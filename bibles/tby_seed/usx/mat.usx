<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">TOBMAT TOBARU NT MATHEW CHP. 01 YOSIAS, INDONESIA</book>
  <para style="h">'O MATIUS</para>
  <para style="toc3">Mat.</para>
  <para style="toc2">'O Matius</para>
  <para style="toc1">'O Habari ma Owa gee 'o Matius Wositotara</para>
  <para style="mt1">'O HABARI MA OWA GEE</para>
  <para style="mt1">'O MATIUS WOSITOTARA</para>
  <para style="imt">'O Habari ma Owa gee 'o Matius Wositota-totara ma Dumutu</para>
  <para style="ip">'O Matius 'awi bukuoka ne'ena 'inasitotara 'o Habari ma Owa. Ma Habari ma Owa ge'ena la 'o Yesus 'una ge'ena ma Koana 'o Nyawa Wosilaha-laha. 'Unau ne'ena gee ma Jo'oungu ma Dutu wijajiokau 'ato dua woboa, 'isoka gee 'o nabii yositotarokau 'o Buku 'Itebi-tebinoka 'o Jaji ma Siraka. Ngaro ma sira 'o Yesus woboano 'o duniaka ne'ena de womanoa doka ka 'o Yahudioka, ma 'o Habari ma Owa ge'ena ma dumutu duga ka 'o Yahudi ma nyawakawa. So 'ena 'o nyawa 'iodumika 'o duniaka ne'ena.</para>
  <para style="ip">Nako ngone pabaca ma buku ne'ena, ge'ena dua panako kokia ma sira nanga Jou Yesus wosupu 'o duniano, wi'osiki, de 'o Tokata ma Koana witaili. De mita 'o sagala moi-moi wokadi-diai 'o Galileaka, ge'ena la: Kokia 'o nyawa wakidotoko; 'o nyawa manga panyake 'i'ini-'inioka wosi'aiki; de mita kokia 'una wosongene de womomikoli. Ne'ena 'iodumu ma dumutu la pasahe ma gou-goungu, 'o Yesus 'una ge'ena to ngone 'o nyawa 'o duniaka poodumu nanga so-sowono ma du-duusu.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ma Yesus Kristus 'awi edete de wi dotumu manga ronga-ronga</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk. 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Koneda 'isilefo ma Yesus Kristus 'awi edete de wi dotumu, 'o Dautino de 'o Abrahamuno. 'O Abrahamuoka de sigado 'o Dautuku, manga ronga-ronga konee:<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2-6a" style="v" sid="MAT 1:2-6a" />'O Abraham 'awi ngowaka 'o Ishak,</para>
  <para style="li" vid="MAT 1:2-6a">'o Ishak 'awi ngowaka 'o Yakub,</para>
  <para style="li" vid="MAT 1:2-6a">'o Yakub 'awi ngowaka 'o Yehuda de wi riaka dodoto,</para>
  <para style="li" vid="MAT 1:2-6a">'o Yehuda 'awi ngowaka 'o Peres de 'o Zerah, manga 'esa ngo Tamar,</para>
  <para style="li" vid="MAT 1:2-6a">'o Peres 'awi ngowaka 'o Hezron,</para>
  <para style="li" vid="MAT 1:2-6a">'o Hezron 'awi ngowaka 'o Ram,</para>
  <para style="li" vid="MAT 1:2-6a">'o Ram 'awi ngowaka 'o Aminadab,</para>
  <para style="li" vid="MAT 1:2-6a">'o Aminadab 'awi ngowaka 'o Nahason,</para>
  <para style="li" vid="MAT 1:2-6a">'o Nahason 'awi ngowaka 'o Salmon,</para>
  <para style="li" vid="MAT 1:2-6a">'o Salmon 'awi ngowaka 'o Boas, ma 'esa ngo Rahab,</para>
  <para style="li" vid="MAT 1:2-6a">'o Boas 'awi ngowaka 'o Obed, ma 'esa ngo Rut,</para>
  <para style="li" vid="MAT 1:2-6a">'o Obed 'awi ngowaka 'o Isai,</para>
  <para style="li" vid="MAT 1:2-6a">'o Isai 'awi ngowaka</para>
  <para style="li" vid="MAT 1:2-6a">ma Koana 'o Dautu.<verse eid="MAT 1:2-6a" /></para>
  <para style="p">
    <verse number="6b-11" style="v" sid="MAT 1:6b-11" />'O Dautoka de sigado ma 'orasi 'o Israeloka yaki'umo 'o Babelika, manga ronga-ronga 'isilefoku konee:</para>
  <para style="li" vid="MAT 1:6b-11">'O Dautu 'awi ngowaka 'o Salomo gee ma 'esa 'o Uria ma bao.</para>
  <para style="li" vid="MAT 1:6b-11">'O Salomo 'awi ngowaka 'o Rehabeam,</para>
  <para style="li" vid="MAT 1:6b-11">'o Rehabeam 'awi ngowaka 'o Abia,</para>
  <para style="li" vid="MAT 1:6b-11">'o Abia 'awi ngowaka 'o Asa,</para>
  <para style="li" vid="MAT 1:6b-11">'o Asa 'awi ngowaka 'o Yosafat,</para>
  <para style="li" vid="MAT 1:6b-11">'o Yosafat 'awi ngowaka 'o Yoram,</para>
  <para style="li" vid="MAT 1:6b-11">'o Yoram 'awi ngowaka 'o Uzia,</para>
  <para style="li" vid="MAT 1:6b-11">'o Uzia 'awi ngowaka 'o Yotam,</para>
  <para style="li" vid="MAT 1:6b-11">'o Yotam 'awi ngowaka 'o Ahas,</para>
  <para style="li" vid="MAT 1:6b-11">de 'o Ahas 'awi ngowaka 'o Hizkia,</para>
  <para style="li" vid="MAT 1:6b-11">'o Hizkia, 'awi ngowaka 'o Manasye,</para>
  <para style="li" vid="MAT 1:6b-11">'o Manasye 'awi ngowaka 'o Amon,</para>
  <para style="li" vid="MAT 1:6b-11">'o Amon 'awi ngowaka 'o Yosia,</para>
  <para style="li" vid="MAT 1:6b-11">de 'o Yosia 'awi ngowaka 'o Yekhonya de wi riaka dodoto.<verse eid="MAT 1:6b-11" /></para>
  <para style="p">
    <verse number="12-16" style="v" sid="MAT 1:12-16" />Ma 'orasi 'o Israeloka yaki'umo 'o Babelika sigado 'o Yesus wosupu 'o duniano manga ronga-ronga konee:</para>
  <para style="li" vid="MAT 1:12-16">'O Yekhonya 'awi ngowaka 'o Sealtiel,</para>
  <para style="li" vid="MAT 1:12-16">'o Sealtiel 'awi ngowaka 'o Zerubabel,</para>
  <para style="li" vid="MAT 1:12-16">'o Zerubabel 'awi ngowaka 'o Abihud,</para>
  <para style="li" vid="MAT 1:12-16">'o Abihud 'awi ngowaka 'o Elyakim,</para>
  <para style="li" vid="MAT 1:12-16">'o Elyakim 'awi ngowaka 'o Azur,</para>
  <para style="li" vid="MAT 1:12-16">'o Azur 'awi ngowaka 'o Zadok,</para>
  <para style="li" vid="MAT 1:12-16">'o Zadok 'awi ngowaka 'o Akhim,</para>
  <para style="li" vid="MAT 1:12-16">'o Akhim 'awi ngowaka 'o Eliud,</para>
  <para style="li" vid="MAT 1:12-16">'o Eliud 'awi ngowaka 'o Eleazar,</para>
  <para style="li" vid="MAT 1:12-16">'o Eleazar 'awi ngowaka 'o Matan,</para>
  <para style="li" vid="MAT 1:12-16">'o Matan 'awi ngowaka 'o Yakub,</para>
  <para style="li" vid="MAT 1:12-16">'o Yakub 'awi ngowaka 'o Yusuf,</para>
  <para style="li" vid="MAT 1:12-16">'o Yusuf ngo Maria ma rokata.</para>
  <para style="p" vid="MAT 1:12-16">Ngo Marianou 'o Yesus wosupu gee ma Jo'oungu ma Dutu Wiiri-iriki.<verse eid="MAT 1:12-16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />So 'o Abrahamuoka de sigado ma Koana 'o Dautuku, 'o lape mogiooko de soatuku. 'Asa de ma Koana 'o Dautoka de sigado 'o Israeloka 'o Babelika yaki'umo, 'o lape mogiooko de soatukoli. De ma 'orasi 'o Israeloka yaki'umo 'o Babelika sigado ma Yesus Kristus wosupu 'o duniano, 'o lape mogiooko de soatukoli mita.<verse eid="MAT 1:17" /></para>
  <para style="s">'O Yesus wosupu 'o duniano</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk. 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />'O Yesus woboa 'o duniano ma jarita konee: Ma 'orasi ngo Maria 'o Yesus ma 'esa de 'o Yusuf 'asa ka 'o demo 'iputusoka ma koyomatoomunuwasi 'ena ngo Maria miroesokau. 'O Yusuf kowanakowa 'ato muna miroesoka ge'ena ma Jo'oungu ma Dutu wi Ngomasa 'imanarama. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />So womau watoakou ma kawomasiriidino sababu 'una ge'ena wi singina 'isure, so wooluku womisimae-maeke 'o kawasaka. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />'O Yusuf watiba-tibangi ma hali ge'ena de wonanere 'ato ma Jo'oungu ma Dutu wi mala'ekati 'iboa de 'ingose, &lt;&lt;Yusuf 'o Dautu wi ngowaka! 'Uwa nimodongo moningaamoko ngo Maria; sababu muna miroesoka ge'ena ma Jo'oungu ma Dutu wi Ngomasa 'Itebi-tebini 'imanarama. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />De dua muna 'asa momaku'arene de mi ngowaka 'o nauru, salingou wonisironga 'o Yesus, sababu ka 'una duga 'asa watuusu 'o nyawa 'iodumu manga sowono.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Ge'ena 'iodumu 'idadi la 'isoka kokia naga gee 'o nabii wimoi wosidemokau 'ato, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;&lt; 'O mosolese mimoi dua 'asa miroesoka de momaku'arene mi ngowaka 'o nauru, 'o ngowaka gu'una 'asa wisironga 'o Imanuel.&gt;&gt; Ngone tanu, &lt;&lt;Ma Jo'oungu ma Dutu naga de de ngone.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Gee womomikie, de wotagi ngo Maria mi'ese so womingaamokokau sababu wamoteke 'isoka 'o mala'ekati wisidemo-demokau gee. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ma 'o Yusuf kowomasiganuwasi ngo Mariaka sigado momaku'arenoka. Momaku'arenoka de mi ngowaka 'o nauru gu'una 'o Yusuf wisironga 'o Yesus.<verse eid="MAT 1:25" /></para>
  <para style="rem">Penyuntingan: Ning 26-6-'08 Edit Koreksi Penterjemah: Ning 23-7-2008</para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Yoca-cawaro manga daeraa dina 'o wange ma siwarisa 'idadu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />'O Yesus wosupu 'o Betlehemuoka, 'o Yudea ma tonaoka, ma 'orasi ge'ena 'o Herodes wokoana. De yamuruo naga yoba-barija 'o ngoma 'o diwangoka yolega ma diai dinaoko 'o wange ma siwaroko, yaoko 'o Yerusalemuoko. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />'Ona yokakasano-sano, &lt;&lt;Kiaka 'o ngowaka gee wosupuokau 'o duniano la wodadi 'o Yahudioka manga Koana? Ngomi miamakekau to 'una wi no-nako, 'o ngoma dina 'o wange ma siwaroka, so ngomi mioboa miosuba 'unaka.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Ma Koana 'o Herodes wo'isenoka ma habari ge'ena, de witodokana, koge'enali mita 'awi kawasa yoodumu 'o Yerusalemuoka. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />So ge'enaka de wakisuloko 'o 'imam ma saeke de 'o Yahudioka manga 'agamaka yodoto-dotoko yomalomuno. Yomalomuno de wosano, &lt;&lt;Kiaka dua 'o Koana wimoi ma Jo'oungu ma Dutu Wiiri-irikokau wosupu?&gt;&gt;<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />'Ona yosango, &lt;&lt; 'O Betlehem ma kotaka 'o Yudea ma tonaoka. Sababu 'isoka gee 'o nabii wimoi wosilefokau,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;Ngona Betlehem, 'o Yehuda ma tonaoka!</para>
  <para style="q2" vid="MAT 2:6">'Igou-goungu ngona konotingoonuwa naga 'o Yehuda ma kota 'ila-laagomo ma sigoronaka.</para>
  <para style="q1" vid="MAT 2:6">Sababu ngonano dua 'asa wosupu wimoi wodadi balusu</para>
  <para style="q2" vid="MAT 2:6">gee dua wakipareta de wakipaliara 'awi kawasa 'o Israeloka.&gt; &gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />'O Herodes wo'isenoka koge'ena, de kawomasibongonino waki'asoko yoba-barija 'o ngoma yolega ma diai dinaoko 'o wange ma siwaroko. 'Asa de wosano, &lt;&lt;Kauruosi niamake 'o ngoma ge'ena 'ibaorino?&gt;&gt; <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Ge'enaka de wakisuloko 'o Betlehemuka yotagi de wakisibesesongo 'ato, &lt;&lt;Niotagi, la nianonu niosidi-diai 'o ngowaka ge'ena. De nako winimakekau, niaino niositotara ngoino la ngoi mita taika towisuba.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10" />Ge'enaka de 'ona yotagi de yamakekauoli ma ngoma gee 'o wange ma siwarie 'ibao-baorino. 'Ona yomorene gee yamakeka ma ngoma ge'ena 'itagi 'isira-sira de 'imaogoro ge'ena ma ngowaka ma dekude daku. <verse eid="MAT 2:9-10" /><verse number="11" style="v" sid="MAT 2:11" />'Ona yowosama ma woaka ge'ena de wimake 'o ngowaka gu'una de ma 'esa ngo Maria, ge'enaka de yobukuku yasuba 'o ngowaka ge'ena, de yapelenga manga harataa ma ngiioka de yokula manga su-suba ge'ena la 'o guraci, de 'o manyanyi, de 'o gota ma tigono ma bounu yaowa-owa posironga 'o mur. <figure style="fig" file="HK00115.pcx" size="col" ref="(2:11)">'O manyanyi ma sago de ma soka de ma bunga</figure> <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ma Jo'oungu ma Dutu wakisitiari manga naneroka, la 'uwa yolioli 'o Herodesika. So 'ona yolio manga tonakisa yaboa 'o ngekomo 'iregu.<verse eid="MAT 2:12" /></para>
  <para style="s">'O Yusuf de ngo Maria 'o Yesus wisiowara 'o Mesirika</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Ma 'orasi yoba-barija 'o ngoma yolega ma diai go'ona yolioka, de 'o Yusuf wonanere 'ato ma Jo'oungu ma Dutu wi mala'ekati 'iboa de 'ingose, &lt;&lt; 'O Herodes winonu 'o ngowaka gu'una womau wito'oma. So nomomikie la wonisiowara 'o ngowaka gu'una de ma 'esa 'o Mesirika. De ge'enakasi doka notamaa sigado tonisidemoli.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Ge'enaka de 'o Yusuf womomiki so kage'ena ma obiri de 'o ngowaka ge'ena de ma 'esa wakisiowarokau 'o Mesirika. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />'Ona yogogere kadoka sigado 'o Herodes wosongenoka.</para>
  <para style="p" vid="MAT 2:15">Koge'ena 'idadi la 'imatiai moteke ma Jo'oungu ma Dutu wi demo 'o nabii wimoi wosihabariokau, &lt;&lt; 'Ai ngowaka towi'asoko 'o Mesirino.&gt;&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">'O ngowa-ngowaka yakito'oma</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />'O Herodes wanako 'ato yoba-barija 'o ngoma 'o diwangoka yolega ma diai dinaoko 'o wange ma siwaroko go'ona wisihagakau, de wi do'otasa 'irama. So wosuloko 'o Betlehemuoka de ma date-dateoka manga ngowaka 'o nauru ma 'umuru 'o taunu modidi de 'isikauku 'iodumu yakokito'oma moteke to 'ona manga demo gee yamakeka 'o ngoma ge'ena de 'isiino.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />So ge'ena 'imatiai gee 'isoka ma Nabii Yeremia wongosekau 'ato,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt; 'O Ramaka yo'isene yoto-tora</para>
  <para style="q2" vid="MAT 2:18">de yogaribetongo.</para>
  <para style="q1" vid="MAT 2:18">Ngo Rahel mi ngowa-ngowaka makidagari,</para>
  <para style="q2" vid="MAT 2:18">de miaru ma mooluku sababu mi ngowaka koyaki'iwau.&gt;&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">'O Mesiroka de yolio</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ma 'orasi gee 'o Herodes wosongenokau, 'ena 'o Yusuf ka 'o Mesirokasi, de ma Jo'oungu ma Dutu wi mala'ekati moi 'imasidumutoli wi naneroka. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />De 'ingose 'ato, &lt;&lt; 'O nyawa gee yomau yato'oma 'o ngowaka ge'ena, yosongenokau. So nomomiki, na'ese 'o ngowaka ge'ena de ma 'esa la nioliou 'o Israelika.&gt;&gt; <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />'O Yusuf womomiki so wa'ese 'o ngowaka ge'ena de ngo Maria de waki'asa yolio 'o Israelika.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Ma gee 'o Yusuf wogi'isenoka 'ato 'o Arkelaus 'o Herodes wi ngowaka gu'una, ma dea witagaliokau wodadi Koana 'o Yudeaka, so kawododatoka ge'enaka waika. So ma Jo'oungu ma Dutu wisisahe 'itiaiokasi wi naneroka, 'asa de wosiika 'o Galilea ma daeraaka. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />So ge'enaka waika de wogogere 'o Nazaret ma kotaka. Koge'ena 'idadi la 'isoka 'o nabii ma sirasi yosidemokau ma ngale 'o ngowaka ge'ena, &lt;&lt; 'Una 'asa wisironga 'o Nazaretioka ma nyawa.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <para style="rem">Penyuntingan: Ning 26-6-2008 Edit Koreksi Penterjemah: Ning 23-7-2008</para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">'O Yohanes Wo'osi-'osiki wi do-dotoko</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mrk. 1:1-8</ref>, <ref loc="LUK 3:1-18">Luk. 3:1-18</ref>, <ref loc="JHN 1:19-28">Yoh. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />'O taunu muruo naga deika 'o Yohanes Wo'osi-'osiki woboano 'o tonaka 'ika-kakasaka 'iga-gamamuoka 'o Yudea ma daeraaka de wokurue wodotoko, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />wongose, &lt;&lt;Niotoba 'o sowono niodiai de niolio ma Jo'oungu ma Dutuka, sababu ma Jo'oungu ma Dutu wacobou wopareta!&gt;&gt;<verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />'O Yohanesou gee ma Nabii Yesaya wongosekau konee,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt; 'O nyawa moi naga 'o tonaka 'ika-kakasaka wosigaso-gasoko wongose 'ato,</para>
  <para style="q2" vid="MAT 3:3">&lt;Niosikadiai ma Jou 'awi ngekomo;</para>
  <para style="q2" vid="MAT 3:3">niosikaboooto ma Jou wi tapaki la waboa!&gt; &gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />'O Yohanes wi baju ge'ena 'o 'onta ma gogo yadiaiku, de 'awi bulu ge'ena 'o haewani ma kai, de wi 'inomo, 'o kakasoso de 'o madu 'o bonganika. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Manga gudai 'o Yerusalemuoka de 'o Yudeaka de mita 'o Yordan ma 'akere ma date-dateoka gee, yoboa 'o Yohanesino. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />'Ona yomangakuoka manga sowono de 'o Yohanes waki'osiki ge'ena 'o Yordan ma 'akeroka.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Manga gudai mita 'o Farisioka de 'o Sadukioka yoboa 'o Yohanesino la waki'osiki. Ma gee wakimake yoboa, de kawongosekau, &lt;&lt;Ee ngini 'o ngowosana ma ngowa-ngowaka! Nago'ona nidongoseka 'ato ngini 'idadi niomasiresene gee dua ma Jo'oungu ma Dutu wi hukumani 'iboa? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Niosidumutu nia gokoieka 'ato ma gou-goungu niotobakau 'o sowono niodiai. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />'Uwa nimangano-nganono 'o hukumani konidaenuwa sababu niongose 'ato 'o Abraham ge'ena to ngini nia topora. Niongano-nganono, 'o teto-teto ne'ena mita ma Jo'oungu ma Dutu 'idadi wadiai ma ngale 'o Abraham wi ngowa-ngowaka. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />'O patu naga 'inoakou 'o gota ma pegoka, ma ngale 'isitodanga 'o gota ma roese sigado ma ngutu-ngutuuku. 'O gota gee 'isowoko 'itorou, ge'ena dua yatodanga de yodugumo 'o 'ukuka. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ngoi tini'osiki de 'o 'akere, ma ngale ma no-nako niotobakau 'o sowono niodiai; ma dua wimoi wotu'uruno, wini'osiki de 'o Ngomasa 'Itebi-tebini de 'o 'uku, 'una 'ifoloi woamoko de de ngoi. Ka 'awi tarupa to'asa ma koyadaenuwa. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />'Una wacobou wosikati-tingaka 'o nyawa ma owa de ma dorou matero kawopai-pairi wimoi 'awi tatapa wa'aonou ma ngale 'awi bira wakokitadoko sigado 'itebini. Ma bira ge'ena 'asa watoomu 'o rawongoka, duga ma konga 'iodumu 'asa wositaulu 'o 'ukuka gee koisonge-songenuawau!&gt;&gt; <figure style="fig" file="HK00097.pcx" size="span" ref="(3:12)">'O Israeloka ma sira manga gandum ma sowoko de ma pusa yosikati-tingaka</figure><verse eid="MAT 3:12" /></para>
  <para style="s">'O Yesus wi'osiki</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mrk. 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ge'enaka de 'o Yesus 'o Galileaka de wotagi 'o Yordan ma 'akerika, ge'enaka waika de 'o Yohanesika waika womaga'asoko wi'osiki. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ma 'o Yohanes wositaili womanitomo 'o Yesus wi ga-ga'asoko ge'ena, kawongosekau, &lt;&lt; 'Aba, yadaene 'ena ngona noi'osiki, ma ne'ena 'ido'oa so ngona noboa ngoino?&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />'O Yesus wosango, &lt;&lt;Koge'enau ngaro. Sababu kone'ena ma ngale padiai 'iodumu gee ma Jo'oungu ma Dutu wi mau.&gt;&gt; Ge'enaka de 'o Yohanes 'o Yesus wi'osiki.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Wi'osiki 'iduanga so womabaorie de 'o diwanga 'ipelenga de 'o Yesus wamake ma Jo'oungu ma Dutu wi Ngomasa 'i'uti dakuuku 'isoka 'o pombo ngai moi de widangiku. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Ge'enaka de ma Jo'oungu ma Dutu wi 'ilingi 'ingose konee, &lt;&lt;Ne'ena to ngoi 'ai Ngowaka towisiboso-bosono, 'una 'ai singina wasanangi.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <para style="rem">Penyuntingan: Ning 26-6-2008 Edit Koreksi Penterjemah: Ning 23-7-2008</para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">'O Yesus 'o Tokata ma Koana witaili</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mrk. 1:12-13</ref>; <ref loc="LUK 4:1-13">Luk. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Ge'ena 'ipasa de 'o Yesus 'o Ngomasa 'Itebi-tebini wi'asa 'o tonaka 'ika-kakasaka 'iga-gamamuoka la 'o Tokata ma Koana witaili. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ge'enaka dau 'o Yesus wopuasa so 'o wange nagi soata de 'o obiri nagi soata kowo'odomuwa<note caller="a" style="f"><char style="fr" closed="false">4:2: </char><char style="ft" closed="false">Kowo'odomuwa ma ngale 'awi singina duga ka ma Jo'oungu ma Dutuka.</char></note> so wamao wisawinukou. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />De 'o Tokata ma Koana yaino de kaingosekau 'unaka, &lt;&lt;Ngona ne'ena ma Jo'oungu ma Dutu wi Ngowaka. So bika nasuloko 'o teto-teto ne'ena 'imadadi 'o 'inomo.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />'O Yesus wosango, &lt;&lt; 'O Buku 'Itebi-tebinoka 'isilefoku, &lt; 'O nyawa yo'ahu duga ka de 'o 'inomuwa, ma mita de ma Jo'oungu ma Dutu wi demo moi-moi gee wosidemokau.&gt; &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ge'enaka de 'o Tokata ma Koana wi'asa 'o Yerusalemuka, 'o kota 'itebi-tebinika, de kadaku ma Jo'oungu ma Dutu wi Woa ma dekuokau. <figure style="fig" file="LB00250.tif" size="span" ref="(4:5)">Ma Jo'oungu ma Dutu 'awi Woa 'o Yerusalemoka</figure> <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />De 'o Tokata ma Koana kaingosekau 'o Yesusika, &lt;&lt;Ngona ma Jo'oungu ma Dutu 'awi Ngowaka, bika nomaotaka daunguku; sababu naga 'isilefokau 'o Buku 'Itebi-tebinoka konee:</para>
  <para style="q1" vid="MAT 4:6">&lt;Ma Jo'oungu ma Dutu 'asa wasuloko 'awi mala'ekati</para>
  <para style="q1" vid="MAT 4:6">nijaga de nilegono</para>
  <para style="q1" vid="MAT 4:6">la ka 'ani dou ma 'uwa 'imasitolo 'o tetoka.&gt; &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />'O Yesus wosango, &lt;&lt;Ma naga mita 'o Buku 'Itebi-tebinoka 'isilefoku, &lt; 'Uwa wonitaili nanga Jou, ge'ena la ma Jo'oungu ma Dutu!&gt; &gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Ge'ena 'ipasa de 'o Tokata ma Koana 'o Yesus wi'asakauoli 'o gigie 'ikuru-kurutieka de wisidumutu 'o duniaka ma pareta moi-moi de ma kia sonaa 'isure-sure 'iodumu. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />De kaingosekau 'o Yesusika, &lt;&lt; 'Iodumu ge'ena 'asa tonisidukula, nako noisuba.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />'O Yesus wosango, &lt;&lt;Noma'aiika ne'enaka. 'O Buku 'Itebi-tebinoka 'isilefoku: &lt;Winisuba ma Jou, nia Jo'oungu ma Dutu, de ka 'una duga winileleani.&gt; &gt;&gt;<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ge'enaka de 'o Tokata ma Koana 'o Yesus wimadakau, de 'o mala'ekati 'iboa wileleani.<verse eid="MAT 4:11" /></para>
  <para style="s">'O Yesus wokurue wi manarama 'o Galileaka</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mrk. 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Gedagee ma habari 'ato 'o Yohanes wibuiokau, de 'o Yesus womasiditoko 'o Galileaku. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Ge'enaka de woma'aiki 'o Nazaretioka de wogogere 'o Kapernaumoka 'o Galilea ma talaga ma dateoka, 'o Zebulon de 'o Naftali ma daeraaka, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />moteke ma Nabii Yesaya wongosekau,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt; 'O Zebulon de 'o Naftali</para>
  <para style="q2" vid="MAT 4:15">ma daeraa gee 'o talaga ma ngekomoko,</para>
  <para style="q2" vid="MAT 4:15">'o Yordan ma 'akere ma songonaka,</para>
  <para style="q2" vid="MAT 4:15">'o Galileaka, ge'enaka yokudai ka 'o Yahudiokawa.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />'O nyawa gee yo'ahu naga 'o darusoka,</para>
  <para style="q2" vid="MAT 4:16">yamake 'o siwara ma amoko.</para>
  <para style="q1" vid="MAT 4:16">'O nyawa gee 'o darusu yakiparetano yakisi'asa 'o songenika,</para>
  <para style="q2" vid="MAT 4:16">mita yamakekau 'o darangi!&gt;&gt;<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Ma 'orasi ge'ena 'o Yesus wokurue wositotara wongose 'ato, &lt;&lt;Nimaogoro 'o sowono niodiai de niolio ma Jo'oungu ma Dutuka sababu 'una wacobou wopareta ma ngale wokoana!&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">'O Yesus waki'asoko 'o naoko yosoma-soma yaruata</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mrk. 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk. 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Ma 'orasi 'o Yesus wotagi-tagi 'o Galilea ma talaga ma batingoka, de wakimake 'o riaka dodoto yamididi ge'ena la 'o Simon (gee wisironga mita 'o Petrus) de 'o Andreas, 'ona 'o naoko yomadosoma ma gu-gudaioka. <figure style="fig" file="HK074C.pcx" size="span" ref="(4:18)">'O naoko yotago-tagoko 'o Galilea ma talagaka</figure> <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />'O Yesus wongose 'onaka, &lt;&lt;Nou, nimoteke ngoi. Ngoi 'asa tinidotoko 'o nyawa niasoma!&gt;&gt; <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Ge'enaka de ka manga soma yamada de yomoteokau.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Deika 'o Yesus wogila-gilali, de wakimakeli 'o riaka de 'o dodoto yamididi, ge'ena la 'o Yakobus de 'o Yohanes 'o Zebedeus wi ngowa-ngowaka. 'Ona de manga dea yoodumu 'o ngo'otiroka manga soma yosidiai. 'O Yesus waki'asoko mita, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />de ka manga ngo'otiri de manga dea yamada de wimotekokau 'o Yesus.<verse eid="MAT 4:22" /></para>
  <para style="s">'O Yesus wodotoko de 'o panyake wosi'aiki</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luk. 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />'O Yesus wakilolituku 'o Galilea ma daeraa, wodotoko 'o lo-lomu ma woa-woaka. 'Una wositotara 'o Habari ma Owa, ma ngale ma Jo'oungu ma Dutu 'asa wonapareta sababu 'una nanga Koana. De wakisilaha 'o nyawa yopa-panyake de yobo-bolohi. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />'O Yesus wi habari 'o Siriaka yakilolitukou, so ma rai 'o nyawa manga gudai widolomu de yaki'asano 'o nyawa manga panyake 'i'ini-'inioka yosa-sangisara, 'o tokata yakiali-aliti de yakimusu-musuku de yolugu-lugu, yoodumu 'o Yesus wakisi'aiki. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ma 'orasi ge'ena 'o nyawa manga gudai 'o Yesus wimoteke. Naga mita 'o Galileano, de mita 'o Kota Mogiookino, 'o Yerusalemino, 'o Yudeano, de mita 'o Yordan ma daeraa ma songonano doka.<verse eid="MAT 4:25" /></para>
  <para style="rem">Penyuntingan teks: Ning 4-7-2008</para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">'O Yesus wobi-bicara ma ngale 'o sanangi</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk. 6:20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Gee 'o Yesus wakimake 'o nyawa manga gudai yoboano de 'o gigie ma dekuoka wosaude so wogogeruku, de wi do-domoteke yoboa. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Ge'enaka de wakidotoko wongose 'ato,<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt;Yosanangioka 'o nyawa gee yomamaoku koyomado-do'oawa de duga ka ma Jouka yomasiga-gao;</para>
  <para style="q2" vid="MAT 5:3">'ona ge'ena ma Jo'oungu ma Dutu wi kawasa!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Yosanangioka 'o nyawa gee manga singina 'iga-gamamu;</para>
  <para style="q2" vid="MAT 5:4">'ona 'asa ma Jo'oungu ma Dutu wakiaru!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Yosanangioka 'o nyawa gee manga singina 'ima-ma'ai;</para>
  <para style="q2" vid="MAT 5:5">ma Jo'oungu ma Dutu 'asa wakidototomo 'awi jaji 'onaka!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Yosanangioka 'o nyawa gee yonyafisuu yodiai ma Jo'oungu ma Dutu wi mau;</para>
  <para style="q2" vid="MAT 5:6">'ona 'asa wakikula sigado yakiduga!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Yosanangioka nago'ona gee yosimara'ai 'o nyawaka;</para>
  <para style="q2" vid="MAT 5:7">'ona mita 'asa ma Jo'oungu ma Dutu wakisimara'ai!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Yosanangioka 'o nyawa gee manga singina 'itebi-tebini ma Jo'oungu ma Dutu wi bionoka;</para>
  <para style="q2" vid="MAT 5:8">'ona 'asa ma Jo'oungu ma Dutu wimake!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Yosanangioka 'ona gee 'o nyawa yosikakatiai;</para>
  <para style="q2" vid="MAT 5:9">ma Jo'oungu ma Dutu 'asa wakisironga to 'una 'awi ngowa-ngowaka!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Yosanangioka 'ona gee yamake 'o sangisara 'o nyawano sababu yadiai ma Jo'oungu ma Dutu wi mau;</para>
  <para style="q2" vid="MAT 5:10">'ona ge'ena ma Jo'oungu ma Dutu wi kawasa!<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Niosanangioka ngini nako nisiti-tingoono, nisangisara, de nisigurubungu ma ngale ngoi. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />'O nabii ma sirasi gee ngini koni'iwasi mita yakisangisarakau 'isoka koge'ena. Salingou kaniomore-morene sababu nia parasengi ma amoko daku 'o sorogaaka ma Jou wadua-duangou.&gt;&gt;<verse eid="MAT 5:12" /></para>
  <para style="s">'O gasi de 'o darangi</para>
  <para style="r">(<ref loc="MRK 9:50">Mrk. 9:50</ref>; <ref loc="LUK 14:34-35">Luk. 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />&lt;&lt;Ngini ne'ena 'isoka 'o gasi 'o dunia ma nyawaka. Nako 'o gasi koiosawau, de kaidadiosi yadiai 'iosali? Koi'iwau ma faedaa, so kaya'umo de 'o nyawa yadoko-doko.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Ngini ne'ena 'o darangi 'o dunia ma nyawaka. 'O kota daku 'o gigie ma dekuoka koidadiwa yosidutuluku. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Komoiwa 'o silo yatuuika de 'o pa'udi yositamunuku, ma 'ena ma ngiioka yositodenguku la 'o nyawa 'iodumu 'o woa ma dodaka gee yomasimake. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Koge'enali mita nia darangi ge'ena salingou 'isiwara 'o nyawaka, la 'ona yamake 'okia sonaa niodi-diai yaowa-owa ge'ena, de wisitedene nia Dea 'o sorogaaka.&gt;&gt;<verse eid="MAT 5:16" /></para>
  <para style="s">'O Yahudioka manga 'agama ma do-dotoko</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt; 'Uwa niongose 'ato ngoi taino ne'ena taisanga 'o Musa wi besesongo de 'o nabii-nabii manga do-dotoko. Ngoi taino kotaisanguwa so 'ena tosidumutu ma ngale ma gou-goungu. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Niongano-nganono! Nako 'o diwanga de 'o dunia ka de ma 'enasi, ge'ena ka ma eta ma koiisanguwa ma besesongo ge'ena, nako 'iodumu gee ma besesongoka ge'ena koidadiwasi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Sababu ge'ena nago'ona yaparene 'o do-dotoko ge'ena ngaro ka ma eta, de yosidotoko 'o nyawaka la 'ona mita koge'ena, 'ona ge'ena dua 'ifoloi yotingoono ma Jo'oungu ma Dutu wi kawasaka. Ma gedagee yamoteke ma besesongo ge'ena de yosidotoko 'o nyawaka koge'enali, 'ona ge'ena dua yoamoko ma Jo'oungu ma Dutu wi kawasaka. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />So niongano-nganono! Nako ngini niomau niodadi ma Jo'oungu ma Dutu wi kawasa, ge'ena salingou ngini 'ifoloide niodiai ma Jo'oungu ma Dutu wi mau de godagee 'o Yahudioka manga 'agamaka yodoto-dotoko de 'o Farisioka.&gt;&gt;<verse eid="MAT 5:20" /></para>
  <para style="s">'O gangamo ma da-dawanono</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luk. 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />&lt;&lt;Ngini nianakokau nanga edete de nanga dotumu yakisidotoko konee: &lt; 'Uwa nioto'oma; nago'ona yoto'oma dua yakihukumu.&gt; <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ma ne'ena ngoi tinisidemo, nago'ona bato ngaro kayongamo duga 'o nyawaka, 'ona 'asa yakihukumu. De nago'ona yodoana 'o nyawaka, 'ona 'asa 'o 'agama ma balusu yakihukumu. De nago'ona yositi-tingoono 'o nyawaka, 'ona 'asa yakihukumu 'o 'uku ma lurusoka. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Sababu ge'ena nako nia su-suba niokula ma Jo'oungu ma Dutuka la nimamaoku 'ato naga 'o nyawa manga singina niasiriku, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />ge'ena salingou nianoakosi nia su-suba ge'ena 'o su-suba 'idu-dutuuku ma dateoka, la niotagi niomasilo-loakasi gee manga singina niasiri-sirika. Ge'enaka 'asa de niolio niosisuba 'ania su-suba ge'ena ma Jo'oungu ma Dutuka.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Nako la moikani nikalaki 'o hakimika, ge'ena konisitotaruawasi 'ena nimasikalo-loakau. Nako ko'uwa ge'ena dua 'o hakimika ni'asa, de dua 'o hakimi ma balusu wosulokoli 'awi ro-riwoka, de 'ona nisingosama 'o buika. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />De tinisidemo nginika: Ma raiokau dua ngini koidadiwasi niosupu nako nia nagimi koniabootuawasi niafangu.&gt;&gt;<verse eid="MAT 5:26" /></para>
  <para style="s">'O songou</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />&lt;&lt;Ngini nianakokau 'o do-dotoko 'isoka konee: &lt; 'Uwa niosongou.&gt;<verse eid="MAT 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 5:28" />Ma ne'ena ngoi tinisidemo, nagu'una 'o ngeweka moi waungini la de wi nyafisuu, 'una ge'ena wosongouokau de 'o ngeweka gumuna 'awi singina ma dodaka. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Nako nia ako ma songona nisiotaka 'o dorouku, ge'ena niapeleuru la nia'umoka. Yaowa nia roese ma kia sonaa ngai moi nia'umo, la 'uwa sigado 'o 'ukuka nidugumo. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Nako nia giama ma songona nisiotaka 'o dorouku, nia'ogu la nia'umoka. Yaowa nia giama ma songona koi'iwaka, la 'uwa sigado ngini 'o 'ukuka nidugumo.&gt;&gt;<verse eid="MAT 5:30" /></para>
  <para style="s">'O gangoluku</para>
  <para style="r">(<ref loc="MAT 19:9">Mat. 19:9</ref>; <ref loc="MRK 10:11-12">Mrk. 10:11-12</ref>; <ref loc="LUK 16:18">Luk. 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />&lt;&lt;De ma 'ena mita 'o do-dotoko 'isoka konee: &lt;Nago'ona manga wekata yaoluku, salingou 'o ngo-ngoluku ma surati yokula manga wekatika.&gt; <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Duga ne'ena ngoi tinisidemo nginika: Nagu'una wi wekata komosongouwa de mioluku, 'una wodiai muna mosongou nako la momodokali. De nagu'una womingaamoko 'o di-dilikutu gumuna, 'una mita wosongou.&gt;&gt;<verse eid="MAT 5:32" /></para>
  <para style="s">'O sasi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />&lt;&lt;Ngini nianakokau nanga edete de nanga dotumoka manga do-dotoko konee: &lt; 'Uwa niaparene nia sasi, 'okia naga niosasiokau ma Jo'oungu ma Dutu wi bionoka, salingou niadiai.&gt; <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ma ne'ena ngoi tinisidemo nginika: Ka ma eta ma 'uwa niosasi, ngaro de 'o diwanga ma, sababu ge'ena ma Jo'oungu ma Dutu wi ngii ma ngale wopareta; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />bolo de 'o dunia, sababu ge'ena ma Jo'oungu ma Dutu wi dou ma ha-hangi; bolo de 'o Yerusalem, sababu ge'ena ma Koana ma Amoko wi kota. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Mita 'uwa niosasi de nia saeke, sababu ngini koniadadiwa niodiai nia utu 'i'arese bolo 'itaromo ngaro ka ngai moi ma. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Kaniongose duga, &lt;Ia&gt;, bolo &lt;Ko'uwa&gt;. Nako 'ipaili de ge'ena, ge'ena ka 'o Tokata ma Koanino.&gt;&gt;<verse eid="MAT 5:37" /></para>
  <para style="s">'O dorou 'uwa posibalasi de 'o dorou</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk. 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />&lt;&lt;Ngini mita nianakokau 'o do-dotoko 'isoka konee: &lt; 'O nyawa manga ako niatorou to ngini mita yatorou, de 'o nyawa manga 'ingiri niatotaka to ngini mita yatotaka.&gt; <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ma ne'ena ngoi tinisidemo nginika, 'uwa niakigogola gee 'o nyawa yoba-badingaka nginika. De nako nisiti-tingoono nia gotoaka ma ginirakino yapoka, ge'ena yaowa ma gubalioli niosidakunu. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />De nako 'o nyawa nikalaki 'o hakimika de yomau nia baju ya'ese, ge'ena nia juba mita niakikulaka. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />De nako yopa-pareta moi yoboa la yopakisaa manga gina nia'asa ma gurutu 'o kilo moika, ge'ena salingou nia'asa 'o kilo modidika. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Nako 'o nyawa 'o kianikia yomaga'asoko nginika, niakikulaka. Mita nako nia kianikia yomadabau, 'uwa koniakikulawa.&gt;&gt;<verse eid="MAT 5:42" /></para>
  <para style="s">Nia saturuu niakidora</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk. 6:27-28</ref>, <ref loc="LUK 6:32-36">6:32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ngini nianakokau mita ma ngale 'o do-dotoko 'isoka konee: &lt;Niakidora nia ma-manai, de niakidu'uduku gee nia saturuu.&gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ma ne'ena ngoi tinisidemo: Niakidora nia saturuu, de niakisilahidoa godagee niba-badingaka, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />la ngini 'asa niodadi nia Dea 'o sorogaaka wi ngowa-ngowaka. Sababu ma Jo'oungu ma Dutu wi wange ma ako wosibaoro, ma ngale 'o nyawa ma owa de mita 'o nyawa ma dorou. 'Una wosiguti 'o besaka, ma ngale 'o nyawa manga 'ahu yaowa-owa de mita 'ito-torou. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Sababu nako niakisibosono duga ka kiaka naga gee 'ona mita nisibosono nginika, ge'ena kaimatero de 'o balasitengi yoga-ga'asoko yadi-diai. So dua 'okia ma Jo'oungu ma Dutu winisiparasengi? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />De nako niakitabea duga ka gee nia nyawaka, 'okia niofoloide? 'O nyawa gee kowinakowa ma Jo'oungu ma Dutu mita yodiai koge'ena! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />'Ania Dea 'o sorogaaka 'o nyawa 'iodumu wadora ma gou-goungu. Ngini mita salingou koge'ena.&gt;&gt;<verse eid="MAT 5:48" /></para>
  <para style="rem">Edit Koreksi Penterjemah: Ning 23-7-2008</para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">'O sadakaa pokula</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />&lt;&lt;Niosi-singina! Nako 'o 'agama ma mau-mau niadiai 'uwa niosidumutika. Sababu nako niosidumutika, nia Dea daku 'o sorogaaka kowiniparasengiwa.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Ge'enau so nako yosusa-susa niakiriwo, 'uwa niosidumutika 'isoka gee yoma'uca-'uca. 'Ona yoduaka 'o lo-lomu ma woa-woaka de 'o tapakioka la bari 'o nyawa yakisiarene. Niosi-singina! 'Ona ge'ena yamakekau manga parasengi, ge'ena la 'o nyawa yakisiarene. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ma nako nia sadakaa niokula, ge'ena kanimasiriidino la 'o nyawa 'uwa yanako. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Madaka la nia sadakaa niokula ge'ena duga ka ma Jo'oungu ma Dutu wanako. 'Una 'asa winiparasengi gee winimake kanimasiriidino.&gt;&gt;<verse eid="MAT 6:4" /></para>
  <para style="s">'O do-dotoko ma ngale pomalahidoa</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk. 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />&lt;&lt;Nako niomalahidoa, ge'ena 'uwa 'isoka gee 'o nyawa yoma'uca-'uca la salingou ka 'o lo-lomu ma woaka yaika, bolo 'o ngekomo ma ridabioka la 'o kawasa yakimake. Niongano-nganono! Ge'enau to 'ona manga parasengi yamakekau ge'ena la 'o nyawa yakisiarene.<verse eid="MAT 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 6:6" />Duga nako la nimalahidoa, ge'ena nimasidebenoka nia kamarioka la nia Dea gee 'o nyawa kowimake-makewa wamake koge'ena de winiparasengi.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Nako niolahidoa ge'ena ma betongo 'uwa kage'ena niogi-gilio 'isoka 'o nyawa gee ma Jo'oungu ma Dutu kowinako-nakowa. 'Ona yongose nako manga lahidoa ma betongo 'ikudai de 'ito-to'ingoka ge'ena dua ma Jo'oungu ma Dutu wadawongo. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />'Uwa 'isoka 'ona, sababu nia Dea wanakokau 'ania paraluu koniolahidoawasi 'ena. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />So niolahidoa konee:</para>
  <para style="q1" vid="MAT 6:9">&lt;Mia 'Aba 'o sorogaaka!</para>
  <para style="q2" vid="MAT 6:9">Tanu ngomi 'o nyawa mioodumu 'ani ronga miositedene.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Tanu ngona noparetau 'o duniaka,</para>
  <para style="q2" vid="MAT 6:10">de tanu 'ani mau miamoteke</para>
  <para style="q2" vid="MAT 6:10">ne'enaka 'isoka 'o sorogaaka.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Tanu nokula mia 'inomo</para>
  <para style="q2" vid="MAT 6:11">gee mioparaluu ne'ena ma wange.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />'Uwa nosi-singina mia sowono</para>
  <para style="q2" vid="MAT 6:12">'isoka ngomioli komiosi-singinawau</para>
  <para style="q2" vid="MAT 6:12">'o nyawa manga sowono.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />De 'uwa minisimadaka mitaili,</para>
  <para style="q2" vid="MAT 6:13">ma minisipidili 'o dorouoka.</para>
  <para style="q2" vid="MAT 6:13">[Ngona ge'ena ma Koana, nopa-pareta, minisitedene kaisi'ado-'adonika. 'Amin. Koge'enau.]&gt;<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Sababu nako konimadonoakuwa 'o nyawa yosowono nginika, nia Dea 'o sorogaaka mita kowosi-singinawau to ngini nia sowono. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ma nako ngini nia singinaka nimadonoaku 'o nyawa manga sowono, ge'ena dua nia Dea 'o sorogaaka mita kowinisipidiluwa to ngini nia sowono.&gt;&gt;<verse eid="MAT 6:15" /></para>
  <para style="s">'O puasa ma gou-goungu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt;Nako niopuasa, ge'ena 'uwa nia biono kailamahaninou 'isoka 'o nyawa gee yoma'uca-'uca la manga biono ma yangalioka, yakarana 'o nyawa yakinako 'ato 'ona yopuasaka la yakisiarene. Niongano-nganono! Ge'enau to 'ona manga parasengi yamakekau. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ma nako ngini niopuasaka, ge'ena nimama-marauka de nimausika. <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />La 'o nyawa 'uwa yanako 'ato niopuasaka, duga ka nia Dea gee 'o nyawa kowimake-makewa 'una 'asa winiparasengi gee wamake kaniosigi'iunino.&gt;&gt;<verse eid="MAT 6:18" /></para>
  <para style="s">'O harataa 'o sorogaaka</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk. 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />&lt;&lt; 'Uwa nimadolomu 'o harataa 'o duniaka, dua kayabo-boruoka de kaimookoka, de yotosi-tosiki yoboa yatosioka. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Duga nimadolomu 'o harataa 'o sorogaaka gee koyabo-boruwau de koimookuawau, de yotosi-tosiki koyatosikuawau. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Sababu kiaka naga nia harataa, nia singina mita ge'enaka.&gt;&gt;<verse eid="MAT 6:21" /></para>
  <para style="s">'O roese ma silo</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk. 11:34-36</ref>)</para>
  <para style="p">
    <verse number="22-23" style="v" sid="MAT 6:22-23" />&lt;&lt;Nanga ako ge'ena kaimatero de nanga roese ma silo. Nako nia ako 'idoto ge'ena dua nimasimake 'itiai 'okia sonaa niodi-diaioka. Ma nako nia ako koidodonuwa ge'ena ngini dua 'isoka 'o darusoka. So nako nia silo koiletonguwa, ge'ena dua posironga 'itarusoka.&gt;&gt;<verse eid="MAT 6:22-23" /></para>
  <para style="s">Ma Jo'oungu ma Dutu 'awi mau de 'o harataa</para>
  <para style="r">(<ref loc="LUK 16:13">Luk. 16:13</ref>, <ref loc="LUK 12:22-31">12:22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />&lt;&lt;Komoiwa yomanarama manga balusu yamididioka; sababu dua wimoika 'ifoloi widora de gee wimoikali, bolo dua wimoika 'ifoloi wisingounu de gee wimoikali. Koge'enali mita ngini. Ngini koidadiwa niamanarama to ma Jo'oungu ma Dutu 'awi mau, ma de nio'ahu kanimadolomu 'o duniaka ma harataa.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Sababu ge'ena niosi-singina! 'Uwa niododato ma ngale nia 'ahu, ge'ena la 'okia dua nia'odomo de nia'okere de nimasinoa. Ma gou-goungu 'o 'ahu 'ifoloi 'ibaraguna de 'o 'inomo, de nia roese 'ifoloi 'ibaraguna de 'o pakeangi. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Nialega 'o namoro 'o diwangika, 'ena koimadutudukuwa de koimadugutukuwa, de mita koimada-daotuwa ma rawongino, ma ma Jo'oungu ma Dutu watowo! De nginioli? ngini de 'o namoro ge'ena nginiosi 'ifoloi niobaraguna? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Nago'ona nginioka ne'ena yodo-dodato so manga 'umuru 'iganapu ngaro ka ma eta ma?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />'Ido'oa so niododato ma ngale nia pakeangi? Nialega 'o bunga-bunga 'igo'oode 'o godoaka, 'ena koimanaramuwa de ma baju koimaditiaiwa; <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />ma ma Koana 'o Salomo wikorago koge'ena, ma koma'iwa womapakeangi ma sure 'isoka 'o bunga-bunga ge'ena. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />'O 'ubutu 'o godoaka ne'ena ma wange 'igo'oode de bibinoka yatuuku yabootokau. Ma ma Jo'oungu ma Dutu wadiai koge'ena ma sure. De nginioli! Ma ngini koniongakuwa rekeni! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />'Uwa niododato de 'uwa niongose 'ato 'okia dua pa'odomo de pa'okere, de 'okia dua pomasinoa? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Koge'ena dau ge'ena, 'o nyawa gee ma Jo'oungu ma Dutu kowinako-nakowa kaitaurika yanonu. Momongo 'ania Dea daku 'o sorogaaka wanakokau ngini nioparaluu 'iodumu ge'ena. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />So niosisira-sira to ma Jo'oungu ma Dutu 'awi pareta la nia 'ahu wapareta. De dua nia paraluu 'iodumu 'asa winikula. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Sababu ge'ena 'uwa niododato ma ngale bibinie, sababu bibinie ge'ena de ma 'enali to 'ena ma susa. Ne'ena ma wange yaowakau to 'ena ma susa, so 'uwau niadogo.&gt;&gt;<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">'Uwa nimasikasala</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk. 6:37-38</ref>, <ref loc="LUK 6:41-42">6:41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt; 'Uwa niakisisala 'o nyawa, la ma Jo'oungu ma Dutu mita 'uwa winisisala. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Sababu kokia naga niakisisala 'o nyawa, ma Jo'oungu ma Dutu mita winisisala koge'ena. De kokia naga yaika niakisipake 'o nyawaka, dua koge'enali yaika mita ma Jo'oungu ma Dutu winisipake. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />'Ido'oa so niosidawanono nia 'esa moi manga ako ma geneo, 'ena to nginioka 'o balaki koniakalesanguwa. <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Dua kokia ngini 'idadi niongose nia 'esa moika, &lt; 'Ino, ta'aiki 'ani ako ma geneo gee!&gt;, 'ena to nginioka 'o basagi? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ee! Tabangeluku! To nginiosi nia akoka 'isira niosisupu 'o basagi, la niomasimake 'itiaiokasi 'asa de to nia 'esa moi manga ako ma geneo nia'aiki.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />'Okia sonaa 'itebi-tebini 'uwa niodukula 'o kasoka, 'uwa sigado nidubulutuka nikaboto, de nia mustika 'uwa niodukula 'o titika, la 'uwa sigado yadoku-doku.&gt;&gt;<verse eid="MAT 7:6" /></para>
  <para style="s">Nimaga'asoko, nimadononu, de nimasi'ilingi</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk. 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Nimaga'asoko ma Jo'oungu ma Dutuka la 'asa winikula, nimadononu la 'asa nimadamake, de nimasi'ilingi la 'o ngorana 'asa winidebelenga. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Sababu nago'ona yomaga'asoko 'asa wakikula, de nago'ona yomadononu 'asa yomadamake, de nago'ona yomasi'ilingi, 'asa 'o ngorana wakidebelenga. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Komoiwa nako manga ngowaka 'o roti 'iga'asoko de ma dea wokula 'o teto, <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />bolo nako 'iga'asoko 'o naoko de ma dea wokula 'o ngia. <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Ngaro niotingkai, ma kanianako niokula yaowa-owa nia ngowaika. De dua nia Deali daku 'o sorogaaka, 'unasi 'ifoloi 'asa wokula yaowa-owa gee 'o nyawa yomaga'asoko 'unaka!<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Niodiai 'o nyawaka gee 'isoka ngini nioduaka 'o nyawa yodiai nginika, ge'ena 'o Musa de 'o nabii-nabii manga do-dotoko ma titi.&gt;&gt;<verse eid="MAT 7:12" /></para>
  <para style="s">'O ngekomo 'ipe-pe'etoro</para>
  <para style="r">(<ref loc="LUK 13:24">Luk. 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt;Nako nianonu 'o 'ahu 'ika-kakali, ge'ena niowosama 'o ngorana 'ipe-pe'etorika, sababu 'o ngorana de 'o ngekomo 'iamo-amoika ge'ena 'isikaika 'o narakaka, de ge'enaka 'o nyawa manga gudai yaboa. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ma 'o ngorana de 'o ngekomo gee 'isikaika 'o 'ahu 'ika-kakalika ge'ena 'isusa de 'ipe'etoro, de ka munuka duga ge'enaka yaboa.&gt;&gt;<verse eid="MAT 7:14" /></para>
  <para style="s">'O gota ma roese de ma sowoko</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk. 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Nimasitiari gee 'o nabii yoelu-eluika, sababu 'ona nidoboa 'isoka 'o domba, 'ena momongo 'ona ge'ena kaimatero de 'o haewani 'iti-tingkai. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Ngini 'asa niakisahe to 'ona manga 'ahuoka. 'O gota 'ido-dodowoko koma'iwa 'isowokino 'o 'anggur ma sowoko, de 'o sisika koma'iwa 'isowokino 'o 'ara ma sowoko. <figure style="fig" file="HK00111.pcx" size="col" ref="(7:16)">'O 'anggur ma sowoko</figure> <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />'O gota gee 'ibobo-bero ge'ena ma sowoko mita 'isure; ma gee ma bo-bero 'itorou, ge'ena ma sowoko mita 'itorou. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />'O gota 'ibobo-bero koi'iwa ma sowoko 'itorou, de 'o gota gee ma bo-bero 'itorou, koi'iwa ma sowoko 'isure. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />'O gota gee kiaka 'isowoko 'itorou, dua 'asa yatodanga de yositaulu 'o 'ukuka. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Koge'enali mita de 'o nabii yoelu-eluku, dua 'asa niakinako to 'ona manga 'ahuoka.&gt;&gt;<verse eid="MAT 7:20" /></para>
  <para style="s">Nadiai la 'uwa duga ka ma bicaraka</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk. 13:25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ko 'o nyawa 'iodumuwa gee kaitaurika yongose ngoino, &lt;Jou! Ngona to ngoi 'ai Jou!&gt;, ge'ena dua yodadi ma Jo'oungu ma Dutu wi kawasa, ma duga ka gee yomote-moteke 'ai Dea 'o sorogaaka wi mau. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Dua 'o dunia ma do-dogumoka, 'o nyawa manga gudai yongose ngoino, &lt;Jou! Jou! De to ngona ni ronga, ngomi miosihabariokau ma Jo'oungu ma Dutu wi besesongo, 'o tokata mioginiiki, de mita 'o gudai 'o no-nako 'ihera-herangi miodiai!&gt; <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Ma ngoi dua 'asa takisiti-tiaika tongose, &lt;Ngoi kotininakowa! Nimagoraika ne'enaka ngini gee nioti-tingkai.&gt; &gt;&gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Wimoi woca-cawaro de wimoi wohaga-haga 'o woa 'o utu yomamo-moi yodiai</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk. 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Nago'ona gee yo'isenoka 'ai demo ne'ena de yodomoteke, 'ona ge'ena 'isoka wimoi wi woa wodiai 'o teto ma dekuoka. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Gee 'ibesaka de yodungu'uisi, de mita yodarato, ma koirubawa sababu wosigoko 'o teto ma dekude.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />Ma 'o nyawa gee yo'isenoka 'ai demo ne'ena de koyamotekuwa, 'ona ge'ena 'isoka wohaga-haga wi woa wodiai 'o dowongioka. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Gee 'ibesaka de yodungu'uisi de mita yodarato, de ma woa ge'ena 'iruba so 'ipiakoro 'ibootoka.&gt;&gt;<verse eid="MAT 7:27" /></para>
  <para style="s">'O Yesus wi kuasa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Ma duanguku 'o Yesus wodotoko 'iduanga, de 'o nyawa yoku-kudai ge'enaka gee yoherangi ma sala yo'isene 'awi do-dotoko ge'ena. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Sababu 'una wodotoko ka de to 'una ma sirete wi kumati, 'isoka to 'onawa manga 'agamaka yodoto-dotoko.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">'O Yesus wosi'aiki wimoi wipado-pado</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mrk. 1:40-45</ref>; <ref loc="LUK 5:12-16">Luk. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />'O Yesus wo'utiku 'o gigieku daku, de 'o nyawa manga gudai wimoteke. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />De wimoi wipado-pado mita woboano de wobukuku 'o Yesus wi bionoka de wongose, &lt;&lt;Ee 'Aba! Nako nomodeke de noisi'aiki.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />De 'o Yesus wi'aoka de wongose, &lt;&lt;Ngoi tomodeke. So ne'ena tonisi'aiki.&gt;&gt; De kage'ena ma 'orasi de 'o nyawa gu'una wi panyake 'i'aiokau. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Ge'enaka de 'o Yesus widongose, &lt;&lt;Nongano-nganono! 'Uwa nosikademo ka moika ma, ma nosikaika 'o 'imamika de noga'asoko nilega la yanako ma gou-goungu 'ani panyake 'i'aiokau. Deika nosisuba 'o su-suba gee 'isoka 'o Musa wosulokokau ma no-nako 'o nyawaka 'ato ma gou-goungu 'ani panyake 'i'aiokau.&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">'O solodado ma balusu wi ro-riwo wimoi 'awi panyake 'o Yesus wosi'aiki</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk. 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Ma moi ge'ena 'o Yesus 'o Kapernaumoka waika, de 'o Romaka manga kapita woboa de womasiga'asoko wongose 'ato, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt; 'Aba! 'Ai ro-riwo wimoi woluguku so ka 'o dangiri ma dekuokau, de wosangisara ma sala.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Ge'enaka de 'o Yesus wongose, &lt;&lt;Ngoi 'asa taika towisi'aiki.&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />De ma kapita gu'una kawaporoongie, &lt;&lt; 'Etei! 'Aba, koyadaenuwa tonisingosama 'ai woaka, so kanosuloko duga la 'ai ro-riwo wi lugu ge'ena 'i'aiki. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Ge'ena 'isoka ngoioli, ngoi mita tosigisene 'ai dekude manga pareta, de ngoioka deuku de ma 'enali mita 'o tentara salingou yosigisene 'ai pareta. Nako ma tentara wimoi towisuloko, &lt;Notagi!&gt; ge'ena 'una mita wotagi, de nako tongose wimoikali, &lt;Nongoka naino!&gt;, 'una mita woboa. De nako tosuloko 'ai gilaongika, &lt;Neda nadiai!&gt;, ge'ena 'una mita wadiai.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />'O Yesus wo'isenoka koge'ena, de woherangi so wakisidemo gee wimote-motekino ge'enaka, &lt;&lt;Tinisidemo nginika, koma'iwasi tamake 'o ngo-ngaku kone'ena ma amooka 'o Israeloka. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Tinisidemoli, dua manga gudai yoboa dinaoko 'o wange ma siwaroko de daiisa 'o wange ma dumunisa, ma ngale yomarame de 'o Abraham, 'o Ishak, de 'o Yakub, ma Jo'oungu ma Dutu wi Dunia ma Sungioka.<verse eid="MAT 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 8:12" />'Ena momongo gee tanu yodadi ma Jo'oungu ma Dutu wi ngowa-ngowaka, 'ona ge'ena yakisisupu yaki'umo 'o darusika. Ge'enaka dau dua 'ona yo'ari de yosangisara.&gt;&gt; <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Ge'enaka de 'o Yesus wosuloko ma kapitaka gee, &lt;&lt;Noliou! 'Okia naga gee nangakuokau dua 'idadi.&gt;&gt;</para>
  <para style="p" vid="MAT 8:13">De kage'ena ma 'orasi de 'awi ro-riwo gu'una wi lugu 'i'aiokau.<verse eid="MAT 8:13" /></para>
  <para style="s">'O Yesus wakisi'aiki 'o nyawa manga gudai</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mrk. 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Ge'enaka de 'o Yesus wa'adonika 'o Petrus wi woaka, de womimake 'o Petrus ma toroa moma'iduoka 'o dangiroka sababu migogamino. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Ge'enaka de 'o Yesus wa'ao mi giamika, de mi panyake ge'ena 'i'aiokau so momomikie de mileleani.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />'Iobirou, de 'o nyawa yakitoka-tokata manga gudai yaki'asa 'o Yesusino, de ka 'o betongo moi woginiiki ma tokata ge'ena, de wosi'aiki manga panyake. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Koge'ena 'idadi la 'isoka ma Nabii Yesaya wosidemokau, &lt;&lt; 'Una wamoku to ngone nanga sangisara, de wosi'aiki to ngone nanga panyake!&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">'O nyawa gee yomau yodadi 'o Yesus wi do-domoteke</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk. 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Ma moi ge'ena 'o Yesus wakimake 'o nyawa manga gudaioka wisigilolitino, de wosuloko wi do-domoteika la yosikaika doka 'o talaga ma songonaka. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ge'enaka de 'o Yahudioka manga 'agamaka wodoto-dotoko wimoi woboa de kawongosekau 'o Yesusika, &lt;&lt; 'Aba Guru, ngoi tonimoteke kiaka naga bato!&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />De 'o Yesus wosango, &lt;&lt; 'O haewani 'o joro yabi-binasa mita de ma 'arukoka, de 'o namoro gee kopapi-piarawa mita de ma 'igutu, ma 'o Nyawa ma Ngowaka wi ngii womasiruba-ruba koi'iwa.&gt;&gt;<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />De 'o Yesus wi do-domoteke wimoi wongose, &lt;&lt; 'Aba! Tanu tolio 'ai dea towipo'osuikasi 'isira.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ma 'o Yesus wosango, &lt;&lt;Noimoteke! Madaka la 'o nyawa gee koyamote-motekuwa ma Jo'oungu ma Dutu 'awi mau yapo'osuku manga nyawa 'isonge-songene.&gt;&gt;<verse eid="MAT 8:22" /></para>
  <para style="s">'O Yesus 'o rato wosiogoro</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mrk. 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ge'enaka de 'o Yesus 'o ngo'otiruku woparene, de wi do-domoteke mita yomoteke. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />De kayasorogano 'irato ge'ena ma talagaka so manga ngo'otiri 'o moku-moku yapoka, 'ena ma 'orasi ge'ena 'o Yesus woma'iduoka. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />So wi do-domoteke yaika witomanga yongose 'ato, &lt;&lt; 'Aba! Noriwosi, polutuou so!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />De 'o Yesus wongose 'onaka, &lt;&lt; 'Ido'oa so nimodongo? Ngini koningakuwa rekeni!&gt;&gt; Ge'enaka de 'o Yesus woma'okode de wodorofu 'o rato de 'o talaga ge'ena, de ma talaga ge'ena 'iriidokau.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />So wi do-domoteke yoherangi de yongose, &lt;&lt; 'Una ne'ena ma kia, sigado 'o rato de 'o talaga ma wisingounu?&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">'O Yesus 'o tokata woginiiki</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mrk. 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Ya'adonika doka ma talaga ma songonaka 'o Gadara ma daeraaka, de yamididi yakitokatuku 'o bo'osuku ma sukonino doka yosupu, yaino 'o Yesusino. 'Ona manga singina kaifoloi 'isauku so komoiwa moi yomoroini yaboa ge'enano. <figure style="fig" file="LB00303.tif" size="span" ref="(8:28)">'O nyawa gee 'o tokata widongosamuku wosupu 'o bo'osukino</figure> <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />De yomapoa-poaka, &lt;&lt;Ee ngona ma Jo'oungu ma Dutu wi Ngowaka! Dua minido'oau ngomino? 'Ato nomau minisisangisarau ngaro ko ma 'orasuawasi ma?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Ge'enaka 'ena koikurutikawa 'o juku 'o gudaioka ma 'inomo 'imadononu. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />'O ngomasa ma dorou ge'ena 'imasiga'asoko 'o Yesusika, &lt;&lt;Nako dua nosuloko miosupu, de yaowa nosuloko 'o titika miosikaika.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />De 'o Yesus wongose, &lt;&lt;Niosupuka!&gt;&gt; De ma ngomasa ma dorou ge'ena 'ikokisupu 'o nyawa yamididioka de 'isikaika 'o juku ma gu-gudaika. De ma juku ge'ena ma 'ikokiowara de 'iotaka 'o ba-bawatuku so dau 'o talagaka 'ilutuku.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />So ma juku yopi-piara go'ona yoowara 'o kotaka de yosijarita 'okia naga yamakekau ge'ena, mita gee 'o nyawa yamididi 'o ngomasa ma dorou yakido-dongosamuku. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />So ma kotaka ge'ena yomasidobootoka yotagi 'o Yesusika. De ge'enaka yaika de yogegoto la 'o Yesus wamadakau manga daeraaka.<verse eid="MAT 8:34" /></para>
  <para style="rem">Penyuntingan: Ning 7-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">'O Yesus wosi'aiki 'o nyawa wimoi wolugu-lugu 'o Kapernaumoka</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mrk. 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />'O Yesus wongo'otiri 'o talaga watoaka wolio doka 'awi soanika. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ge'enaka doka de yamuruo naga yoboa 'o Yesusino wi'asa wolugu-lugu wimoi wi kokowaka witigirangisa. Gee 'o Yesus wakimake to 'ona manga ngo-ngaku ma guatoka, de wongose wolugu-luguka gee, &lt;&lt; 'Ai ngowaka, 'uwa ni singina 'i'ogu! Ni so-sowono ta'ikirokau.&gt;&gt;<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />'O Yahudioka manga 'agamaka yodoto-dotoko yamuruo naga ge'enaka gee ka manga singinaka, &lt;&lt; 'O nyawa nu'una ma Jo'oungu ma Dutu wisiti-tingoono.&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />'O Yesus wanako manga singina ma dodaka so wongose, &lt;&lt; 'Ido'oa so nia di-dibangi koge'ena ma dorou? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ka'ena 'ifoloi 'igapangi tongose wolugu-luguka, &lt; 'Ani so-sowono tosi'aikokau!&gt; bolo, &lt;Nomomikie de notagiou!&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ma ne'ena dua tosidumutu nginika 'ato 'o duniaka ne'ena 'o Nyawa ma Ngowaka wopareta 'o so-sowono wa'ikiri.&gt;&gt; Ge'enaka de wolugu-luguka wongose, &lt;&lt;Noma'okodeu, ni kokowa nagoraka la noliou!&gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />De wolugu-lugu gu'una woma'oko so wolio wi woaka. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />So gee yamake ge'ena 'idadi, de yakimodongo de ma Jo'oungu ma Dutu wisiarene sababu wokulakau wi guata koge'ena ma amoko 'o nyawaka.<verse eid="MAT 9:8" /></para>
  <para style="s">'O Yesus 'o Matius wi'asoko</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mrk. 2:13-17</ref>; <ref loc="LUK 5:27-32">Luk. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Gee 'o Yesus womagoraka ge'enaka dau so wotagika de wimake 'o pajaki woga-ga'asoko wimoi wi ronga 'o Matius. 'Una wogogerie 'o pajaki yoga-ga'asoko ma woaka. So 'o Yesus wongose, &lt;&lt;Nou, noimoteke!&gt;&gt;</para>
  <para style="p" vid="MAT 9:9">De 'o Matius kawoma'oko de wimotekokau 'o Yesus.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Gee 'o Yesus wo'odomo ma gu-gudaioka 'o Matius wi woaka, de manga gudai yoboa 'o balasitengi yoga-ga'asoko de 'o nyawa gee 'o kawasa yakimakeka 'o nyawa ma dorou, yomasido'odomo de 'o Yesus de wi do-domoteke. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />De 'o Farisioka yakimake de yongose 'o Yesus wi do-domoteika, &lt;&lt; 'Ido'oa so nia Guru de 'o balasitengi yoga-ga'asoko de 'o nyawa ma do-dorou yomasido'odomo?&gt;&gt;<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />De 'o Yesus wo'isene yosano koge'ena so wongose 'ato, &lt;&lt; 'O nyawa ma guata koyoparaluuwa 'o dotere, ma 'ena gee yopa-panyake. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />So tagi niatibangi kokia ma ngale 'o Buku 'Itebi-tebini ma demo ne'ena: &lt;Ngoi kotoduakuwa 'o su-suba 'o haewani, ma 'ena 'o dora.&gt; Sababu ngoi taino kotaki'asokuwa 'o nyawa ma owa, ma 'ena gee yosowo-sowono.&gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">'O puasa</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mrk. 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ge'enaka de 'o Yohanes Wo'osi-'osiki wi do-domoteke yaino 'o Yesusino yosano, &lt;&lt; 'Ido'oa so ngomi de 'o Farisioka 'ijaga miopuasa de 'ani do-domoteke 'ona ko'uwa?&gt;&gt;<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />De 'o Yesus wosango, &lt;&lt; 'O nyawa yaki'aso-'asokino 'o ngaamoko ma rameka, nako ma 'orasi wonga-ngaamoko ge'enakasi, ge'ena dua manga singina 'isusa? Ma gee dua ma 'orasi kowi'iwau, 'asa de yopuasa.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Komoiwa 'o mosa ma siraka de ma sungi yosipata, sababu ma ba-bata ge'ena dua 'isikaino 'itingoono de yatobaka so 'ifoloi 'iracanga. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Koge'enali mita 'o 'anggur ma sungi koidadiwa posinoa ma ngii<note caller="b" style="f"><char style="fr" closed="false">9:17: </char><char style="ft" closed="false">'O Yahudioka manga 'anggur ma ngii, ge'ena 'o haewani ma kai yadiaiku.</char></note> ma siraku, sababu dua yosidopotoka de 'ipoaka. So 'o 'anggur ma sungi salingou posinoa ma ngii ma sungiku, la ma 'anggur de ma ngii ge'ena koyado'oawa.&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">'O Yesus 'o ngeweka mimoi womisi'aiki de mimoi misiwangoli</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mrk. 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />'O Yesus wobicara ma gu-gudaioka 'o Yohanes Wo'osi-'osiki wi do-domoteika, de 'o lo-lomu ma woa ma balusu wimoi woboa de wobukuku 'o Yesus wi bionoka 'asa de wongose, &lt;&lt; 'Ai ngowaka mimoi 'asa kamosongenuku, so tanu noboa moni'aosi la mowangoli!&gt;&gt;<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />'O Yesus de wi do-domoteke yoma'oko so wimoteke 'o nyawa gu'una.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="MAT 9:20-21" />Manga do-dagi ma sigoronaka de mimoi 'ami 'aunu 'ijaga 'itagi ma do'ingo 'o taunu mogiooko de modidiou, momasisori 'o Yesus wi dudunino. Muna matibangi 'ato, &lt;&lt;Ngaro ka wi jubaka tatigi ma dua 'ai panyake 'i'aiki.&gt;&gt; Ge'enaka de matigi 'awi baju 'ikuru-kurutuku ma barenika.<verse eid="MAT 9:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />De ma 'orasi ge'ena 'o Yesus womadutumu de womimake 'o ngeweka gumuna de kawongosekau munaka, &lt;&lt; 'Ai ngowaka! 'Uwa ni singina 'i'ogu, sababu noingaku so ni panyake 'i'aiki!&gt;&gt; De kage'ena ma 'orasi de mi panyake ge'ena 'i'aiokau.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />'O Yesus woboa 'o lo-lomu ma woa ma balusu wi woaka, 'ena yosuling de yogaribetongo ma gu-gudaioka. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />De 'o Yesus wongose 'onaka, &lt;&lt;Niosupuka nioodumu, sababu 'o ngowaka numuna komosongenuwa kamiki'ookoka.&gt;&gt;</para>
  <para style="p" vid="MAT 9:24">Ge'enaka de 'ona wirisela. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />'O nyawa yoku-kudai go'ona yakiginiioka, de 'o Yesus wowosama so 'o ngowaka gumuna mi giamika wa'ao de momomiki. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />So ma habari ge'ena 'itagi ma daeraaka ge'ena yasuluunuku.<verse eid="MAT 9:26" /></para>
  <para style="s">'O Yesus wakisi'aiki yamididi yorau-rau</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />'O Yesus womagoraka ge'enaka, de 'o ngekomoka de yorau-rau yamididi wimoteke. 'Ona yomasigaso-gasoko, &lt;&lt;Ee Dautu wi Ngowaka! Minidoranosi!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Gedagee 'o Yesus wowosamika 'o woa moioka, de yorau-rau yaino 'o Yesusino de wongose 'onaka, &lt;&lt;Niongaku? 'ato ngoi 'idadi tinisilaha?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">De 'ona yosango, &lt;&lt;Miongaku, 'Aba!&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Ge'enaka de 'o Yesus wa'ao manga akoka de wongose, &lt;&lt;Sababu niongaku, 'idadi moteke to ngini nia mau.&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Ge'enaka de yomasimakekau. 'O Yesus wakisitiari, &lt;&lt; 'Uwa niosikademo ma hali ge'ena ka moika ma.&gt;&gt;<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Ma gee yotagika de yosikawasa ge'ena ma daeraa yasuluunuku.<verse eid="MAT 9:31" /></para>
  <para style="s">Womou-mou 'idadi wobicara</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Yorau-rau yopasaka, de wimoi womou-mou 'o tokata widongosamuku wi'asa 'o Yesusino. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />'O Yesus woginiioka ma tokata ge'ena, de 'idadiokau wobicara. So 'o nyawa yoku-kudai ge'enaka yoherangi de yongose, &lt;&lt;Koma'iwasi miamake kone'ena 'idadi 'o Israeloka.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ma 'o Farisioka yongose, &lt;&lt; 'O Tokata ma Koana wikulaka 'o guata ma ngale wosikiniiki 'o tokata.&gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">'O Yesus wakisingina wakimake 'o nyawa manga gudai</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Koge'enau 'o Yesus wotagi 'o kota de 'o soana wanga-ngaimoi. 'Una wodotoko 'o lo-lomu ma woa-woaka, de wositotara 'o Habari ma Owa ma ngale ma Jo'oungu ma Dutu wopareta. 'Una wakisi'aiki 'o nyawa manga panyake 'i'ini-'inioka, de yobo-bolohi. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Gedagee 'o Yesus wakimakeka 'o nyawa yoku-kudai go'ona de wakisingina sababu koyomasinakowau de koyomado-do'oawau, so 'isoka 'o domba komoiwau yapiara. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ge'enaka de 'o Yesus wongose 'awi do-domoteika, &lt;&lt; 'I'umukukou ma amooka ma yo'utu-'utuku ka munukaka. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Sababu ge'ena nioga'asoko ma Bairi ma Dutuka la wakisidingoto yo'utu-'utuku.&gt;&gt;<note caller="c" style="f"><char style="fr" closed="false">9:38: </char><char style="ft" closed="false">Bolo: &lt;&lt; 'O nyawa ne'ena naga manga gudai yomau yosigisene 'o Habari ma Owa matero ka 'o bira 'i'umuuku ma amokoka, ma yo'utu-'utuku ka munukaka. Sababu ge'ena, nioga'asaoko ma bairi ma dutuka ge'ena la ma Jo'oungu ma Dutu, la wakisidingoto yoma-manarama ma ngale ya'utuku.&gt;&gt;</char></note><verse eid="MAT 9:38" /></para>
  <para style="rem">Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">'O su-suloko yamogiooko de modidi</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mrk. 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Ma moi ge'ena 'o Yesus 'awi do-domoteke yamogiooko de modidi wakitoomu. Ge'enaka de wakikula 'o guata ma ngale yoginiiki 'o ngomasa ma do-dorou de yosi'aiki 'o panyake de 'o roese ma bolohi 'i'ini-'inioka. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />'O su-suloko yamogiooko de modidi go'ona manga ronga-ronga konee: Ma di-disiraka, 'o Simon gee wisironga mita 'o Petrus, de ma dodoto 'o Andreas, ge'enaka de 'o Yakobus de ma dodoto 'o Yohanes, ge'ena la 'o Zebedeus wi ngowa-ngowaka. <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Ge'enaka de 'o Filipus de 'o Bartolomeus, 'o Tomas, de 'o Matius 'o balasitengi woga-ga'asoko, de 'o Yakobus 'o Alfeus wi ngowaka, 'o Tadeus, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />de 'o Simon 'o Zelot ma nyawa,<note caller="d" style="f"><char style="fr" closed="false">10:4: </char><char style="ft" closed="false">'O Zelot ma nyawa ge'ena la 'o Yahudioka 'o paratei moi gee yomariwo-riwo 'o Romaka yakiginiiki.</char></note> de 'o Yudas Iskariot gee 'o Yesus wiwuku-wukunu.<verse eid="MAT 10:4" /></para>
  <para style="s">'O su-suloko manga manarama</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mrk. 6:7-13</ref>; <ref loc="LUK 9:1-6">Luk. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Ge'enaka de 'o su-suloko yamogiooko de modidi 'o Yesus wakisuloko de wakisibesesongo koneda: &lt;&lt; 'Uwa niaika gee ko 'o Yahudiokawa manga daeraaka de mita 'o Samaria manga soa-soanika. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ma niosikaika 'o Israelika gee yoliba-libaka. 'Ona 'isoka 'o domba ma dutu koi'iwa. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Niositotara 'onaka ma ngale ma Jo'oungu ma Dutu wacobou wopareta. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Niakisi'aiki 'o nyawa gee yopa-panyake; niakisiwango 'o nyawa gee yosonge-songenuku; niosi'aiki 'o nyawa yakipado-pado de nioginiiki 'o ngomasa ma dorou. Ngini niadawongokau ge'ena 'iodumu koniofanguwa. So, niokula mita ma bo-bangu koi'iwa. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />'Uwa nio'asa 'o pipi 'o guraci, 'o pipi 'o saaka, bolo 'o pipi 'o tambaga. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Mita 'uwa nio'asa nia tasi, bolo nia ga-gali nia do-dagioka, bolo nia tarupa bolo nia papadi. Sababu 'o nyawa yomanarama ge'ena ma raiokau yakikula 'okia naga yoparaluu.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Nako ngini niototarika 'o kotaka bolo 'o soanoka, nianonu 'o nyawa moi gee yomodeke nimasido-dogumu. Niomanoa de de 'ona sigado niotagioli. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Gee niowosama manga woaka, de niakitabea. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Nako 'o woa ma dutu go'ona nidawongo, madaka la nia tabea ge'ena naga 'onaka. Ma nako 'ona konisidabinowa, niosigilioli nia tabea ge'ena.<note caller="e" style="f"><char style="fr" closed="false">10:13: </char><char style="ft" closed="false">'O Yahudioka ma nyawa yongose 'ato nako yosigilio manga tabea dua 'o nyawa 'o barakati kayamakewa.</char></note> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nako naga 'o woaka bolo 'o kotaka konisidabinowa bolo konisigisenuwa, niamadaka ma ngii ge'ena de nia dou ma soata ma kakawo niodabarisuku ge'ena ma ngale ngini niakiitomokau 'ona. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Niosi-singina! 'O dunia ma do-dogumoka, 'o Sodom de 'o Gomora ma nyawa dua manga hukumani 'ifoloi 'iku'arene de gee 'o kota ge'ena!&gt;&gt;<verse eid="MAT 10:15" /></para>
  <para style="s">'O sikisaa dua 'iboa</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mrk. 13:9-13</ref>; <ref loc="LUK 21:12-17">Luk. 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />&lt;&lt;Niosi-singina ne'ena: Ngoi tinisuloko 'isoka 'o domba 'o haewani 'iti-tingkai ma 'igutika. Ngini salingou niocawaro 'isoka 'o ngia de nia singina yaowa 'isoka 'o namoro 'o pombo. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Nimajaga-jaga sababu ngini dua nitagoko de ni'asa 'o 'agama ma balu-balusika. Ngini 'asa nipesana 'o lo-lomu ma woa-woaka. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Ngini dua ni'asa yopa-paretaka de 'o koa-koanika sababu ngini to ngoi 'ai do-domoteke. De ge'enau ma 'orasi ngini niokula 'o sakisii ma ngale ngoi 'onaka de mita 'o nyawa gee ma Jo'oungu ma Dutu kowinako-nakokawa. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ma nako ngini nisitaari 'o hakimika, 'uwa niododato ma ngale 'okia dua salingou niongose, bolo niosibicara, sababu 'okia naga dua gee salingou niongose, dua nisidemo gee ma 'orasi ya'adono de. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Sababu niobicara ma 'orasi ge'ena, ge'ena ko nginiwa ma sirete ma 'ena 'ania Dea 'o sorogaaka wi Ngomasa.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Dua 'asa 'idadi 'o nyawa manga 'esa moi ma dutu yakidukula 'o nyawaka la yakito'oma. De mita dua koge'enali 'idadi naga 'o dea de 'o ngowaka. 'O ngowa-ngowaka 'asa yomalawani manga 'esa de manga deaka, de yakidukula 'o nyawaka la yakito'oma. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ngini 'asa 'o nyawa 'iodumu nidu'uduku sababu ngini to ngoi 'ai do-domoteke. Ma nago'ona yomatongosono sigado ma do-dogumika, 'ona 'asa yakisilaha. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Nako ngini nisikisaa naga 'o kota moioka, ge'ena nioowara 'o kota 'iregukali. De ngoi tinisidemo, dua koniabootuawasi niodongosama 'o Israeloka ma kota-kotaka, 'ena 'o Nyawa ma Ngowaka woboakauoli.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />'O do-domoteke koyofoloidewa de 'o guru, de 'o ro-riwo koyodaduiewa de manga balusu. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Yaowakau nako 'o do-domoteke moi yodadiokau 'isoka 'o guru, de 'o ro-riwo 'isoka manga balusu. Nako 'o woa moi ma balusu wisirongakau 'o Beelzebul,<note caller="f" style="f"><char style="fr" closed="false">10:25: </char><char style="ft" closed="false">Ge'ena 'o Tokata ma Koana ma ronga moioli.</char></note> de dua ma woa ma dodakoli? Dua 'onasi 'ifoloi 'o ronga 'ito-torou yakisironga!&gt;&gt;<verse eid="MAT 10:25" /></para>
  <para style="s">Powidomodongo ma Jo'oungu ma Dutuka</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk. 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt; 'Uwa nimodongo 'o nyawaka. Koi'iwa naga isigi'iunino gee dua koyamakewa, de koi'iwa naga 'isibongonino gee dua koisupuwa. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />'Okia naga gee tinisidemo 'o sakautuoka, salingou niositotaroli 'o wangeka. De 'okia naga gee tinisisudu nia ngauika, niosikawasa kiaka naga bato! <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />'Uwa niakidomodongo 'ona gee yato-to'oma nia roese, ma koya'akunuwa yado'oanikia nia jiwa. Salingou winidomodongo ma Jo'oungu ma Dutu gee wokuasa wabinasa nia roese de mita nia jiwa 'o 'ukuoka gee koisonge-songenuawau. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />'O tui-tui 'o ngai modidi 'idadi posi'ija de 'o pipi ma etaka. Ngaro koge'ena ma ka 'o ngai moi ma koi'iwa 'iotaka 'o tonauku nako nia Dea kowomauwa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />De ngini nia utu nia saeoka ma 'idoimukou 'iodumu. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Sababu ge'ena 'uwa nimodongo! Ngini 'ifoloi niobaraguna de 'o tui-tui!&gt;&gt;<verse eid="MAT 10:31" /></para>
  <para style="s">Yomangaku 'ona de 'o Yesus 'o kawasaka</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk. 12:8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />&lt;&lt;Nago'ona yomangaku 'ato 'ona ge'ena to ngoi 'ai do-domoteke 'o kawasa ma bionoka, ngoi mita 'asa tomangaku 'onaka 'ai Dea 'o sorogaaka wi bionoka. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ma nago'ona yomadidumu 'o kawasa ma bionoka 'ato 'ona ko to ngoiwa 'ai do-domoteke, ngoi mita 'asa koge'enali 'onaka 'ai Dea 'o sorogaaka wi bionoka.&gt;&gt;<verse eid="MAT 10:33" /></para>
  <para style="s">Ko 'o go-gasa ma owawa ma 'ena 'o galawani</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk. 12:51-53</ref>, <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt; 'Uwa niongose 'ato ngoi toboa 'o duniano ne'ena ge'ena dua ngini nimakasanangi. Ngoi toboa ge'ena dua 'idadi galawani so nimakati-tingaka. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ngoi toboa so ma rai 'o ngowa-ngowaka 'o nauru koyakisingounuwa manga deaka, 'o ngowaka 'o ngeweka koyakidomotekuwa manga 'esaka, de 'o dungunu 'o gooka koyosingounuwa manga dungunu 'o berekika. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Dua 'asa 'idadi 'o saturuu ma amoko ge'ena la ka 'o woa ma dodaku!<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />'O nyawa gee yosibosono manga balusika 'ifoloika de ngoino, koyadaenuwa yodadi to ngoi 'ai do-domoteke. Koge'enali mita 'o nyawa gee yosibosono manga ngowaika 'ifoloika de ngoino. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />De 'o nyawa gee yooluku yamoku 'o salip de koimotekuwa, koyadaenuwa yodadi 'ai do-domoteke. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Nago'ona gee manga 'ahu yariwo, dua manga 'ahu 'iisanga, ma nago'ona manga 'ahu 'iisanga sababu yosingounu ngoino, 'asa yamake 'o 'ahu.&gt;&gt;<verse eid="MAT 10:39" /></para>
  <para style="s">'O 'ahu yaowa-owa ma parasengi</para>
  <para style="r">(<ref loc="MRK 9:41">Mrk. 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;Nago'ona nidawongo ngini, ge'ena ma ngale 'idawongo ngoi. De nago'ona 'idawongo ngoi, ge'ena ma ngale widawongo 'una gee woisulo-suloko. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />'O nyawa gee yadawongo 'o nabii sababu yanako 'o nabii, 'asa yamake 'o nabii ma parasengi. De nago'ona yakidawongo 'o nyawa gee manga singina 'ibo-boooto sababu yanako manga singina 'iboooto, 'asa yamake to 'ena ma parasengi. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nago'ona yakisi'okere 'o nyawa gee kokiawa yakidae-daene ngaro ka 'o 'akere ma somoa ma sababu 'ona to ngoi 'ai do-domoteke, niongano-nganono ma raiokau 'ona 'asa yamake ma parasengi!&gt;&gt;<verse eid="MAT 10:42" /></para>
  <para style="rem">Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">'O Yohanes wi do-domoteke</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk. 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />'O Yesus wakisibesesongo 'iduanga wi do-domoteke yamogiooko de modidika, de wotagi wodotoko de wosihabari ma Jo'oungu ma Dutu wi demo 'o soa-soana gee kage'ena ma kakadate-dateoka.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />'O Yohanes Wo'osi-'osiki 'o buioka de wogi'isene ma Kristus wi manarama, de wi do-domoteke yamuruo naga wakisuloko yaika yosano, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />&lt;&lt; 'Aba, ngonau ne'ena? gee ma Jo'oungu ma Dutu wojajiokau 'ato dua wimoi woboa? Bolo salingou 'o nyawa 'ireguosi miodamaa?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />De 'o Yesus wosango 'onaka, &lt;&lt;Niolio 'o Yohanesika de niosidemo 'okia niamake de nio'isene, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ma ngale yopilo-piloko yomasimake, yolugu-lugu 'idadi yotagi, yakipado-pado manga panyake 'i'aiki, de yakito-topongono yomasi'isene, yosonge-songenuku yomomiki, de yosusa-susaka 'o Habari ma Owa ma Jo'oungu ma Dutuno 'isitotara. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Yosanangioka 'o nyawa gee manga singina koikapulawa ngoino so koiitomuwa!&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />'O Yohanes wi do-domoteke yolioka, de 'o Yesus wokurue wobicara 'o nyawa yoku-kudaika ma ngale 'o Yohanes, wongose 'ato, &lt;&lt;Tosanosi nginika! Ngini niotagi 'o tonaka 'ika-kakasaka ma ngale 'okia niodo'oa? Winilega 'o nyawa wimoi 'awi singina kairiiduwa 'isoka 'o 'ubutu 'o dadoko yauwa-uwaka? Ma rai ko'uwa! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Bolo niotagi 'okia nialega? Wimoi wi baju 'isure-sure? 'O nyawa manga baju 'isure-sure ge'ena yogogere 'o kadatoka! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />So 'okia niodo'oa ngini niotagi? Winilega 'o nabii wimoi? Ma goungu, 'unasi 'ifoloi woamoko de 'o nabii. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Sababu 'o Yohanesikau ma dumutu 'o Buku 'Itebi-tebinoka 'ingose,</para>
  <para style="q1" vid="MAT 11:10">&lt;Nu'una to ngoi 'ai demo wositota-totara,</para>
  <para style="q2" vid="MAT 11:10">'una towisuloko wosirano de de ngona,</para>
  <para style="q2" vid="MAT 11:10">la ni ngekomo woniditiai.&gt;<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Niongano-nganono! 'O duniaka ne'ena komoiwa moi 'ifoloi yoamoko de 'o Yohanes Wo'osi-'osiki. Ngaro koge'ena, ma 'o nyawa gee 'ifoloi yotingoono ma Jo'oungu ma Dutu wi pareta ma sigoronaka, 'ona 'ifoloi yoamoko de 'o Yohanes. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Kaikurue 'o Yohanes wosihabari 'awi do-dotoko sigado ne'ena naga munuka yokiniiki ma ngale yomau 'itaiti yosigokoli ma Jo'oungu ma Dutu wi pareta. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Sigado 'o Yohanes Wo'osi-'osiki woboa, 'iodumu 'o Musa wi besesongo de 'o nabii manga do-dotoko 'isidemosirakau 'okia naga gee salingou 'idadi. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />De nako ngini niomau niongaku, 'o Yohanes ge'ena la 'o Elia, gee wi bo-boa 'isidemosirakau. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nako de nia ngaukoka, nio'isenika!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />De 'okia salingou tositero 'o nyawa ma 'orasi ne'ena? 'Ona 'isoka 'o ngowa-ngowaka yogogerie 'o pasarioka. 'O bolu moi yongose 'ireguka, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />&lt;Ngomi minidababoka 'irame-rame ma ngini koniosodawa! Ngomi mionyanyi 'o balisa ma nyanyi ma ngini koniobalisawa!&gt; <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />'O Yohanes woboano 'ijaga wopuasa. 'Una 'o 'anggur kowa'oke-'okeruwa. De 'o nyawa yongose 'ato, &lt; 'Una 'o tokata widongosamuku.&gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Ne'ena 'o Nyawa ma Ngowaka woboano, 'una wo'odomo ma de wo'okere de yongose, &lt;Winimake 'o nyawa gu'una! 'Una witopokana de witaba'eto. 'Una 'o balasitengi yoga-ga'asoko de yosowo-sowono manga manai.&gt; Ngaro koge'ena, ma 'o di-dibangi 'isure-sure ma Jo'oungu ma Dutuno, 'inyata naga 'o nyawa manga gokoieka.&gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">'O kota-kota gee ma nyawa koyongaku-ngakuwa</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk. 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Ge'enaka de 'o Yesus wokurue wakisitobionika 'o kota-kotaka gee koyotoba-tobawa 'o sowono yodiai, ngaro ge'enaka 'ifoloi 'ikudai 'o no-nako 'ihera-herangi wodiai ma. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />&lt;&lt;Niotorouoka ngini 'o Korazim ma nyawa de 'o Betsaida ma nyawa! Sababu nako 'o no-nako 'ihera-herangi 'isoka nginioka ne'ena la 'idadiokau 'o Tirusoka de 'o Sidonioka, tanu 'ona ma do'ingou yotoba 'o sowono yodiai de yomasinoa 'o balisa ma pakeangi de manga mumuoka 'o kakawo yodonoaku. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Niongano-nganono! 'O dunia ma do-dogumoka dua, 'o Tirus de 'o Sidon 'ifoloi 'iku'arene manga hukumani de to ngini ne'ena! <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />De ngini 'o Kapernaumoka! Ngini dua dakuou sigado 'o diwangoka? Ko'uwa! So 'ena dua 'o narakaka ni'umo. Sababu nako 'o Sodomioka la 'idadiokau 'o no-nako 'ihera-herangi gee 'isoka nginioka, tanu 'o kota ge'ena sigado ne'ena ka de ma 'enasi! <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Niongano-nganono! 'O dunia ma do-dogumoka dua 'o Sodom ma nyawa 'ifoloi 'iku'arene manga hukumani de to ngini ne'ena!&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Nou niaino ngoino</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk. 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ma 'orasi ge'ena 'o Yesus wolahidoa, &lt;&lt; 'Aba Jou, gee napareta 'o diwanga de 'o dunia! Ngoi to'alele, sababu 'iodumu ne'ena ngona konosidumutuwa 'o nyawaka gee yomamaoku yobarija de yanako 'o sagala moi-moi, ma ngona nosidumutu kiaka naga gee 'o nyawa yakimakeka koyoba-barijawa. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ge'enau 'ani singina yadaene 'Aba.&gt;&gt;<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Ge'enaka de 'o Yesus wongose, &lt;&lt; 'O sagala moi-moi 'ai Dea woisidukulakau. De komoiwa moi ngoi 'inako, duga ka 'ai Dea. De komoiwa moi 'ai Dea winako duga ka 'awi Ngowaka, de nago'ona gee 'o Ngowaka gu'una wakisinako.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Nou, niaino ngoino nioodumu gee nioka-kangela de niamao nia gina 'itu-tubuso. Ngoi 'asa tinisisanangi. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Niamoteke 'ai pareta de nimadotoko ngoino. Sababu ngoi 'ai singina 'ima'ai, so ngini 'asa niamao niosanangi. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Sababu 'ai pareta ge'ena nisisanangi de nia gina tinikula mita 'iku'arene.&gt;&gt;<verse eid="MAT 11:30" /></para>
  <para style="rem">Penyuntingan: Ning 8 Juli 2008</para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">'O Farisioka yomaributu de 'o Yesus ma ngale Pomaoma-omasa ma Wange</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mrk. 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ma moi ge'ena 'o Yahudioka Pomaoma-omasa ma Wange, de 'o Yesus de wi do-domoteke 'o gandum ma bairino yaboa, de wi do-domoteke 'o gandum yo'utuku de ya'odomo sababu yakisawini. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />'O Farisioka yakimake de yongose 'o Yesusika, &lt;&lt;Nakilega! 'Ani do-domoteke yaparene to ngone nanga 'agama ma besesongo, ma ngale yadiai gee koidadiwa Pomaoma-omasa ma Wangeka.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />'O Yesus wosango 'onaka, &lt;&lt;Koniabacawasi? gedagee 'okia 'o Dautu wodiai ma 'orasi 'una de gee wimote-moteke yakisawini? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />'Una wowosama ma Jo'oungu ma Dutu wi Woaka, de 'una de wimote-moteke go'ona ya'odomo 'o roti gee 'isisubakau ma Jo'oungu ma Dutuka. 'Ena momongo moteke to ngone nanga 'agama ma besesongo, 'ona koidadiwa, salingou ka 'o 'imam-'imam duga. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Bolo 'o Musa wi buku koniabacawasi? Ge'ena la Pomaoma-omasa ma Wange 'isinoi-noimi 'o 'imam-'imam gee yoleleani ma Jo'oungu ma Dutu wi Woaka, ngaro yaparene Pomaoma-omasa ma Wange ma besesongo, ma koyakisisalawa. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Niosigisene niosidi-diai 'okia tosidemo ne'ena, ne'enaka naga wimoi 'ifoloi wobaraguna de ma Jo'oungu ma Dutu wi Woa, ge'ena la ngoi. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />'O Buku 'Itebi-tebinoka 'isilefoku: &lt;Ko 'o su-suba 'o haewaniwa toduaka, ma 'ena 'o dora.&gt; Nako la ngini niasahe 'ai demo ge'ena, ma rai 'asa koniakisisalawa 'o nyawa gee manga sala koi'iwa. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Sababu 'o Nyawa ma Ngowaka 'una wapareta Pomaoma-omasa ma Wange.&gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">'O nyawa wimoi wi giama ma songona 'isonge-songene</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mrk. 3:1-6</ref>; <ref loc="LUK 6:6-11">Luk. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />'O Yesus woma'aiki ge'enaka de wotagi 'o lo-lomu ma woaka. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Ge'enaka dau wimoi wi giama ma songona 'isonge-songene. Yamuruo naga ge'enaka dau 'o Yesus wi sala yosinonu-nonu, yosano 'o Yesusika, &lt;&lt;Pomaoma-omasa ma Wangeka de 'o nyawa manga panyake posi'aiki, kaidadi?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />'O Yesus wosango, &lt;&lt;Nako la Pomaoma-omasa ma Wangeka de nia domba moi 'iotauku 'o jurupongoka de dua kaniosidipidilika? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />'O nyawa 'ifoloi 'ibaraguna de 'o domba, so kaidadi podiai yaowa-owa Pomaoma-omasa ma Wangeka.&gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Ge'enaka de 'o Yesus wongose 'o nyawa wi giama ma songona 'isonge-songenika gu'una, &lt;&lt;Ni giama naboootika.&gt;&gt;</para>
  <para style="p" vid="MAT 12:13">'O nyawa gu'una wi giama waboooto de koisongenuawau so 'idadi 'isoka ma songonau gee. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Ge'enaka de 'o Farisioka yosupu 'o lo-lomu ma woaka ge'ena de yomasikagaro 'o Yesus wito'oma.<verse eid="MAT 12:14" /></para>
  <para style="s">'O ro-riwo gee ma Jo'oungu ma Dutu wiiri-iriki</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />'O Yesus wanako 'o Farisioka manga singina 'itorou 'unaka, so woma'aiki ge'enaka de manga gudai wimoteke, de wosi'aiki to 'ona yoodumu manga panyake. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Ma 'una kowakisidabiwa 'ona yosikawasa 'ato 'una ge'ena nagu'una. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Koge'ena 'idadi ma ngale moteke ma Nabii Yesaya 'awi demo:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Nu'una to ngoi 'ai ro-riwo towiirikokau.</para>
  <para style="q2" vid="MAT 12:18">'Una towisibosono de 'ai singina wasanangi.</para>
  <para style="q1" vid="MAT 12:18">Ngoi 'asa towikula 'ai Ngomasa.</para>
  <para style="q2" vid="MAT 12:18">'Ai loa 'asa wosihabari 'o nyawa-nyawaka.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />'Una 'asa kowori-ributuwa de kowomapoa-poakuwa;</para>
  <para style="q2" vid="MAT 12:19">de kowobobetowa naga 'o tapaki wosimigiranga.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />'O nyawa manga gina 'itubusokou, 'asa kowaganapuwa;</para>
  <para style="q2" vid="MAT 12:20">de gee rekeni koyomado-do'oawau, 'asa kowakido-dokowa.</para>
  <para style="q1" vid="MAT 12:20">'Una 'asa womariwo sigado 'o loa 'idadi;<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />de 'o nyawa 'iodumu 'asa yomasinganono 'unaka.&gt;&gt;<verse eid="MAT 12:21" /></para>
  <para style="s">'O Yesus de 'o Beelzebul<note caller="g" style="f"><char style="fr" closed="false">12:22-32: </char><char style="ft" closed="false">Ge'ena 'o Tokata ma Koana ma ronga moioli.</char></note></para>
  <para style="r">(<ref loc="MRK 3:20-30">Mrk. 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk. 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ge'enaka de 'o Yesusika wi'asa 'o nyawa wimoi worau-rau de womou-mou sababu 'o tokata widongosamuku. 'O Yesus wisi'aiki so 'idadi womasimake de wobicara. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />'O nyawa 'iodumu yoherangi so yongose, &lt;&lt;Poilia nu'unau 'o Dautu wi Ngowaka gee 'inasijajiokau?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />'O Farisioka yo'isenoka ge'ena de yongose, &lt;&lt; 'Una 'idadi woginiiki 'o tokata, sababu 'o Tokata ma Koana gee ma ronga Beelzebul ma guata wikulaka.&gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />'O Yesus wanako 'o Farisioka manga di-dibangi so wongose, &lt;&lt;Nako 'o negara moi la 'ikapula-pula de 'o paratei yamo-moi yomakakudoti, dua 'o negara ge'ena kaipiakoroka. De 'o kota moi bolo 'o woa moi la koyomakasanangiwa, ge'ena dua kayopiakoroka. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Koge'enali mita 'o Tokata ma Koana ma pareta, nako ngai moi 'ikiniiki, ge'ena dua 'imakati-tingaoka so ma pareta ge'ena kaipiakoroka. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ngini niongose 'ato ngoi 'o tokata toginiiki ka de 'o Beelzebul ma guata. Nako koge'ena de to ngini nia nyawa 'ona kiano yakikula 'o guata 'o tokata yoginiiki? To nginiou nia nyawa ma sirete yosidumutu 'ato 'ania di-dibangi ge'ena koyadaenuwa. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ma ngoi toginiiki 'o tokata ge'ena de ma Jo'oungu ma Dutu wi Ngomasa ma guata, so ne'ena ma ngale ma Jo'oungu ma Dutu wokurue wopareta nginioka.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Kokia 'o nyawa 'idadi yowosama wimoi wokua-kuata wi woaka la wi kia sonaa ya'ora, nako 'una kowipusukuwa 'isira? Salingou wipusuokasi 'asa de wi harataa ya'ora.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Nago'ona ko de de ngoiwa, 'ona ge'ena 'iitomokau ngoi. De nago'ona koiriwowa, 'ona yatorou 'ai manarama! <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Sababu ge'ena tinisidemo, nako 'o nyawa 'o sowono yodiai sababu yosigurubungu, ge'ena kayakisipidilokasi manga sowonoka. Ma nago'ona yositi-tingoono 'o Ngomasa 'Itebi-tebini, 'ona koyakisipidiluawau manga sowonoka. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nako moikani 'o kianikia yongose ma ngale wiitomo 'o Nyawa ma Ngowaka, ge'ena kayakisipidilokasi manga sowonoka. Ma nako yositi-tingoono 'o Ngomasa 'Itebi-tebini, ge'ena koyakisipidiluawau ma 'orasi ne'ena bolo ma du'uruoka.&gt;&gt;<verse eid="MAT 12:32" /></para>
  <para style="s">Ma roese de ma sowo-sowoko</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk. 6:43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />&lt;&lt;Nako pamake ma sowoko yaowa, salingou ma roese 'ibo-bero. Nako ma roese koibo-berowa, ma sowoko mita koisurewa. 'Ibo-bero bolo ko'uwa 'o gota 'o utu moi, ma nyo-nyata ma sowokoka. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ngini nioti-tingkai, koigapanguwa niobi-bicara 'o sagala yaowa-owa. 'Okia naga gee niosisupu nia 'urude, ge'ena gee nia singina ma dodaka 'isupu. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />'O nyawa ma owa, yosisupu 'okia sonaa yaowa-owa sababu manga singina ma dodaka doka yaowa-owa. Koge'enali mita, 'o nyawa ma dorou yosisupu 'okia sonaa 'ito-torou sababu manga singina ma dodaka doka ka 'o dorou.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />So niongano-nganono! 'O dunia ma do-dogumoka dua, 'o nyawa moi-moi 'asa yomadomoku manga demo gee ma faedaa koi'iwa-'iwa. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Sababu nia demo-demo ma sirete 'asa 'isiputusu niosowono bolo ko'uwa.&gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">'O Farisioka yoga'asoko 'o Yesus wodiai 'o no-nako 'ihera-herangi</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mrk. 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk. 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Ge'enaka de 'o 'agamaka yodoto-dotoko yamuruo naga de 'o Farisioka yongose, &lt;&lt; 'Aba Guru, ngomi miomau miamake nodiai 'o no-nako 'ihera-herangi.&gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />'O Yesus wosango, &lt;&lt; 'Ena ma dingkaioka de ma daliseka 'o nyawa-nyawa ma 'orasi ne'ena. Ngini nioga'asoko? ngoi todiai 'o no-nako 'ihera-herangi? Dua ka 'o ngai moi ma kotinikulawa, duga 'isoka to ma Nabii Yunus 'awi no-nako 'ihera-herangi. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />'O Yunus wiwange sa'ange de wiobiri sa'ange 'o naoko 'iamo-amoko ma pokoroka, koge'enali mita dua 'o Nyawa ma Ngowaka 'o wange sa'ange de 'o obiri sa'ange 'o bo'osuku ma dodaka doka. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />'O dunia ma do-dogumoka 'o Niniwe ma nyawa 'asa yoma'oko yobicara ma ngale yakisisala 'o nyawa-nyawaka gee yo'ahu ma 'orasi ne'ena naga. Sababu 'o Niniwe ma nyawa 'ona yotobakau 'o sowono yodiai ma 'orasi 'o Yunus wakidotoko. Ma ne'enaka naga wimoi 'ifoloi woamoko de 'o Yunus, ge'ena la ngoi, ma niooluku ni'isene. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />'O dunia ma do-dogumoka dua 'o Syebaku daku ma Koana mimoi<note caller="h" style="f"><char style="fr" closed="false">12:42: </char><char style="ft" closed="false">'O Syeba ma Koana ge'ena 'o Koresaraku ma Koana mimoi. 'O Syeba ge'ena 'o Arab ma daeraaka dakuie ma songona.</char></note> 'asa moma'oko mobicara ma ngale mosisala 'o nyawa-nyawa gee yo'ahu ma 'orasi ne'ena. Sababu muna momau mosigisene ma Koana 'o Salomo woba-barija wi do-dotoko, muna naga posironga 'o gurutoka de maino. Ma ne'enaka naga ma 'orasi ne'ena wimoi 'ifoloi woamoko de ma Koana 'o Salomo, ma kowinisigisenuwa 'unaka.&gt;&gt;<verse eid="MAT 12:42" /></para>
  <para style="s">'O tokata 'ilionoli</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk. 11:24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt;Nako la 'o tokata 'isupuokau 'o nyawaka, ge'ena 'itagi 'ikiloliti 'imadononu 'o ngii 'idu-dudungu la 'imaoma-omasa, ma koimadamakewa. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Sababu ge'ena 'ingose, &lt;Ngoi dua tolioli 'o woaka gee tamadakau.&gt; Ge'enaka yaika, 'ena ma woa ge'ena ka ma somoaka, 'itebi-tebini de 'isikadiaioka. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Ge'enaka 'itagioli de 'isiboano 'o tokata 'iregu ngai tumudiingi 'ifoloiosi 'itingkai, de 'iwosama 'o nyawa gu'unaka gee, de 'imanoa ge'enaka. So ma rai 'o nyawa gu'una 'ifoloiosi wisitorou de gee ma si-siraka. Koge'enali mita dua 'idadi de 'o nyawa yoti-tingkai ma 'orasi ne'ena.&gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">'O Yesus wi 'esa de wi riaka dodoto ma dutu</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mrk. 3:31-35</ref>; <ref loc="LUK 8:19-21">Luk. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />'O Yesus wobicara ma gu-gudaioka 'o nyawa yoku-kudaika, de wi 'esa, de wi riaka dodoto ma dutu yoboa. 'Ona yoma'oko-'oko ma dudunoka, de yomau yomabicara de de 'una. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />De wimoi ge'enaka dau yoku-kudaioka gee wosidemo 'o Yesusika, &lt;&lt; 'Aba, 'ani 'esa de ni riaka dodoto doka ma dudunoka. 'Ona yomau yomabicara de de ngona.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />'O Yesus wosango, &lt;&lt;Nago'ona to ngoi 'ai 'esa de 'ai riaka dodoto?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />De wakitumutu 'awi do-domoteika de wongose, &lt;&lt;No'ona to ngoi 'ai 'esa de 'ai riaka dodoto. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />'O nyawa gee yamoteke 'ai Dea 'o sorogaaka wi mau, 'ona ge'ena to ngoi 'ai riaka dodoto, 'ai 'esa de 'ai biranga.&gt;&gt;<verse eid="MAT 12:50" /></para>
  <para style="rem">Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">'O 'ade-'ade 'o nyawa wimoi 'o fini wopiakoro</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mrk. 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kage'ena ma wange mita, 'o Yesus wamada 'o woa ge'ena de wotagi 'o talaga ma batingika so wogogerie ge'enaka. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />'O nyawa manga gudai wisigilolitino, so 'una wosikaika 'o ngo'otiroka de wogogerie ge'enaka, 'ena yoku-kudai 'ona 'o dowongioka. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Ge'enaka de 'o Yesus wakidotoko 'i'ini-'inioka de wosi'ade-'ade. Wongose:</para>
  <para style="p" vid="MAT 13:3">&lt;&lt;Wopai-pairi wimoi wotagi wi fini wopiakoro. <figure style="fig" file="LB00094.tif" size="col" ref="(13:3)">Wopai-pairi wi fini wopiakoro</figure> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Gedagee wopiakoro, munuka 'itotaka 'o ngekomuku. Ge'enaka de 'o namoro 'iboa de ya'odomo yabootoka. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Munuka 'itotaka 'o tonaka 'ikakatetoku gee ma tonaka ka ma etaka. Ma fini ge'ena ma japatioka 'igo'oo, sababu ma tonaka koikipirinuwa, <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />ma gee 'o wange yodasauku de ma fini 'igo-go'oode ge'ena 'imaai deika 'i'osaka, so 'isongene sababu 'imasingutuku koikurutukuwa. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />De mita ma fini munuka 'itotaka gee 'o sisika ma sigoronaku. Gee ma sisika 'ifero de ma go'oo ge'ena yapilatu sigado 'isongenoka. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ma gedagee 'itotaka 'o tonaka 'irewo-rewoku, ge'ena 'isowoko, munuka ma giliono 'o ratusu moi, munuka 'o nagi butanga, de munuka 'o nagi sa'ange.&gt;&gt; <figure style="fig" file="HK00099.pcx" size="col" ref="(13:8)">'O gandum ma sowoko</figure><verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />'O Yesus wosijaritaka 'o 'ade-'ade ge'ena, de wongose, &lt;&lt;Nako de nia ngaukoka nio'isenika.&gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">'Ido'oa so 'o Yesus wopake 'o 'ade-'ade</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mrk. 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ge'enaka de 'o Yesus wi do-domoteke yoboa 'unano de yosano, &lt;&lt; 'Aba, 'ido'oa so nako nobi-bicara 'o nyawa 'iku-kudaika de nopake 'o 'ade-'ade?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />'O Yesus wosango, &lt;&lt;Sababu ngini nikulakau 'o co-catu ma ngale niasahe kokia ma Jo'oungu ma Dutu wi pareta gee koisupu-supuwasi, ma 'ona yoku-kudaika ko'uwa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Sababu to nago'ona de ma 'ena, 'ona 'asa yakiganapu 'ifoloiosi 'ikudai, so 'ona 'asa yofoloiku. Duga to nago'ona koi'iwa, ge'ena naga ka ma etaka ma dua ya'eseka. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ma ngale ge'ena ngoi topake 'o 'ade-'ade nako tobi-bicara 'o nyawa yoku-kudaika, sababu 'ona yamake ma 'isoka koyamakewa, 'ona yo'isene ma 'isoka koyo'isenuwa de koyasahewa. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />De ge'ena 'idadiokau 'isoka ma Nabii Yesaya wosidemokau:</para>
  <para style="q1" vid="MAT 13:14">&lt;Ma Jo'oungu ma Dutu wongose:</para>
  <para style="q1" vid="MAT 13:14">'Ona 'asa yosigisene kaitaurika ma koyasahewa;</para>
  <para style="q2" vid="MAT 13:14">'ona 'asa kaitaurika yodi-diriidi ma koyosidongoowa.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Sababu 'o nyawa no'ona manga singina 'i'opinokau,</para>
  <para style="q2" vid="MAT 13:15">manga ngauku yati'imukokau, de manga ako yaruutokau.</para>
  <para style="q1" vid="MAT 13:15">Koge'ena 'idadi la manga ako 'uwa yosimake,</para>
  <para style="q2" vid="MAT 13:15">manga ngauku 'uwa yosi'isene,</para>
  <para style="q1" vid="MAT 13:15">de manga di-dibangi 'uwa yasahe la 'uwa yolioli ngoino,</para>
  <para style="q2" vid="MAT 13:15">de takisilaha.&gt; &gt;&gt;<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />'O Yesus wongose 'awi do-domoteika, &lt;&lt;Duga ngini ne'ena niosanangioka sababu ngini ma gou-goungu niamake de nio'isene. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Niongano-nganono! Manga gudai 'o nabii de 'o nyawa yoloa-loa yomau yamake gee 'isoka ngini niamakekau ma 'orasi ne'ena, ma 'ona koyamakewa. 'Ona yomau yo'isene 'okia naga ngini nio'isenokau ma 'orasi ne'ena, ma 'ona koyo'isenuwa.&gt;&gt;<verse eid="MAT 13:17" /></para>
  <para style="s">'O Yesus wosiguti ma ngale 'o 'ade-'ade wopai-pairi wimoi wi fini wopiakoro</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mrk. 4:13-20</ref>; <ref loc="LUK 8:11-15">Luk. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />&lt;&lt;Niosigisene 'o 'ade-'ade wopai-pairi wimoi wi fini wopiakoro. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />'O fini gee 'itotaka 'o ngekomuku, ge'ena 'isoka 'o nyawa gee yo'isenoka ma habari ma ngale kokia ma Jo'oungu ma Dutu wopareta, ma koyasahewa. 'O Tokata ma Koana 'iboa de ya'oraka 'okia naga gee yapiakorukou to 'ona manga singinaka. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />'O fini gee 'itotaka 'o tonaka 'iteto-tetoku, ge'ena 'isoka 'o nyawa gee kayo'isenoka 'o habari ge'ena de yadawongokau de manga singina 'imore-morene, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />duga 'o habari ge'ena koimasingutukuwa manga singinaka, so ka gedagee yosangisara bolo yakihalebiru sababu 'o habari ge'ena, de yamadakau. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />'O fini gee 'itotaka 'o sisika ma dodaku, ge'ena 'isoka 'o nyawa gee yo'isenoka 'o habari ge'ena ma yododato ma ngale manga 'ahu, de ka 'o pipi yonyafisuu, so 'o Habari ma Owa manga singina ma dodaka gee yapilatu so koisowokuwa. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />De 'o fini gee 'itotaka 'o tonaka 'irewo-rewoku, ge'ena 'o nyawa gee yo'isenoka 'o habari ge'ena de yasahe. 'Ona yakidosowoko munuka ma gilio 'o ratusu moioka, munuka 'o nagi butangaka, munuka 'o nagi sa'angeka.&gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">'O 'ade-'ade 'o ngu'usumu 'o biraka</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />'O Yesus wosijaritali 'o 'ade-'ade moi 'o nyawa yoku-kudaika, konee, &lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isoka 'o fini yaowa-owa wopai-pairi wimoi wodatomo wi bairoka. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ma moi ge'ena 'iobiruku, gee 'o nyawa 'iodumu yoma'iduoka, de wopai-pairi wi musu woboa 'o ngu'usumu wopiakoro 'o bira ma dodako, ge'enaka de wotagiokau. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Gedagee ma bira ge'ena 'igo'oo so 'isooboto, de ma ngu'usumu mita 'igo'oo. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Ge'enaka de wopai-pairi 'awi ro-riwo yaino yosidemo ma bairi ma dutuno, &lt;Bereki, to ngona ni bairoka 'o bira notuduku, de kokia so doka de ma 'ena 'o ngu'usumu?&gt; <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />De ma bairi ma dutu wongose, &lt;Ge'ena 'o musu wimoi wobadingaka.&gt; Ge'enaka de wi ro-riwo go'ona yosanoli, &lt;Nomodeke, 'Aba? miaika miarapuku 'o ngu'usumu ge'ena?&gt; <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ma bairi ma dutu wongose, &lt; 'Uwa. Sababu done niosidarapuku de ma bira. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Niamadaka 'imasidefero sigado 'o togutuku. Dua ngoi 'asa tongose yo'utu-'utuika, 'o ngu'usumu 'isira niatoomu, de niapusukino 'asa de niatuuku. Ge'enaka de nialomu 'o bira, la niadaoto 'ai rawongoka.&gt; &gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">'O 'ade-'ade 'o sawi<note caller="i" style="f"><char style="fr" closed="false">13:31: </char><char style="ft" closed="false">'O sawi 'o Palestinaka ge'ena ma gurutie poilia sigado 'o meteri sa'ange.</char></note> ma doda</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mrk. 4:30-32</ref>; <ref loc="LUK 13:18-19">Luk. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />'O Yesus wokula 'o 'ade-'ade moioli 'o nyawa yoku-kudaika, konee, &lt;&lt;Ma Jo'oungu ma Dutu wopareta 'isi'ade-'ade 'isoka 'o sawi ma doda 'o nyawa moi yatuduku manga bairoka. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />'O fini 'ifoloi 'inye-nyeme ge'ena 'o sawi ma doda. Duga nako la 'i'oodeu, ge'ena dua 'ena 'ifoloi 'iamokie de 'o joro ma di-dingoono 'iregu. 'Ena 'imadiai 'o gota so 'o namoro 'iboa 'imasi'igutu ma sago-sagoka.&gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s">'O Yesus wosi'ade-'ade 'o ragi</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luk. 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />'O Yesus wokula mita 'o 'ade-'ade ne'ena 'o nyawa yoku-kudaika, wongose 'ato, &lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isoka 'o ragi 'o ngeweka mimoi mosikaruahe de 'o tarigu ma amokoka<note caller="j" style="f"><char style="fr" closed="false">13:33: </char><char style="ft" closed="false">'O tarigu ma amokoka ge'ena poilia 'o kilo monaoko, bolo 'o literi nagi soata.</char></note> so 'idoa.&gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">'Ido'oa so 'o Yesus wopake 'o 'ade-'ade</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mrk. 4:33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />'O Yesus wodotoko 'o nyawa yoku-kudaika, ge'ena 'iodumu wopake 'o 'ade-'ade. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Koge'ena la moteke 'o nabii wimoi wosidemokau:</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Ngoi topake 'o 'ade-'ade nako tobi-bicara 'onaka;</para>
  <para style="q2" vid="MAT 13:35">ngoi 'asa takisidemo 'okia naga koisupu-supuwasi kaikurue 'o duniasi 'isidadi.&gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">'O Yesus wosiwaiti 'o 'ade-'ade gee 'o ngu'usumu 'o bira ma dodaka</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Ge'enaka de 'o Yesus womagoraka ge'ena 'o nyawa yoku-kudaioka, de wowosama 'o woaka. 'Awi do-domoteke yoboa de yongose, &lt;&lt;Bika 'Aba, nosiwaiti 'o 'ade-'ade gee 'o ngu'usumu 'o bira ma dodaka.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />'O Yesus wosango, &lt;&lt; 'O nyawa gee wodatomo 'o gisisi yaowa-owa gu'una 'o Nyawa ma Ngowaka. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />'O bairi ge'ena 'o dunia ne'ena. 'O gisisi yaowa-owa ge'ena 'o nyawa gee yodadi ma Jo'oungu ma Dutu wi kawasa. 'O ngu'usumu ge'ena 'o nyawa gee yomoteke de 'o Tokata ma Koana. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />'O saturuu gee 'idatomo 'o ngu'usumu ge'ena 'o Tokata ma Koana. 'O togutuku ge'ena la 'o dunia ma do-dogumu, de yo'utu-'utuku ge'ena 'o mala'ekati. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Kokia naga 'o ngu'usumu yatoomu de yatuuku, koge'enali mita dua 'o dunia ma do-dogumoka. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />'O Nyawa ma Ngowaka dua wosuloko 'o mala'ekati yatoomu 'o nyawa gee yodadi sababu 'o nyawa 'iregu yosowono, de gee yoti-tingkai 'iodumu. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Go'ona yoodumu 'asa yaki'umo 'o 'uku 'iluru-lurusika, ge'enaka 'asa 'ona yosangisara de yo'ari. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />De godagee yamote-moteke ma Jo'oungu ma Dutu wi mau, 'ona ge'ena dua yoletongo, matero ka 'o wange ma ako, ma Jo'oungu ma Dutu to 'ona manga Dea wi dunia ma sungioka. So nako de nia ngaukoka, nio'isenika!&gt;&gt;<verse eid="MAT 13:43" /></para>
  <para style="s">'O 'ade-'ade 'o harataa 'o tonaka ma dodaka</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isoka 'o 'ade-'ade neneda. 'O nyawa wimoi 'o harataa wamake dau 'o tonaka ma dodaka de kawosibaitokali. Sababu 'una kaifoloi womorene so wotagi wawukunu 'awi kia sonaa 'iodumu, ge'enaka de woliono de wa'ija ma tonaka ge'ena.&gt;&gt;<verse eid="MAT 13:44" /></para>
  <para style="s">'O 'ade-'ade 'o mutiara 'isure-sure</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />&lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, 'isi'ade-'ade 'isoka woko-korago wimoi 'o mutiara 'ihali-hali wononu. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Gedagee wamakeka ma mutiara 'isure-sure 'o muhi moi, de wotagi wawukunu 'awi kia sonaa 'iodumu, de wosi'ija 'o mutiara ngai moi ge'ena.&gt;&gt;<verse eid="MAT 13:46" /></para>
  <para style="s">'O 'ade-'ade 'o soma</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />&lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isi'ade-'ade 'isoka 'o soma yawaruku 'o ngootoka, de yadaene 'o naoko 'i'ini-'inioka. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Gedagee ma soma ge'ena 'i'omangokau, de yosoma-soma go'ona yatobaka 'o dowongisa. Ge'enaka de yogogeruku yosikati-tingaka ma naoko ge'ena, yaowa-owa gee 'o rataku yosinoa, de gee ma do-dorou ya'umo. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Koge'enali mita dua 'o dunia ma do-dogumoka, 'o mala'ekati 'asa yosikati-tingaka 'o nyawa gee yamote-moteke ma Jo'oungu ma Dutu wi mau, de gee yoti-tingkai. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Ge'enaka de 'o nyawa yoti-tingkai 'asa yaki'umo 'o 'ukuka, ge'enaka dua 'ona yosangisara de yo'ari.&gt;&gt;<verse eid="MAT 13:50" /></para>
  <para style="s">'Okia sonaa ma du'uru de ma sira</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />'O Yesus wosano, &lt;&lt;Niasahekau ge'ena 'iodumu?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">'Ona yosango, &lt;&lt;Miasahekau 'Aba!&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Ge'enaka de 'o Yesus wongose, &lt;&lt; 'O 'agamaka yodoto-dotoko gee yodadiokau ma Jo'oungu ma Dutu 'awi kawasa, ge'ena 'isoka 'o woa ma dutu wimoi de 'awi harataaka. 'Una wosisupu 'awi harataa ma ngiioka, 'okia sonaa ma sira de ma sungi.&gt;&gt;<verse eid="MAT 13:52" /></para>
  <para style="s">'O Nazaretioka 'o Yesus kowidawonguwa</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mrk. 6:1-6</ref>; <ref loc="LUK 4:16-30">Luk. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />'O Yesus waduanga wosidemo 'o 'ade-'ade 'iodumu ge'ena, de woma'aiki ge'enaka, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />de wolio 'awi soanika. Ge'enaka waika de wodotoko 'o lo-lomu ma woaka, de 'o nyawa yosigise-gisene ge'enaka yoherangi ma sala. 'Ona yongose, &lt;&lt;Kiano womadamake 'o cawaro koge'ena? De kiano womadamake 'o kuasa so wodiai 'o no-nako 'ihera-herangi? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />'Una ge'ena 'o woa wodi-diai wi ngowaka. 'Awi 'esa, ngo Maria, de wi dodo-dodoto ma dutu 'o Yakobus, 'o Yusuf, 'o Simon de 'o Yudas. <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />De 'awi bira-biranga ma dutu mita yogogere ne'enaka. Kiano 'una womadamake 'iodumu ge'ena?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />So 'ona wiitomo 'o Yesus. Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt; 'O nabii moi ge'ena yakihoromati kiaka naga bato, duga to 'ona manga soanoka bolo manga woaka ge'ena ko'uwa.&gt;&gt; <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Ge'enau so ge'enaka 'o Yesus koikudaiwa wodiai 'o no-nako 'ihera-herangi sababu koyongakuwa.<verse eid="MAT 13:58" /></para>
  <para style="rem">Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">'O Yohanes Wo'osi-'osiki wosongene ma jarita</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mrk. 6:14-29</ref>; <ref loc="LUK 9:7-9">Luk. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ma 'orasi ge'ena 'o Herodes wokoana 'o Galileaka, wogi'isenoka 'o Yesus wi habari, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />de wongose 'awi ro-riwoka, &lt;&lt;Ma raiokau ne'ena ge'ena 'o Yohanes Wo'osi-'osiki womomikieli! Sababu ge'ena to 'una wi kuasa de ma 'ena wodiai 'o no-nako 'ihera-herangi.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Sababu ma sira 'o Herodes wosuloko 'o Yohanes witagoko de wipusuku la wisingosama 'o buika. 'O Herodes wodiai koge'ena, sababu ma titi ngo Herodias. Muna ge'ena 'o Herodes wi dodoto ma dutu 'o Filipus ma wekata. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Sababu 'o Yohanes wosidawanono 'o Herodesika wongose, &lt;&lt;Koyadaenuwa ngona moningaamoko ngo Herodias!&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />'O Herodes womau wito'oma 'o Yohanes, duga kawimodongoka 'o nyawa yoku-kudaika sababu 'ona yanako 'o Yohanes ge'ena 'o nabii moi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Ma 'orasi 'o Herodes 'awi wange ma gilio wodiai, de ngo Herodias mi ngowaka moroge ge'ena 'o nyawa yoboa-boano manga bionoka. 'O Herodes woduaka ma sala 'ami roge ge'ena, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />so wojaji de wosasi munaka, 'okia naga bato moga'asoko, 'asa womikula.<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />De ngano ma 'esa mosuloko ma jojaruka gumuna, so mongose, &lt;&lt;Ngoi toga'asoko 'o Yohanes wi saeke nikula 'o bobilanguoka 'isinoaku ka kone'enasi.&gt;&gt;<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />'O Herodes wogi'isenoka mi ga-ga'asoko ge'ena de wi singina 'isusa ma sala. Duga 'una wosasiokau 'o nyawa yoboa-boano manga bionoka, so wopareta la 'o mosolese gumuna mi ga-ga'asoko ge'ena de ma 'ena. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />'Una wosuloko 'o nyawa yotagi 'o buika la ya'ogu 'o Yohanes wi saeke. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Ge'enaka de 'o Yohanes wi saeke ge'ena yosingosama, 'o bobilanguoka yosinoaku, 'asa de yokula 'o jojaruka gumuna. Ge'enaka de 'o jojaru gumuna mokulali ma 'esaka. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Ge'enaka de 'o Yohanes wi do-domoteke yoboa ya'ese 'o Yohanes wi songene de yapo'osuku. Yapo'osuoka de yotagi yositotara 'o Yesusika.<verse eid="MAT 14:12" /></para>
  <para style="s">'O Yesus wakisi'odomo 'o nyawa yacaana motoa</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mrk. 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Ma habari ge'ena 'o Yesus wo'isenoka, de womagoraka ge'enaka so wongo'otiri wosikaika womatengo 'o ngii 'irii-riidika. Ma gedagee 'o nyawa yoku-kudai wigi'isene de moi-moi manga soana yamada so wisidu'uru kayolingana. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Gee 'o Yesus womasabi de wakimake 'o nyawa yoku-kudai go'ona, de wakisingina. Ge'enaka de wakisilaha kiaka gee yopa-panyake.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />'Iobirou de 'o Yesus wi do-domoteke yongose 'o Yesusika, &lt;&lt; 'Iobirou de 'o ngii ne'ena 'imatingakino, so yaowa, 'Aba, nakisuloko yokokilio yoku-kudai go'ona, la 'o 'inomo yomadi'ija 'o soa-soanoka.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />'O Yesus wongose, &lt;&lt; 'Uwau yotagi, ka nginiou niakikula 'o 'inomo.&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />'Awi do-domoteke yosango, &lt;&lt;Ngomioka duga ka 'o roti 'o ngai motoa de 'o naoko 'o ngai modidioka!&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />De 'una wongose, &lt;&lt;Nia'asano nongoka.&gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Ge'enaka de wakisuloko yoku-kudai go'ona 'o 'ubutoka yogogerie, de wa'ese 'o roti ngai motoa de 'o naoko ngai modidi ge'ena, de 'o diwangie womatagade de wo'amalaha ma Jo'oungu ma Dutude. 'Asa deika ma roti ge'ena wakakaeta, deika wokula 'awi do-domoteika la yosibula-bula 'o nyawa yoku-kudaika go'ona. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />'Ona yoodumu yo'odomo sigado yakipunusoka. Ge'enaka de 'o Yesus wi do-domoteke yotoomu ma 'inomo ma baili ge'ena, 'o pa'udi mogiooko de modidioka. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Ma 'orasi ge'ena gee yo'odo-'odomo manga gudai poilia yacaana motoa, ge'ena koyakidoimuawasi 'o ngeweka de 'o ngowa-ngowaka.<verse eid="MAT 14:21" /></para>
  <para style="s">'O Yesus wotagi-tagi 'o 'akere ma dekuoko</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mrk. 6:45-52</ref>; <ref loc="JHN 6:16-21">Yoh. 6:16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ge'ena 'iduanga de 'o Yesus wakiyogo wi do-domoteke 'o ngo'otiruku yoparene de yosirau 'o talaga ma songonaka, 'ena yoku-kudaika go'ona wakisuloko yokokiliou. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Gedagee yoku-kudai yotagioka, de 'o Yesus womatengo wosau 'o gigiede la wolahidoa. 'Iobirukou 'ena 'o Yesus kage'enakasi womatengoka. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />'Ena 'o ngo'otiri gee 'o Yesus wi do-domoteke yobare-barene 'o gurutikau 'o moku-moku yapoka-poka sababu 'o dadoko yatomo. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />'Isori 'ibibini 'o Yesus woboa 'onaka wotagi-tagi 'o 'akere ma dekuoko. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Gedagee wi do-domoteke wimake wotagi-tagi 'o 'akere ma dekuoko, de yakitodokana ma sala. Yakimodongo so yopoaka 'ato, &lt;&lt;Ididi! 'O tokata!&gt;&gt;<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Ma 'o Yesus wongose 'onaka, &lt;&lt;Nimarii-riidi! 'Uwa nimodongo. Ngoi ne'ena 'o Yesus.&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Ge'enaka de 'o Petrus wongose, &lt;&lt;Jou, ngonau ge'ena? Nako ma goungu ngonau, nosuloko taika ngonaka totagi-tagi 'o 'akere ma dekuka.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />'O Yesus wongose, &lt;&lt;Nou!&gt;&gt; Ge'enaka de 'o Petrus wo'uti 'o ngo'otiroka de waika 'o Yesusika. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ma gee wamao 'o dadoko 'ikuata ge'ena ma talagaka de wimodongo so 'ikurueu wolutu de womasigasoko, &lt;&lt;Jou, noiriwo!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Ge'enaka de 'o Yesus witagoko de wongose, &lt;&lt;Ngona ne'ena konoingakuwa rekeni! 'Ido'oa so ni singina 'ikapula?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Ge'enaka de 'o Yesus de 'o Petrus yoparenokau ge'ena ma ngo'otiruku de ma dadoko mita 'iriidokau. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />So wi do-domoteke yosuba 'unaka. 'Ona yongose, &lt;&lt;Ma gou-goungu, Jou, ngona ne'ena ma Jo'oungu ma Dutu wi Ngowaka!&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">'O Yesus wakisi'aiki 'o nyawa yopa-panyake 'o Genesaretioka</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mrk. 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ya'adonika ma talaga ma songonaka, de yo'uti 'o Genesaretioka. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />De ma nyawa ge'enaka gee wimake 'o Yesus woboa, de yosikawasa ma daeraa yosinoimika ge'ena ma kota ma sidateoka. Ge'enaka de yopa-panyake yakikoki'asa 'o Yesusino. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />De yoga'asoko la wosidabi wi baju 'ikuru-kurutuku yatigi, ngaro ka ma barenika. De gedagee yatigi-tigi yoodumu manga panyake 'ikoki'aiki.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">'O edete de 'o dotumu manga 'adati</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mrk. 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ge'enaka de 'o Farisioka 'o bolu moi de 'o 'agamaka yodoto-dotoko yamuruo naga 'o Yerusalemuno, yaino 'o Yesusino yosano, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt; 'Ido'oa so ni do-domoteke yaparene to ngone nanga edete de nanga dotumu manga 'adati? Gee yo'odomo ma 'isira ko manga giamuwa ya'isoko.&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />'O Yesus wosango, &lt;&lt; 'Ido'oa so ngini ma Jo'oungu ma Dutu wi pareta niaparene, de niosilamo-lamo ka nia edete de nia dotumu manga 'adati? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Sababu ma Jo'oungu ma Dutu wongose, &lt;Niakihoromati nia dea de nia 'esa, de nago'ona yakisibobeto manga balusika, 'ona salingou yakihukumu yakiso-songene.&gt; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ma ngini niosidotoko 'ato, &lt;Koido'oawa nia balusu koniakikalesanguwa sababu nia kia sonaa niokulakau ma Jouka.&gt; <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Koge'enau niodiai ngini niamao koiparaluuwau niakihoromati nia balusu. So ma sababu nia edete de nia dotumu manga 'adati, ngini koniosikiamoiwau ma Jo'oungu ma Dutu wi demo. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Tei, ngini tabangeluku! Yadae-daene monga 'okia naga 'o Yesaya wosidemokau ma sirasi ma ngale ngini.<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />'O Yesaya wosidemo konee:</para>
  <para style="q1" vid="MAT 15:8">&lt;Ma Jo'oungu ma Dutu wongose 'ato 'o nyawa no'ona yosuba ngoino duga ka manga 'uru ma kaioka,</para>
  <para style="q2" vid="MAT 15:8">ma manga singina 'ena 'imasikurutu ngoioka.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Ma faedaa koi'iwa 'ona yosuba ngoino,</para>
  <para style="q2" vid="MAT 15:9">sababu 'ona yodotoko 'o nyawa ma 'atorangi,</para>
  <para style="q2" vid="MAT 15:9">de yongose 'ato to ngoi 'ai 'atorangi.&gt; &gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">'Okia sonaa gee 'inasimediri</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mrk. 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Ge'enaka de 'o Yesus waki'asokino 'o nyawa yoku-kudai de wakidongose, &lt;&lt;Niosigisene la niasahe! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Gee 'iwosama nanga 'uruoko ge'ena koinasimediruwa; de gedagee 'okia naga 'isupu nanga 'urude, ge'enau 'inasimediri.&gt;&gt;<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ge'enaka de 'o Yesus wi do-domoteke yoboa de yosidemo 'unaka, &lt;&lt; 'Aba, nanakokau? 'o Farisioka yomadegese ma ngale gee yo'isenoka nobi-bicara?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />'O Yesus wosango, &lt;&lt; 'O joro moi-moi gee ko 'ai Deawa 'o sorogaaka wotuduku, dua yarapuku. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />'O Farisioka ge'ena 'uwa niakisigisenika. 'Ona ge'ena 'o ma-malingi 'ipilo-piloko, so nako 'o nyawa yopilo-piloko yakituda 'o nyawa yopilo-piloko, ge'ena dua yomasidootaka 'o guruuku.&gt;&gt;<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />'O Petrus wongose, &lt;&lt; 'Aba, yaowa minisisahenosi 'o 'ade-'ade ge'ena!&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />'O Yesus wosango, &lt;&lt;So ge'ena ngini mita koniasahewasi? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Konianakowasi? 'okia naga gee 'iwosama nanga 'uruoko de 'itotara nanga pokoruku 'asa deika 'isupuoli? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ma gee 'isupu nanga 'urude ge'ena 'o singinano 'ibaoro; de ge'enau 'inasimediri. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Sababu 'o singinano 'ibaoro 'o di-dibangi 'ito-torou, ge'enau 'isidadi 'o do'oma, 'o songou, 'o ga'angara, 'o dosiki, 'o sakisii ma ngeluku de 'o sikagurubungu. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ma hali ge'enau 'o nyawa yakisimediri, ma gee yo'odomo de manga giama koya'isokuwa ge'ena ko'uwa.&gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">'O Kanaan ma nyawa mimoi 'ami ngo-ngaku</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mrk. 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Ge'enaka de 'o Yesus wamada ma daeraa ge'ena, de wosikaoko 'o daeraa gee 'o Tirus de 'o Sidon ma kota ma dateoko. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ma daeraaka ge'ena, 'o Kanaan ma nyawa mimoi moboa 'o Yesusino de mo'aso-'asoko, &lt;&lt;Ee! Dautu wi Ngowaka, noisingina ngoi! 'Ai ngowaka motoroukou 'o tokata mialiti so.&gt;&gt;<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />'O Yesus ka ma eta ma kowosangowa munaka. Ge'enaka de 'o Yesus wi do-domoteke yaika 'o Yesusika yoga'asoko, &lt;&lt; 'Aba, nosuloko la 'o ngeweka gumuna motagikau. Muna kamonamote-moteke de kamomasigaso-gasoko mi 'ilingi kadakuoko!&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />'O Yesus wosango, &lt;&lt;Ngoi 'isuloko takiriwo duga ka 'o Israel ma nyawaka gee yoliba-liba.&gt;&gt;<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />'O ngeweka gumuna 'o Yesus wi bionoka maino motalibukuku de mongose, &lt;&lt; 'Aba, noiriwo ngoi!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Duga 'o Yesus wosango, &lt;&lt;Koyadaenuwa 'o ngowa-ngowaka manga 'inomo de 'o kasoka podukula.&gt;&gt;<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />'O ngeweka gumuna mosango, &lt;&lt;Ma goungu ge'ena, 'Aba, duga 'o kaso mita ya'odomo 'o 'inomo 'itota-totauku ma dutu wi amaka ma timioka.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Ge'enaka de 'o Yesus wongose, &lt;&lt; 'Esa, 'ani ngo-ngaku ma guatoka, so madaka la 'idadi gee 'okia naga ngona nomau!&gt;&gt; Kage'ena ma 'orasi mita de 'o ngeweka gumuna mi ngowaka 'isanangiokau.<verse eid="MAT 15:28" /></para>
  <para style="s">'O Yesus wakisilaha 'o nyawa gudai manga panyake</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />'O Yesus wamada ma ngii ge'ena, de wotagi wanonu 'o Galilea ma talaga ma batingino. Ge'enaka de wosau 'o gigiede, de wogogerieu ge'enaka. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />'O nyawa manga gudai yoboa 'unano, yaki'asano yoliga-liga, yopilo-piloko, yolugu-lugu, yomou-mou, de manga gudaiosi manga panyake 'iregu. Yopa-panyake yoodumu go'ona yakinoaku 'o Yesus wi bionoka, de wakisilaha. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />'O nyawa yoku-kudai ge'enaka gee yoherangi ma sala, gedagee yakimake yomou-mou 'idadi yobicara, yoliga-liga koyoligawau, yolugu-lugu 'idadi yotagi, de yopilo-piloko yomasimakekau. Ge'enaka de 'ona wisiarene 'o Israeloka manga Jo'oungu ma Dutu.<verse eid="MAT 15:31" /></para>
  <para style="s">Yacaana soatoka 'o Yesus wakisi'odomo</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mrk. 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Ge'enaka de 'o Yesus wi do-domoteke waki'asokino de wongose, &lt;&lt;Takisingina 'o nyawa yoku-kudai no'ona. 'O wange sa'angenou 'ona de de ngoi, de ma 'orasi ne'ena to 'ona manga 'inomo koi'iwau. Ngoi tooluku 'ona yolio de manga pokoro ma doda 'uwa. 'Uwa sigado 'o ngekomoka naga de kayopusa.&gt;&gt;<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Ge'enaka de 'o Yesus wi do-domoteke yongose 'unaka, &lt;&lt; 'O ngii 'imatinga-tingakinoka ne'ena de kiano pamake 'o 'inomo la pakisi'odomo 'o nyawa manga gudai no'ona?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />'O Yesus wosano, &lt;&lt;Nia roti ngai muruoka naga?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">'Ona yosango, &lt;&lt;Ngai tumudiingoka de 'o naoko ma di-dingoono ngai muruoka naga.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ge'enaka de 'o Yesus wosuloko yoku-kudai go'ona 'o tonaoka yogogerie. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />De ma roti ngai tumudiingi de ma naoko ge'ena wa'ese, de wosi'amalaha ma Jo'oungu ma Dutude. Ge'enaka de waeta-eta, deika wokula wi do-domoteika so yosibula-bula 'o nyawa yoku-kudaika. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Yoodumu go'ona yo'odomo yakikokipunusoka, de 'o Yesus wi do-domoteke yatoomu ma 'inomo ma baili, 'o pa'udi 'ila-laagomo tumudiingi 'i'oma-'omanga. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Ma 'orasi ge'ena yo'odomo ka 'o nau-naurosi yacaana soatou, koyakidoimuawasi 'o nge-ngeweka de 'o ngowa-ngowaka.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Ge'enaka de 'o Yesus wakisuloko yoku-kudai go'ona yokokilio. 'Una 'o ngo'otiruku woparene de wosikaika 'o Magadan ma daeraaka.<verse eid="MAT 15:39" /></para>
  <para style="rem">Penyuntingan: Ning 8-7-2008 Edit Koreksi Penterjemah: Ning24-7-2008</para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">'O Farisioka de 'o Sadukioka yoga'asoko 'o Yesus wodiai 'o no-nako 'ihera-herangi</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mrk. 8:11-13</ref>; <ref loc="LUK 12:54-56">Luk. 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />'O Farisioka de 'o Sadukioka yamuruo naga yaino 'o Yesusino wibole ma timi-timi. 'Ona yoga'asoko la wodiai 'o no-nako 'ihera-herangi la 'isinyata 'una ge'ena ma Jo'oungu ma Dutuoka de waino. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />'O Yesus wosango, &lt;&lt;Nako 'o wange 'itumunou de 'o diwanga 'itereboko ge'ena niongose wangede dua 'iogoro. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />De 'o ngoru-ngorumika, niongose 'ato 'o wange ne'ena dua 'ibesaka sababu 'o diwanga 'itereboko de 'ilobi. Ngini 'idadi niosikanako 'ibesaka bolo ko'uwa ka 'o diwangoka niamake, ma 'o no-nako 'ihera-herangi 'idadi-dadi ne'ena naga ngini konianakowa to 'ena ma ngale. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />'O nyawa-nyawa ne'ena naga posironga yotingkaioka ma de koyosingou-ngounuwa. 'Ona yoga'asoko 'o no-nako 'ihera-herangi todiai, dua ka moi ma kotinisidumutuwa, tosidumutu duga 'isoka ma Nabii Yunus 'awi no-nako 'ihera-herangi.&gt;&gt;</para>
  <para style="p" vid="MAT 16:4">Ka koge'ena wongoseka de wotagi so wakimadakou 'ona ge'enaka.<verse eid="MAT 16:4" /></para>
  <para style="s">'O Farisioka de 'o Sadukioka manga do-dotoko 'isi'ade-'ade 'isoka 'o ragi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mrk. 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Ma 'orasi 'o Yesus wi do-domoteke ya'adonika 'o talaga ma songonaka, 'asa de yonganonie 'ato 'o roti yamongoruku. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />'O Yesus wongose, &lt;&lt;Niomanako-nako 'o Farisioka de 'o Sadukioka manga ragika.&gt;&gt;<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Yogi'isene 'o Yesus wi demo ge'ena, de moi-moi yomakadongose, &lt;&lt; 'Una koge'ena wongose sababu ngone 'o roti kopo'asawa.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />'O Yesus wanako 'okia naga 'ona yomasikademo, so wongose, &lt;&lt; 'Ido'oa so ngini niatibangi ma ngale 'o roti konio'asawa? Ngini koniongakuwasi rekeni! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Koniasahewasi? Konionganoninowau? 'o roti ngai motoa takide-deeta yacaana motoa? 'O pa'udi muruo ma baili niapoluno? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />De kokiali gee 'o roti ngai tumudiingi de yacaana soatoka? 'O pa'udi 'ila-laagomo muruo ma roti ma baili niatoomuno? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />'Ido'oa so ngini koniasahewa 'ato ngoi tobi-bicara nginika ge'ena ma dumutu ko 'o rotiwa? Nimasitiari 'o Farisioka de 'o Sadukioka manga ragika.&gt;&gt;<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Ge'enaka 'asa de yasahe ma ngale 'o Yesus wakisuloko yomasitiari 'o ragika gee ko 'o rotiwa ma ragi yosidi-diai, ma 'ena 'o Farisioka de 'o Sadukioka manga do-dotoko.<verse eid="MAT 16:12" /></para>
  <para style="s">'O Petrus wi ngo-ngaku 'o Yesusika</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mrk. 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />'O Yesus wotagi 'o Kaisarea Filipi ma kota ma daeraa ma dateoka. Ge'enaka 'una wakisano wi do-domoteika, &lt;&lt;Moteke 'o nyawa manga demo, 'o Nyawa ma Ngowaka ge'ena nagu'una?&gt;&gt;<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />'Awi do-domoteke yosango, &lt;&lt;Munuka yongose 'o Yohanes Wo'osi-'osiki, de munuka yongose 'o Elia, de munukali yongose, 'o Yeremia, bolo 'o nabii wimoi.&gt;&gt;<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />&lt;&lt;Ma moteke ngini ma sirete, ngoi ne'ena nagu'una?&gt;&gt;<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />De 'o Simon Petrus wosango, &lt;&lt; 'Aba, ngona ge'ena ma Jo'oungu ma Dutu wi Ngiriki, ma Lahatala wowango kaisi'ado-'adonika wi Ngowaka.&gt;&gt;<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />'O Yesus wongose, &lt;&lt;Nosanangioka Simon, 'o Yunus wi ngowaka. Sababu ko 'o nyawawa nisidemoka ma hali ge'ena, so 'ena 'ai Dea 'o sorogaaka. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Sababu ge'ena tonisidemo, ngona ge'ena 'o Petrus, 'o teto 'ikua-kuata. De 'o teto ne'ena ma dekude dua 'ai jamati tosigoko de koidadiwa yaisanga ngaro ka 'o songenou ma pareta ma. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Ngoi 'asa tokula ngonaka ma Jo'oungu ma Dutu wi Dunia ma Sungi ma ngorana ma kuci. 'Okia naga konosidabiwa 'o duniaka, dua 'o sorogaaka mita. De 'okia naga nosidabi 'o duniaka, dua 'o sorogaaka mita.&gt;&gt;<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Ge'enaka de 'o Yesus wakisitiari wi do-domoteika, la 'uwa yosikademo 'ato 'una ge'ena ma Jo'oungu ma Dutu wi Ngiriki.<verse eid="MAT 16:20" /></para>
  <para style="s">'O Yesus wobi-bicara ma ngale wosangisara de wosongene</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mrk. 8:31-9:1</ref>; <ref loc="LUK 9:22-27">Luk. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />'Ikurue ma 'orasi ge'ena, 'o Yesus kawositarangikau wosidemo wi do-domoteika, 'ato 'una salingou wotagi 'o Yerusalemuka de ge'enaka wamake 'o sangisara ma gudaiku gee 'o Yahudioka ma balu-balusino de 'o 'imam ma saekino, de 'o 'agamaka yodoto-dotokino. 'Una 'asa wito'oma, ma 'o wange sa'angeka de womomikoli.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ge'enaka de 'o Petrus 'o Yesus witobakino wi gagaroka de witawanono wongose, &lt;&lt; 'Aba, tanu ma Jo'oungu ma Dutu wonisikurutu ma hali ge'ena! 'Uwa sigado nidutuku!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />'O Yesus womapulutuka 'o Petrusika de wongose, &lt;&lt;Ee, ngona matero ka 'o Tokata ma Koana gee de! Noma'aikika ne'enaka! 'Uwa noitatoko; ni di-dibangi ge'ena ko ma Jo'oungu ma Dutunowa so ka 'o nyawano!&gt;&gt;<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ge'enaka de 'o Yesus wobicara wi do-domoteika, wongose 'ato, &lt;&lt;Nago'ona yomau 'imoteke ngoi, salingou 'uwa yamoteke ka to 'ona ma sirete manga mau, de salingou yamoku 'o salip de tatapu yomoteke de de ngoi. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Sababu nago'ona manga 'ahu yosingina, dua 'asa manga 'ahu 'iisanga. Ma nago'ona manga 'ahu 'iisanga ma ngale ngoi, 'asa yomadamake. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />'Okia ma faedaa, 'o nyawa wimoi ngaro 'o dunia moi ne'ena ka to 'una, ma nako wi 'ahu 'iisanga? 'Idadi? 'o 'ahu positero de 'o kianikia?<verse eid="MAT 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 16:27" />Koito'ingowau de 'o Nyawa ma Ngowaka de wi mala'ekati yomasidoboau de ma Dea wi kuasa. Ma 'orasi ge'ena dua de wosibalasi 'o nyawa moi-moi moteke manga di-diai. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Niongano-nganono! Ngini ne'enaka gee, dua naga de ma 'ena koyosongenuawasi nako koyamakewasi 'o Nyawa ma Ngowaka woboa wodadi Koana.&gt;&gt;<verse eid="MAT 16:28" /></para>
  <para style="rem">Penyuntingan: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">'O Yesus wisitedene</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mrk. 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />'O wange butanga 'ipasa de 'o Yesus waki'asa 'o Petrus, 'o Yakobus, de ma dodoto 'o Yohanes, ka 'ona yosau 'o gigie moi 'ikuru-kurutieka. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Manga bionoka, de 'o Yesus 'awi lugo 'ingali. 'Awi biono 'ikinitara 'isoka 'o wange ma ako, de wi baju 'i'arese daungie 'iletongo. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Ge'enaka de 'o do-domoteke yaruange go'ona yakimake 'o Musa de 'o Elia yomabi-bicara de 'o Yesus. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />De 'o Petrus wongose, &lt;&lt;Jou, 'ena ma sureka ngone ne'enaka. Nako noduaka, de 'asa todiai 'o da-darusu ngai sa'ange. Moi to ngona, Jou, moi to Musa, de moi to Elia.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />'O Petrus kawobicarasi de 'o sauramo yakisao de ma sauramono doka 'o 'ilingi 'isupu 'ingose, &lt;&lt;Nu'una to ngoi 'ai Ngowaka towisiboso-bosono. 'Una 'ai singina wasanangi. Niosigisene 'unaka.&gt;&gt;<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />'O demo ge'ena 'o do-domoteke yo'isenoka de yakimodongo so yomapagaruku dau 'o tonaoka. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ma gee 'o Yesus woboa de wakitigi de wongose, &lt;&lt;Niomomikieu; 'uwa nimodongo!&gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ge'enaka de yomalega 'ena 'iregu komoiwau so ka 'o Yesusou womatengoka.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Gedagee yo'uti ma gigieku ge'ena, de 'o Yesus wakisitiari wongose 'ato, &lt;&lt; 'Uwa niosikademo ka moika ma 'okia naga gee niamakekau kangano, ma 'orasi 'o Nyawa ma Ngowaka kowomomikuawasi 'o songenino.&gt;&gt;<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />'O Yesus wi do-domoteke yosano, &lt;&lt; 'Ido'oa so 'o 'agamaka yodoto-dotoko yongose 'ato ma Jo'oungu ma Dutu Wiiri-iriki gu'una kowoboawasi 'ena 'o Elia salingou woboakau?&gt;&gt;<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />'O Yesus wosango, &lt;&lt;Ma goungu 'o Elia woboa de wosikadiai 'okia sonaa 'iodumu. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ma ngoi tinidongose nginika 'o Elia woboakau duga 'o nyawa kowinakowa; de widiai moteke ka to 'ona manga singina ma suka. De koge'enali mita dua yodiai 'o Nyawa ma Ngowakika.&gt;&gt;<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Ge'enaka de 'o do-domoteke yasahe 'o Yesus 'awi bicara ma ngale 'o Elia ge'ena la 'o Yohanes Wo'osi-'osiki.<verse eid="MAT 17:13" /></para>
  <para style="s">'O ngowaka 'o tokata yodo-dongosamuku 'o Yesus wosilaha</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mrk. 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ge'enaka de 'o Yesus de 'awi do-domoteke yaruange yolio 'o nyawa yoku-kudaino gee, de wimoi waino 'o Yesus wi bionoka wosuba de wongose, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />&lt;&lt; 'Aba, tanu nosingina 'ai ngowaka! 'Una wimusu-musuku widofoloi de wosangisara ma sala, do'oaka wootaka 'o 'ukuku de mita do'oaka 'o 'akeruku. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ngoi towi'asakau 'ani do-domoteika ma koya'akunuwa wisilaha.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />'O Yesus wongose, &lt;&lt; 'Etei, kaifoloiou ngini ne'ena! Ngini koniongaku-ngakuwa. Sigado kokiasi ma do'ingo ngoi de de ngini, de kokiasi ma do'ingo tosabari nginika? Nia'asano 'o ngowaka ge'ena.&gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Ge'enaka de 'o Yesus wodorofu 'o tokata gee 'o ngowakoka ge'ena 'isupu, so 'isupu de ma ngowaka ge'ena 'isanangiokau.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Ge'enaka de 'o Yesus wi do-domoteke ka 'ona yoma'uraku yaino 'unano de yosano, &lt;&lt; 'Aba, 'ido'oa so ngomi komia'akunuwa mioginiiki 'o tokata ge'ena?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />'O Yesus wosango, &lt;&lt;Sababu nia ngo-ngaku koikuatuwa. Niongano-nganono! Ngaro nia ngo-ngaku ma amoko 'isoka 'o sawi ma dodani, ma nako 'o diko ne'ena niosuloko, &lt;Nomato'oraka dokangika!&gt; ma raiokau dua 'imato'oraka. 'Okia naga bato niodiai 'iodumu kaidadi. [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Duga 'o tokata koge'ena nioginiiki, ge'ena 'idadi duga kapolahidoa de popuasa.]&gt;&gt;<verse eid="MAT 17:21" /></para>
  <para style="s">'O Yesus wosidemoli ma ngale wosongene</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mrk. 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luk. 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Ma 'orasi 'o Yesus wi do-domoteke yomatoomuno 'o Galileaka, de 'o Yesus wosidemo 'onaka, &lt;&lt;Koito'ingowau de 'o Nyawa ma Ngowaka widukula 'o nyawa manga giama ma soatika. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />'Una 'asa wito'oma, duga ma wange sa'angeka 'asa de womomikokali.&gt;&gt;</para>
  <para style="p" vid="MAT 17:23">So 'awi do-domoteke manga singina 'ifoloi 'isusa.<verse eid="MAT 17:23" /></para>
  <para style="s">'O Yesus wofangu ma Jo'oungu ma Dutu wi Woa ma lewo</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Ma 'orasi 'o Yesus de wi do-domoteke ya'adonino 'o Kapernaumoka, de ma Jo'oungu ma Dutu wi Woa ma lewo yoga-ga'asoko yosano 'o Petrusika, &lt;&lt;Nia guru wofangu bolo ko'uwa ma Jo'oungu ma Dutu wi Woa ma lewo?&gt;&gt; <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />'O Petrus wosango, &lt;&lt;Ia, wofangu!&gt;&gt; Ge'enaka de 'o Petrus wowosama 'o woaka, de 'isira ka 'o Yesus wosano, &lt;&lt;Simon, kokia moteke to ngona ni di-dibangi? Nago'ona salingou yofangu 'o lewo bolo 'o balasitengi 'o duniaka ma koa-koanika? 'O kawasa bolo 'o nyawa ma dudunino?&gt;&gt;<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />'O Petrus wosango, &lt;&lt; 'O nyawa ma dudunino.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Ge'enaka de 'o Yesus wongose, &lt;&lt;Nako koge'ena de 'o kawasa koiparaluuwau yofangu. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Duga 'uwa sigado ngone podiai 'ona yomadegese ma ngale, so notagi nogumaa 'o talagaka. De ma naoko ma di-disiraka natuono gee, dua ma 'uru ma dodaka namake 'o pipi ya'adonoka to ngone 'inamididi nanga balasitengi. Na'ese ma pipi ge'ena de nofangu nanga balasitengi ma ngale ma Jo'oungu ma Dutu wi Woa.&gt;&gt;<verse eid="MAT 17:27" /></para>
  <para style="rem">Penyuntingan: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nago'ona 'ifoloi yoamoko</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mrk. 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ma 'orasi ge'ena 'o Yesus wi do-domoteke yaino 'unano de yosano, &lt;&lt;Nago'ona dua 'ifoloi yoamoko naga ma Jo'oungu ma Dutu 'awi kawasaka?&gt;&gt;<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />'O Yesus wa'eseno 'o ngowaka ma dingoono moi de wa'okode manga bionoka. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />De wongose, &lt;&lt;Tinisidemo, duga kanimangali de nimadiai 'isoka 'o ngowa-ngowaka, ge'ena 'asa niodadi ma Jo'oungu ma Dutu 'awi kawasa. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Nago'ona manga singina yositipokoku yomadiai 'isoka 'o ngowaka ne'ena, 'ona 'ifoloi yoamoko ma Jo'oungu ma Dutu wi kawasa ma sigoronaka. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />De nago'ona yadawongo 'o ngowaka 'isoka ne'ena sababu ngoi, ge'ena ma ngale 'idawongo ngoi.&gt;&gt;<verse eid="MAT 18:5" /></para>
  <para style="s">'O hali gee 'imadadi 'o nyawa 'o so-sowono yodiai</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mrk. 9:42-48</ref>; <ref loc="LUK 17:1-2">Luk. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Nago'ona yodiai sigado 'o ngowaka ma dingoono moi yongaku-ngaku ne'ena la koyongakuwau ngoino, ge'ena yaowa manga tomaroka 'o teto yosidupusuika de yakitapu 'o ngooto ma lukuku. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Tei, 'o dunia ne'ena ma raiokau 'itorouou, sababu 'o sagala moi-moi gee ma duanguku 'o nyawa yosowono. Ma raiokau ma hali 'isoka koge'ena ge'ena dua kaitaurika de ma 'ena, duga yotorouoka gee nago'ona yodadi sababu!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Nako nia giama bolo nia dou nisi'asa 'o sowonika, nia'ogu la nia'umoka. 'Ifoloi yaowa nio'ahu de ma Jo'oungu ma Dutu de nia giama bolo nia dou ka ma songonaka, ma 'uwa sigado nia giama de nia dou 'itoto-totomo de ni'umo 'o narakaka. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />De nako nia ako nisi'asa 'o sowonika, niapeleuru la nia'umoka. Yaowa nio'ahu de ma Jo'oungu ma Dutu de nia ako ka ma songonaka, 'uwa sigado de nia ako 'itoto-totomo ni'umo 'o narakaka.&gt;&gt;<verse eid="MAT 18:9" /></para>
  <para style="s">'O 'ade-'ade ma ngale 'o domba 'iisa-isanga</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk. 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt;Niongano-nganono! 'Uwa niakisiti-tingoono 'o ngowa-ngowaka ma di-dingoono no'ona ka moioni ma, sababu to 'ona manga mala'ekati daku 'ai Dea wi bionoka 'o sorogaaka.<verse eid="MAT 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 18:11" />Sababu 'o Nyawa ma Ngowaka woboa, ma ngale wakisilaha 'o nyawa yoliba-liba.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Kokia to ngini nia di-dibangi? Nako wimoi wi domba 'o ratusu moioka de 'o ngai moi 'iisangoka, dua kokia ma dutu? Ma raiokau dua wamada ma domba 'o nagi siwo de siwo ge'ena 'o dikoka daku de wotagi wanonu gee 'iisa-isangoka. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Tinisidemo ne'ena! Nako wamakeli wi domba ge'ena, dua 'ifoloiosi wodomorene ngaro de 'o nagi siwo de siwo gee koiisa-isanguwa ma. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Koge'enali mita 'ania Dea 'o sorogaaka. Wooluku 'o nyawa moi yongaku-ngaku gee yoliba.&gt;&gt;<verse eid="MAT 18:14" /></para>
  <para style="s">Nako 'ani manai yosowono</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Nako 'ani manai 'o sowono wodiai ngonaka, ge'ena naika 'unaka de nosidumutu 'awi sowono ka ngini nimididioka nimasiriidino. Nako la wodomoteke 'ani demo-demo, ge'ena ma ngale niodagakunu winisigilio 'ani manai gu'una. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ma nako kowodomotekuwa, naki'asa moioli bolo yamididioli 'unaka. Sababu 'o Buku 'Itebi-tebinoka 'isilefoku: &lt;Salingou yaino ma kurangi yamididi bolo yaruange yasakisii ma ngale 'isinyata 'una wosowono.&gt; <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Nako 'una kowosigisenuwa 'o nyawa go'ona manga demo, niosidemo 'o jamatika. De nako 'o jamati manga demo mita kowosigisenuwa, winidiai 'una ge'ena kaimatero de 'o balasitengi yoga-ga'asoko bolo ma Jo'oungu ma Dutu kawinako-nakowa.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Ngoi tinisidemo, 'okia naga gee koniosidabiwa 'o duniaka, ge'ena 'o sorogaaka mita koge'ena. De 'okia naga niosimoteke 'o duniaka, dua 'o sorogaaka mita koge'enali.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />De tinisidemo mita, ngini 'o duniaka ne'ena nako la yamididi manga singina ka moi 'o kianikia bato yoparaluu de yosilahidoa, manga lahidoa ge'ena 'asa 'ai Dea 'o sorogaaka gee wosimoteke. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Sababu kiaka yamididi bolo yaruangeka yomatoomuno ma ngale ngoi, ngoi naga de de 'ona.&gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ge'enaka de 'o Petrus waino 'o Yesusino wosano, &lt;&lt;Jou, nako 'ai manai yosowono ngoino de ma muruo salingou takisipidilika de kotomadonoakuwa? Ma tumudiingi?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />'O Yesus wosango, &lt;&lt;Ko'uwa komatumudiinguwa, ma 'ena ma nagi tumudiingi 'isigali ma tumudiingi. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Sababu nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isoka 'o 'ade-'ade ne'ena: Ma Koana wimoi womau wi ro-riwo manga nagimi wakokipolu. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ma 'orasi wokurue wodoimi, de wimoi wi'asano wi nagimi de ma juta. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Sababu kowa'akunuawau wafangu, so ma Koana wosuloko la 'una de wi wekata de wi ngowaka de wi kia sonaa 'iodumu yawukunu la wi nagimi yosifangu. Deika 'ona yodadi yongosi. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />De 'o ro-riwo gu'una wosuba ma Koana wi bionoka de womasiga'asoko wongose, &lt;Jou, nosabariosi! Ngoi 'asa takokifangu 'ai nagimi ge'ena!&gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Ge'enaka de ma Koana gu'una widora wi ro-riwoka gu'una so wi nagimi 'iodumu ge'ena kowongano-nganonuwau.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Gedagee 'o ro-riwo gu'una wosupuokau ma Koanoka so wotagika, de yomakadaene de wimoi ka 'o ro-riwoli mita gee wonagimoka 'unaka 'o caana muruo naga. Ge'enaka de wico'okoko wonagi-nagimi wi tomaroko, de wongose, &lt;Kone'enasi nofangunou!&gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />De wi manai gu'una wosubaku wi bionoka de wongose, &lt;Nosabariosi, 'Esa moi, 'iodumu ge'ena 'asa tafangu!&gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ma 'una wooluku. 'Una wisingosama wi manai gu'una 'o buika sigado wafangu wabootoka 'awi nagimi. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Gedagee 'o ro-riwo 'iregu yamake ge'ena de manga singina 'isusa so ma Koanika yokalaki. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />De ma Koana wi'asoko 'o ro-riwo woti-tingkai gu'una de widongose, &lt;Ee ngona 'o ro-riwo noti-tingkai! 'Ani nagimi 'iodumu koi'iwau sababu nomasiga'asoko ngoino. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Ko ngonawa? mita salingou nakidora ni manaika 'isoka ngoioli tonidora ngonaka?&gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Ma Koana wi do'otasa 'irama so 'o ro-riwo woti-tingkai gu'una wisingosama 'o buika sigado wi nagimi 'iodumu wafanguoka.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Koge'enali mita dua 'ai Dea 'o sorogaaka wodiai nginika moi-moi, nako ngini koniakisimadawa nia 'esa moi manga sowono nginika de nia singina ma gou-goungu.&gt;&gt;<verse eid="MAT 18:35" /></para>
  <para style="rem">Penyuntingan: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">'O gangoluku</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mrk. 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />'O Yesus wosikokidemoka 'iodumu ge'ena, de woma'aiki 'o Galileaka so wosikaika 'o Yudea ma daeraaka 'o Yordan ma 'akere ma songonaka. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Manga gudai wimoteke, de ge'enaka dau manga panyake wosi'aiki.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Ge'enaka de 'o Farisioka yamuruo naga yaino witaili. 'Ona yosano, &lt;&lt;Moteke to ngone nanga 'agama ma besesongo, kaidadi nanga wekata paoluku de ma sababu 'o kianikia bato?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />'O Yesus wosango, &lt;&lt; 'O Buku 'Itebi-tebinoka 'ingose: &lt;Wosidadi-dadi wodiaiokau 'o nyawa 'o nauru de 'o ngeweka.&gt; Koniabacawasi? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Ge'enaka de wosidemo, &lt;Sababu ge'ena 'o nauru 'asa yamada manga 'esa de manga dea, de yomarimoi de manga wekata so yamididi go'ona 'idadi ka moi!&gt; <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />So 'ona koyamati-tingakuwau so ka moiou. Sababu ge'ena 'okia naga ma Jo'oungu ma Dutu wosikatoomuokau, 'o nyawa koidadiwa posikati-tingaka.&gt;&gt;<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Ge'enaka de 'o Farisioka yongose, &lt;&lt;Nako koge'ena de 'ido'oa so 'o Musa wosuloko 'o gangoluku ma surati yokula nako manga wekata yaoluku?&gt;&gt;<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />'O Yesus wosango, &lt;&lt; 'O Musa wosidabi nia wekata niaoluku, sababu nia singina 'i'opini. Ma ma si-siraka 'ena ko koge'enawa. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Tinisidemo: Nago'ona manga wekata koisongouwa de yaolukou, yaoluoka 'asa de yongaamokoli de 'o ngeweka 'iregu, 'ona ge'ena yosongou.&gt;&gt;<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />'O do-domoteke yongose 'unaka, &lt;&lt;Nako 'o giaberekioka naga ma hali koge'ena ma rupa, de yaowa 'uwau pongaamoko.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />'O Yesus wongose, &lt;&lt; 'O nyawa koiodumuwa yosimoteke 'o demo ge'ena, duga ka gee nago'ona ma Jo'oungu ma Dutu wositatapuokau. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Sababu naga mita koidadiwa yongaamoko, ngano 'ona koge'enau kayomasidoboanosi. Naga mita koidadiwa yongaamoko, sababu yakikabirioka. De naga mita, 'ona ma sirete yooluku yongaamoko, ma ngale ma Jo'oungu ma Dutu wileleani. Nago'ona ya'akunu 'o do-dotoko ne'ena yasahe, madaka la yamoteke.&gt;&gt;<verse eid="MAT 19:12" /></para>
  <para style="s">'O Yesus wakisibarakati 'o ngowa-ngowaka</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mrk. 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Naga 'o nyawa 'o ngowa-ngowaka yaki'asano 'o Yesusoka la 'awi giama wakidatamiku manga saeoka de wakisilahidoa. Ma 'o do-domoteke yakingamo 'o nyawa go'ona. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Ma 'o Yesus wongose 'awi do-domoteika, &lt;&lt;Niakimadaka 'o ngowa-ngowaka go'ona yaino ngoino. 'Uwa koniakisidabiwa, sababu 'o nyawa gee yadawongo ma Jo'oungu ma Dutu 'awi pareta 'isoka 'o ngowa-ngowaka, 'ona yodadi ma Jo'oungu ma Dutu 'awi kawasa.&gt;&gt;<note caller="k" style="f"><char style="fr" closed="false">19:14: </char><char style="ft" closed="false">Bolo: &lt;&lt;...sababu 'o nyawa 'isoka no'ona ge'ena yodadi ma Jo'oungu ma Dutu 'awi kawasa.&gt;&gt;</char></note><verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Ge'enaka de 'o Yesus wi giama wakidatami manga saeuku de wakisibarakati. 'Asa deika womagoraka ge'enaka.<verse eid="MAT 19:15" /></para>
  <para style="s">'O dogu'uru wokaya-kaya</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mrk. 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ma moi ge'ena wimoi waino 'o Yesusino de wongose, &lt;&lt; 'Aba Guru, 'okia yaowa-owa tadiai la tamake 'o 'ahu kaisi'ado-'adonika?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />'O Yesus wosango, &lt;&lt; 'Ido'oa so ngona nosano ngoino ma ngale 'okia yaowa? Kawimoi duga yaowa. Duga nako nomau namake 'o 'ahu kaisi'ado-'adonika, ge'ena salingou nosingounu ma Jo'oungu ma Dutu 'awi besesongo.&gt;&gt;<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />'O nyawa gu'una wosano 'o Yesusika, &lt;&lt; 'O besesongo ka'ena gee?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">'O Yesus wosango, &lt;&lt; 'Uwa noto'oma, 'uwa nosongou, 'uwa notosiki, 'uwa nodadi 'o sakisii ma ngeluku, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />nakihoromati 'ani dea de 'ani 'esa, de nakisibosono 'o nyawa 'iodumu 'isoka ngona ma sirete nomasibosono.&gt;&gt;<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />'O dogu'uru gu'una wosango, &lt;&lt; 'O besesongo 'iodumu ge'ena tamotekokau. 'Okiasi sonaa salingou?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />'O Yesus wongose, &lt;&lt;Nako nomau nomadototomo, notagi 'ani harataa nakokiwukunu. De ma pipi nakisibula-bula 'o nyawa yosusa-susaka, de dua 'asa namake 'o harataa 'o sorogaaka. Ge'ena 'iduanga, de naino la noimoteke ngoi!&gt;&gt;<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />'O dogu'uru gu'una wo'isenoka 'o demo ge'ena, de wotagi de wi singina ma susa sababu wi harataa 'ikudai.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Ge'enaka de 'o Yesus wongose 'awi do-domoteika, &lt;&lt;Ma gou-goungu 'isusa 'o nyawa kaya yodadi ma Jo'oungu ma Dutu wi kawasa. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />De moiosi ne'ena tinisidemo nginika: 'O nyawa kaya yowosama ma Jo'oungu ma Dutu wi Dunia ma Sungika, ge'ena 'ifoloi 'igapangi 'o 'onta 'o ngai moi 'o daiti ma sukonika 'iwosama.&gt;&gt; <figure style="fig" file="LB00042.tif" size="col" ref="(19:24)">'O 'onta</figure><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />'Awi do-domoteke yo'isenoka 'o Yesus 'awi demo ge'ena, de yakitodokana so yongose, &lt;&lt;Nako koge'ena de nago'ona dua yamake 'o laha?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />'O Yesus wakidiriidi 'awi do-domoteika de wongose, &lt;&lt;Ma hali ne'ena nako ka 'o nyawa ge'ena koidadiwa, ma nako de ma Jo'oungu ma Dutu ge'ena 'iodumu 'idadi.&gt;&gt;<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Ge'enaka de 'o Petrus wongose, &lt;&lt;Namake ngomi miamadakau mia kia sonaa sababu minimoteke ngona, so dua 'okia ngomi miamake?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />'O Yesus wongose 'onaka, &lt;&lt;Tinisidemo ne'ena: 'O dunia ma sungioka dua 'o Nyawa ma Ngowaka wogogerie 'o koana ma go-gogeroka. De ngini, to ngoi 'ai do-domoteke, 'asa niogogerie 'o koana ma go-gogere 'o ngai mogiooko de modidioka ma ngale niakipareta niahakimi 'o Israeloka 'o suku mogiooko de modidi. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />De nago'ona gee yamadakau manga woa, manga riaka dodoto bolo manga 'esa biranga, manga dea de manga 'esa, manga ngowaka bolo manga bairi sababu ngoi, 'ona 'asa yomadamake 'isigali ma ratusu moi, de 'asa yamake 'o 'ahu kaisi'ado-'adonika. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ma 'o nyawa manga gudai gee ma 'orasi ne'ena yakimakeka 'o nyawa ma amoko, dua yodadi yotingoono, de gee ma 'orasi ne'ena yakimakeka yoti-tingoono, dua 'asa yodadi amoko.&gt;&gt;<verse eid="MAT 19:30" /></para>
  <para style="rem">Penyuntingan: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">'O 'ade-'ade yoma-manarama wimoi 'awi rakioka ge'ena la 'o 'anggur ma betuoka</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />&lt;&lt;Ma Jo'oungu ma Dutu wopareta 'isi'ade-'ade konee: 'O raki ma dutu ka 'o ngoru-ngorumikasi de wotagi wononu 'o nyawa la yomanarama 'awi 'anggur ma betuoka. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Gedagee womodekoka yomaka'aturu wofangu 'onaka 'o wange moi 'o pipi 'o saaka 'o ngai moi, de wosuloko yomanarama. <figure style="fig" file="HK00166.pcx" size="col" ref="(20:2)">'O pipi 'o saaka </figure> <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Poilia 'o gagini 'idudungu de ma raki ma dutu gu'una wotagioli, de wakimake yamuruo naga 'o pasarioka yosomoaku. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />De wongose 'onaka, &lt;Tagi niomanarama 'ai rakioka; 'asa tinikula nia sewa 'imakadaenoka.&gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ge'enaka de yotagiokau. 'O wange 'ikorona de 'o wange 'imasiniporo, wotagioli de koge'enali mita wodiai. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />De 'o wange 'alo, wotagioli de kawakimakesi yosomoaku, de wosano, &lt; 'Ido'oa so ngini kanimago-gogere 'o wange yamo-moi?&gt; <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />'Ona yosango, &lt;Sababu komoiwa misewa miomanarama.&gt; Ge'enaka de ma raki ma dutu wongose, &lt;Nako koge'ena, de tagi niomanarama 'ai rakioka.&gt;<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />'Iobirou, de ma raki ma dutu wongose yoma-manarama manga balusika, &lt;Tagi naki'asoko yoma-manarama de manga sewa nofangu 'ikurue gee yotu-tu'uruno yoboa, sigado gee yosira-sirano.&gt;<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Ge'enaka de yoboa yoma-manarama gee yokurue 'o wange 'alo. 'Ona yomadamake manga sewa 'o nyawa moi 'o pipi 'o saaka ngai moi. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ge'enaka de yoboa mita yomanarama gee ka 'o ngoru-ngorumikasi yokurue. 'Ona yomangano-nganono dua 'ona 'ifoloi 'iamoko yamadamake, 'ena momongo 'ona mita 'o nyawa moi ka koge'enali. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Gedagee yadawongo manga sewa, de yokurubungu ma raki ma dutuka, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />yongose 'ato, &lt;Yotu-tu'uruno yoboa, 'ona yomanarama ka 'o takoro moi. 'Ena ngomi 'o wange moi mimasidowoerika, ma ngona nofangu 'onaka kaimatero de ngomino!&gt; <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Ma bairi ma dutu gu'una wosango yoma-manaramika wimoi, &lt; 'Esa moi, ngoi kokiawa tasowono ngonaka. Ngonau ma sirete nosimotekokau nomanarama 'o wange moi 'ani sewa 'o pipi 'o saaka ngai moi? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Nee na'ese to ngona ni sewa la notagiou. Ngoi tomau takikula 'o nyawa yotu-tu'uruno gee, kaimatero de to ngini. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Koidadiwa? 'ai kia sonaa 'iodumu ne'ena ta'aturu moteke ngoi? Bolo notaleana sababu 'ai singina 'ima'ai?&gt;<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Koge'enali mita 'o nyawa yotu-tu'uru 'asa 'idadi yosira-sira, de yosira-sira 'asa 'idadi yotu-tu'uru.&gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">'O Yesus wobi-bicara ma warasa ma sa'ange ma ngale wosongene</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mrk. 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Ma 'orasi 'o Yesus wosikaie 'o Yerusalemude, de wi do-dagi ma sigoronaka de wi do-domoteke yamogiooko de modidi waki'asokino ka 'onaka, de wakisidemo, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;Nio'isenika! Ne'ena posikaie 'o Yerusalemude, kadaku dua de 'o Nyawa ma Ngowaka wisisarakani 'o 'imam ma saekika de 'o 'agamaka yodoto-dotoika. Ge'enaka de wihukumu wiso-songene. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />'Asa deika wisisarakani gee ko 'o Yahudiokawa ma nyawaka. 'Ona 'asa wisikahaga, wipesana, de wisidele 'o salipoka. Duga ma wange sa'angeka, 'asa wisimomikoli.&gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">'O Yakobus de 'o Yohanes manga 'esa 'ami ga-ga'asoko</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mrk. 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Ge'enaka de 'o Zebedeus ma wekata de mi ngowa-ngowaka yaino 'o Yesusino. 'O Yesus wi bionoka de mobukuku, ma ngale moga'asoko 'o barangi moi.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />'O Yesus wosano, &lt;&lt; 'Okia noparaluu, 'Esa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">De muna mosango, &lt;&lt;Ngoi tomau gee dua, 'Aba, nokoana, de 'ai ngowaka yamididi no'ona yogogere 'ani gubalioka de ni giniraoka.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />'O Yesus wongose, &lt;&lt;Ngini konianakowa 'okia nioga'asoko. Nia'akunoka? niamoku 'o sangisara ma dubuso gee dua 'isoka ngoi tamoku?&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />'O Yesus wongose, &lt;&lt;Ma goungu ngini mita dua nia'okere 'ai sawokoka, ma gee dua nago'ona yogogere 'ai gubalika de 'ai ginirakoka, ge'ena ko ngoiwa tositantuu. 'O ngii ge'ena ma nyawa 'ai Dea wakisitantuuokau.&gt;&gt;<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Gedagee 'o do-domoteke yamogiooko yo'isenoka ge'ena, de yongamo 'o riaka dodoto ma dutu yamididika go'ona. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Sababu ge'ena 'o Yesus wakikoki'asokino de wakidongose, &lt;&lt;Ngini nianakokau, gee ma Jo'oungu ma Dutu kowinako-nakowa yakipa-pareta, manga kawasa yahalebiru de 'o nyawa yola-laagomo manga kawasa yokido-doko. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ma ngini koidadiwa koge'ena. Nago'ona yomau yoamoko nginioka ne'ena, salingou yole-leleani nginika. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />De nago'ona nginioka naga yomau yomadadi ma di-disiraka, salingou yodadi 'o yongosi, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />'isoka 'o Nyawa ma Ngowakoli gu'una. 'Una woboa, ge'ena ma ngale kowileleaniwa, ma 'ena woleleani de 'awi 'ahu wokula, la watuusu 'o nyawa gudai manga sowono.&gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">'O Yesus wakisi'aiki 'o nyawa yamididi yopilo-piloko</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mrk. 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Ma moi ge'ena 'o Yesus de wi do-domoteke yamada 'o Yerikho ma kotaka, de manga gudai 'o Yesus wimoteke. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />'O ngekomo ma gagaroka yopilo-piloko yamididi yogogerie. Gedagee yo'isenoka 'o Yesus woboa, de yomapoa-poaka, &lt;&lt;Ee Dautu wi Ngowaka! Minidora ngomi!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />'O nyawa yoku-kudai ge'enaka gee yakigorese la yomaogoro. Ma 'ona kayodaamoko monga yomapoaka, &lt;&lt; 'Aba, 'o Dautu wi Ngowaka, minidora ngomi!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Ge'enaka de 'o Yesus womaogoruku so waki'asokino de wosano, &lt;&lt;Niomau 'okia todiai nginika?&gt;&gt;<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />'Ona yosango, &lt;&lt; 'Aba, ngomi miomau mimasimake!&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />'O Yesus wakisingina, so wa'ao manga akoka, de kage'ena de yomasimakekau. Ge'enaka de yomotekokau de 'o Yesus.<verse eid="MAT 20:34" /></para>
  <para style="rem">Penyunting: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">'O Yesus wowosama 'o Yerusalemuka de wisibusuku de wisirame</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mrk. 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Ma 'orasi 'o Yerusalem yodomoorika 'o Betfageka gee 'o Zaitun ma gigieka, ge'enaka de 'o Yesus wosuloko wi do-domoteke yamididi yosira. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />'O Yesus wakisibesesongo 'onaka, &lt;&lt;Niotagi 'o soanika doka nanga bionika gee. Ngini 'asa niamake 'o keledai<note caller="l" style="f"><char style="fr" closed="false">21:2: </char><char style="ft" closed="false">'O keledai ge'ena 'isoka 'o kuda ma dingoono.</char></note> ngai moi 'isipusuika de ma ngowaoka. Niasose 'o ngai modidi ge'ena, de nia'asano. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Nako moikani yosano, niongose 'ato ma Jou woparaluu. Dua 'asa yosidabi 'o keledai ge'ena nia'asa.&gt;&gt;<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ma hali ge'ena 'idadi, la 'isoka gee 'o nabii wimoi wosidemokau konee,<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Niosidemo 'o Sion ma nyawaka,</para>
  <para style="q2" vid="MAT 21:5">&lt;Nia Koana naga winidoboa.</para>
  <para style="q1" vid="MAT 21:5">'Una wi singina 'ima'ai, de woparenuku 'o keledaioka,</para>
  <para style="q2" vid="MAT 21:5">'o keledai ma ngowaka moi ma gooka.&gt; &gt;&gt;<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Ge'enaka de 'o do-domoteke yamididi go'ona yaika de yadiai 'isoka gee 'o Yesus wosibesesongokau 'onaka. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />'Ona ya'asa 'o keledai ge'ena de ma ngowaka. Ge'enaka de ma keledai ge'ena ma poretuku manga baju yosinao, deika 'o Yesus woparene. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Kadoka manga gudai manga baju 'o ngekomoko yosikokinao de manga gudai mita 'o gota ma sago ma di-dingoono ya'otono de yosikokibiakoro 'o tapakioko ma ngale wisiarene. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />'O nyawa manga gudai gee 'o Yesus wi bionisa de wisidudunoko, yosigaso-gasoko, &lt;&lt; 'Alele 'o Dautu wi Ngowaka! Tanu ma Jo'oungu ma Dutu wisibarakati 'una gee woboa de ma Jou 'awi kuasa. Powisiarene ma Jo'oungu ma Dutu gee 'ifoloi wodaduie gu'una!&gt;&gt;<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Gedagee 'o Yesus wowosanga 'o Yerusalem ma kotaka, de ma kota moi ge'ena yakikokitodokana de yosano, &lt;&lt; 'Etei! Nagu'una ne'ena?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />'O nyawa yoku-kudai gee wisiduo-duono yongose, &lt;&lt; 'Una 'o Yesus, 'o nabii moi 'o Nazaretino gee 'o Galileaka.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">'O Yesus wowosama ma Jo'oungu ma Dutu wi Woaka</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mrk. 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Ge'enaka de 'o Yesus wowosama ma Jo'oungu ma Dutu wi Woa ma ginitarika, de wakikokiginiiki gee yomawuku-wukunu de yo'ija-'ija ge'enaka dau. De wakokileoto pagara 'o pipi yosita-tagali manga meja, de 'o pombo yomawuku-wukunu manga go-gogere. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ge'enaka de 'o Yesus wakidongose, &lt;&lt; 'O Buku 'Itebi-tebinoka ma Jo'oungu ma Dutu wongose: &lt;To ngoi 'ai Woa dua yosironga 'o lahidoa ma ngii.&gt; Ma ngini niadiai 'isoka 'o kago'ora ma ngii.&gt;&gt;<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ge'enaka de 'o nyawa yopilo-piloko de yolugu-lugu yaino ge'ena ma Jo'oungu ma Dutu wi Woano so 'o Yesus wakisilaha. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Duga 'o 'imam ma saeke de 'o 'agamaka yodoto-dotoko gee yamake 'o no-nako 'ihera-herangi ge'ena, de yo'isene ma Jo'oungu ma Dutu wi Woaka 'o ngowa-ngowaka yosigaso-gasoko yongose, &lt;&lt; 'Alele 'o Dautu wi Ngowaka!&gt;&gt; De 'ona yakitu'uduku so yakingamo.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />'Ona kayongosekau 'o Yesusika, &lt;&lt;Ngona no'isene? 'okia naga yongose?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">'O Yesus wosango, &lt;&lt;Ia, to'isene. 'O Buku 'Itebi-tebinoka 'ingose konee: &lt; 'O ngowa-ngowaka de 'o la'ekati nakisidotokokau yosiarene ma gou-goungu.&gt; So koniabacawasi?&gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ge'enaka de 'o Yesus wakimadakou ge'enaka, de wosikaisa 'o Betaniasa so womatoobiri ge'enaka.<verse eid="MAT 21:17" /></para>
  <para style="s">'O Yesus wosibobeto 'o 'ara ma gota</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mrk. 11:12-14</ref>, <ref loc="MRK 11:20-24">11:20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ma bibinoka 'o ngoru-ngorumika de 'o Yesus wolioli 'o Yerusalemuoko, so wi do-dagi ma sigoronaka de wisawini. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ge'enaka de wamake 'o 'ara 'o utu moi 'o ngekomo ma gagaroka, de waika ma timika ma kowamakewa ma sowoko ka 'o ngai moi ma, duga ka ma soka. Ge'enaka de 'o Yesus wongose 'o gotaka ge'ena, &lt;&lt;Ne'ena dua konosowokuawau!&gt;&gt; De ma gota ge'ena kayasorogaku 'isongene. <figure style="fig" file="LB00085.tif" size="col" ref="(21:19)">'O 'ara ma gota</figure><verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Gedagee 'o do-domoteke yamake koge'ena 'idadi de yoherangi so yosano, &lt;&lt; 'Ido'oa so 'o 'ara 'o utu moi ge'ena kayasorogaku 'isongene?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />'O Yesus wongose 'onaka, &lt;&lt;Ma gou-goungu ne'ena, nako nia ngo-ngaku 'ikuata de nia singina koikapulawa, ge'ena dua nia'akunu niodiai 'okia naga gee todiaiokau 'o 'ara ma gotaka. De duga kage'enawa, ma dua ngini ngaro niongose 'o gigieka ne'ena, &lt;Nomagoraka la 'o ngootuku notumunu!&gt;, de dua 'asa 'idadi. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />'Okia naga bato niomaga'asoko de niolahidoa, ge'ena 'asa niomadamake, 'itilai niongaku.&gt;&gt;<verse eid="MAT 21:22" /></para>
  <para style="s">Yodasano 'o Yesus wi kuasa</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mrk. 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Ge'enaka de 'o Yesus wolioli ma Jo'oungu ma Dutu wi Woaka, so wowosamika de wodotoko. Wodotoko ma gu-gudaioka de 'o 'imam ma saeke de 'o Yahudioka ma balu-balusu yaino yosano, &lt;&lt;Kiano namake 'o pareta so ngona nodiai 'iodumu ge'ena?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />'O Yesus wosango, &lt;&lt;Ngoi mita tosano nginika. De nako ngini niosango, ge'ena ngoi mita 'asa tosidemo, nago'ona 'o kuasa 'ikula ngoi todiai 'iodumu ne'ena. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />'O Yohanes 'o nyawa waki'osiki ge'ena 'o kuasa nago'onano, ma Jo'oungu ma Dutuno bolo 'o nyawano?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Ge'enaka de 'o 'imam ma saeke de 'o Yahudioka ma balu-balusu yomatoomu de yokurue yomasikadibangi, &lt;&lt;Nako ngone pongose 'ato de ma Jo'oungu ma Dutu wi kuasa, dua 'una wongose, &lt;Nako koge'ena de 'ido'oa so koniongakuwa 'unaka?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ma nako pongose 'ato 'o nyawano, pakidomodongo 'o nyawa yoku-kudaika sababu 'ona yoodumu yanako 'o Yohanes ge'ena 'o nabii moi.&gt;&gt; <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />So 'ona yosango, &lt;&lt;Ngomi komianakowa.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Ge'enaka de 'o Yesus wakidongose, &lt;&lt;Nako koge'ena de ngoi mita kotosidemowa de nago'ona manga kuasa todiai 'iodumu ne'ena.&gt;&gt;<verse eid="MAT 21:27" /></para>
  <para style="s">'O 'ade-'ade 'o ngowaka yamididi</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Ge'enaka de 'o Yesus wongose, &lt;&lt;Kokia ne'ena nako moteke to ngini nia di-dibangi? Naga wimoi 'awi ngowaka 'o nauru yamididioka. Waika wi ngowaka 'o riaika wongose, &lt;Ngowaka, tagi nomanarama 'ai 'anggur ma bairoka ne'ena ma wange.&gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />'O ngowaka gu'una wosango, &lt;Tooluku&gt;, ma gedagee wi di-dibangi 'ingali de wotagiokau ma 'anggur ma bairika. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Ge'enaka de ma bereki gu'una waika wi ngowaka 'o dodotika wosidemo 'isoka koge'enali. 'O ngowaka gu'una wosango, &lt;Ia, 'Aba,&gt; ma kowotagiwa. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />'O ngowaka yamididi no'ona, nago'ona yamoteke ma dea 'awi mau?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">'O 'imam ma saeke de 'o Yahudioka yakidoto-dotoko yosango, &lt;&lt; 'O ngowaka 'o riaka.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">So 'o Yesus wakisidemo, &lt;&lt;Ngoi tinidongose, dua 'o balasitengi yoga-ga'asoko de 'o nge-ngeweka yakika-ka'angara 'isira yodadi ma Jo'oungu ma Dutu wi kawasa, de ngini ne'ena gee. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Sababu 'o Yohanes Wo'osi-'osiki woboa winisidumutu 'o 'ahu gee moteke ma Jou wi mau, ma 'awi do-dotoko koniongakuwa. Ma 'o balasitengi yoga-ga'asoko de 'o nge-ngeweka yoca-capurado, 'ona yongaku. De ngini ngaro niamakekau ge'ena 'iodumu ma konimangaliwa de niooluku niongaku ma Jouka.&gt;&gt;<verse eid="MAT 21:32" /></para>
  <para style="s">'O 'ade-'ade 'o nyawa yoma-manarama 'o 'anggur ma bairoka</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mrk. 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />'O Yesus wongose, &lt;&lt;Niosigisene 'o 'ade-'ade moioli ne'ena. 'O tonaka ma dutu wimoi wi 'anggur wotuduku 'o dae moi, de wahisa wosikilolitoka. Ge'enaka de 'o sukono wodiai ma ngale ma 'anggur yode-deteo, de mita 'o woa 'ikuru-kurutie woditiai ma bairi ma dodaka la ge'enaka yojaga. 'Asa de 'o 'anggur ma betuoka ge'ena wakisewa yoma-manaramika yojaga, de 'una wotagiokau 'o daeraa 'ireguka. <figure style="fig" file="LB00103.tif" size="span" ref="(21:33)">'O 'anggur ma bairi de ma hisa, ma 'anggur yode-deteo ma ngii, de ma 'anggur ma bairi yojaga-jaga manga ngii</figure> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Gedagee ma 'orasi ya'adono 'o 'anggur ma sowoko yotowi, ma tonaka ma dutu gu'una wosidingoto wi ro-riwo, ma ngale ya'ese ma bula. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ma yoma-manarama 'o 'anggur ma betuoka go'ona, yakitagoko ma tonaka ma dutu wi ro-riwo go'ona. So wimoi wipesana, de munuka yakito'oma, de munukali yakiteto. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />'O tonaka ma dutu gu'una wosidingotoli wi ro-riwo 'iregu 'ifoloiosi yokudai de gee ma di-disiraka. Ma yakidiai ka koge'enali. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ma du-du'uruoka ge'ena tahani ka wi ngowakou ma dutu wasuloko. Watibangi 'ato, &lt; 'Ai ngowaka ge'ena dua ma raiokau wisingounu.&gt; <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ma gedagee yoma-manarama 'o 'anggur ma betuoka wimake 'o tonaka ma dutu wi ngowaka gu'una, de yomakadongose, &lt;Ee, nu'unau ma warisi ma dutu, so nou, powito'oma la ngone pomadamake 'o warisi!&gt; <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />So 'o ngowaka gu'una witagoko, de wi'asa ma raki ge'ena ma dudunika de wito'omaka.&gt;&gt;<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />'O Yesus wosano, &lt;&lt;So kokia nako ma tonaka ma dutu gu'una woliono? 'Una dua kokia gee yoma-manaramika?&gt;&gt;<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />'Ona yosango, &lt;&lt;Yotorouoka 'ona. Sababu ma raiokau 'una 'asa wakisotumu gee yoti-tingkai go'ona, de ma 'anggur ma betuoka ge'ena dua 'o nyawa 'iregukali wakisewa, gee ma bula yokula ma 'orasi ya'adono de.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />So 'o Yesus wakidongose, &lt;&lt;Koniabacawasi 'o Buku 'Itebi-tebinoka?</para>
  <para style="q1" vid="MAT 21:42">&lt; 'O teto gee kaya'umokou 'o woa yodi-diai,</para>
  <para style="q2" vid="MAT 21:42">'idadi ma ba-bangini ma guata.</para>
  <para style="q1" vid="MAT 21:42">Ne'ena ge'ena ma Jou wodiai;</para>
  <para style="q2" vid="MAT 21:42">duru de 'i'ofioka!&gt;<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />So niongano-nganono! Ma Jo'oungu ma Dutu 'asa winisisupu 'awi pareta ma sigoronaka, de wakipareta kiaka naga 'o nyawa gee ma Jo'oungu ma Dutu wi pareta yosidagi. [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />De nago'ona yoruba 'o tetoku ge'ena, dua 'asa yopetetoka; de nago'ona yakitapadu 'o teto ge'ena, dua yowederoka.]&gt;&gt;<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />'O 'imam ma saeke de 'o Farisioka yo'isenoka 'o Yesus wi 'ade-'ade ge'ena de 'ona yanako 'ato 'o Yesus wobi-bicara ma ngale 'ona. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />So 'ona yosikadike ma 'akali la witagoko, duga kayododatoka 'o nyawa yoku-kudaika, sababu 'o nyawa yoku-kudai 'ona yanako 'o Yesus ge'ena 'o nabii moi.<verse eid="MAT 21:46" /></para>
  <para style="rem">Penyuntingan: Ning 9-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">'O 'ade-'ade 'o ngaamoko ma ngodomo</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk. 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />'O Yesus wobi-bicarali 'onaka de 'o 'ade-'ade, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />wongose, &lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, ge'ena 'isoka 'o 'ade-'ade ne'ena: Ma Koana wimoi 'o rame wodiai ma ngale wi ngowaka wongaamoko. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Ma Koana gu'una wosuloko wi ro-riwo yotagi yakitongoono 'o nyawa gee yaki'aso-'asoko 'o rameno, duga 'ona yoolukino. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Ge'enaka de ma Koana gu'una wosulokoli wi ro-riwo 'ireguka, &lt;Niakidongose 'o ga-gasoko yamake-makekau go'ona: 'O biono 'iduangukou, 'ai sapi ma balusu de ma goo-gooka yaowa-owa ma 'ikokitoaukou. 'Iodumu 'ikokiduangukou so yainou 'o ngaamoko ma rameno!&gt; <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ma gee 'o ga-gasoko yamake-make, koyokalesangikawa. Munuka 'ona kayosikaika moi-moi manga manaramika, munuka manga bairika, munuka naga manga manarama 'ireguka, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />de munukali ge'ena yakitagoko ma Koana wi ro-riwo go'ona, de yakipesana yakisongenoka. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Ma Koana wo'isenoka ma hali ge'ena, de wi do'otasa 'irama so wosuloko wi solodado yaika yakito'oma gee yoto-to'oma go'ona, de manga kota yatuuku. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Ge'ena 'ipasa de ma Koana gu'una waki'asokino wi ro-riwo de wakidongose, &lt; 'O ngaamoko ma biono 'iduangukou, ma 'o ga-gasoko yamake-make go'ona koyakisorawa yodoboa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Sababu ge'ena, ma 'orasi ne'ena niotagi naga 'o tapaika, la niakudaino 'o nyawa niaki'asoko 'o ngaamoka ma rameno ne'ena.&gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Ge'enaka de 'o ro-riwo go'ona yotagi naga 'o tapaika, de yakikokitoomu nago'ona bato yakimake, 'o nyawa ma owa bolo ma dorou. Sigado 'o ngaamoko ma rame ma ngii ge'ena ya'oma-'omanga.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Ge'enaka de ma Koana wowosama wakikokilega wi woa ma gikiri go'ona, de wimake wimoi ge'enaka 'awi baju koyadaenuwa wosiwosanga 'o rameno. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />De ma Koana gu'una wosano, &lt; 'Esa moi, kokia ngona 'idadi nowosama ne'enano konomasinoakuwa 'o rame ma baju?&gt; Ma 'o nyawa gu'una kaworii-riidika. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Ge'enaka de ma Koana wosuloko wi ro-riwoka, &lt; 'O nyawa gu'una wi dou de wi giama niapusuku, de wini'umo ma dudunika gee 'o ngii 'imoo-moongika. Ge'enakau doka dua 'o gari de 'o sangisara.&gt; &gt;&gt;<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Ge'enaka de 'o Yesus wositogumu wi 'ade-'ade ge'ena, konee, &lt;&lt;Manga gudai waki'asoko, ma ka munuka wakiiriki.&gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">'O balasitengi</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mrk. 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ma moi ge'ena 'o Farisioka yomatoomu yomasikadibangi ma ngale kokia 'o Yesusika witaili de manga sa-sano. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />So yakisuloko manga do-domoteika de 'o nyawa gee de 'o Herodes 'o paratei moi yaika 'o Yesusika. Yaika de yongose 'ato, &lt;&lt; 'Aba Guru, ngomi mianako ngona noloa. Ngona nodotoko kanositi-tiaika ma Jo'oungu ma Dutu wi mau 'o nyawaka, komoiwa moi manga di-dibangi nodomoteke, sababu ngona konakidomodonguwa nago'ona bato. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />So bika nosidemo ngomino, moteke to ngone nanga 'agama ma mau; kaidadi? 'o balasitengi pofangu 'o Kaisarika, bolo koidadiwa?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />'O Yesus wanako manga singina ma dorou ge'ena, so wongose, &lt;&lt;Ee, ngini nioelu-eluku! 'Ido'oa so niomau nitaili? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Bika niosidumutino nia pipi gee niosifangu-fangu 'o balasitengi!&gt;&gt;</para>
  <para style="p" vid="MAT 22:19">Ge'enaka de 'ona yokula 'o pipi 'o saaka 'o ngai moi. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />De 'o Yesus wakisano, &lt;&lt;Nagu'una 'awi gambari de wi ronga ne'ena?&gt;&gt;<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />'Ona yosango 'ato, &lt;&lt;To Kaisar, ma Koana ma Amoko.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Ge'enaka de 'o Yesus wakidongose, &lt;&lt;Nako koge'ena, de niokula ma koanika 'okia naga gee to ma Koana, de niokula ma Jo'oungu ma Dutuka 'okia naga gee to ma Jo'oungu ma Dutu.&gt;&gt;<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Gedagee yo'isenoka 'o Yesus wi demo ge'ena, de yoherangi. So kage'ena de yotagiokau so wimadakau 'una ge'enaka.<verse eid="MAT 22:22" /></para>
  <para style="s">Posongenokau de pomomikoli</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mrk. 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ma wange ge'ena mita, 'o Sadukioka yamuruo naga yaino 'o Yesusino, 'ona ge'ena yanako 'o nyawa yosongenokau ge'ena dua koyomomikuawau. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />'Ona yongose 'o Yesusika, &lt;&lt; 'Aba Guru, 'o Musa wosidotoko konee: Nako wimoi wosongene 'ena wi ngowaka koi'iwa, 'awi 'esa moi salingou mingaamoko 'o bao-bao gumuna, la wosonge-songenokau gee, 'unaka deuku 'awi 'asali 'uwa 'iisanga. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ne'enaka naga ngomioka 'o 'esa moi yatumudiingoka. 'O riaka wongaamokino, duga wi ngowaka koi'iwa de wosongenokau. So 'awi bao gumuna wi dodotuku widamada. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ge'enaka de wi dodotoli gu'una ma wi ngowaka koi'iwa de wosongenokau. Deuku wi dodotuku yaruange sigado yatumudiingi ge'ena ka koge'enali. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ma du'uruku 'o ngeweka gumuna mita mosongene. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />So dua gee yosonge-songenoka yokokimomikoli, de muna dua to nagu'una wi wekata? Sababu yatumudiingi go'ona yoodumu mingaamokoka?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />'O Yesus wosango, &lt;&lt;Ngini nioliba ma sala sababu koniasahewa 'o Buku 'Itebi-tebini de ma Jo'oungu ma Dutu wi guata. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Sababu dua nako 'o nyawa yosonge-songenoka yomomikie, ge'ena koyongaamokuawau ma yo'ahu 'isoka 'o mala'ekati 'o sorogaaka. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Koniabacawasi? kokia ma Jo'oungu ma Dutu wosidemokau ma ngale 'o nyawa yosonge-songenoka yakisimomikoli? Ma Jo'oungu ma Dutu wongose, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />&lt;Ngoi ne'ena 'o Abraham de 'o Ishak, de 'o Yakub 'isuba-suba.&gt; 'Una ge'ena koyosonge-songenuwa manga Jo'oungu ma Dutu, ma 'ena yowango-wango.&gt;&gt;<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />'O nyawa yoku-kudai go'ona gee yo'isenoka 'o Yesus 'awi do-dotoko koge'ena, de yokokiherangi.<verse eid="MAT 22:33" /></para>
  <para style="s">'O besesongo ma titi</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mrk. 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Ge'enaka de 'o Farisioka yomatoomu sababu yo'isene 'ato 'o Yesus wakidomoi-moi 'o Saduki ma nyawaka so 'ona kokiawau yongose. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ge'enau so manga 'agamaka wodoto-dotoko wimoi 'o Yesusika witaili wosano, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Ee 'Aba Guru, nanga 'agamaka 'o besesongo ka'ena 'ifoloi 'iamoko?&gt;&gt;<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />'O Yesus wosango, &lt;&lt;Winisibosono ma Jo'oungu ma Dutu de nia singina ma gou-goungu, de nia guata, de nia di-dibangi 'iodumu. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ge'ena 'o besesongo ma di-disiraka de ma titi. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />De 'o besesongo modidi gee kaimatero de 'o besesongo ma di-disiraka, ge'ena: Niomasikabosono moi de moi 'isoka to ngini ma sirete nia roese niosibosono. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />'O 'agama ma besesongo gee 'o Musa wosidoto-dotoko de 'o nabii manga do-dotoko 'iodumu ge'ena ma titi 'o besesongo ngai modidino ne'ena.&gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">'O Koana ma Jo'oungu ma Dutu Wiiri-iriki gu'una</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mrk. 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />'O Farisioka kayomatoomunosi ge'enaka de 'o Yesus wosano 'onaka, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt;Kokia moteke ngini ma ngale 'o Koana ma Jo'oungu ma Dutu Wiiri-iriki? 'Una wi 'asali kiano?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">'Ona yosango, &lt;&lt; 'O Dautino.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />'O Yesus wongose, &lt;&lt;Nako koge'ena de 'ido'oa so 'o Dautu 'o Ngomasa 'Itebi-tebini widugutiku la 'o Koana ma Jo'oungu ma Dutu Wiiri-iriki gu'una wisironga ma Jou? Sababu 'o Dautu wongose:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />&lt;Ma Jou wongose 'ai Jouka:</para>
  <para style="q2" vid="MAT 22:44">Tonigoraka nodadi Koana la nopareta de de ngoi,</para>
  <para style="q2" vid="MAT 22:44">sigado nisa-saturuu takidiai yo'isene ngonaka.&gt;<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />So nako 'o Dautu ma Jo'oungu ma Dutu wi Ngirikika wisironga &lt;ma Jou&gt;, kokia so 'una 'awi 'asali 'o Dautino?&gt;&gt;<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Komoiwau yosango, de ge'enau ma 'orasi 'ikurue komoiwau yomoroini yokasano-sano 'unaka.<verse eid="MAT 22:46" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">'Inasingano-nganono la pomasitiari 'o 'agamaka yodoto-dotoika de 'o Farisioka</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mrk. 12:38-39</ref>; <ref loc="LUK 11:43">Luk. 11:43</ref>, <ref loc="LUK 11:46">11:46</ref>, <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ge'enaka de 'o Yesus wongose 'o nyawa yoku-kudaika de wi do-domoteika, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />&lt;&lt; 'O 'agamaka yodoto-dotoko de 'o Farisioka 'ona yakisiga-gao ma ngale yosiwaiti 'o Musa wi besesongo. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />So 'okia naga yosuloko ge'ena niamoteke, ma 'uwa niamoteke 'isoka kokia naga 'ona yokadi-diai, sababu 'ona koyamotekuwa 'isoka gee yosidoto-dotoko. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />'Ona yogegoto 'okia sonaa 'isusa-susa, de yakikula 'o sagala 'atorangi 'itu-tubuso, ma 'ona ka ma eta ma koyakiriwowa gee 'o nyawa yadiai koge'ena. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />'Iodumu yokakadiai ge'ena duga kayomau la 'o nyawa yamake. 'Ona yoduaka yomasinoa 'o Buku 'Itebi-tebini ma bo-bula ma ngii ma bu-busuku 'ila-laagomo, de 'o baju ma renda-renda yaku-kurutuku. <figure style="fig" file="LB00276.tif" size="col" ref="(23:5)">'O Buku 'Itebi-tebini ma no-noimi ma ngii</figure> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Yoduaka 'o ngii de 'o go-gogere 'isure-sureka nako 'o rameka bolo 'o lo-lomu ma woaka. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />'Ona yoduaka 'o nyawa yakisiie-ie 'o pasarioka de yakisi'asoko, &lt;Rabi&gt;.<note caller="m" style="f"><char style="fr" closed="false">23:7: </char><char style="ft" closed="false">'O Rabi ge'ena 'o Yahudioka manga guru yakiho-horomati yakisi'asoko.</char></note> <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ma ngini 'uwa niomau nisi'asoko, &lt;Rabi!&gt;, sababu to ngini nia Guru duga kawomatengoka, de ngini nioodumu ge'ena ka 'o 'esa moi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />De 'o duniaka ne'ena ka moika ma 'uwa nio'asoko niakisiie-ie, &lt; 'Aba!&gt;, sababu to ngini nia 'Aba ge'ena kawomatengoka gee daku 'o sorogaaka. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />De 'uwa ngini niomau nisi'asoko, &lt;Tuangi ma Amoko&gt; sababu to ngini nia tuangi ma amoko duga kawomatengoka, ge'ena la ma Jo'oungu ma Dutu wi Ngiriki, gee ma Jo'oungu ma Dutu wojajiokau 'asa woboa. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />'O nyawa gee 'ifoloi yoamoko de de ngini salingou yodadi nia yongosi. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />'O nyawa gee yomadaduie ma Jo'oungu ma Dutu 'asa wakisidaduuku, de 'o nyawa gee yomasidaduuku 'asa wakisidaduie.&gt;&gt;<verse eid="MAT 23:12" /></para>
  <para style="s">'O Yesus wakisitobionika gee yoma'uca-'uca</para>
  <para style="r">(<ref loc="MRK 12:40">Mrk. 12:40</ref>; <ref loc="LUK 11:39-52">Luk. 11:39-52</ref>, <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt;Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka! Ngini niomataba'uca-'uca. Ngini niakitatoko 'o nyawa gee yomau yodadi ma Jo'oungu ma Dutu wi kawasa. Ngini ma sirete niooluku niodadi ma Jo'oungu ma Dutu wi kawasa, de gee 'o nyawa yomau-mau, ngini koniakisidabiwa.</para>
  <para style="p" vid="MAT 23:13">[<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka! Ngini nimataba'uca-'uca. Ngini niakisihaga 'o bao-bao de manga kia sonaa nia'ese niabo-bootoka, de nia di-diai 'ito-torou ge'ena niositamunu de 'o lahidoa 'ikuru-kurutika. Ge'enau so to ngini nia hukumani dua 'ifoloi 'itubuso!]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka! Ngini nimataba'uca-'uca. Ngini niokakadagi 'o gurutika ma ngale niomau la moi yowosama to ngini nia 'agamaka. De gedagee yowosamokau de ngini niakidiai 'onasi 'ifoloika manga di-diai 'itorou de to ngini ma!<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Niotorouoka ngini niomau 'o nyawa niakituda 'ena momongo ngini ma konimasimakewa! Sababu ngini niodotoko 'ato, &lt;Nako 'o nyawa yosasi de ma Jo'oungu ma Dutu wi Woa, ge'ena ngaro koyadiaiwa ma koido'oawa. Duga nako yosasi de ma Jo'oungu ma Dutu wi Woaka ma guraci, manga sasi ge'ena salingou yadiai.&gt; <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ngini niohaga-haga de niopilo-piloko! Ka'ena 'ifoloi 'ibaraguna, 'o guraci bolo ma Jo'oungu ma Dutu wi Woa gee yositebini 'o guraci ge'ena? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Ngini niodotoko koneda mita: &lt;Nako moi yosasi de 'o su-suba yodu-dutuuku ma ngii, ge'ena ngaro manga sasi koyadiaiwa ma koido'oawa, ma nako yosasi de 'o su-suba gee to 'ena ma ngiioka, ge'ena salingou yadiai.&gt; <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ngini posironga de niopilokoka! Ka'ena 'ifoloi 'ibaraguna? 'O su-suba bolo 'o su-suba yodu-dutuuku ma ngii gee yositebi-tebini ma su-suba ge'ena? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Sababu ge'ena, nako la moi yosasi de 'o su-suba yodu-dutuuku ma ngii, ge'ena ma ngale yosasi de 'o su-suba gee ma ngiioka mita. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />De nako moi yosasi de ma Jo'oungu ma Dutu wi Woa, ge'ena ma ngale mita ma Jo'oungu ma Dutuka. Sababu 'una womanoa ge'enaka. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />De nako la moi yosasi de 'o sorogaa, ge'ena ma ngale yosasi de ma Jou wi go-gogere, de mita ma Jo'oungu ma Dutuka gee wogogerie ge'enaka. <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka! Ngini nimataba'uca-'uca. 'O rapa-rapa 'isoka 'o sulasi, 'o 'iri-'irisi, de 'o galiasaa ma niokula ma persen mogiooko ma Jouka. 'Ena momongo 'okia naga gee 'ifoloi 'ibaraguna 'o 'agama ma besesongoka 'isoka 'o loa, 'o sikamara'ai de 'o singounu, koniamotekuwa. 'Ena ge'enau 'ifoloi 'ibaraguna niamoteke, de 'iregu-regu mita niamoteke. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Ngini ne'ena niosi'asa-'asa niopilo-piloko! 'O gu'uuru nia 'akeroka ge'ena niati-tisiokasi, 'ena momongo 'o 'onta ge'ena kanioasirou.<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka! Ngini nimataba'uca-'uca. Ngini nia 'ahu 'isoka 'o sawoko de nia sude ma dudunino nia'isoko niatebi-tebini monga, 'ena momongo ma dodaka kaige-ge'ewere, ngano 'okia sonaa niamake ge'ena ka de nia singina ma dorou de nia dopokana. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ee ngini 'o Farisioka konimasido-dongoowa! 'Isira nia'isoko niatebinikasi nia sawoko de nia sude ma dodaku, la ma dudunino mita 'itebini.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka gee niomataba'uca-'uca! Ngini 'isoka 'o bo'osuku gee ma dudunino yacetioka, ma cet 'i'are-'arese so ma dudunika pamakeka ma sureka 'ena ma dodaka doka 'o kobongo de 'o boanga. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Koge'enali mita ngini! 'O nyawa nimakeka nioloa, 'ena momongo nia singina ma dodaka ka 'o ngeluku de 'o dorou.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Niotorouoka ngini 'o 'agamaka niodoto-dotoko de 'o Farisioka gee nimataba'uca-'uca! Ngini niodiai 'o nabii manga bo'osuku de 'o nyawa yoloa-loa manga tugu ma ngale niakingano-nganono. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />De niongose 'ato, &lt;Nako ngomi mio'ahu ma 'orasi 'amia edete de mia dotumosi, tanu ngomi komiomotekuwa mioto'oma 'o nabii-nabii.&gt; <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />So nginiou ma sirete nimasidemo 'ato ngini ge'ena 'o nabii-nabii yakito-to'oma manga waata. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Nako koge'ena de tagi niosigila de niositotomika 'o so-sowono gee nia edete de nia dotumu yosikuruekau. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Ee ngini ne'ena 'o ngowosana ma ngowa-ngowaka! Kokia ngini 'idadi nimasimada nia hukumanioka gee 'o narakaka? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Sababu ge'ena, ngoi dua takisidingoto nginika 'o nabii-nabii de 'o nyawa yoca-cawaro de yodoto-dotoko; munuka dua niakito'oma, de munuka niakisidele 'o salipoka, de munukali niakisikisaa 'o lo-lomu ma woa-woaka, de niakiginiiki 'o kota moioka de 'o kota 'ireguka. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Ge'enau so, ngini 'asa nihukumu sababu niakito'oma 'o nyawa gee manga sala koi'iwa 'ikurue 'o Habelioka, sigado 'o Zakharia 'o Berekhya wi ngowaka gee winito'oma ma Jo'oungu ma Dutu ma sirete 'awi Woa de 'o su-suba yodu-dutuuku ma ngii ma sigoronaka. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Ngoi tinisidemo: Ma hali ne'ena 'iodumu dua 'o nyawa-nyawa ma 'orasi ne'ena naga yamoku.&gt;&gt;<verse eid="MAT 23:36" /></para>
  <para style="s">'O Yesus 'o Yerusalem wasingina</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk. 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Sioko Yerusalem ma nyawa! Sioko Ee! Ngini niakito'omakau 'o nabii-nabii! Niakiteto niakisongenoka ma Jo'oungu ma Dutu 'awi su-suloko! 'Igi-giliou tomau tiniriwo 'isoka 'o namoro ma 'esa ma ngowaka yajagano yaporonuku, ma ngini niooluku! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Sababu ge'ena ma Jo'oungu ma Dutu ko de de nginiwau. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Niongano-nganono! Ngini 'asa konimakewau ngoi. Dua sigado niongose 'ato, &lt; 'Alele! Wisibarakati 'una gee woboa de ma Jou wi kuasa!&gt;, 'asa de nimakeli.&gt;&gt;<verse eid="MAT 23:39" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">'O Yesus wobi-bicara ma ngale ma Jo'oungu ma Dutu wi Woa 'ipiakoro</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mrk. 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Ge'enaka de 'o Yesus wosupuokau ma Jo'oungu ma Dutu 'awi Woaka, de 'awi do-domoteke yaika 'unaka de yatumutu ge'ena ma Jo'oungu ma Dutu 'awi Woa 'iodumika. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />'O Yesus wongose 'onaka, &lt;&lt;Niamakekau? 'iodumu ge'ena? Tinisidemo, dua ma teto ge'ena ka 'o ngai moi ma koimakaretenukuwau ma ngiioka. 'Iodumu dua yakokitotaoka.&gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">'O susa de 'o sangisara dua 'iboa</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mrk. 13:3-13</ref>; <ref loc="LUK 21:7-19">Luk. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ge'enaka de 'o Yesus 'o Zaitun ma gigieka waika so wogogeruku, de wi do-domoteke yaika ma ngale yomabi-bicara ka 'onaka. 'Ona yosano, &lt;&lt;Muruoka ge'ena 'iodumu 'idadi? De kokia ma no-nako dua gee ngona noboali, de mita 'o dunia ma do-dogumu?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />'O Yesus wosango, &lt;&lt;Nimasitiari 'uwa sigado 'o nyawa nisiliba. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Sababu dua manga gudai 'ai ronga ya'asa de yongose, &lt;Ngoi ne'ena 'o Koana 'o Nyawa Wosilaha-laha ma Jo'oungu ma Dutu Wiiri-iriki!&gt; 'Ona ge'ena dua yosiliba 'o nyawa gudai. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Ngini 'asa nio'isene 'o parangi ma 'ilingi de ma habari, ma 'uwa nimodongo sababu ge'ena 'iodumu salingou 'idadi, ma ge'ena ko ma ngalewa 'ato ya'adonou 'o dunia ma do-dogumu. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />'O suku de 'o suku, 'o negara de 'o negara 'asa 'imakakudoti. Kiaka naga bato dua 'idadi 'o baulaco de 'o 'osu. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ge'ena 'iodumu 'asa ka ma gurue, ma siri 'isoka mimoi momaku'arenou.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />De ngini 'asa nitagoko de nisisarakani la nisikisaa de nito'oma. 'O duniaka yoodumu 'asa nidu'uduku sababu ngini to ngoi 'ai do-domoteke. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ma 'orasi ge'ena dua 'o nyawa manga gudai koyongakuwau, de yomakawukunu de yomakadu'uduku. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />'O nabii yoelu-eluku 'asa manga gudai yoboa de yosiliba 'o nyawa manga gudai. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />'O dingkai 'asa 'imarajalela sigado manga gudai koyomakasinginawau. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ma godagee yomatahani sigado ma do-dogumika, 'ona ge'ena 'asa ma Jo'oungu ma Dutu wakisilaha. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />De 'o Habari ma Owa ma ngale ma Jo'oungu ma Dutu kokia wopareta 'asa yosihabari 'o dunia yasuluunuku, la 'o nyawa 'iodumu yo'isene. Ge'ena 'ipasa 'asa de 'o dunia ma do-dogumu.&gt;&gt;<verse eid="MAT 24:14" /></para>
  <para style="s">'O dorou yamediri ma Jou 'awi Woa<note caller="n" style="f"><char style="fr" closed="false">24:15: </char><char style="ft" closed="false">'O gomanga ma dutu yosingosama ma Jo'oungu ma Dutu 'awi Woaka so yamediri ma Jo'oungu ma Dutu 'awi Woa. Posidelega Dan. 9:27, 11:31, 12:11.</char></note></para>
  <para style="r">(<ref loc="MRK 13:14-23">Mrk. 13:14-23</ref>; <ref loc="LUK 21:20-24">Luk. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Ngini 'asa niamake &lt; 'O Dorou gee 'Isito-torou&gt;, 'isoka ma Nabii Daniel wosidemokau, gee 'ima'okode ma Jo'oungu ma Dutu 'awi Ngii 'Itebi-tebinoka. (Ngini gee niabaca-baca, bika niatibangi la tanu ma ngale niasahe.) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Ma 'orasi ge'ena gee 'o Yudeaka salingou yoowara 'o gigieka. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />'O nyawa gee daku manga woa ma dekuoka 'uwa yadongosamoli manga woa ma dodaku ma ngale manga kianikia yo'ese. <figure style="fig" file="HK00233.pcx" size="span" ref="(24:17)">'O woa 'o Palestinaka</figure> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Gedagee manga bairoka yaika 'uwa yogilio manga juba. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ma 'orasi ge'ena yo'iraka 'o nge-ngeweka gee yotu-tubuso, de 'o ngowa'esa. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Niomalahidoa la 'uwa 'o besa-besaka bolo Pomaoma-omasa ma Wange de ngini nioowara! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ma 'orasi ge'ena dua 'o sangisara 'idadi gee koma'iwasi 'idadi ka ma gurue 'o dunia 'idadi sigado ne'ena, de dua koma'iwau. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Nako ma Jo'oungu ma Dutu kowositipokowa ma 'orasi, ma raiokau komoiwau yo'ahu-'ahuosi. Ma ngano 'awi kawasa, so wositipoko ma 'orasi ge'ena.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Ma 'orasi ge'ena nako moi yongose nginika 'ato, &lt;Ma Jo'oungu ma Dutu wi Ngiriki nongoka bolo ge'enaka naga&gt;, 'uwa niongaku. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Sababu dua 'asa yoboa yosilaha-laha ma ngeluku de 'o nabii-nabii ma ngeluku. 'Ona 'asa yodiai 'okia sonaa gee kobiasawa de 'o no-nako 'ihera-herangi la yosiliba, de poilia ma Jo'oungu ma Dutu wi kawasa mita. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ngoi tinisidemokau ko ma 'orasuawasi ma hali ge'ena 'idadi, so niongano-nganono.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Nako 'o nyawa yongose nginika 'ato, &lt; 'Una doka 'o tonaka 'ika-kakasaka de 'iga-gamamuoka,&gt; 'uwa niaika. Bolo nako yongose 'ato, &lt; 'Una woma'iunika nongoka 'o kamaroka,&gt; 'uwa niongaku. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Sababu 'o Nyawa ma Ngowaka woboa 'isoka 'o tawi-tawi ma letongo dinaoko de 'isiwara sigado 'o wange ma dumunoko.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />Kiaka naga 'o haewani ma songene, ge'enaka 'o wogono 'imatoomu.&gt;&gt;<verse eid="MAT 24:28" /></para>
  <para style="s">'O Nyawa ma Ngowaka wibo-boa</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mrk. 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />&lt;&lt;Gedagee 'o sangisara 'ipasa, koito'ingowa de 'o wange ma ako 'itarusu de 'o mede koisiwaruwau. 'O ngoma 'o diwangoka 'asa 'ikokitotaka, de 'o ngawa-ngawaka ma kuasa 'asa 'ikawecara. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Ge'enaka 'asa deika 'o Nyawa ma Ngowaka woboa ma no-nako niamake 'o diwangoka. Ma 'orasi ge'ena 'o nyawa 'o jiko 'isinoimi 'o duniaka gee 'asa yokoki'ari. 'Ona 'asa wimake 'o Nyawa ma Ngowaka woboa daku 'o kakamoroka de wi pareta de wi kumati 'iamoko. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Gedagee 'o torompet ma 'ilingi 'iamo-amokie yauwaka de 'o Nyawa ma Ngowaka 'asa wakokisuloko wi mala'ekati yatoomu 'awi kawasa 'o 'alami ma libuku soata gee 'o dunia ma do-dogumoka naga de 'isiino.&gt;&gt;<verse eid="MAT 24:31" /></para>
  <para style="s">'O do-dotoko 'o 'ara ma gotano</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mrk. 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt;Nia'ese 'o do-dotoko 'o 'ara ma gotano. Nako ma sago-sago 'iboboko de 'ito'ori, ngini nianako 'ato 'o ngogoro ma 'orasi 'isoriokau. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Koge'enali mita nako ngini niamake 'o susa de 'o sangisara gee tosidemo-demokau 'iodumu la 'idadi, ge'ena ngini 'asa nianako ma 'orasi ge'ena 'isori ma foloiokau. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Tinisidemo! Ma hali ge'ena 'idadi dua gee 'o nyawa yo'ahu-'ahu ma 'orasi ne'ena koyobootuawasi yosongene. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />'O diwanga de 'o dunia 'asa 'iisanga, ma 'ai demo-demo dua kaisi'ado-'adonika.&gt;&gt;<verse eid="MAT 24:35" /></para>
  <para style="s">Komoiwa yanako ma wange de ma 'orasi</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mrk. 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk. 17:26-30</ref>, <ref loc="LUK 17:34-36">17:34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />&lt;&lt;Komoiwa yanako muruoka ma wange de ma 'orasi. 'O mala'ekati 'o sorogaaka mita koyanakowa, ma Jo'oungu ma Dutu wi Ngowaka ma kowanakowa, ka ma Dea duga wanako. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Nako dua 'o Nyawa ma Ngowaka woboa, dua ma lugo 'isoka ma sira ma 'orasi 'o Nuh. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Gee 'o ngu'uisi ma amoko koiboawasi, ge'ena yomangodomo de yomagokere de yomakangaamoko. Koge'enau koitoakuwa sigado 'o Nuh 'o kapalika wowosamoka. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />'Ona koyanakowa 'okia dua 'idadi, so gee ma ngu'uisi ma amoko yakikokiolu, 'asa de yanako 'ato 'idadiokau. Koge'ena mita dua 'idadi gee 'o Nyawa ma Ngowaka woboa. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ma 'orasi ge'ena nako yamididioka 'o bairoka yomanarama, ge'ena wimoi wi'asaka, wimoi wimadaku. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Nako 'o ngeweka yamididioka 'o bira yotutuku, ge'ena mimoi mi'asaka, mimoi mimadaku. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />So salingou nimajaga-jaga sababu konianakowa muruoka de nia Jou woboa. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Niongano-nganono ne'ena! Nako 'o woa ma dutu wimoi wanakokau 'o takoro muruo 'iobiruku de yotosi-tosiki yoboa, 'una dua kowoma'iduwa la 'uwa yowosama. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />So ngini mita salingou niomajaga-jaga. Sababu 'o Nyawa ma Ngowaka dua woboa ma 'orasi konianakowa.&gt;&gt;<verse eid="MAT 24:44" /></para>
  <para style="s">'O ro-riwo wosingou-ngounu de kowosingou-ngounuwa</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk. 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />'O Yesus wongoseli, &lt;&lt; 'O ro-riwo gee wosingou-ngounu de wobarija, 'unau manga balusu wigoraka widiai 'o ro-riwo 'iregu manga saeke la wakikula 'o 'inomo gee ma 'orasuku. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Posironga wosanangioka 'o ro-riwo gu'una nako wi balusu woboa 'ena wi manarama ge'ena wadiai ma gu-gudaioka. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Tinisidemo, ma gou-goungu 'o ro-riwo gu'una dua wisijaga 'o harataa 'iodumu ge'ena. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ma nako 'o ro-riwo gu'una 'awi singina 'itorou, dua wi singina ma dodaka 'ato, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />&lt; 'Ai balusu 'o do'ingosi 'asa de wolio&gt;, so wakipesana 'o ro-riwo 'iregu gee, de yomasido'odomo de yomasido'okere de 'o nyawa yakitaba'eto. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Ge'enaka de 'awi balusu dua wolio gee ma wange de ma 'orasi kowosidongoowa. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />So 'o ro-riwo gu'una 'asa wi balusu witeto-tetorie de wi'umo yomataba'uca-'uca manga ngiika. 'Ona 'asa yo'ari de yosangisara ge'enaka doka.&gt;&gt;<verse eid="MAT 24:51" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">'O 'ade-'ade 'o mosolese yamogiooko</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, 'isi'ade-'ade 'isoka 'o mosolese yamogiooko 'o modoka yosiduono. Moi-moi manga poci yo'ese de wisibusuku womo-modoka. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ge'enaka dau yamotoa yohaga-haga, de yamotoa yoba-barija. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />'O mosolese yamotoa yohaga-haga go'ona, manga poci yo'asa, ma manga goooro yositatu-tatu koya'asawa. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />'O mosolese yamotoa yoba-barija go'ona, manga poci yo'asa de mita manga goooro yositatu-tatu yadua-duangou. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Womo-modoka gu'una 'ilati woboa so 'o mosolese go'ona yaki-ki'ooko so yoma'iduokau.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />'O utu gorona de yo'isene yosigasoko, &lt;Womo-modoka woboa! Tagi winisoboko!&gt; <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />'O mosolese yamogiooko go'ona yomomiki de yosiamoko manga poci ma lurusu. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />'O mosolese yohaga-haga gee yongose yoba-barijaka, &lt;Minikulanosi ma eta nia goooro sababu mia poci 'isongenou so!&gt; <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />'O mosolese yoba-barija go'ona yosango, &lt;Koidadiwa! Sababu dua kapomasi'adonuwa! Niotagi la nio'ija yomawuku-wukunika.&gt; <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />So 'o mosolese yohaga-haga go'ona yotagi yomadi'ija. Gee yopasaka de womo-modoka gu'una woboa. 'O mosolese yamotoa gee yomadudu-duangou go'ona yomasidowosama de womo-modoka gu'una 'o rame ma ngiika, de ma ngorana yabenokau.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Ge'enaka de 'o mosolese 'iregu go'ona yoboa de yomasigasoko, &lt; 'Abae! 'Abae! 'O ngorana minidebelengakasi!&gt; <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Ma womo-modoka gu'una wosango, &lt;Ngoi kotininakowa ngini.&gt; &gt;&gt;<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Ge'enaka de 'o Yesus wosiduanga wi 'ade-'ade ge'ena konee, &lt;&lt;Sababu ge'ena nimajaga-jaga de nimadudu-duanga, sababu konianakowa 'okia ma wange de 'o takoro muruo 'o Nyawa ma Ngowaka dua woboa.&gt;&gt;<verse eid="MAT 25:13" /></para>
  <para style="s">'O 'ade-'ade 'o ro-riwo yaruange</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk. 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt;Koge'enali mita nako ma Jo'oungu ma Dutu wopareta ge'ena 'isoka 'o 'ade-'ade ne'ena. Wimoi wotagi 'o daeraa 'ikuru-kurutika. 'Una waki'asoko wi ro-riwo wakisijaga wi harataa. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Wi ro-riwo go'ona wakisijaga moteke moi-moi manga barija. Wimoi wikula 'o pipi guraci 'o caana motoa, wimoi 'o caana modidi, de wimoi 'o caana moi, de wotagiokau. <figure style="fig" file="HK00168.pcx" size="col" ref="(25:15)">'O pipi 'o guraci ma sirasi</figure> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />'O ro-riwo gee wa'ese 'o pipi guraci 'o caana motoa, wotagi womapoti-poti so wamake 'o caana motoali. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Koge'enali mita 'o ro-riwo gee wa'ese 'o pipi guraci 'o caana modidi, 'una wamakeli 'o caana modidioli. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ma 'o ro-riwo gee wa'ese 'o pipi guraci 'o caana moi, wotagi 'o guruku wodiai so wosibaituku dau 'o tonaoka 'awi balusu ma pipi ge'ena.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Ge'enaka de 'o do'ingo 'asa de 'o ro-riwo go'ona manga balusu woboa de wokurue wakido-doimi. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />'O ro-riwo gee wa'ese 'o pipi guraci 'o caana motoa, woboa de wokula 'o caana mogiooko. Wongose, &lt; 'Aba, ngona nokula ngoino 'o caana motoa, nalega neda ngoi tamakekau 'o caana motoali.&gt; <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Manga balusu gu'una wongose, &lt; 'Isure! Ngona ge'ena 'o ro-riwo ma owa de 'idadi toningaku. De sababu ngona na'akunu 'okia sonaa ma di-dingoono, dua 'asa tonisijaga 'okia sonaa 'ila-laagomo. Nowosama la nomoteke nomasa-sanangi de de ngoi!&gt;<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Ge'enaka de 'o ro-riwo gee wa'ese 'o pipi guraci 'o caana modidi woboa de wongose, &lt; 'Aba, ngona nokula ngoino 'o pipi guraci 'o caana modidi. Nalega nee ngoi tamake ma giliono 'o caana modidioli.&gt; <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Manga balusu gu'una wongose, &lt; 'Isure! Ngona ge'ena 'o ro-riwo ma owa de 'idadi toningaku. Sababu ngona na'akunu 'o hali ma di-dingoono, so dua tonisijaga 'o hali 'ila-laagomo. Nowosamino la nomoteke nomasa-sanangi de de ngoi!&gt; <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Ge'enaka de 'o ro-riwo gee 'o pipi guraci 'o caana moi wa'ese-'ese woboa de wongose, &lt; 'Aba, ngoi tanako ngona 'o nyawa ma singina 'i'opi-'opini. Ngona konomadutudukuwa ma nomau nomadugutuku ma sowoko. Ngona konopiakoruwa ma nomau nomadunguunu. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Nedau ma ni pipi! 'Imodongo so ta'iunika tosibaituku dau 'o tonaoka.&gt; <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Ma pipi ma dutu gu'una wosango, &lt;Ngona 'o ro-riwo ma dorou de ma debeturu! Ngona nanakokau ngoi kotomadutudukuwa ma tomau tomadugutuku ma sowoko! De kotopiakoruwa ma tomau tomadunguunu! <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Nako koge'ena de salingou ma pipi ge'ena nokula yomapoti-potika la yosiputari, la gee ma 'orasi ngoi toliono de ta'ese ma pipi ge'ena de ma 'utungu.&gt; <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />So wosuloko 'awi ro-riwo 'ireguka, &lt;Nia'ese ma pipi 'unaka, de niokula gee kiaka wi pipi guraci 'o caana mogiookoka. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Sababu to nago'ona de ma 'ena, dua 'asa 'iganapu 'ifoloiosi 'ikudai, de 'ona 'asa yofoloiku. Ma to nago'ona koi'iwa, dua gee ma etakasi ma ya'eseka. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />De 'o ro-riwo gee ma faedaa koi'iwa, wini'umoka doka ma dudunika 'o darusika, ge'enaka doka dua 'una wo'ari de wosangisara.&gt; &gt;&gt;<verse eid="MAT 25:30" /></para>
  <para style="s">'O dero 'isigogere 'o dunia ma do-dogumoka</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />&lt;&lt; 'O dunia ma do-dogumoka 'o Nyawa ma Ngowaka 'asa wahakimi 'o nyawa 'iodumu. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />'O nyawa 'iodumu 'asa wakikokitoomu. Deika wosikati-tingaka wadiai 'o bolu modidioka 'isoka 'o haewani yoso-sowohi yosikati-tingaka 'o domba de 'o kabingi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />'O nyawa gee yamote-moteke ma Jo'oungu ma Dutu wi mau, yakitoomu wi giniraoka, de gee koyamote-motekuwa, wi gubalioka. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Ge'enaka de ma Koana gu'una dua wakidongose gee wi giniraoka, &lt;Nou, ngini gee 'ai Dea winisiba-barakati, niowosama wi pareta ma dodaka gee 'idudu-duangou ka ma gurue 'o duniasi 'idadi. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Sababu gee ngoi 'isawini, ngini 'o 'inomo nikula. Gee 'ai kibiti 'idudungu, ngini nikula 'o 'akere. Gee ngoi 'o nyawa ma dudunino, ngini nidawongo nia woaka. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Gee ngoi 'ai baju 'isidukuranguku, ngini nikula. Gee ngoi 'igogama, ngini nileleani; gee ngoi 'o buioka, ngini nioboa nilega.&gt;<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Ge'enaka de 'o nyawa go'ona dua yongose, &lt;Jou, kauruo ngomi minimake ngona nisawini, de ngomi 'o 'inomo minikula? Bolo ni kibiti 'idudungu de 'o 'akere minikula? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Kauruo ngomi minimake ngona 'isoka 'o nyawa ma dudunino, de minidawongo 'amia woaka? Kauruo ngomi minimake 'ani baju nisidukurangi de ngomi minikula? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Kauruo ngomi minimake ngona nigogama de nobuika, de ngomi miaika minilega?&gt; <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Ma Koana gu'una 'asa wosango, &lt;Tinisidemo ne'ena, gedagee ngini niodiai koge'ena, ngaro ka 'ai nyawaka moi gee koyopake-pakewa, ge'ena kaimatero de niodiaiokau ngoino.&gt;<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Ge'enaka de ma Koana gu'una dua 'asa wakidongose gee wi gubalioka, &lt;Nioma'aikika gee 'o gorosau niamake-make! Niowosama 'o narakaka gee 'idua-duangou ma ngale 'o Tokata ma Koana de ma mala'ekati. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Sababu gee ngoi 'isawini, ngini konikulawa 'o 'inomo, de gee ngoi 'ai kibiti 'idudungu, ngini konisi'okeruwa. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Gee ngoi 'o nyawa ma dudunino, konisidabinowa nia woaka. Gee ngoi 'ai baju 'isidukuranguku, ngini konikulawa. Gee ngoi 'igogama de 'ibuika, ngini konilegawa.&gt; <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Ge'enaka de dua 'ona yongose 'unaka, &lt;Jou, kauruo ngomi minimake ngona nisawini, bolo ni kibiti 'idudungu, bolo 'isoka 'o nyawa ma somoa. De kauruo ngomi minimake ni baju nisidukuranguku, bolo nigogama, bolo nobuika de ngomi kominiriwowa?&gt; <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Ma Koana gu'una dua 'asa wosango, wongose 'ato, &lt;Tinisidemo ne'ena: Nako ngini koniakiriwowa 'o nyawa gee kokiawa yakidae-daene, ge'ena ma ngale koniriwowa ngoi.&gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />So 'o nyawa go'ona dua yakihukumu kaisi'ado-'adonika. Ma gee yomote-moteke ma Jo'oungu ma Dutu wi mau, dua yamake 'o 'ahu kaisi'ado-'adonika.&gt;&gt;<verse eid="MAT 25:46" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">'O Yahudioka manga balu-balusu yomau 'o Yesus wito'oma</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mrk. 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />'O Yesus wosidotoko 'iduanga 'iodumu ge'ena, de wongose wi do-domoteika, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Ngini nianako 'o wange modidiosi de porame ma ngale posinganonie Wakisisupu ma Wange<note caller="o" style="f"><char style="fr" closed="false">26:2: </char><char style="ft" closed="false">Wakisisupu ma Wange ge'ena la ma 'orasi 'o Israeloka ma Jo'oungu ma Dutu wakisisupu 'o Mesiroka.</char></note> de 'o Nyawa ma Ngowaka 'asa wisisarakani la wisidele 'o salipoka.&gt;&gt;<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ma 'orasi ge'ena 'o 'imam ma sae-saeke de 'o Yahudioka manga balu-balusu yomatoomu ma 'Imam ma Amoko 'o Kayafas wi woaka. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />'Ona yomaka'aturu la kayomasiriidino 'o Yesus witagoko de wito'oma. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ma yomakadongose 'ato, &lt;&lt; 'Uwa gee 'o rame-rame ma 'orasi, sababu dua naga 'o kawasaka 'iruahe.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">'O ngeweka mimoi 'o Yesus wi saeuku 'o goooro ma bounu yaowa-owa modarisi</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mrk. 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoh. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Ma 'orasi 'o Yesus 'o Betaniaka, 'o Simon gee wipado-pado wi woaka, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ge'enaka de mimoi maino 'o Yesusino mo'asa 'o goooro ma bounu yaowa-owa de 'ihali-hali 'o botoli ma dingoonuku moi. Gedagee 'o Yesus wogogeruku wo'odomo, de 'o ngeweka gumuna 'o goooro modarisi 'o Yesus wi saeuku. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />'O do-domoteke yamake ge'ena de yakitu'uduku. Yongose, &lt;&lt; 'Ido'oa so ma halebiru ge'ena 'iodumu? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />'O goooro ge'ena nako mawukunu, ge'ena ma 'ija 'ihali, de ma pipi 'idadi mokula 'o nyawa yosusa-susaka.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />'O Yesus wanako manga singinaka ge'ena so wongose, &lt;&lt;Minimadaka! Muna modiai 'okia naga yaowa-owa ngoino. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />'O nyawa yosusa-susa ge'ena kaitaurika naga de de ngini, ma ngoi kaitaurikawa de de ngini. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />De 'o goooro ma bounu yaowa-owa moidarisi 'ai roesuku, ge'ena ma ngale moidudu-duangou 'ipo'osuku. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Tinisidemo ne'ena: 'O duniaka ne'ena gee kiaka naga bato 'o Habari ma Owa ma Jo'oungu ma Dutuno 'isitotara, 'o ngeweka numuna 'ami di-diai dua 'asa kayosija-jarita mita, de kamingano-nganono.&gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">'O Yudas wosimoteke 'o Yesus wiwukunu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mrk. 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ge'enaka de wimoi gee 'o do-domoteke yamogiooko de modidino wi ronga 'o Yudas Iskariot wotagi 'o 'imam ma sae-saekika. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />'Una wosano 'onaka, &lt;&lt; 'Okiau dua nikula nako 'o Yesus towisisarakani nginika?&gt;&gt; Ge'enaka de 'ona yokula 'unaka 'o pipi 'o saaka 'o nagi sa'ange. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Ge'enau 'ikurue 'o Yudas 'o 'orasi wononu la 'o Yesus wisisarakani.<verse eid="MAT 26:16" /></para>
  <para style="s">'O Yesus de 'awi do-domoteke yo'odomo Wakisisupu ma Wange ma 'inomo</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mrk. 14:12-21</ref>; <ref loc="LUK 22:7-14">Luk. 22:7-14</ref>, <ref loc="LUK 21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ma wange ma di-disiraka 'o Roti Koiragi-ragiwa ma Rameka<note caller="p" style="f"><char style="fr" closed="false">26:17: </char><char style="ft" closed="false">'O Yahudioka 'o Roti Koiragi-ragiwa yo'odomo 'o wange tumudiingino ge'ena ma ngale yosirame Wakisisupu ma Wange.</char></note> 'awi do-domoteke yaino 'o Yesusino yosano, &lt;&lt; 'Aba, kiakau ngona nomau ngomi miosidaoto nanga 'inomo ma ngale Wakisisupu ma Wange ma ngodomo?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />'O Yesus wosango, &lt;&lt;Niotagi doka wimoika 'o kotaka de niongose 'ato 'o 'Aba Guru wongose, &lt;Ma 'orasi ya'adonokau ma ngale ngoi. Ngoi tomau de 'ai do-domoteke mio'odomo 'ani woaka ma ngale Wakisisupu ma Wange.&gt; &gt;&gt;<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />'O Yesus wi do-domoteke yamoteke 'okia naga wongosekau gee. 'Ona yotagi yosidaoto ma rame ma 'inomo ge'ena.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />'Iobiruku de 'o Yesus de wi do-domoteke yamogiooko de modidi yogogeruku yo'odomo. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Yo'odomo ma gu-gudaioka de 'o Yesus wongose, &lt;&lt; 'Ena nio'isenika, ne'ena nginioka naga wimoi dua woiwukunu!&gt;&gt;<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />'O do-domoteke yo'isene ge'ena, de manga singina 'isusa ma sala. Ge'enaka de moi-moi yomadasano 'o Yesusika, &lt;&lt;Ma raiokau ko ngoiwa 'Aba?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />'Una wosango, &lt;&lt;Gee 'awi roti wositubuku 'o sawokuku de de ngoi, gu'unau dua woisisarakani. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ma goungu 'o Nyawa ma Ngowaka dua wosongene 'isoka 'isidemokau 'o Buku 'Itebi-tebinoka, duga wotorouoka 'o nyawa gu'una gee wisisa-sarakani 'o Nyawa ma Ngowaka. 'Ifoloi yaowa nako 'o nyawa gu'una koma'iwa woboano 'o duniaka.&gt;&gt;<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Ge'enaka de 'o Yudas gee 'o Yesus wiwuku-wukunu wongose, &lt;&lt;Ma rai ko ngoinowa gee, 'Aba Guru, 'ani dumutu?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Ge'enaka de 'o Yesus wosango, &lt;&lt;Ka to ngona ni demo ge'ena!&gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Ma Jou wi Ngodomo 'Itebi-tebini</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mrk. 14:22-26</ref>; <ref loc="LUK 22:14-20">Luk. 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Gedagee yo'odomo, de 'o Yesus wa'ese 'o roti de wo'amalaha ma Jo'oungu ma Dutude, deika waeta-eta so wakikula wi do-domoteika de wongose, &lt;&lt;Nia'ese de nia'odomo; ne'ena to ngoi 'ai roese.&gt;&gt;<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Ge'ena 'iduanga de wa'ese 'o 'anggur 'o sawoko moi, de wo'amalaha ma Jo'oungu ma Dutude. Ge'enaka de wokula 'awi do-domoteika de wongose, &lt;&lt;Nioodumu nia'okere 'o sawokoka ne'ena. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Ne'ena ge'ena 'ai 'aunu gee 'ipoa ma ngale 'o nyawa 'iodumu, la manga so-sowono ma Jo'oungu ma Dutu kowosi-singinawau. Ma Jo'oungu ma Dutu 'awi jaji wositiai de ne'ena. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Tinisidemo ne'ena: Ngoi dua kota'okeruawau 'o 'anggur kone'ena, sigado ma 'orasi ngoi ta'okere 'o 'anggur ma sungi de de ngini 'ai Dea wi dunia ma sungioka.&gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Ge'enaka de 'ona yosinyanyi 'o nyanyi moi ma Jo'oungu ma Dutu wisiarene. Ge'ena 'iduanga deika yotagi 'o Zaitun ma gigieka.<verse eid="MAT 26:30" /></para>
  <para style="s">'O Petrus dua womasipongono</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mrk. 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Ge'enaka de 'o Yesus wongose 'awi do-domoteika, &lt;&lt;Ne'ena ma eta 'iobiruku ngini nioodumu dua 'ania ngo-ngaku 'igiwioka ngano 'okia naga gee 'idadi ngoino. Sababu 'o Buku 'Itebi-tebinoka 'isilefoku konee: &lt;Ngoi dua towito'oma 'o so-sowohi gu'una de ma domba 'asa 'ikokiowara 'imakati-tingaoka.&gt; <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ma gee dua tomomikieli, de ngini koniotagiwasi 'o Galileaka 'ena ngoi tomatisirakau ge'enaka doka.&gt;&gt;<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />De 'o Petrus wongose 'o Yesusika, &lt;&lt;Ngaro 'iregu-regu 'ona yoodumu nimada, ma ngoi ma gou-goungu ko'uwa.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />'O Yesus wongose 'o Petrusika, &lt;&lt;Ma gou-goungu 'o obiri ne'ena 'o namoro koisorenuawasi, ngona nomasipongono ngoino ma sa'angeu.&gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />'O Petrus wongose, &lt;&lt;Ngaro tosongene de de ngona, ma dua kotomasipongonuwa.&gt;&gt;</para>
  <para style="p" vid="MAT 26:35">De 'o do-domoteke 'iregu mita koge'ena yongose.<verse eid="MAT 26:35" /></para>
  <para style="s">'O Yesus wolahidoa 'o Getsemanioka</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mrk. 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Ge'ena 'ipasa de 'o Yesus de wi do-domoteke yotagi 'o ngii moika ma ronga 'o Getsemani. Kadoka yaika de 'o Yesus wongose wi do-domoteika, &lt;&lt;Niogogerukosi ne'enaka, ngoi totagi tolahidoasi.&gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Ge'enaka de wakisigaro 'o Petrus de 'o Zebedeus wi ngowa-ngowaka yamididi wimoteke. 'Una wamao wi singina 'isusa de wobalisa. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />'Una wosidemo 'onaka, &lt;&lt;Tamao tobalisa ma sala matero tosongenoka. Ngini ne'enakasi de niomajaga-jaga de de ngoi.&gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Ge'enaka de 'o Yesus wotagi ma etasi 'ikurutika de wotalibukuku wolahidoa wongose, &lt;&lt; 'Aba, nako yaowa de noisikurutu 'o sangisara gee salingou tamoku, ma 'uwa ka to ngoi 'ai mau 'idadi, la 'ena ka to ngona, 'Aba.&gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Ge'enaka de 'o Yesus wolio 'awi do-domoteika gee yaruangeka, 'ena 'ona yonisuoka. 'Una wongose 'o Petrusika, &lt;&lt;Ka 'o takoro moi ma koidadiwa nimajaga-jaga de de ngoi? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Nimajaga-jaga de nimalahidoa la 'uwa nitaili. Ma goungu ngini nia singinaka niomau niadiai ma owa, ma ngini niolamahani.&gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Ma moioli 'o Yesus wotagi wolahidoa wongose, &lt;&lt; 'Aba, nako 'o sangisara 'o sawooka ne'ena salingou tamoku de koidadiwa 'isiresene, madakau la moteke to ngona 'ani mau.&gt;&gt; <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Ge'ena 'ipasa de 'o Yesus wolioli 'ena wakidaenino wi do-domoteke kayoma'iduokasi sababu kaifoloi manga ako 'itubuso.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Ma moioli 'o Yesus wakimadaku de wotagi wolahidoali wosigali ma sa'angeu, ma betongo ka koge'ena. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Ge'ena 'iduanga de wolioli wi do-domotekino de wongose, &lt;&lt;Kanionisukosi? De kaniomaomasosi? Niamake ma 'orasi ya'adonokau 'o Nyawa ma Ngowaka wisisarakani 'o nyawa yosowo-sowono manga giama ma soatika. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Niomomikieu! Potagiou! Woiwuku-wukunu gu'una woboau.&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">'O Yesus witagoko</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mrk. 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />'O Yesus kawobicarasi, de 'o Yudas gee 'o do-domoteke wimoi yamogiooko de modidino, woboa de 'o nyawa yoku-kudai 'o samarangi de 'o palo-palo yo'asa. 'Ona 'o 'imam ma sae-saeke de 'o Yahudioka manga balu-balusu yakisuloko. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />'O nyawa gee 'o Yesus wisisa-sarakani<note caller="q" style="f"><char style="fr" closed="false">26:48: </char><char style="ft" closed="false">'O nyawa gee 'o Yesus wisisa-sarakani ge'ena la 'o Yudas.</char></note> wakidongosekau ma no-nako konee, &lt;&lt; 'O nyawa gee towiame, ge'ena gu'unau so winitagoko!&gt;&gt;<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Gee ya'adonika ge'enaka de 'o Yudas kawogila-gila waika 'o Yesusika de wongose, &lt;&lt;Tabea, 'Aba Guru!&gt;&gt; Deika wiame.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />'O Yesus wongose, &lt;&lt;Ee 'Esa moi! 'Okia nodo'oa ne'enano?&gt;&gt;<note caller="r" style="f"><char style="fr" closed="false">26:50: </char><char style="ft" closed="false">Ma ngale: &lt;&lt; 'Itaitika nadiai 'okia naga gee nomau nadiai.&gt;&gt;</char></note></para>
  <para style="p" vid="MAT 26:50">Ge'enaka de yoku-kudai go'ona wida-dagi witagoko. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />'O do-domoteke wimoi wi samarangi wagoraka de wi'oto 'o 'Imam ma Amoko wi ro-riwoka so wi ngauku ma 'itoaoka. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Ge'enaka de 'o Yesus wongose wi do-domoteika gu'una, &lt;&lt; 'Ani samarangi nosigilioku ma sarumuku, sababu nago'ona 'o wase yosisasaru, 'asa yosisongene de 'o wase. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Bolo ngona nongose ngoi koidadiwa tomaga'asoko 'ai Dea woiriwo? Nako toga'asoko ge'ena 'una 'asa kawataitino wosidingoto 'o mala'ekati 'o solodado gee 'o bolu mogiooko de modidi 'ifoloi! <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ma nako koge'ena, kokia la 'idadi moteke ma Jo'oungu ma Dutu 'awi demo? Sababu 'o Buku 'Itebi-tebinoka 'isidemokau salingou 'idadi 'isoka gee ma 'orasi ne'ena.&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ge'enaka de 'o Yesus wongose yoku-kudaika gee, &lt;&lt;Ngoi ne'ena to'ora-'ora? so 'o samarangi de 'o palo-palo nidagasa la nitagoko? 'O wange 'isinoi-noimi ngoi todotoko ma Jo'oungu ma Dutu wi Woaka, ma konitagokuwa! <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ma ngano salingou koge'enau la 'idadi 'isoka 'o nabii yosilefokau 'o Buku 'Itebi-tebinoka!&gt;&gt;</para>
  <para style="p" vid="MAT 26:56">Ge'enaka de wi do-domoteke yoodumu yoowara wisidamadaku.<verse eid="MAT 26:56" /></para>
  <para style="s">'O Yesus 'o 'Agamaka ma Hakimi manga bionoka</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mrk. 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk. 22:54-55</ref>, <ref loc="LUK 22:63-71">22:63-71</ref>; <ref loc="JHN 18:13-14">Yoh. 18:13-14</ref>, 19-24)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />'O Yesus witagokino de wi'otaka 'o Kayafasika ma 'Imam ma Amoko gu'una. Ge'enaka doka 'o Yahudioka manga 'agamaka yodoto-dotoko de 'o Yahudioka ma balu-balusu yomalomunou. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />'O Petrus doka 'o gurutika 'o Yesus wisidu-du'uru sigado ma 'Imam ma Amoko wi ginitaroka waino. Ge'enaka de wowosama ma dodaka so wogogerie de yojaga-jaga gee, ma ngale womau wanako 'iodumu ge'ena dua kokia ma do-dogumuku. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />'O 'Agamaka ma Hakimi 'ona ge'ena la 'o 'imam ma sae-saeke de 'o 'agama ma balu-balusu yoodumu yosikanonu yomau yodamake 'o sakisii ma ngeluku, la 'o Yesus wihukumu wiso-songene. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Ma ngaro manga gudai yosidemo manga sakisii, ma ka ma eta ma koyodamakewa 'awi sowono. Sababu ge'ena yamididi yoma'okode ma bionoka, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />de yongose, &lt;&lt; 'O nyawa nu'una wongose, &lt;Ngoi 'idadi taruba ma Jo'oungu ma Dutu wi Woa, de ka 'o wange sa'ange ma dodaka de tosigokoli.&gt; &gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Ge'enaka de ma 'Imam ma Amoko woma'oko de wongose 'o Yesusika, &lt;&lt;Nooluku nasango manga galaki ge'ena?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Ma 'o Yesus kaworii-riidika. Ge'enaka de ma 'Imam ma Amoko wongoseli 'o Yesusika, &lt;&lt;De ma Jo'oungu ma Dutu wowango-wango, nosidemo ngomino ngona ne'ena ma Koana Wiiri-iriki ma Jo'oungu ma Dutu wosijajiokau gu'una? Ma Jo'oungu ma Dutu wi Ngowaka?&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />'O Yesus wosango, &lt;&lt; 'Isoka to ngona ni demo! Duga tinidongose, dua 'asa winimake 'o Nyawa ma Ngowaka wopareta de ma Jo'oungu ma Dutu gee 'awi kuasa 'ifoloi 'iamoko de woboa daku 'o kakamoroka 'o diwangino!&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Ge'enaka de ma 'Imam ma Amoko 'awi baju waracanga de wongose, &lt;&lt; 'Una ma Jo'oungu ma Dutu wisiti-tingoono! Ngaro ma sakisii koi'iwau sababu ngini ma sirete nio'isenokau 'awi demo-demo gee ma Jo'oungu ma Dutu wisiti-tingoono.<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />Kokia ne'ena moteke ngini?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">'Ona yosango, &lt;&lt; 'Una salingou wihukumu wiso-songene.&gt;&gt;<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Ge'enaka de wi bionoko yakibiti de wipesana, de munuka wipoka, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />de kayongosekau, &lt;&lt;Ngona ma Jo'oungu ma Dutu wi Ngiriki. Bika nopasi nago'ona nipesana?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">'O Petrus womadidumu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mrk. 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh. 18:15-18</ref>, <ref loc="JHN 18:25-27">18:25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ma 'orasi ge'ena 'o Petrus doka ma dudunoka 'o ginitaroka wogogerie, de 'o ro-riwo mimoi moboa de mongose, &lt;&lt;Ngona mita nomote-moteke de 'o Yesus 'o Galileano?&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Ma 'o Petrus womadidumu ge'ena 'o nyawa ma gu-gudai manga bionoka wongose, &lt;&lt;Ngoi kotasahewa 'okia ni dumutu.&gt;&gt; <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Ge'enaka de womato'oraka 'o ginitara ma ngoranika. 'O ro-riwo mimoioli mimake 'o Petrus de mongose 'o nyawa-nyawaka ge'enaka dau gee, &lt;&lt; 'O nyawa nu'una mita kangano womote-moteke de 'o Yesus 'o Nazaretino.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Ge'enaka de 'o Petrus womasipongonoli de wosasi, &lt;&lt;Ma gou-goungu ngoi kotowinakowa 'una.&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Koito'ingowa de yoma'oko-'okode ge'enaka yaika 'o Petrusika de yongose, &lt;&lt;Ma raiokau ngona mita de de 'ona. Ma nyo-nyata ni bicaraka gee.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Ge'enaka de 'o Petrus womasibo-bobeto de wongose, &lt;&lt;Ma gou-goungu ngoi kotowinakowa 'o nyawa gu'una!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Ma 'orasi ge'ena mita 'o namoro 'isorene. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />De 'o Petrus wonganonino 'o Yesus wongosekau, &lt;&lt; 'O namoro koisorenuawasi 'ena ngona nomasipongono ma sa'angeu.&gt;&gt; Ge'enaka de 'o Petrus wosupu ge'ena ma 'Imam ma Amoko wi ginitaroka 'ena wo'ari kawidomo-domo.<verse eid="MAT 26:75" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">'O Yesus 'o Pilatusika wisisarakani</para>
  <para style="r">(<ref loc="MRK 15:1">Mrk. 15:1</ref>; <ref loc="LUK 23:1-2">Luk. 23:1-2</ref>; <ref loc="JHN 18:28-32">Yoh. 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Kayaika 'ikinitara de 'o 'imam ma saeke yoodumu de 'o Yahudioka manga balu-balusu yomatoomu 'o butusangi yodiai ma ngale 'o Yesus wito'oma. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />'Ona wipusuku de wi'asa wisisarakani 'o Pilatusika 'o Romaka manga sangaji.<verse eid="MAT 27:2" /></para>
  <para style="s">'O Yudas wosongene</para>
  <para style="r">(<ref loc="ACT 1:18-19">Sulo. 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />'O Yudas gee 'o Yesus wisisa-sarakani wolega-lega 'ena 'o hukumani 'iotaokau 'o Yesusuku, de womatoduba so 'o pipi 'o saaka 'o nagi sa'ange wosigilio 'o 'imam ma sae-saekika de 'o Yahudioka manga balu-balusika. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />'Una wongose, &lt;&lt;Ngoi tosowonokau. Ngoi towiwukunu 'una gee wi sala koi'iwa, sigado wihukumu wiso-songene!&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Ma 'ona yongose, &lt;&lt;Ngomi komianakowa ge'ena! Ge'ena to ngona ni 'urusangi.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Ma pipi ge'ena 'o Yudas wa'umo ma Jou wi Woa ma dodaku, de wotagiokau womasidele.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />'O pipi ge'ena 'o 'imam ma saeke yatoomu de yongose, &lt;&lt; 'O pipi ne'ena 'o 'aunu ma pipi. Moteke 'o 'agama ma 'atorangi, 'o pipi ne'ena koidadiwa 'isingosama 'o sadakaa ma ngiiku ma Jou wi Woaka.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Ge'enaka de yomaka'aturokasi 'asa de ma pipi ge'ena 'o tonaka yosi'ija, gee yosironga 'o Boso yodi-diai manga Tonaka. 'O tonaka ge'ena yadiai 'o nyawa ma dudunino yakido-dobo'osuku. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ge'enau so 'o tonaka ge'ena sigado ne'ena yosironga, &lt;&lt; 'O 'Aunu ma Tonaka.&gt;&gt;<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />De ge'enau, 'idadiokau 'isoka 'okia naga Nabii Yeremia wosidemokau 'ato: &lt;&lt; 'Ona ya'ese 'o pipi 'o saaka 'o nagi sa'ange, ge'ena 'o Israeloka yomodekokau yofangu to 'una wi 'ija. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />De ma pipi ge'ena yosi'ija 'o boso yodi-diai manga tonaka, 'isoka gee ma Jo'oungu ma Dutu wosulokokau ngoino.&gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">'O Yesus 'o Pilatus wi bionoka</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mrk. 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk. 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoh. 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Ge'enaka de 'o Yesus wotaari 'o Pilatusika, ma gubernur ge'ena ma daeraaka gee, de 'o Pilatus wosano, &lt;&lt;Ngona ne'ena 'o Yahudioka manga Koana?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">'O Yesus wosango, &lt;&lt;Ia, 'isoka to ngona 'ani demo.&gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Ma gedagee 'o 'imam ma sae-saeke de 'o Yahudioka manga balu-balusu wikalaki 'ikudai, de 'una kowosangowau.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Sababu ge'ena 'o Pilatus wongose, &lt;&lt;Kono'isenuwa nikalaki ge'ena ma gudai?&gt;&gt;<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Ma 'o Yesus kowosangowa ka ma eta ma, so ma gubernur gu'una woherangi ma sala.<verse eid="MAT 27:14" /></para>
  <para style="s">'O Yesus 'o hukumani widubutusu ma ngale wiso-songene</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mrk. 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk. 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yoh. 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />'O taunu 'isinoi-noimi gee Wakisisupu ma Wange ma rame yodiai, ma gubernur 'o Pilatus biasa wosisupu 'o bui ma nyawa moi moteke 'o kawasa yoiriki. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ma 'orasi ge'ena wobui-buika wimoi gee wikokinako-nakokau sababu 'o dorou wodi-diai, 'awi ronga 'o Yesus Barabas. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Gedagee 'o kawasa yomakokitoomuno de 'o Pilatus kawongosekau, &lt;&lt;Ngini niomau nagu'una towisisupu nginika? 'O Yesus Barabas bolo 'o Yesus gee wisironga ma Kristus?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />'O Pilatus wongose koge'ena sababu 'una wanako 'ona wisisarakani ma ngale witaleana.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Ma 'orasi 'o Pilatus wogogeruku wosi'adi-'adili ma ngiioka, de ma wekata mobesesongo konee, &lt;&lt;Tanu 'uwa wonido'oanikia 'o nyawa gee wi sala koi'iwa. Sababu ma ngale 'una ngoi 'ai naneroka 'imodongo ma sala kangano ne'ena.&gt;&gt; <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Ma 'o 'imam ma sae-saeke de 'o Yahudioka manga balu-balusu koyomaogoruwa yosisau-sauku 'o kawasaka go'ona la yoga'asoko 'o Pilatusika 'ato 'o Barabas wisisupu de 'o Yesus wihukumu wiso-songene. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Ge'enaka de ma sangaji gu'una wosanoli 'onaka, &lt;&lt; 'O nyawa yamididi no'ona, ka 'una towisisupu nginika?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">'Ona yosango, &lt;&lt; 'O Barabas.&gt;&gt;<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />'O Pilatus wongose 'onaka, &lt;&lt;Nako koge'ena, kokia todiai 'o Yesusika gee wisironga ma Kristus?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">'Ona yoodumu yosango, &lt;&lt;Powisidele 'o salipoka!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />'O Pilatus wosano, &lt;&lt;Ma ka'ena wadiai gee 'ito-torou?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Ge'enaka de 'ona yosigasoko 'ifoloiosi 'iamokie, &lt;&lt;Powisidele 'o salipoka!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />'O Pilatus wamaoku kowomado-do'oawau, de yoku-kudai go'ona wiridutukou, so 'o 'akere wa'ese de yoku-kudai manga bionoka de wi giama wa'isoko de wongose, &lt;&lt;Ngoi kotomadomokuwa 'o nyawa nu'una wi songene. Ge'ena ngini nimadomoku.&gt;&gt;<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Yoku-kudai go'ona yoodumu yosango, &lt;&lt;Ia, ngaro ngomi de mia ngowa-ngowaka 'asa miamoku wi songene ma hukumani ge'ena!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Ge'enaka de 'o Pilatus 'o Barabas wisisupu 'onaka, de wosuloko 'o Yesus wipa'asana de wisisarakani 'onaka la wisidele 'o salipoka.<verse eid="MAT 27:26" /></para>
  <para style="s">'O solodado 'o Yesus wisisasaru</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mrk. 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoh. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Ge'enaka de 'o Pilatus wi solodado 'o Yesus wi'asa ma gubernur wi gogerika, de 'o solodado yoodumu yomatoomu wisigilolitino. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />'Ona yaawene 'o Yesus wi baju so yositagali 'o baju gee ya'ungu-'ungu. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />'Ona yodiai 'o tuala ngai moi 'o da'ara 'ido-dodowoko, de yosinoa 'o Yesus wi saeuku. Ge'enaka de 'o papadi ngai moi wi giama ma ginirakoka yokulaka de wi bionoka yobukuku de wisisasaru yongose, &lt;&lt;Suba Jou, 'o Yahudioka manga Koana!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />'Ona wikibiti de 'o papadi ge'ena ya'ese so yosipesana wi mumuuku. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Gedagee wisisasaru 'iduanga, de 'o baju ge'ena yaawene so wisinoali gee to 'una. Ge'enaka de 'una wi'asa 'o kota ma dudunika ma ngale wisidele 'o salipoka.<verse eid="MAT 27:31" /></para>
  <para style="s">'O Yesus wisidele</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mrk. 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />'O ngekomo ma goronaka, de yomakamake de 'o Kirene ma nyawa wimoi wi ronga 'o Simon. 'O solodado go'ona wigegoto wamoku 'o Yesus wi salip. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Gee ya'adono 'o ngii moi ma ronga 'o Golgota, ma ngale, &lt;&lt; 'O Saeke ma Kobongo ma Ngii.&gt;&gt; <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ge'enaka dau de 'o Yesus wisi'okere 'o 'anggur gee 'o haewani ma miringi yosiganuku. Ma 'o 'anggur ge'ena watailoka de waolukou.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Ge'enaka de 'o solodado go'ona wisidele 'o salipoka, de wi baju yomasibula-bula yodu'undi. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ge'ena 'ipasa de 'ona yogogerieu ge'enaka wilega-lega. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />'Awi saeke ma dekude 'isilefoka kokia naga 'una wikalaki gee, ge'ena la, &lt;&lt;Nu'una 'o Yesus, 'o Yahudioka manga Koana.&gt;&gt; <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Yamididi 'o dorou yodi-diai mita yakisidisidele 'o salipoka de 'o Yesus, wimoi wi giniraoka, de wimoi wi gubalioka.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />'O nyawa gee yotoaka ge'enano kayomagiwi-giwi wisiti-tingoono 'o Yesus. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Yongose 'ato, &lt;&lt;Ngonau ne'ena nomau ma Jou wi Woa natotaka de nosigokoli ka 'o wange sa'ange ma dodaka! Nako ngona ma gou-goungu ma Jo'oungu ma Dutu wi Ngowaka, bika no'uti 'o salipoka de ngona ma sirete nomasilaha!&gt;&gt;<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Koge'enali mita 'o 'imam ma sae-saeke de 'o Yahudioka manga 'agamaka yodoto-dotoko, de mita 'o Yahudioka manga balu-balusu, 'o Yesus wisiti-tingoono. 'Ona yongose, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />&lt;&lt; 'O nyawa 'iregu wakisilaha, 'ena momongo 'una ma sirete koidadiwa womasilaha! Nako 'una 'o Israeloka manga Koana de yaowa ma 'orasi ne'ena wo'uti 'o salipioka, 'asa de ngomi miongaku 'unaka. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />'Una wongaku ma Jo'oungu ma Dutuka. So bika dua wisilahaka. Sababu 'una wongose 'ato 'una ge'ena ma Jo'oungu ma Dutu wi Ngowaka.&gt;&gt;<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Yo'ora-'ora gee yakisidi-disidele de 'o Yesus, 'ona mita koge'enali yositi-tingoono 'o Yesusika.<verse eid="MAT 27:44" /></para>
  <para style="s">'O Yesus wosongene</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mrk. 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />'O wange 'ikoronako, de ma daeraa ge'ena 'itarusu ka ma moiku ma do'ingo 'o takoro sa'ange. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />'O takoro sa'ange de 'o Yesus wopoaka womasigasoko ma Deaka, &lt;&lt; 'Eli, 'Eli, lama sabatani!&gt;&gt; ma ngale, &lt;&lt;Jo'oungu ma Dutu, Jo'oungu ma Dutu, 'ido'oa so noimadaka?&gt;&gt;<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Yamuruo naga ge'enaka gee yo'isene wi 'ilingi de kayongosekau, &lt;&lt;Ee! 'O Elia wi'asoko!&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Wimoi ge'enaka dau wosijai-jai 'o spons wa'ese de wositubuku 'o daluku 'icuka-cukaku, ge'enaka de 'o gotaka wosisagatuku de widotobe 'o Yesus wi 'uru ma kaide la bari wa'okere.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Ma munuka yongose, &lt;&lt; 'Uwasi! Nou, polega-lega bika dua 'o Elia woboa wisilaha!&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Ge'enaka de 'o Yesus womapoakoli waamo-amokie de wi ngomasa 'ipidili.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Ge'enaka de ma Jo'oungu ma Dutu ma sirete 'awi Ngii<note caller="s" style="f"><char style="fr" closed="false">27:51: </char><char style="ft" closed="false">Ma Jo'oungu ma Dutu ma sirete wi Ngii ma ngale 'o Ngii moi 'Itebi-tebini 'awi Woaka 'o Yerusalemuoka.</char></note> ma da-datoko 'iside-sideluku ma 'iracanga 'itaga modidioka kadaku de 'isikauku, de 'o 'osu de 'o gigie 'iteto-teto 'ikapelaka. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />'O bo'osuku 'ikokipelenga, de manga gudai ma Jo'oungu ma Dutu wi kawasa yosonge-songenokau wakisimomiki, de yamada manga bo'osuku. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Gedagee 'o Yesus womomioka de yowosanga 'o Yerusalemuka so manga gudai yakimake.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />'O solodado ma balusu de ma solodado gee 'o Yesus wijaga-jagano yosawanoka gee yamake 'o 'osu de 'okia naga gee 'ikokidadi. 'Ona yongose, &lt;&lt;Ma gou-goungu nu'una ge'ena ma Jo'oungu ma Dutu wi Ngowaka.&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Ge'enaka mita manga gudai 'o nge-ngeweka yolega-lega 'o gurutika. 'Ona ge'ena gee 'o Yesus wimote-moteke de wiriwo-riwo ka 'o Galileakasi de 'isikaino. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ge'ena la ngo Maria Magdalena<note caller="t" style="f"><char style="fr" closed="false">27:56: </char><char style="ft" closed="false">Ngo Maria Magdalena ge'ena 'ami 'asali 'o Magdalano.</char></note> de ngo Maria 'o Yakobus de 'o Yusuf manga 'esa, de mita 'o Zebedeus wi ngowa-ngowaka manga 'esa.<verse eid="MAT 27:56" /></para>
  <para style="s">'O Yesus wipo'osuku</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mrk. 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />'Iobirou de 'o Arimateano wokaya-kaya wimoi waino wi ronga 'o Yusuf. 'Una mita 'o Yesus wimote-moteke. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />'Una wotagi 'o Pilatusika, woga'asoko 'o Yesus 'awi songene. Ge'enaka de 'o Pilatus wosuloko 'o Yesus 'awi songene yosiguti la yokula 'o Yusufika. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Ge'enaka de 'o Yusuf wa'ese 'o maieti ge'ena de wosisao de 'o mosa 'i'are-'arese de 'i'alu-'alusu de 'itebi-tebini. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Ge'enaka de 'o maieti ge'ena wapo'osuku to 'una ma sirete wi bo'osuku ma sungika, gee wa'aruika 'o teto ma dodaka. Ge'enaka de 'o teto 'iamo-amoko moi wodololoika de wotagiokau. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />'Ena ngo Maria Magdalenano de ngo Maria 'iregu, ge'enaka yogogerie ma bo'osuku yodaarika.<verse eid="MAT 27:61" /></para>
  <para style="s">'O bo'osuoka yojaga-jaga</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ma bibinoka 'o Yahudioka Pomaoma-omasa ma Wangeka, 'o 'imam ma sae-saeke de 'o Farisioka yotagi 'o Pilatusika, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />de yongose, &lt;&lt;Jou, ngomi kamiongano-nganonosi gee wotabaeluku kawowango-wangosi, 'una wongosekau, &lt;Dua 'o wange sa'angeka 'asa ngoi tomomiki 'o songenoka.&gt; <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Sababu ge'ena nosuloko la 'o bo'osuku ge'ena yojaga yosidi-diai sigado 'o wange sa'ange, la 'uwa sigado 'awi do-domoteke yatosiki 'awi maieti ge'ena de yongose 'o nyawa-nyawaka 'ato, &lt; 'Una womomiokau 'o songenino.&gt; De manga ngeluku ma du-du'uruoka ne'ena dua 'ifoloiosi 'itorou de gee ma si-siraka.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />'O Pilatus wongose, &lt;&lt;To ngini nia jo-jaga de ma 'ena so tagi niakisuloko la yojaga yosidi-diai!&gt;&gt;<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Ge'enaka de 'ona yotagi 'o bo'osuika de yano-nakokau 'o tetoka gee ma bo'osuku ma da-datoko ge'ena de yojaganou.<verse eid="MAT 27:66" /></para>
  <para style="rem">Ilustrasi+Foonote: Ning 25-6-'08 Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">'O Yesus womomiki</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mrk. 16:1-10</ref>; <ref loc="LUK 24:1-12">Luk. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />'O Yahudioka Pomaoma-omasa ma Wange 'ipasa, 'o 'Ahadi ma Wange kaitaru-tarusikasi, ngo Maria Magdalena de ngo Maria mimoioli yotagi yalega 'o bo'osuku ge'ena. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />De kayasorogano 'o 'osu ma kiamati sababu ma Jo'oungu ma Dutu 'awi mala'ekati 'i'uti 'o sorogaaku yaloloko 'o teto gee ma bo'osuku ma da-datoko ge'ena, de 'igogerieu ma dekuoka. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />'O mala'ekati ge'ena ma biono 'isoka 'o tawi-tawi de ma baju ma garese 'isoka 'o kapa. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />'O solodado gee yojaga-jaga ge'enaka, yakimodongo kayoti-tirine sigado yotitooka.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />'O mala'ekati ge'ena 'ingose 'o nge-ngewekaka, &lt;&lt; 'Uwa nimodongo! Ngoi tanako ngini wininonu 'o Yesus gee wisidelokau 'o salipoka. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />'Una kowi'iwau ne'enaka. 'Una womomiokau 'isoka ma sira wosidemokau. Nou, nialega 'awi ngiioka gee winoa-noaku. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ne'ena, niotagiou nimatai-taiti niosidemo wi do-domoteika, &lt; 'Una womomiokau yosonge-songene manga sigoronaka, de ne'ena womatisirakau doka 'o Galileaka, ge'enaka doka 'asa dua winimake!&gt; Niongano-nganono 'okia naga gee tinisidemokau.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />'O nge-ngeweka go'ona ka manga japatioka yamada ma bo'osuku ge'ena. Yakimodongo ma yomorene ma sala kayoowa-owara yosidemo ma hali ge'ena 'o Yesus wi do-domoteika.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Koito'ingowa 'ena 'o Yesus woboanou 'o nge-ngewekaka de wongose, &lt;&lt;Tabea!&gt;&gt; Ge'enaka de yomasisori 'unaka de yomasigao wi douno de wisuba. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />'O Yesus wongose, &lt;&lt; 'Uwa nimodongo. Niotagi niosidemo 'ai 'esa moika la yotagi 'o Galileaka. Ge'enaka doka 'asa de 'ona 'imake.&gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">'O solodado gee yojaga-jaga manga demo</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Gedagee 'o nge-ngeweka go'ona yotagi de 'o solodado yamuruo naga gee 'o bo'osuku yojaga-jaga yolio 'o kotaka, de yosidemo 'o 'imam ma sae-saekika 'okia naga gee 'idadiokau. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />'O 'imam ma sae-saeke yomaka'aturu de 'o Yahudioka manga balu-balusu, ge'enaka de 'o pipi ma amoko yokula 'o solodado gee 'o bo'osuku yojaga-jagaka. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />De yongose, &lt;&lt;Ngini salingou niongose 'ato, 'iobiruku nima'iduoka de wi do-domoteke yaino yatosioka 'o maieti ge'ena. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />De nako ma gubernur wo'isene ma hali ge'ena, ngomi 'asa mibaja la konido'oawa.&gt;&gt;<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />So 'o solodado gee yojaga-jaga go'ona 'o pipi ya'ese de yodiai 'isoka yakisibe-besesongokau gee. Sababu ge'ena 'o jarita ge'ena kaitagiosi 'o Yahudioka sigado ne'ena.<verse eid="MAT 28:15" /></para>
  <para style="s">'O Yesus wakisuloko 'o habari ma owa yosidagi</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mrk. 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh. 20:19-23</ref>; <ref loc="ACT 1:6-8">Sulo. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />'O do-domoteke yamogiooko de moi yotagi 'o gigie moika 'o Galileaka 'isoka kokia naga gee 'o Yesus wosulokokau. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Gedagee 'ona wimake 'o Yesus ge'enaka doka, de wisuba. Ma 'onaka naga de ma 'ena koyongakuwasi rekeni. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />'O Yesus womasisori 'onaka de wongose, &lt;&lt; 'O sorogaaka de 'o duniaka ma kuasa 'iodumu 'isidukulakau ngoino. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Sababu ge'ena niotagi 'o sagala nyawaka 'o dunia niakiloliti, niakidotoko la yodadi to ngoi 'ai do-domoteke. Niaki'osiki de 'o 'Aba wi ronga, wi Ngowaka, de 'o Ngomasa 'Itebi-tebini. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Niakidotoko yamoteke 'okia naga gee tinisidemokau. De niongano-nganono, ngoi dua naga de de ngini sigado 'o dunia ma do-dogumika.&gt;&gt;<verse eid="MAT 28:20" /></para>
  <para style="rem">Penyuntingan: Ning 10-7-2008 Edit Koreksi Penterjemah: Ning 24-7-2008</para>
  <chapter eid="MAT 28" />
</usx>