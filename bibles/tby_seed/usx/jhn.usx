<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">TOBJHN NT TOBARU JHN CHP. 01 YOSIAS, INDONESIA</book>
  <para style="h">'O YOHANES</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc3">Yoh.</para>
  <para style="toc2">'O Yohanes</para>
  <para style="toc1">'O Habari ma Owa gee 'o Yohanes Wositotara</para>
  <para style="mt1">'O HABARI MA OWA GEE</para>
  <para style="mt1">'O YOHANES WOSITOTARA</para>
  <para style="imt">'O Habari ma Owa gee 'o Yohanes Wositota-totara ma Dumutu</para>
  <para style="ip">Moteke 'o nyawa yongaku-ngaku ma sirasi, yongose 'ato 'o buku ne'ena 'o Yohanes wolefo. 'Una ge'ena 'o Zebedeus 'awi ngowaka gee yomagiamanai ma sala de 'o Yesus. De 'o Yohanes 'una ge'ena 'o Yesus 'awi do-domoteke gee yamogiooko de modidioka wimoi. 'Unau mita wamake-make 'okia sonaa moi-moi 'o Yesus wadi-diai, 'isoka kokia naga gee walefo-lefoku ma bukuoka ne'ena. Moteke 'o nyawa yoba-barija, 'o Habari ma Owa ma buku gee ma du-du'uruokau 'isupu ge'ena la gee 'o Yohanes wositota-totara. 'O Yohanes wolefo ma buku ne'ena poilia ma taunu 85-95 'o Yesus wosupuoka 'o duniano. De ma buku ne'ena 'o Yohanes wolefo 'o Efesus ma kotaka.</para>
  <para style="ip">'O Habari ma Owa gee <char style="bk">'o Yohanes</char> wositota-totara ma dodaka ne'ena, 'isidemo 'ato 'o Yesus 'una ge'ena ma Jo'oungu ma Dutu 'awi demo 'ika-kakali gee 'imadadiokau 'o nyawa de womanoa naga ngoneka. 'Isoka 'isidemokau ma buku ne'ena ma dodaka, 'o Habari ma Owa 'ilefoku ma dumutu la 'o nyawa 'idadi yongaku 'ato 'o Yesusou ge'ena ma Koana 'o Nyawa Wosilaha-laha gee ma Jo'oungu ma Dutu wosijajiokau, 'una ge'ena ma Jo'oungu ma Dutu ma sirete 'awi Ngowaka. De mita ma ngale yongaku 'unaka, 'ona yamake 'o 'ahu (Yoh. 3:16; Yoh. 20:31).</para>
  <para style="ip">Gedagee ma buku ne'ena ma gurueka 'isidemoka 'ato ma Jo'oungu ma Dutu 'awi demo 'ika-kakali ge'ena la 'o Yesus, ma buku ne'ena ma bula ma di-disiraka 'isijarita 'o no-nako 'ihera-herangi 'i'ini-'inioka gee 'o Yesus wodi-diai. 'O no-nako 'ihera-herangi ge'ena 'isidumutu 'ato 'o Yesus ge'ena ma Koana 'o Nyawa Wosilaha-laha gee ma Jo'oungu ma Dutu wosijajiokau, 'una ge'ena ma Jo'oungu ma Dutu 'awi Ngowaka. 'O jarita ma ngale 'o no-nako 'ihera-herangi moi-moi ge'ena 'isimoteke de 'o jarita ma ngale ma Jou Yesus de 'o nyawa manga gudai yomabi-bicara. Manga bicaraka dau ge'ena 'iwaitokau 'okia naga gee 'isisupuokau 'o no-nako 'ihera-herangi ge'ena. Ma bula ne'ena ma dodaka 'isidemo 'ato naga 'o nyawa gee yongaku-ngaku 'o Yesusika de yodadi 'awi do-domoteke, ma naga mita wiitomo de yooluku wingaku.</para>
  <para style="ip">Ma go-goraka 13-17 'o gudai 'isilefoku kokia ma 'ofi 'o Yesus de 'awi do-domoteke yomagiamanai ma 'orasi 'o Yesus dua witagokou ma obiruku, de kokia 'una wakisi'aturu de manga singina wosikuata ma obiri ge'ena.</para>
  <para style="ip">Ma go-goraka ma du-du'uruokau 'isidemo ma ngale kokia 'o Yesus witagoko de wi'urusu, kokia 'una wisidele 'o salipoka, wosongene de womomikoli, de kokia 'una womasidumutu 'awi do-domoteika gedagee wowangodeli.</para>
  <para style="ip">Ma buku ne'ena ma dodaka 'o Yohanes wosilamo-lamo 'o co-catu, ge'ena la 'o 'ahu ma dutu 'ika-kakali gee ma Jo'oungu ma Dutu wokula ma ngekomo ma Yesus Kristus. 'Unau ge'ena 'o ngekomo ma Jo'oungu ma Dutuka, 'unau ge'ena wosidumu-dumutu ma Jo'oungu ma Dutu 'una kokia, de 'unau 'o 'ahu wokula-kula. 'O Yohanes gee wodotoko 'okia sonaa 'iti-tiai, 'una woduaka wosi'ade-'ade de 'okia sonaa 'idadi-dadi 'o wange 'isinoi-noimi, kogee 'o 'akere, 'o roti, 'o darangi, 'o domba woso-sowohi de 'awi domba, 'o 'anggur ma roese de ma sowoko.</para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">'Una gee wisironga 'o Demo gee 'o nyawa wosi'ahu-'ahu</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />Ma sira ka 'o dunia ma koisidadikuwasi 'ena 'una gee wisironga 'o Demo 'una nagau.</para>
  <para style="q1" vid="JHN 1:1">'O demo 'una ge'ena naga de ma Jo'oungu ma Dutu</para>
  <para style="q1" vid="JHN 1:1">de 'una kaimatero de ma Jo'oungu ma Dutu.<verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />Ka ma di-disirakasi 'una naga de ma Jo'oungu ma Dutu.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />'O sagala moi-moi 'isikokidadi ma ngekomo 'una.</para>
  <para style="q1" vid="JHN 1:3">Nako ko 'unawa ge'ena</para>
  <para style="q1" vid="JHN 1:3">'okia sonaa 'iodumu 'idadi-dadiku gee ka moi ma koi'iwa.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />'O Demo 'una ge'ena 'o 'ahu ma titi.</para>
  <para style="q1" vid="JHN 1:4">De 'o 'ahu ma titi gu'una wo'asa 'o darangi 'o nyawaka.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />'O darangi ge'ena 'isiwara 'o darusu ma dodaka</para>
  <para style="q1" vid="JHN 1:5">de 'o darusu koya'akunuwa yasongene 'o darangi ge'ena.<verse eid="JHN 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JHN 1:6" />Naga wimoi ma Jo'oungu ma Dutu wisuloko woboano</para>
  <para style="q1" vid="JHN 1:6">'awi ronga 'o Yohanes.<verse eid="JHN 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JHN 1:7" />'Una woboa wositotara ma ngale 'o darangi ge'ena</para>
  <para style="q1" vid="JHN 1:7">la 'o nyawa 'iodumu yongaku 'unaka.<verse eid="JHN 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JHN 1:8" />'O Yohanes 'una ge'ena ko 'o darangiwa.</para>
  <para style="q1" vid="JHN 1:8">'Una duga kawositotara ma ngale 'o darangi ge'ena.<verse eid="JHN 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JHN 1:9" />'O darangi ma dutu gee yakidisiwara 'o nyawa 'iodumika</para>
  <para style="q1" vid="JHN 1:9">naga 'iboakau 'o duniano.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />Ngaro 'o dunia de ma doda 'isidadi ma ngekomo 'una,</para>
  <para style="q1" vid="JHN 1:10">ma gee 'una woboano 'o duniaka,</para>
  <para style="q1" vid="JHN 1:10">'o dunia ma nyawa kowinakowa ma ngale kowingakuwa.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />'Una woboa 'awi daeraano</para>
  <para style="q1" vid="JHN 1:11">ma 'awi nyawa-nyawa kowisidabinowa.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />Ma 'o nyawa 'iodumu gee widawongo de wingaku 'unaka,</para>
  <para style="q1" vid="JHN 1:12">wakidiai 'ona yodadi ma Jo'oungu ma Dutu 'awi ngowa-ngowaka.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />'Ona yodadi ma Jo'oungu ma Dutu 'awi ngowa-ngowaka ge'ena koimaterowa de ngone 'o nyawa polahiri.</para>
  <para style="q1" vid="JHN 1:13">Ngone polahiri ge'ena ka 'o nyawa ma du-duaka, ma 'ona yodadi ma Jo'oungu ma Dutu 'awi ngowa-ngowaka ge'ena sababu 'una ma sirete wakisidadi.<verse eid="JHN 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />'O Demo gu'una womadadiokau 'o nyawa,</para>
  <para style="q1" vid="JHN 1:14">de womanoa naga ngoneka,</para>
  <para style="q1" vid="JHN 1:14">de ngone pamakekau 'awi kumati.</para>
  <para style="q1" vid="JHN 1:14">'Awi kumati ge'ena ma Jo'oungu ma Dutuno to 'una 'awi Dea. Ngano 'una ge'ena ma Jo'oungu ma Dutu 'awi Ngowaka womatengo-tengoka.</para>
  <para style="q1" vid="JHN 1:14">Ma ngekomo 'una, ngone pakokimake ma Jo'oungu ma Dutu 'awi singina ma sure</para>
  <para style="q1" vid="JHN 1:14">de 'awi dora, de posironga wotiaioka.<verse eid="JHN 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 1:15" />'Unau ge'ena gee 'o Yohanes wositotara wongose 'ato,</para>
  <para style="q1" vid="JHN 1:15">&lt;&lt; 'O nyawa nu'unau gee ma sira tosikawasakau 'o nyawaka tongose 'ato,</para>
  <para style="q1" vid="JHN 1:15">&lt;Dua wimoi 'asa woboa ma 'una 'ifoloi wi kuasa 'iamoko de de ngoi.</para>
  <para style="q1" vid="JHN 1:15">Sababu ngoi kotolahiruawasi 'ena 'una nagau.&gt; &gt;&gt;<verse eid="JHN 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="JHN 1:16" />'Una posironga de wonadoraka</para>
  <para style="q1" vid="JHN 1:16">de posironga wonasibarakatioka</para>
  <para style="q1" vid="JHN 1:16">koitogu-togumuwa.<verse eid="JHN 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="JHN 1:17" />Ma Jou 'awi besesongo wonakula ma ngekomo 'o Musa,</para>
  <para style="q1" vid="JHN 1:17">ma ma Jo'oungu ma Dutu 'awi dora de 'awi di-diai gee</para>
  <para style="q1" vid="JHN 1:17">'itiai ma sala ngoneno wosidumutu ma ngekomo ma Yesus Kristus.<verse eid="JHN 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="JHN 1:18" />Komoiwasi wimake ma Jo'oungu ma Dutu</para>
  <para style="q1" vid="JHN 1:18">duga ka to 'una 'awi Ngowaka womatengo-tengoka</para>
  <para style="q1" vid="JHN 1:18">gee naga de ma Dea de ka 'o singina moi.</para>
  <para style="q1" vid="JHN 1:18">'Unau wosidumutu ngoneno ma Jo'oungu ma Dutu ge'ena nagu'una.<verse eid="JHN 1:18" /></para>
  <para style="s">'O Yohanes womasidemo 'ato 'una ge'ena ko ma Koanuwa gee 'o Nyawa Wosilaha-laha</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat. 3:1-12</ref>; <ref loc="MRK 1:1-8">Mrk. 1:1-8</ref>; <ref loc="LUK 3:1-18">Luk. 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />'O Yahudioka manga balu-balusu gee yogogere 'o Yerusalemuoka yosuloko 'o 'imam-'imam de manga ro-riwo gee manga 'asali 'o Lewino<note caller="a" style="f"><char style="fr" closed="false">1:19: </char><char style="ft" closed="false">'O 'imam-'imam de manga ro-riwo gee manga 'asali 'o Lewino ge'ena ma ngale 'o nyawa-nyawa gee yoma-manarama ma Jou 'awi Woaka ma ngale yakiriwo 'o 'imam.</char></note> yotagi 'o Yohanesika la yosano 'unaka 'ato ngona ne'ena ma kia. <figure style="fig" file="HK00379.pcx" size="span" ref="(1:19)">'O Yerusalem ma kota ma sirasi</figure><verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />'O Yohanes womasidemo wositi-tiaika wongose 'ato, &lt;&lt;Ma Koana 'o Nyawa Wosilaha-laha gee ma Jo'oungu ma Dutu wosijajiokau ge'ena ko ngoiwa.&gt;&gt;<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />De 'ona yosanoli, &lt;&lt;Nako koge'ena de ngona ne'ena nagu'una? Ma Nabii Elia?&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">'O Yohanes wosango, &lt;&lt;Ko'uwa.&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">De yongoseli, &lt;&lt;Ngona ne'ena 'o Nabii ma Amoko gee mida-damaa?&gt;&gt;</para>
  <para style="p" vid="JHN 1:21">'O Yohanes wosango wongose 'ato &lt;&lt;Ko'uwa!&gt;&gt;<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />Ge'enaka de 'ona yongoseli, &lt;&lt;Nako koge'ena ge'ena nosidemono ngomino ngona ne'ena nagu'una. La ngomi 'idadi miositotara 'o nyawaka gee misulo-suloko ngomino. So moteke ngona, ngona ne'ena ma kia?&gt;&gt;<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />'O Yohanes wosango, &lt;&lt;Ngoiou ne'ena gee ma sirasi ma Nabii Yesaya wongose 'ato:</para>
  <para style="q1" vid="JHN 1:23">&lt; 'O nyawa moi naga 'o tonaka 'ika-kakasaka wosigaso-gasoko wongose 'ato:</para>
  <para style="q1" vid="JHN 1:23">Niosikatiai 'o ngekomo ma ngale ma Jou woboa.&gt; &gt;&gt;<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Naga yakisulo-sulokino go'ona yamuruo naga 'o Farisioka. <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />'Ona yosano 'o Yohanesika, &lt;&lt;Nako ngona ko ma Koana 'o Nyawa Wosilaha-lahawa, ko 'o Eliawa, de ko 'o Nabii ma Amokuwa, de 'ido'oa so 'o nyawa naki'osiki?&gt;&gt;<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />'O Yohanes wosango, &lt;&lt;Ngoi 'o nyawa taki'osiki de 'o 'akere. Ma naga nia sigoronaka wimoi ngini kowininakowa. <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />'Una woboa woisidu'uruno. Ma ka 'awi tarupa ma gumini tasose ma koyadaenuwa.&gt;&gt;<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Ge'ena 'iodumu 'idadi 'o Betaniaka, 'o Yordan ma 'akeroka gee kiaka naga 'o Yohanes 'o nyawa waki'osi-'osiki ma songonasa dina.<verse eid="JHN 1:28" /></para>
  <para style="s">Ma Kristus 'una ge'ena wisi'ade-'ade ma Jo'oungu ma Dutu 'awi Domba ma Ngowaka</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ko ma bibinoka de 'o Yohanes wimake 'o Yesus woboa 'unano. De 'o Yohanes kawongosekau, &lt;&lt;Ee, gudaue ma Jo'oungu ma Dutu 'awi Domba ma Ngowaka gee wadua-duangou ma ngale watuusu 'o nyawa 'o duniaka ma so-sowono. <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />'Unau ge'ena gee tinisidemo-demokau 'ato dua wimoi woboa woisidu'uruno, ma 'una 'ifoloi 'awi kuasa 'iamoko, sababu ngoi kotolahiruawasi 'ena 'una nagau. <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Ma sira ngoi ma kotowinakowasi 'una ge'ena ma kia, 'ena momongo ngoi 'o nyawa taki'osiki de 'o 'akere la 'o Israeloka winako 'una.&gt;&gt;<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />'O Yohanes wositotara naneda mita, &lt;&lt;Ngoi tamake 'o Ngomasa 'Itebi-tebini 'i'uti daku 'o diwanguku 'isoka 'o pombo 'i'uti de 'imanoa 'unaka. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ma 'orasi ge'ena ngoi kotowinakowasi 'una ge'ena ma kia. Ma ma Jo'oungu ma Dutu wosuloko 'o nyawa taki'osiki de 'o 'akere, 'una wongosekau ngoino konee: &lt;Gee dua namake 'o Ngomasa 'Itebi-tebini 'i'uti de 'imanoa wimoioka, 'unau 'asa 'o nyawa waki'osiki de 'o Ngomasa 'Itebi-tebini.&gt; &gt;&gt; <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />'O Yohanes wongose, &lt;&lt;Ngoi ma sirete towimakekau de ngoi ma sirete tinisidemo 'ato 'una ge'ena ma Jo'oungu ma Dutu 'awi Ngowaka.&gt;&gt;<verse eid="JHN 1:34" /></para>
  <para style="s">'O Yesus 'awi do-domoteke ma di-disiraka</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ma bibinoka, 'o Yohanes de 'awi do-domoteke yamididi ge'enakauoli. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Gee 'o Yohanes wimake 'o Yesus wotagi-tagioko de kawongosekau, &lt;&lt;Winilega, gu'unau ma Jo'oungu ma Dutu 'awi Domba ma Ngowaka.&gt;&gt;<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />'O Yohanes 'awi do-domoteke yamididi go'ona kayo'isenoka 'o Yohanes koge'ena wongose, de yotagiokau 'o Yesus wimoteke. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />'O Yesus womadutumu 'awi dudunisa de wakimake 'ona wimote-moteke, de kawosanokau, &lt;&lt; 'Okiau nianonu?&gt;&gt;</para>
  <para style="p" vid="JHN 1:38">'Ona yosango, &lt;&lt;Rabi, kiaka nomanoa?&gt;&gt; ('O Rabi ngone tanu, &lt;&lt; 'o Guru&gt;&gt;.)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />'O Yesus wongose, &lt;&lt;Nou, ngini ma sirete nialega!&gt;&gt; 'Ona yotagi de de 'una de yamake kiaka 'una womanoa. Ma 'orasi ge'ena poilia 'o takoro soata 'o wange 'icako. Ge'ena ma wange 'ona yomanoa de de 'una.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Yamididi gee yo'isenokau 'okia naga 'o Yohanes wakisidemoka de yotagi wimoteke 'o Yesus, wimoi ge'ena 'o Andreas, 'o Simon Petrus ma dodoto. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />'O Andreas wosijai-jai winonu 'o Simon Petrus to 'una 'awi riaka, so wimakeno de kawongosekau 'unaka, &lt;&lt;Ngomi mimakamakekau ma Koana 'o Nyawa Wosilaha-laha gee wisironga ma Kristus!&gt;&gt; Ngone tanu &lt;&lt;Ma Jo'oungu ma Dutu Wiiri-iriki.&gt;&gt; <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Ge'enaka de 'o Andreas 'o Simon wi'otaka 'o Yesusika.</para>
  <para style="p" vid="JHN 1:42">'O Yesus widi-diriidi 'o Simonika de kawongosekau, &lt;&lt;Ngona 'o Simon, 'o Yohanes 'awi ngowaka. Ngona 'asa nisironga 'o Kefas.&gt;&gt; ('O Kefas ge'ena 'o Yunanioka yongose 'ato 'o Petrus, ngone tanu &lt;&lt; 'O Teto 'Igi-gigie.&gt;&gt;)<verse eid="JHN 1:42" /></para>
  <para style="s">'O Yesus waki'asoko 'o Filipus de 'o Natanael ma ngale yodadi 'awi do-domoteke</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ma bibinoka 'o Yesus waputusokau wotagi 'o Galileaka. De yomakamake de 'o Filipus de kawongosekau 'o Filipusika, &lt;&lt;Nou noimoteke ngoi la nodadi 'ai do-domoteke!&gt;&gt; <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />'O Filipus 'awi 'asali 'o Betsaida ma kotano, ge'ena la 'o Andreas de 'o Petrus manga gogeroka. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />'O Filipus yomakamake de 'o Natanael de kawongosekau 'o Natanaelika, &lt;&lt;Ngomi mimakekau 'o nyawa gee 'o Musa wingose-ngose naga ma Jo'oungu ma Dutu 'awi besesongo ma bukuoka, de gee 'o nabii yosika-kawasa. 'Una ge'ena 'o Yesus 'o Nazaretino, 'o Yusuf 'awi ngowaka!&gt;&gt;<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Ma 'o Natanael wosango, &lt;&lt;Tei! Kaidadi? 'o kianikia moi yaowa-owa de 'iboa 'o Nazaretino?&gt;&gt; De 'o Filipus wosango, &lt;&lt;Nou, ngona ma sirete wonilega!&gt;&gt;<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />'O Yesus wimake 'o Natanael woboa de kawongosekau, &lt;&lt;Winimake, gu'una 'o Israel toto. 'Una 'awi singina 'itiai.&gt;&gt;<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />'O Natanael wosano 'o Yesusika, &lt;&lt; 'Aba, kokia so noinako?&gt;&gt; 'O Yesus wosango, &lt;&lt; 'O Filipus kowoni'asokuawasi 'ena tonimakekau 'o gota ma ronga 'o 'ara ma timiku.&gt;&gt;<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Ge'enaka de 'o Natanael kawongosekau, &lt;&lt; 'Aba Guru, ngona ne'ena ma Jo'oungu ma Dutu 'awi Ngowaka, ngona 'o Israeloka ma nyawa 'amia Koana!&gt;&gt;<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />'O Yesus wongose, &lt;&lt;Ngona nongaku ge'ena duga ka sababu ngoi tongose 'ato tonimakekau 'o gota ma ronga 'o 'ara ma timiku! Dua 'asa namake 'okia sonaa 'ifoloiosi 'ila-laagomo de ge'ena!&gt;&gt; <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />De ge'ena 'o Yesus wongoseli, &lt;&lt;Ne'ena tonisidemo tosigou-gounguku, ngona 'asa namake 'o diwanga 'ipelenga de ma Jo'oungu ma Dutu 'awi sagala mala'ekati 'i'uti doa ngoi 'o Nyawa ma Ngowaka 'ai bionoka.&gt;&gt;<verse eid="JHN 1:51" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">'O ngaamoko yosi'odomo 'o Kana ma kotaka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />'O Yesus waki'asokoka 'o Filipus de 'o Natanael, de ma wange sa'angeka de 'o ngaamoko yosi'odomo 'o Kana ma kotaka 'o Galilea ma daeraaka. De 'o Yesus ma 'esa mita ge'enaka. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />'O Yesus de wi do-domoteke mita yamake 'o ga-gasoko 'o ngaamoko ma ngodomino ge'ena. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />Gedagee manga 'anggur 'ibootokau de 'o Yesus ma 'esa kamongosekau 'o Yesusika, &lt;&lt;Manga 'anggur yakisidobootokau.&gt;&gt;<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />'O Yesus wosango, &lt;&lt; 'Eme, 'uwasi noisuloko. Ma 'orasi koya'adonuawasi tomasidumutu 'ato ngoi ne'ena ma kia.&gt;&gt;<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Ma 'o Yesus ma 'esa mongose 'o nyawa-nyawaka gee yole-leleani 'o ngaamoko ma ngodomoka go'ona, &lt;&lt;Kaniamoteke 'okia naga bato wongose nginika.&gt;&gt;<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Ge'enaka 'o 'akere ma ngii 'o ngai butangaka yadua-duanga ma ngale yomasi'iso-'isoko moteke 'o Yahudioka manga 'adati la bari yotebini ma Jo'oungu ma Dutu 'awi bionoka. 'O 'akere ma ngii ge'ena moi-moi ma doda poilia 'o literi ratusu moiku. <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />'O Yesus wongose yole-leleanika go'ona, &lt;&lt;Ma 'akere ma ngi-ngiiku ge'ena niokokidarisuku 'o 'akere.&gt;&gt; Ge'enaka de 'ona yodarisi yosi'oma-'omangie. <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt;Bika ne'ena nia'ese ma 'akere ge'ena ma eta de nia'asa ma rame ma dutuka.&gt;&gt; Ge'enaka de 'ona ya'asa ma 'akere ge'ena ma rame ma dutuka, <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />de ma rame ma dutu gu'una wataili ma 'akere gee 'imadadikou 'o 'anggur. ('Una kowosido-dogumuwa kiano 'o 'anggur ge'ena, yanako duga ka gee yole-leleani gee ma 'akere ge'ena yodari-darisi.) So ma rame ma balusu gu'una wi'asokino wonga-ngaamoko, <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />de kawongosekau, &lt;&lt; 'Etei, biasa 'o nyawa 'o 'anggur yosisupu ge'ena 'isira gee 'ifoloi yaowa-owasi de nako 'o nyawa yoboa-boano gee yakidugakau 'asa de gee biasali. Ma 'Esa moi ngona nadaotika 'o 'anggur gee 'ifoloi yaowa-owa sigado ne'ena.&gt;&gt;<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Ne'enau 'o no-nako 'ihera-herangi ma di-disiraka 'o Yesus wodiai. 'Una wodiai ge'ena 'o Kana ma kotaka 'o Galilea ma daeraaka. De 'o no-nako ge'enau 'una wosidumutu 'awi kuasa 'iamoko ma sala so wi do-domoteke wingaku.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Ge'ena 'ipasa de 'o Yesus de ma 'esa, de 'awi dodo-dodoto, de mita wi do-domoteke yotagi 'o Kapernaum ma kotaka. 'Ona ge'enaka manga wange muruoka naga.<verse eid="JHN 2:12" /></para>
  <para style="s">'O Yesus ma Jo'oungu ma Dutu 'awi Woaka</para>
  <para style="r">(<ref loc="MAT 21:12-13">Mat. 21:12-13</ref>; <ref loc="MRK 11:15-17">Mrk. 11:15-17</ref>; <ref loc="LUK 19:45-46">Luk. 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Gee 'o Yahudioka manga wange ma amoko 'isoriokau ge'ena la yosingano-nganonie Wakisisupu ma Wange, de 'o Yesus wotagi wosikaie 'o Yerusalemude. <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />'O Yerusalemuoka ma Jo'oungu ma Dutu 'awi Woa ma ginitaroka 'o Yesus wakimake 'o sapi de 'o domba de 'o pombo yomawuku-wukunu, de mita 'o pipi yosita-tagali ge'enaka yogogerie. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />'O Yesus wodiai 'o be-besana moi 'o gumini de ge'enau wakisikiniiki yomawuku-wukunu go'ona de manga sapi de ma domba 'iodumu gee ma Jou wi Woa ma ginitaroka. 'O pipi yosita-tagali manga meja waleoto pagara so manga pipi ma 'ipiakorika. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Ge'enaka de wongose 'o pombo yowuku-wukunika, &lt;&lt;Nia'aikika 'iodumu ne'enaka dau. 'Ai Dea 'awi Woa 'uwa niadiai nimawuku-wukunu ma ngii!&gt;&gt; <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />So 'awi do-domoteke yonganonie 'o Buku 'Itebi-tebini ma bo-bulaka 'ingose konee, &lt;&lt; 'Ani Woa posironga toduaoka. 'Ai du-duaka 'ai singina ma dodaka ge'ena matero ka 'o 'uku 'ilala-lala.&gt;&gt;<verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />'O Yahudioka manga balu-balusu 'o Yesus wiba-baili yongose 'ato, &lt;&lt;Bika nodiai 'o no-nako 'ihera-herangi ma ngale 'isidumutu ngomino 'ato ngona ma Jo'oungu ma Dutu wonikula 'o hak nodiai kone'ena.&gt;&gt;<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />'O Yesus wosango wongose 'ato, &lt;&lt;Niapiakorika ma Jo'oungu ma Dutu wi Woa ne'ena, de ka 'o wange sa'ange ma dodaka de ngoi tosigokokali!&gt;&gt;<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />De 'ona yosango, &lt;&lt; 'O taunu nagi soata de butangano yodiai ma Jou wi Woa ne'ena, de ngona nomau nosigokoli ka 'o wange sa'ange ma dodaka?&gt;&gt;<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Ma 'o Yesus 'awi dumutu ma ngale ma Jou 'awi Woa ge'ena, ge'ena la to 'una 'awi roese ma sirete. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />So ge'enaka de gee 'o Yesus wisimomikoka 'o songenoka, de 'awi do-domoteke yonganonie 'ato ma ngale ge'ena, ge'ena wakisidemokau. So yongaku 'okia naga gee 'isilefoku 'o Buku 'Itebi-tebinoka de mita gee 'okia naga 'o Yesus wosidemokau.<verse eid="JHN 2:22" /></para>
  <para style="s">'O Yesus wakinako 'o nyawa 'iodumu</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />'O Yesus ka 'o Yerusalemuokasi ma 'orasi Wakisisupu ma Wange ma Amoko ge'ena, de 'o nyawa manga gudai yongaku 'unaka sababu 'o no-nako 'ihera-herangi wokadiai. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Ma 'o Yesus ma sirete kowakingakuwa, sababu 'una wakinako 'o nyawa 'iodumu. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Ma ngale 'o nyawa manga singina, koiparaluuwa 'o nyawa yosiwaiti 'unaka, sababu 'una wanako 'okia naga 'o nyawa manga singina ma dodaka.<verse eid="JHN 2:25" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">'O Yesus de 'o Nikodemus</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Naga wimoi 'o Yahudioka manga balusu 'o Farisino 'awi ronga 'o Nikodemus. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Ma moi ge'ena 'iobiruku de waino 'o Yesusino de wongose, &lt;&lt; 'Aba Guru, ngomi mianako ngona 'o guru moi ma Jo'oungu ma Dutu wonisulokino, sababu komoiwa ya'akunu yadiai 'o no-nako 'ihera-herangi 'isoka ngona nodi-diai nako ko de ma Jo'oungu ma Dutuwa.&gt;&gt;<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />De 'o Yesus wosango, &lt;&lt;Ne'ena tosidemogaroku tosidemo, komoiwa moi yodadi ma Jo'oungu ma Dutu 'awi 'umati nako koyakisingowakuwali.&gt;&gt;<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Ge'enaka de 'o Nikodemus wongose 'o Yesusika, &lt;&lt;Tei, kokia 'o nyawa yobalusokau de yakisingowakoli? Kaidadiosi manga 'esa manga pokorie yoliode 'asa de yakisingowakoli?&gt;&gt;<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />De 'o Yesus wosango, &lt;&lt;Ma gou-goungu yadaene 'ai demo ne'ena: Nago'ona koyakisingowakuwa de 'o 'akere de 'o Ngomasa 'Itebi-tebini, 'ona koyodadiwa ma Jo'oungu ma Dutu 'awi 'umati. <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />Ngone 'o nyawa ge'ena ka nanga balusu 'inasingowauku, ma nako 'o 'ahu ma sungi ge'ena 'o Ngomasa 'Itebi-tebinino. <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />'Uwa noherangi nako ngoi tongose 'ato ngini nioodumu salingou nisingowakoli. <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />'O dadoko 'itagi kiaka naga moteke 'ena ma mau, ngone po'isene ma guruusu ma koposidongoowa kiano 'iboa de kiaka 'isikaika. Koge'enali mita 'o nyawa gee 'o Ngomasa yakisingowaka ma ngale 'o 'ahu ma sungi yakikula, ge'ena moteke to 'ena ma mau.&gt;&gt;<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />'O Nikodemus wosano, &lt;&lt;Kokia sigado koge'ena 'idadi?&gt;&gt;<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />'O Yesus wosango, &lt;&lt;Ngona noguru 'o Israeloka de konosikanakowa? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />Tonisidemo ne'ena: Ngoi tobi-bicara duga ka 'okia sonaa gee tanakokau, de tosijarita duga ka 'okia naga gee tamakekau, ma ngini koniadawonguwa 'okia naga gee tositota-totara. <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />Ngini koniongakuwa gee ngoi tosijarita 'okia sonaa 'o duniaka ne'ena, so dua ma rai koniongakuwa nako ngoi tosijarita 'okia sonaa 'o sorogaaka! <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />Komoiwasi yodoa 'o sorogaade, duga ka ngoi 'o Nyawa ma Ngowaka gee to'utiokau 'o duniaku.<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />'Isoka 'o Musa 'o tonaka 'ika-kakasaka 'o ngia gee 'o tambaga yadi-diaiku 'o gotaka wosidoade, koge'enali mita ngoi 'o Nyawa ma Ngowaka salingou 'isitedene 'o salipoka. <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />La 'o nyawa 'iodumu gee yongaku-ngaku ngoino yamake 'o 'ahu 'ika-kakali.&gt;&gt;<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />Sababu ma Jo'oungu ma Dutu wadora ma sala 'o nyawa 'o duniaka ne'ena, sigado wokula 'awi Ngowaka womatengo-tengoka, la nago'ona yongaku de yomasiga-gao 'unaka, ge'ena koyobinasawa ma yamake 'o 'ahu kaisi'ado-'adonika. <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />Sababu ma Jo'oungu ma Dutu 'awi Ngowaka wosiguti 'o duniaku, ma ngale kowahukumuwa 'o nyawa 'o duniaka ne'ena, ma 'ena wosilaha. <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />'O nyawa gee yongaku-ngaku 'unaka ge'ena koyakihukumuwa. Ma gee koyongaku-ngakuwa ge'ena ma Jo'oungu ma Dutu wakihukumokau sababu koyongakuwa ma Jo'oungu ma Dutu 'awi Ngowaika gee womatengo-tengoka. <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />'Ona yakihukumu ma sababu naneda: Ma Jo'oungu ma Dutu 'awi darangi 'iboakau 'o duniano, ma 'o nyawa 'ifoloi yoduaka ka 'o darusu ge'ena la 'o sowono, sababu manga manarama 'itorou. <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />'O nyawa gee yodua-duaka 'o dorou yodiai, yodu'uduku 'o darangi. 'Ona yooluku yaika 'o darangika la manga di-diai 'ito-torou ge'ena 'uwa 'isupu. <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />Ma 'o nyawa gee yadi-diai ma Jo'oungu ma Dutu 'awi mau, 'ona yoboa 'o darangika la 'iwaiti 'okia naga yadiaiokau ge'ena moteke ma Jo'oungu ma Dutu 'awi mau.<verse eid="JHN 3:21" /></para>
  <para style="s">'O Yesus de 'o Yohanes Wo'osi-'osiki</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Ge'ena 'ipasa de 'o Yesus de 'awi do-domoteke 'o Yerusalemuoka yoma'aiki yotagi 'o Yudea ma daeraaka. Ge'enaka doka 'una de 'awi do-domoteke manga wange muruoka naga, de ma 'orasi ge'ena 'una 'o nyawa waki'osiki. <verse eid="JHN 3:22" /><verse number="23-24" style="v" sid="JHN 3:23-24" />Ma 'orasi ge'ena 'o Yohanes kowobuiwasi. 'Una 'o nyawa waki'osiki 'o 'akeroka gee yosironga 'o Ainon 'o Salim ma datekoka, sababu ge'enaka 'o 'akere 'iamoko. So 'o nyawa yoboa 'unano de waki'osiki.<verse eid="JHN 3:23-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />'O Yohanes 'awi do-domoteke yamuruo naga yomakaributu de 'o Yahudioka wimoi, ma ngale kokia yoma'isoko la bari yotebini ma Jo'oungu ma Dutu 'awi bionoka moteke manga 'adati. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />'Ona yotagi 'o Yohanesika de yongose, &lt;&lt;Ee 'Aba Guru, ma raiokau kanongano-nganonosi 'o nyawa wimoi gee de de ngona 'o Yordan ma 'akere ma songonaka, gee ma sira nosidumutu ngomino! Ne'ena 'una 'o nyawa waki'osiki mita, de 'o nyawa manga gudai yotagi 'unaka!&gt;&gt;<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />'O Yohanes wosango, &lt;&lt;Ka ngone 'o nyawa ge'ena kopomadamakewa 'isoka koge'ena, nako ko ma Jo'oungu ma Dutuwa wonakula. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Ngini ma sirete nio'isenokau ngoi tosidemo konee: &lt;Ngoi ko ma Koana 'o Nyawa Wosilaha-lahawa. Ngoi ma Jo'oungu ma Dutu woisuloko tosira 'o duniano, 'asa deika 'una.&gt; <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />Ma raiokau 'o nyawa dua yosikaika 'unaka sababu 'ona ge'ena to 'una, 'isoka 'o ngeweka monga-ngaamoko muna ge'ena to ma rokata. Ma wonga-ngaamoko 'awi manai ge'ena duga kawoma'okode 'awi dateoka de wosigisene, de 'una womorene nako wo'isene wonga-ngaamoko 'awi 'ilingi. Koge'enali mita ngoi. Ne'ena ngoi tomorene ma sala. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Salingou 'una kaisiika monga wisiamoko, de ngoi kaisiika monga koisiamokuawau.&gt;&gt;<verse eid="JHN 3:30" /></para>
  <para style="s">'Una gee 'o sorogaaku woboaku</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />&lt;&lt; 'Una gee daku 'o sorogaaku woboaku, 'una wodaduie de 'o nyawa 'iodumu 'o duniaka. Ma 'o nyawa 'o duniano, 'ona ge'ena 'o dunia ma nyawa, de yobi-bicara 'o dunia ma kia sonaa. 'Una gee dakuuku 'o sorogaaku woboa-boaku, ge'ena 'una wodaduie de 'o sagala 'iodumu. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />'Una wosidemo 'okia naga gee wamakekau de wo'isenokau 'o sorogaaka, ma 'o nyawa koyongakuwa 'okia naga wosidemo-demo ge'ena. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Ma 'o nyawa gee yongaku 'awi demo ge'ena, 'ona ge'ena yongaku 'ato ma Jo'oungu ma Dutu 'awi demo ge'ena ma gou-goungu 'itiai. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Sababu 'una gee ma Jo'oungu ma Dutu wisuloko wositotara 'awi demo-demo, ngano 'unaka wisidukulakau 'o Ngomasa 'Itebi-tebini ma kuasa. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Nanga Dea ma Jo'oungu ma Dutu wisibosono 'awi Ngowaika, de wosisarakaniokau 'o sagala moi-moi 'una waparetano. <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />'O nyawa gee yongaku de yomasiga-gao ma Jo'oungu ma Dutu 'awi Ngowaika gu'una, 'ona yamake 'o 'ahu 'ika-kakali. Ma 'o nyawa gee kowisingounuwa ma Jo'oungu ma Dutu 'awi Ngowaika gu'una, 'ona koyamakewa 'o 'ahu kaisi'ado-'adonika. 'Ona ma Jo'oungu ma Dutu tatapu kawakihukumosi.&gt;&gt;<verse eid="JHN 3:36" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">'O Yesus de 'o ngeweka mimoi 'o Samariano</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />'O Yesus wanako 'ato 'o Farisioka yo'isenokau 'ato 'una 'o nyawa manga gudai wimoteke de waki'osiki, 'ifoloi yokudai de gee 'o Yohanes womote-moteke. (<verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />Yadaene 'ena 'o Yesus 'una kowaki'osikuwa duga ka 'awi do-domoteke.) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Gee 'o Yesus wanako 'ato 'o Farisioka yo'isenokau ge'ena, de 'una woma'aiki 'o Yudea ma daeraaka de wolio 'o Galilea ma daeraaku. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />Wosikauku 'o Galileaku waboa 'o Samaria ma daeraa ge'ena moteke ma Jo'oungu ma Dutu 'awi mau. <verse eid="JHN 4:4" /><verse number="5" style="v" sid="JHN 4:5" />So wototara 'o kota moika 'o Samariaka ma ronga 'o Sikhar, 'o tonaka gee ma sira 'o Yakub wokula-kula 'awi ngowaka 'o Yusufika ma dateoka. <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Ge'enaka dau 'o parigi moi gee yosironga 'o Yakub 'awi parigi. 'O Yesus wokangelakou sababu 'awi do-dagi 'ikurutu, so wogogeruku 'o parigi ma dateoka. Ma 'orasi ge'ena poilia 'o takoro mogiooko de modidi 'o wangeka. <verse eid="JHN 4:6" /><verse number="7-8" style="v" sid="JHN 4:7-8" />Ma 'orasi ge'ena 'awi do-domoteke yotagiokau 'o kotaka 'o 'inomo yo'ija.</para>
  <para style="p" vid="JHN 4:7-8">Ge'enaka de 'o Samaria ma nyawa mimoi moboa 'o 'akere mosi'onoko, de 'o Yesus kawongosekau munaka, &lt;&lt;Biranga, tanu ma eta noikula ta'okere?&gt;&gt; <figure style="fig" file="LB00302.tif" size="span" ref="(4:7-9)">'O Yesus de 'o Samariano mimoi 'o sumu ma dateoka</figure><verse eid="JHN 4:7-8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />'O ngeweka gumuna mosango, &lt;&lt; 'Aba ngona 'o Yahudi ma nyawa, ngoi 'o Samaria ma nyawa; de 'ido'oa so nomau 'o 'akere noga'asoko ngoino?&gt;&gt; (Muna koge'ena mongose, sababu 'o Yahudioka 'ona koyomakasupuwosamuwa de 'o Samariaka.)<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />'O Yesus wosango, &lt;&lt;Nako ngona nanako ma Jo'oungu ma Dutu 'awi co-catu 'o nyawaka, de nanako ngoi ne'ena ma kia gee toga-ga'asoko 'o 'akere ngonaka, ma raiokau ngona ma sirete noga'asoko 'o 'akere ngoino ma ngale na'okere, de ngoi 'asa tonikula 'o 'akere gee 'o nyawa yakisiwango-wango.&gt;&gt;<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />'O ngeweka gumuna mosango, &lt;&lt; 'Aba, 'o parigi ne'ena komasorikuwa, 'ani gu-guiti ma koi'iwa, de kiano namake 'o 'akere gee 'o nyawa yosi'ahu-'ahu? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />'O Yakub to ngomi 'amia topora, mikulano 'o parigi ne'ena. 'Una ma sirete ne'enakou wa'odo-'odomo; koge'enali mita 'awi ngowa-ngowaka de 'awi haewani waso-sowohi. Bolo 'Aba ngona nongose ngona 'ifoloi noamoko de 'o Yakub?&gt;&gt;<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />'O Yesus wongose, &lt;&lt; 'O nyawa gee ya'oke-'okere 'o 'akere ne'ena dua manga kibiti kaidudungokasi! <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />Ma 'o nyawa gee dua ya'okere 'o 'akere gee ngoi takikulaka, dua manga kibiti koidudunguawau kaisi'ado-'adonika. Sababu 'o 'akere gee dua ngoi takikula-kulaka ge'ena matero ka 'o booteke manga roese ma dodaka, gee ma 'akere 'i'uisi de yakikula 'o 'ahu kaisi'ado-'adonika.&gt;&gt;<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />'O ngeweka gumuna mongose, &lt;&lt; 'Aba, noikulano 'o 'akere ge'ena, la 'ai kibiti 'uwau 'idudu-dudungu, de koiparaluuwau tainoli ne'enano ma ngale 'o 'akere tosi'onoko.&gt;&gt;<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />De 'o Yesus wongose, &lt;&lt;Tagi 'ani rokata woni'ese, deika nainoli de de 'una ne'enano!&gt;&gt;<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />'O ngeweka gumuna mosango, &lt;&lt;Ngoi 'ai rokata koi'iwa.&gt;&gt; 'O Yesus wosango, &lt;&lt;Ia ma goungu 'ani demo ge'ena. <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />Sababu ngona nongaamoko ma motoau, de 'o nauru gee ne'ena naga nimalomuno ge'ena ko to ngonawa 'ani rokata.&gt;&gt;<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />'O ngeweka gumuna kamongosekau, &lt;&lt;Ne'ena ngoi tanako 'Aba ngona 'o nabii moi. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />To ngomi 'amia edete de mia dotumu yosuba ma Jo'oungu ma Dutuka 'o gigieka ne'ena. Ma 'Aba to ngona 'ani nyawa yongose 'ato, 'o nyawa salingou yosuba ma Jo'oungu ma Dutuka, ma ngii duga ka 'o Yerusalemuoka.&gt;&gt;<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />'O Yesus wongose munaka, &lt;&lt;Biranga, kanongaku bato 'okia naga tongose-ngose! Dua 'o 'orasi ma moi, 'o nyawa 'asa yosuba 'ai Deaka ko ne'ena 'o gigiekawau, de mita ko 'o Yerusalemuokawau. <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />Ngini 'o Samaria ma nyawa winisuba ma Jo'oungu ma Dutu ma kowininako 'itiaiwasi, ma ngomi 'o Yahudi ma nyawa misuba ma Jo'oungu ma Dutu gee minako-nakokau, sababu 'o habari ma ngale ma Jo'oungu ma Dutu 'o nyawa wosilaha, ma ngekomo 'o Yahudi ma nyawaka de yaino. <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />Ma dua ma 'orasi 'asa ya'adono de naga ya'adonokau, 'o Ngomasa 'Itebi-tebini 'asa nisi'asa winisuba 'ai Dea ma Jo'oungu ma Dutu, ma ngekomo 'iti-tiai 'isoka gee 'una wodua-duaka. <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />Sababu ma Jo'oungu ma Dutu ge'ena 'o Ngomasa, de duga ka de 'o Ngomasa 'Itebi-tebini so 'o nyawa 'idadi wisuba 'ai Dea ma Jo'oungu ma Dutu, de winako 'itiai.&gt;&gt;<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />'O ngeweka gumuna mongose 'o Yesusika, &lt;&lt;Ngoi tanako ma Koana 'o Nyawa Wosilaha-laha (gee wisironga ma Kristus) 'asa woboa. Gee woboa ge'ena dua wositotara 'okia sonaa moi-moi ngomino.&gt;&gt;<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />'O Yesus wongose, &lt;&lt; 'Una gee woningose-ngose ge'ena ngoiou gee ne'ena tobi-bicara de de ngona.&gt;&gt;<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Ma 'orasi ge'ena 'o Yesus 'awi do-domoteke yolio 'o kotaka de yaino so ya'adono ge'enano. 'Ona yoherangi wimake 'o Yesus wobi-bicara de 'o ngeweka mimoi. Ma komoiwa yomoroini yosano 'ato, &lt;&lt; 'Aba, 'okiau noparaluu?&gt;&gt; Bolo &lt;&lt; 'Ido'oa so 'Aba nobi-bicara de 'o ngeweka gumuna?&gt;&gt;<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Ge'enaka de 'o ngeweka gumuna mamada 'ami 'akere ma ngii de motagi kamoowa-owara 'o kotaka de mosidemo 'o nyawa-nyawaka ge'enaka doka, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />&lt;&lt;Nou powilega 'o nyawa gee wosidemo 'okia sonaa 'iodumu gee ngoi tadi-diaiokau. Poilia 'una ge'ena ma Koana 'o Nyawa Wosilaha-laha ge'ena la ma Kristus!&gt;&gt; <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />So 'o nyawa-nyawa ma kotaka ge'ena mita yotagi 'o Yesus wilega.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Ma 'orasi ge'ena 'o Yesus 'awi do-domoteke yongose, &lt;&lt; 'Aba Guru, no'odomosi.&gt;&gt;<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />'O Yesus wongose, &lt;&lt; 'O 'inomo naga ngoioka gee ngini konianakowa.&gt;&gt;<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />So 'awi do-domoteke yomakasano yongose 'ato, &lt;&lt;Naga 'o nyawa 'o 'inomo widagasano?&gt;&gt;<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Ge'enaka de 'o Yesus kawongosekau, &lt;&lt;To ngoi 'ai 'inomo ge'ena la tadiai 'ai Dea gee woisulo-suloko 'o duniano 'awi mau, de tosiduanga 'o manarama gee wokulakau ngoino. <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />Ngini niongose 'ato, &lt; 'O togutuku 'o mede soatosi.&gt; Ma ngoi tinisidemo: Nialega 'o bira 'o bairoka 'i'umukukou, 'i'utukou! <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />Yo'utu-'utuku gee 'ikuruekau yomanarama de yamake manga sewa de ma hasili ge'ena la 'o nyawa yamake 'o 'ahu 'ika-kakali. So gee yotudu-tuduku de yo'utu-'utuku yoodumu 'idadi kayomore-morene. <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />De ge'ena dau ge'ena 'itiai gee 'o nyawa yongose-ngose konee: &lt;Moi yotuduku, moi yo'utuku.&gt; <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />Ngoi tinisuloko ngini niotagi 'o nyawaka gee yakisitotarokau 'o Habari ma Owa matero katinisuloko nio'utuku 'o bairoka gee 'o nyawa 'iregu yotuduuku. 'O nyawa 'iregu yomanarama, ma ngini niomadugutuku ma hasili.&gt;&gt;<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />De manga gudai 'o Samaria ma nyawa ma kotaka ge'ena yongaku 'o Yesusika sababu 'o ngeweka gumuna mongose 'ato, &lt;&lt; 'Una wosidemo ngoino 'okia naga 'iodumu gee todi-diaiokau.&gt;&gt; <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />So gee 'o Samaria ma nyawa go'ona yomakamake de 'o Yesus, de wibaja la womanoasi de de 'ona. So 'o Yesus womanoa ge'enaka 'o wange modidioka.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Ge'enaka de 'o nyawa-nyawa kayokudai monga yongaku 'o Yesusika, sababu 'okia naga gee 'una ma sirete wakisidotoko 'onaka. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />'Ona yosidemo 'o ngewekaka gumuna yongose 'ato, &lt;&lt;Ma 'orasi ne'ena ngomi miongaku ge'ena ma sababu ko ngonawau 'okia naga nongoseno ngomino, ma 'ena sababu ngomi ma sirete mio'isenokau 'una wobi-bicara, de mianako 'una ge'ena ma goungu 'o nyawa 'o duniaka wosilaha-laha.&gt;&gt;<verse eid="JHN 4:42" /></para>
  <para style="s">'O Yesus wosi'aiki 'o kadatoka woma-manarama wimoi 'awi ngowaka</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />'O Yesus 'o Sikharoka wi wange modidioka, de wotagi wosikauku 'o Galileaku. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />'O Yesus ma sirete wongosekau 'ato, &lt;&lt; 'O nabii moi ka to 'ona manga soanoka ge'ena koyakihoromatiwa.&gt;&gt; <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Ma gee wototara 'o Galileaku, de 'o nyawa-nyawa ge'enaka dau widawongo kayomore-morene, sababu Wakisisupu ma Wange ma Amoko 'ona 'o Yerusalemuoka, de yamakekau 'iodumu gee 'o Yesus wodi-diaiokau.<verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Ge'enaka de 'o Yesus wolioli 'o Kanaka 'o Galilea ma daeraaka, gee kiaka naga 'o 'akere wadiai 'idadi 'o 'anggur. De 'o Kapernaumoka wimoi 'o pamaretaka woma-manarama 'awi ngowaka wopanyakeku. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Gee wo'isenoka 'o Yesus woboano 'o Galileaka 'o Yudeaka de waino, de 'una waika 'o Yesusika woga'asoko 'o Yesus 'o Kapernaumika waika la wosi'aiki 'awi ngowaka gee rekeni wosongenoka. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />'O Yesus wongose 'unaka, &lt;&lt;Nako ngini koniamakewa 'o no-nako 'ihera-herangi, ngini koniongakuwa.&gt;&gt;<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />De 'una wosango, &lt;&lt; 'Aba, tanu nomataitika la 'ai ngowaka kowosongenuwasi 'ena noboakau la wonisi'aikokau!&gt;&gt;<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />'O Yesus wongose, &lt;&lt;Notagiou, 'ani ngowaka wi panyake ge'ena 'i'aiki.&gt;&gt;</para>
  <para style="p" vid="JHN 4:50">'O nyawa gu'una wongaku 'o Yesus 'awi demo ge'ena, ge'enaka de wotagiokau. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />'O ngekomo ma goronaka de 'awi ro-riwo yoboa de yosidemo 'unaka, &lt;&lt; 'Aba, 'ani ngowaka wi panyake 'i'aikokau.&gt;&gt;<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Ge'enaka de 'una wosano 'onaka 'o takoro muruo de 'ikurue 'i'aiki? 'Ona yosango, &lt;&lt;Ka'uginika poilia 'o takoro moi 'o wange 'ikoronako.&gt;&gt; <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />De 'o ngowaka ma dea gu'una wonganonie 'ato ma 'orasi ge'enau 'o Yesus wongose 'unaka 'ato, &lt;&lt; 'Ani ngowaka wi panyake ge'ena 'i'aiki.&gt;&gt; So 'una de 'awi woa ma dodaku yoodumu yongaku 'o Yesusika.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Ge'enau 'o no-nako 'ihera-herangi 'o Yesus wodiai ma warasa ma modidi 'o Galileaka gee woboano 'o Yudeaka de waino.<verse eid="JHN 4:54" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">'O Yesus wisi'aiki wimoi 'awi panyake 'o Betesda ma 'akere 'ilupa-lupanginoka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Ge'ena 'iduangino 'o wange muruo naga de 'o Yahudioka manga wange ma amoko, so 'o Yesus wotagi 'o Yerusalemude. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />'O Yerusalem ma kotaka ma tembok 'isigilolitoka, de ma ngorana moi yosironga-ronga &lt;&lt; 'O Domba ma Ngorana&gt;&gt;. Ge'ena ma Domba ma Ngorana ma dateoka 'o lupanga moi gee 'o Ibranioka yosironga 'o Betesda. Ma lupanga ge'ena ma dateoka 'o ngii moi 'ibatingi motoaka. <figure style="fig" file="LB-00307.tif" size="span" ref="(5:2)">'O Betesda ma lupanga</figure> <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Ma ngiioka ge'ena, manga gudaioka yopa-panyake yoma'idu-'iduoka: Munuka yorau-rau, de munuka yolugu-lugu de munuka manga roese 'isonge-songene. ['Ona yoodumu yoda-damaa 'o 'akere 'ilupa-lupangoka ge'ena 'iluaka. <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Sababu ma Jou 'awi mala'ekati 'ijaga 'i'uti ma 'akeruku ge'ena de yaluaka. De yopa-panyake gee yo'uti yosira ma lupanguku ge'ena ma 'orasi ma 'akere 'iluaka, ge'ena 'okia naga bato manga panyake yosisa-sangisara gee 'i'aiki.] <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Ge'enaka dau wimoi wopanyake 'o taunu nagi sa'ange de tuangerinou. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />'O Yesus wimake 'una woma'iduoka ge'enaka dau, de wanako 'ato 'una ge'ena ma do'ingou wopanyake; so 'o Yesus wosano 'unaka, &lt;&lt;Nomodeke 'ani panyake 'i'aiki?&gt;&gt;<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Wopa-panyake gu'una wosango, &lt;&lt; 'Aba, ne'enaka dau komoiwa 'i'asa 'isingosama 'o lupanguku ge'ena, gee ma 'orasi 'o 'akere ge'ena 'iluaka. De gee ma 'orasi ngoi tosikauku 'o lupanguku, 'o nyawa 'iregu yosirakau yowosanga.&gt;&gt;<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />So ma rai 'o Yesus kawongosekau 'unaka, &lt;&lt;Nomomikie, 'ani kokowa nagoraka la notagiou.&gt;&gt; <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Kage'ena ma 'orasi de 'o nyawa gu'una 'awi panyake 'i'aikokau. 'Una ka 'awi kokowa wa'aiki de wotagiokau.</para>
  <para style="p" vid="JHN 5:9">Ge'ena 'idadi Pomaoma-omasa ma Wangeka. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Sababu ge'ena 'o Yahudioka yopa-pareta kayongosekau 'o nyawaka gee 'awi panyake 'asa kai'aikino, &lt;&lt;Ne'ena ma wange Pomaoma-omasa ma Wange, so moteke nanga 'agama ma besesongo koidadiwa 'ani oki na'asa.&gt;&gt;<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Ma 'o nyawa gu'una wosango, &lt;&lt; 'O nyawa gee kangano woisi'ai-'aiki woisuloko tagoraka 'ai oki de totagiou.&gt;&gt;<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />'Ona yosano, &lt;&lt;Gee wosulo-suloko 'ani oki nagoraka 'una ge'ena nagu'una?&gt;&gt; <verse eid="JHN 5:12" /><verse number="13" style="v" sid="JHN 5:13" />Ma 'o nyawa 'awi panyake 'i'aikokau gee, kowinakowa 'o nyawa gu'una nagu'una, sababu 'o Yesus womaisangokau doka 'o nyawa yoku-kudaika.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Ge'ena 'ipasa de 'o Yesus de 'o nyawa gu'una yomakamake ma Jou 'awi Woaka de 'o Yesus kawongosekau 'unaka, &lt;&lt;Nongano-nganono! Ne'ena to ngona 'ani panyake 'i'aikokau, so 'uwa nodiaioli 'o sowono, la 'uwa 'ifoloiosi nosangisara.&gt;&gt;<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />So ma rai 'o nyawa gu'una wotagi de wosidemo 'o Yahudioka manga balu-balusika 'ato 'awi panyake ge'ena 'o Yesus wosi'aiki. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Ge'enau so 'ona yokurue 'o Yesus wisikadingidaa, sababu 'una 'o nyawa manga panyake wosi'aiki Pomaoma-omasa ma Wangeka.<verse eid="JHN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 5:17" />Ma 'o Yesus wongose 'onaka, &lt;&lt; 'Ai Dea kowomaogoruwa womanarama ma ngale 'o nyawa wakiriwo sigado ne'ena, so ngoi mita salingou tomanarama.&gt;&gt;<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />'O demo-demo ge'enau sigado 'o Yahudioka manga balu-balusu 'ifoloiosi yosikanonu yomau wito'oma. 'Ona koge'ena yodiai ge'ena bukangi la duga kawaparene 'o 'agama ma 'atorangi ma ngale Pomaoma-omasa ma Wange, ma mita sababu wongose 'ato ma Jo'oungu ma Dutu ge'ena to 'una 'awi Dea; ma ngale 'una womasitero de ma Jo'oungu ma Dutu.<verse eid="JHN 5:18" /></para>
  <para style="s">Ma Jo'oungu ma Dutu 'o pareta wokula 'awi Ngowakika</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />'O Yesus wosango 'o nyawa-nyawaka go'ona wongose 'ato, &lt;&lt; 'Uwa koniongakuwa, ngoi ma Jo'oungu ma Dutu 'awi Ngowaka koidadiwa 'o kianikia todiai ka de to ngoi ma sirete 'ai mau. Ngoi todiai duga ka 'okia naga tamake-make 'ai Dea wodiai. Sababu 'okia naga gee 'ai Dea wadiai, ge'enau mita ngoi tadiai. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Sababu 'ai Dea woisibosono de wosidumutu la tadiai 'okia naga 'iodumu gee 'una ma sirete wadi-diai. De 'asa wosidumutu 'o manarama 'ifoloiosi 'ila-laagomo ma ngale tadiai, sigado ngini nioherangi. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />'Isoka 'ai Dea gu'una wosimomiki 'o nyawa yosonge-songenuku de wakikula 'o 'ahu 'ika-kakali, koge'enali mita ngoi to 'una 'awi Ngowaka. Ngoi takikula 'o 'ahu 'ika-kakali 'o nyawaka gee tomau yamake 'o 'ahu. <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />'Ai Dea ma sirete kowakihakimuwa nago'ona bato. Sababu 'o kuasa 'iodumu ma ngale wohakimi, wokulakau ngoino 'awi Ngowakino. <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />'Ai Dea koge'ena wodiai la 'o nyawa 'iodumu 'i'isene ngoino 'isoka 'ai Deaka. 'O nyawa gee koi'isenuwa ngoino, ge'ena kowi'isenuwa mita 'ai Deaka gee woisulo-suloko toboano.<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />Ma gou-goungu 'itiai 'ai demo-demo ne'ena: Nago'ona yosigisene 'ai demo-demo, de wingaku 'unaka gee woisulo-suloko, 'ona yamake 'o 'ahu 'ika-kakali. 'Ona 'asa koyakihukumuwa, de yakisimadakau 'o songenoka ma ngale koyomakati-tingakuawau de ma Jo'oungu ma Dutu, de yamakekau 'o 'ahu 'ika-kakali. <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />Ngoi ma Jo'oungu ma Dutu wi Ngowaka, tinisidemo ne'ena: Dua 'asa ma 'orasi ya'adono, de ne'ena 'iboakau, 'o nyawa yosonge-songene ma ngale yo'ahu ko de ma Jo'oungu ma Dutuwa 'asa yo'isene 'ai 'ilingi. De gee yo'ise-'isene de yosingou-ngounu go'ona 'asa yowango. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />'Isoka 'ai Dea ma sirete 'una ge'ena 'o 'ahu ma titi, koge'enali mita ngoi woidiai 'o 'ahu ma titi. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />De 'una woisito-togumokau ngoino ma ngale tahakimi 'o nyawa, sababu ngoi 'o Nyawa ma Ngowaka. <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />'Uwa nioherangi gee nio'isene 'okia naga tosidemo-demo ne'ena, sababu ma 'orasi 'asa 'iboa 'o nyawa yosonge-songenokau yoodumu yo'isene 'ai 'ilingi, <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />de 'o nyawa gee yodiaiokau yaowa-owa 'asa yomomiki ma ngale yo'ahuoli. Ma 'o nyawa gee yodiaiokau 'ito-torou 'asa yomomiki ma ngale yakihukumu.&gt;&gt;<verse eid="JHN 5:29" /></para>
  <para style="s">'O Yesus wosidemo 'ato 'una ge'ena ma Jo'oungu ma Dutu wisulokino</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />'O Yesus wongoseli, &lt;&lt;Ngoi koidadiwa todiai 'okia sonaa moi-moi ka de to ngoi ma sirete 'ai mau. Ngoi 'o nyawa tahakimi moteke ka kokia naga gee ma Jo'oungu ma Dutu wosuloko. De 'ai butusangi ge'ena 'iloa, sababu ko to ngoiwa ma sirete 'ai mau tamoteke, ma 'ena to 'ai Dea gee woisulo-suloko 'awi mau.<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />Nako kogee ngoi tomasisakisii ma ngale ka ngoi ma sirete, 'ai sakisii ge'ena koyangakuwa. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Ma naga wimoi ge'ena la 'ai Dea, 'una woisisakisii ma ngale ngoi, de ngoi tanako to 'una 'awi sakisii ge'ena yadaene. <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />Ngini niosidingotokau 'ania su-suloko 'o Yohanesika la yosano ma ngale ngoi de 'una wakisidemokau yadae-daene ma ngale ngoi. <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Ne'ena tinisidemo ge'ena, ge'ena kotoparaluuwa 'o sakisii 'o nyawano, ma 'ena ma ngale niamake 'o laha. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />'O Yohanes 'una ge'ena 'isi'ade-'ade 'isoka 'o silo 'iluru-lurusu ma ginitara sababu 'okia naga gee wositota-totara ge'ena. De ngini kaniomore-morene niadawongo ma siwara ge'ena ngaro ka 'o 'orasi moioka ma. <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />Ma naga ma nyo-nyata 'ireguosi 'ifoloi 'ikuata de gee 'o Yohanes wosidemo-demo ma ngale ngoi, ge'ena la 'o manarama gee 'ai Dea wosuloko tadiai. Ge'enau 'isinyata 'ato 'ai Dea wosulokokau ngoi. <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />De 'ai Dea gee woisulo-suloko mita wosidemo ma ngale ngoi. Ngini koma'iwasi nio'isene 'awi 'ilingi de koma'iwasi niamake 'awi jako. <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />'Awi demo-demo konia'esenowa nia singina ma dodaka sababu ngini koniongakuwa ngoino gee woisulo-sulokino. <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />Ngini niomadotoko 'o Buku 'Itebi-tebini sababu ngini niongose ge'ena dau ma dodaka 'idadi niamake 'o 'ahu 'ika-kakali. De 'o Buku 'Itebi-tebini ma sirete 'isisakisii ma ngale ngoi. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Ma ngini niooluku nioboa ngoino ma ngale niamake 'o 'ahu 'ika-kakali.<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />Ngoi kotanonuwa 'o nyawa 'isiie. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Ngoi tininako ngini. Ngini ko de nia singina ma gounguwa winidora ma Jo'oungu ma Dutuka. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Sababu ngoi toboa de 'ai Dea 'awi pareta, ma ngini konidawonguwa. Ma nako 'o nyawa 'iregu yoboa de to 'ona ma sirete manga kuasa, ngini niomau niakidawongo. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Ngini koniongakuwa ngoino sababu ngini niomau ka ngini de ngini nimasika'arene, de niooluku ma Jo'oungu ma Dutu gee womatengo-tengoka winisiarene nginika. <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />'Uwa niongose 'ato dua ngoi tinisisala ngini 'ai Dea 'awi bionoka. 'Ena duga 'o Musa gee to ngini 'ania singina nganono, dua winisisala nginika. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Nako ngini niongaku 'o Musaka, ma rai ngini 'asa niongaku ngoino mita, sababu 'una wolefoku 'awi bukuoka ge'ena ma ngale ngoi. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Ma nako ngini koniongakuwa gee 'o Musa walefo-lefoku, ma raiokau koniongakuwa 'okia naga gee tosidemo-demo.&gt;&gt;<verse eid="JHN 5:47" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">'O Yesus wakisi'odomo 'o nyawa yacaana motoaka</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat. 14:13-21</ref>; <ref loc="MRK 6:30-44">Mrk. 6:30-44</ref>; <ref loc="LUK 9:10-17">Luk. 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />Ge'ena 'ipasano 'o wange muruo naga de 'o Yesus womasingo'otiri wosikaisa 'o Galilea ma talaga ma songonasa, gee yosironga mita 'o Tiberias ma talaga. <figure style="fig" file="HK00340.pcx" size="span" ref="(6:1)">'O Galilea ma talaga</figure> <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />'O nyawa manga gudai wimoteke sababu yamakekau 'o no-nako 'ihera-herangi wodiai ge'ena la 'o nyawa yopa-panyake wakisi'aiki. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />'O Yesus de 'awi do-domoteke yosau 'o gigiede so kadaku ma dekuoka de yomasidogogerie de 'awi do-domoteke. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Ma 'orasi ge'ena 'o Yahudioka manga Wange ma Amoko ma ngale ma Jo'oungu ma Dutu Wakisisupu ma Wange ma rame-rame 'isoriokau. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Gee 'o Yesus womakadutumu 'awi datekino, de wakimake 'o nyawa manga gudai kayotuonou yoboa 'unano, so kawongosekau 'o Filipusika, &lt;&lt;Ee Filipus, bika kiaka 'idadi 'o 'inomo po'ija la 'o nyawa yoodumu no'ona 'idadi yo'odomo?&gt;&gt; (<verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />'O Yesus wanakokau 'okia gee dua wodiai, ma koge'ena wongose sababu womau witaili 'o Filipusika.)<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />De 'o Filipus wosango, &lt;&lt;Ma roti ma 'ija ngaro 'o pipi 'o saaka ma amoko 'o ratusu modidi<note caller="b" style="f"><char style="fr" closed="false">6:7: </char><char style="ft" closed="false">Ma 'orasi ge'ena 'o pipi 'o saaka 'o ngai moi ge'ena ma ngale 'o nyawa moi yomanarama 'o wange moi manga sewa. Palega Mat. 20:2.</char></note> ma koyaki'adonuwa 'o nyawa-nyawa no'ona, ngaro 'o nyawa moi ka ma eta-etaka ma.&gt;&gt;<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />De 'o Yesus 'awi do-domoteke wimoioli ge'ena la 'o Andreas, 'o Simon Petrus ma dodoto, kawongosekau, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />&lt;&lt;Nongoka 'o ngowaka wimoi 'awi roti 'o ngai motoaka, de 'awi naoko 'o ngai modidioka. Ma ge'ena ma faedaa koi'iwa ma ngale 'o nyawa manga gudaioka no'ona.&gt;&gt;<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />'O Yesus wongose 'awi do-domoteika, &lt;&lt;Niakisuloko la 'o nyawa go'ona yogogeruku.&gt;&gt; Ge'enaka dau de ma 'ubutoka so 'o nyawa-nyawa go'ona yoodumu yogogeruku ge'enaka, poilia yacaana motoaka ka 'o nau-naurosi. <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Ge'enaka de 'o Yesus wa'eseno ma roti ge'ena de wo'amalahakasi ma Jo'oungu ma Dutude, 'asa de ma roti ge'ena wosuloko 'awi do-domoteke yosibula-bula 'o nyawa yoku-kudaika. Deika ma naokoli mita wa'eseno de wo'amalahakasi ma Jo'oungu ma Dutude deika wosuloko yosibula-bula so yoodumu yo'odomo sigado yosibunu-bunusu. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Gee yakikokipunusoka de 'o Yesus wongose 'awi do-domoteika, &lt;&lt; 'O 'inomo ma baili ge'ena niakokitoomu la 'uwa si'ado munuka 'ihalebiru.&gt;&gt; <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />So ma roti 'o ngai motoa gee 'o nyawa ge'ena manga gudai ya'odomoka, 'ena ma baili yatoomuno 'o gogata mogiooko de modidi ya'oma-'omanga!<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />'O nyawa yoku-kudai yamakeka 'o Yesus wodiai 'o no-nako 'ihera-herangi de kayongoseku, &lt;&lt;Ma goungu nu'una 'o Nabii ma Amoko gee 'o Buku 'Itebi-tebinoka 'ingose 'ato dua woboa 'o duniano!&gt;&gt; <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />'O Yesus wakinako 'ona yomau yaino wipakisaa wodadi to 'ona manga Koana. Sababu ge'ena 'una wotagi womasiresene 'o daeraa 'idiko-dikoka.<verse eid="JHN 6:15" /></para>
  <para style="s">'O Yesus wotagi-tagi 'o 'akere ma dekuoko</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat. 14:22-33</ref>; <ref loc="MRK 6:45-52">Mrk. 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Gee 'iobirou de 'o Yesus 'awi do-domoteke yo'uti 'o talagaku. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />Ge'enaka de 'o ngo'otiruku yoparene yosikaika ma talaga ma songonaka doka 'o Kapernaumika. 'Itarusokau 'ena 'o Yesus kowoboawasi 'onaka. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />'Ena ma 'orasi ge'ena 'o talaga yacobokau 'imoku-moku sababu 'o dadoko 'ikuata. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Gee 'ona yosidete poilia 'o kilo motoa bolo butangau, de wimake 'o Yesus woboa wa'adonou manga ngo'otirino, wotagi-tagi 'o 'akere ma dekuoko. So 'ona yakimodongo ma sala. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Ma 'o Yesus wongose 'onaka, &lt;&lt; 'Uwa nimodongo, ka ngoi ne'ena so!&gt;&gt; <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Ge'enaka de 'ona kayomore-morene wisuloko manga ngo'otiriku woparene, de kage'ena ma 'orasi de manga ngo'otiri ge'ena 'itotarokau gee manga dumutika.<verse eid="JHN 6:21" /></para>
  <para style="s">'O nyawa manga gudai 'o Yesus winonu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ma bibinoka, 'o nyawa yoku-kudai gee ka 'o talaga ma songonakasi doka, yanako 'ato kangano 'o ngo'otiri ka 'o ngai moioka duga kadoka. 'Ona yanako 'ato 'o Yesus 'awi do-domoteke yotagiokau de 'o ngo'otiri ge'ena, ma 'o Yesus kowomotekuwa. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Ge'enaka de 'o ngo'otiri ngai muruo naga 'iboa dokaino 'o Tiberias ma kotano, de yomasidutuku kiaka naga 'o nyawa yoku-kudai 'o roti yo'odo-'odomo ma dateoka gee ma Jou Yesus wo'amalahakasi ma Jo'oungu ma Dutude. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Gee yoku-kudai yanako 'ato 'o Yesus de 'awi do-domoteke koyaki'iwau ge'enaka, de 'ona mita yokokidoa 'o ngo'otiruku ge'enaka gee, de yotagi 'o Kapernaumika 'o Yesus winonu.<verse eid="JHN 6:24" /></para>
  <para style="s">'O Yesus 'una ge'ena 'isoka 'o 'inomo gee 'o nyawa yakisi'ahu-'ahu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />'O nyawa-nyawa go'ona gee yomakamakeno de 'o Yesus doka 'o talaga ma songonaka, de kayosanokau 'unaka, &lt;&lt; 'Aba Guru, kauruo nototarino ne'enaka?&gt;&gt;<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />'O Yesus wosango, &lt;&lt;Ma gou-goungu, ngini ninonu ngoi, ge'ena ko ma ngalewa 'ato niasahekau 'o no-nako 'ihera-herangi todi-diai ma dumutu, ma 'ena sababu ka 'o roti nia'odomokau sigado niosibunu-bunusu. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Niomanarama 'uwa duga kaniomau niamake 'o 'inomo gee kaiboo-bootokasi de kaitorouokasi. Ma 'ena niomanarama ma ngale niamake 'o 'inomo gee koito-torouwau de nisi'ahu kaisi'ado-'adonika. 'O 'inomo ge'ena dua ngoi 'o Nyawa ma Ngowaka tinikula, sababu ngoi ma Jo'oungu ma Dutu 'ai Dea gu'una woisitatapuokau ma dumutu ge'ena.&gt;&gt;<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Ge'enaka de 'ona yosango 'o Yesusika, &lt;&lt;Ngomi salingou 'okia miadiai ma ngale miamoteke ma Jo'oungu ma Dutu 'awi mau?&gt;&gt;<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />'O Yesus wosango, &lt;&lt;Ma Jo'oungu ma Dutu womau ngini niongaku ngoino gee woisulo-sulokino.&gt;&gt;<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />'Ona kayongosekau, &lt;&lt;Nako koge'ena, 'o no-nako ka'ena 'Aba 'idadi nosidumutu ngomino la miamake de miningaku 'Aba? 'Okia dua 'Aba nodiai? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Ma sira mia dotumu de mia topora 'o manna ya'odomokau 'o tonaka 'ika-kakasaka, 'isoka 'isilefokau 'o Buku 'Itebi-tebinoka, &lt; 'Una wakikulakau 'o roti 'o sorogaaku.&gt; &gt;&gt;<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt;Tinisidemo ne'ena, ko 'o Musawa wokula 'o roti ma dutu gee 'o sorogaaku, ma 'ena 'ai Dea. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Sababu 'o roti ma dutu gee ma Jo'oungu ma Dutuno, ge'ena la ngoi gee to'utiku daku 'o sorogaaku la takikula 'o 'ahu 'ika-kakali 'o nyawaka 'o duniaka.&gt;&gt;<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />De 'ona yongose 'o Yesusika, &lt;&lt; 'Aba, tanu kaitaurika nokula ngomino 'o roti ge'ena.&gt;&gt;<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />'O Yesus wongose 'onaka, &lt;&lt;Ngoi ne'ena matero ka 'o 'inomo gee 'o nyawa yakisi'ahu-'ahu. So nago'ona yaino ngoino de 'ingaku, 'ona 'asa koyakisawinuawau de manga kibiti koidudunguawau kaisi'ado-'adonika.<verse eid="JHN 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 6:36" />Ma gee 'isoka tosidemokau nginika, ngaro ngini nimakekau ngoi, ma ngini koniongakuwa. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />'O nyawa 'iodumu gee 'ai Dea wosito-togumokau ngoino ma ngale takipareta, 'asa yoboa ngoino. Ngoi 'asa kotakiitomuwa nago'ona bato yoboa ngoino. <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />Sababu ngoi 'o sorogaaka de to'uti, ge'ena ma ngale ko to ngoiwa 'ai mau ma sirete tadiai, ma 'ena to 'una gee woisulo-suloko. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />De nanedau gee woisulo-suloko 'awi mau: 'Una womau la 'o nyawa 'iodumu gee wosito-togumokau ngoino, ka moi ma 'uwa yoisanga. La dua takisimomiki 'o dunia ma do-dogumoka de yowango kaisi'ado-'adonika. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />'Ai Dea woduaka ge'ena la 'o nyawa 'iodumu gee 'ingaku-ngaku ngoi, 'ona yamake 'o 'ahu 'ika-kakali, de takisimomikoli 'o dunia ma do-dogumoka.&gt;&gt;<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />'O Yahudioka yakitu'uduku de yokurubungu sababu 'una wongose 'ato, &lt;&lt;Ngoi ne'ena 'o 'inomo daku 'o sorogaaku!&gt;&gt; <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />'Ona kayongosekau, &lt;&lt; 'Etei 'unau ne'ena 'o Yesus 'o Yusuf 'awi ngowaka! Ngone pakinako 'awi dea de 'awi 'esa! De kokia so ne'ena wongose 'ato 'una 'o sorogaaku wo'utiku?&gt;&gt;<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt; 'Uwau niokurubungu. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Ka moi ma koidadiwa yoboa de yongaku ngoino, nako 'ai Dea gee woisulo-suloko kowaki'asawa ngoino, de nago'ona yoboa, 'ona 'asa takisimomiki 'o dunia ma do-dogumoka. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />'O nabii manga bukuoka 'isitulisuku konee: &lt; 'O nyawa 'iodumu 'asa ma Jo'oungu ma Dutu wakidotoko.&gt; So nago'ona gee yosigisene de yomadotoko 'ai Deaka, 'asa yoboa ngoino. <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />Ge'ena ko ma ngalewa 'ato naga 'o nyawa wimakekau 'ai Dea. Duga ka ngoi gee ma Jo'oungu ma Dutuoka de taino ge'ena towimakekau 'ai Dea.<verse eid="JHN 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47" />Niongano-nganono: 'O nyawa gee yongaku-ngaku ngoino, 'ona yamakekau 'o 'ahu 'ika-kakali. <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />Ngoiou ne'ena 'o 'inomo gee 'o nyawa yakisi'ahu-'ahu. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />'O tonaka 'ika-kakasaka 'ania edete de nia dotumu 'o manna yo'odo-'odomo ma kayosongenoka. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Ma 'o 'inomo gee dakuuku 'o sorogaaku ge'ena koimaterowa de 'o manna. Nago'ona ya'odomo 'o 'inomo ge'ena, 'ona koyosongenuawau. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Ngoi ne'ena 'o 'inomo 'o sorogaaku, 'o 'inomo gee 'o nyawa yakisiwango-wango. 'O nyawa gee ya'odomo 'o 'inomo ne'ena, 'asa yo'ahu kaisi'ado-'adonika. 'O 'inomo gee dua tokula ma ngale 'o nyawa 'o duniaka yakisi'ahu, ge'ena la 'ai roese.&gt;&gt;<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />'O Yahudi ma nyawa yo'isenoka de moi de moi yomakaributu kayongosekau, &lt;&lt;Kokia 'o nyawa nu'una wonakula 'awi roese la pa'odomo?&gt;&gt;<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Tinisidemo ne'ena! Ngoi ne'ena 'o Nyawa ma Ngowaka. Nako ngini konia'odomuwa 'ai roese de konia'okeruwa 'ai 'aunu, ngini 'asa nio'ahu koitiaiwa. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />'O nyawa gee 'ai roese ya'odomo de 'ai 'aunu ya'okere, 'asa yamake 'o 'ahu 'ika-kakali de 'asa takisimomiki 'o dunia ma do-dogumoka. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Sababu 'ai roese ge'ena 'o 'inomo ma dutu, de 'ai 'aunu ge'ena 'o 'anggur ma gou-goungu. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />'O nyawa gee 'ai akeme ya'odomo de 'ai 'aunu ya'okere, 'ona ge'ena kaisi'ado-'adonika yomarimoi de de ngoi, de ngoi de de 'ona. <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />'Ai Dea 'o 'ahu ma titi gu'una, 'unau woisuloko taino. De ngoi to'ahu sababu 'una. Koge'enali mita 'o nyawa gee ya'odomo 'ai roese, 'asa 'o 'ahu yamake sababu ngoi. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Ne'enau 'o 'inomo gee 'o sorogaaku 'i'utiku; 'o 'inomo gee koimaterowa de gee nia edete de nia dotumu ya'odo-'odomo. Sababu gee ma 'inomo ge'ena ya'odomoka, ma kayosongenokasi. Ma 'o nyawa gee ya'odomo 'o 'inomo ne'ena, 'asa yo'ahu kaisi'ado-'adonika.&gt;&gt;<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Ge'ena 'iodumu 'o Yesus wosidemo, gee ma 'orasi wodotoko 'o lo-lomu ma woaka 'o Kapernaumoka.<verse eid="JHN 6:59" /></para>
  <para style="s">'O demo-demo gee 'o nyawa yakisidadi laha</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Yo'isenoka 'o Yesus 'awi demo-demo ge'ena, de 'awi do-domoteoka naga manga gudai yongose 'ato, &lt;&lt; 'O do-dotoko ne'ena kaifoloi 'itubuso. 'O do-dotoko ne'ena komoiwa ya'akunu yamoteke!&gt;&gt;<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />'O Yesus ma sirete 'awi singina ma dodaka wanako 'ato 'awi do-domoteke yakitu'uduku sababu 'awi demo-demo ge'ena, de kawongosekau, &lt;&lt;Ngini nioolukou nimoteke ngoi sababu 'ai demo-demo ge'ena? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Kokiau dua nako nimake ngoi 'o Nyawa ma Ngowaka todoali 'o sorogaade 'ai ngii ma sirade? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />'O nyawa po'ahu ge'ena sababu 'o Ngomasa 'Itebi-tebini. Ka 'o nyawa ma guata ge'ena koidadiwa po'ahu. 'O demo-demo gee tosibicara nginika ne'ena, ge'ena la 'o Ngomasa 'Itebi-tebini ma demo-demo, de 'o demo-demo ge'enau 'o nyawa yakisi'ahu-'ahu. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Ma de ma 'ena mita nginioka naga koyongakuwa.&gt;&gt; ('O Yesus kamasi-sirakasi womanarama 'ena wakinakokau nago'ona gee dua koyongaku-ngakuwa, de nago'ona dua wihalebiru.) <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Ge'enaka de 'o Yesus wongoseli, &lt;&lt;Ge'enau so ngoi tosidemokau nginika 'ato komoiwa moi 'idadi yoboa ngoino nako 'ai Dea kowongosewa 'ato ngini niodadi to ngoi 'ai do-domoteke.&gt;&gt;<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />'Ikurue ma 'orasi ge'ena, 'o nyawa gee wimote-moteke manga gudai wimadakau. <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />Ge'enaka de 'o Yesus wakisano 'awi do-domoteke yamogiooko de modidi, &lt;&lt;Ngini mita niomau nimadau ngoi?&gt;&gt;<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />'O Simon Petrus kawongosekau, &lt;&lt;Jou, ngomi dua komoikawa miosikaika! Jou 'ani demou ge'ena so 'o nyawa yamake 'o 'ahu 'ika-kakali. <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Ngomi miongaku de mianako Jou ngona ge'ena 'o su-suloko notebi-tebini ma Jo'oungu ma Dutu woniiri-iriki.&gt;&gt;<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />'O Yesus wosango, &lt;&lt;Ngoiou tiniiriki nimogiooko de modidi ne'ena. Ma wimoi nginioka naga ge'ena 'o Tokata ma Koana ma su-suloko!&gt;&gt; <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />'O Yesus 'awi dumutu ge'ena la 'o Yudas, 'o Simon Iskariot 'awi ngowaka. Sababu 'o Yudas ngaro 'o do-domoteke moi gee yamogiooko de modidioka, ma 'una dua 'o Yesus wiwukunu.<verse eid="JHN 6:71" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">'O Yesus de 'awi riaka dodoto</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Ge'ena 'ipasa de 'o Yesus wotagi-tagi 'o Galileaka wakilolituku. 'Una wooluika 'o Yudeaka, sababu ge'enaka doka gee yopa-pareta 'o Yahudioka yomau wito'oma.<verse eid="JHN 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 7:2" />Ma 'orasi ge'ena 'o Yahudioka manga Wange ma Amoko gee yosironga 'o Da-darusu ma Katu 'o Soka-soka ma rame 'isoriokau. <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />So 'o Yesus 'awi riaka dodoto kayongosekau 'unaka, &lt;&lt;Namadaka 'o ngii ne'ena de notagi 'o Yudeaka, la 'ani do-domoteke 'idadi yamake mita 'ani manarama 'o no-nako 'ihera-herangi nodiai. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Nako 'o nyawa wimoi womau la 'o nyawa wikokinako, ge'ena 'okia naga wadi-diai gee koidadiwa wosigi'iunino. Nako ngona nomau 'o nyawa 'iodumu ninako, salingou notagi nosidumutu 'o no-nako 'ihera-herangi 'o nyawa 'iodumika!&gt;&gt; (<verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Sababu to 'una ma sirete 'awi riaka dodoto mita koyongakuwa.)<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />'O Yesus wongose 'onaka, &lt;&lt;Ma ngale ngoi, ge'ena ko ma 'orasuawasi tomasidumutu 'o kawasaka. Ma ngini, 'o 'orasi 'isinoimi kaidadi. <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />'O nyawa 'o duniaka ne'ena konidu'udukuwa nginika. Ma ngoino ge'ena 'idu'uduku, sababu ngoi kaitaurika tosidemo 'ato manga di-diai 'itorou. <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />Tagi ka ngini niaika doka 'o wange ma amoko ma rameka. Ngoi kotaikawa sababu ngoi tomasidumutu ma 'orasi koya'adonuawasi.&gt;&gt; <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />'O Yesus koge'enau wongose 'awi riaka dodotika, de 'una mita ge'ena 'o Galileakasi womanoa.<verse eid="JHN 7:9" /></para>
  <para style="s">'O Yesus woboano 'o Da-darusu ma Katu 'o Soka-soka ma rameka</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Gee 'o Yesus 'awi riaka dodoto yotagioka 'o Da-darusu ma Katu 'o Soka-soka ma Wange ma Amoko ma rameka, de 'o Yesus kawomasiriidino wotagi ma rameka ge'ena komoiwa winakoka. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Ma rame-rame ge'ena ma do'ingono gee, 'o Yahudioka manga balu-balusu wikanonu de yokasano, &lt;&lt; 'O Yesus kiaka?&gt;&gt;<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Manga gudai yomakakasudu yomasikademo ma ngale 'una. Munaka yongose 'ato, &lt;&lt; 'Una 'o nyawa ma owa.&gt;&gt; Munuka yongose 'ato, &lt;&lt;Ko'uwa! 'Una 'o nyawa manga gudai wakisiliba.&gt;&gt; <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Ma komoiwa yomoroini yobicara yosita-tarangika ma ngale 'una, sababu yakimodongo gee 'o Yahudioka manga balu-balusika.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />'O rame-rame ma doda de 'o Yesus wowosanga ma Jou 'awi Woaka de wodotoko. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />'O Yahudioka manga balu-balusu go'ona yoherangi ma sala de kayongosekau, &lt;&lt;Kokia so 'o nyawa nu'una koge'ena ma gudai wanako, 'ena 'una koma'iwa 'o 'agamaka yodoto-dotoko widotoko?&gt;&gt;<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />'O Yesus wosango, &lt;&lt;Gee ngoi tosidoto-dotoko ne'ena, ge'ena ko to ngoiwa ma sirete 'ai do-dotoko, ma 'ena to ma Jo'oungu ma Dutu gee woisulo-suloko. <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />'O nyawa gee yomau ma Jo'oungu ma Dutu 'awi mau yamoteke, 'asa yanako 'ai do-dotoko ge'ena 'iboa ma Jo'oungu ma Dutuno bolo ka ngoino. <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />'O nyawa gee yosidotoko ka to 'ona ma sirete manga do-dotoko, ge'ena yomau ka 'onaka yakihoromati. Ma 'o nyawa gee yomau la wihoromati 'unaka gee woisulo-suloko, 'o nyawa go'ona yoloa. <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />Ma Jo'oungu ma Dutu 'awi besesongo 'o Musa wositotarokau nginika! Ma naga nginioka komoiwa yamoteke 'o besesongo ge'ena. De 'ido'oa so niomau nito'oma?&gt;&gt;<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />'O nyawa yoku-kudai go'ona kayongosekau, &lt;&lt;Nitokatuku gee de! Nago'ona yomau nito'oma?&gt;&gt;<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />'O Yesus wosango, &lt;&lt; 'O no-nako 'ihera-herangi ka 'o ngai moi tadiai Pomaoma-omasa ma Wangeka, de ngini nioherangi de nitu'uduku. <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />Ma 'o Musa winikula 'o 'atorangi ma ngale niomasuna, ngaro 'o suna ge'ena ko 'o Musanowa ma mulaenge, so 'ena ka nanga edete de nanga dotumosi 'o Musa kowi'iwasi 'ena. Ge'enau so Pomaoma-omasa ma Wangeka ma ngini niomau 'o nyawa niakisuna. <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />Ngini niakisuna 'o ngowaka 'o nauru Pomaoma-omasa ma Wangeka ge'ena ma ngale la 'uwa niaparene 'o besesongo gee 'o Musa wositota-totara ma ngale 'o suna, de 'ido'oa so niongamo ngoino gee 'o nyawa manga roese ma panyake tosi'aiki 'itiaioka Pomaoma-omasa ma Wangeka? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />'Uwa niakihakimi 'o nyawa moteke ka gee pamake-make, ma 'ena niatibangi niosidi-diai la moteke 'iloa-loa.&gt;&gt;<verse eid="JHN 7:24" /></para>
  <para style="s">Ma goungu 'o Yesus 'una ge'ena ma Koana 'o Nyawa Wosilaha-laha gu'una</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Ge'enaka de 'o Yerusalem ma nyawa yamuruo naga kayongosekau, &lt;&lt;Ma rai nu'unau gee ne'ena naga winonu-nonu yomau wito'oma! <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Winimake 'una wobicara womasuka-suka 'o kawasa ma bionoka, de nanga balu-balusu ka moi ma kokiawa yongose 'unaka! Poilia to ngone nanga balu-balusu yanakokau 'ato 'una ne'ena ma Koana 'o Nyawa Wosilaha-laha. <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Duga nako ma Koana 'o Nyawa Wosilaha-laha gu'una woboa, ge'ena komoiwa yosido-dogumu 'awi 'asali! Ma ne'ena ngone panako 'o nyawa nu'una 'awi 'asali.&gt;&gt;<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Ge'enaka de gee 'o Yesus wodotoko ma gu-gudaioka ma Jou 'awi Woaka de wosigasoko waamo-amokie wongose 'ato, &lt;&lt;Ngini nianako ngoi ne'ena ma kia, de 'ai 'asali kiano? Ngaro koge'ena ma ngoi toboa ge'ena ko to ngoiwa ma sirete 'ai mau. 'Una gee woloa-loa de salingou powingaku-ngaku woisulokino. Ma ngini kowininakowa 'unaka gee. <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />Ngoi towinako 'una, sababu ngoi 'ai 'asali 'unano, de 'unau woisulokino.&gt;&gt;<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Ma 'orasi ge'ena 'ona yomau 'o Yesus witagoko, ma komoiwa yomoroini wi'ao, sababu ma 'orasi koya'adonuawasi. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />'O nyawa yoku-kudaioka go'ona manga gudai yongaku 'unaka, de yongose, &lt;&lt;Gee ma Koana 'o Nyawa Wosilaha-laha gu'una woboa, done 'unasi? 'ifoloi 'ikudai wodiai 'o no-nako 'ihera-herangi de 'o nyawa nu'una? Ma rai ko'uwa sababu 'unau ge'ena ma Koana 'o Nyawa Wosilaha-laha.&gt;&gt;<verse eid="JHN 7:31" /></para>
  <para style="s">Yosika'akali ma ngale 'o Yesus witagoko</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />'O Farisioka yamuruo naga yo'isene 'ato naga 'o nyawa yoku-kudaioka go'ona yamuruo naga yomakakasudu yomasikademo ma ngale 'o Yesus, ge'enau so 'o Farisioka de 'o 'imam ma sae-saeke yosuloko ma Jou 'awi Woa ma jo-jaga yamuruo naga yaika 'o Yesus witagoko. <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />'O Yesus wosidemo 'o nyawa yoku-kudaika ge'ena ma Jou 'awi Woaka, &lt;&lt;Ka 'o 'orasi moiou ngoi de de nginiosi. Ge'ena 'ipasa de ngoi 'asa tolio gee woisulo-suloika. <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />Ngini 'asa ninonu ngoi, ma konimakewau, sababu ngini konia'akunuwa niaika 'o ngiika gee kiaka ngoi ge'enaka.&gt;&gt;<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Ge'enaka de 'o Yahudioka manga balu-balusu yomakadongose moi de moi, &lt;&lt; 'O nyawa nu'una kiaka wotagi so ngone koidadiwa powimake? Bolo 'una womau wotagi 'o Yahudi ma nyawaka gee yogogere 'o daeraa 'ireguoka naga 'o Yunanioka, de wakidotoko 'o Yunani ma nyawa? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />'Okia 'awi dumutu wongose 'ato dua ngone powinonu ma kopowimakewau, de ngone koidadiwa paika gee kiaka naga 'una womanoa?&gt;&gt;<verse eid="JHN 7:36" /></para>
  <para style="s">'O 'akere gee 'o nyawa 'inasi'ahu-'ahu</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />'O rame-rame ge'ena ma wange ma du-du'uruokau, ge'ena la 'o wange gee 'ifoloiosi yosilamo-lamo, 'o Yesus woma'okode ma Jou 'awi Woa ma dodaka de wosigasoko wongose 'ato, &lt;&lt; 'O nyawa gee manga kibiti 'idudu-dudungu, yotagino ngoino la 'o 'akere yo'okere. <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />Gedagee yongaku-ngaku ngoino, 'o Buku 'Itebi-tebinoka naga 'isitulisuku konee: &lt;Manga singina ma dodano doka 'o 'akere gee 'o nyawa 'inasi'ahu-'ahu 'i'uisi 'isasu-sasuru.&gt; &gt;&gt; (<verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />'O Yesus wobi-bicara ma ngale 'o Ngomasa 'Itebi-tebini, gee dua 'imanoa 'o nyawaka gee yongaku-ngaku 'unaka. Sababu ma 'orasi ge'ena 'o Ngomasa 'Itebi-tebini koyakikulawasi; ngano 'o Yesus kowosongenuawasi de kowisitedenuawasi.)<verse eid="JHN 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />'O nyawa manga gudai yo'isenoka 'okia naga 'o Yesus wongose, de munuka kayongosekau, &lt;&lt; 'O nyawa nu'una ma raiokau 'o Nabii gee ma Jo'oungu ma Dutu wojajiokau 'ato dua woboa!&gt;&gt;<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Munukali yongose 'ato, &lt;&lt;Nu'una ma Koana 'o Nyawa Wosilaha-laha!&gt;&gt;</para>
  <para style="p" vid="JHN 7:41">Ma munukali yongose 'ato, &lt;&lt;Tei, ma Koana 'o Nyawa Wosilaha-laha de 'awi 'asali 'o Galileano? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Sababu naga 'o Buku 'Itebi-tebinoka 'isitulisuku 'ato ma Koana 'o Nyawa Wosilaha-laha 'una ge'ena 'awi 'asali 'o Dautino de dua woboa 'o Betlehemuno, ge'ena la 'o Dautu 'awi soanino.&gt;&gt;<note caller="c" style="f"><char style="fr" closed="false">7:42: </char><char style="ft" closed="false">Palega Mi. 5:2.</char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Ma duanguku 'o nyawa-nyawa koyomakadaenuawau moi de moi sababu yatiba-tibangi ma ngale 'o Yesus. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Munuka yomau witagoko, ma komoiwa yomoroini wi'ao.<verse eid="JHN 7:44" /></para>
  <para style="s">'O Yahudioka manga balu-balusu koyongakuwa 'o Yesusika</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Ma 'orasi ma Jou 'awi Woa ma jo-jaga gee yakisulo-suloko yotagi 'o Yesus witagoko go'ona yoboanoli, 'o 'imam ma sae-saeke de 'o Farisioka go'ona yosano 'onaka, &lt;&lt; 'Ido'oa so kowini'asanowa ne'enano?&gt;&gt;<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Ma Jou 'awi Woa ma jo-jaga go'ona yosango, &lt;&lt;Tei, koma'iwasi 'o nyawa yobi-bicara ma sure 'isoka 'una!&gt;&gt;<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />'O Farisioka go'ona kayongosekau, &lt;&lt;Bolo nginika mita winisilibakau? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Naga done de ma 'enau? to ngone nanga balu-balusu bolo 'o Farisioka yongakuokau 'unaka? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Ma 'o nyawa yoku-kudai no'ona, 'ona koyanakowa 'o Musa 'awi besesongo, de ngaro ka kokiau naga ma 'ona ge'ena ma Jo'oungu ma Dutu wakikorosauokau.&gt;&gt;<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />'O Farisioka wimoi ge'ena la 'o Nikodemus gee ma moi woboa 'o Yesusino. 'Una kawongosekau 'o Farisi ma nyawa 'ireguka gee, <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />&lt;&lt;Moteke nanga 'agama ma besesongo, koidadiwa pakihukumu 'o nyawa moi nako kopo'isenuawasi 'okia yongose de manga parakara kopalega ma diaiwasi.&gt;&gt;<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />'Ona yosango, &lt;&lt;Ngona mita 'o Galileano? Kanalega ma diai bato 'o Buku 'Itebi-tebini! Ngona 'asa namake 'o nabii koi'iwa ma 'asali 'o Galileano!&gt;&gt;</para>
  <para style="s" vid="JHN 7:52">'O ngeweka mimoi misidamake mosongou</para>
  <para style="p" vid="JHN 7:52">[<verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />Ge'enaka de 'o nyawa yoodumu yokokilio moi-moi manga woaka.]<verse eid="JHN 7:53" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Ma 'o Yesus 'una wotagi 'o Zaitun ma gigiede. <figure style="fig" file="HK00351.pcx" size="span" ref="(8:1)">'O Zaitun ma gigie</figure> <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Ma bibinoka 'o ngoru-ngorumika 'una wotagioli ma Jou 'awi Woaka, de 'o nyawa manga gudai yaika 'unaka. 'O Yesus wogogeruku de womulaenge wakidotoko. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Ma 'orasi ge'ena 'o 'agamaka yodoto-dotoko de 'o Farisioka misidamake 'o ngeweka mimoi mosongou so mi'asa 'o Yesusika. 'Ona yosuloko 'o ngeweka gumuna moma'okode manga sigoronaka, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />Ge'enaka de kayongosekau 'o Yesusika, &lt;&lt; 'Aba Guru, 'o ngeweka numuna misidamake mosongou yomasi'iduoka de 'o nyawa manga rokata. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />'O Musa 'awi besesongoka naga 'o 'atorangi konaneda, nako 'o ngeweka koge'ena ge'ena salingou yakiteto sigado yakisongene. Ne'ena kokia moteke to ngona 'Aba 'ani di-dibangi?&gt;&gt; <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />'Ona yosano koge'ena ma ngale yomau witaili, la 'ona 'idadi wisisala. Ma 'o Yesus kawogogere de womakuduruku de wotuli-tulisi 'o tonauku de 'awi ra-raga. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Gee 'ona yosano kayogegotokau, de 'awi saeke wamomiki so kawongosekau 'onaka, &lt;&lt;Nginioka naga gee nago'ona yomamaoku manga sowono koi'iwa, madaka la 'onasi 'isira miteto munaka.&gt;&gt; <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Ge'ena 'iduanga de 'o Yesus womakudurukoli de wotuli-tulisi 'o tonauku. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Gee yo'isenoka 'o Yesus koge'ena wongose, de 'ona moi-moi yomakoki'aikokau ge'enaka, 'ikurue gee yope-pereki. So ma rai ge'enaka ka 'o Yesusou de 'o ngeweka gumuna gee kamoma'okodesi ge'enaka. <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />Ge'enaka de 'o Yesus 'awi saeke wamomikie de wongose 'o ngewekaka gumuna, &lt;&lt; 'Ona yoodumu kiakau? Komoiwa nihukumu?&gt;&gt;<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Muna mosango, &lt;&lt;Ko'uwa 'Aba.&gt;&gt;</para>
  <para style="p" vid="JHN 8:11">Ge'enaka de 'o Yesus wongose, &lt;&lt;Ngoi mita kotonihukumuwa. Ne'ena notagiou de 'uwau 'o sowono nodiaioli.&gt;&gt;<verse eid="JHN 8:11" /></para>
  <para style="s">'O Yesus 'una ge'ena 'o darangi 'o dunia ma nyawaka</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />'O Yesus wobicarali 'o nyawa yoku-kudaika wongose 'ato, &lt;&lt;Ngoi ne'ena 'o darangi 'o dunia ma nyawaka. 'O nyawa gee yomoteke de de ngoi, 'ona 'asa yotagi-tagi ko 'o sakautuokawa, ma to 'ona de manga darangi gee yakisi'asa 'o 'ahu 'ika-kakalika.&gt;&gt;<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />'O Farisioka kayongosekau 'unaka, &lt;&lt;Ne'ena ka ngona ma sirete nomasisakisii ma ngale ngona. Ma 'ani demo ge'ena koitiaiwa de 'o nyawa yakisiliba.&gt;&gt;<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />'O Yesus wosango, &lt;&lt;Ngaro ka ngoi ma sirete tomasisakisii ma ngale ngoi, ma 'ai demo ge'ena 'itiai, sababu ngoi tanako kiano toboa de kiaka totagi. Ngini konianakowa ngoi kiano toboa de kiaka totagi. <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />Ngini niakihukumu 'o nyawa ka de 'o nyawa ma di-dibangi; ngoi komoiwa takihukumu. <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />Ma nako ngoi takihukumu 'o nyawa, 'ai butusangi ge'ena 'itiai, sababu ngoi kotomatengokawa. 'Ai Dea gee woisulo-suloko naga de de ngoi. <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />Naga 'ania besesongo ma bukuoka 'isitulisuku konee: &lt; 'O sakisii gee ma gou-goungu 'itiai ge'ena salingou yamididi, de yamididi go'ona manga demo kaimatero.&gt; <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />Gee miosisa-sakisii ma ngale ngoi ge'ena mimididi, ge'ena la ngoi de 'ai Dea gee woisulo-suloko.&gt;&gt;<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />De 'ona kayongosekau, &lt;&lt; 'Ani Dea gu'una kiaka?&gt;&gt; 'O Yesus wosango, &lt;&lt;Ngini koninakowa ngoi de mita 'ai Dea. Nako ngini ninako ngoi, ma raiokau wininako mita 'ai Dea.&gt;&gt;<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Ge'ena 'iodumu 'o Yesus wosidemo ma 'orasi 'una wodotoko ma Jou 'awi Woaka 'o sadakaa ma peti ma dateoka. Ma komoiwa witagoko sababu ma 'orasi koya'adonuawasi.<verse eid="JHN 8:20" /></para>
  <para style="s">'O Yesus 'una ge'ena daku 'o sorogaaku</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />'O Yesus kawongosekauoli 'onaka, &lt;&lt;Ngoi 'asa totagi, de ngini ninonu ngoi, ma ngini 'asa niosongene nia sowono ma sigoronaka sababu konimaogoruwa 'o sowono niodiai. Kiaka naga ngoi totagi, ngini konia'akunuwa niaika.&gt;&gt;<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />So 'O Yahudioka manga balu-balusu kayongosekau, &lt;&lt;Poilia 'una womau womaso-songene, sababu 'una wongose 'ato, &lt; 'O ngii gee kiaka ngoi totagi, ngini konia'akunuwa niaika.&gt; &gt;&gt;<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Ngini nia 'asali 'o duniano, ma ngoi dakuuku 'o sorogaaku. Ngini 'o dunia ma mau-mau niparetano ma ngoi 'o sorogaa ma mau-mau 'iparetano. <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />Ge'enau ma sababu so kangano tongose 'ato, dua niosongene sababu koniamadawa 'ania sowono. De ma goungu dua niosongene 'ania so-sowono ma sigoronaka, nako koniongakuwa 'ato ngoi ne'ena 'una gee wisironga &lt;NGOI NAGA&gt;.&gt;&gt;<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />De 'ona yosano, &lt;&lt;Ngona ne'ena doka ma kia?&gt;&gt;</para>
  <para style="p" vid="JHN 8:25">'O Yesus wosango, &lt;&lt;Tei! Ge'ena tinisidemokau kamadi-disirakasi! <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />'O gudaiosi naga 'idadi tinisidemo de 'o gudaiosi 'idadi tinisisala. Ma 'una gee woisulo-suloko ge'ena ma gou-goungu 'idadi powingaku, de ngoi tosihabari 'o duniaka, 'okia naga gee to'isenino 'unano.&gt;&gt;<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />'Ona koyasahewa 'ato 'una wobi-bicara ge'ena ma dumutu ma Dea. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Ge'enau so 'o Yesus kawongosekau 'onaka, &lt;&lt;Dua gee ngoi 'o Nyawa ma Ngowaka nisitedenokau 'o salipoka, 'asa de nianako 'ato, &lt;Ngoi ge'ena 'unau gee 'isironga: NGOI NAGA&gt;, de ngini 'asa nianako 'ato koi'iwa tadiai moteke ka to ngoi 'ai mau ma sirete. Ngoi tositotara duga ka 'okia naga gee 'ai Dea woisidoto-dotokino. <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />De 'una woisulo-suloko gee, naga de de ngoi. 'Una koma'iwa woimadaka tomatengoka, sababu ngoi kaitaurika tadiai 'okia naga gee 'awi singina yasanangi.&gt;&gt;<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />'O Yesus wosidemoka ge'ena 'iodumu, de manga gudai yongaku 'unaka.<verse eid="JHN 8:30" /></para>
  <para style="s">'O nyawa gee koyoyongo-yongosuawau de gee yoyongo-yongosi</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Ge'enaka de 'o Yesus kawongosekau 'o Yahudi ma nyawaka gee yongaku-ngakuokau 'unaka, &lt;&lt;Nako ngini nio'ahu moteke 'ai do-dotoko, ngini ma gou-goungu 'ai do-domoteke. <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />So ngini 'asa nianako 'okia gee 'iti-tiai ma Jo'oungu ma Dutuno, de ge'enau so ngini ko 'o yongosuawau.&gt;&gt;<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />'Ona kayongosekau, &lt;&lt;Ngomi ne'ena 'amia 'asali 'o Abrahamuno. Koma'iwasi ngomi miodadi yongosi nago'onaka naga bato! 'Okia ni dumutu nongose 'ato ngini 'asa nisipidili?&gt;&gt;<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />'O Yesus wongose 'onaka, &lt;&lt; 'Ai demo ne'ena posironga 'itiaioka. 'O nyawa gee 'o sowono yodi-diai, 'ona ge'ena 'o sowono ma yongosi. <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />De wimoi woyongo-yongosi ge'ena 'awi hak 'ita-tatapu koi'iwa 'o woa ma dodaka, ma 'o ngowaka ma dutu ge'ena kaisi'ado-'adonika 'awi hak de ma 'ena. <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />Ge'enau so nako ngoi ma Jo'oungu ma Dutu wi Ngowaka tinisipidili nia sowonoka, ge'ena ngini ma gou-goungu konioyongosikawau. <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />Ma goungu ngoi tanako ngini ne'ena 'ania 'asali 'o Abrahamuno. Ma ngini niomau ngoi nito'oma, sababu niooluku niamoteke 'ai do-dotoko. <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />'Okia naga gee tamake 'ai Deaka, ge'enau tosidemo. Ma ngini niadiai 'okia naga gee to ngini nia dea nidotoika.&gt;&gt;<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />'Ona yosango, &lt;&lt;To ngomi 'amia dea ge'ena 'o Abraham.&gt;&gt;</para>
  <para style="p" vid="JHN 8:39">'O Yesus wongose, &lt;&lt;Nako ma gou-goungu ngini 'o Abraham 'awi ngowa-ngowaka, ma raiokau ngini niadiai 'isoka gee 'o Abraham wadi-diai. <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />Ngoi tinisitotara 'okia naga 'iti-tiai gee ma Jouoka to'isenino, ma ngini niomau ngoi nito'oma. 'O Abraham kowodiaiwa 'isoka koge'ena! <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />Ngini niadiai 'okia naga gee 'ania dea ma sirete yadi-diai.&gt;&gt;</para>
  <para style="p" vid="JHN 8:41">'Ona yosango, &lt;&lt;Ngomi ko 'o mosolesuwa ma ngowaka. To ngomi 'amia dea duga kawomatengoka ge'ena la ma Jo'oungu ma Dutu ma sirete.&gt;&gt;<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Nako ma Jo'oungu ma Dutu ge'ena to ngini nia dea, ma raiokau ngini nisibosono ngoi, sababu ngoi toboa ma Jo'oungu ma Dutuno. Ngoi toboa ko de to ngoiwa ma sirete 'ai mau, ma 'una woisuloko. <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />'Okia ma sababu so koniasahewa 'okia naga gee tosidemo-demo? Sababu ngini niooluku niosigisene 'ai do-dotoko. <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />To ngini 'ania dea ge'ena 'o Tokata ma Koana, de ngini niomau niamoteke to 'ena ma mau. Ka ma sirasi, 'o Tokata ma Koana ge'ena 'ito-to'oma. 'Ena koma'iwa yamoteke 'iti-tiai, sababu 'enaka koi'iwa 'o loa. Nako 'ena 'ieluku, ge'ena yadaene, sababu 'ena ma biasau. 'Ena ge'ena 'ielu-eluku, de 'o sagala ngeluku ma titi. <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />Ma ngano ngoi tositotara 'iti-tiai, so ngini koniongakuwa ngoino. <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />Naga nginioka nago'ona 'idadi yosinyata 'ato ngoi tosowono? Nako tositotara 'iti-tiai, 'ido'oa so ngini koniongakuwa ngoino? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />'O nyawa gee manga 'asali ma Jo'oungu ma Dutuno, ge'ena yosigisene ma Jo'oungu ma Dutu 'awi demo. Ma ngini ko ma Jo'oungu ma Dutunowa, ge'enau so ngini niooluku niosigisene.&gt;&gt;<verse eid="JHN 8:47" /></para>
  <para style="s">'O Abraham kowi'iwasi 'ena 'o Yesus nagau</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />'O Yahudi ma nyawa-nyawa go'ona yosango 'o Yesusika kayongosekau, &lt;&lt;Ma goungu yadaene gee miongose 'ato ngona 'o Samaria ma nyawa gee 'o tokata nidongosamuku!&gt;&gt;<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />'O Yesus wosango, &lt;&lt;Ngoi ko 'o tokatuwa 'idongosamuku. Ngoi towihoromati 'ai Dea, ma ngini konihoromatiwa ngoino. <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />Ngoi kotanonuwa ka ngoi ma sirete 'isitedene. Ma naga wimoi wadiai ma ngale ngoi 'isitedene, de 'unau 'awi butusangi 'iti-tiai. <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />Tinisidemo ne'ena, 'o nyawa gee yamoteke 'ai demo, 'ona koyosongenuawau kaisi'ado-'adonika.&gt;&gt;<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Ge'enaka de 'o Yahudi ma nyawa-nyawa kayongosekau 'o Yesusika, &lt;&lt;Ne'ena ngomi mianako ma gou-goungu ngona 'o tokata nidongosamuku! 'O Abraham ma sirete wosongenokau, koge'enali mita 'o nabii yoodumu. Ma ngona nongose, &lt; 'O nyawa gee yamoteke 'ai demo, 'ona kaisi'ado-'adonika koyosongenuawau.&gt; <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />'O Abraham ma sirete wosongenokau, de 'o nabii mita yokokisongenokau; ngona ne'ena nomamaoku ma kia? 'O Abraham to ngomi mia dea 'una ge'ena 'ifoloi wodaduie de de ngona!&gt;&gt;<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />'O Yesus wosango, &lt;&lt;Nako ngoi tanonu ka ngoi ma sirete 'isiarene, 'o siarene ge'ena ma ngale koi'iwa. Gee woiho-horomati ge'ena la 'ai Dea gee ngini niongose 'ato ma Jo'oungu ma Dutu gee winisuba-suba, <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />'ena momongo kowininakowa 'una. Ma ngoi towinako. Nako ngoi tongose 'ato ngoi kotowinakowa, ge'ena ngoi toelu-eluku 'isoka nginioli. Ngoi towinako 'una de tosingounu 'awi demo. <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />'Ania dea 'o Abraham womorene ma sala gee dua wamake 'ai bo-boa ma wange. De 'una wamakekau de womorene!&gt;&gt;<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Ge'enaka de 'o Yahudi ma nyawa kayongosekau 'o Yesusika, &lt;&lt; 'Ani 'umuru koya'adonuawasi 'o taunu nagi motoa de wonimakekau 'o Abraham?&gt;&gt;<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />'O Yesus wosango, &lt;&lt;Tinisidemo ne'ena: 'O Abraham kowi'iwasi 'ena ngoi nagau.&gt;&gt;<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />Ge'enaka de 'o teto yo'ese la yomau witeto, ma 'o Yesus woma'iunu de womagorakokau ma Jou 'awi Woaka.<verse eid="JHN 8:59" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008 Edit Koreksi Penterjemh: Ning 25-7-2008</para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">'O nyawa worau-rau womasimake sababu 'o Yesus wiriwo</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Ma moi ge'ena gee 'o Yesus wotagi-tagi, de wimake 'o nyawa worau-rau kawosidoboanosi. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />'O Yesus 'awi do-domoteke yosano 'o Yesusika, &lt;&lt; 'Aba Guru, 'ido'oa so 'o nyawa nu'una worau kawosidoboanosi? Poilia 'una ma sirete wosowono bolo 'awi 'esa de wi dea?&gt;&gt;<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />'O Yesus wosango, &lt;&lt; 'Una worau ge'ena ko to 'unawa 'awi sowono de ko wi balusuwa manga sowono, ma 'ena la 'isidumutu ma Jo'oungu ma Dutu 'awi kuasa 'imanarama 'unaka. <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />Ka 'o wangesi ge'ena salingou padiai gee woisulo-suloko 'awi manarama. Sababu nako 'iobirokau ge'ena komoiwau 'idadi yomanarama. <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />Kokia naga ma do'ingo ngoi 'o duniaka, ngoiou tokula-kula 'o darangi 'o nyawaka 'o duniaka.&gt;&gt;<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />'O Yesus koge'ena wongoseka de wakibituku 'o tonaoka, de wosikaruahe 'awi kibiti ge'ena de 'o tonaka deika wosiesaka worau-rau gu'una 'awi akoka, <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />de kawongosekau 'unaka, &lt;&lt;Tagi 'ani biono na'isoko 'o Siloam ma 'akere 'ilupa-lupanginoka.&gt;&gt; 'O Siloam ngone tanu &lt;&lt;Wisulo-suloko&gt;&gt;. So 'o nyawa gu'una wotagi 'awi biono wa'isokoka de wolio 'ena womasimakekau.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />'Awi woa ma sidateke de 'o nyawa gee wimake-make 'ato 'una ge'ena 'o pipi womaga-ga'asoko ma 'orasi 'una kowomasimakewasi, yoodumu kayongosekau, &lt;&lt;Ko nu'unawa? gee biasa wogogerie 'o pipi womaga-ga'asoko?&gt;&gt;<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />Munuka yongose, &lt;&lt;Ma goungu 'unau.&gt;&gt; Ma munukali yongose, &lt;&lt;Kawimodi ma 'isoka 'una.&gt;&gt;</para>
  <para style="p" vid="JHN 9:9">Ma 'o nyawa gu'una ma sirete kawongosekau, &lt;&lt;Ngoiou de!&gt;&gt;<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />'Ona kayongosekau 'unaka, &lt;&lt;Kokia so ngona 'idadi nomasimake?&gt;&gt;<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />'Una wosango, &lt;&lt; 'O nyawa gee 'awi ronga 'o Yesus gu'una 'o tonaka ma eta wapesaoka de wosiesaika 'ai akoka de kawongosekau, &lt;Tagi 'ani biono na'isoko 'o Siloam ma 'akere 'ilupa-lupangoka.&gt; Ge'enaka de ngoi totagi so ta'isokoka 'ai biono, de tomasimakekau.&gt;&gt;<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />De 'ona yosano, &lt;&lt;Kiaka 'o nyawa gu'una?&gt;&gt;</para>
  <para style="p" vid="JHN 9:12">'Una wosango, &lt;&lt;Sinako.&gt;&gt;<verse eid="JHN 9:12" /></para>
  <para style="s">'O Farisioka yalega ma diai kokia worau-rau womasimakekau</para>
  <para style="p">
    <verse number="13-14" style="v" sid="JHN 9:13-14" />Gee 'o Yesus 'o tonaka de 'awi kibiti wosikaruahe ma ngale wosiesaka 'o nyawa worau-rau wi akoka la 'idadi womasimake, ma 'orasi ge'ena Pomaoma-omasa ma Wangeka. So 'o nyawa gee ko kangano wopilo-piloko gu'una wi'asa 'o Farisi ma nyawaka. <verse eid="JHN 9:13-14" /><verse number="15" style="v" sid="JHN 9:15" />'Ona mita yosano 'unaka kokia so 'una 'idadi womasimake. 'Una wosango, &lt;&lt; 'O tonaka de wi kibiti wosikaruaheka de wosiesaika 'ai akoka, ge'enaka de ta'isokoka de tomasimakekau.&gt;&gt;<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />'O Farisioka yamuruo naga kayongosekau, &lt;&lt; 'O nyawa gee worau-rau wisi'ai-'aiki gu'una 'awi 'asali ko ma Jo'oungu ma Dutunowa, sababu 'una kowosikiamoiwa Pomaoma-omasa ma Wange.&gt;&gt;</para>
  <para style="p" vid="JHN 9:16">Ma 'o nyawa 'iregu kayongosekau, &lt;&lt;Kokia 'idadi 'o nyawa gee yosowo-sowono yodiai 'o no-nako 'ihera-herangi 'isoka ne'ena?&gt;&gt; Ge'enaka de 'onaka gee koyomakadaenuawau.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />So ma rai 'o Farisioka go'ona yosanoli 'o nyawaka gee womasimake-makekau gu'una, &lt;&lt;Kokia moteke ngona ma ngale 'una gee wonidiai nomasimakekau?&gt;&gt;</para>
  <para style="p" vid="JHN 9:17">'O nyawa gu'una wosango, &lt;&lt; 'Una 'o nabii moi.&gt;&gt;<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Ma 'o Yahudioka manga balu-balusu go'ona, yooluku yongaku 'ato 'o nyawa gu'una ma gou-goungu worau kawosidoboanosi de ne'ena womasimakekau. Sababu ge'ena yaki'asoko to 'una 'awi balusu, <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />de yosano, &lt;&lt;Ma goungu nu'una to ngini 'ania ngowaka, gee niongose 'ato worau kawosidoboanosi? Kokia so ne'ena 'una womasimakekau?&gt;&gt;<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />'O nyawa gu'una 'awi 'esa de 'awi dea yosango, &lt;&lt;Ma goungu nu'una to ngomi 'amia ngowaka; de ma goungu 'una worau kawosidoboanosi. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Ma kokia so ne'ena 'una womasimakekau, ngomi komiosidongoowa. De nago'ona widiai 'una 'idadi womasimake, ge'ena mita ngomi komiosidongoowa. Ka 'unakau niosano; 'una mita wobalusokau so ka 'una ma kaidadi wosidemo.&gt;&gt; <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />'O nyawa gu'una 'awi 'esa de 'awi dea koge'ena yongose, ngano yakidomodongo 'o Yahudioka manga balu-balusika; sababu 'ona yomaka'aturokau 'ato 'o nyawa gee yongaku 'o Yesus ge'ena la ma Koana 'o Nyawa Wosilaha-laha gu'una, 'ona koidadiwau yowosanga 'o lo-lomu ma woaka ma ngale wisuba ma Jo'oungu ma Dutu. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Ge'enau so 'o nyawa gu'una 'awi 'esa de 'awi dea yongose 'ato, &lt;&lt; 'Una wobalusokau; so ka 'unakau winisano.&gt;&gt;<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Ge'enaka de 'ona wi'asokoli 'o nyawa gee ko kangano worau-rau gu'una, de kayongosekau 'unaka, &lt;&lt;Tagi nosasi 'ato dua nobicara ge'ena ma gou-goungu 'itiai. Ngomi mianako 'o nyawa gu'una wosowo-sowono.&gt;&gt;<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />'O nyawa gu'una wosango, &lt;&lt;Wosowo-sowono bolo ko'uwa, ngoi kotanakowa. Ma 'o ngai moi tanako, ge'ena ma sira ngoi torau, ma ne'ena tomasimakekau.&gt;&gt;<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />Ge'enaka de 'ona yongoseli 'unaka, &lt;&lt; 'Una 'okia wodiai ngonaka? Kokia wonidiai so nomasimake?&gt;&gt;<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />'O nyawa gu'una wosango, &lt;&lt;Tosijaritakau nginika, ma ngini koniosigisenuwa. 'Ido'oa so niomau niosigi'isenoli? Poilia ngini niomau niodadi to 'una 'awi do-domoteke mita?&gt;&gt;<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Ge'enaka de 'ona widoana de mita kayongosekau, &lt;&lt;Ngona to 'una 'awi do-domoteke, ma ngomi to Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Ngomi mianako ma Jo'oungu ma Dutu wobicarakau 'o Musaka, ma 'o nyawa gu'una ngomi komianakowa 'awi 'asali kiano.&gt;&gt;<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />'O nyawa gu'una wosango, &lt;&lt; 'Etei, toherangi ma sala ngini konianakowa 'awi 'asali kiano, 'ena 'una woidiai tomasimakekau. <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Ngone panako ma Jo'oungu ma Dutu kowakisigisenuwa 'o nyawa yosowo-sowono, ma 'ena 'o nyawa gee wisuba-suba, de yamote-moteke 'awi mau. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Ka ma 'orasi 'o dunia 'idadi de 'isikaino, koma'iwasi po'isene naga yodiai 'o nyawa yorau kayosidoboanosi 'idadi yomasimake. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Nako 'o nyawa gu'una ko ma Jo'oungu ma Dutunowa, 'una 'asa kowa'akunuwa 'o no-nako 'ihera-herangi wodiai 'isoka ge'ena.&gt;&gt;<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />'Ona yosango, &lt;&lt; 'Okia? Ngona 'o sowono ni'omanguku kanomasidoboanosi, ngona nomau nodotoko ngomino?&gt;&gt; So 'ikurue ma 'orasi ge'ena 'una wisisupu 'o lo-lomu ma woaka de kowisidabiwau wowosanga 'o lo-lomu ma woaka.<verse eid="JHN 9:34" /></para>
  <para style="s">'O nyawa gee manga dibangi 'ipupuka so koyasahewa ma Jo'oungu ma Dutu 'awi mau</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />'O Yesus wo'isene 'ato 'o nyawa gu'una kowisidabinowau 'o lo-lomu ma woano, de 'una winonu 'o nyawa gu'una de kawongosekau, &lt;&lt;Ngona nongaku? 'o Nyawa ma Ngowakika?&gt;&gt;<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />'O nyawa gu'una wosango, &lt;&lt;Nagu'una ge'ena Jou? Bika noisidemono la ngoi towingaku 'unaka.&gt;&gt;<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />'O Yesus wosango, &lt;&lt;Ngona wonimakekau. 'Una ge'ena ngoiou gee ma 'orasi ne'ena pomabi-bicara.&gt;&gt;<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />'O nyawa gu'una wongose, &lt;&lt;Ngoi tongaku Jou,&gt;&gt; ge'enaka de wosuba 'o Yesus 'awi bionoka.<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />'O Yesus wongose, &lt;&lt;Ngoi toboa 'o duniano ne'ena ma ngale tosidumutu 'o nyawa manga singina kokia; la 'o nyawa yorau-rau yomasimake de 'o nyawa yomasimake-make 'idadi yorau.&gt;&gt;<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />'O Farisioka yamuruo naga ge'enaka dau gee yo'isene 'o Yesus koge'ena wongose, de yosano 'unaka, &lt;&lt; 'Ani dumutu ngomi ne'ena miorau mita?&gt;&gt;<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />'O Yesus wosango, &lt;&lt;Nako ngini niorau, ge'ena konisisowonuwa. Ma ngano ngini niongose 'ato, &lt;Ngomi mimasimake&gt;, ge'ena ma ngale ngini kaniosowonosi.&gt;&gt;<verse eid="JHN 9:41" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008</para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">'O 'ade-'ade 'o domba de ma so-sowohi</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />'O Yesus wongoseli, &lt;&lt;Ne'ena tinisidemo tosigou-gounguku: Nago'ona yowosanga 'o domba<note caller="d" style="f"><char style="fr" closed="false">10:1: </char><char style="ft" closed="false">'O domba ge'ena ma ngale 'o nyawa yongaku-ngaku.</char></note> ma gu-gurungaka la ko ma ngoranikawa yaboa so ka ma hisade yadoa, 'ona ge'ena yotosi-tosiki de yo'ora-'ora. <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />Ma 'o nyawa gee yowosanga yaboa ma ngoranika, 'ona ge'ena 'o domba ma so-sowohi. <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />So ma ngorana ma ja-jaga wakidebelenga 'o ngorana, de ma domba-domba gee 'iisene 'awi 'ilingi wa'asoko to 'ena ma ronga moi-moi de wimoteke watuda wosisupu. <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />Gee ma domba wosikokisupuokau ma gurunga ma dudunoka, de ma domba ma so-sowohi gu'una wotagi wosira-sira, de 'awi domba ge'ena 'ikokimoteke sababu 'awi 'ilingi yanako. <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />Ma de 'o nyawa 'iregu ge'ena dua koimotekuwa so kaiowara, sababu yanako 'ato ko to 'enawa ma so-sowohi 'awi 'ilingi.&gt;&gt;<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />'O Yesus wosijarita 'o 'ade-'ade ge'ena, ma 'ona koyasahewa 'awi dumutu 'okia.<verse eid="JHN 10:6" /></para>
  <para style="s">'O Yesus womasi'ade-'ade 'isoka 'o domba ma so-sowohi yaowa-owa</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />So 'o Yesus wakidongose ma moioli, &lt;&lt;Ne'ena tinisidemo tosigou-gounguku: Ma gou-goungu ngoi ne'ena tomasi'ade-'ade 'o domba ma ngorana. <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />'Iodumu 'o guru ma ngeluku gee ngoi koi'iwasi 'ena 'ona yoboanou de yongose 'ato 'ona ge'ena 'o domba yoso-sowohi, 'ona ge'ena yotosi-tosiki de yo'ora-ora de 'o domba ge'ena koisigisenuwa to 'ona manga 'ilingi. <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />Ngoi ne'ena 'isoka 'o ngorana. Nago'ona yowosanga yoboa ngoino 'asa koyakido'oawa de dua yosupuwosanga la yo'ahu 'isanangi. <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />Yotosi-tosiki yoboa ge'ena duga kayotosiki, yoto'oma, de 'o nyawa yasotumu. Ma ngoi toboa, ma ngale 'o nyawa yamake 'o 'ahu ma dutu, de kokiawa yakisidukurangi.<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />Ngoi ne'ena 'isoka 'o domba ma so-sowohi yaowa-owa. 'O so-sowohi ma owa ge'ena womodeke wosongene ma ngale wariwo 'awi domba-domba. <figure style="fig" file="BK00004.tif" size="span" ref="(10:12)">'O domba ma so-sowohi</figure> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />'O nyawa gee 'o domba wojaga kawisewa, gee ko ma domba ma so-sowohiwa de mita ko ma domba ma dutuwa, 'asa wokokidoowaruku ma domba nako wamake 'o haewani 'iti-tingkai 'iboa. So 'o domba-domba ge'ena 'asa 'o haewani 'iti-tingkai yakaboto de munuka 'iowara 'imati-tingaoka. <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />Wisewa-sewa gu'una kawoowara, sababu 'una womanarama ge'ena kawisewa, so 'una ka ma eta ma kowakalesanguwa ma domba-domba ge'ena. <verse eid="JHN 10:13" /><verse number="14-15" style="v" sid="JHN 10:14-15" />Ngoi ne'ena 'o so-sowohi ma owa. 'Isoka 'ai Dea woinako ngoi de ngoi towinako 'ai Dea, koge'enali mita ngoi tanako 'ai domba, de 'ai domba 'inako ngoi. Ngoi tomodeke tosongene ma ngale tariwo 'ai domba-domba ge'ena. <verse eid="JHN 10:14-15" /><verse number="16" style="v" sid="JHN 10:16" />'Ai domba 'iregu-regu de ma 'enasi mita, ma koisidotodoimuwa de 'o domba ma duonoka ne'ena. 'Ena mita salingou ta'asa de dua 'isigisene 'ai 'ilingi. 'Ena 'asa 'idadi ka 'o duono moi de kawomatengo wasowohi.<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />'Ai Dea woisibosono, sababu ngoi tomodeke tosongene ma ngale dua woisiwangoli. <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />Ngoi 'asa komoiwa moi 'idadi 'ito'oma nako ko ngoiwa ma sirete tomasisarakani. Ngoi tomasisarakani moteke to ngoi 'ai mau ma sirete. Ngoi tokuasa ma ngale tomasisarakani 'iso-songene, de mita tokuasa ma ngale to'ahuoli. Ge'enau to ngoi 'ai manarama 'ai Dea wosuloko tadiai.&gt;&gt;<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Sababu 'o Yesus wobicara koge'ena, so 'o Yahudi ma nyawa yomakaributu. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Manga gudai yongose 'ato, &lt;&lt; 'Una 'o tokata widongosamuku ma de witogosanga! 'Okia ma ngale niosigisene 'unaka?&gt;&gt;<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Ma naga mita yongose, &lt;&lt; 'O nyawa 'o tokata yakidongosamuku ko koge'enawa yobicara! 'O tokata koya'akunuwa 'idiai 'o nyawa yorau-rau yomasimake!&gt;&gt;<verse eid="JHN 10:21" /></para>
  <para style="s">'O Yahudioka 'o Yesus kowisidabinowa</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />'O Yerusalemuoka yodiai ma gu-gudaioka ma Jou 'awi Woa 'Itabisi ma Wange ma Amoko, ma 'orasi ge'ena 'o 'alo ma tepu. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />'O Yesus wokakadagi ma Jo'oungu ma Dutu 'awi Woa ma ginitaroka, gee yosironga 'o Salomo 'awi Surabioka, <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />de 'o Yahudioka yamuruo naga yoboa yomatoomu 'o Yesus wisigilolitino de kayongosekau, &lt;&lt;Sigado muruoka minisimadaka komimasidongoo 'itiaiwa ngona ge'ena nagu'una? Minisidemo nositi-tiaino, nako ngona ma gou-goungu ma Koana 'o Nyawa Wosilaha-laha gu'una.&gt;&gt;<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />'O Yesus wosango, &lt;&lt;Ngoi tosidemokau nginika, ma ngini koniongakuwa. 'O sagala manarama gee 'ai Dea wosulokokau tadiai, 'isinyata ma ngale ngoi. <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />Ngini koniongakuwa sababu ngini ge'ena matero ka to ngoiwa 'ai domba. <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />To ngoi 'ai domba-domba ge'ena 'isigisene 'ai 'ilingi, ngoi takokinako 'ena de 'ena 'imoteke ngoi. <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />Ngoi tokula 'enaka 'o 'ahu 'ika-kakali, de 'ena 'asa kaisi'ado-'adonika koibinasawau. 'Ena 'asa komoiwa moi 'idadi ya'ora to ngoi 'ai giama ma soatoka. <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />'Ai Dea wosisarakaniokau ngoino. De 'una 'ifoloi 'awi kuasa 'iamoko de nago'ona bato so komoiwa moi 'idadi ya'ora 'ai Dea 'awi giama ma soatoka. <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />Ngoi de 'ai Dea ge'ena ka moi.&gt;&gt;<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Ge'enaka de 'o Yahuidoka go'ona 'o teto yomageseli ma ngale 'o Yesusika wisiwako. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Ma 'o Yesus kawongosekau 'onaka, &lt;&lt;Ngini niamakekau ngoi todiai 'o manarama yaowa-owa 'o gudai, gee 'ai Dea wokulakau ngoino. 'Ai manarama 'iodumoka ge'ena, ka'ena ma sababu ngini niomau niteto?&gt;&gt;<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />'O Yahudioka ma nyawa-nyawa go'ona yosango, &lt;&lt;Ma sababu ko ni manaramuwa yaowa-owa ge'ena so ngomi miomau miniteto, ma 'ena sababu ngona wonisiti-tingoono ma Jo'oungu ma Dutu. Ngona 'o nyawa biasa de nomau nomadiai ma Jo'oungu ma Dutu.&gt;&gt;<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Ge'enaka de 'o Yesus wosango, &lt;&lt;Naga nia besesongo ma bukuoka 'isitulisuku ma Jo'oungu ma Dutu wongose konee: &lt;Ngini ge'ena 'o jo'oungu&gt;? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />Ngone panako 'okia naga gee 'itulisuku 'o Buku 'Itebi-tebinoka 'ena ge'ena kaisi'ado-'adonikau. So nako ma Jo'oungu ma Dutu wakisironga &lt; 'o jo'oungu&gt; gee naga yadawo-dawongo 'awi demo, <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />'ido'oa so ngini niongose 'ato ngoi towisiti-tingoono ma Jo'oungu ma Dutu, ma sababu ngoi tongose 'ato ngoi ma Jo'oungu ma Dutu 'awi Ngowaka? 'Ena momongo ngoi 'ai Dea woiirikokau la ka 'una duga towileleani de woisuloko 'o duniano. <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />Nako ngoi kotadiaiwa 'o manarama gee 'ai Dea wokulakau, 'uwa niongaku ngoino. <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />Duga ngano ngoi tadiaiokau, so niongakukau 'okia naga gee ngoi tadiai, ngaro ngini niooluku niongaku ngoino. De ge'enau 'asa ngini nianako de niasahe 'ato 'ai Dea de de ngoi ka moi, de ngoi de 'ai Dea ka moi.&gt;&gt;<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />'Ona yosikadike witagokoli 'o Yesus, duga kowidaenuwasi.<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />'O Yesus wolioli 'o Yordan ma 'akere ma songonasa, gee ma sira 'o Yohanes 'o nyawa wo'osi-'osikoka, de womanoa ge'enaka doka. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />'O nyawa manga gudai yaika 'unaka de yomasikademo kayongosekau, &lt;&lt; 'O Yohanes kowodiaiwa 'o no-nako 'ihera-herangi, ma 'iodumu gee wosidemo-demo ma ngale 'o nyawa nu'una ge'ena yadaene.&gt;&gt; <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Ge'enaka de manga gudai ge'enaka doka yongakuokau 'o Yesusika.<verse eid="JHN 10:42" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">'O Lazarus wosongene</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Ma moi ge'ena wimoi wopanyakeku 'awi ronga 'o Lazarus. 'Una de 'awi bira-biranga ngo Maria de ngo Marta yomanoa 'o Betaniaka. <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />'O ngo Mariau gumuna gee 'o goooro ma bounu yaowa-owa 'o Yesus wi douku modarisi de mosiesaka de 'ami utu. <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />'O Lazarus wopa-panyakeku gu'una 'awi biranga yamididi yobesesongo 'o Yesusika 'ato, &lt;&lt;Jou, 'amia iranga gee wonisiboso-bosono gu'una wopanyake.&gt;&gt;<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />'O Yesus wo'isenoka 'o besesongo ge'ena, de kawongosekau, &lt;&lt; 'O panyake ge'ena dua sigado kowosisongenuwa. Ne'ena 'idadi la ma Jo'oungu ma Dutu wisiarene, de mita ma sababu ge'ena, ma Jo'oungu ma Dutu 'awi Ngowaka mita wisiarene.&gt;&gt;<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />'O Yesus wakisibosono ma sala 'o ngo Marta, ngo Maria, de 'o Lazarus. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Ma gee 'o Yesus wo'isenoka 'ato 'o Lazarus wopanyake, de ka 'una wi singina 'o wange modidiosi kowotagiwasi ge'enaka dau. <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />Ge'ena 'ipasa de wongose 'awi do-domoteika, &lt;&lt;Nou, ngone polioli 'o Yudeaka.&gt;&gt;<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />'Ona yosango, &lt;&lt; 'Aba Guru, 'asa kaipasano 'o Yahudi ma nyawa-nyawa yomau niteto, de ne'ena nomau nogilioli ge'enaka doka?&gt;&gt;<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />De 'o Yesus wongose 'onaka, &lt;&lt; 'O wange moi ma do'ingo 'o takoro mogiooko de modidi. 'O nyawa gee yotagi-tagi 'o wangeka ge'ena koyomasipelekuwa sababu yamake 'o dunia ma darangi. <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />Ma 'o nyawa yotagi-tagi 'o obiruku ge'ena yomasipeleke, sababu 'o darangi koi'iwa 'onaka.&gt;&gt; <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />'O Yesus koge'enau wongose, ge'enaka de wongoseli, &lt;&lt;Nanga manai 'o Lazarus woma'iduokau, ma dua taika de towisimomiki.&gt;&gt;<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />De 'o Yesus 'awi do-domoteke yongose, &lt;&lt;Jou, nako 'o Lazarus kawoma'iduoka ge'ena dua kowido'oawa.&gt;&gt;<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />'O Yesus 'awi dumutu ge'ena 'o Lazarus wosongenukou, duga 'awi do-domoteke 'ona yongose 'o Yesus 'awi dumutu ge'ena kawoma'iduoka. <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />Ge'enau so 'o Yesus wakidongose kawakisiti-tiaikau, wongose 'ato, &lt;&lt; 'O Lazarus wosongenukou. <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />Ma ngoi tomorene mita ma 'orasi wosongene 'ena ngoi koi'iwa kadoka, sababu koge'ena ge'ena 'ifoloi yaowa ma ngale ngini, la ngini 'idadi niongaku ngoino. Nou, ngone potagiou 'o Lazarusika.&gt;&gt;<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />De 'o Tomas gee wisironga mita 'o Sago kawongosekau 'awi ma-manaika 'o Yesus 'awi do-domoteke go'ona, &lt;&lt;Nou ngone pomoteke de de 'una, madaka la ngaro ngone pomasidosongene de de 'una!&gt;&gt;<verse eid="JHN 11:16" /></para>
  <para style="s">'Una gee wosimomi-momiki 'o nyawa yosonge-songenuku de wokula-kula 'o 'ahu</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Gee 'o Yesus wa'adono ge'ena 'o Betaniano 'ena 'o Lazarus 'o obiri soatou wi'otaika 'o bo'osuoka. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />'O Betania ge'ena 'o Yerusalemuoka 'ena koikurutuwa, poilia 'o kilo sa'angesani. <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />'O Yahudioka manga gudai yaino ngo Maria de ngo Martano ma ngale manga singina yosikuata sababu manga iranga wosongene.<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />'O ngo Marta gee mo'isenoka 'o Yesus woboa, de midajai-jai 'ena ngo Maria muna ka 'o woaka. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />'O ngo Marta misoboika 'o Yesus de mongose 'ato, &lt;&lt;Jou, nako 'iso ma 'orasi ge'ena de de ngonaka ne'enaka, ma raiokau 'ai iranga gu'una kowosongenuwa. <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Duga ne'ena ma 'orasi ngoi tanako, 'okia bato Jou ngona noga'asoko ma Jo'oungu ma Dutude, ge'ena 'asa wonikula.&gt;&gt;<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />'O Yesus wongose 'o ngo Martaka, &lt;&lt; 'Ani iranga 'asa womomikoli.&gt;&gt;<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />'O ngo Marta mosango, &lt;&lt;Ia ngoi tanakokau 'o Lazarus dua womomikoli gee ma 'orasi yosonge-songenoka yakisimomiki 'o dunia ma do-dogumoka.&gt;&gt;<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />De 'o Yesus wongoseli 'o ngo Martaka, &lt;&lt;Ngoi ne'ena 'o nyawa yosonge-songenuku takisimomi-momiki de takikula 'o 'ahu 'ika-kakali. 'O nyawa gee yongaku-ngaku ngoino ngaro yosongenukou ma dua yowangoli. <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />De 'o nyawa yowango-wango gee yongaku-ngaku ngoino, 'ona 'asa kaisi'ado-'adonika koyomakati-tingakuawau de ma Jo'oungu ma Dutu. Ngona nongaku ge'ena?&gt;&gt;<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Ngo Marta mosango, &lt;&lt;Ia Jou, ma gou-goungu ngoi tongaku ngona ge'ena ma Jo'oungu ma Dutu 'awi Ngowaka, ma Koana 'o Nyawa Wosilaha-laha gee ma Jo'oungu ma Dutu wojajiokau 'ato dua noboa 'o duniano ne'ena.&gt;&gt;<verse eid="JHN 11:27" /></para>
  <para style="s">'O Yesus wo'ari</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />'O ngo Marta mongoseka koge'ena, de motagi mi'ese ngo Maria to muna 'ami 'esa moi gumuna, de misudu munaka mongose 'ato, &lt;&lt; 'O 'Aba Guru naga 'una, 'una wongose 'ato naikasi.&gt;&gt; <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Ngo Maria kamo'isenoka ge'ena, de mosijai-jai momomiki, so motagi 'o Yesusika. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Ma 'orasi ge'ena 'o Yesus kowa'adonuawasi 'o soanino so ka gee 'o ngo Marta misobo-sobokokasi. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />'O Yahudi ma nyawa gee ngo Maria mi woaka yaino mi singina yosikua-kuata, mimake ngo Maria mosupu de motagi momatai-taiti so miriniiki, sababu 'ona yongose 'o bo'osuika mosikaika moto-tora.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />So gee ngo Maria ma'adonika 'o Yesusoka de motalibukuku wi bionoka de kamongosekau, &lt;&lt;Jou, tei nako 'iso ma 'orasi ge'ena ngona ne'enaka, ma raiokau 'ai iranga kowosongenuwa.&gt;&gt;<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Gee 'o Yesus mimake 'o ngo Maria moto-tora, de 'o Yahudioka gee ngo Maria mimote-motekino mita yoto-tora, de 'awi singina 'isusa de posironga wobalisaka, <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />so wosano 'onaka, &lt;&lt;Kiakau wininoaku?&gt;&gt;</para>
  <para style="p" vid="JHN 11:34">'Ona yosango, &lt;&lt;Jou, nou 'awi bo'osuku nalega.&gt;&gt;<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Ge'enaka de 'o Yesus wo'ari. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />So 'o Yahudi ma nyawa gee kayongosekau, &lt;&lt; Sioko ee, posironga de wisibosonoka 'o Lazarusika!&gt;&gt;<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Duga ge'enaka dau munuka yomakadongose 'ato, &lt;&lt; 'Unau ge'ena 'o nyawa yorau-rau wakidiai 'idadi yomasimake, de 'ido'oa so kowosi'aikuwa 'o Lazarus 'awi panyake la 'uwa wosongene?&gt;&gt;<verse eid="JHN 11:37" /></para>
  <para style="s">'O Lazarus wisiwangoli</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />'O Yesus 'awi singina posironga de 'isusakauoli, so wotagi 'o bo'osuika. 'O bo'osuku ge'ena 'o teto ya'aruika de 'o teto 'iamo-amoko yositamunika.<verse eid="JHN 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 11:39" />De 'o Yesus kawongosekau, &lt;&lt;Niatuluruka ma teto ge'ena.&gt;&gt; De ngo Marta 'o Lazarus ma biranga gumuna mosango, &lt;&lt; 'Etei Jou, 'una wi wange soatou 'o bo'osuku ma dodaka, so ma raiokau wobounukou.&gt;&gt;<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />'O Yesus kawaporoongie wongose ngo Martaka, &lt;&lt; Ee Marta, tonisidemokau bolo: Nako ngona nongaku, 'asa namake ma Jo'oungu ma Dutu 'awi kuasa posironga ma amoko.&gt;&gt; <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />So 'ona yatuluru ma teto ge'ena. Ge'enaka de 'o Yesus womatagade 'o diwangie de kawongosekau, &lt;&lt;Kasamaowa 'Aba, sababu ngona nosigisenokau 'ai ga-ga'asoko! <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />Ngoi tanakokau ngona kaitaurika noisigisene, ma kone'ena tongose la 'o nyawa 'isigi-gilolitino no'ona gee yo'isene de yongaku ma ngale ngoi ne'ena ngona noisulokino.&gt;&gt; <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />Ka koge'ena wongoseka de wo'asoko wakua-kuatie, &lt;&lt;Lazarus, nou nosupuno!&gt;&gt; <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />So wosonge-songenuku gee wosupu. 'Awi giama de wi dou ka de ma sa-saokasi 'o mosa ya'are-'arese, de wi biono ma lu-luunu ma koi'aikuawasi. 'O Yesus wakisuloko 'o nyawa-nyawaka ge'enaka gee kawongosekau, &lt;&lt; 'Awi sa-sao niasoseka de winimadaka wotagi-tagi!&gt;&gt;<verse eid="JHN 11:44" /></para>
  <para style="s">Yomasigaro 'o Yesus wito'oma</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat. 26:1-5</ref>; <ref loc="MRK 14:1-2">Mrk. 14:1-2</ref>; <ref loc="LUK 22:1-2">Luk. 22:1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />'O Yahudi ma nyawa ngo Mariaka yaino-ino gee manga gudai yongaku 'o Yesusika ma 'orasi yamake 'o Lazarus wosongenukou de wisimomiki. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Duga yamuruo naga ge'enaka dau gee koyongaku-ngakuwa yotagi 'o Farisi ma nyawaka de yositotara 'okia naa gee 'o Yesus wodiaiokau. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />So 'o Farisioka de 'o 'imam ma sae-saeke yomatoomu de 'o 'Agamaka ma Hakimi. 'Ona kayongosekau, &lt;&lt;Ngone salingou 'okia podiai? 'O nyawa nu'una 'o no-nako 'ihera-herangi 'o gudai wodiai! <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Nako ngone kapowisidipidilika kone'ena, 'o nyawa 'iodumu dua yongaku 'unaka, de ma duanguku 'o Romaka manga balu-balusu dua 'inadoboano de yatorouoka ma Jou 'awi Woa de nanga nyawa 'iodumu!&gt;&gt;<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />'Onaka naga wimoi 'awi ronga 'o Kayafas, 'una 'o 'Imam ma Amoko ma taunu ge'ena, kawongosekau, &lt;&lt;Ngini kokiawa nianako. <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Ngini konianakowa 'ato ma ngale 'o kawasa manga laha, 'ifoloi yaowa womatengo wosongene, 'uwa sigado ngone 'o Yahudioka poodumu pobootuku?&gt;&gt; <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />'O Kayafas koge'ena wongose, ge'ena ko to 'unawa ma sirete 'awi singinano ma, ma Jo'oungu ma Dutuno, sababu 'una 'o 'Imam ma Amoko ma taunu ge'ena. So 'una wosidemosira 'ato 'o Yesus 'asa wosongene ma ngale 'o Yahudioka ma nyawa. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />De duga ka 'o Yahudiokawa, ma mita watoomu de wadiai ka moi ma Jo'oungu ma Dutu 'awi ngowa-ngowaka gee kiaka naga bato yomati-tingaika.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />'Ikurue ma wange ge'ena 'o Yahudioka manga balu-balusu yomasikagaro ma ngale 'o Yesus wito'oma. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Ge'enau so 'o Yesus kowomasidumutuawau 'o kawasaka 'o Yahudi ma nyawaka. 'Una woma'aiki ge'enaka dau de wosikaika 'o kotaka gee ma ronga 'o Efraim, 'o tonaka 'ika-kakasa ma datekoka. Ge'enaka dau 'una de 'awi do-domoteke yomanoa.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Ma 'orasi ge'ena 'isoriokau 'o Yahudioka Wakisisupu 'o Mesiroka ma Wange ma Amoko. 'O nyawa 'o soa-soanoka manga gudai yopasakau 'o Yerusalemuka la yadiai manga 'agamaka ma 'adati ma ngale manga singina yatebini, gee ma wange ma amoko ge'ena koya'adonikawasi. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />'Ona winonu 'o Yesus, de gee yomatoomuno ma Jou 'awi Woaka, 'ona yomakadongose moi de moika, &lt;&lt;Kokia to ngini 'ania di-dibangi? Poilia dua 'una kowoboawa 'o wange ma amokoka ne'ena.&gt;&gt; <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />'Ona koge'ena yongose sababu 'o 'imam ma sae-saeke de 'o Farisioka manga pareta yosisupuokau 'ato nago'ona wimake 'o Yesus kiaka naga bato, salingou yosidemo la 'idadi witagoko.<verse eid="JHN 11:57" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">'O ngo Maria 'o goooro ma bounu yaowa-owa mosidarisi 'o Yesus wi douka 'o Betania ma soanoka</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat. 26:6-13</ref>; <ref loc="MRK 14:3-9">Mrk. 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />'O wange butangasi de Wakisisupu ma Wange ma Amoko ya'adono, 'o Yesus wotagi 'o Betaniaka, gee 'o Lazarus womanoa-noaka de ge'enakau 'o Lazarus wosongenuku de 'o Yesus wisimomiki. <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />Ge'enaka doka 'o Yesus wisi'odomo, de ngo Marta makileleani. 'O Lazarus mita yomasido'odomo de 'o woa ma gikiri manga gudaioka de 'o Yesus. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Yo'odomo ma gu-gudaioka de ngo Maria moboa mo'asa 'o goooro ma bounu yaowa-owa ma 'ija 'ihali ma sala ma ronga 'o narwastu, poilia 'o literi ma ngogu. De modarisi 'o Yesus 'awi douku deika mosiesaka de 'ami utu.<note caller="e" style="f"><char style="fr" closed="false">12:3: </char><char style="ft" closed="false">Muna modiai koge'ena ma ngale mihoromati 'o Yesus.</char></note> So ma woa ge'ena ya'omanguku ma bounu 'ena ma sureka ngano ma narwastu ge'ena. <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />Duga 'o Yudas Iskariot 'o Yesus wi do-domoteke wimoi gee dua 'o Yesus wiwukunu kawongosekau, <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />&lt;&lt; 'Ido'oa so ma narwastu ge'ena konawukunuwa ma 'ija 'o pipi saaka 'o ratusu sa'angeka, 'asa de ma pipi nakikula 'o nyawa yosusa-susaka?&gt;&gt; <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />'O Yudas koge'ena wongose ge'ena ma ngale ko 'o nyawa susawa wakikalesangi, ma 'ena sababu 'una ge'ena wotosi-tosiki. 'Una 'ijaga wa'ese 'o do-domoteke manga pipi yalomu-lomuno 'unaka.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Ma 'o Yesus kawongosekau, &lt;&lt;Monimadaka muna modiai koge'ena! Muna modiai kone'ena ma ngale moidudu-duangou ma 'orasi 'ipo'osuku. <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />'O nyawa yosusa-susa kaitaurika naga de de ngini, ma dua ngoi koitaurikawa naga de de ngini.&gt;&gt;<verse eid="JHN 12:8" /></para>
  <para style="s">'O 'imam ma sae-saeke yomasikagaro ma ngale 'o Lazarus wito'oma</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />'O Yahudioka manga gudai yo'isene 'ato 'o Yesus doka 'o Betaniaka, so 'ona yotagi dokaika. 'Ona yaika ge'ena manga dumutu duga ka 'o Yesusikawa, ma mita yomau wimake 'o Lazarus gee wosongenuku de 'o Yesus wisimomikieu. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Ge'enau so 'o 'imam ma sae-saeke yomau wito'oma 'o Lazarus mita. <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />Ngano ma sababu 'unau so 'o Yahudi ma nyawa manga gudai yakimadakau manga balusu go'ona de yongakuoku 'o Yesususika.<verse eid="JHN 12:11" /></para>
  <para style="s">'O Yesus wowosama 'o Yerusalemuka de wisiduono</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat. 21:1-11</ref>; <ref loc="MRK 11:1-11">Mrk. 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk. 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ma bibinoka 'o nyawa yoku-kudai gee yoboanou ma ngale Wakisisupu ma Wange ma Amoko yodiai, yo'isene 'ato 'o Yesus naga wi do-dagi ma sigoronakau 'awi dumutu 'o Yerusalemuno. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />So 'ona yo'ese 'o palem<note caller="f" style="f"><char style="fr" closed="false">12:13: </char><char style="ft" closed="false">'O palem ge'ena 'isoka 'o 'igono bolo 'isoka 'o daluku.</char></note> ma soka-soka de yotagi wisiduono de yosibeto-betongo, &lt;&lt; 'Alele! Nou, powisiarene ma Jo'oungu ma Dutu! Tanu ma Jo'oungu ma Dutu wisibarakati 'una gee woboa de ma Jou 'awi kuasa. Tanu wisibarakati 'o Israeloka nanga Koana!&gt;&gt;<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />'O Yesus wamake 'o keledai ma gooka 'o ngai moi, de ge'enaku woparene. So 'idadiokau gee 'isilefoku 'o Buku 'Itebi-tebinoka konee,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />&lt;&lt; 'Uwa nimodongo, ngini 'o Sion ma nyawa!</para>
  <para style="q1" vid="JHN 12:15">Winimake 'ania Koana woboa,</para>
  <para style="q2" vid="JHN 12:15">woparenuku 'o keledai ma gooka moi!&gt;&gt;<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />Ma 'orasi ge'ena 'o Yesus 'awi do-domoteke koyasahewasi 'iodumu ge'ena. Ma gee 'o Yesus wisiwangodeli ma ngale wisitedene, 'asa de 'ona yonganonie 'ato gee 'o nyawa yokakadiai 'unaka ge'ena 'isilefokau 'o Buku 'Itebi-tebinoka ma ngale 'una.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />'O nyawa gee yoboa-boano ma 'orasi 'o Yesus 'o Lazarus wosongenuku de wisimomiki wi'asoko wosupu 'o bo'osukino, 'ona koyomaogoruwa yosijarita ma ngale 'o Lazarus wisiwango. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Ge'enau so 'o nyawa yoku-kudai go'ona yotagi 'o Yesus wijai-jai. Sababu 'ona yo'isene 'ato 'unau wodiai 'o no-nako 'ihera-herangi ge'ena. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />So 'o Farisioka moi de moi yomakadongose 'ato, &lt;&lt; 'Etei, ngone kopomado-do'oawa! Kaniamake 'o nyawa posironga manga gudai yotagi wimoteke 'una!&gt;&gt;<verse eid="JHN 12:19" /></para>
  <para style="s">'O Yunanioka yamuruo naga yomau yomakamake de 'o Yesus</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />'O nyawa gee yotagi-tagi 'o Yerusalemuka ma ngale yamoteke 'o lo-lomu gee ma 'orasi 'o wange ma amoko ma rame-rame ge'ena, ge'ena dau manga sigoronaka de ma 'ena mita 'o Yunanioka yamuruo naga. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />'Ona yaika 'o Filipusika de kayongosekau, &lt;&lt; 'Esa moi, nako 'idadi de ngomi miomau mimakamake de 'o Yesus.&gt;&gt; ('O Filipus 'awi 'asali 'o Betsaidano 'o Galilea ma daeraaka.)<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />So 'o Filipus waika wosidemo 'o Andreasika, deika 'ona yamididi yositotara 'o Yesusika. <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />'O Yesus kawongosekau 'onaka, &lt;&lt;Ma 'orasi ya'adonokau 'o Nyawa ma Ngowaka ma Jo'oungu ma Dutu wisitedene. <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />Ma gou-goungu 'itiai 'ai demo ne'ena: Nako 'o bira 'o muhi moi koyatudukuwa 'o tonauku de koisongenuwa, dua 'ena ka koge'ena ka 'o muhi<note caller="g" style="f"><char style="fr" closed="false">12:24: </char><char style="ft" closed="false">'O muhi moi ge'ena ma ngai 'o ngai moi.</char></note> moioka. Ma nako 'o bira ma muhi ge'ena 'isongene, dua ma hasili 'isupuno ma amooka. <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />'O nyawa gee manga 'ahu yasingina, 'asa manga 'ahu 'iisanga. Ma 'o nyawa gee koyosinginawa manga 'ahu 'o duniaka ne'ena, 'asa yapaliara ma ngale yo'ahu kaisi'ado-'adonika. <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />'O nyawa gee yomau 'ileleani ngoi, salingou 'imoteke ngoi, la 'ai ro-riwo 'idadi de de ngoi kiaka naga ngoi taika. 'O nyawa gee 'ileleani ngoi, 'asa 'ai Dea wakihoromati.&gt;&gt;<verse eid="JHN 12:26" /></para>
  <para style="s">'O Yesus wosidemo 'ato dua wosongene</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />&lt;&lt;Tei, 'ai singina 'isusa. 'Okia salingou tongose? Salingou tongose? 'ato, &lt; 'Aba, noisiresene 'o sangisara ne'ena&gt;? Ma ngano salingou tamoku 'o sangisara ne'ena, so ngoi toboa 'o duniano. <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />'Aba, tanu nosidumutu 'ani kumati 'o nyawaka!&gt;&gt; So 'o 'ilingi daku 'o sorogaaku 'ingose 'ato, &lt;&lt;Ngoi tosidumutokau 'ai kumati, de 'asa tosidumutoli.&gt;&gt;<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />'O nyawa yoku-kudai ge'enaka gee yo'isene 'o 'ilingi ge'ena de kayongosekau, &lt;&lt;Ge'ena 'o duturu ma 'ilingi!&gt;&gt; Ma naga mita yongose, &lt;&lt;Ko'uwa, ge'ena 'o mala'ekati 'ibicara 'unaka!&gt;&gt;<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt; 'O 'ilingi gee po'ise-'isene ge'ena ma dumutu ko to ngoiwa 'ai laha, ma 'ena to ngini. <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />Ne'ena ma 'orasi ya'adonokau ma Jo'oungu ma Dutu wahakimi 'o nyawa 'o duniaka, de ma 'orasi ne'ena 'o dunia yapa-paretano ge'ena la 'o Tokata ma Koana koimado-do'oawau. <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />Ma ngoi ne'ena dua gee 'isitedenoka 'o salipoka de 'isidoaka 'o sorogaade, ngoi 'asa takitoomu 'o nyawa 'iodumu ngoino.&gt;&gt;<note caller="h" style="f"><char style="fr" closed="false">12:32: </char><char style="ft" closed="false">Bolo ma ngale konee mita: &lt;&lt;Ma ngoi ne'ena dua gee 'isidoaka 'o tonaka ma dekuoka, ngoi 'asa todiai 'o nyawa 'iodumu yoboa ngoino.&gt;&gt;</char></note> <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />'Una koge'ena wongose, ma ngale wosidumutu kokia ma ngekomo dua 'una wosongene.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />'O nyawa yoku-kudai go'ona kayongosekau 'unaka, &lt;&lt;Moteke 'o besesongo ma bukuoka 'isilefoku, ma Koana 'o Nyawa Wosilaha-laha dua wo'ahu kaisi'ado-'adonika. De kokia so ngona nongose 'ato 'o Nyawa ma Ngowaka dua wisidele 'o salipoka? Nagu'una 'o Nyawa ma Ngowaka gu'una?&gt;&gt;<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />'O Yesus wosango, &lt;&lt; 'O darangi ge'ena koito'ingokawa nginioka. So niotagiou ma 'orasi 'o darangi ka de ma 'enasi, la ngini 'uwa nidaene 'o darusu. 'O nyawa gee yotagi-tagi 'o darusoka, koyosikanakowa kiaka yosikaika. <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />Ma 'orasi ngoi naga nginiokasi, ge'ena matero ka 'o darangi naga nginioka. So ngini salingou niongaku ngoino la ngini nio'ahu 'o darangi ma dodaka.&gt;&gt;</para>
  <para style="s" vid="JHN 12:36">'O Yahudioka koyongakuwa 'o Yesusika</para>
  <para style="p" vid="JHN 12:36">'O Yesus wongoseka koge'ena, de womagoraka ge'enaka doka de kowomasidumutuawau 'onaka. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Ngaro 'o gudaiou 'o no-nako 'ihera-herangi 'o Yesus wodiai to 'ona manga bionoka, ma 'ona koyongakuwa 'unaka. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />So ge'ena 'idadiokau 'isoka ma Nabii Yesaya wongosekau konee,</para>
  <para style="q1" vid="JHN 12:38">&lt;&lt;Jou, gee miosiha-habari ge'ena nago'ona yangaku?</para>
  <para style="q1" vid="JHN 12:38">Nago'onaka nosidumutu 'ato ngona 'ifoloi nokuasa?&gt;&gt;<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />'Ona koyongakuwa, sababu 'o Yesaya wongosekau konee mita,</para>
  <para style="q1" vid="JHN 12:39">&lt;&lt;Ma Jo'oungu ma Dutu wongose,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;Ngoi takidiai 'ona</para>
  <para style="q1" vid="JHN 12:40">yopiloko de manga singina 'i'opini;</para>
  <para style="q1" vid="JHN 12:40">la koyomasimakewau,</para>
  <para style="q1" vid="JHN 12:40">de koyomasinakowau.</para>
  <para style="q1" vid="JHN 12:40">La 'ona 'uwa yolioli ngoino,</para>
  <para style="q1" vid="JHN 12:40">la 'uwa takisi'aiki.&gt; &gt;&gt;<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />'O Yesaya koge'ena wongose sababu ma sira 'o mo-make ma sigoronaka wamakekau 'o Yesus 'asa wisitedene so wobi-bicara ma ngale 'una.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Ngaro koge'ena, ma manga gudai mita yongaku 'o Yesusika, naga 'o Yahudioka manga balu-balusu sona. Ma 'ona koyomoroinuwa yosikawasa, sababu 'ona yakimodongo 'uwa sigado 'o Farisioka koyosidabiwau yowosanga ma Jou 'awi Woaka. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />'O Farisioka 'ona ge'ena 'ifoloi yoduaka ka 'o nyawa yakihoromati 'onaka positero ma Jo'oungu ma Dutu wakihoromati.<verse eid="JHN 12:43" /></para>
  <para style="s">'O Yesus 'awi demo-demo 'asa 'idadi hakimi</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Ge'enaka de 'o Yesus wosigasoko wongose 'ato, &lt;&lt; 'O nyawa gee yongaku-ngaku ngoino, 'ona ge'ena yongaku ka ngoinowa duga, ma wingaku 'unaka gee woisulo-suloko. <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />De 'o nyawa gee 'imakekau ngoi, ge'ena wimakekau 'una gee woisulo-suloko. <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />Ngoi toboa 'o duniano ne'ena ge'ena todadi 'o darangi, la 'o nyawa 'iodumu gee yongaku-ngaku ngoino 'uwa yogogere 'o darusoka. <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />De 'o nyawa gee yo'ise-'isene 'ai do-dotoko ma koyodomotekuwa, ge'ena ko ngoiwa takihukumu. Sababu ngoi toboa ma ngale kotahukumuwa 'o nyawa 'o duniaka ne'ena, ma 'ena takisilaha. <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />'O nyawa gee koidawonguwa de koyosigisenuwa 'ai demo, naga de ma 'enau gee yakihaki-hakimi. 'O demo gee tositota-totarokau, ge'enau dua yakihakimi 'o dunia ma do-dogumoka. <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />Sababu gee tosibi-bicara ge'ena duga ka to ngoiwa ma sirete 'ai mau. Ge'ena 'ai Dea gee woisulo-suloko wopareta 'okia naga salingou tangose moteke ka to 'una 'awi mau. <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />De ngoi tanako 'awi pareta ge'ena nisi'asa 'o 'ahu 'ika-kakalika. So ngoi tositotara moteke 'ai Dea woisidemokau.&gt;&gt;<verse eid="JHN 12:50" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008 Edit Koreksian Penterjemah: 25-7-2008</para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">'O Yesus 'awi do-domoteke manga dou wa'isoko</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />'O wange moiosi de Wakisisupu ma Wange ma Amoko, 'o Yesus wanakokau 'ato ma 'orasi ya'adonokau 'una wamada 'o dunia ne'ena ma ngale wolio ma Deade. 'Una wakisibosono 'o nyawa-nyawa gee yodadiokau to 'una 'awi do-domoteke de tatapu wakisibosono sigado ma do-dogumika.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />'O Yesus de 'awi do-domoteke yo'odomo ma gu-gudaioka 'o obiruku, de 'o Tokata ma Koana ma niati 'ito-torou 'isingosangokau 'o Yudas 'awi singina ma dodaka, ma ngale 'o Yesus wiwukunu. 'O Yudas gu'una 'o Simon Iskariot 'awi ngowaka. <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />'O Yesus wanakokau 'ato 'awi Dea wosito-togumokau 'o pareta 'iodumu 'unaka. De 'una wanakokau mita 'una ge'ena ma Jo'oungu ma Dutuoka de waino, de dua wolioli ma Jo'oungu ma Dutuka. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Sababu ge'ena 'una woma'oko de wa'aiki 'awi juba, de 'awi handuk womasipusukino 'awi goronano. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Ge'enaka de 'o 'akere wodarisuku 'o giama ma gi-gisoko ma ngiioka, de womasitero 'isoka 'o gilaongo so 'awi do-domoteke manga dou wa'isoko. Wa'isokoka 'asa de wosi'ikiri de 'o handuk gee 'awi goronaka wosipusu-pusukino. <figure style="fig" file="LB00320.tif" size="span" ref="(13:6)">'O Yahudioka ma sira nako yo'odomo ge'ena kone'ena</figure> <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Gee wototara 'o Simon Petrusika, de 'o Simon Petrus kawongosekau, &lt;&lt; 'Etei Jou, 'ato ngona de 'ai dou na'isoko?&gt;&gt;<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />'O Yesus wosango, &lt;&lt; 'Okia naga todiai ne'ena, ma 'orasi ne'ena ngona konasahewasi, ma dua 'asa nasahe.&gt;&gt;<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />'O Petrus wongose 'o Yesusika, &lt;&lt; 'Uwa Jou! Ka ma eta ma koidadiwa na'isoko 'ai dou!&gt;&gt;</para>
  <para style="p" vid="JHN 13:8">Ma 'o Yesus wosango, &lt;&lt;Nako kotoni'isokuwa, ge'ena ngona de de ngoi kopomarimoiwa.&gt;&gt;<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />'O Simon Petrus kawongosekau, &lt;&lt;Jou, nako koge'ena, de 'uwa duga ka 'ai dou, ma 'ai giama de 'ai saeke mita!&gt;&gt;<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />'O Yesus wongose 'o Petrusika, &lt;&lt; 'O nyawa gee yoma'osikokau, ge'ena manga roese 'iodumu 'ikokitebinokau. 'Ona koiparaluuwau yaki'osikoli; duga ka manga douou gee yotagi de 'imedirokau, ge'ena salingou ya'isoko. Ngini ne'ena niotebinokau, duga konioodumuwa.&gt;&gt; (<verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />'O Yesus wanakokau nagu'una dua wiwukunu. Ge'enau so wongose 'ato, &lt;&lt;Ngini ne'ena niotebinokau, ma konioodumuwa.&gt;&gt;)<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />'O Yesus wakoki'isokoka manga dou, de womasinoali 'awi juba 'asa de woliokali wi rioka. Ge'enaka de kawongosekau 'onaka, &lt;&lt;Niasahe? 'okia naga gee 'asa katodiaioka nginika? <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />Ngini nio'asoko ngoino 'Aba Guru de ma Jou. De ge'ena ma goungu. <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />Nako ngoi to ngini 'ania Jou de nia Guru ma ta'isokokau 'ania dou, ngini mita salingou 'ania dou nimakadigisoko. <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />Ngoi tosidumutokau nginika 'okia salingou niadiai, la ngini mita niadiai 'isoka kokia naga gee ngoi tadi-diai nginika. <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />'Ai demo ne'ena ma gou-goungu 'itiai: 'O yongosi koyofoloidewa de manga tuangi. De 'o su-suloko koyofoloidewa de gee wosulo-suloko. <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />Ne'ena ngini nianakokau 'iodumu ge'ena. Niosanangioka ngini nako niamoteke.<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />'Okia naga gee ngoi tosidemo ne'ena, ge'ena ma ngale ko ngini nioodumuwa. Ngoi takinako 'iti-tiai nago'ona gee takiirikokau. Ma 'okia naga gee 'isilefokau 'o Buku 'Itebi-tebinoka salingou 'idadi, ge'ena la: &lt; 'O nyawa wimoi gee mimasido'odomo de de ngoi, 'asa woiwukunu.&gt; <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />Ge'ena koidadiwasi 'ena tinisitotarokau nginika ma 'orasi ne'ena, la dua gee 'idadi, ngini 'asa niongaku 'ato, &lt;Ngoi ne'ena 'una gee 'isironga NGOI NAGA.&gt; <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />Ma gou-goungu 'itiai 'ai demo ne'ena: Nago'ona yakidawongo 'o nyawa gee takisulo-suloko, ge'ena 'idawongo ngoi. De nago'ona 'idawongo ngoi, ge'ena widawongo 'una gee woisulo-suloko.&gt;&gt;<verse eid="JHN 13:20" /></para>
  <para style="s">'O Yesus wosidemosira 'ato 'una dua wiwukunu</para>
  <para style="r">(<ref loc="MAT 26:20-25">Mat. 26:20-25</ref>; <ref loc="MRK 14:17-21">Mrk. 14:17-21</ref>; <ref loc="LUK 22:21-23">Luk. 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />'O Yesus koge'ena wongoseka, de 'awi singina 'isusa ma sala. Ge'enaka de 'una kawongosekau, &lt;&lt;Ma gou-goungu 'itiai 'ai demo ne'ena: Wimoi naga nginioka gee dua woiwukunu.&gt;&gt;<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />'Awi do-domoteke yomakaungini moi de moi de yoherangi ma sala, sababu 'ona koyanakowa 'awi dumutu nagu'unaka. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />'O do-domoteke gee 'o Yesus wisiboso-bosono de yogiamanai ma sala ge'ena 'o Yesus 'awi dateoka. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />'O Simon Petrus wiakotawi 'unaka, la wosano 'o Yesusika 'ato 'awi dumutu nago'onaka.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />So 'o do-domoteke gu'una womasisori-sorika monga de wosano 'o Yesusika, &lt;&lt;Nagu'una ge'ena Jou?&gt;&gt;<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />'O Yesus wosango, &lt;&lt; 'O nyawa gee towikula 'o roti todawaruoka 'o sawokuku, 'unau ge'ena.&gt;&gt; So 'o Yesus wa'ese 'o roti 'o eta moi de wodawaruoka 'o sawouku; deika wokula 'o Yudasika 'o Simon Iskariot 'awi ngowaka. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />'O Yudas wa'eseka 'o roti ge'ena, de 'o Tokata ma Koana 'awi singina yaparetanou. Ge'enaka de 'o Yesus kawongosekau 'o Yudasika, &lt;&lt;Nomatai-taiti nadiai 'okia naga gee nomau nadiai.&gt;&gt; <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Gee yo'odo-'odomo ge'enaka dau komoiwa yasahe 'ido'oa so 'o Yesus koge'ena wongose 'o Yudasika. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Munuka 'ona yongose 'o Yesus wosuloko 'o Yudas 'o kianikia wo'ija ma ngale manga paraluu 'o rame-rameka ge'ena, bolo 'o pipi ma eta wakikula 'o nyawa yosusa-susaka, sababu 'una ge'ena manga pipi ma ga-gao.<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />'O Yudas kawa'eseka 'o roti ge'ena, de kawogila-gilaka wosupu 'ena 'iobirokau.<verse eid="JHN 13:30" /></para>
  <para style="s">'O besesongo ma sungi</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />'O Yudas wopasaka de 'o Yesus kawongosekau, &lt;&lt;Ne'ena ma 'orasi ya'adonokau ngoi 'o Nyawa ma Ngowaka 'isitedene, de ma Jo'oungu ma Dutu wisitedene ma ngekomo ngoi. <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />Nako ma Jo'oungu ma Dutu wisitedene ma ngekomo ngoi, ngoi mita 'asa ma Jo'oungu ma Dutu woisitedene ma ngekomo 'una ma sirete. De ma Jo'oungu ma Dutu 'asa wacobou woisitedene. <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" />Ngini gee matero ka 'ai ngowa-ngowaka, ngoi dua koito'ingowau tomanoa de de ngini. Ngini 'asa ninonu ngoi, ma 'isoka gee tosidemokau 'o Yahudioka manga balu-balusika, koge'enali mita tosidemo nginika, 'o ngii kiaka naga ngoi totagi, ngini konia'akunuwa niaika. <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" />Ngoi tinikulakau 'o besesongo ma sungi ge'ena la, nimasikabosono moi de moi. 'Isoka ngoi tinisibosono ngini, koge'enali mita ngini salingou nimasikabosono. <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />Nako ngini nimasikabosono, 'o nyawa 'iodumu 'asa yanako 'ato ngini ge'ena to ngoi 'ai do-domoteke.&gt;&gt;<verse eid="JHN 13:35" /></para>
  <para style="s">'O Yesus wosidemosira 'ato 'o Petrus dua womasipongono.</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat. 26:31-35</ref>; <ref loc="MRK 14:27-31">Mrk. 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk. 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />'O Simon Petrus wosano 'o Yesusika, &lt;&lt;Jou, kiaka notagi?&gt;&gt; 'O Yesus wosango, &lt;&lt;Kiaka naga ngoi totagi ngona koidadiwa nomoteke ma 'orasi ne'ena. Ma dua ngona 'asa noimoteke ngoi.&gt;&gt;<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />'O Petrus wosanoli, &lt;&lt;Jou, 'ido'oa so ngoi koidadiwa tonimoteke ma 'orasi ne'ena? Ngoi katomodeke tosongene ma ngale ngona Jou!&gt;&gt;<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />'O Yesus wosango, &lt;&lt;Ma goungu? nomodeke nosongene ma ngale ngoi? Nosi-singina, dua 'o namoro koisorenuawasi 'ena nomadidumu ma sa'angeu nongose 'ato konoinakowa!&gt;&gt;<verse eid="JHN 13:38" /></para>
  <para style="rem">Penyunting: Ning 16-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">'O Yesus 'una ge'ena nanga ngekomo posikaika ma Jo'oungu ma Dutuka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />'O Yesus wongose 'awi do-domoteika, &lt;&lt; 'Uwa nia singina 'isusa. Salingou niongaku ma Jo'oungu ma Dutuka de mita ngoino. <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />'Ai Dea 'awi woaka 'o ngii pomanoa-noa 'o gudaioka. Ngoi totagi ge'enaka ma ngale takalari to ngini 'ania ngii. Ngoi ma rai kotinidongosewa nako la ge'ena ko ma gounguwa. <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />'Ania ngii takalari 'iduanga, 'asa tainoli tini'ese, la kiaka naga ngoi, ngini mita ge'enaka. <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />'O ngii kiaka ngoi totagi, ngini niosikanako ma ngekomo.&gt;&gt;<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Ge'enaka de 'o Tomas kawongosekau 'o Yesusika, &lt;&lt;Jou, ngomi komiosidongoowa kiaka notagi, de kokia ngomi miosikanako ma ngekomo?&gt;&gt;<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />De 'o Yesus wosango, &lt;&lt;Ngoi ne'ena 'o ngekomo ma ngale 'o nyawa winako 'itiai ma Jo'oungu ma Dutu, de yamake 'o 'ahu 'ika-kakali. Komoiwa moi 'idadi yaika ma Jo'oungu ma Dutuka, nako ko de de ngoiwa. <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />Nako ngini ninako ngoi, ma raiokau ngini wininako 'ai Dea mita. Ma 'orasi ne'ena ngini wininakokau 'una, de winimakekau.&gt;&gt;<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />So 'o Filipus kawongosekau 'o Yesusika, &lt;&lt;Jou, minisidumutino 'ani Dea ma Jo'oungu ma Dutu gu'una, la ngomi miosanangi.&gt;&gt;<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Ma 'o Yesus wosango, &lt;&lt;Ee Filipus, koge'enau ma do'ingo ngoi de de ngini, de konoinakowasi? 'O nyawa gee 'imakekau ngoi, ge'ena wimakekau 'ai Dea. De kokia so nongose 'ato, &lt;Minisidumutino 'o 'Aba gu'una&gt;? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />Filipus, ngona konongakuwa? 'ato ngoi de 'ai Dea ge'ena ka moi, 'imatero de ka 'o singina moi. 'Okia naga gee tangose-ngose ngonaka ge'ena ko to ngoiwa ma sirete 'ai mau. 'Okia naga gee tongose-ngose ngonaka, ge'ena ko to ngoiwa ma sirete 'ai singinano 'isupu. Ma 'ai Dea gee ka moi de de ngoi, 'una womanarama 'iodumu ge'ena. <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />Kanoingaku bato, ngoi de 'ai Dea ge'ena ka moi, de koge'enali mita 'una de de ngoi. Bolo yaino ma kurangi ge'ena salingou noingaku sababu 'okia naga todiaiokau. <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />Ma gou-goungu 'itiai 'ai demo ne'ena: 'O nyawa gee yongaku-ngaku ngoino, 'asa yadiai 'o manarama gee ngoi tadi-diai, de 'ona 'asa yadiai 'ifoloiosi 'ila-laagomo, sababu ngoi totagiou 'ai Deaka. <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />De 'okia naga bato nioga'asoko de to ngoi 'ai pareta, ge'ena 'asa tinileleani, la ma ngekomo ngoi ma Jo'oungu ma Dutu 'awi Ngowaka, 'o nyawa 'asa wisitedene 'ai Dea. <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />'Okia naga bato nioga'asoko de to ngoi 'ai pareta, 'asa tadiai.&gt;&gt;<verse eid="JHN 14:14" /></para>
  <para style="s">'O Yesus 'o Ngomasa 'Itebi-tebini wosijajiokau</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />'O Yesus wongoseli, &lt;&lt;Nako ngini nisibosono ngoi, ngini 'asa niamoteke 'iodumu gee tosulo-suloko nginika. <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />De ngoi 'asa toga'asoko 'ai Deaka, la winikula 'o Ro-riwo moioli, gee dua 'imanoa nginioka kaisi'ado-'adonika. <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />'Ena ge'ena 'o Ngomasa 'Itebi-tebini gee dua nisidumutu 'iti-tiai ma ngale ma Jo'oungu Dutu. 'O nyawa 'o duniaka gee koyongaku-ngakuwa, 'ona koyadawonguwa 'o Ngomasa 'Itebi-tebini sababu 'ona koyamakewa bolo koyanakowa. Ma ngini nianako, sababu ge'ena 'ena naga de de ngini, de dua 'ena 'imanoa 'ania singinaka.<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />Ngoi 'asa kotinisidamadakawa ka nginioka 'isoka 'o go'osisi. Ngoi 'asa tolioli nginino. <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />Ka 'o 'orasi moiou de 'o nyawa 'o duniaka dua koimakewau. Ma ngini 'asa nimakeli ngoi. De sababu ngoi to'ahu, so ngini mita 'asa nio'ahu kaisi'ado-'adonika. <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />Nako ma wange ya'adono to'ahuoli, ngini 'asa nianako 'ato ngoi ka moi de 'ai Dea, de ngoi de de ngini pomarimoi.<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />'O nyawa gee yadawongo de yoduaka yadiai 'okia naga gee tosulo-suloko, 'ona ge'ena 'isibosono ngoi. 'Ai Dea 'asa wakisibosono 'o nyawa gee 'isiboso-bosono ngoi, ngoi mita 'asa takisibosono 'o nyawa go'ona, de tomasidumutu 'onaka.&gt;&gt;<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />'O Yudas gee ko 'o Yudas Iskariotuwa wosano 'o Yesusika wongose 'ato, &lt;&lt;Jou, 'ido'oa so konomasidumutuwa 'o nyawa 'ireguka 'o duniaka ne'ena so ka ngomino?&gt;&gt;<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />'O Yesus wosango, &lt;&lt; 'O nyawa gee ma gou-goungu 'isibosono ngoi, 'asa yamoteke 'ai do-dotoko. 'Ai Dea 'asa wakisibosono 'ona, de 'una de de ngoi 'asa mioboa 'onaka de miomanoa de de 'ona. <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />'O nyawa gee koisibosonuwa ngoi, 'ona koyamotekuwa 'ai do-dotoko. 'O do-dotoko gee ngini nio'ise-'isene, ge'ena ko ngoinowa, ma 'ena 'ai Deano gee woisulo-suloko.<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />'Iodumu ge'ena tosidemo nginika, ma 'orasi ngoi ka de de nginiosi. <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />Ma 'o Ngomasa 'Itebi-tebini, 'o Ro-riwo gee dua 'ai Dea wosidingoto ma ngale 'ai dagali, 'ena 'asa nisidotoko 'o sagala moi-moi, de nisinganono 'okia naga tosidemokau nginika.<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />Ngoi ne'ena 'o sanangi ma titi. Ngoi tinikula 'o sanangi la niosangani 'isoka ngoioli. Gee tinikula-kula nginika ge'ena 'isoka 'o nyawa 'o duniakawa nikula-kula. 'Uwa nia singina 'isusa, 'uwa nimodongo. <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />Ngini nio'isenokau tinisidemo konee: &lt;Ngoi 'asa totagi, ma 'asa toboali nginino.&gt; Nako ngini nisibosono ngoi, ngini dua niomorene ngoi totagi 'ai Deaka, sababu 'una 'ifoloi woamoko de de ngoi. <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />Ma 'orasi ne'ena, 'iodumu ge'ena koidadiwasi 'ena tinisidemokau. La nako gee dua 'idadi, ngini 'asa niongaku. <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />Ngoi dua koikudaiwau tobicara de de ngini, sababu ma 'orasi ya'adonokau 'o duniaka 'ipa-pareta ge'ena la 'o Tokata ma Koana ge'ena 'iboau. Ma 'ena koi'akunuwa 'ipareta ngoi. <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />Ma ge'ena 'iodumu salingou 'idadi la 'o nyawa 'o duniaka yasahe 'ato ngoi towisibosono 'ai Dea, de tadiai 'o sagala moi-moi gee 'ai Dea wosulo-suloko.</para>
  <para style="p" vid="JHN 14:31">Aa, nou ngone pomagoraka ne'enaka!&gt;&gt;<verse eid="JHN 14:31" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008</para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">'O Yesus womasi'ade-'ade 'o 'anggur ma gou-goungu ma roese</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />'O Yesus wongoseli, &lt;&lt;Ngoi ne'ena 'isoka 'o 'anggur ma gou-goungu ma roese, de 'ai Dea 'una ge'ena ma 'anggur ma bairi wodi-diai. <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />Ma 'anggur ma sago gee koisowo-sowokuwa ge'ena ma bairi wodi-diai gu'una wa'oto, de ma sago gee 'isowo-sowoko ge'ena wodetebini, la ma sowoko 'ifoloiosi 'ikudaioka. <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />Ngini niotebinokau sababu 'o do-dotoko gee tinikula-kulakau. <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />Ngini salingou tatapu de de ngoi, de ngoi tatapu de de ngini. 'Isoka 'o 'angguroli nako ka ma roesoka duga ge'ena koidadiwa 'isowoko. So nako 'imau 'isowoko ge'ena salingou 'uwa 'imasipidili ma roesoka. Koge'enali mita ngini 'idadi niadiai 'okia sonaa yaowa-owa nako ngini konimasipidiluwa de de ngoi.<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />Ma gou-goungu ngoi 'isoka 'o 'anggur ma roese, de ngini ma sago-sago. 'O nyawa gee tatapu de de ngoi de ngoi de de 'ona, 'ona ge'ena 'isoka 'o 'angguroli tanu ma sowoko 'o gudaioka. Sababu ko de ngoiwa, ngini konimado-do'oawa. <figure style="fig" file="LB00107.tif" size="span" ref="(15:5)">'O 'anggur ma roese, ma sago-sago de ma sowoko</figure> <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />'O nyawa gee koyotatapukuwa ngoioka, 'asa yaki'umo 'isoka 'o 'anggur ma sago-sago gee koisowokuwa so ya'oto de ya'umo. So gee 'i'osauku 'asa de yatoomu so yositaulu. <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />Nako ngini tatapu nimarimoi de de ngoi de 'ai do-dotoko naga 'ania singinaka, 'okia naga bato niomau nioga'asoko 'ai Deaka, ge'ena 'asa nimadamake. <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />Nako ngini 'ikudai niadiai yaowa-owa, ge'ena 'ai Dea wisitedene. Ma ngekomo ge'ena ngini ma gou-goungu niodadi 'ai do-domoteke. <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />'Isoka 'ai Dea woisibosono ngoi, koge'enali mita ngoi tinisibosono ngini. Ge'enau so 'ai dora nginika niosi-singina de 'uwa nimasimada. <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />Nako ngini niamoteke 'ai pareta moi-moi, ngini tatapu nio'ahu 'ai dora ma sigoronaka. 'Isoka ngoi tatapu 'o Dea 'awi dora ma sigoronaka, sababu tamoteke 'awi pareta moi-moi.<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />'Iodumu ne'ena tosidemo nginika, la ngini niomorene sababu ngoi, de to ngini 'ania morene 'idadi 'itotomo. <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />Nanedau tinisulo-suloko ge'ena la: Nimakadora moi de moi, 'isoka ngoi tinidora ngini. <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />'O dora gee 'ifoloi 'iamoko ge'ena la yakiriwo manga manai sigado ngaro yosongene ma yomodeke. <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />Ngini ge'ena to ngoi 'ai ma-manai, nako la ngini niamoteke 'ai pareta. <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />Ngini kotinisi'asokuawau 'ai ro-riwo, sababu 'o ro-riwo koyanakowa 'okia gee naga manga tuangi wi di-dibangi. Ngini tinisi'asoko 'o giamanai, sababu 'iodumu gee to'isenino 'ai Deaka, tositotarokau nginika. <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />Ngoi ne'ena ko nginiwa niiriki, so 'ena ngoi tiniiriki ngini de tinisuloko niotagi niadiai 'ai manarama la de ma sowoko, de ma sowoko gee koito-torouwau. La 'ai Dea 'asa winikula 'okia naga bato nioga'asoko 'unaka de to ngoi 'ai pareta. <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />Naneda to ngoi 'ai besesongo nginika: Niomasikabosono moi de moi.&gt;&gt;<verse eid="JHN 15:17" /></para>
  <para style="s">'O nyawa 'o duniaka nidu'uduku nginika</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />&lt;&lt;Nako la 'o nyawa 'o duniaka nidu'uduku nginika, niongano-nganono, 'isira ngoino 'idu'udukokau. <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />Nako ngini niomarimoi de 'o nyawa 'o duniaka gee koyamotekuwa ma Jo'oungu ma Dutu 'awi mau, ma raiokau 'ona 'asa nisibosono. Ma ngoi tiniirikokau 'o duniaka ne'ena ma ngale nimoteke ngoi, so ngini konimarimoiwau de de 'ona. Ge'enau so 'ona nidu'uduku nginika. <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />Niongano-nganono 'okia naga gee tosidemokau nginika, &lt; 'O ro-riwo koi'iwa 'ifoloi yodaduie de manga tuangi.&gt; Nako 'ona 'ihalebiruokau ngoi, 'ona 'asa nihalebiru ngini mita. Nako 'ona yamoteke 'ai do-dotoko, 'ona 'asa yamoteke mita to ngini 'ania do-dotoko. <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />Ge'ena 'iodumu dua 'ona yodiai nginika, sababu ngini to ngoi 'ai do-domoteke, de sababu 'ona kowinakowa 'una gee woisulo-suloko. <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />Nako ngoi kotainowa de kotakisidemowa 'onaka 'iodumu ge'ena, ge'ena 'ona manga sala koi'iwa. Ma ne'ena 'ona koidadiwau yongose 'ato 'ona koyosikanakowa 'o sowono. <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />'O nyawa gee ngoino 'idu-du'uduku, ge'ena widu'uduku 'ai Deaka. <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />Nako 'onaka naga ngoi kotodiaiwa 'o no-nako 'ihera-herangi gee 'o nyawa 'iregu koyodiaiwasi, 'ona koyakisisalawa. Ma ne'ena 'ona yamakekau, ma 'ona 'idu'uduku ngoino de 'ai Deaka. <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />Ma ge'ena salingou koge'enau moteke 'okia naga gee 'isitulisuku to 'ona manga besesongo ma bukuoka ge'ena la: &lt; 'Ona 'idu'uduku ngoino ma sababu koi'iwa.&gt;<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />Ngoi 'asa tinisidingoto 'o Ro-riwo<note caller="i" style="f"><char style="fr" closed="false">15:26: </char><char style="ft" closed="false">Bolo ma ngale konee mita: gee nia singina 'isikua-kuata.</char></note> ma Jo'oungu ma Dutuno, ge'ena la 'o Ngomasa 'Itebi-tebini gee dua 'isidumutu 'o do-dotoko 'iti-tiai ma Jo'oungu ma Dutuno. Nako 'ena 'iboa, 'ena 'asa wosisakisii ma ngale ngoi. <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />De ngini mita salingou nisisakisii ngoi, sababu ngini de de ngoiou ka ma si-sirakasi.&gt;&gt;<verse eid="JHN 15:27" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008</para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />&lt;&lt; 'Iodumu ge'ena tinisidemokau nginika la 'uwa 'ania singina 'i'ogu de koniongakuwau ngoino. <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />Ngini 'asa niginiiki 'o lo-lomu ma woa-woaka. De dua ma 'orasi ya'adono, 'o nyawa gee nito-to'oma ngini 'asa yongose bari ge'ena ma ngale ma Jo'oungu ma Dutu wileleani. <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />'Ona koge'ena yodiai nginika sababu kowinakowasi 'ai Dea de mita ngoi. <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />Ma ne'ena tinisidemo ma ngale ge'ena, la dua gee 'idadi, ngini nionganonie 'ato ngoi tosidemokau nginika.&gt;&gt;</para>
  <para style="s" vid="JHN 16:4">'O Ngomasa 'Itebi-tebini ma manarama</para>
  <para style="p" vid="JHN 16:4">&lt;&lt; 'Iodumu ge'ena kotinisidemowa ka ma mulaenginosi, sababu ngoi ka de de nginiosi. <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />Ma ne'ena ngoi 'asa totagi 'ai Deaka gee woisulo-suloko; de nginioka naga ka moi ma koyosanowa kiaka ngoi totagi. <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />Ma 'orasi ne'ena ka 'ania singinali 'isusa, sababu ngoi tongose 'ato totagiou. <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />Ma ngoi tinisitotara gee ma gou-goungu: Niosanangioka ngini nako ngoi totagi; sababu nako ngoi kototagiwa, 'o Ro-riwo ge'ena dua koiboawa nginino. Ma nako ngoi totagi, ngoi 'asa tasuloko 'ena 'iboa nginino. <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />Nako 'ena 'iboa, 'ena 'asa yakisisahe 'o nyawa 'o duniaka ma ngale 'o sowono, 'o do-dotoko 'iti-tiai ma ngale ma Jo'oungu ma Dutu, de 'o hukumani. <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />'Ena 'asa 'isidumutu 'ato koingakuwa ngoino ge'ena 'o sowono; <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />de 'isidumutu 'ato 'o do-dotoko 'iti-tiai sababu ngoi totagi 'ai Deaka, de ngini dua konimakewau; <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />mita 'isidumtu ma ngale ma Jo'oungu ma Dutu dua wakihakimi 'o nyawa 'o duniaka, sababu wahukumokau 'o dunia ne'ena yapa-paretano ge'ena la 'o Tokata ma Koana.<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />'O gudaiosi tomau tinisidemo, duga ma 'orasi ne'ena konia'akunuawasi niadawongo. <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />Ma nako 'o Ngomasa ge'ena 'iboa, ge'ena la 'o Ngomasa 'Itebi-tebini gee 'isidumu-dumutu 'o do-dotoko 'iti-tiai ma ngale ma Jo'oungu ma Dutu, ngini 'asa nisi'asa ma ngale niosikanako 'o sagala moi-moi 'iti-tiai. 'Ena 'asa 'ibicara ka de to 'enawa ma sirete ma mau, ma 'ena 'asa 'isitotara 'okia naga gee 'i'isenokau. De 'ena 'asa nisidemo 'okia naga gee dua 'asa 'idadi. <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />'Ena 'asa 'isitedene ngoi, sababu 'okia naga gee 'isitota-totara nginika, ge'ena ngoioka 'i'isenino. <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />'Iodumu gee to 'ai Dea ge'ena to ngoi. Ge'enau ma sababu so ngoi tongose 'ato 'okia naga 'o Ngomasa 'Itebi-tebini 'isidemo-demo nginika ge'ena ngoioka 'i'isenino.&gt;&gt;<verse eid="JHN 16:15" /></para>
  <para style="s">'O susa de 'o morene</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />&lt;&lt;Ka 'o 'orasi moiou de ngoi konimakewau, de mita ka 'o 'orasi moiou de ngoi nimakekauoli.&gt;&gt;<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />'O Yesus 'awi do-domoteke yamuruo naga yomakasano moi de moi, &lt;&lt; 'Awi dumutu 'okia wongose ngoneno: &lt;Ka 'o 'orasi moiou de ngini 'asa konimakewau ngoi, de mita ka 'o 'orasi moiou de ngini 'asa nimakeli ngoi&gt;? Mita 'okia ma dumutu: &lt;Ngoi totagi 'ai Deaka&gt;?&gt;&gt; <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />De 'ona kayomakasano koyomaogoruwa, &lt;&lt; 'Okia ma ngale &lt;ka 'o 'orasi moiou&gt;? Ngone kopasahewa 'una wobicara ma ngale 'okia!&gt;&gt;<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />'O Yesus kawakidanakoka 'ato yomau yosano 'unaka, so kawongosekau, &lt;&lt;Kangano tongose, &lt;Ka 'o 'orasi moiou de ngini 'asa konimakewau, de mita ka 'o 'orasi moiou de ngini 'asa nimakeli ngoi.&gt; Ge'enau ngini niatiba-tibangi?<verse eid="JHN 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 16:20" />Kaniongaku bato, ngini 'asa nio'ari de nioto-tora, ma 'o dunia 'asa 'imorene. Ngini 'asa 'ania singina 'isusa, ma 'ania singina ma susa ge'ena 'asa 'imasitagali de 'o morene. <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />Nako 'o ngeweka mimoi rekeni momaku'arenoka, ge'ena 'ami singina 'isusa sababu ma 'orasiou mosangisara. Ma gedagee mokuatokau, ge'ena mamongorokau 'ami sangisara ge'ena, ngano momorene sababu 'o ngowaka ma giau moi 'iboa 'o duniano. <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />Koge'enali mita ngini: Ne'ena ngini 'ania singina 'isusa, ma ngoi de de ngini 'asa pomakamakeli, so 'ania singina 'asa 'imorene; de 'o morene 'ania singinaka ge'ena komoiwa 'idadi ya'ese.<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />Ge'ena ma wangeka ngini dua ko 'okiawau niosano ngoino. Kaniongaku bato: 'Okia naga bato nioga'asoko 'ai Deaka de to ngoi 'ai kuasa, ge'ena 'ai Dea 'asa winikula. <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />Sigado ma 'orasi ne'ena ngini koniomaga'asokuawasi 'o kianikia de to ngoi 'ai kuasa. Niomaga'asoko la ngini 'asa nimadamake, la posironga de niomorenoka.&gt;&gt;<verse eid="JHN 16:24" /></para>
  <para style="s">'O Yesus walakuokau 'o sagala moi-moi</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />&lt;&lt;Ge'ena 'iodumu tinisidemo de 'o cagulu. Ma 'asa ya'adono ma 'orasi, ngoi kotopakewau 'o cagulu, ma katinisiti-tiaikau ma ngale 'ai Dea. <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />Ma 'orasi ge'ena ngini 'asa nimaga'asoko 'ai Deaka de to ngoi 'ai kuasa. Ngoi kotongosewa 'ato ngoi 'asa tinidaga'asoko 'ai Deaka, <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />sababu 'ai Dea ma sirete winisibosono ngini. 'Una winisibosono ngini, sababu ngini nisibosono ngoi, de niongaku 'ato ngoi toboa ma Jo'oungu ma Dutuno. <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />Ma goungu ngoi 'ai 'asali 'ai Deano, de toboanou 'o duniaka. Ma ne'ena ngoi tamada 'o dunia ma ngale tolio 'ai Deaka.&gt;&gt;<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Ge'enaka de 'o Yesus 'awi do-domoteke kayongosekau 'unaka, &lt;&lt;Ma 'orasi ne'ena Jou nobicara kanositi-tiainou de konosica-caguluwau, <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />de ngomi mianako Jou ngona nosikanako 'okia sonaa. Kawimoi ma koiparaluuwau wosano 'o kianikia ngonaka Jou. Ge'enau so ngomi miongaku Jou ngona noboa ma Jo'oungu ma Dutuno.&gt;&gt;<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />'O Yesus wosango 'onaka, &lt;&lt;So ne'ena ngini niongaku? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />Niongano-nganono, ma 'orasi 'asa ya'adono de ya'adonokau, ngini 'asa nisibiakoroka. Ngini 'asa niolio moi-moi 'ania woaka de nisidamadaku tomatengokasi. Ma ngoi kotomatengokawa sababu 'ai Dea naga de de ngoi. <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />'Iodumu ne'ena tinisidemo la ngini niamake 'o sanangi sababu ngini de de ngoi ka moi. 'O duniaka ngini 'asa niosangisara. Ma 'ania singina niatongosonino! Ngoi talakuokau 'o sagala moi-moi 'o duniaka gee kowidomotekuwa ma Jo'oungu ma Dutu so!&gt;&gt;<verse eid="JHN 16:33" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008</para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />'O Yesus koge'ena wongoseka de 'o diwangie womatagade de kawongosekau, &lt;&lt; 'Aba, ne'ena ma 'orasi ya'adonokau. So noisitedenou ngoi 'ani Ngowaka, la ngoi mita tonisitedene ngona 'Aba. <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />'Aba ngona nokulakau 'ani kuasa ngoino 'ani Ngowakino, ma ngale takipareta 'o nyawa 'iodumu de takikula 'o 'ahu ma dutu 'ika-kakali 'o nyawa 'iodumika gee ngona nokula-kulakau ngoino. <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />Nanedau ma 'ahu ma dutu 'ika-kakali gee; ge'ena la ninako 'Aba Jo'oungu ma Dutu gee nomatengo-tengoka, de ngoi ma Yesus Kristus gee 'Aba noisulo-suloko. <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />Ngoi tonisitedenokau 'o dunia ma dekuoka ne'ena, ma ngekomo tosiduanga 'ai manarama gee ngona nokulakau ngoino. <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />'Aba! Noisitedenou ma 'orasi ne'ena 'ani bionoka, de 'ai kumati gee nagau 'ani bionoka ka 'o dunia ma koisidadiwasi 'ena.<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />Ngoi tomanarama so 'o nyawa-nyawa 'o duniaka ne'ena gee ngona 'Aba nosito-togumokau ngoino, ninakokau 'Aba. 'Ona ge'ena to ngona 'ani rongamoi, de ngona nakisisarakaniokau ngoino. 'Ona yodomotekokau to ngona 'ani demo. <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />Ma 'orasi ne'ena 'ona yanakokau 'ato 'iodumu gee 'Aba nokula-kulano ngoioka, ge'ena ma titi ngonano 'Aba. <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />Sababu tositotarokau 'onaka 'ani demo-demo gee nokula-kulano; de 'ona yadawongokau. 'Ona yanako 'ato ma gou-goungu ngoi toboa ngonano 'Aba de 'ona yongaku 'ato ngonau noisulo-suloko.<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />Ne'ena ngoi tosilahidoa ko 'o nyawa 'o duniaka 'iodumuwa, so duga ka 'o nyawa-nyawa gee 'Aba ngona nokulakau ngoino, sababu 'ona ge'ena to ngona 'ani rongamoi 'Aba. <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />'Iso de to ngoiou 'ai nyawa ge'ena la to ngona mita; de 'iso de to ngonau 'Aba ge'ena to ngoi mita. Ma ngekomo 'ona so 'o nyawa 'isitedene ngoi. <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />Ma 'orasi ne'ena ngoi toboa ngonaka 'Aba. Ngoi dua kotomanoawau 'o duniaka; ma 'ona 'o duniakasi. 'Aba notebi-tebini! Tanu nakijaga 'ona de to ngona 'ani kuasa ma guata, ge'ena la 'o kuasa gee ngona 'Aba noikulakau la 'ona 'idadi ka moi, 'isoka ngona 'Aba de ngoi ka moi. <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />Ma 'orasi ngoi ka de de 'onasi, ngoi takijagakau 'ona de to ngona 'ani kuasa ma guata -- 'o kuasa gee ngona 'Aba nokulano ngoino. Ngoi takijagakau 'ona, ka moi ma koyoisanguwa, duga ka 'una gee salingou woisanga; la de ge'ena 'idadi 'okia naga gee 'isilefoku 'o Buku 'Itebi-tebinoka. <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />Ma 'orasi ne'ena ngoi toboa ngonaka 'Aba. 'Iodumu ne'ena tosidemo ma 'orasi ngoi ka 'o duniakasi; la 'ona yomorene ma sala sababu ngoi. <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />Ngoi tositotarokau 'onaka to ngona 'Aba 'ani demo, de 'o dunia ma nyawa yakidu'uduku 'onaka, sababu 'ona ko 'o dunianowa. Kaimatero de ngoi, ngoi mita ko 'o dunianowa. <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />Ngoi kotoga'asokuwa naki'ese 'o duniaka ne'ena, ma ngoi toga'asoko la nakijaga la 'uwa 'o Tokata ma Koana yakitaili. <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />'Isoka ngoioli ne'ena kotomarimoiwa de 'o dunia ma nyawa,<note caller="j" style="f"><char style="fr" closed="false">17:16: </char><char style="ft" closed="false">&lt;&lt; 'O dunia ma nyawa&gt;&gt; ma ngale gee koyongaku-ngakuwa.</char></note> 'ona mita koyomarimoiwa de 'o dunia ma nyawa. <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />Nakidiai 'ona ge'ena ka to ngona 'Aba, ma ngekomo 'o do-dotoko 'iti-tiai. 'Ani demou 'Aba ge'ena la 'o do-dotoko 'iti-tiai. <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />'Isoka ngona 'Aba noisulokokau 'o duniano, koge'enali mita 'ona takisuloko 'o duniaka. <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />Ma ngale 'ona, ngoi tomasisarakani 'ai 'ahu 'idadi ka to ngona 'ani rongamoi 'Aba, la 'ona mita 'idadi ka to ngona 'ani rongamoi ma ngekomo 'ani do-dotoko 'iti-tiai.<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />Ngoi takisilahidoa duga ka 'onawa ne'ena. Ma mita 'o nyawa-nyawa gee dua yongaku ngoino de to 'ona manga sakisii ne'ena. <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />Ngoi toga'asoko 'Aba, la 'ona yoodumu ka moi, 'isoka ngona de de ngoi pomarimoi, de ngoi de de ngona. Tanu 'ona 'idadi ka moi de de ngone la 'o dunia ma nyawa yongaku 'ato ngonau 'Aba noisulo-suloko ngoi. <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />Ngoi todiaiokau 'ona yokumati, kaimatero de ngona noidiaiokau ngoi tokumati, la 'ona 'idadi yomarimoi, 'isoka ngoneli mita pomarimoi; <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />ngoi naga de de 'ona de ngona 'Aba de de ngoi; la 'ona ma gou-goungu ka moi. So ma rai 'o dunia ma nyawa 'asa yanako 'ato ngoi ne'ena ngona noisulokino, de ngona 'Aba nakisibosono 'ona kaimatero de ngoino.<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />'Aba, ngoi tomau 'o nyawa gee ngona nokulakau ngoino, 'ona de de ngoi kiaka naga taika, la 'ona yamake 'ai kumati gee ngona 'Aba noikulano, sababu ngona noisibosonokau ka 'o dunia ma koisidadiwasi. <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />'Aba noloa-loa! 'O dunia ma nyawa koninakowa ngona, ma ngoi toninako; de 'o do-domoteke no'ona yanakokau 'ato ngonau 'Aba noisulo-suloko. <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />Ngoi tosidumutokau 'onaka 'ani kuasa 'Aba; de ngoi dua kotomaogoruwa todiai koge'ena, la 'ani dora ngoino gee takikulakau 'onaka, tatapu to 'ona manga singinaka de ngoi ka moi de de 'ona.&gt;&gt;<verse eid="JHN 17:26" /></para>
  <para style="rem">Ilustrasi+Footnote: Ning 25-6-'08 Penyunting: Ning 17-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">'O Yesus witagoko</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat. 26:47-56</ref>; <ref loc="MRK 14:43-50">Mrk. 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk. 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />'O Yesus wolahidoaka koge'ena, deika 'una de 'awi do-domoteke yotagi 'o Kidron ma 'akere ma songene ma songonaka. Ge'enaka 'o bairi 'o ngai moi so 'o Yesus de 'awi do-domoteke yowosanga ge'enaka. <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />'O Yudas gee 'o Yesus wiwuku-wukunu gu'una, wosikanako 'o ngii ge'ena; sababu 'o Yesus de 'awi do-domoteke 'ijaga yomalomu-lomuou ge'enaka. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />So 'o Yudas wotagi ge'enaka de waki'asa 'o Romaka ma tentara 'o bolu moi de ma Jou 'awi Woa ma jo-jaga yamuruo naga gee 'o 'imam ma sae-saeke de 'o Farisioka yakisuloko. 'Ona yo'asa 'o dae, 'o poci, de 'o burane. <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />'O Yesus wanakokau 'iodumu gee dua 'idadi 'unaka. So womasisori gee yoboa-boano go'ona de wosano, <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />&lt;&lt;Nagu'una wininonu?&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">'Ona yosango, &lt;&lt; 'O Yesus 'o Nazaret ma nyawa.&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">'O Yesus wongose, &lt;&lt;Ngoiou ne'ena.&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">'O Yudas gee 'o Yesus wiwuku-wukunu gu'una woma'okode ge'enaka de de 'ona. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Gee 'o Yesus wongose 'ato, &lt;&lt;Ngoiou ne'ena,&gt;&gt; de 'ona yoodumu yomasidorusu manga dudunoko de kayaruba. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Ma moiosi 'o Yesus wosano 'onaka, &lt;&lt;Nagu'una wininonu?&gt;&gt;</para>
  <para style="p" vid="JHN 18:7">'Ona yosango, &lt;&lt; 'O Yesus 'o Nazaret ma nyawa.&gt;&gt;<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />'O Yesus wongose, &lt;&lt;Tosidemokau 'ato ngoiou ne'ena. De nako ma goungu ngoi ninonu, niakimadaka 'iregu-regu gee yotagi.&gt;&gt; (<verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />De koge'ena wongose, 'idadiokau 'okia naga gee 'o Yesus wosidemokau bene'ena koidadiwasi 'ena: &lt;&lt; 'Aba 'o nyawa gee ngoino nokula-kula, ka moi ma koyoisanguwa.&gt;&gt;)<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />'O Simon Petrus gee 'o wase 'o ngai moi wo'asa, wa'aikie de wisi'oto ma 'Imam ma Amoko 'awi ro-riwoka so 'awi ngauku ma giniraka ma 'itoaka. 'O ro-riwo gu'una 'awi ronga 'o Malkus. <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />So 'o Yesus kawongosekau 'o Petrusika, &lt;&lt; 'Ani wase nasarumukoli! Bolo ngona nongose ngoi kotomodekuwa? tosangisara moteke 'ai Dea wositatapuokau?&gt;&gt;<verse eid="JHN 18:11" /></para>
  <para style="s">'O Yesus wi'asa wisitaari 'o Hanasika</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Ge'enaka de 'o Romaka manga tentara de manga kapita de ma Jo'oungu ma Dutu 'awi Woa ma jo-jaga 'o Yesus witagoko de wipusuku. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />Ma si-siraka 'ona 'o Yesus wi'asa wisitaari 'o Hanasika, 'o Kayafas ma toroa. 'O Kayafas ge'ena 'o 'Imam ma Amoko moi ma taunu ge'ena. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />De 'unau ge'ena wakidongosekau 'o Yahudioka manga balu-balusika 'ato 'ifoloi yaowa wimoi wosongene ma ngale to ngone nanga nyawa yoodumu.<verse eid="JHN 18:14" /></para>
  <para style="s">'O Petrus womasipongono 'ato kowinakowa 'o Yesus</para>
  <para style="r">(<ref loc="MAT 26:69-70">Mat. 26:69-70</ref>; <ref loc="MRK 14:66-68">Mrk. 14:66-68</ref>; <ref loc="LUK 22:55-57">Luk. 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />'O Simon Petrus de 'o do-domoteke 'iregu wimoi 'o Yesus wimoteke. 'O do-domoteke 'iregu gu'una 'o 'Imam ma Amoko winako; so 'una mita wowosanga de 'o Yesus ma 'Imam ma Amoko 'awi ginitarika. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />'Ena 'o Petrus 'una wota-tamaa ma dudunoka, 'o ngoranoka. Ge'enaka de 'o do-domoteke 'iregu gu'una wosupu de wobi-bicara de 'o ro-riwo mimoi gee 'o ngorana mojaga-jaga, ge'enaka de misingosama 'o Petrus dokaika 'o ginitarika. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />'O ro-riwo 'o ngorana mojaga-jaga gumuna kamongosekau 'o Petrusika, &lt;&lt;Ee, ngona mita 'o nyawa gu'una 'awi do-domoteke?&gt;&gt;</para>
  <para style="p" vid="JHN 18:17">'O Petrus wosango, &lt;&lt;Ko'uwa.&gt;&gt;<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ma 'orasi ge'ena 'o 'alo 'isupuokau so 'o roro-riwo de yojaga-jaga go'ona 'o 'uku yotaulieu de yomasaukikau ge'enaka. 'O Petrus waika de woma'okode womasauku de de 'ona.<verse eid="JHN 18:18" /></para>
  <para style="s">Ma 'Imam ma Amoko 'o Yesusika wisano</para>
  <para style="r">(<ref loc="MAT 26:59-66">Mat. 26:59-66</ref>; <ref loc="MRK 14:55-64">Mrk. 14:55-64</ref>; <ref loc="LUK 22:66-71">Luk. 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Ma 'Imam ma Amoko 'awi ngiioka de 'o Yesusika wisano ma ngale 'awi do-domoteke de 'awi do-dotoko. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />'O Yesus wosango, &lt;&lt;Ngoi kaitaurika tobi-bicara tositi-tiaika 'o kawasa ma bionoka, kaitaurika todotoko 'o lo-lomu ma woa-woaka de ma Jo'oungu ma Dutu 'awi Woaka, gee biasa 'o Yahudioka yomalomu-lomu ma ngiioka. Koma'iwa 'o kianikia tosidemo tosipongo-pongono. <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />'Ido'oa so ngona nosano ngoino? Nakisano 'ona gee yo'ise-'isenokau ngoi todotoko. Ma raiokau 'ona yanako 'okia tongose.&gt;&gt;<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Gee 'o Yesus koge'ena wongose, de 'o jo-jaga wimoi ge'ena wopoka 'o Yesusino de kawongosekau, &lt;&lt;De nomoroinoka nobicara koge'ena 'o 'Imam ma Amokika!&gt;&gt;<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />'O Yesus wosango, &lt;&lt;Nako ngoi tosidemo 'o kianikia ko ma gounguwa, kaniosidemo bato. Ma nako 'okia naga tosidemo-demo ge'ena la ma goungu, 'ido'oa so noipoka?&gt;&gt;<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Ge'enaka de 'o Hanas wosuloko 'o Yesus wi'asa de wibu-busuoka 'o Kayafasika ma 'Imam ma Amoko gu'una.<verse eid="JHN 18:24" /></para>
  <para style="s">'O Petrus womasipongonoli 'ato 'una ko 'o Yesusuwa 'awi do-domoteke</para>
  <para style="r">(<ref loc="MAT 26:71-75">Mat. 26:71-75</ref>; <ref loc="MRK 14:69-72">Mrk. 14:69-72</ref>; <ref loc="LUK 22:58-62">Luk. 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />'O Simon Petrus kawomasaukikasi woma'okode ge'enaka, de 'o nyawa-nyawa kayongosekau 'unaka, &lt;&lt; Ma rai ngona mita 'o nyawa gu'una 'awi do-domoteke. Bolo?&gt;&gt; Ma 'o Petrus womasipongono wongose 'ato, &lt;&lt;Ko'uwa!&gt;&gt;<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />'O 'Imam ma Amoko 'awi ro-riwo wimoi ge'ena la 'o araka moi de 'o nyawa wimoi gee 'awi ngauku 'o Petrus wa'oto so kaiatetikau, kawongosekau, &lt;&lt;Ma rai ngonau tonimake 'o bairoka gee de 'o Yesus, bolo?&gt;&gt;<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Ge'enaka de 'o Petrus womasipongonoli wongose 'ato, &lt;&lt;Ko'uwa.&gt;&gt; De ma 'orasi ge'ena 'o namoro 'isorene.<verse eid="JHN 18:27" /></para>
  <para style="s">'O Yesus wotaari 'o Pilatusika</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat. 27:1-2</ref>, <ref loc="MAT 11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mrk. 15:1-5</ref>; <ref loc="LUK 23:1-5">Luk. 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Kayaika 'ibibini de 'o Yesus wisisupu 'o Kayafas 'awi woaka wi'asa ma gubernur 'awi kadatoka. 'O Yahudioka ma sirete koyowosanguwa 'o kadato ma dodaka, la 'uwa yomediri moteke manga 'agama ma 'atorangi, sababu 'ona yomau yomoteke Wakisisupu ma Wange ma ngodomo. <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Sababu ge'ena 'o Pilatus wosupuka wosano, &lt;&lt; 'Okia winikalaki 'o nyawa nu'una?&gt;&gt;<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />'Ona yosango, &lt;&lt;Nako la 'una ko 'okiawa wasala, ngomi komi'asawa 'o nyawa nu'una ngonaka 'Aba Gubernur.&gt;&gt;<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />'O Pilatus kawongosekau 'onaka, &lt;&lt;Wini'ese la wini'urusu moteke to ngini ma sirete 'ania hukumu!&gt;&gt;</para>
  <para style="p" vid="JHN 18:31">Ma 'o Yahudioka yosango, &lt;&lt;Ngomi 'o Romaka ma Koana ma Amoko komisidabiwa 'o nyawa miahukumu miakiso-songene.&gt;&gt; (<verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Ne'ena moteke 'okia naga 'o Yesus wosidemokau ma ngale dua wosongene ma do-dagi.)<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />'O Pilatus wowosangoli 'awi kadato ma dodaka de 'o Yesus wi'asokino de wosano, &lt;&lt;Ngona 'o Yahudioka manga Koana?&gt;&gt;<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />'O Yesus wosango, &lt;&lt; 'O sa-sano ne'ena ka ngonano ma sirete bolo naga 'o nyawa 'iregu yosidemokau ngonaka ma ngale ngoi?&gt;&gt;<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />'O Pilatus wosango, &lt;&lt;Ngoi ne'ena ko 'o Yahudiwa ma nyawa! Gee ni'asa ngoino ge'ena to ngona ma sirete 'ani nyawa de 'o 'imam ma sae-saeke. 'Okia nadiaiokau?&gt;&gt;<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />'O Yesus wongose, &lt;&lt;Ngoi 'ai pareta ko 'o dunianowa ne'ena. Nako la 'ai pareta 'o duniano ne'ena, 'ai nyawa-nyawa 'asa yokudoti la ngoi 'uwa 'i'asa 'o Yahudioka manga balu-balusika. Ma ma goungu to ngoi 'ai pareta ko ne'ena 'o dunianowa!&gt;&gt;<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />So 'o Pilatus wosano 'unaka, &lt;&lt;Nako koge'ena, ngona ma Koana?&gt;&gt; 'O Yesus wosango, &lt;&lt;Ngona ma sirete nongosekau. Ngoi tosupu 'o duniano de taino 'o duniano ne'ena ma dumutu ma ngale tositotara 'o loa. 'O nyawa gee yodua-duaka 'o loa ge'ena, yosigisene ngoino.&gt;&gt;<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />'O Pilatus wosango, &lt;&lt; 'O loa ge'ena ma ngale 'okia?&gt;&gt;</para>
  <para style="s" vid="JHN 18:38">'O Yesus wihukumu wiso-songene</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Mat. 27:15-31</ref>; <ref loc="MRK 15:6-20">Mrk. 15:6-20</ref>; <ref loc="LUK 23:13-25">Luk. 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Ge'enaka de 'o Pilatus wosupuoli 'awi kadatoka de kawongosekau 'o Yahudi ma nyawaka, &lt;&lt;Ka 'o ngai moi ma kotodamakewa 'o nyawa nu'una 'awi sowono. <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Ma moteke to ngini 'ania 'adati, Wakisisupu ma Wange ma Amoko 'isinoimi ngoi takisisupu 'o bui ma nyawa womatengo. Niomodeke ngoi towisisupu 'o Yahudioka manga Koana nginika?&gt;&gt;<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />'Ona yosango yomapoa-poaka, &lt;&lt; 'Uwa 'una. 'Ena 'o Barabas!&gt;&gt; ('O Barabas 'una ge'ena wo'ora-'ora de woto-to'oma.)<verse eid="JHN 18:40" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Ge'enaka de 'o Pilatus wowosanga de wakisuloko 'o tentara 'o Yesus wiribesana. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />De 'o tentara yodiai 'o Yesus 'awi tuala moi 'o gota ma sago-sago 'ito-totowoko de wi saeoka yosinoaku ma ngale wisiti-tingoono. Ge'ena 'iduanga de 'o baju 'ikaku-kakuruku ya'ungu-'ungu wisinoaku, <figure style="fig" file="HK00197.pcx" size="span" ref="(19:2)">'O Roma ma nyawa manga tentara</figure> <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />de yaika yogi-gilioka 'unaka kayongosekau, &lt;&lt;Cei! Cei! 'O Yahudioka manga Koana!&gt;&gt; De 'ona wipoka.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Ge'ena 'ipasa de 'o Pilatus ma moiosi wosupu de kawongosekau 'o nyawa yoku-kudaika, &lt;&lt;Bika winilega towisisupuno 'ania bionoka, la nianako 'ato ngoi kotodamakewa 'awi sowono ka moi ma.&gt;&gt; <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />So 'o Yesus wosupu de 'awi tuala 'ito-totowoko de wi baju 'ikaku-kakuruku ya'ungu-'ungu, de 'o Pilatus wongose 'onaka, &lt;&lt;Nudau 'o nyawa gu'una.&gt;&gt;<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Gee 'o 'imam ma sae-saeke de yojaga-jaga go'ona wimake 'o Yesus, de yosigaso-gasoko, &lt;&lt;Winisidele 'o salipoka! Winisidele 'o salipoka!&gt;&gt;</para>
  <para style="p" vid="JHN 19:6">De 'o Pilatus wongose 'onaka, &lt;&lt;Neda wini'eseno la ngini ma sirete winisidele, ngoi kotodamakewa 'awi sowono ka moi ma.&gt;&gt;<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />'O Yahudioka ma nyawa yosango, &lt;&lt;Moteke to ngomi mia hukumu, 'una ge'ena salingou wihukumu wiso-songene, sababu 'una womasironga ma Jo'oungu ma Dutu 'awi Ngowaka ma ngale 'una womasitero ma Jo'oungu ma Dutu.&gt;&gt;<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />'O Pilatus gee wo'isenoka koge'ena yongose, de 'ifoloiosi wimodongo. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />So wowosangoli 'awi kadato ma dodaka de gee 'o Yesus wisingosamika de 'o Pilatus wosano 'unaka, &lt;&lt;Ngona ne'ena ni 'asali kiano?&gt;&gt;</para>
  <para style="p" vid="JHN 19:9">Ma 'o Yesus kowosangowa. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />So 'o Pilatus wongoseli, &lt;&lt;Nooluku nobicara ngoino? Ngona nanakokau ngoiou ne'ena tokuasa nisipidili bolo nisidele 'o salipoka!&gt;&gt;<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />De 'o Yesus wosango, &lt;&lt;Nako ma Jo'oungu ma Dutu kowonikulawa 'o kuasa ge'ena, ngona ka ma eta ma koidadiwa noipareta. Sababu ge'ena 'o nyawa gee 'isisarakani ngonaka, to 'ona 'ifoloi manga sowono 'iamoko de to ngona.&gt;&gt;<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />'O Pilatus kawo'isenoka ge'ena de ma ngekomo wononu la 'o Yesus wisipidili. Duga 'o Yahudioka yosigaso-gasoko 'o Pilatusika 'ato, &lt;&lt;Nako ngona wonisipidili, ge'ena ngona konogiamanaiwau de 'o Kaisar! Sababu nago'ona la yomasironga 'o Koana, 'ona ge'ena 'o Kaisar 'awi musu!&gt;&gt;<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />So gee 'o Pilatus wo'isenoka manga demo ge'ena, de 'o Yesus wisisupuka de 'o Pilatus wogogeruku 'o sowono yolega ma diai ma go-gogeroka, 'o ngiioka gee yosironga 'o Teto 'Inao-nao. ('O Ibranioka yosironga 'o Gabata.)<verse eid="JHN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 19:14" />Ma 'orasi ge'ena 'o wange 'ikoronau, Wakisisupu ma Wange ma Amoko 'isoriokau. 'O Pilatus kawongosekau 'o nyawa-nyawaka go'ona, &lt;&lt;Nee 'ania Koana!&gt;&gt;<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />De 'ona yosigaso-gasoko, &lt;&lt;Winito'oma! Winito'oma! Winisidele 'o salipoka!&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">'O Pilatus wosano 'onaka, &lt;&lt;Salingou ngoi towisidele 'ania Koana?&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">De 'o 'imam ma sae-saeke yosango, &lt;&lt; 'Amia koana duga ka 'o Kaisar womatengoka!&gt;&gt; <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />So 'o Pilatus 'o Yesus wisisarakani 'onaka ma ngale wisidele 'o salipoka. So 'o solodado wi'ese de wi'asakau.<verse eid="JHN 19:16" /></para>
  <para style="s">'O Yesus wisidele 'o salipoka</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat. 27:32-44</ref>; <ref loc="MRK 15:21-32">Mrk. 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk. 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />'O Yesus wisisupu ma kotaka ge'ena, de wamoku 'awi salip wa'asa 'o ngii moika gee yosironga &lt;&lt; 'O Saeke ma Kobongo ma Ngii&gt;&gt;. ('O Ibranioka yosironga 'o Golgota.) <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Ge'enaka doka 'una wisidele 'o salipoka. Wisidisidele de de 'una 'o nyawa yamididi. Wimoi 'awi gubalioka, de wimoi 'awi giniraoka so 'o Yesus 'una ma goronaka. <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />'O Pilatus wosuloko 'o Yesus 'awi salipoka 'awi saeke ma dekude yosilefoka koneda, &lt;&lt; 'O Yesus 'o Nazaretino, 'o Yahudioka manga Koana.&gt;&gt; <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />'O Yahudioka manga gudai yabaca 'ituli-tulisika ge'ena, sababu 'o Yesus wiside-sidele 'o salipoka ma ngii ge'ena 'o kotaka 'ena koikurutikawa. 'Isituli-tulisika ge'ena 'o Ibranioka de 'o Latinoka de 'o Yunanioka manga demo. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />'O 'imam ma sae-saeke 'o Pilatusika yongose 'ato, &lt;&lt; 'Uwa 'isitulisika &lt; 'O Yahudioka manga Koana&gt;, la 'ena 'isitulisika, &lt; 'O nyawa nu'una wongose 'ato, Ngoi ne'ena 'o Yahudioka manga Koana.&gt; &gt;&gt;<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Ma 'o Pilatus wosango, &lt;&lt;Gee 'isitulisikau ge'ena tatapu koge'enau.&gt;&gt;<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />'O tentara gee 'o Yesus wisidele 'o salipoka 'iduanga, de wi pakeangi ya'ese so yomasibula yaruatoka; so 'o nyawa moi 'o ngai moi. De 'awi juba mita ya'ese. 'Awi juba ge'ena ma yodiai kadaku de 'isikauku sigado daukuku 'itotaroka ma gu-guriti koi'iwaka. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Ma tentara go'ona yomakadongose 'ato, &lt;&lt; 'Uwa pa'ogu-'ogu 'o juba ne'ena. Nou pocabu'undi la nagu'una wadaene ge'ena 'una wa'ese.&gt;&gt; Koge'ena 'idadi moteke 'isoka kokia naga 'isitulisuku 'o Buku 'Itebi-tebinoka ge'ena la:</para>
  <para style="q1" vid="JHN 19:24">&lt;&lt; 'Ona yomasibula-bula 'ai pakeangi</para>
  <para style="q1" vid="JHN 19:24">de 'ai juba yodu'undi.&gt;&gt;</para>
  <para style="m" vid="JHN 19:24">De ma goungu 'o tentara go'ona yodiai koge'ena.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />'O Yesus 'awi salip ma dateoka yoma'oko-'okode 'o Yesus ma 'esa, de 'ami 'esa moi ma dutu, 'o ngo Maria 'o Klopas ma wekata, de ngo Maria Magdalena. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Gee 'o Yesus wakimake ma 'esa de 'awi do-domoteke gee yomagiamanai ma sala de wisiboso-bosono yoma'okode de wongose ma 'esaka, &lt;&lt; 'Eme, gu'una to ngona 'ani ngowaka.&gt;&gt;<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />'Asa de wongoseli 'awi do-domoteika gu'una, &lt;&lt;Gumuna to ngona 'ani 'esa.&gt;&gt; So ma 'orasi ge'enau de 'ikurue 'o do-domoteke gu'una womi'asakau 'o Yesus ma 'esa momanoa 'awi woaka.<verse eid="JHN 19:27" /></para>
  <para style="s">'O Yesus wosongene</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat. 27:45-56</ref>; <ref loc="MRK 15:33-41">Mrk. 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk. 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />'O Yesus wanakokau 'ato ma 'orasi ne'ena 'awi manarama 'iodumu waduangokau, de ge'ena ma ngale la 'okia naga gee 'isitulisokau 'o Buku 'Itebi-tebinoka gee 'idadi, de kawongosekau, &lt;&lt; 'Ai kibiti 'idudungu.&gt;&gt;<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Ge'enaka 'o daluku ma cuka 'o sawoko moi ya'oma-'omanga. So 'o spons yawaruoka ma daluku ma cukaku, de 'o gota 'o hisop ma sagoka yosisagatuku de 'awi 'uru ma kaide yodutubo. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Deika 'o Yesus wataili ma daluku ma cuka ge'ena, de kawongosekau, &lt;&lt; 'Iduangokau!&gt;&gt;</para>
  <para style="p" vid="JHN 19:30">Ge'enaka de 'awi saeke wakuduru de 'awi ngomasa 'ipidili.<verse eid="JHN 19:30" /></para>
  <para style="s">'O Yesus wituduku</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />'O Yahudioka ma balu-balusu yooluku 'o nyawa yosonge-songenuku 'o salipoka manga maieti koge'ena 'isidelika Pomaoma-omasa ma Wangeka, 'ifoloi ne'ena ma moi Pomaoma-omasa ma Wange ge'ena 'o wange ma amoko moi 'iditingaka sababu ma 'orasi 'o Yesus wisidele 'o salipoka ge'ena Pomaoma-omasa ma Wange koya'adonikawasi. 'O Yahudioka yotagi 'o Pilatusika yoga'asoko 'o nyawa yakiside-sidelika gee manga dou ya'ogu de manga songene yosiguti. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />So 'o tentara yaika de yatisira ya'ogu yamididi manga dou gee yakisidisidele de 'o Yesus. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Gee ya'adono 'o Yesusika, 'ena wimake wosongenokau. So to 'una koya'oguwau. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Duga 'o Yesus 'awi meseosika 'o tentara wimoi 'o kuama wositadi; de 'isupu 'o 'aunu de 'o 'akere.<verse eid="JHN 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 19:35" />'O nyawa gee wamake-make 'okia naga 'idadiokau ge'ena, 'unau wositotara 'iodumu ge'ena la ngini mita niongaku. De 'awi sakisii ge'ena 'itiai, de 'una wanako ge'ena ma gou-goungu 'itiai. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Ge'ena 'idadi, moteke 'isoka 'isitulisokau 'o Buku 'Itebi-tebinoka 'ato, &lt;&lt;Dua 'awi kobongo ka 'o ngai moi ma koya'oguwa.&gt;&gt; <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />'O Buku 'Itebi-tebinoka 'isitulisuku mita, &lt;&lt; 'Ona 'asa wiungi-ungini 'unaka gee wisu-sumoka de.&gt;&gt;<verse eid="JHN 19:37" /></para>
  <para style="s">'O Yesus wipo'osuku</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat. 27:57-61</ref>; <ref loc="MRK 15:42-47">Mrk. 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk. 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Ge'ena 'ipasa de 'o Yusuf 'o Arimateano woga'asoko 'o Pilatusika la 'o Yesus 'awi maieti wa'ese. ('O Yusuf ge'ena 'o Yesus 'awi do-domoteke ma kawoma'iu-'iunu sababu wakidomodongo 'o Yahudioka manga balu-balusu.) 'O Pilatus wosidabi so waika wa'ese 'o Yesus 'awi maieti. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />Mita 'o Nikodemus gee ma sira 'o obiruku de woboa-boa 'o Yesusino, 'una mita womoteke de 'o Yusuf. 'O Nikodemus wo'asa 'o gota ma tigono ma bounu yaowa-owa gee yosironga 'o mur 'isikaganuku de 'o gaharu poilia 'o kilo nagi sa'ange la wi maieti yosiesaka. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Yamididi go'ona 'o Yesus 'awi maieti ya'ese, de yasao. Yosisao 'o songene ma sa-sao, ka ma moi de 'o mur de 'o gaharu 'isikakaganuku ge'ena, moteke 'o Yahudioka manga 'adati 'o songene yopo'osuku. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />Gee 'o Yesus wiside-sidele 'o salipoka ma dateoka, ge'enaka 'o bairi 'o ngai moi de ma dodaka 'o bo'osuku ma sungi 'o ngai moi komoiwasi yakidobo'osuku. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Sababu 'o bo'osuku ge'ena ka ma sorino, de Pomaoma-omasa ma Wange rekeni ya'adonoka, so 'ona wipo'osuku ge'enakau doka.<verse eid="JHN 19:42" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">'O bo'osuku ka ma somoakau</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat. 28:1-8</ref>; <ref loc="MRK 16:1-8">Mrk. 16:1-8</ref>; <ref loc="LUK 24:1-12">Luk. 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />'O 'Ahadi ma wange kaitaru-tarusikasi, ngo Maria Magdalena motagi 'o bo'osukika. De mamake ma bo'osuku ma ngorana ma da-datoko 'o teto gee yatuluruokau. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />So kamoowa-owara makinonu 'o Simon Petrus de 'o do-domoteke gee 'o Yesus wisiboso-bosono de yomagiamanai ma sala, de kamongosekau 'onaka, &lt;&lt;Ma Jou wi'esekau 'o bo'osukoka, ngoi kotanakowa kiaka winoaka.&gt;&gt;<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Ge'enaka de 'o Petrus de 'o do-domoteke 'iregu go'ona yotagi 'o bo'osukika. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />'Ona yamididi kayoowa-owara ma 'o do-domoteke 'iregu gee 'ifoloi wotaiti de 'o Petrus, so 'una 'isira wototara 'o bo'osukika. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />'Una watutumu ma bo'osuku ma dodaka de wamake 'o songene ma sa-sao ge'enaka, ma 'una kowowosanguwa. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />'O Simon Petrus wotu'uruno kawogila-gilaka wowosanga ma bo'osuku ge'ena ma dodaka. 'Una wamake 'o songene ma sa-sao ge'enaka, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />ma 'o Yesus 'awi saeke ma bu-busuku koi'iwau ge'ena wi sa-sao ma datekoka so 'ena 'itingaika 'ipelelenou. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Ge'enaka de 'o do-domoteke gee wosiraka 'o bo'osuika, wowosanga mita. 'Una ma wamake de wongaku. (<verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Sigado ma 'orasi ge'ena 'ona koyasahewasi 'okia naga gee 'isitulisuku 'o Buku 'Itebi-tebinoka 'ato 'o Yesus salingou wowangoli ngaro wosongenukou ma.) <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Ge'ena 'ipasa de 'o Yesus 'awi do-domoteke go'ona yolio.<verse eid="JHN 20:10" /></para>
  <para style="s">'O Yesus womasidumutu 'o ngo Mariaka gee 'o Magdalenano</para>
  <para style="r">(<ref loc="MAT 28:9-10">Mat. 28:9-10</ref>; <ref loc="MRK 16:9-11">Mrk. 16:9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Ngo Maria Magdalena moma'okode 'o bo'osuku ma daarioka de mo'ari-'ari. Mo'ari ma de matutumu 'o bo'osuku ma dodaka, <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />de mamake 'o mala'ekati 'o ngai modidi ma baju ya'are-'arese. 'Ena 'igogerie 'o Yesus 'awi songene ma rioka, moi 'awi saekisa de moioli 'awi douoko. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />'O mala'ekati 'o ngai modidi ge'ena 'isano, &lt;&lt; 'Esa 'ido'oa so no'ari?&gt;&gt;</para>
  <para style="p" vid="JHN 20:13">Ngo Maria mosango, &lt;&lt; 'Ai Jou wi maieti ya'esekau, de kotosidongoowa kiaka winoaka.&gt;&gt;<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Koge'ena mongoseka, de momadutumu 'ami dudunoko de mimake 'o Yesus woma'okode ge'enaka. Ma muna kominakowa 'ato gu'una 'o Yesus. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />'O Yesus wosano munaka, &lt;&lt; 'Eme, 'ido'oa so no'ari? Nago'ona nakinonu?&gt;&gt;</para>
  <para style="p" vid="JHN 20:15">Ngo Maria muna mongose 'una 'o bairi woma-manarama so kamongosekau, &lt;&lt;Bereki, nako ngona wonito'orakoka ne'enaka, de noisidemo kiaka woninoaku la towi'ese.&gt;&gt;<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />'O Yesus kawongosekau munaka, &lt;&lt;Maria!&gt;&gt;</para>
  <para style="p" vid="JHN 20:16">Ngo Maria momadutumu so milega-lega 'o Yesusika de kamongosekau de 'o Ibranioka manga demo, &lt;&lt;Rabuni!&gt;&gt; (Ngone tanu &lt;&lt; 'Aba Guru&gt;&gt;.)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />'O Yesus kawongosekau, &lt;&lt; 'Uwau noi'ao, sababu ngoi kotoliowasi 'ai Deade. Ma tagi nositotara 'ai riaka dodotika, de nosidemo 'ato ma 'orasi ne'ena ngoi tolio nanga Deade ge'ena la ma Jo'oungu ma Dutude.&gt;&gt;<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />So ngo Maria motagi mositotara 'o Yesus 'awi do-domoteika 'ato muna mimakekau ma Jou, de mositotara mita 'iodumu gee ma Jou wosikokidemokau munaka.<verse eid="JHN 20:18" /></para>
  <para style="s">'O Yesus womasidumutu 'awi do-domoteika</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat. 28:16-20</ref>; <ref loc="MRK 16:14-18">Mrk. 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk. 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Kage'enali ma Gareja ma wange 'iobiruku, 'o Yesus 'awi do-domoteke yomalomuno 'o woa moioka yomasidukucika, sababu yakidomodongo 'o Yahudioka manga balu-balusika. De 'o Yesus woboa woma'okode manga sigoronaka de kawongosekau, &lt;&lt;Tabea, 'Esa moi! Tanu ngini kaniosa-sanangi.&gt;&gt;<verse eid="JHN 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 20:20" />Koge'ena wongoseka de wakisidumutu 'awi giama de wi meseoso. Gee 'ona wimake ma Jou de yomorene ma sala. <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />Ge'enaka de 'o Yesus ma moiosi wongose 'onaka, &lt;&lt;Tabea! Tanu ngini kaniosa-sanangi. 'Isoka 'ai Dea woisuloko ngoi, koge'enali mita ne'ena ngoi tinisuloko ngini niotagi 'o duniaka ne'ena.&gt;&gt; <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Ge'enaka de 'una 'awi ngomasa wakisiuwaka 'onaka de kawongosekau, &lt;&lt;Niadawongo 'o Ngomasa 'Itebi-tebini. <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />Nako ngini niakisipidili 'o nyawa manga sowono, ma Jo'oungu ma Dutu mita wakisipidili manga sowono. Nako ngini koniakisipidiluwa 'o nyawa manga sowono, ma Jo'oungu ma Dutu mita kowakisipidiluwa.&gt;&gt;<verse eid="JHN 20:23" /></para>
  <para style="s">'O Yesus de 'o Tomas</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />'O Tomas gee wisironga 'o Sago, 'o do-domoteke gee yamogiooko de modidioka wimoi, 'una kowi'iwa ma 'orasi 'o Yesus woboa 'o do-domotekino go'ona. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />So 'o Yesus 'awi do-domoteke 'iregu-regu kayongosekau 'unaka, &lt;&lt;Ngomi mimakekau ma Jou!&gt;&gt;</para>
  <para style="p" vid="JHN 20:25">Ma 'o Tomas wosango, &lt;&lt;Nako ngoi kotamakewasi 'o paku ma rio 'awi giamoka, kotodonoawasi 'ai ra-raga 'awi daboka 'o paku ma rio gee, de kotodonoawasi 'ai giama 'awi meseoso ma daboka, ge'ena ka ma eta ma kotongakuwasi.&gt;&gt;<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />'O 'ahadi moi 'ipasa de 'o Yesus 'awi do-domoteke yomalomunoli ma ngiioka ge'ena, de 'o Tomas mita ge'enaka. 'O ngorana 'iodumu 'ikucioka. Ma 'o Yesus woboa de woma'okode manga sigoronaka, de kawongosekau, &lt;&lt;Tabea! Tanu ngini kaniosa-sanangi.&gt;&gt; <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Ge'enaka de 'o Yesus kawongosekau 'o Tomasika, &lt;&lt;Nalega 'ai giama de nodonoaku 'ani ra-raga ne'enaka. 'Ani giama nanoaku 'ai meseoso ma daboka. 'Ani singina 'uwau 'ikapulasi ma nongakukau!&gt;&gt;<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />'O Tomas kawongosekau 'o Yesusika, &lt;&lt;Ngona ge'ena to ngoi 'ai Jou ge'ena la ma Jo'oungu ma Dutu gee tonisuba-suba!&gt;&gt;<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />So 'o Yesus kawongosekau 'unaka, &lt;&lt;Ngona nongaku sababu noimakekau! Yosanangioka 'o nyawa gee yongaku ngaro koimakewa ma!&gt;&gt;<verse eid="JHN 20:29" /></para>
  <para style="s">'O buku ne'ena ma dumutu</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />'O gudaiosi 'o no-nako 'ihera-herangi gee 'o Yesus wodi-diai 'awi do-domoteke manga bionoka, ma koisitulisuwa ma bukuoka ne'ena. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Ma ne'ena 'iodumu 'isitulisuku, la ngini niongaku 'ato 'o Yesus ge'ena ma Koana 'o Nyawa Wosilaha-laha gu'una, ma Jo'oungu ma Dutu 'awi Ngowaka, la de nia ngo-ngaku 'unaka, ngini niamake 'o 'ahu 'ika-kakali.<verse eid="JHN 20:31" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">'O Yesus womasidumutu 'awi do-domoteke yatumudiingika</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Ge'ena 'iduanga de 'o Yesus ma moiosi womasidumutu 'awi do-domoteika 'o Tiberias ma talaga ma batingoka. Koneda 'idadi: <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Ma moi ge'ena 'o Simon Petrus, 'o Tomas gee wisironga 'o Sago, 'o Natanael 'o Kana ma soanino 'o Galileaka, 'o Zebedeus 'awi ngowa-ngowaka, de 'o Yesus 'awi do-domoteke 'iregu yamididi yomalomuno. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />De 'o Simon Petrus kawongosekau 'onaka, &lt;&lt;Ngoi tomau totagi 'o naoko totagoko.&gt;&gt;</para>
  <para style="p" vid="JHN 21:3">'Ona kayongosekau, &lt;&lt;Ngomi ma miomoteke.&gt;&gt; So 'ona yotagi 'o ngo'otiruku yoparene. Ma 'o obiri moi ge'ena 'ona ko 'okia-kiawa. <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />Gee 'o wange 'ikurue 'ibaoro de 'o Yesus woma'okode 'o talaga ma batingoka, ma 'ona kowinakowa 'ato 'una ge'ena 'o Yesus. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />'O Yesus kawongosekau 'onaka, &lt;&lt; 'Esa moi, ngini de nia naokoka?&gt;&gt;</para>
  <para style="p" vid="JHN 21:5">'Ona yosango, &lt;&lt;Koi'iwa.&gt;&gt;<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />'O Yesus kawongosekau, &lt;&lt; 'Ania soma nia'umo nia ngo'otiri ma ginirauku. Ngini 'asa nimadamake 'o naoko.&gt;&gt; Ge'enaka de manga soma ge'ena ya'umo, duga gee ya'umoku de koya'akunuawau yatobaka sababu ma naoko kage'enau ma gudaioka ma soma ma dodaka.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />'O do-domoteke gee 'o Yesus wisiboso-bosono de yogiamanai ma sala kawongosekau 'o Petrusika, &lt;&lt;Dokauda ge'ena ma Jou!&gt;&gt; 'O Simon Petrus wo'isenoka 'ato gu'una ma Jou, de womabaju (sababu 'una kowomabajukuwa) de womatebulu 'o 'akeruku wosikaisa 'o dudungisa. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />'O do-domoteke 'iregu-regu yotu'uru 'o dudungisa 'o ngo'otiruku ma de ma soma yotobaka ma naoko 'i'oma-'omanga. 'Ona 'o dudungoka 'ena koikurutokowa, poilia 'o meteri 'o ratusu moioko. <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />Gee 'ona yo'uti 'o dudungisa, de yamake 'o 'uku ma ngaboso ge'enaka de ma dekuoka 'o naoko de 'o roti. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />'O Yesus kawongosekau 'onaka, &lt;&lt;Bika nia'asano 'o naoko 'o ngai muruoni gee 'asa kaniatagokino.&gt;&gt;<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />'O Simon Petrus woparene 'o ngo'otirie de watobaka ma soma ge'ena 'o dudungisa. Ma soma ge'ena 'o naoko ya'oma-'omanga 'iodumu kaila-laagomo, 'o ngodumu ratusu moi de 'o nagi motoa de sa'angeka. De ngaro koge'ena ma gudaioka, 'o soma ge'ena koi'etonguwa. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />'O Yesus kawongosekau 'onaka, &lt;&lt;Nou po'odomo.&gt;&gt; 'O do-domoteke go'ona komoiwa yomoroini yosano 'unaka, &lt;&lt; 'Aba ngona nagu'una?&gt;&gt; Sababu 'ona yanakokau 'ato 'una ma Jou. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Ge'enaka de 'o Yesus womasisori 'onaka wa'ese 'o roti ge'ena de wakikula 'onaka. 'O naoko mita koge'enali wadiai.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Ne'ena ge'ena ma warasa ma sa'ange 'o Yesus womasidumutu 'awi do-domoteika, gedagee 'una wisimomikokali wosongenukou de.<verse eid="JHN 21:14" /></para>
  <para style="s">'O Yesus de 'o Petrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Yo'odomo yaduangino de 'o Yesus kawongosekau 'o Simon Petrusika, &lt;&lt;Ee Simon 'o Yohanes 'awi ngowaka, ngona de 'ona ne'ena, ngona? 'ifoloi noisibosono?&gt;&gt;</para>
  <para style="p" vid="JHN 21:15">'O Petrus wosango, &lt;&lt;Ma goungu Jou. Jou ngona nanako ngoi tonisibosono ngona.&gt;&gt;</para>
  <para style="p" vid="JHN 21:15">'O Yesus wosango, &lt;&lt;Nakisowohi 'o nyawa gee 'ingaku-ngaku ngoi, matero ka 'o domba yoso-sowohi yojaga manga domba.&gt;&gt;<verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Ma warasa ma modidi 'o Yesus wongose 'o Petrusika, &lt;&lt;Ee Simon 'o Yohanes 'awi ngowaka, ngona noisibosono ngoi?&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">'O Petrus wosango, &lt;&lt;Ma goungu Jou. Jou ngona nanako ngoi tonisibosono.&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">'O Yesus kawongosekau 'unaka, &lt;&lt;Nakisowohi 'o nyawa gee 'ingaku-ngaku ngoi, matero ka 'o domba yoso-sowohi yojaga manga domba.&gt;&gt;<verse eid="JHN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17" />Ma warasa ma sa'ange 'o Yesus wongose 'unaka, &lt;&lt;Ee Simon 'o Yohanes 'awi ngowaka, ngona noisibosono ngoi?&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">'O Petrus 'awi singina 'isusa sababu 'o Yesus wosano 'unaka sigado ma sa'ange. So 'o Petrus wosangoli, &lt;&lt;Jou, ngona nanako 'okia sonaa 'iodumu. Ngona nanako ngoi tonisibosono ngona Jou!&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">Ge'enaka de 'o Yesus kawongosekau 'unaka, &lt;&lt;Nakisowohi 'o nyawa 'ingaku-ngaku ngoi, matero ka 'o domba yoso-sowohi yojaga manga domba. <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />Ma gou-goungu 'itiai 'ai demo ne'ena: Ma 'orasi ngona ka 'o dogu'urunosi, ngona ma sirete 'ani gorona nabulu, de kiaka naga bato notagi moteke to ngona 'ani mau. Ma dua nako ngona noperekikou, ngona 'ani giama nodukulaka, de 'o nyawa 'iregu nipusuku de ni'asa kiaka naga gee ngona nooluika.&gt;&gt; <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />('O Yesus koge'ena wongose ge'ena wosidumutu kokia dua 'o Petrus wosongene, ma ngale wisitedene ma Jo'oungu ma Dutu.) Ge'ena 'iduanga de 'o Yesus kawongosekau 'o Petrusika, &lt;&lt;Tatapu noimoteke ngoi!&gt;&gt;<verse eid="JHN 21:19" /></para>
  <para style="s">'O Yesus de 'awi do-domoteke 'iregu</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Gedagee 'o Petrus womadutumu 'awi dudunoko de wimake 'o do-domoteke gee 'o Yesus wisiboso-bosono de yogiamanai ma sala. ('Unau ge'ena gee 'o 'orasi 'ipasa-pasa yomakadateuku de 'o Yesus ma 'orasi yo'odomo, de gee wosano 'o Yesusika 'ato, &lt;&lt;Jou, nago'ona dua niwukunu?&gt;&gt;) <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Wimakeka de 'o Petrus kawosanokau 'o Yesusika, &lt;&lt;Jou kokia nanuda?&gt;&gt;<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />'O Yesus wosango, &lt;&lt;Nako kogee ngoi tomau 'una kawo'ahu-'ahu sigado ngoi toboali, ge'ena ko to ngonawa 'ani 'aturu. Ma ngona tatapu noimoteke ngoi!&gt;&gt;<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />So ma habari ge'ena 'o do-domoteke yokoki'isenokau 'ato 'o do-domoteke gu'una dua kowosongenuwa. 'Ena momongo 'o Yesus kowongosewa 'ato 'o do-domoteke gu'una dua kowosongenuwa, ma 'ena wongose 'ato, &lt;&lt;Nako kogee ngoi tomau 'una kawo'ahu-'ahu sigado ngoi toboali, ge'ena ko to ngonawa 'ani 'aturu.&gt;&gt;<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />'O Yesus 'awi do-domoteke gu'unau gee wosisa-sakisii 'iodumu ne'ena. De 'unau mita wotulisi ne'ena. De ngone poodumu panako 'okia naga wongose ge'ena ma goungu 'itiai.<verse eid="JHN 21:24" /></para>
  <para style="s">'O demo ma sido-dogumu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />'Okia sonaa 'iregu-regu 'o gudaiosi gee 'o Yesus wokadi-diai. Nako kogee 'iodumu ge'ena patulisi pamoi-moi, ngoi tamao 'o duniaka ne'ena kayapailoka 'isidaoto ma buku gee dua 'ituli-tulisuku ge'ena.<verse eid="JHN 21:25" /></para>
  <para style="rem">Penyunting: Ning 17-7-2008 Edit Koreksi Penterjemah: Ning 25-7-2008</para>
  <chapter eid="JHN 21" />
</usx>