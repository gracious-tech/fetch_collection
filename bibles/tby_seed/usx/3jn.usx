<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">TABARU</book>
  <para style="h">3 YOHANES</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc3">3Yoh.</para>
  <para style="toc2">3 Yohanes</para>
  <para style="toc1">'O Paulus 'awi Surati ma Warasa ma Sa'ange</para>
  <para style="mt1">'O YOHANES 'AWI SURATI</para>
  <para style="mt1">MA WARASA MA SA'ANGE</para>
  <para style="imt">
    <char style="bk">'O Yohanes 'awi Surati ma Warasa ma Sa'ange ma Dumutu</char></para>
  <para style="ip">'O Yohanes nanga Jou Yesus 'awi do-domoteke de 'o jamati ma balusu, 'awi surati ma warasa ma sa'ange ne'ena wositago-tago 'o Gayusika. 'O Gayus 'una ge'ena 'o jamatioka wimoi 'awi ngo-ngaku 'ikua-kuata, de 'o Yohanes kawisiare-arene sababu woduaka wakiriwo 'o nyawa ma somoa yongaku-ngaku 'o Yesusika. 'O Yohanes wositiari mita 'o Gayusika la 'uwa wimaha-mahaka wimoi gee wi ronga 'o Diotrefes.</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />'Esa moi, Gayus, tonisiboso-bosono!</para>
  <para style="p" vid="3JN 1:1">Ngoi, ne'ena 'o jamati ma balusu gee ma gou-goungu tonidora-dora, <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />tolahidoa la kanosa-sanangi, 'Esa moi, de toga'asoko la 'okia sonaa moi-moi naga ngonaka 'iodumu kayaowa-owa 'isoka 'ani singinali mita kayaowa. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Tei, ngoi posironga tomorenoka gee yongaku-ngaku yamuruo naga yoboa de 'isidemo 'ato ngona posironga wonidomoteoka ma Jo'oungu ma Dutu, sababu ma gou-goungu ngona tatapu no'ahu moteke ma Jo'oungu ma Dutu 'awi do-dotoko. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ngoi tomorene 'ifoloi ge'ena duga kato'isene 'ato 'ai ngowa-ngowaka yo'ahu moteke ma Jo'oungu ma Dutu 'awi do-dotoko ge'ena la 'o do-dotoko 'iti-tiai.<verse eid="3JN 1:4" /></para>
  <para style="s">'O Gayus 'una kawingose-ngose 'ato 'una ge'ena 'o nyawa ma owa</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />'Esa moi tonisiboso-bosono! Ngona posironga de notangaroka nomanarama ma ngale nakileleani 'o nyawa yongaku-ngaku ngaro konakinako-nakowa ma. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />'Ona yosidemokau 'o jamatika gee mimanoa-noaka ma ngale 'ani dora. Tanu nakiriwo la 'idadi manga do-dagi yosigila. Koge'ena nadiai ma Jo'oungu ma Dutu wi singina 'isanangi. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Sababu manga do-dagioka ma ngale ma Kristus wisihabari, 'ona koyomasinganonuwa 'o nyawa-nyawaka gee ma Jo'oungu ma Dutu kowinako-nakowa. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Ge'enau so ngone pongaku-ngaku salingou pakiriwo nanga ma-manai gee 'isoka koge'ena dau, la ngone mita pomoteke to 'ona manga manaramoka ma ngale yosidagi 'o do-dotoko 'iti-tiai ma Jo'oungu ma Dutuno.<verse eid="3JN 1:8" /></para>
  <para style="s">'O Diotrefes de 'o Demetrius</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ngoi totulisokau 'o surati ma dipoko 'o jamatika, ma 'o Diotrefes gee womau wodadi 'o jamati ma balusu wooluku wodomoteke. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Dua nako ngoi toboa, 'asa de tosikokisupu 'iodumu gee wadi-diaiokau ge'ena la 'okia sonaa 'ito-torou de 'o ngeluku gee wosidemo-demo ma ngale mia ronga ma dorou wodiai. De wamaoku kowosanangiwasi de ge'ena 'iodumu. Gee nanga ma-manai yongaku-ngaku yoboa, 'una wakiitomo, de kiaka naga gee yakidawo-dawongo nanga 'esa moi go'ona, 'una kowosidabiwa de wakisuloko 'o nyawa-nyawa go'ona yosupu 'o jamatioka.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />'Esa moi tonisiboso-bosono, 'uwa nomaduru 'okia sonaa 'ito-torou, ma 'ena nomaduru gee yaowa-owa. 'O nyawa gee manga di-diai yaowa-owa, 'ona ge'ena ma Jo'oungu ma Dutuno. Ma nago'ona manga di-diai 'itorou, 'ona ge'ena kowinakowasi ma Jo'oungu ma Dutu.<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />'O Demetrius 'una ge'ena 'o nyawa yongaku-ngaku yoodumu yongose 'ato 'awi singina yaowa. 'Awi gokoieka mita 'iwai-waiti monga 'ato 'una ge'ena 'o nyawa ma owa. De ngomi mita miongose 'ato 'una ge'ena 'awi singina yaowa.<verse eid="3JN 1:12" /></para>
  <para style="s">Tabea</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />'Ena 'o gudai tanu tinisidemo, ma tamaoku 'ifoloi yaowa 'uwa ka de 'o surati. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ngoi tomau 'uwa 'ito'ingo de pomakamake la pomabi-bicara.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Tanu ma Jou wonisibarakati la 'ani singina 'ifoloi 'isanangi, 'Esa moi.</para>
  <para style="p" vid="3JN 1:15">'Ani ma-manai gee ngoi tomanoa-noaka ne'ena, manga tabea yosidingoto ngonaka. Nositotara 'ai tabea nanga ma-manaika nakisimoi-moi.<verse eid="3JN 1:15" /></para>
  <para style="rem">Penyunting: Ning 22-7-2008</para>
  <chapter eid="3JN 1" />
</usx>