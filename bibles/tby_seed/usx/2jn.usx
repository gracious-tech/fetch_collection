<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id" />
  <para style="h">2 YOHANES</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc3">2Yoh.</para>
  <para style="toc2">2 Yohanes</para>
  <para style="toc1">'O Paulus 'awi Surati ma Warasa ma Modidi</para>
  <para style="mt1">'O YOHANES 'AWI SURATI</para>
  <para style="mt1">MA WARASA MA MODIDI</para>
  <para style="imt">
    <char style="bk">'O Yohanes 'awi Surati ma Warasa ma Modidi ma Dumutu</char></para>
  <para style="ip">Nanga Jou Yesus 'awi do-domoteke wimoi wi ronga 'o Yohanes, 'una ge'ena 'o jamati ma balusu. 'Una wolefo 'awi surati ma warasa ma modidi ne'ena wositago-tago mimoika gee ma Jo'oungu ma Dutu womiiri-iriki, de 'ami ngowa-ngowakika gee 'o Yohanes wakisiboso-bosono. 'O ngeweka mimoi de 'ami ngowa-ngowaka ge'ena poilia kaisi'ade-'ade 'o jamati moi de ma nyawa-nyawa.</para>
  <para style="ip">'O surati ma dipoko ma dodaka ne'ena, 'o Yohanes woga'asoko 'o ngai modidi, ge'ena la yomakadora moi de moi, de yomasitiari 'o guru-guru ma ngelukika de manga do-dotoika.</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Ngoi ne'ena 'o jamati ma balusu tolefo 'o surati ne'ena, tositago-tago ngonaka, 'Esa, gee ma Jo'oungu ma Dutu woniiri-irikokau, de mita 'ani ngowa-ngowaika gee posironga tinisibosonoka. De duga ka ngoiwa tinisibosono so 'ena 'o nyawa 'iodumu gee ma Jo'oungu ma Dutu winako-nakokau. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Sababu ma Jo'oungu ma Dutu naga nanga singinaka, de 'una dua kaisi'ado-'adonika de de ngone.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Toga'asoko la 'o barakati, 'o simara'ai, de 'o singina ma sanangi nanga Dea ma Jo'oungu ma Dutuno de 'awi Ngowaka ma Yesus Kristusino dua naga koitogu-togumuwa ngoneka. Tanu ge'ena 'iodumu padawongo de nanga singina 'iti-tiai de nanga dora.<verse eid="2JN 1:3" /></para>
  <para style="s">'O do-dotoko 'iti-tiai de 'o dora</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Ngoi tomorene 'ifoloi sababu to'isene 'ato, 'Esa, 'ani ngowa-ngowaka naga de ma 'ena yo'ahu moteke ma Jo'oungu ma Dutu 'awi do-dotoko, gee 'isoka 'o 'Aba ma Jo'oungu ma Dutu wosulokokau ngoneno. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Ge'enau so 'Esa, ngoi toga'asoko la ngone poodumu pomasikamara'ai. Ngoi tositotara ne'ena ko 'o besesongo ma sungiwa; 'o besesongo ne'ena 'inakulakau ka gee ngone 'ikurue pongaku. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Pomakadora ge'ena ma ngale po'ahu moteke ma Jo'oungu ma Dutu 'awi besesongo. De 'o besesongo gee nio'isenokau ma sirasi, ge'ena la ngini salingou nimakadora moi de moi.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Yosiliba-liba manga gudaiokau 'o duniaka ne'ena, 'ona ge'ena koyongakuwa 'ato ma Yesus Kristus woboakau 'o duniano ge'ena ma gou-goungu wodadi 'o nyawa. 'O nyawa koge'ena ge'ena yotipu-tipu de ma Kristusika wimusu-musu. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Sababu ge'ena, niaka'eli niosidiaino 'okia naga gee minidu'usahanou. Niomariwo la niamake ma Jo'oungu ma Dutuno 'ania parasengi 'iodumu.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />'O nyawa gee koyomasiga-gaowa ma Kristus 'awi do-dotokika, so kayosiregu de gee 'okia naga wosidoto-dotoko, 'ona koyomarimoiwa de ma Jo'oungu ma Dutu. Nago'ona yomasiga-gao ma Kristus 'awi do-dotokoka, 'ona yomarimoi de 'o 'Aba ma Jo'oungu ma Dutu de 'awi Ngowaka. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Sababu ge'ena nako moikani yoboa de nisidotoko 'o do-dotoko gee ko ma Kristusuwa wosidoto-dotoko, 'uwa niakisidabino nia woano, de 'uwa niakitabea 'isoka 'o nyawa manga ngo-ngaku 'iti-tiai. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Sababu nago'ona yakitabea 'isoka 'o nyawa manga ngo-ngaku 'iti-tiai 'o nyawa koge'ena, 'ona mita yomotekokau de 'o nyawa gee 'o dorou yodi-diai.<verse eid="2JN 1:11" /></para>
  <para style="s">'O demo-demo 'isidu-du'uruokau</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />'Ena 'o gudai salingou tinisitotara, duga tamao 'ifoloi yaowa 'uwa ka de 'o surati. Ngoi tomau taika nginika de pomabi-bicara la nanga singina ma gou-goungu 'imorene.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />'Esa, 'ani dodoto 'ami ngowa-ngowaka gee ma Jo'oungu ma Dutu wakiiri-iriki mita, manga tabea yosidingoto ngonaka.<verse eid="2JN 1:13" /></para>
  <para style="rem">Penyunting: Ning 22-7-2008</para>
  <chapter eid="2JN 1" />
</usx>