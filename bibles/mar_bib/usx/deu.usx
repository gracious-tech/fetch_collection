<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="DEU" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">अनुवाद</para>
  <para style="toc1">अनुवादाचे पुस्तक</para>
  <para style="toc2">अनुवाद</para>
  <para style="toc3">अनु</para>
  <para style="mt1">अनुवादाचे पुस्तक</para>
  <chapter number="1" style="c" sid="DEU 1"/>
  <para style="s1">होरेब सोडण्याची आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1"/>इस्राएली लोक यार्देन नदीच्या पूर्वेस असणार्‍या रानातील अराबा नावाच्या दरीमध्ये तळ देऊन राहिले होते, त्यावेळी मोशे जे बोलला त्या सर्व गोष्टीची नोंद या पुस्तकात केलेली आहे. या प्रदेशात सूफ, पारान, तोफेल, लाबान, हसेरोथ व दीजाहाब इत्यादी शहरांचा समावेश होतो. <verse eid="DEU 1:1"/><verse number="2" style="v" sid="DEU 1:2"/>(सेईर डोंगरमार्गे होरेब ते कादेश-बरनेआपर्यंतचा प्रवास अकरा दिवसाचा होता.)<verse eid="DEU 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 1:3"/>चाळिसाव्या वर्षाच्या, अकराव्या महिन्याच्या पहिल्या दिवशी, याहवेहने आज्ञा केल्याप्रमाणे मोशेने इस्राएली लोकांना हे सर्व सांगितले. <verse eid="DEU 1:3"/><verse number="4" style="v" sid="DEU 1:4"/>हे मोशेने जाहीर करण्यापूर्वीच अमोर्‍यांचा राजा सीहोनाचा हेशबोन येथे पराभव करण्यात आला होता व एद्रेई जवळील अष्टारोथ येथे बाशानचा राजा ओगचाही पराभव करण्यात आला होता.<verse eid="DEU 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 1:5"/>यार्देनच्या पूर्वेकडील मोआब प्रदेशात मोशे इस्राएली लोकांशी नियमांसंबंधी बोलला. तो म्हणाला:<verse eid="DEU 1:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6"/>आपल्या याहवेह परमेश्वरांनी चाळीस वर्षांपूर्वी होरेब येथे आपल्याला सांगितले होते, “तुम्ही या पर्वताजवळ खूप दिवस राहिलात; <verse eid="DEU 1:6"/><verse number="7" style="v" sid="DEU 1:7"/>आता तुम्ही येथून जा व अमोर्‍यांचा डोंगराळ प्रदेश, अराबाची दरी, नेगेव, कनान व लबानोन आणि भूमध्य समुद्रकिनार्‍यापासून ते फरात<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fq" closed="false">फरात </char><char style="ft" closed="false">ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते</char></note> नदीच्या काठापर्यंत पसरलेल्या संपूर्ण प्रदेशात जाऊन वस्ती करा. <verse eid="DEU 1:7"/><verse number="8" style="v" sid="DEU 1:8"/>पाहा, मी हा सर्व प्रदेश तुम्हाला देत आहे. तुम्ही जा व तो प्रदेश हस्तगत करा. कारण याहवेहने तो प्रदेश अब्राहाम, इसहाक व याकोब या तुमच्या पूर्वजास व त्यांच्या वंशजास दिलेला वचनदत्त देश आहे.”<verse eid="DEU 1:8"/></para>
  <para style="s1">पुढार्‍यांची नेमणूक</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9"/>त्यावेळी मी तुम्हाला सांगितले होते, “माझ्या शक्तीपलीकडे असलेले मी एकट्यानेच वाहून नेणारे तुमचे मोठे ओझे माझ्यावर पडले आहे. <verse eid="DEU 1:9"/><verse number="10" style="v" sid="DEU 1:10"/>कारण याहवेह तुमच्या परमेश्वराने तुमची संख्या आकाशातील तार्‍यांप्रमाणे अगणित केली आहे, <verse eid="DEU 1:10"/><verse number="11" style="v" sid="DEU 1:11"/>याहवेह तुमच्या पूर्वजांच्या परमेश्वरांनी जे तुम्हाला अभिवचन दिले होते, त्यानुसार तुमची संख्या हजारपटीने वाढवो आणि तुम्हाला आशीर्वाद देवो! <verse eid="DEU 1:11"/><verse number="12" style="v" sid="DEU 1:12"/>तुमच्या समस्या, तुमचे ओझे व तुमची भांडणे माझ्यासारखा एकटा मनुष्य कसा सोडवू शकेल? <verse eid="DEU 1:12"/><verse number="13" style="v" sid="DEU 1:13"/>तेव्हा तुम्हीच प्रत्येक गोत्रांमधून सुज्ञ, समजूतदार व प्रतिष्ठित अशी काही माणसे निवडा, म्हणजे मी त्यांना तुमचे पुढारी नेमीन.”<verse eid="DEU 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 1:14"/>तुम्ही मला उत्तर देऊन म्हणाला, “तुम्ही जे करण्याचा प्रस्ताव दिला ते उत्तम आहे.”<verse eid="DEU 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 1:15"/>म्हणून मी तुमच्या प्रत्येक गोत्रांतून प्रमुख, ज्ञानी आणि आदरणीय पुरुष घेतले आणि त्यांना हजारांवर, शंभरांवर, पन्नासांवर व दहांवर प्रमुख व अधिकारी म्हणून नेमले. <verse eid="DEU 1:15"/><verse number="16" style="v" sid="DEU 1:16"/>आणि त्यावेळी मी तुमच्या न्यायाधीशांना आज्ञा केली, “तुमच्या लोकांचा वाद ऐकून त्यावर न्याय करावा, मग तो दोन इस्राएली लोकांमधील असो किंवा इस्राएली आणि तुमच्यामध्ये राहणारे परदेशी यांच्यातील असो. <verse eid="DEU 1:16"/><verse number="17" style="v" sid="DEU 1:17"/>न्याय करताना पक्षपातीपणा दाखवू नका; लहान व मोठे यांचे म्हणणे समानतेत ऐकून घ्या. कोणालाही घाबरू नका; कारण न्याय हा परमेश्वराकडूनच असतो. ज्या तक्रारी तुम्हाला सोडविण्यास कठीण वाटतील, त्या माझ्याकडे आणा आणि मी ऐकेन.” <verse eid="DEU 1:17"/><verse number="18" style="v" sid="DEU 1:18"/>आणि त्यावेळी मी तुम्हाला जे काही करावयाचे आहे ते सर्व सांगितले होते.<verse eid="DEU 1:18"/></para>
  <para style="s1">हेर पाठविले जातात</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19"/>नंतर आम्ही होरेब येथून प्रस्थान केले व जो तुम्ही पाहिला होता अशा अफाट आणि भयानक अशा अरण्यातून प्रवास करीत, याहवेह आमच्या परमेश्वराच्या आज्ञेप्रमाणे शेवटी अमोर्‍यांच्या डोंगराळ प्रदेशात पोहोचलो आणि आम्ही कादेश-बरनेआस आलो. <verse eid="DEU 1:19"/><verse number="20" style="v" sid="DEU 1:20"/>तेव्हा मी तुम्हाला सांगितले, “आता तुम्ही अमोर्‍यांच्या डोंगराळ प्रदेशात येऊन पोहोचला आहात, जो याहवेह आमचे परमेश्वर आम्हाला देणार आहेत. <verse eid="DEU 1:20"/><verse number="21" style="v" sid="DEU 1:21"/>पाहा, याहवेह तुमच्या परमेश्वराने हा देश तुम्हाला दिला आहे. तुमच्या पूर्वजांचे देव परमेश्वरांनी सांगितल्याप्रमाणे वर जा आणि तो आपल्या ताब्यात घ्या. घाबरू नका; निराश होऊ नका.”<verse eid="DEU 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22"/>तेव्हा तुम्ही सर्व लोक माझ्याकडे आले आणि म्हणाले, “आधी आपण आपले हेर पाठवू म्हणजे कुठल्या मार्गाने त्या देशात प्रवेश करावा व त्यांची कोणती शहरे लागतील हे शोधून काढणे सोपे होईल.”<verse eid="DEU 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 1:23"/>ही गोष्ट मला चांगली वाटली; म्हणून मी प्रत्येक गोत्रातून एक असे बारा हेर निवडले. <verse eid="DEU 1:23"/><verse number="24" style="v" sid="DEU 1:24"/>तिथून निघून ते डोंगराळ प्रदेशात पोहोचले आणि ते अष्कोल दरीपर्यंत आले व त्यांनी त्या प्रदेशाची पाहणी केली. <verse eid="DEU 1:24"/><verse number="25" style="v" sid="DEU 1:25"/>तिथून परत येताना त्यांनी त्या ठिकाणची फळे आपल्याबरोबर आणली व असा अहवाल दिला: “जो देश याहवेह आमचे परमेश्वर आम्हाला देत आहेत तो खरोखरच चांगला आहे.”<verse eid="DEU 1:25"/></para>
  <para style="s1">याहवेहविरुद्ध बंड</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 1:26"/>परंतु तुम्ही वर जाण्यास नाकारले व याहवेह तुमच्या परमेश्वराच्या आज्ञेविरुद्ध बंड केले. <verse eid="DEU 1:26"/><verse number="27" style="v" sid="DEU 1:27"/>आपल्या तंबूत बसून तुम्ही कुरकुर केली आणि म्हटले, “याहवेह आमचा द्वेष करीत आहेत, म्हणून अमोर्‍यांच्या हातून आमचा नाश व्हावा यासाठी त्यांनी आम्हाला इजिप्त देशातून इकडे आणले आहे. <verse eid="DEU 1:27"/><verse number="28" style="v" sid="DEU 1:28"/>आम्ही आता कुठे जावे? आमच्या हेरबंधूंच्या वार्तेमुळे आम्ही भयभीत झालो आहोत. ते म्हणतात की, ‘त्या देशातील लोक आपल्यापेक्षा धिप्पाड आणि बलवान आहेत. त्यांची नगरे खूप मोठी असून नगरतट तर इतके उंच आहेत की ते जणू काही आकाशाला भिडले आहेत. आम्ही तिथे अनाकाचे वंशज देखील पाहिले आहेत.’ ”<verse eid="DEU 1:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29"/>तेव्हा मी त्यांना म्हणालो, “असे भयभीत होऊ नका, त्यांना घाबरू नका. <verse eid="DEU 1:29"/><verse number="30-31" style="v" sid="DEU 1:30-31"/>कारण याहवेह तुमचे परमेश्वर तुमच्यापुढे जात आहेत, ते तुमच्यावतीने त्यांच्याशी लढतील, जसे तुमच्या डोळ्यादेखत त्यांनी इजिप्त देशात आणि अरण्यात असताना केले. ज्याप्रमाणे पिता आपल्या मुलांची सर्वतोपरी काळजी घेतो, त्याप्रमाणे याहवेह परमेश्वराने इथे पोहोचेपर्यंत तुमची सतत काळजी घेतली.”<verse eid="DEU 1:30-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 1:32"/>पण तरीही तुम्ही याहवेह तुमच्या परमेश्वरावर विश्वास ठेवण्याचे नाकारले. <verse eid="DEU 1:32"/><verse number="33" style="v" sid="DEU 1:33"/>ज्यांनी प्रवासात तुमच्यापुढे राहून रात्री अग्नीने आणि दिवसा मेघांनी तुमचे मार्गदर्शन केले, वाटेत विश्रांतीसाठी उत्तमोत्तम जागा निवडल्या, ते रात्री अग्नीने आणि दिवसा मेघांनी तुमचे मार्गदर्शन करीत.<verse eid="DEU 1:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="DEU 1:34"/>तुम्ही जे म्हटले ते याहवेहनी ऐकले आणि ते रागावले व त्यांनी शपथपूर्वक म्हटले: <verse eid="DEU 1:34"/><verse number="35" style="v" sid="DEU 1:35"/>“या पिढीतील एकाच्याही दृष्टीस मी त्यांच्या पूर्वजांना वचनदत्त केलेली उत्तम भूमी पडू देणार नाही. <verse eid="DEU 1:35"/><verse number="36" style="v" sid="DEU 1:36"/>परंतु यफुन्नेहचा पुत्र कालेब, जो मला पूर्णपणे अनुसरून चालला, त्याचे पाय ज्या भूमीला लागतील ती भूमी मी त्याच्या वंशजांना देईन, कारण तो याहवेहच्या मागे पूर्ण अंतःकरणाने चालला.”<verse eid="DEU 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37"/>तुमच्यामुळे याहवेह माझ्यावरही रागावले व म्हणाले, “तू या वचनदत्त देशात प्रवेश करणार नाहीस. <verse eid="DEU 1:37"/><verse number="38" style="v" sid="DEU 1:38"/>पण तुझा मदतनीस, नूनाचा पुत्र यहोशुआ प्रवेश करेल. तू त्याला प्रोत्साहन दे, कारण तो या वतनाचा ताबा घेण्यासाठी इस्राएली लोकांचे मार्गदर्शन करेल. <verse eid="DEU 1:38"/><verse number="39" style="v" sid="DEU 1:39"/>जी बालके पारतंत्र्यात जातील असे तुम्ही म्हणता, ज्यांना त्यांचे बरेवाईटही कळत नाही, त्यांना मी तो देश बहाल करेन आणि ते त्याला आपल्या ताब्यात घेतील. <verse eid="DEU 1:39"/><verse number="40" style="v" sid="DEU 1:40"/>परंतु तुम्ही मागे वळून वाळवंटातून तांबड्या समुद्राच्या वाटेने कूच करावे.”<verse eid="DEU 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41"/>तेव्हा लोकांनी कबुली दिली, “आम्ही याहवेहविरुद्ध पाप केले आहे; आम्ही आमच्या वचनदत्त देशात जाऊ व तो मिळविण्यासाठी याहवेह परमेश्वराच्या आज्ञेनुसार आम्ही वर जाऊन लढाई करू.” असे म्हणून त्यांना आपली शस्त्रे सरसावली. त्यांना वाटले की हा सर्व डोंगराळ प्रदेश आपण सहज जिंकून घेऊ.<verse eid="DEU 1:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="DEU 1:42"/>परंतु याहवेह मला म्हणाले, “त्यांना सांग, ‘लढाई करण्यास वर जाऊ नका, कारण मी तुमच्याबरोबर राहणार नाही. तुमचा तुमच्या शत्रूकडून पराभव होईल.’ ”<verse eid="DEU 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 1:43"/>तुम्हाला मी तसे सांगितले, पण तुम्ही माझे ऐकले नाही. उलट पुन्हा याहवेहच्या आज्ञेविरुद्ध बंड केले आणि धिटाई करून त्या डोंगराळ देशात शत्रूवर चाल करून गेले. <verse eid="DEU 1:43"/><verse number="44" style="v" sid="DEU 1:44"/>तिथे डोंगराळ देशात राहणार्‍या अमोर्‍यांनी तुमच्यावर चाल करून मधमाश्यांप्रमाणे सेईरपासून होरमाहपर्यंत तुमचा पाठलाग केला व तुम्हाला मार दिला. <verse eid="DEU 1:44"/><verse number="45" style="v" sid="DEU 1:45"/>यानंतर तुम्ही परत येऊन याहवेहसमोर शोक करू लागलात, परंतु त्यांनी तुमच्या रडण्याकडे लक्ष दिले नाही. <verse eid="DEU 1:45"/><verse number="46" style="v" sid="DEU 1:46"/>म्हणून तुम्ही कादेश येथेच दीर्घकाल राहिला, असे तुम्ही तिथे दिवस घालविले.<verse eid="DEU 1:46"/></para>
  <chapter eid="DEU 1"/>
  <chapter number="2" style="c" sid="DEU 2"/>
  <para style="s1">रानात भ्रमण</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1"/>नंतर आम्ही मागे वळून अरण्यामधून तांबड्या समुद्राकडे निघालो, कारण याहवेहनी मला तशी आज्ञा दिली होती आणि अनेक वर्षे आम्ही सेईर पर्वताच्या सभोवतालच्या प्रदेशात भ्रमण करीत राहिलो.<verse eid="DEU 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2"/>मग याहवेह मला म्हणाले, <verse eid="DEU 2:2"/><verse number="3" style="v" sid="DEU 2:3"/>“तुम्ही या पर्वताच्या सभोवती दीर्घकाल राहिला आहात, तर आता उत्तरेकडे वळा. <verse eid="DEU 2:3"/><verse number="4" style="v" sid="DEU 2:4"/>लोकांना आदेश दे: ‘सेईर येथे राहणार्‍या एसावाच्या वंशजाच्या, म्हणजे त्यांच्या एदोमी भाऊबंदांच्या देशातून ते पुढे जाणार आहेत. तुमची त्यांना भीती वाटेल, म्हणून तुम्ही खबरदारी घ्या. <verse eid="DEU 2:4"/><verse number="5" style="v" sid="DEU 2:5"/>त्यांना लढाईला प्रवृत्त करू नका, कारण त्यांची भूमी मी तुम्हाला देणार नाही, मी तुम्हाला तिथे पाऊल ठेवण्यासही जागा देणार नाही. मी सेईर पर्वताचा मुलूख एसावाला दिला आहे. <verse eid="DEU 2:5"/><verse number="6" style="v" sid="DEU 2:6"/>तुम्ही तिथे जे काही अन्न खाल व पाणी प्याल त्याच्या मोबदल्यात त्यांना चांदी द्या.’ ”<verse eid="DEU 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 2:7"/>याहवेह तुमच्या परमेश्वराने तुमच्या हाताच्या प्रत्येक कार्याला आशीर्वादित केले आहे. या विशाल अरण्यात तुमचे भटकणे त्यांनी पाहिले आहे, चाळीस वर्षे याहवेह तुमचे परमेश्वर तुमच्याबरोबर आहेत व तुम्हाला कशाचेही उणे पडले नाही.<verse eid="DEU 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8"/>म्हणून आम्ही सेईर येथे राहणाऱ्या एसावाच्या वंशातील भाऊबंदांच्या देशाला वळसा घालून दक्षिणेकडे एलाथ व एजिओन-गेबेरकडे जाणारा अराबाचा रस्ता पार करून उत्तरेकडे प्रवास करीत मोआब वाळवंटाकडे निघालो.<verse eid="DEU 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 2:9"/>तेव्हा याहवेह आम्हाला म्हणाले, “मोआबी लोकांना उपद्रव किंवा लढाईसाठी प्रवृत करू नका, कारण मी त्यांच्या देशाचा कोणताही भाग वतन म्हणून तुम्हाला देणार नाही. मी लोटाच्या वंशजांना आर प्रदेश वतन म्हणून दिला आहे.”<verse eid="DEU 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10"/>(एमी लोक त्या भागात राहात होते—बलवान व बहुसंख्य आणि अनाकी लोकांसारखे उंच असे होते. <verse eid="DEU 2:10"/><verse number="11" style="v" sid="DEU 2:11"/>एमी व अनाकी या दोन्हीही जमातीस पुष्कळदा रेफाईम असेही म्हणत, पण मोआबी मात्र त्यांना एमीच म्हणत. <verse eid="DEU 2:11"/><verse number="12" style="v" sid="DEU 2:12"/>पूर्वीच्या काळी होरी लोक सेईरमध्ये राहत असत, परंतु एसावाचे वंशज एदोमींनी त्यांना तिथून घालवून दिले व तिथे वस्ती केली. याहवेहने वतन दिलेल्या प्रदेशातून ज्याप्रमाणे इस्राएली लोकांनी तेथील लोकांना घालवून दिले होते त्याचप्रमाणे.)<verse eid="DEU 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13"/>आणि याहवेह म्हणाले, “आता उठा आणि जेरेद ओहोळ पार करून जा.” तेव्हा आम्ही ओहोळ पार केला.<verse eid="DEU 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 2:14"/>पण कादेश-बरनेआहून निघून जेरेद ओहोळ ओलांडून जाण्यास आम्हाला तब्बल अडतीस वर्षे लागली, कारण याहवेहने घेतलेल्या शपथेमुळे लढाऊ पुरुषांची संपूर्ण पिढी छावणीतून नष्ट झाली होती. <verse eid="DEU 2:14"/><verse number="15" style="v" sid="DEU 2:15"/>त्या सर्वांचा नाश होईपर्यंत छावणीतून त्यांचा संहार करावा म्हणून याहवेहचा हात त्यांच्यावर उगारलेला होता.<verse eid="DEU 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16"/>आता जेव्हा या लोकांमधील शेवटचा योद्धा मरण पावला, <verse eid="DEU 2:16"/><verse number="17" style="v" sid="DEU 2:17"/>याहवेह मला म्हणाले, <verse eid="DEU 2:17"/><verse number="18" style="v" sid="DEU 2:18"/>“आज तुम्हाला आर येथे मोआबाची सीमा ओलांडून जायचे आहे. <verse eid="DEU 2:18"/><verse number="19" style="v" sid="DEU 2:19"/>जेव्हा तुम्ही अम्मोनी लोकांच्या भूमीत प्रवेश कराल, अम्मोनी लोकांना त्रास देऊ नका, कारण मी त्यांचा कोणताही प्रदेश तुम्हाला देणार नाही, तो सर्व मी लोटाच्या वंशजांना वतनादाखल दिला आहे.”<verse eid="DEU 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20"/>(तो देश तिथे राहाणाऱ्या रेफाईम लोकांचा देखील मानला जात होता; परंतु अम्मोनी लोक त्यांना जमजुम्मी म्हणत. <verse eid="DEU 2:20"/><verse number="21" style="v" sid="DEU 2:21"/>त्यांच्या वंशातील लोक धिप्पाड आणि संख्येने पुष्कळ होते. ते अनाकी लोकांइतके उंच होते, परंतु अम्मोनी लोकांपुढून त्यांना याहवेहने घालवून दिले व त्यांच्या नाश केला. त्यांच्या जागी अम्मोन्यांनी त्या देशात वस्ती केली. <verse eid="DEU 2:21"/><verse number="22" style="v" sid="DEU 2:22"/>जेव्हा तिथे राहणार्‍या होरी लोकांना त्यांनी घालवून लावले व त्यांचा नाश केला. त्यांनी त्यांना हुसकावून लावले आणि आजपर्यंत त्यांच्या जागी ते वस्ती करून राहत आहेत, त्याचप्रमाणे सेईर येथे राहाणाऱ्या एसावाच्या वंशजांसाठीही याहवेहने असेच केले. <verse eid="DEU 2:22"/><verse number="23" style="v" sid="DEU 2:23"/>गाझा शहरापर्यंत विखुरलेल्या गावातून वस्ती करून राहिलेल्या अव्वी लोकांवर कफतोरहून आलेल्या कफतोरी लोकांनी हल्ला चढवून त्यांचा संहार केला व त्या ठिकाणी वस्ती केली.)<verse eid="DEU 2:23"/></para>
  <para style="s1">हेशबोनचा राजा सीहोनचा पराभव</para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24"/>“आता उठा आणि आर्णोन नदी ओलांडून जा. पाहा, हेशबोनचा राजा अमोरी सीहोन आणि त्याचा देश मी तुमच्या हाती दिला आहे. तो देश ताब्यात घेण्यास सुरुवात करा व त्याच्याशी युद्ध करा. <verse eid="DEU 2:24"/><verse number="25" style="v" sid="DEU 2:25"/>आजपासून पुढे मी असे करेन की अखिल पृथ्वीतलावरील लोक तुमच्यापुढे भीतीने थरथर कापतील व तुमच्या आगमनाची चाहूल लागताच दहशत घेतील.”<verse eid="DEU 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26"/>नंतर शांततेची बोलणी करण्याकरिता मी केदेमोथच्या रानातून हेशबोनचा राजा सीहोनकडे दूत पाठवून म्हटले, <verse eid="DEU 2:26"/><verse number="27" style="v" sid="DEU 2:27"/>“आम्हाला तुझ्या देशामधून जाऊ दे. आम्ही मुख्य रस्त्यावरच राहू; उजवीकडे वा डावीकडे वळणारही नाही. <verse eid="DEU 2:27"/><verse number="28" style="v" sid="DEU 2:28"/>आम्ही वाटेने जात असताना तुमचे अन्न व पाणी तुमच्याकडून चांदीच्या किमतीत विकत घेऊ. तुमच्या देशातून पायी चालत जाण्याची फक्त आम्हाला परवानगी द्या— <verse eid="DEU 2:28"/><verse number="29" style="v" sid="DEU 2:29"/>सेईरमध्ये राहणारे एसावाचे वंशज आणि आरवासी मोआबी यांनी आमच्यासाठी केले—आम्ही यार्देन ओलांडून याहवेह आमचे परमेश्वर आम्हाला देत असलेल्या देशात जाईपर्यंत तुम्ही आमच्यासोबत करा.” <verse eid="DEU 2:29"/><verse number="30" style="v" sid="DEU 2:30"/>परंतु हेशबोनाच्या सीहोन राजाने आम्हाला जाण्यास परवानगी दिली नाही. याहवेह तुमच्या परमेश्वराने त्याला तुमच्या हातात देण्यासाठी त्याचा आत्मा हट्टी आणि त्याचे हृदय कठीण केले होते.<verse eid="DEU 2:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31"/>मग याहवेह म्हणाले, “सीहोन राजाचा देश तुम्हाला देण्यास मी आता सुरुवात केली आहे. जेव्हा तुम्ही तो देश ताब्यात घ्याल, तेव्हा तो कायमचा तुमच्या मालकीचा होईल.”<verse eid="DEU 2:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 2:32"/>सीहोन आणि त्याची सर्व सेना आमच्यासोबत युद्ध करण्यास याहस येथे एकत्रित झाली, <verse eid="DEU 2:32"/><verse number="33" style="v" sid="DEU 2:33"/>परंतु याहवेह आमच्या परमेश्वराने त्याला आमच्या अधीन केले, आम्ही त्याला, त्याच्या पुत्रांसह संपूर्ण सेनेला चिरडून टाकले. <verse eid="DEU 2:33"/><verse number="34" style="v" sid="DEU 2:34"/>त्यावेळी आम्ही त्याची सर्व नगरे घेतली. त्यांच्या सर्वांचा नाश केला—पुरुष, स्त्रिया आणि मुले. आम्ही कोणालाही जिवंत सोडले नाही. <verse eid="DEU 2:34"/><verse number="35" style="v" sid="DEU 2:35"/>फक्त त्यांची गुरे जिवंत ठेवली. त्यांची नगरे काबीज करून ती सर्व संपत्ती आम्ही घेतली. <verse eid="DEU 2:35"/><verse number="36" style="v" sid="DEU 2:36"/>आर्णोन खोर्‍याच्या कडेला असलेल्या अरोएर शहरापासून खोर्‍यातील शहरापर्यंत व त्या शहरापासून गिलआदापर्यंत एकही दुर्गम शहर राहिले नाही. याहवेह आमच्या परमेश्वराने हे सर्व आमच्या अधीन करून दिले. <verse eid="DEU 2:36"/><verse number="37" style="v" sid="DEU 2:37"/>मात्र याहवेह आमच्या परमेश्वराच्या आज्ञेनुसार अम्मोनी लोकांच्या प्रदेशापासून आम्ही दूरच राहिलो. तसेच यब्बोक नदी व त्या डोंगराळ प्रदेशात वसलेल्या शहरापासूनही आम्ही दूर राहिलो.<verse eid="DEU 2:37"/></para>
  <chapter eid="DEU 2"/>
  <chapter number="3" style="c" sid="DEU 3"/>
  <para style="s1">बाशानचा राजा ओगचा पराजय</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1"/>मग आम्ही वळलो आणि बाशानाच्या वाटेने वर गेलो आणि बाशानचा राजा ओग आपले सर्व सैन्य जमवून आमच्याशी युद्ध करण्यासाठी एद्रेई येथे आला. <verse eid="DEU 3:1"/><verse number="2" style="v" sid="DEU 3:2"/>याहवेहने मला म्हटले, “त्याला भिऊ नकोस; कारण मी त्याला व त्याच्या सर्व सैन्याला तुझ्या हाती दिले आहे. अमोर्‍यांचा राजा सीहोन जो हेशबोनात राज्य करीत होता त्याचे तू जसे केले तसेच याचे कर.”<verse eid="DEU 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 3:3"/>याप्रमाणे याहवेह आमच्या परमेश्वराने बाशानचा ओग राजा त्याच्या सर्व सैन्यासह आमच्या अधीन झाला. आम्ही त्यांचा असा संहार केला की त्यांच्यातील कोणीही मागे जिवंत राहिला नाही. <verse eid="DEU 3:3"/><verse number="4" style="v" sid="DEU 3:4"/>त्याची सगळी शहरे आम्ही त्यावेळी घेतली होती. अर्गोबचा संपूर्ण प्रदेश आणि बाशानमधील ओगचे राज्य, साठ नगरातील असे एकही शहर राहिले नाही जे आम्ही त्यांच्याकडून घेतले नाही. <verse eid="DEU 3:4"/><verse number="5" style="v" sid="DEU 3:5"/>या सर्व शहरांच्या तटबंदी उंच व दरवाजे लोखंडी गजांचे होते. शिवाय बरीच तटबंदी नसलेली गावेही होती. <verse eid="DEU 3:5"/><verse number="6" style="v" sid="DEU 3:6"/>ज्याप्रकारे आपण सीहोन राज्याचा हेशबोन येथे नाश केला, त्याच प्रकारे आपण बाशानच्या राज्यातील संपूर्ण शहरांचा—पुरुष, स्त्रिया व मुले यासहित समूळ नायनाट केला. <verse eid="DEU 3:6"/><verse number="7" style="v" sid="DEU 3:7"/>पण त्यांची सर्व गुरे व शहरातून मिळालेली लूट आपण आपल्यासाठी नेली.<verse eid="DEU 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8"/>म्हणून आपल्या ताब्यात दोन्हीही राजांचे सर्व प्रदेश, म्हणजे यार्देनेच्या पूर्वेकडे आर्णोन खिंडीपर्यंत असलेला हर्मोन पर्वतापर्यंतचा अमोर्‍यांचा सर्व प्रदेश आपल्या ताब्यात आला. <verse eid="DEU 3:8"/><verse number="9" style="v" sid="DEU 3:9"/>(सीदोनी लोक हर्मोन पर्वतास सिर्योन असेही म्हणत, पण अमोरी लोक त्याला सनीर म्हणत असत.) <verse eid="DEU 3:9"/><verse number="10" style="v" sid="DEU 3:10"/>आतापर्यंत आपण पठारावरील सर्व शहरे, संपूर्ण गिलआद आणि बाशान, सलेकाह व एद्रेई, ओग या शहरांपर्यंतची सर्व शहरे काबीज केली. <verse eid="DEU 3:10"/><verse number="11" style="v" sid="DEU 3:11"/>(रेफाईम लोकांपैकी बाशानचा राजा ओग हा शेवटचा होता. त्याचा पलंग लोखंडाने सजविला होता आणि तो चार हात लांब आणि दोन हात रुंद होता.<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">अंदाजे 4 मीटर लांब, 1.8 मीटर रुंद</char></note> तो अजूनही अम्मोनी लोकांच्या राब्बाहमध्ये आहे.)<verse eid="DEU 3:11"/></para>
  <para style="s1">देशाची वाटणी</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12"/>त्यावेळी आपण काबीज केलेला प्रदेश मी रऊबेन व गाद यांच्या वंशास दिला. रऊबेन व गादच्या वंशांना मी आर्णोन नदीवरील अरोएरापासून गिलआद पर्वताचा अर्धा भाग त्यातील शहरांसह दिला. <verse eid="DEU 3:12"/><verse number="13" style="v" sid="DEU 3:13"/>गिलआद पर्वताचा उरलेला अर्धा भाग आणि ओग राजाचे पूर्वीचे राज्य म्हणजे अर्गोब विभाग हा मनश्शेहच्या अर्ध्या गोत्रास दिला. (बाशानच्या अर्गोब प्रदेशाला रेफाईमचा देश असेही म्हणत. <verse eid="DEU 3:13"/><verse number="14" style="v" sid="DEU 3:14"/>मनश्शेहच्या वंशातील याईराच्या कुळाने गशूरी व माकाथी लोकांच्या सीमेपर्यंतचा अर्गोबचा संपूर्ण प्रदेश आपल्या ताब्यात घेतला; त्याच्या नावावरून त्या प्रदेशाचे नाव पडले, त्यामुळे आजपर्यंत बाशानाला हव्योथ याईर<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">याईराची वस्ती</char></note> म्हणतात.) <verse eid="DEU 3:14"/><verse number="15" style="v" sid="DEU 3:15"/>आणि मी गिलआद देश माखीरला दिला. <verse eid="DEU 3:15"/><verse number="16" style="v" sid="DEU 3:16"/>रऊबेन आणि गाद यांना मात्र गिलआद देशातील यब्बोक नदीपासून ते आर्णोन नदीच्या खोर्‍याच्या मध्यापर्यंतचा सर्व भाग मिळाला. गिलआद ही अम्मोन लोकांची सीमा होती. <verse eid="DEU 3:16"/><verse number="17" style="v" sid="DEU 3:17"/>तसेच किन्नेरेथाच्या समुद्रापासून अराबाचा समुद्र (म्हणजे मृत समुद्र) आणि पिसगाच्या उतरणी खालील अराबा व यार्देनेच्या पश्चिमेकडील सर्व प्रदेशही त्यांनाच मिळाला.<verse eid="DEU 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18"/>त्यावेळी मी तुम्हाला आज्ञा दिली: “याहवेह तुमच्या परमेश्वराने हा प्रदेश तुम्हाला वतन म्हणून दिलेला आहे, परंतु तुम्ही त्यात वस्ती करण्यापूर्वी तुमच्या सक्षम योद्ध्यांना शस्त्रे धारण करून यार्देन ओलांडून इतर इस्राएलाच्या पुढे पाठवावे. <verse eid="DEU 3:18"/><verse number="19" style="v" sid="DEU 3:19"/>तुमच्या स्त्रिया, मुले आणि तुमची जनावरे (मला माहीत आहे तुमच्याकडे विपुल गुरे आहेत) यांना मी तुम्हाला दिलेल्या शहरात राहता येईल, <verse eid="DEU 3:19"/><verse number="20" style="v" sid="DEU 3:20"/>यार्देनेच्या पश्चिमेला याहवेह देत असलेल्या देशात तुमचे इस्राएली बांधव वस्ती करेपर्यंत आणि याहवेह तुमच्या परमेश्वराने ज्याप्रमाणे तुम्हाला विसावा दिला आहे, त्याप्रमाणे त्यांनाही विसावा मिळेपर्यंत, तुमच्या बांधवांना मदत करा. त्यानंतर जो प्रदेश मी तुम्हाला दिला आहे येथे तुम्ही आपल्या वतनावर परत यावे.”<verse eid="DEU 3:20"/></para>
  <para style="s1">मोशेला यार्देनेपलीकडे जाण्यास मनाई</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21"/>नंतर मी यहोशुआस म्हणालो: “याहवेह तुझ्या परमेश्वराने सीहोन व ओग या दोन राजांचे काय केले हे तू आपल्या डोळ्याने पाहिले आहेस. तुम्ही जिथे जात आहात तेथील सर्व राज्यांचेही याहवेह असेच करतील. <verse eid="DEU 3:21"/><verse number="22" style="v" sid="DEU 3:22"/>त्यांना तू भिऊ नको; कारण याहवेह तुझे परमेश्वर स्वतः तुझ्यासाठी त्यांच्याशी लढतील.”<verse eid="DEU 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23"/>त्यावेळी मी याहवेहला विनवणी केली: <verse eid="DEU 3:23"/><verse number="24" style="v" sid="DEU 3:24"/>“हे सार्वभौम याहवेह, तुमची महानता आणि तुमचा बलवान हात तुमच्या दासाला दाखविण्यास तुम्ही आरंभ केला आहे. स्वर्गात किंवा पृथ्वीवर असे कोणते दैवत आहे की, ज्याला तुमच्यासारखी थोर व महान कृत्ये करता येतील? <verse eid="DEU 3:24"/><verse number="25" style="v" sid="DEU 3:25"/>हे प्रभो, मला जाऊ द्या आणि यार्देनच्या पलीकडील उत्तम जमीन पाहू द्या—तो उत्तम डोंगराळ प्रदेश आणि लबानोन.”<verse eid="DEU 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 3:26"/>पण तुमच्यामुळे याहवेह माझ्यावर रागावले आणि त्यांनी त्या वचनदत्त देशात मला जाऊ दिले नाही. ते मला म्हणाले, “पुरे कर. ही गोष्ट पुन्हा माझ्याजवळ काढू नकोस. <verse eid="DEU 3:26"/><verse number="27" style="v" sid="DEU 3:27"/>पिसगा पर्वताच्या शिखरावर जा आणि तिथून पूर्व, पश्चिम, उत्तर व दक्षिण दिशांना पाहा. तिथून दूरवर तुला तो देश दिसेल, कारण तुला यार्देन ओलांडून जाता येणार नाही. <verse eid="DEU 3:27"/><verse number="28" style="v" sid="DEU 3:28"/>पण तुझ्या जागी यहोशुआची नेमणूक कर. त्याला उत्तेजन दे, धैर्य दे, कारण तोच आपल्या लोकांना पलीकडे घेऊन जाईल आणि जो प्रदेश तुझ्या दृष्टीस पडेल तो त्यांना वतन करून देईल.” <verse eid="DEU 3:28"/><verse number="29" style="v" sid="DEU 3:29"/>म्हणून आम्ही बेथ-पौरातील खोर्‍यातच मुक्काम केला.<verse eid="DEU 3:29"/></para>
  <chapter eid="DEU 3"/>
  <chapter number="4" style="c" sid="DEU 4"/>
  <para style="s1">आज्ञापालनाविषयी बोध</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1"/>आता, अहो इस्राएली लोकहो, मी जे विधी व नियम तुम्हाला शिकवणार आहे ते ऐका. त्यांचे पालन करा म्हणजे जिवंत राहाल आणि याहवेह तुमच्या पूर्वजांचे परमेश्वर तुम्हाला देत आहेत, तो देश ताब्यात घ्या. <verse eid="DEU 4:1"/><verse number="2" style="v" sid="DEU 4:2"/>याहवेह तुमच्या परमेश्वराच्या आज्ञा मी तुम्हाला देत आहे त्यांचे तुम्ही फक्त पालन करा, त्यात काही भर घालू नका आणि काही कमी करू नका.<verse eid="DEU 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 4:3"/>बआल—पौर येथे याहवेहने काय केले हे तुम्ही आपल्या डोळ्याने पाहिले आहे. याहवेह तुमच्या परमेश्वराने बआल-पौराच्या मागे चालणार्‍या सर्वांचा नाश केला, <verse eid="DEU 4:3"/><verse number="4" style="v" sid="DEU 4:4"/>पण याहवेह तुमच्या परमेश्वराशी एकनिष्ठ राहिलेले तुम्ही सर्वजण आजही जिवंत आहात.<verse eid="DEU 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5"/>पाहा, मी तुम्हाला याहवेह माझ्या परमेश्वराच्या आज्ञेप्रमाणे दिलेले विधी व नियम यासाठी शिकविले की जो देश तुम्ही ताब्यात घेणार आहात, त्या देशात तुमचा प्रवेश होईल, त्यावेळी ते तुम्ही पाळावे. <verse eid="DEU 4:5"/><verse number="6" style="v" sid="DEU 4:6"/>तुम्ही जर ते पाळले तर तुम्ही सुज्ञ व समंजस आहात अशी तुमची किर्ती होईल. जेव्हा सभोवतालची राष्ट्रे या नियमांविषयी ऐकतील तेव्हा ती म्हणतील, “इस्राएली राष्ट्रातील लोक निश्चितच बुद्धिमान व समंजस आहेत.” <verse eid="DEU 4:6"/><verse number="7" style="v" sid="DEU 4:7"/>याहवेह आपले परमेश्वर जसे आपण त्यांना प्रार्थना करतो तेव्हा ते आपल्या समीप असतात त्याप्रमाणे दुसरे कोणते महान राष्ट्र आहे ज्याचे देव त्यांच्या समीप असतात? <verse eid="DEU 4:7"/><verse number="8" style="v" sid="DEU 4:8"/>आणि एवढे महान राष्ट्र कोणते आहे, ज्याचे विधी आणि नियम या नियमशास्त्रासारखे न्याय्य आहेत, जे मी आज तुमच्यासमोर मांडणार आहे?<verse eid="DEU 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 4:9"/>तुम्ही स्वतःबद्दल जागरूक असणे आणि स्वतःची काळजी घेणे खूप आवश्यक आहे, जेणेकरून तुम्ही स्वतःच्या डोळ्यांनी पाहिलेल्या गोष्टी विसरून जाऊ नये आणि आयुष्यभर त्या तुमच्या स्मरणातून निघून जाऊ नये. तुम्ही ते तुमच्या पुत्रांना आणि त्यांच्यानंतर त्यांच्या पुत्रांना शिकवा. <verse eid="DEU 4:9"/><verse number="10" style="v" sid="DEU 4:10"/>ज्या दिवशी तुम्ही होरेब पर्वताजवळ याहवेह तुमच्या परमेश्वरासमोर उभे होता, त्या दिवसाविषयी त्यांना सांगा. त्या दिवशी याहवेहनी मला म्हणाले होते, “माझ्यासमोर सर्व लोकांना माझे शब्द ऐकण्यासाठी एकत्र कर, म्हणजे ते पृथ्वीवर जिवंत असेपर्यंत माझा आदर करतील आणि आपल्या मुलाबाळांना माझे शब्द शिकवतील.” <verse eid="DEU 4:10"/><verse number="11" style="v" sid="DEU 4:11"/>मग तुम्ही जवळ येऊन त्या पर्वताच्या पायथ्याशी जाऊन उभे राहिलात आणि पर्वत अग्नीने पेटला होता, त्याची ज्वाला आकाशापर्यंत पोहोचली होती, सर्वत्र अंधार, ढग आणि घनदाट अंधकार पसरला होता. <verse eid="DEU 4:11"/><verse number="12" style="v" sid="DEU 4:12"/>मग याहवेह तुमच्याशी अग्नीतून बोलले, तुम्ही त्यांचे शब्द ऐकले, परंतु त्यांची आकृती तुम्हाला दिसली नाही; फक्त वाणी ऐकली. <verse eid="DEU 4:12"/><verse number="13" style="v" sid="DEU 4:13"/>त्यांनी आपला करार तुम्हाला घोषित केला, दहा आज्ञा, ज्या पालन करण्याची त्यांनी आज्ञा दिली आणि त्यांनी त्या दोन दगडी पाट्यांवर लिहिल्या. <verse eid="DEU 4:13"/><verse number="14" style="v" sid="DEU 4:14"/>आणि त्यावेळी याहवेहने मला आज्ञा केली की तुम्ही यार्देन ओलांडून जो देश ताब्यात घेणार आहात तिथे तुम्हाला जे विधी व नियम पाळायचे आहेत ते शिकवावे.<verse eid="DEU 4:14"/></para>
  <para style="s1">मूर्तिपूजेस सक्त मनाई</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15"/>याकरिता सावधगिरी बाळगा, कारण याहवेह तुमच्याशी होरेब पर्वतावर अग्नीमधून बोलले, त्यावेळी त्यांची काहीही आकृती तुमच्या दृष्टीस पडली नाही; <verse eid="DEU 4:15"/><verse number="16" style="v" sid="DEU 4:16"/>म्हणून कोणत्याही पुरुष अथवा स्त्रीच्या आकाराची कोरीव मूर्ती करून तुम्ही स्वतःला भ्रष्ट करू नये, <verse eid="DEU 4:16"/><verse number="17" style="v" sid="DEU 4:17"/>किंवा पृथ्वीवरील एखाद्या पशूची किंवा आकाशात उडणार्‍या कोणत्याही पक्ष्याची, <verse eid="DEU 4:17"/><verse number="18" style="v" sid="DEU 4:18"/>अथवा जमिनीवर रांगणार्‍या कोणत्याही प्राण्याची किंवा पृथ्वीच्या खाली जलामध्ये असणार्‍या कोणत्याही मत्स्याची तुम्ही प्रतिमा करू नये. <verse eid="DEU 4:18"/><verse number="19" style="v" sid="DEU 4:19"/>जेव्हा तुम्ही वर आकाशाकडे बघाल आणि तुम्हाला सूर्य, चंद्र व तारे—आकाशातील सर्व नक्षत्र—दिसतील, तेव्हा त्यांची उपासना करण्याच्या आणि त्यांना दंडवत घालण्याच्या मोहात पडू नका. याहवेह तुमच्या परमेश्वराने आकाशाखाली असलेल्या पृथ्वीतलावरील इतर राष्ट्रांना ते वाटून दिले आहेत. <verse eid="DEU 4:19"/><verse number="20" style="v" sid="DEU 4:20"/>परंतु याहवेहने तुम्हाला इजिप्तच्या तप्त लोखंडी भट्टीतून यासाठी सोडवून आणले की, तुम्ही त्यांचे खास निवडलेले लोक, त्यांचे वारसदार व्हावे, जसे तुम्ही आज आहात.<verse eid="DEU 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21"/>पण तुमच्यामुळेच याहवेह माझ्यावर रागावले होते. त्यांनी मला शपथपूर्वक सांगितले आणि याहवेह तुमच्या परमेश्वरांनी वतनादाखल दिलेल्या त्या उत्तम देशात यार्देन ओलांडून तुला जाता येणार नाही. <verse eid="DEU 4:21"/><verse number="22" style="v" sid="DEU 4:22"/>तुला याच देशात मरावे लागणार; मी यार्देन पार करू शकणार नाही; परंतु तुम्ही मात्र पार करून तो उत्तम प्रदेश वतन म्हणून ताब्यात घ्याल. <verse eid="DEU 4:22"/><verse number="23" style="v" sid="DEU 4:23"/>तेव्हा सावधगिरी बाळगा, नाहीतर याहवेह तुमच्या परमेश्वराने मनाई केलेल्या वस्तूंची तुम्ही स्वतःसाठी कोरीव प्रतिमा कराल आणि याहवेह तुमच्या परमेश्वराच्या कराराचे तुम्हाला विस्मरण होईल. <verse eid="DEU 4:23"/><verse number="24" style="v" sid="DEU 4:24"/>कारण याहवेह तुमचे परमेश्वर भस्म करणारे अग्नी व ईर्ष्यावान असे परमेश्वर आहेत.<verse eid="DEU 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25"/>तुम्हाला जेव्हा मुले आणि नातवंडे होतील आणि त्या देशात तुम्ही बराच काळ वास्तव्य केल्यावर तुम्ही मूर्तिपूजा करून स्वतःला भ्रष्ट केले, तर याहवेह तुमचे परमेश्वर तुमच्यावर अतिशय कोपायमान होतील, <verse eid="DEU 4:25"/><verse number="26" style="v" sid="DEU 4:26"/>तर मी सांगतो की तुमच्याविरुद्ध स्वर्ग व पृथ्वी ही दोन्हीही साक्षी असतील, मग तुम्ही यार्देन पार करून जो देश ताब्यात घ्याल, त्या देशात तुमचा लवकरच नाश होईल. तुमचे तेथील वास्तव्य अगदी अल्पकाळ असेल व तुमचा संपूर्णपणे नायनाट होईल. <verse eid="DEU 4:26"/><verse number="27" style="v" sid="DEU 4:27"/>याहवेह, तुमची इतर राष्ट्रांमध्ये पांगापांग करतील आणि ज्या राष्ट्रांमध्ये याहवेह तुम्हाला घेऊन जातील त्यांच्यापैकी फक्त काही लोकच मागे उरतील. <verse eid="DEU 4:27"/><verse number="28" style="v" sid="DEU 4:28"/>तिथे तुम्ही लाकूड आणि दगडाच्या मानवनिर्मित दैवतांची सेवा कराल, जे पाहू शकत नाहीत, ऐकू शकत नाहीत, खाऊ शकत नाहीत किंवा वासही घेऊ शकत नाहीत. <verse eid="DEU 4:28"/><verse number="29" style="v" sid="DEU 4:29"/>परंतु तिथे असताना जर तुम्ही याहवेह तुमच्या परमेश्वराचा शोध घ्याल आणि संपूर्ण मनाने व जिवाने त्यांना शोधाल, तर ते तुम्हाला सापडतील. <verse eid="DEU 4:29"/><verse number="30" style="v" sid="DEU 4:30"/>तुमच्यावर यातना व अनेक दुःखाचे प्रसंग येतील, तेव्हा तुम्ही याहवेह तुमच्या परमेश्वराकडे परत याल आणि त्यांचे आज्ञापालन कराल. <verse eid="DEU 4:30"/><verse number="31" style="v" sid="DEU 4:31"/>कारण याहवेह तुमचे परमेश्वर हे कनवाळू आहेत. ते तुम्हाला सोडणार वा टाकणार नाहीत किंवा त्यांनी तुमच्या पूर्वजांशी केलेला शपथपूर्वक करार ते विसरणार नाहीत.<verse eid="DEU 4:31"/></para>
  <para style="s1">याहवेहच परमेश्वर आहेत</para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32"/>परमेश्वराने पृथ्वीवर मानवाला निर्माण केले त्या दिवसापासून आतापर्यंत तुमच्या आधी होऊन गेलेल्या दिवसांना विचारा आणि आकाशाच्या एका टोकापासून दुसर्‍या टोकापर्यंत विचारा की, अशा प्रकारची महान गोष्ट पूर्वी कधी घडली होती का किंवा अशी गोष्ट कुठे घडल्याचे कोणी कधी ऐकले आहे का? <verse eid="DEU 4:32"/><verse number="33" style="v" sid="DEU 4:33"/>अग्नीमधून बोलताना परमेश्वराची वाणी कोणी कधी ऐकली, ज्याप्रकारे तुम्ही ऐकली आणि जिवंत राहिले आहेत काय? <verse eid="DEU 4:33"/><verse number="34" style="v" sid="DEU 4:34"/>कोणत्या दैवताने एका राष्ट्रातून दुसर्‍या राष्ट्राला गुलामगिरीतून बाहेर काढण्याकरिता भयानक पीडा पाठविल्या, चिन्हे, चमत्कार केले, युद्ध व अद्भुत कृत्ये केली, जसे इजिप्त देशातून तुम्हाला बाहेर काढण्यासाठी याहवेह तुमच्या परमेश्वराने पराक्रमी बाहू आणि उगारलेल्या हाताने चमत्कार केले, असे एक तरी उदाहरण इतरत्र तुम्हाला सापडेल का?<verse eid="DEU 4:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 4:35"/>त्यांनी या गोष्टी अशासाठी केल्या की, याहवेहच परमेश्वर आहेत हे तुम्हाला कळून यावे; त्यांच्यासारखा अन्य कोणीही नाही हे देखील समजावे. <verse eid="DEU 4:35"/><verse number="36" style="v" sid="DEU 4:36"/>तुम्हाला बोध करण्यासाठी स्वर्गातून आज्ञा देण्यास त्यांनी तुम्हाला आपली वाणी ऐकविली, तसेच त्यांचा महान अग्निस्तंभही तुम्हाला या पृथ्वीतलावर दाखविला; आणि तुम्ही त्या अग्नीमधून येणारे त्यांचे शब्दही ऐकले. <verse eid="DEU 4:36"/><verse number="37" style="v" sid="DEU 4:37"/>तुमच्या पूर्वजांवर त्यांची प्रीती होती आणि त्यांनी त्यांच्या वंशजांना आशीर्वाद देण्यासाठी निवडले आणि म्हणूनच त्यांनी तुम्हाला आपल्या उपस्थितीने आणि महान सामर्थ्याने इजिप्त देशामधून बाहेर आणले, <verse eid="DEU 4:37"/><verse number="38" style="v" sid="DEU 4:38"/>त्यांनी तुमच्यापेक्षाही महान आणि सामर्थ्यवान राष्ट्रांना घालवून दिले व त्यांची भूमी तुम्हाला वतनादाखल दिली, ती आजही तशीच आहे.<verse eid="DEU 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="DEU 4:39"/>वर स्वर्गात आणि खाली पृथ्वीवर याहवेहच परमेश्वर आहेत, हे आजच स्वीकारा आणि तुमच्या अंतःकरणात ठेवा. त्यांच्याशिवाय दुसरा कोणी नाही. <verse eid="DEU 4:39"/><verse number="40" style="v" sid="DEU 4:40"/>आज जे विधी व आज्ञा मी तुम्हाला सांगणार आहे, यांचे तुम्ही पालन केले, तर तुमचे व तुमच्या वंशजांचे कल्याण होईल आणि याहवेह तुमचे परमेश्वर तुम्हाला देत असलेल्या या देशामध्ये तुम्ही चिरकाल वस्ती कराल.<verse eid="DEU 4:40"/></para>
  <para style="s1">आश्रयाची शहरे</para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41"/>नंतर मोशेने यार्देनेच्या पूर्वेस तीन शहरे नेमली; <verse eid="DEU 4:41"/><verse number="42" style="v" sid="DEU 4:42"/>ती यासाठी की, जर कोणी चुकून एखाद्या व्यक्तीची हत्या केली, त्याने पूर्व कल्पना नसताना एखाद्या शेजार्‍याला अनावधानाने मारले तर त्याला सुरक्षिततेसाठी त्या शहरात पळून जाता येईल. तो यापैकी एका शहरात पळून जाऊन आपला जीव वाचवू शकतो. <verse eid="DEU 4:42"/><verse number="43" style="v" sid="DEU 4:43"/>ती शहरे ही होती: रऊबेनाच्या वंशजासाठी रानातील पठारावरील बेसेर, गाद वंशजांसाठी गिलआदातील रामोथ आणि मनश्शेहच्या वंशजांसाठी बाशानातले गोलान.<verse eid="DEU 4:43"/></para>
  <para style="s1">नियमशास्त्राची ओळख</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44"/>मोशेने इस्राएली लोकांना दिलेले नियमशास्त्र हे आहे. <verse eid="DEU 4:44"/><verse number="45" style="v" sid="DEU 4:45"/>ज्यावेळी इस्राएली लोकांनी इजिप्त देश सोडला, त्यांना मोशेने या अटी, विधी व नियम दिले <verse eid="DEU 4:45"/><verse number="46" style="v" sid="DEU 4:46"/>आणि तेव्हा ते यार्देनेच्या पूर्वेकडे बेथ-पौर शहराजवळ तळ देऊन राहिलेले होते, हीच भूमी पूर्वी अमोर्‍यांनी आपला राजा सीहोनच्या अधिपत्याखाली व्यापली होती आणि त्याची राजधानी हेशबोन होती; मोशे व इस्राएली लोकांनी इजिप्त देशातून बाहेर आल्यानंतर सीहोन राजा आणि त्याच्या लोकांचा पराभव केला. <verse eid="DEU 4:46"/><verse number="47" style="v" sid="DEU 4:47"/>इस्राएली लोकांनी त्यांची भूमी आणि बाशानचा राजा ओगचीही भूमी जिंकून ताब्यात घेतली. यार्देनेच्या पूर्वेस असणारे हेच दोघे अमोरी राजे होते. <verse eid="DEU 4:47"/><verse number="48" style="v" sid="DEU 4:48"/>आर्णोन नदीच्या खोर्‍याच्या टोकाशी वसलेल्या अरोएर शहरापासून सिर्योन<note caller="+" style="f"><char style="fr" closed="false">4:48 </char><char style="ft" closed="false">काही हस्तलेखात </char><char style="fqa" closed="false">सीयोन</char></note> पर्वतापर्यंत, ज्याला हर्मोन पर्वत असेही म्हणतात, <verse eid="DEU 4:48"/><verse number="49" style="v" sid="DEU 4:49"/>आणि तसेच यार्देनच्या पूर्वेस असलेल्या अराबाच्या संपूर्ण प्रदेशापासून पिसगा पर्वताच्या उताराखाली असलेल्या खार्‍या समुद्रापर्यंतचा सर्व भूभाग इस्राएली लोकांनी जिंकून घेतला.<verse eid="DEU 4:49"/></para>
  <chapter eid="DEU 4"/>
  <chapter number="5" style="c" sid="DEU 5"/>
  <para style="s1">दहा आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1"/>मोशेने सर्व इस्राएली लोकांना बोलाविले आणि म्हटले:</para>
  <para style="p" vid="DEU 5:1">इस्राएली लोकांनो, ज्या विधी व नियमांची आज मी घोषणा करीत आहे व तुम्हाला ऐकवीत आहे, ते शिका आणि निश्चितपणे त्याचे पालन करा. <verse eid="DEU 5:1"/><verse number="2" style="v" sid="DEU 5:2"/>याहवेह आपल्या परमेश्वराने होरेब पर्वतावर तुमच्याशी एक करार केला होता. <verse eid="DEU 5:2"/><verse number="3" style="v" sid="DEU 5:3"/>याहवेहने हा करार आपल्या पूर्वजांशी नव्हे तर आज येथे जिवंत असलेल्या आपल्या सर्वांशी<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">केवळ आमच्या पूर्वजांशी</char></note> केला आहे. <verse eid="DEU 5:3"/><verse number="4" style="v" sid="DEU 5:4"/>याहवेह पर्वतावर अग्नीमधून तुमच्याशी समोरासमोर बोलले. <verse eid="DEU 5:4"/><verse number="5" style="v" sid="DEU 5:5"/>(त्यावेळी मी तुमच्या आणि याहवेहमध्ये उभा राहिलो आणि तुम्हाला याहवेहच्या वचनाची घोषणा केली, कारण तुम्हाला अग्नीची भीती वाटत असल्यामुळे तुम्ही पर्वतावर चढून त्यांच्यापर्यंत गेला नाही.)</para>
  <para style="p" vid="DEU 5:5">आणि ते म्हणाले:<verse eid="DEU 5:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="DEU 5:6"/>“ज्याने तुम्हाला इजिप्त देशातून व दास्यातून बाहेर आणले तो मी याहवेह तुमचा परमेश्वर आहे.<verse eid="DEU 5:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="DEU 5:7"/>“माझ्यासमोर तुम्हाला इतर कोणतेही देव नसावेत.<verse eid="DEU 5:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="DEU 5:8"/>तुम्ही स्वतःसाठी वर आकाशातील, पृथ्वीवरील व पृथ्वीच्या खाली जलातील कशाचीही प्रतिमा करू नका. <verse eid="DEU 5:8"/><verse number="9" style="v" sid="DEU 5:9"/>तुम्ही त्यांना नमन करू नये किंवा त्यांची उपासना करू नये; कारण मी याहवेह तुमचा परमेश्वर ईर्ष्यावान परमेश्वर आहे. जे माझा द्वेष करतात त्यांच्या लेकरांना तिसर्‍या व चौथ्या पिढीपर्यंत त्यांच्या आईवडिलांच्या पापांचे शासन करतो, <verse eid="DEU 5:9"/><verse number="10" style="v" sid="DEU 5:10"/>परंतु जे माझ्यावर प्रीती करतात आणि माझ्या आज्ञा पाळतात अशांच्या हजारो पिढ्यांपर्यंत प्रीती करतो.<verse eid="DEU 5:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="DEU 5:11"/>याहवेह तुमच्या परमेश्वराचे नाव तुम्ही व्यर्थ घेऊ नका, कारण जे त्यांचे नाव व्यर्थ घेतात, त्यांना याहवेह शिक्षा दिल्यावाचून राहणार नाहीत.<verse eid="DEU 5:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="DEU 5:12"/>याहवेह तुमच्या परमेश्वराच्या आज्ञेनुसार शब्बाथ दिवस पवित्रपणे पाळावा. <verse eid="DEU 5:12"/><verse number="13" style="v" sid="DEU 5:13"/>सहा दिवस तुम्ही परिश्रम करावेत आणि आपली सर्व कामे करावी, <verse eid="DEU 5:13"/><verse number="14" style="v" sid="DEU 5:14"/>परंतु सातवा दिवस याहवेह तुमच्या परमेश्वराचा शब्बाथ आहे. त्या दिवशी तुम्ही कोणतेही काम करू नये. तुम्ही किंवा तुमचा पुत्र किंवा कन्या, तुमचा दास किंवा दासी, तुमचे बैल, गाढव, तुमचे पशू किंवा तुमच्या नगरात राहणारा परदेशी, तुमचा दास आणि दासी यांनी देखील तुमच्यासह त्या दिवशी विश्रांती घ्यावी. <verse eid="DEU 5:14"/><verse number="15" style="v" sid="DEU 5:15"/>तुम्ही इजिप्त देशात गुलाम होता याचे स्मरण करा. याहवेह तुमच्या परमेश्वराच्या सामर्थ्यवान व विस्तारित हातांनी तुम्हाला तिथून बाहेर काढले. यास्तव याहवेह तुमच्या परमेश्वराने शब्बाथ दिवस पाळण्याची आज्ञा केली आहे.<verse eid="DEU 5:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="DEU 5:16"/>याहवेह तुमच्या परमेश्वराने आज्ञा दिल्याप्रमाणे आपल्या वडिलांचा व आपल्या आईचा सन्मान करा, म्हणजे जो देश याहवेह तुमचे परमेश्वर तुम्हाला देत आहे, त्यात तुम्ही दीर्घकाळ राहाल व तुमचे कल्याण होईल.<verse eid="DEU 5:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="DEU 5:17"/>तुम्ही खून करू नका.<verse eid="DEU 5:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="DEU 5:18"/>तुम्ही व्यभिचार करू नका.<verse eid="DEU 5:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="DEU 5:19"/>तुम्ही चोरी करू नका.<verse eid="DEU 5:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="DEU 5:20"/>तुमच्या शेजार्‍याविरुद्ध खोटी साक्ष देऊ नका.<verse eid="DEU 5:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="DEU 5:21"/>तुमच्या शेजार्‍याच्या पत्नीची अभिलाषा धरू नका. त्याच्या घराचा किंवा भूमीचा, त्याच्या दासाचा किंवा दासीचा, त्याच्या बैलाचा किंवा गाढवाचा किंवा शेजार्‍याच्या मालकीच्या कशाचाही लोभ करू नका.”<verse eid="DEU 5:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22"/>याहवेहने या आज्ञा तुमच्यातील प्रत्येकाला अग्नी, मेघ व निबिड अंधकार यांनी वेष्टिलेल्या पर्वतावरून उंच आवाजात उच्चारून दिल्या; व त्यात अधिक काहीही जोडले नाही. त्यांनी त्या दोन दगडी पाट्यांवर लिहून माझ्याजवळ दिल्या.<verse eid="DEU 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23"/>पण ज्यावेळी तुम्ही अंधारातून येणारा आवाज ऐकला आणि डोंगर माथ्यावरील त्या भयानक ज्वाला पाहिल्या, तेव्हा तुमचे सर्व गोत्रप्रमुख व वडील माझ्याकडे आले. <verse eid="DEU 5:23"/><verse number="24" style="v" sid="DEU 5:24"/>आणि मला म्हणाले, “याहवेह आमच्या परमेश्वराने आज आम्हाला त्यांचे गौरव व थोरवी दाखविली आहे आणि अग्नीमधून येणारा त्यांचा आवाजसुद्धा आम्ही ऐकला. आम्ही आज पाहिले आहे की, परमेश्वर मानवाशी बोलले तरी मानव जिवंत राहणे शक्य आहे. <verse eid="DEU 5:24"/><verse number="25" style="v" sid="DEU 5:25"/>परंतु आम्ही का मरावे? त्या भयानक ज्वाला आम्हाला भस्म करून टाकतील आणि याहवेह आमच्या परमेश्वराची वाणी आम्ही ऐकत राहू, तर खात्रीने मरून जाऊ. <verse eid="DEU 5:25"/><verse number="26" style="v" sid="DEU 5:26"/>कारण जिवंत परमेश्वर अग्नीतून बोलत असताना त्यांची वाणी ऐकून जिवंत राहिला आहे, असा सर्व नश्वर मानवात आमच्याशिवाय कोण आहे? <verse eid="DEU 5:26"/><verse number="27" style="v" sid="DEU 5:27"/>तेव्हा तुम्ही याहवेह आमच्या परमेश्वराजवळ जा आणि ते जे सांगतील ते सर्व ऐका. मग याहवेह आमच्या परमेश्वराने तुम्हाला जे काही सांगितले आहे ते आम्हाला सांगा. आम्ही ऐकू आणि त्याचे पालन करू.”<verse eid="DEU 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28"/>तुम्हाला माझ्याशी बोलताना याहवेहनी ऐकले आणि याहवेह मला म्हणाले, “हे लोक जे काही तुझ्याशी बोलले ते मी ऐकले आहे. त्यांनी जे सर्वकाही बोलले ते चांगले आहे. <verse eid="DEU 5:28"/><verse number="29" style="v" sid="DEU 5:29"/>त्यांचे अंतःकरण मजविषयी नेहमीच असे राहिले आणि माझ्या आज्ञा पाळण्याचे भय त्यांच्याठायी नेहमीच राहिले तर किती बरे होईल! असे झाल्यास त्यांचे व त्यांच्या मुलाबाळांचे सदासर्वकाळ कल्याण होईल!<verse eid="DEU 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 5:30"/>“जा आणि त्यांना त्यांच्या तंबूमध्ये परत जाण्यास सांग. <verse eid="DEU 5:30"/><verse number="31" style="v" sid="DEU 5:31"/>पण तू माझ्याबरोबर इथेच थांब, म्हणजे मी तुला माझ्या सर्व आज्ञा, विधी व नियम देईन आणि ते त्यांना शिकव म्हणजे जो देश मी त्यांना वतन म्हणून देणार आहे तिथे त्यांचे पालन करावे.”<verse eid="DEU 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 5:32"/>याहवेह तुमच्या परमेश्वराच्या आज्ञा पाळण्याची तुम्ही खबरदारी घ्या; उजवीकडे किंवा डावीकडे वळू नका. <verse eid="DEU 5:32"/><verse number="33" style="v" sid="DEU 5:33"/>याहवेह तुमच्या परमेश्वराने ज्या मार्गावर चालण्यास आज्ञा केली आहे, त्यावर तुम्ही चला, म्हणजे तुम्ही जिवंत राहाल आणि ज्या देशाचा तुम्ही ताबा घेणार आहात, त्या देशात तुम्ही दीर्घकाल समृद्धीचे जीवन जगू शकाल.<verse eid="DEU 5:33"/></para>
  <chapter eid="DEU 5"/>
  <chapter number="6" style="c" sid="DEU 6"/>
  <para style="s1">याहवेह तुमच्या परमेश्वरावर प्रीती करा</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1"/>यार्देन ओलांडून त्या वचनदत्त देश ताब्यात घ्यायचा आहे, त्या देशात तुम्हाला पाळावयास शिकविण्यासाठी याहवेह तुमच्या परमेश्वराने मला सांगितलेल्या आज्ञा, विधी व नियम हे आहेत, <verse eid="DEU 6:1"/><verse number="2" style="v" sid="DEU 6:2"/>यासाठी की तुम्ही, तुमचे पुत्र, पौत्रे यांनी याहवेह तुमच्या परमेश्वराचे भय बाळगावे. मी तुम्हाला दिलेले सर्व नियम व आज्ञा तुम्ही पाळत राहाल तर तुम्ही दीर्घायुष्याचा आनंद घ्याल. <verse eid="DEU 6:2"/><verse number="3" style="v" sid="DEU 6:3"/>म्हणून इस्राएली लोकहो ऐका आणि काळजीपूर्वक आज्ञा पाळा म्हणजे तुमचे भले होईल आणि याहवेह तुमच्या पूर्वजांच्या परमेश्वरांनी तुम्हाला दिलेल्या वचनाप्रमाणे दूध व मध वाहणार्‍या देशात तुम्ही बहुगुणित व्हाल.<verse eid="DEU 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 6:4"/>हे इस्राएला ऐक: याहवेह आपले परमेश्वर एकच याहवेह आहेत. <verse eid="DEU 6:4"/><verse number="5" style="v" sid="DEU 6:5"/>याहवेह तुमच्या परमेश्वरावर तुमच्या पूर्ण हृदयाने, तुमच्या पूर्ण जिवाने आणि तुमच्या पूर्णशक्तीने प्रीती करा. <verse eid="DEU 6:5"/><verse number="6" style="v" sid="DEU 6:6"/>या ज्या आज्ञा मी आज तुम्हाला देणार आहे, त्या तुमच्या अंतःकरणात सदैव असाव्या. <verse eid="DEU 6:6"/><verse number="7" style="v" sid="DEU 6:7"/>त्या तुमच्या मुलांवर बिंबवा. घरी बसले असताना, वाटेवर चालत असताना, झोपण्याच्या वेळी व झोपेतून उठल्यानंतर त्याबद्दल बोलत राहा. <verse eid="DEU 6:7"/><verse number="8" style="v" sid="DEU 6:8"/>त्या तुम्ही आपल्या हातावर चिन्ह म्हणून बांधून ठेवा आणि आपल्या कपाळपट्टीवर बांधा. <verse eid="DEU 6:8"/><verse number="9" style="v" sid="DEU 6:9"/>त्या तुमच्या घरातील दाराच्या चौकटीवर व तुमच्या फाटकांवर लिहा.<verse eid="DEU 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10"/>जो देश देण्याचे वचन याहवेह तुमच्या परमेश्वराने तुमचे पूर्वज अब्राहाम, इसहाक व याकोबाला दिले होते, त्या देशात जेव्हा ते तुम्हाला घेऊन जातील व जी तुम्ही स्वतः वसविलेली नाहीत—अशी मोठी व सुंदर शहरे तुम्हाला देतील, <verse eid="DEU 6:10"/><verse number="11" style="v" sid="DEU 6:11"/>तुम्ही स्वतः भरले नाहीत अशा सर्व चांगल्या वस्तूंनी भरलेली घरे, तुम्ही स्वतः खोदल्या नाहीत अशा विहिरी आणि तुम्ही स्वतः लावले नाहीत असे द्राक्षमळे व जैतुनाचे वृक्ष—तुम्ही ते सर्व खाल आणि तृप्त व्हाल, <verse eid="DEU 6:11"/><verse number="12" style="v" sid="DEU 6:12"/>ज्या याहवेहने तुम्हाला इजिप्त देशातून, दास्यगृहातून बाहेर आणले त्यांना तुम्ही विसरू नये याची खबरदारी घ्या.<verse eid="DEU 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 6:13"/>तुम्ही याहवेह आपल्या परमेश्वराचे भय बाळगावे, फक्त त्यांचीच सेवा करावी आणि त्यांच्याच नावाने शपथ वाहवी. <verse eid="DEU 6:13"/><verse number="14" style="v" sid="DEU 6:14"/>इतर दैवतांच्या, तुमच्या सभोवती असलेल्या राष्ट्रांच्या दैवतांच्या मागे लागू नका; <verse eid="DEU 6:14"/><verse number="15" style="v" sid="DEU 6:15"/>कारण याहवेह तुमचे परमेश्वर, जे तुम्हामध्ये आहेत, ते ईर्ष्यावान परमेश्वर आहेत, यामुळे त्यांचा राग भडकेल व ते तुम्हाला या पृथ्वीवरून नष्ट करून टाकतील. <verse eid="DEU 6:15"/><verse number="16" style="v" sid="DEU 6:16"/>मस्सा येथे पाहिली तशी तुम्ही याहवेह तुमच्या परमेश्वराची परीक्षा पाहू नका. <verse eid="DEU 6:16"/><verse number="17" style="v" sid="DEU 6:17"/>याहवेह तुमच्या परमेश्वराच्या आज्ञा तुम्ही काळजीपूर्वक पाळाव्या आणि त्यांची बोधवचने व नियमांचेही जपून पालन करावे. <verse eid="DEU 6:17"/><verse number="18" style="v" sid="DEU 6:18"/>याहवेहच्या दृष्टीने जे योग्य व चांगले आहे तेच करा, तर तुमचे सर्व बाबतीत कल्याण होईल आणि याहवेहने तुमच्या पूर्वजांना शपथपूर्वक देऊ केलेल्या देशात तुम्ही जाल व तो देश तुम्ही ताब्यात घ्याल. <verse eid="DEU 6:18"/><verse number="19" style="v" sid="DEU 6:19"/>याहवेहने सांगितल्याप्रमाणे तुमच्या सर्व शत्रूंना तुमच्यापुढून घालवून द्या.<verse eid="DEU 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20"/>भविष्यात जेव्हा तुमचा पुत्र तुम्हाला विचारेल, “याहवेह आपल्या परमेश्वराने या आज्ञा, ही बोधवचने, विधी व नियम तुम्हाला दिले आहेत, त्यांचा अर्थ काय?” <verse eid="DEU 6:20"/><verse number="21" style="v" sid="DEU 6:21"/>तेव्हा तुम्ही त्यांना सांगा: “आम्ही इजिप्त देशात फारोहचे गुलाम होतो, परंतु याहवेहने आपल्या पराक्रमी हाताने आम्हाला इजिप्तमधून बाहेर आणले. <verse eid="DEU 6:21"/><verse number="22" style="v" sid="DEU 6:22"/>आमच्या नजरेसमोर याहवेहने इजिप्त देश, फारोह राजा आणि त्याच्या संपूर्ण कुटुंबाविरुद्ध—महान व भयावह—चिन्हे दाखविली व चमत्कार केले. <verse eid="DEU 6:22"/><verse number="23" style="v" sid="DEU 6:23"/>त्यांनी आम्हाला इजिप्तमधून यासाठी बाहेर आणले की, आमच्या पूर्वजांना जो देश देण्याचे त्यांनी शपथपूर्वक वचन दिले होते, त्या देशात आम्हाला आणावे. <verse eid="DEU 6:23"/><verse number="24" style="v" sid="DEU 6:24"/>याहवेहने आम्हाला सर्व नियम पाळण्याची आज्ञा दिली आणि याहवेह आपल्या परमेश्वराचे भय बाळगावे, जेणेकरून आपले निरंतर कल्याण व्हावे आणि स्वतःस जिवंत राखावे, जसे आजवर आहोत. <verse eid="DEU 6:24"/><verse number="25" style="v" sid="DEU 6:25"/>आणि जर आपण याहवेह आपल्या परमेश्वरासमोर दिलेल्या आज्ञेप्रमाणे या सर्व नियमांचे काळजीपूर्वक पालन केले, तर ते आपले नीतिमत्व असेल.”<verse eid="DEU 6:25"/></para>
  <chapter eid="DEU 6"/>
  <chapter number="7" style="c" sid="DEU 7"/>
  <para style="s1">इतर राष्ट्रांना घालवून देणे</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1"/>जेव्हा याहवेह तुमचे परमेश्वर तुम्हाला त्या देशात घेऊन जातील, ज्याचा ताबा मिळविण्यासाठी तुम्ही जात आहात आणि तुमच्यापुढून—हिथी, गिर्गाशी, अमोरी, कनानी, परिज्जी, हिव्वी आणि यबूसी या तुमच्यापेक्षा मोठ्या आणि बलाढ्य सात राष्ट्रांना हाकलून देतील— <verse eid="DEU 7:1"/><verse number="2" style="v" sid="DEU 7:2"/>आणि जेव्हा याहवेह तुमचे परमेश्वर त्यांना तुमच्या हाती देतील आणि तुम्ही त्यांचा पराभव कराल, तेव्हा तुम्ही त्यांचा समूळ नायनाट करा. त्यांच्याशी कुठलाही करार करू नका किंवा त्यांना दया दाखवू नका. <verse eid="DEU 7:2"/><verse number="3" style="v" sid="DEU 7:3"/>तुम्ही त्यांच्याशी आंतरविवाह करू नका, तुमच्या कन्या त्यांच्या पुत्रांसाठी देऊ नका किंवा त्यांच्या कन्या तुमच्या पुत्रांसाठी घेऊ नका, <verse eid="DEU 7:3"/><verse number="4" style="v" sid="DEU 7:4"/>कारण ते तुमच्या मुलांना माझे अनुसरण करण्यापासून परावृत्त करून इतर दैवतांची उपासना करण्यासाठी प्रवृत्त करतील आणि याहवेहचा क्रोध तुम्हावर भडकेल आणि ते लगेच तुमचा नाश करतील. <verse eid="DEU 7:4"/><verse number="5" style="v" sid="DEU 7:5"/>तुम्ही त्यांच्या बाबतीत हे करा: त्यांच्या वेद्या मोडून टाका, त्यांच्या पवित्र पाषाणांचा चुरा करा, त्यांचे अशेराचे स्तंभ तोडून टाका आणि त्यांच्या मूर्ती अग्नीत जाळून टाका. <verse eid="DEU 7:5"/><verse number="6" style="v" sid="DEU 7:6"/>कारण तुम्ही याहवेह तुमच्या परमेश्वराचे पवित्रजन आहात. संपूर्ण पृथ्वीवरील सर्व लोकातून याहवेह तुमच्या परमेश्वराने तुम्हाला अशासाठी निवडले आहे की, तुम्ही त्यांचा खूप मोलाचा ठेवा असावा.<verse eid="DEU 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 7:7"/>तुम्ही संख्येने अधिक होता म्हणून याहवेहने तुमची निवड केली नाही व तुमच्यावर प्रीती केली नाही, कारण तुम्ही तर सर्व राष्ट्रांमध्ये संख्येने अतिशय अल्प होता. <verse eid="DEU 7:7"/><verse number="8" style="v" sid="DEU 7:8"/>पण याहवेहची तुमच्यावर प्रीती असल्यामुळे आणि त्यांनी तुमच्या पूर्वजांना दिलेली शपथ पाळावयाची होती, म्हणून त्यांनी तुम्हाला सामर्थ्यशाली हाताने बाहेर काढले आणि इजिप्तचा राजा फारोहच्या दास्यगृहातून तुम्हाला सोडविले. <verse eid="DEU 7:8"/><verse number="9" style="v" sid="DEU 7:9"/>म्हणून हे जाणून घ्या की, याहवेहच तुमचे परमेश्वर आहेत; ते विश्वासू परमेश्वर आहेत, जे त्यांच्यावर प्रीती करतात आणि त्यांच्या आज्ञा पाळतात, अशांच्या हजारो पिढ्यांपर्यंत ते आपल्या प्रीतीचा करार पाळतात. <verse eid="DEU 7:9"/><verse number="10" style="v" sid="DEU 7:10"/>परंतु</para>
  <para style="q1" vid="DEU 7:10">जे त्यांचा द्वेष करतात, त्यांना ते नष्ट करण्यास संकोच करणार नाहीत;</para>
  <para style="q2" vid="DEU 7:10">जे त्यांची घृणा करतात, त्यांची ते परतफेड करण्यास विलंब लावणार नाही.<verse eid="DEU 7:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="DEU 7:11"/>यास्तव, मी आज तुम्हाला देत आहे त्या सर्व आज्ञा, विधी व नियम पाळण्याची तुम्ही खबरदारी घ्या.<verse eid="DEU 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12"/>तुम्ही या आज्ञा ऐकून त्या प्रामाणिकपणे पाळल्या, तर याहवेह तुमचे परमेश्वर तुमच्या पूर्वजांना दिलेल्या अभिवचनाप्रमाणे हा प्रीतीचा करार पुढेही पाळीत राहतील. <verse eid="DEU 7:12"/><verse number="13" style="v" sid="DEU 7:13"/>ते तुम्हावर प्रीती करतील, तुम्हाला आशीर्वाद देतील आणि तुम्हाला बहुगुणित करतील. तुमच्या पूर्वजांना देऊ केलेल्या वचनदत्त देशात ते तुमच्या पोटच्या फळाला, तुमच्या जमिनीतील पीक—तुमच्या धान्याला, नव्या द्राक्षारसाला, जैतुनाच्या तेलाला—तुमच्या गुरांची वासरे आणि तुमच्या कळपातील कोकरे यांनाही ते आशीर्वाद देतील. <verse eid="DEU 7:13"/><verse number="14" style="v" sid="DEU 7:14"/>तुम्ही इतर लोकांपेक्षा अधिक आशीर्वादित व्हाल; तुमच्यापैकी कोणीही पुरुष वा स्त्री निःसंतान राहणार नाही किंवा तुमच्या पशूंपैकी कोणीही वांझ राहणार नाही. <verse eid="DEU 7:14"/><verse number="15" style="v" sid="DEU 7:15"/>याहवेह तुमच्यातील सर्व रोग दूर करतील. इजिप्तमधील तुम्हाला माहीत असलेले भयंकर रोग ते तुमच्यावर आणणार नाहीत, तर तुमचा द्वेष करणार्‍या सर्वांवर ते रोग आणतील. <verse eid="DEU 7:15"/><verse number="16" style="v" sid="DEU 7:16"/>याहवेह तुमचे परमेश्वर जे सर्व देश तुमच्या हाती देतील, त्यांचा तुम्ही पूर्णपणे संहार करावा. त्यांना दयामाया दाखवू नका व त्यांच्या दैवतांची सेवा करू नका. कराल, तर ते तुमच्यासाठी सापळा असे होईल.<verse eid="DEU 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17"/>तुम्ही स्वतःशी म्हणाल, “ही राष्ट्रे आमच्यापेक्षा कितीतरी सामर्थ्यवान आहेत. आम्ही त्यांना कसे काय घालवून देऊ?” <verse eid="DEU 7:17"/><verse number="18" style="v" sid="DEU 7:18"/>परंतु त्यांना भिऊ नका; याहवेह तुमच्या परमेश्वराने फारोहचे आणि संपूर्ण इजिप्त देशाचे काय केले याचे चांगले स्मरण ठेवा. <verse eid="DEU 7:18"/><verse number="19" style="v" sid="DEU 7:19"/>याहवेह तुमच्या परमेश्वराने तुम्हाला इजिप्तमधून बाहेर काढून आणण्यासाठी सामर्थ्यशाली हाताने व पसरलेल्या भुजांनी जी भयंकर संकटे, महान चमत्कार व चिन्हे केली, ते सर्व तुम्ही प्रत्यक्ष पाहिले होते. तुम्हाला ज्या लोकांचे भय वाटते त्यासर्वांच्या सोबत याहवेह तुमचे परमेश्वर हेच करतील. <verse eid="DEU 7:19"/><verse number="20" style="v" sid="DEU 7:20"/>शिवाय याहवेह तुमचे परमेश्वर त्यांना घालवून देण्यासाठी गांधीलमाशा पाठवतील, तुमच्यापासून लपून बसलेले देखील नाश पावतील. <verse eid="DEU 7:20"/><verse number="21" style="v" sid="DEU 7:21"/>तुम्ही त्यांना भिऊ नका, कारण महान व भयावह असे याहवेह तुमचे परमेश्वर तुम्हाबरोबर आहेत. <verse eid="DEU 7:21"/><verse number="22" style="v" sid="DEU 7:22"/>याहवेह तुमचे परमेश्वर त्या राष्ट्रांना हळूहळू घालवून देतील; कारण त्यांना एकदम घालवून दिल्यास हिंस्र पशूची संख्या वेगाने वाढेल आणि त्यांच्याकडून तुम्हाला धोका निर्माण होईल. <verse eid="DEU 7:22"/><verse number="23" style="v" sid="DEU 7:23"/>परंतु त्यांच्यात खूप गोंधळ निर्माण करून त्यांचा नाश होईपर्यंत याहवेह तुमचे परमेश्वर त्यांना तुमच्या हातात देतील. <verse eid="DEU 7:23"/><verse number="24" style="v" sid="DEU 7:24"/>ते त्यांच्या राजांना तुमच्या हाती देतील आणि तुम्ही त्यांची नावे या पृथ्वीतलावरून पुसून टाकाल. मग कोणीही तुमच्याविरुद्ध उभा राहणार नाही; तुम्ही त्यांचा नाश कराल. <verse eid="DEU 7:24"/><verse number="25" style="v" sid="DEU 7:25"/>त्यांच्या दैवतांच्या मूर्ती तुम्ही जाळून टाका; त्यांच्या सोन्यारुप्याच्या लोभ धरू नका आणि ते स्वतःकरिता घेऊ नका, नाहीतर तुम्ही त्याद्वारे सापळ्यात अडकाल, कारण याहवेह तुमच्या परमेश्वराला याचा वीट आहे. <verse eid="DEU 7:25"/><verse number="26" style="v" sid="DEU 7:26"/>नाशाचे कारण असलेली कोणतीही किळसवाणी वस्तू घरात आणू नका, तसे केल्यास तुमचा खात्रीने नाश होईल. ती घृणास्पद समजून तिचा अगदी वीट माना, कारण ती शापित आहे.<verse eid="DEU 7:26"/></para>
  <chapter eid="DEU 7"/>
  <chapter number="8" style="c" sid="DEU 8"/>
  <para style="s1">याहवेहचे विस्मरण होऊ देऊ नका</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1"/>आज मी तुम्हाला देत असलेल्या आज्ञांचे तुम्ही काळजीपूर्वक पालन करावे. जेणेकरून तुम्ही जिवंत राहाल व बहुगुणित व्हाल आणि याहवेहने तुमच्या पूर्वजांना शपथ दिलेल्या देशात जाऊन तो ताब्यात घ्याल. <verse eid="DEU 8:1"/><verse number="2" style="v" sid="DEU 8:2"/>याहवेह तुमच्या परमेश्वराने तुम्हाला रानात चाळीस वर्षात कसे चालविले, त्यांनी तुम्हाला कसे नम्र केले व तुमची परीक्षा कशी पाहिली, याची तुम्ही आठवण करा. तुमच्या अंतःकरणात काय होते, तुम्ही त्यांच्या आज्ञा पाळणार की नाही, हे पाहण्यासाठी त्यांनी असे केले. <verse eid="DEU 8:2"/><verse number="3" style="v" sid="DEU 8:3"/>तुमची उपासमार करून तुम्हाला नम्र केले व नंतर तुम्हाला आणि तुमच्या पूर्वजांनाही पूर्वी कधीही माहिती नसलेला मान्ना खावयास देऊन तुम्हाला शिकविले की, मनुष्य केवळ भाकरीने नव्हे, तर याहवेहच्या मुखातून निघणार्‍या प्रत्येक वचनाने जगेल. <verse eid="DEU 8:3"/><verse number="4" style="v" sid="DEU 8:4"/>या चाळीस वर्षात तुमचे कपडे कधी जीर्ण झाले नाहीत, की तुमच्या पायांना सूज आली नाही. <verse eid="DEU 8:4"/><verse number="5" style="v" sid="DEU 8:5"/>तेव्हा तुम्हाला हे समजावे की, जसा पिता आपल्या पुत्राला शिस्त लावतो तसे याहवेह तुमचे परमेश्वर तुम्हाला शिस्त लावतात.<verse eid="DEU 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 8:6"/>याहवेह तुमच्या परमेश्वराच्या आज्ञांचे पालन करा, त्यांच्या आज्ञेत राहा आणि त्यांचा आदर करा. <verse eid="DEU 8:6"/><verse number="7" style="v" sid="DEU 8:7"/>कारण याहवेह तुमचे परमेश्वर तुम्हाला उत्तम अशा देशात नेणार आहेत—त्यात नद्या, झरे व ओहोळ हे डोंगरात उगम पावून खोर्‍यांमधून वाहत आहेत; <verse eid="DEU 8:7"/><verse number="8" style="v" sid="DEU 8:8"/>गहू व जव, द्राक्षमळे, अंजिरे व डाळिंबे, जैतुनाचे तेल व मध यांचा तो देश आहे; <verse eid="DEU 8:8"/><verse number="9" style="v" sid="DEU 8:9"/>या देशात भाकरीची उणीव भासणार नाही आणि कशाचीही कमतरता राहणार नाही; तेथील दगड लोहयुक्त आहेत व डोंगरांमधून तांबे खणून काढता येईल.<verse eid="DEU 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 8:10"/>जेव्हा तुम्ही खाल आणि तृप्त व्हाल, याहवेह तुमच्या परमेश्वराने तुम्हाला उत्तम देश दिल्याबद्दल त्यांचा धन्यवाद करा. <verse eid="DEU 8:10"/><verse number="11" style="v" sid="DEU 8:11"/>परंतु याच वेळी तुम्ही सावधगिरी बाळगली पाहिजे, नाहीतर तुम्ही आपल्या समृद्धीत याहवेह तुमच्या परमेश्वराला विसराल व त्यांच्या ज्या आज्ञा, नियम व विधी मी तुम्हाला आज देत आहे, त्या पाळण्याचे सोडून द्याल. <verse eid="DEU 8:11"/><verse number="12" style="v" sid="DEU 8:12"/>कारण जेव्हा तुम्ही खाल आणि तृप्त व्हाल, जेव्हा सुंदर घरे बांधाल आणि त्यात वस्ती कराल, <verse eid="DEU 8:12"/><verse number="13" style="v" sid="DEU 8:13"/>आणि जेव्हा तुमची शेरडेमेंढरे व गुरे यांची वृद्धी झालेली असेल आणि तुमचे चांदी आणि सोने व तुमची मालमत्ता वाढलेली असेल, <verse eid="DEU 8:13"/><verse number="14" style="v" sid="DEU 8:14"/>तेव्हा तुमचे अंतःकरण उन्मत्त होईल आणि ज्यांनी तुम्हाला इजिप्त देशाच्या गुलामगिरीतून काढून बाहेर आणले, त्या याहवेह तुमच्या परमेश्वराला तुम्ही विसरून जाल. <verse eid="DEU 8:14"/><verse number="15" style="v" sid="DEU 8:15"/>विषारी सापाचा आणि विंचवांचा धोका असलेल्या अफाट व भयानक रानातून व उष्ण आणि कोरड्या भूमीतून त्यांनी तुम्हाला आणले. शुष्क भूमीत खडक फोडून तुम्हाला पाणी दिले. <verse eid="DEU 8:15"/><verse number="16" style="v" sid="DEU 8:16"/>त्यांनी तुम्हाला रानात खावयास मान्ना दिला, जो तुमच्या पूर्वजांना कधीच माहीत नव्हता, यासाठी की त्यांनी तुम्हाला नम्र करावे आणि तुमची परीक्षा घ्यावी, जेणेकरून शेवटी तुमचे भले व्हावे. <verse eid="DEU 8:16"/><verse number="17" style="v" sid="DEU 8:17"/>तुम्ही आपल्या मनात म्हणाल, “माझ्या शक्तीने व माझ्या हाताच्या बळाने मी हे धन मिळविले आहे.” <verse eid="DEU 8:17"/><verse number="18" style="v" sid="DEU 8:18"/>परंतु याहवेह तुमच्या परमेश्वराचे स्मरण ठेवा, कारण संपत्ती निर्माण करण्याचे सामर्थ्य केवळ तेच तुम्हाला पुरवितात, आणि आजच्या प्रमाणेच ते तुमच्या पूर्वजांशी शपथपूर्वक केलेल्या कराराची पुष्टी करतात.<verse eid="DEU 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19"/>परंतु जर तुम्ही याहवेह तुमच्या परमेश्वराला विसराल, त्यांना सोडून इतर दैवतांच्या मागे लागाल आणि त्यांची उपासना कराल व त्यांना नमन कराल, तर आज मी तुमच्याविरुद्ध साक्ष देतो की, तुम्ही खात्रीने नाश पावाल. <verse eid="DEU 8:19"/><verse number="20" style="v" sid="DEU 8:20"/>याहवेहने इतर राष्ट्रांचा तुमच्यापुढे जसा नाश केला, तसाच याहवेह तुमच्या परमेश्वराच्या आज्ञांचे पालन केले नाही तर तुमचाही नाश होईल.<verse eid="DEU 8:20"/></para>
  <chapter eid="DEU 8"/>
  <chapter number="9" style="c" sid="DEU 9"/>
  <para style="s1">इस्राएलाच्या नीतिमत्वामुळे नव्हे</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1"/>हे इस्राएला, ऐक: तुम्ही आता यार्देन पार करून पलीकडे आत जाणार आहात आणि ज्यांच्या शहरांची तटबंदी आकाशापर्यंत आहेत, अशा तुमच्यापेक्षा महान आणि अधिक बलवान लोकांना हाकलून देणार आहात. <verse eid="DEU 9:1"/><verse number="2" style="v" sid="DEU 9:2"/>तेथील लोक धिप्पाड व उंच आहेत—अनाकी वंशज! तुम्हाला त्यांच्याबद्दल माहीत आहे आणि तुम्ही हे ऐकले आहे: “अनाकी लोकांविरुद्ध कोण उभे राहू शकेल?” <verse eid="DEU 9:2"/><verse number="3" style="v" sid="DEU 9:3"/>पण तुमची खात्री असू द्या की, याहवेह तुमचे परमेश्वर भस्म करणार्‍या अग्निरुपाने तुमच्यापुढे जातील. ते त्यांचा नाश करतील; त्यांना तुमच्यापुढे नमवतील आणि तुमच्यासमोर त्यांचा नायनाट करतील, मग याहवेहने दिलेल्या अभिवचनानुसार तुम्ही त्यांना लगेच संपूर्ण नष्ट कराल आणि त्यांना तिथून घालवून द्याल.<verse eid="DEU 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 9:4"/>याहवेह तुमच्या परमेश्वराने त्यांना तुमच्यापुढून घालवून दिल्यानंतर स्वतःशी म्हणू नका, “मी नीतिमान आहे, म्हणूनच याहवेहने हा देश वतन म्हणून घेण्यास मला मदत केली.” नाही! तसे मुळीच नाही, तर या राष्ट्रांच्या दुष्टपणामुळेच याहवेह त्यांना तुमच्यापुढून घालवून देत आहेत. <verse eid="DEU 9:4"/><verse number="5" style="v" sid="DEU 9:5"/>तुम्ही नीतिमान आणि सरळ मनाचे लोक आहात म्हणून याहवेह तुम्हाला त्यांचा देश ताब्यात देतील असे मुळीच नाही; मी पुन्हा सांगतो की याहवेह तुमचे परमेश्वर हे केवळ त्या राष्ट्रांच्या दुष्टपणामुळेच व त्यांनी तुमचे पूर्वज अब्राहाम, इसहाक व याकोब यांना जी शपथ दिली होती, ती पूर्ण करण्यासाठीच ते त्या राष्ट्रांना तुमच्यापुढून घालवून देतील. <verse eid="DEU 9:5"/><verse number="6" style="v" sid="DEU 9:6"/>आणि हे जाणून घ्या, याहवेह तुमचे परमेश्वर, तुम्ही नीतिमान आहात म्हणून हा उत्तम देश तुम्हाला वतन म्हणून देत नाहीत, खरेतर तुम्ही ताठ मानेचे लोक आहात.<verse eid="DEU 9:6"/></para>
  <para style="s1">वासराची सुवर्ण मूर्ती</para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7"/>तुम्ही त्या रानात याहवेह तुमच्या परमेश्वराला राग येईल असे वागलात, हे तुम्ही विसरू नका आणि याची नेहमी आठवण ठेवा. ज्या दिवशी तुम्ही इजिप्त देश सोडला त्या दिवसापासून या ठिकाणी येईपर्यंत, तुम्ही याहवेहविरुद्ध सतत बंड केले. <verse eid="DEU 9:7"/><verse number="8" style="v" sid="DEU 9:8"/>होरेब पर्वतावर तुम्ही त्यांना इतके संतप्त केले की याहवेह तुमचा नाश करणारच होते. <verse eid="DEU 9:8"/><verse number="9" style="v" sid="DEU 9:9"/>याहवेहने तुमच्याशी केलेल्या कराराच्या दगडी पाट्या स्वीकारण्यासाठी मी त्या पर्वतावर चढून गेलो होतो. तिथे मी चाळीस दिवस व चाळीस रात्री होतो; त्या काळात मी भाकर खाल्ली नाही आणि पाणीदेखील प्यालो नाही. <verse eid="DEU 9:9"/><verse number="10" style="v" sid="DEU 9:10"/>याहवेहने दोन दगडी पाट्या मला दिल्या, ज्यावर परमेश्वराच्या बोटाने लिहिलेले होते. तुम्ही पर्वताच्या पायथ्याशी गोळा झालेले होता, त्यावेळी याहवेहने तुमच्याशी बोलताना पर्वतावर अग्नीतून सांगितलेल्या सर्व आज्ञा त्यावर होत्या.<verse eid="DEU 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 9:11"/>चाळीस दिवस व चाळीस रात्री लोटल्यानंतर, याहवेहने कराराच्या दोन दगडी पाट्या मला दिल्या. <verse eid="DEU 9:11"/><verse number="12" style="v" sid="DEU 9:12"/>मग याहवेह मला म्हणाले, “ताबडतोब येथून उतरून खाली जा, कारण तुझे लोक, ज्यांना तू इजिप्त देशातून बाहेर काढून आणले, ते भ्रष्ट झाले आहेत. मी त्यांना जे करण्याची आज्ञा दिलेली होती, त्यापासून बहकून त्यांनी स्वतःसाठी ओतीव मूर्ती तयार केली आहे.”<verse eid="DEU 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 9:13"/>याहवेह मला म्हणाले, “मी या लोकांना ओळखतो, हे ताठ मानेचे लोक आहेत. <verse eid="DEU 9:13"/><verse number="14" style="v" sid="DEU 9:14"/>तू माझ्या आड येऊ नकोस, मी या लोकांचा नाश करेन आणि त्यांचे नाव पृथ्वीवरून पुसून टाकेन आणि त्यांच्याहीपेक्षा अधिक बलवान व बहुगुणित असे राष्ट्र मी तुझ्यापासून बनवीन.”<verse eid="DEU 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 9:15"/>नंतर मी मागे वळलो आणि पर्वतावरून खाली उतरत असताना पर्वत अग्नीने जळत होता आणि त्या कराराच्या दोन पाट्या माझ्या हातात होत्या. <verse eid="DEU 9:15"/><verse number="16" style="v" sid="DEU 9:16"/>जेव्हा मी पाहिले की, याहवेह तुमच्या परमेश्वराविरुद्ध तुम्ही पाप केले आहे; तुम्ही तुमच्यासाठी वासराची ओतीव मूर्ती घडविली, असे माझ्या दृष्टीस पडले. याहवेहनी दिलेल्या आज्ञा पाळण्याचे सोडून तुम्ही किती लवकर पथभ्रष्ट झालात. <verse eid="DEU 9:16"/><verse number="17" style="v" sid="DEU 9:17"/>तेव्हा मी त्या दोन दगडी पाट्या घेतल्या आणि माझ्या हातांतून फेकून, तुमच्या डोळ्यादेखत त्यांचा चुराडा केला.<verse eid="DEU 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 9:18"/>नंतर आणखी चाळीस दिवस व चाळीस रात्री मी याहवेहपुढे पालथा पडून राहिलो; मी भाकर खाल्ली नाही आणि पाणीदेखील प्यालो नाही, कारण याहवेहच्या दृष्टीने वाईट आहे, तेच पाप तुम्ही करून त्यांचा क्रोध भडकाविला होता. <verse eid="DEU 9:18"/><verse number="19" style="v" sid="DEU 9:19"/>मला याहवेहच्या रागाची आणि क्रोधाची भीती वाटली, कारण ते तुमचा नाश करण्याइतके रागावले होते. परंतु त्यावेळी सुद्धा याहवेहने माझे ऐकले. <verse eid="DEU 9:19"/><verse number="20" style="v" sid="DEU 9:20"/>आणि याहवेह अहरोनवर अत्यंत संतप्त झाले व त्याचा नाश करणार होते, परंतु मी त्याच्यासाठी देखील प्रार्थना केली. <verse eid="DEU 9:20"/><verse number="21" style="v" sid="DEU 9:21"/>मी तुमचे पापकृत्य, म्हणजे जे वासरू तुम्ही बनविले होते ते घेतले आणि अग्नीत जाळून त्याची कुटून धुळीसारखी बारीक पूड केली आणि ती धूळ डोंगरातून वाहणार्‍या ओहोळात फेकून दिली.<verse eid="DEU 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22"/>पुन्हा तबेरा येथे, मस्सा येथे आणि किब्रोथ-हत्ताव्वा येथेही तुम्ही याहवेहला संतप्त केले.<verse eid="DEU 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 9:23"/>आणि जेव्हा याहवेहने तुम्हाला कादेश-बरनेआ येथून पाठविले, तेव्हा ते म्हणाले, “वर जा आणि जो देश मी तुम्हाला दिला आहे त्याचा ताबा घ्या.” पण तुम्ही याहवेह तुमच्या परमेश्वराच्या आज्ञेविरुद्ध बंड केले. त्यांच्यावर भरवसा ठेवला नाही व त्यांची आज्ञा पाळली नाही. <verse eid="DEU 9:23"/><verse number="24" style="v" sid="DEU 9:24"/>मी तुम्हाला ओळखतो, त्या दिवसापासून तुम्ही याहवेहविरुद्ध बंड करीत आहात.<verse eid="DEU 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25"/>म्हणूनच मी याहवेहपुढे चाळीस दिवस व चाळीस रात्र पालथा पडून राहिलो, कारण याहवेह म्हणाले होते की, ते तुमचा नाश करतील. <verse eid="DEU 9:25"/><verse number="26" style="v" sid="DEU 9:26"/>मी याहवेहला प्रार्थना केली आणि म्हणालो, “हे सार्वभौम याहवेह, तुमच्या प्रचंड शक्तीने व तुमच्या बलाढ्य हाताने इजिप्त देशातून वाचविलेल्या तुमच्या लोकांचा, तुमच्या वारसांचा संहार करू नका. <verse eid="DEU 9:26"/><verse number="27" style="v" sid="DEU 9:27"/>तुमचे सेवक अब्राहाम, इसहाक व याकोब यांची आठवण करा. या लोकांचा हट्टीपणा, त्यांच्या दुष्टपणाकडे व त्यांच्या पापाकडे लक्ष देऊ नका. <verse eid="DEU 9:27"/><verse number="28" style="v" sid="DEU 9:28"/>कारण जर तुम्ही यांचा नाश केला, तर ज्या देशामधून तुम्ही आम्हाला बाहेर आणले ते लोक म्हणतील, ‘वचनदत्त देशात त्यांना नेण्यास त्यांचा याहवेह असमर्थ होता आणि तो त्यांचा द्वेष करीत होता म्हणून त्याने त्यांचा नाश केला व त्यांना ठार मारण्यासाठीच त्याने त्यांना रानात नेले.’ <verse eid="DEU 9:28"/><verse number="29" style="v" sid="DEU 9:29"/>पण हे तुमचे लोक, तुमचे वारसदार आहेत. तुम्हीच त्यांना तुमच्या महान सामर्थ्याने आणि पसरलेल्या बाहूने इजिप्तमधून बाहेर आणले.”<verse eid="DEU 9:29"/></para>
  <chapter eid="DEU 9"/>
  <chapter number="10" style="c" sid="DEU 10"/>
  <para style="s1">पहिल्या पाट्यांसारख्या नव्या पाट्या</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1"/>त्यावेळी याहवेहने मला सांगितले, “पहिल्या पाट्यांसारख्याच आणखी दोन दगडी पाट्या तू घडव आणि त्या घेऊन पर्वतावर माझ्याकडे ये. एक लाकडी कोशही तयार कर. <verse eid="DEU 10:1"/><verse number="2" style="v" sid="DEU 10:2"/>तू फोडून टाकलेल्या पहिल्या पाट्यांवर जी वचने होती, ती मी त्यावर लिहेन. मग त्या पाट्या तू कोशात ठेव.”<verse eid="DEU 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 10:3"/>म्हणून मी बाभळीच्या लाकडाचा एक कोश तयार केला, आणि पहिल्यासारख्या दोन दगडी पाट्या घडविल्या व त्या पाट्या माझ्या हातात घेऊन मी पर्वतावर गेलो. <verse eid="DEU 10:3"/><verse number="4" style="v" sid="DEU 10:4"/>याहवेहने या पाट्यांवर जे आधी लिहिले होते तेच लिहिले, ज्या दहा आज्ञा त्यांनी पर्वतावर अग्नीमधून संपूर्ण मंडळीला घोषित केल्या होत्या, त्या पुन्हा लिहिल्या आणि मला सोपवून दिल्या. <verse eid="DEU 10:4"/><verse number="5" style="v" sid="DEU 10:5"/>नंतर मी पर्वतावरून खाली उतरलो आणि याहवेहने मला आज्ञा दिल्याप्रमाणे त्या पाट्या मी बनविलेल्या लाकडी कोशात ठेवून दिल्या; आजपर्यंत त्या तिथेच आहेत.<verse eid="DEU 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6"/>(मग इस्राएली लोक बेने याकानच्या विहिरी सोडून प्रवास करीत मोसेरापर्यंत आले. तिथे अहरोन मरण पावला व त्याला मूठमाती देण्यात आली, आणि त्याचा पुत्र एलअज़ार त्याच्यानंतर याजक झाला. <verse eid="DEU 10:6"/><verse number="7" style="v" sid="DEU 10:7"/>नंतर ते प्रवास करीत गुदगोदाह येथे आले व तिथून पुढे याटबाथह येथे आले, ही झर्‍यांची भूमी होती. <verse eid="DEU 10:7"/><verse number="8" style="v" sid="DEU 10:8"/>याच ठिकाणी याहवेहने लेवीच्या गोत्रास याहवेहच्या कराराचा कोश वाहून नेण्यासाठी, त्याचप्रमाणे याहवेहच्या समोर उभे राहून त्यांची सेवा करण्यास व त्यांच्या नावाने आशीर्वाद देण्यास नेमले, जसे आजपर्यंत चालत आले आहे. <verse eid="DEU 10:8"/><verse number="9" style="v" sid="DEU 10:9"/>म्हणून लेवी वंशजांना वचनदत्त देशात त्यांच्या बंधुवंशजांप्रमाणे वाटा किंवा वतन मिळालेले नाही, कारण याहेवह तुमच्या परमेश्वराने सांगितल्याप्रमाणे याहवेह स्वतःच त्यांचे वतन आहेत.)<verse eid="DEU 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10"/>त्या पर्वतावर पहिल्या वेळी राहिलो होतो, त्याप्रमाणे चाळीस दिवस व चाळीस रात्र राहिलो आणि या वेळीही याहवेहने माझी विनंती मान्य केली. तुमचा नाश करण्याची त्यांची इच्छा नव्हती. <verse eid="DEU 10:10"/><verse number="11" style="v" sid="DEU 10:11"/>याहवेह मला म्हणाले, “जा आणि सर्व लोकांना मी त्यांच्या पूर्वजांना वचनपूर्वक देऊ केलेल्या देशाकडे जाण्यास मार्गदर्शन कर, म्हणजे ते त्या देशात प्रवेश करून तो ताब्यात घेतील.”<verse eid="DEU 10:11"/></para>
  <para style="s1">याहवेहचे भय धरा</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12"/>आता हे इस्राएली लोकहो, याहवेह तुमचे परमेश्वर तुमच्याजवळ मागतात ते एवढेच की तुम्ही याहवेह तुमच्या परमेश्वराचे भय धरावे, त्यांच्या आज्ञा पाळाव्या, त्यांच्यावर प्रीती करावी आणि पूर्ण मनाने व पूर्ण जिवाने याहवेह तुमच्या परमेश्वराची सेवा करावी, <verse eid="DEU 10:12"/><verse number="13" style="v" sid="DEU 10:13"/>आणि याहवेहच्या ज्या आज्ञा व नियम आज मी तुम्हाला देत आहे, त्या तुमच्या भल्यासाठीच आहेत, त्या तुम्ही पाळाव्या.<verse eid="DEU 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 10:14"/>आकाश, सर्वोच्च आकाश, पृथ्वी व तिच्यावरील सर्वकाही याहवेह तुमच्या परमेश्वराचे आहे. <verse eid="DEU 10:14"/><verse number="15" style="v" sid="DEU 10:15"/>असे असूनही याहवेहने तुमच्या पूर्वजांवर वात्सल्यमय प्रीती केली व त्यांच्यानंतर तुम्ही इतर सर्व राष्ट्रांहून श्रेष्ठ व्हावे म्हणून त्यांच्या वंशजांची म्हणजे तुमची निवड केली—जसे आजही आहे. <verse eid="DEU 10:15"/><verse number="16" style="v" sid="DEU 10:16"/>म्हणून तुम्ही तुमच्या अंतःकरणाची सुंता करा आणि आता ताठ मानेचे राहू नका. <verse eid="DEU 10:16"/><verse number="17" style="v" sid="DEU 10:17"/>याहवेह तुमचे परमेश्वर, हे देवाधिदेव, प्रभूंचे प्रभू, महान परमेश्वर, पराक्रमी आणि भयावह आहेत, जे पक्षपात करीत नाहीत व लाच घेत नाहीत. <verse eid="DEU 10:17"/><verse number="18" style="v" sid="DEU 10:18"/>ते अनाथांचा व विधवांचा न्याय करतात, जे परदेशीय तुम्हामध्ये राहतात त्यांच्यावर प्रीती करून त्यांना अन्न व वस्त्रे देतात. <verse eid="DEU 10:18"/><verse number="19" style="v" sid="DEU 10:19"/>तुम्हीदेखील परदेशीयांवर प्रीती केली पाहिजे, कारण तुम्ही स्वतः इजिप्त देशामध्ये परदेशी होता. <verse eid="DEU 10:19"/><verse number="20" style="v" sid="DEU 10:20"/>याहवेह तुमच्या परमेश्वराचे तुम्ही भय बाळगा, त्यांची सेवा करा, त्यांना बिलगून राहा आणि त्यांच्याच नावाने शपथ घ्या. <verse eid="DEU 10:20"/><verse number="21" style="v" sid="DEU 10:21"/>तेच तुमच्या स्तुतीचा विषय आहे; तेच तुमचे परमेश्वर आहेत, त्यांनी केलेले महान व भयावह चमत्कार तुम्ही स्वतःच्या डोळ्याने पाहिले आहेत. <verse eid="DEU 10:21"/><verse number="22" style="v" sid="DEU 10:22"/>ज्यावेळी तुमचे पूर्वज इजिप्तमध्ये गेले, त्यावेळी ते केवळ सत्तर जणच होते आणि आता याहवेह तुमच्या परमेश्वराने तुम्हाला आकाशातील तार्‍यांइतके अगणित केले आहे.<verse eid="DEU 10:22"/></para>
  <chapter eid="DEU 10"/>
  <chapter number="11" style="c" sid="DEU 11"/>
  <para style="s1">याहवेहवर प्रीती करा व त्यांच्या आज्ञा पाळा</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1"/>याहवेह तुमच्या परमेश्वरावर प्रीती करावी आणि नेहमी त्यांचे विधी, त्यांचे नियम आणि त्यांच्या आज्ञा पाळाव्यात. <verse eid="DEU 11:1"/><verse number="2" style="v" sid="DEU 11:2"/>तुम्ही आज हे स्मरणात ठेवा, तुमच्या मुलांनी याहवेह तुमच्या परमेश्वराचे अनुशासन पाहिले नाही आणि त्याचा अनुभव केला नाही—त्यांचे गौरव, सामर्थ्यशाली हात व पसरलेल्या भुजांचा; <verse eid="DEU 11:2"/><verse number="3" style="v" sid="DEU 11:3"/>इजिप्तचा राजा फारोह व त्याच्या सर्व देशाच्या समक्षतेत याहवेहने केलेली चिन्हे आणि केलेल्या गोष्टी; <verse eid="DEU 11:3"/><verse number="4" style="v" sid="DEU 11:4"/>इजिप्तचे सैन्य, त्यांचे रथ आणि घोडे जेव्हा तुमचा पाठलाग करीत आले, तेव्हा याहवेहने त्या सैन्याला तांबड्या समुद्रामध्ये कसे बुडवून टाकले व त्यांची कशी दुर्दशा केली. <verse eid="DEU 11:4"/><verse number="5" style="v" sid="DEU 11:5"/>तुम्ही या ठिकाणी येईपर्यंत त्यांनी तुमच्यासाठी रानात काय केले, <verse eid="DEU 11:5"/><verse number="6" style="v" sid="DEU 11:6"/>रऊबेनाचा वंशज एलियाब, याचे पुत्र दाथान व अबीराम यांचे त्यांनी काय केले, जेव्हा पृथ्वीने सर्व इस्राएली छावणीच्या मध्यभागी आपले तोंड उघडले आणि तिने त्यांना, त्यांच्या घरादारांना, त्यांच्या डेर्‍यांना आणि त्यांच्या सर्व मालकीचे सर्व जिवंत प्राणी कसे गिळून टाकले हे तुमच्या मुलांनी पाहिले नाही. <verse eid="DEU 11:6"/><verse number="7" style="v" sid="DEU 11:7"/>परंतु याहवेहने केलेले हे सर्व महान कार्य तुम्ही स्वतःच्या डोळ्यांनी पाहिले आहे.<verse eid="DEU 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8"/>म्हणून मी तुम्हाला आज देत असलेल्या सर्व आज्ञा पाळाव्या, म्हणजे यार्देन ओलांडून ज्या देशात तुम्ही प्रवेश करणार आहात, तो हस्तगत करण्यास तुम्हाला सामर्थ्य मिळेल. <verse eid="DEU 11:8"/><verse number="9" style="v" sid="DEU 11:9"/>म्हणजे जो देश त्यांना व त्यांच्या वंशजांना देण्याविषयी याहवेहने तुमच्या पूर्वजांना वचन दिले होते, त्या दुधामधाच्या सुंदर देशात तुम्ही चिरकाल राहाल. <verse eid="DEU 11:9"/><verse number="10" style="v" sid="DEU 11:10"/>कारण ज्या देशात तुम्ही प्रवेश करणार आहात व तो ताब्यात घेणार आहात, तो देश तुम्ही सोडून आलेल्या इजिप्त देशातील भूमीसारखा नाही. तिथे तुम्ही पेरणी केली व भाज्यांचे मळे लावण्यासाठी जलसिंचन केले. <verse eid="DEU 11:10"/><verse number="11" style="v" sid="DEU 11:11"/>परंतु यार्देन ओलांडून जो देश ताब्यात घेण्यासाठी तुम्ही जात आहात, तो देश डोंगराचा व दर्‍याखोर्‍यांचा आहे, जो आकाशातून पडणारा पाऊस पितो. <verse eid="DEU 11:11"/><verse number="12" style="v" sid="DEU 11:12"/>याहवेह तुमचे परमेश्वर स्वतः त्या भूमीची काळजी घेतात; वर्षाच्या आरंभापासून अखेरपर्यंत याहवेह तुमच्या परमेश्वराची नजर सतत त्या देशावर असते.<verse eid="DEU 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13"/>आज मी तुम्हाला देत असलेल्या या सर्व आज्ञा जर तुम्ही अगदी विश्वासूपणे पाळाल—तुम्ही याहवेह तुमच्या परमेश्वरावर पूर्ण अंतःकरणाने व पूर्ण जिवाने प्रीती कराल व त्यांची सेवा कराल— <verse eid="DEU 11:13"/><verse number="14" style="v" sid="DEU 11:14"/>तर मी आगोठीचा आणि वळवाचा पाऊस योग्य समयी पाठवेन, म्हणजे तुम्हाला धान्य, नवीन द्राक्षे व तेलासाठी जैतुनाच्या तेलाचा साठा करता येईल. <verse eid="DEU 11:14"/><verse number="15" style="v" sid="DEU 11:15"/>मी तुमच्या गुरांसाठी हिरवीगार कुरणे देईन आणि तुम्हीही खाल आणि तृप्त व्हाल.<verse eid="DEU 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 11:16"/>पण सावध असावे, तुम्ही इतर दैवतांची उपासना व त्यांना नमन करण्याकडे बहकून जाऊ नये. <verse eid="DEU 11:16"/><verse number="17" style="v" sid="DEU 11:17"/>तसे केल्यास याहवेहचा क्रोध तुम्हावर भडकेल आणि ते आकाशकपाटे बंद करतील, मग पाऊस पडणार नाही, भूमी आपला हंगामही देणार नाही आणि याहवेहने तुम्हाला दिलेल्या या उत्तम देशातून तुम्ही त्वरित नाश पावाल. <verse eid="DEU 11:17"/><verse number="18" style="v" sid="DEU 11:18"/>यास्तव माझ्या या आज्ञा काळजीपूर्वक आपल्या मनात आणि अंतःकरणात साठवून ठेवा; त्या तुम्ही आपल्या हातावर चिन्ह म्हणून बांधून ठेवा आणि आपल्या कपाळपट्टीवर बांधा. <verse eid="DEU 11:18"/><verse number="19" style="v" sid="DEU 11:19"/>त्या आपल्या मुलांना शिकवा. घरी बसलेले असताना, वाटेवर चालत असताना, झोपण्याच्या वेळी व झोपेतून उठल्यानंतर त्याबद्दल बोलत राहा. <verse eid="DEU 11:19"/><verse number="20" style="v" sid="DEU 11:20"/>त्या तुमच्या घरातील दाराच्या चौकटीवर व तुमच्या फाटकांवर लिहाव्या, <verse eid="DEU 11:20"/><verse number="21" style="v" sid="DEU 11:21"/>म्हणजे जितके दिवस पृथ्वीवर आकाश स्थित आहे, तितके तुमच्या पूर्वजांना याहवेहने देऊ केलेल्या वचनदत्त देशात तुमचे आणि तुमच्या मुलाबाळांचे दिवस असतील.<verse eid="DEU 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 11:22"/>मी तुम्हाला देत असलेल्या या सर्व आज्ञा तुम्ही काळजीपूर्वक पाळाल—याहवेह तुमच्या परमेश्वरावर प्रीती कराल, आज्ञाधारकपणे त्यांच्या मार्गावर चालत राहाल आणि त्यांना बिलगून राहाल— <verse eid="DEU 11:22"/><verse number="23" style="v" sid="DEU 11:23"/>तर याहवेह या सर्व राष्ट्रांना तुमच्यापुढून घालवून देतील आणि तुमच्यापेक्षा कितीही मोठी आणि बलवान राष्ट्र असोत, तुम्ही त्यांना आपल्या ताब्यात घ्याल. <verse eid="DEU 11:23"/><verse number="24" style="v" sid="DEU 11:24"/>तुम्ही जिथे पाऊल ठेवाल, ती प्रत्येक भूमी तुमची होईल: तुमच्या देशाची सीमा दक्षिणेकडील नेगेव प्रांतापासून लबानोन देशापर्यंत व फरात नदीपासून भूमध्य समुद्रापर्यंत पसरेल. <verse eid="DEU 11:24"/><verse number="25" style="v" sid="DEU 11:25"/>तुमच्याविरुद्ध कोणीही उभे राहू शकणार नाही. कारण याहवेह तुमच्या परमेश्वराने वचन दिल्याप्रमाणे, तुम्ही जाल त्या ठिकाणी तुम्हाविषयी तेथील लोकात ते भय आणि दहशत निर्माण करतील.<verse eid="DEU 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26"/>पाहा, मी आज तुमच्यापुढे आशीर्वाद व शाप ठेवीत आहे— <verse eid="DEU 11:26"/><verse number="27" style="v" sid="DEU 11:27"/>याहवेह तुमच्या परमेश्वराच्या ज्या आज्ञा आज मी तुम्हाला देणार आहे, त्या जर तुम्ही पाळल्या, तर तुम्हाला आशीर्वाद मिळेल; <verse eid="DEU 11:27"/><verse number="28" style="v" sid="DEU 11:28"/>आणि याहवेह तुमच्या परमेश्वराच्या आज्ञा न मानल्यास, आज मी तुम्हाला ज्या मार्गाने जाण्याची आज्ञा देत आहे त्यापासून भटकून जाल आणि जी दैवते तुम्हाला माहीत नाहीत अशांचे अनुसरण करण्यास सुरुवात कराल, तर तुम्हाला शाप मिळेल. <verse eid="DEU 11:28"/><verse number="29" style="v" sid="DEU 11:29"/>याहवेह तुमचे परमेश्वर तुम्हाला जेव्हा या देशाचा ताबा घेण्यासाठी आणतील, तेव्हा तुम्ही गरिज्जीम डोंगरावरून आशीर्वाद आणि एबाल डोंगरावरून शाप उच्चारावा. <verse eid="DEU 11:29"/><verse number="30" style="v" sid="DEU 11:30"/>तुम्ही जाणता, हे डोंगर यार्देन नदीच्या पश्चिमेला असलेल्या कनानी लोकांच्या देशात आहेत. कनानी लोक जे अराबात गिलगाल या शहराजवळ असलेल्या ओसाड भागात राहतात. हे ठिकाण मोरेहच्या जवळील एला वृक्षांच्या राईपासून दूर नाही. <verse eid="DEU 11:30"/><verse number="31" style="v" sid="DEU 11:31"/>तुम्ही यार्देन नदी ओलांडून याहवेह तुमचे परमेश्वर तुम्हाला देत असलेला देश काबीज करण्यास जात आहात. तुम्ही तो ताब्यात घ्याल आणि तिथे वस्ती कराल, <verse eid="DEU 11:31"/><verse number="32" style="v" sid="DEU 11:32"/>पण मी आज तुमच्यासमोर ठेवत असलेल्या सर्व विधी व नियम पाळण्याची खबरदारी तुम्ही घेतली पाहिजे.<verse eid="DEU 11:32"/></para>
  <chapter eid="DEU 11"/>
  <chapter number="12" style="c" sid="DEU 12"/>
  <para style="s1">उपासनेचे एकमेव स्थान</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1"/>याहवेह तुमच्या पूर्वजांच्या परमेश्वराने जो देश तुम्हाला ताब्यात घ्यावयास दिला आहे—तिथे तुम्ही या पृथ्वीवर जिवंत असेपर्यंत हे विधी व नियम काळजीपूर्वकपणे पाळावेत. <verse eid="DEU 12:1"/><verse number="2" style="v" sid="DEU 12:2"/>ज्या राष्ट्रांना तुम्ही ताब्यात घेणार आहात तेथील उंच पर्वतांवर, टेकड्यांवरील आणि प्रत्येक घनदाट पसरलेल्या झाडाखाली जे त्या दैवतांची उपासना करतात ती सर्व ठिकाणे पूर्णपणे नष्ट करा. <verse eid="DEU 12:2"/><verse number="3" style="v" sid="DEU 12:3"/>तुम्ही त्यांच्या वेद्या पाडून टाकाव्या, त्यांचे पवित्र दगड फोडून टाकावे, त्यांचे अशेरास्तंभ अग्नीत जाळून टाकावे, त्यांच्या दैवतांच्या कोरीव मूर्ती फोडून टाकाव्या आणि त्या ठिकाणातून त्यांची नावे पुसून टाकावी.<verse eid="DEU 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4"/>याहवेह तुमच्या परमेश्वराची उपासना त्यांच्या पद्धतीने करू नका. <verse eid="DEU 12:4"/><verse number="5" style="v" sid="DEU 12:5"/>उलट, तुमच्या सर्व गोत्रांच्या जागेतून याहवेह तुमचे परमेश्वर निवडील व त्या जागेला ते स्वतःचे नाव देतील, त्या ठिकाणी तुम्ही जावे; <verse eid="DEU 12:5"/><verse number="6" style="v" sid="DEU 12:6"/>तिथेच तुम्ही आपली होमार्पणे, यज्ञार्पणे, तुमचे दशांश व विशेष भेटी, नवस फेडण्यासाठी आणलेली अर्पणे आणि तुमची स्वेच्छार्पणे आणि तुमच्या गुरांची व शेरडामेंढरांची प्रथम वत्सांची अर्पणे आणावीत. <verse eid="DEU 12:6"/><verse number="7" style="v" sid="DEU 12:7"/>त्या ठिकाणी याहवेह तुमच्या परमेश्वराच्या सान्निध्यात तुम्ही आणि तुमच्या कुटुंबाने भोजन करावे आणि तुम्ही हातात घेतलेल्या प्रत्येक गोष्टीत आनंद कराल, कारण याहवेह तुमच्या परमेश्वराने तुम्हाला आशीर्वादित केले आहे.<verse eid="DEU 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8"/>आजपर्यंत तुम्ही तुमच्या मनाला योग्य वाटेल त्याप्रमाणे वागत आला आहात, पण आता तसे करता येणार नाही, <verse eid="DEU 12:8"/><verse number="9" style="v" sid="DEU 12:9"/>कारण याहवेह तुमच्या परमेश्वरांनी दिलेल्या विश्रामस्थानी आणि वचनदत्त ठिकाणी अजून तुम्ही पोहोचला नाही. <verse eid="DEU 12:9"/><verse number="10" style="v" sid="DEU 12:10"/>पण तुम्ही यार्देन नदी पार करून याहवेह तुमच्या परमेश्वराने दिलेल्या वचनदत्त देशात राहू लागाल तेव्हा ते तुमच्या सभोवती असलेल्या सर्व शत्रूपासून सुरक्षित ठेवून तुम्हाला विश्रांती देतील. <verse eid="DEU 12:10"/><verse number="11" style="v" sid="DEU 12:11"/>तेव्हाच तुम्ही तुमची सर्व होमार्पणे, यज्ञार्पणे, दशांश, नवसाची अर्पणे व स्वेच्छार्पणे—याहवेह तुमचे परमेश्वर स्वतःच्या नावाचे निवासस्थान म्हणून ज्या ठिकाणाची निवड करतील तिथे आणावीत. <verse eid="DEU 12:11"/><verse number="12" style="v" sid="DEU 12:12"/>आणि त्या ठिकाणी तुम्ही, तुमचे पुत्र आणि कन्या, तुमचे दास व दासी आणि तुमच्या नगरातील लेवी, ज्यांना स्वतःचा कोणताही वाटा किंवा वतन नाही, या सर्वांसह—याहवेह तुमच्या परमेश्वरासमोर आनंदोत्सव करावा. <verse eid="DEU 12:12"/><verse number="13" style="v" sid="DEU 12:13"/>तुमची होमार्पणे तुम्ही इतर कुठेही अर्पण करणार नाही याची खबरदारी घ्या. <verse eid="DEU 12:13"/><verse number="14" style="v" sid="DEU 12:14"/>तुमच्या एका गोत्रातील याहवेहने नेमून दिलेल्या ठिकाणीच तुमचे होमबली अर्पावेत आणि मी तुम्हाला जे आज्ञापिले ते सर्वकाही करावे.<verse eid="DEU 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 12:15"/>तरीसुद्धा, याहवेह तुमचे परमेश्वर देत असलेल्या आशीर्वादाप्रमाणे तुम्ही तुमच्या नगरात तुमचे पशू ज्याप्रमाणे सांबर व हरिण मारून खाता त्याप्रमाणे पाहिजे तेवढे खा. विधिनियमानुसार अशुद्ध आणि शुद्ध असे दोघेही ते खाऊ शकतात. <verse eid="DEU 12:15"/><verse number="16" style="v" sid="DEU 12:16"/>पण तुम्ही रक्ताचे सेवन कधीही करू नये; तर ते जमिनीवर पाण्यासारखे ओतून द्यावे. <verse eid="DEU 12:16"/><verse number="17" style="v" sid="DEU 12:17"/>धान्य, द्राक्षारस व तेलाचे दशांश, गुरांचे प्रथमवत्स, नवसफेडीच्या वस्तू, स्वेच्छार्पणे व इतर अर्पणे या परमेश्वराला वाहिलेल्या अर्पणातून काहीही आपल्या नगरात खाऊ नये. <verse eid="DEU 12:17"/><verse number="18" style="v" sid="DEU 12:18"/>पण ही सर्व अर्पणे याहवेह तुमचे परमेश्वर निवडील त्या ठिकाणी तुमचे पुत्र, कन्या, तुमचे दास व दासी व तुमच्या शहरात राहणारे लेवी, या सर्वांसह तुम्ही याहवेह तुमच्या परमेश्वरासमोर खावीत. तुम्ही जे करता त्या प्रत्येक सेवेबद्दल परमेश्वरापुढे आनंद करावा. <verse eid="DEU 12:18"/><verse number="19" style="v" sid="DEU 12:19"/>जेव्हापर्यंत तुमचे या भूमीवर वास्तव्य असेल तेव्हापर्यंत लेवी वंशजांकडे दुर्लक्ष न करण्याची काळजी घ्यावी.<verse eid="DEU 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20"/>याहवेह तुमच्या परमेश्वराने आपल्या वचनाप्रमाणे तुमच्या देशाची सीमा वाढविल्यावर, तुम्हाला मांस खाण्याची इच्छा झाल्यास तुम्ही म्हणाल, “मला मांस खावयाचे आहे,” तेव्हा तुम्ही मनसोक्त मांस खावे. <verse eid="DEU 12:20"/><verse number="21" style="v" sid="DEU 12:21"/>याहवेह तुमच्या परमेश्वराने आपल्या नावासाठी निवडलेले स्थान तुमच्या घरापासून खूप दूर असेल, तर तुम्हाला जेव्हा इच्छा होईल, तेव्हा याहवेहने तुम्हाला दिलेल्या पशूंमधून किंवा मेंढरांमधून तुम्ही काहीही मारून खावे. मी तुम्हाला सांगितल्याप्रमाणे ते मांस तुम्ही तुमच्या शहरात तुम्हाला हवे तेवढे खावे. <verse eid="DEU 12:21"/><verse number="22" style="v" sid="DEU 12:22"/>जो कोणी विधिनियमानुसार शुद्ध किंवा अशुद्ध असेल त्यानेही हे मांस, हरणाचे किंवा सांबराचे मांस खातात, त्याप्रमाणे खावे. <verse eid="DEU 12:22"/><verse number="23" style="v" sid="DEU 12:23"/>परंतु रक्त सेवन न करण्याची तुम्ही खबरदारी घ्यावी, कारण रक्त हे जीवन आहे, म्हणून तुम्ही मांसाबरोबर जीवन सेवन करू नये. <verse eid="DEU 12:23"/><verse number="24" style="v" sid="DEU 12:24"/>तुम्ही रक्ताचे सेवन करू नये; त्याऐवजी ते पाण्याप्रमाणे जमिनीवर ओतून टाकावे. <verse eid="DEU 12:24"/><verse number="25" style="v" sid="DEU 12:25"/>त्याचे सेवन करू नये, तर त्याने तुमचे आणि तुमच्यानंतर तुमच्या संततीचे सर्व बाबतींत कल्याण होईल, कारण याहवेहच्या दृष्टीने योग्य वाटणार्‍या गोष्टीच तुम्ही कराल.<verse eid="DEU 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26"/>परंतु जी पवित्र अर्पणे करावयाची असतील व नवसाची दाने द्यावयाची असतील, ती घेऊन तुम्ही याहवेह जे स्थान निवडील, त्या स्थानी जावे. <verse eid="DEU 12:26"/><verse number="27" style="v" sid="DEU 12:27"/>तिथे आपल्या होमबलीचे मांस व रक्त याहवेह तुमच्या परमेश्वराच्या वेदीवर अर्पण करावे. तुमच्या यज्ञपशूंचे रक्त याहेवह तुमच्या परमेश्वराच्या वेदीवर ओतावे आणि मांस खावे. <verse eid="DEU 12:27"/><verse number="28" style="v" sid="DEU 12:28"/>या सर्व आज्ञा पाळण्याची तुम्ही खबरदारी घ्यावी. याहवेह तुमच्या परमेश्वराच्या दृष्टीने जे उत्तम आणि योग्य ते तुम्ही केले, तर तुमचे आणि तुमच्या मुलाबाळांचे निरंतर कल्याण होईल.<verse eid="DEU 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29"/>ज्या भूमीत तुम्ही राहणार आहात तेथील राष्ट्रांचा याहवेह तुमचे परमेश्वर नाश करतील. मग त्यांना तिथून घालवून दिल्यानंतर तुम्ही त्या ठिकाणी वस्ती करावी, <verse eid="DEU 12:29"/><verse number="30" style="v" sid="DEU 12:30"/>आणि तुमच्यासमोर ते नष्ट झाल्यानंतर, तुम्ही त्यांच्या दैवतांची चौकशी कराल “ही राष्ट्रे त्यांच्या दैवतांची उपासना कशी करीत होती? आपणही तसेच करावे,” तसे करण्याचा तुम्हाला मोह होईल, तेव्हा त्यांच्या दैवतांच्या मोहात अडकू नये याची खबरदारी घ्या. <verse eid="DEU 12:30"/><verse number="31" style="v" sid="DEU 12:31"/>त्यांच्या पद्धतीप्रमाणे तुम्ही याहवेह तुमच्या परमेश्वराची उपासना कदापि करू नये, कारण त्यांच्या दैवतांच्या उपासनेमध्ये ते अशी घृणित कृत्ये करतात, ज्यांचा याहवेह तिरस्कार करतात. ते आपल्या पुत्रांना जाळतात आणि कन्यांचा त्यांच्या दैवतांना होम करतात.<verse eid="DEU 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 12:32"/>मी देत असलेल्या सर्व आज्ञांचे तुम्ही पालन करावे; त्यात काहीही भर घालू नये किंवा त्यातून काही कमी करू नये.<verse eid="DEU 12:32"/></para>
  <chapter eid="DEU 12"/>
  <chapter number="13" style="c" sid="DEU 13"/>
  <para style="s1">इतर दैवतांची उपासना</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 13:1"/>जर तुम्हामध्ये कोणी ज्योतिषी किंवा स्वप्नांच्या आधाराने भविष्य सांगणारा असेल व त्याने दैवी चिन्ह आणि चमत्कारांची घोषणा केली, <verse eid="DEU 13:1"/><verse number="2" style="v" sid="DEU 13:2"/>आणि जर त्याची चिन्हे आणि भविष्ये खरी ठरली आणि तो ज्योतिषी म्हणेल, “चला, आपण इतर दैवतांचे अनुसरण करू आणि त्यांची उपासना करू.” (अशी दैवते ज्यांची तुम्हाला ओळख नसेल) <verse eid="DEU 13:2"/><verse number="3" style="v" sid="DEU 13:3"/>तर तुम्ही त्या ज्योतिष्याचे किंवा स्वप्नदर्शीचे शब्द ऐकू नका. कारण तुम्ही याहवेह तुमच्या परमेश्वरावर मनापासून प्रीती करता की नाही, हे पाहण्यासाठी परमेश्वर तुमची परीक्षा घेत आहेत. <verse eid="DEU 13:3"/><verse number="4" style="v" sid="DEU 13:4"/>याहवेह तुमच्या परमेश्वराचेच तुम्ही अनुसरण करावे व त्यांचेच भय बाळगावे. त्यांच्या आज्ञा पाळाव्यात, त्यांची वाणी ऐकावी; त्यांची सेवा करावी व त्यांनाच बिलगून राहावे. <verse eid="DEU 13:4"/><verse number="5" style="v" sid="DEU 13:5"/>जो संदेष्टा किंवा स्वप्नदर्शी तुम्हाला बहकवील त्याला अवश्य जिवे मारावे, कारण ज्या याहवेह तुमच्या परमेश्वराने तुम्हाला इजिप्त देशातील गुलामगिरीतून बाहेर काढले, त्यांच्याविरुद्ध बंड करण्यास त्याने तुम्हाला प्रवृत्त केले. तुम्ही स्वतःला या दुष्टाईपासून मुक्त केले पाहिजे.<verse eid="DEU 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 13:6"/>जर तुमचा स्वतःचा बंधू किंवा तुमचे पुत्र किंवा कन्या किंवा तुमची प्रिय पत्नी किंवा जिवलग मित्र तुम्हाला गुप्तपणे भुरळ पाडेल व म्हणेल, “चल, आपण जाऊ आणि इतर दैवतांची उपासना करू” (ज्यांना तुम्ही वा तुमचे पूर्वज ओळखत नाहीत, <verse eid="DEU 13:6"/><verse number="7" style="v" sid="DEU 13:7"/>जे तुमच्या शेजार्‍यांचे देव आहेत, ते जवळ असो वा दूर, त्या भूमीच्या एका टोकापासून असो वा दुसर्‍या टोकापर्यंत), <verse eid="DEU 13:7"/><verse number="8" style="v" sid="DEU 13:8"/>तर त्यांना संमती देऊ नका किंवा त्यांचे ऐकू नका. त्यांची गयही करू नका. त्यांना वाचवू नका किंवा संरक्षण देऊ नका. <verse eid="DEU 13:8"/><verse number="9" style="v" sid="DEU 13:9"/>तर त्यांना अवश्य जिवे मारावे. त्यांना मृत्युदंड देत असताना, त्यांच्यावर तुमचा हात सर्वप्रथम पडला पाहिजे आणि त्यानंतर इतर लोकांचे हात पडावेत. <verse eid="DEU 13:9"/><verse number="10" style="v" sid="DEU 13:10"/>त्यांना मरेपर्यंत धोंडमार करावी, कारण ज्यांनी तुम्हाला इजिप्त देशाच्या गुलामगिरीतून बाहेर काढले, त्या याहवेह तुमच्या परमेश्वरापासून तुम्हाला फूस लावून दूर नेण्याचा त्यांनी प्रयत्न केला आहे. <verse eid="DEU 13:10"/><verse number="11" style="v" sid="DEU 13:11"/>तेव्हा संपूर्ण इस्राएल ऐकेल व भयभीत होईल आणि तुमच्यामध्ये असा दुष्टपणा करण्यास कोणी धजणार नाही.<verse eid="DEU 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 13:12"/>याहवेह तुमचे परमेश्वर वस्ती करण्यास देत असलेल्या एखाद्या शहरातून तुमच्या कानावर आले की, <verse eid="DEU 13:12"/><verse number="13" style="v" sid="DEU 13:13"/>तुमच्यापैकी काही अधम पुरुष निघाले आहेत आणि त्यांनी त्यांच्या नगरातील लोकांना हे बोलून बहकविले, “चला आपण जाऊ आणि इतर दैवतांची उपासना करू” (अशी दैवते ज्यांना तुम्ही ओळखत नाहीत), <verse eid="DEU 13:13"/><verse number="14" style="v" sid="DEU 13:14"/>तर तुम्ही त्याची चौकशी करावी, शोध करावा आणि सखोल तपासणी करावी आणि जर हे सत्य असेल की तुमच्यामध्ये असे घृणित कृत्य घडले आहे, <verse eid="DEU 13:14"/><verse number="15" style="v" sid="DEU 13:15"/>तर तुम्ही त्या नगरातील लोकांना तलवारीने निश्चित मारून टाकावे. त्यातील सर्व रहिवाशांचा आणि गुरांचा समूळ नाश करावा. <verse eid="DEU 13:15"/><verse number="16" style="v" sid="DEU 13:16"/>त्यानंतर युद्धात मिळालेल्या लुटीचा नगरातील रस्त्याच्या मधोमध ढीग करून त्याला आग लावावी आणि ते संपूर्ण नगर होमार्पण म्हणून याहवेह तुमच्या परमेश्वराला अर्पण करावे. हे नगर म्हणजे एक उजाड ठिकाण म्हणून कायम राहील. ते पुन्हा कधीही बांधले जाणार नाही, <verse eid="DEU 13:16"/><verse number="17" style="v" sid="DEU 13:17"/>आणि निषिद्ध वस्तूंपैकी ज्या विनाशासाठी ठरविलेल्या आहेत त्यातील काहीही तुमच्या हातात राहू नये. मग याहवेहचा तीव्र क्रोध शमेल, ते तुमच्यावर दया करतील आणि तुम्हावर करुणा करतील. तुमच्या पूर्वजांना वचन दिल्याप्रमाणे ते तुम्हाला बहुगुणित करतील— <verse eid="DEU 13:17"/><verse number="18" style="v" sid="DEU 13:18"/>कारण तुम्ही याहवेह तुमच्या परमेश्वराची वाणी ऐकून, आज मी तुम्हाला ज्या आज्ञा देत आहे त्या पाळल्या आणि त्यांच्या दृष्टीने जे योग्य तेच केले आहे.<verse eid="DEU 13:18"/></para>
  <chapter eid="DEU 13"/>
  <chapter number="14" style="c" sid="DEU 14"/>
  <para style="s1">शुद्ध आणि अशुद्ध अन्न</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1"/>याहवेह तुमच्या परमेश्वराची तुम्ही संतती आहात. मृतांसाठी स्वतःला जखमा करून घेऊ नका किंवा डोक्याचे मुंडण करून घेऊ नका, <verse eid="DEU 14:1"/><verse number="2" style="v" sid="DEU 14:2"/>कारण तुम्ही याहवेह तुमच्या परमेश्वराचे पवित्रजन आहात. पृथ्वीवरील इतर सर्व राष्ट्रांमधून तुम्हीच त्यांचा मौल्यवान ठेवा असावे म्हणूनच याहवेहने तुम्हाला निवडले आहे.<verse eid="DEU 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3"/>कोणतेही निषिद्ध ठरविण्यात आलेले अन्न तुम्ही खाऊ नये. <verse eid="DEU 14:3"/><verse number="4" style="v" sid="DEU 14:4"/>तुम्ही हे प्राणी खाऊ शकता: बैल, मेंढरे व शेरडे, <verse eid="DEU 14:4"/><verse number="5" style="v" sid="DEU 14:5"/>सांबर, हरिण, भेकर, रानबोकड, रोही, गवा व डोंगरी मेंढा. <verse eid="DEU 14:5"/><verse number="6" style="v" sid="DEU 14:6"/>ज्यांचे खूर दुभागलेले आहेत आणि जे प्राणी रवंथ करतात असे कोणतेही प्राणी तुम्ही खाऊ शकता. <verse eid="DEU 14:6"/><verse number="7" style="v" sid="DEU 14:7"/>तरी, जे प्राणी फक्त रवंथ करतात अथवा ज्यांचे फक्त खूर दुभागलेले असतात, हे प्राणी तुम्ही खाऊ नयेत: उंट, ससा आणि रानससा; कारण हे प्राणी रवंथ करतात, परंतु त्यांचे खूर दुभागलेले नसतात; ते प्राणी तुमच्यासाठी विधिनियमानुसार अशुद्ध आहेत. <verse eid="DEU 14:7"/><verse number="8" style="v" sid="DEU 14:8"/>डुकरे देखील अशुद्ध आहेत; त्यांचे खूर जरी दुभागलेले आहेत, तरी ते रवंथ करीत नाहीत, त्यांचे मांस तुम्ही खाऊ नये किंवा त्यांच्या मृतशरीरांना स्पर्श करू नये.<verse eid="DEU 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9"/>पाण्यात राहणार्‍या सर्व प्राण्यांपैकी ज्यांना कल्ले व खवले आहेत, त्यांना तुम्ही खाऊ शकता. <verse eid="DEU 14:9"/><verse number="10" style="v" sid="DEU 14:10"/>परंतु ज्यांना कल्ले व खवले नाहीत ते तुम्ही खाऊ नये; तुमच्यासाठी ते अशुद्ध आहे.<verse eid="DEU 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11"/>कोणतेही शुद्ध पक्षी खाण्यास योग्य आहेत. <verse eid="DEU 14:11"/><verse number="12" style="v" sid="DEU 14:12"/>परंतु हे पक्षी तुम्ही खाऊ नये: गरुड, गिधाड, काळे गिधाड, <verse eid="DEU 14:12"/><verse number="13" style="v" sid="DEU 14:13"/>लाल पतंग, काळे पतंग, निरनिराळ्या जातीच्या घारी, <verse eid="DEU 14:13"/><verse number="14" style="v" sid="DEU 14:14"/>कोणत्याही जातीचे कावळे, <verse eid="DEU 14:14"/><verse number="15" style="v" sid="DEU 14:15"/>शिंग असलेले घुबड, किंचाळणारे घुबड, समुद्रपक्षी, सर्व जातीचे बहिरी ससाणे, <verse eid="DEU 14:15"/><verse number="16" style="v" sid="DEU 14:16"/>लहान घुबड, पिंगळा, मोठे घुबड, पांढरे घुबड, <verse eid="DEU 14:16"/><verse number="17" style="v" sid="DEU 14:17"/>वाळवंटी घुबड, कुरर, करढोक, <verse eid="DEU 14:17"/><verse number="18" style="v" sid="DEU 14:18"/>करकोचा, कोणत्याही प्रकारचे बगळे, टिटवी आणि वटवाघूळ.<verse eid="DEU 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 14:19"/>सर्वप्रकारचे उडणारे कीटक तुमच्यासाठी अशुद्ध आहेत; ते तुम्ही खाऊ नये. <verse eid="DEU 14:19"/><verse number="20" style="v" sid="DEU 14:20"/>पण पंख असलेले कोणतेही पक्षी जे शुद्ध आहेत ते तुम्ही खाऊ शकता.<verse eid="DEU 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21"/>आधीच मृत्यू पावलेले असे काहीही तुम्ही खाऊ नये. तुमच्या नगरात राहणार्‍या एखाद्या परकियाने ते खाण्यास हरकत नाही. किंवा परकियाला विकत द्यावा, परंतु तुम्ही याहवेह तुमच्या परमेश्वराचे पवित्रजन आहात.</para>
  <para style="p" vid="DEU 14:21">त्याच्या आईच्या दुधात करडाला कधीही शिजवू नये.<verse eid="DEU 14:21"/></para>
  <para style="s1">दशांश</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22"/>तुमच्या शेतात प्रत्येक वर्षी होणार्‍या उत्पन्नाचा दशांश भाग वेगळा ठेवण्याची खात्री करा. <verse eid="DEU 14:22"/><verse number="23" style="v" sid="DEU 14:23"/>धान्याचा, नवीन द्राक्षारसाचा व जैतुनाच्या तेलाचा दशांश आणि तुमच्या गुरांच्या व शेरडामेंढरांच्या प्रथम वत्सांनाही याहवेह तुमच्या परमेश्वरासमोर त्यांच्या नावाप्रित्यर्थ खाण्यासाठी, ते जे पवित्रस्थान निवडतील त्या ठिकाणी खा, म्हणजे तुम्ही याहवेह तुमच्या परमेश्वराचे नेहमीच आदर करण्याचे शिकाल. <verse eid="DEU 14:23"/><verse number="24" style="v" sid="DEU 14:24"/>परंतु जर ते ठिकाण खूप दूर असेल आणि तुम्ही याहवेह तुमच्या परमेश्वराद्वारे आशीर्वादित झाला असाल आणि तुमचा दशांश घेऊन जाणे गैरसोईचे असेल (कारण जे ठिकाण याहवेह त्यांच्या नावाच्या स्थापनेसाठी निवडतील ते खूप दूर आहे), <verse eid="DEU 14:24"/><verse number="25" style="v" sid="DEU 14:25"/>तर मग तुमचे दशांश चांदीच्या मोबदल्यात घ्या, ही चांदी तुमच्याबरोबर घ्या आणि याहवेह तुमचे परमेश्वर निवडतील त्या ठिकाणी जा. <verse eid="DEU 14:25"/><verse number="26" style="v" sid="DEU 14:26"/>त्या चांदीने तुम्हाला आवडेल ते विकत घ्या: गाई, बैल, मेंढी, थोडा द्राक्षारस अथवा आंबलेले पेय आणि तुम्हाला हवे असलेले काहीही. त्या ठिकाणी याहवेह तुमच्या परमेश्वरासमोर तुम्ही आणि तुमच्या कुटुंबासह खाऊन पिऊन आनंद करावा. <verse eid="DEU 14:26"/><verse number="27" style="v" sid="DEU 14:27"/>आणि तुमच्या नगरात राहत असलेल्या लेवी वंशजांकडे तुम्ही कधीही दुर्लक्ष करू नये; कारण त्यांना तुमच्यासारखा वाटा अथवा वतन नाही.<verse eid="DEU 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 14:28"/>प्रत्येक तिसर्‍या वर्षाच्या शेवटी संपूर्ण उत्पन्नाचा दशांश आणावा आणि तुमच्या नगरात एकत्र साठवून ठेवावा, <verse eid="DEU 14:28"/><verse number="29" style="v" sid="DEU 14:29"/>म्हणजे लेवी वंशजांना (ज्यांना स्वतःचा वाटा अथवा वतन नाही) तो दशांश द्यावा किंवा परकियांना द्यावा अथवा तुमच्या नगरात असणार्‍या विधवांना आणि अनाथांना द्यावा. म्हणजे ते खाऊन तृप्त होतील आणि मग याहवेह तुमचे परमेश्वर तुम्हाला आणि तुमच्या हाताच्या कार्याला आशीर्वादित करतील.<verse eid="DEU 14:29"/></para>
  <chapter eid="DEU 14"/>
  <chapter number="15" style="c" sid="DEU 15"/>
  <para style="s1">ॠणविमोचनाचे वर्ष</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1"/>प्रत्येक सातव्या वर्षाच्या शेवटी सर्व कर्ज माफ करावे. <verse eid="DEU 15:1"/><verse number="2" style="v" sid="DEU 15:2"/>कर्जमाफीची प्रक्रिया अशी असावी: प्रत्येक सावकाराने आपल्याजवळ असलेल्या कोणाही इस्राएली बंधूचे कर्ज माफ करावे. त्यांना स्वतःच्या लोकांपैकी कोणाकडूनही पैसे घ्यावे लागणार नाहीत, कारण कर्जाची फेड करण्याची वेळ याहवेहने घोषित केली आहे. <verse eid="DEU 15:2"/><verse number="3" style="v" sid="DEU 15:3"/>परदेशी पासून असलेले कर्ज तुम्हाला वसूल करता येईल, परंतु तुमच्याच बांधवांची देणी तुम्ही मुळीच वसूल करू नयेत. <verse eid="DEU 15:3"/><verse number="4" style="v" sid="DEU 15:4"/>तरीसुद्धा तुमच्यात कोणीही दरिद्री असा राहू नये, कारण याहवेह तुमचे परमेश्वर तुम्हाला वतनादाखल देऊ केलेल्या या देशात भरपूर आशीर्वाद देतील, <verse eid="DEU 15:4"/><verse number="5" style="v" sid="DEU 15:5"/>जर तुम्ही पूर्णपणे याहवेह तुमच्या परमेश्वराच्या आज्ञेत राहाल आणि आज मी तुम्हाला देत असलेल्या या सर्व आज्ञा काळजीपूर्वक पाळाल तरच. <verse eid="DEU 15:5"/><verse number="6" style="v" sid="DEU 15:6"/>कारण याहवेह तुमच्या परमेश्वराने अभिवचन दिल्याप्रमाणे ते तुम्हाला आशीर्वाद देतील आणि तुम्ही अनेक राष्ट्रांना कर्ज द्याल पण तुम्ही मात्र कर्ज घेणार नाही. तसेच तुम्ही अनेक राष्ट्रांवर राज्य कराल, पण ती राष्ट्रे तुम्हावर राज्य करणार नाहीत.<verse eid="DEU 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7"/>परंतु याहवेह तुमचे परमेश्वर जो देश तुम्हाला देत आहेत, त्यातील कोणत्याही नगरात कोणी इस्राएली बांधव गरीब असेल, तर त्यांच्याकरिता तुमचे हृदय कठोर करू नका किंवा तुमची मूठ बांधून ठेऊ नका. <verse eid="DEU 15:7"/><verse number="8" style="v" sid="DEU 15:8"/>त्यांना गरज लागेल तितके तुम्ही त्यांना उदारमनाने व निर्व्याज उसने द्यावे. <verse eid="DEU 15:8"/><verse number="9" style="v" sid="DEU 15:9"/>हा दुष्ट विचार मनात न आणण्याची खबरदारी घ्या: “कर्जमाफी करण्याचे सातवे वर्ष जवळ आले आहे.” म्हणून तुम्ही एखाद्या इस्राएली बांधवाबद्दल वाईट इच्छा दाखवू नका आणि मदत नाकारू नका. जर तो याहवेहकडे आपले गार्‍हाणे घेऊन गेला, तर ते तुमच्याविरुद्ध पाप असे मोजण्यात येईल. <verse eid="DEU 15:9"/><verse number="10" style="v" sid="DEU 15:10"/>तुम्ही त्यांना उदारपणे दिले पाहिजे आणि त्याबद्दल तुम्ही अंतःकरणात कुरकुर करू नये; मग तुम्ही जे काही कराल आणि जे कार्य हातात घ्याल त्यात याहवेह तुमचे परमेश्वर तुम्हाला आशीर्वादित करतील. <verse eid="DEU 15:10"/><verse number="11" style="v" sid="DEU 15:11"/>देशात नेहमीच गरीब असतील. म्हणून मी तुम्हाला आज्ञा देत आहे की तुमच्या देशातील इस्राएली बांधव जे गरीब आणि गरजवंत आहेत, त्यांना उदारहस्ते मदत करावी.<verse eid="DEU 15:11"/></para>
  <para style="s1">दासदासींना स्वतंत्र करणे</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12"/>जर तुमच्यापैकी कोणी—इब्री पुरुष किंवा इब्री स्त्री—दास म्हणून स्वतःला विकले आणि सहा वर्षे त्यांनी तुमची सेवा केल्यानंतर सातव्या वर्षी त्यांना मुक्त करावे. <verse eid="DEU 15:12"/><verse number="13" style="v" sid="DEU 15:13"/>आणि ज्यावेळी तुम्ही त्यांना मुक्त कराल, त्यावेळी त्यांना रिकाम्या हाताने जाऊ देऊ नका. <verse eid="DEU 15:13"/><verse number="14" style="v" sid="DEU 15:14"/>तर तुम्ही तुमच्या गुरांच्या कळपातून, तुमच्या खळ्यातून, तुमच्या द्राक्षारसाच्या कुंडातून उदारहस्ते द्यावे. ज्याप्रकारे याहवेह तुमच्या परमेश्वराने तुम्हाला आशीर्वादित केले आहे त्याप्रकारे त्यांना द्या. <verse eid="DEU 15:14"/><verse number="15" style="v" sid="DEU 15:15"/>स्मरण ठेवा, तुम्हीही इजिप्त देशामध्ये गुलाम होता आणि याहवेह तुमच्या परमेश्वराने तुमची सुटका केली. म्हणूनच मी आज तुम्हाला ही आज्ञा देत आहे.<verse eid="DEU 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16"/>परंतु तुमच्या दासाची तुमच्यावर आणि तुमच्या कुटुंबावर प्रीती असेल आणि त्याला तुमच्या घरी राहण्यात आनंद वाटत असेल आणि तो तुम्हाला म्हणेल की “तुम्हाला सोडून जाण्याची माझी इच्छा नाही,” <verse eid="DEU 15:16"/><verse number="17" style="v" sid="DEU 15:17"/>तर आरी घेऊन, त्याचा कान दरवाजावर धरून, तो आरपार टोचावा. मग तो तुमचा कायमचाच दास होईल. तुमच्या दासीचेही असेच करावे.<verse eid="DEU 15:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 15:18"/>पण जेव्हा तुम्ही तुमच्या दासदासींना दास्यातून मुक्त कराल, तेव्हा वाईट वाटून घेऊ नये; कारण लक्षात ठेवा की, सहा वर्षात एखाद्या मोलकर्‍यासाठी जितका खर्च तुम्हाला आला असता, त्याच्या निम्म्याहूनही कमी खर्चात त्यांनी तुमचे काम केले आहे आणि त्यांना मुक्त करण्यासाठी तुम्ही जे काही कराल, त्याबद्दल याहवेह तुमचे परमेश्वर तुम्हाला आशीर्वादित करतील.<verse eid="DEU 15:18"/></para>
  <para style="s1">पशूंचे प्रथम जन्मलेले</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19"/>तुमच्या गुरांचे आणि शेरडामेंढरांचे प्रथम जन्मलेले नर, याहवेह तुमच्या परमेश्वरासाठी तुम्ही पवित्र म्हणून वेगळे ठेवावेत. तुमच्या गुरांचे प्रथमवत्स तुम्ही शेतीच्या कामासाठी वापरू नयेत आणि तुमच्या मेंढरांच्या प्रथम वत्साची लोकर कातरू नये. <verse eid="DEU 15:19"/><verse number="20" style="v" sid="DEU 15:20"/>प्रत्येक वर्षी तुम्ही आणि तुमच्या कुटुंबाने याहवेह तुमच्या परमेश्वरासमोर, ते जे स्थान निवडतील त्या ठिकाणी त्यांचे मांस खावे. <verse eid="DEU 15:20"/><verse number="21" style="v" sid="DEU 15:21"/>तरी, त्या प्राण्यात काही दोष आढळल्यास, म्हणजे तो लंगडा किंवा आंधळा असेल किंवा त्यामध्ये कोणतेही व्यंग असले तर याहवेह तुमच्या परमेश्वराला त्याचे अर्पण करू नये. <verse eid="DEU 15:21"/><verse number="22" style="v" sid="DEU 15:22"/>ते तुम्ही आपल्याच नगरात खावे. हरिण किंवा सांबर खातात त्याप्रमाणेच, विधीनुसार अशुद्ध व शुद्ध यांनी ते खावे; <verse eid="DEU 15:22"/><verse number="23" style="v" sid="DEU 15:23"/>परंतु तुम्ही त्याच्या रक्ताचे सेवन करू नये; तर ते पाण्यासारखे जमिनीवर ओतून द्यावे.<verse eid="DEU 15:23"/></para>
  <chapter eid="DEU 15"/>
  <chapter number="16" style="c" sid="DEU 16"/>
  <para style="s1">वल्हांडण सण</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1"/>अवीव हा महिना पाळावा आणि याहवेह तुमच्या परमेश्वरासाठी वल्हांडण सण साजरा करावा, कारण त्यांनी अवीव महिन्यात तुम्हाला इजिप्त देशामधून रात्रीच्या वेळी बाहेर काढले. <verse eid="DEU 16:1"/><verse number="2" style="v" sid="DEU 16:2"/>याहवेह तुमच्या परमेश्वराला तुमचे वल्हांडण सणाचे अर्पण म्हणजे शेरडेमेंढरे किंवा गाईबैल असावे आणि याहवेह त्यांच्या नावाच्या स्थापनेसाठी जे स्थान निवडतील तिथे त्याचे अर्पण करावे. <verse eid="DEU 16:2"/><verse number="3" style="v" sid="DEU 16:3"/>ते खमीर असलेल्या भाकरीबरोबर खाऊ नये, परंतु सात दिवस तुम्ही बेखमीर भाकर खावी, ही तुमच्या क्लेशाची भाकर होय, कारण इजिप्त देश घाईघाईने सोडताना तुम्हाला खावी लागली होती—इजिप्तमधून तुमची सुटका झाली त्या वेळेची आठवण तुम्हाला आयुष्यभर राहील. <verse eid="DEU 16:3"/><verse number="4" style="v" sid="DEU 16:4"/>सात दिवसापर्यंत तुमच्या संपूर्ण देशात खमीर अजिबात दृष्टीस पडू नये. बली देण्यात आलेले मांस दुसर्‍या दिवसाच्या सकाळपर्यंत राहू देऊ नये.<verse eid="DEU 16:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 16:5"/>याहवेह तुमचे परमेश्वर तुम्हाला देत असलेल्या शहरांपैकी कोणत्याही शहरात तुम्ही वल्हांडणाच्या यज्ञपशूचे अर्पण करावयाचे नाही, <verse eid="DEU 16:5"/><verse number="6" style="v" sid="DEU 16:6"/>तर ते आपल्या नावाच्या स्थापनेसाठी जे स्थान निवडतील तिथेच वल्हांडणाचा यज्ञपशू तुम्ही सूर्यास्ताच्या वेळी अर्पावा, कारण त्याच वेळेला<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">काही मूळ प्रतीमध्ये </char><char style="fqa" closed="false">वर्धापनदिनी</char></note> तुम्ही इजिप्त देशामधून बाहेर पडला होता. <verse eid="DEU 16:6"/><verse number="7" style="v" sid="DEU 16:7"/>याहवेह तुमचे परमेश्वर निवडतील त्या स्थानी ते भाजावे आणि खावे. मग दुसर्‍या दिवशी सकाळी आपल्या तंबूत परतावे. <verse eid="DEU 16:7"/><verse number="8" style="v" sid="DEU 16:8"/>तुम्ही सहा दिवस बेखमीर भाकर खावी आणि सातव्या दिवशी याहवेह तुमच्या परमेश्वरासाठी सभा भरवावी आणि कोणतेही काम करू नये.<verse eid="DEU 16:8"/></para>
  <para style="s1">सप्ताहाचा सण</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9"/>उभ्या पिकाला विळा लावल्यापासून तुम्ही सात आठवडे मोजावे. <verse eid="DEU 16:9"/><verse number="10" style="v" sid="DEU 16:10"/>मग याहवेह तुमच्या परमेश्वरासमोर तुम्ही सप्ताहांचा उत्सव साजरा करावा. यावेळी तुम्ही तुम्हाला मिळालेल्या आशीर्वादांच्या प्रमाणात याहवेह तुमच्या परमेश्वराला स्वेच्छार्पणे वाहावीत. <verse eid="DEU 16:10"/><verse number="11" style="v" sid="DEU 16:11"/>याहवेह तुमच्या परमेश्वरासमोर त्यांनी आपल्या नावासाठी निवडलेल्या पवित्रस्थानी—तुम्ही, तुमचे पुत्र व कन्या, तुमचे दास व दासी, तुमच्या नगरातील लेवी आणि परदेशी, तुमच्यामध्ये राहणारे अनाथ आणि विधवा यांनाही उत्सवात सामील करून घ्यावे. <verse eid="DEU 16:11"/><verse number="12" style="v" sid="DEU 16:12"/>तुम्ही इजिप्त देशामध्ये गुलाम होता, याचे तुम्हाला स्मरण राहावे आणि म्हणून या विधीचे तुम्ही काळजीपूर्वक पालन करावे.<verse eid="DEU 16:12"/></para>
  <para style="s1">मंडपांचा सण</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13"/>तुमच्या खळ्यातील आणि द्राक्षकुंडातील उत्पादन तुम्ही गोळा केल्यानंतर सात दिवस मंडपाचा सण साजरा करा. <verse eid="DEU 16:13"/><verse number="14" style="v" sid="DEU 16:14"/>आनंदोत्सव साजरा करण्यास—तुम्ही, तुमचे पुत्र व कन्या, तुमचे दास व दासी, तुमच्या नगरातील लेवी, परदेशी, तुमच्यामध्ये राहणारे अनाथ आणि विधवा यांनाही उत्सवात सामील करून घ्यावे. <verse eid="DEU 16:14"/><verse number="15" style="v" sid="DEU 16:15"/>हा सण सात दिवस याहवेह तुमचे परमेश्वर जे स्थान निवडतील तिथे साजरा करावा. कारण याहवेह तुमच्या परमेश्वराने तुम्हाला तुमच्या सर्व उत्पन्नात आणि हाती घेतलेल्या तुमच्या कामात आशीर्वादित केले यास्तव तुमचा आनंद परिपूर्ण व्हावा.<verse eid="DEU 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16"/>वर्षातून तीन वेळा तुमच्या सर्व पुरुषांनी याहवेह तुमच्या परमेश्वरासमोर हजर व्हावे: बेखमीर भाकरीचा सण, सप्ताहांचा सण व मंडपांचा सण. या प्रत्येक प्रसंगी याहवेहसमोर रिक्तहस्ते येऊ नये: <verse eid="DEU 16:16"/><verse number="17" style="v" sid="DEU 16:17"/>याहवेह तुमच्या परमेश्वराने तुम्हाला ज्याप्रकारे आशीर्वादित केले आहे, त्या प्रमाणात तुम्ही प्रत्येकाने भेटवस्तू आणावी.<verse eid="DEU 16:17"/></para>
  <para style="s1">न्यायाधीश</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18"/>याहवेह तुमचे परमेश्वर जी सर्व शहरे तुमच्या प्रत्येक गोत्राला देणार आहेत, त्या सर्व शहरांमध्ये न्यायाधीश आणि शास्ते यांची तुम्ही नेमणूक करावी व त्यांनी लोकांचा न्याय नीतीने करावा. <verse eid="DEU 16:18"/><verse number="19" style="v" sid="DEU 16:19"/>भेदभाव किंवा विपरीत असा न्याय कधीही करू नये. लाच घेऊ नये, कारण लाच ही शहाण्या माणसांना आंधळे करते आणि निरपराध्याचे शब्द विपरीत करते. <verse eid="DEU 16:19"/><verse number="20" style="v" sid="DEU 16:20"/>न्याय आणि केवळ न्यायाचीच कास तुम्ही धरावी, जेणेकरून याहवेह तुमचे परमेश्वर तुम्हाला देणार असलेल्या देशाचा ताबा घेऊन तुम्ही तिथे वस्ती करू शकाल.<verse eid="DEU 16:20"/></para>
  <para style="s1">अन्य दैवतांची पूजा</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21"/>याहवेह तुमच्या परमेश्वराच्या वेदीशेजारी तुम्ही अशेरा मूर्तीचे लाकडी स्तंभ उभारू नका, <verse eid="DEU 16:21"/><verse number="22" style="v" sid="DEU 16:22"/>आणि पूजास्तंभ उभारू नयेत, कारण याहवेह तुमच्या परमेश्वराला त्यांचा अत्यंत तिटकारा आहे.<verse eid="DEU 16:22"/></para>
  <chapter eid="DEU 16"/>
  <chapter number="17" style="c" sid="DEU 17"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1"/>तुम्ही याहवेह तुमच्या परमेश्वराला दोष अथवा व्यंग असलेला बैल किंवा मेंढरू यांचे अर्पण कदापि करू नये; कारण त्याचा त्यांना वीट आहे.<verse eid="DEU 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2"/>समजा याहवेहने तुम्हाला दिलेल्या देशातील एखाद्या नगरात तुमच्यातील कोणी पुरुष अथवा स्त्री याहवेह तुमच्या परमेश्वराच्या कराराविरुद्ध त्यांच्या दृष्टीने पातक करेल, <verse eid="DEU 17:2"/><verse number="3" style="v" sid="DEU 17:3"/>आणि त्यांनी माझ्या आज्ञेच्या विरुद्ध अन्य दैवतांची उपासना केली, त्यांना किंवा सूर्य किंवा चंद्र किंवा आकाशातील तारे यांना नमन केले, <verse eid="DEU 17:3"/><verse number="4" style="v" sid="DEU 17:4"/>आणि हे तुमच्या कानी आले, तर ही गोष्ट खरी आहे की नाही याची तुम्ही प्रथम काळजीपूर्वक खात्री करून घ्यावी. इस्राएलात ही घृणास्पद गोष्ट घडली आहे व हे सत्य आहे असे निश्चित झाल्यावर, <verse eid="DEU 17:4"/><verse number="5" style="v" sid="DEU 17:5"/>ही घृणास्पद गोष्ट करणार्‍या त्या पुरुषाला अथवा स्त्रीला नगराच्या वेशीजवळ घेऊन जावे आणि त्या व्यक्तीला मरेपर्यंत धोंडमार करावा. <verse eid="DEU 17:5"/><verse number="6" style="v" sid="DEU 17:6"/>दोन किंवा तीन साक्षीदारांच्या साक्षीवर एखाद्याला मृत्यू दंड द्यावे लागते, परंतु केवळ एका साक्षीदाराच्या साक्षीवर कोणालाही मृत्यू दंड देऊ नये. <verse eid="DEU 17:6"/><verse number="7" style="v" sid="DEU 17:7"/>ही धोंडमार करण्यासाठी जे साक्षीदार आहेत, त्यांनी प्रथम त्या मनुष्याला दगडमार करावा आणि नंतर इतरांनी त्यात सहभागी व्हावे. अशा रीतीने तुमच्यामधून दुष्टाई घालवून तुम्ही स्वतःला शुद्ध करून घ्यावे.<verse eid="DEU 17:7"/></para>
  <para style="s1">न्यायालये</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8"/>तुमच्या न्यायालयात खटले येतात, ज्यांचा निवाडा करण्याचे काम तुमच्या आवाक्याबाहेरचे असेल—मग ते रक्तपात असो, फिर्याद अथवा मारामारी असोत—याहवेह तुमच्या परमेश्वराने निवडलेल्या स्थानी तुम्ही तो वाद न्यावा. <verse eid="DEU 17:8"/><verse number="9" style="v" sid="DEU 17:9"/>त्याकाळी जे लेवी याजक किंवा न्यायाधीश आपल्या पदावर असतील, त्यांच्याशी तुम्ही मसलत करावी आणि ते त्या वादाचा निर्णय तुम्हाला देतील. <verse eid="DEU 17:9"/><verse number="10" style="v" sid="DEU 17:10"/>ते आपला निर्णय देतील आणि ते सांगतील त्याप्रमाणे अगदी तंतोतंत तुम्ही करावे. याहवेहने निवडलेल्या स्थानी त्यांनी दिलेला निर्णय तुम्ही अगदी तंतोतंत पाळावा. त्यांनी तुम्हाला जे काही करण्यास सांगितले आहे ते सर्व करण्याची काळजी घ्या. <verse eid="DEU 17:10"/><verse number="11" style="v" sid="DEU 17:11"/>ते तुम्हाला जे काही शिकवतील व जो निर्णय ते देतील, त्याच्या उजवीकडे वा डावीकडे न वळता, तो अंमलात आणावा. <verse eid="DEU 17:11"/><verse number="12" style="v" sid="DEU 17:12"/>याहवेह तुमच्या परमेश्वराने निवडलेला, त्यावेळी पदावर असलेल्या न्यायाधीशाचा अथवा याजकांचा निर्णय न पाळण्याचे धाडस जो कोणी करेल, त्याला मृत्यूची शिक्षा दिली जावी. अशा रीतीने इस्राएलातून तुम्हाला ही दुष्टाई काढून टाकता येईल. <verse eid="DEU 17:12"/><verse number="13" style="v" sid="DEU 17:13"/>हे सर्व लोक ऐकतील व भयभीत होतील आणि पुढे ते उन्मत्तपणा करणार नाहीत.<verse eid="DEU 17:13"/></para>
  <para style="s1">राजासंबंधी सूचना</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14"/>याहवेह तुमचे परमेश्वर तुम्हाला देणार असलेल्या देशात तुम्ही याल व तो ताब्यात घ्याल आणि स्वतःशी म्हणाल, “इतर राष्ट्रांना जसा राजा आहे तसा आपल्यालाही असावा,” <verse eid="DEU 17:14"/><verse number="15" style="v" sid="DEU 17:15"/>तर ज्या माणसाची याहवेह तुमचे परमेश्वर निवड करतील, त्यालाच तुम्ही राजा म्हणून नेमावे. तो तुमच्या भाऊबंदांपैकी असावा; परदेशीयाला म्हणजे इस्राएली पैकी नसलेल्यास तुम्ही राजा म्हणून नेमू नये.<verse eid="DEU 17:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 17:16"/>राजाने स्वतःसाठी घोड्यांचा मोठा संग्रह करू नये किंवा त्याने आपल्यासाठी अधिक घोडे आणण्यासाठी आपली माणसे इजिप्त देशात पाठवू नये, कारण “तुम्ही त्या मार्गाने परत जाऊ नये,” असे याहवेहने तुम्हाला सांगितले आहे. <verse eid="DEU 17:16"/><verse number="17" style="v" sid="DEU 17:17"/>तुमच्या राजाने अनेक स्त्रिया करू नयेत, जेणेकरून त्याचे अंतःकरण बहकून जाईल. त्याने आपल्यासाठी चांदी व सोन्याचा मोठा संग्रह करू नये.<verse eid="DEU 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18"/>जेव्हा तो आपल्या राजासनावर बसेल, तेव्हा त्याने लेवी याजकांच्या जवळ असणार्‍या नियमशास्त्रामधून हे सर्व नियम व आज्ञा स्वतः लिहून काढाव्यात. <verse eid="DEU 17:18"/><verse number="19" style="v" sid="DEU 17:19"/>ती प्रत नेहमीच त्याच्याजवळ असेल. त्याने त्या नियमांचे दररोज वाचन करावे म्हणजे तो याहवेह त्याच्या परमेश्वराचा आदर करण्यास शिकेल आणि या नियमाचे आणि विधीचे सर्व शब्द काळजीपूर्वक पाळेल <verse eid="DEU 17:19"/><verse number="20" style="v" sid="DEU 17:20"/>व त्याने स्वतःला आपल्या इस्राएली बांधवांपेक्षा अधिक श्रेष्ठ समजू नये आणि नियमांपासून उजवीकडे किंवा डावीकडे वळू नये. मग तो आणि त्याचे वंशज अनेक पिढ्या इस्राएलावर दीर्घकाळ राज्य करतील.<verse eid="DEU 17:20"/></para>
  <chapter eid="DEU 17"/>
  <chapter number="18" style="c" sid="DEU 18"/>
  <para style="s1">याजक व लेवी यांचा वाटा</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1"/>लेवी याजकांना—अर्थात् संपूर्ण लेवी गोत्राला—इतर गोत्रांप्रमाणे इस्राएलात वाटा किंवा वतन नाही. ते याहवेहला केलेल्या होमार्पणावर जगतील, कारण हेच त्यांचे वतन आहे. <verse eid="DEU 18:1"/><verse number="2" style="v" sid="DEU 18:2"/>त्यांच्या इस्राएली भाऊबंदांप्रमाणे त्यांना वतन नसेल; कारण याहवेहच त्यांचे वतन आहेत, जसे त्यांनी त्यांना अभिवचन दिले होते.<verse eid="DEU 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 18:3"/>बैलाचे किंवा मेंढराचे अर्पण करणार्‍या लोकांकडून मिळणारा याजकांचा हा वाटा आहे: खांदा, अंतर्गत अवयव आणि डोक्याचे मांस. <verse eid="DEU 18:3"/><verse number="4" style="v" sid="DEU 18:4"/>याशिवाय धान्य, नवा द्राक्षारस व जैतुनाचे तेल यांच्या उत्पन्नाचे प्रथम भाग आणि मेंढरांची प्रथम कातरलेली लोकर त्यांना दिली जावी, <verse eid="DEU 18:4"/><verse number="5" style="v" sid="DEU 18:5"/>कारण याहवेह तुमच्या परमेश्वराने त्यांना आणि त्यांच्या वंशजांना सर्व गोत्रातून पिढ्यान् पिढ्या निरंतर उभे राहून आणि याहवेहच्या नावाची सेवा करण्यासाठी निवडले आहे.<verse eid="DEU 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6"/>जर एखाद्या लेवीची इस्राएली राष्ट्राच्या एका नगरातून दुसर्‍या नगरात जाऊन राहण्याची कळकळीची इच्छा असल्यास आणि तो याहवेहने निवडलेल्या पवित्रस्थानी येऊन राहिल्यास, <verse eid="DEU 18:6"/><verse number="7" style="v" sid="DEU 18:7"/>याहवेह त्याच्या परमेश्वराच्या नावाने इस्राएली भूमीत इतर लेवी बांधवांप्रमाणे याहवेहच्या उपस्थितीत त्याने सेवा करावी. <verse eid="DEU 18:7"/><verse number="8" style="v" sid="DEU 18:8"/>वारसाहक्काने मिळालेली संपत्ती विकून आलेले पैसे त्याच्याकडे असतील तरी देखील त्याला इतरांप्रमाणेच सारखा वाटा मिळावा.<verse eid="DEU 18:8"/></para>
  <para style="s1">अमंगळ चालीरीती</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9"/>जेव्हा तुम्ही याहवेह तुमच्या परमेश्वराने दिलेल्या वचनदत्त देशात याल, तेव्हा त्या देशात राहणार्‍या राष्ट्रांच्या अमंगळ चालीरीती शिकू नका. <verse eid="DEU 18:9"/><verse number="10" style="v" sid="DEU 18:10"/>तुमच्यामध्ये आपल्या पुत्राचा किंवा कन्येचा होम करणारा, शकुनमुहूर्त पाहणारा किंवा चेटके करणारा, दुष्ट आत्म्यांची मदत घेऊन भविष्य सांगणारा, जादूटोणा करणारा, <verse eid="DEU 18:10"/><verse number="11" style="v" sid="DEU 18:11"/>अथवा वशीकरण करणारा, अथवा कोणी मध्यस्थ अथवा मृतात्म्यांना बोलावून त्यांच्याशी मसलत करणारा असू नये. <verse eid="DEU 18:11"/><verse number="12" style="v" sid="DEU 18:12"/>जो कोणी अशी कृत्ये करतो त्याचा याहवेहला तिरस्कार आहे; आणि त्यांच्या या अमंगळ कृत्यांमुळेच त्या राष्ट्रांना याहवेह तुमचे परमेश्वर तुमच्यापुढून घालवून देणार आहेत. <verse eid="DEU 18:12"/><verse number="13" style="v" sid="DEU 18:13"/>तुम्ही याहवेह तुमच्या परमेश्वरापुढे निर्दोषपणे चालावे.<verse eid="DEU 18:13"/></para>
  <para style="s1">संदेष्टा</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 18:14"/>जी सर्व राष्ट्रे शकुनमुहूर्त पाहणार्‍यांचे व दैवज्ञांची भाकिते ऐकतात त्या राष्ट्रांचा ताबा तुम्ही घेणार आहात, त्यामधून त्यांना हुसकावून लावा. परंतु याहवेह तुमचे परमेश्वर तुम्हाला अशा गोष्टी करण्याची परवानगी देत नाहीत. <verse eid="DEU 18:14"/><verse number="15" style="v" sid="DEU 18:15"/>याहवेह तुमचे परमेश्वर इस्राएलातून तुमच्यासाठी माझ्यासारखा एक संदेष्टा उभा करतील. तुम्ही त्याचे ऐकावे. <verse eid="DEU 18:15"/><verse number="16" style="v" sid="DEU 18:16"/>कारण होरेबाच्या पर्वताजवळ हीच विनंती तुम्ही स्वतः याहवेह तुमच्या परमेश्वराजवळ केली होती, जेव्हा तुम्ही विनविले, “याहवेह आमच्या परमेश्वराचा भयावह आवाज पुन्हा ऐकण्याचा अथवा त्या पर्वतावर तो भयावह अग्नी पुनरपि पाहण्याचा प्रसंग आम्हावर येऊ नये, नाहीतर आम्हाला मृत्यू येईल.”<verse eid="DEU 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 18:17"/>तेव्हा याहवेह मला म्हणाले: “ते जे म्हणतात ते योग्य आहे. <verse eid="DEU 18:17"/><verse number="18" style="v" sid="DEU 18:18"/>त्यांच्या भाऊबंदांतून मी त्यांच्यासाठी तुझ्यासारखा एक संदेष्टा उभा करेन आणि मी माझी वचने त्याच्या मुखात घालेन. मी त्याला ज्याकाही आज्ञा देईन त्या सर्व तो त्यांना सांगेल. <verse eid="DEU 18:18"/><verse number="19" style="v" sid="DEU 18:19"/>तो संदेष्टा जे काही माझ्या नावाने बोलेल आणि जो कोणी माझे शब्द ऐकणार नाही, त्याची मी स्वतः झडती घेईन. <verse eid="DEU 18:19"/><verse number="20" style="v" sid="DEU 18:20"/>पण जो संदेष्टा माझ्या नावाने असे काही बोलतो ज्याची मी आज्ञा दिली नाही किंवा जो संदेष्टा इतर दैवतांच्या नावाने बोलतो त्याला जिवे मारावे.”<verse eid="DEU 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 18:21"/>तुम्ही स्वतःशी म्हणू शकता, “हा संदेश याहवेह बोलले नाहीत, हे आम्ही कसे ओळखावे?” <verse eid="DEU 18:21"/><verse number="22" style="v" sid="DEU 18:22"/>तर एखाद्या संदेष्ट्याने याहवेहच्या नावाने ज्या गोष्टीची घोषणा केलेली असेल, ती गोष्ट जर घडून आली नाही किंवा खरेच तसे होत नसेल तर तो संदेश याहवेहने दिलेला नाही. तो संदेष्टा उन्मत्तपणे बोलला आहे, तुम्ही त्याचे भय बाळगू नये.<verse eid="DEU 18:22"/></para>
  <chapter eid="DEU 18"/>
  <chapter number="19" style="c" sid="DEU 19"/>
  <para style="s1">आश्रयाची शहरे</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1"/>याहवेह तुमचे परमेश्वर जी भूमी तुम्हाला देणार आहेत, तेथील राष्ट्रांचा ते नाश करतील व जेव्हा तुम्ही त्यांना त्या भूमीतून घालवून द्याल आणि त्यांच्या शहरात व घरात वस्ती कराल, <verse eid="DEU 19:1"/><verse number="2" style="v" sid="DEU 19:2"/>त्यावेळी याहवेह तुमचे परमेश्वर जी भूमी तुम्हाला वतन म्हणून देत आहेत, त्यामधील तीन शहरे तुम्ही वेगळी करून ठेवावी. <verse eid="DEU 19:2"/><verse number="3" style="v" sid="DEU 19:3"/>यातील अंतर निश्चित करा आणि याहवेह तुमचे परमेश्वर तुम्हाला वतन म्हणून देत असलेल्या भूमीचे तीन भाग करा, म्हणजे एखाद्याने कोणाची हत्या केली, तर त्याला स्वतःच्या संरक्षणासाठी त्या नगरात पळून जाता येईल.<verse eid="DEU 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4"/>जो कोणी एखाद्या व्यक्तीची हत्या करतो आणि आश्रयाच्या नगरात पळून जातो, त्याच्यासाठी हे नियम असावे: एखाद्या मनुष्याने मनात काहीही द्वेष नसताना व हेतुपुरस्सर नव्हे, पण चुकून त्याच्या शेजार्‍याचा वध केला. <verse eid="DEU 19:4"/><verse number="5" style="v" sid="DEU 19:5"/>एखादा मनुष्य लाकडे तोडण्यासाठी आपल्या शेजार्‍याबरोबर अरण्यात गेला आणि झाड तोडत असता त्याने कुर्‍हाड चालविली व ती दांड्यातून निसटून उडाली व त्याच्या शेजार्‍याला ती लागली आणि तो मरण पावला, तर त्या मनुष्याने पळून जाऊन या तीन शहरांपैकी एका शहराचा आश्रय घेऊन सुरक्षित राहावे. <verse eid="DEU 19:5"/><verse number="6" style="v" sid="DEU 19:6"/>नाही तर, अशा रक्तपाताबद्दल सूड घेणारा संतापाने त्याचा पाठलाग करेल व मार्ग लांब असल्याने त्याला वाटेत गाठून ठार मारेल. त्याला मृत व्यक्तीबद्दल द्वेष नव्हता व त्याने पूर्वनियोजित केल्याशिवाय आपल्या शेजार्‍याशी हे कृत्य केले, तो प्राणदंडाच्या शिक्षेस पात्र नव्हता. <verse eid="DEU 19:6"/><verse number="7" style="v" sid="DEU 19:7"/>म्हणून मी तुम्हाला आज्ञा देतो की तीन शहरे निवडून ती वेगळी करून ठेवावी.<verse eid="DEU 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8"/>याहवेह तुमच्या परमेश्वराने तुमच्या पूर्वजांना वचन दिल्याप्रमाणे तुमच्या देशाच्या सीमांचा विस्तार करून संपूर्ण देश तुम्हाला दिला, <verse eid="DEU 19:8"/><verse number="9" style="v" sid="DEU 19:9"/>कारण मी आज तुम्हाला देत असलेल्या या सर्व आज्ञांचे काळजीपूर्वक पालन केले—तुम्ही याहवेह तुमच्या परमेश्वरावर प्रीती केली व त्यांच्या मार्गात आज्ञाधारकपणे चाललात—तर तुम्ही आणखी तीन शहरे निवडावीत. <verse eid="DEU 19:9"/><verse number="10" style="v" sid="DEU 19:10"/>हे करावे, अशा रीतीने याहवेह तुमचे परमेश्वर तुम्हाला वतनादाखल देत असलेल्या भूमीवर निरपराधी माणसांचे रक्त सांडल्याचा दोष तुमच्यावर येणार नाही.<verse eid="DEU 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11"/>परंतु कोणी द्वेषाने दबा धरून राहील व आपल्या शेजार्‍यावर अचानक प्राणघातक हल्ला करून त्याला ठार करेल आणि मग यापैकी एखाद्या शहरात पळून जाईल, <verse eid="DEU 19:11"/><verse number="12" style="v" sid="DEU 19:12"/>तर त्या गावाच्या वडील मंडळीने माणसे पाठवून त्याला धरून आणावे व त्याला वध झालेल्या माणसाच्या रक्तपाताचा सूड घेणार्‍याच्या स्वाधीन करावे. <verse eid="DEU 19:12"/><verse number="13" style="v" sid="DEU 19:13"/>त्याला दया दाखवू नये. इस्राएलास निरपराधी माणसांचे रक्त सांडल्याच्या दोषापासून शुद्ध करावे, म्हणजे तुमचे सर्व बाबतीत कल्याण होईल.<verse eid="DEU 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14"/>याहवेह तुमचे परमेश्वर जो देश तुम्हाला वतनात देत आहेत, तो ताब्यात घेतल्यावर, आधीच्या माणसांनी ठेवलेल्या शेजार्‍याच्या जमीन हद्दीच्या खुणा कदापि बदलू नये.<verse eid="DEU 19:14"/></para>
  <para style="s1">साक्षीदारासंबंधीचे नियम</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 19:15"/>केवळ एकाच साक्षीदाराच्या साक्षीवर तुम्ही कोणालाही त्याच्या गुन्ह्याबद्दल किंवा अपराधाबद्दल कदापि दोषी ठरवू नये. दोन किंवा तीन साक्षीदारांच्या संमतीने प्रकरण स्थापित केले पाहिजे.<verse eid="DEU 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16"/>एखाद्याने मत्सराने खोटी साक्ष देऊन कोणावर चुकीचा आरोप लावल्यास, <verse eid="DEU 19:16"/><verse number="17" style="v" sid="DEU 19:17"/>त्या दोन्हीही इसमांना याहवेहसमोर, त्यावेळी जबाबदार असलेल्या याजकांपुढे आणि न्यायाधीशांपुढे आणावे. <verse eid="DEU 19:17"/><verse number="18" style="v" sid="DEU 19:18"/>न्यायाधीशांनी त्यांची बारकाईने चौकशी करावी आणि साक्षीदार खोटे बोलत असल्याचे सिद्ध झाले व तो दुसर्‍या इस्राएली बांधवावर खोटा आरोप करीत असेल, <verse eid="DEU 19:18"/><verse number="19" style="v" sid="DEU 19:19"/>तर त्याच्या बांधवाचे जे करण्याचे त्याने मनात योजिले होते, तेच त्याचे करण्यात यावे. अशा रीतीने तुमच्यातील दुष्टाई तुम्ही घालवून टाकावी. <verse eid="DEU 19:19"/><verse number="20" style="v" sid="DEU 19:20"/>इतर लोक हे ऐकतील व भयभीत होतील आणि तुम्हामध्ये अशी दुष्टाई पुन्हा कधीही घडणार नाही. <verse eid="DEU 19:20"/><verse number="21" style="v" sid="DEU 19:21"/>खोट्या साक्षीदाराला तुम्ही दया दाखवू नये: जिवाबद्दल जीव, डोळ्याबद्दल डोळा, दाताबद्दल दात, हाताबद्दल हात, पायाबद्दल पाय.<verse eid="DEU 19:21"/></para>
  <chapter eid="DEU 19"/>
  <chapter number="20" style="c" sid="DEU 20"/>
  <para style="s1">युद्ध करण्याविषयीचे नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1"/>जेव्हा तुम्ही तुमच्या शत्रूशी युद्ध करण्यास जाल आणि तुमच्यासमोर घोडे व रथ आणि तुमच्या सैन्यापेक्षा फारच मोठे शत्रुसैन्य पाहाल, तेव्हा त्यांना घाबरू नका. कारण ज्यांनी तुम्हाला इजिप्त देशातून सुखरुपपणे बाहेर आणले, ते याहवेह तुमचे परमेश्वर तुम्हाबरोबर असतील. <verse eid="DEU 20:1"/><verse number="2" style="v" sid="DEU 20:2"/>तुम्ही युद्धाला सुरुवात करण्यापूर्वी, याजकाने पुढे यावे आणि सैन्याला सांगावे. <verse eid="DEU 20:2"/><verse number="3" style="v" sid="DEU 20:3"/>त्याने म्हणावे: “हे इस्राएली लोकहो, ऐका: जेव्हा आज तुम्ही लढण्यासाठी तुमच्या शत्रूविरुद्ध पुढे जात आहात; मन कचरू देऊ नका वा भयभीत होऊ नका; त्यांना घाबरू वा भिऊ नका. <verse eid="DEU 20:3"/><verse number="4" style="v" sid="DEU 20:4"/>कारण याहवेह तुमचे परमेश्वर तुम्हाबरोबर जात आहेत. ते तुमच्यासाठी तुमच्या शत्रूविरुद्ध लढतील आणि तुम्हाला विजय प्राप्त करून देतील.”<verse eid="DEU 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5"/>नंतर सेनाधिकारी आपल्या सैनिकांना म्हणतील: “तुम्हामध्ये असा कोणी आहे का, की ज्याने नुकतेच नवीन घर बांधले असून, तो अद्याप त्या घरात राहिला नाही? तर त्याने घरी जावे, कारण या युद्धात तो कदाचित मारला गेला तर दुसरा कोणीतरी त्या घरात राहू लागेल. <verse eid="DEU 20:5"/><verse number="6" style="v" sid="DEU 20:6"/>तुम्हापैकी असा कोणी आहे, ज्याने द्राक्षमळा लावला, पण त्याचे फळ अद्याप खाल्लेले नाही? तर त्याने घरी जावे. कदाचित युद्धात तो मारला जाईल आणि दुसरा कोणी त्याचा आनंद घेईन. <verse eid="DEU 20:6"/><verse number="7" style="v" sid="DEU 20:7"/>तुमच्यापैकी कोणाचा वाङ्निश्चय झालेला असून त्याचा अद्याप विवाह झाला नाही असा आहे का? त्याने घरी जावे आणि विवाह करावा. कदाचित युद्धात तो मारला जाईल आणि दुसरा कोणी तिच्याशी विवाह करेल.” <verse eid="DEU 20:7"/><verse number="8" style="v" sid="DEU 20:8"/>मग सेनाधिकारी पुढे म्हणेल, “तुम्हापैकी कोणी भेकड वा भित्रा आहे का? जर असेल, तर इतर सैनिकांना घाबरवून टाकण्यापूर्वी त्याने घरी निघून जावे.” <verse eid="DEU 20:8"/><verse number="9" style="v" sid="DEU 20:9"/>जेव्हा सेनाधिकारी आपले बोलणे संपवतील, ते सैनिकांवर सेनापती नियुक्त करतील.<verse eid="DEU 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10"/>युद्ध करण्याकरिता तुम्ही एखाद्या शहरावर हल्ला करण्यास पोहोचला, तर प्रथम तेथील लोकांना शांतीचा प्रस्ताव द्या. <verse eid="DEU 20:10"/><verse number="11" style="v" sid="DEU 20:11"/>जर त्यांनी तो मान्य केला आणि शहराच्या वेशी तुमच्यासाठी उघडल्या, तर त्या शहरातील सर्व रहिवासी तुमचे दास बनतील आणि तुमची सेवा करतील. <verse eid="DEU 20:11"/><verse number="12" style="v" sid="DEU 20:12"/>परंतु त्यांनी तह करण्याचे नाकारले व तुमच्याशी युद्ध करण्याची तयारी केली तर त्या शहराला तुम्ही वेढा घालावा. <verse eid="DEU 20:12"/><verse number="13" style="v" sid="DEU 20:13"/>जेव्हा याहवेह तुमचे परमेश्वर ते शहर तुमच्या ताब्यात देतील, तेव्हा त्यातील सर्व पुरुषांना तुम्ही तलवारीने ठार मारावे. <verse eid="DEU 20:13"/><verse number="14" style="v" sid="DEU 20:14"/>पण त्या शहरातील सर्व स्त्रिया, मुले, गुरे व सर्व संपत्ती तुम्ही स्वतःकरिता ठेवावी. ही संपत्ती जी याहवेह तुमचे परमेश्वर तुमच्या शत्रूकडून तुम्हाला देतील तिचा तुम्ही स्वतःसाठी उपयोग करावा. <verse eid="DEU 20:14"/><verse number="15" style="v" sid="DEU 20:15"/>तुमच्यापासून दूर असलेल्या व निकटवर्ती नसलेल्या राष्ट्राच्या सर्व शहरांच्याबाबतीत तुम्ही असेच वागावे.<verse eid="DEU 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 20:16"/>कारण याहवेह तुमचे परमेश्वर तुम्हाला देत असलेल्या वचनदत्त देशात असणार्‍या शहरातील कोणालाही तुम्ही जिवंत ठेऊ नये. <verse eid="DEU 20:16"/><verse number="17" style="v" sid="DEU 20:17"/>हिथी, अमोरी, कनानी, परिज्जी, हिव्वी आणि यबूसी—यांचा समूळ नायनाट करावा—ही आज्ञा याहवेह तुमच्या परमेश्वराने तुम्हाला दिली आहे. <verse eid="DEU 20:17"/><verse number="18" style="v" sid="DEU 20:18"/>नाहीतर ते त्यांच्या दैवतांची उपासना करताना ज्या किळसवाण्या चालीरीती करतात त्या तुम्हाला शिकवतील व तुम्ही याहवेह तुमच्या परमेश्वराविरुद्ध पाप कराल.<verse eid="DEU 20:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19"/>तुम्ही एखाद्या शहराला बरेच दिवस वेढा द्याल आणि ते हस्तगत करण्यासाठी त्याच्याविरुद्ध युद्ध कराल, तेव्हा तेथील झाडांचा कुर्‍हाड चालवून त्यांचा नाश करू नये. झाडांवरील पाहिजे तेवढी फळे तुम्ही खावी; पण झाडे मात्र तोडू नयेत. झाडे मनुष्य आहेत का त्यांना तुम्ही वेढा घालावा? <verse eid="DEU 20:19"/><verse number="20" style="v" sid="DEU 20:20"/>परंतु जी झाडे फळे न देणारी आहेत हे तुम्ही जाणता, त्यांचा वापर तुमच्याशी युद्ध सुरू असलेले शहर पडेपर्यंत वेढा बांधण्यासाठी करू शकता.<verse eid="DEU 20:20"/></para>
  <chapter eid="DEU 20"/>
  <chapter number="21" style="c" sid="DEU 21"/>
  <para style="s1">न उलगडलेल्या हत्येबद्दल नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1"/>याहवेह तुमच्या परमेश्वराने वतन म्हणून दिलेल्या देशात तुम्ही आल्यावर एखाद्या शेतामध्ये वध झालेला मनुष्यदेह तुम्हाला आढळला व त्याला कोणी मारले हे समजले नाही, <verse eid="DEU 21:1"/><verse number="2" style="v" sid="DEU 21:2"/>तर वडीलजनांनी आणि न्यायाधीशांनी तिथे जाऊन त्या मृतदेहापासून आजूबाजूच्या प्रत्येक नगरापर्यंत अंतर मोजावे. <verse eid="DEU 21:2"/><verse number="3" style="v" sid="DEU 21:3"/>नंतर मृतदेहाच्या सर्वात जवळ असलेल्या नगरातील वडीलजनांनी, कधीही कामास न लावलेली आणि पूर्वी कधीही जू न ठेवलेली अशी एक कालवड घ्यावी <verse eid="DEU 21:3"/><verse number="4" style="v" sid="DEU 21:4"/>आणि तिला वडिलांनी ज्या भूमीची कधी नांगरणी अथवा पेरणी केलेली नाही, अशा सतत पाणी वाहत असलेल्या खोर्‍यात नेऊन तिथे कालवडीची मान मोडावी. <verse eid="DEU 21:4"/><verse number="5" style="v" sid="DEU 21:5"/>यानंतर लेवी वंशातील याजक जवळ येतील, कारण याहवेह तुमच्या परमेश्वराने त्यांना आपल्यासमोर सेवा करण्यासाठी याहवेहच्या नावाने आशीर्वाद देण्यासाठी व वाद आणि हल्ला यांचे निर्णय घेण्यासाठी निवडलेले आहे. <verse eid="DEU 21:5"/><verse number="6" style="v" sid="DEU 21:6"/>मग मृत माणसाच्या देहाच्या सर्वात जवळ असलेल्या नगरातील सगळे वडीलजन आपले हात खोर्‍यात मान मोडून टाकलेल्या त्या कालवडीवर धुतील, <verse eid="DEU 21:6"/><verse number="7" style="v" sid="DEU 21:7"/>आणि त्यांनी हे घोषित करावे, “आमच्या हातांनी हा रक्तपात केलेला नाही किंवा आमच्या डोळ्यांनी तो पाहिलेला नाही. <verse eid="DEU 21:7"/><verse number="8" style="v" sid="DEU 21:8"/>हे याहवेह, ज्या तुमच्या इस्राएली लोकांना तुम्ही सोडविले आहे, त्या लोकांना तुम्ही क्षमा करा व निरपराधी माणसाच्या हत्येचा आरोप त्यांच्यावर ठेवू नका.” मग या रक्तपाताचे प्रायश्चित्त होईल, <verse eid="DEU 21:8"/><verse number="9" style="v" sid="DEU 21:9"/>आणि तुम्ही तुमच्यावरील निरपराधी माणसाच्या रक्तपाताचा दोष घालवून टाकाल, कारण याहवेहच्या दृष्टीने योग्य ते केले आहे.<verse eid="DEU 21:9"/></para>
  <para style="s1">कैद करून आणलेल्या स्त्रीशी विवाह</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10"/>जेव्हा तुम्ही तुमच्या शत्रूविरुद्ध युद्ध करण्यास जाल आणि याहवेह तुमचे परमेश्वर तुमच्या शत्रूंना तुमच्या स्वाधीन करतील आणि त्यांना तुम्ही बंदिवान कराल, <verse eid="DEU 21:10"/><verse number="11" style="v" sid="DEU 21:11"/>आणि त्या बंदिवानात तुम्हाला जर एखादी देखणी तरुणी आढळली आणि तुम्ही तिच्याकडे आकर्षित झालात तर तिचा तुम्ही तुमची पत्नी म्हणून स्वीकार करावा. <verse eid="DEU 21:11"/><verse number="12" style="v" sid="DEU 21:12"/>तिला तुम्ही तुमच्या घरी न्यावे आणि तिच्या डोक्यावरील केसांचे मुंडण करावे, तिची नखे कापावीत <verse eid="DEU 21:12"/><verse number="13" style="v" sid="DEU 21:13"/>आणि तिने बंदिवासाची सर्व वस्त्रे बाजूला ठेवून द्यावीत आणि नंतर तिने तुमच्या घरी तिच्या आईवडिलांसाठी संपूर्ण महिनाभर शोक करावा. त्यानंतर तुम्ही तिच्याशी संबंध ठेऊ शकता, तुम्ही तिचे पती व ती तुमची पत्नी होईल. <verse eid="DEU 21:13"/><verse number="14" style="v" sid="DEU 21:14"/>जर तुम्हाला ती आवडेनाशी झाली, तर तिला मुक्त करावे व तिला हवे तिथे जाऊ द्यावे, तुम्ही तिला किंमत घेऊन विकू नये, अथवा तिला गुलामासारखे वागवू नये कारण तुम्ही तिची अवहेलना केली आहे.<verse eid="DEU 21:14"/></para>
  <para style="s1">ज्येष्ठ पुत्राचा हक्क</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15"/>एखाद्या मनुष्याला दोन पत्नी असतील व तो एकीवर प्रीती करीत असेल व दुसरीवर करीत नसेल आणि त्या दोघींनाही त्याच्यापासून पुत्र झाले असतील आणि जी त्याला प्रिय नाही तिचा पुत्र ज्येष्ठ असेल, <verse eid="DEU 21:15"/><verse number="16" style="v" sid="DEU 21:16"/>तर जेव्हा तो आपल्या पुत्रांना आपली संपत्ती त्याचे वतन म्हणून वाटून देईल, तेव्हा जो खरा ज्येष्ठपुत्र असून नावडत्या पत्नीचा पुत्र आहे, त्याला डावलून, धाकट्या पुत्राला, जो त्याच्या आवडत्या पत्नीचा आहे, त्याला आपल्या प्रथम पुत्राचा अधिकार देऊ नये. <verse eid="DEU 21:16"/><verse number="17" style="v" sid="DEU 21:17"/>आपल्या परंपरेप्रमाणे त्याने आपल्या सर्वात ज्येष्ठ पुत्राला दुप्पट वाटा द्यावा, कारण तो त्याच्या पौरुषाचे प्रथमफळ आहे. तो जरी नावडत्या पत्नीचा पुत्र असला, तरीही ज्येष्ठ पुत्राचा हक्क त्याचाच आहे.<verse eid="DEU 21:17"/></para>
  <para style="s1">बंडखोर पुत्र</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18"/>जर एखाद्या मनुष्याला हट्टी व बंडखोर पुत्र असेल, जो आपल्या आईवडिलांची आज्ञा पाळत नसेल आणि त्यांनी शिस्त लावण्याचा प्रयत्न केला तरी तो त्यांचे ऐकत नसेल, <verse eid="DEU 21:18"/><verse number="19" style="v" sid="DEU 21:19"/>तर त्याच्या आईवडिलांनी त्याला धरून नगराच्या वेशीवर वडील मंडळीपुढे घेऊन जावे. <verse eid="DEU 21:19"/><verse number="20" style="v" sid="DEU 21:20"/>त्यांनी वडील मंडळीपुढे सांगावे, “हा आमचा पुत्र हट्टी आणि बंडखोर आहे. तो आमच्या आज्ञा पाळत नसून आमचे ऐकत नाही. तो खादाड व मद्यपी आहे.” <verse eid="DEU 21:20"/><verse number="21" style="v" sid="DEU 21:21"/>मग त्या नगरातील सर्व लोकांनी त्याला धोंडमार करून ठार मारावे. अशा रीतीने तुमच्यामधील दोष तुम्ही घालवून टाकावे म्हणजे सर्व इस्राएली लोक हे ऐकतील आणि घाबरतील.<verse eid="DEU 21:21"/></para>
  <para style="s1">निरनिराळे नियम</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22"/>जर एखाद्या मनुष्याने असा काही गंभीर स्वरुपाचा गुन्हा केला ज्याची शिक्षा मृत्युदंड आहे व त्याला मृत्युदंड देण्यात आला आणि त्याला झाडावर टांगण्यात आले असेल, <verse eid="DEU 21:22"/><verse number="23" style="v" sid="DEU 21:23"/>तर त्याचा मृतदेह रात्रभर तिथे ठेवू नये, तर त्याच दिवशी त्याचे दफन करावे; कारण जो कोणी खांबावर टांगलेला असेल, त्याच्यावर परमेश्वराचा शाप असतो. म्हणून याहवेह तुमचे परमेश्वर तुम्हाला जो देश वतन म्हणून देत आहे, तो तुम्ही भ्रष्ट करू नये.<verse eid="DEU 21:23"/></para>
  <chapter eid="DEU 21"/>
  <chapter number="22" style="c" sid="DEU 22"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1"/>आपल्यापैकी एखाद्या इस्राएली मनुष्याचा बैल अथवा मेंढरू दूरवर भटकलेला तुम्ही पाहिला, तर त्याच्याकडे दुर्लक्ष करू नये; त्याला त्याच्या मालकाकडे घेऊन जावे. <verse eid="DEU 22:1"/><verse number="2" style="v" sid="DEU 22:2"/>जर मालक तुमच्याजवळ राहत नसतील किंवा तो कोण आहे हे तुम्हाला ठाऊक नसेल, तर तो तुम्ही तुमच्या घरी न्यावा व त्याचा मालक त्याला शोधीत तिथे येईपर्यंत त्याला ठेवावे. मग त्याच्या मालकाला तो परत करावा. <verse eid="DEU 22:2"/><verse number="3" style="v" sid="DEU 22:3"/>जर तुम्हाला त्यांचे गाढव किंवा झगा किंवा त्यांनी हरवलेले इतर काही सापडले तर असेच करा. त्याकडे दुर्लक्ष करू नका.<verse eid="DEU 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 22:4"/>जर तुमच्या इस्राएली बांधवाचे गाढव किंवा बैल मार्गात घसरून पडलेले दिसले तर त्याच्याकडे दुर्लक्ष करू नये. त्याला आपल्या पायांवर उभे करण्यास त्याच्या मालकाला मदत करावी.<verse eid="DEU 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5"/>कोणत्याही स्त्रीने पुरुषाचा पोशाख घालू नये किंवा कोणत्याही पुरुषाने स्त्रीचा पोशाख घालू नये, कारण याहवेह तुमच्या परमेश्वराच्या दृष्टीने असे करणे घृणित आहे.<verse eid="DEU 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6"/>जर तुम्हाला मार्गाच्या कडेला किंवा झाडावर किंवा जमिनीवर पक्ष्याचे घरटे आढळले आणि त्यात मादी पिलांवर किंवा अंड्यांवर बसलेली असेल, तर त्या मादीला पिलांसोबत धरू नये. <verse eid="DEU 22:6"/><verse number="7" style="v" sid="DEU 22:7"/>तुम्हाला हवी असतील तर तुम्ही तिची पिल्ले घेऊ शकता, त्यांच्या आईस मात्र तुम्ही अवश्य जाऊ द्यावे; म्हणजे तुमचे कल्याण होईल व तुम्हाला दीर्घायुष्य लाभेल.<verse eid="DEU 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8"/>जेव्हा तुम्ही नवीन घर बांधाल तेव्हा धाब्याला कठडा बांधवा, म्हणजे कोणीही धाब्यावरून पडल्यास मनुष्य हत्येचा दोष तुमच्या घरावर येऊ नये.<verse eid="DEU 22:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9"/>तुमच्या द्राक्षमळ्यात तुम्ही दोन प्रकारचे बी पेरू नये; तसे केल्यास, दोन्हीही पिकेच नव्हे तर दोन्ही बीजे देखील दूषित समजल्या जातील.<verse eid="DEU 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 22:10"/>एकाच नांगराला बैल व गाढव यांना एकत्र जुंपून नांगरणी करू नये.<verse eid="DEU 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 22:11"/>लोकर व ताग यांचे मिश्रण असलेली वस्त्रे घालू नका.<verse eid="DEU 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12"/>आपल्या अंगरख्याच्या चारही कोपर्‍यांना गोंडे लावावीत.<verse eid="DEU 22:12"/></para>
  <para style="s1">वैवाहिक नियमांचे उल्लंघन</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13"/>एखाद्या पुरुषाने पत्नी केली आणि तिच्याशी समागम केल्यानंतर ती त्याला आवडेनाशी झाली <verse eid="DEU 22:13"/><verse number="14" style="v" sid="DEU 22:14"/>आणि तिची निंदा केली आणि तिच्या नावाची बदनामी करून म्हटले, “मी या स्त्रीसोबत लग्न केले, पण जेव्हा मी तिच्याजवळ गेलो तेव्हा तिच्यात मला कौमार्याबद्दलचा पुरावा आढळला नाही,” <verse eid="DEU 22:14"/><verse number="15" style="v" sid="DEU 22:15"/>तर मुलीच्या आईवडिलांनी तिच्या कौमार्याबद्दलचा पुरावा, त्या नगराच्या वेशीत वडील मंडळीपुढे साजरा करावा. <verse eid="DEU 22:15"/><verse number="16" style="v" sid="DEU 22:16"/>तिच्या वडिलांनी त्यांना असे सांगावे, “मी माझी कन्या या मनुष्याला त्याची पत्नी व्हावी म्हणून दिली, परंतु आता ती त्याला आवडत नाही. <verse eid="DEU 22:16"/><verse number="17" style="v" sid="DEU 22:17"/>आता त्याने तिची निंदा केली आणि म्हणाला, ‘मला तुमच्या कन्येमध्ये कौमार्याबद्दलचे पुरावे आढळले नाही.’ पण हे पाहा आमच्या कन्येच्या कौमार्याबद्दलचा पुरावा.” मग तिच्या आईवडिलांनी ते वस्त्र नगराच्या वडीलांपुढे सादर करावे, <verse eid="DEU 22:17"/><verse number="18" style="v" sid="DEU 22:18"/>आणि मग नगरातील वडील मंडळीने त्या पुरुषाला घ्यावे आणि त्याला शिक्षा द्यावी. <verse eid="DEU 22:18"/><verse number="19" style="v" sid="DEU 22:19"/>शंभर चांदीची नाणी<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">अंदाजे 1.2 कि. ग्रॅ.</char></note> दंडादाखल त्याच्याकडून वसूल करावी आणि मुलीच्या वडिलांना द्यावीत, कारण त्या तरुणाने एका इस्राएली कुमारिकेची बदनामी केली. ती त्याची पत्नी म्हणून राहील; तो जिवंत असेपर्यंत त्याने तिला कदापि घटस्फोट देऊ नये.<verse eid="DEU 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20"/>परंतु आरोप सत्य असल्यास आणि तिच्या कौमार्याबद्दलचा पुरावा आढळला नाही, <verse eid="DEU 22:20"/><verse number="21" style="v" sid="DEU 22:21"/>तर मात्र नगराच्या वडिलांनी त्या कन्येला तिच्या वडिलांच्या घराच्या दारापर्यंत न्यावे व तिथे नगरातील लोकांनी तिला मरेपर्यंत धोंडमार करावी. आपल्या आईवडिलांच्या घरात राहत असताना, व्यभिचारिणी होऊन तिने इस्राएलात घृणास्पद कृत्य केले आहे. अशा रीतीने तुमच्यामधील दोष काढून टाकण्यात यावे.<verse eid="DEU 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22"/>एखादा पुरुष दुसर्‍या पुरुषाच्या स्त्रीबरोबर व्यभिचार करीत असताना आढळला, तर तिच्यासोबत झोपलेला पुरुष आणि स्त्री दोघांनाही जिवे मारावे. अशा रीतीने इस्राएलमधून कलंक दूर करून शुद्ध करावे.<verse eid="DEU 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23"/>ज्या कुमारिकेचा वाङ्निश्चय झालेला आहे, अशा कुमारिकेला जर एखाद्या नगरात एखाद्या पुरुषाने भ्रष्ट केले, <verse eid="DEU 22:23"/><verse number="24" style="v" sid="DEU 22:24"/>तर त्या दोघांनाही नगराच्या वेशीच्या बाहेर घेऊन जावे आणि मरेपर्यंत धोंडमार करावा—त्या कुमारिकेला अशासाठी की नगरात असताना तिने मदतीसाठी आरडाओरडा केला नाही आणि त्या पुरुषाला अशासाठी की त्याने दुसर्‍या पुरुषाच्या स्त्रीला भ्रष्ट केले. अशा रीतीने तुमच्यामधून कलंक दूर करून शुद्ध करावे.<verse eid="DEU 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25"/>परंतु एखाद्या पुरुषाने वाङ्निश्चय झालेल्या कुमारिकेला बाहेर शेतात गाठून तिच्यावर बलात्कार केला, तर असे करणार्‍या पुरुषाला ठार मारावे. <verse eid="DEU 22:25"/><verse number="26" style="v" sid="DEU 22:26"/>त्या कुमारिकेला काही करू नये; तिला मरणदंड मिळावा असे पाप तिने केले नाही. एखाद्याने आपल्या शेजार्‍यावर हल्ला करून त्याला ठार मारावे त्याप्रमाणे हे आहे, <verse eid="DEU 22:26"/><verse number="27" style="v" sid="DEU 22:27"/>कारण त्या पुरुषाने त्या एकट्या कुमारिकेला शेतात शोधून काढली आणि मदतीसाठी ती ओरडलीच असेल, परंतु ते ऐकण्यासाठी आणि तिची सुटका करण्यासाठी त्या ठिकाणी कोणीही नव्हते.<verse eid="DEU 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28"/>जर एखाद्या पुरुषाने जिचा वाङ्निश्चय झालेला नसेल, अशा कुमरिकेवर बलात्कार केला आणि ते करीत असताना तो आढळला, <verse eid="DEU 22:28"/><verse number="29" style="v" sid="DEU 22:29"/>तर त्याने मुलीच्या वडिलांना पन्नास चांदीची नाणी<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="ft" closed="false">अंदाजे 575 ग्रॅ.</char></note> दंड म्हणून दिली पाहिजेत आणि त्या कुमारिकेशी विवाह केला पाहिजे, कारण त्याने तिला भ्रष्ट केले. तो जिवंत असेपर्यंत तिला घटस्फोट देऊ शकत नाही.<verse eid="DEU 22:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 22:30"/>कोणाही पुरुषाने आपल्या पित्याच्या पत्नीशी विवाह करू नये; त्याने आपल्या पित्याच्या अंथरुणास भ्रष्ट करू नये.<verse eid="DEU 22:30"/></para>
  <chapter eid="DEU 22"/>
  <chapter number="23" style="c" sid="DEU 23"/>
  <para style="s1">सभेतून वगळलेले लोक</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1"/>जो भग्नांड आहे किंवा ज्याच्या लिंगाचा छेद झाला आहे त्याने याहवेहच्या सभेत प्रवेश करू नये.<verse eid="DEU 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2"/>निषिद्ध विवाहबंधनापासून जन्मलेला अथवा त्यांच्या वंशातल्या अगदी दहाव्या पिढीपर्यंत कोणीही याहवेहच्या सभेत प्रवेश करू नये.<verse eid="DEU 23:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 23:3"/>तसेच दहाव्या पिढीनंतर कोणाही अम्मोनी अथवा मोआब्याने याहवेहच्या सभेत कधीही प्रवेश करू नये. <verse eid="DEU 23:3"/><verse number="4" style="v" sid="DEU 23:4"/>कारण जेव्हा तुम्ही इजिप्त देशातून बाहेर आला, तेव्हा हे मार्गात अन्न व पाणी घेऊन तुम्हाला भेटण्यास आले नाहीत, एवढेच नव्हे तर अराम-नहराईम<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मेसोपोटेमिया</char></note> येथील पथोर नगरात राहणारा बौराचा पुत्र बलामास द्रव्य देऊन तुम्हाला शाप देण्यासाठी आणले. <verse eid="DEU 23:4"/><verse number="5" style="v" sid="DEU 23:5"/>तरीही याहवेह तुमच्या परमेश्वराने बलामाचे ऐकले नाही, परंतु त्यांनी त्याच्या शापाचे तुमच्यासाठी आशीर्वादात रूपांतर केले, कारण याहवेह तुमचे परमेश्वर तुम्हावर प्रीती करतात. <verse eid="DEU 23:5"/><verse number="6" style="v" sid="DEU 23:6"/>म्हणून तुम्ही जिवंत असेपर्यंत त्यांच्याशी तहाची मैत्री करण्याचा कधीही प्रयत्न करू नये.<verse eid="DEU 23:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 23:7"/>परंतु एदोमी लोकांना तुच्छ लेखू नका, कारण एदोमी तुमचे भाऊबंद आहेत. इजिप्तच्या लोकांचा तिरस्कार करू नका कारण त्यांच्या देशात तुम्ही परदेशी म्हणून राहिला होता. <verse eid="DEU 23:7"/><verse number="8" style="v" sid="DEU 23:8"/>त्यांच्यात जन्मलेल्या तिसर्‍या पिढीच्या संततीस याहवेहच्या सभेत प्रवेश करण्यास हरकत नाही.<verse eid="DEU 23:8"/></para>
  <para style="s1">छावणीतील अस्वच्छता</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 23:9"/>जेव्हा तुम्ही तुमच्या शत्रूविरुद्ध तळ ठोकाल, तेव्हा सर्व अशुद्ध गोष्टींपासून दूर राहावे. <verse eid="DEU 23:9"/><verse number="10" style="v" sid="DEU 23:10"/>एखादा पुरुष स्वप्नावस्थेमुळे रात्रीतून अशुद्ध झाला असेल, तर त्याने छावणीबाहेर जावे आणि बाहेरच राहावे. <verse eid="DEU 23:10"/><verse number="11" style="v" sid="DEU 23:11"/>पण जशी संध्याकाळ होईल तसे त्याने स्नान करावे व सूर्यास्तानंतर छावणीत परत यावे.<verse eid="DEU 23:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 23:12"/>नैसर्गिक विधी करण्यासाठी लागणारी जागा छावणीच्या बाहेर असावी. <verse eid="DEU 23:12"/><verse number="13" style="v" sid="DEU 23:13"/>तुमच्या हत्यारांमध्ये कुदळ अवश्य असावी आणि बहिर्दिशेच्या वेळी आपल्या मलमूत्रासाठी त्याने खड्डा खोदावा व नंतर झाकून टाकण्यासाठी तिचा वापर करावा. <verse eid="DEU 23:13"/><verse number="14" style="v" sid="DEU 23:14"/>तुमचे रक्षण करण्यासाठी आणि तुमच्यापुढे तुमच्या शत्रूंना तुमच्या हाती देण्यासाठी, याहवेह तुमचे परमेश्वर तुमच्या छावणीमध्ये फिरत असतात. तुमची छावणी पवित्र असली पाहिजे, यासाठी की त्यांच्या दृष्टीस अमंगळता पडल्यास ते तुमच्यापासून दूर निघून जातील.<verse eid="DEU 23:14"/></para>
  <para style="s1">इतर विविध नियम</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 23:15"/>एखादा गुलाम आपल्या धन्यापासून पळून तुमच्याकडे आला असेल, तर तुम्ही त्याला त्याच्या धन्याच्या स्वाधीन करू नका. <verse eid="DEU 23:15"/><verse number="16" style="v" sid="DEU 23:16"/>त्यांना जे गाव आवडेल, त्या गावात तुमच्यामध्ये त्यांना राहू द्यावे. तुम्ही त्यांना छळू नये.<verse eid="DEU 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 23:17"/>इस्राएलातील कन्या वा पुत्रांनी मंदिरातील देवदासी बनू नये. <verse eid="DEU 23:17"/><verse number="18" style="v" sid="DEU 23:18"/>वेश्येच्या कमाईचा अथवा पुमैथुन करणार्‍याच्या मिळकतीचा पैसा याहवेह तुमच्या परमेश्वराच्या मंदिरात नवस फेडण्यासाठी कोणीही आणू नये; कारण हे दान व दान देणारी व्यक्ती या दोन्हीही गोष्टी याहवेह तुमच्या परमेश्वराच्या दृष्टीने ओंगळ होत.<verse eid="DEU 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 23:19"/>तुमच्या इस्राएली बंधूला दिलेल्या कर्जावर व्याज मागू नका, मग ते कर्ज पैशाच्या, अन्नाच्या अथवा दुसर्‍या कशाच्याही रूपाने दिलेले असो, त्याच्यावर व्याज मागू नका. <verse eid="DEU 23:19"/><verse number="20" style="v" sid="DEU 23:20"/>तुम्ही एखाद्या परदेशीकडून व्याज घेऊ शकता, पण कोणाही इस्राएली बांधवाकडून घेऊ नका, म्हणजे याहवेह तुमचे परमेश्वर जेव्हा तुम्हाला वतन म्हणून ज्या देशात आणतील, तेव्हा तुम्ही केलेल्या प्रत्येक कार्याला आशीर्वाद देतील.<verse eid="DEU 23:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 23:21"/>तुम्ही याहवेह तुमच्या परमेश्वराला एखादा नवस करता, तेव्हा तो फेडण्यास विलंब लावू नये, कारण नवसांची फेड तत्परतेने करावी, अशी याहवेह तुमच्या परमेश्वराची अपेक्षा आहे. तसे न केल्याने तुम्ही पापाचे दोषी ठराल. <verse eid="DEU 23:21"/><verse number="22" style="v" sid="DEU 23:22"/>परंतु तुम्ही नवस केला नसेल, तर ते मात्र पाप नाही. <verse eid="DEU 23:22"/><verse number="23" style="v" sid="DEU 23:23"/>तुमच्या ओठांनी तुम्ही जे काही वचन दिले असेल, त्याप्रमाणे तुम्ही अवश्य केले पाहिजे; कारण तो नवस तुम्ही मुखाने, स्वखुशीने याहवेह तुमच्या परमेश्वराला केला होता.<verse eid="DEU 23:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 23:24"/>तुम्ही तुमच्या शेजार्‍याच्या द्राक्षमळ्यात गेलात, तर हवी तितकी द्राक्षे तुम्ही खावी, परंतु टोपलीत घालून तुम्ही काहीही नेऊ नये. <verse eid="DEU 23:24"/><verse number="25" style="v" sid="DEU 23:25"/>आपल्या शेजार्‍याच्या उभ्या पिकात तुम्ही गेलात, तर हवी तेवढी कणसे तुम्ही हाताने मोडून खावी, पण त्याच्या उभ्या पिकास मात्र विळा लावू नये.<verse eid="DEU 23:25"/></para>
  <chapter eid="DEU 23"/>
  <chapter number="24" style="c" sid="DEU 24"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1"/>कोणा पुरुषाने एखाद्या स्त्रीसोबत विवाह केला, परंतु नंतर तो तिच्यासोबत संतुष्ट होत नाही आणि त्याला तिच्यात काही दोष आढळला, तर त्याने सूटपत्र लिहून तिच्या हाती द्यावे आणि तिला आपल्या घरातून घालवून द्यावे, <verse eid="DEU 24:1"/><verse number="2" style="v" sid="DEU 24:2"/>आणि त्याचे घर सोडल्यानंतर ती दुसर्‍या पुरुषाची पत्नी होते, <verse eid="DEU 24:2"/><verse number="3" style="v" sid="DEU 24:3"/>आणि तिच्या दुसर्‍या पतीलाही ती आवडली नाही व त्यानेही तिच्या हाती सूटपत्रे देऊन तिला घालवून दिले किंवा तो मरण पावला, <verse eid="DEU 24:3"/><verse number="4" style="v" sid="DEU 24:4"/>तर तिच्या पहिल्या पतीने तिला पत्नी म्हणून पुन्हा स्वीकारू नये, कारण ती भ्रष्ट झालेली आहे. अशा स्त्रीशी विवाह करणे ही गोष्ट याहवेहच्या दृष्टीने अमंगळ अशी आहे. याहवेह तुमचे परमेश्वर तुम्हाला वतन म्हणून देत असलेल्या देशावर पाप आणू नका.<verse eid="DEU 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5"/>नुकतेच विवाह झालेल्या पुरुषाला सैन्याबरोबर मोहिमेवर पाठवू नये किंवा त्याच्यावर इतर कुठलीही जबाबदारी टाकू नये. त्याला वर्षभर घरी राहण्याची मोकळीक असावी आणि त्याने घरी राहून आपल्या विवाहित पत्नीला आनंदित करावे.<verse eid="DEU 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6"/>तुम्ही एखाद्या मनुष्याला काही उसने देता—तेव्हा जाते किंवा जात्याची तळी गहाण म्हणून ठेवून घेऊ नये—कारण अशी वस्तू गहाण ठेवणे म्हणजे त्या मनुष्याचे जीवितच गहाण ठेवणे होय.<verse eid="DEU 24:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7"/>जर एखाद्याने आपल्याच इस्राएली बांधवाचे अपहरण केले आणि त्याला एखाद्या गुलामाप्रमाणे वागविले किंवा तो विकून टाकताना त्याला धरण्यात आले, तर अपहरण करणार्‍याला अवश्य जिवे मारावे. अशा रीतीने तुमच्यातील दुष्कर्म तुम्ही दूर करावे.<verse eid="DEU 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8"/>कुष्ठरोगाच्या बाबतीत लेवी याजकाने तुम्हाला सांगितल्याप्रमाणे वागण्याची काळजी घ्या. मी त्यांना दिलेल्या आज्ञा तुम्ही काळजीपूर्वक पाळा. <verse eid="DEU 24:8"/><verse number="9" style="v" sid="DEU 24:9"/>इजिप्तमधून येताना याहवेह तुमच्या परमेश्वराने मिर्यामचे काय केले, याची तुम्ही आठवण ठेवावी.<verse eid="DEU 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10"/>जेव्हा तुम्ही आपल्या शेजार्‍याला काही उसने देता, तर तारण घेण्यासाठी तुम्ही त्याच्या घरात शिरू नये, <verse eid="DEU 24:10"/><verse number="11" style="v" sid="DEU 24:11"/>तुम्ही बाहेर उभे राहावे आणि ज्या शेजार्‍याला तुम्ही कर्ज देत आहात त्याने तुम्हाला बाहेर तारण आणून द्यावे. <verse eid="DEU 24:11"/><verse number="12" style="v" sid="DEU 24:12"/>जर शेजारी गरीब असेल, तर तुम्ही त्याने तारण म्हणून दिलेले पांघरूण अंगावर घेऊन झोपू नका. <verse eid="DEU 24:12"/><verse number="13" style="v" sid="DEU 24:13"/>गहाणादाखल त्याने आपले पांघरूण दिले असेल व तर सूर्यास्तसमयी ते त्याला परत करावे म्हणजे ते पांघरूण अंगावर घेऊन तो झोपेल. तो तुमचे आभार मानेल आणि याहवेह तुमच्या परमेश्वराच्या दृष्टीने तुमचे हे कृत्य नीतिमत्व असे ठरेल.<verse eid="DEU 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14"/>गरीब व गरजवंत मजुराचा तुम्ही गैरफायदा घेऊ नये, मग तो तुमचा इस्राएली बांधव असो किंवा तुमच्या गावात राहणारा परदेशी असो. <verse eid="DEU 24:14"/><verse number="15" style="v" sid="DEU 24:15"/>त्यांना दररोज सूर्य मावळण्यापूर्वीच त्यांची मजुरी द्यावी, कारण ते गरीब आहेत आणि ते त्या मजुरीवर अवलंबून आहेत. नाहीतर ते तुमच्याविरुद्ध याहवेहकडे गार्‍हाणे करतील व मग ते तुमच्याविरुद्ध पाप असे मोजण्यात येईल.<verse eid="DEU 24:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16"/>आईवडिलांना त्यांच्या मुलांच्या कारणामुळे जिवे मारू नये, तसेच आईवडिलांच्या कारणामुळे त्यांच्या मुलांना जिवे मारू नये. प्रत्येकजण स्वतःच्या पापासाठी मरतील.<verse eid="DEU 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17"/>परदेशी आणि अनाथांना यथायोग्य न्याय दिला पाहिजे, किंवा विधवेची वस्त्रे गहाण म्हणून कधीही घेतली जाऊ नये. <verse eid="DEU 24:17"/><verse number="18" style="v" sid="DEU 24:18"/>तुम्ही इजिप्त देशात गुलाम होता आणि याहवेह तुमच्या परमेश्वराने त्यातून तुमची सुटका केली, याची तुम्ही सतत आठवण ठेवावी. म्हणूनच मी तुम्हाला हे करण्याची आज्ञा देत आहे.<verse eid="DEU 24:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19"/>पिकांची कापणी करीत असताना तुम्ही बांधून ठेवलेली एखादी पेंढी शेतातून आणावयाचे विसरलात, तर ती आणण्यासाठी तुम्ही माघारी जाऊ नये, तर परदेशी, अनाथ व विधवा यांच्यासाठी ती तिथेच राहू द्यावी, म्हणजे याहवेह तुमचे परमेश्वर तुमच्या हाताच्या सर्व कार्यात आशीर्वाद देतील. <verse eid="DEU 24:19"/><verse number="20" style="v" sid="DEU 24:20"/>तुम्ही तुमच्या जैतून वृक्षांवरील फळे काढण्याकरिता झोडपणी कराल, तेव्हा तुम्ही एकाच फांदीवर दोनदा प्रहार करू नये. त्या फांदीवर जी काही फळे राहतील ती परदेशी, अनाथ व विधवा यांच्यासाठी राहू द्यावी. <verse eid="DEU 24:20"/><verse number="21" style="v" sid="DEU 24:21"/>जेव्हा तुम्ही तुमच्या द्राक्षमळ्यातील द्राक्षे काढता तेव्हा परत वेलींवर जाऊ नका. तर राहिलेली द्राक्षे परदेशी, अनाथ व विधवा यांच्यासाठी तशीच राहू द्यावीत. <verse eid="DEU 24:21"/><verse number="22" style="v" sid="DEU 24:22"/>इजिप्त देशामध्ये तुम्ही गुलाम होता याची आठवण ठेवावी म्हणून मी तुम्हाला हे करण्याची आज्ञा देत आहे.<verse eid="DEU 24:22"/></para>
  <chapter eid="DEU 24"/>
  <chapter number="25" style="c" sid="DEU 25"/>
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1"/>लोकांमध्ये वाद उपस्थिती झाला आणि न्याय मागण्यासाठी त्यांनी न्यायालयात जावे व न्यायाधीशाने त्यांचा निवाडा करावा. जो निर्दोष असेल त्याला निर्दोषी ठरवावे व जो दोषी असेल त्याला दोषी ठरवावे. <verse eid="DEU 25:1"/><verse number="2" style="v" sid="DEU 25:2"/>दोषी मनुष्य जर फटक्यांच्या शिक्षेस पात्र ठरला, तर न्यायाधीशाने त्याला पालथे पाडावे आणि आपल्यादेखत त्याच्या अपराधाप्रमाणे मोजून फटके मारावेत, <verse eid="DEU 25:2"/><verse number="3" style="v" sid="DEU 25:3"/>परंतु न्यायाधीशाने त्याला चाळीस पर्यंतच फटके मारावेत, अधिक फटके मारू नयेत. नाहीतर, अधिक फटके मारल्यास, तुमच्या बंधूंची तुमच्यादेखत अप्रतिष्ठा होईल.<verse eid="DEU 25:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4"/>बैल धान्याची मळणी करीत असताना त्याला मुसके बांधू नको.<verse eid="DEU 25:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5"/>भाऊ एकत्र राहत असतील व त्यातील एकजण निपुत्र मरण पावला, तर त्याच्या विधवेने कुटुंबाबाहेर परक्याशी विवाह करू नये. तिच्या पतीच्या भावाने तिच्याशी विवाह करावा आणि तिचा स्वीकार करावा आणि तिच्याप्रती दिराचे कर्तव्य पूर्ण करावे. <verse eid="DEU 25:5"/><verse number="6" style="v" sid="DEU 25:6"/>तिला जन्मलेल्या पहिल्या पुत्राला मृत भावाचे नाव द्यावे, जेणेकरून त्याचे नाव इस्राएलमधून पुसले जाणार नाही.<verse eid="DEU 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7"/>परंतु याबाबतीत मृत माणसाच्या भावाने त्याच्या मृत भावाच्या विधवेशी विवाह करण्यास नकार दिला, तर तिने त्या नगराच्या वेशीवर वडीलजनांकडे जाऊन त्यांना म्हणावे, “माझ्या पतीचा भाऊ आपल्या भावाचे नाव इस्राएलात पुढे चालविण्यास तयार नाही. माझ्याप्रति तो आपले दिराचे कर्तव्य पार पाडणार नाही.” <verse eid="DEU 25:7"/><verse number="8" style="v" sid="DEU 25:8"/>तेव्हा त्याच्या नगरातील वडीलजनांनी त्याला बोलावून घ्यावे आणि त्याच्याशी बोलणी करावी. “मला त्या बाईशी लग्न करावयाचे नाही,” असे जर तो हट्टीपणाने म्हणाला. <verse eid="DEU 25:8"/><verse number="9" style="v" sid="DEU 25:9"/>तर त्या विधवेने सर्व वडीलजनासमोर त्याच्याकडे जावे, त्याच्या पायातील पायतण काढून घ्यावे आणि त्याच्या तोंडावर थुंकून म्हणावे, “जो मनुष्य आपल्या भावाचे घर चालविण्यास नकार देतो, त्याची अशीच गत होते.” <verse eid="DEU 25:9"/><verse number="10" style="v" sid="DEU 25:10"/>त्याच्या घराण्याचा उल्लेख इस्राएलातील पायतण काढलेल्या पुरुषाचे घराणे असा केला जाईल.<verse eid="DEU 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11"/>समजा दोन पुरुष एकमेकात मारामारी करीत असताना त्या दोघांपैकी एकाची पत्नी आपल्या पतीला मदत करण्यासाठी येते आणि दुसर्‍या मनुष्याचे वृषण पकडते, <verse eid="DEU 25:11"/><verse number="12" style="v" sid="DEU 25:12"/>तर काहीही दयामाया न दाखविता तुम्ही तिचा हात कापून टाकावा.<verse eid="DEU 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13"/>तुमच्या झोळीत तुम्ही वेगवेगळी वजने ठेऊ नये—एक जड व एक हलके. <verse eid="DEU 25:13"/><verse number="14" style="v" sid="DEU 25:14"/>तुमच्या घरात दोन वेगवेगळी मापे वापरू नये—एक मोठे व एक लहान. <verse eid="DEU 25:14"/><verse number="15" style="v" sid="DEU 25:15"/>तुम्ही तुमच्याजवळ तंतोतंत आणि प्रामाणिक वजने आणि मापे बाळगावी, म्हणजे याहवेह तुमचे परमेश्वर जो देश तुम्हाला देणार आहे, त्या देशात तुम्हाला दीर्घायुष्य लाभेल. <verse eid="DEU 25:15"/><verse number="16" style="v" sid="DEU 25:16"/>कारण याहवेह तुमचे परमेश्वर या गोष्टी अप्रामाणिकपणे करणार्‍यांचा तिरस्कार करतात.<verse eid="DEU 25:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17"/>तुम्ही इजिप्त देशातून बाहेर आल्यानंतर अमालेक लोक तुमच्याशी कसे वागले, हे स्मरण ठेवा. <verse eid="DEU 25:17"/><verse number="18" style="v" sid="DEU 25:18"/>जेव्हा तुम्ही दुर्बल व थकलेले होता, तेव्हा त्यांनी तुम्हाला मार्गात गाठले आणि मागे राहिलेल्यांवर हल्ला केला; त्यांना परमेश्वराचे भय नव्हते. <verse eid="DEU 25:18"/><verse number="19" style="v" sid="DEU 25:19"/>जेव्हा वतन म्हणून देणार्‍या देशातील तुमच्या सर्व शत्रूपासून याहवेह तुमचे परमेश्वर तुम्हाला विश्रांती देतील, तेव्हा तुम्ही या अमालेक लोकांचे नाव पृथ्वीवरून पूर्णपणे नामशेष केले पाहिजे. हे तुम्ही कधीही विसरू नये!<verse eid="DEU 25:19"/></para>
  <chapter eid="DEU 25"/>
  <chapter number="26" style="c" sid="DEU 26"/>
  <para style="s1">प्रथम फळे आणि दशांश</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1"/>जेव्हा तुम्ही याहवेह तुमचे परमेश्वराने वतन दिलेल्या देशात प्रवेश कराल, तो जिंकून त्याचा ताबा घ्याल आणि तिथे वस्ती कराल, <verse eid="DEU 26:1"/><verse number="2" style="v" sid="DEU 26:2"/>तेव्हा याहवेह तुमच्या परमेश्वराने दिलेल्या भूमीतील प्रत्येक पिकाचे प्रथम उत्पन्न एका टोपलीत आणावे. नंतर याहवेह तुमचे परमेश्वर आपल्या नावासाठी जे वसतिस्थान निवडून देतील त्या ठिकाणी तुम्ही जावे <verse eid="DEU 26:2"/><verse number="3" style="v" sid="DEU 26:3"/>आणि त्यावेळी सेवा करीत असलेल्या याजकास म्हणा, “याहवेह तुमच्या परमेश्वराला आज मी जाहीर करतो, की आमच्या पूर्वजांना वचन देऊ केलेल्या देशात मी आलो आहे.” <verse eid="DEU 26:3"/><verse number="4" style="v" sid="DEU 26:4"/>मग याजक ती टोपली तुमच्या हातून घेऊन याहवेह तुमच्या परमेश्वराच्या वेदीपुढे ठेवेल. <verse eid="DEU 26:4"/><verse number="5" style="v" sid="DEU 26:5"/>नंतर तुम्ही याहवेह तुमच्या परमेश्वरासमोर म्हणावेः “आमचे पूर्वज अरामी, हे निर्वासित होऊन आश्रयासाठी इजिप्त देशास गेले. ते संख्येने अगदी थोडे होते, पण इजिप्त देशात ते एक विशाल, बलाढ्य आणि थोर राष्ट्र बनले. <verse eid="DEU 26:5"/><verse number="6" style="v" sid="DEU 26:6"/>इजिप्त देशातील लोकांनी आम्हाला वाईट रीतीने वागविले, आमच्यावर जुलूम केला व कठोर परिश्रम लादले <verse eid="DEU 26:6"/><verse number="7" style="v" sid="DEU 26:7"/>तेव्हा आम्ही याहवेहचा, आमच्या पूर्वजांच्या परमेश्वराचा धावा केला आणि याहवेहने आमचे गार्‍हाणे ऐकले, आमच्या अडचणी जाणल्या आणि आमच्यावर होत असलेला जुलूम व अत्याचार त्यांनी पाहिला. <verse eid="DEU 26:7"/><verse number="8" style="v" sid="DEU 26:8"/>मग याहवेहने महान चमत्कारांनी, सामर्थ्यशाली बाहुबलाने व पसरलेल्या हातांनी आणि भयावह चिन्ह व चमत्कार करून आम्हाला इजिप्त देशातून बाहेर आणले. <verse eid="DEU 26:8"/><verse number="9" style="v" sid="DEU 26:9"/>त्यांनी आम्हाला या ठिकाणी आणले आणि दुधामधाचे प्रवाह वाहत असलेला हा देश आम्हाला दिला; <verse eid="DEU 26:9"/><verse number="10" style="v" sid="DEU 26:10"/>आता, हे याहवेह परमेश्वरा, तुम्ही जी भूमी आम्हाला दिली आहे, त्यात उगविलेल्या धान्याचे प्रथम उत्पन्न आम्ही आणले आहे.” नंतर ते अर्पण तुम्ही याहवेह तुमच्या परमेश्वरापुढे ठेवावे व त्यांची उपासना करावी. <verse eid="DEU 26:10"/><verse number="11" style="v" sid="DEU 26:11"/>त्यानंतर याहवेह तुमच्या परमेश्वराने ज्या सर्व चांगल्या गोष्टी तुम्हाला दिल्या, त्याबद्दल तुम्ही, लेवी व परदेशी लोक या सर्वांनी मिळून आनंदोत्सव साजरा करावा.<verse eid="DEU 26:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12"/>तुम्ही तुमच्या सर्व उत्पन्नाचा दशांश तिसर्‍या वर्षी, म्हणजे दशांशाच्या वर्षी लेवी वंशजांना, परदेशी लोकांना, अनाथांना आणि विधवांना द्यावा, म्हणजे तुमच्या नगरात ते खाऊन तृप्त होतील. <verse eid="DEU 26:12"/><verse number="13" style="v" sid="DEU 26:13"/>मग तुम्ही याहवेह तुमच्या परमेश्वरासमोर सांगावे, “मी माझ्या घरातून पवित्र हिस्सा काढला आहे. लेवी वंशजांना, परदेशीयांना, अनाथांना आणि विधवांना तुमच्या आज्ञेप्रमाणे दिला आहे. मी कोणतीही आज्ञा मोडली नाही किंवा तुमचा कोणताही नियम विसरलो नाही. <verse eid="DEU 26:13"/><verse number="14" style="v" sid="DEU 26:14"/>मी विलाप करीत असताना त्या पवित्र वाट्यातील काहीही खाल्ले नाही, धार्मिक संस्कारांच्या दृष्टीने अशुद्ध असताना ते घराच्या बाहेर नेले नाही किंवा एखाद्या मृत व्यक्तीला अर्पण केले नाही. हे माझ्या याहवेह परमेश्वरा, मी तुमचे आज्ञापालन केले आहे. तुम्ही सांगितलेले सर्वकाही मी केले आहे. <verse eid="DEU 26:14"/><verse number="15" style="v" sid="DEU 26:15"/>म्हणून हे परमेश्वरा, स्वर्गातील तुमच्या पवित्र निवासस्थानातून तुम्ही खाली पाहा आणि आमच्या पूर्वजांना वचन दिल्याप्रमाणे जो दुधामधाचे प्रवाह वाहणारा असा देश तुम्ही आम्हाला दिला आहे त्याला व आम्हा इस्राएली लोकांना आशीर्वादित करा.”<verse eid="DEU 26:15"/></para>
  <para style="s1">याहवेहच्या नियमाचे पालन</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16"/>आज याहवेह तुमचे परमेश्वर तुम्हाला ज्या आज्ञा आणि विधी देत आहेत, त्या आज्ञा व विधी यांचे तुम्ही पूर्ण मनाने व पूर्ण जिवाने पालन करावे; <verse eid="DEU 26:16"/><verse number="17" style="v" sid="DEU 26:17"/>कारण ते याहवेह तुमचे परमेश्वर आहेत, असे तुम्ही आज जाहीरपणे मान्य केले आहे; त्यांचे नियम आणि विधी पाळण्याचे आणि ते जे काही सांगतील ते करण्याचे तुम्ही वचन दिले आहे. <verse eid="DEU 26:17"/><verse number="18" style="v" sid="DEU 26:18"/>आणि याहवेहनेही वचन दिल्याप्रमाणे स्वतःचे लोक व त्यांचा मोलवान ठेवा म्हणून त्यांनी आज तुमचा स्वीकार केला आहे व तुम्ही त्यांच्या सर्व आज्ञा अवश्य पाळाव्या. <verse eid="DEU 26:18"/><verse number="19" style="v" sid="DEU 26:19"/>ते तुम्हाला इतर कोणत्याही राष्ट्रापेक्षा थोर करतील आणि तुम्हाला प्रशंसा, किर्ती व सन्मान प्राप्त होतील आणि त्यांनी वचन दिल्यानुसार तुम्ही याहवेह तुमच्या परमेश्वराचे पवित्र लोक व्हाल.<verse eid="DEU 26:19"/></para>
  <chapter eid="DEU 26"/>
  <chapter number="27" style="c" sid="DEU 27"/>
  <para style="s1">एबाल डोंगरावरील वेदी</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1"/>नंतर मोशे व इस्राएलांच्या वडीलजनांनी लोकांना आज्ञापिले: “ज्या आज्ञा आज मी तुम्हाला सांगत आहे त्या तुम्ही पाळाव्या. <verse eid="DEU 27:1"/><verse number="2" style="v" sid="DEU 27:2"/>जेव्हा तुम्ही यार्देन नदी पार करून याहवेह तुमच्या परमेश्वराने दिलेल्या वचनदत्त देशात जाल, तेव्हा काही मोठे धोंडे घेऊन त्यावर चुन्याचा लेप लावून स्थापित करावे. <verse eid="DEU 27:2"/><verse number="3" style="v" sid="DEU 27:3"/>त्यावर या नियमशास्त्राचे सर्व शब्द लिहून काढावे जेव्हा तुम्ही यार्देन नदी पार करून याहवेह तुमचे परमेश्वर देत असलेल्या वचनदत्त देशात जाल म्हणजे दुधामधाचे प्रवाह वाहणार्‍या अशा देशात जाल, जसे याहवेह तुमच्या पूर्वजांच्या परमेश्वराने तुम्हाला वचन दिले होते. <verse eid="DEU 27:3"/><verse number="4" style="v" sid="DEU 27:4"/>आणि जेव्हा तुम्ही यार्देन नदी पार करून याहवेह तुमच्या परमेश्वराने दिलेल्या वचनदत्त देशात जाल, तेव्हा हे धोंडे एबाल डोंगरावर स्थापित करावे, जसे मी आज तुम्हाला आज्ञा करीत आहे आणि त्यावर चुन्याचा लेप लावावा. <verse eid="DEU 27:4"/><verse number="5" style="v" sid="DEU 27:5"/>याहवेह तुमच्या परमेश्वरासाठी तुम्ही तिथे एक वेदी बांधावी, धोंड्यांची वेदी बांधावी. त्यावर कोणतेही लोखंडी अवजार वापरू नये. <verse eid="DEU 27:5"/><verse number="6" style="v" sid="DEU 27:6"/>याहवेह तुमच्या परमेश्वरासाठी तुम्ही तिथे न घडविलेल्या धोंड्यांची एक वेदी बांधावी आणि मग त्या वेदीवर याहवेह तुमच्या परमेश्वराला होमार्पणे अर्पावी. <verse eid="DEU 27:6"/><verse number="7" style="v" sid="DEU 27:7"/>तसेच शांत्यर्पणही त्याच वेदीवर करून याहवेह तुमच्या परमेश्वरासमोर मोठ्या आनंदाने भोजन करावे. <verse eid="DEU 27:7"/><verse number="8" style="v" sid="DEU 27:8"/>या धोंड्यावर नियमशास्त्राचा प्रत्येक शब्द स्पष्टपणे लिहून काढावा.”<verse eid="DEU 27:8"/></para>
  <para style="s1">एबाल डोंगरावरून शापवचने</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9"/>नंतर मोशे व लेवीय याजकांनी सर्व इस्राएली लोकांना म्हटले, “अहो इस्राएली लोकांनो, शांत व्हा व ऐका! आता तुम्ही याहवेह तुमच्या परमेश्वराचे लोक झाला आहात. <verse eid="DEU 27:9"/><verse number="10" style="v" sid="DEU 27:10"/>याहवेह तुमच्या परमेश्वराच्या आज्ञेचे पालन करा आणि त्यांच्या ज्या आज्ञा आणि विधी आज मी तुम्हाला देत आहे, ते सर्व तुम्ही पाळावे.”<verse eid="DEU 27:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11"/>त्याच दिवशी मोशेने लोकांना आज्ञापिले:<verse eid="DEU 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 27:12"/>तुम्ही यार्देन नदी पार करून जाल, तेव्हा शिमओन, लेवी, यहूदाह, इस्साखार, योसेफ व बिन्यामीनच्या गोत्रांनी लोकांना आशीर्वाद देण्यासाठी गरिज्जीम पर्वतावर उभे राहावे. <verse eid="DEU 27:12"/><verse number="13" style="v" sid="DEU 27:13"/>आणि रऊबेन, गाद, आशेर, जबुलून, दान आणि नफताली यांच्या गोत्रांनी शापवचने उच्चारण्यासाठी एबाल डोंगरावर उभे राहावे.<verse eid="DEU 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 27:14"/>तेव्हा लेव्यांनी सर्व इस्राएली लोकांना पुढीलप्रमाणे मोठ्याने म्हणावे:<verse eid="DEU 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 27:15"/>“जो याहवेहला घृणास्पद अशी मूर्ती कुशल कारागिरांच्या हातांनी घडवितो आणि ती गुप्तपणे ठेवतो तो शापित आहे.”</para>
  <para style="pr" vid="DEU 27:15">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 27:16"/>“जो कोणी आपल्या पित्याचा अथवा मातेचा अनादर करतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:16">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 27:17"/>“जो कोणी आपल्या शेजार्‍याच्या सीमेची धोंड बदलतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:17">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 27:18"/>“जो कोणी आंधळ्याची वाट चुकवितो तो शापित होय!”</para>
  <para style="pr" vid="DEU 27:18">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 27:19"/>“जो कोणी परदेशी, अनाथ आणि विधवा यांचा न्याय विपरीत करतो तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:19">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 27:20"/>“जो कोणी आपल्या पित्याच्या पत्नीबरोबर समागम करतो, तो शापित होय, कारण त्याने त्याच्या पित्याचे अंथरूण अपमानित केले आहे.”</para>
  <para style="pr" vid="DEU 27:20">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 27:21"/>“जो कोणी एखाद्या पशूबरोबर समागम करतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:21">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 27:22"/>“जो कोणी आपल्या बहिणीबरोबर, त्याच्या पित्याच्या कन्येबरोबर किंवा आपल्या मातेच्या कन्येबरोबर समागम करतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:22">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 27:23"/>“जो कोणी आपल्या सासूबरोबर समागम करतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:23">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 27:24"/>“जो कोणी आपल्या शेजार्‍याला गुप्तपणे ठार मारतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:24">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 27:25"/>“जो कोणी एखाद्या निरपराधी मनुष्याला जिवे मारण्यासाठी लाच घेतो, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:25">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 27:26"/>“जो कोणी या नियमशास्त्राचे शब्द अमान्य करून ते आचरणात आणत नाही, तो शापित होय.”</para>
  <para style="pr" vid="DEU 27:26">तेव्हा सर्व लोकांनी “आमेन!” म्हणावे.<verse eid="DEU 27:26"/></para>
  <chapter eid="DEU 27"/>
  <chapter number="28" style="c" sid="DEU 28"/>
  <para style="s1">आज्ञापालनापासून मिळणारे आशीर्वाद</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1"/>याहवेह तुमच्या परमेश्वराच्या ज्या सर्व आज्ञा आज मी तुम्हाला देत आहे, त्या सर्व तुम्ही पाळल्या, तर याहवेह तुमचे परमेश्वर तुम्हाला पृथ्वीवरील सर्व राष्ट्रांपेक्षा श्रेष्ठ असे राष्ट्र करतील. <verse eid="DEU 28:1"/><verse number="2" style="v" sid="DEU 28:2"/>जर तुम्ही याहवेह तुमच्या परमेश्वराच्या आज्ञा पाळाल तर हे सर्व आशीर्वाद तुम्हावर येतील व तुमच्यासह असतील:<verse eid="DEU 28:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="DEU 28:3"/>तुम्ही नगरात आणि शेतात आशीर्वादित व्हाल.<verse eid="DEU 28:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="DEU 28:4"/>तुमची संतती, तुमच्या भूमीतील पिके आणि तुमच्या गुरांचे वत्स, तुमच्या कळपातील वासरे व कोकरे आशीर्वादित होतील.<verse eid="DEU 28:4"/></para>
  <para style="pm">
    <verse number="5" style="v" sid="DEU 28:5"/>तुमच्या टोपल्या व तुमची पीठ मळण्याची परात आशीर्वादित होतील.<verse eid="DEU 28:5"/></para>
  <para style="pm">
    <verse number="6" style="v" sid="DEU 28:6"/>तुम्ही बाहेर जाल तेव्हा व तुम्ही आत याल तेव्हा आशीर्वादित व्हाल.<verse eid="DEU 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 28:7"/>तुमचे शत्रू जेव्हा तुम्हावर हल्ला करतील, तेव्हा याहवेह त्यांचा तुमच्यासमोर पराजय करतील. ते एका दिशेकडून तुमच्यावर चालून येतील, परंतु सात दिशांना पळून जातील.<verse eid="DEU 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 28:8"/>याहवेह तुमच्या धान्याची कोठारे आणि जे काही तुम्ही हाती घ्याल त्यास आशीर्वादित करतील, याहवेह तुमचे परमेश्वर देत असलेल्या देशात तुम्ही जाल तिथे ते तुमची भरभराट करतील.<verse eid="DEU 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 28:9"/>तुम्ही याहवेह तुमच्या परमेश्वराच्या आज्ञा पाळल्या व त्यांच्या मार्गात चालला तर ते तुम्हाला त्यांच्या शपथेनुसार, त्यांचे पवित्र लोक म्हणून प्रतिष्ठित करतील. <verse eid="DEU 28:9"/><verse number="10" style="v" sid="DEU 28:10"/>मग पृथ्वीवरील सर्व लोक पाहतील की तुम्हाला याहवेहच्या नावाने संबोधित करण्यात येते, ती तुम्हाला भिऊ लागतील. <verse eid="DEU 28:10"/><verse number="11" style="v" sid="DEU 28:11"/>याहवेह तुम्हाला अत्यंत संपन्न करतील—तुमची संतती, तुमच्या गुरांची पिल्ले आणि तुमच्या भूमीतील उपज—जसे त्यांनी तुमच्या पूर्वजांना वचन दिले होते.<verse eid="DEU 28:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 28:12"/>प्रत्येक ॠतूत उत्तम पिके मिळावीत यासाठी याहवेह त्यांच्या आकाशातील अद्भुत असे पावसाचे भांडार तुम्हासाठी उघडतील व तुम्ही हाती घ्याल ती प्रत्येक गोष्ट ते आशीर्वादित करतील. अनेक राष्ट्रांना तुम्ही उसने द्याल, पण तुम्हाला उसने कधीही घ्यावे लागणार नाही. <verse eid="DEU 28:12"/><verse number="13" style="v" sid="DEU 28:13"/>याहवेह तुम्हाला मस्तक करतील, शेपूट नव्हे. मी तुम्हाला आज देत असलेल्या याहवेह तुमच्या परमेश्वराच्या सर्व आज्ञा जर तुम्ही प्रामाणिकपणे पाळल्या, तर तुम्ही सतत उच्चस्थानी राहाल व कधीही खाली राहणार नाही. <verse eid="DEU 28:13"/><verse number="14" style="v" sid="DEU 28:14"/>आज मी देत असलेल्या आज्ञांपासून तुम्ही परावृत्त होऊ नका, उजवीकडे किंवा डावीकडे वळू नका, इतर दैवतांचे अनुसरण करू नका आणि त्यांची उपासनाही करू नका.<verse eid="DEU 28:14"/></para>
  <para style="s1">आज्ञाभंगामुळे शाप</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15"/>परंतु याहवेह तुमच्या परमेश्वराचे तुम्ही ऐकले नाही व त्यांच्या सर्व आज्ञा व विधी ज्या मी तुम्हाला आज देत आहे त्यांचे तुम्ही काळजीपूर्वक पालन केले नाही, तर हे सर्व शाप तुम्हावर येतील आणि तुम्हाला येऊन गाठतील:<verse eid="DEU 28:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="DEU 28:16"/>तुम्ही नगरात शापित व्हाल व शेतात शापित व्हाल.<verse eid="DEU 28:16"/></para>
  <para style="pm">
    <verse number="17" style="v" sid="DEU 28:17"/>तुमच्या टोपल्या व तुमचे पीठ मळण्याचे परात शापित होईल.<verse eid="DEU 28:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="DEU 28:18"/>तुमच्या पोटचे फळ आणि तुमच्या भूमीतील पिके आणि तुमच्या गुरांचे वत्स आणि तुमच्या कळपातील वासरे शापित होतील.<verse eid="DEU 28:18"/></para>
  <para style="pm">
    <verse number="19" style="v" sid="DEU 28:19"/>तुम्ही आत याल तेव्हा शापित व्हाल आणि तुम्ही बाहेर जाल तेव्हा शापित व्हाल.<verse eid="DEU 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20"/>जर तुम्ही याहवेहचा त्याग करून दुष्कर्मे करीत राहिलात तर तुम्ही ज्या कार्यात हात घालाल त्या प्रत्येक गोष्टीत याहवेह शाप, गोंधळ आणि संकटे आणतील व सरतेशेवटी तुमचा अचानक आणि संपूर्णपणे नाश करतील. <verse eid="DEU 28:20"/><verse number="21" style="v" sid="DEU 28:21"/>जो देश तुम्ही प्रवेश करून ताब्यात घेणार आहात, त्या देशातून तुम्ही समूळ नष्ट होईपर्यंत, याहवेह तुम्हावर मरी पाठवतील. <verse eid="DEU 28:21"/><verse number="22" style="v" sid="DEU 28:22"/>याहवेह तुम्हावर क्षयरोग, ज्वर, दाह, साथीचे रोग व अवर्षण, तांबेरा व बुरशी पाठवतील, तुमचा संपूर्ण नाश होईपर्यंत या पीडा तुमचा पिच्छा पुरवतील. <verse eid="DEU 28:22"/><verse number="23" style="v" sid="DEU 28:23"/>तुमच्या डोक्यावरील आकाश कास्यासारखे होऊन तुमच्या पावला खालील भूमी लोखंडासारखी होईल. <verse eid="DEU 28:23"/><verse number="24" style="v" sid="DEU 28:24"/>पावसाच्या ऐवजी याहवेह तुमच्यावर, तुमचा नाश होईपर्यंत, धुळीच्या व वाळूच्या वादळांचा आकाशातून वर्षाव करतील.<verse eid="DEU 28:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 28:25"/>तुमच्या शत्रूंपुढे तुमचा पराभव व्हावा, असे याहवेह करतील. तुम्ही त्यांच्यावर एका दिशेने चाल करून जाल, पण सात दिशांनी गोंधळून पळ काढाल आणि पृथ्वीवरील सर्व राष्ट्रांकरिता तुम्ही भयानक विनाशाचे उदाहरण व्हाल. <verse eid="DEU 28:25"/><verse number="26" style="v" sid="DEU 28:26"/>तुमची प्रेते पक्ष्यांचे आणि वन्यपशूंचे भक्ष्य होतील आणि त्यांना दूर हाकलून देण्यास तिथे कोणीही नसेल. <verse eid="DEU 28:26"/><verse number="27" style="v" sid="DEU 28:27"/>याहवेह तुम्हावर इजिप्त देशातील गळवे, मूळव्याध, खवडे व खरूजाच्या अशा पीडा आणतील की ज्यातून तुम्ही कधीच बरे होणार नाही. <verse eid="DEU 28:27"/><verse number="28" style="v" sid="DEU 28:28"/>याहवेह तुम्हाला वेडे व आंधळे करतील आणि तुमची मने गोंधळून जातील. <verse eid="DEU 28:28"/><verse number="29" style="v" sid="DEU 28:29"/>ज्याप्रमाणे एखादा आंधळा मनुष्य चाचपडतो तसे, तुम्ही प्रखर सूर्यप्रकाशात चाचपडाल. जे काही तुम्ही हाती घ्याल, त्यात तुम्हाला यश मिळणार नाही; तुमच्यावर सतत जुलूम होत राहील आणि तुम्ही सतत लुबाडले जाल, यातून कोणीही तुम्हाला सोडविणारा राहणार नाही.<verse eid="DEU 28:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30"/>तुमच्या वाग्दत्त वधूला दुसराच कोणी नेईल व तिचे शीलभंग करेल. तुम्ही घर बांधाल, पण त्यामध्ये तुम्ही राहणार नाही. तुम्ही द्राक्षमळा लावाल, पण त्या फळांचा उपभोग तुम्ही करू शकणार नाही. <verse eid="DEU 28:30"/><verse number="31" style="v" sid="DEU 28:31"/>तुमच्या डोळ्यादेखतच तुमच्या बैलांची कत्तल करण्यात येईल, पण त्यांचे मांस तुम्हाला खायला मिळणार नाही. तुमच्यासमक्ष तुमची गाढवे जबरदस्तीने हाकलून नेण्यात येतील, पण ती तुम्हाला परत देणार नाहीत. तुमची मेंढरे तुमच्या शत्रूंना देण्यात येतील आणि त्यांना कोणीही सोडविणार नाही. <verse eid="DEU 28:31"/><verse number="32" style="v" sid="DEU 28:32"/>तुमच्या पुत्र व कन्यांना दुसर्‍या देशात देण्यात येईल आणि तुमचे डोळे त्यांना पाहण्याच्या उत्कट इच्छेने क्षीण होतील आणि तुम्ही तुमचे हातही वर उचलण्यास असमर्थ व्हाल. <verse eid="DEU 28:32"/><verse number="33" style="v" sid="DEU 28:33"/>तुम्ही कष्ट करून वाढविलेली पिके एखादे परकीय राष्ट्र, ज्याचे नावही तुम्ही कधी ऐकले नाही, ते खातील. तुमची नेहमीच छळवणूक होईल व तुम्ही नेहमीच चिरडले जाल. <verse eid="DEU 28:33"/><verse number="34" style="v" sid="DEU 28:34"/>तुमच्यासमोर जे येईल ते पाहून तुम्हाला वेड लागेल. <verse eid="DEU 28:34"/><verse number="35" style="v" sid="DEU 28:35"/>याहवेह तुमच्या गुडघ्या व पायावर कधीही बरी होणार नाही अशी वेदना देणारी फोडी येऊ देतील, जे अगदी तुमच्या डोक्यापासून पायाच्या तळव्यापर्यंत भरून जातील.<verse eid="DEU 28:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="DEU 28:36"/>तुम्हाला किंवा तुमच्या पूर्वजांना कधीही माहीत नसलेल्या राष्ट्रांमध्ये याहवेह तुम्हाला आणि तुम्ही स्वतःवर नेमलेल्या राजाला हद्दपार करतील. तिथे तुम्ही इतर दैवतांची उपासना कराल, जे लाकडाचे आणि दगडाचे दैवत असेल. <verse eid="DEU 28:36"/><verse number="37" style="v" sid="DEU 28:37"/>याहवेह तुम्हाला अशा सर्व राष्ट्रांमध्ये ओढून नेतील, जिथे तुम्ही भयाचा, म्हणीचा आणि उपहासाचा विषय बनाल.<verse eid="DEU 28:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38"/>तुम्ही पुष्कळ बी पेराल, पण थोडक्याच पिकांची कापणी कराल, कारण टोळ ते खाऊन टाकतील. <verse eid="DEU 28:38"/><verse number="39" style="v" sid="DEU 28:39"/>तुम्ही द्राक्षमळे लावून त्यांची निगा राखाल; पण तुम्हाला द्राक्षे खावयाला मिळणार नाहीत किंवा द्राक्षारस प्यावयास मिळणार नाही. कारण कीड त्यांना खाऊन टाकेल. <verse eid="DEU 28:39"/><verse number="40" style="v" sid="DEU 28:40"/>तुमच्या सर्व देशात जैतुनाची झाडे वाढतील, पण तुम्ही तेलाचा उपयोग करू शकणार नाही. तुम्हाला तेल लावण्यासाठी पुरेसे जैतून तेल मिळणार नाही, कारण त्यांची फळे गळून जातील. <verse eid="DEU 28:40"/><verse number="41" style="v" sid="DEU 28:41"/>तुम्हाला पुत्र व कन्या होतील, पण त्यांना तुम्ही ठेऊ शकणार नाही, कारण ते गुलामगिरीत जातील. <verse eid="DEU 28:41"/><verse number="42" style="v" sid="DEU 28:42"/>टोळधाड येऊन तुमच्या भूमीवरील वृक्षांचा आणि पिकांचा नाश करतील.<verse eid="DEU 28:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 28:43"/>तुम्हामध्ये राहणारे परदेशी लोक तुमच्यावर अधिकाधिक वरचढ होत जातील, पण तुमची अधिकाधिक अधोगती होत जाईल. <verse eid="DEU 28:43"/><verse number="44" style="v" sid="DEU 28:44"/>ते तुम्हाला उसने देतील, पण तुम्ही त्यांना उसने देऊ शकणार नाही. ते मस्तक होतील आणि तुम्ही शेपूट व्हाल.<verse eid="DEU 28:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45"/>हे सर्व शाप तुमच्यावर येतील. ते तुमचा नाश होईपर्यंत पाठपुरावा करतील आणि तुम्हाला गाठतील, कारण तुम्ही याहवेह तुमच्या परमेश्वराच्या आज्ञेचे पालन केले नाही व ज्या आज्ञा आणि विधी त्यांनी तुम्हाला दिले त्याचे पालन करण्याचे नाकारले. <verse eid="DEU 28:45"/><verse number="46" style="v" sid="DEU 28:46"/>ही अरिष्टे सदैव तुमच्यावर व तुमच्या संततीवर चिन्ह आणि चमत्कार असे होतील. <verse eid="DEU 28:46"/><verse number="47" style="v" sid="DEU 28:47"/>कारण तुम्ही याहवेह तुमच्या परमेश्वराची समृद्धीच्या काळात आनंदाने आणि हर्षाने सेवा केली नाही, <verse eid="DEU 28:47"/><verse number="48" style="v" sid="DEU 28:48"/>म्हणून तुम्ही याहवेहने पाठविलेल्या तुमच्या शत्रूंचे गुलाम व्हाल आणि तुम्ही भुकेले, तहानलेले, नग्न आणि अत्यंत गरीब असे व्हाल आणि ते तुमचा नाश करेपर्यंत तुमच्या मानेवर लोखंडी जू ठेवण्यात येईल.<verse eid="DEU 28:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="DEU 28:49"/>याहवेह तुमच्यावर दुरून, पृथ्वीच्या सीमेवरून एक राष्ट्र पाठवतील, ते गरुडाप्रमाणे झेप घेऊन तुमच्यावर तुटून पडतील, ते असे राष्ट्र असेल ज्यांची भाषा तुम्हाला समजणार नाही, <verse eid="DEU 28:49"/><verse number="50" style="v" sid="DEU 28:50"/>ते क्रूर चेहर्‍याचे राष्ट्र असेल, जे तुमच्यातील वृद्धांना आदर देणार नाहीत किंवा तरुणांना दयामाया दाखविणार नाहीत. <verse eid="DEU 28:50"/><verse number="51" style="v" sid="DEU 28:51"/>तुमचा नाश होईपर्यंत ते तुमच्या गुराचे वत्स व तुमच्या भूमीचा उपज खाऊन टाकतील. तुमचे धान्य, नवीन द्राक्षारस, जैतुनाचे तेल, वासरे आणि कोकरे ही सर्व नाहीशी करून तुमचा पूर्णपणे नाश करतील. <verse eid="DEU 28:51"/><verse number="52" style="v" sid="DEU 28:52"/>ते राष्ट्र तुमच्या नगरांना वेढा घालेल आणि तुमचे सर्व उंच व मजबूत तट, ज्यावर तुमची भिस्त आहे, ते पाडून टाकतील. याहवेह तुमच्या परमेश्वराने तुम्हाला दिलेल्या देशातील सर्व शहरांना ते वेढा घालतील.<verse eid="DEU 28:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="DEU 28:53"/>तुमच्या शत्रूंनी वेढा दिल्यामुळे आणि त्यांच्या छळामुळे, तुम्ही तुमच्या पोटचे फळ म्हणजे तुमचे पुत्र व कन्या देखील तुम्ही खाऊन टाकाल, जे याहवेह तुमच्या परमेश्वराने तुम्हाला दिले आहे. <verse eid="DEU 28:53"/><verse number="54" style="v" sid="DEU 28:54"/>तुमच्यातील अत्यंत कोमलहृदयी व सुसंस्कृत पुरुषाला देखील आपला भाऊ, आपली प्राणप्रिय पत्नी आणि जगून वाचून राहिलेल्या मुलांवरही दयामाया येणार नाही, <verse eid="DEU 28:54"/><verse number="55" style="v" sid="DEU 28:55"/>आणि तो त्याच्या मुलांचे जे मांस खाईल त्याचे मांस तो त्यापैकी कोणालाही देणार नाही. कारण तुमच्या शहरांना वेढा पडल्यामुळे त्याच्याजवळ काहीच शिल्लक राहणार नाही. <verse eid="DEU 28:55"/><verse number="56" style="v" sid="DEU 28:56"/>ऐश्वर्यसंपन्न असल्यामुळे जिने आपला तळवाही कधी जमिनीला लावला नाही अशी घरंदाज व कोमलहृदयी पत्नी इतकी कठोरहृदयी बनेल की आपला प्राणप्रिय पती, पुत्र किंवा कन्या यांना ती आपल्या अन्नाचे वाटेकरी होऊ देणार नाही, <verse eid="DEU 28:56"/><verse number="57" style="v" sid="DEU 28:57"/>आपल्याच पोटचा गर्भ व आपल्याच पोटची मुले स्वतःलाच गुप्तपणे खाता यावी म्हणून ती लपवून ठेवील. अशाप्रकारे या वेढ्याच्या काळातील भूक खूप भयानक असेल आणि तुमच्या शत्रूकडून तुम्हाला तुमच्याच वेशींच्या आत भयंकर संकट व यातना भोगाव्या लागतील.<verse eid="DEU 28:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58"/>या पुस्तकात नमूद केलेली नियमशास्त्राची वचने तुम्ही प्रामाणिकपणे आचरणात आणली नाही आणि याहवेह तुमच्या परमेश्वराच्या अद्भुत आणि भयावह नावाचा मान तुम्ही राखला नाही, <verse eid="DEU 28:58"/><verse number="59" style="v" sid="DEU 28:59"/>तर याहवेह तुमच्यावर व तुमच्या वंशजांवर असाध्य रोग आणि कधीही न थांबणारे भयंकर साथीचे रोग पाठवतील. <verse eid="DEU 28:59"/><verse number="60" style="v" sid="DEU 28:60"/>ज्या रोगांना तुम्ही भिता, असे इजिप्तमधील सर्व रोग तुमच्यावर आणतील आणि ती तुम्हाला लागून राहतील. <verse eid="DEU 28:60"/><verse number="61" style="v" sid="DEU 28:61"/>तुमचा नाश होईपर्यंत याहवेह तुम्हावर प्रत्येक आजार आणि सर्व साथींचे रोग आणि या नियमशास्त्र ग्रंथात ज्यांचा उल्लेख नाही, असे सर्व रोग तुम्हावर आणतील. <verse eid="DEU 28:61"/><verse number="62" style="v" sid="DEU 28:62"/>तुम्ही आकाशातील तार्‍यांप्रमाणे अगणित असला, तरी अगदीच थोडके उराल, कारण तुम्ही याहवेह तुमच्या परमेश्वराचे आज्ञापालन केले नाही. <verse eid="DEU 28:62"/><verse number="63" style="v" sid="DEU 28:63"/>तुमची भरभराट करण्यात व तुम्हाला बहुगुणित करण्यात जसा याहवेहला आनंद वाटला, तसाच आनंद त्यांना तुमचा नाश व नायनाट करण्यातही वाटेल. जो देश तुम्ही ताब्यात घेण्यास जात आहात, त्या देशातून तुमचे उच्चाटन करण्यात येईल.<verse eid="DEU 28:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="DEU 28:64"/>पृथ्वीच्या एका टोकापासून दुसर्‍या टोकापर्यंत असलेल्या निरनिराळ्या राष्ट्रांमध्ये याहवेह तुमची पांगापांग करतील. तिथे तुम्ही किंवा तुमच्या पूर्वजांनी ज्यांची कधीही उपासना केली नाही—अशा लाकडाच्या आणि दगडाच्या दैवतांची तुम्ही उपासना कराल. <verse eid="DEU 28:64"/><verse number="65" style="v" sid="DEU 28:65"/>त्या राष्ट्रांमध्ये तुम्हाला स्वास्थ्य मिळणार नाही, तुमच्या पायांना विसावा मिळणार नाही, तिथे तुमची हृदये थरथर कापत राहतील, तुमचे डोळे म्लान होतील व तुमचा जीव झुरणीस लागेल, असे याहवेह करतील. <verse eid="DEU 28:65"/><verse number="66" style="v" sid="DEU 28:66"/>तुम्ही सदैव संशयात जगाल, रात्रंदिवस तुम्ही भीतीने ग्रस्त राहाल, तुमच्या जीवनाची काहीच खात्री राहणार नाही. <verse eid="DEU 28:66"/><verse number="67" style="v" sid="DEU 28:67"/>तुमची अंतःकरणे भयग्रस्त झाल्यामुळे सारखी धडधडत राहतील, त्यामुळे सकाळी तुम्ही म्हणाल, “अहा, आता रात्र असती, तर किती बरे झाले असते!” आणि संध्याकाळी तुम्ही म्हणाल, “अहा, आता सकाळ असती तर किती बरे झाले असते!” <verse eid="DEU 28:67"/><verse number="68" style="v" sid="DEU 28:68"/>जो प्रवास तुम्ही कधीही करणार नाही असे याहवेह म्हणाले होते, तोच प्रवास याहवेह तुम्हाला करावयाला लावतील आणि जहाजातून मी तुम्हाला पुन्हा इजिप्त देशामध्ये पाठवेन. मग तिथे तुमच्या शत्रूंनी तुम्हाला पुरुष व स्त्री गुलाम म्हणून विकत घ्यावे यासाठी तुम्ही स्वतःला देऊ कराल, परंतु तुम्हाला कोणाही विकत घेणार नाही.<verse eid="DEU 28:68"/></para>
  <chapter eid="DEU 28"/>
  <chapter number="29" style="c" sid="DEU 29"/>
  <para style="s1">कराराचे नवीनीकरण</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1"/>याहवेहने मोआब देशात इस्राएली लोकांबरोबर जो करार करण्याची मोशेला आज्ञा दिली होती त्याच्या या अटी आहेत, त्यांनी होरेब पर्वतावर जो करार केला होता तो विस्तारित असा आहे.<verse eid="DEU 29:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 29:2"/>मोशेने सर्व इस्राएली लोकांना बोलाविले आणि सांगितले:</para>
  <para style="b" vid="DEU 29:2"/>
  <para style="p" vid="DEU 29:2">इजिप्त देशात फारोह, त्याच्या अधिकार्‍यांशी आणि त्याच्या देशात याहवेहने जे काही केले ते तुम्ही तुमच्या डोळ्यांनी पाहिले आहे. <verse eid="DEU 29:2"/><verse number="3" style="v" sid="DEU 29:3"/>तिथे ज्या महान पीडा आणि ते चिन्ह आणि जे महान चमत्कार केले, ते सर्व तुम्ही स्वतःच्या डोळ्यांनी पाहिले आहेत. <verse eid="DEU 29:3"/><verse number="4" style="v" sid="DEU 29:4"/>पण याहवेहने आजपर्यंत तुम्हाला समजणारी अंतःकरणे किंवा पाहू शकणारे डोळे किंवा ऐकू शकणारे कान दिलेले नाहीत. <verse eid="DEU 29:4"/><verse number="5" style="v" sid="DEU 29:5"/>तरी देखील याहवेह म्हणतात, “चाळीस वर्षे तुम्हाला त्या रानात चालविले, तरी तुमचे कपडे जीर्ण झाले नाहीत ना तुमची पायतणे झिजली. <verse eid="DEU 29:5"/><verse number="6" style="v" sid="DEU 29:6"/>खाण्यासाठी तुमच्याजवळ भाकर नव्हती अथवा पिण्यासाठी तुमच्याजवळ द्राक्षारस किंवा मद्य नव्हते. हे मी यासाठी केले की मीच याहवेह तुमचा परमेश्वर आहे, हे तुम्ही ओळखावे.”<verse eid="DEU 29:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 29:7"/>जेव्हा तुम्ही येथे आला, तेव्हा हेशबोनचा राजा सीहोन व बाशानचा राजा ओग लढाई करण्यासाठी आपल्यावर चालून आले, पण आपण त्यांचा पराभव केला. <verse eid="DEU 29:7"/><verse number="8" style="v" sid="DEU 29:8"/>त्यांचा प्रदेश जिंकून आपण तो रऊबेन आणि गाद यांच्या गोत्रांना आणि मनश्शेहच्या अर्ध्या गोत्राला वतन म्हणून दिला.<verse eid="DEU 29:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9"/>म्हणून या कराराच्या अटींचे काळजीपूर्वक पालन करा, म्हणजे तुम्ही जे सर्वकाही कराल त्यात तुम्ही समृद्ध व्हाल. <verse eid="DEU 29:9"/><verse number="10" style="v" sid="DEU 29:10"/>आज तुम्ही सर्वजण याहवेह तुमच्या परमेश्वराच्या उपस्थितीत उभे आहात—म्हणजे तुमचे पुढारी व तुमचे गोत्र, तुमचे वडील आणि अधिकारी आणि इस्राएलमधील इतर सर्व पुरुष, <verse eid="DEU 29:10"/><verse number="11" style="v" sid="DEU 29:11"/>तुमचे लेकरे आणि तुमच्या स्त्रिया व मुलेबाळे आणि तुमच्या छावणीमध्ये राहणारे परदेशी, जे तुमच्यासाठी लाकूड तोडतात आणि तुमच्यासाठी पाणी भरतात. <verse eid="DEU 29:11"/><verse number="12" style="v" sid="DEU 29:12"/>याहवेह तुमच्या परमेश्वराशी करार करण्यासाठी येथे तुम्ही उभे आहात, तो करार याहवेह आज तुमच्यासोबत करीत आहेत आणि शपथपूर्वक त्यावर अशी मोहोर लावत आहेत की, <verse eid="DEU 29:12"/><verse number="13" style="v" sid="DEU 29:13"/>तुम्ही त्यांचे लोक आहात आणि तुमचे पूर्वज अब्राहाम, इसहाक व याकोब यांना प्रतिज्ञापूर्वक वचन दिल्याप्रमाणे याहवेहच तुमचे परमेश्वर आहेत याची आज तुम्हाला खात्री करून द्यावयाची आहे. <verse eid="DEU 29:13"/><verse number="14" style="v" sid="DEU 29:14"/>हा करार मी शपथपूर्वक करीत आहे, केवळ तुमच्याशीच नव्हे, <verse eid="DEU 29:14"/><verse number="15" style="v" sid="DEU 29:15"/>तर आज याहवेह तुमच्या परमेश्वरासमोर जे इस्राएली उभे आहेत व जे आज येथे नाहीत त्यांच्यासोबत देखील ते आहेत.<verse eid="DEU 29:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 29:16"/>तुम्हाला माहीत आहे की, आपण इजिप्त देशामध्ये कसे राहिलो आणि आपण इतर देशातून प्रवास करीत येथपर्यंत कसे आलो. <verse eid="DEU 29:16"/><verse number="17" style="v" sid="DEU 29:17"/>तुम्ही त्यांच्यामध्ये घृणास्पद वस्तू आणि लाकडाच्या आणि दगडाच्या, चांदीच्या आणि सोन्याच्या अमंगळ मूर्ती पाहिल्या आहेत. <verse eid="DEU 29:17"/><verse number="18" style="v" sid="DEU 29:18"/>आज येथे उभा असणारा तुमच्यातील कोणताही पुरुष किंवा स्त्री, कूळ किंवा गोत्राचे हृदय याहवेह तुमच्या परमेश्वराला सोडून इतर राष्ट्रांच्या दैवतांची उपासना करण्यासाठी त्यांच्याकडे वळणार नाही याबद्दल खबरदारी घ्या; हे कडू विषारी फळ आणि कडू दवणा देणार्‍या रोपट्याचे मूळ तुम्हामध्ये उगविणार नाही याबद्दल खबरदारी घ्या.<verse eid="DEU 29:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 29:19"/>जो कोणी अशी महत्त्वाची आणि गंभीर स्वरुपाची शपथ आपल्या कानांनी ऐकतो आणि स्वतःला आशीर्वाद देऊन म्हणतो, “माझ्या स्वतःच्याच इच्छेने मी चाललो तरी माझे काही बिघडणार नाही, मी सुरक्षित राहीन;” असे म्हणणारी माणसे सिंचित भूमी आणि कोरड्या भूमीवर नाश ओढवून घेतील. <verse eid="DEU 29:19"/><verse number="20" style="v" sid="DEU 29:20"/>याहवेह अशा लोकांना क्षमा करण्यास कधीही तयार होणार नाहीत; त्यांचा कोप व क्रोधाग्नी त्यांच्याविरुद्ध भडकेल. या ग्रंथात लिहिलेले सर्व शाप त्यांच्यावर कोसळतील आणि याहवेह त्यांचे नाव देखील या आकाशाच्या खालून नामशेष करून टाकतील. <verse eid="DEU 29:20"/><verse number="21" style="v" sid="DEU 29:21"/>याहवेह या मनुष्याला सर्व इस्राएली गोत्रातून वेगळे काढतील आणि कराराच्या या नियमशास्त्राच्या ग्रंथात नमूद केलेले सर्व शाप त्याच्यावर कोसळतील.<verse eid="DEU 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 29:22"/>मग तुमची भावी पिढी, तुमची मुलेबाळे आणि दूरदेशातील परदेशी लोक, तुमच्या देशावर याहवेहने पाठविलेली पीडा आणि रोगराई पाहतील. <verse eid="DEU 29:22"/><verse number="23" style="v" sid="DEU 29:23"/>तुमचा संपूर्ण देश गंधक आणि क्षारयुक्त होऊन—पूर्णपणे जळून गेल्यामुळे ती एक निरुपयोगी भूमी झाली आहे असे त्यांना आढळून येईल आणि याहवेहने क्रोधाविष्ट होऊन त्याचा सदोम, गमोरा, अदमाह व सबोईम या देशांसारखाच नाश केला आहे हे त्यांना दिसेल. <verse eid="DEU 29:23"/><verse number="24" style="v" sid="DEU 29:24"/>सर्व राष्ट्रे विचारतील: “याहवेहने या देशाचे असे का केले? हा एवढा कोप व क्रोधाग्नी कशाला?”<verse eid="DEU 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 29:25"/>आणि त्याचे उत्तर असेल: “ज्यावेळी याहवेह त्यांच्या पूर्वजांच्या परमेश्वराने इस्राएली लोकांना इजिप्त देशातून बाहेर आणले होते, त्यावेळी त्यांच्याशी जो करार केला होता तो या लोकांनी मोडला म्हणून असे झाले. <verse eid="DEU 29:25"/><verse number="26" style="v" sid="DEU 29:26"/>सक्त मनाई असतानाही, ते ओळखत नसलेली दैवते, जी त्यांना देण्यात आली नाहीत, त्या दैवतांची त्यांनी उपासना केली आणि त्यांना नमन केले. <verse eid="DEU 29:26"/><verse number="27" style="v" sid="DEU 29:27"/>म्हणूनच याहवेहचा क्रोध या देशाविरुद्ध इतका भडकला की, या पुस्तकात नमूद केलेले सर्व शाप त्यांनी त्यांच्यावर आणले. <verse eid="DEU 29:27"/><verse number="28" style="v" sid="DEU 29:28"/>तेव्हा याहवेहने रागाने आणि मोठ्या क्रोधाने त्यांचे या देशातून उच्चाटन केले आणि त्यांना दूरच्या देशात घालवून दिले, जिथे ते आज देखील राहत आहेत.”<verse eid="DEU 29:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 29:29"/>रहस्यमय बाबी याहवेह आमच्या परमेश्वराच्या आहेत; परंतु त्यांनी ज्यागोष्टी उघड रीतीने सांगितल्या, त्या आपल्यासाठी आणि आपल्या लेकरांसाठी आहेत, यासाठी की आपण या नियमशास्त्राच्या सर्व शब्दांचे पालन करावे.<verse eid="DEU 29:29"/></para>
  <chapter eid="DEU 29"/>
  <chapter number="30" style="c" sid="DEU 30"/>
  <para style="s1">याहवेहकडे वळल्याने होणारी भरभराट</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1"/>मी तुमच्यापुढे ठेवलेले हे सर्व आशीर्वाद आणि शाप तुम्हावर येतील, तेव्हा याहवेह तुमच्या परमेश्वराने तुम्हाला घालवून दिलेल्या देशात राहत असताना तुम्ही या गोष्टी आपल्या अंतःकरणात ठेवाव्या, <verse eid="DEU 30:1"/><verse number="2" style="v" sid="DEU 30:2"/>आणि त्यावेळी जर तुम्ही व तुमची मुले याहवेह तुमच्या परमेश्वराकडे परत याल आणि संपूर्ण मनाने व संपूर्ण जिवाने आज मी तुम्हाला देत आहे त्या त्यांच्या आज्ञा पाळाल, <verse eid="DEU 30:2"/><verse number="3" style="v" sid="DEU 30:3"/>तर याहवेह तुमचे परमेश्वर तुमची बंदिवासातून सुटका करतील आणि ते तुमच्यावर दया करतील आणि ज्या देशात त्यांनी तुम्हाला पांगवून टाकले असेल, त्या देशातून तुम्हाला एकत्र करतील. <verse eid="DEU 30:3"/><verse number="4" style="v" sid="DEU 30:4"/>तुम्ही पृथ्वीच्या अगदी दिगंतापर्यंत विखुरलेले असला, तरी याहवेह तुमचे परमेश्वर तुम्हाला तिथून पुन्हा परत आणतील. <verse eid="DEU 30:4"/><verse number="5" style="v" sid="DEU 30:5"/>याहवेह तुमचे परमेश्वर तुम्हाला तुमच्या पूर्वजांच्या देशात परत आणतील आणि तुम्ही तो ताब्यात घ्याल. ते तुमचे कल्याण करतील आणि तुमच्या पूर्वजांपेक्षा तुम्हाला अधिक संपन्न आणि बहुगुणित करतील. <verse eid="DEU 30:5"/><verse number="6" style="v" sid="DEU 30:6"/>याहवेह तुमचे परमेश्वर तुमच्या व तुमच्या वंशजांच्या अंतःकरणाची सुंता करतील, तुम्ही त्यांच्यावर पूर्ण मनाने व आत्म्याने प्रीती कराल, मग याद्वारे तुम्ही जिवंत राहू शकाल. <verse eid="DEU 30:6"/><verse number="7" style="v" sid="DEU 30:7"/>याहवेह तुमचे परमेश्वर हे सर्व शाप तुमच्या शत्रूंवर, म्हणजे जे तुमचा द्वेष करतात व तुमचा छळ करतात, त्यांच्यावर आणतील. <verse eid="DEU 30:7"/><verse number="8" style="v" sid="DEU 30:8"/>तुम्ही परत याहवेहच्या आज्ञा पाळाल आणि मी आज तुम्हाला देत असलेल्या त्यांच्या सर्व आज्ञेचे तुम्ही पालन कराल. <verse eid="DEU 30:8"/><verse number="9" style="v" sid="DEU 30:9"/>तेव्हा याहवेह तुमचे परमेश्वर तुमच्या हाताच्या प्रत्येक कार्यात तुम्हाला समृद्धी प्रदान करतील. ते तुम्हाला विपुल संतती, पुष्कळ गुरे आणि तुमच्या भूमीला अमाप पीक देतील. याहवेह तुमच्या पूर्वजांवर जसे प्रसन्न होते, तसेच तुमच्या कल्याणासाठी तुम्हावरही परत प्रसन्न होतील, <verse eid="DEU 30:9"/><verse number="10" style="v" sid="DEU 30:10"/>जर तुम्ही याहवेह तुमच्या परमेश्वराच्या आज्ञा पाळाल आणि नियमशास्त्राच्या या ग्रंथात याहवेह तुमच्या परमेश्वराने जे नियम व विधी दिले आहेत, त्या तुम्ही पाळाल व पूर्ण मनाने व आत्म्याने याहवेह तुमच्या परमेश्वराकडे माघारी वळाल, तर हे होईल.<verse eid="DEU 30:10"/></para>
  <para style="s1">दोन पर्याय: जीवन अथवा मृत्यू</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11"/>आता मी ज्या आज्ञा आज तुम्हाला देत आहे, त्या अतिशय अवघड किंवा तुमच्या आवाक्याबाहेरच्या नाहीत. <verse eid="DEU 30:11"/><verse number="12" style="v" sid="DEU 30:12"/>कारण त्या काही वर स्वर्गात नाहीत, की तुम्ही विचाराल, “आम्ही त्या पाळाव्या म्हणून आमच्यापर्यंत आणण्यासाठी आणि जाहीर करण्यासाठी स्वर्गात कोण चढेल?” <verse eid="DEU 30:12"/><verse number="13" style="v" sid="DEU 30:13"/>तसेच त्या महासागरा पलीकडेही नाहीत, की तुम्ही विचाराल, “आम्ही त्या पाळाव्या म्हणून आमच्यापर्यंत आणण्यासाठी आणि जाहीर करण्यासाठी महासागर ओलांडून कोण जाईल?” <verse eid="DEU 30:13"/><verse number="14" style="v" sid="DEU 30:14"/>नाही, वचन अगदी तुमच्याजवळ आहे; तुम्हाला त्यांचे पालन करता यावे म्हणून ते तुमच्या मुखात आहेत; ते तुमच्या अंतःकरणात आहे.<verse eid="DEU 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15"/>पाहा मी आज तुमच्यापुढे जीवन व समृद्धी, मृत्यू व नाश ठेवले आहे. <verse eid="DEU 30:15"/><verse number="16" style="v" sid="DEU 30:16"/>आज मी तुम्हाला आज्ञा देत आहे की तुम्ही याहवेह तुमच्या परमेश्वरावर प्रीती करावी, आज्ञापूर्वक त्यांच्या मार्गात चालावे, आणि त्यांच्या आज्ञा, विधी व नियम पाळावे; म्हणजे तुम्ही जिवंत राहाल व तुमची वृद्धी होईल आणि जी भूमी तुम्ही ताब्यात घेण्यासाठी जात आहात, तिथे याहवेह तुमचे परमेश्वर तुम्हाला आशीर्वादित करतील.<verse eid="DEU 30:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 30:17"/>परंतु तुमचे अंतःकरणे फिरले आणि तुम्ही आज्ञा न पाळणारे झालात आणि जर तुम्ही इतर दैवतांकडे बहकून जाऊन त्यांना नमन कराल आणि त्यांची उपासना कराल, <verse eid="DEU 30:17"/><verse number="18" style="v" sid="DEU 30:18"/>तर मी आज तुम्हाला जाहीरपणे सांगतो की, तुम्ही निश्चितच नष्ट व्हाल. यार्देन ओलांडून ज्या भूमीत प्रवेश करण्यास आणि ताब्यात घेण्यासाठी तुम्ही जात आहात, त्यात तुम्हाला दीर्घायुष्य लाभणार नाही.<verse eid="DEU 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 30:19"/>आकाश आणि पृथ्वी यांना तुमच्याविरुद्ध साक्षीला ठेवून आज मी तुमच्यापुढे जीवन आणि मृत्यू, आशीर्वाद आणि शाप, ही ठेवली आहेत. म्हणून तुम्ही जीवन निवडून घ्यावे म्हणजे तुम्ही आणि तुमची मुले जिवंत राहतील, <verse eid="DEU 30:19"/><verse number="20" style="v" sid="DEU 30:20"/>आणि तुम्ही याहवेह तुमच्या परमेश्वरावर प्रीती करावी, त्यांची वाणी ऐकावी आणि त्यांना बिलगून राहावे. कारण याहवेहच तुमचे जीवन आहेत आणि अब्राहाम, इसहाक आणि याकोब या तुमच्या पूर्वजांना वचन दिलेल्या देशात तेच तुम्हाला दीर्घायुष्य देतील.<verse eid="DEU 30:20"/></para>
  <chapter eid="DEU 30"/>
  <chapter number="31" style="c" sid="DEU 31"/>
  <para style="s1">मोशेनंतर यहोशुआचा पदाधिकार</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1"/>मोशेने या गोष्टी सर्व इस्राएली लोकांना जाऊन सांगितल्या: <verse eid="DEU 31:1"/><verse number="2" style="v" sid="DEU 31:2"/>“मी आता एकशेवीस वर्षांचा झालो आहे आणि मी येथून पुढे तुमचे नेतृत्व करू शकणार नाही. कारण ‘तू यार्देन नदी ओलांडू नये,’ असे याहवेहने मला सांगितले आहे. <verse eid="DEU 31:2"/><verse number="3" style="v" sid="DEU 31:3"/>परंतु याहवेह तुमचे परमेश्वर स्वतःच तुमच्या आधी यार्देन नदी ओलांडतील. ते या राष्ट्रांचा तुमच्यापुढे नाश करतील आणि तुम्ही त्यांच्या भूमीचा ताबा घ्याल. याहवेहने म्हटल्याप्रमाणे यहोशुआ देखील यार्देन नदी ओलांडून तुमच्यापुढे जाईल. <verse eid="DEU 31:3"/><verse number="4" style="v" sid="DEU 31:4"/>आणि ज्याप्रमाणे याहवेहने अमोर्‍यांचे राजे सीहोन आणि ओगचा नाश केला, त्याचप्रमाणे या देशातील राष्ट्रांचा ते नाश करतील. <verse eid="DEU 31:4"/><verse number="5" style="v" sid="DEU 31:5"/>याहवेह त्यांना तुमच्या स्वाधीन करतील आणि त्यांच्याशी ते सर्व करावे ज्याची आज्ञा मी तुम्हाला दिलेली आहे. <verse eid="DEU 31:5"/><verse number="6" style="v" sid="DEU 31:6"/>खंबीर व्हा आणि हिंमत धरा. त्यांना भिऊ नका वा घाबरू नका, कारण याहवेह तुमचे परमेश्वर तुमच्याबरोबर जातील; ते तुम्हाला कधीही सोडणार नाही किंवा त्यागणार नाही.”<verse eid="DEU 31:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7"/>मग मोशेने यहोशुआला बोलाविले आणि सर्व इस्राएली लोकांसमक्ष त्याला सांगितले, “खंबीर हो आणि हिंमत धर, कारण या लोकांच्या पूर्वजांना याहवेहने वचनपूर्वक देऊ केलेल्या देशात तू त्यांच्यासह जावे आणि ती भूमी त्यांचे वतन म्हणून त्यांना विभागून द्यावी. <verse eid="DEU 31:7"/><verse number="8" style="v" sid="DEU 31:8"/>याहवेह स्वतः तुझ्यापुढे चालतील आणि तुझ्याबरोबर राहतील; ते तुला कधीही सोडणार नाही किंवा त्यागणार नाहीत. भिऊ नकोस; निरुत्साही होऊ नकोस.”<verse eid="DEU 31:8"/></para>
  <para style="s1">नियमशास्त्राचे सार्वजनिक वाचन</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9"/>नंतर मोशेने हे संपूर्ण नियमशास्त्र लिहिले आणि याहवेहच्या कराराचे कोश वाहणाऱ्या लेवीय याजकांना आणि इस्राएली लोकांच्या वडीलजनांना दिले. <verse eid="DEU 31:9"/><verse number="10" style="v" sid="DEU 31:10"/>मग मोशेने त्यांना आज्ञा दिली: “प्रत्येक सातव्या वर्षाच्या शेवटी, कर्ज माफीच्या वर्षी, मंडपांच्या उत्सवात, <verse eid="DEU 31:10"/><verse number="11" style="v" sid="DEU 31:11"/>याहवेह तुमच्या परमेश्वराने निवडलेल्या ठिकाणी जेव्हा सर्व इस्राएली लोक उपस्थित होतील, तेव्हा हे नियमशास्त्र त्यांना ऐकू जाईल असे वाचावे. <verse eid="DEU 31:11"/><verse number="12" style="v" sid="DEU 31:12"/>लोकांना एकत्र करा—पुरुष, स्त्रिया आणि मुले आणि तुमच्या नगरात राहत असलेले परदेशी—म्हणजे ते ऐकतील आणि याहवेह तुमच्या परमेश्वराचे भय बाळगण्यास शिकतील व या नियमशास्त्रामधील सर्व वचने काळजीपूर्वक पाळतील. <verse eid="DEU 31:12"/><verse number="13" style="v" sid="DEU 31:13"/>त्यांची बालके, ज्यांना हे नियमशास्त्र ठाऊक नाही, त्यांनीही यार्देन नदी ओलांडून, त्या वचनदत्त देशात, जी भूमी ताब्यात घेण्यास तुम्ही जात आहात तिथे जोपर्यंत राहाल, तोपर्यंत हे ऐकावे आणि याहवेह तुमच्या परमेश्वराचे भय बाळगण्यास शिकावे.”<verse eid="DEU 31:13"/></para>
  <para style="s1">इस्राएलाच्या बंडाचे भाकीत</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14"/>मग याहवेह मोशेला म्हणाले, “तुझ्या मृत्यूचा दिवस जवळ आला आहे. यहोशुआला बोलव आणि तुम्ही दोघे सभामंडपात हजर व्हा म्हणजे मी तिथे त्याला नियुक्त करेन.” मग मोशे आणि यहोशुआ आले आणि सभामंडपात हजर झाले.<verse eid="DEU 31:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 31:15"/>तेव्हा याहवेह मंडपाच्या प्रवेशद्वाराशी मेघस्तंभाच्या रूपाने त्यांना प्रगट झाले आणि मेघस्तंभ द्वाराशी स्थिर राहिले. <verse eid="DEU 31:15"/><verse number="16" style="v" sid="DEU 31:16"/>आणि याहवेह मोशेला म्हणाले: “तू आपल्या पूर्वजांसोबत विसावा घ्यावयास जाणार आहे आणि हे लोक ज्या देशात प्रवेश करणार आहेत, तिथे लवकरच परकीय दैवतांच्या समोर व्यभिचार करतील. ते माझा त्याग करतील आणि मी त्यांच्याबरोबर केलेला करार मोडतील. <verse eid="DEU 31:16"/><verse number="17" style="v" sid="DEU 31:17"/>आणि म्हणून त्या दिवशी माझा क्रोध त्यांच्याविरुद्ध भडकेल आणि मी त्यांचा त्याग करेन; माझे मुख त्यांच्यापासून लपवेन आणि त्यांचा नाश होईल. त्यांच्यावर भयंकर संकटे व अरिष्ट येतील आणि त्या दिवशी ते म्हणतील, ‘आमचे परमेश्वर आता आम्हामध्ये नाहीत म्हणून ही संकटे आम्हावर आली आहेत का?’ <verse eid="DEU 31:17"/><verse number="18" style="v" sid="DEU 31:18"/>आणि निश्चितच इतर दैवतांची उपासना करण्याच्या त्यांच्या पातकांमुळे मी माझे मुख त्यांच्यापासून लपवेन.<verse eid="DEU 31:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19"/>“म्हणून आता हे गीत तुम्ही लिहून घ्या आणि ते इस्राएलाच्या सर्व लोकांना शिकव व त्यांना गावयास सांग, म्हणजे हे गीत त्यांच्याविरुद्ध माझ्याकरिता साक्ष असेल. <verse eid="DEU 31:19"/><verse number="20" style="v" sid="DEU 31:20"/>जो देश मी त्यांच्या पूर्वजांना शपथ वाहून देऊ केला आहे, त्या दुधामधाचा प्रवाह वाहणार्‍या देशात, मी त्यांना आणेन आणि ते खाऊन पिऊन तृप्त व संपन्न होतील, तेव्हा ते इतर दैवतांकडे वळतील आणि त्यांची उपासना करू लागतील, माझी उपेक्षा करतील आणि माझा करार मोडतील. <verse eid="DEU 31:20"/><verse number="21" style="v" sid="DEU 31:21"/>आणि जेव्हा त्यांच्यावर अनेक संकटे व अरिष्टे येतील, तेव्हा हे गीत त्यांच्याविरुद्ध साक्ष असे ठरेल, कारण त्यांचे वंशज हे गीत विसरू शकणार नाही. या वचनदत्त देशात प्रवेश करण्यापूर्वीच या लोकांची प्रवृत्ती कशी आहे हे मला माहीत आहे.” <verse eid="DEU 31:21"/><verse number="22" style="v" sid="DEU 31:22"/>तेव्हा त्याच दिवशी मोशेने त्या गीताचे शब्द लिहून काढले आणि सर्व इस्राएली लोकांना ते शिकविले.<verse eid="DEU 31:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23"/>नंतर याहवेहने नूनाचा पुत्र यहोशुआला ही आज्ञा दिली: “खंबीर हो व हिंमत धर, कारण तू सर्व इस्राएली लोकांना मी त्यांना देऊ केलेल्या वचनदत्त देशात आणशील आणि मी स्वतः तुझ्याबरोबर असेन.”<verse eid="DEU 31:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24"/>त्या पुस्तकात नमूद केलेल्या नियमशास्त्राच्या सर्व शब्दांना प्रारंभापासून शेवटपर्यंत मोशेने लिहून पूर्ण केल्यानंतर, <verse eid="DEU 31:24"/><verse number="25" style="v" sid="DEU 31:25"/>त्याने जे याहवेहच्या कराराचा कोश वाहतात त्या लेव्यांना आज्ञा केली: <verse eid="DEU 31:25"/><verse number="26" style="v" sid="DEU 31:26"/>“तुम्ही नियमशास्त्राचा हा ग्रंथ घ्या आणि याहवेह तुमच्या परमेश्वराच्या कराराच्या कोशाजवळ नेऊन ठेवा. तिथे हा तुमच्याविरुद्ध साक्ष म्हणून राहील. <verse eid="DEU 31:26"/><verse number="27" style="v" sid="DEU 31:27"/>कारण तुम्ही किती बंडखोर आणि ताठ मानेचे आहात हे मला माहीत आहे. मी तुम्हाबरोबर असताना, तुम्ही जर याहवेहविरुद्ध बंडखोरी करीत आहात, तर माझ्या मृत्यूनंतर तुम्ही किती अधिक बंडखोरी कराल! <verse eid="DEU 31:27"/><verse number="28" style="v" sid="DEU 31:28"/>आता तुमच्या गोत्रांच्या सर्व वडीलजनास आणि अधिकार्‍यांस माझ्यासमोर एकत्र करा, म्हणजे मी हे वचने त्यांच्या कानावर पडतील असे बोलेन व आकाश आणि पृथ्वी यांना त्यांच्याविरुद्ध साक्ष बनवेल. <verse eid="DEU 31:28"/><verse number="29" style="v" sid="DEU 31:29"/>कारण मला माहीत आहे की, माझ्या मृत्यूनंतर तुम्ही स्वतःला पूर्णपणे भ्रष्ट कराल आणि मी दिलेल्या आज्ञांपासून बहकून दूर जाल. भविष्यकाळात तुमच्यावर संकटे येतील, कारण याहवेहच्या दृष्टीने वाईट ते कराल व तुमच्या हस्तकृतीने त्यांना अतिशय संतप्त कराल.”<verse eid="DEU 31:29"/></para>
  <para style="s1">मोशेचे गीत</para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30"/>आणि मोशेने या गीताचे शब्द प्रारंभापासून तर शेवटपर्यंत जमलेल्या इस्राएली लोकांच्या सर्व मंडळीच्या कानी पडतील असे सांगितले.<verse eid="DEU 31:30"/></para>
  <chapter eid="DEU 31"/>
  <chapter number="32" style="c" sid="DEU 32"/>
  <para style="q1">
    <verse number="1" style="v" sid="DEU 32:1"/>अहो आकाशमंडळांनो, ऐका आणि मी बोलेन;</para>
  <para style="q2" vid="DEU 32:1">हे पृथ्वी, माझ्या मुखातील शब्दांकडे लक्ष दे.<verse eid="DEU 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 32:2"/>माझे शिक्षण तुमच्या कानावर पावसाच्या सरीप्रमाणे पडो,</para>
  <para style="q2" vid="DEU 32:2">माझ्या शब्दांची दवाप्रमाणे पखरण होवो,</para>
  <para style="q1" vid="DEU 32:2">नव्या गवतावर पडणार्‍या पावसाप्रमाणे,</para>
  <para style="q2" vid="DEU 32:2">कोवळ्या रोपांवर पावसाच्या सरींप्रमाणे वृष्टी करोत.<verse eid="DEU 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 32:3"/>मी याहवेहचे नाव जाहीर करेन.</para>
  <para style="q2" vid="DEU 32:3">आपल्या परमेश्वराच्या महानतेची स्तुती गा!<verse eid="DEU 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 32:4"/>तेच आमचे खडक आहेत, त्यांचे कार्य परिपूर्ण आहे.</para>
  <para style="q2" vid="DEU 32:4">आणि त्यांचे सर्व मार्ग न्याय्य असतात.</para>
  <para style="q1" vid="DEU 32:4">विश्वासयोग्य परमेश्वर, जे कधीच चूक करीत नाही,</para>
  <para style="q2" vid="DEU 32:4">ते न्यायी आणि सत्यनिष्ठ आहेत.<verse eid="DEU 32:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 32:5"/>ती आता त्यांची लेकरे राहिली नाहीत, कारण ती भ्रष्ट झाली आहेत;</para>
  <para style="q2" vid="DEU 32:5">त्यांना लाज वाटेल की ते एक विकृत आणि कुटिल पिढी आहेत.<verse eid="DEU 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 32:6"/>अहो मूर्ख आणि मतिमंद लोकांनो,</para>
  <para style="q2" vid="DEU 32:6">याहवेहची परतफेड करण्याची ही रीत आहे काय?</para>
  <para style="q1" vid="DEU 32:6">ते तुमचे जनक, तुमचे पिता नाहीत काय?</para>
  <para style="q2" vid="DEU 32:6">त्यांनीच तुम्हाला बनविले व घडविले नाही काय?<verse eid="DEU 32:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="DEU 32:7"/>पूर्वीच्या काळातील दिवस आठवा;</para>
  <para style="q2" vid="DEU 32:7">तुमच्या गत पिढ्यांची वर्षे स्मरणात आणा.</para>
  <para style="q1" vid="DEU 32:7">तुमच्या वडिलांना विचारा व ते तुम्हाला सांगतील.</para>
  <para style="q2" vid="DEU 32:7">तुमच्या वडीलजनांकडे विचारणा करा, ते याचा खुलासा करतील.<verse eid="DEU 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 32:8"/>जेव्हा सर्वोच्चांनी पृथ्वीवरील राष्ट्रांना त्यांचे वतन दिले,</para>
  <para style="q2" vid="DEU 32:8">तेव्हा त्यांनी सर्व मानवजातीची विभागणी केली,</para>
  <para style="q1" vid="DEU 32:8">इस्राएलाच्या पुत्रांच्या संख्येनुसार</para>
  <para style="q2" vid="DEU 32:8">त्यांच्या सीमारेषा आखून दिल्या.<verse eid="DEU 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 32:9"/>कारण याहवेहची प्रजाच त्यांची संपत्ती होती,</para>
  <para style="q2" vid="DEU 32:9">याकोब हे त्यांचे वैयक्तिक वतन आहे.<verse eid="DEU 32:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 32:10"/>एका मरुभूमीत त्यांना ते भेटले</para>
  <para style="q2" vid="DEU 32:10">ते घोर व भयाण अरण्य होते.</para>
  <para style="q1" vid="DEU 32:10">त्यांनी त्याचे जतन व संरक्षण केले;</para>
  <para style="q2" vid="DEU 32:10">त्यांच्या डोळ्यातील बाहुलीसारखे त्याचे रक्षण केले,<verse eid="DEU 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 32:11"/>गरुडपक्षीण आपले घरटे हालविते</para>
  <para style="q2" vid="DEU 32:11">आणि पिलांवर घिरट्या घालते,</para>
  <para style="q1" vid="DEU 32:11">आपले पंख पसरून,</para>
  <para style="q2" vid="DEU 32:11">आपल्या पिलांना आपल्या पंखावर सुरक्षित वाहून नेते.<verse eid="DEU 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 32:12"/>तसे फक्त याहवेहच याकोबाला चालवित होते;</para>
  <para style="q2" vid="DEU 32:12">इतर कोणतेही परदेशी दैवत त्याच्यासोबत नव्हते.<verse eid="DEU 32:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="DEU 32:13"/>याहवेहने त्याला देशातील उंचीवर स्वार केले,</para>
  <para style="q2" vid="DEU 32:13">आणि शेतातील फळे खायला दिली.</para>
  <para style="q1" vid="DEU 32:13">खडकातून पाझरणारा मध,</para>
  <para style="q2" vid="DEU 32:13">आणि डोंगर कपारीतून तेलाचा पौष्टिक आहार पुरविला,<verse eid="DEU 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 32:14"/>त्यांनी त्याला कळपातील गाईंचे दही-दूध,</para>
  <para style="q2" vid="DEU 32:14">पुष्ट शेळ्या आणि मेंढरे,</para>
  <para style="q1" vid="DEU 32:14">आणि बाशानाचे अस्सल मेंढे,</para>
  <para style="q2" vid="DEU 32:14">आणि सर्वोत्तम गहू पुरविला,</para>
  <para style="q1" vid="DEU 32:14">तुम्ही गडद लाल फेसाळणारा द्राक्षारसही प्यालात.<verse eid="DEU 32:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 32:15"/>लवकरच यशुरून<note caller="+" style="f"><char style="fr" closed="false">32:15 </char><char style="ft" closed="false">हा इस्राएलसाठी पर्यायी शब्द आहे आणि त्याचा अर्थ नीतिमान असा होतो.</char></note> स्वस्थ झाला आणि लाथा झाडू लागला;</para>
  <para style="q2" vid="DEU 32:15">खाऊन पिऊन धष्टपुष्ट व आकर्षक झाला.</para>
  <para style="q1" vid="DEU 32:15">उन्मत्त होऊन त्याने त्याच्या निर्माणकर्त्या परमेश्वराचा तिरस्कार केला,</para>
  <para style="q2" vid="DEU 32:15">आणि आपल्या तारणदुर्गाचा त्याग केला.<verse eid="DEU 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 32:16"/>त्यांनी परदेशी दैवतांच्या नादी लागून याहवेहला ईर्षेस पेटविले</para>
  <para style="q2" vid="DEU 32:16">आणि घृणित मूर्तींमुळे अतिशय संतप्त केले.<verse eid="DEU 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 32:17"/>जे परमेश्वर नाहीत अशा खोट्या दैवतांना अर्पणे वाहिली—</para>
  <para style="q2" vid="DEU 32:17">जी दैवते अनोळखी होती,</para>
  <para style="q2" vid="DEU 32:17">जी दैवते नवीनच अस्तित्वात आली होती,</para>
  <para style="q2" vid="DEU 32:17">ज्या दैवतांचे तुमच्या पूर्वजांना कधीच भय वाटले नाही.<verse eid="DEU 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 32:18"/>ज्या खडकाने तुम्हाला जन्म दिला, त्याचाच तुम्ही त्याग केला;</para>
  <para style="q2" vid="DEU 32:18">ज्या परमेश्वराने तुम्हाला निर्माण केले, त्यांनाच तुम्ही विसरला.<verse eid="DEU 32:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 32:19"/>हे याहवेहने बघितले आणि त्यांनी त्यांना नाकारले</para>
  <para style="q2" vid="DEU 32:19">कारण त्यांच्या पुत्र व कन्यांच्या द्वारे ते संतप्त झाले.<verse eid="DEU 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 32:20"/>तेव्हा ते म्हणाले, “मी त्यांच्यापासून माझे मुख लपवेन,</para>
  <para style="q2" vid="DEU 32:20">आणि मग त्यांचा कसा अंत होतो ते पाहीन;</para>
  <para style="q1" vid="DEU 32:20">कारण ही विकृत पिढी आहे,</para>
  <para style="q2" vid="DEU 32:20">जी विश्वासयोग्य संतती नाही.<verse eid="DEU 32:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 32:21"/>जे देव नाहीत त्याद्वारे त्यांनी मला ईर्षेस पेटविले आहे</para>
  <para style="q2" vid="DEU 32:21">आणि त्यांच्या तुच्छ मूर्तींनी मला संताप आणला आहे.</para>
  <para style="q1" vid="DEU 32:21">जे लोक नाहीत त्यांच्याद्वारे मी त्यांना ईर्षेस आणेन;</para>
  <para style="q2" vid="DEU 32:21">ज्या राष्ट्राला समज नाही त्याद्वारे मी त्यांना क्रोधास आणेन;<verse eid="DEU 32:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 32:22"/>कारण माझा क्रोधाग्नी प्रदीप्त होत आहे,</para>
  <para style="q2" vid="DEU 32:22">तो थेट अधोलोकापर्यंत खोलवर पेटणार आहे.</para>
  <para style="q1" vid="DEU 32:22">तो पृथ्वी व तिच्यावरील सर्व पिके जाळून टाकील,</para>
  <para style="q2" vid="DEU 32:22">आणि तिच्या पर्वतांच्या पायांना अग्नी लावील.<verse eid="DEU 32:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="DEU 32:23"/>“मी त्यांच्यावर संकटांची रास रचेन,</para>
  <para style="q2" vid="DEU 32:23">माझ्या बाणांनी त्यांच्यावर प्रहार करेन.<verse eid="DEU 32:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 32:24"/>मी पाठविलेल्या दुष्काळाने ते दुर्बल होतील,</para>
  <para style="q2" vid="DEU 32:24">महामारी व घातक रोग त्यांच्यावर येतील;</para>
  <para style="q1" vid="DEU 32:24">आपल्या दातांनी त्यांना फाडून खाणारी हिंस्त्र श्वापदे मी त्यांच्यावर पाठवेन,</para>
  <para style="q2" vid="DEU 32:24">मातीत सरपटणारे विषारी सर्पही त्यांच्यावर पाठवेन.<verse eid="DEU 32:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 32:25"/>घराबाहेर शत्रूंची तलवार त्यांना निर्वंश करेल;</para>
  <para style="q2" vid="DEU 32:25">आणि घराच्या आत ते भयाक्रान्त होतील.</para>
  <para style="q1" vid="DEU 32:25">तरुण पुरुष व तरुण स्त्रिया,</para>
  <para style="q2" vid="DEU 32:25">वृद्ध आणि बालके नाश पावतील.<verse eid="DEU 32:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 32:26"/>मी असे म्हटले असते, मी त्यांना दूरच्या देशात पांगविणार</para>
  <para style="q2" vid="DEU 32:26">आणि त्यांची आठवणसुद्धा मानवी स्मरणातून पुसली जाईल,<verse eid="DEU 32:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 32:27"/>पण मला शत्रूच्या फुशारक्यांची धास्ती वाटली,</para>
  <para style="q2" vid="DEU 32:27">ते कदाचित गैरसमज करतील,</para>
  <para style="q1" vid="DEU 32:27">आणि म्हणतील, ‘आम्ही आमच्या बाहुबलानेच विजय मिळविला आहे;</para>
  <para style="q2" vid="DEU 32:27">याहवेहने यातील काहीही केले नाही.’ ”<verse eid="DEU 32:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 32:28"/>ते एक असमंजस राष्ट्र आहे,</para>
  <para style="q2" vid="DEU 32:28">त्यांच्यात काही विवेक नाही.<verse eid="DEU 32:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 32:29"/>हे लोक सुज्ञ असते आणि जर त्यांना हे कळले असते तर किती बरे झाले असते,</para>
  <para style="q2" vid="DEU 32:29">आणि त्यांचा अंत कसा होणार हे त्यांना समजले असते!<verse eid="DEU 32:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="DEU 32:30"/>हे कसे शक्य आहे, केवळ एक मनुष्य हजार लोकांचा,</para>
  <para style="q2" vid="DEU 32:30">किंवा दोन लोक दहा हजार लोकांचा पाठलाग करू शकतात,</para>
  <para style="q1" vid="DEU 32:30">जर इस्राएलांच्या खडकाने त्यांना विकून टाकले नसते,</para>
  <para style="q2" vid="DEU 32:30">जर याहवेहने त्यांना टाकले नसते, तरच असे होऊ शकले असते?<verse eid="DEU 32:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="DEU 32:31"/>कारण त्यांचा खडक आमच्या खडकासारखा नाही,</para>
  <para style="q2" vid="DEU 32:31">आमचे शत्रू देखील हे मान्य करतात.<verse eid="DEU 32:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="DEU 32:32"/>त्यांची द्राक्षलता सदोमाच्या द्राक्षलतेमधून येते,</para>
  <para style="q2" vid="DEU 32:32">आणि गमोराच्या मळ्यातून येते.</para>
  <para style="q1" vid="DEU 32:32">त्यांचे द्राक्ष विषाने भरलेले आहेत,</para>
  <para style="q2" vid="DEU 32:32">आणि द्राक्षाचे घड कडू चवीचे आहेत.<verse eid="DEU 32:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="DEU 32:33"/>त्यांचे द्राक्षारस सर्पाचे विष,</para>
  <para style="q2" vid="DEU 32:33">ते नागांचे घातक विष आहे.<verse eid="DEU 32:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="DEU 32:34"/>“यांना मी राखून ठेवलेले नाही काय,</para>
  <para style="q2" vid="DEU 32:34">आणि यांना माझ्या तिजोरीत सुरक्षित ठेवले नाही काय?<verse eid="DEU 32:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="DEU 32:35"/>सूड घेणे मजकडे आहे; मी परतफेड करेन.</para>
  <para style="q2" vid="DEU 32:35">ठरल्या वेळेवर त्यांचे पाय घसरतील;</para>
  <para style="q1" vid="DEU 32:35">त्यांच्या नाशाचा दिवस जवळ आलेला आहे,</para>
  <para style="q2" vid="DEU 32:35">आणि त्यांचा सर्वनाश वेगाने त्यांच्या दिशेने सरसावत आहे.”<verse eid="DEU 32:35"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="36" style="v" sid="DEU 32:36"/>याहवेह आपल्या लोकांचा न्याय करतील,</para>
  <para style="q2" vid="DEU 32:36">आणि त्यांच्या सेवकांसाठी त्यांच्या मनाला पाझर फुटेल</para>
  <para style="q1" vid="DEU 32:36">जेव्हा त्यांच्यातील सर्व शक्ती संपून जाईल,</para>
  <para style="q2" vid="DEU 32:36">आणि दास किंवा स्वतंत्र असे कोणीही उरणार नाहीत.<verse eid="DEU 32:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="DEU 32:37"/>मग ते विचारतील: “आता त्यांची दैवते कुठे आहेत,</para>
  <para style="q2" vid="DEU 32:37">त्यांचे आश्रयाचे खडक कुठे आहेत?<verse eid="DEU 32:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="DEU 32:38"/>ज्या दैवतांनी त्यांच्या यज्ञातील चरबीचे सेवन केले</para>
  <para style="q2" vid="DEU 32:38">आणि त्यांच्या द्राक्षारसाचे रसपान केले, ती दैवते आता कुठे आहेत?</para>
  <para style="q1" vid="DEU 32:38">त्या दैवतांनी तुमच्या मदतीसाठी आता जागे व्हावे!</para>
  <para style="q2" vid="DEU 32:38">त्यांनी त्यांचे आश्रयस्थान व्हावे!<verse eid="DEU 32:38"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="39" style="v" sid="DEU 32:39"/>“आता पाहा मीच एकमेव आहे तो आहे!</para>
  <para style="q2" vid="DEU 32:39">माझ्याशिवाय इतर कोणताही ईश्वर नाही.</para>
  <para style="q1" vid="DEU 32:39">माझ्या आदेशानेच मृत्यू येतो आणि जीवनही मीच प्रदान करतो.</para>
  <para style="q2" vid="DEU 32:39">मी जखम केली आणि मी ती बरीही करेन,</para>
  <para style="q2" vid="DEU 32:39">माझ्या हातून सोडविणारा कोणीही नाही.<verse eid="DEU 32:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="DEU 32:40"/>मी माझा हात स्वर्गाकडे उंचावतो</para>
  <para style="q2" vid="DEU 32:40">आणि म्हणतो: शपथ माझ्या जीवनाची,<verse eid="DEU 32:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="DEU 32:41"/>जेव्हा मी माझी लखलखणारी तलवार पाजळेन</para>
  <para style="q2" vid="DEU 32:41">आणि न्याय देण्यासाठी ती माझ्या हातात घेईन,</para>
  <para style="q1" vid="DEU 32:41">मी माझ्या शत्रूचा सूड घेईन,</para>
  <para style="q2" vid="DEU 32:41">आणि जे माझा तिरस्कार करतात त्यांची परतफेड करेन.<verse eid="DEU 32:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="DEU 32:42"/>वधलेल्या व कैद केलेल्यांच्या रक्ताने,</para>
  <para style="q2" vid="DEU 32:42">शत्रूंच्या सरदारांच्या मस्तकाच्या रक्ताने</para>
  <para style="q1" vid="DEU 32:42">मी माझे बाण मदमस्त करेन,</para>
  <para style="q2" vid="DEU 32:42">आणि माझी तलवार मांस गिळून टाकेल.”<verse eid="DEU 32:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="DEU 32:43"/>अहो राष्ट्रांनो, त्यांच्या लोकांबरोबर जयजयकार करा,</para>
  <para style="q2" vid="DEU 32:43">कारण आपल्या सेवकांच्या रक्तपाताचा ते सूड उगवतील;</para>
  <para style="q1" vid="DEU 32:43">आणि शत्रूंचा प्रतिशोध घेतील,</para>
  <para style="q2" vid="DEU 32:43">आणि आपला देश आणि आपले लोक यांच्याकरिता प्रायश्चित करतील.<verse eid="DEU 32:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 32:44"/>मोशे नूनाचा पुत्र होशा<note caller="+" style="f"><char style="fr" closed="false">32:44 </char><char style="fq" closed="false">होशा </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">यहोशुआ</char></note> सोबत आला आणि या गीताचे सर्व शब्द लोकांना ऐकू जातील असे म्हणून दाखविले. <verse eid="DEU 32:44"/><verse number="45" style="v" sid="DEU 32:45"/>जेव्हा मोशेने गीताचे हे सर्व शब्द सर्व इस्राएलींसमोर बोलून संपविले, <verse eid="DEU 32:45"/><verse number="46" style="v" sid="DEU 32:46"/>तेव्हा तो त्यांना म्हणाला: “आज मी ज्या नियमशास्त्रामधील आज्ञा तुमच्यापुढे जाहीर केल्या आहेत, त्याला हृदयात साठवून ठेवा आणि तुमच्या मुलाबाळांना काळजीपूर्वक रीतीने त्यांचे पालन करण्यास शिकवा. <verse eid="DEU 32:46"/><verse number="47" style="v" sid="DEU 32:47"/>कारण हे केवळ पोकळ शब्द नाहीत—तर ते तुमचे जीवन आहे. त्याद्वारे यार्देनेच्या पलीकडे असलेला जो देश तुम्ही ताब्यात घेणार आहात, त्या देशात तुम्ही दीर्घकाल जगाल.”<verse eid="DEU 32:47"/></para>
  <para style="s1">नबो पर्वतावर मोशेचा शेवट होणार</para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48"/>त्याच दिवशी याहवेह मोशेला म्हणाले, <verse eid="DEU 32:48"/><verse number="49" style="v" sid="DEU 32:49"/>“तू मोआब देशात यरीहो पलीकडे असलेल्या अबारीम पर्वतातील नबो शिखराकडे जा, त्याच्यावर चढून समोर पसरलेला जो देश मी इस्राएली लोकांना त्यांचे स्वतःचे वतन म्हणून देणार आहे, त्या कनान देशाकडे नजर टाक. <verse eid="DEU 32:49"/><verse number="50" style="v" sid="DEU 32:50"/>तुझा भाऊ अहरोन होर पर्वतावर मरण पावला व आपल्या पूर्वजास जाऊन मिळाला, तसा तू देखील नबो पर्वतावर चढून गेल्यावर व कनान देश पाहिल्यावर मरशील आणि आपल्या पूर्वजास जाऊन मिळशील. <verse eid="DEU 32:50"/><verse number="51" style="v" sid="DEU 32:51"/>कारण सीनच्या अरण्यात कादेशच्या मरीबाह नावाच्या झर्‍याजवळ इस्राएली लोकांसमक्ष तू आणि अहरोनाने माझा विश्वासघात करून माझ्या पवित्रतेला आदर दिला नाही. <verse eid="DEU 32:51"/><verse number="52" style="v" sid="DEU 32:52"/>तर तो देश तू दुरून पाहशील; पण मी जो देश इस्राएली लोकांना देणार आहे, त्यात तू प्रवेश करणार नाहीस.”<verse eid="DEU 32:52"/></para>
  <chapter eid="DEU 32"/>
  <chapter number="33" style="c" sid="DEU 33"/>
  <para style="s1">मोशे इस्राएली गोत्रांना आशीर्वाद देतो</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1"/>परमेश्वराचा मनुष्य मोशेने आपल्या मरणापूर्वी इस्राएली लोकांना आशीर्वाद जाहीर केले. <verse eid="DEU 33:1"/><verse number="2" style="v" sid="DEU 33:2"/>तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:2">“याहवेह सीनाय पर्वतावरून आले</para>
  <para style="q2" vid="DEU 33:2">आणि सेईरावर ते सूर्याप्रमाणे उदय पावले;</para>
  <para style="q2" vid="DEU 33:2">पारान पर्वतावरून ते प्रकाशले.</para>
  <para style="q1" vid="DEU 33:2">असंख्य पवित्र जनांचा समुदाय त्यांच्याबरोबर होता.</para>
  <para style="q2" vid="DEU 33:2">दक्षिण दिशेने, त्यांच्या पर्वत उतरणीवरून ते खाली आले.<verse eid="DEU 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 33:3"/>निश्चित तुम्हीच आपल्या लोकांवर प्रीती करता;</para>
  <para style="q2" vid="DEU 33:3">सर्व पवित्रजन तुमच्या अधीन आहेत.</para>
  <para style="q1" vid="DEU 33:3">ते तुमच्या चरणाशी नमन करतात,</para>
  <para style="q2" vid="DEU 33:3">आणि तुमच्याकडून ते आज्ञा स्वीकारतात,<verse eid="DEU 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 33:4"/>मोशेने आम्हाला जे नियम दिले,</para>
  <para style="q2" vid="DEU 33:4">ते नियम याकोबाच्या सभेचे अमोल वतन आहे.<verse eid="DEU 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 33:5"/>इस्राएलच्या गोत्रांबरोबर</para>
  <para style="q2" vid="DEU 33:5">जेव्हा इस्राएलच्या लोकांचे पुढारी एकत्र जमले,</para>
  <para style="q2" vid="DEU 33:5">तेव्हा याहवेह यशुरून<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">नीतिमान </char><char style="ft" closed="false">इस्राएलसाठी हा शब्द वापरला आहे</char></note> लोकांचे राज्यकर्ता झाले.<verse eid="DEU 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 33:6"/>“रऊबेन जिवंत राहो व त्यास मृत्यू न येवो,</para>
  <para style="q2" vid="DEU 33:6">त्याची माणसे कमी न होवोत.”<verse eid="DEU 33:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7"/>आणि तो यहूदाहबद्दल असे म्हणाला:</para>
  <para style="q1" vid="DEU 33:7">“हे याहवेह, यहूदाहचा धावा ऐका;</para>
  <para style="q2" vid="DEU 33:7">आणि त्याला आपल्या लोकांजवळ आणा.</para>
  <para style="q1" vid="DEU 33:7">स्वतःच्या हाताने ते त्याचे संरक्षण करतात,</para>
  <para style="q2" vid="DEU 33:7">तुम्हीच त्याच्यासाठी त्याच्या शत्रूविरुद्ध साहाय्य व्हा!”<verse eid="DEU 33:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 33:8"/>मग तो लेवी विषयी म्हणाला:</para>
  <para style="q1" vid="DEU 33:8">“तुमचे उरीम व थुम्मीम,</para>
  <para style="q2" vid="DEU 33:8">तुमच्या विश्वसनीय लोकांच्या अधिकारात कायम राहोत.</para>
  <para style="q1" vid="DEU 33:8">ज्यांची तुम्ही मस्सा येथे परीक्षा घेतली; आणि मरीबाहच्या झर्‍याजवळ</para>
  <para style="q2" vid="DEU 33:8">तुम्ही त्यांच्याशी झुंज दिली.<verse eid="DEU 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 33:9"/>आपले आई आणि वडील यांच्याबद्दल त्याने म्हटले,</para>
  <para style="q2" vid="DEU 33:9">‘ते माझे कोणीही नाहीत.’</para>
  <para style="q1" vid="DEU 33:9">त्याने आपल्या बांधवांना ओळखले नाही,</para>
  <para style="q2" vid="DEU 33:9">किंवा आपल्या संततीस ओळखले नाही,</para>
  <para style="q1" vid="DEU 33:9">परंतु त्याने तुमच्या आज्ञांचे पालन केले,</para>
  <para style="q2" vid="DEU 33:9">आणि तुमच्या कराराशी ते प्रामाणिक राहिले.<verse eid="DEU 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 33:10"/>ते तुमचे विधी याकोबाला,</para>
  <para style="q2" vid="DEU 33:10">आणि तुमचे नियमशास्त्र इस्राएली लोकांना शिकवतील.</para>
  <para style="q1" vid="DEU 33:10">धूपाच्या वेदीवर ते धूप जाळतील,</para>
  <para style="q2" vid="DEU 33:10">व तुमच्या वेदीवर संपूर्ण होमबली अर्पितील.<verse eid="DEU 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 33:11"/>हे याहवेह, त्यांचे सर्व कौशल्य आशीर्वादित करा,</para>
  <para style="q2" vid="DEU 33:11">आणि त्यांची हस्तकृती तुम्हाला प्रसन्न करो.</para>
  <para style="q1" vid="DEU 33:11">त्यांच्याविरुद्ध जे उठतात त्यांना चिरडून टाका,</para>
  <para style="q2" vid="DEU 33:11">आणि ते पुन्हा उठणार नाहीत, असे करा.”<verse eid="DEU 33:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 33:12"/>मोशे बिन्यामीनाबद्दल म्हणाला:</para>
  <para style="q1" vid="DEU 33:12">“याहवेहचा लाडका त्यांच्याजवळ सुरक्षित राहो,</para>
  <para style="q2" vid="DEU 33:12">कारण दिवसभर याहवेह त्याची ढाल होऊन त्याला आपली सुरक्षा प्रदान करतात,</para>
  <para style="q2" vid="DEU 33:12">आणि जो याहवेहला प्रिय आहे तो त्यांच्या दोन्ही खांद्यामध्ये सुरक्षित आहे.”<verse eid="DEU 33:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 33:13"/>तो योसेफाबद्दल म्हणाला:</para>
  <para style="q1" vid="DEU 33:13">“याहवेह स्वर्गातील मौल्यवान दवाने,</para>
  <para style="q2" vid="DEU 33:13">आणि पृथ्वीच्या खोलात असलेल्या जलाने</para>
  <para style="q2" vid="DEU 33:13">त्याच्या भूमीला आशीर्वादित करोत;<verse eid="DEU 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 33:14"/>सूर्यप्रकाशाने मिळणारे उत्तम उत्पादन,</para>
  <para style="q2" vid="DEU 33:14">आणि चंद्राच्या प्रभावाने मिळणाऱ्या उत्तम गोष्टी त्याला प्राप्त होवो;<verse eid="DEU 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 33:15"/>प्राचीन पर्वतामधून प्राप्त होणार्‍या सर्वोत्तम वस्तूंनी</para>
  <para style="q2" vid="DEU 33:15">आणि सनातन डोंगरातून मिळणार्‍या निवडक फळांनी भरून जावो;<verse eid="DEU 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 33:16"/>जी पृथ्वीच्या विपुलतेची सर्वोत्तम भेट,</para>
  <para style="q2" vid="DEU 33:16">आणि जळत्या झुडूपातून बोलणार्‍या त्या प्रभूच्या कृपादृष्टीने तो समृद्ध होवो.</para>
  <para style="q1" vid="DEU 33:16">योसेफाच्या व त्याच्या वंशजाच्या<note caller="+" style="f"><char style="fr" closed="false">33:16 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">च्या पासून वेगळे केलेले</char></note> मस्तकावर हे सर्व आशीर्वाद येवोत,</para>
  <para style="q2" vid="DEU 33:16">जो आपल्या भाऊबंदांत प्रमुख होता.<verse eid="DEU 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 33:17"/>प्रथम जन्मलेल्या बैलासारखे त्याचे वैभव आहे;</para>
  <para style="q2" vid="DEU 33:17">त्याची शिंगे रानबैलाची शिंगे आहेत,</para>
  <para style="q1" vid="DEU 33:17">त्या शिंगानी तो राष्ट्रांना,</para>
  <para style="q2" vid="DEU 33:17">पृथ्वीच्या दिगंती असलेल्यांना देखील भोसकतो.</para>
  <para style="q1" vid="DEU 33:17">एफ्राईमाचे लाखो वंशज</para>
  <para style="q2" vid="DEU 33:17">आणि मनश्शेहचे हजारो वंशज असे आहेत.”<verse eid="DEU 33:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 33:18"/>जबुलूनाविषयी तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:18">“जबुलूना, तुझा प्रवास तुझ्यासाठी आनंदाचा होवो</para>
  <para style="q2" vid="DEU 33:18">आणि तू इस्साखारा, आपल्या डेऱ्यात उल्हास करो.<verse eid="DEU 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 33:19"/>ते लोकांना डोंगरावर बोलवतील</para>
  <para style="q2" vid="DEU 33:19">व तिथे न्याययुक्त अशी यज्ञार्पणे वाहतील;</para>
  <para style="q1" vid="DEU 33:19">समुद्रातून मिळविलेल्या उत्पन्नाचे ते स्वामी होतील,</para>
  <para style="q2" vid="DEU 33:19">वाळूतून आपले गुप्तधन काढतील.”<verse eid="DEU 33:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 33:20"/>गादाविषयी तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:20">“धन्य आहे गादाचा विस्तार!</para>
  <para style="q2" vid="DEU 33:20">गाद सिंहासारखा जीवन जगतो,</para>
  <para style="q2" vid="DEU 33:20">झडप घालून तो भुजा आणि डोके फोडतो.<verse eid="DEU 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 33:21"/>त्याने स्वतःसाठी सर्वाेत्तम अशी भूमी निवडली आहे;</para>
  <para style="q2" vid="DEU 33:21">पुढार्‍यासाठी राखून ठेवलेली जमीन त्याला मिळाली आहे.</para>
  <para style="q1" vid="DEU 33:21">वंशपित्यांच्या सभेत त्याने</para>
  <para style="q2" vid="DEU 33:21">इस्राएलाकरिता याहवेहच्या नीतिपर इच्छेचे</para>
  <para style="q2" vid="DEU 33:21">आणि याहवेहच्या न्यायाचे पालन केले.”<verse eid="DEU 33:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 33:22"/>दानाविषयी तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:22">“दान हा सिंहाच्या छाव्यासारखा आहे,</para>
  <para style="q2" vid="DEU 33:22">बाशानातून तो सिंहासारखी झेप घेतो.”<verse eid="DEU 33:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 33:23"/>नफताली विषयी तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:23">“नफताली याहवेहच्या सर्व आशीर्वादांनी तृप्त आहे</para>
  <para style="q2" vid="DEU 33:23">आणि त्यांच्या कृपेत परिपूर्ण आहे;</para>
  <para style="q2" vid="DEU 33:23">तो सागरापर्यंतचा दक्षिण भाग वतन करून घेईल.”<verse eid="DEU 33:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 33:24"/>आशेराविषयी तो म्हणाला:</para>
  <para style="q1" vid="DEU 33:24">“आशेर हा पुत्रांपैकी सर्वात धन्य आहे;</para>
  <para style="q2" vid="DEU 33:24">त्याला सर्व भावांची कृपादृष्टी प्राप्त होवो</para>
  <para style="q2" vid="DEU 33:24">आणि त्याचे पाय तेलाने धुतले जावोत.<verse eid="DEU 33:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 33:25"/>लोखंड आणि काशांच्या अडसरांनी त्याच्या शहराचे रक्षण होवो,</para>
  <para style="q2" vid="DEU 33:25">आणि तुझे सामर्थ्य तुझ्या जीवनमानाइतके असो.<verse eid="DEU 33:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 33:26"/>“यशुरूनच्या परमेश्वरासमान कोणी नाही,</para>
  <para style="q2" vid="DEU 33:26">ते आपल्या वैभवाच्या मेघावर आरूढ होऊन,</para>
  <para style="q2" vid="DEU 33:26">आकाशमंडळातून तुझ्या साहाय्यार्थ धावून येतात.<verse eid="DEU 33:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 33:27"/>सनातन परमेश्वर तुमचा आश्रय आहे,</para>
  <para style="q2" vid="DEU 33:27">आणि सनातन बाहू तुझ्याखाली आहेत.</para>
  <para style="q1" vid="DEU 33:27">तुझ्या शत्रूंना ते तुझ्यापुढून घालवून देतात,</para>
  <para style="q2" vid="DEU 33:27">‘त्यांचा नाश करा!’ असा ते आदेश देतात.<verse eid="DEU 33:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 33:28"/>म्हणून इस्राएल सुरक्षितेत जगेल;</para>
  <para style="q2" vid="DEU 33:28">याकोबास संरक्षण<note caller="+" style="f"><char style="fr" closed="false">33:28 </char><char style="ft" closed="false">काही मूळ प्रतींमध्ये </char><char style="fqa" closed="false">याकोबाचा झरा सुरक्षित आहे</char></note> प्राप्त होईल,</para>
  <para style="q1" vid="DEU 33:28">धान्य आणि नव्या द्राक्षारसाने समृद्ध असलेल्या</para>
  <para style="q2" vid="DEU 33:28">आणि आकाशातील जलांच्या दवबिंदूंनी सिंचित होणार्‍या भूमीत तो सुरक्षित राहील.<verse eid="DEU 33:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 33:29"/>इस्राएला, तू आशीर्वादित आहेस!</para>
  <para style="q2" vid="DEU 33:29">इतर कोणत्या लोकांना</para>
  <para style="q2" vid="DEU 33:29">याहवेहने वाचविले आहे काय?</para>
  <para style="q1" vid="DEU 33:29">तेच तुझी ढाल व तुझे साहाय्य आहेत</para>
  <para style="q2" vid="DEU 33:29">आणि तुझ्या वैभवाची तलवार आहेत.</para>
  <para style="q1" vid="DEU 33:29">तुझे शत्रू तुझ्यापुढे थरथर कापतील,</para>
  <para style="q2" vid="DEU 33:29">आणि तू त्यांची उच्च स्थाने पायाखाली तुडवशील!”<verse eid="DEU 33:29"/></para>
  <chapter eid="DEU 33"/>
  <chapter number="34" style="c" sid="DEU 34"/>
  <para style="s1">मोशेचा मृत्यू</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1"/>नंतर मोशे मोआबाच्या सपाट मैदानातून यरीहोच्या समोरील नबो पर्वताच्या पिसगा नामक शिखरावर चढून गेला. तिथून सभोवार—गिलआदापासून दानपर्यंतचा—सर्व प्रदेश याहवेहने त्याला दाखविला, <verse eid="DEU 34:1"/><verse number="2" style="v" sid="DEU 34:2"/>नफतालीचा संपूर्ण प्रदेश, एफ्राईम आणि मनश्शेह यांचे प्रदेश, त्यांच्या पलीकडे भूमध्य समुद्रापर्यंत पसरलेला तो यहूदीयाचा सर्व प्रदेश, <verse eid="DEU 34:2"/><verse number="3" style="v" sid="DEU 34:3"/>नेगेव प्रांत व यार्देनेचे खोरे! आणि खजुरीच्या झाडांचे यरीहो शहर, सोअर प्रांतापर्यंत. <verse eid="DEU 34:3"/><verse number="4" style="v" sid="DEU 34:4"/>मग याहवेह त्याला म्हणाले, “हाच तो वचनदत्त देश होय, ज्याचे मी अब्राहाम, इसहाक व याकोब यांना शपथपूर्वक वचन देऊन मी म्हटले होते, ‘मी हा देश त्यांच्या वंशजांना देईन.’ आता त्याला तू स्वतःच्या डोळ्यांनी पाहिले आहेस, परंतु तू त्यात प्रवेश करणार नाहीस.”<verse eid="DEU 34:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5"/>आणि याहवेहने सांगितल्याप्रमाणे, याहवेहचा सेवक मोशे मोआब देशात मरण पावला. <verse eid="DEU 34:5"/><verse number="6" style="v" sid="DEU 34:6"/>याहवेहने त्याला मोआब देशातील बेथ-पौरजवळील खोर्‍यात पुरले, पण आजपर्यंत त्याला पुरले ते ठिकाण नक्की कुठे आहे हे कोणालाही ठाऊक नाही. <verse eid="DEU 34:6"/><verse number="7" style="v" sid="DEU 34:7"/>मृत्युसमयी मोशे एकशेवीस वर्षांचा होता तरीही त्याची दृष्टी कमी झाली नव्हती, की त्याची शक्ती कमी झाली नव्हती. <verse eid="DEU 34:7"/><verse number="8" style="v" sid="DEU 34:8"/>इस्राएली लोकांनी मोआबाच्या मैदानात मोशेसाठी विलाप करण्याचे तीस दिवस पूर्ण होईपर्यंत शोक केला.<verse eid="DEU 34:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9"/>नूनाचा पुत्र यहोशुआ हा ज्ञानाच्या आत्म्याने परिपूर्ण होता, कारण मोशेने त्याजवर आपले हात ठेवले होते. म्हणून इस्राएली लोकांनी त्याचे ऐकले आणि याहवेहने मोशेला दिलेल्या आज्ञा ते पाळीत असत.<verse eid="DEU 34:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10"/>मोशेसारखा संदेष्टा इस्राएलात पूर्वी झाला नाही, कारण याहवेह त्याच्याशी समोरासमोर बोलत असत, <verse eid="DEU 34:10"/><verse number="11" style="v" sid="DEU 34:11"/>याहवेहच्या आज्ञेवरून त्याने इजिप्तमध्ये फारोह—त्याच्या दरबारातील लोक व संपूर्ण देशात आश्चर्यकारक चमत्कार केले. <verse eid="DEU 34:11"/><verse number="12" style="v" sid="DEU 34:12"/>मोशेने इस्राएलसमोर जे महान सामर्थ्यशाली किंवा भयावह चमत्कार केले ते चमत्कार इतर कोणीही केले नाही.<verse eid="DEU 34:12"/></para>
  <chapter eid="DEU 34"/>
</usx>
