<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">आमोस</para>
  <para style="toc1">आमोसाची भविष्यवाणी</para>
  <para style="toc2">आमोस</para>
  <para style="toc3">आमो</para>
  <para style="mt1">आमोसाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="AMO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1"/>तकोवा येथील एक मेंढपाळ आमोसाची वचने—त्याने उज्जीयाह यहूदाहचा आणि योआश<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">योआश </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">येहोआश</char></note> चा पुत्र यरोबोअम इस्राएलचा राजा असता, भूकंपाच्या दोन वर्षे आधी इस्राएलाबद्दल जे दृष्टान्तामध्ये पाहिले ते हे.<verse eid="AMO 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2"/>त्याने म्हटले:</para>
  <para style="q1" vid="AMO 1:2">“याहवेह सीयोनातून गर्जना करतात</para>
  <para style="q2" vid="AMO 1:2">आणि यरुशलेमातून गडगडाट करतात;</para>
  <para style="q1" vid="AMO 1:2">मेंढपाळांची कुरणे सुकून जातात,</para>
  <para style="q2" vid="AMO 1:2">आणि कर्मेलचा माथा कोमेजून जाईल.”<verse eid="AMO 1:2"/></para>
  <para style="s1">इस्राएलच्या शेजाऱ्यांचा न्याय</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 1:3">“दिमिष्कच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 1:3">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 1:3">कारण तिने गिलआदला</para>
  <para style="q2" vid="AMO 1:3">मळणी करण्याच्या लोखंडी काट्यांनी मळले आहे,<verse eid="AMO 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4"/>म्हणून मी हजाएलच्या घरावर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 1:4">व बेन-हदादच्या किल्ल्याला भस्म करेन.<verse eid="AMO 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5"/>दिमिष्कचे प्रवेशद्वार तोडून टाकेन;</para>
  <para style="q2" vid="AMO 1:5">आणि आवेन<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">क्रूर</char></note> खोर्‍यातील राजा<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">खोर्‍यातील रहिवासी</char></note></para>
  <para style="q1" vid="AMO 1:5">आणि बेथ-एदेनचा राजदंड धरणाऱ्यांना मी नष्ट करेन.</para>
  <para style="q2" vid="AMO 1:5">अरामाचे लोक कीर येथे गुलाम म्हणून जातील.”</para>
  <para style="q2" vid="AMO 1:5">याहवेह असे म्हणतात.<verse eid="AMO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 1:6">“गाझाच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 1:6">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 1:6">कारण तिने सर्व लोकांना बंदिवासात घेतले</para>
  <para style="q2" vid="AMO 1:6">आणि त्यांना एदोमला विकले,<verse eid="AMO 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7"/>म्हणून मी गाझाच्या तटांवर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 1:7">आणि तिच्या किल्ल्याला भस्म करेन.<verse eid="AMO 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8"/>मी अश्दोदच्या राजाचा</para>
  <para style="q2" vid="AMO 1:8">आणि अष्कलोनचा राजदंड धरणार्‍याचा नाश करेन.</para>
  <para style="q1" vid="AMO 1:8">शेवटच्या पलिष्टीचा नाश होत नाही</para>
  <para style="q2" vid="AMO 1:8">तोपर्यंत मी आपला हात एक्रोनावर चालवेन,”</para>
  <para style="q2" vid="AMO 1:8">असे सार्वभौम याहवेह म्हणतात.<verse eid="AMO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 1:9">“सोरच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 1:9">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 1:9">कारण बंदिवासातील सर्वांना एदोमास विकले</para>
  <para style="q2" vid="AMO 1:9">आणि बंधुत्वाच्या कराराची अवहेलना केली आहे.<verse eid="AMO 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10"/>म्हणून मी सोरच्या तटांवर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 1:10">आणि तिच्या किल्ल्यांना भस्म करेन.”<verse eid="AMO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 1:11">“एदोमच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 1:11">तर चार अपराधांसाठी शासन करण्यापासून अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 1:11">कारण त्याने तलवार घेऊन आपल्या भावाचा पाठलाग केला</para>
  <para style="q2" vid="AMO 1:11">आणि देशातील स्त्रियांचा वध केला,</para>
  <para style="q1" vid="AMO 1:11">कारण त्याचा क्रोध निरंतर वाढत होता,</para>
  <para style="q2" vid="AMO 1:11">आणि त्याच्या क्रोध अनियंत्रित वाढत गेला,<verse eid="AMO 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12"/>म्हणून मी तेमानवर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 1:12">आणि ती आग बस्राचे किल्ले भस्म करून टाकील.”<verse eid="AMO 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13"/>याहवेह असे म्हणतात,</para>
  <para style="q1" vid="AMO 1:13">“अम्मोनच्या तीन नाही</para>
  <para style="q2" vid="AMO 1:13">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 1:13">कारण आपल्या सीमा वाढविण्यासाठी</para>
  <para style="q2" vid="AMO 1:13">गिलआदाच्या गरोदर स्त्रियांना चिरले,<verse eid="AMO 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14"/>म्हणून मी राब्बाहच्या तटांवर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 1:14">आणि त्यामुळे त्यांचे किल्ले व राजमहाल भस्म होतील.</para>
  <para style="q1" vid="AMO 1:14">महान वादळामध्ये वावटळीचा आवाज व्हावा</para>
  <para style="q2" vid="AMO 1:14">तसा भयानक रणगर्जना होतील;<verse eid="AMO 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15"/>आणि तिचा राजा<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मोलेख राजा</char></note></para>
  <para style="q2" vid="AMO 1:15">आणि राजाचे अधिपती बरोबरच बंदिवासात जातील.”</para>
  <para style="q2" vid="AMO 1:15">याहवेहने म्हटले.<verse eid="AMO 1:15"/></para>
  <chapter eid="AMO 1"/>
  <chapter number="2" style="c" sid="AMO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1"/>याहवेह असे म्हणतात,</para>
  <para style="q1" vid="AMO 2:1">“मोआबच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 2:1">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 2:1">कारण त्याने एदोम राजाची हाडे जाळून</para>
  <para style="q2" vid="AMO 2:1">त्याची राख केली आहे.<verse eid="AMO 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2"/>मी मोआबावर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 2:2">तो करीयोथच्या किल्ल्याला<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">तिच्या शहरांना</char></note> भस्म करेन.</para>
  <para style="q1" vid="AMO 2:2">युद्धाच्या आक्रोशात आणि रणशिंगाच्या आवाजात मोआब</para>
  <para style="q2" vid="AMO 2:2">प्रचंड नाशाने खाली जाईल.<verse eid="AMO 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3"/>मी तिच्या शासकाचा नाश करेन</para>
  <para style="q2" vid="AMO 2:3">आणि त्याच्यासोबत तिच्या सर्व अधिकार्‍यांना मारून टाकेन.”</para>
  <para style="q2" vid="AMO 2:3">असे याहवेह म्हणतात.<verse eid="AMO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 2:4">“यहूदीयाच्या तीन नव्हे</para>
  <para style="q2" vid="AMO 2:4">तर चार अपराधांसाठी शासन करण्यापासून मागे फिरणार नाही.</para>
  <para style="q1" vid="AMO 2:4">कारण त्यांनी याहवेहचे नियमशास्त्र धिक्कारले आहे</para>
  <para style="q2" vid="AMO 2:4">व त्यांचे विधी पाळले नाही.</para>
  <para style="q1" vid="AMO 2:4">ज्या दैवतांचे अनुसरण त्यांच्या पूर्वजांनी केले होते</para>
  <para style="q2" vid="AMO 2:4">त्या त्यांच्या खोट्या दैवतांनी<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">खोटेपणाने</char></note> त्यांची दिशाभूल केली होती,<verse eid="AMO 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5"/>म्हणून मी यहूदीयावर अग्नी पाठवेन</para>
  <para style="q2" vid="AMO 2:5">आणि यरुशलेमचे किल्ले भस्म करेन.”<verse eid="AMO 2:5"/></para>
  <para style="s1">इस्राएलचा न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6"/>याहवेह असे म्हणतात,</para>
  <para style="q1" vid="AMO 2:6">“इस्राएलला तीन नव्हे</para>
  <para style="q2" vid="AMO 2:6">तर चार अपराधांसाठी शासन करण्यापासून मी अनुताप करणार नाही.</para>
  <para style="q1" vid="AMO 2:6">चांदीसाठी ते एका न्यायी व्यक्तीला,</para>
  <para style="q2" vid="AMO 2:6">आणि पायातील एका जोड्यासाठी गरजवंत व्यक्तीला विकतात.<verse eid="AMO 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7"/>ते गरिबांच्या डोक्याला</para>
  <para style="q2" vid="AMO 2:7">भूमिवरील धुळीत पायदळी तुडवितात</para>
  <para style="q2" vid="AMO 2:7">आणि दीनदुबळ्यांचा न्याय करीत नाही.</para>
  <para style="q1" vid="AMO 2:7">मुलगा व पिता एकाच तरुणीकडे जाऊन</para>
  <para style="q2" vid="AMO 2:7">माझ्या पवित्र नामाला काळिमा लावतात.<verse eid="AMO 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8"/>प्रत्येक वेदीजवळ</para>
  <para style="q2" vid="AMO 2:8">गहाण ठेवलेल्या वस्त्रांवर पडून राहतात</para>
  <para style="q1" vid="AMO 2:8">आणि आपल्या दैवतांच्या घरात</para>
  <para style="q2" vid="AMO 2:8">दंड म्हणून घेतलेला द्राक्षारस पितात.<verse eid="AMO 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9"/>“जरी ते गंधसरूंसारखे उंच</para>
  <para style="q2" vid="AMO 2:9">व एलावृक्षांसारखे मजबूत होते,</para>
  <para style="q2" vid="AMO 2:9">तरी मी त्यांच्यासमोर अमोरी लोकांचा संहार केला.</para>
  <para style="q1" vid="AMO 2:9">मी वरून त्यांचे फळ</para>
  <para style="q2" vid="AMO 2:9">व खालून त्यांचे मूळ नासविले.<verse eid="AMO 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10"/>अमोर्‍यांचा देश तुम्हाला द्यावा म्हणून</para>
  <para style="q2" vid="AMO 2:10">मी तुम्हाला इजिप्त देशातून बाहेर आणले</para>
  <para style="q2" vid="AMO 2:10">व चाळीस वर्षे तुम्हाला रानात चालविले.<verse eid="AMO 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11"/>“तुमच्या मुलांपैकी काहींना संदेष्टे म्हणून</para>
  <para style="q2" vid="AMO 2:11">आणि तरुणांतील काहींना नाजीर होण्याकरिता वाढवले आहे.</para>
  <para style="q1" vid="AMO 2:11">अहो इस्राएलच्या लोकांनो, हे खरे नाही काय?”</para>
  <para style="q2" vid="AMO 2:11">असे याहवेह जाहीर करतात.<verse eid="AMO 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12"/>“पण तुम्ही नाजीरांना द्राक्षारस पिण्यास</para>
  <para style="q2" vid="AMO 2:12">आणि संदेष्ट्यांना भविष्य न सांगण्याची आज्ञा दिली.<verse eid="AMO 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13"/>“म्हणून धान्याच्या पेंढ्यांखाली गच्च भरलेली गाडी जशी दबते,</para>
  <para style="q2" vid="AMO 2:13">तसे मी तुम्हाला दाबेन आणि तुम्ही कण्हाल.<verse eid="AMO 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14"/>चपळ निसटून जाणार नाहीत,</para>
  <para style="q2" vid="AMO 2:14">शक्तिमानाला आपले सामर्थ्य लावता येणार नाही,</para>
  <para style="q2" vid="AMO 2:14">आणि वीराला आपला जीव वाचविता येणार नाही.<verse eid="AMO 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15"/>धनुर्धार्‍याला आपल्या भूमीवर उभे राहता येणार नाही,</para>
  <para style="q2" vid="AMO 2:15">अत्यंत वेगाने धावणारा सैनिक सुटणार नाही,</para>
  <para style="q2" vid="AMO 2:15">आणि घोडेस्वाराला आपला जीव वाचवता येणार नाही.<verse eid="AMO 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16"/>वीरांपैकी महाधैर्यवानही</para>
  <para style="q2" vid="AMO 2:16">त्या दिवशी वस्त्रे टाकून पळतील.”</para>
  <para style="q2" vid="AMO 2:16">याहवेह असे जाहीर करतात.<verse eid="AMO 2:16"/></para>
  <chapter eid="AMO 2"/>
  <chapter number="3" style="c" sid="AMO 3"/>
  <para style="s1">इस्राएलविरुद्ध साक्षीदार बोलाविण्यात येतात</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1"/>इस्राएलच्या लोकांनो, हे वचन ऐका, जे याहवेह तुमच्याविरुद्ध बोलले आहेत—त्या संपूर्ण घराण्याविरुद्ध आहे ज्यांना मी इजिप्तमधून बाहेर आणले आहे:<verse eid="AMO 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2"/>“पृथ्वीवरील सर्व राष्ट्रातील लोकांमधून</para>
  <para style="q2" vid="AMO 3:2">मी फक्त तुझीच निवड केली आहे;</para>
  <para style="q1" vid="AMO 3:2">म्हणून तुझ्या सर्व पापांबद्दल</para>
  <para style="q2" vid="AMO 3:2">मी तुला शिक्षा करेन.”<verse eid="AMO 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3"/>दोन व्यक्ती एकमताचे झाल्यावाचून</para>
  <para style="q2" vid="AMO 3:3">ते सोबत चालू शकतील काय?<verse eid="AMO 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4"/>शिकार नसली तर</para>
  <para style="q2" vid="AMO 3:4">सिंह गर्जना करेन काय?</para>
  <para style="q1" vid="AMO 3:4">काही धरल्याशिवाय</para>
  <para style="q2" vid="AMO 3:4">तो त्याच्या गुहेत गुरगुरणार काय?<verse eid="AMO 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5"/>अमिष नसताना पक्षी</para>
  <para style="q2" vid="AMO 3:5">भूमीवरील सापळ्यात अडकतो काय?</para>
  <para style="q1" vid="AMO 3:5">जर सापळ्यात काही अडकले नसेल</para>
  <para style="q2" vid="AMO 3:5">तर ते भूमीवरून उडेल काय?<verse eid="AMO 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6"/>नगरात जेव्हा रणशिंगाचा आवाज येतो,</para>
  <para style="q2" vid="AMO 3:6">तेव्हा लोक घाबरत नाही काय?</para>
  <para style="q1" vid="AMO 3:6">शहरात विपत्ती आली तर,</para>
  <para style="q2" vid="AMO 3:6">ती याहवेहने घडवून आणली नाही काय?<verse eid="AMO 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7"/>सार्वभौम याहवेह</para>
  <para style="q2" vid="AMO 3:7">आपल्या सेवक संदेष्ट्यांना त्याच्या योजना प्रकट केल्याशिवाय</para>
  <para style="q2" vid="AMO 3:7">निश्चितच काहीही करणार नाही.<verse eid="AMO 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8"/>सिंहाने गर्जना केली आहे—</para>
  <para style="q2" vid="AMO 3:8">कोण भिणार नाही?</para>
  <para style="q1" vid="AMO 3:8">सार्वभौम याहवेहने बोलले आहेत;</para>
  <para style="q2" vid="AMO 3:8">तर मग संदेश दिल्यावाचून कोणी राहील काय?<verse eid="AMO 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9"/>अश्दोदच्या गडांना</para>
  <para style="q2" vid="AMO 3:9">आणि इजिप्तच्या गडांना ही घोषणा करा:</para>
  <para style="q1" vid="AMO 3:9">“शोमरोनच्या पर्वतावर एकत्र व्हा;</para>
  <para style="q2" vid="AMO 3:9">तिच्यामधील गोंधळ</para>
  <para style="q2" vid="AMO 3:9">आणि तिच्या लोकांवरील अत्याचाराकडे पाहा.”<verse eid="AMO 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10"/>“जे योग्य ते कसे करावे हे त्यांना माहीत नाही,” याहवेह जाहीर करतात,</para>
  <para style="q2" vid="AMO 3:10">“त्यांनी लुटलेला व चोरी केलेला माल</para>
  <para style="q2" vid="AMO 3:10">त्यांच्या महालात कोणी साठवून ठेवला आहे.”<verse eid="AMO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11"/>यास्तव सार्वभौम याहवेह असे म्हणतात,</para>
  <para style="q1" vid="AMO 3:11">“एक शत्रू जो तुमचा देश व्यापून टाकेल,</para>
  <para style="q2" vid="AMO 3:11">तो तुमचे किल्ले कोसळून टाकेल</para>
  <para style="q2" vid="AMO 3:11">आणि तुमचे गड लुटेल.”<verse eid="AMO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 3:12">“जसा मेंढपाळ सिंहाच्या तोंडातून</para>
  <para style="q2" vid="AMO 3:12">केवळ दोन तंगड्या आणि कानाचा एक तुकडा सोडवितो,</para>
  <para style="q1" vid="AMO 3:12">तसे शोमरोनातील इस्राएल लोक</para>
  <para style="q2" vid="AMO 3:12">जे पलंगाच्या शीरपट्टीने</para>
  <para style="q2" vid="AMO 3:12">आणि बिछान्यावरील<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">जे इस्राएली लोक शमरोनात बसून आहेत</char></note> रेशमी कापडाच्या तुकड्याने सोडविले जातील.”<verse eid="AMO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13"/>“हे ऐका आणि याकोबाच्या घराण्याविरुद्ध साक्ष द्या,” असे याहवेह सर्वसमर्थ परमेश्वर म्हणतात:<verse eid="AMO 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14"/>“ज्या दिवशी मी इस्राएलला तिच्या पातकाबद्दल शिक्षा करेन,</para>
  <para style="q2" vid="AMO 3:14">त्याच दिवशी मी बेथेलमधल्या वेद्यांचा नाश करेन;</para>
  <para style="q1" vid="AMO 3:14">वेद्यांची शिंगे कापून टाकण्यात येतील</para>
  <para style="q2" vid="AMO 3:14">आणि ती जमिनीवर पडतील.<verse eid="AMO 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15"/>मी ग्रीष्मकालीनघर</para>
  <para style="q2" vid="AMO 3:15">आणि उष्मकालीनघर पाडून टाकेन;</para>
  <para style="q1" vid="AMO 3:15">हस्तिदंताने सजविलेल्या घरांचा विध्वंस होईल</para>
  <para style="q2" vid="AMO 3:15">भवने जमीनदोस्त होतील,”</para>
  <para style="q2" vid="AMO 3:15">असे याहवेह जाहीर करतात.<verse eid="AMO 3:15"/></para>
  <chapter eid="AMO 3"/>
  <chapter number="4" style="c" sid="AMO 4"/>
  <para style="s1">इस्राएल परमेश्वराकडे परतले नाही</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1"/>शोमरोनच्या डोंगरावर राहणार्‍या बाशानच्या गाईंनो हे वचन ऐका,</para>
  <para style="q2" vid="AMO 4:1">तुम्ही स्त्रिया, ज्या तुम्ही गरिबांवर अत्याचार करता आणि गरजवंतांना चिरडता</para>
  <para style="q2" vid="AMO 4:1">आणि आपल्या नवर्‍यांना म्हणता, “आम्हाला काही पेय आणा!”<verse eid="AMO 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2"/>सार्वभौम याहवेहने आपल्या पवित्रतेची शपथ घेऊन म्हटले आहे:</para>
  <para style="q2" vid="AMO 4:2">“खचितच अशी वेळ येईल</para>
  <para style="q1" vid="AMO 4:2">जेव्हा तुम्हाला आकड्यांनी आणि तुमच्यातील शिल्लक राहिलेल्यांना</para>
  <para style="q2" vid="AMO 4:2">मासे धरण्याच्या गळांनी<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">माशांच्या टोपलीत</char></note> ओढून नेतील.<verse eid="AMO 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3"/>तुमच्यातील प्रत्येक</para>
  <para style="q2" vid="AMO 4:3">भिंतीच्या भगदाडातून सरळ निघून जाल.</para>
  <para style="q1" vid="AMO 4:3">तुम्ही हर्मोनात<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">काही मूळ प्रतींमध्ये </char><char style="fqa" closed="false">तू अत्याचार करणार्‍या पर्वता</char></note> आपणाला टाकाल.”</para>
  <para style="q2" vid="AMO 4:3">असे याहवेह म्हणतात.<verse eid="AMO 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4"/>“बेथेलास जा आणि पाप करा;</para>
  <para style="q2" vid="AMO 4:4">गिलगालास जाऊन आणि अधिक पाप करा.</para>
  <para style="q1" vid="AMO 4:4">रोज सकाळी आपली अर्पणे,</para>
  <para style="q2" vid="AMO 4:4">दर तीन वर्षांनी<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">दिवसांनी</char></note> आपला दशांश आणा.<verse eid="AMO 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5"/>उपकारस्तुती म्हणून खमिराची भाकरी जाळून टाका</para>
  <para style="q2" vid="AMO 4:5">आणि तुमच्या स्वैच्छिक अर्पणांची फुशारकी मारा;</para>
  <para style="q1" vid="AMO 4:5">इस्राएली लोकहो तुम्ही याविषयी बढाई मिरवा,</para>
  <para style="q2" vid="AMO 4:5">कारण असेच करणे तुम्हाला आवडते.”</para>
  <para style="q2" vid="AMO 4:5">असे सार्वभौम याहवेह जाहीर करतात.<verse eid="AMO 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6"/>“मी तुम्हाला प्रत्येक शहरात उपाशी पोटी ठेवले</para>
  <para style="q2" vid="AMO 4:6">आणि प्रत्येक नगरात भाकरीची कमतरता केली,</para>
  <para style="q1" vid="AMO 4:6">तरीही तुम्ही मजकडे वळला नाही.”</para>
  <para style="q2" vid="AMO 4:6">असे याहवेह जाहीर करतात.<verse eid="AMO 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7"/>“हंगामाच्या आधी तीन महिने</para>
  <para style="q2" vid="AMO 4:7">मी पाऊस रोखून धरला.</para>
  <para style="q1" vid="AMO 4:7">मी एका नगरावर पाऊस पाडला,</para>
  <para style="q2" vid="AMO 4:7">पण दुसर्‍यावर पाडला नाही.</para>
  <para style="q1" vid="AMO 4:7">एका शेतावर पाऊस पडला;</para>
  <para style="q2" vid="AMO 4:7">दुसर्‍या शेतावर पाऊस नव्हता आणि ते सुकून गेले.<verse eid="AMO 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8"/>पाण्यासाठी लोक नगरोनगरी भटकले</para>
  <para style="q2" vid="AMO 4:8">परंतु त्यांना पिण्यास पुरेसे मिळाले नाही,</para>
  <para style="q1" vid="AMO 4:8">तरीही तुम्ही मजकडे वळला नाही.”</para>
  <para style="q2" vid="AMO 4:8">असे याहवेह जाहीर करतात.<verse eid="AMO 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9"/>“मी तुमच्या शेतांवर व द्राक्षमळ्यांवर तांबेरा</para>
  <para style="q2" vid="AMO 4:9">आणि भेरड हे रोग पाठविले;</para>
  <para style="q1" vid="AMO 4:9">टोळांनी तुमची अंजिराची व जैतुनाची झाडे खाऊन टाकली,</para>
  <para style="q2" vid="AMO 4:9">आणि तरीही तुम्ही माझ्याकडे वळला नाही,”</para>
  <para style="q2" vid="AMO 4:9">असे याहवेह जाहीर करतात.<verse eid="AMO 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10"/>“इजिप्तमध्ये पाठविल्या</para>
  <para style="q2" vid="AMO 4:10">तशा पीडा मी तुमच्यामध्ये पाठविल्या.</para>
  <para style="q1" vid="AMO 4:10">मी तुमच्या तरुणांना</para>
  <para style="q2" vid="AMO 4:10">तुमच्या लुटलेल्या घोड्यांसहित तलवारीने मारून टाकले.</para>
  <para style="q1" vid="AMO 4:10">तुमच्या छावणीतील दुर्गंध तुमच्या नाकात भरला,</para>
  <para style="q2" vid="AMO 4:10">तरीही तुम्ही माझ्याकडे वळला नाही,”</para>
  <para style="q2" vid="AMO 4:10">असे याहवेह जाहीर करतात.<verse eid="AMO 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11"/>“तुमच्यातील काहींचा नाश असा केला</para>
  <para style="q2" vid="AMO 4:11">जसा मी, परमेश्वराने, सदोम आणि गमोराचा केला.</para>
  <para style="q1" vid="AMO 4:11">तुम्ही अग्नीच्या भट्टीतून ओढून काढलेल्या जळत्या काठीप्रमाणे होता,</para>
  <para style="q2" vid="AMO 4:11">तरीही तुम्ही माझ्याकडे वळला नाही,”</para>
  <para style="q2" vid="AMO 4:11">असे याहवेह जाहीर करतात.<verse eid="AMO 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12"/>“म्हणून हे इस्राएला, मी तझ्यासोबत असेच करणार आहे,</para>
  <para style="q2" vid="AMO 4:12">कारण मी तुझ्याशी असे करणार आहे,</para>
  <para style="q2" vid="AMO 4:12">म्हणून तुझ्या परमेश्वराला भेटण्यास तयार हो.”<verse eid="AMO 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13"/>ज्यांनी पर्वतांची रचना केली,</para>
  <para style="q2" vid="AMO 4:13">ज्यांनी वारे निर्माण केले,</para>
  <para style="q2" vid="AMO 4:13">आणि जे आपले विचार मानवजातीला प्रकट करतात,</para>
  <para style="q1" vid="AMO 4:13">जे प्रभात समयाला अंधकारात बदलतात</para>
  <para style="q2" vid="AMO 4:13">आणि पर्वताला आपल्या पायाखाली तुडवितात;</para>
  <para style="q2" vid="AMO 4:13">याहवेह सर्वसमर्थ परमेश्वर, हे त्यांचे नाव आहे.<verse eid="AMO 4:13"/></para>
  <chapter eid="AMO 4"/>
  <chapter number="5" style="c" sid="AMO 5"/>
  <para style="s1">विलापगीत आणि पश्चात्तापासाठी आव्हान</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1"/>हे इस्राएला, या वचनास ऐक, मी तुझ्याबद्दल विलाप करतो:<verse eid="AMO 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2"/>“इस्राएलची कुमारी पडली आहे,</para>
  <para style="q2" vid="AMO 5:2">ती पुन्हा कधीही उठणार नाही,</para>
  <para style="q1" vid="AMO 5:2">तिच्या स्वतःच्या भूमीत उजाड आहे,</para>
  <para style="q2" vid="AMO 5:2">तिला उठविणारा कोणीही नाही.”<verse eid="AMO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3"/>कारण सार्वभौम याहवेह इस्राएलास असे म्हणतात:</para>
  <para style="q1" vid="AMO 5:3">“तुमच्या शहरातून एक हजार शूर निघतात,</para>
  <para style="q2" vid="AMO 5:3">त्यातील शंभरच उरतील;</para>
  <para style="q1" vid="AMO 5:3">तुमच्या शहरातून शंभर निघतात,</para>
  <para style="q2" vid="AMO 5:3">त्यातील दहाच उरतील.”<verse eid="AMO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4"/>याहवेह इस्राएलाच्या लोकांना असे म्हणतात,</para>
  <para style="q1" vid="AMO 5:4">“मला शोधा म्हणजे तुम्ही जिवंत राहाल.<verse eid="AMO 5:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5"/>बेथेलचा<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">बेथेल </char><char style="ft" closed="false">बेथ-आवेनचा संकेत</char></note> शोध करू नका,</para>
  <para style="q1" vid="AMO 5:5">गिलगाल येथे जाऊ नका,</para>
  <para style="q2" vid="AMO 5:5">किंवा बेअर-शेबा येथे प्रवास करू नका.</para>
  <para style="q1" vid="AMO 5:5">कारण गिलगाल खचितच बंदिवासात जाईल,</para>
  <para style="q2" vid="AMO 5:5">आणि बेथेलचा पूर्ण नाश होईल”<verse eid="AMO 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6"/>याहवेहचा शोध करा म्हणजे तुम्ही वाचाल,</para>
  <para style="q2" vid="AMO 5:6">नाहीतर याहवेह योसेफाच्या गोत्रावर अग्नीसारखे भडकतील;</para>
  <para style="q1" vid="AMO 5:6">आणि त्याला भस्म करून टाकील,</para>
  <para style="q2" vid="AMO 5:6">आणि बेथेलमध्ये त्याला विझवणारा कोणीही नसेल.<verse eid="AMO 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7"/>असे लोक आहेत जे न्यायाला कडूपणात बदलतात</para>
  <para style="q2" vid="AMO 5:7">आणि नीतिमत्ता धुळीस मिळवितात.<verse eid="AMO 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8"/>ज्यांनी कृत्तिका नक्षत्रे व मृगशीर्ष नक्षत्रे निर्माण केले,</para>
  <para style="q2" vid="AMO 5:8">जे मध्यरात्रीचे रूपांतर पहाटेत करतात,</para>
  <para style="q2" vid="AMO 5:8">आणि जे दिवसाचे रूपांतर रात्रीत करतात,</para>
  <para style="q1" vid="AMO 5:8">जे समुद्राच्या पाण्यास बोलवितात</para>
  <para style="q2" vid="AMO 5:8">आणि ते जमिनीच्या पृष्ठभागावर ओततात—</para>
  <para style="q2" vid="AMO 5:8">याहवेह, हे त्यांचे नाव आहे.<verse eid="AMO 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9"/>अंधारी आणणाऱ्या क्षणिक प्रकाशाने ते किल्ला उद्ध्वस्त करतात</para>
  <para style="q2" vid="AMO 5:9">आणि तटबंदी असलेल्या शहराचा नाश करतात.<verse eid="AMO 5:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10"/>असे लोक आहे जे न्यायालयात न्यायाची बाजू घेणार्‍यांचा द्वेष</para>
  <para style="q2" vid="AMO 5:10">आणि सत्य बोलणार्‍यांचा तिरस्कार करतात.<verse eid="AMO 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11"/>तुम्ही गरिबांच्या पेंढ्यावरही कर लावता आणि त्यांच्या धान्यावरही कर लावता.</para>
  <para style="q2" vid="AMO 5:11">म्हणून जरी स्वतःसाठी चिरेबंदी भवन बांधले असतील</para>
  <para style="q1" vid="AMO 5:11">तरी त्यामध्ये कधीही राहणार नाही,</para>
  <para style="q2" vid="AMO 5:11">किंवा तुम्ही लावत असलेल्या भरघोस पीक देणार्‍या रमणीय</para>
  <para style="q1" vid="AMO 5:11">जरी तुम्ही कसदार द्राक्षमळा लावला</para>
  <para style="q2" vid="AMO 5:11">तरी त्यातील द्राक्षारस कधीच पिऊ शकणार नाही.<verse eid="AMO 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12"/>कारण तुमचे अपराध किती अधिक</para>
  <para style="q2" vid="AMO 5:12">आणि तुमची पातके किती घोर आहेत हे मला माहीत आहे.</para>
  <para style="b" vid="AMO 5:12"/>
  <para style="q1" vid="AMO 5:12">निरपराधांवर अत्याचार करून लाच घेतात</para>
  <para style="q2" vid="AMO 5:12">व गरिबांना न्यायालयात न्याय मिळण्यापासून वंचित करतात असेही लोक आहेत.<verse eid="AMO 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13"/>अशा वेळी जे शहाणे आहेत ते मौन धरतात,</para>
  <para style="q2" vid="AMO 5:13">कारण वेळ वाईट आहे.<verse eid="AMO 5:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14"/>वाईट नको, तर चांगले ते शोधा,</para>
  <para style="q2" vid="AMO 5:14">म्हणजे तुम्ही जगाल.</para>
  <para style="q1" vid="AMO 5:14">तुम्ही जसे ते म्हणतात त्याचप्रमाणे</para>
  <para style="q2" vid="AMO 5:14">याहवेह सर्वसमर्थ परमेश्वर तुमच्यासोबत असतील.<verse eid="AMO 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15"/>दुष्टाईचा द्वेष करा, चांगल्यावर प्रीती करा;</para>
  <para style="q2" vid="AMO 5:15">न्यायालयात न्याय स्थापित करा.</para>
  <para style="q1" vid="AMO 5:15">मग कदाचित याहवेह सर्वसमर्थ परमेश्वर</para>
  <para style="q2" vid="AMO 5:15">योसेफाच्या उरलेल्या लोकांवर दया करतील.<verse eid="AMO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16"/>यास्तव प्रभू, याहवेह सर्वसमर्थ परमेश्वर असे म्हणतात:</para>
  <para style="q1" vid="AMO 5:16">“सर्व रस्त्यांवर विलाप होईल</para>
  <para style="q2" vid="AMO 5:16">आणि प्रत्येक चौकात आक्रंदन होईल.</para>
  <para style="q1" vid="AMO 5:16">तुमच्याबरोबर शोक करण्यासाठी शेतकर्‍यांनाही बोलाविले जाईल;</para>
  <para style="q2" vid="AMO 5:16">रडण्यासाठी शोक करणार्‍यांना बोलाविले जाईल.<verse eid="AMO 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17"/>प्रत्येक द्राक्षमळ्यामध्ये आक्रंदन होईल,</para>
  <para style="q2" vid="AMO 5:17">कारण मी तुमच्यामधून जाईन,”</para>
  <para style="q2" vid="AMO 5:17">असे याहवेह म्हणतात.<verse eid="AMO 5:17"/></para>
  <para style="s1">याहवेहचा दिवस</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18"/>जे याहवेहच्या दिवसाची इच्छा बाळगतात</para>
  <para style="q2" vid="AMO 5:18">त्यांच्या धिक्कार असो!</para>
  <para style="q1" vid="AMO 5:18">तुम्ही याहवेहच्या दिवसाची इच्छा का बाळगता?</para>
  <para style="q2" vid="AMO 5:18">कारण तो दिवस प्रकाशाचा नाही तर अंधाराचा असेल.<verse eid="AMO 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19"/>जसे काय एखादा मनुष्य सिंहापासून पळाला</para>
  <para style="q2" vid="AMO 5:19">आणि त्याला अस्वलाने गाठले,</para>
  <para style="q1" vid="AMO 5:19">किंवा जसे काय आपल्या घरात येऊन त्याने</para>
  <para style="q2" vid="AMO 5:19">हात भिंतीला टेकविला</para>
  <para style="q2" vid="AMO 5:19">आणि त्याला साप चावला.<verse eid="AMO 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20"/>याहवेहचा दिवस हा प्रकाशाचा नसून अंधकाराचा दिवस असेल;</para>
  <para style="q2" vid="AMO 5:20">गडद अंधकार, प्रकाशाचा एकही किरण नसेल?<verse eid="AMO 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21"/>“मला तुमच्या धार्मिक उत्सवांचा तिरस्कार वाटतो;</para>
  <para style="q2" vid="AMO 5:21">तुमच्या सभा माझ्यासाठी दुर्गंधीप्रमाणे आहेत.<verse eid="AMO 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22"/>तुमची गोऱ्ह्यांची होमार्पणे व उपकारस्तुतीची अर्पणे आणली तरीही</para>
  <para style="q2" vid="AMO 5:22">मी स्वीकारणार नाही.</para>
  <para style="q1" vid="AMO 5:22">तुमच्या उत्तम शांत्यर्पणामुळे</para>
  <para style="q2" vid="AMO 5:22">मी संतुष्ट होणार नाही.<verse eid="AMO 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23"/>तुमच्या गीतांचा गोंगाट माझ्यापासून दूर ठेवा!</para>
  <para style="q2" vid="AMO 5:23">मी तुमच्या वीणांचे संगीत ऐकणार नाही.<verse eid="AMO 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24"/>परंतु न्याय नदीप्रमाणे</para>
  <para style="q2" vid="AMO 5:24">व नीतिमत्ता प्रचंड लोंढ्याप्रमाणे वाहू द्या!<verse eid="AMO 5:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25"/>“अहो इस्राएल लोकहो, रानात असताना</para>
  <para style="q2" vid="AMO 5:25">चाळीस वर्षे तुम्ही मला अर्पणे आणली व होम केले काय?<verse eid="AMO 5:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26"/>तुम्ही तुमच्या राजाचा देव्हारा,</para>
  <para style="q2" vid="AMO 5:26">तुमच्या काइवान<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="fq" closed="false">काइवान </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">किय्यून</char></note> मूर्तीची बैठक,</para>
  <para style="q2" vid="AMO 5:26">तुमच्या दैवताचा तारा<note caller="+" style="f"><char style="fr" closed="false">5:26 </char><char style="fq" closed="false">दैवताचा तारा </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">तुमचा राजा साक्कुथ आणि तुमचे दैवत रेफानचा तारा</char></note> उंचाविला;</para>
  <para style="q2" vid="AMO 5:26">जो तुम्ही तुमच्यासाठी बनविला.<verse eid="AMO 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27"/>म्हणून मी तुम्हाला, दिमिष्कच्या पलीकडे बंदिवासात पाठवेन,”</para>
  <para style="q2" vid="AMO 5:27">असे याहवेह म्हणतात, ज्यांचे नाव सर्वसमर्थ परमेश्वर आहे.<verse eid="AMO 5:27"/></para>
  <chapter eid="AMO 5"/>
  <chapter number="6" style="c" sid="AMO 6"/>
  <para style="s1">ऐषोरामी इस्राएलचा धिक्कार</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1"/>तुम्ही जे सीयोनेत आरामात राहता,</para>
  <para style="q2" vid="AMO 6:1">आणि शोमरोनच्या पर्वतावर निश्चिंत असण्याचा विचार करता की</para>
  <para style="q1" vid="AMO 6:1">तुम्ही जे राष्ट्रातील मुख्य लोक आहात,</para>
  <para style="q2" vid="AMO 6:1">ज्यांच्याजवळ इस्राएलचे लोक येतात, त्या तुमचा धिक्कार असो!<verse eid="AMO 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2"/>कालनेह येथे जा आणि तिला पाहा;</para>
  <para style="q2" vid="AMO 6:2">तिथून महान हमाथास जा,</para>
  <para style="q2" vid="AMO 6:2">आणि तिथून खाली पलिष्ट्यांच्या गथ येथे जा.</para>
  <para style="q1" vid="AMO 6:2">हे तुमच्या दोन राज्याहून अधिक उत्तम आहेत काय?</para>
  <para style="q2" vid="AMO 6:2">त्यांचा देश तुमच्या देशाहून मोठा आहे काय?<verse eid="AMO 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3"/>तुम्ही विपत्तीचे दिवस बाजूला सारता,</para>
  <para style="q2" vid="AMO 6:3">आणि दहशतीचे राज्य जवळ आणता.<verse eid="AMO 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4"/>तुम्ही हस्तिदंतांनी सजविलेल्या पलंगावर लोळता;</para>
  <para style="q2" vid="AMO 6:4">आणि तुम्ही अंथरुणावर पडून राहतात.</para>
  <para style="q1" vid="AMO 6:4">उत्तम कोकरे</para>
  <para style="q2" vid="AMO 6:4">आणि चरबीयुक्त वासरे खाता.<verse eid="AMO 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5"/>तुम्ही वीणेच्या सुरावर निरर्थक गाणी गाता,</para>
  <para style="q2" vid="AMO 6:5">आणि दावीदासारखे आहोत याची भ्रामक कल्पना करता.<verse eid="AMO 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6"/>तुम्ही वाट्या भरून द्राक्षारस पिता.</para>
  <para style="q2" vid="AMO 6:6">उत्तम तेलांनी स्वतःला माखता,</para>
  <para style="q2" vid="AMO 6:6">परंतु तुम्ही योसेफाच्या नाशाबद्दल दुःख करत नाही.<verse eid="AMO 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7"/>म्हणून तुम्ही प्रथम बंदिवासात जाल;</para>
  <para style="q2" vid="AMO 6:7">आणि तुमची चैनबाजी आणि मौज मस्ती नाहीशी होईल.<verse eid="AMO 6:7"/></para>
  <para style="s1">याहवेह इस्राएलाच्या गर्विष्ठपणाचा तिरस्कार करतात</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8"/>सार्वभौम याहवेहनी स्वतः शपथ घेतली आहे—याहवेह सर्वसमर्थ परमेश्वर घोषणा करतात:</para>
  <para style="q1" vid="AMO 6:8">“याकोबाच्या गर्वाचा मी तिरस्कार करतो</para>
  <para style="q2" vid="AMO 6:8">आणि त्यांचे किल्ले मी घृणास्पद मानतो;</para>
  <para style="q1" vid="AMO 6:8">मी या शहराला आणि तिच्यातील सर्वकाही</para>
  <para style="q2" vid="AMO 6:8">शत्रूंच्या हाती देईन.”<verse eid="AMO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9"/>जर एका घरात फक्त दहाच लोक उरले असले तरीही ते सर्व मरतील. <verse eid="AMO 6:9"/><verse number="10" style="v" sid="AMO 6:10"/>आणि मृतदेह जाळण्यासाठी<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मृत व्यक्तीच्या सन्मानार्थ</char></note> घरातून बाहेर काढायला आलेल्या त्याच्या नातेवाईकांनी तिथे लपून बसलेल्या कोणाला विचारले तर तुझ्यासोबत आणखी कोणी आहे काय? आणि तो म्हणेल, “नाही,” तो त्याला पुढे म्हणेल, “गप्प राहा, याहवेहचे नाव घेऊ नको.”<verse eid="AMO 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11"/>कारण याहवेहने अशी आज्ञा दिली आहे,</para>
  <para style="q2" vid="AMO 6:11">आणि ते मोठ्या घरांचे तुकडे तुकडे</para>
  <para style="q2" vid="AMO 6:11">आणि लहान घरांना चक्काचूर करतील.<verse eid="AMO 6:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12"/>घोडे खडकाळ कडांवर पळतात काय?</para>
  <para style="q2" vid="AMO 6:12">बैल घेऊन कोणी समुद्र नांगरतो काय?</para>
  <para style="q1" vid="AMO 6:12">पण तुम्ही न्यायाला विषामध्ये</para>
  <para style="q2" vid="AMO 6:12">आणि नीतिमत्तेच्या फळाला कडवटपणामध्ये बदलले आहे;<verse eid="AMO 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13"/>लो-देबारला<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">लो-देबार </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">क्षुल्लक</char></note> आपल्या ताब्यात घेण्यात तुम्ही आनंद मानता</para>
  <para style="q2" vid="AMO 6:13">आणि म्हणता, “आम्ही स्वतःच्या बळाने करनाईम<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">करनाईम </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">शिंग</char></note> घेतला नाही काय?”<verse eid="AMO 6:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14"/>याहवेह, सर्वसमर्थ परमेश्वर जाहीर करतात,</para>
  <para style="q2" vid="AMO 6:14">“हे इस्राएला, मी तुझ्याविरुद्ध एक राष्ट्र उठवेन,</para>
  <para style="q1" vid="AMO 6:14">लेबो हमाथपासून अराबाच्या ओहोळापर्यंत</para>
  <para style="q2" vid="AMO 6:14">ते तुझ्यावर जुलूम करेल.”<verse eid="AMO 6:14"/></para>
  <chapter eid="AMO 6"/>
  <chapter number="7" style="c" sid="AMO 7"/>
  <para style="s1">टोळधाड, अग्नी व ओळंबा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1"/>सार्वभौम याहवेहने मला जे दाखविले, ते हे आहे: जेव्हा राजाच्या पिकांची कापणी झाली आणि पुढचे पीक येणार होते, तेव्हा याहवेह टोळांची एक प्रचंड झुंड तयार करीत होते. <verse eid="AMO 7:1"/><verse number="2" style="v" sid="AMO 7:2"/>जेव्हा त्यांनी जमीन साफ केली, तेव्हा मी मोठ्याने ओरडलो, “सार्वभौम याहवेह, क्षमा करा! याकोब कसा टिकू शकेल? तो फार लहान आहे!”<verse eid="AMO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3"/>तेव्हा याहवेहचे मन द्रवले,</para>
  <para style="p" vid="AMO 7:3">“पुन्हा हे घडणार नाही,” याहवेह असे म्हणाले.<verse eid="AMO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4"/>सार्वभौम याहवेहने हे मला दाखविले: सार्वभौम याहवेहने अग्नीला न्याय करण्यास बोलाविले; त्यांनी खोल समुद्र कोरडा केला आहे आणि त्यांनी भूमी गिळंकृत केली आहे. <verse eid="AMO 7:4"/><verse number="5" style="v" sid="AMO 7:5"/>तेव्हा मी म्हणालो, “अहो सार्वभौम याहवेह, मी तुम्हाला विनंती करतो, थांबा! याकोब कसा वाचेल? तो फार लहान आहे!”<verse eid="AMO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6"/>मग याहवेहचे मन द्रवले.</para>
  <para style="p" vid="AMO 7:6">आणि सार्वभौम याहवेह म्हणाले, “हे देखील घडणार नाही.”<verse eid="AMO 7:6"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7"/>त्यांनी मला हे दाखविले: ओळंबा लावून बांधलेल्या एका भिंतीच्या जवळ, प्रभू हातात ओळंबा घेऊन उभे होते. <verse eid="AMO 7:7"/><verse number="8" style="v" sid="AMO 7:8"/>आणि याहवेहने मला विचारले, “आमोस, तुला काय दिसते?”</para>
  <para style="p" vid="AMO 7:8">मी म्हणालो, “ओळंबा!”</para>
  <para style="p" vid="AMO 7:8">नंतर प्रभू म्हणाले, “पाहा मी माझे लोक इस्राएल यांच्यामध्ये ओळंबा धरणार आहे; यापुढे मी त्यांची गय करणार नाही.<verse eid="AMO 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9"/>“इसहाकाचे उच्च पूजास्थाने नाश करण्यात येतील</para>
  <para style="q2" vid="AMO 7:9">आणि इस्राएलची पवित्रस्थाने पाडण्यात येतील;</para>
  <para style="q2" vid="AMO 7:9">मी माझ्या तलवारीने यरोबोअमाच्या विरुद्ध उठेन.”<verse eid="AMO 7:9"/></para>
  <para style="s1">आमोस आणि अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10"/>तेव्हा बेथेलचा याजक, अमस्याहने इस्राएलचा राजा यरोबोअमाला हा निरोप पाठविला: आमोस इस्राएलच्या हृदयात तुमच्याविरुद्ध कट रचीत आहे. त्याचेही सर्व शब्द देशासाठी असह्य आहेत. <verse eid="AMO 7:10"/><verse number="11" style="v" sid="AMO 7:11"/>कारण आमोस असे म्हणत आहे:</para>
  <para style="q1" vid="AMO 7:11">“ ‘यरोबोअम हा तलवारीने मरणार आहे,</para>
  <para style="q2" vid="AMO 7:11">आणि इस्राएल खात्रीने,</para>
  <para style="q2" vid="AMO 7:11">आपल्या भूमीवरून दूर बंदिवासात जाईल.’ ”<verse eid="AMO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12"/>नंतर अमस्याह आमोसला म्हणाला, “हे संदेष्ट्या, येथून यहूदीया प्रांतात परत जा आणि तिथे जाऊन आपली भाकर कमव आणि तुझे संदेश तिथे सांगत राहा! <verse eid="AMO 7:12"/><verse number="13" style="v" sid="AMO 7:13"/>याच्यापुढे बेथेल येथे संदेश देऊ नकोस, कारण हे राजकीय भवन आहे आणि राज्याचे मंदिर आहे.”<verse eid="AMO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14"/>आमोसने अमस्याहला उत्तर दिले, “मी तर संदेष्टा नाही आणि मी संदेष्ट्याचा पुत्रही नाही, मी तर मेंढपाळ आणि उंबरांच्या झाडांची निगा राखणारा होतो. <verse eid="AMO 7:14"/><verse number="15" style="v" sid="AMO 7:15"/>परंतु मी गुरांची राखण करीत असताना याहवेहने मला दूर नेले आणि मला म्हणाले, ‘जा, आणि माझ्या इस्राएली लोकांना संदेश सांग.’ <verse eid="AMO 7:15"/><verse number="16" style="v" sid="AMO 7:16"/>म्हणून आता तुम्ही याहवेहचे वचन ऐका, व तुम्ही म्हणतात,</para>
  <para style="q1" vid="AMO 7:16">“ ‘इस्राएलविरुद्ध भविष्यवाणी करू नकोस,</para>
  <para style="q2" vid="AMO 7:16">आणि इसहाकाच्या घराण्याविरुद्ध प्रचार करणे थांबव.’<verse eid="AMO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17"/>“म्हणून याहवेह असे म्हणतात:</para>
  <para style="q1" vid="AMO 7:17">“ ‘तुझी पत्नी शहरात वेश्या होईल,</para>
  <para style="q2" vid="AMO 7:17">तुझे पुत्र व कन्या तलवारीने मरतील,</para>
  <para style="q1" vid="AMO 7:17">तुझी जमीन मोजण्यात येईल आणि सूत्राने विभागली जाईल,</para>
  <para style="q2" vid="AMO 7:17">आणि तू स्वत: अपवित्र देशात मरशील.</para>
  <para style="q1" vid="AMO 7:17">इस्राएलचे लोक निश्चितच आपल्या</para>
  <para style="q2" vid="AMO 7:17">देशातून दूर बंदिवासात गुलाम म्हणून जातील.’ ”<verse eid="AMO 7:17"/></para>
  <chapter eid="AMO 7"/>
  <chapter number="8" style="c" sid="AMO 8"/>
  <para style="s1">पिकलेल्या फळांची टोपली</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1"/>सार्वभौम याहवेहने मला हे दाखविले: पिकलेल्या फळांनी भरलेली एक टोपली दाखविली. <verse eid="AMO 8:1"/><verse number="2" style="v" sid="AMO 8:2"/>“आमोसा, तुला काय दिसते?” त्यांनी विचारले.</para>
  <para style="p" vid="AMO 8:2">मी उत्तर दिले, “मला पिकलेल्या फळांची एक टोपली दिसते.”</para>
  <para style="p" vid="AMO 8:2">मग याहवेह मला म्हणाले, “माझ्या इस्राएली लोकांचा समय परिपक्व झाला आहे; मी त्यांची गय करणार नाही.”<verse eid="AMO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3"/>सार्वभौम याहवेह घोषित करतात, “त्या दिवशी, मंदिरातील त्यांचे गीत मी आकांतात बदलेन.<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मंदिरात गीत गाणारे आकांत करतील</char></note> सर्वत्र अनेक मृतदेह मौन धरून पडलेली असतील!”<verse eid="AMO 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4"/>जे तुम्ही गरजवंतांना तुडवितात</para>
  <para style="q2" vid="AMO 8:4">आणि देशाच्या गरिबांना दूर लोटता,<verse eid="AMO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5"/>असे म्हणता,</para>
  <para style="q1" vid="AMO 8:5">“अमावस्या केव्हा निघून जाईल</para>
  <para style="q2" vid="AMO 8:5">म्हणजे आम्ही धान्य विकू शकू?</para>
  <para style="q1" vid="AMO 8:5">आणि शब्बाथ केव्हा निघून जाईल,</para>
  <para style="q2" vid="AMO 8:5">म्हणजे आम्ही धान्याचे कोठार उघडू?”</para>
  <para style="q1" vid="AMO 8:5">तराजूत लबाडी करून,</para>
  <para style="q2" vid="AMO 8:5">लबाडीच्या मापाने,</para>
  <para style="q2" vid="AMO 8:5">किंमत वाढवू.<verse eid="AMO 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6"/>म्हणजे चांदीच्या मापात गरिबांना</para>
  <para style="q2" vid="AMO 8:6">आणि पायतणाच्या एका जोडीसाठी गरजूंना विकत घेऊ,</para>
  <para style="q2" vid="AMO 8:6">आणि गव्हाचा भुसाही विकायचा.<verse eid="AMO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7"/>याकोबाचे वैभव असलेले याहवेह यांनी स्वतःची शपथ घेऊन सांगितले आहेः “मी त्यांनी जे केले ते कधीही विसरणार नाही!<verse eid="AMO 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8"/>“यामुळे पृथ्वी थरथर कापणार नाही काय,</para>
  <para style="q2" vid="AMO 8:8">आणि तिच्यात राहणारे सर्व शोक करणार नाहीत काय?</para>
  <para style="q1" vid="AMO 8:8">संपूर्ण पृथ्वी नाईल नदीसारखी उठेल;</para>
  <para style="q2" vid="AMO 8:8">ती नील नदीप्रमाणे खवळेल</para>
  <para style="q2" vid="AMO 8:8">आणि मग इजिप्तच्या नदीप्रमाणे बुडून जाईल.<verse eid="AMO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9"/>“त्या दिवशी,” सार्वभौम याहवेह घोषणा करतात,</para>
  <para style="q1" vid="AMO 8:9">“दुपारच्या वेळी मी सूर्यास्त करेन</para>
  <para style="q2" vid="AMO 8:9">आणि भरदिवसा पृथ्वीला अंधकारमय करेन.<verse eid="AMO 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10"/>मी तुमचे धार्मिक उत्सव शोकामध्ये उलटवेन</para>
  <para style="q2" vid="AMO 8:10">आणि तुमची सर्व गीते विलापात बदलून टाकीन.</para>
  <para style="q1" vid="AMO 8:10">मी तुम्हा सर्वांना गोणपाट घालेन</para>
  <para style="q2" vid="AMO 8:10">आणि तुमचे मुंडण करेन.</para>
  <para style="q1" vid="AMO 8:10">मी तो काळ एकुलत्या एक मुलासाठी विलाप करण्यासारखा</para>
  <para style="q2" vid="AMO 8:10">आणि त्याचा शेवट कडू दिवसासारखा करेन.<verse eid="AMO 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11"/>“असे दिवस येत आहेत,” सार्वभौम याहवेह घोषित करतात,</para>
  <para style="q2" vid="AMO 8:11">“मी देशावर दुष्काळ आणेन—</para>
  <para style="q1" vid="AMO 8:11">तो अन्नाचा दुष्काळ किंवा पाण्याची तहान नव्हे,</para>
  <para style="q2" vid="AMO 8:11">तर याहवेहचे वचन ऐकण्याचा दुष्काळ पाडेन—<verse eid="AMO 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12"/>आणि लोक याहवेहच्या वचनाच्या शोधात</para>
  <para style="q2" vid="AMO 8:12">समुद्रापासून समुद्रापर्यंत</para>
  <para style="q1" vid="AMO 8:12">आणि उत्तरेपासून पूर्वेकडे भटकतील,</para>
  <para style="q2" vid="AMO 8:12">पण त्यांना ते सापडणार नाही.<verse eid="AMO 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13"/>“त्या दिवसात</para>
  <para style="q1" vid="AMO 8:13">“तहानेने व्याकूळ होऊन सुंदर कुमारी</para>
  <para style="q2" vid="AMO 8:13">आणि उमदे तरुण निस्तेज होऊन जातील.<verse eid="AMO 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14"/>जे शोमरोनच्या पापाची शपथ घेतात;</para>
  <para style="q2" vid="AMO 8:14">जे म्हणतात, ‘हे दान, तुझ्या दैवतेची शपथ’</para>
  <para style="q2" vid="AMO 8:14">किंवा ‘बेअर-शेबाच्या दैवतेची<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मार्गाची</char></note> शपथ,’—</para>
  <para style="q2" vid="AMO 8:14">ते असे पडतील की पुन्हा कधीही उठणार नाहीत.”<verse eid="AMO 8:14"/></para>
  <chapter eid="AMO 8"/>
  <chapter number="9" style="c" sid="AMO 9"/>
  <para style="s1">इस्राएलचा नाश करण्यात येईल</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1"/>मी प्रभूला वेदीजवळ उभे असलेले पाहिले आणि ते म्हणाले:</para>
  <para style="q1" vid="AMO 9:1">“खांबांच्या वरच्या भागावर प्रहार करा</para>
  <para style="q2" vid="AMO 9:1">म्हणजे उंबरठे हलतील.</para>
  <para style="q1" vid="AMO 9:1">आणि ते सर्व लोकांच्या डोक्यावर खाली पाड;</para>
  <para style="q2" vid="AMO 9:1">जे त्यातून वाचतील त्यांना मी तलवारीने मारून टाकीन.</para>
  <para style="q1" vid="AMO 9:1">एक सुद्धा वाचणार नाही,</para>
  <para style="q2" vid="AMO 9:1">कोणीही निसटणार नाही.<verse eid="AMO 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2"/>खोल खणीत ते अधोलोकापर्यंत जाऊन पोहोचले,</para>
  <para style="q2" vid="AMO 9:2">तरी तिथे जाऊन माझ्या हात त्यांना वर ओढून आणेन;</para>
  <para style="q1" vid="AMO 9:2">वर चढत ते आकाशापर्यंत आले,</para>
  <para style="q2" vid="AMO 9:2">तरी तिथूनही मी त्यांना खाली आणेन.<verse eid="AMO 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3"/>कर्मेल पर्वताच्या शिखरावर ते लपून राहिले,</para>
  <para style="q2" vid="AMO 9:3">तरी मी त्यांची शिकार करून त्यांना पकडेन.</para>
  <para style="q1" vid="AMO 9:3">ते महासागराच्या तळाशी माझ्या दृष्टिआड लपून बसले तरी,</para>
  <para style="q2" vid="AMO 9:3">मी सर्पाला त्यांना चावा घेण्याची आज्ञा देईन.<verse eid="AMO 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4"/>जरी शत्रूंनी त्यांना कैद करून बंदिवासात नेले,</para>
  <para style="q2" vid="AMO 9:4">तरी मी तलवारीला त्यांना ठार मारण्याची आज्ञा देईन.</para>
  <para style="b" vid="AMO 9:4"/>
  <para style="q1" vid="AMO 9:4">“मी त्यांच्यावर माझी नजर ठेवेन</para>
  <para style="q2" vid="AMO 9:4">ती तर हानीसाठी असणार भल्यासाठी नाही.”<verse eid="AMO 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5"/>प्रभू, सेनाधीश याहवेह—</para>
  <para style="q1" vid="AMO 9:5">भूमीला स्पर्श करतात आणि ती विरघळून जाते,</para>
  <para style="q2" vid="AMO 9:5">आणि त्यामध्ये राहणारे सर्व लोक शोक करतात.</para>
  <para style="q1" vid="AMO 9:5">संपूर्ण देश नाईल नदीसारखा वर येतो</para>
  <para style="q2" vid="AMO 9:5">आणि इजिप्तच्या नदीप्रमाणे खाली बुडतो;<verse eid="AMO 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6"/>ते आकाशात आपले भव्य राजवाडे बांधतात</para>
  <para style="q2" vid="AMO 9:6">आणि त्याचा पाया पृथ्वीवर ठेवतात;</para>
  <para style="q1" vid="AMO 9:6">ते समुद्राच्या पाण्याला बोलवितात</para>
  <para style="q2" vid="AMO 9:6">आणि ते पृथ्वीच्या पृष्ठभागावर ओततात;</para>
  <para style="q2" vid="AMO 9:6">याहवेह हे त्यांचे नाव आहे.<verse eid="AMO 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7"/>“तुम्ही इस्राएली लोक</para>
  <para style="q2" vid="AMO 9:7">माझ्यासाठी कूशी लोकांसारखेच नाहीत काय?”</para>
  <para style="q2" vid="AMO 9:7">असे याहवेह घोषित करतात.</para>
  <para style="q1" vid="AMO 9:7">“मी इस्राएल लोकांना इजिप्त देशातून,</para>
  <para style="q2" vid="AMO 9:7">पलिष्ट्यांना कफतोरातून</para>
  <para style="q2" vid="AMO 9:7">आणि अरामी लोकांना कीर देशातून बाहेर काढले नाही काय?<verse eid="AMO 9:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8"/>“खचितच, सार्वभौम याहवेहची दृष्टी</para>
  <para style="q2" vid="AMO 9:8">या पापी राज्यावर आहे.</para>
  <para style="q1" vid="AMO 9:8">आणि मी त्यांचा</para>
  <para style="q2" vid="AMO 9:8">पृथ्वीच्या पृष्ठभागावरून नाश करेन;</para>
  <para style="q1" vid="AMO 9:8">तरीसुद्धा मी याकोबाच्या संतानांचा</para>
  <para style="q2" vid="AMO 9:8">कायमचा नाश करणार नाही,”</para>
  <para style="q2" vid="AMO 9:8">असे याहवेह घोषित करतात.<verse eid="AMO 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9"/>“तर पाहा, मी आज्ञा करेन</para>
  <para style="q2" vid="AMO 9:9">आणि जसे चाळणीने धान्य चाळावे</para>
  <para style="q2" vid="AMO 9:9">त्याप्रमाणे इस्राएलला</para>
  <para style="q1" vid="AMO 9:9">इतर राष्ट्रांनी चाळावे,</para>
  <para style="q2" vid="AMO 9:9">पण त्याचा एक खडाही भूमीवर पडणार नाही.<verse eid="AMO 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10"/>माझ्या लोकांतील</para>
  <para style="q2" vid="AMO 9:10">जे सर्व पापी म्हणतात,</para>
  <para style="q1" vid="AMO 9:10">‘संकटे आमच्यावर येणार नाही वा आम्हाला गाठणार नाहीत,</para>
  <para style="q2" vid="AMO 9:10">ते तलवारीने मरतील.’<verse eid="AMO 9:10"/></para>
  <para style="s1">इस्राएलचे पुनर्वसन</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11"/>“त्या दिवशी</para>
  <para style="q1" vid="AMO 9:11">“दावीदाचा पतन झालेला आश्रय मी पुनर्स्थापित करेन;</para>
  <para style="q2" vid="AMO 9:11">मी तिची तुटलेली तटबंदी दुरुस्त करेन,</para>
  <para style="q2" vid="AMO 9:11">आणि तिचे अवशेष दुरुस्त करेन—</para>
  <para style="q2" vid="AMO 9:11">आणि पूर्वीसारखीच तिची पुनर्बांधणी करेन,<verse eid="AMO 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12"/>यासाठी की त्यांनी एदोमच्या अवशेषांवर</para>
  <para style="q2" vid="AMO 9:12">व माझे नाव धारण करणार्‍या सर्व राष्ट्रांचा ताबा घ्यावा,<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">मुळात </char><char style="fqa" closed="false">जी राष्ट्रे माझे नाव धारण करतात ते माझा शोध करो</char></note>”</para>
  <para style="q2" vid="AMO 9:12">ही कार्ये करणारे याहवेह ही घोषणा करतात.<verse eid="AMO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13"/>“ते दिवस येत आहेत,” याहवेह जाहीर करतात,</para>
  <para style="q1" vid="AMO 9:13">“जेव्हा नांगरणारा कापणी करणार्‍याला</para>
  <para style="q2" vid="AMO 9:13">आणि द्राक्षे तुडविणारा बी पेरणार्‍याला मागे टाकेल.</para>
  <para style="q1" vid="AMO 9:13">नवीन द्राक्षारस पर्वतांवरून गळू लागेल</para>
  <para style="q2" vid="AMO 9:13">आणि ते सर्व टेकड्यांवरून वाहू लागेल,<verse eid="AMO 9:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14"/>मी माझ्या इस्राएली लोकांना बंदिवासातून परत आणेन.<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">माझ्या इस्राएल लोकांची समृद्धी मी परत आणेन</char></note></para>
  <para style="b" vid="AMO 9:14"/>
  <para style="q1" vid="AMO 9:14">“ते त्यांच्या उद्ध्वस्त झालेल्या नगरांची पुनर्बांधणी करून त्यात राहतील.</para>
  <para style="q2" vid="AMO 9:14">ते द्राक्षमळे लावतील आणि त्याचा द्राक्षारस पितील;</para>
  <para style="q2" vid="AMO 9:14">ते बागा लावतील आणि त्याची फळे खातील.<verse eid="AMO 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15"/>मी इस्राएलला त्यांच्या स्वतःच्या भूमीमध्ये पेरीन,</para>
  <para style="q2" vid="AMO 9:15">मी त्यांना दिलेल्या भूमीतून त्यांना पुन्हा उपटून</para>
  <para style="q2" vid="AMO 9:15">टाकण्यात येणार नाही.”</para>
  <para style="m" vid="AMO 9:15">असे याहवेह तुमचे परमेश्वर म्हणतात.<verse eid="AMO 9:15"/></para>
  <chapter eid="AMO 9"/>
</usx>
