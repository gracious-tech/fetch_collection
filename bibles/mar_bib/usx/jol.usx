<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">योएल</para>
  <para style="toc1">योएलाची भविष्यवाणी</para>
  <para style="toc2">योएल</para>
  <para style="toc3">योएल</para>
  <para style="mt1">योएलाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>पेथूएलचा पुत्र योएलकडे याहवेहचे वचन आले.<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">टोळांचे आक्रमण</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>वडिलजनहो, हे ऐका;</para>
  <para style="q2" vid="JOL 1:2">या देशात राहणारे प्रत्येकजण हे ऐको.</para>
  <para style="q1" vid="JOL 1:2">तुमच्या दिवसात किंवा</para>
  <para style="q2" vid="JOL 1:2">तुमच्या पूर्वजांच्या दिवसात असे कधी घडले होते काय?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>तुम्ही ते आपल्या लेकरांना सांगा,</para>
  <para style="q2" vid="JOL 1:3">आणि तुमच्या लेकरांनी ते त्यांच्या लेकरांना सांगावे,</para>
  <para style="q2" vid="JOL 1:3">आणि त्यांच्या लेकरांनी पुढील पिढीला सांगावे.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>कुरतडणार्‍या टोळांनी जे सोडले होते,</para>
  <para style="q2" vid="JOL 1:4">ते झुंडींनी येणार्‍या टोळांनी खाल्ले;</para>
  <para style="q1" vid="JOL 1:4">जे झुंडींनी येणार्‍या टोळांनी सोडले</para>
  <para style="q2" vid="JOL 1:4">ते खुरडत चालणार्‍या टोळांनी खाल्ले;</para>
  <para style="q1" vid="JOL 1:4">जे खुरडत चालणार्‍या टोळांनी सोडले</para>
  <para style="q2" vid="JOL 1:4">ते इतर टोळांनी खाल्ले.<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>अहो मद्यप्यांनो, जागे व्हा आणि रडा!</para>
  <para style="q2" vid="JOL 1:5">हे सर्व द्राक्षारस पिणार्‍यांनो विलाप करा;</para>
  <para style="q1" vid="JOL 1:5">नवीन द्राक्षारसाकरिता विलाप करा</para>
  <para style="q2" vid="JOL 1:5">कारण तो तुमच्या ओठातून काढून घेतला आहे.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>एक राष्ट्र माझ्या देशावर चालून आले आहे,</para>
  <para style="q2" vid="JOL 1:6">ते सैन्य बलाढ्य आणि असंख्य आहे;</para>
  <para style="q1" vid="JOL 1:6">त्यांचे दात हे सिंहाचे दात आहे,</para>
  <para style="q2" vid="JOL 1:6">त्यांचे सुळे हे सिंहिणीचे सुळे आहेत.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>त्या राष्ट्रांनी माझ्या द्राक्षवेलींची नासधूस केली आहेत</para>
  <para style="q2" vid="JOL 1:7">आणि अंजिराच्या झाडांचा नाश केला आहे.</para>
  <para style="q1" vid="JOL 1:7">त्यांनी त्याचे खोड सोलून</para>
  <para style="q2" vid="JOL 1:7">साल दूर फेकली आहे,</para>
  <para style="q2" vid="JOL 1:7">त्यांच्या फांद्या पांढर्‍या केल्या आहेत.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>जशी एक कुमारी गोणपाट नेसून</para>
  <para style="q2" vid="JOL 1:8">आपल्या तारुण्यातील प्रियकरासाठी करते, तसा तुम्हीही शोक करा.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>याहवेहच्या मंदिरात वाहण्याची</para>
  <para style="q2" vid="JOL 1:9">अन्नार्पणे व पेयार्पणे बंद झाली आहेत;</para>
  <para style="q1" vid="JOL 1:9">याहवेहसमोर सेवा करणारे याजक</para>
  <para style="q2" vid="JOL 1:9">विलाप करीत आहे.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>शेतांची धूळधाण झाली आहेत,</para>
  <para style="q2" vid="JOL 1:10">भूमी कोरडी पडली आहे;</para>
  <para style="q1" vid="JOL 1:10">धान्याचा नाश झाला आहे,</para>
  <para style="q2" vid="JOL 1:10">नवीन द्राक्षारस सुकला आहे,</para>
  <para style="q2" vid="JOL 1:10">जैतून तेल समाप्त झाले आहे.<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>अहो, शेतकर्‍यांनो, लज्जित व्हा,</para>
  <para style="q2" vid="JOL 1:11">द्राक्षमळ्यांची मशागत करणार्‍यांनो,</para>
  <para style="q1" vid="JOL 1:11">आकांत करा; गहू व जव याकरिता विलाप करा,</para>
  <para style="q2" vid="JOL 1:11">कारण शेतातील पिके नष्ट झाली आहेत.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>द्राक्षवेल वाळून गेली आहे</para>
  <para style="q2" vid="JOL 1:12">अंजिराचे झाड कोमेजले आहे;</para>
  <para style="q1" vid="JOL 1:12">डाळिंब, खजुराचे आणि सफरचंदाचे झाड;</para>
  <para style="q2" vid="JOL 1:12">शेतातील सर्व झाडे सुकून गेली आहेत.</para>
  <para style="q1" vid="JOL 1:12">खचितच लोकांचा आनंद</para>
  <para style="q2" vid="JOL 1:12">विरून गेला आहे.<verse eid="JOL 1:12"/></para>
  <para style="s1">विलापासाठी आव्हान</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>अहो याजकांनो, गोणपाट परिधान करा आणि शोक करा;</para>
  <para style="q2" vid="JOL 1:13">वेदीची सेवा करणार्‍यांनो, विलाप करा.</para>
  <para style="q1" vid="JOL 1:13">तुम्ही जी परमेश्वराची सेवा करता,</para>
  <para style="q2" vid="JOL 1:13">या, गोणपाट परिधान करीत रात्र घालावा;</para>
  <para style="q1" vid="JOL 1:13">कारण अन्नार्पणे व पेयार्पणे</para>
  <para style="q2" vid="JOL 1:13">तुमच्या परमेश्वराच्या भवनात येणे बंद झाले आहेत.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>एक पवित्र उपास जाहीर करा;</para>
  <para style="q2" vid="JOL 1:14">लोकांची एक धार्मिक सभा बोलवा.</para>
  <para style="q1" vid="JOL 1:14">वडीलजनास</para>
  <para style="q2" vid="JOL 1:14">व देशात राहणार्‍यांना</para>
  <para style="q1" vid="JOL 1:14">याहवेह तुमच्या परमेश्वराच्या भवनात बोलवा,</para>
  <para style="q2" vid="JOL 1:14">आणि याहवेहपुढे शोक करा.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>त्या दिवसाबद्दल हाय!</para>
  <para style="q2" vid="JOL 1:15">याहवेहचा दिवस जवळ आहे;</para>
  <para style="q2" vid="JOL 1:15">सर्वसमर्थापासून<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">शद्दाय</char></note> जसा नाश तसे ते येतील.<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>आपल्या डोळ्यादेखत</para>
  <para style="q2" vid="JOL 1:16">अन्न नाहीसे झाले नाही काय—</para>
  <para style="q1" vid="JOL 1:16">आमच्या परमेश्वराच्या भवनातील</para>
  <para style="q2" vid="JOL 1:16">सर्व आनंद व उल्हास गेले नाही काय?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>जमिनीच्या ढेकळांखाली</para>
  <para style="q2" vid="JOL 1:17">बीज कुजून जात आहे.</para>
  <para style="q1" vid="JOL 1:17">कोठारे उद्ध्वस्त झाली आहेत</para>
  <para style="q2" vid="JOL 1:17">आणि गोदामे मोडली आहेत,</para>
  <para style="q2" vid="JOL 1:17">कारण धान्य करपून गेले आहे.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>गुरे कशी कण्हत आहेत!</para>
  <para style="q2" vid="JOL 1:18">शेरडामेंढरांचे कळप व्याकूळ झाले आहेत,</para>
  <para style="q1" vid="JOL 1:18">कारण त्यांना चरण्यासाठी कुरणेच नाहीत;</para>
  <para style="q2" vid="JOL 1:18">मेंढ्यांचे कळप विव्हळत आहेत.<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>हे याहवेह, मी तुम्हाला हाक मारीत आहेत,</para>
  <para style="q2" vid="JOL 1:19">कारण अग्नीच्या उष्णतेने कुरणे जाळून फस्त केली आहेत,</para>
  <para style="q2" vid="JOL 1:19">आणि अग्नीने मैदानातील सर्व झाडे भस्मसात झाली आहेत.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>आणि वनपशूदेखील तुमच्याकडे आक्रोश करीत आहेत,</para>
  <para style="q2" vid="JOL 1:20">पाण्याचे झरे कोरडे पडले आहेत.</para>
  <para style="q2" vid="JOL 1:20">आणि आणि अग्नीने रानातील कुरणे होरपळून निघाली आहे.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">टोळांचे सैन्य</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>सीयोनात कर्णा वाजवा;</para>
  <para style="q2" vid="JOL 2:1">माझ्या पवित्र पर्वतावर धोक्याची घंटा वाजवा.</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">देशात राहणार्‍या प्रत्येकाचा भीतीने थरकाप होवो,</para>
  <para style="q2" vid="JOL 2:1">कारण याहवेहचा दिवस येत आहे.</para>
  <para style="q1" vid="JOL 2:1">तो अगदी हाताशी आहे—<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>तो दिवस अंधाराचा व औदासिन्याचा,</para>
  <para style="q2" vid="JOL 2:2">मेघांचा व दाट काळोखाचा दिवस.</para>
  <para style="q1" vid="JOL 2:2">जसे डोंगरावर विस्तारलेल्या पहाटेसारखा आहे</para>
  <para style="q2" vid="JOL 2:2">तसे विशाल व बलवान सैन्य चालून येत आहे,</para>
  <para style="q1" vid="JOL 2:2">यापूर्वी असे कधी झाले नव्हते,</para>
  <para style="q2" vid="JOL 2:2">नंतरही अनेक पिढ्या पुन्हा कधीच होणार नाही.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>त्यांच्यापुढे अग्नी विनाश करीत आहे,</para>
  <para style="q2" vid="JOL 2:3">त्यांच्यामागे ज्वाला पेटली आहे.</para>
  <para style="q1" vid="JOL 2:3">त्यांच्यापुढील प्रदेश एदेन बागेसारखा आहे,</para>
  <para style="q2" vid="JOL 2:3">त्यांच्यामागील प्रदेश ओसाड वाळवंट आहे—</para>
  <para style="q2" vid="JOL 2:3">त्यांच्या तावडीतून काहीच वाचू शकत नाही.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>त्यांचे स्वरूप घोड्यांप्रमाणेच आहेत;</para>
  <para style="q2" vid="JOL 2:4">आणि घोडेस्वारा प्रमाणे ते जोरात धावतात.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>रथांच्या आवाजाप्रमाणे,</para>
  <para style="q2" vid="JOL 2:5">पर्वताच्या माथ्यांवर ते उड्या मारतात,</para>
  <para style="q1" vid="JOL 2:5">भुसा भस्म करणार्‍या अग्नीप्रमाणे,</para>
  <para style="q2" vid="JOL 2:5">युद्धासाठी सज्ज झालेल्या पराक्रमी सैन्याप्रमाणे आहे.<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>त्यांच्यासमोर राष्ट्रे भयभीत होतात;</para>
  <para style="q2" vid="JOL 2:6">हे प्रत्येक चेहरा फिका पडतो.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>वीरांप्रमाणे ते हल्ला करतात;</para>
  <para style="q2" vid="JOL 2:7">सैनिकांप्रमाणे ते तटाच्या भिंती चढतात.</para>
  <para style="q1" vid="JOL 2:7">आपल्या रांगा न मोडता</para>
  <para style="q2" vid="JOL 2:7">ते सरळ आगेकूच करतात.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>ते एकमेकांना धक्काबुक्की करीत नाहीत;</para>
  <para style="q2" vid="JOL 2:8">प्रत्येकजण सरळ पुढे जातो.</para>
  <para style="q1" vid="JOL 2:8">समोर शस्त्रे असताना ते जखमी न होता</para>
  <para style="q2" vid="JOL 2:8">रांग न मोडता त्यातून पार जातात.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>शहराकडे ते धाव घेतात;</para>
  <para style="q2" vid="JOL 2:9">ते तटाच्या भिंतीवर धावतात;</para>
  <para style="q1" vid="JOL 2:9">ते चढून घरात शिरतात,</para>
  <para style="q2" vid="JOL 2:9">जणू काही खिडक्यांतून प्रवेश करणारे चोरच!<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>पृथ्वी त्यांच्यापुढे कापते</para>
  <para style="q2" vid="JOL 2:10">आणि आकाशे थरथरतात,</para>
  <para style="q1" vid="JOL 2:10">सूर्य आणि चंद्र काळवंडतात,</para>
  <para style="q2" vid="JOL 2:10">आणि तारे चमकणे सोडून देतात.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>याहवेह आपल्या सैन्यापुढे</para>
  <para style="q2" vid="JOL 2:11">गर्जना करीत चालतात;</para>
  <para style="q1" vid="JOL 2:11">त्यांचे सैन्य असंख्य आहेत,</para>
  <para style="q2" vid="JOL 2:11">आणि त्यांची आज्ञा मानणारे बलवान सैन्य आहे.</para>
  <para style="q1" vid="JOL 2:11">याहवेहचा दिवस महान आहे;</para>
  <para style="q2" vid="JOL 2:11">अति भयंकर दिवस आहे.</para>
  <para style="q2" vid="JOL 2:11">त्यास कोण सहन करू शकेल?<verse eid="JOL 2:11"/></para>
  <para style="s1">अंतःकरणे भग्न करण्यासाठी आव्हान</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>तरी आताही याहवेह म्हणतात,</para>
  <para style="q2" vid="JOL 2:12">तुम्ही आपल्या संपूर्ण अंतःकरणाने,</para>
  <para style="q2" vid="JOL 2:12">उपास, आक्रंदन व शोक करीत मजकडे परत या.<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>तुमची वस्त्रे फाडून नव्हे,</para>
  <para style="q2" vid="JOL 2:13">तर तुमचे अंतःकरण फाडा.</para>
  <para style="q1" vid="JOL 2:13">याहवेह तुमच्या परमेश्वराकडे परत या,</para>
  <para style="q2" vid="JOL 2:13">कारण ते कृपाळू व दयाळू आहेत.</para>
  <para style="q1" vid="JOL 2:13">ते मंदक्रोध आणि अधिक प्रीती करणारे आहेत,</para>
  <para style="q2" vid="JOL 2:13">आणि ते विपत्तीविषयी अनुताप करतात.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>कोण जाणो? याहवेह तुमचे परमेश्वर वळतील व अनुताप करतील</para>
  <para style="q2" vid="JOL 2:14">आणि तुमच्यासाठी एक आशीर्वाद सोडतील—</para>
  <para style="q1" vid="JOL 2:14">मग याहवेह तुमच्या परमेश्वराला</para>
  <para style="q2" vid="JOL 2:14">तुम्ही धान्यार्पण व पेयार्पण करू शकाल.<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>सीयोनात कर्णा वाजवा!</para>
  <para style="q2" vid="JOL 2:15">पवित्र उपास घोषित करा</para>
  <para style="q2" vid="JOL 2:15">पवित्र सभा बोलवा.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>लोकांना एकत्र करा,</para>
  <para style="q2" vid="JOL 2:16">सभेला पवित्र करा;</para>
  <para style="q1" vid="JOL 2:16">वडिलजनांना एकत्र आणा,</para>
  <para style="q2" vid="JOL 2:16">बालकांना आणि स्तनपान करणार्‍या अर्भकांना</para>
  <para style="q2" vid="JOL 2:16">देखील एकत्र आणा.</para>
  <para style="q1" vid="JOL 2:16">वराला त्याच्या निवासस्थानातून</para>
  <para style="q2" vid="JOL 2:16">आणि वधूला तिच्या खोलीतून बोलवा.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>याहवेहसमोर सेवा करणार्‍या याजकांनी,</para>
  <para style="q2" vid="JOL 2:17">द्वारमंडप आणि वेदी यांच्यामध्ये रडत उभे राहावे.</para>
  <para style="q1" vid="JOL 2:17">आणि त्यांनी असे म्हणावे, “हे याहवेह, तुमच्या लोकांना वाचवा,</para>
  <para style="q2" vid="JOL 2:17">आपल्या वतनाला राष्ट्रांमध्ये अप्रतिष्ठा</para>
  <para style="q2" vid="JOL 2:17">किंवा चेष्टेचे कारण होऊ देऊ नका.</para>
  <para style="q1" vid="JOL 2:17">‘त्यांचा परमेश्वर कुठे आहे?’</para>
  <para style="q2" vid="JOL 2:17">असे त्यांनी लोकांमध्ये का म्हणावे.”<verse eid="JOL 2:17"/></para>
  <para style="s1">याहवेहचे उत्तर</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>मग याहवेहने आपल्या देशासाठी ईर्ष्या<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">आवेश</char></note> धरली,</para>
  <para style="q2" vid="JOL 2:18">आणि ते आपल्या लोकांवर दया करतील.<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>याहवेहने त्यांना उत्तर दिले:</para>
  <para style="q1" vid="JOL 2:19">“मी तुम्हाला धान्य, नवा द्राक्षारस व जैतून तेल पाठवित आहे,</para>
  <para style="q2" vid="JOL 2:19">जे तुम्हाला तृप्त करण्यास भरपूर आहे;</para>
  <para style="q1" vid="JOL 2:19">पुन्हा कधीही मी तुम्हाला राष्ट्रांमध्ये</para>
  <para style="q2" vid="JOL 2:19">उपहासाचा विषय होऊ देणार नाही.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“मी उत्तरेकडील उपद्रवी टोळीस काढून त्यांना तुझ्यापासून दूर नेईन;</para>
  <para style="q2" vid="JOL 2:20">मी त्यांना होरपळून निघालेला ओसाड प्रदेशात ढकलून देईन;</para>
  <para style="q1" vid="JOL 2:20">त्याची पूर्वेचा रांग मृत समुद्रात बुडवेन</para>
  <para style="q2" vid="JOL 2:20">व पश्चिमी रांग भूमध्य समुद्रात बुडवेन.</para>
  <para style="q1" vid="JOL 2:20">आणि मग त्यांचा दुर्गंध वर जाईल;</para>
  <para style="q2" vid="JOL 2:20">त्यांचा दर्प वाढत जाईल.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">निश्चितच याहवेहने महान कार्य केले आहे!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>हे यहूदीय देशा, भिऊ नको;</para>
  <para style="q2" vid="JOL 2:21">आनंद व उल्हास करा, निश्चितच याहवेहने महान</para>
  <para style="q1" vid="JOL 2:21">कार्य केले आहेत!<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>वन्य पशूंनो तुम्ही घाबरू नका,</para>
  <para style="q2" vid="JOL 2:22">कारण रानातील कुरणे हिरवीगार होत आहेत.</para>
  <para style="q1" vid="JOL 2:22">झाडे आपली फळे देत आहेत;</para>
  <para style="q2" vid="JOL 2:22">अंजिराची झाडे आणि द्राक्षवेली पुन्हा आपले सत्व देत आहेत.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>सीयोनच्या लोकांनो, आनंद करा;</para>
  <para style="q2" vid="JOL 2:23">तुमच्या याहवेहच्या ठायी आनंद करा,</para>
  <para style="q1" vid="JOL 2:23">कारण त्यांनी शरदॠतूतील पाऊस दिला आहे</para>
  <para style="q2" vid="JOL 2:23">कारण ते विश्वासयोग्य आहेत.</para>
  <para style="q1" vid="JOL 2:23">परमेश्वर तुमच्यासाठी विपुल वृष्टी करतात,</para>
  <para style="q2" vid="JOL 2:23">शरदॠतूतील आणि वसंतॠतूतील भरपूर पाऊस पाहिल्याप्रमाणे दिला आहे.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>खळी पुन्हा गव्हाच्या उंच राशींनी भरून जातील;</para>
  <para style="q2" vid="JOL 2:24">आणि कुंडे तेलाने आणि द्राक्षारसाने ओसंडून वाहू लागतील.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“मोठे टोळ व तरुण टोळ</para>
  <para style="q2" vid="JOL 2:25">इतर टोळ व टोळांचे थवे,</para>
  <para style="q2" vid="JOL 2:25">म्हणजेच माझे मोठे सैन्य जे मी तुमच्यामध्ये पाठवले होते;</para>
  <para style="q1" vid="JOL 2:25">त्यांनी खाल्लेल्या तुमच्या वर्षांची मी भरपाई करेन.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>जोपर्यंत तुम्ही तृप्त होत नाही तोपर्यंत तुम्ही खाल,</para>
  <para style="q2" vid="JOL 2:26">ज्यांनी तुमच्यासाठी अद्भुत कार्य केले आहेत</para>
  <para style="q2" vid="JOL 2:26">त्या याहवेह तुमच्या परमेश्वराच्या नावाची तुम्ही स्तुती कराल,</para>
  <para style="q1" vid="JOL 2:26">माझे लोक पुन्हा कधीही लज्जित होणार नाहीत.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>तुम्हाला कळून येईल की मी इस्राएलमध्ये आहे,</para>
  <para style="q2" vid="JOL 2:27">आणि मीच याहवेह तुमचा परमेश्वर आहे,</para>
  <para style="q2" vid="JOL 2:27">आणि दुसरा कोणीही नाही;</para>
  <para style="q1" vid="JOL 2:27">माझे लोक पुन्हा कधीही लज्जित होणार नाहीत.<verse eid="JOL 2:27"/></para>
  <para style="s1">याहवेहचा दिवस</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“आणि त्यानंतर,</para>
  <para style="q2" vid="JOL 2:28">मी माझा आत्मा सर्व लोकांवर ओतेन.</para>
  <para style="q1" vid="JOL 2:28">तुमचे पुत्र व तुमच्या कन्या भविष्यवाणी सांगतील,</para>
  <para style="q2" vid="JOL 2:28">व तुमचे वृद्ध स्वप्ने पाहतील,</para>
  <para style="q2" vid="JOL 2:28">तुमचे तरुण दृष्टान्त पाहतील.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>माझ्या दासांवर म्हणजेच, स्त्री आणि पुरुष दोघांवरही,</para>
  <para style="q2" vid="JOL 2:29">त्या दिवसांत मी माझा आत्मा ओतेन.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>आकाशात व पृथ्वीवर,</para>
  <para style="q2" vid="JOL 2:30">रक्त व अग्नी व धुरांचे स्तंभ अशी</para>
  <para style="q2" vid="JOL 2:30">विलक्षण चिन्हे मी दाखवेन.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>याहवेहचा महान व भयंकर दिवस</para>
  <para style="q2" vid="JOL 2:31">येण्यापूर्वी सूर्य अंधकारमय व</para>
  <para style="q2" vid="JOL 2:31">चंद्र रक्तमय होईल.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>आणि प्रत्येकजण जो प्रभूच्या नावाने</para>
  <para style="q2" vid="JOL 2:32">त्यांचा धावा करेल तोच वाचेल;</para>
  <para style="q1" vid="JOL 2:32">कारण याहवेहने म्हटले आहे</para>
  <para style="q2" vid="JOL 2:32">सीयोन डोंगरावर आणि यरुशलेममध्ये</para>
  <para style="q2" vid="JOL 2:32">व जे उरलेले असतील ते वाचतील</para>
  <para style="q1" vid="JOL 2:32">आणि ज्यांना याहवेहने बोलाविले</para>
  <para style="q2" vid="JOL 2:32">ते सुद्धा तारण पावतील.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">राष्ट्रांचा न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“त्या दिवसात आणि त्या समयी जेव्हा मी यहूदाह व</para>
  <para style="q2" vid="JOL 3:1">यरुशलेम भविष्य पुनर्संचयित करेन,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>मी सर्व राष्ट्रांना एकत्र करेन</para>
  <para style="q2" vid="JOL 3:2">आणि त्यांना खाली यहोशाफाट<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">यहोशाफाट </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">याहवेह न्याय करतात</char></note> च्या खोऱ्यात आणेन.</para>
  <para style="q1" vid="JOL 3:2">त्यांनी माझ्या वतनास, माझ्या इस्राएली लोकांशी जे केले</para>
  <para style="q2" vid="JOL 3:2">त्याबद्दल मी त्यांची परीक्षा घेईन.</para>
  <para style="q1" vid="JOL 3:2">कारण त्यांनी माझ्या लोकांना राष्ट्रांमध्ये विखुरले आहे</para>
  <para style="q2" vid="JOL 3:2">आणि माझ्या देशाचे विभाजन केले आहे.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>त्यांनी माझ्या लोकांकरिता चिठ्ठ्या टाकल्या</para>
  <para style="q2" vid="JOL 3:3">आणि वेश्यांसाठी मुलांचा व्यापार केला;</para>
  <para style="q2" vid="JOL 3:3">मद्द्याकरिता आपल्या मुलींना विकले.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“अहो सोर आणि सीदोन, पलेशेथच्या शहरांनो, आता तुमच्याजवळ माझ्याविरुद्ध काय आहे? मी जे काही केले आहे त्याची परतफेड मला करीत आहात काय? तुम्ही मजवर सूड उगविण्याचा प्रयत्न करीत आहात काय? कारण मी त्वरेने उलट प्रहार करेन आणि तुमचेच कृत्य तुमच्या माथ्यावर उलटवेन. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>तुम्ही माझे रूप आणि सोने हरण केले आहे आणि माझी सर्व मोलवान भांडारे घेऊन ती तुमच्या मंदिरात<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">राजवाडे</char></note> ठेवली आहेत. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>तुम्ही यहूदीयाच्या आणि यरुशलेमच्या लोकांना त्यांच्या देशापासून दूर नेण्यासाठी यावानी लोकांना विकले.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“परंतु जिथे तुम्ही त्यास विकून पाठविले, त्या सर्व ठिकाणांहून मी त्यांना परत आणेन आणि तुम्ही जे हे सर्व केले त्याची परतफेड तुमच्या माथ्यावर फेडीन. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>मी तुमचे पुत्र व तुमच्या कन्या यहूदीयातील लोकांना विकून टाकेन आणि ते त्यांना दूरच्या शबाई लोकांस विकतील.” याहवेहने हे म्हटले आहे.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>राष्ट्रांमध्ये ही घोषणा करा:</para>
  <para style="q2" vid="JOL 3:9">युद्धासाठी सुसज्ज व्हा!</para>
  <para style="q1" vid="JOL 3:9">योद्ध्यांना आव्हान करा!</para>
  <para style="q2" vid="JOL 3:9">तुमचे सर्व लढवय्ये जवळ या आणि हल्ला करा.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>तुमचा फाळ वितळवून त्यांच्या तलवारी तयार करा</para>
  <para style="q2" vid="JOL 3:10">आणि तुमच्या कोयत्यांचे भाले बनवा.</para>
  <para style="q1" vid="JOL 3:10">दुर्बल असे म्हणो,</para>
  <para style="q2" vid="JOL 3:10">“मी सबल आहे!”<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>सभोवतालच्या राष्ट्रांनो, तुम्ही लवकर या,</para>
  <para style="q2" vid="JOL 3:11">आणि तिथे एकत्र व्हा.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">हे याहवेह, तुमचे योद्धे खाली आणा!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“राष्ट्रे जागृत व्हावी;</para>
  <para style="q2" vid="JOL 3:12">त्यांनी यहोशाफाटाच्या खोर्‍यात यावे,</para>
  <para style="q1" vid="JOL 3:12">कारण तिथे मी न्यायासनावर बसून</para>
  <para style="q2" vid="JOL 3:12">चारही बाजूंच्या सर्व राष्ट्रांचा न्याय करणार आहे.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>आता विळा चालवा,</para>
  <para style="q2" vid="JOL 3:13">कारण पीक तयार झाले आहे.</para>
  <para style="q1" vid="JOL 3:13">या, द्राक्षांचा घाणा तुडवा,</para>
  <para style="q2" vid="JOL 3:13">कारण द्राक्षकुंडे भरली आहेत</para>
  <para style="q2" vid="JOL 3:13">आणि कुंडे ओसंडून वाहत आहेत—</para>
  <para style="q2" vid="JOL 3:13">कारण त्यांची दुष्टाई फार मोठी आहे!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>निर्णयाच्या खोर्‍यात</para>
  <para style="q2" vid="JOL 3:14">लोकांची गर्दीच गर्दी आहे!</para>
  <para style="q1" vid="JOL 3:14">कारण निर्णयाच्या खोऱ्यात</para>
  <para style="q2" vid="JOL 3:14">याहवेहचा दिवस येऊन ठेपला आहे.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>सूर्य व चंद्र काळे पडतील</para>
  <para style="q2" vid="JOL 3:15">आणि तारे यापुढे प्रकाशणार नाही.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>याहवेह सीयोनातून गर्जना करतील</para>
  <para style="q2" vid="JOL 3:16">आणि यरुशलेमातून गडगडाट होईल;</para>
  <para style="q2" vid="JOL 3:16">पृथ्वी व आकाश थरथर कापतील.</para>
  <para style="q1" vid="JOL 3:16">परंतु याहवेह त्याच्या लोकांसाठी आश्रयस्थान</para>
  <para style="q2" vid="JOL 3:16">आणि इस्राएल लोकांसाठी दुर्ग असतील.<verse eid="JOL 3:16"/></para>
  <para style="s1">परमेश्वराच्या लोकांसाठी आशीर्वाद</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“तेव्हा तुम्हाला कळून येईल की</para>
  <para style="q2" vid="JOL 3:17">सीयोनात, माझ्या पवित्र पर्वतावर, राहणारा मी याहवेह तुमचा परमेश्वर आहे.</para>
  <para style="q1" vid="JOL 3:17">यरुशलेम पवित्र होईल;</para>
  <para style="q2" vid="JOL 3:17">परकीय लोक तिच्यावर पुन्हा कधीही आक्रमण करणार नाहीत.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“त्या दिवशी नवीन द्राक्षारस पर्वतांवरून पाझरेल,</para>
  <para style="q2" vid="JOL 3:18">आणि टेकड्यांवरून दूध वाहील;</para>
  <para style="q2" vid="JOL 3:18">यहूदीयातील ओहोळांची कोरडी पात्रे पाण्याने भरून वाहतील</para>
  <para style="q1" vid="JOL 3:18">आणि याहवेहच्या मंदिरातून एक झरा निघेल व तो</para>
  <para style="q2" vid="JOL 3:18">शिट्टीमच्या खोर्‍यात पाणी पुरवेल.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>इजिप्त देश उजाड होईल</para>
  <para style="q2" vid="JOL 3:19">आणि एदोम देश ओसाड होईल,</para>
  <para style="q1" vid="JOL 3:19">कारण त्यांनी यहूदीयाच्या लोकांवर अत्याचार केला</para>
  <para style="q2" vid="JOL 3:19">त्यांच्या देशात त्यांनी निर्दोष रक्त पाडले आहे.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>परंतु यहूदाह सदासर्वकाळ</para>
  <para style="q2" vid="JOL 3:20">आणि यरुशलेम पिढ्यान् पिढ्या वसलेले राहील.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>त्यांच्या निर्दोष रक्ताचा सूड न घेता मी जाईन काय?</para>
  <para style="q2" vid="JOL 3:21">नाही, मुळीच नाही.”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">याहवेह सीयोनमध्ये निवास करतात!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
