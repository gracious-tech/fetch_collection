<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">होशेय</para>
  <para style="toc1">होशेयाची भविष्यवाणी</para>
  <para style="toc2">होशेय</para>
  <para style="toc3">होशे</para>
  <para style="mt1">होशेयाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="HOS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1"/>यहूदाहचे राजे उज्जीयाह, योथाम, आहाज, हिज्कीयाह आणि इस्राएलचा राजा, योआशचा<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">येहोआश</char></note> पुत्र यरोबोअम यांच्या कारकिर्दीत बैरीचा पुत्र होशेय याच्याकडे याहवेहचे जे वचन आले ते हे:<verse eid="HOS 1:1"/></para>
  <para style="b"/>
  <para style="s1">होशेयची पत्नी व मुले</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2"/>जेव्हा याहवेहने प्रथम होशेयद्वारे बोलण्यास प्रारंभ केला, तेव्हा याहवेह त्याला म्हणाले, “जा आणि एखाद्या व्यभिचारी स्त्रीबरोबर विवाह कर आणि तिच्यापासून लेकरे जन्माला घाल. कारण हा देश एका व्यभिचारी पत्नीप्रमाणे याहवेहशी अविश्वासूपणाचा दोषी आहे.” <verse eid="HOS 1:2"/><verse number="3" style="v" sid="HOS 1:3"/>म्हणून त्याने दिब्लाइमाची कन्या गोमेर हिच्याशी विवाह केला आणि ती गरोदर राहिली. तिने त्याच्या पुत्राला जन्म दिला.<verse eid="HOS 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4"/>तेव्हा याहवेह होशेयला म्हणाले, “त्याचे नाव येज्रील ठेव, कारण मी लवकरच येहूच्या घराण्याला येज्रीलच्या रक्ताबद्दल शिक्षा देईन आणि मी इस्राएल राज्याचा शेवट करेन. <verse eid="HOS 1:4"/><verse number="5" style="v" sid="HOS 1:5"/>त्या दिवशी येज्रीलच्या खोर्‍यात मी इस्राएलचे धनुष्य मोडून टाकीन.”<verse eid="HOS 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6"/>गोमेर पुन्हा गर्भवती झाली आणि तिने कन्येला जन्म दिला. तेव्हा याहवेह होशेयला म्हणाले, “हिचे नाव लो-रुहामा<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">लो-रुहामा </char><char style="ft" closed="false">म्हणजे अप्रिय</char></note> असे ठेव, कारण येथून पुढे त्यांना क्षमा करावी अशी प्रीती मी इस्राएलवर दाखविणार नाही. <verse eid="HOS 1:6"/><verse number="7" style="v" sid="HOS 1:7"/>पण मी यहूदीयाच्या वंशावर मी प्रीती करेन; आणि मी त्यांना वाचवेन—धनुष्य, तलवार किंवा युद्ध, किंवा घोडे आणि घोडेस्वार यांच्याद्वारे नाही, परंतु मी याहवेह त्यांचा परमेश्वर, त्यांना वाचवेन.”<verse eid="HOS 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8"/>लो-रुहामाचे दूध तोडल्यावर गोमेरने आणखी एका पुत्राला जन्म दिला. <verse eid="HOS 1:8"/><verse number="9" style="v" sid="HOS 1:9"/>तेव्हा याहवेह म्हणाले, “याचे नाव लो-अम्मी<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">लो-अम्मी </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">माझे लोक नाहीत</char></note> असे ठेव, कारण तुम्ही माझे लोक नाहीत आणि मी तुमचा परमेश्वर नाही.<verse eid="HOS 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10"/>“तरीही इस्राएली लोक समुद्रकिनाऱ्यावरील वाळूप्रमाणे असंख्य असतील जी मापता येणार नाही किंवा मोजता येणार नाही, असे. ज्या ठिकाणी म्हटले होते,</para>
  <para style="q2" vid="HOS 1:10">तुम्ही माझे लोक नाहीत,</para>
  <para style="q2" vid="HOS 1:10">तिथे त्यांना जिवंत परमेश्वराची लेकरे म्हणतील <verse eid="HOS 1:10"/><verse number="11" style="v" sid="HOS 1:11"/>तेव्हा यहूदाहचे संतान व इस्राएलचे संतान एकत्र येतील; ते एक पुढारी नेमतील आणि देशातून एकत्र बाहेर येतील, कारण तो येज्रीलचा किती महान दिवस असेल.<verse eid="HOS 1:11"/></para>
  <chapter eid="HOS 1"/>
  <chapter number="2" style="c" sid="HOS 2"/>
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1"/>“तुमच्या बंधूंना, ‘माझे लोक<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">माझे लोक </char><char style="ft" closed="false">म्हणजे अम्मी</char></note>’ आणि तुमच्या भगिनींना, ‘माझी प्रिय व्यक्ती.’<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">माझी प्रिय व्यक्ती </char><char style="ft" closed="false">म्हणजे रुहामा</char></note> असे म्हणा.<verse eid="HOS 2:1"/></para>
  <para style="s1">इस्राएलास शिक्षा आणि पुनर्स्थापना</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2"/>“तुम्ही आपल्या आईला रागवा, तिला रागवाच,</para>
  <para style="q2" vid="HOS 2:2">कारण ती माझी पत्नी नाही,</para>
  <para style="q2" vid="HOS 2:2">आणि मी तिचा पती नाही.</para>
  <para style="q1" vid="HOS 2:2">ती आपल्या मुखावरून तिचे व्यभिचारी रूप</para>
  <para style="q2" vid="HOS 2:2">आणि अविश्वासूपणा तिच्या स्तनांमधून दूर करो.<verse eid="HOS 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3"/>नाही तर मी तिचे वस्त्र काढून तिला नग्न करेन,</para>
  <para style="q2" vid="HOS 2:3">जशी तिच्या जन्माच्या दिवशी ती नग्न होती;</para>
  <para style="q1" vid="HOS 2:3">तिला मी वैराण प्रदेशासारखी करेन,</para>
  <para style="q2" vid="HOS 2:3">निर्जल भूमीसारखी ठेवेन</para>
  <para style="q2" vid="HOS 2:3">व तिला तहानेने जिवे मारीन.<verse eid="HOS 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4"/>मी तिच्या मुलांच्या प्रती आपली प्रीती दाखविणार नाही,</para>
  <para style="q2" vid="HOS 2:4">कारण ती मुले व्यभिचाराची आहेत.<verse eid="HOS 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5"/>कारण त्यांची आई अविश्वासू आहे</para>
  <para style="q2" vid="HOS 2:5">आणि तिने लाजिरवाणी गोष्ट करून त्यांचे गर्भधारणा केली आहे.</para>
  <para style="q1" vid="HOS 2:5">ती म्हणाली, ‘मी माझ्या प्रियकरांच्या मागे जाईन,</para>
  <para style="q2" vid="HOS 2:5">जे मला माझे अन्न आणि माझे पाणी,</para>
  <para style="q2" vid="HOS 2:5">माझी लोकर आणि माझे ताग, माझे जैतुनाचे तेल आणि माझे पेय देतात.’<verse eid="HOS 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6"/>म्हणून मी तिच्या मार्गात काटेरी झाडांचे कुंपण घालेन;</para>
  <para style="q2" vid="HOS 2:6">मी तिच्यापुढे अशी आडभिंत उभी करेन की तिला तिच्या वाटा सापडणार नाही.<verse eid="HOS 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7"/>ती तिच्या प्रियकरांमागे धावेल, पण त्यांना गाठू शकणार नाही.</para>
  <para style="q2" vid="HOS 2:7">ती त्यांना शोधेल, पण ते तिला सापडणार नाहीत.</para>
  <para style="q1" vid="HOS 2:7">मग ती म्हणेल,</para>
  <para style="q2" vid="HOS 2:7">‘मी आता माझ्या पहिल्या पतीकडे परत जाईन,</para>
  <para style="q2" vid="HOS 2:7">कारण माझी परिस्थिती सध्यापेक्षा तेव्हा चांगली होती.’<verse eid="HOS 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8"/>तिने ओळखले नाही की, तो मीच होतो</para>
  <para style="q2" vid="HOS 2:8">ज्याने तिला धान्य, नवीन द्राक्षारस आणि तेल दिले,</para>
  <para style="q1" vid="HOS 2:8">ज्याने उदारहस्ते तिला चांदी आणि सोने दिले;</para>
  <para style="q2" vid="HOS 2:8">जे त्यांनी बआलसाठी वापरले.<verse eid="HOS 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9"/>“म्हणून जेव्हा माझे धान्य पिकेल मी ते काढून घेईन,</para>
  <para style="q2" vid="HOS 2:9">आणि माझा नवीन द्राक्षारस तयार होईल तेव्हा तो काढून घेईन.</para>
  <para style="q1" vid="HOS 2:9">तिचे नग्न शरीर झाकण्यासाठी,</para>
  <para style="q2" vid="HOS 2:9">मी माझी लोकर आणि माझी तागाची वस्त्रे दिली होती ती परत घेईन.<verse eid="HOS 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10"/>म्हणून मी आता तिची अश्लीलता</para>
  <para style="q2" vid="HOS 2:10">तिच्या प्रियकरांसमोर उघडी करेन;</para>
  <para style="q2" vid="HOS 2:10">माझ्या हातून तिला कोणीही वाचवू शकणार नाही.<verse eid="HOS 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11"/>मी तिचे सर्व उत्सव:</para>
  <para style="q2" vid="HOS 2:11">तिचे वार्षिक सण, तिचे नवीन चंद्रदर्शन,</para>
  <para style="q2" vid="HOS 2:11">तिचे शब्बाथाचे दिवस—नेमून दिलेले तिचे सर्व सण बंद करेन.<verse eid="HOS 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12"/>मी तिच्या द्राक्षमळ्यांचा व अंजिराच्या झाडांचा नाश करेन,</para>
  <para style="q2" vid="HOS 2:12">जो तिच्या प्रियकरांनी तिला वेतन म्हणून दिला होता, असे तिचे म्हणणे आहे;</para>
  <para style="q1" vid="HOS 2:12">मी त्यांचे गर्द झाडी करेन</para>
  <para style="q2" vid="HOS 2:12">व वनपशू ते खाऊन टाकतील.<verse eid="HOS 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13"/>जेव्हा तिने बआलसाठी धूप जाळला,</para>
  <para style="q2" vid="HOS 2:13">तिला मी त्या दिवसांसाठी शिक्षा करेन;</para>
  <para style="q1" vid="HOS 2:13">तिने स्वतःला अंगठ्यांनी आणि दागिन्यांनी सजविले,</para>
  <para style="q2" vid="HOS 2:13">आणि तिच्या प्रियकरांच्या मागे गेली,</para>
  <para style="q2" vid="HOS 2:13">परंतु मला मात्र ती विसरून गेली,” असे याहवेह घोषित करतात.<verse eid="HOS 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14"/>“म्हणून तिला मी भुलविणार;</para>
  <para style="q2" vid="HOS 2:14">तिला रानात घेऊन जाईन</para>
  <para style="q2" vid="HOS 2:14">आणि तिच्याबरोबर कोमलतेने बोलेन.<verse eid="HOS 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15"/>तिथे मी तिला तिचे द्राक्षमळे परत करेन,</para>
  <para style="q2" vid="HOS 2:15">आणि अखोरचे खोरे<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">दुःखाची दरी</char></note> तिला आशेचे द्वार असे देईन.</para>
  <para style="q1" vid="HOS 2:15">जेव्हा ती इजिप्तमधून बाहेर आली, तिच्या तारुण्याच्या दिवसात</para>
  <para style="q2" vid="HOS 2:15">जसे उत्तर देत होती तसेच उत्तर<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">गीत गाईल</char></note> देईल.<verse eid="HOS 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16"/>“त्या दिवशी, तुम्ही मला ‘माझा पती’ असे म्हणाल;</para>
  <para style="q2" vid="HOS 2:16">यापुढे तुम्ही मला ‘माझे बआल<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">धनी</char></note>’ असे म्हणणार नाही,</para>
  <para style="q2" vid="HOS 2:16">याहवेह असे घोषित करतात.<verse eid="HOS 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17"/>मी तिच्या मुखातून बआलची नावे काढून टाकीन;</para>
  <para style="q2" vid="HOS 2:17">यापुढे त्यांची नावे कधीही घेतली जाणार नाही.<verse eid="HOS 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18"/>त्या दिवशी मी त्यांच्यासाठी</para>
  <para style="q2" vid="HOS 2:18">रानातील पशू, आकाशातील पक्षी</para>
  <para style="q2" vid="HOS 2:18">आणि भूमीवर सरपटणारे यांच्यामध्ये मी करार घडवून आणेन.</para>
  <para style="q1" vid="HOS 2:18">धनुष्य आणि तलवार आणि लढाया</para>
  <para style="q2" vid="HOS 2:18">मी देशातून काढून टाकेन,</para>
  <para style="q2" vid="HOS 2:18">म्हणजे तुम्ही सर्वजण सुरक्षितपणे विश्राम कराल.<verse eid="HOS 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19"/>मी तुला माझ्याबरोबर कायमचे वाग्दत्त असे करेन;</para>
  <para style="q2" vid="HOS 2:19">मी तुम्हाला नीतिमत्व आणि न्याय,</para>
  <para style="q2" vid="HOS 2:19">प्रीती आणि करुणा यामध्ये वाग्दत्त करेन.<verse eid="HOS 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20"/>विश्वासूपणाने तुला वाग्दत्त करून घेईन,</para>
  <para style="q2" vid="HOS 2:20">आणि याहवेहची ओळख तुला होईल.<verse eid="HOS 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21"/>“त्या दिवशी मी प्रतिसाद देईन;</para>
  <para style="q2" vid="HOS 2:21">मी आकाशाला प्रतिसाद देईन</para>
  <para style="q1" vid="HOS 2:21">आणि ते पृथ्वीला प्रतिसाद देतील;”</para>
  <para style="q2" vid="HOS 2:21">याहवेह अशी घोषणा करतात.<verse eid="HOS 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22"/>“आणि पृथ्वी धान्य, नवीन द्राक्षारस आणि जैतून तेल</para>
  <para style="q2" vid="HOS 2:22">यांना प्रतिसाद देईल,</para>
  <para style="q2" vid="HOS 2:22">आणि ते येज्रीलास<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">परमेश्वर रोपण करतात</char></note> प्रतिसाद देतील.<verse eid="HOS 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23"/>मी तिची माझ्यासाठी देशात पेरणी करेन;</para>
  <para style="q2" vid="HOS 2:23">‘माझी प्रिया नाही<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">मूळ भाषेत </char><char style="fqa" closed="false">लो-रुहामाह</char></note>’ असे मी ज्यांना म्हटले त्याला मी माझी प्रीती दाखवेन.</para>
  <para style="q1" vid="HOS 2:23">जे ‘माझे लोक नाहीत,<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">मूळ भाषेत </char><char style="fqa" closed="false">लो-अम्मी</char></note>’ असे म्हटले त्यांना ‘तुम्ही माझे लोक आहात’ असे म्हणेन;</para>
  <para style="q2" vid="HOS 2:23">आणि ते म्हणतील, ‘तुम्ही आमचे परमेश्वर आहात.’ ”<verse eid="HOS 2:23"/></para>
  <chapter eid="HOS 2"/>
  <chapter number="3" style="c" sid="HOS 3"/>
  <para style="s1">होशेयचा आपल्या पत्नीशी समेट</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1"/>मग याहवेह मला म्हणाले, “जा आणि आपल्या पत्नीस आपली प्रीती पुनः प्रकट कर, जरी तिला दुसरा कोणता पुरुष प्रीती करतो आणि ती एक व्यभिचारिणी आहे. जरी ते इतर दैवतांकडे वळले असून पवित्र मनुकांच्या ढेपांची आवड धरतात, तरी याहवेह इस्राएली लोकांवर प्रीती करतात.”<verse eid="HOS 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2"/>तेव्हा मी तिच्या सुटकेसाठी चांदीची पंधरा शेकेल<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">अंदाजे 170 ग्रॅ.</char></note> व एक होमेर व एक लेथेक<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">अंदाजे 195 कि.ग्रॅ.</char></note> जव देऊन तिला विकत घेतले. <verse eid="HOS 3:2"/><verse number="3" style="v" sid="HOS 3:3"/>मग मी तिला म्हणालो, “तुला अनेक दिवस माझ्याबरोबर राहवयाचे आहे; जारकर्म करू नकोस अथवा इतर पुरुषांकडे जाऊ नकोस, आणि मीही तुझ्यासोबत तसाच वागेन.”<verse eid="HOS 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4"/>कारण दीर्घकाळापर्यंत इस्राएली लोक राजा अथवा राजपुत्र, यज्ञ अथवा पवित्र दगड, एफोद अथवा कुलदैवतांशिवाय राहतील. <verse eid="HOS 3:4"/><verse number="5" style="v" sid="HOS 3:5"/>त्यानंतर इस्राएली लोक परत येतील आणि याहवेह त्यांच्या परमेश्वराला आणि त्यांचा राजा दावीदाचा शोध घेतील. अखेरच्या काळात याहवेहकडे ते थरथर कापत आणि त्यांच्या आशीर्वादासाठी येतील.<verse eid="HOS 3:5"/></para>
  <chapter eid="HOS 3"/>
  <chapter number="4" style="c" sid="HOS 4"/>
  <para style="s1">इस्राएलविरुद्ध केलेले आरोप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1"/>इस्राएली लोकहो, याहवेहचे वचन ऐका.</para>
  <para style="q2" vid="HOS 4:1">या देशात राहणार्‍यांवर</para>
  <para style="q2" vid="HOS 4:1">याहवेहचा आरोप आहे:</para>
  <para style="q1" vid="HOS 4:1">या देशात विश्वासूपणा नाही,</para>
  <para style="q2" vid="HOS 4:1">प्रीती नाही, परमेश्वराप्रती ज्ञान नाही.<verse eid="HOS 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2"/>या ठिकाणी फक्त शाप, खोटे बोलणे आणि खून,</para>
  <para style="q2" vid="HOS 4:2">चोरी आणि व्यभिचार आहे;</para>
  <para style="q1" vid="HOS 4:2">सर्व सीमाबंदी ते मोडून टाकतात,</para>
  <para style="q2" vid="HOS 4:2">आणि रक्तपातानंतर रक्तपात होतो.<verse eid="HOS 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3"/>म्हणूनच तुमची भूमी कोरडी पडत आहे,</para>
  <para style="q2" vid="HOS 4:3">येथे राहणारे सर्व नाश पावत आहे;</para>
  <para style="q1" vid="HOS 4:3">रान पशू, आकाशातील पक्षी</para>
  <para style="q2" vid="HOS 4:3">आणि समुद्रातील मासे नाहीसे होत आहेत.<verse eid="HOS 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4"/>परंतु कोणीही आरोप करू नका,</para>
  <para style="q2" vid="HOS 4:4">तुम्ही इतरांवर आळ घेऊ नका,</para>
  <para style="q1" vid="HOS 4:4">कारण तुमचे लोक असे आहेत</para>
  <para style="q2" vid="HOS 4:4">जे याजकांवर दोष लावतात.<verse eid="HOS 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5"/>तुम्ही दिवस व रात्र अडखळता,</para>
  <para style="q2" vid="HOS 4:5">आणि संदेष्टेही तुमच्याबरोबर अडखळतात.</para>
  <para style="q1" vid="HOS 4:5">म्हणून मी तुमच्या आईचा नाश करेन—<verse eid="HOS 4:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6"/>ज्ञान नसल्यामुळे माझ्या लोकांचा नाश होत आहे,</para>
  <para style="b" vid="HOS 4:6"/>
  <para style="q1" vid="HOS 4:6">“कारण, तुम्ही ज्ञानाला नाकारले आहे,</para>
  <para style="q2" vid="HOS 4:6">म्हणून मी तुम्हाला माझे याजक म्हणून नाकारत आहे;</para>
  <para style="q1" vid="HOS 4:6">कारण तुम्ही तुमच्या परमेश्वराच्या नियमांकडे दुर्लक्ष केले आहे,</para>
  <para style="q2" vid="HOS 4:6">म्हणून मी सुद्धा तुमच्या मुलांकडे दुर्लक्ष करेन.<verse eid="HOS 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7"/>जितकी याजकांची संख्या वाढत गेली,</para>
  <para style="q2" vid="HOS 4:7">तितकी अधिक पापे त्यांनी माझ्याविरुद्ध केली;</para>
  <para style="q2" vid="HOS 4:7">त्यांच्या वैभवशाली परमेश्वराच्या बदल्यात<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मी त्यांचे वैभव बदलेन</char></note> त्यांनी लाजिरवाणी गोष्ट स्वीकारली.<verse eid="HOS 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8"/>माझ्या लोकांच्या पापांवर ते पोषण करतात</para>
  <para style="q2" vid="HOS 4:8">आणि त्यांच्या दुष्टतेचा आनंद घेतात.<verse eid="HOS 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9"/>आणि असे होईल की: जसे लोक तसे याजक होतील.</para>
  <para style="q2" vid="HOS 4:9">मी दोघांनाही त्यांच्या आचरणामुळे शासन करेन</para>
  <para style="q2" vid="HOS 4:9">आणि त्यांच्या कृत्यांसाठी त्यांना परतफेड करेन.<verse eid="HOS 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10"/>“ते खातील परंतु ते तृप्त होणार नाहीत;</para>
  <para style="q2" vid="HOS 4:10">ते व्यभिचार करतील परंतु त्यांची भरभराट होणार नाही,</para>
  <para style="q1" vid="HOS 4:10">कारण त्यांनी याहवेहचा त्याग केला आहे</para>
  <para style="q2" vid="HOS 4:10">आणि स्वतःस वेश्या व्यवसायास सोपविले आहे. <verse eid="HOS 4:10"/><verse number="11" style="v" sid="HOS 4:11"/>जुना द्राक्षारस</para>
  <para style="q1" vid="HOS 4:11">आणि नवीन द्राक्षारस</para>
  <para style="q2" vid="HOS 4:11">त्यांचा समंजसपणा दूर करतात.<verse eid="HOS 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12"/>माझे लोक लाकडी मूर्तींचा सल्ला घेतात</para>
  <para style="q2" vid="HOS 4:12">आणि दैवप्रश्न करणाऱ्यांची काठी त्यांचे भविष्य सांगते.</para>
  <para style="q1" vid="HOS 4:12">व्यभिचाराचा आत्मा त्यांना भरकटवितो;</para>
  <para style="q2" vid="HOS 4:12">ते त्यांच्या परमेश्वराला विश्वासू राहिले नाहीत.<verse eid="HOS 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13"/>एला वृक्ष, हिवर आणि एला या झाडांखाली,</para>
  <para style="q2" vid="HOS 4:13">जिथे सुखदायक सावली असते</para>
  <para style="q1" vid="HOS 4:13">तिथे पर्वतांच्या शिखरांवर यज्ञ करतात</para>
  <para style="q2" vid="HOS 4:13">आणि टेकड्यांवर ते होमार्पण करतात.</para>
  <para style="q1" vid="HOS 4:13">म्हणून तुमच्या कन्या वेश्याव्यवसायाकडे वळतात</para>
  <para style="q2" vid="HOS 4:13">आणि तुमच्या सुना व्यभिचार करतात.<verse eid="HOS 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14"/>“जेव्हा त्या वेश्याव्यवसायाकडे वळतात,</para>
  <para style="q2" vid="HOS 4:14">अथवा तुमच्या सुना</para>
  <para style="q1" vid="HOS 4:14">त्या व्यभिचार करतात,</para>
  <para style="q2" vid="HOS 4:14">मी तुमच्या कन्यांना शासन करणार नाही,</para>
  <para style="q1" vid="HOS 4:14">कारण पुरुष स्वतः वेश्यांबरोबर सहवास करतात</para>
  <para style="q2" vid="HOS 4:14">आणि पवित्र स्थळी असलेल्या देवदासींबरोबर बलिदान करतात—</para>
  <para style="q2" vid="HOS 4:14">समंजसपणा नसलेल्या लोकांचा नाश होईल!<verse eid="HOS 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15"/>“हे इस्राएला, जरी तू व्यभिचार केला आहेस,</para>
  <para style="q2" vid="HOS 4:15">तरी यहूदाहला दोषी होऊ देऊ नकोस.</para>
  <para style="b" vid="HOS 4:15"/>
  <para style="q1" vid="HOS 4:15">“गिलगालकडे जाऊ नका;</para>
  <para style="q2" vid="HOS 4:15">वर बेथ-आवेन<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="fqa" closed="false">बेथ-अव्हेन </char><char style="ft" closed="false">दुष्टतेचे घर </char><char style="ft" closed="false">बेथेल </char><char style="fqa" closed="false">परमेश्वराचे घर याचे अपमानास्पद नाव</char></note> येथे जाऊ नका.</para>
  <para style="q2" vid="HOS 4:15">आणि ‘याहवेहच्या जीविताची शपथ!’ अशी शपथ घेऊ नका.<verse eid="HOS 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16"/>जशी कालवड हट्टी असते,</para>
  <para style="q2" vid="HOS 4:16">तसे इस्राएली लोक हट्टी आहेत.</para>
  <para style="q1" vid="HOS 4:16">मग जशी कोकरे कुरणात चरतात,</para>
  <para style="q2" vid="HOS 4:16">त्याप्रमाणे याहवेह त्यांना कुरणात कसे नेतील?<verse eid="HOS 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17"/>एफ्राईम मूर्तीबरोबर जोडले गेले आहे,</para>
  <para style="q2" vid="HOS 4:17">त्याला एकटे सोडून द्या!<verse eid="HOS 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18"/>जेव्हा त्यांचे मद्य संपते तेव्हा सुद्धा,</para>
  <para style="q2" vid="HOS 4:18">ते त्यांचा वेश्याव्यवसाय चालू ठेवतात;</para>
  <para style="q2" vid="HOS 4:18">त्यांचे शासक लज्जास्पद कृतिंवर अधिक प्रीती करतात.<verse eid="HOS 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19"/>एक वावटळ त्यांना वाहून नेईल,</para>
  <para style="q2" vid="HOS 4:19">आणि त्यांच्या अर्पणांमुळे त्यांना लाज वाटेल.<verse eid="HOS 4:19"/></para>
  <chapter eid="HOS 4"/>
  <chapter number="5" style="c" sid="HOS 5"/>
  <para style="s1">इस्राएलविरुद्ध न्याय</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1"/>“तुम्ही याजकांनो, हे ऐका!</para>
  <para style="q2" vid="HOS 5:1">अहो इस्राएलाच्या घराण्यांनो, लक्ष द्या!</para>
  <para style="q1" vid="HOS 5:1">राजघराणे, ऐका!</para>
  <para style="q2" vid="HOS 5:1">हा न्याय तुमच्याविरुद्ध आहे:</para>
  <para style="q1" vid="HOS 5:1">मिस्पाह येथे तुम्ही पाश झाला आहात,</para>
  <para style="q2" vid="HOS 5:1">ताबोरावर पसरलेले जाळे झाले आहात.<verse eid="HOS 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2"/>बंडखोरांनी भयंकर कत्तल केली आहे,</para>
  <para style="q2" vid="HOS 5:2">मी त्या सर्वांना शिस्त लावेन.<verse eid="HOS 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3"/>एफ्राईमाबद्दल मला सर्वकाही माहीत आहे;</para>
  <para style="q2" vid="HOS 5:3">इस्राएल माझ्यापासून लपलेले नाही.</para>
  <para style="q1" vid="HOS 5:3">हे एफ्राईमा, तू आता वेश्याव्यवसायाकडे वळला आहेस;</para>
  <para style="q2" vid="HOS 5:3">इस्राएल भ्रष्ट झालेला आहे.<verse eid="HOS 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4"/>“त्यांची कर्मे त्यांना पुन्हा</para>
  <para style="q2" vid="HOS 5:4">त्यांच्या परमेश्वराकडे येऊ देत नाहीत.</para>
  <para style="q1" vid="HOS 5:4">वेश्यावृत्तीचा आत्मा त्यांच्या अंतःकरणात आहे;</para>
  <para style="q2" vid="HOS 5:4">ते याहवेहला ओळखत नाहीत.<verse eid="HOS 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5"/>इस्राएलचा उन्मत्तपणाच त्यांच्याविरुद्ध साक्ष देतो;</para>
  <para style="q2" vid="HOS 5:5">इस्राएल आणि एफ्राईम सुद्धा आपल्या पापात अडखळतात;</para>
  <para style="q2" vid="HOS 5:5">यहूदीया देखील त्यांच्यासोबत अडखळतो.<verse eid="HOS 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6"/>जेव्हा ते आपले मेंढरांचे व गुरांचे कळप घेऊन</para>
  <para style="q2" vid="HOS 5:6">याहवेहच्या शोधात फिरतील,</para>
  <para style="q1" vid="HOS 5:6">ते त्यांना सापडणार नाही;</para>
  <para style="q2" vid="HOS 5:6">कारण त्यांनी स्वतःला त्यांच्यापासून दूर केले आहेत.<verse eid="HOS 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7"/>ते याहवेहशी अविश्वासू राहिले;</para>
  <para style="q2" vid="HOS 5:7">ते अनौरस लेकरांना जन्म देतात.</para>
  <para style="q1" vid="HOS 5:7">जेव्हा ते अमावस्येचा उत्सव साजरा करतील,</para>
  <para style="q2" vid="HOS 5:7">तेव्हा ते त्यांच्या शेताला गिळून<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">नाश करतील</char></note> टाकतील.<verse eid="HOS 5:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8"/>“तुम्ही गिबियाहात शिंग फुंका,</para>
  <para style="q2" vid="HOS 5:8">रामाह येथे कर्णा वाजवा.</para>
  <para style="q1" vid="HOS 5:8">बेथ-आवेन येथे उंच आवाजात युद्धाची घोषणा करा;</para>
  <para style="q2" vid="HOS 5:8">बिन्यामीन आमचे नेतृत्व करा.<verse eid="HOS 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9"/>एफ्राईम शासनाच्या</para>
  <para style="q2" vid="HOS 5:9">दिवशी ओसाड पडेल.</para>
  <para style="q1" vid="HOS 5:9">इस्राएली गोत्रात जे निश्चितच होणार</para>
  <para style="q2" vid="HOS 5:9">त्याची घोषणा करणार.<verse eid="HOS 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10"/>यहूदाहचे पुढारी</para>
  <para style="q2" vid="HOS 5:10">सीमारेषांचे दगड हालविणारे झाले आहेत.</para>
  <para style="q1" vid="HOS 5:10">एखाद्या जलप्रलयाप्रमाणे</para>
  <para style="q2" vid="HOS 5:10">मी माझा संताप त्यांच्यावर ओतेन.<verse eid="HOS 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11"/>एफ्राईम चिरडला गेला आहे,</para>
  <para style="q2" vid="HOS 5:11">न्यायात चेंगरलेला आहे.</para>
  <para style="q2" vid="HOS 5:11">कारण मूर्तीच्या मागे जाण्याचा त्याचा निश्चय आहे.<verse eid="HOS 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12"/>एफ्राईमाला मी कसर,</para>
  <para style="q2" vid="HOS 5:12">आणि यहूदाहसाठी सडीचा रोग आहे.<verse eid="HOS 5:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13"/>“ज्यावेळी एफ्राईमने त्याचा आजार पाहिला,</para>
  <para style="q2" vid="HOS 5:13">आणि यहूदाहने त्याची जखम पाहिली,</para>
  <para style="q1" vid="HOS 5:13">तेव्हा एफ्राईम अश्शूराकडे वळला,</para>
  <para style="q2" vid="HOS 5:13">आणि महान राजाकडे मदतीसाठी विनंती केली.</para>
  <para style="q1" vid="HOS 5:13">परंतु तो तुला बरे करू शकत नाही,</para>
  <para style="q2" vid="HOS 5:13">तुझ्या जखमाही बर्‍या करू शकत नाही.<verse eid="HOS 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14"/>कारण मी एफ्राईमला एखाद्या सिंहासारखा,</para>
  <para style="q2" vid="HOS 5:14">व यहूदाहला मोठ्या सिंहासारखा होईन.</para>
  <para style="q1" vid="HOS 5:14">मी त्यांना फाडून टाकीन आणि दूर निघून जाईन;</para>
  <para style="q2" vid="HOS 5:14">मी त्यांना घेऊन जाईन आणि त्यांना सोडविणारा कोणीही नसेल.<verse eid="HOS 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15"/>ते आपला अपराध कबूल करेपर्यंत</para>
  <para style="q2" vid="HOS 5:15">व साहाय्यासाठी माझे मुख पुन्हा शोधेपर्यंत</para>
  <para style="q2" vid="HOS 5:15">मी आपल्या गुहेत परत जाईन—</para>
  <para style="q1" vid="HOS 5:15">कारण संकट आल्याबरोबर,</para>
  <para style="q2" vid="HOS 5:15">ते माझा शोध कळकळीने करतील.”<verse eid="HOS 5:15"/></para>
  <chapter eid="HOS 5"/>
  <chapter number="6" style="c" sid="HOS 6"/>
  <para style="s1">लोकांचा खोटा पश्चात्ताप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1"/>“चला, आपण याहवेहकडे परत जाऊ.</para>
  <para style="q1" vid="HOS 6:1">त्यांनी आम्हाला फाडले आहे,</para>
  <para style="q2" vid="HOS 6:1">व तेच आम्हाला बरे करतील;</para>
  <para style="q1" vid="HOS 6:1">त्यांनी आम्हाला जखम केली आहे,</para>
  <para style="q2" vid="HOS 6:1">व आता तेच पट्टी बांधतील.<verse eid="HOS 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2"/>ते आम्हाला दोन दिवसात पुनरुज्जीवन देतील;</para>
  <para style="q2" vid="HOS 6:2">तिसर्‍या दिवशी ते आम्हाला पुनर्स्थापित करतील,</para>
  <para style="q2" vid="HOS 6:2">जेणेकरून आपण त्यांच्या उपस्थितीत जिवंत राहू शकू.<verse eid="HOS 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3"/>चला, याहवेहचा आपण स्वीकार करू या;</para>
  <para style="q2" vid="HOS 6:3">चला, त्यांचा स्वीकार करण्यास आपण झटू या.</para>
  <para style="q1" vid="HOS 6:3">सूर्याचे उगविणे जसे निश्चित आहे,</para>
  <para style="q2" vid="HOS 6:3">तसेच त्यांचे प्रकट होणे निश्चित आहे;</para>
  <para style="q1" vid="HOS 6:3">हिवाळ्यातील पावसाप्रमाणे,</para>
  <para style="q2" vid="HOS 6:3">पृथ्वीला सिंचन घालणाऱ्या वसंतऋतूप्रमाणे ते आमच्याकडे येतील.”<verse eid="HOS 6:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4"/>“एफ्राईमा मी तुमचे काय करू?</para>
  <para style="q2" vid="HOS 6:4">यहूदाह मी तुमचे काय करू?</para>
  <para style="q1" vid="HOS 6:4">कारण तुमची प्रीती सकाळच्या ढगांप्रमाणे,</para>
  <para style="q2" vid="HOS 6:4">पहाटेच्या दवबिंदूप्रमाणे नाहीशी होते.<verse eid="HOS 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5"/>म्हणून माझ्या संदेष्ट्याद्वारे मी तुमचे तुकडे केले आहे,</para>
  <para style="q2" vid="HOS 6:5">माझ्या मुखाच्या शब्दांनी तुम्हाला ठार केले—</para>
  <para style="q2" vid="HOS 6:5">तेव्हा माझ्या न्याय सूर्याच्या प्रकाशाप्रमाणे पुढे वाढत जातो.<verse eid="HOS 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6"/>कारण मला तुमची अर्पणे नव्हे, तर दया हवी आहे,</para>
  <para style="q2" vid="HOS 6:6">आणि होमार्पण पेक्षा परमेश्वराचे ज्ञान प्रिय आहे.<verse eid="HOS 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7"/>आदामाप्रमाणे तुम्ही माझा करार मोडला आहे;</para>
  <para style="q2" vid="HOS 6:7">तिथे ते माझ्याशी अविश्वासूपणे वागले होते.<verse eid="HOS 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8"/>गिलआद हे दुष्कर्म करणारे शहर आहे,</para>
  <para style="q2" vid="HOS 6:8">त्यावर रक्ताची पावले उमटली आहेत.<verse eid="HOS 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9"/>जसे लुटारू बळी पडणाऱ्याची वाट पाहत दबा धरून बसतात,</para>
  <para style="q2" vid="HOS 6:9">तसेच याजकांच्या टोळ्या</para>
  <para style="q1" vid="HOS 6:9">शेखेमाच्या वाटेवर वध करतात,</para>
  <para style="q2" vid="HOS 6:9">ते आपल्या दुष्ट योजना पूर्ण करतात.<verse eid="HOS 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10"/>मी इस्राएलमध्ये एक भयानक गोष्ट पाहिली आहे:</para>
  <para style="q2" vid="HOS 6:10">एफ्राईम वेश्याव्यवसाय करण्यास दिला आहे,</para>
  <para style="q2" vid="HOS 6:10">इस्राएल अपवित्र झाला आहे.<verse eid="HOS 6:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11"/>“हे यहूदाह, तुझ्यासाठी</para>
  <para style="q2" vid="HOS 6:11">हंगामाची वेळ नेमलेली आहे.</para>
  <para style="b" vid="HOS 6:11"/>
  <para style="q1" vid="HOS 6:11">“जेव्हा मी माझ्या लोकांना जुन्या दिवसात पुनर्स्थापित करेन,<verse eid="HOS 6:11"/></para>
  <chapter eid="HOS 6"/>
  <chapter number="7" style="c" sid="HOS 7"/>
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1"/>जेव्हा मी इस्राएलला आरोग्य देतो,</para>
  <para style="q1" vid="HOS 7:1">तेव्हा एफ्राईमचे पाप</para>
  <para style="q2" vid="HOS 7:1">आणि शोमरोनचे अपराध प्रकट होतात.</para>
  <para style="q1" vid="HOS 7:1">ते लबाडी करतात,</para>
  <para style="q2" vid="HOS 7:1">चोर घरात चोरी करतात,</para>
  <para style="q2" vid="HOS 7:1">लुटारू रस्त्यावर लूटमार करतात;<verse eid="HOS 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2"/>परंतु त्यांना हे कळत नाही</para>
  <para style="q2" vid="HOS 7:2">की त्यांची सर्व वाईट कृत्ये मला स्मरण आहेत.</para>
  <para style="q1" vid="HOS 7:2">त्यांच्या पापकर्मांनी त्यांना घेरले आहे;</para>
  <para style="q2" vid="HOS 7:2">ते नेहमी माझ्यासमोर असतात.<verse eid="HOS 7:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3"/>“ते राजाला आपल्या दुष्टाईने,</para>
  <para style="q2" vid="HOS 7:3">अधिपतीला आपल्या लबाड्यांनी हर्षित करतात.<verse eid="HOS 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4"/>ते सर्वच व्यभिचारी आहेत;</para>
  <para style="q2" vid="HOS 7:4">रोटी भाजणार्‍याच्या सतत</para>
  <para style="q1" vid="HOS 7:4">पेटलेल्या भट्टीप्रमाणे ते आहेत.</para>
  <para style="q2" vid="HOS 7:4">पीठ मळून ते फुगेपर्यंत तो विस्तव चाळविण्याचे थांबवितो.<verse eid="HOS 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5"/>आमच्या राजाच्या उत्सवाच्या दिवशी</para>
  <para style="q2" vid="HOS 7:5">अधिपती द्राक्षारसाने धुंद होतात,</para>
  <para style="q2" vid="HOS 7:5">आणि त्याने आपला हात कुचेष्टा करणार्‍यांबरोबर मिळविला आहे.<verse eid="HOS 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6"/>कारस्थाने करताना त्यांची हृदये</para>
  <para style="q2" vid="HOS 7:6">तापलेल्या भट्टीसारखी होतात.</para>
  <para style="q1" vid="HOS 7:6">त्यांची उत्कटता रात्रभर धुमसत असते;</para>
  <para style="q2" vid="HOS 7:6">सकाळी तो प्रज्वलित अग्नीसारखा पेट घेतो.<verse eid="HOS 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7"/>ते सर्व भट्टीसारखे तप्त आहेत;</para>
  <para style="q2" vid="HOS 7:7">ते त्यांच्या अधिपतींना गिळून टाकतात.</para>
  <para style="q1" vid="HOS 7:7">त्यांचे सर्व राजे पतन पावले आहेत,</para>
  <para style="q2" vid="HOS 7:7">त्यातील कोणी मला हाक मारीत नाही.<verse eid="HOS 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8"/>“एफ्राईम गैर यहूदीयांसोबत मिसळतो;</para>
  <para style="q2" vid="HOS 7:8">एफ्राईम न पलटलेल्या भाकरीसारखा झाला आहे.<verse eid="HOS 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9"/>परकीय लोक त्याच्या शक्तीचे शोषण करतात,</para>
  <para style="q2" vid="HOS 7:9">पण त्याला हे कळत नाही</para>
  <para style="q1" vid="HOS 7:9">त्याचे केस पांढरे होत चालले आहेत,</para>
  <para style="q2" vid="HOS 7:9">पण तो त्याची नोंद घेत नाही.<verse eid="HOS 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10"/>इस्राएलचा उन्मत्तपणाच त्याच्याविरुद्ध साक्ष देतात,</para>
  <para style="q2" vid="HOS 7:10">हे सर्व असूनही</para>
  <para style="q1" vid="HOS 7:10">तो याहवेह त्याच्या परमेश्वराकडे वळत नाही,</para>
  <para style="q2" vid="HOS 7:10">किंवा त्यांचा शोध घेत नाही.<verse eid="HOS 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11"/>“एफ्राईम एखाद्या खुळ्या पारव्यासारखा</para>
  <para style="q2" vid="HOS 7:11">बुद्धिहीन आणि सहज फसणारा आहे—</para>
  <para style="q1" vid="HOS 7:11">तो आता इजिप्तला हाक मारतो;</para>
  <para style="q2" vid="HOS 7:11">आता तो अश्शूराकडे धाव घेतो.<verse eid="HOS 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12"/>जेव्हा ते जातील तेव्हा मी माझे जाळे त्याच्यावर फेकेन;</para>
  <para style="q2" vid="HOS 7:12">मी त्यांना आकाशातील पक्ष्याप्रमाणे खाली आणेन.</para>
  <para style="q1" vid="HOS 7:12">जेव्हा मी ऐकेन की ते एकत्र होत आहेत,</para>
  <para style="q2" vid="HOS 7:12">तेव्हा मी त्यांना पकडेन.<verse eid="HOS 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13"/>ते माझ्यापासून बहकले आहेत</para>
  <para style="q2" vid="HOS 7:13">म्हणून त्यांचा धिक्कार असो!</para>
  <para style="q1" vid="HOS 7:13">त्यांचा नाश होवो,</para>
  <para style="q2" vid="HOS 7:13">कारण त्यांनी माझ्याविरुद्ध विद्रोह केला आहे.</para>
  <para style="q1" vid="HOS 7:13">मला त्यांचा उद्धार करावयाची इच्छा होती,</para>
  <para style="q2" vid="HOS 7:13">पण ते माझ्याबद्दल खोटे बोलतात.<verse eid="HOS 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14"/>ते मला त्यांच्या हृदयापासून हाक मारत नाहीत,</para>
  <para style="q2" vid="HOS 7:14">परंतु त्यांच्या बिछान्यांवर विलाप करतात.</para>
  <para style="q1" vid="HOS 7:14">ते धान्य आणि नवीन द्राक्षारसासाठी</para>
  <para style="q2" vid="HOS 7:14">त्यांच्या दैवतांकडे भीक मागून स्वतःला जखमा करतात,<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">भीक मागत एकत्र येतात</char></note></para>
  <para style="q2" vid="HOS 7:14">पण ते माझ्यापासून दूर राहतात.<verse eid="HOS 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15"/>मी त्यांना शिक्षण दिले आहे आणि त्यांचे बाहू बळकट केले आहे,</para>
  <para style="q2" vid="HOS 7:15">परंतु ते माझ्याविरुद्ध वाईट कल्पना मनात आणतात.<verse eid="HOS 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16"/>ते परमोच्च परमेश्वराकडे फिरत नाहीत;</para>
  <para style="q2" vid="HOS 7:16">तर ते सदोष धनुष्यांसारखे आहेत.</para>
  <para style="q1" vid="HOS 7:16">उर्मट शब्दांमुळे त्यांचे पुढारी</para>
  <para style="q2" vid="HOS 7:16">तलवारीला बळी पडतील.</para>
  <para style="q1" vid="HOS 7:16">यामुळे इजिप्त देशात</para>
  <para style="q2" vid="HOS 7:16">त्यांची थट्टा करण्यात येईल.<verse eid="HOS 7:16"/></para>
  <chapter eid="HOS 7"/>
  <chapter number="8" style="c" sid="HOS 8"/>
  <para style="s1">इस्राएल वावटळीची कापणी करतात</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1"/>“तू कर्णे आपल्या मुखाला लाव!</para>
  <para style="q2" vid="HOS 8:1">याहवेहच्या भवनावर एक गरुड आहे,</para>
  <para style="q1" vid="HOS 8:1">कारण लोकांनी माझा करार मोडला आहे</para>
  <para style="q2" vid="HOS 8:1">आणि माझ्या नियमशास्त्राविरुद्ध बंड केले आहे.<verse eid="HOS 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2"/>इस्राएल माझा धावा करून आता म्हणतो,</para>
  <para style="q2" vid="HOS 8:2">‘आमच्या परमेश्वरा, आम्ही तुमचा स्वीकार करतो!’<verse eid="HOS 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3"/>इस्राएलने जे उत्तम ते नाकारले आहे;</para>
  <para style="q2" vid="HOS 8:3">शत्रू त्याचा पाठलाग करतील.<verse eid="HOS 8:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4"/>त्यांनी माझ्या संमतीशिवाय राजे नेमले आहेत;</para>
  <para style="q2" vid="HOS 8:4">ते माझ्या मान्येतेशिवाय अधिपतींना निवडतात.</para>
  <para style="q1" vid="HOS 8:4">त्यांनी आपले चांदी आणि सोने घेऊन</para>
  <para style="q2" vid="HOS 8:4">स्वतःच्या नाशाकरिता</para>
  <para style="q2" vid="HOS 8:4">मूर्ती बनविल्या आहेत.<verse eid="HOS 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5"/>हे शोमरोना, तुझी वासराची मूर्ती फेकून दे!</para>
  <para style="q2" vid="HOS 8:5">त्यांच्याविरुद्ध माझा राग पेटला आहे.</para>
  <para style="q1" vid="HOS 8:5">ते अजून किती काळ शुद्ध होण्यास असमर्थ राहतील?<verse eid="HOS 8:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6"/>ते इस्राएलाकडून आहे!</para>
  <para style="q1" vid="HOS 8:6">हे वासरू—एका कारागिराने बनविले आहे;</para>
  <para style="q2" vid="HOS 8:6">तो परमेश्वर नाही.</para>
  <para style="q1" vid="HOS 8:6">शोमरोनाच्या या वासराचे</para>
  <para style="q2" vid="HOS 8:6">तुकडे तुकडे करण्यात येतील.<verse eid="HOS 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7"/>“ते वारा पेरतात</para>
  <para style="q2" vid="HOS 8:7">आणि ते वावटळीची कापणी करतात.</para>
  <para style="q1" vid="HOS 8:7">त्यांच्या पिकांना कणसे येत नाहीत;</para>
  <para style="q2" vid="HOS 8:7">त्यातून पीठ तयार होत नाही.</para>
  <para style="q1" vid="HOS 8:7">जर त्यातून अन्न तयार झाले</para>
  <para style="q2" vid="HOS 8:7">तर परकीय ते गिळून टाकतील.<verse eid="HOS 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8"/>इस्राएलास गिळून टाकण्यात आले आहे;</para>
  <para style="q2" vid="HOS 8:8">राष्ट्रांमध्ये ती कोणासही</para>
  <para style="q2" vid="HOS 8:8">आवडत नाही.<verse eid="HOS 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9"/>एकाकी भटकणार्‍या रानगाढवासारखे ते वर</para>
  <para style="q2" vid="HOS 8:9">अश्शूराकडे गेले आहे.</para>
  <para style="q2" vid="HOS 8:9">एफ्राईमने स्वतःस तिच्या प्रियकरांना विकले आहे.<verse eid="HOS 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10"/>जरी त्यांना स्वतःला राष्ट्रांमध्ये विकले असेल,</para>
  <para style="q2" vid="HOS 8:10">तरीही आता मी त्यांना एकत्र करेन.</para>
  <para style="q1" vid="HOS 8:10">बलाढ्य राजाच्या अत्याचाराने</para>
  <para style="q2" vid="HOS 8:10">ते नष्ट होऊ लागतील.<verse eid="HOS 8:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11"/>“एफ्राईमने पापार्पण करण्यास पुष्कळ वेद्या बांधल्या आहेत,</para>
  <para style="q2" vid="HOS 8:11">पण ते पाप करण्याच्या वेद्या झाल्या आहेत.<verse eid="HOS 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12"/>मी त्यांच्यासाठी माझ्या नियमशास्त्राच्या पुष्कळ गोष्टी लिहिल्या,</para>
  <para style="q2" vid="HOS 8:12">पण त्यांनी ते परकीय मानले.<verse eid="HOS 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13"/>जरी ते त्यांचे यज्ञार्पण मला भेटस्वरूप अर्पितात,</para>
  <para style="q2" vid="HOS 8:13">आणि तरीही ते मांस खातात,</para>
  <para style="q2" vid="HOS 8:13">याहवेह त्यांच्याशी प्रसन्न नाही.</para>
  <para style="q1" vid="HOS 8:13">आता ते त्यांचा दुष्टपणा स्मरणार</para>
  <para style="q2" vid="HOS 8:13">आणि त्यांच्या पापांची शिक्षा देणार:</para>
  <para style="q2" vid="HOS 8:13">ते इजिप्तला परततील.<verse eid="HOS 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14"/>कारण इस्राएल आपल्या निर्माणकर्त्याला विसरला आहे</para>
  <para style="q2" vid="HOS 8:14">आणि राजवाडे बांधले;</para>
  <para style="q2" vid="HOS 8:14">यहूदाहने अनेक तटबंदीची नगरे बांधली आहेत.</para>
  <para style="q1" vid="HOS 8:14">पण मी त्यांच्या नगरांवर अग्नी पाठवून</para>
  <para style="q2" vid="HOS 8:14">त्यांचे किल्ले भस्म करेन.”<verse eid="HOS 8:14"/></para>
  <chapter eid="HOS 8"/>
  <chapter number="9" style="c" sid="HOS 9"/>
  <para style="s1">इस्राएलास शासन</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1"/>हे इस्राएला, आनंद करू नकोस;</para>
  <para style="q2" vid="HOS 9:1">इतर राष्ट्रांसारखे उल्लासू नकोस,</para>
  <para style="q1" vid="HOS 9:1">कारण तू तुझ्या परमेश्वराशी अविश्वासू झाला आहेस;</para>
  <para style="q2" vid="HOS 9:1">धान्याच्या प्रत्येक खळ्यावर</para>
  <para style="q2" vid="HOS 9:1">वेश्याव्यवसाय करून मिळणारी कमाई तुला आवडते.<verse eid="HOS 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2"/>खळे आणि द्राक्षकुंड लोकांना खाऊ घालणार नाही;</para>
  <para style="q2" vid="HOS 9:2">नवा द्राक्षारस त्यांना दगा देईल.<verse eid="HOS 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3"/>याहवेहच्या देशात ते राहणार नाहीत;</para>
  <para style="q2" vid="HOS 9:3">एफ्राईम इजिप्त देशात परत जाईल</para>
  <para style="q2" vid="HOS 9:3">आणि अश्शूर येथे अशुद्ध भोजन खाईल.<verse eid="HOS 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4"/>ते याहवेहला द्राक्षारसाची पेयार्पणे करू शकणार नाही,</para>
  <para style="q2" vid="HOS 9:4">किंवा त्यांच्या यज्ञार्पणाने याहवेहला संतोष होणार नाही.</para>
  <para style="q1" vid="HOS 9:4">कारण असे यज्ञ त्यांच्यासाठी शोक करणाऱ्यांच्या अन्नासारखे होईल;</para>
  <para style="q2" vid="HOS 9:4">त्यास खाणारे सर्वजण अमंगळ होतील.</para>
  <para style="q1" vid="HOS 9:4">ते भोजन त्यांच्यासाठीच असेल;</para>
  <para style="q2" vid="HOS 9:4">ते याहवेहच्या मंदिरात आणता येणार नाही.<verse eid="HOS 9:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5"/>मग तू ठरविलेल्या उत्सवाच्या दिवशी,</para>
  <para style="q2" vid="HOS 9:5">याहवेहच्या सणाच्या दिवशी काय करशील?<verse eid="HOS 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6"/>जरी ते नाशापासून सुटले तरी</para>
  <para style="q2" vid="HOS 9:6">इजिप्त त्यांना गोळा करेल,</para>
  <para style="q2" vid="HOS 9:6">आणि मेम्फीस त्यांना मूठमाती देतील.</para>
  <para style="q1" vid="HOS 9:6">काटेकुसळे त्यांच्या चांदीच्या वस्तू नेतील,</para>
  <para style="q2" vid="HOS 9:6">आणि त्यांच्या तंबूत काटेरी झाडे उगवतील.<verse eid="HOS 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7"/>शासन करण्याची वेळ जवळ आली आहे;</para>
  <para style="q2" vid="HOS 9:7">प्रतिफळ घेण्याचे दिवस जवळ आले आहेत.</para>
  <para style="q2" vid="HOS 9:7">इस्राएलला हे समजून यावे.</para>
  <para style="q1" vid="HOS 9:7">कारण तुमची पापे अधिक आहेत</para>
  <para style="q2" vid="HOS 9:7">आणि तुमचे शत्रुत्व जास्त आहे,</para>
  <para style="q1" vid="HOS 9:7">संदेष्टा मूर्ख ठरत आहे,</para>
  <para style="q2" vid="HOS 9:7">प्रेरित वेडा समजला जातो.<verse eid="HOS 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8"/>संदेष्टा माझ्या परमेश्वरासोबत,</para>
  <para style="q2" vid="HOS 9:8">एफ्राईमचा पहारेकरी आहे,</para>
  <para style="q1" vid="HOS 9:8">तरीही त्याच्या सर्व मार्गात सापळा त्याची वाट पाहत आहे,</para>
  <para style="q2" vid="HOS 9:8">आणि परमेश्वराच्या भवनात शत्रुत्व आहे.<verse eid="HOS 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9"/>जसे गिबियाहमधील दिवसात केले</para>
  <para style="q2" vid="HOS 9:9">तसे त्यांनी स्वतःला अधिक भ्रष्ट केले आहे.</para>
  <para style="q1" vid="HOS 9:9">परमेश्वर त्यांचे दुष्कर्म स्मरणात ठेवतील</para>
  <para style="q2" vid="HOS 9:9">आणि त्यांना त्यांच्या पापांबद्दल शिक्षा करतील.<verse eid="HOS 9:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10"/>“जेव्हा मला इस्राएल आढळला,</para>
  <para style="q2" vid="HOS 9:10">तेव्हा ते रानात द्राक्षे आढळल्यासारखे होते;</para>
  <para style="q1" vid="HOS 9:10">जेव्हा मी तुमच्या पूर्वजांना पाहिले,</para>
  <para style="q2" vid="HOS 9:10">ते अंजिराच्या झाडावर प्रथमफळ पाहण्यासारखे होते.</para>
  <para style="q1" vid="HOS 9:10">पण जेव्हा ते बआल-पौराला आले</para>
  <para style="q2" vid="HOS 9:10">तेव्हा त्यांनी त्या घृणास्पद मूर्तींपुढे स्वतःला समर्पित केले</para>
  <para style="q2" vid="HOS 9:10">आणि त्यांच्या आवडत्या वस्तूप्रमाणे अमंगळ झाले.<verse eid="HOS 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11"/>एफ्राईमचे वैभव पक्ष्याप्रमाणे उडून जाईल—</para>
  <para style="q2" vid="HOS 9:11">जन्म नाही, गर्भधारणा नाही, गर्भसंभव नाही.<verse eid="HOS 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12"/>जरी त्यांनी मुलांचे संगोपन केले,</para>
  <para style="q2" vid="HOS 9:12">तरी मी त्यांना सर्वांपासून दूर करेन.</para>
  <para style="q1" vid="HOS 9:12">मी त्या लोकांपासून निघून जाईन,</para>
  <para style="q2" vid="HOS 9:12">तेव्हा त्यांचा धिक्कार असो.<verse eid="HOS 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13"/>सोर जसा सुखदायी ठिकाणी लावलेला मी पाहिला,</para>
  <para style="q2" vid="HOS 9:13">तसाच एफ्राईम आहे,</para>
  <para style="q1" vid="HOS 9:13">परंतु एफ्राईम आपल्या मुलांना</para>
  <para style="q2" vid="HOS 9:13">वध करणार्‍याकडे घेऊन येईल.”<verse eid="HOS 9:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14"/>हे याहवेह, त्यांना द्या—</para>
  <para style="q2" vid="HOS 9:14">तुम्ही त्यांना काय द्याल?</para>
  <para style="q1" vid="HOS 9:14">त्यांना वांझ गर्भाशये</para>
  <para style="q2" vid="HOS 9:14">आणि शुष्क स्तने द्या.<verse eid="HOS 9:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15"/>“गिलगालात त्यांची सर्व दुष्कृत्ये आहेत,</para>
  <para style="q2" vid="HOS 9:15">मी त्यांचा तिथेच द्वेष केला.</para>
  <para style="q1" vid="HOS 9:15">त्यांच्या पापी कृत्यांमुळे,</para>
  <para style="q2" vid="HOS 9:15">मी त्यांना माझ्या घरातून हाकलून देईन.</para>
  <para style="q1" vid="HOS 9:15">मी यापुढे त्यांच्यावर प्रीती करणार नाही;</para>
  <para style="q2" vid="HOS 9:15">त्यांचे सर्व पुढारी बंडखोर आहेत.<verse eid="HOS 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16"/>एफ्राईम नाश पावला आहे.</para>
  <para style="q2" vid="HOS 9:16">त्यांची मुळे सुकून गेली आहेत.</para>
  <para style="q2" vid="HOS 9:16">ते फळ देत नाही.</para>
  <para style="q1" vid="HOS 9:16">जरी ते मुलांना जन्म देतील,</para>
  <para style="q2" vid="HOS 9:16">तर मी त्यांचे प्रिय मूल मारून टाकेन.”<verse eid="HOS 9:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17"/>माझा परमेश्वर त्यांना नाकारील</para>
  <para style="q2" vid="HOS 9:17">कारण त्यांनी त्यांची आज्ञा पाळली नाही;</para>
  <para style="q2" vid="HOS 9:17">ते देशादेशातून भटकत राहतील.<verse eid="HOS 9:17"/></para>
  <para style="b"/>
  <chapter eid="HOS 9"/>
  <chapter number="10" style="c" sid="HOS 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1"/>इस्राएल एक पसरणारा द्राक्षवेल होता.</para>
  <para style="q2" vid="HOS 10:1">त्याने स्वतःसाठी फळे आणली.</para>
  <para style="q1" vid="HOS 10:1">जसे त्याचे फळ वाढले,</para>
  <para style="q2" vid="HOS 10:1">तसे त्याने आणखी वेद्या बांधल्या;</para>
  <para style="q1" vid="HOS 10:1">जसा त्याचा देश समृद्ध झाला,</para>
  <para style="q2" vid="HOS 10:1">तसे त्याने त्याच्या पवित्र दगडांना सुशोभित केले.<verse eid="HOS 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2"/>त्यांचे अंतःकरण फसवणूक करणारे आहे,</para>
  <para style="q2" vid="HOS 10:2">आणि आता त्यांना त्यांचे अपराध भोगावेच लागतील.</para>
  <para style="q1" vid="HOS 10:2">याहवेह त्यांच्या वेद्या पाडून टाकतील</para>
  <para style="q2" vid="HOS 10:2">आणि त्यांच्या पवित्र दगडांचे तुकडे करतील.<verse eid="HOS 10:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3"/>मग ते म्हणतील, “आम्हाला राजा नाही</para>
  <para style="q2" vid="HOS 10:3">कारण आम्ही याहवेहचा आदर केला नाही.</para>
  <para style="q1" vid="HOS 10:3">पण आमचा राजा असला तरी</para>
  <para style="q2" vid="HOS 10:3">त्याने आमच्यासाठी काय केले असते?”<verse eid="HOS 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4"/>ते अनेक अभिवचने देतात,</para>
  <para style="q2" vid="HOS 10:4">खोट्या शपथा घेतात</para>
  <para style="q2" vid="HOS 10:4">आणि करार करतात;</para>
  <para style="q1" vid="HOS 10:4">त्यामुळे नांगरलेल्या शेतात उगविलेल्या</para>
  <para style="q2" vid="HOS 10:4">विषारी तणाप्रमाणे खटले सुरू होतात.<verse eid="HOS 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5"/>शोमरोनात राहणारे लोक</para>
  <para style="q2" vid="HOS 10:5">बेथ-आवेनच्या वासरूच्या मूर्तीला घाबरतात.</para>
  <para style="q1" vid="HOS 10:5">त्याचे लोक त्याच्यासाठी शोक करतील</para>
  <para style="q2" vid="HOS 10:5">आणि त्याचप्रमाणे त्याचे मूर्तिपूजक पुजारी करतील,</para>
  <para style="q1" vid="HOS 10:5">जे पूर्वी त्याच्या वैभवात आनंदित होते.</para>
  <para style="q2" vid="HOS 10:5">कारण ते वैभव त्यांच्याकडून हिसकावून त्यांना बंदिवासात नेण्यात आले आहे.<verse eid="HOS 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6"/>महान राजाला भेट म्हणून सादर करण्यासाठी</para>
  <para style="q2" vid="HOS 10:6">ते अश्शूरला नेले जातील.</para>
  <para style="q1" vid="HOS 10:6">एफ्राईमला लज्जित केले जाईल;</para>
  <para style="q2" vid="HOS 10:6">बाहेरील लोकांशी संबंध ठेवल्यामुळे इस्राएलही आपल्या मसलतीविषयी लज्जित होईल.<verse eid="HOS 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7"/>शोमरोनच्या राजाचा नाश होईल,</para>
  <para style="q2" vid="HOS 10:7">पाण्याच्या पृष्ठभागावर पडलेली डहाळी जशी वाहून जाते, तसा तो वाहून जाईल.<verse eid="HOS 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8"/>दुष्टता असलेल्या उच्च स्थानांचा<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">हिब्रू भाषेत </char><char style="fqa" closed="false">आवेन, </char><char style="ft" closed="false">बेथ-आवेनचा संकेत (बेथेलसाठी अपमानास्पद नाव)</char></note> नाश केला जाईल—</para>
  <para style="q2" vid="HOS 10:8">हे इस्राएलचे पाप आहे.</para>
  <para style="q1" vid="HOS 10:8">काटेरी झाडे आणि कुसळे उगवतील</para>
  <para style="q2" vid="HOS 10:8">आणि त्यांच्या वेद्या झाकून घेतील.</para>
  <para style="q1" vid="HOS 10:8">मग ते पर्वतांना म्हणतील, “आम्हाला झाकून टाका!”</para>
  <para style="q2" vid="HOS 10:8">आणि टेकड्यांना म्हणतील, “आमच्यावर येऊन पडा!”<verse eid="HOS 10:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9"/>“हे इस्राएला, गिबियाहतील दिवसापासून तू पाप करीत आला आहेस</para>
  <para style="q2" vid="HOS 10:9">आणि तू तिथेच राहिला.</para>
  <para style="q1" vid="HOS 10:9">गिबियाहच्या दुष्कृत्य करणाऱ्या</para>
  <para style="q2" vid="HOS 10:9">विरुद्ध पुन्हा युद्ध भडकणार नाही काय?<verse eid="HOS 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10"/>जेव्हा माझी इच्छा होईल तेव्हा मी त्यांना दंड देईन;</para>
  <para style="q2" vid="HOS 10:10">त्यांनी केलेल्या दोन्ही पापांसाठी</para>
  <para style="q2" vid="HOS 10:10">त्यांना बेड्या टाकण्यासाठी राष्ट्रे त्यांच्याविरुद्ध एकत्र होतील.<verse eid="HOS 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11"/>एफ्राईम शिकविलेली कालवड आहे.</para>
  <para style="q2" vid="HOS 10:11">तिला मळणी करण्याची आवड आहे;</para>
  <para style="q1" vid="HOS 10:11">म्हणून मी तिच्या नाजूक मानेवर</para>
  <para style="q2" vid="HOS 10:11">जू ठेवेन.</para>
  <para style="q1" vid="HOS 10:11">मी एफ्राईमला नांगराला जुंपेन,</para>
  <para style="q2" vid="HOS 10:11">यहूदाहला नांगरणी करणे</para>
  <para style="q2" vid="HOS 10:11">व याकोबाला माती फोडणे आवश्यक आहे.<verse eid="HOS 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12"/>तुम्ही आपल्यासाठी नीतिमत्वाची पेरणी करा,</para>
  <para style="q2" vid="HOS 10:12">न बदलणार्‍या प्रीतीचे फळ घ्या,</para>
  <para style="q1" vid="HOS 10:12">आणि पडीक जमीन नांगरून टाका;</para>
  <para style="q2" vid="HOS 10:12">जोपर्यंत ते येऊन तुमच्यावर</para>
  <para style="q1" vid="HOS 10:12">नीतिमत्वाचा वर्षाव करत नाही तोपर्यंत,</para>
  <para style="q2" vid="HOS 10:12">याहवेहला शोधण्याची हीच वेळ आहे.<verse eid="HOS 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13"/>पण तुम्ही दुष्टतेची नांगरणी केली आहे</para>
  <para style="q2" vid="HOS 10:13">आणि अन्यायाचे पीक काढले आहे,</para>
  <para style="q2" vid="HOS 10:13">तुम्ही लबाडीचे फळ खाल्ले आहे.</para>
  <para style="q1" vid="HOS 10:13">कारण तुम्ही स्वतःच्या सामर्थ्यावर</para>
  <para style="q2" vid="HOS 10:13">आणि आपल्या अनेक योद्धांवर विश्वास ठेवला आहे,<verse eid="HOS 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14"/>तुझ्या लोकांच्या विरुद्ध युद्धाची गर्जना होईल,</para>
  <para style="q2" vid="HOS 10:14">जेणेकरून तुझ्या सर्व गडांचा नाश होईल;</para>
  <para style="q1" vid="HOS 10:14">जसे शलमनाने युद्धाच्या दिवशी बेथ-आर्बेलाचा नाश केला,</para>
  <para style="q2" vid="HOS 10:14">जेव्हा मातेला तिच्या मुलांसहित आपटून ठार मारण्यात आले.<verse eid="HOS 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15"/>तसेच बेथेल तुझ्यासोबत होईल,</para>
  <para style="q2" vid="HOS 10:15">कारण तुझी दुष्टता फार अधिक आहे.</para>
  <para style="q1" vid="HOS 10:15">तेव्हा त्या दिवशी सकाळच्या प्रहरी</para>
  <para style="q2" vid="HOS 10:15">इस्राएलाच्या राजाचा पूर्णरीतीने नाश केला जाईल.<verse eid="HOS 10:15"/></para>
  <chapter eid="HOS 10"/>
  <chapter number="11" style="c" sid="HOS 11"/>
  <para style="s1">याहवेहची इस्राएलसाठी प्रीती</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1"/>“इस्राएल जेव्हा लहान मूल होते तेव्हा मी त्याच्यावर प्रीती केली,</para>
  <para style="q2" vid="HOS 11:1">आणि इजिप्तमधून माझ्या पुत्राला बोलाविले.<verse eid="HOS 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2"/>पण त्यांना जितके जास्त बोलाविले,</para>
  <para style="q2" vid="HOS 11:2">तितके ते माझ्यापासून दूर गेले.</para>
  <para style="q1" vid="HOS 11:2">त्यांनी बआलापुढे बळी दिले</para>
  <para style="q2" vid="HOS 11:2">आणि त्यांनी मूर्तीला धूप जाळला.<verse eid="HOS 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3"/>मी तोच होतो ज्याने एफ्राईमला चालण्यास शिकविले,</para>
  <para style="q2" vid="HOS 11:3">मी त्यांना कडेवर वागवले;</para>
  <para style="q1" vid="HOS 11:3">तो मीच होतो ज्याने त्यांना आरोग्य दिले,</para>
  <para style="q2" vid="HOS 11:3">परंतु हे त्यांना समजले नाही.<verse eid="HOS 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4"/>मी त्यांना मानवी दयाळूपणाच्या दोरीने</para>
  <para style="q2" vid="HOS 11:4">आणि प्रीतीच्या बंधनाने चालविले.</para>
  <para style="q1" vid="HOS 11:4">त्यांच्यासाठी मी एखाद्या लहान मुलाला</para>
  <para style="q2" vid="HOS 11:4">गालापर्यंत उचलल्यासारखा होतो,</para>
  <para style="q2" vid="HOS 11:4">आणि मी खाली वाकून त्यांना खायला घालत असे.<verse eid="HOS 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5"/>“ते इजिप्त देशात परत जाणार नाहीत काय</para>
  <para style="q2" vid="HOS 11:5">आणि अश्शूर त्यांच्यावर राज्य करणार नाही काय</para>
  <para style="q2" vid="HOS 11:5">कारण ते पश्चात्ताप करण्यास नकार देतात?<verse eid="HOS 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6"/>त्यांच्या शहरातून तलवार चमकेल;</para>
  <para style="q2" vid="HOS 11:6">ती त्यांच्या खोट्या संदेष्ट्यांना मारून टाकेल</para>
  <para style="q2" vid="HOS 11:6">व त्यांच्या योजनांचा अंत करेल.<verse eid="HOS 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7"/>माझ्या लोकांनी माझा त्याग करून दूर जाण्याचा निश्चय केला आहे.</para>
  <para style="q2" vid="HOS 11:7">त्यांनी मला परमोच्च परमेश्वर म्हटले तरी</para>
  <para style="q2" vid="HOS 11:7">मी त्यांना कोणत्याही प्रकारे उन्नत करणार नाही.<verse eid="HOS 11:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8"/>“अरे एफ्राईमा, मी तुला कसे सोडू शकतो?</para>
  <para style="q2" vid="HOS 11:8">अरे इस्राएला, मी तुला दुसऱ्याच्या हाती कसे सोपवून देऊ?</para>
  <para style="q1" vid="HOS 11:8">मी तुला अदमाहसारखे कसे वागवू शकतो?</para>
  <para style="q2" vid="HOS 11:8">मी तुला सबोईमसारखा कसे बनवू शकतो?</para>
  <para style="q1" vid="HOS 11:8">माझे हृदय आतल्याआत आक्रोश करीत आहे;</para>
  <para style="q2" vid="HOS 11:8">माझी सर्व करुणा जागृत झाली आहे.<verse eid="HOS 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9"/>मी माझ्या तीव्र रागाप्रमाणे वागणार नाही,</para>
  <para style="q2" vid="HOS 11:9">मी एफ्राईमचा पुन्हा नाश करणार नाही.</para>
  <para style="q1" vid="HOS 11:9">कारण मी तुमच्यामध्ये एक पवित्र परमेश्वर आहे.</para>
  <para style="q2" vid="HOS 11:9">मनुष्य नाही.</para>
  <para style="q2" vid="HOS 11:9">मी त्यांच्या शहरांविरुद्ध येणार नाही.<verse eid="HOS 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10"/>ते याहवेहला अनुसरतील;</para>
  <para style="q2" vid="HOS 11:10">ते सिंहासारखी गर्जना करतील.</para>
  <para style="q1" vid="HOS 11:10">जेव्हा ते गर्जना करतील,</para>
  <para style="q2" vid="HOS 11:10">तेव्हा त्यांची मुले थरथर कापत पश्चिमेकडून परत येतील.<verse eid="HOS 11:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11"/>पक्ष्यांच्या थरथरणाऱ्या</para>
  <para style="q2" vid="HOS 11:11">थव्याप्रमाणे ते इजिप्तकडून येतील,</para>
  <para style="q2" vid="HOS 11:11">पारव्यांप्रमाणे पंख फडफडत अश्शूरहून येतील.</para>
  <para style="q1" vid="HOS 11:11">आणि मी त्यांना त्यांच्या घरी स्थायिक करेन,”</para>
  <para style="q2" vid="HOS 11:11">असे याहवेह घोषणा करतात.<verse eid="HOS 11:11"/></para>
  <para style="s1">इस्राएलचे पाप</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12"/>एफ्राईमने मला खोटेपणाने,</para>
  <para style="q2" vid="HOS 11:12">इस्राएलने फसवेगिरीने वेढून टाकले आहे.</para>
  <para style="q1" vid="HOS 11:12">आणि यहूदाह उद्धटपणाने परमेश्वराच्या विरोधात आहे,</para>
  <para style="q2" vid="HOS 11:12">शिवाय जे परमेश्वर विश्वासू व पवित्र आहेत, त्यांच्याविरुद्ध आहे.<verse eid="HOS 11:12"/></para>
  <chapter eid="HOS 11"/>
  <chapter number="12" style="c" sid="HOS 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1"/>एफ्राईम वाऱ्यावर चरतो;</para>
  <para style="q2" vid="HOS 12:1">तो दिवसभर पूर्वेकडील वाऱ्याचा पाठलाग करतो</para>
  <para style="q2" vid="HOS 12:1">आणि खोटेपणा व हिंसाचार वाढवितो.</para>
  <para style="q1" vid="HOS 12:1">तो अश्शूरसोबत करार करतो</para>
  <para style="q2" vid="HOS 12:1">आणि इजिप्तला जैतून तेल पाठवितो.<verse eid="HOS 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2"/>याहवेह यहूदीयाच्या विरुद्ध वाद आणत आहेत;</para>
  <para style="q2" vid="HOS 12:2">याकोबाला<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="fq" closed="false">याकोब </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">टाच धरणारा </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">फसविणारा</char></note> त्याच्या मार्गाप्रमाणे ते शासन करतील</para>
  <para style="q2" vid="HOS 12:2">आणि त्याच्या कार्यानुसार त्याला प्रतिफळ देतील.<verse eid="HOS 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3"/>त्याने गर्भात असता आपल्या भावाची टाच धरली;</para>
  <para style="q2" vid="HOS 12:3">एका मनुष्य असून त्याने परमेश्वराशी झुंज केली.<verse eid="HOS 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4"/>तो स्वर्गदूताशी झगडला आणि त्याच्यावर विजयी झाला;</para>
  <para style="q2" vid="HOS 12:4">तो रडला आणि त्याची मेहेरबानी व्हावी म्हणून त्याने भीक मागितली.</para>
  <para style="q1" vid="HOS 12:4">बेथेलला ते त्याला भेटले</para>
  <para style="q2" vid="HOS 12:4">आणि तिथे तो त्यांच्याशी बोलला—<verse eid="HOS 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5"/>याहवेह सर्वसमर्थ परमेश्वर,</para>
  <para style="q2" vid="HOS 12:5">याहवेह हे त्यांचे नाव!<verse eid="HOS 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6"/>पण तू आपल्या परमेश्वराकडे परत आलेच पाहिजे;</para>
  <para style="q2" vid="HOS 12:6">प्रीती आणि न्यायाचे पालन कर</para>
  <para style="q2" vid="HOS 12:6">आणि सतत आपल्या परमेश्वराची प्रतीक्षा कर.<verse eid="HOS 12:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7"/>व्यापारी चुकीचे माप वापरतो</para>
  <para style="q2" vid="HOS 12:7">आणि त्याला लबाडी करणे आवडते.<verse eid="HOS 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8"/>एफ्राईम बढाई मारतो,</para>
  <para style="q2" vid="HOS 12:8">“मी फार धनवान आहे; मी श्रीमंत झालो आहे.</para>
  <para style="q1" vid="HOS 12:8">माझ्या सर्व संपत्तीसह त्यांना माझ्यामध्ये कोणताही</para>
  <para style="q2" vid="HOS 12:8">अपराध किंवा पाप आढळणार नाही.”<verse eid="HOS 12:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9"/>“तू इजिप्तमधून बाहेर आल्यापासून</para>
  <para style="q2" vid="HOS 12:9">मी याहवेह तुमचा परमेश्वर आहे;</para>
  <para style="q1" vid="HOS 12:9">तुझ्या नेमलेल्या उत्सवाच्या दिवसात</para>
  <para style="q2" vid="HOS 12:9">मी तुला पुन्हा तंबूंमध्ये राहवयास लावेन.<verse eid="HOS 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10"/>मी संदेष्ट्यांबरोबर बोललो,</para>
  <para style="q2" vid="HOS 12:10">त्यांना अनेक दृष्टान्त दिले</para>
  <para style="q2" vid="HOS 12:10">आणि त्यांच्याद्वारे दाखले सांगितले.”<verse eid="HOS 12:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11"/>गिलआद दुष्ट आहे काय?</para>
  <para style="q2" vid="HOS 12:11">त्याचे लोक निरुपयोगी आहेत!</para>
  <para style="q1" vid="HOS 12:11">ते गिलगालात बैलांचे अर्पण करतात का?</para>
  <para style="q2" vid="HOS 12:11">त्यांच्या वेद्या नांगरलेल्या शेतातील दगडांच्या</para>
  <para style="q2" vid="HOS 12:11">ढिगार्‍यासारख्या असतील.<verse eid="HOS 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12"/>याकोब अराम देशात पळून गेला;</para>
  <para style="q2" vid="HOS 12:12">इस्राएलने पत्नी मिळविण्यासाठी चाकरी केली</para>
  <para style="q2" vid="HOS 12:12">आणि तिची किंमत चुकविण्यासाठी त्याने मेंढरे राखली.<verse eid="HOS 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13"/>याहवेहने इजिप्तमधून इस्राएलला बाहेर काढण्यासाठी संदेष्ट्याच्या उपयोग केला,</para>
  <para style="q2" vid="HOS 12:13">एका संदेष्ट्याच्या मार्फत त्याची काळजी घेतली.<verse eid="HOS 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14"/>पण एफ्राईमने त्यांचा कोप भयंकर चेतविला आहे;</para>
  <para style="q2" vid="HOS 12:14">त्याचे प्रभू त्याच्या रक्ताचा दोष त्याच्यावरच राहू देतील</para>
  <para style="q2" vid="HOS 12:14">आणि त्याला त्याच्या अपमानाची भरपाई देतील.<verse eid="HOS 12:14"/></para>
  <chapter eid="HOS 12"/>
  <chapter number="13" style="c" sid="HOS 13"/>
  <para style="s1">इस्राएलविरुद्ध याहवेहचा संताप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1"/>जेव्हा एफ्राईम बोलत असे, तेव्हा लोक थरथर कापत असत;</para>
  <para style="q2" vid="HOS 13:1">कारण तो इस्राएलाचा अधिपती होता.</para>
  <para style="q2" vid="HOS 13:1">पण तो बआल मूर्तीच्या उपासनेचा दोषी झाला आणि मरण पावला.<verse eid="HOS 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2"/>आता ते अधिकाधिक पाप करीत आहेत;</para>
  <para style="q2" vid="HOS 13:2">ते आपल्या चांदीपासून स्वतःसाठी मूर्ती बनवतात,</para>
  <para style="q1" vid="HOS 13:2">हुशारीने तयार केलेल्या प्रतिमा,</para>
  <para style="q2" vid="HOS 13:2">त्या सर्व कारागिरांची हस्तकृती आहेत.</para>
  <para style="q1" vid="HOS 13:2">या लोकांबद्दल असे म्हटले जाते,</para>
  <para style="q2" vid="HOS 13:2">“हे नरबली देतात!</para>
  <para style="q2" vid="HOS 13:2">ते वासराच्या मूर्तीचे चुंबन<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">यज्ञ करणारे पुरुष</char></note> घेतात!”<verse eid="HOS 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3"/>म्हणून ते सकाळच्या धुक्यासारखे,</para>
  <para style="q2" vid="HOS 13:3">पहाटेच्या लवकर उडून जाणार्‍या दहिवरासारखे,</para>
  <para style="q2" vid="HOS 13:3">खळ्यातून उडून जाणार्‍या भुशासारखे,</para>
  <para style="q2" vid="HOS 13:3">धुराड्यातून निघणार्‍या धुराप्रमाणे होतील.<verse eid="HOS 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4"/>“तू इजिप्तमधून बाहेर आल्यापासून</para>
  <para style="q2" vid="HOS 13:4">मी याहवेह तुमचा परमेश्वर आहे;</para>
  <para style="q1" vid="HOS 13:4">माझ्याशिवाय इतर कोणत्याही परमेश्वराला तू स्वीकारणार नाहीस,</para>
  <para style="q2" vid="HOS 13:4">माझ्याशिवाय इतर कोणीही तारणारा नाही.<verse eid="HOS 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5"/>मी रानात, त्या तप्त उष्णतेच्या प्रदेशात,</para>
  <para style="q2" vid="HOS 13:5">तुझी काळजी वाहिली.<verse eid="HOS 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6"/>जेव्हा मी त्यांना भोजन दिले ते तृप्त झाले;</para>
  <para style="q2" vid="HOS 13:6">जेव्हा ते तृप्त झाले तेव्हा ते गर्विष्ठ झाले;</para>
  <para style="q2" vid="HOS 13:6">नंतर ते मला विसरले.<verse eid="HOS 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7"/>म्हणून मी त्यांच्यासाठी सिंहासारखा होईन,</para>
  <para style="q2" vid="HOS 13:7">चित्त्यासारखा त्यांच्या वाटेवर दबा धरून बसेन.<verse eid="HOS 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8"/>जिची पिल्ले हरण केली आहेत, अशा अस्वलीप्रमाणे</para>
  <para style="q2" vid="HOS 13:8">मी त्यांच्यावर हल्ला करेन आणि त्यांचे तुकडे तुकडे करेन;</para>
  <para style="q1" vid="HOS 13:8">मी त्यांना सिंहाप्रमाणे फाडून टाकेन—</para>
  <para style="q2" vid="HOS 13:8">वनपशू त्यांना फाडून टाकतील.<verse eid="HOS 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9"/>“हे इस्राएला, तुझा नाश झाला आहे,</para>
  <para style="q2" vid="HOS 13:9">कारण तू माझ्याविरुद्ध, तुझ्या साहाय्यकर्त्यांच्या विरुद्ध आहेस.<verse eid="HOS 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10"/>तुला वाचविणारा तुझा राजा कुठे आहे?</para>
  <para style="q2" vid="HOS 13:10">‘मला राजा व राजपुत्र द्या’</para>
  <para style="q1" vid="HOS 13:10">ज्यांच्याबद्दल तू असे म्हटले होते,</para>
  <para style="q2" vid="HOS 13:10">ते तुझे सर्व नगरांचे अधिकारी कुठे आहेत?<verse eid="HOS 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11"/>म्हणून माझ्या रागात मी तुला राजा दिला</para>
  <para style="q2" vid="HOS 13:11">आणि माझ्या क्रोधात त्याला मी काढून टाकले आहे.<verse eid="HOS 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12"/>एफ्राईमची पातके जमा केली आहेत,</para>
  <para style="q2" vid="HOS 13:12">त्याची पापे साठवून ठेवली आहेत.<verse eid="HOS 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13"/>बाळंतपणात स्त्रीला होणारा त्रास त्याला होईल,</para>
  <para style="q2" vid="HOS 13:13">पण तो बुद्धी नसलेला एक बालक आहे;</para>
  <para style="q1" vid="HOS 13:13">जेव्हा प्रसूतीची वेळ येते तेव्हा</para>
  <para style="q2" vid="HOS 13:13">त्याला गर्भातून बाहेर येण्याचे ज्ञान नसते.<verse eid="HOS 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14"/>“मी या लोकांना कबरेच्या सामर्थ्यापासून सुटका देईन;</para>
  <para style="q2" vid="HOS 13:14">मी त्यांना मृत्यूपासून वाचवेन.</para>
  <para style="q1" vid="HOS 13:14">अरे मरणा, तुझ्या पीडा कुठे आहे?</para>
  <para style="q2" vid="HOS 13:14">हे कबरे, तुझा नाश कुठे आहे?</para>
  <para style="b" vid="HOS 13:14"/>
  <para style="q1" vid="HOS 13:14">“मला काहीही कळवळा येणार नाही,<verse eid="HOS 13:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15"/>जरी तो त्याच्या भावांमध्ये अत्यंत फलद्रूप होता,</para>
  <para style="q1" vid="HOS 13:15">परंतु याहवेहकडून पूर्वेकडील वारा येईल,</para>
  <para style="q2" vid="HOS 13:15">तो वाळवंटातून येईल;</para>
  <para style="q1" vid="HOS 13:15">त्याचे झरे सुकून जातील</para>
  <para style="q2" vid="HOS 13:15">आणि त्याची विहीर कोरडी पडेल.</para>
  <para style="q1" vid="HOS 13:15">त्याच्या भांडारातील</para>
  <para style="q2" vid="HOS 13:15">सर्व खजिना लुटला जाईल.<verse eid="HOS 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16"/>शोमरोनच्या लोकांनी त्यांचा दोष वाहिलाच पाहिजे,</para>
  <para style="q2" vid="HOS 13:16">कारण त्यांनी त्यांच्या परमेश्वराविरुद्ध बंड केले.</para>
  <para style="q1" vid="HOS 13:16">ते तलवारीने पडतील;</para>
  <para style="q2" vid="HOS 13:16">त्यांची बालके जमिनीवर आपटली जातील,</para>
  <para style="q2" vid="HOS 13:16">आणि त्यांच्या गर्भवती स्त्रियांना चिरून टाकण्यात येईल.”<verse eid="HOS 13:16"/></para>
  <chapter eid="HOS 13"/>
  <chapter number="14" style="c" sid="HOS 14"/>
  <para style="s1">आशीर्वाद प्राप्तीसाठी पश्चात्ताप</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1"/>हे इस्राएला, याहवेह तुमच्या परमेश्वराकडे परत ये.</para>
  <para style="q2" vid="HOS 14:1">कारण तुझे पापच तुझ्या पतनाचे कारण झाले आहे!<verse eid="HOS 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2"/>परमेश्वराच्या वचनांचे पालन कर</para>
  <para style="q2" vid="HOS 14:2">आणि याहवेहकडे परत ये.</para>
  <para style="q1" vid="HOS 14:2">त्यांना सांगा:</para>
  <para style="q2" vid="HOS 14:2">“आमच्या सर्व पापांची क्षमा करा,</para>
  <para style="q1" vid="HOS 14:2">आणि कृपापूर्वक आमचा स्वीकार करा,</para>
  <para style="q2" vid="HOS 14:2">म्हणजे आम्ही आमच्या ओठांची फळे वासराच्या अर्पणाप्रमाणे अर्पण करू.<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">आमचे ओठ अर्पण करू</char></note><verse eid="HOS 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3"/>अश्शूर आमचे तारण करू शकणार नाही;</para>
  <para style="q2" vid="HOS 14:3">आम्ही युद्धाच्या घोड्यावर स्वार होणार नाही.</para>
  <para style="q1" vid="HOS 14:3">हातांनी बनविलेल्या मूर्तीना आम्ही</para>
  <para style="q2" vid="HOS 14:3">‘आमची दैवते’ असे इतःपर म्हणणार नाही.</para>
  <para style="q2" vid="HOS 14:3">कारण अनाथांना तुमच्याठायीच दया मिळते.”<verse eid="HOS 14:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4"/>“मी त्यांचा स्वच्छंदीपणा दूर करेन</para>
  <para style="q2" vid="HOS 14:4">आणि त्यांच्यावर मुक्तपणे प्रीती करेन,</para>
  <para style="q2" vid="HOS 14:4">कारण माझा राग त्यांच्यापासून दूर झाला आहे.<verse eid="HOS 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5"/>मी इस्राएलला दहिवराप्रमाणे होईन.</para>
  <para style="q2" vid="HOS 14:5">तो कुमुदिनीप्रमाणे फुलेल</para>
  <para style="q1" vid="HOS 14:5">आणि त्याची मुळे लबानोनातील</para>
  <para style="q2" vid="HOS 14:5">गंधसरूंच्या मुळांप्रमाणे जातील;<verse eid="HOS 14:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6"/>त्याच्या फांद्या पसरतील.</para>
  <para style="q1" vid="HOS 14:6">त्याचे वैभव एका जैतून वृक्षासारखे होईल.</para>
  <para style="q2" vid="HOS 14:6">त्याचा सुगंध लबानोनातील गंधसरू सारखा होईल.<verse eid="HOS 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7"/>लोक परत त्यांच्या छायेत विश्रांती घेतील;</para>
  <para style="q2" vid="HOS 14:7">ते धान्यासारखे पुनरुज्जीवित होतील,</para>
  <para style="q1" vid="HOS 14:7">द्राक्षवेलीप्रमाणे ते फळे देतील—</para>
  <para style="q2" vid="HOS 14:7">इस्राएलची प्रसिद्धी लबानोनच्या द्राक्षारसाप्रमाणे होईल.<verse eid="HOS 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8"/>हे एफ्राईमा, आता माझा या मूर्तीशी काय संबंध आहे?</para>
  <para style="q2" vid="HOS 14:8">मी त्याला उत्तर देईन आणि त्याची काळजी घेईन.</para>
  <para style="q1" vid="HOS 14:8">मी सदाहरित गंधसरू वृक्षासारखा आहे;</para>
  <para style="q2" vid="HOS 14:8">तुमचे फलवंत होणे माझ्यामुळे येते.”<verse eid="HOS 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9"/>कोण शहाणा आहे? त्यांना या गोष्टींची जाणीव होऊ द्या.</para>
  <para style="q2" vid="HOS 14:9">कोण समंजस आहे? त्यांना समजू द्या.</para>
  <para style="q1" vid="HOS 14:9">कारण याहवेहचे मार्ग योग्य आहेत;</para>
  <para style="q2" vid="HOS 14:9">नीतिमान त्यावरून चालतील,</para>
  <para style="q2" vid="HOS 14:9">पण पातकी त्यावर अडखळून पडतील.<verse eid="HOS 14:9"/></para>
  <chapter eid="HOS 14"/>
</usx>
