<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">3 योहान</para>
  <para style="toc1">योहानाचे तिसरे पत्र</para>
  <para style="toc2">3 योहान</para>
  <para style="toc3">3 योहा</para>
  <para style="mt1">योहानाचे तिसरे पत्र</para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="po">
    <verse number="1" style="v" sid="3JN 1:1"/>मंडळीचा वडील याजकडून,</para>
  <para style="po" vid="3JN 1:1">माझ्या प्रिय मित्र गायसला, ज्याच्यावर मी खरेपणाने प्रीती करतो.<verse eid="3JN 1:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2"/>प्रिय मित्रा, मी प्रार्थना करतो की, तुला चांगले आरोग्य लाभो आणि तुझ्याबरोबर सर्वकाही चांगले होत जावो, जशी तुझ्या आत्म्याचीसुद्धा उन्नती होत आहे. <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>जेव्हा काही विश्वासणार्‍यांनी येऊन सत्यासाठी असलेल्या तुमच्या विश्वासूपणाबद्दल साक्ष दिली आणि सांगितले की तुम्ही सातत्याने विश्वासात कशाप्रकारे जगत आहात, तेव्हा मला मोठा आनंद झाला. <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>माझी मुले सत्याने चालतात, हे ऐकल्याने मला जेवढा आनंद होतो, तेवढा आनंद दुसर्‍या कशानेही होत नाही.<verse eid="3JN 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>प्रिय मित्रा, जे तुला अनोळखी आहेत, त्या काही भावांसाठी आणि बहिणींसाठी तू जे करीत आहेस त्यामध्ये तू विश्वासू आहेस. <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>त्यांनी मंडळीला तू दाखविलेल्या प्रीतीविषयी साक्ष दिली आहे. कृपा करून त्यांना अशाप्रकारे निरोप देऊन पाठव की ज्यामुळे परमेश्वराचे गौरव व्हावे. <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ते गैरयहूदी लोकांकडून कोणतीही मदत न घेता सेवेसाठी बाहेर निघाले हे परमेश्वराच्या नावाच्या गौरवासाठीच होते. <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>आपण अशा लोकांचे आदरातिथ्य केले पाहिजे, म्हणजे सत्यासाठी आपण एकत्र कार्य करू शकू.<verse eid="3JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>मी मंडळीला एक पत्र लिहिले, परंतु दियत्रेफस, जो स्वतःस श्रेष्ठ करण्याची आवडत धरतो, तो आमचे स्वागत करणार नाही. <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>म्हणून जेव्हा मी येईन, तेव्हा तो आमच्याविषयी द्वेषभावनेने निरर्थक बातम्या पसरवित आहे याकडे लक्ष वेधीन. एवढेच नव्हे तर तो इतर विश्वासणार्‍यांचेही स्वागत करीत नाही. पण जे कोणी करू इच्छितात त्यांना तो मनाई करतो आणि मंडळीतून घालवून देतो.<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>प्रिय मित्रा, जे वाईट आहे त्याचे अनुकरण करू नको तर चांगल्याचे कर. जो कोणी चांगले करतो तो परमेश्वरापासून आहे. जो कोणी जे काही वाईट आहे ते करतो त्याने परमेश्वराला पाहिलेले नाही. <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>देमेत्रियाबद्दल प्रत्येकजण चांगले बोलतात आणि स्वतः सत्यसुद्धा त्याच्याविषयी साक्ष देते. आम्हीसुद्धा त्याच्याविषयी चांगलेच बोलतो आणि तुम्हाला माहीतच आहे की, आमची साक्ष खरी आहे.<verse eid="3JN 1:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>तुम्हाला लिहिण्यासाठी माझ्याकडे पुष्कळ काही आहे, परंतु ते लेखणी आणि शाईने लिहून कळवावे अशी माझी इच्छा नाही. <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>तुमची भेट लवकरच होईल, अशी मला आशा आहे आणि तेव्हा आपण समोरासमोर बोलू.<verse eid="3JN 1:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>तुम्हाला शांती लाभो.</para>
  <para style="b" vid="3JN 1:15"/>
  <para style="p" vid="3JN 1:15">येथील मित्र तुम्हाला शुभेच्छा पाठवितात. कृपया तेथील मित्रांपैकी प्रत्येकाला त्यांच्या नावाने शुभेच्छा दे.<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
