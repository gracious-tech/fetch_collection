<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open Marathi Contemporary Version</book>
  
  <para style="h">ओबद्याह</para>
  <para style="toc1">ओबद्याहाची भविष्यवाणी</para>
  <para style="toc2">ओबद्याह</para>
  <para style="toc3">ओब</para>
  <para style="mt1">ओबद्याहाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="OBA 1" />
  <para style="s1">ओबद्याहचा दृष्टान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1" />ओबद्याहचा दृष्टान्त हा.</para>
  <para style="b" vid="OBA 1:1" />
  <para style="b" vid="OBA 1:1" />
  <para style="p" vid="OBA 1:1">एदोमाबद्दल सार्वभौम याहवेह असे म्हणतात;</para>
  <para style="q1" vid="OBA 1:1">आम्ही याहवेहकडून हा संदेश ऐकला:</para>
  <para style="q2" vid="OBA 1:1">राष्ट्रांना सांगण्यासाठी एक दूत पाठविण्यात आला होता,</para>
  <para style="q1" vid="OBA 1:1">“उठा, आपण तिच्याविरुद्ध युद्ध करण्यास जाऊ.”<verse eid="OBA 1:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2" />“पाहा, राष्ट्रांमध्ये मी तुला लहान करेन;</para>
  <para style="q2" vid="OBA 1:2">तुझा पूर्णपणे तिरस्कार करण्यात येईल.<verse eid="OBA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3" />तुमच्या अंतःकरणाच्या गर्विष्ठपणाने तुमची फसवणूक केली आहे,</para>
  <para style="q2" vid="OBA 1:3">तुम्ही जे खडकांच्या<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">सेलाच्या कपारींमध्ये</char></note> कपारीत राहता</para>
  <para style="q2" vid="OBA 1:3">आणि तुमचे घर उंचावर बांधता,</para>
  <para style="q1" vid="OBA 1:3">तुम्ही जे स्वतःला म्हणता,</para>
  <para style="q2" vid="OBA 1:3">‘मला खाली जमिनीवर कोण आणू शकेल?’<verse eid="OBA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4" />तू गरुडांप्रमाणे उंच भरार्‍या मारीत असलास</para>
  <para style="q2" vid="OBA 1:4">किंवा आपले घरटे तार्‍यांमध्ये बांधत असलास,</para>
  <para style="q2" vid="OBA 1:4">तरी तिथून मी तुला खाली आणेन,”</para>
  <para style="q2" vid="OBA 1:4">असे याहवेह जाहीर करतात.<verse eid="OBA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5" />“जरी तुमच्याकडे चोर आले,</para>
  <para style="q2" vid="OBA 1:5">जरी रात्री लुटारू आले तर</para>
  <para style="q1" vid="OBA 1:5">पाहा, संकट कसे तुमची वाट पाहत आहे!</para>
  <para style="q2" vid="OBA 1:5">त्यांना हवे तेवढेच चोरत नाहीत काय?</para>
  <para style="q1" vid="OBA 1:5">जर द्राक्ष वेचणारे तुमच्याकडे आले,</para>
  <para style="q2" vid="OBA 1:5">तर ते थोडी द्राक्षे सोडणार नाहीत काय?<verse eid="OBA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6" />परंतु एसावला लुटण्यात येईल,</para>
  <para style="q2" vid="OBA 1:6">आणि त्याचा गुप्त खजिना हस्तगत केला जाईल!<verse eid="OBA 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7" />तुझ्यासोबत करार केलेले सर्व मित्र राष्ट्रे तुला तुझ्या सीमेपर्यंत ढकलतील;</para>
  <para style="q2" vid="OBA 1:7">तुझे मित्र तुला फसवतील आणि तुझा ताबा घेतील;</para>
  <para style="q1" vid="OBA 1:7">जे तुझी भाकरी खातात, तेच तुझ्यासाठी सापळा रचतील,</para>
  <para style="q2" vid="OBA 1:7">परंतु तुला ते कळणारही नाही.”<verse eid="OBA 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8" />याहवेह असे जाहीर करतात,</para>
  <para style="q2" vid="OBA 1:8">“त्या दिवशी, मी एदोमच्या ज्ञानी पुरुषांचा,</para>
  <para style="q2" vid="OBA 1:8">एसावच्या डोंगरावर जे समजूतदार आहेत, त्यांचा नाश करणार नाही काय?<verse eid="OBA 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9" />तेमान, तुझे योद्धे घाबरून जातील,</para>
  <para style="q2" vid="OBA 1:9">आणि एसावाच्या डोंगरांमध्ये असलेला प्रत्येकजण</para>
  <para style="q2" vid="OBA 1:9">कापला जाईल.<verse eid="OBA 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10" />तुझा भाऊ याकोब याच्यावर केलेल्या अत्याचारामुळे,</para>
  <para style="q2" vid="OBA 1:10">तू लाजेने झाकून जाशील;</para>
  <para style="q2" vid="OBA 1:10">आणि तुझा कायमचा नाश करण्यात येईल.<verse eid="OBA 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11" />अनोळखी लोकांनी जेव्हा त्याची संपत्ती पळवून नेली</para>
  <para style="q2" vid="OBA 1:11">त्या दिवशी तू अलिप्त राहिला</para>
  <para style="q1" vid="OBA 1:11">आणि परदेशी लोक त्याच्या वेशीत शिरले</para>
  <para style="q2" vid="OBA 1:11">आणि यरुशलेमसाठी चिठ्ठ्या टाकल्या,</para>
  <para style="q2" vid="OBA 1:11">तेव्हा तू त्यांच्यापैकी एक होतास.<verse eid="OBA 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12" />आपल्या भावाच्या दुःखाच्या दिवशी</para>
  <para style="q2" vid="OBA 1:12">त्याच्याबद्दल आनंद करू नकोस,</para>
  <para style="q1" vid="OBA 1:12">किंवा यहूदीयाच्या रहिवाशांवर</para>
  <para style="q2" vid="OBA 1:12">आनंद मानू नकोस,</para>
  <para style="q1" vid="OBA 1:12">त्यांच्या संकटाच्या दिवशी</para>
  <para style="q2" vid="OBA 1:12">अधिक गर्व करू नकोस.<verse eid="OBA 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13" />तुम्ही माझ्या लोकांच्या संकटाच्या दिवशी</para>
  <para style="q2" vid="OBA 1:13">माझ्या लोकांच्या नगरात प्रवेश करू नका,</para>
  <para style="q1" vid="OBA 1:13">किंवा त्यांच्या आपत्तीच्या दिवशी</para>
  <para style="q2" vid="OBA 1:13">त्यावर आनंद करू नका,</para>
  <para style="q1" vid="OBA 1:13">किंवा त्यांच्या विपत्तीच्या दिवशी.</para>
  <para style="q2" vid="OBA 1:13">त्यांच्या संपत्तीवर ताबा मिळवू नका.<verse eid="OBA 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14" />त्यांच्या फरार झालेल्यांना मारण्यासाठी</para>
  <para style="q2" vid="OBA 1:14">चौकात उभा राहू नको</para>
  <para style="q1" vid="OBA 1:14">किंवा त्यांच्या संकटाच्या वेळी</para>
  <para style="q2" vid="OBA 1:14">त्यांच्या शत्रूच्या स्वाधीन करू नको.<verse eid="OBA 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15" />“सर्व राष्ट्रांसाठी</para>
  <para style="q2" vid="OBA 1:15">नेमलेला याहवेहचा दिवस जवळ आला आहे.</para>
  <para style="q1" vid="OBA 1:15">जसे तू केलेस, तसे तुझ्यासोबतही केले जाईल होईल;</para>
  <para style="q2" vid="OBA 1:15">तुझ्याद्वारे करण्यात आलेली दुष्कर्मे तुझ्याच माथ्यावर उलटतील.<verse eid="OBA 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16" />जसा तू माझ्या पवित्र पर्वतावर प्याला,</para>
  <para style="q2" vid="OBA 1:16">तसेच सर्व राष्ट्रे सतत पीत राहतील;</para>
  <para style="q1" vid="OBA 1:16">ते पितील आणि पीत राहतील</para>
  <para style="q2" vid="OBA 1:16">आणि जसे ते कधीच नव्हते तसे बनतील.<verse eid="OBA 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17" />पण सीयोन पर्वतावर तारण होईल;</para>
  <para style="q2" vid="OBA 1:17">ते पवित्र होईल,</para>
  <para style="q2" vid="OBA 1:17">आणि याकोबास त्याचे वतन मिळेल.<verse eid="OBA 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18" />याकोब अग्नीसारखा</para>
  <para style="q2" vid="OBA 1:18">आणि योसेफ ज्वालासारखे असतील;</para>
  <para style="q1" vid="OBA 1:18">एसाव उरलेल्या भुशासारखे होतील,</para>
  <para style="q2" vid="OBA 1:18">आणि ते त्यांना जाळून नष्ट करतील.</para>
  <para style="q1" vid="OBA 1:18">एसावच्या वंशजांपैकी</para>
  <para style="q2" vid="OBA 1:18">कोणीही जिवंत राहणार नाही.”</para>
  <para style="q1" vid="OBA 1:18">याहवेहने हे म्हटले आहे.<verse eid="OBA 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19" />एसावाचा पर्वत</para>
  <para style="q2" vid="OBA 1:19">दक्षिणेतील लोक ताब्यात घेतील,</para>
  <para style="q1" vid="OBA 1:19">आणि पलिष्टी लोकांच्या देशाला</para>
  <para style="q2" vid="OBA 1:19">डोंगराच्या पायथ्याशी राहणारे आपल्या ताब्यात घेतील.</para>
  <para style="q1" vid="OBA 1:19">ते एफ्राईम आणि शोमरोनच्या भूमीचा ताबा घेतील</para>
  <para style="q2" vid="OBA 1:19">आणि बिन्यामीन गिलआद प्रांत व्यापून घेतील.<verse eid="OBA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20" />बंदिवान इस्राएल लोकांचा हा गट, जो कनानमध्ये आहे,</para>
  <para style="q2" vid="OBA 1:20">तो कनानी लोकांचा सारेफथपर्यंतचा प्रदेश ताब्यात घेतील;</para>
  <para style="q1" vid="OBA 1:20">यरुशलेमेचे बंदिवान, जे सफारदात शहरात आहेत,</para>
  <para style="q2" vid="OBA 1:20">ते नेगेवची शहरे ताब्यात घेतील.<verse eid="OBA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21" />सुटका करणारे एसाव पर्वतावर</para>
  <para style="q2" vid="OBA 1:21">राज्य करण्यासाठी सीयोन पर्वतावर चढतील.</para>
  <para style="q2" vid="OBA 1:21">आणि ते याहवेहचे राज्य असेल.<verse eid="OBA 1:21" /></para>
  <chapter eid="OBA 1" />
</usx>