<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Marathi Contemporary Version</book>
  
  <para style="h">सफन्याह</para>
  <para style="toc1">सफन्याहची भविष्यवाणी</para>
  <para style="toc2">सफन्याह</para>
  <para style="toc3">सफ</para>
  <para style="mt1">सफन्याहची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />सफन्याहला, जो कूशीचा पुत्र, जो गदल्याहचा पुत्र, जो अमर्‍याहचा पुत्र, जो हिज्कीयाहचा पुत्र, यहूदीयाचा राजा योशीयाह, जो आमोनचा पुत्र होता, याच्या कारकिर्दीत याहवेहकडून आलेले वचन ते असे:<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="s1">याहवेहचा संपूर्ण पृथ्वीसाठी न्यायाचा दिवस</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“मी पृथ्वीतलावरून सर्वकाही</para>
  <para style="q2" vid="ZEP 1:2">झटकून नाहीसे करेन.”</para>
  <para style="q2" vid="ZEP 1:2">असे याहवेह जाहीर करतात.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“मी माणसे आणि जनावरे दोन्हीही नष्ट करेन;</para>
  <para style="q2" vid="ZEP 1:3">मी आकाशातील पक्षी नष्ट करेन</para>
  <para style="q2" vid="ZEP 1:3">आणि समुद्रातील मासेही—</para>
  <para style="q2" vid="ZEP 1:3">त्या मूर्ती ज्या दुष्टाच्या अडखळण्याचे कारण बनते.”</para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q1" vid="ZEP 1:3">याहवेह जाहीर करतात,</para>
  <para style="q2" vid="ZEP 1:3">“जेव्हा मी पृथ्वीवरून</para>
  <para style="q2" vid="ZEP 1:3">सर्व मानवजातीला नष्ट करेन,<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />तेव्हा मी यहूदीयातील</para>
  <para style="q2" vid="ZEP 1:4">आणि यरुशलेम येथील सर्व रहिवाशांच्या विरुद्ध माझा हात उगारेन.</para>
  <para style="q1" vid="ZEP 1:4">या ठिकाणावरील बआलच्या सर्व शेष उपासकांचा मी नाश करेन</para>
  <para style="q2" vid="ZEP 1:4">प्रत्येक मूर्तिपूजक पुजार्‍यांच्या नावाचा—<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />जे त्यांच्या घरांच्या धाब्यांवर जातात</para>
  <para style="q2" vid="ZEP 1:5">आणि आकाशातील नक्षत्रांना नमन करतात.</para>
  <para style="q1" vid="ZEP 1:5">जे याहवेहला नमन करून त्यांची शपथ घेतात,</para>
  <para style="q2" vid="ZEP 1:5">आणि मोलेख<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मालकम</char></note> दैवताचीही शपथ घेतात,<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />जे याहवेहचे अनुसरण करण्यापासून मागे फिरले आहेत</para>
  <para style="q2" vid="ZEP 1:6">आणि जे याहवेहचा शोध घेत नाहीत वा त्यांची इच्छा जाणून घेत नाहीत.”<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />सार्वभौम याहवेहपुढे स्तब्ध राहा.</para>
  <para style="q2" vid="ZEP 1:7">कारण त्यांच्या न्यायाचा दिवस जवळ आला आहे;</para>
  <para style="q1" vid="ZEP 1:7">याहवेहने अर्पण सिद्ध केले आहे;</para>
  <para style="q2" vid="ZEP 1:7">ज्यांना त्यांनी आमंत्रित केले, त्यांचे पवित्रीकरण केले आहे.<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />याहवेहच्या अर्पणाच्या दिवशी</para>
  <para style="q2" vid="ZEP 1:8">मी अधिपतींना आणि राजपुत्रांना</para>
  <para style="q1" vid="ZEP 1:8">आणि परकीय वस्त्रे परिधान करणार्‍या</para>
  <para style="q2" vid="ZEP 1:8">सर्वांना शिक्षा करेन.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />त्या दिवशी या सर्वांना शिक्षा करेन</para>
  <para style="q2" vid="ZEP 1:9">जे उंबरठ्यावर पाऊल ठेवण्याचे टाळतात<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="1SA 5:5">1 शमु 5:5</ref></char> पाहावे</char></note></para>
  <para style="q1" vid="ZEP 1:9">जे त्यांच्या दैवतांची मंदिरे</para>
  <para style="q2" vid="ZEP 1:9">हिंसाचार व लबाडीने भरतात.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />याहवेह जाहीर करतात,</para>
  <para style="q2" vid="ZEP 1:10">“त्या दिवशी मत्स्य वेशीपासून</para>
  <para style="q1" vid="ZEP 1:10">एक मोठी आरोळी ऐकू जाईल,</para>
  <para style="q2" vid="ZEP 1:10">नगरातील नव्या विभागातून विलापाचा ध्वनी,</para>
  <para style="q2" vid="ZEP 1:10">आणि डोंगरातून मोठ्या स्फोटाचा आवाज ऐकू येईल;<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />विलाप करा, तुम्ही जे मक्तेशातील व्यापारी भागात राहता,</para>
  <para style="q2" vid="ZEP 1:11">तुमचे सर्व व्यापारी,</para>
  <para style="q2" vid="ZEP 1:11">सोन्याचांदीचा व्यवहार करणारे सर्वजण नष्ट होतील.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />त्या समयी मी दिवा घेऊन यरुशलेममध्ये शोधेन</para>
  <para style="q2" vid="ZEP 1:12">आणि जे बेफिकीर असतात,</para>
  <para style="q2" vid="ZEP 1:12">जे पखालीत सोडलेल्या द्राक्षारसाच्या गाळासारखे आहेत,</para>
  <para style="q1" vid="ZEP 1:12">जे विचार करतात की याहवेह आपले बरे किंवा वाईट</para>
  <para style="q2" vid="ZEP 1:12">असे काहीही करणार नाहीत, अशांना शिक्षा करेन.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />या लोकांची मालमत्ता लुटली जाईल,</para>
  <para style="q2" vid="ZEP 1:13">यांचीच घरे ढासाळून टाकली जातील,</para>
  <para style="q1" vid="ZEP 1:13">जरी त्यांनी घरे बांधली असतील,</para>
  <para style="q2" vid="ZEP 1:13">त्या घरात ते राहू शकणार नाहीत;</para>
  <para style="q1" vid="ZEP 1:13">जरी त्यांनी द्राक्षमळा लावला असेल,</para>
  <para style="q2" vid="ZEP 1:13">द्राक्षांचा रस ते पिणार नाहीत.”<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />याहवेहचा तो भयावह दिवस जवळ—</para>
  <para style="q2" vid="ZEP 1:14">तो वेगाने अगदी जवळ येत आहे.</para>
  <para style="q1" vid="ZEP 1:14">याहवेहच्या दिवसाची गर्जना मर्मभेदक आहे;</para>
  <para style="q2" vid="ZEP 1:14">सामर्थ्यशाली योद्धे त्याची रणगर्जना करतील.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />तो दिवस क्रोधाग्नीचा दिवस असेल—</para>
  <para style="q2" vid="ZEP 1:15">तो दिवस दुःखाचा व क्लेशाचा,</para>
  <para style="q3" vid="ZEP 1:15">तो दिवस अरिष्ट व उजाडतेचा,</para>
  <para style="q2" vid="ZEP 1:15">तो दिवस अंधकाराचा व उदासीनतेचा,</para>
  <para style="q3" vid="ZEP 1:15">तो दिवस अभ्रांचा व निबिड काळोखाचा—<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />तो दिवस तटबंदीच्या नगरांविरुद्ध</para>
  <para style="q1" vid="ZEP 1:16">आणि कोपऱ्यातील बुरुजा विरुद्ध</para>
  <para style="q2" vid="ZEP 1:16">रणशिंगाचा व रणगर्जनांच्या निनादांचा असेल.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />“मी सर्व लोकांवर अशा विपत्ती आणेन, ते मार्ग शोधणार्‍या</para>
  <para style="q2" vid="ZEP 1:17">एखाद्या आंधळ्या माणसाप्रमाणे चाचपडतील,</para>
  <para style="q2" vid="ZEP 1:17">कारण त्यांनी याहवेहविरुद्ध पाप केले आहे.</para>
  <para style="q1" vid="ZEP 1:17">त्यांचे रक्त धुळीसारखे ओतले जाईल</para>
  <para style="q2" vid="ZEP 1:17">व त्यांच्या आतड्या शेणासारख्या विखुरतील.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />त्यांचे सोने किंवा त्यांची चांदी</para>
  <para style="q2" vid="ZEP 1:18">त्यांना याहवेहच्या क्रोधापासून</para>
  <para style="q2" vid="ZEP 1:18">वाचवू शकणार नाही.”</para>
  <para style="b" vid="ZEP 1:18" />
  <para style="q1" vid="ZEP 1:18">त्यांच्या ईर्षेच्या अग्नीने</para>
  <para style="q2" vid="ZEP 1:18">संपूर्ण पृथ्वी भस्म होईल,</para>
  <para style="q1" vid="ZEP 1:18">कारण जे सर्व पृथ्वीवर रहिवास करतात</para>
  <para style="q2" vid="ZEP 1:18">त्यांचा ते अकस्मातपणे अंत करतील.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">राष्ट्रांबरोबर यहूदीया आणि यरुशलेमचा न्याय</para>
  <para style="s2">यहूदीयास पश्चात्तापासाठी आव्हान</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />हे निर्लज्ज राष्ट्रा एकत्र ये,</para>
  <para style="q2" vid="ZEP 2:1">स्वतःला एकवटून घे,<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />फर्मानाचा प्रभाव सुरू होण्याआधी</para>
  <para style="q2" vid="ZEP 2:2">आणि तो दिवस वाऱ्याने उडालेल्या भुशासारखा उडून जाण्यापूर्वी,</para>
  <para style="q1" vid="ZEP 2:2">याहवेहचा भयंकर संताप</para>
  <para style="q2" vid="ZEP 2:2">तुझ्यावर कोसळण्यापूर्वी,</para>
  <para style="q1" vid="ZEP 2:2">याहवेहच्या भयानक क्रोधाचा दिवस,</para>
  <para style="q2" vid="ZEP 2:2">तुझ्यावर कोसळण्यापूर्वी एकत्र ये.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />या देशातील नम्रजन हो, याहवेहचा ध्यास करा,</para>
  <para style="q2" vid="ZEP 2:3">तुम्ही जे त्यांच्या आज्ञा पाळता.</para>
  <para style="q1" vid="ZEP 2:3">धार्मिकतेचा ध्यास करा, नम्रतेचा ध्यास करा;</para>
  <para style="q2" vid="ZEP 2:3">याहवेहच्या क्रोधाच्या दिवशी</para>
  <para style="q2" vid="ZEP 2:3">कदाचित तुम्हाला आश्रयस्थान मिळेल.<verse eid="ZEP 2:3" /></para>
  <para style="s2">फिलिस्तिया</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />गाझाचा त्याग करण्यात येईल</para>
  <para style="q2" vid="ZEP 2:4">आणि अष्कलोन ओसाड पडेल.</para>
  <para style="q1" vid="ZEP 2:4">भर दुपारी अश्दोद नगर रिकामे होईल</para>
  <para style="q2" vid="ZEP 2:4">आणि एक्रोन समूळ उपटले जाईल.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />हे करेथीयाच्या लोकांनो,</para>
  <para style="q2" vid="ZEP 2:5">समुद्र किनार्‍यावरील रहिवाशांनो तुम्हाला धिक्कार असो;</para>
  <para style="q1" vid="ZEP 2:5">कनान देशात राहणार्‍या पलिष्टी लोकांनो,</para>
  <para style="q2" vid="ZEP 2:5">याहवेहचे वचन तुमच्याविरुद्ध आहे.</para>
  <para style="q1" vid="ZEP 2:5">ते म्हणतात, “मी तुमचा असा नाश करेन,</para>
  <para style="q2" vid="ZEP 2:5">की तुमच्यातील कोणीही वाचणार नाही.”<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />समुद्रकिनाऱ्याची भूमी एक कुरण बनेल</para>
  <para style="q2" vid="ZEP 2:6">मेंढपाळांसाठी विहिरी असलेले स्थान</para>
  <para style="q2" vid="ZEP 2:6">व मेंढरांसाठी मेंढवाड्याचे ठिकाण होईल.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />ती भूमी यहूदीयाच्या वंशातील</para>
  <para style="q2" vid="ZEP 2:7">अवशेषाचे वतन होईल;</para>
  <para style="q2" vid="ZEP 2:7">तिथे त्यांची कुरणे असतील.</para>
  <para style="q1" vid="ZEP 2:7">संध्याकाळी ते अष्कलोन येथील घरात</para>
  <para style="q2" vid="ZEP 2:7">विश्रांती घेतील.</para>
  <para style="q1" vid="ZEP 2:7">याहवेह, त्यांचे परमेश्वर आपल्या लोकांची काळजी घेतील;</para>
  <para style="q2" vid="ZEP 2:7">त्यांचे पूर्वीचे वैभव त्यांना परत प्राप्त करून देतील.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">त्यांचे बंदिवान मी परत आणेन</char></note><verse eid="ZEP 2:7" /></para>
  <para style="s2">मोआबी आणि अम्मोनी</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“मोआबी लोकांच्या अपमानास्पद गोष्टी</para>
  <para style="q2" vid="ZEP 2:8">आणि अम्मोनी लोकांचे टोमणे मी ऐकले आहेत,</para>
  <para style="q1" vid="ZEP 2:8">जे माझ्या लोकांचा उपहास करतात</para>
  <para style="q2" vid="ZEP 2:8">आणि त्यांच्या प्रदेशाविरुद्ध धमक्याही मी ऐकल्या आहेत.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />म्हणून माझ्या जिवाची शपथ,”</para>
  <para style="q2" vid="ZEP 2:9">इस्राएलचे परमेश्वर,</para>
  <para style="q2" vid="ZEP 2:9">सर्वसमर्थ याहवेह जाहीर करतात.</para>
  <para style="q1" vid="ZEP 2:9">“निश्चितच मोआब हा सदोमासारखा,</para>
  <para style="q2" vid="ZEP 2:9">अम्मोनी गमोरासारखा होईल</para>
  <para style="q1" vid="ZEP 2:9">तण वाढलेले ठिकाण व मिठाची आगरे</para>
  <para style="q2" vid="ZEP 2:9">कायमची ओसाड ठिकाणे होतील.</para>
  <para style="q1" vid="ZEP 2:9">माझे अवशिष्ट लोक त्यांची लूट करतील;</para>
  <para style="q2" vid="ZEP 2:9">माझे अवशिष्ट राष्ट्र त्यांच्या भूमीचे वारस बनतील.”<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />त्यांना त्यांच्या गर्विष्ठपणाचे</para>
  <para style="q2" vid="ZEP 2:10">हे प्रतिफळ मिळेल.</para>
  <para style="q2" vid="ZEP 2:10">कारण त्यांनी सर्वसमर्थ याहवेहच्या लोकांचा अपमान व उपहास केला.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />जेव्हा याहवेह पृथ्वीवरील सर्व दैवतांचा नाश करतील,</para>
  <para style="q2" vid="ZEP 2:11">तेव्हा याहवेह त्यांना भयावह वाटतील.</para>
  <para style="q1" vid="ZEP 2:11">दूरदेशातील सर्व राष्ट्रे आपआपल्या भूमीवर</para>
  <para style="q2" vid="ZEP 2:11">त्यांच्यापुढे नतमस्तक होतील.<verse eid="ZEP 2:11" /></para>
  <para style="s2">कूश<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">कूश अर्थात् </char><char style="fqa" closed="false">इथिओपिया</char></note></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“अहो कूशी<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">नाईल नदीच्या वरच्या भागातील भूमी</char></note> लोकांनो,</para>
  <para style="q2" vid="ZEP 2:12">तुमचाही माझ्या तलवारीने वध होईल.”<verse eid="ZEP 2:12" /></para>
  <para style="s2">अश्शूर</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />ते उत्तरेविरुद्ध आपला हात उगारतील</para>
  <para style="q2" vid="ZEP 2:13">आणि अश्शूरचा नाश करतील,</para>
  <para style="q1" vid="ZEP 2:13">निनवेह नगरीस ते पूर्णपणे ओसाड</para>
  <para style="q2" vid="ZEP 2:13">आणि वाळवंटाप्रमाणे शुष्क ठिकाण करतील.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />कळप व मेंढरे</para>
  <para style="q2" vid="ZEP 2:14">सर्व राष्ट्रांचे प्राणी तिथे विश्रांती घेतील.</para>
  <para style="q1" vid="ZEP 2:14">तिथे वाळवंटातील घुबडे व कर्कश किंचाळणारी घुबडे</para>
  <para style="q2" vid="ZEP 2:14">तिच्या स्तंभावर निवारा घेतील.</para>
  <para style="q1" vid="ZEP 2:14">घुबडांची घूं घूं खिडक्यांमधून प्रतिध्वनित होईल,</para>
  <para style="q2" vid="ZEP 2:14">तिची प्रवेशद्वारे दगडविटांच्या तुकड्यांनी भरलेली असतील,</para>
  <para style="q2" vid="ZEP 2:14">देवदारूचे स्तंभ उघडे बोडके होतील.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />ही नगरी चैनबाजी करणारी,</para>
  <para style="q2" vid="ZEP 2:15">सुरक्षितेत वसणारी होती.</para>
  <para style="q1" vid="ZEP 2:15">ती स्वतःशी म्हणत असे,</para>
  <para style="q2" vid="ZEP 2:15">“मी एकटीच आहे, माझ्यासारखी नगरी जगात दुसरी नाही.”</para>
  <para style="q1" vid="ZEP 2:15">पण आता तिची कशी भग्नावस्था झाली आहे,</para>
  <para style="q2" vid="ZEP 2:15">जंगली श्वापदे राहण्याचे ठिकाण!</para>
  <para style="q1" vid="ZEP 2:15">तिच्याजवळून जाणारे सर्वजण तिचा उपहास करून</para>
  <para style="q2" vid="ZEP 2:15">त्यांचे डोके हलवितात.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s2">यरुशलेम</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />हे जुलमी लोकांच्या नगरी,</para>
  <para style="q2" vid="ZEP 3:1">विद्रोही व भ्रष्ट नगरी, तुला धिक्कार असो!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />ती कोणाचीही आज्ञा पाळत नाही,</para>
  <para style="q2" vid="ZEP 3:2">ती कोणतीही सुधारणा स्वीकारत नाही.</para>
  <para style="q1" vid="ZEP 3:2">ती याहवेहवर विश्वास ठेवीत नाही,</para>
  <para style="q2" vid="ZEP 3:2">ती तिच्या परमेश्वराच्या समीप जात नाही.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />तिच्यामध्ये असलेले तिचे अधिकारी</para>
  <para style="q2" vid="ZEP 3:3">गर्जना करणार्‍या सिंहासारखे आहेत;</para>
  <para style="q1" vid="ZEP 3:3">तिचे शासनकर्ते निशाचर लांडगे आहेत</para>
  <para style="q2" vid="ZEP 3:3">ते सकाळपर्यंत काहीही शिल्लक राहू देत नाहीत.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />तिचे संदेष्टे अधर्म करणारे आहेत;</para>
  <para style="q2" vid="ZEP 3:4">ते विश्वासघातकी लोक आहेत.</para>
  <para style="q1" vid="ZEP 3:4">तिचे याजक मंदिर अपवित्र करतात</para>
  <para style="q2" vid="ZEP 3:4">ते आज्ञेचे उल्लंघन करतात.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />परंतु तिच्यात असणारे याहवेह नीतिमान आहेत;</para>
  <para style="q2" vid="ZEP 3:5">ते काहीही अयोग्य करीत नाहीत.</para>
  <para style="q1" vid="ZEP 3:5">प्रतिदिन सकाळी ते त्यांचे न्यायदान करतात,</para>
  <para style="q2" vid="ZEP 3:5">आणि कोणत्याही नवदिनी ते असफल होत नाहीत,</para>
  <para style="q2" vid="ZEP 3:5">तरी अधर्म्यांना लाज काय ते ठाऊकच नाही.<verse eid="ZEP 3:5" /></para>
  <para style="s2">यरुशलेम पश्चात्ताप करणे नाकारते</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“मी अनेक राष्ट्रांचा नाश केला;</para>
  <para style="q2" vid="ZEP 3:6">त्यांच्या गडांना उद्ध्वस्त केले आहे.</para>
  <para style="q1" vid="ZEP 3:6">मी त्यांचे रस्ते ओसाड केले आहेत</para>
  <para style="q2" vid="ZEP 3:6">तिथून कोणीही प्रवास करीत नाही.</para>
  <para style="q1" vid="ZEP 3:6">आणि त्यांची शहरे निर्जन केली आहेत;</para>
  <para style="q2" vid="ZEP 3:6">ते त्यागलेले व रिकामे झाले आहेत.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />यरुशलेमबद्दल मी विचार केला,</para>
  <para style="q2" vid="ZEP 3:7">‘निश्चितच तू माझे भय धरशील;</para>
  <para style="q2" vid="ZEP 3:7">आणि माझ्या सुधारणांचा स्वीकार करशील!’</para>
  <para style="q1" vid="ZEP 3:7">तेव्हा तिचे आश्रयस्थान<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">तिचे पवित्रस्थान</char></note> उद्ध्वस्त होणार नाही.</para>
  <para style="q2" vid="ZEP 3:7">माझ्या सर्व शिक्षा तिच्यावर येणार नाहीत,</para>
  <para style="q1" vid="ZEP 3:7">पण तरीही पूर्वीसारखीच</para>
  <para style="q2" vid="ZEP 3:7">भ्रष्टाचारी दुष्कर्मे करण्यास ती उत्सुक आहे.”<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />याहवेह जाहीर करतात, “म्हणून माझी वाट पाहा,</para>
  <para style="q2" vid="ZEP 3:8">त्या दिवशी मी दोषारोप करण्यास<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">लूट घेण्यास</char></note> उभा राहीन.</para>
  <para style="q1" vid="ZEP 3:8">पृथ्वीवरील सर्व राज्ये व राष्ट्रे</para>
  <para style="q2" vid="ZEP 3:8">एकत्र करण्याचा मी निर्धार केला आहे</para>
  <para style="q1" vid="ZEP 3:8">आणि त्यांच्यावर माझ्या कोपाचा वर्षाव करेन;</para>
  <para style="q2" vid="ZEP 3:8">माझ्या अत्यंत तीव्र क्रोधाग्नीने</para>
  <para style="q1" vid="ZEP 3:8">आणि माझ्या ईर्षेच्या अग्नीने</para>
  <para style="q2" vid="ZEP 3:8">संपूर्ण विश्व जळून भस्म होईल.<verse eid="ZEP 3:8" /></para>
  <para style="s1">इस्राएलच्या अवशेषाचे पुनर्स्थापन</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />“मग मी त्यांच्या ओठांचे शुद्धीकरण करेन,</para>
  <para style="q2" vid="ZEP 3:9">असे की ते सर्व याहवेहच्या नामाचा धावा करतील</para>
  <para style="q2" vid="ZEP 3:9">आणि खांद्याला खांदा लावून त्यांची सेवा करतील.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />कूश देशाच्या नद्यांपलीकडून</para>
  <para style="q2" vid="ZEP 3:10">माझे उपासक, माझे विखुरलेले लोक</para>
  <para style="q2" vid="ZEP 3:10">माझ्यासाठी अर्पणे आणतील.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />त्या दिवशी तू यरुशलेमा, माझ्याविरुद्ध जे काही दुष्कृत्य केलेस,</para>
  <para style="q2" vid="ZEP 3:11">त्याबद्दल तू लज्जित केली जाणार नाही,</para>
  <para style="q1" vid="ZEP 3:11">तेव्हा तू माझ्याविरुद्ध बंड करणारी अशी राहणारच नाहीस.</para>
  <para style="q2" vid="ZEP 3:11">कारण मी तुझ्यातील सर्व गर्वाने उन्मत्त झालेली माणसे काढून टाकेन.</para>
  <para style="q1" vid="ZEP 3:11">माझ्या पवित्र पर्वतावर पुन्हा कधीही</para>
  <para style="q2" vid="ZEP 3:11">गर्विष्ठपणा केला जाणार नाही.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />मी तुझ्यामध्ये जे गरीब व दीन,</para>
  <para style="q2" vid="ZEP 3:12">असेच अवशिष्ट लोक ठेवेन.</para>
  <para style="q1" vid="ZEP 3:12">इस्राएलचे अवशिष्ट लोक असतील आणि ते</para>
  <para style="q2" vid="ZEP 3:12">याहवेहच्या नामात आश्रय घेतील.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />इस्राएलमधील उरलेले कोणतेही दुष्कृत्य करणार नाहीत;</para>
  <para style="q2" vid="ZEP 3:13">ते असत्य बोलणार नाहीत.</para>
  <para style="q1" vid="ZEP 3:13">लबाडी करणारी जीभ</para>
  <para style="q2" vid="ZEP 3:13">त्यांच्या मुखात असणार नाही.</para>
  <para style="q1" vid="ZEP 3:13">ते अन्न सेवन करून विसावा घेतील</para>
  <para style="q2" vid="ZEP 3:13">आणि त्यांना कोणीही भीती दाखविणार नाही.”<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />हे सीयोनकन्ये, तू गीत गा;</para>
  <para style="q2" vid="ZEP 3:14">हे इस्राएला, तू मोठ्याने गजर कर!</para>
  <para style="q1" vid="ZEP 3:14">अगे यरुशलेमकन्ये,</para>
  <para style="q2" vid="ZEP 3:14">अगदी मनापासून आनंद कर, उल्लास कर.<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />कारण याहवेहने तुझी शिक्षा काढून घेतली आहे,</para>
  <para style="q2" vid="ZEP 3:15">तुझ्या शत्रूचे सैन्य परत गेले आहे.</para>
  <para style="q1" vid="ZEP 3:15">याहवेह, इस्राएलचे राजा तुझ्यासह आहेत;</para>
  <para style="q2" vid="ZEP 3:15">यापुढे हानीचे भय तू बाळगणार नाही.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />त्या दिवशी</para>
  <para style="q2" vid="ZEP 3:16">ते यरुशलेमला असे म्हणतील,</para>
  <para style="q1" vid="ZEP 3:16">“हे सीयोना, भिऊ नकोस,</para>
  <para style="q2" vid="ZEP 3:16">तुझे बाहू दुर्बल होऊ देऊ नकोस.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />महाप्रतापी योद्धा जे रक्षणकर्ता आहेत,</para>
  <para style="q2" vid="ZEP 3:17">ते याहवेह तुझे परमेश्वर तुझ्यासह आहेत.</para>
  <para style="q1" vid="ZEP 3:17">त्यांना तुझ्यामुळे अत्यंत आनंद होतो;</para>
  <para style="q2" vid="ZEP 3:17">तुझ्यावरील प्रीतीमुळे ते तुजवर दोषारोपण करणार नाहीत.</para>
  <para style="q2" vid="ZEP 3:17">त्याऐवजी तुझ्याबद्दल ते गीत गाऊन उल्हास व्यक्त करतील.”<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />“जे निर्धारित सण तुझ्याकरिता ओझे व कलंक आहेत,</para>
  <para style="q2" vid="ZEP 3:18">ते सण साजरे करता आले नाही म्हणून जे लोक शोक करतात,</para>
  <para style="q2" vid="ZEP 3:18">त्या सर्वांना मी तुझ्यामधून काढून टाकेन.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />त्या समयी ज्यांनी तुझ्यावर जुलूम केला त्यांना मी अतिशय कडक शिक्षा करेन.</para>
  <para style="q2" vid="ZEP 3:19">त्या सर्वांचा मी जाब घेईन.</para>
  <para style="q1" vid="ZEP 3:19">जे लंगडे आहेत त्यांची मी सोडवणूक करेन;</para>
  <para style="q2" vid="ZEP 3:19">बंदिवासात गेलेल्यांना मी एकत्र करेन.</para>
  <para style="q1" vid="ZEP 3:19">जिथे ते लज्जित झाले त्या प्रत्येक भूमीवर</para>
  <para style="q2" vid="ZEP 3:19">त्यांना मी प्रशंसा व गौरव बहाल करेन.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />त्यावेळी मी तुम्हा सर्वांना एकत्र गोळा करेन;</para>
  <para style="q2" vid="ZEP 3:20">त्यावेळी मी तुम्हाला घरी परत आणेन.</para>
  <para style="q1" vid="ZEP 3:20">जेव्हा मी तुमची संपन्नता तुम्हाला परत देईन</para>
  <para style="q2" vid="ZEP 3:20">तेव्हा पृथ्वीवरील सर्व लोकांमध्ये,</para>
  <para style="q1" vid="ZEP 3:20">स्वतःच्या दृष्टीसमोर</para>
  <para style="q2" vid="ZEP 3:20">मी तुम्हाला गौरव व प्रशंसा बहाल करेन,”</para>
  <para style="q2" vid="ZEP 3:20">असे याहवेह म्हणतात.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>