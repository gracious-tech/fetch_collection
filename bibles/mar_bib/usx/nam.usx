<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Biblica® Open Marathi Contemporary Version</book>
  <para style="h">नहूम</para>
  <para style="toc1">नहूमाची भविष्यवाणी</para>
  <para style="toc2">नहूम</para>
  <para style="toc3">नहूम</para>
  <para style="mt1">नहूमाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="NAM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1"/>निनवेहविषयी भविष्यवाणी. एल्कोशवासी नहूमच्या दृष्टान्ताचे पुस्तक.<verse eid="NAM 1:1"/></para>
  <para style="b"/>
  <para style="s1">निनवेहविषयी याहवेहचा क्रोध</para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 1:2"/>याहवेह ईर्ष्यावान व सूड घेणारे परमेश्वर आहेत;</para>
  <para style="q2" vid="NAM 1:2">याहवेह सूड घेणारे आणि क्रोधाने भरलेले आहेत.</para>
  <para style="q1" vid="NAM 1:2">त्यांच्या शत्रूंचा ते सूड घेतात</para>
  <para style="q2" vid="NAM 1:2">आणि आपला कोप त्यांच्याविरुद्ध मोकळा करतात.<verse eid="NAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 1:3"/>याहवेह मंदक्रोध आहेत, पण अत्यंत सामर्थ्यशाली आहेत;</para>
  <para style="q2" vid="NAM 1:3">याहवेह दुष्टांना शिक्षा दिल्याशिवाय सोडत नाही.</para>
  <para style="q1" vid="NAM 1:3">त्यांचे मार्ग चक्रीवादळ व वादळामधून जातात.</para>
  <para style="q2" vid="NAM 1:3">ढग त्यांच्या पायाखालची धूळ आहेत.<verse eid="NAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 1:4"/>ते समुद्रास फटकारतात आणि तो शुष्क होतो;</para>
  <para style="q2" vid="NAM 1:4">ते सर्व नद्यांना कोरडे करतात.</para>
  <para style="q1" vid="NAM 1:4">बाशान व कर्मेल मलूल होतात;</para>
  <para style="q2" vid="NAM 1:4">लबानोनचा मोहोर कोमेजतो.<verse eid="NAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 1:5"/>त्यांच्यासमोर पर्वत कंपित होतात</para>
  <para style="q2" vid="NAM 1:5">व टेकड्या विरघळतात.</para>
  <para style="q1" vid="NAM 1:5">पृथ्वी आणि जग व त्यात राहणारे सर्वजण</para>
  <para style="q2" vid="NAM 1:5">त्यांच्या समक्षतेत थरकापतात.<verse eid="NAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 1:6"/>संतप्त याहवेहपुढे कोणाचा निभाव लागेल?</para>
  <para style="q2" vid="NAM 1:6">त्यांचा क्रोध कोण सहन करू शकेल?</para>
  <para style="q1" vid="NAM 1:6">त्यांचा उग्र क्रोध अग्नीसारखा ओतला जातो;</para>
  <para style="q2" vid="NAM 1:6">त्यांच्यापुढे खडक ढासळून पडतात.<verse eid="NAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 1:7"/>याहवेह चांगले आहेत,</para>
  <para style="q2" vid="NAM 1:7">संकटसमयी आश्रयस्थान आहेत.</para>
  <para style="q1" vid="NAM 1:7">त्यांच्यावर भरवसा ठेवणार्‍या प्रत्येकाची ते काळजी घेतात.<verse eid="NAM 1:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="NAM 1:8"/>परंतु भयंकर महापुराने</para>
  <para style="q1" vid="NAM 1:8">ते निनवेहचा अंत करतील;</para>
  <para style="q2" vid="NAM 1:8">त्यांच्या शत्रूचा ते अंधकाराच्या साम्राज्यातही पाठलाग करतात.<verse eid="NAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 1:9"/>याहवेहच्या विरुद्ध ते जे काही कारस्थान करतात<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">तुम्ही जे शत्रू ते याहवेहविरुद्ध काय कट रचता?</char></note></para>
  <para style="q2" vid="NAM 1:9">त्याचा ते अंत करतील;</para>
  <para style="q2" vid="NAM 1:9">ते संकट दुसऱ्यांदा येणार नाही.<verse eid="NAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 1:10"/>याहवेहचे शत्रू काटेरी झुडूपात गुंतून पडतील</para>
  <para style="q2" vid="NAM 1:10">आणि स्वतःचेच मद्य पिऊन ते धुंद होतील;</para>
  <para style="q2" vid="NAM 1:10">वाळलेल्या गवताप्रमाणे ते अग्नीमध्ये भस्म होतील.<verse eid="NAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 1:11"/>हे निनवेह, तुमच्यापैकी कोण आहे</para>
  <para style="q2" vid="NAM 1:11">जो याहवेहविरुद्ध कट रचेल</para>
  <para style="q2" vid="NAM 1:11">आणि दुष्ट योजना करू शकेल?<verse eid="NAM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="NAM 1:12"/>याहवेह असे म्हणतात:</para>
  <para style="q1" vid="NAM 1:12">“यद्यपि त्यांना अनेक दोस्त राष्ट्र आहेत व ते असंख्य आहेत,</para>
  <para style="q2" vid="NAM 1:12">तरी ते नष्ट होतील व त्यांचे अस्तित्व नाहीसे होईल.</para>
  <para style="q1" vid="NAM 1:12">हे यहूदाह, मी जरी तुला पीडित केले,</para>
  <para style="q2" vid="NAM 1:12">तरी आता मी तुला पीडा देणार नाही.<verse eid="NAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 1:13"/>आता मी तुमच्या मानेवरील जू मोडून टाकीन</para>
  <para style="q2" vid="NAM 1:13">आणि तुमच्या शृंखला तोडून टाकीन.”<verse eid="NAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 1:14"/>हे निनवेह, याहवेहने तुझ्याविषयी आज्ञा दिली आहे:</para>
  <para style="q2" vid="NAM 1:14">“तुझे नाव पुढे चालविणारी कोणीही संतती राहणार नाही.</para>
  <para style="q1" vid="NAM 1:14">आणि जी तुझ्या दैवताच्या मंदिरात आहेत</para>
  <para style="q2" vid="NAM 1:14">ती तुझी दैवते आणि मूर्ती मी नष्ट करेन.</para>
  <para style="q1" vid="NAM 1:14">मी तुझी कबर तयार करेन,</para>
  <para style="q2" vid="NAM 1:14">कारण तू तिरस्करणीय आहेस.”<verse eid="NAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 1:15"/>पाहा, पर्वतांवरून संदेशवाहक येत आहेत,</para>
  <para style="q2" vid="NAM 1:15">ज्यांची पावले एक शुभवार्ता आणत आहेत,</para>
  <para style="q2" vid="NAM 1:15">जे शांतीची घोषणा करतात!</para>
  <para style="q1" vid="NAM 1:15">हे यहूदाह, तू तुझे सण साजरे कर,</para>
  <para style="q2" vid="NAM 1:15">आणि तुझे नवस फेड.</para>
  <para style="q1" vid="NAM 1:15">कारण आता कोणी दुष्ट लोक तुझ्यावर आक्रमण करणार नाहीत;</para>
  <para style="q2" vid="NAM 1:15">त्यांचा कायमचा उच्छेद होईल.<verse eid="NAM 1:15"/></para>
  <chapter eid="NAM 1"/>
  <chapter number="2" style="c" sid="NAM 2"/>
  <para style="s1">निनवेहचा पाडाव</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 2:1"/>हे निनवेह, एक आक्रमक तुझ्याविरुद्ध येत आहे.</para>
  <para style="q2" vid="NAM 2:1">आपल्या गडांवर पहारा दे,</para>
  <para style="q2" vid="NAM 2:1">मार्गांची रखवाली कर,</para>
  <para style="q2" vid="NAM 2:1">मोर्चा बांध,</para>
  <para style="q2" vid="NAM 2:1">आपल्या सर्व शक्तिनिशी सैन्यांची संरक्षक फळी मजबूत कर!<verse eid="NAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 2:2"/>जरी संहारकाने तो देश उद्ध्वस्त केला आहे</para>
  <para style="q2" vid="NAM 2:2">आणि त्यांचे द्राक्षमळे नष्ट केले आहेत तरी,</para>
  <para style="q1" vid="NAM 2:2">इस्राएलच्या वैभवासारखे</para>
  <para style="q2" vid="NAM 2:2">याहवेह याकोबाचे वैभव पुनर्स्थापित करणार आहेत.<verse eid="NAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 2:3"/>ज्या दिवसाची त्यांनी तयारी केली आहे;</para>
  <para style="q2" vid="NAM 2:3">त्या दिवसासाठी रथांवरील धातू चकाकत आहेत,</para>
  <para style="q1" vid="NAM 2:3">सैनिकांच्या ढाली तांबड्या आहेत;</para>
  <para style="q2" vid="NAM 2:3">योद्धे किरमिजी पेहराव केलेले आहेत</para>
  <para style="q2" vid="NAM 2:3">सनोवरचे भाले परजलेले आहेत.<verse eid="NAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 2:4"/>रथही मार्गांवरून बेफामपणे धावत आहेत,</para>
  <para style="q2" vid="NAM 2:4">चौकातून झपाट्याने मागेपुढे होत आहेत.</para>
  <para style="q1" vid="NAM 2:4">ते प्रज्वलित मशालीप्रमाणे दिसत आहेत;</para>
  <para style="q2" vid="NAM 2:4">ते वीजगतीने दौडत आहेत.<verse eid="NAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 2:5"/>निनवेहने आपल्या निवडक सैनिकांना पाचारण केले आहे,</para>
  <para style="q2" vid="NAM 2:5">तरी ते आपल्या मार्गांवर अडखळत आहेत.</para>
  <para style="q1" vid="NAM 2:5">ते तटाच्या भिंतीकडे धाव घेतात;</para>
  <para style="q2" vid="NAM 2:5">संरक्षक ढाल नियोजित ठिकाणी ठेवलेली आहे.<verse eid="NAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 2:6"/>नदीकडचे दरवाजे सताड उघडले गेले आहेत</para>
  <para style="q2" vid="NAM 2:6">आणि राजवाडे ढासळत आहेत.<verse eid="NAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 2:7"/>अशी राजाज्ञा सुनावण्यात आली आहे,</para>
  <para style="q2" vid="NAM 2:7">की निनवेहला बंदिवासात टाकून नेण्यात यावे.</para>
  <para style="q1" vid="NAM 2:7">तिच्या दासी पारव्यांच्या घुमण्याप्रमाणे विलाप करीत आहेत</para>
  <para style="q2" vid="NAM 2:7">आणि त्यांचे ऊर बडवित आहेत.<verse eid="NAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 2:8"/>निनवेह एखाद्या जलाशयाप्रमाणे आहे</para>
  <para style="q2" vid="NAM 2:8">जिचे पाणी गळून चालले आहे.</para>
  <para style="q1" vid="NAM 2:8">“थांबा, थांबा,” ते ओरडतात,</para>
  <para style="q2" vid="NAM 2:8">पण कोणीही वळून तिच्याकडे परत येत नाही.<verse eid="NAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 2:9"/>चांदी लुटा!</para>
  <para style="q2" vid="NAM 2:9">सोने लुटा!</para>
  <para style="q1" vid="NAM 2:9">निनवेहची संपत्ती</para>
  <para style="q2" vid="NAM 2:9">येथील मौल्यवान वस्तूंचा अमर्याद संग्रह आहे!<verse eid="NAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 2:10"/>ती लुटल्या गेली, लुबाडल्या गेली व विवस्त्र करण्यात आली आहे!</para>
  <para style="q2" vid="NAM 2:10">तिच्या लोकांची अंतःकरणे वितळून गेली आहेत व गुडघे निकामी झाले आहेत,</para>
  <para style="q2" vid="NAM 2:10">त्यांची शरीरे थरथर कापत आहेत व त्यांचे चेहरे फिके पडले आहेत.<verse eid="NAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 2:11"/>ती सिंहाची गुहा कुठे आहे</para>
  <para style="q2" vid="NAM 2:11">जिथे ते त्यांच्या बछड्यांचे पालनपोषण करीत असत,</para>
  <para style="q1" vid="NAM 2:11">जिथे सिंह आणि सिंहिणी जातात, कोवळी मुलेदेखील निर्भयतेने राहात असत,</para>
  <para style="q2" vid="NAM 2:11">आणि त्यांच्या बछड्यांना कशाचेही भय नसे?<verse eid="NAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 2:12"/>सिंह आपल्या बछड्यांना पुरेलशी शिकार करत असे</para>
  <para style="q2" vid="NAM 2:12">व आपल्या सिंहिणींना भक्ष्य पुरविण्यासाठी सावजाची नरडी दाबून ठार मारत असे,</para>
  <para style="q1" vid="NAM 2:12">आपल्या गुहेत ते जमा करीत असत</para>
  <para style="q2" vid="NAM 2:12">आणि आपली गुहा भक्षांनी भरून टाकीत असत.<verse eid="NAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 2:13"/>सर्वसमर्थ याहवेह जाहीर करतात:</para>
  <para style="q2" vid="NAM 2:13">“मी तुझ्याविरुद्ध उठलो आहे,</para>
  <para style="q1" vid="NAM 2:13">मी तुझे रथ भस्म करून त्यांचा धूर करेन,</para>
  <para style="q2" vid="NAM 2:13">आणि तलवार तुझ्या सिंहाच्या बछड्यांना गिळंकृत करेल.</para>
  <para style="q2" vid="NAM 2:13">मी पृथ्वीवर तुझ्यासाठी एकही भक्ष ठेवणार नाही.</para>
  <para style="q1" vid="NAM 2:13">तुझ्या संदेशवाहकांचे आवाज</para>
  <para style="q2" vid="NAM 2:13">यापुढे कधीही ऐकू येणार नाहीत.”<verse eid="NAM 2:13"/></para>
  <chapter eid="NAM 2"/>
  <chapter number="3" style="c" sid="NAM 3"/>
  <para style="s1">निनवेहला धिक्कार असो</para>
  <para style="q1">
    <verse number="1" style="v" sid="NAM 3:1"/>हे रक्तपात करणाऱ्या नगरी, तुला धिक्कार असो,</para>
  <para style="q2" vid="NAM 3:1">लबाड्यांनी गच्च भरलेली,</para>
  <para style="q1" vid="NAM 3:1">लूटमाऱ्यांनी भरलेली,</para>
  <para style="q2" vid="NAM 3:1">कधीही पीडितांशिवाय नसणारी!<verse eid="NAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="NAM 3:2"/>चाबकांच्या फटकार्‍यांचा आवाज,</para>
  <para style="q2" vid="NAM 3:2">चाकांचा खडखडाट,</para>
  <para style="q1" vid="NAM 3:2">चौखूर धावणारे घोडे</para>
  <para style="q2" vid="NAM 3:2">आणि हिसके देणारे रथ!<verse eid="NAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="NAM 3:3"/>आक्रमक घोडेस्वारांची पलटण</para>
  <para style="q2" vid="NAM 3:3">लखलखणार्‍या तलवारी</para>
  <para style="q2" vid="NAM 3:3">चमचमणारे भाले!</para>
  <para style="q1" vid="NAM 3:3">पडलेली अनेक प्रेते,</para>
  <para style="q2" vid="NAM 3:3">सर्वत्र मृतांचे ढीग,</para>
  <para style="q1" vid="NAM 3:3">अगणित मृत शरीरे,</para>
  <para style="q2" vid="NAM 3:3">प्रेतांना अडखळून पडणारे लोक—<verse eid="NAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="NAM 3:4"/>या सर्वांचे कारण, एका वेश्येच्या रंगेलपणाची वासना,</para>
  <para style="q2" vid="NAM 3:4">ती भुलविणारी, जादूटोण्याची स्वामिनी आहे,</para>
  <para style="q1" vid="NAM 3:4">तिने आपल्या वेश्यागिरीने राष्ट्रांना</para>
  <para style="q2" vid="NAM 3:4">आणि जादूटोण्याने लोकांना गुलाम बनविले.<verse eid="NAM 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="NAM 3:5"/>सर्वसमर्थ याहवेह जाहीर करतात, “मी तुझ्याविरुद्ध आहे,</para>
  <para style="q2" vid="NAM 3:5">मी तुझे वस्त्र तुझ्या चेहऱ्यावर उचलेन.</para>
  <para style="q1" vid="NAM 3:5">तुझी नग्नता सर्व राष्ट्रांना</para>
  <para style="q2" vid="NAM 3:5">आणि तुझी लज्जा सर्व देशांना दाखवेन.<verse eid="NAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="NAM 3:6"/>मी तुझ्यावर घृणास्पद गोष्टी फेकेन,</para>
  <para style="q2" vid="NAM 3:6">मी तुला अपमानित करेन</para>
  <para style="q2" vid="NAM 3:6">आणि तुला तमाशा बनवेन.<verse eid="NAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="NAM 3:7"/>तुला पाहणारे सर्व भयभीत होऊन तुझ्यापासून दूर पळतील व म्हणतील,</para>
  <para style="q2" vid="NAM 3:7">‘निनवेह उद्ध्वस्त झाली आहे—तिच्यासाठी कोण शोक करेल?’</para>
  <para style="q2" vid="NAM 3:7">तुझे सांत्वन करणारा मला कुठे मिळेल?”<verse eid="NAM 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="NAM 3:8"/>नाईल नदीकाठी वसलेल्या,</para>
  <para style="q2" vid="NAM 3:8">सर्व बाजूंनी पाण्याने घेरलेल्या</para>
  <para style="q2" vid="NAM 3:8">थेबेस नगरीपेक्षा तू अधिक चांगली आहेस काय?</para>
  <para style="q1" vid="NAM 3:8">नदीच तिला संरक्षण देते,</para>
  <para style="q2" vid="NAM 3:8">नदीच तिची तटबंदी आहे.<verse eid="NAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="NAM 3:9"/>कूश<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">नाईल नदीचा वरचा भाग</char></note> आणि इजिप्त तिचे अपरिमित सामर्थ्य होते;</para>
  <para style="q2" vid="NAM 3:9">पूट व लिबिया तिच्या मित्रराष्ट्रांपैकी होते.<verse eid="NAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="NAM 3:10"/>असे असूनही थीब्जचा पाडाव झाला</para>
  <para style="q2" vid="NAM 3:10">आणि तिला बंदिवासात नेण्यात आले.</para>
  <para style="q1" vid="NAM 3:10">तिची बालके रस्त्यांच्या प्रत्येक कोपऱ्यावर</para>
  <para style="q2" vid="NAM 3:10">दगडांवर आपटून ठार मारण्यात आली.</para>
  <para style="q1" vid="NAM 3:10">तिच्या अधिकार्‍यांसाठी चिठ्ठ्या टाकण्यात आल्या,</para>
  <para style="q2" vid="NAM 3:10">तिच्या सर्व प्रतिष्ठित व्यक्तींना साखळदंडानी बांधण्यात आले.<verse eid="NAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="NAM 3:11"/>तू देखील मद्यपीप्रमाणे धुंद होशील;</para>
  <para style="q2" vid="NAM 3:11">तू लपून बसशील</para>
  <para style="q2" vid="NAM 3:11">आणि सुरक्षिततेसाठी तुझ्या शत्रूपासून आश्रय शोधशील.<verse eid="NAM 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="NAM 3:12"/>तुझे सर्व गड अंजिरांच्या झाडासारखे होतील</para>
  <para style="q2" vid="NAM 3:12">त्यांच्या प्रथम पिकलेल्या फळांगत;</para>
  <para style="q1" vid="NAM 3:12">जेव्हा ते हलविले जातात,</para>
  <para style="q2" vid="NAM 3:12">तेव्हा ते नेमके खाणाऱ्याच्या तोंडात पडतात.<verse eid="NAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="NAM 3:13"/>तुझ्या सैन्य-दलांकडे पाहा—</para>
  <para style="q2" vid="NAM 3:13">ते सर्व दुर्बल आहेत.</para>
  <para style="q1" vid="NAM 3:13">तुझ्या देशाच्या वेशी</para>
  <para style="q2" vid="NAM 3:13">तुझ्या शत्रूंसाठी सताड उघडलेल्या आहेत;</para>
  <para style="q2" vid="NAM 3:13">तुझ्या वेशीच्या सळया अग्नीने भस्म केल्या आहेत.<verse eid="NAM 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="NAM 3:14"/>तुला पडणार्‍या वेढ्यासाठी पाण्याचा साठा करून ठेव,</para>
  <para style="q2" vid="NAM 3:14">तुझे किल्ले मजबूत कर!</para>
  <para style="q1" vid="NAM 3:14">चिखल तुडवून ठेव,</para>
  <para style="q2" vid="NAM 3:14">चिखलाचा गारा साच्यांत भर,</para>
  <para style="q2" vid="NAM 3:14">वीटकाम दुरुस्त कर!<verse eid="NAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="NAM 3:15"/>तिथे तुला अग्नी भस्म करेल;</para>
  <para style="q2" vid="NAM 3:15">तलवार तुला कापून टाकेल—</para>
  <para style="q2" vid="NAM 3:15">एखाद्या टोळधाडीप्रमाणे ते तुला गिळंकृत करतील.</para>
  <para style="q1" vid="NAM 3:15">नाकतोड्यासारखे बहुगुणित व्हा,</para>
  <para style="q2" vid="NAM 3:15">टोळांसारखे बहुगुणित व्हा!<verse eid="NAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="NAM 3:16"/>तू तुझ्या व्यापार्‍यांची संख्या वाढविली आहे</para>
  <para style="q2" vid="NAM 3:16">त्यांची संख्या आकाशातील तार्‍यांपेक्षाही जास्त वाढली आहे,</para>
  <para style="q1" vid="NAM 3:16">परंतु ते एखाद्या टोळधाडीप्रमाणे संपूर्ण भूमी ओरबाडून टाकतात</para>
  <para style="q2" vid="NAM 3:16">व मग ते उडून जातात.<verse eid="NAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="NAM 3:17"/>तुझे रक्षक टोळांसारखे आहेत,</para>
  <para style="q2" vid="NAM 3:17">तुझे अधिकारी टोळांच्या झुंडीप्रमाणे आहेत</para>
  <para style="q2" vid="NAM 3:17">थंडीच्या दिवसात ते भिंतीमध्ये वसतात—</para>
  <para style="q1" vid="NAM 3:17">पण सूर्योदय होताच उडून जातात,</para>
  <para style="q2" vid="NAM 3:17">आणि कुठे जातात ते कोणालाच कळत नाही.<verse eid="NAM 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="NAM 3:18"/>हे अश्शूरच्या राजा, तुझे मेंढपाळ<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">अधिपती</char></note> डुलकी घेतात;</para>
  <para style="q2" vid="NAM 3:18">तुझे प्रतिष्ठित लोक विश्रांती घेण्यासाठी पहुडले आहेत.</para>
  <para style="q1" vid="NAM 3:18">तुझे लोक डोंगरांवर विखुरले आहेत</para>
  <para style="q2" vid="NAM 3:18">त्यांना एकत्र करण्यास कोणीही नाही.<verse eid="NAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="NAM 3:19"/>तुला कशानेही आरोग्य मिळणार नाही;</para>
  <para style="q2" vid="NAM 3:19">तुझी जखम घातक आहे.</para>
  <para style="q1" vid="NAM 3:19">तुझ्या दुर्दशेची बातमी जे कोणी ऐकतील</para>
  <para style="q2" vid="NAM 3:19">ते सर्वजण आनंदाने टाळ्या वाजवितील,</para>
  <para style="q1" vid="NAM 3:19">तुझ्या क्रूरतेचा उपद्रव ज्याला झाला नाही,</para>
  <para style="q2" vid="NAM 3:19">असा कोण आहे?<verse eid="NAM 3:19"/></para>
  <chapter eid="NAM 3"/>
</usx>
