<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Marathi Contemporary Version</book>
  
  <para style="h">1 इतिहास</para>
  <para style="toc1">1 इतिहास</para>
  <para style="toc2">1 इतिहास</para>
  <para style="toc3">1 इति</para>
  <para style="mt1">1 इतिहास</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">आदामापासून अब्राहामापर्यंतची ऐतिहासिक नोंदी</para>
  <para style="s2">नोआहच्या पुत्रांपर्यंत</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1" />आदाम, शेथ, अनोश,<verse eid="1CH 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2" />केनान, महलालेल, यारेद,<verse eid="1CH 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3" />हनोख, मथुशेलह, लामेख,</para>
  <para style="li1" vid="1CH 1:3">नोआह.<verse eid="1CH 1:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4" />नोआहाचे पुत्र: शेम, हाम व याफेथ.<verse eid="1CH 1:4" /></para>
  <para style="s2">याफेथाचा वंश</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5" />याफेथाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:5">गोमेर, मागोग, मादय, यावान, तूबाल, मेशेख व तीरास.<verse eid="1CH 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6" />गोमेरचे पुत्र:</para>
  <para style="li2" vid="1CH 1:6">आष्कनाज, रीपाथ<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">दीपाथ</char></note> व तोगर्माह.<verse eid="1CH 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7" />यावानाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:7">एलिशाह, तार्शीश, कित्तीम व रोदानीम.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">दोदानीम</char></note><verse eid="1CH 1:7" /></para>
  <para style="s2">हामाचा वंश</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8" />हामाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:8">कूश, इजिप्त, पूट व कनान.<verse eid="1CH 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9" />कूशाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:9">सबा, हवीला, साब्ता, रामाह व साब्तेका.</para>
  <para style="li1" vid="1CH 1:9">रामाहचे पुत्र:</para>
  <para style="li2" vid="1CH 1:9">शबा व ददान.<verse eid="1CH 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10" />कूश निम्रोदचा पिता होता,</para>
  <para style="li2" vid="1CH 1:10">जो पृथ्वीवरील एक वीर व्यक्ती झाला.<verse eid="1CH 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11" />इजिप्तचे पुत्र:</para>
  <para style="li2" vid="1CH 1:11">लूदीम, अनामीम, लहाबीम, नाप्तुहीम, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />पात्रुसीम, कास्लूहीम (ज्यापासून पलिष्टी लोक आले) आणि कफतोरीम.<verse eid="1CH 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13" />कनान यांचा पिता होता:</para>
  <para style="li2" vid="1CH 1:13">प्रथमपुत्र सीदोन, आणि हेथ, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />यबूसी, अमोरी, गिर्गाशी, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />हिव्वी, आर्की, सीनी, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />अर्वादी, समारी व हमाथी.<verse eid="1CH 1:16" /></para>
  <para style="s2">शेमचे वंश</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17" />शेमचे पुत्र:</para>
  <para style="li2" vid="1CH 1:17">एलाम, अश्शूर, अर्पक्षद, लूद व अराम.</para>
  <para style="li1" vid="1CH 1:17">अरामाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:17">ऊस, हूल, गेतेर व मेशेख.<verse eid="1CH 1:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18" />अर्पक्षद हा शेलाहचा पिता झाला,</para>
  <para style="li2" vid="1CH 1:18">व शेलाह एबरचा पिता झाला.<verse eid="1CH 1:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19" />एबरला दोन पुत्र झाले:</para>
  <para style="li2" vid="1CH 1:19">एकाचे नाव पेलेग<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">पेलेग </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">विभागणी</char></note> ठेवले, कारण याच्या हयातीत पृथ्वीची विभागणी झाली. त्याच्या भावाचे नाव योक्तान होते.<verse eid="1CH 1:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20" />योक्तानचे पुत्र:</para>
  <para style="li2" vid="1CH 1:20">अलमोदाद, शेलेफ, हसर्मावेथ, येरह, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />हदोराम, ऊजाल, दिक्लाह, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />ओबाल<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">एबाल</char></note>, अबीमाएल, शबा, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />ओफीर, हवीला व योबाब. हे सर्व योक्तानचे पुत्र होते.<verse eid="1CH 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24" />शेम, अर्पक्षद, शेलाह,<verse eid="1CH 1:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25" />एबर, पेलेग, रऊ,<verse eid="1CH 1:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26" />सरूग, नाहोर, तेरह,<verse eid="1CH 1:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27" />व अब्राम (अर्थात् अब्राहाम).<verse eid="1CH 1:27" /></para>
  <para style="s1">अब्राहामाचे कुटुंब</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28" />अब्राहामाचे पुत्र: इसहाक व इश्माएल.<verse eid="1CH 1:28" /></para>
  <para style="s2">हागारचे वंशज</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29" />हे त्यांचे वंशज होते:</para>
  <para style="li2" vid="1CH 1:29">इश्माएलाचा प्रथमपुत्र नबायोथ, नंतर केदार, अदबील, मिबसाम, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />मिश्मा, दूमाह, मस्सा, हदद, तेमा, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />यतूर, नापीश आणि केदमाह.</para>
  <para style="lf" vid="1CH 1:31">हे इश्माएलचे पुत्र होते.<verse eid="1CH 1:31" /></para>
  <para style="s2">केटूराहचे वंशज</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32" />अब्राहामाची उपपत्नी केटूराह हिला जन्मलेले पुत्र:</para>
  <para style="li2" vid="1CH 1:32">जिम्रान, योक्षान, मदान, मिद्यान, इश्बाक व शूआह.</para>
  <para style="li1" vid="1CH 1:32">योक्षानचे पुत्र:</para>
  <para style="li2" vid="1CH 1:32">शबा आणि ददान.<verse eid="1CH 1:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33" />मिद्यानाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:33">एफाह, एफेर, हनोख, अबीदा आणि एल्दाह.</para>
  <para style="lf" vid="1CH 1:33">हे सर्व केटूराहचे वंशज होते.<verse eid="1CH 1:33" /></para>
  <para style="s2">साराहचे वंशज</para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34" />अब्राहामास इसहाक झाला.</para>
  <para style="li1" vid="1CH 1:34">इसहाकाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:34">एसाव व इस्राएल.<verse eid="1CH 1:34" /></para>
  <para style="s1">एसावाचे पुत्र</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35" />एसावाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:35">एलीफाज, रऊएल, यऊश, यालाम व कोरह.<verse eid="1CH 1:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36" />एलीफाजचे पुत्र:</para>
  <para style="li2" vid="1CH 1:36">तेमान, ओमर, सेपो,<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">सेपो</char></note> गाताम व केनाज,</para>
  <para style="li2" vid="1CH 1:36">तिम्नाद्वारे: अमालेक.<verse eid="1CH 1:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37" />रऊएलाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:37">नहाथ, जेरह, शम्माह व मिज्जा.<verse eid="1CH 1:37" /></para>
  <para style="s2">एदोम मधील सेईराचे लोक</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38" />सेईराचे पुत्र:</para>
  <para style="li2" vid="1CH 1:38">लोटान, शोबाल, सिबोन, अनाह, दिशोन, एसर व दीशान.<verse eid="1CH 1:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39" />लोटानाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:39">होरी व होमाम. तिम्ना लोटानाची बहीण होती.<verse eid="1CH 1:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40" />शोबालाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:40">अलवान, मानहथ, एबाल, शेफी व ओनाम.</para>
  <para style="li1" vid="1CH 1:40">सिबोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:40">अय्याह व अनाह.<verse eid="1CH 1:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41" />अनाहचा पुत्र:</para>
  <para style="li2" vid="1CH 1:41">दिशोन.</para>
  <para style="li1" vid="1CH 1:41">दिशोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:41">हेमदान<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">काही हस्तलिखाणात </char><char style="fqa" closed="false">हम्रान</char></note>, एश्बान, इथरान व करान.<verse eid="1CH 1:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42" />एसराचे पुत्र:</para>
  <para style="li2" vid="1CH 1:42">बिल्हान, जावान व याकान<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="fq" closed="false">याकान </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">आकान</char></note>.</para>
  <para style="li1" vid="1CH 1:42">दिशोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 1:42">ऊस व अरान.<verse eid="1CH 1:42" /></para>
  <para style="s2">एदोमाचे शासक</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43" />इस्राएली लोकांवर कोणत्याही राजाने राज्य करण्यापूर्वी एदोम देशावर ज्या राजांनी राज्य केले ते हे:</para>
  <para style="li1" vid="1CH 1:43">बौराचा पुत्र बेला; त्याच्या शहराला दिन्हाबाह हे नाव दिले होते.<verse eid="1CH 1:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44" />बेला मृत्यू पावल्यावर बस्रा येथला जेरहाचा पुत्र योबाब हा त्याच्या जागी राजा झाला.<verse eid="1CH 1:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45" />योबाब मरण पावल्यावर तेमानी देशातील हुशाम त्याच्या जागी राजा झाला.<verse eid="1CH 1:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46" />हुशामच्या मृत्यूनंतर बदादाचा पुत्र हदाद त्याच्या जागी राजा झाला; यानेच मोआब मैदानात मिद्यानांना पराभूत केले; त्या नगराचे नाव अवीत होते.<verse eid="1CH 1:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47" />मग हदाद मेल्यावर मास्रेका येथील सामलाह त्याच्या जागी राजा झाला.<verse eid="1CH 1:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48" />सामलाहच्या मृत्यूनंतर फरात<note caller="+" style="f"><char style="fr" closed="false">1:48 </char><char style="fq" closed="false">फरात </char><char style="ft" closed="false">किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते</char></note> नदीच्या तीरावरील रेहोबोथ नावाच्या शहरातला शौल त्याच्या जागी राजा झाला.<verse eid="1CH 1:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49" />शौलाच्या मृत्यूनंतर अकबोराचा पुत्र बआल-हानान त्याच्या जागी राजा झाला.<verse eid="1CH 1:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50" />बआल-हानानच्या मृत्यूनंतर हदाद त्याच्या जागी राजा झाला. त्याच्या नगराचे नाव पाऊ<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">पाई</char></note> होते आणि त्याच्या पत्नीचे नाव महेटाबेल असून ती मेजाहाबाची कन्या मात्रेदची कन्या होती. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />हदादही मरण पावला.</para>
  <para style="b" vid="1CH 1:51" />
  <para style="lh" vid="1CH 1:51">एदोमाचे मूळ पुरुष:</para>
  <para style="li1" vid="1CH 1:51">तिम्ना, आल्वा, यतेथ, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />ओहोलीबामाह, एलाह, पीनोन, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />केनाज, तेमान, मिब्सार, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />मग्दीएल व ईराम.</para>
  <para style="lf" vid="1CH 1:54">हे एदोम देशाचे मुख्य अधिकारी होते.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">इस्राएलचे पुत्र</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1" />इस्राएलचे पुत्र: रऊबेन, शिमओन, लेवी, यहूदाह, इस्साखार व जबुलून, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" />दान, योसेफ, बिन्यामीन, नफताली, गाद व आशेर.<verse eid="1CH 2:2" /></para>
  <para style="s1">यहूदा</para>
  <para style="s2">हेस्रोनाचे पुत्र</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3" />यहूदाहचे पुत्र:</para>
  <para style="li2" vid="1CH 2:3">एर, ओनान व शेलाह. हे तिघे कनानी बथ-शूवा<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">बथ-शूवा </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">शूआची मुलगी</char></note> हिच्या पोटी त्यास झाले.</para>
  <para style="li2" vid="1CH 2:3">(यहूदाहचा ज्येष्ठपुत्र एर हा याहवेहच्या दृष्टीने दुष्ट असल्यामुळे त्यास याहवेहनी जिवे मारले.)<verse eid="1CH 2:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4" />यहूदाहची सून तामारपासून त्याला पेरेस व जेरह हे पुत्र झाले;</para>
  <para style="lf" vid="1CH 2:4">यहूदाहास एकंदर पाच पुत्र झाले.<verse eid="1CH 2:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5" />पेरेसाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:5">हेस्रोन व हामूल.<verse eid="1CH 2:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6" />जेरहाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:6">जिम्री, एथान, हेमान, कल्कोल व दारा<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">दारदा</char></note>; असे एकंदर पाच पुत्र होते.<verse eid="1CH 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7" />कर्मीचा पुत्र:</para>
  <para style="li2" vid="1CH 2:7">आखार<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">आखार </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">त्रास </char><char style="ft" closed="false">यहोशुआमध्ये </char><char style="fqa" closed="false">आखान</char></note>, ज्याने अविश्वासूपणे मूर्तीस समर्पित वस्तूंची चोरी करून आपल्या इस्राएली राष्ट्रास क्लेश दिला.<verse eid="1CH 2:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8" />एथानाचा पुत्र:</para>
  <para style="li2" vid="1CH 2:8">अजर्‍याह.<verse eid="1CH 2:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9" />हेस्रोनास झालेले पुत्र:</para>
  <para style="li2" vid="1CH 2:9">यरहमेल, राम व केलूबाइ.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">कालेब</char></note><verse eid="1CH 2:9" /></para>
  <para style="s2">हेस्रोनचा पुत्र राम पासून</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10" />रामास अम्मीनादाब झाला,</para>
  <para style="li1" vid="1CH 2:10">आणि अम्मीनादाबास यहूदाह वंशाचा सरदार नहशोन हा झाला.<verse eid="1CH 2:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11" />नहशोनाला सल्मा<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">सल्मोन</char></note></para>
  <para style="li1" vid="1CH 2:11">व सल्माला बवाज हा झाला;<verse eid="1CH 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12" />बवाजाला ओबेद झाला</para>
  <para style="li1" vid="1CH 2:12">व ओबेदाला इशाय झाला.<verse eid="1CH 2:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13" />इशायाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:13">ज्येष्ठपुत्र एलियाब, दुसरा अबीनादाब,</para>
  <para style="li2" vid="1CH 2:13">तिसरा शिमिआ, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />चवथा नथानेल,</para>
  <para style="li2" vid="1CH 2:14">पाचवा रद्दाय, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" />सहावा ओसेम,</para>
  <para style="li2" vid="1CH 2:15">व सातवा दावीद हे होते.<verse eid="1CH 2:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16" />त्यांच्या बहिणी सरुवा व अबीगईल.</para>
  <para style="li3" vid="1CH 2:16">जेरुइयाहचे अबीशाई, योआब व असाहेल असे तिघे पुत्र होते.<verse eid="1CH 2:16" /></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17" />अबीगईलला अमासा झाला, अमासाचा पिता इश्माएली येथेर होता.<verse eid="1CH 2:17" /></para>
  <para style="s2">हेस्रोनचा पुत्र कालेब</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18" />हेस्रोनचा पुत्र कालेबास त्याच्या पत्नी अजूबा (व यरियोथ) यांच्यापासून संतती झाली. अजुबाहचे पुत्र:</para>
  <para style="li2" vid="1CH 2:18">येशेर, शोबाब व अर्दोन.<verse eid="1CH 2:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19" />अजुबाहच्या मृत्यूनंतर कालेबाने एफ्राथेशी विवाह केला. तिच्या पोटी त्यास हूर झाला.<verse eid="1CH 2:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20" />हूरास उरी झाला व उरीस बसालेल झाला.<verse eid="1CH 2:20" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21" />नंतर हेस्रोन साठ वर्षांचा असता त्याने गिलआदाचा पिता माखीरच्या कन्येशी विवाह केला व तिच्याशी केलेल्या प्रीतीसंबंधाने त्यास सगूब हा झाला.<verse eid="1CH 2:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22" />सगूबास याईर झाला, याईराने गिलआद प्रांतात तेवीस शहरांचे नियंत्रण केले.<verse eid="1CH 2:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23" />(पण गशूर व अराम यांनी हव्योथ याईर व केनाथ आणि त्यांच्या आसपासची गावे अशी एकंदर साठ नगरे हस्तगत केली.)</para>
  <para style="lf" vid="1CH 2:23">गिलआदाचा पिता माखीरची ही संतती होय.<verse eid="1CH 2:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24" />हेस्रोन कालेब एफ्राथ येथे मृत्यू पावल्यावर त्याची पत्नी अबीयाहच्या पोटी त्याला तकोवाचा पिता<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="fq" closed="false">पिता </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">सेनानायक</char></note> अश्हूर हा झाला.<verse eid="1CH 2:24" /></para>
  <para style="s2">हेस्रोनाचा ज्येष्ठपुत्र यरहमेल</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25" />हेस्रोनाचा<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">ओरेन</char></note> ज्येष्ठपुत्र यरहमेल याचे पुत्र:</para>
  <para style="li2" vid="1CH 2:25">ज्येष्ठपुत्र राम, बुना, ओरेन ओसेम व अहीयाह. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />यरहमेलाची अटाराह नावाची दुसरी एक पत्नी होती. ती ओनामची आई होती.<verse eid="1CH 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27" />यरहमेलाचा ज्येष्ठपुत्र रामचे पुत्र:</para>
  <para style="li2" vid="1CH 2:27">मास, यामीन व एकर.<verse eid="1CH 2:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28" />ओनामाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:28">शम्मय व यादा.</para>
  <para style="li1" vid="1CH 2:28">शम्मयाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:28">नादाब व अबीशूर. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />अबीशूराच्या पत्नीचे नाव अबीहाईल होते. तिच्या पोटी त्यास अहबान व मोलीद हे झाले.<verse eid="1CH 2:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30" />नादाबाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:30">सलेद व अप्पईम. सलेद हा पुत्रहीन मेला.<verse eid="1CH 2:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31" />अप्पईमचा पुत्र:</para>
  <para style="li2" vid="1CH 2:31">इशी. इशीला शेशान हा झाला व शेशानाला अहलाय झाला.<verse eid="1CH 2:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32" />शम्मयाचा भाऊ यादायाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:32">येथेर व योनाथान. येथेर हा पुत्रहीन मेला.<verse eid="1CH 2:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33" />योनाथानचे पुत्र:</para>
  <para style="li2" vid="1CH 2:33">पेलेथ व जाजा.</para>
  <para style="lf" vid="1CH 2:33">ही यरहमेलाची संतती होती.<verse eid="1CH 2:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34" />शेशानास पुत्र नव्हते, मात्र कन्या होत्या.</para>
  <para style="li2" vid="1CH 2:34">त्याचा यरहा नावाचा एक इजिप्त येथील सेवक होता. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />शेशानाने आपली कन्या, आपला सेवक यरहास दिली; तिच्या पोटी त्यास अत्ताय झाला.<verse eid="1CH 2:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36" />अत्तायास नाथान,</para>
  <para style="li1" vid="1CH 2:36">नाथानास जाबाद,<verse eid="1CH 2:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37" />जाबादास एफलाल,</para>
  <para style="li1" vid="1CH 2:37">एफलालास ओबेद,<verse eid="1CH 2:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38" />ओबेदास येहू,</para>
  <para style="li1" vid="1CH 2:38">येहूस अजर्‍याह,<verse eid="1CH 2:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39" />अजर्‍याहास हेलेस,</para>
  <para style="li1" vid="1CH 2:39">हेलेसाला एलीयासाह,<verse eid="1CH 2:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40" />एलीयासाहला सिस्माय,</para>
  <para style="li1" vid="1CH 2:40">सिस्मायास शल्लूम,<verse eid="1CH 2:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41" />शल्लूमास यकम्याह,</para>
  <para style="li1" vid="1CH 2:41">आणि यकम्याहास एलीशामा झाला.<verse eid="1CH 2:41" /></para>
  <para style="s2">कालेबाचे कूळ</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42" />यरहमेलाचा भाऊ कालेबचे पुत्र:</para>
  <para style="li2" vid="1CH 2:42">ज्येष्ठपुत्र मेशा जीफाचा पिता होता,</para>
  <para style="li2" vid="1CH 2:42">मेशा जिफचा पिता होता आणि त्याचा पुत्र मारेशाह हा हेब्रोनचा पिता होता.<verse eid="1CH 2:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43" />हेब्रोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:43">कोरह, तप्पूआह, रेकेम व शमा.<verse eid="1CH 2:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44" />शमास रहम झाला.</para>
  <para style="li2" vid="1CH 2:44">तो यर्कामाचा पिता होता.</para>
  <para style="li1" vid="1CH 2:44">रेकेमास शम्मय हा झाला.<verse eid="1CH 2:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45" />शम्मयाचा पुत्र मावोन,</para>
  <para style="li2" vid="1CH 2:45">माओन हा बेथ-सूराचा पिता होता.<verse eid="1CH 2:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46" />कालेबाची उपपत्नी एफाहला</para>
  <para style="li2" vid="1CH 2:46">हारान, मोसा व गाजेज झाले.</para>
  <para style="li2" vid="1CH 2:46">हारानास गाजेज झाला.<verse eid="1CH 2:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47" />यादायाचे पुत्र:</para>
  <para style="li2" vid="1CH 2:47">रेगेम, योथाम, गेशान, पेलेट, एफाह व शाफ.<verse eid="1CH 2:47" /></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48" />कालेबाची उपपत्नी माकाहला</para>
  <para style="li2" vid="1CH 2:48">शेबेर व तिर्‍हना हे झाले.<verse eid="1CH 2:48" /></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49" />याशिवाय तिला मदमन्नाहचा पिता शाफ,</para>
  <para style="li2" vid="1CH 2:49">आणि मखबेना व गिबियाह यांचा पिता शेवा हे झाले;</para>
  <para style="li1" vid="1CH 2:49">कालेबाची कन्या अक्साह होती.<verse eid="1CH 2:49" /></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50" />ही कालेबाची संतती होय.</para>
  <para style="b" vid="1CH 2:50" />
  <para style="li1" vid="1CH 2:50">एफ्राथेचा ज्येष्ठपुत्र हूरचे पुत्र:</para>
  <para style="li2" vid="1CH 2:50">शोबाल हा किर्याथ-यआरीमाचा पिता होता. <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />सल्मा बेथलेहेमाचा पिता होता. हारेफ हा बेथ-गादेराचा पिता होता.<verse eid="1CH 2:51" /></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52" />किर्याथ-यआरीमाच्या पिता शोबालचे वंशज:</para>
  <para style="li2" vid="1CH 2:52">हारोवेह व अर्धे मेनुहोथवासी. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" />किर्याथ-यआरीम याची कुळे: इथ्री, पूथी, शुमाथी व मिश्राई. यांच्यापासून सोराथी व एष्टाबुली ही कुळे निघाली.<verse eid="1CH 2:53" /></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54" />सल्माचे वंशज:</para>
  <para style="li2" vid="1CH 2:54">बेथलेहेम, नटोफाथी, अटरोथ-बेथ-योआब आणि अर्धे मानाहथी, सोरी, <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" />आणि याबेस येथे राहणारी सोफारी<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">लेखनिकांची</char></note> कुळे: तिराथी, शिमाथी व सुकाथी. रेखाब<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">बेथ-रेकाबचा पिता</char></note> घराण्याचा मूळ पुरुष हम्मथच्या वंशातील ही केनी कुळे होती.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s2">दावीदाचे पुत्र</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1" />हेब्रोन येथे जन्मलेले दावीदाचे पुत्र:</para>
  <para style="b" vid="1CH 3:1" />
  <para style="li1" vid="1CH 3:1">दावीदाचा ज्येष्ठपुत्र अम्नोन. दावीदाला तो येज्रीली अहीनोअमपासून झाला.</para>
  <para style="li1" vid="1CH 3:1">दावीदाचा दुसरा पुत्र दानीएल. त्याच्या आईचे नाव अबीगईल असे असून ती कर्मेलची होती.<verse eid="1CH 3:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2" />तिसरा पुत्र अबशालोम हा गशूरचा राजा तलमयची कन्या माकाहपासून झाला.</para>
  <para style="li1" vid="1CH 3:2">चौथा पुत्र अदोनियाह हग्गीथपासून जन्मला.<verse eid="1CH 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3" />पाचवा पुत्र शफाट्याह अबीटालपासून झाला.</para>
  <para style="li1" vid="1CH 3:3">सहावा पुत्र इथ्रियामची पत्नी एग्लाहपासून झाला.<verse eid="1CH 3:3" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4" />हेब्रोन येथे जन्मलेले दावीदाचे हे सहा पुत्र होते; तिथे त्याने सात वर्षे सहा महिने राज्य केले.</para>
  <para style="b" vid="1CH 3:4" />
  <para style="b" vid="1CH 3:4" />
  <para style="lh" vid="1CH 3:4">यरुशलेममध्ये दावीदाने तेहतीस वर्षे राज्य केले. <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" />यरुशलेममध्ये त्याला जे पुत्र झाले ते हे:</para>
  <para style="b" vid="1CH 3:5" />
  <para style="li1" vid="1CH 3:5">शम्मुआ<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">शिमिआ</char></note>, शोबाब, नाथान, शलोमोन हे चार अम्मीएलाची कन्या बथशेबा<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">बथ-शूवा</char></note> हिच्यापासून झाले.<verse eid="1CH 3:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6" />नंतर इभार, एलीशुआ,<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">एलीशामा</char></note> एलिफेलेत. <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />नोगा, नेफेग, याफीय, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />एलीशामा, एलयादा व एलिफेलेत हे सुद्धा झाले; असे एकूण नऊ पुत्र होते.<verse eid="1CH 3:8" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9" />या यादीमध्ये त्याला त्याच्या उपपत्नींपासून झालेल्या पुत्रांचा समावेश केलेला नाही. दावीदाला तामार नावाची एक कन्याही होती.<verse eid="1CH 3:9" /></para>
  <para style="s2">यहूदीयाचे राजे</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10" />शलोमोनचा पुत्र रेहोबोअम,</para>
  <para style="li1" vid="1CH 3:10">त्याचा पुत्र अबीयाह,</para>
  <para style="li1" vid="1CH 3:10">त्याचा पुत्र आसा,</para>
  <para style="li1" vid="1CH 3:10">त्याचा पुत्र यहोशाफाट,<verse eid="1CH 3:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11" />त्याचा पुत्र यहोराम<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fq" closed="false">यहोराम </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">योराम</char></note>,</para>
  <para style="li1" vid="1CH 3:11">त्याचा पुत्र अहज्याह,</para>
  <para style="li1" vid="1CH 3:11">त्याचा पुत्र योआश,<verse eid="1CH 3:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12" />त्याचा पुत्र अमस्याह,</para>
  <para style="li1" vid="1CH 3:12">त्याचा पुत्र अजर्‍याह,</para>
  <para style="li1" vid="1CH 3:12">त्याचा पुत्र योथाम,<verse eid="1CH 3:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13" />त्याचा पुत्र आहाज,</para>
  <para style="li1" vid="1CH 3:13">त्याचा पुत्र हिज्कीयाह,</para>
  <para style="li1" vid="1CH 3:13">त्याचा पुत्र मनश्शेह,<verse eid="1CH 3:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14" />त्याचा पुत्र आमोन,</para>
  <para style="li1" vid="1CH 3:14">त्याचा पुत्र योशीयाह.<verse eid="1CH 3:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15" />योशीयाहचे पुत्र:</para>
  <para style="li2" vid="1CH 3:15">ज्येष्ठ योहानान,</para>
  <para style="li2" vid="1CH 3:15">दुसरा यहोयाकीम,</para>
  <para style="li2" vid="1CH 3:15">तिसरा सिद्कीयाह,</para>
  <para style="li2" vid="1CH 3:15">व चौथा शल्लूम.<verse eid="1CH 3:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16" />यहोयाकीमाचे पुत्र:</para>
  <para style="li2" vid="1CH 3:16">यकोन्याह<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">यहोयाखीन</char></note>,</para>
  <para style="li2" vid="1CH 3:16">व सिद्कीयाह.<verse eid="1CH 3:16" /></para>
  <para style="s2">बंदिवासात गेल्यानंतरचे राजघराणे</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17" />बंदी झालेले यकोन्याहचे पुत्र:</para>
  <para style="li2" vid="1CH 3:17">शल्तीएल, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />मल्कीराम, पदायाह, शेनस्सर, यकम्याह, होशामा व नेदब्याह.<verse eid="1CH 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19" />पदायाहचे पुत्र:</para>
  <para style="li2" vid="1CH 3:19">जरूब्बाबेल व शिमी.</para>
  <para style="li1" vid="1CH 3:19">जरूब्बाबेलाचे पुत्र:</para>
  <para style="li2" vid="1CH 3:19">मशुल्लाम, हनन्याह. त्याच्या कन्येचे नाव शेलोमीथ. <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />त्या शिवाय आणखी पाच पुत्र होते: हशूबाह, ओहेल, बेरेख्याह, हसद्याह व यूशाब-हेसेद.<verse eid="1CH 3:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21" />हनन्याहचे पुत्र:</para>
  <para style="li2" vid="1CH 3:21">पेलतियाह व यशायाह. यशायाहचा पुत्र रफायाह. रफायाहचा पुत्र नाव अर्णान. अर्णानला ओबद्याह हा झाला. ओबद्याहचा पुत्र शखन्याह.<verse eid="1CH 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22" />शखन्याहचे वंशज:</para>
  <para style="li2" vid="1CH 3:22">शमायाह आणि त्याचे पुत्र: हट्टूश, इगाल, बारीहा, निरय्याह व शाफाट; एकूण सहा पुत्र.<verse eid="1CH 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23" />निरय्याहचे पुत्र:</para>
  <para style="li2" vid="1CH 3:23">एलिओएनाइ, हिज्कीयाह व अज्रीकाम, एकूण तीन पुत्र.<verse eid="1CH 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24" />एलिओएनाइ याचे पुत्र:</para>
  <para style="li2" vid="1CH 3:24">होदव्याह, एल्याशीब, पेलतियाह, अक्कूब, योहानान, दलायाह व अनानी; एकूण सात पुत्र.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s2">यहूदाहची इतर कुळे</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1" />यहूदाहचे वंशज:</para>
  <para style="li2" vid="1CH 4:1">पेरेस, हेस्रोन, कर्मी, हूर व शोबाल.<verse eid="1CH 4:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2" />शोबालचा पुत्र रेआयाहला यहथ, यहथाला अहूमय व लाहाद झाला, ही सोराथी कुळे होत.<verse eid="1CH 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3" />एटामाचे पुत्र:</para>
  <para style="li2" vid="1CH 4:3">येज्रील, इश्मा, इद्बाश व त्यांची बहीण हस्सलेलपोनी होती. <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" />पेनुएल गदोरचा पिता होता, आणि एजेरला हूशा झाला.</para>
  <para style="li1" vid="1CH 4:4">हूरचे वंशज: ज्येष्ठपुत्र एफ्राथाह आणि तो बेथलेहेमाचा पिता होता.<verse eid="1CH 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5" />तकोवाचा पिता अश्हूरला हेला व नाराह अशा दोन पत्नी होत्या.<verse eid="1CH 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6" />नाराहच्या पोटी त्याला अहुज्जाम, हेफेर, तेमानी व अहष्टारी झाले. ही नाराहची संतती होती.<verse eid="1CH 4:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7" />हेलाचे पुत्र:</para>
  <para style="li2" vid="1CH 4:7">सेरथ, जोहर व एथ्नान <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />व कोस, जो आनूब व हस्सोबेबाह यांचा पिता होता, तसेच त्याच्यापासून हारूमाचा पुत्र अहरहेल याची कुळे निपजली.<verse eid="1CH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9" />याबेस आपल्या भावांपेक्षा अधिक आदरणीय होता; “त्यास प्रसवताना मला फार क्लेश झाले” असे म्हणत त्याच्या आईने त्याचे नाव याबेस<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">याबेस </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">क्लेश</char></note> ठेवले. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />याबेसाने इस्राएलाच्या परमेश्वराजवळ प्रार्थना केली, “तुम्ही मला आशीर्वादित करा, माझ्या क्षेत्राचा विस्तार करा! माझ्यावर कोणतेही अरिष्ट येऊन, मला क्लेश वाटू नये म्हणून तुमचा हात माझ्यावर राहो.” परमेश्वराने त्याची विनंती मान्य केली.<verse eid="1CH 4:10" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11" />शूहाहचा भाऊ कलूबला महीर झाला; हा एष्टोनाचा पिता होता. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />एष्टोनास बेथ-राफा, पासेआह आणि ईर-नाहाश<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">नाहाशचे शहर</char></note> चा पिता तहिन्ना झाले. हे रेकाह नगरवासी होते.<verse eid="1CH 4:12" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13" />केनाजचे पुत्र:</para>
  <para style="li2" vid="1CH 4:13">ओथनिएल व सेरायाह.</para>
  <para style="li1" vid="1CH 4:13">ओथनिएलाचे पुत्र:</para>
  <para style="li2" vid="1CH 4:13">हथथ आणि मेयोनोथाय. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" />मेयोनोथाय ओफराहचा पिता होता.</para>
  <para style="li1" vid="1CH 4:14">सेरायाह योआबाचा पिता होता,</para>
  <para style="li2" vid="1CH 4:14">हा योआब गे-हाराशीम<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">गे-हाराशीम </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">निपुण कारागिरांची दरी</char></note> चा पिता. हे यासाठी म्हटले कारण तेथील लोक निपुण कारागीर होते.<verse eid="1CH 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15" />यफुन्नेहचा पुत्र कालेबाचे पुत्र:</para>
  <para style="li2" vid="1CH 4:15">इरु, एलाह व नाआम.</para>
  <para style="li1" vid="1CH 4:15">एलाहचा पुत्र:</para>
  <para style="li2" vid="1CH 4:15">केनाज.<verse eid="1CH 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16" />यहल्लेलेलचे पुत्र:</para>
  <para style="li2" vid="1CH 4:16">जीफ, जीफा, तिर्‍या व असरेल.<verse eid="1CH 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17" />एज्राहचे पुत्र:</para>
  <para style="li2" vid="1CH 4:17">येथेर, मेरेद, एफेर व यालोन.</para>
  <para style="li1" vid="1CH 4:17">मेरेदची एक पत्नी बिथ्याने मिर्याम, शम्मय व इश्बह यास जन्म दिला. इश्बह एष्टमोवाचा पिता होता. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />मेरेदने इजिप्तचा राजा फारोहची राजकन्या बिथ्याशी विवाह केला होता.</para>
  <para style="li1" vid="1CH 4:18">यहूदाह गोत्रातील त्याच्या पत्नीने गदोरचा पिता येरेद, सोकोहचा पिता हेबेर आणि जानोहाचा पिता यकूथिएल यांना जन्म दिला.<verse eid="1CH 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19" />नहमाची बहीण, होदीयाहची पत्नी झाली; तिला:</para>
  <para style="li2" vid="1CH 4:19">गार्मी येथील कईलाहचा पिता व माकाथी येथील एष्टमोवा झाले.<verse eid="1CH 4:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20" />शिमओनाचे पुत्र:</para>
  <para style="li2" vid="1CH 4:20">अम्नोन, रिन्नाह, बेन-हानान व तिलोन.</para>
  <para style="li1" vid="1CH 4:20">इशीचे वंशज:</para>
  <para style="li2" vid="1CH 4:20">जोहेथ व बेन-जोहेथ.<verse eid="1CH 4:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21" />यहूदाहचा पुत्र शेलाहचे पुत्र:</para>
  <para style="li2" vid="1CH 4:21">लेकाहचा पिता एर, मारेशाहचा पिता लादाह आणि बेथ-अश्बे येथील तलम कापडाचे विणकाम करणारी कुळे उत्पन्न झाली.<verse eid="1CH 4:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22" />तसेच शेलापासून योकीम, कोजेबा येथील लोक, योआश, मोआबावर सत्ता चालविणारे साराफ व यशूबी-लेहेम हे निपजले. (हा वृतांत प्राचीन नोंदवहीतील आहे.) <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />हे कुंभार असून नताईम व गेदेराह येथे राहत असत; ते राजाचे कामकाज करून त्याच्याजवळ राहत असत.<verse eid="1CH 4:23" /></para>
  <para style="s1">शिमओन</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24" />शिमओनाचे वंशज:</para>
  <para style="li2" vid="1CH 4:24">नेमूएल, यामीन, यारीब, जेरह व शौल;<verse eid="1CH 4:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25" />शौलाचा पुत्र शल्लूम, शल्लूमाचा पुत्र मिबसाम आणि मिबसामचा पुत्र मिश्मा.<verse eid="1CH 4:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26" />मिश्माचा वंशज:</para>
  <para style="li2" vid="1CH 4:26">त्याचा पुत्र हम्मूएल. हम्मूएलाचा पुत्र जक्कूरचा पुत्र शिमी.<verse eid="1CH 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27" />शिमीस सोळा पुत्र व सहा कन्या झाल्या; पण त्याच्या भावास फारशी संतती झाली नाही आणि त्यांचा वंश यहूदाहच्या वंशाप्रमाणे वृद्धी पावला नाही. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" />त्यांनी वस्ती केलेली गावे ही: बेअर-शेबा, मोलादाह, हसर-शुआल, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />बिल्हा असेम, तोलाद, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />बेथुएल, होरमाह सिकलाग, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />बेथ-मर्काबोथ, हसर-सुसीम, बेथ-बिरी व शाराईम. दावीदाच्या कारकिर्दीपर्यंत ही त्यांची शहरे होती. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />त्यांचे वंशज एटाम, एईन, रिम्मोन, तोखेन आणि आशान या पाच नगरात आणि <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />या नगरांच्या सभोवतीच्या गावात बआलपर्यंत<note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">काही मूळ प्रतींनुसार </char><char style="fqa" closed="false">बालाथ</char></note> वस्ती करून होते.</para>
  <para style="b" vid="1CH 4:33" />
  <para style="lh" vid="1CH 4:33">त्यांच्या वंशावळीत असे नमूद केलेले आहे:<verse eid="1CH 4:33" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34" />मेशोबाब, यामलेख,</para>
  <para style="li1" vid="1CH 4:34">अमस्याहाचा पुत्र योशाह, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />योएल.</para>
  <para style="li1" vid="1CH 4:35">येहू योशिब्याहचा पुत्र, जो सेरायाहचा पुत्र, जो असिएलाचा पुत्र होता.<verse eid="1CH 4:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36" />एलिओएनाइ, याकोबाह, येशोहाइयाह,</para>
  <para style="li1" vid="1CH 4:36">असायाह, अदिएल, यशीमिएल, बेनाइयाह.<verse eid="1CH 4:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37" />जीजा हा शिफीचा पुत्र, जो अल्लोनचा पुत्र, जो यदायाहचा पुत्र, जो शिम्रीचा पुत्र व जो शमायाहचा पुत्र होता.<verse eid="1CH 4:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38" />नावाने वर सूचीबद्ध केलेले हे सर्व पुरुष कुलप्रमुख होते.</para>
  <para style="b" vid="1CH 4:38" />
  <para style="p" vid="1CH 4:38">या कुटुंबांचा खूप विस्तार झाला. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />ते आपल्या मेंढरांच्या कळपांसाठी कुरणाच्या शोधार्थ पूर्वेकडे गदोरच्या खोर्‍यापर्यंत गेले. <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />तिथे त्यांना कसदार व उत्तम चारा सापडला. तो देश विस्तीर्ण असून शांत व निवांत होता; तिथे पूर्वी हामाचे वंशज राहत असत.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41" />ज्यांच्या नावाची वर नोंद केली आहे, त्यांनी यहूदीयाचा राजा हिज्कीयाहच्या कारकिर्दीत तिथे आक्रमण करून हामच्या वंशजांना आणि तसेच मऊनीमींना त्यांच्या डेर्‍यांसह नष्ट करून ते त्यांच्या ठिकाणी आजपर्यंत वसलेले आहेत; कारण त्या ठिकाणी त्यांच्या शेरडामेंढरांसाठी चारा होता. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" />त्यापैकी म्हणजे शिमओनाच्या गोत्रातील पाचशे पुरुषांनी इशीचे पुत्र पेलतियाह, निरय्याह, रफायाह व उज्जीएल यांनी त्यांचे नेतृत्व केले आणि ते सेईर डोंगरावर गेले. <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" />तिथे जे पळून गेलेले अमालेकी उरले होते, त्यांचा संहार करून ते आजवर तिथे राहतात.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">रऊबेन</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1" />रऊबेन हा ज्येष्ठपुत्र होता खरा, पण त्याने आपल्या पित्याचा पलंग भ्रष्ट केला म्हणून त्याचा ज्येष्ठत्वाचा हक्क इस्राएलपुत्र योसेफच्या संततीस देण्यात आला, म्हणून वंशावळीत रऊबेनचे नाव ज्येष्ठत्वाच्या हक्काप्रमाणे नमूद करण्यात आले नाही. <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" />जरी यहूदाह त्याच्या बंधूतील सर्वात शक्तिमान होता आणि यहूदाहच्या वंशातूनच एक राज्यकर्ता उदयास आला, तरी योसेफाला ज्येष्ठत्वाचा हक्क मिळाला. <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" />इस्राएलचा ज्येष्ठपुत्र रऊबेनचे पुत्र:</para>
  <para style="b" vid="1CH 5:3" />
  <para style="li2" vid="1CH 5:3">हनोख, पल्लू, हेस्रोन व कर्मी.<verse eid="1CH 5:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4" />योएलाचे वंशज:</para>
  <para style="li2" vid="1CH 5:4">त्याचा पुत्र शमायाह, त्याचा पुत्र गोग,</para>
  <para style="li2" vid="1CH 5:4">त्याचा पुत्र शिमी, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />शिमीचा पुत्र मीखाह,</para>
  <para style="li2" vid="1CH 5:5">त्याचा पुत्र रेआयाह, त्याचा पुत्र बाल,<verse eid="1CH 5:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6" />बालाचा पुत्र बैरा रऊबेन वंशाचा सरदार असून त्याला अश्शूरचा राजा तिग्लथ-पिलेसर<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="fq" closed="false">तिग्लथ-पिलेसर </char><char style="ft" closed="false">याला </char><char style="fqa" closed="false">तिग्लथ-पिल्नेसर </char><char style="ft" closed="false">म्हणूनही ओळखले जाते</char></note> ने कैद करून नेले.<verse eid="1CH 5:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7" />त्याच्या भावांची वंशावळी त्यांच्या कुळांप्रमाणे लिहिली ती अशी:</para>
  <para style="li2" vid="1CH 5:7">प्रमुख ईयेल, जखर्‍याह, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" />बेलाचा पिता आजाजचा पिता शमा व त्याचा पिता योएल.</para>
  <para style="b" vid="1CH 5:8" />
  <para style="p" vid="1CH 5:8">हा वंश नबो व बआल-मेओन येथपर्यंत अरोएरात वस्ती करून राहिला. <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" />पूर्वेकडे फरात नदीजवळील रानाच्या सीमेपर्यंत त्यांनी वस्ती केली, कारण गिलआद देशात त्यांचे पशुधन भरपूर वाढले होते.<verse eid="1CH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10" />शौलाच्या कारकिर्दीत त्यांनी हगरी लोकांशी युद्ध करून त्यांचा संहार केला; व गिलआदाच्या पूर्वेकडे असलेल्या सगळ्या हगरी प्रदेशातील त्या लोकांच्या डेर्‍यात ते वस्ती करू लागले.<verse eid="1CH 5:10" /></para>
  <para style="s1">गाद</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11" />गादाचे वंशज त्यांच्यासमोर सलेकाह येथवर बाशान प्रदेशात राहत होते:<verse eid="1CH 5:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12" />त्यात योएल प्रमुख होता व दुसरा शाफाम, याखेरीज यानय व शाफाट हे बाशानात राहत होते.<verse eid="1CH 5:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13" />त्यांच्या पितृकुळाप्रमाणे त्यांचे बांधव:</para>
  <para style="li2" vid="1CH 5:13">मिखाएल, मशुल्लाम, शबा, योरय, याकान, जीया व एबर; असे सर्व मिळून सात.<verse eid="1CH 5:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14" />अबीहाईल हूरीचा पुत्र, जो दूरीचा पुत्र, जो यारोहचा पुत्र, जो गिलआदाचा पुत्र, जो मिखाएलचा पुत्र, जो यशीशायचा पुत्र, जो यहदोचा पुत्र, जो बूजचा पुत्र.<verse eid="1CH 5:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15" />अही जो अबदीएलचा पुत्र, जो गूनीचा पुत्र हा त्यांच्या कुटुंबाचा प्रमुख होता.<verse eid="1CH 5:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16" />गादचे लोक गिलआदात व बाशानात व तेथील गावात आणि शारोनच्या शिवारात आपल्या सीमेत वस्ती करून राहिले.<verse eid="1CH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17" />या सर्वांची वंशावळी यहूदीयाचा राजा योथाम व इस्राएलचा राजा यरोबोअम यांच्या कारकिर्दीत संग्रहित करण्यात आली होती.<verse eid="1CH 5:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />रऊबेनी, गादी व मनश्शेहच्या अर्ध्या गोत्रात 44,760 पुरुष योद्धे होते—ढालधारी, तलवारबहादूर, धनुर्धारी व युध्दकलानिपुण असे. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" />त्यांनी हगरी, यतूर, नापीश व नोदाब यांच्याशी युद्ध केले. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" />त्यांच्याशी लढण्यास त्यास साहाय्य मिळून परमेश्वराने हगरी आणि त्यांच्यासोबत असणाऱ्या इतर लोकांना त्यांच्या हातात दिले, कारण युध्दसमयी त्यांनी परमेश्वराचा धावा केला; त्यांनी त्यांच्यावर भरवसा ठेवला म्हणून त्यांनी त्यांची प्रार्थना ऐकली. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />त्यांनी त्यांची गुरे जप्त केली—पन्नास हजार उंट, दोन लक्ष पन्नास हजार मेंढरे, दोन हजार गाढवे व एक लक्ष पुरुष कैद करून नेले. <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" />बऱ्याच लोकांचा संहार झाला, कारण हे युद्ध परमेश्वराचे होते. ते लोक या प्रदेशात बंदिवासाच्या समयापर्यंत वस्ती करून राहिले.<verse eid="1CH 5:22" /></para>
  <para style="s1">मनश्शेहचा अर्धा वंश</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />मनश्शेहच्या अर्ध्या वंशातील लोक असंख्य होते. त्यांनी बाशानपासून बआल-हर्मोन, सनीरपर्यंत (हर्मोन पर्वत) वस्ती केली.<verse eid="1CH 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24" />त्यांच्या कुटुंबातील प्रमुख पुरुष: एफेर, इशी, एलीएल, अज्रीएल, यिर्मयाह, होदव्याह व यहदीएल. हे महावीर व नामांकित पुरुष असू कुलप्रमुख होते. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" />ते आपल्या पूर्वजांच्या परमेश्वराशी अविश्वासू झाले आणि परमेश्वराने त्यांच्यापुढून ज्या लोकांचा नाश केला होता, त्यांच्या दैवतांच्या नादी लागून ते व्यभिचारी बनले. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" />यास्तव इस्राएलाच्या परमेश्वराने अश्शूरचा राजा पूल (म्हणजे अश्शूरचा राजा तिग्लथ-पिलेसर), यास तयार केले. त्याने रऊबेनी, गादी व मनश्शेहच्या अर्ध्या वंशाच्या लोकांचा पाडाव करून त्यांना हलह, हाबोर, हारा येथे व गोजान नदीपर्यंत नेऊन बंदिवासात ठेवले व तिथेच ते आजवर वस्ती करून राहिले आहेत.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">लेवी</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1" />लेवीचे पुत्र:</para>
  <para style="li2" vid="1CH 6:1">गेर्षोन, कोहाथ व मरारी.<verse eid="1CH 6:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2" />कोहाथाचे पुत्र:</para>
  <para style="li2" vid="1CH 6:2">अम्राम, इसहार, हेब्रोन व उज्जीएल.<verse eid="1CH 6:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3" />अम्रामाची संतती:</para>
  <para style="li2" vid="1CH 6:3">अहरोन, मोशे व मिर्याम.</para>
  <para style="li1" vid="1CH 6:3">अहरोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 6:3">नादाब, अबीहू, एलअज़ार व इथामार.<verse eid="1CH 6:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4" />एलअज़ारास फिनहास,</para>
  <para style="li2" vid="1CH 6:4">फिनहासास अबीशूवा,<verse eid="1CH 6:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5" />अबीशूवास बुक्की,</para>
  <para style="li2" vid="1CH 6:5">बुक्कीस उज्जी,<verse eid="1CH 6:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6" />उज्जीस जरह्याह,</para>
  <para style="li2" vid="1CH 6:6">जरह्याहास मरायोथ,<verse eid="1CH 6:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7" />मरायोथास अमर्‍याह,</para>
  <para style="li2" vid="1CH 6:7">अमर्‍याहास अहीतूब,<verse eid="1CH 6:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8" />अहीतूबास सादोक,</para>
  <para style="li2" vid="1CH 6:8">सादोकास अहीमाज,<verse eid="1CH 6:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9" />अहीमाजास अजर्‍याह,</para>
  <para style="li2" vid="1CH 6:9">अजर्‍याहास योहानान,<verse eid="1CH 6:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10" />योहानान यास अजर्‍याह झाला.</para>
  <para style="li2" vid="1CH 6:10">अजर्‍याह शलोमोनाने यरुशलेमात बांधलेल्या मंदिरात याजक म्हणून सेवा करीत असे.<verse eid="1CH 6:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11" />अजर्‍याहास अमर्‍याह,</para>
  <para style="li2" vid="1CH 6:11">अमर्‍याहास अहीतूब झाला,<verse eid="1CH 6:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12" />अहीतूबास सादोक,</para>
  <para style="li2" vid="1CH 6:12">सादोकास शल्लूम,<verse eid="1CH 6:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13" />शल्लूमास हिल्कियाह,</para>
  <para style="li2" vid="1CH 6:13">हिल्कियाहास अजर्‍याह,<verse eid="1CH 6:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14" />अजर्‍याहास सरायाह,</para>
  <para style="li2" vid="1CH 6:14">सेरायाहास यहोसादाक<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fq" closed="false">यहोसादाक </char><char style="ft" closed="false">दुसरे नाव </char><char style="fqa" closed="false">योसादक</char></note> झाला.<verse eid="1CH 6:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15" />याहवेहने बाबेलचा राजा नबुखद्नेस्सराच्या हस्ते यहूदीया व यरुशलेमचा पाडाव केला, तेव्हा यहोसादाक बंदी झाला.<verse eid="1CH 6:15" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16" />लेवीचे पुत्र:</para>
  <para style="li2" vid="1CH 6:16">गेर्षोन,<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">गेर्षोम</char></note> कोहाथ व मरारी.<verse eid="1CH 6:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17" />ही गेर्षोनच्या पुत्रांची नावे:</para>
  <para style="li2" vid="1CH 6:17">लिब्नी व शिमी.<verse eid="1CH 6:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18" />कोहाथाचे पुत्र:</para>
  <para style="li2" vid="1CH 6:18">अम्राम, इसहार, हेब्रोन व उज्जीएल.<verse eid="1CH 6:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19" />मरारीचे पुत्र:</para>
  <para style="li2" vid="1CH 6:19">महली व मूशी.</para>
  <para style="b" vid="1CH 6:19" />
  <para style="lh" vid="1CH 6:19">त्यांच्या पूर्वजांप्रमाणे नोंदवलेली लेव्यांची कुळे:<verse eid="1CH 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20" />गेर्षोमाच्या कुळातील:</para>
  <para style="li2" vid="1CH 6:20">गेर्षोमचा पुत्र लिब्नी, लिब्नीचा पुत्र यहथ,</para>
  <para style="li2" vid="1CH 6:20">यहथाचा पुत्र जिम्माह, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />जिम्माहाचा पुत्र योवाह,</para>
  <para style="li2" vid="1CH 6:21">योवाहचा पुत्र इद्दो, इद्दोचा पुत्र जेरह,</para>
  <para style="li2" vid="1CH 6:21">जेरहचा पुत्र जेथेराय.<verse eid="1CH 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22" />कोहाथाचे वंशज:</para>
  <para style="li2" vid="1CH 6:22">कोहाथाचा पुत्र अम्मीनादाब, अम्मीनादाबाचा पुत्र कोरह,</para>
  <para style="li2" vid="1CH 6:22">कोरहाचा पुत्र अस्सीर, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />अस्सीरचा पुत्र एलकानाह,</para>
  <para style="li2" vid="1CH 6:23">एलकानाहचा पुत्र एब्यासाफ, एब्यासाफाचा पुत्र अस्सीर,<verse eid="1CH 6:23" /></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24" />अस्सीरचा पुत्र तहथ, तहथाचा पुत्र उरीएल,</para>
  <para style="li2" vid="1CH 6:24">उरीएलाचा पुत्र उज्जीयाह आणि त्याचा पुत्र शौल.<verse eid="1CH 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25" />एलकानाहचे वंशज:</para>
  <para style="li2" vid="1CH 6:25">अमासय व अहीमोथ.<verse eid="1CH 6:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26" />एलकानाहचा पुत्र सोफय, सोफयाचा पुत्र नहाथ,</para>
  <para style="li2" vid="1CH 6:26">नहाथाचा पुत्र एलियाब, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />एलियाबाचा पुत्र,</para>
  <para style="li2" vid="1CH 6:27">यरोहाम व त्याचा पुत्र एलकानाह,</para>
  <para style="li2" vid="1CH 6:27">एलकानाहचा पुत्र शमुवेल.<verse eid="1CH 6:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28" />शमुवेलाचे पुत्र:</para>
  <para style="li2" vid="1CH 6:28">ज्येष्ठ योएल</para>
  <para style="li2" vid="1CH 6:28">व दुसरा अबीयाह.<verse eid="1CH 6:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29" />मरारीचे वंशज:</para>
  <para style="li2" vid="1CH 6:29">महली, त्याचा पुत्र लिब्नी,</para>
  <para style="li2" vid="1CH 6:29">त्याचा पुत्र शिमी, त्याचा पुत्र उज्जाह,<verse eid="1CH 6:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30" />त्याचा पुत्र शिमा, त्याचा पुत्र हग्गीयाह</para>
  <para style="li2" vid="1CH 6:30">व त्याचा पुत्र असायाह.<verse eid="1CH 6:30" /></para>
  <para style="s2">मंदिराचे संगीतकार</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />कोश स्थायिक झाल्यावर दावीदाने याहवेहच्या मंदिरात गायकवृंदात जे पुरुष नेमले ते: <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />यरुशलेममध्ये शलोमोन याहवेहचे मंदिर बांधेपर्यंत सभामंडपाच्या निवासमंडपासमोर त्यांनी संगीताची सेवा केली. ते आपल्या कामावर क्रमानुसार हजर राहत असत.<verse eid="1CH 6:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33" />ज्या पुरुषांनी त्यांच्या पुत्रांसह मिळून सेवा केली त्यांची नावे:</para>
  <para style="b" vid="1CH 6:33" />
  <para style="li1" vid="1CH 6:33">कोहाथी पासून:</para>
  <para style="li2" vid="1CH 6:33">गायक हेमान,</para>
  <para style="li2" vid="1CH 6:33">जो योएलचा पुत्र, जो शमुवेलाचा पुत्र,<verse eid="1CH 6:33" /></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34" />जो एलकानाहचा पुत्र, जो यरोहामाचा पुत्र,</para>
  <para style="li2" vid="1CH 6:34">जो एलीएलचा पुत्र, जो तोहाचा पुत्र,<verse eid="1CH 6:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35" />जो सूफाचा पुत्र, जो एलकानाहचा पुत्र,</para>
  <para style="li2" vid="1CH 6:35">जो महथचा पुत्र, जो अमासयचा पुत्र,<verse eid="1CH 6:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36" />जो एलकानाहचा पुत्र, जो योएलचा पुत्र,</para>
  <para style="li2" vid="1CH 6:36">जो अजर्‍याहाचा पुत्र, जो सफन्याहाचा पुत्र,<verse eid="1CH 6:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37" />जो तहथाचा पुत्र, जो अस्सीरचा पुत्र,</para>
  <para style="li2" vid="1CH 6:37">जो एब्यासाफचा पुत्र, जो कोरहाचा पुत्र,<verse eid="1CH 6:37" /></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38" />जो इसहारचा पुत्र, जो कोहाथचा पुत्र,</para>
  <para style="li2" vid="1CH 6:38">जो लेवीचा पुत्र, आणि जो इस्राएलचा पुत्र.<verse eid="1CH 6:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39" />हेमानाचा भाऊ आसाफ त्याच्या उजवीकडे उभा राहात असे:</para>
  <para style="li2" vid="1CH 6:39">आसाफ जो बेरेख्याहचा पुत्र, जो शिमाचा पुत्र,<verse eid="1CH 6:39" /></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40" />जो मिखाएलचा पुत्र, जो बासेयाहचा<note caller="+" style="f"><char style="fr" closed="false">6:40 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">मासेया</char></note> पुत्र,</para>
  <para style="li2" vid="1CH 6:40">जो मल्कीयाहचा पुत्र, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />जो एथनीचा पुत्र,</para>
  <para style="li2" vid="1CH 6:41">जो जेरहचा पुत्र, जो अदायाहचा पुत्र,<verse eid="1CH 6:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42" />जो एथानचा पुत्र, जो जिम्माहचा पुत्र,</para>
  <para style="li2" vid="1CH 6:42">जो शिमीचा पुत्र, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />जो यहथाचा पुत्र,</para>
  <para style="li2" vid="1CH 6:43">जो गेर्षोमचा पुत्र, आणि जो लेवीचा पुत्र,<verse eid="1CH 6:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44" />आणि त्यांच्या डावीकडे, मरारी कुळातील सहायक:</para>
  <para style="li2" vid="1CH 6:44">एथान जो किशीचा पुत्र, जो अब्दीचा पुत्र,</para>
  <para style="li2" vid="1CH 6:44">जो मल्लूखचा पुत्र, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />जो हशब्याहाचा पुत्र,</para>
  <para style="li2" vid="1CH 6:45">जो अमस्याहाचा पुत्र, जो हिल्कियाहचा पुत्र,<verse eid="1CH 6:45" /></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46" />जो अमसीचा पुत्र, जो बानीचा पुत्र,</para>
  <para style="li2" vid="1CH 6:46">जो शेमेरचा पुत्र, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />जो महलीचा पुत्र,</para>
  <para style="li2" vid="1CH 6:47">जो मूशीचा पुत्र, जो मरारीचा पुत्र,</para>
  <para style="li2" vid="1CH 6:47">आणि जो लेवीचा पुत्र.<verse eid="1CH 6:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48" />त्यांच्या लेवी भाऊबंदांना परमेश्वराच्या भवनाच्या निवासमंडपातील सर्व सेवेसाठी समर्पित करण्यात आलेले होते. <verse eid="1CH 6:48" /><verse number="49" style="v" sid="1CH 6:49" />अहरोन व त्याचे वंशज हे होमवेदीवर व धूपवेदीवर अर्पणे करीत असत. परमपवित्र स्थानासंबंधीची सर्व कामे ते करीत आणि इस्राएली लोकांसाठी प्रायश्चित करीत. परमेश्वराचा सेवक मोशेने दिलेल्या आज्ञेप्रमाणे ते करीत असत.<verse eid="1CH 6:49" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50" />अहरोनाचे वंशज:</para>
  <para style="li2" vid="1CH 6:50">अहरोनाचा पुत्र एलअज़ार, त्याचा पुत्र फिनहास,</para>
  <para style="li2" vid="1CH 6:50">त्याचा पुत्र अबीशूवा, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />त्याचा पुत्र बुक्की,</para>
  <para style="li2" vid="1CH 6:51">त्याचा पुत्र उज्जी, त्याचा पुत्र जरह्याह,<verse eid="1CH 6:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52" />त्याचा पुत्र मरायोथ, त्याचा पुत्र अमर्‍याह,</para>
  <para style="li2" vid="1CH 6:52">त्याचा पुत्र अहीतूब, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />त्याचा पुत्र सादोक</para>
  <para style="li2" vid="1CH 6:53">व त्याचा पुत्र अहीमाज.<verse eid="1CH 6:53" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54" />हा प्रदेश त्यांना वाटप म्हणून देण्यात आला होता. ही त्यांच्या वसाहतींची ठिकाणे बनली. (हा प्रदेश अहरोनाच्या वंशज कोहाथी कुळातील लोकांना देण्यात आला, कारण पहिली चिठ्ठी त्यांच्यासाठी होती):<verse eid="1CH 6:54" /></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55" />यहूदीयाच्या प्रदेशातील हेब्रोन हे नगर त्याच्या शिवारांसहित दिले. <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" />पण त्या नगराची शेते व गावे यफुन्नेहचा पुत्र कालेब याला दिली. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" />अहरोनाच्या वंशजास पुढील नगरे देण्यात आली: हेब्रोन (शरणपूर म्हणून), लिब्नाह<note caller="+" style="f"><char style="fr" closed="false">6:57 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">आश्रयाचे शहर</char></note> व त्याचे शिवार, यत्तीर, एशतमोआ, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />हीलेन, दबीर, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />आशान, युताह, बेथ-शेमेश सर्व त्यांच्या शिवारासह.<verse eid="1CH 6:59" /></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60" />बिन्यामीनच्या गोत्रास गिबोन, गेबा, आलेमेथ आणि अनाथोथ ही सर्व त्यांच्या शिवारासह.</para>
  <para style="lf" vid="1CH 6:60">त्यांच्या घराण्यांची एकंदर सगळी नगरे तेरा होती.<verse eid="1CH 6:60" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61" />अवशिष्ट राहिलेल्या कोहाथी वंशजास चिठ्ठ्या टाकून मनश्शेहच्या अर्ध्या वंशजाच्या प्रदेशातून दहा नगरे दिली.<verse eid="1CH 6:61" /></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62" />गेर्षोम वंशजास त्यांच्या पितृकुळाप्रमाणे इस्साखार, आशेर, नफताली व बाशानात राहणाऱ्या मनश्शेह वंशाची तेरा नगरे दिली.<verse eid="1CH 6:62" /></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63" />मरारी वंशजास चिठ्ठ्या टाकून त्यांच्या पितृकुळाप्रमाणे रऊबेन, गाद व जबुलून या गोत्रांच्या प्रदेशातून बारा नगरे दिली.<verse eid="1CH 6:63" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64" />इस्राएली लोकांनी लेवी वंशजास ही नगरे त्यांच्या शिवारांसहित दिली.<verse eid="1CH 6:64" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65" />त्यांनी यहूदाह, शिमओन व बिन्यामीन या वंशांमधून चिठ्ठ्या टाकून आधी उल्लेख केलेली नगरे दिली.<verse eid="1CH 6:65" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66" />एफ्राईम वंशजाने कोहाथ पितृकुळाला जी नगरे त्यांच्या शिवारांसहित दिली ती ही:<verse eid="1CH 6:66" /></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67" />एफ्राईमच्या डोंगराळ प्रदेशातील नगर शेखेम (शरणपूर) व त्याचे शिवार, तसेच गेजेर व त्याचे शिवार, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" />योकमेअम, बेथ-होरोन, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />अय्यालोन, गथ-रिम्मोन हे सर्व त्यांच्या शिवारासह.<verse eid="1CH 6:69" /></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70" />तसेच मनश्शेहच्या अर्ध्या गोत्रातून आनेर आणि बिलाम, त्यांच्या शिवारासह. ही कोहाथी पितृकुळातील अवशिष्ट वंशजास दिली.<verse eid="1CH 6:70" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71" />गेर्षोमाच्या वंशजास जी नगरे मिळाली ती ही:</para>
  <para style="li1" vid="1CH 6:71">मनश्शेहच्या अर्ध्या गोत्रातून बाशानातले गोलान व अष्टारोथ त्यांच्या शिवारासह;<verse eid="1CH 6:71" /></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72" />इस्साखारच्या गोत्रातून केदेश व दाबरथ, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />रामोथ व त्याचे शिवार आणि आनेम व त्याचे शिवार ही दिली;<verse eid="1CH 6:73" /></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74" />आशेरच्या गोत्रातून माशाल व त्याचे शिवार, अब्दोन व त्याचे शिवार, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />हुक्कोक व त्याचे शिवार आणि रहोब व त्याचे शिवार ही दिली;<verse eid="1CH 6:75" /></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76" />नफताली गोत्रातून गालीलातील केदेश व त्याचे शिवार, हम्मोन व त्याचे शिवार आणि किर्याथाईम व त्याचे शिवार ही दिली.<verse eid="1CH 6:76" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77" />लेवीच्या बाकी लोकांना म्हणजे मरारी वंशजास जी शहरे दिली ती ही:</para>
  <para style="li1" vid="1CH 6:77">जबुलूनाच्या गोत्रातून रिम्मोनो आणि ताबोर त्यांच्या शिवारासह;<verse eid="1CH 6:77" /></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78" />यार्देनेपलीकडे यरीहोजवळ, यार्देनेच्या पूर्वथडीस रऊबेन गोत्रातून रानातले बेसेर व त्याचे शिवार, याहसाह व त्याचे शिवार, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />केदेमोथ व त्याचे शिवार आणि मेफाथ व त्याचे शिवार ही दिली;<verse eid="1CH 6:79" /></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80" />आणि गाद गोत्रातून गिलआदी रामोथ व त्याचे शिवार, महनाईम व त्याचे शिवार, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" />हेशबोन व त्याचे शिवार आणि याजेर व त्याचे शिवार ही दिली.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">इस्साखार</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1" />इस्साखारचे पुत्र:</para>
  <para style="li2" vid="1CH 7:1">तोला, पुआह, याशूब व शिम्रोन; एकूण चार पुत्र.<verse eid="1CH 7:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2" />तोलाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:2">उज्जी, रफायाह, यरीएल, यहमय, इबसाम व शमुवेल हे—त्याचा पिता तोलाच्या घराण्याचे प्रमुख असून आपल्या वंशातील योद्धे होते. त्यांची संख्या दावीदाच्या कारकिर्दीत 22,600 होती.<verse eid="1CH 7:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3" />उज्जी पुत्र:</para>
  <para style="li2" vid="1CH 7:3">इज्राह.</para>
  <para style="li1" vid="1CH 7:3">इज्राहचा पुत्र:</para>
  <para style="li2" vid="1CH 7:3">मिखाएल, ओबद्याह, योएल व इश्शीयाह असे एकूण पाच प्रमुख पुरुष होते. <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />त्यांच्या कुटुंबाप्रमाणे व पितृकुळाप्रमाणे लढाईच्या सैन्याच्या टोळ्यांत त्याचे 36,000 पुरुष असत, कारण त्यांना पुष्कळ स्त्रिया व संतती होती.<verse eid="1CH 7:4" /></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5" />इस्साखारच्या सर्व कुळातील त्यांचे भाऊबंद योद्धे होते. वंशावळीत ते एकंदर 87,000 नमूद झाले.<verse eid="1CH 7:5" /></para>
  <para style="s1">बिन्यामीन</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6" />बिन्यामीनचे तीन पुत्र:</para>
  <para style="li2" vid="1CH 7:6">बेला, बेकेर व यदिएल.<verse eid="1CH 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7" />बेलाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:7">एसबोन, उज्जी, उज्जीएल, यरिमोथ व ईरी; असे पाच पुत्र होते. हे आपल्या पितृकुळांचे प्रमुख असून 22,034 योद्धे होते.<verse eid="1CH 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8" />बेकेराचे पुत्र:</para>
  <para style="li2" vid="1CH 7:8">जमीराह, योआश, एलिएजर, एलिओएनाइ, ओमरी, यरेमोथ, अबीयाह, अनाथोथ व अलेमेथ. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />ते आपआपल्या पितृकुळाचे प्रमुख असून, वंशावळीत 20,200 योद्धे नमूद झाले होते.<verse eid="1CH 7:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10" />यदिएलाचा पुत्र:</para>
  <para style="li2" vid="1CH 7:10">बिल्हान.</para>
  <para style="li1" vid="1CH 7:10">बिल्हानाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:10">यऊश, बिन्यामीन, एहूद, केनानाह, जेथान, तार्शीश व अहीशाहर. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />हे सर्व यदिएलाचे वंशज होते. ते आपल्या कुटुंबाचे प्रमुख असून युद्धासाठी जाण्यास योग्य 17,200 योद्धे होते.<verse eid="1CH 7:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12" />ईराचे वंशज शुप्पीम व हुप्पीम आणि अहेराचा वंशज हुशीम.<verse eid="1CH 7:12" /></para>
  <para style="s1">नफताली</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13" />नफतालीचे पुत्र:</para>
  <para style="li2" vid="1CH 7:13">यहसिएल, गूनी, येसेर व शल्लूम<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">शल्लूम</char></note>. ही बिल्हाची संतती.<verse eid="1CH 7:13" /></para>
  <para style="s1">मनश्शेह</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14" />मनश्शेहचे वंशज:</para>
  <para style="li2" vid="1CH 7:14">त्याच्या पत्नीपासून त्याला अस्रिएल झाला. त्याच्या अरामी उपपत्नीपासून त्याला गिलआदाचा पिता माखीर झाला. <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" />माखीराने हुप्पीम व शुप्पीमची बहीण पत्नी केली; तिचे नाव माकाह. त्याच्या दुसर्‍या पुत्राचे नाव सलाफहाद. सलाफादाला फक्त कन्याच होत्या. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />माखीराची पत्नी माकाहला पुत्र झाला. त्याचे नाव तिने पेरेस ठेवले. त्याच्या भावाचे नाव शेरेष, त्याचे पुत्र ऊलाम व रेकेम.<verse eid="1CH 7:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17" />ऊलामाचा पुत्र:</para>
  <para style="li2" vid="1CH 7:17">बदान.</para>
  <para style="li1" vid="1CH 7:17">हे गिलआदाचे पुत्र माखीराचे पुत्र व मनश्शेहचे पुत्र.<verse eid="1CH 7:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18" />त्याची बहीण हम्मोलेखेथ हिला इशहोद, अबिएजेर व महलाह झाली.<verse eid="1CH 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19" />शेमीदाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:19">अह्यान, शेखेम, लिखी व अनीयाम.<verse eid="1CH 7:19" /></para>
  <para style="s1">एफ्राईम</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20" />एफ्राईमचे वंशज:</para>
  <para style="li2" vid="1CH 7:20">एफ्राईमचा पुत्र शुथेलह, त्याचा पुत्र बेरेद,</para>
  <para style="li2" vid="1CH 7:20">त्याचा पुत्र तहथ, त्याचा पुत्र एलिआदाह,</para>
  <para style="li2" vid="1CH 7:20">त्याचा पुत्र तहथ, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />त्याचा पुत्र जाबाद,</para>
  <para style="li2" vid="1CH 7:21">त्याचा पुत्र शुथेलह.</para>
  <para style="li2" vid="1CH 7:21">(आणि एजेर व एलद; यास गथच्या मूळ रहिवाशांनी मारून टाकले, कारण त्यांची गुरे जप्त करण्यास ते गेले होते. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />यामुळे त्यांचा पिता एफ्राईमने पुष्कळ दिवस शोक केला आणि त्याचे भाऊबंद त्याचे सांत्वन करण्यास आले. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />तो आपल्या पत्नीजवळ गेला आणि ती गर्भवती होऊन तिला एक पुत्र झाला. त्याने त्याचे नाव बरीयाह<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">शोकांतिका</char></note> असे ठेवले, कारण त्याच्या घराण्यावर दुर्दैव ओढवले होते. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" />त्याची कन्या शेराह होती. तिने खालचे व वरचे बेथ-होरोन व उज्जेन-शेराह ही वसविली.)<verse eid="1CH 7:24" /></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25" />त्याचा पुत्र रेफह व त्याचा पुत्र रेशेफ,</para>
  <para style="li2" vid="1CH 7:25">रेशेफाचा पुत्र तेलह, तेलहाचा पुत्र तहन,<verse eid="1CH 7:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26" />त्याचा पुत्र लादान, त्याचा पुत्र अम्मीहूद,</para>
  <para style="li2" vid="1CH 7:26">त्याचा पुत्र एलीशामा, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" />त्याचा पुत्र नून</para>
  <para style="li2" vid="1CH 7:27">व त्याचा पुत्र यहोशुआ.<verse eid="1CH 7:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28" />त्यांच्या वस्त्या व नगरे बेथेल व त्याच्या आसपासची गावे, पूर्वेस नारान, पश्चिमेस गेजेर व त्याची गावे, शेखेम व त्याची गावे, गाझा व त्याची गावे आणि अय्याहपर्यंत त्याची वतने होती. <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" />त्याप्रमाणेच मनश्शेहच्या सीमेवरील बेथ-शान व त्याची गावे, तानख व त्याची गावे, मगिद्दो व त्याची गावे, दोर व त्याची गावे होती. यात इस्राएलचा पुत्र योसेफाचे वंशज राहात.<verse eid="1CH 7:29" /></para>
  <para style="s1">आशेर</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30" />आशेराचे पुत्र:</para>
  <para style="li2" vid="1CH 7:30">इम्नाह, इश्वा, इश्वी व बरीयाह, त्यांची बहीण सेराह.<verse eid="1CH 7:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31" />बरीयाहचे पुत्र:</para>
  <para style="li2" vid="1CH 7:31">हेबेर व मालकीएल, मालकीएल हा बिर्जाइथाचा पिता.<verse eid="1CH 7:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32" />हेबेरास यफलेट, शोमेर, होथाम व त्यांची बहीण शूवा झाली.<verse eid="1CH 7:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33" />यफलेटाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:33">पासख, बिह्माल व अश्वाथ.</para>
  <para style="lf" vid="1CH 7:33">ही यफलेटाची संतती होती.<verse eid="1CH 7:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34" />शोमेराचे पुत्र:</para>
  <para style="li2" vid="1CH 7:34">अही, रोहगाह, येहूब्बाह व अराम.<verse eid="1CH 7:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35" />शोमेराचा भाऊ हेलेम याचे पुत्र:</para>
  <para style="li2" vid="1CH 7:35">सोफह, इम्ना, शेलेश व आमाल.<verse eid="1CH 7:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36" />सोफहाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:36">सूहा, हर्नेफेर, शूआल, बेरी, इम्राह, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />बेसेर, होद, शाम्मा शिलशाह, इथरान<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">दुसरे नाव </char><char style="fqa" closed="false">येथेर</char></note> व बैरा.<verse eid="1CH 7:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38" />येथेराचे पुत्र:</para>
  <para style="li2" vid="1CH 7:38">यफुन्नेह, पिस्पाह व अरा.<verse eid="1CH 7:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39" />उल्लाचे पुत्र:</para>
  <para style="li2" vid="1CH 7:39">आरह, हन्निएल, रिस्याह.<verse eid="1CH 7:39" /></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40" />आशेराचे हे सर्व वंशज—आपल्या कुटुंबाचे प्रमुख होते. ते सर्व शूर योद्धे व प्रसिद्ध सरदार होते. त्यांची अधिकृत मोजदाद केली तेव्हा ते 26,000 योद्धे भरले.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">बिन्यामीन शौलाची वंशावळी</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1" />बिन्यामीनच्या पुत्रांची नावे:</para>
  <para style="li2" vid="1CH 8:1">ज्येष्ठपुत्र बेला,</para>
  <para style="li2" vid="1CH 8:1">दुसरा आशबेल, तिसरा अहरह,<verse eid="1CH 8:1" /></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2" />चौथा नोआह व पाचवा राफा.<verse eid="1CH 8:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3" />बेलाचे पुत्र:</para>
  <para style="li2" vid="1CH 8:3">अद्दार, गेरा, अबीहूद,<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">किंवा </char><char style="fq" closed="false">गेरा </char><char style="fqa" closed="false">एहूदचा बाप</char></note> <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" />अबीशूवा, नामान, अहोआह, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />गेरा, शेफूफान व हुराम.<verse eid="1CH 8:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6" />एहूदाचे पुत्र, जे गेबा येथील कुटुंबाचे प्रमुख होते, ज्यांचा पाडाव करून त्यांना मानाहथ येथे नेले ते:<verse eid="1CH 8:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7" />नामान, अहीयाह व गेरा यास कैद करून पाठविण्यात आले. गेराचे पुत्र उज्जा व अहीहूद.<verse eid="1CH 8:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8" />शहरयिमाने आपल्या पत्नी हुशीम व बारा यांच्यापासून घटस्फोट घेतला व मोआब देशामध्ये त्याला पुत्र झाले. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />त्याची पत्नी होदेशच्या पोटी झालेले पुत्र: योबाब, सिब्या, मेशा, मल्काम, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />यऊस, शख्याह व मिर्माह. हे त्यांच्या कुटुंबाचे प्रमुख होते. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />हुशीमेपासून त्यास झालेले पुत्र अबीतूब व एल्पाल.<verse eid="1CH 8:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12" />एल्पालाचे पुत्र:</para>
  <para style="li2" vid="1CH 8:12">एबर, मिशाम व शमेद (ज्याने ओनो व लोद ही नगरे व त्यांच्या आसपासची गावे वसविली), <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />बरीयाह व शमा हे अय्यालोन लोकांचे कुटुंबप्रमुख होते व त्यांनी गथकरास पळवून लावले.<verse eid="1CH 8:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14" />अहियो, शशक, यरेमोथ, <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />जबद्याह, अराद, एदर, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />मिखाएल, इश्पाह व योहा हे बरीयाहचे पुत्र.<verse eid="1CH 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17" />जबद्याह, मशुल्लाम, हिज्की, हेबेर, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />इश्मरय, इज्लीयाह व योबाब हे एल्पालाचे पुत्र.<verse eid="1CH 8:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19" />याकीम, जिक्री, जब्दी, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />अलीएनय, सिलथाई, एलीएल, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />अदायाह, बरीयाह व शिम्राथ हे शिमीचे पुत्र.<verse eid="1CH 8:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22" />इश्पान, एबर, एलीएल, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />अब्दोन, जिक्री, हानान, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />हनन्याह, एलाम, अनथोथीयाह, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />इफदयाह व पेनुएल हे शशकाचे पुत्र.<verse eid="1CH 8:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26" />शमशेराय, शहर्‍याह, अथल्याह, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />यारेश्याह, एलीयाह व जिक्री हे यरोहामाचे पुत्र.<verse eid="1CH 8:27" /></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28" />हे त्यांच्या पिढीतील कुटुंबप्रमुख असून ते यरुशलेम येथे राहात असत.<verse eid="1CH 8:28" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29" />गिबोनचा पिता ईयेल, गिबोन येथे स्थायिक झाला.</para>
  <para style="li2" vid="1CH 8:29">त्याच्या पत्नीचे नाव माकाह. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />त्याच्या पुत्रांची नावे: ज्येष्ठ अब्दोन, मग सूर, कीश, बाल, नेर, नादाब, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />गदोर, अहियो, जेखर <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />आणि मिकलोथ जो शिमिआचा पिता. त्यांनीही त्यांच्या नातलगांजवळ यरुशलेम येथे वस्ती केली.<verse eid="1CH 8:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33" />नेराला कीश झाला, कीशाला शौल, शौलाला योनाथान, मलकीशुवा, अबीनादाब व एश-बाल<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">इश-बोशेथ</char></note> हे पुत्र झाले.<verse eid="1CH 8:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34" />योनाथानाचा पुत्र:</para>
  <para style="li2" vid="1CH 8:34">मरीब-बाल<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मेफीबोशेथ</char></note> ला मीखाह झाला.<verse eid="1CH 8:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35" />मीखाहचे पुत्र:</para>
  <para style="li2" vid="1CH 8:35">पीथोन, मेलेख, तरेया व आहाज.<verse eid="1CH 8:35" /></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36" />आहाजास यहोअद्दा, यहोअद्दाहास आलेमेथ, अजमावेथ व जिम्री, जिम्रीस मोसा. <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />मोसाला बिना, बिनाला राफाह, राफाहला एलीयासाह, व एलीयासाहला आजेल झाले.<verse eid="1CH 8:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38" />आजेलास सहा पुत्र होते. त्यांची नावे अशी:</para>
  <para style="li2" vid="1CH 8:38">अज्रीकाम, बोखेरू, इश्माएल, शिआरियाह, ओबद्याह व हानान. हे सर्व आजेलाचे पुत्र.<verse eid="1CH 8:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39" />त्याचा भाऊ एशेकाचे पुत्र:</para>
  <para style="li2" vid="1CH 8:39">ज्येष्ठ ऊलाम, दुसरा यऊश व तिसरा एलिफेलेत. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />ऊलामाचे वंशज शूरवीर असून धनुर्धारी होते; त्यांचे पुत्र पौत्रे एकूण 150 लोक.</para>
  <para style="li1" vid="1CH 8:40">हे सर्व बिन्यामीनचे वंशज होते.<verse eid="1CH 8:40" /></para>
  <para style="b" />
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />याप्रकारे सर्व इस्राएली लोकांच्या वंशावळ्या इस्राएलच्या व यहूदीयाच्या राजांच्या इतिहासग्रंथात नमूद केलेल्या आहेत; या लोकांच्या अविश्वासूपणामुळे त्यांना बंदिवान करून बाबिलोन देशी नेले.<verse eid="1CH 9:1" /></para>
  <para style="s1">यरुशलेमचे रहिवासी</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2" />जे सर्वप्रथम स्वतःच्या वतनातील आपल्या नगरात राहण्यास आले, त्यातील काही इस्राएली, याजक, लेवी व मंदिराचे सेवक होते.<verse eid="1CH 9:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3" />यहूदाह, बिन्यामीन, एफ्राईम व मनश्शेह यांच्यापैकी जे यरुशलेममध्ये राहण्यास आले:<verse eid="1CH 9:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4" />ऊथय जो अम्मीहूदाचा पुत्र, जो ओमरीचा पुत्र, जो इम्रीचा पुत्र व जो बानीचा पुत्र, हा यहूदाहचा पुत्र पेरेसचा वंशज होता.<verse eid="1CH 9:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5" />शिलोनी वंश:</para>
  <para style="li2" vid="1CH 9:5">त्याचा ज्येष्ठपुत्र असायाह व त्याचे पुत्र.<verse eid="1CH 9:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6" />जेरही वंश:</para>
  <para style="li2" vid="1CH 9:6">यऊवेल.</para>
  <para style="lf" vid="1CH 9:6">यहूदाहचे 690 लोकही आले.<verse eid="1CH 9:6" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7" />बिन्यामीन वंशातून:</para>
  <para style="li1" vid="1CH 9:7">सल्लू जो मशुल्लामाचा पुत्र, जो होदव्याहचा पुत्र व जो हस्सनुआहाचा पुत्र;<verse eid="1CH 9:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8" />इबनीयाह जो यरोहामाचा पुत्र;</para>
  <para style="li1" vid="1CH 9:8">एलाह जो उज्जी पुत्र, जो मिकरीचा पुत्र;</para>
  <para style="li1" vid="1CH 9:8">मशुल्लाम जो शफाट्याहचा पुत्र, जो रऊएलाचा पुत्र व जो इबनीयाहचा पुत्र;<verse eid="1CH 9:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9" />वंशावळीत नोंद झालेल्या बिन्यामीन लोकांची एकूण संख्या 956 होती. हे सर्व लोक कुटुंबप्रमुख होते.<verse eid="1CH 9:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10" />याजकातील:</para>
  <para style="li1" vid="1CH 9:10">यदायाह; यहोयारीब; याखीन;<verse eid="1CH 9:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11" />अजर्‍याह जो हिल्कियाहचा पुत्र, जो मशुल्लामाचा पुत्र, जो सादोकाचा पुत्र, जो मरायोथाचा पुत्र व जो अहीतूबचा पुत्र, हा परमेश्वराच्या मंदिराचा प्रमुख अधिकारी होता;<verse eid="1CH 9:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12" />अदायाह याजकही परतला. तो यरोहामाचा पुत्र जो पशहूराचा पुत्र, जो मल्कीयाहचा पुत्र होता;</para>
  <para style="li1" vid="1CH 9:12">मआसाई जो अदिएलाचा पुत्र, जो यहजेराचा पुत्र, जो मशुल्लामाचा पुत्र, जो मेशिल्लेमीथाचा पुत्र, जो इम्मेराचा पुत्र.<verse eid="1CH 9:12" /></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13" />जे कुटुंबप्रमुख होते, त्या 1,760 याजकांची नोंद झाली. परमेश्वराच्या मंदिराच्या सेवाकार्यास हे पुरुष जबाबदार होते.<verse eid="1CH 9:13" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14" />लेवींमधून:</para>
  <para style="li1" vid="1CH 9:14">शमायाह जो हश्शूबचा पुत्र, जो अज्रीकामचा पुत्र, जो हशब्याहाचा पुत्र. हे मरारी वंशाचे होते;<verse eid="1CH 9:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15" />बकबक्कार, हेरेश, गालाल, आणि मत्तन्याह जो मीखाहचा पुत्र, जो जिक्रीचा पुत्र, जो आसाफचा पुत्र;<verse eid="1CH 9:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16" />ओबद्याह जो शमायाहचा पुत्र, जो गालालचा पुत्र, जो यदूथूनचा पुत्र;</para>
  <para style="li1" vid="1CH 9:16">जो बेरेख्याहचा पुत्र, जो आसाचा पुत्र, जो एलकानाहचा पुत्र, जो नटोफाथीच्या वस्तीत राहत असे.<verse eid="1CH 9:16" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17" />द्वारपाल:</para>
  <para style="li1" vid="1CH 9:17">शल्लूम, अक्कूब, तल्मोन, अहीमान व त्यांचे लेवी भाऊबंद. शल्लूम त्यांचा प्रमुख होता; <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" />आजवर ते राजाच्या पूर्वेकडील प्रवेशद्वारावर कार्यरत आहेत; लेवींच्या छावणीचे द्वारपाल हेच होते.<verse eid="1CH 9:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19" />शल्लूम जो कोरेचा पुत्र, जो एब्यासाफचा पुत्र, जो कोरहचा पुत्र आणि त्यांच्या कुटुंबातील त्याचे द्वारपाल भाऊबंद जे कोरही होते, त्यांची उपासनेच्या कामावर नेमणूक केलेली असून, ते त्यांच्या पूर्वजांसारखे याहवेहच्या भवनाच्या व्दाराची रखवाली करीत.<verse eid="1CH 9:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20" />पूर्वीच्या काळी एलअज़ारचा पुत्र फिनहास या सर्वांवर द्वारपालांचा अधिकृत अधिकारी होता. याहवेहचे सानिध्य त्यांच्याबरोबर होते.<verse eid="1CH 9:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21" />मशेलेम्याहचा पुत्र जखर्‍याह सभामंडपाचा द्वारपाल होता.<verse eid="1CH 9:21" /></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22" />द्वारपालांच्या कामासाठी 212 लोक निवडले होते. त्यांच्या गावी त्यांच्या वंशावळीत त्यांची नोंद केलेली होती.</para>
  <para style="b" vid="1CH 9:22" />
  <para style="p" vid="1CH 9:22">विश्वासयोग्यता पाहून त्यास दावीद व शमुवेल संदेष्टा यांनी त्या कामगिरीवर नेमले होते. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />ते व त्यांचे वंशज याहवेहच्या भवनाच्या म्हणजे सभामंडपाच्या द्वारपालाचे काम पाहत असत. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />पूर्व, पश्चिम, उत्तर व दक्षिण अशा चारही दिशांना द्वारपाल ठेवण्यात आले होते. <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" />त्यांच्या गावात राहणारे त्यांचे भाऊबंद सात दिवसात पाळीपाळीने कार्य करीत. <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" />परंतु चारही मुख्य द्वारपाल विश्वासू लेवीय असून त्यांच्याकडे परमेश्वराच्या भवनाच्या कोठड्या व भांडारे यांची जबाबदारी सोपविली होती. <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" />परमेश्वराच्या भवनाचे रक्षण त्यांच्याकडे सोपविले असल्यामुळे रात्री ते मंदिराच्या आसपास राहत असत आणि दररोज सकाळी परमेश्वराचे भवन उघडण्यासाठी चावी त्यांच्याच ताब्यात असे.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />सेवेसंबंधीची पात्रे त्यांच्यापैकी काहीजणांच्या ताब्यात असत; ती पात्रे ते मोजून आत ठेवीत व मोजून बाहेर काढीत. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" />त्यांच्यापैकी काहीजणांकडे सामानसुमान, पवित्रस्थानातील सर्व पात्रे, सपीठ, द्राक्षारस, तेल, ऊद व सुगंधी द्रव्ये यांची व्यवस्था असे. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" />याजकांपैकी काहीजण सुगंधी मसाले तयार करीत असत. <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" />तव्यावर विश्वासयोग्यतेने ज्या वस्तू भाजण्यात येत, त्यावर देखरेख करण्यासाठी लेव्यांपैकी कोरही शल्लूमचा ज्येष्ठपुत्र मत्तिथ्याहला नेमले. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" />कोहाथी कुळातील त्यांच्या काही लेवी भाऊबंदांची नेमणूक दर शब्बाथ दिवशी समर्पित भाकरी तयार करण्याच्या कामावर झाली होती.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />काही लेवी कुटुंबप्रमुख जे मंदिरातील संगीतासाठी जबाबदार होते, ते मंदिराच्या काही खोल्यात राहत असत आणि त्यांना संगीताशिवाय इतर कामे नव्हती, कारण त्या कामाची त्यांना रात्रंदिवस जबाबदारी देण्यात आली होती.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34" />हे सर्व लेवी वंशातील कुटुंबप्रमुख असून त्यांची प्रमुख म्हणून वंशावळीत नोंद झाली होती, ते यरुशलेमात राहात.<verse eid="1CH 9:34" /></para>
  <para style="s1">शौलाची वंशावळ</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35" />गिबोनचा<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">सेनानायक</char></note> पिता ईयेल गिबोन येथे स्थायिक झाला.</para>
  <para style="li2" vid="1CH 9:35">त्याच्या पत्नीचे नाव माकाह होते. <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />त्याच्या पुत्रांची नावे अशी: ज्येष्ठ अब्दोन, मग सूर, कीश, बाल, नेर, नादाब, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />गदोर, अहियो, जखर्‍याह आणि मिकलोथ. <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />मिकलोथ जो शिमिआमचा पिता होता. या सर्वांनी त्यांच्या नातलगांजवळ यरुशलेमेत वस्ती केली.<verse eid="1CH 9:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39" />नेराला कीश झाला; कीशाला शौल, शौलाला योनाथान, मलकीशुवा, अबीनादाब व एश-बाल हे पुत्र झाले.<verse eid="1CH 9:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40" />योनाथानाचा पुत्र:</para>
  <para style="li2" vid="1CH 9:40">मरीब-बाल. मरीब-बाल याला मीखाह.<verse eid="1CH 9:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41" />मीखाहचे पुत्र:</para>
  <para style="li2" vid="1CH 9:41">पीथोन, मेलेख, तहरेया व आहाज.<verse eid="1CH 9:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42" />आहाजास येरह<note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">यादाह</char></note>, यादाहास आलेमेथ, अजमावेथ व जिम्री झाले, जिम्रीस मोसा. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />मोसाला बिना, बिनाला रफायाह, रफायाहला एलीयासाह, व एलीयासाहला आजेल झाले.<verse eid="1CH 9:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44" />आजेलास सहा पुत्र होते. त्यांची नावे:</para>
  <para style="li2" vid="1CH 9:44">अज्रीकाम, बोखेरू, इश्माएल, शिआरियाह, ओबद्याह व हानान. हे सर्व आजेलाचे पुत्र होते.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">शौल स्वतःचा प्राणत्याग करतो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />पलिष्ट्यांनी इस्राएलविरुद्ध युद्ध केले; इस्राएली लोक त्यांच्यापुढून पळून गेले, आणि गिलबोआ डोंगरावर पुष्कळजण मारले गेले. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />पलिष्ट्यांनी शौल आणि त्याच्या पुत्रांचा आवेशाने पाठलाग केला आणि त्याचे पुत्र योनाथान, अबीनादाब आणि मलकी-शुआ यांना ठार मारले. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />शौलाच्या सर्व बाजूंनी युद्ध भयंकर वाढत गेले आणि जेव्हा धनुर्धऱ्यांनी त्याला गाठले व त्याला जखमी केले.<verse eid="1CH 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4" />तेव्हा शौल त्याच्या शस्त्रवाहकाला म्हणाला, “तुझी तलवार उपस आणि मला आरपार भोसक, नाहीतर हे बेसुंती लोक येऊन माझी विटंबना करतील.”</para>
  <para style="p" vid="1CH 10:4">परंतु त्याचा शस्त्रवाहक घाबरून गेला होता आणि तो तसे करेना; तेव्हा शौलाने त्याची स्वतःची तलवार घेतली आणि तिच्यावर तो पडला. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />जेव्हा शस्त्रवाहकाने पाहिले की शौल मरण पावला आहे, तेव्हा तो सुद्धा आपल्या तलवारीवर पडला आणि मरण पावला. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />अशाप्रकारे शौल आणि त्याचे तीन पुत्र मरण पावले, त्याचे सर्व कुटुंब एकत्रच मृत्यू पावले.<verse eid="1CH 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7" />जेव्हा खोर्‍यात असलेल्या इस्राएली लोकांनी पाहिले की सैन्याने पळ काढला आहे आणि शौल आणि त्याचे पुत्र मरण पावले आहेत, तेव्हा त्यांनी त्यांची नगरे सोडली आणि तिथून पलायन केले. पलिष्ट्यांनी येऊन तिथे वस्ती केली.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />दुसर्‍या दिवशी जेव्हा पलिष्टी लोक मेलेल्या लोकांच्या वस्तू लुटण्यासाठी आले, तेव्हा त्यांना गिलबोआ डोंगरावर शौल आणि त्याचे पुत्र मृत होऊन पडलेले दिसले. <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />त्यांनी शौलास लुबाडून, त्याचे शिर व त्याचे शस्त्र काढून घेतले आणि पलिष्ट्यांच्या संपूर्ण देशामध्ये आणि त्यांच्या मूर्तींमध्ये आणि आणि त्यांच्या लोकांमध्ये जाहीर करण्यास संदेशवाहक पाठवले. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />त्यांनी त्याची शस्त्रे त्यांच्या दैवतांच्या मंदिरात ठेवली आणि त्याचे शिर दागोनाच्या मंदिरात टांगले.<verse eid="1CH 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11" />पलिष्टी लोकांनी शौलाचे काय केले हे जेव्हा याबेश-गिलआदच्या रहिवाशांनी ऐकले, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />तेव्हा त्यांचे सर्व शूर पुरुष रणांगणावर गेले व त्यांनी शौल आणि त्याच्या पुत्रांचे मृतदेह याबेश येथे परत आणले. त्यांच्या अस्थी याबेश येथील एला झाडाखाली पुरल्या आणि सात दिवस उपास केला.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />याहवेहशी अविश्वासू राहिल्यामुळे शौलाला मृत्यू आला; कारण त्याने याहवेहची आज्ञा न पाळता, एका भूतविद्याप्रवीण स्त्रीचा सल्ला घेतला, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" />आणि याहवेहचे मार्गदर्शन नाकारले, यामुळे याहवेहने त्याचा वध केला आणि त्याचे राज्य इशायाचा पुत्र दावीदास सोपविले.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">दावीद इस्राएलचा राजा झाला</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />मग इस्राएलचे पुढारी एकत्र आले व हेब्रोन येथे दावीदाकडे आले आणि त्याला म्हणाले, “आम्ही तर तुमचेच मांस आणि रक्त आहोत. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />मागील काळात, जेव्हा शौल राजा होता, तेव्हा इस्राएलला त्यांच्या युद्धात चालविणारे तुम्हीच तर होता. आणि याहवेह तुमच्या परमेश्वराने तुम्हाला म्हटले, ‘माझ्या इस्राएली लोकांचा मेंढपाळ व त्यांचा अधिकारी तू होशील.’ ”<verse eid="1CH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3" />जेव्हा इस्राएलचे सर्व वडील लोक हेब्रोनात दावीद राजाकडे आले होते, तेव्हा त्याने याहवेहसमोर हेब्रोन येथे त्यांच्याशी एक करार केला आणि त्यांनी दावीदाचा इस्राएलचा राजा म्हणून अभिषेक केला, जसे याहवेहने शमुवेलद्वारे वचन दिले होते.<verse eid="1CH 11:3" /></para>
  <para style="s1">दावीद यरुशलेम जिंकून घेतो</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />नंतर दावीद व इस्राएलचे सर्व लोक मिळून यरुशलेमला (म्हणजे यबूसला) गेले. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />तिथे राहणारे यबूसी लोक दावीदाला म्हणाले, “तू या शहरात प्रवेश करू शकणार नाही.” तरीही, दावीदाने सीयोन गड हस्तगत केला; हेच दावीदाचे शहर आहे.<verse eid="1CH 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6" />दावीद म्हणाला, “जो कोणी यबूसींवर हल्ला करण्यात पुढाकार घेईल तो सेनापती होईल.” मग जेरुइयाहचा पुत्र योआबने पहिल्याने आक्रमण करण्यास गेल्यामुळे तो दावीदाच्या सैन्याचा सेनापती झाला.<verse eid="1CH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7" />तेव्हा दावीदाने त्या गडामध्ये आपला निवास केला, म्हणून त्याला दावीदाचे शहर असे नाव पडले. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />दावीदाने मिल्लोपासून गडाभोवतालच्या शहराच्या भागाचा विस्तार केला आणि योआबाने बाकी यरुशलेमची पुनर्बांधणी केली. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />आणि दावीद अधिकाधिक शक्तिशाली बनत गेला, कारण सर्वसमर्थ याहवेह त्याच्याबरोबर होते.<verse eid="1CH 11:9" /></para>
  <para style="s1">दावीदाचे शूर योद्धे</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />दावीदाच्या काही अत्यंत शूर योद्ध्यांची नावे पुढीलप्रमाणे आहेत—याहवेहच्या कराराप्रमाणे या योद्ध्यांनी इस्राएली पुढार्‍यांसह राज्याची वाढ करण्यासाठी त्याला मजबूत आधार दिला. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" />दावीदाच्या पराक्रमी योद्ध्यांची नावे:</para>
  <para style="p" vid="1CH 11:11">हखमोनी याशबआम<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">दुसरे नाव </char><char style="fqa" closed="false">यशोब-बाल</char></note> हा दावीदाच्या सैन्यातील पहिल्या श्रेणीच्या वीरांपैकी होता; त्याने भाला उगारून एका हल्ल्यात तीनशे लोकांचा वध केला.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />त्याच्यानंतर अहोहचा रहिवासी, दोदोचा पुत्र एलअज़ार होता, तो तीन पराक्रमी योद्ध्यांपैकी एक होता. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />पस-दम्मीम येथे पलिष्ट्यांबरोबर केलेल्या लढाईत तो दावीदाबरोबर होता. तो जवाच्या शेतात असताना इस्राएली सैन्याने पलिष्ट्यांपुढून पळ काढला होता. <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />परंतु ते त्या शेताच्या मध्यभागी उभे राहिले, त्यांनी सामना केला आणि पलिष्ट्यांना मारून टाकले आणि याहवेहने त्या दिवशी मोठा विजय मिळवून दिला.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />जेव्हा पलिष्ट्यांच्या टोळीने रेफाईमच्या खोर्‍यात छावणी दिली होती तेव्हा तीस मुख्य सेनापती योद्ध्यांपैकी तिघे जण दावीदाकडे अदुल्लाम गुहेतील खडकाकडे आले. <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />त्यावेळी दावीद गडावर होता आणि पलिष्टी सेना बेथलेहेम नगरात होती. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />दावीदाला पाणी पिण्याची उत्कट इच्छा झाली व तो म्हणाला, “बेथलेहेमच्या वेशीजवळच्या विहिरीचे पाणी मला कोणी आणून दिले तर किती बरे झाले असते!” <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />तेव्हा या तीन पराक्रमी योद्ध्यांनी पलिष्ट्यांच्या छावणीमधून घुसून, बेथलेहेमच्या वेशीजवळच्या विहिरीचे पाणी काढून दावीदाकडे आणले. परंतु दावीदाने ते पिण्याचे नाकारले; आणि ते याहवेहसमोर ओतले. <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />त्याने म्हटले, “परमेश्वर न करो मला ते करावे लागेल. ज्या पुरुषांनी ते आपला जीव धोक्यात घालून आणले त्यांचे रक्त मी प्यावे काय?” कारण ते आणण्यासाठी त्यांनी त्यांचा जीव धोक्यात घातला होता. त्यामुळे दावीद ते पाणी प्याला नाही.</para>
  <para style="p" vid="1CH 11:19">अशी साहसी कामे त्या तीन पराक्रमी योद्ध्यांनी केली होती.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />योआबाचा भाऊ अबीशाई हा तिघांचा प्रमुख होता. त्याने आपला भाला तीनशे लोकांविरुद्ध उगारून त्यांचा वध केला होता, म्हणून तो या तिघांप्रमाणेच प्रसिद्ध झाला होता. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />या तिघांपेक्षा त्याला दुप्पट सन्मान दिला गेला आणि तो त्या तिघांचाही सेनापती झाला, जरी त्या तिघांमध्ये त्याची गणती केली नाही.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />कबसेल येथील यहोयादाचा पुत्र बेनाइयाह एक शूर मनुष्य होता. त्याने मोआबाच्या सर्वात पराक्रमी योद्ध्यांना ठार मारले होते. त्याचप्रमाणे हिमवर्षावाच्या दिवसात खाली गुहेत जाऊन एका सिंहाला ठार मारले. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" />एकदा त्याने पाच हात<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">अंदाजे 2.3 मीटर</char></note> उंचीच्या इजिप्ती मनुष्याला जिवे मारले होते. त्या इजिप्ती माणसाच्या हातात भाला होता, तरी बेनाइयाह केवळ आपली विणकर्‍याची काठी हातात घेऊन त्याच्याशी लढण्यास गेला. त्याने त्याचा भाला हिसकावून घेतला व त्याच्याच भाल्याने त्याला ठार मारले. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />यहोयादाचा पुत्र बेनाइयाहची ही साहसी कामे होती; त्या तीन पराक्रमी योद्ध्यांप्रमाणे त्याने देखील किर्ती मिळविली होती. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />इतर तीस जणांपेक्षा त्याला मोठा सन्मान दिला गेला, परंतु तिघांमध्ये त्याची गणती झाली नाही. आणि दावीदाने त्याला आपल्या अंगरक्षकांचा अधिकारी म्हणून नेमले.<verse eid="1CH 11:25" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26" />दावीदाचे पराक्रमी योद्धे हे होते:</para>
  <para style="b" vid="1CH 11:26" />
  <para style="li1" vid="1CH 11:26">योआबाचा भाऊ असाहेल,</para>
  <para style="li1" vid="1CH 11:26">बेथलेहेमकर दोदोचा पुत्र एलहानान,<verse eid="1CH 11:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27" />हरोरचा शम्मोथ,</para>
  <para style="li1" vid="1CH 11:27">पलोनी हेलेस,<verse eid="1CH 11:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28" />तकोवा येथील इक्केशाचा पुत्र ईरा,</para>
  <para style="li1" vid="1CH 11:28">अनाथोथचा अबिएजेर,<verse eid="1CH 11:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29" />हुशाथचा सिब्बखय,</para>
  <para style="li1" vid="1CH 11:29">अहोहचा ईलाय,<verse eid="1CH 11:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30" />नटोफाथी माहाराई,</para>
  <para style="li1" vid="1CH 11:30">नटोफाथी बाअनाहचा पुत्र हेलेद,<verse eid="1CH 11:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31" />गिबियाहतील बिन्यामीन गोत्रातील रीबाईचा पुत्र इत्तय,</para>
  <para style="li1" vid="1CH 11:31">पिराथोनचा बेनाइयाह,<verse eid="1CH 11:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32" />गाशाच्या ओढ्याजवळचा हूरय,</para>
  <para style="li1" vid="1CH 11:32">अर्बाथचा अबीएल,<verse eid="1CH 11:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33" />बहरूमचा अजमावेथ,</para>
  <para style="li1" vid="1CH 11:33">शालबोनचा एलीहबा,<verse eid="1CH 11:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34" />गिजोन येथील हाशेमचे पुत्र,</para>
  <para style="li1" vid="1CH 11:34">हरार येथील शागे याचा पुत्र योनाथान,<verse eid="1CH 11:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35" />हरार येथील साखार याचा पुत्र अहीयाम,</para>
  <para style="li1" vid="1CH 11:35">ऊरचा पुत्र एलिफाल,<verse eid="1CH 11:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36" />मकेराथी हेफेर,</para>
  <para style="li1" vid="1CH 11:36">पलोनी अहीयाह,<verse eid="1CH 11:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37" />कर्मेलचा हेस्रो,</para>
  <para style="li1" vid="1CH 11:37">एजबयाचा पुत्र नाराय,<verse eid="1CH 11:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38" />नाथानाचा भाऊ योएल,</para>
  <para style="li1" vid="1CH 11:38">हागरीचा पुत्र मिभार,<verse eid="1CH 11:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39" />अम्मोनी सेलेक,</para>
  <para style="li1" vid="1CH 11:39">जेरुइयाहचा पुत्र योआब याचा शस्त्रवाहक बैरोथचा नाहाराई,<verse eid="1CH 11:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40" />इथ्री येथील ईरा,</para>
  <para style="li1" vid="1CH 11:40">इथ्री येथील गारेब,<verse eid="1CH 11:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41" />उरीयाह हिथी,</para>
  <para style="li1" vid="1CH 11:41">अहलायाचा पुत्र जाबाद,<verse eid="1CH 11:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42" />शीझाचा पुत्र अदीना, तो रऊबेनच्या गोत्रातील एकतीस पुढार्‍यांपैकी एक होता.<verse eid="1CH 11:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43" />माकाहचा पुत्र हानान,</para>
  <para style="li1" vid="1CH 11:43">मिथनी योशाफाट,<verse eid="1CH 11:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44" />अष्टराथी उज्जिया,</para>
  <para style="li1" vid="1CH 11:44">अरोएर येथील होथामाचे पुत्र शामा व ईयेल,<verse eid="1CH 11:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45" />शिम्रीचा पुत्र यदिएल,</para>
  <para style="li1" vid="1CH 11:45">व तीसा येथील त्याचा भाऊ योहा,<verse eid="1CH 11:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46" />महवी येथील एलीएल,</para>
  <para style="li1" vid="1CH 11:46">व एलानामाचे पुत्र यरीबय व योशव्याह,</para>
  <para style="li1" vid="1CH 11:46">मोआबी इथ्माह,<verse eid="1CH 11:46" /></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47" />मसोबी एलीएल, ओबेद आणि यासीएल.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">दावीदास येऊन मिळालेले योद्धे</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1" />कीशाचा पुत्र शौलाच्या सानिध्यातून हद्दपार केलेले असताना दावीदाला सिकलाग येथे येऊन मिळालेले योद्धे (ज्यांनी त्याला युद्धात साहाय्य केले त्या योद्ध्यांपैकी असलेले; <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" />हे सर्वच धनुर्धारी वीर असून आपल्या डाव्या आणि उजव्या अशा दोन्ही हातांनी गोफणगुंडे व धनुष्‍यबाण मारण्यात प्रवीण होते. ते सर्वच बिन्यामीन गोत्रातील आणि शौल राजाचे नातलग होते):<verse eid="1CH 12:2" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3" />त्यातील प्रमुख शमाहाचे पुत्र अहीएजर व त्याचा भाऊ योआश, हे गिबियाहचे रहिवासी होते.</para>
  <para style="li1" vid="1CH 12:3">अजमावेथचे पुत्र यजिएल व पेलेट,</para>
  <para style="li1" vid="1CH 12:3">बेराखाह व अनाथोथचा रहिवासी येहू. <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" />इश्मायाह हा गिबोनी होता. हा तीस वीरांतील अत्यंत शूरवीर असून त्या तिसांवरील मुख्य होता.</para>
  <para style="li1" vid="1CH 12:4">यिर्मयाह, यहजिएल, योहानान, गदेराथी योजाबाद, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />एलूजय, यरिमोथ, बाल्या, शमारियाह व हरूफी शफात्याह,<verse eid="1CH 12:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6" />एलकानाह, इश्शीयाह, अजरएल, योबेजर व याशबआम हे सर्व कोरही वंशज होते.<verse eid="1CH 12:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7" />योएलाह व जबद्याह हे गदोर येथील यरोहामाचे पुत्र होते.<verse eid="1CH 12:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />गादचे महान शूर वीरसुध्दा फितूर होऊन दावीद अरण्यवासात असताना त्याच्याकडे गेले. ते ढाली व भाले वापरण्यात निष्णात होते. त्यांचे चेहरे सिंहाच्या मुखासारखे असून ते डोंगरावरील हरणांसारखे चपळ होते.<verse eid="1CH 12:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9" />एजेर हा त्यांचा प्रमुख सेनाधिकारी होता.</para>
  <para style="li1" vid="1CH 12:9">ओबद्याह त्यांचा उपप्रमुख, एलियाब तिसरा,<verse eid="1CH 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10" />मिश्मन्नाह चौथा, यिर्मयाह पाचवा,<verse eid="1CH 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11" />अत्तय सहावा, एलीएल सातवा,<verse eid="1CH 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12" />योहानान आठवा, एलजाबाद नववा,<verse eid="1CH 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13" />यिर्मयाह दहावा आणि मखबन्नय अकरावा.<verse eid="1CH 12:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14" />हे गाद गोत्राचे असून सैन्यातील अधिकारी होते; त्यातील जो सर्वात कनिष्ठ होता, तो शंभरांच्या तोडीचा होता व सर्वात ज्येष्ठ हजाराच्या तोडीचा. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" />वर्षाच्या पहिल्या महिन्यात यार्देन नदी दुथडी भरून वाहत असताना त्यांनी ती ओलांडली आणि नदीच्या खोर्‍यांत राहणार्‍या लोकांची त्यांनी पूर्वेकडे व पश्चिमेकडे दाणादाण उडविली.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />बिन्यामीन व यहूदाह गोत्रातील दुसरे काहीजण दावीदाकडे गडावर आले. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />दावीद त्यांच्या भेटीसाठी बाहेर आला आणि त्यांना म्हणाला, “तुम्ही मला मदत करावयास शांतीने आला असाल, तर तुम्हाला सहभागी करण्यास मी तयार आहे. पण मी निरपराध असताना मला शत्रूंच्या हवाली करण्यासाठी, माझा विश्वासघात करावयास तुम्ही आला असाल, तर आपल्या पूर्वजांचा परमेश्वर तुम्हाला पाहून घेईल व तुमचा न्याय करेल.”<verse eid="1CH 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18" />तेव्हा त्या तिसांचा पुढारी अमासयवर पवित्र आत्मा आला आणि अमासय म्हणाला:</para>
  <para style="q1" vid="1CH 12:18">“दावीद महाराज, आम्ही तुमचे आहोत!</para>
  <para style="q2" vid="1CH 12:18">अहो इशायपुत्र, आम्ही तुमच्या बाजूचे आहोत!</para>
  <para style="q1" vid="1CH 12:18">तुम्हाला शांती, कल्याण लाभो,</para>
  <para style="q2" vid="1CH 12:18">आणि जे तुम्हाला मदत करतील, त्या सर्वांना यश लाभो.</para>
  <para style="q3" vid="1CH 12:18">कारण तुमचे परमेश्वर तुम्हाला मदत करतील.”</para>
  <para style="p" vid="1CH 12:18">मग दावीदाने त्यांचा स्वीकार केला आणि त्यांना आपल्या गनिमी युद्धाच्या सेनेवर अधिकारी नेमले.<verse eid="1CH 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19" />आणि दावीद पलिष्ट्यांशी शौलाच्या विरुद्ध लढायला गेला तेव्हा मनश्शेह गोत्रातीलही काही लोक दावीदाकडे फितूर झाले. (तरीही दावीद आणि त्याच्या माणसांनी पलिष्ट्यांची मदत केली नाही, कारण सल्लामसलत करून त्यांच्या अधिकार्‍यांनी त्याला पाठवून दिले. ते म्हणाले, “जर आपला धनी शौल याकडे तो फितूर झाला तर आमची शिरे धोक्यात जातील.”) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />दावीद सिकलाग येथे जात असताना मनश्शेह गोत्रातील जे लोक दावीदाला येऊन मिळाले, त्यांची यादी पुढे दिली आहे: अदनाह, योजाबाद, यदिएल, मिखाएल, यहोजाबाद, एलीहू व सिलथाई. ते सर्वजण मनश्शेह गोत्रातील उच्च श्रेणीचे सहस्त्राधिपती होते. <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" />ते शूर योद्धे होते. त्यांनी पलिष्ट्यांच्या गनिमी युद्धाविरुद्ध दावीदाला मदत केली आणि ते त्याच्या सैन्यात सेनाधिकारी होते. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />दररोज लोक दावीदाला येऊन मिळत होते. शेवटी त्याच्याकडे परमेश्वराच्या सेनेसारखी<note caller="+" style="f"><char style="fr" closed="false">12:22 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">बलवान सैन्य</char></note> प्रचंड सेना जमा झाली.<verse eid="1CH 12:22" /></para>
  <para style="s1">हेब्रोन येथे दावीदाला इतरजण येऊन मिळतात</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23" />दावीद हेब्रोन येथे असताना, त्याला अनेक कसलेले योद्धे येऊन मिळाले. याहवेहने वचन दिल्याप्रमाणे दावीदाला शौलाच्या जागी राजा होण्यास मदत करावी या उद्देशाने ते आले होते.<verse eid="1CH 12:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24" />यहूदाह गोत्रातील ढाल व भाला धारण करणारे हत्यारबंद 6,800 योद्धे;<verse eid="1CH 12:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25" />शिमओनी गोत्रातले शूर व पराक्रमी योद्धे 7,100;<verse eid="1CH 12:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26" />लेव्यातील 4,600, <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />याजकांपैकी अहरोन घराण्याचा पुढारी यहोयादा होता. त्याच्याबरोबर 3,700 लोक होते. <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" />सादोक हा तरुण असून मोठा धैर्यवान लढवय्या होता आणि त्याच्याबरोबर त्याच्या पित्याच्या घराण्यातील 22 सरदार होते;<verse eid="1CH 12:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29" />बिन्यामीनच्या म्हणजे शौलाच्या गोत्रातील 3,000, यातील बहुतेक या वेळेपर्यंत शौलाशा एकनिष्ठ राहिले होते;<verse eid="1CH 12:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30" />एफ्राईमी, हे महान योद्धे आपआपल्या कुळांमध्ये नामांकित असे पुरुष 20,800;<verse eid="1CH 12:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31" />मनश्शेहच्या अर्ध्या गोत्रातले लोक दावीदाला राजा होण्यास मदत करण्यासाठी तातडीने पाठविण्यात आलेल्या सैन्यात होते 18,000;<verse eid="1CH 12:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32" />इस्साखार गोत्रातले 200 पुढारी आले, काळाची पावले ओळखून इस्राएलने काय करावे हे त्यांना समजत होते. त्यांचे सर्व भाऊबंद त्याच्या आज्ञेत होते;<verse eid="1CH 12:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33" />जबुलून गोत्रातले निष्णात लढवय्ये 50,000, ते शस्त्रांनी सुसज्ज व दावीदाला एकनिष्ठ होते;<verse eid="1CH 12:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34" />नफतालीचे 1,000 अधिकारी आणि भाले व ढाली यांनी सुसज्ज असे 37,000 सैनिक;<verse eid="1CH 12:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35" />दान गोत्राचे लढाईसाठी सुसज्ज सैनिक 28,600;<verse eid="1CH 12:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36" />आशेर गोत्राचे अनुभवी, सुसज्ज सैनिक 40,000;<verse eid="1CH 12:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37" />यार्देन नदीच्या पूर्वेकडील काठावर राहणारे रऊबेनी, गाद व मनश्शेहच्या अर्ध्या गोत्रातील सर्व शस्त्रांनिशी सज्ज सैनिक 1,20,000.<verse eid="1CH 12:37" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38" />हे सर्व योद्धे, जे सेनेत त्यांच्या हुद्यानुसार सहभागी होण्यास स्वेच्छेने आले.</para>
  <para style="b" vid="1CH 12:38" />
  <para style="p" vid="1CH 12:38">ते हेब्रोनला आले तेव्हा दावीदाला इस्राएलचा राजा करणे हा त्यांचा एकच उद्देश होता. वास्तविक पाहता सर्व इस्राएलींनी या गोष्टीस मान्यता दिली होती. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />त्यांनी तिथे तीन दिवस दावीदाबरोबर घालवून, खाणेपिणे केले, कारण त्यांच्या कुटुंबाने त्यांचा तसा प्रबंध केला होता. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />शेजारच्या लोकांनी म्हणजे इस्साखार, जबुलून व नफताली प्रांतांपर्यंत जे राहत होते, त्यांनी भाकरीचे पीठ, अंजिरांच्या ढेपा, खिसमिसांचे घड, द्राक्षारस, तेल इत्यादी खाण्याच्या वस्तू गाढवे, उंट खेचरे व बैल यांच्यावर लादून आणल्या होत्या. त्याचप्रमाणे असंख्य बैल व शेरडेमेंढरे पण आणली होती. कारण इस्राएलात सर्वत्र आनंदोत्सव साजरा होत होता.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">कोश परत आणणे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />दावीदाने आपल्या सेनाधिकार्‍यांचा, म्हणजे प्रत्येक सहस्राधिपती, शताधिपतीचा सल्ला घेतला. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" />जमलेल्या संपूर्ण इस्राएली सभेपुढे दावीदाने असे भाषण केले, “जर तुम्हाला योग्य वाटते आणि आपल्या याहवेह परमेश्वरानेही या गोष्टीला संमती दिली आहे, त्याअर्थी आपल्यात सामील होण्यासाठी, आपण इस्राएलातील सर्व बंधूना, तसेच याजक, लेवी, जे त्यांच्यासह नगरात व मळ्यात आहेत त्यांना आमंत्रणाचा संदेश पाठवू या. <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" />त्याचप्रमाणे आपण आपल्या परमेश्वराचा कोश परत आणू या. कारण शौल राजाच्या कारकिर्दीत आपण त्याकडे पूर्ण दुर्लक्ष केले होते<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">त्याची विचारपूस केली नाही</char></note>.” <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" />तेव्हा संपूर्ण सभेने एकमताने होकार दिला व सर्व लोकांना ते योग्य वाटले.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />मग दावीदाने परमेश्वराचा कोश किर्याथ-यआरीमहून आणण्याच्या वेळी इजिप्तच्या शिहोर नदीपासून ते लबो हमाथपर्यंत सर्वत्र विखुरलेल्या इस्राएली लोकांना एकत्र केले. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" />दावीद व इस्राएलचे सर्व लोक यहूदीयातील बालाह म्हणजे किर्याथ-यआरीम येथे, जो त्या नावाने संबोधित केला जातो, सर्वसमर्थ याहवेह परमेश्वराचा कोश, जे करुबांमध्ये आरूढ आहेत, तो आणण्यासाठी निघाले.<verse eid="1CH 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7" />त्यांनी परमेश्वराचा कोश अबीनादाबाच्या घरातून काढून एका नव्या गाडीवर ठेवला. उज्जा आणि अहियो हे बैलगाडी चालवित होते. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" />दावीद आणि इस्राएलचे सर्व लोक त्यांच्या सर्व शक्तीने परमेश्वरासमोर वीणा, सारंगी, डफ, डमरू, झांजा व कर्णे वाजवित आनंद करीत होते.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />जेव्हा ते कीदोनाच्या खळ्याजवळ आले, तेव्हा बैल अडखळले म्हणून कोश धरण्यासाठी उज्जाहने आपला हात पुढे केला. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" />त्यामुळे याहवेहचा कोप उज्जाहविरुद्ध पेटला आणि त्याने कोशाला हात लावला म्हणून त्यांनी त्याला मारून टाकले. आणि तो परमेश्वरापुढे मरण पावला.<verse eid="1CH 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11" />तेव्हा दावीदाला राग आला कारण याहवेहचा क्रोध उज्जाहवर भडकला होता आणि आजपर्यंत त्या ठिकाणाला पेरेस-उज्जाह<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">उज्जाविरुद्ध तडाखा</char></note> असे म्हणतात.<verse eid="1CH 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12" />त्या दिवशी दावीदाला परमेश्वराचे भय वाटले, तो म्हणाला, “परमेश्वराचा कोश मी आपल्याकडे कसा नेऊ?” <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />त्याने कोश त्याच्याबरोबर दावीदाच्या नगरात नेला नाही. त्याऐवजी त्याने तो गित्ती ओबेद-एदोम याच्या घरी नेला. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />परमेश्वराचा कोश ओबेद-एदोम याच्या घरात तीन महिने राहिला आणि याहवेहने त्याच्या घराण्यास व त्याचे जे काही होते त्या सर्वास आशीर्वाद दिला.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">दावीदाचे घर व कुटुंब</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />आता सोरचा राजा हीरामाने दावीदाकडे दूत पाठविले व दावीदासाठी राजवाडा बांधावा म्हणून त्यांच्याबरोबर देवदारू लाकडे, गवंडी व सुतार पाठवले. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />आणि दावीदाने जाणले की याहवेहने आपल्याला इस्राएलवर राजा म्हणून स्थापित केले आहे आणि आपल्या इस्राएली लोकांसाठी त्याचे राज्य खूप उंचावले आहे.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />यरुशलेमात दावीदाने अनेक पत्नी व उपपत्नी केल्या आणि त्याला आणखी पुत्र आणि कन्या झाल्या. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" />यरुशलेममध्ये जन्मलेल्या त्याच्या मुलांची नावे ही: शम्मुआ, शोबाब, नाथान, शलोमोन, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />इभार, एलीशुआ, एल्पलेट, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />नोगा, नेफेग, याफीय, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />एलीशामा, बिलिआदा<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">एलयादा</char></note> व एलिफेलेत.<verse eid="1CH 14:7" /></para>
  <para style="s1">दावीद पलिष्ट्यांचा पराभव करतो</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />इस्राएलवर राजा म्हणून दावीदाचा अभिषेक झाला आहे असे पलिष्ट्यांनी जेव्हा ऐकले, तेव्हा ते त्याला शोधण्यासाठी आपले सर्व सैन्य घेऊन निघाले, परंतु दावीदाने याबद्दल ऐकले तेव्हा तो त्यांना भेटण्यास गेला. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />इकडे पलिष्टी लोकांनी येऊन रेफाईमच्या खोर्‍याला लुटले. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />तेव्हा दावीदाने परमेश्वराला विचारले, “मी जाऊन पलिष्ट्यांवर हल्ला करू काय? आपण त्यांना माझ्या हाती देणार काय?”</para>
  <para style="p" vid="1CH 14:10">याहवेहने त्याला उत्तर दिले, “जा, मी त्यांना तुझ्या हातात देईन.”<verse eid="1CH 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11" />म्हणून दावीद व त्याचे सैन्य बआल-पेरासीम येथे गेले आणि तिथे त्याने त्यांचा पराभव केला. दावीद म्हणाला, “पाण्याच्या लोंढ्याप्रमाणे परमेश्वराने माझ्याद्वारे शत्रूंचा नाश केला आहे.” म्हणून त्या ठिकाणाला बआल-पेरासीम<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">परमेश्वर जे तुटून पडतात</char></note>, हे नाव पडले. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />पलिष्टी लोकांनी त्यांची दैवते टाकून दिली व दावीदाने ती अग्नीत जाळून टाकण्याची आज्ञा केली.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />पुन्हा एकदा पलिष्टी लोकांनी खोर्‍यात हल्ला केला. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />तेव्हा दावीदाने पुन्हा परमेश्वराला विचारले, आणि परमेश्वराने त्याला उत्तर दिले, “थेट त्यांच्यामागे जाऊ नकोस, पण त्यांच्या बाजूने वळसा देऊन, तुतीच्या झाडांसमोरून त्यांच्यावर हल्ला कर. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />तुतीच्या झाडांच्या शेंड्यांमधून सैन्य चालत येण्याचा आवाज येताच, युद्धास पुढे निघा, त्यावरून पलिष्टी सैन्याचा नाश करण्यासाठी परमेश्वर तुमच्यापुढे गेले आहेत असे समज.” <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />तेव्हा दावीदाने परमेश्वराच्या आज्ञेप्रमाणे केले आणि गिबोनापासून गेजेरपर्यंत त्यांनी पलिष्टी सैन्याला ठार केले.<verse eid="1CH 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17" />दावीदाची किर्ती संपूर्ण प्रदेशात पसरत गेली. सर्व राष्ट्रांना त्याचे भय वाटावे असे याहवेहने केले.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">कोश यरुशलेमात आणतात</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />आता दावीदाने स्वतःसाठी दावीद नगर यरुशलेममध्ये भवने बांधली व त्याने परमेश्वराच्या कोशाकरिता एक स्थान सिद्ध करून तिथे एक नवा तंबू ठोकला. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" />नंतर दावीदाने म्हटले, “लेव्यांशिवाय इतर कोणीही परमेश्वराचे कोश वाहू नये, कारण याहवेहने त्यांना त्यांचे कोश वाहण्यासाठी निवडले आहे, त्यांची सेवा निरंतर करण्यासाठी निवडले आहे.”<verse eid="1CH 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3" />नंतर याहवेहचा कोश नव्या तंबूत आणण्याच्या समारंभासाठी दावीदाने इस्राएलाच्या सर्व लोकांना यरुशलेममध्ये एकत्र केले.<verse eid="1CH 15:3" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4" />दावीदाने अहरोनाच्या वंशजांना आणि लेवींना एकत्र बोलाविले:<verse eid="1CH 15:4" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5" />कोहाथी वंशातील,</para>
  <para style="li2" vid="1CH 15:5">प्रमुख उरीएल व त्याचे 120 भाऊबंद;<verse eid="1CH 15:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6" />मरारीच्या वंशातील,</para>
  <para style="li2" vid="1CH 15:6">प्रमुख असायाह व त्याचे 220 भाऊबंद;<verse eid="1CH 15:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7" />गेर्षोमाच्या वंशातील,</para>
  <para style="li2" vid="1CH 15:7">प्रमुख योएल व त्याचे 130 भाऊबंद;<verse eid="1CH 15:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8" />एलीजाफानच्या वंशातील,</para>
  <para style="li2" vid="1CH 15:8">प्रमुख शमायाह व त्याचे 200 भाऊबंद;<verse eid="1CH 15:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9" />हेब्रोनाच्या वंशातील,</para>
  <para style="li2" vid="1CH 15:9">प्रमुख एलीएल व त्याचे 80 भाऊबंद;<verse eid="1CH 15:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10" />उज्जीएलाच्या वंशातील,</para>
  <para style="li2" vid="1CH 15:10">प्रमुख अम्मीनादाब व त्याचे 112 भाऊबंद.<verse eid="1CH 15:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11" />नंतर दावीदाने सादोक व अबीयाथार या मुख्य याजकांना व उरीएल, असायाह, योएल, शमायाह, एलीएल व अम्मीनादाब या लेवी पुढार्‍यांना बोलाविणे पाठविले. <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" />तो त्यांना म्हणाला, “तुम्ही लेवी वंशातील कुटुंबप्रमुख आहात; आता तुमच्या सर्व बांधवांसमवेत तुम्ही शुद्ध व्हा, कारण इस्राएली लोकांच्या याहवेह परमेश्वराचा कोश मी तयार केलेल्या जागेवरील नव्या तंबूत आणावयाचा आहे. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" />याहवेह आपले परमेश्वर आपल्यावर पूर्वी क्रोधाविष्ट झाले, कारण तुम्ही लेवी लोकांनी तो उचलून आणला नाही. नेमून दिलेल्या विधीनुसार आपण कोश कोणत्या पद्धतीने उचलावयाचा यासंबंधी कधी चौकशी केली नाही.” <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />तेव्हा याजक व लेवी यांनी इस्राएलच्या याहवेह परमेश्वराचा कोश आणण्यासाठी स्वतःला विधिपूर्वक शुद्ध केले. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" />याहवेह परमेश्वराने मोशेला ज्या सूचना दिल्या होत्या त्याबरहुकूम लेव्यांनी कोशाचे खांब खांद्यांवर घेऊन तो वाहिला.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16" />दावीदाने लेवी पुढार्‍यांना गायकवर्ग व वाद्यवृंद तयार ठेवण्यास सांगितले. या वाद्यवृंदानेः सतार, वीणा व झांजा उच्चस्वराने आणि हर्षाने वाजविल्या.<verse eid="1CH 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17" />लेवी लोकांनी योएलचा पुत्र हेमान, बेरेख्याहचा पुत्र आसाफ व मरारी कुटुंबातील कुशायाहचा पुत्र एथान, हे प्रमुख वादक नेमले. <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />पुढे नमूद केलेल्या कुटुंबातील लोक त्यांचे सहायक म्हणून नेमले: जखर्‍याह, बेन, यजिएल, शमिरामोथ, यहीएल, उन्नी, एलियाब, बेनाइयाह, मासेयाह, मत्तिथ्याह, एलीफलेहू, मिकनेयाह. ओबेद-एदोम व ईयेल<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">व अजऱ्याह</char></note> हे द्वारपाल होते.<verse eid="1CH 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19" />संगीतकार हेमान, आसाफ व एथान यांना कास्याच्या झांजा वाजविण्यासाठी नेमले होते. <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />जखर्‍याह, अजीएल, शमिरामोथ यहीएल, उन्नी, एलियाब, मासेयाह व बेनाइयाह यांना अलामोथ या संगीत रागावर सारंगी वाजविण्यास नेमले. <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />मत्तिथ्याह, एलीफलेहू, मिकनेयाह, ओबेद-एदोम, ईयेल, व अजज्याह यांना शमीनीथ सुरावर वीणा वाजविण्यास नेमले होते. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />लेव्यांचा प्रमुख कनन्याह गायनकर्त्यांना ती जबाबदारी देण्यात आली होती. तो गायनकलेत निपुण होता.<verse eid="1CH 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23" />बेरेख्याह व एलकानाह हे कोशाचे द्वारपाल होते. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" />शबन्याह, योशाफाट, नथानेल, अमासय, जखर्‍याह, बेनाइयाह व एलिएजर हे सर्व याजक परमेश्वराच्या कोशापुढे कर्णे वाजवित व मिरवणुकीच्या वेळी अग्रभागी चालत. ओबेद-एदोम व यहीयाह हे कोशाचे द्वारपाल होते.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />म्हणून दावीद, इस्राएलचे वडीलजन, सैन्याचे उच्चाधिकारी याहवेहच्या कराराचा कोश यरुशलेममध्ये आणण्यासाठी मोठ्या हर्षाने ओबेद-एदोमच्या घरी गेले. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />याहवेह परमेश्वराच्या कराराचा कोश वाहून नेणार्‍या लेव्यांची याहवेहने मदत केली म्हणून सात बैल आणि सात गोर्‍हे अर्पण केले गेले. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />दावीद, कोश वाहणारे सर्व लेवी, सर्व गायक व गायकांचा मुख्य संगीतकार कनन्याह होता, या सर्वांनी तलम तागाची वस्त्रे परिधान केली होती. दावीदाने तागाचे एफोद घातले होते. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />अशाप्रकारे इस्राएलाच्या सर्व लोकांनी हर्षाने जयघोष करीत, रणशिंगे, कर्णे, झांजा, सतार व वीणा यांच्या मोठ्या निनादात याहवेहचा कराराचा कोश आणला.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />याहवेहच्या कराराचा कोश दावीदाच्या नगरात प्रवेश करीत असताना, शौलाची मुलगी मीखल हिने खिडकीतून पाहिले. आणि जेव्हा तिने दावीद राजाला याहवेहसमोर नाचत आणि हर्ष करीत असता पाहिले, तेव्हा तिने तिच्या अंतःकरणात त्याचा तिरस्कार केला.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">कोशापुढे आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />त्यांनी देवाचा कोश आणला आणि दावीदाने त्यासाठी जो तंबू तयार केला होता त्या ठिकाणी तो ठेवला आणि परमेश्वरासमोर होमार्पणे व शांत्यर्पणे सादर केली. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />होमार्पणे व शांत्यर्पणे सादर केल्यानंतर दावीदाने लोकांना याहवेहच्या नावाने आशीर्वाद दिला. <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />नंतर त्याने इस्राएल लोकांच्या प्रत्येक स्त्री व पुरुषास एक भाकर, खजुराची एक ढेप व मनुक्यांची एक वडी वाटप केली.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4" />इस्राएलच्या याहवेह परमेश्वराचे गौरव, स्तुतिगान व त्यांचे उपकारस्मरण करण्याकरिता दावीदाने कोशापुढे सेवा करणार्‍या काही लेवी लोकांची नेमणूक केली: <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" />वादकांचा प्रमुख आसाफ, पुढच्या श्रेणीत जखर्‍याह, येइएल, शमिरामोथ, यहीएल, मत्तिथ्याह, एलियाब, बेनाइयाह, ओबेद-एदोम व ईयेल हे सतार व वीणा वाजवित, व आसाफ उंच स्वरात झांज वाजवित असे. <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />बेनाइयाह व यहजिएल हे याजक परमेश्वराच्या कराराच्या कोशापुढे नियमितपणे कर्णे वाजवित.<verse eid="1CH 16:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />त्या दिवसापासून दावीदाने याहवेहची अशा प्रकारे उपकारस्तुती करण्यासाठी आसाफ व त्याचे सहायक नेमले:<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />याहवेहचे स्तवन करा, त्यांच्या नावाची घोषणा करा;</para>
  <para style="q2" vid="1CH 16:8">त्यांनी केलेली अद्भुत कृत्ये सर्व राष्ट्रात जाहीर करा.<verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />त्यांची स्तुतिस्तोत्रे गा आणि त्यांचे स्तवन करा;</para>
  <para style="q2" vid="1CH 16:9">त्यांच्या सर्व अद्भुत कार्याचे वर्णन करा.<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />त्यांच्या पवित्र नावाचा अभिमान बाळगा;</para>
  <para style="q2" vid="1CH 16:10">जे याहवेहचा शोध करतात, त्यांचे हृदय हर्षित होवो.<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />याहवेह व त्यांच्या सामर्थ्याकडे पाहा;</para>
  <para style="q2" vid="1CH 16:11">सतत त्यांचे मुख शोधा.<verse eid="1CH 16:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />परमेश्वराने केलेली अद्भुत कार्ये, त्यांचे चमत्कार,</para>
  <para style="q2" vid="1CH 16:12">आणि त्यांनी केलेले न्याय</para>
  <para style="q2" vid="1CH 16:12">यांचे स्मरण करा.<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />अहो त्यांचे सेवक, इस्राएलच्या वंशजांनो,</para>
  <para style="q2" vid="1CH 16:13">त्यांच्या निवडलेल्या लोकांनो, याकोबाच्या संतानांनो,</para>
  <para style="q2" vid="1CH 16:13">तुम्ही या सर्वांचे स्मरण करा.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />कारण याहवेह आमचे परमेश्वर आहेत.</para>
  <para style="q2" vid="1CH 16:14">त्यांचे न्याय सर्व पृथ्वीवर आहेत.<verse eid="1CH 16:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />ते आपला करार सर्वदा स्मरणात ठेवतात,</para>
  <para style="q2" vid="1CH 16:15">ती अभिवचने त्यांनी हजारो पिढ्यांना दिली होती,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />हा करार त्यांनी अब्राहामाशी केला,</para>
  <para style="q2" vid="1CH 16:16">आणि इसहाकाशी शपथ वाहिली,<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />आणि त्यांनी याकोबासाठी नियम</para>
  <para style="q2" vid="1CH 16:17">व इस्राएलसाठी सदासर्वकाळचा करार या रूपाने कायम केला:<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />“मी तुम्हाला कनान देश</para>
  <para style="q2" vid="1CH 16:18">तुमचे वतन म्हणून देईन.”<verse eid="1CH 16:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />त्यावेळी इस्राएली लोक अगदी मोजके होते</para>
  <para style="q2" vid="1CH 16:19">निश्चितच थोडे, वचनदत्त देशात ते परके होते.<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />ते एका देशातून दुसर्‍या देशात,</para>
  <para style="q2" vid="1CH 16:20">एका राज्यातून दुसर्‍या राज्यात भटकत असताना,<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />याहवेहने कोणालाही त्यांच्यावर जुलूम करू दिला नाही;</para>
  <para style="q2" vid="1CH 16:21">त्यांच्याकरिता त्यांनी राजांना दटाविले:<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />“माझ्या अभिषिक्तांना स्पर्श करू नका;</para>
  <para style="q2" vid="1CH 16:22">माझ्या संदेष्ट्यांना इजा करू नका.”<verse eid="1CH 16:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />हे सर्व पृथ्वी, याहवेहस्तव स्तुतिस्तोत्रे गा,</para>
  <para style="q2" vid="1CH 16:23">दररोज त्यांच्या तारणाची घोषणा करा.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />सर्व राष्ट्रांमध्ये त्यांचे गौरव,</para>
  <para style="q2" vid="1CH 16:24">सर्व लोकांमध्ये त्यांची अद्भुत कृत्ये जाहीर करा.<verse eid="1CH 16:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />कारण याहवेह थोर आणि स्तुतीस पात्र आहेत;</para>
  <para style="q2" vid="1CH 16:25">सर्व दैवतांपेक्षा त्यांचे भय बाळगणे यथायोग्य आहे.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />इतर देशांची दैवते केवळ मूर्ती आहेत.</para>
  <para style="q2" vid="1CH 16:26">परंतु याहवेहनी आकाशमंडलांची रचना केली आहे.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />राजवैभव आणि ऐश्वर्य त्यांच्या पुढे चालतात.</para>
  <para style="q2" vid="1CH 16:27">त्यांच्या उपस्थितीत सामर्थ्य आणि हर्ष असतो.<verse eid="1CH 16:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />अहो राष्ट्रातील सर्व कुळांनो याहवेहला गौरव द्या,</para>
  <para style="q2" vid="1CH 16:28">याहवेहला गौरव आणि सामर्थ्य द्या.<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />याहवेहच्या नावाला योग्य तो गौरव द्या;</para>
  <para style="q2" vid="1CH 16:29">अर्पणे आणून त्यांच्या समक्षतेत या.</para>
  <para style="q1" vid="1CH 16:29">त्यांच्या पवित्रतेच्या ऐश्वर्याने याहवेहची उपासना करा;<verse eid="1CH 16:29" /></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30" />त्यांच्या उपस्थितीत हे पृथ्वी कंपित हो!</para>
  <para style="q2" vid="1CH 16:30">सर्व सृष्टी दृढपणे स्थिर झालेली आहे; ती डळमळत नाही.<verse eid="1CH 16:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />आकाशे हर्ष करोत, पृथ्वी उल्लास करो;</para>
  <para style="q2" vid="1CH 16:31">त्यांनी राष्ट्रांना हे सांगावे, “याहवेह राज्य करतात!”<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />सागर व त्यातील सर्वकाही गर्जना करोत;</para>
  <para style="q2" vid="1CH 16:32">शेते व त्यातील सर्वकाही हर्षित होवो!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />वनातील सर्व झाडे गुणगान करो,</para>
  <para style="q2" vid="1CH 16:33">आनंदाने याहवेहची स्तुती करा,</para>
  <para style="q2" vid="1CH 16:33">कारण ते पृथ्वीचा न्याय करण्यास येत आहेत.<verse eid="1CH 16:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />याहवेहचे उपकारस्मरण करा, कारण ते चांगले आहेत;</para>
  <para style="q2" vid="1CH 16:34">त्यांची प्रीती अनंतकाळची आहे.<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />यांचा धावा करून म्हणा, हे आमच्या परमेश्वरा, आमचे तारण करा;</para>
  <para style="q2" vid="1CH 16:35">परमेश्वरा, आम्हाला या देशातून सोडवून एकत्र करा,</para>
  <para style="q1" vid="1CH 16:35">जेणेकरून आम्ही तुमचे पवित्र नाव धन्यवादित करून,</para>
  <para style="q2" vid="1CH 16:35">तुमच्या स्तवनात गौरव मानावे.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />इस्राएलचे परमेश्वर याहवेहची,</para>
  <para style="q2" vid="1CH 16:36">अनादिकालापासून अनंतकालापर्यंत स्तुती होवो.</para>
  <para style="m" vid="1CH 16:36">मग सर्व लोकांनी म्हटले “आमेन! याहवेहची स्तुती होवो.”<verse eid="1CH 16:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37" />दररोज गरजेप्रमाणे आसाफ आणि त्याचे भाऊबंद यांची याहवेहच्या कोशाची नियमितपणे करारबद्ध सेवा करण्यासाठी दावीदाने नेमणूक केली. <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" />तसेच ओबेद-एदोम आणि त्याचे अडुसष्ट नातलग आणि यदूथूनाचा पुत्र ओबेद-एदोम आणि होसाह यांचा द्वारपाल म्हणून समावेश केला.<verse eid="1CH 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39" />दावीदाने गिबोन टेकडीवरील याहवेहच्या सभामंडपात सादोक याजक आणि त्याचे याजक भाऊबंद सेवा करण्यासाठी ठेवले. <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" />ते दररोज, सकाळ व संध्याकाळ, याहवेहने इस्राएली लोकांना दिलेल्या आज्ञेनुसार होमवेदीवर नियमितपणे होमार्पणे करीत होते. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" />त्यांच्यासोबत हेमान, यदूथून आणि नावे घेऊन निवडलेल्या इतर अनेकांची नेमणूक केली. या सर्वांना “याहवेहची प्रीती सनातन आहे” अशी त्यांची उपकारस्तुती करण्यासाठी नेमण्यात आले होते. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" />त्यांच्याबरोबर हेमान आणि यदूथून यांना कर्णे, झांजा व इतर वाद्ये वाजवून परमेश्वराची स्तुती करण्याची जबाबदारी दिली. यदूथूनच्या पुत्रांची द्वारपाल म्हणून नेमणूक करण्यात आली.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />नंतर सर्व लोक आपापल्या नगरास परत गेले आणि दावीदही आपल्या कुटुंबीयांना आशीर्वाद देण्यासाठी घरी परतला.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">याहवेहने दावीदाला अभिवचन दिले</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />जेव्हा दावीद आपल्या राजवाड्यात राहत असताना, त्याने नाथान संदेष्ट्यास म्हटले, “पाहा, येथे मी गंधसरूच्या भवनात राहतो, परंतु याहवेहच्या कराराचा कोश एका तंबूत आहे!”<verse eid="1CH 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2" />नाथानाने दावीदाला उत्तर दिले, “आपल्या मनात जे काही आहे त्यानुसार करा, कारण परमेश्वर आपल्याबरोबर आहेत.”<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />परंतु त्याच रात्री परमेश्वराचे वचन असे नाथानाकडे आले:<verse eid="1CH 17:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4" />“जा आणि माझा सेवक दावीदला सांग, ‘याहवेह असे म्हणतात: मी निवास करावा म्हणून माझ्यासाठी तू घर बांधणार नाहीस. <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />इस्राएली लोकांना इजिप्त देशातून मी बाहेर आणले त्या दिवसापासून आजपर्यंत मी घरात राहिलो नाही, तंबू एका ठिकाणापासून दुसऱ्या ठिकाणात, या निवासस्थानातून त्या निवासस्थानात फिरत राहिलो आहे. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />जिथे कुठे मी इस्राएली लोकांबरोबर फिरत आलो, तेव्हा त्यांच्यातील ज्यांना मी माझ्या लोकांची मेंढपाळाप्रमाणे काळजी घेण्यास आज्ञा दिली त्यातील कोणत्याही पुढार्‍यांना, “तुम्ही माझ्यासाठी गंधसरूचे भवन का बांधले नाही असे कधी मी म्हटले काय?” ’<verse eid="1CH 17:6" /></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7" />“तर आता माझा सेवक दावीद याला सांग, ‘सर्वसमर्थ याहवेह असे म्हणतात: मी तुला कुरणातून, कळप राखीत असताना आणले आणि माझ्या इस्राएली लोकांवर अधिपती म्हणून नेमले. <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />जिथे कुठे तू गेलास तिथे मी तुझ्याबरोबर राहिलो आणि तुझ्या सर्व शत्रूंना तुझ्यापुढून छेदून टाकले. आता मी, पृथ्वीवरील सर्वश्रेष्ठ पुरुषांच्या नावांप्रमाणे तुझे नाव करेन. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />आणि मी माझ्या इस्राएली लोकांसाठी एक ठिकाण नेमून देईन आणि त्यांना त्या ठिकाणी स्थापित करेन, यासाठी की त्यांना आपले स्वतःचे घर असावे आणि त्यांना पुन्हा त्रास होऊ नये. आणि पूर्वीप्रमाणे दुष्ट लोकांनी त्यांचा छळ करू नये. <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />मी माझ्या इस्राएली लोकांवर पुढारी नेमले तेव्हापासून असेच घडले. मी तुझ्या सर्व शत्रूंचा ताबा घेईन.</para>
  <para style="pm" vid="1CH 17:10">“ ‘मी असे जाहीर करतो की याहवेह तुझ्यासाठी एक घर बांधतील: <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />जेव्हा तुझे दिवस भरतील आणि तू आपल्या पूर्वजांना जाऊन मिळशील, तेव्हा मी तुझे संतान, तुझ्या पुत्रांपैकी एक उभा करून त्याला तुझा उत्तराधिकारी बनवीन, मी त्याचे राज्य स्थापित करेन. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />तोच माझ्यासाठी घर बांधेल आणि मी त्याचे राजासन सर्वकाळासाठी स्थापित करेन. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" />मी त्याचा पिता होईन आणि तो माझा पुत्र होईल; ज्याप्रकारे मी तुझ्या पूर्वजापासून काढून घेतले होते तसे मी माझे प्रेम कधीही त्याच्यापासून काढून घेणार नाही. <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />मी त्याला माझ्या मंदिरावर आणि माझ्या राज्यावर नेमीन; त्याचे राजासन सर्वकाळासाठी स्थापित केले जाईल.’ ”<verse eid="1CH 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15" />या संपूर्ण प्रकटीकरणातील प्रत्येक शब्द नाथानाने दावीदाला सांगितला.<verse eid="1CH 17:15" /></para>
  <para style="s1">दावीदाची प्रार्थना</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />तेव्हा दावीद राजा आत जाऊन याहवेहसमोर बसला आणि म्हणाला:</para>
  <para style="pm" vid="1CH 17:16">“हे याहवेह परमेश्वरा, मी कोण आहे आणि माझे कुटुंब काय आहे की, तुम्ही मला येथवर आणावे? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />माझ्या परमेश्वरा, तुमच्या दृष्टीने हे जणू पुरेसे नव्हते, तर तुम्ही माझ्या कुटुंबाच्या भविष्याबद्दलही अभिवचन दिले आहे. याहवेह परमेश्वरा, मी जणूकाही कोणीतरी फार श्रेष्ठ दर्जाचा आहे, अशा नजरेने तुम्ही माझ्याकडे बघितले आहे.<verse eid="1CH 17:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18" />“तुम्ही दावीद या आपल्या सेवकाला मोठा सन्मान दिला आहे, तर मी पुढे काय बोलू? आपल्या सेवकाला तुम्ही ओळखता. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />हे याहवेह, तुम्ही आपल्या सेवकासाठी आणि तुमच्या इच्छेप्रमाणे हे सर्व महान कार्य केले आहे आणि थोर अभिवचन दिले आहे.<verse eid="1CH 17:19" /></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20" />“हे याहवेह, तुमच्यासारखे कोणी परमेश्वर नाही. जे आम्ही आमच्या कानांनी ऐकले आहे त्यानुसार तुमच्याशिवाय कोणीही परमेश्वर नाही. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />आपल्या इस्राएली लोकांसारखे कोण आहे; पृथ्वीवरील असे एक राष्ट्र, ज्यांच्या परमेश्वरांनी बाहेर जाऊन स्वतःसाठी व तुमच्या नावासाठी इजिप्तमधून त्यांना खंडून घेतले, म्हणजे राष्ट्रे व त्यांची दैवते यांच्यामधून सोडविले व त्यांच्यादेखत आपल्या लोकांसाठी महान व अद्भुत कार्य केले? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />तुम्ही आपल्या इस्राएली लोकांना सर्वकाळासाठी तुमचे स्वतःचे खास लोक बनविले आहे आणि हे याहवेह तुम्ही त्यांचे परमेश्वर झाला आहात.<verse eid="1CH 17:22" /></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23" />“तर आता, हे याहवेह, आपला सेवक व त्याच्या घराण्याविषयी जे अभिवचन तुम्ही दिले आहे, ते आपण सर्वकाळासाठी स्थापित करावे. आपण म्हटल्याप्रमाणे ते आपण करावे. <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />यासाठी की ते स्थापित व्हावे आणि तुमचे नाव सर्वकाळ महान होईल. तेव्हा लोक म्हणतील, ‘सर्वसमर्थ याहवेह हे इस्राएलवर राज्य करणारे इस्राएलचे परमेश्वर आहेत!’ आणि आपला सेवक दावीदाचे घराणे तुमच्यासमोर स्थापित व्हावे.<verse eid="1CH 17:24" /></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25" />“हे माझ्या परमेश्वरा, तुम्ही तुमच्या सेवकास प्रकट केले आहे, की तुम्ही त्याच्यासाठी एक घर बांधाल. त्यामुळे आपल्या सेवकाला तुमच्याकडे प्रार्थना करण्याचे धैर्य आले आहे. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />याहवेह, परमेश्वर तुम्हीच आहात! तुम्ही आपल्या सेवकासाठी उत्तम गोष्टींचे अभिवचन दिले आहे. <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />आता आपल्या सेवकाच्या घराण्याला आशीर्वाद देण्यास तुम्ही प्रसन्न आहात, म्हणजे ते तुमच्या दृष्टीत सदैव राहावे; कारण हे याहवेह, तुम्ही ते आशीर्वादित केले आहे, आणि ते सदैव आशीर्वादित व्हावे.”<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">दावीदाची यशोगाथा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />काही काळानंतर, दावीदाने पलिष्ट्यांचा पराभव केला आणि त्यांच्यावर ताबा घेतला आणि गथ व त्याच्या सभोवतालची गावे पलिष्ट्यांच्या ताब्यातून काढून घेतली.<verse eid="1CH 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2" />दावीदाने मोआबी लोकांचा सुद्धा पराभव केला आणि ते त्याच्या अधीन झाले आणि त्याला कर देऊ लागले.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />याशिवाय दावीद त्याच्या स्मारकाची उभारणी करण्यास फरात नदीकडे गेला असता, त्याने<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">आपली सत्ता स्थापित करावयास</char></note> सोबाहचा राजा हादादेजर याचा हमाथाच्या परिसरात पराभव केला. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />दावीदाने त्याचे एक हजार रथ, सात हजार रथस्वार आणि वीस हजार पायदळ ताब्यात घेतले. परंतु रथाच्या घोड्यांपैकी शंभर घोडे सोडून बाकी घोड्यांच्या नसा कापून टाकल्या.<verse eid="1CH 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5" />जेव्हा दिमिष्कातील अरामी लोक सोबाहचा राजा हादादेजरच्या मदतीला आले तेव्हा दावीदाने त्यांच्यातील बावीस हजार जणांना ठार केले. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />नंतर त्याने दिमिष्कातील अरामी राज्यात ठाणे बसविले आणि अरामी लोक त्याच्या अधीन झाले आणि त्याला कर देऊ लागले. दावीद जिथेही गेला, तिथे याहवेहने त्याला विजय दिला.<verse eid="1CH 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7" />हादादेजरचे अधिकारी वाहत असलेल्या सोन्याच्या ढाली दावीदाने घेतल्या आणि त्या यरुशलेमात आणल्या. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" />हादादेजरच्या मालकीची नगरे तिबहाथ<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">तेबाह</char></note> व कून येथून दावीद राजाने पुष्कळ कास्य आणले. शलोमोनाने हे नंतर वितळविले व मंदिर बांधण्याच्या कामात कास्याची मोठी टाकी, खांब आणि वेदीवरील यज्ञार्पणांसाठी लागणारी उपकरणे बनविण्याच्या उपयोगात आणले.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />हमाथाचा राजा तोऊ याने जेव्हा ऐकले की, दावीदाने सोबाहचा राजा हादादेजरच्या संपूर्ण सैन्याचा पराभव केला आहे, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />तेव्हा त्याने आपला पुत्र हादोरामला दावीदाला आशीर्वाद देऊन अभिनंदन करण्यासाठी दावीद राजाकडे पाठवले, कारण दावीदाने हादादेजरशी युद्ध करून त्याच्यावर विजय मिळविला होता. कारण हादादेजर आणि तोऊ<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">तोई</char></note> यांच्यातही युद्ध होते. हदोरामने त्याच्याबरोबर चांदी, सोने आणि कास्याच्या सर्वप्रकारच्या वस्तू आणल्या.<verse eid="1CH 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11" />दावीद राजाने या वस्तू, या सर्व राष्ट्रांतून लुटून आणलेल्या चांदी सोन्याबरोबर याहवेहला समर्पित केल्या, दावीदाने ताब्यात घेतलेली राष्ट्रे ही: एदोम आणि मोआब, अम्मोनी, पलिष्टी आणि अमालेकी.<verse eid="1CH 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12" />जेरुइयाहचा पुत्र अबीशाईने क्षार खोर्‍यात एदोमाचे अठरा हजार लोक ठार मारले. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />त्याने एदोमात ठाणे बसविले, आणि सर्व एदोमी लोक दावीदाच्या अधीन झाले. दावीद जिथेही गेला तिथे याहवेहने त्याला विजय दिला.<verse eid="1CH 18:13" /></para>
  <para style="s1">दावीदाचे अधिकारी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />दावीदाने संपूर्ण इस्राएलवर राज्य केले व त्याच्या लोकांशी तो न्यायाने व सत्याने वागत असे.<verse eid="1CH 18:14" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15" />जेरुइयाहचा पुत्र योआब सर्व सैन्याचा सेनापती होता;</para>
  <para style="li1" vid="1CH 18:15">आणि अहीलुदचा पुत्र यहोशाफाट नोंदणी करणारा.<verse eid="1CH 18:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16" />अहीतूबचा पुत्र सादोक आणि अबीयाथारचा पुत्र अहीमेलेख<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">इतर मूळ प्रतींनुसार </char><char style="fqa" closed="false">अबीमेलेख</char></note> याजक;</para>
  <para style="li1" vid="1CH 18:16">शावेशा राजाचा चिटणीस होता.<verse eid="1CH 18:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17" />यहोयादाचा पुत्र बेनाइयाह करेथी आणि पेलेथी लोकांवर अधिकारी होता.</para>
  <para style="li1" vid="1CH 18:17">दावीदाचे पुत्र राजाचे मुख्य मंत्री होते.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">दावीद अम्मोन्यांचा पराभव करतो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />कालांतराने, अम्मोन्यांचा राजा नाहाश मरण पावल्यानंतर त्याचा पुत्र राजा झाला. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />दावीदाने विचार केला, “हानूनचा पिता नाहाशने माझ्यावर दया दाखविली होती, तशी दया मी हानूनवर दाखवेन.” म्हणून दावीदाने हानूनच्या पित्याविषयी आपली सहानुभूती व्यक्त करण्यासाठी राजदूत पाठवले.</para>
  <para style="p" vid="1CH 19:2">जेव्हा दावीदाचे राजदूत अम्मोनी लोकांच्या प्रदेशात आले, <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />तेव्हा अम्मोनी अधिकार्‍यांनी हानूनला विचारले, “दावीदाने सहानुभूती व्यक्त करण्यासाठी तुमच्याकडे राजदूत पाठवून तुमच्या पित्याचा आदर केला आहे असे आपणास वाटते काय? दावीदाने त्यांना आपणाकडे केवळ देशाची पहाणी करण्यास, ते हेरण्यास व ते उद्ध्वस्त करण्यास पाठवले नाही काय?” <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />तेव्हा हानूनने दावीदाच्या राजदूतांना ताब्यात घेऊन, प्रत्येकाचे मुंडण केले व त्यांची वस्त्रे मधोमध नितंबापर्यंत फाडून त्यांना परत पाठवून दिले.<verse eid="1CH 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5" />जेव्हा कोणी येऊन दावीदाला त्या माणसांबद्दल सांगितले, तेव्हा दावीदाने त्यांची भेट घेण्यासाठी माणसे पाठवली, कारण त्यांचा मोठा अपमान झाला होता. राजाने म्हटले, “तुमची दाढी वाढेपर्यंत यरीहोतच राहा, मग परत या.”<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />जेव्हा अम्मोनी लोकांना समजून आले की, दावीदाला आपण घृणास्पद झालो आहोत, तेव्हा हानून व अम्मोन्यांनी अराम-नहराईम,<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">म्हणजेच </char><char style="fqa" closed="false">मेसोपोटेमियाचा उत्तरपश्चिम भाग</char></note> अराम-माकाह व सोबाह येथून एक हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">अंदाजे 34 मेट्रिक टन</char></note> चांदी देऊन सैन्य, रथ व घोडदळ ही भाड्याने आणली. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />त्याने भाड्याने बत्तीस हजार रथ व सारथी आणले. तसेच माकाहचा राजा व त्याचे संपूर्ण सैन्य बोलाविले. त्या सैन्याने मेदबा येथे तळ दिला. अम्मोन्यांनी आपल्या नगरातून भरती केलेल्या सैन्यासह तिथे येऊन युद्धासाठी मोर्चा बांधला.<verse eid="1CH 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8" />हे ऐकून, दावीदाने संपूर्ण लढाऊ सैन्यासह योआबाला पाठवले. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />तेव्हा अम्मोन्यांचे सैन्य बाहेर आले आणि युद्धाच्या तयारीने त्यांच्या नगराच्या दरवाजाजवळ येऊन थांबले, युद्ध करण्यासाठी आलेले राजे एकीकडे मोकळ्या प्रदेशात एकटेच होते.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />शत्रूचे सैन्य आपल्यापुढे व मागे आहे हे योआबाला समजले; तेव्हा त्याने इस्राएली सैन्यातून उत्तम योद्धे निवडले व त्यांना अरामी सैन्याशी लढण्यास पाठविले. <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" />बाकीचे सैन्य त्याने आपला भाऊ अबीशाई याच्या हाती दिले आणि त्यांना अम्मोनी लोकांविरुद्ध लढण्यास पाठविले गेले. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />योआब म्हणाला, “जर अरामी सैन्य माझ्यावर भारी झाले तर तुम्ही माझी सुटका करावी; परंतु जर अम्मोनी सैन्य तुझ्यावर भारी झाले तर मी तुला सोडविण्यास येईन. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />खंबीर व्हा, आपल्या लोकांसाठी आणि आपल्या परमेश्वराच्या शहरांसाठी आपण धैर्याने लढू. याहवेहच्या दृष्टीने जे बरे ते याहवेह करतील.”<verse eid="1CH 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14" />तेव्हा योआब आणि त्याच्या बरोबरचे सैन्य अराम्यांशी लढण्यास पुढे गेले आणि ते अरामी त्याच्यापुढून पळून गेले. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />जेव्हा अम्मोनी सैन्याला समजले की, अरामी सैन्याने पळ काढला आहे, तेव्हा त्यांनी सुद्धा त्याचा भाऊ अबीशाई याच्यापुढून पळ काढून ते शहरात गेले. तेव्हा योआब यरुशलेमास परत गेला.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />नंतर अरामी लोकांनी पाहिले इस्राएलकडून त्यांचा पराभव झाला आहे, तेव्हा त्यांनी दूत पाठवून फरात नदीच्या पूर्वेकडून अधिक अरामी सैन्य बोलाविले. हादादेजर राजाचा सेनापती शोफख या सेनेचे नेतृत्व करीत होता.<verse eid="1CH 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17" />याविषयी जेव्हा दावीदाला सांगण्यात आले, तेव्हा त्याने सर्व इस्राएली सैन्य एकत्र केले आणि यार्देन नदी पार करून शत्रुसैन्याशी युद्ध सुरू केले. दावीदाने पुन्हा युद्धसीमेची खूण तयार केली व अराम्यांविरुद्ध युद्ध केले. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />परंतु अरामी सैन्यांनी इस्राएल समोरून पळ काढला आणि दावीदाने त्यांच्यातील सात हजार रथस्वारांना व चाळीस हजार पायदळांना ठार मारले. त्याने त्यांचा सेनापती शोफख यालाही ठार केले.<verse eid="1CH 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19" />जेव्हा हादादेजरच्या जहागीरदारांनी पाहिले की इस्राएलपुढे त्यांचा पराभव झाला, त्यांनी दावीदाशी समेट केला व ते त्याच्या अधीन झाले.</para>
  <para style="p" vid="1CH 19:19">यानंतर अरामी लोक पुन्हा कधीही अम्मोन्यांना त्याच्या युद्धामध्ये मदत करण्यास तयार झाले नाही.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">दावीद राब्बा हस्तगत करतो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />त्याकाळी वसंतॠतूमध्ये, राजे लोक युद्धावर जात असे, योआबाने इस्राएली सैन्याला युद्धासाठी नेले. त्याने अम्मोन्यांची भूमी उद्ध्वस्त केली व राब्बाह शहराला वेढा घातला, परंतु दावीद यरुशलेमात राहिला. योआबने राब्बाहवर हल्ला करून त्याचा नाश केला. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" />दावीद तिथे पोहोचला, तेव्हा त्याने राब्बाहचा राजा मिलकोम<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मोलेख</char></note> च्या डोक्यावरील मुकुट काढला—तो मुकुट सोन्याचा असून त्याचे वजन सोन्याचा एक तालांत<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">अंदाजे 34 कि.ग्रॅ.</char></note> होते व त्यावर मोलवान रत्ने जडविलेली होती; तो दावीदाच्या डोक्यावर ठेवण्यात आला. त्याने त्या शहरातून मोठ्या प्रमाणात लूट घेतली. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />आणि त्या शहरातील रहिवाशांना त्याने बाहेर आणले व त्यांना करवती, लोखंडी कुदळ आणि कुऱ्हाडीच्या साहाय्याने मजुरी करण्यास लावले आणि त्याने त्यांना वीटभट्टीवर काम करावयाला लावले. दावीदाने अम्मोन्यांच्या सर्व नगरांचे असेच केले. नंतर दावीद व त्याचे सर्व सैन्य यरुशलेमास परतले.<verse eid="1CH 20:3" /></para>
  <para style="s1">दावीदाचे पलिष्ट्यांबरोबर युद्ध</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />कालांतराने, पलिष्ट्यांबरोबर गेजेर येथे युद्ध झाले, सिब्बखय नावाच्या हुशाथी मनुष्याने रेफाईमच्या वंशातील सिप्पय नावाच्या एका मनुष्याला ठार मारले, तेव्हा पलिष्टी शरण आले.<verse eid="1CH 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5" />पलिष्ट्यांबरोबर झालेल्या आणखी एका युद्धात याईराचा पुत्र एलहानानने लहमी या गित्ती गल्याथाच्या भावाला ठार मारले, ज्याच्या भाल्याची काठी विणकर्‍याच्या काठीसारखी होती.<verse eid="1CH 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6" />आणखी गथ येथे झालेल्या दुसर्‍या एका युद्धात प्रत्येक हाताला सहा बोटे आणि पायाला सहा बोटे; असे एकंदर चोवीस बोटे असलेला एक धिप्पाड मनुष्य होता. तो सुद्धा राफाहच्या वंशातील होता. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" />जेव्हा त्याने इस्राएलची अवहेलना केली, तेव्हा दावीदाचा भाऊ शिमिआचा पुत्र योनाथानने त्याला ठार केले.<verse eid="1CH 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8" />हे गथ येथील राफाहच्या वंशातील होते आणि ते दावीद व त्याच्या सैनिकांच्या हातून मारले गेले.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">दावीद योद्ध्यांची शिरगणती करतो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />सैतानाने इस्राएलविरुद्ध आपत्ती आणली, त्याने दावीदाला इस्राएली लोकांची शिरगणती करण्यास चिथाविले. <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />म्हणून दावीदाने योआब आणि इतर मुख्य सेनापतींना सांगितले, “जा आणि संपूर्ण इस्राएलींची बेअर-शेबापासून दानापर्यंत शिरगणती करा, म्हणजे ते किती आहेत ते मला कळेल.”<verse eid="1CH 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3" />परंतु योआबाने उत्तर दिले, “याहवेह आपल्या सैन्याची शंभरपटीने वाढ करो. माझ्या धनीराजा, ती सर्व आपलीच प्रजा नाही का? मग गणती करावी अशी इच्छा राजा का बाळगतात? इस्राएलवर आपण दोष का आणावा?”<verse eid="1CH 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4" />तथापि, राजाच्या शब्दापुढे योआब व सेनापतींचे म्हणणे सफल झाले नाही; आणि योआब सर्व इस्राएलभर प्रवास करून यरुशलेमास परतला. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />योआबाने दावीदाला योद्धे पुरुषांच्या संख्येचा अहवाल दिला: यहूदीयामधील चार लक्ष सत्तर हजार मिळून सर्व इस्राएलमध्ये अकरा लाख धनुर्धारी पुरुष होते.<verse eid="1CH 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6" />या गणतीमध्ये त्याने लेवी व बिन्यामीन वंशजांचा समावेश केला नाही, कारण राजाने सांगितलेल्या या कामाचा योआबाला वीट आला होता. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />परमेश्वराच्या दृष्टीमध्ये देखील ही शिरगणती वाईट होती; म्हणून त्यांनी त्याबद्दल इस्राएलला शिक्षा केली.<verse eid="1CH 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8" />तेव्हा दावीद परमेश्वराला म्हणाला, “असे करून मी मोठे पाप केले आहे. आता मी आपणास विनंती करतो, आपल्या सेवकाचा दोष दूर करा. मी मूर्खपण केले आहे.”<verse eid="1CH 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9" />याहवेहने दावीदाचा द्रष्टा गाद याला म्हटले, <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />“जाऊन दावीदाला सांग, ‘याहवेह असे म्हणतात: मी तुझ्यापुढे तीन पर्याय ठेवतो. त्यापैकी तू एकाची निवड कर जो मी तुझ्याविरुद्ध वापरावा.’ ”<verse eid="1CH 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11" />तेव्हा गाद दावीदाकडे गेला व त्याला म्हटले, “याहवेह असे म्हणतात: ‘तू निवड कर: <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />तीन वर्षाचा दुष्काळ, तुझ्या शत्रूपासून तीन महिने पलायन किंवा तीन दिवस याहवेहची तलवार; म्हणजे मरी देशात पसरून याहवेहचा दूत सर्व इस्राएलच्या भागात नाश करेल.’ आता ज्यांनी मला पाठविले आहे त्यांना काय उत्तर द्यावे ते तुम्ही ठरवून मला सांगा.” <verse eid="1CH 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13" />दावीदाने गादला म्हटले, “मी मोठ्या पेचात पडलो आहे. मला याहवेहच्या हाती पडू दे, कारण त्यांची कृपा अतिशय अपार आहे; परंतु मला मनुष्याच्या हातात पडू देऊ नको.”<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />तेव्हा याहवेहने इस्राएल देशात मरी पाठवली आणि तिच्यामुळे सत्तर हजार लोक मरण पावले. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" />आणि परमेश्वराने आपले दूत पाठवून यरुशलेमचा नाश केला. परंतु दूत जे करणार होता तेव्हा ते पाहून याहवेहला अरिष्टाविषयी वाईट वाटले आणि नाश करणार्‍या दूताला याहवेहने म्हटले, “पुरे! आपला हात आवर.” त्यावेळी याहवेहचा दूत यबूसी अरवनाहच्या<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">आर्णोन</char></note> खळ्याजवळ उभा होता.<verse eid="1CH 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16" />दावीदाने वर दृष्टी केली आणि याहवेहच्या दूताला स्वर्गाच्या आणि पृथ्वीच्या मध्ये यरुशलेमकडे तलवार उगारून उभे असलेले पाहिले, तेव्हा दावीद आणि वडीलजनांनी अंगावर गोणपाटाची वस्त्रे घालून दंडवत घातले.<verse eid="1CH 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17" />दावीदाने परमेश्वराला म्हटले, “योद्ध्यांची शिरगणती करण्यासाठी मीच आज्ञा केली होती ना? मी मेंढपाळ असून पाप केले आहे आणि चुकीचे वागलो. ही तर केवळ मेंढरे आहेत. त्यांनी काय केले आहे? हे याहवेह, माझ्या परमेश्वरा, आपला हात माझ्यावर व माझ्या घराण्यावर पडो. परंतु तुमच्या या लोकांवर मरी राहू देऊ नका.”<verse eid="1CH 21:17" /></para>
  <para style="s1">दावीद वेदी बांधतो</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />तेव्हा याहवेहच्या दूताने गादला दावीदाला सूचना देण्यास सांगितले की, जा आणि यबूसी अरवनाहच्या खळ्यात याहवेहप्रीत्यर्थ वेदी बांध. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />मग याहवेहच्या नावाने गादने जे सांगितले होते त्यानुसार दावीद वर गेला.<verse eid="1CH 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20" />आर्णोन गव्हाची मळणी करीत होता, त्याने वळून पाहिले, तर त्याच्या दृष्टीस एक दूत पडला. आर्णोनाचे चार पुत्र सोबत होते, तिथून ते गेले व लपून राहिले. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />जेव्हा दावीद जवळ गेला, आर्णोनाने त्याच्याकडे पाहिले, तेव्हा त्याने खळ्यापासून निघून दावीदासमोर भूमीकडे तोंड करून दंडवत घातले.<verse eid="1CH 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22" />दावीद अरवनाहला म्हणाला, “मला तुझे हे खळे दे, लोकांवर आलेली मरी थांबावी म्हणून याहवेहसाठी मी इथे वेदी बांधेन. मला हे विकत दे, मी तुला त्याची संपूर्ण किंमत देईन.”<verse eid="1CH 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23" />अरवनाह दावीदाला म्हणाला, “माझ्या धनीराजांना मनास येईल ते त्यांनी करावे. पाहा, होमार्पणासाठी मी बैल देईन, लाकडासाठी मळणीची आऊते व धान्यार्पणासाठी गहू, मी हे सर्व तुम्हाला देत आहे.”<verse eid="1CH 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24" />परंतु दावीद राजाने अरवनाहला उत्तर दिले, “नाही, मी त्याबद्दल तुला किंमत मोजून देणार. जे तुझे आहे, ते मी याहवेहसाठी तसेच घेणार नाही. फुकट मिळालेले होमार्पण मी अर्पिणार नाही.”<verse eid="1CH 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25" />मग दावीदाने आर्णोनला जागेबद्दल सोन्याची सहाशे शेकेल<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">अंदाजे 6.9 कि.ग्रॅ.</char></note> दिली. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" />नंतर दावीदाने तिथे याहवेहप्रीत्यर्थ एक वेदी बांधली व होमार्पणे व शांत्यर्पणे अर्पिली. त्याने याहवेहचा धावा केला आणि याहवेहने स्वर्गातून होमार्पणाच्या वेदीवर अग्नी पाठवून त्याला उत्तर दिले.<verse eid="1CH 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27" />मग याहवेहने देवदूताला आज्ञा दिली आणि त्याने आपली तलवार म्यानात परत ठेवली. <verse eid="1CH 21:27" /><verse number="28" style="v" sid="1CH 21:28" />याहवेहने आपल्या प्रार्थनेचे उत्तर दिले, हे पाहून दावीदाने आर्णोन यबूसीच्या खळ्यात अर्पणे वाहिली. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" />मोशेने रानात याहवेहसाठी केलेला सभामंडप आणि होमबलीची वेदी या दोन्ही गिबोनच्या टेकडीवर होती. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />परंतु दावीद परमेश्वराला प्रश्न विचारावयास त्यांच्या पुढे जाण्यास धजेना, कारण याहवेहच्या दूताच्या तलवारीने तो भयभीत झाला होता.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />मग दावीद म्हणाला, “याहवेह परमेश्वराचे मंदिर व इस्राएलसाठी होमबलीची वेदी याच ठिकाणी असली पाहिजे.”<verse eid="1CH 22:1" /></para>
  <para style="s1">मंदिर बांधण्याची पूर्वतयारी</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />दावीदाने इस्राएलमध्ये राहणार्‍या सर्व परकियांना एकत्र करून परमेश्वराच्या मंदिरासाठी चिरे घडविण्याची आज्ञा दिली. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" />प्रवेशद्वारे आणि जोडपट्ट्या यांना लागणारे खिळे तयार करण्यासाठी दावीदाने विपुल प्रमाणात लोखंड, तसेच वजन करता येणार नाही इतका कास्य धातू पुरविला. <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" />त्याने मोजता येणार नाहीत इतके गंधसरूचे ओंडके पुरविले, कारण सीदोन व सोर येथील लोकांनी ते प्रचंड प्रमाणात दावीदाकडे आणले होते.<verse eid="1CH 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5" />दावीदाने विचार केला, “माझा पुत्र शलोमोन तरुण आणि अननुभवी आहे. याहवेहसाठी जे मंदिर बांधावयाचे आहे, ते संपूर्ण जगात अत्यंत भव्य, प्रसिद्ध व वैभवशाली झाले पाहिजे. म्हणून मी ते बांधण्याची पूर्वतयारी करेन.” त्याप्रमाणे आपल्या मृत्यूपूर्वी दावीदाने पुष्कळ तयारी केली.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />नंतर त्याने त्याचा पुत्र शलोमोनला इस्राएलचे परमेश्वर याहवेहसाठी एक भवन बांधण्याची जबाबदारी दिली. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" />दावीद शलोमोनाला म्हणाला, “याहवेह परमेश्वराच्या नावाने मंदिर बांधावयाची माझी मनापासून इच्छा होती, <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" />परंतु माझ्याकडे याहवेहचा हा संदेश आला, ‘तू अनेक युद्ध करून पुष्कळ रक्त वाहिले आहेस. तू माझ्या नावाचे मंदिर बांधू नकोस, कारण तू या पृथ्वीवर माझ्यासमोर पुष्कळ रक्त वाहिले आहे. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" />परंतु तुला एक पुत्र होईल, तो शांतताप्रिय व स्वस्थचित्त मनुष्य असेल. सभोवतालच्या सर्व प्रदेशातील शत्रूपासून मी त्याला विसावा देईन. त्याचे नाव शलोमोन<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">शांती</char></note> असेल. त्याच्या कारकिर्दीत मी इस्राएलला शांती आणि स्वस्थता देईन. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" />तो माझ्या नावाचे एक मंदिर बांधील. तो माझा पुत्र होईल आणि मी त्याचा पिता होईन. मी इस्राएलावर त्याचे राजासन अनंतकालापर्यंत स्थापन करेन.’<verse eid="1CH 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11" />“आता माझ्या मुला, याहवेह तुझ्याबरोबर असो आणि तुला यश प्राप्त होवो आणि तू ते बांधशील असे त्यांनी सांगितल्याप्रमाणे याहवेह तुझ्या परमेश्वराचे भवन बांध. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" />तुझे याहवेह तुला सुबुद्धी आणि चातुर्य देवो आणि जेव्हा ते तुला इस्राएलवर अधिकार देतील, तुला त्यांच्या नियमशास्त्राचे पालन करण्याची बुद्धी देवो, म्हणजे तू याहवेह तुझ्या परमेश्वराच्या नियमशास्त्राचे पालन करशील. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" />याहवेहने इस्राएली लोकांना मोशेद्वारे दिलेल्या नियमांचे तू काळजीपूर्वक पालन करशील, तर तू यशस्वी होशील. बलवान हो, धैर्यवान हो. भयभीत आणि निराश होऊ नको.<verse eid="1CH 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14" />“मी अत्यंत परिश्रम करून याहवेहच्या मंदिरासाठी एक लाख तालांत<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">अंदाजे 3,400 मेट्रिक टन</char></note> सोने, दहा लाख तालांत<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">अंदाजे 34,000 मेट्रिक टन</char></note> चांदी जमा केली आहे. कास्य आणि लोखंड अगणित प्रमाणात आहेत आणि लाकूड आणि दगडही आहेत. आणि तुलाही त्यात भर घालता येईल. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />तुझ्याजवळ पुष्कळ कारागीर आहेत: दगड घडविणारे, गवंडी, सुतार आणि प्रत्येक प्रकारचे कामगार. <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />सोने आणि चांदी, कास्य आणि लोखंड—याचे अगणित कारागीर आहेत. आता काम करण्यास सुरू कर, याहवेह तुझ्याबरोबर असो.”<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />नंतर दावीदाने इस्राएलाच्या सर्व पुढार्‍यांना आपला पुत्र शलोमोनला या कामी मदत करण्याची आज्ञा दिली. <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" />तो त्यांना म्हणाला, “याहवेह तुमचे परमेश्वर तुमच्याबरोबर नाहीत का? त्यांनी सर्व क्षेत्रात तुम्हाला स्वस्थता दिली नाही का? कारण त्यांनी या प्रदेशाच्या लोकांना माझ्या अधीन केले व या भूमीवर याहवेहचा व त्यांच्या लोकांचा अधिकार आहे. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" />आता तुमच्या याहवेह परमेश्वराला शोधण्याकरिता तुम्ही आपले अंतःकरण आणि आपला जीव लावा. आणि याहवेह परमेश्वराचे मंदिर बांधा म्हणजे याहवेहच्या नामाप्रीत्यर्थ जे मंदिर बांधण्यात येणार आहे, त्यात तुम्हाला याहवेहच्या कराराचा कोश आणि परमेश्वराची पवित्र पात्रे आणता येतील.”<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">लेवी</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />जेव्हा दावीद वृद्ध व वयातीत झाला, तेव्हा त्याने आपला पुत्र शलोमोनला इस्राएलचा राजा बनविले.<verse eid="1CH 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />त्याने इस्राएलांच्या सर्व पुढार्‍यांना आणि लेवी व याजकांना एकत्र केले. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" />तीस वर्षे किंवा त्यापेक्षा अधिक वयाच्या लेव्यांची शिरगणती करण्यात आली. त्यांची संख्या अडतीस हजार भरली. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" />दावीद म्हणाला, “यापैकी चोवीस हजार लेव्यांनी याहवेहच्या मंदिराच्या कामावर मुकादम म्हणून देखरेख करावी, सहा हजार लोकांनी न्यायाधीशांची आणि अंमलदारांची कामे करावी. <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" />चार हजार लोकांनी मंदिराच्या द्वारपालांचे काम करावे आणि चार हजार लोकांनी मी पुरवठा केलेली वाद्ये वाजवून याहवेहचे स्तुतिगान करावे.”<verse eid="1CH 23:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6" />नंतर दावीदाने लेवींची विभागणी करून त्यांचे त्यांच्या संततीनुसार भाग पाडले: गेर्षोन, कोहाथ व मरारी.<verse eid="1CH 23:6" /></para>
  <para style="s1">गेर्षोनी</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7" />गेर्षोनीचे विभाग:</para>
  <para style="li2" vid="1CH 23:7">लादान व शिमी.<verse eid="1CH 23:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8" />लादानाचे पुत्र:</para>
  <para style="li2" vid="1CH 23:8">यात यहीएल हा ज्येष्ठ, जेथाम व योएल—सर्व मिळून तीन.<verse eid="1CH 23:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9" />शिमीचे पुत्र:</para>
  <para style="li2" vid="1CH 23:9">शेलोमीथ, हजिएल व हारान; सर्व मिळून तीन.</para>
  <para style="li2" vid="1CH 23:9">(हे लादानाचे कुटुंबप्रमुख.)<verse eid="1CH 23:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10" />शिमीचे पुत्र:</para>
  <para style="li2" vid="1CH 23:10">यहथ, जीजा,<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">झिना</char></note> यऊश आणि बरीयाह.</para>
  <para style="li2" vid="1CH 23:10">हे शिमीचे पुत्र; सर्व मिळून चार.<verse eid="1CH 23:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11" />(यहथ हा ज्येष्ठ होता, जीजाह हा दुसरा होता, परंतु यऊश आणि बरीयाह यांना पुष्कळ पुत्र नव्हते; म्हणून ते एकच कुटुंब म्हणून ओळखले जात.)<verse eid="1CH 23:11" /></para>
  <para style="s1">कोहाथी</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12" />कोहाथाचे पुत्र:</para>
  <para style="li2" vid="1CH 23:12">अम्राम, इसहार, हेब्रोन आणि उज्जीएल; सर्व मिळून चार पुत्र.<verse eid="1CH 23:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13" />अम्रामचे पुत्र:</para>
  <para style="li2" vid="1CH 23:13">अहरोन व मोशे.</para>
  <para style="li2" vid="1CH 23:13">अहरोनाला आणि त्याच्या वंशाला सर्वकाळाकरिता वेगळे करण्यात आले, जेणेकरून त्यांनी याहवेहसाठी अतिपवित्र वस्तू अर्पण करण्यासाठी, त्यांची सेवा करण्यासाठी व त्यांच्या नावाने अनंतकालाकरिता आशीर्वाद द्यावे. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" />परमेश्वराचा मनुष्य मोशे याच्या पुत्रांचाही समावेश लेवीच्या गोत्रात केला होता.<verse eid="1CH 23:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15" />मोशेचे पुत्र:</para>
  <para style="li2" vid="1CH 23:15">गेर्षोम व एलिएजर.<verse eid="1CH 23:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16" />गेर्षोमाचे वंशज:</para>
  <para style="li2" vid="1CH 23:16">शबुएल प्रथमपुत्र होता.<verse eid="1CH 23:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17" />एलिएजरचे वंशज:</para>
  <para style="li2" vid="1CH 23:17">रहब्याह प्रथमपुत्र होता.</para>
  <para style="li2" vid="1CH 23:17">(एलिएजरला दुसरा पुत्र नव्हता, परंतु रहब्याहाला पुष्कळ पुत्र झाले.)<verse eid="1CH 23:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18" />इसहारचे पुत्र:</para>
  <para style="li2" vid="1CH 23:18">शेलोमीथ प्रथमपुत्र होता.<verse eid="1CH 23:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19" />हेब्रोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 23:19">यरीयाह हा प्रथमपुत्र होता, अमर्‍याह दुसरा,</para>
  <para style="li2" vid="1CH 23:19">यहजिएल तिसरा आणि यकमाम चौथा.<verse eid="1CH 23:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20" />उज्जीएलाचे पुत्र:</para>
  <para style="li2" vid="1CH 23:20">मीखाह हा प्रथमपुत्र व इश्शीयाह दुसरा.<verse eid="1CH 23:20" /></para>
  <para style="s1">मरारी</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21" />मरारीचे पुत्र:</para>
  <para style="li2" vid="1CH 23:21">महली व मूशी.</para>
  <para style="li1" vid="1CH 23:21">महलीचे पुत्र:</para>
  <para style="li2" vid="1CH 23:21">एलअज़ार व कीश.<verse eid="1CH 23:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22" />एलअज़ारला पुत्र नव्हता: त्याला फक्त कन्याच होत्या. त्यांचे चुलतभाऊ कीशपुत्र यांनी त्यांच्याशी विवाह केले.<verse eid="1CH 23:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23" />मूशीचे पुत्र:</para>
  <para style="li2" vid="1CH 23:23">महली, एदर व यरेमोथ; सर्व मिळून तीन.<verse eid="1CH 23:23" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24" />लेव्याच्या शिरगणतीमधील सर्व लेवी पुरुष—ज्या कुटुंब प्रमुखांची नावे समाविष्ट केली व त्यांची नावनोंदणी झाली, जे वीस वर्षांचे व त्याहून अधिक वयाचे होते, त्या सर्वांना याहवेहच्या मंदिरात सेवाकार्य दिले गेले. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" />कारण दावीद म्हणाला होता, “इस्राएलाच्या याहवेह परमेश्वराने आम्हाला विश्रांती दिली आहे आणि यरुशलेमात निरंतर निवास करण्यास ते आले आहेत. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" />म्हणून लेव्यांना निवासमंडप व इतर सर्व सेवा साधने एका जागेवरून दुसर्‍या जागी नेण्याची गरज राहणार नाही.” <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />दावीदाच्या शेवटच्या सूचनेनुसार, वीस वर्षे व त्याहून अधिक वयाच्या लेवींची शिरगणती केली गेली.<verse eid="1CH 23:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28" />लेव्यांचा कार्यभाग, अहरोनाच्या वंशजांना याहवेहच्या मंदिराच्या सेवेत याप्रमाणे मदत करावी: अंगणाची देखरेख, इतर खोल्यांची देखरेख, सर्व पवित्र वस्तूंचे शुद्धीकरण आणि परमेश्वराच्या भवनातील इतर कामे करणे. <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" />त्यांना समक्षतेची भाकर टेबलावर ठेवणे, अन्नार्पणांसाठी लागणारे विशिष्ट सपीठ ठेवणे, बेखमीर पापड्या तयार करणे, भाजणे व मिश्रण तयार करणे व सर्व वजन आणि मापाचे प्रमाण बघणे या जबाबदाऱ्या होत्या. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />दररोज सकाळी याहवेहसमोर उभे राहून ते उपकारस्तुतीचे स्तवनगान करीत असत व संध्याकाळीही ते हीच कामे करीत. <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" />शब्बाथ दिवशी, चंद्रदर्शनाच्या दिवशी आणि इतर सणांमध्ये विशेष होमार्पणाच्या कामात ते नित्यनेमाने याहवेहची सेवा त्यांना नेमून दिल्यानुसार करीत होते.<verse eid="1CH 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32" />याप्रमाणे याहवेहच्या मंदिरात लेवी सभामंडपाची आणि पवित्रस्थानाची काळजी घेत आपल्या जबाबदाऱ्या पार पाडीत असत आणि त्यांचे नातलग अहरोनाचे वंशज यांच्या मदतनीसाचे काम करीत असत.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">याजकांचे विभाजन</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />अहरोनाच्या वंशजाची विभागणी:</para>
  <para style="p" vid="1CH 24:1">अहरोनाचे पुत्र नादाब, अबीहू, एलअज़ार व इथामार. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" />नादाब व अबीहू हे अहरोनाचे पुत्र, ते अहरोना आधीच मृत्यू पावले होते. त्यांना पुत्र नव्हते; म्हणून याजकाचे कार्य एलअज़ार व इथामार हे करीत. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" />दावीदाने एलअज़ाराचे वंशज सादोक व इथामाराचा वंशज अहीमेलेख यांच्या मदतीने अहरोनाच्या वंशजांची विभागणी केली व त्यांची क्रमानुसार सेवेसाठी नेमणूक केली. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />एलअज़ाराच्या वंशात इथामाराच्या वंशापेक्षा अधिक पुढारी होते आणि त्यांची त्यानुसार विभागणी करण्यात आली: एलअज़ाराच्या वंशातून सोळा कुटुंबप्रमुख आणि इथामाराच्या वंशातून आठ कुटुंबप्रमुख असे विभागण्यात आले. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />कोणताही भेदभाव न करता चिठ्ठ्या टाकून विभागण्यात आले, कारण ते एलअज़ार व इथामार या दोन्ही वंशातून घेतलेले मंदिराचे अधिकारी व परमेश्वराचे निवडलेले अधिकारी होते.<verse eid="1CH 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6" />लेवी वंशातील नथानेलाचा पुत्र लेखनिक शमायाहने राजाच्या व शासक—याजक सादोक, अबीयाथारचा पुत्र अहीमेलेख व याजक आणि लेवीच्या कुटुंबप्रमुखांसमोर—नावनोंदणी केली. एलअज़ारच्या वंशातील एक कुटुंब व इथामारच्या वंशातील एक कुटुंब घेण्यात आले.<verse eid="1CH 24:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7" />प्रथम चिठ्ठी यहोयारीबच्या नावे आली,</para>
  <para style="li1" vid="1CH 24:7">दुसरी यदायाह,<verse eid="1CH 24:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8" />तिसरी हारीम,</para>
  <para style="li1" vid="1CH 24:8">चवथी सोरीम,<verse eid="1CH 24:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9" />पाचवी मल्कीयाह,</para>
  <para style="li1" vid="1CH 24:9">सहावी मियामीन,<verse eid="1CH 24:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10" />सातवी हक्कोस,</para>
  <para style="li1" vid="1CH 24:10">आठवी अबीयाह,<verse eid="1CH 24:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11" />नववी येशूआ,</para>
  <para style="li1" vid="1CH 24:11">दहावी शखन्याह,<verse eid="1CH 24:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12" />अकरावी एल्याशीब,</para>
  <para style="li1" vid="1CH 24:12">बारावी याकीम,<verse eid="1CH 24:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13" />तेरावी हुप्पाह,</para>
  <para style="li1" vid="1CH 24:13">चौदावी येशेबियाब,<verse eid="1CH 24:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14" />पंधरावी बिल्गाह,</para>
  <para style="li1" vid="1CH 24:14">सोळावी इम्मेरा,<verse eid="1CH 24:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15" />सतरावी हेजीरा,</para>
  <para style="li1" vid="1CH 24:15">अठरावी हप्पिसेसा,<verse eid="1CH 24:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16" />एकोणविसावी पथह्याह,</para>
  <para style="li1" vid="1CH 24:16">विसावी यहेज्केल,<verse eid="1CH 24:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17" />एकविसावी याखीन,</para>
  <para style="li1" vid="1CH 24:17">बाविसावी गामूल,<verse eid="1CH 24:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18" />तेविसावी दलायाह,</para>
  <para style="li1" vid="1CH 24:18">चोविसावी माझियाह.<verse eid="1CH 24:18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19" />त्या सर्वांचा पूर्वज अहरोनला याहवेह इस्राएलाच्या परमेश्वराने नेमून दिलेली सेवा विधीनुसार पार पाडण्याची जशी आज्ञा होती, त्याप्रमाणे ते परमेश्वराच्या मंदिरात प्रवेश करीत.<verse eid="1CH 24:19" /></para>
  <para style="s1">बाकीचे लेवी</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20" />लेवी वंशातील बाकीची संतती पुढीलप्रमाणे होती:</para>
  <para style="b" vid="1CH 24:20" />
  <para style="li1" vid="1CH 24:20">अम्रामाचे पुत्र: शूबाएल;</para>
  <para style="li2" vid="1CH 24:20">शूबाएलाचे पुत्र: यहदायाह.<verse eid="1CH 24:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21" />रहब्याहचे पुत्र: इश्शीयाह प्रथमपुत्र.<verse eid="1CH 24:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22" />इसहारचे पुत्र: शलोमोथ;</para>
  <para style="li2" vid="1CH 24:22">शलोमोथाचे पुत्र: यहथ.<verse eid="1CH 24:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23" />हेब्रोनाचे पुत्र:</para>
  <para style="li2" vid="1CH 24:23">यरीयाह प्रथमपुत्र, अमर्‍याह दुसरा, यहजिएल तिसरा व यकमाम चौथा.<verse eid="1CH 24:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24" />उज्जीएलाचे पुत्र: मीखा;</para>
  <para style="li2" vid="1CH 24:24">मीखाहच्या पुत्रांपैकी: शामीर.<verse eid="1CH 24:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25" />मीखाहचा भाऊ: इश्शीयाह;</para>
  <para style="li2" vid="1CH 24:25">इश्शीयाचे पुत्र: जखर्‍याह.<verse eid="1CH 24:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26" />मरारीचे पुत्र: महली व मूशी.</para>
  <para style="li2" vid="1CH 24:26">याजीयाहचा पुत्र: बनो.<verse eid="1CH 24:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27" />मरारीचे पुत्र:</para>
  <para style="li2" vid="1CH 24:27">याजीयाहकडून: बनो, शोहम, जक्कूर व इब्री.<verse eid="1CH 24:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28" />महलीकडून: एलअज़ार, त्याला पुत्र नव्हता.<verse eid="1CH 24:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29" />कीशाकडून: कीशाचा पुत्र: यरहमेल.<verse eid="1CH 24:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30" />मूशीचे पुत्र: महली, एदर व यरिमोथ.</para>
  <para style="b" vid="1CH 24:30" />
  <para style="lf" vid="1CH 24:30">हे लेव्यांचे वंशज आपआपल्या कुटुंबाप्रमाणे होते.<verse eid="1CH 24:30" /></para>
  <para style="b" />
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31" />अहरोनाच्या संततीप्रमाणे दावीद राजा, सादोक, अहीमेलेख आणि याजकांचे व लेव्यांचे पुढारी या सर्वांसमक्ष चिठ्ठ्या टाकून कामे वाटून देण्यात आली. सर्वात ज्येष्ठाच्या कुटुंबास व सर्वात कनिष्ठाच्या कुटुंबास सारखीच वागणूक देण्यात आली.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">मंदिराचे संगीतकार</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />दावीद व निवासमंडपाचे अधिकारी यांनी आसाफ, हेमान व यदूथूनच्या काही पुत्रांना सतारी, वीणा व झांजा वाजवून संदेशाची सेवा करण्यासाठी वेगळे केले. त्यांच्या सेवेनुसार त्यांची यादी अशी आहे:<verse eid="1CH 25:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2" />आसाफच्या पुत्रा मधून:</para>
  <para style="li2" vid="1CH 25:2">जक्कूर, योसेफ, नथन्याह आणि अशारेलाह. राजाच्या देखरेखीत आसाफ संदेश देत असे, त्याच्या देखरेखीत त्याचे पुत्र कार्य करीत.<verse eid="1CH 25:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3" />यदूथून व त्याचे पुत्र:</para>
  <para style="li2" vid="1CH 25:3">गदल्याह, सरी, यशायाह, शिमी, हशब्याह आणि मत्तिथ्याह, सर्व मिळून सहाजण, संदेश देणारे त्यांचे पिता यदूथूनच्या नेतृत्वाखाली वीणा वाजवून याहवेहचे उपकारस्मरण व स्तवन करीत असत.<verse eid="1CH 25:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4" />हेमान व त्याचे पुत्र:</para>
  <para style="li2" vid="1CH 25:4">बुक्कीयाह, मत्तन्याह, उज्जीएल, शबुएल आणि यरिमोथ; हनन्याह, हनानी, अलियाथाह, गिद्दल्ती, रोमामती-एजेर; योश्बेकाशाह, मल्लोथी, होथीर आणि महजिओथ हे होते. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" />(हे सर्व राजाचा संदेष्टा हेमानचे पुत्र होते. परमेश्वराने दिलेल्या अभिवचनानुसार त्याला हा कर्णा देण्यात आला होता. परमेश्वराने हेमानाला चौदा पुत्र आणि तीन कन्या दिल्या.)<verse eid="1CH 25:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6" />हे सर्वजण याहवेहच्या मंदिरात आपल्या पित्याच्या नेतृत्वाखाली झांजा, सतारी व वीणा वाजवून परमेश्वराच्या भवनात सेवा करीत असत.</para>
  <para style="p" vid="1CH 25:6">आसाफ, यदूथून व हेमान राजाच्या नेतृत्वाखाली कार्य करीत. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />ते आणि त्यांच्या घराण्यातील सर्वजण म्हणजे एकंदर 288 गायनकला शिकून याहवेहसाठी संगीत देण्यात कुशल झाले होते. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" />तरुण वा वयस्कर, तसेच शिक्षक वा शिष्य या सर्व गायकांची चिठ्ठ्या टाकून नेमणूक केली जाई.<verse eid="1CH 25:8" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9" />पहिली चिठ्ठी निघाली आसाफ, योसेफ, त्याचे पुत्र आणि नातेवाईक 12<note caller="+" style="f"><char style="fr" closed="false">25:9 </char><char style="ft" closed="false"><char style="xt" link-href="1CH 25:7"><ref loc="1CH 25:7">वचन 7</ref></char> मध्ये एकूण संख्या पहा; हिब्रूमध्ये संख्या 12 नाहीत.</char></note>,</para>
  <para style="li1" vid="1CH 25:9">दुसरी गदल्याहची, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10" />तिसरी जक्कूरा, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11" />चौथी इज्री,<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">झेरी</char></note> त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12" />पाचवी नथन्याह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13" />सहावी बुक्कीयाह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14" />सातवी यसारेलाह,<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">असारेलाह</char></note> त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15" />आठवी यशायाह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16" />नववी मत्तन्याह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17" />दहावी शिमी, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18" />अकरावी अजरएल,<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">उस्सीएल</char></note> त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19" />बारावी हशब्याह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20" />तेरावी शूबाएल, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21" />चौदावी मत्तिथ्याह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22" />पंधरावी यरेमोथ, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23" />सोळावी हनन्याह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24" />सतरावी योश्बेकाशाह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25" />अठरावी हनानी, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26" />एकोणविसावी मल्लोथी, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27" />विसावी एलियाथाह, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28" />एकविसावी होथीर, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29" />बाविसावी गिद्दल्ती, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30" />तेविसावी महजिओथ, त्याचे पुत्र आणि नातेवाईक 12,<verse eid="1CH 25:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31" />चोविसावी रोमामती-एजेर, त्याचे पुत्र आणि नातेवाईक 12.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">द्वारपाल</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1" />द्वारपालांचे विभाजन:</para>
  <para style="b" vid="1CH 26:1" />
  <para style="lh" vid="1CH 26:1">कोरहा पासून:</para>
  <para style="li1" vid="1CH 26:1">कोरही पुत्र मशेलेम्याह, आसाफाचा एक पुत्र होता. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" />मशेलेम्याहचे पुत्र:</para>
  <para style="li2" vid="1CH 26:2">जखर्‍याह प्रथमपुत्र, यदिएल दुसरा,</para>
  <para style="li2" vid="1CH 26:2">जबद्याह तिसरा, यथनिएल चौथा,<verse eid="1CH 26:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3" />एलाम पाचवा, यहोहानान सहावा</para>
  <para style="li2" vid="1CH 26:3">व एलिओएनाइ सातवा.<verse eid="1CH 26:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4" />ओबेद-एदोमासही पुत्र होते:</para>
  <para style="li2" vid="1CH 26:4">शमायाह प्रथमपुत्र, यहोजाबाद दुसरा,</para>
  <para style="li2" vid="1CH 26:4">योवाह तिसरा, साखार चवथा,</para>
  <para style="li2" vid="1CH 26:4">नथानेल पाचवा, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" />अम्मीएल सहावा,</para>
  <para style="li2" vid="1CH 26:5">इस्साखार सातवा व पउलथय आठवा.</para>
  <para style="li2" vid="1CH 26:5">(कारण परमेश्वराने त्याला आशीर्वाद दिला.)<verse eid="1CH 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6" />ओबेद-एदोमाचा पुत्र शमायाहला सुद्धा पुत्र झाले, ते आपल्या कुटुंबाचे प्रमुख होते, कारण ते सक्षम पुरुष होते. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />शमायाहचे पुत्र:</para>
  <para style="li2" vid="1CH 26:7">अथनी, रफाएल, ओबेद, एलजाबाद;</para>
  <para style="li2" vid="1CH 26:7">आणि त्यांचे बंधू अलीहू आणि समख्याह हे सक्षम पुरुष होते.<verse eid="1CH 26:7" /></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8" />हे सर्व ओबेद-एदोमाचे वंशज होते; ते आणि त्यांचे कुटुंब हे सर्वच सक्षम—काम करण्यास समर्थ पुरुष होते—ओबेद-एदोमाचे वंशज, सर्व मिळून 62.<verse eid="1CH 26:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9" />मशेलेम्याहचे पुत्र व नातेवाईक सुद्धा शूर पुरुष होते—सर्व मिळून 18.<verse eid="1CH 26:9" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10" />मरारी होसाहचे पुत्र:</para>
  <para style="li2" vid="1CH 26:10">शिम्री पहिला (तो प्रथमपुत्र नसतानाही त्याच्या पित्याने त्याला पुढारी नेमले).<verse eid="1CH 26:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11" />हिल्कियाह दुसरा, तबालियाह तिसरा,</para>
  <para style="li2" vid="1CH 26:11">जखर्‍याह चौथा.</para>
  <para style="lf" vid="1CH 26:11">होसाहचे पुत्र व नातेवाईक मिळून एकंदर 13.<verse eid="1CH 26:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12" />ज्याप्रकारे त्यांच्या कुटुंबीयांना देण्यात आली, त्याच प्रकारे सर्व विभाजित द्वारपालांना त्यांच्या पुढार्‍यांव्दारे याहवेहच्या मंदिराची सेवा देण्यात आली. <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" />प्रत्येक द्वारांसाठी, लहान थोर सारखेच समजून त्यांच्या कुटुंबानुसार चिठ्ठ्या टाकण्यात आल्या.<verse eid="1CH 26:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14" />पूर्वेकडील द्वारासाठी शेलेम्याहच्या<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">मशेलेमाह</char></note> नावाची चिठ्ठी निघाली.</para>
  <para style="li1" vid="1CH 26:14">उत्तरेकडील द्वाराची त्याचा पुत्र जखर्‍याहकडे गेली, जो एक बुद्धिमान सल्लागार होता.<verse eid="1CH 26:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15" />दक्षिणेकडील द्वार ओबेद-एदोम आणि त्याच्या पुत्रांच्या ताब्यात कोठारे दिली गेली.<verse eid="1CH 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16" />पश्चिमेकडील द्वाराची व शल्लेकेथ द्वाराशी चढून जाण्याच्या मार्गावर पहारा देण्याची जबाबदारी शुप्पीम व होसाह यांच्याकडे आली.</para>
  <para style="b" vid="1CH 26:16" />
  <para style="lh" vid="1CH 26:16">द्वारपाल पहारेकऱ्यांसह उभे असत:<verse eid="1CH 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17" />पूर्वेच्या द्वारासाठी रोज सहा लेवी,</para>
  <para style="li1" vid="1CH 26:17">उत्तरेच्या द्वारासाठी चार रक्षक,</para>
  <para style="li1" vid="1CH 26:17">दक्षिणेच्या द्वारासाठी चार रक्षक</para>
  <para style="li1" vid="1CH 26:17">आणि भांडारावर एकाच वेळी प्रत्येकी दोन.<verse eid="1CH 26:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18" />न्यायालयाच्या पश्चिमेकडील द्वारांसाठी मार्गावर चार व न्यायालयात दोन रक्षक.<verse eid="1CH 26:18" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19" />हे द्वारपालांचे विभाजित वर्ग कोरही आणि मरारी वंशातील होते.<verse eid="1CH 26:19" /></para>
  <para style="s1">खजिनदार व इतर अधिकारी</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />अहीयाह लेवीस परमेश्वरासाठी मंदिराचे खजिनदार आणि वाहिलेल्या अर्पणांची देखरेख करण्यासाठी नेमण्यात आले.<verse eid="1CH 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21" />लादानाचे वंशज, जे लादान गेर्षोनी होते व जे गेर्षोनी लादानाचे यहीएली कुटुंबप्रमुखांचा समावेश होता. <verse eid="1CH 26:21" /><verse number="22" style="v" sid="1CH 26:22" />यहीएलीचे पुत्र जेथाम आणि त्याचा भाऊ योएलना याहवेहच्या मंदिराच्या खजिन्यावर अधिकारी नेमले होते.<verse eid="1CH 26:22" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23" />अम्रामी पासून इसहारी हेब्रोनी व उज्जीएली:<verse eid="1CH 26:23" /></para>
  <para style="b" />
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24" />मोशेचा पुत्र गेर्षोमच्या वंशातील शबुएल खजिन्यावर प्रमुख अधिकारी होता. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" />एलिएजरपासून त्याचे नातेवाईक: त्याचा पुत्र रहब्याह, त्याचा पुत्र यशायाह, त्याचा पुत्र योराम, त्याचा पुत्र जिक्री, व त्याचा पुत्र शेलोमीथ.<verse eid="1CH 26:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26" />(हा शेलोमीथ आणि त्याचे नातेवाईक दावीद राजाने, हजार सैनिकांचे, शताधिपतींच्या आणि इतर सैनिकांच्या सेनाधिकारींचे कुटुंबप्रमुख, या सर्वांनी अर्पण केलेल्या भांडार वस्तूंची काळजी घेत. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />लढाईतील काही लूट याहवेहच्या मंदिराच्या दुरुस्तीच्या खर्चासाठी अर्पण करीत. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />शमुवेल संदेष्टा, कीशाचा पुत्र शौल, नेराचा पुत्र अबनेर आणि जेरुइयाहचा पुत्र योआब यांनी अर्पण केलेले सर्वकाही आणि इतर अर्पणे सांभाळण्याची जबाबदारी शेलोमीथ आणि त्याच्या नातेवाईकांवर टाकण्यात आली.)<verse eid="1CH 26:28" /></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29" />इसहार्‍यांपैकी:</para>
  <para style="li2" vid="1CH 26:29">कनन्याह आणि त्याचे पुत्र यांची नेमणूक मंदिरापासून दूर इस्राएली लोकांवर अधिकारी आणि न्यायाधीश म्हणून करण्यात आली.<verse eid="1CH 26:29" /></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30" />हेब्रोन्यांपैकी:</para>
  <para style="li2" vid="1CH 26:30">हशब्याह आणि त्याचे नातेवाईक 1,700 सक्षम पुरुष यार्देन नदीच्या पश्चिमेकडील इस्राएलाच्या प्रदेशाचे प्रमुख होते. याहवेहची आणि राजाची सेवा करण्याची जबाबदारी त्यांच्यावर होती. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" />हेब्रोन्यातील यरीयाह हा त्यांच्या वंशावळीच्या नोंदीनुसार त्यांचा कुटुंबप्रमुख होता.</para>
  <para style="li2" vid="1CH 26:31">(दावीद राजाच्या शासनकाळात चाळिसाव्या वर्षी शिरगणतीत शोध घेण्यात आला. गिलआदामधील हिब्रोनी याजेरमध्ये सक्षम पुरुष आढळून आले. <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" />येरीह कडे 2,700 कुटुंब होते, जे सक्षम असून कुटुंबप्रमुख होते. दावीद राजाने त्यांना रऊबेन, गाद आणि मनश्शेहचे अर्धे गोत्र यांच्या परमेश्वरा संबंधित धार्मिक व सामाजिक बाबींवर नियंत्रण ठेवण्यासाठी नेमले.)<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">सेनेचे विभाग</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1" />इस्राएली लोकांची यादी—कुटुंबप्रमुख, हजार सैनिकांचा अधिकारी आणि शंभर सैनिकांचा अधिकारी आणि त्यांचे मुख्य अधिकारी, दरवर्षी प्रत्येक महिन्यात राजाच्या सर्व लष्करी सेवेसाठी या सैन्य विभागांना बोलाविले जात असे. प्रत्येक विभागात 24,000 पुरुष सैनिक असत.<verse eid="1CH 27:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2" />पहिल्या विभागाचा, पहिल्या महिन्याचा सेनापती जब्दीएलाचा पुत्र याशबआमच्या विभागामध्ये 24,000 पुरुष होते. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" />तो पेरेसाच्या वंशातील होता आणि त्याच्या नेतृत्वाची सैन्य तुकडी पहिल्या महिन्यात कामावर असे.<verse eid="1CH 27:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4" />अहोही दोदय हा दुसर्‍या महिन्याच्या विभागाचा सेनापती होता; मिकलोथ त्यांचा मुख्य अधिकारी होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5" />तिसर्‍या महिन्याच्या सैन्य विभागाचा सेनापती, प्रमुख याजक यहोयादाचा पुत्र बेनाइयाह होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" />बेनाइयाह दावीदाच्या सैन्यातील पहिल्या तीस योद्ध्यापैकी एक व त्या तिसांचा अधिकारी होता. त्याचा पुत्र अम्मीजाबाद सैन्य तुकडीचा सेनापती होता.<verse eid="1CH 27:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7" />चौथ्या महिन्याचा चवथा सेनापती योआबाचा भाऊ असाहेल होता; त्याच्यानंतर त्याचा पुत्र जबद्याह त्याच्या जागी आला. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8" />पाचव्या महिन्याचा पाचवा सेनापती इज्राही शम्हूथ होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9" />सहाव्या महिन्याचा सहावा सेनापती तकोवा येथील इक्केशाचा पुत्र ईरा होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10" />सातव्या महिन्याचा सातवा सेनापती हेलेस होता, तो एफ्राईमी असून पलोन येथील होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11" />आठव्या महिन्याचा आठवा सेनापती जेरह कुळातील हुशाथी सिब्बखय होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12" />नवव्या महिन्याचा नववा सेनापती बिन्यामीन अनाथोथी अबिएजेर होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13" />दहाव्या महिन्याचा दहावा सेनापती माहाराई, नटोफाथी जेरही होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14" />अकराव्या महिन्याचा अकरावा सेनापती पिराथोनचा एफ्राईमी बेनाइयाह होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15" />बाराव्या महिन्याचा बारावा सेनापती नटोफाथी हेल्दय असून तो ओथनिएलाच्या कुटुंबातील होता. त्याच्या विभागात 24,000 पुरुष सैनिक होते.<verse eid="1CH 27:15" /></para>
  <para style="s1">गोत्रप्रमुख</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16" />इस्राएलांचे गोत्रप्रमुख हे होते:</para>
  <para style="b" vid="1CH 27:16" />
  <para style="li1" vid="1CH 27:16">रऊबेन गोत्रावर: जिक्रीचा पुत्र एलिएजर;</para>
  <para style="li1" vid="1CH 27:16">शिमओनी गोत्रावर: माकाहचा पुत्र शफात्याह;<verse eid="1CH 27:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17" />लेवी गोत्रावर: कमुवेलाचा पुत्र हशब्याह;</para>
  <para style="li1" vid="1CH 27:17">अहरोन गोत्रावर: सादोक;<verse eid="1CH 27:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18" />यहूदाह गोत्रावर: दावीद राजाचा बंधू अलीहू;</para>
  <para style="li1" vid="1CH 27:18">इस्साखार गोत्रावर: मिखाएलचा पुत्र ओमरी;<verse eid="1CH 27:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19" />जबुलून गोत्रावर: ओबद्याहचा पुत्र इश्मायाह;</para>
  <para style="li1" vid="1CH 27:19">नफताली गोत्रावर: अज्रीएलचा पुत्र यरिमोथ;<verse eid="1CH 27:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20" />एफ्राईमच्या गोत्रावर: अजज्याहचा पुत्र होशेय;</para>
  <para style="li1" vid="1CH 27:20">मनश्शेहच्या अर्ध्या गोत्रावर: पदायाहचा पुत्र योएल;<verse eid="1CH 27:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21" />गिलआदातील मनश्शेहच्या अर्ध्या गोत्रावर: जखर्‍याहचा पुत्र इद्दो;</para>
  <para style="li1" vid="1CH 27:21">बिन्यामीन गोत्रावर: अबनेरचा पुत्र यासीएल;<verse eid="1CH 27:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22" />दान गोत्रावर: यरोहामाचा पुत्र अजरएल.</para>
  <para style="b" vid="1CH 27:22" />
  <para style="lf" vid="1CH 27:22">हे सर्व इस्राएलचे गोत्रप्रमुख होते.<verse eid="1CH 27:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23" />दावीदाने शिरगणती केली, तेव्हा वीस वर्षांच्या किंवा त्यापेक्षा कमी वयाच्या व्यक्तीचा त्या गणतीमध्ये समावेश केला नव्हता, कारण याहवेहने इस्राएली लोकांची संख्या आकाशातील ताऱ्यांसारखी अगणित करण्याचे वचन दिले होते. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" />जेरुइयाहचा पुत्र योआबाने गणती सुरू केली, परंतु तो ती पूर्ण करू शकला नाही. कारण इस्राएलावर परमेश्वराचा कोप भडकला आणि गणतीची पूर्ण संख्या दावीद राजाच्या इतिहासात लिहिली गेली नाही.<verse eid="1CH 27:24" /></para>
  <para style="s1">राजाचे पर्यवेक्षक</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25" />अदिएलाचा पुत्र अजमावेथ राजाचा भांडारपाल होता.</para>
  <para style="li1" vid="1CH 27:25">उज्जीयाहचा पुत्र योनाथान इस्राएलातील सर्व सीमापार नगरे, गावे आणि किल्ले यांचा विभागीय भांडारपाल होता.<verse eid="1CH 27:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26" />कलूबाचा पुत्र एज्री राजाच्या जमिनीची लागवड करणार्‍या कामकर्‍यांवर अधिकारी होता.<verse eid="1CH 27:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27" />रामाही शिमी राजाच्या द्राक्षमळ्यांवर देखरेख करणारा होता.</para>
  <para style="li1" vid="1CH 27:27">जब्दी शिफमी द्राक्षारस बनविणे व त्याचा साठा करणे यास जबाबदार होता.<verse eid="1CH 27:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28" />गदेर येथील बआल-हानान राज्याच्या पश्चिमी डोंगरपायथ्यातील जैतुनाच्या व उंबराच्या झाडांची देखरेख करत असे.</para>
  <para style="li1" vid="1CH 27:28">योआश जैतून तेलाच्या पुरवठ्याचा प्रमुख होता.<verse eid="1CH 27:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29" />शारोनाच्या मैदानात चरणार्‍या कळपांवर शारोनी शित्रेय देखरेख करत असे.</para>
  <para style="li1" vid="1CH 27:29">खोर्‍यातील कळपांवर अदलयचा पुत्र शाफाट हा देखरेख करत असे.<verse eid="1CH 27:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30" />इश्माएली प्रांतातला ओबील उंटांवर देखरेख करत असे.</para>
  <para style="li1" vid="1CH 27:30">गाढवांवर मेरोनोथी यहदायाह देखरेख करत असे.<verse eid="1CH 27:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31" />मेंढरांवर हगरी येथील याजीज देखरेख करत असे.</para>
  <para style="lf" vid="1CH 27:31">हे सर्व दावीद राजाच्या मालमत्तेवर देखरेख ठेवणारे अधिकारी होते.<verse eid="1CH 27:31" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32" />दावीदाचा चुलता योनाथान हा सुशिक्षित असून उत्तम सल्लागार व लेखनिक होता.</para>
  <para style="li1" vid="1CH 27:32">हखमोन्याचा पुत्र यहीएल राजपुत्रांचा शिक्षक होता.<verse eid="1CH 27:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33" />अहीथोफेल राजाचा सल्लागार होता.</para>
  <para style="li1" vid="1CH 27:33">हूशाई अर्की खाजगी सल्लागार होता.<verse eid="1CH 27:33" /></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34" />बेनाइयाहचा पुत्र यहोयादा आणि अबीयाथार नंतर अहीथोफेल त्यांच्या जागी आला.</para>
  <para style="li1" vid="1CH 27:34">योआब राजाच्या शाही सेनेचा सरसेनापती होता.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">मंदिर बांधण्याची दावीदाची योजना</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />दावीदाने इस्राएलच्या सर्व अधिकार्‍यांना यरुशलेम येथे एकत्र बोलाविले: त्यात गोत्रावरील अधिकारी, राजकीय सेवेतील विभागीय अधिकारी, हजार सैन्याचे आणि शंभर सैन्याचे सैन्याधिकारी, राजा आणि राजपुत्र यांच्या स्थावर मालमत्तेची आणि पशुधनाची देखरेख करणारे अधिकारी, युद्ध सैनिक व सर्व वीर योद्धे यांचा समावेश होता.<verse eid="1CH 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2" />राजा दावीद उभा राहिला व म्हणाला: “माझ्या इस्राएली बंधूंनो, माझ्या लोकांनो, माझे ऐका. याहवेहच्या पवित्र कराराच्या कोशासाठी आणि परमेश्वराच्या पादास्थानासाठी एक भवन असावे म्हणून मंदिर बांधण्याची माझी इच्छा होती. आणि मी मंदिर बांधावयास योजना केली आहे. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" />परंतु परमेश्वराने मला सांगितले आहे, ‘तू माझ्या नामासाठी भवन बांधणार नाही, कारण तू योद्धा आहेस आणि तू रक्तपात केला आहेस.’<verse eid="1CH 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4" />“तरीपण याहवेह इस्राएलच्या परमेश्वराने माझ्या सर्व घराण्यातून इस्राएलावर सदासर्वदा राज्य करण्यासाठी मला राजा म्हणून निवडले आहे. त्यांनी प्रथम यहूदाहच्या गोत्राची आणि या गोत्रातून माझ्या पित्याच्या घराण्याची आणि माझ्या पित्याच्या सर्व पुत्रांमधून माझी निवड करून आनंद मानला असून मला इस्राएलावर राजा केले आहे. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" />याहवेहने मला पुष्कळ पुत्र दिलेले आहेत—माझ्या अनेक पुत्रांमधून—याहवेहने इस्राएलींच्या राजगादीवर बसण्यासाठी माझा पुत्र शलोमोन याची निवड केली. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" />याहवेहने मला सांगितले: ‘तुझा पुत्र शलोमोन माझे मंदिर आणि अंगण बांधील, कारण मी त्याला माझा पुत्र म्हणून निवडले आहे आणि मी त्याचा पिता होईन. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" />त्याने माझ्या आज्ञा आणि सूचना आतापर्यंत पाळल्या, त्याप्रमाणे जर तो यापुढेही काटेकोरपणाने पाळल्या, तर मी त्याचे राज्य सदासर्वकाळ टिकवेन.’<verse eid="1CH 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8" />“म्हणून आता सर्व इस्राएलसमोर, याहवेहच्या लोकांसमोर आणि आपल्या परमेश्वराच्या ऐकिवात: मी तुम्हाला सूचना देत आहे की याहवेह परमेश्वराच्या प्रत्येक आज्ञेचे काळजीपूर्वक पालन करा, म्हणजे तुम्ही ही उत्तम भूमी ताब्यात घेऊन, ती सदासर्वदा तुमच्या वंशजांना वारसाहक्क म्हणून देता येईल.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />“आणि तू, माझ्या पुत्रा शलोमोना, आपल्या पित्याच्या परमेश्वराचा अंगीकार कर, त्यांची सेवा पूर्ण अंतःकरणाने व स्वखुशीने कर, कारण याहवेह प्रत्येकाचे अंतःकरण पाहतात आणि त्यातील प्रत्येक इच्छा व विचार त्यांना कळतो. जर तू त्यांना शोधशील, तर ते तुला सापडतील; पण जर तू त्यांचा त्याग करशील, तर ते तुझा कायमचा त्याग करतील. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" />म्हणून आता तू लक्ष दे, याहवेहने त्यांचे पवित्र मंदिर बांधण्यासाठी तुझी निवड केली आहे. शक्तिशाली हो आणि ते कार्य पूर्ण कर.”<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />नंतर दावीदाने मंदिराची नियोजित जागा, तेथील भवने, भांडारगृहे, वरच्या खोल्या, आतील खोल्या, तसेच प्रायश्चिताची जागा यांचा नकाशा शलोमोनाला दिला. <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" />पवित्र आत्म्याने ज्या योजना त्याच्या मनात घातल्या होत्या त्या याहवेहच्या मंदिराच्या अंगणाचा, सभोवतालच्या खोल्यांचा, परमेश्वराच्या मंदिराच्या खजिन्यांचा व समर्पित वस्तूंच्या कोठारांचाही नकाशा त्याला दिला. <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" />याजक व लेवी यांच्या विभागांच्या कामकाजाच्या सूचनाही राजाने शलोमोनाला दिल्या, त्याचप्रमाणे याहवेहच्या मंदिरातील भक्ती व सेवेसाठी वापरण्यात येणाऱ्या प्रत्येक वस्तूचा तपशीलही त्याने त्याला दिला. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />त्याने वजन करून निरनिराळ्या सेवेसाठी लागणाऱ्या सोन्याच्या पात्रांसाठी लागणारे पुरेसे सोने व निरनिराळ्या सेवेसाठी लागणाऱ्या चांदीच्या पात्रांसाठी लागणारी पुरेशी चांदी दिली. <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" />दिव्यांना व दिवठणींना लागणारे ठराविक वजनाचे सोनेही त्याने दिले. त्याने चांदीच्या बैठकींसाठी व दिव्यांसाठी प्रत्येकाच्या कामाप्रमाणे पुरेल एवढी चांदी दिली. <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />त्याने समक्षतेच्या भाकरीच्या मेजासाठी व इतर सोन्याच्या मेजांसाठी सोने तोलून दिले. त्याने चांदीच्या मेजांसाठीसुध्दा चांदी तोलून दिली. <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />शुद्ध सोन्याचे काटेरी चमचे, शिंपडण्यासाठी लागणारे कटोरे आणि प्याले; सोन्याच्या प्रत्येक ताटासाठी सोने, त्याप्रमाणेच चांदीच्या प्रत्येक ताटासाठी चांदी तोलून दिली; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" />आणि त्याने धूपवेदीसाठी लागणारे शुद्ध सोने तोलून दिले. तसेच रथाचा नकाशा म्हणजे याहवेहच्या कराराच्या कोशावर आपले पंख पसरून त्याचे संरक्षण करणार्‍या करुबांचा नकाशा त्याने त्याला दिला.<verse eid="1CH 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19" />दावीद म्हणाला, “हा सगळा तपशील खुद्द याहवेहच्या सूचनांचा परिणाम आहे. आणि त्यांनीच मला या नकाशाचा सर्व तपशील समजण्याचे ज्ञान दिले.”<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />दावीद त्याचा पुत्र शलोमोनला हे देखील म्हणाला, “हिंमत बांध, धैर्य धर आणि कामास लाग, भिऊ नकोस किंवा खचू नकोस, कारण याहवेह परमेश्वर, माझे परमेश्वर तुझ्याबरोबर आहेत. याहवेहच्या मंदिराचे प्रत्येक कार्य योग्यप्रकारे सिद्धीस जाईपर्यंत ते तुझा त्याग करणार नाहीत किंवा तुला अपयश देणार नाहीत. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" />याजक आणि लेवी यांच्या विभागणी प्रमाणे परमेश्वराच्या मंदिरातील सर्व कामे करण्यास तयार आहेत आणि तसेच निरनिराळ्या कारागिरीमध्ये कुशल असलेला प्रत्येक उत्सुक मनुष्य तुला सर्व कामात मदत करण्यास तयार आहे. अधिकारी वर्ग आणि सामान्य लोक तुझ्या प्रत्येक आज्ञेप्रमाणे वागतील.”<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">मंदिर बांधण्यासाठी देणग्या</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />नंतर सर्व जमलेल्या सभेला दावीद राजा म्हणाला: “माझा पुत्र शलोमोन, ज्याची निवड परमेश्वराने केली आहे, तो अजून तरुण आणि अननुभवी आहे. आणि हे कार्य महान आहे, कारण हे भव्यदिव्य मंदिर मानवाकरिता नव्हे, तर खुद्द याहवेह परमेश्वरासाठी आहे. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />माझ्या उपलब्धींचा उपयोग करून परमेश्वराच्या मंदिरासाठी जितक्या वस्तू गोळा करता येतील, तितक्या मी केल्या आहेत—सोन्याच्या कामासाठी सोने, चांदीच्या कामासाठी चांदी, कास्याच्या कामासाठी कास्य, लोखंडाच्या कामासाठी लोखंड, लाकडाच्या कामासाठी लाकूड, गोमेद आणि जडावाच्या कामासाठी रंगीबेरंगी पाचूरत्न, उत्तम रत्ने, संगमरवरी पाषाण—मी गोळा केले आहेत. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />माझा भक्तिभाव माझ्या परमेश्वराच्या मंदिरावर आहे, म्हणून माझ्या व्यक्तिगत खजिन्यातून जो सोने आणि चांदीचा मी संग्रह केला आहे, तो मी परमेश्वराच्या मंदिरासाठी देतो. याव्यतिरिक्त या पवित्र मंदिरासाठी मी दिले आहे: <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" />ओफीराचे तीन हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">अंदाजे 100 मेट्रिक टन</char></note> सोने आणि मंदिराच्या भिंती मढविण्यासाठी सात हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">29:4 </char><char style="ft" closed="false">अंदाजे 235 मेट्रिक टन</char></note> शुद्ध चांदी. <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />सर्व सोने आणि चांदीची कामे कारागिरांकडून करण्यात येतील. आता स्वेच्छेने याहवेहसाठी स्वतःचे पवित्रीकरण करण्यास कोण तयार आहे?”<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />मग कुटुंबप्रमुख, इस्राएल गोत्राचे अधिकारी, हजार सैनिकांचे अधिकारी, आणि शंभर सैनिकांचे अधिकारी, राजाचे शासकीय अधिकारी यांनी स्वेच्छेने दान दिले. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" />परमेश्वराच्या मंदिराच्या कामासाठी त्यांनी पाच हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">अंदाजे 170 मेट्रिक टन</char></note> आणि दहा हजार दारिक<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">अंदाजे 84 कि.ग्रॅ.</char></note> सोने, दहा हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">अंदाजे 340 मेट्रिक टन</char></note> चांदी, अठरा हजार तालांत<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">अंदाजे 610 मेट्रिक टन</char></note> कास्य आणि एक लाख तालांत<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">अंदाजे 3,400 मेट्रिक टन</char></note> लोखंड दिले. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" />ज्यांच्याकडे रत्ने होती ती त्यांनी खजिन्यामध्ये जमा करण्यासाठी याहवेहच्या मंदिरातील खजिनदार गेर्षोनी यहीएलकडे सोपविली. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" />पुढाऱ्यांच्या या स्वेच्छेने दिलेल्या प्रतिसादाने सर्व लोक आनंदित झाले, कारण त्यांनी स्वयंस्फुर्तीने व पूर्ण अंतःकरणाने, आनंदाने याहवेहच्या सेवेला दिले, दावीद राजालाही मोठा आनंद झाला.<verse eid="1CH 29:9" /></para>
  <para style="s1">दावीदाची प्रार्थना</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />दावीदाने सर्व सभेदेखत याहवेहची स्तुती केली, तो म्हणाला,</para>
  <para style="q1" vid="1CH 29:10">“हे याहवेह परमेश्वरा,</para>
  <para style="q2" vid="1CH 29:10">आमच्या इस्राएलच्या पित्याच्या परमेश्वरा,</para>
  <para style="q2" vid="1CH 29:10">अनादि ते अनंतकालापर्यंत तुमची स्तुती असो.<verse eid="1CH 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11" />याहवेह, तुमचे सामर्थ्य व महिमा महान आहे;</para>
  <para style="q2" vid="1CH 29:11">गौरव, वैभव व ऐश्वर्य ही सदासर्वकाळ तुमचीच असो,</para>
  <para style="q2" vid="1CH 29:11">पृथ्वीवरील व स्वर्गातील सर्वकाही तुमचेच आहे!</para>
  <para style="q1" vid="1CH 29:11">याहवेह, हे सर्व तुमचेच राज्य आहे;</para>
  <para style="q2" vid="1CH 29:11">तुमचे प्रभुत्व सर्वांवर आहे.<verse eid="1CH 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12" />श्रीमंती व सन्मान तुमच्याकडूनच येतात;</para>
  <para style="q2" vid="1CH 29:12">तुम्ही सर्व गोष्टीचे शासक आहात.</para>
  <para style="q1" vid="1CH 29:12">सर्वांना मोठेपणा व सामर्थ्य देण्याकरिता</para>
  <para style="q2" vid="1CH 29:12">केवळ तुमच्याच बाहूत सामर्थ्य आणि अधिकार आहे.<verse eid="1CH 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13" />आता, हे आमच्या परमेश्वरा, आम्ही तुमचे उपकार मानतो,</para>
  <para style="q2" vid="1CH 29:13">आणि तुमच्या वैभवी नावाची स्तुती करतो.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />“परंतु मी कोण, माझी शक्ती आणि माझे लोक कोण, जे तुम्हाला इतक्या उदारतेने दान देऊ शकतील? आमच्याजवळचे सर्वकाही तुमच्याकडूनच मिळालेले आहे आणि तेच आम्ही तुम्हाला देत आहोत. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" />आम्ही तुमच्या दृष्टीने आमच्या पूर्वजांप्रमाणे परकीय व अगांतुक आहोत. आमचे पृथ्वीवरील दिवस एखाद्या सावलीप्रमाणे आहेत, काही आशा न ठेवता ते नाहीसे होतील. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />हे आमच्या याहवेह परमेश्वरा, तुमच्या पवित्र नावासाठी, तुमचे मंदिर बांधण्यास जे प्रचंड साहित्य आम्ही गोळा केले आहे, ते सर्व तुमच्याकडून मिळाले आहे, हे सर्वकाही तुमचेच आहे. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" />माझ्या परमेश्वरा, मी जाणतो, तुम्ही हृदयाची परीक्षा घेता आणि खरेपणाने प्रसन्न होता. मी या सर्व वस्तू स्वखुशीने व प्रामाणिक हेतूने दिल्या आहेत. आणि आता हे बघून मला आनंद झाला की तुमच्या लोकांनीही किती आनंदाने स्वखुशीने या देणग्या दिल्या आहेत. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />हे याहवेह, आमच्या पित्या अब्राहाम, इसहाक आणि इस्राएल यांच्या परमेश्वरा, तुमच्या लोकांच्या मनात या इच्छा कायम राखा आणि त्यांचे अंतःकरण तुमच्याशी एकनिष्ठ राहू द्या. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" />माझा पुत्र शलोमोनाने एकचित्त हृदयाने तुमच्या सर्व आज्ञा, आदेश व नियम पाळावे, व हे भव्यदिव्य बांधकाम पूर्ण करण्यास सर्वतोपरी प्रयत्न करावा, ज्याच्यासाठी मी संपूर्ण तयारी करून ठेवली आहे.”<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />नंतर दावीद सर्व मंडळीला म्हणाला, “तुमच्या याहवेह परमेश्वराची स्तुती करा.” म्हणून त्या सर्वांनी आपल्या पूर्वजांचे याहवेह परमेश्वराची मस्तके लववून, दंडवते घालून, त्यांचा राजा याहवेहची स्तुती केली.<verse eid="1CH 29:20" /></para>
  <para style="s1">राजा म्हणून शलोमोनचा स्वीकार</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21" />दुसर्‍या दिवशी त्यांनी याहवेहसाठी यज्ञ व होमबली अर्पण केले: एक हजार गोर्‍हे, एक हजार मेंढे आणि एक हजार कोकरे, सोबत पेयार्पणे, तसेच इस्राएलींच्या वतीने इतर विपुल अर्पणे वाहिली. <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" />त्यांनी त्या दिवशी याहवेहसमोर मोठ्या आनंदाने खाणेपिणे केले.</para>
  <para style="p" vid="1CH 29:22">नंतर त्यांनी दावीद राजाचा पुत्र शलोमोनचा याहवेहसमोर आणि सर्व पुढार्‍यांसमोर पुन्हा राज्यकर्ता म्हणून राज्याभिषेक केला. आपला याजक म्हणून त्यांनी सादोकाचाही याजक म्हणून अभिषेक केला. <verse eid="1CH 29:22" /><verse number="23" style="v" sid="1CH 29:23" />अशा रीतीने शलोमोन त्याचा पिता दावीदानंतर राजा झाला आणि याहवेहच्या सिंहासनावर बसला. त्याची भरभराट झाली व सर्व इस्राएली लोक त्याच्या आज्ञेत राहिले. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />सर्व अधिकारी आणि शूरवीर सैनिक, दावीद राजांच्या पुत्रांनी राजा शलोमोनशी एकनिष्ठ राहण्याचे वचन दिले.<verse eid="1CH 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25" />याहवेहने शलोमोनाला इस्राएलीदेखत सर्वाधिक सन्मान दिला आणि इस्राएलमध्ये कोणत्याही राजाला त्याच्यासारखे शाही ऐश्वर्य दिले नव्हते.<verse eid="1CH 29:25" /></para>
  <para style="s1">दावीदाचा मृत्यू</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />अशाप्रकारे इशायाचा पुत्र दावीदाने सर्व इस्राएलावर राज्य केले. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />दावीदाने इस्राएलवर चाळीस वर्षे राज्य केले; सात वर्षे हेब्रोनमध्ये आणि तेहतीस वर्षे यरुशलेममध्ये राज्य केले. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />तो वयोवृद्ध होऊन मरण पावला, त्याने दीर्घायुष्य घालविले, संपत्ती आणि मान मिळविला. त्याच्या जागी त्याचा पुत्र शलोमोन राज्य करू लागला.<verse eid="1CH 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 29:29" />दावीद राजाच्या कारकिर्दीतील घटना, सुरुवातीपासून शेवटपर्यंत द्रष्टा शमुवेल, संदेष्टा नाथान आणि द्रष्टा गाद यांच्या ग्रंथात लिहिल्या आहेत. <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />त्याच्या राज्याचा सर्व वृत्तांत, त्याचे सामर्थ्य, त्याच्यावर आणि इस्राएलावर आणि इतर शेजारील राष्ट्रांच्या राजांवर जे बरे वाईट प्रसंग आले, ते सर्व या ग्रंथात नमूद केले आहेत.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>