<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Biblica® Open Marathi Contemporary Version</book>
  
  <para style="h">गणना</para>
  <para style="toc1">गणनेचे पुस्तक</para>
  <para style="toc2">गणना</para>
  <para style="toc3">गण</para>
  <para style="mt1">गणनेचे पुस्तक</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s1">जनगणना</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />इस्राएली लोक इजिप्तमधून बाहेर आल्यावर, दुसर्‍या वर्षाच्या दुसर्‍या महिन्याच्या पहिल्या दिवशी सीनाय रानात सभामंडपामध्ये याहवेह मोशेशी बोलले. ते म्हणाले: <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“संपूर्ण इस्राएली समुदायाची त्यांचे कूळ आणि कुटुंब यानुसार, प्रत्येक पुरुषाच्या नावाने एकएक करून जनगणना करा. <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />तू आणि अहरोनाने त्यांच्या विभागानुसार जे वीस वर्षे किंवा त्याहून अधिक वयाच्या आणि सैन्यात सेवा करण्यास सक्षम असलेल्या सर्व इस्राएली पुरुषांची गणना करावी. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />प्रत्येक कुळा मधून जो मनुष्य कुटुंबप्रमुख आहे त्याने तुला मदत करावी.<verse eid="NUM 1:4" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="5" style="v" sid="NUM 1:5" />“तुम्हाला मदत करणार्‍या पुरुषांची नावे ही आहेत:</para>
  <para style="b" vid="NUM 1:5" />
  <para style="li1" vid="NUM 1:5">“रऊबेन वंशातील शदेयुराचा पुत्र एलीसूर;<verse eid="NUM 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 1:6" />शिमओन वंशातील, सुरीशादैचा पुत्र शेलुमीएल;<verse eid="NUM 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7" />यहूदाह वंशातील अम्मीनादाबाचा पुत्र नहशोन;<verse eid="NUM 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8" />इस्साखार वंशातील सूवाराचा पुत्र नथानेल;<verse eid="NUM 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9" />जबुलून वंशातील हेलोनाचा पुत्र एलियाब;<verse eid="NUM 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10" />योसेफाचे पुत्र:</para>
  <para style="li2" vid="NUM 1:10">एफ्राईम वंशातील अम्मीहूदाचा पुत्र एलीशामा;</para>
  <para style="li2" vid="NUM 1:10">मनश्शेह वंशातील पदहसूरचा पुत्र गमलीएल;<verse eid="NUM 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11" />बिन्यामीन वंशातील गिदोनाचा पुत्र अबीदान;<verse eid="NUM 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12" />दान वंशातील अम्मीशद्दायचा पुत्र अहीएजर;<verse eid="NUM 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13" />आशेर वंशातील आक्रानाचा पुत्र पगीयेल;<verse eid="NUM 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14" />गाद वंशातील देउएलाचा पुत्र एलीआसाफ;<verse eid="NUM 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15" />नफतालीचा वंशातील एनानाचा पुत्र अहीरा.”<verse eid="NUM 1:15" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="16" style="v" sid="NUM 1:16" />हे सर्व वंशांतून निवडलेले पुरुष त्यांच्या पूर्वजांच्या वंशांचे सरदार आहेत. ते इस्राएली गोत्रप्रमुख होते.<verse eid="NUM 1:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />मोशे आणि अहरोनाने नावे नमूद केलेल्यांना घेतले, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />आणि दुसर्‍या महिन्याच्या पहिल्या दिवशी सर्व समुदायाला एकत्र बोलाविले. लोकांनी आपआपल्या पूर्वजांची नावे, आपले कूळ व घराणे यानुसार नोंदणी केली आणि वीस वर्षे किंवा त्याहून अधिक वयाच्या पुरुषांच्या नावांची एकामागून एक यादी केली. <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />याहवेहने मोशेला आज्ञा केल्याप्रमाणेच सीनायच्या रानात त्याने त्यांची गणती केली:<verse eid="NUM 1:19" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="20" style="v" sid="NUM 1:20" />इस्राएलचा पहिला पुत्र रऊबेनच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:20">वीस वर्षे किंवा त्याहून अधिक वयाचे, सैन्यात सेवा करण्यास सक्षम असणाऱ्या सर्व पुरुषांची नावे, त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />रऊबेनाच्या गोत्रांची संख्या 46,500 होती.<verse eid="NUM 1:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="NUM 1:22" />शिमओनाच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:22">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष व जे सैन्यात सेवा करण्यास सक्षम होते अशांची नावे त्यांचे कूळ आणि कुटुंबानुसार नोंदण्यात आली. <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />शिमओनाच्या गोत्रांची संख्या 59,300 होती.<verse eid="NUM 1:23" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="24" style="v" sid="NUM 1:24" />गादच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:24">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />गाद गोत्रांची संख्या 45,650 होती.<verse eid="NUM 1:25" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="26" style="v" sid="NUM 1:26" />यहूदाहच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:26">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />यहूदाहच्या गोत्रांची संख्या 74,600 होती.<verse eid="NUM 1:27" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="28" style="v" sid="NUM 1:28" />इस्साखारच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:28">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />इस्साखार गोत्रांची संख्या 54,400.<verse eid="NUM 1:29" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="30" style="v" sid="NUM 1:30" />जबुलूनच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:30">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />जबुलून गोत्रांची संख्या 57,400.<verse eid="NUM 1:31" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="32" style="v" sid="NUM 1:32" />योसेफाच्या पुत्रांमधून:</para>
  <para style="li1" vid="NUM 1:32">एफ्राईमच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:32">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />एफ्राईमच्या गोत्रांची संख्या 40,500.<verse eid="NUM 1:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 1:34" />मनश्शेहच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:34">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />मनश्शेहच्या गोत्रांची संख्या 32,200 होती.<verse eid="NUM 1:35" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="36" style="v" sid="NUM 1:36" />बिन्यामीनच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:36">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />बिन्यामीन गोत्रांची संख्या 35,400 होती.<verse eid="NUM 1:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 1:38" />दानच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:38">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />दान गोत्रांची संख्या 62,700 होती.<verse eid="NUM 1:39" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="40" style="v" sid="NUM 1:40" />आशेरच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:40">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />आशेर गोत्रांची संख्या 41,500 होती.<verse eid="NUM 1:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 1:42" />नफतालीच्या वंशजातून:</para>
  <para style="li2" vid="NUM 1:42">वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांचे कूळ आणि कुटुंब यानुसार नोंदण्यात आली. <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />नफताली गोत्रांची संख्या 53,400 होती.<verse eid="NUM 1:43" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="44" style="v" sid="NUM 1:44" />मोशे आणि अहरोन आणि इस्राएलच्या प्रत्येक घराण्याच्या बारा पुढार्‍यांनी मोजलेले पुरुष ते हेच. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />सर्व इस्राएलातील वीस वर्षे किंवा त्याहून अधिक वयाचे सर्व पुरुष जे सैन्यात सेवा करण्यास सक्षम होते, अशांची नावे त्यांच्या कुटुंबानुसार नोंदण्यात आली. <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />एकूण संख्या 6,03,550 होती.<verse eid="NUM 1:46" /></para>
  <para style="b" />
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />परंतु लेवी पूर्वजांच्या गोत्रांची गणना मात्र इतरांबरोबर करण्यात आली नाही. <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />याहवेहने मोशेला सांगितले होते: <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“लेवी गोत्राची गणती करू नये किंवा इस्राएलच्या जनगणनेमध्ये त्यांचा समावेश करू नये. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />परंतु कराराच्या नियमाचा निवासमंडप; त्यातील सामुग्री व त्यासंबंधाचे जे काही आहे त्यावर लेवींची प्रमुख म्हणून नेमणूक कर. त्यांनी निवासमंडप व त्यातील सामुग्री वाहून न्यावी; त्यांनी त्याची काळजी घ्यावी व त्याभोवती आपला डेरा उभारावा. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />ज्यावेळी निवासमंडप पुढे जायचा असेल, त्यावेळी लेव्यांनीच तो खाली काढावा आणि ज्यावेळी निवासमंडप उभारावयाचा असेल त्यावेळी लेव्यांनीच तो उभारावा. इतर कोणी निवासमंडपाच्या जवळ गेल्यास त्याला जिवे मारावे. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />इस्राएली लोकांनी आपआपल्या दलानुसार, प्रत्येकाने आपआपल्या छावणीत, आपआपल्या झेंड्याखाली आपले डेरे द्यावे. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />परंतु लेव्यांनी आपले डेरे कराराच्या निवासमंडपाच्या सभोवती उभारावे, म्हणजे इस्राएली समुदायाविरुद्ध माझा क्रोध पेटणार नाही. लेव्यांनी कराराच्या नियमाच्या निवासमंडपाची जबाबदारी घेऊन त्याची काळजी घ्यावी.”<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />याहवेहने मोशेला जसे आज्ञापिले होते, त्याप्रमाणे इस्राएली लोकांनी सर्वकाही केले.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">गोत्राच्या डेर्‍यांची व्यवस्था</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />याहवेहने मोशे आणि अहरोनाला म्हटले: <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />“इस्राएली लोकांनी सभामंडपाच्या सभोवती, त्यापासून थोडे अंतरावर आपआपले डेरे उभारावे, प्रत्येकाने ते आपआपल्या झेंड्याजवळ व आपल्या घराण्याच्या निशाणाजवळ ते उभारावे.”<verse eid="NUM 2:2" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="3" style="v" sid="NUM 2:3" />पूर्वेकडे, सूर्योदयाच्या दिशेने:</para>
  <para style="li1" vid="NUM 2:3">यहूदाहच्या छावणीच्या दलांनी त्यांच्या झेंड्याखाली आपला डेरा द्यावा. यहूदाहच्या लोकांचा पुढारी अम्मीनादाबाचा मुलगा नहशोन असावा. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />त्यांच्या दलातील लोकांची संख्या 74,600 होती.<verse eid="NUM 2:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 2:5" />इस्साखारचे गोत्र त्यांच्या शेजारी डेरा देणार. इस्साखारच्या लोकांचा पुढारी सूवाराचा मुलगा नथानेल असावा. <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />त्यांच्या दलातील लोकांची संख्या 54,400 होती.<verse eid="NUM 2:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 2:7" />त्यानंतर जबुलूनचे गोत्र असणार. हेलोनचा पुत्र एलियाब हा जबुलूनच्या लोकांचा पुढारी आहे. <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />त्यांच्या दलातील लोकांची संख्या 57,400 होती.<verse eid="NUM 2:8" /></para>
  <para style="lf">
    <verse number="9" style="v" sid="NUM 2:9" />यहूदाहच्या छावणीत नेमलेले सर्व पुरुष, त्यांच्या दलानुसार, संख्येने 1,86,400 होते. त्यांनी सर्वप्रथम निघावे.<verse eid="NUM 2:9" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="10" style="v" sid="NUM 2:10" />दक्षिणेच्या बाजूस:</para>
  <para style="li1" vid="NUM 2:10">रऊबेनच्या छावणीच्या दलाने त्यांच्या झेंड्याखाली आपला डेरा द्यावा असावा. रऊबेनच्या लोकांचा पुढारी शेदेऊरचा पुत्र एलीसूर आहे. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />त्यांच्या दलातील लोकांची संख्या 46,500 होती.<verse eid="NUM 2:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 2:12" />शिमओनचे गोत्र त्यांच्या शेजारी डेरा देईल. शिमओनच्या लोकांचा पुढारी सुरीशादैचा पुत्र शेलुमीएल आहे. <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />त्यांच्या दलातील लोकांची संख्या 59,300 होती.<verse eid="NUM 2:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 2:14" />त्यानंतर गाद गोत्र असेल. गादच्या लोकांचा पुढारी रऊएलाचा पुत्र एलीआसाफ आहे. <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />त्यांच्या दलातील लोकांची संख्या 45,650 होती.<verse eid="NUM 2:15" /></para>
  <para style="lf">
    <verse number="16" style="v" sid="NUM 2:16" />रऊबेनच्या छावणीत नेमलेले सर्व पुरुष, त्यांच्या दलानुसार संख्येने 1,51,450 होते. ते दुसर्‍या रांगेत निघतील.<verse eid="NUM 2:16" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="17" style="v" sid="NUM 2:17" />मग सभामंडप व लेव्यांची छावणी सर्व छावण्यांच्या मध्यभागी असणार. ज्या क्रमाने ते डेरा देऊन राहतात त्याच क्रमाने, आपल्या झेंड्याखाली आपआपल्या जागेवर त्यांनी निघावे.<verse eid="NUM 2:17" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="18" style="v" sid="NUM 2:18" />पश्चिमेच्या बाजूस:</para>
  <para style="li1" vid="NUM 2:18">एफ्राईमच्या दलाने आपल्या झेंड्याखाली आपला डेरा द्यावा. एफ्राईमच्या लोकांचा पुढारी अम्मीहूदाचा पुत्र एलीशामा आहे. <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />त्यांच्या दलातील लोकांची संख्या 40,500 होती.<verse eid="NUM 2:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 2:20" />मनश्शेहचे गोत्र त्यांच्यानंतर असेल. मनश्शेहच्या लोकांचा पुढारी पदहसूरचा पुत्र गमलीएल आहे. <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />त्यांच्या दलातील लोकांची संख्या 32,200 होती.<verse eid="NUM 2:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 2:22" />त्यानंतर बिन्यामीनचे गोत्र असणार. बिन्यामीन लोकांचा पुढारी गिदयोनीचा पुत्र अबीदान आहे. <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />त्यांच्या दलातील लोकांची संख्या 35,400 होती.<verse eid="NUM 2:23" /></para>
  <para style="lf">
    <verse number="24" style="v" sid="NUM 2:24" />एफ्राईमच्या छावणीत नेमलेले सर्व पुरुष, त्यांच्या दलानुसार संख्येने 1,08,100 होते. ते तिसर्‍या रांगेत निघतील.<verse eid="NUM 2:24" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="25" style="v" sid="NUM 2:25" />उत्तरेच्या बाजूस:</para>
  <para style="li1" vid="NUM 2:25">दानच्या दलाने आपल्या झेंड्याखाली त्यांचा डेरा द्यावा. दान लोकांचा पुढारी अम्मीशद्दायचा पुत्र अहीएजर आहे. <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />त्यांच्या दलातील लोकांची संख्या 62,700 होती.<verse eid="NUM 2:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 2:27" />आशेर गोत्र त्यांच्या शेजारी डेरा देईल. आशेर लोकांचा पुढारी ओक्रानचा पुत्र पगीयेल आहे. <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />त्यांच्या दलातील लोकांची संख्या 41,500 होती.<verse eid="NUM 2:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 2:29" />नफताली गोत्र त्यांच्या शेजारी असणार. नफताली लोकांचा पुढारी एनानाचा पुत्र अहीरा आहे. <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />त्यांच्या दलातील लोकांची संख्या 53,400 होती.<verse eid="NUM 2:30" /></para>
  <para style="lf">
    <verse number="31" style="v" sid="NUM 2:31" />दानच्या छावणीत नेमलेले सर्व पुरुष, त्यांच्या दलानुसार संख्येने 1,57,600 होते. त्यांच्या झेंड्याखाली ते सर्वांच्या शेवटी निघतील.<verse eid="NUM 2:31" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="32" style="v" sid="NUM 2:32" />आपआपल्या घराण्यानुसार मोजलेले इस्राएली लोक हे आहेत. छावणीतील सर्व पुरुषांची संख्या 6,03,550 होती. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />याहवेहने मोशेला दिलेल्या आज्ञेप्रमाणे इतर इस्राएल लोकांबरोबर लेव्यांची मोजणी केली नव्हती.<verse eid="NUM 2:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />अशा रीतीने याहवेहने मोशेला आज्ञापिल्याप्रमाणे इस्राएली लोकांनी प्रत्येक गोष्ट केली, ते असे की, आपआपल्या झेंड्याजवळ ते डेरे देत असत आणि आपले कूळ व घराणे यानुसार पुढे चालत असत.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">लेव्यांची कर्तव्ये</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />सीनाय डोंगरावर याहवेह मोशेबरोबर बोलले, त्यावेळी अहरोन व मोशे यांची वंशावळी ही होती.<verse eid="NUM 3:1" /></para>
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="NUM 3:2" />अहरोनाच्या पुत्रांची नावे: प्रथम जन्मलेला नादाब, मग अबीहू, एलअज़ार व इथामार. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />अहरोनाच्या ज्या पुत्रांचा याजक म्हणून अभिषेक करण्यात आला आणि निवासमंडपात सेवा करण्यासाठी समर्पित करण्यात आले, त्यांची ही वरील नावे होती. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />नादाब व अबीहूनी सीनायच्या रानात अनाधिकृत अग्नी वापरल्यामुळे ते याहवेहसमोर मरण पावले, त्यांना पुत्र नसल्यामुळे एलअज़ार व इथामारनी त्यांचे वडील अहरोनाच्या जीवनकाळात याजक म्हणून सेवा केली.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />याहवेह मोशेला म्हणाले, <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“लेवीच्या गोत्राने अहरोन याजकाला मदत करावी म्हणून तू त्यांना त्याच्यासमोर सादर कर. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />त्यांनी सभामंडपात त्याच्यासाठी आणि संपूर्ण समुदायासाठी निवासमंडपाचे काम करून कर्तव्ये पार पाडावीत. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />सभामंडपाच्या सर्व सामानाची त्यांनी काळजी घ्यावी, निवासमंडपाचे काम करून इस्राएली लोकांची कर्तव्ये पूर्ण करावी. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />यास्तव लेव्यांना अहरोन आणि त्याच्या पुत्रांच्या हाती द्यावे; संपूर्ण इस्राएली लोकांमधून ते अहरोनाला पूर्णपणे देण्यात आलेले आहेत. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />याजकाची सेवा करण्यासाठी अहरोन व त्याच्या पुत्रांची नेमणूक करावी. इतर दुसरे कोणी पवित्रस्थानाच्या जवळ आले, तर त्यास जिवे मारावे.”<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />आणि याहवेह मोशेला म्हणाले, <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“इस्राएली लोकांतील प्रत्येक स्त्रीच्या पोटी प्रथम जन्मलेल्या पुत्रांच्या ऐवजी मी लेव्यांना घेतले आहे. लेवी लोक माझे आहेत, <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />कारण सर्व प्रथम जन्मलेले माझे आहेत. ज्या दिवशी इजिप्तमध्ये मी सर्व प्रथम जन्मलेले मारून टाकले, त्या दिवशी इस्राएलातील प्रत्येक प्रथम जन्मलेले मी माझ्यासाठी समर्पित करून घेतले, ते मनुष्य असो किंवा पशू, ते माझे आहेत, मीच याहवेह आहे.”<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />याहवेहने पुन्हा मोशेला सीनाय रानात सांगितले, <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“आता तू लेवींची त्यांच्या घराण्यानुसार व कुळानुसार गणती करावी. एक महिन्याच्या व त्यापेक्षा जास्त वयाच्या प्रत्येक पुरुषाची गणती करावी.” <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />याहवेहच्या आज्ञेनुसार मोशेने लेव्यांची गणती केली.<verse eid="NUM 3:16" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="17" style="v" sid="NUM 3:17" />लेवीच्या पुत्रांची नावे ही:</para>
  <para style="li2" vid="NUM 3:17">गेर्षोन, कोहाथ आणि मरारी.<verse eid="NUM 3:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="NUM 3:18" />गेर्षोनाच्या कुळांची नावे ही होती:</para>
  <para style="li2" vid="NUM 3:18">लिब्नी आणि शिमी.<verse eid="NUM 3:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 3:19" />कोहाथाची कुळे:</para>
  <para style="li2" vid="NUM 3:19">अम्राम, इसहार, हेब्रोन आणि उज्जीएल.<verse eid="NUM 3:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 3:20" />मरारीची कुळे:</para>
  <para style="li2" vid="NUM 3:20">महली आणि मूशी.</para>
  <para style="b" vid="NUM 3:20" />
  <para style="lf" vid="NUM 3:20">त्यांच्या घराण्यानुसार लेवीची कुळे ही होती.<verse eid="NUM 3:20" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="21" style="v" sid="NUM 3:21" />लिब्नी व शिमी ही कुळे गेर्षोनापासून होती; ही गेर्षोनी कुळे होती.<verse eid="NUM 3:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 3:22" />एक महिना किंवा त्याहून अधिक वयाच्या सर्व पुरुषांची संख्या 7,500 होती.<verse eid="NUM 3:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 3:23" />गेर्षोनी कुळांनी निवासमंडपाच्या मागे पश्चिमेकडे डेरा द्यावा.<verse eid="NUM 3:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 3:24" />गेर्षोनी घराण्याचा प्रमुख लाएलचा पुत्र एलीआसाफ होता.<verse eid="NUM 3:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 3:25" />सभामंडपात गेर्षोनी लोकांची जबाबदारी ही होती की, त्यांनी निवासमंडप व तंबू, त्याचे आच्छादन, सभामंडपाच्या प्रवेशद्वाराचा पडदा, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />आणि अंगणाचे पडदे, निवासमंडप आणि वेदीच्या सभोवतालच्या अंगणाच्या प्रवेशद्वाराचा पडदा आणि दोर्‍या व त्याच्या वापराशी संबंधित जे सर्वकाही आहे यांची काळजी घ्यावी.<verse eid="NUM 3:26" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="27" style="v" sid="NUM 3:27" />अम्रामी, इसहारी, हेब्रोनी आणि उज्जीएली हे कोहाथी कुळाचे होते; ही कोहाथची कुळे होती.<verse eid="NUM 3:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 3:28" />एक महिना किंवा त्याहून अधिक वयाच्या सर्व पुरुषांची संख्या 8,600 होती.</para>
  <para style="li1" vid="NUM 3:28">पवित्रस्थानाची काळजी घेण्याची जबाबदारी कोहाथी लोकांकडे होती.<verse eid="NUM 3:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 3:29" />कोहाथी कुळांनी निवासमंडपाच्या दक्षिणेकडे डेरे द्यायचे होते.<verse eid="NUM 3:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="NUM 3:30" />उज्जीएलचा पुत्र एलीजाफान हा कोहाथी कुळांचा पुढारी होता.<verse eid="NUM 3:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="NUM 3:31" />कोश, मेज, दीपस्तंभ, वेद्या, पवित्रस्थानाच्या सेवेत वापरली जाणारी उपकरणे, पडदा आणि त्यांच्या वापराशी संबंधित सर्व गोष्टींची काळजी घेण्यास ते जबाबदार होते.<verse eid="NUM 3:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="NUM 3:32" />अहरोन याजकाचा पुत्र एलअज़ार हा लेवींचा प्रमुख पुढारी होता. पवित्रस्थानाची काळजी घेण्याची जबाबदारी असलेल्यांवर त्याची नेमणूक करण्यात आली होती.<verse eid="NUM 3:32" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="33" style="v" sid="NUM 3:33" />महली व मूशी हे कुळे मरारीपासून होते. ही मरारी कुळे होती.<verse eid="NUM 3:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 3:34" />एक महिना किंवा त्याहून अधिक वयाच्या सर्व पुरुषांची संख्या सहा हजार दोनशे होती.<verse eid="NUM 3:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 3:35" />अबीहाईलाचा पुत्र जूरीएल हा मरारी घराण्यांच्या कुळांचा पुढारी होता.</para>
  <para style="li1" vid="NUM 3:35">त्यांनी निवासमंडपाच्या उत्तरेला डेरे द्यायचे होते.<verse eid="NUM 3:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="NUM 3:36" />मरारी लोकांची नेमणूक निवासमंडपाच्या फळ्या, अडसर, खांब, बैठका, त्याची सर्व उपकरणे आणि त्यांच्या वापरा संबंधित सर्व गोष्टींची काळजी घेण्यासाठी, <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />तसेच अंगणाच्या आजूबाजूच्या बैठका, तंबूच्या मेखा आणि दोर्‍या यावर करण्यात आली होती.<verse eid="NUM 3:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 3:38" />मोशे आणि अहरोन आणि त्याच्या पुत्रांनी निवासमंडपाच्या पूर्वेला, सूर्योदयाच्या दिशेने, सभामंडपासमोर डेरा द्यायचा होता.</para>
  <para style="li1" vid="NUM 3:38">इस्राएली लोकांच्या वतीने पवित्रस्थानाची काळजी घेण्याची जबाबदारी त्यांच्याकडे होती.</para>
  <para style="li1" vid="NUM 3:38">इतर कोणीही पवित्रस्थानाजवळ आले तर त्याला जिवे मारले जावे.<verse eid="NUM 3:38" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="39" style="v" sid="NUM 3:39" />याहवेहच्या आज्ञेप्रमाणे मोशे व अहरोन यांनी लेवी लोकांची त्यांच्या कुळानुसार एक महिन्याचे व अधिक वयाचे पुरुष यांची गणती केली, ते एकूण 22,000 होते.<verse eid="NUM 3:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />मग याहवेह मोशेला म्हणाले, “इस्राएली लोकांतील एक महिन्याच्या व त्याहून अधिक वयाच्या प्रथम जन्मलेल्या सर्व पुरुषांची गणती करून त्यांच्या नावांची यादी करावी. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />आणि इस्राएली लोकांच्या सर्व प्रथम जन्मलेल्यांच्या ऐवजी लेव्यांना माझ्यासाठी घ्यावे आणि इस्राएली लोकांच्या पशूतील सर्व प्रथम जन्मलेल्या वत्सांऐवजी, लेव्याच्या पशूंना माझ्यासाठी घ्यावे. मीच याहवेह आहे.”<verse eid="NUM 3:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 3:42" />याहवेहच्या आज्ञेप्रमाणे मोशेने इस्राएल लोकांच्या प्रथम जन्मलेल्या सर्वांची गणती केली. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />एक महिना व त्याहून अधिक वयाच्या प्रथम जन्मलेल्या पुरुषांची एकूण संख्या 22,273 होती.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />याहवेह मोशेला आणखी म्हणाले, <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“इस्राएली लोकांच्या सर्व प्रथम जन्मलेल्यांच्या ऐवजी लेवी लोकांना घे आणि त्यांच्या पशूंच्या ऐवजी लेव्यांचे पशू घ्यावे. लेवी लोक माझे असावेत. मीच याहवेह आहे. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />273 इस्राएली लोकांचे प्रथम जन्मलेले जे लेव्यांपेक्षा अधिक आहेत त्यांची खंडणी भरण्यासाठी, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />प्रत्येकामागे पवित्रस्थानाच्या शेकेलाप्रमाणे पाच शेकेल<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="ft" closed="false">अंदाजे 58 ग्रॅ.</char></note> घे; म्हणजेच वीस गेरा. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />आणि इस्राएली लोकांतील जे अधिक होते त्यांच्या खंडणीचे पैसे अहरोन आणि त्याच्या पुत्रांना द्यावे.”<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />मोशेने लेव्यांपेक्षा जे अधिक होते त्यांच्याकडून त्यांच्या खंडणीचे पैसे गोळा केले. <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />इस्राएली लोकांच्या प्रथम जन्मलेल्यांकडून त्याने पवित्रस्थानाच्या शेकेलनुसार 1,365<note caller="+" style="f"><char style="fr" closed="false">3:50 </char><char style="ft" closed="false">अंदाजे 16 कि.ग्रॅ.</char></note> गोळा केले. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />याहवेहच्या वचनाप्रमाणे झालेल्या आज्ञेनुसार मोशेने ते खंडणीचे पैसे अहरोन व त्याच्या पुत्रांना दिले.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">कोहाथी</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />याहवेह मोशेला आणि अहरोनाला म्हणाले: <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“लेवींच्या शाखेतील कोहाथी लोकांची त्यांच्या कुळांनुसार व घराण्यानुसार जनगणना करा. <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />म्हणजे सभामंडपाच्या कामाची सेवा करण्यास जे सर्व तीस ते पन्नास वर्षे वयाचे पुरुष आहेत, त्यांची गणती करावी.<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />“सभामंडपातील परमपवित्र वस्तूंची काळजी घेण्याचे काम कोहाथी लोकांचे आहे. <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />ज्यावेळी छावणी पुढे चालण्यास निघेल, त्यावेळी अहरोन आणि त्याच्या पुत्रांनी आत जाऊन आडपडदा खाली काढून तो कराराच्या नियमाच्या कोशावर ठेवावा. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />मग त्यांनी तो पडदा टिकाऊ चर्माने<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">तहशाची कातडी</char></note> झाकावा व त्यावर निळ्या रंगाचे कापड पसरावे आणि कोशाचे दांडे त्याच्या जागी बसवावे.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />“समक्षतेच्या मेजावर त्यांनी निळ्या रंगाचे कापड पसरावे आणि त्यावर बशा, ताट, वाट्या आणि पेयार्पणासाठी कलश ठेवावे; आणि निरंतरची अर्पणाची भाकर त्यावर असावी. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />त्यांनी त्यावर किरमिजी रंगाचे एक कापड पसरावे आणि त्यावर टिकाऊ चर्माचे आच्छादन घालावे व मेजाचे दांडे त्यांच्या जागी बसवावेत.<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />“यानंतर त्यांनी प्रकाश देणारा दीपस्तंभ व त्यावरील दिवे, वातीचे चिमटे व त्यांची तबके आणि जैतुनाच्या तेलाचे वाटप करण्यासाठी त्याचे सर्व कलश हे सर्व निळ्या कापडाने झाकावे. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />मग त्यांनी ती सगळी उपकरणे टिकाऊ चर्माच्या आच्छादनात गुंडाळून ते वाहून नेण्याच्या फळीवर ठेवावे.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />“मग त्यांनी सोन्याच्या वेदीवर निळे कापड पसरावे व ते टिकाऊ चर्माने झाकावे आणि वेदीचे दांडे त्यांच्या जागी बसवावेत.<verse eid="NUM 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 4:12" />“पवित्रस्थानाच्या सेवेसाठी वापरात आणली जाणारी सर्व पात्रे निळ्या कापडात गुंडाळावीत व त्यावर टिकाऊ चर्माचे आच्छादन घालावे आणि ती वाहून नेण्याच्या फळीवर ठेवावी.<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />“कास्य वेदीवरील सर्व राख काढावी आणि वेदी जांभळ्या रंगाच्या कापडाने झाकावी. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />मग वेदीच्या सेवेसाठी वापरात येणारी सर्व पात्रे म्हणजे अग्निपात्रे, मांसाचे काटे, फावडी आणि शिंपडण्याचे कटोरे त्यावर ठेवावे. मग त्यावर टिकाऊ चर्माचे आच्छादन घालावे आणि त्याचे दांडे त्यांच्या जागी बसवावेत.<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />“नंतर अहरोन आणि त्याच्या पुत्रांनी सर्व पवित्र साहित्य व पवित्र उपकरणे यावर आच्छादन घालण्याचे काम संपविल्यावर, जेव्हा छावणी पुढे जाण्यास सज्ज होईल, त्याचवेळी कोहाथी कुळाने ते वाहून नेण्यास पुढे यावे. परंतु त्यांनी पवित्र वस्तूंना स्पर्श करू नये, नाहीतर ते मरतील. कोहाथी लोकांनी सभामंडपातील वस्तू वाहून न्यावयाच्या आहेत.<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />“दिव्याचे तेल, सुगंधी धूप, रोजचे अन्नार्पण व अभिषेकाचे तेल, संपूर्ण निवासमंडप आणि त्यातील सर्व साहित्य, त्याचे पवित्र साहित्य व उपकरणे यांची जबाबदारी अहरोन याजकाचा पुत्र एलअज़ारकडे असावी.”<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />याहवेहने मोशे व अहरोन यांना म्हटले, <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“कोहाथी गोत्राच्या कुळाचा लेव्यांमधून नाश होऊ नये, <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />आणि ते जेव्हा परमपवित्र वस्तूंच्या जवळ येतात तेव्हा त्यांनी मरू नये पण जगावे म्हणून त्यांच्यासाठी असे करावे: अहरोन आणि त्याच्या पुत्रांनी पवित्रस्थानात जावे आणि प्रत्येकाने काय वाहून न्यावे हे त्यांना दाखवावे. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />परंतु कोहाथी लोकांनी पवित्र वस्तू पाहण्यासाठी एक क्षणभरही आत जाऊ नये. नाहीतर ते मरण पावतील.”<verse eid="NUM 4:20" /></para>
  <para style="s1">गेर्षोनी</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />याहवेह मोशेला म्हणाले, <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />गेर्षोनी लोकांची त्यांचे घराणे व कूळ यानुसार जनगणना करावी. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />म्हणजे सभामंडपाच्या कामाची सेवा करण्यास तीस ते पन्नास वर्षे वयाच्या सर्व पुरुषांची गणती करावी.<verse eid="NUM 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 4:24" />“वाहून नेणे व त्यांची इतर कामे करणे, ही गेर्षोनी कुळांची सेवा आहे: <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />त्यांनी निवासमंडपाचे पडदे, सभामंडप व त्याचे आच्छादन व त्याचे टिकाऊ चर्माचे बाहेरील आच्छादन, सभामंडपाच्या प्रवेशद्वाराचा पडदा वाहून न्यावा. <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />निवासमंडप आणि वेदीच्या सभोवतालच्या अंगणाचे पडदे, अंगणाच्या प्रवेशद्वाराचा पडदा, दोर्‍या आणि मंडपातील सेवा करण्यासाठी वापरलेली सर्व उपकरणे. या संबंधीच्या ज्यागोष्टी करण्याची गरज आहे, त्या गेर्षोनी लोकांनी कराव्‍यात. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />गेर्षोनी लोकांनी सर्व सेवा, वाहून नेण्यासंबंधी असो किंवा इतर कामे असो, ती अहरोन आणि त्याच्या पुत्रांच्या मार्गदर्शनाखाली पार पाडावी. त्यांनी जे काही वाहून न्यायचे आहे ते त्यांना त्यांची जबाबदारी म्हणून तू नेमून द्यावे. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />सभामंडपात गेर्षोनी कुळांनी करावयाची सेवा ती हीच आहे. त्यांची कर्तव्ये अहरोन याजकाचा मुलगा इथामार याच्या मार्गदर्शनाखाली असावीत.<verse eid="NUM 4:28" /></para>
  <para style="s1">मरारी कूळ</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />“मरारी लोकांची त्यांचे कूळ व घराणे यानुसार गणती करावी. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />म्हणजे सभामंडपाच्या कामाची सेवा करण्यास सर्व तीस ते पन्नास वर्षे वयाच्या पुरुषांची गणती करावी. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />सभामंडपातील त्यांच्या सेवेचा भाग म्हणून, त्यांनी निवासमंडपाच्या फळ्या, त्याची अडसरे, खांब आणि बैठका वाहून न्याव्या, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />त्याचप्रमाणे सभोवतालच्या अंगणाचे खांब, त्यांच्या बैठका, मेखा, दोर्‍या, त्याची सर्व उपकरणे आणि त्याच्या वापरासंबंधीचे सर्व साहित्य न्यावे. ज्या पुरुषाने जी ठराविक वस्तू वाहून न्यावयाची आहे ती त्याला नेमून द्यावी. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />अहरोन याजकाचा पुत्र इथामार याच्या मार्गदर्शनाखाली राहून सभामंडपात जी सेवा मरारी कुळांनी करावयाची आहे ती हीच आहे.”<verse eid="NUM 4:33" /></para>
  <para style="s1">लेव्यांच्या कुळांची गणती</para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 4:34" />मोशे, अहरोन आणि समुदायाच्या पुढार्‍यांनी कोहाथी लोकांची, त्यांचे कूळ व घराणे यानुसार गणती केली.<verse eid="NUM 4:34" /></para>
  <para style="li2">
    <verse number="35" style="v" sid="NUM 4:35" />सभामंडपाच्या कामाची सेवा करण्यास जे सर्व तीस ते पन्नास वर्षे वयाचे पुरुष आले होते, <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />त्यांची संख्या कुळांनुसार 2,750 होती. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />सभामंडपात सेवा करणार्‍या सर्व कोहाथी कुळाची ही एकूण संख्या होती. मोशेद्वारे याहवेहने आज्ञा दिल्यानुसार मोशे आणि अहरोनाने त्यांची गणती केली.<verse eid="NUM 4:37" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="38" style="v" sid="NUM 4:38" />गेर्षोनी लोकांची त्यांचे कूळ व घराणे यानुसार गणती केली.<verse eid="NUM 4:38" /></para>
  <para style="li2">
    <verse number="39" style="v" sid="NUM 4:39" />सभामंडपाच्या कामाची सेवा करण्यास सर्व तीस ते पन्नास वर्षे वयाचे पुरुष आले होते, <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />त्यांचे कूळ व घराणे यानुसार ते 2,630 होते. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />सभामंडपात सेवा करणार्‍या सर्व गेर्षोनी कुळाची ही एकूण संख्या होती. मोशेद्वारे याहवेहने आज्ञा दिल्यानुसार मोशे आणि अहरोनाने त्यांची गणती केली.<verse eid="NUM 4:41" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="42" style="v" sid="NUM 4:42" />मरारी लोकांची त्यांचे कूळ व घराणे यानुसार गणती केली.<verse eid="NUM 4:42" /></para>
  <para style="li2">
    <verse number="43" style="v" sid="NUM 4:43" />सभामंडपाच्या कामाची सेवा करण्यास जे सर्व तीस ते पन्नास वर्षे वयाचे पुरुष आले होते, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />त्यांच्या कुळानुसार ते 3,200 गणले गेले. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />सभामंडपात सेवा करणार्‍या सर्व मरारी कुळाची ही एकूण संख्या होती. मोशेद्वारे याहवेहने आज्ञा दिल्यानुसार मोशे आणि अहरोनाने त्यांची गणती केली.<verse eid="NUM 4:45" /></para>
  <para style="b" />
  <para style="lf">
    <verse number="46" style="v" sid="NUM 4:46" />मोशे, अहरोन आणि इस्राएलच्या पुढार्‍यांनी सर्व लेवींची, त्यांचे कूळ व घराणे यानुसार गणती केली. <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />सभामंडपाच्या कामाची सेवा करण्यास सर्व तीस ते पन्नास वर्षे वयाचे पुरुष आले होते, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />त्यांची संख्या 8,580 भरली. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />याहवेहने मोशेद्वारे आज्ञा दिल्याप्रमाणे प्रत्येकाला आपले काम व त्यांनी काय वाहून न्यावे हे नेमून देण्यात आले.</para>
  <para style="b" vid="NUM 4:49" />
  <para style="p" vid="NUM 4:49">अशाप्रकारे याहवेहने दिलेल्या आज्ञेप्रमाणे प्रत्येकाची गणती करण्यात आली.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">छावणीची शुद्धता</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />याहवेहने मोशेला म्हटले, <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />इस्राएली लोकांना आज्ञा दे की, ज्यांना चर्मरोग<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">कातडीच्या वेगवेगळ्या आजारांसाठी हा शब्द वापरला जात असे.</char></note> आहे किंवा कोणत्याही प्रकारचा स्राव आहे किंवा जो मृतदेहाच्या विधीमुळे अशुद्ध झाला आहे, त्यांना छावणीबाहेर पाठवून द्यावे. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />मग ते स्त्री असो किंवा पुरुष; त्यांना बाहेर पाठवावे. ज्या छावणीत मी तुमच्यामध्ये राहतो, ती त्यांच्यामुळे भ्रष्ट होऊ नये, म्हणून त्यांना बाहेर पाठवावे. <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />त्याप्रमाणे इस्राएली लोकांनी केले; त्यांनी त्यांना छावणीबाहेर पाठविले. याहवेहने मोशेला सूचना दिली होती तसेच त्यांनी केले.<verse eid="NUM 5:4" /></para>
  <para style="s1">अपराधाबद्दल भरपाई</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />याहवेह मोशेला म्हणाले, <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“इस्राएली लोकांस सांग, ‘जेव्हा कोणी पुरुष किंवा स्त्री एखाद्याविरुद्ध कोणताही अपराध करेल, तो याहवेहच्या विरुद्ध विश्वासघात असून तो दोषी आहे. <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />त्यांनी केलेले पाप कबूल करावे. त्यांनी केलेल्या पापाची पूर्ण भरपाई करून द्यावी, त्यात त्याचा पाचवा भाग मिळवून ज्या व्यक्तीविरुद्ध पाप केला आहे त्याला द्यावा. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />परंतु पापाची भरपाई करण्यासाठी त्या व्यक्तीचा कोणीही जवळचा नातेवाईक नसेल तर ती भरपाई याहवेहची असावी आणि पापासाठी प्रायश्चित करण्याच्या मेंढ्यासह ती याजकाकडे द्यावी. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />सर्व पवित्र भेटी, ज्या इस्राएली लोक याजकाकडे आणतात त्या याजकाच्या व्हाव्या. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />पवित्र वस्तू त्यांच्या मालकाच्या आहेत, परंतु ते जे याजकाला देतात, ते याजकाच्या मालकीचे होईल.’ ”<verse eid="NUM 5:10" /></para>
  <para style="s1">अविश्वासू पत्नीसाठी परीक्षा</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />मग याहवेह मोशेला म्हणाले, <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“इस्राएली लोकांशी बोल आणि त्यांना सांग: जर एखाद्या मनुष्याच्या पत्नीचे वाकडे पाऊल पडले आणि ती त्याच्याशी अविश्वासूपणे वागली, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />जेणेकरून दुसर्‍या पुरुषाचे तिच्याशी लैंगिक संबंध असले आणि हे तिच्या पतीपासून गुपित असेल आणि तिची अशुद्धता उघडकीस आली नाही (कारण तिच्याविरुद्ध कोणीही साक्षीदार नाही आणि ती त्या कृत्यात पकडली गेली नाही), <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />आणि जर तिच्या पतीला मत्सराची भावना झाली आणि तो आपल्या पत्नीवर संशय घेतो की ती अशुद्ध आहे—किंवा त्याच्या मनात मत्सराची भावना निर्माण झाली आणि ती जरी अशुद्ध नसली तरीही तो संशय घेतो— <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />तर त्याने आपल्या पत्नीला याजकाकडे न्यावे. त्याने तिच्या वतीने सोबत एक एफाचा दहावा भाग<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">अंदाजे 1.6 कि.ग्रॅ.</char></note> जवाचे पीठ आणावे. त्याने त्यावर जैतुनाचे तेल ओतू नये किंवा त्यावर धूप ठेवू नये, कारण हे मत्सरासाठी केलेले अन्नार्पण आहे, अपराधाची आठवण देणारे स्मरणाचे अर्पण आहे.<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />“ ‘याजकाने त्या स्त्रीला आणावे आणि तिला याहवेहसमोर उभे करावे. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />मग याजकाने मातीच्या पात्रात पवित्र पाणी घ्यावे आणि निवासमंडपाच्या भूमीवरील थोडी धूळ घेऊन त्या पाण्यात टाकावी. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />नंतर याजकाने तिला याहवेहपुढे उभे केल्यानंतर, त्याने तिचे केस मोकळे सोडावे आणि तिच्या स्मरणाचे अर्पण, मत्सरासाठी केलेले अन्नार्पण तिच्या हातावर ठेवावे व त्याने शाप आणणारे कडू पाणी आपल्या हाती घ्यावे. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />मग याजकाने त्या स्त्रीला शपथ घालून म्हणावे, “जर कोणी पुरुषाने तुझ्याशी लैंगिक संबंध ठेवलेले नाहीत आणि तू आपल्या पतीशी विवाहित असताना निर्दोष असून वाकडे पाऊल टाकले नाही, तर या कडू पाण्यापासून मिळणारा शाप तुला अपाय न करो. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />परंतु जर तू तुझ्या पतीशी विवाहित असतानाही वाकडे पाऊल टाकले आहे आणि आपल्या पती व्यतिरिक्त इतर पुरुषाशी लैंगिक संबंध ठेवून स्वतःला भ्रष्ट केले आहेस— <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />यावेळी याजकाने त्या स्त्रीस शपथ देऊन या शापाखाली आणावे—जेव्हा याहवेह तुझ्या उदराचा गर्भपात करेल आणि तुझे पोट फुगेल, तेव्हा याहवेह तुला तुझ्या लोकांमध्ये शापित करो. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />शाप देणारे हे पाणी तुझ्या शरीरात जावो, म्हणजे तुझे पोट फुगेल किंवा तुझा गर्भपात होईल.”</para>
  <para style="p" vid="NUM 5:22">“ ‘मग त्या स्त्रीने म्हणावे, “आमेन. असेच होवो.”<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />“ ‘तेव्हा याजकाने हे शापाचे शब्द एका गुंडाळीवर लिहून ते शब्द त्या कडू पाण्यात धुवावे. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />ज्या पाण्यापासून शाप येईल ते कडू पाणी त्याने तिला प्यायला द्यावे आणि हे पाणी जे शाप व कडवट कष्ट आणते ते तिच्यात प्रवेश करेल. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />याजकाने ते मत्सराचे अन्नार्पण त्या स्त्रीच्या हातातून घ्यावे व याहवेहस ओवाळत ते वेदीकडे आणावे. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />त्या अन्नार्पणाचे प्रतीक म्हणून याजकाने त्या अर्पणातील मूठभर अन्न घेऊन ते वेदीवर जाळावे; व त्यानंतर त्याने ते पाणी त्या स्त्रीला प्यायला द्यावे. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />जर ती आपल्या पतीशी अविश्वासू राहून तिने स्वतःला भ्रष्ट केले असेल, तर त्याचा परिणाम असा असेल: जेव्हा तिला ते शाप आणि कडवट कष्ट आणणारे पाणी पाजले जाईल, ते तिच्या शरीरात जाईल, तिचे पोट फुगेल आणि तिचे उदर गर्भपात करेल आणि ती शापित होईल. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />पण त्या स्त्रीने जर स्वतःला भ्रष्ट केलेले नाही आणि ती शुद्ध असेल, तर ती निर्दोष ठरविली जाईल आणि तिला मुलेबाळे होतील.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />“ ‘जेव्हा एखादी स्त्री तिच्या पतीशी विवाहित असतानाही स्वतःला भ्रष्ट करते तेव्हा हा मत्सराचा नियम असावा, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />किंवा जेव्हा एखाद्या पुरुषाच्या मनात मत्सराची भावना येते, कारण तो आपल्या पत्नीवर संशय घेतो, याजकाने तिला याहवेहसमोर उभे करावे आणि हा संपूर्ण नियम तिला लागू करावा. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />तिचा पती कोणत्याही अन्यायापासून निर्दोष असेल, परंतु ती स्त्री आपल्या पापाचे परिणाम भोगेल.’ ”<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">नाजीरासंबंधी नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />मग याहवेह मोशेला म्हणाले, <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“इस्राएली लोकांशी बोल व त्यांना सांग: एखादा पुरुष किंवा स्त्री याहवेहला समर्पित नाजीर होण्याचा एक विशेष नवस करू इच्छितात, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />तर त्या नाजीरांनी द्राक्षारस व इतर आंबलेले पेय वर्ज्य करावे आणि त्यांनी द्राक्षारसाचा शिरका किंवा इतर आंबलेले पेय पिऊ नये. त्यांनी द्राक्षाचा रस पिऊ नये किंवा द्राक्षे किंवा मनुकेही खाऊ नयेत. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />जोपर्यंत ते नाजीराच्या नवसाखाली असतील, तोपर्यंत त्यांनी द्राक्षवेलीचा कोणताही उपज, साल व बीज सुद्धा खाऊ नये.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />“ ‘नाजीरपणाच्या संपूर्ण काळात त्यांच्या डोक्यावर वस्तरा फिरवू नये. त्यांनी याहवेहला समर्पित केलेला नवसाच्या काळ संपेपर्यंत त्यांनी पवित्र असावे; त्यांनी आपले केस लांब वाढू द्यावेत.<verse eid="NUM 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6" />“ ‘याहवेहला समर्पित केलेल्या त्यांच्या संपूर्ण कालावधीत, नाजीराने मृतदेहाजवळ जाऊ नये. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />त्यांचे स्वतःचे वडील किंवा आई किंवा भाऊ किंवा बहीण जरी मरण पावले, तरीही त्यांच्यामुळे त्यांनी स्वतःला विधिपूर्वक अशुद्ध करू नये, कारण परमेश्वराला समर्पित केल्याचे प्रतीक त्यांच्या डोक्यावर आहे. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />समर्पित केलेल्या त्यांच्या संपूर्ण कालावधीत ते याहवेहसाठी पवित्र आहेत.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />“ ‘जर नाजीराच्या समक्षतेत कोणी अचानक मरण पावला, तर त्यांच्या डोक्यावरील केस, समर्पणाचे प्रतीक विटाळले जाते, त्यावेळी सातव्या दिवशी; शुद्धीकरणाच्या दिवशी त्यांनी आपले मुंडण करावे. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />मग आठव्या दिवशी त्यांनी दोन कबुतरे किंवा पारव्यांची दोन पिल्ले सभामंडपाच्या दाराशी याजकाकडे आणावी. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />मग नाजीरासाठी याजकाने त्यापैकी एक पापार्पण व दुसरा होमार्पणाचे प्रायश्चित म्हणून अर्पण करावा, कारण मृतदेहाच्या समक्षतेत राहून त्यांनी पाप केले. त्याच दिवशी त्यांनी पुन्हा आपले डोके पवित्र करावे. <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />आणि त्यांनी आपला नाजीरपणाचा काळ याहवेहसाठी पुनर्समर्पित करावा आणि दोषार्पण म्हणून एक वर्षाचा कोकरा आणावा. आधीचे दिवस मोजले जाणार नाही, कारण त्यांच्या समर्पित असलेल्या काळात ते विटाळले गेले.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />“ ‘आणि त्यांचा समर्पणाचा काळ संपल्यानंतर नाजीरांसाठी हा नियम असावा. त्यांना सभामंडपाच्या दाराशी आणावे, <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />त्या ठिकाणी त्यांनी याहवेहसाठी ही अर्पणे सादर करावी: होमार्पणासाठी एक वर्षाचा निर्दोष कोकरा व पापार्पणासाठी मेंढी आणावी व शांत्यर्पणाच्या अर्पणासाठी निर्दोष गोर्‍हा आणावा. <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />त्याबरोबर त्यांचे अन्नार्पण व पेयार्पण आणि एक टोपलीभर सपिठाची आणि बेखमीर भाकरी—जैतुनाच्या तेलात मळलेल्या जाड भाकरी व जैतुनाचे तेल लावलेल्या पातळ भाकरी आणाव्या.<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />“ ‘याजकाने ही अर्पणे याहवेहसमोर सादर करून पापार्पण व होमार्पण करावे. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />याजकाने बेखमीर भाकरीची टोपली सादर करावी व अन्नार्पण व पेयार्पण याबरोबर याहवेहसाठी शांत्यर्पण म्हणून गोर्‍हाचा यज्ञ करावा.<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />“ ‘मग नाजीराने आपल्या डोक्यावरील केस जे त्यांच्या समर्पणाचे प्रतीक आहे, ते सभामंडपाच्या दारात मुंडवावे. मग ते केस घेऊन त्यांनी शांत्यर्पणाखाली असलेल्या अग्नीत टाकावे.<verse eid="NUM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19" />“ ‘नाजीराने आपल्या डोक्यावरील केस जे त्यांच्या समर्पणाचे प्रतीक आहे ते मुंडण केल्यानंतर, याजकाने त्यांच्या हातात गोर्‍हाचा उकळलेला खांद्याचा भाग व खमीर न घालता बनविलेल्या दोन्ही, एक जाड व एक पातळ भाकर ठेवावी. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />नंतर याजकाने ते हेलावणीचे अर्पण म्हणून याहवेहपुढे ओवाळावे; ते पवित्र आहे; त्याचबरोबर ओवाळलेला उराचा भाग आणि सादर केलेला मांडीचा भाग याजकासाठी असावा. यानंतर नाजीर द्राक्षारस पिऊ शकतो.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />“ ‘हा नाजीराचा नियम आहे, जे आपल्या समर्पणानुसार याहवेहला अर्पण करण्याचा नवस करतात, त्या खेरीज त्यांना परवडेल त्यानुसार आणावे. नाजीराच्या नियमानुसार केलेले नवस त्यांनी पूर्ण केले पाहिजे.’ ”<verse eid="NUM 6:21" /></para>
  <para style="s1">याजकीय आशीर्वाद</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />याहवेह मोशेला म्हणाले, <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />अहरोन आणि त्याच्या पुत्रांना सांग, “तुम्ही इस्राएली लोकांस आशीर्वाद देतांना असे म्हणावे:<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />“ ‘ “याहवेह तुम्हाला आशीर्वाद देवो</para>
  <para style="q2" vid="NUM 6:24">आणि तुमचे संरक्षण करो;<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />याहवेह आपला मुखप्रकाश तुमच्यावर पाडो</para>
  <para style="q2" vid="NUM 6:25">आणि तुमच्यावर कृपा करो;<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />याहवेह आपले मुख तुमच्याकडे लावो,</para>
  <para style="q2" vid="NUM 6:26">आणि तुम्हाला शांती देवो.” ’<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />“अशा रीतीने ते माझे नाव इस्राएली लोकांना ठेवतील आणि मी त्यांना आशीर्वादित करेन.”<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">निवासमंडपाच्या समर्पणाच्या वेळी दिलेली अर्पणे</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />जेव्हा मोशेने निवासमंडप उभारण्याचे काम संपविले, तेव्हा त्याने निवासमंडप व त्यातील सामानावर अभिषेक केला व ते पवित्र केले. त्याने वेदी व त्याची सर्व पात्रे सुद्धा अभिषिक्त करून ती पवित्र केली. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />मग इस्राएलचे पुढारी, घराण्यांचे प्रमुख जे त्यांच्या गोत्राचे पुढारी होते, ज्यांची मोजणी करण्यात आली होती, त्यांच्यावर जे देखरेख करणारे होते, त्यांनी अर्पणे आणली. <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />त्यांनी याहवेहपुढे भेटी म्हणून आणले ते हे—आच्छादन असलेल्या सहा गाड्या व बारा बैल; प्रत्येक पुढार्‍यामागे एक बैल आणि दोन पुढार्‍यांमागे एक गाडी. हे सर्व त्यांनी निवासमंडपासमोर सादर केले.<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />याहवेहने मोशेला म्हटले, <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“तू त्यांच्याकडून ते स्वीकार आणि त्यांचा उपयोग सभामंडपाच्या कामासाठी करावा. जसे प्रत्येक व्यक्तीच्या कामास लागेल तसे ते लेव्यांच्या हाती दे.”<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />तेव्हा मोशेने त्या गाड्या आणि ते बैल घेतले व लेव्यांना दिले. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />गेर्षोन कुळाला त्यांच्या कामाच्या गरजेनुसार त्याने दोन गाड्या व चार बैल दिले. <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />आणि त्याने मरारी कुळाला त्यांच्या कामाच्या गरजेनुसार चार गाड्या व आठ बैल दिले. ते सर्व अहरोन याजकाचा पुत्र इथामार याच्या नेतृत्वाखाली होते. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />कोहाथी कुळाला मात्र मोशेने काहीही दिले नाही, कारण पवित्र वस्तू आपल्या खांद्यांवर वाहून नेण्याच्या सेवेसाठी ते जबाबदार होते.<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />जेव्हा वेदीचा अभिषेक करण्यात आला, पुढार्‍यांनीही तिच्या समर्पणाची अर्पणे आणली व ती वेदीपुढे सादर केली. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />कारण याहवेहने मोशेला सांगितले होते, “प्रत्येक दिवशी एका पुढार्‍याने वेदीच्या समर्पणासाठी अर्पणे आणावी.”<verse eid="NUM 7:11" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="12" style="v" sid="NUM 7:12" />पहिल्या दिवशी ज्याने अर्पणे आणली तो यहूदाह गोत्रातील अम्मीनादाबाचा पुत्र नहशोन होता.<verse eid="NUM 7:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 7:13" />त्याचे अर्पण हे:</para>
  <para style="li2" vid="NUM 7:13">पवित्रस्थानाच्या शेकेलानुसार एकशे तीस शेकेल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">अंदाजे 1.5 कि.ग्रॅ.</char></note> वजनाचे एक चांदीचे ताट आणि सत्तर शेकेल<note caller="+" style="f"><char style="fr" closed="false">7:13 </char><char style="ft" closed="false">अंदाजे 800 ग्रॅ.</char></note> वजनाचे शिंपडण्याचे चांदीचे भांडे, ही दोन्ही अन्नार्पण म्हणून जैतुनाच्या तेलात मळलेल्या सपिठाने भरली होती;<verse eid="NUM 7:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="NUM 7:14" />दहा शेकेल<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">अंदाजे 115 ग्रॅ.</char></note> वजनाचे धूपाने भरलेले एक सोन्याचे धूपपात्र.<verse eid="NUM 7:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="NUM 7:15" />होमार्पणासाठी एक तरुण बैल, एक गोर्‍हा आणि एक वर्षांचा कोकरा;<verse eid="NUM 7:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="NUM 7:16" />पापार्पणासाठी एक बोकड;<verse eid="NUM 7:16" /></para>
  <para style="li2">
    <verse number="17" style="v" sid="NUM 7:17" />आणि शांत्यर्पणासाठी दोन बैल, पाच गोर्‍हे, पाच बोकडे आणि एक वर्षाची पाच नरकोकरे.</para>
  <para style="lf" vid="NUM 7:17">ही अम्मीनादाबाचा पुत्र नहशोनाची अर्पणे होती.<verse eid="NUM 7:17" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="18" style="v" sid="NUM 7:18" />दुसर्‍या दिवशी इस्साखार वंशाचा प्रमुख सूवाराचा पुत्र नथानेलाने आपली अर्पणे आणली.<verse eid="NUM 7:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="NUM 7:19" />त्याचे अर्पण हे:</para>
  <para style="li2" vid="NUM 7:19">पवित्रस्थानाच्या शेकेलानुसार एकशे तीस शेकेल वजनाचे एक चांदीचे ताट आणि सत्तर शेकेल वजनाचे शिंपडण्याचे चांदीचे भांडे, ही दोन्ही अन्नार्पण म्हणून जैतुनाच्या तेलात मळलेल्या सपिठाने भरली होती;<verse eid="NUM 7:19" /></para>
  <para style="li2">
    <verse number="20" style="v" sid="NUM 7:20" />दहा शेकेल वजनाचे धूपाने भरलेले एक सोन्याचे धूपपात्र;<verse eid="NUM 7:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="NUM 7:21" />होमार्पणासाठी एक तरुण बैल, एक गोर्‍हा आणि एक वर्षाचा कोकरा;<verse eid="NUM 7:21" /></para>
  <para style="li2">
    <verse number="22" style="v" sid="NUM 7:22" />पापार्पणासाठी एक बोकड;<verse eid="NUM 7:22" /></para>
  <para style="li2">
    <verse number="23" style="v" sid="NUM 7:23" />आणि शांत्यर्पणासाठी दोन बैल, पाच गोर्‍हे, पाच बोकडे आणि एक वर्षाची पाच नरकोकरे.</para>
  <para style="lf" vid="NUM 7:23">सूवाराचा पुत्र नथानेलाचे हे अर्पण होते.<verse eid="NUM 7:23" /></para>
  <para style="b" />
  <para style="lh">
