<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Marathi Contemporary Version</book>
  
  <para style="h">मीखाह</para>
  <para style="toc1">मीखाहाची भविष्यवाणी</para>
  <para style="toc2">मीखाह</para>
  <para style="toc3">मीखा</para>
  <para style="mt1">मीखाहाची भविष्यवाणी</para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />यहूदीयाचे राजे योथाम, आहाज आणि हिज्कीयाहच्या कारकिर्दीत, मोरेशेथचा रहिवासी मीखाहला याहवेहचा संदेश आला—त्याने शोमरोन आणि यरुशलेमबद्दल दृष्टान्तात पाहिला.<verse eid="MIC 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2" />सर्व लोकहो, तुम्ही सर्वजण, ऐका,</para>
  <para style="q2" vid="MIC 1:2">पृथ्वी आणि जे सर्व त्यामध्ये राहतात, लक्ष द्या,</para>
  <para style="q1" vid="MIC 1:2">सार्वभौम याहवेह परमेश्वर, त्यांच्या पवित्र मंदिरातून,</para>
  <para style="q2" vid="MIC 1:2">तुमच्याविरुद्ध साक्ष देतील.<verse eid="MIC 1:2" /></para>
  <para style="s1">शोमरोन आणि यरुशलेमविरुद्ध न्याय</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3" />पाहा! याहवेह त्यांच्या निवासस्थानातून बाहेर पडत आहेत.</para>
  <para style="q2" vid="MIC 1:3">ते खाली उतरतात आणि पृथ्वीच्या उंच जागा तुडवितात.<verse eid="MIC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4" />त्यांच्या पायाखाली पर्वत वितळतात</para>
  <para style="q2" vid="MIC 1:4">जसे अग्नीपुढे मेण,</para>
  <para style="q1" vid="MIC 1:4">जसे पाणी उतारावरून खाली येते,</para>
  <para style="q2" vid="MIC 1:4">तशा दऱ्या दुभंगतात.<verse eid="MIC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5" />हे सर्व याकोबाच्या अपराधामुळे</para>
  <para style="q2" vid="MIC 1:5">आणि इस्राएली लोकांच्या पापाचे परिणाम आहे.</para>
  <para style="q1" vid="MIC 1:5">याकोबाचा अपराध काय आहे?</para>
  <para style="q2" vid="MIC 1:5">ते शोमरोन आहे की नाही?</para>
  <para style="q1" vid="MIC 1:5">यहूदीयाचे उच्च स्थान कोणते आहे?</para>
  <para style="q2" vid="MIC 1:5">ते यरुशलेम नाही की नाही?<verse eid="MIC 1:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6" />“म्हणून मी शोमरोनला मातीचा ढिगारा,</para>
  <para style="q2" vid="MIC 1:6">द्राक्षमळे लावण्याची जागा करेन.</para>
  <para style="q1" vid="MIC 1:6">मी तिचे दगड खोऱ्यात टाकेन</para>
  <para style="q2" vid="MIC 1:6">आणि तिचा पाया उघडा करेन.<verse eid="MIC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7" />तिच्या सर्व मूर्ती फोडून तुकडे करण्यात येतील;</para>
  <para style="q2" vid="MIC 1:7">तिच्या मंदिरातील सर्व भेटवस्तू अग्नीत भस्म होतील;</para>
  <para style="q2" vid="MIC 1:7">मी तिच्या सर्व प्रतिमा नष्ट करेन.</para>
  <para style="q1" vid="MIC 1:7">कारण तिने आपल्या भेटवस्तू वेश्याव्यवसाय करून मिळवल्या आहेत,</para>
  <para style="q2" vid="MIC 1:7">आणि त्या पुन्हा वेश्यावृत्तीची मजुरी म्हणून वापरली जाईल.”<verse eid="MIC 1:7" /></para>
  <para style="s1">शोक व आक्रंदन</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8" />म्हणून मी शोक व आक्रंदन करेन;</para>
  <para style="q2" vid="MIC 1:8">मी अनवाणी व वस्त्रहीन फिरेन.</para>
  <para style="q1" vid="MIC 1:8">कोल्ह्यासारखा मी आक्रोश करेन;</para>
  <para style="q2" vid="MIC 1:8">आणि घुबडाप्रमाणे विव्हळेन.<verse eid="MIC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9" />कारण शोमरोनची पीडा असाध्य आहे;</para>
  <para style="q2" vid="MIC 1:9">ती यहूदीयामध्ये पसरली आहे.</para>
  <para style="q1" vid="MIC 1:9">ती माझ्या लोकांच्या वेशीपर्यंत पोहोचली आहे,</para>
  <para style="q2" vid="MIC 1:9">ती यरुशलेमपर्यंतही पोहोचली आहे.<verse eid="MIC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10" />गथ<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">गथ </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">सांगणे</char></note> मध्ये ही बातमी देऊ नका;</para>
  <para style="q2" vid="MIC 1:10">अजिबात रडू नका.</para>
  <para style="q1" vid="MIC 1:10">बेथ‑ले‑अफ्राह<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">धुळीचे घर</char></note> मध्ये जाऊन</para>
  <para style="q2" vid="MIC 1:10">धुळीत लोळ.<verse eid="MIC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11" />शाफीर<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">शाफीर </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">आनंददायी</char></note> मध्ये राहणारे तुम्ही</para>
  <para style="q2" vid="MIC 1:11">वस्त्रहीन आणि निर्लज्जपणे निघून जा.</para>
  <para style="q1" vid="MIC 1:11">जे झानन<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">झानन </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">बाहेर या</char></note> मध्ये राहतात</para>
  <para style="q2" vid="MIC 1:11">ते बाहेर जाणार नाहीत.</para>
  <para style="q1" vid="MIC 1:11">बेथ‑एसल विलाप करीत आहे;</para>
  <para style="q2" vid="MIC 1:11">ते तुम्हाला यापुढे संरक्षण देऊ शकत नाही.<verse eid="MIC 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12" />मारोथ<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">मारोथ </char><char style="ft" closed="false">अर्थात् </char><char style="fqa" closed="false">कडू</char></note> मध्ये राहणारे लोक वेदनांनी रडत आहेत,</para>
  <para style="q2" vid="MIC 1:12">आणि मदतीची वाट पाहत आहेत,</para>
  <para style="q1" vid="MIC 1:12">कारण यरुशलेमच्या प्रवेशद्वारापर्यंत पीडा</para>
  <para style="q2" vid="MIC 1:12">याहवेहने पाठविलेली आहे.<verse eid="MIC 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13" />लाखीशमध्ये राहणार्‍यांनो,</para>
  <para style="q2" vid="MIC 1:13">वेगवान घोडे रथाला जुंपा.</para>
  <para style="q1" vid="MIC 1:13">तुझ्यापासून सीयोनच्या कन्येचे पाप सुरू झाले,</para>
  <para style="q2" vid="MIC 1:13">कारण तुझ्यामध्ये इस्राएलचे अपराध आढळून आले.<verse eid="MIC 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14" />त्यामुळे तू मोरेशेथ-गथला</para>
  <para style="q2" vid="MIC 1:14">निरोपाची भेट देशील.</para>
  <para style="q1" vid="MIC 1:14">अकजीब<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">अकजीब </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">फसवणूक</char></note> चे रहिवासी</para>
  <para style="q2" vid="MIC 1:14">इस्राएलच्या राजांना फसविणारी ठरतील.<verse eid="MIC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15" />मारेशाहच्या रहिवाशांनो,</para>
  <para style="q2" vid="MIC 1:15">मी तुमच्यावर विजय मिळविणारा पाठवेन.</para>
  <para style="q1" vid="MIC 1:15">इस्राएलचे प्रतिष्ठित लोक</para>
  <para style="q2" vid="MIC 1:15">अदुल्लामला पळून जातील.<verse eid="MIC 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16" />ज्या मुलांमध्ये तुम्ही आनंदी आहात</para>
  <para style="q2" vid="MIC 1:16">त्यांच्यासाठी शोक करताना आपले डोके मुंडण करा;</para>
  <para style="q1" vid="MIC 1:16">गिधाडासारखे तुमच्या डोक्याचे मुंडण करा,</para>
  <para style="q2" vid="MIC 1:16">कारण ते तुमच्यापासून गुलाम म्हणून जातील.<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s1">मानवी योजना आणि परमेश्वराच्या योजना</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1" />जे वाईट कृत्याची योजना करतात,</para>
  <para style="q2" vid="MIC 2:1">जे आपल्या अंथरुणावर कट रचतात, त्यांचा धिक्कार असो!</para>
  <para style="q1" vid="MIC 2:1">पहाट होताच ते त्यांचा कट पूर्ण करतात</para>
  <para style="q2" vid="MIC 2:1">कारण हे सामर्थ्य त्यांच्या हातात असते.<verse eid="MIC 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2" />ते लोभीपणाने इतरांची शेते बळकावतात,</para>
  <para style="q2" vid="MIC 2:2">दुसऱ्यांची घरेही हिसकावून घेतात.</para>
  <para style="q1" vid="MIC 2:2">ते कपटाने लोकांची घरे बळकावतात</para>
  <para style="q2" vid="MIC 2:2">आणि त्यांच्या पूर्वजांची संपत्ती लुटतात.<verse eid="MIC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3" />म्हणून याहवेह म्हणतात:</para>
  <para style="q1" vid="MIC 2:3">“मी या लोकांविरुद्ध विपत्ती योजत आहे,</para>
  <para style="q2" vid="MIC 2:3">ज्यापासून तुम्ही स्वतःला वाचवू शकत नाही.</para>
  <para style="q1" vid="MIC 2:3">तुम्ही पुन्हा कधीही गर्वाने चालणार नाही,</para>
  <para style="q2" vid="MIC 2:3">कारण तो आपत्तीचा काळ असेल.<verse eid="MIC 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4" />त्या दिवशी लोकांकरिता तुम्ही चेष्टेचा विषय व्हाल;</para>
  <para style="q2" vid="MIC 2:4">ते तुम्हाला या विलाप गीताने टोमणे मारतील:</para>
  <para style="q1" vid="MIC 2:4">‘आमचा संपूर्ण नाश झाला आहे;</para>
  <para style="q2" vid="MIC 2:4">माझ्या लोकांच्या मालमत्तेची विभागणी झाली आहे.</para>
  <para style="q1" vid="MIC 2:4">ते ती माझ्यापासून काढून घेतात!</para>
  <para style="q2" vid="MIC 2:4">ते आमची शेते बंडखोरांना देतात.’ ”<verse eid="MIC 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5" />म्हणून याहवेहच्या सभेत चिठ्ठ्या टाकून</para>
  <para style="q2" vid="MIC 2:5">सूत्राने जमिनीची वाटणी करण्यास तुमच्याकडे कोणी राहणार नाही.<verse eid="MIC 2:5" /></para>
  <para style="s1">खोटे संदेष्टे</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6" />त्यांचे संदेष्टे म्हणतात, “संदेश देऊ नका,</para>
  <para style="q2" vid="MIC 2:6">या गोष्टींबद्दल संदेश देऊ नका;</para>
  <para style="q2" vid="MIC 2:6">आमच्यावर अप्रतिष्ठा येणार नाही.”<verse eid="MIC 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7" />हे याकोबाच्या घराण्या, “असे म्हटले जावे काय,</para>
  <para style="q2" vid="MIC 2:7">याहवेह<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">याहवेह </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">याहवेहचा आत्मा</char></note> अधीर होतात काय?</para>
  <para style="q2" vid="MIC 2:7">ते अशी कामे करतात काय?</para>
  <para style="b" vid="MIC 2:7" />
  <para style="q1" vid="MIC 2:7">“ज्याचे मार्ग सरळ आहेत त्याचे</para>
  <para style="q2" vid="MIC 2:7">माझे शब्द भले करत नाहीत काय?<verse eid="MIC 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8" />अलीकडे माझे लोक</para>
  <para style="q2" vid="MIC 2:8">शत्रूसारखे उठले आहेत.</para>
  <para style="q1" vid="MIC 2:8">जे लोक निष्काळजीपणे जवळून जातात</para>
  <para style="q2" vid="MIC 2:8">त्यांचे किमती कपडे तुम्ही काढून घेता,</para>
  <para style="q2" vid="MIC 2:8">जसे युद्धातून परत येणारे पुरुष करतात.<verse eid="MIC 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9" />तुम्ही माझ्या लोकांच्या स्त्रियांना</para>
  <para style="q2" vid="MIC 2:9">त्यांच्या सुखी घरातून हाकलून देतात.</para>
  <para style="q1" vid="MIC 2:9">तुम्ही त्यांच्या मुलांकडून</para>
  <para style="q2" vid="MIC 2:9">माझे आशीर्वाद कायमचे हिरावून घेता.<verse eid="MIC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10" />उठा, चालते व्हा!</para>
  <para style="q2" vid="MIC 2:10">कारण हे तुमचे विश्रांतिस्थान नाही,</para>
  <para style="q1" vid="MIC 2:10">कारण हे अशुद्ध झाले आहे,</para>
  <para style="q2" vid="MIC 2:10">सर्व उपायांच्या पलीकडे, ते उद्ध्वस्त झाले आहे.<verse eid="MIC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11" />जर एखादा लबाड आणि फसवणूक करणारा येऊन म्हणाला,</para>
  <para style="q2" vid="MIC 2:11">‘मी तुम्हाला भरपूर द्राक्षारस व मद्याची भविष्यवाणी करेन,’</para>
  <para style="q2" vid="MIC 2:11">तर अशीच व्यक्ती या लोकांसाठी योग्य संदेष्टा होईल!<verse eid="MIC 2:11" /></para>
  <para style="s1">सुटकेचे अभिवचन</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12" />“हे याकोबा, मी तुम्हा सर्वांना निश्चित गोळा करेन;</para>
  <para style="q2" vid="MIC 2:12">इस्राएलच्या उरलेल्यांना मी खचित गोळा करेन.</para>
  <para style="q1" vid="MIC 2:12">जसे मेंढवाड्यात मेंढरे,</para>
  <para style="q2" vid="MIC 2:12">जसे कुरणात कळप, तसे मी त्यांना एकत्र गोळा करेन;</para>
  <para style="q2" vid="MIC 2:12">आणि ती जागा लोकांनी फुलून जाईल.<verse eid="MIC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13" />जे कुंपण तोडून मार्ग उघडणारे त्यांच्या पुढे जातील;</para>
  <para style="q2" vid="MIC 2:13">ते द्वार तोडून त्यातून बाहेर जातील.</para>
  <para style="q1" vid="MIC 2:13">त्यांचा राजा त्यांच्या पुढे जाईल,</para>
  <para style="q2" vid="MIC 2:13">याहवेह त्यांचे पुढारी असतील.”<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s1">पुढारी आणि संदेष्टे यांना फटकारणे</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />तेव्हा मी म्हणालो,</para>
  <para style="q1" vid="MIC 3:1">याकोबाच्या पुढार्‍यांनो,</para>
  <para style="q2" vid="MIC 3:1">इस्राएलाच्या अधिकाऱ्यांनो, ऐका.</para>
  <para style="q1" vid="MIC 3:1">तुम्ही न्यायाला स्वीकारू नये काय,<verse eid="MIC 3:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2" />तुम्ही जो चांगल्याचा द्वेष करता व वाईटावर प्रीती करता;</para>
  <para style="q1" vid="MIC 3:2">तुम्ही माझ्या लोकांची कातडी सोलता,</para>
  <para style="q2" vid="MIC 3:2">आणि त्यांच्या हाडापर्यंतच्या मांसाचे लचके तोडता;<verse eid="MIC 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3" />तुम्ही जे माझ्या लोकांचे मांस खाता,</para>
  <para style="q2" vid="MIC 3:3">त्यांची कातडी सोलता</para>
  <para style="q2" vid="MIC 3:3">आणि त्यांची हाडे मोडता,</para>
  <para style="q1" vid="MIC 3:3">आणि पातेल्यात शिजविण्यासाठी</para>
  <para style="q2" vid="MIC 3:3">मांसाचे तुकडे करावेत तसे त्यांचे तुकडे करता.<verse eid="MIC 3:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4" />मग ते याहवेहचा धावा करतील,</para>
  <para style="q2" vid="MIC 3:4">पण याहवेह त्यांचे ऐकणार नाही.</para>
  <para style="q1" vid="MIC 3:4">त्यावेळी त्यांच्या वाईट कृत्यांमुळे</para>
  <para style="q2" vid="MIC 3:4">याहवेह त्यांच्यापासून आपला चेहरा लपवतील.<verse eid="MIC 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5" />याहवेह असे म्हणतात:</para>
  <para style="q1" vid="MIC 3:5">“माझ्या लोकांना</para>
  <para style="q2" vid="MIC 3:5">चुकीच्या मार्गाने नेणारे संदेष्टे,</para>
  <para style="q1" vid="MIC 3:5">त्यांना काही खायला मिळाल्यास</para>
  <para style="q2" vid="MIC 3:5">ते ‘शांती’ ची घोषणा करतात.</para>
  <para style="q1" vid="MIC 3:5">परंतु जो त्यांना खाण्याचे देण्यास नकार देतो</para>
  <para style="q2" vid="MIC 3:5">त्याच्याशी युद्ध करण्यास सुसज्ज राहतात.<verse eid="MIC 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6" />म्हणूनच तुझ्यावर रात्र येईल, दृष्टान्त दिसणार नाही,</para>
  <para style="q2" vid="MIC 3:6">आणि अंधार येईल, तुम्ही दैवप्रश्न पाहिल्याशिवाय!</para>
  <para style="q1" vid="MIC 3:6">या संदेष्ट्यांसाठी सूर्यास्त होईल</para>
  <para style="q2" vid="MIC 3:6">आणि दिवस असता त्यांच्यावर अंधार पडेल.<verse eid="MIC 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7" />द्रष्ट्यांना लाज वाटेल</para>
  <para style="q2" vid="MIC 3:7">आणि दैवप्रश्न करणारे फजीत होतील.</para>
  <para style="q1" vid="MIC 3:7">ते सर्व आपली मुखे झाकतील</para>
  <para style="q2" vid="MIC 3:7">कारण त्यांना परमेश्वराकडून उत्तर आलेले नाही.”<verse eid="MIC 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8" />परंतु माझ्याबाबतीत म्हणाल,</para>
  <para style="q2" vid="MIC 3:8">तर याकोबाला त्याचे अपराध</para>
  <para style="q2" vid="MIC 3:8">आणि इस्राएलला त्याचे पाप सांगण्यासाठी</para>
  <para style="q1" vid="MIC 3:8">मी याहवेहच्या आत्म्याने, न्यायाने आणि सामर्थ्याने</para>
  <para style="q2" vid="MIC 3:8">परिपूर्ण आहे.<verse eid="MIC 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9" />अहो याकोबाच्या पुढार्‍यांनो,</para>
  <para style="q2" vid="MIC 3:9">इस्राएलाच्या अधिकाऱ्यांनो, माझे ऐका,</para>
  <para style="q1" vid="MIC 3:9">तुम्ही न्यायाला तुच्छ लेखता</para>
  <para style="q2" vid="MIC 3:9">आणि चांगल्या गोष्टी विकृत करता;<verse eid="MIC 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10" />सीयोनला रक्तपाताने</para>
  <para style="q2" vid="MIC 3:10">आणि यरुशलेमला दुष्टपणाने बांधले आहे.<verse eid="MIC 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11" />तिचे पुढारी लाच घेऊन न्याय करतात,</para>
  <para style="q2" vid="MIC 3:11">तिचे याजक किंमत घेऊन शिकवितात,</para>
  <para style="q2" vid="MIC 3:11">व तिचे संदेष्टे पैशासाठी भविष्य सांगतात.</para>
  <para style="q1" vid="MIC 3:11">तरीही ते याहवेहच्या मदतीसाठी आसुसलेले असतात आणि म्हणतात,</para>
  <para style="q2" vid="MIC 3:11">“याहवेह आपल्यामध्ये नाहीत काय?</para>
  <para style="q2" vid="MIC 3:11">आमच्यावर कोणतेही संकट येणार नाही.”<verse eid="MIC 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12" />म्हणून तुमच्यामुळे,</para>
  <para style="q2" vid="MIC 3:12">सीयोन शेताप्रमाणे नांगरला जाईल,</para>
  <para style="q1" vid="MIC 3:12">यरुशलेम दगडांचा ढिगारा होईल,</para>
  <para style="q2" vid="MIC 3:12">मंदिराच्या टेकडीवर दाटीने झाडेझुडपे वाढतील.<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s1">याहवेहचे पर्वत</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />पण शेवटच्या दिवसात</para>
  <para style="q1" vid="MIC 4:1">याहवेहच्या मंदिराचे पर्वत बळकट व उंच</para>
  <para style="q2" vid="MIC 4:1">असे स्थापित केले जातील;</para>
  <para style="q1" vid="MIC 4:1">सर्व पर्वतांपेक्षा ते उंचावले जातील,</para>
  <para style="q2" vid="MIC 4:1">आणि लोकांचा लोंढा त्याकडे एकत्र येईल.<verse eid="MIC 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2" />अनेक राष्ट्रे येतील आणि म्हणतील,</para>
  <para style="q1" vid="MIC 4:2">“चला, आपण याहवेहच्या पर्वताकडे,</para>
  <para style="q2" vid="MIC 4:2">याकोबाच्या परमेश्वराच्या मंदिराला जाऊ.</para>
  <para style="q1" vid="MIC 4:2">ते आपले मार्ग आम्हाला शिकवतील,</para>
  <para style="q2" vid="MIC 4:2">म्हणजे आम्ही त्या मार्गावर चालू.”</para>
  <para style="q1" vid="MIC 4:2">कारण सीयोनमधून नियमशास्त्र,</para>
  <para style="q2" vid="MIC 4:2">यरुशलेमातून याहवेहचे वचन बाहेर जाईल.<verse eid="MIC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3" />ते देशांमधील अनेक लोकांचा न्याय करतील,</para>
  <para style="q2" vid="MIC 4:3">दूरदूरच्या बलाढ्य राष्ट्रांमधील वाद मिटवतील.</para>
  <para style="q1" vid="MIC 4:3">ते आपल्या तलवारी ठोकून त्यांचे नांगराचे फाळ करतील,</para>
  <para style="q2" vid="MIC 4:3">व भाल्यांचे आकडे बनवतील.</para>
  <para style="q1" vid="MIC 4:3">एक देश दुसऱ्या देशाविरुद्ध तलवार उगारणार नाही,</para>
  <para style="q2" vid="MIC 4:3">तसेच ते यापुढे लष्करी प्रशिक्षण देणार नाहीत.<verse eid="MIC 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4" />प्रत्येकजण आपआपल्या द्राक्षवेलीखाली</para>
  <para style="q2" vid="MIC 4:4">आणि आपआपल्या अंजिराच्या झाडाखाली बसेल,</para>
  <para style="q1" vid="MIC 4:4">आणि कोणीही त्यांना घाबरविणार नाही,</para>
  <para style="q2" vid="MIC 4:4">कारण सर्वसमर्थ याहवेहने म्हटले आहे.<verse eid="MIC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5" />सर्व राष्ट्रे</para>
  <para style="q2" vid="MIC 4:5">आपआपल्या दैवतांच्या नावाने चालतील,</para>
  <para style="q1" vid="MIC 4:5">पण आम्ही नेहमी</para>
  <para style="q2" vid="MIC 4:5">याहवेह आमच्या परमेश्वराच्या नावाने चालत राहू.<verse eid="MIC 4:5" /></para>
  <para style="s1">याहवेहची योजना</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6" />याहवेह घोषित करतात, “त्या दिवशी,</para>
  <para style="q2" vid="MIC 4:6">मी लंगड्यांना एकत्र करेन;</para>
  <para style="q1" vid="MIC 4:6">बहिष्कृत लोकांना</para>
  <para style="q2" vid="MIC 4:6">आणि ज्यांना मी दुखविले आहे त्यांनाही एकत्र करेन.<verse eid="MIC 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7" />मी लंगड्यांना माझे अवशेष करेन,</para>
  <para style="q2" vid="MIC 4:7">आणि बहिष्कृत लोकांना एक बलाढ्य राष्ट्र करेन.</para>
  <para style="q1" vid="MIC 4:7">त्या दिवसापासून याहवेह सीयोन पर्वतावरून</para>
  <para style="q2" vid="MIC 4:7">सदासर्वदा राज्य करतील.<verse eid="MIC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8" />आणि तू, कळपाच्या टेहळणीच्या बुरुजा,</para>
  <para style="q2" vid="MIC 4:8">सीयोन कन्येच्या मजबूत किल्ल्या,<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">पर्वत</char></note></para>
  <para style="q1" vid="MIC 4:8">तुझे पूर्वीचे राज्य तुला परत देण्यात येईल;</para>
  <para style="q2" vid="MIC 4:8">यरुशलेमच्या कन्येला सिंहासन दिले जाईल.”<verse eid="MIC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9" />तू आता मोठ्याने का रडत आहेस—</para>
  <para style="q2" vid="MIC 4:9">तुला राजा नाही काय?</para>
  <para style="q1" vid="MIC 4:9">तुमचा अधिकारी नष्ट झाला आहे काय,</para>
  <para style="q2" vid="MIC 4:9">म्हणून तुम्ही स्त्रीच्या प्रसूती वेदनांप्रमाणे व्याकूळ झाला आहात काय?<verse eid="MIC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10" />हे सीयोनच्या कन्ये,</para>
  <para style="q2" vid="MIC 4:10">बाळंतपणाच्या प्रसूती वेदनांनी कण्हत राहा,</para>
  <para style="q1" vid="MIC 4:10">कारण तू आता शहर सोडून</para>
  <para style="q2" vid="MIC 4:10">मोकळ्या मैदानात तळ ठोकला पाहिजे.</para>
  <para style="q1" vid="MIC 4:10">तू बाबेलला जाशील;</para>
  <para style="q2" vid="MIC 4:10">आणि तिथे तुझी सुटका होईल</para>
  <para style="q1" vid="MIC 4:10">आणि याहवेह तिथून तुम्हाला</para>
  <para style="q2" vid="MIC 4:10">तुमच्या शत्रूंच्या हातातून मुक्त करतील.<verse eid="MIC 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11" />पण आता पुष्कळ राष्ट्रे</para>
  <para style="q2" vid="MIC 4:11">तुमच्याविरुद्ध एकत्र झाली आहेत.</para>
  <para style="q1" vid="MIC 4:11">ते म्हणतात, “तिला अशुद्ध होऊ द्या,</para>
  <para style="q2" vid="MIC 4:11">आपण सीयोनेवर दुष्ट नजर टाकून आनंद करू!”<verse eid="MIC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12" />पण त्यांना</para>
  <para style="q2" vid="MIC 4:12">याहवेहचे विचार माहीत नाहीत;</para>
  <para style="q1" vid="MIC 4:12">त्यांना याहवेहच्या योजना समजत नाही,</para>
  <para style="q2" vid="MIC 4:12">खळ्यातील पेंढ्यांप्रमाणे याहवेहने त्यांना गोळा केले आहे.<verse eid="MIC 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13" />“अगे सीयोनकन्ये, ऊठ, मळणी कर;</para>
  <para style="q2" vid="MIC 4:13">कारण मी तुला लोखंडाची शिंगे</para>
  <para style="q1" vid="MIC 4:13">व कास्याचे खूर देईन,</para>
  <para style="q2" vid="MIC 4:13">आणि तू अनेक राष्ट्रांचे तुकडे करशील.”</para>
  <para style="q1" vid="MIC 4:13">त्यांची लूट तू याहवेहला,</para>
  <para style="q2" vid="MIC 4:13">त्यांची संपत्ती सर्व पृथ्वीच्या प्रभूला अर्पण करशील.<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="s1">बेथलेहेमातून अधिपती देण्याचे अभिवचन</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1" />हे सैन्याच्या नगरी, आता आपल्या सैन्याला एकत्र करा,</para>
  <para style="q2" vid="MIC 5:1">कारण आमच्याविरुद्ध वेढा पडला आहे.</para>
  <para style="q1" vid="MIC 5:1">ते काठीने इस्राएलाच्या</para>
  <para style="q2" vid="MIC 5:1">शासकाच्या गालावर मारतील.<verse eid="MIC 5:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2" />“परंतु, तू हे बेथलेहेम एफ्राथा,</para>
  <para style="q2" vid="MIC 5:2">तू जरी यहूदीयाच्या वंशजांपैकी सर्वात लहान आहेस,</para>
  <para style="q1" vid="MIC 5:2">तरी तुझ्यातून माझ्यासाठी</para>
  <para style="q2" vid="MIC 5:2">इस्राएलचा शासक उदय पावेल,<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">अधिपती</char></note></para>
  <para style="q1" vid="MIC 5:2">ज्याची उत्पत्ती</para>
  <para style="q2" vid="MIC 5:2">प्राचीन काळातील आहे.”<verse eid="MIC 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3" />म्हणून प्रसूती वेदनेत असलेली</para>
  <para style="q2" vid="MIC 5:3">एका मुलाला जन्म देईपर्यंत</para>
  <para style="q1" vid="MIC 5:3">आणि तिचे बाकीचे भाऊ परत इस्राएल लोकांमध्ये येईपर्यंत</para>
  <para style="q2" vid="MIC 5:3">इस्राएलचा त्याग केला जाईल.<verse eid="MIC 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4" />तो याहवेहच्या सामर्थ्याने,</para>
  <para style="q2" vid="MIC 5:4">याहवेह त्याच्या परमेश्वराच्या नावाच्या वैभवात उठेल</para>
  <para style="q2" vid="MIC 5:4">आणि आपल्या कळपाचा मेंढपाळ होईल आणि ते सुरक्षित राहतील,</para>
  <para style="q1" vid="MIC 5:4">कारण तेव्हा पृथ्वीच्या टोकापर्यंतच्या लोकांना</para>
  <para style="q2" vid="MIC 5:4">याहवेहची महानता कळेल.<verse eid="MIC 5:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5" />ते पुरुष<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fq" closed="false">ते पुरुष </char><char style="ft" closed="false">अर्थात् याहवेह</char></note> आपली शांती असतील</para>
  <para style="q2" vid="MIC 5:5">जेव्हा अश्शूरी आपल्या देशावर हल्ला करतील</para>
  <para style="q2" vid="MIC 5:5">आणि आपल्या किल्ल्यांमध्ये प्रवेश करतील,</para>
  <para style="q1" vid="MIC 5:5">तेव्हा आम्ही त्यांच्याविरुद्ध सात मेंढपाळ,</para>
  <para style="q2" vid="MIC 5:5">आठ देखील सेनापती उभे करू,<verse eid="MIC 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6" />अश्शूर देशावर तलवारीने,</para>
  <para style="q2" vid="MIC 5:6">निम्रोदाच्या देशावर उपसलेल्या तलवारीने कोण शासन<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">चुराडा</char></note> करेल.</para>
  <para style="q1" vid="MIC 5:6">अश्शूरचे लोक जेव्हा आपल्या देशावर आक्रमण करतील</para>
  <para style="q2" vid="MIC 5:6">आणि आपली सीमा ओलांडतील</para>
  <para style="q2" vid="MIC 5:6">तेव्हा याहवेह आपल्याला त्यांच्यापासून सोडवतील.<verse eid="MIC 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7" />याकोबाचे उरलेले लोक</para>
  <para style="q2" vid="MIC 5:7">अनेक लोकांमध्ये असतील,</para>
  <para style="q1" vid="MIC 5:7">ते याहवेहने पाठविलेल्या दहिवराप्रमाणे,</para>
  <para style="q2" vid="MIC 5:7">गवतावर पडणाऱ्या पावसाप्रमाणे असतील,</para>
  <para style="q1" vid="MIC 5:7">जे कोणाचीही वाट पाहत नाही</para>
  <para style="q2" vid="MIC 5:7">आणि कोणा मनष्यावर अवलंबून राहत नाही.<verse eid="MIC 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8" />याकोबाचे अवशेष राष्ट्रांमध्ये</para>
  <para style="q2" vid="MIC 5:8">आणि अनेक लोकांमध्ये असणार,</para>
  <para style="q1" vid="MIC 5:8">जंगली श्वापदांमध्ये सिंहासारखे</para>
  <para style="q2" vid="MIC 5:8">आणि मेंढरांच्या कळपामध्ये तरुण सिंहासारखे असतील,</para>
  <para style="q1" vid="MIC 5:8">ते त्यांच्यावर झेप घेतील आणि त्यांना ठार करीत पुढे जातील</para>
  <para style="q2" vid="MIC 5:8">आणि कोणीही त्यांना वाचवू शकत नाही.<verse eid="MIC 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9" />तुझ्या शत्रूंवर विजय मिळवून तुझा हात उंच होईल</para>
  <para style="q2" vid="MIC 5:9">आणि तुझ्या सर्व शत्रूंचा नाश होईल.<verse eid="MIC 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10" />“त्या दिवशी,” याहवेह ही घोषणा करतात,</para>
  <para style="q1" vid="MIC 5:10">“मी तुमच्या घोड्यांचा तुमच्यामध्ये नाश करेन</para>
  <para style="q2" vid="MIC 5:10">आणि तुमच्या रथांनाही नष्ट करेन.<verse eid="MIC 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11" />मी तुझ्या देशातील शहरांचा नाश करेन</para>
  <para style="q2" vid="MIC 5:11">आणि तुझे किल्ले उद्ध्वस्त करेन.<verse eid="MIC 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12" />मी तुमच्यातील चेटके नष्ट करेन</para>
  <para style="q2" vid="MIC 5:12">आणि यापुढे तुझ्यामध्ये कोणीही शकुन पाहणार नाही.<verse eid="MIC 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13" />मी तुमच्या मूर्ती</para>
  <para style="q2" vid="MIC 5:13">आणि तुमच्यातील पवित्र दगडांचा नाश करेन;</para>
  <para style="q1" vid="MIC 5:13">तुमच्या हस्तकृतींना</para>
  <para style="q2" vid="MIC 5:13">तुम्ही पुन्हा दंडवत करणार नाही.<verse eid="MIC 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14" />जेव्हा मी तुझी नगरे उद्ध्वस्त करेन,</para>
  <para style="q2" vid="MIC 5:14">तेव्हा तुझे अशेरा स्तंभ<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">अश्शेरा देवीचे लाकडी चिन्ह</char></note> उपटून टाकीन.<verse eid="MIC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15" />ज्या राष्ट्रांनी माझी आज्ञा पाळली नाही,</para>
  <para style="q2" vid="MIC 5:15">त्यांचा मी रागाने आणि क्रोधाने सूड उगवेन.”<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s1">याहवेहचा इस्राएलशी वाद</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />याहवेह काय म्हणतात ते ऐका:</para>
  <para style="q1" vid="MIC 6:1">“उभे राहा, पर्वतांसमोर माझ्या दावा मांडा;</para>
  <para style="q2" vid="MIC 6:1">आणि तुला काय बोलायचे आहे ते टेकड्या ऐको.<verse eid="MIC 6:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2" />“हे पर्वतांनो, याहवेहने केलेल्या आरोपाकडे लक्ष द्या;</para>
  <para style="q2" vid="MIC 6:2">हे पृथ्वीच्या अढळ पाया, तूही ऐक.</para>
  <para style="q1" vid="MIC 6:2">कारण याहवेहचा त्यांच्या लोकांविरुद्ध एक दावा आहे.</para>
  <para style="q2" vid="MIC 6:2">ते इस्राएली लोकांविरुद्ध वाद दाखल करीत आहेत.<verse eid="MIC 6:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3" />“हे माझ्या लोकांनो, मी तुम्हाला काय केले आहे?</para>
  <para style="q2" vid="MIC 6:3">मी तुमच्यावर कोणते ओझे टाकले आहे? मला उत्तर द्या.<verse eid="MIC 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4" />मी तुम्हाला इजिप्त देशातून बाहेर काढले</para>
  <para style="q2" vid="MIC 6:4">आणि तुम्हाला गुलामगिरीतून देशातून मुक्त केले.</para>
  <para style="q1" vid="MIC 6:4">मी मोशेला तुमचे नेतृत्व करण्यास पाठवले,</para>
  <para style="q2" vid="MIC 6:4">अहरोन आणि मिर्यामलाही पाठवले.<verse eid="MIC 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5" />माझ्या लोकांनो,</para>
  <para style="q2" vid="MIC 6:5">मोआबाचा राजा बालाक याने काय कट केला</para>
  <para style="q2" vid="MIC 6:5">आणि बौराचा पुत्र बलाम याने काय उत्तर दिले ते स्मरणात ठेवा.</para>
  <para style="q1" vid="MIC 6:5">शिट्टीम ते गिलगालपर्यंतचा तुमचा प्रवास स्मरणात ठेवा,</para>
  <para style="q2" vid="MIC 6:5">म्हणजे याहवेहच्या न्यायीपणाच्या कृती तुम्हाला कळतील.”<verse eid="MIC 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6" />मी याहवेहसमोर काय आणावे</para>
  <para style="q2" vid="MIC 6:6">आणि स्तुतीस पात्र असलेल्या परमेश्वरासमोर मी नमन करावे?</para>
  <para style="q1" vid="MIC 6:6">होमार्पणासाठी मी एक वर्षाचे वासरू घेऊन</para>
  <para style="q2" vid="MIC 6:6">त्यांच्यासमोर येऊ का?<verse eid="MIC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7" />एक हजार मेंढे</para>
  <para style="q2" vid="MIC 6:7">किंवा जैतून तेलाच्या दहा हजार नद्यांनी याहवेह संतुष्ट होतील काय?</para>
  <para style="q1" vid="MIC 6:7">माझ्या अपराधाचे प्रायश्चित्त म्हणून मी माझा ज्येष्ठपुत्र अर्पावा काय,</para>
  <para style="q2" vid="MIC 6:7">माझ्या आत्म्याच्या पापासाठी माझ्या शरीराचे फळ द्यावे काय?<verse eid="MIC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8" />हे मनुष्या, त्यांनी तुला चांगले काय ते दाखविले आहे.</para>
  <para style="q2" vid="MIC 6:8">आणि याहवेह तुझ्याकडून काय अपेक्षा करतात?</para>
  <para style="q1" vid="MIC 6:8">नीतीने वागणे आणि दयेने प्रीती करणे</para>
  <para style="q2" vid="MIC 6:8">आणि तुझ्या परमेश्वराबरोबर नम्रपणे चालणे.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">शहाणपणाने</char></note><verse eid="MIC 6:8" /></para>
  <para style="s1">इस्राएलचा दोष व शासन</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9" />ऐका! याहवेह नगराला हाक मारीत आहेत—</para>
  <para style="q2" vid="MIC 6:9">आणि तुमच्या नावाचे भय बाळगणे हे ज्ञान आहे—</para>
  <para style="q2" vid="MIC 6:9">“काठी आणि त्यास नियुक्त करणाऱ्याचे ऐका.<verse eid="MIC 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10" />हे दुष्ट घरा, अजूनही तुझी अन्यायाने मिळवलेली संपत्ती,</para>
  <para style="q2" vid="MIC 6:10">आणि उणे एफा माप<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">म्हणजे </char><char style="fqa" closed="false">जे कोरडे माप करण्यासाठी उपयोगात आणले जात असे</char></note> जे शापित आहे त्यास विसरेन काय?<verse eid="MIC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11" />चुकीच्या वजनाच्या पिशवीने,</para>
  <para style="q2" vid="MIC 6:11">कपटाच्या वजनांनी मी कोणाची सुटका करू काय?<verse eid="MIC 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12" />तुमचे श्रीमंत लोक हिंसा करतात;</para>
  <para style="q2" vid="MIC 6:12">तुमचे रहिवासी लबाड आहेत</para>
  <para style="q2" vid="MIC 6:12">आणि त्यांची जीभ कपटी गोष्ट बोलते.<verse eid="MIC 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13" />म्हणून तुमच्या पातकांमुळे तुमचा नायनाट</para>
  <para style="q2" vid="MIC 6:13">व नाश करण्यास मी सुरुवात केली आहे.<verse eid="MIC 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14" />तू खाशील तृप्त होणार नाही;</para>
  <para style="q2" vid="MIC 6:14">खाल्ल्यानंतरही तुझे पोट रिकामे राहील.</para>
  <para style="q1" vid="MIC 6:14">तू साठवून ठेवशील, पण काहीही उरणार नाही,</para>
  <para style="q2" vid="MIC 6:14">कारण मी तुझी बचत तलवारीला देईन.<verse eid="MIC 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15" />तू पेरणी करशील पण कापणी करणार नाही;</para>
  <para style="q2" vid="MIC 6:15">तुम्ही जैतून फळे तुडवाल, पण ते तेल वापरणार नाही,</para>
  <para style="q2" vid="MIC 6:15">तू द्राक्षे चिरडशील, पण त्याचा द्राक्षारस पिणार नाही.<verse eid="MIC 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16" />तू ओमरीचे नियम</para>
  <para style="q2" vid="MIC 6:16">आणि अहाबाच्या घराण्याच्या सर्व चालीरीती पाळल्या आहेत;</para>
  <para style="q2" vid="MIC 6:16">तुम्हीही त्यांच्या रूढी पाळल्या आहेत.</para>
  <para style="q1" vid="MIC 6:16">म्हणून मी तुझा नाश करेन</para>
  <para style="q2" vid="MIC 6:16">व तुझ्या प्रजेची थट्टा करेन;</para>
  <para style="q2" vid="MIC 6:16">तू राष्ट्रांची निंदा सहन करशील.”<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">माझ्या लोकांची अप्रतिष्ठा तुम्हाला सोसावी लागेल</char></note><verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s1">इस्राएलची दुर्दशा</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1" />काय ही माझी दुःखद स्थिती!</para>
  <para style="q1" vid="MIC 7:1">मी द्राक्षमळ्यातील</para>
  <para style="q2" vid="MIC 7:1">उन्हाळी फळे गोळा करणार्‍यासारखा आहे;</para>
  <para style="q1" vid="MIC 7:1">खाण्यास द्राक्षांचा घडही उरला नाही,</para>
  <para style="q2" vid="MIC 7:1">अंजिराच्या ज्या पहिल्या फळाची मला इच्छा होती ती सुद्धा नाही.<verse eid="MIC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2" />पृथ्वीवरून विश्वासू लोकांचा नाश झाला आहे;</para>
  <para style="q2" vid="MIC 7:2">एकही प्रामाणिक मनुष्य उरला नाही.</para>
  <para style="q1" vid="MIC 7:2">प्रत्येकजण रक्तपात करण्यात गुंतला आहे;</para>
  <para style="q2" vid="MIC 7:2">ते सापळा रचून एकमेकांची शिकार करतात.<verse eid="MIC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3" />वाईट करण्यात दोन्ही हात निपुण आहेत;</para>
  <para style="q2" vid="MIC 7:3">शासक भेटवस्तूंची मागणी करतो,</para>
  <para style="q1" vid="MIC 7:3">न्यायाधीश लाच घेतात,</para>
  <para style="q2" vid="MIC 7:3">सामर्थ्यवान लोक बळजबरीने त्यांच्या इच्छा पूर्ण करतात;</para>
  <para style="q2" vid="MIC 7:3">ते सर्व मिळून कट रचतात.<verse eid="MIC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4" />त्यांच्यामध्ये जो सर्वोत्कृष्ट मानला जातो तो काटेरी झुडूप</para>
  <para style="q2" vid="MIC 7:4">आणि जो नीतिमान तो काट्याच्या कुंपणापेक्षाही वाईट आहे.</para>
  <para style="q1" vid="MIC 7:4">परमेश्वराने तुमच्याकडे येण्याचा दिवस आला आहे,</para>
  <para style="q2" vid="MIC 7:4">म्हणजेच तुमच्या पहारेकऱ्याने आवाज देण्याची वेळ आली आहे.</para>
  <para style="q2" vid="MIC 7:4">आता तुमच्या गोंधळाची वेळ आली आहे.<verse eid="MIC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5" />शेजाऱ्यावर भरवसा ठेवू नका;</para>
  <para style="q2" vid="MIC 7:5">आणि मित्रांवर विश्वास ठेवू नका.</para>
  <para style="q1" vid="MIC 7:5">तुझ्या मिठीत असलेली स्त्रीबरोबर असतानाही,</para>
  <para style="q2" vid="MIC 7:5">तुझ्या ओठांच्या शब्दांचे रक्षण कर.<verse eid="MIC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6" />कारण पुत्र आपल्या पित्याचा अनादर करतो,</para>
  <para style="q2" vid="MIC 7:6">मुलगी तिच्या आईविरुद्ध,</para>
  <para style="q1" vid="MIC 7:6">आणि सून तिच्या सासूविरुद्ध उठते—</para>
  <para style="q2" vid="MIC 7:6">मनुष्याचे शत्रू त्याच्या आपल्याच कुटुंबातील सदस्य असतात.<verse eid="MIC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7" />मी तर, याहवेहची आशेने वाट पाहतो,</para>
  <para style="q2" vid="MIC 7:7">मी माझ्या तारणाऱ्या परमेश्वराची प्रतीक्षा करतो;</para>
  <para style="q2" vid="MIC 7:7">माझे परमेश्वर माझे ऐकतील.<verse eid="MIC 7:7" /></para>
  <para style="s1">इस्राएल उठेल</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8" />अरे माझ्या वैर्‍या, माझी परिस्थिती बघून आनंद करू नकोस!</para>
  <para style="q2" vid="MIC 7:8">कारण मी पडलो, तरी पुन्हा उठेन.</para>
  <para style="q1" vid="MIC 7:8">जरी मी अंधारात बसलो,</para>
  <para style="q2" vid="MIC 7:8">तरी याहवेह माझा प्रकाश होतील.<verse eid="MIC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9" />मी याहवेहविरुद्ध पाप केल्यामुळे,</para>
  <para style="q2" vid="MIC 7:9">ते माझी बाजू ऐकून</para>
  <para style="q1" vid="MIC 7:9">मला न्याय देईपर्यंत</para>
  <para style="q2" vid="MIC 7:9">मी याहवेहचा कोप सहन करेन.</para>
  <para style="q1" vid="MIC 7:9">ते मला प्रकाशात आणतील;</para>
  <para style="q2" vid="MIC 7:9">आणि मी त्यांचे न्यायीपण पाहीन.<verse eid="MIC 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10" />मग माझे शत्रू हे पाहून</para>
  <para style="q2" vid="MIC 7:10">ते लज्जेने झाकले जातील,</para>
  <para style="q1" vid="MIC 7:10">ती जी मला म्हणत होती,</para>
  <para style="q2" vid="MIC 7:10">“याहवेह तुझा परमेश्वर कुठे आहे?”</para>
  <para style="q1" vid="MIC 7:10">माझे डोळे तिचे पतन पाहतील;</para>
  <para style="q2" vid="MIC 7:10">रस्त्याच्या चिखलाप्रमाणे</para>
  <para style="q2" vid="MIC 7:10">तीही पायाखाली तुडविली जाईल.<verse eid="MIC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11" />तुमचे तट बांधण्याचा दिवस येईल,</para>
  <para style="q2" vid="MIC 7:11">आणि तुमच्या सीमा विस्तारित करण्याचा दिवस येईल.<verse eid="MIC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12" />अश्शूरपासून इजिप्तच्या नगरांपर्यंत</para>
  <para style="q2" vid="MIC 7:12">आणि मिसरपासून फरात<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">फरात </char><char style="ft" closed="false">किंवा ज्याला आजच्या काळात युफ्रेटिस या नावाने ओळखले जाते</char></note> नदीपर्यंत,</para>
  <para style="q1" vid="MIC 7:12">समुद्रापासून समुद्रापर्यंत</para>
  <para style="q2" vid="MIC 7:12">आणि डोंगरांपासून डोंगरांपर्यंत,</para>
  <para style="q2" vid="MIC 7:12">त्या दिवशी लोक तुझ्याकडे येतील.<verse eid="MIC 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13" />पृथ्वीवरील रहिवाशांमुळे,</para>
  <para style="q2" vid="MIC 7:13">त्यांच्या कृतींचा परिणाम म्हणून, पृथ्वी उजाड होईल.<verse eid="MIC 7:13" /></para>
  <para style="s1">प्रार्थना आणि स्तुती</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14" />आपल्या लोकांचा काठीसह मेंढपाळ हो,</para>
  <para style="q2" vid="MIC 7:14">जो तुझ्या वतनाचा कळप आहे,</para>
  <para style="q1" vid="MIC 7:14">जो एकटाच जंगलात,</para>
  <para style="q2" vid="MIC 7:14">सुपीक कुरणात राहतो.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">किंवा </char><char style="fqa" closed="false">कर्मेलच्या मधोमध</char></note></para>
  <para style="q1" vid="MIC 7:14">त्यांना पूर्वीप्रमाणे बाशानात व गिलआदात</para>
  <para style="q2" vid="MIC 7:14">यथेच्छ चरू द्या.<verse eid="MIC 7:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15" />“तुम्ही इजिप्तमधून बाहेर आलात त्या दिवसांप्रमाणे,</para>
  <para style="q2" vid="MIC 7:15">मी त्यांना माझे चमत्कार दाखवेन.”<verse eid="MIC 7:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16" />राष्ट्रे हे पाहतील आणि लज्जित होतील,</para>
  <para style="q2" vid="MIC 7:16">त्यांच्या सत्तेपासून वंचित राहतील.</para>
  <para style="q1" vid="MIC 7:16">ते आपली मुखे हाताने झाकतील</para>
  <para style="q2" vid="MIC 7:16">आणि त्यांचे कान बहिरे होतील.<verse eid="MIC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17" />ते सर्पाप्रमाणे,</para>
  <para style="q2" vid="MIC 7:17">भूमीवर सरपटणार्‍या प्राण्यांप्रमाणे धूळ चाटतील.</para>
  <para style="q1" vid="MIC 7:17">ते आपल्या बिळातून थरथर कापत बाहेर पडतील;</para>
  <para style="q2" vid="MIC 7:17">भयभीत होऊन ते याहवेह आमच्या परमेश्वराकडे वळतील</para>
  <para style="q2" vid="MIC 7:17">आणि तुमचे भय बाळगतील.<verse eid="MIC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18" />तुम्ही जे अन्यायाची क्षमा करतात,</para>
  <para style="q2" vid="MIC 7:18">आपल्या वतनातील उरलेल्यांची पापे मागे टाकतात</para>
  <para style="q2" vid="MIC 7:18">त्या तुमच्यासारखा कोण परमेश्वर आहे?</para>
  <para style="q1" vid="MIC 7:18">तुम्ही सर्वकाळ क्रोध धरीत नाहीत,</para>
  <para style="q2" vid="MIC 7:18">परंतु दया दाखविण्यात आनंद मानता.<verse eid="MIC 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19" />पुन्हा एकदा तुम्ही आम्हावर दया कराल;</para>
  <para style="q2" vid="MIC 7:19">तुम्ही आमची पापे आपल्या पायाखाली तुडविणार;</para>
  <para style="q2" vid="MIC 7:19">आणि आमची दुष्कृत्ये समुद्राच्या खोलीत फेकून द्याल.<verse eid="MIC 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20" />फार पूर्वी,</para>
  <para style="q2" vid="MIC 7:20">आमच्या पूर्वजांना वचन दिल्याप्रमाणे,</para>
  <para style="q1" vid="MIC 7:20">तुम्ही याकोबाशी विश्वासू असाल,</para>
  <para style="q2" vid="MIC 7:20">आणि अब्राहामवर प्रीती दाखवाल.<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>