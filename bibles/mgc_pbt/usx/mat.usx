<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.5">
  <book code="MAT" style="id">- Morokodo - Mbara version - Checked - Ortho checked with Silvano Sebit - Ortho revised by Silvano Sebit</book>
  <para style="mt">Kö'du Yöyö Laka 'ba Yësu</para>
  <para style="mt1">ma Matayo ayöru</para>
  <chapter number="1" style="c"/>
  <para style="s">Zutu 'ba Yësu</para>
  <para style="p">
    <verse number="1" style="v"/>Nenye zutu 'ba Yësu Korisitɔ kozo 'ba Dawidi, kozo 'ba Abarayama.</para>
  <para style="q">
    <verse number="2" style="v"/>Abarayama ra o'jo Yisika,</para>
  <para style="q">Yisika ra o'jo Yakoba,</para>
  <para style="q">Yakoba ra o'jo Yuda, öndu nï ëtï.</para>
  <para style="q">
    <verse number="3" style="v"/>Yuda ra o'jo Pereze Zera aba,</para>
  <para style="q">ma zë ra Tamara,</para>
  <para style="q">Pereze ra o'jo Ezerona,</para>
  <para style="q">Ezerona ra o'jo Rama,</para>
  <para style="q">
    <verse number="4" style="v"/>Rama ra o'jo Aminadaba,</para>
  <para style="q">Aminadaba ra o'jo Nasona,</para>
  <para style="q">Nasona ra o'jo Salamono,</para>
  <para style="q">
    <verse number="5" style="v"/>Salamono ra o'jo Bowoza,</para>
  <para style="q">ma mo ra Raba.</para>
  <para style="q">Bawoza ra o'jo Obede,</para>
  <para style="q">ma mo ra Ruta.</para>
  <para style="q">Obede ra o'jo Jese.</para>
  <para style="q">
    <verse number="6" style="v"/>Jese ra o'jo Dawidi vo damöku.</para>
  <para style="b"/>
  <para style="q">Dawidi ra o'jo Solomono</para>
  <para style="q">ma mo ra lu'bë pëtï Uriya.</para>
  <para style="q">
    <verse number="7" style="v"/>Solomono ra o'jo Rebama,</para>
  <para style="q">Rebama ra o'jo Abiya,</para>
  <para style="q">Abiya ra o'jo Asa.</para>
  <para style="q">
    <verse number="8" style="v"/>Asa ra o'jo Yesopata,</para>
  <para style="q">Yesopata ra o'jo Yorama,</para>
  <para style="q">Yorama ra o'jo Uziya.</para>
  <para style="q">
    <verse number="9" style="v"/>Uziya ra o'jo Yotama,</para>
  <para style="q">Yotama ra o'jo Aza,</para>
  <para style="q">Aza ra o'jo Ezikiya.</para>
  <para style="q">
    <verse number="10" style="v"/>Ezikiya ra o'jo Manase,</para>
  <para style="q">Manase ra o'jo Amona,</para>
  <para style="q">Amona ra o'jo Yosiya.</para>
  <para style="q">
    <verse number="11" style="v"/>Yosiya ra o'jo Yekoniya zë 'dö</para>
  <para style="q">öndu nï ëtï kadra 'ba kïrï vïdï tï'bë Babalönï.</para>
  <para style="b"/>
  <para style="q">
    <verse number="12" style="v"/>Tapëtï kïrï vïdï tï'bë Babalönï ne.</para>
  <para style="q">Yekoniya ra o'jo Salatele,</para>
  <para style="q">Salatele ra o'jo Zerobabele,</para>
  <para style="q">
    <verse number="13" style="v"/>Zerobabele ra o'jo Abiyuda,</para>
  <para style="q">Abiyuda ra o'jo Elikima,</para>
  <para style="q">Elikima ra o'jo Azora,</para>
  <para style="q">
    <verse number="14" style="v"/>Azora ra o'jo Zadoka,</para>
  <para style="q">Zadoka ra o'jo Akimo,</para>
  <para style="q">Akimo ra o'jo Eliyuda,</para>
  <para style="q">
    <verse number="15" style="v"/>Eliyuda ra o'jo Elizara,</para>
  <para style="q">Elizara ra o'jo Matana,</para>
  <para style="q">Matana ra o'jo Yakoba,</para>
  <para style="q">
    <verse number="16" style="v"/>Yakoba ra o'jo Yosepa</para>
  <para style="q">kora 'ba Mariya ma 'ba</para>
  <para style="q">Yësu ma ako'jo Korisitɔ ne.</para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v"/>Here kozo ëdï kazi Abarayama zi Dawidi 'butë dɔmosowɔ, ëdï kazi Dawidi ma ï'bënnï mï Babalönï 'butë dɔmosowɔ le mï ko'jo 'ba Korisitɔ.</para>
  <para style="s">Ko'jo Yësu</para>
  <para style="p">
    <verse number="18" style="v"/>Nenye hala kö'du ko'jo 'ba Yësu Korisitɔ. Alivö ma mo zi koze zi Yosepa, mora gba adrɔ'bo rë nnï dë mo ayɔlɔ rë nnï mo ɔmɔ ku kyigɔ 'ba Lawo Kölö Laka aba. <verse number="19" style="v"/>Mora kora 'bɔmo Yosepa vo kö'du laka ko'dɔ mo omba dë zi gburu mo komo vïdï kayo. Mo asösu gbɔ zi kinga mo liwo. <verse number="20" style="v"/>Mora mati mo ëdï kö'du ne sösu mo here ne, malayika 'ba Yere ayada rë nï zi mo tëmï wïrï, iya henye, “Yosepa Kozo 'ba Dawidi, ere dë ta bi Mariya kïrï zi yï na mbara 'bëyï, ga kö'du wisi mï mo ne Lawo Kölö Laka ra ï'dï mo ɔmɔ. <verse number="21" style="v"/>Mo ako'jo na wisi kora akako'jo ru mo Yësu ga kö'du mo ra akakɔnyi vïdï 'bënï 'e tëmï kö'du kyënyë 'bëzë.”</para>
  <para style="p">
    <verse number="22" style="v"/>Kö'du ne biya o'dɔ rë nï zi tëdï kaa Wïrï ï'dï me'do mo ku kyere zi nëbï, iya henye, <verse number="23" style="v"/>Wu'jë maako gba na wu'jë ngulu ako'jo wisi kora akako'jo ru mo Imanowele, mï me'do ne iya henye, “Wïrï ëdï ze aba.”</para>
  <para style="p">
    <verse number="24" style="v"/>Mora Yosepa ongɔ here oze Mariya gbɔ kaa malayika 'ba Wïrï iya zi mo. <verse number="25" style="v"/>Mati gba zë ïrï dë nnï dë Mariya aba mo o'jo wisi ënï ne na kora, mora mo ï'dï ru mo gbɔ Yësu.</para>
  <chapter number="2" style="c"/>
  <para style="s">Tayi 'ba vo yɔlɔ me'do'e</para>
  <para style="p">
    <verse number="1" style="v"/>O'jo Yësu ku Beteleme mï dakaŋo 'ba Yudiya mï kadra 'ba Heroda vo damöku. Mora vo me'do yɔlɔ maako'e ayinnï ta humïrë ɔkɔnnï Yerusalema. <verse number="2" style="v"/>Zë ako'jonnï henye, “Wisi ma o'jo kinye na yere 'ba Yuda'e ne, mo ëdï kila? Dongɔ kyëlu ɔmo ma ayi ta humïrë ne dayi ze zi mo yeto.” <verse number="3" style="v"/>Mati Heroda owo kö'du ne here, mï mo ënyï umbë gbɔ mora vïdï 'ba Yerusalema maako'e mï zë umbë kpa. <verse number="4" style="v"/>Mora mo ako'jo vo da karasa'e 'dö vo komoyandi 'ba kö'du kida'e gbɔ ti'de mayinnï zi nï, mora mo ako'jo hë zë, mo iya henye, “Kɔdɔ here, Korisitɔ ne ako'jo kila?”</para>
  <para style="p">
    <verse number="5" style="v"/>Zë aya'bannï da me'do iyannï henye, “Ako'jo Korisitɔ ne mï Beteleme mï dakaŋo 'ba Yudiya, ga kö'du nëbï maako ayöru kö'du ne ku kyere iya henye,</para>
  <para style="q">
    <verse number="6" style="v"/>‘Mï, Beteleme, mï dakaŋo 'ba Yudiya,</para>
  <para style="q">anza dë tisiwa aba mï yere'e 'ba Yuda ne.</para>
  <para style="q">Vïdï ma kyedre atasi ndö tëmï 'e</para>
  <para style="q">mora mo akagaga vïdï 'bama 'ba Yiserele.’”</para>
  <para style="p">
    <verse number="7" style="v"/>Mora Heroda ako'jo vo kö'du yɔlɔ ne'e gbɔ liwo tayinnï zi nï mo ako'jo kadra 'ba tasi 'ba kyëlu nani kazi zë. <verse number="8" style="v"/>Mora mo utu zë gbɔ Beteleme kö'du kira nenye'e aba, “Ï'bë oma'e bi liya na laka kö'du wisi ne, ëzë i'ja'e mo ku ayi iya'e kö'du mo zi ma, tï'bë kpa mo yeto.”</para>
  <para style="p">
    <verse number="9" style="v"/>Mati zë owonnï me'do kiya 'ba Heroda ne ku zë ënyïnnï gbɔ tï'bë. Zë ongɔnnï te kyëlu ma zë ongɔnnï ta humïrë ne. Kyëlu ne alaga nduwë dagba zi zë le ï'bë ɔrɔ ga bi ma wisi Yësu ëdï dɔ mo ne. <verse number="10" style="v"/>Mati zë ongɔnnï ku here ne, zë gbɔ mï kyëyï kyedre aba. <verse number="11" style="v"/>Zë ödunnï gbɔ ï'bë i'jannï wisi ne ëdï loko ani 'dö ma mo aba. Mora zë alimannï gbɔ akaŋo zi mo yeto. Zë upönnï ha aŋboro 'bënnï ï'dïnnï wakï'dï 'bënnï gbɔ zi Yësu. Wakï'dï mora dahabo, wa kyëzï ngutru, ɔwɔ teme maako ako'jonnï ru mo “murë.”</para>
  <para style="p">
    <verse number="12" style="v"/>Wïrï ayada zi zë tëmï wïrï, ma'bannï dekpe hulëhu ta da Heroda. Mora zë a'ba ï'bënnï gbɔ dakaŋo 'bënnï ta gërï mënzë maako.</para>
  <para style="s">Taho mï Ezipeto</para>
  <para style="p">
    <verse number="13" style="v"/>Mati zë ï'bënnï ku, malayika 'ba Yere alaya zi mo tëmï wïrï iya henye, “Heroda omba zi wisi ne kofo. Ënyï oba wisi ne 'dö ma mo aba aho ï'bë Ezipeto. Alima ani le ma kiya zi yï a'ba.”</para>
  <para style="p">
    <verse number="14" style="v"/>Yosepa ënyï gbɔ mï yɔndɔ nani, oba wisi ne ma mo aba aho gbɔ mï Ezipeto. <verse number="15" style="v"/>Zë ï'bë alimannï Ezipeto ani le mï kadra 'ba koli 'ba Heroda.</para>
  <para style="p">Lima 'bëzë ani ne ëdï ku kaa kö'du 'ba Wïrï iya zi nëbï iya henye, “Ma ko'jo wisi ama ku ta Ezipeto.”</para>
  <para style="s">Kofo 'ba gisi kora mï Beteleme</para>
  <para style="p">
    <verse number="16" style="v"/>Mati Heroda ayɔlɔ ku vo kö'du yɔlɔ ne'e andëndënnï, nï ku, mï mo ënyï ata gbɔ. Mo utu vo kanya 'bënnïye gbɔ tï'bënnï mï dakaŋo ti'de 'ba Beteleme gisi kora kofo a'ba ti'de vo haliŋɔ aba. Zë ma ɔkɔnnï dë gba kɔɔ rïyö, ga kö'du kadra ma vo kö'du yɔlɔ ne'e ayadannï zi mo. <verse number="17" style="v"/>Kö'du ne o'dɔ rë nï tïnyö kaa nëbï Yeremaya iya henye,</para>
  <para style="q">
    <verse number="18" style="v"/>“Kpɔrɔ kudu ëdï mï Rama,</para>
  <para style="q">kpɔrɔ 'ba kudu 'e 'dö kuyë aba,</para>
  <para style="q">Rayile ra ëdï kudu ga kö'du gisi ënïye.</para>
  <para style="q">Zë olinnï ku ti'de mo omba</para>
  <para style="q">dë zi vïdï maako yata nï ta bi kudu.”</para>
  <para style="s">Ta'ba mï Ezipeto</para>
  <para style="p">
    <verse number="19" style="v"/>Tapëtï koli 'ba Heroda, malayika 'ba Yere alaya tëmï wïrï zi Yosepa mï Ezipeto iya zi mo henye, <verse number="20" style="v"/>“Ënyï, oba wisi ne ma mo aba, ï'bë hulëhu mï dakaŋo 'ba Yiserele, ga kö'du zë ma ï'dï rë nnï zi wisi ne kofo, olinnï ku.”</para>
  <para style="p">
    <verse number="21" style="v"/>Here Yosepa ënyï oba wisi ne ma mo aba ï'bë gbɔ hulëhu mï Yiserele. <verse number="22" style="v"/>Mora here, mati Yosepa owo Arakerosi ïrï pëtï 'bu nï Heroda ku na yere 'ba Yudiya, mo na tere zi tï'bë ani. Ayandi mo tëmï wïrï, here mo mï'bë gbɔ mï dakaŋo 'ba Galilaya. <verse number="23" style="v"/>Mora o'dɔ liŋɔ ënï gbɔ mï gawo 'ba Nazereta. Here kö'du ma nëbïye iyannï ne ayi ku tïnyö. “Akako'jo mo vïdï 'ba Nazereta.”</para>
  <chapter number="3" style="c"/>
  <para style="s">Yowani Bapatisi</para>
  <para style="p">
    <verse number="1" style="v"/>Mï kadra nani 'e Yowani Bapatisi ayi da lïpï 'ba Yudiya. Ayeto kö'du yëtï, <verse number="2" style="v"/>iya henye, “Otɔ'e de 'e tëmï kö'du kyënyë ko'dɔ 'be'e ga kö'du damöku 'ba Wïrï ëdï ku kara.” <verse number="3" style="v"/>Yowani ra Yisaya nëbï 'ba Wïrï iya me'do ku kyere, ga kö'du mo iya henye,</para>
  <para style="q">“Here vïdï maako ëdï mbere mï da lïpï</para>
  <para style="q">iya henye, akɔ'jɔ 'e gërï zi Yere.</para>
  <para style="q">Adɔrɔ'e gërï mbïyï zi mo.”</para>
  <para style="p">
    <verse number="4" style="v"/>Bɔngɔ 'ba Yowani o'dɔ tëmï yövu 'ba jemele. Mo ida kɔ'di wana ra götö nï na gasi. Wakonyo 'bɔmo ra wömï yazi 'ba wɔrɔ aba. <verse number="5" style="v"/>Vïdï olɔ ï'bënnï zi mo mï Yerusalema, tëmï daliŋɔ 'ba Yudiya ti'de kpa tëmï liŋɔ ma kara kara ha ranga 'ba Yeredene ne. <verse number="6" style="v"/>Zë odrɔ hë nnï ga kö'du kyënyë 'bënnï mo a bapatisi zë gbɔ mï ranga 'ba Yeredene.</para>
  <para style="p">
    <verse number="7" style="v"/>Mati Yowani ongɔ vïdï ma ako'jo ru zë Farasiye ne, 'dö Sadeke ma kayo ne ëtï tayinnï zi nï zë bapatisi, mo iya zi zë henye, “'E gisi 'ba wiri ne'e, ëyï ra o'ba 'e zi taho kazi riti ma ëdï tayi de 'e ne? <verse number="8" style="v"/>O'dɔ'e wa ma akayada otɔ'e de 'e ku tëmï kö'du kyënyë 'be'e. <verse number="9" style="v"/>Asösu 'e dë henye, ataho'e kazi riti ma Wïrï omba kutu ne kiya mo aba henye, Abarayama ne zutu 'be'e ra. Mayada zi ye Wïrï akïrï yïtö nenye'e a ko'dɔ na kozo zi Abarayama. <verse number="10" style="v"/>Lɔgɔ ëdï ku nzɔ zi kaga ma ana lɔgɔ dë ne kiga mo akaŋo ku'du mo mï wa'do.”</para>
  <para style="p">
    <verse number="11" style="v"/>“Mëdï 'bama bapatisi ko'dɔ nje de 'e toto wini aba zi yada otɔ'e de 'e ku. Vïdï ma atayi ta pëtï ma ne, akabapatisi 'e Lawo Kölö Laka wa'do aba. Mo mbiri kyedre ta da ma mëdï le kamoka 'ba ndï mo mɔ'bɔ dë kïnjë. Mo akï'dï bapatisi de 'e Lawo Kölö Laka 'dö wa'do aba. <verse number="12" style="v"/>Mo ëdï sërï ënï aba zi kahi nyenyo. Mo akakyitɔ köru ma laka mora akï'dï nyenyo ënï gbɔ mï lɔ'bi, mo ako'bɔ turu mo yaga mï wa'do ma kazi tölu ne.”</para>
  <para style="s">Bapatisi 'ba Yësu</para>
  <para style="p">
    <verse number="13" style="v"/>Yësu ayi tëmï Galilaya ɔkɔ ha ranga 'ba Yeredene zi Yowani nï bapatisi. <verse number="14" style="v"/>Yowani omba yata mo iya henye, “Ayi zi ma kaa ma ra ma tï'bë zi yï ko'dɔ bapatisi da ma?” <verse number="15" style="v"/>Yësu aya'ba dɔ mo iya henye, “Ï'dï mëdï tikɔ here, ga kö'du zi rë nï ko'dɔ kaa komba 'ba Wïrï ma laka here.” Mora Yowani ëlëzë gbɔ gɔ mo. <verse number="16" style="v"/>Mati ï'dï bapatisi ku da Yësu, mo ëdï ku tasi yaga tëmï wini, komorïyë ayëhu rë nï zi mo. Mo ongɔ Lawo Kölö Laka 'ba Wïrï ëdï tayi akaŋo dë nï ta komorïyë kaa atu'bu here. <verse number="17" style="v"/>Kpɔrɔ aa ta komorïyë iya henye, “Yï ra na Wisi 'bama mɔwɔ yï ku pe. Ma mï kyëyï kyedre aba ga kö'du 'bëyï.”</para>
  <chapter number="4" style="c"/>
  <para style="s">Yɔnzɔ 'ba Yësu</para>
  <para style="p">
    <verse number="1" style="v"/>Mora Lawo Kölö Laka ika Yësu gbɔ möku da lïpï zi Satani mo yɔnzɔ. <verse number="2" style="v"/>Mati mo oro hë nï ku kadra 'butësowɔ 'dö yɔndɔ aba kazi wakonyo maako, mo ëdï ku na o'bo. <verse number="3" style="v"/>Mora Satani ayi gbɔ zi mo iya henye, “Ëzë ëdï na wisi 'ba Wïrï ame'do zi ṛï'dï ne'e mofɔ rë nnï zi yï na mangɔlɔ'bɔ.”</para>
  <para style="p">
    <verse number="4" style="v"/>Yësu aya'ba dɔ mo iya henye, “Ayöru ku mï buku 'ba Wïrï iya henye, vïdï alima dë nje ra, wakonyo toto kö'du ma ëdï tasi ta ha Wïrï.”</para>
  <para style="p">
    <verse number="5" style="v"/>Mora Satani ika Yësu le tï'bë mï Yerusalema gawo laka, ënyï ï'dï mo ku le da tɔlɔ yëkëlu 'ba Wïrï. <verse number="6" style="v"/>Mo iya zi mo henye, “Ëzë ëdï na Wisi 'ba Wïrï umë rë yï akaŋo ga kö'du ayöru ku mï buku 'ba Wïrï iya henye, mo akï'dï me'do zi malayika ënïye ga kö'du 'bëyï zi zë kako yï kazi otra ndï yï ra ṛï'dï.” <verse number="7" style="v"/>Yësu aya'ba dɔ mo iya henye, “Ayöru ku iya henye, ayɔnzɔ Yere Wïrï 'bëyï dë.”</para>
  <para style="p">
    <verse number="8" style="v"/>Mora Satani ika mo löhu da döku ma konda rïyë mora ayada damöku 'dö teme mo aba ti'de zi mo, <verse number="9" style="v"/>iya henye, “Wa ne ti'de makï'dï zi yï ëzë alɔdrɔ ku akaŋo ma yeto.” <verse number="10" style="v"/>Yësu aya'ba dɔ mo zi mo iya henye, “Ehe yaga tara ma Satani. Ga kö'du ayöru iya henye, ‘Nje Yere Wïrï 'bëyï amötu.’” <verse number="11" style="v"/>Satani ila mo gbɔ mora malayika ayinnï akɔnyinnï mo gbɔ.</para>
  <para style="s">Lɔɔ ko'dɔ 'ba Yësu</para>
  <para style="p">
    <verse number="12" style="v"/>Mati Yësu owo ï'dï Yowani ku mï kamba, mo ënyï ï'bë gbɔ Galilaya. <verse number="13" style="v"/>Mo alima dë Nazereta ënyï ï'bë mï Kaparanamo, gawo ha föfö 'ba Galilaya mï dakaŋo 'ba Zebolona 'dö Napatali aba. <verse number="14" style="v"/>O'dɔ rë nï ku kaa Yisaya nëbï 'ba Wïrï iya ne here. Mo iya henye,</para>
  <para style="q">
    <verse number="15" style="v"/>“Tu'dë maako'e mï dakaŋo 'ba Zebolona 'dö Napatali aba,</para>
  <para style="q">'dö vïdï ma ha gërï 'ba föfö kyedre kayo ha</para>
  <para style="q">ranga 'ba Yeredene vïdï 'ba Galilaya dakaŋo 'ba vo leze'e,</para>
  <para style="q">
    <verse number="16" style="v"/>zë vïdï ma ëdï alimannï mï mandölu 'ba koli ne.”</para>
  <para style="m">
    <verse number="17" style="v"/>Mï kadra nani, Yësu ayeto kö'du kise 'bënï yëtï zi vïdï, iya henye, “Otɔ'e de 'e tëmï kö'du kyënyë 'be'e ga kö'du damöku 'ba Wïrï ëdï ku kara.”</para>
  <para style="s">Yësu ako'jo kora vo kyenze kïrïye sowɔ</para>
  <para style="p">
    <verse number="18" style="v"/>Mati Yësu ëdï alasi ta da götï 'ba föfö 'ba Galilaya, mo i'ja öndu vo kyenze kïrïye rïyö Simona ma ako'jo Petero öndu nï Anderiya aba. Ëdïnnï kyenze kïrï tëmï föfö öndu aba. <verse number="19" style="v"/>Yësu iya zi zë henye, “Ayiye zi ma, ma kayandiye zi vïdï kika mo zi Wïrï.” <verse number="20" style="v"/>Here kandi ila öndu 'bënnï ne, ï'bënnï gbɔ mo aba.</para>
  <para style="p">
    <verse number="21" style="v"/>Mo ï'bë nduwë dagba i'ja öndu ma kyamo'e rïyö, Yemisi nï Yowani aba gisi 'ba Zebedeyo zë ëdïnnï mï töŋbö ënnï 'bu nnï Zebedeyo ëtï öndu ënnï ko'jo mo nzɔ. Yësu ako'jo zë. <verse number="22" style="v"/>Mora kandi zë ilannï töŋbö ne 'bu nnï aba, ënyï ï'bënnï gbɔ mo aba.</para>
  <para style="s">Yësu ayandi kö'du vïdï kɔ'jɔ aba</para>
  <para style="p">
    <verse number="23" style="v"/>Yësu ënyï alasi biya tëmï Galilaya, kö'du yandi aba mï bi 'ba mötu'e yöyö yöyö laka 'ba damöku 'ba Wïrï aba, zi vïdï ma ëdïnnï dakyïnë 'ba kɔɔ ma 'beri'beri rakɔɔ kɔ'jɔ aba. <verse number="24" style="v"/>Kö'du yöyö ga kö'du mo apere rë nï biya tëmï dakaŋo 'ba Siriya, mora here, vïdï ikannï zi mo zë ma na rakɔɔ riti aba tëmï kyïnë 'ba dakɔɔ ne'e biya, vïdï maako'e ndï keŋe aba Yësu akɔ'jɔ zë biya. <verse number="25" style="v"/>Vïdï kayo alö'bönnï ga ndï mo tëmï Galilaya a'ba Gawo 'Butë, tëmï Yerusalema, Yudiya dakaŋo kapa 'ba Yeredene ma aga mo.</para>
  <chapter number="5" style="c"/>
  <para style="s">Kö'du kise 'ba Yësu da döku</para>
  <para style="s">Vo rakyenyiye ra</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu ongɔ vïdï kayo ne'e, mo ënyï ï'bë ëkyï da döku mora alima gbɔ akaŋo. Vo lö'bö 'bɔmo'e atoto rë nnï kpo rɔ mo, <verse number="2" style="v"/>mo ayeto gbɔ zë yandi iya henye,</para>
  <para style="q">
    <verse number="3" style="v"/>Vo rakyenyiye ra vïdï wïrï lumë aba,</para>
  <para style="q">ga kö'du damöku 'ba Wïrï 'bëzë ra.</para>
  <para style="q">
    <verse number="4" style="v"/>Vo rakyenyiye ra vïdï ma kudu aba,</para>
  <para style="q">ga kö'du akayëyï zë.</para>
  <para style="q">
    <verse number="5" style="v"/>Vo rakyenyiye ra vïdï ma dakumbë aba,</para>
  <para style="q">ga kö'du akïrïnnï drïvu 'ba dakaŋo.</para>
  <para style="q">
    <verse number="6" style="v"/>Vo rakyenyiye ra vïdï ma na o'bo a'ba kɔdrɔ aba tïnyö,</para>
  <para style="q">ga kö'du zë atɔvɔnnï.</para>
  <para style="q">
    <verse number="7" style="v"/>Vo rakyenyiye ra vïdï ma mïkyëyï aba,</para>
  <para style="q">ga kö'du zë aki'jannï mïkyëyï.</para>
  <para style="q">
    <verse number="8" style="v"/>Vo rakyenyiye ra vïdï ma di'di zë ŋbala,</para>
  <para style="q">ga kö'du zë akongɔnnï Wïrï.</para>
  <para style="q">
    <verse number="9" style="v"/>Vo rakyenyiye ra vïdï ma vo wayata, ga kö'du akako'jo zë na gisi 'ba Wïrï.</para>
  <para style="q">
    <verse number="10" style="v"/>Vo rakyenyiye ra vïdï ma ayaza zë ga kö'du tïnyö 'bëzë,</para>
  <para style="q">ga kö'du damöku 'ba Wïrï 'bëzë ra.</para>
  <para style="m">
    <verse number="11" style="v"/>Vo rakyenyiye ra vïdï ma alidiye, ayaza'e, o'dɔ'e na kyënyë dakyïnë kö'du 'ba Satani yada mo na ndɔndɔ ru'e aba ga kö'du 'e vo ga ndï ma. <verse number="12" style="v"/>Ëdïye rakyenyi aba ga kö'du biriti kyedre ëdï na sesi asesi zi biye komorïyë. Nenye ëdï hala nëbï ma alimannï dagba kazi komo'e ayaza zë.</para>
  <para style="s">Yɔ'dɔ bikanyi aba</para>
  <para style="p">
    <verse number="13" style="v"/>'E kaa yɔ'dɔ zi vïdï köndu 'ba dakaŋo ne biya. Mora ëzë yɔ'dɔ ayaŋa yɔkɔ nï ku, ata'ba akayɔkɔ hala? Anza kpe na laka, here aku'du yaga möku mora vïdï akutunnï dɔ mo ta bi lasi. <verse number="14" style="v"/>'E kaa bikanyi 'ba damöku ne biya. Gawo ma uvö da lutu oho rë nï dë. <verse number="15" style="v"/>Vïdï maako owi lamba dë mora kï'dï mo hu sikɔ, ta gɔ mo mo ï'dï da wa tɔrɔ 'ba lamba, ï'dï bikanyi gbɔ zi vïdï 'ba mï loko ne biya. <verse number="16" style="v"/>Tëmï gërï kölö ne, bikanyi 'be'e ma yanyi ga bi dagba komo vïdï, here ne zi zë kongɔ kö'du laka ma o'dɔ 'e zi yeto 'bu komorïyë.</para>
  <para style="s">Kö'du yandi 'ba kö'du kï'dï</para>
  <para style="p">
    <verse number="17" style="v"/>Asösu 'e dë henye ere, mayi ne zi kö'du kï'dï 'ba Mosa ne koba mo 'de, a'ba kö'du yandi 'ba nëbïye. Mayi dë zi zë koba mo 'de, mayi zi kö'du yandi 'bëzë ne kinde mo. <verse number="18" style="v"/>Miya kö'du tïnyö ra ze'e, dakaŋo komorïyë aba alaya dekpe, mora gbï le nje ï'jö kö'du kï'dï ma tisi wa aba ölu dë. Kö'du kï'dï akinde rë nï. <verse number="19" style="v"/>Here ëzë vïdï ma ɔwɔ gbï dë le nje kö'du ma tisi wa ne a'ba okannï 'e yandi mo zi ko'dɔ kpa here, atëdï nje tisiwa aba mï damöku 'ba Wïrï. Ta gërï ma kyamo, vïdï ma owo kö'du kï'dï a'ba ayandi oka 'e zi ko'dɔ mo kpa here, akatëdï na kyedre mï damöku 'ba Wïrï. <verse number="20" style="v"/>Mayada zi ye, henye ere, akatɔ'bɔ 'e tödu damöku 'ba Wïrï nje ëzë ëdï 'e koma aba kyɔ ta da vo kö'du kï'dï 'ba vo komoyandiye nnï Farasi ëtï tëmï wa ma Wïrï omba zi ko'dɔ mo.</para>
  <para style="s">Kö'du yandi ga kö'du 'ba kamo</para>
  <para style="p">
    <verse number="21" style="v"/>Owo 'e henye, ayada zi vïdï kyere naniye, “Ofo vïdï dë. Ëzë vïdï ma ofo vïdï ku, aki'ja riti.” <verse number="22" style="v"/>Mora yaanya aba mayada zi ye, vïdï ma na kamo öndu nï aba akika mo bi 'ba riti. Mo ma ako'jo öndu nï iya henye, “Yi wayawa ra,” akika mo komo vurë ma kyedre 'ba Yuda'e. Mo ma iya zi öndu nï, “Yï vo lökyï,” aku'du mo mï wa'do 'ba gehena ma ölu dë. <verse number="23" style="v"/>Here ëzë omba ku zi wakï'dï 'bëyï kï'dï zi Wïrï da karasa asösu öndu yï ëdï kö'du aba rë yï, <verse number="24" style="v"/>ila wakï'dï 'bëyï ne ani komo bi 'ba wakumu, ï'bë inde kö'du ne yaga tëmï kutë'e öndu yï aba, mora a'ba 'da wakï'dï 'bëyï ne kï'dï mo zi Wïrï. <verse number="25" style="v"/>Ëzë vïdï maako asusu yï mï gëri 'ba kö'du kï'dï, oba yï bi 'ba vurë, inde 'e kö'du ne mo aba ëzë ndï kadra gba kazi tɔkɔ bi 'ba vurë. Ëzë ëdï 'e ku ani, mo akï'dï yï zi vo vurë kikye mora mo akidra yï zi turu da köndu mora akï'dï yï gbɔ mï kamba. <verse number="26" style="v"/>Mayada zi yï akalima ani le ëzë opi ndundu kɔhi 'ba kö'du lïtë 'bëyï ne ku.</para>
  <para style="s">Kö'du yada ga kö'du 'ba ndoro</para>
  <para style="p">
    <verse number="27" style="v"/>Owo 'e ku iya henye, “O'dɔ ndoro dë.” <verse number="28" style="v"/>Mora yaanya aba ne mayada zi ye, bi 'ba wakumu zi Wïrï, vïdï ma ongɔ bi da mbara maako omba mo zi tëdï zi nï, o'dɔ ndoro ku mo aba mï di'di nï. <verse number="29" style="v"/>Mora here, ëzë komo yï ma tïrï o'dɔ yï zi kö'du kyënyë ko'dɔ, oba yaga u'du möku. Ëdï na laka zi, kya 'ba rë yï koba 'de yaga ta da yï ku'du biya ida rë yï aba mï gehena. <verse number="30" style="v"/>Ëzë kala yï ma tïrï o'dɔ yï zi kö'du kyënyë ko'dɔ ikye u'du möku. Ëdï na laka zi kya 'ba rë yï ma kölö koba mo 'de ta da ida rë yï biya zi tï'bë mï gehena ma ölu dë.</para>
  <para style="p">
    <verse number="31" style="v"/>Iya kpa henye, “Vïdï mati ayëyï mbara 'bënï mï'dï zi mo waraga 'ba rakinga.” <verse number="32" style="v"/>Yaanya aba ne mayada zi ye henye, ëzë kora ma inga mbara 'bënï ga kö'du ma 'beri anza ndoro dë, ëzë mbara ne ï'bë oze kora maako, mo o'dɔ ndoro ku. Kora ma oze mo ne o'dɔ ndoro kpa ku.</para>
  <para style="s">Kö'du yandi ga kö'du 'ba lömu</para>
  <para style="p">
    <verse number="33" style="v"/>Owo 'e kpa henye ayada zi vïdï ma alagannï kyere ne'e henye, apere mï lömu 'bëyï dë, o'dɔ wa ma o'dɔ lömu mo ne zi Yere zi ko'dɔ. <verse number="34" style="v"/>Mora mayada zi ye o'dɔ 'e lömu maako dë komorïyë aba ga kö'du bi lima 'ba Wïrï. <verse number="35" style="v"/>Alömu rë yï dë dakaŋo aba, ga kö'du bi ndï kutu 'bɔmo ra. Alömu rë yï dë Yerusalema aba ga kö'du gawo kyedre 'ba Wïrï ra. <verse number="36" style="v"/>Alömu dë dë yï aba ga kö'du ɔ'bɔ dë zi yëvu ma kölö ko'dɔ na kanyi mandere na köndu. <verse number="37" style="v"/>Iya nje henye, “Ɔɔ mandere e'e. Wa ma iya 'e 'beri ne ayi kazi Satani.”</para>
  <para style="s">Kö'du yandi ga kö'du 'ba dasolo</para>
  <para style="p">
    <verse number="38" style="v"/>Owo'e ku iya henye, komo, komo aba, yingɔ ha, yingɔ ha aba. <verse number="39" style="v"/>Yaanya aba miya zi ye henye, “Aya'ba da kö'du kyënyë dë zi vïdï ma o'dɔ kö'du kyënyë zi yï. <verse number="40" style="v"/>Ëzë vïdï maako isa lɔ'bɔ yï ma datïrï, mo misa lɔ'bɔ yï ma da gali kpa.” <verse number="41" style="v"/>Ëzë vïdï maako ïrï yï na wehe zi wa 'bënï kumbë, wiṛi kölö, ïnjë wiṛi rïyö. <verse number="42" style="v"/>Ëzë vïdï maako ako'jo wa kazi yï, ï'dï zi mo. Ëzë vïdï maako omba wa koba kazi yï dero, ï'dï zi mo.</para>
  <para style="s">O'dɔ lɔvɔ vo wehe oka yïye</para>
  <para style="p">
    <verse number="43" style="v"/>Owo 'e iya henye, “O'dɔ lɔvɔ oka yï 'e biya. Mora oyi vo wehe 'bëyï 'e.” <verse number="44" style="v"/>Yaanya aba mayada zi ye, o'dɔ lɔvɔ vo wehe 'bëyïye amötu ga kö'du zë ma o'dɔnnï yï na kyënyë. <verse number="45" style="v"/>Zi yada 'e tëdï na gisi 'ba 'bu ma komorïyë, ga kö'du mo ï'dï kadra ënï zi bi yanyi da vïdï kyënyë'e 'dö ma laka ëtï, ï'dï mïrë zi zë ma o'dɔnnï kö'du laka kpa zi zë ma o'dɔnni kö'du kyënyë. <verse number="46" style="v"/>Hala Wïrï akï'dï biriti zi yï ëzë o'dɔ nje lɔvɔ vïdï ma o'dɔ nnï lɔvɔ yï? Vïdï 'ba 'be'bele kö'du 'e o'dɔnni kpa here. <verse number="47" style="v"/>Ëzë ame'do nje zi aboka yïye, here ne o'dɔ ku ndra ta da vïdï ma ayɔlɔ Wïrï dë ne. <verse number="48" style="v"/>Ëdï na laka ta ga kadra biya kaa 'bu yï 'ba komorïyë.</para>
  <chapter number="6" style="c"/>
  <para style="s">Wakï'dï zi vo leri</para>
  <para style="p">
    <verse number="1" style="v"/>Andiye re 'e laka o'dɔ'e kö'du laka 'be'e dë komo vïdï zi kongɔ mo, ëzë o'dɔ'e ku here, i'ja'e wa ma kölö maako dë kazi 'bu'e ma komorïyë. <verse number="2" style="v"/>Ëzë yï maako ëdï kï'dï wa zi vo leri, iya kö'du mo dë zi vïdï maako kaa vo komo kandiye ëdïnnï ko'dɔ mo mï bi 'ba mötu'e, a'ba da gërï zi vïdï koronnï. Na laka miya zi ye biriti 'bëzë ku nje here. <verse number="3" style="v"/>Ëzë ëdï wakï'dï zi vo leri, ï'dï vïdï ma kara rë yï ne ma yɔlɔ dë. <verse number="4" style="v"/>Ï'dï toto liwo. Ëzë 'bu Wïrï i'ja wa ma o'dɔ ku liwo ne mo akï'dï biriti mo zi yï.</para>
  <para style="s">Mötu ko'dɔ</para>
  <para style="p">
    <verse number="5" style="v"/>Ëzë ëdïye amötu anza'e dë kaa vo komo kandiye, kö'du zë o'dɔnnï lɔvɔ tɔrɔ mötu ko'dɔ aba mï bi 'ba mötu'e ta da gërï zi vïdï nnï kongɔ. Mayada zi ye, tïnyö biriti 'bëzë gɔ mo ra ku nje ne. <verse number="6" style="v"/>Ëzë omba mötu ödu kutu yï aba loko 'bëyï isi haloko gë yï a mötu zi 'Bu yï, zi Wïrï mati ongɔ rɔ mo dë ne. Wa mati o'dɔ'e ku liwo ne, 'Bu'e akï'dï biriti mo zi ye. <verse number="7" style="v"/>Ëzë ëdïye ku amötu adele'e mï me'do dë kaa vïdï ma ayɔlɔ Wïrï dë, ga kö'du zë asösu 'bënnï henye akowonnï ga kö'du mötu konda 'bënnï ne. <verse number="8" style="v"/>Anza'e dë kaa zë, ga kö'du 'bu'e ayɔlɔ wa ma, omba'e ne ku kyere gba kazi ako'jo 'e dë. <verse number="9" style="v"/>Nenye ëdï hala aka mötu'e.</para>
  <para style="q">'Bu ze ma komorïyë nani,</para>
  <para style="q">ru yï mëdï na koro.</para>
  <para style="q">
    <verse number="10" style="v"/>Ï'dï damöku 'bëyï mayi,</para>
  <para style="q">kö'du 'bëyï 'ba dakaŋo kinye mo'dɔ rë nï kpa kaa 'ba komorïyë ne here.</para>
  <para style="q">
    <verse number="11" style="v"/>Ï'dï wakonyo 'ba kadra ma ndenye ne zi ze.</para>
  <para style="q">
    <verse number="12" style="v"/>Ila ze ga kö'du yaŋa 'beze kaa dëdï kila oka ze 'e</para>
  <para style="q">ga kö'du yaŋa zë o'dɔnnï zi ze ne here.</para>
  <para style="q">
    <verse number="13" style="v"/>Ika ze dë mï wayɔnzɔ, asesi ze laka kazi Satani.</para>
  <para style="p">
    <verse number="14" style="v"/>Ëzë ila'e vïdï ga kö'du ma zë ayaŋannï zi ye ne, 'bu'e ma komorïyë ne akila 'e kpa ga kö'du yaŋa 'be'e. <verse number="15" style="v"/>Ëzë ila'e vïdï dë ga kö'du kyënyë, 'bu'e ma komorïyë ne ila 'e kpa dë ga kö'du kyënyë 'be'e.</para>
  <para style="s">Hakoro</para>
  <para style="p">
    <verse number="16" style="v"/>Ëzë ëdïye he 'e koro, ayaŋa'e da komo'e dë kaa vo komo kandiye ëdïnnï ako'dɔ. Zë afufu rë nnï vonyö vonyö zi yɔlɔ mo nëdïnnï hë nnï koro. Tïnyö miya zi ye biriti ï'dï ku nzɔ ndɔ zi zë. <verse number="17" style="v"/>Ëzë ëdï he 'e koro, akaka'e komo'e osa'e yënï re 'e, <verse number="18" style="v"/>kazi vïdï maako'e ayɔlɔnnï ëdïye he 'e koro, nje 'bu'e ma ongɔ rɔ mo dë ne, mo ra nje ma yɔlɔ wa ma o'dɔ'e na liwo ne mo akï'dï biriti mo zi ye.</para>
  <para style="s">Watɔɔ rë yï</para>
  <para style="p">
    <verse number="19" style="v"/>Ulu ha wa dë zi ye dakaŋo kinye, bi ma malödö ëdï yaŋa wa ti'de zi mo ne, wa ma ëdï lëndrë ne, mora vo logo ëdïnnï logo wa ta dɔ mo ne. <verse number="20" style="v"/>Wa ma laka ulu ku zi ye komorïyë, ga bi ma malödö ayaŋa wa dë ta dɔ mo, wa lëndrë, vo logo alogo wa dë ta dɔ mo ne. <verse number="21" style="v"/>Ga kö'du, bi ma ulu ha wa ku dɔ mo ne di'di yï atëdï ŋburu dɔ mo.</para>
  <para style="p">
    <verse number="22" style="v"/>Komo yï ra, na lamba 'ba rë yï. Ëzë komo yï ëdï na laka ida rë yï ti'de akatëdï ndɔ mï bikanyi kyedre. <verse number="23" style="v"/>Ëzë komo yï na kyënyë rë yï ti'de atëdï ga bi köndu. Ëzë bikanyi anza dë mï yï di'di yï ndɔ na bi köndu.</para>
  <para style="s">Wïrï 'dö kɔhi aba</para>
  <para style="p">
    <verse number="24" style="v"/>Vïdï maako ɔ'bɔ dë zi lïtu zi yere rïyö, mo atɔwɔ nje ma kölö, mo akoyi ma kölö. Ɔ'bɔ dë zi lïtu zi Wïrï kpa zi damöku? <verse number="25" style="v"/>Mï kadra ko'do kölö ne mëdï kiya zi ye alima'e dë kö'du sösu aba ga kö'du 'ba wakonyo, wa kuwë, bɔngɔ ga kö'du lawo ɔɔ ndra ta da wakonyo. Mora kö'du ida ra ɔɔ ndra ta da bɔngɔ. <verse number="26" style="v"/>Ongɔ'e aliye te, zë isi nnï wa dë, zë umunnï wa dë kï'dï mo mï lɔ'bi. 'Bu 'ba komorïyë ne ëdï zë kulu. Here anza'e dë kyedre ta da aliye? Asösu 'be'e 'e ra dë kyedre ta da aliye? <verse number="27" style="v"/>Vïdï maako tëmï 'e atɔ'bɔ lima tisi konda, kö'du sösu aba kö'du mo?</para>
  <para style="p">
    <verse number="28" style="v"/>Kö'du a'di ëdïye alima kö'du sösu aba ga kö'du bɔngɔ? Ongɔ'e döru 'ba möku te zë urunnï bɔngɔ dë, o'dɔnnï lɔɔ dë zi nnï. <verse number="29" style="v"/>Tïnyö miya zi ye, Solomono ëdï le wa dakayo aba usu bɔngɔ ma teme alaga döru 'ba möku dë. <verse number="30" style="v"/>Ëzë Wïrï ëdï kusu bɔngɔ ra döru ma ëdï alɔ'bɔ atɔ'bɔ'e dë bɔngɔ kusu re 'e, vïdï ma kö'du koma aba ne. <verse number="31" style="v"/>Miya zi ye alima'e dë kö'du sösu aba kiya mo henye, “Ma konyo wa ndenye ta kila? Ma kuwë wa ndenye ta kila? Ma ki'ja bɔngɔ ta kila?” <verse number="32" style="v"/>Vïdï ma ayɔlɔ Wïrï dë ne ëdï nje taho ga wa 'ba dakaŋo ne. 'Bu 'e ma komorïyë nani mo ayɔlɔ, wa ma omba'e ne, mo akï'dï zi ye. <verse number="33" style="v"/>Oma mï damöku 'ba Wïrï dagba 'dö tïnyö 'bɔmo aba, wa ma omba ne mo akï'dï zi yï. <verse number="34" style="v"/>Asösu kö'du wa 'ba mïndö aba dë, ga kö'du mïndö ëdï kö'du sösu 'bënï aba kutu, kadra 'ba mïndö ëdï kpa kö'du 'bënï aba kutu.</para>
  <chapter number="7" style="c"/>
  <para style="s">Vurë ko'dɔ nje</para>
  <para style="p">
    <verse number="1" style="v"/>O'dɔ vurë 'ba vïdï maako dë na mbërë. Ëzë o'dɔ ku, ako'dɔ vurë 'bëyï kpa here. <verse number="2" style="v"/>Gërï ma ëdï ko'dɔ vurë 'ba vïdï mo aba ne, ako'dɔ vurë 'bëyï kpa mo aba. Ndï me'do ma ëdï yeri mo ra vïdï ne akayeri 'bëyï kpa here. <verse number="3" style="v"/>Kö'du a'di ongɔ bi da wa mati komo öndu yï, kazi bi kongɔ da kulugbu kyedre ma komo yï ne. <verse number="4" style="v"/>Hala akiya zi öndu yï, “Ï'dï ma yago ngayo nenye yaga ta komo yï,” mora ëdï 'bëyï gbï kulugbu aba komo yï? <verse number="5" style="v"/>Yï vo komo kandi nenye, ayago kulugbu ne dero dagba yaga ta komo yï, zi bi kongɔ na laka zi yago ngayo yaga ta komo öndu yï. <verse number="6" style="v"/>Ï'dï wa 'ba Wïrï dë zi wïhïye. U'du wa ma teme 'bëyï dë da komo wa'do 'e akalasinnï ta dɔ mo, akizannï mï yï sisisi yaga.</para>
  <para style="s">Oma aki'ja</para>
  <para style="p">
    <verse number="7" style="v"/>Ako'jo akï'dï zi yï, oma aki'ja, akökö, akayëhu haloko zi yï. <verse number="8" style="v"/>Zë ma ti'de ako'jonnï akï'dï zi zë. Zë ma ti'de omannï, aki'jannï. Zë ma akökönnï akayëhu. <verse number="9" style="v"/>Ëyï ra ëzë wisi 'bɔmo ako'jo mangɔlɔ'bɔ, mo ënyï ïrï yïtö ï'dï zi mo? <verse number="10" style="v"/>Ëzë wisi maako ako'jo kyenze ma mo akïrï wiri kï'dï zi mo. <verse number="11" style="v"/>Vo kö'du kyënyë ko'dɔ'e, ëzë ï'dï 'e wakï'dï 'be'e zi gisi 'be'e. 'Bu 'ba komorïyë akï'dï wa ma laka ndra kyɔ zi ye. <verse number="12" style="v"/>Wa ma omba oka yï 'e ko'dɔ mo zi yï ne o'dɔ kpa zi zë, nenye kö'du kise 'ba kö'du kï'dï 'dö nëbï kö'du ëtï. <verse number="13" style="v"/>Ödu 'e ta ha resi ma tisi ne, ha resi ma kyedre ne ï'bë bi 'ba koli. Gërï ma kyedre ne, vïdï ma ëdï tï'bënnï ta gɔ mo ne zë na kayo. <verse number="14" style="v"/>Ha loko ma ëdï tï'bë bi 'ba dïdï ma ŋburu ŋburu ne nje tisiwa. Vïdï ma i'jannï ne, toto tisiwa.</para>
  <para style="p">
    <verse number="15" style="v"/>Ï'dï 'e komo'e mandi laka, kazi nëbï kö'du 'ba Wïrï mambërë ne'e, ga kö'du usunnï bɔngɔ ma o'dɔ tëmï yëvu 'ba tïmëlë ne ta rë nnï yaga, mora mï di'di zë na tuku wölïwölï ma kyënyë. <verse number="16" style="v"/>Akayɔlɔ'e zë tëmï wa ma zë ëdïnnï ko'dɔ mo. Kaga kono ana oha dë, ana kyëlu dë. <verse number="17" style="v"/>Mora kpa here, kaga laka ana gbï lɔgɔ laka. Mora kaga ma kyënyë ana gbï lɔgɔ kyënyë. <verse number="18" style="v"/>Kaga laka ana lɔgɔ kyënyë dë. Kaga kyënyë ana lɔgɔ laka dë. <verse number="19" style="v"/>Kaga ma ti'de ana lɔgɔ ma laka dë ne akiga akaŋo aku'du mï wa'do. <verse number="20" style="v"/>Akayɔlɔ zë nje tara lɔgɔ 'bëzë ma ana ne.</para>
  <para style="p">
    <verse number="21" style="v"/>Anza vïdï biya ma ëdïnnï ko'jo ma, “Yere Yere,” ne akatödunnï mï damöku 'ba Wïrï, nje zë ma o'dɔnnï wa ma 'Bu ma komorïyë omba zë zi ko'dɔ. <verse number="22" style="v"/>Mï kadra 'ba vurë nani, vïdï ma kayo akiyannï zi ma henye, Yere, Yere, ze ra dëdï kumë kö'du dakyikyi kore aba yaga tara vïdï mï ru yï? <verse number="23" style="v"/>Ma kaya'ba, ma kiya zi zë henye, “Ma yɔlɔ 'e dë. Ï'bë'e yaga tara ma, 'e vo kö'du kyënyë ko'du ne'e.”</para>
  <para style="s">Vo loko ko'ba'e rïyö</para>
  <para style="p">
    <verse number="24" style="v"/>Ëzë vïdï ma owo kö'du yandi 'bama ku koro mo aba, atëdï kaa vo kö'du yɔlɔ ma o'ba loko ënï da ṛï'dï. <verse number="25" style="v"/>Ëzë mïrë a'di wini oso le, ëzë buluku aluku le akyëtï rë nï le ra loko nani alöru dë, ga kö'du o'ba hu mo ku da ṛï'dï. <verse number="26" style="v"/>Ëzë vïdï ma owo kö'du yandi 'bama ne dë koro mo aba, atëdï kaa vo lumë ma o'ba loko ënï da yayi. <verse number="27" style="v"/>Mïrë a'di wini oso, buluku aluku ra loko nani alöru ku na löru kyënyë. <verse number="28" style="v"/>Mati Yësu inde kö'du yëtï ku zi vïdï kayo nani 'e zë ku na rakaga ga kö'du wa yandi 'bɔmo ne. <verse number="29" style="v"/>Ga kö'du mo ëdï kala konda aba. Anza dë kaa vo komoyandi 'ba vo kö'du kida'e.</para>
  <chapter number="8" style="c"/>
  <para style="s">Yësu akɔ'jɔ vo mönyu</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu asi akaŋo ta da döku ne, vïdï kayo alö'bönnï gɔ mo. <verse number="2" style="v"/>Vo mönyu maako ayi alɔdrɔ, akaŋo komo Yësu, iya henye, “Yere, ëzë omba ku akɔ'jɔ ma ŋbala.” <verse number="3" style="v"/>Yësu iza kala nï gbɔ ise ra vere nani, iya henye, “Momba dɔ mo ku.” Mo iya henye, “Ëdï na ŋbala.” Akɔ'jɔ yï ku, mora rakɔɔ ila vere nani gbɔ kandi. <verse number="4" style="v"/>Yësu ise gɔ mo zi mo, iya henye, “Ï'bë iya me'do nenye dë zi vïdï maako, ï'bë zi vo karasa 'e ma nyelinnï rë yï, ï'dï wakumu 'ba wa kɔ'jɔ ma Mosa ï'dï kö'du mo ne, zi yada yï zi vïdïye ti'de akɔ'jɔ yï ku.”</para>
  <para style="s">Kyedre 'ba da vo kanya</para>
  <para style="p">
    <verse number="5" style="v"/>Yësu ödu mï Kaparanamo kyedre 'ba vo da kanya maako 'ba Roma vo da wehe lamikölö ayi ako'jo ha Yësu ga kö'du wa kɔnyi. <verse number="6" style="v"/>Iya henye, “Yere, vo kalima 'bama ëdï rakɔɔ aba liŋɔ na keŋe na riti.” <verse number="7" style="v"/>Yësu iya henye, “Ma tï'bë liŋɔ 'bëyï zi mo kɔ'jɔ.”</para>
  <para style="p">
    <verse number="8" style="v"/>Kyedre 'ba vo da kanya nani iya henye, “Yere, ɔ'bɔ dë zi yï tayi liŋɔ 'bama. Iya nje hë yï akakɔ'jɔ vo kalima 'bama ne, <verse number="9" style="v"/>ga kö'du mayɔlɔ kala konda 'bëyï ëdï gbï kaa 'bama, mëdï kala konda 'dö vo kanya ëtï hu ma. Ëzë ma me'do zi ma kölö, miya henye, ‘Ï'bë,’ mo ï'bë gbï. Ëzë ma me'do zi maako, miya henye, ‘Ayi,’ mo ayi gbï. Ëzë ma me'do zi vo kalima 'bama, o'dɔ wa nenye mo o'dɔ gbï.”</para>
  <para style="p">
    <verse number="10" style="v"/>Mati Yësu owo me'do 'ba vere ne ku, aga gbɔ rɔ mo. Mo iya zi vo gënïye iya henye, “Tïnyö miya zi ye, mi'ja vïdï maako dë 'de tëmï vïdï 'ba Yiserele, ma ëdï kö'du koma aba kaa vere ne. <verse number="11" style="v"/>Ëdï na laka mëdï kiya zi ye, ma kayo mo atayinnï tëmï dakaŋo kapa 'ba humïrë 'dö da lërë aba zi drɔkɔ rë nnï ra Abarayama, Yisika, Yakoba ëtï mï damöku 'ba Wïrï. <verse number="12" style="v"/>Gisi 'ba Yiserele ma kayo, ma akɔ'jɔ damöku ga kö'du zë aku'du zë mï bi köndu 'ba kudu ha konyo aba.” <verse number="13" style="v"/>Yësu aya'ba dɔ mo iya zi vo da kanya nani, iya henye ï'bë liŋɔ ako'dɔ rë nï kaa wa ma oma ne. Mora vo kalima 'ba da vo kanya ne akɔ'jɔ gbɔ mï kadra nani.</para>
  <para style="p">
    <verse number="14" style="v"/>Yësu ï'bë ödu loko 'ba Petero i'ja wese 'ba Petero zöyï aba o'ba rë nï ku da sora. <verse number="15" style="v"/>Mo ise kala mo, zöyï ila mo gbɔ. Here mo ënyï gbɔ lïtu zi mo. <verse number="16" style="v"/>Mï da hutaga nani aba, ikannï vïdï kayo maakowe ëdïnnï nökyï aba zi mo. Mo ore dakyikyi yaga ta rë zë me'do aba. Mo akɔ'jɔ vïdï ma rakɔɔ aba ne'e ti'de. <verse number="17" style="v"/>Mo o'dɔ here zi tëdï kaa ma Yesaya nëbï vo me'do 'ba Wïrï iya ne. Mo iya henye, “Ma gogo makïnjë rakɔɔ yaga.”</para>
  <para style="p">
    <verse number="18" style="v"/>Yësu ongɔ vïdï kayo ëdïnnï ku kpo ta rë nï mo ame'do zi vo lö'bö gënïye zi zë kumu kafo föfö ma agamo. Mo ame'do gbɔ zi vo lö'bö gënï 'e zi zë kumu tï'bë kafo ranga ma agamo. <verse number="19" style="v"/>Vo komoyandi maako ayi zi mo iya henye, vo komoyandi. Bi ma ï'bë zi mo. Ma kusu gëyï. <verse number="20" style="v"/>Yësu aya'ba dɔ mo, iya henye, “Uhwavödö 'e ëdïnnï ogo ënnï aba, ali 'e ëdïnnï loko ënnï aba. Wïsi 'ba Vïdï anza dë liŋɔ aba na bi 'ba ralawo.” <verse number="21" style="v"/>Vere maako na vo lö'bö gɔ mo iya henye, “Kyedre 'bama, ï'dï ma 'ba dero 'bu ma kusu.” <verse number="22" style="v"/>Yësu iya zi mo henye, “Usu ga ma, ila yöku 'e musunnï yöku ënnï.”</para>
  <para style="p">
    <verse number="23" style="v"/>Yësu ëkyï gbɔ mï töŋbö 'dö vo lö'bö gënï ëtï <verse number="24" style="v"/>tisi yaa buluku ënyï gbɔ aluku da föfö nani. Buluku alima ku töŋbö kɔhɔ zi likɔ kaŋo. Yësu ëdï ako'do. <verse number="25" style="v"/>Zë ï'bënnï alironnï mo, iyannï henye, “Yere, akɔnyi ze, dëdï ku kara zi koli.” <verse number="26" style="v"/>Mo iya zi zë henye, “Ëdïye atere ga a'dï? Ëdïye koma tisi aba.” Mo ënyï amo da buluku wini kagba aba, mati ɔrɔnnï ne, bi gbɔ liwo. <verse number="27" style="v"/>Zë ti'de na rakaga iyannï henye, “Vere ne, ëyï ra? Buluku 'e wini kagba aba owonnï dɔ mo.”</para>
  <para style="s">Vo nökyï nnï wa'do ëtï</para>
  <para style="p">
    <verse number="28" style="v"/>Mati Yësu umu da föfö ï'bë mï dakaŋo 'ba Gadora ne, vïdï rïyö maako'e zë dakyikyi aba andɔsi dë nnï mo aba. Vïdï ne'e ënyïnnï na nganga. Vïdï maako ɔ'bɔ dë zi laga ta ga bi nani, dakyikyi ne'e ayaza rë nnï zi Yësu. <verse number="29" style="v"/>Zë apinnï na kyembe, iyannï henye, “Yï Wisi 'ba Wïrï nenye, a'di ra omba kazi ze ayi ku de ze kinde gba kazi kadra mo tɔkɔ?”</para>
  <para style="p">
    <verse number="30" style="v"/>Wa'do kayo 'ba liŋɔ ëdïnnï wakonyo kara ra liŋɔ da lutu. <verse number="31" style="v"/>Dakyikyiye ayaza rë nnï zi Yësu, iyannï henye, “Ëzë omba ku kore ze, utu ze zi wa'do nani 'e.” <verse number="32" style="v"/>Mo iya zi zë, henye, “Ï'bëë.” Zë ï'bënnï ödunnï mï wa'do kayo naniye, mora wa'do naniye ënyïnnï gbɔ ti'de ataho bi lunyï 'ba föfö mora aluyïnnï gbɔ ti'de mï wini. <verse number="33" style="v"/>Vo yako wa'do nani 'e aho iyannï mï gawo. Ayadannï kö'du ma o'dɔ rë nï nani ti'de, kö'du mati o'dɔ rë nï zi kora dakyikyi ne'e. <verse number="34" style="v"/>Vïdï 'ba mï gawo nani 'e olɔnnï gbɔ ti'de tayi Yësu kongɔ. Zë i'jannï mo ako'jonnï hɔ mo zi mo tënyï tï'bë yaga tëmï dakaŋo ënnï.</para>
  <chapter number="9" style="c"/>
  <para style="s">Yësu akɔ'jɔ kora vo keŋe maako</para>
  <para style="r">(Mk. 2:1-12; Lk. 5:17-26)</para>
  <para style="p">
    <verse number="1" style="v"/>Here Yësu ëkyï mï töŋbö ï'bë hulëhu kyëtï 'ba föfö mï gawo 'bënï. <verse number="2" style="v"/>Ani kya 'ba vïdï maako'e ikannï zi mo kora vo keŋe akaŋo ne ëdï ako'do da sora. Mati Yësu ongɔ hala kö'du koma 'bëzë ëdï, mo iya zi kora keŋe ne henye, “Akyigɔ rë yï, wisi ama, kö'du kyënyë 'bëyï ila ku.” <verse number="3" style="v"/>Mora here, kya 'ba vo komoyandi 'ba vo kö'du kida'e ame'donnï na bi dë nnï, iyannï henye, “Kora nenye, ëdï me'do 'dasi ra kiya.” <verse number="4" style="v"/>Mora here, Yësu ayɔlɔ kö'du sösu 'bëzë, ne a'ba iya henye, “Kö'du a'di ëdï 'e kö'du kyënyë mahere ne sösu mo? <verse number="5" style="v"/>Mavala ra zi kiya, ila yï ku ga kö'du kɔdɔ kyënyë 'bëyï, kɔdɔ zi kiya henye, ‘Ënyï rïyë alasi?’ <verse number="6" style="v"/>Mako'dɔ tïnyö zi ye yɔlɔ, Wisi a Vïdï ëdï kyigɔ aba dakaŋo zi kö'du kyënyë kila.” Mora here, mo iya zi kora keŋe ne henye, “Ënyï rïyë, ïnjë sora 'bëyï ne, ï'bë liŋɔ!” <verse number="7" style="v"/>Kora ne ënyï rïyë ï'bë gbɔ liŋɔ. <verse number="8" style="v"/>Mati vïdï kayo ongɔnnï ne, zë na tere Wïrï yeto aba ga kö'du kyigɔ kaa mahere ne kï'dï mo zi vïdï.</para>
  <para style="s">Yësu akɔ'jɔ Matayo</para>
  <para style="r">(Mk. 2:13-17; Lk. 5:27-32)</para>
  <para style="p">
    <verse number="9" style="v"/>Here Yësu ila bi nani, ma mo ï'bë dagba, mo ongɔ kora vo 'be'bele kö'du ru mo Matayo, ëdï alima bi 'ba 'be'bele kö'du, mo iya zi mo henye, “Alö'bö ga ma.” Matayo ënyï alö'bö gbɔ gɔ mo. <verse number="10" style="v"/>Mati Yësu ëdï wakonyo mï liŋɔ a Matayo, vo 'be'bele kö'du kyɔ, a'ba kya 'ba vo kö'du kyënyë ko'dɔ'e ayi onyonnï wa Yësu aba a'ba, vo lö'bö 'bɔmo'e ëtï da tarabiza kölö. <verse number="11" style="v"/>Kya 'ba Farasiye ongɔnnï kö'du ne here, ako'jonnï ha vo lö'bö 'bɔmo'e, “Kö'du a'di vo komoyandi 'be'e ëdïnnï wakonyo vïdï mahere ne ëtï? <verse number="12" style="v"/>Yësu owo kö'du 'bëzë ne, aya'ba dɔ mo iya henye, vïdï ma rë zë na laka kazi kɔɔ, ï'bënnï dë zi vo ɔwɔ, nje zë ma na rakɔɔ. <verse number="13" style="v"/>Ï'bë oma'e mï kö'du ya'ba ma kö'du yöru iya ne.” Ëdï kö'du laka ma momba, ra anza ngötu kumu. Mayi dë kö'du vïdï laka'e, mayi ga kö'du vïdï 'ba kö'du kyënyë'e.</para>
  <para style="s">Kö'du kɔ'jɔ kö'du 'ba hakoro</para>
  <para style="r">(Mk. 2:18-22; Lk. 5:33-39)</para>
  <para style="p">
    <verse number="14" style="v"/>Here vo lö'bö 'ba Yowani Bapatisi ayinnï zi Yësu, ako'jonnï kö'du iyannï henye, “Kö'du a'di ze Farasi ëtï, dëdï he ze koro mora vo lö'bö 'bëyïye, oro hë nnï dë gɔ mo?” <verse number="15" style="v"/>Yësu aya'ba dɔ mo iya henye, omba 'be'e yingɔ ma ëdïnnï mï kyërë 'ba oze, zi tëdï na rasösu ëzë 'bïyësï ëdï zë ëtï? Anza here dë. Here kadra mo akatɔkɔ, ëzë omba ku 'bïyësï koba 'de kazi zë mora atehennï 'da hë nnï koro. <verse number="16" style="v"/>“Vïdï maako uru bɔngɔ ma kyïyï dë zi kɔ'jɔ bɔngɔ ma kɔɔ, ga kö'du bɔngɔ ma kyïyï ako'dɔ wogo kyedre mï bɔngɔ ne. <verse number="17" style="v"/>Vïdï maako ope a'ji ma kyïyï dë mï lɔsɔ wana makɔɔ, ga kö'du lɔsɔ wana akiha a'ji akalödï yaga, mora lɔsɔ wana ne akayaŋa rë nï. Here a'ji makyïyï mope gbï mï lɔsɔ wana makyïyï a'ba 'dö rïyö atëdïnnï na laka.”</para>
  <para style="s">Wu'jë 'ba kyedre 'ba Yuda'e nnï mbara ma ise ra bɔngɔ 'ba Yësu</para>
  <para style="r">(Mk. 5:21-43; Lk. 8:40-56)</para>
  <para style="p">
    <verse number="18" style="v"/>Mati Yësu ëdï kö'du nenye kiya, vïdï mï turu 'ba Yuda'e ayi zi mo alɔmvɔ akaŋo komo mo iya henye, “Wu'jë 'bama oli ku yaanya ayi ï'dï kala yï dɔ mo zi mo tëdï na dïdï.” <verse number="19" style="v"/>Yësu ënyï rïyë alö'bö gbɔ gɔ mo mora vo lö'bö 'bɔmo'e ï'bënnï gbɔ mo aba. <verse number="20" style="v"/>Mbara maako ëdï na riti, kö'du yama ëdï taho ta rɔ mo kɔɔ 'butë dɔmorïyö, ayi ta kafo Yësu ise da ha bɔngɔ 'bɔmo gbɔ. <verse number="21" style="v"/>Mo iya na bi dënï henye, “Ëzë mise gbï le nje ra 'bɔngɔ ɔmo, akakɔ'jɔ ma.” <verse number="22" style="v"/>Yësu opi rë nï ongɔ mo, iya henye, “Ëdï na kyigɔ wu'jë ama! Koma 'bëyï akɔ'jɔ yï ku.” Tëmï kadra ne mbara ne akɔ'jɔ rë nï gbɔ na laka. <verse number="23" style="v"/>Mati Yësu ödu mï loko 'ba turu kyedre ne, mo i'ja vïdï kayo ëdïnnï kyëzu 'ba da koli kome. <verse number="24" style="v"/>Mo iya zi zë henye, “Vïdï biya asiye yaga. Wu'jë tisi ne oli dë mo ëdï nje ako'do!” Here zë biya ogonnï mo gbɔ. <verse number="25" style="v"/>Kandi ma ti ore vïdï ne'e ku yaga, Yësu ï'bë mï loko ma yöku wu'jë dɔ mo ne, ïrï kala mo mo ënyï gbɔ rïyë. <verse number="26" style="v"/>Kö'du yöyö ne apere rë nï biya tëmï dakaŋo nani.</para>
  <para style="s">Yësu akɔ'jɔ vo komoköndu rïyö</para>
  <para style="p">
    <verse number="27" style="v"/>Yësu ila bi nani ëdï ku atï'bë, vo komoköndu rïyö ayetonnï lö'bö ga ndï mo. Zë agbögbönnï hë nnï, iyannï henye, ï'dï mïyï mëyï re ze, “Asösu kö'du ze, Wisi 'ba Dawidi!” <verse number="28" style="v"/>Mati Yësu ödu loko, vo komoköndu rïyö ne ayinnï zi mo, mo ako'jo hë zë iya henye, “Oma'e ku zi matɔ'bɔ 'e kɔ'jɔ?” Zë aya'bannï da me'do, iyannï henye, “Ɔɔ Yere.” <verse number="29" style="v"/>Yësu ise komo zë, iya henye, “Mo'dɔ rë nï kaa ma oma'e” <verse number="30" style="v"/>komo zë ayëhu rë nï gbɔ. Yësu ise gɔ mo zi zë iya henye, “Ayada'e kö'du nenye dë zi vïdï maako!” <verse number="31" style="v"/>Mora zë ï'bë a yëlënnï kö'du ne ta ga bi nani ti'de.</para>
  <para style="s">Yësu akɔ'jɔ kora ma ɔ'bɔ dë zi me'do</para>
  <para style="p">
    <verse number="32" style="v"/>Mati vïdï kora ne'e ëdïnnï atï'bë, kya, vïdï maako'e ikannï kora maako zi Yësu, mo ɔ'bɔ dë zi me'do ga kö'du mo ëdï dakyikyi aba. <verse number="33" style="v"/>Mora kandi ma ti ore dakyikyi ku yaga, kora ne ayeto me'do mora vïdï biya na rakaga. Zë iyannï henye “Gba dongɔ kö'du ma hee ne dë mï Yiserele.” <verse number="34" style="v"/>Mora Farasiye iyannï henye, “Ne yere 'ba dakyikyiye ra ï'dï kyigɔ ne zi Yësu zi dakyikyiye kore yaga.”</para>
  <para style="s">Yësu asösu rë nï ga kö'du vïdï</para>
  <para style="p">
    <verse number="35" style="v"/>Yësu ënyï ï'bë biya lasi aba tëmï gawo daliŋɔ aba. Mo ayandi kö'du mï bi 'ba mötu'e, kö'du yöyö laka 'ba damöku 'ba Wïrï yëtï aba, mora akɔ'jɔ vïdï kayo dakyïnë 'ba kɔɔ aba. <verse number="36" style="v"/>Mati mo ongɔ vïdï kayo, di'di mo oso kyɔ kö'du sösu aba ga kö'du zë na kö'du sösu, wakɔnyi kpa anza dë kaa tïmëlë kazi vo yako. <verse number="37" style="v"/>Here mo iya zi vo lö'bö 'bënnïye henye, “Wa mï yaka ëdï kyɔ, mora vo lɔɔ ko'dɔ'e ayonnï dë. <verse number="38" style="v"/>Amötu zi vo kyeti yaka nenye, mo mutu yaga vo lɔɔ'e zi wa 'bɔmo toto mo ta yaka.”</para>
  <chapter number="10" style="c"/>
  <para style="s">Vo Lïtu 'butë dɔmorïyö</para>
  <para style="r">(Mk. 3:13-19; Lk. 6:12-16)</para>
  <para style="p">
    <verse number="1" style="v"/>Yësu akɔ'jɔ vo lö'bö 'butë dɔmorïyö 'bënïye bi kölö ï'dï kyigɔ zi zë kore dakyikyi yaga, zi kɔ'jɔ kɔɔ rakɔɔ aba biya. <verse number="2" style="v"/>Nenye'e ru 'ba vo lïtu, butë dɔmorïyö ne'e ma dagba Simona (ma ako'jo Petero) öndu mo: Anderiya, Yemisi öndu nï Yowani aba, gisi 'ba Zebedeyo. <verse number="3" style="v"/>Pilipo, Baratolomoya, Toma, Matayo, vo 'be'bele kö'du, Yemisi wisi 'ba Alipayo Tadöyösu, <verse number="4" style="v"/>Simona vo dakaŋo 'ba Kanana zë Yudasi Sikereto ma asösu Yësu aba.</para>
  <para style="s">Lɔɔ 'ba vo lö'bö 'butë dɔmorïyö</para>
  <para style="r">(Mk. 6:7-13; Lk. 9:1-6)</para>
  <para style="p">
    <verse number="5" style="v"/>Vïdï kora 'butë dɔmorïyö ne'e, Yësu utu zë kö'du kira nenye aba. “Ï'bë'e dë mï dakaŋo 'ba vo leze'e mandere mï gawo 'ba Samarona'e. <verse number="6" style="v"/>Omba zi ye tï'bë zi tïmëlë 'ba Yiserele ma ölu. <verse number="7" style="v"/>Ï'bë'e ayëtïye, ‘Damöku 'ba Wïrï ëdï ku kara.’ <verse number="8" style="v"/>Akɔ'jɔ'e vo kɔɔ, ayɔmɔ'e yöku löhu na dïdï, akɔ'jɔ'e zë ma na riti kɔɔ mönyu aba, ore'e dakyikyi yaga. I'ja'e kazi ma na mbiya, here ï'dïye kpa zi zë na mbiya. <verse number="9" style="v"/>Ïnjë'e dahabo ako dë, kɔhi mandere meŋe kɔhi mï bɔngɔ re 'e. <verse number="10" style="v"/>Ïnjë'e aŋboro 'ba wa lenze dë ta bi tï'bë 'be'e, oba'e nje bɔngɔ kamoka ma ëdïye akusu ne. Oba'e mɔvɔ 'ba lasi dë, vo lɔɔ'e akï'dï zi zë wa ma zë ombannï.”</para>
  <para style="p">
    <verse number="11" style="v"/>“Ëzë ayiye mï gawo, ï'bë'e bi koma kö'du vïdï ma akïrïye kala kyedre aba, alima'e mo aba le zi ye bi nani kila. <verse number="12" style="v"/>Ëzë ï'bë'e mï liŋɔ iya'e henye, ‘Rakyëyï mëdï ëtï.’ <verse number="13" style="v"/>Ëzë vïdï mï liŋɔ nani ïrïye kala kyedre aba, ï'dïye wa mëtë 'be'e 'ba rakyëyï malima, ëzë zë ïrïnnï 'e dë kïrï kala kyedre aba, oba'e wa mëtë'e hulëhu. <verse number="14" style="v"/>Ëzë kya 'ba liŋɔ mandere gawo omba dë bi 'e kïrï kala kyedre aba mandere kö'du 'be'e kowo, ila'e bi nani akyitɔ'e turufu 'de ta ndïye zi mo na lömu rë zë. <verse number="15" style="v"/>Mayada zi ye tïnyö, mï kadra 'ba vurë aba atëdï na kyënyë ndra kö'du gawo nani ta da gawo 'ba Sɔdɔmo, Gɔmora aba.”</para>
  <para style="s">Yësu ame'do kö'du 'ba riti</para>
  <para style="r">(Mk. 13:9-13; Lk. 21:12-17)</para>
  <para style="p">
    <verse number="16" style="v"/>“Owo'e te, mëdï 'e kutu yaga kaa tïmëlë mï kutë wölïwölï. Here ëdïye ŋbala kaa wiriye. Mora ëdïye kpa kaa atu'bu o'dɔnnï kö'du kyënyë dë. <verse number="17" style="v"/>Ongɔ'e re 'e laka, ga kö'du vïdï maako atëdïnnï ani zë akïrï nï 'e akika bi 'ba vurë mora zë aku'bönnï 'e mï bi 'ba mötu'e. <verse number="18" style="v"/>Kö'du ma, akika 'e bi 'ba vurë komo vo dakaŋo yere ëtï, zi kö'du yöyö laka ne yada zi zë zi vo leze'e. <verse number="19" style="v"/>Ëzë ikannï 'e bi 'ba vurë, asösu'e dë a'di ra atï'bë'e zi kiya, mandere hala akonyo'e. Mï kadra nani mo ɔkɔ ku, akï'dï zi ye a'di akiya'e. <verse number="20" style="v"/>Ga kö'du me'do ma akame'do 'e atanza dë 'be'e, zë atayinnï kazi Lawo Kölö Laka 'ba 'bu'e akame'do kpuru kazi 'e.”</para>
  <para style="p">
    <verse number="21" style="v"/>“Ɔndu'e atënyïnnï akpa da öndu'e zë kï'dï zi kofo. 'Bu'e atënyïnnï akpa da gisisi 'bënnïye zë kï'dï zi kofo. Gisisiye ako'dɔnnï wehe akpa vo ko'jo zë aba akutu zë zi kofo. <verse number="22" style="v"/>Vïdï biya akiyïye ga kö'du ma. Mora vïdï ma nduwë na kyigɔ le mï ndundu mo, akayɔmɔ mo. <verse number="23" style="v"/>Ëzë o'dɔ'e na kyënyë mï gawo maako, aho'e mï gawo ma agamo. Ma yada zi ye tïnyö, inde'e lɔɔ ne'e mï gawo biya 'ba Yiserele ne dë, gba kazi Wisi a Vïdï tɔkɔ. <verse number="24" style="v"/>Vo kö'du ko'jo anza kyedre ta da vo komoyandi 'bënï. Vo yasa anza kyedre ta da vo kyedre 'bënï. <verse number="25" style="v"/>Here vo kö'du ko'jo mo'bɔ zi tëdï kaa vo komoyandi 'bënï, vo lö'bö kaa vo kyedre 'bënï. Ëzë vo da dakota ako'jo Belezobulu, vo dakota 'ba liŋɔ'e ako'jo ru kyënyë aba.”</para>
  <para style="s">Atere ëyï</para>
  <para style="r">(Lk. 12:2-7)</para>
  <para style="p">
    <verse number="26" style="v"/>“Here ere'e vïdï dë. Yaanya aba, wa ma ayöfu dɔ mo, akayëhu, kö'du koho biya ako'dɔ na yɔlɔ. <verse number="27" style="v"/>Wa mati mëdï ayada zi ye mï mandölu, akayada'e mï bikanyi kyedre, wayawaya 'be'e akame'do ta da tɔlɔ 'ba loko. <verse number="28" style="v"/>Ere'e dë kazi vïdï ma ëdïnnï ida ra kofo, ofonnï lawo dë. Ere'e Wïrï ma akatɔ'bɔ yaŋa 'dö ida ra lawo aba mï wa'do gehena. <verse number="29" style="v"/>Nje tarifa kölö akatɔ'bɔ silɔ kogo rïyö. Here silɔ ma kölö alëpï dë akaŋo kazi da kö'du komba 'ba 'bu'e. <verse number="30" style="v"/>Ga kö'du yëvu biya ma de 'e ne, ëdï akiti. <verse number="31" style="v"/>Here ere'e dë ëdïye na laka ndra ta da silɔ kayo.”</para>
  <para style="s">Kö'du kyënyë yasi Yësu komba dë aba</para>
  <para style="r">(Lk. 12:8-9)</para>
  <para style="p">
    <verse number="32" style="v"/>“Here kö'du zë ma iyannï mï vïdï kayo zë 'bama, mako'dɔ kpa here komo 'bu ma komorïyë. <verse number="33" style="v"/>Mora here, ëzë vïdï maako omba ma dë ta komo vïdï kayo, ma komba mo kpa dë ta komo 'bu ma komorïyë.”</para>
  <para style="s">Anza rakyëyï ra dë wa ne kulu ra</para>
  <para style="r">(Lk. 12:51-53; 14:26-27)</para>
  <para style="p">
    <verse number="34" style="v"/>“Asösu'e dë henye ere, mayi zi rakyëyï ra kika mï damöku. 'E'e, mayi dë zi rakyëyï ra kika, kulu ra. <verse number="35" style="v"/>Mayi zi gisi kora'e tënyïnnï wehe aba da 'bu nnï, gisi mïnzö'e tënyïnnï wehe aba da ma nnï, mbara koze atënyïnnï wehe aba da wese nnï. <verse number="36" style="v"/>Vo wehe kyënyë 'be'e, atëdï akpa vïdï 'ba dakota 'be'e.</para>
  <para style="p">
    <verse number="37" style="v"/>“Zë ma o'dɔnnï lɔvɔ 'bu nnï, mandere ma nnï ndra ta da ma, ɔ'bɔnnï dë zi tëdï na vo lö'bö 'bama. Zë ma o'dɔnnï lɔvɔ gisi kora 'bënnï, mandere wisi wu'jë ɔ'bɔnnï dë zi tëdï na vo lö'bö 'bama. <verse number="38" style="v"/>Zë ma ïnjënnï taka 'bënnï dë rïyë zi lö'bö ga ndï ma, ɔ'bɔnnï dë zi tëdï na vo lö'bö 'bama. <verse number="39" style="v"/>Zë ma o'dɔnnï lɔvɔ dïdïnnï ndra ta da lɔvɔ ma, akayölunnï. Zë ma ayölunnï dïdïnnï ga kö'du ma, aki'jannï dïdï löhu.”</para>
  <para style="s">Biriti</para>
  <para style="r">(Mk. 9:41)</para>
  <para style="p">
    <verse number="40" style="v"/>“Vïdï ma ïrïye kala kyedre aba ïrï ne ma ra, mora vïdï ma ïrï ma kala kyedre aba, ïrï ne vïdï ma utu ma ne. <verse number="41" style="v"/>Vïdï ma ïrï nëbï kala kyedre aba ga kö'du mo nëbï, aki'ja mï wakinye 'ba biriti 'ba nëbï. Vïdï ma ïrï vïdï ma laka kala kyedre aba ga kö'du mo na laka, aki'ja mï wa yanya 'ba biriti 'ba vïdï laka. <verse number="42" style="v"/>Ëzë vïdï ma ï'dï gbï le nje sikɔ 'ba wini kyëyï, zi vïdï ma kölö 'ba ga ndï ma, vïdï nani aki'ja biriti rë nï.”</para>
  <chapter number="11" style="c"/>
  <para style="s">Vo lïtu'e kazi Yowani Bapatisi</para>
  <para style="r">(Lk. 7:18-35)</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu inde kö'du nenye'e yada mo zi vo lö'bö 'bënï 'butë dɔmorïyö ne'e, mo ila bi nani ï'bë kö'du yandi yëtï aba mï gawo 'ba Galilaya'e. <verse number="2" style="v"/>Mati Yowani Bapatisi owo mï kamba, kö'du Korisitɔ ëdï ako'dɔ ne, mo utu kya 'ba vo lö'bö 'bënïye zi mo. <verse number="3" style="v"/>Zë ako'jonnï ha Yësu iyannï henye, “Ayada zi ze, yï ra kora ma omba tayi kɔdɔ dida ze bi vïdï maako?” <verse number="4" style="v"/>Yësu aya'ba da me'do iya henye, “Ï'bë'e a'ba'e hulëhu ayada'e zi Yowani kö'du ma ëdï akowo'e kongɔ mo aba. <verse number="5" style="v"/>Vo komoköndu atɔ'bɔ bi kongɔ, vo keŋe atɔ'bɔ lasi, zë ma ëdïnnï na riti kazi kɔɔ mönyu o'dɔ zë ŋbala, vo mbilikïsï owo kö'du, yöku vïdï ënyïnnï löhu na dïdï, kö'du yöyö laka ëdï yëti mo zi vo leriye. <verse number="6" style="v"/>Rakyenyi ëdï zi zë ma anza nnï dë dajijï aba ga kö'du ma.”</para>
  <para style="p">
    <verse number="7" style="v"/>Mati vo lö'bö a Yowani ëdï atï'bënnï, Yësu ame'do kö'du mo zi vïdï kayo: “Mati ï'bë'e yaga zi Yowani mï da lïpï, a'di ra omba'e zi kongɔ? Rakïdë 'ba mbili loma mï buluku? <verse number="8" style="v"/>A'di ra ï'bë'e yaga zi kongɔ? Vïdï kora usu rë nï mï bɔngɔ laka? Vïdï ma usu rë nnï kaa mahere ne alimannï mï loko kyedre a yere. <verse number="9" style="v"/>Ayada'e zi ma a'di ra ï'bë'e yaga zi kongɔ? Nëbï ra? Ɔɔ ongɔ'e ndra ta da nëbï. <verse number="10" style="v"/>Here kö'du yöru ra iya kö'du ga kö'du mo, ‘Ma kutu vo lö'bö ama dagba komo yï zi gërï yëhu zi bi yï.’ <verse number="11" style="v"/>Ma yada zi ye tïnyö, Yowani Bapatisi ëdï kyedre ta da vïdï maako, mo maako ma tisiwa mï damöku 'ba Wïrï kyedre ta da Yowani. <verse number="12" style="v"/>Mï kadra ma Yowani Bapatisi ayëtï kö'du 'bënï le mï ko'do nenye damöku 'ba Wïrï ëdï tövu kyedre kyigɔ aba. Kora vo wehe ko'dɔ'e ï'dï rë nnï zi kuru mo na gbörökötö. <verse number="13" style="v"/>Here le mï kadra 'ba Yowani nëbïye biya kö'du kï'dï 'ba Mosa ame'do kö'du 'ba damöku. <verse number="14" style="v"/>Ëzë omba'e zi koma mï kö'du kise 'bëzë, Yowani mo Eliya, ma kö'du tayi 'bɔmo ayëtï. <verse number="15" style="v"/>Owo'e kö'du ne ëzë ëdïye mbili aba!”</para>
  <para style="p">
    <verse number="16" style="v"/>“Yaanya aba, kaa a'di ma kiya ga kö'du vïdï ma ëdïnnï mï ko'do ma ndenye ne? Zë kaa gisisi ma ëdïnnï alima mï bi 'ba wakogo. Gbɔngɔ ma kölö akagbögbö hë nnï zi maako'e akiya.</para>
  <para style="q">
    <verse number="17" style="v"/>‘Henye, dɔlɔ kudï 'ba rakoze zi ye,</para>
  <para style="q">mora ɔlɔ'e dë.</para>
  <para style="q">Daya'bi ze ngala 'ba dakoli,</para>
  <para style="q">mora udu'e dë.’</para>
  <para style="m">
    <verse number="18" style="v"/>Mati Yowani ayi, mo oro hë nï uwë a'ji dë vïdï biya iyannï henye, ‘Mo ëdï dakyikyi aba.’ <verse number="19" style="v"/>Mati Wisi a Vïdï ayi, mo onyo wa, uwë a'ji. Mora vïdï iyannï henye, ongɔ'e bi te da kora ne. Mo onyo wa takanyi. Uwë a'ji kpa takanyi mo aboka 'ba vo 'be'bele kö'du'e vo kö'du kyënyë ko'dɔ'e ëtï. Mora kö'du yɔlɔ a Wïrï ëdï na yada zi tëdï tïnyö tëmï wa ma o'dɔ rë nï.”</para>
  <para style="s">Vïdï 'ba gawo naniye owonnï kö'du dë</para>
  <para style="r">(Lk. 10:13-15)</para>
  <para style="p">
    <verse number="20" style="v"/>Vïdï ma mï gawo ma Yësu o'dɔ kö'du ko'do kyedre ënï mï zë ne, 'de otɔ dë nnï dë tëmï kö'du kyënyë 'bënnï, here mo iya zë na kyënyë. <verse number="21" style="v"/>“Atëdï zi ye kyënyë Korɔzini! Atëdï zi ye kyënyë Beteseyida! Ëzë kö'du ko'do ma o'dɔ mï ye ne o'dɔ mï Tiyere, Sidoni aba kani vïdï nani usunnï bɔngɔ 'ba lubë ku rë nnï zi yada henye ere zë otɔnnï dë nnï ku tëmï kö'du kyënyë 'bënnï. <verse number="22" style="v"/>Ma yada zi ye henye, mï ko'do 'ba vurë aba, Wïrï akila vïdï 'ba Tiyere, Sidoni aba tada'e. <verse number="23" style="v"/>Yï Kaparanamo! Omba'e zi re 'e kïnjë komorïyë? Aku'du'e akaŋo mï wa'do 'ba gehena. Ëzë kö'du ko'do ma o'dɔ mï ye ne mo'dɔ mï Sɔdɔmo, atëdï zɔ kadra ndenye aba. <verse number="24" style="v"/>Akatɔ'bɔ yɔlɔ'e henye, mï ko'do 'ba vurë aba Wïrï rasösu ndra kö'du Sɔdɔmo tada'e!”</para>
  <para style="s">Ayiye zi ma zi lawo</para>
  <para style="r">(Lk. 10:21-22)</para>
  <para style="p">
    <verse number="25" style="v"/>Mï kadra nani Yësu iya henye, “'Bu Yere 'ba komorïyë dakaŋo aba! Mo'dɔ öwö'dï zi yï ga kö'du zi vo kazi kö'du yɔlɔ'e, wa ma oho kazi vo kö'du yɔlɔ'e vo yandi ëtï ayada ku zi gisisiye. <verse number="26" style="v"/>Ɔɔ, 'bu, nenye hala wa ma omba kani zi rë nï ko'dɔ. <verse number="27" style="v"/>'Bu ma ï'dï wa ku biya zi ma. Vïdï maako ayɔlɔ Wisi dë nje 'Bu. Vïdï maako ayɔlɔ 'bu dë nje Wisi, zë ma Wisi inzi zi nnï yada.”</para>
  <para style="p">
    <verse number="28" style="v"/>“Ayiye zi ma 'e biya ma na riti kazi wayeto kïnjë makï'dïye alawo. <verse number="29" style="v"/>O'dɔ 'e lɔɔ 'bama, ayandi 'e kazi ma, ga kö'du ma vo watɔwɔ raya'ba aba. Here aki'ja'e ralawo. <verse number="30" style="v"/>Lɔɔ 'bama ayeto dë. Kïnjë mo na pëlë.”</para>
  <chapter number="12" style="c"/>
  <para style="s">Kö'du ko'jo ga kö'du ko'do 'ba ralawo</para>
  <para style="r">(Mk. 2:23-28; Lk. 6:1-5)</para>
  <para style="p">
    <verse number="1" style="v"/>Anza na kɔwɔ ta gɔ mo, Yësu ëdï gbɔ tï'bë kpuru tëmï yaka 'ba nyenyo mï ko'do 'ba ralawo aba. Vo lö'bö 'bɔmo'e gbɔ na o'bo, here ayetonnï da mbili nyenyo kowe ï'jö mo konyo. <verse number="2" style="v"/>Mati Farasi ongɔnnï kö'du ne here, zë iyannï zi Yësu henye, “Ongɔ te, anza na laka mï kö'du kï'dï 'beze zi vo lö'bö 'bëyïye kö'du mahere ne, ko'dɔ mï ko'do 'ba ralawo!” <verse number="3" style="v"/>Yësu aya'ba da me'do iya henye, “Ako'jo'e kö'du ma Dawidi o'dɔ mï kadra nani ma mo vïdï 'bënï ëtï na o'bo ne dë? <verse number="4" style="v"/>Mo ï'bë ödu mï loko 'ba Wïrï, mo nnï vïdï 'bënï ëtï onyonnï mangɔlɔ'bɔ koro ma ï'dï zi Wïrï, ëdï le mï kö'du kï'dï anza dë zi zë konyo mo, nje vo karasa ra akila zi konyo mo. <verse number="5" style="v"/>Kɔdɔ ako'jo'e dë mï kö'du kï'dï 'ba Mosa iya henye, tëmï ko'do 'ba ralawo biya vo kö'du yëtï mï yëkëlu 'ba Wïrï zë oronnï ko'do 'ba ralawo dë, here zë anza nnï dë na lïtë? <verse number="6" style="v"/>Ma yada zi ye henye, wa maako ëdï kinye kyedre ta da yëkëlu. <verse number="7" style="v"/>Ködu yöru iya henye, momba ngötu kumu dë, momba 'e zi tëdï na mïkuku. Ëzë ayɔlɔ'e mï kö'du nenye ku, ɔ'bɔ'e dë zi vurë kikye ra vïdï ma o'dɔnnï kö'du kyënyë ako dë. <verse number="8" style="v"/>Wisi a Vïdï Yere 'ba ko'do 'ba ralawo ra.”</para>
  <para style="s">Kora vo kala keŋe</para>
  <para style="r">(Mk. 3:1-6; Lk. 6:6-11)</para>
  <para style="p">
    <verse number="9" style="v"/>Yësu ila bi nani ënyï ï'bë bi 'ba mötu. <verse number="10" style="v"/>Kora maako ëdï ani na vo kala keŋe. Kya 'ba vïdï maako'e ëdïnnï ani ombannï zi Yësu susu ga kö'du kyënyë ko'dɔ ako'jonnï hɔ mo iyannï henye, “Ëdï na kyënyë mï kö'du ki'di 'beze zi vïdï kɔ'jɔ mï ko'do 'ba ralawo?” <verse number="11" style="v"/>Yësu aya'ba da me'do iya henye, “A'di, ëzë vïdï ma kölö tëmï 'e ëdï tïmëlë aba alëpï mï wogo yöndu mï ko'do 'ba ralawo, akasösu kö'du mo dë zi kotɔ mo yaga? <verse number="12" style="v"/>Vïdï köndu ra laka ndra ta da tïmëlë! Here ne, kö'du kï'dï 'beze ila ze zi vïdï maako kɔnyi mï ko'do 'ba ralawo aba.” <verse number="13" style="v"/>Here mo iya zi kora 'ba kala keŋe ne henye, “Iza ga kala yï yaga.” Mo iza gɔ mo yaga, gbɔ na laka löhu kaa agamo ne. <verse number="14" style="v"/>Here Farasiye ï'bënnï o'dɔnnï mala zi Yësu kofo.</para>
  <para style="s">Vo lïtu kinzi a Wïrï ra Yësu?</para>
  <para style="p">
    <verse number="15" style="v"/>Mati Yësu owo kö'du mala rë nï ne, mo ï'bë 'de ta bi nani, mora vïdï kayo alö'bönnï gbɔ ga ndï mo aba. Mo akɔ'jɔ vïdï ma zë na rakɔɔ ne'e biya, <verse number="16" style="v"/>mo ise gɔ mo zi zë iya henye, mayadannï kö'du nï dë zi vïdï maako'e. <verse number="17" style="v"/>Mo o'dɔ here zi rë nï ko'dɔ kaa kö'du ma nëbï Yisaya ayi ku tïnyö.</para>
  <para style="q">
    <verse number="18" style="v"/>“Kinye ëdï vo lö'bö ama ma minzi.</para>
  <para style="q">Mo ma mo'dɔ lɔvɔ mo.</para>
  <para style="q">Kö'du mo, ma na rakyenyi.</para>
  <para style="q">Ma kutu Lawo Kölö Laka ama dɔ mo,</para>
  <para style="q">mo akayöyö kö'du vurë ama zi vïdï.</para>
  <para style="q">
    <verse number="19" style="v"/>Mo awasa mandere ha gbögbö dë</para>
  <para style="q">mandere me'do na gu ŋberere da gëri.</para>
  <para style="q">
    <verse number="20" style="v"/>Mo owe loma ma ïdë rë nï ku ne dë,</para>
  <para style="q">mandere yölu lamba ma omba ku kara tɔrɔ kazi lëru.</para>
  <para style="q">Mo atëdï nduwë, le mo ako'dɔ vurë ma laka 'ba kpilïrï.</para>
  <para style="q">
    <verse number="21" style="v"/>Tu'dë biya akï'dï kö'du sösu 'bënnï mï mo.”</para>
  <para style="s">Yësu Belezobulu aba</para>
  <para style="r">(Mk. 3:20-30; Lk. 11:14-23)</para>
  <para style="p">
    <verse number="22" style="v"/>Here kya 'ba vïdï maako'e ikannï kora vo komoköndu maako zi Yësu, ɔ'bɔ dë zi me'do ga kö'du mo ëdï dakyikyi aba. Yësu akɔ'jɔ kora ne, here mo ɔ'bɔ zi me'do bi kongɔ aba. <verse number="23" style="v"/>Vïdï biya na rakaga tëmï kö'du ma Yësu o'dɔ ne. Zë ako'jonnï kö'du iyannï henye, “Mo atëdï Wisi 'ba Dawidi ra?”</para>
  <para style="p">
    <verse number="24" style="v"/>Mati Farasiye owonnï kö'du ne, aya'bannï dɔ mo iyannï henye, “Mo ore dakyikyi ne'e yaga, ga kö'du vo dë zë Belezobulu ra, ï'dï kyigɔ ne zi mo zi ko'dɔ here.” <verse number="25" style="v"/>Yësu ayɔlɔ kö'du ma zë ëdïnnï asösu, mo iya zi zë henye, “Dakaŋo ma inye rë nï na gbɔngo gbɔngo wehe ko'dɔ oka ani aba, alima na konda dë. Gawo maako, mandere dakota ma inye rë nï na gbɔngo gbɔngo wehe ko'dɔ oka maako aba akalëpï. <verse number="26" style="v"/>Here ëzë gbɔngo ma kölö ëdï wehe ko'dɔ oka nï vere aba mï damöku a Satani, nenye kö'du ya'ba aba henye, inye rë nï ku nzɔ na gbɔngo gbɔngo kandi apere rë nï. <verse number="27" style="v"/>Iya'e henye, mo ore dakyikyi yaga kyigɔ 'ba Belezobulu aba, mora ëyï ra ï'dï zi vo ga ndï yïye kyigɔ ne zi zë kore yaga? Zë atëdï na vo vurë 'bë 'e. <verse number="28" style="v"/>Ëzë mora dakyikyi kyigɔ 'ba Lawo 'ba Wïrï, here damöku a Wïrï ayi ku de 'e.”</para>
  <para style="p">
    <verse number="29" style="v"/>“Vïdï maako ɔ'bɔ dë tödu mï loko 'ba kora ma na kyigɔ zi wasisi ɔmo koba, nje ëzë mo ida kora kyigɔ ne dagba atehe 'da loko ɔmo kolɔ.”</para>
  <para style="p">
    <verse number="30" style="v"/>“Vïdï ma anza dë 'bama, mo ëdï tïnyö kö'du aba ra ma. Vïdï ma akɔnyi ma dë zi toto, ëdï tïnyö pere mo. <verse number="31" style="v"/>Ma yada zi ye henye, atɔ'bɔ vïdï kila ga kö'du kyënyë mati o'dɔnnï, kö'du kyënyë kiya aba, mora vïdï mati iya kö'du kyënyë ra Lawo Kölö Laka, ila mo dë. <verse number="32" style="v"/>Vïdï mati iya kö'du kyënyë ra Wisi a Vïdï akila mo, vïdï mati iya kö'du kyënyë ra Lawo Kölö Laka ila mo dë yaanya aba ŋburu.”</para>
  <para style="s">Kaga lɔgɔ nï aba</para>
  <para style="r">(Lk. 6:43-45)</para>
  <para style="p">
    <verse number="33" style="v"/>“Zi tëdï lɔgɔ laka aba ëdï kaga ma laka aba. Ëzë ëdï kaga ma kyënyë aba atëdï lɔgɔ ma kyënyë aba. Kaga akayɔlɔ tara dakyïnë 'ba lɔgɔ ma ana. <verse number="34" style="v"/>'E wiri ne'e, hala akiya'e kö'du ma laka, mora 'e Satani? Ha akiya wa ma ëdï. Ndɔ mï didi mo aba. <verse number="35" style="v"/>Vïdï ma laka akɔdɔ gbï wa ma laka ga kö'du laka ënï, vïdï ma kyënyë akɔdɔ gbï kö'du kyënyë ga kö'du kyënyë ënï. <verse number="36" style="v"/>Ayɔlɔ'e henye kadra 'ba vurë aba, vïdï biya na kölö kölö akayëtï kö'du kyënyë ma mo iya. <verse number="37" style="v"/>Me'do hë yï ra, akpa ako'dɔ vurë mo aba rë yï, zi yɔlɔ yï vo kö'du laka kɔdɔ vo kö'du kyënyë.”</para>
  <para style="s">Kö'du ko'jo ga kö'du ko'do</para>
  <para style="r">(Mk. 8:11-12; Lk. 11:29-32)</para>
  <para style="p">
    <verse number="38" style="v"/>Here kya 'ba vo komoyandi 'ba kö'du kï'dï maako'e, kya 'ba Farasi maako'e ëtï, ame'donnï rïyë iyannï henye, “Vo komoyandi, domba zi yï kongɔ ta bi kö'du ko'do ko'dɔ.” <verse number="39" style="v"/>Mo aya'ba dɔ mo zi zë iya henye, “Hala vïdï kyënyë 'ba kazi wiri ëdïnnï kadra ndenye aba. Ako'jo'e ha ma ga kö'du ko'do? 'E'e! Kö'du ko'do ma akayada zi ye atëdï nje kö'du ko'do 'ba nëbï Yona. <verse number="40" style="v"/>Tëmï gërï kölö ne Yona o'do kadra wota yɔndɔ aba mï kyenze, here Wisi a Vïdï ako'do kadra wota yɔndɔ aba mï hu kaŋo yöndu ne. <verse number="41" style="v"/>Mï ko'do 'ba vurë aba, vïdï 'ba Nïnëwë atënyïnnï rïyë akasusunnï 'e ga kö'du zë otɔnnï dë nnï ku tëmï kö'du kyënyë 'bënnï, ma owonnï kö'du yëtï 'ba Yona ne. Ma yada zi ye, wa kyedre maako ëdï kinye ta da Yona. <verse number="42" style="v"/>Mï ko'do 'ba vurë aba yere mbara 'ba daliŋɔ 'ba Seba atënyï rïyë 'e susu ga kö'du mo ï'bë tëmï gërï ne biya tëmï kaŋo 'bënï kö'du me'do yɔlɔ yandi 'ba yere Solomono kowo. Miya zi ye henye, wa ëdï kinye kyedre ta da Solomono!”</para>
  <para style="s">Ta'ba 'ba dakyikyi</para>
  <para style="r">(Lk. 11: 24-26)</para>
  <para style="p">
    <verse number="43" style="v"/>“Ëzë dakyikyi asi ku yaga tara vïdï, ï'bë lasi aba dakaŋo maako bi lawo koma. Ëzë i'ja dë, <verse number="44" style="v"/>akiya na bi dënï henye, ‘Ma ta'ba hulëhu liŋɔ ama ma mila ne.’ Here ï'bë hulëhu i'ja loko na mbiya, ŋbala na laka. <verse number="45" style="v"/>Here ënyï ï'bë yaga ika aboka nïye madɔmorïyö dakyikyi maako'e na kyënyë ta da nï, zë ayinnï alimannï gbɔ ani. Ëzë inde rë nï ku, vïdï nani ëdï mï riti kyënyë ta da ma dagba. Nenye ëdï kö'du ma ako'dɔ rë nï zi vïdï ma kyënyë'e mï ko'do nenye.”</para>
  <para style="s">Ma 'ba Yësu öndu mo ëtï</para>
  <para style="r">(Mk. 3:31-35; Lk. 8:19-21)</para>
  <para style="p">
    <verse number="46" style="v"/>Mati Yësu ëdï gba ame'do zi vïdï kayo, ma mo öndu mo ëtï ɔkɔnnï gbɔ. Zë ɔrɔnnï yaga kö'du ko'jo zi me'donnï zi mo. <verse number="47" style="v"/>Here vïdï maako tëmï vïdï naniye iya zi mo henye, “Ongɔ te ma yi, öndu yï ëtï ëdïnnï atɔrɔ yaga, ombannï zi me'do zi yï.” <verse number="48" style="v"/>Yësu aya'ba da me'do iya henye, “Ëyï 'bënï ma ma? Ëyïye ra öndu ma'e?” <verse number="49" style="v"/>Mo ënyï ayada bi da vo lö'bö 'bënïye, iya henye, “Ongɔ te! Kinye ma ma öndu ma ëtï. <verse number="50" style="v"/>Vïdï ma o'dɔ wa ma 'bu ma komorïyë omba mo zi ko'dɔ mo ne, mo ra na öndu ma, ëmï ma ma ma.”</para>
  <chapter number="13" style="c"/>
  <para style="s">Mala 'ba vo kofo kïlï</para>
  <para style="r">(Mk. 4:1-9; Lk. 8:4-8)</para>
  <para style="p">
    <verse number="1" style="v"/>Mï ko'do kölö, Yësu ila liŋɔ ënyï ï'bë da götï 'ba föfö alima gbɔ akaŋo. <verse number="2" style="v"/>Vïdï kayo ma atoto rë nnï kpo ta rɔ mo gbɔ kyɔ, mo ëkyï mï töŋbö alima gbɔ mï mo, vïdï kayo ɔrɔ 'bënnï yaga da götï. <verse number="3" style="v"/>Mo alima kö'du yëtï zi zë kyɔ tëmï mala. Yësu iya henye, “Kadra maako aba kora maako ï'bë kofo kïlï. <verse number="4" style="v"/>Mati mo ïlï kofo mï yaka, kya mo alëpï da gërï, ali ayi onyonnï 'de. <verse number="5" style="v"/>Kya mo alëpï mï kaŋo ma ṛï'dï, kaŋo ma laka nje tisiwa aba, kandi kofo ne ötu ga kö'du kaŋo ne alo dë. <verse number="6" style="v"/>Mati kadra ese o'bɔ wevo ma luru ne'e, ga kö'du ngara'da ödu dë gbo na laka, kandi wevo ne'e akyïtu gbɔ. <verse number="7" style="v"/>Kya 'ba kofo alëpï mï kutë kono, övu mora ofo wevo mo. <verse number="8" style="v"/>Kya 'ba kofo alëpï mï kaŋo ma laka wevo mo ana ï'jö, kya mo lamikölö, aga mo'e 'butëmodaka, mora aga mo'e 'butëwota.” <verse number="9" style="v"/>Yësu inde kö'du 'bënï iya henye, “Owo'e kö'du ne, ëzë ëdï 'e mbiliye aba!”</para>
  <para style="s">Mï ï'jö 'ba mala ne</para>
  <para style="r">(Mk. 4:10-12, Lk. 8:9-10)</para>
  <para style="p">
    <verse number="10" style="v"/>Vo lö'bö'e ayinnï zi Yësu ako'jonnï hɔ mo iya henye, “Kö'du a'di ëdï 'bëyï ame'do zi vïdï tëmï mala?” <verse number="11" style="v"/>Yësu ënyï aya'ba dɔ mo iya henye, “Kö'du koho 'ba damöku 'ba Wïrï ï'dï ku zi ye, anza dë zi zë. <verse number="12" style="v"/>Mora here, vïdï ma wa aba akï'dï zi mo ndra, here mo atëdï mo aba kyɔ ta da ma ëdï. Mora vïdï mati anza wa aba dë, akoba 'de kazi mo gbï le ma tisi ma mo ëdï mo aba ne. <verse number="13" style="v"/>Mï kö'du ma mëdï ame'do zi zë tëmï mala ëdï henye,</para>
  <para style="q">‘Zë ongɔnnï bi mora ï'jannï dë,</para>
  <para style="q">zë o'je mbili nnï.</para>
  <para style="q">Mora owonnï mandere ayɔlɔnnï dë.’</para>
  <para style="m">
    <verse number="14" style="v"/>Kö'du kumë 'ba Yisaya ga kö'du 'bëzë ne henye,</para>
  <para style="q">‘Vïdï nenye'e akowonnï nje na kowo</para>
  <para style="q">mora ödu dë, dë zë.</para>
  <para style="q">Zë akongɔnnï bi akongɔ</para>
  <para style="q">mora 'de ï'jannï dë.</para>
  <para style="q">
    <verse number="15" style="v"/>Dïdï vïdï nenye'e na kyigo.</para>
  <para style="q">Mbili vïdï nenye'e yaanya aba na kïsï.</para>
  <para style="q">Zë ombannï dë zi kö'du tïnyö kongɔ.</para>
  <para style="q">Ëzë mbili zë anza dë na kisi,</para>
  <para style="q">zë akongɔnnï komo nnï aba,</para>
  <para style="q">akayɔlɔnnï dë nnï aba mora akotɔ dë nnï zi ma hulëhu,</para>
  <para style="q">mora akakɔ'jɔ zë.’”</para>
  <para style="p">
    <verse number="16" style="v"/>“Mora kö'du'e ne laka ga kö'du komo'e i'ja ku, mora mbiliye owo kpa ku. <verse number="17" style="v"/>Ëdï na laka miya zi ye nëbï kayo mora vïdï kayo a Wïrï ombannï zi ki'ja wa ma i'ja 'e ne, mora 'de ï'jannï dë, mora zë ombannï zi kowo wa ma owo'e ne, mora 'de owonnï dë.</para>
  <para style="s">Yësu ayada mï mala 'ba vo kofo kïlï</para>
  <para style="r">(Mk. 4:13-20; Lk. 8:11-15)</para>
  <para style="p">
    <verse number="18" style="v"/>“Owo'e ayandiye mï kö'du 'ba vo kofo kïlï ne. <verse number="19" style="v"/>Zë mati owonnï kö'du kise 'ba damöku ne, mora ayɔlɔnnï dë ëdïnnï kaa kofo mati alëpï da ga gërï. Satani ayi ïrï me'do ne yaga tëmï di'di zë. <verse number="20" style="v"/>Kofo mati alëpï dakaŋo ma ṛï'dï aba, ëdï zë ma owonnï kö'du ne rakyenyi aba, kandi ma owonnï. <verse number="21" style="v"/>'De ödu dë gbo mï di'di zë, mora ëhïnnï dë na konda. Here mati kö'du kyënyë maako ayi ga kö'du kise ne, akilannï 'de kandi. <verse number="22" style="v"/>Kofo ma alëpï mï kono ne, ga kö'du zë ma owonnï kö'du kise ne, kö'du sösu ga kö'du wa 'ba dakaŋo, lɔvɔ wa kyɔ ila kö'du kise ne dë tödu mï di'di zë, du anannï lɔgɔ dë. <verse number="23" style="v"/>Kofo ma ïlï mï kaŋo ma laka, ëdï kö'du zë ma owonnï kö'du kise ne, ïrïnnï gö zë ra anannï lɔgɔ, kya mo lamikölö, agamo'e 'butëmodaka mora agamo'e 'butëwota.”</para>
  <para style="s">Mala kö'du 'ba nyangölu</para>
  <para style="p">
    <verse number="24" style="v"/>Yësu ayada mala ma kya mo zi zë. “Damöku 'ba Wïrï ëdï kaa henye. Kora maako ïlï kofo ma laka mï yaka ënï. <verse number="25" style="v"/>Yɔndɔ kölö maako aba, mati vïdï o'donnï ku biya vo wehe ayi ïlï kofo nyangölu mï kutë wana, mora ï'bë wënï 'de. <verse number="26" style="v"/>Mati wevo mo övu, mbili mo omba ku zi rë nï kï'dï. Nyangölu alaya gbɔ. <verse number="27" style="v"/>Vo kalima a kora ne ayi zi mo iya henye, ‘Kyedre, kofo laka ra ïlï mï yaka 'bëyï ne. Nyangölu ne ayi 'bënï ta kila?’ <verse number="28" style="v"/>Mo aya'ba da me'do zi mo, iya henye, ‘Ne vo wehe maako ra o'dɔ kö'du ne.’ Zë ako'jonnï hɔ mo iyannï henye, ‘Omba zi ze tï'bë nyangölu ne kotɔ mo 'de yaga?’ <verse number="29" style="v"/>Mo aya'ba da me'do, iya henye, ‘'E'e, ga kö'du ëzë atoto'e nyangölu ne akotɔ'e kya wana 'dö zë ëtï. <verse number="30" style="v"/>Ila'e wana 'dö nyangölu aba mövunnï bi kölö le kadra 'ba wakumu ta yaka aba. Ma kayada zi vo lɔɔ'e, zi nyangölu kotɔ dagba, hɔ mo kida na kulu zë ko'bɔ, mora da wana toto zi kï'dï mo mï lɔ'bi.’”</para>
  <para style="s">Mala 'ba kofo masatada</para>
  <para style="r">(Mk. 4:30-32; Lk. 13:18-19)</para>
  <para style="p">
    <verse number="31" style="v"/>Yësu ayada mala ma aga mo zi zë, “Damöku 'ba Wïrï ëdï henye: Kora maako oba kofo masatada ïyï mï yaka ënï. <verse number="32" style="v"/>Kofo matisiwa aba ta da kofo biya, mati övu rïyë, gbɔ na kyedre ta da wevo biya, övu na kaga, ali ayinnï uvö loko ënnï mï ngora mo.”</para>
  <para style="s">Mala kö'du 'ba langa</para>
  <para style="r">(Lk. 13:20-21)</para>
  <para style="p">
    <verse number="33" style="v"/>Yësu nduwë mala maako yada mo zi zë iya henye, “Damöku 'ba Wïrï ëdï henye: Mbara maako oba langa asusë mï tele 'butësowɔ 'ba lunzu ï'dï gbɔ tö'bu.” <verse number="34" style="v"/>Yësu ayada kö'du nenyee zi vïdï kayo tëmï mala. Mo iya kö'du ako dë zi zë kazi mala. <verse number="35" style="v"/>Mo o'dɔ kö'du ne here zi kö'du kiya 'ba nëbï tayi tïnyö: “Ma ko'dɔ mala ëzë ma me'do zi zë. Ma kayada zi zë wa mati ayɔlɔnnï dë kyere ma damöku ï'dï rë nï ne.”</para>
  <para style="s">Yësu ayada mï mala 'ba nyangölu</para>
  <para style="p">
    <verse number="36" style="v"/>Mati Yësu ila vïdï kayo ödu loko, vo lö'bö 'bɔmowe ayinnï zi mo, iyannï henye, “Ayada dero zi ze mï mala 'ba nyangölu mï yaka ne a'di?” <verse number="37" style="v"/>Yësu aya'ba dɔ mo, iya henye, “Kora ma ïlï kofo ma laka ne Wisi a Vïdï. <verse number="38" style="v"/>Yaka damöku, kofo ma laka ne, mora vïdï ma 'bënnï 'ba damöku ne. Nyangölu ra vïdï ma 'bënnï 'ba Satani. <verse number="39" style="v"/>Vo wehe ma ïlï kofo ne mo ra Satani. Wa kumu ta yaka mora ndundu 'ba daliŋɔ, mora vo kumumo'e zë ra malayika'e.”</para>
  <para style="p">
    <verse number="40" style="v"/>“Here kaa ma nyangölu atoto dɔ mo o'bɔ mï wa'do, kö'du ne ako'dɔ rë nï here mï ndundu 'ba daliŋɔ aba. <verse number="41" style="v"/>Ëdï here, Wisi a Vïdï akutu yaga malayika ënïye, zi toto tëmï damöku ënï yaga, vïdï ma biya ëdïnnï vïdï kï'dï zi kö'du kyënyë ko'dɔ, biya agamo'e ma ëdïnnï kö'du kyënyë ko'dɔ. <verse number="42" style="v"/>Zë aku'dunnï zë mï wa'do, zë akudunnï hë nnï konyo aba. <verse number="43" style="v"/>Vïdï a Wïrï atanyinnï kaa kadra mï damöku a 'bu nnï, owo'e kö'du ne, ëzë ëdï 'e mbili aba.”</para>
  <para style="s">Mala kö'du 'ba wa koho</para>
  <para style="p">
    <verse number="44" style="v"/>“Damöku 'ba Wïrï ëdï henye, kora maako i'ja wa na koho mï yaka. Mo ayöfu dɔ mo gbɔ löhu. Mo na rakyenyi, ï'bë wogo wasisi mati mo ëdï mo aba yaga, ï'bë hulëhu wogo yaka nani gbɔ.</para>
  <para style="s">Mala 'ba ateŋe</para>
  <para style="p">
    <verse number="45" style="v"/>“Damöku 'ba Wïrï ëdï kpa kaa henye. Kora maako ëdï bi koma kö'du dahabo ma laka. <verse number="46" style="v"/>Mati mo i'ja, mo ï'bë wogo wasisi mati mo ëdï mo aba biya yaga, wogo dahabo nani gbɔ.</para>
  <para style="s">Mala 'ba kïrï kyenze</para>
  <para style="p">
    <verse number="47" style="v"/>“Damöku 'ba Wïrï ëdï kpa kaa henye, kya 'ba kora vo kyenze kïrï u'du wa 'ba kyenze kïrï ënnï yaga mï föfö, mora ïrï dakyïnë 'ba kyenze biya. <verse number="48" style="v"/>Mati wa 'ba kyenze kïrï ëdï ku ndɔ, zë otɔnnï yaga da götï alimannï gbɔ akaŋo zi mï kyenze ne yanya, ma laka ne ï'dïnnï mï baga ënnï, mati anza na laka u'dunnï zë 'de möku. <verse number="49" style="v"/>Atëdï mï ndundu 'ba daliŋɔ aba kaa nenye. Malayika atï'bënnï yaga akako'dɔnnï vïdï ma kyënyë'e tëmï ma laka <verse number="50" style="v"/>Aku'du zë mï wa'do 'ba koli ani zë akudunnï hë nnï konyo aba.”</para>
  <para style="s">Kö'du kyï ma kɔɔ aba</para>
  <para style="p">
    <verse number="51" style="v"/>Yësu ako'jo hë zë, iya henye, “Ayɔlɔ'e kö'du nenye'e ku?” Zë aya'bannï dɔ mo iyannï, “Ɔɔ.” <verse number="52" style="v"/>Here mo aya'ba dɔ mo zi zë iya henye “Vo komoyandi 'ba kö'du kï'dï ma ayandi zë kö'du 'ba Damöku 'ba Wïrï, kaa vo kyeti 'ba loko mati oba wa ma kyï ma kɔɔ aba, yaga tëmï lɔ'bi ënï.”</para>
  <para style="s">Omba Yësu dë mï Nazereta</para>
  <para style="r">(Mk. 6:1-6; Lk. 4:16-30)</para>
  <para style="p">
    <verse number="53" style="v"/>Mati Yësu inde yada mala nenye'e ku, mo ila bi nani <verse number="54" style="v"/>ënyï ï'bë hulëhu mï gawo 'bënï Nazereta. Mo ayëtï kö'du mï bi 'ba mötu, mora zë ma owonnï kö'du yëtï 'bɔmo ne, zë rakaga aba. Zë ako'jonnï kö'du, iyannï henye, “Here mo i'ja kö'du yɔlɔ mahere ne ta kila? Mora kö'du ko'do 'bɔmo ne'e? <verse number="55" style="v"/>Mo ra dë wisi 'ba vo wakïsë? Mariya ra dë ma mo, Yemisi, Yosepa, Simona, mora Yudasi, zë ra dë na öndu mo'e? <verse number="56" style="v"/>Ëmï mo'e ra dë ëdïnnï alima kinye ne? Mo i'ja kö'du nenye biya ta kila?”</para>
  <para style="p">
    <verse number="57" style="v"/>Mora here, zë ombannï mo dë. Yësu iya zi zë henye, “Nëbï oro ta ga bi ne biya nje mï gawo 'bɔmo vo dakota 'bɔmo ëtï. <verse number="58" style="v"/>Mo o'dɔ kö'du ko'do dë ani, ga kö'du zë anza nnï dë kö'du koma aba.”</para>
  <chapter number="14" style="c"/>
  <para style="s">Koli 'ba Yowani Bapatisi</para>
  <para style="r">(Mk. 6:14-29; Lk. 9:7-9)</para>
  <para style="p">
    <verse number="1" style="v"/>Mï kadra nani Heroda vo dakaŋo owo kö'du Yësu mo ayada zi vo mï <verse number="2" style="v"/>turu ënïye henye, “Tïnyö Yowani Bapatisi ra ënyï ku na dïdï.” “Kö'du nere ra mo ëdï kyigɔ nenye aba, zi kö'du ko'do ne'e ko'dɔ mo.” <verse number="3" style="v"/>Kö'du Heroda ra kyere ï'dï kö'du zi Yowani kïrï kida mo nyɔri aba ku'du mï kamba. Mo o'dɔ kö'du ne ga kö'du Herodiya mbara 'ba öndu mo Pilipo. <verse number="4" style="v"/>Mï kadra maako aba, Yowani Bapatisi ayada zi Heroda, iya henye, “Anza na laka zi yï Herodiya koze.” <verse number="5" style="v"/>Here Heroda omba zi mo kofo, mora ere kazi vïdï 'ba Yuda'e ga kö'du zë asösu 'bënnï Yowani ne nëbï ra. <verse number="6" style="v"/>Here mï kadra ko'jo 'ba Heroda aba wu'jë 'ba Herodiya ɔlɔ komo vïdï kayo. Heroda gbɔ rakyenyi aba <verse number="7" style="v"/>alömu zi mo, iya henye, “Malömu ku zi kï'dï zi yï wa ma ako'jo kö'du ga kö'du mo.” <verse number="8" style="v"/>Here tëmï kö'du sösu 'bama mo, mo ako'jo hɔ mo, iya henye, “ï'dï zi ma kinye yaanya aba da Yowani Bapatisi da gbenje ne.” <verse number="9" style="v"/>Yere gbɔ kazi rakyenyi ga kö'du lömu ma mo o'dɔ ta da komo yingɔ 'bënï ne'e biya ne, mo ï'dï kö'du zi wu'jë ne, da kö'du wa ko'jo 'bɔmo omba ku. <verse number="10" style="v"/>Here mo ï'dï kö'du ikye da Yowani gbɔ mï kamba, <verse number="11" style="v"/>dɔ mo ne ika mï gbenje mora ï'dï gbɔ zi wu'jë ne, mo oba ika gbɔ zi ma nï. <verse number="12" style="v"/>Vo lö'bö a Yowani ayi ïnjënnï yöku mo usu, mora zë ï'bë ayadannï kö'du mo gbɔ zi Yësu.</para>
  <para style="s">Yësu ï'dï wakonyo zi vïdï kayo</para>
  <para style="r">(Mk. 6:30-44; Lk. 9:10-17; Yn. 6:1-14)</para>
  <para style="p">
    <verse number="13" style="v"/>Mati Yësu owo kö'du Yowani, mo ɔsɔ ani mï töŋbö, ënyï ï'bë ga bi mbiya na bi dënï. Here vïdï owonnï kö'du mo ënyï ilannï gawo 'bënnï, ï'bënnï ga ndï mo aba ta akaŋo. <verse number="14" style="v"/>Yësu ënyï asi yaga tëmï töŋbö, mati mo ongɔ vïdï kayo ne'e, di'di mo oso gbɔ ndɔ na kö'du sösu ga kö'du zë, mo akɔ'jɔ zë ma na rakɔɔ ne'e gbɔ. <verse number="15" style="v"/>Hutaga nani aba, vo lö'bö 'bɔmo ayinnï zi mo iyannï henye, “Bi ku ra hutaga bi nenye bi mbiya ra, utu vïdï ne'e liŋɔ mï'bënnï wakonyo kogo zi nnï.” <verse number="16" style="v"/>Yësu aya'ba da me'do zi zë iya henye, “Zë mï'bënnï dë. 'E na bi de 'e, ï'dïye wakonyo zi zë konyo.” <verse number="17" style="v"/>Zë aya'bannï da me'do, iyannï henye, “Wa biya ma dëdï mo aba kinye mangɔlɔ'bɔ muyï kyenze rïyö.” <verse number="18" style="v"/>Yësu iya zi zë henye, “Ika'e zë zi ma kinye.” <verse number="19" style="v"/>Mo ï'dï kö'du gbɔ zi vïdï ne'e limannï akaŋo da loma, mo oba mangɔlɔ'bɔ muyï kyenze rïyö ne aba, ongɔ bi rïyë o'dɔ öwö'dï zi Wïrï. Mo owe mï mangɔlɔ'bɔ ne'e ï'dï zë gbɔ zi vo lö'bö'e, vo lö'bö ï'dï zë gbɔ zi vïdïye. <verse number="20" style="v"/>Vïdï biya onyo ɔvɔnnï mora vo lö'bö obannï baga 'butë dɔmorïyö ndɔ na kɔsɔ wa ma ɔsɔ. <verse number="21" style="v"/>Watiti 'ba vïdï kora ma onyonnï wa ne, ëdï kpulukumuyï vïdï, mbara gisisi ëtï iti dë.</para>
  <para style="s">Yësu alasi ta da wini</para>
  <para style="r">(Mk. 6:45-52; Yn 6:15-21)</para>
  <para style="p">
    <verse number="22" style="v"/>Here Yësu ï'dï vo lö'bö'e tëkyïnnï mï töŋbö tï'bënnï dagba kapa föfö mɔtɔ, mora mo iya vïdï ne'e mï'bënnï 'de. <verse number="23" style="v"/>Ta pëtï utu vïdï ne'e ku, mo ï'bë da lutu rïyë kutï nï aba amötu. Mati hutaga ɔkɔ, Yësu ëdï gbɔ ani kutï nï aba. <verse number="24" style="v"/>Mï kadra ne töŋbö ëdï ku na kɔwɔ mï kutë wini 'ba föfö rë nï kɔhɔ kazi wini kagba, ga kö'du buluku ëdï aluku zɔ kï'dï zi mo. <verse number="25" style="v"/>Tëmï kutë kadra wota, modaka aba mï da mïndö, Yësu ayi zi vo lö'bö'e lasi aba ta da wini. <verse number="26" style="v"/>Mati zë ongɔnnï mo ëdï alasi ta da wini, zë na tere. Zë iyannï kudu aba na tere henye, “Ne gïlïlö 'ba yöku ra.” <verse number="27" style="v"/>Yësu ame'do kandi zi zë iya henye, “Uku mï ye, ne ma ra, ere'e dë.” <verse number="28" style="v"/>Here Petero ame'do rïyë iya henye, “Yere ëzë ëdï tïnyö yï ra ï'dï kö'du zi ma tï'bë ta da wini zi yï ani.” <verse number="29" style="v"/>Yësu aya'ba da me'do iya henye, “Ayi.” Petero asi yaga tëmï töŋbö ayeto gbɔ tï'bë ta da wini zi Yësu. <verse number="30" style="v"/>Mati mo ongɔ buluku kyigɔ ne, mo na tere ayeto zi lëndï akaŋo mï wini. Mo udu “Ayɔmɔ ma Yere.” <verse number="31" style="v"/>Kandi Yësu akako Petero kala nï aba, iya zi mo henye, “Ëdï kö'du koma aba tisiwa. Kö'du a'di dë yï jijiji gɔ mo?” <verse number="32" style="v"/>Here zë 'dö rïyö ëkyïnnï mï töŋbö, buluku ɔrɔ gbɔ. <verse number="33" style="v"/>Here zë ma mï töŋbö ne'e ayetonnï Yësu, iyannï henye, “Tïnyö yï Wisi 'ba Wïrï ra.”</para>
  <para style="s">Yësu akɔ'jo vo rakɔɔ mï Genesereta</para>
  <para style="r">(Mk. 6:53-56)</para>
  <para style="p">
    <verse number="34" style="v"/>Zë umunnï kyëtï 'ba föfö ayinnï gawo 'ba Genesereta, <verse number="35" style="v"/>ani vïdï ayɔlɔnnï Yësu gbɔ, zë utunnï kö'du zi vïdï 'ba rakɔɔ'e biya kpo tara gawo nani, ikannï zë gbɔ zi Yësu. <verse number="36" style="v"/>Zë alenzennï mo zi kila zë mati kɔɔ aba ne, gbï nje zi ha bɔngɔ ɔmo kisa, zë biya ma isennï ne, akɔ'jɔ zë gbɔ ŋbala.</para>
  <chapter number="15" style="c"/>
  <para style="s">Kö'du yandi 'ba wa ŋbala ti'da aba</para>
  <para style="r">(Mk. 7:1-13)</para>
  <para style="p">
    <verse number="1" style="v"/>Kya 'ba Farasiye nnï vo komoyandi 'ba kö'du kï'dï ëtï, ayinnï ta Yerusalema zi Yësu, ako'jonnï hɔ mo, iyannï henye, <verse number="2" style="v"/>“Kö'du a'di vo lö'bö 'bëyïye ɔwɔnnï kö'du kï'dï ma kyedre 'beze ilannï zi ze ne dë? Akaka kala nnï dë tëmï gërï ma laka gba kazi wakonyo.” <verse number="3" style="v"/>Yësu aya'ba dɔ mo iya henye, “Mora kö'du a'di ɔwɔ'e kö'du a Wïrï dë, ïrïye ga ndï kö'du yandi 'be'e? <verse number="4" style="v"/>Kö'du Wïrï iya henye, ‘Ɔwɔ 'bu yï ma yï aba. Vïdï ma asënë 'bu nï mandere ma nï akï'dï mo zi kofo.’ <verse number="5" style="v"/>Mora ayandi 'e henye, ëzë vïdï maako ëdï wa aba, mo mo'dɔ zi 'bu nï kɔnyi mandere ma nï. Mora iya henye, nenye 'ba Wïrï. <verse number="6" style="v"/>Mo omba dë zi 'bu nï tɔwɔ. Tëmï gërï ne ɔwɔ'e kö'du kï'dï a Wïrï dë, ga kö'du zi ga ndï kö'du yandi 'be ra kïrï. <verse number="7" style="v"/>'E vo komokandi ne'e, kö'du 'ba Yisaya ëdï tïnyö, kaa ma mo iya kö'du ga kö'du ko'dɔ 'be'e.”</para>
  <para style="p">
    <verse number="8" style="v"/>Wïrï iya henye, “Vïdï nenye'e ɔwɔnnï ma me'do hë nnï aba, di'di zë tïnyö na kɔwɔ tara ma. <verse number="9" style="v"/>Here anza na laka zi zë ma yeto, ga kö'du ëdïnnï kö'du kï'dï 'ba vïdï köndu ra yandi mo kaa kö'du kï'dï ama.”</para>
  <para style="s">Wa mati ëdï vïdï ko'dɔ na ti'da</para>
  <para style="r">(Mk. 7:14-23)</para>
  <para style="p">
    <verse number="10" style="v"/>Yësu ako'jo vïdï kayo zi nï iya zi zë henye, “Owo'e, ayɔlɔ'e. <verse number="11" style="v"/>Anza dë wa ma ï'bë ta ha vïdï mï mo ra o'dɔ mo na ti'da, wa ma asi yaga ta hɔ mo ra o'dɔ mo na ti'da” <verse number="12" style="v"/>Here vo lö'bö ɔmo ayinnï zi mo iyannï henye, “Ayɔlɔ'e ku henye ere, Farasi anzannï dë na rakyenyi mï kö'du kiya 'bëyï ne?” <verse number="13" style="v"/>Yësu aya'ba da me'do iya henye, “Wevo mati 'bu komorïyë ra dë yï akotɔ 'de.” <verse number="14" style="v"/>“Asösu'e kö'du zë dë. Zë vo dagba 'ba vo komoköndu. Ëzë kora vo komoköndu maako akɔkɔ vo komoköndu agamo, zë 'dö rïyö akalëpïnnï mï wogo.” <verse number="15" style="v"/>Petero ënyï ame'do rïyë iya henye, “Ayada mï ï'jö me'do ne te zi ze.” <verse number="16" style="v"/>Yësu iya zi zë henye, “Anza'e dë gba ndrë na komokandi ta da oka'e. <verse number="17" style="v"/>Ayɔlɔ'e dë? Wa ma ï'bë ta ha vïdï ï'bë mï mo mora gbɔ yaga tëmï ida rɔ mo. <verse number="18" style="v"/>Mora wa ma asi yaga ta ha, ayi tëmï di'di, ne wa ma o'dɔ vïdï na ti'da <verse number="19" style="v"/>Tëmï di'di mo ayi kö'du sösu ma kyënyë, ma akï'dï mo zi wa kofo, ndoro ko'dɔ, kö'du kyënyë maako'e ko'dɔ mo aba, zi wakɔlɔ, ndɔndɔ, kö'du kyënyë kiya ra oka'e. <verse number="20" style="v"/>Nenye'e wa ma ëdïnnï vïdï ko'dɔ na ti'da, zi wakonyo kazi kala'e kaka, kaa ma zë iyannï ne, o'dɔ vïdï dë na ti'da.”</para>
  <para style="s">Koma 'ba mbara tëmï Kanana</para>
  <para style="r">(Mk. 7:24-30)</para>
  <para style="p">
    <verse number="21" style="v"/>Yësu ila bi nani ënyï ï'bë dakaŋo ma kara ra gawo kyedre 'ba Tiyere nnï Sidoni aba. <verse number="22" style="v"/>Mbara 'ba Kanana maako ma alima bi nani ayi zi mo. Ënyï udu rïyë, iya henye, “Wisi 'ba Dawidi, akɔnyi ma kyedre. Wu'jë ama ëdï dakyikyi aba, mï riti kyedre.” <verse number="23" style="v"/>Yësu iya me'do ako dë zi mo. Vo lö'bö 'bɔmo ayinnï zi mo alenzennï mo iyannï henye, “Ore mo 'de, mo ëdï ga ndi ze kïrï kpɔrɔ nenye ko'dɔ aba.” <verse number="24" style="v"/>Yësu aya'ba dɔ mo iya henye, “Utu ma nje zi vïdï 'ba Yiserele'e ma ölunnï.” <verse number="25" style="v"/>Mati here ne, mbara ne ayi alëpï ndï mo. Mo iya henye, “Akɔnyi ma Yere.” <verse number="26" style="v"/>Yësu aya'ba dɔ mo iya henye, “Anza dë na laka zi wakonyo a gisisiye ku'du mo zi wïhïye.” <verse number="27" style="v"/>Mo aya'ba dɔ mo iya henye, “Ne tïnyö Yere, wïhï ëdïnnï kpa wakonyo ma ɔsɔ alëpï ta da tarabiza 'ba kyedre 'bëzë 'e ne konyo.” <verse number="28" style="v"/>Yësu aya'ba dɔ mo zi mo iya henye, “Yï mbara 'ba kö'du koma kyedre aba. Mï kadra tisi nani wu'jë ɔmo akɔ'jɔ rë nï gbɔ.”</para>
  <para style="s">Yësu akɔ'jɔ vïdï kyɔ</para>
  <para style="p">
    <verse number="29" style="v"/>Yësu ila bi nani ënyï ï'bë na konda ta da kapa föfö 'ba Galilaya. Mo ëkyï da lutu alima akaŋo. <verse number="30" style="v"/>Vïdï kayo ayinnï zi mo, ikannï aba, vo keŋe, vo komoköndu, vo ka'bo, vo ha ngulu vïdï rakɔɔ maako'e kyɔ ma ï'dïnnï zë ndï Yësu, mo akɔ'jɔ zë gbɔ. <verse number="31" style="v"/>Vïdï ne'e na rakaga ma ongɔnnï vo ha ngulu ëdï ku ame'do, vo ka'bo ku na laka, ma keŋe ëdï ku alasi, vo komoköndu ëdï ku bi kongɔ, ayetonnï Wïrï 'ba Yiserele gbɔ.</para>
  <para style="s">Yësu ï'dï wakonyo zi vïdï kyedre kayo</para>
  <para style="r">(Mk. 8:1-10)</para>
  <para style="p">
    <verse number="32" style="v"/>Yësu ako'jo vo lö'bö 'bënïye zi nï iya zi zë henye, “Ma rasösu aba ga kö'du vïdï nenye'e, ga kö'du zë ëdïnnï ku ma aba, ko'do wota aba yaanya aba anzannï dë waako aba zi konyo. Momba dë zë kutu kazi wakonyo, ga kö'du atëdïnnï na riti ta da gërï 'bëzë liŋɔ.” <verse number="33" style="v"/>Here vo lö'bö 'bɔmo ako'jonnï hɔ mo iyannï henye, “Da ki'ja ze wakonyo kyɔ mï da lëpï nenye zi kï'dï zi vïdï kayo nenye'e ta kila?” <verse number="34" style="v"/>Yësu ako'jo hë zë iya henye, “Ëdïye mangɔlɔ'bɔ aba ndö?” Aya'bannï dɔ mo iyannï henye, “Mangɔlɔ'bɔ madɔmorïyö nzoyi, kyenze ëdï tisiwa.”</para>
  <para style="p">
    <verse number="35" style="v"/>Yësu iya kö'du gbɔ zi vïdï kayo ne zi limannï akaŋo dakaŋo. <verse number="36" style="v"/>Mo oba mangɔlɔ'bɔ madɔmorïyö kyenze ne aba o'dɔ öwö'dï zi Wïrï, owe mï zë ï'dï zë zi vo lö'bö'e, vo lö'bö'e ï'dï zë zi vïdï ne'e. <verse number="37" style="v"/>Zë onyonnï mora ɔvɔnnï. Here vo lö'bö obannï koṛi madɔmorïyö ndɔndɔ na nzoyi ma ɔsɔ. <verse number="38" style="v"/>Watiti 'ba vïdï kora ma onyonnï ëdï 4,000 vïdï mbara gisisi ëtï iti dë. <verse number="39" style="v"/>Mati Yësu utu vïdï ne'e ku 'de, ëkyï mï töŋbö ï'bë mï dakaŋo 'ba Magadoni.</para>
  <chapter number="16" style="c"/>
  <para style="s">Kö'du ko'jo ga kö'du 'ba kö'du ko'do</para>
  <para style="r">(Mk. 8:11-13; Lk. 12:54-56)</para>
  <para style="p">
    <verse number="1" style="v"/>Kya 'ba Farasiye nnï Sadeke ëtï ayinnï zi Yësu ombannï zi mo yɔnzɔ ako'jonnï hɔ mo kö'du ko'do ko'dɔ mo zi zë, zi yada Wïrï ra omba da kö'du zi mo. <verse number="2" style="v"/>Mora Yësu aya'ba dɔ mo iya henye, “Ëzë kadra ëdï ku loso, iya 'e henye, ‘Dëdï ku tï'bë zi komo bi laka ki'ja, ga komo bi ëdï na kahi.’ <verse number="3" style="v"/>Ŋbɔ da mïndö aba, iya 'e henye, ‘Omba ku zi ta'di, ga kö'du komo bi na kahi a'ba na köndu.’ Aka me'do'e kö'du 'ba komo bi ne bi kongɔ aba komorïyë, mora ɔ'bɔ'e me'do dë kö'du kyïnë 'ba kadra ne'e. <verse number="4" style="v"/>Hala kö'du kyënyë vïdï ma ndenye ne kazi Wïrï. Ako'jo 'e ha ma ga kö'du ko'do? 'E'e, kö'du ko'do ma aki'di zi ye nje kö'du ko'do 'ba Yona.” Here Yësu ila zë ënyï ï'bë wënï 'de.</para>
  <para style="s">Langa 'ba Farasiye nnï Sadeke ëtï</para>
  <para style="r">(Mk. 8:14-21)</para>
  <para style="p">
    <verse number="5" style="v"/>Mati vo lö'bö'e umu nï kyëtï föfö maaga mo, kö'du mangɔlɔ'bɔ ölu ta dë zë zi kobannï aba. <verse number="6" style="v"/>Yësu iya zi zë henye, “Andire'e ëdï 'e bi kida aba kö'du langa 'ba Farasiye nnï Sadeke ëtï.” <verse number="7" style="v"/>Zë ayetonnï gbɔ me'do na ga rë nnï iyannï henye, “Mo iya kö'du ne ga kö'du doba 'e mangɔlɔ'bɔ maako dë.” <verse number="8" style="v"/>Yësu ayɔlɔ kö'du ma zë ëdïnnï kiya ne, here mo ako'jo hë zë iya henye, “Kö'du a'di ëdïye ame'do na ga re 'e kö'du mangɔlɔ'bɔ ma anza dë? Hala ëdïye koma tisi aba. <verse number="9" style="v"/>Gba ayɔlɔ'e dë? Mangɔlɔ'bɔ muyï ma minye mï mo kö'du vïdï kora kpulukumuyï ne dë? Koṛi ndö ma oso'e? <verse number="10" style="v"/>Mora ëdï hala kö'du mangɔlɔ'bɔ madɔmorïyö kö'du vïdï kora kpulukusowɔ ne? Koṛi ëdï ndö ma oso'e? <verse number="11" style="v"/>Hala ayɔlɔ'e dë manza dë ame'do zi ye kö'du 'ba mangɔlɔ'bɔ? Ongɔ'e ga re 'e kazi langa 'ba Farasiye nnï Sadeke ëtï. <verse number="12" style="v"/>Here vo lö'bö ayɔlɔnnï mo anza dë kö'du ne kiya zi ga rë nnï kongɔ kazi mangɔlɔ'bɔ ma o'dɔ langa aba, wënï ga kö'du yandi 'ba Farasiye nnï Sadeke ëtï.”</para>
  <para style="s">Petero Iya Yësu ra Korisitɔ</para>
  <para style="r">(Mk. 8:27-30; Lk. 9:18-21)</para>
  <para style="p">
    <verse number="13" style="v"/>Yësu ënyï ï'bë daliŋɔ ma kara ra gawo 'ba Kasariya Filipo, bi ma mo ako'jo ha vo lö'bö 'bënïye iya henye, “Ëyï ra vïdï ëdïnnï akiya mo Wisi a Vïdï?” <verse number="14" style="v"/>Zë aya'bannï dɔ mo iyannï henye, “kya vïdï maako'e iyannï henye, Yowani Bapatisi ra.” “Agamo'e iyannï Eliya ra, mora agamo'e iya 'bënnï Yeremaya ra mandere kya 'ba nëbï maako.” <verse number="15" style="v"/>Mo ako'jo hë zë iya henye, “Mora 'e 'be'e? Iya 'be'e ma ëyï?” <verse number="16" style="v"/>Simona Petero ënyï aya'ba dɔ mo iya henye, “Yï Korisitɔ ra, Wisi 'ba Wïrï wïdï.” <verse number="17" style="v"/>Yësu ënyï aya'ba dɔ mo iya henye, “Laka, Simona wisi 'ba Yona ga kö'du, tïnyö nenye ayi dë zi yï kazi vïdï köndu maako. Ï'dï mbïyï zi yï kazi 'bu ma komorïyë. <verse number="18" style="v"/>Here mayada zi yï Petero, mako'ba kanisa a ma mora gbï le koli ɔ'bɔ dë zi dɔ mo kohe. <verse number="19" style="v"/>Makï'dï gbalaka 'ba Damöku 'ba Wïrï zi yï, kö'du ma ida dakaŋo kinye, akida kpa komorïyë, kö'du ma inga dakaŋo kinye, akinga kpa komorïyë.” <verse number="20" style="v"/>Here Yësu ise gɔ mo zi vo lö'bö 'bënï ne'e mayadannï dë zi vïdï kölö maako nï Korisitɔ ra.</para>
  <para style="s">Yësu ame'do kö'du riti 'bënï koli aba</para>
  <para style="r">(Mk. 8:31-9:1; Lk. 9:22-27)</para>
  <para style="p">
    <verse number="21" style="v"/>Mï kadra nani zɔ dagba Yësu ayeto kiya kö'du riti 'bënï koli aba zi vo lö'bö 'benïye kazi koho, iya henye, “Makatï'bë mï Yerusalema mora matëdï riti aba kazi kyedre'e, vo da karasa'e vo komoyandi 'ba vo kö'du kï'dï ëtï. Akï'dïnnï ma zi kofo, mora ta pëtï ko'do da wota aba, matënyï na dïdï.” <verse number="22" style="v"/>Here Petero oba mo tisi dakapa ayeto gbɔ mo wasa iya henye, “Anza here Yere, kö'du ne mo'dɔ rë nï dë zi yï.” <verse number="23" style="v"/>Yësu opi komo nï da Petero iya nenye, “Ënyï 'de ta ra ma, Satani. Yï ra na wayata mï gërï ama, ga kö'du sösu 'bëyï ne ayi dë kazi Wïrï, mora kazi kö'du ko'dɔ 'ba vïdï köndu.” <verse number="24" style="v"/>Mora here, Yësu iya zi vo lö'bö 'bënnïye henye, “Ëzë vïdï maako omba tayi zi ma, kö'du mo mölu ta dɔ mo, mïnjë taka 'bënï malö'bö ga ma. <verse number="25" style="v"/>Vïdï ma omba zi dïdï 'bënï yɔmɔ akayölu mora vïdï ma ayölu dïdï nï kö'du ma aki'ja. <verse number="26" style="v"/>Vïdï atëdïnnï wa aba ëzë zë ïrïnnï damöku ne biya mora ayölu dïdï nnï? Anza here dë. Waako anza ani dë zi kï'dïnnï zi dïdï nnï ya'ba mo aba. <verse number="27" style="v"/>Kö'du Wisi 'ba Vïdï omba ku zi tayi mï bikanyi kyedre 'ba 'bu nï malayika ënï ëtï, mora mo akï'dï biriti zi vïdï maako mï kö'du ko'dɔ 'bɔmo. <verse number="28" style="v"/>Miya zi ye henye, kya vïdï maako'e ëdïnnï kinye akolinnï dë, zë akongɔnnï bi tayi 'ba Wisi 'ba Vïdï mï damöku 'bënï.”</para>
  <chapter number="17" style="c"/>
  <para style="s">Yësu ofɔ rë nï</para>
  <para style="r">(Mk. 9:2-13; Lk. 9:28-36)</para>
  <para style="p">
    <verse number="1" style="v"/>Tapëtï ko'do modaka aba, Yësu oba Petero, Yemisi öndu nï Yowani aba, ënyï ï'bënnï rïyë da döku konda na bi dë nnï. <verse number="2" style="v"/>Mati zë ëdïnnï bi kongɔ rakofɔ ayi zi Yësu, komo mo ëdï alaka kaa kadra, bɔngɔ 'bɔmo ofɔ rë nï na kanyi. <verse number="3" style="v"/>Vo lö'bö wota ne'e, ongɔnnï Mosa nnï Eliya aba, ëdï ame'donnï Yësu ëtï. <verse number="4" style="v"/>Petero ame'do rïyë zi Yësu, iya henye “Yere, ëdï na laka ze kinye. Ëzë omba, ma kuvö gövö wota kinye. Kölö zi yï, kölö zi Mosa, mora kölö zi Eliya.” <verse number="5" style="v"/>Mati mo ëdï gba ame'do, fɔli laaka ayi ɔrɔ rïyë dë zë, gu aa tëmï fɔli iya henye, “Nenye gogo wisi ama ra, ma na rakyenyi mo aba. Owo'e dɔ mo.” <verse number="6" style="v"/>Mati vo lö'bö owonnï me'do ne, zë na tere umë rë nnï na mï yöfu dakaŋo. <verse number="7" style="v"/>Yësu ënyï ayi ise rë zë, iya henye, “Ënyïye rïyë, ere 'e dë.” <verse number="8" style="v"/>Here zë ongɔnnï bi rïyë i'jannï vïdï maako dë, du Yësu kutï nï aba. <verse number="9" style="v"/>Mati zë ëdï tasinnï akaŋo ta da döku, Yësu iya zi zë henye, “Ayada'e dë zi vïdï maako kö'du mati ongɔ'e ne, le ëzë Wisi a Vïdï ënyï ku tëmï koli.” <verse number="10" style="v"/>Vo lö'bö ako'jonnï ha Yësu iyannï henye, “Kö'du a'di vo komoyandi 'ba kö'du kï'dïye, iyannï henye ere, Eliya ra atayi dagba?” <verse number="11" style="v"/>Yësu aya'ba da me'do zi zë iya henye, “Eliya ra ëdï tayi dagba, mo akakɔ'jɔ wasisi nzɔ. <verse number="12" style="v"/>Mayada zi ye henye, Eliya ɔkɔ ku nzɔ, vïdïye ra ayɔlɔnnï mo dë o'dɔnnï mo kaa zë omba nnï. Tëmï gërï kölö ne zë ako'dɔnnï Wisi 'ba Vïdï kpa here.” <verse number="13" style="v"/>Vo lö'bö ënyï ayɔlɔnnï mo ëdï ame'do zi nnï ne, kö'du 'ba Yowani Bapatisi.</para>
  <para style="s">Yësu akɔ'jɔ wisi kora dakyikyi aba</para>
  <para style="r">(Mk. 9:14-29; Lk. 9:37-43a)</para>
  <para style="p">
    <verse number="14" style="v"/>Mati zë a'bannï zi vïdï kayo ne'e, kora maako ayi zi Yësu alɔdrɔ da womo nï aba akaŋo komo Yësu, <verse number="15" style="v"/>iya henye, “Yere, ï'dï mïyï mëyï ra wisi ama ne. Mo ëdï kɔɔ nökï aba na kyënyë, ëdï mo kumë kadra maako aba mï wa'do, mandere mï wini. <verse number="16" style="v"/>Mika mo zi vo lö'bö 'bëyïye, ɔ'bɔnnï dë mo kɔ'jɔ.” <verse number="17" style="v"/>Yësu aya'ba dɔ mo, iya henye, “'E vïdï kazi koma kö'du kyënyë aba ne'e, omba 'e zi ma tëdï ëtï le ndala aba? Omba'e zi ma lima ëtï le ndala aba? Ika 'e wisi ne zi ma.” <verse number="18" style="v"/>Yësu ï'dï kö'du zi dakyikyi ne, ënyï asi gbɔ yaga tara wisi ne, mï kadra nani akɔ'jɔ mo gbɔ. <verse number="19" style="v"/>Vo lö'bö ayinnï zi Yësu liya ako'jonnï hɔ mo, iyannï henye, “Kö'du a'di dore ze dakyikyi dë gɔ mo yaga?” <verse number="20-21" style="v"/>Yësu aya'ba da me'do zi zë iya henye, “Miya zi ye henye, ëzë ëdïye koma aba kaa kofo masatada ma tisi, akiya'e zi lutu nenye henye, ‘Ï'bë ta kinye nani!’ atï'bë. Ako'dɔ'e wa biya.”</para>
  <para style="s">Yësu ame'do löhu ga kö'du koli 'bënï</para>
  <para style="r">(Mk. 9:30-32; Lk. 9:43b-45)</para>
  <para style="p">
    <verse number="22" style="v"/>Mati vo lö'bö 'ba Yësu ayi atoto rë nnï ku biya mï Galilaya, Yësu iya zi zë henye, “Wisi 'ba Vïdï omba ku kï'dï mo zi vïdï <verse number="23" style="v"/>akofonnï mo, ko'do da wota aba mo atënyï na dïdï tëmï koli.” Vo lö'bö'e na rasösu ga kö'du mati Yësu iya akofo nï ne.</para>
  <para style="s">'Be'bele kopi mï yëkëlu 'ba Wïrï</para>
  <para style="p">
    <verse number="24" style="v"/>Mati Yësu vo lö'bö 'bënï ëtï ayinnï mï Kaparanamo, vo 'be'bele kö'du 'ba yëkëlu ayi zi Petero ako'jo hɔ mo iya henye, “Vo komoyandi 'be'e ëdï 'be'bele loko 'ba Wïrï kopi?” <verse number="25" style="v"/>Petero aya'ba dɔ mo, iya henye “Ëdï here.” Mati Petero ï'bë liŋɔ, Yësu ame'do dagba, “Simona, kö'du sösu 'bëyï a'di? Ëyï ra ëdïnnï 'be'bele kopi zi yeree 'ba dakaŋo nenye? Vo gisi 'ba dakaŋo'e ra kɔdɔ tu'dë maako'e?” <verse number="26" style="v"/>Petero aya'ba dɔ mo iya henye, “Vo leze'e ra.” Yësu aya'ba dɔ mo iya laka, “Gisi 'ba dakaŋo'e opinnï dë. <verse number="27" style="v"/>Domba dë zi vo 'be'bele kö'du ne'e ko'dɔ mo zi tënyïnnï na kamo. Ï'bë mï föfö kyenze kïrï. Otɔ yaga dagba kyenze mati ïrï ku ne, ayëhu hɔ mo aki'ja kɔhi ŋbiriṛi kyɔ kö'du 'be'bele 'bama 'ba loko 'ba Wïrï 'bëyï aba. Oba zë opi na 'be'bele 'bama 'be'e aba.”</para>
  <chapter number="18" style="c"/>
  <para style="s">Ëyï ra kyedre ndra?</para>
  <para style="r">(Mk. 9:33-37; Lk. 9:46-48)</para>
  <para style="p">
    <verse number="1" style="v"/>Mï kadra nani vo lö'bö ayinnï zi Yësu ako'jonnï hɔ mo, iyannï henye, “Ëyï ra 'bënï na kyedre mï damöku 'ba Wïrï?” <verse number="2" style="v"/>Yësu ako'jo wisi ï'dï mo atɔrɔ komo zë, <verse number="3" style="v"/>Mora iya henye, “Miya zi ye tïnyö, ëzë ofɔ re 'e dë kaa gisisi mï di'diye, ödu'e dë mï damöku 'ba Wïrï. <verse number="4" style="v"/>Vïdï ma kyedre mï damöku 'ba Wïrï ra mati aya'ba rë nï tisi kaa wisi nenye. <verse number="5" style="v"/>Ëzë vïdï mati ïrï wisi kaa nenye kala kyedre aba mï ru ma, ïrï ma ku.”</para>
  <para style="s">Kö'du yɔnzɔ zi kö'du kyënyë ko'dɔ</para>
  <para style="r">(Mk. 9:42-48; Lk. 17:1-2)</para>
  <para style="p">
    <verse number="6" style="v"/>“Ëzë vïdï maako o'dɔ wisi kölö tëmï gisisi nenye'e mo oma mï kö'du kyënyë ko'dɔ, ëdï na laka kö'du vïdï nani zi yïtö kyedre 'ba wakuhu kida gu mo, zi kuyï mo mï wulu ma yöndu ne. <verse number="7" style="v"/>Atëdï na riti zi vïdï 'ba damöku nenye, kö'du wa maako mati ëdï zi ko'dɔ zë zi kö'du kyënyë ko'dɔ. Wa ne ako'dɔ rë nnï 'duwï, atëdï na riti zi vïdï mati ï'dï zë zi rë nnï ko'dɔ ne. <verse number="8" style="v"/>Ëzë kala yï mandere ndï yï o'dɔ yï zi kö'du kyënyë ko'dɔ, ikye u'du 'de yaga. Ëdï na laka zi yï tödu mï dïdï kazi kala, mandere ndï ta da sesi kala 'dö rïyö, ndï kpa 'dö rïyö zi ku'du mï wa'do kazi tölu. <verse number="9" style="v"/>Ëzë komo yï o'dɔ yï zi kö'du kyënyë ko'dɔ, otɔ u'du 'de yaga. Ëdï na laka zi yï tödu mï dïdï komo aba nje kölö ta da sesi komo 'dö rïyö zi ku'du mï wa'do 'ba gehena.”</para>
  <para style="s">Mala kö'du tölu 'ba tïmëlë</para>
  <para style="r">(Lk. 15:3-7)</para>
  <para style="p">
    <verse number="10-11" style="v"/>“Komo'e mëdï re 'e, awasa'e dë gisisi. Miya zi ye henye, malayika 'bëzë ëdï 'duwï ŋburu komo 'Bu ma komorïyë. <verse number="12" style="v"/>A'di ra asösu 'bëyï ëzë vïdï kora ëdï tïmëlë aba lamikölö, ma kölö ölu tëmï zë ako'dɔ? Mo akila ma lamikölö 'butëmodɔmosowɔ dɔmomodɔmosowɔ bi wakonyo dakapa lutu, atï'bë koma tïmëlë mati ölu ne dë ya? <verse number="13" style="v"/>Ëzë mo i'ja ku, mayada zi ye henye, mo atëdï rakyenyi aba ndra kö'du tïmëlë kölö ne ta da ma lamikölö 'butëmodɔmosowɔ dɔmomodɔmosowɔ ma ölunnï dë ne. <verse number="14" style="v"/>Tëmï gërï kölö ne, 'Bu'e komorïyë omba dë zi ma kölö tëmï zë zi tölu.</para>
  <para style="s">Öndu mandere ëmï ma o'dɔ kö'du kyënyë</para>
  <para style="p">
    <verse number="15" style="v"/>“Ëzë öndu yï o'dɔ kö'du kyënyë zi yï, ï'bë ayada kö'du kyënyë 'bɔmo ne zi mo, o'dɔ na liwo, nje tëmï kutë'e. Ëzë mo owo kö'du 'bëyï ne ku, ayɔmɔ mo ku tëmï kö'du kyënyë ko'dɔ. <verse number="16" style="v"/>Ëzë mo owo kö'du 'bëyï ne dë, oba kölö mandere rïyö vïdï kya mo'e yï aba, kö'du wa sösu ne zi vo hu kö'du dɔrɔ tëdïnnï rïyö, mandere wota kaa mati ko'du yöru iya. <verse number="17" style="v"/>Ëzë mo owo dë zë dë, ayada kö'du ne biya zi vïdï 'ba kanisa. Ndundu mo aba ëzë mo owo da vïdï 'ba kanisa dë, o'dɔ mo kaa vo leze mandere kaa vo 'be'bele kö'du.</para>
  <para style="s">Kö'du kida kö'du kinga aba</para>
  <para style="p">
    <verse number="18" style="v"/>“Tïnyö mayada zi ye henye, kö'du mati ida ku mï dakaŋo kinye, akida kpa komorïyë, kö'du mati inga ku dakaŋo kinye, akinga kpa komorïyë. <verse number="19" style="v"/>Mayada kyɔ zi ye, ëzë vïdï rïyö tëmï 'e dakaŋo nenye omba da kö'du wa mati amötu'e kö'du mo, 'bu ma komorïyë ako'dɔ zi ye. <verse number="20" style="v"/>Ëzë vïdï rïyö mandere wota atoto rë nnï bi kölö mï ru ma, ma mëdï zë ëtï.”</para>
  <para style="s">Mala 'ba vo kalima kazi kö'du kila zi oka nï</para>
  <para style="p">
    <verse number="21" style="v"/>Petero ayi zi Yësu ako'jo hɔ mo iya henye, “Yere, ëzë öndu ma ëdï nduwë kö'du kyënyë ko'dɔ ra ma makila mo da ndö? Modɔmorïyö?” <verse number="22" style="v"/>“'Ë'e,” Yësu aya'ba dɔ mo iya henye, “Anza madɔmorïyö, 'butëmodɔmorïyö dɔmomodɔmorïyö, <verse number="23" style="v"/>ga kö'du damöku 'ba Wïrï ëdï here. Kadra maako aba, yere maako omba zi kö'du kɔhi 'ba vo kalima 'bënïye mati obannï kazi nï kongɔ. <verse number="24" style="v"/>Mati mo ayeto ku zi ko'dɔ mo here, ma kölö tëmï zë ika 'bënï zi mo atiti gɔ mo miliyönï pawono. <verse number="25" style="v"/>Vo kalima ne anza wa aba kyɔ dë, zi kɔhi ɔmo ne kopi. Yere ï'dï kö'du zi mo kogo 'de kaa vo kalima, mbara 'bɔmo, gisisi, biya wa mati mo ëdï mo aba kö'du zi yöngu ne kopi mo aba. <verse number="26" style="v"/>Vo kalima ne alɔdrɔ domo nï aba komo yere, ala'ba rë nï iya henye, ‘Mïyï mëyï ra ma, ma kopi wa 'bëyï ne biya zi yï.’ <verse number="27" style="v"/>Yere gbɔ rasösu aba kö'du mo, ila mo tëmï yöngu ne, ila mo ï'bë gbɔ.”</para>
  <para style="p">
    <verse number="28" style="v"/>“Kora ne ënyï ï'bë andɔsi dë nnï, vo kalima oka nï mati oba kɔhi tisiwa aba kazi mo ne, ïrï mo ta gu mo ŋbïrï, iya zi mo henye, ‘Opi yöngu ama gë yï ne.’ <verse number="29" style="v"/>Vo kalima oka mo ne alɔdrɔ akaŋo ala'ba rë nï zi mo iya henye, ‘Mïyï mëyï ra ma, ma kopi zi yï.’ <verse number="30" style="v"/>Mo omba dë ënyï u'du mo mï kamba le mo akopi yongu ne. <verse number="31" style="v"/>Mati kya 'ba vo kalima maako'e ongɔnnï kö'du mati o'dɔ rë nï ne, zë rasösu aba, ënyï ï'bë ayadannï kö'du ne gbɔ biya zi yere. <verse number="32" style="v"/>Yere ako'jo vo kalima ne loko iya zi mo henye, ‘Yï vo kalima kyënyë ra, mila yï kö'du wasisi mati oba kazi ma ne'e biya, nje ga kö'du ala'ba rë yï zi ma. <verse number="33" style="v"/>Here kaa atëdï mïkyëyï aba ra oka yï ne kaa mati mo'dɔ mïkyëyï zi yï ne.’ <verse number="34" style="v"/>Here yere gbɔ na kamo usu vo kalima ne mï kamba zi riti kï'dï zi mo le ëzë mo opi yongu ne ku biya.” <verse number="35" style="v"/>Yësu ï'dï dɔ mo gbɔ zi zë iya henye “Ne ëdï kö'du mati 'bu ma komorïyë ako'dɔ zi ye, ëzë ila'e ako'e dë tëmï di'diye.”</para>
  <chapter number="19" style="c"/>
  <para style="s">Yësu ayandi kö'du ga kö'du 'ba mbara yëyï</para>
  <para style="r">(Mk. 10:1-12)</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu inde me'do ne'e kiya ku, mo ila Galilaya ënyï ï'bë mï dakaŋo 'ba Yudiya kapa ranga 'ba Yeredene. <verse number="2" style="v"/>Vïdï kayo alö'bönnï ga ndï mo, mo akɔ'jɔ zë gbɔ ani.</para>
  <para style="p">
    <verse number="3" style="v"/>Kya 'ba Farasi maako'e ayinnï zi mo, ayɔnzɔnnï zi mo kuyï kö'du ko'jo aba, iyannï henye, “Kö'du kï'dï 'beze akila vïdï kora zi mbara 'bënï yëyï na yawa kaa mo omba?” <verse number="4" style="v"/>Yësu aya'ba dɔ mo iya henye, “Akɔ'jɔ'e kö'du yöru ne dë, mati iya henye, bi yeto aba Wïrï ï'dï vïdï kora mbara aba? <verse number="5" style="v"/>Wïrï iya henye, ‘Ga kö'du ne, vïdï kora akila 'bu nï, ma nï akadrɔko rë nnï mbara 'bënï aba, zë rïyö ne atëdïnnï na wa kölö.’ <verse number="6" style="v"/>Here anzannï dë kpe rïyö, atëdïnnï kölö. Vïdï maako inye mï wa mati Wïrï adrɔkɔ ku bi kölö ne dë.”</para>
  <para style="p">
    <verse number="7" style="v"/>Farasiye ako'jonnï hɔ mo iya henye, “Kö'du a'di Mosa ï'dï kö'du zi vïdï kora waraga 'ba rayëyï yöru, kï'dï zi mbara 'bënï mo kore 'de?” <verse number="8" style="v"/>Yësu aya'ba dɔ mo iya henye, “Mosa ï'dï kö'du zi ye mbara 'be'e yëyï, ga kö'du de 'e na kyigɔ zi yandi. Anza dë here, tëmï kadra mati bi o'dɔ rë nï. <verse number="9" style="v"/>Mayada zi ye henye, ëzë kora maako ayëyï mbara 'bënï 'beri ta da ndoro ko'dɔ, mo o'dɔ ndoro ku, ëzë mo ïrï mbara maako.”</para>
  <para style="p">
    <verse number="10" style="v"/>Vo lö'bö 'bɔmo'e iyannï zi mo henye, “Ëzë ëdï ne kö'du mati mï kutë kora mbara 'bënï aba, here, vïdï moze mbara dekpe.” <verse number="11" style="v"/>Yësu aya'ba da me'do zi zë iya henye, “Kö'du yandi nenye anza dë zi vïdï biya, nje zi zë mati Wïrï ï'dï here. <verse number="12" style="v"/>Vïdï kora na lïmu kö'du o'jo zë here. Maako'e vïdï ra o'dɔ zë here, maako'e ombannï dë mbara koze ga kö'du 'ba damöku 'ba Wïrï. Mo mati atɔ'bɔ da kö'du yandi nenye komba, mo'dɔ here.”</para>
  <para style="s">Yësu ï'dï ya'da zi gisisiye</para>
  <para style="r">(Mk. 10:13-16; Lk. 18:15-17)</para>
  <para style="p">
    <verse number="13" style="v"/>Kya vïdï maako'e ikannï gisisi zi Yësu kala nï kï'dï dë zë zi mötu kö'du zë, vo lö'bö 'bɔmo ayatannï vïdï ne'e. <verse number="14" style="v"/>Yësu iya zi zë henye, “Ila'e gisisi mayinnï zi ma, ayata'e zë dë, ga kö'du damöku 'ba Wïrï ra kaa nenye'e.” <verse number="15" style="v"/>Mo ï'dï kala nï dë zë ila zë ï'bë wënï gbɔ.</para>
  <para style="s">Wisi kora ɔbi ma wa aba kyɔ</para>
  <para style="r">(Mk. 10:17-31; Lk. 18:18-30)</para>
  <para style="p">
    <verse number="16" style="v"/>Kadra maako aba, kora maako ayi zi Yësu ako'jo hɔ mo iya henye, “Vo komoyandi, kö'du laka a'di ra ma ko'dɔ zi ma dïdï ŋburu ki'ja?” <verse number="17" style="v"/>Yësu aya'ba dɔ mo iya henye, “Kö'du a'di ako'jo ha ma kö'du wa ma laka? Mo ma laka ëdï nje kölö. Ïrï ga ndï kö'du kï'dï ne, ëzë omba zi tödu mï dïdï ma ŋburu.” <verse number="18" style="v"/>Mo ako'jo kö'du iya henye, “Kö'du kï'dï a'di?” Yësu ënyï aya'ba dɔ mo zi mo iya henye, “Ofo vïdï dë, o'dɔ ndoro dë, alogo dë, asusu vïdï maako dë na ndɔndɔ, <verse number="19" style="v"/>ɔwɔ 'bu yï ma yï aba, o'dɔ lɔvɔ vo haliŋɔ oka kaa mati o'dɔ lɔvɔ yï.” <verse number="20" style="v"/>Kora ne aya'ba da me'do iya henye, “Mɔwɔ kö'du kï'dï ne'e ku biya. A'di ra omba gba zi ma ko'dɔ?”</para>
  <para style="p">
    <verse number="21" style="v"/>Yësu iya zi mo henye, “Ëzë omba zi yï zi tëdï ŋbala, ï'bë ogo wa mati ëdï mo aba ne biya yaga, ï'dï kɔhi mo zi vo leriye, atëdï wa aba kyɔ komorïyë, ta pëtï mo ayi alö'bö ga ma.” <verse number="22" style="v"/>Mati kora ne owo kö'du ne here, ënyï ï'bë na rasösu ga kö'du mo wa aba kyɔ.</para>
  <para style="p">
    <verse number="23" style="v"/>Yësu iya zi vo lö'bö 'bënïye henye, “Mayada zi ye, atëdï na kyigɔ zi vïdï ma wa aba kyɔ zi tödu mï damöku 'ba Wïrï. <verse number="24" style="v"/>Miya löhu zi ye henye; ëdï na kyigɔ ndra zi vïdï ma wa aba kyɔ zi tödu mï damöku 'ba Wïrï, ta da jemele tödu kpuru tëmï ogo 'ba ibira.”</para>
  <para style="p">
    <verse number="25" style="v"/>Mati vo lö'bö owonnï kö'du ne, zë biya na rakaga. Zë ako'jonnï kö'du iyannï henye, “Mora here ne, ëyï ra akayɔmɔ?” <verse number="26" style="v"/>Yësu ongɔ bi mbïyï dë zë aya'ba dɔ mo iya henye, “Wa mahere ne, vïdï ɔ'bɔ dë ko'dɔ. Wïrï ra atɔ'bɔ ko'dɔ mo biya.” <verse number="27" style="v"/>Petero ënyï ame'do rïyë, mo iya henye, “Ongɔ te, dila wasisi ku biya kö'du lö'bö gë yï. A'di ra datëdï ze mo aba?”</para>
  <para style="p">
    <verse number="28" style="v"/>Yësu iya zi zë henye, “Mayada tïnyö zi ye Wisi a Vïdï alima ku da kyïtï 'bënï bikanyi laka 'bɔmo mï daliŋɔ kyï. Vo ga ndï ma 'butë dɔmorïyö 'bama ne, akalima 'e kpa da kyïtï 'ba tu'dë gisi 'ba Yiserele 'butë dɔmorïyö ne. <verse number="29" style="v"/>Vïdï mati ila loko, öndu'e, ëmïye, 'bu, ma, gisisi, yaka ga kö'du ma aki'ja lami da kyɔ akï'dï dïdï ma ŋburu ŋburu zi mo. <verse number="30" style="v"/>Yaanya aba zë mati kyɔ dagba ne atëdïnnï hulëhu, yaanya aba zë ma kyɔ hulëhu ne, atëdïnnï dagba.”</para>
  <chapter number="20" style="c"/>
  <para style="s">Mala 'ba vo lɔɔ ko'dɔ'e mï yaka</para>
  <para style="p">
    <verse number="1" style="v"/>“Damöku 'ba komorïyë ëdï henye. Kora maako ëdï, mo ënyï gbɔ da mïndö aba tï'bë vïdï vo lɔɔ ko'dɔ'e koma, zi lɔɔ ko'dɔ mï yaka ënï. <verse number="2" style="v"/>Mo omba da kö'du zi kɔhi ŋbiriṛi kopi mo zi zë mï ko'do kölö, utu zë gbɔ lɔɔ ko'dɔ mï yaka ënï.”</para>
  <para style="p">
    <verse number="3" style="v"/>“Mo ënyï ï'bë löhu bi 'ba wakogo, kadra mamodɔmosowɔ aba i'ja kya vïdï kora maako ëdïnnï tɔrɔ ani öŋbö kazi lɔɔ. <verse number="4" style="v"/>Mo ayada zi zë iya henye, ‘Ï'bë'e kpa lɔɔ ko'dɔ mï yaka ma kopi kɔhi zi ye na laka.’ <verse number="5" style="v"/>Ï'bënnï gbɔ. Kadra 'butë dɔmorïyö kadra wota aba, mo o'dɔ kpa kö'du kölö ne. <verse number="6" style="v"/>Ëdï kara zi kadra muyï mo ënyï ï'bë bi 'ba wakogo i'ja kya 'ba vïdï maako'e ëdïnnï gba tɔrɔ ani öŋbö. Mo iya zi zë henye, ‘Ëdï 'be'e atɔrɔ kadra loso de 'e kinye öŋbö kazi lɔɔ ga a'di?’ <verse number="7" style="v"/>Zë aya'bannï dɔ mo iyannï henye, ‘Vïdï maako ï'dï lɔɔ dë zi ze.’ Mo iya henye, ‘Laka ï'bë'e lɔɔ ko'dɔ mï yaka ama.’”</para>
  <para style="p">
    <verse number="8" style="v"/>“Mati kadra ɔkɔ ku na hutaga, vo kyeti yaka ayada zi vo da lɔɔ ko'dɔ'e iya zi mo henye, ‘Akɔ'jɔ vo lɔɔ ko'dɔ ne'e opi kɔhi ëzë, ayeto zë mati ta da hulëhu ne, ndundu mo zë mati ma dagba.’ <verse number="9" style="v"/>Vïdï kora mati ayetonnï lɔɔ kadra muyï aba ne, opi kɔhi ŋbiriṛi zi ma kölö, kölö. <verse number="10" style="v"/>Kora mati o'dɔnnï lɔɔ dagba ayinnï zi kɔhi 'bënnï kïrï, asösunnï na kïrïnnï ndra, ma kölö opi kpa kɔhi ŋbiriṛi kölö. <verse number="11" style="v"/>Zë ïrïnnï kɔhi 'bënnï ënyïnnï agbɔrɔ vo kyeti yaka aba. <verse number="12" style="v"/>Zë iyannï henye, ‘Vïdï kora nenye'e mati o'dɔnnï lɔɔ ta da hulëhu nje kadra kölö, ze do'dɔ lɔɔ kadra ŋbo da kadra kyëtu ne, here ne opi kpa zi zë kaa mati opi ze ne?’”</para>
  <para style="p">
    <verse number="13" style="v"/>“Vo kyeti yaka aya'ba dɔ mo zi ma kölö tëmï zë iya henye, ‘Owo te aboka ma mo'ba'e dë. 'E biya omba'e da kö'du zi lɔɔ ko'dɔ, kadra kölö ŋbo da kɔhi ŋbiriṛi kölö. <verse number="14" style="v"/>Yaanya aba oba kɔhi 'be'e ne, ï'bë'e liŋɔ. Momba zi kï'dï zi kora mati o'dɔ lɔɔ ta da hulëhu, kpa kyɔ kaa mati mï'dï zi ye ne. <verse number="15" style="v"/>Here ne, manza dë dangölö aba zi ko'dɔ wa mati momba ko'dɔ mo kɔhi 'bama aba? Kɔdɔ 'e na mï kumbë ga kö'du ma na laka?’” <verse number="16" style="v"/>Yësu inde me'do 'bënï kiya mo aba henye, “Here zë mati hulëhu atëdïnnï dagba, mora zë mati dagba atëdïnnï hulëhu.”</para>
  <para style="s">Yësu ame'do ma da wota mo kö'du koli 'bënï</para>
  <para style="r">(Mk. 10:2-34; Lk. 18:31-34)</para>
  <para style="p">
    <verse number="17" style="v"/>Mati Yësu ëdï atï'bënnï mï Yerusalema, mo oba vo lö'bö 'bënï 'butë dɔmorïyö dakapa nï, ame'do zi zë na liwo. Mati zë ëdï atï'bënnï, mo ayada zi zë iya henye, <verse number="18" style="v"/>“Owo'e te, dëdï ze tï'bë le mï Yerusalema, ani Wisi a Vïdï akï'dï zi kyedre 'ba vo karasa'e nnï vo komoyandi 'ba vo kö'du kï'dï ëtï. Zë akikyennï vurë rɔ mo zi kofo. <verse number="19" style="v"/>Zë akï'dïnnï mo zi vo leze'e ako'dɔnnï sawiya rɔ mo, aku'bönnï mo, akatötönnï mo da taka. Mora ko'do da wota aba, mo atënyï löhu na dïdï.”</para>
  <para style="s">Kö'du ko'jo 'ba ma Yemisi nnï Yowani aba</para>
  <para style="r">(Mk. 10:35-45)</para>
  <para style="p">
    <verse number="20" style="v"/>Here mbara 'ba Zebedeyo ayi gisi kora 'bënï aba rïyö zi Yësu, alɔdrɔ komo mo ako'jo hɔ mo ga kö'du ko'dɔ laka. <verse number="21" style="v"/>Yësu ako'jo hɔ mo iya henye, “A'di ra omba?” Mo aya'ba da me'do iya henye, “Korisitɔ zi ma gisi kora rïyö 'bama nenye'e akalimannï da kala yï ma tïrï ma gali aba mï damöku 'be.”</para>
  <para style="p">
    <verse number="22" style="v"/>Yësu aya'ba da me'do zi gisi kora ne'e, iya henye, “Ayɔlɔ'e wa mati ëdïye kö'du ko'jo gɔ mo ne dë. Atɔ'bɔ'e kïnjë riti mati momba zi kïnjë ne?” Zë aya'bannï da me'do iyannï henye, “Datɔ'bɔ ze.” <verse number="23" style="v"/>Yësu ayada zi zë iya henye, “Tïnyö akïnjë'e riti 'bama ama, mora mɔ'bɔ dë kyigɔ aba zi kinzi vïdï mati akalima da kala ma ma tïrï ma gali aba. Bi nenye'e kö'du vïdï mati 'bu ma akɔ'jɔ zi zë.”</para>
  <para style="p">
    <verse number="24" style="v"/>Mati kya 'ba vo lö'bö 'butë owonnï kö'du ne, zë na kamo gisi öndu rïyö ne ëtï. <verse number="25" style="v"/>Yësu ako'jo zë biya bi kölö iya henye, “Ayɔlɔ'e ku henye, vo daliŋɔ 'ba vo leze ne'e ëdïnnï kalakonda aba dë zë, vo dagba'e ëdïnnï ndra kalakonda aba. <verse number="26" style="v"/>Here gërï mahere ne, manza dë mï kutë'e. Ëzë vïdï maako tëmï 'e omba zi tëdï kyedre, mo mëdï na vo lö'bö zi oka'e. <verse number="27" style="v"/>Ëzë vïdï maako tëmï 'e omba zi tëdï na vo dagba mo mëdï na vo kalima 'bëyï. <verse number="28" style="v"/>Kaa Wisi 'ba Vïdï ayi dë zi vïdï maako'e lɔɔ ko'dɔ zi mo, ayi zi ko'dɔ zi vïdï maako'e, dïdï nï kï'dï zi vïdï kayo yɔmɔ.”</para>
  <para style="s">Yësu akɔ'jɔ vo komoköndu rïyö</para>
  <para style="r">(Mk. 10:46-52; Lk. 18:35-43)</para>
  <para style="p">
    <verse number="29" style="v"/>Mati Yësu vo lö'bö 'bënï ëtï ënyïnnï ku tï'bë 'de ta Yerïkö, vïdï kayo ënyïnnï ga ndï mo aba. <verse number="30" style="v"/>Here kora vo komoköndu rïyö mati ëdï alimannï dakapa gërï, owonnï Yësu ëdï alaga ta da kapa, ayetonnï hë nnï gbögbö, “Wisi 'ba Dawidi ï'dï mïyï mëyï re ze.” <verse number="31" style="v"/>Here vïdï kayo ne'e o'dɔnnï sawiya zi zë ayadannï zi zë iyannï henye, alima'e ti. Mora here, zë agbögbö hë nnï ndra na kamo, iyannï henye, “Yere Wisi 'ba Dawidi, ï'dï mïyï mëyï re ze.”</para>
  <para style="p">
    <verse number="32" style="v"/>Yësu ɔrɔ ako'jo zë, ako'jo hë zë iya henye, “A'di ra omba'e zi ma zi ko'dɔ zi ye?” <verse number="33" style="v"/>Zë aya'bannï da me'do iyannï henye, “Yere, domba ze zi bi kongɔ.” <verse number="34" style="v"/>Yësu na rasösu kö'du zë, ise komo zë kandi ongɔnnï bi, mora alö'bönnï gbɔ ga ndï mo.</para>
  <chapter number="21" style="c"/>
  <para style="s">Tödu 'ba Yësu mï Yerusalema</para>
  <para style="r">(Mk. 11:1-11; Lk. 19:28-40; Yn. 12:12-19)</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu vo lö'bö 'bënï ëtï ɔkɔnnï ku kara ra Yerusalema, zë ayinnï Betehege da Döku 'ba Olivo ani Yësu utu vo lö'bö 'bënï rïyö dagba. <verse number="2" style="v"/>Kö'du kise nenye aba iya henye, “Ï'bë'e zi daliŋɔ mati dagba komo'e nani, kandi aki'ja'e mokakya na kida wisi ënï aba dakapa nï, inga'e zë ika'e zë zi ma. <verse number="3" style="v"/>Ëzë vïdï maako iya kö'du maako, ayada'e zi mo ‘Yere ra omba zë mo akila zë tï'bë kandi.’”</para>
  <para style="p">
    <verse number="4" style="v"/>Kö'du ne o'dɔ rë nï, zi kö'du mati nëbï iya ne tayi tïnyö.</para>
  <para style="q">
    <verse number="5" style="v"/>“Ayada zi gawo kyedre 'ba Ziyɔnɔ,</para>
  <para style="q">ongɔ'e vo damöku 'be'e ëdï tayi zi ye.</para>
  <para style="q">Mo umbë dënï dë,</para>
  <para style="q">ëdï taho da mokakya,</para>
  <para style="q">wisi mokakya ëdï zë aba.”</para>
  <para style="p">
    <verse number="6" style="v"/>Here vo lö'bö ne ï'bë o'dɔnnï kö'du ne te kaa mati Yësu ayada zi zë zi ko'dɔ mo. <verse number="7" style="v"/>Zë, ikannï mokakya ne wisi mo aba, o'bannï bɔngɔ 'bënnï dë zë Yësu ëkyï gbɔ dɔ mo. <verse number="8" style="v"/>Vïdï kayo o'ba bɔngɔ 'bënnï da gërï, agamo'e ikyennï da ngora 'ba kaga o'bannï zë da gërï. <verse number="9" style="v"/>Vïdï kayo ne alagannï dagba komo Yësu, zë mati ëdï tayi 'bënnï ta gɔ mo, ayetonnï hë nnï gbögbö, iyannï henye,</para>
  <para style="q">“Wayeto zi wisi a Dawidi.</para>
  <para style="q">Wïrï ï'dï ya'da zi mo mati ayi mï ru 'ba Yere,</para>
  <para style="q">wayeto zi Wïrï.”</para>
  <para style="m">
    <verse number="10" style="v"/>Mati Yësu ödu mï Yerusalema, da vïdï kayo mï gawo kyedre ne biya na wïrï wïrï. Here vïdï ako'jonnï kö'du iyannï henye, “Mo 'bënï ëyï ra?” <verse number="11" style="v"/>Vïdï kayo aya'bannï da me'do iyannï henye, “Nenye nëbï Yësu ra, tëmï Nazereta mï Galilaya.”</para>
  <para style="s">Yësu ï'bë ödu mï yëkëlu 'ba Wïrï</para>
  <para style="r">(Mk. 11:15-19; Lk. 19:45-48; Yn. 2:13-22)</para>
  <para style="p">
    <verse number="12" style="v"/>Yësu ï'bë ödu mï yëkëlu, ore vïdï mati ëdïnnï wakogo ne biya yaga. Mo adu'du da tarabiza 'ba vïdï 'ba kɔhi kutrë, gba'da 'ba vïdï mati ëdïnnï atu'bu kogo ëtï. <verse number="13" style="v"/>Mora iya zi zë henye, “Ëdï na yöru mï kö'du yöru, Wïrï iya ku henye, ‘Loko 'ba Wïrï ama ne ako'jo na loko 'ba mötu, ofɔ'e ku na wöru 'ba rakoho 'ba vo logo'e.’”</para>
  <para style="p">
    <verse number="14" style="v"/>Vo komoköndu vo ka'bo ëtï ayinnï zi mo mï yëkëlu 'ba Wïrï mo akɔ'jɔ zë gbɔ. <verse number="15" style="v"/>Kyedre 'ba vo karasa vo komoyandi 'ba vo kö'du kï'dï ëtï, ënyïnnï na kamo mati zë ongɔnnï kö'du ko'do mati Yësu ëdï ako'dɔ ne, gisisi ëdï hë nnï gbögbö mï yëkëlu, iyannï henye, “Wayeto zi Wisi a Dawidi.” <verse number="16" style="v"/>Zë ako'jo nï ha Yësu iyannï henye, “Owo kö'du mati ëdïnnï akiya ne ku?” Yësu aya'ba da me'do iya henye, “Ɔɔ, mowo ku. Gba ako'jo'e kö'du yöru nenye dë? ‘Ayandiye gisisi, gisisi ëtï zi wayeto ma laka kï'dï.’” <verse number="17" style="v"/>Yësu ila zë ënyï ï'bë yaga tëmï gawo kyedre ne ko'do mï Beteniya.</para>
  <para style="s">Yësu asënë kyëlu</para>
  <para style="r">(Mk. 11:12-14, 20-24)</para>
  <para style="p">
    <verse number="18" style="v"/>Tabi ta'ba 'bɔmo hulëhu mï gawo kyedre ŋbɔ da mïndö vere aba, Yësu na o'bo. <verse number="19" style="v"/>Mo ongɔ kaga kyëlu dakapa gërï, ï'bë rɔ mo i'ja waako dë dɔ mo du yëyu mo. Mo iya zi kaga ne henye, “Ana lɔgɔ dekpe löhu.” Kandi kaga kyëlu ne akyïtru gbɔ. <verse number="20" style="v"/>Vo lö'bö 'bɔmo ongɔnnï kö'du ne iyannï henye, “Kaga kyëlu ne akyitru kandi ga a'di?” <verse number="21" style="v"/>Yësu ënyï aya'ba dɔ mo zi zë iya henye, “Mayada zi ye tïnyö, ëzë oma'e awïrï de 'e dë, atɔ'bɔ'e ko'dɔ wa mati mo'dɔ zi kaga kyëlu ne. Anza nje ma ne dë, atɔ'bɔ'e kpa zi kiya zi lutu nenye, ‘Ënyï rïyë u'du rë yï mï ranga, ako'dɔ rë nï.’ <verse number="22" style="v"/>Ëzë oma'e, aki'ja'e wa mati akɔ'jɔ'e kö'du mo tëmï mötu.”</para>
  <para style="s">Kö'du ko'jo ga kö'du a Yësu</para>
  <para style="r">(Mk. 11:27-33; Lk. 20:1-8)</para>
  <para style="p">
    <verse number="23" style="v"/>Yësu ayi hulëhu mï yëkëlu, mo ayandi kö'du, kyedre 'ba vo karasa'e nnï vïdï kyedre ëtï ayinnï zi mo, ako'jonnï hɔ mo iyannï henye, “Ayada dero zi ze ëdï wa ne'e ko'dɔ kalakonda vala aba? Ëyï ra ï'dï kalakonda ne zi yï?” <verse number="24" style="v"/>Yësu aya'ba da me'do zi zë iya henye, “Ma kako'jo kö'du kölö ta he 'e, ëzë aya'ba'e dɔ mo ku zi ma makayada zi ye mëdï kö'du ne ko'dɔ kalakonda 'bëyï aba? <verse number="25" style="v"/>Kalakonda 'ba Yowani mati ëdï bapatisi kï'dï mo aba ne, ayi ta kila, kazi Wïrï kɔdɔ kazi vïdï?” Zë ayetonnï hë nnï wasa na ga rë nnï, iyannï henye, “Dakiya ze a'di?” Ëzë daya'ba'e dɔ mo diya'e kazi Wïrï, mo akiya zi ze henye, “Mora kö'du a'di oma'e dë mï Yowani?” <verse number="26" style="v"/>Ëzë diya'e henye, “Kazi vïdï, ze na tere, ga kö'du ze biya dasösu Yowani ra nëbï.” <verse number="27" style="v"/>Here zë aya'bannï dɔ mo zi Yësu, iya henye, “Dayɔlɔ ze dë.” Mo aya'ba dɔ mo zi zë iya henye, “Mayada dë zi ye kalakonda 'ba a'di ra mëdï kö'du nenye'e ko'dɔ mo aba.”</para>
  <para style="s">Mala kö'du gisi kora rïyö</para>
  <para style="p">
    <verse number="28" style="v"/>“Yaanya aba asösu'e kö'du a'di? Kadra maako aba kora ëdï gisi kora aba rïyö. Mo ënyï ï'bë zi ma kyedre ne iya zi mo henye, ‘Wisi ama ï'bë lɔɔ ko'dɔ mï yaka ndenye.’ Wisi aya'ba da me'do iya henye, <verse number="29" style="v"/>‘Momba dë tï'bë,’ yaa, mo asösu dë nï ënyï ï'bë gbɔ.”</para>
  <para style="p">
    <verse number="30" style="v"/>“'Bu ënyï ï'bë zi wisi agamo onyɔ kpa kö'du kölö ne. Wisi ënyï aya'ba da me'do iya henye, ‘Ɔɔ, kyedre ma tï'bë,’ lɔɔ ne ko'dɔ mo, 'de ï'bë dë. <verse number="31" style="v"/>Wisi ma vala tëmï gisi rïyö ne'e, o'dɔ wa mati 'bu mo omba?” Zë aya'bannï da me'do iyannï henye, “Wisi ma kyedre.” Yësu iya zi zë henye, “Mayada zi ye, vo 'be'bele kö'du nnï, vo rönyï ëtï, ëdï tï'bënnï damöku 'ba Wïrï dagba komo'e. <verse number="32" style="v"/>Yowani Bapatisi ayi zi yada zi ye gërï ma laka zi ye kïrï, oma e dë mï mo. Vo 'be'bele kö'du vo rönyï ëtï ra omannï mï mo. Mati ongɔ'e mo gbï le, kpa otɔ de 'e dë zi koma mï mo.”</para>
  <para style="s">Mala kö'du vo lɔɔ ko'dɔ'e mï yaka 'ba lu'ju</para>
  <para style="r">(Mk. 12:1-12; Lk. 20:9-19)</para>
  <para style="p">
    <verse number="33" style="v"/>Yësu iya henye, “Owo'e mala vere ne, vo kyeti kaŋo maako ïyï lu'ju mï yaka, o'dɔ resi kpo ta rɔ mo, ole wogo 'ba a'ji koto, uvö loko tɔrɔ 'ba bi kongɔ. Mo ila yaka ne zi vo lɔɔ'e, ï'bë gbɔ bi yingɔ. <verse number="34" style="v"/>Mati kadra 'ba wa toto ta yaka ɔkɔ ku, mo utu vo kalima 'bënïye zi vo lɔɔ'e ga kö'du zi mï 'bënï mati inye ne koba.”</para>
  <para style="p">
    <verse number="35" style="v"/>“Vo lɔɔ ne'e ïrï vo kalima ne'e, u'bönnï ma kölö, ofonnï agamo, u'dunnï vere ṛï'dï aba. <verse number="36" style="v"/>Kora vo kyeti yaka ne utu vo kalima löhu kyɔ ta da ma dagba, vo lɔɔ ko'dɔ ne'e o'dɔnnï zë kpa kaa ma dagba. <verse number="37" style="v"/>Ndundu mo aba mo utu wisi 'bënï zi zë. Mo iya henye, ‘Tïnyö zë akoronnï wisi 'bama.’”</para>
  <para style="p">
    <verse number="38" style="v"/>“Mati vo lɔɔ ne'e ongɔnnï wisi ne, iyannï henye, ‘Nenye wisi 'ba vo kyeti yaka ra. Ayi dofo'e mo, doba'e wa 'bɔmo.’ <verse number="39" style="v"/>Zë ïrïnnï mo u'dunnï mo yaga tëmï yaka, ofonnï mo.”</para>
  <para style="p">
    <verse number="40" style="v"/>Yësu ako'jo hë zë iya henye, “Yaanya aba ëzë vo kyeti yaka ne ayi, ako'dɔ a'di zi vo lɔɔ ne'e?” <verse number="41" style="v"/>Zë aya'bannï da me'do iyannï henye, “Mo akofo kora 'ba kö'du kyënyë ko'dɔ ne'e, akï'dï yaka ne zi vo lɔɔ ko'dɔ maako'e, mati akï'dïnnï zi mo wa mï yaka mï kadra ma laka.” <verse number="42" style="v"/>Yësu iya zi zë henye,</para>
  <para style="q">“Ako'jo'e kö'du mati kö'du yöru iya ne dë?</para>
  <para style="q">‘Yïtö mati vo wa ko'ba ombannï dë,</para>
  <para style="q">ofɔ ku na yïtö ma laka ndra.</para>
  <para style="q">Nenye Yere ra o'dɔ.</para>
  <para style="q">Kongɔ mo atëdï na laka.’”</para>
  <para style="p">
    <verse number="43" style="v"/>Yësu idra dɔ mo iya henye, “Mayada zi ye, damöku 'ba Wïrï akoba 'de kazi 'e, akï'dï zi vïdï mati akatanannï lɔgɔ ma laka. <verse number="44" style="v"/>Vïdï mati alëpï da yïtö nenye, akolowe. Ëzë yïtö ne alëpï da vïdï akanzekpe vïdï nani.” <verse number="45" style="v"/>Here kyedre 'ba vo karasa nnï Farasi ëtï owonnï mala a Yësu ne, ayɔlɔnnï mo ëdï ame'do kö'du nnï, <verse number="46" style="v"/>zë ayɔnzɔnnï zi mo kïrï. Mora zë erennï vïdï kayo mati omannï mï Yësu mo nëbï ra.</para>
  <chapter number="22" style="c"/>
  <para style="s">Mala 'ba karama 'ba oze</para>
  <para style="r">(Lk. 14:15-24)</para>
  <para style="p">
    <verse number="1" style="v"/>Yësu ame'do löhu zi vïdï tëmï mala iya henye, <verse number="2" style="v"/>“Damöku 'ba Wïrï ëdï henye. Yere maako akɔ'jɔ karama 'ba oze 'ba wisi ënï. <verse number="3" style="v"/>Mo utu vo lö'bö 'bënïye zi yada zi yingɔ mati omba zë ne zi tayinnï mï karama ne, zë ombannï dë zi tayi.”</para>
  <para style="p">
    <verse number="4" style="v"/>“Mo utu kya vo lö'bö ne'e kö'du kise aba zi yingɔ ne'e, iya henye. ‘Karama ama ku nzɔ yaanya aba. Mofo isa ama ma kyedre, matɔnɔ aba ku nzɔ zi konyo mo. Ayiye mï karama 'ba oze.’ <verse number="5" style="v"/>Yingɔ mati ako'jo zë ne ombannï dë, ï'bënnï rï mï lɔɔ ënnï maako'e. Ma kölö maako ï'bënnï yaka ënï, ma vere ï'bënnï mï loko wakogo ënï. <verse number="6" style="v"/>Agamo'e ïrïnnï vo lö'bö ne'e u'bönnï zë ofonnï zë. <verse number="7" style="v"/>Vo damöku ënyï na kamo utu vo kanya 'bënïye ofonnï vo wa kofo ne'e, o'bɔ gawo kyedre 'bëzë ne ti'de.”</para>
  <para style="p">
    <verse number="8" style="v"/>“Mo ako'jo vo lö'bö 'bënïye iya zi zë henye, ‘Karama oze ama ku nzɔ. Vïdï mati mako'jo zë ne anzannï dë na laka tayi. <verse number="9" style="v"/>Yaanya aba ï'bë'e da gëri ma kyedre akɔ'jɔ'e vïdï kayo mati i'ja'e zë mayinnï mï karama.’ <verse number="10" style="v"/>Vo kalima ënyï ï'bënnï yaga da gëri atotonnï vïdï mati zë i'jannï biya, ma laka makyënyë mo aba, loko 'ba oze oso kyɔ vïdï aba.”</para>
  <para style="p">
    <verse number="11" style="v"/>“Yere ënyï ï'bë loko yingɔ ënïye kongɔ, mo i'ja kora maako usu bɔngɔ 'ba oze dë. Yere ako'jo hɔ mo iya henye, <verse number="12" style="v"/>‘Aboka ma ödu hala kinye kazi bɔngɔ 'ba oze?’ Kora ne 'de onyɔ kö'du ako dë. <verse number="13" style="v"/>Yere ayada zi vo lö'bö 'bënïye, iya henye, ‘Ida'e kala mo ndï mo aba u'du'e mo yaga mï bi köndu. Ani mo akudu hë nï konyo aba.’” <verse number="14" style="v"/>Yësu ï'dï dɔ mo iya henye, “Vïdï kayo ma ako'jo ne, ma jeli mo ayo dë.”</para>
  <para style="s">Kö'du ko'jo ga kö'du 'ba 'be'bele kopi</para>
  <para style="r">(Mk. 12:13-17; Lk. 20:20-26)</para>
  <para style="p">
    <verse number="15" style="v"/>Farasi ënyï ï'bë o'dɔnnï yeṛe zi Yësu kuyï kö'du ko'jo aba. <verse number="16" style="v"/>Zë ënyï utunnï kya 'ba vo lö'bö 'bënnï, kya 'ba vïdï 'ba Heroda ëtï. Zë iyannï zi mo henye, “Vo komoyandi dayɔlɔ ku ëdï kö'du tïnyö ra yada. Ëdï wa yandi tïnyö a Wïrï ra yandi zi vïdï. Kazi tere kö'du kiya 'ba vïdï kyedre maako'e dë. <verse number="17" style="v"/>Ayada zi ze, a'di ra asösu? Ëdï na laka zi ze 'be'bele kopi zi yere 'ba Roma, kɔdɔ anza here dë?”</para>
  <para style="p">
    <verse number="18" style="v"/>Yësu ayɔlɔ yeṛe kyënyë 'bëzë ne, mo iya zi zë henye, “'E vo komokandi ne'e, kö'du a'di ëdïye ma kuyï kö'du yɔnzɔ aba? <verse number="19" style="v"/>Ayada'e zi ma kɔhi 'ba 'be'bele mati ëdï kopi.” Zë ikannï kɔhi ne zi mo. <verse number="20" style="v"/>Mo ako'jo hë zë iya henye, <verse number="21" style="v"/>“Komo ëyï ra ru mo aba nenye?” Aya'bannï da me'do iyannï henye, nenye komo Siza ra ru mo aba. Yësu iya zi zë henye, “Laka opi zi Siza wa 'ba Siza, opi zi Wïrï wa 'ba Wïrï.” <verse number="22" style="v"/>Mati zë owonnï kö'du ne, zë na rakaga zë ilannï mo ënyï ï'bënnï gbɔ.</para>
  <para style="s">Kö'du ko'jo ga kö'du 'ba tënyï tëmï koli</para>
  <para style="r">(Mk. 12:18-27; Lk. 20:27-40)</para>
  <para style="p">
    <verse number="23" style="v"/>Sadeke'e ma omannï vïdï ënyï dekpe tëmï koli, zë ayannï zi Yësu iyannï henye, <verse number="24" style="v"/>“Vo komoyandi, Mosa iya henye ere, kora mati oze mbara oli 'de kazi gisisi ko'jo, öndu mo moba mbara lu'bë ne, zi zë gisisi ko'jo mï ru 'ba kora mati oli ne. <verse number="25" style="v"/>Yaanya aba ne gisi öndu ëdïnnï madɔmorïyö kinye, wisi ma kyedre oze mbara oli 'de kazi gisisi ko'jo, mo ila mbara lu'bë ne zi öndu nï. <verse number="26" style="v"/>Kö'du ne o'dɔ rë nï kpa here zi öndu ma rïyö ma wota ndundu mo zi zë madɔmorïyö ne biya. <verse number="27" style="v"/>Ndundu mo aba, mbara ne oli gbɔ. <verse number="28" style="v"/>Yaanya aba ne, mï ko'do mati yöku atënyïnnï na dïdï, mo atëdï mbara 'bëyï? Zë biya ozennï mo.”</para>
  <para style="p">
    <verse number="29" style="v"/>Yësu aya'ba dɔ mo zi zë iya henye, “Alïtë'e ku, ga kö'du ayɔlɔ'e wayöru dë mandere kyigɔ a Wïrï. <verse number="30" style="v"/>Ëzë yöku ënyïnnï ku na dïdï, atëdïnnï kaa malayika'e komorïyë ozennï mbara dë. <verse number="31" style="v"/>Yaanya aba kaa kö'du tënyï 'ba yöku tëmï koli, ako'jo'e kö'du mati Wïrï ayada zi ye ne dë? Mo iya henye, <verse number="32" style="v"/>Ma Wïrï 'ba Abarayama, Wïrï 'ba Yisika, Yakoba aba. Mo Wïrï 'ba dïdï anza 'ba yöku.” <verse number="33" style="v"/>Mati vïdï kayo ne'e owonnï kö'du ne, zë na rakaga tëmï gërï kö'du yandi 'bɔmo ne.</para>
  <para style="s">Kö'du kï'dï ma kyedre</para>
  <para style="r">(Mk. 12:28-34; Lk. 10:25-28)</para>
  <para style="p">
    <verse number="34" style="v"/>Mati Farasiye owonnï Yësu ayata Sadeke'e, zë ayi atoto rë nnï bi kölö. <verse number="35" style="v"/>Ma kölö tëmï zë vo komoyandi 'ba vo kö'du kï'dï, ako'jo ha Yësu tëmï kö'du yɔnzɔ iya henye, <verse number="36" style="v"/>“Vo komoyandi, kö'du kï'dï ma vala ra kyedre mï kö'du kï'dï?” <verse number="37" style="v"/>Yësu aya'ba dɔ mo iya henye, “'O'dɔ lɔvɔ Yere Wïrï 'bëyï di'di yï aba biya, lawo yï aba biya, kö'du yɔlɔ 'bëyï aba biya. <verse number="38" style="v"/>Nenye kö'du kï'dï ma dagba ma kyedre ndra 'ba kö'du kï'dï ra. <verse number="39" style="v"/>Kö'du kï'dï ma rïyö ma kyedre mo ëdï kaa mo. O'dɔ lɔvɔ vo haliŋɔ oka kaa mati o'dɔ lɔvɔ yï. <verse number="40" style="v"/>Kö'du kï'dï 'ba Mosa biya kö'du yandi 'ba nëbï ëtï ɔrɔ da kö'du kï'dï rïyö ne'e.”</para>
  <para style="s">Kö'du ko'jo ga kö'du 'ba Korisitɔ</para>
  <para style="r">(Mk. 12:35-37; Lk. 20:41-44)</para>
  <para style="p">
    <verse number="41" style="v"/>Mati kya 'ba Farasi maako'e atoto rë nnï ga bi kölö, Yësu ako'jo hë zë iya henye, <verse number="42" style="v"/>“A'di ra asösu'e kö'du 'ba Korisitɔ? Mo tëmï kozo 'bëyï?” Zë aya'bannï dɔ mo iyannï henye, “Mo tëmï kozo a Dawidi.” <verse number="43" style="v"/>Yësu ako'jo hë zë iya henye, “Kö'du a'di ra Lawo Kölö Laka ï'dï Dawidi zi ko'jo mo na Yere? Mati Dawidi ëdï ame'do mo iya henye,</para>
  <para style="q">
    <verse number="44" style="v"/>‘Yere iya zi Yere 'bama,</para>
  <para style="q">'Alima kinye da tïrï ma</para>
  <para style="q">le mï'dï vo wehe 'bëyïye ku mïdïrï ndï yï.'’</para>
  <para style="m">
    <verse number="45" style="v"/>Ëzë Dawidi ako'jo mo ‘Yere,’ hala Korisitɔ atëdï tëmï kozo 'ba Dawidi?” <verse number="46" style="v"/>Vïdï maako aya'ba da kö'du ko'jo ne dë zi Yësu. Ta pëtï ko'do nani, vïdï maako ako'jo ha Yësu dekpe.</para>
  <chapter number="23" style="c"/>
  <para style="s">Kö'du kyënyë 'ba Farasiye</para>
  <para style="r">(Mk. 12:38-39; Lk. 11:43, 20:45-46)</para>
  <para style="p">
    <verse number="1" style="v"/>Yësu ame'do zi vïdï kayo ne'e, vo lö'bö 'bënï ëtï iya henye, <verse number="2" style="v"/>“Vo komoyandi 'ba vo kö'du kï'dï nnï Farasi ëtï, ëdïnnï kyigɔ aba zi yëtï zi ye kö'du kï'dï 'ba Mosa. <verse number="3" style="v"/>Owo'e kö'du mati zë iyannï zi ye zi ko'dɔ, kö'du ko'dɔ 'bëzë anza dë na laka zi ye gɔ mo kïrï. Zë ayadannï kö'du wa zi ye ko'dɔ mo, zë o'dɔnnï dë. <verse number="4" style="v"/>Zë ï'dïnnï wa yeto ma kyedre mati vïdï ɔ'bɔ dë zi kïnjë mo ne da vïdïye. Zë ombannï dë zi kɔnyi zë zi kïnjë le nje da gisi kala nnï aba.”</para>
  <para style="p">
    <verse number="5" style="v"/>“Zë o'dɔnnï wa mati vïdï zi kongɔ. Zë idannï kɔ'di piri konda ga bɔngɔ 'bënnï zi yada zë na laka. Zë ï'dïnnï bɔngɔ kanyi kölökpö gë nnï zi yada zë na vo mötu. <verse number="6" style="v"/>Zë o'dɔnnï lɔvɔ bi ma laka ne, bi 'ba karama, bi lima mati na laka aba mï bi 'ba mötu. <verse number="7" style="v"/>Zë o'dɔnnï lɔvɔ zi mëtënnï watɔwɔ aba mï bi 'ba wakogo. Zë o'dɔnnï lɔvɔ zi ko'jo vo komoyandi.”</para>
  <para style="p">
    <verse number="8" style="v"/>“Akɔ'jɔ yï dë, ‘Vo komoyandi,’ ga kö'du 'e biya ta dakota kölö, vo komoyandi nje kölö. <verse number="9" style="v"/>Akɔ'jɔ vïdï maako dë dakaŋo kinye na ‘'bu,’ ga kö'du ëdïye nje 'bu kölö aba komorïyë. <verse number="10" style="v"/>Ako'jo yï dë na ‘vo komoyandi,’ ga kö'du vo komoyandi kölö 'bëyï ra Korisitɔ. <verse number="11" style="v"/>Ma kyedre kölö mï kutë'e mëdï na vo kalima. <verse number="12" style="v"/>Mo mati o'dɔ rë nï na kyedre, maya'ba rë nï hulëhu, mo mati o'dɔ rë nï hulëhu, ako'dɔ mo kyedre.”</para>
  <para style="s">Yësu ayada kö'du kyënyë ko'dɔ 'ba vo komoyandiye</para>
  <para style="r">(Mk. 12:40; Lk. 11:39-42, 44, 52; 20:47)</para>
  <para style="p">
    <verse number="13" style="v"/>“Hala atëdï na kyënyë zi ye, vo komoyandi 'ba vo kö'du kï'dï Farasi ëtï. 'E vïdï komokandi ne'e, isiye ha loko 'ba damöku 'ba Wïrï kazi vïdï ödunnï, kpa ödu'e dë. Ayata'e vïdï mati ëdï rë nnï kï'dï zi tödu ne kpa.”</para>
  <para style="p">
    <verse number="14-15" style="v"/>“Atëdï na kyënyë zi ye vo komoyandi 'ba kö'du kï'dï Farasi ëtï. 'E vo komokandi ra. Umu'e kyëtï ranga kayo kpuru tëmï dakaŋo kutu kutu biya lasi aba, zi vïdï maako ki'ja zi gërï 'be'e ne kïrï. Ëzë i'ja'e vïdï ne ku, o'dɔ'e mo ndra na kyënyë tada'e, zi tï'bë mï gehena kaa 'e.”</para>
  <para style="p">
    <verse number="16" style="v"/>“Riti atëdï na kyënyë zi ye, alaga'e dagba zi vïdï, mora 'e na vo komoköndu. Ayandiye iya 'e henye, ëzë vïdï maako alömu ru yëkëlu aba, mo anza dë na kida lömu 'bënï ne aba. Ëzë mo alömu ru dahabo mati mï yëkëlu ne aba, mo ku na kida. <verse number="17" style="v"/>'E vo komoköndu lumë'e, vala ra na kyedre, dahabo kɔdɔ yëkëlu ra o'dɔ, dahabo na laka? <verse number="18" style="v"/>Ayandiye kpa iya'e henye, ‘Ëzë vïdï maako alömu ru karasa aba, mo anza dë na kida lömu 'bënï ne aba. Ëzë mo alömu rë nï ku wa ma ï'dï da karasa ne aba, mo ku na kida.’ <verse number="19" style="v"/>'E vo komoköndu ne'e, ma vala ra na kyedre wakï'dï kɔdɔ karasa ra, o'dɔ wakï'dï na koho? <verse number="20" style="v"/>Ëzë vïdï maako alömu ru karasa aba, mo ëdï lömu kpa wa mati biya ï'dï dɔ mo ne. <verse number="21" style="v"/>Ëzë mo alömu ru yëkëlu aba, mo ëdï lömu mo aba, ehe Wïrï mati ëdï alima mï mo. <verse number="22" style="v"/>Ëzë vïdï maako alömu komorïyë aba, mo ëdï lömu kyïtï 'ba Wïrï mati mo alima dɔ mo.”</para>
  <para style="p">
    <verse number="23" style="v"/>“Atëdï na riti zi ye vo komoyandi 'ba vo kö'du kï'dï nnï Farasi ëtï. 'E vo komokandi ne'e, ï'dïye zi Wïrï 'butë, wokonyo tisiwa kaa kököwu. Mora o'dɔ'e wa ma laka ndra 'ba ködu kï'dï dë, kaa tïnyö, mïkyëyï, koma aba. <verse number="24" style="v"/>O'dɔ re 'e na vo dagba zi vïdï, mora 'e na vo komoköndu, oba'e kɔŋɔ tisi yaga tëmï wa kuwë 'be'e, ondrɔ'e jemele.”</para>
  <para style="p">
    <verse number="25" style="v"/>“Atëdï na riti zi ye vo komoyandi 'ba vo kö'du kï'dï Farasi ëtï. 'E vo komokandi ne'e, akaka'e ra sikɔ 'be'e gbenje aba ta rɔ mo yaga, mï zë ndɔ na wakoyi mï kumbë aba. <verse number="26" style="v"/>Farasi vo komoköndu, akyitɔ wa mati ëdï mï sikɔ dagba, ma ta yaga akakyitɔ kpa 'da.”</para>
  <para style="p">
    <verse number="27" style="v"/>“Atëdï na riti zi ye vo komoyandi 'ba vo kö'du kï'dï Farasi ëtï. 'E vo komokandi ne'e, 'e kaa da wogo mati akɔ'jɔ rë zë na kanyi, lunzu ṛï'dï kanyi aba, ongɔ na laka tarë zë yaga, mï zë ndɔ na yingɔ keŋe yöku aba. <verse number="28" style="v"/>Tëmï gërï kölö ne, ta ra'e yaga na laka zi vïdï biya, mï ye ndɔ na komokandi kö'du lïtë aba.”</para>
  <para style="s">Yësu ame'do kö'du riti 'bëzë</para>
  <para style="r">(Lk. 11:47-51)</para>
  <para style="p">
    <verse number="29" style="v"/>“Atëdï na riti zi ye vo komoyandi 'ba vo kö'du kï'dï Farasi ëtï. 'E vo komokandi ne'e, o'ba'e ogo na laka zi nëbïye, ayada'e tɔwɔ zi wogo zi vïdï mati alimannï kyere na lima ma laka. <verse number="30" style="v"/>Iya'e henye, ëzë ëdïye kyere mï kadra 'ba 'bu'e vu'e nani, o'dɔ'e kö'du mati zë o'dɔnnï nëbï ne'e, kofo mo gɔ mo ne dë. <verse number="31" style="v"/>Omba'e dɔ mo tïnyö, 'e ra na kozo 'ba vïdï ma ofonnï nëbï ne'e. <verse number="32" style="v"/>Ï'bë'e zɔ dagba wa mati 'bu'e vu'e ayetonnï ne kinde mo.”</para>
  <para style="p">
    <verse number="33" style="v"/>“'E wiri ne'e, 'e gisi 'ba wiri ne'e, hala asösu'e zi taho. Kazi vurë re 'e, atï'bë'e biya mï gehena. <verse number="34" style="v"/>Mayada zi ye makutu nëbï ne'e, kora vo kö'du yɔlɔ, vo komoyandi ëtï, akofo'e kyamo'e, akatötö'e agamo'e akakpökyïye agamo'e mï bi 'ba mötu'e, akore'e zë tëmï gawo ta da gawo. <verse number="35" style="v"/>Riti biya kö'du vïdï mbiya mati ofo'e ne akalëpï de 'e tëmï kozo 'ba Abele zi kozo 'ba Zakariya wisi 'ba Berahiya mati ofo'e mï kutë yëkëlu karasa aba. <verse number="36" style="v"/>Mayada zi ye tïnyö, riti biya 'ba wakofo ne akalëpï da vïdï 'ba ko'do nenye.”</para>
  <para style="s">Yësu o'dɔ lɔvɔ Yerusalema</para>
  <para style="r">(Lk. 13:34-35)</para>
  <para style="p">
    <verse number="37" style="v"/>“Yerusalema, Yerusalema ofo'e nëbïye, u'du'e vo lö'bö mati Wïrï utu zi ye ne ṛï'dï aba. Da ndö momba zi kala ma kï'dï mo kpo ra vïdï 'be'e biya, kaa ma yëru mati atoto gisisi ënï hu förö nï, ila'e ma dë. <verse number="38" style="v"/>Loko 'be'e ne akila na mï mbiya. <verse number="39" style="v"/>Tëmï ndenye dagba ani, mayada zi ye henye, ongɔ'e ma dekpe löhu le akiya'e henye, ‘Wïrï ï'dï ya'da zi mo mati ayi mï ru 'ba Yere.’”</para>
  <chapter number="24" style="c"/>
  <para style="s">Yësu ame'do ga kö'du loko 'ba Wïrï yaŋa</para>
  <para style="r">(Mk. 13:1-2; Lk. 21:5-6)</para>
  <para style="p">
    <verse number="1" style="v"/>Yësu ënyï ila bi nani ëdï gbɔ atï'bë 'de tëmï yëkëlu, vo lö'bö 'bɔmo ayinnï zi yada zi mo kuvö 'ba loko 'ba Wïrï ne. Mo ënyï alëzë. <verse number="2" style="v"/>“Ɔɔ. Ongɔ'e bi biya na laka da wa nenye'e. Mayada zi ye henye, yïtö ma kölö kinye alima dë ga bi 'bënï zë biya aku'du akaŋo.”</para>
  <para style="s">Riti vïdï yaza aba</para>
  <para style="r">(Mk. 13:3-13; Lk. 21:7-19)</para>
  <para style="p">
    <verse number="3" style="v"/>Mati Yësu alima da Döku 'ba Olivo, vo lö'bö ayinnï na liwo zi mo, ako'jonnï hɔ mo iyannï henye, “Ayada zi ze kö'du biya nenye atëdï ndala aba, a'di ra ako'dɔ rë nï zi yada mo henye, ‘Ku tayi 'bëyï ndundu 'ba daliŋɔ aba.’”</para>
  <para style="p">
    <verse number="4" style="v"/>Yësu aya'ba dɔ mo iya henye, “Ëdïye komo kï'dï aba, ila'e vïdï maako mo'ba 'e dë. <verse number="5" style="v"/>Vïdï kayo atayinnï me'do ru ma aba ako'bannï vïdï kayo akiyannï henye, ‘Ma, Korisitɔ ra.’ <verse number="6" style="v"/>Akowo'e kpɔrɔ wehe kara dakapa, kö'du yöyö 'ba wehe aba na kɔwɔ, ere'e dë. Wa ne ako'dɔ rë nï, anza dë zi kiya henye, ndundu mo ɔkɔ ku. <verse number="7" style="v"/>Dakaŋo ako'dɔ wehe oka maako aba, damöku akalëpï wehe aba da ma kölö maako. Zöyï atëdï, kinzikinzi atëdï ta ga bi ne biya. <verse number="8" style="v"/>Wa ne atëdïnnï biya kaa dagba tɔɔ 'ba wisi ko'jo.”</para>
  <para style="p">
    <verse number="9" style="v"/>“Akïrïye, akï'dïye zi ko'dɔ mo na kyënyë zi kofo. Vïdï biya akoyi 'e ga kö'du ma. <verse number="10" style="v"/>Mï kadra nani, vo kö'du komba'e akalëpïnnï tëmï kö'du koma 'bënnï, zë akasusunnï oka maako, akoyinnï oka maako. <verse number="11" style="v"/>Nëbï vo ndɔndɔ kayo'e akalayannï vïdï kayo ko'ba aba. <verse number="12" style="v"/>Ne atëdï rapere 'ba kö'du kyënyë ko'dɔ, zi vïdï kayo lɔvɔ 'bëzë ofɔ. <verse number="13" style="v"/>Vïdï mati ɔrɔ nduwë na kyigɔ mï ndundu mo, akayɔmɔ mo. <verse number="14" style="v"/>Kö'du yöyö laka nenye ga kö'du 'ba damöku akayëtï zi vïdï 'ba dakaŋo ne biya kaa vo hu kö'du dɔrɔ, ndundu mo atɔkɔ 'da.”</para>
  <para style="s">Wa kyënyë ma ndra</para>
  <para style="r">(Mk. 13:14-23; Lk. 21:20-24)</para>
  <para style="p">
    <verse number="15" style="v"/>“Mati ongɔ 'e wa kyënyë ma ndra mï loko 'ba Wïrï ma ayaŋa, ma nëbï Daniyele ame'do kö'du mo. Atɔrɔ bi ma laka. Kö'du nenye zi vo ko'jo mo: ayɔlɔ laka mï kö'du nenye a'di. <verse number="16" style="v"/>Vïdï mati ëdïnnï mï Yudiya atahonnï da lutu. <verse number="17" style="v"/>Vïdï maako mati ëdï da loko ënï, i'ja kadra dekpe zi tasi akaŋo zi wasisi 'bënï koba ta loko. <verse number="18" style="v"/>Vïdï maako mati ëdï mï yaka a'ba dekpe hulëhu zi bɔngɔ ënï koba. <verse number="19" style="v"/>Atëdï na kyënyë mï ko'do naniye zi mbara mati ɔmɔnnï 'e mbara mati ëdïnnï gisiluru aba: <verse number="20" style="v"/>Amötu'e zi Wïrï kazi aho'e tëmï tona mandere mï ko'do kadra 'ba ralawo. <verse number="21" style="v"/>Ga kö'du riti mï kadra nani atëdï na kɔwɔ ndra ta da riti, mati ëdï tëmï biyeto 'ba damöku tëmï ko'do ma ndenye ne. Ani, wa maako atanza dekpe kaa mo löhu. <verse number="22" style="v"/>Wïrï aya'ba ra watiti 'ba ko'do naniye, mo mo'dɔ dë here, vïdï maako ɔmɔ dë. Ga kö'du vïdï jeli 'bënïye Wïrï akaya'ba mï kadra ko'do nani 'e 'da.”</para>
  <para style="p">
    <verse number="23" style="v"/>“Ëzë vïdï maako iya zi yï henye, ‘Ongɔ te, Korisitɔ ëdï kinye, mandere mo ëdï nani,’ oma dë mï kö'du ne. <verse number="24" style="v"/>Ga kö'du Korisitɔ vo ndɔndɔ 'e nnï nëbï vo ndɔndɔ ëtï akalayannï, zë ako'dɔnnï kö'du ko'do kyedre rakaga aba zi vïdï jeli a Wïrï ko'ba ëzë zë atɔ'bɔnnï. <verse number="25" style="v"/>Owo'e te, mayada kö'du nenye zi ye gba kazi kadra mo tɔkɔ.”</para>
  <para style="p">
    <verse number="26" style="v"/>“Ëzë vïdï maako ayada zi ye iya henye, ongɔ'e te, mo ëdï yaga mï da lïpï, ï'bë'e dë ani, mandere ëzë zë iyannï henye, ongɔ'e te, mo ëdï rë nï koho kinye oma'e dë mï kö'du ne. <verse number="27" style="v"/>Ga kö'du Wisi a Vïdï atayi kaa bikanyi mati alaka komorïyë ta humïrë le da mïrë. <verse number="28" style="v"/>Ëzë yöku ëdï, langa akatoto rë nnï.”</para>
  <para style="s">Tayi 'ba Wisi a Vïdï</para>
  <para style="r">(Mk. 13:24-27; Lk. 21:25-28)</para>
  <para style="p">
    <verse number="29" style="v"/>“Kandi ta pëtï riti 'ba ko'do naniye, kadra akuyï rë nï na mandölu, yehwe anyi dekpe, kyëlu akalëpïnnï ta komorïyë, wa ma komorïyë akakɔhɔ rë nnï. <verse number="30" style="v"/>Kyïnë wa mati akayada kö'du 'ba Wisi a Vïdï akalaya komorïyë, vïdï biya 'ba dakaŋo akudunnï ëzë ongɔnnï Wisi a Vïdï ëdï atayi tëmï fɔli 'ba komorïyë kyigɔ bikanyi kyedre 'bënï aba. <verse number="31" style="v"/>Kyedre torombeta akata'a, mo akutu malayika 'bënïye yaga mï bi gɔlɔ'bɔ sowɔ 'ba dakaŋo. Zë akatotonnï vïdï jeli ɔmo'e tëmï ndundu 'ba dakaŋo ne biya.”</para>
  <para style="s">Kaga kyëlu</para>
  <para style="r">(Mk. 13:28-31; Lk. 21:29-33)</para>
  <para style="p">
    <verse number="32" style="v"/>“Kaga kyëlu ma yandi kö'du yɔlɔ zi ye. Ëzë ngora mo ïnzï ku, akofɔ rë nï na luwë, mbili yëyu makyïyï akayeto gbɔ tövu, akayɔlɔ'e umu ku kara. <verse number="33" style="v"/>Tëmï gërï kölö ne, ëzë ongɔ'e wa ne ku biya, akayɔlɔ'e kadra mo ku kara nzɔ zi rë nï yeto. <verse number="34" style="v"/>Mayada tïnyö zi ye, wa ne biya ako'dɔ rë nï dagba, kazi vïdï ma ëdïnnï lima yaanya aba ne, oli dë gba biya. <verse number="35" style="v"/>Komorïyë dakaŋo aba akalagannï, me'do 'bama alaga dë.”</para>
  <para style="s">Vïdï maako ayɔlɔ ko'do mo kadra aba dë</para>
  <para style="r">(Mk. 13:32-37; Lk. 17:26-30, 34-36)</para>
  <para style="p">
    <verse number="36" style="v"/>“Vïdï maako ayɔlɔ ko'do mo kadra aba dë. Kpa le malayika komorïyë mandere Wisi ayɔlɔnnï dë, nje 'bu ra akayɔlɔ. <verse number="37" style="v"/>Tayi 'ba Wisi a Vïdï ako'dɔ rë nï kaa mï kadra 'ba Nowa. <verse number="38" style="v"/>Mï ko'do gba ta komo wini koso, vïdï ëdïnnï wakonyo, wa kuwë, vïdï kora rë nnï koze mbara ëtï, le mï ko'do mati Nowa ï'bë ödu mï töŋbö, <verse number="39" style="v"/>ayɔlɔnnï kö'du mati ëdï rë nï ko'dɔ ne dë, le wini koso ayi akyitɔ zë biya. Ëzë Wisi a Vïdï ayi akatëdï here. <verse number="40" style="v"/>Mï kadra nani vïdï kora rïyö atëdïnnï lɔɔ ko'dɔ mï yaka. Ma kölö akoba, agamo akila hulëhu. <verse number="41" style="v"/>Vïdï mbara rïyö atëdïnnï bi 'ba wakuhu, ma kölö akoba, agamo akila hulëhu.”</para>
  <para style="p">
    <verse number="42" style="v"/>“Ëdïye komo kï'dï aba ga kö'du ayɔlɔ'e dë, mï ko'do vala ra Yere 'be'e atayi. <verse number="43" style="v"/>Ëzë vo kyeti liŋɔ ayɔlɔ kadra mati vo logo atayi, tïnyö akayɔlɔ'e henye, mo akalima na ngö ila vo logo dë zi tödu mï loko ënï. <verse number="44" style="v"/>Here ëdï 'e kpa 'duwï nzɔ, ga kö'du Wisi a Vïdï atayi mï kadra mati anza'e dë komo kï'dï aba gɔ mo.”</para>
  <para style="s">Vo kalima koma vo kazi koma aba</para>
  <para style="r">(Lk. 12:41-48)</para>
  <para style="p">
    <verse number="45" style="v"/>“Ëyï ra vo lö'bö laka, kö'du yɔlɔ aba? Mo ra mati kyedre 'bɔmo ï'dï mo na ga vo lö'bö oka nïye kongɔ wakonyo 'bëzë kï'dï mï kadra ma laka. <verse number="46" style="v"/>Rakyenyi atëdï zi vo lö'bö ne hala, ëzë kyedre 'bɔmo i'ja mo lɔɔ ne ko'dɔ, ëzë mo a'ba liŋɔ. <verse number="47" style="v"/>Mayada tïnyö zi ye, kyedre ne akï'dï vo lö'bö na vo da wasisi ënï biya. <verse number="48" style="v"/>Ëzë mo na vo lö'bö ma kyënyë, mo akayada na bi dënï henye, ‘Kyedre 'bënï ne ayi dekpe hulëhu kandi,’ <verse number="49" style="v"/>mo akayeto vo lö'bö okanïye ku'bö zi wakonyo wa kuwë aba na kyënyë. <verse number="50" style="v"/>Kyedre 'ba vo lö'bö ne atayi ko'do maako aba, mati vo lö'bö ne anza dë komo kï'dï aba gɔ mo, mï kadra mati mo ayɔlɔ dë. <verse number="51" style="v"/>Kyedre akasese mo kozokozo 'ba vo komokandi ne zë ëtï, ani mo akudu hë nï konyo aba.”</para>
  <chapter number="25" style="c"/>
  <para style="s">Mala kö'du mïnzö ngulu 'butë</para>
  <para style="p">
    <verse number="1" style="v"/>“Mï kadra nani, damöku 'ba Wïrï atëdï henye. Mïnzö ngulu 'butë oba lamba ënnï ënyï ï'bënnï yaga da 'bïyësï kutrë. <verse number="2" style="v"/>Muyï tëmï zë na vo lumë, agamo'e muyï na vo kö'du yɔlɔ. <verse number="3" style="v"/>Ma vo lumë ne oba lamba 'bënnï obannï kya 'ba yënï wa'do dë nnï aba. <verse number="4" style="v"/>Ma vo kö'du yɔlɔ ne'e, obannï maṛanjiye ndɔ yënï aba mï mo. <verse number="5" style="v"/>'Bïyësï alïkö dënï tisi ta bi tayi, mïnzö ne'e, ayetonnï nano o'donnï gbɔ.”</para>
  <para style="p">
    <verse number="6" style="v"/>“Ëdï mï kutë yɔndɔ kudu aa yaga iya henye, ‘'Bïyësï ëdï kinye, ayiye dɔ mo kutrë.’ <verse number="7" style="v"/>Mïnzö 'butë ne ënyï alironnï, akɔ'jɔ lamba ënnï gbɔ. <verse number="8" style="v"/>Mïnzö ma lumë ne iyannï zi ma vo kö'du yɔlɔ ne'e henye, ‘Ï'dïye kya 'ba yënï 'be'e, tisi zi ze, ga kö'du 'beze inde rë nï ku.’ <verse number="9" style="v"/>Vo kö'du yɔlɔ ne aya'bannï dɔ mo iyannï henye, ‘'E'e, anza dë kyɔ ga kö'du 'e ehe ze, ï'bë'e bi 'ba wakogo kyamo kogo ga kö'du'e.’ <verse number="10" style="v"/>Mïnzö ma lumë ne ënyï ï'bënnï gbɔ kya 'ba yënï kogo. Mati ëdïnnï tï'bë, 'bïyësï ɔkɔ gbɔ ta gë zë. Zë mati nzɔ muyï ne ënyï ï'bënnï mo aba mï karama 'ba oze isinnï ha loko gbɔ. <verse number="11" style="v"/>Yaa, mïnzö agamo ne ɔkɔnnï, ënyïnnï kudu iyannï henye, ‘Kyedre, kyedre, ayëhu ha loko zi ze tödu.’ <verse number="12" style="v"/>'Bïyësï aya'ba dɔ mo iya henye, ‘'E'e, mayɔlɔ 'e dë.’” <verse number="13" style="v"/>Yësu ï'dï dɔ mo iya henye, “Ëdïye komo kï'dï aba ga kö'du ayɔlɔ'e ko'do mo kadra mo aba dë.”</para>
  <para style="s">Mala kö'du vo kalima wota</para>
  <para style="r">(Lk. 19:11-27)</para>
  <para style="p">
    <verse number="14" style="v"/>“Mï kadra nani aba, damöku 'ba Wïrï atëdï henye. Kora maako ëdï omba ku zi tï'bë bi yingɔ, mo ako'jo vo kalima 'bënï ne'e ise ga wasisi 'bënï zi zë zi tëdïnnï na vo gɔ mo kongɔ. <verse number="15" style="v"/>Mo ï'dï zi ma kölö wa mati mo akatɔ'bɔ ko'dɔ mo. Zi ma kölö, mo ï'dï kɔhi dahabo ŋbiriṛi kpulukumuyï. Zi agamo, mo ï'dï kpulukurïyö, zi ma wota mo kpulukukölö, ënyï ï'bë gbɔ bi yingɔ. <verse number="16" style="v"/>Vo kalima mati oba 'bënï kɔhi ŋbiriṛi kpulukumuyï ne kandi ï'bë o'dɔ lɔɔ mo aba, i'ja dɔ mo kpa kpulukumuyï. <verse number="17" style="v"/>Tëmï gërï kölö ne vo kalima mati oba kpulukurïyö ne, i'ja dɔ mo kpa kpulukurïyö. <verse number="18" style="v"/>Vo kalima mati ïrï 'bënï kpulukukölö ne, ï'bë ole wogo mï kaŋo oho kɔhi 'ba kyedre 'bënï ne gbɔ mï mo.”</para>
  <para style="p">
    <verse number="19" style="v"/>“Gɔ mo ëhï na konda, kyedre 'ba vo kalima ne'e ayi hulëhu alimannï ga kɔhi ne kiti mo zë ëtï. <verse number="20" style="v"/>Vo kalima mati ïrï kɔhi 'bënï kpulukumuyï ne, ödu ï'dï kpulukumuyï agamo. Mo iya henye, ‘Ï'dï zi ma kɔhi ŋbiriṛi kpulukumuyï, kyedre, ongɔ te, nenye aga kpulukumuyï vere mati mi'ja.’ <verse number="21" style="v"/>Kyedre 'bɔmo iya zi mo henye, ‘O'dɔ ku laka, yï vo kalima 'ba kö'du koma laka ra. Ëdï mï koma aba zi kɔhi tisi ne ki'ja mo here, ma kï'dï yï na vo da kɔhi ma kyedre. Ayi loko ta, dayanyi mï rakyenyi ne yï aba.’”</para>
  <para style="p">
    <verse number="22" style="v"/>“Vo kalima mati ï'dï 'bɔmo kpulukurïyö ne ayi loko iya henye, ‘Ï'dï zi ma kɔhi kpulukurïyö, kyedre ongɔ te, kinye kya 'ba kpulukurïyö agamo mati mi'ja.’ <verse number="23" style="v"/>Kyedre 'bɔmo iya zi mo henye, ‘O'dɔ ku laka yï vo kalima 'ba kö'du koma laka ra. Ëdï mï koma aba zi kɔhi tisi ne ki'ja mo here, makï'dï yï na vo da kɔhi ma kyedre. Ayi loko ta, dayanyi mï rakyenyi ne yï aba.’”</para>
  <para style="p">
    <verse number="24" style="v"/>“Vo kalima mati ïrï 'bënï kpulukukölö ne, ayi ödu loko iya henye, ‘Kyedre, mayɔlɔ yï kora vo kala kyigɔ ra, ëdï wakumu kpa ïyï dë, ëdï wa 'ba yaka toto kpa kazi kofo kïlï. <verse number="25" style="v"/>Ma na tere, mï'bë moho kɔhi 'bëyï ne mï kaŋo ongɔ te, kinye wë yï ëdï.’ <verse number="26" style="v"/>Kyedre 'bɔmo iya zi mo henye, ‘Yï vo kalima vo wëdï kyënyë. Ayɔlɔ dë mëdï wakumu kpa mïyï dë, wa toto ta yaka kazi kofo kïlï? <verse number="27" style="v"/>Laka, ï'dï kɔhi ama ne kyere mï loko 'ba kɔhi sesi, ma koba biya hulëhu dɔ mo mati i'ja ne aba ëzë ma'ba ku liŋɔ.’”</para>
  <para style="p">
    <verse number="28" style="v"/>“Yaanya aba oba'e kɔhi ne 'de kazi mo ï'dïye zi ma kpuluku'butë aba ne. <verse number="29" style="v"/>Ga kö'du vïdï biya mati ëdï wa aba, le kyɔ akï'dï, mo atëdï mo aba kyɔ. Ta da mati mo ëdï mo aba. Vïdï mati anza wa aba dë, gbï le nje ma tisi mati mo ëdï mo aba, akoba 'de kazi mo. <verse number="30" style="v"/>Vo kalima lumë ne, u'du'e mo yaga mï bi köndu ani mo akudu hë nï konyo aba.”</para>
  <para style="s">Ndundu 'ba vurë</para>
  <para style="p">
    <verse number="31" style="v"/>“Mati Wisi a Vïdï ayi mï bikanyi kyedre malayika ëtï, mo akalima da kyïtï, <verse number="32" style="v"/>vïdï 'ba damöku ne akatoto biya komo mo. Mo akinye mï zë mï gboko rïyö, kaa vo tïmëlë yako inye tïmëlë tara wanya here. <verse number="33" style="v"/>Mo akï'dï vïdï ma laka 'e da kala nï ma tïrï, ma kyënyë'e da kala nï ma gali.”</para>
  <para style="p">
    <verse number="34" style="v"/>“Yere akiya zi vïdï ma da kala nï ma tïrï ne henye, ‘'Ayiye, 'e mati 'bu ma ï'dï ya'da ku zi ye ne. Ayiye mï damöku mati akɔ'jɔ ku kyere zi ye, ko'dɔ 'ba dakaŋo aba. <verse number="35" style="v"/>Ma na o'bo, ï'dïye wakonyo zi ma. Ma na kɔdrɔ, ï'dïye wini zi ma kuwë. Ma na vo leze, oba'e ma liŋɔ 'be'e. <verse number="36" style="v"/>Ma na ga mbiṛö usu'e bɔngɔ ra ma. Ma na rakɔɔ, ongɔ'e ga ma. Ma mï kamba, ëdïye tï'bë ma kongɔ.’”</para>
  <para style="p">
    <verse number="37" style="v"/>“Vïdï ma laka ne akaya'bannï dɔ mo zi mo, akiyannï henye, ‘Ndala aba ya Yere, dongɔ yï na o'bo, dïdï wakonyo zi yï, mandere kɔdrɔ aba, dïdï wini zi yï kuwë? <verse number="38" style="v"/>Ndala aba di'ja yï na tu'dë maako dïrï ze yï liŋɔ 'beze, mandere na ga mbiṛö dusu bɔngɔ rë yï? <verse number="39" style="v"/>Ndala aba dongɔ yï na rakɔɔ mandere mï kamba dëdï tï'bë yï kongɔ?’ <verse number="40" style="v"/>Yere akaya'ba zi zë akiya henye, ‘Mayada zi ye, ëzë o'dɔ'e kö'du ne gbï le nje zi vïdï ma tisi kaa ma nenye'e ne, o'dɔ'e ku zi ma.’”</para>
  <para style="p">
    <verse number="41" style="v"/>“Mo akiya zi zë ma da galinï ne, ‘Ï'bë'e 'de tara ma karani 'e mati mï wa sënë a Wïrï. Ï'bë'e 'de mï wa'do ma kazi ndundu, mati akɔ'jɔ ku zi Satani malayika 'bënï ëtï. <verse number="42" style="v"/>Ma na o'bo ï'dïye wakonyo dë zi ma. Ma na kɔdrɔ ï'dïye wini dë zi ma kuwë. <verse number="43" style="v"/>Ma na vo leze, ïrïye ma dë kala aba mï liŋɔ 'be'e. Ma na ga mbiṛö usu'e bɔngɔ dë ra ma. Ma na rakɔɔ mï kamba ongɔ'e ga ma dë.’”</para>
  <para style="p">
    <verse number="44" style="v"/>“Akaya'bannï dɔ mo zi mo, akiyannï henye, ‘Ndala aba ya Yere, dongɔ yï na o'bo, na kɔdrɔ, na vo leze, na ga mbiṛö, na rakɔɔ, mï kamba, dakɔnyi yï dë?’ <verse number="45" style="v"/>Yere akaya'ba dɔ mo akiya henye, ‘Mayada zi ye, ëzë omba'e dë zi kɔnyi gbï le nje vïdï ma tisi nenye'e ne, omba'e dë ne ma ra kɔnyi.’ <verse number="46" style="v"/>Vïdï kyënyë ne'e atï'bënnï mï wa'do ma ŋburu ŋburu riti aba, vïdï ma laka akatï'bë 'bënnï mï dïdï ma ŋburu ŋburu.”</para>
  <chapter number="26" style="c"/>
  <para style="s">Yeṛe ko'dɔ ra Yësu</para>
  <para style="r">(Mk. 14:1-2; Lk. 22:1-2; Yn. 11:45-53)</para>
  <para style="p">
    <verse number="1" style="v"/>Mati Yësu inde kö'du ne'e yandi mo ku biya, mo iya zi vo lö'bö 'bënïye henye, <verse number="2" style="v"/>“Mï ko'do rïyö aba kaa ayɔlɔ'e atëdï karama 'ba laga 'ba koli, Wisi a Vïdï akï'dï zi tötö mo.” <verse number="3" style="v"/>Kyedre 'ba vo karasa nnï vïdï kyedre'e ëtï atoto rë nnï mï loko kyedre 'ba Kayafa vo da vo da karasa'e. <verse number="4" style="v"/>O'dɔnnï yeṛe zi Yësu kïrï zi kofo mo na liwo. <verse number="5" style="v"/>Zë iyannï henye, “Do'dɔ'e dë mï kadra karama. Kazi vïdï ënyïnnï na wehe.”</para>
  <para style="s">Ope yënï da Yësu mï Beteniya</para>
  <para style="r">(Mk. 14:3-9; Yn. 12:1-8)</para>
  <para style="p">
    <verse number="6" style="v"/>Mati Yësu ëdï mï Beteniya liŋɔ 'ba Simona, kora mati na riti kɔɔ mönyu aba ne. <verse number="7" style="v"/>Mati Yësu ëdï wakonyo, vïdï mbara ayi zi mo yënï ogo kɔhi kyedre aba, mo ope gbɔ dɔ mo. <verse number="8" style="v"/>Mati vo lö'bö 'bɔmo ongɔnnï kö'du ne here, ënyïnnï na kamo. Zë ako'jonnï kö'du iyannï henye, “Kö'du a'di ayaŋa wa ne biya here gɔ mo? <verse number="9" style="v"/>Yënï këzï ngutru nenye akogo yaga kɔhi kyedre aba, kï'dï zi vo leriye.”</para>
  <para style="p">
    <verse number="10" style="v"/>Yësu ayɔlɔ kö'du mati zë ëdïnnï kiya ne, iya zi zë henye, “Kö'du a'di ëdïye sawiya ko'dɔ zi mbara ne? Kö'du teme laka ra mo o'dɔ zi ma. <verse number="11" style="v"/>Atëdïye 'duwï vo lere ëtï mï kutë'e, anza'e dë 'duwï ma aba. <verse number="12" style="v"/>Kö'du mati mo o'dɔ zi yënï këzï ngutru nenye kope ra ma, zi kɔ'jɔ ma nzɔ zi kusu. <verse number="13" style="v"/>Yaanya aba mayada zi ye, bi ma yöyo laka nenye ayëtï zi mo mï dakaŋo ne biya, wa mati mo o'dɔ ne atëdï na kö'du sösu ga kö'du mo.”</para>
  <para style="s">Yudasi omba da kö'du zi Yësu susu.</para>
  <para style="r">(Mk. 14:10-11; Lk. 22:3-6)</para>
  <para style="p">
    <verse number="14" style="v"/>Ma kölö tëmï vo lö'bö 'butë dɔmorïyö ne ru mo Yudasi Sikereto ï'bë zi vo da karasa'e <verse number="15" style="v"/>ako'jo hɔ mo iya henye, “Akï'dïye a'di zi ma, ëzë masusu Yësu zi ye?” Zë itinnï kɔhi ŋbiriṛi 'butëwota ï'dïnnï gbɔ zi mo. <verse number="16" style="v"/>Ta gɔ mo Yudasi ëdï gërï ma laka koma zi Yësu kï'dï zi zë.</para>
  <para style="s">Yësu onyo wakonyo 'ba karama 'ba laga 'ba koli</para>
  <para style="r">(Mk. 14:12-21; Lk. 22:7-13; 21-23; Yn. 13:21-30)</para>
  <para style="p">
    <verse number="17" style="v"/>Mï dagba ko'do 'ba karama 'ba laga 'ba koli, vo lö'bö ayinnï zi Yësu ako'jonnï hɔ mo iyannï henye, “Kila omba ze zi wakonyo 'ba karama 'ba laga 'ba koli ne, kɔ'jɔ mo nzɔ zi bi yï?” <verse number="18" style="v"/>Mo iya zi zë henye, “Ï'bë'e zi kora maako ayada'e zi mo henye, ‘Vo komoyandi iya henye, kadra ama ɔkɔ ku, ma vo lö'bö 'bama ëtï dako'dɔ karama 'ba laga 'ba koli liŋɔ 'bëyï.’” <verse number="19" style="v"/>Vo lö'bö o'dɔnnï kaa mati Yësu ayada zi zë, akɔ'jɔnnï wakonyo 'ba laga 'ba koli gbɔ.</para>
  <para style="p">
    <verse number="20" style="v"/>Kɔsi kadra aba, Yësu vo lö'bö 'butë dɔmorïyö ne ëtï, alimannï gbɔ akaŋo wakonyo. <verse number="21" style="v"/>Mati ëdïnnï wakonyo, Yësu iya zi zë “Mayada zi ye, vïdï ma kölö tëmï 'e akasusu ma.” <verse number="22" style="v"/>Vo lïtu'e na rasösu ayetonnï hɔ mo ko'jo ma kölö ta ga oka nï, “Tïnyö, Yere, iya dë ma ra?” <verse number="23" style="v"/>Yësu ënyï aya'ba dɔ mo zi zë iya henye, “Ma kölö mati usu kala nï ma aba mï gbenje ne akasusu ma. <verse number="24" style="v"/>Wisi a Vïdï akoli kaa mati kö'du yöru iya mo akoli, atëdï na riti zi vïdï mati asusu Wisi a Vïdï zi kofo ne. Atëdï na laka zi vïdï ne lima kazi ko'jo mo.”</para>
  <para style="p">
    <verse number="25" style="v"/>Yudasi vo susu ënyï ame'do rïyë iya henye, “Tïnyö vo komoyandi ayɔlɔ anza dë ma ra?” Yësu aya'ba dɔ mo iya henye, “Kaa mati iya ne.”</para>
  <para style="s">Wakonyo 'ba da hutaga 'ba Yere</para>
  <para style="r">(Mk. 14:22-26; Lk. 22:14-20, 1 Kr. 11:23-25)</para>
  <para style="p">
    <verse number="26" style="v"/>Mati zë ëdïnnï wakonyo, Yësu oba nzoyi mangɔlɔ'bɔ o'dɔ mötu 'ba öwö'dï, owe mï mo ï'dï zi vo lö'bö 'bënïye. Mo iya zi zë henye, “Oba onyo'e, nenye ida ra ma ra.” <verse number="27" style="v"/>Mo oba köfö o'dɔ öwö'dï zi Wïrï, ï'dï zi zë, iya henye, “Uwë'e, 'e biya ta ge'e. <verse number="28" style="v"/>Nenye yama ma mati na da kö'du kï'dï a Wïrï, yama mati alikɔ yaga ko'du vïdï kayo kila tëmï kö'du kyënyë. <verse number="29" style="v"/>Mayada zi ye makuwë a'ji nenye dekpe löhu le mï damöku a 'Bu ma.” <verse number="30" style="v"/>Aya'binnï ngala ënyï ï'bënnï gbɔ da Döku 'ba Olivo.</para>
  <para style="s">Yësu ame'do kö'du ha kiga 'ba Petero</para>
  <para style="r">(Mk. 14:27-31, Lk. 22:31-34; Yn. 13:36-38)</para>
  <para style="p">
    <verse number="31" style="v"/>Yësu iya zi zë henye, “Yɔndɔ nenye aba ataho'e biya akila'e ma kaa mati kö'du yöru iya henye, ‘Wïrï akofo vo tïmëlë yako, tïmëlë ne akapere rë nnï.’ <verse number="32" style="v"/>Ta pëtï tënyï 'bama tëmï koli, makatï'bë dagba komo'e mï Galilaya.” <verse number="33" style="v"/>Petero ënyï ame'do rïyë iya zi Yësu henye, “Mila yï dë, ëzë ma kayo ne'e, ilannï yï le.” <verse number="34" style="v"/>Yësu iya zi Petero henye, “Mayada zi yï gba kazi zanga ayapa mï yɔndɔ ne akiga hë yï, akiya da wota henye ere, ayɔlɔ ma dë.” <verse number="35" style="v"/>Petero ënyï aya'ba dɔ mo iya henye, “Ëzë le zi ma koli kö'du yï, mila yï dë.” Vo lö'bö agamo'e iyannï kpa kö'du kölö ne.</para>
  <para style="s">Yësu amötu mï Getesemina</para>
  <para style="r">(Mk. 14:32-42; Lk. 22:39-46)</para>
  <para style="p">
    <verse number="36" style="v"/>Yësu ënyï ï'bënnï vo lö'bö 'bënï ëtï mï bi mati ako'jo Getesemina, mo iya zi zë henye, “Alima'e kinye mëdï dero tï'bë dagba amötu.” <verse number="37" style="v"/>Mo oba nï aba Petero, gisi 'ba Zebedeyo rïyö. Yësu kö'du sösu riti aba, <verse number="38" style="v"/>mo iya zi zë henye, “Kö'du sösu mï di'di ma ne ku na kyedre, omba ku kara zi ma kofo. Alima'e kinye bi kida ma aba.” <verse number="39" style="v"/>Mo ënyï ï'bë tisi dagba kɔwɔ, umë rë nï na komokomo akaŋo amötu iya henye, “'Bu ma, ëzë atɔ'bɔ oba riti ne 'de ta da ma. Anza kö'du komba 'bama, kö'du komba 'beyï ra.”</para>
  <para style="p">
    <verse number="40" style="v"/>Mo ënyï a'ba zi vo lö'bö wota ne'e, i'ja zë ako'do, mo iya zi Petero henye, “Hala 'e wota ne ɔ'bɔ'e dë zi bi kida ma aba gbï le nje kadra kölö?” <verse number="41" style="v"/>Alima'e nzɔ bi kida mötu aba, kazi alëpïye mï kö'du yɔnzɔ. Di'di ra omba, ida ra kazi kyigɔ.</para>
  <para style="p">
    <verse number="42" style="v"/>Yësu ënyï ï'bë kpa löhu mï da rïyö a mötu, iya henye, “'Bu ma, ëzë köfö 'ba riti nenye oba dë, ma ki'ja riti mï da kö'du komba 'bëyï.” <verse number="43" style="v"/>Mo a'ba i'ja vo lö'bö ne'e, kpa löhu ako'do, zë ɔ'bɔnnï dë zi lima na ngö. <verse number="44" style="v"/>Yësu ënyï ila zë löhu ï'bë 'de amötu ma da wota mo iya kpa kö'du kölö ne. <verse number="45" style="v"/>Mo a'ba zi vo lö'bö'e iya henye, “Ëdïye gba a ko'do re 'e alawo? Ongɔ'e te, kadra 'ba zi Wisi a Vïdï kï'dï, zi vïdï kyënyë'e ɔkɔ ku. <verse number="46" style="v"/>Ënyï dï'bë'e. Ongɔ'e te, kora mati asusu ma ne ëdï nenye.”</para>
  <para style="s">Kïrï 'ba Yësu</para>
  <para style="r">(Mk. 14:43-50, Lk. 22:47-53; Yn. 18:3-12)</para>
  <para style="p">
    <verse number="47" style="v"/>Mati Yësu ëdï gba ame'do, Yudasi mo kölö tëmï vo lö'bö 'butë dɔmorïyö ne'e, ɔkɔ gbɔ. Mo aba vïdï kayo ëdïnnï kulu, mɔvɔ aba kala nnï, kyedre 'ba vo karasa vïdï kyedre ëtï ra utunnï zë. <verse number="48" style="v"/>Yudasi o'dɔ dakyïnë kö'du maako zi vïdï kayo ne'e zi yɔlɔ, iya henye, “Kora mati munzu hɔ mo ne, mo ra omba'e, ïrïye mo.” <verse number="49" style="v"/>Yudasi ï'bë mbïyï zi Yësu, iya henye, “Rakyëyï mëdï yï aba vo komoyandi,” unzu hɔ mo gbɔ.</para>
  <para style="p">
    <verse number="50" style="v"/>Yësu aya'ba dɔ mo iya henye, “Aboka ma, o'dɔ kö'du mati ayi gɔ mo kandi.” Zë ayinnï, ïrïnnï Yësu anda'bannï mo gbɔ gö. <verse number="51" style="v"/>Ma kölö tëmï vo lö'bö mati Yësu aba ne, otɔ kulu 'bënï tëmï sirikpa iga mbili vo lö'bö 'ba vo karasa, ikye yaga. <verse number="52" style="v"/>Yësu iya zi mo henye, “Aya'ba kulu 'bëyï ne hulëhu ga bi mo. Zë biya mati ïrïnnï kulu ne, akofo zë kulu aba. <verse number="53" style="v"/>Ayɔlɔ'e dë makako'jo 'Bu ma kö'du wa kɔnyi, kandi mo akutu kyɔ ta da malayika kpuluku'butë dɔmorïyö 'ba vo wehe? <verse number="54" style="v"/>Kö'du ne ako'dɔ rë nï zi tëdï kaa mati kö'du yöru iya mo'dɔ rë nï.”</para>
  <para style="p">
    <verse number="55" style="v"/>Yësu ënyï ame'do zi vïdï kayo ne'e, iya henye, “Ayiye kulu mɔvɔ aba kala'e, zi ma kïrï mo kaa ma vo kö'du kï'dï pere? 'Duwï ma lima akaŋo kö'du yandi mï yëkëlu, ïrïye ma dë. <verse number="56" style="v"/>Kö'du nenye biya o'dɔ rë nï zi wa mati nëbïye ayörunnï, mï kö'du yöru zi tayi tïnyö.” Vo lö'bö biya ilannï mo ahowënnï.</para>
  <para style="s">Yësu komo kyedre 'ba vurë'e</para>
  <para style="r">(Mk. 14:53-65; Lk. 22:54-55, 63-71; Yn. 18:13-14, 19-24)</para>
  <para style="p">
    <verse number="57" style="v"/>Zë mati ïrïnnï Yësu ne, obannï mo tï'bë mo aba liŋɔ 'ba Kayafa kyedre 'ba vo karasa, bi mati vo komoyandi 'ba vo kö'du kï'dïye nnï vïdï kyedre ëtï atoto rë nnï ga bi kölö. <verse number="58" style="v"/>Petero usu gɔ mo ta bi kɔwɔ le bi 'ba vurë, liŋɔ 'ba kyedre 'ba vo karasa. Mo ï'bë ödu bi 'ba vurë alima gbɔ akaŋo vo kanya ëtï, kongɔ wa a'di ako'dɔ zi Yësu.</para>
  <para style="p">
    <verse number="59" style="v"/>Vo da vo karasa 'e vïdï 'ba vurë'e kikye ëtï ayɔnzɔnnï zi mbërë kiga ra Yësu zi mo kofo, <verse number="60" style="v"/>zë i'jannï kö'du kyënyë maako dë, vïdï kayo ayinnï le ndɔndɔ kiga gumu. Ndundu mo aba vïdï kora rïyö ayinnï, <verse number="61" style="v"/>iyannï henye, kora nenye iya henye, “Ma kiha akaŋo yëkëlu 'ba Wïrï ne, yaa ko'do da wota aba ko'ba mo löhu.”</para>
  <para style="p">
    <verse number="62" style="v"/>Kyedre 'ba vo karasa ënyï rïyë iya zi Yësu henye, “Anza da kö'du ya'ba aba dë, ga kö'du wasusu rë yï ne?” <verse number="63" style="v"/>Yësu alima ti. Löhu kyedre 'ba vo karasa ame'do zi mo, iya henye, “Mï ru 'ba Wïrï dïdï yaanya aba mï'dï yï ku mï lömu, ayada zi ze ëzë yï Korisitɔ, Wisi 'ba Wïrï ra.” <verse number="64" style="v"/>Yësu aya'ba dɔ mo zi mo iya henye, “Mo ra kaa iya ne. Miya zi ye henye, tëmï kadra ma dagba ani, akongɔ'e Wisi a Vïdï ta bi lima da kala tïrï 'ba Wïrï kyigɔ tayi tëmï fɔli 'ba komorïyë.” <verse number="65" style="v"/>Mati kyedre 'ba vo karasa owo kö'du ne here, ënyï na kamo iza bɔngɔ 'bɔmo iya henye, “Ne kö'du sawiya ra. Domba kya kö'du 'ba vo hu kö'du dɔ rɔ dekpe. Owo'e kö'du sawiya ne ku. <verse number="66" style="v"/>Asösu'e a'di ra?” Zë aya'bannï dɔ mo iyannï henye, “Mo o'dɔ kö'du kyënyë ku, mofo mo.” <verse number="67" style="v"/>Zë o'binnï oro komo mo, u'bönnï mo, zë maako'e isannï mo, <verse number="68" style="v"/>iyannï henye, “Ayada zi ze Korisitɔ, ëzë yï nëbï ra, ayada ëyï ra isa yï.”</para>
  <para style="s">Ha kiga 'ba Petero ta ra Yësu</para>
  <para style="r">(Mk. 14:66-72; Lk. 22:56-62; Yn. 18:15-18, 25-27)</para>
  <para style="p">
    <verse number="69" style="v"/>Mati Petero ëdï lima yaga mï liŋɔ 'ba Kalafa, vo lö'bö kölö tëmï mbara 'ba kyedre 'ba vo karasa ayi zi mo iya henye, “Yï kpa Yësu aba tëmï Galilaya.” <verse number="70" style="v"/>Mo iga hë nï ta da komo vïdï kayo ne'e biya. Mo aya'ba dɔ mo iya henye, “Ma yɔlɔ kö'du ma ëdï ame'do gɔ mo ne dë, <verse number="71" style="v"/>ënyï asi wënï yaga ha loko bi 'ba vurë. Mbara vo lö'bö agamo ongɔ mo iya zi vïdïye henye, mo Yësu 'ba Nazereta aba.” <verse number="72" style="v"/>Löhu Petero iga hë nï aya'ba dɔ mo iya henye, “Malömu tïnyö mayɔlɔ kora ne dë.” <verse number="73" style="v"/>Tisi yaa ta gɔ mo vïdï kora mati ëdïnnï tɔrɔ ani ne, ayinnï zi Petero iyannï henye, “Yï ma kölö tëmï zë, dayɔlɔ ze tëmï gërï me'do 'bëyï.” <verse number="74" style="v"/>Petero iya henye, “Ma lömu kö'du tïnyö ra mëdï ayada, ëzë anza dë here, Wïrï mï'dï riti zi ma. Ma yɔlɔ kora ne dë.” Zanga ënyï ayapa, <verse number="75" style="v"/>Petero asösu kö'du ma Yësu ayada zi nï iya henye, “Gba kazi yapa 'ba zanga, akiya da wota henye ere, ayɔlɔ ma dë.” Mo ënyï asi gbɔ yaga akudu na kyënyë.</para>
  <chapter number="27" style="c"/>
  <para style="s">Oba Yësu komo Pilato</para>
  <para style="r">(Mk. 15:1; Lk. 23:1-2; Yn. 18:28-32)</para>
  <para style="p">
    <verse number="1" style="v"/>Kyere 'do da mïndö aba ŋbɔ, kyedre 'ba vo karasa'e nnï vïdï kyedre ëtï ï'dï kö'du 'bënnï ombannï ku zi Yësu kofo. <verse number="2" style="v"/>Zë idannï mo nyɔri aba ikannï mo, ï'dïnnï mo zi Pilato, vo daliŋɔ mï turu 'ba Roma.</para>
  <para style="s">Koli 'ba Yudasi lɔɔ 'ba vo lö'bö'e</para>
  <para style="p">
    <verse number="3" style="v"/>Mati Yudasi vo wasusu ayɔlɔ ombannï ku zi Yësu kofo, mo ayasi kö'du lïtë 'bënï ne, ënyï oba kɔhi ŋbiriṛi 'butëwota ne kika mo hulëhu zi kyedre 'ba vo karasa vïdï kyedre ëtï. <verse number="4" style="v"/>Yudasi iya zi zë henye, “Mo'dɔ kö'du kyënyë ku zi ma kora vo kazi kö'du kyënyë ko'dɔ ne kï'dï zi ye zi kofo.” Zë aya'bannï dɔ mo zi mo iyannï henye, “Anza kö'du 'beze ra dë, kö'du 'bëyï ra.” <verse number="5" style="v"/>Mati Yudasi owo kö'du ne here, odrɔ kɔhi ne komo zë ani mï yëkëlu, mo ënyï asi ï'bë ove gu nï gbɔ.</para>
  <para style="p">
    <verse number="6" style="v"/>Kyedre 'ba vo karasa aködu kɔhi ne iya henye, “Nenye kɔhi yama ra, mï kö'du kï'dï 'beze anza dekpe zi kï'dï mï kutë 'ba wa sesi mï loko 'ba Wïrï.” <verse number="7" style="v"/>Mati ombannï dɔ mo ku, ogonnï yaka gbɔ kɔhi ne aba na bi 'ba zi yöku tu'dë maako'e kusu. <verse number="8" style="v"/>Kö'du nere ra, yaka ne ako'jo na yaka 'ba yama le ndenye. <verse number="9" style="v"/>Kö'du mati nëbï Yeremaya iya ne, ayi ku tïnyö. “Zë obannï kɔhi ŋbiriṛi 'butëwota, mati vïdï 'ba Yiserele ombannï dɔ mo zi kopi ga kö'du mo, <verse number="10" style="v"/>Kɔhi mo ne zi yaka kogo mo aba kaa mati Yere ï'dï kö'du mo zi ma.”</para>
  <para style="s">Pilato ako'jo ha Yësu</para>
  <para style="r">(Mk. 15:2-5; Lk. 23:3-5; Yn. 18:33-38)</para>
  <para style="p">
    <verse number="11" style="v"/>Yësu ɔrɔ komo vo daliŋɔ 'ba Roma, ako'jo hɔ mo iya henye, “Yï ra Yere vo damöku 'ba Yuda'e?” Yësu aya'ba dɔ mo iya henye, “Mo ra kaa iya ne.” <verse number="12" style="v"/>Mo ame'do dë na da kö'du ya'ba 'ba vo wa sösu'e, mati kyedre 'ba vo karasa'e nnï vïdï kyedre nani ëtï. <verse number="13" style="v"/>Pilato iya zi mo henye, “Owo kö'du mati asusunnï yï gɔ mo nenye dë?” <verse number="14" style="v"/>Mati Yësu omba dë zi da kö'du ma kölö ya'ba ne, o'dɔ Pilato gbɔ na rakaga.</para>
  <para style="s">Ikye vurë ra Yësu zi kofo</para>
  <para style="r">(Mk. 15:6-15; Lk. 23:13-25; Yn. 18:39-19:16)</para>
  <para style="p">
    <verse number="15" style="v"/>Mï kadra 'ba karama 'ba laga 'ba koli aba, vo daliŋɔ 'ba Roma ëdï kö'du aba zi kinga yaga vïdï mati vïdïye ako'jonnï kö'du mo tëmï kamba. <verse number="16" style="v"/>Mï kadra nani, kora maako ëdï mï kamba ru mo Barabasi, mo na yɔlɔ ga kö'du ko'dɔ kyënyë. <verse number="17" style="v"/>Mati vïdï kayo ne atoto rë nnï, Pilato ako'jo hë zë iya henye, “Ma vala ra omba'e zi ma kinga zi ye? Barabasi, kɔdɔ Yësu mati ako'jo Korisitɔ?” <verse number="18" style="v"/>Mo ayɔlɔ na laka, vo kalakonda 'ba Yuda'e ï'dïnnï Yësu zi nï ga kö'du zë na mï kumbë.</para>
  <para style="p">
    <verse number="19" style="v"/>Mati Pilato ëdï gba alima mï loko 'ba vurë, mbara 'bɔmo utu kö'du kise zi mo iya henye. “O'dɔ kö'du ako dë zi kora vo kazi kö'du yaŋa ne, wïrï ayaza ma mï yɔndɔ ne aba ga kö'du mo.” <verse number="20" style="v"/>Kyedre 'ba vo karasa nnï vïdï kyedre ëtï alëlunnï da vïdï kayo ne'e zi ha Pilato ko'jo zi Barabasi kinga, Yësu zi kofo. <verse number="21" style="v"/>Pilato ako'jo ha vïdï kayo ne'e, iya henye, “Ma vala ra tëmï vïdï rïyö nenye'e, omba'e ma zi kinga zi ye?” Zë aya'bannï dɔ mo iyannï henye “Barabasi.” <verse number="22" style="v"/>Pilato ako'jo hë zë iya henye, “Mo'dɔ a'di zi Yësu mati ako'jo Korisitɔ ne?” Zë biya aya'bannï dɔ mo iyannï henye, “Matötö mo.” <verse number="23" style="v"/>Pilato ako'jo hë zë iya henye, “Kö'du kyënyë a'di mo o'dɔ?” Ayetonnï hë nnï gbögbö gu kyembe aba, “Matötö mo.”</para>
  <para style="p">
    <verse number="24" style="v"/>Mati Pilato ongɔ kö'du ma zi nï ko'dɔ anza kpe, kazi vïdï ne ënyïnnï na kamo, mo oba wini akaka kala nï ta da komo vïdï kayo ne'e, iya henye, “Manza dë mï koli 'ba kora nenye. Ne kö'du ko'dɔ 'be'e ra.” <verse number="25" style="v"/>Vïdï kayo ne'e biya aya'bannï dɔ mo, iyannï henye, “Yama koli 'bɔmo malëpï gbɔ de ze gisi 'beze ëtï.” <verse number="26" style="v"/>Pilato inga Barabasi zi zë, ta pëtï mo, u'bö hu Yësu, ï'dï mo gbɔ zi tötö.</para>
  <para style="s">Vo wehe o'dɔnnï sawiya ra Yësu</para>
  <para style="r">(Mk. 15:16-20; Yn. 19:2-3)</para>
  <para style="p">
    <verse number="27" style="v"/>Here vo kanya a Pilato obannï Yësu tï'bënnï mo mï loko 'ba vo kanya'e. Vo kanya kayo atoto rë nnï kpo ta da kapa mo. <verse number="28" style="v"/>Zë otɔnnï bɔngɔ 'bɔmo usunnï bɔngɔ konda 'ba yere rɔ mo. <verse number="29" style="v"/>Here zë o'dɔnnï safo tëmï kono ayöfunnï dɔ mo. Ï'dïnnï mɔvɔ 'ba yere kala mo ma tïrï alɔdrɔnnï da womo nnï aba komo mo sawiya ko'dɔ rɔ mo, zë iyannï henye, “Lima konda zi yï vo damöku 'ba Yuda'e.” <verse number="30" style="v"/>Zë o'binnï oro komo mo, obannï mɔvɔ u'bönnï dɔ mo. <verse number="31" style="v"/>Mati zë indennï sawiya ko'dɔ ku rɔ mo, zë otɔnnï bɔngɔ konda ne 'de ta rɔ mo, usunnï bɔngɔ ɔmo gbï löhu rɔ mo. Here zë obannï mo gbɔ kika mo yaga zi tötö mo.</para>
  <para style="s">Atötö Yësu</para>
  <para style="r">(Mk. 15:21-32; Lk. 23:26-43; Yn. 19:17-27)</para>
  <para style="p">
    <verse number="32" style="v"/>Mati zë ëdï tï'bënnï yaga, zë andɔsi dë nnï kora maako aba tëmï Sirënë ru mo Simona, vo kanya'e o'dɔnnï mo na kamo zi taka a Yësu kïnjë. <verse number="33" style="v"/>Zë ayinnï bi mati ako'jo Gologota ne, mï kö'du ya'ba aba “Bi 'ba Kiṛiyingɔ da.” <verse number="34" style="v"/>Ani zë ï'dïnnï a'ji zi Yësu na susë wa kata aba kuwë, mati anene ta pëtï mo, mo omba dekpe kuwë. <verse number="35" style="v"/>Mati zë atötönnï mo ku, zë ayanyannï bɔngɔ 'bɔmo tëmï kutë nnï födö ku'du aba zi yɔlɔ akalëpï zi ëyï. <verse number="36" style="v"/>Tapëtï mo, alimannï ani mo kongɔ.</para>
  <para style="p">
    <verse number="37" style="v"/>Dɔ mo rïyë ï'dïnnï wayöru 'ba wasusu iya henye, “Nenye Yësu, yere 'ba Yuda'e” <verse number="38" style="v"/>Zë atötönnï vo logo rïyö dakapa Yësu, ma kölö da kala mo ma tïrï ma agamo da kala mo ma gali. <verse number="39" style="v"/>Vïdï mati ëdï lagannï ta da kapa ne, dë nnï njili Yësu lidi aba, iyannï henye, <verse number="40" style="v"/>“Here omba tï'bë yëkëlu ne kiha mo akaŋo, kuvö mo löhu mï ko'do da wota aba. Ayɔmɔ rë yï ëzë yï Wisi 'ba Wïrï. Asi akaŋo ta da taka.”</para>
  <para style="p">
    <verse number="41" style="v"/>Tëmï gërï kölö ne, kyedre 'ba vo karasa vo komoyandi 'ba vo kö'du kï'dï nnï vïdï kyedre ëtï alimannï sawiya ko'dɔ ra Yësu iyannï henye, <verse number="42" style="v"/>“Mo ayɔmɔ oka'e, ayɔmɔ rë nï dë. Anza mo ra dë yere 'ba Yiserele? Ëzë mo ayi ku akaŋo ta da taka yaanya aba dakoma 'da mï mo. <verse number="43" style="v"/>Mo oma mï Wïrï, iya henye, ‘Nï Wisi 'ba Wïrï ra.’ Laka dongɔ'e te, ëzë Wïrï omba zi mo yɔmɔ yaanya aba.” <verse number="44" style="v"/>Vo logo mati atötö zë da kapa Yësu ne, alidi mo kpa here.</para>
  <para style="s">Koli 'ba Yësu</para>
  <para style="r">(Mk. 15:33-41; Lk. 23:44-49; Yn. 19:28-30)</para>
  <para style="p">
    <verse number="45" style="v"/>Mï kutë kadra aba mandölu ayöfu dakaŋo ne biya, inde rë nï le ta pëtï kadra wota aba. <verse number="46" style="v"/>Gba kaa kadra wota aba, Yësu ënyï udu gu kyembe aba iya henye, “Elöyï Elöyï lema sabakatani?” Mï kö'du ya'ba aba iya henye, “Wïrï ama, Wïrï ama, ila ma ga a'di ya?” <verse number="47" style="v"/>Kya vïdï ma ëdï tɔrɔnnï ani ne, iyannï henye, “Mo ëdï Eliya ko'jo.”</para>
  <para style="p">
    <verse number="48" style="v"/>Vïdï ma kölö tëmï zë aho kandi oba lifa usu mï a'ji ï'dï da njili mɔvɔ, mo yɔnzɔ zi kuwë. <verse number="49" style="v"/>Kyamo'e iyannï henye, “Ɔrɔ dongɔ'e te, ëzë Eliya ëdï tayi zi mo yɔmɔ.” <verse number="50" style="v"/>Yësu api rïyë löhu na kyembe ila lawo gbɔ.</para>
  <para style="p">
    <verse number="51" style="v"/>Bɔngɔ mati ove mï yëkëlu 'ba Wïrï ne mï mo aliza rïyö kɔ ta rïyë le akaŋo. Dakaŋo akɔhɔ rë nï, lutu alihannï, <verse number="52" style="v"/>da wogo ayëhu rë nnï biya, vïdï kayo a Wïrï mati olinnï ne, ënyïnnï gbɔ na dïdï tëmï koli. <verse number="53" style="v"/>Zë ilannï da wogo, ta pëtï tënyï 'ba Yësu tëmï koli, ënyï ï'bënnï mï gawo laka ani vïdï kayo ongɔnnï zë.</para>
  <para style="p">
    <verse number="54" style="v"/>Mati vo kyëlu 'ba vo kanya'e mati nnï mo aba, ëdïnnï ga Yësu kongɔ ne, ongɔnnï kinzikinzi biya wasisi mati o'dɔ rë nï ne, zë na tere iyannï henye, “Mo tïnyö Wisi 'ba Wïrï ra.” <verse number="55" style="v"/>Mbara kayo mati ëdïnnï Yësu kɔnyi, usunnï gɔ mo ta Galilaya ne, ëdïnnï atɔrɔ ani bi kongɔ ta bi kɔwɔ. <verse number="56" style="v"/>Mï kutë zë Mariya Magadala, Mariya ma 'ba Yemisi nnï Yosepa aba, mbara 'ba Zebedeyo.</para>
  <para style="s">Kusu 'ba Yësu</para>
  <para style="r">(Mk. 15:42-47; Lk. 23:50-56; Yn. 19:38-42)</para>
  <para style="p">
    <verse number="57" style="v"/>Mati ëdï ku na hutaga, kora vo wa dakayo maako tëmï Arimataya, ru mo Yosepa ɔkɔ gbɔ, mo kpa vo lö'bö 'ba Yësu ra. <verse number="58" style="v"/>Mo ënyï ï'bë ako'jo ha Pilato kö'du yöku Yësu. Pilato ï'dï kö'du gbɔ kala konda aba zi yöku ne kï'dï zi Yosepa. <verse number="59" style="v"/>Yosepa olo mï bɔngɔ ma kyïyï, <verse number="60" style="v"/>usu mï wogo ënï mati mo ole mï ṛï'dï, kyigɔ ne. Mo alulu yïtö kyedre ha wogo ne, isi ï'bë wënï gbɔ. <verse number="61" style="v"/>Mariya Magadala nnï Mariya ma agamo ne aba, ëdï limannï ani bi kongɔ zɔ da wogo.</para>
  <para style="s">Vo kanya 'ba ga da wogo kongɔ'e</para>
  <para style="p">
    <verse number="62" style="v"/>Mï ko'do 'ba ralawo aba, kyedre 'ba vo karasannï Farasi ëtï andɔsi dë nnï Pilato aba <verse number="63" style="v"/>iyannï henye, “Kyedre dasösu ze, mati vo ndɔndɔ kyedre ne ëdï gba na wïdï, mo iya henye, ‘Matënyï tëmï koli ko'do da wota aba.’ <verse number="64" style="v"/>Ï'dï kö'du zi ga wogo 'bɔmo ne kongɔ na laka le mï ko'do 'ba da wota ne, kazi vo lö'bö 'bɔmo ï'bë alogonnï yöku mo, akayadannï zi vïdï henye, ere, mo ënyï ku tëmï koli. Ndundu ndɔndɔ ma nenye atëdï ndra na kyënyë ta da ma dagba.”</para>
  <para style="p">
    <verse number="65" style="v"/>Pilato ayada zi zë iya henye, “Oba'e vo kanya'e zi tï'bënnï ga wogo ne kongɔ tëmï gërï ma laka.” <verse number="66" style="v"/>Zë ï'bënnï da wogo a'ba'bannï ga yïtö ha wogo ne zi yada vïdï maako ayëhu dë. Ilannï vo kanya ani zi gɔ mo kongɔ.</para>
  <chapter number="28" style="c"/>
  <para style="s">Tënyï tëmï koli</para>
  <para style="r">(Mk. 16:1-10; Lk. 24:1-12; Yn. 20:1-10)</para>
  <para style="p">
    <verse number="1" style="v"/>Ta pëtï ko'do 'ba ralawo aba, mï kano bi kezi da mïndö ko'do 'ba ralawo aba, Mariya Magadala nnï Mariya vere aba ënyï ï'bënnï bi kongɔ da wogo. <verse number="2" style="v"/>Kandi mï kadra nani kinzikinzi kyigɔ akɔhɔ bi. Malayika 'ba Yere ayi akaŋo ta komorïyë, alulu yïtö ne 'de ta ha wogo alima gbɔ dɔ mo. <verse number="3" style="v"/>Kyïnë mo na laka kaa bikanyi, bɔngɔ rɔ mo na kanyi kaa ṛï'dï 'ba mïrë. <verse number="4" style="v"/>Vo kanya ma ëdïnnï ga wogo ne kongɔ ne, zë na tere tese aba, mora a'bannï kaa vïdï mati olinnï ku.</para>
  <para style="p">
    <verse number="5" style="v"/>Malayika ame'do zi mbara ne'e, mo iya henye, “Ere'e dë, mayɔlɔ ku ëdïye bi koma kö'du Yësu ma atötö ne. <verse number="6" style="v"/>Mo anza dë kinye, mo ënyï ku, kaa mati mo iya. Ayiye kinye, ongɔ'e bi mati o'bannï mo zi mo. <verse number="7" style="v"/>Ï'bë'e kandi yaanya aba, ayada'e zi vo lö'bö 'bɔmo'e ‘Mo ënyï ku tëmï koli. Yaanya aba mo ëdï ku tï'bë mï Galilaya dagba komo'e, ani aki'ja'e mo. Yaanya aba mayada ku zi ye.’”</para>
  <para style="p">
    <verse number="8" style="v"/>Kandi ilannï da wogo tere aba, kpa na rakyenyi, ahonnï yada mo zi vo lö'bö 'bɔmo'e. <verse number="9" style="v"/>Kandi Yësu i'ja zë iya zi zë henye, “Rakyëyï mëdï ëtï.” Zë ayinnï zi mo ïrïnnï mo ta ndï mo amötunnï mo gbɔ. <verse number="10" style="v"/>Yësu iya zi zë henye, “Ere'e dë, ï'bë ayada'e zi öndu ma'e zi tï'bënnï mï Galilaya aki'jannï ma ani.”</para>
  <para style="s">Kö'du yëtï 'ba vo kanya'e</para>
  <para style="p">
    <verse number="11" style="v"/>Mati mbara ne ï'bënnï zi kö'du ne yada mo zi vo lö'bö 'bɔmo'e, kya 'ba vo kanya mati ëdïnnï ga wogo ne kongɔ ne, ënyï ï'bënnï hulëhu mï gawo ayadannï kö'du mati o'dɔ rë nï ne, biya zi kyedre 'ba karasa'e. <verse number="12" style="v"/>Kyedre 'ba vo karasa'e adrɔko rë nnï vïdï kyedre ëtï, zë o'dɔnnï yeṛe 'bënnï ï'dïnnï kɔhi kyedre zi vo kanya ne'e. <verse number="13" style="v"/>Mora iyannï henye, “Iya'e henye, ‘Vo lö'bö 'bɔmo ayinnï yɔndɔ aba alogonnï yöku mo mati ëdïye ako'do.’ <verse number="14" style="v"/>Ëzë vo daliŋɔ owo kö'du ne, dakalëlu ze dɔ mo dakiya henye, mo mï'dï riti dë zi ye.” <verse number="15" style="v"/>Vo kanya ne'e obannï kɔhi ne, o'dɔnnï te kaa kö'du mati ayada zi zë zi ko'dɔ mo ne. Mora here, kö'du ne apere rë nï biya mï kutë Yuda'e ko'do ndenye aba ne.</para>
  <para style="s">Yësu ayada rë nï zi vo lö'bö 'bënïye</para>
  <para style="r">(Mk. 16:14-18; Lk. 24:36-49; Yn. 20:19-23; Lɔɔ 1:6-8)</para>
  <para style="p">
    <verse number="16" style="v"/>Vo lö'bö 'butë dɔmokölö ne ënyï ï'bënnï da lutu mï Galilaya bi mati Yësu ayada zi zë, zi tï'bënnï dɔ mo. <verse number="17" style="v"/>Mati zë ongɔnnï mo, zë ayetonnï mo. Mora here, kya 'ba vo lö'bö maako'e omannï dë. <verse number="18" style="v"/>Yësu ehe kara, mora iya zi zë henye, “Kalakonda biya 'ba komorïyë dakaŋo aba, ï'dï ku zi ma. <verse number="19" style="v"/>Ï'bë'e zi vïdï biya ta bi ne o'dɔ'e zë na vo lö'bö ama. Abapatisiye zë mï ru 'ba 'Bu, Wisi, Lawo Kölö Laka aba, <verse number="20" style="v"/>ayandiye zë zi koronnï kö'du kï'dï mati mï'dï zi ye ne biya. Matëdï 'e ëtï 'duwï le mï ndundu 'ba daliŋɔ aba.”</para>
</usx>
