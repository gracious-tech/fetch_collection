<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id" />
  <para style="h">ЛІКІ</para>
  <para style="toc2">ЛІКІ</para>
  <para style="toc1">КНІГА ЛІКІ</para>
  <para style="mt1">КНІГА ЛІКІ</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="cl">Лікі 1</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 1:1" /> І прамовіў ГОСПАД да Майсея ў пустыні Сынай у Намёце Спатканьня ў першы дзень другога месяца, у другім годзе па выхадзе з Эгіпту, кажучы:<verse eid="NUM 1:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 1:2" /> «Зрабі сьпіс усяе грамады cыноў Ізраіля па родах іхніх, па сем’ях іхніх, усіх мужчынаў па імёнах.<verse eid="NUM 1:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 1:3" /> Ад дваццаці гадоў і вышэй, усіх здатных да бою Ізраільцянаў палічыце па дружынах іхніх ты і Аарон.<verse eid="NUM 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 1:4" /> З кожнага пакаленьня павінен быць з вамі чалавек, князь роду бацькоў сваіх.<verse eid="NUM 1:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 1:5" /> Вось імёны правадыроў пакаленьняў, якія будуць з вамі: для Рубэна — Эліцур, сын Шэдэура,<verse eid="NUM 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 1:6" /> для Сымона — Шэлюмiэль, сын Цурышадая,<verse eid="NUM 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 1:7" /> для Юды — Нахшон, сын Амінадава,<verse eid="NUM 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 1:8" /> для Ісахара — Натанаэль, сын Цуара,<verse eid="NUM 1:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 1:9" /> для Завулёна — Эліяў, сын Гэлёна,<verse eid="NUM 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 1:10" /> для сыноў Язэпа: для Эфраіма — Элішама, сын Амігуда; для Манасы — Гамаліэль, сын Пэдагсура;<verse eid="NUM 1:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 1:11" /> для Бэн’яміна — Абідан, сын Гідэоні,<verse eid="NUM 1:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 1:12" /> для Дана — Ахіезэр, сын Амішадая,<verse eid="NUM 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 1:13" /> для Асэра — Пагіэль, сын Акрана,<verse eid="NUM 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 1:14" /> для Гада — Эліясаф, сын Дэўэля,<verse eid="NUM 1:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 1:15" /> для Нэфталі — Ахіра, сын Энана».<verse eid="NUM 1:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 1:16" /> Гэтыя пакліканыя з усёй супольнасьці, князі пакаленьняў бацькоў сваіх і начальнікі тысячаў Ізраіля.<verse eid="NUM 1:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 1:17" /> Іх узяў Майсей і Аарон, тых, што былі паіменна названыя.<verse eid="NUM 1:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 1:18" /> У першы дзень другога месяца сабралі яны ўсю супольнасьць дзеля сьпісу іх паходжаньня па пакаленьнях іхніх, па сем’ях бацькоў іхніх і лічылі кожнага па імені ад дваццаці гадоў і вышэй.<verse eid="NUM 1:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 1:19" /> Як загадаў ГОСПАД Майсею, быў зроблены перапіс у пустыні Сынай.<verse eid="NUM 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 1:20" /> Сыноў Рубэна, першароднага Ізраеля, па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў усіх мужчынаў ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 1:21" /> тых, якіх палічылі з пакаленьня Рубэна, было сорак шэсьць тысячаў пяцьсот.<verse eid="NUM 1:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 1:22" /> Сыноў Сымона па пакаленьнях іхніх, па племёнах іхніх і па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў, ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 1:23" /> налічана з пакаленьня Сымонавага пяцьдзесят дзевяць тысячаў трыста.<verse eid="NUM 1:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 1:24" /> Сыноў Гада па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 1:25" /> налічана з пакаленьня Гадавага сорак пяць тысячаў шэсьцьсот пяцьдзясят.<verse eid="NUM 1:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 1:26" /> Сыноў Юды па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 1:27" /> налічана з пакаленьня Юды семдзесят чатыры тысячы шэсьцьсот.<verse eid="NUM 1:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 1:28" /> Сыноў Ісахара па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 1:29" /> налічана з пакаленьня Ісахара пяцьдзясят чатыры тысячы чатырыста.<verse eid="NUM 1:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 1:30" /> Сыноў Завулёна па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 1:31" /> налічана з пакаленьня Завулёна пяцьдзесят сем тысячаў чатырыста.<verse eid="NUM 1:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 1:32" /> Сыноў Язэпа, сыноў Эфраіма па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 1:33" /> налічана з пакаленьня Эфраіма сорак тысячаў пяцьсот.<verse eid="NUM 1:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 1:34" /> Сыноў Манасы па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, усіх здольных да бою,<verse eid="NUM 1:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 1:35" /> налічана з пакаленьня Манасы трыццаць дзьве тысячы дзьвесьце.<verse eid="NUM 1:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 1:36" /> Сыноў Бэн’яміна па пакаленьнях іхніх, па пямёнах іхніх, па сем’х іхніх, па ліку імёнаў, мужчынаў ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 1:37" /> налічана з пакаленьня Бэн’яміна трыццаць пяць тысячаў чатырыста.<verse eid="NUM 1:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 1:38" /> Сыноў Дана па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 1:39" /> налічана з пакаленьня Дана шэсьцьдзесят дзьве тысячы семсот.<verse eid="NUM 1:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 1:40" /> Сыноў Асэра па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 1:41" /> налічана з пакаленьня Асэра сорак адна тысяча пяцьсот.<verse eid="NUM 1:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 1:42" /> Сыноў Нэфталі па пакаленьнях іхніх, па плямёнах іхніх, па сем’ях іхніх, па ліку імёнаў, усіх мужчынаў ад дваццаці гадоў і вышэй, здольных да бою,<verse eid="NUM 1:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 1:43" /> налічана з пакаленьня Нэфталі пяцьдзясят тры тысячы чатырыста.<verse eid="NUM 1:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 1:44" /> Гэта вось тыя, якіх палічылі Майсей і Аарон разам з начальнікамі Ізраіля, дванаццацю князямі, па аднаму з кожнага пакаленьня.<verse eid="NUM 1:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 1:45" /> Поўны лік сыноў Ізраіля, здольных да бою, па сем’ях іхніх, ад дваццаці гадоў і вышэй,<verse eid="NUM 1:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 1:46" /> складаў шэсьцьсот тры тысячы пяцьсот пяцьдзясят.<verse eid="NUM 1:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 1:47" /> Лявіты не падпалі пад сьпіс паводле пакаленьняў сваіх,<verse eid="NUM 1:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 1:48" /> бо ГОСПАД сказаў Майсею:<verse eid="NUM 1:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 1:49" /> «Не перапісвай пакаленьня Левія і не лічы іх разам з сынамі Ізраіля,<verse eid="NUM 1:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 1:50" /> але даручы лявітам Сялібу Сьведчаньня, усе яе прылады і ўсё, што да яе належыць. Яны будуць насіць Сялібу і ўсе яе прыналежнасьці, будуць пры ёй служыць і навокал яе паставяць намёты свае.<verse eid="NUM 1:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 1:51" /> Калі трэба рушыць у дарогу, разьбяруць яе лявіты, а калі трэба затрымацца, зноў яе паставяць. Калі хто чужы наблізіцца да яе, будзе пакараны сьмерцю.<verse eid="NUM 1:51" /></para>
  <para style="m">
    <verse number="52" style="v" pubnumber="52." sid="NUM 1:52" /> Сыны Ізраіля паставяць намёты свае, кожны на месцы сваім у табары, кожны пад сьцягам сваім, пры дружынах сваіх.<verse eid="NUM 1:52" /></para>
  <para style="m">
    <verse number="53" style="v" pubnumber="53." sid="NUM 1:53" /> А лявіты разьмесьцяцца табарам вакол Сялібы Сьведчаньня; тады кара не спадзе на грамаду сыноў Ізраіля. Лявіты будуць сьцерагчы Сялібу Сьведчаньня».<verse eid="NUM 1:53" /></para>
  <para style="m">
    <verse number="54" style="v" pubnumber="54." sid="NUM 1:54" /> Сыны Ізраіля споўнілі і зрабілі ўсё, што ГОСПАД загадаў Майсею.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="cl">Лікі 2</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 2:1" /> І сказаў ГОСПАД Майсею і Аарону:<verse eid="NUM 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 2:2" /> «Няхай сыны Ізраіля паставяць намёты, кожны пад сьцягам сваім, пад знакамі бацькоў сваіх, навокал Намёту Спатканьня на адлегласьці.<verse eid="NUM 2:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 2:3" /> З усходу паставіць Юда намёты адпаведна дружынаў войска свайго, а князем сыноў Юды будзе Нахшон, сын Амінадава.<verse eid="NUM 2:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 2:4" /> Лічба войска ягонага, паводле падліку, мае семдзесят чатыры тысячы шэсьцьсот.<verse eid="NUM 2:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 2:5" /> Побач іх разложыцца табар калена Ісахара, князем якога мае быць Натанаэль, сын Цуара.<verse eid="NUM 2:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 2:6" /> Лічба войска ягонага, паводле падліку, мае пяцьдзясят чатыры тысячы чатырыста.<verse eid="NUM 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 2:7" /> Потым пакаленьне Завулёна, а князем сыноў Завулёна будзе Эліяў, сын Гэлёна.<verse eid="NUM 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 2:8" /> Лічба войска ягонага, паводле падліку, мае пяцьдзясят сем тысячаў чатырыста.<verse eid="NUM 2:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 2:9" /> Усіх, палічаных у табары Юды па дружынах іхніх, сто восемдзесят шэсьць тысячаў чатырыста. Яны першыя будуць выходзіць.<verse eid="NUM 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 2:10" /> Ад паўднёвага боку будзе сьцяг табару Рубэна з войскам ягоным, а князем у яго будзе Эліцур, сын Шэдэура.<verse eid="NUM 2:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 2:11" /> Лічба войска ягонага, паводле падліку, мае сорак шэсьць тысячаў пяцьсот.<verse eid="NUM 2:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 2:12" /> Побач іх разложыцца табар пакаленьня Сымона, а князем сыноў Сымона будзе Шэлюміэль, сын Цурышадая.<verse eid="NUM 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 2:13" /> Лічба войска ягонага, паводле падліку, мае пяцьдзясят дзевяць тысячаў трыста.<verse eid="NUM 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 2:14" /> Пасьля пакаленьне Гада. Князем пакаленьня Гада будзе Эліясаф, сын Дэўэля.<verse eid="NUM 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 2:15" /> Лічба войска ягонага, паводле падліку, мае сорак пяць тысячаў шэсьцьсот пяцьдзесят.<verse eid="NUM 2:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 2:16" /> Усіх, палічаных у табары Рубэна, — сто пяцьдзясят адна тысяча чатырыста пяцьдзясят. Яны другімі будуць выходзіць.<verse eid="NUM 2:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 2:17" /> Пасля вырушыць Намёт Спатканьня і табар лявітаў у сярэдзіне другіх табараў, паводле таго, як расстаўлялі намёты, так і выходзіць будуць, кожны на месцы сваім, пад сьцягам сваім.<verse eid="NUM 2:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 2:18" /> Ад захаду будзе сцьяг табару Эфраіма, разьмешчанага па дружынах сваіх. Князем сыноў Эфраіма будзе Элішама, сын Амігуда.<verse eid="NUM 2:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 2:19" /> Лічба войска ягонага, паводле падліку, мае сорак тысячаў пяцьсот.<verse eid="NUM 2:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 2:20" /> Побач іх пакаленьне Манасы; князем сыноў Манасы будзе Гамаліэль, сын Пэдагсура.<verse eid="NUM 2:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 2:21" /> Лічба войска ягонага, паводле падліку, мае трыццаць дзьве тысячы дзьвесьце.<verse eid="NUM 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 2:22" /> Наастатак пакаленьне Бэн’яміна; князем сыноў Бэн’яміна будзе Абідан, сын Гідэоні.<verse eid="NUM 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 2:23" /> Лічба войска ягонага, паводле падліку, мае трыццаць пяць тысячаў чатырыста.<verse eid="NUM 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 2:24" /> Усіх, палічаных у табары Эфраіма па дружынах іхніх, — сто восем тысячаў сто. Яны трэція будуць выходзіць.<verse eid="NUM 2:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 2:25" /> З поўначы, адпаведна дружынаў сваіх, будзе сьцяг табару Дана з войскам ягоным. Князем сыноў Дана будзе Ахіезэр, сын Амішадая.<verse eid="NUM 2:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 2:26" /> Лічба войска ягонага, паводле падліку, мае шэсьцьдзесят дзьве тысячы семсот.<verse eid="NUM 2:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 2:27" /> Побач іх разложыцца табарам пакаленьне Асэра. Князем сыноў Асэра будзе Пагіэль, сын Акрана.<verse eid="NUM 2:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 2:28" /> Лічба войска ягонага, паводле падліку, мае сорак адну тысячу пяцьсот.<verse eid="NUM 2:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 2:29" /> Наастатак пакаленьне Нэфталі. Князем сыноў Нэфталі будзе Ахіра, сын Энана.<verse eid="NUM 2:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 2:30" /> Лічба войска ягонага, паводле падліку, мае пяцьдзесят тры тысячы чатырыста.<verse eid="NUM 2:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 2:31" /> Усіх, палічаных у табары Дана, — сто пяцьдзясят сем тысячаў шэсьцьсот. Яны як апошнія будуць выходзіць пад сьцягамі сваімі.<verse eid="NUM 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 2:32" /> Гэта вось лічба сыноў Ізраіля, сьпісаных па сем’ях сваіх з войскам сваім, — шэсьцьсот тры тысячы пяцьсот пяцьдзясят.<verse eid="NUM 2:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 2:33" /> Як загадаў ГОСПАД Майсею, лявіты не былі перапісаны разам з сынамі Ізраіля.<verse eid="NUM 2:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 2:34" /> Сыны Ізраіля споўнілі ўсё, што загадаў ГОСПАД: раскладаліся табарам пад сьцягамі сваімі і выходзілі паводле пакаленьняў і сем’яў бацькоў сваіх.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="cl">Лікі 3</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 3:1" /> Вось такі радавод Аарона і Майсея, калі прамаўляў ГОСПАД да Майсея на гары Сынай.<verse eid="NUM 3:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 3:2" /> Вось гэтыя імёны сыноў Аарона: перашародны Надаў, потым Абігу, і Элеазар, і Ітамар.<verse eid="NUM 3:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 3:3" /> Вось гэта імёны сыноў Аарона, памазаных сьвятароў, пасьвячаных, каб спаўнялі службу сьвятарскую.<verse eid="NUM 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 3:4" /> Але Надаў і Абігу памерлі перад абліччам ГОСПАДА ў пустыні Сынай, калі хацелі скласьці ў ахвяру чужы агонь, ды памерлі яны бязьдзетныя, дык спаўнялі службу сьвятарскую перад абліччам бацькі свайго, Аарона, Элеазар і Ітамар.<verse eid="NUM 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 3:5" /> Прамовіў зноў ГОСПАД да Майсея, кажучы:<verse eid="NUM 3:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 3:6" /> «Прывядзі пакаленьне Левія і пастаў яго перад абліччам Аарона сьвятара, няхай яны паслугуюць яму.<verse eid="NUM 3:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 3:7" /> Няхай рупяцца пра ўсё, што належыцца яму ды ўсёй супольнасьці адносна Намёту Спатканьня, каб выконваць службу пры Сялібе,<verse eid="NUM 3:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 3:8" /> і няхай захоўваюць усе прыналежнасьці Намёту Спатканьня, спаўняючы абавязкі сыноў Ізраіля, каб выконваць службу пры Сялібе.<verse eid="NUM 3:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 3:9" /> Аддай лявітаў Аарону і сынам ягоным, няхай яны будуць дадзеныя яму з сыноў Ізраіля.<verse eid="NUM 3:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 3:10" /> А Аарона і сыноў ягоных пастаў наглядчыкамі над службаю сьвятарскай. Калі б хто чужы прыступіў да службы, мае быць пакараны сьмерцю».<verse eid="NUM 3:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 3:11" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 3:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 3:12" /> «Вось, Я выдзяліў лявітаў спасярод сыноў Ізраіля на месца ўсіх першародных, народжаных з улоньня маткі, таму леявіты будуць Маімі.<verse eid="NUM 3:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 3:13" /> Бо Мой кожны першародны. У той дзень, калі ў зямлі Эгіпецкай выбіў Я ўсё першароднае, пасьвяціў Я Сабе ўсё першароднае ў Ізраіля, пачынаючы ад чалавека аж да жывёлы. Яны ўсе — Мае! Я — ГОСПАД!»<verse eid="NUM 3:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 3:14" /> Гаварыў далей ГОСПАД Майсею на гары Сынай:<verse eid="NUM 3:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 3:15" /> «Палічы сыноў Левія па сем’ях іхніх і плямёнах іхніх, усіх мужчынскага роду ад аднаго месяца і вышэй».<verse eid="NUM 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 3:16" /> І палічыў іх Майсей, як загадаў яму ГОСПАД.<verse eid="NUM 3:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 3:17" /> І вось імёны сыноў Левія: Гершон, Кегат і Мэрары.<verse eid="NUM 3:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 3:18" /> А вось імёны сыноў Гершона па родах іхніх: Лібні і Шымэй.<verse eid="NUM 3:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 3:19" /> Сыны Кегата па родах іхніх: Амрам, Іцгар, Геброн і Узіэль.<verse eid="NUM 3:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 3:20" /> Сыны Мэрары па родах іхніх: Махлі і Мушы. Вось жа гэта роды Левія па сем’ях бацькоў іхніх.<verse eid="NUM 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 3:21" /> Ад Гершона паходзяць сям’я Лібні і сям’я Шымэя.<verse eid="NUM 3:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 3:22" /> Лічба сьпісаных мужчынаў ад аднаго месяца і вышэй — сем тысячаў пяцьсот.<verse eid="NUM 3:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 3:23" /> Яны будуць разьмяшчацца за Сялібай на захад.<verse eid="NUM 3:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 3:24" /> Галавой роду Гершона быў Эліясаф, сын Ляэля.<verse eid="NUM 3:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 3:25" /> Сынам Гершона ў Намёце Спатканьня была даручана сама Сяліба, Намёт і пакрыцьцё ягонае, а таксама заслона пры ўваходзе ў Намёт Спатканьня.<verse eid="NUM 3:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 3:26" /> Далей заслоны панадворку, а таксама заслона пры выхадзе на панадворак, які акружае Сялібу і ахвярнiк, а наастатак — вяроўкі, патрэбныя для службы.<verse eid="NUM 3:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 3:27" /> Ад Кэгата паходзяць сем’і: Амрама і Іцгара, Геброна і Узіэля. Гэта вось сем’і Кегата.<verse eid="NUM 3:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 3:28" /> Усіх мужчынаў ад аднаго месяца і вышэй — восем тысячаў шэсьцьсот; яны мелі апекавацца Сялібай.<verse eid="NUM 3:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 3:29" /> Сем’і Кегата раскладалі табар з паўднёвага боку Сялібы.<verse eid="NUM 3:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 3:30" /> Галавой роду Кегата быў Эліцафан, сын Узіэля.<verse eid="NUM 3:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 3:31" /> Мелі яны рупіцца пра каўчэг, стол, сьвечнік, ахвярнiкi, а таксама пра прылады Сялібы, прызначаныя на службу Божую, наастатак — пра заслону і абслугу яе.<verse eid="NUM 3:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 3:32" /> Начальнікам князёў сем’яў лявітаў быў Элеазар, сын Аарона сьвятара. Ён наглядаў за тымі, што спаўнялі службы ў сьвятыні.<verse eid="NUM 3:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 3:33" /> Ад Мэрары паходзяць сем’і Махлі і Мушы; гэта сем’і Мэрары.<verse eid="NUM 3:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 3:34" /> Поўны лік сьпісаных мужчынаў ад аднаго месяца і вышэй — шэсьць тысячаў дзьвесьце.<verse eid="NUM 3:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 3:35" /> Галавой сем’яў Мэрары быў Цурыэль, сын Абігаіля. Яны ставілі табар з паўночнага боку Сялібы.<verse eid="NUM 3:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 3:36" /> Сынам Мэрары даручаны былі дошкі Сялібы, іхнія папярочкі, слупкі разам з падставамі i ўсе рэчы, патрэбныя для ейнай абслугі,<verse eid="NUM 3:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 3:37" /> і слупкі панадворку з усіх бакоў, і іхнія падставы, і колцы іх з вяроўкамі.<verse eid="NUM 3:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 3:38" /> А з пярэдняга боку Сялібы, на ўсход перад Намётам Спатканьня стаўлялі палаткі Майсей, і Аарон, і сыны ягоныя, якім даручана сьвятыня ад імя сыноў Ізраіля. Калі б хто наблізіўся чужы, меў быць пакараны сьмерцю.<verse eid="NUM 3:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 3:39" /> Поўная лічба лявітаў, сьпісаных Майсеем па загаду ГОСПАДА, мужчынаў ад аднаго месяца і вышэй — дваццаць дзьве тысячы.<verse eid="NUM 3:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 3:40" /> І загадаў ГОСПАД Майсею: «Падлічы ўсіх першародных мужчынаў Ізраільцянаў у гадах ад аднаго месяца і вышэй, палічы іх паіменна,<verse eid="NUM 3:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 3:41" /> i вазьмі лявітаў для Мяне як замену усіх першародных з сыноў Ізраіля. Я — ГОСПАД. Таксама вазьмі жывёлу іхнюю на замену ўсёй першароднай жывёлы спаміж жывёлы сыноў Ізраіля».<verse eid="NUM 3:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 3:42" /> І палічыў Майсей на загад ГОСПАДА першародных Ізраільцянаў.<verse eid="NUM 3:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 3:43" /> І было ўсіх першародных мужчынаў па ліку імёнаў, ад аднаго месяца і вышэй, дваццаць дзьве тысячы дзьвесьце семдзесят тры.<verse eid="NUM 3:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 3:44" /> І зноў загадаў ГОСПАД Майсею:<verse eid="NUM 3:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 3:45" /> «Вазьмі лявітаў на месца ўсіх першародных Ізраільцянаў разам з жывёлай лявітаў на замену жывёлы іхняе. Лявіты будуць Маімі. Я — ГОСПАД.<verse eid="NUM 3:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 3:46" /> Як выкуп за гэтых дзьвесьце семдзесят трох, з першародных сыноў Ізраіля, што перавышаюць лік лявітаў,<verse eid="NUM 3:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 3:47" /> вазьмі па пяць сыкляў ад галавы, па вазе сыкля сьвятыні; сыкль мае дваццаць гераў.<verse eid="NUM 3:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 3:48" /> Дасі срэбнікі Аарону і сынам ягонымяк выкуп за тых, што засталіся».<verse eid="NUM 3:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 3:49" /> І ўзяў Майсей выкуп ад тых, што перавышалі лік выкупленых лявітамі.<verse eid="NUM 3:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 3:50" /> Дык вось ад першародных сыноў Ізраіля дастаў срэбнікаў тысячу трыста шэсьдзесят пяць [сыкляў] па вазе сыкля сьвятыні.<verse eid="NUM 3:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 3:51" /> І аддаў Майсей срэбра выкупу Аарону і сынам ягоным на загад ГОСПАДА, як сказаў яму ГОСПАД.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="cl">Лікі 4</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 4:1" /> І загадаў ГОСПАД Майсею і Аарону:<verse eid="NUM 4:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 4:2" /> «Аддзялі спаміж сыноў Левія сыноў Кегата, усю іх лічбу па родах іхніх і сем’ях іхніх,<verse eid="NUM 4:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 4:3" /> ад трыццаці гадоў і да пяцідзесяці гадоў, усіх, здольных да службы, каб выконвалі работу ў Намёце Спатканьня.<verse eid="NUM 4:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 4:4" /> Гэткая вось служба сыноў Кегата ў Намёце Спатканьня — [насіць] рэчы найсьвяцейшыя.<verse eid="NUM 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 4:5" /> Калі табар будуць рыхтаваць у паход, тады Аарон і сыны ягоныя ўвойдуць і здымуць заслону, што вiсiць перад уваходам, і накрыюць ёю Каўчэг Сьведчаньня.<verse eid="NUM 4:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 4:6" /> Потым пакладуць накрыцьцё са скуры тахаш, і над ім расьцягнуць тканіну, усю з фіялетавага пурпуру, а потым укладуць насілы.<verse eid="NUM 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 4:7" /> Таксама стол хлябоў пакладных накрыюць тканінаю з фіялетавага пурпуру і паставяць на ім посуд, талеркі, чашы і кубкі на ахвяры вадкія; і хлябы будуць на ім заўсёды.<verse eid="NUM 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 4:8" /> І пакладуць на іх тканіну кармазыновую, а потым накрыцьцё са скураў тахаш, а пасьля укладуць насілы.<verse eid="NUM 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 4:9" /> Потым возьмуць тканіну з фіялетавага пурпуру і накрыюць ёй падставу сьвечніка разам з лямпамі, нажніцамі, пасудзінамі на кнаты ды ўсімі пасудзінамі для алею, ужыванымі пры ім для запальваньня.<verse eid="NUM 4:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 4:10" /> І ўсё гэтае накрыюць накрыцьцём са скуры тахаш, і пакладуць на насілы.<verse eid="NUM 4:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 4:11" /> І на залаты ахвярнiк пакладуць тканіну з фіялетавага пурпуру, і накрыюць яго накрыцьцём са скуры тахаш, і ўкладуць насілы.<verse eid="NUM 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 4:12" /> Потым возьмуць усе прыналежнасьці, патрэбныя да службы ў сьвятыні, і накрыюць іх тканінай з фіялетавага пурпуру і накрыцьцём са скуры тахаш, і пакладуць на насілы.<verse eid="NUM 4:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 4:13" /> І ачысьцяць ахвярнiк ад попелу, і накрыюць яго чырвоным пурпурам.<verse eid="NUM 4:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 4:14" /> І пакладуць на ім увесь посуд, ужываны для службы пры ахвярнiку: папяльніцы, вілкі, лапаткі, крапільнікі — усе гэтыя прыналежнасьці ахвярнiка накрыюць скурай тахаш і ўкладуць насілы.<verse eid="NUM 4:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 4:15" /> Пры выхадзе ў дарогу, калі Аарон і сыны ягоныя скончаць накрываць усе сьвятыя рэчы і ўсе прыналежнасьці іхнія, падыйдуць сыны Кегата, каб іх несьці. Нельга ім аднак дакранацца Каўчэга Сьведчаньня, каб не памерлі. Такія вось абавязкі сыноў Кегата ў Намёце Спатканьня.<verse eid="NUM 4:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 4:16" /> Элеазар, сын Аарона сьвятара, будзе рупіцца пра алей на асьвятленьне, пра пахкія кадзілы, пра заўсёдную ахвяру хлебную, і пра алей памазаньня, і што толькі патрэбнае для служэньня ў Сялібе, і пра ўсе прыналежнасьці Сялібы».<verse eid="NUM 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 4:17" /> Зноў гаварыў ГОСПАД да Майсея:<verse eid="NUM 4:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 4:18" /> «Не дазвольце зьнікнуць сям’і Кегата сярод лявітаў,<verse eid="NUM 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 4:19" /> але старайцеся, каб жылі і не паміралі, калі будуць прыступацца да найсьвяцейшых рэчаў. Аарон і сыны ягоныя няхай прыйдуць і вызначаць кожнаму свой занятак і што хто мае несьці.<verse eid="NUM 4:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 4:20" /> Але няхай самі не ўваходзяць у сьвятыню хоць на хвіліну, каб паглядзець, бо будуць пакараныя сьмерцю».<verse eid="NUM 4:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 4:21" /> І далей гаварыў ГОСПАД да Майсея:<verse eid="NUM 4:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 4:22" /> «Палічы сыноў Гершона па родах іхніх і сем’ях іхніх.<verse eid="NUM 4:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 4:23" /> Палічы ўсіх ад трыццаці гадоў і да пяцідзесяці гадоў, усіх, здольных да службы, каб выконвалі работу ў Намёце Спатканьня.<verse eid="NUM 4:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 4:24" /> Вось такі абавязак сыноў Гершона, што яны будуць рабіць:<verse eid="NUM 4:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 4:25" /> яны будуць насіць заслоны Сялібы і сам Намёт Спатканьня з накрыцьцём ягоным, таксама накрыцьці са скураў тахаш, заслону, што вісіць каля ўваходу ў Намёт Спатканьня,<verse eid="NUM 4:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 4:26" /> заслоны панадворку і заслону ля ўваходу ў панадворак, які знаходзіцца вакол Сялібы і ахвярнiка, ды вяроўкі і ўсе прыналежнасьці, патрэбныя для служэньня.<verse eid="NUM 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 4:27" /> На загад Аарона і сыноў ягоных павінны праходзіць ўсе службы сыноў Гершона пры пераносцы цяжараў і пры ўсякай рабоце іхняй. Даручы ім ўсё, што носяць яны.<verse eid="NUM 4:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 4:28" /> Такі абавязак сыноў Гершона ў Намёце Спатканьня. Будуць яны пад наглядам Ітамара, сына Аарона сьвятара.<verse eid="NUM 4:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 4:29" /> Палічы таксама сыноў Мэрары па сем’ях іхніх і родах іхніх,<verse eid="NUM 4:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 4:30" /> ад трыццаці да пяцідзесяці гадоў, усіх, здольных да службы, каб працаваць у Намёце Спатканьня.<verse eid="NUM 4:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 4:31" /> Такія вось іхнія абавязкі: насіць дошкі Сялібы і яе папярочкі, слупкі яе і іх падставы,<verse eid="NUM 4:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 4:32" /> далей слупкі панадворку з усіх бакоў і іхнія падставы, калкі намёту і вяроўкі, ды ўсе рэчы пры іх, і ўсе прыналежнасьці іхнія, і запішыце ўсе рэчы, якія яны павінны насіць.<verse eid="NUM 4:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 4:33" /> Такі абавязак сыноў Мэрары і службаў іх у Намёце Спатканьня. Будуць яны пад наглядам Ітамара, сына Аарона сьвятара».<verse eid="NUM 4:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 4:34" /> Дык Майсей, і Аарон, і князі супольнасьці палічылі сыноў Кегата па сем’ях іхніх і родах іхніх,<verse eid="NUM 4:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 4:35" /> ад трыццаці гадоў і аж да пяцідзесяці гадоў, усіх здатных да спаўненьня службы і працы ў Намёце Спатканьня.<verse eid="NUM 4:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 4:36" /> Было налічана іх па сем’ях дзьве тысячы семсот пяцьдзясят.<verse eid="NUM 4:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 4:37" /> Такая вось лічба сыноў Кегата, якія паслугуюць у Намёце Спатканьня і якіх палічыў Майсей і Аарон па загаду ГОСПАДА, дадзенага праз Майсея.<verse eid="NUM 4:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 4:38" /> Палічаны таксама сыны Гершона па сем’ях іхніх і родах іхніх,<verse eid="NUM 4:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 4:39" /> ад трыццаці гадоў і аж да пяцідзесяці гадоў, здатных да спаўненьня службы і да працаў у Намёце Спатканьня.<verse eid="NUM 4:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 4:40" /> Налічана іх па сем’ях і родах дзьве тысячы шэсьцьсот трыццаць.<verse eid="NUM 4:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 4:41" /> Гэта лічба сыноў Гершона, усіх, якія спаўняюць службу ў Намёце Спатканьня, якіх палічыў Майсей і Аарон па загаду ГОСПАДА.<verse eid="NUM 4:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 4:42" /> Палічана таксама сыноў Мэрары па сем’ях іхніх і родах іхніх,<verse eid="NUM 4:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 4:43" /> ад трыццаці гадоў і да пяцідзесяці гадоў, усіх, здатных да службы ў Намёце Спатканьня.<verse eid="NUM 4:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 4:44" /> І налічана іх па сем’ях тры тысячы дзьвесьце.<verse eid="NUM 4:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 4:45" /> Гэта лічба сыноў Мэрары, якіх палічыў Майсей і Аарон па загаду ГОСПАДА, дадзенаму праз Майсея.<verse eid="NUM 4:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 4:46" /> Так былі сьпісаны ўсе лявіты, якіх палічылі Майсей, і Аарон, і князі Ізраіля па сем’ях іхніх і родах іхніх,<verse eid="NUM 4:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 4:47" /> ад трыццаці гадоў і аж да пяцідзесяці, здатных да спаўненьня службы ў Сялібе і да працаў у Намёце Спатканьня.<verse eid="NUM 4:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 4:48" /> І было налічана іх восем тысячаў пяцьсот восемдзесят.<verse eid="NUM 4:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 4:49" /> Па загаду ГОСПАДА, дадзенага Майсею, прызначаны яны кожны да сваёй работы і сваіх працаў. І былі яны палічаны, як загадаў ГОСПАД Майсею.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="cl">Лікі 5</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 5:1" /> І прамовіў зноў ГОСПАД да Майсея:<verse eid="NUM 5:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 5:2" /> «Загадай сынам Ізраіля выдаліць з табару ўсіх пракажоных, хворых на выцёкі і апаганеных ад нябожчыка.<verse eid="NUM 5:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 5:3" /> Як мужчыну, так і жанчыну выдаліце з табару, каб не паганілі табару, дзе Я жыву паміж вамі».<verse eid="NUM 5:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 5:4" /> Так і зрабілі сыны Ізраіля, і выдалілі іх па-за табар, як загадаў ГОСПАД Майсею, так і зрабілі.<verse eid="NUM 5:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 5:5" /> І загадаў ГОСПАД Майсею, кажучы:<verse eid="NUM 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 5:6" /> «Скажы сынам Ізраіля: Калі мужчына або жанчына дапусьціцца якога грэху адносна людзей, і парушыць загад ГОСПАДА, то будзе той чалавек вінаваты.<verse eid="NUM 5:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 5:7" /> Дык няхай яны вызнаюць грэх свой і аддадуць тое, што забранае, таму, перад кім саграшылі, з дадаткам пятай часткі.<verse eid="NUM 5:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 5:8" /> Калі ў яго няма чалавека, якому мог бы зьвярнуць, дык мусіць ГОСПАДУ пасьвяціць гэта, няхай будзе гэта сьвятару, апрача барана, ахвяраванага на перамольваньне, каб ім ачысьціць яго.<verse eid="NUM 5:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 5:9" /> Усе сьвятыя дары, якія прыносяць сьвятару сыны Ізраіля, яму належаць.<verse eid="NUM 5:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 5:10" /> Сьвятыя дары кожнага Ізраільцяніна будуць належаць сьвятару. Усё, што хто дасьць сьвятару, яму належыць».<verse eid="NUM 5:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 5:11" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 5:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 5:12" /> «Вось што скажы сынам Ізраіля: Муж, жонка якога распусьнічала, ашукваючы мужа,<verse eid="NUM 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 5:13" /> ды спала з чужым мужчынам, і муж яе пра гэтая ня ведаў, і дапусьцілася яна нячыстасьці, але няма сьведкаў на пацьвярджэньне, якія злавілі б яе на распусьце,<verse eid="NUM 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 5:14" /> і дух падазрэньня ахапіў мужа супраць жонкі сваёй, ці яна сапраўды спракудзілася, ці не,<verse eid="NUM 5:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 5:15" /> тады няхай прывядзе ён яе да сьвятара і складзе ў ахвяру за яе дзясятую частку эфы мукі ячменнай. Ня вылье аднак на яе алею і не пакладзе кадзіла, бо гэта ахвяра падазрэньня, ахвяра выяўленьня, якая мае выявіць віну.<verse eid="NUM 5:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 5:16" /> Дык няхай прывядзе яе сьвятар і паставіць перад ГОСПАДАМ.<verse eid="NUM 5:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 5:17" /> Няхай возьме сьвятар пасьвенчанай вады ў гліняны посуд і няхай возьме зямлі з падлогі Сялібы і ўложыць у ваду.<verse eid="NUM 5:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 5:18" /> І паставіць сьвятар жанчыну перад ГОСПАДАМ, адкрые валасы ёй ды паложыць на яе рукі ахвяру выяўленьня або падазрэньня; ваду ж горкую, якая нясе праклён, сьвятар будзе трымаць у руцэ сваёй.<verse eid="NUM 5:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 5:19" /> Тады запрысягне ён жанчыну і скажа ёй: “Калі сапраўды ніводзін мужчына не ляжаў з табой, і калі з іншым не спаганілася ты што да мужа твайго, тады вада горычы і праклёну не прынясе табе шкоды<verse eid="NUM 5:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 5:20" /> Калі аднак была ты нявернай мужу свайму ды сталася праз гэта нячыстая, бо іншы мужчына, а ня твой муж ляжаў з табой, выліваючы (насеньне),” —<verse eid="NUM 5:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 5:21" /> тады сьвятар пракляне жанчыну прысягай праклёну і скажа ёй: “Няхай аддасьць цябе ГОСПАД праклёну і клятве ў народзе тваім, і няхай счэзьне ўлоньне тваё і апухне жывот твой.<verse eid="NUM 5:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 5:22" /> Няхай вада праклёну пранікне ў нутро тваё, каб апух жывот твой ды апала ўлоньне тваё”. Жанчына адкажа: “Амэн, амэн”.<verse eid="NUM 5:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 5:23" /> І напіша сьвятар на скрутку словы праклёну, а пасля змые іх вадою горычы<verse eid="NUM 5:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 5:24" /> і дасьць выпіць жанчыне горкую ваду, якая нясе праклён, каб вада праклёну пранікла ў яе і спрычыніла горкі боль.<verse eid="NUM 5:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 5:25" /> Потым возьме сьвятар з рук жанчыны ахвяру падазрэньня, і патрасе перад ГОСПАДАМ, і складзе яе на ахвярнiку.<verse eid="NUM 5:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 5:26" /> Потым возьме з яе поўнай жменяй частку яе як памятную частку i спаліць яе на ахвярнiку, а пасьля дасьць жанчыне выпіць вады.<verse eid="NUM 5:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 5:27" /> Калі вып’е жанчына ваду праклёну і калі сапраўды была яна нячыстай і нявернай мужу свайму, вада праклёну пранікне ў яе, выклікаючы горкі боль. Улоньне яе ападзе і жывот апухне, і станецца тая жанчына праклятаю ў народзе сваім.<verse eid="NUM 5:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 5:28" /> Калі аднак тая жанчына не была нячыстай, але, наадварот, чыстай, то застанецца бяз шкоды i зноў будзе нараджаць дзяцей».<verse eid="NUM 5:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 5:29" /> Такі вось закон адносна падазрэньня, калі жонка не стрымае вернасьці свайму мужу і праз гэта станецца нячыстай,<verse eid="NUM 5:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 5:30" /> або калі муж ейны стане яе падазраваць, тады ён паставіць яе перад ГОСПАДАМ, а сьвятар споўніць усё, што прадпісана.<verse eid="NUM 5:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 5:31" /> Муж яе будзе без віны, а тая жонка адкажа за грэх свой.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="cl">Лікі 6</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 6:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 6:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 6:2" /> «Аб’яві сынам Ізраіля і скажы ім: Калі нейкі мужчына або жанчына складуць шлюбаваньне назіру, каб пасьвяціцца ГОСПАДУ,<verse eid="NUM 6:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 6:3" /> мусяць яны ўстрымацца ад віна і сікеры, ад ўсяго п’янкога, воцату з віна ды ўсякага іншага піцьця, што выціскаецца з вінаграду. Няхай не ядуць таксама сьвежага вінаграду і сушанага.<verse eid="NUM 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 6:4" /> У-ва ўсе дні, у якія з шлюбаваньня пасьвяціліся ГОСПАДУ, ня будзе [такі чалавек] есьці нічога з вінаграду, ад недасьпелага вінаграду аж да выцісканага.<verse eid="NUM 6:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 6:5" /> Увесь час пасьвячэньня нажніцы не дакрануцца галавы ягонай. Аж да спыненьня часу, на які ён пасьвяціўся ГОСПАДУ, будзе ён сьвяты ды мае даць свабоду валасам расьці на галаве.<verse eid="NUM 6:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 6:6" /> Увесь час пасьвячэньня ГОСПАДУ не павінен ён падыходзіць да нябожчыка.<verse eid="NUM 6:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 6:7" /> Няхай пры пахаваньні нават бацькі, маці, брата або сястры не занячысьціцца, бо пасьвячэньне Богу ягонаму на галаве ягонай.<verse eid="NUM 6:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 6:8" /> У-ва ўсе дні пасьвячэньня свайго сьвятым будзе ён для ГОСПАДА.<verse eid="NUM 6:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 6:9" /> А калі хто раптам пры ім памрэ, і ён занячысьціць галаву пасьвячэньня свайго, то астрыжэ галаву ў сёмы дзень, у дзень ачышчэньня свайго.<verse eid="NUM 6:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 6:10" /> У восьмы дзень прынясе двух туркоў або двух маладых галубоў сьвятару да ўваходу ў Намёт Спатканьня.<verse eid="NUM 6:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 6:11" /> Аднаго складзе сьвятар у ахвяру за грэх, а другога — у ахвяру цэласпаленьня і ачысьціць яго, бо саграшыў ён дзеля нябожчыка, і ў той дзень пасьвяціць галаву яго.<verse eid="NUM 6:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 6:12" /> Ды зноў пасьвяціць ён ГОСПАДУ дні пасьвячэньня свайго, складаючы ў ахвяру ягня аднагадовае як аднагараджэньне. Дні папярэднія ня будуць залічаны яму, бо спаганіў пасьвячэньне сваё.<verse eid="NUM 6:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 6:13" /> Такі вось закон пасьвячэньня. Калі дні, якія шлюбаваў, скончацца, прывядуць яго да ўваходу ў Намёт Спатканьня,<verse eid="NUM 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 6:14" /> і ён прынясе ў ахвяру ГОСПАДУ адно аднагадовае ягня без заганы ў ахвяру цэласпаленьня, і адну аднагадовую авечку без заганы ў ахвяру за грэх, i адно ягня без заганы ў ахвяру мірную,<verse eid="NUM 6:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 6:15" /> і кошык хлябоў прэсных з мукі пшанічнай, запраўленых алеем, i аладак прэсных, запраўленых алеем, поруч з належнай да іх ахвярай хлебнай і ахвярай вадкай.<verse eid="NUM 6:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 6:16" /> Сьвятар занясе ўсё гэта перад ГОСПАДА i складзе ахвяру за грэх і ахвяру цэласпаленьня.<verse eid="NUM 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 6:17" /> Ягня ён складзе ГОСПАДУ ў ахвяру мірную разам з кошыкам праснакоў. Потым складзе сьвятар ахвяру хлебную і ахвяру вадкую.<verse eid="NUM 6:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 6:18" /> Тады абстрыжэ назір ля ўваходу ў Намёт Спатканьня валасы свайго пасьвячэньня і кіне іх у агонь, у каторым гарыць ахвяра прымірэньня.<verse eid="NUM 6:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 6:19" /> Потым возьме сьвятар звараную лапатку барана, хлеб прэсны з каша і прэсную аладку i складзе іх на рукі назіра пасьля таго, як пастрыжэ ён галаву пасьвячэньня свайго.<verse eid="NUM 6:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 6:20" /> І сьвятар дары ахвярныя патрасе перад ГОСПАДАМ; бо гэта дар сьвяты, якi належыць сьвятару, апрача грудзіны патрасаньня і пляча, якое адкладзена на ахвяру. Пасьля гэтага назір можа піць віно.<verse eid="NUM 6:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 6:21" /> Такі вось закон адносна назіра, які шлюбаваў ахвяру сваю ГОСПАДУ за пасьвячэньне сваё апрача таго, што дазволіць яму дастатак ягоны. Паводле шлюбаваньня свайго, якое ён дасьць, павінен ён рабіць, паводле закону пасьвячэньня свайго».<verse eid="NUM 6:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 6:22" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 6:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 6:23" /> «Скажы Аарону і сынам ягоным: Гэтак вось маеце вы дабраслаўляць сыноў Ізраіля і казаць ім:<verse eid="NUM 6:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 6:24" /> “Няай дабраславіць цябе ГОСПАД i захавае цябе!<verse eid="NUM 6:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 6:25" /> Няхай спагадна гляне ГОСПАД на цябе i зьлітуецца над табою!<verse eid="NUM 6:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 6:26" /> Няхай зьверне ГОСПАД аблічча Сваё на цябе і дасьць табе супакой!”<verse eid="NUM 6:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 6:27" /> Няхай так прызываюць імя Маё на сыноў Ізраіля, і Я буду ім дабраславіць».<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="cl">Лікі 7</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 7:1" /> Калі Майсей збудаваў Сялібу і памазаў яе, і пасьвяціў яе і ўсе ейныя прыналежнасьці, і памазаў іх, і пасьвяціў іх,<verse eid="NUM 7:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 7:2" /> тады прыйшлі князі Ізраіля, галовы паасобных родаў сваіх, начальнікі пакаленьняў, якія стаялі на чале перапісу,<verse eid="NUM 7:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 7:3" /> і прынесьлі дары свае перад ГОСПАДА: шэсьць крытых вазоў і дванаццаць валоў, па адным возе ад двух начальнікаў і па аднаму валу ад кожнага, і паставілі гэта перад Сялібай.<verse eid="NUM 7:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 7:4" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 7:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 7:5" /> «Вазьмі гэта ад іх; няхай будзе гэта на абслугу Намёту Спатканьня. Разьдзялі гэта паміж лявітамі адпаведна да іх паслугі».<verse eid="NUM 7:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 7:6" /> І ўзяў Майсей вазы і валы, і аддаў іх лявітам.<verse eid="NUM 7:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 7:7" /> Адпаведна да іх паслугі сынам Гершона даў два вазы і чатыры валы.<verse eid="NUM 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 7:8" /> Восем валоў і чатыры вазы даў сынам Мэрары, адпаведна да іхняй паслугі, якую мелі спаўняць пад наглядам Ітамара, сына Аарона сьвятара.<verse eid="NUM 7:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 7:9" /> А сынам Кегата ня даў нічога, бо яны мелі апякавацца рэчамі найсьвяцейшымі і насіць іх на плячах сваіх.<verse eid="NUM 7:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 7:10" /> У дзень пасьвячэньня і памазаньня ахвярнiка прынесьлі начальнікі дары свае перад ахвярнiкам.<verse eid="NUM 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 7:11" /> І сказаў ГОСПАД Майсею: «Няхай кожны з начальнікаў штодзень прыносіць дары свае на пасьвячэньне ахвярнiка».<verse eid="NUM 7:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 7:12" /> У першы дзень прынёс дар свой Нахшон, сын Амінадава, з пакаленьня Юды.<verse eid="NUM 7:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 7:13" /> Ягоным дарам ахвярным былі міса срэбная ў сто трыццаць сыкляў вагі, таксама чаша срэбная ў семдзесят сыкляў вагі, па вазе сьвятыні. Абедзьве напоўненыя былі пшанічнаю мукой, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 7:14" /> залатая чаша ў дзесяць сыкляў вагі, напоўненая кадзілам,<verse eid="NUM 7:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 7:15" /> адзін бычок, баран і гадавое ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 7:16" /> казёл у ахвяру за грэх,<verse eid="NUM 7:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 7:17" /> і ў ахвяру мірную два валы, пяць бараноў, пяць казлоў і пяць аднагадовых ягнят. Гэта ахвярны дар Нахшона, сына Амінадава.<verse eid="NUM 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 7:18" /> У другі дзень прынёс дар ахвярны Натанаэль, сын Цуара, князь з пакаленьня Ісахара.<verse eid="NUM 7:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 7:19" /> Ён прынёс місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя пшанічнай мукой, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 7:20" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам;<verse eid="NUM 7:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 7:21" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 7:22" /> казла ў ахвяру за грэх,<verse eid="NUM 7:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 7:23" /> i ў ахвяру мірную два валы, пяць бараноў, пяць казлоў і пяць аднагадовых ягнят. Гэта ахвяра Натанаэля, сына Цуара.<verse eid="NUM 7:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 7:24" /> У трэці дзень [прынёс дар ахвярны] князь сыноў Завулёна Эліяў, сын Гэлёна.<verse eid="NUM 7:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 7:25" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя пшанічнай мукой, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 7:26" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 7:27" /> маладога бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 7:28" /> казла ў ахвяру за грэх,<verse eid="NUM 7:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 7:29" /> і два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Эліява, сына Гэлёна.<verse eid="NUM 7:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 7:30" /> У чацьвёрты дзень [прынёс дар ахвярны] князь Рубэна Эліцур, сын Шэдэура.<verse eid="NUM 7:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 7:31" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па сыклю сьвятыні, абедзьве напоўненыя пшанічнай мукой, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 7:32" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 7:33" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 7:34" /> казла ў ахвяру за грэх,<verse eid="NUM 7:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 7:35" /> і два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Эліцура, сына Шэдэура.<verse eid="NUM 7:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 7:36" /> У пяты дзень [прынёс дар ахвярны] князь сыноў Сымона Шэлюміэль, сын Цурышадая.<verse eid="NUM 7:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 7:37" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 7:38" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 7:39" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 7:40" /> казла ў ахвяру за грэх,<verse eid="NUM 7:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 7:41" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Шэлюміэля, сына Цурышадая.<verse eid="NUM 7:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 7:42" /> У шосты дзень [прынёс дар ахвярны] князь сыноў Гада Эліясаф, сын Дэўэля.<verse eid="NUM 7:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 7:43" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 7:44" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 7:45" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 7:46" /> казла ў ахвяру за грэх,<verse eid="NUM 7:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 7:47" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Эліясафа, сына Дэўэля.<verse eid="NUM 7:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 7:48" /> У сёмы дзень [прынёс дар ахвярны] князь сыноў Эфраіма Элішама, сын Амігуда.<verse eid="NUM 7:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 7:49" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбнуюў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 7:50" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 7:51" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:51" /></para>
  <para style="m">
    <verse number="52" style="v" pubnumber="52." sid="NUM 7:52" /> казла ў ахвяру за грэх,<verse eid="NUM 7:52" /></para>
  <para style="m">
    <verse number="53" style="v" pubnumber="53." sid="NUM 7:53" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Элішамы, сына Амігуда.<verse eid="NUM 7:53" /></para>
  <para style="m">
    <verse number="54" style="v" pubnumber="54." sid="NUM 7:54" /> У восьмы дзень [прынёс дар ахвярны] князь сыноў Манасы Гамаліэль, сын Пэдагсура.<verse eid="NUM 7:54" /></para>
  <para style="m">
    <verse number="55" style="v" pubnumber="55." sid="NUM 7:55" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:55" /></para>
  <para style="m">
    <verse number="56" style="v" pubnumber="56." sid="NUM 7:56" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:56" /></para>
  <para style="m">
    <verse number="57" style="v" pubnumber="57." sid="NUM 7:57" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:57" /></para>
  <para style="m">
    <verse number="58" style="v" pubnumber="58." sid="NUM 7:58" /> казла ў ахвяру за грэх,<verse eid="NUM 7:58" /></para>
  <para style="m">
    <verse number="59" style="v" pubnumber="59." sid="NUM 7:59" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Гамаліэля, сына Пэдагсура.<verse eid="NUM 7:59" /></para>
  <para style="m">
    <verse number="60" style="v" pubnumber="60." sid="NUM 7:60" /> У дзявяты дзень [прынёс дар ахвярны] князь сыноў Бэн’яміна Абідан, сын Гідэоні.<verse eid="NUM 7:60" /></para>
  <para style="m">
    <verse number="61" style="v" pubnumber="61." sid="NUM 7:61" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:61" /></para>
  <para style="m">
    <verse number="62" style="v" pubnumber="62." sid="NUM 7:62" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:62" /></para>
  <para style="m">
    <verse number="63" style="v" pubnumber="63." sid="NUM 7:63" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:63" /></para>
  <para style="m">
    <verse number="64" style="v" pubnumber="64." sid="NUM 7:64" /> казла ў ахвяру за грэх,<verse eid="NUM 7:64" /></para>
  <para style="m">
    <verse number="65" style="v" pubnumber="65." sid="NUM 7:65" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Абідана, сына Гідэоні.<verse eid="NUM 7:65" /></para>
  <para style="m">
    <verse number="66" style="v" pubnumber="66." sid="NUM 7:66" /> У дзясяты дзень [прынёс дар ахвярны] князь сыноў Дана Ахіезэр, сын Амішадая.<verse eid="NUM 7:66" /></para>
  <para style="m">
    <verse number="67" style="v" pubnumber="67." sid="NUM 7:67" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:67" /></para>
  <para style="m">
    <verse number="68" style="v" pubnumber="68." sid="NUM 7:68" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:68" /></para>
  <para style="m">
    <verse number="69" style="v" pubnumber="69." sid="NUM 7:69" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:69" /></para>
  <para style="m">
    <verse number="70" style="v" pubnumber="70." sid="NUM 7:70" /> казла ў ахвяру за грэх,<verse eid="NUM 7:70" /></para>
  <para style="m">
    <verse number="71" style="v" pubnumber="71." sid="NUM 7:71" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Ахіезэра, сына Амішадая.<verse eid="NUM 7:71" /></para>
  <para style="m">
    <verse number="72" style="v" pubnumber="72." sid="NUM 7:72" /> У адзінаццаты дзень [прынёс дар ахвярны] князь сыноў Асэра Пагіэль, сын Акрана.<verse eid="NUM 7:72" /></para>
  <para style="m">
    <verse number="73" style="v" pubnumber="73." sid="NUM 7:73" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:73" /></para>
  <para style="m">
    <verse number="74" style="v" pubnumber="74." sid="NUM 7:74" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:74" /></para>
  <para style="m">
    <verse number="75" style="v" pubnumber="75." sid="NUM 7:75" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:75" /></para>
  <para style="m">
    <verse number="76" style="v" pubnumber="76." sid="NUM 7:76" /> казла ў ахвяру за грэх,<verse eid="NUM 7:76" /></para>
  <para style="m">
    <verse number="77" style="v" pubnumber="77." sid="NUM 7:77" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Пагіэля, сына Акрана.<verse eid="NUM 7:77" /></para>
  <para style="m">
    <verse number="78" style="v" pubnumber="78." sid="NUM 7:78" /> У дванаццаты дзень [прынёс дар ахвяры] князь сыноў Нэфталі Ахіра, сын Энана.<verse eid="NUM 7:78" /></para>
  <para style="m">
    <verse number="79" style="v" pubnumber="79." sid="NUM 7:79" /> Ён ахвяраваў місу срэбную ў сто трыццаць сыкляў вагі, чашу срэбную ў семдзесят сыкляў вагі, па вазе сьвятыні, абедзьве напоўненыя мукой пшанічнай, запраўленай алеем, у ахвяру хлебную,<verse eid="NUM 7:79" /></para>
  <para style="m">
    <verse number="80" style="v" pubnumber="80." sid="NUM 7:80" /> залатую чашу ў дзесяць сыкляў вагі, напоўненую кадзілам,<verse eid="NUM 7:80" /></para>
  <para style="m">
    <verse number="81" style="v" pubnumber="81." sid="NUM 7:81" /> аднаго бычка, барана і аднагадовае ягня ў ахвяру цэласпаленьня,<verse eid="NUM 7:81" /></para>
  <para style="m">
    <verse number="82" style="v" pubnumber="82." sid="NUM 7:82" /> казла ў ахвяру за грэх,<verse eid="NUM 7:82" /></para>
  <para style="m">
    <verse number="83" style="v" pubnumber="83." sid="NUM 7:83" /> два валы, пяць бараноў, пяць казлоў, пяць аднагадовых ягнят у ахвяру мірную. Гэта ахвяра Ахіры,сына Энана.<verse eid="NUM 7:83" /></para>
  <para style="m">
    <verse number="84" style="v" pubnumber="84." sid="NUM 7:84" /> Вось дары ад князёў Ізраіля пры пасьвячэньні ахвярнiка, у дзень яго памазаньня: дванаццаць срэбных місаў, дванаццаць срэбных чашаў, дванаццаць залатых чашаў.<verse eid="NUM 7:84" /></para>
  <para style="m">
    <verse number="85" style="v" pubnumber="85." sid="NUM 7:85" /> Кожная міса важыла сто трыццаць сыкляў срэбра, а кожная чаша — семдзесят.<verse eid="NUM 7:85" /></para>
  <para style="m">
    <verse number="86" style="v" pubnumber="86." sid="NUM 7:86" /> Чашаў залатых, напоўненых кадзілам, было дванаццаць; кожная чаша важыла дзесяць сыкляў, па вазе сьвятыні. Агульная вага золата чашаў складала сто дваццаць сыкляў.<verse eid="NUM 7:86" /></para>
  <para style="m">
    <verse number="87" style="v" pubnumber="87." sid="NUM 7:87" /> Агульная лічба жывёлы, прызначанай для цэласпаленьня, была: дванаццаць бычкоў, дванаццаць бараноў, дванаццаць аднагадовых ягнят, з дадаткам належных ахвяраў хлебных, і дванаццаць казлоў у ахвяру за грэх.<verse eid="NUM 7:87" /></para>
  <para style="m">
    <verse number="88" style="v" pubnumber="88." sid="NUM 7:88" /> Агульная лічба быдла, прызначанага ў ахвяру мірную, складала: дваццаць чатыры валы, шэсьцьдзесят бараноў, шэсьцьдзесят казлоў i шэсьцьдзесят аднагадовых ягнят. Гэта былі [дары] на пасьвяту ахвярнiка, калі ён быў памазаны.<verse eid="NUM 7:88" /></para>
  <para style="m">
    <verse number="89" style="v" pubnumber="89." sid="NUM 7:89" /> Калі Майсей уваходзіў у Намёт Спатканьня, каб гаварыць з ГОСПАДАМ, чуў ён голас, якi гаварыў яму з-над накрыўкі, якая была над Каўчэгам Сьведчаньня паміж двума херувімамі. Адтуль казаў Ён яму.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="cl">Лікі 8</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 8:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 8:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 8:2" /> «Аб’яві Аарону i скажы яму: “Калі будзеш запальваць лямпы, то на пярэднім баку сьвечніка павінны гарэць сем лямпаў”».<verse eid="NUM 8:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 8:3" /> Аарон зрабіў гэтак і на пярэднім баку сьвечніка запаліў лямпы, як загадаў ГОСПАД Майсею.<verse eid="NUM 8:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 8:4" /> Такі вось быў выраб сьвечніка: куты ён быў з золата, ад падставы аж да кветак быў каваны. Быў ён зроблены паводле ўзору, які паказаў ГОСПАД Майсею.<verse eid="NUM 8:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 8:5" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 8:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 8:6" /> «Вазьмі лявітаў спаміж сыноў Ізраіля і ачысьці іх.<verse eid="NUM 8:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 8:7" /> Ачысьці іх так: пакрапі іх вадой ахвяры за грэх, і няхай паголяць яны ўсе валасы на целе, і няхай вымыюць адзеньне сваё, і будуць чыстымі.<verse eid="NUM 8:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 8:8" /> Потым возьмуць цяля са статку і ахвяру з мукі, запраўленай алеем, а другое цяля са статку ты возьмеш у ахвяру за грэх.<verse eid="NUM 8:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 8:9" /> Прывядзі лявітаў перад Намёт Спатканьня і зьбяры ўсю супольнасьць Ізраіля.<verse eid="NUM 8:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 8:10" /> Калі лявіты зьбяруцца перад ГОСПАДАМ, няхай сыны Ізраіля пакладуць на іх рукі свае.<verse eid="NUM 8:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 8:11" /> Потым Аарон як патрасанае перад ГОСПАДАМ ахвяруе лявітаў ад сыноў Ізраіля, каб былі служыцелямі Ягонымі.<verse eid="NUM 8:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 8:12" /> А лявіты няхай ускладуць рукі свае на галовы цялят, і ты аднаго з іх складзеш у ахвяру за грэх, а другога — у ахвяру ГОСПАДУ на цэласпаленьне, каб ачысьціць іх.<verse eid="NUM 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 8:13" /> Потым паставіш лявітаў перад Ааронам і сынамі ягонымі і ахвяруеш іх як патрасанае ГОСПАДУ.<verse eid="NUM 8:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 8:14" /> Выдзелі лявітаў спаміж сыноў Ізраіля, каб былі яны Маімі.<verse eid="NUM 8:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 8:15" /> А потым няхай прыходзяць і служаць у Намёце Спатканьня, калі ты іх ачысьціш і ахвяруеш іх як ахвяру пасьвячэньня.<verse eid="NUM 8:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 8:16" /> Бо яны Мне аддадзены спасярод сыноў Ізраіля. Узяў Я іх замест першародных, якія родзяцца ў Ізраіля.<verse eid="NUM 8:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 8:17" /> Бо Мае ўсе першародныя з сыноў Ізраіля, як з людзей, так і з жывёлы. Ад таго дня, у які Я выгубіў усё першароднае ў зямлі Эгіпецкай, Я іх пасьвяціў Сабе.<verse eid="NUM 8:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 8:18" /> І ўзяў Я лявітаў замест усіх першародных спаміж сыноў Ізраіля,<verse eid="NUM 8:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 8:19" /> і даю іх Аарону і сынам ягоным спаміж сыноў Ізраіля, каб служылі Мне за ўсяго Ізраіля ў Намёце Спатканьня, каб перамаляць ГОСПАДА за іх, каб усьцерагчы ад кары народ, калі б асьмеліўся наблізіцца да Сялібы».<verse eid="NUM 8:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 8:20" /> Дык Майсей і Аарон і ўся супольнасьць сыноў Ізраіля зрабілі з лявітамі гэтак; як загадаў ГОСПАД Майсею, так і зрабілі з імі сыны Ізраіля.<verse eid="NUM 8:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 8:21" /> Вось жа ачысьціліся лявіты і памылі адзеньне сваё, а Аарон, патрасаючы, ахвяраваў іх ГОСПАДУ і ачысьціў іх, каб былі ачышчаныя.<verse eid="NUM 8:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 8:22" /> Пасьля спаўнялі яны абавязкі свае ў Намёце Спатканьня ў прысутнасьці Аарона і сыноў ягоных. Як адносна лявітаў загадаў ГОСПАД Майсею, так вось і сталася.<verse eid="NUM 8:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 8:23" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 8:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 8:24" /> «Такі вось закон адносна лявітаў: ад дваццаці пяці гадоў і вышэй няхай прыходзяць яны і служаць ў Намёце Спатканьня;<verse eid="NUM 8:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 8:25" /> а калі скончаць пяцідзясяты год жыцьця, няхай ня служаць,<verse eid="NUM 8:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 8:26" /> а будуць толькі дапамагаць братам сваім у Намёце Спатканьня, але абавязкаў ужо сваіх спаўняць ня будуць. Так зробіш з лявітамі адносна службы іхняй».<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="cl">Лікі 9</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 9:1" /> У першы месяц другога году па выхадзе з Эгіпту сказаў ГОСПАД Майсею ў пустыні Сынай:<verse eid="NUM 9:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 9:2" /> «У вызначаны час сыны Ізраіля павінны сьвяткаваць Пасху.<verse eid="NUM 9:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 9:3" /> Будзеце яе сьвяткаваць у чатырнаццаты дзень гэтага месяца вечарам паводле ўсіх адносна яе законаў і звычаяў».<verse eid="NUM 9:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 9:4" /> І прамовіў Майсей да сыноў Ізраіля, каб яны справілі Пасху.<verse eid="NUM 9:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 9:5" /> І яны спраўлялі Пасху ў свой час у чатырнаццаты дзень месяца вечарам у пустыні Сынай. Паводле ўсяго таго, што загадаў ГОСПАД Майсею, рабілі сыны Ізраіля.<verse eid="NUM 9:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 9:6" /> І былі людзі, якія дзеля дакрананьня да нябожчыка сталіся нячыстымі і не маглі ў той дзень спраўляць Пасху, і прыйшлі яны да Майсея і Аарона,<verse eid="NUM 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 9:7" /> і сказалі ім: «Мы — нячыстыя дзеля дакрананьня да нябожчыка, але дзеля чаго мы пазбаўлены таго, каб сярод сыноў Ізраіля ў вызначаны час маглі скласьці ахвяры ГОСПАДУ?»<verse eid="NUM 9:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 9:8" /> І сказаў ім Майсей: «Пачакайце, даведаюся, што адносна вас загадае ГОСПАД».<verse eid="NUM 9:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 9:9" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 9:10" /> «Скажы сынам Ізраіля: Чалавек з вас ці з нашчадкаў вашых, які стаўся нячыстым дзеля нябожчыка або дзеля далёкай дарогі, павінен спраўляць Пасху<verse eid="NUM 9:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 9:11" /> ў чатырнаццаты дзень другога месяца вечарам; з прэсным хлебам і горкімі травамі няхай спажываюць яе.<verse eid="NUM 9:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 9:12" /> Няхай не пакідаюць з яе анічога да раніцы, таксама косткі яе ня будуць ламаць. Няхай увесь парадак Пасхі дакладна захаваюць.<verse eid="NUM 9:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 9:13" /> Калі ж хто чысты і не ў дарозе, а Пасхі не спраўляе, вынішчана будзе душа тая з народу свайго, бо ён ня склаў ахвяры ГОСПАДУ ў свой час. Ён сам адкажа за грэх свой.<verse eid="NUM 9:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 9:14" /> Падарожнік і прыбылец, калі б такія жылі б у вас, няхай спраўляюць Пасху паводле закону і звычаяў Пасхі. Загад той самы будзе ў вас і чужынцу, і тутэйшаму».<verse eid="NUM 9:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 9:15" /> У дзень, у які была пастаўлена Сяліба, воблака накрыла Сялібу разам з Намётам Сьведчаньня, і ад вечара да раніцы заставалася над Сялібай у выглядзе агня.<verse eid="NUM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 9:16" /> І так было заўсёды: днём пакрывала яе воблака, а ноччу — як бы бляск агню.<verse eid="NUM 9:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 9:17" /> Калі воблака, якое пакрывала Сялібу, падымалася над Сялібай, тады сыны Ізраіля выходзілі ў дарогу, а на тым месцы, дзе затрымоўвалася, там раскладаліся табарам.<verse eid="NUM 9:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 9:18" /> На загад ГОСПАДА выходзілі яны ў дарогу і на загад Ягоны раскладаліся табарам. Усе дні, у якія воблака стаяла над Сялібай, яны заставаліся ў тым самым месцы.<verse eid="NUM 9:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 9:19" /> Вось жа здаралася, што воблака доўгі час трымалася над Сялібай, і сыны Ізраіля паводле волі ГОСПАДА не выходзілі ў дарогу.<verse eid="NUM 9:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 9:20" /> Але здаралася таксама, што воблака кароткі час стаяла над Сялібай, і сыны Ізраіля паводле волі ГОСПАДА раскладаліся табарам і па загадзе Ягоным рушылі ў дарогу.<verse eid="NUM 9:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 9:21" /> Было і так, што воблака стаяла ад вечара да раніцы, а на раніцы падымалася, тады і яны зьбіраліся ў дарогу. Часам стаяла воблака дзень і ноч, і як толькі яно падымалася, яны адразу выходзілі ў дарогу.<verse eid="NUM 9:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 9:22" /> Вось жа калі два дні, або месяц, або некалькі дзён стаяла воблака над Сялібай, то і сыны Ізраіля стаялі і не зьбіраліся ў дарогу.<verse eid="NUM 9:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 9:23" /> Паводле волі ГОСПАДА яны раскладаліся табарам, і на слова ГОСПАДА выпраўляліся ў дарогу; яны трымаліся волі ГОСПАДА і загадаў, даваных праз Майсея.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="cl">Лікі 10</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 10:1" /> І казаў ГОСПАД Майсею:<verse eid="NUM 10:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 10:2" /> «Зрабі сабе дзьве трубы срэбныя, кутыя, якімі зможаш склікаць усю супольнасьць, калі трэба будзе рыхтаваць табар у дарогу.<verse eid="NUM 10:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 10:3" /> Калі затрубяць у трубы, зьбярэцца да цябе ўся супольнасьць да ўваходу ў Намёт Спатканьня.<verse eid="NUM 10:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 10:4" /> А калі толькі ў адну затрубяць, зьбяруцца да цябе толькі князі і начальнікі дружынаў Ізраіля.<verse eid="NUM 10:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 10:5" /> Калі затрубіш працягла, падымуцца тыя дружыны, якія з усходняга боку.<verse eid="NUM 10:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 10:6" /> Калі другі раз працягла затрубіш, падымуцца тыя дружыны, якія з паўднёвага боку. Знакам на вырушаньне табару будзе працяглае трубеньне.<verse eid="NUM 10:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 10:7" /> На зьбіраньне супольнасьці будзе просты гук, а не працяглы.<verse eid="NUM 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 10:8" /> Трубіць у трубы будуць сыны Аарона, сьвятары. Будзе гэта вам і нашчадкам вашым закон вечны.<verse eid="NUM 10:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 10:9" /> Калі будзеш ісьці на вайну ў зямлі вашай супраць ворага, які наступае на вас, будзеце працягла трубіць у трубы. Гэта будзе кліч ваш перад ГОСПАДАМ, Богам вашым, і будзеце збаўлены з рук ворагаў вашых.<verse eid="NUM 10:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 10:10" /> Калі будзеце мець баляваньне ў сьвяты і ў маладзікі, пры вашых ахвярах цэлапсаленьня i ахвярах мірных, будзеце трубіць у трубы; яны будуць прыпамінаньнем перад ГОСПАДАМ пра вас. Я — ГОСПАД, Бог ваш!»<verse eid="NUM 10:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 10:11" /> У другі год, у другі месяц, у дваццаты дзень месяца, паднялося воблака з-над Сялібы Сьведчаньня.<verse eid="NUM 10:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 10:12" /> І вырушылі сыны Ізраіля ў дарогу сваю з пустыні Сынай і спынілася воблака ў пустыні Паран.<verse eid="NUM 10:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 10:13" /> Першы раз паводле загаду ГОСПАДА, дадзенага праз Майсея, рушыў табар у дарогу.<verse eid="NUM 10:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 10:14" /> Першым вырушыў сьцяг табару сыноў Юды з дружынамі сваімі, князем якіх быў Нахшон, сын Амінадава.<verse eid="NUM 10:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 10:15" /> Дружыны пакаленьня Ісахара ўзначальваў Натанаэль, сын Цуара.<verse eid="NUM 10:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 10:16" /> А над дружынамі пакаленьня Завулёна быў князем Эліяў, сын Гэлёна.<verse eid="NUM 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 10:17" /> І разабралі Сялібу, і вырушылі сыны Гершона і сыны Мэрары, несучы Сялібу.<verse eid="NUM 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 10:18" /> Вырушыў у дарогу сьцяг табару сыноў Рубэна з дружынамі сваімі, а над грамадой гэтай князем быў Эліцур, сын Шэдэура.<verse eid="NUM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 10:19" /> А над дружынай пакаленьня Сымона князем быў Шэлюміэль, сын Цурышадая.<verse eid="NUM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 10:20" /> Над дружынай пакаленьня сыноў Гада князем быў Эліясаф, сын Дэўэля.<verse eid="NUM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 10:21" /> Рушылі ў дарогу сыны Кегата, несучы найсьвяцейшыя рэчы. Пакуль яны прыбылі, Сяліба была ўжо пастаўлена.<verse eid="NUM 10:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 10:22" /> Падняўся сьцяг табару сыноў Эфраіма з дружынамі сваімі, князем якіх быў Элішама, сын Амігуда.<verse eid="NUM 10:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 10:23" /> А над дружынай пакаленьня Манасы князем быў Гамаліэль, сын Пэдагсура.<verse eid="NUM 10:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 10:24" /> А над дружынай сыноў Бэн’яміна князем быў Абідан, сын Гідэоні.<verse eid="NUM 10:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 10:25" /> Потым падняўся сьцяг табару сыноў Дана з дружынамі сваімі, князем якіх быў Ахіезэр, сын Амішадая.<verse eid="NUM 10:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 10:26" /> А над дружынай пакаленьня сыноў Асэра князем быў Пагіэль, сын Акрана.<verse eid="NUM 10:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 10:27" /> А над дружынай сыноў Нэфталі князем быў Ахіра, сын Энана.<verse eid="NUM 10:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 10:28" /> Вось такі быў парадак паходу сыноў Ізраіля з дружынамі сваімі, калі выходзілі ў дарогу.<verse eid="NUM 10:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 10:29" /> І сказаў Майсей Хававу, сыну Рэгуэля, Мадыянца, цесьця свайго: «Выпраўляемся мы ў зямлю, якую абяцаў нам даць ГОСПАД. Хадзі з намі, і будзе табе добра з намі, бо ГОСПАД абяцаў дабро Ізраілю».<verse eid="NUM 10:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 10:30" /> Той адказаў яму: «Не пайду я з табой, але вярнуся ў зямлю маю, у якой я нарадзіўся».<verse eid="NUM 10:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 10:31" /> І сказаў [Майсей]: «Не пакідай нас, бо ты ведаеш, у якіх мясцовасьцях пустыні маем мы раскладацца табарам, дык будзеш нашымі вачыма.<verse eid="NUM 10:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 10:32" /> Калі пойдзеш з намі, то што будзе найлепшае з багацьцяў, якія дасьць нам ГОСПАД, дамо табе».<verse eid="NUM 10:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 10:33" /> І выправіліся яны з гары ГОСПАДА, і ішлі на працягу трох дзён. Каўчэг Запавету ГОСПАДАВАГА ішоў наперадзе іх на працягу трох дзён, выбіраючы месца на табар.<verse eid="NUM 10:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 10:34" /> Воблака ГОСПАДАВА ацяняла іх днём, калі яны выходзілі з табару.<verse eid="NUM 10:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 10:35" /> Калі вырушаў Каўчэг у дарогу, Майсей казаў: «Паўстань, ГОСПАДЗЕ, і няай разьбягуцца ворагі Твае, і няхай паўцякаюць тыя, што зьненавідзелі Цябе, перад абліччам Тваім».<verse eid="NUM 10:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 10:36" /> А калі стаўлялі Каўчэг, казаў: «Вярніся, ГОСПАДЗЕ, да шматлікага войска Ізраільскага!»<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="cl">Лікі 11</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 11:1" /> І пачаў народ наракаць на ГОСПАДА, як бы стогнучы ад вялікага гора. Калі пачуў гэта ГОСПАД, разгневаўся, і ўзгарэўся на іх, як агонь, гнеў ГОСПАДА, i зьнішчыў крайнюю частку табара.<verse eid="NUM 11:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 11:2" /> Тады народ стаў клікаць Майсея, і Майсей маліў ГОСПАДА, і агонь спыніўся.<verse eid="NUM 11:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 11:3" /> І назвалі тое месца Табэра, таму што ўзгарэўся супраць іх агонь ГОСПАДАЎ.<verse eid="NUM 11:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 11:4" /> Іншапляменныя людзі, якія былі паміж імі, сталі адчуваць нястачу, і разам з імі сыны Ізраіля плакалі і наракалі: «Хто дасьць нам наесьціся мяса?<verse eid="NUM 11:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 11:5" /> Мы памятаем, як у Эгіпце мы елі дарма рыбу. Памятаем агуркі, дыні, цыбулю і часнык.<verse eid="NUM 11:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 11:6" /> Горла нашае ссохла, нічога іншага ня бачаць вочы нашыя, апрача манны».<verse eid="NUM 11:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 11:7" /> Манна ж была падобная да насеньня каляндры i мела выгляд як бдалах.<verse eid="NUM 11:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 11:8" /> Людзі выходзілі і зьбіралі яе, і малолі ў жорнах або таўклі ў ступе i варылі ў гаршчках, і рабілі з яе аладкі; і смак іх быў падобны да аладак з алеем.<verse eid="NUM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 11:9" /> Калі ноччу раса ападала на табар, адначасова ападала і манна.<verse eid="NUM 11:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 11:10" /> Вось жа Майсей чуў, як народ плача і наракае сем’ямі, кожны каля ўваходу ў намёт свой. І вельмі ўзгарэўся гнеў ГОСПАДА, і гэта невыносным было Майсею.<verse eid="NUM 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 11:11" /> І сказаў Майсей ГОСПАДУ: «Чаму Ты мучыш слугу Твайго? Чаму не магу я знайсьці ласкі ў Цябе? І чаму Ты ўсклаў на мяне ўвесь цяжар народу гэтага?<verse eid="NUM 11:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 11:12" /> Ці ж з мяне пачаўся ўвесь народ гэты або з мяне нарадзіўся, што Ты кажаш мне: “Насі яго ў сэрцы тваім, як носiць карміцелька дзіцятка, і занясі яго ў зямлю, якую запрысяг Ты бацькам нашым”?<verse eid="NUM 11:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 11:13" /> Адкуль узяць мне мяса, каб даць усяму народу гэтаму? З плачам наракаюць на мяне, кажучы: “Дай нам мяса, каб маглі наесьціся!”<verse eid="NUM 11:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 11:14" /> Не магу адзін насіць увесь гэты народ, бо ён зацяжкі для мяне.<verse eid="NUM 11:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 11:15" /> Калі Ты такім чынам абыходзішся са мною, дык прашу, забі мяне, калі маю ласку ў вачах Тваіх, каб ня бачыў я болей няшчасьця майго!»<verse eid="NUM 11:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 11:16" /> І сказаў ГОСПАД Майсею: «Скліч Мне семдзясят чалавек спасярод старшыняў Ізраіля, пра якіх ты ведаеш, што яны людзі разважныя і ўмеюць кіраваць, і прывядзі іх у Намёт Спатканьня. Няхай там яны стаяць разам з табой,<verse eid="NUM 11:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 11:17" /> а Я зыйду і буду гаварыць з табою. Вазьму тады з духа твайго і перадам ім, каб яны разам з табою насілі цяжар народу, а ня толькі ты быў ім абцяжараны.<verse eid="NUM 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 11:18" /> А народу скажы: “Ачысьцьцеся, заўтра будзеце есьці мяса, бо Я пачуў плач ваш: ‘Хто дасьць нам есьці мяса? Добра было нам у Эгіпце’. Вось жа дасьць вам ГОСПАД мяса, і будзеце есьці,<verse eid="NUM 11:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 11:19" /> і не адзін дзень, ані два або пяць, або дзесяць, ані дваццаць нават,<verse eid="NUM 11:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 11:20" /> але ўвесь месяц, аж пакуль вам ня выйдзе праз ноздры вашыя і не абрыдзіць вам, бо адвярнуліся вы ад ГОСПАДА, Які сярод вас, і наракалі на Яго, кажучы: ‘Чаму выходзілі мы з Эгіпту?’”»<verse eid="NUM 11:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 11:21" /> І сказаў Майсей: «Шэсьцьсот тысячаў пешых у гэтым народзе, а Ты кажаш: “Я дам ім есьці мяса цэлы месяц”?<verse eid="NUM 11:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 11:22" /> Ці ж усе авечкі і валы будуць забітыя, каб хапіла ім наесьціся? Або ці ўсе рыбы ў моры зьбяруцца ў адно, каб ім хапіла?»<verse eid="NUM 11:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 11:23" /> Адказаў яму ГОСПАД: «Ці ж рука ГОСПАДА скарацілася? Цяпер убачыш, ці слова Маё спаўняецца на справе, ці не».<verse eid="NUM 11:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 11:24" /> І выйшаў Майсей, і абвясьціў народу словы ГОСПАДА, і склікаў семдзясят старшыняў народу, і паставіў іх вакол Сялібы.<verse eid="NUM 11:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 11:25" /> А ГОСПАД зыйшоў у воблаку і гаварыў з ім, і ўзяў з духа, які быў на Майсею, і перадаў сямідзесяці старшыням. І калі дух супачыў на іх, праракавалі яны, а потым перасталі.<verse eid="NUM 11:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 11:26" /> Два чалавекі засталіся ў табары, адзін зваўся Эльдад, а другі — Мэдад. На іх таксама зыйшоў дух, бо былі яны пакліканыя, толькі не пайшлі ў Намёт. Калі яны праракавалі ў табары,<verse eid="NUM 11:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 11:27" /> прыбег юнак да Майсея і паведаміў яму: «Эльдад і Мэдад праракуюць у табары».<verse eid="NUM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 11:28" /> Егошуа, сын Нуна, які ад юнацтва свайго быў на паслузе ў Майсея, сказаў: «Гаспадару мой, Майсей, забарані ім!»<verse eid="NUM 11:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 11:29" /> Але Майсей адказаў: «Ці не зайздросны ты замест мяне? О, каб увесь народ так праракаваў і каб даў ім ГОСПАД Духа Свайго!»<verse eid="NUM 11:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 11:30" /> Пасьля Майсей і старшыні Ізраіля вярнуліся ў табар.<verse eid="NUM 11:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 11:31" /> Раптам падняўся вецер ад ГОСПАДА і прынёс ад мора перапёлак, і кінуў іх на табар з абодвух бакоў на дзень дарогі, і пакрылі яны зямлю на два локці вышыні.<verse eid="NUM 11:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 11:32" /> І паўстаў народ, і ўвесь той дзень ды ўсю ноч, і ўвесь наступны дзень зьбіралі перапёлак; хто мала сабраў, прынёс ня менш дзесяці гомараў; і разлажылі іх навакол табару.<verse eid="NUM 11:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 11:33" /> Яшчэ мяса было ў зубах іхніх і не было яшчэ зьедзена, калі зноў узгарэўся гнеў ГОСПАДА супраць народу і ўдарыў яго ГОСПАД плягаю дужа вялікай.<verse eid="NUM 11:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 11:34" /> Дзеля таго тое месца названа Кіброт-Гатава, бо там пахавалі прагавіты народ.<verse eid="NUM 11:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 11:35" /> Выйшаўшы з Кіброт-Гатавы, яны прыйшлі ў Гацэрот і там затрымаліся.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="cl">Лікі 12</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 12:1" />Мірыям і Аарон блага гаварылі супраць Майсея з прычыны Кушыткі, якую ён узяў за жонку,<verse eid="NUM 12:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 12:2" /> і казалі: «Ці ж толькі праз аднаго Майсея гаварыў ГОСПАД? Ці таксама і праз нас не гаварыў Ён?» І пачуў гэта ГОСПАД.<verse eid="NUM 12:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 12:3" /> Майсей жа быў найпакарнейшым з усіх людзей, якія жылі на зямлі.<verse eid="NUM 12:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 12:4" /> І сказаў раптам ГОСПАД да Майсея і да Аарона, і да Мірыям: «Толькі вы трое падыйдзіце да Намёту Спатканьня». І падыйшлі ўсе трое.<verse eid="NUM 12:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 12:5" /> І ГОСПАД зыйшоў у слупе воблачным і затрымаўся каля ўваходу, і паклікаў Аарона і Міріям, і ўвайшлі яны абое.<verse eid="NUM 12:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 12:6" /> І сказаў Ён ім: «Слухайце словы Мае. Калі хто спаміж вас будзе прарок ГОСПАДАЎ, Я аб’яўлюся яму ў зьяве, і ў снах буду казаць яму.<verse eid="NUM 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 12:7" /> Але ня так са слугой Маім Майсеем, ён — найвярнейшы ў-ва ўсім доме Маім!<verse eid="NUM 12:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 12:8" /> Вуснамі ў вусны Я кажу яму, і адкрыта, а не праз відзежы і зьявы, бачыць ён ГОСПАДА! Дык чаму адважыліся вы дакараць слугу Майго Майсея?»<verse eid="NUM 12:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 12:9" /> І загневаўся на іх, і адыйшоў.<verse eid="NUM 12:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 12:10" /> І воблака зьнікла, а яно было над Сялібай. І вось Мірыям сталася ў момант белая, як сьнег, ад праказы. Калі Аарон павярнуўся да яе, спасьцярог, што яна пракажоная.<verse eid="NUM 12:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 12:11" /> Тады прасіў ён Майсея: «Прашу, гаспадару мой, не карай нас за грэх, якога мы неразважна дапусьціліся.<verse eid="NUM 12:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 12:12" /> Не дапусьці, каб сталася яна, як спарон, які напалову гнілы выходзіць з улоньня маці сваёй».<verse eid="NUM 12:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 12:13" /> Дык прасіў Майсей ГОСПАДА: «Божа, прашу Цябе, аздараві яе!»<verse eid="NUM 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 12:14" /> І адказаў яму ГОСПАД: «Калі б бацька яе плюнуў ёй у твар, ці ня мусіла б яна сем дзён сароміцца? Так мае яна на сем дзён быць па-за табарам, а потым можа зноў вярнуцца».<verse eid="NUM 12:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 12:15" /> І выдалена была Мірыям па-за табар на сем дзён, а народ ня рухаўся з таго месца, пакуль Мірыям не вярнулася.<verse eid="NUM 12:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 12:16" /> Пасьля народ выйшаў з Гацэроту і разлажыўся табарам у пустыні Паран.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="cl">Лікі 13</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 13:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 13:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 13:2" /> «Пашлі людзей, якія выведаюць зямлю Ханаан, якую Я маю даць сынам Ізраіля, па адным з кожнага пакаленьня бацькоў іхніх».<verse eid="NUM 13:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 13:3" /> Што ГОСПАД загадаў, тое і зрабіў Майсей; і паслаў іх Майсей з пустыні Паран, а ўсе яны князі ў сыноў Ізраіля.<verse eid="NUM 13:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 13:4" /> Вось імёны іхнія: з пакаленьня Рубэна — Шамуа, сын Закура;<verse eid="NUM 13:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 13:5" /> з пакаленьня Сымона — Шафат, сын Харэя;<verse eid="NUM 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 13:6" /> з пакаленьня Юды — Халеў, сын Ефунны;<verse eid="NUM 13:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 13:7" /> з пакаленьня Ісахара — Ігаль, сын Язэпа;<verse eid="NUM 13:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 13:8" /> з пакаленьня Эфраіма — Ошэа, сын Нуна;<verse eid="NUM 13:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 13:9" /> з пакаленьня Бэн’яміна — Пальцы, сын Рафу;<verse eid="NUM 13:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 13:10" /> з пакаленьня Завулёна — Гадыэль, сын Соды,<verse eid="NUM 13:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 13:11" /> з пакаленьня Язэпа, пакаленьня Манасы — Гады, сын Сусі,<verse eid="NUM 13:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 13:12" /> з пакаленьня Дана — Аміэль, сын Гемальлі,<verse eid="NUM 13:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 13:13" /> з пакаленьня Асэра — Сэтур, сын Мікаэля,<verse eid="NUM 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 13:14" /> з пакаленьня Нэфталі — Нагбі, сын Вафшы,<verse eid="NUM 13:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 13:15" /> з пакаленьня Гада — Геўэль, сын Махі.<verse eid="NUM 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 13:16" /> Гэта вось імёны мужчынаў, пасланых Майсеем для выведваньня зямлі [Ханаан]. Ошэа, сына Нуна, назваў Майсей потым Егошуа.<verse eid="NUM 13:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 13:17" /> Пасылаючы іх дзеля выведваньня зямлі Ханаан, Майсей сказаў ім: «Ідзіце праз Нэгеў. Калі прыйдзеце ў горы,<verse eid="NUM 13:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 13:18" /> разгледзьце зямлю, якая яна, і народ, жыхароў той зямлі, ці моцны ён, ці кволы, ці нямногія лікам, ці шматлікія?<verse eid="NUM 13:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 13:19" /> І сама зямля ці добрая, ці ліхая? Якія гарады: ці абмураваныя, ці без муроў?<verse eid="NUM 13:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 13:20" /> Ці глеба ўрадлівая, ці пустая, заросшая дрэвамі, ці бяз дрэваў. Будзьце адважнымі і прынясіце нам пладоў той зямлі». Быў жа час дасьпяваньня вінаграду.<verse eid="NUM 13:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 13:21" /> Яны пайшлі і выведалі зямлю ад пустыні Сін аж па Рэгоў паблізу Хамату.<verse eid="NUM 13:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 13:22" /> І дайшлі да Нэгеву, а адтуль прыйшлі ў Хеўрон, дзе жылі Ахіман, і Шэшай, і Тальмай, сыны Анака. А Хеўрон пабудаваны на сем гадоў раней, чым Цаан, горад Эгіпецкі.<verse eid="NUM 13:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 13:23" /> Дайшлі яны аж да даліны Эшколь, там зрэзалі вінаградную галінку з гронкай вінаграду, якую несьлі на жэрдцы два мужчыны. Узялі таксама яблыкаў гранатавых і фігаў і несьлі з таго месца.<verse eid="NUM 13:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 13:24" /> І назвалі яго далінай Эшколь, таму што адтуль сыны Ізраіля несьлі гронку вінаграду.<verse eid="NUM 13:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 13:25" /> І вярнуліся выведчыкі зямлі праз сорак дзён, абыйшоўшы ўвесь тот край.<verse eid="NUM 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 13:26" /> І прыйшлі да Майсея і Аарона, і ўсей супольнасьці сыноў Ізраіля ў пустыню Паран, у Кадэш. І расказвалі ім, і паказалі плады той зямлі ўсім сабраным.<verse eid="NUM 13:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 13:27" /> І так вось расказвалі: «Прыйшлі мы ў зямлю, у якую паслаў ты нас, якая сапраўды ацякае малаком і мёдам, як можаш пераканацца з гэтых пладоў.<verse eid="NUM 13:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 13:28" /> Але жыхароў мае яна дужых і гарады вялікія і ўмацаваныя. Бачылі мы там таксама сыноў Анака.<verse eid="NUM 13:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 13:29" /> Амалекцы жывуць у Нэгеве; Хеты, і Евусэі, і Амарэйцы — у гарах, а Хананейцы жывуць каля мора і на берагах Ярдану».<verse eid="NUM 13:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 13:30" /> Халеў супакойваў абурэньне народу супраць Майсея, кажучы: «Пойдзем і здабудзем зямлю, бо мы можам авалодаць ёю».<verse eid="NUM 13:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 13:31" /> А іншыя, якія былі з ім, казалі: «Ніякім чынам ня зможам ваяваць з тым народам, бо ён дужэйшы за нас».<verse eid="NUM 13:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 13:32" /> І гаварылі ліхія весткі пра зямлю, якую аглядалі, паміж сыноў Ізраіля, кажучы: «Зямля, якую мы аглядалі, пажырае жыхароў сваіх, а народ, які мы бачылі, — высокага росту.<verse eid="NUM 13:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 13:33" /> Бачылі мы там волатаў, сыноў Анака, з роду волатаўскага, і ў нашых вачах мы выглядалі як саранча, і такімі ж мы былі ў вачах іхніх».<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="cl">Лікі 14</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 14:1" /> І ўсё зграмаджэньне ў тую ноч плакала ў голас,<verse eid="NUM 14:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 14:2" /> і наракалі на Майсея і Аарона ўсе сыны Ізраіля, і казалі: «Лепш, каб мы былі паўміралі ў Эгіпце, або ў той бязьлюднай пустыні.<verse eid="NUM 14:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 14:3" /> Навошта завёў нас ГОСПАД у гэтую зямлю, каб мы загінулі ад мяча, а жонкі і дзеці нашыя пайшлі ў палон? Ці ня лепш нам вярнуцца ў Эгіпет?»<verse eid="NUM 14:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 14:4" /> І казалі адзін аднаму: «Паставім сабе правадыра і вернемся ў Эгіпет».<verse eid="NUM 14:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 14:5" /> Пачуўшы гэта, Майсей і Аарон упалі ніцма на зямлю перад усёй супольнасьцю сыноў Ізраіля.<verse eid="NUM 14:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 14:6" /> А Егошуа, сын Нуна, і Халеў, сын Ефунны, якія самі аглядалі зямлю, разьдзёрлі шаты свае<verse eid="NUM 14:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 14:7" /> і казалі ўсяму зграмаджэньню сыноў Ізраіля: «Зямля, якую мы абыйшлі, вельмі добрая.<verse eid="NUM 14:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 14:8" /> Калі ласкавы будзе ГОСПАД, то ўвядзе нас у яе і дасьць нам зямлю, якая ацякае малаком і мёдам.<verse eid="NUM 14:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 14:9" /> Не бунтуйцеся супраць ГОСПАДА і не палохайцеся народу той зямлі, бо, як хлеб, мы іх праглынем. Яны ня маюць ніякай абароны, бо ГОСПАД з намі. Ня бойцеся іх».<verse eid="NUM 14:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 14:10" /> Уся супольнасьць з абурэньнем гаманіла і хацела іх укаменаваць, калі над Намётам Спатканьня зьявілася хвала ГОСПАДА перад абліччам усіх сыноў Ізраіля.<verse eid="NUM 14:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 14:11" /> І прамовіў ГОСПАД да Майсея: «Дакуль будзе зьневажаць Мяне народ гэты? Дакуль жа ня будзе ён верыць усім знакам, якія Я ўчыніў перад ім?<verse eid="NUM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 14:12" /> Я адведаю іх пошасьцю і зусім выгублю. А з цябе Я зраблю вялікі народ, мацнейшы за іх».<verse eid="NUM 14:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 14:13" /> І сказаў Майсей ГОСПАДУ: «Вось жа пачуюць Эгіпцяне, ад якіх Ты вывеў народ гэты магутнасьцю Тваёй,<verse eid="NUM 14:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 14:14" /> і будуць пра гэта казаць жыхарам зямлі, якія чулі, што Ты, ГОСПАДЗЕ, даешся бачыць Сябе тварам у твар, і воблака Тваё стаіць над імі, і Ты ідзеш перад імі днём у слупе воблачным, а ноччу — у слупе вогненным.<verse eid="NUM 14:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 14:15" /> Дык калі гэты народ выб’еш да апошняга чалавека, народы, якія пра гэта пачуюць, скажуць пра Цябе:<verse eid="NUM 14:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 14:16" /> “ГОСПАД ня мог увесьці народ у зямлю, якую ім запрысяг, дзеля таго Ён выбіў іх у пустыні!”<verse eid="NUM 14:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 14:17" /> Дык няхай праславіцца моц Госпада, як Ты запрысяг, кажучы:<verse eid="NUM 14:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 14:18" /> “ГОСПАД цярплівы і бязьмежнай міласэрнасьці, Які прабачае правіны і грахі і не пакідае без пакараньня, але карае беззаконьні бацькоў на сынах да трэйцяга, а нават да чацьвёртага пакаленьня”.<verse eid="NUM 14:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 14:19" /> Дык даруй правіну народу гэтаму дзеля вялікай ласкавасьці Тваёй, як Ты прабачаў народу гэтаму ад Эгіпту аж дасюль».<verse eid="NUM 14:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 14:20" /> І сказаў ГОСПАД: «Вось, Я прабачаю паводле слова твайго.<verse eid="NUM 14:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 14:21" /> Але, як Я жывы, слава ГОСПАДА напоўніць усю зямлю!<verse eid="NUM 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 14:22" /> Усе людзі, якія бачылі славу Маю і знакі, якія чыніў Я ў Эгіпце і ў пустыні, але ўсё ж такі спакушалі Мяне ўжо дзесяць разоў і ня слухалі голасу Майго,<verse eid="NUM 14:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 14:23" /> не пабачаць яны зямлі, якую запрысяг Я бацькам іхнім, і ніхто з тых, хто зьневажаў Мяне, ня будзе аглядаць яе.<verse eid="NUM 14:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 14:24" /> Толькі слугу Майго Халева, поўнага іншага духа, які ідзе за Мною, увяду Я ў тую зямлю, у якую ён ўжо ўвайшоў, і насеньне ягонае авалодае ёю.<verse eid="NUM 14:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 14:25" /> Няхай Амалек і Хананейцы жывуць у далінах. Заўтра падымеце табар і вернецеся ў пустыню ў накірунку Мора Чырвонага».<verse eid="NUM 14:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 14:26" /> І сказаў ГОСПАД Майсею і Аарону:<verse eid="NUM 14:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 14:27" /> «Дакуль гэтая грамада ліхая будзе наракаць на Мяне? Чуў Я нараканьні сыноў Ізраіля.<verse eid="NUM 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 14:28" /> Дык скажы ім: “Жыву Я, кажа ГОСПАД. Як вы гаварылі, Я пачуў, і гэтак зраблю вам!<verse eid="NUM 14:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 14:29" /> У гэтай пустыні пападаюць трупы вашыя! Усе, што наракалі на Мяне, ад дваццаці гадоў і вышэй, палічаны.<verse eid="NUM 14:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 14:30" /> Ня ўвойдзеце вы ў зямлю, на якой Я, падымаючы руку Маю, запрысяг пасяліць вас, апрача Халева, сына Ефунны, і Егошуа, сына Нуна.<verse eid="NUM 14:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 14:31" /> А дзяцей вашых, пра якіх вы казалі, што яны будуць здабычай ворагаў, Я ўвяду, каб аглядалі зямлю, якою вы ўзгардзілі.<verse eid="NUM 14:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 14:32" /> Што да вас, то вашыя трупы будуць ляжаць у гэтай пустыні.<verse eid="NUM 14:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 14:33" /> А сыны вашыя будуць блукаць у пустыні сорак гадоў і будуць цярпець за нявернасьць вашую, пакуль ня счэзнуць трупы вашыя ў пустыні.<verse eid="NUM 14:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 14:34" /> Па ліку сарака дзён, на працягу якіх аглядалі вы зямлю, год будзе залічаны за дзень, значыць, сорак гадоў вы будзеце пакутаваць за грахі вашыя і даведаецеся, што такое, калі Я пакінуў вас.<verse eid="NUM 14:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 14:35" /> Я, ГОСПАД, сказаў і гэтак зраблю гэтаму ліхому зграмаджэньню, якое бунтуецца супраць Мяне. У гэтай пустыні вы загінеце і памрэцё».<verse eid="NUM 14:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 14:36" /> І вось усе тыя людзі, якіх паслаў Майсей на выведваньне зямлі, і якія, вярнуўшыся, схілілі ўсю супольнасьць да нараканьня, падаючы ліхія весткі пра зямлю,<verse eid="NUM 14:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 14:37" /> тыя, што разносілі ліхія весткі пра зямлю тую, памерлі раптоўна ў прысутнасьці ГОСПАДА.<verse eid="NUM 14:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 14:38" /> Але Егошуа, сын Нуна, і Халеў, сын Ефунны, засталіся жывымі з усіх тых людзей, якія хадзілі выведваць зямлю.<verse eid="NUM 14:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 14:39" /> Усе гэтыя словы пераказаў Майсей усім сынам Ізраіля, і народ вельмі засмуціўся.<verse eid="NUM 14:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 14:40" /> Устаўшы назаўтра рана, узыйшлі яны на вяршыню гары і казалі: «Гатовыя мы пайсьці ў зямлю, пра якую казаў ГОСПАД, бо бачым, што мы саграшылі».<verse eid="NUM 14:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 14:41" /> Майсей сказаў ім: «Чаму вы пераступаеце волю ГОСПАДА? Гэта ня будзе мець посьпеху.<verse eid="NUM 14:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 14:42" /> Не ідзіце, бо няма ГОСПАДА з вамі, каб не пагінулі вы ад ворагаў вашых!<verse eid="NUM 14:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 14:43" /> Амалек вось і Хананейцы перад вамі, ад мяча іхняга пагінеце, таму што вы адступіліся ад ГОСПАДА, і ня будзе з вамі ГОСПАДА».<verse eid="NUM 14:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 14:44" /> Але яны вырашылі ўзыйсьці на вяршыню гары; а Каўчэг Запавету ГОСПАДА і Майсей ня выйшлі з табару.<verse eid="NUM 14:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 14:45" /> Тады зыйшлі Амалекцы і Хананейцы, што жылi на гары, і разьбілі іх, і гналі іх аж да Хармы.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="cl">Лікі 15</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 15:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 15:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 15:2" /> «Паведамі сынам Ізраіля і скажы ім: “Калі ўвойдзеце ў зямлю пражываньня вашага, якую Я дам вам,<verse eid="NUM 15:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 15:3" /> і будзеце складаць ахвяры ГОСПАДУ, цэласпаленьні або як спаўненьне шлюбаваньняў, або дабравольна прыносячы дары, або пры ўрачыстасьцях вашых, каб прынесьці мілы пах ГОСПАДУ з валоў ці авечак,<verse eid="NUM 15:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 15:4" /> тады той, хто прыносіць ахвяру сваю ГОСПАДУ, павенен прынесьці ў ахвяру хлебную дзясятую частку эфы пшанічнай мукі, запраўленай адной трэйцяй гіну алею.<verse eid="NUM 15:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 15:5" /> Як ахвяру вадкую павінен даць разам з ахвярай цэласпаленьня або з ахвярай мірнай чацьвёртую частку гіну віна на кожнае ягня.<verse eid="NUM 15:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 15:6" /> Разам з ахвярай з ягняці складзеш дзьве трэці эфы пшанічнай мукі, запраўленай адной трэцяй гіну алею.<verse eid="NUM 15:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 15:7" /> Поруч у ахвяру вадкую з віна адну трэйцюю гіну прынясеш на мілы пах ГОСПАДУ.<verse eid="NUM 15:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 15:8" /> Калі складаеш у ахвяру цяля на цэласпаленьне або ў ахвяру як спаўненьне шлюбаваньня, або ў ахвяру мірную ГОСПАДУ,<verse eid="NUM 15:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 15:9" /> дасі разам з цялём у ахвяру хлебную тры дзясятыя часткі эфы пшанічнай мукі, запраўленай паловай гіну алею,<verse eid="NUM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 15:10" /> а ў ахвяру вадкую дасі палову гіну віна на мілы пах ГОСПАДУ.<verse eid="NUM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 15:11" /> Так трэба рабіць пры кожнай ахвяры з цяляці або ягняці як з авечак, так і з козаў.<verse eid="NUM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 15:12" /> Паводле ліку ахвяраў, якія вы складаеце, так рабеце пры кожнай, паводле лічбы іх.<verse eid="NUM 15:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 15:13" /> Кожны тутэйшы так павінен рабіць гэта, складаючы ахвяру на мілы пах ГОСПАДУ.<verse eid="NUM 15:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 15:14" /> Калі б які чужынец, якi жыве ў вас, або які пасяліўся сярод вас, хацеў бы скласьці ахвяру на мілы пах ГОСПАДУ, павінен складаць яе, як і вы.<verse eid="NUM 15:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 15:15" /> Адна пастанова для вас і для прыханяў у-ва ўсе пакаленьні вашыя; як вы, так і прыхадзень будзе перад ГОСПАДАМ.<verse eid="NUM 15:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 15:16" /> Адзін закон і тая самая пастанова як для вас, так і для прыхадняў, якiя пражываюць у вас”».<verse eid="NUM 15:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 15:17" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 15:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 15:18" /> «Аб’яві сынам Ізраіля і скажы ім: “Калі вы прыйдзеце ў зямлю, якую Я вам дам,<verse eid="NUM 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 15:19" /> і калі будзеце есьці хлеб з той зямлі, то выдзяліце перш асаблівы дар ГОСПАДУ.<verse eid="NUM 15:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 15:20" /> Ад першага цеста вашага печыва прынясіце як асаблівы дар з току.<verse eid="NUM 15:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 15:21" /> Будзеце складаць пяршыны цеста як асаблівы дар ГОСПАДУ ў-ва ўсе пакаленьні вашыя.<verse eid="NUM 15:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 15:22" /> Калі праз няведаньне вы ня споўніце ўсіх гэтых загадаў, якія перадаў ГОСПАД праз Майсея,<verse eid="NUM 15:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 15:23" /> таго ўсяго, што загадаў ГОСПАД праз Майсея, ад дня, у які ГОСПАД загадаў гэта, ды праз усе будучыя пакаленьні вашыя,<verse eid="NUM 15:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 15:24" /> і забудзе зрабіць гэтае супольнасьць, то павінна ўся супольнасьць скласьці ў ахвяру цялёя ў цэласпаленьне на мілы пах ГОСПАДУ; да таго адпаведную прадпісаньнем закону ахвяру хлебную і вадкую, і казла ў ахвяру за грэх.<verse eid="NUM 15:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 15:25" /> Сьвятар ачысьціць усю супольнасьць сыноў Ізраіля і будзе ім адпушчана, бо было гэта зроблена па няведаньні, і яны склалі ахвяру цэласпаленьня і ахвяру за грэх перад абліччам ГОСПАДА за няўвагу сваю.<verse eid="NUM 15:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 15:26" /> І будзе ўсёй супольнасьці адпушчана, а таксама чужынцам, якiя жывуць сярод іх, бо гэта быў грэх па няведаньні ўсяго народу.<verse eid="NUM 15:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 15:27" /> Калі хто адзін саграшыць па няведаньні, няхай прынясе аднагадовую казу ў ахвяру за грэх.<verse eid="NUM 15:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 15:28" /> І сьвятар ачысьціць душу, што па няведаньні саграшыла перад ГОСПАДАМ, і будзе яна ачышчаная, i атрымае адпушчэньне.<verse eid="NUM 15:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 15:29" /> Адзін закон для ўсіх, як для тутэйшых, так і для чужынцаў, для тых, хто саграшыць па няведаньні.<verse eid="NUM 15:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 15:30" /> Калі б хто з тутэйшых або з прыхадняў зрабіў гэта сьвядома, то ён зьневажае ГОСПАДА, і будзе вынішчана душа тая спаміж народу свайго,<verse eid="NUM 15:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 15:31" /> бо ён узгардзіў словам ГОСПАДА і парушыў прыказаньне Ягонае. Такі будзе пакараны і панясе адказнасьць за грэх свой”».<verse eid="NUM 15:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 15:32" /> І сталася, калі сыны Ізраіля былі ў пустыні, вось, напаткалі яны чалавека, які зьбіраў дровы ў дзень суботы.<verse eid="NUM 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 15:33" /> І прывялі яго да Майсея і Аарона, і да ўсёй супольнасьці.<verse eid="NUM 15:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 15:34" /> Яны затрымалі яго пад вартай, ня ведаючы, што з ім павінны зрабіць.<verse eid="NUM 15:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 15:35" /> І ГОСПАД сказаў Майсею: «Гэты чалавек павінен памерці. Няхай уся грамада ўкамянуе яго за табарам».<verse eid="NUM 15:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 15:36" /> І вывелі яго за табар, і ўкаменавалі яго, як загадаў ГОСПАД, і ён памёр.<verse eid="NUM 15:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 15:37" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 15:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 15:38" /> «Аб’яві сынам Ізраіля і скажы ім, каб яны зрабілі сабе фрэнзьлі на краях шатаў сваіх і ўклалі ў іх ніткі з фіялетавага пурпуру.<verse eid="NUM 15:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 15:39" /> Калі іх убачыце, узгадаеце ўсе прыказаньні ГОСПАДА, каб споўніць іх ды каб не ісьці вам за пажаданьнямі сэрца вашага і вачэй, якія валакуць вас у распуснасьць,<verse eid="NUM 15:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 15:40" /> каб вы памяталі ўсе прыказаньні Мае і спаўнялі іх, і так былі сьвятымі перад Богам вашым.<verse eid="NUM 15:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 15:41" /> Я — ГОСПАД, Бог ваш, Які вывеў вас з зямлі Эгіпецкай, каб быць Богам вашым. Я — ГОСПАД, Бог ваш!»<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="cl">Лікі 16</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 16:1" /> Вось жа Карах, сын Іцгара, сына Кегата, сына Левія, а таксама Датан і Абірам, сыны Эліява, і Он, сын Пэлета, з сыноў Рубэна,<verse eid="NUM 16:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 16:2" /> паўсталі супраць Майсея разам з іншымі сынамі Ізраіля, у лічбе двухсот пяцідзесяці чалавек, начальнікі супольнасьці, прадстаўнікі народу, людзі слаўныя.<verse eid="NUM 16:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 16:3" /> Выступілі яны супраць Майсея і Аарона і сказалі: «Хопіць вам, бо ўся супольнасьць, усе — сьвятыя, і пасярод іх ёсьць ГОСПАД. Дык чаму вы ставіце сябе вышэй зграмаджэньня ГОСПАДАВАГА?»<verse eid="NUM 16:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 16:4" /> Калі пачуў гэта Майсей, упаў вобліч.<verse eid="NUM 16:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 16:5" /> І сказаў Караху ды ўсяму сходу: «Заўтра пакажа ГОСПАД, хто да Яго належыць, і хто сьвяты, i сьвятых прытуліць да Сябе; і каго Ён выбярэ, таго Ён наблізіць да Сябе.<verse eid="NUM 16:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 16:6" /> Дык вось што зрабіце: Няхай Карах і ўсе яго супольнікі возьмуць кадзільніцы свае,<verse eid="NUM 16:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 16:7" /> і няхай у іх укладуць агонь, і заўтра пакладуць у іх кадзіла перад ГОСПАДАМ, і каго выбярэ ГОСПАД, той сьвяты. Досыць вам, сыны Левія».<verse eid="NUM 16:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 16:8" /> І сказаў Майсей Караху: «Слухайце, сыны Левія!<verse eid="NUM 16:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 16:9" /> Ці мала вам, што Бог Ізраіля аддзяліў вас спаміж усёй супольнасьці Ізраіля, і выбраў вас Сабе, каб вы служылі Яму ў Сялібе ГОСПАДА, і каб стаялі перад народам, і паслугавалі за іх?<verse eid="NUM 16:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 16:10" /> І Ён дапусьціў цябе да Сябе і ўсіх братоў тваіх, сыноў Левія, а вы дамагаецеся яшчэ сьвятарства,<verse eid="NUM 16:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 16:11" /> i ўсё тваё зборышча выступае супраць ГОСПАДА? Хто такі Аарон, што вы наракаеце супраць яго?»<verse eid="NUM 16:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 16:12" /> І паслаў Майсей паклікаць Датана і Абірама, сыноў Эліява, але яны сказалі: «Ня пойдзем!<verse eid="NUM 16:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 16:13" /> Ці мала табе, што ты вывеў нас з зямлі, якая ацякае малаком і мёдам, каб выгубіць нас у пустыні, і яшчэ хочаш панаваць над намі?<verse eid="NUM 16:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 16:14" /> На самой справе ня ўвёў ты нас у зямлю, якая ацякае малаком і мёдам, і ня даў нам на ўласнасьць палёў і вінаграднікаў! Хочаш вочы людзей засьляпіць? Ня пойдзем!»<verse eid="NUM 16:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 16:15" /> І надта разгневаўся Майсей, і сказаў ГОСПАДУ: «Не прымай ахвяры іхняе! Ніводнаму з іх ня ўзяў я нават асла і нікога з іх я ня скрыўдзіў».<verse eid="NUM 16:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 16:16" /> Потым сказаў Майсей Караху: «Заўтра ты і ўсе супольнікі твае станьце перад ГОСПАДАМ, ты і Аарон – асобна.<verse eid="NUM 16:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 16:17" /> І возьмеце кожны кадзільніцу сваю і пакладзіцё ў іх кадзіла, і прынясіцё перад аблічча ГОСПАДА кожны кадзільніцу сваю, дзьвесьце пяцьдзясят кадзільніцаў; ты і Аарон будзеце трымаць кожны кадзільніцу сваю».<verse eid="NUM 16:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 16:18" /> І кожны ўзяў кадзільніцу сваю, уклаў у яе агонь, насыпаў кадзіла, і сталі яны каля ўваходу ў Намёт Спатканьня, сталі таксама Майсей і Аарон.<verse eid="NUM 16:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 16:19" /> І сабраў Карах супраць іх усё зграмаджэньне каля ўваходу ў Намёт Спатканьня. І зьявілася ўсім слава ГОСПАДАВА.<verse eid="NUM 16:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 16:20" /> І сказаў ГОСПАД Майсею і Аарону:<verse eid="NUM 16:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 16:21" /> «Адлучыцеся ад гэтай грамады, Я іх зьнішчу ў момант».<verse eid="NUM 16:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 16:22" /> Яны тады ўпалі вобліч і малілі: «Божа, Божа, ад Якога залежыць жыцьцё ўсяго жывога, ці Сваім гневам хочаш усіх ахапіць, калі толькі адзін хто саграшыў?»<verse eid="NUM 16:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 16:23" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 16:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 16:24" /> «Загадай усяму народу адыйсьці ад жытлаў Караха, Датана і Абірама».<verse eid="NUM 16:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 16:25" /> Тады ўстаў Майсей і пайшоў да Датана і Абірама, а старшыні Ізраіля пайшлі за ім.<verse eid="NUM 16:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 16:26" /> І сказаў ён тым, што сабраліся: «Адыйдзіце ад намётаў гэтых бязбожных людзей! І не дакранайцеся нічога, што да іх належыць, каб вы не пагінулі праз грахі іхнія!»<verse eid="NUM 16:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 16:27" /> І адыйшліся ўсе ад месца пражываньня Караха, Датана і Абірама. Датан жа і Абірам выйшлі і сталі перад уваходам у намёты свае разам з жонкамі сваімі, сынамі і малымі дзецьмі.<verse eid="NUM 16:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 16:28" /> І сказаў Майсей: «З гэтага даведаецеся, што ГОСПАД паслаў мяне, каб чыніў усё, што бачыце, і што гэта не ад мяне выйшла.<verse eid="NUM 16:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 16:29" /> Калі гэтыя людзі памруць, як усе людзі паміраюць, ды калі лёс іхні будзе такі, які і ў кожнага чалавека, то ГОСПАД не паслаў мяне.<verse eid="NUM 16:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 16:30" /> А калі ГОСПАД учыніць штосьці незвычайнае, што зямля разявіць пашчу сваю і праглыне іх і ўсё, што да іх належыць, і жывыя пападуць яны ў адхлань, то ведайце, што яны блявузгалі на ГОСПАДА».<verse eid="NUM 16:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 16:31" /> І адразу, як перастаў гаварыць, расступілася зямля пад нагамі іхнімі;<verse eid="NUM 16:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 16:32" /> і, раскрыўшы пашчу сваю, праглынула іх разам з сем’ямі іхнімі, усіх людзей Караха з усёй маёмасьцю іхняй.<verse eid="NUM 16:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 16:33" /> І так жывыя папалі яны ў адхлань, і зямля накрыла іх, і былі вынішчаны спаміж супольнасьці.<verse eid="NUM 16:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 16:34" /> Усе ж сыны Ізраіля, якія стаялі навокал, на крык тых, што гінулі, паўцякалі, кажучы: «Каб часам і нас зямля не праглынула».<verse eid="NUM 16:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 16:35" /> І выйшаў агонь ад ГОСПАДА, і спаліў дзьвесьце пяцьдзясят чалавек, якія ахвяроўвалі кадзіла.<verse eid="NUM 16:35" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="cl">Лікі 17</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 17:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 17:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 17:2" /> «Загадай Элеазару, сыну Аарона сьвятара, каб сабраў з пажарышча кадзільніцы, а агонь няхай выкіне з іх куды далей, бо яны асьвячоныя,<verse eid="NUM 17:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 17:3" /> тыя кадзільніцы, сьмерцю грэшнікаў. Няхай з іх зробяць тонкія бляхі на пакрыцьцё ахвярнiка, таму што іх прынесьлі ГОСПАДУ, і яны асьвячаны, ды каб былі яны сынам Ізраіля як перасьцярога».<verse eid="NUM 17:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 17:4" /> І прынёс Элеазар кадзільніцы мядзяныя, якія прынесьлі тыя, што былі спалены, і перарабілі іх на бляху на пакрыцьцё ахвярнiка,<verse eid="NUM 17:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 17:5" /> на памяць сынам Ізраіля, каб ніхто чужы, якi не належыць да нашчадкаў Аарона, не прыносіў кадзіла перад аблічча ГОСПАДА ды не сталася з ім тое, што з Карахам і супольнікамі ягонымі, як казаў яму ГОСПАД праз Майсея.<verse eid="NUM 17:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 17:6" /> Назаўтра ўся супольнасьць сыноў Ізраіля наракала на Майсея і Аарона, кажучы: «Вы выгубілі народ ГОСПАДАЎ».<verse eid="NUM 17:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 17:7" /> І калі сабралася ўся супольнасьць супраць Майсея і Аарона, яны накіраваліся да Намёту Спатканьня. У той час воблака ахутала Намёт і зьявілася слава ГОСПАДА.<verse eid="NUM 17:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 17:8" /> Майсей і Аарон прыйшлі перад Намёт Спатканьня.<verse eid="NUM 17:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 17:9" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 17:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 17:10" /> «Адыйдзіцеся ад грамады гэтай, бо хачу іх выгубіць у момант». Яны тады ўпалі вобліч.<verse eid="NUM 17:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 17:11" /> І сказаў Майсей Аарону: «Вазьмі кадзільніцу i, узяўшы агня з ахвярнiку, улажы кадзіла на верх, i пасьпяшай жвава да народу, каб заступіцца за яго, бо ўзгарэўся гнеў ГОСПАДА, і пачалася кара».<verse eid="NUM 17:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 17:12" /> Калі гэта зрабіў Аарон і прыбег да грамады, ужо пачалася зараза, і ён палажыў кадзіла і заступіўся за народ.<verse eid="NUM 17:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 17:13" /> Ён стаў паміж памёршымі і жывымі, і пляга спынілася.<verse eid="NUM 17:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 17:14" /> А тых, што згінула, было чатырнаццаць тысячаў семсот, апрача памёршых з прычыны Караха.<verse eid="NUM 17:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 17:15" /> Потым вярнуўся Аарон да Майсея да ўваходу ў Намёт Спатканьня, і спынілася пляга.<verse eid="NUM 17:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 17:16" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 17:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 17:17" /> «Скажы сынам Ізраіля і вазьмі ад іх па кію ад кожнага калена, ад усіх князёў пакаленьняў, дванаццаць кіёў. Напішы імя кожнага на кіі.<verse eid="NUM 17:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 17:18" /> А на кіі лявітаў напішы імя Аарона. Будзе па адным кіі на князя кожнага пакаленьня.<verse eid="NUM 17:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 17:19" /> І палажы іх у Намёце Спатканьня перад Каўчэгам Сьведчаньня, дзе Я з табою сустракаюся.<verse eid="NUM 17:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 17:20" /> Каго з іх Я выбяру, таго кій закрасуе, і гэтак спыню Я нараканьні сыноў Ізраіля, якімі яны наракаюць на вас».<verse eid="NUM 17:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 17:21" /> І загадаў Майсей сынам Ізраіля, і далі яму ўсе князі кіі ад кожнага пакаленьня. Было дванаццаць кіёў, і кій Аарона паміж іх.<verse eid="NUM 17:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 17:22" /> Гэтыя кіі палажыў Майсей перад ГОСПАДАМ у Намёце Спатканьня.<verse eid="NUM 17:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 17:23" /> Калі на другі дзень увайшоў Майсей у Намёт Спатканьня, убачыў, што закрасаваў кій Аарона з пакаленьня Левія, выпусьціў пупышкі, закрасаваў і зрадзіў сьпелыя мігдалы.<verse eid="NUM 17:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 17:24" /> І вынес Майсей ад аблічча ГОСПАДА ўсе кіі да усіх сыноў Ізраіля. Яны ўбачылі, і кожны ўзяў кій свой.<verse eid="NUM 17:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 17:25" /> І ГОСПАД сказаў Майсею: «Кій Аарона палажы назад перад Каўчэгам Сьведчаньня, каб захаваўся як знак супраць збунтаваных. Спыні такім чынам нараканьні іх перада Мною, каб не загінулі».<verse eid="NUM 17:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 17:26" /> І Майсей зрабіў, як загадаў яму ГОСПАД.<verse eid="NUM 17:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 17:27" /> І сказалі сыны Ізраіля Майсею: «Мы прападаем, гінем, усе паміраем!<verse eid="NUM 17:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 17:28" /> Хто толькі прыступіцца да Сялібы ГОСПАДА, памірае. Ці ўсе мы да апошняга будзем вынішчаны?»<verse eid="NUM 17:28" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="cl">Лікі 18</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 18:1" /> І сказаў тады ГОСПАД Аарону: «Ты і сыны твае, і дом бацькі твайго з табой будзеце адказныя за праступкі, дапушчаныя ў Сялібе. Ты і сыны твае будзеце адказныя за грахі сьвятарства вашага.<verse eid="NUM 18:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 18:2" /> Вазьмі сабе таксама братоў тваіх, пакаленьне Левія, племя бацькі твайго, няхай будуць яны пры табе і дапамагаюць табе; а ты і сыны твае з табою будзеце пры Намёце Спатканьня.<verse eid="NUM 18:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 18:3" /> Няхай рупяцца яны пра тое, што патрэбнае для цябе і для Сялібы. Але да сьвятых рэчаў і да ахвярнiка ня могуць яны прыступацца, каб не памерлі і яны, і вы разам з імі.<verse eid="NUM 18:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 18:4" /> Няхай будуць яны пры табе і няхай рупяцца пра ўсё адносна Намёту Спатканьня, пра ўсю службу ў Сялібе. Але ніводзін чужынец ня можа набліжацца да вас.<verse eid="NUM 18:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 18:5" /> Вы рупцеся пра абслугу Сялібы ды пра абслугу ахвярнiка, каб не ўзгарэўся зноў гнеў на сыноў Ізраіля.<verse eid="NUM 18:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 18:6" /> Вось жа ўзяў Я братоў вашых, лявітаў, спасярод сыноў Ізраіля і даў іх як дар ГОСПАДУ, каб спаўнялі службу ў Намёце Спатканьня.<verse eid="NUM 18:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 18:7" /> І ты і сыны твае захоўвайце сьвятарства вашае і ўсё, што належыць да абслугі ахвярнiка і месца за заслонай. Я даю вам дар службы сьвятарства, а хто чужы прыступіцца, пакараны будзе сьмерцю».<verse eid="NUM 18:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 18:8" /> І сказаў ГОСПАД Аарону: «Я даручаю табе нагляд за дарамі Маімі. Усе дары, якія пасьвячаюцца сынамі Ізраіля, Я перадаю табе і сынам тваім за служэньне сьвятарскае як закон вечны.<verse eid="NUM 18:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 18:9" /> З дароў найсьвяцейшых, за выключэньнем таго, што будзе спалена, возьмеш сабе кожны дар і ахвяру за грэх, ахвяру хлебную і ахвяру аднагараджэньня, якія Мне прыносяць; як рэчы найсьвяцейшыя будуць яны належаць табе і сынам тваім.<verse eid="NUM 18:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 18:10" /> У месцы найсьвяцейшым будзеш іх есьці; толькі мужчыны могуць есьці гэта, бо гэта сьвятыня для цябе.<verse eid="NUM 18:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 18:11" /> Дары ахвярныя, патрасаныя парад ГОСПАДАМ, якія складаюць сыны Ізраіля, Я даю табе, і сынам тваім, і дочкам тваім як закон вечны; кожны чысты ў доме тваім няхай спажывае іх.<verse eid="NUM 18:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 18:12" /> Табе Я даю ўсё, што найлепшае з алею, усё, што найлепшае з віна і збожжа, якое сыны Ізраіля прыносяць ГОСПАДУ як першыя плады.<verse eid="NUM 18:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 18:13" /> І пяршыны, якія яны прыносяць ГОСПАДУ з усёй іхняй зямлі, належаць табе. Кожны, хто чысты спаміж сям’і тваёй, можа іх спажываць.<verse eid="NUM 18:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 18:14" /> Усё, што заклятае у Ізраілі, тваім будзе.<verse eid="NUM 18:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 18:15" /> Усе першародныя ўлоньня маткі, якія прыносяцца ў ахвяру ГОСПАДУ, ці з людзей, ці з жывёлы, тваімі будуць. Што да людзей першародных і кожнай жывёлы, якая нячыстая, іх трэба выкупіць.<verse eid="NUM 18:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 18:16" /> Выкуп бярэцца праз месяц пасьля нараджэньня ў пяць сыкляў срэбра па вазе сьвятыні; сыкль мае дваццаць гераў.<verse eid="NUM 18:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 18:17" /> Першародных кароваў, авечак і козаў ня будзеш выкупляць, бо яны пасьвячаны ГОСПАДУ. Толькі кроў іхнюю выльеш на ахвярнiк, а тлушч іхні спаліш у агні на мілы пах ГОСПАДУ.<verse eid="NUM 18:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 18:18" /> Мяса іхняе табе належыць, грудзіна патрасаная і правая лапатка будуць тваімі.<verse eid="NUM 18:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 18:19" /> Усе дары сьвятыя, якія ахвяроўваюць сыны Ізраіля ГОСПАДУ, Я даю табе, і сынам тваім, і дочкам тваім як закон вечны. Гэта вечны закон солі перад ГОСПАДАМ для цябе і сыноў тваіх».<verse eid="NUM 18:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 18:20" /> І сказаў ГОСПАД Аарону: «У зямлі іхняй ня будзеш мець ніякай уласнасьці i ня будзеш мець між імі часткі зямлі. Я — частка твая і спадчына твая між сынамі Ізраіля.<verse eid="NUM 18:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 18:21" /> Вось жа сынам Левія Я даю як спадчыну ўсе дзесяціны, складаныя сынамі Ізраіля, за служэньне, якое яны выконваюць для Мяне ў Намёце Спатканьня.<verse eid="NUM 18:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 18:22" /> А сыны Ізраіля не павінны прыступаць да Намёту Спатканьня, каб не дапусьціліся грэху ды не памерлі.<verse eid="NUM 18:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 18:23" /> Адны толькі лявіты могуць выконваць служэньне ў Намёце Спатканьня і несьці на сабе грэх іхні. Гэта закон вечны для нашчадкаў вашых. Лявіты ня будуць мець спадчыны між сынамі Ізраіля,<verse eid="NUM 18:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 18:24" /> бо Я даў лявітам у спадчыну дзесяціны, якія сыны Ізраіля ахвяроўваюць ГОСПАДУ. Дзеля таго сказаў Я ім: “Між сыноў Ізраіля ня будзеце вы мець спадчыны”».<verse eid="NUM 18:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 18:25" /> Пасьля гаварыў ГОСПАД Майсею:<verse eid="NUM 18:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 18:26" /> «Аб’яві лявітам і скажы ім: “Калі вы атрымаеце дзесяціны ад сыноў Ізраіля, якія Я даў вам у спадчыну, то дзясятую частку маеце адкласьці ГОСПАДУ.<verse eid="NUM 18:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 18:27" /> Гэта будзе вам залічана як ахвяра ад збожжа з току або ад таго, што напаўняе тоўчню.<verse eid="NUM 18:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 18:28" /> І вы таксама павінны складаць ГОСПАДУ ахвяры з дзесяцінаў, якія атрымоўваеце ад сыноў Ізраіля; прынясіце іх ГОСПАДУ і дайце сьвятару Аарону.<verse eid="NUM 18:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 18:29" /> З усяго, што атрымліваеце з дзесяцін, выдзеліце дары ГОСПАДУ, і няхай будуць яны найлепшыя і адборныя”.<verse eid="NUM 18:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 18:30" /> І скажы ім: “Калі вы зложыце ў ахвяру з дзесяцінаў што адборнае і найлепшае, то гэта будзе вам залічана як ахвяра з току і з тоўчні.<verse eid="NUM 18:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 18:31" /> Можаце гэта есьці на кожным месцы разам з усімі, хто належыць да сем’яў вашых. Бо гэта плата за службу вашую ў Намёце Спатканьня.<verse eid="NUM 18:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 18:32" /> Калі адберыцё тое, што найлепшае, не саграшыце, і не зьняважыце сьвятых дароў Ізраіля, і не памрыцё”».<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="cl">Лікі 19</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 19:1" /> І сазаў ГОСПАД Майсею і Аарону:<verse eid="NUM 19:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 19:2" /> «Вось пастанова Закону, устаноўленая ГОСПАДАМ. Скажы сынам Ізраіля, няхай прывядуць табе рудую карову без заганы, на якую яшчэ не ўскладана ярмо.<verse eid="NUM 19:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 19:3" /> Аддасьцё яе сьвятару Элеазару, які загадае вывесьці яе за табар, і заб’іцё яе ў прысутнасьці яго.<verse eid="NUM 19:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 19:4" /> Потым Элеазар памочыць палец у крыві ейнай і пакропіць сем разоў уваход Намёту Спатканьня.<verse eid="NUM 19:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 19:5" /> І няхай спаляць цела ейнае ў прысутнасьці яго, а таксама скуру, кроў і нячыстасьць ейную спаляць агнём.<verse eid="NUM 19:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 19:6" /> І няхай возьме сьвятар дровы кедровыя, гізоп разам з ніткамі кармазыновымі i кіне ў агонь, у якім гарыць карова.<verse eid="NUM 19:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 19:7" /> Тады вось, памыўшы шаты свае i цела сваё, увойдзе ён у табар, але нячысты будзе ён аж да вечара.<verse eid="NUM 19:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 19:8" /> І той, хто спальваў карову, няхай памые шаты свае і цела сваё, але нячысты будзе ён аж да вечара.<verse eid="NUM 19:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 19:9" /> Потым чалавек чысты зьбярэ попел каровы і высыпе за табарам у месцы чыстым, каб для супольнасьці Ізраіля быў захаваны для прыгатаваньня вады ачышчэньня. Гэта ахвяра за грэх.<verse eid="NUM 19:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 19:10" /> Той, хто зьбіраў попел каровы, павінен вымыць адзеньне сваё і будзе нячысты аж да вечара. Гэта пастанова вечная як для Ізраільцянаў, так і для чужынцаў, якія ў іх жывуць.<verse eid="NUM 19:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 19:11" /> Хто дакранецца нябожчыка, будзе дзеля таго сем дзён нячысты.<verse eid="NUM 19:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 19:12" /> Павінен ён [вадой з попелу каровы] ачысьціцца ў трэйці і сёмы дзень, і тады будзе чысты. Калі ў трэйці дзень і ў сёмы дзень ня будзе ачышчаны, ня будзе чысты.<verse eid="NUM 19:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 19:13" /> Кожны, хто дакрануўся мёртвага цела нейкага чалавека памёршага i не ачысьціўся, зьневажае Сялібу ГОСПАДА; будзе вынішчана душа тая з Ізраіля. Ён не акрапіў сябе вадою ачышчэньня, дык нячысты ён будзе, і нячыстасьць ягоная застанецца на ім.<verse eid="NUM 19:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 19:14" /> Гэткі вось закон адносна чалавека, які памёр у намёце: кожны, хто ўвойдзе ў гэты намёт, і хто ў ім знаходзіцца, будзе нячысты сем дзён.<verse eid="NUM 19:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 19:15" /> Таксама кожная пасудзіна адкрытая, якая ня мае накрыўкі, прымацаванай на шнурку, будзе нячыстай.<verse eid="NUM 19:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 19:16" /> Падобна будзе нячыстым сем дзён той, хто на адкрытым полі дакранецца або забітага мячом, або памёршага, або костак людзкіх, або магілы.<verse eid="NUM 19:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 19:17" /> Для нячыстага няхай возьмуць попелу той спаленай ахвяры за грэх і няхай нальюць на яго жывой вады ў посуд.<verse eid="NUM 19:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 19:18" /> Няхай чалавек чысты возьме гізоп, памочыць яго ў вадзе і пакропіць намёт, і ўвесь посуд, і людзей, якія знаходзяцца ў ім, наастатак таго, хто дакрануўся костак, або забітага, або памёршага, або магілы.<verse eid="NUM 19:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 19:19" /> І пакропіць чалавек чысты таго, хто нячысты, у трэйці і сёмы дзень, і так ачысьціць яго ў сёмы дзень. Чалавек [нячысты] памые сябе і адзеньне сваё вадой, i вечарам будзе чысты.<verse eid="NUM 19:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 19:20" /> Але калі хто ў гэты спосаб ня быў ачышчаны, то будзе зьнішчана душа яго спаміж супольнасьці, бо ён апаганіў Сялібу ГОСПАДА; вадою ачышчэньня ён не абмыты, ён — нячысты.<verse eid="NUM 19:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 19:21" /> Гэта будзе вам законам у-ва ўсе вякі. Той, хто кропіць вадой ачышчэньня, таксама павінен вымыць адзеньне сваё; кожны, хто дакранецца вады ачышчэньня, нячысты будзе да вечара.<verse eid="NUM 19:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 19:22" /> Чаго толькі дакранецца нячысты, а таксама асоба, якая яго дакранецца, будуць нячыстымі да вечара».<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="cl">Лікі 20</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 20:1" /> У першы месяц сыны Ізраіля, уся супольнасьць, прыбылі ў пустыню Сін, і затрымаўся народ у Кадэшы. Там памерла Мірыям, і была пахавана ў тым самым месцы.<verse eid="NUM 20:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 20:2" /> Калі не хапіла народу вады, выступілі яны супраць Майсея і Аарона.<verse eid="NUM 20:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 20:3" /> І ўсхваляваліся яны, і казалі: «Лепш, каб мы пагінулі разам з братамі нашымі перад абліччам ГОСПАДА!<verse eid="NUM 20:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 20:4" /> Навошта вывелі вы супольнасьць ГОСПАДА ў пустыню, каб мы разам з жывёлай нашай пагінулі?<verse eid="NUM 20:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 20:5" /> Навошта вы нас вывелі з Эгіпту i завялі нас у гэтае месца ліхое, дзе сеяць нельга, дзе дрэва фігавае не расьце, ані вінаград, ані дрэвы гранатавыя, i нават вады няма для піцьця?»<verse eid="NUM 20:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 20:6" /> Майсей і Аарон адыйшлі ад натоўпу, і прыйшлі да ўваходу ў Намёт Спатканьня, і ўпалі вобліч на зямлю. І вось зьявілася слава ГОСПАДА над імі.<verse eid="NUM 20:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 20:7" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 20:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 20:8" /> «Вазьмі кій, і ты і Аарон, брат твой, зьбярыце народ i скажыце скале, што перад вамі, і яна дасьць ваду. І як вывядзеш ваду са скалы, напоіш народ і жывёлу ягоную».<verse eid="NUM 20:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 20:9" /> Дык Майсей па загаду ГОСПАДА ўзяў кій спрад аблічча ГОСПАДА.<verse eid="NUM 20:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 20:10" /> І Майсей і Аарон, сабраўшы народ перад скалою, сказалі яму: «Слухайце, бунтаўнікі! Ці зможам мы з гэтай скалы вывесьці ваду для вас?»<verse eid="NUM 20:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 20:11" /> Пасьля падняў Майсей руку і ўдарыў кіем два разы ў скалу. І выцякла шмат вады, так што напіўся і народ, і жывёла.<verse eid="NUM 20:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 20:12" /> І сказаў ГОСПАД Майсею і Аарону: «За тое, што вы не паверылі Мне, каб выявіць сьвятасьць Маю перад сынамі Ізраіля, не ўвядзіцё вы гэтых людзей у зямлю, якую Я даў ім».<verse eid="NUM 20:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 20:13" /> Гэта вось вада Мэрыбы, дзе збунтаваліся сыны Ізраіля супраць ГОСПАДА і дзе Ён выявіў сьвятасьць Сваю перад імі.<verse eid="NUM 20:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 20:14" /> З Кадэшу паслаў Майсей паслоў да валадара Эдому, каб яны сказалі: «Так кажа брат твой, Ізраіль: Ты ведаеш усе беды, якія ахапілі нас,<verse eid="NUM 20:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 20:15" /> як перабраліся бацькі нашыя ў Эгіпет і пражылі там шмат часу і як Эгіпцяне крыўдзілі нас і бацькоў нашых,<verse eid="NUM 20:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 20:16" /> ды як мы клікалі ГОСПАДА, і Ён выслухаў нас, і паслаў Анёла Сьвятога Свайго, Які вывеў нас з Эгіпту. Вось жа мы ў горадзе Кадэшы, на мяжы тваёй.<verse eid="NUM 20:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 20:17" /> Дык просім, дазволь прайсьці праз зямлю тваю. Ня пойдзем мы праз палі і вінаграднікі і ня будзем піць вады са студняў тваіх. Але пойдзем дарогай валадарскай, не адхіляючыся ані направа, ані налева, пакуль не мінем межаў тваіх».<verse eid="NUM 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 20:18" /> Адказаў ім Эдом: «Не ідзі праз мяне, бо перайму цябе са зброяй».<verse eid="NUM 20:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 20:19" /> Сказалі тады сыны Ізраіля: «Мы пойдзем бітаю дарогай, а калі будзем піць ваду, мы і жывёла наша, заплацім, што належыцца. Ня будзе цяжкасьці з платай. Мы хутка пройдзем».<verse eid="NUM 20:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 20:20" /> Але Эдом адказаў: «Ня пройдзеце!» І выйшаў Эдом супраць іх з шматлікім войскам і добра ўзброены.<verse eid="NUM 20:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 20:21" /> І забараніў Эдом Ізраілю пераходзіць межы свае, дык Ізраіль адыйшоў у бок ад яго.<verse eid="NUM 20:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 20:22" /> І вырушылі сыны Ізраіля з Кадэшу, і прыбылі пад гару Гор.<verse eid="NUM 20:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 20:23" /> Сказаў ГОСПАД Майсею і Аарону там, на гары Гор, якая знаходзіцца на мяжы Эдому:<verse eid="NUM 20:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 20:24" /> «Аарон будзе далучаны да народу свайго, бо ён ня ўвойдзе ў зямлю, якую Я дам сынам Ізраіля, таму што вы супрацівіліся волі Маёй ля водаў Мэрыбы.<verse eid="NUM 20:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 20:25" /> Вазьмі Аарона і сына яго Элеазара і завядзі іх на гару Гор.<verse eid="NUM 20:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 20:26" /> Там здымеш з бацькі адзеньне ягонае, і апранеш у яго Элеазара, сына ягонага. Аарон няхай адыйдзе і там памрэ».<verse eid="NUM 20:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 20:27" /> Майсей зрабіў, як яму загадаў ГОСПАД. І ўзыйшлі яны на гару Гор у прысутнасьці ўсёй супольнасьці.<verse eid="NUM 20:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 20:28" /> Аарон скінуў шаты свае, і апрануў у іх Элеазара, сына свайго. І памёр Аарон на вяршыні гары, а Майсей з Элеазарам зыйшлі ўніз.<verse eid="NUM 20:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 20:29" /> А калі ўся супольнасьць Ізраіля ўбачыла, што памёр Аарон, плакаў увесь дом Ізраіля трыццаць дзён.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="cl">Лікі 21</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 21:1" /> Валадар Араду, Хананеец, які жыў ў Нэгеве, даведаўся, што Ізраільцяне надыходзяць дарогай ад Атарыму, і напаў ён на Ізраіля, і ўзяў палоньнікаў.<verse eid="NUM 21:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 21:2" /> Тады Ізраіль шлюбаваў ГОСПАДУ ў гэтыя словы: «Калі Ты выдасі народ гэты ў рукі нашыя, мы збурым гарады ягоныя».<verse eid="NUM 21:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 21:3" /> І выслухаў ГОСПАД малітву Ізраіля, і даў яму Хананейцаў, якіх яны выбілі, і збурылі гарады іхнія, і назвалі месца тое Харма.<verse eid="NUM 21:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 21:4" /> З гары Гор ішлі яны ў напрамку Мора Чырвонага, каб абыйсьці зямлю Эдом. І ў час дарогі народ страціў цярплівасьць.<verse eid="NUM 21:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 21:5" /> І пачалі яны наракаць на Бога і Майсея, і казалі: «Навошта вы вывелі нас з Эгіпту, каб мы памерлі ў пустыні? Няма хлеба, няма вады. Абрыдла ўжо нам гэтая марная ежа».<verse eid="NUM 21:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 21:6" /> І паслаў ГОСПАД на народ ядавітых зьмеяў, якія кусалі народ, і памерла шмат народу з Ізраіля.<verse eid="NUM 21:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 21:7" /> І прыйшоў народ да Майсея, і жаліўся: «Саграшылі мы, бо блявузгалі супраць ГОСПАДА і супраць цябе. Маліся да ГОСПАДА, каб забраў Ён ад нас гэтых зьмеяў». І маліўся Майсей за народ.<verse eid="NUM 21:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 21:8" /> І сказаў ГОСПАД яму: «Зрабі мядзянага зьмея і падымі яго на жэрдцы. Калі хто ўкушаны гляне на яго, будзе жыць».<verse eid="NUM 21:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 21:9" /> І зрабіў Майсей мядзянага зьмея, і памясьціў яго на жэрдцы, і хто быў укушаны зьмеямі, глянуўшы на мядзянага зьмея, здаравеў.<verse eid="NUM 21:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 21:10" /> Адтуль выйшлі сыны Ізраіля і расклаліся табарам у Абоце.<verse eid="NUM 21:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 21:11" /> З Аботу накіраваліся далей і расклаліся табарам пад Іе-Гаабарымам у пустыні на ўсход ад Мааву.<verse eid="NUM 21:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 21:12" /> Адтуль пайшлі далей і затрымаліся ў лагчыне ручая Зарэд.<verse eid="NUM 21:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 21:13" /> Пакінуўшы яго, расклаліся табарам за ракою Арнон, якая цячэ праз пустыню, пачынаючыся з зямлі Амарэйцаў, бо Арнон творыць мяжу між Мааўлянамі і Амарэйцамі.<verse eid="NUM 21:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 21:14" /> Таму вось сказана ў Кнізе войнаў ГОСПАДА: «Вагэб каля Суфа і ручаёў Арнону.<verse eid="NUM 21:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 21:15" /> Схіл ручаёў сягае аж да мясцовасьці Ар і прылягае аж да межаў Мааву».<verse eid="NUM 21:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 21:16" /> Адгэтуль рушылі у Бээр. Гэта тая студня, пра якую сказаў ГОСПАД Майсею: «Зьбяры народ, і Я дам ім вады».<verse eid="NUM 21:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 21:17" /> Тады засьпявалі Ізраільцяне гэтую песьню: «Напаўняйся, студня, сьпявайце аб ёй!<verse eid="NUM 21:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 21:18" /> Студня, якую выкапалі князі ды начальнікі народу, выразалі скіпетрам і кіямі сваімі». З пустыні яны вырушылі ў Матану,<verse eid="NUM 21:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 21:19" /> з Матаны ў Нааліэль, з Нааліэля ў Бамот,<verse eid="NUM 21:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 21:20" /> з Бамоту ў лагчыну, якая ў зямлі Мааў, каля вяршыні гары Пісга, што ўзвышаецца над пустыняй.<verse eid="NUM 21:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 21:21" /> І паслаў Ізраіль паслоў да Сыгона, валадара Амарэйцаў, каб яму сказаць:<verse eid="NUM 21:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 21:22" /> «Прашу, дазволь мне прайсьці праз зямлю тваю; ня збочым мы на палі і на вінаграднікі, ня будзем піць са студняў, пакуль ня пройдзем межы твае».<verse eid="NUM 21:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 21:23" /> Але Сыгон не дазволіў Ізраілю прайсьці праз межы свае. Ён сабраў усё войска сваё і пераняў іх у пустыні, прыйшоў у Ягцу і напаў на Ізраіля.<verse eid="NUM 21:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 21:24" /> Паканаў аднак яго Ізраіль мячом і заняў зямлю ягоную ад Арнону аж да Ябоку, аж да [зямлі] сыноў Амона, бо моцнай абаронай былі заагледжаны межы сыноў Амона.<verse eid="NUM 21:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 21:25" /> І авалодаў Ізраіль усімі тымі гарадамі, i абжыўся ў гарадах Амарэйцаў, у Хешбоне і ў-ва ўсіх ваколіцах.<verse eid="NUM 21:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 21:26" /> Хешбон быў сталіцай Сыгона, валадара Амарэйцаў, які ваяваў з папярэднім валадаром Мааву і заваяваў у яго ўсю зямлю аж да Арнону.<verse eid="NUM 21:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 21:27" /> Таму гаворыцца ў прыказцы: «Ідзіце ў Хешбон! Няхай будзе адбудаваны і ўмацаваны горад Сыгона!<verse eid="NUM 21:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 21:28" /> Вось, агонь шугануў з Хешбону, полымя з гораду Сыгона, і спаліў Ар-Мааў і праглынуў узгорышчы Арнона.<verse eid="NUM 21:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 21:29" /> Гора табе, Мааў; прапаў ты, народ Хамоша! Змусіў ён сыноў тваіх да ўцёкаў, а дачок тваіх [даў] у палон Сыгону, валадару Амарэйцаў.<verse eid="NUM 21:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 21:30" /> Пусьцілі мы стрэлы ў іх, загінуў Хешбон аж да Дыбону. Зьнішчылі мы ўсё аж да Нофы ды аж да Мэдэвы».<verse eid="NUM 21:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 21:31" /> Так абжыўся Ізраіль у зямлі Амарэйцаў.<verse eid="NUM 21:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 21:32" /> Пасьля паслаў Майсей выведчыкаў, каб агледзелі Язэр. І яны здабылі яго разам з вакалічнымі мясцовасьцямі, а Амарэйцаў, якія былі там, выгналі.<verse eid="NUM 21:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 21:33" /> Далей павярнуліся і пайшлі ў бок Башану. Пераняў іх Ог, валадар Башану, з усім народам сваім у Эдрэі, каб ваяваць з імі.<verse eid="NUM 21:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 21:34" /> І ГОСПАД сказаў Майсею: «Ня бойся яго, бо Я аддаў яго ў рукі твае, яго і ўвесь народ, і зямлю ягоную, і ты зробіш з ім так, як зрабіў з Сыгонам, валадаром Амарэйцаў, які сядзеў у Хешбоне».<verse eid="NUM 21:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 21:35" /> І яны пабілі яго і сыноў ягоных, і ўвесь народ ягоны, аж нікога не засталося з іх, і завалодалі зямлёй ягонай.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="cl">Лікі 22</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 22:1" /> Потым сыны Ізраіля пайшлі далей і расклаліся табарам на раўнінах Мааву на другім баку Ярдану, насупраць Ерыхону.<verse eid="NUM 22:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 22:2" /> Балак, сын Цыпора, бачыў усё, што зрабіў Ізраіль Амарэйцам.<verse eid="NUM 22:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 22:3" /> Дык Мааў дужа баяўся гэтага народу, бо ён быў шматлікі, і баяўся Мааў сыноў Ізраіля.<verse eid="NUM 22:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 22:4" /> І сказаў Мааў старшыням спаміж Мадыянцаў: «Цяпер гэта мноства паесьць усё кругом, як вол саскубае траву на полі». Тады валадаром Мааву быў Балак, сын Цыпора.<verse eid="NUM 22:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 22:5" /> І паслаў ён пасланцоў да Білеама, сына Бэора, у Пэтор над ракой Эўфрат у зямлі Амавітаў, каб паклікаць яго і сказаць яму: «Вось, выйшаў народ з Эгіпту і пакрыў аблічча зямлі, i пасяліўся насупраць мяне.<verse eid="NUM 22:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 22:6" /> Дык прыйдзі, прашу, і пракляні мне народ гэты, бо ён дужэйшы за мяне. Можа, я здолею перамагчы яго і выгнаць з зямлі, бо ведаю, што каго ты дабраславіш, будзе дабраслаўлёны, а каго ты праклянеш, будзе пракляты».<verse eid="NUM 22:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 22:7" /> І вось выбраліся старшыні Мааўлянаў са старшынямі Мадыянцаў у дарогу, заагледжаныя ў падарункі для вяшчуна, і прыйшлі да Білеама, і перадалі яму словы Балака.<verse eid="NUM 22:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 22:8" /> Ён жа ім адказаў: «Пераначуйце тут ноч, і я адкажу вам тады, як скажа мне ГОСПАД». І асталіся старшыні Мааўлянаў у Білеама.<verse eid="NUM 22:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 22:9" /> І прыйшоў Бог да Білеама, і сказаў: «Што гэта за людзі ў цябе?»<verse eid="NUM 22:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 22:10" /> Білеам адказаў Богу: «Балак, сын Цыпора, валадар Мааўлянаў, прыслаў да мяне<verse eid="NUM 22:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 22:11" /> сказаць: “Гэты вось народ, які выйшаў з Эгіпту, пакрыў аблічча зямлі. Прыйдзі і пракляні мне яго, каб мог я з ім ваяваць і выгнаць яго”».<verse eid="NUM 22:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 22:12" /> На тое сказаў Бог Білеаму: «Ня можаш ты ісьці з імі, нельга табе праклінаць народ, бо ён дабраслаўлёны».<verse eid="NUM 22:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 22:13" /> На раніцы ўстаў ён і сказаў князям Балака: «Варочайцеся ў зямлю сваю, бо ГОСПАД не дазволіў мне ісьці з вамі».<verse eid="NUM 22:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 22:14" /> Усталі тады князі Мааву, і прыйшлі да Балака, і сказалі яму: «Білеам на захацеў ісьці з намі».<verse eid="NUM 22:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 22:15" /> І Балак паслаў яшчэ больш князёў, і болей дастойных, чым тыя.<verse eid="NUM 22:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 22:16" /> Як толькі прыйшлі яны да Білеама, сказалі яму: «Так кажа Балак, сын Цыпора: “Не адмаўляйся прыйсьці да мяне.<verse eid="NUM 22:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 22:17" /> Я гатовы табе выказаць вялікую пашану, і, што захочаш, дам табе. Прыйдзі і пракляні мне народ гэты”».<verse eid="NUM 22:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 22:18" /> Білеам адказаў: «Калі б даваў мне Балак поўны дом свой срэбра і золата, то не магу пераступіць волі ГОСПАДА, Бога майго, як у малых рэчах, так і ў вялікіх.<verse eid="NUM 22:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 22:19" /> Прашу, застаньцеся таксама ў гэтую ноч, а я даведаюся, што скажа мне зноў ГОСПАД».<verse eid="NUM 22:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 22:20" /> І прыйшоў вось Бог да Білеама ноччу, і кажа яму: «Калі прыйшлі гэтыя людзі паклікаць цябе, то ўстань і ідзі з імі, але зробіш толькі тое, што Я табе скажу».<verse eid="NUM 22:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 22:21" /> І ўстаў Білеам, асядлаў асьліцу сваю і вырушыў разам з імі.<verse eid="NUM 22:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 22:22" /> І ўзгарэўся гнеў Бога, што ён паехаў. І стаў анёл ГОСПАДАЎ на дарозе супраць яго, каб затрымаць яго. Ён жа ў таварыстве двух слугаў сваіх ехаў на асьліцы сваёй.<verse eid="NUM 22:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 22:23" /> Калі асьліца заўважыла анёла ГОСПАДАВАГА, якi стаяў на дарозе з выцягнутым мячом, зыйшла з дарогі і пайшла ў поле. Білеам ударыў яе, хочучы завярнуць яе на дарогу.<verse eid="NUM 22:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 22:24" /> Тады анёл ГОСПАДАЎ стаў на цеснай дарозе паміж вінаграднікамі, і мур быў з тога і з гэтага боку.<verse eid="NUM 22:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 22:25" /> Калі асьліца ўбачыла анёла ГОСПАДАВАГА, дык прыціснулася да муру. Ён жа пачаў яе біць нанова.<verse eid="NUM 22:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 22:26" /> Анёл ГОСПАДАЎ перайшоў у месца так цеснае, што ані з правага, ані з левага боку ніяк ня можна было абмінуць яго, і закрыў дарогу.<verse eid="NUM 22:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 22:27" /> Калі асьліца ўбачыла анёла ГОСПАДАВАГА зноў, лягла пад ногі Білеама. Ён, узлаваны, яшчэ мацней біў яе палкаю.<verse eid="NUM 22:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 22:28" /> Тады адкрыў ГОСПАД вусны асьліцы, і яна сказала Білеаму: «Што я табе зрабіла? Чаму б’еш мяне трэйці раз?»<verse eid="NUM 22:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 22:29" /> Білеам сказаў: «Бо ты працівілася мне. Каб меў я меч у руцэ, забіў бы цябе!»<verse eid="NUM 22:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 22:30" /> Асьліца сказала: «Ці ж я не твая асьліца, на якой езьдзіш ад пачатку да сёньняшняга дня? Ці ж я мела звычку так чыніць з табой?» А ён кажа: «Ніколі».<verse eid="NUM 22:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 22:31" /> Раптам адкрыў ГОСПАД вочы Білеама, і ён угледзеў анёла ГОСПАДАВА, што стаяў на дарозе з выцягнутым мячом. Пакланіўся ён тады анёлу да зямлі.<verse eid="NUM 22:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 22:32" /> І сказаў яму анёл ГОСПАДАЎ: «Навошта трэйці раз біў ты асьліцу сваю? Я прыбыў і заступіў табе дарогу, бо нядобрая дарога твая.<verse eid="NUM 22:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 22:33" /> Бачачы мяне, асьліца тры разы ўхілялася ад мяне, і каб не ўхілялася, я забіў бы цябе, а яе пакінуў бы жывую».<verse eid="NUM 22:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 22:34" /> Білеам сказаў: «Саграшыў я, бо ня ведаў, што ты заступіў мне дарогу; а цяпер вось, калі табе не падабаецца, вярнуся назад».<verse eid="NUM 22:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 22:35" /> Але анёл ГОСПАДАЎ сказаў Білеаму: «Ідзі з тымі людзьмі, але сьцеражыся, не гавары чаго іншага, толькі тое, што я табе загадаю». І пайшоў Білеам з князямі Балака.<verse eid="NUM 22:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 22:36" /> Калі пачуў Балак, што Білеам ідзе, выйшаў яму на спатканьне аж да Ір-Мааву, гораду, які на мяжы пры Арноне.<verse eid="NUM 22:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 22:37" /> Ён сказаў Білеаму: «Ці ж не пасылаў я да цябе пасланцоў, каб паклікалі цябе? Чаму не адразу прыбыў ты да мяне? Няўжо я не магу ўшанаваць цябе?»<verse eid="NUM 22:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 22:38" /> Білеам яму адказаў: «Вось, я прыйшоў да цябе. Ці ж магу што другое гаварыць, апрача таго, што мне ў вусны Бог улажыў?»<verse eid="NUM 22:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 22:39" /> І пайшлі Балак разам з Білеамам, і прыйшлі ў Кірыят-Хуцот.<verse eid="NUM 22:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 22:40" /> Балак пазабіваў валоў і авечак і паслаў Білеаму і князям, якія з ім былі.<verse eid="NUM 22:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 22:41" /> З настаньнем раніцы Балак завёў Білеама на высоты Баала, каб адтуль убачыў ён частку народу Ізраіля.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="cl">Лікі 23</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 23:1" /> Тады сказаў Білеам Балаку: «Пастаў мне тут сем ахвярнiкаў і прыгатуй мне столькі сама бычкоў і столькі сама бараноў».<verse eid="NUM 23:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 23:2" /> Балак зрабіў так, як яму сказаў Білеам, i паклалі яны па бычку і барану на кожны ахвярнiк.<verse eid="NUM 23:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 23:3" /> Тады сказаў Білеам Балаку: «Пастой каля цэласпаленьня твайго, а я пайду, можа, мяне спаткае ГОСПАД, і што мне загадае, скажу табе». Калі ён узыйшоў на лысы ўзгорак,<verse eid="NUM 23:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 23:4" /> пераняў яго Бог, і сказаў Яму Білеам: «Паставіў я сем ахвярнiкаў, і на кожны ахвярнiк палажылі бычка і барана».<verse eid="NUM 23:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 23:5" /> Тады ГОСПАД уклаў словы ў вусны Білеама і сказаў яму: «Вярніся да Балака і гэта вось скажы».<verse eid="NUM 23:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 23:6" /> Дык вярнуўся Білеам і знайшоў Балака, якi стаяў каля цэласпаленьня свайго, i ўсіх князёў Мааўскіх.<verse eid="NUM 23:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 23:7" /> І сказаў ён прароцтва сваё, кажучы: «З Араму прывёў мяне Балак, з гор усходніх кароль Мааву: “Прыйдзі, кажа, і пракляні мне Якуба! Пасьпяшай і навядзі няшчасьце на Ізраіля!”<verse eid="NUM 23:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 23:8" /> Як магу я праклінаць таго, каго не праклінае Бог? Як магу хацець каму зла, калі Бог ня хоча?<verse eid="NUM 23:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 23:9" /> Я бачу яго з вяршыні скалаў і з узгорышчаў гляджу на яго. Вось народ, які жыве асобна, і сярод народаў ня лічыцца.<verse eid="NUM 23:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 23:10" /> Хто ж можа зьлічыць пыл Якуба, і хто палічыць пясок Ізраіля? Няхай памрэ душа мая сьмерцю справядлівых і няхай будзе канец мой падобны іхняму».<verse eid="NUM 23:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 23:11" /> І сказаў Балак Білеаму: «Што гэта, што ты робіш? Я цябе паклікаў праклінаць ворагаў маіх, а ты, наадварот, дабраслаўляеш іх!»<verse eid="NUM 23:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 23:12" /> І адказаў яму Білеам: «Ці магу я што іншае казаць? Хіба ня тое, што загадаў мне ГОСПАД?»<verse eid="NUM 23:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 23:13" /> І сказаў Балак: «Хадзі са мной на другое месца, адтуль толькі частку Ізраіля ўбачыш, а ўсяго ня будзеш магчы бачыць. Адтуль будзеш яго праклінаць».<verse eid="NUM 23:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 23:14" /> І завёў ён яго на Поле Старажоў, на вяршыню Пісгі, і паставіў там сем ахвярнiкаў, і паклаў на кожны па цяляці і барану.<verse eid="NUM 23:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 23:15" /> І сказаў Білеам Балаку: «Пастой тут каля цэласпаленьня твайго, а я адыйдуся далей на спатканьне [з Госпадам]».<verse eid="NUM 23:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 23:16" /> Калі яго пераняў ГОСПАД, уклаў словы ў вусны ягоныя і сказаў: «Вяртайся да Балака і вось гэта скажаш яму».<verse eid="NUM 23:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 23:17" /> Вярнуўшыся, знайшоў Балака, якi стаяў каля цэласпаленьня свайго, і князёў Мааву з ім, і зьвярнуўся да яго Балак: «Што гаварыў табе ГОСПАД?»<verse eid="NUM 23:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 23:18" /> А ён аб’явіў прароцтва сваё, кажучы: «Устань, Балак, і настаў вуха. Слухай, сыне Цыпора!<verse eid="NUM 23:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 23:19" /> Бог — гэта не чалавек, каб Ён падманваў, і ня сын чалавечы, каб памыляўся. Ці ж Ён скажа і ня зьдзейсьніць?<verse eid="NUM 23:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 23:20" /> Дабраслаўляць прывёў Ён мяне, і ўстрымацца не магу, каб не дабраслаўляць.<verse eid="NUM 23:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 23:21" /> Ня бачна няшчасьця у Якуба і ня бачыцца гора ў Ізраіля. ГОСПАД, Бог ягоны, з ім, і гоман ў яго [на славу] валадара ягонага.<verse eid="NUM 23:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 23:22" /> Бог вывеў яго з Эгіпту. Ён для іх — як рог буйвала.<verse eid="NUM 23:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 23:23" /> Няма варажбы ў Якуба, ані прадказаньняў у Ізраіля. У свой час будзе сказана Якубу і Ізраілю, што ўчыніць Бог.<verse eid="NUM 23:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 23:24" /> Вось народ як ільвіца падымаецца ды як леў становіцца; ён ня ляжа, пакуль ня зьесьць здабычы і пакуль не нап’ецца крыві забітых».<verse eid="NUM 23:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 23:25" /> І сказаў Балак Білеаму: «Калі ты ня можаш праклінаць яго, то, прынамсі, не дабраслаўляй яго!»<verse eid="NUM 23:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 23:26" /> І сказаў Білеам: «Ці ж я табе не казаў: тое, што мне ГОСПАД загадае, я мушу рабіць?»<verse eid="NUM 23:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 23:27" /> І сказаў Балак яму: «Хадзі, я завяду цябе на іншае месца. Можа, спадабаецца Богу, што адтуль праклянеш яго?»<verse eid="NUM 23:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 23:28" /> І завёў яго на вяршыню гары Пэор, што зьвернута ў бок пустыні.<verse eid="NUM 23:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 23:29" /> І сказаў яму Білеам: «Пастаў мне тут сем ахвярнiкаў і прыгатуй столькі сама цялят і бараноў».<verse eid="NUM 23:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 23:30" /> І зрабіў Балак, як яму сказаў Білеам, і паклаў бычкоў і бараноў на кожны асобны ахвярнiк.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="cl">Лікі 24</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 24:1" /> Калі Білеам пераканаўся, што ГОСПАДУ падабаецца, каб ён дабраслаўляў Ізраіля, дык не пайшоў, як раней хадзіў, каб варажыць, але павярнуў ён аблічча сваё на пустыню.<verse eid="NUM 24:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 24:2" /> Калі падняў ён вочы свае і ўбачыў Ізраіля, што стаяў табарам па пакаленьнях сваіх, агарнуў яго Дух Божы,<verse eid="NUM 24:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 24:3" /> і абвясьціў ён прароцтва сваё, кажучы: «Кажа Білеам, сын Бэора, кажа чалавек, у якога адкрытыя вочы,<verse eid="NUM 24:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 24:4" /> кажа той, хто чуе слова Божае, той, хто бачыць відзежы Ўсемагутнага, той, хто падае, але вочы адкрытыя ў яго.<verse eid="NUM 24:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 24:5" /> О як прыгожыя намёты твае, Якубе, і паселішчы твае, Ізраілю!<verse eid="NUM 24:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 24:6" /> Раскінуліся яны як даліны рэкаў, як сады на беразе ручая, як дрэвы алёэ, якія ГОСПАД пасадзіў, як кедры між водамі.<verse eid="NUM 24:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 24:7" /> Цячэ вада з нетраў ягоных, і зерне ягонае мае ўдосталь вільгаці. Валадар ягоны мацнейшы, чым Агаг, і ўзвышаецца валадарства ягонае.<verse eid="NUM 24:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 24:8" /> Бог вывеў яго з Эгіпту. Ён для яго — як рог буйвала. Праглыне ён народы, ворагаў сваіх, косьці іхнія паломіць і струшчыць стрэламі сваімі.<verse eid="NUM 24:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 24:9" /> Ён прыхіліўся, лёг як леў ды як ільвіца, хто адважыцца падняць яго? Хто дабраслаўляе цябе, сам будзе дабраслаўлёны; хто праклінае цябе, сам будзе пракляты!»<verse eid="NUM 24:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 24:10" /> І разгневаўся на Білеама Балак, і, пляснуўшы рукамі, сказаў: «На праклён ворагаў маіх я паклікаў цябе. А іх ты ўжо трэці раз дабраслаўляеш!<verse eid="NUM 24:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 24:11" /> Уцякай хутчэй у дом свой! Хацеў я цябе багата аднагародзіць, але ГОСПАД пазбавіў цябе прыгатаванай нагароды».<verse eid="NUM 24:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 24:12" /> Білеам адказаў Балаку: «Ці ж ужо пасланцам тваім, пасланым табою да мяне, не казаў я:<verse eid="NUM 24:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 24:13" /> “Хоць бы Балак даваў мне поўны дом свой срэбра або золата, не магу працівіцца слову ГОСПАДА. Ці што добрае, ці што ліхое ня выкажу з сэрца майго, але толькі тое, што ГОСПАД скажа, тое і я скажу”.<verse eid="NUM 24:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 24:14" /> Дык вось, я вярнуся да народу майго, але падыйдзі, я скажу табе, што зробіць народ гэты з народам тваім у апошнія часы».<verse eid="NUM 24:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 24:15" /> І выказаў ён прароцтва, кажучы: «Кажа Білеам, сын Бэора, кажа чалавек, які мае адкрытыя вочы,<verse eid="NUM 24:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 24:16" /> кажа той, хто чуе словы Божыя, які ведае думку Ўзвышняга і бачыць відзежы Ўсемагутнага, які, падаючы, мае адкрытыя вочы.<verse eid="NUM 24:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 24:17" /> Бачу яго, але яшчэ не цяпер, аглядаю яго, але ня зблізка. Узыходзіць зорка з Якуба, паўстае скіпетр з Ізраіля; і ён струшчыць скроні Мааву і чарапы ўсіх сыноў Сэта.<verse eid="NUM 24:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 24:18" /> Эдом станецца ўласнасьцю ягонай, і Сэір стане спадчынай ворагаў. Ізраіль будзе рабіць вялікія справы.<verse eid="NUM 24:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 24:19" /> Ад Якуба будзе валадар, і зьнішчыць ён рэшткі гораду».<verse eid="NUM 24:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 24:20" /> Калі ўбачыў ён Амалека, абвясьціў прароцтва сваё і сказаў: «Амалек — першы з народаў, але да рэшты ён будзе зьнішчаны».<verse eid="NUM 24:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 24:21" /> Угледзеў таксама Кенэяў, і абвясьціў прароцтва сваё, і сказаў: «Моцнае жытло тваё, і на скале пабудаванае гняздо тваё;<verse eid="NUM 24:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 24:22" /> але і яно прызначанае на зьнішчэньне, калі Асур зьняволіць цябе».<verse eid="NUM 24:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 24:23" /> І абвясьціў ён прароцтва сваё, і зноў сказаў ён: «Хто будзе жыць, калі Бог зробіць гэта?<verse eid="NUM 24:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 24:24" /> Прыплывуць караблі з Кітыму, і перамогуць Асура, і паканаюць Эбэра, але ўрэшце і самі загінуць».<verse eid="NUM 24:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 24:25" /> І ўстаў Білеам, і вярнуўся ў месца сваё, а Балак таксама пайшоў дарогай сваёй.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="cl">Лікі 25</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 25:1" /> І жыў тады Ізраіль у Шыттыме, і стаў распуставаць з дочкамі Мааву,<verse eid="NUM 25:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 25:2" /> якія запрашалі народ на ахвяры багам сваім. Разам яны елі і пакланяліся ідалам іхнім.<verse eid="NUM 25:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 25:3" /> Так прыляпіўся Ізраіль да Баал-Пэора, і ўзгарэўся гнеў ГОСПАДА.<verse eid="NUM 25:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 25:4" /> І сказаў Ён Майсею: «Зьбяры ўсіх [вінаватых] начальнікаў народу і павесь іх перад абліччам ГОСПАДА на сонцы, каб гэтак адвярнуўся гнеў Мой ад Ізраіля».<verse eid="NUM 25:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 25:5" /> І сказаў Майсей судзьдзям Ізраіля: «Няхай кожны з вас заб’е тых людзей вашых, якія прыляпіліся да Баал-Пэора».<verse eid="NUM 25:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 25:6" /> І вось адзін з сыноў Ізраіля прыйшоў, і прывёў да братоў сваіх Мадыянку на вачах Майсея і вялікай грамады сыноў Ізраіля, якія лямантавалі перад уваходам у Намёт Спатканьня.<verse eid="NUM 25:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 25:7" /> Калі гэта ўбачыў Пінхас, сын Элеазара, сына Аарона сьвятара, выбег спаміж супольнасьці, схапіўшы дзіду,<verse eid="NUM 25:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 25:8" /> і пайшоў за мужчынам Ізраільцянінам у намёт, і прабіў іх дзідаю абодвух, мужчыну і жанчыну, праз улоньні. Так спынілася кара на сыноў Ізраіля.<verse eid="NUM 25:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 25:9" /> А загінула ўжо дваццаць чатыры тысячы чалавек.<verse eid="NUM 25:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 25:10" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 25:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 25:11" /> «Пінхас, сын Элеазара, сына Аарона сьвятара, адвярнуў гнеў Мой ад сыноў Ізраіля, бо загарэўся руплівасьцю Маёю сярод іх, і каб ня ён, зьнішчыў бы Я сыноў Ізраіля ў зайздрасьці Сваёй.<verse eid="NUM 25:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 25:12" /> Дзеля таго скажы яму: “Вось, Я заключаю з ім запавет супакою”.<verse eid="NUM 25:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 25:13" /> І будзе гэта яму і патомству ягонаму запаветам вечнага сьвятарства, бо рупіўся ён пра Бога свайго і адкупіў злачынствы сыноў Ізраіля».<verse eid="NUM 25:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 25:14" /> А імя таго мужчыны Ізраільцяніна, забітага разам з Мадыянкай, было Зімры, сын Салю, князь аднаго з родаў пакаленьня Сымона.<verse eid="NUM 25:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 25:15" /> Забітая жанчына Мадыянка называлася Казбі, была яна дачкой Цура, начальніка аднаго з пакаленьняў Мадыянскіх.<verse eid="NUM 25:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 25:16" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 25:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 25:17" /> «Ваюйце супраць Мадыянцаў і выбіце іх,<verse eid="NUM 25:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 25:18" /> бо яны варожа паставіліся да вас і ашуквалі вас празь ідала Пэора і праз распусту Казбі, дачкі начальніка Мадыянскага, сястры іхняй, забітай у дзень кары за Пэора».<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="cl">Лікі 26</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 26:1" /> Пасьля гэтай плягі сказаў ГОСПАД Майсею і Элеазару, сыну Аарона сьвятара:<verse eid="NUM 26:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 26:2" /> «Палічыце лічбу усяе супольнасьці сыноў Ізраіля ад дваццаці гадоў і вышэй па родах, усіх, здольных ваяваць».<verse eid="NUM 26:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 26:3" /> Дык Майсей і сьвятар Элеазар так пастанавілі на раўнінах Мааву, насупраць Ерыхону, над Ярданам:<verse eid="NUM 26:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 26:4" /> «Палічыць усіх ад дваццаці гадоў і вышэй, як ГОСПАД загадаў Майсею і Ізраільцянам пры выхадзе з Эгіпту». Вось лічба сыноў Ізраіля, якія выйшлі з зямлі Эгіпецкай:<verse eid="NUM 26:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 26:5" /> Рубэн, першародны Ізраіля. Сыны Рубэна: Ханох, ад якога род Ханоха, і Пальлю, ад якога род Пальлю,<verse eid="NUM 26:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 26:6" /> і Хецрон, ад якога род Хецрона, і Кармі, ад якога род Кармі.<verse eid="NUM 26:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 26:7" /> Гэтыя вось роды з пакаленьня Рубэна, лічба якіх дасягала сорак тры тысячы семсот трыццаць.<verse eid="NUM 26:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 26:8" /> Сыны Пальлю: Эліяў<verse eid="NUM 26:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 26:9" /> і сыны ягоныя: Нэмуэль, Датан і Абірам. Датан і Абірам — гэта тыя князі народу, якія збунтаваліся супраць Майсея і Аарона разам з Карахам, калі яны паднялі бунт супраць ГОСПАДА,<verse eid="NUM 26:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 26:10" /> і зямля разьзявіла вусны свае і праглынула іх і Караха, і паўміралі многія, калі агонь спаліў дзьвесьце пяцьдзясят чалавек, і сталіся яны знакам [перасьцярогі].<verse eid="NUM 26:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 26:11" /> Але сыны Караха не загінулі.<verse eid="NUM 26:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 26:12" /> Сыны Сымона па пакаленьнях іхніх: ад Нэмуэля паходзіць род Нэмуэля; ад Яміна — род Яміна; ад Яхіна — род Яхіна,<verse eid="NUM 26:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 26:13" /> ад Зэраха — род Зэраха; ад Шаўля — род Шаўля.<verse eid="NUM 26:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 26:14" /> Такія вось роды з пакаленьня Сымона, агульная лічба якіх была дваццаць дзьве тысячы дзьвесьце.<verse eid="NUM 26:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 26:15" /> Сыны Гада па родах сваіх: Цэфон, ад якога род Цэфона; Хаггi, ад якога род Хаггі; Шуні, ад якога род Шуні,<verse eid="NUM 26:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 26:16" /> Озьні, ад якога род Озьні; Эры, ад якога род Эры,<verse eid="NUM 26:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 26:17" /> Арод, ад якога род Арода; Арыэль, ад якога род Арыэля.<verse eid="NUM 26:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 26:18" /> Гэта вось роды Гада, агульная лічба якіх была сорак тысячаў пяцьсот.<verse eid="NUM 26:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 26:19" /> Сыны Юды: Гер і Янан, яны абодва памерлі ў зямлі Ханаан.<verse eid="NUM 26:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 26:20" /> Вось сыны Юды па родах іхніх: Шэля, ад якога род Шэлі; Пэрэс, ад якога род Пэрэса; Зэрах, ад якога род Зэраха.<verse eid="NUM 26:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 26:21" /> А вось сыны Пэрэса: Хецрон, ад якога род Хецрона, і Хамуль, ад якога род Хамуля.<verse eid="NUM 26:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 26:22" /> Гэтыя вось роды Юды, агульная лічба якіх была семдзясят шэсьць тысячаў пяцьсот.<verse eid="NUM 26:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 26:23" /> Сыны Ісахара па родах сваіх: Таля, ад якога род Талі; Пува, ад якога род Пувы;<verse eid="NUM 26:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 26:24" /> Яшуб, ад якога род Яшуба; Шымрон, ад якога род Шымрона.<verse eid="NUM 26:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 26:25" /> Такія вось роды Ісахара, агульная лічба якіх была шэсьцьдзесят чатыры тысячы трыста.<verse eid="NUM 26:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 26:26" /> Сыны Завулёна па родах іхніх: Сэрэд, ад якога род Сэрэда; Элён, ад якога род Элёна; Яхлеэль, ад якога род Яхлеэля.<verse eid="NUM 26:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 26:27" /> Гэта роды Завулёна, агульная лічба якіх была шэсьцьдзясят тысячаў пяцьсот.<verse eid="NUM 26:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 26:28" /> Сыны Язэпа па родах сваіх: Манаса і Эфраім.<verse eid="NUM 26:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 26:29" /> З Манасы нарадзіўся Махір, ад якога род Махіра; Махір быў бацькам Гілеаду, ад якога род Гілеада.<verse eid="NUM 26:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 26:30" /> Гілеад меў сыноў: Езэра, ад якога род Езэра; і Гэлека, ад якога род Гэлека;<verse eid="NUM 26:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 26:31" /> і Асрыэля, ад якога род Асрыэля; і Мэхема, ад якога род Мэхема,<verse eid="NUM 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 26:32" /> і Шэміду, ад якога род Шэміды; і Хэфэра, ад якога род Хэфэра.<verse eid="NUM 26:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 26:33" /> Хэфэр быў бацькам Цэлафхада, які ня меў сыноў, а толькі дочкі, імёны якіх: Махля, Ноа, Хогля, Мілька і Тырца.<verse eid="NUM 26:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 26:34" /> Такія вось роды Манасы, лічба якіх была пяцьдзясят дзьве тысячы семсот.<verse eid="NUM 26:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 26:35" /> Сыны Эфраіма па родах іхніх: Шутэлях, ад якога род Шутэляха; Бэхэр, ад якога род Бэхэра; Тахан, ад якога род Тахана.<verse eid="NUM 26:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 26:36" /> Сынам Шэтэляха быў Эран, ад якога род Эрана.<verse eid="NUM 26:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 26:37" /> Такія вось роды сыноў Эфраіма, лічба якіх была трыццаць дзьве тысячы пяцьсот. Яны — нашчадкі Язэпа па родах сваіх.<verse eid="NUM 26:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 26:38" /> Сыны Бэн’яміна па родах сваіх: Бэля, ад якога род Бэлі; Ашбэль, ад якога род Ашбэля; Ахірам, ад якога род Ахірама;<verse eid="NUM 26:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 26:39" /> Шэфуфам, ад якога род Шэфуфама; Хуфам ад якога род Хуфама.<verse eid="NUM 26:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 26:40" /> Сыны Бэлі: Ард і Нааман; ад Арда паходзіць род Арда, ад Наамана — род Наамана.<verse eid="NUM 26:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 26:41" /> Такія вось сыны Бэн’яміна па родах сваіх, лічба якіх была сорак пяць тысячаў шэсьцьсот.<verse eid="NUM 26:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 26:42" /> Сыны Дана па родах сваіх: Шухам, ад якога род Шухама. Такія вось сыны Дана па родах сваіх:<verse eid="NUM 26:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 26:43" /> усе былі сыны Шухама, лічба іх была шэсьцьдзясят чатыры тысячы чатырыста.<verse eid="NUM 26:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 26:44" /> Сыны Асэра па родах сваіх: Імна, ад якога род Імны; Ішві, ад якога род Ішві; Бэрыя, ад якога род Бэрыі.<verse eid="NUM 26:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 26:45" /> Сыны Бэрыі: Гебэр, ад якога род Гебэра; і Малькіэль, ад якога род Малькіэля.<verse eid="NUM 26:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 26:46" /> Дачкі Асэра імя было Сэраха.<verse eid="NUM 26:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 26:47" /> Такія вось роды сыноў Асэра, лічба іх была пяцьдзясят тры тысячы чатырыста.<verse eid="NUM 26:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 26:48" /> Сыны Нэфталі па родах сваіх: Яхцэль, ад якога род Яхцэля; Гуні, ад якога род Гуні;<verse eid="NUM 26:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 26:49" /> Ецэр, ад якога род Ецэра; Шылем, ад якога род Шылема.<verse eid="NUM 26:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 26:50" /> Такія вось роды сыноў Нэфталі па родах сваіх, лічба якіх была сорак пяць тысячаў чатырыста.<verse eid="NUM 26:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 26:51" /> Агульная лічба сыноў Ізраіля паводле сьпісу: шэсьцьсот адна тысяча семсот трыццаць.<verse eid="NUM 26:51" /></para>
  <para style="m">
    <verse number="52" style="v" pubnumber="52." sid="NUM 26:52" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 26:52" /></para>
  <para style="m">
    <verse number="53" style="v" pubnumber="53." sid="NUM 26:53" /> «Паміж імі будзе падзелена зямля на ўласнасьць паводле лічбы імёнаў.<verse eid="NUM 26:53" /></para>
  <para style="m">
    <verse number="54" style="v" pubnumber="54." sid="NUM 26:54" /> Больш шматлікім большую частку дасі; менш шматлікім — меншую; кожнаму асобна, паводле сьпісу, будзе дадзена спадчына.<verse eid="NUM 26:54" /></para>
  <para style="m">
    <verse number="55" style="v" pubnumber="55." sid="NUM 26:55" /> Зямля павінна быць падзелена жэрабем, а спадчыну маюць атрымаць паводле лічбы імёнаў у родах.<verse eid="NUM 26:55" /></para>
  <para style="m">
    <verse number="56" style="v" pubnumber="56." sid="NUM 26:56" /> Жэрабем трэба падзяліць спадчыну між вялікімі і малымі родамі».<verse eid="NUM 26:56" /></para>
  <para style="m">
    <verse number="57" style="v" pubnumber="57." sid="NUM 26:57" /> Такая вось лічба сыноў Левія па родах іхніх: Гершон, ад якога род Гершона; Кегат, ад якога род Кегата; і Мэрары, ад якога род Мэрары.<verse eid="NUM 26:57" /></para>
  <para style="m">
    <verse number="58" style="v" pubnumber="58." sid="NUM 26:58" /> Такія вось роды Левія: род Лібні, род Хеўрона, род Махлі, род Мушы, род Караха. Кегат жа быў бацькам Амрама,<verse eid="NUM 26:58" /></para>
  <para style="m">
    <verse number="59" style="v" pubnumber="59." sid="NUM 26:59" /> які меў жонку Ёкэбэд, дачку Левія, якая нарадзілася яму ў Эгіпце. Яна нарадзіла Амраму, мужу свайму, Аарона і Майсея, поруч сястру іхнюю Мірыям.<verse eid="NUM 26:59" /></para>
  <para style="m">
    <verse number="60" style="v" pubnumber="60." sid="NUM 26:60" /> Аарон меў сыноў: Надава, Абігу, Элеазара і Ітамара,<verse eid="NUM 26:60" /></para>
  <para style="m">
    <verse number="61" style="v" pubnumber="61." sid="NUM 26:61" /> з якіх Надаў і Абігу памерлі, калі прынесьлі чужы агонь перад аблічча ГОСПАДА.<verse eid="NUM 26:61" /></para>
  <para style="m">
    <verse number="62" style="v" pubnumber="62." sid="NUM 26:62" /> Усіх па сьпісе было дваццаць тры тысячы мужчынаў ад аднаго месяца і вышэй. Яны ня ўпісаныя ў лічбу сыноў Ізраіля, бо ня дадзена ім спадчына сярод сыноў Ізраіля.<verse eid="NUM 26:62" /></para>
  <para style="m">
    <verse number="63" style="v" pubnumber="63." sid="NUM 26:63" /> Такая вось лічба сыноў Ізраіля, сьпісаных Майсеем і Элеазарам сьвятаром на раўнінах Мааву над Ярданам насупраць Ерыхону.<verse eid="NUM 26:63" /></para>
  <para style="m">
    <verse number="64" style="v" pubnumber="64." sid="NUM 26:64" /> Між імі не было нікога з тых, якіх Майсей і Аарон лічылі, калі сьпісвалі сыноў Ізраіля ў пустыні Сынай,<verse eid="NUM 26:64" /></para>
  <para style="m">
    <verse number="65" style="v" pubnumber="65." sid="NUM 26:65" /> бо прадказаў ім ГОСПАД, што ўсе яны вымруць у пустыні, і не застанецца з іх ніводнага, апрача Халева, сына Ефунны, і Егошуа, сына Нуна.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="cl">Лікі 27</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 27:1" /> І прыйшлі дочкі Цэлафхада, сына Хэфэра, сына Гілеада, сына Махіра, сына Манасы, з роду Манасы, сына Язэпа, а імёны іхнія: Махля, Ноа, Хогля, Мілька і Тырца.<verse eid="NUM 27:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 27:2" /> І сталі яны перад Майсеем і Элеазарам сьвятаром, і князямі, і перад ўсёю супольнасьцю каля ўваходу ў Намёт Спатканьня, і сказалі:<verse eid="NUM 27:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 27:3" /> «Бацька наш памёр у пустыні, і ня ўдзельнічаў у бунце Караха супраць ГОСПАДА, але памёр у граху сваім. Ён ня меў сыноў.<verse eid="NUM 27:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 27:4" /> Ці ж можа счэзнуць імя ягонае з роду ягонага, бо ня меў ён сына? Дайце нам спадчыну паміж братоў бацькі нашага».<verse eid="NUM 27:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 27:5" /> І прынёс Майсей справу іхнюю на суд ГОСПАДА.<verse eid="NUM 27:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 27:6" /> І ГОСПАД сказаў яму:<verse eid="NUM 27:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 27:7" /> «Справядліва дамагаюцца дочкі Цэлафхада. Дай ім уласнасьць між братоў бацькі іхняга, і няхай яны маюць спадчыну.<verse eid="NUM 27:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 27:8" /> Сынам жа Ізраіля скажы так: “Калі чалавек памрэ бяз сына, спадчына ягоная пераходзіць на дачку.<verse eid="NUM 27:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 27:9" /> Калі б ня меў дачкі, спадкаемцамі сталі б браты ягоныя.<verse eid="NUM 27:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 27:10" /> Калі б і братоў не было, аддасьцё спадчыну братам бацькі яго.<verse eid="NUM 27:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 27:11" /> Калі б і братоў у бацькі не было, тады спадчына ягоная пераходзіць найбліжэйшаму сваяку ў родзе ягоным, і ён возьме спадчыну”. Як загадаў ГОСПАД Майсею, такі будзе сынам Ізраіля сьвяты і вечны закон».<verse eid="NUM 27:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 27:12" /> І сказаў ГОСПАД Майсею: «Узыйдзі на гэту гару Абарым і паглядзі адтуль на зямлю, якую Я дам сынам Ізраіля.<verse eid="NUM 27:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 27:13" /> Калі агледзіш яе, ты пойдзеш да народу свайго, як пайшоў брат твой, Аарон,<verse eid="NUM 27:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 27:14" /> бо вы зьняважылі Мяне ў пустыні Сін падчас бунту супольнасьці, бо не захацелі аб’явіць сьвятасьці Маёй перад імі, [даючы ім] вады». Гэта вада Мэрывы каля Кадэшу ў пустыні Сін.<verse eid="NUM 27:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 27:15" /> І сказаў Майсей ГОСПАДУ:<verse eid="NUM 27:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 27:16" /> «Няхай прызначыць ГОСПАД, Бог духаў і кожнага цела, чалавека, які кіраваў бы зграмаджэньнем гэтым,<verse eid="NUM 27:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 27:17" /> i мог бы выступіць перад імі, выводзіць іх і ўводзіць, каб ня стаўся народ ГОСПАДАЎ як авечкі без пастуха».<verse eid="NUM 27:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 27:18" /> І сказаў яму ГОСПАД: «Вазьмі Егошуа, сына Нуна, чалавека, на якім прабывае Дух; і ўскладзі рукі твае на яго.<verse eid="NUM 27:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 27:19" /> І пастаў яго перад Элеазарам сьвятаром i ўсёй супольнасьцю, і перад абліччам усіх дай яму даручэньні.<verse eid="NUM 27:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 27:20" /> І ўладай сваёй падтрымай яго, каб слухала яго ўся супольнасьць сыноў Ізраіля.<verse eid="NUM 27:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 27:21" /> Стане ён перад Элеазарам сьвятаром, а ён пра яго параіцца з ГОСПАДАМ праз суд урыму. Паводле загаду ягонага будзе выходзіць і ўваходзіць ён сам, і ўсе сыны Ізраіля з ім, і ўся супольнасьць».<verse eid="NUM 27:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 27:22" /> Майсей зрабіў так, як яму загадаў ГОСПАД. Паклікаў Егошуа, паставіў яго перад сьвятаром Элеазарам і ўсім прысутным народам,<verse eid="NUM 27:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 27:23" /> і, усклаўшы на галаву ягоную рукі, паставіў яго правадыром, як загадаў ГОСПАД праз Майсея.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="cl">Лікі 28</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 28:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 28:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 28:2" /> «Загадай сынам Ізраіля і скажы ім: Няхай у свой час складаюць ахвяру Мне і хлеб Мой, ахвяру цэласпаленьня на мілы пах Мне.<verse eid="NUM 28:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 28:3" /> Такая вось ахвяра агнявая, якую вы павінны складаць: два гадавыя ягняткі штодзень у ахвяру цэласпаленьня.<verse eid="NUM 28:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 28:4" /> Адно ягня складзіцё на раніцы ў ахвяру цэласпаленьня, а другое — ўвечары.<verse eid="NUM 28:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 28:5" /> І як ахвяру хлебную дасьцё дзясятую частку эфы пшанічнай мукі, запраўленай чацьвёртай часткай гіну найчысьцейшага алею.<verse eid="NUM 28:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 28:6" /> Гэта цэласпаленьне пастаяннае, якое склалі вы на гары Сынай на мілы пах ГОСПАДУ як ахвяру агня.<verse eid="NUM 28:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 28:7" /> І ахвяру вадкую з віна; чацьвёртую частку гіну выльеце на кожнае ягня. На сьвятым месцы вылівайце п’янкое віно ГОСПАДУ.<verse eid="NUM 28:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 28:8" /> У такі самы спосаб складзіцё другое ягня вечарам паводле парадку ранішняй ахвяры. Гэта ахвяра агнявая на мілы пах ГОСПАДУ.<verse eid="NUM 28:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 28:9" /> А ў дзень суботы складзіцё ў ахвяру двух беззаганных аднагадовых ягнятаў і дзьве дзясятыя эфы мукі, запраўленай алеем, як ахвяру хлебную.<verse eid="NUM 28:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 28:10" /> Гэта суботняя ахвяра цэласпаленьня на кожную суботу, апрача штодзённай ахвяры цэласпаленьня і ахвяры вадкай.<verse eid="NUM 28:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 28:11" /> У кожны першы дзень вашага месяца складайце ГОСПАДУ ахвяру цэласпаленьня: два бычкі, барана і сем аднагадовых ягнят без заганы.<verse eid="NUM 28:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 28:12" /> На кожнага бычка палажыце тры дзясятыя эфы пшанічнай мукі, запраўленай алеем, як ахвяру хлебную, і на кожнага барана — дзьве дзясятыя эфы мукі, запраўленай алеем, як ахвяру хлебную,<verse eid="NUM 28:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 28:13" /> і на кожнае ягня як ахвяру хлебную палажыце дзясятую частку эфы пшанічнай мукі, запраўленай алеем; усё гэта як цэласпаленьне на мілы пах ГОСПАДУ.<verse eid="NUM 28:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 28:14" /> Ахвяры вадкія іхнія будуць такія: палова гіну віна на кожнага бычка, адна трэцяя гіну на барана і адна чацьвёртая гіну на ягня. Гэта цэласпаленьне ў кожны першы дзень месяца на ўсе месяцы году.<verse eid="NUM 28:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 28:15" /> Таксама казёл будзе складзены ГОСПАДУ ў ахвяру за грэх, апрача пастаяннай ахвяры цэласпаленьня і належнай да яе ахвяры вадкай.<verse eid="NUM 28:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 28:16" /> У чатырнаццаты дзень першага месяца – Пасха ГОСПАДА.<verse eid="NUM 28:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 28:17" /> У пятнаццаты дзень таго месяца будзе сьвята. Сем дзён будзеце есьці толькі праснакі.<verse eid="NUM 28:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 28:18" /> У першы дзень будзе сьвяты сход, нельга ў той дзень працаваць.<verse eid="NUM 28:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 28:19" /> І складзіцё ахвяру агнявую, цэласпаленьне ГОСПАДУ: два бычкі, аднаго барана і сем беззаганных аднагадовых ягнят;<verse eid="NUM 28:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 28:20" /> пры іх ахвяру хлебную з пшанічнай мукі, запраўленай алеем: тры дзясятыя (эфы) на аднаго бычка, дзьве дзясятыя на аднаго барана,<verse eid="NUM 28:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 28:21" /> і адна дзясятая на кожнага з сямі ягнят.<verse eid="NUM 28:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 28:22" /> Наастатак аднаго казла ў ахвяру за грэх, для ачышчэньня вашага.<verse eid="NUM 28:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 28:23" /> Апрача ранішняга цэласпаленьня, якое ёсьць цэласпаленьнем пастаянным, складайце гэтыя ахвяры.<verse eid="NUM 28:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 28:24" /> Такія ахвяры складайце штодзень сем дзён, як цэласпаленьне, як мілы пах ГОСПАДУ. Апрача штодзённай ахвяры цэласпаленьня і ахвяры хлебнай павінны быць складаныя гэтыя ахвяры.<verse eid="NUM 28:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 28:25" /> Дзень сёмы будзе для вас сьвятым сходам, не выконвайце ў той дзень ніякай працы.<verse eid="NUM 28:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 28:26" /> У дзень пяршынаў, калі складаеце ГОСПАДУ ахвяру з новага збожжа ў сьвята Тыдняў, таксама зьбярыце сьвяты сход, і ў той дзень ня будзеце рабіць ніякай работы.<verse eid="NUM 28:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 28:27" /> Складзіцё тады ў ахвяру цэласпаленьня на мілы пах ГОСПАДУ двух бычкоў, барана і сем аднагадовых ягнят без заганы.<verse eid="NUM 28:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 28:28" /> І дадасьцё ахвяру хлебную: пшанічную муку, запраўленую алеем; тры дзясятыя (эфы) на аднаго бычка,<verse eid="NUM 28:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 28:29" /> дзьве дзясятыя на барана і па адной дзясятай на кожнае з сямі ягнят.<verse eid="NUM 28:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 28:30" /> І казла [у ахвяру за грэх] для ачышчэньня вашага.<verse eid="NUM 28:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 28:31" /> Апрача штодзённай ахвяры цэласпаленьня, і ахвяры хлебнай, і ахвяры вадкай, складайце ўсё гэта ў ахвяру; павінны яны быць без заганы.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="cl">Лікі 29</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 29:1" /> У першы дзень сёмага месяца няхай будзе ў вас сьвяты сход; у той дзень не рабіце ніякай работы, бо дзень гэты — дзень трубнага гуку.<verse eid="NUM 29:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 29:2" /> Складзіцё ахвяру цэлампаленьня на мілы пах ГОСПАДУ: аднаго бычка, барана і сем ягнят аднагадовых без заганы,<verse eid="NUM 29:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 29:3" /> а таксама ахвяру хлебную: пшанічную муку, запраўленую алеем; тры дзясятыя [эфы] на аднаго бычка, дзьве дзясятыя на барана,<verse eid="NUM 29:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 29:4" /> і адну дзясятую на кожнае ягня.<verse eid="NUM 29:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 29:5" /> І казла як ахвяру за грэх, для ачышчэньня вашага.<verse eid="NUM 29:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 29:6" /> Апрача ахвяры цэлапаленьня на пачатак месяца разам з ахвяраю хлебнай і апрача штодзённай ахвяры цэласпаленьня, лучна з ахвяраю хлебнай і вадкай, складайце іх на мілы пах ГОСПАДУ.<verse eid="NUM 29:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 29:7" /> У дзясяты дзень таго сёмага месяца адбудзецца сьвяты сход і пост; нельга рабіць у той дзень ніякай работы.<verse eid="NUM 29:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 29:8" /> У ахвяру цэласпаленьня на мілы пах ГОСПАДУ складзіцё бычка, барана і сем гадавых ягнят без заганы,<verse eid="NUM 29:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 29:9" /> і ахвяру хлебную: пшанічную муку, запраўленую алеем; тры дзясятыя [эфы] на бычка, дзьве дзясятыя на барана,<verse eid="NUM 29:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 29:10" /> і адну дзясятую на кожнае з сямі ягнят.<verse eid="NUM 29:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 29:11" /> І таксама казла ў ахвяру за грэх, апрача таго, што ахвяроўваюць за праступак дзеля ачышчэньня і штодзённага цэласпаленьня разам з ахвярамі хлебнымі і вадкімі, на мілы пах ГОСПАДУ.<verse eid="NUM 29:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 29:12" /> У пятнаццаты дзень сёмага месяца адбудзецца сьвяты сход. Нельга ў той дзень рабіць ніякай работы. Будзеце сьвяткаваць сем дзён сьвята ГОСПАДА.<verse eid="NUM 29:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 29:13" /> У ахвяру цэласпаленьня складзіцё на мілы пах ГОСПАДУ трынаццаць бычкоў, два бараны, чатырнаццаць ягнят гадавых без заганы.<verse eid="NUM 29:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 29:14" /> І ахвяру хлебную: пшанічную муку, запраўленую алеем, тры дзясятыя [эфы] на кожнага бычка; дзьве дзясятыя на кожнага барана,<verse eid="NUM 29:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 29:15" /> i па адной дзясятай на кожнае з чатырнаццаці ягнят.<verse eid="NUM 29:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 29:16" /> І казла ў ахвяру за грэх, ня лічачы штодзённай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 29:17" /> У другі дзень [прынесіцё] дванаццаць бычкоў, два бараны і чатырнаццаць аднагадовых ягнят без заганы.<verse eid="NUM 29:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 29:18" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярай з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 29:19" /> І казла ў ахвяру за грэх, ня лічачы штодзённай ахвяры цэласпаленьня, ахвяраў хлебных і вадкіх.<verse eid="NUM 29:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 29:20" /> У трэці дзень — адзінаццаць бычкоў, два бараны і чатырнаццаць гадавых ягнят без заганы.<verse eid="NUM 29:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 29:21" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 29:22" /> І казла ў ахвяру за грэх, ня лічачы пастаяннай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 29:23" /> У чацьвёрты дзень — дзесяць бычкоў, два бараны і чатырнаццаць аднагадовых ягнят без заганы.<verse eid="NUM 29:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 29:24" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 29:25" /> І казла ў ахвяру за грэх, ня лічачы штодзённай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 29:26" /> У пяты дзень — дзевяць бычкоў, два бараны і чатырнаццаць аднагадовых ягнят без заганы.<verse eid="NUM 29:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 29:27" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 29:28" /> І казла ў ахвяру за грэх, ня лічачы пастаяннай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 29:29" /> У шосты дзень — восем бычкоў, два бараны і чатырнаццаць аднагадовых ягнят без заганы.<verse eid="NUM 29:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 29:30" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 29:31" /> І казла ў ахвяру за грэх, ня лічачы пастаяннай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 29:32" /> У сёмы дзень — сем бычкоў, два бараны і чатырнаццаць аднагадовых ягнят без заганы.<verse eid="NUM 29:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 29:33" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 29:34" /> І казла ў ахвяру за грэх, ня лічачы пастаяннай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 29:35" /> У восьмы дзень адбудзецца сьвяты сход; ня будзеце ніякай работы рабіць у той дзень.<verse eid="NUM 29:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 29:36" /> І складзіцё цэласпаленьне на мілы пах ГОСПАДУ: аднаго бычка, аднаго барана і сем аднагадовых ягнят без заганы.<verse eid="NUM 29:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 29:37" /> І ахвяру хлебную і ахвяру вадкую, лучна з ахвярамі з бычкоў, бараноў і ягнят, адпаведна да іх лічбы, паводле пастановы.<verse eid="NUM 29:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 29:38" /> І казла ў ахвяру за грэх, ня лічачы пастаяннай ахвяры цэласпаленьня і ахвяраў хлебных і вадкіх.<verse eid="NUM 29:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 29:39" /> Гэтыя ахвяры маеце складаць ГОСПАДУ пад час сьвятаў вашых, незалежна ад таго, што ахвяруеце паводле шлюбаваньняў вашых, або як дабравольныя дары на ахвяры цэласпаленьня, на ахвяры хлебныя, на ахвяры вадкія, і на ахвяры мірныя».<verse eid="NUM 29:39" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="cl">Лікі 30</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 30:1" /> І Майсей распавёў усё сынам Ізраіля, што яму ГОСПАД загадаў.<verse eid="NUM 30:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 30:2" /> І сказаў Майсей правадырам пакаленьняў Ізраіля: «Вось што загадаў ГОСПАД:<verse eid="NUM 30:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 30:3" /> Калі хто [з мужчынаў] пашлюбуе што ГОСПАДУ або зьвяжа сябе прысягай, няхай не парушыць словы свае, але ўсё, што абяцаў, споўніць.<verse eid="NUM 30:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 30:4" /> Калі жанчына шлюбавала штосьці ГОСПАДУ, або зьвязала сябе прысягай, і яна яшчэ ў доме бацькі свайго і маладых гадоў,<verse eid="NUM 30:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 30:5" /> то калі б бацька даведаўся пра шлюбаваньне, якое яна абяцала, або пра прысягу, якой яна зьвязала сябе, і ён прамаўчаў, яна зьвязаная шлюбаваньнем. Што яна шлюбавала або прысягала, няхай споўніць.<verse eid="NUM 30:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 30:6" /> Калі ў той дзень, калі пачуе бацька яе, ён забароніць ёй гэта, дык шлюбаваньні яе і прысягі будуць няважныя. Міласьцівы будзе ёй ГОСПАД, таму што бацька запярэчыў.<verse eid="NUM 30:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 30:7" /> Калі, аднак, выйдзе яна замуж, але зьвязана яна шлюбаваньнем або прысягай вуснаў сваіх, зьвязала яна душу сваю,<verse eid="NUM 30:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 30:8" /> і калі пачуе муж яе і, пачуўшы, не запярэчыць, то яна зьвязаная шлюба-ваньнем і павінна споўніць, што абяцала.<verse eid="NUM 30:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 30:9" /> А калі пачуў бы муж і запярэчыў у той жа дзень, то шлюбаваньні яе, якія дала, і словы, якімі зьвязала душу сваю, няважныя; няхай будзе ёй міласьцівы ГОСПАД.<verse eid="NUM 30:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 30:10" /> Што прыракалі б удовы або разьведзеныя — важнае, няхай споўняць.<verse eid="NUM 30:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 30:11" /> Калі жонка ў доме мужа зьвязала сябе шлюбаваньнем або прысягаю,<verse eid="NUM 30:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 30:12" /> і калі пра гэта даведаўся муж, і маўчаў, і не пярэчыў шлюбаваньню, няхай яна споўніць тое, што абяцала.<verse eid="NUM 30:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 30:13" /> А калі б ён запярэчыў, то яна не зьвязаная прысягай, бо муж супрацівіўся. Няхай будзе ёй міласьцівы ГОСПАД.<verse eid="NUM 30:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 30:14" /> Калі б яна шлюбавала або прысягай зьвязала сябе, ад волі мужа залежыць, ці споўніць яна гэта, ці не.<verse eid="NUM 30:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 30:15" /> А калі муж ведаў, але маўчаў, ды з дня на дзень адкладаў прысуд свой, то што яна прыракала або запрысягла, павінна споўніць, бо муж ведаў, але маўчаў.<verse eid="NUM 30:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 30:16" /> Калі б жа ён запярэчыў праз нейкі час пасьля таго, як даведаўся, адказны будзе ён за правіну сваю».<verse eid="NUM 30:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 30:17" /> Такія вось законы, якія перадаў ГОСПАД Майсею адносна мужа і жонкі, бацькі і дачкі, калі яна яшчэ ў юнацтве жыве ў доме бацькоў.<verse eid="NUM 30:17" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="cl">Лікі 31</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 31:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 31:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 31:2" /> «Адпомсьці за сыноў Ізраіля Мадыянцам, а потым далучыся да народу свайго».<verse eid="NUM 31:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 31:3" /> І адразу загадаў Майсей: «Узбройце спаміж сябе мужчынаў на вайну, каб яны маглі выканаць помсту ГОСПАДА над Мадыянцамі.<verse eid="NUM 31:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 31:4" /> Выбярыце па тысячы мужчынаў з кожнага пакаленьня Ізраіля і пашліце іх на вайну».<verse eid="NUM 31:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 31:5" /> І выдзелена было па тысячы з кожнага пакаленьня, значыць, дванаццаць тысячаў здольных да бою.<verse eid="NUM 31:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 31:6" /> Іх выправіў Майсей з Пінхасам, сынам Элеазара сьвятара. Даў ім таксама посуд сьвяты і трубы, каб у трывозе трубіць.<verse eid="NUM 31:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 31:7" /> Калі паводле загаду ГОСПАДА ваявалі яны супраць Мадыянцаў, выбілі яны ўсіх мужчынаў<verse eid="NUM 31:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 31:8" /> і валадароў іхніх: Эвія, Рэкема, Цура, Хура, Рэву, пяць валадароў гэтага народу, а таксама Білеама, сына Бэора, забілі мячом.<verse eid="NUM 31:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 31:9" /> І ўзялі яны ў палон жанчынаў іхніх і дзяцей, і як здабычу ўзялі ўсю жывёлу іхнюю і ўсю маёмасьць,<verse eid="NUM 31:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 31:10" /> а гарады, пасяленьні і табары іхнія спалілі агнём.<verse eid="NUM 31:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 31:11" /> І забралі яны здабычу сваю, як людзей, так і жывёлу.<verse eid="NUM 31:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 31:12" /> І прывялі яны палонных, і здабычу, і нарабаванае да Майсея і Элеазара сьвятара, і да ўсяе супольнасьці сыноў Ізраіля ў табар на раўнінах Мааву над Ярданам насупраць Ерыхону.<verse eid="NUM 31:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 31:13" /> Майсей, сьвятар Элеазар i ўсе князі супольнасьці выйшлі з табару на сустрэчу ім.<verse eid="NUM 31:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 31:14" /> І загневаўся Майсей на начальнікаў войска, на тысячнікаў і сотнікаў, якія вярталіся з вайны.<verse eid="NUM 31:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 31:15" /> І ён сказаў ім: «Чаму вы захавалі ўсіх жанчынаў?<verse eid="NUM 31:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 31:16" /> Ці ж не яны за намовай Білеама паганілі сыноў Ізраіля і нявернымі зрабілі вас перад ГОСПАДАМ праз Пэора, таму і нішчаны быў народ ГОСПАДАЎ?<verse eid="NUM 31:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 31:17" /> Дык забіце ўсіх дзяцей мужчынскага роду i ўсіх жанчынаў, якія жылі з мужчынамі.<verse eid="NUM 31:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 31:18" /> Дзяўчат жа і ўсіх жанчынаў, ня жыўшых з мужчынамі, пакіньце сабе.<verse eid="NUM 31:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 31:19" /> І вы будзьце па-за табарам сем дзён. Хто забіў чалавека або дакрануўся да забітага, мусіць ачысьціцца ў трэйці і ў сёмы дзень, як вы, так і палонныя вашыя.<verse eid="NUM 31:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 31:20" /> Таксама адзеньне і ўсе вырабы са скуры, і што зроблена з воўны казінай, i ўсе драўляныя рэчы павінны быць ачышчаны».<verse eid="NUM 31:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 31:21" /> Так вось сказаў Элеазар сьвятар ваярам, якія былі на вайне: «Такое прыказаньне закону, якое загадаў ГОСПАД Майсею:<verse eid="NUM 31:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 31:22" /> Золата, срэбра, медзь, жалеза, цына, волава<verse eid="NUM 31:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 31:23" /> і агулам усё, што можа прайсьці праз агонь, няхай агнём будзе ачышчана. Што не пераносіць агня, няхай будзе асьвечана вадой ачышчэньня.<verse eid="NUM 31:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 31:24" /> У сёмы дзень памыеце адзеньне вашае і, ужо ачышчаныя, увойдзеце ў табар».<verse eid="NUM 31:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 31:25" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 31:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 31:26" /> «Палічыце ўсё, што здабыта, ад чалавека да жывёлы, ты і Элеазар сьвятар, і начальнікі родаў.<verse eid="NUM 31:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 31:27" /> І падзеліш здабычу папалам паміж тымі, што ваявалі і выйшлі на вайну, і паміж ўсёй грамадой.<verse eid="NUM 31:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 31:28" /> І выдзеліш частку ГОСПАДУ ад тых, што ваявалі, і якія былі на вайне — адно жывое на пяцьсот, як з людзей, так і з валоў, аслоў і авечак.<verse eid="NUM 31:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 31:29" /> І дасі гэта Элеазару сьвятару як ахвяру ГОСПАДУ.<verse eid="NUM 31:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 31:30" /> А з паловы сыноў Ізраіля вазьмі адну частку з пяцідзесяці: з людзей, валоў, аслоў і авечак, з усяго жывога, і дасі гэта лявітам, якія служаць пры Сялібе ГОСПАДА».<verse eid="NUM 31:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 31:31" /> Майсей і сьвятар Элеазар усё выканалі, як ім загадаў ГОСПАД.<verse eid="NUM 31:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 31:32" /> А здабыча, якую ваяры здабылі, лічыла шэсьцьсот семдзесят пяць тысячаў авечак,<verse eid="NUM 31:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 31:33" /> семдзесят дзьве тысячы валоў,<verse eid="NUM 31:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 31:34" /> шэсьцьдзесят адну тысячу аслоў,<verse eid="NUM 31:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 31:35" /> а людзей, значыць дзяўчат, якія яшчэ не жылі з мужчынамі, было разам трыццаць дзьве тысячы.<verse eid="NUM 31:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 31:36" /> Палова дадзена была тым, што былі на вайне: трыста трыццаць сем тысячаў пяцьсот авечак,<verse eid="NUM 31:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 31:37" /> і з гэтага ГОСПАДУ далі шэсьцьсот семдзесят пяць авечак,<verse eid="NUM 31:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 31:38" /> трыццаць шэсьць тысячаў валоў, з чаго ГОСПАДУ далі семдзесят два,<verse eid="NUM 31:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 31:39" /> трыццаць тысяч пяцьсот аслоў, з якіх ГОСПАДУ далі семдзесят два,<verse eid="NUM 31:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 31:40" /> і шаснаццаць тысячаў дзяўчат, з якіх ГОСПАДУ далі трыццаць дьзве асобы.<verse eid="NUM 31:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 31:41" /> І аддаў Майсей сьвятару Элеазару дары, прызначаныя ў ахвяру ГОСПАДУ, па загаду, дадзеным ГОСПАДАМ Майсею.<verse eid="NUM 31:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 31:42" /> А палова для сыноў Ізраіля, якую ўзяў Майсей у тых, што былі на вайне, складала:<verse eid="NUM 31:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 31:43" /> трыста трыццаць сем тысячаў пяцьсот авечак,<verse eid="NUM 31:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 31:44" /> трыццаць шэсьць тысячаў валоў,<verse eid="NUM 31:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 31:45" /> трыццаць тысячаў пяцьсот аслоў<verse eid="NUM 31:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 31:46" /> і шаснаццаць тысячаў дзяўчат.<verse eid="NUM 31:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 31:47" /> З гэтае часткі, належнай сынам Ізраіля, узяў Майсей адну пяцідзясятую частку з людзей і жывёлы і аддаў яе лявітам, якiя служылi пры Сялібе ГОСПАДА, як загадаў ГОСПАД Майсею.<verse eid="NUM 31:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 31:48" /> І вось прыйшлі да Майсея ваяры, начальнікі дружынаў войска, тысячнікі і сотнікі,<verse eid="NUM 31:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 31:49" /> і сказалі Майсею: «Мы, слугі твае, праверылі лічбу ваяроў, якіх мы мелі пад рукой сваёй, і выявілася, што ні адзін не загінуў.<verse eid="NUM 31:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 31:50" /> Дзеля гэтае прычыны прынесьлі мы ў ахвяру ГОСПАДУ ўсе знойдзеныя вырабы з золата: бранзалеты, наплечнікі, пярсьцёнкі, кольцы і нашыйнікі — для ачышчэньня душаў нашых перад ГОСПАДАМ».<verse eid="NUM 31:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 31:51" /> І ўзялі Майсей і сьвятар Элеазар золата і ўсе каштоўнасьці.<verse eid="NUM 31:51" /></para>
  <para style="m">
    <verse number="52" style="v" pubnumber="52." sid="NUM 31:52" /> Золата, аддадзенага тысячнікамі і сотнікамі ў ахвяру ГОСПАДУ, было шаснаццаць тысячаў семсот пяцьдзясят сыкляў.<verse eid="NUM 31:52" /></para>
  <para style="m">
    <verse number="53" style="v" pubnumber="53." sid="NUM 31:53" /> А кожны з ваяроў меў яшчэ свой здабытак.<verse eid="NUM 31:53" /></para>
  <para style="m">
    <verse number="54" style="v" pubnumber="54." sid="NUM 31:54" /> Дык Майсей і сьвятар Элеазар узялі золата ад тысячнікаў і занесьлі ў Намёт Спатканьня як памятны дар сыноў Ізраіля для ГОСПАДА.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="cl">Лікі 32</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 32:1" /> Сыны Рубэна і Гада мелі вельмі шмат жывёлы. Калі яны ўбачылі зямлю Язэр і Гілеад, прыдатныя на гадоўлю быдла,<verse eid="NUM 32:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 32:2" /> прыйшлі яны да Майсея, і Элеазара, і начальнікаў супольнасьці і сказалі ім:<verse eid="NUM 32:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 32:3" /> «Вось, Атарот, Дыбон, Язэр, Німра, Хешбон, Элеале, Сэбам, Нэбо і Бэон,<verse eid="NUM 32:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 32:4" /> зямля, якую ГОСПАД даў супольнасьці Ізраіля, край ураджайны, прыдатны для гадоўлі быдла, і вось мы, слугі твае, маем шмат жывёлы».<verse eid="NUM 32:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 32:5" /> І сказалі: «Калі мы знайшлі ласку у цябе, дай гэтую зямлю слугам тваім на ўласнасьць, не пераводзь нас за Ярдан».<verse eid="NUM 32:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 32:6" /> Адказаў ім Майсей: «Няўжо калі браты вашыя пойдуць ваяваць, вы тут будзеце сядзець?<verse eid="NUM 32:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 32:7" /> Чаму вы стрымліваеце сэрца сыноў Ізраіля, каб ня мелі яны адвагі перайсьці ў зямлю, якую ім мае даць ГОСПАД?<verse eid="NUM 32:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 32:8" /> Ці ня так зрабілі бацькі вашыя, калі паслаў я іх з Кадэш-Барнэа выведаць зямлю?<verse eid="NUM 32:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 32:9" /> Калі дайшлі яны аж да даліны Эшколь, выведаўшы ўвесь той край, збунтавалі яны сэрцы сыноў Ізраіля, каб не ішлі ў зямлю, якую прызначыў ім ГОСПАД.<verse eid="NUM 32:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 32:10" /> І ГОСПАД узгарэўся гневам і сказаў:<verse eid="NUM 32:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 32:11" /> “Ня ўбачаць гэтыя людзі, якія выйшлі з Эгіпту ў дваццаць гадоў і вышэй, тае зямлі, якую ГОСПАД пад прысягай абяцаў Абрагаму, Ісааку і Якубу, бо не захацелі Мяне слухаць,<verse eid="NUM 32:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 32:12" /> за выняткам Халева, сына Ефунны, Кенезеяніна, і Егошуа, сына Нуна, бо яны слухалі ГОСПАДА!”<verse eid="NUM 32:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 32:13" /> І гневаўся ГОСПАД на Ізраіля, і вадзіў яго па пустыні сорак гадоў, пакуль ня вымерла ўсё пакаленьне, якое рабіла зло перад абліччам ГОСПАДА.<verse eid="NUM 32:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 32:14" /> Так і вы, род ліхіх людзей, як і бацькі вашыя, збунтаваліся, каб павялічыць лютасьць гневу ГОСПАДАВАГА на Ізраіля.<verse eid="NUM 32:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 32:15" /> Калі зноў не захочаце слухаць Яго, зноў будзе Ён вадзіць вас па пустыні вакол, і вы будзеце прычынай гібелі ўсіх».<verse eid="NUM 32:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 32:16" /> Яны падыйшлі бліжэй да яго і сказалі: «Мы пабудуем загоны для статкаў нашых і гарады для дзяцей нашых,<verse eid="NUM 32:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 32:17" /> а самі, узброеныя і прыгатаваныя, пойдзем ваяваць перад сынамі Ізраіля, пакуль не ўвядзём іх у месцы іхнія. Дзеці нашыя будуць жыць у гарадах абмураваных дзеля небясьпекі ад жыхароў зямлі гэтай.<verse eid="NUM 32:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 32:18" /> Ня вернемся мы ў дамы нашыя, пакуль не авалодаюць сыны Ізраіля ўласнасьцю сваёй.<verse eid="NUM 32:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 32:19" /> Мы ня будзем шукаць уласнасьці за Ярданам або далей, бо ўжо маем спадчыну сваю на ўсходнім беразе Ярдана».<verse eid="NUM 32:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 32:20" /> Майсей адказаў ім: «Калі ўчыніце так, як вы сказалі, калі будзеце дзеля ГОСПАДА гатовыя да бою,<verse eid="NUM 32:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 32:21" /> і калі кожны з вас, узброены, пяройдзе Ярдан, аж пакуль ГОСПАД ня выганіць ворагаў Сваіх перад Сабою,<verse eid="NUM 32:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 32:22" /> і, пасьля авалоданьня ўсёй зямлёй, вернецеся ў гэтую зямлю, тады ня будзеце вінаватыя перад ГОСПАДАМ і перад Ізраілем і возьмеце гэтую зямлю на ўласнасьць перад ГОСПАДАМ.<verse eid="NUM 32:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 32:23" /> А калі тое, што кажаце, ня споўніце, вы дапусьціцеся грэху перад ГОСПАДАМ, і ведайце, што грэх ваш знойдзе вас.<verse eid="NUM 32:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 32:24" /> Дык будуйце гарады дзецям вашым і загоны авечкам вашым, але тое, што абяцалі, споўніце».<verse eid="NUM 32:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 32:25" /> Сыны Гада і Рубэна сказалі Майсею: «Мы, слугі твае, зробім усё, што загадвае гаспадар наш.<verse eid="NUM 32:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 32:26" /> Нашыя дзеці, жанчыны, жывёлы і стады застануцца у гарадах Гілеадзкіх,<verse eid="NUM 32:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 32:27" /> а слугі твае, усе ўзброеныя, пойдуць перад абліччам ГОСПАДА на вайну, як загадаў гаспадар наш».<verse eid="NUM 32:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 32:28" /> І загадаў Майсей сьвятару Элеазару, і Егошуа, сыну Нуна, і начальнікам родаў усіх пакаленьняў Ізраіля,<verse eid="NUM 32:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 32:29" /> і сказаў ён ім: «Калі сыны Гада і сыны Рубэна разам з вамі пяройдуць раку Ярдан, усе ўзброеныя, каб па волі ГОСПАДА ваяваць, і вы завалодаеце зямлёю, дайце ім Гілеад на ўласнасьць.<verse eid="NUM 32:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 32:30" /> А калі не захочуць разам з вамі, узброеныя, ісьці ў зямлю Ханаан, атрымаюць пасяленьні паміж вас».<verse eid="NUM 32:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 32:31" /> І адказалі сыны Гада і сыны Рубэна: «Як загадаў ГОСПАД слугам Сваім, так і зробім.<verse eid="NUM 32:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 32:32" /> Узброеныя, самі пойдзем перад абліччам ГОСПАДА ў зямлю Ханаан, і возьмем спадчыну нашую за Ярданам».<verse eid="NUM 32:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 32:33" /> І даў Майсей сынам Гада і Рубэна і палове пакаленьня Манасы, сына Язэпа, валадарства Сыгона, валадара Амарэйцаў, і валадарства Ога, валадара Башану, зямлю з гарадамі і гарады ваколічныя.<verse eid="NUM 32:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 32:34" /> І збудавалі сыны Гада Дыбон, Атарот, Араэр,<verse eid="NUM 32:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 32:35" /> Атрот-Шафан, Язэр і Ёгбэгу,<verse eid="NUM 32:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 32:36" /> і Бэт-Німру і Бэт-Гаран, абмураваныя гарады і загоны для статкаў сваіх.<verse eid="NUM 32:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 32:37" /> А сыны Рубэна збудавалі Хешбон, Элеале і Кірыятаім,<verse eid="NUM 32:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 32:38" /> Нэбо, Баал-Мэон, зьмяніўшы іх назвы, Сібму, і далі назвы гарадам, якія адбудавалі.<verse eid="NUM 32:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 32:39" /> Сыны Махіра, сына Манасы, пайшлі ў Гілеад і занялі яго, выгнаўшы Амарэйцаў, што жылі ў ім.<verse eid="NUM 32:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 32:40" /> І даў Майсей Гілеад Махіру, сыну Манасы, які абжыўся ў ім.<verse eid="NUM 32:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 32:41" /> А Яір, сын Манасы, пайшоў і заняў мястэчкі Амарэйцаў, якія назваў Хават-Яір.<verse eid="NUM 32:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 32:42" /> Нобах таксама вырушыў, і захапіў Кенат з ваколіцамі ягонымі, і назваў яго імем сваім, Нобах.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="cl">Лікі 33</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 33:1" /> Гэтыя вось месцы прыпынку сыноў Ізраіля, якія выйшлі з Эгіпту дружынамі на чале з Майсеем і Ааронам.<verse eid="NUM 33:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 33:2" /> Майсей запісаў падарожжа іх па месцы табараў, з якіх яны па загаду ГОСПАДА выходзілі. Вось гэтыя месцы:<verse eid="NUM 33:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 33:3" /> Вось жа ў першы месяц, у пятнаццаты дзень першага месяца, у другі дзень Пасхі вырушылі сыны Ізраіля з Рамсэсу, ведзеныя рукой Найвышэйшага на вачах усіх Эгіпцянаў.<verse eid="NUM 33:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 33:4" /> Эгіпцяне ў той час хавалі ўсіх першародных сваіх, якіх забіў ГОСПАД, калі Ён учыніў суд над ідаламі іхнімі.<verse eid="NUM 33:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 33:5" /> І вырушылі Ізраільцяне з Рамсэсу і расклаліся табарам у Сукоце.<verse eid="NUM 33:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 33:6" /> З Сукоту прыйшлі яны ў Этам, што на мяжы пустыні.<verse eid="NUM 33:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 33:7" /> Адсюль, вырушыўшы, прыйшлі ў Пі-Гахірот, што каля Баал-Цэфону, ды раскла-ліся табарам перад Мігдолам.<verse eid="NUM 33:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 33:8" /> Выйшаўшы з Пі-Гахіроту, перайшлі яны сярэдзінай мора ў пустыню, і тры дні ішлі пустыняй, і расклаліся табарам у Мары.<verse eid="NUM 33:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 33:9" /> Выйшаўшы з Мары, прыйшлі ў Элім, дзе было дванаццаць крыніцаў водных і семдзясят пальмаў, і там расклаліся табарам.<verse eid="NUM 33:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 33:10" /> Выйшаўшы з Эліму, разлажыліся табарам каля Мора Чырвонага.<verse eid="NUM 33:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 33:11" /> І выйшлі ад Мора Чырвонага, і разлажыліся табарам у пустыні Сін.<verse eid="NUM 33:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 33:12" /> Адтуль выйшлі і прыйшлі ў Дафку.<verse eid="NUM 33:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 33:13" /> Выйшаўшы з Дафкi, разлажыліся табарам у Алушы.<verse eid="NUM 33:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 33:14" /> Выйшаўшы з Алушы, паставілі намёты ў Рэфідыме, дзе не было вады для піцьця.<verse eid="NUM 33:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 33:15" /> Вырушыўшы з Рэфідыму, разлажыліся табарам у пустыні Сынай.<verse eid="NUM 33:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 33:16" /> Вырушылі з пустыні Сынай і прыйшлі ў Кібрат-Гатаву.<verse eid="NUM 33:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 33:17" /> Вырушыўшы з Кібрат-Гатавы, разлажыліся табарам у Хацэроце.<verse eid="NUM 33:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 33:18" /> А з Хацэроту прыйшлі ў Рытму.<verse eid="NUM 33:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 33:19" /> Выйшлі з Рытмы і зрабілі табар ў Рымон-Пэрэсе.<verse eid="NUM 33:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 33:20" /> Выйшлі з Рымон-Пэрэса і разлажыліся табарам у Лібне.<verse eid="NUM 33:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 33:21" /> З Лібны выйшлі і зрабілі табар ў Рысе.<verse eid="NUM 33:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 33:22" /> З Рысы выйшлі і разлажыліся табарам у Кэгеляце.<verse eid="NUM 33:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 33:23" /> Выйшаўшы з Кэгеляты, паставілі намёты на гары Шэфэр.<verse eid="NUM 33:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 33:24" /> І, зыйшоўшы з гары Шэфэр, разлажыліся табарам у Харадзе.<verse eid="NUM 33:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 33:25" /> Адтуль выйшаўшы, зрабілі табар у Макэлёце.<verse eid="NUM 33:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 33:26" /> Выйшаўшы з Макэлёту, разлажыліся табарам у Тахаце.<verse eid="NUM 33:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 33:27" /> Выйшаўшы з Тахату, паставілі намёты ў Тэраху.<verse eid="NUM 33:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 33:28" /> Выйшлі з Тэраху і разлажыліся табарам у Мітцы.<verse eid="NUM 33:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 33:29" /> Вырушылі з Міткі і зрабілі табар у Хашмоне.<verse eid="NUM 33:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 33:30" /> Вырушыўшы з Хашмону, прыйшлі ў Масэрот.<verse eid="NUM 33:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 33:31" /> Выйшаўшы з Масэроту, разлажыліся табарам у Бэнэ-Яакане.<verse eid="NUM 33:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 33:32" /> З Бэнэ-Яакану прыйшлі ў Хар-Гагідгад.<verse eid="NUM 33:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 33:33" /> Адсюль вырушыўшы, паставілі намёты ў Ётбаце.<verse eid="NUM 33:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 33:34" /> З Ётбаты прыйшлі ў Аброну.<verse eid="NUM 33:34" /></para>
  <para style="m">
    <verse number="35" style="v" pubnumber="35." sid="NUM 33:35" /> Выйшаўшы з Аброны, разлажыліся табарам у Ецыён-Гебэры.<verse eid="NUM 33:35" /></para>
  <para style="m">
    <verse number="36" style="v" pubnumber="36." sid="NUM 33:36" /> Адсюль вырушыўшы, прыйшлі ў пустыню Сін, або Кадэш.<verse eid="NUM 33:36" /></para>
  <para style="m">
    <verse number="37" style="v" pubnumber="37." sid="NUM 33:37" /> Вырушылі з Кадэшу і паставілі намёты на гары Гор, на мяжы зямлі Эдому.<verse eid="NUM 33:37" /></para>
  <para style="m">
    <verse number="38" style="v" pubnumber="38." sid="NUM 33:38" /> Па загаду ГОСПАДА Аарон сьвятар узыйшоў на гару Гор і там памёр у саракавым годзе пасьля выхаду сыноў Ізраіля, у першы дзень пятага месяца.<verse eid="NUM 33:38" /></para>
  <para style="m">
    <verse number="39" style="v" pubnumber="39." sid="NUM 33:39" /> Меў ён сто дваццаць тры гады, калі памёр на гары Гор.<verse eid="NUM 33:39" /></para>
  <para style="m">
    <verse number="40" style="v" pubnumber="40." sid="NUM 33:40" /> Валадар Араду, Хананеец, які жыў у Нэгеве ў зямлі Ханаан, пачуў у той час, што надыходзяць сыны Ізраіля.<verse eid="NUM 33:40" /></para>
  <para style="m">
    <verse number="41" style="v" pubnumber="41." sid="NUM 33:41" /> Яны зыйшлі з гары Гор і зрабілі табар у Цальмоне.<verse eid="NUM 33:41" /></para>
  <para style="m">
    <verse number="42" style="v" pubnumber="42." sid="NUM 33:42" /> Адтуль вырушылі ў Пунон.<verse eid="NUM 33:42" /></para>
  <para style="m">
    <verse number="43" style="v" pubnumber="43." sid="NUM 33:43" /> З Пунону выйшлі і прыйшлі ў Абот.<verse eid="NUM 33:43" /></para>
  <para style="m">
    <verse number="44" style="v" pubnumber="44." sid="NUM 33:44" /> З Аботу прыйшлі ў Іе-Абарым, што на мяжы Мааву.<verse eid="NUM 33:44" /></para>
  <para style="m">
    <verse number="45" style="v" pubnumber="45." sid="NUM 33:45" /> Вырушыўшы з Іе-Абарыму, разлажыліся табарам у Дыбон-Гадзе.<verse eid="NUM 33:45" /></para>
  <para style="m">
    <verse number="46" style="v" pubnumber="46." sid="NUM 33:46" /> Адтуль выйшаўшы, паставілі намёты ў Альмон-Дыблатаіме.<verse eid="NUM 33:46" /></para>
  <para style="m">
    <verse number="47" style="v" pubnumber="47." sid="NUM 33:47" /> Выйшаўшы з Альмон-Дэблатаіму, прыйшлі пад гару Абарым, насупраць Нэво.<verse eid="NUM 33:47" /></para>
  <para style="m">
    <verse number="48" style="v" pubnumber="48." sid="NUM 33:48" /> Выйшаўшы з гары Абарым, прыйшлі на раўніны Мааву над Ярдан насупраць Ерыхону.<verse eid="NUM 33:48" /></para>
  <para style="m">
    <verse number="49" style="v" pubnumber="49." sid="NUM 33:49" /> Там расклаліся табарам паміж Бэт-Гаешымотам і Абэль-Шытымам на раўнінах Мааву.<verse eid="NUM 33:49" /></para>
  <para style="m">
    <verse number="50" style="v" pubnumber="50." sid="NUM 33:50" /> Там вось сказаў ГОСПАД Майсею:<verse eid="NUM 33:50" /></para>
  <para style="m">
    <verse number="51" style="v" pubnumber="51." sid="NUM 33:51" /> «Загадай сынам Ізраіля і скажы ім: “Калі пяройдзеце раку Ярдан і ўвойдзеце ў зямлю Ханаан,<verse eid="NUM 33:51" /></para>
  <para style="m">
    <verse number="52" style="v" pubnumber="52." sid="NUM 33:52" /> выганіце перад сабою ўсіх жыхароў той зямлі, паламіце ўсе іхнія выявы ды разьбіце ўсіх ідалаў, і ўсе ўзгоркі спусташыце.<verse eid="NUM 33:52" /></para>
  <para style="m">
    <verse number="53" style="v" pubnumber="53." sid="NUM 33:53" /> Завалодайце зямлёй і абжывайцеся на ёй, бо Я даў вам яе на ўласнасьць.<verse eid="NUM 33:53" /></para>
  <para style="m">
    <verse number="54" style="v" pubnumber="54." sid="NUM 33:54" /> Падзяліце яе паміж вашымі пака-леньнямі, большаму пакаленьню – большую частку, меншаму – меншую. Як жэрабя выпадзе, так будзе падзелена спадчына. Па пакаленьнях і родах будзе яна падзелена.<verse eid="NUM 33:54" /></para>
  <para style="m">
    <verse number="55" style="v" pubnumber="55." sid="NUM 33:55" /> Калі ж не захочаце выгнаць жыхароў зямлі гэтай, і калі яны застануцца, будуць яны вам цернямі ў вачах вашых i калючкамі ў баках вашых, будуць яны ўціскаць вас у зямлі пражываньня вашага.<verse eid="NUM 33:55" /></para>
  <para style="m">
    <verse number="56" style="v" pubnumber="56." sid="NUM 33:56" /> І тады тое, што Я маніўся ім зрабіць, вам зраблю”».<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="cl">Лікі 34</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 34:1" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 34:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 34:2" /> «Загадай сынам Ізраіля і скажы ім: “Калі ўвойдзеце ў зямлю Ханаан, тады абшар, які вы жэрабем падзеліце на ўласнасьць, будзе ў гэтых межах.<verse eid="NUM 34:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 34:3" /> Паўднёвая мяжа будзе ад пустыні Сін, уздоўж Эдому, і будзе ісьці на ўсходзе Мора Салёнага.<verse eid="NUM 34:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 34:4" /> Потым зьверне на поўдзень да ўзвышша Акраббім, і далей пойдзе праз Сін на поўдзень ад Кадэш-Барнэа. Адтуль пойдзе да Хацар-Адару і далей да Ацмону.<verse eid="NUM 34:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 34:5" /> Ад Ацмону паверне мяжа да ручаю Эгіпецкага і спыніцца на беразе Вялікага Мора.<verse eid="NUM 34:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 34:6" /> Вашай мяжой заходняй будзе для вас Вялікае Мора, гэта будзе ваша заходняя мяжа.<verse eid="NUM 34:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 34:7" /> На поўначы будзе ў вас мяжа ад Вялікага Мора пачынаючы і аж да гары Гор,<verse eid="NUM 34:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 34:8" /> і ад гары Гор павядзіце мяжу да Хамату і далей, да мяжы Цэдаду.<verse eid="NUM 34:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 34:9" /> Потым пойдзе мяжа да Зіфрону і Гацар-Энану. Такая будзе мяжа з поўначы.<verse eid="NUM 34:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 34:10" /> Усходнюю мяжу правядзіце ад Гацар-Энану да Шэфама,<verse eid="NUM 34:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 34:11" /> і ад Шэфама пойдзе мяжа ў накірунку Гарбэль на ўсход ад Аіну. Адтуль пойдзе далей праз горы на ўсход ад мора Кінэрэт,<verse eid="NUM 34:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 34:12" /> потым уздоўж Ярдану і спыніцца пры Моры Салёным. Гэта будзе зямля вашая з межамі сваімі”».<verse eid="NUM 34:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 34:13" /> І загадаў Майсей сынам Ізраіля: «Гэта вось зямля, якую маеце падзяліць жэрабем, і якую загадаў ГОСПАД даць дзевяці пакаленьням і палове пакаленьня.<verse eid="NUM 34:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 34:14" /> Бо пакаленьне сыноў Рубэна па сем’ях сваіх, і пакаленьне сыноў Гада па сем’ях сваіх, i палова пакаленьня Манасы атрымалі ўжо спадчыну сваю.<verse eid="NUM 34:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 34:15" /> Гэтыя два і палова пакаленьня ўзялі спадчыну сваю з таго боку Ярдану насупраць Ерыхону на ўсход».<verse eid="NUM 34:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 34:16" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 34:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 34:17" /> «Вось гэта імёны людзей, якія падзеляць вам зямлю: Элеазар сьвятар і Егошуа, сын Нуна.<verse eid="NUM 34:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 34:18" /> І возьмеце па аднаму князю з кожнага пакаленьня, каб падзяліць зямлю на ўласнасьць.<verse eid="NUM 34:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 34:19" /> Вось імёны тых людзей: з пакаленьня Юды — Халеў, сын Ефунны,<verse eid="NUM 34:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 34:20" /> з пакаленьня Сымона — Шэлюміэль, сын Амігуда,<verse eid="NUM 34:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 34:21" /> з пакаленьня Бэн’яміна — Элідад, сын Кісьлёна,<verse eid="NUM 34:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 34:22" /> з пакаленьня Дана — Букі, сын Ёглі,<verse eid="NUM 34:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 34:23" /> з сыноў Язэпа, з пакаленьня Манасы — Ханіэль, сын Эфода,<verse eid="NUM 34:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 34:24" /> з пакаленьня Эфраіма — Камуэль, сын Шыфтана,<verse eid="NUM 34:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 34:25" /> з пакаленьня Завулёна — Эліцафан, сын Парнаха,<verse eid="NUM 34:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 34:26" /> з пакаленьня Ісахара — Пальтыэль, сын Азана,<verse eid="NUM 34:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 34:27" /> з пакаленьня Асэра — Ахігуд, сын Шэломіі,<verse eid="NUM 34:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 34:28" /> з пакаленьня Нэфталі — Пэдагель, сын Амігуда».<verse eid="NUM 34:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 34:29" /> Гэта вось тыя, якім загадаў ГОСПАД падзяліць зямлю Ханаан між сыноў Ізраіля.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="cl">Лікі 35</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 35:1" /> І сказаў ГОСПАД Майсею на раўнінах Мааву каля Ярдану насупраць Ерыхону:<verse eid="NUM 35:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 35:2" /> «Загадай сынам Ізраіля, каб далі лявітам у спадчыну гарады, у якіх яны б жылі, і палі кругом гарадоў.<verse eid="NUM 35:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 35:3" /> У гарадах будуць жыць, а ваколіцы будуць пашай для жывёлы і для ўсяго быдла іхняга.<verse eid="NUM 35:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 35:4" /> Ад муроў гарадзкіх яны маюць цягнуцца на тысячу локцяў ушыркі.<verse eid="NUM 35:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 35:5" /> Адмерайце за горадам дзьве тысячы локцяў з боку ўсходняга, дзьве тысячы локцяў з боку паўднёвага, дзьве тысячы локцяў з боку заходняга і дзьве тысячы локцяў з боку паўночнага, каб сам горад быў пасярэдзіне; гэта будуць палі вакол тых гарадоў.<verse eid="NUM 35:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 35:6" /> Гарады, якія аддасьцё лявітам, будуць шэсьць гарадоў прыбежышча, каб забойца мог у іх схавацца, і апрача іх яшчэ сорак два гарады.<verse eid="NUM 35:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 35:7" /> Лічба гарадоў, якія разам з палямі будуць належаць лявітам, будзе сорак восем.<verse eid="NUM 35:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 35:8" /> Пры выбары гарадоў, якія аддасьцё са спадчыны сыноў Ізраіля, так будзеце вырашаць: ад большага пакаленьня — большую іх лічбу, ад меншага — меншую. Кожнае пакаленьне павінна аддаць лявітам паводле вялікасьці атрыманае спадчыны адпаведную лічбу гарадоў».<verse eid="NUM 35:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 35:9" /> І сказаў ГОСПАД Майсею:<verse eid="NUM 35:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 35:10" /> «Аб’яві сынам Ізраіля і скажы ім: “Калі пяройдзеце праз Ярдан у зямлю Ханаан,<verse eid="NUM 35:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 35:11" /> выбярыце сабе гарады, якія маюць быць прыбежышчам уцекачам, што, ня хочучы, пралілі кроў.<verse eid="NUM 35:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 35:12" /> Гэтыя гарады будуць вам гарадамі-прыбежышчамі ад мсьціўцаў, і забойца захавае жыцьцё, дакуль ня стане перад судом супольнасьці.<verse eid="NUM 35:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 35:13" /> Што да гарадоў, якія маеце зрабіць гарадамі прыбежышча, павінна быць іх шэсьць.<verse eid="NUM 35:13" /></para>
  <para style="m">
    <verse number="14" style="v" pubnumber="14." sid="NUM 35:14" /> Тры будуць за Ярданам, а тры — у зямлі Ханаан як гарады прыбежышча.<verse eid="NUM 35:14" /></para>
  <para style="m">
    <verse number="15" style="v" pubnumber="15." sid="NUM 35:15" /> Іх будзе шэсьць, каб маглі да іх уцякаць тыя, што ненаўмысна пралілі кроў: як сыны Ізраіля, так і прыбыльцы або падарожнікі.<verse eid="NUM 35:15" /></para>
  <para style="m">
    <verse number="16" style="v" pubnumber="16." sid="NUM 35:16" /> Калі хто ўдарыць каго жалезам, што той памрэ, дык той, хто ўдарыў, — забойца, ён павінен памерці.<verse eid="NUM 35:16" /></para>
  <para style="m">
    <verse number="17" style="v" pubnumber="17." sid="NUM 35:17" /> Калі хто каго каменем ударыў, якім можна забіць, і забіў, падобна будзе пакараны.<verse eid="NUM 35:17" /></para>
  <para style="m">
    <verse number="18" style="v" pubnumber="18." sid="NUM 35:18" /> Калі хто каго паленам так ударыў, што той памёр, — ён забойца. І будзе ён пакараны сьмерцю.<verse eid="NUM 35:18" /></para>
  <para style="m">
    <verse number="19" style="v" pubnumber="19." sid="NUM 35:19" /> Мсьціўца за кроў заб’е забойцу; дзе толькі зловіць яго, можа яго забіць.<verse eid="NUM 35:19" /></para>
  <para style="m">
    <verse number="20" style="v" pubnumber="20." sid="NUM 35:20" /> Калі хто з нянавісьці напаў на чалавека, або кінуў у яго штосьці з намерам забіць, так, што той памёр,<verse eid="NUM 35:20" /></para>
  <para style="m">
    <verse number="21" style="v" pubnumber="21." sid="NUM 35:21" /> або калі хто ў злосьці ўдарыў кулаком, што той памёр, тады той, хто ўдарыў, мусіць быць пакараны сьмерцю, бо ён — забойца; і мсьціўца за кроў можа яго забіць, калі сустрэне.<verse eid="NUM 35:21" /></para>
  <para style="m">
    <verse number="22" style="v" pubnumber="22." sid="NUM 35:22" /> Калі ж хто прыпадкам і без нянавісьці ўдарыў каго або кінуў у яго чым-колечы ненаўмысна,<verse eid="NUM 35:22" /></para>
  <para style="m">
    <verse number="23" style="v" pubnumber="23." sid="NUM 35:23" /> або, ня бачачы яго, пусьціў у яго каменем, які можа забіць, і ударыў яго так, што той памёр, але ён ня быў яго ворагам ды не хацеў яму зла,<verse eid="NUM 35:23" /></para>
  <para style="m">
    <verse number="24" style="v" pubnumber="24." sid="NUM 35:24" /> то грамада павінна судзіць паміж забойцам і мсьціўцам за кроў на гэтай аснове.<verse eid="NUM 35:24" /></para>
  <para style="m">
    <verse number="25" style="v" pubnumber="25." sid="NUM 35:25" /> Грамада павінна выратаваць забойцу ад рукі мсьціўца за кроў i павінна вярнуць яго ў горад прыбежышча яго, куды ён уцёк, каб ён там жыў да сьмерці першасьвятара, які памазаны сьвятым алеем.<verse eid="NUM 35:25" /></para>
  <para style="m">
    <verse number="26" style="v" pubnumber="26." sid="NUM 35:26" /> Калі ж забойца выйдзе за межы гораду-прыбежышча, у які схаваўся,<verse eid="NUM 35:26" /></para>
  <para style="m">
    <verse number="27" style="v" pubnumber="27." sid="NUM 35:27" /> і калі мсьціўца за кроў сустрэне яго па-за межамі гораду-прыбежышча, тады мсьціўца за кроў не вінаваты, калі заб’е забойцу.<verse eid="NUM 35:27" /></para>
  <para style="m">
    <verse number="28" style="v" pubnumber="28." sid="NUM 35:28" /> Бо да сьмерці першасьвятара павінен забойца быць у горадзе прыбежышча свайго. Пасьля сьмерці першасьвятара можа ён вярнуцца да спадчыны сваёй.<verse eid="NUM 35:28" /></para>
  <para style="m">
    <verse number="29" style="v" pubnumber="29." sid="NUM 35:29" /> Няхай гэта будзе вам законам у-ва ўсе пакаленьні вашыя і ў-ва ўсіх месцах пражываньня вашага.<verse eid="NUM 35:29" /></para>
  <para style="m">
    <verse number="30" style="v" pubnumber="30." sid="NUM 35:30" /> Забойцу на падставе словаў сьведкаў караюць сьмерцю. На падставе аднаго сьведкі ніхто на сьмерць не асуджаецца.<verse eid="NUM 35:30" /></para>
  <para style="m">
    <verse number="31" style="v" pubnumber="31." sid="NUM 35:31" /> Нельга прымаць выкупу за душу забойцы, які варты сьмерці; павінен ён быць пакараны сьмерцю.<verse eid="NUM 35:31" /></para>
  <para style="m">
    <verse number="32" style="v" pubnumber="32." sid="NUM 35:32" /> Не бярыце выкупу і за ўцёкшага ў горад прыбежышча, каб яму дазволіць жыць у зямлі сваёй перад сьмерцю першасьвятара.<verse eid="NUM 35:32" /></para>
  <para style="m">
    <verse number="33" style="v" pubnumber="33." sid="NUM 35:33" /> Не паганьце зямлі пражываньня вашага, бо кроў пляміць зямлю, і ніяк яна ня можа быць ачышчаная, як толькі праз кроў таго, хто праліў яе.<verse eid="NUM 35:33" /></para>
  <para style="m">
    <verse number="34" style="v" pubnumber="34." sid="NUM 35:34" /> Не паганьце зямлі, на якой будзеце жыць, бо Я буду жыць з вамі. Бо Я — ГОСПАД, Які жыву пасярод сыноў Ізраіля”».<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="cl">Лікі 36</para>
  <para style="m">
    <verse number="1" style="v" pubnumber="1." sid="NUM 36:1" /> І прыйшлі начальнікі сем’яў пакаленьня сыноў Гілеада, сына Махіра, сына Манасы, з роду сыноў Язэпа, і расказалі Майсею, і князям, і начальнікам пакаленьняў Ізраіля<verse eid="NUM 36:1" /></para>
  <para style="m">
    <verse number="2" style="v" pubnumber="2." sid="NUM 36:2" /> такую справу: «Табе, гаспадар наш, загадаў ГОСПАД жэрабем падзяліць зямлю паміж сынамі Ізраіля і таксама даць спадчыну дочкам Цэлафхада, брата нашага.<verse eid="NUM 36:2" /></para>
  <para style="m">
    <verse number="3" style="v" pubnumber="3." sid="NUM 36:3" /> Дык калі яны будуць жонкамі якога з сыноў другога нейкага пакаленьня сыноў Ізраіля, то спадчына іх адымецца ад спадчыны бацькоў нашых і далучыцца да таго пакаленьня, у якім яны будуць жыць, дык наша частка, атрыманая жэрабем, змалее.<verse eid="NUM 36:3" /></para>
  <para style="m">
    <verse number="4" style="v" pubnumber="4." sid="NUM 36:4" /> І калі для Ізраіля настане год юбілейны, тады іх спадчына будзе назаўсёды належаць да пакаленьня, да якога яны ўвайшлі, а спадчына пакаленьня бацькоў нашых паменшыцца на спадчыну іхнюю».<verse eid="NUM 36:4" /></para>
  <para style="m">
    <verse number="5" style="v" pubnumber="5." sid="NUM 36:5" /> І сказаў Майсей сынам Ізраіля па загаду ГОСПАДА: «Справядліва сказала пакаленьне сыноў Язэпа.<verse eid="NUM 36:5" /></para>
  <para style="m">
    <verse number="6" style="v" pubnumber="6." sid="NUM 36:6" /> Вось як пастанавіў ГОСПАД у справе дачок Цэлафхада: Яны могуць ісьці замуж за каго захочуць, але за мужчынаў пакаленьня свайго.<verse eid="NUM 36:6" /></para>
  <para style="m">
    <verse number="7" style="v" pubnumber="7." sid="NUM 36:7" /> Няхай не пераходзіць спадчына сыноў Ізраіля з аднаго пакаленьня ў другое пакаленьне. Няхай сыны Ізраіля трымаюцца спадчыны пакаленьня бацькоў сваіх.<verse eid="NUM 36:7" /></para>
  <para style="m">
    <verse number="8" style="v" pubnumber="8." sid="NUM 36:8" /> Кожная дзяўчына, якая атрымае спадчыну ў якімсьці пакаленьні, стане жонкаю аднаго з мужчынаў пакаленьня свайго, каб сыны Ізраіля захавалі спадчыну бацькоў сваіх,<verse eid="NUM 36:8" /></para>
  <para style="m">
    <verse number="9" style="v" pubnumber="9." sid="NUM 36:9" /> і каб спадчынная маёмасьць не пераходзіла з аднаго пакаленьня ў другое. Пакаленьні сыноў Ізраіля павінны трымацца спадчынных паселасьцяў сваіх».<verse eid="NUM 36:9" /></para>
  <para style="m">
    <verse number="10" style="v" pubnumber="10." sid="NUM 36:10" /> Дочкі Цэлафхада зрабілі так, як загадаў ГОСПАД Майсею,<verse eid="NUM 36:10" /></para>
  <para style="m">
    <verse number="11" style="v" pubnumber="11." sid="NUM 36:11" /> і выйшлі замуж Махля, Тырца, Хогля, Мілька і Ноа за сыноў дзядзькоў сваіх.<verse eid="NUM 36:11" /></para>
  <para style="m">
    <verse number="12" style="v" pubnumber="12." sid="NUM 36:12" /> Пайшлі яны замуж за людзей з пакаленьня Манасы, сына Язэпа, і так спадчына іхняя засталася пры пакаленьні, да якога належаў род бацькі іхняга.<verse eid="NUM 36:12" /></para>
  <para style="m">
    <verse number="13" style="v" pubnumber="13." sid="NUM 36:13" /> Гэта прыказаньні і пастановы, якія даў ГОСПАД праз Майсея сынам Ізраіля на раўнінах Мааву каля Ярдану насупраць Ерыхону.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>