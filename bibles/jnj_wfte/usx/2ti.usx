<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">2 TI -Yemsa New Testament</book>
  <para style="h">2 ጢሞትዮስ</para>
  <para style="toc1">ዎሲ ጳዉሎስኒ ሄፕሳ ዎሲያ ጢሞትዮስኒክ</para>
  <para style="toc2">2 ጢሞትዮስ</para>
  <para style="toc3">2 ጢሞ.</para>
  <para style="mt2">ዎሲ ጳዉሎስኒ ሄፕሳ ዎሲያ</para>
  <para style="mt1">ጢሞትዮስኒክ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ጳዉሎስ ጢሞትዮስኒክ ትችና ሀን ሄፕሳ ዎሲያስ፤ ጳዉሎስኒን ታሶኖን አሪጋሲ ዎስቶኒ ዞሞባይ ስና ናኦ ጢሞትዮስኒክ እምና ኪቶሶን ኤጶዋ። ዳይስሬ ደይ ኪትናስ ፋክያክ ችናክዋ። ጢሞትዮስ ኪቶነዋ ችኑኒ ካማ ዳንናስ የሱስ ክርስቶስኒ ቾዋሶን አማናምቶክ ዛላ ማኮናክ ዛግሬ ኤጳናክናዋ አዉነ ፋሮንኑ ሻናሴዋ ቱጋኦሴ አርክፋናክኑ አሱሲክናዋ ምስራቹኒ ካማሲ ማኮኒ ዎስቶሲክና ዱዶናክዋ።</para>
  <para style="ip">ጢሞትዮስ አርክሮን ቴትባሶን ኦዳናክ ማክቴናስ ጎዉማክ ዛግቴፋ ስንኖይ ክርክሪስን ዎካናክዋ። ኤስ ኤፋቴና ዉዛስ ኦደፌ ባሶትን ትሽኩታኖ ኦማ ኬእፋና ዉዛባ ኣፋዋ።</para>
  <para style="ip">ኤስ ዉዛ ዙታምባሴ አሲክ ጢሞትዮስ ያዳቶናክ ሾልሲናስ ጳዉሎስኒ ካሴዋ ፎሴ አርክሮን ደይ አማንቶባሶን፤ ፋክባሶን፤ ኬሽታንባሶን፤ ችምባሶንናዋ ካቡግቶክ ባሳስታ ካርአ ሻናሲ ቤሶክና ዞኑስቶናክዋ።</para>
  <para style="iot">ማፃፋስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="2TI 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ጢሞትዮስኒክ እምቴ ኪቶ <char style="ior"><ref loc="2TI 1:3-2:13">1:3—2:13</ref> </char></para>
  <para style="io1">ሞርሞኒ ካባሲክ አማናምቶ ስንነ ቤስቶ <char style="ior"><ref loc="2TI 2:14-4:5">2:14—4:5</ref> </char></para>
  <para style="io1">ኤስ ካባሲክ ፋሴ ዉዛአሲክቶነዋ ሾልሱ ዞንሱነ <char style="ior"><ref loc="2TI 4:6-18">4:6-18</ref> </char></para>
  <para style="io1">ኮርኡባ <char style="ior"><ref loc="2TI 4:19-22">4:19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1"/>የሱስ ክርስቶስኒኪን ቤስቴ ካኒ አብዲሲክ ሀኦሲ ፍቃድክ የሱስ ክርስቶስኒ ዎሲ ስና ጳዉሎስኒኪን ዎስቴ ዎሲያ፤ <verse eid="2TI 1:1"/><verse number="2" style="v" sid="2TI 1:2"/>ሹንቶ ናታ ጢሞትዮስኒክ፤ አባ ሀኦኒሲክንናዋ ዳምኒ የሱስ ክርስቶስኒክንና ኦቱምነዋ ፋክነ ደይ ናጋነ ኔክ ስንፋውጝዋ።<verse eid="2TI 1:2"/></para>
  <para style="s1">ጢሞትዮስኒክ እምቴ ኪቶ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>ዎንና ዎንና ዎንነዋ ዋልነ ሺጶናሲክ ኔን ሳፋሬፋና ካባሲክ ታ አባኒ ሜያ ዛግሴቴሲማቶ ታ ደይ ካይማ ካኑክ ባሪክ ዎስቴፋና ሀኦሶን ጋላቴፋዉጙዋ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>አራፍኔሶን ያዳቴድፋዉጝዋ፤ ኤስ ባሪ ቦርኣ አካማኖን ግሮናክ ኔን ብያናክ ካልቴፋዉጝዋ። <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>ኔኪክ ፋ ፉቶኒ አማንቶሶን ያዳቴድፋንዋ። ኤፋቴና አማንቶስ ዜምማ አፋነ ሎይድያኪክ ደይ እንቶነ ኤዉንቄኪክቱ ፋዋ። ኔኪክ ደይ ፋናማቶ አሪጙዋ። <verse eid="2TI 1:5"/><verse number="6" style="v" sid="2TI 1:6"/>ኤስ ባሪ ቦርኣ ኩሹናሶን ነይስታ ታእፋና ካባሲክ ኔክ እምቴ ጌኒማቶ ስንና ነይሲ ፋ ሀኦሲ እማኖን ሄፕሳ ዎልግራ ጌኒማቶ ሳምማ ዳይሲት ሀማናክ ያዳሲፋዉጝዋ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>ሀኦ እኖክ እምና እማስ ሁግናኒር፥ ኬሽታኒር፥ ደይ ቴትኒ ሀእሱኒ ኮርቶ አያናታኖ ድጋኒ አያናታዋ። <verse eid="2TI 1:7"/><verse number="8" style="v" sid="2TI 1:8"/>ኤሴ ዳምኒሳ ቾዋኖን ማኮሶን ኢቾታታዋ። ባሳ ቦርአ ታቴሬ ፌ ታክ ደይ ኢቾታታዋ። ስኑንታኖ ሀኦ ኔክ እማና ሁግናሲክ ምስራቹኒ ካማሲ ቦርአ ዮኒ ሻናሶን ኤጳቶዋ። <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ባር እንኖ ዛግኒ ማአ ዎስቶክ ስንኖይናማቶ ቴትባሲ ሹናክናዋ ኦቱምባሲክና እኖትን ፋቲዋ። ኮርቶ ስንና ፎኒክ እኖትን ቴጌ። ኤስ ኦትማሶን ነያኔን ስናክ የሱስ ክርስቶስኒኪ ካሞ እኖክ እሚዋ። <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>ኤስ ኦትማስ ደይ እኖትን ፋቲ የሱስ ክርስቶስ ዮባሲክ አምማኖን ቤስቴ። ባር ክቱሲ ሁግናኖን ትሽክሬ ምስራቹኒ ካማሲኪ ካሞ ክቱኖይ ኮእባ ፎንቶ ካ አምማኖን እኖክ ቤሲ።<verse eid="2TI 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11"/>ታ ደይ ኤስ ምስራቹኒ ካማሶን ማኮኒ ዎሲ፤ አስኛ ስንና ቴግቴን። <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>ሀን ራክኮሶን ኤጳታት ፋናስ ደይ ኤስ ባሪ ቦርኣዋ። ስኑንታኖ ኦኒን አማነናማቶ አሪፋና ቦርአ ኣፋ ኢቾናዉዛ። ታ እምና አዳራሶን ክርስቶስ ዎል ሌ ዮና ካባኔን ባር ኦዳ ችማናማቶ አሪፋውጙዋ። <verse eid="2TI 1:12"/><verse number="13" style="v" sid="2TI 1:13"/>ታኪን አሪታ አማናምቶ ካማሶን ቤሶ ዛግራ የሱስ ክርስቶስኒክ ፋ አማንቶሲክናዋ ኬሽታናሲክና ኦድዋ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>እንኖሲ ፋፋ ኮርቶ አያናስኪ ካሞ ኔክ እምቴ ማአ አዳራሶን ኦድዋ።<verse eid="2TI 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ኢስያኒ አዉራጃሲ ፌ ባሶ ዙቴሬ ታን ቤየ ሀሜቴማቶ አርፋትዋ። ባሶ ጋነያስን ፍጌሉስናዋ ሄርሞጌነስና ፌሴቴርዋ። <verse eid="2TI 1:15"/><verse number="16" style="v" sid="2TI 1:16"/>ዳሚስ ኦነስፎርኒ ኬርኪ ሜያክ ፋክባሶን እማዎዋ። ባር ሾዎ ዎና ታን ችኒ። ታቶናሲክኑ ኣነ ኢቾዌ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>ሮምኪ ካታማ ዬና ካባሲክ ደይ ሾሌፌ ሾሌፌቱ ታን ዳኒ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>ማጝሱኒ ካርኒ ዎኖ ዳሚስ ፋክባሶን እማዎዋ። ኤፌሶኑክ ፋና ካባሲክ አዉነ ፋሮን ታን አርጋሲናማቶ ነ ቴትኔሲክ ማእስራ አሪፋትዋ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">ክርስቶስኒ አማናምቶ ሜያ ታርኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ኤሴ ናታሶ! የሱስ ክርስቶስኒኪን ቤስቴፋ ኦትማሲክ ችምዋ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ሾዎ ዛልኒ ሜኒ ስናክ ታኪን አሪታ አሩሶን ኦምኒ ሜያኖን አሱክ ችምኒ ባሶክናዋ አማናምቶ አሱኒ ሜያክና አዳራ እምማ። <verse eid="2TI 2:2"/><verse number="3" style="v" sid="2TI 2:3"/>ነ ደይ የሱስ ክርስቶስኒ ማአ ሜያ ታርኦ ስንና ታኔን አነ ሻናሶን ኤጳቶዋ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ታርኦ ስንነ ዎስቴፌ አሱ ሜያ ታርኦሳ ጋኛኒን ግርሱክ ሆሮ ስናናክቱ ሾልሲፋታኖ ታርኦስ ቴትባሪ ዎስቶሲ ኣነ ግሪፌዋ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>ኤሲስማቶ ደይ ኣቶ ኣቶ ኤልፌ አሱ ቱምባሲማቶ ኤልላ ሻካናነ ሜሬሬ ኤስ ሜሬና ባሪ ዎሱማ ኣፋ ዳናናዉዛ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ዎስቶክ ሆፕፌ ቡልኛአስ ዎስቴና ጋናስን ቴሱኒሶን ዳናናክ ሾልሲፋዋ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ዳሚስ ዙታምባሴ አሲክ ያዳታ ኔክ እማና ስንና ቦርአ ታ ማኬፋና ባሮን ማእስራ ያዳቶዋ። <verse eid="2TI 2:7"/><verse number="8" style="v" sid="2TI 2:8"/>ክቱን ካብ ባርናዋ ዳዊትኒ ዛላስን ስና የሱስ ክርስቶስኒን ያዳቶዋ። ታ ማኬፋና ምስራቹኒ ካማስ ኤሲስዋ። <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ኤስ ምስራቹኒ ካማሲ ቦርአ ማጝሲ አሱኒማቶ ሻሻራክ ታቴራ ሻና ኤጳ ታድፋጝዋ። ስኑንታኖ ሀኦሲ ካማ ኣፋዋ ታቶናዉዛ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ኤስ ባሪ ቦርኣ ባሶ ደይ የሱስ ክርስቶስኒኪክ ፋ ፋሩሲኪ ካሞ ቤስቴፋ ኮእባ ፎንቶ ኡልፍና ዳኖነክ ሀኦ ኮሪና አሱኒ ሜያክዋ እያት ዙታምባሴ አሲን ፋክፋንዋ። <verse eid="2TI 2:10"/><verse number="11" style="v" sid="2TI 2:11"/>ኤካ ይፋ ካማስ አማንቶዋ፤</para>
  <para style="q1" vid="2TI 2:11">«ባርኔን አነ ክትፋኒነ፤</para>
  <para style="q2" vid="2TI 2:11">ባርኔን አነ ደይ ካክ ፎኒዋ።<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ፋኪያክ ችምማ የሬፋኒነ፤</para>
  <para style="q2" vid="2TI 2:12">ባርኔን አነ ደይ ታቶኒዋ፤</para>
  <para style="q2" vid="2TI 2:12">ሞርሜፋኒነ ባር ደይ፤</para>
  <para style="q2" vid="2TI 2:12">እኖትን ሞርሞናዋ።<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>እንኖ አማናምቶ አሱ፤</para>
  <para style="q2" vid="2TI 2:13">ስና ሻካኒነ፤</para>
  <para style="q2" vid="2TI 2:13">ባር ቴትባሶን፤</para>
  <para style="q2" vid="2TI 2:13">ኣፋ ሞርሞናዉዛ ስንና ቦርአ፤</para>
  <para style="q2" vid="2TI 2:13">ኣጌኑ አማናምቶ ስንነቱ ፎናዋ።»<verse eid="2TI 2:13"/></para>
  <para style="s1">ችም ዎስትኛ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ሀን ቾዋሶን ያዳትሶነክ ዛጉዋ። ካምታን ካብ ቾዋ ካራካርሶኖይቴማቶ ሀኦሲ ስና ቴትቤሲሶን ኦዶሶነክ ዛጉዋ። ኤስ ካምኒ ካራካሮስ ኦደሴፌ አሱኒ ሜያኖንቱ ትሽኩናታኖ እሳ ዉዛክኑ ኣነ ኬእፋዋ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>ፉቶኒ ሀኦሲ ካማኖን ልኪክ ካትፌ አሱኒማቶናዋ ዎስቶባሲክ ኢቾኖይ ዎስትኛ ስንና ቴትኔሶን ሀኦሲ ስና ታእሱክና ደይ ግርሲ አሱ ስናታክ ዱዶዋ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ሀን ዳስታኪ ቾዉነዋ ሽማ ስና ዎላስታን ዎክዋ። ኤስ ኤፋቴና ዎላስ አሱኒ ሜያኖን ሀኦስታን ዳይስሬ ዎኮሶነክቱ ዛግፋዋ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>ኤስ ባሶ አስሱስ ፋሩኖይ ማዛኒማቶቱ ታግትቱ ሀምፋዋ። ኤስ ባሶ ጋነያሲን ሄሜነዎስናዋ ፍልቶስና ፌሴቴርዋ። <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>ኤስ አሱኒ ሜያ፦ «ክቱን ካቡ ዜሞ ስንናክቱ ስኒዋ» ይት ካራካሮክ ፉቶስታን ዎኬቴዋ። ደይ እሳ እሳ አሱኒ ሜኒ አማንቶሶን ሾርኪሴፌዋ። <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>ስኑንታኖ «ዳሚስ ባሳር ስና ባሶትን አሪፌዋ» ኤሲስማቶኑ፦ «ዳሚሳ ሱናኖን ቴጌፌ ባሶ ዙቴሬ ማጙስታን ዎኮሶቶ» ይስቴራ ትቼራ ሾርኮኖይ ሀኦሲ ካፕታስታ ማታማክ እቼዋ።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>እኛ ኬያሲ ዋርቄክናዋ ብሪክና ዎሱስቴ ኮዳ ኮእባ ስንኖይናሮን እኦኪን ዎሱስቴ ኮዳነዋ ኦቸ ኮዳነቱ ፋሴር። ኤስ ባርስን እሳ እሳይስ ኡልፍንቶ ዎስቶክ፤ እሳ እሳይስ ኡልፍንባ ፎንቶ ዎስቶታቱ ፌሽፋዋ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ኤስ ማጙ ዉዛስን ኮርቴሬ ኬሴ ካይም ስንነ ፌፌ አሱ ኡልፍንቶ ዎስቶታ ፌሽፋ ኮዳስነ ፌር ስናናዋ። ማአ ዎስቶክ ሆሬ ባር ዳሚሲክ ኮርቶ ስንነ ፌሬ ኬእኒ ኮዳ ስናና።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>ናኦኒ ሜኒ ማጙ ኤናንቶስታን ዎክዋ። ካይማ ንባክ ዳሚስን ቴግሴፌ አሱኒ ሜያኔን አነ ስንና ኦኮሶን፥ አማንቶሶን፥ ኬሽታናሶን፥ ናጋሶን ሾሎዋ። <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>ቾዋ ኤጳ ዮናማቶ አሪራ ጎዋ ስናስታንናዋ ኬእኖይ ሽማ ካራካሮስታንና ዎክዋ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ዳምኒ ዎስትኛ ስና አሱ ዙታምባሴ አሲክ ጋራም፥ አሱክ ችማርናዋ ፋኪርና ስናናክቱ ሾልሲፋታኖ ፋሶናክ ኣነ ሾልስፋዋ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>ባር ቱጋኤሴፌ ባሶትን ጋራማክ ኪትር ስናናክ ሾልሲፋዋ። አዉዛክነ ፉቶሶን አርሶነክ ሀኦስ ሀርሚን ኡግና ባሶክ እማናክ ችማና። <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>ኤሲስማቶ ንቤሲሲኪ ዎልሴሬ ዳቡሎስ ባሳ ፍቃዲሶን ዛግሶነክ ባሶትን ኤጵኒ ኤሽምያስን አቴ ኬሶነዋ።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ኮእኒ ዎናስ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ኮእኒ ዎኖ ራክሱኒ ዎና ዮናማቶ አሩዋ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>አሱኒ ሜያ ቴትቤሲሶን ኬሽቴር፥ ዋግኒ ዳናክ ጆሬር፥ ጌኤሴር፥ ቤጋንቴር፥ ሜኤሴር፥ አባ እንቶሲክ አጃጃሞኖር፥ ጋላትቤስ ፎንቶ፥ ኮርቶቤስ ፎንቶ፥ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ኬሽታንቤስ ፎንቶ፥ ፌሹን ኡሶኖር፥ አሱኒ ሱና ማጝስሴር፥ ቴትቤሲሶን ሀእሱኖር፥ ኬና ቡዱ፥ ማአር ስና ዉዛሶን ኦምቴሴር፥ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ሞርሜሴር፥ ቴትቤሲ ኦድኖር፥ ቤጋንቶክ ቱምሜ ፌሴር፥ ሀኦሶን ሹናስታን አሽቤሲሶን ግርሱ ሹናር ስኖነ። <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ሀኦሶን ሺጴድፌርነ ፌር ስንነቱ ቤስቴሴፌ፤ ስኑንታኖ ሀኦሲ ሺጶኒ ሁግናኖን ሞርሜሴፌ። ኤስ ኤፌቴና አሱኒ ሜያስታን ዎክዋ። <verse eid="2TI 3:5"/><verse number="6" style="v" sid="2TI 3:6"/>ኤስ አሱኒ ሜያ ኬያ ኬያስ አቴ ግሪሴፋፌ ሾዎ ቦርቤስ ቱልቴራ ፋና ሾዎ ቴሳ እጋክ ዞኑስቴሴፋ ሆፕያ አያናቤስ ፋና ማሽካሱሶን ባሶ ሀእሱሲ ዛግሴፌ አሱኒ ሜያነ ፌሴቴርዋ። <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ኤስ ኤፋቴና ማሽካሱሲክቶ ዎንና ዎንናቱ አርሴሴፌ፤ ስኑንታኖ ፉቶሶን አሩታ ካርአክ ኣነ ችሜሴፌ። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>እያነስናዋ እያንቤሬስና ሙሴኒን ቱጋሴሴቴማቶ ሀን ባሶ ካኑቤሲስ ማጝራ አማንቶኒ ቾዋሲክ ጋንደሴሬ ፌሴቴር ስንና ቦርአቱ ፉቶሶን ቱጋኤሴፌዋ። <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>እያነስናዋ እያንቤሬስና አሲ ጎዋስስ አምማኖን ቤስቴናማቶ ሀን ባሶ ጎዋስ ደይ አሱ ዙታምባሴ አሲ ስና አምማኖን ቤስቶኒር ስንና ቦርአ ኣፋ ዎስቶታ ፌሻናዉዛ።<verse eid="2TI 3:9"/></para>
  <para style="s1">ኮእኒ ኪቶ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>ስኑንታኖ ነ ታ አስሱሶን፥ ታ ፎሶን፥ ታ አላማሶን፥ ታ አማንቶሶን፥ ታ ፋክያሶን፥ ታ ኬሽታናሶን፥ ኤጵና ባሪክ ችምሜ የሮናሶን አሪፋትዋ። <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>ኤሲስማቶ ደይ ካቡግቶናሶንናዋ ኤጳታና ሻናናሶንና አሪፋትዋ። አንሶኪያክናዋ እኮኒዮክና፥ ደይ ልስትራክ ታይስታ ካርአ ቾዋሴዋ ፋኪያክ ኤጳታና ካቡግቶሴ አሪፋትዋ። ስኑንታኖ ዳሚስ ዙታምባሴ አሲስን ታን ፉኤዋ። <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ፉቶክ ክርስቶስ የሱስኒር ስንነ ሀኦሶን ግርሲሬ ፎክ ሾልሴፌ ባሶ ዙቴሬ ካቡግቴሴቴርዋ። <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ስኑንታኖ ማጙ አሱኒ ሜናዋ ኤሽቱኒ ሜና አሱኒ ሜያኖን ኤሸትናዋ ቴትቤሲሲክ ዳጌሴትና ማጙስታ ማጙ ዳይሲሴትቱ ሀሜፌዋ። <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>ስኑንታኖ ነ ኦኪን አሪታማቶ አሪታር ስንና ቦርአ ኤስ አሪታ ባርክናዋ አማነታ ፉቶሲክና ዛጉዋ። <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>ዳግኔስታኔን ካብራ የሱስ ክርስቶስኒክ አማኖክ ፋሩ ቤስቴፋናማቶ ቴችማ እምፋ ኮርቶ ማፃፋሲክቶኖን አሪትዋ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ኮርቶ ማፃፋሲክቶ ዙቴራ ሀኦሲ አያናኒ ዞንሲያክቱ ትቼርዋ። ኤስ ባር ደይ ፉቶሶን አሱክ፤ ዳጌ ባሶትን ኬኡክ፤ ዳጌት ፎሶን ካኑክናዋ ማአ ፎክ ስንኒ ኡግና እማክ ኬአርዋ። <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ኤስ ኬእፋናስ ደይ ሀኦኒ አሱ ዛግ ስናናክናዋ ኣፋ ማአ ዎስቶሶን ደይ ዎስቶክ ሆሬር ስንነ ቤስቶናክዋ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>ሀኦሲ ስናክናዋ ደይ ታቶባሶን ዬትፌና ካባሲክና ሀየዉኒ ሜያስታናዋ ክቱኒ ሜያስታና ማጝሱ ካርኒ የሱስ ክርስቶስኒ ስና አዳራ ይፋን። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ካምባሶን ማኮ፤ ማእፋናክ ማጝፋናክ ኣጌኑ ስኑን ችምማ ዎስቶዋ፤ አስሲት፥ ኬእትናዋ ኪትትና፤ ፋኪያክናዋ አስሱክና ችምዋ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>አሱኒ ሜያክ ካ እምፋ አስሱሶን ኦዶክ ኦምቶሶነ ዎና ዮና። ስኑንታኖ ባሶ ሾልሴፌ ዉዛሶን ማኮኒ አስኛቤሲርን ዙቱሶነ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ኤስ ባሪ ቦርኣ ፉቶሲ ቾዋኖን ኦዶ ቤየፋት ራጅኒ ኦዶክ ሾልሴፌዋ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>ስኑንታኖ ነ ዙታምባሴ አሲስታን ቴትኔሶን ኦድ። ሻናኒ ኤጴቶክ ዛጉ፤ ምስራቹኒ ካማንሲ ማኮኒ ዎስቶሶን ዎስቶ። ኔክ እምቴ ዎስቶሶን ዙትራ ኮእሱ። <verse eid="2TI 4:5"/><verse number="6" style="v" sid="2TI 4:6"/>ታ ማአ ስናናክ ሆሬራቱ ፋን፤ ሀን ዳስታን ደይ ኦር ኬሳ ሀማና ዎና ካርእ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>ኔቦሶን ማአሪክ ኔቤን፤ ኣታቶኒ ኤላሶን ኮእባ ካርአ ኤልን፤ አማንቶናሶን ኦድን። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>ሀንኔን ኤካሎ ኦኮኒ አክሊልስቱ ታክ ሆሬራ ፋር። ኤስ አክልሊሶን ፉቶክ ማጝሱ ካርፌ ዳሚስ ኤስ ካባሲክ ታክ እማና። እማናስ ደይ ታክ ኮእባ ስንኖይናሮን ባሳ አምማኖን ቤስቶሶን ካልቴሴፌ ባሶክኔጝዋ።<verse eid="2TI 4:8"/></para>
  <para style="s1">ቴትኒ ቾዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ታፕቴራ ሀጝ ታኪ ዮታክ ዱዶዋ። <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማስ ሀን ዳስታኪ ፋ ዉዛሶን ሹንነ ታይስታን ኦር ኬስሴ ቴሴሎንቄ ሀሚ፤ ኬርቅጤስ ጋላትያ ሀሚ፤ ትቶ ደይ ድልማትያ ሀሚ። <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ታኔን አነ ፌይስ ሉቃስ ኮእባዋ። ማርቆስ ሀኦሲ ዎስቶክ ኬኒር ስንና ቦርአ ሾሌራ ታክ ኤጳ ዮዋ። <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>ጥቂቆስኒን ኤፌሶን ዎስጝዋ። <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>ያፋታ ካባሲክ ትሮአዳክ ካርፑስኒኪ ኤስታ ኩንስና ኮምቦርታናሶን ታክ ኤጳ ዮዋ። ማፃፋሲክቶኖን አሪክሮን ደይ ብራናን ማፃፋሶን ታክ ኤጳ ዮዋ። <verse eid="2TI 4:13"/><verse number="14" style="v" sid="2TI 4:14"/>ብታ ክፌ እስኪንድር አካማ ሚርአ ታይስታ ካት። ዳሚስ ዎስቶባስማቶ ባርኪ ካሱና። <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ባር እንኖ ማኬፌን ባሮን ማእስሬ ቱጋኤር ስንና ቦርአ ነኑ ቴትኔሶን ባሳስታን ኦድዋ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ታ ማላቴና ቾዋሲክ ቴሱኒ ማልሲሶን ዎልግፋና ካባሲክ ዙታምቤሲሴቱ ታይስታን ዎኬቴታኖ ታኔን አነ የሬሬ ታን አሪጋስር ኦኑ ኣፌ። ኤስ ባሮን ደይ ሀኦሲ ማጝሱ ዛግራ ባሶስታ ፋዱናታ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ስኑንታኖ ዎስያስ ታክ ካሞ ዙቴራ ማክቶናክናዋ አዛብኒ ሜያ ዙቴሬ ኦዶሶነክ ዳሚስ ታኔን አነ ስንነ ታን ችኒ። ኤቶሳ ኖኖስን ደይ ፉቴን። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ዳሚስ ማጙ ዉዛ ዙታምባሴ አሲስኒ ታን ፉኦና። ሳማኪ ፋ ታቶባስታ ታን ታሜ ካቱና። ባርኪ ኮእባ ፎንቶኖን ኡልፍና ስንፋውጝዋ! ኣሚን።<verse eid="2TI 4:18"/></para>
  <para style="s1">ኮእኒ ናጋን ኦሾ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ፕርስቅላክናዋ አቅላክና፤ ኦነስፎርምኒ ኬርክ ሜያክ ናጋናሶን ማኮ። <verse eid="2TI 4:19"/><verse number="20" style="v" sid="2TI 4:20"/>ኤራስቶስ ቆሮንጦስ ካታማ ፉእቴ፤ ትሮፎሞስ ሜትቴና ቦርአ ምልጥን ቤያ ያን። <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ዬሹ ግሩኖይፌን ታክ ታፕቴሬ ዮክ ዱዶዋ።</para>
  <para style="p" vid="2TI 4:21">ኤዉቡሉስ፥ ጱደስ፥ ልኖስ፥ ክላዉድያነዋ አማኝኒ ሜነ ዙቴሬ ናጋ ማክሴድፌ። <verse eid="2TI 4:21"/><verse number="22" style="v" sid="2TI 4:22"/>ዳሚስ ነኔን አነ ስኖ።</para>
  <para style="p" vid="2TI 4:22">ሀኦሲ ኦትማ ንቶኔን አነ ስንፋውጝ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
