<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">-Yemsa New Testament</book>
  <para style="h">2 ዮሀኒስ</para>
  <para style="toc1">ዎሲ ዮሀኒስኒ ሄፕሳ ዎሲያ</para>
  <para style="toc2">2 ዮሀኒስ</para>
  <para style="toc3">2 ዮሀ.</para>
  <para style="mt1">ዎሲ ዮሀኒስኒ ሄፕሳ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ዎሲ ዮሀኒስኒ ሄፕሳኒ ዎሲያስ ትቼናስ ኩርኡ ስና ዎሲ ዮሀኒስኒኪን ስንፋት ትቼናስ ደይ ኮርቴራ ፋ ኬርኛአሲክናዋ ናንጎትባሲክናዋ። አዉዛክነ ደይ እሳ አትብያ ቤቴክርስታኒሲክናዋ ባሪስሲ ፌሴ ባሶክና ስና ኣፋ ቤያና ዉዛ። ሀን ካዉና ዎሲያ ትቼናስ ዎል ሹኖሶነክ ካምባሶን ማኮክናዋ ኤሽ አስኛኒ ሜኒ አሱስታን ቴትቤሲሶን ኦዶሶነክዋ።</para>
  <para style="iot">ማፃፋስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችቼ ግሩ <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">ኬሽታና ዙታምባሴ አሲስታን ደናሎ ስንባስ <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">ኤሻ አሱስሲን ቴትኒ ኦዳ <char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">ኮርኡባ <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>ኮርቴራ ፋ ኬሪኛአሲክናዋ ናንጎትባሲክና ቤቴክርስታንኒ ኩርኡ ስና ታኪን ዎስቴ ዎሲያ፦ ታ ፉቶሲክ ንቶትን ሹንፋዉግዌ፤ ታ ታ ስኖይናሮን ፉቶሶን አርሴፌ ባሶ ዙቴሬ ንቶትን ሹነቴርዌ። <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ኤስ ፉቶስ እንኖ ጋነያሲ ፋርዌ፤ ሀንኔን ደይ ኮእባ ፎንቶኖን እንኖኔን አነ ፎኒርዌ። <verse eid="2JN 1:2"/><verse number="3" style="v" sid="2JN 1:3"/>አባ ሀኦሴዋ ና የሱስ ክርስቶስኒ ኦትማ፥ ፋክያሴዋ ናጋሴ ፉቶክናዋ ኬሽታናክና እንኖኔን አነ ስንፋውጝ።<verse eid="2JN 1:3"/></para>
  <para style="s1">ፉቶነዋ ኬሽታንነ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>ናንጎትኔሲክቶስን እሳ እሳይስ አባስ እኖትን አጃጀናሲማቶ ፉቶሲክ ችምማ የርሴፌኒ ዳንና ቦርአ አካማኖን ግሬንዌ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ኬሪኛአሴ! ሀሽኑ አዳራዌ፤ ሀን ኔክ ትችፋና ትቻስ ጋድዶ አጃጅ ስንና ኔክ ቤስቶናታዌ፤ ሀን ኔክ ትችፋናስ፦ «እኖትና እኖትና ዎል ሹኖኒ» ይፋ ቴሱባስታን ካብራ እኖክ እምቴ አጃጂስዌ። <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ፉቶኒ ኬሽታና ኡስ ሀኦሲ አጃጅኖን ዛጉስዌ። ኤስ አጃጂስ ደይ ቴሱስታን ካብግራ ኦደሴትሲማቶ «ኬሽታናክ ፎቲ» ይፋ ባርዌ። <verse eid="2JN 1:6"/><verse number="7" style="v" sid="2JN 1:7"/>የሱስ ክርስቶስ አሱ ስንነ ዮባሶን አማኖኖር ዳግስሴፌ ሾዎ ሜያ ሀን ዳስታክ ካብሴቴ። ኤስ ኤፌቴና አሱስ ኤሽኛ ደይ ክርስቶስኒን ቱጋኤፌ ባርዌ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>ስኑንታኖ ንቶ ቱማ ዋግኒትሶን ኤጳቶትክ ችምትዌ፤ ዎስቴቲ ዎስቶስ ትሹኖይናማቶ አሩትዌ። <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>ክርስቶስኒ አሱሲክ ችምሜ ፎኖይ ባርናዋ ባሳ አሱስታን ዎኬ ሀምፌ ባርና ሀኦባ ኣፋዌ። ስኑንታኖ ክርስቶስኒ አሱሲክ ችምሜ የሬፌ ባርኔን አነ አባስናዋ ናስና ባሪክ ፌሴቴርዌ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ሀን አሱሶን ኤጵኖይ ኦኑ ንቶኪ ዬፋናነ ኬንትስሲ ኤጳቶትታዌ፤ ናጋኑ ደይ ኦሾትታ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>ኤስ አሱስን ናጋ ኦሸፌ ባር ባሳ ማጙ ዎስቶሶን ሃኤርቱ ስናናዌ።<verse eid="2JN 1:11"/></para>
  <para style="s1">ኮእኒ ናጋኒ ኦሽሾ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ንቶክ ትቹናክ ሾሌና ሾዎ ዉዛ ፋርዌ፤ ስኑንታኖ ዙታምባሴ አሲን ዳብዳቤክ ትቹናክ ኣነ ሾሎትዌ፤ ኤሴ ባርስታን ግራናስ ቱማ ስናናክ ንቶኪ ያራ ንቶኔን አነ ዎል ኡጰራ ዎሎናክ አብድ ዛግፋዉጝዌ። <verse eid="2JN 1:12"/><verse number="13" style="v" sid="2JN 1:13"/>ኮርቴራ ፋ ኤትኔሲ ናንጎታኒክቶ ናጋ ኔክ ኦሽሼድፋዌ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
