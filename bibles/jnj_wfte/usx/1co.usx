<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">-Yemsa New Testament</book>
  <para style="h">1 ቆሮንጦስ</para>
  <para style="toc1">ዎሲ ጳዉሎስኒ እሶንሳ ዎሲያ ቆሮንጦስኪ አሱኒ ሜያክ</para>
  <para style="toc2">1 ቆሮንጦስ</para>
  <para style="toc3">1 ቆሮ.</para>
  <para style="mt2">ዎሲ ጳዉሎስኒ ዎስያ</para>
  <para style="mt1">ቆሮንጦስኪ አሱኒ ሜያክ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ጳዉሎስ ቆሮንጦስኪ አሱኒ ሜያክ ትችና እሶንሳ ዎሲያስ ትቼናስ ቆሮንጦስሱክ ቶክና ቤቴክርስታኒስ ክርስቲናኒ ካሲክናዋ አማንቶሲክና ካብ ቾዋሲ ራኮክ ኮትባ እማክ ሳፋሬፋትዋ። ኤስ ካባሲክ ቆሮንጦሱክ ሾዉ ቴሳ አሱኒ ሜያ ፌሴፌ ግሪክኒ ካታማ ስንባስታን ደናሎ አካይያ ይስቴ ሮምኒ ሀእሱሲ አርክ ካታማዋ። ኤስ ካታማስ አካማ ናጋዳክ፤ ስኖይ ጌእኒ ዱቢዮክ፤ አካማኖን ታግት ፋ ማጙ አማላክናዋ ሀይማኖትሲክቶኒ ሾዎክና አርቶ ካታማዋ።</para>
  <para style="ip">ዎሲስ አርክሮን ቤቴክርስታኒስሲ ፋ ኦር ኦር ኬሳሶን፤ ዝናሶን፤ ጌርኬስን ቾዋሲክ፤ ኤጵነ ግሩነ አሲ ቾዋሲክ፤ ቤቴክርስታኒኒ ስትርኒ ቾዋሲክ፤ ኮርቶ አያናስ እማሲክቶነዋ ክቱን ካቡኒ ቾዋሲክናቱ ማኬፌዋ። ኤሲስማቶ ዎሲስ ኤስ ማምሱሲክቶክ ምስራቹኒ ካማስ ዎልጉባ እማናማቶቱ ማኬዋ።</para>
  <para style="ip">«ኬሽታና» ሀኦስ ዳራባሲክ እምና እማሲክቶስን አካማ ስንባሶን ቤስፋስ ኤደባ 13 ፋ ባር ሀን ማፃፋሲን አርቶ ድማ ይስቴራቱ ፋድቴፋዋ።</para>
  <para style="iot">ማፃፋስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">ክርስታናን ሜኒ ጋነያሲ ካቢ ኦር ኦር ኬሳ <char style="ior"><ref loc="1CO 1:10-4:21">1:10—4:21</ref> </char></para>
  <para style="io1">ጌርኬሳ <char style="ior"><ref loc="1CO 5:1-7:40">5:1—7:40</ref> </char></para>
  <para style="io1">ኮእሎክ ሹክቴ አሻሶን ሙኒ ቾዋክ ጳዉሎስ እምና ዎልጉባ <char style="ior"><ref loc="1CO 8:1-11:1">8:1—11:1</ref> </char></para>
  <para style="io1">ቤቴክርስታኒኒ ካነዋ ሀኦኒ ሺጶኒ ስትርነ <char style="ior"><ref loc="1CO 11:2-14:40">11:2—14:40</ref> </char></para>
  <para style="io1">ክርስቶስናዋ አማኝኒ ሜኒ ክቱን ካቡነ <char style="ior"><ref loc="1CO 15:1-58">15:1-58</ref> </char></para>
  <para style="io1">ዩዳክ ፌሴ ራካታ ክርስታናኒ ሜያክ ዛግቴ አርጋሱ <char style="ior"><ref loc="1CO 16:1-4">16:1-4</ref> </char></para>
  <para style="io1">ቴትኒ ቾዉነዋ ማፃፋሲ ኮርኡነ <char style="ior"><ref loc="1CO 16:5-24">16:5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>ሀኦሲ ፍቃድክ ክርስቶስ የሱስኒ ዎሲ ስናናክ ቴግቴ ጳዉሎስናዋ አይኒ ስና ሶስቴኒሲክና፤ <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>ቆሮንጦስኒ ካታማሲ ፋ ሀኦሲ ቤቴክርስታኒክ፤ ባሪሲ ፌሴ ክርስቶስ የሱስኒክ ኮርቶ ስነ ባሶክናዋ ኮርቶ ስኖነክ ቴግቴ ባሶክና፤ ኤሲስማቶ ድማ ድማሲ ባሶክናዋ እኖክና ዳም ስና ዳምኒ የሱስ ክርስቶስኒ ሱናሶን ቴግሴፌ ባሶ ዙታምቤሲሴ አሲክ፤ <verse eid="1CO 1:2"/><verse number="3" style="v" sid="1CO 1:3"/>አባን ስና ሀኦስክናዋ ዳም የሱስ ክርስቶስኒክና ኦቱምነዋ ናጋነ ንቶክ ስንፋውጝዋ።<verse eid="1CO 1:3"/></para>
  <para style="s1">ጋላታ ሀኦሲክ</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>ክርስቶስ የሱስኒኪ ካሞ ሀኦስ ኦቱምባሶን ንቶክ እምና ቦርአ ዎንና ዎንና ሀኦናሶን ጋላቴፋዉጙዋ። <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>ዙታምባሴ አሲክ ዎላክ ስኑን አሩክ ክርስቶስ የሱስኒክ ኦቱም ስንነትዋ። <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>ክርስቶስኒ ቾዋሲክ ማኬን ዛላስ ንቶኪክ ዛግራቱ ፋዋ። <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>ኤስ ባሪ ቦርኣ ዳምኒ የሱስ ክርስቶስኒ አምማኖን ዮሶን ኦደት ፋሴፌት ካባሲክ ሀኦሲ አያናን እማስኒ እሳርንኑ ንቶክ ኣፋ ዮኡና ዉዛ። <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>ዳምኒ የሱስ ክርስቶስ ዎል ሌ ዮና ዎኖ ዝኒት ፎንቶ ስንና ኮእባስታ ካርአናኔን ችማ ፎትክ ንቶትን ዛጋዎዋ። <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>ናባ ስንና ዳምኒ የሱስ ክርስቶስኔን አነ እሳርኒት ፎናክ ንቶትን ቴጌ ሀኦሲ አማናምቶዋ።<verse eid="1CO 1:9"/></para>
  <para style="s1">ክርስታናኒ ሜኒ ጋነያሲ ዛግቴ ኦር ኦር ኬሳ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>አይታሳክቶኖ! «ንቶ ጋነያሲ ኦር ኦር ኬሳ ፎናታዋ፤ ዙታምኒትሴ እሳ ንባክናዋ እሳ ሳፋራክና ችምማ ፎትዋ» ይራ ዳምኒ የሱስ ክርስቶስኒ ሱናሲክ ሺጴፋዉጙዋ። <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>አይታሳክቶኖ! ንቶ ጋነያሲ ፋሶ ፋናማቶ ኬሎኤኒ ኬር ፌሴ ሜያኪን ኦደጝዋ። <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>ኤሲስ ደይ ንቶ እሳ እሳርኒትስ፦ «ታ፤ ጳዉሎስኒር፥ ታ፤ አጵሎስኒር፥ ታ፤ ጴጥሮስኒር፥ ታ፤ ክርስቶስኒርዋ» ይሴፌት። <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>ኤካን ክርስቶስ ባግቴዎሶ? ጳዉሎስ ንቶክዋ እያት ሱቴዎሶ? ወደይ ሀጱክቴሴቲስ ጳዉሎስኒ ሱናሲኮሶ? <verse eid="1CO 1:13"/><verse number="14" style="v" sid="1CO 1:14"/>ታ፤ ቀርስፖስንናዋ ጋዮስንናታኖ ንቶስን ኦኒንኑ ኣነ ሀጵቁት ስንና ቦርአ ሀኦናሶን ጋላቴፋዉጙዋ። <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>ኤስ ባሪ ቦርኣ፦ «ታ፤ ጳዉሎስኒ ሱናሲክ ሀጱክቴጝዋ» ይሬ ማኮክ ችምኒር ኦኑ ኣፌዋ። [<verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>ፉቶዋ፤ እስጥፋኖስኒ ኬርኪ ሜያኖን ሀጵቅጝዋ፤ ኤስ ባሶኔን ኦም ሀጵቅና አስሱ ፎባሶን ኣነ ያዳቶትዋ።] <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>ክርስቶስ ታን ዎሲናስ ምስራቹኒ ካማሶን ማኮናክታኖ ሀጵቁናክታዋ፤ ክርስቶስኒ ሜስቀሊስ ሽማ ስንና ፉእቶኖይናማቶ ምስራቹኒ ካማሶን ማኬፋናስ አሱኒ ቴችማክ ቤስቴ ዎላክታዋ።<verse eid="1CO 1:17"/></para>
  <para style="s1">ክርስቶስ ሀኦኒ ቴቹምነዋ ሁግናነ ስንናማቶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>ሜስቀሊሲ ካማ ትሹኒ ባሶክ ጎዉምማ ስንናቱ ፋድቴፋ፤ ስኑንታኖ ፋሩኒ እኖክ ሀኦኒ ሁግናዋ።<verse eid="1CO 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CO 1:19"/>«ቴቹምኒ ሜኒ ቴችማሶን ትሽኩና፤</para>
  <para style="q2" vid="1CO 1:19">አሩኒ ሜኒ አሩሶን ሽማ ዛጉናዋ»</para>
  <para style="m" vid="1CO 1:19">ይስቴራ ትቼዋ።<verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>ኤካን ቴቹም አይፌሶ? ቱማሲ አሩ ደይ አይ ፌሶ? ሀን ነያሲ ቱእኒኚኛስ አይ ፌሶ? ሀኦስ ሀን ዳስታኪ ቴችማሶን ጎዉምማ ኣነ ዛጉዋኖሶ?<verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>ሀን ዳስታኪ አሱኒ ሜያ ባሶ ቴትኒ ቴችማሲክ ሀኦሶን አሩ ችሞኖይቴማቶ ሀኦስ ቴቹምባሲክ ኩልፍዋ። ስኑንታኖ ጎዋንማቶ ፋድቴፌ እንኖ ማኬፌኒ ምስራቹኒ ካማሲክ አማነፌ ባሶትን ፋቱናክ ሀኦሲ ፍቃድ ስኒዋ። <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>ኣጌኑ ስንፋናነ አይሁድኒ ሜያ ቢስቴራ አሪቶኖይ ዉዛ ብያ ሾልሴቴርዋ፤ ግሪክኒ ሜያ ደይ ቴችማቱ ሾልሴፌዋ። <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>ስኑንታኖ እንኖ ክርስቶስ እኖክዋ እያት ሱቶባሶንቱ ማኬፌኒዋ፤ ኤስ ባር ደይ አይሁድኒ ሜያክ ቱሳ፤ ግሪክኒ ሜያክ ደይ ጎዉምማዋ። <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>ስኑንታኖ ቴግቴ ባሶክ አይሁድ ስኖቶ ግሪክኒ ሜያክ ክርስቶስ ሀኦሲ ሁግናነዋ ቴቹምነዋ። <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>ኤሲስ ደይ ሀኦሲ ጎዉምማ አሱኒ ሜኒ ቴችማስታን ደናሎዋ፤ ሀኦሲ ሆፕያ ደይ አሱኒ ሜኒ ሁግናስታን ደናሎዋ።<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>አይታሳክቶኖ! ሀኦስ ንቶትን ቴጌና ካባሲክ አዉነ ፌ አስሱ ስንነትማቶ ያዳቶትዋ። አሱኒ ሳፋራስማቶ ንቶ ጋነያስን ሾዎኒ ሜያ ቴቹም ወደይ ችም ወደይ አርቶ አስሱ ኣፍሶቶዋ። <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>ስኑንታኖ ሀኦስ ቴቹምኒ ሜያኖን ኢሹናክ ሀን ዳስታኪ ጎዋንማቶ ፋድቴሴፌ አሱኒ ሜያኖን ኮሪዋ፤ ችምኒ ሜያኖን ኢሹናክ ሀን ዳስታኪ ፌሴ ሆፕኒማቶ ስንነ ፋድቴሴፌ ባሶትን ኮሪዋ። <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>ሀኦስ ሀን ዳስታኪ አሱኒ ሜኒ ስንናክ ኡልፍንቶ ይስቴ ዉዛሲክቶኖን ኡልፍንቶኖር ስንባሶን ቤሱናክ፤ ሀን ዳስታኪ ዳካሎ ስና ባሮንናዋ ካሽስቶ ባሮንና ደይ ሽማ ስንና ዉዛሶን ኮሪዋ። <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>ኤስ ባሮን ደይ ዛግናስ ኦኑ ሀኦሲ ስንናክ ባሳ ቴትኒ ሳፋራሲክ ቴቶኖይናማቶዋ። <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>ስኑንታኖ ሀኦስ ንቶትን ክርስቶስ የሱስኔን አነ እሳርኒት ፎናክ ዛግዋ። ኤስ ባሪ ቦርኣ ሀኦስ ክርስቶስ የሱስኒን እኖክ ቴቹምኒ፤ ኦኮኒ፥ ኮርቶኒናዋ ፉሪና ዛግራ እኖክ እሚዋ። <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>ኤሴ ማፃፋስሲ ደይ፦ «ቴቴፌ ባር ዳሚሲክ ቴቶዎዋ» ይስቴራ ትቼናማቶዋ።<verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="s1">ሱቴ ክርስቶስኒ ቾዋሶን ማኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>አይታሳክቶኖ! ታ፤ ንቶኪ ያና ካባሲክ ሀኦሲ ኣቾ ቾዋኖን ማኬናስ ዎሉምኒ ችማክ ወደይ አካማ ቴቹምኒ ቤሱክታዋ። <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>ንቶኔን አነ ፋና ካባሲክ የሱስ ክርስቶስንናዋ ኤሲስ ደይ ሜስቀሊስታ ሱቴሬ ክቱባሶንታኖ ኦማ እሳ ዉዛኑ አሩኖይናማቶ ቡግራ ፋናር። <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>ኤስ ባሪ ቦርኣ ንቶኔን ፋና ካባሲክ ሆፕ ስንና ድጋክናዋ አካማ ቆርኩክናቱ ፋኒ። <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>ዎሉምናሴዋ ማኮናሴ አሱኒ ቴችማክናዋ ዎሉምኒ ካቱክ ስኖይናሮን ሀኦሲ አያናኒ ሁግናኖን አምማኖን ቤሱክዋ። <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>ኤስ ባሮን ደይ ዛግናስ አማንቶኒቲስ አሱኒ ቴቹምታ ካፑቴር ስኖይናሮን ሀኦኒ ሁግናክ ቴቶናክዋ።<verse eid="1CO 2:5"/></para>
  <para style="s1">ሀኦኒ ቴችማ</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>ስኑንታኖ አያናክ ፎክ ችም አሱኒ ሜያክ ቴችማክቱ ማኬፌን፤ ስንፋናክኑ ማኬፌኒስ ደይ ሀን ዳስታኪ ቴችማክ ወደይ ትሹኒ ሜኒ ሀን ዳሶን ሀእስሴፌ ባሶ ቴችማክታዋ። <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>ስኑንታኖ እንኖ ማኬፌኒስ ሀኦስ ዜምማ ሾዎ ነያኔን እንኖ ኡልፍናሲክ ሆስና ባሬዋ ኣቼራ ፋ ሀኦሲ ኣቾ ቾዉኒ ቴችማኖንዋ። <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>ሀን ዳሶን ሀእሲፌ ባሶ ጋነያስን ሀን ቴችማሶን አሪር ኦኑ ኣፌ፤ አርሴቴ ስንፋናነ ኡልፍንኒ ዳሚስን ሱቶሶነ ካባታዋ። <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>ስኑንታኖ ማፃፋስሲ፦</para>
  <para style="q1" vid="1CO 2:9">«ኣፋ ብኖይናሶን፤</para>
  <para style="q2" vid="1CO 2:9">ኦዶ ኦዶኖይናሶን፥</para>
  <para style="q2" vid="1CO 2:9">አሱኒ ንባ ሳፋሮኖይናሶን፤</para>
  <para style="q2" vid="1CO 2:9">ሀኦሶን ሹንፌ ባሶክ ሆሲዋ»</para>
  <para style="m" vid="1CO 2:9">ይስቴራ ትቼናስማቶዋ።<verse eid="1CO 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 2:10"/>ስኑንታኖ እኖክ ሀኦሲ አያንባሲክ ካሞ ኣቾ ቾዋሶን አምማኖን ቤስዋ። ሀኦሲ አያና አካማኖን ኣቾ ስና ሀኦሲ ቾዋኖኑ ፉኦኖይ ዙትራ ቱእኒርዋ። <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>አሱኒ ቾዋሲክ ስናር ስንፋናነ ባሳ ቴትኒ አያናስታኖ ኦማ ባሳሲ ፋ ሳፋራሶን አሪፌር ኦንሶ? ኤሲስማቶ ሀኦሲ አያናታኖ ሀኦሲ ሳፋራኖን አሩኒር ኦኑ ኣፌዋ። <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>ሀኦስኪን እምቴ ዉዛሶን አሩኒክ ሀኦሲ አያናኖንቱ ኤጳታኒታኖ ሀን ዳሲ አያናኖን ኣነ ኤጳቶዌኒዋ። <verse eid="1CO 2:12"/><verse number="13" style="v" sid="1CO 2:13"/>ኤስ ባር ደይ አያናኒ ዉዛሶን አያናክ ፌሴፌ ባሶክ ማኬፌኒስ አሱኒኪን ቤስቴፋ ቴችማሲክ ስኖይናሮን ሀኦኒ አያናስኪን ቤስቴፋ ቴችማሲክዋ። <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>ስኑንታኖ ሀኦሲ አያና ባሳሲ ትሽፋን አሻክ ፌፌ አስሱ ሀኦኒ አያናስኪን እምቴፋ ዉዛሲክቶኖን ኣፋ ኤጴቶና ዉዛ። ኤስ እምቴ እማሶን ቱኡኒፌናስ ሀኦሲ አያናኪ ካሞ ስንና ቦርአ ኤስ አሱስ ያዳቶናክ ኣፋ ችማናዉዛ። <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>ስኑንታኖ ሀኦኒ አያና ባሳሲ ፋና ባር ዙታምባሴ አስን ቱእኒር። ስኑንታኖ ባር ቴትባሲክ ኦንክኑ ኣነ ቱእንቴፌ። <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>ኤሲስ ደይ፦</para>
  <para style="q1" vid="1CO 2:16">«ዳሚሳ ሳፋራኖን፤</para>
  <para style="q2" vid="1CO 2:16">ኦ አሩክ ችምንሪንሶ?</para>
  <para style="q2" vid="1CO 2:16">ባሪን ኪቱክ ችምንር ኦንሶ?»</para>
  <para style="m" vid="1CO 2:16">ይስቴራ ትቼናስማቶ፥</para>
  <para style="p" vid="1CO 2:16">ስንፋናክኑ ክርስቶስኒ ንብባሲ እንኖሲ ፋርዋ።<verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">ቆሮንጦስኒ ቤቴክርስታኒሲክ ኦር ኦር ኬሳ ካብ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>አይታሳክቶኖ! ታ፤ ንቶትን አስፋና ካባሲክ አሽኒ ሳፋራክ ክርስቶስኒኪ ሀሽኑ ችምማ የሮኖይ ዳጋ ናንጎታ ስንነትማቶታኖ ሀኦኒ ካማክ ፌሴፌ ባሶሲማቶ ዛግራታዋ። <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>ችማ ሙኒ ሙክ ችምኖይ ዳጋ ናንጎታ ስነት ቦርአ ታ፤ ንቶትን ሻቦታኖ ችማ ሙ ኣነ ማሱትዋ፤ ሀሽኑ ስንፋናክ ንቶ ችማ ሙኒ ሙክ አነ ችሜትዋ። <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>ንቶ ሀሽኑ አሽኒ ሳፋራክ ፌ አሱዋ፤ ንቶትና ንቶትና አስሲ ዎል ኮኖነዋ ካራካሮነ ፋር ስንና ቦርአ አሽኒ ሳፋራክ ፌር ስንትታኖሶ? ዎስቴት ፋሴቲ ዎስቶስ ደይ ባክ አሱኒማቶታኖሶ? <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>እሳር፦ «ታ፤ ጳዉሎስኒርዋ» ኦሚስ ደይ፦ «ታ፤ አጵሎስኒርዋ» ይፌና ካባሲክ ባክ ሀን ዳስታኪ አስሱ ስኒትሶንታኖሶ ቤሲፋናሪ? <verse eid="1CO 3:4"/><verse number="5" style="v" sid="1CO 3:5"/>ሻካፎት አጲሎስ ኣምቤንሶ? ጳዉሎስ ኣምቤንሶ? ባሶ ንቶ አማኖትክ ዛግ ዎስትኛዋ፤ እሳ እሳርቤሲስ ዎስቴሴፌስ ዳሚሲክ ባሶክ እምና ዎስቶሶጝዋ። <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>ታ፤ ቶኪን፤ አጵሎስ አካ ኡሽ፤ ስኑንታኖ ድቺስ ሀኦስዋ። <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>ኤስ ባሪ ቦርኣ ዎስቶሲክ አሪክሮን ሾልሱ ስናስ ድች ሀኦስታኖ ቶካ ባር ስኖ አካ ኡሽ ባር እሳ ዉዛታዋ። <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>ቶካ ባር ስኖ አካ ኡሽ ባር እሳ ባርዋ፤ እሳ እሳርባስ ዎስቶባስማቶ ቴትባሲ ዋጋኖን ኤጴቶናዋ። <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>እንኖ ንቶኔን አነ ሀኦሲክ ዎስቴ ዎስትኛዋ፤ ንቶ ደይ ሀኦሲ ፎሽነዋ ሀኦሲ ሹእኒ ኬነዋ። <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>ሀኦስ ታክ እምና ባሪ ኦትማሲማቶ እሳ ሀጤ ሹእኒ ኬያ ኬርእፌ ኬርእኛንማቶ ካፑታ ኩንስንዋ፤ ኦሚስ ደይ ታ፤ ካፑትና ካፕታስታቱ ኬርአናዋ። ስኑንታኖ እሳርባ እሳርባስ ኤስ ባርስታ ኣካክ ኬርአናማቶ አሩናክ ሾልስፋዋ። <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>እሳርጋ ካፑቴ ካፕታስታን ኦኑ ኦማ ካፕታ ካፑታናክ ኣፋ ችማናዉዛ፤ ኤስ ካፕታስ ደይ የሱስ ክርስቶስዋ። <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>ኦኑ ኤስ ካፕታስታ ዋርቄክ ወደይ ብሪክ፤ ማአ ኡልፍንቶ ሹአክ ወደይ እኦክ፤ ሻአክ ወደይ አጋዳክ ኬርአር ፌፋናነ፤ <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>አስሱ እሳ እሳርባሳ ዎስቶ አምማኖን ኬስሳ ቤስቶና ማጝሱኒ ካርኒ ዎናስ ዮናዋ፤ ኤስ ዎኖ እሳ እሳርባሳ ዎስቶ አዉነፋር ስንናማቶ ጌያክ ፋታንቴራ ቢስቶና። <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>እሳ ሹኒ ኬያ ኬርእኛአስ ካፑትና ካፕታስታ ዎስቴና ዎስቶስ ጌያክ ፋታንቴራ ኪቾኖይ ፉእቴፋናነ ሹኒ ኬያሶን ኬርአ ባር ዋግባሶን ዳናናዋ። <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>ዎስቶባስ ጌያክ ኪቼና ኬርእኛአስ ዳናና ዋግባሶን ቱርኩናዋ፤ ስኑንታኖ ባር ቴትባሲክ ጌያሲ ካሞ ኣትፋት ኪቾኖይ ፉእቴ አሱኒማቶ ስንኔ ፋሩናዋ። <verse eid="1CO 3:15"/><verse number="16" style="v" sid="1CO 3:16"/>ሀኦሲ ቤቴሜቅደስ ስኒትማቶናዋ ሀኦሲ አያና ደይ ንቶስሲ ፋፋናማቶና ኣነ አሩዌትኖሶ? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>ኤሴ ኦኑ ሀኦሲ ቤቴሜቅደስኖን ቦጋናነ ሀኦስ ባሪን ቦጋርዋ፤ ሀኦሲ ቤቴሜቅደስ ኮርቶዋ፤ ኤስ ቤቴሜቅደሲሲ ደይ ንቶዋ። <verse eid="1CO 3:17"/><verse number="18" style="v" sid="1CO 3:18"/>ንቶስን ኦኑ ቴትባሶን ኤሻናታዋ፤ ሀን ዳስታኪ ቴቹምኒ ጌፋሲክ ቴቹም ስንነ ቤስቴር ፌፋናነ ሀኦሲ ፉቶ ቴችማኖን ዳናናክ ቴትባሶን ጎዋ ዛግሬ ፋዱዎዋ። <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>ሀን ዳስታኪ ቴችማስ ሀኦሲ ስናክ ጎዉምማዋ፤ ኤሲስ ደይ ማፃፋስሲ፦ «ሀኦስ ቴቹምኒ ሜያኖን ማጙቤሲሲክ ባሶትን ኤሽሚያ ስንና ኤጳናዋ» ይስቴራ ትቼናስማቶዋ። <verse eid="1CO 3:19"/><verse number="20" style="v" sid="1CO 3:20"/>ኤሲስማቶ ደይ፦ «ዳሚስ ቴቹምኒ ሜኒ ሳፋራስ ሽማ ስንናማቶ አሪፌኒዋ» ይስቴራ ትቼዋ። <verse eid="1CO 3:20"/><verse number="21" style="v" sid="1CO 3:21"/>ኤስ ባሪ ቦርኣ ዙታምባሴ ንቶር ስንና ቦርአ ኦኑ አሱኒክ ቴቶናታዋ። <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>ጳዉሎስ ስንፌናክ አጲሎስ ስንፌናክ ጴጥሮስ ስንፌናክ ሀን ዳስኑ ስንፋናክ ካስኑ ክቱስኑ፤ ሀሽቲ ፋ ባርኑ ስኑን ዮኒ ባር ዙታምባሴ ንቶርዋ። <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>ስኑንታኖ ንቶ ክርስቶስኒር፤ ክርስቶስ ደይ ሀኦኒርዋ።<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">ክርስቶስኒ ዎስትኛ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>ኤሴ አስሱ ዙታምባሴ እኖትን ክርስቶስኒ ዎስትኛ ስንኒማቶናዋ ሀኦሲ ኣቾ ቾዋኖን አምማኖን ክስሬ ማኮኒ ሀእሱኒ ሁግና እምቴና አዳራ ኤጶ አስሱ ዛግሬ ፋዱናክ ሾልሱዋ። <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>አዳራ ኤጳ አሱኒ ሜያ አማናምቶ ስነሬ ቤስቶሶነክቱ ሾልስፋዋ። <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>ታ፤ ቾዋሲክ ስንፋናነ ንቶኑ ታይስታ ማጝሱ ካርኤፌትክ ወደይ ኦም አስሱ ታይስታ ማጝሱ ካርፌናክ እሳ ግድና ኣፋዋ። ፉቶሲክ ታ፤ ታ፤ ቴታሲክ ታይስታ ማጝሱ ካርአናክ ኣፋ ችማናዉዛ። <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>ታ፤ አሪፋናሲማቶ ስንፋናነ ካኑናስ ኣነ ታን ዋቃሴፋዋ፤ ስኑንታኖ ታይስታ ማጝሱ ካርኒስ ዳሚስ ኮእባዋ። <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>ኤስ ባሪ ቦርኣ ዎንባስ ካርኖይፌን ወደይ ዳሚስ ማጝሱኒ ካርአክ ዮኖይፌን ኦኒስታኑ ማጝሱ ካርአቲታዋ፤ ባር ዬና ዎኖ ታልማሲ ኣቸራ ፋ ኣቾ ቾዋሶን ቻሬፋስታ ክሱናዋ። አሱኒ ሜኒ ንብባሲ ኣቸራ ፋ ሳፋራሶን አምማኖን ክሱናዋ፤ ኤስ ካባሲክቱ አስሱ እሳ እሳርባሲክ ሀኦስኪን ሾልሱ ጋላታ ዳናናዋ። <verse eid="1CO 4:5"/><verse number="6" style="v" sid="1CO 4:6"/>አይን ሜያነ! ንቶክ ኬእኒ ዉዛሲክዋ እያት ሀን ቾዋሲክ ታናዋ አጲሎስኒንና ቤሶ ዛግራ ማኬጝዋ፤ ኤስ ባሮን ደይ ዛግናስ፦ «ትቼ ባሪስታን ኣታታታዋ» ይፋ ኪቶሶን እኖኪን አሩትክዋ እያትዋ። ኤስ ባሪ ቦርኣ እሳ አሱኒክ ቴቴፋት ኦሚስን ካሹትክ ኣነ ሾልስፋዋ። <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>ነ፤ ኦሚሳታን አዉክ አርኩታስሶ? ኦሚስኪን ኤጳቶኖታ ዉዛ ኣምባንሶ? ኤካን ዙታምባሴ አስን ኤጳ ታታስ ኦሚስኪን ስንናኔን ኦሚስኪን ኤጴቶኖይ አሱኒማቶ አዉኒሮን ቴቴፋስሶ? <verse eid="1CO 4:7"/><verse number="8" style="v" sid="1CO 4:8"/>ሀሽኑ ንቶክ ሾልሲ ዉዛሶን ዙትራ ዳንትዋ! ሀሽኑ ደይ ኦቱም ስንነትዋ! እኖስታን ኦር ኬስሳ ታቶ ስንትዋ! ፉቶክ ታቶ ስነት ስንፋናነ እንኖ ደይ ንቶኔን አነ ታቶኒር ስንና ቦርአ ማአሪ ስንናና ካባዋ። <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>ኤስ ባሪ ቦርኣ ሀኦሲ ዎሲ ስና እኖትን ክቱኒ ማጝሱኒ ካርአ ባሶስታ ካቴን ዎርቶሶነ ድማ ኦቴሬ ሀሜፌ አሱኒ ሜኒ ጋነያስን ኮእኒስ እንኖ ስንማቶቱ ታክ ቤስቴፋዋ። ኤስ ባርስታን ካብ ቾዋ ሀን ዳ ዙታምባሴ አሲስ ሀኦኒ ዎስያኑ ስንፋናክ አሱኒ ሜኒ ስንናክኑ ስንፋናክ ቢስቶኒ ዉዝንማቶ ስንና ቤስቴፌንዋ። <verse eid="1CO 4:9"/><verse number="10" style="v" sid="1CO 4:10"/>እንኖ ክርስቶስኒክዋ እያት ጎዋ ስንኒዋ፤ ስኑንታኖ ንቶ ክርስቶስኒኪ ካሞ ቴቹምኒ ሜያ ስንነትዋ፤ ኤሲስማቶ እንኖ ሆፕን ሜያ ስንኒዋ፤ ስኑንታኖ ንቶ ደይ ችምቤሲ ፋና ሜያ ስንነትዋ፤ ንቶ ደይ ኡልፍንቶ ስንነትዋ፤ ስኑንታኖ እንኖ ሳልጳቴር ስንኒዋ። <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>ኤስ ሳአትስ ካርአና ካባኔን ማክቴፌኒ፤ እክቴፌኒ፤ አታቱ ስንፌኒ፤ እቼፌኒ፤ ዱኒ ኬያ ቱርኩክ ራካቴፌኒ። <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>እንኖ ቴትኒ ኩሹሲክ ዎስቶክ ሆፕፌኒ፤ እኖትን ኤርውሴፌን ኤቢስፌኒ፤ ካብግሴፌን ፋክፌኒ፤ <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>እኖትን ሜእኤፌንናዋ ሱንኒሶን ማጝስሴፌንና ማአሮን ባሶክ ዎልግፌኒ፤ ኤሴን ሀውጙ ካርአ ሀን ዳስታክ ሀእቶ ዉዝነዋ ፉትቴራ ሀእቴ ዲምነ ስንኒዋ። <verse eid="1CO 4:13"/><verse number="14" style="v" sid="1CO 4:14"/>ታ፤ ሀን ባሮን ንቶክ ትችናስ ሹንቶ ናንጎትና ስንነትማቶ ዛግራ ኪቱናክታኖ ንቶትን ኢሽሹናክዋ እያታዋ። <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>አዉኑ ስኑን ክርስቶስኒኪ ካሞ ሾዎ ዞንስንቲ ፌፌናክኑ ሾዎ አባንት ኣፌዋ፤ ስኑንታኖ ታ፤ ንቶትን ክርስቶስ የሱስኒ ምስራቹኒ ካማሲክ ኮንጝዋ። <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>ኤስ ባሪ ቦርኣ ታ፤ ቤሶሲክ ዞኑስቶትክ ሺጴፋዉጙዋ። <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>ኤስ ቾዋሲክ ሹንቶናዋ አማናምቶና ስንና ደይ ዳሚሲክ ናታ ስና ትሞትዮስኒን ንቶኪ ዎስጝዋ። ዳ፤ ዳስንናዋ ሾዎ ቤቴክርስታኒስንና ታ፤ አሲፋናይሲማቶ ባር ታ፤ ክርስቶስኒኪ ካሞ ዳና ጋድዶ ካሲ አጃጅኖን ንቶክ ያዳሱናዋ። <verse eid="1CO 4:17"/><verse number="18" style="v" sid="1CO 4:18"/>ንቶስን እሳ እሳይስ ንቶትን ብያክ ዮ ቤያናርነ ፋር ስንና ባሶክ ቤስቴፋን ቤጋንቶክ ቱሜሴቴዋ። <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>ስኑንታኖ ዳሚሳ ፍቃድ ስንፋናነ ሀን ታአ ዎናስሲ ንቶኪ ዮናዋ። ኤስ ካባሲክ ኤስ ቤጋንቴሴፌ ባሶ ዎላሶን ኮእባ ስኖይናሮን ሁግናቤስሶንኑ አሩናክ ሾሌፋዉጙዋ። <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>ሀኦሲ ታቶ ዎሉምኒ ቾዋታዋ፤ ስኑንታኖ ሀኦኒ ሁግናዋ። <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>ሾሌፌትስ ኣምባንሶ? ኬኦኒ ሃሮ ኤጳ ንቶኪ ዮናክጝዋ ወደይ ኬሽታናክናዋ ጋራምኒ አያናክና ዮናኪ ሾሌፌትሪ?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">አማኝኒ ሜኒ ጋነያሲ ዛግቴ ማጙ አማላ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>ንቶ ጋነያሲ ኢቹ ሶሎኒ ዝና ፋናማቶ ዎሉምቴድፋርዋ። ኤስ ኤፋቴና ሶሎኒ ዝናስ አዛብኒ ሜኒ ጋነያስኑ ኣነ ዛግቴፋዋ። ኤሲስ ደይ ቱሽኒ እንቶባሶን አስሱ ዛግሬ ኤጳ አስሱ ንቶ ጋነያሲ ፌርዋ ይስቴዋ። <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>ኤካን ኤስ ኤፋቴና ኢቹ ቾዋ ንቶ ጋነያሲ ፌን አዉኒሮን ቤጋንቴፌትሶ? ኤሲስታን ሀን ቾዋሲክ ሱሞትክ ኣነ ሾልሱዋኖሶ? ኤስ ኤፋቴና ዎስቶሶን ዛግ አሱስን ንቶ ጋነያስን ኦር ክሱትዋ። <verse eid="1CO 5:2"/><verse number="3" style="v" sid="1CO 5:3"/>አዉነ ፋሮን ታ፤ አሻክ ንቶኔን አነ ፎ ቤይፋናክኑ አያናክ ንቶኔን አነቱ ፋዉጝዋ፤ ንቶኔን አነ ፋናሪማቶ ስንና ኤስ ኤፌቴና ዎስቶሶን ዛግ አሱሳታ ዳሚሳ ሱናክ ማጝሱ ካርእጝዋ። <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>ዙቴሴፌት ካባሲክ ታ፤ ደይ ዳም የሱስኒ ሁግናሲክ ንቶ ጋነያሲ አያናክ ፋናር ስንና ቦርአዋ። <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>ቦርአክ ቱሜ ፌ ሀን አሱሳ አሻ ትሹናክ ሴጣናሲክ ኣትራ እማትክ ሾልሱዋ። ኤስ ባሮን ደይ ዛጉሶቲስ ዳም የሱስ ማጝሱኒ ካርአክ ዬፌና ዎኖ ኤስ አሱሳ ካ ፋሩናክዋ። <verse eid="1CO 5:5"/><verse number="6" style="v" sid="1CO 5:6"/>ኤሴ ቴቶንትስ ማአርታዋ፤ ኪስኩ ማሶስ አካማ ቱሾሶን ክስፋናማቶ ኣነ አሪፌትኖሶ? <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>ሀሽቲ ስንትስማቶ ማሶባ ፎንቶ ኦራ ቱሾንማቶ ስንናትክ ሀጅፋ ድ ማሶሶን ትሽኩትዋ። እኖክ ፋስካኒ ፋንቱ ስንና ክርስቶስ ሹክቴዋ። <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>ኤስ ባሪ ቦርኣ ማጙነዋ ቤጋንቶነ አስክ ቱምማ ሀጅራ ድ ማሶሲክ ስኖይናሮን ማሶባ ፎንቶ ጋራማክናዋ ፉቶክና ቂጣኒ ኤቦሶን ኡልፍንሱኒዋ። <verse eid="1CO 5:8"/><verse number="9" style="v" sid="1CO 5:9"/>ዜሞቲ ንቶክ ትችና ዎስያሲክ ሶለፌ ባሶኔን አነ እሳር ስንናትታ ይራ ፋናርዋ። <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>ኤስ ባሮን ደይ ይናስ ዙቲ ኤጳ ሀን ዳስታኪ ሶልሴፌ ሜያኔን ወደይ ጆርሴፌ ባሶኔን ወደይ ዊስኒ ሜያኔን ወደይ ኮልሎ ሺጲሴፌ ሜያኔን አነ ፎቲታ ኡናታዋ። <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>ስኑንታኖ ታ፤ ሀሽ ትችና አማኝኒ ሜያ ይስቴፋት ሶለሴፌ ባሶኪን ወደይ ጆሬሴፌ ባሶኪን ወደይ ኮልሎ ሺጵሴፌ ባሶኪን ወደይ አሱኒ ሱና ማጝስሴፌ ባሶኪን ወደይ ዛየሴፌ ባሶኪን ወደይ ቦኤሴፌ ባሶኔን አነ እሳር ስንናትታዋ ኡናዋ። ኤስ ኤፌቴና አሱኒ ሜያኔን አነ ሙኑ አነ ሙቲታዋ። <verse eid="1CO 5:11"/><verse number="12" style="v" sid="1CO 5:12"/>ክርስታናኒ ሜኒ ማባራሲ ጌራካሎ ፌሴ አሱኒ ሜያስታ ማጝሱ ካርኒስ ታ፤ ኦንሶ? ክርስታናኒ ሜኒ ኬርካሎ ፌሴ አሱኒ ሜኒ ቾዋሲክ ንቶ ቴትንትሲክ ማጝሱኒ ካርአ ችምቲርታኖሶ? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>ጌሮክ ፌሴ አሱኒ ሜኒ ቾዋሲክ ማጝሱ ካርኒስ ሀኦስዋ፤ ኤሴ ማፃፋሲ፦ «ማጙ አሱስን ንቶ ጋነያስን ኦር ክሱትዋ» ይፋዋ።<verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">ክርስታናን ሜኒ ጋነያስ ፋ ማላታ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>ንቶስን እሳይስ ክርስታና ስና አይባስኔን አነ ፋሴፋናነ ቾዉባሶን ክርስታናኒ ሜያ ብዮነክ ዛጉስታን ማላቶናክ አማኖኖይ ሜኒ ሾንጎስታ ሀማናክ ኣካክ ችምሶ? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>ሀኦኒ አሱኒ ሜያ ሀን ዳስታክ ማጝሱ ካርኦነማቶ ኣነ አሩዌትኖሶ? ኤካን ሀን ዳስታክ ማጝሱ ካርአትር ስንፌን ሀን ጋሮ ዉዛሶን ማጝሱኒ ካርአ ሆፑትሮሶ? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>ሀኦኒ ዎስያስታኑ ማጝሱ ካርአኒር ስንናማቶ ኣነ አሩዌትኖሶ? ኤካን ሀን ዳስታኪ ቾዋሲክ ኣካክ ዳይስራ ማጝሱ ካርአ ቤያኒርንሶ? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>ኤሴ ንቶትና ንቶትና ዎል ፋሴፋትነ ክርስታናኒ ሜኒ ማባራስኔን ጌራካሎ ስና ካሽስቶ አሱኒ ሜኒ ስና ቾዉንትሶን ኣካክ ታእሱትሶ? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>ሀን ባሮን ማኬናስ ኢችሹክዋ እያትዋ። ሻካፎቲ ንቶ ጋነያሲ አይኒ ሜያኖን ማጝሱኒ ካርአ ችምኒ አሩባ ፋና አስሱ ኣፌኖሶ? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>ስኑንታኖ አይ አይባስን ማላቴሬ አማኖኖይ ሜኒ ማጝሱ ካርኒ ኬር ኤጴ ሀማስ ሾልሱኖሶ? <verse eid="1CO 6:6"/><verse number="7" style="v" sid="1CO 6:7"/>ኤሴ ንቶ ጋነያሲ ንቶትና ንቶትና ዎል ማላቴራ ካራካሬት ፎንቲስ ቴትባሲክ ሳልጲናዋ። ኤስ ባርስታን ንቶ ሚርአሜፋቲነታኖሶ ዋያይ? ኤሲስማቶ ንቶ ኤሽቴፋትነ ዋያታኖሶ? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>ስኑንታኖ ንቶ አይንቲ ስና ክርስታናኒ ሜያስታኑ ሚርእኦነዋ ኤሽሹነ ካትድፌትርዋ። <verse eid="1CO 6:8"/><verse number="9" style="v" sid="1CO 6:9"/>ጃልሲፌ ባሶ ሀኦሲ ታቶሲ ኣፋ ግርሶነ ዉዛ ስንናማቶ ኣነ አሪፌትኖሶ? ኤስ ቾዋሲክ ኤሽቶቲታዋ፤ እግፌ ባሶ፤ ሶለፌ ባሶ ወደይ ኮልሎ ሺጵሴፌ ባሶ ወደይ ጌርኬሴፌ ባሶ ወደይ ኣርቃርና ኣርቃርና ዎል ኤጴፌ ባሶ፤ <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>ወደይ ዊስኒ ሜያ፥ ወደይ ጆርቱኒ ሜያ፥ ወደይ ዛይኒ ሜያ፥ ወደይ አሱኒ ሱና ማጝስሴፌ ሜያ፥ ወደይ ቦእኛኒ ሜያ ሀኦሲ ታቶሲ ኣፋ ግርሶነ ዉዛ። <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>ንቶስን እሳ እሳይስ ኤሲስማቶ ስንና ፋሴትርዋ። ስኑንታኖ ሀሽ ዳምኒ የሱስ ክርስቶስኒ ሱናሲክናዋ ሀኦኒሲ አያናክና ቦርኒትስን ማስቴራ ካይምትዋ፤ ሀኦሲክ ኮርቴ ኮርቶ ዳራ ስነት ደይ ኦኮ ስንትዋ።<verse eid="1CO 6:11"/></para>
  <para style="s1">ጌርኬስኒ ቾዋ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>«ዙታምባሴ ታክ ፋቃድቴዋ፤ ስኑንታኖ ዙታምባሴ ታክ ኣፋ ኬአናዉዛ፤ ዙታምባሴ ታክ ፋቃድቴዋ፤ ስኑንታኖ ኣፋ ዉዛሲክኑ ቦዛ ስንና ኣፋ ሀእኡና ዉዛ። <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>ሙስ ካትንርዋ፤ ካታስ ደይ ሙኒርዋ» ኤካን፤ ሀኦሲ ሙሶን ጌዳ ካታሶን ጌዳ ትሽኩኒርዋ። ስኑንታኖ አቱኒስ ዳምኒ የሱስኒርዋ፥ ዳም የሱስ ደይ እንኖ አቱኒስር ስንና ቦርአ አቱኒስ ጌርኬሳሲ ዎስቶኖን ዎስቶናክ ኣነ ሾልስፋዋ። <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>ሀኦስ ዳም የሱስኒን ክቱን ካብግዋ፤ እኖትን ደይ ሁግናባሲክ ክቱን ካብጉናዋ።<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>አቱንቲስ ክርስቶስኒ አቱኒ ባግቶ ስንናማቶ አሪትርታኖሶ? ኤካን ክርስቶስኒ አቱሶን ኤጳ ታምማ ሶለፋ ማሽካሱሲ አቱስኔን አነ እሳር ስናናክ ዛጉ ሾልሱኖሶ? እሳንነ ኣነ ሾልስፋዋ! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>ሶለፋ ማሽካሱስኔን አነ ኩንፌ አስሱ ባርኔን አነ እሳ አቱ ስንባሶን አሪትርታኖሶ? «ሄፖቤሲሴ እሳ አቱ ስኖነዋ» ይስቴራ ትቼዋ። <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>ስኑንታኖ ዳም የሱስኔን አነ እሳር ስንፌ ባር ባርኔን አነ አያናሲክ እሳር ስንፌዋ። <verse eid="1CO 6:17"/><verse number="18" style="v" sid="1CO 6:18"/>ኤስ ባሪ ቦርኣ ጌርኬሳስታን ዎክትዋ፤ አስሱ ዛግፌና ቦርኣስ ዙቴራ አቱባስታን ጌራካሎቱ ዛግፌዋ፤ ስኑንታኖ ጌርኬስፌ አሱስ ባሳ ቴትኒ አቱስታቱ ቦርአ ዎስቴፌዋ። <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>ንቶ አቱስ ሀኦስኪን ኤጳ ታቲ ባሬዋ ንቶሲ ፋ ኮርቶ አያናሲ ቤቴሜቅደስ ስንናማቶ አሪቲርታኖሶ? ኤሴ ንቶ ሀኦሲርቴኖ ንቶ ንቶ ቴትኒርቴዋ። <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>ባር ንቶትን ዋጋክቱ ዋጌዋ፤ ኤስ ባሪ ቦርኣ አቱንትሲክ ሀኦሶን ኡልፍንሱትዋ።<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">ኤጵነ ግሩነ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>ንቶ ታክ ትችቲ ቾዋሲክ አስሱ ማሽካሱኔን አነ ኩኑ ሻካናነ ማአሪዋ። <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>ስኑንታኖ ጌርኬሳስታን ዎካክ ኣርቃሱ እሳርባ እሳርባስ ቴትባሪ አሱባ ፎጝዋ፤ ማሽካሱ እሳርባ እሳርባስ ቴትባሪ ቴጎባይ ፎዎዎ። <verse eid="1CO 7:2"/><verse number="3" style="v" sid="1CO 7:3"/>ቴጎ አሱባሲክ ዛጉናክ ሾልሲ ባሮን ካላናታ፤ ኤሲስማቶ አሱስ ደይ ቴጎባሲክ ሾልሲ ባሮን ካላናታ። <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>ማሽካአሱስ አቱባስ ባር ባርሪርታዋ፤ ቴጎሳርኔንጝዋ፤ ኤሴ ደይ ቴጎ አቱባስ ባር ባሳርታዋ፤ አሱባስርኔንጝዋ። <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>ችምማ ሀኦኒ ሺጶክ ሄፖንቲሴ ንቶትና ንቶትና ዎል ሜርኬራ ጋሮ ዎኒሮን ስና ሻካናነ ኦር ኬስሳ እሳይስ ኦሚሳ ማብትኖን ካላናታዋ። ኤስ ባሪ ቦርኣ ቴትንትሶን ኦዳ ሆፕራ ሴጣናክ ፋታንቶኖይትማቶ ዎላ እሳሪክ ፎትዋ። <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>ሀን ባሮን ይፋናስ ደይ አጃጅኒማቶ ስኖይናሮን ኪቶዋ እያትዋ። <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>አስሱ ዙቴሬ ታይሲማቶ አስሱ ኤጵኖይ ፌፋናነ ሹናና ካባዋ። ስኑንታኖ እሳርባ እሳርባሲክ ሀኦስ ኦማ ኦማ እማቱ እምዋ፤ እሳይሲክ እሳ ቴሳ እማ እሚ፥ ኦሚሲክ ደይ ኦማ ቴሳ እማ እሚዋ።<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>ግሩኖይ ባክ ዲሴ ባሶናዋ ቴጎቤስ ክትና ማሽካሱሲክቶነ አሲክ ይፋናስ ደይ ኤሲስዋ፤ ግሩኖይ ታማቶ ስንነ ፋሴፋቴነ ማአሪዋ። <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>ስኑንታኖ አሽኒ ኤናንቶክ ኪቾስታን ኤጳ ዋያ ስንና ቦርአ ቴትቤሲሶን ሀእሱ ሆፕሴፋቴነ ኤጶቶዋ። <verse eid="1CO 7:9"/><verse number="10" style="v" sid="1CO 7:10"/>ኤጳ ባሶክ ደይ እማና አጃጂስ ሀንስዋ፤ ኤስ አጃጂስ ደይ ዳሚሳርታኖ ታርታዋ፤ ግሪ አስሱ ቴጎባሳታን ኦር ኬሳናታዋ። <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>ኦር ኬስፋናነ ግሩኖይናማቶ ቴትባክ ባክ ዱን ወደይ ቴጎባስኔን አነ ጋኖን፤ ኤሲስማቶ ቴጎ አሱባሶን ኮፍኩናታዋ። <verse eid="1CO 7:11"/><verse number="12" style="v" sid="1CO 7:12"/>ስኑንታኖ ኦምኒ ሜያክ ዳሚስ ስኖይናሮን ታ፤ ቴትናሲክ ይፋናስ ኤካዋ፤ እሳ ክርስታና ስንና አስሱ ክርስታና ስኖይ አሱባ ፋፋናነናዋ ባርኔን አነ ፎናክ ሾሌፋናነና ጋፍኩናታዋ። <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>ክርስታና ስና ማሽካሱ ክርስታና ስኖይ ቴጎባይ ፌፋናነናዋ ባር ባርኔን አነ ፎናክ ሾሌፋናነና ባሮን ኮፍኩናታ። <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>ክርስታና ስኖይ ቴጎስ ክርስታና ስና አሱባሲ ቦርአ ሀኦኒ አስሱ ስንናናዋ፤ ክርስታና ስኖይ አሱስ ደይ ክርስታና ስና ቴጎባይሳ ቦርአ ሀኦኒ አስሱ ስንናናዋ፤ ኤካ ስና ሻካናነ ንቶ ናንጎታስ ሀኦኒ ናንጎታ ስናናክ ኣፋ ችማናዉዛ። ስኑንታኖ ኤስ ባርክ ፋሴፋትነ ናንጎትኒትስ ሀኦኒ ናንጎታዋ። <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>ክርስታና ስኖይ ባር ኦር ኬሳናክ ሾሌፋናነ ኦር ኬሶዋ፤ ስኑንታኖ ኤስ ባርኪ ክርስታና ስንና ቴጎስ ስኖ ክርስታና ስንና አሱስ ኣፋ ቾዋክኑ ግድክ ኣፋ ኦድቶና ዉዛ። ሀኦሲ እኖትን ቴጌናስ ናጋክ ፎኒክዋ። <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>ነ፤ ክርስታና ማሽካሱሴ፤ ክርስታና ስኖይ ቴጎኔስን አዉዛክነ ፉኦታቶ አዉ አሪፋስሴ? ነ፤ ክርስታና ስና ኣርቃሱሶ! ክርስታና ስንኖይ አሱኔሶን አዉዛክነ ፉኦታቶ አዉ አሪፋስሶ? <verse eid="1CO 7:16"/><verse number="17" style="v" sid="1CO 7:17"/>እሳ እሳርባሲክ ዳሚስ ባርክ እምና እማሲክናዋ ሀኦስ ባሪን ቴጌና ካባሲክ ፌና ፎሲክና ፎዎዋ። ቤቴክርስታኒሲክቶክ እምና ቱማስ ኤሲስዋ። <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>ኦኑ ሃርኮ ኩናኔን ኦርፎ ቴግቴር ስንፋናነ ሃርኮ ኩኖይነ ፌር ስንነ ሳፋሮናታዋ። ሃርኮ ኩኖይ ቴግቴር ስንፋናነ ሃርኮ ኩናናክ ሾሎናታዋ። <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>ሃርኮኒ ኩና ስኑን ኩኑ ቤያ ዋግባ ኣፋዋ። አርክ ዉዛስ ሀኦሲ አጃጅኖን ኦዳስዋ። <verse eid="1CO 7:19"/><verse number="20" style="v" sid="1CO 7:20"/>ኤስ ባሪ ቦርኣ አስሱ እሳ እሳርባሲክ ሀኦሲ ባሪን ቴጌና ካባሲክ ፌናማቶ ችምሜ ፎዎዋ። <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>ሀኦስ ኔን ቴጌና ካባሲክ ቦዝ ስንና ፋታሮሶ? ስንፋታነዎ ግድባ ኣፋዋ ራካቶታታዋ። ስኑንታኖ ብርማዱምማ ኬስኒ እጣ ዳንፋታነ ኤስ እጣስ ነይስታን ኣታናታዋ። <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>ቦዝ ስንነ ፌን ዳሚሲክ ቴግቴ አሱስ ዳሚሲክ ብርማዱምማ ዳኒዋ። ኤሲስማቶ ደይ ብርማዱምማ ኬሴ ፌን ቴግቴ አሱስ ክርስቶስኒ ቦዝዋ። <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>ዋጋክ ዋግቴት ቦርአ አሱኒ ቦዝ ስንናትታዋ። <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>ኤስ ባሪ ቦርኣ አይታሳክቶኖ! አስሱ እሳ እሳርባሲክ ቴግቴፌና ካባሲክ ፌና ፎስማቶ ሀኦሴን አነ ዛግሬ ፎዎዋ።<verse eid="1CO 7:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>ግሩኖይ ወደይ ኤጵኖይ ዲሴ ባሶ ቾዋሲክ ዳሚስኪን ኤጵና አጃጅ ኣፋዋ። ስኑንታኖ ዳሚሳ ፋክያክ አማናምቶ አስሱ ስንናማቶ ታ፤ ኪቶሶን እማናዋ። <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>ሀሽቲ ፋኒ ዎናስ ራኮኒ ዎና ስንና ቦርአ አስሱ ኤጵኖይ ወደይ ግሩኖይ ባክ ፎባስ ማአሪነ ፋርዋ። <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>ስንፋናክኑ አስሱ ኤጲት ስንፋታነ ጋፍኩክ ሾሎታታዋ፤ አስሱ ኣነ ኤጴ ስንፋታነ ኤጳክ ሽሎታታዋ። <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>ስኑንታኖ ነ፤ አስሱ ኤጳታነ ቦርአ ስኒርዋ ኡታዋ። ኤሲስማቶ እሳ ዱርባ ናዋ ግሪፋናነ ቦርአ ስኒርዋ ኡታዋ። ስኑንታኖ አስሱ ኤጵፌ ባሶ ሀን ዳስታኪ ሾዎ ፎኒ ራክኮ ባሶትን ኤጳርዋ። ታ፤ ሳፋራስ ደይ ኤስ ራኮስን ፉእቶትክዋ። <verse eid="1CO 7:28"/><verse number="29" style="v" sid="1CO 7:29"/>አይኒ ሜያነ! ታ፤ ንቶክ ማኮናስ ሀንስዋ፤ ዎናስ ካዉኒዋ፤ ሀንኔን ኤካሎክ አሱባ ፌና ባር አሱባ ፎንቶኒማቶ ስንነ ፎዎዋ። <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>ዋስሴፌ ባሶ ዋሱኖይ ባሶይሲማቶ ስኖቶዋ፤ ግርሴፌ ባሶ ግሮሶኖይ ባሶነ ፌር ስንነ ፎሶቶዋ። ኮዳ ዋግሴፌ ባሶ እሳ ኮዳቤሲ ፎንቶ ዛግሬ ፋዱሶቶዋ። <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>ሀን ዳስታኪ ባሶክ ኬእፋ ዉዛሶን ባሶክ ኬእኖር ዛግሬ ፋዱሶቶዋ። ሀሽቲ ፋ ሀን ዳስታኪ ዉዛስ ኣታርዋ። <verse eid="1CO 7:31"/><verse number="32" style="v" sid="1CO 7:32"/>ኤስ ባሪ ቦርኣ እሳ ሳፋራክኑ ራካቶኖይ ፎሶትክ ሾሌፋዉጙዋ። አስሱ ኤጵኖይ ባር ዳሚስን ግርሱና ዉዛቱ ሾሌፌ ስንና ቦርአ ሳፋራባሶን ዳሚሲክ ሾልሱ ዎስቶታቱ ፌሽፌዋ። <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>ስኑንታኖ አስሱ ኤጳ ባር አሱባሶን ግርሱክ ሀን ዳስታክ ፋ ዉዛሶንቱ ሳፋሬፌ። <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>ኤስ ባርክ ሳፋራባስ ሄፕክ ባግቴዋ ኡዋ። ኤሲስማቶ ግሩኖይ ማሽካሱስ ወደይ ዱርባ ናዋ አሽባሲክናዋ ካባሲክና ኮርቴራ ዳሚሳር ስንናክ ሾሌፋና ቦርአ ሳፋራባሶን ዳሚሲክ ሾልሱ ዎስቶስታቱ ፌሽፋዋ። ስኑንታኖ ግሪራ ድ ማሽካሱስ ቴጎባስን ግርሱናክ ሾሌፋና ቦርአ ሳፋሬፋና ሳፋራስ ሀን ዳስታኪ ዉዛሶጝዋ። <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>ታ፤ ንቶክ ሀን ባሮን ማኬፋናስ ብርማዱምማንትሶን ካላክ ስኖይናሮን ንቶክ ኬአናዋ ኡክዋ። ታ፤ ሳፋራናስ ደይ ንቶ ማአ ፎ ፎትክናዋ ሳፋራንቲስ ባግቶኖይናሮን ቱማ ንባክ ዳሚሲክ ዎስቶትክናዋ። <verse eid="1CO 7:35"/><verse number="36" style="v" sid="1CO 7:36"/>እሳ አስሱ ቴጌሬ ዱስና ዱርባ ናዋሶን ኤጳ ቤያናክ ቡግናኔን ኦርፎ ኤስ ባሮን ዛጉባስ ናዋሲክ ማአሮን ኣነ ዛጉዌ ስንባሶን ሳፋሬፋናነ ባሮን ኤጳናክ ፋ ሳፋራባስ ዛጋ ስንፋናነ ባሶ ኤጵነ ግሩነ ዛጉስ ማአሪ ስንና ባሪክ ቤስቴፋናነ ኤስ ሾሌናሲማቶ ኤጳናነ ቦርአ ኣፍ ስንናናዉዛ፤ ኤጶዋ። <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>ስኑንታኖ እሳ አስሱ ንብባሲ ዛግፋናነ ግድሱኒ ዉዛ ትሽፋናነ ባር ሾሌና ባሮን ዬቱክ ችምፋናነናዋ ቴጌና ናዋሶን ኤጳ ቤያናክ ቡግፋናነና ማአሮንቱ ዛግ። <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>ኤስ ባሪ ቦርኣ አስሱ ኤጳ ባር ማአሮንቱ ዛግ፤ ስኑንታኖ ኤጵኖይ ባር ደይ አካማኖን ማአሮንቱ ዛግ። <verse eid="1CO 7:38"/><verse number="39" style="v" sid="1CO 7:39"/>ግሪራ ድ አሱስ ቴጎባስ ካክ ፌናኔን ኤጵነ ግሩነ አሲ ቱማሲክ ታቴራ ፋርዋ። ስኑንታኖ ቴጎባስ ክትፋናነ ኦርፎ ባር ሾሌና አሱኒኪ ግሩናክ ብርማዱማባ ፋርዋ፤ ስንፋናክኑ ግሩና አሱስ ክርስታና ስናናክ ሾልሱዋ። <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>ስኑንታኖ ታ፤ ሳፋራሲክ ግሩኖይ ባክ ዲፋናነቱ አሪክሮን ግሬራ ፎናዋ። ሀኦሲ አያና ታይሲ ፋርነ ፋር ስንናቱ ታክ ቤስቴፋዋ።<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">ኮሎክ ሹክቴ አሻ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>ኮሎክ ሹክቴ አሽኒ ቾዋሲክ ስንፋናነ ፉቶሲክ ዙታምኒሴ አሩኒ ፋርዋ፤ አሩስ ጌእስር፤ ስኑንታኖ ኬሽታናስ ችኒር። <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>«አሩና ፋርዋ» ይት ሳፋሬፌ አስሱ ፌፋናነ አሩናክ ሾልስንናስንነ ፋሮን ሀሽኑ ኣነ አሩዌዋ። <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>ስኑንታኖ ሀኦሶን ሹንፌ አሱስ ሀኦሲ ስንናክ አርቶ ስንናናዋ። <verse eid="1CO 8:3"/><verse number="4" style="v" sid="1CO 8:4"/>ኤስ ባሪ ቦርኣ ኮሎክ ሹክቴ አሻሶን ሙኒ ቾዋሲክ ስንፋናነ ኮሎስ ቴትባሲክ ካባ ፎንቶ ስንናማቶናዋ እሳ ሀኦስታኖ ኦማ ሀኦ ኣፋ ስንናማቶ አሪፌኒዋ። <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>አዉኑ ስንፋናክ ሀኦ ስኖይ ሀኦ ይስቴራ ቴግቴፋ ሾዎ ሀኦነዋ ሾዎ ዳምኒ ሜና ደን ሳማክ ስኑን ሀን ዳስታክ ፌሴቴር ይስቴፋዋ። <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ስኑንታኖ ዙታምባሴ አሲን ቴሲስ እሳ አባ ሀኦ ኮእባ እኖክ ፋርዋ፤ እንኖ ደይ ባሪር ስንኒዋ። ኤሲስማቶ ዙታምባሴ ባርኪ ካሞ ቴስቴናማቶናዋ እንኖ ደይ ባርክ ፋፌኒ እሳ ዳም የሱስ ክርስቶስ ኮእባዋ። <verse eid="1CO 8:6"/><verse number="7" style="v" sid="1CO 8:7"/>ስኑንታኖ ኤስ ባሮን አርሴፌስ አሱኒ ሜያ ዙታምባሴቴዋ፤ እሳ እሳይስ ሀሽኑ ኮሎኒ ሺጶ ዶስቴሴቴ ቦርአ አሻሶን ሜሴፌስ ኮሎ ሹክቴር ዛግሬዋ። ኤስ ባሪ ቦርኣ ካኑቤሲስ ሆፕያ ስንና ቦርአ ኪነፌዋ። <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>ኤሴ ሀኦስኪ ታእሱኒስ ሙስታዋ፤ ሙቤይፌኒክ እኖክ ዮኡኒ ዉዝኒ ኣፋዋ፤ ማፌኒክ ቡእሱኒ ዉዛኒ ኣፋዋ። <verse eid="1CO 8:8"/><verse number="9" style="v" sid="1CO 8:9"/>ስንፋናክኑ ሀን ብርማዱምማንቲስ አማንቶክ ዛጉኖይ አሱኒ ሜያክ ቱሳ ስኖይናማቶ ቴትንትሶን ኦድትዋ። <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>«አሩና ፋርዋ» እያት ኮሎክ ሹክቴ ባሮን ኮሎ ሺጵቴፋና ድማስታ ማፌን አማንቶባሲክ ዛጉኖይ አስሱ ኔን ቢፋናነ ኤስ ዎስቴታ ዎስቶኔስ አሱስ ኮሎክ ሹክቴ አሻሶን ሙናክ ዛግታርታኖሶ? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>ኤስ ባሪ ቦርኣ ነ፦ «ታ፤ አሩዋ» ኡኔሲክ ክርስቶስ ክትና ባሪንናዋ አማንቶባሲክ ዛጉኖይ ክርስታናስንና ትሽክርዋ ኡዋ። <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>ኤሲሲክ ክርስታና አይንትሳክቶኒን ሚርእኦክናዋ ሆፕያ ካኑቤሲሶን ማዛሱክና ክርስቶስኒን ሚርእኤፌትዋ። <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>ኤስ ባሪ ቦርኣ ሙስ ክርስታና አይታስን ቱሳእሱኒር ስንፋናነ አይታስን ቱሳእሱናስኔን እሳንነ አሻ ኣፋዋ ሙና ዉዛ።<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">ዎሲ ስንና አሱኒ ማብት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>ታ፤ ብርማዱምማና ፋና አሱቴኖሶ? ታ፤ ዎስቴኖሶ? ዳምኒ የሱስኒን ኣነ ብዩቶሶ? ዳሚስኪ ካሞ ሆፕናሲ ጋና ንቶቴኖሶ? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>ዳሚሲክ ታ፤ ዎሲ ስንናሶን ቤስፋ ማታም ንቶ ስንነት ቦርአ ኦምን ሜያክ ዎሲ ስና ቤይፋናክኑ ንቶክ ፉቶሲክ ታ፤ ዎሲዋ። <verse eid="1CO 9:2"/><verse number="3" style="v" sid="1CO 9:3"/>«ዎሲ ስንኒ ማብትነ ኣፋዋ» ይሬ ታን ፋፌሲድፌር ፌሴፋቴነ ማኮና ዎልጉስ ሀንኒስዋ፤ <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>ኤካን እንኖ ሙንክናዋ ኡሻኒክና ማብትኒ ኣፋኖሶ? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>ኦማ ዎስኒ ሜኒማቶናዋ ዳሚሳ አይኒ ሜኒማቶና ደይ ኬፋኒሲማቶ አማነ አስሱ ዞንስሬ ኩቱክ ማብትኒ ኣፋኖሶ? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>ወደይ ዎስቶኒ ዎስቶክ ካቤት ፎ ሾልሲናስ ባርናባስኒክናዋ ታክና ኮእባኖሶ? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>ዳሞዛባ ፎንቶኖን ቴትባሪ ዋጋክ ሜያ ታርኦ ስንነ ዎስቶኒር ኦንሶ? ዋይኒ ቶኬ ጋንባሶን ሙኖር ኦንሶ? ምያ ኬምፌጌዶ ሚባሲ ሻቦኖን ኡሽኖር ኦንሶ? <verse eid="1CO 9:7"/><verse number="8" style="v" sid="1CO 9:8"/>ሀን ባሮን ማኬፋናስ አሱኒ ሳፋራኒማቶኖሶ? ቱማስ ደይ ኤካ ኣነ ማኬፋኖሶ? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>«ሜያሶን እችፋ ጋቹዋሲ ኖኖኖን ታርአታታዋ» ይስቴራ ሙሴኒ ቱማስሲ ትቼዋ፤ ኤካን ሀኦስ ኤስ ባሮን ይናስ ጋቹዋሲክቶክ ሳፋሬፋትኖሶ? <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>ሀኦስ ኤስ ባሮን ይናስ እኖክ ሳፋሬና ቦርአታኖሶ? ቡለፌ ቡልኝኛሲ አብድክ ቡሎናክ ሜያሶን እችፌ ባር አብድክ እቻናክ፤ ዙታምባሴ ሃኦባሶን ዳናናክ ኤስ ትቼ ባር ፉቶሲክ እንኖ ቦርአዋ። <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>እንኖ ንቶስሲ ሀኦሲ ቾዋኖን ቡካት ንቶ አሽኒ ኤባሶን ካርአንነ አካማ ዉዛ ስንባኖሶ? <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>ኦምኒ ሜያ ሀን ዉዛሶን ንቶኪን ሃኦሶንነ ማብትቤስ ፋር ስንናኔን ኤካን እንኖ ኣካክ ኤስ ባሪስታን ደናሎ ማብትኒ ፎ ቤይኒሪን? ስኑንታኖ እንኖ ሀን ማብትሶን ኣነ ኤጳ ኬኤኒዋ። ኤስ ባሮን ዛግኒስ ደይ ክርስቶስኒ ምስራቹኒ ካማሲ ታግት ሀማስታን የሮኖይናማቶ ሳፋሮክ ዙታምባሴ አስን ፋክራ ችማኒ ኡክዋ። <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>ቤቴሜቅደሲሲ ዎስቴሴፌ ባሶ ሙቤሲሶን ቤቴሜቅደሲሲን ዳነሴፌማቶናዋ ሾኣስታ ማአ እሜፌ ባሶ ደይ ኤስ ማኣስታን ሃእኤሬ ሜሴፌማቶና ንቶ አሪቲርታኖሶ? <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>ኤሲስማቶ ደይ ምስራቹኒ ካማሶን ማክሴፌ ባሶ ሙቤሲሶን ኤስ ዎስቴሴፌ ዎስቶስን ዳኖነማቶ ዳሚስ አጃጀዋ። <verse eid="1CO 9:14"/><verse number="15" style="v" sid="1CO 9:15"/>ስኑንታኖ ታ፤ ኤስ ማብትሲክቶስን እሳሮንኑ ኣነ ኤጳቶትዋ። ሀን ባሮን ትችናስ ኤስ ማብትናስ አዉኒሮን ዛግቶኖይ ፉእቴሶ ኡክታዋ። አስሱ ታ፤ ቴቴና ቴቶናሶን ሽማ ዛጉባስታን ክትፋናነ ታክ ዋያዋ። <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>ምስራቹኒ ካማሶን ማኮናሲክ ኣፋ ቴቶና ዉዛ፤ ማኬፋናስ ግድ ስንና ቦርአዋ። ምስራቹኒ ካማሶን ማኮ ቤይፋናነ ሀይቡታጝዋ። <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>ምስራቹኒ ካማሶን አስሱ ታን ግድሱኖይናሮን ሹናክ ማኬፋናነ ሆፕናስ ዋግባ ፎናዋ። ስኑንታኖ ግድክ ዛግፋናነ ታክ እምቴ አዳራሶንቱ ኮእስንታኖ ኦማ ዛግና ዉዛ ፋር ኡታዋ። <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>ኤካን፥ ሆፕናሲ ዋጋ ኣምባንሶ? ኤሴ ሆፕናሲ ዋጋ ምስራቹኒ ካማሶን ማኮናሲክ ታክ ፋ ማብትናሶን ቤይፋት ምስራቹኒ ካማሲ ማኮኒ ዎስቶናሲክ ካስቶኒ ዋጋ ፎንቶኖን ባክ ማኮናስዋ።<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>ታ፤ ኦኒክንኑ ቦዝ ስኖይ ብርማዱምማ ኬሴ ፌ አሱዋ፤ ስኑንታኖ ታክ ችምቴናይሲማቶ ሾዎኒ ሜያኖን ዎልጉክዋ እያት ዙታምቤሲሴ አሲ ቦዝ ስንጝዋ። <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>አይሁድኒ ሜያኔን ስንፋና ካባሲክ አይሁድኒ ሜያኖን ፉኦናክዋ ኢያት አይሁድ ስኒንዋ፤ ታ፤ ቱማሲ ዳካሎ ስና ቤይፋናክኑ ቱማሲ ዳካሎ ፌሴ ባሶትን ፉኦናክዋ እያት ቱማሲ ዳካሎ ፌሴ አሱኒ ሜኒማቶ ስኒንጝዋ። <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>ታ፤ ቴትናሲክ ሀኦሲ ቱማ ፌናርናዋ ክርስቶስኒ ቱማሲ ስካሎሲ ፌ አስሱ ስንፋናክኑ ቱማቤሲ ፎንቶ አዛብኒ ሜያኖን ፉኦክዋ እያት ቱማባ ፎንቶ አሱኒማቶ ስኒንዋ። <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>አማንቶክ ሆፕ ስና ባሶትን ፉኦክዋ እያት ሆፕኒ ሜያነ ፌር ስኒንጝዋ። ታክ ችምቴናስነ ፋሮን እሳ እሳይስን ፉኦክዋ እያት ዙታምቤሲሴኔን አነ ዙታምባሴ አሲን ስኒንዋ። <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>ኤስ ባሮን ዙትራ ኤካ ዛግናስ ምስራቹኒ ካማሲ ኤባኖን ሃአክ ምስራቹኒ ካማሲክዋ እያትዋ። <verse eid="1CO 9:23"/><verse number="24" style="v" sid="1CO 9:24"/>ኣቶ ኣቶኒ ኤላሶን ዙታምቤሲሴ ኤለፌሲማቶናዋ ኤስ ኤልላ ባሶስን እሳ ባር ባር ዎሱማሶን ኤጴቴፌናማቶና አሪቲርታኖሶ? ኤስ ባሪ ቦርኣ ንቶ ደይ ዎሱማሶን ኤጴቶክ ኤልትዋ። <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>ሃቶ ሃቶኒ ኤላክ ሆሬሴፌ ባሶ ዙቴሬ አካማኖን ፋያ ሌጅቱ ኤጴፌዋ፤ ባሶ ኤካ ሆፕሴፌስ ትሹኒ ኡልፍናኒ ዎሱማሶን ዳኖሶነክዋ። ስኑንታኖ እንኖ ሆፕፌኒስ ትሹኖይ ኮእባ ፎንቶኖን ፎኒ ኡልፍንኒ ዎሱማሶን ዳናኒክዋ። <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>ኤስ ባሪ ቦርኣ ታ፤ ሀምሜ ካርአና ድማሶን አሩኖይ አሱኒማቶ ሽማኖን ኣፋ ኤላና ዉዛ። ስሩሶን ጉምሜ ክእፌ አሱኒማቶ ባክ ኣፋ ካቦና ዉዛ። <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>ኤስ ባሪ ቦርኣ ኦምኒ ሜያኖን ኣቶ ኣቶስሲ ቴጌናኔን ኦርፎ ታ፤ ቴትናሲክ ሀእቴር ስኖይናማቶ አቱናሶን ኬእራ ታክ አጃጃሞናክ ዛጉናዋ።<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">ኮእሎሶን ሺጶ ኣነ ሾልስፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>አይታሳክቶኖ! አባኒሳክቶ ሻሩስ ዳካሎ ዞኑስቴሴቴማቶናዋ ዙታምቤሲሴ ሸአ ባሪሶን ፍነቴይሲማቶና ንቶትን ያዳሱናክ ሾሌፋዉጙዋ። <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>ሙሴኔን አነ እሳር ስንናክ ኤስ ሻሩስናዋ ባሪስና ሀጱቅቴሴቴ። <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>ዙታምቤሲሴ እሳ ቴሳ አያናኒ ሙሶን ሜሴቴ። <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>ዙታምቤሲሴ እሳ ቴሳ አያናኒ ኡሻሶን ኡሸቴ። ኡሸቴስ ደይ ባሶትን ቱስቴት ፋ አያናኒ ካኦስን ኬሳ ባሮንጝዋ፤ ኤስ ካኦስ ደይ ክርስቶስዋ። <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>ስንፋናክኑ ሀኦስ ሾዎኒ ሜያክ ኣነ ግሮዋ፤ ኤስ ባሪ ቦርኣ ዱግኖቤሲስ ዛቦሲ ሀእቴራ ፉእቴ። <verse eid="1CO 10:5"/><verse number="6" style="v" sid="1CO 10:6"/>ባሶ ማጙ ዉዛ ኤናንቴሴቴስማቶ እንኖ ደይ ማጙ ዉዛሶን ኤናንቶኖይንማቶ ሀን ባር ዙታምባሴ እኖክ ቴትንትሶን ኦድት ኡኒ ቤሶ ስኒዋ። <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>«አሱኒ ሜያ ሙሶነክናዋ ኡሾነክና ዲሴቴ፤ ልክኔን ደናሎ ኡሸሼ ሱርሬ ቤጨቆክ ካብሴቴ» ይስቴራ ባሶ ቾዋሲክ ትቼናስማቶ ባሶ ኮእሎክ ሺጵሴቴስማቶ ንቶ ደይ ኮልሎ ሺጶትታዋ። <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>ባሶስን እሳ እሳ ሜያ ጌርኬሴሬ ቦርአ ዎስቴሴቴስማቶ እንኖ ደይ ጌርኬስን ቦርአ ዎስቶኒታዋ። ባሶ ኤስ ባሮን ዛግሶቤሲሲክ ባሶስን እሳ ዎናሲ ሄፓስሬ ኬዜ ኩም አሱኒ ሜያ ክትሴቴዋ። <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>ባሶስን እሳ እሳይስ ዳሚስን ፋታነሴቴይሲማቶናዋ ዛዋክ ዱፕቴሬ ክትሴቴማቶና እንኖ ደይ ክርስቶስኒን ፋታኖኒታዋ። <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>[ባሶስን እሳ እሳይስ ኡኚሴቴ ቦርአ ቤቶ ኤጳ ያ ሀኦሲ ዎሲያክ ትሽሴቴማቶ ንቶ ደይ ኡኙትታዋ] <verse eid="1CO 10:10"/><verse number="11" style="v" sid="1CO 10:11"/>ኤስ ባር ዙቴራ ባሶስታ ካርእናስ እኖክ ቴትንትሶን ኦድት ኡኒ ቤሶ ስናናክዋ። ትቼናስ ደይ ነያሲ ኮእታ ፌ እኖትን ኬኡክዋ። <verse eid="1CO 10:11"/><verse number="12" style="v" sid="1CO 10:12"/>ኤስ ባሪ ቦርኣ የሬርነ ፌር ስንነ ቤስቴፌ ባር ጋንዶኖይናማቶ ቴትባሶን ኦዶዋ። <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>አሱኒስታ ካርፋ ፋታናስታኖ ኦማ ፋታና ኣነ ንቶስታ ካርአዋ፤ ሀኦስ አማናምቶዋ፤ ኤስ ባሪ ቦርኣ ንቶ ግዶስታን ደናሎ ስና ፋታና ንቶስታ ካርአናክ ኣፋ ፋቃዶናውዛ። ፋታንቴፌት ካባሲክ ደይ ፋኩት ሁግና ንቶክ እምማ ፋታናስን ኬሳት ኡግና ንቶክ ሆሱናዋ። <verse eid="1CO 10:13"/><verse number="14" style="v" sid="1CO 10:14"/>ኤሴ ኮንታሳክቶኖ! ኮእሎሶን ሺጶስታን ዎክትዋ። <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>ሀን ባሮን ደይ ንቶክ ማኬፋናስ ያዳትኒት ፌናር ስነት ቦርአዋ። ኤስ ባሪ ቦርኣ ታ፤ ማኬፋና ባሮን ንቶ ማጝሱ ካርእትዋ። <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>እንኖ ሀኦሶን ጋላቶክ ሃኤፌኒ ኤባን ቶፎስ ክርስቶስኒ ሀንናስኔን አነ እሳርባ ፋርታኖሶ? ባቴራ ሃኦኒ ክጣስ ደይ ክርስቶስኒ አሻስኔን አነ እሳርባ ፋርታኖሶ? <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>ክጣስ እሳር ስንባሲክ እንኖ ደይ ሀን እሳ ክጣሶን ሃኦኒር ስንናኔን አዉነ ፋሮን ሾዎ ስንፌኒክኑ እንኖ እሳ አቱዋ። <verse eid="1CO 10:17"/><verse number="18" style="v" sid="1CO 10:18"/>ኤሴ እስራኤልኒ ዳራስ ዛግና ባሮን ቢትዋ፤ እምቴፋ ማኣሶን ሜሴፌ ባሶ ሾአሲኔን አነ እሳርቤስ ኣፋኖሶ? <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>ኤካን፤ ኤስ ባሮን ይፌኒስ ኮእሎሲክ ሹክቴ አሻስ ዋግባ ፋር ኡናኖሶ? ወደይ ኮእሎስ ቴትባሲክ ዋግባ ፋና ዉዛዋ ኡናኖሶ? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>እንዳነዋ! አዛብኒ ሜያ ማአ እሜፌስ ሀኦሲክ ስኖይናሮን ክታሲክዋ። ኤስ ባሪ ቦርኣ ንቶ ክታስኔን አነ እሳርኒት ፎናክ ኣነ ሾሌፋትዋ። <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>ዳሚሳ ቶፎስን ኡሽፋት ደይ ክታሲ ቶፎስን ኡሻትክ ኣፋ ችማት ዉዛ። ዳሚሳ ማድታን ሃኤር ስንፋት ክታሲ ማድታን ሃኤር ስናትክ ኣነ ሾልስፋዋ። <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>ኤካን ኤስ ባሮን ዛጉኒሲክ ዳሚስ ኮኖናክ ዛጉንሮሶ? እንኖ ባሳስታን ደናሎኖን ችም ስናኒሮሶ?<verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>ዙታምባሴ ፋቃድቴዋ፤ ስኑንታኖ ዙታምባሴ ኣፋ ኬአናዉዛ፤ ዙታምባሴ ፋቃድቴዋ ስኑንታኖ ዙታምባሴ ኣነ ኬፋዋ። <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>አስሱ እሳ እሳርባስ ኦምሲክኔን ኬእኒ ዉዛ ሳፋሮዎቴኖ ባር ባሪክ ኬእኒሶን ኮእባ ሾሎናታዋ። <verse eid="1CO 10:24"/><verse number="25" style="v" sid="1CO 10:25"/>ካኑንትስሲ ሳፋሮ ሻካት ጋባስታ ዋግቴፋ ኣፋ አሻሶን ላጰባቶኖይ ሙትዋ። <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>ዳሴዋ ባሪስታ ፋ ባሬ ዙቴራ ዳሚሳርዋ። <verse eid="1CO 10:26"/><verse number="27" style="v" sid="1CO 10:27"/>አማኖኖይ አስሱ ሙ ንቶትን ማሱናክ ቴጌፋናነ ሀማትክ ደይ ሾሌፋትነ ቴሸና ሙሶን ካኑንትስሲ ሳፋሮ ሻካት ላጰባቶኖይ ሙትዋ። <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>ስኑንታኖ እሳ አስሱ፦ «ሀን አሻስ ኮእሎክ ሹክቴ አሻዋ» እያናነ ኤስ ባሮን ማኬ አሱሳ ቦርአናዋ ካኑንትሲ ቦርአና አሻሶን ሙትታ። <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>ካኑ ይፋናስ አሱሳ ካኑኖን ኡናታኖ ንቶ ካኑሶን ኡናታዋ። ኤካን ኦም አሱሳ ካኑኒ ቦርአ ታ፤ ብርማዱምማስታ ማጝሱ ካርአናስ አዉኒ ቦርአንሶ? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>ታ፤ ሀኦሶን ጋላቴት ሙ ማፋናነ ሀኦሶን ጋላቴና ዉዛሲክ አዉኒ ቦርአ ዋቃስቶናስሶ? <verse eid="1CO 10:30"/><verse number="31" style="v" sid="1CO 10:31"/>ኤሴ ማፌት ባርክ ስኑን ኡሽፌት ባርክ ወደይ ኣፍፋ ዉዛሶንኑ ዛግፌት ካባሲክ ዙታምባሴ አሲን ሀኦሲ ኡልፍናክ ዛጉትዋ። <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>አይሁድኒ ሜያኖን ስኑን አዛብኒ ሜያኖን ስኑን ሀኦሲ ቤቴክርስታንኖን ስኑን ቱሳእሱትታዋ። <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>ታ፤ ዙታምቤሲሴ ፉእቶሶነክ ደይ ኦምኒ ሜያክ ኬእኒሶንታኖ ታክ ኬእኒ ባሮን ኮእባ ሾሎኖይ አሱኒክ ዙትራ ዛግፋና ዉዛ ዙታምባሴ አሲክ ግርሲፋናስማቶ ንቶ ደይ ኤሲስማቶ ዛጉት።<verse eid="1CO 10:33"/></para>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>ታ፤ ክርስቶስኒ ቤሶሲክ ዞኑስቴናማቶ ንቶ ደይ ታ፤ ቤሶሲክ ዞኑስቶት።<verse eid="1CO 11:1"/></para>
  <para style="s1">ሀኦኒ ሺጶኒ ስትሪ</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>ዙታምባሴ አሲክ ታን ያዳቴፌት ቦርአናዋ ታ፤ ንቶክ አሲና አሱሶን ማእስራ ኤጵት ቦርአና ንቶትን ጋላቴፋዉጙዋ። <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>ስኑንታኖ ኣርቃሱ ዙታምባሴ አሲ ቴት ክርስቶስዋ፤ ማሽካሱሲ ቴት ደይ ኣርቃሱ፤ ክርስቶስኒ ቴት ደይ አባ ሀኦስ ስንባሶን አሩትክ ሾሌፋንዋ። <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>ቴትባሶን ጉፌሬ ሀኦ ሺጴፌ ወደይ ራጅኒ ካማ ማኬፌ ኣርቃሱ ዙታምባሴ ቴትባሶንቱ ሳልጲስፌዋ። <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>ኤሲስማቶ ደይ ቴትባሶን ጉፎኖይ ሀኦ ሺጴፋ ማሽካአሱስ ወደይ ራጅኒ ካማ ማኬፋ ባር ባር ደይ ቴታሶንቱ ሳልጲስፋዋ። ቴትባሶን ጉፎኖይ ማሽካሱስ ሶምባሶን ፊቴናሪማቶቱ ፋድቴፋዋ። <verse eid="1CO 11:5"/><verse number="6" style="v" sid="1CO 11:6"/>ማሽካ አስሱ ቴትባሶን ጉፎ ሻካናነ ሶምባሶን ካቶጝዋ። ስኑንታኖ ሶምባሶን ካቶ ወደይ ፊቶ ባሮን ሳልጲሱኒ ዉዛ ስንፋናነ ቴትባሶን ጉፎጝዋ። <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>ኣርቃሱ ቴትባሶን ጉፎናክ ኣነ ሾልስፋዋ፤ ኣርቃሱ ሀኦሲ ቤሶነዋ ሀኦሲ ኡልፍንነዋ። ስኑንታኖ ማሽካሱስ ኣርቃሱሳ ኡልፍናዋ። <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>ማሽካሱስ ኣርቃአሱኒኪንቱ ቤስቴታኖ ኣርቃሱ ማሽካሱንኪን ኣነ ቤስቶዌዋ። <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>ኤሲስማቶ ማሽካሱስ ኣርቃሱሲክቱ ቴስቴታኖ ኣርቃሱ ማሽካሱሲክ ኣነ ቴስቶየዋ። <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>ኤስ ባሪ ቦርኣናዋ ሀኦኒ ዎሲያኒ ቦርአና ማሽካሱስ ሀእሱኒ ሁግናኒ ማላቶ ስና ጉፎሶን ቴትባስታ ዱሱንዋ። <verse eid="1CO 11:10"/><verse number="11" style="v" sid="1CO 11:11"/>ዳሚሲክ ፋ ካኒሲክ ማሽካሱስ ኣርቃሱ ፎንቶኖን ኣፋ ፎና ዉዛ፤ ኣርቃሱስ ደይ ማሽካሱ ፎንቶኖን ኣፋ ፎና ዉዛ። <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>ማሽካሱስ ኣርቃሱንኪን ቤስቴናማቶ ኣርቃሱስ ደይ ማሽካርኪንቱ ኮንቴፌዋ። ስኑንታኖ ኣርቃሱ ስኖ ማሽካሱ ደይ ኦማ ዉዛስኑ ዙቴራ ቤስቴፋናስ ሀኦስክጝዋ። <verse eid="1CO 11:12"/><verse number="13" style="v" sid="1CO 11:13"/>ኤሴ ንቶ ቴትንትሲክ ማጝሱ ካርእትዋ፤ ማሽካሱ ቴትባሶን ጉፎኖይ ሀኦኒ ሺጶባስ ሾልሱኖሶ? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>ኣርቃሱ ሶምባሶን ድችፋናነ ሳልጲና ስንናማቶ ቴስቶስ ቴትባሲክ ኣነ አሲፋኖሶ? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>ስኑንታኖ ማሽካሱሲክ ሶማ ድቹናክ እምቴናስ ቴትባሶን ኡካናክ ስንና ቦርአ ሶምባሶን ድችፋናነ ባርክ ኡልፍንባዋ። <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>ሀን ቾዋሲክ ካራካሮናክ ሾሌ አስሱ ፌፋናነ እንኖ ስንፌኒክ ወደይ ኦማ ሀኦሲ ቤቴክርስታኒሲክቶ ስኑን ኤስ ባርስታን ኦማ ዶስቴኒ ዉዝኒ ኣፋዋ።<verse eid="1CO 11:16"/></para>
  <para style="s1">ዳሚሳ ሜታኡ</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማት. 26:26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14:22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>ስኑንታኖ ዙቴፌት ካባሲክ ሚርእአኒትታኖ ማአሪር ስና ቤይና ቦርአ ሀን አጃጂሶን እምፋናስ ጋላቴፋትዋ። <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>ዙታምባሴ አሲስታን ዜምማ እሳ ኩጳማክ ዙቴሴፌት ካባሲክ ንቶ ጋነያሲ ኦር ኦር ኬሳ ፋናማቶ ኦደጝዋ። ኤስ ኦደና ዉዛስን ባግጋ ፉቶ ስንናማቶ አማነፋዉጝዋ። <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>ፉቶ ስና ባሶ ኦ ስንነቴማቶ ኦር ኮርቴሬ አርቶሶነክ ንቶ ጋነያሲ ኦር ኦር ኬሳ ፎባስ ግድዋ። <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>እሳሪክ ኩጲፌት ካባሲክ ማፌትስ ዳሚሳ ሜታኡታዋ። <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>ማፌት ካባሲክ እሳይስ ኦሚስን ኦድኖይ ባር ባር ሜፌዋ፤ ኤስ ባርክ እሳይስ ማክቴፌን ኦሚስ ዛየፌዋ። <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>ሻካፎት ዲራ ሙት ኬነዋ ዲራ ኡሻት ኬነ ቱርኪትዮሶ? ወደይ ሀኦሲ ቤቴክርስታኒኖን ካሽሺትዮሶ? ወደይ እሳ ዉዝቤስ ፎንቶ ቱካምኒ ሜያኖን እችሹትኮሶ? ኤሴ አዉ ንቶክ ኡናሪንሶ? ኤስ ባሪ ቦርኣ ሀን ቾዋሲክ ንቶትን ጋላቶናሮሶ? እሳንነ ኣፋዋ ጋላቶና ዉዛ። <verse eid="1CO 11:22"/><verse number="23" style="v" sid="1CO 11:23"/>ዳሚስኪን ኤጵና ባሮን ንቶክ ኣትራ እምጝዋ። ዳም የሱስ አቴሬ እምቴና ዋላሲክ ክጣሶን ካብግሬ፤ <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>ጋላትኒ ሺጶ ሺጴናኔን ኦርፎ ባትቴ፦ «ሀን ባር ንቶክ ስንኒ አቱናስዋ፤ ኤስ ባሮን ታን ያዳቶኒር ዛግራ ሙትዋ» ይ። <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>ኤሲስማቶ ደይ ሜታኡስኔን ኦርፎ ቶፎሶን ካብግሬ፦ «ሀን ቶፎስ ሀሪንናሲክ ስንኒ ጋድዶ ቴያስዋ፤ ሀን ቶፎስን ኡሽፌት ካባሲክ ኤስ ባሮን ታን ያዳቶኒር ዛግራ ኡሽትዋ» ይ። <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>ሀን ክጣሶን ማፌት ካባሲክናዋ ሀን ቶፎስን ኡሽፌት ካባሲክና ዎንና ዎንና ዳሚስ ዮናኔን ክቱባሶን ማኮትዋ። <verse eid="1CO 11:26"/><verse number="27" style="v" sid="1CO 11:27"/>ኤሴ ኦኑ ሙናክ ሾልሱኖይፌን ዳሚሳ ክጣኖን ሜፋናነናዋ ዳሚሳ ቶፎስን ኡሽፋናነና፤ ዳሚሳ አሽነዋ ሀሪንነ አሲን ሀቴስሲና ቦርአ ማሙስቴርዋ። <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>ኤስ ባሪ ቦርኣ ኣፌ አሱኑ ሀን ክጣሶን ሙባስታንናዋ ሀን ቶፎሲን ኡሽባስታንና ዜምሜ ቴትባሶን ቱኑዎዋ። <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>ኣፌ አሱኑ ዳሚሳ አቱ አዉ ስንናማቶ ማእስሬ አሩኖይ ዳሚሳ ሜታኡኖን ሜፋናነናዋ ዳሚሳ ቶፎስን ኡሽፋናነና ባሳ ቴታስታ ማጝሱኒ ካርአቱ ኤጴ ዮናዋ። <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>ንቶ ጋነያስን ሾዎኒ ሜያ ሆፕሴቴሴዋ ሜቴሴቴሴ ደይ እሳ እሳ ሜያ ክትሴቴስኑ ኤስ ባሪ ቦርኣዋ። <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>እንኖ ቴታስታ ማጝሱ ካርኒ ስንናፋናነ ማጝሱኒ ካርኣሲ ስካሎሲ ጋንዶኒ ካባታዋ። <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>ስኑንታኖ ሀንኔን ሀን ዳስኔን አነ ማጝሱ እኖስታ ካቶኖይናማቶ ሀሽ ዳሚስ ማጝሱ ካርኤ እኖትን ኬእዲፌዋ። <verse eid="1CO 11:32"/><verse number="33" style="v" sid="1CO 11:33"/>ኤስ ባሪ ቦርኣ አይታሳክቶኖ! ዳሚሳ ሜታኡኒ ሙክ ዙቴፌት ካባሲክ ንቶትና ንቶትና ዋል ኦድትዋ። <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>ዙቴፌት ዙቶስ ማጝሱ ንቶስታ ካቶናክ ዛጉኒር ስኖይናሮን ንቶ ጋነያስን ማክቴር ፌፋናነ ኬባሲክ ሀምሜ ሙዎዋ። ፉእቴ ዉዛሲክ ንቶኪ ያና ዎኖ ኦማ ስትሪ ንቶክ እማናዋ።<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">ኮርቶ አያናስ እማንክቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>አይታሳክቶኖ! ሀሽ ደይ ኮርቶ አያናኒ እማሶን አሩትማቶ ሾሌፋዉጙዋ። <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>አማንቶንት ፎንቶ ስንና ፋቲ ካባሲክ አሩኖይት ዉዛሲክ ዞኑስቴራ ዎላ ችምኖይ ኮእሎስኪ ሀሜት ፋትር ስንናማቶ አሪፌት። <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>ኤስ ባሪ ቦርኣ ሀኦኒ አያናክ ዞኑስቴፌት የሱስኒን ኤርዉቶዋ ሁኒር ኦኑ ኣፌዋ። ኤሲስማቶ ኮርቶ አያናክ ስንና ሻካናነ ኦኑ «የሱስ ዳምማዋ» ይፌር ኣፌ ስንናማቶ ታ፤ ንቶክ ማኬፋውጙዋ። <verse eid="1CO 12:3"/><verse number="4" style="v" sid="1CO 12:4"/>ኦም ኦማ ኮርቶ አያናኒ እማ ፋርዋ። ስኑንታኖ ኮርቶ አያናስ እሳርዋ። <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>ኦም ኦማ ሀኦኒ ዎስቶ ፋርዋ፤ ስኑንታኖ ዳሚስ እሳርዋ። <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>ኦማ ኦማ ዎስቶ ፋርዋ፤ ስኑንታኖ ዙታምባሴ አሲን ዙትራ ዛግፋስ እሳ ሀኦስዋ። <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>እሳርባ እሳርባሲክ ኮርቶ አያናሶን አምማኖን ኮቴ ማኮኒ እማ እምፋናስ ዙታምኒሴ አሲክ ኬእአናዋ። <verse eid="1CO 12:7"/><verse number="8" style="v" sid="1CO 12:8"/>ኮርቶ አያናስ እሳይሲክ ቴችማክ ማኮኒ ችማ እማር፤ ኦሚሲክ ደይ ኤስ አያናስ አሩክ ዎሎኒ ችማ እማር። <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>ኤስ እሳ አያናስ እሳይሲክ አማንቶ እማር፤ ኦሚሲክ ደይ ፋቱኒ እማ እማር። <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>ኤሲስማቶ እሳይሲክ ቢስቴራ አሪቶኖይ ዉዛ ዛጉኒ ሁግና እማር፤ ኦሚሲክ ደይ ራጅ ማኮኒ ችማ እማር፤ ኦሚሲክ ደይ ኤስ እማሲክቶ ኮርቶ አያናስኪን ወደይ ኪና አያናስኪን ስንባሶን ኮሪሬ አሩኒ ችማ እማር፤ ኤሲስማቶ ደይ እሳይሲክ ኦማ ኦማ ኖኖክ ዎሎኒ ችማ እማር፤ ኦሚሲክ ደይ ኦማ ኦማ ኖኖክ ዎሉምቴ ባሮን ኮትቴ ማኮኒ ችማ እምር።<verse eid="1CO 12:10"/></para>
  <para style="s1">እሳ አሱሳ አቱታ ኦማ ኦማ ብልት ፋር</para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 12:11"/>[ስኑንታኖ ኤስ ባሮን ዙትራ ዛግፋስ ኤስ እሳ ኮርቶ አያናስዋ። ኮርቶ አያናስ ሾሌናማቶ አስሱ እሳ እሳርባሲክ ኦማ ኦማ እማ እምፋ] <verse eid="1CO 12:11"/><verse number="12" style="v" sid="1CO 12:12"/>እሳ አሱስ ሾዎ አቱኒ ብልትባ ፋር። አቱሲ ብልት ሾዎ ስንና ፋናስ ኤስ እሳ አቱስታዋ። ኤሲስማቶ ክርስቶስ ሾዎ አቱኒ ብልትባ ፋና እሳ አቱንማቶዋ። <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>አይሁድ ስንፌኒክ፤ ግሪክኒ አስሱ ስንፌኒክ፤ ቦዝ ስንፌንክ፤ ብርማዱምማ ኬሳ አስሱ ስንፌንክ እንኖ ዙታምኒሴ እሳ አቱ ስንናንክ ኮርቶ አያናሲክ ሀጱቅቴንዋ። ዙታምኒሴ ደይ ኤስ እሳ አያናስኪን ኡሽኒዋ። <verse eid="1CO 12:13"/><verse number="14" style="v" sid="1CO 12:14"/>እሳ አቱ ዎሱስቴናስ ሾዎ አቱኒ ብልትስኪንታኖ እሳ አቱ ባር ባርኪን ኮእባታዋ። <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>ዎቾስ፦ «ታ፤ ኩሹ ስንና ሻኪና ቦርአ አቱኒ ብልትታዋ» እያናነ ኤካን፤ ኤካ ኡባሲክ አቱኒ ብልት ስንባስ ፌሽንሮሶ? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>ኦዶስ ደይ፦ «ታ፤ ኣፋ ስና ሻኪና ቦርአ አቱኒ ብልት ኣፋ ስንናናዉዛ» እያናነ፤ ኤካን ኤስ ኤካ ኡባሲክ አቱኒ ብልት ስንባስ ፌሽንሮሶ? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>እሳ አቱስ ዙቴራ ኣፋ ኣፋ ስኒ ስንፋናነ አዉክ ኦድቶና ካባንሶ? እሳ አቱ ዙታምባሴ ኦዶ ኦዶ ስኒ ስንፋናነ አዉክ ሳዉስቴራ ቢስቶና ካባንሶ? <verse eid="1CO 12:17"/><verse number="18" style="v" sid="1CO 12:18"/>ስኑንታኖ ሀሽ ሀኦስ ባር ሾሌናማቶ እሳ አቱሲ ብልት አቱሲክ ሾልሲ ድምባስታ ኤጳ ዱናክ ዛጊዋ። <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>ዙታምባሴ እሳ ብልት ስኒ ስንፋናነ ቱምማ አቱ አይን ቤስቶና ካባንሶ! <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>ስኑንታኖ ሀሽ ሾዎ ብልት ፋፋናክኑ አቱስ እሳርዋ። <verse eid="1CO 12:20"/><verse number="21" style="v" sid="1CO 12:21"/>ኣፋስ ኩሹሶን፦ «ነ፤ ታክ ኣነ ሾልስፌዌ!» ኡናክ ኣፋ ችማናዉዛ። ቴታስ ደይ ዎቾሶን፦ «ነ፤ ታክ ኣነ ሾልስፌዌ!» ኡናክ ኣፋ ችማናዉዛ፤ <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>ኤስ ባርስታን አካማኖን ሆፕያነ ፋር ስንና ቤስቴፋ አቱሲ ብልትሲክቶኒ ኦማስታን ደናሎኖን ሾልሱዋ። <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>ጋሮ ኡልፍንባ ፋርነ ፋር ስንና ቤስቴፋ አቱሲ ብልትኒክቶክ አሪክሮን ኡልፍና እምኒርዋ። ብያክ ኢቹነ ፋር ስንና ቤስቴፋ አቱሲ ብልትኒክቶክኑ አሪክሮን ኡልፍና እምማ ኦድፌኒዋ። <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>ስኑንታኖ ብያክ ኢቾኖይኒ አቱሲ ብልትኒክቶክ ኤስ ባር ዙታምባሴ ኣነ ሾልስፋ። ስንፋናክኑ ሀኦስ ብያክ ኢቹነ ፋር ስንና ቤስቴፋ አቱኒሲ ብልትኖን አሪክሮን ኡልፍናክ ኦድቶናማቶ ዛግራቱ አቱሲ ብልትሲ ኬእዋ። <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>ኤስ ባሮን ደይ ዛግናስ አቱሲ ብልትኒ ጋነያሲ ኦር ኦር ኬሳ ፎኖይናሮን ባሬ ባሬ ዋል ሳፋሮናክዋ። <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>እሳ አቱሲ ብልት ራካቴፌን ኦማ አቱሲ ብልትኒክቶ ዙታምባሴ ደይ አነቱ ራካቴፋዋ። እሳ አቱሲ ብልት ኡልፍንቴፋና ካባሲክ ኦማ አቱሲ ብልትኒክቶ ደይ አነ ግሬፋዋ። <verse eid="1CO 12:26"/><verse number="27" style="v" sid="1CO 12:27"/>ንቶ ደይ ክርስቶስኒ አቱኒ ብልትዋ፤ እሳ እሳርኒትስ ባሳ አቱሲ ብልትዋ። <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>ኤስ ባሪ ቦርኣ ሀኦስ አስሱ እሳ እሳርባስን ቤቴክርስታኒሲ ኦማ ኦማ ዎስቶባ ፎናማቶ ዛጊዋ። ኤስ ባርክ ዜምማ ዎስኒ ሜያኖን፤ ሄፕሳስታክ ራጁኒ ሜያኖን፤ ኬዝሳስታክ አስሲኛኒ ሜያኖን ዛግራ ታትሲዋ። ቱስራ ደይ ቢስቴራ አሪቶኖይ ዉዛ ዛጉኒ ባሶትን፤ ቱስራ ደይ ፋቱኒ እማ ባሶክ እምቴና ባሶትን፤ አሱኒኒ አሪጋሱኒ እማ ባሶክ እምቴና ባሶትን፤ ሀእሱኒ ሜያኖንናዋ ኦማ ኦማ ኖኖክ ዎሉምሶኒ አሱኒ ሜያኖንና ሆሲዋ። <verse eid="1CO 12:28"/><verse number="29" style="v" sid="1CO 12:29"/>ዙታምቤሲሴ ዎሲኖሶ? ዙታምቤሲሴ ራጁኖሶ? ዙታምቤሲሴ አስሲኛኖሶ? ዙታምባሴ ቢስቴራ አሪቶኖይ ዉዛ ዛግሴቴሮሶ? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>ዙታምቤሲሴ አሲክ ፋቱኒ እማ ባሶኪ ፋሮሶ? ዙታምቤሲሴ ኦማ ኦማ ኖኖክ ማክሶነ አሩቤስ ፋሮሶ? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>ኤስ ባሪ ቦርኣ ዙታምባሴ አሲስታን ደናሎ ስና እማሲክቶኖን ዳናትክ ችምማ ሾሎትዋ። ሀሽ ደይ ዙታምባሴ አሲስታን ደናሎ ስና ኡግናሶን ንቶክ ቤሱናዋ።</para>
  <para style="p" vid="1CO 12:31">ሀሽ ደይ ዙታምባሴ አሲስታን ደናሎ ስንና እማሶን ቤሱናዋ።<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">ፉቶኒ ኬሽታና</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>አሱኒ ሜኒ ኖኖክናዋ ሀኦሲ ዎስኒ ኖኖክና ዎል ሌፋናክኑ ኬሽታና ታይሲ ትሽፋናነ ሾሩክቴን ሲክል ሲክልት ግልፋ ብትታ ወደይ አሽቀ ስኒጝዋ። <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>ራጅ ማኮኒ እማ ታክ እምቴፋናነናዋ ኣቾ ዉዛሶን ዙትራ አሪፋናነና ደይ አሩ ዙቴራ ታክ ፋፋናነ፤ ኣማሶን እሳ ድምታን ኦማ ድምታ ዋርአ ታምኒ አማንቶና ፋፋን ኬሽታና ታይሲ ትሽፋናነና ሽማ ስኒጝዋ። <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>ታክ ፋ ዉዛሶን ዙትራ ቱካምኒ ሜያክ ሃእፋናነ፤ አሽናስኑ ፉእቶኖይናሮን ጌያክ ኪቾናክ ኣትራ እማና ኬሽታና ታይሲ ትሽፋናነ ኣፋ ታክ ኬእአናዉዛ። <verse eid="1CO 13:3"/><verse number="4" style="v" sid="1CO 13:4"/>ኬሽታናስ ፋክር፤ ኬሽታናስ ማአሮን ዛግር፤ ኬሽታናስ ኮኖኒክ ኣነ ዛግፋ፤ ኬሽታንባ ፋና አስሱ ባሳ ቴታሲክ ኣነ ቴቴፌ፤ ኬሽታንባ ፋና አስሱ ኣነ ቤጋንቴፌ። <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>ኬሽታናስ ስትርባ ፎንቶ ኣነ ዛግፋ፤ ኬሽታንባ ፋና አስሱ ባርክ ኬእኒ ባር ባሮን ኣነ ሾሌፌ፤ ኬሽታንባ ፋና አስሱ ኣነ ሃሬፌ፤ ኬሽታንባ ፋና አስሱ ሚርእአሜፌናክኑ ሚርእአምባሶን ኣነ ፋድፌ። <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>ኬሽታንባ ፋና አስሱ ፉቶ ስንና ዉዛስታቱ ግሬፌቴኖ ፉቶ ስኖይ ዉዛሲክ ኣነ ግሬፌ። <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>ኬሽታንባ ፋና አስሱ ዙታምባሴ አሲን ችማር፤ ዙታምባሴ አሲክ አማነር፤ ዙታምባሴ አሲን አብድ ዛግር፤ ዙታምባሴ አሲክ ዛግሬ የሬር። <verse eid="1CO 13:7"/><verse number="8" style="v" sid="1CO 13:8"/>ኬሽታምባ ፋና አስሱ ኣጌነ ኣጌነ ኣነ ጋንደፌ፤ ራጅ ማኮኒ እማስ ኣታር፤ ኦማ ኦማ ኖኖክ ዎሎኒ ችማስ ኣታር፤ አሩስኑ ስንፋናነ ኣታር። <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>አሪፌኒ ባር ስኑን ራጅ ማኬፌኒ ባር ባጋዋ። <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>ስኑንታኖ ፉቶ እሳ ኤሽባ ፎንቶ ዉዛስ ያፋና ካባሲክ ባግቶ ስና ባር ፌሻናዋ። <verse eid="1CO 13:10"/><verse number="11" style="v" sid="1CO 13:11"/>ዳጋ ናዋ ስንና ፋና ካባሲክ ዳጋ ናኒማቶ ዎል ሌት ፋናር፤ ደይ ዳጋ ናኒማቶ ሳፋሬት ፋናር፥ ዳጋ ናኒማቶ ቱእኒት ፋናር፥ ስኑንታኖ ጋይማ አስሱ ስንፋና ካባሲክ ዳጋ ናኒ አማላናሶን ቤይጝዋ። <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>ሀሽ እንካሊሲ ቢፌንስማቶ ጣቃጣቃስቱ ቢድፌንዋ። ስኑንታኖ ኤስ ካባሲክ አምማኖን ብያንዋ። ሀሽ አሪፋናስ ባግጋዋ፤ ስኑንታኖ ኤስ ካባሲክ ሀኦስ ታን አሪፋናስነ ፋሮን ቱማ አሩና ፎናዋ። <verse eid="1CO 13:12"/><verse number="13" style="v" sid="1CO 13:13"/>ኤሴ አማንቶ፥ አብድ፥ ኬሽታናስ ኬዞባሴ ዛግራ ፎናዋ፤ ስኑንታኖ ሀን ባርኪቶኒ ጋነያስን አርኪስ ኬሽታናስዋ።<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">ኦማ ኦማ ኖኖክ ዎሎን እማሲክቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>ኤሴ ኬሽታናሲክ ዞኑስቶትዋ፤ ኮርቶ አያናስ እማኖን አሪክሮን ራጅኒ ማኮስ እማኖን ማእስራ ሾሎት። <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>ኦማ ኦማ ኖኖክ ዎል ሌፌ ባር ሀኦሲክታኖ አሱኒክ ኣነ ማኬፌ። ኣቾ ስንና ቾዋሶን ኮርቶ አያናስ ሁግናክ ማክቴፋና ቦርአ ኤስ ማክቴ ካማሶን አሪፌር ኣፌ። <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>ስኑንታኖ ራጂሶን ማኬፌ ባር ኦሚስን ዬቱክ፥ ዛጉክናዋ ችኑክና አሱኒ ሜያክ ማኬፌ። <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>ኦማ ኦማ ኖኖክ ዎል ሌፌ አሱስ ባሳ ቴታሶንቱ ዛግፌ፤ ስኑንታኖ ራጅ ማኬፌ ባር ክርስታናን ሜኒ ማባራሶንቱ ዛግፌ። <verse eid="1CO 14:4"/><verse number="5" style="v" sid="1CO 14:5"/>ዙታምንትሴ ኦማ ኦማ ኖኖክ ዎል ሌፋትነ ሹናና ካባዋ። ስኑንታኖ ኤስ ባርስታን ማእስራ ሹናናስ ራጂሶን ማኬፋትነዋ። ክርስታናኒ ሜኒ ማባራስ ዛጉናክ ኦማ ኦማ ኖኖክ ዎል ሌፌ አሱሳ ዎላኖን ኮትቴ ማኮኒ አስሱ ትሽፋናነ ራጅ ማኬፌ ባር ደናሎዋ። <verse eid="1CO 14:5"/><verse number="6" style="v" sid="1CO 14:6"/>ኤሴ አይኒ ሜያነ! ንቶኪ ያፋና ካባሲክ ኦማ ኦማ ኖኖክ ማኬት ያፋናነ አዉ ንቶክ ኬእንሪንሶ? ኤስ ባርስታን ንቶክ ኬእኒስ ሀኦሲ ኣቾ ቾዋኖን አምማኖን ክስሬ ማኮሶን፥ አሩሶን፥ ራጅኒ ማኮሶን፥ አሱሶን ኤጳ ያፋናነዋ። <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>ኡሉሌኒማቶናዋ ካማኒማቶና ፋሴ ካባ ፎንቶ ሱሩኒ ኮዳሲክቶኑ ኦማ ኦማ ግልኒ ካማ እማናክ ማእስቴራ ዱስቶ ሻካናነ እምፋና ቴቾኒ ካማ አዉ ስንናማቶ ኣካክ አርቶኒሪንሶ? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>ቱቱሩስ አርቶኖይ ካማክ ፉግቴፋናነ ኔቦክ ኦንሶ ሆሮንሪ? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>ኤሲስማቶ ጋድዶ ኖኖክ ዎል ሌፌት ካባሲክ አምማ ስና ካማክ ማኮ ሻካትነ ዎል ሌፌት ባሮን ኦ አሩክ ችምንሪንሶ? ስሩሲክ ማኬድፌትሪነ ፋርቱ ስንናትዋ። <verse eid="1CO 14:9"/><verse number="10" style="v" sid="1CO 14:10"/>ኤሴ ሀን ዳስታክ ሾዎ ቴሳ ኖኖ ፋርዋ፤ ኮትባ ፎንቶ ኖኖ ደይ ኣፋዋ። <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>ኤሴ ታ፤ ዎሉምቴፋ ዎላሲ ኮታኖን አሩኖይናር ስንፋናነ ዎል ሌፌ አሱሲክ እርባቱ ስንናናዋ፤ ባር ደይ ታክ እርባቱ ስንናናዋ። <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>ንቶ ደይ ኮርቶ አያናሲ እማኒክቶኖን አካማኖን ሾሌት ፋትር ስንና ቦርአ አሪክሮን ሾሎትክ ሾልስንናስ ቤትክርስታኒሶን ዛግፋ እማሲክቶ ሾዎናክዋ።<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>ኤስ ባሪ ቦርኣ ኦማ ኦማ ኖኖክ ዎል ሌፌ አስሱ ኮትቴ ማኮኒ ችምባ ፎናክ ሺጶዎዋ። <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>ታ፤ ኦማ ኦማ ኖኖክ ሺጴፋናነ አያናሲቱ ሺጴፋርታኖ ካኑናስ ጋንባ ፎንቶዋ። <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>ኤካ አዉ ዛጉናክ ሾልስፋሶ? አያናሲክ ሺጶና፤ ካኑናሲክ ደይ ሺጶናዋ፤ ደይ አያናሲክ ጋማ ጋሜናርዋ፤ ካኑናሲክ ደይ ጋማ ጋሜናርዋ። <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>ኤካ ስና ሻካናነ ነ አያናክ ሀኦሶን ጋላቴፋታ ካባሲክ ነ፤ ማኬፋታ ባሮን አሩኖይ እርባ አስሱ ጋላትኒ ሺጶኔሲክ፦ «ኣሚን» ኡክ ኣካክ ችምንሪንሶ? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>ፉቶሲክ ነ፤ ሺጴታ ጋላትኒ ሺጶስ ማአሪክዋ። ስኑንታኖ ኦም አሱስን ኣፋ ዛግጉናዉዛ <verse eid="1CO 14:17"/><verse number="18" style="v" sid="1CO 14:18"/>ታ፤ ንቶ ዙታምኒትሴ አሲስታን ደናሎኖን ኦማ ኦማ ኖኖክ ዎል ሌፋና ቦርአ ሀኦናሶን ጋላቴፋዉጙዋ። <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>ስኑንታኖ ኦማ ኦማ ኖኖክ ሾዎ ካማክ ፋድቶኒ ካማ ማኮናስኔን ኦም ሜያኖን አሱክዋ እያት ቤቴክርስታኒሲክ ኡች ካማ አርቶ ኖኖክ ካኑናሲክ ማኮናክቱ ሾሌፋዉጙዋ። <verse eid="1CO 14:19"/><verse number="20" style="v" sid="1CO 14:20"/>አይታሳክቶኖ! ማጙ ዉዛሲክ ዳጋ ናንጎታ ስንትታኖ ሳፋራንትሲክ ዳጋ ናንጎትኒማቶ ስንናቲታዋ። ኤስ ባሮን ሻካት ሳፋራንትሲክ አሩ ስንትዋ። <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>ኤሲስ ደይ፦</para>
  <para style="q1" vid="1CO 14:21">« ‹ኦማ ኦማ ኖኖክ ዎል ሌፌ አሱኒ ሜናዋ፤</para>
  <para style="q2" vid="1CO 14:21">አላጋ አሱኒ ሜኒ ኖኖክና፤</para>
  <para style="q2" vid="1CO 14:21">ሀን ዳራሲክ ማኬፋውጙዋ፤</para>
  <para style="q2" vid="1CO 14:21">ኤስ ባርኑ ስንፋናክ ኣፋ ታን ኦዶሶነ ዉዛ›</para>
  <para style="q2" vid="1CO 14:21">ይፋዋ ዳማ ሀኦስ»</para>
  <para style="m" vid="1CO 14:21">ይስቴራ ቱማስሲ ትቼዋ።<verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>ኤስ ባሪ ቦርኣ ኦማ ኦማ ኖኖክ ዎላሲ ማላቶ ስንናስ አማኖኖይ አሱኒ ሜያክታኖ አማነሴፌ አሱኒ ሜያክታዋ። ስኑንታኖ ራጅኒ ካማ ማኮስ ማላቶ ስንናስ አማነሴፌ አሱኒ ሜያክታኖ አማኖኖይ አሱኒ ሜያክታዋ። <verse eid="1CO 14:22"/><verse number="23" style="v" sid="1CO 14:23"/>ኤሴ ቤቴክርስታኒን አማኝኒ ሜያ ዙቴሴፌ ካባሲክ እሳ እሳርቤሲስ ኦማ ኦማ ኖኖክ ዎል ሌሴፋቴነናዋ አሩኖር ወደይ አማኖኖይ አሱኒ ሜያ ዬሴፋቴነና ኤስ ማክሴፌ ባሶትን፦ «ሀን አሱኒ ሜያ ንፋሴሴቴዋ» ኣፋኖሶ ኡሶነዉዛይ? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>ስኑንታኖ ዙቴሬ ራጅኒ ካማ ማኬፋናነናዋ አማኖኖር ወደይ አሩኖይ አሱ ዬፋናነና ኦደና ካማ ዙታምባሴ አሲክ ዋቃስቴርዋ። ኤሲስማቶ ደይ ኦደና ካማ ዙታምባሴ አሲክ ማጝሱ ባሳስታ ካቴርዋ። <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>ንብባሲ ኣቸራ ፋ ዉዛስ ደይ አምማኖን ኬስሳ ቤስቴርዋ፤ ስንባሲክ ደይ ጋንደሬ፦ «ፉቶሲክ ሀኦስ ባሶ ጋነያስዋ!» ይት ሀኦሲክ ሳጋዶናዋ።<verse eid="1CO 14:25"/></para>
  <para style="s1">ማባራክ ሺጶኒ ካባሲክ ፎናክ ሾልስ ስትሪ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>አይኒ ሜያነ! ኤሴ አዉ ዛጉኒክ ሾልስፋሶ? ሺጶክ ዙቴሴፌት ካባሲክ ንቶስን እሳይሲክ ጋማ ፋር፤ እሳይሲክ አስሱ ፋር፤ እሳይሲክ ኣቾ ስና ዉዛሶን አምማኖን ክሲሬ ቤሱ ፋር፤ እሳይሲክ ኦማ ኦማ ኖኖክ ዎሎ ፋር፤ እሳይሲክ ማክቴ ባሮን ኮትቴ ማኮ ፋር። ኤስ እማስ ዙቴራ ክርስታናኒ ሜያኖን ዛግጉኒር ስናናክ ሾልሱዋ። <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>ኦማ ኦማ ኖኖክ ማኮኒ አሱኒ ሜያ ፌሴፋቴነ ሄፕ ወደይ አሪክፋናነ ኬዝ ስንነ ታራ ታራ ማክሶቶ፥። ባሶ ማክሴቴ ባሮን ኦም አስሱ ኮትቴ ማኮዎ። <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>ስኑንታኖ ኮትቴ ማኮኒ አሱ ትሽፋናነ ኦማ ኦማ ኖኖክ ማኬሴፌ ባሶ ዙቶኒ ድማስታክ ሻኩሶቶ። ባሶ ቴታሲክናዋ ሀኦሲክና ኮእባ ማክሶቶ። <verse eid="1CO 14:28"/><verse number="29" style="v" sid="1CO 14:29"/>ራጁኒ ሜያ ሄፕ ወደይ ኬዝ ስንነሬ ማክሶቶ፤ ኦሚስ ደይ ማክቴ ባሮን ኦደሴሬ ማእስሬ ማዛንሶቶ። <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>ዙቶስታ ዲሴ ኦም አሱ እሳ ዉዛ ቤስቴፋናነ ቴሱኒ ማኬት ፌ ባር ሻኩዎ። <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>እሳ እሳርባስ አሩናክናዋ ዛጉናክና ዙታምኒትሴ ታራ ታራ ሀኦሲ ዎሲያኖን ማኮ ችማትዋ። <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>ራጁኒ ሜኒ ራጅኒ አያናስ ራጁኒ ሜያክ አጃጃሜርዋ። <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>ሀኦኒ ዳራ ስና ቤቴክርስታኒሲክቶ ዙታምባሴ አሲስ ዛግቴፋናይስማቶ ሀኦስ ናጋኒ ሀኦታኖ ሳስኒ ሀኦታዋ። <verse eid="1CO 14:33"/><verse number="34" style="v" sid="1CO 14:34"/>ማሽካ ሜያ ሀኦ ሺጶክ ዙቶኒ ካባሲክ ሻኩሶቶ። ቱማስ ባሶትን አጃጀፋናይስማቶ አጃጃሞሶነክታኖ ማክሶነክ ኣነ አጃጆዋዋ። <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>እሳ እሳ ዉዛ አሩክ ሾልሴፋቴነ ኬቤሲሲክ ቴጎቤሲስን ማሙሶቶ፤ ሺጶኒ ዙቶስታክ ማሽካሱ ዎል ሌፋናነ ኢቹዋ።<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>ሻካፎት ሀኦሲ ካማ ንቶኪንኖሶ? ወደይ ሀኦሲ ካማ ያራ ካርእናስ ንቶ ንቶክኖሶ? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>ታ፤ ራጁዋ ወደይ አያናኒ እማ ታይሲ ፋርዋ ይፌ አሱ ፌፋናነ ሀን ትችናስ ዳሚሳ አጃጅ ስንባሶን አሩዎዋ። <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>ኤስ ባሮን አሩኖር ፌፋናነ ባር ደይ ኣነ አርቴፌዋ። <verse eid="1CO 14:38"/><verse number="39" style="v" sid="1CO 14:39"/>ኤስ ባሪ ቦርኣ አይኒ ሜያነ! ራጅኒ ማኮሶን ማእስራ ሾሎትዋ፤ ኦማ ኦማ ኖኖክ ዎላሶን ደይ ካላቲታ። <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>ስኑንታኖ ዙታምባሴ ሾልሲናማቶናዋ ስትሪክና ስኑን።<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">ክርስቶስኒ ክቱን ካቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>ሀሽ ደይ አይኒ ሜያነ! አሲና ምስራቹኒ ካማሶን ያዳሱናክ ሾሌፋዉጙዋ፥ ኤስ ምስራቹኒ ካማስ ደይ ንቶ ኤጳ ታሴት ባሬዋ ዛግራ ዬርሴት ባሬዋ። <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>ታ፤ ንቶትን አሲና ምስራቹኒ ካማሶን ማእስራ ኤጳትነ ባርክቱ ፋሩትዋ፥ ኤካ ስና ሻካናነ አማንቶኒትስ ሽማሲክ ሲናርዋ።<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>ታ፤ ኤጳታና ቴሱኒ ጌፋስታ ፋ ባሮን ንቶክ ኣትጝዋ፥ ታ፤ ንቶክ ኣትና ዉዛስ ኮርቶ ማፃፋስሲ ትቼናስማቶ ክርስቶስ እንኖ ቦርኣሲክ ክት፤ <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>ካባርቴ፤ ኮርቶ ማፃፋስሲ ትቼናስማቶ ኬዝስንናሪ ዎኖ ክቱን ካብ ይፋርዋ። <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>ባር ጴጥሮስኒክ ቤስቴ፥ ኦርፎ ደይ አሲሬ ሄፕ ዎስኒ ሜያክ ቤስቴ። <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>ኡች ትያስታን ደናሎ ስና ባሳ ዞንሲሲክ እሳርጋ ቤስቴ፤ ባሶስን ሾዎቤሲስ ሀሽ ሀውጙ ካርኤ ካክ ፌሴቴርዋ። ስኑንታኖ እሳ እሳይስ ደይ ክትሴቴዋ። <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>ኤሴን ኦርፎ ያቆብኒክ ቤስቴ፥ ዎስኒ ሜያ ዙታምቤሲሴ አሲክ ቤስቴ። <verse eid="1CO 15:7"/><verse number="8" style="v" sid="1CO 15:8"/>ኮእአሲታክ ናሱነ ፌር ስና ታክ ደይ ቤስቴ። <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>ታ፤ ሀኦሲ ቤቴክርስታኒኖን ቤትራ ትሽኪት ፋናር ስንና ቦርአ ዎስኒ ሜያ ዙታምቤሲሴ አሲስን ሀቴር ደይ ዎሲ ይስቴራ ቴግቶናክ ሾልሱኖይናርዋ። <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>ስኑንታኖ ታ፤ ሀሽ ስንና ባሮን ስንናስ ሀኦሲ ኦትማክዋ። ታክ እምቴ ኦትማስ ጋንባ ፎንቶኖን ኣነ ፉእቶዋ። ኤስ ባሪስታን ኣትታ ኦሚኒ ሜያስታን አርክሮን ዎስቶክ ሆፕን። ስኑንታኖ ኤስ ባሮን ዛግስ ታኔን አነ ፋ ሀኦሲ ኦትማታኖ ታቴዋ። <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>ኤሴ ታ፤ ስንፋናክ ወደይ ባሶ ስንነፌክ አሲፌኒስ ኤስ ባሮጝዋ፤ ንቶ ደይ አማነቲስ ኤስ ባሮጝዋ።<verse eid="1CO 15:11"/></para>
  <para style="s1">ክቱኒ ሜኒ ክቱን ካቡ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>ስኑንታኖ ክርስቶስ ክቱን ካብናማቶ ማኬኒ ስንፋናነ ንቶስን እሳ እሳ ሜያ ክቱን ካቡ ኣፋዋ ኣካክ ይሴፌሶ? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>ክቱን ካቡ ትሽፋናነ ክርስቶስ ክቱን ኣነ ካቡዌ ኡዋ። <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>ክርስቶስ ክቱን ካቡ ሻካናነ እንኖ አስሱስ ስኑን ንቶ አማንቶስ ሽማሲክ ስንባዋ። <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>ደይ ሀኦስ ክርስቶስኒን ክቱን ካብጝዋ ይሬ አስሱኒሲክ ኤሽኛ ሀኦኒ ዛል ስንኒ ኡዋ። ኤሴ ክት አሱኒ ሜያ ክቱን ካቡ ሻክሴፋቴነ ሀኦስ ክርስቶስኒን ደይ ክቱን ኣነ ካብጉዋ ኡዋ። <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>ክት አሱኒ ሜያ ክቱን ካቡ ሻክሴፋቴነ ክርስቶስ ክቱን ኣነ ካቡዌዋ ኡዋ። <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>ክርስቶስ ክቱን ኣነ ካቡዌ ስንፋናናነ አማንቶኒትስ ሽማሲክዋ ኡዋ። ንቶ ደይ ሀሽኑ ቦርኣስቱ ፋሴት ኡዋ። <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>ክርስቶስኒክ አማነሬ ክት ባሶ ትሽሴቴዋ ኡዋ፦ <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>ክርስቶስኒክ አብድ ዛግፌኒስ ሀን ዳስታኪ ካክ ኮእባ ስንፋናነ አሱ ዙታምባሴ አሲስን አርክሮን እኖክ ሱሞኒ አስሱ ስንናኒርዋ።<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>ስኑንታኖ ክርስቶስ ክት ባሶክ ክቱን ካቡኒ ኡዛ ስንነ ፉቶክ ክቱን ካብዋ። <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>ክቱ ያናስ እሳ አሱኒኪ ካሞ ስንናማቶ ክቱን ካቡስ ደይ እሳ አሱኒኪ ካሞ ስኒዋ። <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>አዳምኒ ቦርአ አሱ ዙታምባሴ ክትፌናማቶ ደይ ክርስቶስኒ ቦርአ አስሱ ዙታምባሴ ካ ዳናናዋ። <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>ስኑንታኖ ኤስ ባር ደይ ስንናናስ እሳርባ እሳርባስ ታራባሲክዋ። ክርስቶስ ክቱን ካቡባሲክ ኡዛዋ። ሀንኔን ደይ ክርስቶስ ዬፌና ካባሲክ ባሳር ስና ባሶ ደይ ክቱኒን ካብሶነርዋ። <verse eid="1CO 15:23"/><verse number="24" style="v" sid="1CO 15:24"/>ቱስሬ ደይ ባር ሀእሱሶንናዋ ሀእሱኒ ሁግናሶንና ደይ ግዶሶን ዙትሬ ትሽካት ታቶሶን አባ ሀኦሲክ እምፌና ካባሲክ ሀን ዳስ ኮአ ስንናናዋ። <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>ሀኦስ ጉማባስን ዙትራ ሀእሱባሲ ስካሎሲ ዛጉና ካባኔን ክርስቶስ ታትቶናክ ሾልሱዋ። <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>ሜርቴራ ኮእባስታክ ትሹኒስ ጉማኒ ስና ክቱስዋ። <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>«ሀኦሲ ዙታምባሴ አሲን ሀእሱባሲ ስካሎሲ ዛጊዋ» ይፋር ትቼዋ። ስኑንታኖ፦ «ዙታምባሴ ሀእሱባሲ ስካሎሲ ዛግ» ኡስ ዙታምባሴ አስን ሀእሱባሲ ስካሎሲ ዛግ አባ ሀኦሶን ኣነ ዳይስፋዋ። <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>ዉዛ ዙታምባሴ ክርስቶስኒ ሀእሱኒ ስካሎሲ ስንናኔን ኦርፎ አባ ሀኦስ ዙትራ ዙታምባሴ አሲስታ ስናናክ ናስ ቴትባሲክ ዙታምባሴ አሲን ሀእሱባሲ ስካሎሲ ዛግ አባ ሀኦሲ ሀእሱኒ ስካሎሲ ስንናናዋ። <verse eid="1CO 15:28"/><verse number="29" style="v" sid="1CO 15:29"/>ኤሴ ክት አሱኒ ሜያ ክቱን ካብሶ ሻክሶነር ስንፋናነ ክት አሱኒ ሜኒ ቾዋሲክ ሀጱቅቴሴፌ ባሶ ዙቴሬ ቡእቤሲስ ኣምባንሶ? ክት አሱኒ ሜያ እሳንነ ኣፋ ክቱን ካብሶነ ዉዛ ስንፋናነ አሱኒ ሜያ ባሶ ኤዴ አዉኒሮን ሀጱቅቴሴፌሶ? <verse eid="1CO 15:29"/><verse number="30" style="v" sid="1CO 15:30"/>እንኖኑ ስንፌኒክ ሳአት ሳአትሲክ አዳጋታ ካቱኒ ዉዛክ አቴራ ኦድቴት ፋኒስ አዉኒ ቦርአንሶ? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>አይኒ ሜያነ! ታክ ዎንና ዎንና ክቱ ኡጰርዋ፤ ሀን ባሮን ንቶክ ማኬፋናስ ዳምኒ የሱስ ክርስቶስኒኪ ካሞ ንቶስታ ፋ ቴቶናስ ፉቶ ስንና ቦርአዋ። <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>አሱኒ ሳፋራስማቶ ታ፤ ኤፌሶኑክ ጎኞስኔን አነ ካቦናስ ታክ ኬእናስ ኣምባንሶ? ክቱኒ ሜያ ክቱኒ ካቡ ሻክሶነር ስንነፋቴነ፦ «ዎኖ ክቱኒር ስንና ቦርአ ሀን ያኒ ሙኒ፤ ኡሽኒ» ይስቴናይስማቶ ስንኒርዋ። <verse eid="1CO 15:32"/><verse number="33" style="v" sid="1CO 15:33"/>ኤሽቶትታዋ፤ «ማጙ ዞሞስ ማአ አማላሶን ማጝስርዋ» <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>ሀጝ ንብንትሲክ ዎሉትዋ፤ ቦርኣሶን ደይ ዎስቶትታዋ፤ ንቶ ጋነያሲ እሳ እሳ ሜያ ሀኦሶን አሩኖር ፌሴቴርዋ። ሀን ባሮን ኤካ ይፋናስ ንቶ ኢቾሶትክዋ።<verse eid="1CO 15:34"/></para>
  <para style="s1">ክቱን ካብ አቱ</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>ስኑንታኖ እሳ አሱ፦ «ክት አሱኒ ሜያ ካብሶኔስ ኣካኪንሶ? ክቱን ካብሴፌ ካባሲክ ፎኒ አቱቤሲስ አዉነ ፋሪንሶ?» ይሬ ማምሱና ስንናናዋ፦ <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>ነ፤ ጎዋ! ቡክታ ሜያስ ክቱ ሻካናነ ካባ ኣፋ ፎና ዉዛ። <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>ነ፤ ቡክፋታ ካባሲክ አካክልትሶን ኣነ ቶኬዋ፤ ስኑንታኖ ዛላስ አዉዛክነ ዛጎ ወደይ ኦማ ዉዛ ስናናክ ችማናዋ። <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>ስኑንታኖ ሀኦሲ ሾሌናማቶ ዛላሲክ አቱባ እምፋዋ። ዛላስ እሳ እሳርባሲክ ኦማ ኦማ አቱ እምፋዋ።<verse eid="1CO 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39"/>አሻ ዙቴራ እሳ ቴሳታዋ፤ አሱኒ አሻስ እሳ ቴሳዋ፤ ካባሬ የሬ ዋጋሲ አሻ ደይ ኦማ ቴሳዋ፤ ካሳሲክቶኒ አሻ ኦማ ቴሳዋ፤ ኩርጡሚሲ አሻ ደይ ኦማ ቴሳዋ።<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>ኤሲስማቶ ደይ ሳማኪ አቱ ፋር፤ ሀን ዳስታኪ አቱ ደይ ፋርዋ። ስኑንታኖ ሳማኪ አቱሲ ኡልፍና እሳ ቴሳዋ፤ ሀን ዳስታኪ አቱሲ ኡልፍና ደይ ኦማ ቴሳዋ። <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>አዋሲ ኡልፍና እሳ ቴሳ፤ አሳሲ ኡልፍና ደይ ኦማ ቴሳውኣ፤ ባኩራስ ኡልፍና ደይ ኦማ ቴሳ፤ እሳ ባኩራስ ኦማ ባኩራስታን ኦማ ኡልፍንባ ፋርዋ። <verse eid="1CO 15:41"/><verse number="42" style="v" sid="1CO 15:42"/>ክቱን ካቡኒ አሱኒ ሜኒ ቾዋስ ሀን ባርነ ፋርዋ። ኩፕኒ አቱቱ ቡክቴፋርዋ፤ ኩፓ ትሹኖር ሀየዋ አቱቱ ስንና ካቡናዋ። <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>ሳልጲናክ ቡክቴ ባር ኡልፍናክቱ ካቡናዋ፤ ሆፕያ ስንና ቡክቴ ባር ሁግናባሬ የሬር ስንናቱ ካቡናዋ። <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>አሽኒ አቱ ስንና ቡክቴ ባር አያናኒ አቱ ስንናቱ ካቡናዋ። አሽኒ አቱ ፋናኔን አያናኒ አቱ ደይ ፋርዋ። <verse eid="1CO 15:44"/><verse number="45" style="v" sid="1CO 15:45"/>ኤስ ባሪ ቦርኣ፦ «ቴሱኒ አሱ አዳም ሀየዉ ቴስቶ ስኒዋ» ይስቴራ ትቼዋ። ስኑንታኖ ኮእኒ አዳም ስንና ክርስቶስ ደይ ካ እምኒ አያና ስኒዋ። <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>ስኑንታኖ ቴሱስታ የይስ አሻ ማዮቴኖ አያናኒስቴዋ። አያናኒስ ዬናስ አሻ ማዮስኔን ኦርፎዋ። <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>ቴሱኒ አሱስ ቴስቴናስ ሀን ዳስክር ስንና ቦርአ ሀን ዳስታኪርዋ፤ ሄፕሳኒ አሱ ዬናስ ሳማጝዋ። <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>ሀን ዳስታኪር ስንና ባሶ ሀን ዳስታኪ ቴስቴ ባሳይሲማቶዋ። ሳማን ስንና ባሶ ሳማን የ ባሳይሲማቶዋ። <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>ሀን ዳስታኪ አሱሳ ግቶነ ፌር ስንማቶ ደይ ሳማኪ አሱሳ ግቶነ ፌር ስንናኒርዋ።<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>አይኒ ሜያነ! ታ፤ ንቶክ ማኬፋናስ ሀኒስዋ፤ አሻሴዋ ሀንናሴ ሀኦሲ ታቶኖን ኣፋ ኤጳቶና ዉዛ። ኤሲስማቶ ደይ ክቱኒ አቱስ ክቱኖይ ሀየዋ አቱሶን ኣፋ ኤጳቶና ዉዛ።<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>ኤሴ እሳ ኣቾ ዉዛ ንቶክ ማኮናዋ፤ እንኖ ዙታምኒሴ ኣፋዋ ክቱኒ ዉዛ፤ ስኑንታኖ ዙታምኒሴ ሶልቶኒርዋ። <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>ሶልቶኒስ ደይ ኮእኒ ቱቱሩስ ፉግቴፋና ካባሲክ ኣፍኒ ዋልጋት ይፕግፌስነ ፋሮን እሳርጋክዋ። ቱቱሩስ ፉግቶና፤ ክት አሱኒ ሜያ ደይ ክቱኖር ሀየዉ ስንነሬ ክቱኒ ካብሶነ፤ እንኖ ደይ ሶልቶኒ። <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>ሀን ኩፕን ባር ኩፕኖይሶን ሀን ክቱኒ ባር ክቱኖይሶን ማያናክ ሾልሱዋ። <verse eid="1CO 15:53"/><verse number="54" style="v" sid="1CO 15:54"/>ኤስ ኩፕኒ ባር ኩፕኖይሶን ሀን ክቱኒ ባር ክቱኖይሶን ማይፋና ካባሲክ፦ «ክቱስ ትሺ ደይ ሜርቴ!» ይስቴራ ትቼ ባር ኮኡናዋ። <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>ኤሲስማቶ ደይ፦</para>
  <para style="q1" vid="1CO 15:55">«ክቱሴ! ሜሬሬ ካቡኔስ አይፋሴ?</para>
  <para style="q2" vid="1CO 15:55">ክቱሴ! አሱኒ ሚርኤፋታ</para>
  <para style="q2" vid="1CO 15:55">ሁግናኔስ አይፋሴ?» ይስቴዋ።<verse eid="1CO 15:55"/></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56"/>ክቱሲ ኬጅኒ ሁግናስ ቦርኣስዋ፤ ቦርኣሲ ሁግና ደይ ቱማስዋ። <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>ስኑንታኖ ዳምኒ የሱስ ክርስቶስኒኪ ካሞ ሜሮኒክ ዛግፋ ሀኦሲክ ጋላታ ስንፋውጝዋ። <verse eid="1CO 15:57"/><verse number="58" style="v" sid="1CO 15:58"/>ኤስ ባሪ ቦርኣ ሹንቶ አይታሳክቶኖ! ዛግራ የሮትዋ፤ እሳ ዉዛክኑ ስንፋናነ ሾርኮትታዋ፤ ዳሚሳ ዎስቶክ ሆፕፌት ባር ሽማሲክ ስና ቤይባሶን አሪራ ዬቱኖይ ዎንና ዎንና ዳሚሳ ዎስቶኖን ዎስቶክ ችምትዋ።<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">የሩሳሌሙክ አማኝኒ ሜያክ ዙቴ ዋግኒ አሪጋሱ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>አማኝኒክ ዛግቴፋ ዋግኒ ክሱኒ ቾዋሲክ ጋላትያኒ ቤቴክርስታኒሲክቶክ አጃጀናስማቶ ንቶ ደይ ኤካ ዛጉትዋ። <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>ታ፤ ያፋና ካባሲክ ዋግኒ ክሱ ዛግቶኖይናማቶ ጉዳ ጉዳሲ ዎኖ ንቶ ጋነያስን እሳ እሳርባሲክ ዳንፌና ዋጋስታን ክስሬ ኦር ኩንሱዎዋ። <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>ታ፤ ንቶኪ ያፋና ካባሲክ ንቶ ኮሪራ እሜቲ አሱኒ ሜያ ክስሴቲ ዋጋሶን ኤጴ የሩሳሌም ሀሞነክ ጌጌሱኒ ትቻኔን አነ ዎሱናዋ። <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>ሾልሲፋናነ ታ፤ ደይ ባሶኔን ሀማና፤ ባሶ ደይ ታኔን አነ ሀማክ ችሞነ።<verse eid="1CO 16:4"/></para>
  <para style="s1">ጳዉሎስኒ ኮፖሲክቶ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>ሜቀዶንያ ካሞ ሀማናክ ኮፓኤና ቦርአ ኤስታ ካሞ ኣትፋና ካባሲክ ንቶኪ ዮናዋ። <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>ሀማና ድማ ኣፋሪስኑ ኡጉናሲክ ስንኒ አሪጋሱ ታክ ዛጉትክ አዉዛክነ ንቶኪ ኤስታ ጋሮ ዎና ፎና ስናና፤ አዉዛክነ ደይ ዬሹሶን ንቶኔን አነ ኣቱና ስናናዋ። <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>ሀሽ ኤስታ ካሞ ኣትፋና ካባሲክ ንቶትን ብያናክ ኣነ ሾሎትዋ፤ ዳሚሳ ፍቃድ ስንፋናነ ጋሮኖን ድቻ ዎና ንቶኔን አነ ፎናማቶ አብድ ዛግፋዉጝዋ።<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>ስኑንታኖ ፐንጠኮስቴኒ ሄቦስ ካርአናኔን ኤፌሶኑክቱ ፎናዋ። <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>ሾዎ ዎስቶኒ ኡግና ታክ ጋችቼ፤ ስኑንታኖ ቱጋእኤፌ ሜያ ሾዎዋ።<verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>ትሞትዮስ ንቶኪ ዬፌና ካባሲክ ድጋባ ፎንቶኖን ንቶኔን አነ ፎናክ ባሪን አሪጋሱት። ባር ደይ ታይሲማቶ ዳሚሳ ዎስቶኖንቱ ዎስቴፌዋ። <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>ኤስ ባሪ ቦርኣ ኦኑ ባሪን ካሹኖይናማቶ ባር አይኒ ሜያኔን አነ ታኪ ዎል ሌ ዮናክ ኦደት ፋናር ስንና ቦርአ ታኪ ናጋክ ዎል ሌ ዮናክ ኡጉንባሲክ ሾልሲ ባሮን ባሪክ አሪጋሱትዋ።<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>አይኒ ስንና አጵሎስ ኦም አይኒ ሜያኔን አነ ንቶትን ዬሴሬ ብዮሶነክ ማእስራ ሺጴራ ፋናርዋ። ስኑንታኖ ባር ሀሽ ንቶኪ ዮክ ኣኔ ሾሎዌዋ፤ ባርክ ማእና ዎኖ ዮናዋ።<verse eid="1CO 16:12"/></para>
  <para style="s1">ኮእኒ ኪቶነዋ ናጋኒ ኦሽሾነ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>ጉዙት፤ አማንቶክ ዛግራ የሮት፤ ችምት፤ ዛጉት። <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>ዛግፌት ባሮን ዙትራ ኬሽታናክ ዛጉት።<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>አይኒ ሜያነ! እስጥፋኖስኒ ኬርኪ ሜያ አካያኒ ዳስታኪ ቴሱኒ አማኝኒ ሜያ ስንነቴማቶናዋ አማኝኒ ሜያኖን ዎስቶክ ቴትቤሲሶን ኣትሬ እሜቴማቶና አሪሴዲፌትዋ። <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>ኤስ ኤፍፌቴና አሱኒ ሜያክናዋ ባሶኔን አነ ዎስቶክ ሆፕት ፌሴፌ ባሶ ዙታምቤሲሴ አሲክና አጃጃሞሶትክ ማእስራ ያዳሲፋዉጝዋ። <verse eid="1CO 16:16"/><verse number="17" style="v" sid="1CO 16:17"/>እስጥፋኖስኒክናዋ ፌርዶናጥስንክና ደይ አካይቆስንና ባሶ ታኪ ዮስ ታን ግርሲዋ። ንቶ ታኔን አነ ኡጶ ሻኩንትሲክ ባሶ ንቶ ኤድደ ታክ ዮእ ባሮን ቱኒሴቴዋ። <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>ባሶናዋ ታናዋ ንቶትና አሲ አያናሲክ ቤይሳ እሜቴ። ኤስ ባሪ ቦርኣ ኤስ ባሶነ ፌ አሱኒ ሜያ ኡልፍንቶሶነክ ሾልስፋዋ።<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>ኢስያክ ፋ ቤቴክርስታኒሲክቶ ናጋ ንቶክ ኦሽሼሴቴዋ። አቀላነዋ ፕርስቅላነ፤ ደይ ኬቤሲስ ዙቴሴፌ ክርስታናኒ ሜያ ደይ ዙቴሬ ንቤሲስን ካብ ናጋ ንቶክ ዳሚሳ ሱናክ ኦሽሼሴቴውኣ። <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>ሀንታክ ፌሴ ክርስታናኒ ሜያ ዙቴሬ ንቶክ ናጋ ኦሽሼሴቴዋ፤ ኮርቶ ዳሞክ ናጋ ዎል ኦሽሾሶትዋ።<verse eid="1CO 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21"/>ታ ጳዉሎስ ሀን ናጋኒ ትቻሶን ኩሹናሲክቱ ትችጝዋ።<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>ዳሚስን ሹኖር ፌፋናነ ኤርዉቴር ስኖዋ! ዳምኒሶ! ዮዋ!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>ዳም የሱስኒ ኦትማስ ንቶኔን አነ ስንፋውጝዋ።<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>ኬሽታናስ ክርስቶስ የሱስኒኪ ካሞ ዙታምኒትስኔን አነ ስንፋውጝዋ፤ ኣሚን!<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
