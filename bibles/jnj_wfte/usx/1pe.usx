<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">-Yemsa New Testament</book>
  <para style="h">1 ጴጥሮስ</para>
  <para style="toc1">ዎሲ ጴጥሮስኒ እሶንሳ ዎሲያ</para>
  <para style="toc2">1 ጴጥሮስ</para>
  <para style="toc3">1 ጴጥ.</para>
  <para style="mt1">ዎሲ ጴጥሮስኒ እሶንሳ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ዎሲ ጴጥሮስኒ ቴሱኒ ዎሲያ ትቼናስ ዎስባስ «ሀኦሲ ኮርቶ ዳራ» ይስቴሬ ቴግቴሴፌ ባሶክናዋ ጋሮ ኢስያኒ ዬሽዳኪ ድማስሲ ሲክቴሬ ፌሴ ክርስታናኒ ሜያክዋ። ዎሲያስ አሪክሮን ቢፋናስ አማንቶቤሲሲ ቦርአ ካቡግቶነዋ ራኮነ ባሶስታ ካርፋን ፌሬትፌ ባሶትን ችኑክናዋ ዛጉክናዋ። ትችባር ኤስ ባሮን ዛግናስ ክቱባሶን፥ ክቱን ካቡባሶን፥ ዎል ሌ ዮባሲ አብድኖን ማኬፋ የሱስ ክርስቶስኒ ምስራቹኒ ካማሶን ፌሬትፌ ባሶክ ያዳሱክዋ። የሱስ ክርስቶስኒ ካሶን ቤሶ ዛግሴሬ ብያክ ራክኮሶን ፋክያክ ኤጴቶ ሾልስፋናማቶ ማኬፌ። ኤስ ባርኔን ቱስሬ ሻና አማንቶቤሲስ ካይማኖን ፋታኖኒር ስኒባሶን «የሱስ ክርስቶስ ዎል ሌ ዮና ዎኖ» ባሶክ ሾልሲ ዋግቤሲሶን ዳኖነማቶ ማኬፌ።</para>
  <para style="ip">ትችባር ሻናስሲ ፋኩሶነክ ችኑባስታን ኦማ ፌሬትሴፌ ባሶ ክርስቶስኒክ ዞንኑሱሲክ ፎሶነክ ሾልስፋናስንነ ፋሮን ፎሶነክ ማኬፌ።</para>
  <para style="iot">ማፃፋሲ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ሀኦሲ ፋቱኒ ያዳታ <char style="ior"><ref loc="1PE 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">ኮርቶ ካክ ፎሲክ እምቴ ኪቶ <char style="ior"><ref loc="1PE 1:13-2:10">1:13—2:10</ref> </char></para>
  <para style="io1">ራኮኒ ዎኖ ክርስታናኒ ሀእሱ <char style="ior"><ref loc="1PE 2:11-4:19">2:11—4:19</ref> </char></para>
  <para style="io1">ክርስታናኒ ሜኒ ጋራማኒ ዎስቶ <char style="ior"><ref loc="1PE 5:1-11">5:1-11</ref> </char></para>
  <para style="io1">ኮርኡባ <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref> </char></para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>የሱስ ክርስቶስኒ ዎሲ ስና ጴጥሮስኒኪን፥ ፓንቶስ፥ ጋላትያ፥ ኬጳዶክያ፥ ኢስያናዋ ብታኒያና አሲስ ስኬቴሬ እርባ ስነሬ ፌሴ ሀኦ ኮሪና ባሶክ፤ <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>አባ ሀኦስ ዜምማ አሪራ የሱስ ክርስቶስኒክ አጃጃምቶክ ሀርንባሲክ ዊርቴራ ኮርቶ አያናስኪ ካሞ ኮርቶ ስና ንቶክ፤ ሀኦሲ ኦቱምነዋ ናጋነ ንቶክ አሪክፋዉጝዋ።<verse eid="1PE 1:2"/></para>
  <para style="s1">ሀየዋ አብድ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>የሱስ ክርስቶስ ክቱኒ ካቡባሲክ ሀየዋ ስና አብዲሶን እኖክ እምማ፤ አካማ ፋኪባሲክ ጋድዶ ኮኒቶክ እኖትን ባሪ ናንጎታ ዛግ ዳምኒ የሱስ ክርስቶስኒ አባ ሀኦሲክ ጋላታ ስንፋውጝዋ። <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>ባር ደን ሳማክ ትሹኖር፤ ማጙኖይ ደይ ኩርኡኖይ ሆሬራ ፋ ርስት ንቶክ ሆሲ። <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>ንቶ ደይ ኮእኒ ዎናስታ ዮኒ ፋሩሶን አማንቶስኪ ካሞ ሀኦሲ ሁግናክ ኦድቴራ ፋሴትር። <verse eid="1PE 1:5"/><verse number="6" style="v" sid="1PE 1:6"/>ሀሽ ሾዎ ቴሳ ፋታናክ ጋሮ ዎኒሮን ፋታንቴፌትክኑ ኤስ ፋታናሲክ ግሮትዋ። <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>ኤስ ፋታናስ ንቶስታ ካርናስ ንቶ አማንቶስ ዛጋ ስኒባሶን ቤሱክዋ፤ ትሹኒ ዋርቄስኑ ጌሲ ግርራቱ ኬስፋዋ፤ ዋርቄስታን ደናሎ ስና ኡልፍንቶ አማንቶኒትስ ኤሲስማቶ ፋታንቶናክ ሾልሲፋዋ። ኤስ ፋታንቴራ ኬሳ አማንቶኒትስ የሱስ ክርስቶስ አምማኖን ዎል ሌ ዬፌና ካባሲክ ጋላታ፥ ኡልፍነዋ ካጱስቶነ ንቶክ እማና። <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>የሱስኒን ቢኖይፋጌዶ ሹንፌትዋ፤ ሀሽ ብያ ቤይፌትክኑ ባሪክ አማነሴትዋ፤ ኤካ ይስቴራ ማኮክ ችምቶኖይ ኡልፍንቶ ግራ ግሮትዋ። <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>አማነራ ኦድፌት ካኒትሲ ፋሩኖን ዳናትዋ። <verse eid="1PE 1:9"/><verse number="10" style="v" sid="1PE 1:10"/>ንቶክ እምቶኒ ሀኦሲ ኦትማኒ ራጂሶን ማኬ ራጁኒ ሜያ ሀን ፋሩሲ ቾዋኖን ማእስሬ ቱንኢት ፌሴቴርዋ። <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>ባሶስሲ ፋ ክርስቶስኒ አያናስ ክርስቶስኒስታ ካርኒ ሻናሶንናዋ ኤስ ሻናስኔን ኦርፎ ዳናና ኡልፍናሶንና ቤሲራ ፋርዋ። ባሶ ደይ ኤስ ዉዛስ ዙታምባሴ ኣጌናዋ ኣካክና ስናናማቶ ቱኒሬ ፌሴቴርዋ። <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>ኤስ ራጁኒ ሜያ ዎስቴት ፌሴቴስ ንቶክታኖ ባሶ ቴታሲክታ ስንናማቶ ባሶክ አምማኖን ቤስቴራ ፋርዋ። ንቶክ ዎስቴሴቴስ ሳማን ዎስቴራ ያ ኮርቶ አያናስኪ ካሞ ምስራቹኒ ካማሶን ሀሽቲ ንቶክ ማክሴ አሱኒ ሜያ ማክሴቴ ባሮን አምማኖን ኪስሬ ቤሱክዋ። ኤስ ባሮን ደይ ሀኦሲ ዎስያሲክቶኑ ብዮሶናክ ኤናንቴት ፋሴርዋ።<verse eid="1PE 1:12"/></para>
  <para style="s1">ኮርቶ ፎክ ፎ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>ኤስ ባሪ ቦርኣ ንብንትሶን ጉዝግራ ሆሮት፤ ቴትንትሶን ሀእሱት፤ የሱስ ክርስቶስ አምማኖን ዎል ሌ ዬፌና ካባሲክ ዳናት አካማ ፋሩሲ ኦትማኖን ዳናትክ ቱማ አብድንት ፎኒ። <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>አጃጃሜ ናንጎታ ስንትታኖ አሩኖይ ዜሞቲ ፋፌት ማጙ ኤናንቶሲክ ዞኑስቶትታ። <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>ስኑንታኖ ንቶትን ቴጌ ሀኦስ ኮርቶ ስንናማቶ ንቶ ደይ ፎንት ዙታምባሴ አሲክ ኮርቶ ስንትዋ። <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>ኮርቶ ማፃፋስሲ፦ «ታ ኮርቶ ስንና ቦርአ ንቶ ደይ ኮርቶ ስንት» ይስቴራ ትቼዋ። <verse eid="1PE 1:16"/><verse number="17" style="v" sid="1PE 1:17"/>ኦኒንኑ ኮሩኖይ እሳርባ እሳርባሲክ ዎስቶባሲማቶ ማጝሱ ካርኒ ሀኦሶን፦ «አባ» ይራ ቴግሴትር ስንፋናነ ሀን ዳስታክ እርባ ስንና ፋፌት ካባሲክ ሀኦሶን ድጋክ ፎቲ። <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>ንቶ አባንቲሳታን ዋራሴት ኬኖይ ፎስን ፉርቴትስ ትሹኒ ብርክ ወደይ ዋርቄክ ስና ቤይባሶን አርሴፌትዋ። <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>ስኑንታኖ ንቶ ፉርቴሴትስ ዝና ወደይ ሙዳባ ፎንቶ ካይማ ፋንቱ ስና ክርስቶስኒ ኡልፍንቶ ሀንናሲክዋ። <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>ባር ኮርቴናስ ሀን ዳስ ቴስቶኖይፌን ዜምማ ስንፋናክኑ ሀሽ ኮእኒ ነያስታክ ንቶክዋ እያት አምማኖን ኬስሴ ቤስቴዋ። <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>የሱስኒን ክቱን ካብግራ ኡልፍና እማ ሀኦሲክ አማኖሶትዋ፤ ኤሲሲክ አማንቶኒትሴዋ አብድንትሴ ሀኦስታ ስናናዋ።<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>አማኝኒ ሜያክ ኬሽታኒትስ ካይማ ኬናክ ስናናክ ፉቶሲክ አጃጃሞክ ካኒትሶን ካይንትዋ። ኤስ ባሪ ቦርኣ ንቶትና ንቶትና ዛግራ ንብንትስን ኬሽቶሶትዋ። <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>ሄፕሳ ኮንቴሴትስ ሀየዋ ስና ኮእባ ፎንቶኖን ዛግራ ፋፋ ሀኦሲ ካማክ ትሹኖይ ዛላስንታኖ ትሹኒ ዛላስንታዋ። <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>ማፃፋስሲ ማክቴናሲማቶ፦</para>
  <para style="q1" vid="1PE 1:24">«አሱ ዙታምባሴ ኩኒማቶዋ፤</para>
  <para style="q2" vid="1PE 1:24">ኡልፍንባስ ደይ ቡርሁኒ ፉርኣሲማቶዋ፤</para>
  <para style="q2" vid="1PE 1:24">ኩዋስ እችማና፤ ፉርኣስ ደይ ዎቶና።<verse eid="1PE 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="1PE 1:25"/>ስኑንታኖ ዳሚሳ ካማ፤</para>
  <para style="q2" vid="1PE 1:25">ኮእባ ፎንቶኖን ዛግራ ፎና»</para>
  <para style="m" vid="1PE 1:25">ንቶክ ማክቴ ምስራቹኒ ካማስ ኤሲስዋ።<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s1">ሀየዋ ሹነዋ ኮርቶ ዳራስና</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>ኤሴ ማጙ ዉዛሶን ዙትራ፥ ኤሻሶን ዙትራ፥ ስንኖይ ስንነ ቤስቶሶን፥ ኮናሶን፥ ሀማቶሶን ዙትራ ክሲራ ሀኡትዋ። <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>ሀሽ ኮንቴ ዳጋ ናንጎታ ሻቦ ሾሌፋናሲማቶ ንቶ ደይ ፋሩንትስ ድቸት ሀማናክ ካይማ ሀኦሲ ካማኖን ሾሎት። <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>ኤስ ባሮን ደይ ዛጉክ ችማትስ፦ «ዳሚስ ማአሪ ስንባሶን ቤችራ ብያትነዋ» <verse eid="1PE 2:3"/><verse number="4" style="v" sid="1PE 2:4"/>ኤስ ባሪ ቦርኣ ሀየዋ ሹአ ስና ዳም የሱስኒኪ ታእሶት፤ ኤስ ሹኣስ አሱኒ ሜያ ካሽሴሬ ሀእሴቴር፤ ስኑንታኖ ሀኦሲ ስናክ ኡልፍንቶ ዋግባ ፋናርዋ። <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>ዳም የሱስኒኪ ታእሶሶትስ ኤስ ሀየዋ ሹኣሲማቶ አያናኒ ኬያ ስንና ኬቶትክዋ፤ ኤሲሲክ የሱስ ክርስቶስኒኪ ካሞ ግርሱኒ አያናኒ ማአ ሀኦሲክ እማትክ ኮርቶ ማግኒ ሜያ ስናትዋ። <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>ኮርቶ ማፃፋስሲ፦</para>
  <para style="q1" vid="1PE 2:6">«ኤሴ ኮርቶነዋ ኡልፍንቶነ፤</para>
  <para style="q2" vid="1PE 2:6">ስና ካጃስታክ ሹኣሶን፤</para>
  <para style="q2" vid="1PE 2:6">ሲዮኑክ ዱሱናዋ፤</para>
  <para style="q2" vid="1PE 2:6">ባሪክ አማነፌ ባር፤</para>
  <para style="q2" vid="1PE 2:6">እሳንነ ኣፋ ኢቾናዉዛ»</para>
  <para style="m" vid="1PE 2:6">ይስቴራ ትቼዋ።<verse eid="1PE 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7"/>ኤሴ አማነፌ ንቶክ ሀን ሹኣስ ኡልፍንቶዋ፤ ስኑንታኖ አማኖኖይ ባሶክ ማፃፋስሲ፦</para>
  <para style="q1" vid="1PE 2:7">«ሹእኒ ኬያሶን ኬርኤፌ ባሶ፤</para>
  <para style="q2" vid="1PE 2:7">ካሽሴቴ ሹኣስ፤</para>
  <para style="q1" vid="1PE 2:7">ኬያሲክ ካጃኒ ሹአ ስኒ» ይፋዋ።<verse eid="1PE 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1PE 2:8"/>ደይ፦ «አሱኒ ሜያኖን ቱሳሱን ሹአ</para>
  <para style="q2" vid="1PE 2:8">ደይ ጋንሱኒ ካኦ ስኒዋ።»</para>
  <para style="p" vid="1PE 2:8">ኤስ ቱሳሶኔስ ደይ ካምባሶን አጃጃሞ ቤየቴ ቦርአዋ፤ እምቴሴቴስ ኤስ ባሪክዋ።<verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>ስኑንታኖ ታልማስን ዲንቂ ቻሬፍባሲክ ንቶትን ቴጌ ሀኦሲ ዲንቂ ዎስቶኖን አዋሱትክ ኮርቴ ኮንቶ፤ ታቶኒ ማግ፤ ሀኦሲ ኮርቶ ዳራዋ። <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>ንቶ ዜሞ ሀኦሲ ዳራቴዋ፤ ስኑንታኖ ሀሽ ሀኦሲ ዳራዋ። ዜሞ ፋኪያ ኣነ ዳኖዌትዋ፤ ስኑንታኖ ሀሽ ፋኪያ ዳነቲዋ። <verse eid="1PE 2:10"/><verse number="11" style="v" sid="1PE 2:11"/>እንኖ ሜያነ! ሀን ዳስታክ ንቶ እርባ ደይ ጌሮኒ አሱ ስነት ቦርአ ካኒትሶን ኔቤፋ አሽንትሲ ኤናንቶስን ዎካትክ ሺጴፋዉጙዋ። <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>አዉዛክነ፦ «ማጙ ዉዛ ዛግሴ ሜያዋ» ይሴሬ ሀማትሴፌክኑ ሀኦስ ማጝሱኒ ካርኒ ዎኖ አማኖኖይ አሱኒ ሜያ ማአ ዎስቶኒትሶን ቢሴሬ ሀኦሶን ጋላቶሶነክ ባሶ ጋነያሲ ፋፌት ካባሲክ ማአ አማላንት ፎጝዋ። <verse eid="1PE 2:12"/><verse number="13" style="v" sid="1PE 2:13"/>ዳሚሲክዋ እያት ሀእሲፌ ሜያክ አጃጃምቶሶት፤ ኤስ ባርስታን ደይ ንቶስታን ደናሎ ስነቴ ቦርአ ታቴ ሜያክ አጃጃሞት። <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>ዳሶን ሀእሲፌ ባሶክ ደይ አጃጃሞት፤ ኤስ ባሶ ማጙ ዉዛሶን ዛግሴፌ ባሶትን ኬኡሶነክ፤ ማአ ዉዛሶን ዛግሴፌ ባሶትን ሱሶነክ ታቴ ሜኒ ታቶስ ዎሲና ሜያዋ። <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>ኤስ ባሪ ቦርኣ ማአ ዉዛሶን ዛጉክ ጎዋኒ ሜኒ ኬኖይ ዎላሶን ሻኩሶነክ ዛጉትክ ሀኦሲ ፍቃድዋ። <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>ሀኦሲ ዎስትኛኒማቶ ስንና ደይ ብርማዱምማ ኬሳ አሱኒ ሜኒማቶ ፎትታኖ ብርማዱማንቲሶን ማጙ ዉዛሲ ይኑ ዛጉሶትታዋ። <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>አሱ ዙታምባሴ አሲን ኡልፍንሱት፤ አይኒ ሜያኖን ኬሽቶት፥ ሀኦሶን ድጎሶት፥ ታቶስን ኡልፍንሱት።<verse eid="1PE 2:17"/></para>
  <para style="s1">ክርስቶስኒ ሻናሲ ቤሶ</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>ዎስትኛኒ ሜያነ፤ ዳምኒትሳክቶኒን ኡልፍንሱክ አጃጃሞሶትክ ሾልሲፋዋ። ኤስ አጃጃሞትስ ደይ ማአ ሜያክናዋ ጋራም ሜያክና ስኖይናሮን ማጙኒ ሜያክነጝዋ። <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>አሱ ጋላታ ዳንፌናስ ማጝሱኖይ ሻና ኤጴቴፌና ካባሲክ ሀኦሲክዋ እያት ፋኪፋናነዋ። <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>ማጙ ዉዛ ዎስቴፋኒ ኬኦ ካርእን ፋክፋትነ አሮ ጋላታ ዳናትሪንሶ? ስኑንታኖ ማአ ዉዛ ዎስቴፋት ሻና ኤጳ ታፌት ካባሲክ ፋክፋትነ ሀኦስኪን ጋላታ ዳናትዋ። <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>ንቶ ቴግቴትስ ኤስ ባሪክዋ፤ ባሳ ኡግናሲክ ዞኑስቶትክቱ ክርስቶስ ንቶክዋ እያት ሻናሶን ኤጴቴሬ ንቶክ ቤሶ ስኒዋ። <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>ባር እሳ ቦርአ ኣነ ዎስቶዌ፤ ኖኖባስን ደይ ኤሻ ዎላ ኣነ ኬሳ። <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>ባሪን ሜኤፌ ካባሲክ ዎልግሬ ኣነ ሜኤ፤ ሻናሶን ኤጴቴፌና ካባሲክ ፉቶክ ማጝሱ ካርኒ ሀኦሲክቱ ቴትባሶን ኣትሬ እምቴኖ ኣነ ፎኮሮዌ። <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>ቦርኣሲክ ክትራ ኦኮክ ፎኒክ ባር ቴትባሲክ አሽባሲክ እንኖ ቦርኣሶን ሜስቀሊስታ ዎርእ። ባሳ ማዛሲክ ንቶ ፋርሴትዋ። <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>ንቶ ዜሞ ትሽ ፋንቱሲ ማቶ ዮንጃኤት ፋሴትር፤ ስኑንታኖ ሀሽ ካኒትሲ ኬሜር ስና ባርኪናዋ ኦድፌር ስና ባርኪና ዎልሴትዋ።<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s1">ኬኒ አባናዋ ኬርኛአሴ አሲ ቾዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>ኤሲስማቶ ኬርኛአሲክቶነ! ኬኒ አባንቲሳክቶኒክ አጃጃሞት፤ እሳ እሳ ሜያ ሀኦሲ ካማክ አማኖኖር ስንነፌክኑ ካምባሶን ማክሶኖይ ፌሴቴን አሱቤሲሲክቶኒ አማላኪ ዎልሶነዋ። <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>ዎልሶክ ችሞኔስ ካይማ ደይ አሱኒን ኡልፍንሲ ካኒትሶን ብየፋቴነዋ። <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/>ንቶ ጋዳሲ ሶምኒ ሻፕቶ፤ ዋርቄኒ ዬትሬ ኬሹክናዋ ዋግባ ችማ ማምኒ ማያክና ጌሮኪ ቢስቴፋ ዉዛስታ ስናናታዋ። <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>ስኑንታኖ ንቶ ጋዳስ ሀኦሲ ስናክ አካማኖን ኡልፍንቶ ስንና ትሹኖይ ኬሹሲክ ንባማ አያናክ ንብንትስሲ ኣቸራ ፋ ስካሎኪ አቱንትስ ስኑን። <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>ዜሞቲ ካባሲክ አብድቤሲሶን ሀኦስታ ሀእሴ ኮርቶ ማሽካ ሜያ ቴትቤሲሶን ኬሽሴሴቴስ ኤሲስማቶዋ፤ ኬኒ አባሳክቶኒክ ደይ አጃጃሜት ፌሴቴር። <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>ሳራ አብራሀምኒን፦ «ዳምታሶ!» ይት አጃጃሜት ፋር፤ ንቶ ደይ ማአ ዉዛሲክቶኖን ዛግሴፋትነናዋ እሳ ድጋ ፎንቶኖን ስንፋትነና ባሪ ናንጎታዌ። <verse eid="1PE 3:6"/><verse number="7" style="v" sid="1PE 3:7"/>ኤሲስማቶ ኬኒ አባኒ ሜያነ! ኬርኛንትስኔን አነ ያዳታክ ፎሶት፤ ንቶስታን ሆፕያ ቴስቶ ስነቴ ቦርአናዋ ንቶኔን አነ ደይ ካኒ ኦትማሶን ዋራሶሶነር ስንና ቦርአና ኡልፍንሱሶት። ኤሲሲክ ሺጶኒትሶን ቱሳሱኒ ዉዛ ኣፋ ፎና ዉዛ።<verse eid="1PE 3:7"/></para>
  <para style="s1">ማአ ዉዛ ዛግፋት ሻና ኤጳቶሶት</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>ኮእባስታክ ዙታምንትሴ ንቶትና ንቶትና እሳር ስንና ፎሶት፤ ኦሚሳ ራኮኖን ንቶ ቴትኒር ዛግራ ፋዱሶት፤ አይና አይና አሲ ኬሽታናክ ዋል ኬሽቶሶት፤ ኬናሽቴር ደይ ጋራም አሱ ስኖት። <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>ኤቢሱትታኖ ማጙ ዉዛሶን ማጙ ዉዛክ፤ ሜአሶን ደይ ሜአክ ዎልጉትታ፤ ንቶ ቴግቴሴትስ ኤስ ባሮን ዛጉክ ኤባ ዋራሶክዋ።<verse eid="1PE 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1PE 3:10"/>ኮርቶ ማፃፋስሲ ማኬፋናሲማቶ፤</para>
  <para style="q2" vid="1PE 3:10">«ካሶን ሹንፌ ባርናዋ፤</para>
  <para style="q1" vid="1PE 3:10">ማአ ዎናሲክቶኖን</para>
  <para style="q2" vid="1PE 3:10">ብያናክ ሾሌፌ ባርና፤</para>
  <para style="q2" vid="1PE 3:10">ቴሩምባስ ማጙ ዉዛ ዎሎኖይናማቶ፤</para>
  <para style="q2" vid="1PE 3:10">ኖኖባስ ደይ ኤሻ ዉዛ ማኮኖይናማቶ ካሎዋ።<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ማጙ ዉዛስን ዎኮ፤</para>
  <para style="q2" vid="1PE 3:11">ማአ ዉዛሶን ዛጉዎ፤</para>
  <para style="q2" vid="1PE 3:11">ናጋሶን ሾሎዎ ደይ ናጋሲክ ዞኑስቶዎ።<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>ዳሚሳ ኣፋ ኦኮኒ ሜያኪቱ ቢፋ፤</para>
  <para style="q2" vid="1PE 3:12">ኦዶባስ ደይ፤</para>
  <para style="q2" vid="1PE 3:12">ሺጶቤሲሶን ኦዶናክ ጋቾዋ፤</para>
  <para style="q2" vid="1PE 3:12">ስኑንታኖ ማጙ ዉዛሶን ዎስቴሴፌ ባሶስታ፤</para>
  <para style="q2" vid="1PE 3:12">ዳሚስ ግእኒ ስንባሶንቱ ቤሱና።»<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>ማአ ዉዛሲክቶኖን ዎስቶክ ካብፋትነ ኦንሶ ንቶትን ሚርኦኒሪ? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/>ማአ ዉዛ ዛግፋት ሻና ኤጳ ታፋትነ ኤባቱ ዳናትዋ፤ አሱኒ ሜኒ ፎኮራሶን ድጎትታ ደይ ራካቶትታዋ። <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>ክርስቶስኒን ንብንትሲ ኡልፍንሱት፤ ደይ ካንትሲክ ዳምኒት ዛጉት፤ ንቶስሲ ፋ አብዲሲ ቦርአ ንቶትን ማሙሴፌ ባሶክ ዎልጉባ እማትክ ዎንና ዎንና ሆሬሬ ፌር ስንት። ስኑንታኖ ንቶ ዎልጉስ ጋራማክናዋ ኡልፍንሱክና ስኑን። <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>ክርስቶስኒር ስና ዳነቲ ንቶ ማአ ፎንትሶን ማጙኖን ዎል ሌሴፌ ባሶ ኤስ ዎሉምሴቴ ባርክ ኢቾሶነክ ማአ ካኑንት ፎን። <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>ሀኦሲ ፍቃድ ስንናኔን ማጙ ዉዛሶን ዎስቴፋት ሻናኒ ኤጳቶኒትስታን ማአ ዉዛሶን ዎስቴፋት ሻናሶን ኤጳ ታፋትነ ዋያዋ። <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>ክርስቶስ እኖትን ሀኦስኪ ታእሱክ ባር ኦኮ ስንነ ፌጌዶ ኦኮኒ ፎንቶ እንኖ ቦርኣሲክ ሄፕሳ ዎሉኖይናሮን እሳርጋ ሻናሶን ኤጴቴሬ ክትዋ። ባር አሻክ ክት፤ ስኑንታኖ ኮርቶ አያናክ ሀየዉ ስኒ። <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>ኤስ አያናሲክ ታቶኒ ኬር ሀምሜ ታቴራ ፋሴ ካሲክቶክ ምስራቹኒ ካማሶን አዋሲ። <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>ኤስ ታቶኒ ኬር ፌሴ ካኒ ሜያ ዜሞቲ ኖህኒ ነያሲክ ሜርኬቢስ ሆሱስቴፋና ካባሲክ ሀኦስ ፋኪያክ ኦድፌን ኣፋ አጃጃሞኒዉዛ ይሴ ባሶዋ። ኤስ ሜርኬቢስሲ ግሪሬ አካስኪካሞ ፉእቴ ባሶ ፋድቤሲስ ናጝሪን ስንኒ ጋሮ አሱኒ ሜያ ኮእቤስዋ። <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>ኤስ አካስ ሀሽ ሀጵቁኒ ቤሶ ስንና ንቶትን ፉኦኒርዋ። ኤስ ባር ደይ አቱስታኪ ኪናሶን ካይኑክ ስኖይናሮን ካይማ ካኑኒ ዳናክ ሀኦሲ ስና ግሩኒ ቴያስዋ። ፋቱናስ ደይ የሱስ ክርስቶስን ክቱን ካቡስስኪ ካሞዋ። <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ባር ደይ ደን ሳማ ሀምሜ ሀኦሲ ኦእታ ቴሻስታቱ ፌዋ። ሀኦሲ ዎስያንክቶነዋ ሀእሱኒ ሁግናቤስ ፋና ባሶ ዙታምቤሲሴ ባሳ ሲካሎሲ ሀእሴሴቴዋ።<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s1">ኮርቶ ስንነ ፎ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>ክርስቶስ አሽባሲክ ሻናሶን ኤጴ ቴ ስንና ቦርአ ንቶ ደይ ኤስ ሳፋራሲክ ችምማ ሆሮት። አሽባሲክ ሻናሶን ኤጴቴ አሱ ቦርኣስሲዎስቶኖን ዬትዋ። <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>ሀንኔን ኤካሎክ ሀን ዳስታክ ፉእቴ ፎሲክ አሽኒ ማጙ ኤናንቶሲ ሳፋራኖን ዛጉክ ስኖይናሮን ሀኦሲ ፍቃድኖን ዛጉክዋ። <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>አዛብኒ ሜያ ዛግሴፌይሲማቶ ጋፎ ፎክ፤ እጉክ፤ ኡሼ ዛዎክ፤ ስንኖይ ያሆክ፥ ሆሬ ኡባ ፎንቶኖን ኡሼ ሱሩክናዋ ኢቹ ስና ኮልኦኒ ሺጶክና ዜሞቲ ኣትሴት ነያስ ሆሮናዋ። <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>ኤስ ኢቹ ዉዛሲክቶኖን ዛጉክ ባሶኔን አነ ዎእቶ ቤይንትሲክ ዲንቀሴፌ ደይ ሱንኒትሶን ማጝስሴፌ። <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>ስኑንታኖ ካክ ፌሴ ባሶስታናዋ ክት ባሶስታና ማጝሱ ካርአናክ ሆሬሬ ፌ ባሪክ ዎልጉባሶን እሞነርዋ። <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>ኪት ባሶክነን ምስራቹኒ ካማስ ማክቴናስ ኤስ ባሪ ቦርኣዋ። ኤስ ባሪክ አሽቤሲስታ አሱ ዙታምባሴ አሲስታ ማጝሱ ካቴፋናሲማቶ ባሶስታ ደይ ማጝሱ ካቶኒርዋ። ስኑንታኖ አያናቤሲሲክ ሀኦስ ፋፋና ፎስነ ፋሮን ካክ ፎሶነ። <verse eid="1PE 4:6"/><verse number="7" style="v" sid="1PE 4:7"/>ኤሴ ዙታምባሴ አሲ ኮኣስ ታእሴዋ፤ ጉዝሬ ሺጶ ችማትክ ንባማ ካኑንት ፎጝዋ፤ ቴትንትሶን ሀእስር ስኒት። <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>ኬሽታናሲ ሾዎ ቦርኣሶን ኡካር ስንና ቦርአ ዙታምባሴ አሲስታን ንቶትና ንቶትና ንብንትስን ዎል ኬሽቶት። <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>ኡኙኖይ ንቶትና ንቶትና እርባኒ ኤጳቶት። <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>ሾዎ ቴሳ ሀኦሲ ኦትማኒ እማኖን አማናምቶ ዎስትኛኒማቶ ስንነ እሳርባ እሳርባስ ኤስ ባሪክ እምቴ ሀኦሲ ኦትማክ ኦሚሲክ ዎስቶዎዋ። <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>ንቶስን አስፌ ባር ሀኦሲ ካማኖን አሱዎ፤ ሀኦሲክ ዎስቴፌ ባር ሀኦስ ባሪክ እምና ሁግናሲክ ዎስቶዎ። ኤሲሲክ ሀኦስ የሱስ ክርስቶስኒኪ ካሞ ቾዋ ዙታምባሴ አሲክ ሀኦስ ኡልፍንቶና። ኡልፍናሴዋ ሁግናሴ ኮእባ ፎንቶኖን ባሪክ ስንፋውጝ፥ ኣሚን።<verse eid="1PE 4:11"/></para>
  <para style="s1">ሻናስሲ ችሜ የሮ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>እንኖ ሜያነ! ጌኒማቶ ንቶትን ፋታኖኒ ሻና ኤጳ ታፌት ካባሲክ አርቶኖይ እርባ ዉዛ ንቶስታ ካርናርነ ፋሮን ዛግራ ዲንቆትታዋ። <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>ክርስቶስ ኡልፍናባሲክ ዎል ሌ ዬፌና ካባ አካማኖን ግሮትክ ባሳ ሻናሶን ሃኤር ስነት ቦርአ ግሮትዋ። <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>ክርስቶስኒ ሱናሲክ አሱ ንቶትን ሜእፋናነ ኡልፍናኒ አያና ስና ሀኦሲ አያና ንቶስታ ኬሮኒር ስንና ቦርአ ግሮትዋ። <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>ንቶስን ኦኑ ሻናሶን ኤጴቴፌ ባር ካ ዎሪር ወደይ ዊስ ወደይ ማጙ ዉዛ ዎስቴር ወደይ አሱኒ ቾዉስሲ ግሪር ስንነ ሻና ኤጴቶናታዋ። <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>ክርስታና ስንና ቦርአ ሻና ባሳስታ ካርፋናነ ኤስ ባሪክ ሀኦሶን ጋላቶዎቴኖ ኢቾናኣታዋ። <verse eid="1PE 4:16"/><verse number="17" style="v" sid="1PE 4:17"/>ማጝሱ ካቶና ዎናስ ካርእዋ። ኤስ ማጝሱኒ ካቶናስ ደይ ሀኦኒ አሱሳታዋ። ኤኪን ኤስ ማጝሱኒ ካርኣስ እኖኪን ካቡኒር ስንናኔን ምስራቹኒ ካማሲክ አጃጃምቶኖይ አሱኒ ሜኒ ኮኣስ አዉ ስኑንጋሶ? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>ኮርቶ ማፃፋስ ማኬፋናሲማቶ፦</para>
  <para style="q1" vid="1PE 4:18">«ኦኮስኑ ፋሩክ ችማናስ፤</para>
  <para style="q2" vid="1PE 4:18">ራኮክ ስንናኔን፤</para>
  <para style="q2" vid="1PE 4:18">ኑሪፌ ባሶናዋ፤</para>
  <para style="q2" vid="1PE 4:18">ቦርእኛኒ ሜና ኣካ ስኑንጎሶ?»<verse eid="1PE 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19"/>ኤስ ባሪ ቦርኣ አማናምቶ ስንና ቴሲ ባሪ ፍቃድኒማቶ ሻና ኤጲጴ ቴሴፌ ባሶ ዙታምቤሲሴ ካቤሲሶን አማናምቶ ሀኦሲክ አዳራ እማት ማአ ዉዛሶን ዛግት ፎስታን ኦርፎ ዎልሶኔታዋ።<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s1">ሀኦሲ ዳራኒን ሀእሲፌ ባሶክ እምቴ ኪቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>ኤሴ ባሶኔን አነ ቤቴክርስታኒን ኩርኡ ስና ታ ደይ ክርስቶስኒ ሻናሲ ዛል ስና ታ ኤሲስማቶ ደይ ሀንኔንት አምማኖን ቤስቶኒ ኡልፍናሶን ሃኣኦኒ ታ ንቶ ጋነያሲ ፌሴ ቤቴክርስታኒን ኩርኡኒ ሜያኖን ኪትፋዉጝዋ። <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/>አዳራክ ንቶክ እምቴ ዎዶሶን ኦድትዋ፤ ኤስ ዎዶሶን ኦዳቲስ ግድክ ስንኖይናሮን ሀኦሲ ፍቃድኒማቶ ሹናክታኖ፤ ብርኒ ጆራክ ስንኖይናሮን ሀኦሲክ ዎስቶክ ፋ ማአ ሳፋራኒትሲክ ስኑንዋ። <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>ኤሲስማቶ አዳራክ ንቶክ እምቴ ዎዶሲክ ንቶ ባሶክ ማአ ቤሶ ስናቲስታኖ ባሶስታ ሀእሱኒ ሁግናንትሶን ቤሱክ ስናናታዋ። <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>ኤካ ዛግፋትነ ኬሜሪሳ ጋኛ ዎል ሌ ዬፌና ካባሲክ ትሹኖይ ኡልፍንኒ አክልሊሶን ኤጳቶሶትዋ። <verse eid="1PE 5:4"/><verse number="5" style="v" sid="1PE 5:5"/>ኤሲስማቶ ንቶ ናኦኒ ሜያነ፤ ጋይማ ሜያክ አጃጃሞሶት፤ ዙታምንትሴ ቴትኒ ዳ ኤጳሶን ማማ ዛግራ ማይፋት እሳይስ ኦሚሲክ አጃጃሞዎ።</para>
  <para style="q1" vid="1PE 5:5">«ሀኦስ ቤጋንቴፌ ባሶትን ኦምቴር፤</para>
  <para style="q2" vid="1PE 5:5">ስኑንታኖ ጋራምኒ ሜያክ ባሪ ኦትማኣሶን እማር»</para>
  <para style="m" vid="1PE 5:5">ይስቴራ ትቼዋ።<verse eid="1PE 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 5:6"/>ኤስ ባሪ ቦርኣ ባር ይና ዎናስታክ ንቶትን ደን ቴጉናክ ሁግናባ ፋና ሀኦሲ ኩሹኒ ሲካሎሲ ቴትንትሶን ዳ ኤጵትዋ። <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>ባር ንቶክ ሳፋሬር ስንና ቦርአ ንቶትን ራክሲፋ ዉዛሲክቶኖን ዙትራ ባሪስታ ሀኡት። <verse eid="1PE 5:7"/><verse number="8" style="v" sid="1PE 5:8"/>እኖክ ፋዪስ ሆሮና ኡክ ፎቲ፤ ደይ ጉዙት፤ ጉማኒት ስና ዳቡሎስ ኤጴ ኮርአናክ ሾሌፋት ቡርፌ ኤቶሳማቶ ብራቶንቲስታ ብራቴድፌር። <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>ሀን ዳ ዙታምባሴ አሲስታ ፌሴ አይኒትሳክቶ ኤስ ኤፋቴና ሻናሶን ኤጴቶሶነ ባሮን አሪፋት አማንቶክ ችምማ ጉዎት። <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>ጋሮ ዎኒሮን ሻናሶን ኤጳ ታሴትኔን ኦርፎ ክርስቶስኒኪ ካሞ ኮእባ ፎንቶ ኡልፍናስኪ ንቶትን ቴጌ ኦትማ ዙታምባሴ አሲ ሀኦ ስና ባር ኤጳ ታሴት ሻናሲን ንቶትን ፉኦና፤ ቴባና፤ ችኑና ደይ ዛጉና። <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ኮእባኔን ኮእባ ፎንቶኖን ሀእሱኒ ሁግናስ ባሪክ ስንፋውጝ፤ ኣሚን።<verse eid="1PE 5:11"/></para>
  <para style="s1">ኮእኒ ናጋኒ ኦሽሾ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>አማናምቶ አይዋ ይራ ሳፋሬፋና ስልዋኖስኒኪ ካሞ ሀን ዎሲያሶን ካዉንሲራ ንቶክ ትችጝዋ። ትችናስ ደይ ንቶትን ኪቱናክናዋ ሀን ባርር ፉቶኒ ሀኦሲ ኦትማ ስንባሶን ንቶክ ኮትታ ማኮናዋ እያትዋ፤ ኤስ ባሪ ቦርኣ ሀን ሀኦሲ ኦትማክ ችንማ የሮትዋ። <verse eid="1PE 5:12"/><verse number="13" style="v" sid="1PE 5:13"/>ንቶሲማቶ ኮርቴራ ፋ ባብሎንኪ ቤቴክርስታኒስ ንትቶክ ናጋ ኦሽሼድፋዋ፤ ናታ ማርቆስ ደይ ንቶክ ናጋ ኦሽሼድፌዋ። <verse eid="1PE 5:13"/><verse number="14" style="v" sid="1PE 5:14"/>ክርስታናኒ ሜኒ ኬሽታናሲክ ንቶትና ንቶትና ዳሜት ናጋ ኦሽሾሶት፤ ክርስቶስኒር ስና ንቶ ዙታምንትሴ አሲክ ናጋ ስንፋውጝዋ።<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
