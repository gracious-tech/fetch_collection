<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">-Yemsa New Testament</book>
  <para style="h">እብራዊ</para>
  <para style="toc1">እብራዊኒ ሜያክ ዎስቴ ዎስያ</para>
  <para style="toc2">እብራዊ</para>
  <para style="toc3">እብራ.</para>
  <para style="mt1">እብራዊኒ ሜያክ ዎስቴ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ሀን ዎሲያስ ትቼናስ አማኝኒ ሜያስታ አካማ ቱጋኦ ካርና ቦርአ አማንቶቤሲሶን ቤዮኖይቴማቶ ቴትኒትሶን አሩቲ ኡክናዋ ችኑክዋ፤ ሀን ትቻሶን ትች ባር እብራዊኒ ሜኒ አማኝኒ ሜያክ የሱስ ክርስቶስ ፉቶ ደይ ሀኦሶን አምማኖን ኬስሬ ቤስር ስኒባሶን ቤሱናክ። ኤስ አማኝኒ ሜያ አማንቶቤሲሲክ ዛጉሶነክ ባሶትን ችኒድፌር። ኤስ ባሮን ደይ ዛግፌና ካባሲክ ኬዝ ፉቶ አምማኖን ክስሬ ቤሲ፦</para>
  <para style="ili">1. ኤጴቴና ሻናሲኪ ካሞ አባሲክ ፉቶክ አጃጃምቴር ስና የሱስ ኮእባ ፎንቶ ሀኦኒ ናዋ። ሀኦኒ ና ስንባሲክ ኩርኡ ቴያኒ ካማሲ ራጁኒ ሜያ፤ ሙሴኒስታንናዋ ሀኦሲ ዎስያሲክቶታንና ባር አካማኖን ደናሎዋ።</para>
  <para style="ili">2. የሱስ ኩርኡ ቴያኒ ካማሲ ማግኒ ሜያስታን አካማኖን ደናሎ ስና ኮእባ ፎንቶ ማግ ስንባሶን ሀኦስ ቴትባሲክ ማኬዋ።</para>
  <para style="ili">3. የሱስኒኪ ካሞ አማኝኒ ሜያ ቦርኣስን፥ ድጋስንናዋ ክቱስንና ፉእቶሶነ። የሱስ ማግኒ ሜኒ ማግ ስንባሲክ እብራዊኒ ሜኒ አማንቶሲክናዋ ስትሪሲክና ካባሬ የሬ ዋግኒ ማኣስ ይራራኒማቶ ስንና ቢስቴት ፋ ፋሩስ ፉቶ ስናናክ ዛግ።</para>
  <para style="ip">ሀን ትቻሶን ትች ባር እስራኤልኒ ሜኒ ቶቾሲክ አርቶ ስንና አሱኒ ሜኒ አማንቶሶን ቤሶ ዛግሬ ኬአክ (ኤድዴ 11) ፌሬትሴፌ አሱኒ ሜያ አማንቶቤሲሲክ ዛጉሶነክ ያዳስድፌር። ኤሲስማቶ ኤድደ 12 ፌሬትሴፌ አሱኒ ሜያ ኣፍቤሲሶን የሱስኒስታ ዛጉክ አማንቶቤሲሲክ ዛጉሶነክናዋ ኣፋ ሻነዋ ራኮነ ባሶስታ ካርፋና ካባሲክ ፋኩሶነክቱ ኪትፌ። ኮእባስታክ ደይ ኪቶነዋ ቴትኒትሶን ኦድት ይፋ ካምነ ማኮክ ዎሲባሶን ኮርእ።</para>
  <para style="iot">ማፃፋሲ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ ሀኦስ ክርስቶስኒኪ ካሞ አምማኖን ቤስቶባስ <char style="ior"><ref loc="HEB 1:1-3">1:1-3</ref> </char></para>
  <para style="io1">ክርስቶስ ሀኦሲ ዎስያንክቶታኒ ደናሎ ስንናማቶ <char style="ior"><ref loc="HEB 1:4-2:18">1:4—2:18</ref> </char></para>
  <para style="io1">ክርስቶስ ሙሴኒስታንናዋ እያሱኒስታንና ደናሎ ስንናማቶ <char style="ior"><ref loc="HEB 3:1-4:13">3:1—4:13</ref> </char></para>
  <para style="io1">ክርስቶስ ማግሳታን ደናሎ ስኒባስ <char style="ior"><ref loc="HEB 4:14-7:28">4:14—7:28</ref> </char></para>
  <para style="io1">ክርስቶስኒ ቴያኒ ካማስ ደናሎ ስንናማቶ <char style="ior"><ref loc="HEB 8:1-9:22">8:1—9:22</ref> </char></para>
  <para style="io1">ክርስቶስኒ ማአ ስናስ አርክራ ቤስቴ፤ <char style="ior"><ref loc="HEB 9:23-10:39">9:23—10:39</ref> </char></para>
  <para style="io1">አማንቶሲ አካማ ስና <char style="ior"><ref loc="HEB 11:1-12:29">11:1—12:29</ref> </char></para>
  <para style="io1">ሀኦሶን ግርሱ <char style="ior"><ref loc="HEB 13:1-19">13:1-19</ref> </char></para>
  <para style="io1">ኮእኒ ሺጶ <char style="ior"><ref loc="HEB 13:20-21">13:20-21</ref> </char></para>
  <para style="io1">ኮርኡባ <char style="ior"><ref loc="HEB 13:22-25">13:22-25</ref> </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ሀኦስ ናዉባስኪ ካሞ ማኬ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ሀኦስ ዜሞቲ ነያሲ ሾዎ ኡግናክ፤ ራጁኒ ሜያኪ ካሞ እንኖ አባኒ ሜያክ ሾዎ ካባ ማኬት ፋር። <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ስኑንታኖ ሀሽ ኦርፎቲ ነያሲ ዙታምባሴ አሲን ዋራሶኒር ዛግና ናዉባሲኪ ካሞ እኖክ ማኬ። ሀን ዳሶን ደይ ዙታምባሴ አሲን ቴሲናስ ባሪክዋ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ባር ሀኦሲ ኡልፍናኖን ፓልፓልግሬ ቤሲር። ባር ሃላባሲክ ሀኦስኔን አነ ማእስሬ እሳርዋ። ካምባሲ ሁግናክ ሀን ዳሶን ዙትሬ ቴቤ ኤጲዋ፥ አሱኒ ሜያኖን ደይ ቦርቤሲስን ካይምስንናኔን ኦርፎ ሳማኪ ሁግናባ ፋና ሀኦሲ ሆእታ ዲ።<verse eid="HEB 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ባሪክ እምቴ ሱናስ ሀኦሲ ዎስያኒ ሱንታን ደናሎ ስንናማቶ ሀኦሲ ና ሀኦሲ ዎሲያታን አካማኖን ደናሎዋ።<verse eid="HEB 1:4"/></para>
  <para style="s1">ሀኦሲ ና ሀኦሲ ዎሲያታን አካማኖን ደናሎ</para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 1:5"/>ሀኦሲ ባሪ ዎሲያሲ ጋነያስን፦</para>
  <para style="q2" vid="HEB 1:5">«ነ ናታዋ፤</para>
  <para style="q2" vid="HEB 1:5">ሀውጙ ኔን ኮኒን»</para>
  <para style="q2" vid="HEB 1:5">ሄፕሳ ደይ፦ «ታ ባሪክ አባ ስናና፤</para>
  <para style="q2" vid="HEB 1:5">ባር ደይ ታክ ናታ ስናና»</para>
  <para style="q2" vid="HEB 1:5">ይናስ ኦንኒንሶ?<verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>ሀኦስ ኡዛ ናዉባስን፤</para>
  <para style="q2" vid="HEB 1:6">ሀን ዳስታክ ዎሲፋና ካባሲክ፤</para>
  <para style="q1" vid="HEB 1:6">«ሀኦሲ ዎሲያ ዙቴራ፤</para>
  <para style="q2" vid="HEB 1:6">ባሪክ ሳጋዶና» ይፋዋ።<verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>ስኑንታኖ ሀኦሲ ዎስያኒ ቾዋሲክ፤</para>
  <para style="q2" vid="HEB 1:7">ደይ፦ «ሀኦስ ዎሲያኒክቶኖን አያናኒክቶ፤</para>
  <para style="q2" vid="HEB 1:7">ሀኦሲክ ዎስቴሴፌ ባሶትን፤</para>
  <para style="q2" vid="HEB 1:7">ደይ ጌኒ ውኖኒክቶ ዛጉኒር» ይፋዋ።<verse eid="HEB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 1:8"/>ስኑንታኖ ናሳ ቾዋክ፤</para>
  <para style="q2" vid="HEB 1:8">«ሀኦሴ፤ ዝግሞኔስ ኮእባ ፎንቶኖን ፎኒር፤</para>
  <para style="q2" vid="HEB 1:8">ታቶኔስ ደይ ኦኮኒ ሃሮ።<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ኦኮሶን ሹኒት፤ ማንጉሶን ደይ ኦምቴት፤</para>
  <para style="q2" vid="HEB 1:9">ኤስ ባሪ ቦርኣ ዳማ ሀኦኔስ፤</para>
  <para style="q2" vid="HEB 1:9">ዞሞኔሳታን ደናሎኖን ግራ፤</para>
  <para style="q2" vid="HEB 1:9">ሙዳክ ኔን ሙድ» ይፋ።<verse eid="HEB 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10"/>ኤሲስማቶ ደይ፦</para>
  <para style="q2" vid="HEB 1:10">«ዳሚሶ! ነ ዜምማ ዳሶን ቴሲትዋ፤</para>
  <para style="q2" vid="HEB 1:10">ሳማሲክቶ ደይ ኩሹኔሲ ዎስቶዋ።<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>ኤስ ባርኪቶ ዙቴራ ትሹኒር፤</para>
  <para style="q2" vid="HEB 1:11">ስኑንታኖ ነ ፎታር፤</para>
  <para style="q2" vid="HEB 1:11">ዙታምባሴ ማምኒማቶ ኩርኡና።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ማምኒማቶ ደይ ዛግራ ብሩታ፤</para>
  <para style="q2" vid="HEB 1:12">ባርኪቶ ደይ ማምኒማቶ ስንና ሶልቶና፤</para>
  <para style="q2" vid="HEB 1:12">ስኑንታኖ ነ ኣጌነ ኣጌነ ስንፋናክ፤</para>
  <para style="q2" vid="HEB 1:12">ነ ነኔሲክ ኮእባ ኣፋ» ይፋ።<verse eid="HEB 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13"/>ሀኦስ ባሪ ዎስያሲክቶኒ ጋነያስን፦</para>
  <para style="q1" vid="HEB 1:13">«ጉማኔሳክቶኒን ዎቾኔሲ፤</para>
  <para style="q2" vid="HEB 1:13">ስካሎሲ ዛጉና ካባኔን፤</para>
  <para style="q2" vid="HEB 1:13">ታ ሆእታ ቴሻስታ ዱዋ»</para>
  <para style="m" vid="HEB 1:13">ይናስ ኦንኒንሶ?<verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>ኤካን ሀኦሲ ዎሲያ ዙቴራ ፋሩኒ አሱኒ ሜያክ ዎስቶናክ ዎስቴራ ያ ሀኦኒ ዎስትኛ ስና አያናኒክቶታኖሶ?<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">ዳንኒ ፋሩሶን ማእስራ ኦዳኒክቱ ሾልስፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ኤስ ባሪ ቦርኣ ኦዴኒ ቾዋስታን ሞርኦሬራ ጋንዶኖይኒማቶ ኦዴኒ ዉዛሲ ቾዋኖን ማእስራ ኦዳኒክ ሾልሱዋ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ሀኦሲ ዎስያኪ ካሞ ማክቴ ካማስ ፉቶ ስኒዋ። ኤስ ካማሶን ኣትፌ ባርናዋ ሀን ካማሲክ አጃጃምቶኖይ ባርና ሾልሱ ኬኦሶን ኤጴቶና። <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ኤኪን እንኖ ሀን አካማ ፋሩሶን አርፋት ቤይፋንነ ኣካክ ኣታ ኬሳክ ችማኒሪንሶ? ሀን ፋሩሶን ዜምሜ ማኬስ ዳሚስዋ። ባርኪን ኦዴ አሱኒ ሜያ ሀን ባሮንኑ ጋሳሲሴሬ ማክሴቴዋ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ሀኦስ ደይ ማላቶሲክቶኖን፤ ዲንቂ ቾዋሲክቶኖን፤ ሾዎ ቴሳ ቢስቴራ አርቶኖይ ዉዛሲክቶኖን ዛጉክናዋ ባር ፍቃዲሲማቶ እምቴ ኮርቶ አያናሶን እማክ ባሶ ዛላስ ፉቶ ስኒባሶን ቤሲዋ።<verse eid="HEB 2:4"/></para>
  <para style="s1">አሱኒ ዛላ ዙታምባሴ አሲክ ፋሩኒ ዞንሲ ስናስ የሱስዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ሀኦሲ ሀኔንቲ ዮኒ ባሮን ሀን ዎል ሌት ፋኒ ዳሶን ሀኦሲ ዎሲያ ሀእሱናክ ኣነ ዛጉዋ። <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ኤሲስማቶ እሳ ድምታ ኤካ ይስቴ፦</para>
  <para style="q1" vid="HEB 2:6">«ነ ባሪክ ሳፋሮታክ አሱ ኣምቤንሶ?</para>
  <para style="q2" vid="HEB 2:6">ባሪን ደይ ኦዳታክ አሱኒ ና ኣምቤንሶ?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ጋሮ ዎኒሮን ሀኦሲ ዎሲያታን ሀቴስት፤</para>
  <para style="q2" vid="HEB 2:7">ኡልፍንነዋ ጋላትነ አሲ ዛዉድ ጉፍስት፤<verse eid="HEB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8"/>ዙታምባሴ አሲን፤</para>
  <para style="q2" vid="HEB 2:8">ባሳ ሀእሱሲ ስካሎስ ዛግት።»</para>
  <para style="p" vid="HEB 2:8">ዙታምባሴ አሲን ባሳ ሀእሱሲ ስካሎሲ ዛግፋና ካባሲክ ባሳ ሀእሱሲ ስካሎሲ ዛጉኖይ ፉኤናር እሳ ዉዝነ ኣፋዋ። ስኑንታኖ ሀሽቲ ፋ ባር ዙታምባሴ ባሳ ሀእሱሲ ስካሎሲ ስንናማቶ ሀሽኑ ኣነ ብየኒዋ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ስኑንታኖ ሀሽ ሀኦሲ ዎሲያታን ጋሮ ዎኒሮን ሀቴሬ ፌ ባሪን ክቱኒ ሻናሶን ኤጴቴና ቦርአ ኡልፍንነዋ ጋላትኒ ዛዉድነ አሲን ጉፌ የሱስኒን ብያኒ። ባር ሀኦሲ ኦትማክ እንኖ ዙታምኒሴ አሲክ ኪትዋ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ዉዛ ዙታምባሴ ባሪክናዋ ባሳርና ስንና ቴስቴናስ ሀኦሲ ሾዎ ናንጎታ ሀጝ ኡልፍናሲክ ኤጳ ዮናክ ባሶ ፋሩስ ዞንሲ ስና የሱስ ሻናሲክ ማእስሬ ዛግ ስንነ የሮናክ ሾልሲዋ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>አሱኒ ሜያኖን ኮርቶ ዛግፋ ባሬዋ ባሪክ ኮርቶ ስና አሱኒ ሜያ ደይ እሳ አባኒ ናንጎትዋ። ኤስ ባሪ ቦርኣ የሱስ ባሶትን፦ «አይታሳክቶኖ!» ይሬ ቴጎናክ ኣነ ኢቼፌ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ኤሲሲክ ኮርቶ ማፃፋስሲ፦</para>
  <para style="q1" vid="HEB 2:12">«ሱኔሶን አይታሳክቶኒክ ማኮናዋ፤</para>
  <para style="q2" vid="HEB 2:12">ማባራሲ ጋነሲ ቴቾክ ጋላቶናዋ» ይፋዋ።<verse eid="HEB 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13"/>ኤሲስማቶ ደይ፦ «አማንቶናሶን ባሳስታ ሀእኡናዋ» ይፋ።</para>
  <para style="p" vid="HEB 2:13">ሄፕሳ ደይ፦ «ኤሴ ታናዋ ሀኦስ ታክ እምና ናንጎትናሴ ሀንታ ፋኒዋ» ይፋዋ።<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ኤስ ባሪ ቦርኣ ሀን ናንጎታሲክቶ ሀሪንባሬዋ አሽባሬ ፋና አሱ ሲነቴ ቦርአቱ የሱስ ደይ ባሶሲማቶ አሱ ስኒ። ኤስ ባሮን ዛግናስ ክቱባስኪ ካሞ ክቱስታ ሀእሱኒ ሁግናባ ፋና ዳቡሎስኒን ትሽኩናክዋ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ኤሲስማቶኑ ኪቱሶን ድግሴቴ ቦርአ ኔቤሲሶን ዙትሬ ቦዞሲ ስካሎሲ ፌሴ ባሶትን ብርማዱምማ ክሱናክዋ። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>የሱስ አርጋሱናክ ሾሌናስ ሀኦሲ ዎሲያኖን ስንኖይናሮን አብራሀምኒ ዛላሶን ስንባስ አምማዋ። <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ኤስ ባሪ ቦርኣቱ ዉዛ ዙታምባሴ አሲክ አይባሳክቶኒማቶ ስናናክ ሾልሲ። ኤስ ባሪክ አሱኒ ሜኒ ቦርኣሶን ትሽኩኒ ማአ እምሜ ሀኦሲክ ዎስቶክ አማናምቶናዋ ፋኪ ማግኒ ጋኝኜ ሜኒ ጋኛና ስኒዋ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ባር ቴትባሲክ ፋታንቴሬ ሻናሶን ኤጴቴና ቦርአ ፋታንቴሴፌ ባሶትን አርጋሱናክ ችማናዋ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱስ ሙሴኒስታን ደናሎ ስንናማቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ኤስ ባሪ ቦርኣ ሳማኪ ቴግቶሶን ሃኦኒር ስና ኮርቶ አይታሳክቶኖ! አማንቶኒሲ ዎሲ ስና ባሪንናዋ ማግኒ ጋኝኜ ሜኒ ጋኛ ስና የሱስኒንና ሳፋሮትዋ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሴ ሀኦሲ ኬያ ዙታምባሴ አሲስታ አማናምቶ ስንናማቶ የሱስ ደይ ባሪን ታትሲ ሀኦሲክ አማናምቶዋ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ኬያሶን ኬርእፌ ባር ኬያስታን ደናሎኖን ኡልፍንባ ፋናማቶ የሱስኒክ ደይ ሙሴኒስታን ደናሎኖን ኡልፍና ሾልሲርዋ። <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ፉቶሲክ ኬያ እሳርባ እሳርባሲክ ባሮን ኬርአ አሱባ ፌርዋ። ስኑንታኖ ዙታምባሴ አሲን ኬርኣስ ሀኦስዋ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ሀኔንቲ ማክቶኒ ዉዛሲክ ዛላ ስናናክ ሙሴ ሀኦሲ ኬያ ዙታምባሴ አሲስታ ዎስትኛኒማቶ አማናምቶ ስንነ ፌር። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ስኑንታኖ ክርስቶስ ሀኦሲ ኬሩክ አማናምቶ ስንናስ ናኒማቶ ስንነዋ። ኤስ ኬያስ ደይ እኖዋ። ባሪ ኬያ ስናኒስ አማነፌኒ ዉዛሴዋ ቴቴፌኒ አብዲሴ አሲን ማእስራ ኤጵፋኒነዋ።<verse eid="HEB 3:6"/></para>
  <para style="s1">ሀኦኒ አሱኒክ እምቴ ኬኦኒ ኪቶ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ኤስ ባሪ ቦርኣ ኮርቶ አያናስ ማኬፋናሲማቶ፦</para>
  <para style="q1" vid="HEB 3:7">«ሀሽ ሀውጙ ካምባሶን ኦደፌት ካባሲክ፤<verse eid="HEB 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8"/>ዛቦሲክ ፋታንቴፌቲ ካባሲክ፤</para>
  <para style="q2" vid="HEB 3:8">ማጙክ ታይስታ ካብሴቴይሲማቶ፤</para>
  <para style="q2" vid="HEB 3:8">ንብኒትሶን ኤጴቶ ቤያር ዛጉትታ።<verse eid="HEB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9"/>ኤስ ካባሲክ ዜሞቲ አባንቲሳክቶ ታን ፋታነሴቴ፤</para>
  <para style="q2" vid="HEB 3:9">ደይ ታን ቱእኒሴቴ፤</para>
  <para style="q1" vid="HEB 3:9">አቼቻስር ዎግጋ ዛግና ባሮን ደይ ብየቴ»</para>
  <para style="m" vid="HEB 3:9">ይፋዋ ሀኦስ።<verse eid="HEB 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>«ኤስ ባሪ ቦርኣ ኤስ ኮኒቶስታ ሃሬን፦</para>
  <para style="q2" vid="HEB 3:10">‹ንብቤሲስ ዎንና ዎንና ዳጌቱ ፋፋ፤</para>
  <para style="q2" vid="HEB 3:10">ኡጉናሶን ደይ ኣነ አርሶቶ› ይጝዋ።»<verse eid="HEB 3:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="HEB 3:11"/>ደይ፦</para>
  <para style="q1" vid="HEB 3:11">« ‹ታ ባሶክ እማናክ ፋ ቤይሳኒ ድማስታ፤</para>
  <para style="q2" vid="HEB 3:11">እሳንነ ኣፋ ግርሶነ ዉዛ!› ይራ፤</para>
  <para style="q2" vid="HEB 3:11">ግእናሲክ ቴይጝዋ» ይ።<verse eid="HEB 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12"/>አይታሳክቶኖ! ንቶ ጋነያስን ኦኑ ሀየዋ ሀኦስታን ዎክሱኒ ማጙነዋ አማኖኖይ ንብነ ፎኖይናማቶ ቴትኒትሶን ኦድትዋ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ኤስ ባሪስታን ደናሎ ንቶስን ቦርኣሲክ ኤሽቴሬ ንባሶን ኤጳ ቶ ቤያር ዛጉኖይናማቶ፦ «ሀሽ ሀውጙ» ይስቴራ ቴግቴ ዎናስ ፋና ካባሲክ ዎንና ዎንና ሜርኮትዋ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>ቴሱስታኪ ፋ አማንቶኒሶን ሀማ ኮእባስታ ካርአና ካባኔን ዛግራ ኤጵፋንነ ክርስቶስኔን አነ ዋራሴርቱ ሲናኒዋ።<verse eid="HEB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HEB 3:15"/>ኤሲስ ደይ፦</para>
  <para style="q2" vid="HEB 3:15">«ሀሽ ሀውጙ ካምባሶን ኦደፌቲ ካባሲክ፤</para>
  <para style="q2" vid="HEB 3:15">ኤስ ኑሪፌት ካባሲክ ዛግሴትስነ ፋሮን፤</para>
  <para style="q2" vid="HEB 3:15">ንብንትሶን ኤጳ ቶ ቤያር ዛጉትታዋ»</para>
  <para style="m" vid="HEB 3:15">ይስቴራ ማክቴናሲማቶዋ።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ኤካ ኤስ ባሶ ካምባሶን ኦደሴቴኔን ኦርፎ ኑሪስ ኦና ኦናንሶ? ኤስ ባሶ ሙሴ ዞንስን ግጵጽኒ ዳስታን ኬሳ ባሶ ዙቴሬቴኖሶ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ሀኦሶን አቼቻስር ዎግጋ ቱማኖን ግእቶናክ ዛግት ፌሴስ ኦና ኦናንሶ? ኤስ ባሶ ቦርአ ዎስቴ ባሶናዋ ዱግኖቤሲስ ዛቦሲ ጋንደራ ፉእቴና ባሶቴኖሶ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ደይ ኤስ አጃጃሞ ቤያ ባሶትን ስንና ሻካናነ፦ «ቤይሳናሲክ ኣፋ ግርሶነዉዛ» ይራ ቴይናስ ኦና ኦናንሶ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ኤሴ ግሩ ችማ ቤየቴስ አማንቶ ቤዮቤሲስታን ካብ ቾዋ ስንባሶንቱ ቢፌኒዋ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s1">ሀኦስ ዳራባሲክ እምና ቤይሳኒ አብድ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ኤስ ባሪ ቦርኣ ባር እኖክ እማና ቤይሳኒ ድማሲ ግሩኒክ ኤጳታኒ አብዲስ ሀሽኑ ዛግራ ፋር ስንና ቦርአ ንቶስን ኤስ ቤይሳኒ ድማሲ ግሩኒ እጣ ዳንኖይ ፉእቶኖይናማቶ እንኖ ዙታምኒሴ ቴትኒሶን ኦዳንዋ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ማአ ኦዱሶን ባሶ ኦደሴቴሲማቶ እንኖ ደይ ኦደኒዋ። ስኑንታኖ ባሶ ኦደሴቴ ካማሶን አማንቶክ ኣነ ኤጴቶሶቶ ስንና ቦርአ ባሶክ ኣነ ኬአ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ባሳ ዎስቶስ ሀን ዳስ ቴስቴናኔን ካብራ ኮእራ ፋር ስንፋናክኑ፦ « ‹ታ ባሶክ እማና ቤይሳኒ ድማሲ እሳንነ ኣፋ ግርሶነዉዛ› ይራ ግእናሲክ ቴይጝዋ» ይናሲማቶ ሀሽኑ አማነፌ እንኖ ኤስ ሀኦ እኖክ እማና ቤይሳኒ ድማሲ ግሩኒዋ። <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ናፉንሳ ዎናሲ ቾዋክ እሳ ድምታ፦ «ሀኦስ ዎስቴት ፋና ዎስቶሲክቶታን ናፉንሲናሪ ዎኖ ቤይሳ ኤጲ» ይስቴዋ። <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ኤሲስማቶ ሀን ድማስታ ሄፕሳ ደይ፦ «ታ ባሶክ እማና ቤይሳኒ ድማሲ እሳንነ ኣፋ ግርሶነ ዉዛ» ይዋ። <verse eid="HEB 4:5"/><verse number="6" style="v" sid="HEB 4:6"/>ኤስ ባሶ ማአ ኦዱሶን ዜምሜ ኦደሴ ባሶ አጃጃምቶ ቤዮቤሲስታን ካብ ቾዋ ኣነ ግርሶቶዋ። ስንፋናክኑ ኤክ ግርሶነክ ፋቃድቴና እሳ እሳ ሜያ ፌሴቴር። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ኤስ ባር ደይ ዜምማ ማክቴናሲማቶ</para>
  <para style="q1" vid="HEB 4:7">«ሀውጙ ካምባሶን ኦደፌት ካባሲክ፤</para>
  <para style="q2" vid="HEB 4:7">ንብኒትሶን ኦዶ ቤያር ዛጉትታዋ።»</para>
  <para style="m" vid="HEB 4:7">ይት ሀኦሲ ሾዎ ነያኔን ኦርፎ ዳዊትኒኪ ካሞ ማኬና ካማስ «ሀውጙ» ይስቴራ ቴግቴ ዎናስ ቡዱባሲክ ፉቶ ስንናማቶ አርቴዋ።<verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>እያሱ ቤይሳኒ ድማሶን ባሶክ እም ስንፋናነ ሀኦስ ሄፕሳ «ሀውጙ» ኡክ ኦማ ዎን ኒ ቾዋ ማኮና ካባታዋ። <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ኤሴ ሀኦስ ቤይሳ ኤጵናስነ ፋ ቤይሳ ዳራሲክ ሀሽኑ ፉእቴራ ፋርዋ። <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ሀኦስ ዎስቴት ፋና ዎስቶስታን ቤይሳ ኤጵናማቶ ደይ ሀኦስ እማና ድማሲ ግርሶኒ ባሶ ደይ ዎስቴት ፌሴቴ ዎስቶቤሲስታን ቤይሳ ኤጶነዋ። <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ኤስ ባሪ ቦርኣ ኦኑ ኤስ አሱኒ ሜኒ አጃጃምቶ ቤያሲክ ዞኑስቴሬ ጋንዶኖይኒማቶ ኤክ ሀኦሲ ቤይሳኒ ድማሲ ግሩኒክ ካቦኒዋ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ሀኦሲ ካማ ሀየዋ ደይ ዎስቴርዋ። ሄፕ ካድባ ፋና ሲፎስታን ደናሎኖን ካጋዋ። ካሶንናዋ አያናሶንና፤ አቱሲኪ ርቡሶንናዋ ጎኡሶንና ኦር ኦር ክሱናኔን ካርአርዋ። ንብባሲ ኣቸራ ፋ ሳፋራሴዋ ኤናንቶሴ አሲን ቱእኒራ ማጝሱ ካርአር። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ሀኦሲ ስናን ኣቾኒ ቴስቶ እሳንነ ኣፋ። ባሪ ስናስታ ዙታምባሴ አምማ ደይ አታቱ ስንናቱ ቤስቴፋዋ። እንኖ ደይ ዎልጉባ እማኒስ ኤስ ባሪ ስናዋ።<verse eid="HEB 4:13"/></para>
  <para style="s1">የሱስ ማግኒ ጋኝኜ ሜኒ ጋኛታኒ ደናሎዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ኤሴ ሳማሲክቶኖን አቴ ደን ሳማ ኬሳ አካም ማግኒ ጋኝኜ ሜኒ ጋኛ እኖክ ፌር ስንና ቦርአ አማንቶኒሶን ዛግራ ኤጳኒዋ። ኤስ ማግኒ ጋኝኜ ሜኒ ጋኝኛስ ደይ ሀኦሲ ና የሱስዋ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>እኖክ ፌ ማግኒ ጋኝኜ ሜኒ ጋኝኛስ እንኖ ሆፕያሲክ ኬናሽቶክ ችማርዋ። ባር ዙታምባሴ አሲክ እንኖሲማቶ ፋታንቴ። ስኑንታኖ እሳ ቦርአኑ ኣነ ዎስቶዌ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ኤሴ ፋኪያ ኤጳቶኒክናዋ አርጋሱ እኖክ ሾልሲፋና ካባሲክና ኦቱምባሶን ዳናኒክ ኦቱምባ ፋና ኤክ ሀኦሲ ዝግሞኪ እሳ ድጋ ፎንቶኖን ታእሶኒዋ።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ማግኒ ጋኝኜ ሜኒ ጋኝኛስ እሳርባ እሳርባስ አሱኒ ሜኒ ጋነያስን ኮርቴሬ ሀኦስኔን አነ ኡጵሱኒ ቾዋሲክ አሱኒ ሜኒ ኤድዴ ስንነ ማባሶንናዋ ማኣሶንና እማክቱ ታትቴፌ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ባር ቴትባሲክ ሆፕባ ፋናር ስንና ቦርአ አሩኖይ ባሶትንናዋ ዳጌፌ ባሶትንና ኬናሽቶክ ብያናክ ችማና። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ባር ቴትባሲክ ሆፕባሲ ቦርአ ቦርኒ ፋክያ ቤስቶናክ ዛግፋ ማኣሶን እማናክ ሾልሲናስ ዳራሲክ ኮእባ ስንኖይናሮን ባሳ ቴታሲክኔጝዋ። <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ኣሮንኒሲማቶ ሀኦሲክ ቴግቴር ስና ሻካናነ ኦኑ ሀን ኡልፍናሶን ባሳ ቴታሲክ ኤጴቶናክ ኣፋ ችማናዉዛ።<verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ኤሲስማቶ ክርስቶስ ማግኒ ጋኝኜ ሜኒ ጋኛ ስናሶን ባር ቴትባሶን ኣነ ኡልፍንሱዌ። ስኑንታኖ ባር ማግኒ ጋኘ ሜኒ ጋኛ ስናሲ ኡልፍናኖን ዳንናስ፦</para>
  <para style="q1" vid="HEB 5:5">ነ ታክ ናታዋ፦</para>
  <para style="q2" vid="HEB 5:5">«ታ ሀውጙ ኔን ኮኒጝዋ»</para>
  <para style="q2" vid="HEB 5:5">ይ ሀኦስክጝዋ።<verse eid="HEB 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 5:6"/>ኦማ ድማስታ ደይ ሀኦሲ፦</para>
  <para style="q1" vid="HEB 5:6">«ሜልኬሴደቅኒ ማግ ስንናሲማቶ፤</para>
  <para style="q2" vid="HEB 5:6">ነ ኮእባ ፎንቶኖን ማግዋ» ይፋዋ።<verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱስ አሱ ስንነ ሀን ዳስታክ ፌና ካባሲክ ክቱን ፉኦናክ ችምኒ ሀኦስኪ አካማ ቻጋክናዋ አካማ ሀራፋክና ማምሱነዋ ሺጶነ ዛግ። ጋራማክ ቴትባሶን አጃጃሜር ዛጉባሲክ ሀኦስ ሺጶባሶን ኦደ። <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>ሀኦኒ ና ስንፌናክኑ ኤጴቴና ሻናሲን አጃጃምቶሶን አሪ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ዮኡባ ፎንቶ ስንነ ቤስቴናኔን ኦርፎ አጃጃሜፌ ባሶ ዙታምቤሲሴ አሲክ ኮእባ ፎንቶ ፋሩሲክ ኡግና ስኒ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ኤስ ባሪ ቦርኣ ደይ ሀኦስ ሜልኬሴደቅኒ ማግ ስንነ ታቶስነ ፋሮን ማግኒ ጋኝኜ ሜኒ ጋኛ ዛግራ ታትሲ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አሱኒ ሜያ አማንቶቤሲሶን ቤዮኖይቴማቶ ቴትቤሲሶን ኦዶነክ እምቴ ኪቶ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ሀን ቾዋሲክ ማኮኒ ዉዛ ሾዎ ፋርዋ፤ ስኑንታኖ ያዳቶኒ ሁግናንትስ ጋሮ ስንና ቦርአ ንቶክ አስሱስ ራኮዋ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ሀሽኔን ካርአ ፋ ኤፋቴና ዎናሲክ ንቶ አስኛ ስናቲ ካባዋ፤ ስኑንታኖ ሀኦሲ ካምኒ ቴሱኒ አሱሶን ኦም አሱ ሄፕሳ አስሱናክቱ ሾልሱዋ። ኤስ ባሪ ቦርኣ ንቶክ ሾልሲፋስ ሻቦታኖ ችማ ሙታዋ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ሻቦ ኬሽቴፋ ባር ዙቴራ ዳጋ ናዋ ስንና ቦርአ ማኣሶን ማጙስታን ኮሪሬ አሩ ኣፋ ችማናዉዛ። <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ስኑንታኖ ችማ ሙ ሾልሲና ባሶ ማአ ዉዛሴዋ ማጙ ዉዛሴ አሲን ኮሪሬ ክሱኒ አሩቤስ ፋና አሱኒ ሜያዋ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ኤሴ ክርስቶስኒ ቾዋሲክ እምቴ ቴሱኒ አሱስታን ኣታ ኤክ ችማ አስሱሲኪ ሀማኒዋ፤ ክቱ ዎስቶስን ሀርሙኒ ቾዋሲክናዋ ሀኦሲክ አማንቶኒ ቾዋሲክና አሲ ካፕታሶን ሄፕሳ ዎል ላ ካፑታኒታ። <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ኤሲስማቶ ሀጱቅቶሶን፥ ኩሹክ ታኡሶን፥ ክቱን ካቡሶን፥ ኮእባ ፎንቶ ማጝሱኒ ካርኣሲ አሱኒ ቾዋሶን ሄፕሳ ዎል ላ ካፑታኒታ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ሀኦ እያናነ ኤስ ባሮን ዛጉኒ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>አማንቶቤሲሶን ሞርሜ አሱኒ ሜያኖን ሀርምሬ ዎልሶነክ ዛጉ ኣካክ ችምቶኒሪንሶ? ኤስ ኤፌቴና አሱኒ ሜያ ዜሞ ባሶክ ቻሬፋ ቻሬራ ፋር። ሳማኪ እማሶን ቤችሬ ቢሬ ፌሴቴር። ኮርቶ አያናስኔን አነ ሃኤር ስንነ ፌሴቴር። <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሀኦሲ ማአ ካማኖንናዋ ሀኔንቲ ዮኒ ዎናሲ ሁግናኖንና ቤችሬ ቢሬ ፌሴቴር። <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ኤስ ኤፌቴና አሱኒ ሜያ አማንቶቤሲሶን ሞርሜሴፋቴነ ባሶ ቴትቤሲሲክ ሀኦሲ ናኒን ሄፕሳ ዎልግሬ ሱቴሴፌ ቦርአናዋ አምማኖን ሳልጲሲሴፌ ቦርአና ባሶትን ሀርሙሶነክ ዛጉ ኣፋ ችምቶና ዉዛ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>ሾዎ ዎና ባሪስታ ኬሬት ፋ እሮሶን ኡሽፋ ባሬዋ ቡለፌ ባሪክ ደይ ጋና እምፋ ዳሴ ሀኦስኪን ኤብባ ዳናና። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ስኑንታኖ ሴርነዋ አሴዉነ ካይጋናነ ዋግባ ፎንቶቱ ስናና፤ ኤርዉቶናክ ደይ ታእ፤ ባሪ ኮኣስ ደይ ጌሲ ኪቾዋ። <verse eid="HEB 6:8"/><verse number="9" style="v" sid="HEB 6:9"/>ሹንቶ ሜያነ! ሀን ባሮን ማኬፋናክኑ ንቶ ፋሩንቲሶን ኤጳ ዮኒ ማአ ዉዝንቲ ፋናማቶ እንኖ ፉቶክ አሪፌኒዋ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ሀኦስ ፉቶክቱ ማጝሱ ካርፋዋ። ኤስ ባሪ ቦርኣ ዎስቶኒትሴዋ ዜሞ ስኑን ሀሽቲ ፋ ኮርቶኒ ሜያኖን አርጋሱንቲሴ አሲክ ባሪ ሱናሲክ ዛግሴት ኬሽታናሶን ኣፋ ዳጎናዉዛ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>ኒቶ ዙታምኒትሴ አብድክ ኦዴት ፋሴት ዉዛሶን ኩሹንትሲ ኤጳ ጌዳቲ ካባኔን ዱዶንትሶን ሀምማ ኮእባስታ ካርአና ካባኔን ቤሱትክቱ ችኒራ ኤናንቴፌኒዋ። <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ኤናንቴፌኒስ አማንቶክናዋ ፋኪያክና ዛግሬ የሮክ እምቴ አብዲሶን ዋራሶኒ አሱኒ ሜያነ ፌር ስናትክታኖ አዉጃ ስናትክታዋ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ሀኦሲ አብድ አማናምቶ ስንባስ</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ሀኦስ አብራሀምኒክ አብድ እምፋና ካባሲክ ባር ቴጌራ ቴዉናክ ባሪስታን ደናሎ ኦም ኦኑ ኣፌ ስንና ቦርአ ኤካ ይት ባር ባሪ ቴታሲክ ቴይ፦ <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>«ፉቶሲክ ኔን ኤቢሱናዋ፤ ዛልኔሶን ደይ ሾዎሱናዋ» <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አብራሀም ፋኪያክ ኦደ ባሪክ እምቴ አብዲሶን ዳኒ። <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>አሱኒ ሜያ ቴይሴፌ ካባሲክ ባሶስታን ደናሎ ስና ሱና ቴግሴሬቱ ቴይሴፌ። ዎሉምቤሲሶን ቴያክ ዛግሴሬ ባሶ ጋነያሲ ፋ ክርክሪሶን ዙትሬ ትሽክሴፌ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ኤሲስማቶ ሀኦስኪን ቡድ አላማባስ ሶልቶኖር ስንባሶን አምማኖን ቤሱናክ ሾሌፋት አብዲሶን ኤጴቶኒ ባሶክ ቴያክ ዛግ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ኤሲስማቶ ሀኦስ ሀን ሄፕ ሶልቶኖይ ባሪ አብዲሶንናዋ ቴያሶንና እኖክ እሚ፤ ኤስ ባር ደይ ሀኦስ ኤሻክ ኣነ ችምፋ ስንና ቦርአ ስኒስታ ፋ አብዲሶን ዛግራ ኤጳክ ባሪኪ ኤልሌ ሀማ እንኖ አካማ ችማቱ ዳንኒዋ። <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ኤስ አብዲስ ካኒሲክ ማርካቢስ ሾርኮኖይናማቶ ዛታ ዬትፋ ብታሲማቶዋ። ኤስ አብዲስ ይኑሶን ኣታ ስርኪ ባግቶሪ ግር። <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>የሱስ ሜልኬሴደቅኒ ማግ ስንነ ታቶሳማቶ ኮእባ ፎንቶኖን ማግኒ ጋኝኜ ሜኒ ጋኛ ስንነ እኖክዋ እያት ዜምሜ ስር ግሪዋ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ማግኒ ጋኝኜ ሜኒ ጋኛ ሜልኬሴደቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>ሜልኬሴደቅ ሳለምኒ ታቶ፤ ደይ ዙታምባሴ አሲስታን ደናሎ ስና ሀኦሲ ማግዋ። ኤስ ሜልኬፄደቅ አብራሀም ታቴ ሜያኖን ሜሬሬ ዎልፌና ካባሲክ ኡግናስታክ ኡጰሬ ኤቢስ። <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብራሀም ደይ ኤጵና ዉዛ ዙታምባሴ አሲስታን አሲሪስን እሳሮን ኪስሬ እሚ። ሜልኬሴደቅን ሱናሲ ኮታ እሶንሳ፦ «ኦኮ ታቶ» ኦማ፦ «ሳለምኒ ታቶ» ወደይ «ናጋኒ ታቶ» ኡዋ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>ሜልኬሴደቅ ትቻክ አርቴ አባናዋ እንቶነ ወደይ ኮንቶኒ ቱዝባ ኣፋ፤ ኔባሲ ቴሱ፤ ካክ ፎና ዎጋባሲክ ደይ ኮእባ ኣፋ። ኤስ ሜልኬሴደቅ ሀኦሲ ናኒ ቤሶኒማቶ ኮእባ ፎንቶኖን ማግ ስንነ ፎና።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ሀን አሱ ኣካነ ፌ አካም አሱ ስንናማቶ ቢትዋ፤ አሲቴሴሪሲ ቱዝኒ አባ ስና አብራሀምኑ ቦጆክ ዳንና ዉዛስን አሲሪስን እሳሮን ኪስሬ እሚ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ኤስ ባሶ ማግኒ ሜኒ ዎስቶስታ ዎስቶሶነክ ፋድቴፌስ ሌዊኒ ዛላሲክቶ ስና ዳራሳስን አብራሀምኒ ዛላስን ኤሲስኑ ደይ አይቤሲሳክቶኒኪን አሲሪስን እሳሮን ኤጶነክ ቱማስ ባሶክ አጃቼዋ። <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ኤስ ሜልኬሴደቅ ሌዊኒ ሜኒ ዛላ ስና ቤይፌናክኑ አብራሀምኒኪን አሲሪስን እሳሮን ኤጲ። አብድኒ ካማ እምቴና አብራሀምኒን ደይ ኤቢስ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ጋሮስ አሪኪሳታን ኤባ ኤጴቶና ባር ኤክ ሀጝ ኡባ ኣፋዋ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>እሳ ካድባሲክ አሲሪስን እሳሮን ኤጴፌስ ክቱኒር ስና ባሶዋ። ስኑንታኖ ኦማ ኡግናሲክ ደይ አሲሪስን እሳሮን ኤጴፌ ባር ሀየዉ ስንነ ፎናማቶ ዛላ ማክቴና ሜልኬሴደቅዋ። <verse eid="HEB 7:8"/><verse number="9-10" style="v" sid="HEB 7:9-10"/>ኤሴ ሜልኬሴደቅ አብራሀምኒን ኡጰና ካባሲክ ሌዊ አባባ አብራሀምኒኪን ሀሽኑ ኣነ ኮንቶዌ ስንና ቦርአ አሲራትሶን ኤጳናክ ሾልሲናስ ሌዊ ቴትባክ አብራሀምኒኪ ካሞ አሲሪስን እሳሮን ካሲዋ ኡዋ።<verse eid="HEB 7:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ኤሴ ዳራሲክ ቱማ እምቴናስ ሌዊኒ ማግ ስንነ ዎስቶስኪ ካሞዋ። ኤስ ሌዊኒ ሜኒ ዎስቶሲክ ቱማ ስኒ ስንፋናነ ኣሮኒ ማግ ስንነ ታቶስ ስንኖይናሮን ሜልኬሴደቅኒ ማግ ስንነ ታቶባ ፌና ኦም ማግ ዮና ባር ሾልሱና ካባታዋ። <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ማግ ስኒ ቱዛስ ሶልቴፋና ካባሲክ ቱማስ ደይ አነ ሶልቶናክ ሾልሱዋ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ሀን ባር ዙታምባሴ ባሪክ ማክቴና ማግስ ኦማ አሲቴሴርክጝዋ። ኤስ አሲቴሴሪኒ ሾኣስታ ታእሴሬ ዎስቴር ኦኑ ኣፌዋ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ዳምኒስ ዩዳኒ ሜኒ አሲቴሴሪ ስንባስ አርቶዋ። ስንፋናክኑ ሙሴኒ ማግ ስንነ ቾዋሲክ ማኬፌና ካባ ዩዳኒ ሜኒ አሲቴሴሪሶን ቤሲራ ማኬና ዉዛ እሳንነ ኣፋዋ።<verse eid="HEB 7:14"/></para>
  <para style="s1">ክርስቶስ ሜልኬሴደቅኒሲማቶ ማግ ስንናማቶ</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ሀን ዉዛስ አምማ ስንና ፎናስ ሜልኬፄደቅኒሲማቶ ኦም ማግ ካብፌና ካባሲክዋ <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ባር ማግኒ ሜኒ ታቶሶን ኤጵናስ ትሹኖይ ኮእባ ፎንቶ ካኒ ሁግናሲክታኖ ዛላሲ ቱዛኪን ያ ቱማሲ ስትሪክታዋ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>«ሜልኬሴደቅኒ ማግኒ ታቶሲማቶ ነ ኮእባ ፎንቶኖን ማግዋ» ይስቴራ ባሪክ ዛላ ማክቴዋ። <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ዜምማቲ አጃጂስ ሆፕያ ደይ ኬእኖር ስንና ቦርአ ሻርቴዋ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሙሴኒ ቱማሲ ኦኒንኑ እሳንነ ቱማ ዛጉክ ኣነ ችማ። ስኑንታኖ ሀሽ ሀኦሲክ ታአኒክ አካማ አብድ እኖክ እምቴዋ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ኤስ ባርስታን ኦማ ሀን ማግ ስናስ ሀኦሲ ቴያ ፎንቶኖን ኣነ ስናዋ። ኤስ ዜሞ ስናክ ማግ ስነ ባሶ ቴያባ ፎንቶኖንቱ ስነቴዋ። <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>ስኑንታኖ የሱስ ማግ ስንናስ ሀኦሲ ቴያክዋ። ኤሲስ ደይ፦ «ዳሚስ፦ ‹ነ ኮእባ ፎንቶኖን ማግዋ› ይራ ቴይ፤ ኤስ ሳፋራባስ ደይ ኣፋ ሶሎና ዉዛ» ይስቴራ ባሪክ ማክቴናሲማቶዋ። <verse eid="HEB 7:21"/><verse number="22" style="v" sid="HEB 7:22"/>ኤስ ቴያሲ ቦርአቱ የሱስ ኤስ ባርስታን ደናሎ ቴያኒ ካማሲክ ዋሲ ስኒዋ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ክቱሲ ቦርአ እሳ ማግ ሶልቶኖይፌን ዎስቴፌና ዎስቶባስታክ ኮእባ ፎንቶኖን ፎክ ኣፋ ችማናዉዛ ስንና ቦርአ ዜሞቲ ማግኒ ሜያ ፋድቤሲስ ሾዎዋ። <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>ስኑንታኖ የሱስ ኮእባ ፎንቶኖን ፎኒር ስንና ቦርአ ማግ ስንባስ ሶልቶኖርዋ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ኤስ ባሪ ቦርኣ ባሶክ ናቱክ ኮእባ ፎንቶኖን ሀየዉ ስንነ ፎኒር ስንና ቦርአ ባርኪ ካሞ ሀኦስኪ ዬሴፌ ባሶትን ዙትሬ ፋቱክ ችማናዋ። <verse eid="HEB 7:25"/><verse number="26" style="v" sid="HEB 7:26"/>ኤሲስነ ፌ ኮርቶ፤ ዝናባ ፎንቶ፥ ካይም፥ ቦርኒ ሜያስታን ኦር ኬሴ ኮርቶ፥ ሳማስታን ደናሎ ቴግ ስና ማግኒ ጋኝኜ ሜኒ ጋኛስ እኖክ ሾልሱዋ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ባር ኦም ማግኒ ጋኝኜ ሜኒ ጋኛኒማቶ ዜምሜ ባሳ ቴትኒ ቦርኣሲክ፤ ኦርፎ ደይ ዳራሳ ቦርኒ ቦርኣሲክ ዎንና ዎንና ማአ እማናክ ኣነ ሾልሲፋዋ። ቴትባሶን ማአ ዛግሬ እምና ካባሲክ ሀን ዉዛሶን ሄፕሳ ዎሉኖይናማቶ ዛግሬ ኮእሲዋ። <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ቱማስ ማግኒ ጋኝኜ ሜኒ ጋኛ ዛግራ ታትሲፋናስ ሆፕ ስና አሱኒ ሜያኖንጝዋ። ስኑንታኖ ቱማስኔን ኦርፎ ያ ቴያስ ኮእባ ፎንቶኖን ቱማ ስና ሀኦሲ ናኒን ታትሲዋ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱስ ጋድዶ ቴያሲ ማግኒ ጋኘ ሜኒ ጋኛ ስንናማቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ኤሴ ዎሎኒ ዉዛሲክቶስን አሪክስ ሀኒስዋ፦ ሳማክ ዙታምባሴ አሲስታን ደናሎ ስና ሀኦሲ ዝግሞኒ ሆእታ ቴሻስታ ድ ኤፌቴና ማግኒ ጋኝኜ ሜኒ ጋኛኒ እኖክ ፌርዋ። <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ባር ዎስቴት ፌናስ ፉቶኒ ዱርካኒ ስና ሜቅዴሲሲዋ። ኤስ ዱርካኒስ ቶክቴናስ አሱኒ ኩሹክ ስንኖይናሮን ዳሚሲክዋ <verse eid="HEB 8:2"/><verse number="3" style="v" sid="HEB 8:3"/>ማግኒ ጋኝኜ ሜኒ ጋኛ እሳርባ እሳርባስ ታቴፌናስ ማባነዋ ማአነ አሲን እማናክዋ። ኤስ ባሪ ቦርኣ ኤስ ማግስ ደይ እማና እሳ ዉዝባ ፎናክ ሾልሱዋ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ቱማሲማቶ ማባሶን እሜፌ ማግኒ ሜያ ፌሴቴር ስንና ቦርአ ባር ሀን ዳስታኪር ስኒ ስንፋናነ ማግ ስናና ካባታዋ። <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ሀን ማግኒ ሜያ ዎስቴሴፌ ዱርካኒስ ሳማኪ ፋ ባሪ ቤሶነዋ ይራራነ አሲክ ኮእባዋ። ኤስ ባር ደይ ስንናስ ሙሴ ዱርካኒሶን ዎስቴፌና ካባሲክ ሀኦስ፦ «ኣማስታክ አምማኖን ኔክ ቤሲናስነ ፋሮን ዙታምባሴ ማእስራ ኦዳ ዛጉዋ» ይራ አጃጀናሲማቶዋ። <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ስኑንታኖ ሀሽ የሱስ ጋነኒር ደይ እሳር ዛግና ቴያሲ ኩርኡ ቴያስታን ደናሎ ስና አብዲስታ የሬር ስንናማቶ ባሪክ እምቴ ዎስቶስ ደይ አርኪርዋ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ዜምማቲ ቴያስ ዝናባ ፎንቶ ስንና ቤስቴ ስንፋናነ ሄፕሳኒ ቴያስ ሾልሱና ካባታዋ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ሀኦስ ዳራባሳታ ዝና ፎባሶን ቤሱክ ኤካ ይፋዋ፦</para>
  <para style="q1" vid="HEB 8:8">«ኤሴ እስራኤልኒ ዳራስኔንናዋ ዩዳኒ ዳራስኔንና፤</para>
  <para style="q2" vid="HEB 8:8">ጋድዶ ቴያኒ ካማ ግሩና ዎና ዮናዋ»</para>
  <para style="m" vid="HEB 8:8">ይፌዋ ዳሚስ።<verse eid="HEB 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9"/>«ኤስ ቴያስ ደይ ኩሹቤሲሶን ኤጳ ግጵጽኒ ሜኒ ዳስታን፤</para>
  <para style="q2" vid="HEB 8:9">ባሶትን ክስፋና ካባሲክ፤</para>
  <para style="q2" vid="HEB 8:9">ባሶ አባስኔን አነ ግሪና ቴያስነ ፋርታዋ።</para>
  <para style="q1" vid="HEB 8:9">ባሶ ታ ቴያኒ ካማሲክ ኣነ የሮሶቶ ስንና ቦርአ፤</para>
  <para style="q2" vid="HEB 8:9">ታ ደይ ካሽጝዋ»</para>
  <para style="m" vid="HEB 8:9">ይፌዋ ዳሚስ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>«ኤሴ ሀን ዎናስኔን ኦርፎ፤</para>
  <para style="q2" vid="HEB 8:10">እስራኤልኒ ዳራስኔን አነ፤</para>
  <para style="q2" vid="HEB 8:10">ግሩና ቴያኒ ካማስ ሀኒስዋ፤</para>
  <para style="q2" vid="HEB 8:10">ይፌዋ ዳሚስ፤</para>
  <para style="q2" vid="HEB 8:10">ታ ቱማሶን ባሶ፤</para>
  <para style="q2" vid="HEB 8:10">ካኑስሲ ፎናክ ዛጉና፤</para>
  <para style="q2" vid="HEB 8:10">ንብቤሲስ ደይ ትቹና፦</para>
  <para style="q2" vid="HEB 8:10">ታ ደይ ባሶክ ሀኦቤስ ስናና፤</para>
  <para style="q2" vid="HEB 8:10">ባሶ ደይ ታክ ዳራ ስኖነ.<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>‹ዳሚስን አሩዋ› ይሬ ዎልኮባስን ስኑን፤</para>
  <para style="q2" vid="HEB 8:11">አይባስን አሱኒር ኦኑ ኣፋ ፎና ዉዛ፤</para>
  <para style="q2" vid="HEB 8:11">ጋሮሳታን ካብራ ሀምማ፤</para>
  <para style="q2" vid="HEB 8:11">አርኪሳታ ካርአና ካባኔን፤</para>
  <para style="q2" vid="HEB 8:11">ዙቴሬ ታን አርሶነ፦<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ማጝሱቤሲሶን ፌሹን ኡና፤</para>
  <para style="q2" vid="HEB 8:12">ቦርቤሲሶን ደይ፤</para>
  <para style="q2" vid="HEB 8:12">ኣፋ ዎላ ያዳቶና ዉዛ።»<verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ኤሴ፦ «ጋድዶ ቴያኒ ካማ» ይፋና ካባሲክ ስናቲ ቴያኒ ካማሶን ኩርኡ ዛጊዋ ኡዋ። ኤስ ባሪ ቦርኣ ኩርእ ባሬዋ ኩርኡ ዉዛ ዙታምባሴ ትሹና ዎናስ ታእሴዋ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ሳማኪ ቤቴሜቅደሲሲ ሀን ዳስታኪ ባርስታን ደናሎ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>ቴሱኒ ቴያኒ ካማስ ሺጶኒ ስትርባሬዋ ሀን ዳስታኪ ደይ ሜቅደስባሬ ፋርዋ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ሄፕ ባግቶባ ፋና ዱርካኒ ሆሬራ ፋር፤ ማቅሬዝነዋ ታራቤዛነ፤ ደይ ማአኒ ዳቦሴ ባርሲ ፋና ቴሱኒ ባግቶስ፦ «ኮርቶ» ይስቴት ፋር። <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ሄፕሳኒ ይኑሲ ኦርፎሲ ፋ ስርኪ ባግቶስ «ኮርቶሲ ኮርቶ» ይስቴት ፋር። <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ኤስ ባግቶሲ ዋርቄኒ ክርቅዳነዋ ዋርቄ ማቶ ቴያኒ ካምኒ ታቦታባስ ስር ፋር። ኤስ ቴያኒ ካምኒ ታቦታስ ማንናባ ስሩክ ፋና ዋርቄኒ ማሱብ፤ ቶሽባ ኮታ ድ ኣሮኒ ሃሮስ፤ ደይ አሲር አጃጂሲክቶ ትቼራ ፋና ካቶ ሹኣስ ስሩክ ፋሴር። <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ታቦታስታክ ደይ ፋ ቦርኒ ካይምሱኒ ኡካሶን ኮሶቤሲሲክ ይኑኒ ኡልፍናኒ ክሩቤሊስ ደይ ፋሴር። ስኑንታኖ ኤስ ዉዛሲክቶኖን ዙትራ ሀሽ እሳርባ እሳርባሲክ ማኮክ ኣፋ ችማኒ ዉዛ።<verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ዙታምባሴ ኤሲስማቶ ሆሬናኔን ኦርፎ ማግኒ ሜያ ካይኑን ዎስቶቤሲሶን ኮእሱክ ዱርካኒሲ ቴሱኒ ባግቶሲ ዎንና ዎንና ግርሴፌ። <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ስኑንታኖ ሄፕሳኒ ባግቶሲ ፋ ስርኪ ባግቶሲ ግሩኒስ ማግኒ ጋኝኜ ሜኒ ጋኛ ስና ባር ባር ኮእባዋ። ስር ግሩናስ ደይ ዎጋስን እሳ ዎና ኮእባ። ባር ደይ ቴትባሲ ቦርአክናዋ ዳራስ ዳጋክ ዛግና ቦርኣሲክና እማና ሀንናሶን ኤጵኖይ ስር ኣነ ግሪፌ። <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>ቴሱኒ ዱርካኒስ ፋና ካባኔን ኮርቶሲ ኮርቶ ኤጳ ሀሚኒ ኡግናስ ሀሽኑ አምማኖን ኣነ ኬሳ ቤስቶዋ ስንናማቶ ኮርቶ አያናስ ቤስፋ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ኤስ ባር ደይ ሀን ፋ ዎናሲክ ቤሶዋ። ኤስ ኤፋቴና ዉዛሲክ እምቴፋ ማባሲክቶነዋ ማኣሲክቶነ ሺጵሴፌ ባሶ ካኑሶን ኮእባ ፎንቶኖን ካይኑናክ ኣነ ችምፋ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ሙኒ ቾዉነዋ ኡሽኒ ቾዉነ ደይ ኦማ ኦማ ካይምኒ ቾዋሲክቶ ዎስቴት ፋናስ ሀን ጋድዶ ስትሪስ ዮና ካባኔን ኮእባዋ።<verse eid="HEB 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ስኑንታኖ ክርስቶስ ዮናክ ፋሴ ማአ ዉዛሲክቶ ማግኒ ጋኝኜ ሜኒ ጋኛ ስንነ አምማኖን ኬሴ ቤስቴ። ባር ግርና ዱርካኒስ አካማኖን እኛ ደይ ዮኡባ ፎንቶዋ። ኤስ ዱርካኒስ አሱኒ ኩሹክ ዎሱስቶኖር ደይ ሀን ቴስቶስኪን ስንኖርዋ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ባር ኮርቶሲ ኮርቶሲ ሄፕሳ ዎሉኖይናማቶ እሳርጋ ባሳ ሀንናሶንቱ ኤጴ ግርቴኖ ፍዞሲክቶኒ ሀንናነዋ ዝብቻሲክቶኒ ሀንናነ አሲን ኣነ ኤጴ ግሩዌዋ። ኤስ ኤፋቴና ዉዛሲክ ኮእባ ፎንቶ ፋሩኒ ፉሪሶን እኖክ እሚዋ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ፍዞሲክቶኒ ሀንናነዋ ኦሞሩሲክቶኒ ሀንናነ ማአክ ኪቼ አዛታ ሚኒ ቤድናስ ቦርአክ ኪና አሱኒ ሜያስታ ውርቴፋና ካባሲክ አሽኒ ዝናስን ባሶትን ካይንራ ኮርቶ ዛጉኒር ስንናኔን፤ <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ኮእባ ፎንቶ አያናስኪ ካሞ ቴትባሶን ዝናባ ፎንቶ ማአ ዛግሬ ሀኦሲክ እምና ክርስቶስኒ ሀንናስ ሀየዋ ሀኦሲክ ዎስቶኒክ ካኑኒሶን ክቱ ዎስቶስን አዉነ ፋሮን አሪክስራ ካይምሱንጋሶ?<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ኤስ ቴግቴ ባሶ ሀኦስ አብድክ እምና ኮእባ ፎንቶ ርስትሶን ኤጴቶሶነክ ክርስቶስ ጋድዶ ቴያኒ ካማስ ጋነያ ስኒዋ። ኤስ ባር ደይ ስንናስ አሱኒ ሜያ ቴሱኒ ቴያኒ ካማሲ ስካሎሲ ፌሴፋት ዎስቴሴቴ ቦርኣስን ፉኦናክ ክቱባሲክዋ። <verse eid="HEB 9:15"/><verse number="16" style="v" sid="HEB 9:16"/>ማክቴ ፋፎ ፋናኔን ኤስ ፋፎሶን ማኬ አሱስ ክቱባሶን ጋሳሱ ሾልሲፋዋ። <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ፋፍቴ ካማስ ዎስቶታ ፌሻናስ ፋፌ ባር ክትናኔን ኦርፎዋ። ስኑንታኖ ፋፌ አሱስ ካክ ፌን ፋፌና ካማስ ዋግባ ኣፋዋ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ኤስ ባሪ ቦርኣ ቴሱኒ ቴያኒ ካማስ ሀንና ፎንቶኖን ኣፋ ዛጉና ዉዛ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>ቴሱስታ ሙሴ ቱማሲ አጃጅኖን ዳራ ዙታምባሴ አሲክ ማኬ። ኤሴን ኦርፎ ዝብቻኒ ሀርንነዋ ፍዞኒ ሀርንነ አካኔን አነ ዎእስሬ ቱማሲ ማፃፋታናዋ ዳራሳታና ዙትሬ ሂሶፕክናዋ ሸአ ፋንቱሲ ኤሳክና ዊርኢ። <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ኤስ ዊርናስ ደይ፦ «ሀኦስ ንቶክ አጃጀና ቴያኒ ካማሲ ሀንና ሀኒስዋ» ይሬዋ። <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ኤሲስማቶ ዱርካኒስንናዋ ባርሲ ዎሱስቴፋ ኮዳ ዙታምባሴ አሲስታና ዊርኢ። <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ፉቶክ ሙሴኒ ቱማሲማቶ ጋሮ ዉዛታኖ ዙታምባሴ ሀንናክቱ ካይምፋዋ። ሀንና ዉክቶኖይፌን ቦርኒ ፌሹን ኡ ኣፋ። <figure style="fig" alt="Hyssop" file="HK00114B.tif" size="span" ref="9:22">ሂሶጲ</figure><verse eid="HEB 9:22"/></para>
  <para style="s1">ክርስቶስኒ ማአ ስናስ ቦርኣስ ፌሹን ኡስቶናክ ዛግር</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ኤሴ ሀን ሳማኪ ዉዛሲክቶኒ ቤሶ ስና ባር ዙቴራ ሀን ስትሪስማቶ ካይምሶነክ ሾልሱ ስንና ፋር። ስኑንታኖ ሳማን ስና ዉዛሲክቶ ሀን ባሪስታን ቻላ ስንና ማአክ ካይማናክ ሾልሲፋዋ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ክርስቶስ ፉቶኒ ቤቴሜቅደሲሲ ቤሶ ስና ባሪስንናዋ አሱኒ ኩሹክ ኬቴ ኮርቶሲ ኮርቶሲ ኣነ ግሩዌ። ባር ሀሽ እንኖ ቦርአ ሀኦሲ ስና ቢስቶናክ ሳማ ሀምሜ ግር። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>አይሁድኒ ማግኒ ጋኝኜ ሜኒ ጋኛ ስና ባር ባሳር ስንኖይ ሀንናሶን ኤጴ ዎግጋ ዎጋሲክ ኮርቶሲ ኮርቶሲ ግሪፌናሲማቶ ባር ቴትባሶን ሾዎ ዎና ማአ ዛግሬ እማክ ኣነ ግሩዌ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ኤካ ስኒ ስንፋናነ ሀን ዳስ ቴስቴናኔን ካብራ ሾዎ ዎና ሻና ኤጴቶና ባር ሾልሱና ካባዋ። ስኑንታኖ ሀሽ ነያሲ ኮእታክ ቦርኣሶን ትሽኩናክ ቴትባሶን ማአ ዛግሬ እሳርጋ አምማኖን ኬሴ ቤስቴዋ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>አሱኒክ እሳርጋ ክቱስ እምቴራ ፋር፤ ክቱኔን ኦርፎ ደይ ማጝሱ ባሳስታ ካቶናክ ታእኒር። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ኤሲስማቶ ክርስቶስ ሾዎኒ ሜኒ ቦርኣሶን ትሽኩናክ እሳርጋ ክት። ደይ ቦርኣሶን ዎርአናክ ስንኖይናሮን ባሪን ኦደት ፌ ባሶትን ፉኦናክ ሄፕሳ ዎል ሌ ዮኒር።<verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ቱማስ ሀንኔንቲ ዮኒ ማአ ዉዛሲክ ይራራታኖ ፉቶኒ ግቶባስታዋ። ኤስ ባሪ ቦርኣ ዎግጋ ዎጋሲክ እምቴፋ ማኣሲክቶኖን ኤጴ ሀኦስኪ ታኤፌ አሱኒ ሜያኖን ኮእስራ ካይም ኣነ ዛግፋ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ቱማስ ኮእስራ ካይምሱክ ችማር ስንፋናነ ሺጶክ ታኤፌ አሱኒ ሜያ ሄፕሳ ዎልጉኖይ ኡግናክ ቦርኣስን ካይሜቴ ቦርአናዋ ቦርቤሲ ፎንቶ ስኖቤሲሶን ካኑቤሲስ አርቴር ስንና ቦርአና ማኣሲ እማኖን ቤዮነ ካባ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ስኑንታኖ ኤስ ማኣሲክቶ ዎግጋ ዎጋሲክ ቦርኣሶን ሳፋሮሶነክ ዛግርዋ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>ኦሞሩነዋ ፍዞነ አሲ ሀንና ቦርኣሶን ፌሹን ኡክ ኣፋ ችማናዉዛ።<verse eid="HEB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 10:5"/>ኤስ ባሪ ቦርኣ ክርስቶስ፤</para>
  <para style="q2" vid="HEB 10:5">ሀን ዳስታክ ዬፌና ካባሲክ ኤካ ይ፤</para>
  <para style="q2" vid="HEB 10:5">ማኣሲክቶኖናዋ ማባሲክቶኖና፤</para>
  <para style="q2" vid="HEB 10:5">ኔኪን ኣነ ሾሌፋት፤</para>
  <para style="q2" vid="HEB 10:5">ስኑንታኖ አቱሶን ታክ ሆሲት፦<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ኪቾን ማኣሲክቶክናዋ፤</para>
  <para style="q2" vid="HEB 10:6">ቦርኣሶን ፌሹን ኡክና፤</para>
  <para style="q1" vid="HEB 10:6">ደይ እምቴፋ ማኣሲክቶክ ኣነ ግሮዌ።<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ኤስ ካባሲክ ታ፦</para>
  <para style="q2" vid="HEB 10:7">« ‹ሀኦናሴ! ማፃፋሲክ ታ ቾዋሲክ ትቼናሲማቶ፤</para>
  <para style="q1" vid="HEB 10:7">ነ ፍቃዲሶን ኮእሱክቱ ያንዋ› » ይን።<verse eid="HEB 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8"/>ባር ደይ ቴሱስታ ኤስ ዉዛሲክቶ ቱማሲማቶ አዋስቴር ስንፋናክኑ፦ «ማኣሲክቶኖንናዋ ማባሲክቶኖንና፤ ኪቼፋ ማኣሲክቶነዋ ቦርኣሶን ፌሹን ኡክ እምቴፋ ማኣሲክቶነ አሲን ኣኔ ሾሎዌ። ኤስ ባሪክቶክ ደይ ኣነ ግሮዌ» ይ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ቱስሬ ደይ፦ «ኤሴ፥ ታ ፍቃድኔሶን ኮእሱናክቱ ያንዋ» ይ። ኤሲሲክ ሄፕሳኒሶን ኤደባሲ ዎልጉክ ቴሱኒሶን ሻሬፋ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ኤስ ፍቃድኔሲክ የሱስ ክርስቶስ አሻክ እሳርጋ ማአ ስንነ እምቴና ቦርአ እንኖ ኮርቶ ስኒዋ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ማግስ እሳርባ እሳርባስ ቦርኣሶን ትሽኩክ ችምኖይ ኤስ ማኣሲክቶኖን ዎልታፌ እሜት ዎንና ዎንና ዎስቴፌ። <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ስኑንታኖ ክርስቶስ ቦርኣሲክ እሳ ማኣሶን ኮእባ ፎንቶኖን እሳርጋ እምናኔን ኦርፎ ሀኦሲ ሆእታ ቴሽታ ድ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ሀንኔን ኤካሎ ጉማባሳክቶ ባሳ ዎቾሲ ስካሎሲ ስኖነኔን ኦዳና። <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ኤስ ባር ደይ ስንናስ ኮርቶ ስና ባሶትን እሳ ማኣስኪ ካሞ ቱም ዛግና ቦርአዋ። <verse eid="HEB 10:14"/><verse number="15" style="v" sid="HEB 10:15"/>ኮርቶ አያናስኑ ሀን ቾዋሲክ እኖክ ዛላ ማኮና። ቴሱስታ፦<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>«ኤስ ዎናሲክቶኔን ኦርፎ፤</para>
  <para style="q2" vid="HEB 10:16">ባሶኔን አነ ግሩና ቴያኒ ካማስ፤</para>
  <para style="q1" vid="HEB 10:16">ሀኒስዋ ይፌዋ ዳሚስ፤</para>
  <para style="q2" vid="HEB 10:16">ታ ቱማሶን ንብቤሲስ ፎናክ ዛጉና፤</para>
  <para style="q2" vid="HEB 10:16">ባሶ ካኑስ ደይ ትቹና» ይ።<verse eid="HEB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17"/>ቱስሬ ደይ፦ «ቦርቤሲሶንናዋ ኑሩቤሲሶንና፤</para>
  <para style="q2" vid="HEB 10:17">ሀንኔን ኤካሎ፤</para>
  <para style="q2" vid="HEB 10:17">ኣፋ ዎላ ሳፋሮና ዉዛ» ይፌ።<verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>ኤስ ባሪ ቦርኣ ቦርኣስ ዙቴራ ፌሹን ይስቴናኔን ኦርፎ ቦርን ፌሹን ኡክ እምቴፋ ማኣስ ሀንኔን ኤካሎ ኣፋ ፎና ዉዛ።<verse eid="HEB 10:18"/></para>
  <para style="s1">ሀኦስኪ ታእሶ ሾልሱ</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ኤሴ አይታሳክቶኖ! የሱስኒ ሀንናስኪ ካሞ ኮርቶሲ ኮርቶሲ ግሩኒክ ችማ ዳንኒዋ። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ግሩኒስ ይኑሲ ካሞ፤ ኤሲስ ደይ ባሳ አሻስኪ ካሞ ጋችና ጋድዶ ደይ ሀየዋ ስና ኡግናሲክዋ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ሀኦሲ ኬታ ሀእሱኒ ሁግናባ ፋና አካም ማግኒ ፌርዋ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ኤስ ባሪ ቦርኣ ማጙ ካኑኒስን ካይማኒክ ንብኒሶን ዊርቴራ፤ አቱኒሶን ደይ ካይማ አካክ ማሴራ፤ ካይማ ንብነዋ ቱማ አማንቶነ ኤጳ ሀኦስኪ ታእሶኒዋ። <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>አብድኒ ካማሶን እማ ባር አማናምቶ ስንና ቦርአ አማነኒ አብዲሶን ኤክ ሀጝ ኡኖይ ዛግራ ኤጳን። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ኬሽታናክናዋ ማአ ዎስቶክና ጉዝራ ፎኒክ እሳይስ እሳይሲክ ያዳሱዎ። <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ዎንና ዎንና እሳ ዳ ኡጰፋፋ እኖትና እኖትና ዎል ዛጉኒስታኖ እሳ እሳ ሜያ ዛግሴፌሲማቶ ዙቴፌኒ ዙቶሶን ቤያኒታ፤ አርክስራኑ ደይ ዳሚስ ዮና ዎናስ ታባሶን ያዳቴፋት ኤስ ባሮን ማእስራ ዛጉት። <verse eid="HEB 10:25"/><verse number="26" style="v" sid="HEB 10:26"/>ፉቶኒ አሩሶን ኤጳ ታኒኔን ኦርፎ አሪፋት ሾሌራ ቦርአ ዎስቴፋኒነ ሀንኔን ኤካሎ ቦርኒ ቾዋሲክ እምቶኒ እሳ ማአ ኣፋዋ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ስኑንታኖ ሀሽ ፉእቴ ባር ሀንኔንቲ ስንኒ ድግሱ ማጝሱኒ ካርኣሴዋ ኦምቴሴፌ ባሶትን ሙኒ ድግሱ ጌያሴዋ። <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሴኒ ቱማሶን ኣታ ባሳስታ ሄፕ ወደይ ኬዝ አሱኒ ሜያ ዛላ ማክሴፋቴነ ፋክያ ፎንቶኖን ክቱናክ ዛግቴር። <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ኤኪን ሀኦሲ ናኒን ካሺ ባር፤ አኮርቶ ስና ቴያኒ ካማሲ ሀንናኖን ኪንሲ ባር፤ ባክ እምቴ አያናሶን ሜአ ባር ኣካነ ፋ አካማ ኬኦ ባሪክ ሾልሱ ስንና ንቶክ ቤስቴፋሶ? <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>«ኮኒ ካስቶ ታርዋ፤ ታ ሾልሱ ኮዋሶን ካሱና» ይ ባር ኦ ስንናማቶ አርፌኒ። ኤሲስማቶ፦ «ሀኦስ ባሪ ዳራሳታ ማጝሱ ካርአር» ይፌዋ ዳሚስ። <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ኤስ ባሪ ቦርኣ ሀየዋ ሀኦሲ ኩሹሲ ጋንዶ አካማኖን ድግሱዋ። <verse eid="HEB 10:31"/><verse number="32" style="v" sid="HEB 10:32"/>ቻሬፋ ንቶክ ቻሬናኔን ሀንካሎ ሾዎ ሻና ኤጳ ታራ ፋክሴት ዜሞቲ ዎናሲክቶኖን ያዳቶሶትዋ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>እሳ እሳ ዎኖ አሱኒ ስና ሜቸት፤ ራካቴት። እሳ እሳ ዎና ደይ ኤስ ኤፋቴና ሻና ካርና አሱኒ ሜያኔን አነ ዞሞ ስነት ቦርአ ሻና ኤጳ ታሴት። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>ንቶ ማአር ደይ ዎንና ዎንና ፎኒ ኦትማኒት ሳማክ ፋናማቶ አሪት ቦርአ ታቶኒ ሜያክ ኬናሽቴትዋ። ንቶር ስና ፎንትስ ኦቴፋና ካባሲክ ፋክራ ኤስ ዉዛሶን ግራክ ኤጳ ታት። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ኤሴ አካማ ዎሱማ ዳናት አማንቶሶን ሀኡትታዋ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ሀኦሲ ፍቃድኖን ዛግራ ሀኦስ ንቶክ እማናክ ግሪና አብድኒ ካማሶን ዳናቲክ ፋክያክ ኦዳቲክቱ ሾልስፋዋ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ኤስ ባሪክ ደይ ኤካ ይስቴራ ትቼዋ፦</para>
  <para style="q1" vid="HEB 10:37">«ኤስ ዮኒ ባር ጋሮ ዎናኔን ኦርፎ ዮና፤</para>
  <para style="q2" vid="HEB 10:37">ኣፋ ደይ ዎካና ዉዛ።<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>ታር ስና ኦኮ አሱስ አማንቶክ ካክ ፎና፤</para>
  <para style="q2" vid="HEB 10:38">ስኑንታኖ ኦርፎ ዎልፋናነ፤</para>
  <para style="q2" vid="HEB 10:38">ባሪክ ኣፋ ግሮና ዉዛ።»<verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>ስኑንታኖ እንኖ አማነሬ ፋሪ ባሶ ኬንቴኖ ኦርፎ ዎልሴሬ ትሹኒ አሱኒ ሜኒ ኬንቴዋ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አማንቶኒ ቾዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>አማንቶ ኡስ አብድክ ኦዴት ፋኒ ዉዛሶን ሀን ባር ፉቶዋ ይሬ ኤጴቶዋ። ኣፋክ ቢስቶኖይ ዉዛሶኑ ቢስቴር ዛግሬ ፋዱዋ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>እቤቲ አሱኒ ሜያ ጋላታ ዳነቴስ አማንቶክዋ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>ሀን ዳስ ሀኦሲ ካማክ ቴስቴናማቶ አሩኒስ አማንቶክዋ። ኤስ ባሪ ቦርኣ ቢስቴፋ ዉዛ ዙቴራ ቢስቶኖስኪን ዎሱስቴናማቶ አሪፌኒዋ።<verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አቤል ካየልኒ ማኣስታን ዴናሎ ማአ ሀኦሲክ እምናስ አማንቶክዋ። ሀኦስ አቤልኒ እማሶን ግራክ ኤጳ ታፋና ካባሲክ አቤል አማንቶክ ኦኮ ስንባሶን ዛላ ማክቴ። አቤል ክትፌናክኑ አማንቶባስኪ ካሞ ሀሽኑ ማክቴድፌዋ።<verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖክ ክቱ ባሳስታ ካርኖይናማቶ ደን ሳማ ኦድቴናስ አማንቶክዋ። ሀኦስ ባሪን ኤጵና ቦርአ ኣነ ቤስቶዌ። ደን ኦቶባስኔን ስናክ ደይ ሀኦሶን ግርሲናማቶ ዛላ ማክቴዋ። <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>አማንቶ ፎንቶኖን ሀኦሶን ግርሱክ ኣፋ ችምቶና ዉዛ። ሀኦስኪ ታእሴፌ አሱ ሀኦስ ፎባሶንናዋ ባሮን ሾልሴፌ አሱኒ ሜያክ ደይ ዎሱማ ስንባሶን አማኖናክ ሾልሲፋዋ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>ሀሽኑ ኣፋክ ቢስቶኖይ ዉዛሲ ቾዋክ ሀኦስ ኖህኒን ቴትኔሶን ኦድዋ ይና ካባሲክ ኖህ ሀኦሶን ድጎክ ባሳ ኬርኪ ባሶትን ፉኦክ ሜርኬቢ ዎስቴናስ አማንቶክዋ። ኖህ አማንቶባሲክ ሀን ዳስ ቦርኣሲክ ማጝሱ ባርስታ ካቶናክ ዛግ። ኖህ አማንቶክ ቤስቴፋ ኦኮሶን ደይ ዋራሴ።<verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብራሀም ኬሪሴ ሪስትባ ዛግሬ ኤጴቶና ድማስታ ሀማናክ ቴግቴፌና ካባሲክ አይ ሀሚድፌናማቶ አሩ ቤይፌናክኑ ሀማናክ አጃጃሜናስ አማንቶክዋ። <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ይሳቅኒሲማቶናዋ ያቆብኒሲማቶና አብድኒ ዳስታክ እርባ ስንነ ዱርካኒስ ዲናስ አማንቶክዋ። <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ኤስ ባሮን ደይ ዛግናስ ዛጋ ካፕታባ ፋና ሀኦስ ኮፓኤና ባሮንናዋ ዎስቴና ኤስ ካታማሶንና ኦደት ፌር ስንና ቦርአዋ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳራ ደይ አብድ ባርክ እማ ሀኦስ አማናምቶ ስንናማቶ አሪና ቦርአ አዉነ ፋሮንኑ ኔባስ ኣትፋን ኮጶናክ ችምኖር ስንፋናክኑ ናኔርቶናክ ሁግና ዳናስ አማንቶክዋ። <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ኤስ ባሪ ቦርኣ ክት አሱኒማቶ ፋድቴፌ እሳ አብራሀምኒኪን ሳማኪ ባኩራሲማቶ አሪክራ ደይ ባርሲ ቴሻ ፋ ፉቱሲማቶ ፋድቶኖይ ዛላ ቤስቴዋ።<verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ኤስ ባሶ ዙቴሬ አማኖቤሲሴቱ ክትሴቴ። ሀኦስ ባሶክ እማናክ ቴያኒ ካማ ግርና ባሮን ኣነ ዳኖቶ። ስኑንታኖ ዎክሶክ ብያትቱ ሞሴሴቴ። ሀን ዳስታክ እርባ ደይ ኦጎ ስኖቤሲሶን አርሴቴ።<verse eid="HEB 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 11:14"/>ኤካ ማክሴፌ አሱኒ ሜያ ባሶር ስና ዳሶን ኦደት ፌሴቴማቶ አምማኖን ቤሲሴፌ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>ኤስ ቤየ ኬሴቴ ዳሶን ያዳቴሴቴ ስንፋናነ ኤክ ዎል ሌ ሀማክ ችሞነ ካባዋ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ስኑንታኖ ሀሽ ባሪስታን ደናሎ ስና ሳማኪ ፋ ዳሶንቱ ካልቴሴፌዋ። ኤስ ባሪ ቦርኣ ሀኦስ ባሶክ ካታማ ሆሲና ቦርአ «ሀኦኒ» ይሬ ቴግሴፋቴነ ባሮን ኣፋ ኢቹና ዉዛ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብራሀም ፋታንቴፌና ካባሲክ ይሳቅኒን ማአ ዛግሬ እምናስ አማንቶክዋ። ኤስ አብድኒ ካማሶን ኤጴቴ አብራሀም እሳ ናባስን ማአ ዛግሬ ሹካናክ ሆሬሬ ፌርዋ።<verse eid="HEB 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HEB 11:18"/>ኤሲሲክ ሀኦስ፦</para>
  <para style="q2" vid="HEB 11:18">«ይሳቅኒ ዛላሲክቱ ቴግቶና» ይት ማኬራ ፋር።<verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>ሀኦስ ክቱን ካብጉክ ችማር ስንባሶን አብራሀም አማኖባሲክ ክቱን ካብናንነ ፋ ቤሶክ ይሳቅኒን ሄፕሳ ዳዎልግሬ ዳኒ። <verse eid="HEB 11:19"/><verse number="20" style="v" sid="HEB 11:20"/>ይሳቅ ሀንኔንቲ ስንኒ ዉዛሶን ሳፋሮክ ያቆብንናዋ ሄሳዉንና ሱስናስ አማንቶክዋ።<verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያቆብ ክቱና ዎና ካርፋና ካባሲክ ዮሴፍኒ ናንጎታሲክቶኖኒን እሳርባ እሳርባሲክ ሱስናሴዋ ሃሮሲክ ግሜሬ ሳጋደናስ አማንቶክዋ።<verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሴፍ ደይ ክቱና ዎና ካርፋና ካባሲክ እስራኤልኒ ሜያ ግብፂን ኬሶነማቶ ማኬናስ ደይ ሜጋባሲ ቾዋኖን አዉ ዛግሶነማቶ አጃጅ እምናስ አማንቶክዋ።<verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሴኒን ኮኒ ባሶ ኮንቴፌና ካባሲክ ጋዳ ና ስንባሶን ብየቴ ቦርአ ታቶሳ አጃጅኖን ድጎኖይ ኬዝ አስሳ ኣችሴቴስ አማንቶክዋ።<verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴ ድችናኔን ኦርፎ፦ «ፌሬኦንኒ ናኒ ና» ይስቴሬ ቴግቶሶን ቤይናስ አማንቶክዋ። <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ኤስ ባሪ ቦርኣ ባር ቦርአክ ቤስቴፋ ጋሮ ዎን ኒ ግራስታን ሀኦሲ ዳራኔን አነ ሻና ኤጴቶሶን ኮሪ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ሀንኔንቲ ዳናና ዎሱማሶን ቢና ቦርአ ግጵጽኪ ኦትማስታን ደናሎ ሙድቶሳ ቦርአ ሳልጳቶስ አካማ ኦትማ ስንባሶን ሳፋሬ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ታቶሳ ግአኖን ደይ ድጎኖይ ግጵጽኒ ዳሶን ጋፍክሬ ኬስናስ አማንቶክዋ። ኣፋክ ቢስቶኖይ ሀኦሶን ቢናንነ ፋሮን ዛግሬ ሳፋራባሲክ ዛግ። <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ኡዛ ናንጎታሲክቶኖን ዎሩናክ አጃጃምቴ ሀኦሲ ዎሲያ እስራኤልኒ ሜኒ ኡዛ ናንጎታሲክቶኖን ዎሩኖይናማቶ ፋስካነዋ ሀርንኒ ዊርነ አሲ ቱማሶን ዛግናስ አማንቶክዋ።<verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>እስራኤልኒ ሜያ እችማ ዳስታክ ፍነፌስነ ፋሮን ስንነ ሸአ ባሪሶን ፍነሴቴስ አማንቶክዋ። ስኑንታኖ ግጵጽኒ አሱኒ ሜያ ኤካ ዛጉክ ካቤሴፌን ዙታምቤሲሴ አሲን አካስ ኮርእ። <verse eid="HEB 11:29"/><verse number="30" style="v" sid="HEB 11:30"/>እስራኤልኒ ሜያ እያሪኮኒ ኦጃሶን ናፉን ዎና ብራቴሴቴነን ኦርፎ ኦጃስ ቦግቴናስ አማንቶክዋ። <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ጌርኬስፋ ራሀብ ኣፍፎኒ ሜያኖን ናጋክ ኤጳታና ቦርአ አጃጃሞኖይ ባሶኔን አነ ክቱስን ፉእቴናስ አማንቶክዋ።<verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ኤስ ባርስታን ኦማ አዉ ኡናሪንሶ? ጌደዎኒ ቾዋሶን፤ ባራኪኒ ቾዋሶን፤ ሳምሶንኒ ቾዋሶን፤ ዮፍታሄኒ ቾዋሶን፤ ዳዊትኒ ቾዋሶን፤ ሳሙኤልኒ ቾዋሶን፤ ደይ ራጁኒ ሜኒ ቾዋሲ ቶቾኖን ማኮና እያናነ ዎና ኣፋ ሆሮና ዉዛ። <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ባሶ አማንቶክ ታቶስኪቶኖን ሜርሴቴ። ፉቶክ ማጝሱ ካርኤቴ፤ እምቴ አብዲሶን ደይ ዳነቴ። ኤቶሳ ኖኖኖን ኩልፍሴቴ። <verse eid="HEB 11:33"/><verse number="34" style="v" sid="HEB 11:34"/>ጌያሲ ሁግናኖን ትሽክሴቴ፤ ካጋ ሲፎስን አቴቴ፤ ሆፕቤሲስን ዛግ ስነቴ። ኔቦክ ችም ስነቴ፤ ቤትሬ ትሽኩክ የ፤ ጉማስን ካሌ ኮፉክሴቴ። <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ማሽካሱሲክቶ ባሶ ኬን ስነፋት ክት ባሶትን ክቱኒ ካብሴቴን ዳነሴቴ። ኦምኒ ሜያ ደይ ኤስ ባርስታን ደናሎ ስና ክቱን ካቡሶን ዳናክ ብርማዱማ ኬሳሶን ቤይፋት ሾዎ ቴሳ ሻና ኤጴቴሴቴ። <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>ኦሚስ ደይ ካሽስቴሬ እቼሴቴ፤ ኦሚስ ዎቾኒ ግኖክ ታቴሬ ታቶኒ ኬር ሀቴሴቴ። <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ሹአክ እቼሴቴ፤ ማጋዝክ ካላስቴሴቴ፤ ሲፎክ ዎርቴሴቴ፤ ፋንቱነዋ ፍዞነ አሲ ኮማ ማየሬ አካማኖን ሻና ኤጴቴሴሬ ካቡግቴር ስነሬ ብራቴሴቴ። <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ዛቦሲ፤ ኣማስታ፤ ዳስ ስካሎሲ ፋ ዱጋዱግሲኔን ራታኤሴቴ። ሀን ዳስ ባሶክ ኣነ ማሎዋ። <verse eid="HEB 11:38"/><verse number="39" style="v" sid="HEB 11:39"/>ኤስ ባሶ ዙቴሬ አማንቶቤሲሲ ቦርአ ባሶክ ዛላ ማክቴር ሲንፋናክኑ እምቴ አብዲሶን ኣነ ዳኖቶ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ሀኦስ እኖክ አካማ ማአ ዉዛ ኮፓኤ። ኤስ ባሪ ቦርኣ እኖኔን አነታኖ ባሶ ባሶ ቱም ስኖነክ ኣነ ችሞሶቶ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ሀኦስ ናንጎትባሶን ኬእር</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ሻሩኒማቶ ብራቶኒስታ ፋ ሾዎ ዛላሲክቶ ፋናኔን እኖስታ ባአኒማቶ ፋይያ ፋ ዉዛሶን ዙትራ ደይ እኖስታ ታጵቴራ ፋ ቦርኣሶን ትሽክራ ስንኒስታ ፋ ኣቶ ኣቶኒ ኤላሶን ፋክያክ ዛግራ ኤላኒ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ኤላኒስ ደይ እንኖ አማንቶሶን ካፑቴ ደይ ኮእባ ካቱኒር ስና የሱስኒን ቢራዋ። ባር ስንባስታኪ ፋ ግራሲክዋ እያት ሜስቀልስታኪ ክቱኒ ሳልጲናሶን እሳ ዉዛነ ዛግሬ ፋዱኖይ ሜስቀልስታኪ ሻናኒ ክቱሶን ፋኪ። ሀኦሲ ዝግሞኒ ሆእታስታ ደይ ድ። <verse eid="HEB 12:2"/><verse number="3" style="v" sid="HEB 12:3"/>ኤሴ ኦምቶኖይናዋ አብድ ቡጉኖይና ሀን ቦርኒ ሜኒ ቱጋኦሶን ፋኪ የሱስኒን ቢት። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>ንቶ ቦርአኔን አነ ካቦክ ሀርንኒ ዉኩታኔን ካርአ ኣነ ቱጋኦዌሴቲዋ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ሀኦስ ናንጎትባሪማቶ ዛግራ ኤካ ይት ኪትና ኪቶሶን ዳጌትዋ።</para>
  <para style="q1" vid="HEB 12:5">«ናታሶ! ዳሚሳ ኬኦኖን ካሹታታዋ፤</para>
  <para style="q2" vid="HEB 12:5">ኔን ኬእፌና ካባሲክ አብድ ቡጉታታዋ፤<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ዳሚስ ሹንና ባሪን ኬእር፤</para>
  <para style="q2" vid="HEB 12:6">ናባ ዛግሬ ቢፌና ባሪን ደይ ሱስር።»<verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ሀኦስ ናንጎትባሪማቶ ዛግራ ፋድፋና ቦርአ ኬኦሶን ፋኩት። አባባስ ኬኡኖይና ና ኣፌሪንሶ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ናንጎታ ስና ባርኪቶ ዙቴራ ኤጳ ታሴፋና ኬኦሶን ንቶ ደይ ኤጳ ቶ ሻካትነ ኦም አባኒኪን ኮንቴርታኖ ኬርኪ ናንጎታታዋ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ኤስ ባርኔን ደናሎ እኖትን ኬኢ ኮኒ አባኒ ሜያ ፌሴቴር። ባሶትን ደይ ኡልፍንስቱ ፋፌኒ። ኤኪን ካክ ፎክ አያናስቶኒ አባኒስን አካማኖን አጃጃሞኒክ ኣካክ ሾልሱ ቤይንሪንሶ?! <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ባሶክ ማአሪ ስንና ቤስቴናሲማቶ ጋሮ ዎናኖን እኖትን ኬእሴሴቴ። ስኑንታኖ ሀኦስ ባሪ ኮርቶሶን ሃኤር ስናኒክ እኖክ ኬኒ ዉዛክቱ ኬእፋ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ኬኦስ ዙቴራ ኤስ ካባሲክ አሱ ሱሞናክቱ ዛግፋታኖ ግሮናክ ዛጉኒር ስንና ኣነ ቤስቴፋ። ስኑንታኖ ሌጅስቴሬ አሪ አሱኒ ሜያክ ናጋ ቱምና ኦኮ ስናክ ቤስቴፋ ጋናሶን ዳኖነክ ዛጊፋ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ኪቶነዋ ኬኦነ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ኤስ ባሪ ቦርኣ ጎድባ ሻኪ ኩሹንትሶንናዋ ሆፒ ግዶሶንና ዛጉቲ። <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ኤጝታ ባር ፋሩናክታኖ ድምባስታን ሻቴራ ሾርኮኖይናማቶ ዎቾንትሲክ ዜጵቶ ኡግና ሆሱቲ። <verse eid="HEB 12:13"/><verse number="14" style="v" sid="HEB 12:14"/>ኮርቶ ፎክ ፎኖይ ኦኑ ዳሚስን ብያክ ኣፋ ችማናዉዛ ስንና ቦርአ አስሱ ዙታምባሴኔን አነ ናጋክ ፎቲ። ኮርቶ ፎኒ ፎክ ደይ ዱዶሶቲ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>ንቶስን ኦኑ ሀኦሲ ኦትማ ዮኡኖይናማቶ ቴትኒትሶን ኦድቲዋ። ኤሲስማቶ ደይ እሳ ሱቃሮኒ ታሳ ጋነንትሲ ካዩኖይናማቶናዋ ራክሱኖይናማቶና ሾዎኒ ሜያኖን ደይ ኪንሱኖይናማቶ ቴትንቶሶን ኦድቲዋ። <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ዎቤታ ስንና ወደይ እሳርጋ ሙና ሙሲክዋ እያት ኡዙን ስንባሶን ዋጌ ሄሳዉኒሲማቶ ዝናባ ፌና አሱ ፎኖይናማቶ ቴትኒትሶን ኦድቲዋ። <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ኦርፎ ደይ ሄሳዉ ሄፕሳ ኤባ ዳናናክ ሾሌፌና ካባሲክ ኤስ ኤባስ ካልቴናማቶ አርፌት። ዋስትኑ ኤስ ኤባሶን ጉዝሬ ሾሌፌናክኑ ዳናናክ ኣነ ችሜ። ሀርምሬ ዎሉክኑ እሳ እጣ ኣነ ዳነ። <verse eid="HEB 12:17"/><verse number="18" style="v" sid="HEB 12:18"/>ንቶ ኩሹክ ታእቴፋ ደይ ኪቼት ፋ ሲናኪ ኣማስኪ<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">«ሲናን ኣማሲክ» ይፋ ባር ግሪክኒ ማፃፋሲ ኣፋ</char></note>፤ ኤክ ክእናስኪ፤ ደይ ኤክ ታልማስኪ፤ ኤክ እፑዋስኪ ኣነ ካርኤቲ፤ <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>ኡሉለኒ ካማ ወደይ ማክቴት ፋ ካማስ ኦድቴፋናስኪ ኣነ ካርኤት። ኤስ ካማሶን ኦደ አሱኒ ሜያ፦ «ሀንኔን ኤካሎ ኦማ ካማ እኖክ ማክቶናታ» ይት ሺጵሴቴ።<verse eid="HEB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HEB 12:20"/>«ዋጋ ኣማሶን ታእፋናነ</para>
  <para style="q2" vid="HEB 12:20">ሹአክ እቼራ ክቱን።»</para>
  <para style="m" vid="HEB 12:20">ይፋ አጃጂስ ፋይና ቦርአ ዎርአክ ኣነ ችሞቶ።<verse eid="HEB 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="HEB 12:21"/>ቢስቴ ዉዛስ አካማኖን ድግሱ ስንና ቦርአ</para>
  <para style="q2" vid="HEB 12:21">ሙሴኑ፦ «ድጌን፤ ደይ ኮርኪን» ይ።<verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>ስኑንታኖ ንቶ ፂዮንኪ ኣማስኪ ታእሴትዋ፤ ባር ደይ ሀየዋ ሀኦሲ ካታማ ሳማኪ የሩሳሌምዋ። ግራክ ዙቴሴ ሾዎ ኩማ ፋድቶኒ ሀኦኒ ዎስያሲክቶኪ ታእሴሴትዋ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ሱንቤሲስ ሳማክ ትቼና፤ ኡዛኒ ሜኒ ማባራስኪ፤ ዙታምባሴ አሲስታ ማጝሱ ካርኒ ሀኦስኪናዋ ቱም ስናሶን ዳነ ኦኮኒ ሜኒ አያናሲክቶኪና ታእሴትዋ። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ጋድዶ ቴያኒ ካምኒ ጋነያ ስና የሱስኒኪ፤ አቤልኒ ሀንናስታን ደናሎ ስና ባሮን ማኬፋ ባርኪናዋ ዊርቴ ሀንናስኪና ታእሴት። <verse eid="HEB 12:24"/><verse number="25" style="v" sid="HEB 12:25"/>ኤስ ባሮን ማኬፋ ባሮን ኣፋ ኤጳቶኒ ዉዛ ኡኖይትማቶ አሩትዋ። ኤስ ሀኦ አሱኒኪ ካሞ ዳስታኪ ማኬፋና ካባሲክ ኣፋ ኦዶን ዉዛ ይሴ ባሶ አቴ ኬሳ ሻክሴቴነን ኤኪን አሩትዋ ይስቴራ ሳማን ማክቴ ባሮን ኤጳ ቶ ሻካኒነ ኣካክ አቴ ኬሳክ ችማንሪንሶ? <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ኤስ ካባሲክ ካምባስ ዳሶን ሾርኪ። ስኑንታኖ ሀሽ «ዳሶን ኮእባ ስኖይናሮን እሳርጋ ሄፕሳ ሳማሶን ጌዳ ሾርኩና» ይት ቴያ ግሪ። <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ኤስ፦ «እሳርጋ» ይፋ ካማስ ቤሲፋናስ ሾርኮኖይ ዉዛሲክቶ ዛግራ ፎናክ፤ ሾርኬፋ ባር ወደይ ቴስቴ ዉዛሲክቶ ትሽክቶኒር ስንባሶጝዋ። <verse eid="HEB 12:27"/><verse number="28" style="v" sid="HEB 12:28"/>ኤሴ እንኖ ሾርኮኖይ ታቶሶን ኤጳቶኒር ስንና ቦርአ ሀኦሶን ጋላቶኒዋ። ባሪን ግርሱኒ ኡግናክ ኡልፍናክናዋ ድጋክና ባሪክ ዎስቶኒዋ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>ፉቶሲክ ሀኦኒስ ኪችፋ ጌያስዋ።<verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ሀኦሶን ግርሲፋ ዎስቶ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>ዎንና ዎንና ንቶትና ንቶትና አይና አይና አሲ ኬሽታንቲ ፎን። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>እርባኒን ኤጴ እርባሱሶን ዳጎትታ። ኤካ እርባኒ ሜያኖን ኤጴቴሴሬ እርባሲት ፌሴቴን እሳ እሳ ሜያ አሩኖይ ሀኦሲ ዎሲያኖን ኤጴ እርባሲሴቴ። <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ባሶኔን አነ ታቴትነ ፋሮን ዛግራ ታቶኒ ሜያኖን ሳፋሮት። ንቶ ደይ ባሶሲማቶ ሻና ኤጴቴርነ ፌር ስንና ሻና ኤጴቴሴፌ ባሶትን ሳፋሮት።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>ኤጵነ ግሩነ ዙታምባሴ አሲክ ኡልፍንቶ ስኑን። ዎቤታ ስነፌ ባሶስታናዋ ጌርኬሴፌ ባሶስታና ሀኦስ ማጝሱ ካርኒር ስንና ቦርአ አባነ እንቶነ አማንቶ ዮእግሴሬ ኤጵነ ግሩነ አሲን ኪንሱሶኔታ። <verse eid="HEB 13:4"/><verse number="5" style="v" sid="HEB 13:5"/>ዋግኒ ኬሽታናስታን ዎክት፤ ንቶክ ፋዪስ ሆሮና፤ ሀኦስ፦ «ኣፋ ሀኡና ዉዛ፤ ደይ እሳንነ ኣፋ ቤያና ዉዛ» ይዋ።<verse eid="HEB 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 13:6"/>ኤስ ባሪ ቦርኣ አማንቶክ፤</para>
  <para style="q2" vid="HEB 13:6">«ዳሚስ ታን አሪጋሱናዋ፤</para>
  <para style="q2" vid="HEB 13:6">ኣፋ ድጎና ዉዛ፤</para>
  <para style="q2" vid="HEB 13:6">አሱ ታን አዉ ዛጉክ ችምኒርን?» ይፌን።<verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ሀኦሲ ካማኖን ዜምሜ ንቶክ ማኬ ዞንስንትሳክቶኒን ዳጎትታ፤ ባሶ ፎሶንናዋ ዎስቶቤሲስ ጋናኖንና ሳፋሮክ አማንቶቤሲሲክ ዞኑስቶሶት። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>የሱስ ክርስቶስ ሀዞ ስኑን ሀውጙ ደይ ኮእባኔን ካርኤ ባርኑርዋ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ኦራ ኦራ ቴሳ አሱክ ኦቴራ ሀማትታ። ንብኒስ ሙኒ ስትሪሶን ኦዳክ ስኖይናማቶ ሀኦሲ ኦትማክ ስንፋንነ ማአርዋ። ኤስ ሙኒ ስትሪሲክ ዞኑስቴ አሱኒ ሜያክ ኣነ ኬአ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>እንኖ እምፌኒ ሾአ ፋር። ስኑንታኖ ዱርካኒሲ ዎስቴሴፌ ማግኒ ሜያ ኤስ ማአ እምቴፋና ሾኣስታ ፋ ሙሶን ኤጴ ሙ ኣነ ፋቃድቶዋ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>አይሁድኒ ሜኒ ማግኒ ጋኝኜ ሜኒ ጋኝኛስ ቦርኒ ፋኪኒ ዳና እምፋ ዋግኒ ሀንናሶን ኤጴ ኮርቶሲ ኮርቶሲ ግሪፌ። ስኑንታኖ ክት ዋጋሲ አሻ ኬኤስን ጌሮ ኬስሳ ኪቼፋ። <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ኤሲሲማቶ የሱስ ዳራስን ባሳ ቴትኒ ሀንናሲክ ኮርቶ ዛጉናክ ካታማሲ ፍኛኔን ጌራካሎ ሻና ኤጴቴ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ኤሴ እንኖ ደይ ኬኤሲን ኬስሳ ባርኪ ሀማኒ። ባር ኤጴቴና ሳልጲናሶን ደይ ሃኤር ሲናኒ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>እንኖ ሀንኔንት ዮኒ ካታማሶንቱ ኦድትፌኒታኖ ሀን ዳስታክ ዛግራ ፎኒ ካታማኒ ኣፋዋ። <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>ኤሴ የሱስ ክርስቶስኒኪ ካሞ ጋላትኒ ማኣሶን ዬቱኖይ ሀኦሲክ እማኒ። ኤሲስ ደይ ሱንባሲክ ዛላ ማኬፋ ኖኖስኪን እምቶኒ ጋላትኒ ጋናስዋ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ማአ ዉዛ ዛጉሶንናዋ ንቶክ ፋዪሶን ኦሚሲክ ሃአሶንና ዳጎትታ። ሀኦሶን ግርሲፋስ ኤስ ኤፋቴና ማኣስዋ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>ንቶ ዞንሲሳክቶኒክ አጃጃሞት። ባሶ ሀእሱሲ ስካሎሲ ስኖት። ባሶ ንቶ ካሲ ቾዋክ ማሙስቶሶነ ዉዛ ፋር ስንና ቦርአ ጉዝሬቱ የርሴፌ። ንቶ ባሶክ አጃጃሜፋትነ ዎስቶቤሲሶን ግራክ ዎስቶሶነ። ኤስ ባር ስንና ሻካናነ ዎስቶቤሲሶን ሱሞክቱ ዎስቶሶነ። ኤስ ባር ደይ ንቶትን ሚርኤር።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>እኖክ ሺጶት፤ ካይማ ካኑኒ ፋር ስንናማቶ ፉቶክ አሪራቱ ፋኒ። ኣፋ ኡግናክኑ ስኑን ማአ አማላክ ፎኒክቱ ሳፋሬፌኒ። <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>አካማኖን ጉዝራ ሺጶትክ ዛግራ ማምሲፋናስ ታፕታክ ንቶኪ ዎል ላ ዮናክዋ።<verse eid="HEB 13:19"/></para>
  <para style="s1">ኮእኣስታኪ ኤባ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ፋንቱሲክቶኒ ኬሜር ስና አርኪ ዳምኒ የሱስኒን ኮእባ ፎንቶ ቴያኒ ካምኒ ሀንናክ ክቱን ካብግ ናጋኒ ሀኦሲ፤ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ፍቃድባሶን ኮእሱክ ችማትክ ማአ ዉዛ ዙታምባሴ አሲክ ንቶትን ቱም ዛጋዉጝዋ። ባሮን ግርሱኒ ዉዛሶን ደይ የሱስ ክርስቶስኒኪ ካሞ እንኖስሲ ዛጉን። የሱስ ክርስቶስኒክ ኮእባ ፎንቶኖን ኡልፍና ስኑን! ኣሚን!<verse eid="HEB 13:21"/></para>
  <para style="s1">ኮርኡባ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>አይኒ ሜያነ! ሀን ንቶክ ካዉናኖን ትችና ሀን ኪቶኒ ዎሲያሶን ፋኪያክ ኤጳቶትክ ዛግራ ሺጴፋዉጙዋ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>አይኒ ትሞትዮስ ታቶኒ ኬሩን ኬስንናማቶ አሩትክ ሾሌፋኡጙዋ። ታእኖን ሀኒ ዬፋናነ ባርኔን አነ ያራ ንቶትን ብያናዋ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>ንቶትን ዞንስፌ ባሶክናዋ ሀኦኒ አሱኒ ሜያክና ዙትራ ናጋ ማኮት። ጣልያኑን ስና ባሶ ናጋ ንቶክ ኦሸሴድቴ። <verse eid="HEB 13:24"/><verse number="25" style="v" sid="HEB 13:25"/>ሀኦሲ ኦትማ ንቶኔን አነ ስንፋውጝዋ! ኣሚን!<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
