<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">-Yemsa New Testament</book>
  <para style="h">ማርቆስ</para>
  <para style="toc1">ማርቆስኒ ምስራቹኒ ካማ</para>
  <para style="toc2">ማርቆስ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆስ ትችና</para>
  <para style="mt2">ዳም የሱስ ክርስቶስኒ ምስራቹኒ ካማ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ማርቆስኒ ምስራቹኒ ካማስ፦ «ሀን ሀኦሲ ና የሱስ ክርስቶስኒ ምስራቹኒ ካማሲ ቴሱ» ይትቱ ማኬፌዋ። ሀን ምስራቹኒ ካማስ የሱስ ዎስቶኒ አሱናዋ ሀእሱኒ ሁግናባ ፋና አሱና ስንነቱ የ። ሀእሱኒ ሁግናባስ ደይ አስሱባሲክ፤ ኪና አያናስታ ፋ ሁግናባሲክናዋ አሱኒ ቦርኣሶን ፌሹን ኡባሲክናቱ አምማኖን ኬስሳ ቢስቴ። የሱስ፦ «ታ አሱኒ ሜያኖን ቦርኣሲ ቦዝሱስን ብርማዱምማ ክሱናክ ካናሶን ፉሮኒር ዛግራ እማናክ የ አሱኒ ናዋ» ይሬቱ ባር ቴትባሲክ ማኬ።</para>
  <para style="ip">ማርቆስ የሱስኒ ቶቾሶን ቤሲናስ ዜጵቶነዋ ሁግናክ ቱማ ኡግና ስንፋት ዛጊግሬ ማኬናስ ደይ የሱስኒ ካማስታንናዋ አስሱስታንና ስኖይናሮን ባር ዎስቴና ዲንቂ ዎስቶሶንዋ። ሀጵቅፌ ዮሀኒስኒ ቶቾሲክ ደይ፤ የሱስኒ ሀጱቅቶሴዋ ፋታንቶሴ አሲክ ካዉና ጋችግሩ እምናኔን ኦርፎ ትችፌ ባር የሱስኒ አስሱሲ ቾዋኖንናዋ ሜሮስን ፋቱባሲ ዎስቶኖንናቱ ኮቴ ማኬፌ። ዎንናኔን ኦርፎ የሱስኒክ ዞኑስቴፌ ሜያ የሱስኒን ማእስሬ አርሴት ሀሜቴስንነ ፋሮን የሱስኒን ቱጋሴፌ ባሶ ደይ አርክስሬ ኦምቴሴት ሀሜቴርዋ። ኮእኒ ኤዴሲክቶ የሱስኒ ካስታ ኮእኒ ቶርባኒሲ ዛግቴ ዉዛሲክቶኖን፤ አሪክሮን ደይ ባሳ ሱቶሴዋ ባሳ ክቱን ካቡሴ አሲንቱ ማኬፋ።</para>
  <para style="ip">ምስራቹኒ ካማሲ ኮእታ ኩኒ ሄፕ ባግቶሲክቶስን እሳ እሳ ትቻሲክቶሲ ኮእባቱ ፋርዋ።</para>
  <para style="iot">ትቻስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ምስራቹኒ ካማሲ ቴሱ <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">የሱስ ባሳ ዎስቶሶን ጋሊላክ ዎስቶባስ <char style="ior"><ref loc="MRK 1:14-9:50">1:14—9:50</ref></char></para>
  <para style="io1">የሩሳሌም ሀምሜ ዎስቶባስ <char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char></para>
  <para style="io1">የሩሳለሙክናዋ ብራቶስታና ፋ ኬኤሲ ኮእኒ ቶርባኒሴ <char style="ior"><ref loc="MRK 11:1-15:47">11:1—15:47</ref></char></para>
  <para style="io1">የሱስኒ ክቱን ካቡ <char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref></char></para>
  <para style="io1">ክቱን ካቢ ዳሚሳ አምማኖን ቤስቶነዋ ደን ሳማ ሀምነ <char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ሀጵቅፌ ዮሀኒስኒ ምስራቹኒ ካምኒ ማኮ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማት. 3:1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3:1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሀ. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ሀኒስ ሀኦኒ ና<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fk" closed="false">ሀኦኒ ና፦ </char><char style="ft" closed="false">ሀኦኒ ና ይፋ ባር እሳ እሳ ማፃፋሲ ኣፋ</char></note> ስና የሱስ ክርስቶስኒ ቾዋሶን ማኬፋ ምስራቹኒ ካማሲ ቴሱዋ። <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ራጁ ስና ኢሳያስኒ ማፃፋስሲ፦</para>
  <para style="q1" vid="MRK 1:2">«ኡጉኔሶን ሳብሱኒ ዎስታርን፤</para>
  <para style="q2" vid="MRK 1:2">ነ ስናስታ ዜምማ ዎሱናዋ»<verse eid="MRK 1:2"/></para>
  <para style="m">
    <verse number="3" style="v" sid="MRK 1:3"/>ደይ፦</para>
  <para style="q1" vid="MRK 1:3">« ‹ዳሚሳ ኡግናኖን ሆሱት፤</para>
  <para style="q2" vid="MRK 1:3">ሳብስራ ደይ ማእሱት› ይት፤</para>
  <para style="q2" vid="MRK 1:3">ኢችማ ዳስ ሲ ቻግፌ አሱኒ ካማ።»</para>
  <para style="m" vid="MRK 1:3">ይስቴራ ትቼዋ።<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ኤስ ባሪ ቦርኣ ሀጵቅፌ ዮሀኒስ ኢችማ ዳስ ሲ፦ «ቦርኒትስ ፌሹን ኡስቶናክ ሀርምራ ሀጱቅቶት» ይት ማኬት የ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ዩዳኒ ዳስታክናዋ የሩሳሌምኒ ካታማስና ዙቴሬ አካም ሾዎ አሱኒ ሜያ ዮሀኒስኒኪ ዬሴሬ ቦርቤሲሶን ሀርምፋፌ ዮርዳኖስኒ አካስሲ ባሪክ ሀጱክቴሴት ፌሴቴር።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ሀጵቅፌ ዮሀኒስኒ ማማስ ደይ ጋላኒ ኤሳክ ውቾኖንቱ ማይፌ። ጌሾባሶን ደይ ታልፋክቱ ታርኤፌ። ሙባስ ደይ ብልጛነዋ ዛቦኒ ኤስስነ። <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>አሱኒ ሜያክ፦ «ታ ሙግራ ቻኣማባሲ ታርአኖን ኮታክ ሾልሱኖይናር ታይስታን አካማኖን ኡልፍንቶ ታ ኦርፎስታ ዮኒር። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>ታ ንቶትን አካክቱ ሀጵቁና። ስኑንታኖ ባር ኮርቶ አያናክቱ ንቶትን ሀጵቁና» ይት ማኬት ፌር።<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱስኒ ሀጱቅቶነዋ ፋታንቶነ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማት. 3:13-17</ref>፤ <ref loc="MAT 4:1-11">4:1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3:21-22</ref>፤ <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>ኤስ ካባሲክ የሱስ ጋሊላኪ ዳስታ ፋ፤ ካታማ ናዝሬቱን ዬሬ ዮርዳኖስኪኪ አካስሲ ዮሀኒስኒክ ሀጱክቴ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>ጌሬጌሬ የሱስ አካስን ኬስፌና ካባሲክ ሳማስ ጋቼፌንናዋ ሀኦኒ አያና ናካሎኒማቶ ስንና ባሳስታ ኬሬፌንና ቢ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ኤስ ካባሲክ፦ «ሹንፋና ናታ ነዋ። ኔክቱ ታ ግሬፋውጙዋ» ይፋ ካማ ደን ሳማን ኦድቴ።<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ጌሬጌሬ ኮርቶ አያና ባሪን ኢችማ ዳስ ሲ ታሚ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>ኢችማ ዳስ ሲ ሴጣናክ ፋታንቴት አቼቻስር ዎና ድ። ቡርኡኒ ጎኞኔንቱ ፌ። ሀኦኒ ዎስያስ ደይ ያራ ባሪን አርጋስሴ።<verse eid="MRK 1:13"/></para>
  <para style="s1">ቴሱኒ ናዎኒ ሜኒ ኮርቶ</para>
  <para style="r">(<ref loc="MAT 4:14-17">ማት. 4:14-17</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዮሀኒስ ታቶኒ ኬር ግሪናኔን ኦርፎ የሱስ ሀኦሲ ምስራቹኒ ካማኖን ማኬት ጋሊላ ሀሚ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>አሲፌና ካባሲክ ደይ፦ «ዎናስ ኮእ፥ ሀኦሲ ታቶኒ ሀእሱስ ታእሴ። ቦርኒትሶን ሀርምራ ምስራቹኒ ካማሲክ አማኖት» ይት ማኬት ፌር።<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>የሱስ ጋሊላኪ ባርሲ ቴሻ ካሞ ኣትፌት ዎስቶቤስ ቁርጡምኒ ኤሻ ስና ስሞንናዋ አይባ እንድርያስና ዩጉዶቤሲሶን አካስሲ ሀእሴፌን ቢ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>የሱስ ደይ ባሶክ፦ «ታኔን አነ ዮትዋ። ኤካት ሀኦሲ ታቶሲ አሱኒን ዙቱትክ ዛጉናዋ» ይ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ባሶ ደይ ጌሬጌሬ ዩጉዶቤሲሶን ቤይፋት ባርኔን አነ ሀሜቴ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>ኤስታን ጋሮኖን ኤክሴፌና ካባሲክ ዛብድዮስኒ ናንጎት ያቆብናዋ አይባ ዮሀኒስና ፌሴቴር። ባሶ ጎኑስታ ዲሴፋት ዩጉዶቤሲሶን ማእሴፌን ቢ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>ኤስታን ጌሬጌሬ ሀጝ ባርኪ ዮሶነክ ቴጌ። ባሶ ደይ አባቤስ ዛብድዮስኒን ዎስትኛሳክቶኔን ጎኑስታ ቤይየ ሀኣት ባርኔን አነ ሀሜቴ።<verse eid="MRK 1:20"/></para>
  <para style="s1">የሱስ ኪና አያናሶን ክስ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>የሱስናዋ ናዎባሳክቶና ክፍርናሆም ካታማ ሀሜቴ። ጌሬጌሬ የሱስ ቤይሳኒ ዎናሲክ አይሁድኒ ሺጶኒ ኬያስሲ ግሪሬ አሱ ኤጲ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>የሱስ ሙሴኒ ቱማሲ አስሲኛኒ ሜያ አሲሴፌማቶ ስኖይናሮን ዳሶን ሀእሲፌ ባሶሲማቶ ስንና ቦርአ አሲፌና አሱሲክ ዲንቀሴቴ።<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>ኤስ ካባሲክ አይሁድኒ ሺጶኒ ኬያስሲ ኪና አያና ኤጵና እሳ አሱ ኤካ ይት ቻጊ፦ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>«ናዝሬትኪ የሱስኖ! እንኖ ነኔን አዉኒ እሳርኒ ፋሪንሶ? እኖትን ትሽኩታክ ያታሮሶ? ነ ኦ ስንታማቶ ታ አሪፋውጙዋ። ነ ሀኦሲ ኮርቶዋ!»<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱስ ደይ፦ «እሳ ካማ ኮትኖይ ባሳስን ኬስ!» ይት ችኒሬ ኬእ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ኪና አያናስ አሱስን ጋንስራ ቶኮናክ ዛግራ አካማ ካማክ ቻግጋ ባሳስን ኬስ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>አሱኒ ሜያ ዙቴሬ ዲንቆክ፦ «ሀን ባር ኣምባንሶ? አሮን ጋድዶ አስሱንሶ? ኪና አያናሶን ሀእሱኒ ሁግናክ አጃጀን ባሪኪቶ ደይ አጃጃሜር» ይት ባሶትና ባሶትና ማምሲት ፌሴቴር።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>ጌሬጌሬ የሱስኒ ቾዋሲ ዎል ላ ጋሊላኒ ብራቶስታ ፋ፤ ዳ፤ ዙታምባሴ አሲስ ዝእ።<verse eid="MRK 1:28"/></para>
  <para style="s1">የሱስ ሾዎ ሜታንኒ ሜያኖን ፋቲ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማት. 8:14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>ኤስ ካባሲክ የሱስ አይሁድኒ ሺጶኒ ኬያስን ኬስሴ ያቆብኔን ዮሀኒስኔን አነ ስሞንናዋ አንድርያስና አሲ ኬር ግሪ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ኤስታክ ስሞኒ አሱሲ እንቶ ጉምታኒ ሜሮ ሜቴራ ኩንፋር። ባሪ ሜቶሶን ጌሬጌሬ የሱስኒክ ማክሴቴ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>የሱስ ባርኪ ታእሴሬ ኩሹባስሲ ዛትቴ ካብግ። ሜሮስ ደይ ማእን ካብራ ባሶትን እርባሲ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>አዋ ግሪን ታልሜፋና ካባሲክ አሱኒ ሜያ ሜታንኒ ሜያኖንናዋ ኪና አያና ኤጵና ሜያኖንና ዙትሬ የሱስኒኪ ኤጴ ዬሴቴ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካታማስሲ ፌ አሱኒ ሜያ ዙታምቤሲሴ ኬያሲ ፎቻታ ዙቴሬ ፌሴቴርዋ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱስ ሾዎ ቴሳ ሜሮክ ሜቴሬ ፌ ሾዎ አሱኒ ሜያኖን ፋቲ። ሾዎ ኪና አያናሶን ደይ ክሲ። ኪና አያናስኑ ባር ኦ ስንናማቶ አርሴራ ፋሴር ስንና ቦርአ የሱስ እሳ ዉዛነ ማክሶናክ ኣኔ ሾሎዌ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱስ ሻቶ ድምታ ሀምሜ ሺጴ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>ዎንሳ ዋስሲ ካብሬ ዎኖይፌን የሱስ ኬሩን ኬሴ እሳ ፉችቻ ድማ ሀምሜ ሀኦ ሺጴ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስሞንናዋ ባርኔን አነ ፌሴ ባሶትና ሾሎክ ካቢ ሀሜቴ። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ዳነሬ፦ «አሱ ዙቴሬ ኔን ሾሌድፌርዋ» ይሴቴ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>የሱስ ዎልግሬ፦ «ታ ያናስ ኤሲሲክ ስንና ቦርአ ሀንታን ኦማ ታእሶ ድማስታ ፋሴ ካታማስሲ ደይ ሀምፋኒ ካምባሶን ማኮጝዋ» ይ።<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>አይሁድኒ ሺጶኒ ኬያስሲ ካምባሶን ማኬት ኪና አያናሶን አሱሳስኒ ኪስት ጋሊላኒ ዳ ዙታምባሴ አስሲ ኩቲት ፌር።<verse eid="MRK 1:39"/></para>
  <para style="s1">የሱስ አዋታቶኒ ሜታኒስን ፋቲ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማት. 8:1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ. 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>እሳ አዋታቶኒ<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="fk" closed="false">አዋታቶኒ፦ </char><char style="ft" closed="false">ግሪክኒ ማፃፋሲታክ አዋታቶኒ ሜሮ ይፋ ባር አቱታ ኬስፋ ሜሮ ዙታምባሴ አሲንቱ ቤስፋ።</char></note> ሜታን ባርኪ ዬሬ ካአነፋት፦ «ነ ሹንፋታኔ ታን ፋቱክ ችማታዋ» ይት ሺጴ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱስ ባሪክ ኬናሽቴፋት ኩሹባሶን ሾሬ አቱባሶን ታፕትሬ፦ «ሹንፋኡጝዋ፥ ካይማ» ይ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>አሱስ ደይ ጌሬጌሬ ሜሮባስን ፋሪ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱስ አሱስን ማእስሬ ኪትሬ ጋፍካት፦ <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>«ሀን ባሮን ኦንኒክኑ ማኮኖይታማቶ አሩዋ። ስኑንታኖ ሀምማ ቴትኔሶን ማግሲክ ቤሱዋ። ባሶክ ዛላ ስናናክ ፋሩኔሲክ ሙሴኒ ቱማስ ማኬና ማኣሶን እምማ» ይ።<verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>ስኑንታኖ አሱስ ኤስታን ኬስናይሴ ስና ቾዋሶን አሱ ዙታምባሴ አሲክ ዎሎክ ካቢ። ኤስ ባሪ ቦርኣ የሱስ አምማኖን ኬስሴ ኣፋ ካታማሲኑ ግሩናክ ኣነ ችሜ። ባክ ጌራካሎ አሱ ፎንቶ ድማ ሀምሜ ድ። አሱኒ ሜያ ደይ ዳ ዳስን ባሪክ ዬሴት ፌሴቴር።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">የሱስ እሳ ላፋ አሱኒን ፋቲ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማት. 9:1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ጋሮ ዎናኔን ኦርፎ የሱስ ክፍርናሆም ካታማ ዎል ሌ ዬሬ ኬር ፌናማቶ ኦድቴ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ኬያስ ቱምን ፎቻራስ ትርኦናኔን ሾዎ አሱ ዙቴ። የሱስ ደይ ባሶክ ሀኦሲ ካማኖን አሲት ፌር። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>አቼች አሱ እሳ ላፋ አሱኒን ዎርኤ የሱስኒኪ ዬሴቴ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>ዳራ ሾዌና ቦርአ የሱስኒኪ ታእሱክ ኣነ ችሞቶ። ባር ፌና ድማስታኪ ኬያሲ ኣፋኖን ካብጋት ኦፖባሴ የት ኬር ጌደቴ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱስ ባሶ አማንቶሶን ብያት ላፋ አሱስን፦ «ና! ቦርኔስ ፌሹን ይስቴዋ» ይ። <figure style="fig" alt="Single story flat-roofed house" file="LB00234B.tif" size="span" ref="2:4">አይሁድኒ ሜኒ ኬያ </figure><verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ኤስታ ዲሴ ሙሴኒ ቱማሲ አሲኛሳስን እሳ እሳይስ ንብቤሲስ፦ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>«ሀን አሱስ አዉኒ ቦርአ ኤፋቴና ሜእኒ ካማ ማኬፌሶ? እሳ ሀኦስኔን ኦማ ቦርኣሶን ፌሹን ኡክ ችምኒር ኦንሶ?» ይሴቴ።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ጌሬጌሬ የሱስ ንቤሲሲ ሳፋራኖን አያናባሲክ አሪፋት ኤካ ይ፦ «ንብኒትስ አዉኒሮን ኤካ ሳፋሬድፌትሪንሶ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ላፋስን፦ ‹ቦርኔስ ፌሹን ይስቴዋ› ኡስጝዋ ‹ካብራ ኦፖኔሶን ዎርአ ሀምማ› ኡስንሶ ካሾይ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ስኑንታኖ አሱኒ ና ሀን ዳስታኪ ቦርኣሶን ፌሹን ኡክ ሀእሱኒ ሁግናባ ፎባሶን አሩትዋ» እያት ላፋስን፦ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>«ኔክ ማኬፋውጙዋ፦ ካብራ ኦፖኔሶን ዎርአ ኬኔ ሀምማ!» ይ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>ጌሬጌሬ ካብሬ ኦፖባሶን ዎርኤ አሱ ዙታምባሴ አሲ ስና ኬስሴ ሀሚ። ኤስ ባሪ ቦርኣ አሱኒ ሜያ ዙቴሬ ዲንቀሴት፦ «ኤፋቴና ዉዛ ቢራ ኣነ አሩዌኒዋ!» ይት ሀኦሶን ጋላቴሴቴ።<verse eid="MRK 2:12"/></para>
  <para style="s1">ሌዊኒ ቴግቶ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማት. 9:9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱስ ሄፕሳ ዎል ሌ ጋሊላኪ ባርሲ ቴሻ ሀሚ። ሾዎ ዳራ ደይ ዙቴሴሬ ባርኪ ዬሴቴን አስሲ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ኤስታ ካሞ ኣትፌን ግርቦ ዙቴፋናስታ ድ አልፍዮስኒ ና ሌዊኒን ብያት፦ «ታኔን አነ ሀሚኒዋ» ይ። ባር ደይ ካብሬ ባርኔን አነ ሀሚ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>ኤሴን ኦርፎ የሱስ ሌዊኒ ኬር ሙ ሜፌን ሾዎ አሱኒ ሜያ ደይ አነ ኤስታ ፌሴቴር። ባሶስን ሾዎ ቦርኒ ሜናዋ ግርቦ ዙትፌ<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fqa" closed="false">ግርቦ ዙትፌ አሱ፦ </char><char style="ft" closed="false">ግርቦ ዙትፌ አሱ አይሁድኒ ሜያክ ኣነ ሹንቴፌ።</char></note> ባሶትና የሱስናዋ ባሳ ናዎኒ ሜና አነ ሙ ሜሴድፌር። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ፌርሳዊኒ ሜኒ ኬን ስና ቱማሲ አስሲኛኒ ሜያ የሱስ ግርቦ ዙትፌ ባሶኔንናዋ ቦርኒ ሜያኔንና አነ ሜፌን ብየፋት፦ «ግርቦ ዙትፌ ባሶኔንናዋ ቦርኒ ሜያኔንና አዉኒሮን አነ ሜሬ ኡሽድፌሪንሶ?» ይት ናዎኒ ሜያኖን ማሙሴቴ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱስ ኤስ ባሮን ኦደፋት፦ «ሜታኒስቴኖ ፋያኒክ ኤትኒ አሱ ኣነ ሾልስፌዋ። ታ ያናስ ቦርኒ ሜያኖን ሀኦስኪ ዎልጉክታኖ ኦኮኒ ሜያክታዋ» ይ።<verse eid="MRK 2:17"/></para>
  <para style="s1">ሶሜሬ ሺጶኒ ቾዋሲ ማምሱ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማት. 9:14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ዮሀኒስኒ ናዎስናዋ ፌርሳዊኒ ሜና ሶሜሬ ሺጵሴቴር። እሳ እሳ አሱኒ ሜያ የሱስኒኪ ዬሴሬ፦ «ዮሀኒስኒ ናዎስናዋ ፌርሳዊኒ ናዎስና ሶሜሬ ሺጵሴቴር። ነ ናዎኒ ሜያ ሶሜሬ ሺጶ ቤየፌስ አዉኒ ቦርአንሶ?» ይሴቴ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱስ ደይ ባሶክ ዎልግሬ፦ «ማሪስ ባሶኔን አነ ፌን ሞዝጊቱኒ ሜያ ሶሜሬ ሺጵሶነክ ሾልስፋዎሶ? እንዳነዋ! ማሪስ ባሶኔን አነ ፌን ሶሜሬ ሺጵሶነክ ኣነ ሾልሲፋዋ። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>ስኑንታኖ ማሪስ ባሶስታን ኦር ኬሳና ዎና ዮና። ኤስ ካባሲክቱ ሶሜሬ ሺጵሶነዋ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>«ኩርኡ ማማስታ ጋድዶ ኤርቤ ኩንስሬ ዞርፌር ኣፌዋ። ኤስ ባሮ ዛጋናነ ጋድዶ ኤርቤስ ኩርኡ ማያሶን ካራሲርዋ። ካራቶባስ ደይ ዜምማት ባሪስታን አካማቱ ስናና። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ኤሲስማቶ ኩርኡ ሀማቶሲ ኦራ ዋይኒን ኡሻ ጌድፌር ኣፌዋ። ጌድፋናነ ዋይኒኒ ኡሻስ ሀማቶሶን ካራሲርዋ። ዋይኒኒ ኡሻስ ደይ ዉክቴር ሀማቶስ ደይ ማጝር። ኤስ ባሪ ቦርኣ ኦራ ዋይኒን ኡሻሲክ ጋድዶ ሀማቶቱ ሾልስፋርዋ» ይ።<verse eid="MRK 2:22"/></para>
  <para style="s1">የሱስ ቤይሳኒ ዎናሲ ዳምዋ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማት. 12:1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>ቤይሳኒ ዎናሲክ የሱስ ፎሻስታ ካሞ ኣትፌን ናዎኒ ሜያ አነ ሀሜፌት ቦና ዛጎ ቡግሴቴ። <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፌርሳዊኒ ሜያ፦ «ነ ናዎኒ ሜያ ቤይሳኒ ዎናሲክ ዛግቶናክ ሾልሱኖይሶን አዉኒሮን ዛግሴፌሶ?» ይት ማሙሴቴ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱስ ደይ ዎልግሬ፦ «ዳዊትናዋ ባርኔን አነ ፌሴ አሱኒ ሜና ማክቴሴፌ ካባሲክ አዉ ዛግሴቴማቶ ኣነ ፌሬቱዌትኖሶ። <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታር ማግኒ ጋኝኜ ሜኒ ጋኛ ስንነ ፌና ነያሲክ ሀኦሲ ኬር ግሪሬ ማግኒ ሜያክታኖ ኦኑ ሙናክ ሾልሱኖይ ቱሻሶን ሜዋ። ኤስታን ባርኔን አነ ፌሴ ባሶክ ደይ እምዋ» ይ።<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ደይ የሱስ፦ «ቤይሳኒ ዎና አሱኒክቱ ቴስቴታኖ አሱ ቤይሳኒ ዎኒር ስንነ ኣነ ቴስቶዌዋ። <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ኤስ ባሪ ቦርኣ አሱኒ ና ቤይሳኒ ዎናሲክኑ ዳምባይዋ» ይ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">የሱስ ኩሹባ ላፋ አሱስን ፋቲ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማት. 12:9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>ደይ የሱስ ዎል ሌ አይሁድኒ ሺጶኒ ኬያሲ ግሪ። ኤስታክ ደይ ኩሹባ ላፋ አሱ ፌር። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>እሳ እሳ ሜያ ማላቶክ ቾዋ ሾልሴፋት፦ «ሀን ቤይሳኒ ዎናሲክ ፋቱኒቶ ብያኒዋ» ይሬ ኦደት ፌሴቴር። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱስ ደይ ኩሹባ ላፋ አሱስን፦ «ካብራ ሀጝ ጋነያ ያራ የሮዋ» ይ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ኤስታን አሱኒ ሜያክ፦ «ቤይሳኒ ዎናሲክ ማአሮን ዛጉጝዋ ወደይ ማጙኖን ዛጉንሶ፤ ካኒ ፋቱጝዋ ወደይ ዎሩንሶ?፤ ኣፋሪንሶ ፋቃድቴሪ? ማኬቤትሶ?» ይት ማምሲ። ስኑንታኖ ባሶ ሻክሴቴ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱስ ንብቤሲስ ችማክ ሃሬፋት ብራቶስታ ፌሴ አሱኒ ሜያኖን ግእአክ ብያት አሱስን፦ «ኩሹኔሶን ዜጵዋ» ይ። ባር ደይ ኩሹባሶን ዜጲን ኩሹባስ ፋሪ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ኤስታን ፌርሳዊኒ ሜያ ጌሬጌሬ ኬሴሬ የሱስኒን ኣካክ ዎርሶነማቶ ሄሮድስኒ ኬን ስንነ ባሶኔን አነ ሜርኬሴቴ።<verse eid="MRK 3:6"/></para>
  <para style="s1">ሾዎ አሱኒ ሜያ የሱስኔን አነ ሀሜቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱስ ናዎባስኔን አነ ጋሊላኒ ባሪሲኪ ሀሚ። ጋሊላኒ ዳስታን ዬሴ ሾዎ አሱኒ ሜያ ኦርፎባሴ ሀሜቴ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ባር ዛግት ፌና ዉዛሶን ዙትሬ ኦደሴፋት ዩዳኒ ዳስታን፥ የሩሳሌምኒ ካታማስን፥ ኤዶምያስኒ ዳስታን፥ ዮርዳኖስኒ አካሲ የሳሎ ፋ ዳስታን፥ ትሮሱናዋ ስዶኑንና አሲ ካታማሲ ብራቶታን የሱስኒኪ ዬሴቴ። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>ዳራሳ ሾዎታን ካብ ቾዋ አሱኒ ሜያ ቱግስሴት ፌሴቴር ስንና ቦርአ ጎኑ ባሪክ ሆሱሶነክ ናዎኒ ሜያኖን አጃጀ። <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ሾዎ አሱኒን ፋትር ስንና ቦርአ ሜሮቤስ ፋና ባሶ ዙቴሬ ባሪን ታእሬ ፋርሶነክ ትኢርስሴት ፌሴቴር። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>አሱሳሲ ፋ ኪና አያና የሱስኒን ብየናሴ ስንባ ጋንደራ፦ «ነ ሀኦኒ ናዋ» ይት ቻጌት ፋሴር። <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>ኪና አያናሲክቶኖን ደይ ባር ኦ ስንናማቶ ማክሶኖይናማቶ ዛግሬ አጃጀ።<verse eid="MRK 3:12"/></para>
  <para style="s1">አሲሬ ሄፔ ዎስኒ ሜኒ ኮርቶ</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማት. 10:1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱስ ኣማስታ ኬስፋት ባር ሹንና ባሳክቶኒን ቴጌ። ባሳክቶ ደይ ባርኪ ዬሴ። <verse eid="MRK 3:13"/><verse number="14-15" style="v" sid="MRK 3:14-15"/>ባርኔን አነ ፎሶነክ፤ ካምባሶን ማክሶነክ ዎሱናክ፤ ኪና አያናሲክቶኖን አሱሳስን ክሱሶነክ ሀእሱኒ ሁግናቤስ ፎናክ አሲሬ ሄፔ አሱኒን ኮራት፦ «ዎሲ<note caller="+" style="f"><char style="fr" closed="false">3:14-15 </char><char style="fqa" closed="false">ዎሲ ይሬ ቴጌሬ፦ </char><char style="ft" closed="false">ዎሲ ይሬ ቴጌሬ ይፋ ባር ዜሞቲ ግሪክኒ ትቻስሲ ኣፋ።</char></note>» ይሬ ቴጌ።<verse eid="MRK 3:14-15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>ኤስ ኮርቴሴ አሲሬ ሄፔ አሱሳክቶ «ጳጥሮስ» ይሬ ሱንስና ስሞን <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>«ቦአርነርጌስ» ኡስ ደይ «ደዶኒ ናንጎት» ይሬ ሱንስና ዛብድዮስኒ ናንጎት ያቆብናዋ ዮሀኒስና፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>አንድርያስ፥ ፍልጶስ፥ ቤርቴለሜዎስ፥ ማትዎስ፥ ቶማስ፥ እልፍዮስኒ ና ያቆብ፥ ታድዎስ፥ ኮነፌ ባሶኪን ስሞን<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">ኮነፌ ባሶኪን ይፋ ባር አይሁድኒ ሜያሲን ብርማዱምማ ኬሶነክ ካብሴሴፌ ባሶ ኬናስን ዬር ስንባሶንቱ ቤስፋ።</char></note> <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱስኒን ኣትሬ እማ አስቆሮትኪ ዩዳዋ።<verse eid="MRK 3:19"/></para>
  <para style="s1">የሱስናዋ ቤልዘቡልና</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማት. 12:22-32</ref>፤ <ref loc="LUK 11:4-23">ሉቃ. 11:4-23</ref>፤ <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ኤሴን ኦርፎ የሱስ ኬር የ። ባርኔን ናዎኒ ሜያኔን ሾዎ አሱኒ ሜያ ሄፕሳ ደይ ዙቴሴቴ ቦርአ ሙኒ ሙክኑ ኣነ ችሞሶቶ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>«የሱስ ንፋሴዋ» ይስቴፋ ዎል ላ ኦደሴፋት ኮንኒ ሜያ ባሪን ኤጳክ ዬሴቴ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>የሩሳለሙን ዬሴ ሙሴኒ ቱማሲ አስሲኛኒ ሜያ፦ «የሱስ ቤልዘቡል ባሳስሲ ፋርዋ! ኪና አያናሲክቶኖን ክስፌናስ ባሮን ሀእስፋ ባሪክዋ» ይት ዎሉምሴቴ።<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱስ ባሶትን ባርኪ ቴጌሬ ቤሶክ ኤካ ይ፦ «ሴጣናስ ኣካክ ሴጣናሶን ክሱክ ችምንሪንሶ? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>እሳ ታቶስ ባሬ ባሬ ኦር ኦር ኬስፋናነ ታቶባስ ዛግራ የሮክ ኣፋ ችማናዉዛ። <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ኤሲስማቶ እሳ ኬር ፌ አሱ ኦር ኦር ኬስፋናነ ዛግሬ ፎክ ኣፋ ችማናዉዛ። <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ኤስ ባሪ ቦርኣ ሴጣናስ ባሬ ባሬ ኦር ኦር ኬስፋናነ ትሹቱ ትሹናታኖ ኣፋ ዛግራ የሮና ዉዛ።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>«እሳ ዛግ አሱኒ ኬር ግሪሬ ዜምሜ ኤስ ዛግ አሱስን ኤጴ ታርኖይ ኬባስሲ ፋ ፎባሶን ቦኦክ ችምኒር ኣፌዋ። ታርእናነን ኦርፎቱ ቦኦክ ችማናዋ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>«ፉቶ ንቶክ ማኬፋውጙዋ፥ አሱኒ ሜያ ዎስቴሴፌ ቦርኣሴዋ ማክሴፌ ሜኣሴ ዙቴራ ፌሹን ኡስቶናዋ። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ስኑንታኖ ኮርቶ አያናስታ ሜእኒ ካማ ማክሴፌ ባሶ ቦርኣስ ኮእባ ፎንቶኖን ቦርቤሲስ እሳንነ ኣፋ ፌሹን ኡስቶና ዉዛ።<verse eid="MRK 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30"/>« ‹ኪና አያና ባሳስሲ ፋርዋ› » ይሴት ፌሴቴር ስንና ቦርአቱ የሱስ ኤስ ባሮን ማኬ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱስኒ እንቶሴዋ አይኒ ሜና</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማት. 12:46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>የሱስኒ እንቶሴዋ አይባሳክቶና ዬሴሬ ጌራካሎ የርሴፋት ባርኪ ዎስሴሬ ቴግሲሴቴ። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ኤስ ብራቶስታ ዲሴ አሱኒ ሜያ፦ «ነ እንቶኔሴዋ አይኔሳክቶና ጌሮክ ኔን ሾልሴድፌርዋ» ይት ማክሴቴ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱስ ዎልግሬ፦ «እንቶና ኦንሶ? አይታሳክቶ ደይ ኦና ኦናንሶ?» ይት ዎልጊ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ብራቶስታ ዲሴ ባሶኪ ቢፌት፦ «ኤሴ እንቶናሴዋ አይታሳክቶና ሀኒስዋ፦ <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ሀኦስ ፊቃዲኖን ዛግሴፌ ባሶ ዙቴሬ አይታ፥ ኤትና ደይ እንቶናዋ» ይ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ዛልኒ ቡክኛሳ ቤሶ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማት. 13:10-17</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>ሄፕሳ ዎል ሌ የሱስ ባሪሲ ቴሻ ዳራስን አሱክ ካቢ። አካም ሾዎ አሱ ባርኪ ኤስታ ዬሴሬ ዙቴሴቴ ቦርአ የሱስ ጎኑስሲ ግሪሬ ባሪስታ ድ። ዳራስ ዙቴሬ ባርሪ ቴሻ ፌሴቴር። <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>ቤሶክ ሾዎ ዉዛ ባሶክ አሲ። አሲፌና ካባሲክ ደይ ኤካ ይ፦ <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>«ኦዶትዋ! ቡክኛስ ሜኒ ቡካክ ኬሲ። <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>ቡክፌና ካባሲክ እሳ እሳይስ ኡግናሲ ሀእታ ኬሬ ዎርእ። ካሳስ ደይ ኬጳ ማሴ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>ኦማስ ደይ ጋሮ ሆእባ ፋና ካኦስታ ኬሬ ዎርእ። አካማ ሆአ ኣፋ ስንና ቦርአ ጌሬጌሬ ካይ <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>ስኑንታኖ አዋ ኬስፋና ካባሲክ አልቂ። ታስባስ ኣነ ዛጉዋ ስንና ቦርአ እችሚ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>ኦማ ዛላስ ደይ ሴርአ ፋና ዳስታ ኬሬ ዎርእ። ሴርኣስ ኬስሳ ጌርና ቦርአ ኣነ ጋና። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>ኦማስ ማአ ቡሎስታ ኬሬ ዎርአ ባር ካይራ ድቻ ጋና ጋኒ። እሳይስ ኬዛስሮን፥ እሳይስ እሱናስሮን፥ እሳይስ ትያኖን ጋኒ።»<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>ኤስታን ደይ የሱስ፦ «ኦዶኒ ኦዶባ ፌና ባር ኦዶዎዋ!» ይ።<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>የሱስኒ ቴሻ ፌሴ አሱኒ ሜናዋ አሲሬ ሄፔ ናዎባሳክቶና የሱስ ባር ባር ስንፌና ካባሲክ፦ «ቤሶክ ማኬታ ቾዋሲ ኮታ ኣምባንሶ?» ይሬ ማሙሴቴ። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>ባር ደይ ዎልግሬ፦ «ንቶክ ሀኦሲ ታቶኒ ኣቾ ቾዋኖን አሩትክ እምቴዋ። ስኑንታኖ ኦምኒ ሜያክ ዙታምባሴ ቤሶክቱ ማክቴፋዋ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>ኤስ ባር ደይ፦</para>
  <para style="q1" vid="MRK 4:12">« ‹ባሶ ሀኦስኪ ዎልሴቴን ቦርቤሲስ ፌሹን ኡስቶኖይናማቶ፤</para>
  <para style="q2" vid="MRK 4:12">ኣፍቤሲሲክ ቢፌት ኣነ ያዳቴሴፌ፤</para>
  <para style="q2" vid="MRK 4:12">ኦዶቤሲሲክ ኦደፌት ኣነ ጋሳሲሴፌዋ› »</para>
  <para style="m" vid="MRK 4:12">ይስቴናስማቶዋ።<verse eid="MRK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>ደይ የሱስ ባሶክ ኤካ ይ፦ «ሀን ቤሶሶን ንቶ ኣነ አሩዌትኖሶ? ኤካን ኦማ ቤሶሲክቶኖን ዙትራ ኣካክ አሩክ ችምፌትሶ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ቡክኛስ ካምባሶንቱ ቡክፌዋ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ካምባሶን ቡክቴፋና ካባሲክ ኡግናሲ ሀእታ ኬሬ ዎርአ ባር ካምባሶን ኦደሴፌ ካባሲክ ጌሬጌሬ ሴጣና ያራ ኤስ ካማሶን ንቤሲስን ኤጳ ትሽክፋና አሱኒ ሜያዋ። <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>ኤሲስማቶ ደይ ካኦስታ ቡክቴ ባር ካምባሶን ኦደሴፌ ካባሲክ ጌሬጌሬ ግራክ ኤጴቴሴፌ ባሶዋ። <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ስኑንታኖ ኤስ ካባሲክታኖ ባሶሲ ካምባስ ታሳ ኣነ ዛጉዋ። ጋሮ ዎናኔን ኦርፎ ካምባሲ ቦርአ እሳ ራክኮ ወደይ ካቡግቶ ያፋና ካባሲክ ጌሬጌሬ ቱሳኢሴሬ ጋንደሴፌዋ። <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>ሴርአ ፋና ዳስታ ቡክቴ ባር ደይ ካምባሶን ኦደፌ ባሶትጝዋ። <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ስኑንታኖ ሀን ዳስታኪ ፎኒ ቾዋሲ ሳፋራ ኦቱምኒ ኬሽታናሴዋ ኦማ ኦማ ዉዝኒ ኤናንቶሴ ባሶ ንባስሲ ግሪራ ጌሪፋና ቦርአ ጋንቤሲ ፎንቶ ስንነ ፉእቴሴፌዋ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ማአ ሆኣስታ ቡክቴ ባር ደይ ካምባሶን ኦዴሬ ኤጴቴሴፌ አሱኒ ሜያዋ። ኤስ ባሶ እሳይስ ኬዛስሮን፥ እሳይስ እሱናስሮን፥ እሳይስ ትያኖን ጋነፌዋ።»<verse eid="MRK 4:20"/></para>
  <para style="s1">ቴጋ ድምታ ድ ቶናሲ ቤሶ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>ቱስሬ ደይ፦ «እሳ አሱ ቶና ቶኒሬ ዋሽሺ ወደይ ኩጶኒ ስካሎሲ ዱስፌዎሶ? ቴጋ ድምታታኖሶ ዱስፌናሪ? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ኤስ ባሪ ቦርኣ ኣቸራ አምማኖን ኬስኖር ኡክቴራ ቻሬፋስታ ኬስኖይ ዉዛ ኣፋዋ። <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ኤሴ ኦዶኒ ኦዶባ ፌና ባር ኦዶዎዋ።»<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ደይ የሱስ ኤካ ይ፦ «ሀን ቾዋሲክቶኖን ጋሳሲራ ኦዶትዋ! ንቶ ሳፋሬፌት ሳፋሬሲክ ዎል ላ ንቶክ ሳፋርቴራ እምቶናዋ። ኤስ ባርስታኑ ንቶስታ ዳይስቴርዋ። <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>ፌና ባሪክ ዳይስቴራ እምቴር። ስኑንታኖ ትሽፋናነ ኤስ ባርኪ ፋ ባርኑ ኦቴርዋ።»<verse eid="MRK 4:25"/></para>
  <para style="s1">ድችፋ ዛልኒ ቤሶ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>ደይ የሱስ ቱስሬ ኤካ ይ፦ «ሀኦሲ ታቶ ቡሎስታኪ ዛላ ቡክፌ አሱነ ፋርዋ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>አሱስ ዋልን ኩንፌ ደይ ዎናኔን ደይ ካብፌ። ኣካክ ስንድፋናማቶ አሩኖይፌን ዛላስ ካይፋ፤ ደይ ድችፋ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ቡሎኒ ዳስ ደይ ቴትባክ ዜምማ ካይፋ፤ ኤስታን ኬኦባ ክስፋ። ፎትራ ጋና ጋንፋ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>ሜያስ ደይ ካትታ ካርኒ ዎና ካርናኔን አሱስ ማጋዳክ ካርአክ ካቢፌ።»<verse eid="MRK 4:29"/></para>
  <para style="s1">ፍእፍኦኒ ዛላሲ ቤሶ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማት. 13:31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>ኤካ ደይ ይ፦ «ሀኦሲ ታቶኖን አዉኔን ሆሱንሪንሶ? አሮ ቤሶክ ደይ ሆስራ ማኮናሪንሶ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ፍእፍኦኒ ጋናነ ፋርዋ፤ ባር ደይ ቡሎስታ ቡክቴፋና ካባሲክ ዳስታ ፋ ዛላ ዙታምባሴ አሲስታን አቴርዋ። <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ስኑንታኖ ቡክቴራ ካይናኔን ኦርፎ ጎሩ ቡክቴራ ካይ ዛላ ዙታምባሴ አሲስታን አሪክር ስንፋ። ሳማስታኪ ካሳስ ደይ ዋይእባሲ ኬባ ኬርአ ዱናኔን እኛ እኛ ዋይአ ክስፋ» ይ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱስ አሱኒ ሜያ ጋሳሲሬ ኦዶክ ችሞኔስንነ ፋሮን ኤፋ ሾዎ ቤሶክ ካምባሶን ባሶክ ማኬት ፌር። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>ባር አሲፌና ካባሲክ ቤሶ ፎንቶ ኣነ አሱዌ። ስኑንታኖ ባሶ ባሶ ስንነፌ ካባሲክ ቾዋሶን ዙትሬ ናዎኒ ሜያክ ኮቴ ማኬት ፌር።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱስ ኣካኒ ጉቦስ ሻኩናክ ዛግ</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማት. 8:23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>ኤስ ዎኖ ዋልን የሱስ ናዎኒ ሜያክ፦ «ሀን ባሪሲ የሳሎ ፍናኒዋ» ይ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>ዳራስን ኤስታክ ቤይፋት የሱስ ዲና ጎኑሲ ግሪን ባሪን ኤጴ ሀሜቴ። ኦማ ጎኑሲክቶ ደይ ባርኔን አነ ፋሴር። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>አካማ አካኒ ጉቦሲ እፑዋ ካብራ አካስ ጎኑስሲ ቱማናኔን እፑዋስ ጎኑሶን እቸት ፋር። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ኤስ ካባሲክ የሱስ ጎኑሲ ኦርፎሲ ቦክታ ቦክቴሬ ኩንፌር። ናዎኒ ሜያ ባሪን ጉዝግሴሬ፦ «አስሲኛኖ! እንኖ ትሹስ ኔን ኣነ ትርኤፋኖሶ?» ይሴቴ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>ባር ጉዝሬ እፑዋሶን ኬእ። ባሪሶን ደይ፦ «ቤይያ ሻኩ!» ይ። እፑዋሲ ስሩ ደይ ቤይ። አካማ ናጋኑ ስኒ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱስ ናዎኒ ሜያኖን፦ «አዉኒሮን ኤካ ድጌድፌትሪንሶ? ሀሽኔን አማንቶኒት ኣፋኖሶ?» ይ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>አካማኖን ድጌሴሬ ባሶትና ባሶትና፦ «ኤካኒ እፑዋሴዋ ባሪሴ አጃጃሜናር ሀን ባር ኦንሶ?» ይሴሴቴ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">የሱስ እሳ ኪና አያና ኤጵና አሱኒ ፋትናማቶ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማት. 8:28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>ጋሊላን ባሪሶን ጎኑክ ፍነሬ የሳሎ ጌርጌሴኖንኪ ዳስታክ ካርኤቴ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>የሱስ ጎኑስን ኬሮባሴ ጌሬጌሬ ኪና አያና ኤጵና አሱ ሹኢን ሞጋስኒ ኬሴ ባርኪ ኡጰ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ኤስ አሱስ ደይ ሞግን ድምሲቱ ፌፌ። ኦኑ ባሪን ብታን ሻሻራክኑ ታርኤ ዱሱክ ኣነ ችምፌ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>ሾዎ ዎና ዎቾኒ ብትታክናዋ ሻሻራክና ታቴት ፌር። ስኑንታኖ ሻሻራሶን ቡግትናዋ ብታሶን ኪርኤትና ፌር። ባሪን ሜሮክ ኦኑ ችምፌር ኣፌ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>ዎንና ዎንና ቶናዋ ዋልና ሹኢን ሞጋስታናዋ ኩማስታና ኩትፋፌ ቻጌት ፌር። አቱባሶን ሹአክ ቡኤ ማዛስት ፌር።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>ኪና አያናስ ዎክሶክ የሱስኒ ቢናይሴ ኤልላ ስኒባ ካአነፋት። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>ቴጋ ካማክ፦ «አካማኖን ኡልፍንቶ ሀኦሲ ና የሱስኖ! ታኔን አዉነ ፋሪንሶ? ታን ኪቹኖይታማቶ ሀኦሲ ሱናክ ቴዉዋ!» ይት ቻጊ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ኤስ ባሮን ይናስ የሱስ፦ «ነ ኪና አያና ሀን አሱሳስኒ ኬስ» ይና ቦርአ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱስ ደይ፦ «ሱነ ኦንሶ?» ይሬ ማምሲ። አሱስ ዎልግሬ፦ «እንኖ ሾዎ ስኒ ቦርአ ሱና ለጌዎኒ<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">ለጌዎኒ ኡስ 4,000 ሀማ 6,000 ስኒ ሜያ ታርኦን ዙቶ</char></note>» ይ።<verse eid="MRK 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 5:10"/>ባርኪቶኖን ዳስታኪ ካሌ ኮፍኩኖይናማቶ ችኒሬ የሱስኒ ሺጴ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ኤስ ዳስታክ ፋ ኩማስ ቴሻ ሾዎ ሙኮኒ ዎዶ ኬምቴድፋር። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>«ሀማ ሙኮስ ግሩኒክ እኖትን ጋፍኩዋ» ይት ሺጵሴ። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱስ ደይ ሀማ ግሩናክ ማኬን ኪና አያናሲክቶ ኬሳ ሙኮሲክቶስ ግር። ሄፕ ኩማ ስኒ ሙኮ ኩማስታን ኤለራ ባሪስ ግርራ ክት።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ሙኮሶን ኬምፌ ኬዞሳክቶ ኤለሬ ሀሜ ካታማስናዋ ኬኤስና ስና ቾዋሶን ማክሴቴ። አሱኒ ሜያ ደይ ስና ባሮን ብያክ ኬሴቴ። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>የሱስኒክ ዬሴቴን ኤስ ሾዎ ኪና አያናስ ኤጵና አሱስ ንብባሲ ዎልን ማያ ማየ ዲፌን ብየቴሴ ድጌሴቴ <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ኤስ ኪና አያናስ ኤጵና አሱሳ ቾዋኖናዋ ሙኮሲክቶታና ስና ባሮን ዙትሬ ዜምሜ ብያ አሱኒ ሜያ ኤስ ዬሴ ባሶክ ማክሴቴ።<verse eid="MRK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17"/>ኤስ ካባሲክ ኤስ ዳስታክ ፌ አሱኒ ሜያ የሱስ ዳቤሲስታን ኬሴ ሀማናክ ሺጵሴቴ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱስ ጎኑስ ግሪፌና ካባሲክ ኪና አያናስ ባሳስኒ ኬስና አሱስ፦ «ነኔን አነ ሀማናዋ» ይት ሺጴ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>ስኑንታኖ የሱስ ኣነ ማእ ኡዌ። አሱሲክ ዎልግሬ፦ «ኬነ ዎላ ሀምፋት ኬርክ አሱኒ ሜያክ ዳሚስ ኔክ አዉነ ፋ አካማ ዉዛ ዛግናማቶናዋ ኣካክ ኔክ ኬናሽቴናማቶና ማኮዋ» ይ።<verse eid="MRK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20"/>አሱስ ደይ የሱስ ባርኪ ዛግና ቾዋሶን፦ «አሲር ካታማ» ይስቴፋ ዳስታክ ሀሜ አዋስ። ኦደ ባሶ ዙቴሬ ዲንቀሴት ፌሴቴር።<verse eid="MRK 5:20"/></para>
  <para style="s1">ክት ናዋሴዋ ሜታና አሱሴ</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማት. 9:18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱስ ደይ ጎኑክ የሳሎ ሄፕሳ ዎል ሌ ፍንፌና ካባሲክ ሾዎ አሱ ባርስ ቴሻ ባርኪ ኤስታ ዙቴሬ ፌሴቴር። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>አይሁድኒ ሺጶኒ ኬያስ ጋኛአሳስኒ ያይሮስ ይስቴ እሳ አሱ ዬሬ የሱስኒን ቢናይሴ ዎቾባስ ካአነሬ፦ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>«አቴ ናናስ አካማኖን ሜቴራ ክቱና አጋት ኩንርዋ። ፋሪራ ካክ ፎናክ ያራ ኩሹኔሶን ባርስታ ታኡዋ» ይሬ ችኒሬ ሺጴ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱስ ደይ ባርኔን አነ ሀሚ። ሾዎ አሱ ኦርፎባሴ ትርኢስሴድፌር።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>አሲሬ ሄፔ ነያ ሀሪንባ ዉክቴት ፋና እሳ አሱ ፋር። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ሾዎ ኤትኒ አሱኒክ ሀሚፋፋ አካማኖን ራካቴት ዋግባሶን ደይ ኮእስት ፋር። ስኑንታኖ ሜሮባስ አሪክቱ ሀሚታኖ ፋሩክ ኣነ ችማ። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>ባር የሱስኒ ቾዋሶን ኦደራ ፋር ስንና ቦርአ አሱሳ ጋነሲ ኦርፎ ካሞ ያራ ማምባሶን ታእ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>ኤስ ባሮን ዛግናስ፦ «ማምባስታ ታእፋናነ ፋሩናዋ» ይራ ፋር።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ኤስ ዉክቴት ፋ ሀርንባስ ጌሬጌሬ የሬ። ሜሮባስኒ ፋርናማቶ አቱባስታክ አሪ። <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱስ ደይ ጌሬጌሬ ባሳስኒ ሁግና ኬስናማቶ አራት ዳራሳ ጋነሲ የርቀሬ «ማምናስታ ታእስ ኦንሶ?» ይ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>ናዎኒ ሜያ ዎልግሬ፦ «ዳራስ ትርኢስሴፌን ቢፋት፦ ‹ኦንሶ ታን ታእር› ይፋቶሶ?» ይሴቴ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>ስኑንታኖ የሱስ ኤስ ባሮን ዛግስ ኦ ስንናማቶ አሩክ የርቀሬ ቢ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ኤስታን አሱስ ባርኪ ዛግቴ ባሮን አሪና ቦርአ ድጌራ ኮርክት ያራ ስኒባ ካአነራ ፉቶሶን ዙትራ ማኬ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>ባር ደይ፦ «ናናሴ! አማንቶኔስ ኔን ፋትዌ። ማርኦን ሀሜ፤ ሜሮኔስኒ ፋሩዌ» ይ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱስ ኤስ ባሮን ማኬፌና ካባሲክ አይሁድኒ ሺጶኒ ኬያስ ጋኛ ያይሮስኒ ኬሩን ዬሴ አሱኒ ሜያ ባርኪ፦ «ናኔስ ክትዋ። ሀሽ አዉኒሮን አስሲኛስን ሆፕስፋሶ?» ይሴቴ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ስኑንታኖ የሱስ ኤስ ባሮን ኦደፌት አይሁድኒ ሺጶኒ ኬያስ ጋኛንን፦ «አማኖታኖ ድጎታታዋ» ይ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱስ ደይ ጴጥሮስኔን፥ ያቆብኔን፥ ያቆብን አይ ዮሀኒስኔንታኖ ኦም አሱ ባርኔን አነ ሀማናክ ኣነ ማእ ኡዌ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>አይሁድኒ ሺጶኒ ኬያስ ጋኛአሳ ኬር ዬሬ ካርፌና ካባሲክ አሱኒ ሜያ ሳሴትናዋ ዋስትና ቻጋ ኣታምሲሴፌን ቢ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ኬር ግሪሬ፦ «አዉኒ ቦርአ ሳሴት ዋስድፌትሪንሶ? ናዋስ አፋይቶቱ አፋይቴታኖ ኣነ ክቱዋ» ይ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>አሱኒ ሜያ ደይ ካኝን ምአ ምኤሴቴ። ስኑንታኖ የሱስ ባሶትን ዙትሬ ኬሩን ካሌ ክሳት ናዋስ አባንናዋ እንቶኖንና ደይ ባርኔን አነ ፌሴ ባሶትን ዞንስሬ ናዋ ፋናስ ግር። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>ናዋስ ኩሹኖን ደይ ዛቴ፦ «ጣልታ ኩም!» ይ። ኤስ ካማስ ኮታ ደይ፦ «ጋሮ ናዋሴ ካቡዌ ይፋዉጝዌ» ኡ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ባር ደይ ጌሬጌሬ ካብራ ኤክ ሀጝ ኩት። ዎጋባስ ደይ አሲሬ ሄፔ ስናና። ኤስ ባር ስኒፋና ካባሲክ አሱኒ ሜያ አካማኖን ዲንቀሴቴ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>ስኑንታኖ የሱስ፦ «ስና ቾዋሶን ኦኑ አሩናታ» ይሬ ባሶክ አጃጀፋት ደይ፦ «ናዋስ ሙና ሙ እምት» ይ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">ራጁ ዳባስታክ ኡልፍንቶ ቤይባስ</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማት. 13:53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱስ ኤስታን ኬሴ ዳባስታ<note caller="+" style="f"><char style="fr" closed="false">6:1</char><char style="fk" closed="false">ዳባስታ፦ </char><char style="ft" closed="false">ዳባስታ ኡስ ናዝሬት ኡ።</char></note> የ። ናዎኒ ሜያ ኦርፎባሴ ሀሜቴ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>ቤይሳኒ ዎናሲክ አይሁድኒ ሺጶኒ ኬያስ አስሱ ኤጲ። ሾዎ አሱኒ ሜያ ኦደሴሬ ዲንቀሴት ኤካ ይሴቴ፦ «ሀን አሱስ ሀን ዉዛሶን ዙትሬ አይን ዳንሶ? አሮ አሩኒሶ ሀን ባርኪ እምቴሪ? ሀን ቢስቴራ አሪቶኖይ ዉዛሲክቶኖን ዛግፌናስ ኣካኪንሶ? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ሀኒስ እኦ ካርፌ ማራሚን ናስቴኖሶ? ያቆብን፥ ዮሳን፥ ዩዳናዋ ስሞና አሲ አይስቴኖሶ? ኤትባሲክቶኑ ሀን እኖኔን አነታኖሶ ፋሴናሪ?» ኤሲሶን ይሴት ኤጴቶ ቤየሴቴ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>ስኑንታኖ የሱስ፦ «ራጁ ዳባስታክ፥ ኮኒባሳ ጋነስናዋ ኬር አነ ፌና አሱሳ ጋነሲታኖ ኦም ጌሮን አሱሳ ስናክ ኡልፍንቶዋ» ይሬ ማኬ።<verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>ኤስታክ ደይ ጋሮ ሜታን ሜኒስታቱ ኩሹባሶን ታእሬ ፋትቴኖ ኦማ ቢስቴራ አሪቶኖይ ዉዛ ኣነ ዛጉክ ችሜ። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>ዳራስ አማኖ ቤዮቤሲሲክ ዲንቀ። ኤስታን የሱስ ኬኤ ኬኤስ ኩትፋፌ አሲት ፌር።<verse eid="MRK 6:6"/></para>
  <para style="s1">የሱስ አሲሬ ሄፔ ዎስኒ ሜያኖን ዎሲ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማት. 10:5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>አሲሬ ሄፔ ናዎባሳክቶኒን ሀጝ ባርኪ ቴጌሬ ሄፕ ሄፕ ዛግሬ ዎሲ። ኪና አያናሲክቶታ ሀእሱኒ ሁግና እሚ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኤስታን ኤካ ይሬ አጃጀ፦ «ሀማት ኡጉንትሲክ ሃሮታኖ ቱሻ ወደይ ሀማቶ ወደይ ታጫአማስታ ብር ኮርእራ ኤጳትታ። <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>ዎቾንትስ ቻማ የርትታኖ ሄፕ ማማ ኤጳትታ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>እሳ አሱኒ ኬር ግሪፌት ካባሲክ ኤስ ካታማስን ኬሳትኔን ኤስታ ፎቲ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>አሱኒ ሜያ ንቶትን ኤጴቶክናዋ ኦዶክና ቤየቴ ድማስታ ዎቾንትስ ቱሎኖን ቴባት ኤስኒ ኬሳ ሀሚት። ኤስ ባር ደይ ባሶስታ ዛላ ስናና።»<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ኤስታን ኤስ ዎስቴሬ ሀማ ባሶ ደይ ኬሴሬ አሱኒ ሜያክ፦ «ቦርንትሶን ሀርምራ ሀኦሲክ ዎሉት» ይት አሲሴቴ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ሾዎ ኪና አያና አሱኒስኒ ክሴቴ። ሾዎ ሜታኒን ደይ ዛይት ሙድፋፌ ፋትሴቴ።<verse eid="MRK 6:13"/></para>
  <para style="s1">ሀጵቅፌ ዮሀኒስኒ ዎርቶ</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማት. 14:1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>የሱስኒ ሱናስ አሪቴራ ፋር ስንና ቦርአ ታቶ ሄሮድስ ባሳ ቾዋሶን ኦደ። እሳ እሳ ሜያ፦ «ሀጵቅፌ ዮሀኒስ ክቱኒ ካቢ። ኤስ ባሪ ቦርኣ ቢስቴራ አሪቶኖይ ዉዛ ባርኪ ዛግቴድፋር»<note caller="+" style="f"><char style="fr" closed="false">6:14</char><char style="fk" closed="false">ይሴት ፌሴቴር፦ </char><char style="ft" closed="false">ይሴት ፌሴቴር ይፋ ባር እሳ እሳ ዜሞቲ ትቻስ «ይት ፌር» ኡቱ ይፋ </char></note>ይሴት ፌሴቴር።<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ኦሚስ ደይ፦ «ኤልያስዋ» ይሴቴ፤ እሳካዲስ ደይ፦ «ዜሞቲ ራጁኒ ሜያስን እሳሳማቶዋ» ይሴት ፌሴቴር።<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ስኑንታኖ ሄሮድስ ኦዴሬ፦ «ሀን ባር ታ ሱትባሶን ካትና ሀጵቅፌ ዮሀኒስዋ። ኤሴ ባርቱ ክቱኒ ካብርዋ» ይ። <verse eid="MRK 6:16"/><verse number="17-18" style="v" sid="MRK 6:17-18"/>ሄሮድስ አይባ ፍልጶስኒ አሱ ስና ሄሮድያዳኖን አሱ ዛግሬ ኤጲ። ሀጵቅፌ ዮሀኒስ ሄሮድስኒን፦ «አይኔሳ አሱኖን ኤጳታክ ኔክ ኣነ ሾልስፋዋ» ይሬ ማኬ። ኤስ ባሪ ቦርኣ ዎስሬ ሀጵቅፌ ዮሀኒስኒን ኦትሬ ታቶኒ ኬር ታት። <verse eid="MRK 6:17-18"/><verse number="19-20" style="v" sid="MRK 6:19-20"/>ሄሮድስ ሀጵቅፌ ዮሀኒስ ኦኮ ደይ ኮርቶ አሱ ስንናማቶና አሪር ስንና ቦርአ ድጌሬናዋ ኦደትና ፌር። ሄሮድስ ባሳ ዎላሶን ኦደና ኦደና ፋዳሲክ ናየቱ ፌፌ። ስኑንታኖ ግራክቱ ኦደፌ። ኤስ ባሪ ቦርኣ ሄሮድያስ ሀጵቅፌ ዮሀኒስኒን ኤስ ማኬና ዉዛሲክ ሃሬራ ዎሩክ ሾሌፋናክኑ ኣነ ችማ።<verse eid="MRK 6:19-20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄሮድስ ኮንቴና ዎናሶን ኡልፍንሱክ ዳሶን ሀእሲፌ ባሶክ፤ ታርኦን ጋኛንክናዋ አርቶ ጋሊላክ ሜያክና አካማ ኮታ ኮቴ። ኤስ ባር ደይ ሄሮድያ ሾሌፋና ማአ ዎና ስኒ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ሄሮድያዳን ናዋ ኮታስ ማስቴፋና ኬያስ ግርራ ባሶ ስና ሱርት ኤሬስራ ሄሮድስናዋ ባርኔን አነ ፌሴ ባሶትና ግርስ። ታቶስ ደይ ናዋሶን፦ «ነ ሾሌታ ዉዛ አዉኑ ስኑን ታን ማምሱዌ እማናዌ» ይ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>ሄፕሳ ደይ፦ «ታቶናስ እሳ ኩኑኖኑ ስኒፋናክ ማምሲታ ባሮን ዙትራ ኔክ እማናዌ» ይሬ ቴይ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ባር ደይ እንቶባሲክ ሀማ፦ «አዉ ማምሱናሴ» ይ። እንቶባስ ደይ፦ «‹ሀጵቅፌ ዮሀኒስኒ ቴታሶን› ይራ ማምሱዌ» ይ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ናዋስ ደይ ጌሬጌሬ ታቶስኪ ዎላ ሀማ፦ «ሀጵቅፌ ዮሀኒስኒ ቴታሶን ሀን ኮራናስ ጌድቴራ ሀሽ ታክ እምቶናክ ሾሌፋኡጙዋ» ይ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ታቶስ ኤስ ማምሲና ማምሱሲክ አካማኖን ሱሜ። ስኑንታኖ ዜምሜ ቴይና ቦርአ ሙ ሙሶነክ ቴግቴ አሱኒ ሜኒ ስና ናዋሲክ ካላናክ ኣኔ ሾሎዌ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ጌሬጌሬ ታቶስ ኦድፌ ታርኦሳስኒ እሳርን ዮሀኒስኒ ሱታሶን ካርኤ ቴሾናክ ዎሲ። ታርኦስ ደይ ሀሜ ታቶኒ ኬያስኒ ሱትባሶን ካርእ። <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ካርና ቴታሶን ኮራናስ ጌደ ቴሾስ ናዋሲክ እምን ናዋስ ደይ እንቶባሲክ እሚ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዮሀኒስኒ ናዎሳክቶ ኤስ ባሮን ኦደሴቴይሴ ዬሴሬ ዱግኖባሶን ኤጴ ካባርሴቴ።<verse eid="MRK 6:29"/></para>
  <para style="s1">የሱስ ኡች ኩም አሱኒን ማስ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማት. 14:13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9:10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሀ. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ዎስኒ ሜያ ዎስቴሬ ሀሜቴስኒ ዎል ሌ ዬሴሬ የሱስኒክ ስና ዙቴሴቴ። ዛግሴቴ ባሮናዋ አሲሴቴ ባሮና ዙትሬ ባርኪ ማክሴቴ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>ባሶክ ዬፌርናዋ ዎል ሌ ሀሚፌ አሱና ሾዎ ስንና ቦርአ ሙን ሙክኑ ሳአት ኣነ ዳኖቶ። ኤስ ባሪ ቦርኣ የሱስ፦ «ንቶ ንቶ እሳ ሻቶ ድምስ ሀምፋት ጋሮ ዎና ቤይሳ ኤጵትዋ» ይ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>ኤስታን ባሶ ባሶ ጎኑስ ዲሴሬ እሳ ሻቶ ድምስ ሀሜቴ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ስኑንታኖ ሀሜፌን አሱኒ ሜያ ብየሬ ባሶ ስኖቤሲሶን አሪሴቴ። ኤስታን ካታማ ካታማስን ኬሴሬ ዎቾክ ኤለሬ ባሶ ካርኦኖ ፌሴቴን ዜምሜ ሀሜ ባሶ ኬርሶኔስታ ዙቴሴቴ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱስ ጎኑስን ኬሬፌና ካባሲክ ሾዎ አሱኒ ቢሬ ኬዞባ ፎንቶ ፋንቱነ ፌሴቴር ስኖቤሲሲክ ሱሜ። ኤስታን ሾዎ ዉዛ ባሶትን አሱክ ካቢ። <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>ጌሮክ ድማስ ዋለት ሀሚባሴ ናዎባሳክቶ የሱስኒክ ታእሴሴሬ፦ «ሀን ፋኒ ድማስ ዛቦዋ፤ ጌሮክ ደይ ዋልድፋር፤ <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>ሀን አሱኒ ሜያ ሙሶነ ዉዛ ኣፋ ስንና ቦርአ ብራቶስታ ፋ ቤዴስናዋ ኬኤስና ሀሜሬ ሙቤስ ዋግሶነክ ጌጌሱዋ» ይሴቴ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>ስኑንታኖ ባር ዎልግሬ፦ «ባሶ ሙሶነ ሙሶን ንቶ እምትዋ» ይ። ባሶ ደይ፦ «ኤካኒ እንኖ ሀማ ሄፕ ትያ ዲናሪ ዙትራ ክስራ ዋጌራ እማንሮሶ?» ይሴቴ።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱስ፦ «አፑን ቱሻንሶ ፋሪ? ሀማ ብየቤትሶ» ይ። ባሶ ደይ ብየሬ፦ «ኡች ሙማ ቱሽነዋ ሄፕ ቁርጡምነቱ ፋርዋ» ይሴቴ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱስ ደይ ዳራስ ችሮ ኩዋስታ ባግ ባጌ ዱሶነክ አጃጀ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>ኤስታን ትያ ትያነዋ ኡቻስር ኡቻስሬ ስንነፋፌ ማዳዳክ ዲሴቴ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱስ ደይ ኡኮት ኡች ሙማ ቱሻሴዋ ሄፕ ቁርጡሚሴ ኤጴ ደን ሳማ ቢሬ ሀኦ ጋላቴፋት ቱሻሶን ባቴ ዳራሲክ ዎሾነክ ናዎባሳክቶኒክ እሚ። ኤሲስማቶ ሄፕ ቁርጡሚሶን እምን ዙታምቤሲሴ አሲክ ሃኤሴቴ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>ዙታምቤሲሴ ሜሴሬ ጋዉሴቴ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>ናዎሳክቶ ደይ ፉእቴ ባቶ ቱሻሴዋ ቁርጡሚሴ አሲን አሲሬ ሄፔ ማሳ ቱማኖን ዙትሴቴ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ቱሻሶን ሜ ኣርቃሱሳ ፋዳ ኡች ኩም ስናና።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱስ ባሪስታ ኩት</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማት. 14:22-33</ref>፤ <ref loc="JHN 6:15-21">ዮሀ. 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>የሱስ ጌሬጌሬ ዳራስን ጌጌሲፌት ናዎባሳክቶኒን ጎኑስ ዲሴሬ የሳሎ ቤቴሳይዳ ፍነሬ ዜምሜ ሀሞነክ አጃጀ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>ኤሴን ኦርፎ የሱስ ባሶስታን ኦር ኬሴ ሀኦ ሺጶናክ ኣማስታ ኬስ። <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>ዋልፋና ካባሲክ ጎኑስ ባርስ ጋነታቱ ፋ። ኤስ ካባሲክ የሱስ ባር ባር ዳስታክቱ ፌ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ናዎባሳክቶ ስሩ ባሶ ስናስታ ስርድፋር ስንና ቦርአ አካሶን እቼ ፍናክ ራክካሴፌን ቢ። ዋሲ እዝግን ሳአትን ሀማ አሲሬ ሄፔ ሳአትኔን ፋ ካባሲ ባሪስታ ኩቲት ሀጝ ባሶክ የ። ባሶትኑ አቴ ሀማና ካባ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ስኑንታኖ ባሶ ባሪስታ ኩቲት ሀሚፌን ብየሴፋት፦ «ክታዋ» ይሴፋት ቻጌቴ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ዙታምቤሲሴ ብያት ናይሴቴ። የሱስ ደይ ጌሬጌሬ፦ «ሀሬዋ! ታዋ! ድጎትታዋ» ይ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>ጎኑስ ግሪሬ ባሶኔን አነ ዱባሴ ስሩስ ቤያ የሬ። ኤስ ባሪ ቦርኣ ናዎሳክቶ አካማኖን ዲንቀሴቴ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ንብቤሲስ ያዳቶ ቤያ ፋር ስንና ቦርአ ዜምማት ዛግቴ ቢስቴራ አሪቶኖይ ቱሻስ ቾዋኖን ኣነ አሪሶቶ።<verse eid="MRK 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ባሪሶን ፍነሬ ጌንሳሬት ይስቴ ዳስታክ ካርኤቴ። ጎኑሶን ኤክ ዳስታክ ታእስሬ ታርኤ ዬትሴቴ። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ጎኑስን ኬርሴፌ ካባሲክ አሱኒ ሜያ ጌሬጌሬ የሱስኒን አሪሴቴ። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ኤስ ዳ ዙታምባሴ አሲ ብራቶስታ ኤክ ሀጝ ኤለፋፌ የሱስ ፌናስታ ሜታን ሜያኖን ኦፖታ ዎርኤ ቴሸሴቴ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>ባር ሀሚና ሀሚና ድማ ዙታምባሴ አሲ ኬኤስ፥ ካታማስ፥ ቤዴስ ፌሴ ሜታን ሜያኖን ኤክ ያቦስታ ኤጴታፌ ቴሾ ማይባስ ፋሻኖነ ታኡሶነክ ሺጵሴት ፌሴቴር። ታእ ባሶኑ ዙቴሬ ፋርሴት ፌሴቴር።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">አባን ሜኒ ቱማ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማት. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>ፌርሳዊኒ ሜናዋ የሩሳለሙን ዬሴ እሳ እሳ ሙሴኒ ቱማሲ አስሲኛስና የሱስኒክ ዬሴሬ ዙቴሴቴ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱስኒ ናዎሳስን እሳ እሳይስ ቱማስማቶ ማስቴራ ካይምኖይ ኩሹክ ሙ ሜሴፌን ብየቴ። ካይምኖይ ኡስ ማስቶኖይ ኩሹ ኡ።<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>ፌርሳዊኒ ሜናዋ ኦም አይሁድኒ ሜና ኩርኡኒ ሜኒ ቱማሶን ኦዳክ ኩሹቤሲሶን ማሶ ሻክሴፋቴነ ኣነ ሜሴፌ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ኤሲስማቶ ደይ ጋባን ዎልሴፌ ካባሲክ ማሶኖይ ኣነ ሜሴፌ። ቱዎሶን፥ ግማሶን፥ ብታክ ዎሱስቴ ኮዳሶና ማሳነ ፋ ኦማ ኦማ ቱማሶኔን ኦደቱ ፌሴፌ።<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fqa" closed="false">ኩጶ፦ </char><char style="ft" closed="false">እሳ እሳ ትቻስ ኩጶ ይፋ ባሮን ዳይስር።</char></note><verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ኤስ ባሪ ቦርኣ ፌርሳዊኒ ሜናዋ ሙሴኒ ቱማሲ አስሲኛስና፦ «ኤኪን ነ ናዎሳክቶ ኩርኡኒ ሜኒ ቱማሶን ቤየፋት አዉኒ ቦርአ ኩሹቤሲሶን ማሶኖይ ሙ ሜሴፌሶ» ይት የሱስኒን ማሙሴቴ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>ስኑንታኖ ባር ዎልግሬ ኤካ ይ፦ «ንቶ ስኖይ ስንነ ቤስቴፌ አሱዋ፤ ራጁ ኢሳያስ ንቶ ቾዋሲክ ማኬፌና ካባሲክ፦</para>
  <para style="q1" vid="MRK 7:6">« ‹ሀን ዳራስ ኖኖባ ኖኖባሲክቱ ታን ኡልፍንስፌቴኖ፤</para>
  <para style="q2" vid="MRK 7:6">ንብባሲ ታይስታን አካማኖን ዎካዋ።<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>አሱ ቱሜና ቱማሶን፤</para>
  <para style="q2" vid="MRK 7:7">ሀኦኒር ዛግሴሬ አሲሴፋፌ፤</para>
  <para style="q2" vid="MRK 7:7">ሽማሲክቱ ታን ኡልፍንስፌዋ›</para>
  <para style="q2" vid="MRK 7:7">ይሬ ማኬና ባር ፉቶዋ።<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>«ንቶ ሀኦሲ አጃጅኖን ቤየፋት አሱኒ ቱማቱ ኦደፌትዋ።»<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ደይ የሱስ ቱስሬ፦ «ንቶ ቱማሶን ኦዳክዋ እያት ሀኦሲ ቱማኖን ቤያት ማአ ኡጉንት ፋርዋ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙሴ፦ ‹አባነስንናዋ እንቶኔሶንና ኡልፍንሱዋ› ደይ፦ ‹አባባስኒ ወደይ እንቶባሶን ሜአ ባር ዎርቶናክ ሾልስፋ› ይፋ። <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>ስኑንታኖ ንቶ ‹እሳ አሱ አባባስኒ ወደይ እንቶባሶን አሪጋሱና ዉዝባ ፋፋናነናዋ ኤስ ባሮን ደይ፦ «ሀን ባር ሀኦሲክ እምና እማዋ» እያናነ፤ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>አባባሲክናዋ እንቶባሲክና አሪጋሱ ቤያክ ችማናዋ› ይሴፌት። <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ኤሲሲክ ቴኤትንትስ ቱማኖን ኦዳክ ሀኦሲ ካማኖን ሻሬፌት። ደይ ኤፋ ኤፋ ሾዎ ዉዛ ዛግሴፌት።» <verse eid="MRK 7:13"/><verse number="14" style="v" sid="MRK 7:14"/>የሱስ ደይ ዳራስን ሄፕሳ ባርኪ ቴጌሬ፦ «ዙታምንትሴ ጋሳሲራ ታኪን ኦዶትዋ። <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>አሱኒ ኪንስፋስ አሱኒስኒ ኬስፋ ባርታኖ ጌሮን አሱኒስ ግሪፋ ባር ኣነ ኪንስፋዋ። <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ኤሴ ኦዶን ኦዶባ ፌና ባር ኦዶዎዋ!<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="fk" closed="false">ኤሴ ኦዶን ኦዶባ ፌና ባር ኦዶዎዋ፦ </char><char style="ft" closed="false">እሳ እሳ ትቻስታ ፋር</char></note>» ይ።<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱስ ዳራስን ቤይፋት ኬር ሀሚፌና ካባሲክ ናዎባሳክቶ ቤሶስ ኮታኖን ማሙሴቴ <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>ባር ደይ ባሶክ ዎልግሬ፦ «ንቶ ደይ ኣነ ጋዝጉዌትኖሶ? ጌሮን አሱኒ ካታስ ግሪፋ ባር እሳንነ አሱኒ ኣነ ኪንስፋ ስንናማቶ ኣነ አሩዌትኖሶ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>ካታስ ግሪፋ ባር ጌሮቱ ኬስፋታኖ ንብባሲ ኣነ ግሪፋዋ» ይ። ኤካ ኡባሲክ የሱስ ሙ ዙቴራ ካይማ ስኒባሶን ማኬ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ቱስሬ ደይ፦ «አሱኒን ኪንስፋስ አሱሳ ንብስኒ ኬስፋ ዉዛሲክቶዋ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>ኤስ ባር ደይ ማጙኖን ሳፋሮ፥ ሶሎ፥ ዊሶ፥ አሱኒ ዎሩ፤ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ጌርኬሳ፥ ጆሮ፥ ማጙ፥ ኤሻ፥ ጋፎ፥ ኮና፥ ሀማቶ፥ ቤጋንቶ፥ ግሮናታ ኡዋ። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ኤስ ማጙ ዉዛሲክቶ ዙቴራ አሱኒ ንብስኒቱ ኬስፋ። አሱኒን ደይ ኪንስፋ» ይ።<verse eid="MRK 7:23"/></para>
  <para style="s1">ስሮፍንቃክ አሱስ አማንቶ</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማት. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱስ ኤስታን ካብሬ ጢሮስኒ ካታማስ ቴሻ ፋ ኬኤስ ሀሚ። ኤስታ እሳ ኬር ግሪሬ ፎባሶን ኦኑ አሩኖይናማቶ ሾሌ። ስኑንታኖ ኣቾክ ኣነ ችሜ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ጋሮ ናዉባሶን ኪና አያና ኤጵና እሳ ማሽካሱ የሱስኒ ቾዋሶን ኦደፋት ጌሬጌሬ ያራ ዎቾባስ ሳጋደ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>አሱስ ስሮፍንቃውን ሜኒ ኬና ስና ግሪክኒ ካማቱ ዎል ሌፋ። ባር ደይ ናዉባስን ኪና አያናሶን ክሱናክ የሱስኒ ሺጴ። <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>ስኑንታኖ የሱስ፦ «ናንጎታስ ሙኖን ኤጴ ካናክ ሀኡ ማአሪታ። ሻካኒ ናንጎታስ ዜምማ ማራ ጋዉን» ይ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>አሱስ ዎልግራ፦ «ፉቶዋ ዳምታሶ! ካናሲክቶኑ ስላዎስ ስካሎስ ፋፋቱ ናንጎታስ ማፋና ካባሲክ ዝግፋ ፉፉኒቶሶን ማፋዋ» ይ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>ኤስ ባሪ ቦርኣ የሱስ ባርኪ፦ «ኤካ ማኮኔሲክ ኪና አያናስ ናኔስን ኬስዌ፤ ማርኦ ሀሜ» ይ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>አሱስ ደይ ኬባ ዎላ ሀማ ካርእን ኪና አያናስ ኬስፋን ናዋስ ፋሪራ ኩጶስታ ኩንፌን ዳኒ።<verse eid="MRK 7:30"/></para>
  <para style="s1">ኦዶ ኦዮስንናዋ ንብታቶስንና አሲ ፋሩ</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>ኤስታን የሱስ ጥሮሱን ኬሴ ስዶን ካሞ አቴ አሲር ካታማ ይስቴፋ ዳስታኪ ጋሊላን ባሪሲክ የ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>ኤስታክ እሳ ኦዶባ ኦዮናዋ ባቡላ አሱና አሲን አሱኒ ሜያ የሱስኒክ ኤጴ ዬሴቴ። ኩሹባሶን ደይ ባሳስታ ታኡናክ ሺጵሴቴ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱስ አሱስን ዳራሳታን ባር ባሪን ኦር ክስሬ ኩሹባስ ዋአክ ኦዶባስ ጌዳት ቱጃ ቱጀሬ አሱሳ ቴርማኖን ታፕት። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ደን ሳማ ካነ ብያት ስካለሬ ሳፋሬሬ «ኤፍታ» ይ። ኮትባስ ደይ «ጋቾ» ኡ።<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>ጌሬጌሬ ኦዶባስ ጋችቼ። ቴሩምባስ ደይ ኮቴ። እሳ ቱሳኦ ፎንቶኖን ማእስሬ ዎል ሌ። <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>የሱስ፦ «ሀን ባሮን ኦኒክኑ ማኮትታ» ይሬ ኤጴ የ ባሶክ አጃጀ። ስኑንታኖ ባሶ ማኮትታ ይና ባሮን ቤይፋት አሪክስሬ ዎሉምሴሴቴ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>አሱኒ ሜያ አካማኖን ዲንቆክ፦ «ዙታምባሴ አሲን ማአሪ ዛጊዋ። ኦዶ ኦዮኒ ሜያ ኦዶሶነክ፤ ንብታቶኒ ሜያ ዎሉምሶነክ ዛግ!» ይሴቴ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">የሱስ አቼች ኩማ አሱኒ ሜያኖን ማስ</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማት. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ኤስ ዎናሲክ ሾዎ ዳራ ሄፕሳ ደይ ዙቴ። ሙሶነ ሙ ኣፋ ስንና ቦርአ የሱስ ናዎኒ ሜያኖን ባርኪ ቴጌሬ፦ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>«ዳራስ ሀውጙ ኬዝ ዎና ካርኤ ታኔን አነቱ ፌሴቴ። ሙቤስ ኣፋ ስንና ቦርአ ባሶክ ሳፋሬፋዉጝዋ። <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ባሶስኒ እሳ እሳይስ ዎካ ዳኒ ዬሴቴር ስንና ቦርአ አፉር ኬቤስ ጋፍካናነ ኡጉንታ ጎዳ ታቴሴቴርዋ» ይ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>ናዎባሳክቶ ደይ፦ «ሀን ኢችማ ዳስ ሲ አሱ አይን ቱሻ ዳና ሀን ኤፌቴና ዳራስን ማሱክ ችምንሪንሶ?» ይሬ ዎሉግሴቴ። <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>የሱስ፦ «ንቶክ አፑን ቱሻንሶ ፋሪ?» ይሬ ማምሲ። ባሶ ደይ፦ «ናፉን ቱሻቱ ፋርዋ» ይሴቴ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>ዳራስን ዳስታክ ዱሶነክ አጃጀ። ኤስታን ናፉን ሙማ ቱሻሶን ኤጴ ሀኦ ጋላቴፋት ባቴ ዎሾነክ ናዎባሳክቶኒክ እሚ። ባሶ ደይ ዳራሲክ ዎሸቴ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ባሶክ ጋሮ ቁርጡም ፋር። ኤስ ባርኪ ሀኦሶን ጋላቴፋት ዎሾነክ ናዎባሳክቶኒን አጃጀ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>ናዎሳክቶ ደይ አሱኒ ሜያ ሜሴሬ ጋዉሴቴን ፉእቴ ባቶሶን እኛ እኛ ናፉን ማሳ ቱማኖን ዙትሴቴ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>ቱሻሶን ሜሴ አሱኒ ሜያ አቼች ኩም ስኖነ። ኤስታን ጌጌሲ።<verse eid="MRK 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 8:10"/>ኤሴን ኦርፎ ናዎባሳክቶኔን ጎኑስሲ ዲሴሬ ዳልማኑታ ይስቴፋ ዳስታክ ሀሜቴ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ቢስቴራ አሪቶኖይ ዉዛ ብያክ ማሙስቴ ማምሱ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማት. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፌርሳዊኒ ሜያ የሱስኒክ ዬሴሬ ባርኔን ካራካሮ ኤጴቴ። ፋታኖክ ሾልሴፋት ቢስቴራ አሪቶኖይ ዉዛ ሳማን ቤሱናክ ማሙሴቴ። <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>ባሳ ቴታሲክ አካማኖን ስካለሬ ሳፋሬፋት፦ «ሀን ኮንቶስ አዉኒ ቦርአ ቢስቴራ አሪቶኖይ ዉዛ ሾሌፋሶ? ፉቶክቱ ማኬፋውጙዋ፥ ሀን ኮንቶሲክ እሳ ቢስቴራ አሪቶኖይ ዉዛ ኣፋ እምቶና ዉዛ» ይ። <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>ፌርሳዊኒ ሜያኖን ቤይፋት ሄፕስ ዎል ሌ ጎኑስ ዲሬ የሳሎ ፍኒ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፌርሳዊኒ ሜናዋ ሄሮድስኒ ማሶሴ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማት. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>ናዎባሳክቶ ቱሻ ኤጴ ሀማ ዳግሴቴ ቦርአ ጎኑስ ፋዪስ እሳ ቱሻታኖ ኦማ ኣፋ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱስ ባሶትን፦ «ፌርሳዊኒ ሜናዋ ሄሮድስና አሲ ማሶስኒ ቴትንትሶን ኦድትዋ» ይሬ አጃጀ።<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ባሶትና ባሶትና፦ «እኖክ ቱሻ ኣፋ ስንና ቦርአዋ» ይት ዎሉምሴቴ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱስ ኤስ ባሶ ሳፋራሶን አሪፋት፦ « ‹ቱሻ እኖክ ኣፋ ስንና ቦርአዋ› ይት ንቶትና ንቶትና አዉኒሮን ዎሉምሴድፌትሪንሶ? ሀሽኔን ኣነ ጋዝጉዌትኖሶ? ኣነ አሩዌትኖሶ? ንብንትስ ያዳቶ ቤይዮሶ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>ኣፍንት ፌን ኣነ ብፌትኖሶ? ኦዶንት ፌን ኣነ ኦደፌትኖሶ? ንብንትስ ኣነ ካርፋኖሶ? <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ኡች ሙማ ቱሻሶን ኡች ኩም አሱሲክ ባትፋና ካባሲክ ፉእቴ ባቶሶን አፑን ማሳ ካቡግሴትሶ?» ይ። ባሶ ደይ፦ «አሲሬ ሄፔ» ይሴቴ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>ደይ «ናፉን ሙማ ቱሻሶን አቼች ኩም አሱኒክ ባትፋና ካባሲክ ፉእቴ ባቶሶን አፑን ማሳ ካቡግሴትሶ?» ባሶ ደይ፦ «ናፉን» ይሴቴ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>ባር ደይ፦ «ሀሽኑ ኣነ አሩዌትኖሶ?» ይ።<verse eid="MRK 8:21"/></para>
  <para style="s1">የሱስ ቤቴሳይዳክ እሳ ኣፍትሹንን ፋቲ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ቤቴሳይዳ ካርኤፌ ካባሲክ አሱኒ ሜያ እሳ ኣፍትሹንን ኤጴ ዬሴሬ የሱስ ታፕቱናክ ደይ ሺጵሴቴ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>ባር ደይ ኣፍትሹስ ኩሹባስ ዛቴ ኬኤሲ ጌራካሎ ክስሬ ኣፋስ ቱጅፋት ኩሹባሲክ ታእሬ፦ «እሳ ቢድፋ ታ ዉዛ ፋሮሶ?» ይሬ ማምሲ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>ኣፍትሹስ ደን ካነ፦ «አሱሳክቶ ኩቲት የሬ እኦኒማቶ ኩትሴድፌን ቢድፋዉጝዋ» ይ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ሄፕሳ የሱስ ኩሹባሶን ኣፋስታ ታእ። ኤስታን አሱስ ማእስሬ ቢ። ፋሪሬ ዎክሶክኔን ፋ ዉዛሶን ዙትሬ ማእስሬ ቢ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>ኤስታን የሱስ አሱስን ኬባ ጋፍካት፦ «ኬኤስ ግሩታታ<note caller="+" style="f"><char style="fr" closed="false">8:26</char><char style="fqa" closed="false">ኦኒክኑ እሳ ዉዛ ማኮታታ፦ </char><char style="ft" closed="false">ኦኒክኑ እሳ ዉዛ ማኮታታ ይፋ ባሮን እሳ እሳ ዜሞቲ ግሪክኒ ትቻስ ዳይስር </char></note>» ይ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጴጥሮስ የሱስኒን፦ «ነ ሙድቶዋ» ኡባስ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማት. 16:13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱስናዋ ናዎባሳክቶና ኬሳርያኒ ፍልጶስ ይስቴፋ ካታማስ ቴሻ ፋ ኬኤሲክቶስ ሀሜቴ። ኡግናስታክ፦ «አሱኒ ሜያ ታ ኦ ስንናማቶ ማክሴፌሶ?» ይሬ ናዎባሳክቶኒን ማምሲ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>ባሶ ደይ ዎልግሬ፦ «እሳ እሳይስ ሀጵቅፌ ዮሀኒስዋ፤ ኦሚስ ደይ ኤልያስዋ፤ ኦሚስ ደይ ራጁሳስን እሳይስዋ» ይሬቱ ማክሴፌዋ።<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>«ኤካኒ ንቶኬ፤ ታን ኦ ይፌትሶ?» ይሬ ማምሲ። ጴጥሮስ ዎልግሬ፦ «ነ ክርስቶስዋ<note caller="+" style="f"><char style="fr" closed="false">8:29</char><char style="fk" closed="false">ክርስቶስ፦ </char><char style="ft" closed="false">ክርስቶስ ኡ ግሪክኒ ካማ፥ እብራይስትክ ሜስ ኡ። ሄፖባሴ አሲ ኮትባስ «ሙድቶ» ኡ</char></note>» ይ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱስ ባሶክ፦ «ታ ቾዋሶን ኦንክኑ ማኮትታ» ይሬ አጃጀ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱስ ክቱና ባሮን እሶንሳ ማኬ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማት. 16:21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱስ ናዎኒ ሜያክ ኤካ ይት አስሱ ኤጲ፦ «አሱኒ ና አካማ ሻና ኤጴቶናክ ሾልስፋዋ። ኩርኡኒ ሜኒ ስናክ፥ ማግኒ ጋኛን ስናክ፥ ሙሴኒ ቱማሲ አስሲኛኒ ሜኒ ስናክ ካሽስቶኒር ደይ ዎርቶኒር። ስኑንታኖ ኬዝ ዎናኔን ኦርፎ ክቱኒ ካቡኒር።» <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ኤስ ባሮን ደይ አምማኖን ባሶክ ማኬ። ኤስ ካባሲክ ጴጥሮስ የሱስኒን ኦር ኤጴ፦ «ኤካ ኡታታዋ» ይት ኬእ። <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>ስኑንታኖ የሱስ ናዎባሳክቶኒክ የርቀሬ ብያት ጴጥሮስኒን ኤካ ይሬ ኬእ፦ «ነ ሴጣና፥ አሱሳሮንታኖ ሀኦሲሮን ኣነ ሳፋሬፌ ስንና ቦርአ ሄክ ኦርፎና ሀማ።»<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ኤስታን የሱስ ዳራስን ናዎባሳክቶኔን አነ ቴጌሬ ኤካ ይ፦ «ታኔን አነ ሀማክ ሾሌ ባር ባሳ ቴትን ሳፋራሶን ቤዮዋ። ባሳስታ ካርን ማስቃልን ሻናሶን ዎርኤ ታኔን አነ ሀሞዋ። <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ካባሶን ፉኦክ ሾሌፌ ባር ዙቴሬ ቱርኩና። ታክናዋ ምስራቹኒ ካማሲክና እያት ካባሶን ቱርክ ባር ዙቴሬ ፋቱና። <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>አሱ ሀን ዳስታኪ ፋ ዉዛሶን ዙትሬ ዳንፋት ካባሶን ቱርክፋናነ ባርኪ አዉ ኬኢንሪንሶ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>አሱ ካባሶን ፉሮክ አሮ ዋጋ ካሱንሪንሶ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ሀን አማኖኖይናዋ ቦርባሬ የሬ ኮንቶስ ጋነሲ ታክናዋ ታ ካማሲክና ኢቼፌ ባር ዙታምባሴ አሱኒ ና አባባሳ ኡልፍናክ ኮርቶ ዎሲያስኔን አነ ዬፌና ካባሲክ ባርኪ ኢቾና።»<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>ደይ የሱስ፦ «ፉቶ ንቶክ ማኬፋውጙዋ፤ ሀንታ የርሴ አሱኒ ሜያስን ሀኦሲ ታቶ አካማ ሁግናክ ያፌን ቢኖይፌጌዶ ክቱሶኖር እሳ እሳር ፌሴቴርዋ» ይ።<verse eid="MRK 9:1"/></para>
  <para style="s1">የሱስኒ ግቶስ ሶልቴ</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማት. 17:1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>እሱን ዎናኔን ኦርፎ የሱስ ጴጥሮስኒን ያቆብንናዋ ዮሀኒስና ደን ቴጋ ኣማስታ ባሶ ባሶትን ኤጴ ኬስ። ኤስታክ ባሶ ስናስታ ግቶባስ ሶልቴ። <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ማይባስ ደይ ፓልፓልራ ፎሬ። ሀን ዳስታኪ ማማ ሜእፌ ባር ኦኑ ካይኑክ ችምኖይናርነ ፋር ስንና አካማኖን ፎሬ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ኤስታን ኤልያስናዋ ሙሴና የሱስኔን አነ ዎሉምሴፌን ብየቴ። <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>ጴጥሮስ የሱስኒክ፦ «አስሲኛኖ! ሀንታ ፎኒስ እኖክ ማአሪዋ። እሳሮን ኔክ እሳሮን ሙሴኒክ እሳሮን ኤልያስኒክ ኬዝ ሀፎ ኬርአንዋ» ይ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>አካማኖን ድጌሴቴ ቦርአ ጴጥሮስ ማኬፌና ዉዛሶኑ ኣነ አሩዌ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ሻሩ ያራ ባሶትን ይንን ኤስ ሻሩስ፦ «ኬሽቴፋና ናታስ ሀንፌዋ! ባሪን ኦዶትዋ!» ይፋ ካማ ኦድቴ። <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ጌሬጌሬ የርቀሬ ብየቴን የሱስ ባር ባርቴኖ ባሶኔን ኦም ኦኒንኑ ኣነ ብዮቶ።<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኣማስታን ኬርሴፌ ካባሲክ የሱስ፦ «አሱኒ ና ክቱኒ ካቡናኔን ሀን ብየት ባሮን ኦንክኑ ማክሶትታዋ» ይሬ አጃጀ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>ባሳ ካማሶን ንብቤሲስ ኤጴፋት፦ «ክቱኒ ካቡ ኡስ ኣምባንሶ?» ይሴት ባሶትና ባሶትና ዎሉምሴቴ። <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>ባሶ ደይ፦ «ሙሴኒ ቱማሲ አስሲኛኒ ሜያ አዉኒ ቦርአ ‹ኤልያስ ዜምሜ ዮናክ ሾልስፋ ይሴፌሶ?› » ይት ባሪን ማሙሴቴ።<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>ባር ደይ ዎልግሬ፦ «ኣ፤ ኤልያስ ዜምሜ ዬሬ ዙታምባሴ አሲን ዜጳና። ስኑንታኖ አሱኒ ና አካማ ሻናሶን ኤጴቶናማቶናዋ ካሽስቶናማቶና ትቼናስ አዉኒ ቦርአንሶ? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>ስኑንታኖ ንቶክ ማኬፋውጙዋ፦ ‹ኤልያስ ደይ የዋ። ባርኪ ትቼናስማቶ ሾልሴቴሶን ዙትሬ ባሳስታ ዛግሴቴ› » ይ።<verse eid="MRK 9:13"/></para>
  <para style="s1">የሱስ ኪና አያና ኤጵና ናስን ፋቲ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማት. 17:14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>ኡኮት ፉእቴ ናዎኒ ሜያክ ዎልሴሬ ዬሴፌ ካባሲክ ሾዎ ዳራ ባሶ ብራቶስታ ዙቴሬ ፌሴቴን ሙሴኒ ቱማሲ አስሲኛኒ ሜያ ደይ ባሶኔን ዌኢንሴፌን ቢ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ጌሬጌሬ ዳራስ ዙቴሬ የሱስኒ ብየቴሴ ዲንቀሴቴ። ባርኪ ኤልለ ናጋ ኦሸሴቴ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱስ ደይ ባሶክ፦ «አሮ ዉዛንሶን ባሶኔን ካራካርሴድፌትሪ?» ይት ማምሲ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>ዳራሳስን እሳ አሱ ዎልግሬ፦ «አስሲኛኖ! ንባ ታርአ አያና ኤጵና ናታስን ኔክ ቴሸጝዋ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ካብፋና ካባሲክ ኤጳቱ ሀእፋ፤ ኖኖባስ ጉሳ ካርኤቱ ሀይባሶ ኮይፌ፤ ደይ ኮጝስር፤ ክሶነክ ነ ናዎሳክቶኒክ ማኬና ኣነ ችሞቶ» ይ።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱስ ዎልግሬ፦ «አማኖኖይ ኮንቶ ኣጌኔን ንቶኔን አነ ፎናሪንሶ? ኣጌኔን ንቶትን ፋኩናሪንሶ? ሀጝ ታክ ቴሾትዋ» ይ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ባሶ ደይ ናስን ባርኪ ቴስሸሴቴን ባሪን ቢናይሴ ኪና አያናስ ጌሬጌሬ ናስን ጋንስራ ቶኮናክ ዛግራ ጉሳ ካርኤት ዳስታክ ቡካለ። <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>የሱስ ናሳ አባንን፦ «ሀን ባር ኤጵናኔን አፑን ነያንሶ?» ይሬ ማምሲ። አሱስ ደይ ዎልግሬ፦ «ዳግባሴኔጝዋ። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>ሾዎ ዎና ትሽኩናክ ጌያስናዋ አካስና ጌዳር። ኔክ ችምቴፋናነ እኖክ ኬናሽቶዋ፤ ደይ አሪጋሱዋ» ይት ሺጵሴቴ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱስ ደይ፦ «ችምፋታነ ይፋቶሶ? አማነፌ ባርኪ ዙታምባሴ ችምቴርዋ» ይ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ጌሬጌሬ ናሳ አባ፦ «አማነፋዉጝዋ! አማኖን ሆፕናሶን አሪጋሱዋ» ይት ቻጊ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱስ ደይ ዳራስ ኩይቴት ዮባሶን ብያት ኪና አያናሶን፦ «ነ ንባ ታቶ፤ ኦዶ ኦዮ አያናስ ናሳስን ኬስ! ሄፕስ ዎላ ግሩኖይታማቶ አጃጀፋን!» ይሬ ኬእ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ናስ አካማኖን ቶኮናክ ዛግራ ቻጋ ኬስ። ሾዎቤሲስ፦ «ክት» ኡሶነኔን ዱግኖነ ፌር ስኒ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ስኑንታኖ የሱስ ኩሹባስ ዛቴ ካብግኒ የሬ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱስ ኬር ግርናኔን ኦርፎ ናዎባሳክቶ፦ «እንኖ ክሱክ ሆፕኒስ አዉኒ ቦርአንሶ?» ይሬ ባር ባሪን ማሙሴቴ።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>«ሀን ኤፋስ ሶሞክናዋ ሺጶክና ስና ሻካናነ እሳንነ ኬሳክ ኣፋ ችማናዉዛ» ይ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱስ ክቱና ባሮን ሄፕሳ ማኬ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማት. 17:22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30-31" style="v" sid="MRK 9:30-31"/>ኤስታን ኬሴሬ ጋሊላ ካሞ አቴ ሀሜቴ። የሱስ ናዎኒ ሜያክ አሲት ፌር ስንና ቦርአ ባር ፌና ድማሶን ኦኑ አሩናክ ኣኔ ሾሎዌ። ኤካ ደይ ይ፦ «አሱኒ ና አሱኒ ሜኒ ኩሹስ አቴሬ እምቶክ ዎርቴሬ ኬዝስናር ዎኖ ክቱኒ ካቡኒር።»<verse eid="MRK 9:30-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>ኤስ ቾዋሲ ባሶክ ኣነ ጋሎዋ። ባሪን ማምሱክ ደይ ድጌሴቴ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ኦንሶ እንኖስን አሪክሪ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማት. 18:1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>የሱስናዋ ናዎባሳክቶና ክፍርናሆም ዬሴቴ። ኬር ግርሴቴኔን ኦርፎ፦ «ንቶትና ንቶትና ኡግናስታ ኣምባንሶ ዎሉምሴትሪ?» ይሬ ባሶትን ማምሲ።<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>ስኑንታኖ ባሶ ኡጉነ ሀሜፌት፦ «ዙታምባሴ አሲሳታን አሪክር ኦ ስኑገሶ?» ይሴሬ ዎሉምሴቴ ቦርአ ሻክሴቴ። <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱስ ደይ ዲፋት አሲሬ ሄፔስኒ ባርኪ ቴጌሬ «ስና ዜምማክ ሾሌፌ ባር ዙታምባሴ አሲ ኦርፎ ስኖ፤ ደይ ዙታምባሴ አሲ ዎስትኛ ስናናክ ሾልስፋ» ይ። <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>እሳ ዳጋ ናዋ ቴሸሬ ጋነቤሲስ ዬታት እድሜ፦ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>«ሀኒስንነ ፋ ዳጋ ናንጎታስን እሳይሶን ታ ሱናሲክ እርባ ዛግሬ ኤጴቴፌ ባር ዙታምባሴ ታን ኤጴቶናዋ። ታን ኤጴቴፌ ባር ደይ ዙቴሬ ታን ዎሲ ባሪንቱ ኤጴቴቴኖ ታንታዋ» ይ።<verse eid="MRK 9:37"/></para>
  <para style="s1">እኖትን ቱጋኦኖይ ባር እኖኔጝዋ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዮሀኒስ የሱስኒክ፦ «አስሲኛኖ! እሳ አሱ ነ ሱናሲክ ኪና አያናሶን ክስፌን ብያት እኖኔን አነ ስና ቤይና ቦርአ ካልንዋ» ይ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ስኑንታኖ የሱስ፦ «ታ ሱናሲክ ቢስቴራ አሪቶኖይ ዉዛ ዎስቴፋት ጌሬጌሬ ታይስታ ማጙ ካማ ዎሎክ ችምንር ኣፌ ስንና ቦርአ ካላትታዋ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>እኖትን ቱጋኦኖይ ባር እኖኔን አነዋ። <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ፉቶ ንቶክ ማኬፋውጙዋ፤ ክርስቶስኒር ስኒት ቦርአ ታ ሱናሲክ እሳ ቶፎ አካ ንቶክ እማ ባር ዋግባ ኣፋ ትሹና ዉዛ» ይ።<verse eid="MRK 9:41"/></para>
  <para style="s1">አሱኒክ ቱሳ ስናስታን ቴትን ኦዳ</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማት. 18:6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>ቱስሬ ደይ፦ «ሀን ታክ አማነፋ ጋሮ ጋሮ ናንጎታስን እሳይሶን ቱሳስፌ ባር ዙቴሬ ፋያ ዎኒ ሹአ ሱትባስታ ታቴራ ትርእማሲ ሀቴፋናነ ማአና ካባዋ። <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>ኩሹኔስ ቱሳሳናነ ካርአ ሀኡዋ። ሄፕ ኩሹነ ፋፋን ጌኒ ትርእማሲ ሀቶስታን ኩሹ ዱጙ ስንና ካኒ ኬር ግሩ ማአሪዋ። <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>[ጌኒ ትርእማሲ ቶባስ ክቱኖይናር፤ ጌባስ ትሹኖይናርዋ]<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="fqa" closed="false">ቶባስ ክቱኖይናር ጌባስ ትሹኖይናርዋ፦ </char><char style="ft" closed="false">ግሪክኒ ማፃፋሲ ኤካ ይፋር ኣፋ።</char></note>። <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>ዎቾኔስ ቱሳሳናነ ካርአ ሀኡዋ። ሄፕ ዎቾነ ፋፋን ጌኒ ትርእማሲ ሀቶስታን ዎቾ ፎንቶ ስንና ካኒ ኬር ግሩ ማአሪዋ። <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>ጌኒ ትርእማሲ ቶባስ ክቱኖይናር፤ ጌባስ ትሹኖይናርዋ<note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="fqa" closed="false">ቶባስ ክቱኖይናር ጌባስ ትሹኖይናርዋ፦ </char><char style="ft" closed="false">ግሪክኒ ትቻስ ኣፋ።</char></note> <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>ኣፍኔስ ቱሳሳናነ ዎእራ ክሱዋ። ሄፕ ኣፍነ ፋፋን ጌኒ ትርእማሲ ሀቶኔስኔን እሳ ኣፍነ ፋፋን ካኒ ኬር ግሩ ማአሪዋ። <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>ጌኒ ትርእማሲ ቶባስ ክቱኖይናር ጌባስ ደይ ትሹኖይናርዋ።<verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>«ማኣ ዙታምባሴ ካዎክ ሞቸራ ካይምፋናይሲማቶ<note caller="+" style="f"><char style="fr" closed="false">9:49 </char><char style="fqa" closed="false">ማአ ዙታምባሴ ካዎክ ሞቸራ ካይምፋናይሲማቶ፦ </char><char style="ft" closed="false">ይፋ ባር ኦማ ማፃፋሲ ኣፋ</char></note> አሱ ደይ ዙቴሬ ጌያክ ካይማናክ ሾልስፋ።<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>«ካዎ ማአሪዋ፤ ስኑንታኖ ካዎ ካኣርባ ፎንቶ ስንፋናነ አዉክ ካቱትሪንሶ? ካኒትስ ካዎኒ ካኣርአ ፎጝዋ። ንቶትና ንቶትና እሳ ሳፋራክ ፎቲ» ይ።<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">የሱስ አሱኒ ኮትን ቾዋ አሲ</para>
  <para style="r">(<ref loc="MAT 19:1-12">ማት. 19:1-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱስ ኤስታን ካብሬ ዮርዳኖስኖን ፍንነ ዩዳክ ዳስታክ ሀሚ። ሾዎ አሱ ባርኪ ኤስታ ሄፕሳ ዙቴሴቴን ዜሞቲ ዛግፌናይስማቶ አሲት ፌር።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>እሳ እሳ ፌርሳዊኒ ሜያ ዬሴሬ ባሪን ፋታኖክ፦ «አሱ አሱባሶን ጋፍኩናክ ቱማስ ማኬዎሶ?» ይሬ ማሙሴቴ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>የሱስ ደይ ዎልግሬ፦ «ሙሴ ንቶክ ኣምባንሶ አጃጀናሪ?» ይ።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>ባሶ ደይ፦ «ሙሴ ጋፍኩኒ ትቻሶን እሜ ጋፍኩናክ ማኬዋ» ይሴቴ።<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱስ ዎልግሬ፦ «ንቶ ንብባሲ ችማክቱ ኤስ አጃጂሶን ትችዋ። <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ስኑንታኖ ‹ሀኦ ቴስቶስ ቴሱታ ኣርቃርናዋ ማሽካሬ ዛጊዋ። <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ኤስ ባሪ ቦርኣ አሱ አባባስንናዋ እንቶባሶንና ቤየ አሱባስኔን እሳር ስኒፌ። <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ሄፖቤሲሴ እሳ አቱቱ ስኖነ›። ኤስ ባሪ ቦርኣ ባሶ እሳ አቱታኖ ሀንኔን ኤካሎ ሄፕቴዋ። <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ሀኦ እሳር ዛግና ባሮን ኤሴ አሱ ኦር ክሱናታዋ» ይ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኬር ግርሴቴኔን ኦርፎ ናዎባሳክቶ ሄፕሳ ኤስ ቾዋሶን ካቡግሴሬ ማሙሴቴ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱስ ደይ፦ «አሱባሶን ጋፍካት ኦማ አሱ ኤጵፌ ባር አሱባስታ ጌርኬስዋ። <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>አሱስ ደይ ቴጎባስኪን ኬሳ ኦምንክ ግሪፋናነ ጌርኬስዋ» ይት ዎልጊ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱስ ጋሮ ጋሮ ናንጎታሶን ሱስ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማት. 19:13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱስ ጋሮ ጋሮ ናንጎታሶን ታፕቱናክ አሱኒ ሜያ ባርኪ ቴሸሴቴ። ኤስ ቴሸ ባሶትን ደይ ናዎባሳክቶ ካለሴቴ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>ስኑንታኖ የሱስ ብያት ግኢቴሬ፦ «ጋሮ ጋሮ ናንጎታስ ታክ ዮሶን፤ ቤይት ካላትታ። ሀኦሲ ታቶ ሀን ባርኪቶነ ፋይስርዋ። <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ፉቶ ንቶክ ማኬፋውጙዋ፤ ሀኦሲ ታቶኖን ዳጋ ናዋነ ፋሮን ዛግሬ ኤጴቶኖይ ባር እሳንነ ኣፋዋ ግሩና ዉዛ» ይ። <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>እድሜ ኩሹባሲክ ታእሬ ሱስ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ሀን ዳስታኪ ኦትማሴዋ ሀኦሲ ታቶነ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማት. 19:16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱስ ኡግና ሀማናክ ኬስፌን እሳ አሱ ባርኪ ኤልለ ዬሬ ስኒባ ካአነፋት፦ «ጋራም አስሲኛኖ! ኮእባ ፎንቶ ካ ዳናናክ አዉ ዛጉናሪንሶ?» ይት ማምሲ። <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>የሱስ ዎልግሬ ኤካ ይ፦ «አዉኒሮን ታን ጋራም ይፋሶ? እሳ ሀኦሲኔን ኦማ ጋራማ ኣፋዋ። <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>አጃጂስ ደይ፦ ‹ካ ዎሩታታ፥ ጌርኬሳታታ፥ ዊሶታታ፥ ኤሻ ዛላ ማኮታታ፥ አሱኒን ኤሻታታ፥ አባነስንናዋ እንቶኔሶንና አሲን ኡልፍንሱ› ይፋናማቶ አሪታርዋ» ይ።<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>አሱስ ዎልግሬ፦ «አስሲኛኖ! ኤስ ባሮን ዙትራ ጋሮናሴኔን ኦዳቱ ፋዉጝዋ» ይ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱስ ቢሬ ኬሽቴ፤ ደይ ኤካ ይ፦ «እሳ ዉዛቱ ኔኪን ዮእርዋ። ሀምፋት ፋ ኦቱምኔሶን ዙትራ ክስራ ዋጋት ቱካምኒ ሜያክ እማ። ደን ሳማኪ ኦትማ ዳናታዋ። ኤካት ዬን ታኔን አነ ሀሚንዋ» ይ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>ስኑንታኖ ኤስ ቾዋሲክ ስኒባስ ካራየ። አካማ ኦቱምባ ፋር ስንና ቦርአ ሱሜት ሀሚ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>የሱስ የርቀሬ ብያት ናዎኒ ሜያክ፦ «ኦቱምቤስ ፋና ባሶክ ሀኦሲ ታቶስ ግሩ አዉነ ፋሮን ትርኦንሶ!» ይ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>ናዎኒ ሜያ ኤስ ማኬና ካማሲክ ዲንቀሴቴ። ስኑንታኖ የሱስ ቱስሬ፦ «ናንጎትኖ!<note caller="+" style="f"><char style="fr" closed="false">10:24 </char><char style="fqa" closed="false">ዋጋክ አማነፌ ባሶክ፦ </char><char style="ft" closed="false">ይፋ ባር እሳ እሳ ዜሞቲ ግሪክኒ ትቻስ ፋር።</char></note> ሀኦሲ ታቶስ ግሩ አዉነ ፋ ትርኦንሶ! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ኦቱም አሱ ሀኦሲ ታቶስ ግሩባስታን ጋላ ማሩፍን ኣፍስ ካሞ ኣትባስቱ ካሾዋ» ይ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>ናዎኒ ሜያ ዜሞቲስታን አካማኖን ዲንቀሴፋት ባሶትና ባሶትና፦ «ኤሴኑ ኦ ፋሩክ ችምንሪንሶ?» ይሴቴ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱስ ባሶትን ብያት፦ «ፉቶሲክ ሀን ባር አሱኒክ ኣፋ ችምቶና ዉዛ። ስኑንታኖ ሀኦሲክ ችምቴር። ሀኦሲክ ዙታምባሴ ችምቴርዋ» ይ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጴጥሮስ ደይ፦ «ኤሴኑ እንኖ ዙታምባሴ ቤያ ነኔን አነ ያንዋ» ይ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱስ ዎልግሬ፦ «ፉቶክ ንቶክ ማኬፋውጙዋ፤ ታክናዋ ምስራቹኒ ካማሲክና ኬባሶን ወደይ አይባሳክቶኒን ወደይ ኤትባሲክቶኖን ወደይ እንቶባሶን ወደይ አባባስኒ ወደይ<note caller="+" style="f"><char style="fr" closed="false">10:29 </char><char style="fqa" closed="false">አሱባሶን፦ </char><char style="ft" closed="false">ይፋ ባር እሳ እሳ ዜሞቲ ግሪክኒ ትቻስ ፋር። ኦማ ትቻስ ኣፋ</char></note> ናንጎትባሶን ወደይ ቡሎባሶን ቤያ ባር ዳይስሬ ዳናናዋ። <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ሀሽ ሀን ነያሲክ ካቡግቶክ ኬያሶን፥ አይሳክቶኒን፥ ኤትሲክቶኖን፥ እንቶሲክቶኖን፥ ናንጎታሶን፥ ቡሎሶን ትያ ኩሹኖን ዳናና። ዮን ነያሲክ ደይ ኮኢባ ፎንቶ ካ ዳንኖር ኦኑ ኣፌዋ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ስኑንታኖ ስና ዜምሜ ፌ ሾዎኒ ሜያ ኦርፎ ዎልሶነ። ኦርፎ ዎል ሌፌ ባሶ ደይ ስና ዜሞነ» ይ።<verse eid="MRK 10:31"/></para>
  <para style="s1">የሱስ ኬዝሳ ባሳ ክቱኒ ቾዋሶን ማኬ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማት. 20:17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>ደን የሩሳሌም ሀሚፋ ኡግናሲክ ሀሜፌን የሱስ ስና ዜምሜት ፌር ስንና ቦርአ ናዎባሳክቶ ዲንቀሴቴ። ኦርፎባሴ ሀማ ባሶ ደይ ድግሴት ፌሴቴር። ሄፕስ ደይ አሲሬ ሄፔ ናዎባሳክቶኒን ባርኪ ታእስሬ ባሳስታ ካርአናክ ፋ ቾዋሶን ባሶክ ማኮ ኤጲ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>«ኤሴ የሩሳሌም ሀሚንርዋ። አሱኒ ና ማግኒ ጋኛንክናዋ ሙሴኒ ቱማሲ አስሲኛኒ ሜያክና አቴሬ እምቶኒር። ባሶ ደይ ክቱኒ ማጝሱኒ ካርአ ባሳስታ ካርኦነር። አዛብኒ ሜያክ ኣትሬ እሞነር። <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>ባሶ ደይ ካኞነር፥ ቱጆሶነር፥ እቾነር ደይ ዎርሶነር፥ ስኑንታኖ ኬዝ ዎናኔን ኦርፎ ክቱኒ ካቡኒር» ይ።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያቆብናዋ ዮሀኒስና አሲ ማምሱ</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማት. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ኤሴን ኦርፎ ዛብድዮስኒ ናንጎት ያቆብናዋ ዮሀኒስና የሱስኒክ ዬሴሬ፦ «አስሲኛኖ! እንኖ ማምሱን ቾዋሶን ዙትራ ዛጉታክ ሾሌፌንዋ» ይሴቴ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>የሱስ ደይ፦ «ንቶክ አዉ ዛጉናኪንሶ ሾሌፌትሪ?» ይ።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>ባሶ ደይ ዎልግሬ፦ «ነ ታቶስ ኡልፍንቶኒ ካባሲክ እሳርኒስ ኦእታ ቴሽኔስታ እሳርኒስ ደይ አልዳ ቴሽኔስታ ዱኒክ ማእ ኡዋ» ይሴቴ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ስኑንታኖ የሱስ፦ «ማምሲፌት ባሮን ኣነ አሪፌትዋ። ታ ኡሻናክ ፋ ሻናን ኡሻሶን፤ ታ ሀጱክቶናክ ፋ ሀጱክቶሶን ሀጱክቶትክ ችማትሮሶ?» ይ።<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ባሶ ደይ፦ «ኣ፥ ችማናዋ» ይሴቴ። የሱስ፦ «ታ ኡሻናክ ፋ ኡሻሶን ኡሻት፤ ታ ሀጱክቶናክ ፋ ሀጱክቶሶን ሀጱክቶትዋ። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>ስኑንታኖ ኦእትናስታናዋ አልድናስታና ዱስ ሆሬና ባሶክታኖ ኤስ ባሮን እምኒስ ታቴዋ» ይ።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>ፉእቴ አሲር ናዎሳክቶ ኦደሴሬ ያቆብኒስታናዋ ዮሀኒስኒስታና ግእቴሴቴ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱስ አሲሬ ሄፔ ናዎሳክቶኒን ባርኪ ቴጌሬ ኤካ ይ፦ «አዛብኒ ሜኒ ጋኛ ይስቴፌ ባሶ ዳራቤሲስን ሁግናክ ሀኢስሴፌማቶ አሪሴፌት። ኤሲስማቶ ደይ ዞንሲሴፌ ባሶ ደይ ኤስ ዳራሳታ ሀእሱኒ ቱማ ሁግናቤስ ፋናማቶና አሪሴፌት። <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>ስኑንታኖ ንቶኪክ ኤካታዋ። ንቶስኒ አሪክር ስናክ ሾሌፌ ባር ንቶ ዎስትኛ ስኖዋ። <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ንቶስኒ ኦኑ ዜምማክ ሾሌፌ ባር ዙታምንትሴ አሲ ቦዝ ስኖዋ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>ኤሲስማቶ አሱኒ ናስኑ ዎስቶናክናዋ ካባሶን ሾዎኒ ሜያኖን ፉሮክ ኣትሬ እማናክታኖ ባርኪ ዎስቶሶነክና ኣነ ዮዌዋ።»<verse eid="MRK 10:45"/></para>
  <para style="s1">የሱስ ኣፍትሹ ቤርቴሜዎስኒን ፋቲ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማት. 20:29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>የሱስ ናዎኒ ሜያኔን እያሪኮ ዬሴቴ። ኤስታን ኬሴፌን ሾዎ ዳራ ባሶኔን አነ ሀሜድፌር። ኡግናስ ሀእታ ደይ ቴሜዎስኒ ና ኣፍትሹ ባርጠሜዎስ ዲፋት ሺጴት ፌር። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ናዝሬትክ የሱስ ስኒባሶን ኦደናይሴ፦ «ዳዊትኒ ዛላስኒ ኮንቴ የሱስኖ! ታን ማሮዋ» ይት ቻጋ ኤጲ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ሾዎ አሱኒ ሜያ ሻኩናክ ኬእሴቴ። ስኑንታኖ ባር፦ «ዳዊትኒ ዛላስኒ ኮንቴ ናሶ ታክ ኬናሽቶዋ» ይት ኣታምሲሬ ቻጊ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱስ የሬፋት፦ «ቴጎትዋ!» ይ። ባሶ ደይ ኣፍትሹስኒ፦ «ሀሬዋ! ካቡዋ ኔን ቴጌድፌዋ!» ይት ቴግሴቴ።<verse eid="MRK 10:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50"/>ባር ደይ ጌሬጌሬ ካብሬ ቱካስታክ ማይባሶን ሀኣት የሱስኒክ የ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱስ ዎልግሬ፦ «አዉ ኔክ ዛጉናክ ሾሌፋሶ?» ይ። ኣፍትሹስ ደይ፦ «አስሲኛኖ! ብያናክዋ!» ይ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱስ ደይ፦ «ሀማ፥ አማንቶኔስ ኔን ፋትዋ» ይ። ጌሬጌሬ ብየት ኡጉነ ባሳ ኦርፎሴ ሀሚ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">የሱስ አካማ ኡልፍናክ የሩሳሌም ግር</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማት. 21:1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19:28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሀ. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>የሱስናዋ ናዎባሳክቶና የሩሳሌም ታእሴሴፌ ካባሲክ ቤቴፋጌነዋ ብታኒያነ አሲስ ካሞ ዳብራዛይትኒ ኩማስታ ካርኤቴ። ኤስታን ናዎባሳስን ሄፕን ኤካ ይት ዎሲ። <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>«ኤክ ስኒትስታ ፋ ኬኤስ ሀሚት። ኤስታ ካርኤትሴ ኦኑ ባርስታ ዱኖይና ሀኛን ናዋ ቱፕቴራ የሬፌኒ ዳናት። ኮታ ሀጝ ኤጳ ዮትዋ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>ኦኑ፦ ‹አዋጋን ሀን ባሮን ዛግድፌትሪንሶ?› እያናነ ‹ዳሚሲክ ሾልስና ቦርአ፥ ሀሽ ጌሬጌሬ ዎልግሬ ጋፍኩና› » ኡት።<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>ባሶ ደይ ሀሜቴን ሀኛን ናዋ ኡግናስ ቴሽታ ኬን ፎቻታ ቱፕቴራ የሬፌኒ ዳነሬ ኮቴቴ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ኤስታ የርሴ ባሶስኒ እሳ እሳይስ፦ «ሀኛስ ናዋኖን አዉኒሮን ኮትድፌትሪንሶ?» ይሴቴ።<verse eid="MRK 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6"/>ባሶ ደይ የሱስ አጃጀናስማቶ ማክሴቴ። አሱኒ ሜያ ደይ ዎል ሌ ቤየቴ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ናዎሳክቶ ሀኛሶን የሱስኒክ ኤጴ ዬሴቴ። ማይቤሲሶን ጌሾባስታ ኩኑሴቴን ባርስታ ድ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ሾዎ አሱኒ ሜያ ማይቤሲሶን ኡግናስታ ይርኤቴ። ኦሚስ ደይ እኦኒ ቶሻ ኪርኤ ይርኤት ፌሴቴር። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>ስና ዜምማ ባሶናዋ ኦርፎባሴ ዬሴፌ ባሶና ዙቴሬ፦ «ሆሳና! ዳሚሳ ሱናክ ዬፌ ባር ሱስቶዋ።<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">ሆሳና፦ </char><char style="ft" closed="false">ሆሳና ኡስ ጋላታ፥ ግራ፥ ኡልፍና ስር ፎባሶንቱ ቤስፋ።</char></note> <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>ዳሚሳ ሱናክ ዮን አባን ዳዊትኒ ታቶስ ሱስቶዋ። ሆሳና ደን ሳማኪ» ይት ቻጌት ፌሴቴር።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱስ የሩሳሌምክ ቤቴሜቅደሲሲ ግር። ብራቴሬ ዙታምባሴ አሲን ቢናንኔን ኦርፎ ጌሮክ ዋልድፋር ስንና ቦርአ አሲሬ ሄፔ ናዎባሳክቶኔን ብታኒያ ሀሚ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱስ ኤርውና ቤለስኒ እኦ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማት. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዎኖትር ዎኖ ብታኒያን ኬሴፌን የሱስ ማክቴ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>ቶሽባሬ የሬ ቤለስኒ እኦ ዎክሶክ ብያት ጋና ባርስኒ ቤስቶኒቶ እያት ባርኪ ሀሚ። ስኑንታኖ ጋንፋና አስባ ስና ቤይና ቦርአ ቶሻ ቶሻታኖ እሳንነ ዳና ጋና ኣፋ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>ኤስ ባሪ ቦርኣ ቤለሲሶን፦ «ሀውጙኔን ኤካሎ ኦኑ ኔኪን እሳንነ ጋና ሙናታዌ» ይ። ናዎባሳክቶ ደይ ኤስ ባሮን ኦደሴቴ።<verse eid="MRK 11:14"/></para>
  <para style="s1">የሱስ ቤቴሜቅደሲሲ ናጋደፌ ባሶትን ካሌ ክስ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማት. 21:12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19:45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሀ. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>የሩሳሌም ካርኤፌ ካባሲክ ቤቴሜቅደሲሲ ኦጅን ኬርካሎ ግሪሬ ኤስታክ ክስሬ ዋግሴፌ ባሶትናዋ ጌሮን ዋግሴፌ ባሶትና ካሌ ክሱ ኤጲ። ዋጋ ሶለት ፌ ባሶ ታራቤዛሶናዋ ናካሎ ዋጌፌ ባሶ ኮዳሶና ሸልግሬ ሀእ። <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>ኤስታን የሱስ፦ «ኦኑ እሳ ዉዛ ዎርኤ ቤቴሜቅደሲሲ ኬርካሎ ግሩናታዋ» ይ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>ደይ ኤስታ ፌ አሱሲክ አሲፌና ካባሲክ ኤካ ይ፦ «‹ኬናስ ዳራ ዙታምባሴ አሲ ሀኦኒ ሺጶኒ ኬያዋ› ይስቴራ ኣነ ትቾዋኖሶ? ስኑንታኖ ንቶ ቦእኛኒ ዱጋዱግ ዛግትዋ።»<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ማግኒ ሜኒ ጋኛን ሜናዋ ሙሴኒ ቱማሲ አስሲኛስና ኤስ ባሮን ኦደሴቴ። ዳራስኔን ዙቴሬ ባሳ አሱሲክ ዲንቀት ፌሴቴር ስንና ቦርአ የሱስኒን ድጌሴቴ ኤስ ባሪ ቦርኣ ኣካክ ዎርሶነማቶ ሾልሴት ፌሴቴር።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ዋልፋና ካባሲክ ደይ የሱስናዋ ናዎባሳክቶና ካታማስን ጌራካሎ ኬሴቴ።<verse eid="MRK 11:19"/></para>
  <para style="s1">ቤለስኒ እኦስኪን ቤስቴ አሩ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማት. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ኤእሶ ዎኒሳክ ኡጉነ ሀሜፌን ቤለሲስ ታስባስኔን እችማ ዲፌን ብየቴ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጴጥሮስ ንባስታ ኬጅፋን፦ «አስሲኛኖ! ነ ኤርውታ ቤለሲስ እችምዋ» ይ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>የሱስ ባሶክ ዎልግሬ ኤካ ይ፦ «ሀኦሲክ አማኖትዋ። <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ፉቶ ንቶክ ማኬፋውጙዋ፤ ኦኑ ንብባሲ ስኑጙጋሶ ኡኖይ ማኮና ባር ዛግቶናማቶ አማነሬ ሀን ኣማሶን፦ ‹ዋቴራ ባሪስ ሀእቶዌ› እያናነ ባርኪ ስናናዋ። <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>ኤስ ባሪ ቦርኣ ሺጶክ ማምሲት ዉዛሶን ዙትራ ዳንትር ዛግራ አማኖትዋ ንቶክ ስናና። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ሺጴፌት ካባሲክ ደን ሳማኪ ፌ አባንቲስ ቦርንትሶን ፌሹን ኡናክ አሱኒስታ እሳ ቾዉኒት ፋፋናነ ፌሹን ኡትዋ። <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>ስኑንታኖ ንቶ አሱሳ ማጝሱኖን ፌሹን ኡ ሻካትነ ደን ሳማኪ ፌ አባንቲስ ቦርንትሶን ኣፋ ፌሹን ኡናዉዛ።»<verse eid="MRK 11:26"/></para>
  <para style="s1">የሱስኒ ሀእሱኒ ሁግናስ አይን ስንናማቶ ማሙስቴ ማምሱ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማት. 21:23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>ሄፕሳ ደይ የሩሳሌም ዬሴቴ። የሱስ ቤቴሜቅደሲሲ ኩትፌን ማግኒ ጋኛን ሜያ፥ ሙሴኒ ቱማሲ አስሲኛናዋ ኩርኡኒ ሜና ባርኪ ዬሴሬ፦ <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>«ሀን ባሮን አዉኒ ሀእሱኒ ሁግናኪንሶ ዛግኢፋ ዛግድፋታሪ? ወደይ ሀን ባሮን ዛጉታክ ሀእሱኒ ሁግና ኔክ እማር ኦንሶ?» ይት ማምሲሴቴ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱስ ደይ፦ «ታ እሳ ማምሱ ንቶትን ማምሱናዋ። ኤስ ማምሱናሶን ዎልግፋትነ ታ ደይ ሀን ባሮን አዉኒ ሀእሱኒ ሁግናክ ዛግፋናማቶ ንቶክ ማኮናዋ። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዮሀኒስኒ ሀጵቁስ ሀኦስኪን ያሪጝዋ ወደይ አሱኒኪኒንሶ?» ይ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ባሶትና ባሶትና ኤካ ይሴቴ፦ «ሀኦኪን ያር እያንነ ኤኪን አዉኒሮን ባር ማኬና ባሮን አማኖ ቤይትሶ? ኡኒር። <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>ኤሴ አሱኒኪን ኡንሮሶ?» ኤካ ኡሶኖይቴማቶ አሱ ዙቴሬ ዮሀኒስኒን ፉቶሲክ ሀኦኒ ራጁዋ ይሴት ፌሴቴር ስንና ቦርአ ዳራስን ድጌሴቴ <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>የሱስኒክ ዎልግሬ፦ «ኣነ አሪፌንዋ» ይሴቴ። የሱስ ደይ፦ «ታ ደይ አዉኒ ሀእሱኒ ሁግናክ ሀን ባሮን ዛግፋናማቶ ኣፋዋ ንቶክ ማኮና ዉዛ» ይ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ዋይኒን ፎሻስታክ ቡልኛን ሜኒ ቤሶ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማት. 21:33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>ቤሶክ ደይ አሱናክ ካብ፦ «እሳ አሱ ዋይንኒ ሻ ቶኬ፥ ኦጃ ኦጅጀ፥ ጋንባሶን ትኡና ዶአ ዪሸ፥ ቶሎ ኬርእ። ኤስታን ቡልኛን ሜያክ ክራ እማት ዎካ ድማ ሀሚ። <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>ኬጵቶና ዎንባ ካርፋና ካባሲክ ጋንባስታን ኤጴ ዮናክ ዎስትኛስን ቡልኛን ሜያክ ዎሲ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ባሶ ደይ ኤጴ እቸሬ ኩሽኩሽ ጋፉክሴቴ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>ሄፕሳ ኦም ዎስትኛኒን ባሶክ ዎሲ። ኤስ ባሪን ደይ እቼ ቴትባሶን ካርኤሬ ሳልጲስሬ ጋፉክሴቴ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ቱስሬ ኦምንን ዎሲ፤ ኤስ ባሪን ደይ ዎርሴቴ። ኦም ሾዎኒን ዎስኒ እሳ እሳይስን እቸሴቴ ደይ እሳ እሳይስን ዎርሴቴ። <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>ፉእቴ እሳ ኬሽቴፌና ናባስኒ፦ ‹ናታስን ባሶክ ዎሳናነ ኡልፍንሱቤስዋ› እያት ዙታምቤሲሴ አሲ ኦርፎስታ ዎሲ። <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>ስኑንታኖ ኤስ ቡልኛን ሜያ ባሶትና ባሶትና፦ ‹ፎኦሻሶን ቶኒስ ሀን ባርዋ! ያን ዎራት ፎሻሶን እንኖር ዛጉንዋ› ይሴቴ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ኤስታን ኤጴ ዎርሴሬ ዋይኒስ ፎሽን ጌራካሎ ሀእሴቴ። <figure style="fig" alt="Woman with child bringing grapes to wine press" file="LB00106B.tif" size="span" ref="12:8">እሳ አሱ ዋይኒ ትእቴፋና ዶአ ይሼ ሆሲ </figure><verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>«ኤሴ ዋይኒስ ዳም አዉ ዛጉንሪንሶ? ዬሬ ቡልኛን ሜያኖን ዎራት ዋይኒስ ፎሻኖን ኦምን ሜያክ እማናዋ። <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>ኤሴ፦</para>
  <para style="q1" vid="MRK 12:10">« ‹ሹኢን ኬያሶን ኬርእፌ ባሶ ጎነሴቴ ሹኣስ፤</para>
  <para style="q2" vid="MRK 12:10">ሹኢን ኬያስ ካጃታ ዱን ሾልሱ ሹአ ስኒዋ።<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>ኤስ ባርኑ ዳሚስኪንቱ ስኒዋ፤</para>
  <para style="q2" vid="MRK 12:11">ቢፌ እኖክኑ አካማኖን ዲንቂዋ!› »</para>
  <para style="q2" vid="MRK 12:11">ይፋ ትቻሶን ኣነ ፌሬትራ ብየትኖሶ?<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>ማግኒ ጋኛን ሜያ፥ ሙሴኒ ቱማሲ አስሲኛናዋ ኩርኡኒ ሜና ኤስ ማኬና ቤሶስ ባሶስታ ስኒባሶን አሪሴቴ ቦርአ ባሪን ኤጴ ታርአክ ሾልሴቴ። ስኑንታኖ ዳራስን ድግሴፋት ቤየ ሀሜቴ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ግርቦን ቾዋሲክ ማሙስቴ ማምሱ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማት. 22:15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ዎሉምባሲክ ባሪን ኤጳክ እሳ እሳ ፌርሳዊኒ ሜያክናዋ ሄሮድስኒ ኬን ስና ባሶትና የሱስኒክ ዎስሴቴ። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>ባርኪ ዬሴሬ፦ «አስሲኛኖ! ነ ፉእቶኒር ስኒታማቶ አሪፌንዋ። አሱኒ ስና ቢራ ኮሩኖይ ወደይ አሱ አዉ ኡና ኡክ ዛግፋታ ዉዛ ኣፋዋ። ፉቶክ ሀኦሲ ኡግናኖንቱ አሲፋትዋ። ማኮዋ፥ ሮምን ታቴ ሜኒ ታቶስኪ ግርቦን እማ ሾልሱጝዋ ወደይ ሾልሱታንሶ? እማንርጝዋ ወደይ ካላንሪንሶ?» ይት ማሙሴቴ።<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>ስኑንታኖ ባር ስርቤሲሲክ ማጙኖን አራት፦ «አዉኒ ቦርአ ታን ዎላክ ታካሎክ ሾሌፌትሶ? እሳ ሳንትብ ቴሸን ብዩጝዋ» ይ።<verse eid="MRK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16"/>ባሶ ደይ ቴሸሴቴ። የሱስ ደይ፦ «ሀን ግቶሴዋ ትችባሴ ኦንሪንሶ?» ይሬ ማምሲ። ባሶ ደይ፦ «ሮምን ታቴ ሜኒ ታቶሳርዋ» ይሴቴ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱስ ደይ፦ «ኤሴ ታቶሳሮን ታቶስኪ፤ ሀኦሲሮን ሀኦሲክ እምትዋ» ይ። ዎልጉባሲክ ደይ ዲንቀሴቴ።<verse eid="MRK 12:17"/></para>
  <para style="s1">ክቱኒ ካቡኒ ቾዋሲክ ካብ ማምሱ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማት. 22:23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>«ክቱኒ ካቡ ኣፋ» ይሴፌ እሳ እሳ ሴዱቃውን ሜያ ባርኪ ዬሴሬ ኤካ ይት ማሙሴቴ፦ <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>«አስሲኛኖ! ‹እሳ አሱ ናዋ ኮኑኖይ አሱባሶን ሀኣት ክትፋናነ አይባስ ደይ ኤስ አሱሶን ኤጴ ዛልባ ስናናክ አይባሲክ ኮኑዎ› ይሬ ሙሴ እኖክ ትች። <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>ኤሴ ናፉን አይን ሜያ ፌሴቴር። ቴሱኒ ባር አሱ ኤጴ ናዋ ኮኑኖይ ክት። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ሄፕሳስ ደይ ኤጴ ናዋ ኮኑኖይ ክት። ኤሲስማቶ ኬሳስ ደይ ኤካ ስኒ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ናፉኖቤሲሴ አሱሶን ኤጴ ናዋ ኮኑኖይ ክትሴቴ። ዙታምቤሲሴ አሲ ኦርፎታ አሱስ ደይ ክት። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>አሱሶን ናፉኖቤሲሴ ኤጴቴ ስንና ቦርአ ክቱኒ ካቡኒ ዎኖ ባሶስኒ ኦንክ አሱ ስኒሪንሶ?»<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱስ ዎልግሬ ኤካ ይ፦ «ትቻሶናዋ ሀኦሲ ሁግናኖንና ኣነ አሪፌት ስንና ቦርአ ዳጌፌትዋ። <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>ክት ባሶ ክቱኒ ካብሴፌ ካባሲክ ደን ሳማኪ ፋሴ ሀኦሲ ዎስኒማቶቱ ፎሶነታኖ ኤጵነ ግሩነ ኣፋ። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ስኑንታኖ ክቱኒ ሜያ ክቱኒ ካብሶነማቶ ሀኦሲ፦ ‹ታ አብራሀምኒ ሀኦ፥ ይሳቅኒ ሀኦ፥ ያቆብን ሀኦዋ› ይት ኤስ ሳባሲክ ጌያስ ቾዋክ ማኬፋ ድማስታ ሙሴኒክ ማኬና ባሮን ሙሴኒ ትቻስ ኣነ ፌሬትራ ብየትኖሶ? <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>ባር ሀየዉን ሜኒ ሀኦታኖ ክቱኒ ሜኒ ሀኦታዋ። ኤስ ባሪ ቦርኣ ንቶ አካማኖን ዳጌፌትዋ።»<verse eid="MRK 12:27"/></para>
  <para style="s1">ዙታምባሴ አሲስታን ደናሎ ስና አጃጅ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማት. 22:34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ሙሴኒ ቱማሲ አስሲኛሳስኒ እሳይስ ባሶ ካራካሮሶን ኦደ። የሱስ ማአሮን ዎልጉባሶን ጋሳሲፋት ባርኪ ዬሬ፦ «ዙታምባሴ አሲስታን ደናሎ ሾልሱ አጃጂስ ኣፋሪንሶ?» ይሬ ማምሲ።<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱስ ዎልግሬ፦ «አጃጅ ዙታምባሴ አሲስታን ደናሎስ፦ ‹እስራኤልኖ ኦዶዋ! እንኖ ዳማ ሀኦኒስ እሳ ዳማዋ። <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>ነ ደይ ቱማ ንብኔሲክ፥ ቱማ ካኔሲክ፥ ቱማ ሳፋራኔሲክ፥ ቱማ ሁግናኔሲክ ዳማ ሀኦኔሶንጝዋ› ይፋርዋ። <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ሄፕሳ አጃጂስ ደይ ኤካዋ፦ ‹ዎልኮኔስኒ ነ ኔን ሹንፋጝዋ› ኤሲስታን ደናሎ ኦማ አጃጅ ኣፋዋ» ይ።<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ቱማስ አስሲኛ ዎልግሬ፦ «ማአሪዋ፤ አስሲኛኖ! ‹ሀኦሲ እሳርዋ፤ ባርኔን ኦማ ሀኦ ኣፋዋ› ይራ ፉቶክ ዎልግትዋ። <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ቱኡማ ንባክ፥ ቱማ ሳፋራክ፥<note caller="+" style="f"><char style="fr" closed="false">12:33 </char><char style="fqa" closed="false">ቱኡማ ካክ፦ </char><char style="ft" closed="false">ቱኡማ ካክ ይፋ ባር ዜሞቲ እሳ እሳ ግሪክኒ ማፃፋሲታክ ኣፋ።</char></note> ቱማ ሁግናክ ባሮን ሹን። ደይ ዎልኮኔስኒ ቴትኔሶን ሹንፋታስማቶ ሹና ኪቼፋ ማኣስታናዋ ኦማ ኦማ እማስታና ደናሎዋ» ይ።<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>አሱስ አሩክ ዎልግናማቶ የሱስ አራት፦ «ነ ሀኦኒ ታቶስን ዎካ ፋታርታዋ» ይ። ኤሴን ኦርፎ ኦኑ ማምሱን ማምሱክ ኣነ ችሜ።<verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶስኒ ቾዋሲክ ማሙስቴ ማምሱ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማት. 22:41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱስ ቤቴሜቅደሲሲ አሲፌት ኤካ ይ፦ «ሙሴኒ ቱማሲ አስሲኛኒ ሜያ፦ ‹ክርስቶስ ዳዊትኒ ዛላስኒ ኮንቴ ናዋ› ኣካክ ይሴፌሶ? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዊት ቴትባሲክ ኮርቶ አያናክ ዞኑስቴሬ ማኬፌና ካባሲክ፦</para>
  <para style="q1" vid="MRK 12:36">« ‹ዳሚስ ዳምታሲክ ጉማኔሳክቶኒን፤</para>
  <para style="q2" vid="MRK 12:36">ዎቾኔስ ስካሎስ የርአታክ ዛጉና ካባኔን፤</para>
  <para style="q2" vid="MRK 12:36">ኦእታ<note caller="+" style="f"><char style="fr" closed="false">12:36</char><char style="ft" closed="false">10:38 ፋዳስታክ ቢት።</char></note> ቴሽናስታ ዱዋ› ይ።<verse eid="MRK 12:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37"/>«ዳዊት ቴትባሲክ ‹ዳምታ› ኡቱ ይዋ። ኤካኒ ኣካክ ዳዊትኒ ዛላስኒ ኮንቴ ናባ ስንኒሪንሶ?» ሾዎ ዳራስ ደይ ግራክ ኦደሴት ፌሴቴር። <verse eid="MRK 12:37"/><verse number="38" style="v" sid="MRK 12:38"/>የሱስ አሲፌና ካባሲክ ኤካ ይ፦ «ድቻ ድቻ ማያ ማየ ኤክ ሀጝ ኩቱ፥ ጋባስታክ አሱ ናጋ ኦሾናክ ሾልሴፌ ቱማስ አስሲኛኒ ሜያኪን ቴትንትሶን ኦድትዋ። <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ባሶ አይሁድኒ ሺጶኒ ኬያሲክ ቴጋ ኮዳ፥ ኮታ ማስቴፋናስታ ቴጋ ድማቱ ሾልሴፌዋ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ድቻ ቱካማ አሱሲክቶኖን ፋ ዉዝባሶን ኤጴፌ። ደይ ድቻ ሺጶኒ ሺጶክ ቢስቶክዋ እያት ኤስ ኤፋቴና ዉዛ ዛግሴፌ ባሶ አካማ ማጝሱኒ ካርአቱ ኤጴቶሶነዋ።»<verse eid="MRK 12:40"/></para>
  <para style="s1">ቱካማ ድቻ አሱስ እማ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱስ እምቴ እማ ዙቴፋና ሳጥኒስ ስኒታ ዲፌን አሱኒ ሜያ ዋጋ ስር ሀእሴፌን ቢ። ሾዎ ኦቱምኒ ሜያ አካማ ዋጋ እሜት ፌሴቴር። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>እሳ ቱካማ ድቻ አሱ ዋግባስ እሳ ዱደ ስና ሄፕ ጋሮ ጋሮ ናስን ሳንትብ እሚ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>ናዎኒ ሜያኖን ቴጌሬ፦ «ፉቶ ንቶክ ማኬፋውጙዋ፥ ዋግቤሲሶን እማ ባሶ ዙታምቤሲሴ አሲስታን ደናሎ ሀን ቱካማ አሱስ አሪክስራ እምዋ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>ዙታምቤሲሴ ባሶክ ሆሬራ ፉእቴሶንቱ እሜቴዋ። ስኑንታኖ ሀን አሱስ ቱካማ ስኒፋት ባርኪ ፋዪሶን ፉኦኖይ ዙትራ እምዋ» ይ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">ቤቴሜቅደሲሲ ቦክቶናማቶ የሱስ ማኬ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማት. 24:1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱስ ቤቴሜቅደሲሲኒ ኬስፌን ናዎኒ ሜያስን እሳይስ፦ «አስሲኛኖ! ሀን ሹአሲክቶነዋ ሀን ሹን ኬያሲክቶነ አዉነ ፋ ዲንቂ ስንናማቶ ቢዋ» ይት ማኬ። <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>የሱስ ደይ ዎልግሬ፦ «ሀን እኛ እኛ ሹን ኬያሲክቶኖን ቢድፋ ቶሶ? ሀን ሹኣሲክቶ እሳ እሳይስታ ዲራ ፉእቶኒር ኣፋዋ። ዙቴራ ቦክቴርዋ» ይ።<verse eid="MRK 13:2"/></para>
  <para style="s1">ሻናነዋ ካቡግቶነ</para>
  <para style="r">(<ref loc="MAT 24:3-14">ማት. 24:3-14</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>የሱስ ቤቴሜቅደሲሲ ስኒታ ፋ ዳብራዛይትኒ ኩማስታ ዲፌን ጴጥሮስ፥ ያቆብ፥ ዮሀኒስናዋ አንድርያስና ባሶ ባሶ ባርኪ ታእሴሬ፦ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>«ሀን ባር ኣጌንሶ ስናናሪ? ሀን ባር ዙታምባሴ ስኒፋና ካባሲክ ቤሶባስ ኣምባንሶ? እኖክ ማኮዋ» ይሬ ማሙሴቴ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱስ ደይ ኤካ ይ፦ «ኦኑ ንቶትን ኤሽኖይናማቶ ቴትንትሶን ኦድትዋ። <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>ሾዎኒ ሜያ፦ ‹ታ ክርስቶስዋ› ይት ታ ሱናሲክ ዮሶነ። ሾዎኒ ሜያኖን ደይ ኤሾነ። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>ኔቦን ቾዉነዋ ኔቦን ኦዱነ ኦደፌት ካባሲክ ድጎትታዋ። ኤስ ባር ደይ ስናናክ ፋርዋ። ስኑንታኖ ኮእባስ ሀሽታዋ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>ዳራስ ዳራሳታ፤ ታቶስ ታቶስታ ካቡና። ሾዎ ድምታ ደይ ዳኒ ሾርኮነዋ ማክነ ስናና። ኤስ ባር ደይ አካማ ኬክቶኒ ቴሱዋ።<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>«ንቶ ደይ ቴትንትሶን ኦድትዋ። ሾንጎን ኩጳማስታ ንቶ አቴራ እምቶት። አይሁድኒ ሺጶኒ ኬያሲክ እቾሶት። ዛላ ስናትክ ታክዋ እያት ሀእስፌ ባሶ ስናናዋ ታቴ ሜና አሲ ስናና የሮት። <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ኤስ ባር ስኒባስኔን ዜምማ ምስራቹኒ ካማስ ዳራ ዙታምባሴ አሲክ ማክቶናክ ሾልሱዋ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ንቶትን ኤጴ ኣትሬ እሜፌ ካባሲክ፦ ‹አዉታሶ ማኮኒ?› ኡክ ዜምማ ራካቶትታዋ። ስኑንታኖ ኤስ ካባሲክ ንቶክ እምቶኒ ባሮን ማኮት። ማኮኒስ ደይ ኮርቶ አያናታኖ ንቶቴዋ። <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>አዪስ አይባስን፥ አባስ ናባስኒ ክቱክ ኣትሬ እማና። ናንጎታስ ኮኒ አባ እንቶስታ ማጙክ ካብሴራ ዎርሶና። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>አሱ ዙታምባሴ አሲ ስና ታ ሱናስ ቦርአ ኦምቴስቴር ስናት። ስኑንታኖ ኮእባ ካርአናኔን ችሜ የሬ ባር ፋሩና።<verse eid="MRK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>«ደይ<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="fqa" closed="false">ራጁ ዳንኤልኒክ ማክቴ፦ </char><char style="ft" closed="false">እሳ እሳ ዜሞቲ ግሪክኒ ትቻስታ «ራጁ ዳንኤልኒክ ማክቴ» ይፋር ፋር።</char></note> ዝና ዉዛስ ካይማ ድማሶን ኪንፋ ባርኪ ሾልሱኖይ ድማስታ የሬፌኒ ብያትነ [ፌሬትፌ ባር ያዳቶዎዋ]። ኤስ ካባሲክ ዩዳክ ፌሴ ባሶ ኣማሲክ ኤሎቶ። [ዝናስ ኮርቶ ድማስታ የሬፌኒ ቢፌት ካባሲክ ፌሬትፌ ባር ጋሳሱዎዋ] <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ኬያስ ቱክታ ፌ ባር ዳ ኬሬሬ እሳ ዉዛ ኤጳክ ኬር ግሩናታ። <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ፎኦሻስታ ፌ ባር ማይባሶን ኤጳናክ ኦርፎ ዎሉናታ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>ኤስ ካባሲክ ናኔርሴዋ ናዋ ታንፋ አሱሲክቶነ የሬፋዉጝዋ! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ስኑንታኖ ኤስ ዎናስ ዬሹስ ስኖይናማቶ ሺጶት። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>ኤስ ካባሲክ ሀኦ ቴስና ቴስቶስታን ካብራ ሀሽ ሀውጙኔን ካርአ ቢስቶኖር ወደይ ሀንኔንኑ ስኖይ ሻና ስናና። <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ዳሚስ ኤስ ዎናሲክቶኖን ካዉንሱ ሻክ ስንፋናነ አሻ ማዮ አሱ ዙታምባሴ ፉእቶና ካባታዋ። ስኑንታኖ ባር ኮርና አሱኒ ሜኒ ቦርአ ዎናሲክቶኖን ካዉንስ።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>«ኤስ ካባሲክ ኦኑ ስኖ፦ ‹ክርስቶስ ሀንታ ፌርዋ› ወደይ ‹ኤኬስታ ፌርዋ› ይፋናነ አማኖትታ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ኤሽ ክርስቶስኒ ሜናዋ ኤሽ ራጁኒ ሜና ዮሶነር። ኤስ ባሶ ችምቴፋናነ ሀኦ ኮርና ባሶትኑ ዳግሱክ ቤሶነዋ ቢስቴራ አሪቶኖይ ዉዝነ ዛግሶነ። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>ኤሲሲክቱ ታ ዙታምባሴ አሲን ዜምማ ንቶክ ማኬን ስንና ቦርአ ቴትንትሶን ኦድትዋ።<verse eid="MRK 13:23"/></para>
  <para style="s1">ክርስቶስኒ ሄፕሳ ዎል ሌ ዮ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማት. 24:29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>«ኤስ ካባሲክ ኤስ ሻናስኔን ኦርፎ፦ ‹አዋስ ታልሞና፤ አሳስ ደይ ኣፋ ቻሮና ዉዛ። <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/>ባኩራሲክቶ ሳማን ዝግቶሶና፤ ሳማኪ ፋ ሁግናሲክቶ ደይ ሾርኮና› <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>ኤስ ካባሲክ አሱኒ ና አካማ ሁግናክናዋ ኡልፍናክና ሻሩስ ዬፌን ብዮነ። <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>ባር ደይ ሀኦሲ ዎሲያኖን ዎስሬ ዳ ዳስን፥ ዳስ ድልታን ካብራ ዳስ ኮእታ ካርኤ ፌ ባርኪ ኮርቴ አሱኒ ሜያኖን ዙቱና።<verse eid="MRK 13:27"/></para>
  <para style="s1">ቤለስኒ ኢኦስታን አሩት</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማት. 24:32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>«ቤሶሶን ቤለስኒ ኢኦስታን አሩት። ዋኣይባስ ቶሻ ኮታ ቶሽባስ ደይ ቦደፋና ካባሲክ ካዎ ታእሴናማቶ አሪፌትዋ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ኤሲስማቶ ንቶ ኤስ ባር ዙታምባሴ ስኒን ቢፌት ካባሲክ አሱኒ ናኒ ዮ ታእሴራ ፍኛአሲ ካርናማቶ አሩትዋ። <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ፉቶ ንቶክ ማኬፋውጙዋ፦ ኤስ ባር ዙታምባሴ ስኖይፌን ሀን ኮንቶስ ኣፋ ኣታና ዉዛ። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ሳማሴዋ ዳሴ ኣታና። ስኑንታኖ ካምናሲክቶ ኣፋ ኣታና ዉዛ።<verse eid="MRK 13:31"/></para>
  <para style="s1">ዳሚስ ዎል ሌ ዮና ዎናስ ኣነ አሪቴፋ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማት. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>«ስኑንታኖ ኤስ ዎናስ ቾዋኖን ወደይ ኤስ ሳአትስ ቾዋኖን አባስቴኖ ሳማኪ ሀኦሲ ዎስያስ ወደይ ናስ ኣነ አሪፌ። <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>ኤስ ዎናስ ኣጌ ስናናማቶ ኣነ አሪፌት ስንና ቦርአ ጉዝራ ኦድት <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ኤሲስ ደይ ኬባሶን ቤይፋት ኦማ ዳ ሀማ አሱስነ ፋርዋ። ባር ደይ ዎስትኛባሳክቶ ዎስቶሶናክ ዎስቶ ሃኤ እማት ኬያሶን ኦድፌ ባሪን ደይ፦ ‹ጉዝራ ኦድዋ› ይሬ አጃጀ። <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/>ኤስ ባሪ ቦርኣ ኬያስ አባ ኣጌ ዮኒርቶ ኣነ አሪፌት ስንና ቦርአ ቴትንትሶን ኦድት። አዉዛክነ ዋልን ወደይ ዳኒ ኪጤ ወደይ አኮ ኦርፌና ካባሲክ ወደይ ዎኒሳ ዋሲ ስናክ ችማና። <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ዲንቆነ ዬሬ ኩንፌን ዳንኖይናማቶ ጉዙትዋ።<verse eid="MRK 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 13:37"/>«ንቶክ ማኬናሲማቶ ኦምሲክኔን ዙትራ ‹ጉዙት› ይራ ማኬፋውጙዋ።»<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">የሱስኒን ዎሩክ ዛግቴ ሜካማ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማት. 26:1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22:1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሀ. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>አይሁድኒ ፋስካሴዋ ክጣ ማስቴፋና ሄቦሴ ዛግቶናክ ሄፕ ዎና ፉእቴራ ፋር። ማግኒ ጋኛናዋ ሙሴኒ ቱማሲ አስሲኛስና የሱስኒ ኤጴ ዎርሶነ ማጙኒ ኡግና ሾልሴት ፌሴቴር። <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>ስኑንታኖ ባሶ፦ «ዳራስ ፋሶ ካብጉባ፥ ሀን ሄቦስ ኣፋ ዛጉንዉዛ» ይሴቴ።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱስኒን ሽቶ ዎሺ አሱ</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማት. 26:6-13</ref>፤ <ref loc="JHN 12:1-8">ዮሀ. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱስ ብታኒያ ይስቴ ኬኤ ዜሞ አዋታቶኒ ሜታን ስና ስሞን ኬር ዲፌር። ኤስታ ሙን ሙክ ዲፌን እሳ ማሽካሱ ዋግባ አካማ ችማ ሹንቶ ናርዶስኒ ቶሻኪን ዎሱስቴ ሽቶ አልባስትሮስ ይስቴፋ ሹአክ ዎሱስቴ ብልቃድስ ቱማኖን ኤጳ ያ። ብልቃድስ ኡካኖን ሜስራ ሽቶሶን የሱስኒ ቴታስታ ዉክ። <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>ኤስ ስሞን ኬር ዲሴ አሱኒ ሜኒ ጋነያስን እሳ እሳይስ ዛግቴ ባርኪ ግኢቴሴሬ፦ «ሀን ሽቶስ ባክ ዉክቴራ ኬእኖር ስንናስ አዉኒ ቦርአንሶ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>ዋግቴፋናነ እሳ ዎግጋ ዎሱስቴ ዎስቶኒ ብርኔን<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fqa" closed="false">ኦማስታ ኬዝ ትያ ዲናሪ፦ </char><char style="ft" closed="false">ይፋር ፋር</char></note> ደናሎ ዋግቴራ ቱካምኒክ እምቶክ ችምቶና ካባዋ» ይሴሴቴ። አሱሶን ደይ ኬእሴቴ። <figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="span" ref="14:5">አልባስጥሮስኒ ብልቃድ </figure><verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ስኑንታኖ የሱስ፦ «ቤይትዋ! አዉኒሮን ባሮን ራክስድፌትሪንሶ? ባር ታክ ማአ ዉዛ ዛጊዋ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ቱካምኒ ሜያ ዎንና ዎንና ንቶኔን አነቱ ፌሴቴ ስንና ቦርአ ሾሌት ዎኖ አሪጋሱትክ ችማትዋ። ስኑንታኖ ታ ዎንና ዎንና ንቶኔን አነ ኣፋዋ ፎና ዉዛ። <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>ሀን አሱስ ባር ችምናይሶን ታክ ዛጊዋ። አሽናስ ሞግሲ ግሩናክ ሆሱክ ዜምማ ሽቶክ ዎሺ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ታ ፉቶ ንቶክ ማኬፋውጙዋ፤ ሀን ምስራቹኒ ካማስ ዳስ ብራቶታ ዙታምባሴ አሲስታ ማክቴፋና ድማ ኣፋርስታኑ ሀን አሱስ ዛግና ባር ባሮን ሳፋሮንር ስንና ማክቶናዋ።»<verse eid="MRK 14:9"/></para>
  <para style="s1">ዩዳ የሱስኒን ኣትሬ እማክ ሜርኬ</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማት. 26:14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>አሲሬ ሄፔ ናዎሳስን እሳ አስቆሮትኪ ዩዳ የሱስኒን ኣትሬ እማክ ማግኒ ጋኝኜ ሜያክ ሀሚ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ባሶ ደይ ኤስ ባሮን ኦደሴቴይሴ ግርሴቴ። ዋጋ ደይ እሞነክ አብድ እሜቴ። ኤስ ባሪ ቦርኣ ዩዳ ደይ የሱስኒን ኣትሬ እማና ኡግና ሾሌት ፌር።<verse eid="MRK 14:11"/></para>
  <para style="s1">ዳሚሳ ሜታኡ</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማት. 26:17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22:7-14</ref>፥ <ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሀ. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>አይሁድኒ ፋስካኒ ፋንቱ ሹክቴራ ክጣ ማስቴፋና ሄቦስ ቴሱኒ ዎናስታ ናዎኒ ሜያ የሱስኒክ ዬሴሬ፦ «ፋስካ ማስቴፋ ሜታኡሶን ሙታክ አይ ሀማ ሆሱኒክ ሾሌፋሶ?» ይት ማሙሴቴ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱስ ደይ ናዎሳስን ሄፒስኒ ዎስሬ፦ «ኤክ ካታማ ሀሚት። ኤስታክ ደይ አካኒ ግማ ዎርኦ አሱኒን ኡጶት። ባሳ ኦርፎሴ ሀሚት። <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>ባር ሀሜ ግርና ኬያስ ግሪፋት ኬያስ አባንን፦ ‹አስሲኛስ፥ ናዎታስኔን አነ ፋስካኒ ሙሶን ሙና እርባኒ ኬያ አይፋሶ?› ይፌዋ ኡት። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ባር ሴጌነትስታ<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">ሴጌነት ኡስ አይሁድኒ ሜኒ ቱማክ ኬያስ ቱክታ ኬቴ ኬያ</char></note> ሆሬራ ዪቴራ ድ ታጋ ኬያ ንቶክ ቤሱና። ኤስታ ሆሱት» ይ።<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>ኤስ ናዎሳክቶ ካታማስ ሀሜሬ ማኬናሲማቶ ዳነሬ ፋስካኒ ሙሶን ሆስሴቴ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ዋልፋና ካባሲክ የሱስ አሲሬ ሄፔ ናዎባስኔን አነ የ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ዲሴፋ ሜሴፌን፦ «ንቶክ ፉቶ ማኬፋውጙዋ፤ ንቶስኒ እሳይስ ሀን ታኔን ሜፌ ባር ታን ኣትሬ እምንር» ይ።<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>ባሶ ደይ ሱሜሴሬ እሳ እሳርቤሲስ፦ «ታ ስኑጙጋታሶ?» ይሴት የሱስኒን ማሙሴሴቴ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱስ ዎልግሬ፦ «አሲሬ ሄፔሳስኒ እሳይስ ሀን ታኔን አነ ኮራናስ ዱክሬ ሜፌ ባርዋ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>አሱኒ ና ባርኪ ትቼናስማቶ ክቱናክ ፋር። ስኑንታኖ አሱኒ ናኒን ኣትሬ እምን ኤስ አሱስ ሀይቡባዎዋ። ኤስ አሱስ ኮንቶ ሻክ ስንፋናነ ማአሪዋ» ይ።<verse eid="MRK 14:21"/></para>
  <para style="s1">ዳሚሳ ሜታኡን ቱማ</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማት. 26:26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22:14-20</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ሜሴፌን የሱስ ቱሻሶን ኤጴ ሀኦ ጋላቴፋት ባቴ፦ «ኤሴ፥ ሀኒስ አሽናስዋ» ይሬ ናዎሳክቶኒክ እሚ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ቱዎሶን ደይ ኤጴ ሀኦ ጋላቴፋት እሚ። ዙቴሬ ኤስ ቶፎስኒ ኡሸቴ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>ኤካ ደይ ይ፦ «ሀን ባር ሾዎኒ ሜያክ ዉክቶኒ ቴያኒ ሀሪንናስዋ።<verse eid="MRK 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 14:25"/>«ፉቶ ንቶክ ማኬፋውጙዋ፤ ሀኦሲ ታቶኒ ሀኢእሱስ ጋድዶ ዋይኒን ኡሻሶን ኡሻና ካባኔን ሀን ባርስኒ ሄፕስ ኣፋ ኡሻናዉዛ።» <verse eid="MRK 14:25"/><verse number="26" style="v" sid="MRK 14:26"/>ኤሴን ኦርፎ ጋላትን ጋማ ጋሜሬ ኤክ ዳብራዛይትኒ ኩማስታ ኬሴቴ።<verse eid="MRK 14:26"/></para>
  <para style="s1">ጴጥሮስ ሞርሞናማቶ የሱስ ዜምሜ ማኬ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማት. 26:31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22:31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሀ. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱስ ናዎባሳክቶኒክ፦ « ‹ኬሜሪስን እቻ ዎሩና፤ ፋንቱሲክቶ ደይ ሲክቶና› ይስቴራ ትቼና ቦርአ ዙቴራ ሀኣት ኤላትዋ። <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>ስኑንታኖ ታ ክቱኒ ካብናኔን ኦርፎ ኤክ ጋሊላ ዜምማ ሀማና» ይ።<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጴጥሮስ ደይ፦ «ዙታምቤሲሴ ሀኣት ኤለፌክኑ ታ ኣፋ ኤካ ዛጉና ዉዛ» ይ።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱስ ደይ፦ «ፉቶ ኔክ ማኬፋውጙዋ፤ ሀውጙ ሀን ዋላሲክ አኮ ሄፓ ዎል ሌ ኦሩኖይፌን ነ ኬዛ ዎላ ሞርሞታዋ» ይ።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ጴጥሮስ ካምባሶን ችኒሬ፦ «ነኔን አነ ክቱናኑ ስንፋናነ ኣፋ ሞርሞና ዉዛ» ይ። ዙቴሬ ደይ ባሳስማቶ ማክሴቴ።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱስ ጌቴሴማኒ ይስቴፋ ድማስታ ሺጴ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማት. 26:36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ኤሴን ኦርፎ፦ «ጌቴሴማኒ» ይስቴ ድምታ ሀሜቴ። የሱስ ናዎኒ ሜያኖን፦ «ታ ኤኬስታ ሺጶና፤ ንቶ ሀንታ ዲፎትዋ» ይ። <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>ኤስታን ጴጥሮስኒን፥ ያቆብንን፥ ዮሀኒስኒን ባርኔን አነ ዞንስሬ ሀሚ። አካማኖን ሱሜት ናዮ ኤጲ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ናዎባሳክቶኒክ ደይ፦ «ካናስ ክቱናኔን ካርአ አካማኖን ሱሜዋ። ሀንታ ፋፋት ጉዝራ ኦድትዋ» ይ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ጋሮኖን ኤክ ስና ኤክሴሬ ዳስታክ ጋንደሬ ችምቶኒር ስንፋናነ ሻናን ዎናስ ባሳስታን ኣታናማቶ ሺጴ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>ኤካ ደይ ይ፦ «ኣባ አባታሶ! ዙቴራ ኔክ ችምቴርዋ። ሀን ኤጳቶናክ ፋ ሻናሶን ታይስታን ዎክሱ። ስኑንታኖ ታ ሾሌና ባር ስኖይናማቶ ነ ሾሌታ ባር ስኑን» ይ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>ዎል ሌ ዬሬ ኩነፌን ቢ። ጴጥሮስኒን ደይ፦ «ስሞኖ፤ ኩንታሮሶ? እሳ ሳአትነ ጉዝሬ ኦዳክ ኣነ ችሜኖሶ? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ፋታናስ ግሩኖይትማቶ ጉዝራ ሺጶትዋ። አያና ሆሬራቱ ፋ ስኑንታኖ አሻስ ሆፕያዋ» ይ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ኤስታን ዎሌ ደይ ኡኮት ሺጴና ሺጶሶን ሺጴ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>ዎል ሌ ደይ ዬን ኣፌሲስ አፋኢይንክ ፋይና ቦርአ ኩነፌን ቢ። ባርኪ ማክሴፌ ባሮኑ ኣነ አሪሶቶ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ኬሳ ደይ ዬሬ፦ «ሀሽኔን ኩንፌትዮሶ? ሀሽኔን ቤይሳ ኤጵድፌትዮሶ? ኤሴ ሀየ ሆሮናዋ፥ ሳአትስ ካርእ፤ አሱኒ ና ቦርን ሜኒ ኩሹስ አቴሬ እምቶኒር። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ካብን ሀሚን፤ ሀሽ ታን ኣትሬ እምን ባር ታእሴ» ይ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱስኒ ኦቶ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማት. 26:47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22:47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሀ. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>ጌሬጌሬ ኤስ ባሮን ማኬፌና ካባሲክ አሲሬ ሄፔሳስኒ እሳይስ ዩዳ ስኒፌ ባር የ። ባርኔን አነ ስኮነዋ ሙክነ ኤጶ ማግኒ ጋኛንኪን፥ ሙሴኒ ቱማሲ አስሲኛኒኪን፥ ኩርኡኒ ሜያኪን ዎስቴሬ ዬሴ ሾዎ አሱኒ ሜያ ፌሴቴር። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>ኣትሬ እምን ዩዳ ዜምሜ፦ «ታ ዳሞና ባሪንቱ ንቶ ማክራ ኤጳት ኤጳ ሀሚትዋ» ይሬ ቤሶክ ማኬሬ ፌር።<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>ጌሬጌሬ ዬሬ የሱስኒክ ታእሴሬ፦ «አስሲኛኖ!» ይት ዳሜ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ኤስ አነ ዬሴ ባሶ ደይ የሱስኒን ኤጴቴ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ኤስታ የሬ ባሶስኒ እሳይስ ሲፎ ዛምባስን ክስሬ ማግኒ ጋኝኜ ሜኒ ጋኛአሳ ዎስትኛኒ ኦዶኖን ካጨ። <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>የሱስ ደይ፦ «ቦእኛኒን ኤጵንርማቶ ስኮነዋ ሙክነ ኤጳ ታን ኤጳትክ ያትዮሶ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ቤቴሜቅደሲሲ ዎንና ዎንና ንቶኔን አነ ፋፋት አሲፋና ካባሲክ ኣነ ታን ኤጴት። ስኑንታኖ ትቼ ባር ኮኡናክ ሀን ባር ስኒዋ» ይ።<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>ናዎኒ ሜያ ደይ ዙታምቤሲሴ ባሪን ቤይፋት ኤለሴቴ።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>አቱባስታ ዎርአ ማማ ማዮ እሳ ናኦ አሱ ባሳ ኦርፎሴ ሀሜት ፌር። <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>አሱኒ ሜያ ባሪን ኤጴፌ ካባሲክ ማማሶን ሀኣት አታቱባሴ ኤሊ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱስ ሾንጎስታ ታአእ</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማት. 26:57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22:54-55</ref>፥ <ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሀ. 18:13-14</ref>፥ <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>የሱስኒን ማግኒ ጋኝኜ ሜኒ ጋኝኛስክ ኤጴሬ ሀሜቴ። ሙሴኒ ቱማሲ አስሲኛ፥ ኩርኡኒ ሜናዋ ማግኒ ጋኝኜ ሜና ዙቴሬ ኩጲሴቴ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጴጥሮስ ማግኒ ጋኝኜ ሜኒ ጋኛአሳ ኦጅን ኬርካሎ ካርአናኔን ዎክሶክ ኦርፎባሴ ሀሚ። ኤስታክ ደይ ዎስትኛኒ ሜያኔን ዲፋት ጌያ ቤስት ፌር። <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>ማግኒ ሜኒ ጋኝኛስናዋ ሾሴ ዙቴሴሬ የሱስኒን ዎሩክ ዛልንን ሾልሴሬ ኣነ ዳኖቶ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>ሾዎቤሲስ ኤሻ ዛላ ማክሴት ፌሴቴር። ስኑንታኖ ማክሴፌ ዛላስ እሳርባ ፎንቶ ስኒ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>እሳ እሳ አሱኒ ሜያ ካብሴሬ፦ « ‹ታ ሀን ኩሹክ ኬቴ ቤቴሜቅደሲሶን ቦጋት ኬስናር ዎኖ ኦማ ኩሹክ ኬቶኖሮን ኬርአና› ይፌን ኦደኒዋ» ይት ኤሻ ዛላ ማክሴቴ። <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>ስኑንታኖ ሀሽኑ ዛልን ሜኒ ካማስ ኣነ እሳር ስና።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ማግኒ ጋኝኜ ሜኒ ጋኝኛስ ባሶ ጋነያስን ካብሬ የሱስኒን፦ «ሀን ባሶ ነይስታ ማክሴፌ ዛላስ ኣምባንሶ? እሳሮንኑ ዎልጉ ቤይታሮሶ?» ይ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>ስኑንታኖ ባር ሻክ። እሳሮንኑ ኣነ ዎልጉዌ። ሄፕስኑ ማግኒ ጋኝኜ ሜኒ ጋኝኛስ፦ «ሱስቶ ሀኦሲ ና ክርስቶስ ነኖሶ?» ይት ማምሲ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱስ ዎልግሬ፦ «ታዋ፤ አሱኒ ና ሀኦሲ ኦእታ ዲፌናዋ ሳማኪ ሻሩስታ ዬፌና ብያትዋ» ይ። <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>ማግኒ ጋኝኜ ሜኒ ጋኝኛስ ማይባሶን ካራሳት፦ «ሀንኔን ኤካሎ ኦማ ዛላ አዉኒሮን ሾልሱንሪንሶ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ሀኦሶን ሜባሶን ኦደትዋ። ንቶክ አዉ ስንና ቤስቴፋሶ?» ይ። ባሶ ዙቴሴሬ፦ «ክቱ ባርኪ ሾልሱዋ» ይት ማጝሱ ካርኤሴቴ።<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>እሳ እሳይስ ባሳስታ ቱጆ ኤጴቴ። ኣፋሶን ማማክ ኡካት ክኤት፦ «ራጅ እኖክ ማኮዋ» ይሴቴ። ዎስትኛኒ ሜያ ደይ ቦቸት ኤጴ ሀሜቴ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጴጥሮስ የሱስኒን ሞርሜ</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማት. 26:69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22:56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሀ. 18:15-18</ref>፥ <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጴጥሮስ ሃት ኦጅን ኬርካሎ ፌን እሳ ማግኒ ጋኝኜ ሜኒ ጋኛአሳ ኬር ዎስትኛ ያ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ጴጥሮስ ጌያ ቤስፌን ጋሳሲራ ብያት፦ «ነ ደይ ናዝሬትክ የሱስኔን አነ ፋታርዋ» ይ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ስኑንታኖ ባር ዎልግሬ፦ «ነ ማኬፋታ ባሮን ታ ኣነ አሩትዌ። ኣነ ጋሳሱት» ይት ሞርሜ። ጌራካሎ ፍኛ ኬስፌና ካባሲክ አኮ ኦር።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ኬርክ ዎስትኛስ ሄፕሳ ደይ ቢራ ኤስታ የሬ ባሶክ፦ «ሀኒስ ባሶ ኬጝዋ» ይት ማኬ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ባር ደይ ሄፕሳ፦ «ሞርሜ» ጋሮኖን ፌሬ ኤስታ የሬ አሱኒ ሜያ ጴጥሮስኒን፦ «ፉቶክ ነ ጋሊላክ አሱ ስኒታ ቦርአ ባሶ ኬጝዋ» ይሴቴ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ስኑንታኖ ባር፦ «ሀን ማክሴፌት አሱስን ኣነ አሪፋትዋ!» ይት ባሪን ባር ዎልግሬ ኤርውት ቴይ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ጌሬጌሬ ደይ አኮ ሄፕሳ ኦር። ጴጥሮስኒን የሱስ፦ «አኮ ሄፕሳ ዎል ሌ ኦሩኖይፌን ነ ኬዛ ዎላ ሞርሞታዋ» ይና ካማስ ንባስታ ኬጅፋን ሴክቴሬ ዋሲ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱስ ጵላጦስኒ ስና ታእ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማት. 27:1-2</ref>፥ <ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23:1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሀ. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ኤሶ ዎኒሳክ ማግኒ ጋኛን ሜያ ኩርኡኒ ሜያኔን፥ ሙሴኒ ቱማሲ አስሲኛናዋ ሾንጎን ሜና ዙቴሬ እሳሪክ ሜርኬሴቴ። ኤሴን ኦርፎ የሱስኒን ታርኤ ታሜ ጵላጦስኒክ ኣትሬ እሜቴ። <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>ጵላቶስ ደይ፦ «ነ አይሁድኒ ሜኒ ታቶኖሶ?» ይሬ ማምሲ። የሱስ ደይ፦ «ኣ፥ ነ ማኬታስማቶዋ» ይሬ ዎልጊ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ማግኒ ሜኒ ጋኛን ሜያ የሱስኒን ሾዎ ቾዋክ ማላሴት ፌሴቴር። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ጵላጦስ ደይ፦ «እሳሮንነ ኣነ ዎልግፍኖሶ? አፑን ቾዋንሶ ነይስታ ማላሴድፌር» ይሬ ማምሲ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>የሱስ እሳ ዉዛነ ኣነ ዎልጉዌ ስንና ቦርአ ጵላጦስ ዲንቀ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱስኒስታ ክቱኒ ማጝሱኒ ካርአ ካቴ</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማት. 27:15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23:13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሀ. 18:39-40</ref>፤ <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጦስ ፋስካኒ ሄቦ ሄቦሲክ አሱኒ ሜያ ማሙሴቴ እሳ ታቶኒን ኮቴ ጋፍክት ፌር። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ማጙክ ታቶሳታ ካብሴሬ ካኒ ዎሩክ ታቴሬ ፌ አሱኒ ሜያስን እሳ ባርባን ይስቴ አሱ ፌር። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ዳራኒ ሜያ ዬሴሬ፦ «ሀዞዞት ዛግፋታስማቶ እሳ ታቶኒን እኖክ ኮትዋ» ይት ማሙሴቴ። <verse eid="MRK 15:8"/><verse number="9-10" style="v" sid="MRK 15:9-10"/>ጵላጦስ ዎልግሬ ማግኒ ጋኛን ሜያ ኮናክ ኣትሬ እሜቴማቶ አሪና ቦርአ፦ «አይሁድኒ ሜኒ ታቶስን ኮታናክ ሾሌፌትዮሶ?» ይ።<verse eid="MRK 15:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ስኑንታኖ ማግኒ ጋኛን ሜያ የሱስኒን ቤይፋት ባርባንን ኮታናክ ጵላጦስኒን ማሙሶነክ ዳራስን ካቡግሴሴቴ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጦስ ሄፕሳ ዎልግሬ፦ «ኤኪን አይሁድኒ ሜኒ ታቶዋ ይፌት ባሪን አዉ ዛጉናክ ሾሌፌትሶ?» ይ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>ዳራኒ ሜያ ደይ፦ «ሱቶዎዋ!» ይት ቻጌቴ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጦስ ደይ፦ «ኣምሶ? ዛግና ማጝሱ ኣምባንሶ?» ይ። ስኑንታኖ ባሶ፦ «ሱቶዎዋ!» ይት ቻጋ ኣታምሲሴቴ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጦስ ዳራሳ ሳፋራኖን ዛጉክ ሾሌፋት ባርባንን ባሶክ ኮታት የሱስኒን አላንጋክ እቾናክ ዛግሬ ሱቶናክ ኣትሬ እሚ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ታርኦን ሜያ የሱስኒን ካኘሴቴ</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማት. 27:27-31</ref>፤ <ref loc="JHN 19:2-3">ዮሀ. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ታርኦሳክቶ፦ «ፕራቶርዮን» ይስቴፋ ዳ ሀእሲፌ ባሳ ኦጅን ኬርካሎ የሱስኒን ኤጴ ሀሜቴ። ኤስታን ኦም ታርኦን ሜያኖን እሳሪክ ዙትሴቴ። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ሸአ ማያ ማይስሴቴ፤ ደይ ሴርአ ማእሬ ዛዉድ ዛግሬ ቴትባስታ ጉፍስሴቴ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ኤስታን፦ «አይሁድኒ ታቶኖ! ናጋ ኔክ ስንፋውጝዋ!» ይት ናጋ ኦሸሴት ፌሴቴር። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>ቴትባሶን ሶቦቆክ እቸት፥ ቱጀት ባርኪ ካኣነት ሞሴሴቴ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>ካኘሴቴኔን ኦርፎ ሸአ ማያሶን ጋይኣት ባሳ ማያሶን ማይሴሬ ሱቶናክ ኤጴ ሀሜሴቴ።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱስኒ ሱቶ</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማት. 27:32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23:26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሀ. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>እሳ ኡጉንኒ ዎፍ አለክሳንድሮስናዋ ሩፎስና አሲ አባ ስና ስሞን ይስቴ ቀሬናክ አሱ ቤደን ዬፌን ዳነሬ ሜስቀሊሶን ዎርአናክ ግድስሴቴ። <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>ኤስታን የሱስኒን ኤጴ ጎልጎታ ይስቴራ ቴግቴፋ ድማስታ ታሜቴ። ኤስ ጎልጎታ ኡስ ደይ፦ «ቴትን ሜጋን ድማ» ኡ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ኤስታክ ደይ ኩምብኔን ዎእቶ ዋይኒን ኡሻ ኡሻናክ እሜሴቴ። ስኑንታኖ ባር ኣነ ኡሼ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኤስታን ሱቴሴቴ፤ ማይባስታ ደይ እጣ ሀሴሬ ኣኤሴቴ። <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>ኤስ ሱቴሴፌ ካባሲክ ኤእሶ ኬዝ ሳአት። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ማላታስ ትቻ፦ «አይሁድኒ ታቶ» ይፋር። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>ሄፕ ቦእኛኒን ቴሸሴቴ የሱስኔን አነ እሳይስን ኦእታ ቴሽባስታ እሳይስን ደይ ሀልዳ ቴሽባስታ ሱቴሴቴ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ማፃፋሲ፦ «ማጙኒ ሜያኔን ፋድቴዋ» ይና ባር ኮእ።<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="fk" closed="false">ማጙኒ ሜያኔን ፋድቴዋ፦ </char><char style="ft" closed="false">እሳ እሳ ዜሞቲ ግሪክኒ ትቻስ ኣፋ።</char></note> <figure style="fig" alt="fig Myrrh bush, man tapping myrrh, jars, bowl" file="BK00119B.tif" size="span" ref="15:28">ኩምብኒ እኦ</figure><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ቴሽባ ኣትፌ ኡጉንኒ ዎፍን ሜያ ቴትቤሲሶን ሾርክት ኤካ ይት ሜኤት ፌሴቴር፦ «ይ፥ ‹ቤቴሜቅደሲሶን<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="fqa" closed="false">ቤቴሜቅደሲሲ፦ </char><char style="ft" closed="false">ቤቴሜቅደሲሲ ኡስ ስርክ ክድስቴ ክዱሳኒስ</char></note> ቦጋት ኬዝስናር ዎኖ ኬርአናርዋ› ይ ነኖ! <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ኤሴ ሀሽ ሜስቀልስታን ኬሬራ ቴትኔሶን ፉኦዋ!»<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ኤሲስማቶ ማግኒ ጋኛን ሜናዋ ሙሴኒ ቱማሲ አስሲኛስና ባሶትና ባሶትና፦ «ኦሚስን ፉኤ፥ ስኑንታኖ ቴትባሶን ፉኦክ ኣነ ችሜ! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኤሴ ቢራ ባርኪ አማኖኒክ ባር ሙድቶ እስራኤልኒ ታቶስ ሀሽ ሜስቀልስታን ኬሮዎዋ» ይሴት ካኘሴቴ። ባርኔን አነ ሱቴ ቦእኛኒ ሜያ ደይ ባሪን ሜኤት ፌሴቴር።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱስኒ ክቱ</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማት. 27:45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23:44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሀ. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ቶኒ እሱን ሳአትስታን ካብራ እዝግን ሳአት ካርአና ካባኔን ዳስ ዙቴራ ታልማ ስኒ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>እዝግን ሳአትስታ የሱስ፦ «ኤሎሄ፥ ኤሎሄ፥ ላማሴቤቅታኒ» ይሬ አካማ ካማክ ቻጊ። ኮትባስ ደይ፦ «ሀኦናሴ! ሀኦናሴ! አዉኒ ቦርአ ታን ቤይፄ?» ኡ።<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ኤስታ የሬ አሱኒ ሜያስን እሳ እሳይስ ኦደሴሬ፦ «ኦዶትዋ፤ ኤልያስኒንቱ ቴጌድፌዋ» ይሴቴ። <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>እሳር ኤልለ አካ ኤጳክ ችማ ዉዛስ ሀጵቅሬ ሶቦቆታ ዱስሬ ሱትሬ ኡሻናክ የሱስኒክ እማት፦ «ቤይትዋ ሻካኒ ኤልያስ ዬሬ ኬሱንቶ ብያንዋ» ይ።<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>የሱስ አካማ ካማክ ቻጊ፤ ካባስ ደይ ኬስ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ቤቴሜቅደሲሲ<note caller="+" style="f"><char style="fr" closed="false">15:38 </char><char style="ft" closed="false">15:29 ቢት</char></note> ይኑ ደኑን ዳ ሄፕክ ካራቴ። <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>የሱስኒ ስናስታ የሬ ት ሜኒ ጋኝኛስ ካባስ ኬስባሶን ብያት፦ «ሀን አሱስ ፉቶክ ሀኦኒ ናዋ» ይ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>እሳ እሳ ማሽካ ሜያ ደይ ዎክሶክ ብየት ፌሴቴር። ኤስ ባሶስኒ ሜግደላዊትኪ ማራሚ፥ ሳሎሜ፥ ሀቴ ያቆብናዋ ዮሳና አሲ እንቶ ማራሚነ ፌሴቴር። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>ባሶ የሱስ ጋሊላክ ፌና ካባሲክ የሱስኔን አነ ሀሜፋፋ አሪጋስት ፋሴር። ኤሲስማቶ የሱስኔን አነ የሩሳሌም ሀማ ኦማ ሾዎ ማሽካሱ ፋሴር።<verse eid="MRK 15:41"/></para>
  <para style="s1">የሱስኒ ካባርቶ</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማት. 27:57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23:50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>ጌሮክ ዋልፋና ካባሲክ አሪማትያሲክ ዮሴፍ ይስቴ አሱ የ። ዮሴፍ ሾንጎ ኬይሴፌ ባሶስኒ እሳይስ ደይ ኡልፍንቶ አሱ። ባር ደይ ሀኦሲ ታቶኖን አብድክ ኦደት ፌር። ዎናስ ቤይሳኒ ዎናስታን ዜምማ ፋ ሆሱኒ ዎና ስንና ቦርአ ድጎኖይ ፕላቶስኒክ ግሪሬ የሱስኒ ዱግኖሶን እማናክ ማምሲ። <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>ፕላቶስ ደይ፦ «ኣካክ ታእን ክትሶ?» ይት ዲንቀ። ት ታርኦን ሜኒ ጋኝኛስን ቴግስሬ፦ «ፉቶክ የሱስ ክትዮሶ?» ይት ማምሲ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>ት ታርኦን ሜኒ ጋኝኛስኪን ኦደናኔን ኦርፎ ዮሴፍኒክ የሱስኒ ዱግኖሶን እሚ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሴፍ ደይ ክኖን ማማ ዋጌሬ ሜስቀልስታን ዱግኖሶን ኬስሬ ኪምሜ ካቴራ ሆሬ ሹን ሞግሲ<note caller="+" style="f"><char style="fr" closed="false">15:46 </char><char style="fqa" closed="false">ካቴራ ሆሬ ሞጋ፦ </char><char style="ft" closed="false">አይሁድኒ ሜኒ ቱማክ ሞጋ ሹአቱ ካቴራ ሆሬፋር</char></note> ካባሬ። ኤስታን እኛ ሹአ ቡካልስሬ ሞጋስ ኖኖኖን ኡክ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ሜግደላዊትኪ ማራሚነዋ ዮሳን እንቶ ማራሚነ የሱስኒ ዱግኖሶን አይ ካባርሴቴማቶ ብየድፋር።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱስኒ ክቱኒ ካቡ</para>
  <para style="r">(<ref loc="LUK 24:1-12">ሉቃ. 24:1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሀ. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ቤይሳኒ ዎና ኣትናኔን ኦርፎ ሜግደላዊትኪ ማራሚ፥ ሳሎሜ፥ ያቆብን እንቶ ማራሚነ ዬሴሬ የሱስኒ ዱግኖሶን ዎሹክ ሳዋ ዉዛኪን ሆሬ ሽቶ ዋግሴቴ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ቶርባኒስ ቴሱኒ ዎኖ ኤእሶ አዋ ኬስፋና ካባሲክ ሞጋሲክ ሀሜቴ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ባሶትና ባሶትና፦ «ሹኣሶን ሞጋስ ኖኖታን እኖክ ቡካልሱኒሪ ኦንሶ?» ይሴት ፋሴር። <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>ኤስ ባሮን ደይ ይሴቴስ ሹኣስ አካማ እኛ ስንና ቦርአ። ስኑንታኖ ካነ ብየቴን ሹኣስ ቡካለራ ሻቴናማቶ ብየቴ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>ሞጋስ ግርሴቴን ፎሮ ማያ ማዮ ናኦ አሱ ኦእታ ዎሉስታ ዲፌን ቢሬ ናይሴቴ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ኤስ ናኦ አሱስ፦ «ናዮትታ! ሱቴ ናዝሬትክ የሱስኒንቱ ሾሌድፌትማቶ አሪፋዉጝዌ። ባር ካብ፤ ሀንታክ ኣፌ፤ ባሪን ኩኑሴቴ ድማሶን ብዮት። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ኤሴ ሀምፋት ናዎኒ ሜያክናዋ ጴጥሮስኒክና፦ ‹ንቶክ ማኬናሲማቶ ንቶስታን ዜምሜ ጋሊላ ሀሚንር። ኤስታክ ብያት› ይራ ማክሶት» ይ።<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ኤስ ማሽካሱሲክቶ ድጋክ ኮርክሴት ሞጋስኒ ኬሳ ኤለሴ። አካማኖን ድግሴና ቦርአ እሳ ዉዛነ ኦኒክኑ ኣነ ማክሶዋ።<verse eid="MRK 16:8"/></para>
  <para style="s1">የሱስ ናዎኒ ሜያክ ኡጰ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማት. 28:9-10</ref>፤ <ref loc="JHN 20:11-18">ዮሀ. 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>[የሱስ ቶርባኒስ ቴሱኒ ዎኖ ኤሶ ክቱኒ ካብናኔን ኦርፎ ዜምሜ ናፉን ኪና አያና ባርስኒ ክስና ሜግደላዊትኪ ማራሚክ ቤስቴ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>ባር ደይ ሀማ ሱሜትናዋ ዋስትና ፌሴ ባሳ ዞንስኒ ሜያክ ኤስ ባሮን ማኬ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ባሶ ደይ ሀየዉ ስኒባሴዋ ባርኪ ቤስቶባሴ ኦደሴፌ ካባሲክ ኣነ አማንቶሶቶ። <verse eid="MRK 16:11"/><verse number="12" style="v" sid="MRK 16:12"/>ኤሴን ኦርፎ ባሶስኒ ሄፕ ናዎባሳክቶ ቤደ ሀሜፌን የሱስ ኡጉንታክ ኦማ ግቶክ ቤስቴ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ባሶ ደይ ዎል ሌ ሀሜ ኦም ናዎኒ ሜያክ ማክሴቴ። ኤስ ባሶ ደይ ኣነ አማኖሶቶ። <verse eid="MRK 16:13"/><verse number="14" style="v" sid="MRK 16:14"/>ኤሴን ኦርፎ ደይ አሲሬ እሴስ ሙ ሜሴፌን የሱስ ባሶክ ቤስቴሬ፦ «የሱስ ክቱኒ ካብሬ ካክ ፌ፤ እንኖ ደይ ኣፍኒሲክ ቢን» ይሴሬ ማክሴ ባሶትን አማኖ ቤዮቤሲሲክናዋ ንብቤሲስ ችማክና ባሶትን ኬእ። <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/>ቱስሬ ደይ ኤካ ይ፦ «ዳስ ብራቶ ዙታምባሴ አሲስታ ሀሚት። ምስራቹኒ ካማሶን አሱ ዙታምባሴ አሲክ ማኮት። <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አማነሬ ሀጱክቴ ባር ፋሩና። ስኑንታኖ አማኖኖይ ባሳስታ ማጝሱ ካቴር። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>አማነ ባሶ ሀን ቤሶሶን ዛግሶነ፤ ታ ሱናሲክ ኪና አያናሶን ክሱሶነ፤ ጋድዶ ኖኖክ ዎሉምሶነ። <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ዛዋሲክቶኖን ኤጶነ፤ ዎሩን ዉዛኑ ኡሸፋቴነ ባሶትን እሳንነ ኣፋ ሚርኦና ዉዛ። ኩሹቤሲሶን ሜታን ሜኒስታ ታኡሶነ ባሶ ደይ ፋርሶነ።»<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱስ ደን ሳማ ሀሚ</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24:50-53</ref>፤ <ref loc="ACT 1:9-11">ዎስ. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ዳም የሱስ ኤስ ባሮን ናዎኒ ሜያክ ማኬናኔን ኦርፎ ደን ሳማ ሀሚ። ሀኦሲ ሆእታ ቴሽታ ድ። <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>ባሶ ደይ ኬሴሬ ዳ ዳ ዙታምባሴ አሲስ ሀሜፋፌ ማክሴቴ። ዳሚስ ደይ ባሶኔን አነ ዎስቴት ፌር። ቢስቴራ አሪቶኖይ ዉዛን ዛጉክ ማክሴፌ ምስራቹኒ ካማስ ፉቶ ስኒባሶን ቤስት ፌር።]<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">አካማኖን አማንቶ ዜሞቲ ግሪክኒ ትቻሴዋ ኦማ ኦማ ትቻሴ 9-20 ፋ ባሮን ኣነ ዳይስፋ።</char></note><verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
