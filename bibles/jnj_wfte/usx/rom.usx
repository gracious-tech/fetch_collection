<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ROM" style="id">-Yemsa New Testament</book>
  <para style="h">ሮሜ</para>
  <para style="toc1">ዎሲ ጳዉሎስኒ ዎስያ ሮምኪ አሱኒ ሜያክ</para>
  <para style="toc2">ሮሜ</para>
  <para style="toc3">ሮሜ</para>
  <para style="mt2">ዎሲ ጳዉሎስኒ ዎስያ</para>
  <para style="mt1">ሮምኪ አሱኒ ሜያክ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ዎሲ ጳዉሎስኒ ዎስያ ሮምኪ አሱኒ ሜያክ ትቼናስ ጳዉሎስ ሮሙክ ፋ ቤቴክርስታኒሶን ማምሱክ ኮፓኤሬ ፌር ስንና ቦርአ ሆሬሬ ኦዶሶነክ ዛጉክዋ። ጳዉሎስኒ ኮፖስ ሮሙክ ፌሴ አማኝኒ ሜያኔን ጋሮ ዎና ዎስቴናኔን ኦርፎ ባሶ አሪጋሱሲክ እስፐን ሀማናክዋ። ክርስትናኒ አማንቶሲክ ባርክ ጋለ ባሮናዋ ክርስታናኒ ሜያ ካቤሲሲክ ዎስቶታ ፌሹሶነክ ዛግሴፌ ክርስትናኒ አሱሲ ቾዋኖን እሳርባ እሳርባሲክ ትችዋ። ጳዉሎስኒ ዎስያስ ስሩክ ቱማ ፋናስ ሀን ዎስያሲክዋ።</para>
  <para style="ip">ጳዉሎስ ሮሙክ ፌሴ አማኝኒ ሜያክ ናጋባሶን ካትናኔን ኦርፎ ደይ ባሶክ ሺጴት ፌር ስንባሶን አብድ እምናኔን ኦርፎ ዎስባሲ አርክ ሳፋራባሶን (1:17) «ሀኦስኪን ቤስቴፋ ኦኮ ስናስ አማንቶክ፤ አማንቶሲክ ስንባሶን ምስራቹኒ ካማሲ አምማኖን ኬስሳ ፋርዋ» ይፋ ካማስ ስንባሶንቱ ቤስፋ።</para>
  <para style="ip">ኤሴን ኦርፎ ጳዉሎስ ኤስ ሳፋራሶን ታግሬቱ ትች። አይሁድ ስኖቶ አዛብኒ ሜያ ዙቴሬ ቦርኣሲ ሲካሎሲ ሀእሴር ስንነቴ ቦርአ ሀኦሲኔን አነ ጋኖስቱ ሾልስፋርዋ። አሱኒ ሜያ ሀኦሲኔን አነ ጋኖክ ችሞሶኔስ ደይ የሱስ ክርስቶስኒክ አማኖክዋ። ኤስ ባርክ ሀኦሲኔን አነ ካፑቶሶነ ጋድዶ እሳር ስናሲ ጋና ጋድዶ ካ ስንባሶን ጳዉሎስ ታግሬ አሲዋ። አማኚስ ሀኦሲኔን አነ ናጋባ ፎና፤ ሀኦሲ አያናክ ቦርኣስንናዋ ክቱስንና ብርማዱምማ ኬሱና። ኤደባ 5-8 ጳዉሎስ ሀኦሲ ቱማክናዋ አማኝኒ ሜኒ ካሴ አስን ዎስቴት ፋ ሀኦሲ አያናኒ ሁግናነ አሲ አላማስ አዉ ስንናማቶ አምማኖን ቤሱናክዋ። ኤስ ባርስታን ቱስሬ ጳዉሎስ፦ «ሀኦሲ አሱኒ ዛላሲክ ፋ ኮፖባስ አይሁድናዋ ኣዛብና ኣካክ እሳ ድማ ዎሉክ ችሞነሪን?» ይፋ ማምሱሲክ ዎልጉባ እማናክ ካቤድፌት ፌርዋ።</para>
  <para style="ip">ሄፕሳ ደይ ጳዉሎስ አምማኖን ቤስናስማቶ አይሁድ የሱስኒን ኤጴቶሶኖይ ፉእቶቤሲስ ሀኦኒ አላማዋ። ኤስ ባር ደይ ስንናስ የሱስ ክርስቶስኒኪ ካሞ ሀኦሲ አምማኖን ቤስና ፉእቶኒ ኦትማሶን አሱኒ ዛላ ዙታምባሴ ባርሲ ግሩናክ ዛጉክናዋ። ስኑንታኖ አይሁድኒ ሜያ የሱስኒን ኤጴቶሶነ ዎና ዮናማቶቱ ጳዉሎስ አማነፌዋ። ኮእባስታ ጳዉሎስ ክርስትናኒ ካሶን ኣካክ ፎክ ችምቶናማቶ አርክሮን ደይ አማኝኒ ሜያ ባሶትና ባሶትና ፋ ኡጶቤሲሶን ኬሽታኒ ኡግናሲክ ዞኑስቶሶነክ ሾልስፋናማቶቱ ባሶክ አሲ። ሀኦሲክ ዎስቶኒ ቾዋሶን፤ ክርስታናኒ ሜያ ዳቤሲሲ ቾዋኖንናዋ ባሶትና ባሶትና አሲክ ፋ ሃላፊነትሴ ደይ ካኑኒ ቦርአ ካብፋ ማምሱሲክቶኖን እሳርባ እሳርባሲክ ኮቴ አሲዋ።</para>
  <para style="iot">ማፃፋሲ ስር ኤጵና ኤጶባስ</para>
  <para style="io1">ማፃፋሲ ኤጵና ጋናሲ ጋችግሩ <char style="ior"><ref loc="ROM 1:1-17">1:1-17</ref> </char></para>
  <para style="io1">ፋሩ አሱኒ ናንክ ሾልሱ ስኒባስ <char style="ior"><ref loc="ROM 1:18-3:20">1:18—3:20</ref> </char></para>
  <para style="io1">ሀኦሲ ፉኦኒ ኡግና <char style="ior"><ref loc="ROM 3:21-4:25">3:21—4:25</ref> </char></para>
  <para style="io1">ክርስቶስኒኪ ካሞ ቤስቴፋ ጋድዶ ካ <char style="ior"><ref loc="ROM 5:1-8:39">5:1—8:39</ref> </char></para>
  <para style="io1">እስራኤል ሀኦሲ ኮፖስ <char style="ior"><ref loc="ROM 9:1-11:36">9:1—11:36</ref> </char></para>
  <para style="io1">ክርስታናኒ አማላ <char style="ior"><ref loc="ROM 12:1-15:13">12:1—15:13</ref> </char></para>
  <para style="io1">ኮርኡባሴዋ ናጋን ኦሾነ <char style="ior"><ref loc="ROM 15:14-16:27">15:14—16:27</ref> </char></para>
  <chapter number="1" style="c" sid="ROM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1"/>ክርስቶስ የሱስኒ ዎስትኛ ደይ ዎሲ ስናናክ ቴግቴሬ ሀኦሲ ምስራቹኒ ካማኖን ማኮናክ ኮርቴሬ ፌ ጳዉሎስኒኪን ዎስቴ ዎስያ። <verse eid="ROM 1:1"/><verse number="2" style="v" sid="ROM 1:2"/>ኤስ ምስራቹኒ ካማስ ሀኦሲ ራጁኒ ሜያኪ ካሞ ኮርቶ ማፃፋሲክቶሲ ዜምሜ እምና አብድን ካማስዋ። <verse eid="ROM 1:2"/><verse number="3" style="v" sid="ROM 1:3"/>ኤስ ምስራቹኒ ካማስ ሀኦሲ ና አሻክ ዳዊትኒ ዛላስን ኮንቶባሶንቱ ማኬፋ። <verse eid="ROM 1:3"/><verse number="4" style="v" sid="ROM 1:4"/>ኤሲስማቶ ደይ ዳምኒ የሱስ ክርስቶስ ኮርቶ አያናክናዋ አካማ ሁግናክና ክቱን ካቡባሲክ ሀኦኒ ና ስንባስ አርቴ። <verse eid="ROM 1:4"/><verse number="5" style="v" sid="ROM 1:5"/>ክርስቶስኒ ሱናሲክ አዛብኒ ሜያ ዙቴሬ አማኖሶነክናዋ አጃጃሞሶነክና ዛጉክ ባርኪ ካሞ ዎሲ ስንነ ቴግቶኒ ሀኦኒ ኦትማ ዳናኒክዋ። <verse eid="ROM 1:5"/><verse number="6" style="v" sid="ROM 1:6"/>ንቶ ደይ የሱስ ክርስቶስኒር ስናትክ ሀኦሲ ቴጌና አዛብኒ ሜያስን እሳይስዋ። <verse eid="ROM 1:6"/><verse number="7" style="v" sid="ROM 1:7"/>ኤስ ባሪ ቦርኣ ሀኦሲክ ሹንቴሬናዋ ባሪ ኮርቶ ዳራ ስናትክ ቴግቴሬ ፌ ሮማንኪ አሱኒ ሜያክ ዙቴሬ፦</para>
  <para style="p" vid="ROM 1:7">አባን ስና ሀኦስ፤ ዳም የሱስ ክርስቶስኒ ኦትማሴዋ ናጋሴ ንቶክ ስንፋውጝ።<verse eid="ROM 1:7"/></para>
  <para style="s1">ጋላትን ሺጶ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8"/>ንቶ አማንቶሲ ዎላ ሀን ዳስታክ ዙቴራ ኦድቴና ቦርአ ዙታምባሴ አሲስታን ዜምማ የሱስ ክርስቶስኒኪ ካሞ ዙታምኒቲሴ አሲክ ሀኦናሶን ጋላቴፋንዋ። <verse eid="ROM 1:8"/><verse number="9" style="v" sid="ROM 1:9"/>ዎንና ዎንና ሺጴት ፋናማቶ ናሳ ቾዋኖን ማኬፋ ምስራቹኒ ካማሶን ማኮክ ቱማ ንብናሲክ ዎስቴፋና ሀኦሲ ታክ ዛላዋ። <verse eid="ROM 1:9"/><verse number="10" style="v" sid="ROM 1:10"/>ሀሽ ደይ ኮእባስታክ ንቶኪ ዮናክ ሀኦሲ ፍቃድ ስንና ኡጉናስ ካናናክ ዎንና ዎንና ሺጴፋዉጙዋ። <verse eid="ROM 1:10"/><verse number="11" style="v" sid="ROM 1:11"/>አማንቶክ ችምማ ፎትክ ዛጉኒ አያናኒ እማ ንቶክ ሃአናክ ንቶትን ብያናክ ካልቴንዋ። <verse eid="ROM 1:11"/><verse number="12" style="v" sid="ROM 1:12"/>ኤሲስ ደይ ታ ንቶ አማንቶሲክ ንቶ ደይ ታ አማንቶሲክ እኖትና እኖትና ዎል ችማኒክዋ።<verse eid="ROM 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13"/>አይታሳክቶኖ! ኦም አዛብኒ ሜኒ ጋነያሲ ሾዎ አማኝኒ ዳንናይሲማቶ ንቶ ጋነያስን ደይ አማኝኒን ዳናናክ ሾሌት ፋናርዋ። ስኑንታኖ ንቶኪ ዮናክ ሾዎ ዎና ሆሬራ ኬስና ሀሽኔን ካርአ ታክ ስና ቤይናማቶ አሩትክ ሾሌፋንዋ። <verse eid="ROM 1:13"/><verse number="14" style="v" sid="ROM 1:14"/>ግሪክኒ አሱ ስና ባሶትናዋ ግሪክኒ አሱ ስኖይ ባሶትና፥ አሪ ባሶትናዋ አሩኖይ ባሶትና አሲክ ማኮናክ አዳራ ታይስታ ፋርዋ። <verse eid="ROM 1:14"/><verse number="15" style="v" sid="ROM 1:15"/>ኤስ ባሪ ቦርኣ ሮሙክ ፌሴ ንቶክ ምስራቹኒ ካማሶን ማኮናክ አካማኖንቱ ሾሌጝዋ።<verse eid="ROM 1:15"/></para>
  <para style="s1">ምስራቹኒ ካማሲ ሁግና</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16"/>ታ ምስራቹኒ ካማሲክ ኣፋ ኢቾናዉዛ። ምስራቹኒ ካማስ ዜምማ አይሁድኒ ሜያክ ደይ አዛብኒ ሜያክናዋ፤ ኤሲስማቶ ደይ አማነሴፌ ባሶትን ዙትራ ፋቱክ ችምኒ ሀኦኒ ሁግናዋ። <verse eid="ROM 1:16"/><verse number="17" style="v" sid="ROM 1:17"/>ኦኮስ አማንቶክቱ ካ ዳናና ይስቴራ ትቼዋ። ሀኦሲ ኦኮ ደይ ምስራቹኒ ካማሲክ አምማኖን ኬሳ ቤስቴና ቦርአ ቴሱስታን ካብራ ሀምማ ኮእባ ካርአና ካባኔን አሱ ኦኮ ስናናስ አማንቶክዋ።<verse eid="ROM 1:17"/></para>
  <para style="s1">አሱኒ ሜኒ ማጙ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18"/>አሱኒ ሜያ ማጙቤሲሲክ ፉቶስ አርቶኖይናማቶ ዛግሴፌ። ሀኦሶን ድጎ ቤዮቤሲሲክናዋ ማጙቤሲሲ ቦርአና ዙታምቤሲሴ አሲስታ ሀኦኒ ግኢአ ሳማን ዮኒርዋ። <verse eid="ROM 1:18"/><verse number="19" style="v" sid="ROM 1:19"/>ባሶትን ኬኡናስ ሀኦሲ ቾዋኖን አርሶነክ ሾልሲ ባሮን ሀኦስ ባሶክ አምማኖን ቤስን አርሴሬ ፌሴቴር ስንና ቦርአዋ። <verse eid="ROM 1:19"/><verse number="20" style="v" sid="ROM 1:20"/>ሀን ዳስ ቴስቴናኔን ካብራ አሱኒ ሜያክ ቤስቶኖይ ሀኦሲ ሃላ ኮእባ ፎንቶ ሁግናባሴዋ ባር ሀኦ ስንባሴ ቴስና ቴስቶስኪ ካሞ አምማኖን ኬሳ ቤስቴና ቦርአ አሱኒ ሜያ ማጝስሴፌ ማጝሱሲክ ቴቶነ ዉዝቤስ ኣፋዋ። <verse eid="ROM 1:20"/><verse number="21" style="v" sid="ROM 1:21"/>ባሶ ሀኦሶን አርሴሬ ፌሴፌት ባር ሀኦ ስንባሲክ ሾልሱ ኡልፍንነዋ ጋላትነ ባርክ ኣነ እሞሶቶ። ሳፋራቤሲሲክ ኬእኖር ስንነቴ። ያዳቶኖይ ንብቤሲስ ደይ ታልሜ። <verse eid="ROM 1:21"/><verse number="22" style="v" sid="ROM 1:22"/>«ቴቹምኒ ፋር» ይሴፌት ጎዋ ስንነቴ። <verse eid="ROM 1:22"/><verse number="23" style="v" sid="ROM 1:23"/>ኮእባ ፎንቶ ሀኦሶን ኡልፍንሱስታን ኣትኒ ዉዛ ስንና አሱኒ ግቶክ፥ ካሳክ፥ አቼች ዎቾባ ፋና ዋጋክ ወደይ ዳስታ ቦኮቴፋ ቴስቶሲ ግቶክ ዎሱስቴ ሱራሲክ ኡልፍና እሜቴ።<verse eid="ROM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24"/>ኤስ ባሪ ቦርኣ ባሶትና ባሶትና ባሶ አሻስታ ኢቹ ዉዛ ዛግሶነክ ሀኦስ ኪናክ ቱማ ማጙ ኤናንቶቤሲሲክ አጃጃሞሶነክ ኣትራ ባሶትን እሚዋ። <verse eid="ROM 1:24"/><verse number="25" style="v" sid="ROM 1:25"/>ኤስ ባር ደይ ስንናስ ሀኦሲ ፉቶኖን ኤሻክ ሶልሴሬ ቴሲ ባሮን ቤይፋት ቴስቶሶን ሀኦ ዛግሴሬ ሺጵሴቴ ቦርአናዋ ባርክ ደይ ዎስቴሴቴ ቦርአናዋ። ስኑንታኖ ሀኦስ ኮእባ ፎንቶኖን ጋላታምቶዋ። ኣሚን። <verse eid="ROM 1:25"/><verse number="26" style="v" sid="ROM 1:26"/>አሱኒ ሜያ ኤስ ባሮን ዛግሴቴ ቦርአ ሀኦሲ ባሶክ ስኖይ ኢቹ ኤናንቶቤሲሲክ ኣትራ እሚ። ማሽካ አሱቤሲሲክቶ አርቴራ ፋ ኣርቃሱስኔን አነ ኩኑሶን ቤይፋት አርቶኖይ ኡግናክ ሶልሴቴ። <verse eid="ROM 1:26"/><verse number="27" style="v" sid="ROM 1:27"/>ኤሲስማቶ ደይ ኣርቃሱኒ ሜያ አርቴራ ፋ ማሽካሱስኔን ኩኑሶን ቤየ ባሶትና ባሶትና እጋክ ኪቼሴቴ። ኤስ ባሪ ቦርኣ ኣርቃሱኒ ሜያ ኣርቃሱስኔን ኢቹ ዉዛ ዛግሴቴ። ኤስ ማጙ ዎስቶቤሲሲክ ሾልሲ ኬኦ ባሶስታ ካርእን ኤጴቶሶነርዋ።<verse eid="ROM 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28"/>አሱኒ ሜያ ሀኦሶን አሩክ ሾሎ ቤየቴ ቦርአ ኢቹ ዉዛ ዛግሶነክ ሀኦስ ኬእኖይ ካኑክ ባሶትን ኣትራ እሚ። <verse eid="ROM 1:28"/><verse number="29" style="v" sid="ROM 1:29"/>ኤስ ባሪ ቦርኣ ሚርኦክ፥ ማጝሱክ፥ ትታናክ፥ ኑሩክ፥ ኮናክ፥ ካኒ ዎሩክ፥ ፋሶክ፥ ኤሽሹክ፥ ማጙ ሳፋራክኔን ቱምሜ ፌር ስንነቴ። ኤሲስማቶ ደይ ሀማትር ስኖነ። <verse eid="ROM 1:29"/><verse number="30" style="v" sid="ROM 1:30"/>አሱኒ ሱና ማጝስር፤ ሀኦሶን ኦምቴር፤ አሱኒን ኡልፍንሱኖር፤ ቤጋንቶ፤ ታነ ፌ አሱ ኣፌ ይር፤ ማጙ ዉዛ ዎስቶ ሾሌር፤ አባ እንቶቤሲሲክ አጃጃሞኖርዋ። <verse eid="ROM 1:30"/><verse number="31" style="v" sid="ROM 1:31"/>ያዳትቤስ ፎንቶ፤ ዉል ቦኬር፤ ኬሽታምቤስ ፎንቶ ኬና ቡዱዋ። <verse eid="ROM 1:31"/><verse number="32" style="v" sid="ROM 1:32"/>«ኤስ ባሮን ዛግፌ ባሶ ዙቴሬ ክቱሶነክቱ ሾልስፋዋ» ይፋ ሀኦሲ ቱማኖን አሪሴፌት ኤስ ባሮን ዙትሬ ዛግሴፌዋ። ዛጉ ኮእባ ስኖይናሮን ኤሲስማቶ ዛግሴፌ ባሶትን ደይ ችኒሴፌዋ።<verse eid="ROM 1:32"/></para>
  <chapter eid="ROM 1"/>
  <chapter number="2" style="c" sid="ROM 2"/>
  <para style="s1">ሀኦኒ ማጝሱኒ ካርአ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1"/>ኦም አሱኒስታ ማጝሱ ካርፌ ነ ቴትኔሲክ ቴቶታ ዉዝነ ኣፋዋ። ኦም አሱሳታ ማጝሱ ካርፋታ ካባሲክ ቴትኔስታቱ ማጝሱ ካርድፋትዋ። ነ አሱኒስታ ማጝሱ ካርፋት ኤስ አሱስ ዛግፌና ባሮንቱ ነ ደይ ዛግድፋትዋ። <verse eid="ROM 2:1"/><verse number="2" style="v" sid="ROM 2:2"/>ኤስ ባሮን ዛግሴፌ ባሶስታ ሀኦስ ሾልሱ ማጝሱ ካርፋናማቶ አርፌኒዋ። <verse eid="ROM 2:2"/><verse number="3" style="v" sid="ROM 2:3"/>ኤሴ ሀን አሱሶ! ነ ኤካ ዛግሴፌ አሱኒ ሜያስታ ማጝሱ ካርፋት፤ ባሶ ዛግሴፌ ባሮን ዛግፋታ ካባሲክ ሀኦሲ ማጝሱኒ ካርእስን ኣትታ ኬሳታርነ ፋሮሶ? <verse eid="ROM 2:3"/><verse number="4" style="v" sid="ROM 2:4"/>ወደይ ሀኦስ ማአክ ፋክሬ ኦድባሲ ፋክያ ኔክ ኣታሙባሶን ካሽቶሶ? ሀኦሲ ማእባሶን አሪክስናስ ሀርሙታክ ኔን ዞንሱናክ ስንናማቶ ኣነ አሩዌኖሶ? <verse eid="ROM 2:4"/><verse number="5" style="v" sid="ROM 2:5"/>ኤሴ ነ ሀርሙ ቤይኔሲክናዋ ጢቂ ኤጵኔሲክና ደይ ሀኦሲ ግነዋ ፉቶኒ ማጝሱኒ ካርነ ያፋና ዎኖ ነይስታ ካርኒ ኬኦስ አርኩናክቱ ዛግፋትዋ። <verse eid="ROM 2:5"/><verse number="6" style="v" sid="ROM 2:6"/>ሀኦሲ እሳርባ እሳርባሲክ ዎስቶባስማቶ እማናዋ። <verse eid="ROM 2:6"/><verse number="7" style="v" sid="ROM 2:7"/>ማአ ዎስቶሶን ችሜ ዎስቴት ኡልፍና፤ አዳነዋ ኮእባ ፎንቶ ፎነ ሾልሴፌ ባሶክ ኮእባ ፎንቶ ካ እማናዋ። <verse eid="ROM 2:7"/><verse number="8" style="v" sid="ROM 2:8"/>ስኑንታኖ ባሶ ቴታሲክ ኬእኒ ዉዛ ሾልሴፌ ባሶክ፥ ፉቶሲክ አጃጃሞኖይ ማንጙሲክ አጃጃሜ ባሶስታ ሀኦኒ ግእነዋ ሀኦኒ ማጝሱኒ ካርነ ዮና። <verse eid="ROM 2:8"/><verse number="9" style="v" sid="ROM 2:9"/>ማጙ ዉዛ ዛግሴፌ አይሁድኒ ሜያስታ ስኑን አዛብኒ ሜያስታ ሻናነዋ ራኮነ ዮና። <verse eid="ROM 2:9"/><verse number="10" style="v" sid="ROM 2:10"/>ስኑንታኖ ማአ ዉዛ ዎስቴሴፌ ባሶ አይሁድኒ ሜያክ ስኑን አዛብኒ ሜያክ ጋላታ፥ ኡልፍንናዋ ናጋነ እምቶና። <verse eid="ROM 2:10"/><verse number="11" style="v" sid="ROM 2:11"/>ሀኦ አሱኒ ሜኒ ጋነሲ ኣነ ኮሪፋ።<verse eid="ROM 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12"/>ሙሴኒኪ ካሞ እምቴ ቱማቤስ ፎንቶ ቦርአ ዎስቴሴፌ ባሶ ዙቴሬ ሙሴኒኪ ካሞ እምቴ ቱምቤስ ኣፋ ስንፋናክኑ ትሽሴቴርዋ። ስኑንታኖ ቱማቤስ ፌን ቦርአ ዎስቴሴፌ ባሶስታ ኤስ ቱማስማቶ ማጝሱ ካቶናዋ። <verse eid="ROM 2:12"/><verse number="13" style="v" sid="ROM 2:13"/>ኤስ ባሪ ቦርኣ ሀኦሲ ስናክ ኦኮ ስኒስ ቱማሶን ኦዴሬ ዎስቶታ ፌሽፌ ባሶቴኖ ኦዴሬ ዎስቶታ ፌሹኖይ ባሶቴዋ። <verse eid="ROM 2:13"/><verse number="14" style="v" sid="ROM 2:14"/>ሙሴኒኪ ካሞ እምቴ ቱምቤስ ፎንቶ አዛብኒ ሜያ ቴስቶቤሲሲክ ቱማስ አጃጀፋና ባሮንቱ ዛግሴፌ። ኤስ ባሪ ቦርኣ ቱማቤስ ትሽፋናክኑ ንብቤሲስ ፋ ቱማሲክ ዛግሶነክ ሾልስ ባሮን አሪሴቴር። <verse eid="ROM 2:14"/><verse number="15" style="v" sid="ROM 2:15"/>ኤስ ባር ደይ ቤስፋናስ ቱማስ አጃጀፋና ባር ዙቴራ ባሶ ንብባሲ ፋር ስንባሶንዋ። ደይ ካኑቤሲስ ዛላ ማኬርዋ። እሳ እሳ ዎኖ ካኑቤሲስ ባሶትን ዌኤርዋ፤ እሳ እሳ ዎኖ ደይ ኣነ ዌኤፋ። <verse eid="ROM 2:15"/><verse number="16" style="v" sid="ROM 2:16"/>ኤስ ባር ደይ አምማኖን ኬስሳ ቤስቶናስ ሀን ማኬፋና ምስራቹኒ ካማሲክ ሀኦስ ክርስቶስ የሱስኒኪ ካሞ አሱኒ ሜያ ዎስቴሴፌ ኣቾ ዉዛስታ ማጝሱ ካርፋና ዎኖዋ።<verse eid="ROM 2:16"/></para>
  <para style="s1">አይሁድኒ ሜናዋ ቱማቤሲሴ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17"/>ነ ደይ፦ «ታ አይሁድዋ» እያት ቱማሲክ ቴቴፋት። ሀኦሲር ስኔሲክ ደይ ጌእፋትዋ። <verse eid="ROM 2:17"/><verse number="18" style="v" sid="ROM 2:18"/>ነ ሀኦሲ ፍቃድኖን አሪታር። ቱማሶን ደይ አሪታር ስንና ቦርአ ማአሮን ዛጉሶን አርታርዋ። <verse eid="ROM 2:18"/><verse number="19" style="v" sid="ROM 2:19"/>ታ፦ «ኣፍትሹኒ ሜያኖን ዞንስናር፤ ታልማሲ ፌ ባሶክ ደይ ቻሬፍዋ። <verse eid="ROM 2:19"/><verse number="20" style="v" sid="ROM 2:20"/>አሩኖይ ባሶክ ሌጅ እምናር፤ ዳጋ ናንጎታሶን አስሲናርዋ» ይፋት። ኤሲስማቶ ደይ፦ «ቱማሲ አሩክናዋ ፉቶክና ቱምማ ፋናርዋ» ይፋት። <verse eid="ROM 2:20"/><verse number="21" style="v" sid="ROM 2:21"/>ኤካ ኦሚስን አስፋት ነ ቴታሶን አዉኒ ቦርአ አስሱ ቤይትሶ? ነ፦ «ዊሶትታ» ይፋት ዊሴፋቶሶ? <verse eid="ROM 2:21"/><verse number="22" style="v" sid="ROM 2:22"/>ነ፦ «ጌርኬሳትታ» ይፋት ጌርኬስፋቶሶ? ነ ኮእሎሶን ኦምቴፋት ቤቴሜቅደሲሶን ቦኤፋቶሶ? <verse eid="ROM 2:22"/><verse number="23" style="v" sid="ROM 2:23"/>ነ ሀኦሲ ቱማኖን አሩክ ጌኢት፤ ስኑንታኖ ባር ቱማሶን ቦኮክ ሀኦሲክ ኡልፍና ኣነ እምፌ። <verse eid="ROM 2:23"/><verse number="24" style="v" sid="ROM 2:24"/>ኤሲስ ደይ፦ «ንቶ አይሁድኒ ሜኒ ቦርአ ሀኦሲ ሱና አዛብኒ ስናክ ሜቸፋ» ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25"/>ሃርኮኒ ኩናስ ዋግባ ፎናስ ቱማሶን ዛግታር ስንፋናነዋ። ስኑንታኖ ቱማሶን ቦኬታር ስንፋናነ ሃርኮ ኩንኔስ ሃርኮ ኩኖይታር ስንናቱ ፋድቶናዋ። <verse eid="ROM 2:25"/><verse number="26" style="v" sid="ROM 2:26"/>ኤስ ባሪ ቦርኣ ሃርኮ ኩኖይ አዛብኒ ሜኒ ኬንሲ ቱማሲ አጃጅኖን ዛጊር ስንፋናነ ሃርኮ ኩኑ ቤይባስ ሃርኮ ኩኒ ስንናታኖሶ ፋድቶናሪ? <verse eid="ROM 2:26"/><verse number="27" style="v" sid="ROM 2:27"/>ነ ትቼራ ፋ፤ ቱማነ ፌን ደይ ሃርኮ ኩናር ስንፋት ቱማሶን ቦኬር ስንፋታነ አሻክ ሃርኮ ኩኖይ ስንፋት ቱማሶን ዛግፌ አዛብኒ ሜኒ ኬኒስ ነይስታ ማጝሱ ካርእኤቴርዋ። <verse eid="ROM 2:27"/><verse number="28" style="v" sid="ROM 2:28"/>ኤሴ ሱናክ አይሁድ ስና ባር ፉቶኒ አይሁድቴዋ። ኤሲስማቶ ጌሮክ ቢስቴፋ አሽኒ ሃርኮኒ ኩኑስ ፉቶኒ ሃርኮኒ ኩኑታዋ። <verse eid="ROM 2:28"/><verse number="29" style="v" sid="ROM 2:29"/>ፉቶኒ አይሁድ ስካሎባሲክ አይሁድ ስና ባርዋ። ፉቶኒ ሃርኮኒ ኩኑስ ሀኦኒ አያናክ ስንፋ ንብኒ ሃርኮኒ ኩኑታኖ ቱማሲ ትቼናስማቶ አሽኒ ሃርኮኒ ኩኑስታዋ። ኤስ ኤፌቴና አሱስ ደይ ጋላታ ኤጴቴፌናስ ሀኦስኪንታኖ አሱኒኪንታዋ።<verse eid="ROM 2:29"/></para>
  <chapter eid="ROM 2"/>
  <chapter number="3" style="c" sid="ROM 3"/>
  <para style="s1">አይሁድኒ ሜኒ አማኖ ቤያ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1"/>ኤኪን አይሁድ ስናስ አዉ ኬእንሪንሶ? ሃርኮኒ ኩኑስ ዋግባ ኣምባንሶ? <verse eid="ROM 3:1"/><verse number="2" style="v" sid="ROM 3:2"/>ፉቶሲክ አይሁድ ስና ሾዎ ኡግናክ ኬአርዋ፤ አሪክ ቾዋስ ሀኦሲ ካምባሶን አይሁድኒ ሜያክ አዳራ እምባስዋ። <verse eid="ROM 3:2"/><verse number="3" style="v" sid="ROM 3:3"/>ኤኪን አይሁድኒ ሜያስን እሳ እሳ ሜያ አማንቶቤስ ፎንቶ ስንነፋቴነ ባሶ አማኖ ቤያስ ሀኦሲ አማናምቶኖን ዋግባ ቱሩክሱንሮሶ? <verse eid="ROM 3:3"/><verse number="4" style="v" sid="ROM 3:4"/>እሳንነ ኣፋ ቱሩክሱና ዉዛ!</para>
  <para style="q1" vid="ROM 3:4">«ካምኔስታን ካቢ ቾዋ ነ ፉቶ ስናታዋ፤</para>
  <para style="q2" vid="ROM 3:4">ጉማኔስን ደይ ማላቴራ ዳዎታዋ።»</para>
  <para style="m" vid="ROM 3:4">ይስቴራ ትቼናስማቶ አሱ ዙቴሬ ኤሽኛ ስንፌናክኑ ሀኦስ ፉቶ ስኑንዋ።<verse eid="ROM 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5"/>ስኑንታኖ እንኖ ማጝሱስ ሀኦሲ ኦኮኖን ቤሱኒር ስንፋናነ አዉ ኡንሪንሶ? ሀኦስ እንኖ ማጝሱሲ ቦርአ እኖትን ኬእፋናነ ባር ፉቶኒ ማጝሱ ኣነ ካርፋ ኡኖሶ? ሀን ባሮን ማኬፋናስ አሱኒ ሳፋራንማቶዋ። <verse eid="ROM 3:5"/><verse number="6" style="v" sid="ROM 3:6"/>እሳንነ ኤካታዋ፤ ኤካ ስንፋናነ ሀኦስ ኣካክ ሀን ዳስታ ማጝሱ ካርኒሪንሶ?<verse eid="ROM 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7"/>ስኑንታኖ ታ ኤሽኛ ስናስ ሀኦሲ ፉቶኖን አምማኖን ቤስራ ኡልፍንባሲ አሪኩኖን ቤሱኒር ስንፋናነ ኤኪን ታ ቦርእኛኒማቶ አዉኒ ቦርአ ታይስታ ማጝሱ ካቶኒሪንሶ? <verse eid="ROM 3:7"/><verse number="8" style="v" sid="ROM 3:8"/>እሳ እሳ አሱኒ ሜያ፦ «ማአ ዉዛ ዳናኒክ ማጙ ዉዛ ዛጉኒዋ» ይራ አስሲናርነ ፋሮን ዛግሬቱ ታን ማላቴሴፌዋ። ኤስ ባሪ ቦርኣ ኤስ ኤፌቴና አሱኒ ሜያስታ ካቶኒ ማጝሱስ ልኪዋ።<verse eid="ROM 3:8"/></para>
  <para style="s1">አሱ ዙቴሬ ቦርባ ፋርዋ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9"/>ኤኪን እንኖ አይሁዲስ አዛብኒ ሜያስታን ደናሎ ስንኒ ኡኖሶ? እሳንነ እንዳነዋ። አሱኒ ሜያ ዙቴሬ አይሁድ ስኖቶ ኣዛብ ስንነፌክኑ ቦርእቤስ ፋናር ስንነቴማቶቱ ዜምማ ንቶክ አስጝዋ። <verse eid="ROM 3:9"/><verse number="10" style="v" sid="ROM 3:10"/>ማፃፋሲ፦</para>
  <para style="q1" vid="ROM 3:10">«እሳ ኦኮ አሱኑ ኣፌ፤ እሳርንኑ ኣፌዋ።<verse eid="ROM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11"/>ያዳትባ ፌናር ኦኑ ኣፌ፤</para>
  <para style="q2" vid="ROM 3:11">ሀኦሶን ሾሌፌር እሳርንኑ ኣፌ።<verse eid="ROM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12"/>ዙታምቤሲሴ ኡግናስታን ሻቴሴቴ።</para>
  <para style="q2" vid="ROM 3:12">እሳሪክ ኬእኖር ስንነቴ፤</para>
  <para style="q2" vid="ROM 3:12">ማአሮን ዛግፌር ኦኑ ኣፌ፤ እሳርንኑ ኣፌ።<verse eid="ROM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13"/>አሱኒ ሚርኦኒ ማጙ ካማ ማኮክ፤</para>
  <para style="q2" vid="ROM 3:13">ኖኖቤሲስ ጋቼራ ኩኒ ሞጋነ ፋርዋ፤</para>
  <para style="q2" vid="ROM 3:13">ቴሩምቤሲሲክቱ ኤሽሴፌዋ፤</para>
  <para style="q2" vid="ROM 3:13">ቴሩምቤሲስ ዎላ ደይ ዛዉኒ ኬዋንማቶ አሱኒ ሚርእኤርዋ።<verse eid="ROM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14"/>ኖኖቤሲስ ኤርውያክናዋ ሱቃሮክና ቱማ ፋር።<verse eid="ROM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15"/>ዎቾቤሲስ አሱኒን ዎሩክ ታፕቴር።<verse eid="ROM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16"/>ኡጉቤሲስታ ትሹነዋ ሻንቱነ ፋርዋ።<verse eid="ROM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17"/>ናጋኒ ኡግናሶን ኣነ አርሴፌ።<verse eid="ROM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18"/>ሀኦሶን ኣነ ድግሴፌ»</para>
  <para style="m" vid="ROM 3:18">ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19"/>ሙሴኒ ቱማሲ አጃጅ ማኬፋናስ ቱማስ ዳካሎ ፌሴ ባሶትን ስንናማቶ አሪፌንዋ። ኤስ ባሪ ቦርኣ አሱኒ ሜያ ኤጴ ማክሶነ ዉዛ ትሽና ቦርአቱ ሻክሴፌዋ። ዳ ዙታምባሴ ሀኦሲ ማጝሱኒ ካርእኒ ስካሎሲቱ ፋዋ። <verse eid="ROM 3:19"/><verse number="20" style="v" sid="ROM 3:20"/>ኤስ ባሪ ቦርኣ ኦኑ ሀኦሲ ስና ቱማሶን ዛጉክ ኣፋ ኦኮ ስናናዉዛ። ቱማስኪ ካሞቱ ቦርኣስ አርቴፋዋ።<verse eid="ROM 3:20"/></para>
  <para style="s1">ኦኮ ስናስ አማንቶክዋ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21"/>ስኑንታኖ ሀሽ ሀኦስ አሱኒ ሜያኖን ኦኮ ዛጉና ኡግናስ ቱማስ ሾልሱኖይናሮን አምማኖን ኬስሳ ቤስቴዋ። ኤሲስ ደይ ሙሴኒ ቱማሲናዋ ራጁኒ ሜያክና ዛላ ማክቴዋ። <verse eid="ROM 3:21"/><verse number="22" style="v" sid="ROM 3:22"/>ኤስ ባሪ ቦርኣ ሀኦስ እሳ ኮሩባ ፎንቶኖን የሱስ ክርስቶስኒክ አማነፌ ባሶ ዙቴሬ ኦኮ ስኖነክ ዛጊዋ። <verse eid="ROM 3:22"/><verse number="23" style="v" sid="ROM 3:23"/>አሱኒ ሜያ ዙቴሬ ቦርአ ዎስቴሴቴ፤ ሀኦሲ ኡልፍና ደይ ባሶስታን ዮእ። <verse eid="ROM 3:23"/><verse number="24" style="v" sid="ROM 3:24"/>ኤስ ባሪ ቦርኣ አሱኒ ሜያ ዙቴሬ ክርስቶስ የሱስ ዛግና ፉሪሲኪ ካሞ ሀኦሲ ኦትማክቱ ባክ ኦኮ ስኖነዋ። <verse eid="ROM 3:24"/><verse number="25-26" style="v" sid="ROM 3:25-26"/>ሀኦስ የሱስ ክርስቶስኒን ማእአ ዛግራ እምናስ ባርክ አማነፌ ባሶ ዙቴሬ ሀርንባሲክ ቦርእቤሲስ ፋክያኖን ዳኖነክዋ። ሀኦስ ኤስ ባሮን ዛግናስ ፋኪባሲክ ዜሞቲ ዛግቴ ቦርኣሶን ኬኡኖይ ቤይናስ ባሪ ፉቶኒ ማጝሱኒ ካርኣሶን አምማኖን ኪሲራ ቤሱናክዋ። ሀን ነያሲክ ደይ ሀኦ ቴትባሲክ ኦኮ ስንባሶን ቤስናስ የሱስ ክርስቶስኒክ አማነፌ ባሶትን ዙትራ ኦኮ ዛጉባሲክዋ። <verse eid="ROM 3:25-26"/><verse number="27" style="v" sid="ROM 3:27"/>ኤኪን ቴቶኒ ዉዝኒ ፋሮሶ? እሳ ዉዛክኑ ቴቶኒክ ኣፋዋ ችማኒዉዛ። ቴቶ ቤያኒስ አዉኒ ቦርአንሶ? ሙሴኒ ቱማሶን ዛግፌኒ ቦርአኖሶ? እንዳነዋ። ስኑንታኖ አማንቶሲክዋ። <verse eid="ROM 3:27"/><verse number="28" style="v" sid="ROM 3:28"/>ኤስ ባሪ ቦርኣ ሀኦስ አሱ ኦኮ ስናናክ ዛግፋናስ ባሪ ቱማስ አጃጅኖን ዛግና ቦርአ ስኖይናሮን አማንቶክ ስንባሶንቱ ያዳቴፌንዋ። <verse eid="ROM 3:28"/><verse number="29" style="v" sid="ROM 3:29"/>ወደይ ሀኦስ አይሁድኒ ሜኒር ኮእባኖሶ? አዛብኒ ሜያክ ደይ ሀኦታኖሶ? ፉቶሲክ አዛብኒ ሜያክ ደይ ሀኦዋ። <verse eid="ROM 3:29"/><verse number="30" style="v" sid="ROM 3:30"/>ሀኦስ እሳርዋ፤ አይሁድኒ ሜያኖን ስኑን አዛብኒ ሜያኖን አማንቶሲክ ኦኮ ዛጉኒስ ደይ ባርዋ። <verse eid="ROM 3:30"/><verse number="31" style="v" sid="ROM 3:31"/>ኤኪን አማንቶኒ ቦርአ ቱማሶን ሻሮኒር ኡኖሶ? እንዳነዋ፤ ማእሲራ ዛግራቱ ኦዳንዋ።<verse eid="ROM 3:31"/></para>
  <chapter eid="ROM 3"/>
  <chapter number="4" style="c" sid="ROM 4"/>
  <para style="s1">አብራሀም አማንቶክ ኦኮ ስኒ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1"/>ኤሴ አሻክ አባን ስና አብራሀም ዳኒዋ ኡኒ ዉዛ ኣምባንሶ? <verse eid="ROM 4:1"/><verse number="2" style="v" sid="ROM 4:2"/>አብራሀም ኦኮ ስንናስ ዎስቶክ ስኒ ስንፋናነ ቴቶና ዉዛ ዳናና ካባዋ። ስኑንታኖ ሀኦሲ ስና ቴቶክ ኣፋ ችማናዉዛ። <verse eid="ROM 4:2"/><verse number="3" style="v" sid="ROM 4:3"/>ኮርቶ ማፃፋሲ፦ «አብራሀም ሀኦሶን አማንቴ፥ አማንቶባስ ደይ ኦኮ ስንና ፋድቴ» ይፋታኖሶ? <verse eid="ROM 4:3"/><verse number="4" style="v" sid="ROM 4:4"/>ዎስቶ ዎስቴፌ አሱ ባርክ ሾልሱ ዎስቶኒ ዋጋሶንቱ ዳኒቴኖ ባክ እምቴ እማታዋ። <verse eid="ROM 4:4"/><verse number="5" style="v" sid="ROM 4:5"/>ዎስቶክ ዳናናዋ ኡኖይ ቦእርኒ ሜያኖን ኦኮ ዛግፋ ሀኦሲክ አማነፋናነ አማንቶባስ ኦኮ ስንናቱ ፋድቶናዋ። <verse eid="ROM 4:5"/><verse number="6" style="v" sid="ROM 4:6"/>ዳዊት ቴትባሲክ ሀኦሲ ዎስቶ ፎንቶኖን ኦኮ ዛግራ ፋድና አሱስ አዉነ ፋሮን ሱስቶ ስንባሶን ቤሱክ፦<verse eid="ROM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7"/>«ማጝሱቤሲስ ‹ፌሹን› ይስቴና ባሶናዋ፤</para>
  <para style="q2" vid="ROM 4:7">ቦርቤሲስ ትሽክቴና አሱኒ ሜና ሱስቶዋ።<verse eid="ROM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8"/>ዳሚስ ቦርባሶን ፋዱኖይና አሱ ሱስቶዋ» ይ።<verse eid="ROM 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9"/>ኤኪን ዳዊት ማኬና ኤስ ሱስቶስ ሃርኮ ኩነ ባሶክ ኮእባጝዋ ወደይ ሃርኮ ኩንኖይ ባሶክኔኒንሶ? ሃርኮ ኩንኖይ ባሶክኔጝዋ። አብራሀም ሀኦሲክ አማነና ቦርአ አማንቶባስ ደይ ኦኮ ስንና ፋድቴዋ ይንዋ።<verse eid="ROM 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 4:10"/>ኤኪን አብራሀም አማንቶባስ ኦኮ ስንና ፋድቴናስ ኣጌንሶ? ሃርኮ ኩንኖይፌንጝዋ ወደይ ሃርኮ ኩንፋኒንሶ? ሃርኮ ኩንኖይፌንታኖ ሃርኮ ኩናኔንታዋ። <verse eid="ROM 4:10"/><verse number="11" style="v" sid="ROM 4:11"/>አብራሀም ዜምሜ ሃርኮ ኩንኖይፌን አማንቶባስ ኦኮ ስንና ፋድቴናማቶ አሩና ማላቶ ስናናክቱ ሃርኮ ኩኒዋ። ኤስ ባሪ ቦርኣ አብራሀም ሃርኮ ኩንኖይ አማኖኒ ባሶክናዋ አማንቶቤሲስ ኦኮ ስንና ፋድቶና ባሶ ዙታምቤሲሴ አሲክና አባዋ። <verse eid="ROM 4:11"/><verse number="12" style="v" sid="ROM 4:12"/>ኤሲስማቶ አብራሀም ሃርኮ ኩነ ባሶክ ደይ አባዋ። ሃርኮ ኩነ ባሶክ አባ ስንናስ ደይ ሃርኮ ኩነቴ ቦርአ ኮእባ ስንኖይናሮን ባር ሃርኮ ኩንፌና ካባሲክ ፋ አማንቶባሲክ ዞኑስቴሴፌ ባሶክዋ።<verse eid="ROM 4:12"/></para>
  <para style="s1">አማንቶሲክ እምቴ አብድ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13"/>አብራሀምኒክናዋ ባሳ ዛላሲክና ሀን ዳሶን ዋራሶናክ ሀኦስ አብድ እምናስ አማንቶክ ዳና ኦኮሲክታኖ ቱማሶን ዛግና ቦርአታዋ። <verse eid="ROM 4:13"/><verse number="14" style="v" sid="ROM 4:14"/>አብዲሶን ዋራሶኒስ ቱማሶን ዛግ ባስሶ ስንነፋቴነ አማንቶስ ዋግባ ኣፋ ፎና ዉዛ። አብዲስ ደይ ዋግባ ፎንቶቱ ስናናዋ። <verse eid="ROM 4:14"/><verse number="15" style="v" sid="ROM 4:15"/>ቱማስ ሀኦኒ ግእአቱ ኤጳ ያፋ። ስኑንታኖ ቱማ ትሽፋናነ ቱማሶን ዛጉኖይ ኣትቴ ኬሳ ኣፋ ፎና ዉዛ።<verse eid="ROM 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16"/>ኤስ ባሪ ቦርኣ አብዲ የሬናስ አማንቶስታዋ። ኤስ አብዲስ ደይ አብራሀምኒ ዛላ ዙትራ ሀኦሲ ኦትማክ እምቴር ስንባስ ኤስ ባርክ አርቴዋ። ኤሲስ ደይ ቱማሲክ ዞኑስቴፌ አሱኒ ሜያክ ኮእባ ስንኖይናሮን አብራሀምኒስማቶ አማነ ባሶ ዙታምቤሲሴ አሲክዋ። ኤስ ባሪክ አብራሀም እንኖ ዙታምኒሴ አሲክ አባዋ። <verse eid="ROM 4:16"/><verse number="17" style="v" sid="ROM 4:17"/>አብራሀምኒ ቾዋሲክ፦ «ኔን ሾዎ አሱኒ ዛላክ አባ ዛግንዋ» ይስቴራ ትቼዋ። ኤስ አብዲስ አብራሀምኒክ እምቴናስ ክት አሱኒ ሜያኖን ክቱኒ ካብግፋ ሀኦስክናዋ ፎንቶሶን ፋር ዛግፋ ሀኦሲክና አማነና ቦርአዋ። <verse eid="ROM 4:17"/><verse number="18" style="v" sid="ROM 4:18"/>አብራሀም ዛልኔስ አካማኖን ሾዎና ይስቴራ ማክቴናስማቶ ሾዎ አሱኒ ዛላክ አባ ስናናክ አብድክ አማነናስ እሳ አብድ ዛጉክ ችምቶኖይና ዉዛሶጝዋ። <verse eid="ROM 4:18"/><verse number="19" style="v" sid="ROM 4:19"/>አብራሀም ዎጋባስ ትያ ካርአ ፋር ስንና ቦርአ አሽባሲክ ሆፕሬ ክቱነ ፌር ስንነ ፌር። ኮኑክ ደይ ኣፋ ችማናዉዛ ስንናማቶናዋ አሱባ ሳራ ደይ ኣፋ ኮኑና ዉዛ ስንናማቶና አሪፌናክኑ አማንቶባሲክ ኣነ ሆፑዌ። <verse eid="ROM 4:19"/><verse number="20" style="v" sid="ROM 4:20"/>አማንቶባሲክ ዛግ ስንነቱ ሀኦሲክ ኡልፍና እሚቴኖ ሀኦስ እምና አብዲሲክ እሳንነ ኤክ ሀጝ ኣነ ኡዌ። <verse eid="ROM 4:20"/><verse number="21" style="v" sid="ROM 4:21"/>ሀኦስ ባር እምና አብዲሶን ዛጉኒር ስንናማቶ ቱማ ንባክ አማነሬ ፌር። <verse eid="ROM 4:21"/><verse number="22" style="v" sid="ROM 4:22"/>ኤስ ባሪ ቦርኣቱ አብራሀምኒ አማንቶስ ኦኮ ስንና ፋድቴዋ። <verse eid="ROM 4:22"/><verse number="23" style="v" sid="ROM 4:23"/>ስኑንታኖ «ኦኮ ስንነ ፋድቴ» ይስቴራ ትቼ ካማስ ትቼናስ አብራሀምኒክ ኮእባ ስኖይናሮን፤ <verse eid="ROM 4:23"/><verse number="24" style="v" sid="ROM 4:24"/>እኖክኔንጝዋ፤ ዳም የሱስኒን ክቱን ካብግ ሀኦሲክ አማነፌ እኖክ ደይ አማንቶኒስ ኦኮ ስንናቱ ፋድቶናዋ። <verse eid="ROM 4:24"/><verse number="25" style="v" sid="ROM 4:25"/>ኤስ ዳም የሱስ እንኖ ቦርኣሲክ ክቱክ አቴሬ እምቴሬ እኖትን ደይ ኦኮ ዛጉክ ክቱን ካቢስ ባርዋ።<verse eid="ROM 4:25"/></para>
  <chapter eid="ROM 4"/>
  <chapter number="5" style="c" sid="ROM 5"/>
  <para style="s1">አማንቶክ ቤስቴፋ ናጋነዋ ጋኖነ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1"/>ኤሴ እንኖ ኦኮ ስናሶን ዳንኒስ አማንቶክ ስንና ቦርአ ዳምኒ የሱስ ክርስቶስኒኪ ካሞ ሀኦሲኔን አነ ናጋኒ ፋርዋ። <verse eid="ROM 5:1"/><verse number="2" style="v" sid="ROM 5:2"/>ሀን አማንቶክ ዛግራ ፋኒ ሀኦሲ ኦትማሲ ግሪኒስ ባርክ ስንና ቦርአ አብድክ ሀኦሲ ኡልፍናኖን ሃእኤር ስንኒሲክ ቴቴፌንዋ። <verse eid="ROM 5:2"/><verse number="3" style="v" sid="ROM 5:3"/>ኤስ ባር ባር ስኖይናሮን ሻናሲን ችማ ቤስቴር ስንናማቶ አርኒ ቦርአ ኤጳ ታፌኒ ሻናሲክ ደይ ቴቴፌንዋ። <verse eid="ROM 5:3"/><verse number="4" style="v" sid="ROM 5:4"/>ፋክያሲክ ፋታናሶን ችምማ፤ ችማስን ደይ አብድ ቤስቴፋዋ። <verse eid="ROM 5:4"/><verse number="5" style="v" sid="ROM 5:5"/>እኖክ እምቴ ኮርቶ አያናሲኪ ካሞ ሀኦሲ ኬሽታና ንብኒሲ ቱምና ቦርአ እኖክ እምቴ አብዲስ ኣፋ ኢሹና ዉዛ።<verse eid="ROM 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6"/>እንኖ ሆፕ ስንና ፋኒ ሀኦሲ ዎና ካርፋና ካባሲክ ክርስቶስ ቦርእኒ ሜያክ ክትዋ። <verse eid="ROM 5:6"/><verse number="7" style="v" sid="ROM 5:7"/>ኦኮኒ ኤድደ ክቱኒ አሱኒን ዳና አካማኖን ራኮዋ፤ ስንፋናክኑ ማአ አሱኒ ኤድደ ክቱክ ችምኒ አሱ አዉዛክነ ቤስቶናክ ችማናዋ። <verse eid="ROM 5:7"/><verse number="8" style="v" sid="ROM 5:8"/>ስኑንታኖ እንኖ ቦርእባሬ የሬ አሱ ስንና ፋኒ ክርስቶስ እንኖ ኤዴስ ክትዋ። ኤስ ባር ደይ ሀኦስ እኖትን ኬሽቴና ኬሽታምባስ አዉነ ፋ አካማ ስንናማቶቱ ቤስፋዋ። <verse eid="ROM 5:8"/><verse number="9" style="v" sid="ROM 5:9"/>ኤሴ እንኖ ኦኮ ስንኒስ የሱስ ክርስቶስኒ ሀንናሲክ ስንፋናነ ደይ ዳይስራ ሀኦሲ ግእስን ፉእቶክ ችማኒስ ደይ ባርኪ ካሞዋ። <verse eid="ROM 5:9"/><verse number="10" style="v" sid="ROM 5:10"/>እንኖ ሀኦሲ ጉማ ስንና ፋኒ ባሪ ናሳ ክቱክ ባርኔን አነ ጋነኒዋ። ሀሽ ሀኦሲኔን አነ ጋነንኔን ኦርፎ ደይ ዳይስራ ባሳ ካሲኪ ካሞ ፋሩኒዋ። <verse eid="ROM 5:10"/><verse number="11" style="v" sid="ROM 5:11"/>ኤስ ባር ኮእባ ስኖይናሮን፤ ሀኦሲኔን አነ ጋኖሶን ዳንኒስ የሱስ ክርስቶስኒኪ ካሞ ሀኦሲክ ቴቶኒዋ።<verse eid="ROM 5:11"/></para>
  <para style="s1">ክቱ አዳምኒኪ ካሞ ካስ ደይ ክርስቶስ የሱስኒኪ ካሞ ሲኒ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12"/>እሳ አሱኒኪ ካሞ ሀን ዳስታ ቦርአ ያ። ኤስ ቦርኣሲኪ ካሞ ደይ ክቱ ያ። ኤሲስማቶ ደይ አሱ ዙቴሬ ዎስቴና ቦርእባሲክ ክቱ አሱ ዙታምባሴ አሲስታ ያ። <verse eid="ROM 5:12"/><verse number="13" style="v" sid="ROM 5:13"/>ሙሴኒ ቱማስ እምቶኖይፌን ዜምማ ቦርአ ሀን ዳስታክ ፋርዋ። ስኑንታኖ ቱማስ ትሽፋናነ ቦርኣስ ቦርአነ ፋር ስንና ኣነ ፋድቴፋ። <verse eid="ROM 5:13"/><verse number="14" style="v" sid="ROM 5:14"/>ስኑንታኖ አዳምኒስማቶ ቱማሶን ኣታክ ቦርአ ዎስቶኖይ አሱኒ ሜያኖኑ ፉኦኖይናሮን ክቱ አዳምኒስታን ካብራ ሙሴኒኪ ካርአ አሱ ዙታምባሴ አሲስታ ሀእሱኒ ሁግናባ ዳኒዋ። ኤስ አዳም ሀኔንት ዮኒ ክርስቶስኒክ ቤሶዋ። <verse eid="ROM 5:14"/><verse number="15" style="v" sid="ROM 5:15"/>ስኑንታኖ ሀኦሲ ኦትማኒ እማስ አሱሳ ቦርእኒማቶታዋ። እሳ አሱኒ ቦርኣሲክ ሾዎኒ ሜያ ክትሴቴማቶ ደይ ሀኦሲ ኦትማክናዋ እሳ የሱስ ክርስቶስኒኪ ካሞ ቤስቴ ሀኦሲ እማክ ሾዎኒ ሜያክ ዳይስቴራ እምቴዋ። <verse eid="ROM 5:15"/><verse number="16" style="v" sid="ROM 5:16"/>ኤሲስማቶ ባክ ሀኦስ እምና ባሪ እማስ ቴሸና ኦትማስ ጋና እሳ አሱሳ ቦርአ ኤጳ ያና ጋናስነ ፋርታዋ። እሳ አሱሳ ቦርአክ እምቴ ማጝሱኒ ካርኣስ ኬኦቱ ኤጳ ያዋ። ሾዎ ቦርኣሲክ ባክ እምቴ እማስ ኦኮ ኤጳ ያ። <verse eid="ROM 5:16"/><verse number="17" style="v" sid="ROM 5:17"/>እሳ አሱሳ ቦርኣሲክ ክቱ አሱ ዙታምባሴ አሲሳታ ሀእሱኒ ሁግና ዳንናኔን ቱማ ፉእቴ ሀኦሲ እማኖን ኤጴ ኦኮ ስነ ባሶ ዙቴሬ እሳ አሱ ስና የሱስ ክርስቶስኒኪ ካሞ ሜሬሬ ካክ ታትቶሶነዋ። <verse eid="ROM 5:17"/><verse number="18" style="v" sid="ROM 5:18"/>ኤሴ እሳ አዳምኒ ቦርኣስ ኬኦኒ ማጝሱኒ ካርአ አሱ ዙታምባሴ አሲስታ ኤጳ ያናማቶ እሳ ክርስቶስኒ ኦኮ ዎስቶስ ሾዎኒ ሜያኖን ኬኦስን ብርማዱምማ ክስራ ካ እማናዋ። <verse eid="ROM 5:18"/><verse number="19" style="v" sid="ROM 5:19"/>እሳ አሱ ስና አዳምኒ አጃጃምቶ ቤያሲክ ሾዎኒ ሜያ ቦርቤሲ ፋናር ስንነቴማቶ እሳ አሱ ስና ክርስቶስኒ አጃጃምቶሲክ ሾዎኒ ሜያ ኦኮ ስኖነዋ። <verse eid="ROM 5:19"/><verse number="20" style="v" sid="ROM 5:20"/>ቦርአ አሪኩናክቱ ቱማሴ ያዋ። ስኑንታኖ ቦርኣስ አርክናማቶ ሀኦሲ ኦትማ ደይ አካማኖን አርክዋ። <verse eid="ROM 5:20"/><verse number="21" style="v" sid="ROM 5:21"/>ኤስ ባር ደይ ስንናስ ቦርኣስ ክቱስኪ ካሞ አሱ ዙታምባሴ አሲስታ ታቴናማቶ ዳምኒ የሱስ ክርስቶስኒኪ ካሞ ኮእባ ፎንቶ ካ ቤስቶናክ ሀኦሲ ኦትማ ኦኮሶን እማናክ ታቶናዋ።<verse eid="ROM 5:21"/></para>
  <chapter eid="ROM 5"/>
  <chapter number="6" style="c" sid="ROM 6"/>
  <para style="s1">ክርስቶስኔን አነ ክትሬ ባርኔን አነ ካክ ፎ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1"/>ኤካ አዉ ኡንስሶ? ሀኦሲ ኦትማ አርኩናክ ቦርአ ዎስቴት ፎንሮሶ? <verse eid="ROM 6:1"/><verse number="2" style="v" sid="ROM 6:2"/>እንዳነዋ፤ እንኖ ቦርኣሲክ ክትኒ፤ ኤኪን ኣካክ ቦርአ ዎስቴት ፎንሪንሶ? <verse eid="ROM 6:2"/><verse number="3" style="v" sid="ROM 6:3"/>ክርስቶስ የሱስኔን አነ እሳር ስናክ ሀጱክቴ እንኖ ዙቴራ ባር ክትናሲማቶ ክቱባሶን ቤሱክ ሀጱክቶኒሶን ኣነ አሩዌትኖሶ? <verse eid="ROM 6:3"/><verse number="4" style="v" sid="ROM 6:4"/>ሀጱክቶክ ባርኔን አነ ካባርቴፌኒ ካባሲክ ባሳ ክቱሶን ቤስኒዋ። ኤስ ባሪ ቦርኣ ክርስቶስ አባሳ ኡልፍናክ ክቱኒ ካብናማቶ እንኖ ደይ ጋድዶ ካክ ፎኒዋ።<verse eid="ROM 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5"/>ክቱባሲክ ኤካክ ባርኔን አነ እሳር ስኒኔን ኤሲስማቶ ክቱን ካቡባሲክ ደይ ባርኔን አነ እሳር ስናኒዋ። <verse eid="ROM 6:5"/><verse number="6" style="v" sid="ROM 6:6"/>እኖስታ ሁግና ዳና ቦርኣስ ትሹናክናዋ ቦርኣሲ ቦዝ ስንነ ፎኒስ ፌሻናክና ኩርኡ ቴስቶኒስ ክርስቶስኔን አነ ሱቴናማቶ አርፌኒዋ። <verse eid="ROM 6:6"/><verse number="7" style="v" sid="ROM 6:7"/>ክት አሱ ቦርኣሲ ሀእሱኒ ስካሎስን ብርማዱምማ ኬስዋ። <verse eid="ROM 6:7"/><verse number="8" style="v" sid="ROM 6:8"/>ኤሲስማቶ ክርስቶስኔን አነ ክትፋንነ ባርኔን አነ ደይ ካክ ፎኒማቶ አምነፌኒዋ። <verse eid="ROM 6:8"/><verse number="9" style="v" sid="ROM 6:9"/>ክርስቶስ ክቱን ካቡባሲክ ሄፕሳ ኣፋ ክቱና ዉዛ ስንናማቶናዋ ክቱስ ደይ ባሳስታ ሀእሱኒ ሁግናባ ኣፋ ስንናማቶና አርፌኒዋ። <verse eid="ROM 6:9"/><verse number="10" style="v" sid="ROM 6:10"/>ባር ክትፌና ካባሲክ ቦርአ ባሳስታ ሀእሱኒ ሁግናባ ፎኖይናማቶ ሄፕሳ ደይ ዎሉኖይናማቶ ዛግሬ እሳርጋ ክትዋ። ሀሽኑ ካክ ፌና ፎባስ ሀኦሲክዋ። <verse eid="ROM 6:10"/><verse number="11" style="v" sid="ROM 6:11"/>ኤሴ ንቶ ክት አሱነ ፋሮን ቦርኣስኒ ኦር ኬሴትማቶናዋ ክርስቶስ የሱስኒኪ ካሞ ደይ ሀኦሲክ ካክ ፋትማቶና ፋዱት።<verse eid="ROM 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12"/>ኤሴ ቦርኣስ ክቱኒ አቱንትስታ ሀእሱኒ ሁግናባ ፎናክናዋ አሽኒ ኤናንቶሲክና አጃጃሜር ስና ንቶትን ዛጉናክ ማእ ኡትታዋ። <verse eid="ROM 6:12"/><verse number="13" style="v" sid="ROM 6:13"/>ኤሲስማቶ አቱንትሲ ብልትኖን ማጙ ዉዛ ዎስቶኒ ኮዳ ዛግራ ቦርኣሲክ አጃጃሞናክ ዛጉትታዋ። ስኑንታኖ ክቱን ካብራ ሀየዉ ስንነትማቶ ዛግራ ቴትንትሶን ሀኦሲክ እምትዋ። አቱንትሲ ብልትኖን ዙትራ ኦኮ ስና ዉዛሶን ዎስቶኒ ኮዳ ዛግራ ሀኦሲክ አጃጃሞናክ ዛጉትዋ። <verse eid="ROM 6:13"/><verse number="14" style="v" sid="ROM 6:14"/>ሀሽ ንቶ ፋሴቲ ፎስ ሀኦሲ ኦቱማኒ ስካሎስታኖ ቱማሲ ዳካሎሲ ስና ቤይና ቦርአ ቦርኣስ ንቶትን ሀእሱናክ ኣነ ሾልስፋዋ።<verse eid="ROM 6:14"/></para>
  <para style="s1">ኦኮ ስና ዉዛሲክ ቦዝ ስና</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15"/>ኤካ አዉ ኡንሪንሶ? ሙሴኒ ቱማሲ ስካሎስ ስንኒስ ፌሽፋን ሀኦሲ ኦቱማኒ ስካሎሲ ስንኒ ቦርአ ቦርኣሶን ዎስቶኒ ኡኖሶ? እሳንነ እንዳነዋ! <verse eid="ROM 6:15"/><verse number="16" style="v" sid="ROM 6:16"/>እሳ አሱኒክ ቦዝባ ስንፋት አጃጃሞክ ቴትንትሶን እምፌቲ ካባሲክ ኤስ አጃጃሜፌቲ አሱሲክ ባሳ ቦዝ ስንትሶን አርሴፌትዋ። ኤሲስማቶ ቦርኣሲክ አጃጃሜፋትነ ክቱ ንቶስታ ኤጳ ዮኒ ቦርኣሲክ ቦዝባይቱ ስናትዋ። ስኑንታኖ ሀኦሲክ አጃጃሜፋትነ ኦኮ ስና ዉዛሶን ዳናትዋ። <verse eid="ROM 6:16"/><verse number="17" style="v" sid="ROM 6:17"/>ንቶ ዜሞ ስናክ ቦርኣሲ ቦዝ ስንናቱ ፋሴትዋ። ስኑንታኖ ሀሽ ኤጳ ታት አሩሶን ንብንትሲ ካሞ አጃጃሞንትሲክ ሀኦሲክ ጋላታ ስንፋውጝዋ። <verse eid="ROM 6:17"/><verse number="18" style="v" sid="ROM 6:18"/>ቦርኣሲክ ቦዝ ስናስን ብርማዱማ ኬሳ ኦኮ ስና ዉዛሲ ቦዝ ስነትዋ። <verse eid="ROM 6:18"/><verse number="19" style="v" sid="ROM 6:19"/>ታ ሀን ኤካ አሱኒክ ጋሎ ስንና ኖኖክ ማኬፋናስ ንቶ ሳፋራሲ ሆፕታን ካብ ቾዋክዋ። ዜሞ ስናክ አቱንትሲ ብልት ዙቴራ ኪንነዋ ማጙነ አሲ ቦዛ ዛግራ እሜሴትማቶ ሀሽ ደይ አቱንትሲ ብልትኖን ዙትራ ኮርቶ ስናናክ ኦኮሲ ቦዛ ዛግራ እምትዋ።<verse eid="ROM 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20"/>ቦርእኒ ቦዝ ስንና ፋቲ ካባሲክ ኦኮ ስና ዉዛሶን ዛጉትክ ግድንቲ ኣፋዋ። <verse eid="ROM 6:20"/><verse number="21" style="v" sid="ROM 6:21"/>ኤኪን ኤስ ካባሲክ አሮ ኬኒን ዉዛ ዳንቲሶ? ሀሽ ንቶትን ኢቹኒ ዉዛታኖ እሳ ኬእኒ ዉዛ ኣነ ዳነትዋ። ኤስ ባር ኮእኣስ ደይ ክቱዋ። <verse eid="ROM 6:21"/><verse number="22" style="v" sid="ROM 6:22"/>ስኑንታኖ ሀሽ ቦርኣሲክ ቦዝ ስናስን ብርማዱማ ኬሳ ሀኦሲ ቦዝ ስንትሲክ ዳናቲ ቡኣስ ኮርቶ ስናዋ። ኤስ ኮርቶ ስናሲ ኮአ ደይ ኮእባ ፎንቶ ካስዋ። <verse eid="ROM 6:22"/><verse number="23" style="v" sid="ROM 6:23"/>ቦርኣሲ ዎስቶስን ቤስቶኒ ዋጋስ ክቱዋ። ስኑንታኖ ሀኦስኪን እምቶኒ እማስ ዳምኒ ክርስቶስ የሱስኒኪ ካሞ ኮእባ ፎንቶ ካስዋ።<verse eid="ROM 6:23"/></para>
  <chapter eid="ROM 6"/>
  <chapter number="7" style="c" sid="ROM 7"/>
  <para style="s1">ቱማስን ብርማዱምማ ኬሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1"/>አይታሳክቶኖ! ሀን ባሮን ኣነ አሩዌትኖሶ? ማኬፋናስ ቱማሶን አሪፌ አሱኒ ሜያክዋ። ቱማስ አሱኒስታ ሀእሱኒ ሁግናባ ፎናስ አሱ ካክ ፌፌና ካባሲክ ኮእባዋ። <verse eid="ROM 7:1"/><verse number="2" style="v" sid="ROM 7:2"/>እሳ ቤሶ ንቶክ ማኮናዋ፤ ግርራ ድ አሱ ቴጎባስ ካክ ፌና ካባሲክ ባርኔን አነ ቱማሲክ ታቴራ ዲርዋ። ስኑንታኖ ቴጎባስ ክትፋናነ ኤስ ታቴና ቱማስን ብርማዱምማ ኬስዋ። <verse eid="ROM 7:2"/><verse number="3" style="v" sid="ROM 7:3"/>ኤስ ባሪ ቦርኣ ቴጎባስ ካክ ፌን ኦምኒኪ ግሪፋናነ ሶሌዋ ይስቴፋዋ። ስኑንታኖ ቴጎባስ ክትፋናነ ባርኔን አነ ታቴና ቱማስን ብርማዱምማ ኬሲ ስንና ቦርአ ኦም አሱኒኪ ግሪፋናነ ሶሌ ኣፋ ኡስቶና ዉዛ። <verse eid="ROM 7:3"/><verse number="4" style="v" sid="ROM 7:4"/>አይታሳክቶኖ! ንቶ ቾዋስ ደይ ኤሲስማቶዋ። ንቶ ክርስቶስኒ አቱኒ ብልት ስንነቲ ቦርአ ክቱክ ኦር ኬሳስነ ፋሮን ቱማስን ኦር ኬስትዋ። ኤስ ባሪ ቦርኣ ሀኦሲክ ዎስቶክ ጋና ጋናትክ ክቱን ካብ ክርስቶስኒ ኬን ስንነትዋ። <verse eid="ROM 7:4"/><verse number="5" style="v" sid="ROM 7:5"/>አሽኒ ፍቃዲሲክ ፋኒ ካባሲክ ቱማስ ካብግፋና ማጙ ኤናንቶሲክ ክቱኒ ጋና ጋናኒክ አቱኒሲ ብልትሲ ዎስቴት ፋርዋ። <verse eid="ROM 7:5"/><verse number="6" style="v" sid="ROM 7:6"/>ስኑንታኖ ሀሽ እኖትን ታርእአ ፋ ቱማስን ክትራ ኦር ኬስኒ ቦርአ ቱማስ ታቶስን ብርማዱምማ ኬስኒዋ። ኤስ ባሪ ቦርኣ ሀንኔን ኤካሎ እንኖሲ ዎስቶኒስ ጋድዶ ስና ኮርቶ አያናሲ ኡግናክታኖ ዜምማቲ ትቼ ኩርኡ ቱማሲ ኡግናክታዋ።<verse eid="ROM 7:6"/></para>
  <para style="s1">ቱማሴዋ ቦርኣሴ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7"/>ኤሴ አዉ ኡንሪንሶ? ቱማስ ቴትባሲክ ቦርአኖሶ? እሳንነ እንዳነዋ፤ ስኑንታኖ ቦርአ አዉ ስንናማቶ አሩናክ ዛግስ ቱማስዋ። ቱማስ «ኤናንቶታታዋ» ኡ ሻኪ ስንፋናነ ኤናንቶስ አዉ ስንናማቶ አሩና ካባታዋ። <verse eid="ROM 7:7"/><verse number="8" style="v" sid="ROM 7:8"/>ቦርኣስ ቱማስኪን ያ አጃጂሲክ ኡግና ዳና ኤናንቶ ታይሲ ፎናክ ዛጊዋ። ስኑንታኖ ቱማስ ትሽፋናነ ቦርኣስ ክቱ ዉዛዋ። <verse eid="ROM 7:8"/><verse number="9" style="v" sid="ROM 7:9"/>ዜምማ ቱማስ እምቶኖይፌን ታ ሀየዉ ስንናቱ ፋፋዉጝዋ። ስኑንታኖ ቱማሲ አጃጅ ያናኔን ኦርፎ ታ ክትፋና ቦርኣሲ ካ ዳንኒዋ። <verse eid="ROM 7:9"/><verse number="10" style="v" sid="ROM 7:10"/>ካ፤ እማናክ እምቴ ቱማሲ አጃጅ ታይስታ ክቱ ኤጳ ያዋ። <verse eid="ROM 7:10"/><verse number="11" style="v" sid="ROM 7:11"/>ቦርኣስ ቱማሲ አጃጂስኪ ካሞ ኡግና ዳና ታን ኤሽዋ። አጃጂስኪ ካሞ ደይ ታን ዎሪዋ።<verse eid="ROM 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12"/>ቱማስ ኮርቶዋ፤ አጃጂስ ደይ ኮርቶዋ፥ ደይ ፉቶነዋ ማአረነዋ። <verse eid="ROM 7:12"/><verse number="13" style="v" sid="ROM 7:13"/>ኤኪን ሀን ማአር ስና ዉዛስ ታይስታ ክቱ ኤጳ ያ ኡኖሶ? እንዳነዋ! ስኑንታኖ ቦርኣስ ቦርአ ስንና አምማኖን ቤስቶናክ ማአ ዉዛስኪ ካሞ ክቱ ታይስታ ኤጳ ያዋ። ኤሲሲክ ቦርኣሲ አጃጂኪ ካሞ ቦርኣስ አዉነ ፋ ማጙ ስንናማቶ አሪርቴዋ።<verse eid="ROM 7:13"/></para>
  <para style="s1">አሱኒ ካሲ ፋ ካቦ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14"/>ቱማስ ሀኦስኪን ያር ስንናማቶ አሪፌንዋ። ስኑንታኖ ታ ቦርኣሲክ ቦዝ ስናናክ ኬሴ ዋግቴ አሻ ማዮ አሱዋ። <verse eid="ROM 7:14"/><verse number="15" style="v" sid="ROM 7:15"/>ታ ዛግፋና ባሮን ኣነ አሪፋትዋ። ሹንፋና ዉዛሶን ዛጉ ሻካቱ ኦምቴፋና ዉዛሶን ዛግጝዋ። <verse eid="ROM 7:15"/><verse number="16" style="v" sid="ROM 7:16"/>ኤሴ ታ ዛግፋናስ ዛጉክ ሾሎኖይና ዉዛሶን ስንናኔን ቱማሲ ማአር ስንባሶን አምማኖን ማኮናዋ። <verse eid="ROM 7:16"/><verse number="17" style="v" sid="ROM 7:17"/>ዛጉክ ሾሎኖይና ዉዛሶን ዛግፋስ ታይሲ ፋ ቦርኣስታኖ ታቴዋ። <verse eid="ROM 7:17"/><verse number="18" style="v" sid="ROM 7:18"/>ታይሲ ወደይ አሽናሲ ፋ ሃላስ እሳንነ ማአ ዉዛ ኣፋ ስንናማቶ አሪፋኒዋ። ማአ ዉዝኒ ዛጉክ ሾሌፋናክኑ ኤስ ማአ ዉዛሶን ዛጉክ ኣነ ችምፋትዋ። <verse eid="ROM 7:18"/><verse number="19" style="v" sid="ROM 7:19"/>ዛጉናክ ሾሌፋና ማአ ዉዛሶን ኣነ ዛግፋት። ስኑንታኖ ዛጉክ ሾሎኖይና ማጙ ዉዛሶንቱ ዛግፋንዋ። <verse eid="ROM 7:19"/><verse number="20" style="v" sid="ROM 7:20"/>ዛጉናክ ሾሎኖይና ማጙ ዉዛሶን ዛጊር ስንናኔን ኤስ ባሮን ዛግፋስ ታይሲ ፋ ቦርኣስታኖ ታቴዋ ኡዋ።<verse eid="ROM 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21"/>ኤስ ባሪ ቦርኣ ኦማ ቱማ ታይስታ ዎስቴት ፋናማቶቱ ቢጝዋ። ማአ ዉዛሶን ዛጉናክ ሾሌፋት ማጙ ዉዛሶን ዛጉናክ ቱግቴፋንዋ። <verse eid="ROM 7:21"/><verse number="22" style="v" sid="ROM 7:22"/>ስካሎናሲ ሀኦሲ ቱማክቱ ግሬፋን። <verse eid="ROM 7:22"/><verse number="23" style="v" sid="ROM 7:23"/>ስኑንታኖ ካኑናሲ ፋ ቱማስኔን አነ ኔቤፋፋ አቱናሲ ብልትሲ ዎስቴፋ ቦርኣሲ ቱማክ ታቶ ታን ዛግፋ ኦማ ቴስቶኒ ሳፋራ ታይሲ ፋናማቶ ቢጝዋ። <verse eid="ROM 7:23"/><verse number="24" style="v" sid="ROM 7:24"/>ታ አዉነ ፋሮን ሚርእአም አሱንሶ? ሀን ክቱሲ ታምፋ አሽናሲን ኦ ታን ፉእኦናክ ችምንሪንሶ? <verse eid="ROM 7:24"/><verse number="25" style="v" sid="ROM 7:25"/>ዳምኒ የሱስ ክርስቶስኒኪ ካሞ ሀኦሲክ ጋላታ ስንፋውጝዋ።</para>
  <para style="p" vid="ROM 7:25">ኤሴ ታ ቴትናሲ ካኑክ ሀኦሲ ቱማክ አጃጃሜር ስንፋት አሽናሲ ሃላክ ቦርኣሲክ አጃጃሜር ስንጝዋ።<verse eid="ROM 7:25"/></para>
  <chapter eid="ROM 7"/>
  <chapter number="8" style="c" sid="ROM 8"/>
  <para style="s1">አያናክ ፎ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1"/>ኤስ ባሪ ቦርኣ ክርስቶስ የሱስኒክ ፌሴ ባሶ ሀየ ኣፋ ባሶስታ ማጝሱ ካቶና ዉዛ። <verse eid="ROM 8:1"/><verse number="2" style="v" sid="ROM 8:2"/>ክርስቶስ የሱስኒኪ ካሞ ቤስቴፋ ካ እምፋ ኮርቶ አያናሲ ቱማ ቦርኣስንናዋ ክቱስንና ብርማዱምማ ታን ክስዋ። <verse eid="ROM 8:2"/><verse number="3" style="v" sid="ROM 8:3"/>አሱኒ ሃላኒ ሆፕታን ካብ ቾዋ ቱማስ ዛጉክ ችምኖይናሶን ሀኦስ ዛጊዋ። ሀኦ ባሪ ናስን ቦርእባ ፋና አሱነ ፌር ዛግራ ቦርኣሲክ ዎሲዋ። አሽባሲክ ደይ ቦርኣሶን ማጝሱ ካርኤ ትሽክዋ። <verse eid="ROM 8:3"/><verse number="4" style="v" sid="ROM 8:4"/>ኤስ ባሮን ደይ ዛግናስ አሽኒ ሳፋራክ ስንኖይናሮን አያናኒ ሳፋራስማቶ ፌፌ እኖኪ ካሞ ፉቶ ስና ቱማሲ አጃጅ ዎስቶታ ፌሻናክዋ። <verse eid="ROM 8:4"/><verse number="5" style="v" sid="ROM 8:5"/>አሽኒ ሳፋራሲማቶ ፌሴፌ ባሶ አሽኒ ሳፋራሶንቱ ሳፋርሴፌዋ። ስኑንታኖ አያናኒ ሳፋራሲማቶ ፌሴፌ ባሶ አያናኒ ሳፋራሶንቱ ሳፋሬሴፌውኣ። <verse eid="ROM 8:5"/><verse number="6" style="v" sid="ROM 8:6"/>አሽኒ ዉዛ ስና ባሮን ሳፋሮስ ክቱቱ ኤጳ ያፋውዋ። ስኑንታኖ አያናኒ ዉዛ ስና ባሮን ሳፋሮስ ካነዋ ናጋነቱ እምፋዋ። <verse eid="ROM 8:6"/><verse number="7" style="v" sid="ROM 8:7"/>አሽኒ ዉዛ ስና ባሮን ሳፋሬፌ አሱ ሀኦሲ ቱማክ ኣነ አጃጃሜፌዋ፤ አጃጃሞናክ ደይ ኣፋ ችማናዉዛ ስንና ቦርአ ሀኦሲ ጉማዋ። <verse eid="ROM 8:7"/><verse number="8" style="v" sid="ROM 8:8"/>አሽኒ ኤናንቶክ ዞኑስቴሴፌ ባሶ ሀኦሶን ግርሱክ ኣፋ ችሞነ ዉዛ። <verse eid="ROM 8:8"/><verse number="9" style="v" sid="ROM 8:9"/>ስኑንታኖ ንቶ ሀኦሲ አያና ስካሎንትትቲሲ ፋር ስንፋናነ አያናኒ ሳፋራሲክታኖ አሽኒ ኤናንቶሲማቶ ኣፋ ፎቲ ዉዛ። ክርስቶስኒ አያና ባሳስ ፎንቶ አሱ ክርስቶስኒ ኬንቴዋ። <verse eid="ROM 8:9"/><verse number="10" style="v" sid="ROM 8:10"/>ስኑንታኖ ክርስቶስ ንቶሲ ፌፋናነ አዉነ ፋሮንኑ አቱንቲስ ቦርኣስታን ካብ ቾዋ ክቱኒር ስኒፋናክኑ ሀኦስ ንቶትን ኦኮ ዛግና ቦርአ አያናንቲስ ሀየዋዋ። <verse eid="ROM 8:10"/><verse number="11" style="v" sid="ROM 8:11"/>የሱስኒን ክቱን ካብግ ሀኦሲ አያና ንቶስሲ ፋር ስንፋናነ ክርስቶስኒን ክቱን ካብግ ሀኦሲ ንቶስሲ ፋ አያናባስኪ ካሞ ክቱኒ አቱንቲሲክ ካ እማናዋ።<verse eid="ROM 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12"/>ኤስ ባሪ ቦርኣ አይታሳክቶኖ! ግድሱኒ ዉዛ እኖስታ ፋርዋ፤ ስኑንታኖ ኤስ ግድሱኒ ዉዛስ አሽኒ ሳፋራሲክ ፎኒክታዋ። <verse eid="ROM 8:12"/><verse number="13" style="v" sid="ROM 8:13"/>አሽኒ ሳፋራክ ፋፋትነ ክትቲርዋ። ስኑንታኖ ኮርቶ አያናሲ ሁግናክ አሽኒ ዎስቶኒትሶን ዎራትነ ካክ ፎትዋ። <verse eid="ROM 8:13"/><verse number="14" style="v" sid="ROM 8:14"/>ሀኦሲ አያናክ ዞኑስቴፌ ባሶ ዙቴሬ ሀኦሲ ናንጎታዋ። <verse eid="ROM 8:14"/><verse number="15" style="v" sid="ROM 8:15"/>ኤስ ባሪ ቦርኣ፦ «ኣባ! አባኒሶ!» ይራ ቴጌራ ናዉባ ስናት አያናቱ ኤጳ ታትታኖ ድጋክ ፎክ ሄፕሳ ዎላ ቦዝ ስንኒ አያና ኣነ ኤጳቶዌትዋ። <verse eid="ROM 8:15"/><verse number="16" style="v" sid="ROM 8:16"/>ሀኦሲ አያና እንኖ አያናስኔን አነ ስና ሀኦሲ ናንጎታ ስኒሶን እኖክ ዛላ ማኬፋዋ። <verse eid="ROM 8:16"/><verse number="17" style="v" sid="ROM 8:17"/>ኤሴ ሀኦሲ ናንጎታ ስንፋኒነ ባሪር ስና ባሮን ዙትራ ዋራሶንዋ፤ ክርስቶስኔን አነ ደይ ዋራሶኒርዋ፤ ሀሽ ባሳ ሻናሶን ሃኤር ስንፋኒነ ዎሊ ደይ ኡልፍናባሶን ሃኤር ስናንዋ።<verse eid="ROM 8:17"/></para>
  <para style="s1">ዮን ኡልፍናስ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18"/>ሀሽቲ ፋ ሻናስ ሀንኔንቲ እኖክ አምማኖን ቤስቶናክ ፋ ኡልፍናስኔን አነ ሆስፌኒ ካባሲክ እሳ ዉዛኔንኑ ሆሱኒክ ኣፋ ችማኒ ዉዛ ዛግራቱ ፋድፋዉጝዋ። <verse eid="ROM 8:18"/><verse number="19" style="v" sid="ROM 8:19"/>ቴስቶ ዙቴራ ሀኦሲ ናንጎታኒ አምማኖን ኬስሴ ቤስቶሶንቱ አካማ ካልታናክ ኦድትፋዋ። <verse eid="ROM 8:19"/><verse number="20" style="v" sid="ROM 8:20"/>ቴስቶ ዙታምባሴ ኬእኖር ስናናክ ማጝሱ ባሪስታ ካቴዋ። ኤሲስ ደይ ባሪ ቴትን ሹናክ ስኖይናሮን አብድክ ኦዳናክ ዛግ ሀኦሲ ፍቃድክዋ። <verse eid="ROM 8:20"/><verse number="21" style="v" sid="ROM 8:21"/>ኤስ አብዲስ ደይ ቴስቶ ዙታምባሴ ቴትባሲክ ትሹኒ ቦዞስን ብርማዱምማ ኬሳ ሀኦሲ ናንጎታክ ሆሬራ ፋ ብርማዱምማነዋ ኡልፍንነ አሲን ሃኤር ስናናማቶዋ። <verse eid="ROM 8:21"/><verse number="22" style="v" sid="ROM 8:22"/>ቴስቶ ዙታምባሴ እሳሪክ ሀውጙኔን ካርአ ኬክቶኒ ሜሮክ ኦቴራ ሃነት ፎባሶን አርፌኒዋ። <verse eid="ROM 8:22"/><verse number="23" style="v" sid="ROM 8:23"/>ስኑንታኖ ሃነት ፋ ቴስቶ ባር ባር ኮእባታዋ፤ ቴሱኒ እማ ስና ኮርቶ አያናሶን ኤጴቴ እንኖኑ ደይ አቱኒሲ ፉር ስና ሀኦስ አምማኖን ክስራ ቤሱናክ ፋ ሀኦሲ ናንጎታ ስናሶን አብድክ ኦደት ስካሎኪ አቱኒሲ ሃነቱ ፋንዋ። <verse eid="ROM 8:23"/><verse number="24" style="v" sid="ROM 8:24"/>እንኖ ፋሪስ ደይ ኤስ አብዲሲክዋ፤ ስኑንታኖ አብድ ዛግፌኒ ዉዛስ አፋክ ቢስቴር ስንፋናነ አብድ ስንባስ ፌሻርዋ። ኣፋክ ቢስቴፋ ባሮን ኦ አብድ ዛጉኒሪንሶ? <verse eid="ROM 8:24"/><verse number="25" style="v" sid="ROM 8:25"/>ስኑንታኖ ኣፋክ ቢፌኒ ዉዛሶን አብድ ዛግፋንነ ፋክያክ ኦዳኒዋ። <verse eid="ROM 8:25"/><verse number="26" style="v" sid="ROM 8:26"/>ኤሲስማቶ ኣካክ ሺጶኒክ ችማኒማቶ ኣነ አሪፌኒ ስንና ቦርአ ኮርቶ አያናስ ሆፕኒሶን አርጋሱናዋ። ኮርቶ አያናስ ቴትባሲክ ካማክ ዎሎክ ችምኖይኒ ሃኖክ እኖክ ኖኖነፋይዋ። <verse eid="ROM 8:26"/><verse number="27" style="v" sid="ROM 8:27"/>አሱሳ ንባኖን ቱእኒራ ቢፋ ሀኦስ ኮርቶ አያናሲ ሳፋራ አዉ ስንናማቶ አሪፋዋ። ኮርቶ አያናስ ኮርቶኒ ሜያክ ኖነፋናስ ሀኦሲ ፍቃድኒማቶዋ።<verse eid="ROM 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28"/>ሀኦሶን ሹንፌ ባሶክናዋ ባሪ ሳፋራስማቶ ቴግቴ አሱኒ ሜያክና ሀኦሲ ዙታምባሴ አስን ማአሪክ ዛጉናማቶ አሪፌኒዋ። <verse eid="ROM 8:28"/><verse number="29" style="v" sid="ROM 8:29"/>ኤስ ባር ደይ ስናስ ዜምማ አሪና ባሶ ናሳ ግቶኖንናዋ ናስ ደይ ሾዎ አይኒ ሜኒ ጋነያስን ኡዛ ስናናክ ሀኦስ ዜምማ ኮፓኤና ወደይ ቡግና ቦርአዋ። <verse eid="ROM 8:29"/><verse number="30" style="v" sid="ROM 8:30"/>ዜምማ ኮሪና ባሶትን ቴጌ፤ ቴጌና ባሶትን ኦኮ ዛግ፤ ኦኮ ዛግና ባሶትን ደይ ኡልፍንሲ።<verse eid="ROM 8:30"/></para>
  <para style="s1">ሀኦሲ ኬሽታና</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31"/>ኤኪን ሀን ዉዛሶን አዉ ኡንሪንሶ? ሀኦስ እኖኔን አነ ስንፋናነ ኦ እኖትን ቱጋኦክ ችምንሪንሶ? <verse eid="ROM 8:31"/><verse number="32" style="v" sid="ROM 8:32"/>ሀኦስ ባሪ ናሲክ ኬናሽቶኖይ እኖክዋ እያት ኣትራ እምናኔን ኣካክ ዙታምባሴ አስን ናባስኔን አነ ዋግባ ፎንቶኖን እኖክ እማ ቤይንሪንሶ? <verse eid="ROM 8:32"/><verse number="33" style="v" sid="ROM 8:33"/>ሀኦሲ ኮርና ባሶትን ኦ ማላቶክ ችምንሪንሶ? ኦኮ ዛጉኒስ ሀኦስዋ። <verse eid="ROM 8:33"/><verse number="34" style="v" sid="ROM 8:34"/>ኦንሶ ባሶስታ ማጝሱ ካርንሪ? ክርስቶስ የሱስ ባሶስታ ማጝሱ ካርኒሮሶ? ባር እኖክዋ እያት ክት፤ ክቱን ካብሬ አባ ሀኦሲ ሆእታ ቴሽታ ድ፤ እኖክ ናትፌስ ደይ ባርዋ። <verse eid="ROM 8:34"/><verse number="35" style="v" sid="ROM 8:35"/>ክርስቶስኒ ኬሽታናስታን እኖትን ኦር ክሱናክ ችምኒስ ኦንሶ? ራኮኖሶ? ወደይ ሻናኖሶ? ካቡግቶኖሶ? ወደይ ማክቶኖሶ? አታቱ ስናኖሶ? ወደይ አዳጋኖሶ? ወደይ ሲፎኖሶ? <verse eid="ROM 8:35"/><verse number="36" style="v" sid="ROM 8:36"/>ኤስ ደይ፦</para>
  <para style="q1" vid="ROM 8:36">«ነ ቦርአ ዎናሶን ዙትራ ክቱስኔን አነ ኔቤፌንዋ፤</para>
  <para style="q2" vid="ROM 8:36">ሹክቶኒ ፋንቱሲክቶኒማቶ ፋድቴፌኒዋ።»</para>
  <para style="m" vid="ROM 8:36">ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 8:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ROM 8:37"/>ኤሴ እኖትን ሹና ክርስቶስኒክ ኤስ ዉዛሶን ዙትራ ሜሬራ እኖትን ኔቤራ ሜሬፋ ዉዛ ዙታምባሴ አሲስታን ደናሎ ስናንዋ። <verse eid="ROM 8:37"/><verse number="38" style="v" sid="ROM 8:38"/>ኤስ ባሪ ቦርኣ ክቱስኑ ስኑን፥ ካስኑ ስኑን፥ ሀኦሲ ዎስያኑ ስኑን፥ ሀእሱኒ ሁግናቤስ ፋና ባሶኑ ስኖቶ፥ ሀሽቲ ፋ ባርኒ ስኑን፥ ሀንኔንቲ ዮኒ ባርኒ ስኑን፥ ሁግናባ ፋና ባርኒ ስኑን፥ <verse eid="ROM 8:38"/><verse number="39" style="v" sid="ROM 8:39"/>ቴጋስኑ ስኑን፥ ዳክሶስኑ ስኑን፥ ኣፋ ቴስቶስኑ ስኑን ዳምኒ ክርስቶስ የሱስኒኪን ዳኒ ሀኦሲ ኬሽታናታን ኦር ክሱኒ ዉዛ ኣፋ ስንናማቶ ጋሳሲራቱ ፋዉጝዋ።<verse eid="ROM 8:39"/></para>
  <chapter eid="ROM 8"/>
  <chapter number="9" style="c" sid="ROM 9"/>
  <para style="s1">ሀኦሲ እስራኤልኒ ዳራኒ ኮሪ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1"/>ክርስቶስኔን አነ ፋፋትቱ ፉቶሶን ማኬፋንዋ፤ ኣፋ ደይ ኤሻና ዉዛ። ሀኦሲ ኮርቶ አያናክ ዞኑስቴፋ ካኑናስ ደይ ኣፋ ኤሻና ዉዛ ስንናማቶ ታክ ዛላ ማኮናዋ። <verse eid="ROM 9:1"/><verse number="2" style="v" sid="ROM 9:2"/>አካማ ሱሞነዋ ኮኡኖይ ራክኮነ ንብናሲ ፋርዋ። <verse eid="ROM 9:2"/><verse number="3" style="v" sid="ROM 9:3"/>አሻክ ኮኒታ ስና እንኖ ሜያክዋ እያት ታ ክርስቶስኒስታን ኦር ኬሳ ሀኦሲ ኤርዊያ ታይስታ ካርፋናነ ሹናና ካባዋ። <verse eid="ROM 9:3"/><verse number="4" style="v" sid="ROM 9:4"/>ባሶ እስራኤልኒ ሜያዋ፤ ሀኦስ ደይ ባሶትን ናንጎትባ ዛጊዋ። ኡልፍንባሶን ባሶክ አምማኖን ክስራ ቤስዋ። ባሶኔን አነ ደይ ቴያ ግሪዋ፤ ቱማሶን ደይ ባሶክ እሚ። ፉቶኒ ሀኦኒ ሺጶሲ ስትርኖን ባሶክ ቤሲ፤ አብድን ካምባሶን ደይ ባሶክ እሚ። <verse eid="ROM 9:4"/><verse number="5" style="v" sid="ROM 9:5"/>ባሶ ኮንቶቤሲሲክ አሲቴሴሪኒ አባን ሜያኪን ዬሴቴርዋ። ክርስቶስ ደይ አሻክ ዬናስ ባሶ ዛላስንዋ። ባር ዙታምባሴ አሲ ደናሎዋ፤ ኮእባ ፎንቶኖን ደይ ሱስቶ ሀኦዋ፤ ኣሚን!<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">ኦማ ኦማ ትቻስታ ሀኦሲ ዙታምባሴ አሲስታን ደናሎ ኡቱ ይፋ። </char></note><verse eid="ROM 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6"/>እስራኤልኒ ዛላ ዙቴራ ፉቶኒ እስራኤልኒ ሜያታ ስና ቤይና ቦርአ ሀኦሲ ካማ ሻርቴዋ ኡታዋ። <verse eid="ROM 9:6"/><verse number="7" style="v" sid="ROM 9:7"/>ኤሲስማቶ ደይ አብራሀምኒ ዛላ ዙቴራ አብራሀምኒ ናንጎታዋ ኡታዋ። ሀኦሲ አብራሀምኒን፦ «ዛልኔስ ቴግቶናስ ይሳቅኒኪ ካሞዋ» ይና ቦርአዋ። <verse eid="ROM 9:7"/><verse number="8" style="v" sid="ROM 9:8"/>ኤስ ባሪ ቦርኣ አሻክ አብራሀምኒኪን ኮንቴሴቴ ቦርአ ሀኦኒ ናንጎታታዋ። ስኑንታኖ ዛላ ስንና ፋድቶኒስ አብድን ካማሲ ናንጎታስ ኮእባዋ። <verse eid="ROM 9:8"/><verse number="9" style="v" sid="ROM 9:9"/>ኤስ ባር ደይ ሀኦስ እምና አብድን ካማስ፦ «ሀውጙት ዎግጋ ሀን ካባስታ ኔኪ ዮናዋ፤ ሳራ ደይ ኣርቃ ናኒን ኮጶናዋ» ይፋርዋ።<verse eid="ROM 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10"/>ኤስ ባር ኮእባ ስኖይናሮን ርብቃ አሲቴሴሪኒ አባን ስና ይሳቅኒን ማኖ ናንጎትንን ናኔርቴፋና ካባሲክ፤ <verse eid="ROM 9:10"/><verse number="11-12" style="v" sid="ROM 9:11-12"/>ሀኦሲ ኮሩ ዎስቶክ ስኖይናሮን ቴጎክ ስንባሶን አምማኖን ቤሱናክ ሄፕ ናንጎቲስ ኮንቶባስኔን ዜምማ ወደይ ማአሮንናዋ ማጙኖንና ዛግሶቤሲስኔን ስናክ ሀኦስ ርብቃክ፦ «አሪክስ ሀቴሲክ ሀኢር ስናናዌ» ይ። <verse eid="ROM 9:11-12"/><verse number="13" style="v" sid="ROM 9:13"/>ኤሲስ ደይ፦ «ያቆብኒን ሹኒን ስኑንታኖ ኤሳዉኒን ኦምቴን» ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14"/>ኤኪን አዉ ኡንሪንሶ? ሀኦ ኮሪር ኡክ ችማኒሮሶ? እሳንነ ሀኦሲ ኮሪር ኡክ ኣፋዋ ችማኒዉዛ። <verse eid="ROM 9:14"/><verse number="15" style="v" sid="ROM 9:15"/>ሀኦስ ሙሴኒን፦ «ፌሹን ኡናክ ሾሌና ባሶትን ፌሹን ኡና፤ ኬናሽቶናክ ሾሌና ባሶትን ኬናሽቶናዋ» ይዋ። <verse eid="ROM 9:15"/><verse number="16" style="v" sid="ROM 9:16"/>ኤሴ ሀን ባር ቤስቴፋናስ አሱኒ ፍቃድክናዋ ዎስቶክና ስኖይናሮን ሀኦሲ ፋክያክዋ። <verse eid="ROM 9:16"/><verse number="17" style="v" sid="ROM 9:17"/>ኤስ ባሪ ቦርኣ ኮርቶ ማፃፋሲ ግጵጽኒ ታቶሳ ቾዋክ፦ «ኔኪ ካሞ ሁግናናሶን ቤሱናክናዋ ሱናስ ደይ ዳ ዙታምባሴ አሲስ አሪቶናክና ዛጉናክ ኔን ታስጝዋ» ይፋ ካማ ትቼዋ። <verse eid="ROM 9:17"/><verse number="18" style="v" sid="ROM 9:18"/>ኤስ ባሪ ቦርኣ ሀኦሲ ፋኩናክ ሾሌና ባሶትን ፋኩናዋ፤ ሾሌና ባሶትን ደይ ንቤሲሲ ችማናክ ዛጉናዋ።<verse eid="ROM 9:18"/></para>
  <para style="s1">ሀኦኒ ግእነዋ ፋኪነ</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19"/>ኤስ ባሪ ቦርኣ፦ «ሀኦሲ ፍቃድኖን ኦኑ ቱጋኦክ ኣፋ ችማናዉዛ። ኤኪን ባር አሱኒ ሜያኖን ማጙ ዎስቶቤሲሲክ አዉኒ ቦርአ ዌእኤፋሶ?» ይራ ታን ማምሱታር ስናናዋ። <verse eid="ROM 9:19"/><verse number="20" style="v" sid="ROM 9:20"/>ነ ሀን አሱሶ! ሀኦሲኔን ካራካሮታክ ነ ኦንሶ? ኮዳስ ባሮን ሆእፌ ባሪን፦ «አዉኒሮን ታን ኤካ ዛግራ ዎስቴስሶ?» ኡናክ ችምኒሮሶ? <verse eid="ROM 9:20"/><verse number="21" style="v" sid="ROM 9:21"/>ኮዳሶን ሆእፌ ባር እሳ ቴሳ ሆኣስን እሳ ኮዳሶን ኡልፍናኒር፥ ኦማሶን ደይ ስኖይ ዎስቶታ ፌሻናክ ዛግሬ ዎስቶናክ ማብቲባ ኣፋኖሶ?<verse eid="ROM 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22"/>ሀኦሲ ግእባሶን ቤሱክናዋ ሁግናባሶን አምማኖን ክስራ ቤሱናክና ሾሌፋት ትሹክ ሆሬራ ፋ ግእኒ አሱሳክቶኒክ አካማኖን ፋኪ ስንፋናነካሶ? <verse eid="ROM 9:22"/><verse number="23" style="v" sid="ROM 9:23"/>ደይ ዜምማ ኡልፍናክ ሆስና ፌሹን ይና አሱኒ ሜያክ ኡልፍንባሲ አሪኩኖን አምማኖን ክስራ ቤሱናክ ስንፋናነካሶ? <verse eid="ROM 9:23"/><verse number="24" style="v" sid="ROM 9:24"/>ፌሹን ይና አሱኒ ሜያ ደይ አይሁድኒ ሜያስን ኮእባ ስኖይናሮን አዛብኒ ሜያስን ደይ ቴጌዋ። <verse eid="ROM 9:24"/><verse number="25" style="v" sid="ROM 9:25"/>ኤስ ባር ደይ ራጁ ሆሴኒኪ ካሞ ኤካ ይስቴናማቶዋ፦</para>
  <para style="q1" vid="ROM 9:25">«ታ ዳራ ስኖይ ባሶትን፦ ‹ዳራታ› ይራ ቴጎናዋ፤</para>
  <para style="q2" vid="ROM 9:25">ሹንቶኖይ ዳራስን ደይ፤</para>
  <para style="q2" vid="ROM 9:25">‹ሹንቶ› ይራ ቴጎናዋ።<verse eid="ROM 9:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26"/>ባሶ ‹ታ ዳራቴ›</para>
  <para style="m" vid="ROM 9:26">ይስቴሬ ቴግቴሴቴ ድማስታ፤</para>
  <para style="q2" vid="ROM 9:26">‹ሀየዋ ሀኦሲ ናንጎታ›</para>
  <para style="m" vid="ROM 9:26">ይስቴሬ ቴግቶሶነዋ።»<verse eid="ROM 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27"/>ራጁ ኢሳያስ ደይ እስራኤልኒ ቾዋሲክ ኤካ ይት ካምባሶን ቴግሬ ቻግጌ ማኬዋ፦ «እስራኤልኒ ናንጎታስ ፋዳ ባሃሪኒ ፉቱኒማቶ አሪክፋናክኑ ባሶስን ፋሩቶኒስ ጋሮ ሜያ ኮእቤስዋ። <verse eid="ROM 9:27"/><verse number="28" style="v" sid="ROM 9:28"/>ዳሚስ ዎክኖይ ታፕታክ ሀን ዳስታ ማጝሱ ካርአናዋ» <verse eid="ROM 9:28"/><verse number="29" style="v" sid="ROM 9:29"/>ኤሲስማቶ ኢሳያስ፦</para>
  <para style="q1" vid="ROM 9:29">«ዙታምባሴ አሲ ደናሎ ስና ዳሚስ፤</para>
  <para style="q2" vid="ROM 9:29">እኖክ ዛላ ፉኦ ሻኪ ስንፋናነ፤</para>
  <para style="q2" vid="ROM 9:29">ሶዶምኒ ካታማሴዋ፤</para>
  <para style="q2" vid="ROM 9:29">ጋሞራኒ ካታማሴ ትሽናስማቶ፤</para>
  <para style="q2" vid="ROM 9:29">እንኖ ደይ ትሹኒ ካባዋ»</para>
  <para style="m" vid="ROM 9:29">ይት ዜምሜ ማኬዋ።<verse eid="ROM 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30"/>ኤኪን አዉ ኡንሪንሶ? ኦኮ ስና ዉዛሶን ዳናክ ዎስቶኖይ አዛብኒ ሜያ ኦኮ ዉዛሶን ዳነቴዋ፤ ኤስ ኦኮ ዉዛስ ደይ አማንቶክ ቤስቴፋ ባርዋ። <verse eid="ROM 9:30"/><verse number="31" style="v" sid="ROM 9:31"/>ስኑንታኖ ኦኮ ስና ዉዛሶን ዳናኒክ ዛግፋ ቱማሲክ ዞኑስቴት ፌ እስራኤልኒ ሜያ ቱማሶን ኦዳክ ኣነ ችሞቶ ስንና ቦርአ ኦኮስኪ ሀምሜ ኣነ ካርኦቶዋ። <verse eid="ROM 9:31"/><verse number="32" style="v" sid="ROM 9:32"/>ኤስ ባር አዉኒ ቦርአ ኤካ ስኒሶ? ኦኮ ስና ዉዛሲኪ ሀምሜ ካርአ ቤየቴስ ባሶ ኦኮ ስና ዉዛሶን ዳናክ ሾልሴቴስ አማንቶክ ስኖይናሮን ዎስቶክ ስንና ቦርአዋ። ኤስ ባሪ ቦርኣ ቱሳእሱኒ ሹኣሲክ ቱሳኤሴቴዋ። <verse eid="ROM 9:32"/><verse number="33" style="v" sid="ROM 9:33"/>ኤሲስ ደይ፦</para>
  <para style="q1" vid="ROM 9:33">«ኤሴ አሱኒ ሜያኖን ቱሳእሱን ሹአ ፅዮኑክ ዱሱናዋ፤</para>
  <para style="q2" vid="ROM 9:33">ኤስ ሹኣስ አሱኒ ሜያኖን ቱሳእስራ ጋንሱኒ ካኦዋ።</para>
  <para style="q2" vid="ROM 9:33">ባሪክ አማነፌ ባር ኣፋ ኢቾናዉዛ።»</para>
  <para style="m" vid="ROM 9:33">ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 9:33"/></para>
  <chapter eid="ROM 9"/>
  <chapter number="10" style="c" sid="ROM 10"/>
  <para style="s1">እስራኤልኒ ሜያ ሀኦሲ ኡግናክ ዞኑስቶ ቤየቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1"/>አይታሳክቶኖ! ንብናሲ ፋ አካማ ካልታናሴዋ ሀኦስኪ ታእስት ፋና ሺጶናሴ እስራኤልኒ ሜያ ፋርሶነክዋ። <verse eid="ROM 10:1"/><verse number="2" style="v" sid="ROM 10:2"/>አሩስ ልኪ ስና ቤይባስታኖ ባሶ ሀኦሲክ ካምባሲማቶ ፎኒ ኮና ባሶስሲ ፋናማቶ ታ ቴትናሲክ ዛላ ስናናዋ። <verse eid="ROM 10:2"/><verse number="3" style="v" sid="ROM 10:3"/>ሀኦስ አሱኒ ሜያኖን ኦኮ ዛጉና ኡግናሶን ኣነ አሩሶቶ ስንና ቦርአ ቴትቤሲስክ ኦኮኒ ኡግናሲክቱ ዞኑስቴቴታኖ ሀኦሲ ኦኮ ኡግናክ ኣነ ዞኑስቶሶቶዋ። <verse eid="ROM 10:3"/><verse number="4" style="v" sid="ROM 10:4"/>አማነፌ አሱ ዙቴሬ አማንቶክ ኦኮ ስናናክ ሙሴኒ ቱማሲ ክርስቶስኒስታ የሬዋ።<verse eid="ROM 10:4"/></para>
  <para style="s1">ፋሩስ ዙታምባሴ አሲክዋ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5"/>ቱማሶን ኦዳክ ቤስቴፋ ኦኮሲክ ሙሴኒ ማፃፋሲ፦ «ቱማሶን ዛግፌ ባር ዙቴሬ ካክ ፎናዋ» ይፋርዋ። <verse eid="ROM 10:5"/><verse number="6" style="v" sid="ROM 10:6"/>ስኑንታኖ ሀኦስ አሱኒ ሜያኖን አማንቶክ ኦኮ ዛጉባስ ኤካ ይስቴራ ትቼዋ፦ «ንብኔሲ ኦ ሳማ ኬስኒሪንሶ?» ኡታታዋ። ኤስ ባር ደይ ክርስቶስኒን ኬሱክዋ። <verse eid="ROM 10:6"/><verse number="7" style="v" sid="ROM 10:7"/>ወደይ ንብኔሲ «ትርኦኒ ድማሲ ኦ ኬሮንሪንሶ?» ኡታታዋ። ኤሲስ ደይ ክርስቶስኒን ክቱኒ ካብጉዋ።<verse eid="ROM 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 10:8"/>ደይ ኤካ ይስቴራ ትቼዋ፦ «ሀኦሲ ካማ ቴሽነቱ ፋዋ። ደይ ኖኖኔሲንናዋ ንብኔሲናቱ ፋዋ» ኤስ ካማስ ደይ እንኖ ማኬፌን አማንቶኒ ካማስዋ።<verse eid="ROM 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 10:9"/>የሱስ ዳም ስንባሶን ኖኖኔሲክ ዛላ ማኬፋታነናዋ ሀኦስ ባሪን ክቱን ካብግናማቶ ንብኔሲ አማነፋታነና ፋሩታዋ። <verse eid="ROM 10:9"/><verse number="10" style="v" sid="ROM 10:10"/>አሱ ንብባሲ አማነሬ ኦኮ ስናና፤ ኖኖባሲክ ደይ ዛላ ማኬሬ ፋሩናዋ። <verse eid="ROM 10:10"/><verse number="11" style="v" sid="ROM 10:11"/>ኮርቶ ማፃፋሲ፦ «ባርኪ አማነፌ ባር ዙቴሬ ኣፋ ኢቾናዉዛ» ይስቴናስማቶዋ። <verse eid="ROM 10:11"/><verse number="12" style="v" sid="ROM 10:12"/>ኤሴ እሳ ዳሚስ ዙታምባሴ አሲ ዳም ስንና ቦርአ አይሁድኒ ሜኒ ጋነያስናዋ አዛብኒ ሜኒ ጋነያስና ኦር ኦርባ ኣፋዋ። ባር፤ ባርኪ ሺጵሴፌ ባሶ ዙታምቤሲሴ አሲክ ኦቱምባሶን ዳይስሬ እማናዋ። <verse eid="ROM 10:12"/><verse number="13" style="v" sid="ROM 10:13"/>«ዳሚሳ ሱናኖን ቴጌፌ ባር ዙቴሬ ፋሩናዋ» ይስቴዋ።<verse eid="ROM 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14"/>ስኑንታኖ ባሪን አማኖኖይ ኣካክ ቴግሶክ ችሞነሪን? ባሳ ቾዋሶን ኦዶኖይ ኣካክ አማኖሶነሪን? አስሲኛ ፎንቶኖን ደይ ኣካክ ኦዶክ ችሞነሪን? <verse eid="ROM 10:14"/><verse number="15" style="v" sid="ROM 10:15"/>አስሲኛኒ ሜያ ዎስቴሬ ሀሞኖይ ኣካክ ካምባሶን አስሱክ ችሞነሪን? ኤሲስ ደይ፦ «ምስራቹኒ ኦዱሶን ማክሴፌ ባሶ ዮሲ ኣካ ግርስፋሶ!» ይስቴራ ትቼናስማቶዋ። <verse eid="ROM 10:15"/><verse number="16" style="v" sid="ROM 10:16"/>ስኑንታኖ ኢሳያስ፦ «ዳሚሶ! ማኬኒ ኦዱሶን ኦንሶ አማነሪ?» ይሬ ማኬናሲማቶ ምስራቹኒ ኦዱሶን ኤጴቴሴ ባሶ ዙታምቤሲሴታዋ። <verse eid="ROM 10:16"/><verse number="17" style="v" sid="ROM 10:17"/>ኤሴ አማንቶ ቤስቴፋናስ ምስራቹኒ ኦዱሶን ኦዶክዋ። ኤስ ኦዱስ ደይ ክርስቶስኒ ቾዋሲክ ማክቴፋ ካማስዋ። <verse eid="ROM 10:17"/><verse number="18" style="v" sid="ROM 10:18"/>ሻካኒ ማምሱጝዋ፤ ኤኪን ባሶ ካምባሶን ኣነ ኦዶሶቶ ኡኖሶ? ኮርቶ ማፃፋሲ፦</para>
  <para style="q1" vid="ROM 10:18">«ካምቤሲስ ዳ ዙታምባሴ አሲስ ኦድቴ፤</para>
  <para style="q2" vid="ROM 10:18">ማኬሴቴ ካማስ ዳስ ድልታ ካርእ»</para>
  <para style="m" vid="ROM 10:18">ይስቴራ ትቼናስማቶ ፉቶሲክ ኦደሴቴዋ። <verse eid="ROM 10:18"/><verse number="19" style="v" sid="ROM 10:19"/>ሻካኒ ማምሱጝዋ፤ ደይ እስራኤልኒ ሜያ ካምባሶን ኣነ አርሶቶ ኡኖሶ? ኤካ ኡስቶኖይናማቶ ሙሴ ዜምሜ፦</para>
  <para style="q1" vid="ROM 10:19">«ካሽስቶ ዳራስን፤</para>
  <para style="q2" vid="ROM 10:19">ኮኖትክ ዛግራ ጋቢስሱናዋ፤</para>
  <para style="q2" vid="ROM 10:19">ያዳቶኖይ ዳራሲክ ደይ ንቶትን ሃርሱና» ይዋ።<verse eid="ROM 10:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ROM 10:20"/>ራጁ ኢሳያስ ደይ፦</para>
  <para style="q2" vid="ROM 10:20">«ታን ሾልሶኖይ ባሶክ ቤስቴን፤</para>
  <para style="q2" vid="ROM 10:20">‹ሀኦስኪ አይንሶ?›</para>
  <para style="q2" vid="ROM 10:20">ይሬ ማምሱኖይ ባሶክ አምማኖን ቤስቴን»</para>
  <para style="m" vid="ROM 10:20">ይት ድጎኖይ ማኬዋ።<verse eid="ROM 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21"/>ስኑንታኖ እስራኤልኒ ሜኒ ቾዋሲክ፦ «አጃጃሞኖይ ዳራስናዋ ኑሪፌ ዳራስና ታኪ ዮናክ ዎናሶን ዙትራ ኩሹናሶን ሾን» ይፋዋ።<verse eid="ROM 10:21"/></para>
  <chapter eid="ROM 10"/>
  <chapter number="11" style="c" sid="ROM 11"/>
  <para style="s1">ሀኦሲ እስራኤልኒ ዳራስን ኣነ ሀኡዋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1"/>ሻካኒ ደይ ማምሱጝዋ፤ ሀኦሲ ዳራባስን ሀእዮሶ? እሳንነ ኣነ ሀኡዋዋ። ታ ቴትናሲክ እስራኤልኒ ዳኒ አሱዋ፤ አብራሀምኒ ዛላ ስና ብንያምኒ ኬጝዋ። <verse eid="ROM 11:1"/><verse number="2" style="v" sid="ROM 11:2"/>ሀኦስ ዜምማ ኮርና ዳራስን ኣነ ሀኡዋዋ። ኮርቶ ማፃፋሲ ኤልያስኒ ቾዋሲክ አዉ ይናማቶ ኣነ ያዳቶዌትኖሶ? ደይ ኤልያስ እስራኤልኒ ዳራስን አዉ ይሬ ማላቴናማቶ ኣነ አሩዌትኖሶ? <verse eid="ROM 11:2"/><verse number="3" style="v" sid="ROM 11:3"/>ኤስ ካባሲክ ኤልያስ፦ «ዳሚሶ! ራጁነሳክቶኒን ዎርሴቴዋ፤ ሾአኔሲክቶኖን ቦጌሴቴ፤ ታ ደይ ታ ታ ፉእቴጝዋ፥ ታን ደይ ዎርሶነክ ሾልሴድፌርዋ» ይት ፌርዋ። <verse eid="ROM 11:3"/><verse number="4" style="v" sid="ROM 11:4"/>ስኑንታኖ ሀኦስ አዉ ይራንሶ ባርክ ዎልግናሪ?፦ «ባል ይስቴፋ ኮሎሲክ ካኖኖር ናፉን ኩም አሱኒን ታክ ፉእኤጝዋ» ይዋ። <verse eid="ROM 11:4"/><verse number="5" style="v" sid="ROM 11:5"/>ሀን ነያሲክ ደይ ስንፋናክኑ ሀኦሲ ኦትማክ ኮርቴሬ ፉእቴር ጋሮ ፌሴቴርዋ። <verse eid="ROM 11:5"/><verse number="6" style="v" sid="ROM 11:6"/>ኤሴ ባሪ ኮሩስ ሀኦሲ ኦትማክ ስንፋናነ ዎስቶክታዋ ኡዋ፤ ዎስቶክ ስኒ ስንፋናነ ሀኦሲ ኦትማ ፉእቶኒር ስናና ካባታዋ። <verse eid="ROM 11:6"/><verse number="7" style="v" sid="ROM 11:7"/>ኤኪን ጋንባስ አዉ ስንሶ? እስራኤልኒ ሜያ ሾሌሴቴ ባሮን ኣነ ዳኖቶዋ፤ ስኑንታኖ ኮርቴሴ ባሶ ዳነቴ፤ ፉእቴ ባሶ ደይ ንቤሲሶን ችኒሴቴ። <verse eid="ROM 11:7"/><verse number="8" style="v" sid="ROM 11:8"/>ኤሲስ ደይ፦ «ሀኦስ ንቤሲሶን ሙምሲ፤ ኤስ ባሪ ቦርኣ ሀውጙኔን ካርአ ኣፍቤስ ቢኖይናማቶ፤ ኦዶቤስ ደይ ኦዶኖይናማቶ ሲኒዋ» ይስቴራ ትቼናስማቶዋ። <verse eid="ROM 11:8"/><verse number="9" style="v" sid="ROM 11:9"/>ዳዊት ደይ፦</para>
  <para style="q1" vid="ROM 11:9">«ማድቤሲስ ኤጵፋ ኤሽምያ፤</para>
  <para style="q2" vid="ROM 11:9">ጋንሱኒ ዶአ ስና ባሶትን ራክሲፋዉጝዋ፤</para>
  <para style="q2" vid="ROM 11:9">ዛግሴቴ ማጝጉስ ባሶስታ ካርፋዉጝዋ፤<verse eid="ROM 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10"/>ኣፍቤስ ቢኖር ስንና ታልሜፋውጝዋ፤</para>
  <para style="q2" vid="ROM 11:10">ጌሾቤሲስ ራኮክ፤</para>
  <para style="q1" vid="ROM 11:10">ዎንና ዎንና ኩፑፋዉጝዋ» ይዋ።<verse eid="ROM 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11"/>ሻካኒ ደይ ማምሱጝዋ፤ አይሁድኒ ሜያ ጋንደሴቴስ ሄፕሳ ዎል ሌ ካብሶኖይቴማቶኖሶ? እንዳነዋ! አይሁድኒ ማጝሱሲ ቦርአ አዛብኒ ሜያ ፋሩ ዳነቴዋ። ኤስ ባር ደይ ስንናስ አይሁድኒ ሜያ አዛብኒ ሜያስታ ኮኖሶነክ ዛጉክዋ። <verse eid="ROM 11:11"/><verse number="12" style="v" sid="ROM 11:12"/>ስኑንታኖ አይሁድኒ ሜኒ ቦርኣስ ሀን ዳሲክ ኤባ ቤስቶናክ ዛጊዋ። ባሶ ጋንዶስ አዛብኒ ሜያክ ኤባ ስኒዋ። አይሁድኒ ሜያ ፋርሴቴ ስንፋናነ ኤባቤስሲ አዉነ ፋ አካማ ስናና ካባንሶ?<verse eid="ROM 11:12"/></para>
  <para style="s1">አዛብኒ ሜኒ ፋሩ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13"/>ኤሴ ሀሽ ማኮናስ ኣዛብ ስና ንቶክዋ፥ አዛብኒ ሜኒ ዎሲ ስንናማቶ ዎስቴፋና ዎስቶስ ኡልፍና ስንናቱ ታክ ቤስቴፋዋ። <verse eid="ROM 11:13"/><verse number="14" style="v" sid="ROM 11:14"/>ኤስ ባሮን ደይ ዛግናስ ታ ኮን ስና አይሁድኒ ሜያኖን ኮኖሶነክ ዛጉናክዋ። ኤስ ባርክ ደይ አዉዛክነ ባሶስን እሳ እሳርን ፋቱክ ችማና ስናናዋ ኡክዋ። <verse eid="ROM 11:14"/><verse number="15" style="v" sid="ROM 11:15"/>ሀኦ ባሶትን ሀእፋና ካባሲክ ኦማ ሀን ዳሲ ዳራስ ሀኦሲኔን አነ ጋነናኔን ሀኦሲ ባሶትን ኤጳ ታፋና ካባሲክ አዉ ስናና ስንና ንቶክ ቤስቴፋሶ? ኤስ ባር ደይ ክቱን ካቡነ ፋርዋ። <verse eid="ROM 11:15"/><verse number="16" style="v" sid="ROM 11:16"/>እሳ ቴሳ ቱሾስን ቴሱኒ ባር ሀኦሲክ እምቴራ ኮርቶ ስንፋናነ፥ ቱሾስ ዙቴራ ኮርቶዋ፤ ኤሲስማቶ እሳ እኦስ ታስባስ ኮርቶ ስንፋናነ ዋይእባስ ደይ ኮርቶቱ ስናናዋ። <verse eid="ROM 11:16"/><verse number="17" style="v" sid="ROM 11:17"/>ጎርጉ ድ ቡናሲ<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">እስራኤልኒ ዳክ ፋ ቡንኒ እኦስ ጋና ዛይት ዎሱስቴር።</char></note> ዋይአኒማቶ ስና አይሁድኒ ሜያ ካቴሬ ሀቴሴቴኔን ንቶ ቡርእኡ ድ ቡናሲ እኦኒ ዋይእኒማቶ ስና ኣዛቢስ ባሶ ኤደሲ ግሪራ ኤስ ታሳስ እምፋና ኤባሶን ሃኤር ስንፋትነ፤ <verse eid="ROM 11:17"/><verse number="18" style="v" sid="ROM 11:18"/>ንቶ አዛብኒ ሜያ፤ ዋይአሲማቶ ካቴሬ ሀቴ አይሁድኒ ሜያስታ ጌአቲታዋ፥ ስኑንታኖ ንቶ ጌኤፋትነ ዋእአ ዋእአ ስንነት ቦርአ ታሳስቱ ንቶትን ዎርአስታኖ ንቶ ታሳሶን ዎርአክ ኣፋ ችማት ዉዛ ስንናማቶ ያዳቶትዋ። <verse eid="ROM 11:18"/><verse number="19" style="v" sid="ROM 11:19"/>ስኑንታኖ፦ «ዋአሲክቶ ኪቴራ ጋንደናስ ታ ባሪ ኤደሲ ግሩናክዋ» ኡቲ ስናናዋ። <verse eid="ROM 11:19"/><verse number="20" style="v" sid="ROM 11:20"/>ልኪዋ! ባሶ ካቴሬ ጋንደሴቴስ አማኖ ቤዮቤስሲክዋ። ስኑንታኖ ንቶ ችማ ዬሬቲስ አማነሴት ቦርአዋ። ኤሴ ድጎትስታኖ ጌአትክ ኣነ ሾልስፋዋ። <verse eid="ROM 11:20"/><verse number="21" style="v" sid="ROM 11:21"/>ሀኦስ ቴስቶቤሲሲክ ዋይአ ስና አይሁድኒ ሜያክ ኬናሽቶ ሻካናነ ንቶክ ደይ ኣፋ ኬናሽቶና ዉዛ። <verse eid="ROM 11:21"/><verse number="22" style="v" sid="ROM 11:22"/>ኤሴ ሀኦሲ ጋራማኖንናዋ ዴሱባሶንና ቢትዋ። ዴሱባሶን ቤስፋናስ ጋንደ ባሶስታዋ። ስኑንታኖ ጋራምባሶን ቤስፋናስ ንቶስታዋ። ኤስ ባሮን ደይ ዛግናስ ባር ጋራማሲክ ችምማ የሬፋትነዋ። ችምማ የሮ ሻካትነ ንቶ ደይ ካቴራ ጋንደሴትርዋ። <verse eid="ROM 11:22"/><verse number="23" style="v" sid="ROM 11:23"/>አይሁድኒ ሜያ አማኖ ቤዮቤሲስን ዎልሴፋቴነ ዜሞቲ ካቴሴቴ ድምቤሲስታ ዎልሶነዋ። ሀኦስ ዜሞቲ ድምቤሲስታ ባሶትን ዎልጉናክ ደይ ችማናዋ። <verse eid="ROM 11:23"/><verse number="24" style="v" sid="ROM 11:24"/>ስኑንታኖ ንቶ አዛብኒ ሜያ ቴስቶንትሲክ ቡርእኡ ድ ቡናሲ ዋአ ስንና ፋኒ ንቶ ጎርጉ ድ ቡና ስኖይ ድማስታ ቶክቶ ችምቴትኔን ሀን ባሶ ቴስቶቤሲሲክ ጎርጉኪ ቡንኒ ዋአ ስና አይሁድኒ ሜያ ዎል ሌ ዜሞቲ ድምቤሲስታ ኣካክ ቶክቶ ቤዮነሪንሶ? <figure style="fig" alt="Olive tree with its fruits" file="LB00087B.tif" size="span" ref="11:24">ጋንባሬሬ ቡርኡኒ ቡና </figure><verse eid="ROM 11:24"/></para>
  <para style="s1">ሀኦስ አሱ ዙታምቤሲሴ አሲክዋ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25"/>አይታሳክቶኖ!፦ «እንኖ አሩዋ» ይት ቴቶቲታዋ። ታ ንቶክ ማኮና እሳ ኣቾ ቾዋ ፋርዋ፤ ኤሲስ ደይ እስራኤልኒ ሜያስን እሳ እሳይስ ንብቤሲስ ችምናስ ሀኦስ ቴጌና አዛብኒ ሜያ ዙቴሬ ሀኦስኪ ዎልሶነ ካባኔጝዋ። <verse eid="ROM 11:25"/><verse number="26" style="v" sid="ROM 11:26"/>ኤሴ ኤስ ባርክ እስራኤልኒ ዳራኒ ሜያ ዙቴሬ ፋሩሶነዋ። ኤካ ደይ ይስቴራ ትቼዋ፤</para>
  <para style="q1" vid="ROM 11:26">«ፋቱኒር ፂዮኑን ዮናዋ፤</para>
  <para style="q2" vid="ROM 11:26">ያቆብን ዛላ ዙታምባሴ አሲስን ማንጉሶን ውዛሶን ትሽኩናዋ።<verse eid="ROM 11:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27"/>ቦርእቤሲሶን ትሽክፋና ካባሲክ፤</para>
  <para style="q2" vid="ROM 11:27">ባሶኔን አነ ግሩና፤</para>
  <para style="q2" vid="ROM 11:27">ቴያኒ ካማስ ሀኒስዋ።»<verse eid="ROM 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28"/>እስራኤልኒ ሜያ ምስራቹኒ ካማሶን ኤጴቶ ቤዮቤሲሲክ ንቶ አዛብኒ ሜያኖን ፋራዶክ ባሶ ሀኦሲ ጉማ ስንነቴዋ። ስኑንታኖ ሀኦስ ባሶትን ኮሩባስታን ካብ ቾዋ አሲቴሴሪስ አባኒ ሜኒ ቦርአ ባሶ ሀኦሲ ዞሞዋ። <verse eid="ROM 11:28"/><verse number="29" style="v" sid="ROM 11:29"/>ሀኦስ ኮሪራ ኦቱምባሲ እማኖን ባሶክ እምናኔን ኦርፎ ዛግና ዉዛሲክ ሳፋራባሲክ ኣነ ጋቤፋዋ። <verse eid="ROM 11:29"/><verse number="30" style="v" sid="ROM 11:30"/>ንቶ አዛብኒ ሜያ ዜሞ ሀኦሲክ አጃጃሞኖር ስንና ፋትርዋ። ስኑንታኖ ሀሽ አይሁድኒ ሜያ አጃጃሞ ቤየቴ ቦርአ ንቶ ፋክያ ዳነትዋ። <verse eid="ROM 11:30"/><verse number="31" style="v" sid="ROM 11:31"/>ንቶ ፋክያ ዳነሴትስነ ፋሮን ባሶ ደይ ፋክያ ዳኖነክ ሀሽ ባሶ ሀኦሲክ አጃጃሞኖር ስንነቴ። <verse eid="ROM 11:31"/><verse number="32" style="v" sid="ROM 11:32"/>ሀኦሲ ፋክባሶን አሱ ዙታምባሴ አሲክ ቤሱናክዋ እያት አሱኒ ሜያኖን ዙትራ አጃጃሞ ቤዮቤሲሲክ ታቶ ስኖነክ ዛጊዋ።<verse eid="ROM 11:32"/></para>
  <para style="s1">ሀኦሲክ እምቴ ጋላታ</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33"/>ሀኦሲ ቴቹምነዋ አሩነ አዉነ ፋሮን አካማንሶ! ማጝሱኒ ካርባስ ደይ ቱእኑስቶኖርዋ፤ ኡጉንባስ ደይ ኣነ አሪቴፋዋ!<verse eid="ROM 11:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34"/>«ዳሚሳ ሳፋራኖን አሪፌር ኦንሶ?</para>
  <para style="q2" vid="ROM 11:34">ባሪን ኪቱኒር ኦንሶ?»<verse eid="ROM 11:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35"/>«ሀኦሲክ ልቄሳት ልቄሲና ባሮን ዎልግሬ ኤጵኒር ኦንሶ?»<verse eid="ROM 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36"/>ዙታምባሴ ያናስ ባርኪን፥ ባርኪ ካሞናዋ ባርኪንናዋ። ኮእባ ፎንቶኖን ባሪክ ኡልፍና ስንፋውጝዋ፤ ኣሚን!<verse eid="ROM 11:36"/></para>
  <chapter eid="ROM 11"/>
  <chapter number="12" style="c" sid="ROM 12"/>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1"/>ኤሴ አይታሳክቶኖ! አቱንቲሶን ሀኦሶን ግርሱኒ ሀየዋ እማነዋ ኮርቶ ማአነ ዛግራ ሀኦሲክ እማትክ ሀኦሲ ጋራማክ ሺጵፋዉጝዋ። ኤስ ባር ደይ ማአ ንብንትስን ኬስፋ ፉቶኒ ሀኦኒ ሺጶሴዋ። <verse eid="ROM 12:1"/><verse number="2" style="v" sid="ROM 12:2"/>ማአ ዉዛሴዋ ግርሱኒ ዉዛሴ ደይ ቱማ ስና ሀኦሲ ፍቃድኖን አሩ ችማትክ ካኑንትሶን ጋድዶሱክ ንብንቲሲ ሳፋራክ ሶልቶትታኖ ሀን ዳስታኪ አሱኒ ሜያነ ፌር ስናቲታዋ። <verse eid="ROM 12:2"/><verse number="3" style="v" sid="ROM 12:3"/>ደይ እሳ እሳርኒቲስ ሀኦስ ንቶክ እምና አማንቶሲማቶ ሹጳክ ሳፋሮትታኖ ንቶክ ሾልስስታን ደናሎ ቴትንትሲክ ቤጋንቶክ ሳፋሮቲታ ይራ ታክ እምቴ ሀኦሲ ኦትማክ ማኬፋውጙዋ። <verse eid="ROM 12:3"/><verse number="4" style="v" sid="ROM 12:4"/>እሳ አቱኒስታ ሾዎ ብልቲ ፋርዋ፥ ኤስ አቱኒሲ ብልት ደይ ቴትባ ቴትባሲክ ኦማ ኦማ ዎስቶባ ፋርዋ። <verse eid="ROM 12:4"/><verse number="5" style="v" sid="ROM 12:5"/>ኤሲስማቶ ደይ እንኖ ሾዎ ስንፋት ክርስቶስኒክ እሳ አቱ ስንኒዋ። እሳ አቱኒ ብልት ስንኒ ቦርአ እኖትና እኖትና ደይ እሳርዋ። <verse eid="ROM 12:5"/><verse number="6" style="v" sid="ROM 12:6"/>ኤስ ባሪ ቦርኣ ሀኦስ ኦቱምባሲክ እኖክ እምና ሾዎ ቴሳ እማሶን ዎስቶታ ፌሹንዋ። ኤስ እኖክ እምቴ እማስ ሀኦሲ ካማኖን አዋሱ ስንፋናነ አማንቶኒስማቶ ሀኦሲ ካማኖን አዋሱኒዋ። <verse eid="ROM 12:6"/><verse number="7" style="v" sid="ROM 12:7"/>እኖክ እምቴ እማስ ኦምኒ ሜያኖን አርጋሱ ስንፋናነ ችምማ አሪጋሱኒዋ። እኖክ እምቴ እማስ አሱኒን አስሱ ስንፋናነ ማእስራ አስሱኒዋ። <verse eid="ROM 12:7"/><verse number="8" style="v" sid="ROM 12:8"/>እኖክ እምቴ እማስ ችኑ ስንፋናነ ችኑንዋ፥ እኖክ እምቴ እማስ አሱኒክ እማ ስንፋናነ ማአ ንባክ እማንዋ። እኖክ እምቴ እማስ ሀእሱ ስንፋናነ ችማ ሀእሱኒዋ፥ እኖክ እምቴ እማስ ኬናሽቶ ስንፋናነ ኤስ ባሮን ደይ ግራክ ዛጉንዋ። <verse eid="ROM 12:8"/><verse number="9" style="v" sid="ROM 12:9"/>ስንኖይ ስንና ቤስቶኒ ኡባ ፎንቶኖን ፉቶኒ ኬሽታናንት ፎንዋ። ማጙ ዉዛሶን ኦምቶት፥ ማአ ስና ዉዛስኔን አነ እሳር ስንት። <verse eid="ROM 12:9"/><verse number="10" style="v" sid="ROM 12:10"/>ንቶትና ንቶትና አይና አይና አሲ ኬሽታናሲክ ዎል ሹኖት። ንቶትና ንቶትና ዎል ኡልፍንሱክ ታፕቶት። <verse eid="ROM 12:10"/><verse number="11" style="v" sid="ROM 12:11"/>ሆፑኖይ ጉዙ አያናሲክ ዞኑስቴራ ዳሚሲክ ዎስቶት። <verse eid="ROM 12:11"/><verse number="12" style="v" sid="ROM 12:12"/>አብዲሲክ ግሮትዋ፥ ሻና ያና ዎኖ ፋኩት። ዎንና ዎንና ሽጶት። <verse eid="ROM 12:12"/><verse number="13" style="v" sid="ROM 12:13"/>አማኝ አይኝኒ ሜያኖን ራኮቤስሲሲክ አሪጋሱት። እርባ ስንነ የ ባሶትን ኤጳ እርባሱት። <verse eid="ROM 12:13"/><verse number="14" style="v" sid="ROM 12:14"/>ንቶትን ካብግፌ ባሶትን ሱስት፥ ሱስትታኖ ኤርዉቲታ። <verse eid="ROM 12:14"/><verse number="15" style="v" sid="ROM 12:15"/>ግሬፌ ባሶኔን አነ ግርሶት፥ ዋስሴፌ ባሶኔን አነ ዋሱሶት። <verse eid="ROM 12:15"/><verse number="16" style="v" sid="ROM 12:16"/>ንቶትና ንቶትና እሳ ሳፋራክ እሳር ስንና ፎቲ። ቴትንትሶን ቴጉክ ቤጋንቶሶን ቤይያ ቱካምኒ ሜያኔን አነ እሳሪክ ፎሶት፥ ቴትንትሲክ እንኖ አሩዋ ኡትታ። <verse eid="ROM 12:16"/><verse number="17" style="v" sid="ROM 12:17"/>አሱ ዙታምባሴ አስ ስናክ ማአር ስና ዉዛሶን ዛጉትታኖ አሱኒ ሜያ ንቶስታ ማጙ ዉዛ ዛግሴፌ ካባሲክ ዎልግራ ማጙ ዉዛ ባሶስታ ዛጉትታ። <verse eid="ROM 12:17"/><verse number="18" style="v" sid="ROM 12:18"/>ንቶክ ችምቴር ስንፋናነ አሱ ዙታምባሴኔን አነ ናጋክ ፎትክ ንቶኪን ሾልሲ ዉዛሶን ዙትራ ዛጉሶት። <verse eid="ROM 12:18"/><verse number="19" style="v" sid="ROM 12:19"/>ኮንታሳክቶኖ! ግአሶን ሀኦሲክ ቤይትታኖ ንቶ ዎል ላ ጉማ ካስቶትታ፦ «ጉማ ካስቶኒስናዋ ጉማኒ ቆዋሶን ዎልጉኒስና ታዋ ይፋዋ ዳማ ሀኦስ» ይስቴራ ትቼዋ። <verse eid="ROM 12:19"/><verse number="20" style="v" sid="ROM 12:20"/>ኤስ ባሪ ቦርኣ ጉማኒ ካስቶስታን ጉማኔስ ማክቴፋናነ ማሱ እክቴፋናነ ደይ ኡሹ፥ ኤስ ባሮን ዛጉኔሲክ ቴትባስታ ኢችቻንኒ ጌያ ዎቱታዋ። <verse eid="ROM 12:20"/><verse number="21" style="v" sid="ROM 12:21"/>ማጙ ዉዛሶን ማአሪክ ሜሮታኖ ማጙ ዉዛሲክ ሜርቶታታዋ።<verse eid="ROM 12:21"/></para>
  <chapter eid="ROM 12"/>
  <chapter number="13" style="c" sid="ROM 13"/>
  <para style="s1">ሀእሲፌ ባሶክ አጃጃሞ ሾልስር</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1"/>ኣፋ ሀእሱሲኑ ስኑን እምቴፋናስ ሀኦሲ ፍቃድክ ስንና ቦርአናዋ ሀሽ ደይ ፌሴ አእስኛኒ ሜያ ታቴሴቴስ ሀኦሲክ ስንና ቦርአና አሱ ዙቴሬ ባሳ ደናሎክ ሀእሲፌ ባሶክ አጃጃሞናክ ሾልሱዋ። <verse eid="ROM 13:1"/><verse number="2" style="v" sid="ROM 13:2"/>ኤስ ባሪ ቦርኣ ሀእሲፌ ባሶትን ቱጋኤፌ ባር ዙቴሬ ሀኦሲ አጃጅኖንቱ ቱጋኤፌዋ፥ አጃጃሞ ቤይፌ ባር ደይ ባሳስታቱ ኬኦ ኤጴ ዬፌዋ። <verse eid="ROM 13:2"/><verse number="3" style="v" sid="ROM 13:3"/>ሀእሲፌ ባሶ ድግቴሴፌስ ማጙ ዉዛ ዛግሴፌ ባሶክታኖ ማአ ዉዛ ዛግሴፌ ባሶክታዋ። ሀእሲፌ ባሶትን ድጎ ቤያ ሾሌፋቶሶ? ኤሴ ማአ ዉዛ ዛጉዋ፥ ባሶኪን ደይ ጋላታ ዳናታዋ። <verse eid="ROM 13:3"/><verse number="4" style="v" sid="ROM 13:4"/>ሀእሲፌ ባር ኔክ ማአ ዉዛ ዛጉናክ ታትቴ ሀኦኒ ዎስትኛዋ። ሀእሲፌ ባር ሲፎ ታርኤናስ ሽማክ ስና ቤይና ቦርአ ማጙ ዉዛ ዛግታር ስኒፋታነ ባሪን ድጎዋ። ባር ማጙ ዉዛ ዛግፌ ባሶትን ኬኡክናዋ ሀኦሲ ጉማኒ ካስቶኖን ቤሱናክና ሀኦሲ ዎስትኛዋ። <verse eid="ROM 13:4"/><verse number="5" style="v" sid="ROM 13:5"/>ኤስ ባሪ ቦርኣ ደይ ሀኦሲ ኬእኦኖን ድጎስ ኮእባ ስኖይናሮን፥ ሃላንትስ ንቶትን ዌኦና ቦርአ ሀእሲፌ ባሶክ ሀኡ ሾልሱዋ። <verse eid="ROM 13:5"/><verse number="6" style="v" sid="ROM 13:6"/>ግርቦ ካስፌትስ ደይ ኤስ ባሪ ቦርኣዋ፤ ሀእሲፌ ባሶ ኤስ ዎስቶሶን ዎስቴሴፌስ ሀኦሲክ ዎስቶክዋ። <verse eid="ROM 13:6"/><verse number="7" style="v" sid="ROM 13:7"/>እሳርባ እሳርባሲክ ሾልስ ዉዛሶን ዛጉትዋ። ግርቦ ግርቦትክ ሾልስና ባርክ ግርቦ ግርቦት፤ ካራጣ ሾልስና ባርክ ካራጣ ካሱት፤ ድጎትክ ደይ ሾልስና ባሪን ድጎት፤ ኡልፍና ሾልስና ባርክ ኡልፍና እምት።<verse eid="ROM 13:7"/></para>
  <para style="s1">ንቶትና ንቶትና ዎል ኬሽቶሶት</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8"/>ንቶትና ንቶና ዎል ኬሽቶሶትታኖ ኦኒ ኮዋኑ ንቶስታ ፎናታዋ፤ ኤስ ባሪ ቦርኣ አሱስን ዙትሬ ሹንፌ ባር ቱማሶን ዛግዋ። <verse eid="ROM 13:8"/><verse number="9" style="v" sid="ROM 13:9"/>«ጌርኬሳታታ፥ ዎሩታታ፥ ዊሶታታ፥ ኤናንቶታታ» ይፋ አጃጅሴዋ ኦማ ኦማ አጃጂሲክቶነ ዙቴራ፦ «አሱ ዙታምባሴ አሲን ነ ነ ቴታሶን ሹንፋታይስማቶ ሹጝዋ» ይፋ እሳ አጃጂሲ ዙቴራ ግሪዋ። <verse eid="ROM 13:9"/><verse number="10" style="v" sid="ROM 13:10"/>አሱስን ሹንፌ ባር ኤስ ሹና አሱሳታ ማጙ ዉዛ ኣነ ዛግፌዋ። ኤስ ባሪ ቦርኣ አሱኒን ሹንፌ ባር አጃጂሶን ዙትሬ ዛጊዋ ኡዋ። <verse eid="ROM 13:10"/><verse number="11" style="v" sid="ROM 13:11"/>ኤሴ አፋይኒታን ጉዙት ዎናስ ሀሽ ካርእናማቶ አሩትዋ። ዜሞቲ አማነኒ ዎናስታን ሀሽቲ ፋሩኒ ዎናስ ማእስራ ያራ እኖኪ ካርእዋ። <verse eid="ROM 13:11"/><verse number="12" style="v" sid="ROM 13:12"/>ዋላስ ኣትድፋር፤ ዎናስ ደይ ያራ ታእ፤ ኤስ ባሪ ቦርኣ ታልማሲ ዎስቶኖን ቤያ ቻሬፋሲ ኔቦኒ ሜያሶን ማያኒዋ። <verse eid="ROM 13:12"/><verse number="13" style="v" sid="ROM 13:13"/>ያሆክናዋ ኡሼ ዛዎክና ጌርኬሳክናዋ ዎጆቾክና ፋሶክናዋ ማጙ ኮናክና ስኖይናሮን ዎናሲ ቻሬፋሲ ፌፌ አሱኒ ሜኒማቶ ማአሪክ ፎሶትዋ። <verse eid="ROM 13:13"/><verse number="14" style="v" sid="ROM 13:14"/>ኤስ ባሪ ቦርኣ ዳም የሱስ ክርስቶስኒን ማይትታኖ አሽንትሲ ካልታናኖን ቱኑክ ሳፋሮቲታዋ።<verse eid="ROM 13:14"/></para>
  <chapter eid="ROM 13"/>
  <chapter number="14" style="c" sid="ROM 14"/>
  <para style="s1">አሱኒስታ ማጝሱ ካርአትታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1"/>ንቶ ጋነያሲ አማንቶባሲሲክ ሆፕ ስና አሱስን ኤጳቶትታኖ ባሳ ቴትኒ ሳፋራስታ ካራካሮቲታ። <verse eid="ROM 14:1"/><verse number="2" style="v" sid="ROM 14:2"/>እሳ ቤሶ ብያኒዋ፦ እሳ አሱ ቤስቴ ዉዛሶን ዙትሬ ሙናክ ችኑኒ አማንቶባ ፎና ሲናናዋ። ስኑንታኖ አማንቶባሲክ ዛጉ ቤያ ባር ቶክቴ ቶኮ ባር ባሮንቱ ሜፌዋ፤ <verse eid="ROM 14:2"/><verse number="3" style="v" sid="ROM 14:3"/>ባሪን ሀኦስ ኤጳታ ስንና ቦርአ ቤስቴ ዉዛሶን ዙትሬ ሜፌ ባር ሙኖይ ባሪን ካሹናታዋ፤ ሙኖይ ባር ደይ ሜፌ ባሳስታ ማጝሱ ካርአናታዋ። <verse eid="ROM 14:3"/><verse number="4" style="v" sid="ROM 14:4"/>ኤካን ኦም አሱሳ ዎስትኛኒታ ማጝሱ ካርእፌስ ነ ኦንሶ? ባር የሬፌናክ ወደይ ጋንደፌናክ ዳምባሳ ግሮዋ፤ ደይ ዳሚስ ባሪን ዬቱክ ችማና ስንና ቦርአ ችሜ የሮናዋ። <verse eid="ROM 14:4"/><verse number="5" style="v" sid="ROM 14:5"/>ኤሲስማቶ እሳ ዎናስ ኦማ ዎናስታን ደናሎ ኡልፍንቶ ዛግሬ ሳፋሬፌር ፎናክ ችማና ስናናዋ፤ ኦሚስ ደይ ዎናስ ዙቴራ እሳ ኪጤ ኡልፍንባቱ ፋርታኖ ዎናሲክቶኒ ጋነስን ኦርባ ኦርባ ኣፋዋ ይሬቱ ሳፋሬፌ ሲናናዋ። ኤሴ ኤስ ባርነ ፋ ዉዛሲክ አሱ እሳርባ እሳርባሲክ ንብባሲ ሳፋሬናይስማቶ ዛጉዎዋ። <verse eid="ROM 14:5"/><verse number="6" style="v" sid="ROM 14:6"/>እሳ ዎናሶን ኦማ ዎናስታን ደናሎ ዛግሬ ኡልፍንስፌር ፌፋናነ ዳሚሳ ኡልፍናክዋ እያትዋ። ቤስቴ ሙሶን ዙትሬ ሜፌ ባር ዳሚሳ ኡልፍናክዋ እያቱ ሜፌዋ፥ ሜፌና ሙሲክ ደይ ዳሚስን ጋላቴፌ። ቤስቴ ሙሶን ዙትሬ ሙኖይ ባር ዳሚሳ ኡልፍናክዋ እያት ኣነ ሜፌዋ። ኤስ ሙ ቤይባሲክ ደይ ሀኦሶን ጋላቴፌዋ። <verse eid="ROM 14:6"/><verse number="7" style="v" sid="ROM 14:7"/>እንኖስን ቴትባሲክ ክትፌር ወደይ ቴትባሲክ ካክ ፌፌር ኣፌዋ። <verse eid="ROM 14:7"/><verse number="8" style="v" sid="ROM 14:8"/>ፋፋኒነ ዳሚሲክቱ ፎኒ፤ ኪትፋንነ ደይ ዳሚሲክቱ ኪቱኒ። ኤስ ባሪ ቦርኣ ክትፌኒክ ካክ ፋፌኒክ እንኖ ቴትኒሲክኑ ዳሚሳርዋ። <verse eid="ROM 14:8"/><verse number="9" style="v" sid="ROM 14:9"/>ኤስ ባሪ ቦርኣ ክርስቶስ ክትሬ ክቱን ካብናስ ሀየዉኒ ሜያክናዋ ክቱኒ ሜያክና ዳም ስናናክዋ። <verse eid="ROM 14:9"/><verse number="10" style="v" sid="ROM 14:10"/>ኤካን ነ አይኔሳታ አዋጋን ማጝሱ ካርእፋስሶ? ወደይ አዋጋን አይኔስን ካሽፋስሶ? እንኖ ዙታምኒሴ ሀኦሲ ማጝሱኒ ካርእኒ ኮዳሲ ስንታ ዬሮኒርዋ። <verse eid="ROM 14:10"/><verse number="11" style="v" sid="ROM 14:11"/>ደይ ማፃፋስሲ፦</para>
  <para style="q1" vid="ROM 14:11">« ‹ታ ሀየዋዋ› ይፋዋ ሀኦስ፤</para>
  <para style="q2" vid="ROM 14:11">ኬኣስ ዙቴራ ታ ስና ካኖናዋ፤</para>
  <para style="q2" vid="ROM 14:11">ቴርማስ ደይ፤</para>
  <para style="q2" vid="ROM 14:11">ታ ሀኦ ስንናማቶ ታክ ዛላ ማኮናዋ»</para>
  <para style="m" vid="ROM 14:11">ይስቴራ ትቼና ቦርአዋ።<verse eid="ROM 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 14:12"/>ኤስ ባሪ ቦርኣ እንኖ እሳርኒ እሳርኒስ ቴትኒሲ ዎስቶክ ሀኦሲ ስና ታአ ዎልጉባ እማኒርዋ።<verse eid="ROM 14:12"/></para>
  <para style="s1">አሱኒክ ቱሳ ስና ኣነ ሾልስፋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13"/>ኤስ ባሪ ቦርኣ እሳርኒስ ኦሚሳታ ማጝሱ ካርእአንታዋ፤ ስኑንታኖ ኦኑ አይባሳ ኡጉንታ ጋንሱኒ ዉዛ ወደይ ቱሳ ዱሱኖይናማቶ ቴትባሶን ኦዶዋ። <verse eid="ROM 14:13"/><verse number="14" style="v" sid="ROM 14:14"/>እሳ ዉዛ ዝናዋ ይሬ ሳፋሬፌ አሱ ኤስ ዉዛስ ባርክቱ ዝና ስናናታኖ ኣፍፋ ዉዛስኑ ቴትባሲክ ኪና ስና ቤይናማቶ ታ ዳም የሱንኪ ካሞ ማእስራ አሪጝዋ። <verse eid="ROM 14:14"/><verse number="15" style="v" sid="ROM 14:15"/>ነ ማፋታ ሙሲ ቦርአ አይኔሲክ ቱሳ ስናታር ስንፋናነ ኬሽታናስ ነይስ ኣፋዋ ኡዋ፤ ኤስ ባሪ ቦርኣ ክርስቶስ ባርክ ክትና አሱስን ማፋታ ሙሲ ቦርአ ትሹናክ ዛጉታታዋ። <verse eid="ROM 14:15"/><verse number="16" style="v" sid="ROM 14:16"/>ኤሴ ንቶኪክ ማአሪ ስና ዉዛሶን ኦምኒ ሜያ ካሹሶነክ ዛጉቲታዋ። <verse eid="ROM 14:16"/><verse number="17" style="v" sid="ROM 14:17"/>ሀኦሲ ታቶ ኮርቶ አያናክ ቤስቴፋ ኦኮ፥ ናጋነዋ ግራነታኖ ሙነዋ ኡሽነ አሲ ቾዋታዋ። <verse eid="ROM 14:17"/><verse number="18" style="v" sid="ROM 14:18"/>ኤሲስማቶ ክርስቶስኒክ ዎስቴፌ አሱ ሀኦሶንቱ ግርስፌ፥ አሱኒ ስናክ ደይ ጋላታምቶዋ። <verse eid="ROM 14:18"/><verse number="19" style="v" sid="ROM 14:19"/>ኤስ ባሪ ቦርኣ ናጋስ ቤስቴፋና ዉዛሶንናዋ እኖትና እኖትና ዎል ችማኒ ዉዛሶንና ሾሎኒዋ። <verse eid="ROM 14:19"/><verse number="20" style="v" sid="ROM 14:20"/>ሙኒ ቦርአ ሀኦሲ ዎስቶኖን ቦጋኒታዋ። ሙስ ዙቴራ ካይማዋ፤ ስኑንታኖ ኦም አሱስን ቱሳሱን ሙሶን ሙስ ልኪታዋ። <verse eid="ROM 14:20"/><verse number="21" style="v" sid="ROM 14:21"/>ኤስ ባሪ ቦርኣ አይኔስን ቱሳእሱኖይታማቶ አሻ ሙ ቤያ ወደይ ዋይንኒ ኡሻ ኡሻ ቤያ ወደይ ኣፍፋ ቱሳእሱኒ ዉዛ ዛጉ ቤያስ ማአሪዋ። <verse eid="ROM 14:21"/><verse number="22" style="v" sid="ROM 14:22"/>ኤሴ ሀን አማንቶኔስ ኔናዋ ሀኦሴ አሲ ጋነያሲ ስንኑጝዋ፥ ልኪዋ ይሬ አማነና ዉዛሶን ዛግን ካኑባስ ዌኦኖይና አሱ ጋላታምቶዋ። <verse eid="ROM 14:22"/><verse number="23" style="v" sid="ROM 14:23"/>ስኑንታኖ አዉዛክነ ይፌት ሜፌ አሱስ ዛግና ዉዛስ አማንቶክ ስና ቤይና ቦርአ ማጝሱ ባሳስታ ካቴርዋ፥ አማንቶክ ዛግቶኖይ ዉዛስ ዙቴራ ደይ ቦርአዋ።<verse eid="ROM 14:23"/></para>
  <chapter eid="ROM 14"/>
  <chapter number="15" style="c" sid="ROM 15"/>
  <para style="s1">አሱኒ ሜያኖን ግርሱ ሾልሲር</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1"/>አማንቶክ ችም ስና እንኖ ሆፕኒ ሜኒ ሆፕያሶን ዎርአኒክቱ ሾልስፋታኖ እንኖ ቴትኒሶን ግርሱኒክ ኣነ ሾልሲፋዋ። <verse eid="ROM 15:1"/><verse number="2" style="v" sid="ROM 15:2"/>እሳርን እሳርኒስ ኦም አሱስን አማንቶባሲክ ችማናክ ባርክ ኬእኒ ዉዛሴዋ ባሪን ግርሱኒ ዉዛሴ አስን ዛጉኒዋ። <verse eid="ROM 15:2"/><verse number="3" style="v" sid="ROM 15:3"/>ክርስቶስ ቴትባሶን ኣነ ግርሱዌዋ፤ ስኑንታኖ ኮርቶ ማፃፋስሲ፦ «አሱኒ ሜያ ኔን ሜኤቴ ሜኣስ ታይስታቱ ካርእዋ» ይፋ ካማ ባሳስታ ካርእዋ። <verse eid="ROM 15:3"/><verse number="4" style="v" sid="ROM 15:4"/>ኮርቶ ማፃፋሲን ዳንፌኒ ፋክያሴዋ ችኑሴ አብድን ፎናክ ዜምማ ትቼናስ እኖትን አሱክዋ። <verse eid="ROM 15:4"/><verse number="5" style="v" sid="ROM 15:5"/>ፋክነዋ ችኑነ እምፋ ሀኦስ ንቶትና ንቶትና ዎል ክርስቶስ የሱስኒ ቤሶሲክ ዞኑስቶትክ ኦሚስኔን እሳር ስንነ ፎሶን ንቶክ እማጝዋ። <verse eid="ROM 15:5"/><verse number="6" style="v" sid="ROM 15:6"/>ኤስ ባር ስንናስ ዳምኒ የሱስ ክርስቶስኒ አባ ሀኦሶን እሳ ንባክናዋ እሳ ካማክና ኡልፍንሱትክዋ።<verse eid="ROM 15:6"/></para>
  <para style="s1">ምስራቹኒ ካማስ አዛብኒ ሜያክ ማክቴ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7"/>ክርስቶስ ሀኦሲ ኡልፍናክ ንቶትን ኤጴቴናማቶ፥ ንቶ ዙታምንትሴ ደይ እሳይስ ኦሚስን ኤጳቶሶት። <verse eid="ROM 15:7"/><verse number="8" style="v" sid="ROM 15:8"/>ሀን ታ ማኬፋናስ ሀኦስ ዜምማ አባን ሜያክ ግሪና ቴያኒ ካማስ ኮኡናክ ሀኦሲ ፉቶክዋ እያት ክርስቶስ አይሁድኒ ሜኒ ዎስትኛ ስኒዋ። <verse eid="ROM 15:8"/><verse number="9" style="v" sid="ROM 15:9"/>ደይ አዛብኒ ሜያ ሀኦሶን ፋኪባሲክ ጋላቶሶነክዋ። ትቻስስ፦</para>
  <para style="q1" vid="ROM 15:9">«ኤስ ባሪ ቦርኣ አዛብኒ ሜኒ ጋነያሲ፤ ኔን ጋላቶናዋ፤</para>
  <para style="q2" vid="ROM 15:9">ሱኔሲክ ደይ ጋማክ ጋላታ እማናዋ»</para>
  <para style="m" vid="ROM 15:9">ይስቴራ ትቼናስማቶዋ። <verse eid="ROM 15:9"/><verse number="10" style="v" sid="ROM 15:10"/>ደይ፦</para>
  <para style="q1" vid="ROM 15:10">«ንቶ አዛብኒ ሜያነ!</para>
  <para style="q2" vid="ROM 15:10">ሀኦሲ ዳራኔን አነ ግሮትዋ»</para>
  <para style="m" vid="ROM 15:10">ይስቴራ ትቼዋ። <verse eid="ROM 15:10"/><verse number="11" style="v" sid="ROM 15:11"/>ሄፕሳ ደይ፦</para>
  <para style="q1" vid="ROM 15:11">«አዛብኒ ሜያነ!</para>
  <para style="q2" vid="ROM 15:11">ዙቴራ ዳሚስን ጋላቶትዋ፤</para>
  <para style="q2" vid="ROM 15:11">ዳራስ ደይ ዙቴራ ዳሚስን ጋላቶትዋ»</para>
  <para style="m" vid="ROM 15:11">ይስቴራ ትቼዋ። <verse eid="ROM 15:11"/><verse number="12" style="v" sid="ROM 15:12"/>ኤሲስማቶ ደይ ራጁ ኢሳያስ ደይ፦</para>
  <para style="q1" vid="ROM 15:12">«እሴይኒ ዛላስን ኮንቶኒር ዮና፤</para>
  <para style="q2" vid="ROM 15:12">አዛብኒ ሜኒ ዞንሲ ስናናክ ካቡና፤</para>
  <para style="q2" vid="ROM 15:12">ባሶ ደይ አብድቤሲሶ ባሳስታ ዛግክሶነ» ይፋዋ።<verse eid="ROM 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13"/>ንቶ አብዲስ ኮርቶ አያናሲ ሁግናክ ድቼት ሀማናክ አብድን ሀኦሶን አማንቶንቲሲክ ግራነዋ ናጋነ አስን ቱንራ ንቶክ እማጝዋ።<verse eid="ROM 15:13"/></para>
  <para style="s1">ጳዉሎስ ድጋባ ፎንቶኖን ትችና ዉዛሲ ቾዋ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14"/>አይታሳክቶኖ! ማአክ ቱማ ንቶ፤ ቱማ አሩክ ቱሜሴቲስ፤ እሳይስ ኦሚስን ኪቱክ ችማትክ ስንናማቶ ታ አሪጝዋ። <verse eid="ROM 15:14"/><verse number="15" style="v" sid="ROM 15:15"/>ሀኦ ታክ እምና ኦትማሲማቶ ንቶትን ያዳሱናክ ሾሌፋት እሳ እሳ ቾዋ ድጋባ ፎንቶኖን ትችጝዋ። <verse eid="ROM 15:15"/><verse number="16" style="v" sid="ROM 15:16"/>ሀን ሀኦሲ ኦትማ ታክ እምቴናስ ሀኦሲ ምስራቹኒ ካማኖን አዛብኒ ሜያክ ማኮናክ ማግኒማቶ ስና ክርስቶስ የሱስኒክ ዎስቶናክዋ። ኤሲስ ደይ አዛብኒ ሜያ ኮርቶ አያናክ ኮርቴሴሬናዋ ሀኦሶን ደይ ግርሱኒ ማአ ስንነሬና ታእሶሶነክቱ ዎስቴድፋዉጝዋ። <verse eid="ROM 15:16"/><verse number="17" style="v" sid="ROM 15:17"/>ኤስ ባሪ ቦርኣ ክርስቶስ የሱስኒኪ ካሞ ሀኦሲክ ዎስቶናክ ችምናሲክ ቴቴፋዉጝዋ። <verse eid="ROM 15:17"/><verse number="18" style="v" sid="ROM 15:18"/>አዛብኒ ሜያ አጃጃሜር ስኖነክ ዛጉናክ ክርስቶስ ታ ካማሲክናዋ ታ ዎስቶሲኪ ካሞና ዎስቴና ዉዛሶንታኖ ኦማ እሳ ዉዛነ ማኮናክ ኣፋ ችማናዉዛ። <verse eid="ROM 15:18"/><verse number="19" style="v" sid="ROM 15:19"/>ኤሲስማቶ ደይ አካማ አካማ ቢስቴራ አሪቶኖይ ዉዛሲክናዋ ዲንቂ ዎስቶሲክቶክና ደይ ኮርቶ አያናሲ ሁግናክና የሩሳለሙን ካብራ ኤልዋርቆኒ ብራቶስታ ካርአ ክርስቶስኒ ምስራቹኒ ካማሶን ማኬጝዋ። <verse eid="ROM 15:19"/><verse number="20" style="v" sid="ROM 15:20"/>ዎንና ዎንና ካልቴፋናስ ደይ ኦም አሱ ካፑትና ካፕታስታ ኬርአናክ ስኖይናሮን ክርስቶስኒ ሱናስ ቴግቶኖይና ድማ ዙታምባሴ አሲስ ምስራቹኒ ካማሶን ማኮናክዋ። <verse eid="ROM 15:20"/><verse number="21" style="v" sid="ROM 15:21"/>ኤሲስ ደይ፦ «ዜሞ ስናክ ባሳ ቾዋሶን ማክቶኖይና አሱኒ ሜያ ብዮነ፤ ባሳ ቾዋሶን ኦዶኖይ ባሶ ደይ ያዳቶሶነ» ይስቴራ ትቼናስማቶዋ።<verse eid="ROM 15:21"/></para>
  <para style="s1">ጳዉሎስ ሮም ሀማናክ ኮፓኤ</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22"/>ሀሽኔን ካርአ ንቶኪ ዮኖይናማቶ ሾዎ ዎና ካልቴጝዋ። <verse eid="ROM 15:22"/><verse number="23" style="v" sid="ROM 15:23"/>ስኑንታኖ ሀሽ ሀን ብራቶስታ ፋሴ ዳስታክ ዎስቶናሶን ኮእስና ቦርአ፤ ደይ ሾዎ ነያስታን ካብራ ንቶትን ብያናክ አካማኖን ካልቴት ፋናር ስንና ቦርአ፥ <verse eid="ROM 15:23"/><verse number="24" style="v" sid="ROM 15:24"/>እስፐን ሀሚፋና ካባሲክ ሻቴራ ንቶትን ብያናክ ኮፓኤጝዋ። ጋሮ ዎናኖን ንቶኔን አነ ግራክ ኣትናኔን ኦርፎ ኡጉናሲክ ስንኒ አሪጋሱ ታክ ዛጉትማቶ አብድ ዛግፋዉጝዋ። <verse eid="ROM 15:24"/><verse number="25" style="v" sid="ROM 15:25"/>ስኑንታኖ ሀሽ ሀኦኒ አሱኒ ሜያክ እምቶኒ አሪጋሱኒ ዋጋ ኤጳ የሩሳሌም ሀሚናርዋ። <verse eid="ROM 15:25"/><verse number="26" style="v" sid="ROM 15:26"/>ኤሲስ ደይ ሜቀዶንያክናዋ አክያክና ፌሴ ሀኦኒ አሱኒ ሜያ የሩሳለሙክ ፌሴ ቱካምኒ ሜያክ እምቶኒ አሪጋሱኒ ዋጋ ዎስሶነክ ቡግሬ ካብሴቴ ቦርአዋ። <verse eid="ROM 15:26"/><verse number="27" style="v" sid="ROM 15:27"/>ኤስ አሪጋሱሶን ባሶ ፍቃድክ እሜቴስ ግድ ስንና ቦርአዋ። አዛብኒ ሜያ አይሁድኒ ሜያኔን አነ አያናኒ ኤባ ሃእኤር ስንነቴኔን አዛብኒ ሜያ አሽኒ ፎቤሲሲክ አይሁድኒ ሜያኖን አሪጋሱሶነክ ግድዋ። <verse eid="ROM 15:27"/><verse number="28" style="v" sid="ROM 15:28"/>ኤስ ባሪ ቦርኣ ሀን ዙቴ አሪጋሱኒ ዋጋሶን የሩሳሌም ኤጳ ታማ እምናኔን ኦርፎ ንቶኪ ካሞ እስፐን ሀማናዋ። <verse eid="ROM 15:28"/><verse number="29" style="v" sid="ROM 15:29"/>ንቶኪ ያፋና ካባሲክ ክርስቶስኒ ኤባሶን ዮኡባ ፎንቶ ቱማኖን ኤጳ ዮናማቶ አሪፋውጙዋ። <verse eid="ROM 15:29"/><verse number="30" style="v" sid="ROM 15:30"/>አይታሳክቶኖ! ታ ሀኦኒ ሺጶክ ካቤፋና ካቦናሲክ ታን አሪጋሱትማቶ ዳምኒ የሱስ ክርስቶስኒክናዋ ኮርቶ አያናሲ ኬሽታናክና ንቶትን ሺጴፋዉጙዋ። <verse eid="ROM 15:30"/><verse number="31" style="v" sid="ROM 15:31"/>ኤስ ሺጶንቲስ ደይ ዩዳኒ ዳስታክ ፌሴ አማኖኖይ አሱኒ ሜኒ ኩሹስን ታ ፉእቶናክናዋ የሩሳለሙክ ፋ ዎስቶናሶን ሀኦኒ አሱኒ ሜያ ኤጴቶሶነማቶናዋ። <verse eid="ROM 15:31"/><verse number="32" style="v" sid="ROM 15:32"/>ኤስ ባር ደይ ስንናኔን ኦርፎ ሀኦ እያናነ ግራክ ንቶኪ ያራ ንቶኔን አነ ሀላጋልፋቶናክ ሾሌፋዉጙዋ። <verse eid="ROM 15:32"/><verse number="33" style="v" sid="ROM 15:33"/>ናጋኒ ሀኦስ ዙታምንትስኔን አነ ስንፋውጝዋ፤ ኣሚን!<verse eid="ROM 15:33"/></para>
  <chapter eid="ROM 15"/>
  <chapter number="16" style="c" sid="ROM 16"/>
  <para style="s1">ናጋን ኦሽሾ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1"/>ኪንክራያስኒ ካታማስሲ ፋ ቤቴክርስታኒሲ ዎስቴት ፋ ፌቤን አማናምቶ ኤትኒ ስንባሶን አሩትክ ሾሌፋዉጙዋ። <verse eid="ROM 16:1"/><verse number="2" style="v" sid="ROM 16:2"/>ባር ታንናዋ ኦም ሾዎ አሱኒ ሜያኖንና አሪጋሲር ስንና ቦርአ አማኝኒ እርባኒ ሜያኖን ኤጴቶ ሾልሲፋናይስማቶ ዳሚሳ ሱናክ ኤጳ ታራ ባርክ ሾልሲ ዉዛ ዙታምባሴ አስክ አሪጋሱትክ አዳራ ይፋዉጙዋ። <verse eid="ROM 16:2"/><verse number="3" style="v" sid="ROM 16:3"/>ክርስቶስ የሱስኒ ዎስቶሲክ ታኔን አነ እሳር ስንነ ዎስቴት ፌሴ ፕርሲቂላኒክናዋ አቅላኒክና ናጋናሶን ማክሶትዋ። <verse eid="ROM 16:3"/><verse number="4" style="v" sid="ROM 16:4"/>ባሶ ደይ ዜሞ ስናክ ታ ኤድደ ክቱክኑ ስንፋናክ ሆሬሬ ፌሴቴርዋ። ኤስ ባርክ ደይ ባሶትን ጋላቴፋዉጙዋ። ታ ታ ታ ስኖይናሮን ኣዛብ ስንነፋት ክርስታና ስና አማኝኒ ሜኒ ቤቴክርስታኒሲክቶኔን ባሶትን ጋላቴሴድፌዋ። <verse eid="ROM 16:4"/><verse number="5" style="v" sid="ROM 16:5"/>ባሶኪ ኬር ሀኦኒ ሺጶክ ዙቴሴፌ አማኝኒ ሜያክ ናጋናሶን ማክሶትዋ። ኢስያኒ ዳስታክ ዜምሜ ክርስቶስኒክ አማነ ባርክናዋ ሹንፋና ኤጴነቶስኒክና ናጋናሶን ማኮትዋ። <verse eid="ROM 16:5"/><verse number="6" style="v" sid="ROM 16:6"/>ንቶክ አካማኖን ሆፕ ማራሚክ ናጋሶን ማኮትውኣ። <verse eid="ROM 16:6"/><verse number="7" style="v" sid="ROM 16:7"/>ታኔን አነ ታቴሬ ፌሴ ባሶክናዋ ዎስኒ ሜኒ ጋነያስሲክ አርቶ ስና አይሁድ ስና ኮንታሳክቶኒክና ደይ አንድሮንኮስኒክናዋ ዩንያስኒክና ናጋናሶን ማኮትዋ። ባሶ ክርስቶስኒክ አማኖቤሲሲክ ታይስታን ዜምሜ ፌሴቴርዋ። <verse eid="ROM 16:7"/><verse number="8" style="v" sid="ROM 16:8"/>ዳሚሲክ ሹንፋና አምፕልያቶስኒክ ናጋናሶን ማኮትዋ። <verse eid="ROM 16:8"/><verse number="9" style="v" sid="ROM 16:9"/>ክርስቶስኒ ዎስቶሲክ እኖኔን አነ እሳር ስና ኡርባኖስኒክናዋ ሹንፋና እስታኩስኒክና ናጋናሶን ማኮትዋ። <verse eid="ROM 16:9"/><verse number="10" style="v" sid="ROM 16:10"/>ክርስቶስኒክ ፋ አማንቶባስ ፋታንቴራ ዛላ ማክቴና አጰልስኒክ ናጋናሶን ማኮትዋ። አሪስቶቡሎስኒ ኬርኪ ሜያ ስና ባሶክ ደይ ናጋናሶን ማኮትውኣ። <verse eid="ROM 16:10"/><verse number="11" style="v" sid="ROM 16:11"/>አይሁድ ስና ኮኒታ ሄሮድያንክ ናጋናሶን ማኮትዋ። ናርሲኒ ኬሩክ ዳሚሲክ አማነሬ ፌሴ ሜያክ ናጋናሶን ማኮትውኣ። <verse eid="ROM 16:11"/><verse number="12" style="v" sid="ROM 16:12"/>ዳሚሳ ዎስቶክ ሆፕት ፋሴ ማሽካ ሜያክ፤ ትሩፋይክናዋ ትሩፎሳክና ናጋናሶን ማኮትዋ። ዳሚሳ ዎስቶክ አካማኖን ሆፕት ፋ ባሬዋ ክርስቶስኒክ ታ ባሮን ሹንፋና ፐርሲሲክ ናጋናሶን ማኮትዋ። <verse eid="ROM 16:12"/><verse number="13" style="v" sid="ROM 16:13"/>ዳሚሳ ዎስቶኖን ዎስቶክ አካማኖን አርቶ ስና ሩፎስኒክ ናጋናሶን ማኮትዋ። ታን ደይ ናዉባ ዛግራ ሹንፋ እንቶባሲክ ናጋናሶን ማኮትዋ። <verse eid="ROM 16:13"/><verse number="14" style="v" sid="ROM 16:14"/>አሲንክርቶስኒክናዋ ፌሌጎኒክና፥ ሄርሜስኒክ፥ ፓትሮባስኒክ፥ ሄርማስኒክ ደይ፥ ባሶኔን አነ ፌሴ አይኒ ሜያክ ናጋናሶን ማኮትዋ። <verse eid="ROM 16:14"/><verse number="15" style="v" sid="ROM 16:15"/>ፍሎጎስኒክ፥ ዩልያክ፥ ነርያኒክናዋ ኤትባሲክና ናጋናሶን ማኮትዋ። ኤሲስማቶ ደይ ኦሉምፓስኒክናዋ ባሶኔን አነ ፌሴ አማኝኒ ሜያ ዙታምቤሲሴ አሲክና ናጋናሶን ማኮትዋ። <verse eid="ROM 16:15"/><verse number="16" style="v" sid="ROM 16:16"/>ኮርቶ ዳሞክ ናጋ ዎል ኦሽሾሶት። ክርስቶስኒ ቤቴክርስታኒሲክቶ ዙቴራ ናጋ ንቶክ ማክሴዋ።<verse eid="ROM 16:16"/></para>
  <para style="s1">ኮእን ኪቶ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17"/>አይታሳክቶኖ! ኤጳ ታሴቲ አሱሶን ቱእጋኤር ስንነሬ ንቶ ጋነያስሲ ኦር ኦር ኬስነዋ ራክኮነ ኤጴ ዬሴፌ አሱኒ ሜያስታን ቴትንትሶን ኦድትዋ። ባሶስታን ደይ ዎክትዋ። <verse eid="ROM 16:17"/><verse number="18" style="v" sid="ROM 16:18"/>ኤስ ኤፌቴና አሱኒ ሜያ ቴትቤሲስሮንታኖ ዳምኒ ክርስቶስኒክ ኣነ ዎስቴሴፌዋ። ሹጳ ዎላክናዋ ጌእስሬ ቴጎክና ጋራምኒ ሜኒ ንባሶን ኤሽሴፌዋ። <verse eid="ROM 16:18"/><verse number="19" style="v" sid="ROM 16:19"/>ምስራቹኒ ካማሲክ አጃጃሜር ስኒቲሶን አሱ ዙታምባሴ አሲ ስናክ አርቴ ስንባሲክ ግሬፋናክኑ ማአር ስና ዉዛሲክ ቴቹም፤ ማጙ ስና ዉዛሲክ ደይ ጋራም ስናትክቱ ሾሌፋውጝዋ። <verse eid="ROM 16:19"/><verse number="20" style="v" sid="ROM 16:20"/>ኤስ ባሮን ዛግፋትነ ናጋኒ ሀኦስ ታአ ዎናሲ ሴጣናሶን ዎቾንቲሲ ስካሎሲ የርአ ኤሱናዋ። ዳምኒ የሱስኒ ኦትማስ ንቶኔን አነ ስንፋውጝዋ። <verse eid="ROM 16:20"/><verse number="21" style="v" sid="ROM 16:21"/>ታኔን አነ ዎስቴፌ ትሞትዮስ ናጋ ንቶክ ማኬዋ። ኤሲስማቶ አይሁድ ስና ኮንታ ሉቅዮስ፥ እያሶንናዋ ሶስፓትሮስና ናጋ ንቶክ ማክሴቴዋ።<verse eid="ROM 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22"/>ሀን ዎሲያሶን ትች ታ ጠርትዮስ ደይ ዳሚሲክ ናጋ ንቶክ ማኬፋውጙዋ።<verse eid="ROM 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23"/>ታናዋ ሀንታክ ፋ ቤቴክርስታኒሲክቶኖን ዙትሬ እርባሲፌ ጋዮስ ናጋ ንቶክ ማኬድፌዋ። ካታማሲ ዋጋኖን ኩንስፌ ኤራስቶስ ደይ አይኒ ስና ቆአሪቶስ ናጋ ንቶክ ማኬዋ። <verse eid="ROM 16:23"/><verse number="24" style="v" sid="ROM 16:24"/><note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">እሳ እሳ ግሪክኒ ማፃፋሲ ሀን ባሮን ኣነ ዳይስፋ።</char></note>ዳምኒ የሱስ ክርስቶስኒ ኦትማስ ዙታምኒቲስኔን አነ ስንፋውጝዋ፤ ኣሚን!<verse eid="ROM 16:24"/></para>
  <para style="s1">ጋላትን ሺጶ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25"/>እቤኔን ኣቸራ ፋ፥ ሀሽ ደይ አምማኖን ኬሳ ፉቶኒ ኣቾ ቾዋሲኪ ካሞ ታ ማኬፋና የሱስ ክርስቶስኒ ቾዋሲክ ማኬፋ ምስራቹኒ ካማሲክ አማንቶኒትሲክ ችምማ የሮትክ ንቶትን ዛጉናክ ችማናዋ። <verse eid="ROM 16:25"/><verse number="26" style="v" sid="ROM 16:26"/>ስኑንታኖ ሀሽ ኤስ ፉቶስ አምማኖን ኬስሳ ቤስቴዋ፥ ኮእባ ፎንቶ ሀኦሲ አጃጅክ ዙታምቤሲሴ አማነሬ አጃጃሞሶነክ ራጁኒ ሜኒ ማፃፋስኪ ካሞ ዳራስ ዙቴሬ አርሶነክ ዛግቴዋ። <verse eid="ROM 16:26"/><verse number="27" style="v" sid="ROM 16:27"/>ባር ባር ቴቹምባ ፋና እሳ ሀኦሲክ፥ የሱስ ክርስቶስኒኪ ካሞ ኮእባ ፎንቶኖን ጋላታ ስንፋውጝዋ፤ ኣሚን!<verse eid="ROM 16:27"/></para>
  <chapter eid="ROM 16"/>
</usx>
