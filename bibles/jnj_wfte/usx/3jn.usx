<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">-Yemsa New Testament</book>
  <para style="h">3 ዮሀኒስ</para>
  <para style="toc1">ዎሲ ዮሀኒስኒ ኬዝሳ ዎሲያ</para>
  <para style="toc2">3 ዮሀኒስ</para>
  <para style="toc3">3 ዮሀ.</para>
  <para style="mt1">ዎሲ ዮሀኒስኒ ኬዝሳ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ዎሲ ዮሀኒስኒ ኬዝሳ ዎሲያስ ትቼናስ «ኩርኡ ስና ዎሲ ዮሀኒስኒኪን» ስንፋት ትቼናስ ደይ ጋይዮስ ይስቴ ቤቴክርስታንኒ ዞንስሲክዋ። ትች ባር እሳ ሀምናሪክ ኦም ክርስታናኒ ሜያኖን አርጋሲና ቦርአ ጋይዮስኒን ጋላቴት ፌር። ኦማ ኡግናክ ደይ ድዮትሮፍስ ይስቴ ጃልሊኒ አሱስኪን ቴትባሶን ኦዳናክቱ ኪትሬ ማኬ።</para>
  <para style="iot">ማፃፋሲ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">ጋይዮስኒክ እምቴ ጋላታ <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">ድዮትሮፍስኒ ዋቃስቶ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">ድሜጥሮስኒክ እምቴ ጋላታ <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ኮርኡባ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ቤቴክርስታንኒ ኩርኡ ስና ኬሽቴፌና ሹንቶ ጋይዮስኒክ፤</para>
  <para style="p" vid="3JN 1:1">ኩርኡ አሱ ስና ታኪን ዎስቴ ዎሲያ፤ <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>ዞሞታሶ! ፎኔስ ዙቴራ ሆእታናክ ፋይያነ ፎናክናዋ ኤሲስማቶ ደይ ካኔስ ማአሪክ ፎናክናቱ ሺጴፋዉጙዋ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ፉቶኒ አማንቶነሴዋ ፉቶሲክ ፎኔሴ አሲን እሳ እሳ ክርስታና አይኒ ሜያ ዬሴሬ ማክሴቴን ኦደፋና ካባሲክ አካማኖንቱ ግሬጝዋ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ናንጎትናሲክቶ ፉቶሲክ ኬስሳ ግርሴት ፎባሶን ኦዶስታን ደናሎ ታን ግርስፋ ዉዛ ኣፋዋ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋይዮስኒ ሱስቶ</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>ዞሞታሶ! ኔክ እርባ ስነፌክኑ አይኒ ሜያክ ነ አማናምቶ ዎስቶ ዎስቴታርዋ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ባሶ ደይ ነ ዛግታ ኬሽታንኒ ዎሲቶሲክ አማኝኒ ሜኒ ዙቶሲ ስና ኔክ ዛላ ማክሴቴዋ። ሀሽኑ ደይ ሀሞነ ኡግናሲክ ሀኦሶን ግርሱኒ ዉዛሶን ባሶክ አሪጋሲፋታነ ማአሪዋ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ባሶ ክርስቶስኒክ ዎስቶሶነክ ኬሴፌ ካባሲክ አዛብኒ ሜያኪን እሳ አርጋሱኑ ኣነ ኤጶቶዋ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ፉቶኒ ዎስቶሶን ሃኤር ስናኒክ ኤስ ኤፌቴና አሱኒ ሜያኖን አርጋሱኒክ ሾልሱዋ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ድዮትሮፍስኒ ዋቃስቶነዋ ድሜጥሮስኒ ሱስቶነ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ዜሞ ስናክ ቤቴክርስታኒሲክ ዳብዳቤ ትችጝዋ፤ ስኑንታኖ ቤቴክርስታንኒ ዞንሲ ስናናክ ሾሌፌ ድዮትሮፍስ እኖትን ኣነ ኤጴቶዌዋ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ኤስ ባሪ ቦርኣ ንቶኪ ያፋና ካባሲክ ባር እኖትን ሜኤትናዋ ሳልጵስፌትና ዛግና ማጙ ዎስቶሶን ዙትራ አሱ ዙታምቤሲሴ አሲክ ማኮናዋ፤ ኤስ ባር ባርኑ ሆሮ ሻካን ባር ቴትባሲክ አይኒ ሜያኖን ኣነ ኤጴቴፌዋ። ኦምኒ ሜያ ደይ ኤጴቶሶኖይቴማቶ ካልፌ ደይ ቤቴክርስታኒስን ካልሌ ክስፌዋ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>ዞሞታሶ! ማአ ዉዛስነ ፌር ስንታኖ ማጙ ዉዛስነ ፌር ስናታታዋ። ማአ ዎስቶሶን ዎስቴፌ ባር ዙታምባሴ ሀኦስክጝዋ። ስኑንታኖ ማጙ ዎስቶሶን ዎስቴፌ ባር ዙታምባሴ ሀኦሶን ኣነ አሪፌዋ። <verse eid="3JN 1:11"/><verse number="12" style="v" sid="3JN 1:12"/>ድሜጥሮስኒክ አሱ ዙታምባሴ ማአሪክቱ ዛላ ማኬድፌዋ። ፉቶስ ደይ ቴትባሲክ ዛላ ማኬድፋርዋ። እንኖ ደይ ባሪክ ዛላ ማኬድፌኒርዋ፤ ዛልኒስ ደይ ፉቶ ስንናማቶ አሪፋትዋ።<verse eid="3JN 1:12"/></para>
  <para style="s1">ኮእኒ ናጋኒ ኦሽሾ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>ኔክ ትቹናክ ሾሌፋና ሾዎ ዉዛ ፋርዋ፤ ስኑንታኖ ዳብዳቤክ ትቹናክ ኣነ ሾሎትዋ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ሀን ታአኖን ኔን አነ ኡጶናማቶ አብድ ዛግፋዉጝዋ፤ ኤስ ካባሲክ ኣፌ ኣፌ ዎል ቢራ ዎሎኒዋ። <verse eid="3JN 1:14"/><verse number="15" style="v" sid="3JN 1:15"/>ናጋ ኔክ ስንፋውጝዋ፤ ዞሞኔሳክቶ ኔክ ናጋ ኦሽሼድፌ፤ ነ ደይ ዞሞኒሳክቶ እሳርቤስ እሳርቤሲሲክ ናጋናሶን ማኮዋ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
