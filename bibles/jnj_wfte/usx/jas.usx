<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">-Yemsa New Testament</book>
  <para style="h">ያቆብ</para>
  <para style="toc1">ያቆብኒ ዎሲያ</para>
  <para style="toc2">ያቆብ</para>
  <para style="toc3">ያቆ.</para>
  <para style="mt1">ያቆብኒ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ሀን ያቆብኒ ዎሲያስ ዎንና ዎንናት ፎኒሲክ ዞንሲያ ስንኒ ሳፋራባ ስሩክ ኤጶ ስንፋት ትቼናስ ደይ ሀን ዳስታክ ሲክቴሬ ፌሴ አሲሬ ሄፔ አሲቴሴሪሲክቶክዋ። ትች ባር ቴችማሶን አምማኖን ዎስቶታ ፌሹኒ ኡግናሶን፤ ክርስታናኒ ሜያ ዎል እርባሲት ፎነዋ አማላነ አሲክ ቾዋሲ ዞንሲያ ስንኒ ዉዛሲክቶኖን አምማ ስና ቤሶባ ፋና ዎላክቱ ማኬዋ። ቱካም ስንኒ ቾዋሴዋ ኦቱም ስንኒ ቾዋሴ፤ ፋታናኒ ቾዋ፤ ማአ አማላኒ ቾዋ፤ ኮናኒ ቾዋ፤ አማንቶነዋ ማአ አማላነ፤ ቴርማኒ ማእነዋ ማጙነ፤ ቴቹምኒ ቾዋ፤ ዎል ፋሶኒ ቾዋ፤ ቤጋንቶነዋ ጋራምነ አሲ ቾዋ፤ ኦሚሳታ ማጝሱኒ ካርኒ ቾዋ፤ ቤጋንቶኒ ቾዋ፥ ፋኪኒ ቾዉነዋ ሺጶነ፤ ክርስታናኒ ሜያ ዛግሶነክ ሾልሲፋ ግድነ አስን እሳርባ እሳርባሲክ ኮትቴቱ ትች።</para>
  <para style="ip">ዎሲያስ ክርስትናኒ ካኒ አማንቶነዋ ዎስቶታ ፌሹኒ ቾዋሶን ማእስራቱ ቤሲፋ።</para>
  <para style="iot">ማፃፋስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="JAS 1:1">1:1</ref> </char></para>
  <para style="io1">አማንቶነዋ ቴቹምነ <char style="ior"><ref loc="JAS 1:2-8">1:2-8</ref> </char></para>
  <para style="io1">ቱካማነዋ ኦቱምነ <char style="ior"><ref loc="JAS 1:9-11">1:9-11</ref> </char></para>
  <para style="io1">ፋታና <char style="ior"><ref loc="JAS 1:12-18">1:12-18</ref> </char></para>
  <para style="io1">ሀኦሲ ካማኖን ኦዶነዋ ዛጉነ <char style="ior"><ref loc="JAS 1:19-27">1:19-27</ref> </char></para>
  <para style="io1">ኮሩ ዛግቶኖይናማቶ እምቴ ኪቶ <char style="ior"><ref loc="JAS 2:1-13">2:1-13</ref> </char></para>
  <para style="io1">አማንቶነዋ ዎስቶነ <char style="ior"><ref loc="JAS 2:14-26">2:14-26</ref> </char></para>
  <para style="io1">ክርስታናስናዋ ቴሩምባሴ <char style="ior"><ref loc="JAS 3:1-18">3:1-18</ref> </char></para>
  <para style="io1">ክርስታናስናዋ ሀን ዳሴ <char style="ior"><ref loc="JAS 4:1-5:6">4:1—5:6</ref> </char></para>
  <para style="io1">ሾዎ ቴሳ ዉዛክ እምቴ ኪቶ <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="s1">ያቆብኒ ዎሲያ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ዳሲ ብራቶታ ቦክቴሬ ፌሴ አሲሬ ሄፔ አሲቴሴርሲክቶክ ሀኦሲሬዋ ዳምኒ የሱስ ክርስቶስኒ ዎስትኛ ስና ያቆብንኪን ዎስቴ ዎሲያ፤ ናጋ ንቶክ ስንፋውጝዋ።<verse eid="JAS 1:1"/></para>
  <para style="s1">አማንቶነዋ ቴቹምነ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>አይታሳክቶኖ! ሾዎ ቴሳ ፋታና ንቶስታ ካርፋና ካባሲክ ንቶትን ግርሱኒ ዉዛ ዳንትንነ ፋሮን ዛግራ ፋዱትዋ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>አማንቶቲሲ ፋታንቶ ፋኪያክ ችምሜ ፎሶን አሩትክዋ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ፋኪያክ ችምሜ ፎንትስ እሳንነ ዮኡኖይናማቶ ቱም ስንና ፎትክ ዛግር ስኑንጝዋ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>ንቶ ጋነያሲ ቴችማባ ዮእና አሱ ፌፋናነ ኮሩኖይ ጋራማክ እምፋ ሀኦሶን ሺጶዎዋ። ባር ደይ እማናዋ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ስኑንታኖ ሄፕ ሳፋራባ ፌና ባር ስሩ ቱጋን ኤክ ሀጝ ሾርኬት ኩኒ ባሪኒ አካስነ ፌር ስንና ቦርአ ኤክ ሀጝ ኡኖይ አማንቶክ ሺጶዎዋ። <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>ሄፕ ሳፋራባ ፌና ባር ኡጉንባስታክ ኤክ ሀጝ ሾርኬት የሬፌ ባር ሀኦስኪን እሳ ዉዛነ ዳንኒርነ ፋር ስንና ባሪክ ቤስቶናታዋ።<verse eid="JAS 1:7-8"/></para>
  <para style="s1">ቱካም አሱናዋ ኦቱም አሱና</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ፎባሲክ ቱካም ስንነ ፌ አይስ ሀኦስ ባሪን ደን ቴጉኒር ስንና ቦርአ ግሮዎዋ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ኤሲስማቶ ደይ ፎባሲክ ኦቴሬ ፌ አይስ ሀኦስ ባሪን ዳ ኬስሳናነ ግሮዎዋ <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>አሱኒ ኦትማ ኩዋኒ ፉርኒማቶ ዎቶኒርዋ፤ አዋ ኪችፋና ካባሲክ ደይ ኩዋሶንናዋ ፉርአሶንና እችንስርዋ፤ ፉርኣስ ዎቴራ ጋዳባስ ደይ ትሽር። ኤሲስማቶቱ ኦቱም አሱ ዎስቶክ ኤክ ሀጝ ይፌት ትሽፌዋ።<verse eid="JAS 1:11"/></para>
  <para style="s1">አሱኒስታ ካርፋ ፋታና</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ፋታናሶን ፋኪያክ ችማ ባሪክ ዳሚስ አብድኒ ካምባሲማቶ ሀኦሶን ሹነፌ ባሶክ ካኒ አክልሊሶን እማናዋ። ኤስ ባሪ ቦርኣ ፋታና ባሳስታ ካርፋና ካባሲክ ችምሜ ኣትፌ አሱስ ሱስቶዋ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ሀኦስ ማጙ ዉዛሲክ ኣነ ፋታንቴፋ፤ ኤሲስማቶ ባር ደይ ኦኒንኑ ማጙ ዉዛ ዛጉናክ ኣነ ፋትታነፋዋ። ኤስ ባሪ ቦርኣ ኦኑ ስንፋናነ ፋታንቴፌና ካባሲክ፦ «ሀኦስ ታን ፋታነዋ» ኡናታዋ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ስኑንታኖ አሱ ቴትባሲ ማጙ ኤናንቶክ ዛቴሬናዋ ኤሽቴፌና ካባሲክቱ ፋታንቴፌዋ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ኤስታን ማጙ ኤናንቶባስ ናኔርቴራ ቦርኣሶን ኮኒፋ፤ ቦርኣስ ደይ ድቻ ክቱ ቴሸፋዋ። <verse eid="JAS 1:15"/><verse number="16" style="v" sid="JAS 1:16"/>ኬሽቴፋና አይታሳክቶኖ፤ ኤሽቶትታዋ። <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ማአ እማሴዋ ቱማ ኤባሴ ዙቴራ ደን ሀኦስክጝዋ። ኤስ ባር ደይ ይራራኒማቶ ሻቶኖይ ወደይ ሶልቶባ ፎንቶ ቻሬፍኒ አባ ሲና ሀኦስክጝዋ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ሀኦስ ቴስቶ ዙታምባሴ አሲ ኡዛ ስናኒክ ባሪ ፍቃዲሲማቶ ፉቶኒ ካምባሲክ እኖትን ታነዋ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ኦደኒ ውዛሶን ዎስቶታ ፌሹ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ኬሽቴፋና አይታሳክቶኖ! አሱ እሳርባ እሳርባስ ኦዶክ ታፕቴር ስኖዋ። ዎሎክናዋ ግእቶክና ታፕቶኖር ስኖዋ።<verse eid="JAS 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 1:20"/>ኤሲስ ደይ አሱኒ ግእአስ ሀኦስ ሾሌፋና ኦኮ ስንነ ፎሶን ፎኒክ ኣነ ዛግፋዋ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ኤስ ባሪ ቦርኣ ኪናሶንናዋ ቱምማ ፋ ማንጉሶንና ዙትራ ንቶስታን ዎክሳት ሀኦስ ንቶ ንብባሲ ኩንሲና ካንትሶን ፋቱክ ችምኒ ካምባሶን ማአ ንባክ ኤጳቶትዋ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ካምባሶን ኦዴሬ ዎስቶታ ፌሺር ስንትታኖ ቴትኒትሶን ኤሸት ባክ ኦደር ስናትታዋ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ካምባሶን ኦዴሬ ዎስቶታ ፌሹኖይ አሱ ቴትባሲ ግቶኖን እንካሊሲ<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">እንካል ኡስ ማስቶድ ኡዋ</char></note> ብያ አሱነ ፌርዋ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ኤስ አሱስ ኣፍባሲ ቢሬ ሀምፋት ጌሬጌሬ ደይ ባር አዉነፌር ስንናማቶ ዳጌፌዋ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ስኑንታኖ ብርማዱምማ ክሱኒ ዮኡባ ፎንቶ ቱማሶን ጋሳሲሬ ቢሬ ባሪክ ችምሜ ፌ ባር ኦዴሬ ዳጌር ስኖይናማቶ ዎስቶታ ፌሽፌ ባር ዎስቴፌና ዎስቶሲክ ሱስቶዋ። <verse eid="JAS 1:25"/><verse number="26" style="v" sid="JAS 1:26"/>ቴሩምባሶን ኦድኖይ፦ «ሀኦሶንቱ ሺጴድፋንዋ» ይፌ አሱ ቴትባሶንቱ ኤሽፌዋ። ባሳ ሀኦኒ ሺጶስ ደይ ዋግባ ኣፋዋ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>አባ ሀኦሲ ስና ኪንባ ፎንቶ ሺጶስ ሃኒስዋ፦ «አባ እንቶቤሲ ክትና ናንጎታሲክቶኖን፤ ኤሲስማቶ ደይ ቴጎቤስ ክትና ማሽካሱሲክቶኖን ራኮቤሲሲክ አሪጋሱ፤ ቴትኒሶን ደይ ሀን ዳስታኪ ፋ ኪና ዉዛሲን ኦዳስዋ።»<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">አሱኒን ኮሩ ኣነ ሾልሲፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>አይታሳክቶኖ! ኡልፍንቶ ዳም የሱስ ክርስቶስኒክ አማነር ስንፋትነ አሱኒን ኮሩትታዋ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ኤሴ ሄፕ አሱኒ ሜያ ንቶ ዙቴራ ፋትስታ ዮሶነ፤ እሳይስ ዋርቄኒ ግላ ዬቶናዋ ጋዳ ማያ ማዮ ኦቱም አሱና ሲናና፤ ሄፕሳስ ደይ ኪና ማያ ማዮ ቱካም አሱ ሲናና፤ <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ጋዳ ማማ ማዮ አሱስን ኡልፍንሱክ፦ «ሀን ቴጋ ድማስታ ያራ ዱዋ» እያት ቱካሚስን ደይ፦ «ነ፤ ኤኬስታ የሮዋ ወደይ ዳ ዎቾናስሲ ዱዋ» ይፌትዋ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ኤኪን ንቶ ጋነያስሲ አሱኒን ኮሩ ፋናማቶታኖሶ ቤስፋናሪ? ደይ አሱኒን ኮሪሬ ማጝሱ ካርፌ ዳኛነ ፋትርታኖሶ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ሹንቶ አይታሳክቶኖ! ኦዶትዋ! ሀኦስ ባሮን አማኖክ ኦቱም ስኖነክናዋ ባሮን ሹነፌ ባሶክ አብድክ እምና ባሪ ታቶስሲ ግርሶነክና ሀን ዳስታኪ ፌ ቱካሚስን ኣነ ቴጎዋኖሶ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>ስኑንታኖ ንቶ ቱካሚስን ካሽትር፤ ንቶስታ ራክኮ ካትፌስንናዋ ማጝሱኒ ካርኒ ኬር ታሜፌስ ኦቱምኒ ሜያቴኖሶ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>ንቶ ቴግሴፌት ኡልፍንቶ ክርስቶስኒ ሱናሶን ሜኤሴፌስ ባሶቴኖሶ? <verse eid="JAS 2:7"/><verse number="8" style="v" sid="JAS 2:8"/>ኮርቶ ማፃፋስሲ፦ «አሱስን ዙትራ ነ፤ ነ ቴታሶን ሹንፋታሲማቶ ሹንዋ» ይስቴራ ትቼናሲማቶ ሀኦሲ ታቶኒ ቱማኖን ኦድፋትነ ማአሮንቱ ዛግትዋ። <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ስኑንታኖ አሱኒን ኮርፋትነ ቦርአ ዎስቴትርዋ። ቱማሶን ደይ ኣትኒትሲክ ዋቃስቴትርዋ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ሀኦሲ ቱማኖን ዙትሬ ኦዳት እሳሮን ዮእጋናነ ዙታምባሴ አሲን ኦድኖር ስንነቱ ፋድቶናዋ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>«ጌርኬሳቲታ» ይ ዳሚስ፦ «ዎሩቲታ» ደይ ይዋ። ጌርኬሳሶን ቤይፋት ዎሪፋትነ ቱማሶን ኣነ ኦደዋ። <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ዎሉምኒትሴዋ ዎስቶኒትሴ ብርማዱምማ ክሱኒ ቱማሲ ማጝሱ ካርኒ አሱኒ ሜኒማቶ ስንትዋ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ሀኦሲ ማጝሱኒ ካርአ ፋክያ ዛጉኖይ አሱሲክ ፋክያ ኣነ ዛግፋዋ። ፋክያስ ደይ ማጝሱኒ ካርኣሶን ሜሬርዋ።<verse eid="JAS 2:13"/></para>
  <para style="s1">አማንቶነዋ ዎስቶነ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>አይታሳክቶኖ! እሳ አሱ፦ «አማንቶና ፋር» እያት ኤስ አማንቶባሶን ዎስቶክ ቤሱ ሻካናነ ባሳ አማንቶስ አዉ ኬእንሪንሶ? አማንቶባስ ባሪን ፋቱክ ችምንሮሶ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ማዮነ ማምነዋ ሙሶነ ሙነ ቱሩክሴ አይኒ ሜያ ወደይ ኤትኒ ሜያ ፌሴፋናነ፤ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>ንቶስን እሳር፦ «ማርኦን ሀሞት፥ ጌያስ ግንቶክ ጉሙን፤ ጋዉት» እያት ሙሶነ ሙ ወደይ አቱቤሲስታ ማዮነ ማማ እማ ሻካናነ ባሶክ አዉ ኬእንሪንሶ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ኤሲስማቶ ዎስቶባ ፎንቶ አማንቶስ ቴትባሲክ ክቱዋ። <verse eid="JAS 2:17"/><verse number="18" style="v" sid="JAS 2:18"/>ስኑንታኖ እሳ አሱ፦ «ነ፤ አማንቶነ ፋር፤ ታ፤ ደይ ዎስቶና ፋር፤ አማንቶኔሶን ዎስቶኔስታን ኦር ክስራ ቤሱዋ» ይፌር ፌፋናነ ታ፤ ደይ፦ «አማንቶናሶን ዎስቶናሲክ ቤሱናዋ» ኡናዋ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>ሀኦስ እሳር ስንናማቶ አማነታር፤ ኤስ ባር ደይ ማአር፤ ኪና አያናስኑ ደይ ኤስ ባሮን አማነር፤ ድጌራ ደይ ኮሪክሴር። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>ነ፤ ጎዋ አሱ! ዎስቶ ፎንቶ አማንቶስ ኬእኒርነ ፋር ስንና ኔክ ቤስቴፋዎሶ? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>አባኒ አብራሀም ናባ ይሳቅኒን ማአ ዛግሬ ሾኣስታ እምና ካባሲክ ዎስቶክ ሀኦሲ ስናክ ኦኮ ስንነ ኣነ ቤስቶዌኖሶ? <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ኤስ ባሪ ቦርኣ አማንቶባሴዋ ዎስቶባሴ እሳሪክ ሀምናማቶናዋ አማንቶባሶን ደይ ዎስቶክ ዮኡባ ፎንቶ ዛግሬ ቤሲናማቶ ኣነ ብየትኖሶ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ማፃፋስሲክ፦ «አብራሀም ሀኦሶን አማነ፤ አማንቶባስ ደይ ኦኮ ስንና ፋድቴ» ይስቴ ባር ኮእዋ። ባር ደይ ሀኦኒ ኮን ስንነ ቴግቴ። <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ኤሴ አሱ ኦኮ ስንነ ፋድቶናስ አማንቶ ባር ባሪክ ስኖይናማቶ ዎስቶክኔን ስንናማቶቱ ብያታዋ። <verse eid="JAS 2:24"/><verse number="25" style="v" sid="JAS 2:25"/>ኤሲስማቶ ጌርኬስፋ ራሀብ ስንፋ አሱስ እስራኤልኒ ኣፎኒ ሜያኖን ኤጳ ኣችራ ኦማ ኡግናክ ኮፍኩባሲክ ዎስቶክ ኦኮ ስንና ኣነ ፋድቶዋኖሶ? <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>ካ ስሩን ኬስና አሻስ ክቱ ስንናማቶ ዎስቶባ ፎንቶ አማንቶስ ደይ ክቱዋ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">ቴሩምኒ ኦዳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>አይታሳክቶኖ! አስኛ ስና እንኖስታ አካማ ማጝሱኒ ካርአ ዮኒር ስንናማቶ አርሴትር ስንና ቦርአ ንቶስን ሾዎቤሲስ አስኛ ስኖኔታዋ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>እንኖ ዙታምኒሴ ሾዎ ዉዛክ ዳጌኒርዋ። ዎሉምባሲክ ቱሳኦኖር ፌፋናነ ኤስ ባር ቴርማባሶን ኦዳክ ቴትባሶን ሀእሱክ ችማ ዛግ አሱዋ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፋዛሲክቶ እኖክ አጃጃምቶናክ ኖኖባስሲ ሉጋማ ጌድፌኒ፤ ኤስታን ፋዛሶን ሾሌኒ ዲማ ዛትፌኒ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ሜርኬቢሲክቶኖን ደይ ቢትዋ፤ አዉነ ፋሮን አካማ ስንፋናክኑ ደይ አካማ ሁግናባ ፋና ስሩክ ቱግቴር ስንፋናክ ሜርኬቢሶን ካልፌ ባር ኪስኩ ማሪክቱ ባር ሾሌና ዲማ ካልፌዋ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ኤሲስማቶ ቴርማስ አቱስን ኪስኩ ስንፋት ሾዎ ዉዛ ዛግናር ይቱ ጌእፋዋ። አካማ ቡርኡስ ጋሮ ኪስኩ ጌያክ ኣካክ ኪቼራ ትሽፋናሲማቶ ጋሳሱትዋ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>ቴርማስ ደይ ጌያነ ፋርዋ፤ አቱኒሲ ብልትስን ባር ማጙ ዉዛክ ቱማ ፋ ሀን ዳስነ ፋርዋ። አቱኒሶን ዙትራ ኪንስር። ጌኒ ትርእማሲን ኬስፋ ጌኒማቶ አሱሳ ፎኖን ኪችር፤ ባር ደይ ኪቼር። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ሀን ዳስታ ፋ ጎኞሲኪቶ፥ ካሳ፥ ንባሲክ ዛይፋ ባሬዋ፥ አካስሲ ፋ ቴስቶሴ ዙቴራ ሌጅስቴዋ። ባሪኪቶ ደይ ሌጅስቴ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ስኑንታኖ ቴሩምማባሶን ሌጅሱናክ ችማር ኦኑ ኣፌዋ። ባር ደይ ኪችራ ዎሪፋ ማርዝ ባሪሲ ቱማ ፋና ቤይሳባ ፎንቶ ማጙ ዉዛዋ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ባሪክ ዳማ ሀኦሶን ጋላቴፌኒ። ደይ ሀኦሲ ግቶክ ቴስቴ አሱስን ኤርዊፌኒ። <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>እሳ ኖኖስን ጋላትነዋ ኤርዊነ ኬስፋዎሶ? አይታሳክቶኖ! ኤስ ባር ኤካ ስናናክ ኣነ ሾልስፋዋ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>እሳ ኮርኣስን ማጙ አካነዋ ማአ አካነ ኬሳናክ ችማሮሶ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>አይታሳክቶኖ፥ ባላስኒ እኦስ ቡንኒ ጋና ጋናናክ ችምኒሮሶ? ወደይ ዋይንኒ እኦስ ባላስኒ ጋና ጋናክ ችምኒሮሶ? ኤሲስማቶ ማጙ ኮርኣስን ማአ አካ ኬሳናክ ኣነ ችምፋዋ።<verse eid="JAS 3:12"/></para>
  <para style="s1">ሳማን እምቴፋ ቴችማስ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>ንቶስን ቴቹም ወደይ ጋሳሱባ ፋና አሱ ኦንሶ? ኤሴ ቴችማክናዋ ሹጳክና ዎስቴና ዎስቶባሶን ማአ ፎባሲክ ቤሱዎዋ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ስኑንታኖ ማጙ ኮናነዋ ቴትኒ ሹንነ ንብንትስሲ ፋፋናነ ኤስ ቴችማሲክ ቴቶቲታዋ፤ ፉቶስታ ደይ ኤሻቲታዋ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ኤፋቴና ቴችማ ቤስቴፋናስ ሀን ዳስታንዋ፤ አሱኒኪንናዋ፤ ሴጣናስኪንናታኖ ሀኦስኪንታዋ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ኮናነዋ ቴትኒ ሹንነ ፋና ድማስታ ናጋኒ ቱርኩነዋ ማጙ ዎስቶነ ዙቴራ ፋርዋ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ስኑንታኖ ደን ሀኦስኪን ያፋ ቴችማስ ዜምማ ካይማ፥ ደይ ናጋ ሹናር፥ ጋራማ፥ አጃጃሜር፥ ፋኪያ ዛግር፥ ማአ ጋንባ ፋናር፥ ኮሩነዋ ታነ ፌር ኣፌ ኡባ ፎንቶዋ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ናጋ ሾልሴፌ ባስሶ ናጋ ቡኬሬ ኦኮ ስንኒ ጋናቱ ዙትሴፌዋ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ሀን ዳስታኪ ማጙ ዉዛሶን ሹናቲታ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>ንቶ ጋነያሲ ፋ ኔቦሴዋ ፋሶሴ አይን ያሪንሶ? ንብንትሲ ኔቤፋ አሽንትሲ ማጙ ኤናንቶስኪንታኖሶ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>እሳ ዉዝኒ ዳናክ ኤናንቴትር፤ ስኑንታኖ ኣፋ ዳናት ዉዛ። ደይ ኮነትር ፋሴትር፤ ኤስ ባርስታን ደናሎ ደይ አሱኒን ዎሪትር፤ ኣነ ሺጴፌት ስንና ቦርአ ኣፋ ዳናት ዉዛ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>ሺጶኒትስ ማጙ ሳፋራክ አሽንትሶን ግርሱክ ስንና ቦርአ ሺጶኒትሲ ዎልጉኖን ኣፋ ዳናት ዉዛ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>አማናምቶኒት ፎንቶ ንቶኖ! ሀን ዳስታኪ ዉዛሶን ሹና ሀኦሲኔን አነ ፋሶ ስንናማቶ ኣነ አሩዌትኖሶ? ኤሴ ሀን ዳስታኪ ዉዛሶን ሹንፌ ባር ዙቴሬ ሀኦሲ ጉማ ስኒዋ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ኤኪን ኮርቶ ማፃፋስሲ፦ «ሀኦስ እንኖስሲ ኩንስና ባሪ አያናስ ባሪክ ፎኒክ ማእስራቱ ኮነፋዋ» ይራ ማኬናስ ባክኖሶ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ኤሲስማቶ ደይ ማፃፋስሲ፦ «ሀኦስ ጌእፌ ባሶትን ኦምቴር፤ ስኑንታኖ ሹጰፌ ባሶክ ኦቱምባሶን እማርዋ» ይፋና ቦርአ ሀኦስ እምፋና ኦትማስ ዙታምባሴ አሲስታን ደናሎዋ።<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>ኤሴ ሀኦሲክ ሀእኡት፤ ሴጣናሶን ደይ ጉዎት፤ ባር ደይ ንቶስታን ዎካና። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ሀኦስኪ ታእሶት፤ ባር ደይ ንቶኪ ታእሶና። ንቶ ቦርእኒ ሜያነ! ኩሹንትሶን ካይንኑት፤ ሄፕ ሳፋራንት ፋና ንቶ ንብንትሶን ካይንኑት። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ማእስራ ራካቶት፥ ሱሞት፥ ዋሱት። ምእኒትስ ዋሳክ ሶልቶን፤ ግራንትስ ደይ ሱሞክ ሶልቶን። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ዳሚሳ ስና ቴትኒትሶን ዳ ኤጵት፤ ባር ደይ ንቶትን ደን ቴጉና።<verse eid="JAS 4:10"/></para>
  <para style="s1">ማጝሱ ካርአቲታ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>አይታሳክቶኖ! ንቶትና ንቶትና ዎል ሀማቶትታዋ። አይባስን ሜእፌ ባር ወደይ አይባሳታ ማጝሱ ካርፌ ባር ሀኦሲ ቱማኒ ማጙኖንቱ ማኬፌዋ፤ ደይ ቱማስታቱ ማጝሱ ካርፌዋ። ነ ቱማስታ ማጝሱ ካርፋታነ ቱማስታ ማጝሱ ካርአርቱ ስንናታታኖ ቱማሶን ኦዳር ኣፋዋ ስንናታዉዛ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ቱማሶን እምኒሴዋ ማጝሱ ካርኒሴ እሳ ሀኦስዋ። ፉኦክናዋ ትሽኩክና ችምኒስ ደይ ባር ባር ኮእባዋ። ኤኪን አሱሳታ ማጝሱ ካርፌስ ነ ኦንሶ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ንቶ ቴትኒ ሳፋራኒትስታ ቴቶቲታ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>ኤሴ ኦዶትዋ፦ «ሀሽ ሀውጙ ወደይ ዎኖ ሀንታን ካብራ እሳ ካታማሲ ሀማኒዋ፤ እሳ ዎግጋ ኤስታ ዲራ ናጋዴራ ቡእሱኒዋ» ይፌት። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ስኑንታኖ ዎኖ ስንኒ ባሮን ኣነ አሪፌትዋ፤ ካንትስ ኣምባንሶ? እሳርጋ ቢስቴፋት ዎል ላ ትሽፋ ፉሩቱስነ ፋትርዋ። <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ኤስ ባርስታን ዜምማ፦ «ዳሚሳ ፍቃድ ስንፋናነ ሀን ባሮን ወደይ ኤክ ባሮን ዛጉኒዋ» ኡትክቱ ሾልሲፋዋ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>ስኑንታኖ ንቶ ኤስ ባሮን ሻካቱ ቴትኒትሲክ ጌእፌት ደይ ቴቴፌት፤ ኤስ ኤፋቴና ቴቶስ ማጙዋ። <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>ኤሴ ማአሮን ዛጉናክ ሾልሱ ስንባሶን አሪፌት ዛጉ ቤይባሲክ ኤስ ባር ባሪክ ቦርአዋ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ኦቱምኒ ሜያክ እምቴ ኬኦ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ኤሴ ንቶ ኦቱምኒ ሜኖ ኦዶትዋ! አካማ ሻና ንቶስታ ዮኒር ስንና ቦርአ ቻግጋ ዋሱትዋ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>ኦቱምኒትስ ዙቴራ ኩፓና፤ ማይኒትሶን ደይ ኮኝማር ሙና። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>ዋርቄንትሴዋ ብርንትሴ ደይ ሺራ ማጙናዋ። ባሪ ሽያስ ደይ ንቶስታ ዛላ ሲናናዋ። አሽንትሶን ደይ ጌኒማቶ ኪቹናዋ። ሀን ኮእኒ ዎናሲክቱ ኦትማ ዙቲሴትዋ። <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ኤሴ ኦዶትዋ! ፎሽኒትሶን ዙቲ ዎስትኛአሳ ዋጋ ንቶስታ ኩንፋት ቻግድፋዋ። ኤስ ባሶ ቻጋሶን ደይ ዙታምባሴ አሲስታ ሁግናባ ፋና ዳሚስ ኦዴዋ። <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>ማአ ፎክናዋ ግራክና አቱንትሶን ሹክቶናክ ሆሬራ የሬ ጋቹኒማቶ ኩልሲትዋ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>ንቶትን ቱጋኦኖይ ካይም ማጝሱቤስ ፎንቶ ሜያኖን ማጝሱ ባሶስታ ካርኤቲ ደይ ዎርሴትዋ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ዳሚሳ ዎሌ ዮኖን ፋኪያክ ኦዳ ሾልሲር</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>አይታሳክቶኖ! ዳሚስ ዮና ካባኔን ፋኩትዋ። ቡልኛአስ ዳባስ ቤጋኒ እሮሴዋ ዬሹሲ እሮነ አስን ዳንና ማአ ጋና እማናኔን ፋክያክቱ ፎሽባሲ ጋናኖን ኦድፌዋ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>ዳሚስ ዮና ባር ታእ ስንና ቦርአ ንቶ ደይ ኤሲስማቶ ፋኪራ አብድክ ችምማ ኦድትዋ። <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>አይታሳክቶኖ! ንቶስታ ማጝሱ ካቶኖይናማቶ ንቶትና ንቶትና ዎል ኡኙሶቲታዋ። ማጝሱ ካርኒ ባር ዮና ዎና ካርእዋ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>አይታሳክቶኖ! ዳሚሳ ሱናክ ማክሴ ራጁኒ ሜያ ሻናሶን ፋኪያክ ኤጴቶክ ቤሶ ስና ባሶትን ቢትዋ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ኤሲስማቶ ደይ ፋኒያክ ችምሜ ኣታ ባሶትንቱ፦ «ሱስቶዋ» ይፌኒዋ። እዮብ ደይ ኣካክ ፋኪናማቶ ኦደትዋ። ዳሚስ ደይ ኮእባስታ ባሪክ ዛግና ባሮን ቢትዋ። ዳሚስ ፋክር ደይ ኬናሽቴር ስንባሶንቱ ቤስፋዋ።<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>አይታሳክቶኖ! ዙታምባሴ አሲስታን ደናሎ ደን ሳማክ ወደይ ሀን ዳስታክ ወደይ ኦማ እሳ ዉዛክነ ቴዉትታዋ። ዎሉምኒትስ ኣ ስንፋናነ ኣ፤ እንዳነ ስንፋናነ እንዳነ ስኑንዋ። ኤካ ስና ሻካናነ ንቶስታ ማጝሱ ካቴርዋ።<verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>ንቶ ጋነያሲ ራክኮ ባሳስታ ካርእና አሱ ፌፋናነ ሺጶዎዋ። ግሬት ፌ አሱ ፌፋናነ ባር ሀኦሲክ ጋላትኒ ጋማ ጋሞዎዋ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>ንቶ ጋነያሲን ሜትቴ አሱ ፌፋናነ ቤቴክርስታንኒ ኩርኡኒ ሜያኖን ባርኪ ቴጎዎዋ። ባሶ ደይ ዳሚሳ ሱናክ ዛይት ዎሽሬ ባሪክ ሺጶሶቶዋ። <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>አማነሬ ሺጶስ ሜታኒስን ፋትርዋ። ዳሚስ ደይ ኤስ ሜሮባስን ባሪን ፋቱናዋ፤ ቦርእባ ፋፋናነ ደይ ባሪክ ፌሹን ኡስቶናዋ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ንቶትና ንቶትና ዎል ቦርእኒትሶን ሀርሙትዋ። ሜሮንትስን ፋሩትክ እሳይስ ኦሚሲክ ሺጶዎዋ። ኦኮ አሱኒ ሺጶስ ጋንባ ፋር ደይ አካማ ሁግናባ ፋርዋ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤልያስ እንኖነ ፌ አሱዋ፤ እሮ እችኖይናማቶ ዛጊግሬ ሺጴን ኬዝ ዎጋነዋ እሱን አስነ ዳስታክ እሮ ኣነ እቻዋ። <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>ሄፕሳ ደይ ዎል ሌ ሺጴን ሳማን እሮ ኬሬዋ። ዳስ ደይ ሜያ ካይግዋ። <verse eid="JAS 5:18"/><verse number="19" style="v" sid="JAS 5:19"/>አይታሳክቶኖ! ንቶስን እሳር ፉቶኒ ኡግናስታን ሻቴፋናነ ኦሚስ ደይ ኤስ አሱስን ዎልግፋናነ፤<verse eid="JAS 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 5:20"/>ቦርእኛአስን ቦርባስን ዎልግፌ ባር ቦርእኛአሳ ካኖን ክቱስን ፉኤናማቶናዋ አካማ ቦርባሲ ፋኪያኖን ዳናናክ ዛግናማቶና አሩዎዋ።<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
