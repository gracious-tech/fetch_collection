<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">-Yemsa New Testament</book>
  <para style="h">2 ጴጥሮስ</para>
  <para style="toc1">ዎሲ ጴጥሮስኒ ሄፕሳ ዎሲያ</para>
  <para style="toc2">2 ጴጥሮስ</para>
  <para style="toc3">2 ጴጥ.</para>
  <para style="mt1">ዎሲ ጴጥሮስኒ ሄፕሳ ዎሲያ</para>
  <para style="imt1">ጋችግሩ</para>
  <para style="ip">ዎሲ ጴጥሮስኒ ሄፕሳኒ ዎሲያስ ትቼናስ ሾዎ ድምታ ፌሴ እቤቲ ክርስታናኒ ሜያክዋ። ዎሲያስ አርክሮን ቤሲፋናስ ኤሻ አስኛኒ ሜኒ ማጙ ዎስቶሴዋ ባሶ አስሱስኔን አነ ያ ማጙ አማላኒ ፎሶን ቱጋኦክዋ። ቱስቴራ ያ ራክኮሲክ ኮታ ስንኒ ዉዛስ የሱስኒን ኣፋክ ብያ ባሶናዋ አሲፌን ኦዶቤሲሲክ ኦደ አሱኒ ሜና ኣትሴቴ አሱስኪ ካሞ ሀኦሲ ቾዋኖንናዋ ዳም የሱስኒ ቾዋሲክና ዛጋ አሩኒ ዳናኒክዋ። ትች ባር አሪክሮን ጋሳሲሬ ቢናስ «ክርስቶስ ዎል ሌ ኣፋ ዮናዉዛ» ይፋ ኤሻ አሱስታዋ። ኤስ ባሮን ቤስሬ ማኬፌና ካባሲክ «ክርስቶስ ዎል ሌ ዮባሶን ዎክስናስ ሀኦሲ አስሱ ዙቴሬ ቦርእባስኒን ዎሉናክታኖ ኦኑ ትሹናክ ኣነ ሾሌፌ ስንና ቦርአዋ»</para>
  <para style="iot">ማፃፋስ ስሩክ ኤጵና ኤጶባስ</para>
  <para style="io1">ጋችግሩ <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref> </char></para>
  <para style="io1">ክርስታናኒ ሜኒ ቴግቶ <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref> </char></para>
  <para style="io1">ኤሽ አስኛኒ ሜያ <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref> </char></para>
  <para style="io1">ክርስቶስኒ ዎል ሌ ዮ <char style="ior"><ref loc="2PE 3:1-18">3:1-18</ref> </char></para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>የሱስ ክርስቶስኒ ዎሲትኛናዋ ዎሲና ስና ታ ስሞን ጴጥሮስ፤</para>
  <para style="p" vid="2PE 1:1">ሀኦኒሲክንናዋ ሄትኒ ስና የሱስ ክርስቶስኒኪንና ቤስቴፋ ኦኮስኪ ካሞ ዳንኒስነ ፋ ኡልፍንቶ አማንቶ ዳና ንቶክ፤<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>ሀኦሶንናዋ ዳም የሱስኒንና አሩክ ሀኦሲ ኦቱምነዋ ናጋነ ንቶክ አርክፋዉጝዋ።<verse eid="2PE 1:2"/></para>
  <para style="s1">ሀኦሲ ቴጎነዋ ኮሩነ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>ኡልፍንባሲክናዋ ማእባሲክና እኖትን ቴጌ ባሮን አሩኒሲክ ሀኦ ስንባሲ ሁግና ካክናዋ ሀኦሶን ግርሱኒ ፎ ፎኒክና ዙታምባሴ አሲን እኖክ እሚዋ። <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>ኡልፍንባሲክናዋ ጋራምባሲክና ኡልፍንቶ ዋግባ ፋና አካማ እኛ ስና አብዲሶን ዳንኒዋ። ኤስ ባርኪ ካሞ ማጙ ሳፋራስታን ካብ ቾዋ ሀን ዳስታክ ፋ ማጙ ኤናንቶስን ኬስሳ ሀኦሲ ሃላኖን ሃኤር ስነትዋ።<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>ኤስ ባሪ ቦርኣ ሀን ዉዛሲክቶ ንቶክ ዳይቶናክ ችምትዋ፤ አማንቶስታ ማኣሶን፤ ማኣስታ አሩሶን፤ <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>አሩስታ ደይ ቴትኒ ሀእሱሶን፤ ቴትኒ ሀእሱስታ ደይ ፋኪያክ ችምሜ ፎሶን፤ ፋኪያክ ችምሜ ፎስታ ደይ ሀኦኒ ሺጶሶን፤ <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>ሀኦኒ ሺጶስታ ደይ አይና አይና አሲ ሹኖሶን፤ አይና አይና አሲ ሹኖስታ ደይ ኬሽታናሶን ዳይሱትዋ። <verse eid="2PE 1:7"/><verse number="8" style="v" sid="2PE 1:8"/>ኤስ ባርኪቶ አሪክራ ንቶክ ፋፋናነ ዳም የሱስ ክርስቶስኒን አሩሲክ ኬእኖር ወደይ ጋንት ፎንቶ ስንኖይትማቶ ንቶትን ኦዳናዋ። <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>ስኑንታኖ ኤስ ኤፋቴና ዉዛሲክቶ ባሳሲ ትሽና አሱ ዎካኖን ፋ ዉዛሶን ብያክ ችምኖይ ኣፍትሹ አሱዋ፤ ኣታ ቦርባስን ካይምባሶን ደይ ዳጌዋ።<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>ኤስ ባሪ ቦርኣ አይኒ ሜያነ! ቴግቶንትሶንናዋ ኮርቶኒትሶንና ዛጉክ ዜሞቲስታን አርኪስራ ችምትዋ። ኤካ ዛጋትነ ኣፋዋ ቱሳኦትዉዛ። <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>ኤስ ባሪክ ኮእባ ፎንቶኖን ፎኒ ዳምኒሲክናዋ ሄት ስና የሱስ ክርስቶስኒ ታቶሲና ግሩትክ ቱማኖን ንቶክ እምቶናዋ።<verse eid="2PE 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>ኤስ ዉዛሲክቶኖን አዉነ ፋሮን አሪፌትክኑ ኤጳ ታት ፉቶሲክ ደይ ዛግራ የሬፌትክኑ ሀን ዉዛሲክቶኖን ንቶክ ያዳሱሶን ኣፋዋ ቤያና ዉዛ። <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>ሀን ዳስታ ካክ ፋና ካባሲክ ዎንና ዎንና ንቶትን ጉዝጉስ ታክ ልኪ ስንናቱ ቤስቴፋዋ። <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ዳም የሱስ ክርስቶስ አምማኖን ክስሬ ታክ ማኬናሲማቶ ዎክኖይ ካናስ አሽናስታን ኦር ኬሳናማቶ አሪፋውጙዋ። <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>ሀሽ ሀን ታ ንቶትን ጉዝግት ፋናስ ክትናኔን ኦርፎ ሀን ዉዛሲክቶኖን ዎንና ዎንና ያዳቶክ ችማትክዋ።<verse eid="2PE 1:15"/></para>
  <para style="s1">ክርስቶስኒ ኡልፍናሶን ብያ ባሶ ማክሴቴ ዛላ</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>ዳም የሱስ ክርስቶስኒ ሁግናሴዋ ሄፕሳ ዮና ባሬ አስን ንቶክ ማኬፌኒ ካባሲክ እንኖ ቴትኒሲክ አዳባሶን ኣፍኒሲክ ቢኒ ቦርአቱ ዛላ ማኬኒታኖ አሱኒ ቴችማክ ማክቴ ቶቾክ ዞኑስቴራታዋ። <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>«ባሪክ ግሬፋና ደይ ሹንፋና ናታ ሀኒስዋ» ይፋ ካማስ አሪክቶ ኡልፍናስ ባሪክ ያፋና ካባሲክ አባ ሀኦስኪን ኡልፍንነዋ አዳነ ኤጴቴዋ። <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>እንኖ ደይ ባርኔን አነ ካይማ ኣማስታ ፋኒ ካባሲክ ኤስ ካማስ ደን ሳማን ዬን ኦድይኒዋ። <verse eid="2PE 1:18"/><verse number="19" style="v" sid="2PE 1:19"/>ኤስ ባሪክቶ ዙታምባሴ ራጁኒ ሜያ ማኬሴቴ ባር ፉቶ ስንናማቶ አርቴዋ። ኤስ ባሪ ቦርኣ ታልማስ ዎናናክፋና ካባሲክናዋ ዎን ኒ ማስኮስ ንቶ ንብባሲ ቻሮና ካባኔን ታልማስሲ ፋ ቶናስ ትሹኖይናማቶ ኦድቴፋናሲማቶ ንቶ ደይ ሀን ካማሶን ኦድፋትነ ማአሮንቱ ዛግትዋ። <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>ዙታምባሴ አሲስታን ዜምማ ኤስ ባሮን አሩትክ ሾልሱዋ፤ ኮርቶ ማፃፋስሲ ፋ ራጅኒ ካማ ዙታምባሴ አሲን ኦኑ ባሳ ቴትኒ ኡግናክ ኮታናክ ኣፋ ችማናዉዛ። <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>ስኑንታኖ ኣፋ ራጂስኑ አሱኒ ሳፋራክ እሳንነ ኣነ ዮዋዋ። ራጂሶን ኮርቶ አያናሲክ ዞኑስቴ አሱኒ ሜያ ሀኦስኪን ኦዴሬቱ ማክሴቴርዋ።<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">ኤሽኒ አስኛኒ ሜያ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>ስኑንታኖ ኤሽ ራጁኒ ሜያ ዳራሳ ጋነያሲ ፌሴቴማቶ ንቶ ጋነያሲ ደይ ኤሽ ራጁኒ ሜያ ፎሶነክ ችሞነዋ። ባሶ ትሹ ኤጳ ያፋ ኤሻ አስሱሲ ኣቾ ዝኡናክቱ ዛግሴፌዋ። ባሶትን ፉሬ ዳሚስን ሞርሜሴሬ ቴትቤሲስታ ደይ ትሹ ቴሸሴፌዋ። <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>ሾዎቤሲስ ኢቹ ኡግናክ ሀሜፌ ቦርአ ባሶ ዎስቶሲክቱ ፉቶኒ ኡግናስ ሜቸፋዋ። <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>ኤስ ኤሽኒ አስኛኒ ሜያ ዋግኒ ጆራቤሲስታን ቴትቤስሪ ቶቾሶን ዎሉምሴፋፌ ንቶትን ሜሴፌዋ። ሾዎ ዎናኔን ስናክ ማጝሱኒ ካርአ ባሶስታ ሆሬራ ፋርዋ፤ ፉቶክ ትሹስቱ ባሶትን ኦዳት ፋርዋ። <verse eid="2PE 2:3"/><verse number="4" style="v" sid="2PE 2:4"/>ሀኦሲ ዎስያኒክቶኑ ቦርኣሶን ዎስቴሴፌ ካባሲክ ሀኦስ ኬናሽቶኖይ ታልማ ዶኣሲ ማጝሱኒ ካርኒ ዎናሶን ኦዶነክ ሻሻራክ ታርአ ኬኦኒ ድማስሲ ሀእዋ። <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>ኤሲስማቶ ኦኮሲ ቾዋኖን ማኬት ፌ ኖህኒን ኦማ ናፉን አሱኒ ሜያኔን አነ ፉኤፋት ሀኦሶን ሺጶኖይ አሱኒ ሜያ ፌሴቴ ዳስታክ ትሹኒ አካ ኤጴ ያፋና ካባሲክ ኬናሽቴራ ኣነ ቤያዋ። <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>ደይ ሀኦሶን ሺጶኖይ ባሶክ ኬኦ ስኖነክ ሶዶምኖንናዋ ጋሞራኖንና ኪችራ ቤድና ስነራ ትሹና ካባኔን ማጝሱ ባሶስታ ካርእዋ። <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>ስኑንታኖ ቱማስሲ ፎንቶ ማጙ ዎስቶቤሲሲክ ድጌት ፌ ኦኮ ሎጥኒን ፉኤዋ። <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>ኤስ ኦኮ አሱ ባሶ ጋነያስሲ ፌና ካባሲክ ኦደት ፌና ባሪክናዋ ብየት ፌና ባሪክና ካባስ ዎንና ዎንና ራካቴት ፋር። <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>ኤሴ ሀን ባር ዙታምባሴ ኤካ ስንናኔን ዳሚስ ባሪን ሺጴት ፌሴ አሱኒ ሜያኖን ፋታናሲን ኣካክ ፉኦናማቶናዋ ቦርኒ ሜያኖን ደይ ኣካክ ኬኡናማቶናዋ ማጝሱኒ ካርኒ ዎናሲክ ኦደ ፌናማቶና አሪርዋ ኡዋ። <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>አሪክሮን ደይ ኪና ስና አሽኒ እጉቤሲሲክ ዞኑስቴት ሀኦሲ ሀእሱኒ ሁግናኖን ካሺት ፌሴ ባሶትን ማጝሱኒ ካርኒ ዎናሲክ ኦዳቱ ፋ። ኤስ ኤሽ አስኛኒ ሜያ ድጎኖርናዋ ቤጋንቴሴር ስንነቴ ቦርአ ደን ሳማኪ ኡልፍንቶ ቴስቶሲክቶኖን ሜኤሴፌ ካባሲክ ኣነ ድጌሴፌዋ። <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>ሀኦሲ ዎሲያኒክቶ ሁግናክናዋ ሀእሱክና ባሶስታን ደናሎ ስንነፌክኑ ዳሚሳ ስና ሜእኒ ካማክ ኣነ ማክሶቶዋ። <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>ስኑንታኖ ኤስ ኤሽ አስኛኒ ሜያ ያዳቶክ ችሞኖይቴ ዉዛሲክቱ ሜኤሴፌዋ። ኤስ ባሶ ኦድቶክናዋ ዎርቶክና ቴስቶኒ ሳፋራባሲክ ፋሴፋ ካኑባ ፎንቶ ዋጋስኔ ፌሴቴርዋ። ኤስ ዋጋሲክቶ ትሽፋናሲማቶ ባሶ ደይ ትሹሶነርዋ። <verse eid="2PE 2:12"/><verse number="13" style="v" sid="2PE 2:13"/>ዎስቴሴቴ ቦርኣሲክ ዋግቤሲሶን ኤጴቶሶነዋ፤ አሽቤሲሶን ግርሱክ ቶስታ ሱርሴፌ ካባሲክ ማአ ዉዛ ዛግሴሬቱ ፋድሴፌ። ንቶኔን አነ ሙሶነክ ቴግቴሴፌ ካባሲክ ዝናቤስ ፌናር ደይ ኪን ስነፌዋ። <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>ዎንና ዎንና ጌርኬስኒ ቦርኣሶን ሾሌት ፋ ኣፍቤሲ ፋርዋ። አማንቶሲክ ችምሜ የሮኖይ አሱኒ ሜያኖን ደይ ኤሸቴርዋ፤ ደይ ኤናንቴሴቴር፤ ዋጋ ጆሬሴቴር፥ ደይ ኤርዉቶ ሜያዋ። <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>ባሶ ማአ ኡግናሶን ቤየ ዳግሴሴቴዋ። ማጙ ዉዝኒ ዎስቶክ ቤስቴፋ ዋጋሶን ሹና ብኦርኒ ና ባላአምኒ ኡግናሲክቱ ሀሜቴዋ። <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>ስኑንታኖ ባላአም ቦርባሲ ቦርአ ሀኦስ ባሪን ኬእዋ። ዎሎክ ችምኖይ ሀኛስ አሱኒ ኖኖኒ ካማክ ዎል ሌራ ራጁኡሳ ንፋሶ ዎስቶኖን ዬትዋ።<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>ኤስ አሱኒ ሜያ አካባ ፎንቶ ኮርኣስነ ፌሴቴርዋ። እፑዋሲክ ቱግቴራ ሀምፋ ሻሩስነ ፌሴቴርዋ። ባሶትን አካማ ስትቱ ታልማስቱ ኦዳት ፋርዋ። <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>ዳጋክ ፌሴፌ አሱኒ ሜኒ ጋነያሲን ቴስሬ ኬሳ አሱኒ ሜያኖን ጌእኒ ካማ ማክሴፋፌ አሻክ እጉኒ ሳፋራክ ኤሸሴፌዋ። <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>ባሶ ቴትቤሲሲክ ቦርኣሲ ቦዝ ስንነሬ ፌፋት፦ «ብርማዱምማ ኬሳትርዋ» ይሴፋፌ ኬእኖይ አብድ እሜፌዋ። አሱ ሜርቴፌና ካባሲክ ኤስ ሜሬ ባሪክ ቦዝ ስንነ ዋግቴፌናሲማቶ ባሶ ደይ ቦርኣሲ ቦዝዋ። <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>ዳምኒስንናዋ እኖትን ፋቲ የሱስ ክርስቶስኒንና አሪሴሬ ሀን ዳስታኪ ኪናሲን ኦር ኬሴቴኔን ኦርፎ ሄፕሳ ዎል ሌ ኤስ ዜሞቲ ኪናሲክ ኦድቴሴሬ ሜርቴሴፋቴነ ዜሞቲስታን ደናሎ ሄፕሳኒ ባርቱ አካማኖን ባሶስታ ፋይኒርዋ። <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>ኦኮኒ ኡግናሶን አርሴቴነን ሀንካሎ ባሶክ እምቴ ኮርቶ አጃጂስታን ኦርፎ ዎልሶቤሲስታን ካቢ ቾዋ ኦኮኒ ኡግናሶን አሩ ሻክሴቴ ስንፋናነ ባሶክ ማአር ስናና ካባዋ። <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>«ካናስ ቶሽና ቶሻሶን ሙናክ ዎላ ሀምፋናሲማቶ» ደይ «ሙኮስ ማስቴናኔን ኦርፎ ዎላ ቻማሲ ቡካለፋናይሲማቶዋ» ይፋ ፉቶኒ ቤሶስ ባሶስታ ካርእዋ።<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">ዳሚሳ ዮኒ አብድ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>እንኖ ሜያነ! ሀሽ ታ ንቶክ ትቹናስ ሀን ሄፕሳኒ ዎስያሶጝዋ፤ ሀን ሄፕኒ ዎሲያሶን ንቶክ ትችናስ ኤስ ዉዛሲክቶኖን ያዳቶክ ማአ ሳፋራኒት ፎናክ ንቶትን ጉዝጉናክዋ። <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>ዜሞቲ ኮርቶ ራጁኒ ሜያ ማክሴቴ ካማሴዋ ንቶ ዎስኒ ሜያኪ ካሞ ዳነቲ ዳምኒ ደይ ሄትኒ ስና የሱስኒ አጃጂሴ አሲን ያዳቶትክ ሾሌፋዉጙዋ። <verse eid="2PE 3:2"/><verse number="3" style="v" sid="2PE 3:3"/>ዙታምባሴ አሲስታን ዜምማ ሀን ባሮን ያዳቶትዋ፤ ኮእኒ ነያስታክ ማጙ ኮሳ ኮሳየፌ ሜናዋ ባሶ ቴትኒ ማጙ ኤናንቶሲክ ዞኑስቶክ ካኜፌ ሜና ዮሶነርዋ። <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>ባሶ ደይ፦ «ዳም የሱስ ዮኒር ይስቴራ ማክቴ አብዲስ አይፋሶ? ዜሞቲ አባኒ ሜያ ክትሴቴኔን ሀጝ ቴስቶስ ቴስቴናኔን ካብራ ፋ ባር ኤኮባሴቱ ፋዋ» ይሴፌዋ። <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>ኤስ ባሶ ሾዎ ነያኔን ስናክ ሳማስ ሀኦሲ ካማክ ቴስቶባሶን፤ ዳስ ደይ ቴስቴናስ አካክንናዋ አካክና ስንባሶን አርፌቱ ሞርሜሴፌዋ። <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>ኤስ ባሪ ቦርኣ ኤስ ካባቲ ፋ ዳሶን አካ ኮርአ ትሽክዋ። <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>ሀኦሶን ሺጶ ቤየፌ አሱኒ ሜያ፤ ሀሽቲ ፋ ሳማሴዋ ዳሴ ትሹና ማጝሱኒ ካርኒ ዎናስታ ኤስ ካማሲክ ትሹናክ ጌያክ ሆሬራቱ ፋዋ።<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>እንኖ ሜያነ! ዳሚሲኪክ እሳ ዎናስ እሳ ኩማ ዎጋዋ፤ እሳ ኩማ ዎጋስ ደይ እሳ ዎና ስንናማቶ ኤስ ባሮን ዳጎትታዋ። <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>እሳ እሳ አሱኒ ሜያክ ዮናክ ዎክንርነ ፌር ስንነቱ ቤስቴፌዋ፤ ስኑንታኖ ዳሚስ አብድኒ ካምባሶን ዛጉክ ኣፋዋ ዎካና ዉዛ። ኦኑ ትሹኖይናማቶናዋ አሱ ዙታምባሴ ሀርምሴሬ ዎልሶነክ ሾሌፋትቱ ንቶ ቦርአ ፋክሬ ፌዋ።<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>ስኑንታኖ ዳሚሳ ዎና ዲንቆነ ዊስኒማቶቱ ዮናዋ። ኤስ ዎኖ ሀን ሳማሲክቶ አካማ ካማክቱ ትሹሶናዋ። ቴስቶ ዙታምባሴ ጌያክ ኪቼራ ትሹና። ሀን ዳሴዋ ባርስታ ፋሴ ዉዛሲክቶነ ዙቴራ ኪቾና። <verse eid="2PE 3:10"/><verse number="11" style="v" sid="2PE 3:11"/>ኤሴ ኤስ ዉዛሲክቶ ዙታምባሴ ኤሲስማቶ ትሹኒር ስንናኔን ኤኪን ንቶክ ኮርቶ ፎሴዋ ሀኦሶን ሺጴት ፎሴ ኣካክ ሾልሱ ሲና ቤይኒሪንሶ? <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>ኤሴ ሀኦሲ ዎን ኒ ዮኖን ካልታናክ ኦደት ፌርናዋ ታእኒን ደይ ዮናክ ዎስቴት ፌርና ስንትዋ። ኤስ ዎኖ ሳማስ ጌያክ ኪቼራ ትሹና፤ ቴስቶስ ደይ ጌያስሲ ኪቼራ ፋላና። <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>ስኑንታኖ እንኖ ባር እምና አብዲሲክ ኦኮ ፎስ ካፑቶና ጋድዶ ሳማሴዋ ጋድዶ ዳሴ አሲንቱ ኦደት ፋኒዋ። <verse eid="2PE 3:13"/><verse number="14" style="v" sid="2PE 3:14"/>ኤስ ባሪ ቦርኣ እንኖ ሜያነ! ኤስ ዉዛሲክቶ ስናና ዎናሶን ኦደት ፋትር ስንፋናነ ዳሚስ ዝናንቲ ወደይ ሙዳንት ፎንቶ ስንና ናጋክ ፋኒ ዳናናክ ጉዝራ ፎትዋ። <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>ዳሚሳ ፋኪያ ንቶ ፋሩትክ ስንናማቶ አሩትዋ። ሹንቶ አይኒ ጳዉሎስ ባሪክ እምቴ ቴችማሲማቶ ንቶክ ትችናስ ኤሲሶጝዋ። <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>ባር ኤስ ዉዛሲክ ባሳ ዎስያሲክቶኖን ሀኒሲማቶ ትችዋ። ዎስባሲክቶስን ደይ እሳ እሳስ ጋሎኖር ፋሴርዋ። አሩቤስ ዮእና ኤክ ሀጝ ይሴፌ ባሶ ኦማ ኦማ ኮርቶ ማፃፋሲክቶኖን ኤልጝስሴፌይሲማቶ ሀን ዉዛሲክቶኖን ደይ ኤልጝስሴፌዋ። ኤስ ባሮን ደይ ዛግሴፌስ ቴትቤሲሲክ ትሹሶነ ቦርኣዋ።<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>ስኑንታኖ እንኖ ሜያነ! ኤስ ባሮን ዜምማ አሪሴት ቦርአ ማጙኒ ሜኒ ዳግሱሲክ ዛቴራ ችምማ የሬቲ ባሪስታን ጋንዶኖይትማቶ ቴትኒትሶን ኦድትዋ። <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>ኤስ ባሪስታን ደናሎ ዳምኒ ደይ ሄትኒ ስና የሱስ ክርስቶስኒ ኦትማሲክናዋ ባሪን ደይ አሩክና ድችዋ። ባሪክ ሀሽኑ ኮእባ ፎንቶኖን ኡልፍና ስንፋውጝዋ፤ ኣሚን።<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
