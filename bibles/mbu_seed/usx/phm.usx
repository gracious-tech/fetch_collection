<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Mbula</book>
  <para style="h">Filimon</para>
  <para style="toc3">Film</para>
  <para style="toc2">Filimon</para>
  <para style="toc1">Filimon</para>
  <para style="mt2">Cauterǝa mala Bulǝs aban ká a ban</para>
  <para style="mt1">FILIMON</para>
  <para style="imt">Mǝncau</para>
  <para style="im">Cauterǝa mǝnia ka Bulǝs nǝ̀ gìlǝì lang nda aɓa ndàkurban a ɓè ban mǝnana à bangga sǝm lullǝi raka. Gilǝ cautera mǝnia ka aban ká aban Filimon, ɓè mǝkwaɗi mǝnana à súrǝì pepè, sǝ ɗǝm ngga nda mǝtala-ɓala mala ɓè guro mǝnana à tunǝki ama Onisǝmu ka. Onisǝmu ka ɓangŋa nying mǝtala-ɓala male, sǝ lang ngga, à yì je andǝ Bulǝs, mǝnana a bàkú mǝno ka nda a ndàkurban ngga. Onisǝmu yi pǝlǝ mǝkwaɗi nǝ bu Bulǝs. <char style="bk">Cautera mala Bulǝs aban ka aban Filimon </char> ngga zǝmba na aban Filimon ɓǝ̀ eare ɓǝa gilǝki nrea andǝ guro male, mǝnana Bulǝs na arǝ tasǝte ɓǝ̀ nyare a baní, sǝ ɗǝm ngga ɓǝ̀ kǝa gingsǝi kǝla guro mǝnana twalǝni wi banì nǝmurǝì ka ɗang, ɓǝ̀ gingsǝi gbal kǝla mǝ'eamrǝarǝu mǝkwaɗi. Sǝm súrǝ̀ ya gir nani Onisǝmu pa sǝ Filimon ɓinǝce ka ɗang, sǝama Bulǝs ka earǝna nǝ̀ mbweki Filimon gìr mǝnana kat gyajam male Onisǝmu kiɗiki wi ka. Kat andǝ amani ama Bulǝs nǝ̀ gandǝ paktúró nǝ rǝcandǝa male kǝla mǝ'mishan nǝ̀ tsǝk Filimon ɓǝ̀ pàk gìr mǝnana banggi wi ka, pè anggo ɗàng. A kun mani ka, earce nǝ̀ ɓuakiarǝi ɓǝ̀ pè aɓa earcearǝu.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Mǝn cau<char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char></para>
  <para style="io1">Ɓwangsǝban ace Filimon<char style="ior"><ref loc="PHM 1:4-7">1:4-7</ref></char></para>
  <para style="io1">Zǝmbǝa ace Onisǝmu<char style="ior"><ref loc="PHM 1:8-22">1:8-22</ref></char></para>
  <para style="io1">Masǝlǝata cau<char style="ior"><ref loc="PHM 1:23-25">1:23-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">Makkun nǝ ban Bulǝs</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Cauterǝa mǝnia ka pùr nǝban Bulǝs, ɓwa mǝnana ndǎ a ndàkurban ace hamnǝ Cau Amsǝban mala Kǝrǝsti Yesu ka, andǝ mǝ'eam sǝm Timoti.</para>
  <para style="p" vid="PHM 1:1">Mǝ nda ban gilǝì Filimon, gyajam ma'sǝm andǝ ɓi sǝm mǝtúró, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />andǝ mǝ'nggaula sǝm Afiya, andǝ Arkipus ɓi sǝm soje, andǝ ikǝlisiya mǝnana kǝ kpapi a ɓala mò ka.<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 4:17">Kol 4:17</ref></char>.</note><verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Ɓǝ̀ Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti pa wun ɓwamuru andǝ dorǝpwala.<verse eid="PHM 1:3" /></para>
  <para style="s">Yàwá andǝ hiwi mala Bulǝs</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />Ɓǝ̀ aya pwari mǝ nǝ pak hiwi ka, ǝn nggǝ pakki Ɓakuli mem yàwá aceo. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />Acemǝnana ǝn nggǝ ok ce paɓamuru mo arǝ Mǝtalabangŋo Yesu andǝ earcearǝu mo arǝ aɓwana mala Ɓakuli kat. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />Hiwi mem ngga nda mǝnana ama dotarǝu ma'sǝm sǝnǝ we kǝla amǝkwaɗi ka nǝ̀ yinǝ bwaltagìr mǝlime mala koya gìr mǝɓoarne mǝnana sǝm ndanǝi a do ma'sǝm aɓa kpapi ma'sǝm sǝnǝa Kǝrǝsti ka. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Earcearǝu mo panam banɓoarnado kǝ̀rkǝ́r andǝ girikiban, mǝ'eambam, acemǝnana pe mǝɓoarne mo yina nǝ bumpwasǝa a ban aɓwana mala Ɓakuli.<verse eid="PHM 1:7" /></para>
  <para style="s">Bulǝs zǝmba amur Onisǝmu</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Nda gìr mǝnana tsǝa sǝ mǝ ndanǝ ɓabumcandǝa, kǝla mǝ'eambo aɓa Kǝrǝsti, mǝnana mǝ nǝ cio wu pak gìr mǝnana ɓoaro wu pe ka. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Kat andǝ amani ka, mǝ nda rǝ zǝmbo ace earcearǝu, mim Bulǝs, mǝnana ǝn enà, sǝ ɗǝm adyan ngga mǝ nda aɓa kùrban ace Kǝrǝsti Yesu ka.<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">mǝnana ǝn enà, sǝ ɗǝm adyan ngga mǝ nda aɓa kùrban ace Kǝrǝsti Yesu ka: </char><char style="ft" closed="false">Ko &lt;&lt;mǝnana mǝ nda mǝ'pwantu mala Kǝrǝsti Yesu, sǝ ɗǝm adyan ngga mǝ nda kùró ace ka.&gt;&gt;</char></note> <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Mǝ ndarǝ zǝmbo, wu sǝn mǝsǝswatǝr mala munem Onisǝmu. Ən duk tárrí aɓa bangŋo akani aɓa ndàkurban. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />Ɗiɗyal ka, ɓwa mǝɓane na a bano, sǝ adyan ngga, dumǝna ɓwa mǝɓoarne a ban sǝm kǝm.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />Mǝ nda aban tasǝ te, ɓǝ̀ nyare a bano adyan. Ká male ka, ɓabumam nda atè. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />A eare mem ngga, mǝ nǝ bwali akani a banam ɓǝ̀ dupam gbasha a kuniò, aɓa kùrban mǝnia mǝ ndakam ace hamnǝ Cau Amsǝban ngga. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />Sǝ ǝn earce pàk kǝgìr mǝnana pa atārǝia andǝ eare mo raka ɗàng, ace mǝnana pe mǝɓoarne mo, ɓǝ̀ pur nǝ ɓabumo, ɓǝ̀ kǝa do ama à cio púp ɗang. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />Pa kǝla Onisǝmu ka, a ɗwanyibanì aɓalǝ anonggio bǝti, ace mǝnana a nǝ nggá kumi ɗǝm gauwa pa kàm raka. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />A dyan ngga, yì ka, pa kǝla guro ɗǝm ɗàng. Kutini bancame mala guro. A banam ngga, mǝ'eamrǝarǝu na mǝnana ǝn earkiyi ace raka, sǝ a bano ado ka nǝ̀ kútì mǝno, dumǝna kǝla ɓwa sǝ kǝla mǝ'eamrǝarǝu aɓa dotarǝu sǝnǝa Mǝtalabangŋo.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Ace mani ka, ɓǝ̀ a twalam kǝla ɓio mǝtúró ka, é, kǝla mǝnana a nǝ em ngga. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />Ɓǝ̀ pangŋǝno mǝɓane aɓa kǝ njar, ko a kǝ kpate tangna ka, ɗì ce a buam. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />Mim Bulǝs ka, mǝ nǝ̀ gilǝkiyi mǝnia yì cau ka nǝ buam. Mǝ nǝ mbweo, yàle ɓǝà kǝa bang cau mala yilǝmo mǝnana ǝn nggǝ kpato tangnè ka ɗàng. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />È, mǝ'eambam, ǝn nggǝ zǝmbo, lǝmdǝàm mǝnia yì earmúrú ka, ace Mǝtalabangŋo; kǝla mǝ'eambu aɓa Kǝrǝsti ka, ciem ɓabumam ɓǝ̀ nongŋo. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />Acemǝnana ǝn earǝna nǝ okiru mo ka, ǝn nggǝ gilǝo, nǝ sǝlǝe ama gìr mǝnana ǝn ɗikiyice a bano ka, a nǝ pak mǝnana kútì ka.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />Cau mwashat ɗǝm ngga, ida, gilǝki ban-sulǝo acem, acemǝnana mǝ ndanǝ tsǝkɓalǝu ama Ɓakuli nǝ̀ ak ahiwi ma'wun, sǝ à nǝ̀ panzǝam mǝ nyare a ban wun.<verse eid="PHM 1:22" /></para>
  <para style="s">Masǝlǝata makkun mala Bulǝs</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Abafǝras, ɓiam pursǝna ace Kǝrǝsti Yesu, kǝ túrban nǝ makkun male.<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 1:7">Kol 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>.</note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Sǝ anggo gbal, sǝ Markus, andǝ Aristakus, andǝ Dimas andǝ Luka, aɓiam amǝ'túrô.<note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 12:12">Atúró 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Kol 4:10</ref>,<ref loc="COL 4:14">14</ref>; <ref loc="2TI 4:10">2Tim 4:10</ref>,<ref loc="2TI 4:11">11</ref></char>.</note> <verse eid="PHM 1:24" /><verse number="25" style="v" sid="PHM 1:25" />Ɓǝ̀ ɓwamuru mala Mǝtalabangŋo Yesu Kǝrǝsti do atà bangŋo ma'wun.<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 51:12">Ang 51:12</ref></char> .</note><verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>