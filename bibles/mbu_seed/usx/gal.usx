<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Mbula</book>
  <para style="h">Amǝ Galati</para>
  <para style="toc3">Gal</para>
  <para style="toc2">Amǝ Galati</para>
  <para style="toc1">Amǝ Galati</para>
  <para style="mt2">Cauterǝa mala Bulǝs aban ká a ban</para>
  <para style="mt1">AMƏ GALATI</para>
  <para style="imt">Mǝncau</para>
  <para style="im">Lang amǝ'mishan tinata hamnǝ Cau Amsǝban amur Yesu Kǝrǝsti, sǝ aɓwana mǝnana amǝ Yahudi na raka, à nǝ̀ nggǝ ak ce ka, ɗiban yi lo ama, ko dumǝna púp she ɓǝ̀ ɓwa kpana atà Nggurcau mala Musa ka sǝ nǝ̀ pǝlǝ mǝkpata Yesu Kǝrǝsti le? Bulǝs angŋa dǝmba bǝlǝna ɓālǝi ama mǝnia ka pà kàm anggo ɗang. Sǝa ma aɓalǝ a'ikǝlisiya aɓa nggea-là Galati, a bu-nzali mala amǝ Asiya mǝkyauwe ka, aɓea aɓwana nda kam mǝnana à lo makgìr andǝ Bulǝs, à bang ama, dumǝna púp ɓwa nǝ̀ kpata Nzongcau mala Musa ace gilǝki do male pepe andǝ Ɓakuli.</para>
  <para style="ip">
    <char style="bk">Cauterǝa mala Bulǝs aban ká a ban amǝ Galati</char> ka à gilǝì ace mǝnana ɓǝà nyesǝ aɓwana mǝnana à kútí aɓa ɓosǝkiban mala mǝnia yì kanigir mǝ'nyirì ka, ɓǝà nyare aɓa pě andǝ kpata paɓamuru mǝ'mǝsǝcau nì aban Ɓakuli. Bulǝs bang kúni ama yì ka, mǝtúró mishan mala Yesu Kǝrǝsti na, sǝ mǝnia yì tunǝban male mala duk mǝ'mishan ace kánǝ Cau Amsǝban mala Ɓakuli aban aɓwana arǝ acili anzali ka, pur nǝ́ ban Ɓakuli, ɓwapǝndǝa na à twali ka ɗàng. Lǝmdǝí ama paɓamuru nǝmurǝì ɓǝ̀rɓǝ̀r aɓa Yesu Kǝrǝsti ka, nda nǝ̀ tsǝk aɓwana sǝ à nǝ̀ kum akban aban Ɓakuli ka. Ɗǝm ngga lǝmdǝì amǝkpata Yesu Kǝrǝsti, ulang ɓealu mana kǝ pur aɓa earcearǝu mǝnana kǝ yiu nǝban paɓamuru aban Kǝrǝsti ka. Kum panzǝban mǝ'mǝsǝcau nì kǝ yiu, ɓǝ̀ sǝm ak ɓoro mala ɓwamuru mala Ɓakuli nǝ bumpwasǝa, sǝ sǝm pa ɓamur sǝm aɓata Bangŋo, mǝnana pusǝkiyi aɓǝle aɓalǝ sǝm ngga.</para>
  <para style="iot">Gakkita acau mǝnana aɓalǝi ka</para>
  <para style="io1">Mǝn cau<char style="ior"><ref loc="GAL 1:1-10">1:1-10</ref></char></para>
  <para style="io1">Rǝcandǝa mala Bulǝs mala duk mǝ'mishan<char style="ior"><ref loc="GAL 1:11-2:21">1:11--2:21</ref></char></para>
  <para style="io1">Cau Amsǝban mala ɓwamuru mala Ɓakuli<char style="ior"><ref loc="GAL 3:1-4:31">3:1--4:31</ref></char></para>
  <para style="io1">Do ɓá panzǝban mala amǝkwaɗi andǝ túró malea<char style="ior"><ref loc="GAL 5:1-6:10">5:1--6:10</ref></char></para>
  <para style="io1">Masǝlǝata cau<char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Mǝnia yì cauterǝa ka, pur a banam, mim Bulǝs mǝ'mishan.</para>
  <para style="p" vid="GAL 1:1">Twalban mem a túró mishan ngga pur nǝban ɓwapǝndǝa ɗang, pur nǝ bu Yesu Kǝrǝsti andǝ Ɓakuli Tárrú, mana loasǝi yì Kǝrǝsti a ɓembe ka.<verse eid="GAL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 1:2" />Amǝ'eamrǝarǝu mǝnana sǝm nda kani sǝnǝia ka, sǝm nggǝ dapi bu aban tasǝ mǝnia yì cauterǝa ka, aban ká aban a'ikǝlisiya<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">a'ikǝlisiya: </char><char style="ft" closed="false">Ikǝlisiya ka, nda kpapi mala aɓwana mǝnana Ɓakuli tunǝia à nda ka mǝkpata Yesu Kǝrǝsti ka.</char></note> mǝnana a bu-nzali Galati ka.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Ɓǝ̀ Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti, lǝmdǝa wun ɓwamuru andǝ dorǝpwala. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Yesu pa yilǝmi ace acauɓikea ma'sǝm, kǝla mǝnana Ɓakuli Tár sǝm kani ka, ace mǝnana ɓǝ̀ amsǝ sǝm, a bu mǝnia yì nza mǝɓealɓike sǝm nda aɓalǝi ka. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Ɓwangsǝban kat ka, mala Ɓakuli na, mǝnana málá male pà kàm raka! Ɓǝ̀ do anggo.<verse eid="GAL 1:5" /></para>
  <para style="s">Cau Amsǝban mǝ'mǝsǝcau nì ka <optbreak /> nda mwashat ɓǝ̀rɓǝ̀r</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Ən nggǝ ndali nǝ kaurǝ ndǝli ma'wun arǝ Ɓakuli, mǝnana tunǝ wun nǝ ɓwamuru mala Kǝrǝsti, sǝ wu pǝlǝa wu kǝ kpata ɓekǝ cau ɗàng ngga. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Wu nda ban kpata ɓè &lt;&lt;cau amsǝban&gt;&gt; mǝnana a mǝsǝ sǝm ngga, kǝ cau amsǝban na raka. Aɓea aɓwana nda, à kǝ earce zurǝì mur wun, à nǝ̀ ɓosǝki ta Cau Amsǝban mala Kǝrǝsti ka. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Ɓǝ̀ súban mala Ɓakuli sulǝo amur ko ɓǝ̀ ya ɓwa nani, ko ɓǝ̀ sǝm nda, ko ɓǝ̀ mǝturonjar mǝnana a kùli nda ka, yi mǝnana ɓǝ̀ hamnǝ ɓe cau amsǝban sǝ pà mwashat andǝ mǝnana sǝm hamǝna wunì ɗiɗyal ka raka.<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 11:4">2Kor 11:4</ref></char>.</note> <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Kǝla mǝnana sǝm na wun a dǝmbe ka, ǝn nggǝ ɓǝsǝlǝi ɗǝm ama: Ɓǝ̀ ɓwa hamba wun nǝ ɓekǝ cau ama &lt;&lt;cau amsǝban&gt;&gt; na, sǝ nda ɗàng andǝ Cau Amsǝban mǝnana wu angŋǝni ka, ɓǝ̀ súban mala Ɓakuli sulǝo amur ɓwe.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Ado ka, ɓwangsǝban mala ɓwapǝndǝa nda ǝn alkiyite ka le, ko mala Ɓakuli? Ɓǝ̀ mǝ nda ban ɓariki mǝ nǝ pwasǝbum ɓwapǝndǝa ka, ɓǝ́ pà mǝ nǝ duk guro mala Kǝrǝsti ɗàng.<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1TH 2:4">1Tas 2:4</ref></char>.</note><verse eid="GAL 1:10" /></para>
  <para style="s">Ɓakuli nda tunǝ Bulǝs ɓǝ̀ duk <optbreak /> mǝtúró mishan ngga</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Wun amǝ'eamrǝarǝu, ǝn nggǝ earce nǝma ɓǝ̀ wu sǝlǝ ama, Cau Amsǝban mǝnia ǝn nggǝ hamnǝi ka, ɗenyicau mala ɓwapǝndǝa na ɗang.<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 1:16-17">Rom 1:16-17</ref></char>.</note> <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Ən ak cau mem a bu ɓwapǝndǝa ɗang, sǝ kǝɓwa nǝ̀ kaniam gbal ɗàng. Mǝnia yì cau ka, Yesu Kǝrǝsti nǝ̀ mǝnbam ɓālǝi nǝ nggearǝì.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Wu sùrǝ́nà rǝ pa mem ɗiɗyal, mǝnana mǝ nda ban peri, peri mala amǝ Yahudi ka, yi mǝnana ǝn pe ikǝlisiya mala Ɓakuli tanni kǝ̀rkǝ́r, yàle eare mem ngga nǝma ɓǝà mesǝkea ɓǝà ueɓà.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 8:3">Atúró 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>.</note> <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ən kutì aɓeam amǝlo kat aɓa peri mala amǝ Yahudi, sǝ mǝ ndanǝ ɓabumpina kǝ̀rkǝ́r arǝ kúncau mala aká sǝm.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 22:3">Atúró 22:3</ref></char>.</note> <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" /><note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 49:1">Isha 49:1</ref>; <ref loc="JER 1:5">Ir 1:5</ref>; <ref loc="ACT 9:3-6">Atúró 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref></char>.</note>Sǝ kaniama à nǝ̀ ɓǝ̀lám ngga, Ɓakuli tàram, sǝ tunǝam aɓata ɓwamuru male. Banɓoari wi <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />ɓǝ̀ lǝmdǝam Muni ace mǝnana ɓǝ̀ ǝn hamnǝ Cau Amsǝban male aban aɓwana arǝ aɓea nzali. Sǝ mim ngga ǝn alta kwarkiru mala kǝɓwa ɗàng. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Yàle ǝn wari ma a Urǝshalima nǝma mǝ nǝ nggá ok ɓè kǝcau a kun aɓwana mǝnana à akàm dǝmba aɓa túró mishan ngga ɗàng. A kun mani ka, ǝn o kporong aɓa nzali Arabiya, sǝ nǝnzǝ́mò ka, ǝn nyare a nggea-là Damaska.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Anzǝm apǝlǝa tàrú ka, ǝn wari a Urǝshalima, nǝma mǝ nǝ nggá sǝn Bitǝrus. Ən kya pakki anonggio lum-bwamdǝ-tongno abanì.<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 9:26-30">Atúró 9:26-30</ref></char>.</note> <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Ən sǝn kǝɓwa atà mǝ'mishan ɗàng, she kǝ Jemis, mǝ'eam Mǝtalabangŋo. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Mǝnia ka, mǝsǝcau na ǝn nakiya wun a ɓadǝm Ɓakuli ka, nyir pa aɓalǝi ɗàng.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Anzǝm mǝno ka ǝn wari arǝ aɓea ban aɓalǝ abu-nzali Suriya andǝ Sǝlisiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Kat andǝ amani ka, a'ikǝlisiya mǝnana à nda aɓa Kǝrǝsti a bu-nzali Yahudi ka, à súrǝàm a ɓamǝsǝam ɗàng. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Kǝgìr mǝnana à súrǝì ka nda kǝ cau mǝnana aɓwana kǝ na ama: &lt;&lt;Ɓwa mǝnana ɗiɗyal kǝ pa sǝm tanni ka, adyan ngga nda kǝ hamnǝ ce paɓamuru mǝnana ɓariki nǝ̀ kiɗiki ka.&gt;&gt; <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Pǝlǝa à ɓwangsǝ Ɓakuli atàcau mem.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">Amǝ'mishan ak Bulǝs</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Anzǝm apǝlǝa lum-nong-ine ka, ǝn nyare ǝn o a Urǝshalima ɗǝm sǝnǝ Barnabas, sǝm wari nǝ Titus atà sǝm.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 11:30">Atúró 11:30</ref>; <ref loc="ACT 15:2">15:2</ref></char>.</note> <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Ən wari kano, acemǝnana Ɓakuli nǝ̀ lǝmdǝàm ama ɓǝ̀ ǝn kyane. Akanó ka, sǝm kya kum do nǝmurǝ sǝm, sǝnǝ aɓwana mǝnana à twalia ama à nda ka aɓwana-mǝgule mala Ikǝlisiya ka. Pǝlǝa ǝn bǝlia wia ɓá Cau Amsǝban mǝnana ǝn nggǝ hamnǝi a ban aɓwana mala acili anzali ka. Eare mem nda mǝnana kun sǝm ɓǝ̀ duk mwashat, ace mǝnana ɓǝ̀ túró mem mǝnana ǝn pangŋǝni andǝ mǝnana ado mǝ nda rǝ pe ka, ɓǝà kǝa ue ɓà ɗang. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Sǝ yia ka, à earnǝ mim. Titus mǝnana ɓwa Gǝrik na ka, kǝɓwa tsǝì púp ama ɓǝà kasǝî wi ɓate ɗàng. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Mǝno yì cau ka lo, ace aɓea ɓwana mǝnana à na ama à nda ka amǝ kpata Yesu, sǝ ɓafo à nda raka. Yia ka, à kutio aɓalǝ sǝm zàng, à kǝ shenzǝki sǝm, à kǝ earce iu panzǝban mǝnana sǝm ndanǝi aɓa Kǝrǝsti Yesu ka. À kǝ ear ama à nǝ̀ nyesǝ sǝm ɓǝ̀ sǝm duk guro mala anggurcau mala amǝ Yahudi. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Sǝ sǝm ɓinǝ gbal kpékpé, sǝm nyinggia wia njargula ko bǝti ɗàng. Eare ma'sǝm ngga, ɓǝ̀ sǝm yál mǝsǝcau mala Cau Amsǝban ace wun.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 15:23-29">Atúró 15:23-29</ref></char>.</note><verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Sǝ amǝno yì aɓwana à twaliá ama à nda ka aɓwana-mǝgule mala ikǝlisiya ka, à pànǝ kǝ kàɓé cau mǝnana à nǝ̀ tsǝa amur cau mǝnana ǝn nggǝ hamnǝi ka ɗàng. Kat andǝ amani ama à nda ka aɓwana-mǝgule aɓa dǝmbam ngga, ǝn eari mǝno ɓǝ̀ ciem ɓǝ̀n nying kpata gìr mǝnana Ɓakuli lǝmdǝàm ngga ɗàng, ko bǝti, acemǝnana Ɓakuli ka, kǝ lǝmdǝ tàrban ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 10:17">Nggur 10:17</ref></char>.</note> <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Gìr mǝnana ndakam ngga, nda mǝnana ama, Ɓakuli panam túró hamnǝ Cau Amsǝban a ban aɓwana arǝ aɓea anzali, kǝla mǝnana Ɓakuli pê Bitǝrus hamnǝ Cau Amsǝban a ban amǝ Isǝrayila ka. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Kǝ Ɓakuli mǝ'mwashati, mǝnana pak túró nǝ Bitǝrus, tsǝì mǝ'mishan na aban ká a ban amǝ Isǝrayila ka, nda mǝnana pak túró nǝ mim, ciem mǝ'mishan aban ká gbal a ban aɓwana mala acili anzali ka. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Ɓafo, nggearǝ Jemis, sǝ Bitǝrus, sǝ Yohana, mǝnana à twalia ama à nda ka atanggea-nggun mala Ikǝlisiya ka, à sǝnǝna ɓwamuru mǝnana Ɓakuli pam mala túró mǝnia ka; pǝlǝa à ak sǝm sǝnǝ Barnabas, sǝm duk aɓia amǝ'túrô. À pu nzǝm sǝm aban hamnǝ cau a ban aɓwana mala aɓea anzali, sǝ yia ka à kutio atà túró a ban amǝ Isǝrayila. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Kǝ cau mǝnana à tsǝka sǝm a kir sǝm ngga nda mǝnana ama ɓǝ̀ sǝm nggǝ tsǝkir amǝ'tǝ̀r, sǝ mǝno ka, nda kǝgìr mǝnana mǝ ndanǝ bumpina ace ka.<verse eid="GAL 2:10" /></para>
  <para style="s">Bulǝs ɓinǝ ce gìr mana Bitǝrus pè</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Lang Bitǝrus yina a Antiyok ka, ǝn loa rǝì a ɓamǝsǝ ɓwapǝndǝa, acemǝnana gìr mana pè ka ɓoar ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 11:19-26">Atúró 11:19-26</ref></char>.</note> <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />A yiu male a dǝmba ka kǝ lili andǝ aɓwana amǝkwaɗi mǝnana amǝ Yahudi na raka, aɓwana mǝnana kǝgìr oasǝia arǝ cau mala kasǝ ɓatau raka. Sǝ nǝnzǝ́mò ka, lang aɓea amǝ Yahudi, agyajam mala Jemis yina ka, pǝlǝa yì, yì Bitǝrus ka, tamsǝ li girlina andǝ amǝ'eamrǝarǝu mana amǝ Yahudi na raka, tàr ɓamúrì zak nǝ yia. Yì ka, kǝ ɓanggi amǝ Yahudi mana à kǝ na ama ɓǝà kasǝi koya mǝkwaɗi ɓate ka. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Gìr nî tsǝk aɓea amǝkwaɗi mǝnana amǝ Yahudi na ka, à twal kusǝ ulang ɓua-kun-ɓari mala Bitǝrus, gandǝa à ɓosǝki kusǝ Barnabas nǝ ulang ɓealu mǝno.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />Lang ǝn sǝni à kǝ̀ kpata ɓafo mala Cau Amsǝban raka, pǝlǝa ǝn ne Bitǝrus a ɓamǝsǝ ɓwapǝndǝa bwāng ama:</para>
  <para style="pi" vid="GAL 2:14">We ka, a nda ɓwa Yahudi, sǝ a kǝ duk ulang do mala aɓwana mǝnana amǝ Yahudi na raka. Sǝ palang adyan, sǝ a kǝ earce tsǝk aɓwana mǝnana amǝ Yahudi na raka, ɓǝà duk ulang do mala amǝ Yahudi?<verse eid="GAL 2:14" /></para>
  <para style="s">Ɓwapǝndǝa kat kǝ duk amǝ <optbreak /> cauɓoarna a ban Ɓakuli <optbreak /> nǝ Paɓamuru</para>
  <para style="pi">
    <verse number="15" style="v" sid="GAL 2:15" />Mim sǝnǝ we, à ɓǝl sǝm ngga, sǝm nda ka amǝ Isǝrayila, sǝm nggǝ ɓǝsǝki nggurcau mala Musa kǝla aɓwana mǝnana amǝ Isǝrayila na raka, yia amǝ pakki acauɓikea ka ɗàng. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Kat andǝ amani ka, sǝm sǝlǝna ama, nǝ paɓamuru nǝmurǝì a ban Yesu Kǝrǝsti, sǝ ɓwa nǝ̀ duk mǝ cauɓoarna aban Ɓakuli,<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">ɓwa nǝ̀ duk mǝ cauɓoarna aban Ɓakuli: </char><char style="ft" closed="false">Ko &lt;&lt;ɓwa nǝ̀ kum akban aban Ɓakuli.&gt;&gt;</char></note> pa ace kpata anggurcau ɗàng. Nggearǝ sǝm gbal ka, sǝm pa ɓamur sǝm nǝ pa a ban Yesu Kǝrǝsti ace duk amǝ cauɓoarna a ban Ɓakuli, a ta cau mala gūlì arǝ Kǝrǝsti. Pa ace kpata nggurcau ɗàng. Nda acemǝnana kpata nggurcau ka, pà nǝ̀ tsǝk ɓwa ɓǝ̀ duk pepè a ɓadǝm Ɓakuli ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 143:2">Ang 143:2</ref>; <ref loc="ROM 3:20">Rom 3:20</ref></char>.</note><verse eid="GAL 2:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="GAL 2:17" />Sǝ mǝnana ɓǝà bang ama sǝm nda aban alta do mǝɓoarne aɓa Kǝrǝsti, sǝ à yì kum sǝm ngga, sǝm nda ka mǝ'cauɓikea ka, mǝnia ka, nǝ̀ do ama Kǝrǝsti pu nzǝm cauɓikea le? Awo, pa anggo ɗang! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Sǝa ma ɓǝ̀ ǝn nyare ǝn kutia kànî aɓwana njar mala nggurcau mala Musa mǝnana ǝn angŋa dǝmba ǝn nyingni ka, ǝn dumǝna mǝ yàl Nggurcau mala Ɓakuli. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Ɓǝ̀ ǝn ɓariki nǝma mǝ nǝ kpata nggurcau ka, ǝn yi sǝni ka, mǝno ka pà nǝ̀ pwasǝ bum Ɓakuli ɗang. Pǝlǝa ǝn wuki nggurcau, ǝn tamsǝ kpata nggurcau, ace mǝnana mǝ dupi Ɓakuli.<verse eid="GAL 2:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="GAL 2:20" />À gbàllìnam amur nggun-gangndǝi sǝnǝ Kǝrǝsti. Mǝ nda mǝnana ɗǝm nǝ yilǝmu ka ɗang, Kǝrǝsti nda mǝnana ado dukiyi a ɓalǝam ngga. Do mem aɓa nggūrǝu mala ɓanza ka, ǝn dum nǝ paɓamuru a ban Muna mala Ɓakuli mǝnana earcem, sǝ paɓamuri acem ngga.<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 1:4">Gal 1:4</ref>; <ref loc="PHP 1:21">Filp 1:21</ref></char>.</note> <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Ən būrǝce ɓwamuru mala Ɓakuli ɗang. Acemǝnana ɓǝ̀ kpata nggurcau nǝ̀ tsǝk sǝm, sǝm nǝ̀ duk amǝ cauɓoarna a ban Ɓakuli ka, lú mala Kǝrǝsti ka nda ɓà.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Njar mana ɓwa nǝ̀ duk <optbreak /> mǝ'cauɓoarna nǝi <optbreak /> a ɓadǝm Ɓakuli ka</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Wun amǝ Galati ka wu gǝmi fat! Yana ɓwe pyauta wun? Nda àkǝ̀ ɓamǝsǝ wun sǝ à bǝlki ce lú mala Yesu Kǝrǝsti amur nggun-gangndǝi. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Mǝ ɗì wun pe: Wu ak Bangŋo Mǝfele a njar mala kpata Nggurcau mala Musa lè, ko nda acemǝnana wu pà ɓamur wun arǝ cau mǝnana wu ok amur Kǝrǝsti ka?<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="ROM 10:17">Rom 10:17</ref></char>.</note> <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Palang sǝ wu ɓanggea anggo? Anzǝm mǝnana wu tinata do kpata Yesu aɓa Bangŋo mala Ɓakuli ka, wu kǝ earce ado ama wun nǝ̀ masǝlǝte aɓa nggūrǝu le? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Nggea tanni mǝnana wu nu aɓalǝ agir pas aban kpata Yesu ka, nda ɓà le? Kàngkàng nda ɓà le? <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Mǝ nǝ ɗì wun ɗǝm ngga, Bangŋo Mǝfele mǝnana Ɓakuli pa wun, sǝ pàkki agir-ndǝlǝki aɓalǝ wun ngga, nda acemǝnana wu kpata Nggurcau mala Musa ka le, ko nda acemǝnana wu pà ɓamur wun arǝ Cau Amsǝban mana wu ok amur Kǝrǝsti ka?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Wu sǝni ani arǝ cau mala Ibǝrayim. Malǝmce mala Ɓakuli ka bang ama, &lt;&lt;Ibǝrayim earnǝ Ɓakuli, sǝ atàcau mala mǝno yì gūliarǝu male arǝ Ɓakuli ka, Ɓakuli nyesǝi mǝ'cauɓoarna na.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 15:6">Tite 15:6</ref>; <ref loc="ROM 4:3">Rom 4:3</ref></char>.</note> <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Ɓoaro ɓǝ̀ wu sǝlǝ ama amuna mala Ibǝrayim ngga, à nda ka aɓwana mǝnana à pà ɓamuria aban Ɓakuli, à earnǝi ka.<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="fq" closed="false">amuna mala Ibǝrayim: </char><char style="ft" closed="false">Ɓakuli tàr Ibǝrayim aɓalǝ aɓwapǝndǝa, sǝ anggo ka, à earǝna nǝi ama ɓwa mǝnana muna mala Ibǝrayim na ka, yì gbal ka muna mala Ɓakuli na (sǝn cau mǝnana à gilǝì a nzali a tǝta 3:29.)</char></note> <note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 4:16">Rom 4:16</ref></char>.</note> <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Malǝmce ak dǝmba bang ɗiɗyal ama, Ɓakuli nǝ̀ ak aɓwana mala acili anzali, à nǝ̀ pǝlǝ amǝ'cauɓoarna, ace paɓamuru malea a baní. Nda sǝ ak dǝmba ne Ibǝrayim mǝnia yì bǝsa cau mǝɓoarne ama, &lt;&lt;Aɓwana arǝ anzali kat ka, à nǝ̀ kum tsǝkbu mem nǝ bano.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:3">Tite 12:3</ref>; <ref loc="GEN 18:18">18:18</ref>; <ref loc="GEN 22:18">22:18</ref></char>.</note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Nda gìr mǝnana tsǝa sǝ aɓwana mana à pà ɓamuria aban Kǝrǝsti ka, à kum lùmsǝo mala tsǝkbu mǝ'mwashati mǝnana Ibǝrayim kùmô, nǝ́ paɓamuru male aban Ɓakuli ka.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Sǝ aɓwana mǝnana à makɓalǝia arǝ bwal Nggurcau ace kum akban a ɓadǝm Ɓakuli ka, à nda aɓata súban. Malǝmce ka na ama, &lt;&lt;Súban nda amur ɓwa mǝnana kat pà nǝ̀ kpata anzongcau mǝnana kat à gilǝia aɓa Malǝmce Nggurcau mala Ɓakuli raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 27:14-26">Nggur 27:14-26</ref></char>.</note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Ado ka, pusǝna rǝì a banfana ama kǝɓwa pà nǝ̀ kum akban a ɓadǝm Ɓakuli nǝ ɓariki mala bwal Nggurcau ɗàng. Acemǝnana Malǝmce na ama, &lt;&lt;Ɓwa mǝnana duk mǝ'cauɓoarna aban Ɓakuli nǝ́ paɓamuru a baní ka, nda nǝ̀ kum yilǝmu ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="fqa" closed="false">Ko &lt;&lt;Mǝ'cauɓoarna ka nǝ́ gūlì arǝ Ɓakuli sǝ nǝ̀ àwá.&gt;&gt; Ko &lt;&lt;Mǝ'cauɓoarna ka nǝ́ paɓamuru aban Ɓakuli sǝ nǝ̀ àwá.&gt;&gt; Ko &lt;&lt;Ɓwa mǝnana kumǝna akban aban Ɓakuli ka, nǝ paɓamuru male aban Ɓakuli sǝ nǝ̀ àwá.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HAB 2:4">Hab 2:4</ref></char>.</note> <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Túró mala Nggurcau ka à kwákítè amur gūliarǝu ɗang. A kún mani ka, cau male ka na ama, &lt;&lt;Ɓwa mana bwal Nggurcau, kpata anzongcau male kat-kat ka, nda nǝ̀ au ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 18:5">Pǝris 18:5</ref></char>.</note> <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />Sǝa ma do mana Kǝrǝsti yi duk sú-ɓwa ace sǝm ngga, angŋǝna múr sǝm a ɓabù súban mǝnana Nggurcau yinǝi ka. Acemǝnana à gilǝa aɓa Malǝmce ama, &lt;&lt;Súban nda amur koya ɓwa mǝnana à gyari a nggun ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 21:23">Nggur 21:23</ref></char>.</note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Kǝrǝsti akmúr sǝm ace mǝnana tsǝkbu mǝ'mwashati mǝnana Ɓakuli banggi Ibǝrayim ama nǝ̀ tsǝki wi ka, ɓǝ̀ yiu amur aɓwana arǝ anzali kat, nǝ bu Kǝrǝsti Yesu. Acemǝnana sǝm mana sǝm nda ka amǝkwaɗi ka, sǝm nǝ̀ gandǝ ak pàcau mala Bangŋo Mǝfele nǝ paɓamuru.<verse eid="GAL 3:14" /></para>
  <para style="s">Kùrcau mala Ɓakuli kútì <optbreak /> Nggurcau mala Musa</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Wun amǝ'eamrǝarǝu, mǝ mǝnba wun ɓá mǝnia yì cau ka arǝ do mala ɓwamǝpǝndǝe: Kǝla mana ɓwa pà nǝ̀ gandǝ yâl cau mǝnana à earna amurí, ko nǝ̀ yiu nǝ ɓekǝ cau ɗàng ama nǝ̀ tsǝa amurí nǝ̀ nggaɗi raka, anggo sǝ mǝnia pa.<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="fqa" closed="false">Kǝla mana ɓwa pà nǝ̀ gandǝ yâl cau mǝnana à earna amurí, ko nǝ̀ yiu nǝ ɓe kǝ cau ɗàng ama nǝ̀ tsǝa amurí nǝ̀ nggaɗi raka: </char><char style="ft" closed="false">Ko &lt;&lt;Ɓǝ̀ ɓwa pànà cau mala eare male ka, ɓeɓwa ɗàng pà nǝ̀ gandǝ nggaɗi ko nǝ̀ kasǝì ɗang.&gt;&gt;</char></note> <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Ɓakuli pa cau male aban Ibǝrayim andǝ muni. Sǝni pepè, Malǝmce ne ma ama, &lt;&lt;wunǝ amunio&gt;&gt; ɗàng, mǝnana nǝ̀ lǝmdǝ ama à nda pas ka. Awo, bang ama &lt;&lt;wunǝ munio&gt;&gt;, mǝnana lǝmdǝ ama nda aban nacau amur ɓwa mwashat. Sǝ ɓwa mwashat mǝnia ka, nda Kǝrǝsti.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 24:7">24:7</ref></char>.</note> <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Mǝnia ka nda gìr mǝnana ǝn nggǝ earce ne ka: Ɓakuli kùrcau aban Ibǝrayim, sǝ bangŋǝna ama cau male ka nǝ̀ lumsǝì. Nggurcau mǝnana Ɓakuli yi pa, nǝ bu Musa anzǝm mana apǝlǝa gbǝman-ine nǝ lumi-tàrú (430) kutikina ka, pà nǝ̀ kasǝ mǝno yì kùrcau, sǝ nǝ̀ nyesǝ pacau mala Ɓakuli ɓǝ̀ duk ɓà ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:40">Pur 12:40</ref>,<ref loc="EXO 12:41">41</ref></char>.</note> <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Ɗenyi ama ɓǝ̀ nda acemǝnana sǝm bwal nggurcau mala Ɓakuli ka sǝ kǝ pa sǝm liɓala mǝnana pà cau ace ama nǝ̀ pa sǝm ngga, à pà nǝ̀ bang ɗǝm ama nda acemǝnana pà cau ka sǝ nǝ̀ pa sǝm liɓala ka ɗàng. Sǝa ma, Ɓakuli aɓa ɓwamuru male ka, pè Ibǝrayim mǝnia yì liɓala mana pà cau ace ka, acemǝnana bangŋǝna ama nǝ̀ pè wi.<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 4:14">Rom 4:14</ref></char>.</note><verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Sǝ mana ɗe nda tǝ́r pa Nggurcau? Ɓakuli pa Nggurcau nǝnzǝ́mò, ace mǝnana ɓǝ̀ lǝmdǝì ɓwapǝndǝa acauɓikea malea. Sǝ Nggurcau ka à tsǝì ama ɓǝ̀ pak túró ɓǝ̀ kya bik pwari yiu mala mǝno yì muna mala Ibǝrayim, mǝnana Ɓakuli pa cau ace ka. Ɓakuli pa Nggurcau male nǝ bu amǝturonjar aban Musa, mǝnana do a nre ka aɓwana andǝ Ɓakuli ace banggia wia cau mala Nggurcau ka. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Ɓǝ̀ aɓwana ɓari kùrcau ka, à kǝ alta ɓwa mǝnana nǝ̀ cam a nrea ka. Sǝ Ɓakuli mana nda mwashat ka, alta kǝɓwa atè aɓa pàcau male aban Ibǝrayim ɗàng.<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Sǝ ado ka, à nǝ̀ na ama Nggurcau Mala Musa andǝ kùrcau mala Ɓakuli ka à ɓinǝ rǝarǝia le? Awo, ko bǝti! Ɓǝ̀ Nggurcau nǝ̀ gandǝ pa sǝm bǝsa yilǝmu ka, ɓǝ́ kpatè ka nǝ̀ nyesǝ sǝm, ɓǝ̀ sǝm duk amǝ'cauɓoarna aban Ɓakuli. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Sǝ Malǝmce ka, bang ama sǝm kat ka, sǝm nda aɓata kùrban mala cauɓikea. Kǝ njargula mǝnana sǝm nǝ̀ kum panzǝban nǝi, mǝnana Ɓakuli pà cau ace ka, nda mǝnana ama ɓǝ̀ sǝm pà ɓamur rǝ sǝm aban Yesu Kǝrǝsti ka.<verse eid="GAL 3:22" /></para>
  <para style="s">Sǝm nǝ̀ duk amuna mala <optbreak /> Ɓakuli nǝ paɓamuru a baní</para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Kaniama njargula paɓamuru aban Kǝrǝsti ɓǝ̀ yiu aban sǝm ngga, à bwal sǝm aɓata kùrban mala Nggurcau. À kasǝ kún sǝm bà yiu mala yì paɓamuru ɓǝ̀ yi lǝmdǝ rǝì ɓǝ̀ sǝm súrǝì. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Mǝ nǝ tsǝì a ɓè njar ani: Nggurcau ka nda bwala sǝm gara aban ká a ban Kǝrǝsti ka. Yál sǝm bà pwari mǝnana à nyesǝ nre sǝm yi ɓoar sǝnǝa Ɓakuli nǝ́ gūlì arǝ Kǝrǝsti ka. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Sǝ adyan mǝnana njar mala gūlì arǝ Kǝrǝsti yina ka, sǝm pà aɓata yálban mala Nggurcau ɗǝm ɗàng.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Ace mani ka, wun kat ka, wu nda ka muna mala Ɓakuli ace gūlì ma'wun arǝ Kǝrǝsti Yesu. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Sǝ aɓwana mǝnana kat à kum kpapi andǝ Kǝrǝsti aɓa batisǝma ka, à túrna Kǝrǝsti a rǝia kǝla túr bǝsa daura a rǝǔ. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Kǝ cau pà kàm ɗǝm ama ɓwa man ngga ɓwa Isǝrayila na ko ɓwa Isǝrayila na raka ɗàng, ɓwa man ngga guro na ko guro na raka ɗàng, ɓwa man ngga ɓwabura na ko ɓwama na ka ɗàng. Wun ado ka, wu dumǝna mwashat aɓa Kǝrǝsti Yesu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Sǝ ado mǝnana wu dumǝna a mala Kǝrǝsti ka, wu nda ka amuna mǝɓafoe mala Ibǝrayim.<note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="fq" closed="false">wu nda ka amuna mǝɓafoe mala Ibǝrayim: </char><char style="ft" closed="false">Bulǝs banggi amǝ Galati ama paɓamuru aban Yesu Kǝrǝsti ka, nda gìr mǝnana tsǝkiyi ɓwa ɓǝ̀ duk muna mǝɓafoe mala Ibǝrayim andǝ mala Ɓakuli ka. (Sǝn cau mǝnana à gilǝì a nzali a tǝta 3:7.)</char></note> Wu nda ka amǝliɓala, sǝ pàcau mala Ɓakuli aban Ibǝrayim ngga, dumǝna ma'wun.<note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 4:13">Rom 4:13</ref></char>.</note><verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Wu sǝni ani: Ɓǝ̀ tárrú wú, sǝ nyinggi amuni mǝkèke ɓala ka, amǝno yì amuna ka kǝgìr gauwia andǝ guro-ɓala ɗàng. À nda aɓata ɓwa mǝnana à pè wi yál ɓala ka, she ɓǝà gulkina ka, kat andǝ amani ama, à nda ka amǝtala kume mala tárrià kat ka. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Dumǝnia wia púp ɓǝà okî amǝ'lǝsǝban, she ɓǝà kya bwalǝna pǝlǝa mǝnana tárrià kasǝ ka. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Kaniama Yesu nǝ̀ yiu ka, anggo gbal sǝ sǝm pa. Sǝm nda kǝla amuna, aguro mala abangŋo mǝnana ado à bwal ɓanza mǝnia ka. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Sǝama, lang pwari nì yi kārǝ́na ka, Ɓakuli túr Muni, mǝnana ɓwama nǝ̀ ɓǝli ka, aɓata nggurcau mala Musa. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />Ɓakuli túrí, ace mǝnana ɓǝ̀ yi akmúr aɓwana mǝnana à nda ka aguro mala nggurcau ka, ace mǝnana sǝm ngga ɓǝ̀ sǝm kum bancame mala duk amuna male.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 8:15-17">Rom 8:15-17</ref></char>.</note> <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Sǝ acemǝnana sǝm nda ka amuni ka, Ɓakuli tasǝ Bangŋo mala Muni a ɓabum sǝm, mǝnana kǝ tsǝk sǝm, sǝm nggǝ tunǝi ama, &lt;&lt;Dâ, Tárrám.&gt;&gt; <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Ado ka, wu nda ka guro ɗǝm ɗàng, wu nda ka muna mala Ɓakuli. Sǝ acemǝnana wu nda ka muni ka, Ɓakuli tsǝ́ngŋǝ̀nà wu dumǝna amǝliɓala male.<verse eid="GAL 4:7" /></para>
  <para style="s">Gìr mǝnana kwan Bulǝs arǝ <optbreak /> amǝ Galati ka</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Ɗiɗyal, mǝnana wu malaká súrǝ̀ Ɓakuli raka, wu nda ka aguro mala agir mǝnana aɓa mǝsǝcau ka a Ɓakuli na raka. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Sǝ ado mǝnana wu sùrǝ́nà rǝ Ɓakuli, ko a na raka, Ɓakuli súrǝ́nà rǝ wun ngga, palang sǝ wu kǝ earce nyar nǝ ta wun, wun nǝ̀ duk aguro mala alú andǝ akukwar mala ɓanza man, mǝnana à pànǝ kǝ rǝcandǝa raka? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Wu nda aban ɓariki wun nǝ̀ alta dǝmcauwa a ban Ɓakuli nǝ kpata pàkkia alamsan mala aɓea apwari, ko azongŋo, andǝ akunaban, andǝ apǝlǝa. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Wu kǝ pam ɓangciu, ɓǝà kǝa na ama nggea gandǝa mem mana arǝ wun ngga nda ɓà ɗàng.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Wun amǝ'eamrǝarǝu, ǝn nggǝ zǝmba wun, wu do ulang do mem, do gapitarǝu nǝ amǝnia yì agir ka. Nggearǝ mim ngga, ǝn pǝlǝna kǝla wun, wun aɓwana mǝnana wu nda ka amǝ Isǝrayila raka, mǝnana sǝm pà aɓata anggurcau raka. A dǝmbe mǝnana ǝn hamnǝ Cau Amsǝban a ban wun ngga, wu pàkkam kǝgìr mǝɓane ɗàng. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Wu sǝlǝ ama, a nggea dǝmbe mǝno ǝn hamnǝ Cau Amsǝban a ban wun ngga, mǝ ndanǝ rǝkwana a rǝàm. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Kat andǝ gir mǝnana mǝ nda aɓalǝi aɓa nggūrǝam, ɓǝ́ nǝ̀ tsǝk wun, wun nǝ̀ ginǝam, wun nǝ̀ nyesǝ cem ɓà ka, wu ginǝam ɗang. Yàle, wu gingsǝam, wu ɗenyi nǝ mim, kǝla ɓè mǝturonjar mǝnana sulǝ nǝ ban Ɓakuli ka, sǝ wu em kǝla mǝ nda Kǝrǝsti Yesu nǝ nggearǝì. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Sǝ bumpwasǝa mǝnana wu ndanǝi ɗiɗyal ka, nda mǝ ye le? Ən sǝlǝna nǝma ɓǝ̀ nǝ̀ gandǝ pa ka, ɓǝ́ wun nǝ̀ pusǝki amǝsǝ wun, wun nǝ̀ pam mia. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Ado ka, ǝn pǝlǝna ɓi wun mǝbura acemǝnana ǝn nggǝ na wun mǝsǝcau ka le?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Amǝno yì amǝkànìgìr mǝ'nyir nì ka, à ndanǝ rǝɓǝla arǝ alta ɓabum wun, sǝ ɗenyicau malea a ban wun ngga, mǝɓoarne na ɗang. À kǝ ɓariki ama ɓǝ̀ sǝm gau sǝnǝa wun, ace mǝnana kǝ̀ yia nda ɓǝ̀ wu kǝ okia wia ka. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Ɓǝ̀ kǝɓwa ndanǝ rǝɓǝla mala pàkka wun mǝɓoarne ka, ɓoaro na gir nì ɗàng, sǝama ɓǝà kǝ̀ pê pwari-pwari. Ɓǝà kǝa na ama, she pwari mǝnana mǝ nda a ban wun ngga, sǝ à nǝ̀ pàkka wun ɗàng. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />Wun amunem mǝnana ǝn earkiyi acea raka! Ən nggǝ ok kwanban a rǝàm ace wun, kǝla ɓwama mǝnana nda aban gbáshí ka, sǝ mǝno ka pà nǝ̀ mal ɗang she ɓǝ̀ Kǝrǝsti lùmsǝ̀nà aɓalǝ wun ngga. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Ən earǝnace nǝma, ɓǝ́ mǝ nda aban wun ado, ace mǝnana mǝ ɓunba wun giem. Sǝ ado ka, ǝn súrǝ̀ gir mǝnana mǝ nǝ pa ace wun ngga ɗàng.<verse eid="GAL 4:20" /></para>
  <para style="s">Kanicau arǝ amuna mala <optbreak /> Ibǝrayim mǝnana yia ɓari ka</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Wun aɓwana mǝnana wu earce do aɓata Nggurcau mala Musa ka, kàngkàng wu súrǝ̀ gir mǝnana Nggurcau nakiyi ka? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Malǝmce na ama, Ibǝrayim ngga ndanǝ amuna ɓari, man mwashat ka, à ɓǝl andǝ mā-guro male, sǝ man mwashat ka, à ɓǝl andǝ mā-ala male, mǝnana guro na raka.<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 16:15">Tite 16:15</ref>; <ref loc="GEN 21:2-3">21:2-3</ref></char>.</note> <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Muni mǝnana nǝ bu mā-guro ka, à ɓǝli aɓa ɓariki mala ɓwapǝndǝa. Sǝ muni mǝnana nǝ bu mā-ala male ka, à ɓǝli kǝla lùmsǝo mala pàcau mala Ɓakuli.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Amǝnia yì agir ka, à nǝ̀ twalia kun-ndunocau na. Amamǝna mǝnia ɓari ka, à do a kun akùrcau mala Ɓakuli mana ɓari ka. Ɓwama mǝdǝmbe yì Hajara ka, cam a kún kùrcau mana à pà a Nkono Saina, mǝnana kǝ ɓǝl amuna mǝnana aguro mala nggurcau na ka. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Sǝ Hajara, mǝnana cam a kunì Nkono Saina a nzali Arabiya ka, nda lǝmdǝ nggea-là Urǝshalima mǝnana ado ka, acemǝnana yì andǝ aɓwana male ka, à nda ka guro, aɓata nggurcau. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Sǝ ɓe ɓwama man yì Saratu ka, nda kǝla Urǝshalima, mǝnana a kùli ka. Yì ka, guro na ɗang. Sǝ Urǝshalima mǝnana a kùli ka, nda nggea sǝm kat. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Kǝla mǝnana mǝɓangnǝa mala Ɓakuli yì Ishaya na ama:</para>
  <para style="q1" vid="GAL 4:27">&lt;&lt;Pak banɓoarnado,</para>
  <para style="q2" vid="GAL 4:27">we nkombi,</para>
  <para style="q1" vid="GAL 4:27">mǝnana à kǝ ɓǝl muna raka!</para>
  <para style="q1" vid="GAL 4:27">Mak-yalang,</para>
  <para style="q2" vid="GAL 4:27">ace bumpwasǝa,</para>
  <para style="q1" vid="GAL 4:27">we ɓwan a ok kwanban</para>
  <para style="q2" vid="GAL 4:27">mala gbáshí raka!</para>
  <para style="q1" vid="GAL 4:27">Acemǝnana ɓwama mana</para>
  <para style="q2" vid="GAL 4:27">burí ginǝki o ɗeki ka,</para>
  <para style="q1" vid="GAL 4:27">adyan ngga ndanǝ amuna pas,</para>
  <para style="q2" vid="GAL 4:27">à kutini mala ɓwama mana</para>
  <para style="q1" vid="GAL 4:27">burí ɗeki raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 54:1">Isha 54:1</ref></char>.</note><verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Sǝ ado ka, wun amǝ'eambǝam, wu nda ka amuna mala kùrcau, kǝla mana Ishaku pàk ka. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Muna mana à ɓǝli nǝ ɓariki mala ɓwapǝndǝa ka, pè Ishaku, yì muna mǝnana à ɓǝli nǝ rǝcandǝa mala Bangŋo mala Ɓakuli ka, tanni. Anggo gbal yalung ngga, aɓwana mǝnana à kǝ earce ama ɓǝ̀ wu kpata nggurcau ka, à kǝ pa wun tanni.<note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:9">Tite 21:9</ref>,<ref loc="GEN 21:10">10</ref></char>.</note> <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Sǝ mana Malǝmce na amurí ɗe? Na ama, &lt;&lt;Pǝr mā-guro andǝ muni, acemǝnana muna mala mā-guro ka, pà nǝ̀ kpapi atà liɓala andǝ muna mala mǝtala ɓala ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:10">Tite 21:10</ref></char>.</note> <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Ace mani ka, wun amǝ'eamrǝarǝu, sǝm ngga, sǝm nda ka amuna mala mā-guro ɗàng; sǝm nda ka amuna mala mā-ala mana à ɓǝli aɓa do ɓamuru ka.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Panzǝban aɓa Kǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Nda acemǝnana ɓǝ̀ sǝm kum do-ɓamúrû ka sǝ Kǝrǝsti panzǝ sǝm; ace mani ka, wu cam kàngkàng aɓa mǝnia yì panzǝban ngga, wu kǝa nyesǝ ɓamur rǝ wun ɗǝm a ɓata nggun-rya mala doguro ɗàng.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Wu kwaki kir wun! Mim Bulǝs ǝn nggǝ na wun mǝnia yì cau ka: Ɓǝ̀ wu eare à kasǝ aɓata wun ama, nda gìr mǝnana nǝ̀ tsǝk ɓwa ɓǝ̀ duk pepè a ɓadǝm Ɓakuli ka, lǝmdǝ ama Kǝrǝsti ka nda ɓà a ban wun. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Ən nggǝ ɓǝsǝlǝa wuni ɗǝm ama, ɓwa mǝnana kpata nzongcau mala kasǝ-ɓatau ka,<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fq" closed="false">ɓwa mǝnana kpata nzongcau mala kasǝ-ɓatau ka, </char><char style="ft" closed="false">Ko &lt;&lt;ɓwa mǝnana kǝ alta kum akban aban Ɓakuli nǝ kpata nzongcau mala kasǝ-ɓatau ka,&gt;&gt;</char></note> dumǝni wi púp ɓǝ̀ kpata anzongcau mala Musa kat. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Acemǝnana ɓǝ̀ wu kǝ ɓariki ama, wun nǝ̀ kum akban a ban Ɓakuli nǝ kpata Nggurcau ka, wu gauwuni tarǝ wun wunǝi yì Yesu, wu purni ɓata ɓwamuru mala Ɓakuli. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Sǝ sǝm ngga, ace paɓamuru ma'sǝm a ban Kǝrǝsti ka, sǝm tsǝk ɓalǝ sǝm, sǝm nggǝ kúndǝô nǝ rǝɓǝla ɓǝ̀ Ɓakuli ak sǝm, ɓǝ̀ nyesǝ sǝm ɓǝ̀ sǝm duk pepè a ɓadǝmbi nǝ Bangŋo male. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Ɓǝ̀ ɓwa tsǝ̀ngŋǝ̀nà paɓamuru male a ban Kǝrǝsti Yesu ka, ɓekǝ girkuma pà kàm aɓa kasǝ-ɓatau, ko ɗwanyi kasǝ-ɓatau ɗàng. Gìr mǝnana ɓoaro à nǝ̀ na ce ka nda kǝ paɓamuru mǝnana kǝ lǝmdǝ rǝì aɓa earcearǝu ka.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 7:19">1Kor 7:19</ref>; <ref loc="GAL 6:15">Gal 6:15</ref></char>.</note><verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Wu tite ka, wu nda arǝ lidǝmba pepè. Sǝ yana yi tamsǝ wun ɗǝm arǝ kpata mǝsǝcau? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Mǝno yì swarkiban ngga, à pà nǝ̀ na ama pur nǝban Ɓakuli ɗang, acemǝnana yì nǝ̀ tunǝ wun sǝ yinǝ wun aɓa panzǝban. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Kànìgìr mǝ'nyir nì ka, nda kǝla yist mǝnana bǝti ka, nǝ̀ aki ɓá dyar bǝredi kat, nǝ̀ tsǝì ɓǝ̀ vwali ka.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 5:6">1Kor 5:6</ref></char>.</note> <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Mǝ ndanǝ makɓalǝu arǝ Mǝtalabangŋo ama pà wun nǝ̀ ɓinǝ cau mem, wun nǝ̀ earnǝ ɓekǝ cau ɗàng. Ɓakuli nǝ̀ ɓashi mǝno yì ɓwa kǝ zurǝki kusǝ wun ngga, ko ɓǝ̀ yì nda yan ngga.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Wun amǝ'eamrǝarǝu, ɓǝà bang ama ado mǝno ka, cau mala kasǝ-ɓatau nda ǝn nggǝ hamnǝi più ka, palang sǝ mǝ nda aɓa nutanni a bu amǝ Yahudi? Sǝ ɓǝ̀ nda anggo ka, hamnǝ Cau Amsǝban mala Kǝrǝsti Yesu mǝnana ǝn nggǝ hamnǝi amur lú male a nggun-gangndǝi ka, ɓǝ́ pà nǝ̀ yinǝ bumkiɗikea a ban amǝ Yahudi ɗàng. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Yàle eare mem ngga nggearǝ aɓwana mǝnana à kǝ pa wun tanni, à kǝ zurǝki kusǝ wun nǝ cau mala kasǝ-ɓatau ka, ɓǝà jamsǝ ɓamuria, ɓǝà duk abaran nǝ yia.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Wun amǝ'eambǝam, à tunǝ wun ace mǝnana ɓǝ̀ wu yi do aɓa panzǝban. Sǝama wu kǝa na ama wun nǝ̀ nyesǝ dopanzǝban mǝnana wu kùmô à panzǝ wun arǝ Nggurcau ka, ɓǝ̀ dupa wun njargula kpata anpel mala nggūrǝu aban pakki acauɓikea ka ɗàng. A kúnì ka, wu kǝ pakkia rǝ wun túró aɓa earcearǝu. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Nggearǝ anggurcau mǝnana kat Ɓakuli pâ ka, à tsǝì kat aɓa mǝnia yì nzongcau mwashat mana ama: &lt;&lt;Earce ɓio mǝkunɓala kǝla mǝnana a earce ɓamuro ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:18">Pǝris 19:18</ref>; <ref loc="ROM 13:8-10">Rom 13:8-10</ref></char>.</note> <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Sǝ ɓǝ̀ a kúnì lǝmdǝià rǝ wun earcearǝu, wu camarǝ munǝo andǝ loàsǝ̀ban a rǝarǝ wun ngga, wu parkir wun, ɓǝ̀ a na raka wun nǝ̀ kiɗiki rǝarǝ wun.<verse eid="GAL 5:15" /></para>
  <para style="s">Do aɓata rǝcandǝa mala Bangŋo</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Cau mǝnana ǝn nggǝ bang ngga ndya ani ka: Wu nyinggi Bangŋo Mǝfele ban ɓǝ̀ ging nǝ yilǝmi wun. Anggo ka, pa wu nǝ̀ nggǝ pakki agir mala kpata suno mala nggūrǝu ɗang. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Gìr mǝnana nggūrǝu earkiyice ka nda a mgbasho nǝ gir mǝnana Bangŋo earkiyice ka. Sǝ Bangŋo ka, kǝ tsǝk sǝm arǝ earce agir mǝnana nggūrǝu ginǝki cea ka. Amǝnia yì agir ɓari ka, à nda ɓibura. Yia ka, à kǝ munǝo arǝarǝia pwari-pwari. Nda gir mǝnana kǝ tsǝk wun sǝ wu kǝ gandǝ pak mǝɓoarne mǝnana wu kǝ earce pe ka raka.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:15-23">Rom 7:15-23</ref></char>.</note> <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Sǝ ɓǝ̀ wu nying Bangŋo mala Ɓakuli ging nǝ wun ngga, wu pa aɓata pe-púp mala Nggurcau mala Musa ɗǝm ɗang.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Ɓǝ̀ wu kpata gir mǝnana nggūrǝ wun mǝ'cauɓike earkiyi ce ka, ɓǝlle ka kǝ pusǝrǝi ani: kìɗìkì mala nongginǝ rǝarǝu, andǝ atúró pǝndǝki rǝǔ, andǝ ɗwanyi bwalrǝu arǝ pakkiagir kǝsǝkya,<note caller="+" style="f"><char style="fr" closed="false">5:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 1:28">Rom 1:28</ref></char>.</note> <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />andǝ kpata agir mala alú, andǝ pakkia agir monzǝo, andǝ ɓinǝ-mǝsǝarǝu, andǝ munǝki arǝarǝu, andǝ mɓali, andǝ nggea bumlulla mǝɓane, andǝ earce ɓamuru, andǝ gakitarǝu, andǝ tarki rǝarǝu, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />andǝ shamgir mala ɓwa, andǝ wal-walo gir, andǝ ká kpapí mǝɓane mala nukiagir andǝ nongginǝban, andǝ acili acauɓikea kǝla amǝnia ka. Mǝ ɓǝsǝlǝa wuni ɗǝm kǝla mǝnana ǝn na wun a dǝmba ka, ama ɓwa mǝnana kat kǝ do aɓata a'ulang mǝnia yì ado ka, pà nǝ̀ kutio a Domurǝm mala Ɓakuli ɗang.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Sǝ ɓǝ̀ Bangŋo Mǝfele nda gingginǝ sǝm ngga, nǝ̀ pusǝ amǝnia yì aɓealu ka aɓalǝ sǝm: earcearǝu, andǝ bumpwasǝa, andǝ dorǝpwala,<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="fq" closed="false">dorǝpwala, </char><char style="ft" closed="false">Ko &lt;&lt;dotarǝu.&gt;&gt;</char></note> andǝ munyi, andǝ tsǝkir ɓwa, andǝ pěmǝɓoarne, andǝ do'amurmǝsǝcau, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />andǝ ɓukɓuka,<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="fq" closed="false">ɓukɓuka </char><char style="ft" closed="false">Ko &lt;&lt;nongsǝmúrû.&gt;&gt;</char></note> sǝ bwalrǝu. Ɓè kǝ nggurcau pà kàm amur amǝnia yì agir ka ɗàng. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Aɓwana mǝnana à mala Kǝrǝsti Yesu na ka, à gbàllìnà ɓealu mala ɓwapǝndǝa mǝ'cauɓike andǝ anpel andǝ asuno male, amur nggun-gangndǝi mala Yesu. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Ɓǝ̀ sǝm nda ban do aɓata Bangŋo mala Ɓakuli ka, sǝm nǝ̀ kwaɗi lǝmndǝbu mala Bangŋo aɓa do ma'sǝm kat. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ɓǝ̀ sǝm ngga gusǝlǝ mur sǝm, ko ɓǝ̀ sǝm nggǝ altacau arǝarǝ sǝm, ko ɓǝ̀ sǝm nggǝ pak mɓali arǝarǝ sǝm ɗang.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Wu bwalia rǝ wun twalo</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Wun amǝ'eamrǝarǝu, ɓǝ̀ mǝ'eamrǝarǝu na sǝ à kumi aɓa ɓè kǝgìr mǝɓane ka, wun mǝnana wu came aɓa Bangŋo ka, wu nyesǝi amur njargula, nǝ ɓealu mǝɓuɓɓuki. Sǝ we ɓwa mǝnana a nǝ pak túró nyesǝban ngga, yál ɓamúrò ace mǝnana wu kǝa kpa aɓa mǝno yì kārǝkiban raka. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Wu bwalia rǝ wun aɓa tanni; anggo ka, sǝ wu nǝ̀ lùmsǝ nggurcau mala Kǝrǝsti. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Ɓǝ̀ kǝ ɓwa twalî ɓamúrì ama ndanǝ gulo, sǝ pà nǝ̀ nyesǝ ɓamúrì nǝ̀ bwalì kǝ ɓwa kàm raka, ɓwê kǝ swárki ɓamúrì nǝ swarkio. Yì ka, pà a kún ɓe kǝgìr ɗàng. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Kárǝ́kí túró mô nǝ nggearǝo wu sǝni, anggo sǝ a nǝ sǝlǝa ko túró mǝɓoarne na a pak ka, sǝ anggo ka a pà nǝ kànì rǝò arǝ kǝɓwa ɗàng. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Ɗenyi ama koyan ngga nǝ̀ ɓua nǝ́ ɓamúrì nǝ ulang ɓealu male.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Aɓwana mǝnana à kǝ kanià wia cau mala Ɓakuli ka, ɓoaro ɓǝà kǝ pakkì amǝ kàniá wià gìr, gìr mǝnana nda pepè ka; ɓǝà kǝ gau agir mǝɓoarne malea andǝia ace mǝnana ɓǝà kùmô ateà. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />Ɓǝa kǝa ɓosǝki wun ɗàng, kǝɓwa pà nǝ̀ ɓangginǝ Ɓakuli ɗang. Ko ɓǝ̀ mana sǝ ɓwa ɓeal ka, kǝgìr nî nda nǝ̀ càn ngga. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Aɓwana mǝnana do malea ka, kǝ nda ace lùmsǝ sune mala nggūrǝia mǝ'cauɓike ka, kǝ kìɗìkì nda mǝnana à nǝ̀ càn ngga. Sǝ aɓwana mǝnana do malea ka, kǝ nda ace pwasǝbum Bangŋo mala Ɓakuli ka, à nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka, nǝban Bangŋo. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Ace mani ka, ɓǝ̀ sǝm ngga aulǝ nǝ pak gìr mǝnana mǝɓoarne na ka ɗàng. Ɓǝ̀ pwari yi kārǝ́na ka, sǝm nǝ̀ nggá kum tangnakusǝu mǝɓafoe, yì mǝnana ɓǝ̀ aulǝa pa ka sǝm, sǝm bwaki bu sǝm raka. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Ace mani ka, ɓǝ̀ sǝm kum dǝmbu ka, ɓǝ̀ sǝm pakkî koyana le ka mǝɓoarne, nggeamurǝmi ka, amǝ'eamrǝarǝu mǝnana sǝm nda aɓa paɓamuru mǝ'mwashati sǝnǝia aban Kǝrǝsti ka.<verse eid="GAL 6:10" /></para>
  <para style="s">Masǝlǝata kwarkiru mala Bulǝs</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />WU SƏN ATƏRGILE MƏGULKE MƏNANA ƏN NGGƏ GILƏA WUN MASƏLƏATA ACAU MEM NƏIA, NƏ NGGEARƏ BUAM NGGA.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 16:21">1Kor 16:21</ref></char>.</note><verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />Aɓwana mǝnana à kǝ ɓariki ama à nǝ̀ tsǝk wun púp wu kasǝ-ɓatau ka, à nda aban earce ama ɓǝ̀ aɓwana sǝn sǝlǝpe malea. À eare ama à nǝ̀ kum tanni ace nggun-gangndǝi mala Kǝrǝsti ɗàng. Nda gìr mǝnana tsǝa sǝ à kǝ ɓinǝ kànìgir mana ama nǝ́ gūlì arǝ túró mǝnana Kǝrǝsti malǝna pe amur nggun-gangndǝi nǝmurǝì ka, sǝ aɓwana nǝ̀ kum amsǝban ngga. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Ko nggearǝ aɓwana mǝnana à camgiyi kingging arǝ cau mala kasǝ-ɓatau ka, yia nǝ nggearǝia ka, à kǝ kpata nggurcau kat ɗàng. Eare malea ka, ɓǝa kasǝa wun ɓatau sǝ à nǝ̀ nggǝ nggori nǝ wun ama à nda à yinǝ wun aɓa kwaɗi mala amǝ Yahudi ka. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />Ma-mem ngga, pa mǝ nǝ nggori nǝ kǝgìr ɗàng, she kǝ nggun-gangndǝi mala Mǝtala sǝm Yesu Kǝrǝsti. Ace mǝno yì nggun-gangndǝi ka, kpata ɓanza man, mǝnana a ɓalǝam ngga, à gbàllìnì wuna, sǝ nggearǝ mim gbal a ban ɓanza ka à gbàllìnam ǝn wunà. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Ko à kasǝa sǝm ɓata sǝm, ko à kasǝa sǝm raka, kǝgìr pa aɓalǝi ɗàng. Gìr mǝnana kutibanì kat ka nda nggaɗiban mǝnana ama à nda bǝsa ɓwa ka. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Ɓǝ̀ dorǝpwala andǝ ɓwamuru mala Ɓakuli do atà aɓwana mǝnana à kǝ kpata mǝnia yì nzongcau ka. Yia ka, à nda ka amǝ Isǝrayila mǝbǝshe mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 125:5">Ang 125:5</ref></char>.</note><verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Adyan ngga, kǝɓwa ɓǝ̀ kǝa na ama nǝ̀ soaki ɓabumam nǝ amǝnia yì agir ka ɗàng. Acemǝnana mǝ ndanǝ ayale'npenye a nggūrǝam mǝnana à lǝmdǝ ama mǝ nda mala Yesu ka.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Wun amǝ'eamrǝarǝu, ɓwamuru mala Mǝtala sǝm Yesu Kǝrǝsti ɓǝ̀ do atà wun. Ɓǝ̀ do anggo.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>