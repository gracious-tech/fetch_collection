<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Mbula</book>
  <para style="h">Puro</para>
  <para style="toc1">Ɓaria Malǝmce mala Musa mǝnana à kǝ tunǝi ama Puro ka</para>
  <para style="toc2">Puro</para>
  <para style="toc3">Pur</para>
  <para style="mt1">Puro</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">Lullǝu mǝnia ama <char style="bk">Puro </char> ka ɓālǝi nda &lt;&lt;Upi ban,&gt;&gt; sǝ ndarǝ bangcau amur gìr-kumban mǝgule aɓa cau-ɓaraɓara mala Isǝrayila, mǝnana à bangce aɓa mǝnia yì malǝmce ka; yì cau mala puro mala amǝ Isǝrayila mǝnana à nying Masar, ban mǝnana à nda kam ɗiɗyal kǝla aguro ka. Malǝmcenî ka ndanǝ abare mǝgulke ine: (1) Panzǝban mala amǝ'Ibǝru aɓa doguro; (2) Gya malea aban ká a Nkono Saina; (3) Kùrcau mala Ɓakuli nǝ aɓwana male a Saina, mǝnana pea wia anggurcau mala do-ɓealɓoarna, andǝ dotarǝu nǝ aɓwana, andǝ dokpata Ɓakuli, mǝnana à nǝ dum nǝi ka; (4) Pàk ban peri andǝ gilǝki ɓālǝi nǝ agir peri ace amǝ Isǝrayila, andǝ anggurcau ace apǝris andǝ peri aban Ɓakuli.</para>
  <para style="ip">Mugulacau aɓa malǝmce mǝnia ka nda cau mala gìr mǝnana Ɓakuli pê, lang panzǝna aɓwana male mǝnana à kùria aɓa doguro, sǝ nyesǝia à duk nzali mala aɓwapǝndǝa mana à ndanǝ tsǝkɓalǝu ace dǝmba ka.</para>
  <para style="ip">Mugula ɓwa aɓa malǝmce mǝnia ka nda Musa, yì ɓwabura mǝnana Ɓakuli tarrì ɓǝ̀ gingnǝ amǝ Isǝrayila a njar ɓǝà purî Masar ka. Bare cau ɓá malǝmce mǝnia, mǝnana bangula aɓwana súrǝì ka, nda ka Anzongcau Lum mǝnana Ɓakuli pa ka (<char style="xt" closed="false"><ref loc="EXO 20:1-17">Pur 20:1-17</ref>).</char></para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Panzǝban mala amǝ Isǝrayila aɓa doguro a Masar <char style="ior"><ref loc="EXO 1:1-15:21">1:1--15:21</ref></char></para>
  <para style="io2">1. Aguro a Masar <char style="ior"><ref loc="EXO 1:1-22">1:1-22</ref> </char></para>
  <para style="io2">2. Ɓǝlban mala Musa andǝ tita do male <char style="ior"><ref loc="EXO 2:1-4:31">2:1--4:31</ref> </char></para>
  <para style="io2">3. Musa andǝ Haruna soa arǝ murǝm Masar <char style="ior"><ref loc="EXO 5:1-11:10">5:1--11:10</ref> </char></para>
  <para style="io2">4. Lamsan mala Yàlîmurû andǝ upi Masar <char style="ior"><ref loc="EXO 12:1-15:21">12:1--15:21</ref> </char></para>
  <para style="io1">Loapi Nggeamùr Nzuno aban ká Nkono Saina <char style="ior"><ref loc="EXO 15:22-18:27">15:22--18:27</ref> </char></para>
  <para style="io1">Nggurcau andǝ kùrcau <char style="ior"><ref loc="EXO 19:1-24:18">19:1--24:18</ref> </char></para>
  <para style="io1">Tara Mǝfele andǝ akwarkiru ace peri <char style="ior"><ref loc="EXO 25:1-40:38">25:1--40:38</ref></char></para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">Làkkì mala amǝ Isǝrayila a Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />Amǝnia ka à nda ka amuna-burana mala Isǝrayila mǝnana à kùtí a Masar andǝa tárrià Yakupu ka; koyana ateà ka andǝ amǝ'ɓala male:<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 35:23-26">Tite 35:23-26</ref> </char>.</note><verse eid="EXO 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 1:2" />Ruben, andǝ Shimiyon, andǝ Lawi, andǝ Yahuda,<verse eid="EXO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 1:3" />andǝ Isaka, andǝ Zebulu, andǝ Benjami,<verse eid="EXO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EXO 1:4" />andǝ Dan, andǝ Naftali, andǝ Gad, sǝ Asha.<verse eid="EXO 1:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="EXO 1:5" />Amuna andǝ amǝkà Yakupu kat ka,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 46:2-7">Tite 46:2-7</ref>,<ref loc="GEN 46:26-27">26-27</ref></char>.</note> à nda lumi-tongno-nong-ɓari (70).<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓè nyesǝe mana ɓara-ɓara ka bang ama làkkì malea na</char><char style="fqa" closed="false">lumi-tongno-nong-ɓari nǝ mǝsǝi tongno </char><char style="ft" closed="false">(Sǝn Atúró 7:14).</char></note> Yisǝfu ka ak dǝmba nda a Masar.<verse eid="EXO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 1:6" />Yisǝfu yi wú, sǝ amǝ'eambi gbal kat à yi wukio; anggo sǝ yia kat a nza malea ka teà yi twalo. <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" />Sǝama amunia andǝ amǝkea, yia amǝ Isǝrayila ka, à yi ɓǝlki amuna andǝ amǝkau pas; à sa à làkkì nyangsang, à būndǝ kǝ̀rkǝ́r, à lùmsǝ ɓá nzali Masar.<verse eid="EXO 1:7" /></para>
  <para style="s">À par amǝ Isǝrayila aɓata tanni</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />Anzǝm apǝlǝa pas ka, ɓè bǝsa murǝm mǝnana súrǝ̀ kǝgìr amúr Yisǝfu raka, eau a buno-murǝm mala Masar. <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />Banggi aɓwana male ama, &lt;&lt;Wu sǝni, amǝ Isǝrayila adyan ngga à làkkìna kǝ̀rkǝ́r, sǝ à dumǝna gìr ǝn'o aban sǝm! <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" />Wu yiu, sǝm nǝ̀ alta kutan mala tamsǝ lidǝmba mala làkkì malea. Ɓǝ̀ ana raka, ɓǝ̀ lwa lo ka, yangǝla à nǝ̀ kpapibu andǝ aɓisǝm amǝbura, à nǝ̀ o a munǝo arǝ sǝm, sǝ à nǝ̀ nying nzali ma'sǝm.&gt;&gt;<verse eid="EXO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 1:11" />Nda amǝ Masar tsǝk amǝ-pǝ̀rta aguro amúrià, ɓǝà ɓungi bangŋo malea nǝ paria wia akanggǝrang atúró mǝkwane amúrià ka. À tsǝia púp à ɓakkia anggea-là Pitom andǝ Ramisi, anggea-là ramgìr mala Firona,<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">Firona </char><char style="ft" closed="false">ka nda lullǝu gulo mana à tunǝkina amurǝma mala amǝ Masar nǝi a pwarian ngga.</char></note> Murǝm. <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />Sǝ kat andǝ pàtanni mǝnana amǝ Masar kǝ par amǝ Isǝrayila nǝi ka, kara amǝ Isǝrayila kǝ lidǝmba nǝ li aban làkkì andǝ mesǝe aɓa nzali. Nda ɓangciu yi pakki amǝ Masar arǝia, <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />sǝ à tsǝk amǝ Isǝrayila púp aɓa túró-guro mǝɓike, sǝn mǝsǝswatǝr pà kàm ɗàng. <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />Amǝ Masar tsǝk amǝ Isǝrayila do ɓikia wia nǝ tsǝia púp ɓǝà kǝ ɓakkî amǝ Masar atobali andǝ pak koya túró-ɓaban. Amǝ Masar parì amǝ Isǝrayila atúró mǝcandǝe mǝnia ka kat amúrià, sǝ à tsǝia púp ɓǝà peǎ, sǝn mǝsǝswatǝ̀r pà kàm ɗàng.<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />Pǝlǝa murǝm mala Masar bang cau nǝ Shifǝra andǝ Puwa, yì amǝ'bwal-gbáshí mala amǝ Ibǝru<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="fq" closed="false">amǝ Ibǝru </char><char style="ft" closed="false">ka nda lullǝu mana amǝ Masar kǝ tunǝna amǝ Isǝrayila nǝi ka.</char></note> ama, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />&lt;&lt;Lang wu ndarǝ bwalì amālá amǝ Ibǝru gbáshí, sǝ wu sǝni muna-ɓwabura na à ɓǝl ka, wu wal-luí, sǝ ɓǝ̀ muna-ɓwama na ka, wu ɗeki ɓǝ̀ àwá.&gt;&gt; <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />Sǝama amǝ'bwal-gbáshí man ngga amǝ ɓanggi Ɓakuli na, acemani ka à eare à pàk gìr mǝnana Murǝm Masar banggia wia ka ɗàng; à ɗeki amuna-burana à àwá. <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />Murǝm Masar pǝlǝa túrban ɓǝà tunǝ amǝ'bwal-gbáshí man sǝ ɗia ama, &lt;&lt;Mana tsǝa sǝ wu pàk gìr man? Palang sǝ wu kǝ nying abangna amuna-burana nǝyilǝmu?&gt;&gt;<verse eid="EXO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 1:19" />Amǝ'bwal-gbáshí eari wi ama, &lt;&lt;Amālá amǝ Ibǝru ka à pà kǝla amālá amǝ Masar ɗàng; amālá amǝ Ibǝru ka à nda dwat nǝ mǝsǝkàngkàngŋa; kaniama mǝ'bwal-gbáshí nǝ̀ ká a bania ka, à angŋa dǝmba à gbashina.&gt;&gt;<verse eid="EXO 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 1:20" />Anggo sǝ Ɓakuli lǝmdǝ earmúrú male aban amǝ'bwal-gbáshí, sǝ amǝ Ibǝru lidǝmba nǝ hatǝki andǝ gulo nǝ rǝcandǝa kàm kpǝm. <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />Sǝ acemǝnana amǝ'bwal-gbáshí ɓanggi Ɓakuli ka, pea wia malea yià amuna.<verse eid="EXO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 1:22" />Pǝlǝa Firona Murǝm, tsǝki aɓwana male kat amǝ Masar nzongcau ama: &lt;&lt;Koya muna-ɓwabura mǝnana kat ɓwa Ibǝru loa ɓǝle ka, ɓǝà túrí aɓa Nggeasala Nayel. Sǝ amuna-mamǝna kat ka, ɓǝà ɗekia nǝyilǝmu.&gt;&gt;<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">À ɓǝl Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />A bàkú mǝno ka, ɓè ɓwabura a tàu mala Lawi al ɓwama a tàu male. <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" />Ɓwama mǝnia kum muna a bumi, sǝ ɓǝl muna-ɓwabura. Sǝni ka munê ɓoarɓwa kǝ̀rkǝ́r, sǝ pǝlǝa sǝmbǝrǝi zongŋo tàrú. <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />Lang yi sǝni pà nǝ̀ gandǝ lidǝmba nǝ sǝmbǝrǝè raka, pǝlǝa twal mǝgó mǝnana à tè nǝ bondo papiros ka, lanzǝ ɓālǝi nǝ myang andǝ muku kùrrí. Pǝlǝa nongsǝ muna aɓalǝi sǝ tsǝì aɓalǝ anzuno a kún múr mala Nggeasala Nayel. <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />Mǝ'nggaula munê pǝlǝa cam zak aban yálè nǝ̀ sǝn koman nǝ̀ kum muna.<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />Zuku ka, ɓoarnsarile Firona Murǝm yiu a sussǝo a kún nggeasala, sǝ amǝ'tè amuna-nsarina mana a tè ka à kùtí aban gya a kún nggeasala. Mǝsǝì kpa arǝ mǝgó mǝno aɓalǝ anzuno ka, sǝ ne mǝtè muna-ɓwama ama ɓǝ̀ kya twali wi. <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />Lang muna Murǝm loasǝ kún mǝgó ka, kara sǝn bangna muna-ɓwabura. Nda aban ɓua, kara mǝsǝswatǝr male bwali, sǝ na ama, &lt;&lt;Muna man ngga mwashat aɓalǝ amuna mala amǝ Ibǝru na.&gt;&gt;<verse eid="EXO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 2:7" />Sǝ mǝ'nggaula muna sung tù aban ɓoarnsarile murǝm, osso ɗì ama, &lt;&lt;Ɓǝ̀ ǝn kya yinǝ mwashat atà amamǝna mala amǝ Ibǝru ace mǝnana ɓǝ̀ iulǝô munê ka le?&gt;&gt; <verse eid="EXO 2:7" /><verse number="8" style="v" sid="EXO 2:8" />Ɓoarnsarile murǝm eari wi ama, &lt;&lt;E, kyane kya yinǝam nǝi.&gt;&gt;</para>
  <para style="p" vid="EXO 2:8">Pǝlǝa mǝ'nggaula muna tù a mire kya tunǝ nggea munê. <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />Ɓoarnsarile murǝm ne nggea muna ama, &lt;&lt;Twal muna mǝnia ka umnǝi a ɓala, kya iulǝami, mǝ nǝ nggá mbweo tangnakusǝo.&gt;&gt; Pǝlǝa twal munê umnǝi kya iulǝì. <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" />Nǝnzǝ́mò, lang munê yi gulna ka, nyesǝi wari nǝi kya pê ɓoarnsarile murǝm, sǝ pǝlǝ muni. Tsǝki wi lullǝu ama Musa,<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fq" closed="false">Musa </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;twali amúr mùr.&gt;&gt;</char></note> nda ban bang ama, &lt;&lt;Acemǝnana ǝn twali amúr mùr&gt;&gt; ka.<figure style="fig" alt="The birth of Moses" file="co00761.jpg" size="col" loc="2:10" copy="Cook" ref="2:1-10">Ɓǝlban mala Musa</figure><verse eid="EXO 2:10" /></para>
  <para style="s">Musa ɓariki ama nǝ̀ bwalì <optbreak /> aɓwana male kàm</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />Mǝnana Musa gulna karǝna-ɓwa ka, puro wario nǝ̀ nggá sǝn aɓwana male amǝ Ibǝru, sǝ kya sǝn nggea tanni mǝnana à nda aɓalǝi ka. Sǝn ɓwa Masar aban walki mwashat atà amǝ'eambi, ɓwa Ibǝru. <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />Lang Musa pelǝkiban sǝ sǝni kǝɓwa pà kàm aban sǝne raka, kara wal-lú ɓwa Masar sǝ sǝmbǝrǝi a sala.<verse eid="EXO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 2:13" />Ban nǝ fa ka, Musa purna ɗǝm nǝ̀ ká aban aɓwana male. Kya kum amǝ Ibǝru ɓari aban munǝo. Sǝ ɗì ɓwa mǝnana tita altacau ka ama, &lt;&lt;Palang sǝ a kǝ walki mǝ'eambo?&gt;&gt;<verse eid="EXO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 2:14" />Ɓwa mǝno pǝlǝa nyesǝi wi cau ama, &lt;&lt;Yana tsǝo murǝm andǝ mǝ'ɓashi amur sǝm? A ndarǝ earce awu nǝ wal-luem kǝla mǝnana a wal-lú ɓwa Masar yilung ngga le?&gt;&gt; Kara ɓangciu bwal Musa, nda kútí a ɗenyicau ama, &lt;&lt;Gìr mǝno ǝn pê ka aɓwana sǝlǝnace.&gt;&gt;<verse eid="EXO 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 2:15" />Lang Firona Murǝm okce ka, alta Musa nǝ̀ wal-luí. Sǝ Musa ka ɓangŋa apî Firona, o kya do a nzali Midiyan, a nkanggari ɓe tūli-mùr.<verse eid="EXO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 2:16" />Ɓè pǝris mala amǝ Midiyan, ndanǝ amuni amuna-mamǝna tongno-nong-ɓari. Amuna-mamǝna mǝnia yiu, à tò mùr a tūli, à lùmsǝki ankenye-mùr, à nǝ̀ pè anzur mala domwan mala tárrià. <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />Aɓea ayálgír aburana yiu, à pǝ̀r amuna-mamǝna mǝnia ama ɓǝà o. Sǝ Musa ka lo camata amuna-mamǝna mǝnia ka, bwalia wia kàm à pè domwan mala anzur malea mùr.<verse eid="EXO 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 2:18" />Lang amuna-mamǝna man nyarna a ɓala aban tárrià Rewel<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">Rewel </char><char style="ft" closed="false">ka mǝ'eam ko eambu-tárrú mala Jetǝro na.</char></note> ka, ɗia ama, &lt;&lt;Lang sǝ wu nyar tù yalung a ɓala?&gt;&gt;<verse eid="EXO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 2:19" />À eari wi ama, &lt;&lt;Ɓè ɓwabura Masar na amsǝ sǝm a bu ayálgír aburana ka, sǝ yàle toka sǝm mùr a tūli sǝ pè agirkusǝu ma'sǝm à nǔ.&gt;&gt;<verse eid="EXO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 2:20" />Tárrià ɗia ama, &lt;&lt;Sǝ ɓwabure ka, nda ke? Palang sǝ wu o wu ɗeki? Wu kyane wu kya tunǝi ɓǝ̀ yiu ɓǝ̀ yi lìli atà sǝm!&gt;&gt;<verse eid="EXO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 2:21" />Musa eare duk kano atà Rewel, pǝlǝa Rewel twal ɓè muni muna-ɓwama, Zipora sǝ pè Musa ɓǝ̀ duk māmí. <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />Zipora ɓǝlî Musa muna-ɓwabura. Musa bang ama, &lt;&lt;Mǝ nda ɓwa-kúnɗàngna a nzali mǝɗàngne, acemani ka mǝ nǝ tsǝki wi lùllǝú ama Gashom.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">Gashom </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;Bǝri.&gt;&gt;</char></note>&gt;&gt;<verse eid="EXO 2:22" /></para>
  <para style="s">Ɓakuli ok ɓua mala amǝ Isǝrayila</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />Anzǝm apǝlǝa pas ka murǝm Masar paklú. Sǝ amǝ Isǝrayila ka à kǝ imge ace tanni aɓata túró guro mǝnana à nda aɓalǝi ka. À ɓua kǝ̀rkǝ́r, sǝ ɓua malea eauwe aban Ɓakuli. <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" />Pǝlǝa Ɓakuli ok imge malea sǝ ɓālǝi kasǝa arǝ kùrcau male mǝnana pangnǝ Ibǝrayim,<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="GEN 15:14">Tite 15:14</ref></char>.</note> nǝ Ishaku, sǝ nǝ Yakupu<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="GEN 46:4">Tite 46:4</ref></char>.</note> ka. <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />Pǝlǝa Ɓakuli sǝn amǝ Isǝrayila,<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="fq" closed="false">sǝn amǝ Isǝrayila </char><char style="ft" closed="false">ko &lt;&lt;sǝn ɓealu mǝnana amǝ Isǝrayila aɓalǝi ka&gt;&gt;</char></note> sǝ yi sǝlǝa ama pwari kārǝ́na ace amsǝia.<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">Ɓakuli nacau nǝ Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />A ɓè pwari ka, Musa na arǝ yál domwan mala ambul andǝ anzur mala nkili Jetǝro, ɓwamǝgule pǝris mala amǝ Midiyan, sǝ Musa umnǝia kuko a ɓabondo yi pur a ban mǝnana à tunǝki ama Horep, nkono mala Ɓakuli ka. <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />Akano ka, kara sǝn mǝturonjar mala Yahweh<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">Yahweh </char><char style="ft" closed="false">ka nda lullǝu mana Ɓakuli pe ɓamúrì ka.</char></note> pusǝrǝi kǝla bǝsa mǝ'earke aɓa mǝ'nkwarki. Kǝ sǝn earke mala lasǝ bǝsa amur nkwarki, sǝ ko nkwarki pì ɗàng. <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />Pǝlǝa Musa bang ama, &lt;&lt;Mǝ nǝ ká mǝ nggá sǝn mǝnia yì gìr'ndali, mǝnana bǝsa kǝ earke sǝ nkwarki pi raka.&gt;&gt;<verse eid="EXO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 3:4" />Lang Yahweh sǝna Musa pǝlǝna rǝì ace sǝnban pepè ka, pǝlǝa tunǝ Musa nǝ ɓá mǝ'nkwarki ama, &lt;&lt;Musa! Musa!&gt;&gt;</para>
  <para style="p" vid="EXO 3:4">Sǝ Musa pa eare ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="EXO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 3:5" />Pǝlǝa ne Musa ama, &lt;&lt;Kǝa sung kani ɗang! Swár ankura mǝnana a kusǝo ka, acemǝnana ban mana a cam kam ngga, nzali mǝfele na.&gt;&gt; <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />Ɗǝm ngga banggi wi ama, &lt;&lt;Mǝ nda Ɓakuli mala keò, Ɓakuli mala Ibǝrayim, Ɓakuli mala Ishaku, sǝ Ɓakuli mala Yakupu.&gt;&gt;</para>
  <para style="p" vid="EXO 3:6">Lang Musa ok cau man ngga, kùmsǝ ɓamǝsǝi, acemǝnana ɓangciu pakki wi arǝ sǝn Ɓakuli a ɓamǝsǝì.<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />Sǝ Mǝtalabangŋo banggi wi ama, &lt;&lt;Mǝsǝcau ǝn sǝnǝna tanni mǝkǝ̀rkǝ́rnì mala aɓwana mem mǝnana aɓa Masar ka, sǝ ǝn ongŋǝna ɓua malea atàcau mala amǝ pea wia tanni aɓata túró guro. Ən sǝlǝnace nutanni malea. <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" />Acemani ka, ǝn sulǝo ace amsǝia a ɓabù amǝ Masar, mǝ nǝ pusǝia ɓǝà purî ɓá nzali mǝno, sǝ mǝ nǝ kánǝia a nzali mǝɓoarne, andǝ nzali mǝgule, nzali mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga; nzali mǝnana amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Amor, andǝ amǝ'Periz, andǝ amǝ'Hivi, andǝ amǝ'Jebus duk kam ngga. <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />Adyan ngga, ɓua mala amǝ Isǝrayila bwalǝna banam, sǝ ǝn sǝnǝna twalo mǝdǝmbǝre mǝnana amǝ Masar paria wia amúrià ka. <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />Yiu, mǝ nǝ túrô aban Firona, Murǝm Masar, ace mǝnana wu pusǝ aɓwana mem, amǝ Isǝrayila, ɓǝà purî ɓá Masar ka.&gt;&gt;<verse eid="EXO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 3:11" />Pǝlǝa Musa ɓuaki Ɓakuli ama, &lt;&lt;Mǝ nda yana mana mǝ nǝ kútí aɓadǝm Firona ka? Mǝ nda yana mǝnana mǝ nǝ pusǝ amǝ Isǝrayila aɓa Masar ka?&gt;&gt;<verse eid="EXO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 3:12" />Pǝlǝa Ɓakuli ne wi ama, &lt;&lt;Mǝ nda atò, sǝ mǝnia ka nda gìr mana nǝ̀ lǝmdǝ ama mǝ nǝ̀ túrrǒ ka: Lang a pusǝna amǝ Isǝrayila à purnǝì ɓá Masar ka, we wunǝia, wun nǝ̀ yia peri abanam amur nkono mǝnia ka.&gt;&gt;<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />Pǝlǝa Musa ne Ɓakuli ama, &lt;&lt;Ɓǝ̀ ǝn wari aban amǝ Isǝrayila, sǝ ǝn nea wia ama, &lt;Ɓakuli mala aká wun nǝ̀ túrǎm aban wun,&gt; sǝ à ɗiem ama, &lt;Mana nda lùllǝì ka?&gt; Mana mǝ nǝ banggia wia?&gt;&gt;<verse eid="EXO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 3:14" />Ɓakuli pê Musa eare ama, &lt;&lt;MƏ NDA MƏNANA MƏ NDA KA. Mǝnia ka nda cau mana awu nǝ ne amǝ Isǝrayila ka: &lt;MƏ NDA<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Lullǝu mǝnia ama: </char><char style="fq" closed="false">MƏ NDA MƏNANA MƏ NDA KA </char><char style="ft" closed="false">ko </char><char style="fq" closed="false">MƏ NDA </char><char style="ft" closed="false">nǝ kún Ibǝru ka, nda &lt;&lt;Yahweh.&gt;&gt; Aɓa nyesǝcau mǝnia nǝ kún Mbula ka, sǝm tunǝi ama &lt;&lt;Mǝtalabangŋo.&gt;&gt;</char></note> nǝ̀ túrǎm aban wun.&gt; &gt;&gt;<verse eid="EXO 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 3:15" />Ɓakuli nyar ɗǝm ne Musa ama, &lt;&lt;Banggi amǝ Isǝrayila mǝnia yì cau ka ama: &lt;Yahweh, Ɓakuli mala aká wun, yì Ɓakuli mala Ibǝrayim, Ɓakuli mala Ishaku, sǝ Ɓakuli mala Yakupu, nda túrǎm aban wun ngga.&gt; Mǝnia ka nda lùllǝàm mǝnana málá male pà kàm raka, kǝ lùllǝú mǝnana à nǝ̀ ɗenyinǝ mim nǝi arǝ anza kat ka.<verse eid="EXO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 3:16" />&lt;&lt;Kyane, kya ramba aɓwana-mǝgule mala amǝ Isǝrayila a banɓwáná sǝ wu banggia wia ama &lt;Yahweh, Ɓakuli mala aká wun, Ɓakuli mala Ibǝrayim, Ɓakuli mala Ishaku, sǝ Ɓakuli mala Yakupu, pusǝrǝi abanam, sǝ na ama, &lt;&lt;Ən soana mǝsǝàm kyap-kyap arǝ wun, andǝ gìr<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">Ən soana mǝsǝàm kyap-kyap arǝ wun, andǝ gìr </char><char style="ft" closed="false">ko &lt;&lt;Ən yina aban wun, sǝ ǝn sǝnǝna gìr&gt;&gt;</char></note> mǝnana à kǝ pakka wun a Masar ka. <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />Sǝ mǝ ndarǝ pacau ama mǝ nǝ pusǝ wun ɓǝ̀ wu purî ɓá parban mala tanni mǝɓike mala Masar, sǝ mǝ nǝ kánǝ wun a nzali mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga; nzali mǝnana amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Amor, andǝ amǝ'Periz, andǝ amǝ'Hivi, andǝ amǝ'Jebus duk kam ngga.&gt;&gt; &gt;<verse eid="EXO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 3:18" />&lt;&lt;Aɓwana-mǝgule mala Isǝrayila nǝ̀ kwakikiria a rǝò. Pǝlǝa we wunǝ aɓwana-mǝgule ka wun nǝ̀ ká aban murǝm Masar sǝ wun nǝ̀ banggi wi ama, &lt;Yahweh, Ɓakuli mala amǝ Ibǝru lǝmdǝna rǝì aban sǝm. Ado ka, ida eara sǝm ɓǝ̀ sǝm twal gya mala nongŋo tàrú aban ká njenza aɓa pǝɗanban ace pà gìr'nkila aban Yahweh, Ɓakuli ma'sǝm.&gt; <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />Sǝama ǝn sǝlǝna ama murǝm Masar pà nǝ̀ nying wun ɓǝ̀ wu u ɗang, she ɓǝ̀ kaɓa bù tsǝ̀ngŋǝ̀nì púp ɓǝ̀ pè ka. <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />Acemani ka, mǝ nǝ loasǝ buam mǝ nǝ wal Masar, nǝ agir-ndǝlǝki amǝ kàrmuruì mǝnana kat mǝ nǝ peǎ aɓalǝi ka. Anzǝm mǝno ka nǝ̀ nying wun ɓǝ̀ wu o. <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" />Mǝ nǝ tsǝa aɓwana man nǝ̀ kum earmúrú aban amǝ Masar, sǝ ɓǝ̀ yina o, wun nǝ̀ nying Masar ka, pà wun nǝ̀ umnǝ ɓabù wun ɓà ɗàng. <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />Koya ɓwama Isǝrayila ka nǝ̀ nggá zǝmbî ɓî mǝ'murkala ɓwama Masar andǝ koya ɓwama Masar mǝnana ndanǝ do a atè ka, ɓǝà pè wi agir-nggūrǝu, andǝ agir azǝrfa, andǝ bolo-njengǝlan. Wun nǝ̀ oasǝì amuna ma'wun amuna-burana andǝ amuna-mamǝna amǝnia yì agir ka arǝia. Anggo sǝ wun nǝ̀ pwan kume mala amǝ Masar arǝia.&gt;&gt; <figure style="fig" alt="Moses and the Burning Bush" file="cn01919.jpg" size="col" loc="3:22" copy="Wade" ref="3:1-22">Musa andǝ bǝsa mǝ'earke aɓa mǝ'nkwarki</figure><verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">Ɓakuli pè Musa rǝcandǝa mala pàkki agirndǝlǝki</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />Sǝ Musa ka pè Yahweh eare ama, &lt;&lt;Sǝ amǝ Isǝrayila ka, à pà nǝ̀ earnǝ mim, ko à nǝ̀ ok cau mem ɗàng; à nǝ̀ bang ama, we Yahweh ka a lǝmdǝ rǝò abanam ɗàng.&gt;&gt;<verse eid="EXO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 4:2" />Nda Yahweh ɗì ama, &lt;&lt;Mana mǝna a buo ka?&gt;&gt;</para>
  <para style="p" vid="EXO 4:2">Musa eari wi ama, &lt;&lt;Gara na.&gt;&gt;<verse eid="EXO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 4:3" />Yahweh ne wi ama, &lt;&lt;Túrí a nzali.&gt;&gt;</para>
  <para style="p" vid="EXO 4:3">Pǝlǝa Musa túr gara mana a buì ka a nzali, kara garè pǝlǝ n'yau. Musa nyar nǝ te cambi wi zak.<verse eid="EXO 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 4:4" />Sǝ Yahweh ne wi ama, &lt;&lt;Lǝmdǝ buo bwali a nggilate.&gt;&gt;</para>
  <para style="p" vid="EXO 4:4">Pǝlǝa Musa lǝmdǝ buì bwali a nggilate, kara nyare pǝlǝ gara ɗǝm.<verse eid="EXO 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 4:5" />Yahweh pǝlǝa na ama, &lt;&lt;Mǝnia ka nda ace mǝnana ɓǝà ear ama, Mim, Yahweh, yì Ɓakuli mala akeâ, Ɓakuli mala Ibǝrayim, Ɓakuli mala Ishaku, sǝ Ɓakuli mala Yakupu ka, ǝn lǝmdǝna rǝàm a bano.&gt;&gt;<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />Pǝlǝa Yahweh ne Musa ɗǝm ama, &lt;&lt;Ado ka oasǝ buo aɓa daura mô.&gt;&gt; Pǝlǝa Musa oasǝ buì aɓa daura male, sǝ lang pusǝ bui ɗǝm ngga, kwánó nggû<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">kwánó nggû </char><char style="ft" closed="false">ko ɓè kwánó mǝɓike mala nggū rǝu mana kǝ akrǝ ɓwa ka.</char></note> angŋa bui pwasǝna pwapwat kǝla talimbulo.<verse eid="EXO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 4:7" />Nyare Yahweh banggi wi ama, &lt;&lt;Nyesǝ buo aɓa daura mô.&gt;&gt; Pǝlǝa Musa nyesǝ bui aɓa daura male, sǝ lang pusǝ bui ka, buì nyarna pǝlǝna mǝɓoarne kǝla cili rǝì.<verse eid="EXO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 4:8" />Yahweh banggi Musa ama, &lt;&lt;Ɓǝ̀ amǝ Isǝrayila ginǝ earnǝ we ko à tsǝkir gir'ndali mǝnana a dǝmba raka, à nǝ̀ earnǝ gir'ndali mǝnia nǝnzǝ́mò ka. <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />Ɓǝà ginǝ earnǝ we ko à ok cau mò raka, kat andǝ amani ama a lǝmdǝia wia amǝnia yì agir'ndali ɓari ka, ɗàrǝ́ mur a Nggeasala Nayel sǝ wu solǝi a nzali. Mùrnî nǝ̀ pǝlǝ nkila a nzali.&gt;&gt;<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />Pǝlǝa Musa banggi Yahweh, ama, &lt;&lt;Ida Mǝtalem, ǝn sǝlǝ nacau ɗàng. Kaniama awu nǝ nacau nǝ mim ngga, mǝ nda mǝ'sǝlǝ nacau ɗàng, sǝ ko ado mǝno a nanacau nǝ mim guro mò ka ǝn gandǝi ɗàng. Acemǝnana ǝn nggǝ dǝndi nacau, sǝ lasǝàm kǝ twal cau tù ɗàng.&gt;&gt;<verse eid="EXO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 4:11" />Pǝlǝa Yahweh ɗî Musa ama, &lt;&lt;Yana pak kún ɓwa ɗe? Sǝ yana tsǝkiyi ɓwa ɓǝ̀ do mǝtalasǝ-ɓunna, ko mǝkir'ara, ko mǝ sǝnban, ko nte? Mim Yahweh ka, mǝ nda re? <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />Ado ka kyane, Mǝ nǝ bwalo kàm, awu nǝ nacau pepè, sǝ mǝ nǝ kanio cau mǝnana awu nǝ na ka.&gt;&gt;<verse eid="EXO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 4:13" />Sǝ Musa nyar ɗǝm zǝmba ama, &lt;&lt;Mǝtalem, ida, túr ɓeɓwa ɗàng.&gt;&gt;<verse eid="EXO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 4:14" />Kara bum Yahweh lúllô arǝ Musa, pǝlǝa banggi wi ama, &lt;&lt;Mǝ'eambo Haruna, mǝ'kà Lawi ka pà kàm re? Ən sǝlǝ nǝma yì ka sǝlǝ nacau. Ko ado ka nda kǝ yiu a kúllió ka, sǝ ɓǝ̀ yi sǝno ka, ban nǝ̀ ɓoari wi. <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />We ka awu nǝ ne wi cau, awu nǝ tsǝki wi cau a kúni. Mǝ nǝ dupô gbasha arǝ nacau, sǝ mǝ nǝ dupî wi gbasha arǝ nacau, sǝ mǝ nǝ kania wun gìr mǝnana wun nǝ̀ pak ka. <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />Haruna nǝ̀ duk mǝ'nacau a kunio aban aɓwana, yì ka nǝ̀ duk mǝ'bǝlkúnó, sǝ we ka awu nǝ do kǝla Ɓakuli a baní. <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />Sǝ awu nǝ twal gara mò mǝnia ka a buo, acemǝnana kǝ garè na awu nǝ pàkki agir-ndali nǝi ka.&gt;&gt;<verse eid="EXO 4:17" /></para>
  <para style="s">Musa nyare a Masar</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />Pǝlǝa Musa nyare aban nkili Jetǝro sǝ banggi wi ama, &lt;&lt;Ida, earâm ɓǝ̀n o mǝ nyare aban aɓwana mem a Masar. Nǝma mǝ nǝ nggá sǝnia ko à ndakam nǝyilǝmu più.&gt;&gt;</para>
  <para style="p" vid="EXO 4:18">Jetǝro pǝlǝa banggi wi ama, &lt;&lt;Kya ɓá rǝpwala.&gt;&gt;<verse eid="EXO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 4:19" />Musa ka nda kano a nzali Midiyan più sǝ Yahweh banggi wi ama, &lt;&lt;Nyare o a Masar, acemǝnana aɓwana mǝnana à kǝ alta yilǝmo ama à nǝ̀ wal-luio ka à wukina kat.&gt;&gt; <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />Nda Musa twal māmí andǝ amuni tsǝia a nzǝm mǝdambǝriso, sǝ bwal njar andǝia aban o a nzali Masar ka. Musa twal gara male mǝnana Ɓakuli banggi wi ama ɓǝ̀ bwali a bui ka.<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />Yahweh nyare nacau nǝ Musa ama, &lt;&lt;Lang a bingŋǝna Masar ka, kya ban Firona kya pàkki agir'ndali mǝnana ǝn pô rǝcandǝa mala pàkkia ka, a ɓadǝmbi. Sǝ mim ngga, mǝ nǝ tǝ́r ɓabumi, sǝ yì ka pà nǝ̀ earî amǝ Isǝrayila ɓǝà u ɗàng. <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" />Pǝlǝa awu nǝ banggi wi ama Mim, Yahweh ka, ǝn nggǝ na nǝma, &lt;Isǝrayila nda muna-dǝmba mem. <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" />Ən bangŋǝno nǝma wu nying munem ɓǝ̀ o, ace mǝnana ɓǝ̀ kya peri abanam ngga, sǝ a ginǝ eari wi ɓǝ̀ o. Acemani ka, mǝ nǝ wal-lú muna-dǝmba muna-ɓwabura mô.&gt; &gt;&gt;<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />A ɓè bansulǝo a njar aban ká Masar ka, Yahweh yiu yi je andǝ Musa sǝ earce ama nǝ̀ wal-lú Musa. <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />Pǝlǝa Zipora, mālá Musa twal tali mǝ'kún-cauwe kasǝ nggú kún ɓata muni nǝi kpat. Twal nggú kún ɓata muna mǝnana kasǝi ka, wario kya je ka akusǝ Musa nǝi sǝ bang ama, &lt;&lt;A nda bura mala nkila abanam.&gt;&gt; <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />Cau mǝno bang ama, A nda bura mala nkila ka, nda ace kasǝ-ɓatau mǝno kasǝî muna sǝ nkila sukki ka. Nda Yahweh ɗeki Musa wal-luí raka.<verse eid="EXO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />Yahweh ka nanì Haruna ama, &lt;&lt;Puro kyane a njenza aɓa pǝɗanban kya kum Musa.&gt;&gt; Nda Haruna puro wario kya kum Musa a Nkono mala Ɓakuli ka; sǝ lang à je ka, mǝn abui kùrì zǝp, pàkkì'nzalè. <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />Musa pǝlǝa banggi Haruna agir mǝnana kat Yahweh túrí ama ɓǝ̀ kya nâ, andǝ agir-lǝmdǝa mǝnana banggi wi ama ɓǝ̀ kya peǎ ka.<verse eid="EXO 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 4:29" />Nda sǝ Musa andǝ Haruna nyar a Masar à kya tunǝ dapi mala aɓwana-mǝgule mala amǝ Isǝrayila kat ka. <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />Haruna pǝlǝa banggia wia cau mǝnana kat Yahweh banggi Musa ka, sǝ Musa pàk agir-ndali mǝnana Ɓakuli lǝmdǝì wi ka, a ɓamǝsǝ aɓwana.<verse eid="EXO 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 4:31" />Pǝlǝa aɓwana ear ama Yahweh na túr Musa ka, sǝ lang à ok ama Yahweh ɗenyina nǝ Isǝrayila sǝ sǝnǝna nggea tanni mǝkǝ̀rkǝ́rnì mǝnana à kǝ nu ka, à ɓun a nzali à peri aban Yahweh.<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">Musa andǝ Haruna nacau nǝ Firona</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />Anzǝm mani ka, Musa andǝ Haruna kùtí aban Firona, Murǝm Masar, à ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh, Ɓakuli mala amǝ Isǝrayila bang ngga, &lt;Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya pak Lamsan mala gusǝlǝ lùllǝàm a ɓabondo.&gt; &gt;&gt;<verse eid="EXO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 5:2" />Sǝ Firona nyesǝia wia ama, &lt;&lt;Yana nda Yahweh, mǝnana mǝ nǝ oki wi sǝ mǝ nying Isǝrayila ɓǝ̀ u ka? Ən súrǝ̀ Yahweh ɗàng, sǝ pà mǝ nǝ nying Isǝrayila ɓǝ̀ u ɗang.&gt;&gt;<verse eid="EXO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 5:3" />Pǝlǝa Haruna andǝ Musa bang ama, &lt;&lt;Ɓakuli mala amǝ Ibǝru lǝmdǝna rǝì aban sǝm. Acemani ka, ida, nying sǝm ɓǝ̀ sǝm twal gya mala nongŋo tàrú aban ká a ɓabondo, ace mǝnana ɓǝ̀ sǝm kya pa gir'nkila aban Yahweh Ɓakuli ma'sǝm ngga. Ɓǝ̀ sǝm pa anggo raka, nǝ̀ wal-lú sǝm nǝ kwánó ko nǝ lwa.&gt;&gt;<verse eid="EXO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 5:4" />Firona, Murǝm Masar banggia wia ama, &lt;&lt;We Musa wunǝ Haruna, palang sǝ wu kǝ tamsǝ aɓwana man arǝ túró malea le? Wu nyar a túró guro ma'wun!&gt;&gt; <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />Pǝlǝa Firona Murǝm na ama, &lt;&lt;Wu sǝni, amǝ Ibǝru adyan ngga à làkkìna aɓa nzali Masar sǝ ndo wu kǝ tamsǝia arǝ túró malea mana nda púp à nǝ̀ pè ka!&gt;&gt;<verse eid="EXO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 5:6" />A kǝ pwari mǝno ka, Firona túrban à tunǝ aɓwana male, yià amǝ-pǝ̀rta aguro andǝ aɓea amǝ Isǝrayila mana à twalia ace sǝntà túró ka, sǝ banggia wia ama: <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />&lt;&lt;Twal ado aban ká dǝmba ka, wu kǝa nyare wu pè amǝ Isǝrayila lusung-pwasǝa ace yau dǝɓang ɓak tobali ɗǝm ɗang; yia nǝ nggearǝia ɓǝà kyane ɓǝà kya pwan lusung-pwasǝa malea. <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />Sǝ wu kǝa na ama wun nǝ̀ amsǝ làkkì mala atobali mǝnana à nǝ̀ ɓak aɓa pwari mwashat ka ɗàng ko bǝti. Sǝ ɗǝm ngga dumǝna púp à nǝ̀ lùmsǝkún túró malea ɓǝ̀ pǎ kǝla mana ndakam ɗiɗyal ka. Ɗwanyi túró nǝ tsǝia sǝ à kǝ ɓua ama ɓǝ̀n ɗekia à nǝ̀ o, à nǝ̀ ká pà gìr'nkila aban Ɓakuli malea ka. <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />Wu paria wia túró amúrià mǝnana nǝ̀ tsǝia à nǝ̀ do aɓa túró mǝkǝ̀rkǝ́rnì koya pwari ka. Anggo ka à pà nǝ̀ kwakikiria arǝ nyir mǝnana à kǝ banggia wia ka ɗàng!&gt;&gt;<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />Nda amǝ-pǝ̀rta aguro andǝ aɓwana mana à tsǝia ace sǝntà túró ka, à puro à kya ramba amǝ Isǝrayila sǝ à banggia wia ama, &lt;&lt;Mǝnia ka nda cau mǝnana Firona Murǝm Masar bang ngga: &lt;À pà nǝ̀ nyare à nǝ̀ pà wun lusung-pwasǝa ace yau dǝɓang ɗǝm ɗàng. <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />Wun nǝ nggearǝ wun wu kyane wu kya alta lusung-pwasǝa ma'wun a ban mǝnana wun nǝ̀ kumi kàm ngga, sǝ kat andǝ amǝno ka à pà nǝ̀ amsǝa wun túró ma'wun ɗàng ko bǝti.&gt; &gt;&gt; <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />Nda amǝ Isǝrayila puro à mesǝe aɓa nzali Masar kat, aban alta kwa arǝ aɓaban à nǝ̀ pangna túró nǝi a kúnì lusung-pwasǝa ka. <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />Amǝ-pǝ̀rta aguro camarǝ pìtea ama, &lt;&lt;Wu masǝlǝ túró mana à kasǝa wun mala koya pwari, kǝla pě mana ɗiɗyal à kǝ pa wun lusung-pwasǝa ka!&gt;&gt; <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />Amǝ-pǝ̀rta aguro mala Firona kok amǝ Isǝrayila mana twalia ace sǝntà túró ka nǝ nkamso, sǝ à ɗiǎ ama, &lt;&lt;Mana tsǝa sǝ aguro mana à tsǝk wun amúrià ka à mal túró ɓak tobali mǝnana kat à kasǝia wia yilung andǝ yalung, kǝla mana ɗiɗyal ka ɗàng?&gt;&gt;<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />Amǝ Isǝrayila mǝnia à twalia ace sǝntà túró ka, à wari aban Firona nǝ ɓua malea ama, &lt;&lt;Palang sǝ a pakka sǝm ani, sǝm aguro mò? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />À tàmsǝna pà sǝm lusung-pwasǝa ace yau dǝɓang, sǝ kat andǝ mǝno ka, à camarǝ pîtà sǝm ama ɓǝ̀ sǝm ɓak tobali. Ado ka à kutina kok sǝm. Aɓwana mô amǝ Masar na mǝnana à pàk pepè raka.&gt;&gt;<verse eid="EXO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 5:17" />Sǝ Firona nyesǝia wia ama, &lt;&lt;Wu nda ka amǝ'doɓana, wu earce pàk túró ɗang! Nda gìr mǝnana tsǝa sǝ wu kǝ nam ama ɓǝ̀n ɗeki wun, wun nǝ̀ o a pà gir'nkila aban Yahweh Ɓakuli ma'wun ngga. <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />Ado ka, wu nyare a kún túró! À pà nǝ̀ pà wun lusung-pwasǝa ɗàng, sǝ dumǝna púp wun nǝ̀ ɓak làkkì mala atobali mǝnana à kasǝa wun ngga.&gt;&gt;<verse eid="EXO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 5:19" />Amǝ Isǝrayila mǝnana à tsǝia sǝntà túró, sǝni ka, à nda ɓá tanni mǝkwane lang à ok ama à pà nǝ̀ amsǝia wia làkkì mala atobali mǝnana à nǝ̀ ɓak aɓa pwari mwashat raka.<verse eid="EXO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 5:20" />Lang à purî ɓadǝm Firona ka, à kum Musa andǝ Haruna aban came, à nda rǝ kúndǝia. <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />À banggi Musa andǝ Haruna ama, &lt;&lt;Ɓǝ̀ Yahweh sǝn gìr mǝnana wu pàk ka, sǝ ɓǝ̀ ɓasha wun, acemǝnana wu tsǝ̀ngŋǝ̀nà, sǝm pǝlǝna aɓwana mǝnana à nǝ̀ ɓinǝmǝsǝia a sǝne mala murǝm andǝ amǝtúró male ka, sǝ wu pània wia gara wal sǝm.&gt;&gt;<verse eid="EXO 5:21" /></para>
  <para style="s">Yahweh ne Musa andǝ Haruna ama <optbreak /> nǝ̀ pusǝ aɓwana a doguro</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />Pǝlǝa Musa nyar aban Yahweh sǝ banggi wi ama, &lt;&lt;We Yahweh, palang ado sǝ a yinǝ tanni amur aɓwana mǝnia? Ace mana sǝ a túrǎm? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />Twala a pwari mǝnana ǝn wari nǝi aban Firona ace ne wi cau mò mǝnana a túrǎm nǝi ka, kara kǝ lidǝmba nǝ li aban pea aɓwana mô tanni, sǝ ko a pak kǝgìr mǝnana awu nǝ pusǝia aɓa tanni ka ɗàng!&gt;&gt;<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Ado ka, awu nǝ sǝn gìr mǝnana mǝ nǝ pàkkî Firona ka: Mǝ ndo mǝ nǝ tsǝì nǝ rǝcandǝa mem ɓǝ̀ nying aɓwana mem ɓǝà o. Yàle yì ka, nǝ̀ pǝria nǝ pǝra, ɓǝà upi nzali male.&gt;&gt;<verse eid="EXO 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />Nyare Ɓakuli ne Musa cau ama, &lt;&lt;Mǝ nda Yahweh.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Lùllǝú mǝnia ama </char><char style="fq" closed="false">Yahweh </char><char style="ft" closed="false">ka nda gbal à kǝ̀ tunǝi ama, &lt;&lt;Jehovah.&gt;&gt; </char><char style="ft" closed="false">Aɓa nyesǝ cau mǝnia ka à tunǝi ama &lt;&lt;Mǝtalabangŋo.&gt;&gt;</char></note> <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" />Ən lǝmdǝ rǝàm aban Ibǝrayim, aban Ishaku, sǝ aban Yakupu, ama, Mǝ nda Ɓakuli mǝnana Kar Ban nǝ Gulo Kat ka.<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fq" closed="false">Ɓakuli mǝnana Kar Ban nǝ gulo Kat </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda &lt;&lt;El-Shaddai.&gt;&gt;</char></note> Sǝama lùllǝàm mǝnana ama Yahweh ka, ǝn lǝmdǝia wia à súrǝàm nǝi ɗàng. <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" />Ɗǝm ngga ǝn kútí aɓa kùrcau sǝnǝia ama, mǝ nǝ pea wia nzali Kan'ana, yì nzali mǝnana à duk kam kǝla abǝri ka. <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />Sǝ adyan ngga, ǝn ongŋǝna imge mala amǝ Isǝrayila mǝnana amǝ Masar tsǝia aguro ka, sǝ ɓalǝam kasǝna arǝ kùrcau mem.<verse eid="EXO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 6:6" />&lt;&lt;Acemani ka, kyane banggi amǝ Isǝrayila ama, &lt;Mǝ nda Yahweh. Mǝ nǝ amsǝ wun ɓǝ̀ wu purî ɓá nggea kanggǝrang tanni mǝnana amǝ Masar tsǝk wun aɓalǝi ka. Mǝ nǝ pusǝ wun aɓata doguro aɓatea, sǝ mǝ nǝ akmúr wun nǝ kaɓa rǝcandǝa mem andǝ lǝmdǝ atúró mǝgule mala ɓashi amur amǝ Masar. <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />Mǝ nǝ ak wun, wun nǝ̀ duk aɓwana mem, sǝ mǝ nǝ duk Ɓakuli ma'wun. Sǝ wun nǝ̀ sǝlǝ ama Mǝ nda Yahweh, Ɓakuli ma'wun, mǝnana pusǝ wun wu purî ɓá nggea kanggǝrang tanni mǝnana amǝ Masar tsǝk wun aɓalǝi ka. <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />Sǝ mǝ nǝ yinǝ wun a nzali mana ǝn kángìr nǝma mǝ nǝ pè Ibǝrayim, andǝ Ishaku, andǝ Yakupu ka. Mǝ nǝ pà wuni ɓǝ̀ duk girkuma ma'wun. Mǝ nda Yahweh!&gt; &gt;&gt;<verse eid="EXO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 6:9" />Anggo sǝ Musa nea amǝ Isǝrayila cau, sǝ yia ka à kwakikiria arǝì ɗàng, ace ɓungio mana ɓabumia ɓungi ka andǝ tanni mǝcandǝe mǝnana à nu aɓata túró-guro mǝɓike ka.<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />Pǝlǝa Yahweh banggi Musa ama, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />&lt;&lt;Nyare, kyane aban Firona, murǝm Masar, kya ne wi ama, ɓǝ̀ nying amǝ Isǝrayila ɓǝà purî ɓá nzali male.&gt;&gt;<verse eid="EXO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 6:12" />Sǝ Musa ka nyesǝî Yahweh cau ama, &lt;&lt;Nggearǝ amǝ Isǝrayila, yì aɓwana mem ngga à kwakikiria arǝàm rakâ, sǝ lang sǝ Firona nǝ̀ kwakikiri arǝàm, mim mǝnana ǝn nggǝ gandǝ nacau pepè raka?&gt;&gt;<verse eid="EXO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 6:13" />Yahweh nacau nǝ Musa andǝ Haruna sǝ tasǝia nǝ cau aban amǝ Isǝrayila, sǝ aban Firona murǝm Masar, ɓǝà panzǝ amǝ Isǝrayila ɓǝà purî ɓá nzali Masar.<verse eid="EXO 6:13" /></para>
  <para style="s">Tǝ́r tàu mala Musa andǝ Haruna</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />Amǝnia ka à nda ka kau mala atau a nggurkwar mala Musa andǝ Haruna:</para>
  <para style="li1" vid="EXO 6:14">Amuna-burana mala Ruben, muna-dǝmba mala Isǝrayila ka à nda ka:</para>
  <para style="li2" vid="EXO 6:14">Hanok, andǝ Palu, andǝ Hezǝron, sǝ Karmi. À nda ka kau a nggurkwar mala Ruben.<verse eid="EXO 6:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 6:15" />Amuna-burana mala Shimiyon ngga à nda ka:</para>
  <para style="li2" vid="EXO 6:15">Jemuyel, andǝ Jamin, andǝ Ohat, andǝ Jakin, andǝ Zohar, sǝ Shawul muna mala ɓwama Kan'ana. À nda ka kau a nggurkwar mala Shimiyon.<verse eid="EXO 6:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="EXO 6:16" />Amǝnia ka, à nda ka lullǝ amuna andǝ amǝkau mala Lawi, arǝ aɓala malea, sǝ arǝ anza malea:</para>
  <para style="li1" vid="EXO 6:16">Gashon, andǝ Kohat, sǝ Merari. Sauwa mala do ɓanza mala Lawi ka, apǝlǝa gbǝman mwashat nǝ lumi-tàrú nǝ mǝsǝi tongno-nong ɓari na (137).<verse eid="EXO 6:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="EXO 6:17" />Amuna-burana mala Gashon ngga à nda ka:</para>
  <para style="li2" vid="EXO 6:17">Libǝni andǝ Shimeyi, koyan ngga a nggurkwar male.<verse eid="EXO 6:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EXO 6:18" />Amuna-burana mala Kohat ka à nda ka:</para>
  <para style="li2" vid="EXO 6:18">Amram, andǝ Izǝhar, andǝ Hebǝron, sǝ Uziyel. Sauwa mala do ɓanza mala Kohat ka apǝlǝa gbǝman mwashat nǝ lumi-tàrú nǝ mǝsǝi tàrú na (133).<verse eid="EXO 6:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="EXO 6:19" />Amuna-burana mala Merari ka, à nda ka:</para>
  <para style="li2" vid="EXO 6:19">Mali andǝ Mushi.</para>
  <para style="m" vid="EXO 6:19">Aɓwana mǝno kat à tsaɗi lullǝia ka à pur a tàu mala Lawi; à tsaɗia arǝ anza malea.<verse eid="EXO 6:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="EXO 6:20" />Amram al Jochebet mǝ'kyauwa tárrí, sǝ ɓǝlî wi amuna-burana ɓari:</para>
  <para style="li2" vid="EXO 6:20">Haruna andǝ Musa. Sauwa mala do ɓanza mala Amram ngga pǝlǝa gbǝman mwashat nǝ lumi-tàrú nǝ mǝsǝi tongno-nong ɓari na [137].<verse eid="EXO 6:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="EXO 6:21" />Amuna-burana mala Izǝhar ka à nda ka:</para>
  <para style="li2" vid="EXO 6:21">Kora, andǝ Nefeg, sǝ Zǝkiri.<verse eid="EXO 6:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="EXO 6:22" />Amuna-burana mala Uziyel ka à nda ka:</para>
  <para style="li2" vid="EXO 6:22">Mishayel, andǝ Elzafan, sǝ Sitǝri.<verse eid="EXO 6:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="EXO 6:23" />Haruna al Elisheba, nsarile Aminadap sǝ mǝ'eam Nashon. Elisheba ɓǝlî wi amuna-burana, à nda ka:</para>
  <para style="li2" vid="EXO 6:23">Nadap, andǝ Abihu, andǝ Eleaza, sǝ Itamar.<verse eid="EXO 6:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="EXO 6:24" />Amuna-burana mala Kora ka à nda ka:</para>
  <para style="li2" vid="EXO 6:24">Asir, andǝ Elkana, sǝ Abiyasaf. À nda ka kau a nggurkwar mala Kora.<verse eid="EXO 6:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="EXO 6:25" />Eleaza muna-ɓwabura mala Haruna ka yi al mwashat atà ansarina mala Putiyel, sǝ ɓǝlî wi muna-ɓwabura male:</para>
  <para style="li2" vid="EXO 6:25">Finehas.</para>
  <para style="m" vid="EXO 6:25">Amǝno ka à nda ka aká aɓwana andǝ amǝɓala malea a tàu mala Lawi, koyan ngga a nggurkwar male.<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />Haruna andǝ Musa mǝnana à tunǝ lullǝia a tsaɗya mala alullǝu kani ka, à nda mǝnana Yahweh bangcau nǝia ka ama, &lt;&lt;Wu pusǝ amǝ Isǝrayila ɓǝà purî ɓá nzali Masar, koya tàu ka a nggǝsan malea a nzǝmarǝia.&gt;&gt; <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />Kǝ yià, Musa andǝ Haruna mǝnia ka, à nda ka aɓwana mana à bangcau nǝ Firona, murǝm Masar ace pusǝ amǝ Isǝrayila ɓǝà purî Masar ka.<verse eid="EXO 6:27" /></para>
  <para style="s">Yahweh bangcau nǝ Musa andǝ Haruna</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />A pwari mana Yahweh bangcau nǝ Musa a nzali Masar ka, <verse eid="EXO 6:28" /><verse number="29" style="v" sid="EXO 6:29" />Yahweh ne wi ama, &lt;&lt;Mǝ nda Yahweh. Banggi Firona murǝm Masar gìr mana kat ǝn banggo ka.&gt;&gt;<verse eid="EXO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 6:30" />Sǝ Musa ka na a ɓadǝm Yahweh ama, &lt;&lt;Sǝni, ǝn sǝlǝ nacau ɗàng; lang sǝ Firona nǝ̀ kwakikiri arǝàm?&gt;&gt;<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />Pǝlǝa Yahweh banggi Musa ama, &lt;&lt;Sǝni, ǝn nyésǝ̀no a dumǝna kǝla Ɓakuli aban Firona, sǝ mǝ'eambo Haruna ka nǝ̀ do nda mǝɓangnǝa mô. <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />Awu nǝ bang cau mana kat ǝn banggo ka, sǝ mǝ'eambo Haruna ka nǝ̀ banggi Firona ama dumǝna púp ɓǝ̀ panzǝ amǝ Isǝrayila ɓǝà purî nzali male. <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" />Sǝama, mǝ nǝ candǝmúr Firona, sǝ ko ɓǝ̀ ǝn hatǝki pàkkì agir-lǝmdǝa, andǝ agir-ndǝlǝki a nzali Masar ka, <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />Firona pà nǝ̀ oka wun ɗàng. Pǝlǝa mǝ nǝ nongsǝ buam amur Masar, sǝ mǝ nǝ pàkkì agir mǝgulke mala ɓashi mem, mǝ nǝ pusǝ atau mala aɓwana mem, amǝ Isǝrayila, à nǝ̀ purî ɓá nzali Masar. <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />Nda wuni amǝ Masar nǝ̀ sǝlǝ ama mǝ nda Yahweh, a pwari mana ɓǝ̀n lǝmdǝna buam arǝ Masar, mǝ nǝ pusǝ amǝ Isǝrayila ɓǝà purî ɓālǝia ka.&gt;&gt;<verse eid="EXO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 7:6" />Musa andǝ Haruna pàk gìr mǝnana Yahweh banggia wia ama ɓǝà pàk ka. <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />A bàkú mana à waria banggi Firona cau ka, apǝlǝa mala Musa ka, lumi-tongno-nong-tàrú na (80), sǝ mala Haruna ka, lumi-tongno-nong-tàrú nǝ mǝsǝ tàrú na (83).<verse eid="EXO 7:7" /></para>
  <para style="s">Yahweh lǝmdǝì Firona rǝcandǝa male</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />Pǝlǝa Yahweh ne Musa andǝ Haruna ama, <verse eid="EXO 7:8" /><verse number="9" style="v" sid="EXO 7:9" />&lt;&lt;Ɓǝ̀ Firona bangga wun ama ɓǝ̀ wu pàk gir'ndǝlǝki ka, ne Haruna ɓǝ̀ twal gara male ɓǝ̀ túrí a ɓadǝm Firona, garè nǝ̀ pǝlǝ n'yau.&gt;&gt;<verse eid="EXO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 7:10" />Pǝlǝa Musa andǝ Haruna wari aban Firona Murǝm, à kya pa kǝla mǝnana Yahweh banggia wia ka. Haruna túr gara male a ɓadǝm Firona andǝ amǝgulo male, sǝ garè kara pǝlǝ n'yau. <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />Pǝlǝa Firona tunǝ amǝ'sǝlǝe andǝ amǝ'monzǝo; sǝ yià gbal, amǝ'pakki anggár mala Masar ka, à paktúró nǝ monzǝo malea à pak gbal kǝla mǝnana Musa pak ka. <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />À túrki agara malea a nzali, sǝ agara pǝlǝ an'yau. Sǝama gara mala Haruna myal agara malea. <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />Kat andǝ amani ka, Firona candǝmúrí. Sǝ kǝla mǝnana Yahweh bang ngga, anggo sǝ pa, ko Firona kwakikiri arǝ Musa andǝ Haruna ɗàng.<figure style="fig" alt="Aaronʼs staff becomes a snake" file="co00801.jpg" size="col" loc="7:13" copy="Cook" ref="7:8-13">Gara mala Haruna pǝlǝ n'yau</figure><verse eid="EXO 7:13" /></para>
  <para style="s">Yahweh tasǝta agir'mur'mwana amur amǝ Masar</para>
  <para style="s2">Mùr Nggeasala Nayel pǝlǝ nkila</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Firona ka múrí-candǝna, sǝ ɓinǝna pà nǝ̀ nying amǝ Isǝrayila ɓǝà u ɗang. <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />Acemani ka, kyane kya kumi nǝ dǝmbari lang purna nǝ̀ ká a nggeasala ka. Cam a kún Nggeasala Nayel sǝ wu kundǝi ace mǝnana wun nǝ̀ je wunǝi ka. Twal gara mò mǝno pǝlǝ n'yau ka a buo. <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />Banggi wi ama, &lt;Yahweh, yì Ɓakuli mala amǝ'Ibǝru tasǝam ɓǝ̀n banggo ama, &lt;&lt;Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya peri abanam a ɓabondo ka.&gt;&gt; Sǝ bà ado ka a kwakikiro ɗàng. <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" />Ado ka, Yahweh kǝ bang ama, &lt;&lt;Nǝ mǝnia ka, sǝ awu nǝ sǝlǝ ama, mǝ nda Yahweh.&gt;&gt; Sǝni, nǝ gara mǝnia a buam ngga, mǝ nǝ wal mùr Nggeasala Nayel, sǝ mùrî ka nǝ̀ pǝlǝ nkila. <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />Nji mǝnana kat a Nggeasala Nayel ka nǝ̀ wú, sǝ rǝmban mǝɓane nǝ̀ ak mùr, sǝ amǝ Masar nǝ̀ ginǝki nu mùrnî.&gt; &gt;&gt;<verse eid="EXO 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 7:19" />Yahweh ne Musa ama, &lt;&lt;Banggi Haruna ɓǝ̀ twal gara male a buì sǝ ɓǝ̀ sárǝí amur amúr mala nzali Masar, amur anggeasala malea, andǝ amyalmúr malea, andǝ aguguri malea, andǝ tūli-mùr malea, ace mǝnana ɓǝà pǝlǝ nkila ka. Nkila nǝ̀ ak ɓá nzali Masar kat, yàle kat andǝ ɓalǝ adù-mùr andǝ abàng-mùr.&gt;&gt;<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />Nda Musa andǝ Haruna pak kǝla mǝnana Yahweh banggia wia ka. A mǝsǝ Firona andǝ amǝtúró male, Haruna loasǝ gara male wal mùr Nggeasala Nayel nǝi, sǝ mùr nggeasala kat ka, pǝlǝ nkila. <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />Nji mǝnana a nggeasala kat ka wǔ rǝmbô, sǝ rǝmban mǝɓike ak mùr kat, gandǝa amǝ Masar gandǝ nue ɗàng. Koya ban aɓa Masar ka nkila na.<verse eid="EXO 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 7:22" />Sǝ amǝ'pakki agir nggár mala Firona gbal ka, à pàktúró nǝ monzǝo malea, à nyesǝ mùr pǝlǝ nkila. Sǝ kǝla mǝnana Yahweh na ka, Firona tǝ́r ɓabumi, ɓinǝ kwakikiri arǝ Musa andǝ Haruna. <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />Kara wulio, bwal njar o a palta male, falǝ nǝia ɗàng. <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />Pǝlǝa amǝ Masar kat kùtí a tǝm sala a kún Nggeasala Nayel aban alta mùr-nùná, acemǝnana à pà nǝ̀ gandǝ nu mùr mala nggeasalê ɗàng.<verse eid="EXO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25" />Anonggió tongno-nong-ɓari yi kutio anzǝm mana Yahweh tsǝk mùr Nggeasala Nayel pǝlǝ nkila ka.<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s2">Gìr'mur'mwana mala anɗwalung</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Kya aban Firona murǝm Masar, sǝ wu ne wi ama: Yahweh na kǝ banggo ama, &lt;Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya peri a banam ngga. <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />Ɓǝ̀ a ɓinǝ nyia ɓǝà u ka, sǝni mǝ nǝ tsǝa nzali mô kat nǝ̀ lùmsǝ nǝ anɗwalung. <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />Nggearǝ Nggeasala Nayel ka nǝ̀ lùmsǝ nǝ anɗwalung, yàle à nǝ̀ nggá ara aɓa palta mô, andǝ ndà-nongŋo mô, andǝ gyangŋan-nongŋo mô, andǝ aɓala mala amǝtúró mô, andǝ amala aɓwana mô kat. Ko nggearǝ andá-lurǝgìr andǝ atasau-sùrǝ̀gir ma'wun ngga à nǝ̀ lùmsǝ nǝ anɗwalung. <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />Anɗwalung nǝ̀ eauwe amuro, andǝ múr aɓwana mô, andǝ múr amǝtúró mô kat.&gt; &gt;&gt;<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />Pǝlǝa Yahweh banggi Musa ama, &lt;&lt;Banggi Haruna ɓǝ̀ lǝmdǝ gara male mǝnana a buì ka amur anggeasala, andǝ amyal-múr, andǝ aguguri, ɓǝ̀ tsǝk anɗwalung ɓǝà eauwe ɓǝà kya gir nzǝm-nzali Masar kat.&gt;&gt;<verse eid="EXO 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 8:6" />Pǝlǝa Haruna lǝmdǝ gara male mana a buì ka amur amúr mala Masar, sǝ anɗwalung eapi mùr à kya lumsǝ ɓá nzali Masar. <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />Sǝ amǝ'pakki agir nggár pak gìr mǝmwashati nǝ túró kutan malea, à tsǝk anɗwalung à yiu amur nzali Masar.<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />Pǝlǝa Firona Murǝm tunǝ Musa andǝ Haruna, sǝ banggia wia ama, &lt;&lt;Wu zǝmbî Yahweh ɓǝ̀ twàlâm amǝnia yì anɗwalung ngga, ɓǝà nying sǝm sǝnǝ aɓwana mem, sǝ mǝ nǝ nying aɓwana mô ɓǝà o ace mǝnana ɓǝà kya pa agir'nkila aban Yahweh ka.&gt;&gt;<verse eid="EXO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 8:9" />Musa pe wi eare ama, &lt;&lt;Ən nggǝ pò gulo mala nyinggo tsǝk pwari mǝnana ɓǝ̀n pak hiwi nǝi aceo, sǝ ace amǝ'túró mô, andǝ aɓwana mô, ace mǝnana anɗwalung ɓǝà nying wun andǝ aɓala ma'wun ngga, shekǝ amana a Nggeasala Nayel ka.&gt;&gt;<verse eid="EXO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 8:10" />Firona banggi wi ama, &lt;&lt;Pè lí.&gt;&gt;</para>
  <para style="p" vid="EXO 8:10">Pǝlǝa Musa banggi wi ama, &lt;&lt;Mǝ nǝ pè kǝla mǝnana a bang ngga, sǝ awu nǝ sǝlǝ ama kǝ ɓè ɓakuli pa kàm kǝla Yahweh Ɓakuli ma'sǝm ɗàng. <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />Anɗwalung nǝ̀ upì ban wun, andǝ aɓala ma'wun, andǝ mala amǝ'túró mô, andǝ mala aɓwana mô. Kǝ amǝnana à nǝ̀ ue ka à nda ka mana a Nggeasala Nayel ka.&gt;&gt;<verse eid="EXO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 8:12" />Pǝlǝa Musa andǝ Haruna nying ɓadǝm Firona Murǝm, sǝ Musa ɓua aban Yahweh ama, ɓǝ̀ pǝ̀r anɗwalung mǝnana yinǝia amur Firona, murǝm Masar ka. <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />Yahweh pak kǝla mǝnana Musa zǝm ngga. Anɗwalung mana arǝ aɓala, andǝ amǝnana a palta, andǝ amǝnana arǝ abanfana ka, à wukio. <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />Amǝ Masar ramgia amur rǝarǝia gum-gum, sǝ nggea rǝmban mǝɓike ak nzali Masar. <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />Lang Firona Murǝm sǝni kumǝna usǝlǝo bǝti ka, kara candǝmúrí ɗǝm, ɓinǝ kwakikiri arǝ Musa andǝ Haruna, kǝla mǝnana Yahweh bang ngga.<verse eid="EXO 8:15" /></para>
  <para style="s2">Gìr'mur'mwana mala agirlanduno</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />Nda Yahweh banggi Musa ama, &lt;&lt;Ne Haruna ɓǝ̀ loasǝ gara male ɓǝ̀ wal nzali nǝi sǝ tú ka nǝ̀ pǝlǝ agirlanduno a koya ban aɓa nzali Masar kat.&gt;&gt; <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />Anggo sǝ à pa. Haruna loasǝ gara male wal nzali, kara tú nzali Masar pǝlǝ agirlanduno, mǝnana à akrǝ aɓwana andǝ agirkusǝu ka; tú nzali kat pǝlǝ agirlanduno a koya ban aɓa nzali Masar kat. <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />Amǝ'pakki agir nggár mala Firona ɓariki à nǝ̀ pàktúró nǝ monzǝo ɓǝ̀ agirlanduno puro, sǝ ko à gandǝi ɗàng. Sǝ agirlanduno ueo arǝ aɓwana andǝ agirkusǝu.<verse eid="EXO 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 8:19" />Amǝ'pakki agir nggár banggi Firona ama, &lt;&lt;Mǝnia ka, túró mala Ɓakuli na!&gt;&gt;</para>
  <para style="p" vid="EXO 8:19">Sǝ kǝla mǝnana Yahweh bang ngga, Firona candǝmúrí, ɓinǝ kwakikiri arǝ Musa andǝ Haruna.<verse eid="EXO 8:19" /></para>
  <para style="s2">Gìr'mur'mwana mala sǎ mala anggi</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />Yahweh ne Musa ama, &lt;&lt;Lo nǝ dǝmbari ɗiɗyal sǝ wu kya kasǝkun Firona ɓǝ̀ purna nǝ̀ o a nggeasala ka. Banggi wi ama, Yahweh kǝ bang ama, &lt;Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya peri a banam ngga. <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />Ɓǝ̀ a ɓinǝ nying aɓwana mem ɓǝà u ka, mǝ nǝ tasǝ anggi nggǝm-nggǝm amuro, amur amǝ'túró mô, sǝ amur acili aɓwana mô. À nǝ̀ kutikio arǝ aɓala ma'wun. Aɓala mala amǝ Masar nǝ̀ lùmsǝ nǝ anggi nggǝm-nggǝm, sǝ à nǝ̀ gìr múr nzali mǝnana à duk kam ngga.<verse eid="EXO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 8:22" />&lt;&lt; &lt;Sǝama a pwari mǝno ka, mǝ nǝ yál bu-nzali Goshen, ban mǝnana aɓwana mem nakam nǝ do ka; kǝ anggi pa nǝ̀ pàk kàm ɗàng, ace mǝnana wu sǝlǝ ama, Mim, Yahweh ka, mǝ ndakam aɓa nzali mǝnia ka. <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />Mǝ nǝ gau nre aɓwana mem andǝ aɓwana mô. Mǝnia yì gìr'lǝmdǝa ka nǝ̀ kumban li.&gt; &gt;&gt;<verse eid="EXO 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 8:24" />Yahweh pè anggo; Yahweh tasǝ anggi nggǝm-nggǝm, à yì ak ɓá palta mala Firona Murǝm, andǝ aɓala mala amǝ'túró male. Ɓá nzali Masar kat kìɗìkì nǝ anggi.<verse eid="EXO 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25" />Pǝlǝa Firona túrban ɓǝà tunǝ Musa andǝ Haruna sǝ bang ama, &lt;&lt;Wu kyane, wu kya pa gìr'nkila aban Ɓakuli ma'wun aɓa nzali Masar kani.&gt;&gt;<verse eid="EXO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 8:26" />Sǝ Musa banggi wi ama, &lt;&lt;Mǝno ka pà nǝ̀ ɓoaro ɓǝ̀ sǝm pè anggo ɗàng. Apagir mala gir'nkila mǝnana sǝm nǝ̀ pà aban Yahweh Ɓakuli ma'sǝm ngga, gìr'ɓeami na aban amǝ Masar. Sǝ ɓǝ̀ sǝm pà agir'nkila mǝnana gìr'ɓeami na a mǝsǝia ka, à pà nǝ̀ ɓukki sǝm nǝ atali re? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />Dumǝna púp sǝm nǝ̀ twal gya mala nongŋo tàrú aban o a ɓabondo, sǝ sǝm nǝ̀ pà gìr'nkila aban Yahweh Ɓakuli ma'sǝm, kǝla mǝnana bangga sǝm ngga.&gt;&gt;<verse eid="EXO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 8:28" />Firona bang ama, &lt;&lt;Mǝ nǝ nying wun ɓǝ̀ wu kyane wu kya pa gìr'nkila aban Yahweh Ɓakuli ma'wun a ɓabondo, sǝama wu kǝa u kuko ɗàng. Ado ka, wu pàkkam hiwi.&gt;&gt;<verse eid="EXO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 8:29" />Musa eari wi ama, &lt;&lt;Mǝ ndo mǝ nǝ purî ɓadǝmbo, mǝ nǝ pàk hiwi aban Yahweh, sǝ li ka, anggi nǝ̀ nyio wunǝ amǝ'túró mô, andǝ acili aɓwana mô. Sǝama cè a nyare a swarki sǝm ɗǝm, a tamsǝ aɓwana arǝ o a pà gìr'nkila aban Yahweh ɗàng.&gt;&gt;<verse eid="EXO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 8:30" />Nda Musa puro nying palta mala Firona sǝ zǝmba aban Yahweh ɓǝ̀ pǝ̀r anggi kat ɓǝà u ka. <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />Sǝ Yahweh pak kǝla mǝnana Musa zǝmbi wi ka; sǝ tsǝk nggea làkkì mala anggi man à ndǝrmì ban Firona, andǝ amǝ'túró male andǝ acili aɓwana male. Kǝ nggi ueo ko mwashat ɗàng. <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />Sǝ kat andǝ mǝno ka Firona Murǝm candǝmúrí, nyare ɓinǝ nying aɓwe ɓǝà o.<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s2">Gìr'mur'mwana mala lú mala agirkusǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Nyare o aban Firona kya ne wi ama, &lt;Yahweh, Ɓakuli mala amǝ Ibǝru kǝ bang ama: Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya peri abanam ngga. <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />Ɓǝ̀ a ginǝna ɗǝm a pa wunǝ nyia ɓǝà u raka, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />buam, Mim Yahweh nǝ̀ sulǝ gìr'mur'mwana mǝɓike kǝ̀rkǝ́r amur agirkusǝu ma'wun mǝnana a patal ka; apǝr ma'wun andǝ amǝdambǝriso ma'wun, andǝ akalakadambi ma'wun, andǝ andá ma'wun, andǝ anzur ma'wun, andǝ ambul-pǝndǝa ma'wun. <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />Sǝama mǝ nǝ gakkita agirkusǝu mala amǝ Isǝrayila andǝ mala amǝ Masar; kǝ agirkusǝu mala amǝ Isǝrayila na à pà nǝ̀ wù raka. <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />Mim Yahweh ka ǝn tsǝ̀ngŋǝ̀nà lí ɓǝ̀ duk pwari mana mǝ nǝ pàk mǝnia yì gìr ka.&gt; &gt;&gt;<verse eid="EXO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 9:6" />Ban yi fana ka, Yahweh pàk gìr mǝnana na ama nǝ̀ pàk ka; agirkusǝu mala amǝ Masar kat wukio, sǝ agirkusǝu mala amǝ Isǝrayila ka, kǝ ɓè wù ɗàng. <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />Firona ɗiban, sǝ à ne wi gìr mǝnana kumban ngga, ama kǝ girkusǝu mala amǝ Isǝrayila wù ɗàng. Sǝ yì ka, nying buì arǝ murcandǝa male ɗàng; ginǝ nying amǝ Isǝrayila ɓǝà o.<verse eid="EXO 9:7" /></para>
  <para style="s2">Gìr'mur'mwana mala ceakúmsǝǎm</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />Yahweh ne Musa andǝ Haruna ama, &lt;&lt;Wu pwan tú ɓá ndà-ntul arǝ aɓabu wun; Musa ɓǝ̀ mesǝi aɓa gung a ɓadǝm Firona. <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" />Tú mǝno nǝ̀ mesǝe kǝla kǝkǝri amur nzali Masar kat, sǝ nǝ̀ yinǝ ceakúmsǝǎm, sǝ yì ceakúmsǝǎm ngga à nǝ̀ pǝlǝ ampengŋe gula arǝ ɓwapǝndǝa andǝ agirkusǝu aɓa nzali Masar kat.&gt;&gt; <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" />Nda à pwan tú a ndà-ntul sǝ à o à kya came a ɓadǝm Firona; Musa mesǝ tú aɓa gung, kara ceakúmsǝǎm mǝnana pǝlǝ ampengŋe gula ka à sàkkya arǝ ɓwapǝndǝa andǝ agirkusǝu. <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />Nggearǝ amǝ pàkki agir nggár ka à gandǝ came a ɓadǝm Musa ɗàng atàcau mala ceakúmsǝǎm, acemǝnana rǝia kat ka, ceakúmsǝǎm e kǝla mǝnana ak rǝ amǝ Masar kat ka. <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />Sǝ Yahweh ka candǝ ɓabum Firona, ɓinǝ okia Musa andǝ Haruna, kǝla mǝnana Yahweh ne Musa ka.<verse eid="EXO 9:12" /></para>
  <para style="s2">Gìr'mur'mwana mala talimbulo</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Lo nǝ bari ɗiɗyal kyane lǝmdǝ ɓamurò a ɓadǝm Firona, sǝ wu ne wi ama, &lt;Yahweh, Ɓakuli mala amǝ Ibǝru kǝ na ama: Nying aɓwana mem ɓǝà o ace mǝnana ɓǝà kya peri abanam ngga. <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />Sǝ ɓǝ̀ a ginǝ ka, mǝnia adyan ngga mǝ nǝ tasǝ gìr'mur'mwana mǝnana kútì amana ɗiɗyal ka amuro, nggearǝ we, sǝ amur amǝtúró mô, sǝ amur aɓwana a là ma'wun kat. Sǝ wun nǝ̀ sǝlǝ ama, aɓa ɓanza kat ka ɓekǝ ɓwa pà kàm kǝla mim ɗang. <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />Ɓǝ̀n ear ka ɓǝ́ adyan ngga ǝn loasǝna buam ǝn kongŋǝ̀no wunǝ aɓwana mô nǝ nggea kwánó mǝɓike, mǝnana ɓǝ́ twalnata wun a bum ɓanza kat ka. <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" />Sǝ mim ngga ǝn nyio nǝyilǝmu ace mǝnana ɓǝ̀n lǝmdǝo rǝcandǝa mem, sǝ ɓǝ̀ lullǝam zǝ́kí a ɓanza kat. <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />Sǝ kat andǝ amǝno ka, a kǝ twalkirǝo amur aɓwana mem più, sǝ a ɓinǝ ɗekia ɓǝà o. <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />Sǝni, lí, a bu-pwari mǝnia ka, mǝ nǝ sulǝ talimbulo mǝkǝ̀rkǝ́rnì mǝnana nzali Masar malaká sǝn ulangnì raka, twal a pwari mana à kwambi nǝi ka, yi pur ado. <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />Ado ka, túrban ɓǝà nyesǝ agirkusǝu mô andǝ koya gìr mǝnana nda a patal ka, ɓǝà kùtí aɓata tara. Ɓǝ̀ ɓwa, sǝ ɓǝ̀ girkusǝu na mǝnana kat talimbulo man kumi a nza ka, nǝ̀ wù kat.&gt; &gt;&gt;<verse eid="EXO 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 9:20" />Aɓwana-mǝgule mala Firona Murǝm mana ɓangciu pakkia wia arǝ cau mǝnana Yahweh na ka, à nyesǝ aguro andǝ agirkusǝu malea akaurǝa ɓǝà yi kútí arǝ aɓala ace kum àwá. <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />Sǝ aɓwana mǝnana à tsǝkir cau mala Yahweh raka, à nying aguro andǝ agirkusǝu malea a patal.<verse eid="EXO 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 9:22" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Sárǝ́ buo a kùli, ace mǝnana talimbulo ɓǝ̀ sulǝo amur nzali Masar kat; amur ɓwapǝndǝa, amur agirkusǝu, andǝ agirpwala mǝnana a ɓaban aɓa nzali Masar ka.&gt;&gt;<verse eid="EXO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 9:23" />Nda Musa loasǝ gara male a kùli, sǝ Yahweh tasǝ sàkkya mala mgbarangce andǝ nya mala talimbulo; sǝ mgbarangce sulǝ nǝ bǝsa amur nzali. Anggo sǝ Yahweh tasǝ talimbulo yi rak kpana-kpana amur nzali Masar kat. <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />Lang talimbulo na arǝ nya ka, bǝsa camarǝ liki'nzama aɓalǝi. À nya talimbulo kǝ̀rkǝ́r ulang mǝnana a do mala Masar kǝla nzali ka, à nya ulang mǝno raka. <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />Talimbulo mǝno kiɗiki koya gìr mǝnana kumi a nza aɓa nzali Masar ka, kat andǝ ɓwapǝndǝa andǝ agirkusǝu. Agirpwala mǝnana a ɓaban ngga, talimbulo koea rangsǝia a nzali kat, sǝ makki anggun mǝnana kat a patal ka, ɓungia gucik-gucik. <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />Kǝ ban mǝnana ueo talimbulo je raka, nda bu-nzali mala Goshen, ban mǝnana amǝ Isǝrayila duk kam ngga.<verse eid="EXO 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 9:27" />Firona Murǝm túrban ɓǝà tunǝ Musa andǝ Haruna sǝ banggia wia ama, &lt;&lt;Adyan ngga, ǝn pángŋǝ̀nà cauɓikea! Yahweh ka mǝɓealɓoarna na, sǝ mim sǝnǝ aɓwana mem ngga, sǝm ɓwarkina. <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />Ida, wu zǝmbî Yahweh! Sàkkya mala mgbarangce andǝ nya mala talimbulo mala Ɓakuli ka, kārǝ́na anggo. Mǝ nǝ nying wun wu o; ɓoaro wu duk kani ɗǝm ɗàng.&gt;&gt;<verse eid="EXO 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 9:29" />Musa ne wi ama, &lt;&lt;Ən nggǝ purî ɓá nggea-là ani ka, mǝ nǝ loasǝ buam a kùli aban Yahweh. Talimbulo andǝ mgbarangce nǝ̀ came, sǝ awu nǝ sǝlǝ ama ɓanza ka mala Yahweh na. <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />Sǝ ǝn sǝlǝna ama we wunǝ aɓwana-mǝgule mò ka, wu malaká ɓanggi Yahweh Ɓakuli peatu ɗàng.&gt;&gt;<verse eid="EXO 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 9:31" />(Aɓa mǝno anggo ka záng andǝ mǝssa mala bálì ka à kiɗikina, acemǝnana bálì ka ɓǝlǝna sǝ záng ngga nda rǝ sak pwasǝe. <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />Sǝama mǝssa alkama andǝ mutsǝkǝm ngga à kiɗiki ɗàng, acemǝnana à yi ɓǝl nǝnzǝ́mò.)<verse eid="EXO 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 9:33" />Musa nying palta mala Firona Murǝm, purî nggea-là sǝ kya loasǝ abui aban Yahweh; sàkkya mala mgbarangce andǝ kpa mala talimbulo, andǝ nya mala mbulo a nzali ka à came. <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />Lang Firona Murǝm sǝni sàkkya mala mgbarangce, andǝ kpa mala talimbulo, andǝ nya mala mbulo camǝna ka, nyare pàk cauɓikea ɗǝm. Yì andǝ aɓwana-mǝgule male candǝmúrià. <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />Anggo sǝ Firona tǝr ɓabumi, ɓinǝ nying amǝ Isǝrayila ɓǝà o, kǝla mǝnana Yahweh bangŋi nǝ kún Musa ka.<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s2">Gìr'mur'mwana mala sǎ mala doshi</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Nyar aban Firona Murǝm. Ən tsǝ́ngŋǝ̀nà murcandǝa a ɓabumi andǝ ɓabum aɓwana-mǝgule male, ace mǝnana mǝ lǝmdǝ agir'ndali mem aɓalǝia ka. <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" />Mǝ nǝ pàk mǝno yì gìr ka ace mǝnana ɓǝ̀ wu banggi amuna ma'wun andǝ amǝ'kà wun, ulang ɓangginǝban mǝnana ǝn ɓangginǝ amǝ Masar,<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">ulang ɓangginǝban mǝnana ǝn ɓangginǝ amǝ Masar </char><char style="ft" closed="false">ko pa mǝnana ǝn pangnǝ amǝ Masar hakǝrak</char></note> andǝ agir-lǝmdǝa mǝnana ǝn pea, ace mǝnana ɓǝ̀ wu sǝlǝ ama mǝ nda Yahweh ka.&gt;&gt;<verse eid="EXO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 10:3" />Nda Musa andǝ Haruna wari aban Firona Murǝm à kya banggi wi ama, &lt;&lt;Yahweh Ɓakuli mala amǝ Ibǝru kǝ na ama, &lt;Nǝ̀ sau lang sǝ awu nǝ ginǝ nongsǝmuro abanam? Nying aɓwana mem ɓǝà o, ace mǝnana ɓǝà kya peri abanam ngga. <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />Sǝ ɓǝ̀ a ɓinǝ nying aɓwana mem ɓǝà u ka, loasǝ mǝsǝo, lí ka mǝ ndo mǝ nǝ sulǝ doshi amur nzali ma'wun. <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />À nǝ̀ gìr múr nzali ma'wun, yàle pà wu nǝ̀ gandǝ sǝn nzǝm nzali ɗang ace ɓiki lakkì malea. À nǝ̀ lì gìr mǝnana kat talimbulo nyî kiɗiki raka, sǝ à nǝ̀ kpǝri koya nggun mǝnana ueo kǝ gulo aɓa nzali ma'wun ngga. <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />À nǝ̀ yia lùmsǝ palta mô, andǝ aɓala mala amǝtúró mô, andǝ mala aɓwana mala nzali Masar kat. Ɓike malea nǝ̀ kàrmúr gir kat, mǝnana atár wun andǝ aká wun ɓara-ɓara sǝni, twal a do malea a nzali mǝnia yi puro a yalung ngga.&gt; &gt;&gt; Sǝ Musa wulio, upi ɓadǝm Firona.<verse eid="EXO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7" />Aɓwana-mǝgule mala Firona yiu à yi banggi wi ama, &lt;&lt;Nǝ̀ sau lang sǝ ɓwabura man nǝ̀ nggǝ pá sǝm tanni anggo? Nying aɓwana mǝno ɓǝà o, ace mǝnana ɓǝà kya peri aban Yahweh Ɓakuli malea! A sǝlǝ mbak ama, Masar kiɗikina?&gt;&gt;<verse eid="EXO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 10:8" />Nda à nyesǝ Musa andǝ Haruna a ɓadǝm Firona, sǝ yi banggia wia ama, &lt;&lt;Wu kyane, wu kya peri aban Yahweh Ɓakuli ma'wun! Sǝ nggeari kǎ, ayana ɗe aɓalǝ wun mǝnana à nǝ̀ u ka?&gt;&gt;<verse eid="EXO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 10:9" />Musa pǝlǝi wi ama, &lt;&lt;Sǝm kat sǝ sǝm nǝ̀ o, alo-ɓwa andǝ akapana, amuna-burana ma'sǝm, andǝ amuna-mamǝna ma'sǝm, anzur ma'sǝm, andǝ ambul-pǝndǝa ma'sǝm, andǝ andá ma'sǝm. Dumǝna púp sǝm kat sǝm nǝ̀ nggá pàk lamsan ace gusǝlǝ Yahweh.&gt;&gt;<verse eid="EXO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 10:10" />Pǝlǝa Firona nea wia ama, &lt;&lt;She ɓǝ̀ Yahweh nǝ̀ bwala wun kàm aɓa kàne ma'wun mǝna ka, sǝama pà mǝ nǝ nying wun, wun nǝ̀ umnǝ amamǝna andǝ amuna ma'wun ɗàng! Acemǝnana ǝn sǝni ka, wu nda rǝ pak kutan mala mgbicau. <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />Pà mǝ nǝ eara wun anggo ɗàng. Kǝ aburana na à nǝ̀ ká peri aban Yahweh ka, acemǝnana mǝno nda gìr mǝnana wu zǝmba cè ka.&gt;&gt; Firona pǝlǝa pǝr Musa andǝ Haruna ɓǝà nying ɓadǝmbi.<verse eid="EXO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Sárǝ́ buo amur nzali Masar ɓǝ̀ doshi sulǝo amurí ɓǝ̀ lì koya girpwala andǝ gir mǝnana kat talimbulo nyî ka.&gt;&gt; <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />Nda Musa lǝmdǝ gara male amur nzali Masar, sǝ Yahweh loasǝ gung nǝ takuli yi ɓua amur nzali. Mal pwari andǝ du kat, gung na ban ɓua. Lang bân nǝ kwar ka, gung takuli yina nǝ adoshi. <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" />Doshi yiu amur nzali Masar kat, yi sulǝo aki ɓá nzali Masar kat. Sulǝo mala doshi nggǝm-nggǝm mǝno ka, à malaká sǝn ulangnì ɗàng, sǝ à pà nǝ̀ nyare à nǝ̀ sǝn ulangnì ɗǝm ɗàng. <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />À gìr nzǝm-nzali kat, gandǝa nzali pǝlǝ mǝpǝndǝe. À lì girpwala mǝnana a bondo ka kat, andǝ aɓǝla anggun mǝnana talimbulo kúmsǝia raka. Kǝ mbúgir mǝpwale ue ɗǝm amur anggun andǝ bondo aɓa nzali Masar ɗàng.<verse eid="EXO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 10:16" />Firona pǝlǝa túrban akaurǝa ɓǝà tunǝ Musa andǝ Haruna sǝ na ama, &lt;&lt;Ən pángŋǝ́nì Yahweh Ɓakuli ma'wun cauɓikea, sǝ ǝn pángŋǝ̀nà wun cauɓikea. <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />Ado ka, wu twàlâm-ban cauɓikea mem ɗǝm, sǝ wu zǝmbî Yahweh Ɓakuli ma'wun ɓǝ̀ twàlâm-ban mǝnia yì lú ka.&gt;&gt;<verse eid="EXO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 10:18" />Musa pǝlǝa nying ban Firona Murǝm sǝ kya pakhiwi aban Yahweh. <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />Pǝlǝa Yahweh ɓua gung mǝcandǝe tò nǝ njar-nzali, pwan doshi umnǝi a Nggeamùr Nzuno. Kǝ doshi mwashat ueo ɗǝm a koya ban aɓa nzali Masar ɗàng. <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />Sǝ Yahweh ka tsǝk murǝm múrí candǝ ɗǝm, ginǝ nying amǝ Isǝrayila ɓǝà o.<verse eid="EXO 10:20" /></para>
  <para style="s2">Gìr'mur'mwana mala pǝndǝa</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />Yahweh ne Musa ama, &lt;&lt;Loasǝ buo a kùli ace mǝnana pǝndǝa mǝcikcikì, mǝnana à nǝ̀ gandǝ ue nǝ bu ka, ɓǝ̀ gìr mur nzali Masar.&gt;&gt; <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" />Musa pǝlǝa loasǝ bui a kùli sǝ pǝndǝa mǝcikcikì kara ak nzali Masar kat nongŋo tàrú. <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />Kǝɓwa gandǝ sǝn ɓì atà amǝ Masar ɗàng, sǝ kǝɓwa gandǝ nying ɓala male aɓalǝ amǝno yì apwari ka ɗàng. Sǝama a bu bando mala amǝ Isǝrayila ka, tǎlaban nakam.<verse eid="EXO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 10:24" />Pǝlǝa Firona Murǝm tunǝ Musa ne wi ama, &lt;&lt;Wu o, wu kya peri aban Yahweh; amamǝna andǝ amuna ma'wun ɓǝà kyane. Sǝama anzur ma'wun, andǝ ambul-pǝndǝa ma'wun, andǝ andá ma'wun ngga ɓǝà ueo kani.&gt;&gt;<verse eid="EXO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 10:25" />Sǝ Musa ka nyesǝi wi ama, &lt;&lt;Dumǝna púp awu nǝ nying sǝm ɓǝ̀ sǝm umnǝ agirkusǝu andǝ apagir mala pisǝe kǝring a bù sǝm, mǝnana sǝm nǝ̀ nggá pà aban Yahweh Ɓakuli ma'sǝm ngga. <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />Agirkusǝu ma'sǝm nǝ̀ o atà sǝm. Pa sǝm nǝ̀ nying kǝ nkaulakusǝ girkusǝu anzǝ́mò ɗàng. Aɓalǝia sǝ sǝm nǝ̀ twal amǝnana sǝm nǝ̀ nggá pana gir'nkila nǝia aban Yahweh ka. Sǝ pà sǝm nǝ̀ súrǝ̀ ya girkusǝu na sǝm nǝ̀ pana gir'nkila nǝi ka ɗàng, she ɓǝ̀ sǝm bwalǝna ka.&gt;&gt;<verse eid="EXO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 10:27" />Yahweh nyare candǝ múr Firona, ginǝ nying amǝ Isǝrayila ɓǝà o. <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />Firona ne Musa ama, &lt;&lt;Puro nying ɓadǝmbam! Cè a nyare a yiu ama awu nǝ sǝnam ɗǝm ɗàng! Pwari mǝnana a sǝn ɓamǝsǝam ɗǝm ngga, awu nǝ wú!&gt;&gt;<verse eid="EXO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 10:29" />Musa ne wi ama, &lt;&lt;Cau mǝnana a ne ka, nda jik, pà mǝ nǝ sǝn ɓamǝsǝo ɗǝm ɗàng.&gt;&gt;<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s2">Masǝlǝata gìr'mur'mwana</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Mǝ ndanǝ ɓe gìr'mur'mwana mwashat mana mǝ nǝ tasǝte amur Firona murǝm Masar andǝ aɓwana male ka. Anzǝm mǝno ka, nǝ̀ nying wun ɓǝ̀ wu o. Yàle, nǝ̀ pǝ̀r wun nǝ pǝra kat ɓǝ̀ wu nying ban mǝnia ka. <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />Ado ka, bangcau nǝ amǝ Isǝrayila ama, aburana andǝ amamǝna ɓǝà zǝmbî aɓia mǝ'murkala ɓǝà pea wia agir bolo-njengǝlan andǝ bolo-azǝrfa.&gt;&gt; <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" />Yahweh tsǝa amǝ Isǝrayila kum earmúrú aban amǝ Masar. Sǝ Musa ka, ɓwa na amǝ Masar andǝ aɓwana-mǝgule mala Firona twali nǝ gulo kǝ̀rkǝ́r.<verse eid="EXO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 11:4" />Musa wari aban Firona Murǝm sǝ banggi wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh kǝ nô ka, &lt;Nǝ ɓadu yalung ngga, mǝ nǝ gya aɓa nzali Masar. <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />Koya muna-dǝmba aɓa nzali Masar ka nǝ̀ wú, twal amur muna-dǝmba mala Firona Murǝm, kya puro aban muna-dǝmba mala guro ɓwama mana kǝ go mǝsǝsa ka, andǝ muna-dǝmba mala agirkusǝu-ɓala kat. <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />À nǝ̀ ok ɓua mǝcandǝe aɓa Masar kat, yàle ulang ɓuanî ka à malaká oè àkǝ pwari ɗàng, sǝ à pà nǝ̀ ɓǝsǝlǝ ok ulangnì ɗǝm ɗàng. <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />Sǝ a buì mala amǝ Isǝrayila ka, ban nǝ pwal ɗǝong, ko nva pà nǝ̀ gim ɓwa ko girkusǝu ɗang. Sǝ anggo sǝ wun nǝ̀ sǝlǝ ama Mim Yahweh ka, Ən gau nre ka amǝ Masar andǝ amǝ Isǝrayila.&gt; <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />Sǝ aɓwana-mǝgule mò mǝnia kat ka, à nǝ̀ ɓangŋa à nǝ̀ yiu abanam, à nǝ̀ yia ɓunno a nzali a ɓadǝmbam. À nǝ̀ zǝmbam ama, &lt;Ida, wu o, we wunǝ aɓwana mǝnana kat à kǝ̀ kpato ka!&gt; Sǝ anzǝm mǝno ka mǝ nǝ o.&gt;&gt; Pǝlǝa Musa puro o nǝ bumlulla, nying Firona. <verse eid="EXO 11:8" /><verse number="9" style="v" sid="EXO 11:9" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Murǝm Masar pà nǝ̀ kwakikiri arǝò ɗàng. Sǝ aɓa mǝno anggo ka, mǝ nǝ pàkki aɓea agir'ndali amǝgulke kàm aɓa nzali Masar.&gt;&gt;<verse eid="EXO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 11:10" />Musa andǝ Haruna pàkki amǝno yì agir'ndali ka a ɓadǝm Firona Murǝm. Sǝ Yahweh ka tsǝk Firona múrí candǝe, eare nying amǝ Isǝrayila ɓǝà puro ɓǝà nying nzali male ɗàng.<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">Yàlîmurû</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />Mǝnana amǝ Isǝrayila na aɓa nzali Masar più ka, Yahweh pè Musa andǝ Haruna amǝnia yì akwarkiru ka, ama: <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />&lt;&lt;Zongŋo mǝnia aban wun ngga nda nǝ̀ duk zongŋo mǝdǝmbe mala pǝlǝa ka. <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />Banggi ɓinala amǝ Isǝrayila kat, ama, &lt;A lumia nongŋo mala zongŋo mǝnia ka, dumǝna púp koya mǝtala-ɓala ka nǝ̀ twal muna-nzur ko muna-mbul ace amǝ'ɓala male, mwashat ace koya ɓala. <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />Sǝ ɓǝ̀ ɓala ka kyapî muna-nzur ko muna-mbul mwashat ka, yì andǝ ɓi mǝ'murkala ka ɓǝà twal mana nǝ̀ karǝ amǝ'ɓala malea ka; ɓǝà gauwi aɓa kpata làkkì mala aɓwana mǝnana à nǝ̀ lì ka. <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" />Muna-nzur ko muna-mbul mǝnana wun nǝ̀ twal ka, ɓǝ̀ pàk jamne mǝnana mbule mwashat ka, mǝnana kǝ npenye pà arǝì raka.<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 22:19-21">Pǝris 22:19-21</ref>; <ref loc="DEU 17:1">Nggur 17:1</ref>; <ref loc="MAL 1:8">Mal 1:8</ref>,<ref loc="MAL 1:14">14</ref>; <ref loc="HEB 9:14">Ib 9:14</ref></char>.</note> <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />Koya ɓala ka à nǝ̀ ɗenyinǝ muna-mbul ko muna-nzur mǝnana à twal ka. Nǝ́ pwarikpǝra mala lum-nong-inea pwari mala zongŋo mǝnia ka, koya ɓala mala ɓinala amǝ Isǝrayila kat ka, à nǝ̀ pwanmyal agirkusǝu mǝno. <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />À nǝ̀ ɗārǝ́ nkilia sǝ à nǝ̀ hasǝkia arǝ anggun-kunaɓala, arǝ ankanggari andǝ murkuli mala kunɓala mana à nǝ̀ shak anyam agirkusǝu mǝno kam ngga. <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" />Nǝ mǝno yì bù dù ka, à nǝ̀ twan nyame amur bǝsa, sǝ à nǝ̀ shè nǝ mbúgir mǝ'lùlle andǝ bǝredi mana à tsǝki wi yis raka. <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />Wu kǝa shak nyame andapwale ko mǝnana à lambi nǝ mùr ka ɗàng. Nyame ka wu twani nǝ twano kat sǝ wu shè. Wu twani andǝa ɓamúrí, andǝ akusǝi, andǝ alungŋè. <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />Wu kǝa nying kǝ cili nyame ɓǝ̀ bankwari ɗàng. Ɓǝ̀ cili ue ka wu pisǝì. <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" />Lang wun nǝ̀ shak nyame ka, wun nǝ̀ gilǝ rǝ wun ace lo bǝri, nǝ ankura a kusǝ wun, andǝ agara ma'wun a bù wun. Wu lì girline akaurǝa, acemǝnana mǝnia ka Lamsan Yàlîmurû na ace gusǝlǝ lullǝam, Mim Yahweh.<verse eid="EXO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 12:12" />&lt;&lt; &lt;Aɓa kǝ bù dù mǝno ka, mǝ nǝ gya aɓa nzali Masar, mǝ nǝ wal-lú ka amuna-dǝmba mala ɓwapǝndǝa andǝ agirkusǝu aɓa nzali Masar. Sǝ mǝ nǝ yinǝ aɓashi mem amur aɓakuli mǝnana amǝ Masar kǝ peri a bania ka. Mǝ nda Yahweh. <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" />Nkila mǝnana arǝ anggun-kunaɓala ma'wun ngga nǝ̀ duk gìr'lǝmdǝa mǝnana tàr ɓala mana wu duk kam ngga. Sǝ ɓǝ̀ ǝn sǝn nkila ka, mǝ nǝ yàllî mur wun, pa mǝ nǝ pàkka wun mǝɓane ɗàng. Mǝnia yì gìr wal-lú ka pà nǝ̀ je wun ɗàng, yi mana mǝ nda rǝ wal nzali Masar nǝ gìr'mur'mwana ka.<verse eid="EXO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 12:14" />&lt;&lt; &lt;Mǝnia yì pwari ka nǝ̀ dupa wun pwari mala kasǝɓalǝu aban wun arǝ gir mǝnana Yahweh pàk ka, sǝ wun nǝ̀ nggǝ ɗenyi nǝi kǝla lamsan a baní. Dumǝna nggurcau tàtǝ́k, ama arǝ anza ma'wun kat ka, wun nǝ̀ nggǝ pagulo arǝ pwari mǝnia ka nǝ pak lamsan male.<verse eid="EXO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />&lt;&lt; &lt;Wun nǝ̀ twal anongŋo tongno-nong-ɓari wun nǝ̀ nggǝ lì bǝredi mǝnana à pè nǝ muku yis arǝì raka. A pwari mǝdǝmbe mala Lamsan Pakkiɗire ka, wun nǝ̀ pusǝ yis kat arǝ aɓala ma'wun. Aɓalǝ anonggio tongno-nong-ɓari mǝno ka, ɓǝ̀ kǝ ɓwa lì bǝredi mǝnana à pè nǝ muku yis ka, à pà nǝ̀ ɓal ɓwe aɓalǝ aɓwana mem Isǝrayila ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:14">Tite 17:14</ref>; <ref loc="NUM 9:13">Ɓal 9:13</ref></char>.</note> <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />A pwari mǝdǝmbe andǝ tongno-nong-ɓarià pwari ka, wun nǝ̀ yia ramba a banɓwáná ace peri abanam, Mim Yahweh. Aɓalǝ apwari mǝno ɓari ka, pà wun nǝ̀ pàk kǝ túró ɗàng, she kǝ túró lam girlina mana wun nǝ̀ lì ka.<verse eid="EXO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 12:17" />&lt;&lt; &lt;Wu pàk Lamsan mala Bǝredi mǝnana Yis pa arǝì raka, koya pǝlǝa, ace ɗenyinǝ pwari mǝnia ǝn pusǝ atau ma'wun wu purî ɓá nzali Masar nǝi ka. Acemani ka, wun nǝ̀ pagulo arǝ pwari mǝnia, arǝ anza ma'wun kat, kǝla nggurcau tàtǝ́k. <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />Aɓa zongŋo mǝdǝmbe ka wun nǝ̀ lì bǝredi mǝnana yis pà arǝì raka, tite a pwarikpǝra mala lum-nong-inea pwari aban ká pwarikpǝra mala lumi-ɓari-nong-mwashatia pwari. <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />Aɓalǝ anonggio mǝno tongno-nong-ɓari ka, ɓǝà kǝà kum yis ko ɓè kǝgìr kǝla yis arǝ aɓala ma'wun ɗàng ko bǝti. Sǝ ɓwa mǝnana kat lì ɓè kǝgìr nǝ yis aɓalǝi ka, à nǝ̀ kasǝì, ɓǝ̀ ɗwanyi pa aɓa ɓinado mala aɓwana mala Isǝrayila, ko ɓǝ̀ ɓwe ka à ɓǝlì ɓwa Isǝrayila na, ko yì ka ɓwa-kúnɗàngna na ka. <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />Aɓalǝ anonggio mǝno tongno-nong-ɓari ka, pà wun nǝ̀ lì kǝgìr nǝ yis arǝì ɗàng. A rǝ aban mǝnana kat wu duk kam ngga, bǝredi mǝnana yis pà arǝì raka nda wun nǝ̀ lì ka.&gt; &gt;&gt;<verse eid="EXO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />Musa pǝlǝa tunǝ aɓwana-mǝgule mala amǝ Isǝrayila kat sǝ banggia wia ama, &lt;&lt;Koyan atà wun ngga ɓǝ̀ kyane ɓǝ̀ kya tàr muna-nzur ko muna-mbul ace amǝɓala male, sǝ ɓǝ̀ pwan-myali kǝla muna-nzur mala Yàlîmurû. <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />Wu ak nkile aɓa tasau. Wu twal esǝe-kùtùrù, wu oasǝ kúni aɓa nkile sǝ wu hasǝki arǝ anggun-kunaɓala, arǝ ankanggari andǝ murkuli mala kunɓala ma'wun. Anzǝm mǝno ka, koyan ngga ɓǝ̀ do a ɓala ɓǝ̀ kǝa pùr a nza ɗàng, she ɓǝ̀ ban kwarna ka. <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" />Nǝ́ du mǝno ka, Yahweh nǝ̀ ya kútí aɓa Masar, sǝ nǝ̀ wal-lú amǝ'Masar. Lang Yahweh sǝn nkila mǝnana wu hasǝi arǝ ankanggari andǝ murkuli mala anggun-kunaɓala ka, nǝ̀ yàlî mur ɓala mǝno. Pà nǝ̀ earî Mǝturonjar mala Lú ɓǝ̀ kùtí arǝ aɓala ma'wun ɓǝ̀ wal-lú wun ɗàng.<verse eid="EXO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 12:24" />&lt;&lt;Amǝnia yì akwarkiru ka, wun wunǝ amuna ma'wun, wun nǝ̀ kpatea bà. <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />Lang wu kutina a nzali mǝnana Yahweh pa wun cau ace ama nǝ̀ pà wun ngga, wun nǝ̀ lidǝmba nǝ pak mǝnia yì nàtà ka, ɓǝ̀ duk pakkiɗire mala Yàlîmurû koya pǝlǝa. <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" />Lang amuna ma'wun ɗì wun ama, &lt;Mana nda ɓá mǝnia yì nàtà ka?&gt; <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />Wun nǝ̀ earia wia ama, &lt;Mǝnia nda pà gir'nkila mala Yàlîmurû aban Yahweh, acemǝnana Yahweh yàlî múr aɓala mala amǝ Isǝrayila a Masar, lang wal-lú amuna-dǝmba mala amǝ Masar ka, sǝama sǝm ngga je sǝm arǝ aɓala ma'sǝm ɗàng.&gt; &gt;&gt;</para>
  <para style="p" vid="EXO 12:27">Lang Musa malna nacau ka, amǝ Isǝrayila kat ɓun amur ankūnǝia a nzali, à peri aban Yahweh.<verse eid="EXO 12:27" /></para>
  <para style="s">Amuna-dǝmba mala amǝ Masar wú</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 12:28" />Sǝ amǝ Isǝrayila wario à kya pak kǝla mǝnana Yahweh tsǝk Musa andǝ Haruna banggia wia ama ɓǝà pàk ka. <verse eid="EXO 12:28" /><verse number="29" style="v" sid="EXO 12:29" />Nǝ ɓadu gum, Yahweh twalta amuna-dǝmba mala nzali Masar kàng. Twal a ban muna-dǝmba mala Firona Murǝm, mǝnana nda nǝ̀ aki tárrí buno-murǝm ngga, kya bwal ban muna-dǝmba mala koya pursǝna mǝnana nda a ndàkurban ngga, andǝ amuna-dǝmba mala agirkusǝu kat ka, à wal-luia. <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />A mǝno yì dù ka, Firona Murǝm andǝ amǝtúró male, andǝ acilia amǝ Masar ka, mǝsǝia sak kat. Kara ɓua mǝcandǝe twal ɓá Masar kat, acemǝnana kǝ ɓala pà kàm mǝnana ɓwa wù kàm raka ɗàng.<verse eid="EXO 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 12:31" />A kǝ mǝno yì bu dù ka, Firona Murǝm túrban atà Musa andǝ Haruna ɓǝà yiu, sǝ nea wia ama, &lt;&lt;Wu lo! Wu purî ɓalǝ aɓwana mem, wun wunǝ amǝ Isǝrayila! Wu kyane, wu kya peri aban Yahweh kǝla mǝnana wu bang ngga! <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />Wu twal anzur, andǝ ambul-pǝndǝa, andǝ andá ma'wun, kǝla mǝnana wu na ka, wu kyane! Sǝ wu tsǝkam bù gbal!&gt;&gt;<verse eid="EXO 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33" />Amǝ Masar camarǝ pîtà amǝ Isǝrayila ama ɓǝà fà rǝia ɓǝà nying nzali malea. À banggia wia ama, &lt;&lt;Ɓǝ̀ wu u raka, sǝm ndo sǝm nǝ̀ wuki kat.&gt;&gt; <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />Nda amǝ Isǝrayila pwan atasau malea mǝnana à kǝ karki dyar bǝredi aɓalǝia ka, andǝ dyar bǝredi mǝnana à malaká tsǝki wi yis raka, à kària aɓalǝ alagir sǝ à gyarkia arǝ ankpamtaria. <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" />Yià amǝ Isǝrayila ka à angŋa dǝmba à pàngŋǝ̀nà gìr mǝnana Musa banggia wia ama ɓǝà pàk ka. À warina aban aɓia mǝ'murkala mǝnana amǝ Masar na ka, sǝ à zǝmǝnia wia agir-nggūrǝu andǝ agir bolo-njengǝlan andǝ azǝrfa. <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" />Yahweh tsǝa amǝ Isǝrayila kum earmúrú aban amǝ Masar, sǝ à pea wia agir mǝnana kat à zǝm ngga. Anggo sǝ amǝ Isǝrayila pwan gǝna mala amǝ Masar.<verse eid="EXO 12:36" /></para>
  <para style="s">Amǝ Isǝrayila nying Masar</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />Amǝ Isǝrayila lo gya a nggea-là Rameses aban ká nggea-là Sukkot nǝ kusǝia. Làkkì malea ka aburana á-gbǝman-tongno-nong-mwashat na [600,000], sǝ amamǝna andǝ amuna ka à ɓallia ɗàng. <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />Nggea ɓwabundǝa mǝ'làkke mala akún ɗàngɗáng, andǝ anzur, andǝ ambul-pǝndǝa, andǝ andá, o ateà gbal. <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />Amǝ Isǝrayila lurǝ agbatali dyar bǝredi mǝnana yis pà arǝì raka, mǝnana à pùr nǝi a buia a Masar ka. À lurǝ bǝredi anggo yis pà rǝì ɗàng acemǝnana nǝ mire sǝ à loasǝtea à puro à nying Masar, à kum dǝmbu mala pàk kǝ girlina ɗang she kǝ dyar bǝredi mǝno yis pà arǝì raka.<verse eid="EXO 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40" />Làkkì mala apǝlǝa mǝnana amǝ Isǝrayila pǎ aɓa nzali Masar ka, apǝlǝa gbǝman-ine nǝ lumi-tàrú na [430]. <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />Akǝ̀ dù mǝnana apǝlǝa gbǝman-ine nǝ lumi-tàrú mala do malea a Masar lùmsǝ nǝi ka, atau mala aɓwana mala Yahweh kat nying Masar. <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />Aɓa dù mǝno ka, Yahweh tsǝk mǝsǝi amur aɓwana male ace pusǝia ɓǝà purî nzali Masar. Acemani ka, mǝnia yì dù ka, nǝ̀ duk dù mana amǝ Isǝrayila kat nǝ̀ do andǝ amǝsǝia ka, ace gusǝlǝ Yahweh, sǝ à nǝ̀ ɗenyi nǝi koya pǝlǝa arǝ anza malea kat ka.<verse eid="EXO 12:42" /></para>
  <para style="s">Anzongcau ace Lamsan Yàlîmurû</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />Yahweh pè Musa andǝ Haruna amǝnia yì anzongcau ace lamsan mala Yàlîmurû ka, ama:</para>
  <para style="pi" vid="EXO 12:43">Kǝ amǝ Isǝrayila nǝmurǝia, nda à nǝ̀ lì girlina Yàlîmurû ka. Ɓwa-kúnɗàngna pa nǝ̀ lì ɗàng.<verse eid="EXO 12:43" /></para>
  <para style="pi">
    <verse number="44" style="v" sid="EXO 12:44" />Aguro ma'wun mǝnana wu kúria nǝ boalo ka, à nǝ̀ gandǝ li ɓǝà kasǝnia wia ɓatea ka.<verse eid="EXO 12:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="EXO 12:45" />Ɓwa mǝnana bǝri na, ko à twali a túró sǝ yiua do bǝti aɓalǝ wun ngga pà nǝ̀ lì ɗàng.<verse eid="EXO 12:45" /></para>
  <para style="pi">
    <verse number="46" style="v" sid="EXO 12:46" />Girlina Yàlîmurû ka à nǝ̀ lì kat a ɓala mǝnana à lambi kàm ngga; pà wun nǝ̀ twal kǝ bare nyame wun nǝ̀ kánǝí a nza ɗàng.</para>
  <para style="pi" vid="EXO 12:46">Pà wun nǝ̀ ɓun kǝ mú mala muna-nzur ko muna-mbul mǝnana à pwan-myali ace girlina Yàlîmurû ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">12:46 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 9:12">Ɓal 9:12</ref>; <ref loc="JHN 19:36">Yoh 19:36</ref></char>.</note> <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />Isǝrayila kat a ɓinalea ka dumǝna púp à nǝ̀ pàk lamsan mala Yàlîmurû.<verse eid="EXO 12:47" /></para>
  <para style="pi">
    <verse number="48" style="v" sid="EXO 12:48" />Ɓǝ̀ ɓwa ka ɓwa Isǝrayila na ɗang, sǝ ndanǝ do aɓalǝ wun, sǝ kǝ earce ama nǝ̀ pàk lamsan mala Yàlîmurû atà wun ace gusǝlǝ Yahweh ka, dumǝna púp koya ɓwabura andǝ muna-ɓwabura a ɓala male ka, à nǝ̀ kasǝia wia ɓatea; sǝ ɓǝ̀ yiu ɓǝ̀ gbàshì ban aɓwana ace pàk lamsan mala Yàlîmurû; yì ka, à nǝ̀ twali ama ɓwa mala nzali Isǝrayila na a ɓǝlban. Sǝama ɓwabura mǝnana à kasǝî wi ɓate raka, à pà nǝ̀ eari wi ɓǝ̀ lì girlina Yàlîmurû ɗang.<verse eid="EXO 12:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EXO 12:49" />Amǝnia yì anzongcau ka à nda ace aɓwana kat, koɓǝ̀ ɓwa ka à ɓǝli ɓwa Isǝrayila na, ko ɓwa-kúnɗàngna na yiu sǝ yi do aɓalǝ wun ngga.<verse eid="EXO 12:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="EXO 12:50" />Nda amǝ Isǝrayila kat ka, à okiru, à kpata gìr mǝnana Yahweh tsǝkia Musa andǝ Haruna ama ɓǝà pak ka. <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />Àkǝ̀ pwari mǝno ka, Yahweh pusǝ amǝ Isǝrayila à nying nzali Masar, koya tàu ka a nggǝsan malea a nzǝmarǝia.<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">Tàr Muna-dǝmba ace Ɓakuli</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />Yahweh banggi Musa ama, <verse eid="EXO 13:1" /><verse number="2" style="v" sid="EXO 13:2" />&lt;&lt;Koya muna-dǝmba muna-ɓwabura ka, wu tàrì ɓǝ̀ duk mem. Muna-ɓwabura mǝnana tita puro a bum ngge, ko jamna girkusǝu mǝnana tita puro a bum ngge, aɓalǝ amǝ Isǝrayila ka, memma.&gt;&gt;<verse eid="EXO 13:2" /></para>
  <para style="s">Lamsan mala bǝredi mǝnana yis pà a rǝì raka</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />Musa banggi ɓwapǝndǝa ama, &lt;&lt;Wu ɗenyinǝ pwari mǝnia ka; yì pwari mǝnana aɓalǝi sǝ wu purî Masar, yì nzali mǝnana à dumsǝ wun a guro kàm ngga. Mǝnia ka nda pwari mǝnana Yahweh pusǝ wun nǝ rǝcandǝa male mǝgule wu purî ban mǝno ka. A pwari mǝnia ka wu kǝa lì kǝ girlina mǝnana à pè nǝ yis arǝì ka ɗàng. <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />A pwari mǝnia yalung, nǝ kún ɓǝla mala mǝssa, aɓa zongŋo Abip ka, à panzǝna wun, wun ndya wu kǝ purî Masar ka. <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />Yahweh pàcau nǝ kána aban aká wun ama nǝ̀ pà wun nzali mala amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Amor, andǝ amǝ'Hivi, andǝ amǝ'Jebus, ɓǝ̀ duk nzali ma'wun. Ɓǝ̀ Yahweh yina nǝ wun aɓa mǝno yì nzali, mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga,<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:8">Pur 3:8</ref> </char>.</note> dumǝna púp wun nǝ̀ pàk lamsan mala mǝnia yì nàtà ka, aɓa zongŋo mǝnia ka, a koya pǝlǝa. <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />Wun nǝ̀ twal anongŋo tongno-nong-ɓari wun nǝ̀ li girlina mǝnana yis pà arǝì raka, sǝ a tongno-nong ɓaria pwari ka, wun nǝ̀ pàk lamsan ace gusǝlǝ Yahweh. <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />Aɓalǝ anonggio tongno-nong-ɓari mǝno ka, pà wun nǝ̀ lì kǝ bǝredi mǝnana à pè nǝ yis arǝì ka ɗàng. Yàle girlina yis ko ɓekǝ yis ka ɓǝà kǝa kumi aɓa nzali ma'wun aɓalǝ anonggio mǝno ka ɗàng.<verse eid="EXO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 13:8" />&lt;&lt;Aɓalǝ anongŋo mǝno ka wun nǝ̀ bǝ́lì amuna ma'wun ama, wu kǝ pak agir mǝnia ka ace gìr mǝnana Yahweh pè ace sǝm, mǝnana sǝm nda rǝ purì ɓá Masar ka. <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" />Mǝnia yì lamsan ngga nǝ̀ dupa wun kǝla gìr'lǝmdǝa mǝnana wun nǝ̀ kùrì a garabu wun, ko a kúndǝm wun ace kasǝɓalǝ wun ama Yahweh pusǝ aká wun à purî Masar nǝ rǝcandǝa male mǝgule. Nǝ̀ kasǝɓalǝ wun ɗǝm ace mǝnana ɓǝ̀ kanigir mala Yahweh ɓǝ̀ ueo a kún wun ngga. <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />Pakkiɗire mala mǝnia yì lamsan ngga, wun nǝ̀ nggǝ pê ɓǝ̀ pwari male kārǝ́ ka, a koya pǝlǝa.<verse eid="EXO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />&lt;&lt;Anzǝm mǝnana Yahweh yina nǝ wun, wu kutina aɓa nzali mala amǝ'Kan'ana, kǝla mǝnana kánba wun, wunǝ aká wun, sǝ pana wun nǝi ka, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" />koya muna-dǝmba muna-ɓwabura mǝnana tita puro a bum ngge ka, wun nǝ̀ tàrì ɗàng ɓǝ̀ duk mala Yahweh. Amuna-dǝmba mala agirkusǝu ma'wun mǝnana kat ajamne na ka, à nǝ̀ duk amala Yahweh. <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />Sǝama koya jamna mǝdambǝriso mǝnana nda tita puro a bum ngge ka, awu nǝ akmúrí a bu Yahweh ɓǝ̀ nyare ɓǝ̀ duk mô nǝ pâ muna-nzur a kunì. Ɓǝ̀ a pà wu nǝ akmúrí ɓǝ̀ nyare ɓǝ̀ duk mô raka, dumǝna púp awu nǝ ɓùn myali. Ɗǝm ngga dumǝna púp atà amuna mô, koya muna-ɓwabura mǝnana muna-dǝmba na ka, awu nǝ akmúrí a bu Yahweh ɓǝ̀ nyare ɓǝ̀ duk mô nǝ pǎ muna-nzur a kunì.<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 3:45-48">Ɓal 3:45-48</ref>; <ref loc="NUM 18:15-16">18:15-16</ref></char>.</note> <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />A dǝmba ka, ɓǝ̀ kǝ muna mô ɗio ama, &lt;Mana nda ɓá pàkki amǝnia yì agir ka?&gt; Awu nǝ eari wi ama, &lt;Yahweh pàktúró nǝ rǝcandǝa male mǝgule amsǝ sǝm a do guro a Masar. <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />Lang Firona murǝm Masar mgbikiru, ɓinǝe ama pà nǝ̀ nying sǝm ɓǝ̀ sǝm u raka, Yahweh wal-lú koya muna-ɓwabura mǝnana muna-dǝmba na, andǝ koya jamna girkusǝu mǝnana muna-dǝmba na ka a Masar. Nda gìr mǝnana tsǝa sǝ sǝm nggǝ pà gir'nkila nǝ girkusǝu jamne mǝnana à tita ɓǝlea ka aban Yahweh, sǝ koya muna-ɓwabura ma'sǝm mǝnana muna-dǝmba na ka, sǝm nǝ̀ akmúrí a bu Yahweh nǝ pâ muna-nzur a kunì, ace mǝnana ɓǝ̀ nyare ɓǝ̀ duk ma'sǝm ngga.&gt; &gt;&gt;<verse eid="EXO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 13:16" />Pǝlǝa Musa lidǝmba nǝ banggi aɓwana cau ama, &lt;&lt;Mǝnia yì nàtà ka nǝ̀ dupa wun kǝla gìr'lǝmdǝa mǝnana wun nǝ̀ kùrì a garabu wun andǝ kúndǝm wun ace kasǝɓalǝ wun ama Yahweh pusǝ wun a Masar nǝ rǝcandǝa male mǝgule ka.&gt;&gt;<verse eid="EXO 13:16" /></para>
  <para style="s">Amǝ Isǝrayila purî ɓá nzali Masar</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />Lang Firona murǝm Masar nyingŋǝna amǝ Isǝrayila ɓǝà u ka, Ɓakuli pǝlǝ nǝia ɓǝà kǝa kàr nǝ njargula kún nggeamùr mǝnana kútí nǝ ɓá nzali mala amǝ Filisti ka ɗàng, kat andǝ amani ama mǝno ka nda njar mǝnana kasǝ tù aban ká a nzali Kan'ana ka. Ɓakuli ɗenyi ama, &lt;&lt;Pà mǝ nǝ earce aɓwana mem nggaɗi ɓabumia ace nyar a Masar, ɓǝ̀ lwa kasǝ a kunia a njar ka ɗàng.&gt;&gt; <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />A kún mani ka, Ɓakuli gingnǝia à pǝlǝ a njar mǝnana gumbǝliban nǝ ɓá pǝɗanban kya puro a ban Nggeamùr Nzuno ka. Anggo sǝ amǝ Isǝrayila nying Masar, nǝ gilǝrǝu nǝ agirbura ace lwa.<verse eid="EXO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 13:19" />Pǝlǝa Musa twal amú lú Yisǝfu a buì, kǝla mǝnana Yisǝfu tsǝk amǝ Isǝrayila à kána ama à nǝ̀ pàk ka.<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 50:25">Tite 50:25</ref>; <ref loc="JOS 24:32">Jes 24:32</ref>; <ref loc="HEB 11:22">Ib 11:22</ref>; <ref loc="ACT 7:16">Atúró 7:16</ref></char>.</note> Yisǝfu angŋa dǝmba bangŋǝnia wia ama: &lt;&lt;Mbak-kàngkàng, Ɓakuli ka nǝ̀ yia bwala wun kàm, sǝ wun nǝ̀ twal amuem a bu wun, ɓǝ̀ wun nǝ̀ purî nzali mǝnia ka.&gt;&gt;<verse eid="EXO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 13:20" />Amǝ Isǝrayila nying Sukkot sǝ à twal gya aban ká, à yi came à tsǝk agumli malea a Etam, a nkanggari pǝɗanban.<verse eid="EXO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 13:21" />Mǝnana à purna aban o ka, Yahweh dupia wia a dǝmba aɓa pǝrɓang mǝnana cam pǝrapǝra ka nǝ pwari, ace lǝmdǝia wia njar, sǝ nǝ dú ka kútí a ɓadǝmbia aɓa lasǝ bǝsa mǝnana cam pǝrapǝra ka ace pea wia tǎlaban. Mǝnia ka tsǝa à nǝ̀ gandǝ gya, ko nǝ pwari ko du aban o. <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />Mǝnia yì pǝrɓang mǝnana cam pǝrapǝra ka ue kam a ɓadǝmba aɓwana nǝ pwari, sǝ yì lasǝ bǝsa gbal mǝnana cam pǝrapǝra ka ndakam a ɓadǝmbia nǝ du aban gya.<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">Yàlî Nggeamùr Nzuno</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />Yahweh banggi Musa ama, <verse eid="EXO 14:1" /><verse number="2" style="v" sid="EXO 14:2" />&lt;&lt;Banggi ama Isǝrayila ɓǝà pǝlǝ nǝ nzǝmia ɓǝà kya tsǝk agumli malea a ɓadǝm Pi-Hahirot, a nre Migdol andǝ Nggeamùr Nzuno, tù aban Ba'al-Zefon. <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />Firona nǝ̀ twali ama, &lt;Amǝ Isǝrayila na arǝ gāli aban sokkikunia aɓa nzali, pǝɗanban gumbǝlinia.&gt; <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />Mǝ ndo mǝ nǝ tsǝì nǝ̀ candǝmúrí, sǝ nǝ̀ lo ɓangŋatà wun, sǝ limurǝm mem amurí andǝ amǝ'lwa male ka nǝ̀ yinǝàm nǝ gulo. Anggo sǝ amǝ Masar nǝ̀ sǝlǝ ama Mǝ nda Yahweh.&gt;&gt; Anggo sǝ à pa.<verse eid="EXO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />Lang à bangŋǝ́nì Firona murǝm Masar ama amǝ Isǝrayila auna à umǝna ka, kara yì andǝ amǝtúró male nggaɗi ɓabumia arǝ amǝ Isǝrayila, sǝ à na ama, &lt;&lt;Mana nda gìr mǝnia sǝm pàk ka, mǝnana sǝm nyìngŋǝ̀nà amǝ Isǝrayila à umǝna, à pà nǝ̀ duk aguro ma'sǝm ɗǝm raka?&gt;&gt;<verse eid="EXO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 14:6" />Murǝm pǝlǝa tsǝa à yì kur apǝr arǝ waru-pǝr lwa male, sǝ tunǝ amǝ'lwa male ɓǝà do aɓa gilǝrǝu. <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />Pwan awaru-pǝr male amǝɓoarne mana làkkì malea ka, nda gbǝman tongno-nong-mwashat (600) ka, atārǝia andǝ acili awaru-pǝr mala Masar kat. Pwania kat andǝ amǝgulo-lwa aɓa koya waru-pǝr, atè. <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" />Acemǝnana Yahweh tsǝk murǝm Masar múrí candǝ ka, nda lo pyangnǝata amǝ Isǝrayila mǝnana à nyingŋǝna là à nda rǝ o nǝ mǝsǝkang-kangŋa ka. <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />Amǝ'lwa mala amǝ Masar, andǝ apǝr, andǝ awaru-pǝr mala Firona andǝ amǝ'koea ka, à ɓangŋatà amǝ Isǝrayila, à kya bwal teà a ban mǝnana à yì came à tsǝk agumli malea kàm a kún Nggeamùr Nzuno, tù aban Pi-Hahirot andǝ Ba'al-Zefon ngga.<verse eid="EXO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 14:10" />Lang Firona gbàshìnà banià ka, amǝ Isǝrayila loasǝ mǝsǝia, à sǝn Firona andǝ amǝ'lwa male aban yiu amúrià. Ɓangciu pakki amǝ Isǝrayila, sǝ à ɓua, à tunǝ Yahweh ɓǝ̀ amsǝia. <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />Pǝlǝa à ne Musa ama, &lt;&lt;Palang sǝ a yinǝ sǝm akani ɓǝ̀ sǝm yi wukio a ɓabondo? Aɓembe pà kàm a Masar mǝnana à nǝ̀ tsǝk lú sǝm kàm ngga re? Sǝn gìr mǝnana ado a pakka sǝm, nǝ pusǝ sǝm aɓa Masar ka! <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" />Mǝnana sǝm nda kano a Masar più ka, sǝm banggo ama gìr man nǝ̀ yia kum sǝm re? Sǝm no ama wu nying sǝm, ɓǝ̀ sǝm lidǝmba nǝ doguro ma'sǝm a bu amǝ Masar. Nǝ̀ ɓoaribani ɓǝ̀ sǝm duk aguro a bu amǝ Masar amur mǝnana sǝm nǝ̀ wukio a ɓabondo mǝnia ka.&gt;&gt;<verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />Sǝ Musa pǝlǝia wia ama, &lt;&lt;Cè ɓangciu pakka wun ɗàng! Wu cam kàngkàng, wun nǝ̀ sǝn gìr mǝnana Yahweh nǝ̀ pa, nǝ̀ amsǝna wun nǝi yalung ngga. Amǝ Masar mǝnia wu kǝ sǝnia ado ka, pà wun nǝ̀ nyare wun nǝ̀ sǝnia ɗǝm ɗàng. <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" />Yahweh nǝ̀ lwa-lwa ace wun. Acemani ka, wu cam più.&gt;&gt;<verse eid="EXO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />Pǝlǝa Yahweh banggi Musa ama, &lt;&lt;Palang sǝ a kǝ ɓua abanam ama mǝ bwala wun nggàm? Banggi amǝ Isǝrayila ama ɓǝà kya dǝmba. <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />Loasǝ gara mò sǝ wu lǝmdǝí amur nggeamùr. Mùr ka nǝ̀ gauwa ace mǝnana amǝ Isǝrayila ɓǝà kútí nǝ ɓá nggeamùr, ɓǝà gya amur nzali-ima. <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />Mǝ nǝ tsǝk amǝ Masar múrià nǝ̀ candǝe, sǝ à nǝ̀ soa nǝ mire aban ká atà amǝ Isǝrayila. Sǝ mǝ nǝ kumbi ɓamúràm gulo nǝ limurǝm mǝnana mǝ nǝ lì amur Firona, andǝ amǝ'lwa male, andǝ awaru-pǝr male, andǝ amǝ kok awaru-pǝr male ka. <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />Ɓǝ̀n gandǝna Firona andǝ awaru-pǝr male andǝ amǝ kok awaru-pǝr male ka, mǝ nǝ kumbi ɓamúràm gulo, sǝ acili amǝ Masar kat nǝ̀ sǝlǝ ama Mǝ nda Yahweh.&gt;&gt;<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />Mǝturonjar mala Ɓakuli mǝnana akiyidǝmba a ɓadǝmba amǝ'lwa mala amǝ Isǝrayila ka, nyar a nzǝmia; sǝ pǝrɓang mǝnana cam pǝrapǝra ka, loapi ɓadǝmbia sǝ nyare a nzǝmia. <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />Yi came a nre ka amǝ'lwa mala amǝ Masar andǝ amǝ'lwa amǝ Isǝrayila. Yì pǝrɓang ngga pè amǝ Isǝrayila tǎlaban, sǝ amǝ Masar ka túrià wia pǝndǝa, mǝnana tsǝa aɓa dù mǝno kat ka, amǝ Masar andǝ amǝ Isǝrayila ka à gandǝ sungŋo à gbàshì banarǝia ɗàng.<verse eid="EXO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 14:21" />Pǝlǝa Musa lǝmdǝ buì amur nggeamùr, kara Yahweh tasǝ gung-takuli mǝcandǝe, mǝnana ɓua dùkkù-dúkkú, ramta nggeamùr nyar nǝ te sǝ gau ɓari aɓalǝu, nying ban-ima a ban mana mùr nong kam ngga. <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" />Kara amǝ Isǝrayila gya aɓa nggeamùr a ban-ima, mùr dupia wia sheran a buia-mǝlì andǝ buia-mǝ'nggare. <figure style="fig" alt="The Israelites cross the Red Sea" file="CO00820B.TIF" size="col" loc="14:22" copy="Cook OT Images" ref="14:1-22">AmǝʻIsǝrayila yàlî Nggeamùr Nzuno</figure><verse eid="EXO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 14:23" />Sǝ amǝ Masar zùppì aban ká ateà aɓa tsùrú mala nggeamùr nǝ apǝr, andǝ awaru-pǝr mala Firona andǝ amǝ koea kat. <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />Sǝ lang ban malanǝ̀ ori ka, Yahweh dili múrí aɓa bǝsa andǝ pǝrɓang mana kǝ gya amur amǝ Isǝrayila ka, sǝn amǝ'lwa mala Masar, sǝ túrià wia múrzùrǝkya. <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />Yahweh tsǝk kusǝ awaru-pǝr malea cam kingging, sǝ mire dupia wia nǝ kwano. Kara amǝ Masar ne arǝarǝia ama, &lt;&lt;Yahweh na ban lwa-lwa ace amǝ Isǝrayila arǝ sǝm! Wu ɓangŋa ɓǝ̀ sǝm ɗeki pyangnǝata amǝ Isǝrayila!&gt;&gt;<verse eid="EXO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 14:26" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Lǝmdǝ buo ɗǝm amur nggeamùr, ace mǝnana ɓǝ̀ mùr nyare ɓǝ̀ gìr amur amǝ Masar andǝ awaru-pǝr malea, andǝ amǝ koea ka.&gt;&gt; <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />Nda Musa lǝmdǝ buì amur nggeamùr, sǝ lang ban na rǝ kwaro ka, kara mùr nyare a kusǝì a lime male. Amǝ Masar ɓariki ama à nǝ̀ ɓangŋa à nǝ̀ apî mùr mana kǝ yiu a zùppì amúrià ka, sǝ Yahweh ka tsǝa mùr yi pwania umnǝia a tsùrú mala nggeamùr. <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />Mùr nyar a kusǝi, sǝ gìr múr awaru-pǝr, andǝ amǝ koea, andǝ amǝ'lwa mala Firona mana kat à kǝ zùppì atà amǝ Isǝrayila aɓa nggeamùr ka; ko kǝɓwa aɓalǝia au ɗàng.<verse eid="EXO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 14:29" />Sǝ amǝ Isǝrayila ka, à gya a nzǝm nzali à kùtí a ɓaɓalǝu mala nggeamùr, mana dupia wia kǝla sheran a buia mǝlì andǝ mǝ'nggare ka.<verse eid="EXO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 14:30" />A pwari mǝno ka Yahweh amsǝ amǝ Isǝrayila a ɓabù amǝ Masar, sǝ amǝ Isǝrayila sǝn alú ka amǝ Masar aban nonggio a kún nggeamùr. <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />Lang amǝ Isǝrayila sǝnǝna nggea rǝcandǝa mǝgule mana Yahweh twalǝnata amǝ Masar nǝi ka, gìrnî pea wia ndali andǝ ɓangciu arǝ Yahweh. Mǝnia yì gìr ka tsǝia à earnǝ Yahweh andǝ guro male yì Musa.<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">Ɓwangsǝban aban Ɓakuli</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />Pǝlǝa Musa andǝ amǝ Isǝrayila tùkî Yahweh mǝnia yì nggyal ka, ama:</para>
  <para style="q1" vid="EXO 15:1">&lt;&lt;Mǝ nǝ tùkî Yahweh nggyal,</para>
  <para style="q2" vid="EXO 15:1">acemǝnana linamurǝm,</para>
  <para style="q2" vid="EXO 15:1">nggea limurǝm mǝgule.</para>
  <para style="q1" vid="EXO 15:1">Apǝr andǝ amǝ'koea ka,</para>
  <para style="q2" vid="EXO 15:1">kongsǝnia aɓa nggeamùr.<verse eid="EXO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EXO 15:2" />Yahweh ka nda rǝcandǝa</para>
  <para style="q2" vid="EXO 15:2">andǝ nggyal mem.</para>
  <para style="q1" vid="EXO 15:2">Yì nda ɓwa mǝnana amsǝam ngga.</para>
  <para style="q1" vid="EXO 15:2">Yì nda Ɓakuli mem,</para>
  <para style="q2" vid="EXO 15:2">mǝ nǝ ɓwangsǝki,</para>
  <para style="q1" vid="EXO 15:2">Ɓakuli mala tárrám,</para>
  <para style="q2" vid="EXO 15:2">mǝ nǝ tu-nggyal ace gulo male!<verse eid="EXO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EXO 15:3" />Yahweh ka mǝ'lwa na;</para>
  <para style="q2" vid="EXO 15:3">Yahweh nda lùllǝì.<verse eid="EXO 15:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="EXO 15:4" />&lt;&lt;Awaru-lwa andǝ amǝ'lwa mala Firona ka</para>
  <para style="q2" vid="EXO 15:4">ramnateà aɓa nggeamùr.</para>
  <para style="q1" vid="EXO 15:4">Akanggǝrang amǝ'sàrǝ̀ban mala amǝ'lwa male ka à kongsǝnia aɓa Nggeamùr Nzuno<verse eid="EXO 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EXO 15:5" />Mùr-lìma kongsǝna múrià;</para>
  <para style="q2" vid="EXO 15:5">à kò a tàmùr kǝla tali.<verse eid="EXO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EXO 15:6" />We Yahweh, buo mǝlì ka ndanǝ rǝcandǝa mǝgule.</para>
  <para style="q2" vid="EXO 15:6">Nǝ buo mǝlì, we Yahweh sǝ a arki ɓimǝbura,</para>
  <para style="q2" vid="EXO 15:6">a mesǝki mwashat-mwashat.<verse eid="EXO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EXO 15:7" />Aɓa gulo mala ɓoarɓwa mò sǝ a makki aɓwana mana à mgbicau arǝò ka.</para>
  <para style="q2" vid="EXO 15:7">A so bumlulla mò mǝ'earke,</para>
  <para style="q2" vid="EXO 15:7">pisǝia n'hāun kǝla pǐ mala lusung.<verse eid="EXO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EXO 15:8" />Aɓa bumlulla mò a loasǝ gung mǝnana tsǝk mùr yi ramgi amurǝarǝia gum-gum ngga;</para>
  <para style="q2" vid="EXO 15:8">mùr-gùla cam pǝrapǝra kǝla sheran;</para>
  <para style="q2" vid="EXO 15:8">mùr-lìma shiuri a tàban aɓa nggeamùr,<verse eid="EXO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EXO 15:9" />sǝ ɓimǝbura na ama, &lt;Mǝ nǝ pǝrtea, mǝ nǝ nggá kasǝmurià.</para>
  <para style="q2" vid="EXO 15:9">Mǝ nǝ gau gǝna malea, sǝ mǝ twal gìr mǝnana ǝn earkiyice ka;</para>
  <para style="q2" vid="EXO 15:9">mǝ nǝ kwetǝ nggeabyau mem, sǝ buam nǝ̀ twaltea.&gt;<verse eid="EXO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EXO 15:10" />We Yahweh, bumo lúllô, a tsǝk gung mò ɓua,</para>
  <para style="q2" vid="EXO 15:10">sǝ amǝ Masar ko kat a mùr;</para>
  <para style="q2" vid="EXO 15:10">à kò kǝla bolo-dànà a gbǝlwan mùr.<verse eid="EXO 15:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EXO 15:11" />Yana ɓwe kǝla we, We Yahweh, aɓalǝ aɓakuli kat?</para>
  <para style="q2" vid="EXO 15:11">Yana ɓwe kǝla we mǝnana ndanǝ ɓoarɓwa aɓa fele,</para>
  <para style="q2" vid="EXO 15:11">andǝ gulo mǝ'kàrmuruî,</para>
  <para style="q2" vid="EXO 15:11">sǝ kǝ pa ndali aɓa túró ka?<verse eid="EXO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EXO 15:12" />A loasǝ buo mǝlì</para>
  <para style="q2" vid="EXO 15:12">sǝ nzali myal aɓisǝm amǝbura.<verse eid="EXO 15:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="EXO 15:13" />&lt;&lt;Aɓa earcearǝu mô mǝnana kǝ nggaɗi raka,</para>
  <para style="q2" vid="EXO 15:13">a gingnǝ aɓwana mô mǝnana a amsǝia ka.</para>
  <para style="q1" vid="EXO 15:13">Aɓa rǝcandǝa mò, a kàrnǝia</para>
  <para style="q2" vid="EXO 15:13">aban ká nzali mô mǝfele.<verse eid="EXO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EXO 15:14" />Anzali ɓanza okce gìr man,</para>
  <para style="q2" vid="EXO 15:14">sǝ rǝia ɓǝl nǝ ɓangciu.</para>
  <para style="q1" vid="EXO 15:14">Aɓwana mǝnana à do a nzali Filisti ka,</para>
  <para style="q2" vid="EXO 15:14">ǝn'ò bwalia.<verse eid="EXO 15:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="EXO 15:15" />Amurǝma mala nzali Edom ngga,</para>
  <para style="q2" vid="EXO 15:15">à gǝggǝli.</para>
  <para style="q1" vid="EXO 15:15">Akanggǝrang aburana mala nzali Mowap ka,</para>
  <para style="q2" vid="EXO 15:15">ɓabumia tù mùr.</para>
  <para style="q1" vid="EXO 15:15">Amǝ Kan'ana ka yilǝmia o ace ɓangciu;<verse eid="EXO 15:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="EXO 15:16" />ǝn'ò andǝ ɓamúrkàra sulǝ amuria.</para>
  <para style="q2" vid="EXO 15:16">À sǝn rǝcandǝa mò, we Yahweh</para>
  <para style="q2" vid="EXO 15:16">sǝ à cam yak nǝ ɓangciu,</para>
  <para style="q2" vid="EXO 15:16">sheɓǝ̀ aɓwana mô gingŋǝ́na à yi kutina ka,</para>
  <para style="q3" vid="EXO 15:16">yì aɓwana mô mǝnana a akmúria à purî do guro ka.<verse eid="EXO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="EXO 15:17" />Awu nǝ yinǝia, sǝ awu nǝ dumsǝia amur nkono mǝnana girkuma mò na ka,</para>
  <para style="q2" vid="EXO 15:17">yì ban mǝnana we Yahweh,</para>
  <para style="q2" vid="EXO 15:17">a tárì ɓǝ̀ do nda bando mô ka,</para>
  <para style="q2" vid="EXO 15:17">yì Tara-mǝfele mǝnana we nǝ nggearǝo a loasǝi ka.<verse eid="EXO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="EXO 15:18" />We Yahweh a nda murǝm,</para>
  <para style="q2" vid="EXO 15:18">málá male pà kàm ɗàng.&gt;&gt;<verse eid="EXO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />Amǝ Isǝrayila gya à kùtí nǝ ɓá nggeamùr amur nzali mǝ'ime. Sǝ lang awaru-pǝr andǝ apǝr mala amǝ Masar andǝ amǝ'koea kùtí aɓa nggeamùr ka, Yahweh nyesǝ mùr nǝ te yi kongsǝ múrià. <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" />Miriyam māɓangnǝa, muna-ɓwama mǝ'eam Haruna, twal karata-bu male sǝ puro a dǝmba sǝ amamǝna kat kpate à kǝ wal akarata-bu malea nǝ ta'nggwam. <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />Miriyam loasǝia wia nggyal ama:</para>
  <para style="q1" vid="EXO 15:21">&lt;&lt;Wu tùkî Yahweh nggyal ɓwangsǝban,</para>
  <para style="q2" vid="EXO 15:21">ace limurǝm male mǝgule!</para>
  <para style="q1" vid="EXO 15:21">Apǝr andǝ amǝ'koea ka,</para>
  <para style="q2" vid="EXO 15:21">túrnia aɓa nggeamùr.&gt;&gt;<verse eid="EXO 15:21" /></para>
  <para style="s">Mùr mǝ'lùlle pǝlǝ mǝɓoarne</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />Amǝ Isǝrayila loapi ban Nggeamùr Nzuno sǝ Musa gingnǝia aban o aɓa Pǝɗanban Shur. À gya nongŋo tàrú aɓa pǝɗanban sǝ ko à kum kǝ mùr ɗàng. <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />Pǝlǝa à yì bik ɓè ban gaɓakan à tunǝi ama Mara, sǝ mùr mǝnana a banì ka lúllô à gandǝ nue ɗàng. Nda gìr mǝnana tsǝa sǝ à tunǝi ama Mara<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fq" closed="false">Mara </char><char style="ft" closed="false">nǝ kún Ibǝru ka ɓālǝi nda </char><char style="fq" closed="false">lúllô</char><char style="ft" closed="false">.</char></note> ka. <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />Aɓwana nggwanî Musa ama, &lt;&lt;Mana ado sǝm nǝ̀ nu?&gt;&gt; <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />Nda Musa ɓua aban Yahweh ɓǝ̀ bwalì wi kàm. Yahweh lǝmdǝì wi ɓè gbǝlang nggun, sǝ Musa twali túrí aɓa mùrnî; sǝ mùrnî pǝlǝ mǝɓoarne, à nǝ̀ gandǝ nuî.</para>
  <para style="p" vid="EXO 15:25">Akanó a Mara sǝ Yahweh pea aɓwana male aɓea nggurcau andǝ akanìgìr mǝnana à nǝ̀ gingnǝ do malea ka; akanó gbal sǝ mwamia. <verse eid="EXO 15:25" /><verse number="26" style="v" sid="EXO 15:26" />Bang ama, &lt;&lt;Ɓǝ̀ wun nǝ̀ kpata cau mala Yahweh Ɓakuli ma'wun nǝ̀ ɓabum wun kat, sǝ wun nǝ̀ pàk gìr mǝnana nda pepè a sǝne male, sǝ wun nǝ̀ kwakikir wun arǝ anzongcau male, sǝ wun nǝ̀ bwal anggurcau male kat ka, akwánó mǝnana kat ǝn yinǝia amur amǝ Masar ka, pà mǝ nǝ yinǝia amur wun ɗàng, acemǝnana Mim, Yahweh ka, Mǝ nda mǝ'twalban akwánó ma'wun.&gt;&gt;<verse eid="EXO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 15:27" />Anzǝm mǝnana à nyìngŋǝ̀nà Mara ka, amǝ Isǝrayila gya à yi bik gaɓakan Elim, ban mǝnana à kum amáɗí-mùr lum-nong-ɓari andǝ anggun nkangga lumi-tongno-nong-ɓari (70) ka; à came à tsǝk agumli malea kàm.<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">Ɓakuli pea aɓwana male girlina a ɓabondo</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />Amǝ Isǝrayila a ɓinalea kat ka à nying Elim, sǝ à gya à kya puro aɓa pǝɗanban mala Sin, mǝnana nda a nre Elim andǝ Saina ka. À kya bwal banì a lum-nong-tongnoia pwari mala ɓaria zongŋo mana à nyìngŋǝ̀nà nzali Masar nǝi ka. <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />Akanó aɓa pǝɗanban ngga, amǝ Isǝrayila a ɓinalea kat ka, à nggwanî Musa andǝ Haruna ɗǝm. <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" />À nea wia ama, &lt;&lt;Ɓǝà bang ama Yahweh walna-lú sǝm aɓa nzali Masar ka ɓǝ́ ɓoarna. Acemǝnana akanó ka, sǝm nǝ̀ gandǝ dumnǝdo, sǝm nǝ̀ shak nyama andǝ acili agirlina kǝla mana sǝm earce ka. Sǝ adyan ngga, wu yinanǝ sǝm aɓa pǝɗanban mǝnia ace wal-lú sǝm a ɓinala sǝm kat nǝ nzala.&gt;&gt;<verse eid="EXO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 16:4" />Yahweh banggi Musa ama, &lt;&lt;Ado ka, mǝ ndo mǝ nǝ soapa wun girlina nǝ kuli kǝla nya mala mbulo. Banggi aɓwana ɓǝà puro a koya pwari ka ɓǝà kya ram gìr mǝnana nǝ̀ kārǝia mala pwari mwashat ka. Anggo sǝ mǝ nǝ sǝlǝa ko yia ka à nǝ̀ kpata kwarkiru mem. <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />A tongno-nong-mwashatia pwari mala koya limo ka, wun nǝ̀ ram gìr mǝnana wu kǝ ram pwari-pwari ka kusǝ ɓari.&gt;&gt;<verse eid="EXO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 16:6" />Nda Musa andǝ Haruna banggi amǝ Isǝrayila kat ama, &lt;&lt;A pwarikpǝra mala pwari man yalung ngga, wun nǝ̀ sǝlǝ ama Yahweh na pusǝ wun wu purî ɓá nzali Masar ka. <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />Nǝ́ dǝmbari ka wun nǝ̀ sǝn gulo mala Yahweh nǝ̀ pusǝrǝi nǝ tǎlaban. Yì ka ongŋǝna nggwani mǝnana wu kǝ nggwanî wi ka, sǝm nda wu nggwania sǝm ngga ɗàng. Sǝm nda ka yana gbal mǝnana wun nǝ̀ nggwania sǝm ngga?&gt;&gt; <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" />Musa banggia wia ɗǝm ama, &lt;&lt;Yahweh nǝ̀ pà wun nyama mǝnana wun nǝ̀ li nǝ pwarikpǝra ka, ɗǝm ngga nǝ̀ pà wun girlina mǝnana nǝ̀ kārǝ́ wun ngga nǝ dǝmbari, acemǝnana ongŋǝna nggwani ma'wun mǝnana wu nggwanî wi ka. Sǝ sǝm ngga sǝm nda ka yana? Nggwani ma'wun ngga pà arǝ sǝm ɗàng, nda arǝ Yahweh.&gt;&gt;<verse eid="EXO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 16:9" />Musa banggi Haruna ama, &lt;&lt;Banggi amǝ Isǝrayila a ɓinalea kat ama, &lt;Wu yiu wu yi came a ɓadǝm Yahweh, acemǝnana ongŋǝna nggwani ma'wun.&gt; &gt;&gt; <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />Sǝ lang Haruna naban nacau nǝ ɓinala amǝ Isǝrayila kat ka, à pǝlǝ mǝsǝia nǝban pǝɗanban, kara à sǝn tǎlaban mǝnana kǝ twalmǝsǝu ka, mala Yahweh, puro aɓa pǝrɓang.<verse eid="EXO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 16:11" />Pǝlǝa Yahweh ne Musa cau ama, <verse eid="EXO 16:11" /><verse number="12" style="v" sid="EXO 16:12" />&lt;&lt;Ən ongŋǝna nggwani mala amǝ Isǝrayila; ado ka, banggia wia ama, &lt;Koya pwarikpǝra ka, wun nǝ̀ kum nyama wun nǝ̀ she, sǝ koya dǝmbari ka, wun nǝ kum girlina mana nǝ̀ ɗǝmsǝ wun ngga. Anggo sǝ wun nǝ̀ sǝlǝa ama Mǝ nda Yahweh, Ɓakuli ma'wun.&gt; &gt;&gt;<verse eid="EXO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 16:13" />Nǝ́ pwarikpǝra mǝno ka, ankwar mǝ'làkke kǝ̀rkǝ́r yiu à yi sulǝo à lùmsǝ ɓá kàttì mala amǝ Isǝrayila. Sǝ nǝ dǝmbari ka, ɓá kàttì liuwe nǝ ncimna mana kpa ka. <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />Anzǝm mana ncimna imǝna ka, kara à sǝn agir kǝla a'imna nggwato-ɓa'nkwaring, mǝnana ɓoarsǝna kǝla talimbulo ka, à yi lumsǝ nzǝm-nzali. <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" />Lang amǝ Isǝrayila nǝ̀ sǝni ka, à ɗiki rǝarǝia ama, &lt;&lt;Mana man?&gt;&gt; Acemǝnana à súrǝ̀ mana nda mǝno yì gìr ka ɗàng.</para>
  <para style="p" vid="EXO 16:15">Pǝlǝa Musa nea wia ama, &lt;&lt;Mǝnia ka nda girlina mǝnana Yahweh pa wun ɓǝ̀ wu lì ka. <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />Mǝnia ka nda nzongcau mala Yahweh aban wun: &lt;Koyan atà wun ngga ɓǝ̀ ram gìr mǝnana nǝ̀ gandǝ lié ka, munakwar-karǝgìr ɓari ace koya ɓwa a ɓala male.&gt; &gt;&gt;<verse eid="EXO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 16:17" />Amǝ Isǝrayila pàk mǝno ka anggo; aɓea aɓwana pwan kpǝm, sǝ aɓea ka à pwan bǝti. <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" />Sǝ lang à yi kārǝki ka, aɓwana mǝnana à pwan kpǝm ngga malea woribani ɗàng, sǝ aɓwana mǝnana à pwan bǝti ka malea shingnǝ ɗang. Koyan ngga kum gìr mǝnana kārǝ́ arǝì sǝ nǝ̀ gandǝ li ka. <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />Musa banggia wia ama, &lt;&lt;Kǝ ɓwa ɓǝ̀ kǝa tsǝk cili ɓǝ̀ nongŋo bankwari ɗàng.&gt;&gt; <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />Sǝ aɓea ɓwana ka à mgbikî Musa kiru, à tsǝk cili nongŋo. Lang bankwarna ka, à yi kumi ka sàngŋǝ̀nà mǝsǝ'nggwaso sǝ rǝmbi mǝɓike kǝ puro. Bum Musa lúllô arǝia. <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />Koya dǝmbari ka koyan ngga pwan gìr mǝnana nǝ̀ kārǝi ka; sǝ ɓǝ̀ pwari pì ka, gìr mǝnana ueo a nzali ka panzǝa.<verse eid="EXO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 16:22" />Nǝ́ dǝmbari mala tongno-nong-mwashatia pwari ka, à pwan girlina mǝnana à nǝ̀ li aɓa pwari ɓari ka; koya ɓwa ka pwan munakwar-karǝgìr ine. Aɓwana-mǝgule amur ɓinala aɓwana wario à kya banggi Musa cê, <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" />sǝ banggia wia ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh na ka: &lt;Lí ka, pwari mala usǝlǝo na, pwari mǝfele mǝnana à tàrì ace pagulo abanam Mim Yahweh ka nda. Acemani ka, gìr mǝnana kat wu earce lurǝè ka, wu lurǝi yalung; gìr mǝnana kat wu earce lambe ka, wu lambi yalung, sǝ wu tsǝk cili girlina mǝnana nǝ̀ kārǝ́ wun lí ka.&gt; &gt;&gt;<verse eid="EXO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 16:24" />Aɓwana okiru à kpate kǝla mǝnana Musa bang ngga; à tsǝk cili girlina mǝnana ue ka bà ɓè dǝmbari; kiɗiki ɗàng sǝ sak nggwaso ɗàng. <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />Musa na ama, &lt;&lt;Wu lì girlina mǝnia ka yalung, acemǝnana yalung nda pwari Sabbat, pwari usǝlǝo mǝnana à tàrì ace Yahweh ka; kǝ girlina pa kàm wun nǝ̀ kúmô wun nǝ̀ pwano a nzali yalung ɗàng. <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />Girlina ka, wun nǝ̀ kumi a nzali wun nǝ̀ pwano aɓa nongŋo tongno-nong-mwashat. Sǝ tongno-nong-ɓaria pwari ka, pwari Sabbat na. Pà wun nǝ̀ kum kǝ girlina a nzali a pwari mǝno ka ɗàng.&gt;&gt;<verse eid="EXO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 16:27" />Aɓea aɓwana puro a tongno-nong-ɓaria pwari à nǝ̀ nggá pwan girlina, sǝ lang à wari ka, à kya kum kǝgìr ɗàng. <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />Pǝlǝa Yahweh ɗì Musa ama, &lt;&lt;Nǝ̀ sau lang sǝ aɓwana mǝnia nǝ̀ ɓinǝ kpata anzongcau andǝ akwarkiru mem? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />Wu sǝni! Mim Yahweh ka, mǝ nda ǝn pa wun Sabbat, yì pwari usǝlǝo ka. Nda gìr mǝnana tsǝa sǝ a tongno-nong-mwashatia pwari ka, ǝn pa wun girlina mǝnana nǝ̀ kārǝ́ wun mala nongŋo ɓari ka. Koyan ngga ɓǝ̀ do a ɓala ɓǝ̀ usǝlǝo, kǝ ɓwa ɓǝ̀kǝa na ama nǝ̀ purî ɓala male a pwari Sabbat ɗàng.&gt;&gt; <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />Nda aɓwana usǝlǝo, à pàk kǝ túró a pwari Sabbat raka.<verse eid="EXO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 16:31" />Amǝ Isǝrayila tunǝ girline ama Manna.<note caller="+" style="f"><char style="fr" closed="false">16:31</char><char style="fk" closed="false">Manna </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda mwashat andǝ ɗiban nǝ kún la sǝm ama, &lt;&lt;Mana; ko Mana wo, ko Mana man?&gt;&gt;</char></note> Pwasǝo sǝ nda kǝla kyak mǝlapati mǝnana a pè nǝ mǝsǝ mbulara ɓa-mbyau ka, sǝ a lasǝu ka, nda pǝlpǝl kǝla mùr-nyì. <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />Musa na ama, &lt;&lt;Mǝnia ka, nda cau mǝnana Yahweh ɓang ngga: &lt;Wu ɗàrǝ́ munakwar-karǝgìr ɓari mala girlina Manna sǝ ɓǝà tsǝì ace anza mala aɓwana mǝnana à nǝ̀ yiu ka, ace mǝnana ɓǝà sǝn girlina, mǝnana ǝn linǝ wun nǝi a ɓabondo, lang ǝn pusǝ wun wu purî ɓá nzali Masar ka.&gt; &gt;&gt; <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" />Musa banggi Haruna ama, &lt;&lt;Twal muna-nkwaring, tsǝk munakwar-karǝgìr ɓari mala girlina Manna aɓalǝi, sǝ kya tamsǝi a ɓadǝm Yahweh aɓa ban mǝfele ace anza mǝnana à kǝ yiu ka ɓǝà sǝni.&gt;&gt; <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />Kǝla mǝnana Yahweh banggi Musa ka, Haruna tsǝk muna-nkwaring nǝ girlina Manna aɓalǝi, a ɓadǝm Acau-nakûn,<note caller="+" style="f"><char style="fr" closed="false">16:34 </char><char style="fq" closed="false">Acau-nakûn </char><char style="ft" closed="false">ngga à nda ka akpamgbǝlang tali ɓari mǝnana à gilǝ anzongcau mala kùrcau amúrià ka. Amǝnia yì akpamgbǝlang tali ɓari, mǝnana à nda aɓa Akwati Kùrcau ka, à tunǝia ama Acau-nakûn; à nda ka acau-nakûn mala kùrcau mǝnana à gilǝia ka, yì acau mala kùrcau a nre Ɓakuli andǝ aɓwana male.</char></note> yì Akwati Kùrcau ace mǝnana ɓè kǝgìr ɓǝ̀ kǝa kúmsǝí raka. <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" />Aɓalǝ apǝlǝa lumi-ine mǝnana à yi kútí ka, Manna nda girlina mǝnana amǝ Isǝrayila lì ka bà yiu malea a nzong-nzali mala nzali Kan'ana, ban mǝnana aɓwana duk kam ngga.<verse eid="EXO 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 16:36" />Tasau mǝnana à kǝ kārǝki Manna aɓalǝi ka nda oma ko lita lumi-ɓari.<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">Yahweh pusǝ mùr aɓa tali</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />Amǝ Isǝrayila a ɓinalea kat nying pǝɗanban mala Sin, à lo gya malea bǝti-bǝti, à nǝ̀ sulǝo a kàttì man sǝ à nǝ̀ tùr a ɓè, kǝla mǝnana Yahweh banggia wia ka. À kya sulǝo a Rifidim, sǝ banì ka mùr-nùná pa kàm ɗàng. <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" />Nda à tita nggwanî Musa, aban ne wi ama: &lt;&lt;Pà sǝm mùr sǝm nǝ̀ nú!&gt;&gt;</para>
  <para style="p" vid="EXO 17:2">Musa pea wia eare ama, &lt;&lt;Mana tsǝa sǝ wu kǝ nggwaniàm? Mana tsǝa sǝ wu kǝ mwam Yahweh?&gt;&gt;<verse eid="EXO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 17:3" />Aɓwana ka mǝsamùr wallia kǝ̀rkǝ́r, osso à lidǝmba nǝ nggwanì Musa. À kǝ bang ama, &lt;&lt;Ace mana sǝ a pusǝ sǝm aɓa Masar? A pusǝ sǝm ace mǝnana awu nǝ yia wal-lú sǝm nǝ mǝsamùr, sǝnǝ amuna sǝm andǝ agirkusǝu ma'sǝm le?&gt;&gt;<verse eid="EXO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 17:4" />Pǝlǝa Musa ɓua aban Yahweh, bang ama, &lt;&lt;Mana mǝ nǝ pang nǝ aɓwana man? Pà nǝ̀ sau ɗang à ndo à nǝ̀ kùtí a ɓukkiam nǝ atali ka.&gt;&gt;<verse eid="EXO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 17:5" />Yahweh pǝlǝa ne Musa ama, &lt;&lt;Twal aɓea aɓwana-mǝgule mala amǝ Isǝrayila atò, sǝ wu aki aɓwana dǝmba. Twal gara mana a walǝna mùr Nggeasala Nayel nǝi ka a buo, sǝ wù kyane. <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />Wun nǝ̀ yia kumam aban kundǝ wun akanó a ban ɓe tali amur Nkono Saina, a Horep.<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">Nkono Saina ka nda aɓalǝ ankono Horep.</char></note> Wal mǝno yì tali ka nǝ gara, mùr nǝ̀ pur aɓalǝi, mǝnana aɓwana nǝ̀ nu ka.&gt;&gt; Anggo sǝ Musa pa a ɓadǝmbǝ aɓwana-mǝgule mala amǝ Isǝrayila.<verse eid="EXO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 17:7" />Musa pè ban mǝno lullǝu ama Massa sǝ Meriba,<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">Massa sǝ Meriba: </char><char style="ft" closed="false">Lullǝu mǝnia nǝ kún Ibǝru ka ɓālǝi nda &lt;&lt;mwamban andǝ nggwani.&gt;&gt;</char></note> acemǝnana amǝ Isǝrayila nggwani sǝ à mwam Yahweh nǝ ɗiban ama, &lt;&lt;Mbak-kàngkàng Yahweh na aɓalǝ sǝm le?&gt;&gt;<verse eid="EXO 17:7" /></para>
  <para style="s">Amǝ Isǝrayila gandǝ amǝ Amalek nǝ lwa</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />Amǝ'amalek yiu nǝ lwa arǝ amǝ Isǝrayila a Rifidim. <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />Nda Musa banggi Jesǝwa ama, &lt;&lt;Tarki aɓea aburana ɓǝà puro sǝ ɓǝà oa munǝo arǝ amǝ Amalek. Lí ka mǝ nǝ nggá came a ɓong nkono nǝ gara mala Ɓakuli a buam.&gt;&gt;<verse eid="EXO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 17:10" />Jesǝwa pa kǝla mǝnana Musa banggi wi ka, pur nǝ amǝ'lwa sǝ à o à kya je munǝo arǝ amǝ'Amalek, sǝ Musa andǝ Haruna andǝ Hur ka à eauwe à kya came a ɓong nkono. <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" />Lang Musa loasǝ abui a kùli ka, bù amǝ Isǝrayila kǝ twalki arǝ amǝ'Amalek a munǝo, sǝ lang sulǝ abui a nzali ka, bù amǝ Amalek kǝ twalki arǝ amǝ Isǝrayila. <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />Lang banì sau ka, abú Musa aulǝa aban loasǝe a kùli. Nda Haruna andǝ Hur twal tali, à tsǝki wi aɓate ɓǝ̀ do amurí, sǝ yià ka à came arǝ ankanggari sǝ à mbali abui a kuli; anggo sǝ abuí cam kàngkàng bà kpa mala pwari. <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />Anggo sǝ Jesǝwa andǝ amǝ'lwa male gandǝ amǝ Amalek nǝ nggeabyau.<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />Anzǝm mǝno yì limurǝm ngga, Yahweh banggi Musa ama, &lt;&lt;Gilǝ cau mala limurǝm mǝnia ka a malǝmce ace mǝnana ɓǝ̀ duk gir tsǝa a ɗenyicau koya pwari, sǝ wu ɓalli ɓǝ̀ Jesǝwa oè ɓǝ̀ sǝlǝ ama mǝ nǝ twalta amǝ'Amalek, aɓwana pà nǝ̀ sǝlǝ cau malea a ɓanza ɗǝm ɗàng.&gt;&gt;<verse eid="EXO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 17:15" />Pǝlǝa Musa ɓak gyangŋan sǝ tsǝki wi lullǝu ama Yahweh-Nissi.<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">Yahweh-Nissi </char><char style="ft" closed="false">ka ɓālǝi ka nda &lt;&lt;Mǝtalabangŋo ka nda tútà mana à nǝ̀ súrǝ̀ sǝm nǝi ka.&gt;&gt;</char></note> <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />Bang ama, &lt;&lt;Ən loasǝ tútà mala Yahweh a kùli. Acemani ka, arǝ anza mǝnana à kǝ yiu ka, Yahweh nǝ̀ lwa-lwa arǝ amǝ'Amalek bà masǝlǝate.&gt;&gt;<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">Jetǝro yiua sǝn Musa</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />Jetǝro,<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="fq" closed="false">Jetǝro </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 2:16-21">Pur 2:16-21</ref>; <ref loc="EXO 3:1">3:1</ref>,<ref loc="EXO 3:18">18</ref>; <ref loc="EXO 18:1-12">18:1-12</ref>; <ref loc="NUM 10:29">Ɓal 10:29</ref> </char>.</note> nkil Musa mǝɓwabure, pǝris mala amǝ Midiyan ok cau mala agir mǝnana kat Ɓakuli pakki Musa andǝ amǝ Isǝrayila, andǝ pusǝó mǝnana pùsǝiá à purî ɓá nzali Masar ka. <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />Nda lo yiu aban Musa ka. Musa ka akdǝmba tasǝna māmí andǝ amuni ɓari ɓǝà kya aban Jetǝro, sǝ yì Jetǝro ka ea à do a baní. Lang yiu ka, yiu atārǝia andǝ mālá Musa, yì Zipora,<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="fq" closed="false">Zipora </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 2:21-22">Pur 2:21-22</ref>; <ref loc="EXO 4:20">4:20</ref>,<ref loc="EXO 4:24-25">24-25</ref> </char>.</note> <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" />andǝ amuna-burana mala Musa ɓari. À ɓǝlî Musa amuna-burana mǝnia ɓari ka a bàkú mǝnana yì ka bǝri na peatu a nzali Midiyan ngga. Acemani ka, tsǝkî muna-dǝmba male lùllǝú ama Gashom.<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="fq" closed="false">Gashom </char><char style="ft" closed="false">nǝ kún Ibǝru ka ɓālǝi nda &lt;&lt;bǝri kano.&gt;&gt;</char></note> <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />Lang à ɓǝlî wi ɓaria muni ka, tsǝki wi lùllǝú ama Eliyeza,<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="fq" closed="false">Eliyeza </char><char style="ft" closed="false">nǝ kún Ibǝru ka ɓālǝi nda &lt;&lt;Ɓakuli nda mǝ'bwalàm nggam.&gt;&gt;</char></note> acemǝnana bang ama, &lt;&lt;Ɓakuli mana akâ peri a baní ka, bwalam nggam sǝ amsǝam a bu Firona, murǝm Masar, mǝnana ɓǝ́ walna-luem ngga.&gt;&gt;<verse eid="EXO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 18:5" />Yì Jetǝro, nkil Musa, atārǝia andǝ mālá Musa andǝ amuna-burana mala Musa ka, à yiu a ɓabondo aban Musa, a ban mǝnana Musa andǝ amǝ Isǝrayila tsǝk là-gumli kàm, tù aban Nkono mala Ɓakuli ka. <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />Kaniama Jetǝro nǝ̀ yiu ka, akdǝmba tasǝî Musa cau ɓǝà banggi wi ama, &lt;&lt;Mim, Jetǝro nkilo, mǝ ndya ǝn nggǝ ká a bano atarǝ sǝm sǝnǝ māmó andǝ amunio amuna-burana ɓari ka.&gt;&gt;<verse eid="EXO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 18:7" />Lang à yi bingŋǝna ka, Musa puro yi ɓunno a ɓadǝm Jetǝro sǝ kùrì zǝp, gingsǝi. Pǝlǝa Musa kútí nǝ Jetǝro aɓa gumli male. <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />Musa twal cau banggi wi koman kat mala gìr mǝnana Yahweh pangnǝ Firona, Murǝm andǝ amǝ Masar ace amsǝ amǝ Isǝrayila ka. Ɗǝm ngga banggi wi cau mala tanni mǝnana yiu amuria a njar aban yiu, andǝ amsǝa mǝnana Yahweh amsǝ aɓwana male aɓalǝ atanni malea ka. <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />Lang Jetǝro ok acau mǝnia ka, banɓoari wi ace agir mǝɓoarne mǝnana Yahweh pea ace amǝ Isǝrayila, nǝ amsǝa mana amsǝia a bu amǝ Masar ka. <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />Sǝ bang ama, &lt;&lt;Ɓwangsǝban ɓǝ̀ pa aban Yahweh mǝnana amsǝ wun a bù Firona Murǝm sǝ a bù amǝ Masar ka! Ɓǝà ɓwangsǝ Yahweh mǝnana amsǝ aɓwana male aɓata parban mala amǝ Masar ka! <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />Adyan ngga ǝn sǝlǝna ama Yahweh ka, nda Ɓakuli mana kàrmúr aɓakuli kat ka, acemǝnana amsǝ aɓwana male a ɓata parban mala amǝ Masar, amǝ twàlɓamúruì.&gt;&gt; <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />Pǝlǝa Jetǝro, nkil Musa yinǝ ɓoro mala pisǝe kǝring, andǝ agir shawuɗiban, ace pàgir aban Ɓakuli; sǝ Haruna andǝ aɓwana-mǝgule kat mala Isǝrayila yiu à yi li girlina atārǝia andǝ Jetǝro akanó a ɓadǝm Ɓakuli.<verse eid="EXO 18:12" /></para>
  <para style="s">À twal amǝ'ɓashi</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />Ban fana ka, Musa puro yi do a ban ɓashì aɓwana. Aɓwana yi ramba à kàrì Musa aɓalǝu twal a dǝmbari aban ká kpa mala pwari. <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />Lang Jetǝro, nkil Musa sǝn gìr mǝnana kat Musa kǝ pè ace aɓwana ka, ɗì ama, &lt;&lt;Mana mǝnia a kǝ pê ace aɓwana ani ka? Palang sǝ a dum nǝmurǝo [aban pak ɓashi], sǝ aɓwana kat came à kàrio aɓalǝu twal a dǝmbari aban ká kpa mala pwari?&gt;&gt;<verse eid="EXO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 18:15" />Musa eari wi ama, &lt;&lt;Nda acemǝnana aɓwana kǝ yiu abanam ace ɗìbancau aban Ɓakuli ka. <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />Pwari mǝnana kat kúnɓuàna lo a nre aɓwana ɓari ka, à kǝ yiu abanam, sǝ mǝ nǝ kasǝ-ɓashi amur yana ateà ndanǝ mǝsǝcau, sǝ mǝ nǝ kania wia anzongcau andǝ anggurcau mala Ɓakuli.&gt;&gt;<verse eid="EXO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 18:17" />Pǝlǝa Jetǝro, nkil Musa banggi wi ama, &lt;&lt;Pě mana anggo ka ɓoar ɗàng. <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" />We wunǝ aɓwana mǝnana à kǝ yiu a bano ka, banì pà nǝ̀ sau ɗang wun nǝ̀ yauwí. Túró mǝnia ka ɓiki gulò; a pà nǝ gandǝ pe nǝmurǝo ɗàng. <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />Kwakikiro arǝàm sǝ mǝ nǝ po aɓea cau kwarkiru, sǝ Ɓakuli ka nǝ̀ pà atò. Awu nǝ do mǝ'came a nre ka aɓwana andǝ Ɓakuli, ace yinǝ acau mala akúnɓuàna malea a baní. <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />Awu nǝ kània wia anê andǝ anggurcau mala Ɓakuli, wu bǝlia wia lang sǝ do malea ɓoaro ɓǝ̀ pa, andǝ gir mǝnana à nǝ̀ pàk ka. <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />Tsǝa amur mǝno ka, ɓoaro wu tàrki aɓwana mǝnana mǝsǝia kàngkàng, amǝ ɓanggî Ɓakuli, aɓwana mǝnana à nǝ̀ earnǝia, sǝ à nda ka amǝ ɓinǝce ak pàbunǝnzali ka. Tsǝia ɓǝà duk aɓwana-mǝgule amur aɓwana: amǝ'yálmúr aɓwana á, amǝ'yálmúr aɓwana gbǝman, amǝ'yálmúr aɓwana lumi-tongno, sǝ amǝ'yálmúr aɓwana lum. <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />Tsǝia ɓǝà do à nda ka amǝ'ɓashi koya pwari amur aɓwana. Ɓǝ̀ ɓekǝ cau mǝkwane nakam mǝnana gandǝia ka, nda à nǝ̀ yinǝi a bano ka, sǝama koya cau mana kwan raka, à nǝ̀ gilǝki nǝ nggearǝia. Anggo ka agir pà nǝ̀ kwanbo ɗàng, acemǝnana yìa mǝno ka, à nǝ̀ amsǝô dǝmbǝrya mala túrô. <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />Ɓǝ̀ a kpata kwarkiru mǝnia, sǝ ɓǝ̀ Ɓakuli tsǝko wi ama wu pê anggo ka, awu nǝ gandǝ twal gandǝa nǝ acau, sǝ aɓwana mǝnia kat ka, à nǝ̀ nyar a ɓala aɓa rǝpwala.&gt;&gt;<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />Musa kpata kwarkiru mala nkili, sǝ pàk gìr mǝnana kat banggi wi ka; <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />tàrki aɓwana mǝnana mǝsǝia kàngkàng ngga aɓalǝ amǝ Isǝrayila kat sǝ tsǝia à duk aɓwana-mǝgule amur aɓwana: amǝ'yálmúr aɓwana á, amǝ'yálmúr aɓwana gbǝman, amǝ'yálmúr aɓwana lumi-tongno, sǝ amǝ'yálmúr aɓwana lum. <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />À duk amǝ'ɓashi amur aɓwana a koya pwari. Ɓǝ̀ ɓekǝ cau mǝkwane yiu mǝnana gandǝia ka, à wari nǝi a baní. Acili acau mǝkèke ka, à sǝngi ɓālǝia nǝ nggearǝia.<verse eid="EXO 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 18:27" />Bǝti anzǝm mǝno ka, pwari o mala Jetǝro nkil Musa yi pa, pǝlǝa Musa tsǝiandà, sǝ bwal njar nyare o a nzali male.<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">Amǝ Isǝrayila yiu a Nkono Saina</para>
  <para style="m">
    <verse number="1" style="v" sid="EXO 19:1" />A pwari mǝdǝmbe mala tàruià zongŋo anzǝm mǝnana amǝ Isǝrayila purnǝì ɓá nzali Masar ka, à yì bik pǝɗanban mala Saina aɓa mǝno yì pwari ka. <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />Lang à loapi Rifidim ngga à twal gya sǝ à yi bik pǝɗanban mala Saina. Akanó ka amǝ Isǝrayila tsǝk là-gumli malea a kusǝ Nkono Saina.<verse eid="EXO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 19:3" />Pǝlǝa Musa eau amur nkono aban Ɓakuli, sǝ Yahweh tunǝi nǝ múr nkono, ne wi ama, &lt;&lt;Ne amǝ ɓala mala Yakupu, amǝ Isǝrayila ama: <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />&lt;Wu sǝnǝna gìr mǝnana ǝn pakki amǝ Masar, andǝ lang sǝ ǝn twal wun kǝla mana nkwang kǝ twal muni arǝ ankpamtari ka, sǝ ǝn yinǝ wun akani abanam. <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" />Adyan ngga ɓǝ̀ wun nǝ̀ okam, sǝ wun nǝ̀ lùmsǝ kùrcau mem ngga, aɓalǝ anzali kat ka, wun nǝ̀ duk aɓwana mǝnana ǝn tària à dumǝna mem ngga, kat andǝ amani ama ɓanza kat ka mema ka. <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" />Wun nǝ̀ duk domurǝm mala apǝris abanam, aɓwana amǝfele mem.&gt; Amǝnia ka à nda ka acau mǝnana awu nǝ ne amǝ Isǝrayila ka.&gt;&gt;<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />Pǝlǝa Musa sùlǝî múr nkono, sǝ tunǝ aɓwana-mǝgule mala aɓwana kat, sǝ banggia wia cau mana kat Yahweh tsǝì ama ɓǝ̀ banggia wia ka. <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" />Osso aɓwana ear gǝu ama, &lt;&lt;Sǝm nǝ̀ kpata cau mǝnana kat Yahweh bang ngga.&gt;&gt; Sǝ Musa nyesǝ cau mala aɓwana kya ne Yahweh.<verse eid="EXO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 19:9" />Yahweh banggi Musa ama, &lt;&lt;Mǝ ndya mǝ nǝ yiu a bano aɓa pǝrɓang mǝɓiktiki, ace mǝnana ɓǝ̀ aɓwana ok giem aban nacau nǝ we ka. Anggo ka à nǝ̀ earnǝ we a koya pwari.&gt;&gt;</para>
  <para style="p" vid="EXO 19:9">Anzǝm mana Musa nyesǝna cau mǝnana aɓwana bang ngga, kya nani Yahweh ka, <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />Yahweh banggi Musa ama, &lt;&lt;Kyane, aban aɓwana, kya nea wia ɓǝà twal pwari mala yalung andǝ lí ɓǝà gilǝki rǝia aɓa ɓoarnsari ace yiu a peri. Nea wia ɓǝà lákkí agir-nggūrǝu malea <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />sǝ ɓǝà gilǝrǝia a tàruià pwari. A pwari mǝno ka mǝ nǝ sulǝo, mǝ nǝ yiu amur Nkono Saina, a ban mǝnana aɓwana kat nǝ̀ sǝnam ngga. <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" />Tsǝk nzong ɓǝ̀ kàrì nkono ace mǝnana aɓwana ɓǝà kǝa yàllî wi ɗàng, sǝ banggia wia ama ɓǝà kǝa eauwe a nkono ɗàng, yàle ɓǝà kǝa na ama à nǝ̀ gbàshì baní ɗàng. Ɓǝ̀ kǝɓwa tsǝk kusǝì amur nkono ka, ɓǝà wali ɓǝ̀ wu; <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />ɓǝà ɓukki nǝ atali, ko ɓǝà tāki nǝ amundi; sǝ bù kǝɓwa ɓǝ̀ kǝa na ama nǝ̀ je mǝno yì ɓwa ka ɗàng. Ko ɓǝ̀ girkusǝu na sǝ je nkono mǝnia ka, dumǝna púp à nǝ̀ wali ɓǝ̀ wú. Sǝama aɓwana nǝ̀ gandǝ ká tù a kusǝ nkono anzǝm mǝnana ɓǝà ok twang njawe ɓua tè sau ɗār ka.&gt;&gt;<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />Pǝlǝa Musa sùlǝî múr nkono yiu aban aɓwana, sǝ banggi aɓwana ɓǝà gilǝrǝia ace peri. Nda à lákkí agir-nggūrǝu malea ka, <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />sǝ Musa banggia wia ama, &lt;&lt;Wu gilǝ rǝ wun ace tàruià pwari, tite a pwari mala yalung. Wu kǝa gbàshì ban amālá wun ɗàng.&gt;&gt;<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />A tàruià nongŋo nǝ dǝmbari ka, mgbarangce sàkkya, tǎlaban liki'nzama pǝlilip, pǝrɓang mǝgule yi zuppi amur nkono, sǝ à ok gìu mǝcandǝe mala njawe aban ɓua, sǝ koyan a kàttì ka rǝì ɓǝl nǝ ɓangciu. <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" />Pǝlǝa Musa ak dǝmba sǝ aɓwana kpatè, pusǝia à nying kàttì, aban ká je andǝ Ɓakuli. À yiu à yi came a kusǝ nkono.<verse eid="EXO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 19:18" />Sǝ Nkono Saina ka lùmsǝ nǝ yele, acemǝnana Yahweh angŋa dǝmba yi sulǝna amurí aɓa bǝsa mǝ'earke, sǝ yele male kǝ lo a kùli kǝla yele tūli bǝsa, sǝ nkono kat ka kǝ gǝggǝli nǝ rǝcandǝa. <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />Lang gì njawe nǝ̀ nggǝ ɓua kàm kpǝm bàng-bàng ngga, Musa pǝlǝa nacau, sǝ Ɓakuli nyesǝi wi cau nǝ giu mala mgbarangce. <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />Yahweh yi sulǝo a ɓong Nkono Saina sǝ tunǝ Musa ɓǝ̀ eauwe ɓǝ̀ kyane a ɓong nkono. Musa eauwe wario, <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />sǝ Yahweh banggi wi ama, &lt;&lt;Sulǝo kyane kya nunkir aɓwana ama ɓǝà kǝa yàlî nzong ama à nǝ̀ ɓunno aban yiu aban Yahweh ace sǝnban ɗàng. Ɓǝ̀ à pàk anggo ka, pas ateà à nǝ̀ wukio. <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />Ko nggearǝ apǝris mǝnana à kǝ yiu à kǝ gbashi banam pwari-pwari ka, dumǝna púp à nǝ̀ tàr ɓamuria aɓa domǝfele, ɓǝ̀ ana raka mǝ nǝ sulǝ bumlulla mem amuria, mǝ nǝ twaltea.&gt;&gt;<verse eid="EXO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 19:23" />Musa ne Yahweh ama, &lt;&lt;Aɓwana pà nǝ̀ eauwe aban yiu aban nkono ɗàng, acemǝnana à earia wia ɓǝà yiu ɗang; we nǝ nggearǝo ka, a bangŋǝna sǝm ama ɓǝ̀ sǝm tsǝk nzong ɓǝ̀ kàrì nkono ace mǝnana ɓǝ̀ tàrì, dumǝna ban mǝfele ka.&gt;&gt;<verse eid="EXO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 19:24" />Yahweh nyesǝi wi ama, &lt;&lt;Sulǝo kyane sǝ wu kya yiu wunǝ Haruna akani. Sǝ apǝris andǝ acili aɓwana ka, ɓǝà kǝa ɓun ama à nǝ̀ yiu abanam ɗàng, ɓǝ̀ ana raka mǝ nǝ sulǝ bumlulla mem amuria, mǝ nǝ twaltea.&gt;&gt;<verse eid="EXO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 19:25" />Pǝlǝa Musa sulǝo wari aban aɓwana sǝ nea wia gìr mǝnana Yahweh bang ngga.<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">Anzongcau Lum</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />Ɓakuli bang amǝnia yì acau ka, ama:<verse eid="EXO 20:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="EXO 20:2" />Mim Yahweh ka, mǝ nda Ɓakuli mô, mǝnana amsǝo a nzali Masar, a purî ɓala guro ka.<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 13:3">Pur 13:3</ref>; <ref loc="HOS 13:4">Hos 13:4</ref></char>.</note><verse eid="EXO 20:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="EXO 20:3" />A pà wu nǝ pàngnǝ aɓea aɓakuli ɗang she kǝ mim.<note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 6:14">Nggur 6:14</ref>; <ref loc="JER 35:15">Ir 35:15</ref></char>.</note><verse eid="EXO 20:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="EXO 20:4" />A pà wunǝ pakkî ɓamurò kǝ ɓǝ̀nzál mǝnana à shàrrì, ko ɓè gìr mǝnana kat kǝ pur ɓè kǝgìr akanó a kùli, ko akani a nzali, ko a tǝta mùr a tà-nzali ka ɗàng. <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" />Dumǝna púp a pà wu nǝ ɓun a ɓadǝmbia, ko awu nǝ peri abania ɗàng. Acemǝnana Mim Yahweh Ɓakuli mô ka, mǝ nda Ɓakuli mǝ'mɓali.<note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="fq" closed="false">Ɓakuli mǝ'mɓali </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 34:14">Tite 34:14</ref>; <ref loc="DEU 4:24">Nggur 4:24</ref>; <ref loc="DEU 6:15">6:15</ref>; <ref loc="JOS 24:19">Jes 24:19</ref>; <ref loc="NAM 1:2">Nah 1:2</ref></char>.</note> Ən nggǝ yinǝ ɓashi ace acauɓikea mala atárrú amur amunia andǝ amǝ'keà, aban ká tàruia andǝ inea nza mala aɓwana mǝnana à kǝ ɓinǝcem ngga. <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />Sǝama ǝn nggǝ lǝmdǝ earcearǝu mem mǝnana malkiyi raka, amur aɓwana mǝnana à kǝ earcem sǝ à kǝ bwal anzongcau mem ngga. Earcearǝu mem nǝ̀ gya amuria andǝ amunia andǝ amǝ'keà aban ká arǝ anza á-pas malea.<verse eid="EXO 20:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="EXO 20:7" />A pà wunǝ pàktúró nǝ lullǝ Yahweh Ɓakuli mô ace pàkkiagir ɓana ɗàng; acemǝnana Yahweh pa nǝ̀ nying ɓashì ɓwa mǝnana kǝ nyesǝ lullǝì ɓà ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">20:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:12">Pǝris 19:12</ref>; <ref loc="MAT 5:33">Mat 5:33</ref></char>.</note><verse eid="EXO 20:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="EXO 20:8" />Ɗenyinǝ Pwari Sabbat, pwari usǝlǝo; awu nǝ tàrì ɗàng ɓǝ̀ duk mǝfele, pwari ace Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">20:8 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="EXO 31:13-16">Pur 31:13-16</ref>; <ref loc="LEV 19:3">Pǝris 19:3</ref>,<ref loc="LEV 19:30">30</ref>; <ref loc="LEV 26:2">26:2</ref></char>.</note> <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" />Arǝ apwari tongno-nong mwashat sǝ awu nǝ pàk túró, a nǝ mal atúró mô kat. <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />Sǝama tongno-nong-ɓaria nongŋo ka, pwari Sabbat na abanam Yahweh. Aɓalǝi ka, a pà wu nǝ pàk kǝ túró ɗang, ko we, ko muna-ɓwabura mô, ko muna-ɓwama mô, ko muna-ɓwabura mǝtúró-ɓala mô, ko muna-ɓwama mǝtúró-ɓala mô, ko agirkusǝu mô, ko abǝri-aɓwana mǝnana à do atà wun a là ka. <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" />Acemǝnana aɓalǝ anongŋo tongno-nong-mwashat sǝ Yahweh pusǝ kùli andǝ nzali, sǝ nggeamùr, andǝ agir mǝnana kat aɓalǝia ka, sǝ usǝlǝo a tongno-nong-ɓaria pwari. Nda gìr mǝnana tsǝa sǝ Yahweh tsǝki pwari Sabbat bù, sǝ tàrì duk mǝfele ka.<verse eid="EXO 20:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="EXO 20:12" />Gusǝlǝ tárró andǝ nggo,<note caller="+" style="f"><char style="fr" closed="false">20:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:3">Pǝris 19:3</ref>; <ref loc="MAT 15:4">Mat 15:4</ref>; <ref loc="MRK 7:10">Mar 7:10</ref>; <ref loc="LUK 18:20">Luk 18:20</ref>; <ref loc="EPH 6:2">Afi 6:2</ref></char>.</note> ace mǝnana anongŋo mala do ɓanza mô mǝnana Yahweh Ɓakuli mô po ka, ɓǝà làkkì.<verse eid="EXO 20:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="EXO 20:13" />A pà wu nǝ wal-lú ɗàng.<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:21">Mat 5:21</ref>; <ref loc="ROM 13:9">Rom 13:9</ref></char>.</note><verse eid="EXO 20:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="EXO 20:14" />A pà wunǝ nongnǝ kǝ ɓwa mǝnana wu al rǝ wun wunǝi raka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">20:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 5:18">Nggur 5:18</ref>; <ref loc="MAT 5:27">Mat 5:27</ref></char>.</note><verse eid="EXO 20:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="EXO 20:15" />A pà wunǝ iun'í ɗang.<note caller="+" style="f"><char style="fr" closed="false">20:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:11">Pǝris 19:11</ref>; <ref loc="MAT 19:18">Mat 19:18</ref></char>.</note><verse eid="EXO 20:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="EXO 20:16" />A pà wunǝ nakún nyir arǝ ɓio mǝ'murkala ɗang.<note caller="+" style="f"><char style="fr" closed="false">20:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:1">Pur 23:1</ref></char>.</note><verse eid="EXO 20:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="EXO 20:17" />A pà wu nǝ sham ɓala mala ɓio mǝ'murkala ɗang. A pà wu nǝ sham mālá ɓio mǝ'murkala, ko mǝtúró-ɓala male ɓwabura ko ɓwama, ko jamnda, ko ndambǝritso male, sǝ koya gìr mǝnana kat mala ɓio mǝ'murkala na ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 5:21">Nggur 5:21</ref>; <ref loc="MAT 5:28">Mat 5:28</ref>; <ref loc="LUK 12:15">Luk 12:15</ref>; <ref loc="ROM 7:7">Rom 7:7</ref>; <ref loc="ROM 13:9">13:9</ref>; <ref loc="EPH 5:3">Afi 5:3</ref>,<ref loc="EPH 5:5">5</ref>; <ref loc="HEB 13:5">Ib 13:5</ref></char></note><verse eid="EXO 20:17" /></para>
  <para style="s">Ɓangciu pàkkî ɓwapǝndǝa</para>
  <para style="r">(<ref loc="DEU 5:23-33">Ɓǝs Nggur 5:23-33</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />Lang ɓwapǝndǝa kat nǝ̀ ok sàkkya mala mgbarangce, andǝ gi njawe, sǝ à sǝn liki'nzama mala tǎlaban, andǝ yele mǝnana kǝ lo amur nkono ka, ɓangciu pakkia wia, rǝia kǝ ɓǝla, sǝ à cam kuko.<verse eid="EXO 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 20:19" />À banggi Musa ama, &lt;&lt;We ka bangga sǝm cau, sǝm nǝ̀ ǒ, sǝama Ɓakuli ɓǝ̀kǝa na sǝm cau nǝ nggeari ɗàng, ɓǝ̀ ana raka sǝm nǝ̀ wukio.&gt;&gt;<verse eid="EXO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 20:20" />Musa pea wia eare ama, &lt;&lt;Ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Ɓakuli yiu nǝ̀ yia mwam wun, ace mǝnana ɓǝ̀ wu dum nǝ ɓangciu male, wu kǝa pàk cauɓikea raka.&gt;&gt;<verse eid="EXO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 20:21" />Aɓwana ueo aban came zak; Musa na nǝmurǝì sungŋo wari aban pǝndǝa mǝcikciki, a ban mǝnana Ɓakuli nakam ngga.<verse eid="EXO 20:21" /></para>
  <para style="s">Anggurcau amur agyangŋan</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />Yahweh banggi Musa ama, &lt;&lt;Nea amǝ Isǝrayila cau mǝnia ka ama: &lt;Wu sǝnǝni nǝ nggearǝ wun ama ǝn bangga wun cau nǝ kuli. <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />Pà wun nǝ̀ alita ɓamur rǝ wun ɓekǝ nkúl mǝnana à pè nǝ bolo-azǝrfa ko bolo-njengǝlan ama wun nǝ̀ peri abania sǝ wun nǝ̀ kpapiam sǝnǝia ka ɗàng.<verse eid="EXO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 20:24" />&lt;&lt; &lt;Wu ɓak gyangŋan nǝ dǝɓang-nzali acem, sǝ wu pāki agir'nkila nǝ anzur andǝ andá ma'wun mǝnana à nǝ̀ pisǝia kǝring ngga, andǝ pākiagir mala dotarǝu, amurí. A koya ban mǝnana ǝn tárì ace mǝnana ɓǝ̀ wu yi peri abanam kàm ngga, mǝ nǝ yiu aban wun mǝ nǝ tsǝka wun bù. <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" />Ɓǝ̀ wun nǝ̀ ɓak gyangŋan nǝ atali acem ngga, wu kǝa ɓè nǝ atali mǝnana à ɓunnia nǝ ɓunno ka ɗàng. Ɓǝ̀ wu pàktúró nǝ tali mǝnana à ɓunni ko à gilǝki rǝi nǝ girtúró sǝ à ɓak gyangŋan nǝi ka, gyangŋanì pànǝ ɓoaro abanam ace peri ɗàng. <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />Wu kǝa ɓakkam gyangŋan mǝnana ndanǝ aban-eauwe arǝì ka ɗàng, ace mǝnana ɓǝ̀ a ndaban eauwe aban ká amurí ka, wu kǝa alí rǝò ɗàng.&gt;<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />&lt;&lt;Amǝnia ka, à nda ka akwarkiru mǝnana awu nǝ pè amǝ Isǝrayila ka.<verse eid="EXO 21:1" /></para>
  <para style="s">Pangnǝ aguro amǝ Ibǝru</para>
  <para style="r">(<ref loc="DEU 15:12-18">Ɓǝs Nggur 15:12-18</ref>)</para>
  <para style="pi">
    <verse number="2" style="v" sid="EXO 21:2" />&lt;&lt;Ɓǝ̀ a kúr guro ɓwa Ibǝru ka, nǝ̀ pàkkô túró guro apǝlǝa tongno-nong-mwashat. Sǝ aɓa tongno-nong-ɓaria pǝlǝa ka, awu nǝ nyì ɓǝ̀ kum ɓamúrì, ɓǝ̀ kǝa mbweo kǝgir ace ɗàng. <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />Ɓǝ̀ nda nǝmurǝì, pànǝ ɓwama ɗàng, sǝ a kúrí ka, yì nǝmurǝì na awu nǝ panzǝi ɓǝ̀ u ka. Sǝ ɓǝ̀ ndanǝ ɓwama sǝ yi duk guro mò ka, nǝ̀ twal māmí à nǝ̀ o andǝi. <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" />Ɓǝ̀ mǝtala-ɓala male na pè wi ɓwama, sǝ ɓwame ɓǝlî wi amuna ka, nǝ̀ um nǝmurǝì, ɓwama andǝ amuna ka amala mǝtala-ɓala male na. <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />Sǝ ɓǝ̀ mǝno yì guro ne bwāng ama, &lt;Ən nggǝ earce mǝtala-ɓala mem, andǝ māmám andǝ amunem,&gt; sǝ earce ama ɓǝà panzǝi nǝ̀ o nǝ̀ nyia raka, <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />mǝtala-ɓala male nǝ̀ kánǝi a ɓadǝm Ɓakuli. Akanó ka nǝ̀ nggá tamsǝi a kunkurǝm ko arǝ kpangbang kunkurǝm, sǝ mǝtala-ɓala male nǝ̀ tusǝ kiri nǝ nlerǝman, sǝ yì ka nǝ̀ duk guro mala mǝtala-ɓala male bà lú male.<verse eid="EXO 21:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="EXO 21:7" />&lt;&lt;Ɓǝ̀ ɓwa mak nsarile ɓǝ̀ duk guro mǝturo-ɓala ka, à pà nǝ̀ panzǝi ɓǝ̀ o kǝla mala guro muna-ɓwabura ɗàng. <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />Ɓǝ̀ guro muna-ɓwame mǝnia ka, mǝtala-ɓala male yinǝi sǝ yi tàrì ace ɓamúrì ɓǝ̀ duk māmí, sǝama nǝnzǝ́mò ka guro muna-ɓwame pwasǝbumi raka, dumǝni mǝtala-ɓala mǝnia ka púp ɓǝ̀ ɗeki ɓǝà akmúr muna-ɓwame.<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="fq" closed="false">ɓǝà akmúr muna-ɓwame </char><char style="ft" closed="false">ko &lt;&lt;ɓǝ̀ tár muna-ɓwame ko ɓeɓwa ɓǝ̀ nyare ɓǝ̀ kúr muna-ɓwame ɗǝm a bu mǝtala-ɓala male ɓǝ̀ nyesǝi&gt;&gt; ko muna-ɓwame ɓǝ̀ akmúr ɓamúrì ɓǝ̀ nǝ̀ gandǝi ka.</char></note> Njar pà kàm a bu mǝtala-ɓala mǝnia ama nǝ̀ makkì amǝ'kúnɗàngna mǝnia yì guro muna-ɓwama ka ɗàng, acemǝnana ɓungina tsǝkɓalǝu mala muna-ɓwame. <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />Ɓǝ̀ ɓwa kúr mā-guro ace mǝnana ɓǝ̀ duk mālá munì ka, nǝ̀ twali kǝla munì.<verse eid="EXO 21:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="EXO 21:10" />&lt;&lt;Ɓǝ̀ mǝtala-ɓala al ɓaria ɓwama ka, dumǝna púp nǝ̀ lidǝmba nǝ pê ɓwama mǝdǝmbe girlina andǝ gìr'nggūrǝu ɓǝ̀ kārǝí, sǝ nǝ̀ lidǝmba nǝ pakki wi gìr mǝnana ɓoaro ɓǝ̀ ɓwabura pakki māmí ka. <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />Sǝ ɓǝ̀ ginǝ lùmsǝ amǝnia yì atúró male kǝla ɓwabura aban ɓwame ka, dumǝna púp nǝ̀ nyì ɓǝ̀ purî ɓala male, sǝ ɓǝ̀ kǝa mbwe kǝgir ɗàng.<verse eid="EXO 21:11" /></para>
  <para style="s">Anggurcau amur ɓìkìbura</para>
  <para style="pi">
    <verse number="12" style="v" sid="EXO 21:12" />&lt;&lt;Ɓwa mǝnana kat wal ɓè ɓwa, ɓwe wù ka, à nǝ̀ wal-luí gbal. <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" />Sǝama ɓǝ̀ turtúró nǝ túró arǝì, hamce nǝ̀ wal-lui raka, sǝ kat andǝ amani ka Ɓakuli eare gìrnî kumban ngga, mǝ nǝ tsǝk ɓè ban-auwa mǝnana ɓwê nǝ̀ gandǝ ɓangŋa nǝ̀ ká kàm ngga.<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 35:11">Ɓal 35:11</ref>,<ref loc="NUM 35:22-25">22-25</ref>; <ref loc="DEU 19:2-5">Nggur 19:2-5</ref>; <ref loc="JOS 20:2-9">Jes 20:2-9</ref>; <ref loc="1SA 24:4">1Sam 24:4</ref>,<ref loc="1SA 24:10">10</ref>,<ref loc="1SA 24:18">18</ref></char></note> <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" />Sǝ ɓǝ̀ ɓwa kànì a ɓabumi sǝ wal-lú kpakpak ka, ko ɓǝ̀ ɓangŋa sǝ kya auwa arǝ gyangŋan mem ngga, wu nungi wu pusǝì, wu wal-luí.<verse eid="EXO 21:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="EXO 21:15" />&lt;&lt;Ɓwa mǝnana kat walki tárrí ko walki ngge ka, dumǝna ama à nǝ̀ wal-luí.<verse eid="EXO 21:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="EXO 21:16" />&lt;&lt;Ɓwa mǝnana iu ɓè ɓwa kya mé ko à kumi a buì ka, dumǝna ama à nǝ̀ wal-luí.<verse eid="EXO 21:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="EXO 21:17" />&lt;&lt;Ɓwa mǝnana kat sanggi tárrí ko sanggi nggè ka, dumǝna ama à nǝ̀ wal-luí.<note caller="+" style="f"><char style="fr" closed="false">21:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12">Pur 20:12</ref>; <ref loc="LEV 20:9">Pǝris 20:9</ref>; <ref loc="DEU 5:16">Nggur 5:16</ref>; <ref loc="MAT 15:4">Mat 15:4</ref></char>.</note><verse eid="EXO 21:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EXO 21:18" />&lt;&lt;Ɓǝ̀ ndo ama aɓwana ɓari na aban pǝlǝkirǝia, sǝ ɓè ɓwa wal ɓì nǝ tali, ko tùllì nǝ bui sǝ wù ɗàng, sǝama kum penye mǝnana nongsǝi a kala, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />sǝ ɓǝ̀ nǝnzǝ́mò ka ɓwê yi longŋǝna nǝ nggǝ ging nǝ gara a nza ka, ɓwa mǝno walban ngga auna, sǝama nǝ̀ mbwe apwari mǝnana kiɗiki wi ka, sǝ ɗǝm ngga nǝ̀ tsǝkiri sǝ nǝ̀ mbwe boalo agir'sonzǝo male sheɓǝ̀ rǝì malna kat ka.<verse eid="EXO 21:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="EXO 21:20" />&lt;&lt;Ɓǝ̀ mǝtala-ɓala walki guro male, ɓwama ko ɓwabura nǝ gara, sǝ wal-luí a kún bui ka, dumǝna púp à nǝ̀ ɓashì wi nǝ wal-luí. <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />Sǝ ɓǝ̀ gurè wù ɗàng, rǝi malâ aɓa nongŋo mwashat ko ɓari ka, à pà nǝ̀ pakkî mǝtala-ɓala male kǝgir ɗàng acemǝnana guro ka girkuma male na.<verse eid="EXO 21:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="EXO 21:22" />&lt;&lt;Ɓǝ̀ aɓwana ɓari na aban munǝo, sǝ ɓè ɓwa ateà tùl ɓwama nǝ muna a bumi, muna-sulǝ'arǝì, sǝ kum ɓekǝ npenye raka, ɓwa mǝnana tul ɓwamè ka burí nǝ̀ kasǝi wi boalo mǝnana nǝ̀ mbwe ka, sǝ amǝ'ɓashi nǝ̀ sǝngi gir mǝnana ɓoaro ɓǝ̀ mbwe ka. <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />Sǝ ɓǝ̀ ɓè kǝgir kum ɓwamè ka, à nǝ̀ mbwe yilǝmu nǝ yilǝmu, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" />mǝsǝu ace mǝsǝu, minǝu ace minǝu, bù ace bù, kusǝu ace kusǝu, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />pisǝban ace pisǝban, npenye ace npenye, kokban ace kokban.<verse eid="EXO 21:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="EXO 21:26" />&lt;&lt;Ɓǝ̀ ɓwa wal guro male, ɓwabura ko ɓwama, sǝ ar mǝsǝi ka, dumǝna púp ɓǝ̀ nying guro mǝno ɓǝ̀ o atàrǝì. Mǝno ka nǝ̀ do nda mbweban ace mǝsǝì. <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />Sǝ ɓǝ̀ ɓun minǝ guro male ɓwabura ko ɓwama ka, dumǝna púp ɓǝ̀ nying guro mǝno ɓǝ̀ o a do-ɓamurì ace minǝì.<verse eid="EXO 21:27" /></para>
  <para style="s">Akwarkiru amur agirkuma</para>
  <para style="pi">
    <verse number="28" style="v" sid="EXO 21:28" />&lt;&lt;Ɓǝ̀ ndǎ soa ɓwabura ko ɓwama nǝ njawe sǝ wal-luí ka, dumǝna púp à nǝ̀ ɓukki mǝno yì ndǎ ka nǝ atali sǝ à pà nǝ̀ shak nyami ɗàng; sǝ mǝtala ndǎ ka à pà nǝ̀ pakki wi kǝgir ɗàng. <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />Sǝ ɓǝ̀ ndǎ mǝno ka à súrǝì kǝ soaban, sǝ mǝtale ka à nunakiri sǝ oasǝi aɓa nkāndan raka, ɓǝ̀ wal-lú ka, à nǝ̀ ɓukki mǝno yì ndǎ ka, sǝ mǝtale gbal ka à nǝ̀ wal-luí. <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />Sǝama ɓǝà kasǝi wi gìr mǝnana nǝ̀ mbwe ace amsǝ yilǝmi ka, dumǝna púp nǝ̀ mbwe gìr mǝnana kat à kasǝi wi ka. <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />Sǝ ɓǝ̀ mǝno yì ndǎ ka tùl muntulo ɓwama ko ɓwabura ka, kǝ ɓashi mǝmwashati kǝla mǝno na à nǝ̀ kasǝ ka. <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />Ɓǝ̀ mǝno yi ndǎ ka, soa guro ɓwama ko ɓwabura ka, à nǝ̀ mbwe mǝtala guro mǝsǝbolo azǝrfa lumi-tàrú sǝ yì ndǎ ka, à nǝ̀ ɓukki ɓǝ̀ wú.<verse eid="EXO 21:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="EXO 21:33" />&lt;&lt;Ɓǝ̀ ɓwa busǝlǝ tūli, ko tǝm tūli sǝ lúmsǝí raka, ɓǝ̀ ndǎ ko mǝdambǝriso kpa aɓalǝi ka, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />mǝtala tūli ka nǝ̀ mbwe mǝtala girkusǝu boalè, sǝ lú girkusǝu ka nǝ̀ duk male.<verse eid="EXO 21:34" /></para>
  <para style="pi">
    <verse number="35" style="v" sid="EXO 21:35" />&lt;&lt;Ɓǝ̀ ndǎ mala ɓwa soa ndǎ mala ɓè ɓwa, wal-luí ka, yì aɓwana mǝnia ɓari ka à nǝ̀ mak ndǎ mǝnana nǝyilǝmu ka, à nǝ̀ gau boalè sǝ nyam lú ndǎ gbal ka à nǝ̀ gauwi.<verse eid="EXO 21:35" /></para>
  <para style="pi">
    <verse number="36" style="v" sid="EXO 21:36" />&lt;&lt;Sǝ ɓǝ̀ ndo ama mǝno yì ndǎ ka à súrǝì nǝ tulkiban ɗiɗyal sǝ mǝtale tsǝkiri oasǝi aɓa nkāndan raka, mǝtala ndê nǝ̀ mbwe ɓè ndǎ a kúnì lú ndǎ, sǝ nǝ̀ twal lú ndǎ ɓǝ̀ duk male.<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">Akwarkiru ace mbwegìr a kúnì</para>
  <para style="pi">
    <verse number="1" style="v" sid="EXO 22:1" />&lt;&lt;Ɓǝ̀ ɓwa iu ndǎ ko nzur, sǝ pwanmyali ko mé ka, dumǝna púp ɓwe nǝ̀ mbwe andá tongno a kúnì ndǎ mwashat, sǝ nǝ̀ mbwe anzur ine a kúnì nzur mwashat.<verse eid="EXO 22:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="EXO 22:2" />&lt;&lt;Ɓǝ̀ à bwal mǝn'í aɓa ɓala nǝ dú aban ǝn'í sǝ à wal-luí ka, ɓwa mǝno wal-lú mǝn'í ka à pà nǝ̀ bwali nǝ kúmcàu mala wal-lú ɗàng; <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />sǝama ɓǝ̀ nda nǝ pwari sǝ gìrnî kumban ngga, ɓwa mǝnana wal-luí ka, à nǝ̀ ɗice nkila mǝn'í a buì.</para>
  <para style="pi" vid="EXO 22:3">&lt;&lt;Mǝn'í ka, dumǝna púp nǝ̀ mbwe gìr mǝnana kat iu ka. Ɓǝ̀ gandǝ mbwe raka, ɓǝà mé kǝla guro ace mbwe gìr mǝnana iu ka.<verse eid="EXO 22:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="EXO 22:4" />&lt;&lt;Ɓǝ̀ ɓwa iu ndǎ, ko mǝdambǝriso, ko nzur sǝ à kumi a buì ka, dumǝna púp nǝ̀ mbwe ɓari a kúnì mwashat mala gìr mǝnana iu ka.<verse eid="EXO 22:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="EXO 22:5" />&lt;&lt;Ɓǝ̀ ɓwa nying agirkusǝu à kùtí a ɓaban mala ɓeɓwa sǝ à lì mǝssa ko aɓǝlanggun anap ka, dumǝna púp mǝtala agirkusǝu nǝ̀ pwan mǝssa ko ɓǝlanggun anap mǝɓoarne kat-kat aɓalǝ agirɓaban male ɓǝ̀ mbwe mǝtala ɓaban gìr mǝnana kat agirkusǝu kiɗiki wi ka.<verse eid="EXO 22:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="EXO 22:6" />&lt;&lt;Ɓǝ̀ ɓwa soa bǝsa aban pisǝki azwe sǝ bǝshè àwá pisǝ mǝssa mǝnana nda aban came, ko mǝnana à wàlnì, ko mǝnana à ramǝni a ɓaban mala ɓeɓwa ka, ɓwê ka nǝ̀ mbwe mǝtala ɓaban gìr mǝnana kat bǝsa pìsǝì ka.<verse eid="EXO 22:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="EXO 22:7" />&lt;&lt;Ɓǝ̀ ɓwa pè ɓi mǝ'murkala boalo, ko ɓè girkuma ɓǝ̀ tsǝki wi, sǝ à yi iuwi arǝì a ɓala, sǝ ɓǝ̀ à yi bwal mǝn'î ka, dumǝna púp mǝn'í nǝ̀ mbwe gìr mǝnana iu ka kusǝ ɓari. <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />Sǝ ɓǝ̀ à bwal mǝn'î raka, ɓwa mǝnana à pè wi tsǝk boalo ko girkuma ka, à nǝ̀ kánǝí aban amǝ'ɓashi a ɓadǝm Ɓakuli. Akanó ka ɓǝà kya sǝngi cê ko yì na oasǝ buì arǝ girkuma mala ɓì mǝ'murkala ka.<verse eid="EXO 22:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="EXO 22:9" />&lt;&lt;Ɓǝ̀ makgir lo a nre ka aɓwana ɓari amur ndǎ, ko mǝdambǝriso, ko nzur, ko ɓè girkuma, ko gìr'nggūrǝu, ko ɓè gìr mǝnana ɓwaro sǝ koyan ngga kǝ na ama male na ka, à nǝ̀ kánǝ cê malea mǝnia yia kǝm ngga aban amǝ'ɓashi aɓadǝm Ɓakuli, sǝ ɓwa mǝnana amǝ'ɓashi bwali nda mǝ'nyir ka, nǝ̀ mbwe gìrnî kusǝ ɓari.<verse eid="EXO 22:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="EXO 22:10" />&lt;&lt;Ɓǝ̀ ɓwa eare nǝ̀ bwal mǝdambǝriso, ko ndǎ, ko nzur, ko ɓekǝ girkusǝu ace mǝnana nǝ̀ tsǝkiri ace ɓi mǝ'murkala, sǝ yì girkusǝu ka wǔ, ko kum npenye, ko ɓwaro sǝ kǝɓwa sǝni raka, <verse eid="EXO 22:10" /><verse number="11" style="v" sid="EXO 22:11" />ɓwa mǝnana à pè wi tsǝkirgir ka, dumǝna púp nǝ̀ kángìr a ɓadǝm Yahweh ama, iu-ma girkusǝu mala ɓì mǝ'murkala ɗang; sǝ mǝtala girkusǝu ka nǝ̀ earnǝ mǝno, sǝ à pà nǝ̀ ɗice kǝ mbweban ɗang. <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />Sǝ ɓǝ̀ mǝno yì girkusǝu ka à iuwi nǝ iuwe ka, ɓwa mǝnana iuwi ka, nǝ̀ mbwe mǝtale. <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />Ɓǝ̀ mǝno yì girkusǝu ka nyamɓikea na bwali ka, ɓǝà yinǝ abare luí aban mǝtale; mbweban pa kàm ace girkusǝu mǝnana nyamɓikea bwali ko sàngi ka ɗàng.<verse eid="EXO 22:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="EXO 22:14" />&lt;&lt;Ɓǝ̀ ɓwa ak girkusǝu a bù ɓi ace mǝnana nǝ̀ pàngŋǝ̀nà túró nǝi, sǝ ɓè kǝgir mǝɓane kumi, ko wǔ, sǝ pà a mǝsǝ mǝtale raka, ɓwa mǝnana ak girkusǝunì ka, nǝ̀ mbwe mǝtale a kúnì. <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />Sǝama ɓǝ̀ mǝtala girkusǝunì nakam a banì ka, ɓoaro ɓǝ̀ ɓwê mbwe ɗàng. Ɓǝ̀ yì girkusǝu ka à é nǝ â nǝ boalo ka, boalè nda boalo murí.<verse eid="EXO 22:15" /></para>
  <para style="s">Anggurcau mala kpata Ɓakuli andǝ do nǝ aɓwana</para>
  <para style="pi">
    <verse number="16" style="v" sid="EXO 22:16" />&lt;&lt;Ɓǝ̀ ɓwabura swár nsari mǝnana à malaká pur'amuri raka, sǝ nongnǝi ka, dumǝna púp nǝ̀ mbwe gǝna murí, à nǝ̀ do andǝi ɓǝ̀ duk māmí. <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" />Sǝ ɓǝ̀ tár mǝnia yì nsarì ɓinǝ pà muni ɓǝ̀ ɓwabure ali ka, kat andǝ amani ka, dumǝna púp ɓwabure nǝ̀ mbwe boalo mǝnana kārǝ arǝ gǝna múr nsari ka.<verse eid="EXO 22:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EXO 22:18" />&lt;&lt;Ɓwama mǝnana kǝ pakkiagir nggár ka, kǝa ɗeki ɓǝ̀ dumnǝ yilǝmu ɗang.<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 20:27">Pǝris 20:27</ref>; <ref loc="DEU 18:11">Nggur 18:11</ref>; <ref loc="1SA 28:3">1Sam 28:3</ref></char>.</note><verse eid="EXO 22:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="EXO 22:19" />&lt;&lt;Ɓwa mǝnana kat nongnǝ girkusǝu ka, dumǝna púp à nǝ̀ wal-luí.<verse eid="EXO 22:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="EXO 22:20" />&lt;&lt;Ɓwa mǝnana kat pa gir'nkila aban ɓekǝ ɓakuli sǝ Yahweh na raka, à nǝ̀ tàrrì aban Ɓakuli ɓǝ̀ kìɗikì.<note caller="+" style="f"><char style="fr" closed="false">22:20 </char><char style="fq" closed="false">à nǝ̀ tàrrì aban Ɓakuli ɓǝ̀ kìɗikì </char><char style="ft" closed="false">ko &lt;&lt;dumǝna púp à nǝ̀ wal-luí.&gt;&gt;</char></note><verse eid="EXO 22:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="EXO 22:21" />&lt;&lt;Cè wu nyesǝce ɓwa-kúnɗàngna ɓà ko wu ɓiki wi ɗàng. Wu ɗenyi ama wun gbal ɗiɗyal ka, wun nda ka amǝ'kúnɗàngna a nzali Masar.<verse eid="EXO 22:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="EXO 22:22" />&lt;&lt;Wu kǝa pàkkî mā-lú ko káwá mǝɓane ɗàng. <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />Ɓǝ̀ a ɓǝmbǝria a koya buì, sǝ ɓǝ̀ à ɓua abanam ngga, dumǝna ama mǝ nǝ ok ɓua malea, <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />sǝ bumlulla mem nǝ̀ earki amur wun, mǝ nǝ wal-lú wun nǝ nggeabyau. Sǝ amālá wun nǝ̀ duk amā-lú, amuna wun nǝ̀ duk akáwá.<verse eid="EXO 22:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="EXO 22:25" />&lt;&lt;Ɓǝ̀ a pê kǝɓwa atà aɓwana mem mǝnana à nda aɓa tǝle ka, tangna boalo ka, cè a na ama awu nǝ é nǝ mur amurí kǝla pě mala amǝ'pa tangna ɗàng.<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 25:35-38">Pǝris 25:35-38</ref>; <ref loc="DEU 15:7-11">Nggur 15:7-11</ref>; <ref loc="DEU 23:19-20">23:19-20</ref></char>.</note> <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" />Ɓǝ̀ a ak nggubyau kùmsǝó mala ɓio mǝ'murkala a kún kǝgir mǝnana ak a buo ka, dumǝna púp, kaniama pwari nǝ̀ kpa ka, awu nǝ nyesǝi wi, <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />acemǝnana nǝ̀ gandǝ do ama, mǝno nda kǝ nggubyau kùmsǝó male. Lang sǝ nǝ̀ nong'ntullo yi mǝnana gìr'kùmsǝó pa a buì raka? Ɓǝ̀ a nyesǝi wi raka, sǝ ɓǝ̀ ɓua abanam ngga, mǝ nǝ ok ɓua male acemǝnana mǝ nda mǝ'sǝn mǝsǝswatǝr.<verse eid="EXO 22:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="EXO 22:28" />&lt;&lt;Cè a na mǝɓane amur Ɓakuli, ko a tsǝk kuno arǝ mǝ'yálmúr wun ɗàng.<verse eid="EXO 22:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="EXO 22:29" />&lt;&lt;Cè a dǝndi arǝ pam ɓoro mala ɓǝlagir mǝdǝmbe mala ɓaban mô, ko mala mùr-anap mò, ko mala mùrú-olif mò, mǝnana a tita kàmbe ka ɗàng.</para>
  <para style="pi" vid="EXO 22:29">&lt;&lt;Amuna-dǝmba, amuna-burana ma'wun ngga, wun nǝ̀ pam mia. <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />Sǝ amuna-dǝmba jamne mala andá, andǝ anzur, andǝ ambul-pǝndǝa ma'wun ngga wun nǝ̀ pam mia. Ɓǝ̀ jamna muna girkusǝu pángŋǝ̀nà nongŋo tongno-nong-ɓari atà nggè ka, wun nǝ̀ pam mi aɓa tongno-nong-tàruià nongŋo.<verse eid="EXO 22:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="EXO 22:31" />&lt;&lt;Wun ngga wun nǝ̀ duk aɓwana mem mǝnana à tària ka. Wu kǝa li nyam girkusǝu mǝnana nyamɓawan wal-luí ka ɗang; wu túrì anvwa wì ɓǝà shè.<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">Pàk ɓashi mǝ'mǝsǝcaunì</para>
  <para style="pi">
    <verse number="1" style="v" sid="EXO 23:1" />&lt;&lt;Cè a mesǝ acau na'ongŋale mǝ'nyirnì ɗàng, sǝ cè a pu a nzǝm mǝɓealɓikea nǝ nakún nyir ɗang.<verse eid="EXO 23:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="EXO 23:2" />&lt;&lt;Kǝa pu atà bangula ɓwabundǝa ace pak gìr mǝnana mǝɓike na ka ɗàng. Ɓǝ̀ à tunǝo a nakún a ɓadǝm ɓashi ka, kǝa nakún nyir ace pu a nzǝm bangula ɓwabundǝa, wun nǝ̀ pūrǝ ɓashi a mgbasho ɗàng. <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" />Sǝ kǝa pu a nzǝm mǝ'tǝ̀r a ban ɓashi acemǝnana yì ka mǝ'tǝ̀r na ka ɗàng.<verse eid="EXO 23:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="EXO 23:4" />&lt;&lt;Ɓǝ̀ a yaki arǝ jamnda ko mǝdambǝriso mala ɓiomǝbura aban gya atà rǝì ka, bwali nyesǝî wi.<verse eid="EXO 23:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="EXO 23:5" />&lt;&lt;Ɓǝ̀ a sǝn mǝdambǝriso mala ɓwa, twalo gandǝì sǝ kpa ka, kǝa ɗeki ɗàng, bwalì wi kàm ɓǝ̀ lo, ko ɓǝ̀ ndo ama mǝtale kǝ ɓinǝmǝsǝo ka.<verse eid="EXO 23:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="EXO 23:6" />&lt;&lt;A pà wunǝ ɗeki kpata mǝsǝcau aɓa pàk ɓashi mala amǝ'tǝ̀r mò ɗàng. <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />Kǝa tsǝki kǝ ɓwa cau arǝì amur nyir ɗang. Kǝa kasǝ ɓashi-lú amur mǝ'kunpwasǝa ko mǝɓealɓoarna ɗang, acemǝnana ɓashi mem ngga nǝ̀ sulǝo amur ɓwa mǝnana pàk mǝno yì ɓealɓikea ka.<verse eid="EXO 23:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="EXO 23:8" />&lt;&lt;Cè a ak pàbunǝnzali ɗang, acemǝnana pàbunǝnzali ka, kǝ tsǝk ɓwa pà nǝ̀ falǝnǝ mǝsǝcau mǝnana kǝ sǝni a banfana ka ɗàng; sǝ ɗǝm ngga kǝ tsǝk amǝ'ɓashi ɓǝà pūrǝ ɓashi a mgbasho.<verse eid="EXO 23:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="EXO 23:9" />&lt;&lt;Wu kǝa nyesǝce ɓwa-kúnɗàngna ɓà, wu lǝmdǝì wi rǝcandǝa mala parban ɗang; wun nǝ nggearǝ wun ngga wu sùrǝ́nà mana nda do kǝla ɓwa-kúnɗàngna, acemǝnana ɗiɗyal ka wu nda ka amǝ'kúnɗàngna a nzali Masar.<verse eid="EXO 23:9" /></para>
  <para style="s">Anggurcau mala Sabbat andǝ Alamsan</para>
  <para style="pi">
    <verse number="10" style="v" sid="EXO 23:10" />&lt;&lt;Aɓalǝ apǝlǝa tongno-nong-mwashat ka, ɓealɓeale a ɓaban mô sǝ wu pwan gìr mǝnana ɓaban pusǝ ka. <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" />Sǝama a tongno-nong-ɓaria pǝlǝa ka, ɗeki ɓaban ɓǝ̀ usǝlǝo sǝ ɓǝ̀ nong búlí, sǝ kǝa pwan kǝgìr mǝnana gulo sǝ ɓǝl kàm aɓalǝi ka ɗàng; amǝ'tǝ̀r mǝnana aɓalǝ wun ngga, ɓǝà lì gìr mǝnana ɓǝ̀l a nkwalo ka; sǝ cili mǝnana à nyì ka, ɓǝ̀ anyam-bondo ɓǝà lì. Anggo sǝ awu nǝ pangnǝ aɓaban nggun-anap andǝ aɓaban nggun-olif mò.<verse eid="EXO 23:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="EXO 23:12" />&lt;&lt;Awu nǝ pàkki atúró mô aɓalǝ anongŋo tongno-nong-mwashat, sǝ tongno-nong-ɓaria pwari ka, awu nǝ usǝlǝì atúró mô; andá mô andǝ amǝdambǝriso mò gbal ka, ɓǝà usǝlǝo; kat andǝ aguro mô andǝ abǝri mǝnana à pàkkiyio túró ka, ɓǝ̀ rǝia pwalo.<verse eid="EXO 23:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="EXO 23:13" />&lt;&lt;Párkiro arǝ acau mǝnana Mim Yahweh ǝn banggo kat ka. Cè a pak hiwi aban kǝ ɓè ɓakuli ɗang; yàle ɓǝà kǝa ok lullǝia a kuno ɗàng.<verse eid="EXO 23:13" /></para>
  <para style="s">Alamsan mǝgulke tàrú</para>
  <para style="r">(<ref loc="EXO 34:18-26">Puro 34:18-26</ref>; <ref loc="LEV 23:1-44">Ace Apǝris 23:1-44</ref>; <ref loc="NUM 28:1-29:40">Ɓal 28:1--29:40</ref>; <ref loc="DEU 16:1-17">Ɓǝs Nggur 16:1-17</ref>)</para>
  <para style="pi">
    <verse number="14" style="v" sid="EXO 23:14" />&lt;&lt;A koya pǝlǝa ka, wun nǝ̀ pakkiɗire mala alamsan tàrú ace gusǝlǝ lullǝàm.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 34:23">Pur 34:23</ref>; <ref loc="DEU 16:16">Nggur 16:16</ref></char>.</note> <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" />Atà dǝmbe ka, wun nǝ̀ pàk Lamsan mala Bǝredi mǝnana Yis pà arǝì raka. Wu pè a njar mǝnana ǝn tsǝka wun nǝma ɓǝ̀ wu pè ka. Wun nǝ̀ twal anongŋo tongno-nong-ɓari a nzǝmarǝia mǝnana aɓalǝia ka, pà wu nǝ̀ shak bǝredi mǝnana à pè nǝ yis arǝì ka ɗàng. Koya pǝlǝa ka wun nǝ̀ nggǝ pak mǝnia yì lamsan ngga a pwari mǝnana ǝn kanì ka, aɓa zongŋo Abip, zongŋo mǝnana wu nyìngŋǝ̀nà Masar nǝi ka.</para>
  <para style="pi" vid="EXO 23:15">&lt;&lt;Kǝ ɓwa ɓǝ̀kǝa yiu a peri abanam nǝ ɓabui atarǝì ɗàng.<verse eid="EXO 23:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="EXO 23:16" />&lt;&lt;Ɓaria ka, wu pakkiɗire Lamsan mala Pwan Gìrɓaban;<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="fq" closed="false">Lamsan mala Pwan Gìrɓaban </char><char style="ft" closed="false">ngga à tunǝi ama &lt;&lt;Lamsan mala Alimo&gt;&gt; sǝ à súrǝì aɓa Kùrcau Mǝbǝshe ama Pentikos.</char></note> wu pè nǝ paɓoro mala aɓǝlagir mǝdǝmbe mala ɓeale mǝnana wu ɓeal a ɓaban ma'wun ngga.</para>
  <para style="pi" vid="EXO 23:16">&lt;&lt;A masǝlǝate ka, wu pakkiɗire Lamsan mala Pwan Gìrɓaban Kat-kat<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="fq" closed="false">Lamsan mala Pwan Gìrɓaban Kat-kat </char><char style="ft" closed="false">ka à tunǝi gbal ama &lt;&lt;Lamsan mala Do aɓalǝ Agumli.&gt;&gt; Nda lamsan mǝnana à kǝ pê nǝ kún ɓǝla mala agirɓaban, mǝnana amǝ'rya kǝ tsǝk agumli ace yál agirɓaban malea ka.</char></note> aban yinǝe a ɓala a masǝlǝata koya pǝlǝa.<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 34:22">Pur 34:22</ref>; <ref loc="LEV 23:39">Pǝris 23:39</ref>; <ref loc="DEU 16:13">Nggur 16:13</ref></char>.</note><verse eid="EXO 23:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="EXO 23:17" />&lt;&lt;Koya pǝlǝa, ɓǝ̀ apwari mala amǝnia yì alamsan kārǝ́ ka, aburana ma'wun kat ka, à nǝ̀ yiu púp ace peri a ɓadǝmbam, Mim Yahweh Ɓakuli.<verse eid="EXO 23:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EXO 23:18" />&lt;&lt;Wu kǝa pà nkila mala gir'nkila abanam nǝ bǝredi mǝnana à pè nǝ yis arǝì ka ɗàng. Sǝ mùrú-nyam girkusǝu mǝnana wu yinǝi à pàna gir'nkila nǝi ka, ɓǝ̀ kǝa nongŋo ban ɓǝ kwarí ɗàng.<verse eid="EXO 23:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="EXO 23:19" />&lt;&lt;Koya pǝlǝa ka, awu nǝ yinǝ banboàrné mala aɓǝlagir mǝdǝmbe mala ɓaban mô a ɓala mala Yahweh Ɓakuli mô.</para>
  <para style="pi" vid="EXO 23:19">&lt;&lt;Cè a lam muna-mbul nǝ kiura nggè ɗàng.&gt;&gt;<verse eid="EXO 23:19" /></para>
  <para style="s">Apacau andǝ akwarkiru</para>
  <para style="sp">Yahweh lidǝmba nǝ bangcau ama:</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />&lt;&lt;Mǝ ndo mǝ nǝ tasǝ mǝturonjar a dǝm wun ɓǝ̀ yál wun a njar aban ká, sǝ ɓǝ̀ kyan nǝ wun a ban mǝnana ǝn gilǝkice ace wun ngga. <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />Wu kwakikir wun arǝì sǝ wu kpata akwarkiru male. Wu kǝa mgbiki wi cau ɗàng, acemǝnana mǝ nda ǝn tasǝi ka, sǝ yì ka pà nǝ̀ twalban mgbikiru ɗang. <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />Sǝ ɓǝ̀ wun nǝ̀ kwakikir wun pepè, wun nǝ̀ kpata gì, sǝ wun nǝ̀ pàk gìr mǝnana kat ǝn bang ngga, mǝ nǝ duk ɓibura mala aɓiwun amǝbura, sǝ mǝ nǝ ɓinǝmǝsǝ amǝ ɓinǝmǝsǝ wun. <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />Mǝturonjar mem nǝ̀ ká a dǝm wun, sǝ nǝ̀ kánǝ wun a nzali mala amǝ'Amor, andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Kan'ana, andǝ amǝ'Hivi, andǝ amǝ'Jebus, ace mǝnana ɓǝ̀ wu kya duk kam ngga. Mǝ nǝ twaltea kat-kat. <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />Wu kǝa ɓunno a nzali a ɓadǝm aɓakuli malea, ko wun nǝ̀ peri abania ɗàng. Wu kǝa kpata anjar mala pàkki agir kúncau malea ɗàng. Wu kìɗìki aɓakuli malea kat, wu arki akúnamúrú malea.<verse eid="EXO 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 23:25" />&lt;&lt;Kǝ Mim Yahweh Ɓakuli ma'wun, nda wun nǝ̀ peri abanam ngga! Mǝ nǝ tsǝka wun bù arǝ girlina ma'wun andǝ mùr-nùná ma'wun, sǝ mǝ nǝ twalban rǝkwana aɓalǝ wun. <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />Muna pà nǝ̀ sulǝo arǝ kǝ ɓwama, ko à nǝ̀ kum nkombi aɓa nzali ma'wun ɗàng. Mǝ nǝ pà wun sauwa mala yilǝmu andǝ lùmsǝó male.<verse eid="EXO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 23:27" />&lt;&lt;Mǝ nǝ tasǝ ɓangciu mem a ɓadǝm wun, sǝ aɓwana mǝnana wun nǝ̀ kùtí a nzali malea ka, mǝ nǝ yinǝ zùrǝki aɓalǝia. Mǝ nǝ tsǝk aɓiwun amǝbura ɓǝà pǝlǝà wun nzǝmia nǝ mire. <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />Mǝ nǝ tasǝ amǝ'ta-nta a ɓadǝm wun mǝnana à nǝ̀ pǝr amǝ'Hivi, andǝ amǝ'Kan'ana, andǝ amǝ'Hitti, aɓa ká ma'wun ngga. <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />Pà mǝ nǝ pǝria aɓa pǝlǝa mwashat ɗang, ɓǝ̀ ana raka nzali nǝ nong atarǝì, anyamɓawan nǝ̀ hatǝki, à nǝ̀ pǝlǝà wun gìr ɓangciu. <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />Bǝti-bǝti sǝ mǝ nǝ nggǝ pǝria, sheɓǝ̀ wu làkkìna wu akina nzali ka. <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />Mǝ nǝ tsǝk nzong-nzali ma'wun nǝ̀ twal a Nggeamùr mala Nzuno aban ká Nggeamùr mala amǝ Filisti, sǝ nǝ̀ twal a pǝɗanban aban ká Nggeasala Yiufǝretis. Mǝ nǝ pà wun rǝcandǝa amur aɓwapǝndǝa mǝnana à do a nzali mǝno ka, sǝ wun nǝ̀ pǝria a ɓadǝm wun. <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />Wu kǝa kùr kǝ cau wunǝia, ko nǝ aɓakuli malea ɗàng. <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />Wu kǝa ɗekia ɓǝà do a nzali ma'wun ɗàng; ɓǝ̀ wu ɗekia ka, à nǝ̀ dupa wun nggea gbǝ́lî mǝnana nǝ̀ tsǝk wun, wun nǝ̀ pàkkam cauɓikea, sǝ wun nǝ̀ peri aban aɓakuli malea ka.&gt;&gt;<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">Amǝ Isǝrayila ak Kùrcau mala Mǝtalabangŋo</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />Yahweh banggi Musa ama, &lt;&lt;Yiu abanam amur nkono, we wunǝ Haruna, andǝ Nadap, andǝ Abihu, sǝ aɓwana-mǝgule lumi-tongno-nong-ɓari mala amǝ Isǝrayila. Ɓǝ̀ wu nda aban yiu zak ka, wu ɓunno a nzali aɓa peri abanam. <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />We nǝmurǝo ɓǝ̀rɓǝ̀r, na a nǝ yiu awu nǝ gbashì banam tù ka. Cili aɓwana ka, ɓǝà cam zak. Acili amǝ Isǝrayila ka ɓǝà kǝa na ama à nǝ̀ eauwe a nkono ɗàng.&gt;&gt;<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />Lang Musa wario kya nea aɓwana acau mala Yahweh kat, andǝ anggurcaunì ka, aɓwana ak cau gǝu ama, &lt;&lt;Sǝm nǝ̀ kpata koya cau mana Yahweh na ka.&gt;&gt; <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" />Pǝlǝa Musa gilǝ acau mala Yahweh kat. Ban nǝ fa nǝ dǝmbari ɗiɗyal ka, lo ɓak gyangŋan a kusǝ nkono, sǝ loasǝ akúnamúrú lum-nong-ɓari, mǝnana koya tali mwashat ka kǝ cam a kúnì koya tàu lum-nong-ɓari mala amǝ Isǝrayila ka. <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />Pǝlǝa tasǝ alaggana mala amǝ Isǝrayila, à kya pākiagir mala pisǝe kǝring, sǝ à pà gir'nkila nǝ ajamnda ace apagir mala dotarǝu aban Yahweh. <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />Musa twal gauwa-tsùrú mala nkila mala agirkusǝu mǝnana à ɗārǝia ka, solǝi aɓalǝ ankenye, sǝ cili ka watsǝki amur gyangŋan.<verse eid="EXO 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 24:7" />Pǝlǝa twal Malǝmce Kùrcau sǝ ɓallì aɓwana wi ɓǝà oè. Sǝ aɓwana pà eare ama, &lt;&lt;Sǝm nǝ̀ kpata cau mǝnana kat Yahweh na ka, sǝm nǝ̀ oki wi.&gt;&gt;<verse eid="EXO 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 24:8" />Musa pǝlǝa twal nkila mana aɓalǝ ankenye ka, sǝ watsǝki aɓwana arǝia, sǝ bang ama, &lt;&lt;Wu sǝni, kùrcau mǝnana Yahweh pang nǝ wun, mana pà wun amǝnia yì anzongcau ka, ndya kǝ kùrrì nǝ nkila mǝnia ka.&gt;&gt;<verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />Musa andǝ Haruna, andǝ Nadap, andǝ Abihu, sǝ aɓwana-mǝgule lumi-tongno-nong-ɓari mala amǝ Isǝrayila, à eauwe amur nkono, <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />sǝ à sǝn Ɓakuli mala amǝ Isǝrayila. Aɓata akusǝi ka, ɓè kǝgìr kǝla múrbân mala tali-gǝna mala safir; kwár gǝraɗau kǝla ɓamǝsǝ kuli. <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />Kat andǝ amani ama amǝnia yi aɓwana-mǝgule mala amǝ Isǝrayila sǝn Ɓakuli ka, loasǝ buì arǝia ɗàng. Yàle à lìli sǝ à nugìr atārǝia a ɓadǝmbi.<verse eid="EXO 24:11" /></para>
  <para style="s">Musa amur Nkono Saina</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />Yahweh banggi Musa ama, &lt;&lt;Eauwe yiu abanam amur nkono sǝ wu duk kani. Mǝ nǝ po akpamgbǝlang tali ɓari mǝnana ǝn gilǝ nggurcau andǝ anzongcau mem amuria ace mǝnana wu kanì aɓwana mem ngga.&gt;&gt; <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />Nda Musa lo atārǝia andǝ Jesǝwa mǝbwali wi túró, sǝ Musa eauwe o amur nkono mala Ɓakuli. <figure style="fig" alt="Moses with two tablet stones" file="CO00835B.TIF" size="col" loc="24:13" copy="Cook OT Images" ref="24:12-13">Musa nǝ akpamgbǝlang tali ɓari </figure><verse eid="EXO 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 24:14" />Musa ka angŋa dǝmba bangŋǝ́nì aɓwana-mǝgule ama, &lt;&lt;Wu kundǝ sǝm a ban mǝnia ka sheɓǝ̀ sǝm nyarna aban wun ngga. Haruna andǝ Hur ka à ndya kani atà wun ngga. Ɓwa mǝnana kat ndanǝ ɓekǝ cau wuliban, anzǝm mǝnana sǝm umǝna ka, ɓǝ̀ kyan nǝ cê a bania.&gt;&gt;<verse eid="EXO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15" />Pǝlǝa Musa eauwe o a kùli amur Nkono Saina, kara pǝrɓang yi gir múr nkono. <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />Tǎlaban mǝɓoarɓwe mala Yahweh yi sulǝo amur Nkono Saina, sǝ pǝrɓang gìr múrí anongŋo tongno-nong-mwashat. A tongno-nong-ɓaria pwari ka, Yahweh tunǝ Musa nǝ ɓá pǝrɓang. <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />A ban amǝ Isǝrayila a kusǝ nkono ka, à sǝn tǎ mala ɓoarɓwa mala Yahweh ka nda kǝla bǝsa mǝ'earke mǝnana kǝ lì gìr ka, a ɓong nkono <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" />Pǝlǝa Musa eau aban ká amur nkono sǝ kya kútí aɓa pǝrɓang. Akanó sǝ kya do pàk pwari lumi-ine andǝ du lumi-ine.<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">Pāki aɓoro ace Tara Mǝfele</para>
  <para style="r">(<ref loc="EXO 35:4-9">Puro 35:4-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />Yahweh banggi Musa ama, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />&lt;&lt;Ne amǝ Isǝrayila ama ɓǝà yinǝ aɓoro ɓǝà yi pa abanam. Ak gìr mǝnana ɓwa twalo a ɓabumi sǝ yinǝi nǝ̀ pà acem ngga. <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />Amǝnia ka à nda ka aɓoro mǝnana awu nǝ ak a buia ka:</para>
  <para style="li" vid="EXO 25:3">bolo-njengǝlan, bolo-azǝrfa, andǝ bolo-bángŋá;<verse eid="EXO 25:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="EXO 25:4" />nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe;</para>
  <para style="li" vid="EXO 25:4">nkonggúr-linǝn mǝɓǝlke mana à pyauwì ka, andǝ nggubyau nyang-mbulpǝndǝa;<verse eid="EXO 25:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="EXO 25:5" />nggú gam mǝnana à bàngsǝí ka;</para>
  <para style="li" vid="EXO 25:5">nggú mǝɓǝlke mala ambulpǝndǝa;</para>
  <para style="li" vid="EXO 25:5">kpamgbang mala nggun-akasiya;<verse eid="EXO 25:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="EXO 25:6" />mùrú olif ace tsǝk bǝsa arǝ pitǝla;</para>
  <para style="li" vid="EXO 25:6">amuku-gìr mǝ'kuskushi mǝnana à nǝ̀ kpapi andǝ mùrú olif ace ɗārǝâ, sǝ ace kpapè andǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka;<verse eid="EXO 25:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="EXO 25:7" />amunatali-onis,<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="fq" closed="false">amunatali-onis </char><char style="ft" closed="false">ka à nda ka amunatali-pwasǝa mǝɓoarsǝne.</char></note> andǝ amǝsǝtali-gǝna ace gilǝkice rǝ efot<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="fq" closed="false">efot </char><char style="ft" closed="false">ka nda muna daura-múrɓì mǝfele mala Pǝris Mǝgule.</char></note> andǝ lǝpan-damɓalǝu male.<verse eid="EXO 25:7" /></para>
  <para style="s">Ɓakuli bang ama nǝ̀ do aɓalǝ amǝ Isǝrayila</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 25:8" />&lt;&lt;Tsǝk amǝ Isǝrayila ɓǝà pàk Tara-mǝfele acem, ace mǝnana ɓǝ̀ ǝn do aɓalǝia ka. <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />Pàk mǝnia yì Tara-mǝfele ka andǝ agir ɓālǝi kat aɓa kpate a nzongni gǝ̀rgǝ̀r, kǝla karikè mala Taragula mǝnana mǝ nǝ lǝmdǝò ka.<verse eid="EXO 25:9" /></para>
  <para style="s">Akwati Kùrcau</para>
  <para style="r">(<ref loc="EXO 37:1-9">Puro 37:1-9</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />&lt;&lt;Tsǝk aɓwana ɓǝà gbàllì Akwati Kùrcau nǝ kpamgbang mala nggun-akasiya. Sauwa male ɓǝ̀ pàk ɓakusǝu tàrú nǝ incì tongno-nong-ine, tangŋa male ɓǝ̀ pàk ɓakusǝu ɓari nǝ incì tàrú, sǝ dāh'rya male ɓǝ̀ pàk ɓakusǝu ɓari nǝ incì tàrú. <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />Gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne, ɓālǝi andǝ nzǝmi; ɓak bolo-njengǝlan ɓǝ̀ kàrì kúni kat. <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />Tùl agbalmò ine mala bolo-njengǝlan aceì, sǝ kpapì mwashat arǝ nkanggariban mala koya kusǝ akwati. <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />Shàr agara mala nggun-akasiya, sǝ wu gir rǝia kat nǝ bolo-njengǝlan. <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />Oasǝ agare aɓalǝ agbalmò arǝ ankanggariban mala akwati ace twale. <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />Amǝnia yì agara ace twal akwati ka ɓǝà ɗekia kàm aɓalǝ agbalmò arǝ akwati; ɓǝà kǝa pusǝia ɗàng. <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />Awu nǝ tsǝk Acau-nakûn<note caller="+" style="f"><char style="fr" closed="false">25:16 </char><char style="fq" closed="false">Acau-nakûn </char><char style="ft" closed="false">ngga à nda ka akpamgbǝlang tali ɓari mǝnana à gilǝ anzongcau mala kùrcau amúrià ka. Amǝnia yì akpamgbǝlang tali ɓari, mǝnana à nda aɓa Akwati Kùrcau ka, à tunǝia ama Acau-nakûn; à nda ka acau-nakûn mala kùrcau mǝnana à gilǝia ka, yì acau mala kùrcau a nre Ɓakuli andǝ aɓwana male</char></note> mǝnana mǝ nǝ po ka aɓa mǝnia yì akwati ka.<verse eid="EXO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />&lt;&lt;Awu nǝ pàkkî Akwati gìrkúni male, mǝnana nda buno sǝntǝ̀r <note caller="+" style="f"><char style="fr" closed="false">25:17 </char><char style="fq" closed="false">buno sǝntǝ̀r </char><char style="ft" closed="false">ka nda ban pa gìr ace twalban cauɓikea; ban watsǝki nkila a kusǝ buno-murǝm mala Ɓakuli, yì ban mǝnana Ɓakuli nǝ̀ gìr múr cauɓikea, ko nǝ̀ twalban cauɓikea mala aɓwana ka.</char></note> ka, nǝ bolo-njengǝlan mǝɓoarne kat. Sauwa male ɓǝ̀ pàk ɓakusǝu tàrú nǝ incì tongno-nong-ine, tangŋa male ɓǝ̀ pàk ɓakusǝu ɓari nǝ incì tàrú. <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />Awu nǝ tùl aɓǝ̀nzál mala acerup ɓari nǝ bolo-njengǝlan mǝnana à walki ka, ɓǝà came arǝ akún-bân ɓari amur gìrkúni, mǝnana nda buno sǝntǝ̀r ka. <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />Tsǝk ɓè cerup ɓǝ̀ came a ɓè kún-bân amur gìrkún Akwati sǝ ɓè cerup ka tsǝì a nkāɓe ɓì a kún-bân. Bolo-njengǝlan mǝnana à nǝ̀ peǎ nǝi ka ɓǝ̀ kpapi arǝ bolo-njengǝlan mǝnana à nǝ̀ pàngŋǝ̀nà gìrkún Akwati nǝi ka, ace mǝnana ɓǝà duk mwashat. <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />Acerup ka tsǝia, komǝye ka ɓamǝsǝi ɓǝ̀ pǝlǝ nǝban ɓamǝsǝ ɓi. Ɓamǝsǝia ɓǝà kǝ sǝn múr gìrkún Akwati, sǝ abuia mǝnana à mǝn a kùli ka ɓǝà kùmsǝó amur gìrkún Akwati, yì buno sǝntǝ̀r. <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />Acau-nakûn<note caller="+" style="f"><char style="fr" closed="false">25:21 </char><char style="fq" closed="false">Acau-nakûn </char><char style="ft" closed="false">yì akpamgbǝlang-tali ɓari mǝnana à nyoulǝ anzongcau mala kùrcau amúrià ka</char></note> mǝnana mǝ nǝ pò ka, awu nǝ tsǝia aɓa Akwati, sǝ awu nǝ kùmsǝ̀ gìrkún Akwati amúrià. <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />Mǝ nǝ nggǝ je sǝnǝ we kano, a nre ka ɓǝ̀nzál acerup ɓari, mǝnana à nda amur gìrkún Akwati,<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="fq" closed="false">Akwati </char><char style="ft" closed="false">kùrcau mǝnana à tsǝk akpamgbǝlang-tali ɓari mana à nyoulǝ anzongcau mala kùrcau amúrià ka.</char></note> yì buno sǝntǝ̀r ka, sǝ mǝ nǝ banggo cau nǝ kuli, acau mala nzongcau mana kat ǝn nggǝ pò ace amǝ Isǝrayila ka. <figure style="fig" alt="The Art of the Convenant" file="co00992b.TIF" size="col" loc="25:22" copy="Cook OT Images" ref="25:10-22">Akwati Kùrcau</figure><verse eid="EXO 25:22" /></para>
  <para style="s">Kpamgbang ace tsǝk Bǝredi</para>
  <para style="r">(<ref loc="EXO 37:10-16">Puro 37:10-16</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />&lt;&lt;Awu nǝ gballì kpamgbang mala nggun-akasiya, ace tsǝk agir amurí; sauwa male ɓǝ̀ pàk ɓakusǝu tàrú, tangŋa male ɓǝ̀ pàk ɓakusǝu mwashat nǝ incì tongno-nong-mwashat, sǝ dāh'rya male ka ɓǝ̀ pàk ɓakusǝu ɓari nǝ incì tàrú. <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />Awu nǝ gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne, sǝ a nǝ ɓak kúní ɓǝ̀ kàrì nǝ bolo-njengǝlan. <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />Múr kpamgbang mana sárǝ́ ka, awu nǝ pàkki wi mǝ-nzong mǝnana nyane male ka incì tàrú na ka ɓǝ̀ kàrì kúní kat, sǝ wu ɓak bolo-njengǝlan ɓǝ̀ kàrì mǝ-nzong nì. <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />Awu nǝ tùl agbalmò ine nǝ bolo-njengǝlan aceì, sǝ awu nǝ kpapia arǝ abankara male ine, arǝ akusǝi ine. <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />Agbalmò mǝnia mana à nda ace bwal agara mǝnana à nǝ̀ nggǝ twalna kpamgbang-tsǝk-agir nǝia ka, tsǝia arǝ akusǝ kpamgbang ɓǝà gbashì ban nzong kúni. <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />Awu nǝ pàk agara twal kpamgbang-tsǝk-agir nǝ nggun-akasiya, sǝ awu nǝ gìr rǝia kat nǝ bolo-njengǝlan. <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />Awu nǝ pàk aparanti male, andǝ atasau male ace pisǝ muku-gìr mǝrǝmɓoarne, andǝ amuna-nkenye male, andǝ amuna-bàng male ace solǝ pàgir mala girnùná; awu ne pea nǝ bolo-njengǝlan mǝɓoarne. <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" />Awu nǝ tsǝk Bǝredi mala Ɓadǝm Yahweh, mǝnana à pànà ɓoro nǝi abanam ngga amur kpamgbang-tsǝk-agir a ɓadǝmbam koya pwari.<verse eid="EXO 25:30" /></para>
  <para style="s">Gìr-tàmsǝ apitǝla</para>
  <para style="r">(<ref loc="EXO 37:17-24">Puro 37:17-24</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />&lt;&lt;Awu nǝ pàk gìr-tàmsǝ apitǝla nǝ bolo-njengǝlan mǝɓoarne. Kusǝ gìr-tàmsǝ apitǝla, andǝ garè mǝnana cam a ɓaɓalǝu, andǝ nyoulǝa rǝi mǝnana kǝla tǒ mala fufe nǝ pwasǝe andǝ tǝ́r-fufe ka, awu nǝ̀ pè kat nǝ gumtǝli bolo-njengǝlan mwashat mǝnana à walki ka. <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />Pàk garè ɓǝ̀ pàngnǝ abui tongno-nong-mwashat mǝnana à san arǝ ankanggari ka; tàrú a nkanggari man sǝ tàrú a ɓè nkanggari. <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />Komǝye atà abui tongno-nong-mwashat ka, ɓak rǝì ɓǝ̀ lǝmdǝ nyoulǝa tǒ mala afufe tàrú mala nggun-almon, sǝ koya fufe ka ɓǝ̀ pàngnǝ pwasǝe andǝ tǝ́r-fufe male. <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />Ɓak rǝ gìr-tàmsǝ apitǝla ɓǝ̀ lǝmdǝ nyoulǝa mala afufe ine mala nggun-almon nǝ apwasǝe andǝ atǝ́r-fufe malea. <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />Nyoulǝa tǝ́r-fufe mwashat ka nǝ̀ pà a ban-kpapí mala ɓari atà abu gìr-tàmsǝ apitǝla; ɓaria nyoulǝa tǝ́r-fufe ka nǝ̀ pa a ban-kpapí mala aɓea abui ɓari, sǝ tàruià nyoulǝa tǝ́r-fufe ka nǝ̀ pa a ban-kpapí mala masǝlǝata abui ɓari, mǝnana yià kat à sana arǝ gara gìr tàmsǝ apitǝla ka; anggo sǝ gìr tàmsǝ apitǝla ka nǝ̀ pàngnǝ abui tongno-nong-mwashat mǝnana à san arǝ garè ka. <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />Yì gìr-tàmsǝ apitǝla andǝ nyoulǝa rǝi mala afufe andǝ apwasǝe andǝ atǝ́r-fufe ka, à nǝ̀ pea kat nǝ gumtǝli bolo-njengǝlan mǝɓoarne mwashat mǝnana à walki ka.<verse eid="EXO 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 25:37" />&lt;&lt;Awu nǝ pàk apitǝla tongno-nong-ɓari ace gìr tàmsǝ apitǝla, sǝ wu tamsǝkia [amur garè andǝ abui tongno-nong-mwashat], ace mǝnana ɓǝà pa tǎlaban a banfana mana a ɓadǝmbi ka. <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />Amǝmyal (mala kǝtǝriki tú kún bùgìr-bǝsa) andǝ atasau-bǝsa ka, ɓǝà peǎ nǝ bolo-njengǝlan mǝɓoarne. <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />Pàktúró nǝ bolo-njengǝlan mǝɓoarne mǝnana dǝmbǝrya male ka tyang lumi-tàrú-bwamdǝ-tongno [35] na ka sǝ wu pàk gìr tàmsǝ apitǝla andǝ agirtúró male kat.<verse eid="EXO 25:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 25:40" />&lt;&lt;Tsǝkiro wu pak agir man kat aɓa kpate a nzongni kǝla mǝnana ǝn lǝmdǝò amur nkono ka.<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">Taragula mala Yahweh</para>
  <para style="r">(<ref loc="EXO 36:8-38">Puro 36:8-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />&lt;&lt;Sǝ Taragula mǝnana awu nǝ pàk ka, pàk ɓālǝi nǝ alagìr lum mǝnana à teǎ nǝ nkonggúr-linǝn mana à pyauwì ka andǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe. Mǝ'sǝlǝ pakkiagir ɓǝ̀ peǎ sǝ ɓǝ̀ tà pǎ mala acerup ɓǝà lǝmdǝa arǝia. <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />Amǝnia yì alagìr lum ngga, ɓǝà kārǝa; sauwa malea ɓǝ̀ pàk ɓakusǝu lumi-ine nǝ mǝsǝi ɓari, sǝ tangŋa malea ka ɓǝ̀ pàk ɓakusǝu tongno-nong-mwashat. <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />Tongno atà alagìr mǝnia ka, awu nǝ kpapia sǝ awu nǝ swària a kunarǝia ɓǝà duk lagìr mǝsauwe mwashat. Anggo gbal sǝ awu nǝ pangnǝ acilia mǝno tongno ka. <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />Awu nǝ pakkì atǝkrǝk nǝ nkonggúr ɗà'ndíng mǝlùre, sǝ awu nǝ ɗúrkia a nkanggari arǝia a gírí-kún komǝye atà alagìr mǝsake mǝno ka. <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />Awu nǝ ɗúrki atǝkrǝk nkonggúr lumi-tongno a gírí-kún mwashat atà alagìr amǝsake mǝno ka; anggo gbal ɓè man mwashat ka ɗúrkì wi atǝkrǝk nkonggúr male lumi-tongno mǝnana à nǝ̀ cam a nkāɓe gǝ̀rgǝ̀r andǝ amǝno à ɗúrkia arǝ gírí-kún lagìr mǝdǝmbe ka. <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />Awu nǝ pàk anlǐ-bwalkúngir lumi-tongno nǝ bolo-njengǝlan. Bwalki atǝkrǝk gírí-kún lagìr mǝsauwe man mwashat ka, wu kpapia a kúnarǝ atǝkrǝk gírí-kún ɓe lagìr mǝsauwe mǝno ka nǝ anlǐ-bwalkúngir, ace mǝnana yì alagìr mǝsake ka ɓǝà duk mwashat. Anggo sǝ nǝ̀ do ama Taragula ka, lagìr mwashat na à pè nǝi ka.<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />&lt;&lt;Awu nǝ pàk alagìr-nggû nǝ anggu-mbulpǝndǝa lum-nong-mwashat ace kùmsǝ múr Taragula. <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />Amǝnia yì anggu-mbulpǝndǝa lum-nong-mwashat ka ɓǝà kārǝa; sauwa mala komǝye ka ɓǝ̀ pàk ɓakusǝu lumi-ine bwamdǝ tongno, sǝ tangŋa mala komǝye ka ɓǝ̀ pàk ɓakusǝu tongno-nong-mwashat. <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />Tongno ateà ka awu nǝ kpapia sǝ awu nǝ swària a kunarǝia ɓǝà duk lagìr-nggû mǝsauwe mwashat, sǝ aman tongno-nong-mwashat ka swària gbal a kunarǝia ɓǝà duk ɓaria lagìr-nggû mǝsauwe mwashat. Tongno-nong-mwashatia nggu-mbulpǝndǝa mǝnana masǝlǝì aɓî a kún lagìr-nggû mǝnia ka, kàrrì aɓalǝarǝia ɓari ɓǝ̀ gyare a ɓadǝm Tara-mǝfele. <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />Awu nǝ ɗúrki atǝkrǝk nkonggúr lumi-tongno a nkanggari arǝia a gírí-kún komǝye atà alagìr-nggû amǝsake mǝnia ka. <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />Awu nǝ pàk anlǐ-bwalkúngir nǝ bolo-bángŋá, yia lumi-tongno. Awu nǝ oasǝkia aɓalǝ atǝkrǝk gírí-kún alagìr-nggû amǝsake mǝnia ɓari ka, sǝ awu nǝ kpapia a kúnarǝia ɓǝà duk lagìr-nggû nggea mǝgule mwashat, ace mǝnana ɓǝà gìrna múr Tara-mǝfele nǝi ka. <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />Cili lagìr-nggû mǝnana ueo sǝ à lǝpì ka, ɓǝà nyesǝi ɓǝ̀ gyare a nzǝm Taragula. <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />Cili sauwa mala lagìr-nggû, ɓakusǝu mwashat nǝ incì tongno-nong-mwashat mǝnana ueo sǝ sùlǝî múr Taragula a koya bumban male ka, nyia ɓǝa gyare arǝ abumban, ace mǝnana ɓǝà gìr múr Taragula kat-kat.<verse eid="EXO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 26:14" />&lt;&lt;Awu nǝ pàk aɓea lagìr-nggû kàm ɓari ɗǝm ace kùmsǝ múr Taragula. Man mwashat ka pè nǝ nggú ka gam mǝnana à bangsǝi ka, sǝ ɓè man, mǝnana nǝ̀ masǝlǝi aɓî nǝ̀ sarǝa amúrià a kùli ka, pè nǝ nggú mǝɓǝlke mala ambulpǝndǝa.<verse eid="EXO 26:14" /></para>
  <para style="s">Anggun mala Taragula</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />&lt;&lt;Awu nǝ̀ pàk anggun-tara ace Taragula nǝ akpamgbang mala nggun-akasiya mǝnana à sárǝ́ pǝrapǝra ka. <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />Koya nggun-tara ka dāh'rya male ɓǝ̀ duk ɓakusǝu lum-bwamdǝ-tongno, sǝ tangŋa male ka, ɓǝ̀ duk ɓakusǝu ɓari nǝ incì tàrú. <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />Akpamgbang ɓari nǝ kúnià kǝla ankpako na awu nǝ kpapia a nkanggari rǝarǝia ɓǝà pàk nggun-tara mwashat ka. Anggo sǝ awu nǝ pàk anggun-tara mala Taragula kat. <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />Awu nǝ pàk anggun-tara lumi-ɓari ace bumban mala Taragula mǝnana sǝn njar-kunmur ka. <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />Awu nǝ pàk agumtǝli-tǝrtà anggun-tara lumi-ine nǝ bolo-azǝrfa. Agumtǝli-tǝrtè ɓari, komǝye ka nǝ tūli male arǝì, à nǝ̀ pà aɓata koya nggun-tara, ace bwal akusǝ akpamgbang amǝ pyalpyalni ɓari mala nggun-tara. <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />A bumban mala Taragula mǝnana sǝn njar-nza ka, awu nǝ tsǝk anggun-tara lumi-ɓari, <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />aɓalǝ agumtǝli-tǝrteà mǝnana à pea nǝ bolo-azǝrfa ka lumi-ine, ɓari a kusǝ koya nggun-tara. <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />Sǝ a nzǝm Taragula, yì bumban male mǝnana sǝn njar-nzali ka, awu nǝ̀ tsǝk anggun-tara kam tongno-nong-mwashat. <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />Awu nǝ pàk aɓea nggun-tara ɓari ɗǝm ace koya bankara a nzǝm Taragula. <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />Anggun-tara ɓari-ɓari mǝnana à nǝ̀ cam a koya bankara a nzǝm Taragula ka, awu nǝ kpapi tǝrtea ɓǝà cam a ban mǝ'mwashati, sǝ múrià ka kùria nǝ gbalmo kàngkàng ɓǝà duk mwashat. Yì anggun-tara arǝ abankara mǝno ɓari ka anggo sǝ awu nǝ pangnǝia. <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />Lǝmdǝ ama ɓǝà kpapia kat ka, nzǝm Taragula nǝ̀ pangnǝ anggun-tara tongno-nong-tàrú aban came aɓalǝ agumtǝli-tǝrteà lum-bwamdǝ-tongno-nong-mwashat, mǝnana à peǎ nǝ bolo-azǝrfa ka; koya nggun-tara ka, kusǝi nǝ̀ pà aɓalǝ agumtǝli-tǝrtè ɓari.<verse eid="EXO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 26:26" />&lt;&lt;Awu nǝ pàk anggun-gangndea lum-bwamdǝ-tongno nǝ akpamgbang mala nggun-akasiya ace kpapiki anggun-tara. Tsǝk tongno ɓǝà kpapi anggun-tara mala Taragula a bumban male mǝnana sǝn njar-nza ka, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />tongno ɓǝà kpapi anggun-tara a bumban mala Taragula mǝnana sǝn njar-kunmur ka, sǝ tongno ka ɓǝà kpapi anggun-tara a bumban mala Taragula a nzǝmi, yì bumban mǝnana sǝn njar-nzali ka. <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />Nggun-gangndea mǝnana nǝ̀ gangndǝi a tsùrú mala anggun-tara ka, nǝ̀ tite arǝ nggun-tara mǝnana nda a masǝlǝata kún-bân, sǝ nǝ̀ sarǝa aban ká ɓè masǝlǝata kún-bân mala Taragula ka. <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />Anggun-tara ka awu nǝ tasǝ rǝia nǝ bolo-njengǝlan, sǝ awu nǝ kùrkia wia agbalmò bolo-njengǝlan ace bwal anggun-gangndea mǝnana à nǝ̀ oasǝkia aɓalǝia ka. Yià anggun-gangndea ka awu nǝ tasǝ rǝia gbal nǝ bolo-njengǝlan. <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />Awu nǝ loasǝ mǝnia yì Taragula ka a pě mǝnana ǝn lǝmdǝo amúr nkono ka.&gt;&gt;<verse eid="EXO 26:30" /></para>
  <para style="s">Lagìr-kasǝbân aɓa Taragula</para>
  <para style="r">(<ref loc="EXO 36:35-38">Puro 36:35-38</ref>)</para>
  <para style="sp">Mǝtalabangŋo bang ama:</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />&lt;&lt;Awu nǝ pàk lagìr-kasǝbân nǝ nggubyau-linǝn ace gau ɓá Taragula. Mǝ'sǝlǝ pakkiagir ɓǝ̀ pàktúró nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe andǝ mala nkonggúr-linǝn mǝɓǝlke mana à pyauwì ka, ɓǝ̀ tagìr mala acerup ɓǝà lǝmdǝ arǝì. <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />Awu nǝ gyar mǝnia yì lagìr-kasǝbân ngga, nǝ anlǐ-gyargìr mala bolo-njengǝlan, a kún anggun-ɓalǝu ine mala kpamgbang-akasiya, mǝnana à tasǝ rǝia nǝ bolo-njengǝlan, sǝ à camgi aɓalǝ agumtǝli-tǝrteà mala bolo-azǝrfa ka. <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" />Awu nǝ bwalki kún lagìr-kasǝbân mǝnia ka nǝ anlǐ-bwalkúngir ɓǝ̀ gyare a kùli arǝ múr Taragula, sǝ awu nǝ tsǝk Akwati mala Acau-nakûn aɓalǝi nǝ nzǝm lagìr-kasǝbân, mǝnana gau Ban Mǝfele andǝ Ban Nggea Mǝfele ka. <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />Awu nǝ tsǝk gìrkún Akwati mala Acau-nakûn, mǝnana nda buno sǝntǝ̀r ka, amur Akwati Kùrcau sǝ awu nǝ tamsǝì aɓa Ban Nggea Mǝfele. <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />A nza nǝ Ban Nggea Mǝfele aɓa Taragula ka, awu nǝ tsǝk kpamgbang mala tsǝk bǝredi ɓǝ̀ cam a nkanggariban nǝ njar-nza; sǝ a nkāɓe male nǝ njar-kunmur ka, awu nǝ tsǝk gìr-tàmsǝ apitǝla.<verse eid="EXO 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 26:36" />&lt;&lt;Awu nǝ pàk lagìr-gbarban ace bankutio aɓa mǝno yì tara ka. Pè nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì ka. Mǝ'sǝlǝ tagìr nǝ bù ɓǝ̀ nbákí rǝì nǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe. <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />Awu nǝ pàk anggun-ɓalǝu nǝ kpamgbang-akasiya amǝsake tongno, sǝ awu nǝ tasǝ rǝia nǝ bolo-njengǝlan. Awu nǝ tamsǝ komǝye ka aɓa gumtǝli-tǝrtè mǝnana à pè nǝ bolo-bángŋá ka, sǝ awu nǝ gyar mǝnia yì lagìr-gbarban ngga arǝia nǝ anlǐ-gyargìr mala bolo-njengǝlan.<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">Gyangŋan pàgir mala pisǝe kǝring</para>
  <para style="r">(<ref loc="EXO 38:1-7">Puro 38:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />&lt;&lt;Awu nǝ pàk gyangŋan nǝ nggun-akasiya. Sauwa male nǝ̀ duk ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú, tangŋa male, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú, sǝ dāh'rya male ka ɓakusǝu ine nǝ gauwa-tsùrú. <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />Sǝ awu nǝ pàkki wi anjawe arǝ agirikúní ine. Yì gyangŋan andǝ anjawe ka shària nǝ nggun mǝmwashati, sǝ wu gir rǝi kat nǝ bolo-bángŋá. <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />Awu nǝ pàk ankwaring-bolo ace pwan tú male, andǝ ashebǝl, andǝ ankenye, andǝ ashokali-nyama, andǝ atasau-bǝsa. Amǝnia yì agirtúró kat ka, awu nǝ peǎ nǝ bolo-bángŋá. <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />Awu nǝ pàk bàndà nǝ waya mala bolo-bángŋá, sǝ awu nǝ̀ tsǝki wi agbalmò bolo-bángŋá ine arǝ abankara male a kúní ace bwale. <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />Awu nǝ tsǝk mǝno yì bàndà ka aɓa gyangŋan, a bumi nǝ ɓalǝu. <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />Awu nǝ pàk agara ɓari nǝ nggun-akasiya, sǝ wu gir rǝia nǝ bolo-bángŋá. <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />Komǝye ka oasǝi aɓalǝ atūli gbalmò ɓari a ban ankanggari gyangŋan, ace twale. <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />Yì gyangŋan ngga pè nǝ akpamgbang; nying ɓālǝi ɓǝ̀ nong horondong. Pè kǝla mǝnana à lǝmdǝò amur nkono ka.<verse eid="EXO 27:8" /></para>
  <para style="s">Patal mala Taragula</para>
  <para style="r">(<ref loc="EXO 38:9-20">Puro 38:9-20</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />&lt;&lt;Awu nǝ kasǝ patal ɓǝ̀ kàrì Taragula. A bumban male mana sǝn njar-kunmur ka, gyarki wi alagìr mǝnana à teǎ nǝ nkonggúr linǝn mǝɓǝlke mana à pyauwì ka; sauwa malea ɓǝ̀ pàk ɓakusǝu gbǝman-mwashat nǝ lumi-tongno (150), sǝ ɓǝà gyarki arǝ <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />anggun-kala male lumi-ɓari aban camge aɓalǝ agumtǝli-tǝrteà lumi-ɓari, mana à peǎ kat nǝ bolo-bángŋá ka; sǝ anggun-kala andǝ ankò malea, andǝ anlǐ-gyargìr mana à bwal alagìr ka, ɓǝà peǎ nǝ bolo-azǝrfa. <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />Anggo gbal, a bumban mǝnana sǝn njar-nza ka, à nǝ̀ gyarki alagìr mǝnana sauwa malea ka ɓakusǝu gbǝman-mwashat nǝ lumi-tongno na (150) ka, arǝ anggun-kala lumi-ɓari, aban camge aɓalǝ agumtǝli-tǝrteà, mǝnana yià kat ka, bolo-bángŋá na à peǎ nǝia ka. Anlǐ-gyargìr mana à bwal alagìr, arǝ anggun-kala andǝ ankò malea ka, ɓǝà peǎ nǝ bolo-azǝrfa.<verse eid="EXO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 27:12" />&lt;&lt;Bumban mala patal a buì mǝnana nǝ njar-nzali ka, awu nǝ gyarki alagìr mana sauwa malea ka, ɓakusǝu lumi-tongno-nong-ɓari bwamdǝ tongno (75) na ka, arǝ anggun-kala male lum mǝnana à camgi aɓalǝ agumtǝli-tǝrteà lum ngga. <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />Bumban mǝnana nǝ njar-takuli, ban kutio a patal mala Taragula ka, sauwa male gbal ka ɓǝ̀ pàk ɓakusǝu lumi-tongno-nong-ɓari bwamdǝ tongno. <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />Lagìr mǝnana nǝ̀ gyar a buì mǝlì mala kunɓala ka, tangŋa male ɓǝ̀ pàk ɓakusǝu lumi-ɓari-nong-ɓari nǝ gauwa-tsùrú, sǝ ɓǝ̀ gyare arǝ anggun-kala tàrú aban came aɓalǝ agumtǝli-tǝrteà tàrú. <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />Lagìr mǝnana nǝ̀ gyar a buì mǝ'nggare ka, tangŋa male ɓǝ̀ pàk ɓakusǝu lumi-ɓari nong-ɓari nǝ gauwa-tsùrú, sǝ ɓǝ̀ gyar arǝ anggun-kala tàrú aban came aɓalǝ agumtǝli-tǝrteà tàrú.<verse eid="EXO 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 27:16" />&lt;&lt;Bankutio aɓa patal ka, kumbi wi lagìr gbare mǝnana tangŋa male ka ɓǝ̀ pak ɓakusǝu lumi-tàrú. Ɓǝà tè nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì ka, sǝ ɓǝà nyoulǝ rǝi aɓa sǝlǝ tagìr mǝɓoarsǝne nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe. Gyari arǝ anggun-kala ine mǝnana à came aɓalǝ agumtǝli-tǝrteà ine ka. <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />Anggun-kala mǝnana kat à kàrì patal ka, ɓǝà camgi aɓalǝ agumtǝli-tǝrteà mala bolo-bángŋá. Gangndǝki agara bolo-azǝrfa amur anggun-kala kat sǝ wu kùrkia arǝarǝia. Tsǝkia wia anlǐ-gyargìr malea mǝnana à peǎ nǝ bolo-azǝrfa ka. <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />Yì patal kat ka, sauwa male ɓǝ̀ pak ɓakusǝu gbǝman nǝ lumi-tongno (150), sǝ tangŋa male ka ɓakusǝu lumi-tongno-nong-ɓari nǝ mǝsǝi tongno (75). Dāh'rya mala alagìr male mǝnana à nǝ̀ gìr ban ngga, ɓǝ̀ pàk ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú (7.5). Ɓǝà peǎ nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì ka. Agumtǝl-tǝrtà anggun-kala ka, ɓǝà peǎ nǝ bolo-bángŋá. <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />Agir mǝnana kat à nǝ̀ pàngŋǝ̀nà túró nǝia aɓa Taragula ace koya túró, andǝ ankpako male, andǝ ankpako mala anggun-kal patal ka, dumǝna púp à nǝ̀ peǎ nǝ bolo-bángŋá.<verse eid="EXO 27:19" /></para>
  <para style="s">Tsǝkir pitǝla</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />&lt;&lt;Banggi amǝ Isǝrayila ɓǝà yinǝo nǝ mùrú olif mǝɓoarne mǝnana à kambi nǝ kamba ka ace soe aɓa pitǝla, ace mǝnana abǝsa male ka ɓǝà kǝ earke koya pwari. <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />Haruna andǝ amuni, na à nǝ̀ tamsǝ pitǝla a ɓadǝmbam aɓa Tara Ban-peri, anzǝm lagìr-kasǝbân mǝnana gbàr Akwati mala Acau-nakûn ngga, sǝ à nǝ̀ nggǝ tsǝkir pitǝla ace mǝnana abǝsa male ɓǝà kǝ earke a ɓadǝmbam, twal a koya pwarikpǝra bà kwaro mala ban. Mǝnia yi nzongcau ka, dumǝna púp amǝ Isǝrayila andǝ amǝ'keà arǝ anza malea kat à nǝ̀ kpate.<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">Adaura mala apǝris</para>
  <para style="r">(<ref loc="EXO 39:1-7">Puro 39:1-7</ref>)</para>
  <para style="sp">Mǝtalabangŋo banggi Musa ama:</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />&lt;&lt;Túrban ɓǝ̀ mǝ'eambo Haruna andǝ amuna-burana male, Nadap, andǝ Abihu, andǝ Eleaza, sǝ Itamar atè, ɓǝà yiu a bano. Pusǝia a nggǝsanì aɓalǝ amǝ Isǝrayila. Tsǝia ɓǝà duk apǝris ace pakkam túrô.<verse eid="EXO 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 28:2" />&lt;&lt;Awu nǝ swàrî mǝ'eambo Haruna adaura mǝfele mala apǝris, amǝ'ɓoarɓwe andǝ amǝ'ɓoarsǝne. <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />Awu nǝ nacau ne aɓwana mǝnana kat amǝ'sǝlǝ pakkiagir na ka, aɓwana mǝnana ǝn pania wia sǝlǝe a ɓabumia ka, ɓǝà pakkî Haruna agir-nggūrǝu, ace tàre ɓǝ̀ duk pǝris aɓa túró mem.&gt;&gt; <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />Amǝnia ka à nda ka agir-nggūrǝu mǝnana à nǝ̀ swària ka: lǝpan-damɓalǝu, andǝ efot,<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="fq" closed="false">efot </char><char style="ft" closed="false">ka nda muna daura-múrɓì mǝfele.</char></note> andǝ daura-tsuru mǝsauwe mala efot, andǝ daura-ɓaɓalǝu mǝlime mǝnana à nyoulǝ rǝi nǝ tagìr mǝɓoarsǝne ka, andǝ nggubyau mbuɓi múrû, sǝ bugìr mārǝ́ taɓunu. Ɓǝà pàk amǝnia yì adaura mǝfele ka ace mǝ'eambo Haruna andǝ amuni amuna-burana, ace mǝnana ɓǝà nyesǝia ɓǝà duk apǝris ace pakkam túrô ka. <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />Amǝ'túró amǝ'sǝlǝ pakkiagir ɓǝà ak nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala bolo-njengǝlan, sǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì nǝ pyauwe ka, ace pàk adaura mǝno.<verse eid="EXO 28:5" /></para>
  <para style="s">Efot, muna daura-múrɓì mǝfele</para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />&lt;&lt;Muna daura-múrɓì mǝfele, yì efot ka mǝ'sǝlǝ pakkiagir ɓǝ̀ tè nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì nǝ pyauwe ka; ɓǝ̀ tà gìr mǝɓoarsǝne arǝì nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala bolo-njengǝlan. <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />Yì efot ka ɓǝà swàrí wi anggúr-nkpamtaru ɓari mǝnana à nǝ̀ kpapi ɓadǝmbi andǝ nzǝmi ka. <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />Bugìr mārǝ́ taɓunu ace kpapè arǝ efot ka, ɓǝà tè kǝla mala efot, nǝ ankonggúr mala bolo-njengǝlan, andǝ mala ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, sǝ nkonggúr linǝn mǝɓǝlke mana à pyauwì nǝ pyauweka, sǝ ɓǝà swàrì arǝ efot ace mǝnana ɓǝà duk mwashat ka.<verse eid="EXO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 28:9" />&lt;&lt;Twal amunatali-onis ɓari sǝ wu nyoulǝ lullǝ amuna-burana lum-nong-ɓari mala Isǝrayila amuria. <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />Nyoulǝ alullǝu tongno-nong-mwashat amur koya munatali-onis; tsaɗi alullǝia kǝla mǝnana à ɓǝlia ka. <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />Ɓǝà nyoulǝ amǝno yì alullǝ amuna-burana mala Isǝrayila ka, amur amunatali-onis mǝno ɓari, kǝla mǝnana mǝ'pàk-njengǝlan nǝ̀ nyoulǝ gir amur ɓamur gbalmo-parbù ka. Koya munatali-onis ka oasǝi aɓa tǝkrǝk-waya male mǝnana bolo-njengǝlan na ka, <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />sǝ wu dambia arǝ anggúr-nkpamtaru mala efot. À nǝ̀ duk atali ɗenyinǝban mala amuna-burana mala Isǝrayila. Haruna nǝ̀ nggǝ gyar alullǝia a myali a ɓadǝm Yahweh ace ɗenyinǝia. <verse eid="EXO 28:12" /><verse number="13" style="v" sid="EXO 28:13" />Awu nǝ pàk atǝkrǝk-waya mala bolo-njengǝlan ace amunatali-onis mǝno ɓari ka. <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />Pàk amuna-nsolo ɓamyalu nǝ bolo-njengǝlan mǝɓoarne; ɓolǝia ɓǝà pa kǝla nggur, sǝ wu kpapia arǝ atǝkrǝk waya bolo-njengǝlan mala amunatali-onis mǝno ɓari ka, ɓǝà gyare arǝia.<verse eid="EXO 28:14" /></para>
  <para style="s">Lǝpan damɓalǝu</para>
  <para style="r">(<ref loc="EXO 39:8-21">Puro 39:8-21</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />&lt;&lt;Awu nǝ pàk lǝpan-damɓalǝu ace súrǝ̀ nê mala Ɓakuli. Ɓǝà tè aɓa sǝlǝ tagìr ulang mala efot, nǝ ankonggúr bolo-njengǝlan, andǝ ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ linǝn mǝɓǝlke mana à pyauwì nǝ pyauwe ka. <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />Ɓǝà pè nǝ kasǝna lagìr mǝnana à kàrrì ɓari sǝ kúní lǝpi amur ɓè sǝ pàk lǝpan ngga. Sauwa male ɓǝ̀ pàk mwashat andǝ tangŋa male, incì tongno-nong-ine. <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />Awu nǝ gyari wi arǝ amuna tali-gǝna tàrú-tàrú a nzǝmarǝia arǝ asangbǝlang ine; a sangbǝlang mǝdǝmbe ka, ɓǝà lanzǝì wi atali-gǝna rubi, tofas, andǝ beril; <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />a ɓaria sangbǝlang ngga ɓǝà lanzǝì wi amuna tali-gǝna mala emeral, andǝ safir, andǝ daimon; <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />a tàruia sangbǝlang ngga ɓǝà lanzǝì wi amuna tali-gǝna jasinta, andǝ aget, andǝ amitis; <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />a inea sangbǝlang ngga ɓǝà lanzǝì wi amuna tali-gǝna kǝrisolat, andǝ onis, andǝ jaspa; komǝye ka ɓǝ̀ pa aɓa tǝkrǝk-waya bolo-njengǝlan mǝnana à ɓolǝì ka. <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />Yia kat ka amuna tali-gǝna lum-nong-ɓari na; komǝye ateà ka ɓǝà nyoulǝî wi mwashat atà alullǝ amuna-burana lum-nong-ɓari mala Yakupu amurí, ɓǝà cam a kúnì atau mala amǝ Isǝrayila. Ɓǝà nyoulǝ alullǝia kǝla mana à nǝ̀ nyoulǝ gir amur gbalmo parbu ka.<verse eid="EXO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 28:22" />&lt;&lt;Amuna-nsolo mǝno à peǎ nǝ bolo-njengǝlan sǝ à pyauwia kǝla nggur ka, à nda ace kùrre arǝ lǝpan-damɓalǝu. <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />Awu nǝ pàk agbalmò ɓari nǝ bolo-njengǝlan sǝ wu oasǝia arǝ lǝpan-damɓalǝu a ban akúní mǝnana à pǝlǝ nǝ kùli ka. <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />Awu nǝ kùr amuna-nsolo mǝno ɓari ka arǝ agbalmò mǝnia ɓari a kún bankara mala lǝpan-damɓalǝu ka. <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />Kún ansolo mǝno ɓari ka, awu nǝ kùria arǝ atǝkrǝk-waya mala amunatali-onis mǝno ɓari ka. Anggo sǝ lǝpan-damɓalǝu ka nǝ̀ gyare a ɓadǝmbu arǝ anggúr-nkpamtaru mala efot. <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />Awu nǝ pàk agbalmò bolo-njengǝlan ɓari sǝ awu nǝ oasǝia arǝ lǝpan-damɓalǝu a ban akúni mǝnana a nzali ka nǝ ɓalǝu, ɓǝà nong amur efot. <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />Awu nǝ pàk aɓea agbalmò bolo-njengǝlan ɓari ɗǝm, sǝ awu nǝ kpapia a kún anggúr-nkpamtaru mana à pǝlǝ nǝ nzali ka a ɓadǝm efot, tù a ban-kpapya male amur bugìr mārǝ́ taɓunu mǝ'nbaké mala efot. <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />Awu nǝ kùr agbalmò mala lǝpan-damɓalǝu arǝ agbalmò mala efot nǝ nggur mǝlùre, ace mǝnana lǝpan-damɓalǝu ka ɓǝ̀ nongŋo amur bugìr mārǝ́ taɓunu mǝ'nbaké mala efot, sǝ ace mǝnana ɓǝ̀ bwal kàngkàng arǝ efot ka.<verse eid="EXO 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 28:29" />&lt;&lt;Ɓǝ̀ Haruna nǝ̀ kùtí aɓa Ban Mǝfele ka, nǝ̀ oasǝ mǝnia yì lǝpan-damɓalǝu mala súrǝ̀ nê mala Ɓakuli, mana à nyoulǝî wi alullǝ atau mala amǝ Isǝrayila amurí ka a myali; ɓǝ̀ gyare a damɓalǝi, yì ban ɓabumi, ace mǝnana Mim, Yahweh ka, mǝ nǝ nggǝ ɗenyinǝ aɓwana mem a koya pwari. <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" /><note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="ft" closed="false">Ɓal cê aɓa: </char><char style="xt"><ref loc="NUM 27:21">Ɓal 27:21</ref>; <ref loc="DEU 33:8">Nggur 33:8</ref>; <ref loc="EZR 2:63">Ezr 2:63</ref>; <ref loc="NEH 7:65">Nehe 7:65</ref></char>.</note>Awu nǝ oasǝ a Urim andǝ Thummim<note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="fq" closed="false">Urim andǝ Thummim </char><char style="ft" closed="false">ngga agir na ɓari Pǝris Mǝgule kǝ pàngŋǝ̀nà túró nǝia ace súrǝ̀ nê mala Ɓakuli amur acau.</char></note> aɓa lǝpan-damɓalǝu ace mǝnana ɓǝà pà amur ɓabum Haruna a koya pwari nǝ̀ kùtí a ɓadǝmbam aɓa Ban Mǝfele ka. Anggo sǝ amǝno yì agir ka à nǝ̀ nongŋo amur ɓabum Haruna ace súrǝ̀ nê mem amur amǝ Isǝrayila a ɓadǝmbam, Mim Yahweh koya pwari.<verse eid="EXO 28:30" /></para>
  <para style="s">Aɓea daura pǝris mǝnana à ué ka</para>
  <para style="r">(<ref loc="EXO 39:22-31">Puro 39:22-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />&lt;&lt;Daura-tsuru mǝsauwe mala efot ka ɓǝà tè kat nǝ ɗà'ndíng mǝlùre. <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />Ɓǝà nying ban fonggǝrang a myali ace oasǝ ɓamuru, sǝ ɓǝà tà myali nǝ nkonggúr mǝcandǝe ɓǝ̀ gumbǝli kat, ace mǝnana ɓǝ̀ kǝa sàn raka. <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />Awu nǝ kàrì kún daure nǝ agir kǝla aɓǝla mɓǝring mǝnana à teǎ nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe ka, sǝ wu gyarki amuna gwaroji bolo-njengǝlan a nrea. <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />Amuna gwaroji bolo-njengǝlan andǝ aɓǝla mɓǝring ngga ɓǝà gaɓi-ɓalǝarǝia camge a kún daure, ɓǝà gumbǝli. <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />Dumǝna púp Haruna nǝ̀ oasǝ mǝnia yì daura ka arǝì ɓǝ̀ ndarǝ pàk túró mala pǝris ka. Ɓǝ̀ ndarǝ kutio nǝ̀ yiu a ɓadǝmbam aɓa Ban Mǝfele, ko ɓǝ̀ ndarǝ púrì wi nǝ̀ u ka, à nǝ̀ ok ɓua mala amuna gwaroji mǝnia ka, ace mǝnana ɓǝkǝa wù raka.<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />&lt;&lt;Pàk baji mǝkyauwe nǝ bolo-njengǝlan mǝɓoarne sǝ wu nyoulǝ cau mǝnia ka amurí ama: Mǝfele na aban Yahweh. <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />Kùrrì nǝ nkonggúr mǝlùre arǝ nggubyau mbuɓi múrû mala Haruna nǝ ban ɓadǝmbi. <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />Haruna nǝ̀ nggǝ mārǝi a kúndǝmbi koya pwari. Mǝnia ka nda ace lǝmdǝ ama ɓǝ̀ amǝ Isǝrayila pà agir'nkila abanam kǝla pàɓoro mǝfele malea, sǝ à pè nǝ ɓwarkio aɓalǝi ka, Haruna nǝ̀ twal atanni mǝnana à nǝ̀ yiu atàcau mala amǝno yì aɓwarkio ka amurí, ace mǝnana, Mim, Yahweh ka, mǝ ak apaɓoro mǝnana kat à yinǝia abanam ngga.<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />&lt;&lt;Awu nǝ tà daura-ɓaɓalǝu mǝlime ace Haruna, andǝ nggubyau mbuɓi múrû male, nǝ nkonggúr-linǝn mǝɓǝlke. Sǝ awu nǝ pàkki wi bugìr mārǝ́ taɓunu mǝnana à nbákí rǝì nǝ tagìr mǝɓoarsǝne ka.<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />&lt;&lt;Awu nǝ pàk adaura túró-pǝris, andǝ abugìr mārǝ́ taɓunu, andǝ asukuru, ace amuna-burana mala Haruna, ace mǝnana ɓǝ̀ aɓwana sǝnia nǝ ɓoarɓwa andǝ gulo ka. <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />Awu nǝ oasǝì Haruna andǝ amuna-burana male amǝnia yì agir-nggūrǝu ka arǝia. Sǝ awu nǝ ɗārǝia nǝ mùrú olif ace kùria wia gulo, sǝ ace tària mala pàkkam túró kǝla apǝris. <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />Awu nǝ swàrî Haruna andǝ koyan atà amuna-burana male ka ashiwan mala nggubyau linǝn. Shiwan ngga à nǝ̀ oasǝi a taɓunu sǝ akusǝì nǝ̀ sulǝo aban yiu amur abyalu, ace mǝnana ɓata ɓwa ɓǝ̀ kǝa ueo a nza raka. <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />Dumǝna púp Haruna andǝ amuna-burana male ka à nǝ̀ oasǝ agirɓadǝmbu ateà a pwari mana kat à nǝ̀ kùtí a ɓadǝmbam aɓa Tara Ban-peri, ko à nǝ̀ gbashì ban gyangŋan ace pàk túró pǝris aɓa Ban Mǝfele ka. Mǝnia ka nda ace mǝnana ɓǝà kǝa nunbi ɓamuria cauɓikea sǝ à nǝ̀ wù ka ɗàng. Mǝnia yì nggurcau ka nda ace Haruna andǝ amuni andǝ amǝkè tàtǝ́k.<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">Akwarkiru ace pà gara túró pǝris</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />&lt;&lt;Mǝnia ka nda nàtà mǝnana awu nǝ kpate ace tàr Haruna andǝ amuna-burana male ɓǝà duk apǝris aɓa túró mem ngga: Twal lo jamnda mwashat andǝ agam ɓari mǝnana à pànǝ ɓe kǝgìr mǝɓane arǝia raka. <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />Pàktúró nǝ muku mǝssa-alkama mǝɓǝlke mana yis pà arǝì raka sǝ wu pak agbatali bǝredi. Kpapi mukuì andǝ mùrú olif sǝ wu pak agbatali kyak, pǝlǝa pàk abiskit sǝ wu hasǝkia wia mùrú olif. <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />Awu nǝ tsǝia kat aɓa ndakade mǝmwashati, sǝ awu nǝ yinǝia abanam atārǝia andǝ amǝno yì lo jamnda andǝ agam ɓari ka.<verse eid="EXO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 29:4" />&lt;&lt;Awu nǝ kyan nǝ Haruna andǝ amuna-burana male a kún Tara Ban-peri, sǝ awu nǝ lákkià wia rǝia nǝ mùr. <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />Pǝlǝa awu nǝ twal adaura-pǝris sǝ awu nǝ oasǝì Haruna daura-ɓaɓalǝu mǝlime, andǝ daura-tsuru mǝsauwe mala efot, andǝ efot, andǝ lǝpan-damɓalǝu; sǝ awu nǝ mārǝi wi a taɓuni, bugìr mārǝ́ taɓunu mǝnana à tè nǝ ankonggúr mǝɓoarsǝne ulang mala efot ka. <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />Mārǝi wi nggubyau mbuɓi múrû amurí, sǝ wu kùri wi baji male mǝfele mǝnana à nyoulǝ cau amurí ama: &lt;Mǝfele ace Yahweh&gt; ka. <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />Anzǝm mǝno ka, pè wi gara mala tàrban ace túró pǝris nǝ solǝì wi mùrú olif amurí.<verse eid="EXO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 29:8" />&lt;&lt;Kǝla mǝno gbal, awu nǝ yinǝ amuna-burana male, sǝ awu nǝ oasǝia wia adaura túró-pǝris arǝia. <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />Awu nǝ mārǝia wia abugìr mārǝ́ taɓunu, sǝ awu nǝ mbuɓia wia múrià nǝ anggubyau mbuɓi múrû. Anggo sǝ dobuno-pǝris ka nǝ̀ duk mala Haruna andǝ amuna-burana male andǝ amǝ'keà tàtǝ́k. Anggo sǝ awu nǝ̀ kùrî Haruna andǝ amuna-burana male túró pǝris.<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />&lt;&lt;Awu nǝ yinǝ lo jamnda mǝno ka a ɓadǝmbam, a kún Tara Ban-peri, sǝ awu nǝ banggi Haruna andǝ amuna-burana male, ɓǝà tsǝk abuia a ɓamúrí. <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />Awu nǝ pwanmyal mǝnia yi lo jamnda ka a ɓadǝmbam, Mim Yahweh, a kún Tara Ban-peri. <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />Awu nǝ ɗàrǝ́ nkile bǝti, wu hasǝki amur anjawe gyangŋan nǝ muna-buo. Cili nkila ka, solǝi a kusǝ gyangŋan. <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />Mùrú nyama mǝnana gìr múr alungŋo jamnda, andǝ bare mǝsauwe mala nkundingŋi, andǝ amuna-gbè ɓari, andǝ mùrú nyama mǝnana amuria ka, pwania kat sǝ wu pisǝia a bǝsa amur gyangŋan. <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />Sǝama, cili nyam jamnda, andǝ ngguí, andǝ ciute ka, awu nǝ pisǝia a nzǝm là-gumli; mǝnia ka pàgir ace acauɓikea na.<note caller="+" style="f"><char style="fr" closed="false">29:14 </char><char style="fq" closed="false">pàgir ace acauɓikea na </char><char style="ft" closed="false">ko &lt;&lt;pàgir mala lakban arǝ cauɓikea na&gt;&gt;; anggo gbal a mǝsǝi 36.</char></note><verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />&lt;&lt;Ɗǝm ngga awu nǝ twal mwashat atà agam mǝno ɓari ka sǝ wu banggi Haruna andǝ amuna-burana male ɓǝà tsǝk abuia a ɓamúrí. <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />Sǝ awu nǝ pwanmyal gamnì, sǝ nkile ka awu nǝ watsǝki arǝ gyangŋan ɓǝ̀ gumbǝli. <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />Awu nǝ kasǝki nyam gamnì bǝti-bǝti; awu nǝ lak agir-bumi, andǝ akusǝi, sǝ awu nǝ tsǝia amur ɓamúrí andǝ nyami mǝnana à kasǝki bǝti-bǝti ka. <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" />Pisǝ abare gam mǝnia ka kat a bǝsa amur gyangŋan. Mǝnia ka pàgir mala pisǝe kǝring abanam Mim Yahweh na; pàgir na nǝ bǝsa abanam Mim Yahweh, ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam ngga.<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />&lt;&lt;Awu nǝ twal ɓè gam mǝno ue ka, sǝ awu nǝ tunǝ Haruna andǝ amuna-burana male ɓǝà tsǝk abuia a ɓamúrí. <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />Pǝlǝa awu nǝ pwan-myal gamnì, sǝ awu nǝ ɗàrǝ́ bǝti aɓa nkile wu hasǝkì Haruna andǝ amuna-burana male arǝ amburkiria mǝlì, andǝ amuna-buia mǝbure mǝlì, sǝ arǝ amuna-kusǝia mǝbure mǝlì. Cili ka watsǝki arǝ gyangŋan ɓǝ̀ kàrì kat. <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />Awu nǝ ɗàrǝ́ aɓa nkila mǝnana amur gyangŋan ngga, sǝ wu zurǝì andǝ mùrú olif mǝnana nda ace ɗārǝâ ka, sǝ wu watsǝki amur Haruna sǝ amur amuna-burana male, andǝ adaura malea. Anggo, sǝ yia andǝ adaura malea ka awu nǝ tària, amǝfele na.<verse eid="EXO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 29:22" />&lt;&lt;Mǝnia yi gam ngga nda ace nàtà mala pè Haruna andǝ amuna-burana male gara ace túró pǝris. Acemani ka, pusǝki mùrú rǝ nyam gamnì, andǝ mùrú nyam nggilate, andǝ mùrú nyama mǝnana gìr múr agir-bumi ka; sǝ wu pusǝ ban mǝɓoarne mala nkundingŋi, andǝ amuna-gbè ɓari, andǝ mùrú nyama mǝnana gìr múrià ka, andǝ byal kusǝi mǝlì. <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />Aɓa ndakade mǝno à yinǝi ace pà ɓoro nǝi abanam ngga, twal gbatali bǝredi mwashat, gbatali kyak mwashat mana à pè nǝ mùrú ka, sǝ biskit mwashat; <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />tsǝia andǝ abare nyama mǝnia ka a ɓabù Haruna andǝ ɓabu amuna-burana male, ɓǝà loasǝia a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />Anzǝm mǝnia ka, awu nǝ ak gbatali bǝredi, andǝ gbatali kyak, andǝ biskit, andǝ abare nyama kat a buia, awu nǝ tsǝia amur abare nyam gam mǝdǝmbe mǝnana nda aban pi amur gyangŋan ngga, sǝ awu nǝ pisǝia kǝring a ɓadǝmbam Mim Yahweh. Pàgir nǝ bǝsa na abanam, Mim Yahweh.<verse eid="EXO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 29:26" />&lt;&lt;Sǝ awu nǝ twal kikil gam mǝnana à pwanmyali ace nàtà mala tàr Haruna ace túró pǝris ka, sǝ awu nǝ loasǝi a kùli a ɓadǝmbam, ɓǝ̀ do pàgir na mǝnana à loasǝi a kùli abanam Yahweh ka. Mǝnia yì bare girkusǝu ka nda nǝ̀ duk kāmbe mò ka.<verse eid="EXO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 29:27" />&lt;&lt;Ɓǝ̀ à nǝ̀ tàr ɓwa ace túró pǝris ka, kikil andǝ byal gam mǝnana à pwan-myali ace nàtà mala mǝno yi tàrban, mǝnana à loasǝia a kùli kǝla pàɓoro mana à loasǝi a kùli ka, dumǝna ɓoro mǝnana à tàrni, nda kāmbe mala apǝris, yì a Haruna andǝ amuni andǝ amǝkè ka. <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />Mǝnia ka nǝ̀ duk kāmbe mǝnana amǝ Isǝrayila nǝ̀ nggǝ pê apǝris, yì a Haruna andǝ amuni andǝ amǝkè mana a nzǝmi ka, nggaɗè pà kàm ɗàng tàtǝ́k. Mǝnia ka nǝ̀ duk kāmbe mala ɓoro mala amǝ Isǝrayila abanam, Mim Yahweh, mana à twali aɓalǝ apagir ace dotarǝu ka.<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />&lt;&lt;Adaura-pǝris mala Haruna ka, à nǝ̀ tsǝia ace amuni andǝ amǝkè mana à nǝ̀ yia lidǝmba nǝ túró pǝris anzǝm lú male ka. À nǝ̀ oasǝia arǝia ɓǝ̀ à nǝ̀ kùria wia túró pǝris nǝ ɗārǝ́bân nǝ mùrú olif amúrià mala tàrban ace túró pǝris ka. <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />Muna-ɓwabura mala Haruna mǝnana nǝ̀ twal bancame male a túró pǝris ka, nǝ̀ oasǝ adaura-pǝris mǝnia ka arǝì sǝ nǝ̀ nggǝ kútí a ɓadǝmbam aɓa Tara Ban-peri ace pàktúró aɓa Ban Mǝfele, nongŋo tongno-nong-ɓari.<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />&lt;&lt;Awu nǝ twal cili abare nyam gam mana à pàngŋǝ̀nà túró nǝi ace nàtà mala tàr Haruna andǝ amuna-burana male ace túró pǝris ka, sǝ wu lam nyamì nǝ mùr a ɓè ban mǝnana à tàrì ace pàkkì atúró mǝfele ka. <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />Haruna andǝ amuna-burana male nǝ̀ shak nyama mǝnia ka atārǝia andǝ agbatali bǝredi mǝnana à ueo aɓa ndakade ka, a kún Tara Ban-peri. <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />À nǝ̀ shak mǝnia yì nyama andǝ bǝredi mǝnana à pàngŋǝ̀nà túró nǝi ace shawuɗiban aɓa nàtà mala kùria wia gulo andǝ tàrban malea aɓa túró pǝris ka. Kǝ yia apǝris nǝmurǝia na à nǝ̀ lì mǝnia yì girlina ka, acemǝnana girlina mǝfele na. <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />Sǝ ɓǝ̀ cili mǝnia yì nyama ko bǝredi ueo, kya bwal bu dǝmbari ka, dumǝna púp à nǝ̀ súkkì a bǝsa ɓǝ̀ pǐ; kǝ ɓwa ɓǝ̀ kǝa lì ɗàng, acemǝnana mǝfele na.<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />&lt;&lt;Anggo sǝ awu nǝ kùrî Haruna andǝ amuna-burana male túró pǝris, kǝla mana ǝn tsǝko nǝma wu pê ka; mǝnia yì nàtà mala kùrî ɓwa túró pǝris ka, à nǝ̀ pè aɓalǝ apwari tongno-nong-ɓari. <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />Aɓa koya pwari ka, dumǝna púp awu nǝ pwan-myal lo-jamnda kǝla pàgir mala shawuɗiban ace cauɓikea. Ɗǝm ngga ɓǝ̀ a nda rǝ shawuɗì gyangŋan ngga, awu nǝ ɗārǝí nǝ mùrú olif ace tàre ace Ɓakuli. <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />Awu nǝ pàk amǝnia yì anàtà mala shawuɗiban ngga koya pwari arǝ anongŋo tongno-nong-ɓari, ace tàr gyangŋan ɓǝ̀ duk mǝfele kat-kat. Anggo sǝ gyangŋan nǝ̀ duk mǝfele, sǝ gìr mǝnana kat je gyangŋan ngga nǝ̀ duk mǝfele.<verse eid="EXO 29:37" /></para>
  <para style="s">Pāki agir'nkila mala koya pwari</para>
  <para style="r">(<ref loc="NUM 28:1-6">Ɓal 28:1-6</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />&lt;&lt;Amǝnia ka, à nda ka agir'nkila mǝnana awu nǝ pànà ɓoro nǝia amur gyangŋan-pàɓoro koya pwari arǝ apwari kat ka: Amǝgam ɓari, komǝye ka mbule mwashat. <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />Mǝgam mǝnia mwashat ka, awu nǝ pànà ɓoro nǝi kǝla gir'nkila nǝ dǝmbari, sǝ ɓè ka awu nǝ pana ɓoro nǝi kǝla gir'nkila nǝ pwarikpǝra. <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />Mǝgam mǝdǝmbe mǝnana awu nǝ pànà ɓoro mala gir'nkila nǝi ka, kpapi andǝ tasau mwashat<note caller="+" style="f"><char style="fr" closed="false">29:40 </char><char style="fq" closed="false">tasau mwashat </char><char style="ft" closed="false">ko tyang mwashat.</char></note> mala mǝssa-alkama mǝɓǝlke mana à soapi wi mùrú olif mǝɓoarne mǝnana ɓè kǝgìr ɗàng pà kàm arǝì raka, dù-lita mwashat. Sǝ wu so dù-lita mwashat mala mùr-anap amurí, ɓǝ̀ do nda pàgir mala girnùná. <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />Ɓaria mǝgam ngga awu nǝ pànà ɓoro mala gir'nkila nǝi nǝ pwarikpǝra; awu nǝ gilǝkì atārǝia andǝ pàgir mala mǝsǝsa, andǝ pàgir mala girnùná male, kǝla mana a pê nǝ dǝmbari ka. Pàgir nǝ bǝsa na abanam Yahweh, mala pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga.<verse eid="EXO 29:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 29:42" />&lt;&lt;Arǝ anza mǝnana kat à nǝ̀ yiu ka, à nǝ̀ nggǝ pak mǝnia yì pàɓoro mala pisǝ gir a bǝsa ka koya pwari, a ɓadǝmbam, Mim Yahweh, a kún Tara Ban-peri. A mǝnia yì ban a kún Tara Ban-peri ka, sǝ mǝ nǝ nggǝ je sǝnǝ aɓwana mem, sǝ mǝ nǝ nggǝ nô cau. <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />A kǝ banì sǝ mǝ nǝ nggǝ je sǝnǝ amǝ Isǝrayila, sǝ tǎlaban mala ɓoarɓwa mem nǝ̀ tsǝk banì nǝ̀ duk mǝfele.<verse eid="EXO 29:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="EXO 29:44" />&lt;&lt;Anggo sǝ mǝ nǝ tsǝk Tara Ban-peri andǝ gyangŋan-pàɓoro ɓǝà duk amǝfele, sǝ Haruna andǝ amuna-burana male ka, mǝ nǝ tària ace ɓamúràm mana à nǝ̀ nggǝ pakkam túró kǝla apǝris ka. <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />Sǝ mǝ nǝ do aɓalǝ amǝ Isǝrayila, mǝ nǝ duk Ɓakuli malea. <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />Sǝ à nǝ̀ sǝlǝ ama, Mǝ nda Yahweh Ɓakuli malea. Mǝ nda ɓwa mǝnana pusǝia aɓa nzali Masar ace mǝnana ɓǝ̀ ǝn do aɓalǝia ka. Mǝ nda Yahweh Ɓakuli malea.<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">Gyangŋan mala loasǝ yele mǝ'rǝmɓoarne</para>
  <para style="r">(<ref loc="EXO 37:25-28">Puro 37:25-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />&lt;&lt;Awu nǝ ɓak ɓè gyangŋan nǝ akpamgbang mala nggun-akasiya, mǝnana à nǝ̀ nggǝ pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne amurí ka. <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />Tangŋa male andǝ sauwa male ɓǝà kārǝa, komǝye ka ɓakusǝu mwashat nǝ gauwa-tsùrú, sǝ dāh'rya male ɓǝ̀ pàk ɓakusǝu tàrú. A koya nkanggari ka awu nǝ tsǝki wi njawe nǝ ulang kǝ nggun mǝnana à pè nǝi ka, ɓǝà duk mwashat. <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />Awu nǝ gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne: múrí, andǝ ankanggari, andǝ anjawe. Sǝ awu nǝ ɓak bolo-njengǝlan ɓǝ̀ kàrì kúni kat. <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />Sǝ awu nǝ pàkki wi agbalmò bolo-njengǝlan ɓari-ɓari arǝ ankanggari; tsǝia ɓǝà sulǝî ban kúní bǝti sǝ ɓǝà came a nkāɓe rǝarǝia. Amǝnia yì agbalmò ka à nda ace oasǝ agara mǝnana à nǝ̀ nggǝ twal gyangŋanì nǝia ka. <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />Awu nǝ pàk agara twale nǝ nggun-akasiya, sǝ wu gìr rǝia nǝ bolo-njengǝlan. <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />Awu nǝ tsǝk mǝnia yì gyangŋan loasǝ yele mǝ'rǝmɓoarne ka anzǝm lagìr-kasǝbân mana gyare a ɓadǝm Akwati mala Acau-nakûn ngga. Yì Akwati mala Acau-nakûn andǝ gìrkúni ka, ɓǝ̀ pa a ɓadǝm gyangŋan loasǝ yele. Gìrkún Akwati ka nda buno sǝntǝ̀r, sǝ nda ban mǝnana Mǝ nǝ nggǝ je sǝnǝ we kam ngga. <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />Dumǝna púp Haruna nǝ̀ nggǝ pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne amur mǝnia yì gyangŋan ngga. Koya dǝmbari ɓǝ̀ warina nǝ̀ giliki apitǝla ka, nǝ̀ pisǝì. <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />Koya pwarikpǝra ɓǝ̀ warina nǝ̀ tsǝk bǝsa arǝ apitǝla ka, nǝ̀ pìsǝì. Mǝnia yì pàgir mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne a ɓadǝm Yahweh ka, nǝ̀ lidǝmba anggo, tamsǝe pà kàm ɗàng, arǝ anza kat. <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />Pà wunǝ pàɓoro mala loasǝ yele nǝ ɓekǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne mǝnana ǝn earnǝi raka amur mǝnia yì gyangŋan ngga ɗàng; wu kǝa na ama wun nǝ̀ pà gir'nkila mala pisǝe kǝring, ko wun nǝ̀ pàgir mala mǝsǝsa amurí ɗàng; sǝ wu kǝa na ama wun nǝ̀ pàgir mala so mùr-ɓǝlanggun anap amurí ɗàng. <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />Kusǝ mwashat a koya pǝlǝa ka Haruna nǝ̀ pàk nàtà mala shawuɗiban amur anjawe male. Nǝ̀ hasǝki wi nkila arǝ anjawe, yì nkila mǝnana à ɗarǝi arǝ girkusǝu mala pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">30:10 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea.&gt;&gt;</char></note> mǝnana à pwan-myali kǝla gir'nkila ace shawuɗì aɓwapǝndǝa ka. Anggo sǝ à nǝ̀ lidǝmba nǝ pe a koya pǝlǝa, arǝ anza kat. Mǝnia yì gyangŋan loasǝ yele ka nǝ̀ duk nggea mǝfele abanam Yahweh.&gt;&gt;<verse eid="EXO 30:10" /></para>
  <para style="s">Boalo-cemi ace Tara Mǝfele</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />Pǝlǝa Yahweh ne Musa ama, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />&lt;&lt;Ɓǝ̀ awu nǝ ɓal amǝ Isǝrayila ace súrǝ̀ làkkì malea ka, koya ɓwa mǝnana à ɓalli kat ka, nǝ̀ mbwegìr abanam, Mim Yahweh ace amsǝ yilǝmi. À nǝ̀ mbwe ace mǝnana ɓǝ̀ gìr'mur'mwana ɓǝ̀ kǝa kumia ɓǝ̀ à nda rǝ ɓalban ngga ɗàng. <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" />Ɓwa mǝnana kat à ɓalli a mǝnia yì ɓalban ngga, nǝ̀ mbwe boalo, gauwa-tsùrú mala shekel, yì mǝsǝbolo-azǝrfa mǝnana à kārǝ́ dǝmbǝrya male sǝ à earna amurí a Tara-mǝfele ka. (Shekel mwashat ka mǝtyang lum-nong-ɓari na.) Koya ɓwa ka nǝ̀ mbwe boalo mǝnia kǝla ɓoro abanam, Mim Yahweh. <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />Aɓwana mana kat pǝlǝa ɓǝlban malea bwalǝna lumi-ɓari ka, à nǝ̀ pà mǝnia yì ɓoro ka abanam, Mim Yahweh. <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />Ɓǝ̀ wun nǝ̀ yinǝ mǝnia yì ɓoro ace shawuɗì ayilǝmi wun, abanam, Mim Yahweh ka, mǝkume pà nǝ̀ pà gìr mǝnana kútì boalo mǝnana à kasǝ ka ɗàng, sǝ mǝ'tǝ̀r pà nǝ̀ pà gìr mǝnana gattì boalo mǝnana à kasǝ ka ɗàng. <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />Awu nǝ ak mǝnia yì boalo shawuɗiban ngga a bu amǝ Isǝrayila, sǝ awu nǝ pàngŋǝ̀nà túró nǝi ace tsǝkir Tara Ban-peri; ace mǝnana ɓalǝam ɓǝ̀ kasǝa arǝ yália ka.&gt;&gt;<verse eid="EXO 30:16" /></para>
  <para style="s">Nkenye bolo-bángŋá ace lákkí agir</para>
  <para style="r">(<ref loc="EXO 38:8">Puro 38:8</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />Pǝlǝa Yahweh banggi Musa ama, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" />&lt;&lt;Awu nǝ pàk nkenye nǝ bolo-bángŋá ace lákkí arǝu, sǝ girtàmsǝe ka pè gbal nǝ bolo-bángŋá. Tsǝì ɓǝ̀ came a nre Tara Ban-peri andǝ gyangŋan-pàɓoro, sǝ wu so mùr aɓalǝi. <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />Haruna andǝ amuna-burana male nǝ̀ pàktúró nǝ mùrnî ace lákkí abuia andǝ akusǝia. <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />Kaniama à nǝ̀ kùtí aɓa Tara Ban-peri, ko à nǝ̀ gbàshì ban gyangŋan ace pàk túró-pǝris, à nǝ̀ pà ɓoro mala pisǝ gir a bǝsa amurí ace loasǝ yele mǝ'rǝmɓoarne abanam Mim Yahweh ka, dumǝna púp, à nǝ̀ lákkí arǝia nǝ̀ mùr. Ɓǝà pàk anggo raka à nǝ̀ wú. <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />Dumǝna púp à nǝ̀ lákkí abuia andǝ akusǝia, ace mǝnana ɓǝà kǝa wù raka. Mǝnia ka nzongcau na mǝnana yì, andǝ amuni, andǝ amǝ'keà nǝ̀ kpatè arǝ anza malea kat ka.&gt;&gt;<verse eid="EXO 30:21" /></para>
  <para style="s">Mùrú ɗārǝ́bân</para>
  <para style="r">(<ref loc="EXO 37:29">Puro 37:29</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />Yahweh ne Musa ama, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />&lt;&lt;Twal amǝnia yì amuku agir-mǝ'kuskushi ka: tyang tongno-nong-mwashat mala muku mǝr, sǝ tyang tàrú mala muku nggwato-nggun sinamon mǝ'rǝmɓoarne, andǝ tyang tàrú mala muku kǝkar-bondo mǝ'rǝmɓoarne, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />sǝ tyang tongno-nong-mwashat mala muku nggwato-nggun kasiya mǝ'rǝmɓoarne. Yia kat ka, ɓǝà kārǝia nǝ kārǝgìr mǝnana à earna amurí a Tara-mǝfele ka. Soapi wia lita ine mala mùrú olif. <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />Nǝ mǝnia yi amuku agir ka sǝ awu nǝ pàk mùrú mǝfele ace ɗārǝ́bân; ɓǝà pè kǝla mǝnana mǝ'sǝlǝ pakki agir pà rǝmban mǝɓoarne kǝ pê ka; mǝnia yì mùrú ka nǝ̀ duk mùrú-ɗārǝ́bân mǝfele. <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />Pàktúró nǝ mǝnia yi mùrú ka wu hasǝki arǝ Tara Ban-peri sǝ arǝ Akwati mala Acau-nakûn, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />sǝ wu hasǝki arǝ kpamgbang-tsǝk-agir andǝ agirtúró male, andǝ gìr-tàmsǝ apitǝla andǝ agirtúró male kat, andǝ gyangŋan mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne, <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />andǝ gyangŋan pàgir mala pisǝe kǝring andǝ agirtúró male kat, sǝ nkenye lákkí arǝu andǝ girtàmsǝe. <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />Awu nǝ ɗārǝia nǝ mùrú-ɗārǝ́bân anggo ace mǝnana ɓǝà duk agir mǝfele kat-kat. Ɓwa ko gìr mǝnana kat jea ka, nǝ̀ duk mǝfele. <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />Awu nǝ ɗārǝ́ Haruna andǝ amuna-burana male gbal nǝ mùrú ɗārǝ́bân, sǝ wu kùria wia gulo mala pǝris ɓǝà duk amǝ pakkam túró kǝla apǝris. <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />Sǝ awu nǝ banggi amǝ Isǝrayila ama, &lt;Mǝnia yì mùrú-ɗārǝ́bân mǝfele ka, nda ace túró mem arǝ anza kat. <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />À pà nǝ̀ pàngŋǝ̀nà túró nǝi kǝla mùrú-hasǝa arǝ aɓwana ɗàng, sǝ wu kǝa pàk ɓekǝ mùrú nǝ agir kpapè ulang male ɗàng. Mǝnia yì mùrú-ɗārǝ́bân ngga mǝfele na, sǝ anggo sǝ wun nǝ̀ twali mǝfele na. <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />Ɓǝ̀ kǝɓwa pàk kǝ ulangnì, ko ɗārǝ́na kǝɓwa nǝi mǝnana pǝris na raka, nǝ̀ purî ɓalǝ aɓwana mem.<note caller="+" style="f"><char style="fr" closed="false">30:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:14">Tite 17:14</ref>; <ref loc="EXO 30:38">Pur 30:38</ref></char>.</note>&gt; &gt;&gt;<verse eid="EXO 30:33" /></para>
  <para style="s">Myang andǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />Yahweh ne Musa ama, &lt;&lt;Kpapiki amǝnia yì agir mǝpà rǝmban mǝɓoarne ka: mǝrǝm nggun, andǝ nkpoulo nkombo, andǝ myang nggun, andǝ myang-kwarra mǝɓoarne; (komǝye ka dǝmbǝrya male ɓǝ̀ kārǝa andǝ mala aɓî). <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />Nǝ mǝnia yì agir ka sǝ awu nǝ pàk muku-gìr loasǝ yele mǝ'rǝmɓoarne; pè kǝla mǝnana mǝ'sǝlǝ pakki agir pà rǝmban mǝɓoarne kǝ pê ka. Awu nǝ zùrǝì amǝnia yì agir ka, sǝ awu nǝ kúnǝkì wi tuɓamur ɓǝ̀ pàk mǝɓoarnsari sǝ mǝfele. <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />Ɗàrǝ́ bǝti aɓa kpapè mǝno, goe ɓǝ̀ ɓǝlki lǝkǝt-lǝkǝt sǝ wu tsǝî a ɓadǝm Akwati mala Acau-nakûn, a ban mǝnana sǝm nǝ nggǝ je sǝnǝ we kam aɓa Tara Ban-peri ka. Mǝnia yì muku-gìr loasǝ yele mǝ'rǝmɓoarne ka, twali gìr nggea mǝfele na. <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />Mǝnia yì muku-gìr loasǝ yele mǝ'rǝmɓoarne ka dumǝna mǝfele, wu kǝa pakkî ɓamur rǝ wun ulangnì ɗàng. <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" />Ɓwa mǝnana kat pàk ulang mǝnia yì gìr loasǝ yele mǝ'rǝmɓoarne ace ɓamurì ka, nǝ̀ purî ɓalǝ aɓwana mem.<note caller="+" style="f"><char style="fr" closed="false">30:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:14">Tite 17:14</ref>; <ref loc="EXO 30:33">Pur 30:33</ref></char>.</note>&gt;&gt;<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">Mǝtalabangŋo twal Bezal-El andǝ Oholiyap <optbreak /> ace túró pàk Taragula</para>
  <para style="r">(<ref loc="EXO 35:30-36:1">Puro 35:30--36:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />Yahweh bangcau nǝ Musa ama, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />&lt;&lt;Sǝni, ǝn twalna Bezal-El muna-ɓwabura mala Uri, mǝkà Hur, a tàu mala Yahuda sǝ <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />ǝn lúmsǝ̀nì nǝ bangŋo mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="fq" closed="false">bangŋo mala Ɓakuli </char><char style="ft" closed="false">ko bangŋo mem.</char></note> Ən panì wi kwárô aɓa ɗenyicau, andǝ súrǝ̀gir, andǝ sǝlǝe mala pàk koya ulang túróbù; <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />nǝ̀ sǝlǝ nyoulǝ pǎ mala agir mǝɓoarsǝne ɗàng-ɗáng, andǝ tùlki agir nǝ bolo-njengǝlan, bolo-azǝrfa, andǝ bolo-bángŋá; <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />ndanǝ sǝlǝpe mala kpaliki rǝ atali-gǝna ace oasǝkia aɓalǝ agir-bwalia, andǝ mala shàr nggun, andǝ mala pak koya ulang túróbù. <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />Ɗǝm ngga ǝn twalna Oholiyap, muna-ɓwabura mala Ahisamak, a tàu mala Dan, ɓǝà pàktúró andǝi. Nyare ǝn panì acili aɓwana mǝnana kat amǝ pàkkiagir túróbù na ka sǝlǝpe ace mǝnana ɓǝà pàk koya gìr kat gǝ̀rgǝ̀r kǝla mǝnana ǝn banggo nǝma ɓǝà pè ka amur cau mala: <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />Tara Ban-peri, andǝ Akwati mala Acau-nakûn andǝ gìrkúni amurí, mǝnana nda buno sǝntǝ̀r ka, andǝ acili agir mana kat à nǝ̀ tsǝia aɓa Tara Ban-peri ka, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />andǝ kpamgbang-tsǝk-agir andǝ agirtúró male amurí, andǝ gìr-tàmsǝ apitǝla, andǝ agirtúró male kat, andǝ gyangŋan ace loasǝ yele mǝ'rǝmɓoarne, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />andǝ gyangŋan mala pagir mala pisǝ kǝring andǝ agirtúró male kat, andǝ nkenye andǝ girtàmsǝe, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />andǝ adaura-pǝris amǝ'ɓoarɓwe, yi adaura mǝfele ace Haruna pǝris mǝgule andǝ adaura ace amuna-burana male, mǝnana à nǝ̀ oasǝ arǝia ɓǝ̀ à nǝ̀ pàk túró pǝris ka, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />andǝ mùrú-ɗārǝ́bân, andǝ muku-agir loasǝ yele mǝ'rǝmɓoarne ace Ban Mǝfele. Aɓa pàkki amǝnia yì agir kat ka, ɓǝà peǎ gǝ̀rgǝ̀r kǝla mǝnana ǝn banggo ka.&gt;&gt;<verse eid="EXO 31:11" /></para>
  <para style="s">Nggurcau amur Pwari Sabbat</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />Pǝlǝa Yahweh bangcau nǝ Musa ama, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />&lt;&lt;Ne amǝ Isǝrayila ama, &lt;Dumǝna wun púp wun nǝ̀ kpata nzongcau mala Pwari Sabbat, pwari usǝlǝo mem. Acemǝnana Pwari Sabbat ka nda gìr'lǝmdǝa a nrem sǝnǝa wun aban ká arǝ anza mǝnana kat à kǝ yiu ka, ace mǝnana ɓǝ̀ wu sǝlǝ ama, Mim Yahweh ka, ǝn tárnà wun ɓǝ̀ wu duk aɓwana mem. <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />Dumǝna púp wun nǝ̀ kpata nzongcau mala Pwari Sabbat, acemǝnana pwari mǝfele na aban wun. Ɓwa mǝnana pǝndǝkice ka, dumǝna púp à nǝ̀ wali ɓǝ̀ wú. Ɓwa mǝnana pàk túró a pwari mǝno ka, à nǝ̀ pusǝì, pà nǝ̀ pa aɓalǝ aɓwana male ɗàng.<note caller="+" style="f"><char style="fr" closed="false">31:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 15:35">Ɓal 15:35</ref> </char>.</note> <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" />Wu ndanǝ anongŋo tongno-nong-mwashat mala pàkki atúró, sǝama tongno-nong-ɓaria pwari ka, nda pwari Sabbat mala usǝlǝo, pwari mǝfele mana à tàrì ace Yahweh ka. Ɓwa mǝnana pàk túró a Pwari Sabbat ka, dumǝna púp à nǝ̀ wali ɓǝ̀ wú. <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />Acemani ka, amǝ Isǝrayila nǝ̀ pà gulo arǝ Pwari Sabbat, à nǝ̀ kpata nzongcau male arǝ anza mǝnana kat à kǝ yiu ka, kǝla kùrcau mana málá male pà kàm raka. <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" />Mǝnia yì pwari ka, nǝ̀ do gìr'lǝmdǝa na tàtǝ́k a nrem sǝnǝ amǝ Isǝrayila ama, Mim Yahweh ka, ǝn pusǝ kùli andǝ nzali aɓa nongŋo tongno-nong-mwashat, sǝ a tongno-nong-ɓaria pwari ka, ǝn nying buam arǝ túró, ǝn usǝlǝo.<note caller="+" style="f"><char style="fr" closed="false">31:17 </char><char style="fq" closed="false">ǝn nying buam arǝ túró, ǝn usǝlǝo </char><char style="ft" closed="false">ko &lt;&lt;ǝn usǝlǝo, ǝn tusǝɓalǝam.&gt;&gt; </char></note>&gt; &gt;&gt;<verse eid="EXO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 31:18" />Lang Ɓakuli malna nacau nǝ Musa amur Nkono Saina ka, pǝlǝa pè wi akpamgbǝlang tali ɓari mala Acau-nakûn, yì akpamgbǝlang Acau-nakûn mǝnana Ɓakuli nyoulǝia nǝ munabui ka.<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">Aɓwana ɓak ɓǝ̀nzál mala lo-jamnda nǝ bolo-njengǝlan</para>
  <para style="r">(<ref loc="DEU 9:6-29">Ɓǝs Nggur 9:6-29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />Lang aɓwana sǝnǝna sauwa mǝnana ban Musa sauwa amur nkono ka, kara à ramba aban Haruna, à ne wi ama, &lt;&lt;Lo, pakka sǝm ɓakuli,<note caller="+" style="f"><char style="fr" closed="false">32:1 </char><char style="fq" closed="false">ɓakuli </char><char style="ft" closed="false">ko &lt;&lt;ɓǝ̀nzál mala ɓè ɓakuli.&gt;&gt;</char></note> ɓǝ̀ dupa sǝm a dǝmba. Acemǝnana sǝm súrǝ̀ gir mana kum mǝnia yì ɓwa, yì Musa mǝnana pusǝ sǝm aɓa Masar ka ɗàng.&gt;&gt;<verse eid="EXO 32:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 32:2" />Pǝlǝa Haruna nea wia ama, &lt;&lt;Wu pusǝki agirkiru bolo-njengǝlan mala amālá wun, andǝ mala amuna-burana andǝ amuna-mamǝna ma'wun, wu yinǝàm nǝia.&gt;&gt; <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />Kara ɓwabundǝa kat pusǝki agir bolo-njengǝlan mana a kiria ka, à yinǝì Haruna nǝia.<verse eid="EXO 32:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 32:4" />Pǝlǝa Haruna ak agir bolo-njengǝlan mǝnia, tsǝia a bǝsa, à panzǝa. Pǝlǝa ɓakia wia ɓǝ̀nzál lo-jamnda nǝi, konggi rǝì sǝ kolǝì pepè nǝ agirtúró. Lang ɓwapǝndǝa sǝni ka, à na ama, &lt;&lt;Mǝnia ka nda ɓakuli ma'wun, wun amǝ Isǝrayila, mana pusǝ wun aɓa nzali Masar ka!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">32:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 12:28">1Amur 12:28</ref></char>.</note><verse eid="EXO 32:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 32:5" />Lang Haruna sǝn mǝnia ka, kara ɓak gyangŋan-ɗārǝâ a ɓadǝm ɓǝ̀nzál lo-jamnda. Pǝlǝa hambî aɓwana cau ama, &lt;&lt;Li ka, Lamsan nakam ace pagulo aban Yahweh!&gt;&gt; <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" />Aɓwana lo nǝ dǝmbari ɗiɗyal, à pākia agir'nkila mala pisǝe kǝring a bǝsa aban ɓǝ̀nzál mǝno, sǝ à yinǝ aɓoro mala pàgir ace dotarǝu. Anzǝm mǝno ka, à do sǝ à kùtí a likia agir, andǝ nukia agir. Pǝlǝa à lo à pakkiɗire.<note caller="+" style="f"><char style="fr" closed="false">32:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 10:7">1Kor 10:7</ref>; <ref loc="PSA 106:19-20">Ang 106:19-20</ref></char>.</note><verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />Yahweh ne Musa ama, &lt;&lt;Sùlǝî mur nkono akaurǝa! Aɓwana mô mana a pusǝia a Masar ka, à kìɗìkìna ɓamuria. <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />À kaurǝ kyanggi njar, yì njar mǝnana ǝn tsǝkia wia nzongcau ɓǝà kpate ka! À pàngŋǝ́nì ɓamuria ɓǝ̀nzál mala lo-jamnda nǝ bolo-njengǝlan. À ɓunǝna a ɓadǝmbi, sǝ à ɗārǝ́na gìr'nkila a baní, à kǝ na ama, &lt;Mǝnia ka nda ɓakuli ma'wun, wun amǝ Isǝrayila, mana pusǝ wun aɓa nzali Masar ka.&gt; &gt;&gt;<verse eid="EXO 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 32:9" />Pǝlǝa Yahweh banggi Musa ama, &lt;&lt;Ən sǝnǝni ama aɓwana mǝnia ka amǝ'murcandǝa na. <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />Ado ka ɗekiǎm ace mǝnana bumlulla mem ɓǝ̀ earke amúrià, mǝ nǝ twàlteà kat. Sǝ we ka mǝ nǝ tsǝk tàu mò ɓǝ̀ pǝlǝ ɓwapǝndǝa mala nzali mǝgule.&gt;&gt;<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />Sǝ Musa ka ɓariki nǝ pwasǝlǝbum Yahweh Ɓakuli male, na ama:</para>
  <para style="pi" vid="EXO 32:11">&lt;&lt;We Yahweh, man tsǝa sǝ bumlulla mò nǝ̀ earke anggo amur aɓwana mô, yià mǝnana a pusǝia à purî ɓá nzali Masar nǝ kanggǝrang rǝcandǝa andǝ kaɓa bù ka? <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />Ɓǝ̀ a pak anggo ka amǝ Masar nǝ̀ kum kún nacau ama, &lt;Nǝ bumɓikea sǝ Ɓakuli malea pusǝia ɓǝà purî ɓá nzali Masar, ace mǝnana nǝ̀ nggá wal-luia amur ankono, sǝ nǝ̀ twaltea ɗǝɗak ɓǝà malì ɓanza ka.&gt; Nying bumlulla mò mǝ'earke; nggaɗi ɗenyicau mò, sǝ kǝa yinǝ mǝnia yì gìr'mur'mwana ka amur aɓwana mô ɗàng.<verse eid="EXO 32:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="EXO 32:13" />&lt;&lt;Ɓalǝo ɓǝ̀ kasǝa arǝ pacau mò aban aguro mò, Ibǝrayim andǝ Ishaku sǝ Isǝrayila, mǝnana a kánbia wia gìr nǝ ɓamurò ama: &lt;Mǝ nǝ hatǝki wun, amuna andǝ amǝkà wun nǝ̀ làkkì kǝla làkkì mala anlero a bumkuli, sǝ nzali mǝnia kat ǝn pacau ace ka, mǝ nǝ pè amuna ma'wun andǝ amǝ'kà wun ɓǝ̀ duk gìr'liɓala malea tàtǝ́k.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">32:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 15:7">15:7</ref>,<ref loc="GEN 15:18">18</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 22:16-17">22:16-17</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="GEN 35:11-12">35:11-12</ref></char>.</note><verse eid="EXO 32:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 32:14" />Nda Yahweh nggaɗi ɗenyicau male arǝ gìr'mur'mwana mǝnana bang ama nǝ̀ yinǝi amúr aɓwana male ka.<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />Musa pǝlǝa, sǝ sulǝî múr nkono nǝ akpamgbǝlang tali ɓari mala Acau-nakûn a buì, yì akpamgbǝlang tali mǝnana Ɓakuli gilǝ cau mala kùrcau kàm amúrià ɓālǝi andǝ nzǝmi ka. <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />Akpamgbǝlang atali ka Ɓakuli nǝ ɓunnia, sǝ gilǝgir mǝnana amúrià ka Ɓakuli nǝ gilǝì, nyoulǝì amúrià.<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />Lang Jesǝwa ok loàsǝ̀ban mala aɓwana aban sakkiban ngga, banggi Musa ama, &lt;&lt;Ən nggǝ ok gǝshi lwa a kàttì.&gt;&gt;<verse eid="EXO 32:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 32:18" />Musa pè wi eare ama, &lt;&lt;Loàsǝ̀ban mǝno ǝn nggǝ oè ka, mala ɓuà-gāwàn mala kum limurǝm, ko mak'zwalo mala kum kpa a lwa na ɗàng. Gì aɓwana aban tu-nggyal na ǝn nggǝ oè ka.&gt;&gt;<verse eid="EXO 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 32:19" />Lang Musa yi gbashi ban kàttì sǝ sǝn ɓǝ̀nzál mala lo-jamnda andǝ aɓwana aban ta'nggwam ngga, kara bumlulla male pì kùlkùl. Akpamgbǝlang tali mǝnana a buì ka sukkia, à kya arki a nzali a kusǝ nkono. <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />Pǝlǝa twal ɓǝ̀nzál mala lo-jamnda mǝnana à pè ka, túrí a bǝsa panzǝa; goe pǝlǝ mukuì sǝ soé a mùr. Pǝlǝa tsǝia, yì aɓwana mala Isǝrayila ɓǝà nuì.<verse eid="EXO 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />Musa ɗì Haruna ama, &lt;&lt;Mana girnì na aɓwana mǝnia pakko mǝnana tsǝa sǝ a yinǝi mǝnia yì cauɓikea mǝgule amúrià ka?&gt;&gt;<verse eid="EXO 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 32:22" />Haruna pà eare ama, &lt;&lt;Ɓwamǝgule mem, cè bumo lúllô arǝàm ɗàng; a súrǝ́nà rǝ candǝkicau mala aɓwana man arǝ pak mǝɓike. <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" />Yià na à banggam ama, &lt;Pakka sǝm ɓakuli, ɓǝ̀ dupa sǝm a dǝmba ka. Acemǝnana sǝm súrǝ̀ gir mana kum mǝnia yì ɓwa, yì Musa mǝnana pusǝ sǝm aɓa Masar ka ɗàng.&gt; <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />Pǝlǝa ǝn banggia wia nǝma, &lt;Koyan mana kat ndanǝ gìrkiru mala bolo-njengǝlan a kiri ka, ɓǝ̀ pusǝì ɓǝ̀ yinǝi. Nda à pusǝkia, à yinǝia abanam, sǝ ǝn soea a bǝsa ka. Aɓalǝi sǝ mǝnia yì ɓǝ̀nzál mala lo-jamnda ka puro.&gt; &gt;&gt;<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />Musa sǝni ka aɓwana man nyārinà kǝtsǝu, sǝ Haruna na ɗekia atàrǝia à kǝ pàkki agir anggo kǝtsǝu, mǝnana tsǝa à duk gir oalo aban aɓiamǝbura ka. <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />Pǝlǝa Musa yi came a kún kàttì sǝ hama ama, &lt;&lt;Ɓwa mǝnana kat nda a buì mala Yahweh ka, ɓǝ̀ puro ɓǝ̀ yiu abanam!&gt;&gt;</para>
  <para style="p" vid="EXO 32:26">Aburana mǝnana kat à nda a tàu mala Lawi ka, à pùro à yì ramba a baní. <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />Pǝlǝa banggia wia ama, &lt;&lt;Yahweh Ɓakuli mala Isǝrayila kǝ na ama, &lt;Koyan atà wun ngga ɓǝ̀ kùr rǝi nǝ nggeabyau male! Wu kya kutikio arǝ abân aɓa kàttì kat, aɓa koya gumli, sǝ koyan ngga ɓǝ̀ wal-lú aɓǝla, andǝ agyajam, andǝ aɓi amǝ'múrkala.&gt; &gt;&gt;<verse eid="EXO 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 32:28" />Anggo sǝ aburana mǝno a tàu mala Lawi ka pǎ kǝla mǝnana Musa banggia wia ama ɓǝà pàk ka. A pwari mǝno ka à wal-lú ka aɓwana kǝla á-tàrú (3,000). <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />Musa banggi aburana mǝno a tàu mala Lawi ka cau ama, &lt;&lt;Yalung ngga à tàrnà wun ace Yahweh, wun nǝ̀ pàkki wi túrô, sǝ mǝno ka warinǝ wun a wal-lú amuna ma'wun andǝ amǝ'eam wun, ace mǝnana ɓǝ̀ Yahweh tsǝka wun buì a pwari man ngga.&gt;&gt;<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />Lang ban fana ka, Musa banggi aɓwana ama, &lt;&lt;Wu pàngŋǝ̀nà nggea cauɓikea mǝgule. Sǝama ado ka mǝ ndo mǝ nǝ nyare mǝ nǝ eauwe aban Yahweh; yakǝla mǝ nǝ nggá gandǝ shawuɗì wun ace cauɓikea ma'wun.&gt;&gt; <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />Nda Musa nyare o amur Nkono aban Yahweh sǝ banggi wi ama, &lt;&lt;Caukwanban, aɓwana man pángŋǝ̀nà nggea cauɓikea. À ɓangŋǝ́nì ɓamuria ɓakuli nǝ bolo-njengǝlan. <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" />Sǝama, ǝn nggǝ zǝmbô twalia wia banì. Sǝ ɓǝ̀ a pà nǝ twaliabanì raka, ida, esǝki lullǝàm aɓa malǝmce mò mǝnana a gilǝ lullǝ aɓwana mô kàm ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">32:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:28">Ang 69:28</ref>; <ref loc="REV 3:5">Sǝn 3:5</ref></char>.</note><verse eid="EXO 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 32:33" />Sǝ Yahweh ka banggi Musa ama, &lt;&lt;Ɓwa mǝnana pàkkam cauɓikea ka, nda mǝnana mǝ nǝ esǝki lùllǝì aɓa malǝmce mem ngga. <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />Sǝama ado ka, nyare, kyan nǝ aɓwana mǝnia a ban mǝnana ǝn banggo cè ka. Ɓalǝo ɓǝ̀ kasǝa ama Mǝturonjar mem nǝ̀ ká dǝm wun; nǝ̀ lǝmdǝa wun njar. Sǝ ɓǝ̀ pwari mana ǝn tsǝa mǝ nǝ pur'ata aɓwana man ngga yina ka, mǝ nǝ ká arǝ cauɓikea malea amúrià.<note caller="+" style="f"><char style="fr" closed="false">32:34 </char><char style="fq" closed="false">mǝ nǝ ká arǝ cauɓikea malea amúrià </char><char style="ft" closed="false">ko mǝ nǝ pàkkia wia bàndà pepè mǝnana à nǝ̀ oè arǝia ace cauɓikea malea ka.</char></note>&gt;&gt;<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />Nǝnzǝ́mò ka Yahweh tasǝ gìr'mur'mwana mala kwánó mǝɓike mǝnana mesǝ amúrià kat ace gìr mǝnana à pang nǝ ɓǝ̀nzál lo-jamnda mala bolo-njengǝlan mǝnana à tsǝk Haruna ɓakia wia ka.<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">Mǝtalabangŋo banggi amǝ Isǝrayila ɓǝà nying Nkono Saina</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />Yahweh banggi Musa ama, &lt;&lt;Wu loapi ban mǝnia ka, we wunǝ aɓwana mǝnana a pusǝia à purî ɓá nzali Masar ka. Wu bwal njar aban ká a nzali mǝnana ǝn pacau ace nǝ kángìr aban Ibǝrayim, andǝ Ishaku, andǝ Yakupu ama, &lt;Mǝ nǝ pè amunio andǝ amǝ'keo ka.&gt; <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />Mǝ nǝ tasǝ mǝturonjar a ɓadǝmbo, sǝ mǝ nǝ pǝ̀r amǝ'Kan'ana, andǝ amǝ'Amor, andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Hivi, andǝ amǝ'Jebus. <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />Wun ndo wun nǝ̀ ká a nzali mǝɓoarne, mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga. Sǝama pà mǝ nǝ ká atà wun ɗàng, acemǝnana mǝ nggá twàltà wun a njargula raka; wun ngga wun nda ka amǝ'mgbicau.&gt;&gt;<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />Lang aɓwana ok mǝnia yì cau zunggǝli ɓabum ngga, à tíkínǝ múrià ace bumkiɗikea mǝlime, sǝ à tamsǝ oasǝki agir gilǝkirǝu andǝ agir-nggūrǝu mǝɓoarne arǝia. <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />Yahweh ka angŋa dǝmba nanì Musa ɓǝ̀ banggi amǝ Isǝrayila ama, &lt;&lt;Wun nda ka amǝ'ɓamurcandǝa; ɓǝ̀n bang nǝma mǝ nǝ o atà wun zuku ka, mǝ nǝ twalta wun. Ado ka wu swárki agir gilǝkirǝu ma'wun mǝnana arǝ wun ngga, sǝ mǝ nǝ ɓalkiɓabumam amur gir mǝnana mǝ nǝ pangnǝ wun ngga.&gt;&gt; <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />Nda amǝ Isǝrayila swárki agir gilǝkirǝu malea mǝnana arǝia ka, sǝ twal a bàkú mǝno à nying Nkono Saina, yì Horep aban ká dǝmba ka, à nyare à oasǝia ɗǝm ɗàng.<verse eid="EXO 33:6" /></para>
  <para style="s">Tara Ban-peri aban Yahweh <optbreak /> aɓalǝ amǝ Isǝrayila</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />Ɓǝ̀ aya pwari sǝ amǝ Isǝrayila bwal ban mǝnana à nǝ̀ duk kàttì kam ngga, pàkka Musa nǝ̀ twal agir tsǝk tara sǝ nǝ̀ purî kàttì, nǝ̀ nggá tǝm tara zak nǝ kàttì. Yì tara ka tunǝi ama Tara Ban-peri. Koyan sǝ earce nǝ̀ súrǝ̀ ɓekǝ cau aban Yahweh ka, nǝ̀ puro nǝ̀ ká kàm a mǝno yì Tara Ban-peri mǝnana purî kàttì ka. <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />Pwari mana kat Musa puro nǝ̀ ká a mǝno yì Tara ka, aɓwana kat nǝ̀ lo à nǝ̀ cam nǝ came a kún agumli malea aban sǝn Musa sheɓǝ̀ kya kutina aɓalǝi ka. <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />Anzǝm mǝnana Musa kutina aɓa yì tara ka, pǝrɓang nǝ̀ sulǝo nǝ̀ yia cam pǝrapǝra a kún mǝno yì tara ka, sǝ Yahweh nǝ̀ nacau nǝ Musa. <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />Sǝ lang aɓwana sǝn pǝrɓang aban came pǝrapǝra a kún mǝno yì tara ka, koyan atà aɓwana kat ka, nǝ̀ lo sǝ nǝ̀ ɓunno a nzali a kún male yì gumli, sǝ nǝ̀ peri. <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />Anggo ka Yahweh nǝ̀ nacau nǝ Musa ɓamǝsǝu andǝ ɓamǝsǝu, kǝla mǝnana ɓwa kǝ nacau andǝ gyajam male ka. Pǝlǝa Musa nǝ̀ nyare a kàttì, sǝ mǝlagga mǝnana kǝ bwalì wi túró, yì Jesǝwa, muna-ɓwabura mala Nun ngga, uekiyi kano, pà nǝ̀ nying ban mǝno yì tara ka ɗàng.<verse eid="EXO 33:11" /></para>
  <para style="s">Musa zǝmbî Yahweh ɓǝ̀ lǝmdǝì wi ɓoarɓwa male</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />Musa ne Yahweh ama, &lt;&lt;A bangŋǝ́nàm ama, mǝ ging nǝ aɓwana mǝnia ka; sǝ a banggam yana mǝnana awu nǝ tasǝì atàm ngga ɗàng. Nyare a nam ama, a súrǝàm nǝ lullǝam, sǝ ɗǝm ngga bumo kǝ pwasǝ arǝàm. <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />Ɓǝ̀n kumǝna earmúrú a bano ka, kaniam anjar mò, ace mǝnana ɓǝ̀n bwaltò pepè, sǝ ɓǝ̀n lidǝmba aɓa kum earmúrú mô. Ɗenyi ama aɓwana mǝnia ka aɓwana mô na.&gt;&gt;<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />Pǝlǝa Yahweh nyesǝi wi ama, &lt;&lt;Mim nǝ nggearǝam mǝ nǝ o atò, sǝ mǝ nǝ tsǝk ɓālǝo ɓǝ̀ kum usǝlǝo.&gt;&gt;<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />Musa pǝlǝa ne wi ama, &lt;&lt;Ɓǝ̀ a pà wunǝ ká atà sǝm raka, cè a eara sǝm ɓǝ̀ sǝm nying ban mǝnia ɗang. <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />Lang sǝ ɓwa nǝ̀ sǝlǝa ama mim sǝnǝ aɓwana mô ka sǝm kumǝna earmúrú mô, yi mǝnana a o atà sǝm raka? Do mô aɓalǝ sǝm ngga, nda nǝ̀ tsǝk sǝm ɓǝ̀ sǝm pak ɗàngnǝ́ acilia aɓwana kat aɓa ɓanza ka.&gt;&gt;<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />Osso Yahweh ne Musa ama, &lt;&lt;Mǝ nǝ kpata cau mana a na ka, acemǝnana a kumǝna earmúrú abanam, sǝ ǝn súrǝ́nà rǝò nǝ lúllǝò.&gt;&gt;<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />Musa pǝlǝa na ama, &lt;&lt;Mǝ nda ban zǝmbo, lǝmdǝam rǝò aɓa ɓoarɓwa mò.&gt;&gt;<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />Sǝ Yahweh ne Musa ama, &lt;&lt;Mǝ nǝ tsǝk ɓoarɓwa mem kat ɓǝ̀ yi kútí a ɓadǝmbo, sǝ mǝ nǝ hambô lullǝam mana à tunǝki ama &lt;Yahweh&gt; ka. Mǝ nǝ lǝmdǝ ɓwamuru aban ɓwa mǝnana mǝ nǝ lǝmdǝì wi ɓwamuru ka, sǝ mǝ nǝ sǝn mǝsǝswatǝr mala ɓwa mǝnana mǝ nǝ sǝn mǝsǝswatǝr male ka. <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />Sǝ ɓamǝsǝam ngga, a pà nǝ gandǝ sǝne ɗàng, acemǝnana kǝɓwa pà kàm mǝnana nǝ̀ sǝnam sǝ nǝ̀ au ka ɗàng.&gt;&gt;<verse eid="EXO 33:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 33:21" />Pǝlǝa Yahweh lidǝmba, ne wi ama, &lt;&lt;Sǝni, cam kani a banam amur mbisong man. <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />Ɓǝ̀ ɓoarɓwa mem na rǝ kútí ka, mǝ nǝ oasǝǒ aɓa sà-tali, mǝ nǝ gìr muro nǝ buam, she ɓǝ̀n kutinǒ ka. <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />Sǝ mǝ nǝ twal buam, ace mǝnana wu sǝn nzǝmam ngga. Sǝ ɓamǝsǝam ngga, kǝɓwa pà nǝ̀ sǝni ɗàng.&gt;&gt;<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">Musa ɓun bǝsa akpamgbǝlang tali mala kùrcau</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />Pǝlǝa Yahweh banggi Musa ama, &lt;&lt;Ɓun aɓea akpamgbǝlang tali ɓari kǝla atali mǝdǝmbe. Mǝ nǝ gilǝ gir amuria, kǝ akǝ cau mǝnana à nda amur akpamgbǝlang tali mǝnana a arkia ka. <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />Gilǝrǝò ace dǝmbari mala lí, awu nǝ eauwe amur Nkono Saina, awu nǝ lǝmdǝ rǝò abanam a ɓong nkono. <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />Ɓǝ̀ kǝɓwa ɓǝ̀kǝa yiu atò ɗàng; sǝ ɓǝà kǝa sǝn ɓè kǝɓwa a bum ban mala mǝnia yi nkono ka ɗàng; ko anzur, ko andá ka, ɓǝà kǝa sǝnia aban likiagir a kusǝ nkono ɗàng.&gt;&gt;<verse eid="EXO 34:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 34:4" />Musa pǝlǝa ɓun akpamgbǝlang tali ɓari, kǝla amana a dǝmbe ka. Twalia a buì nǝ dǝmbari ɗiɗyal sǝ kya eau nǝia amur Nkono Saina, kǝla mǝnana Yahweh tsǝa ama ɓǝ̀ pàk ka.<verse eid="EXO 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 34:5" />Yahweh yiu sulǝo aɓa pǝrɓang, yi cam kanó a ban Musa, sǝ tunǝ lullǝu mana ama, Yahweh ka. <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />Yahweh pǝlǝa gya kútí a ɓadǝm Musa, sǝ hama ama, &lt;&lt;Mǝ nda Yahweh! Nggearǝ Yahweh! Mǝ nda Ɓakuli mana lùmsǝ nǝ mǝsǝswatǝr andǝ ɓwamuru ka! Bumam kǝ kaurǝa lúllô ɗang, sǝ ǝn lumsǝ nǝ earcearǝu mana kǝ gatti raka, andǝ domǝsǝcau. <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />Ən nggǝ bwal earcearǝu mem nǝ mǝsǝcau aban aɓwana arǝ anza á-pas. Ən nggǝ twalban ɓealɓikea, andǝ mgbikiru, andǝ cauɓikea; sǝama, pà mǝ nǝ nying ɓwa mǝnana à kumi nǝ ɓealɓikea ka, ɓǝ̀ o atarǝì ɓà ɗàng. Ən nggǝ yinǝ ɓashi ace acauɓikea mala atárrú amur amunia andǝ amǝ'keà, aban ká tàruia andǝ inea nza malea.&gt;&gt;<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />Kara Musa ɓun amur ankūnǝi a nzali akaurǝa, sǝ peri. <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />Pǝlǝa na ama, &lt;&lt;Yahweh, ɓǝ̀n kumǝna earmúrú a bano ado ka, ida, We Yahweh do atà sǝm aɓa o ma'sǝm. Aɓwana mǝnia ka, amǝ ɓamúr-candǝa na. Sǝama, twala-sǝm-ban ɓealɓikea andǝ cauɓikea ma'sǝm. Ak sǝm kǝla agirkuma mò.&gt;&gt;<verse eid="EXO 34:9" /></para>
  <para style="s">À loasǝ Kùrcau a bǝshe ɗǝm</para>
  <para style="r">(<ref loc="EXO 23:14-19">Puro 23:14-19</ref>; <ref loc="DEU 7:1-5">Ɓǝs Nggur 7:1-5</ref>; <ref loc="DEU 16:1-17">16:1-17</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />Yahweh pǝlǝa earî Musa ama:</para>
  <para style="pi" vid="EXO 34:10">Adyan ngga, mǝ ndya ǝn nggǝ kùrcau nǝ amǝ Isǝrayila ka. A ɓamǝsǝia kat, mǝ nǝ pakki agir-ndǝlǝki mǝnana à malaká pea aɓa ɓanza ko a ɓekǝ nzali raka. Sǝ aɓwana mǝnana kat wu do aɓalǝia ka, à nǝ̀ sǝn túró mem, Mim Yahweh, acemǝnana gìr'ndali na mǝ nǝ pàngnǝ wun ngga.<verse eid="EXO 34:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="EXO 34:11" />Wu kpata anzongcau mana ǝn nggǝ pà wun ado ka. Sǝni, mǝ ndya mǝ nǝ pǝr amǝ'Amor, andǝ amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Hivi, andǝ amǝ'Jebus, a ɓadǝm wun ngga. <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />Wu tsǝkir wun, wu kǝa na ama wun nǝ̀ kùtí aɓa ɓekǝ kùrcau wunǝ aɓwapǝndǝa mǝnana à do a nzali mǝnana ado wun nǝ̀ ká kàm ngga ɗàng. Ɓǝ̀ wu pàk anggo ka, wun nǝ̀ kpa aɓalǝ agir-tamban malea. <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />A kún mani ka, wun nǝ̀ bǝbbǝriki agyangŋan malea, wun nǝ̀ kiɗikia. Wun nǝ̀ arki akúnamúrú malea, sǝ wun nǝ̀ kasǝki anggun peri mala Ashera, yì mā-ɓakuli malea. <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />Wu kǝa na ama wun nǝ̀ ɓunno a nzali, wun nǝ̀ peri aban ɓekǝ ɓakuli ɗang, acemana Mim Yahweh, mǝnana lullǝàm nda Mɓali ka, mǝ nda Ɓakuli mǝ'mɓali.<verse eid="EXO 34:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="EXO 34:15" />Wu tsǝkir wun, wu kǝa kútí aɓa ɓekǝ kùrcau wunǝ aɓwana mana à do a nzali mǝnia ka ɗàng. Acemǝnana yia ka, ɓǝ̀ à nǝ̀ peri aban aɓakuli malea, sǝ à nǝ̀ ɗārǝ́ agir'nkila aban aɓakuli malea ka, à nǝ̀ tunǝ wun ama wu kya ateà, sǝ wun nǝ̀ liki agirlina mala gir'nkila malea. <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />Sǝ amuna-burana ma'wun nǝ̀ alki amuna-mamǝna malea mǝnana à kǝ peri aban aɓakuli malea ka. Sǝ yia ka, à nǝ̀ swár amuna-burana ma'wun ɓǝà pàk cauɓikea arǝàm nǝ kpata aɓakuli malea.<verse eid="EXO 34:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="EXO 34:17" />A pà wu nǝ pàkkî ɓamúrò ɓekǝ ɓakuli mǝnana à tùllì nǝ bolo-ntùl ka ɗàng.<verse eid="EXO 34:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="EXO 34:18" />Awu nǝ bwal Lamsan mala Bǝredi mǝnana Yis pà arǝì raka, nǝ pakkiɗire male. Kǝla mǝnana ǝn bangga wun ngga, wun nǝ̀ twal anongŋo tongno-nong-ɓari a nzǝmarǝia mǝnana aɓalǝia ka, pà wu nǝ̀ shak bǝredi mǝnana à pè nǝ yis arǝì ka ɗàng. Koya pǝlǝa ka, wun nǝ̀ nggǝ pak mǝnia yì lamsan ngga a pwari mǝnana ǝn kanì ka, aɓa zongŋo Abip; acemǝnana aɓa zongŋo Abip sǝ wu nying Masar.<verse eid="EXO 34:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="EXO 34:19" />Koya muna-dǝmba muna-ɓwabura mǝnana tita puro a bum ngge ka mema; kat andǝ ajamna muna-ndá, andǝ ajamna muna-nzur, andǝ ajamna muna-mbul, mǝnana à tita puro a bum anggea ka.<verse eid="EXO 34:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="EXO 34:20" />Jamna muna mǝdambǝriso mǝnana tita puro a bum ngge ka, awu nǝ akmúrí [a buam, Mim Yahweh, ɓǝ̀ nyare ɓǝ̀ duk mô] nǝ pǎ muna-nzur a kunì. Ɓǝ̀ a pà wu nǝ akmúrí raka, awu nǝ ɓùn myali. Ɗǝm ngga dumǝna púp atà amuna mô ka, koya muna-ɓwabura mǝnana muna-dǝmba na ka, awu nǝ akmúrí nǝ pǎ muna-nzur a kunì.</para>
  <para style="pi" vid="EXO 34:20">Kǝɓwa ɓǝ̀ kǝa yiua peri abanam nǝ ɓabui atarǝì ɗàng.<verse eid="EXO 34:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="EXO 34:21" />Wun nǝ̀ pàk túró aɓa nongŋo tongno-nong-mwashat, sǝ aɓa tongno-nong-ɓaria pwari ka, wun nǝ̀ usǝlǝo; ko ɓǝ̀ nda nǝ kún rya ko nǝ kún pwan-gìrɓaban ngga, she wun nǝ̀ usǝlǝo.<verse eid="EXO 34:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="EXO 34:22" />Dumǝna púp, wun nǝ̀ nggǝ pakkiɗire Lamsan mala Alimo<note caller="+" style="f"><char style="fr" closed="false">34:22 </char><char style="fq" closed="false">Lamsan mala Alimo </char><char style="ft" closed="false">ka nda Lamsan mala Tita Pwan-Gìrɓaban, sǝ à súrǝì aɓa Kùrcau Mǝbǝshe ama Pentikos.</char></note> nǝ paɓoro mala mǝssa mǝnana wu tita pwane a ɓaban ngga, andǝ pakkiɗire mala Lamsan mala Pwan-Gìrɓaban Kat-kat <note caller="+" style="f"><char style="fr" closed="false">34:22 </char><char style="fq" closed="false">Lamsan mala Pwan-Gìrɓaban Kat-kat</char><char style="ft" closed="false">ka nda Lamsan mala Do aɓalǝ Agumli, mǝnana à kǝ pê nǝ kún ɓǝla mala agirɓaban; amǝ'rya kǝ tsǝk gumli a ɓaban ace yál agirɓaban malea ka.</char></note> aban yinǝe a ɓala a masǝlǝata pǝlǝa.<verse eid="EXO 34:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="EXO 34:23" />Kusǝ tàrú a koya pǝlǝa ka, aburana kat à nǝ̀ yiua peri a ɓadǝmbam, Mim Yahweh, yi Ɓakuli mala amǝ Isǝrayila.<verse eid="EXO 34:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="EXO 34:24" />Mǝ nǝ pǝr aɓwana mala aɓea nzali a ɓadǝm wun, sǝ mǝ nǝ tangsǝ anzong-nzali ma'wun; kǝɓwa pà kàm nǝ̀ sham nzali ma'wun ɗàng, mana ɓǝ̀ wu yiu a peri abanam, Mim Yahweh, koya pǝlǝa arǝ abu-pǝlǝa mala alamsan mǝno tàrú ka.<verse eid="EXO 34:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="EXO 34:25" />Ɓǝ̀ wun nǝ̀ pà nkila mala gìr'nkila abanam ngga, pà wun nǝ̀ pè nǝ bǝredi mǝnana à tsǝki wi yis arǝì ka ɗàng. A pwari pakkiɗire mala Lamsan mala Yàlîmurû ka, wu kǝa nying ɓekǝ nyam girkusǝu mǝnana à pana gir'nkila nǝi ka ɓǝ̀ ueo ɓè bankwari ɗàng.<verse eid="EXO 34:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="EXO 34:26" />Koya pǝlǝa ka, wun nǝ̀ twal ban mǝɓoarne kat-kat mala aɓǝlagir mǝdǝmbe mǝnana wu pwano arǝ aɓaban ma'wun ngga, wu yinǝi a ɓala mem, Mim Yahweh, Ɓakuli ma'wun.</para>
  <para style="pi" vid="EXO 34:26">A pà wunǝ lam muna-mbul ko muna-nzur nǝ mùr'kiura nggè ɗàng.<verse eid="EXO 34:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 34:27" />Yahweh pǝlǝa banggi Musa ama, &lt;&lt;Gilǝ amǝnia yì acau ka, acemǝnana nǝ acau mǝnia ka, sǝ ǝn kùrcau sǝnǝ we andǝ amǝ Isǝrayila.&gt;&gt;<verse eid="EXO 34:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 34:28" />Musa ka nda kanó andǝ Yahweh amur nkono dù lumi-ine andǝ pwari lumi-ine; aɓalǝ anongŋo mǝno anggo ka, ko li girlina ɗang sǝ nù mùr gbal ɗàng. Sǝ Yahweh gilǝ acau mala mǝnia yì kùrcau mǝnana pè andǝ aɓwana male ka, yì Anzongcau Lum, amur akpamgbǝlang tali mǝno.<verse eid="EXO 34:28" /></para>
  <para style="s">Tà'nzama mala ɓamǝsǝ Musa</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />Lang Musa sulǝî múr Nkono Saina, nǝ akpamgbǝlang tali mǝno ɓari a buì, yì akpamgbǝlang tali Acau-nakûn ngga, ko sǝlǝ ama ɓamǝsǝi kǝ tà'nzama ɗàng; ɓamǝsǝi kǝ tà'nzama ace nacau mana à na andǝ Yahweh ka.<verse eid="EXO 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 34:30" />Haruna andǝ amǝ Isǝrayila kat pǝlǝ mǝsǝia à sǝn Musa, sǝ à sǝni ka, nggú ɓamǝsǝi kǝ tà'nzama, sǝ ɓangciu pakkia wia arǝ gbashi baní.<verse eid="EXO 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 34:31" />Pǝlǝa Musa tunǝia, sǝ Haruna andǝ aɓwana-mǝgule kat mala ɓinala amǝ Isǝrayila nyare a baní, sǝ Musa nacau nǝia.<verse eid="EXO 34:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 34:32" />Anzǝm mani ka, amǝ Isǝrayila kat, sungŋo a baní tù, sǝ banggia wia anggurcau mana kat Yahweh banggi wi amur Nkono Saina ka. <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />Sǝ lang Musa malǝna nacau nǝia ka, pǝlǝa gìr ɓamǝsǝi nǝ lagir.<verse eid="EXO 34:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 34:34" />Sǝ pwari mana kat Musa wari a ɓadǝm Yahweh ace nacau nǝi ka, nǝ̀ pusǝ lagir mǝno gìrna ɓamǝsǝi nǝi ka, sheɓǝ̀ purnì ɓadǝm Yahweh ka. Sǝ ɓǝ nyarǝna yina aban amǝ Isǝrayila ka, nǝ̀ banggia wia gìr mana Yahweh banggi wi ka. <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" />Amǝ Isǝrayila sǝn Musa ka, nggú ɓamǝsǝi kǝ tà'nzama gbǝang. Pǝlǝa yì gbal ka, nǝ̀ gìr ɓamǝsǝi nǝ lagir, bà pwari mǝnana nǝ̀ ká nacau nǝ Yahweh ka.<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">Anggurcau mala Sabbat</para>
  <para style="r">(<ref loc="EXO 31:14-18">Puro 31:14-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />Musa ram ɓinala amǝ Isǝrayila kat, sǝ banggia wia ama, &lt;&lt;Amǝnia ka à nda ka nggurcau mǝnana Yahweh tsǝka wun ama ɓǝ̀ wu kpatea ka ama:<verse eid="EXO 35:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="EXO 35:2" />&lt;&lt;Wun ndanǝ anonggio tongno-nong-mwashat mǝnana aɓalǝia ka, wun nǝ̀ pàkki atúró ma'wun. Sǝama tongno-nong-ɓaria pwari ka, nǝ̀ do pwari mǝfele na ace wun; pwari Sabbat na à tàrì aban Yahweh ace usǝlǝo. Ɓwa mǝnana pàk túró a mǝnia yì pwari ka, à nǝ̀ wal-luí. <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />Yàle wu kǝa bwal kǝ bǝsa arǝ aɓala ma'wun a pwari Sabbat ɗàng.&gt;&gt;<verse eid="EXO 35:3" /></para>
  <para style="s">Pàɓoro ace agir loasǝ Taragula</para>
  <para style="r">(<ref loc="EXO 25:1-9">Puro 25:1-9</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />Musa lidǝmba bang cau nǝ ɓinala amǝ Isǝrayila kat ama, &lt;&lt;Mǝnia ka nda nggurcau mana Yahweh pa ka, ama:<verse eid="EXO 35:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="EXO 35:5" />&lt;&lt;Wu twal aɓalǝ agirkuma ma'wun, wu pa ɓoro aban Yahweh. Ɓwa mǝnana kat earna a ɓabumi ka, ɓǝ̀ yinǝì Yahweh ɓoro atà amǝnia yì agir ka:</para>
  <para style="li" vid="EXO 35:5">bolo-njengǝlan, andǝ bolo-azǝrfa, andǝ bolo-bángŋá;<verse eid="EXO 35:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="EXO 35:6" />nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe;</para>
  <para style="li" vid="EXO 35:6">nkonggúr-linǝn mǝɓǝlke mana à pyauwì ka, andǝ nggubyau nyang-mbulpǝndǝa;<verse eid="EXO 35:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="EXO 35:7" />nggú gam mǝnana à bàngsǝí ka;</para>
  <para style="li" vid="EXO 35:7">nggú mǝɓǝlke mala ambulpǝndǝa;</para>
  <para style="li" vid="EXO 35:7">kpamgbang mala nggun-akasiya;<verse eid="EXO 35:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="EXO 35:8" />mùrú olif ace pitǝla;</para>
  <para style="li" vid="EXO 35:8">amuku-agir mǝ'kuskushi ace mùrú ɗārǝâ, sǝ ace muku-gìr loasǝ yele mǝ'rǝmɓoarne;<verse eid="EXO 35:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="EXO 35:9" />amunatali-onis, andǝ amǝsǝtali-gǝna ace gilǝkice rǝ efot,<note caller="+" style="f"><char style="fr" closed="false">35:9 </char><char style="ft" closed="false">Ɓal cau amur efot aɓa: </char><char style="xt" closed="false"><ref loc="EXO 28:6-30">Pur 28:6-30</ref>.</char></note> andǝ lǝpan-damɓalǝu male.<verse eid="EXO 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />&lt;&lt;Koya ɓwa aɓalǝ wun mǝnana mǝ'sǝlǝ pakkiagir na ka, ɓǝ̀ yiu ɓǝà yi pak amǝnia yì agir mǝnana kat Yahweh tsǝa ama ɓǝà peǎ ka:<verse eid="EXO 35:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="EXO 35:11" />Taragula, andǝ alagìr mana à kàrì, andǝ lagìr-nggû ace kùmsǝ múr Taragula;</para>
  <para style="li" vid="EXO 35:11">andǝ anlǐ-gyargìr, andǝ anggun-tara, andǝ anggun-gangndea;</para>
  <para style="li" vid="EXO 35:11">andǝ anggun-ɓalǝu andǝ agumtǝli-tǝrteà;<verse eid="EXO 35:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="EXO 35:12" />andǝ Akwati Kùrcau, andǝ agara twale, andǝ gìrkúni mǝnana nda buno sǝntǝ̀r ka, andǝ lagìr-kasǝbân mǝnana nǝ̀ gbàrì ka;<verse eid="EXO 35:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="EXO 35:13" />andǝ kpamgbang-tsǝk-agir andǝ agara twale, andǝ akwar male, andǝ bǝredi mala ɓadǝm Yahweh;<verse eid="EXO 35:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="EXO 35:14" />andǝ gìr-tàmsǝ apitǝla ace pà tǎlaban andǝ agirtúró male kat;</para>
  <para style="li" vid="EXO 35:14">andǝ apitǝla andǝ mùrú olif ace tsǝk bǝsa malea;<verse eid="EXO 35:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="EXO 35:15" />andǝ gyangŋan mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne, andǝ agara twale;</para>
  <para style="li" vid="EXO 35:15">andǝ mùrú-ɗārǝ́bân, andǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne;</para>
  <para style="li" vid="EXO 35:15">andǝ lagìr-gyare a kún bankutio aɓa Taragula;<verse eid="EXO 35:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="EXO 35:16" />andǝ gyangŋan mala pagìr ace pisǝe kǝring andǝ bàndà bolo-bángŋá male, andǝ agara twale andǝ agirtúró male kat;</para>
  <para style="li" vid="EXO 35:16">andǝ nkenye lákkí arǝu andǝ girtàmsǝe;<verse eid="EXO 35:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="EXO 35:17" />andǝ alagìr ace gumbǝli patal mala Taragula, andǝ anggun-kala male andǝ agumtǝli-tǝrteà mana à nǝ̀ camgi aɓalǝia ɓǝà kàrì patal ka;</para>
  <para style="li" vid="EXO 35:17">andǝ lagìr ace gbar kún patal;<verse eid="EXO 35:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="EXO 35:18" />andǝ ankpako mala anggúr Taragula andǝ mala anggun-kal patal;<verse eid="EXO 35:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="EXO 35:19" />andǝ adaura-pǝris mǝnana à teǎ pepè ace peri, yì adaura mǝfele ace Haruna pǝris mǝgule, andǝ adaura mala amuna-burana male, mǝnana à nǝ̀ oasǝ arǝia ɓǝ̀ à nǝ̀ pàk túró pǝris aɓa Ban Mǝfele ka.&gt;&gt;<verse eid="EXO 35:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />Nda ɓinala amǝ Isǝrayila kat purî ɓadǝm Musa. <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />Koya ɓwa mǝnana twalcau a bumi nǝ̀ pàk ɓè gìr, andǝ koyan mǝnana bangŋo male loasǝi ka, à puro à yinǝì Yahweh ɓoro mala aɓea agir ace loasǝ Tara Ban-peri, ace pàkki atúró kat aɓalǝi, sǝ ace adaura mǝfele mala apǝris. <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />Aɓwana kat, aburana andǝ amamǝna, mǝnana à ndanǝ ɓabum mala earce pà gìr ka, à yinǝ aɓoro mala agirgilǝki-rǝu, agirkiru, agirmunabu, agirgarabu, andǝ agir ɗàngɗáng mǝnana à peǎ nǝ bolo-njengǝlan ngga; koyan ngga pà gìr bolo-njengǝlan male, ɓoro na aban Yahweh. <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />Koyan mǝnana ndanǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ nggubyau-linǝn mǝɓǝlke, andǝ nyang mbulpǝndǝa, andǝ nggú nzur mǝnana à bàngsǝí, ko nggú mǝɓǝlke mala ambulpǝndǝa ka, à yinǝia. <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />Ɓwa mana kat ndanǝ bolo-azǝrfa ko bolo-bángŋá ka, yinǝi yi pana ɓoro nǝi aban Yahweh, sǝ ɓwa mana kat ndanǝ nggun-akasiya mǝnana à nǝ̀ pàngŋǝ̀nà túró nǝi ace koya ulang túró ka, yinǝi. <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />Amamǝna mana kat à sǝlǝ túróbù ka, à pyau nkonggúr nǝ bu, sǝ à yinǝ ankonggúr linǝn mǝɓǝlke andǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe mǝnana à pyau ka. <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />Sǝ amamǝna mana kat à súrǝ̀ túró pyau nyang mbul, sǝ ɓabumia loasǝia ka, à pàk túrè. <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />Amǝ'yálmúrû yinǝ amunatali-onis, andǝ amǝsǝtali-gǝna mǝtà'nzame ace gilǝkice rǝ efot, andǝ lǝpan-damɓalǝu male. <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />Aɓea gir ɗǝm mana à yinǝia ka, à nda ka amuku-agir mǝ'kuskushi ace loasǝ yele mǝ'rǝmɓoarne, andǝ mùrú olif ace ɗārǝâ, sǝ ace tsǝk bǝsa a pitǝla.<verse eid="EXO 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 35:29" />Amǝ Isǝrayila kat, aburana andǝ amamǝna, mǝnana ɓabumia eare à nǝ̀ yinǝ koman kat ace túró mana Yahweh bangŋǝ́nì Musa ama ɓǝà pè ka, à yinǝia à yi pana ɓoro nǝia aban Yahweh, kǝla mana ɓabumia twal ka.<verse eid="EXO 35:29" /></para>
  <para style="s">Túró kpapiki Taragula a bu Bezal-El andǝ Oholiyap</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />Pǝlǝa Musa banggi amǝ Isǝrayila ama, &lt;&lt;Wu sǝni, Yahweh tunǝna sǝ twalna Bezal-El, muna-ɓwabura mala Uri, mǝkà Hur, a tàu mala Yahuda; <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />sǝ lùmsǝ̀nì nǝ Bangŋo mala Ɓakuli, pani wi kwárô aɓa ɗenyicau, andǝ sǝlǝe, andǝ bwaltagìr, andǝ súrǝ̀ pàk koya ulang gìr nǝ bu; <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />nǝ̀ gandǝ nyoulǝ pǎ mala anggaman gìr amǝɓoarsǝne ɗàng-ɗáng andǝ tùlki agir nǝ bolo-njengǝlan, bolo-azǝrfa, andǝ bolo-bángŋá; <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />ndanǝ sǝlǝpe mala kpaliki rǝ atali-gǝna ace oasǝkia aɓalǝ agir-bwalia, andǝ mala shàr nggun, ace pusǝ anggaman gìr ɗàng-ɗáng. <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />Yahweh pani wi andǝ Oholiyap, muna-ɓwabura mala Ahisamak, a tàu mala Dan, sǝlǝe mala kànî aɓwana túróbù malea. <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />Lùmsǝ̀nia nǝ sǝlǝpe mala pàkki atúróbù kat mala mǝ'nyoulǝ pa mala agir; andǝ mala mǝ'mbàkì gìr mǝɓoarsǝne arǝ nggubyau nǝ nkonggúr mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ nkonggúr linǝn mǝɓǝlke; andǝ mala mǝ'tà-nggubyau. Yale à nǝ̀ gandǝ pak koya ulang nggaman túróbù.<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />&lt;&lt;Bezal-El, andǝ Oholiyap, andǝ acili amǝ'túróbù mǝnana kat Yahweh pania wia sǝlǝe andǝ bwaltagìr, yia mǝnana à súrǝ̀ lang sǝ à nǝ̀ pàk koya túró mala pàk Tara-mǝfele ka, à nǝ̀ pàk túrè aɓa kpata gìr mǝnana kat Yahweh tsǝk ama ɓǝà pè ka.&gt;&gt;<verse eid="EXO 36:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />Nda Musa túrban à tunǝ a Bezal-El andǝ Oholiyap andǝ koya mǝ'sǝlǝ pakkiagir, yià mǝnana Yahweh pania wia sǝlǝpe a ɓabumia, koyan ateà mǝnana ɓabumi loasǝi ka, ɓǝà yiu ɓǝà pàk túrè. <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />Musa pea wia aɓoro mǝnana kat amǝ Isǝrayila yinǝia ace pàk túró mala Tara-mǝfele ka. Sǝ kat andǝ amǝno ka, aɓwana lidǝmba nǝ yinǝì Musa aɓoro malea mǝnana à pa nǝ eare mala ɓabumia ka koya dǝmbari. <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />Nda amǝ'túróbù mǝnia kat, yià mana à kǝ pàkkì atúró ɗàngɗáng mala Tara-mǝfele ka, koyan ngga nying bui arǝ túró mǝnana pàkkiyi ka. <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />À lo à wari aban Musa sǝ à banggi wi ama, &lt;&lt;Aɓwana pànà gìr mǝnana kútì mana kārǝ́na ace mal túró mǝnana Yahweh tsǝka sǝm ama ɓǝ̀ sǝm pè ka, sǝ à nda rǝ yinǝ agir più!&gt;&gt; <verse eid="EXO 36:5" /><verse number="6" style="v" sid="EXO 36:6" />Pǝlǝa Musa tasǝban ɓǝà hamnǝ cau aban aɓwana arǝ abân kat aɓa là-gumli ama, &lt;&lt;Aɓwana ɓǝà tàmsǝ pagìr ace túró mala Tara-mǝfele, kārǝ́na anggo.&gt;&gt; Nda aɓwana came, à yinǝ ɓekǝ ɓoro ɗǝm ace túró Tara-mǝfele raka. <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />Agir mǝnana aɓwana angŋa dǝmba à pànà ka, à kútì mana à nǝ̀ earce ace pàk túrè kat ka.<verse eid="EXO 36:7" /></para>
  <para style="s">Túró pàk Taragula mala Yahweh</para>
  <para style="r">(<ref loc="EXO 26:1-37">Puro 26:1-37</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />Amǝ'sǝlǝ pakkiagir mǝnana kat aɓalǝ amǝ'túró mǝnia ka, à pàk alagìr mǝtangge lum ace kùmsǝ múr tara mala Taragula. Yì alagìr ka, à peǎ nǝ anggubyau linǝn mǝɓǝlke mana à tè mǝsǝi kèkì ka. Mǝ'sǝlǝ tagìr tà aɓǝ̀nzál mala acerup arǝia nǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe mǝnana à pyauwì ka. <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />Yì alagìr ka gulo malea kārǝa; komǝye ka sauwa male na ɓakusǝu lumi-ine nong ɓari (42), sǝ tangŋa malea ka ɓakusǝu tongno-nong-mwashat na. <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />Tongno atà alagìr man ngga à swària a kunarǝia à duk lagìr mǝsauwe mwashat, sǝ acilia man tongno gbal ka à swària a kunarǝia à duk ɓè lagìr mǝsauwe mwashat. <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />À pàk atǝkrǝk nǝ nkonggúr ɗà'ndíng mǝlùre, sǝ à ɗúrkia a nkanggari arǝia a kún alagìr mǝsake mǝnia ɓari ka. <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />À ɗúrki atǝkrǝk nkonggúr lumi-tongno a kún ɓè lagìr mǝsauwe man mwashat ka, sǝ à ɗúrki lumi-tongno a kún ɓaria lagìr mǝsauwe. Atǝkrǝk mala ɓè lagìr ka à came a nkāɓe gǝ̀rgǝ̀r nǝ atǝkrǝk mala ɓì lagìr. <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />À pàk anlǐ-bwalkúngir lumi-tongno nǝ bolo-njengǝlan. À bwalki atǝkrǝk kún ɓè lagìr mǝsauwe man mwashat ka, sǝ à kpapia a kúnarǝ atǝkrǝk kún ɓe lagìr mǝsauwe mǝno ka, nǝ anlǐ-bwalkúngir, sǝ alagìr mǝsake mǝnia ɓari ka à duk mwashat. Anggo sǝ do ama tara mala Taragula ka, lagìr mwashat na à kùmsǝì nǝi ka.<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />À pàk alagìr lum-nong-mwashat nǝ anggu-mbulpǝndǝa ace kùmsǝ múr tara mala Taragula. <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />Amǝnia yì alagìr lum-nong-mwashat ka à kārǝa; sauwa mala komǝye ka nda ɓakusǝu lumi-ine bwamdǝ tongno, sǝ tangŋa mala komǝye ka ɓakusǝu tongno-nong-mwashat na. <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />Tongno ateà ka à kpapia sǝ à swària a kunarǝia à duk lagìr-nggû mǝsauwe mwashat, sǝ aman tongno-nong-mwashat ka à swària gbal a kunarǝia à duk ɓaria lagìr-nggû mǝsauwe. <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />À ɗúrki atǝkrǝk nkonggúr lumi-tongno a nkanggari arǝia a gírí-kún ɓe lagìr-nggû mǝsauwe mǝnia, sǝ à ɗúrki lumi-tongno a nkanggari arǝia a gírí-kún ɓi lagìr-nggû mǝsauwe man mwashat, mǝnana à nǝ̀ kpapia a kunarǝia ka. <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />À pàk anlǐ-bwalkúngir nǝ bolo-bángŋá, yia lumi-tongno. À oasǝkia aɓalǝ atǝkrǝk gírí-kún alagìr-nggû amǝsake mǝnia ɓari ka, sǝ à kpapia a kúnarǝia à duk lagìr-nggû nggea mǝgule mwashat, mǝnana à gìrna múr Taragula nǝi ka.<verse eid="EXO 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 36:19" />À pàk aɓea lagìr-nggû kàm ɓari ɗǝm ace kùmsǝ múr Taragula. Man mwashat ka à pè nǝ anggû ka gam mǝnana à bangsǝi ka, sǝ ɓè man, mǝnana masǝlǝi aɓî nǝ̀ sarǝa amúrià a kùli ka, à pè nǝ nggú mǝɓǝlke mala ambulpǝndǝa.<verse eid="EXO 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20" />À pàk anggun-tara mǝ'sàré ace Taragula nǝ akpamgbang mala nggun-akasiya. <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />Dāh'rya mala koya nggun-tara ka ɓakusǝu lum-bwamdǝ-tongno na, sǝ tangŋa mala komǝye ka, ɓakusǝu ɓari nǝ incì tàrú na. <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />Akpamgbang ɓari mala koya nggun-tara ka, à kārǝ́ kunia gǝ̀rgǝ̀r sǝ à shària pyalpyal. Anggo sǝ à pàk anggun-tara mala Taragula kat. <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />À pàk anggun-tara mala Taragula kǝla mǝno ka, sǝ à tamsǝkia ani: lumi-ɓari ka à tsǝia a bumban mǝnana sǝn njar-kunmur ka. <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />À pàk agumtǝli-tǝrtà anggun-tara nǝ bolo-azǝrfa yià lumi-ine ace bwal akusǝ anggun-tara lumi-ɓari; agumtǝli-tǝrtè ɓari, komǝye ka nǝ tūli male arǝì, na a kusǝ koya nggun-tara, ace bwal akusǝ akpamgbang amǝ'pyalpyalni ɓari mala nggun-tara. <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />A bumban mala Taragula mǝnana sǝn njar-nza ka, à tsǝk anggun-tara lumi-ɓari, <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />nǝ agumtǝli-tǝrteà mǝnana à pea nǝ bolo-azǝrfa ka lumi-ine, ɓari a kusǝ koya nggun-tara. <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />Sǝ ace nzǝm Taragula, yì bumban mǝnana sǝn njar-nzali ka, à tsǝk anggun-tara tongno-nong-mwashat. <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />À tsǝk aɓea anggun-tara ɓari ɗǝm, mwashat ace koya bankara a nzǝm Taragula. <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />Anggun-tara ɓari-ɓari arǝ abankara ɓari ka, à kpapi tǝrtea a ban mǝ'mwashati, sǝ múrià ka à kùria nǝ gbalmo kàngkàng à duk mwashat a koya bankara. Yì anggun-tara arǝ abankara mǝno ɓari ka anggo sǝ à pangnǝia. <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />Lǝmdǝ ama à kpapia kat ka, nzǝm Taragula na nǝ anggun-tara tongno-nong-tàrú aban came aɓalǝ agumtǝli-tǝrteà lum-bwamdǝ-tongno-nong-mwashat, mǝnana à peǎ nǝ bolo-azǝrfa ka; koya nggun-tara ka, akusǝi cam aɓalǝ agumtǝli-tǝrtè ɓari.<verse eid="EXO 36:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31" />À pàk anggun-gangndea lum-bwamdǝ-tongno mala nggun-akasiya ace kpapiki anggun-tara. À tsǝk anggun-gangndea tongno mana à kpapiki anggun-tara mala Taragula a bumban mǝnana sǝn njar-nza ka, <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />tongno a bumban male mǝnana sǝn njar-kunmur ka, sǝ tongno a nzǝmi, yì bumban mǝnana sǝn njar-nzali ka. <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />A koya bumban mala Taragula ka, à tsǝk nggun-gangndea mǝnana à bwalki anggun-tara a tsùrú malea ka; tite arǝ nggun-tara mǝnana nda a masǝlǝata ban ngga aban ká ɓè masǝlǝata ban mala Taragula. <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />Anggun-tara ka à tasǝrǝia nǝ bolo-njengǝlan, sǝ à kùrkia wia agbalmò bolo-njengǝlan ace bwal anggun-gangndea mǝnana à nǝ̀ oasǝkia aɓalǝia ka. Yià anggun-gangndea ka à tasǝrǝia gbal nǝ bolo-njengǝlan.<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />À pàk lagìr-kasǝbân ace gau ɓá Taragula nǝ nggubyau-linǝn mǝɓoarne mǝnana à tè mǝsǝì kèkì ka. Mǝ'sǝlǝ pakkiagir pàktúró nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe sǝ tà pǎ mala acerup ɓǝà lǝmdǝa arǝì. <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />Ace gyar mǝnia yì lagìr-kasǝbân ngga, à kasǝ anggun-ɓalǝu mala kpamgbang-akasiya amǝsake ine mǝnana à tasǝrǝia nǝ bolo-njengǝlan ngga. Komǝye ka à pàkki wi gumtǝli-tǝrtè nǝ bolo-azǝrfa ace tamsǝe aɓalǝi, sǝ à pàk anlǐ-gyargìr malea nǝ bolo-njengǝlan. <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />Ace gbar bankutio aɓa Taragula ka, à pàk lagìr-gbarban nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pūrǝki arǝarǝia ka. Mǝ'sǝlǝ tagìr nǝ bù, mbákí rǝì nǝ tagìr mǝɓoarsǝne, nǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe. <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />À pàk anggun-ɓalǝu mǝsake tongno andǝ anlǐ-gyargìr malea. À tasǝ rǝ anggun-ɓalǝu mǝnia andǝ ankò malea nǝ bolo-njengǝlan, sǝ agumtǝli-tǝrteà ka bolo-bángŋá na. <figure style="fig" alt="Tabernacle of the LORD" file="co00844b.tif" size="col" loc="36:38" copy="Cook OT Images" ref="36:8-38">Taragula mala Yahweh</figure><verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">Pàk Akwati Kùrcau</para>
  <para style="r">(<ref loc="EXO 25:10-22">Puro 25:10-22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />Bezal-El gbàllì Akwati Kùrcau nǝ kpamgbang mala nggun-akasiya; sauwa male ka ɓakusǝu tàrú nǝ incì tongno-nong-ine na, tangŋa male ka ɓakusǝu ɓari nǝ incì tàrú, sǝ dāh'rya male ka ɓakusǝu ɓari nǝ incì tàrú na. <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />Gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne, ɓālǝi andǝ nzǝmi, sǝ ɓak bolo-njengǝlan kàrì kúni kat. <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />Tùl agbalmò ine mala bolo-njengǝlan ace, sǝ komǝye ka kpapì arǝ nkanggariban mala mwashat atà akusǝ akwati. <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />Shàr agara mala nggun-akasiya sǝ tasǝ rǝia nǝ bolo-njengǝlan, <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />sǝ oasǝ agare aɓalǝ agbalmò mana arǝ ankanggariban mala Akwati ka ace twale. <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />Pǝlǝa pàk gìrkún Akwati nǝ bolo-njengǝlan mǝɓoarne kat, ɓǝ̀ do nda buno sǝntǝ̀r.<note caller="+" style="f"><char style="fr" closed="false">37:6 </char><char style="fq" closed="false">buno sǝntǝ̀r </char><char style="ft" closed="false">ka nda ban shawuɗiban ace cauɓikea; ban watsǝki nkila a kusǝ buno-murǝm mala Ɓakuli, yì ban mǝnana Ɓakuli nǝ̀ gìrmúr cauɓikea, ko nǝ̀ twalban cauɓikea mala aɓwana ka. Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 25:17-18">Pur 25:17-18</ref>,<ref loc="EXO 25:22">22</ref>; <ref loc="HEB 9:5">Ib 9:5</ref> </char>.</note> Sauwa male ka ɓakusǝu tàrú nǝ incì tongno-nong-ine na, sǝ tangŋa male ka ɓakusǝu ɓari nǝ incì tàrú na. <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />Tùl aɓǝ̀nzál mala acerup ɓari nǝ bolo-njengǝlan mǝnana à walki ka, sǝ tsǝia arǝ akún-bân ɓari amur gìrkún Akwati, yì gìrkúni mǝnana nda buno sǝntǝ̀r ka. <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />Tsǝk cerup man mwashat ka a ɓè kún-bân, sǝ ɓè cerup ka tsǝì a nkāɓe ɓì a ɓè kún-bân amur gìrkún Akwati. Bolo-njengǝlan mǝnana à pàk acerup nǝi ka kpapì arǝ bolo-njengǝlan mǝnana à pàngŋǝ̀nà gìrkún Akwati nǝi ka, ace mǝnana ɓǝà duk mwashat ka. <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />Tsǝk acerup, komǝye ka ɓamǝsǝi pǝlǝ nǝban ɓamǝsǝ ɓi. Ɓamǝsǝia kǝ sǝn múr gìrkún Akwati, yì buno sǝntǝ̀r, sǝ abuia mǝnana à mǝn a kùli ka, à kùmsǝó amur gìrkúni, yì buno sǝntǝ̀r.<verse eid="EXO 37:9" /></para>
  <para style="s">Kpamgbang ace tsǝk Bǝredi Mǝfele</para>
  <para style="r">(<ref loc="EXO 25:23-30">Puro 25:23-30</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />Bezal-El andǝ aɓî amǝtúró pǝlǝa à gbàllì kpamgbang mala nggun-akasiya, ace tsǝk agir amurí; sauwa male ka ɓakusǝu tàrú na, tangŋa male ka ɓakusǝu mwashat nǝ incì tongno-nong mwashat, sǝ dāh'rya male ka ɓakusǝu ɓari nǝ incì tàrú na. <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />À gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne, sǝ à ɓak kúní kàrì nǝ bolo-njengǝlan. <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />Múr kpamgbang mana sárǝ́ ka, pàkki wi mǝ-nzong mǝnana nyane male ka incì tàrú na ka, kàrì kúní kat, sǝ ɓak bolo-njengǝlan kàrì mǝ-nzongnì. <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />À tùl agbalmò ine nǝ bolo-njengǝlan, sǝ à tsǝkia arǝ abankara ine arǝ akusǝ kpamgbang ine. <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />Yìa agbalmò ine ka à tsǝia à gbàshìban nzong kún kpamgbang mala tsǝk agir arǝ akusǝì, ace bwal agara mǝnana à nǝ̀ nggǝ twali nǝia ka. <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />Yì agara ace twale ka à pea nǝ nggun-akasiya, sǝ à gìr rǝia kat nǝ bolo-njengǝlan. <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />À pàk atanggǝla mala múr kpamgbang-tsǝk-agir nǝ bolo-njengǝlan mǝɓoarne; yì aparanti male, andǝ atasau male ace loasǝ yele mǝ'rǝmɓoarne, andǝ amuna-nkenye male, andǝ amuna-bàng male mala apagir mala girnùná.<verse eid="EXO 37:16" /></para>
  <para style="s">Gìr-tàmsǝ apitǝla</para>
  <para style="r">(<ref loc="EXO 25:31-40">Puro 25:31-40</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />À pàk gìr-tàmsǝ apitǝla nǝ bolo-njengǝlan mǝɓoarne. Kusǝì andǝ garè mǝnana nǝ̀ cam a ɓaɓalǝu, andǝ nyoulǝa rǝi mǝnana kǝla tǒ mala fufe, andǝ apwasǝe andǝ atǝ́r-fufe ka, à pea kat nǝ gumtǝli bolo-njengǝlan mwashat mǝnana à walki ka. <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />À pè nǝ abui tongno-nong-mwashat mǝnana à san arǝ garè mana a ɓaɓalǝu ka; tàrú a nkanggari man sǝ tàrú a ɓè nkanggari. <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />Komǝye atà abui tongno-nong-mwashat ka à ɓak rǝi lǝmdǝ tǒ mala afufe tàrú mala nggun-almon, andǝ apwasǝia andǝ atǝ́r-fufe malea. <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />Garè mǝnana a ɓaɓalǝu ka à ɓak rǝi lǝmdǝ pǎ mala afufe ine mala nggun-almon nǝ apwasǝia andǝ atǝ́r-fufe malea. <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />Tǝ́r-fufe mwashat ka nda a koya ban-kpapí mala abui ɓari-ɓari banì tàrú arǝ garè. <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />Yì gìr-tàmsǝ apitǝla andǝ nyoulǝa rǝi mala fufe andǝ apwasǝe andǝ atǝ́r-fufe ka, à pè kat nǝ gumtǝli bolo-njengǝlan mǝɓoarne mwashat mǝnana à walki ka. <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />À pàk apitǝla male tongno-nong-ɓari, andǝ amǝmyal<note caller="+" style="f"><char style="fr" closed="false">37:23 </char><char style="fq" closed="false">amǝmyal </char><char style="ft" closed="false">ace kǝtǝriki tú kún lagwani</char></note> male, andǝ atasau-bǝsa<note caller="+" style="f"><char style="fr" closed="false">37:23 </char><char style="fq" closed="false">atasau-bǝsa </char><char style="ft" closed="false">ace pwan tú mala pitǝla.</char></note> male nǝ bolo-njengǝlan mǝɓoarne. <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />À pàktúró nǝ bolo-njengǝlan mǝɓoarne mǝnana dǝmbǝrya male ka tyang lumi-tàrú-bwamdǝ-tongno [35] na ka, sǝ à pàk yì gìr-tàmsǝ apitǝla andǝ agirtúró male kat.<verse eid="EXO 37:24" /></para>
  <para style="s">Pàk gyangŋan mala loasǝ yele mǝ'rǝmɓoarne</para>
  <para style="r">(<ref loc="EXO 30:1-5">Puro 30:1-5</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />À pàk gyangŋan mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne nǝ nggun akasiya. Tangŋa male andǝ sauwa male ka à kārǝa, komǝye ka ɓakusǝu mwashat nǝ gauwa-tsùrú, sǝ dāh'rya male ka ɓakusǝu tàrú na. Koya nkanggari ka à tsǝki wi njawe nǝ ulang kǝ nggun mǝnana à pè nǝi ka, à duk mwashat. <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />À gìr rǝi kat nǝ bolo-njengǝlan mǝɓoarne: múrí, andǝ ankanggari, andǝ anjawe. À ɓak bolo-njengǝlan kàrì kúni kat. <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />À tsǝki wi agbalmò bolo-njengǝlan ɓari arǝ ankanggari; à tsǝia à sulǝî ban kúní mana à ɓè ka bǝti, sǝ à came a nkāɓe rǝarǝia. Agbalmò ka à nda ace oasǝ agara mǝnana à nǝ̀ nggǝ twali nǝia ka. <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />Agara twale ka à peǎ nǝ nggun-akasiya, sǝ à tasǝ rǝia nǝ bolo-njengǝlan.<verse eid="EXO 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />À pàk mùrú mǝfele ace ɗārǝ́bân sǝ à kpapiki amuku-agir mǝɓoarne ace loasǝ yele mǝ'rǝmɓoarne; à pè kǝla mǝnana mǝ'sǝlǝ pakki agir pà rǝmban mǝɓoarne nǝ̀ pè ka.<note caller="+" style="f"><char style="fr" closed="false">37:29 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 30:22-28">Pur 30:22-28</ref></char>.</note><verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">Gyangŋan ace pàɓoro mala pisǝe kǝring</para>
  <para style="r">(<ref loc="EXO 27:1-8">Puro 27:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />aPǝlǝa Bezal-El pàk gyangŋan nǝ nggun-akasiya ace pàgir mala pisǝe kǝring; sauwa male ka ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú, tangŋa male ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú, sǝ dāh'rya male ka, ɓakusǝu ine nǝ gauwa-tsùrú na. <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />Pǝlǝa pàk anjawe male arǝ abankara ine amurí. Yì gyangŋan andǝ anjawe ka à shària nǝ nggun mǝmwashati, sǝ à gìr rǝi kat nǝ bolo-bángŋá. <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />Sǝ pàk agirtúró male kat: ankwaring-bolo, andǝ ashebǝl, andǝ ankenye, andǝ ashokali-soagìr, andǝ atasau-bǝsa. Amǝnia yì agirtúró kat ka, à peǎ nǝ bolo-bángŋá. <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />Pǝlǝa pakkî gyangŋan bàndà male nǝ waya bolo-bángŋá mǝnana à tè aɓalǝarǝia kǝla ndǝambu ka; à oasǝi aɓa gyangŋan, sulǝî kúni, yi came a ɓalǝu. <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />Tùl agbalmò ine arǝ abankara a kún bàndà bolo-bángŋá ace oasǝ agara twale. <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />Pàk agare ɓari nǝ nggun-akasiya, sǝ tasǝ rǝia nǝ bolo-bángŋá. <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />Sǝ oasǝ agara mǝno aɓalǝ atūli gbalmò arǝ ankanggari gyangŋan ace twale. Shàr gyangŋan mǝnia ka nǝ akpamgbang, nying ɓālǝi nong horondong.<verse eid="EXO 38:7" /></para>
  <para style="s">À pàk nkenye lákkí arǝu</para>
  <para style="r">(<ref loc="EXO 30:18-21">Puro 30:18-21</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />Bezal-El pàk nkenye nǝ bolo-bángŋá ace lákkí arǝu, sǝ girtàmsǝe ka à pè gbal nǝ bolo-bángŋá; pè nǝ atapwari-bolobangŋá mala amamǝna mana à kǝ pàktúró a kún Tara Ban-peri ka.<note caller="+" style="f"><char style="fr" closed="false">38:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:18">Pur 30:18</ref>; <ref loc="1SA 2:22">1Sam 2:22</ref></char>.</note><verse eid="EXO 38:8" /></para>
  <para style="s">Kàrì patal mala Tara Ban-peri</para>
  <para style="r">(<ref loc="EXO 27:9-19">Puro 27:9-19</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />Pǝlǝa kasǝ patal ace Taragula. A bumban male mǝnana sǝn njar-kunmur ka gyarki alagìr nggubyau-linǝn mana à teǎ pepè ka; sauwa malea ka, ɓakusǝu gbǝman-mwashat nǝ lumi-tongno na (150). <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />Gyarkia arǝ anggun-kala lumi-ɓari aban camge aɓalǝ agumtǝli-tǝrteà lumi-ɓari, mana à peǎ kat nǝ bolo-bángŋá ka; sǝ anlǐ-gyargìr mala anggun-kala andǝ ankò malea ka, bolo-azǝrfa na à peǎ nǝi ka. <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />Sǝ ace bumban mǝnana sǝn njar-nza ka, à gyarki alagìr male mǝnana sauwa malea ka ɓakusǝu gbǝman-mwashat nǝ lumi-tongno na (150) ka. Anggun-kala lumi-ɓari andǝ agumtǝli-tǝrteà lumi-ɓari ka, à peǎ kat nǝ bolo-bángŋá; sǝ anlǐ-gyargìr mala anggun-kala andǝ ankò malea ka, bolo-azǝrfa na à peǎ nǝi ka.<verse eid="EXO 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 38:12" />Sǝ ace bumban mǝnana sǝn njar-nzali ka, sauwa mala alagìr male ka ɓakusǝu lumi-tongno-nong-ɓari bwamdǝ tongno na (75). À gyarkia arǝ anggun-kala lum aban camge aɓalǝa agumtǝli-tǝrteà lum; anlǐ-gyargìr mala anggun-kala andǝ ankò malea ka, bolo-azǝrfa na à peǎ nǝi ka. <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />A bumban mǝnana sǝn eauwe mala pwari a njar-takuli, a bankutio aɓa patal mala Taragula ka, sauwa mala lagìr male ka ɓakusǝu lumi-tongno-nong-ɓari bwamdǝ tongno na (75). <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />Koya buì mala bankutio a patal mala Taragula ka, ndanǝ lagìr male. Sauwa mala lagìr mǝnana a bu-mǝlì mala kun patal ka, ɓakusǝu lumi-ɓari-nong-ɓari nǝ gauwa-tsùrú na (22.5). À gyari arǝ anggun-kala tàrú aban came aɓalǝ agumtǝli-tǝrteà tàrú. <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />Anggo gbal sǝ pa a bu-mǝnggare. Sauwa mala lagìr male ka ɓakusǝu lumi-ɓari-nong-ɓari nǝ gauwa-tsùrú na (22.5). À gyari arǝ anggun-kala tàrú aban came aɓalǝ agumtǝli-tǝrteà tàrú. <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />Alagìr mǝnana kat à gumbǝli patal ka, à peǎ nǝ nggubyau linǝn mǝɓǝlke mǝnana à tè mǝsǝi kèkì ka. <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />Agumtǝli-tǝrtà anggun-kala ka à peǎ nǝ bolo-bángŋá; sǝ anlǐ-gyargìr mala anggun-kala andǝ ankò malea ka, à peǎ nǝ bolo-azǝrfa. Anggun-kala ka à tasǝ ɓongŋia nǝ bolo-azǝrfa. Anggun-kala mǝnana kat à kàrì patal ka, à pàkkia wia ankò mala bolo-azǝrfa.<verse eid="EXO 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 38:18" />Lagìr mala gbar kunɓala ka, à pè nǝ nggubyau-linǝn mǝɓoarne mǝnana à nyoulǝ rǝi aɓa sǝlǝ tagìr mǝɓoarsǝne nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe ka. Sauwa male ka, ɓakusǝu lumi-tàrú na (30), sǝ dāh'rya male ka ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú na (7.5), kǝla mǝnana alagìr mala patal pàk ka. <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />À tsǝki wi anggun-kala male ine mǝnana à camgi aɓalǝ agumtǝli-tǝrteà mala bolo-bángŋá ine ka. Anlǐ-gyargìr malea ka, à peǎ nǝ bolo-azǝrfa. À tasǝ ɓongŋia sǝ à pàk ankò malea nǝ bolo-azǝrfa. <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />Ankpako mala Taragula andǝ mala anggun-kala mana à kàrì patal kat ka, à peǎ nǝ bolo-bángŋá.<verse eid="EXO 38:20" /></para>
  <para style="s">Agirtúró ace pàk Taragula</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />Mǝnia ka nda tsaɗya mala agirtúró ace pàk Taragula, yì Taragula mala Acau-nakûn. Aburana a tàu mala Lawi na à gilǝ agir mǝnia aɓa malǝmce kǝla mǝnana Musa banggia wia ka. Itamar, muna-ɓwabura mala Haruna, Pǝris Mǝgule, nda ɓwamǝgule mǝgilǝgir amur acili amǝtúró mǝnia ka. <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />Bezal-El muna-ɓwabura mala Uri, mǝkà Hur, a tàu mala Yahuda, nda ɓwa mǝnana pak agir kat pepè kǝla mǝnana Yahweh pè Musa nzongcau ama ɓǝà kpate ka. <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />Nda atārǝia andǝ ɓì mǝbwali wi túró, yi Oholiyap, muna-ɓwabura mala Ahisamak, a tàu mala Dan, mǝnana yi gbal ka mǝ'sǝlǝ pàkki atúróbù mala nyoulǝgir arǝ tali, andǝ pusǝ pa mala koya ulang gìr, andǝ tà gìr mǝɓoarsǝne arǝ nggubyau nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì ka. <verse eid="EXO 38:23" /><verse number="24" style="v" sid="EXO 38:24" />Bolo-njengǝlan mǝnana kat aɓwana yi pa kǝla ɓoro ace pàk Tara-mǝfele ka, dǝmbǝrya male ka tyang á-mwashat na (1,000). À kpata kārǝ́ dǝmbǝrya mala gìr, mǝnana à ear amurí a Tara-mǝfele ka.<verse eid="EXO 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 38:25" />Bolo-azǝrfa mana à kum a bu ɓwabundǝa mǝnana à ɓallia ka, dǝmbǝrya male na tyang á-tàrú, nǝ gbǝman ine nǝ lumi-tàrú (3,430). À kpata kārǝ́ dǝmbǝrya mala gìr, mǝnana à ear amurí a Tara-mǝfele ka. <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" />Mǝnia yi bolo-azǝrfa ka à kumi aɓa cemi aɓwana mana à gilǝ alullǝia a malǝmce aban ɓalban ngga. Koyan ngga pà gìr mǝnana à kasǝ ka, mǝtyang tongno nǝ gauwa-tsùrú; à kpata kārǝ́ dǝmbǝrya mala gìr, mǝnana à ear amurí a Tara-mǝfele ka. Làkkì mala aburana mana à ɓallia, amǝnana pǝlǝa ɓǝlban malea bingŋǝnà lumi-ɓari andǝ mana kútì ka, á-gbǝman-tongno-nong-mwashat-nǝ-tàrú nǝ gbǝman-tongno nǝ lumi-tongno na (603,550). <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />À pàktúró nǝ tyang lumi-tàrú nǝ mǝsǝi ine (34) mala bolo-azǝrfa sǝ à ɓakki agumtǝli-tǝrtà anggun-tara mala Tara-mǝfele andǝ anggun-ɓalǝu mana à bwal lagìr-kasǝbân aɓa Tara-mǝfele ka; làkkì mala agumtǝli-tǝrtà anggun-tara andǝ amala anggun-kala kat ka gbǝman mwashat na. <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />Cili bolo-azǝrfa mǝnana ueo, tyang lumi-tàrú ka, à pàngŋǝ̀nà-túró nǝi ace pàk anlǐ-gyargìr ace anggun-ɓalǝu andǝ tasǝ múr anggun-ɓalǝu, andǝ pak ankò malea.<verse eid="EXO 38:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 38:29" />Bolo-bángŋá mǝnana aɓwana pànà ɓoro nǝi aban Ɓakuli ka dǝmbǝrya male ka tyang á-ɓari, nǝ gbǝman-ine nǝ lumi-ɓari bwamdǝ-tongno na [2,425]. <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />À pàktúró nǝ mǝnia ka sǝ à pàk agumtǝli-tǝrtà anggun-kúnkurǝm mala bankutio aɓa Taragula, yì Tara Ban-peri, andǝ gyangŋan bolo-bángŋá, andǝ bàndà ace twangìr, andǝ agirtúró mala mǝnia yì gyangŋan ngga kat. <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />Ɗǝm ngga nǝ cili mǝno yì bolo-bángŋá ka sǝ à pàk agumtǝli-tǝrtà anggun-kala mǝnana à gumbǝli patal, andǝ agumtǝli-tǝrtà anggun kún patal, andǝ ankpako mala Taragula kat, andǝ ankpako mala anggun-kala mana à kàrì patal ka.<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">À swàr adaura pǝris</para>
  <para style="r">(<ref loc="EXO 28:1-14">Puro 28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />À pàktúró nǝ ɗà'ndíng andǝ mǝlùre, andǝ mǝwanye andǝ mǝbangŋe à tà adaura amǝɓoarne mǝnana apǝris nǝ̀ nggǝ oasǝo arǝia ɓǝà nǝ̀ pàk túró pǝris aɓa Ban Mǝfele ka. Ɗǝm ngga à swàr adaura amǝfele ace Haruna, kǝla mǝnana Yahweh pè Musa nzongcau ama ɓǝ̀ pè ka.<verse eid="EXO 39:1" /></para>
  <para style="s">Efot, muna daura-múrɓì mǝfele</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 39:2" />À Pàk efot nǝ nkonggúr bolo-njengǝlan andǝ mala ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe mǝnana à tè aɓalǝarǝia andǝ nkonggúr linǝn mǝɓǝlke mana à pyauwì ka. <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />À walki bolo-njengǝlan lapat-lapat, à kasǝki ganggǝrang-ganggǝrang, sǝ à tè aɓalǝarǝia andǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala linǝn mǝɓǝlke mǝnana à pyauwì ka, sǝ à tà efot nǝi, nǝ sǝlǝ tagìr. <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />À swàrî efot anggúr-nkpamtaru ɓari mǝnana à kpapi arǝ kúní a ɓadǝmbi andǝ nzǝmi ka. <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />À tà bugìr mārǝ́ taɓunu nǝ nkonggúr mǝmwashati ulang mala efot aɓa sǝlǝ pak gìr mǝɓoarsǝne sǝ à swàrì arǝ efot; à tè nǝ ankonggúr mala bolo-njengǝlan andǝ mala ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala linǝn mǝɓǝlke mǝnana à pyauwì ka. À pè kǝla mǝnana Yahweh banggi Musa ama ɓǝà pè ka. <verse eid="EXO 39:5" /><verse number="6" style="v" sid="EXO 39:6" />À gilǝki amunatali-onis mǝno ɓari ka, sǝ à nyoulǝ alullǝ amuna-burana lum-nong-ɓari mala Isǝrayila amuria; à nyoulǝia kǝla mana à kǝ nyoulǝ gir a ɓamur gbalmo-parbù ka, sǝ à oasǝia aɓalǝ atǝkrǝk-waya mala bolo-njengǝlan. <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />À tsǝia arǝ anggúr-nkpamtaru mala efot. À duk atali ɗenyinǝban mala amuna-burana mala Isǝrayila, kǝla mǝnana Yahweh banggi Musa ama ɓǝà pè ka.<verse eid="EXO 39:7" /></para>
  <para style="s">Lǝpan-damɓalǝu</para>
  <para style="r">(<ref loc="EXO 28:15-30">Puro 28:15-30</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />À pàk lǝpan-damɓalǝu aɓa sǝlǝpe mala tagìr. À tè kǝla pě mala efot, nǝ nkonggúr bolo-njengǝlan andǝ mala ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala linǝn mǝɓǝlke mǝnana à pyauwì ka. <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />À pè sauwa male kārǝa andǝ tangŋa male, incì tongno-nong-ine, sǝ à kàrrì ɓari, kúní lǝpi amur ɓì. <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />À lanzǝì wi amuna tali-gǝna tàrú-tàrú arǝì a nzǝmarǝia arǝ asangbǝlang ine; a sangbǝlang mǝdǝmbe ka à lanzǝì wi atali-gǝna mala rubi, andǝ tofas, andǝ beril; <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />a ɓaria sangbǝlang ngga à lanzǝì wi atali-gǝna mala emeral, andǝ safir, andǝ daimon; <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />a tàruia sangbǝlang ngga à lanzǝì wi atali-gǝna mala jasinta, andǝ aget, andǝ amitis; <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />sǝ a inea sangbǝlang ngga à lanzǝì wi atali-gǝna mala kǝrisolat, andǝ onis, andǝ jaspa. Yia amuna tali-gǝna mǝno kat ka à oasǝkia aɓalǝ atǝkrǝk-waya mala bolo-njengǝlan. <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />Amuna tali-gǝna mǝno ka à nda lum-nong-ɓari; komǝye ateà ka nda ace mwashat atà amuna-burana lum-nong-ɓari mala Isǝrayila, sǝ komǝye ateà ka à nyoulǝî wi mwashat atà alullǝ atau mala amǝ Isǝrayila amurí; à nda kǝla aɓamur gbalmo-parbù. <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />Sǝ à pàk amuna-nsolo ɓamyalu nǝ bolo-njengǝlan mǝɓoarne; à ɓolǝia aɓalǝarǝia, à pa kǝla nggur. <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />À pàk atǝkrǝk-waya mala bolo-njengǝlan ɓari sǝ à pàk agbalmò bolo-njengǝlan ɓari, sǝ à oasǝkia agbalmò mǝnia ka arǝ lǝpan-damɓalǝu a ban akúní ɓari. <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />Amuna-nsolo bolo-njengǝlan mǝno ɓari à ɓolǝia ka à ɗúrkia arǝ agbalmò mana arǝ akún lǝpan-damɓalǝu ka. <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />Akún amuna-nsolo ɓari mana à ue ka à ɗúrkia arǝ atǝkrǝk-waya mǝno ɓari ka, sǝ à kpapia arǝ anggúr-nkpamtaru mala efot, a ɓadǝmbi. <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />À pàk agbalmò bolo-njengǝlan ɓari sǝ à oasǝia arǝ lǝpan-damɓalǝu aban akúni ɓari mana à pǝlǝ nǝɓalǝu, tù aban efot ka. <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />Pǝlǝa à pàk aɓea gbalmò bolo-njengǝlan ɓari ɗǝm, sǝ à kpapia a kún anggúr-nkpamtaru mana à pǝlǝ nǝ'nzali ka a ɓadǝm efot, tù amur bugìr mārǝ́ taɓunu mǝ'nbaké mala efot. <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />Pǝlǝa à kùrki agbalmò mala lǝpan-damɓalǝu arǝ agbalmò mala efot, nǝ nkonggúr mǝlùre, ace mǝnana lǝpan-damɓalǝu ka ɓǝ̀ nongŋo amur bugìr mārǝ́ taɓunu mǝ'nbaké, sǝ ɓǝ̀ bwal kàngkàng arǝ efot, kǝla mǝnana Yahweh tsǝki Musa ama ɓǝ̀ pè ka.<verse eid="EXO 39:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />Ɗǝm ngga à tà daura-tsuru mǝsauwe mala efot; à tè kat nǝ ɗà'ndíng mǝlùre. <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />À nying ban fonggǝrang a myali, kǝla mala nggea-daura, ace oasǝ ɓamuru, sǝ à tà myali nǝ nkonggúr mǝcandǝe gumbǝli kat, ace mǝnana ɓǝ̀ kǝa sàn raka. <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />À kàrì kún daure a nzali nǝ agir kǝla aɓǝla mɓǝring mǝnana à teǎ nǝ nkonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, andǝ mala linǝn mǝɓǝlke mana à pyauwì ka. <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />Ɗǝm ngga à pàk amuna gwaroji bolo-njengǝlan sǝ à gyarkia, à camgi anre ka ɓǝla mɓǝring à kàrì kún daure kat. <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />Aɓǝla mɓǝring andǝ amuna gwaroji gaɓi-ɓalǝarǝia camge à kàrì kún daure mǝnana Haruna nǝ̀ oasǝo arǝì ɓǝ̀ nǝ̀ pàk túró pǝris ka, kǝla mǝnana Yahweh banggi Musa ama ɓǝ̀ pè ka.<verse eid="EXO 39:26" /></para>
  <para style="s">Aɓea daura ace apǝris</para>
  <para style="r">(<ref loc="EXO 28:31-43">Puro 28:31-43</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />Ɗǝm ngga à swàrî a Haruna andǝ amuna-burana male adaura túró-pǝris mǝnana à teǎ nǝ nkonggúr linǝn mǝɓoarne ka, <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />sǝ à pak anggubyau mbuɓi múrû mala linǝn mǝɓǝlke, andǝ asukuru linǝn, andǝ ashiwan mala nggubyau linǝn mǝnana à tè mǝsǝì kèkì ka. <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />Bugìr mārǝ́ taɓunu ka, à tè nǝ nkonggúr linǝn mǝɓǝlke mǝnana à pyauwì ka, andǝ ankonggúr ɗà'ndíng mǝlùre, andǝ mǝwanye, andǝ mǝbangŋe, nǝ tagìr mǝɓoarsǝne, kǝla mǝnana Yahweh banggi Musa ama ɓǝ̀ pè ka. <verse eid="EXO 39:29" /><verse number="30" style="v" sid="EXO 39:30" />À walki bolo-njengǝlan mǝɓoarne pàk lapat ace mǝnana ɓǝ̀ duk muna baji mǝfele ka, sǝ à nyoulǝ cau amurí kǝla mǝnana à nǝ̀ nyoulǝ gir a ɓamur gbalmo-parbù ka ama, &lt;&lt;Mǝfele ace Yahweh.&gt;&gt; <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />À kùrrì nǝ nkonggúr mǝlùre arǝ nggubyau mbuɓi múrû mala Haruna nǝban ɓadǝmbi, kǝla mǝnana Yahweh banggi Musa ama ɓǝ̀ pè ka.<verse eid="EXO 39:31" /></para>
  <para style="s">À masǝlǝ túró Taragula</para>
  <para style="r">(<ref loc="EXO 35:10-19">Puro 35:10-19</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />Anggo sǝ túró mala loasǝ Taragula, yì Tara Ban-peri ka à yi masǝlǝi kat. Amǝ Isǝrayila pàk girbunda kat kǝla mǝnana Yahweh banggi Musa ama ɓǝ̀ pè ka. <verse eid="EXO 39:32" /><verse number="33" style="v" sid="EXO 39:33" />À yinǝ Taragula aban Musa:</para>
  <para style="li" vid="EXO 39:33">yì agir mala loasǝ Tara andǝ agirtúró ɓālǝi;</para>
  <para style="li" vid="EXO 39:33">anlǐ-gyargìr male, andǝ anggun-tara male, andǝ nggun-gangndea male;</para>
  <para style="li" vid="EXO 39:33">andǝ anggun-ɓalǝu male andǝ agumtǝli-tǝrteà;<verse eid="EXO 39:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="EXO 39:34" />andǝ anggú-bángŋá amǝtangge, andǝ nggú mǝɓǝlke mala ambulpǝndǝa,</para>
  <para style="li1" vid="EXO 39:34">andǝ lagìr-kasǝbân,<verse eid="EXO 39:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="EXO 39:35" />andǝ Akwati mala Acau-nakûn andǝ agara twale, andǝ gìrkúni mǝnana nda buno sǝntǝ̀r ka;<verse eid="EXO 39:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="EXO 39:36" />andǝ kpamgbang-tsǝk-agir, andǝ agir mǝnana kat amurí ka, andǝ bǝredi mala ɓadǝm Yahweh;<verse eid="EXO 39:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="EXO 39:37" />andǝ gìr-tàmsǝ apitǝla mǝnana à pè nǝ bolo-njengǝlan mǝɓoarne ka, andǝ apitǝla male mǝnana à tsǝkinia aɓalǝ abancame malea amurí ka;</para>
  <para style="li1" vid="EXO 39:37">andǝ agirtúró kat mala apitǝla andǝ mùrú olif ace tsǝk bǝsa malea;<verse eid="EXO 39:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="EXO 39:38" />andǝ gyangŋan mǝnana à gìr rǝi kat nǝ bolo-njengǝlan ngga;</para>
  <para style="li1" vid="EXO 39:38">andǝ mùrú-ɗārǝ́bân, andǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne;</para>
  <para style="li1" vid="EXO 39:38">andǝ lagìr gyare a kún bankutio aɓa Tara;<verse eid="EXO 39:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="EXO 39:39" />andǝ gyangŋan bolo-bángŋá, andǝ bàndà male mala waya bolo-bángŋá,</para>
  <para style="li1" vid="EXO 39:39">andǝ agara twale, andǝ agirtúró male kat;</para>
  <para style="li1" vid="EXO 39:39">andǝ nkenye lákkí arǝu andǝ girtàmsǝe;<verse eid="EXO 39:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="EXO 39:40" />andǝ alagìr ace gumbǝli patal,</para>
  <para style="li1" vid="EXO 39:40">andǝ anggun-kala male, andǝ agumtǝli-tǝrteà;</para>
  <para style="li1" vid="EXO 39:40">andǝ lagìr-gbarban kún patal;</para>
  <para style="li1" vid="EXO 39:40">andǝ anggur andǝ ankpako male;</para>
  <para style="li1" vid="EXO 39:40">andǝ agir mǝnana kat à nǝ̀ pàktúró nǝia aɓa Taragula, yì Tara Ban-peri ka;<verse eid="EXO 39:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="EXO 39:41" />andǝ adaura mǝɓoarne mǝnana apǝris nǝ̀ nggǝ oasǝo arǝia ɓǝ̀ à nǝ̀ pàk túró-pǝris aɓa Ban Mǝfele ka,</para>
  <para style="li1" vid="EXO 39:41">sǝ adaura mǝfele ace Haruna pǝris mǝgule, andǝ adaura mala amuna-burana male, mǝnana à nǝ̀ oasǝ arǝia ɓǝ̀ à nǝ̀ pàk túró-pǝris ka.<verse eid="EXO 39:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="EXO 39:42" />Amǝ Isǝrayila pàk atúrè kat aɓa kpata agir kat kǝla mǝnana Yahweh ak dǝmba bangŋǝni Musa ama ɓǝ̀ pè ka. <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />Musa pelǝki atúrè pepè sǝ sǝni ka, à pàngŋǝ̀nì kǝla mǝnana Yahweh bang ama ɓǝà pè ka; à pè gǝ̀rgǝ̀r, sǝ Musa tsǝkia wia bù.<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">Loasǝ Taragula mala Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />Pǝlǝa Yahweh bangcau nǝ Musa ama, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />&lt;&lt;A pwari mǝdǝmbe mala zongŋo mǝdǝmbe ka, awu nǝ loasǝ Taragula, yì Tara Ban-peri. <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />Awu nǝ twal Akwati mala Acau-nakûn, awu nǝ̀ tsǝì aɓa Taragula, sǝ awu nǝ gyar lagìr-kasǝbân a ɓadǝmbi ɓǝ̀ gbàrì aɓa Ban Nggea Mǝfele. <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />Awu nǝ yinǝ kpamgbang-tsǝk-agir, awu nǝ tamsǝi, sǝ awu nǝ tsǝki agir male amurí. Awu nǝ yinǝ gìr-tàmsǝ apitǝla, a nǝ tsǝì, sǝ a nǝ tsǝki wi apitǝla male amurí. <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />Sǝ awu nǝ tsǝk gyangŋan bolo-njengǝlan ace loasǝ yele mǝ'rǝmɓoarne, ɓǝ̀ came a ɓadǝm Akwati mala Acau-nakûn, sǝ wu gyar lagìr mala gbàr bankutio aɓa Taragula.<verse eid="EXO 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 40:6" />&lt;&lt;Awu nǝ tsǝk gyangŋan mala pàgir mala pisǝe kǝring ɓǝ̀ came a nza, a kún Taragula, yì Tara Ban-peri. <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />Sǝ awu nǝ tsǝk nkenye lákkí arǝu a nre Tara Ban-peri andǝ gyangŋan mǝnia ka, sǝ wu lúmsǝì nǝ mùr. <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />Awu nǝ kasǝ patal, ɓǝ̀ kàrì Taragula. Gumbǝli nǝ alagìr sǝ wu gyar lagìr mǝnana nǝ̀ gbàr kún patal ka.<verse eid="EXO 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 40:9" />&lt;&lt;Pǝlǝa awu nǝ twal mùrú ɗārǝ́bân sǝ awu nǝ ɗārǝ́ Taragula andǝ agir mǝnana aɓalǝi ka kat, sǝ awu nǝ tàrì andǝ agirtúró-ɓalǝi ace Ɓakuli, ace mǝnana ɓǝ̀ duk mǝfele ka. <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />Sǝ ɗǝm ngga awu nǝ ɗārǝ́ gyangŋan mala pàgir ace pisǝe kǝring, atārǝia andǝ agirtúró male kat, nǝ mùrú olif. Yì gyangŋan ngga awu nǝ tàrì ace Ɓakuli sǝ nǝ̀ duk gyangŋan nggea mǝfele kat-kat. <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />Ɗǝm ngga awu nǝ ɗārǝ́ nkenye lákkí arǝu andǝ girtàmsǝe, nǝ mùrú olif, sǝ awu nǝ tàrì ace Ɓakuli.<verse eid="EXO 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 40:12" />&lt;&lt;<note caller="+" style="f"><char style="fr" closed="false">40:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 8:1-36">Pǝris 8:1-36</ref></char>.</note>Pǝlǝa awu nǝ yinǝ Haruna andǝ amuna-burana male a kún Tara Ban-peri, awu nǝ lákkià wia rǝia nǝ mùr. <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />Awu nǝ oasǝì Haruna adaura mǝfele mala pǝris arǝì, sǝ awu nǝ ɗārǝí nǝ mùrú olif; awu nǝ tàrì ɓǝ̀ duk mǝ'pàkkam túró kǝla pǝris. <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />Ɗǝm ngga, awu nǝ yinǝ amuna-burana male, awu nǝ oasǝkia wia adaura-múrɓì arǝia, <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />sǝ awu nǝ ɗārǝia nǝ mùrú olif, kǝla mǝnana à ɗārǝ́ tárrià ka, ace mǝnana ɓǝà pàkkam túró kǝla apǝris ka. Sǝ ɗārǝ́bân malea ka nǝ̀ yinǝia a dobuno-pǝris mana tè pà nǝ̀ mal raka, arǝ anza malea kat.&gt;&gt;<verse eid="EXO 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />Musa pàk koman kat kǝla mǝnana Yahweh banggi wi ka.<verse eid="EXO 40:16" /></para>
  <para style="s">Musa tǝm Taragula</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 40:17" />Taragula ka à tǝmi a pwari mǝdǝmbe mala zongŋo mǝdǝmbe a ɓaria pǝlǝa anzǝm mǝnana amǝ Isǝrayila nyingŋǝna Masar ka.<verse eid="EXO 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 40:18" />Lang Musa nǝ̀ loasǝ Taragula ka, tsǝki agumtǝli-tǝrtè a nzali sǝ tamsǝki akusǝ anggun-tara aɓalǝia, sǝ nongsǝki anggun-gangndea sǝ kùrkia. Anzǝm mǝno ka pǝlǝa loasǝ anggun-ɓalǝu mana à nǝ̀ mbali múr Taragula ka. <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />Pǝlǝa sárǝ́ lagìr nggu-bangŋa mǝtangŋe male, kùmsǝ múr anggun-tara yi sulǝ a nzali arǝ abumban mala Taragula, sǝ kùmsǝi wi lagìr-murí mǝgule [mala nggu ambulpǝndǝa] amurí nǝ'nza. Pàk koman kat kǝla mana Yahweh tsǝki wi nzongcau ama ɓǝ̀ pàk ka.<verse eid="EXO 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 40:20" />Twal akpamgbǝlang tali ɓari mala Acau-nakûn, tsǝia aɓa Akwati, sǝ twal agara mǝnana à kǝ twalǝna yì Akwati nǝia ka, oasǝki aɓalǝ atūli gbalmò arǝ Akwati, sǝ twal gìrkún Akwati, mǝnana do nda buno sǝntǝ̀r ka, tsǝì amur Akwatinî. <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />Pǝlǝa twal Akwatinî kútí nǝi aɓa Taragula, pǝlǝa gyar lagìr-kasǝbân mǝnana nǝ̀ gau ɓá Taragula ka, gbàr Akwati mala Acau-nakûn, kǝla mana Yahweh tsǝki wi, yì Musa ka.<verse eid="EXO 40:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 40:22" />Musa tsǝk kpamgbang-tsǝk-agir aɓa Tara Ban-peri, aɓalǝi mǝdǝmbe, a ɓadǝm lagìr-kasǝbân, nǝ bumban mala Taragula mǝnana sǝn njar-nza ka. <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />Pǝlǝa tsǝk bǝredi amur kpamgbang-tsǝk-agir a ɓadǝm Yahweh, kǝla mana Yahweh banggi wi, yì Musa ɓǝ̀ pàk ka.<verse eid="EXO 40:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 40:24" />Pǝlǝa tsǝk gìr-tàmsǝ apitǝla aɓa Tara Ban-peri, a nkāɓe kpamgbang-tsǝk-agir, nǝ buì mala Taragula mǝnana sǝn njar-kunmur ka. <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />Pǝlǝa tamsǝki apitǝla a ɓadǝm Yahweh, kǝla mana Yahweh tsǝki wi nzongcau, yì Musa ɓǝ̀ pàk ka.<verse eid="EXO 40:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 40:26" />Musa pǝlǝa tsǝk gyangŋan bolo-njengǝlan aɓa Tara Ban-peri, a ɓadǝm lagìr-kasǝbân, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />sǝ pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne amúr gyangŋan, kǝla mana Yahweh tsǝki wi nzongcau ɓǝ̀ pàk ka.<verse eid="EXO 40:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 40:28" />Sǝ yi gyar lagìr-gbarban a kún ban mǝnana à nǝ̀ kùtí nǝi aɓa Taragula ka. <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />A ɓadǝm mǝno yì lagìr-gbarban a kún Taragula, yì Tara Ban-peri ka, Musa tsǝk gyangŋan mala pàgir ace pisǝe kǝring, sǝ pagìr mala pisǝe kǝring amurí, andǝ pà ɓoro mala mǝsǝsa, kǝla mǝnana Yahweh tsǝki wi nzongcau ɓǝ̀ pàk ka.<verse eid="EXO 40:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 40:30" />Musa tamsǝ nkenye a nre Tara Ban-peri andǝ gyangŋan mǝno, sǝ so mùr aɓalǝi ace lákkí arǝu, <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />A kàm sǝ Musa andǝ Haruna, andǝ amuna-burana mala Haruna à nǝ̀ nggǝ lákkí abuia andǝ akusǝia. <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />Koya pwari sǝ à nǝ̀ kùtí aɓa Tara Ban-peri, ko à nǝ̀ ká a ban gyangŋan ngga, à nǝ̀ lakki abuia andǝ akusǝia sǝ à nǝ̀ kùtí a banì, kǝla mǝnana Yahweh tsǝki Musa nzongcau ka.<verse eid="EXO 40:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 40:33" />Pǝlǝa Musa kasǝ patal ɓǝ̀ kàrì Taragula, tsǝk nkāndan ɓǝ̀ gumbǝliban, túr Taragula andǝ gyangŋan a ɓalǝu. Pǝlǝa gyarki alagìr-gbarban ace kàrì rǝ nkāndan kat, sǝ ace gbar kún patal. Anggo sǝ Musa mal túró.<verse eid="EXO 40:33" /></para>
  <para style="s">Ɓoarɓwa mala Yahweh</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />Kara pǝrɓang yì gir múr Tara Ban-peri, sǝ ɓoarɓwa mala Yahweh yì lumsǝ ɓá Taragula. <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />Musa ka gandǝ kútí aɓa Tara Ban-peri ɗang, acemǝnana pǝrɓang yi sulǝna amurí, sǝ ɓoarɓwa mala Yahweh lùmsǝ ɓá Taragula.<verse eid="EXO 40:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 40:36" />Aɓa gya mala amǝ Isǝrayila kat ka, koya pwari sǝ pǝrɓang loapì múr Taragula ka, à nǝ̀ lo gya aban ká atè. <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />Sǝ ɓǝ̀ pǝrɓang lo raka, yià gbal ka à pà nǝ̀ lo ɗang, she pwari mana pǝrɓang longŋǝna ka. <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />Nǝ́ pwari ka pǝrɓang mala Yahweh nǝ̀ gìr múr Taragula, sǝ nǝ dú ka, bǝsa nǝ̀ pa aɓa pǝrɓangnî, a mǝsǝ amǝ Isǝrayila kat. Anggo sǝ pa arǝ abân mǝnana kat amǝ Isǝrayila kǝ tùrki kam a gya malea ka.<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>