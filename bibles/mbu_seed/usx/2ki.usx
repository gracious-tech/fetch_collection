<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2KI" style="id">- Mbula</book>
  <para style="h">2Amurǝma</para>
  <para style="toc3">2Amur</para>
  <para style="toc2">2 Amurǝm</para>
  <para style="toc1">2 Amurǝma</para>
  <para style="mt2">ƁARIA AMURƏMA</para>
  <para style="mt1">AMURƏMA</para>
  <para style="imt1">MƏNCAU</para>
  <para style="im">
    <char style="bk">Ɓaria Malǝmce mala Amurǝma </char> ka lidǝmba nǝ acau-ɓaraɓara mala adomurǝm ɓari mala Isǝrayila aban mǝnana malǝmce <char style="bk">1 Amurǝma mǝdǝmbe </char> cam kam ngga. Mǝnia yì malǝmce ka à nǝ̀ gandǝ gauwe arǝ abanì ɓari: (1) Kǝɓicau amur adomurǝm ɓari, twal a bàkú mǝnana ue apǝlǝa gbǝman-tongno-nong-tàrú nǝ lumi-tongno (850) sǝ ɓǝà yi ɓǝl Kǝrǝsti ka aban ká a bàkú mala kpa mala Samariya andǝ masǝlǝata domurǝm mǝnana a njarnza a bàkú mǝnana ue apǝlǝa gbǝman-tongno-nong-ɓari nǝ lumi-ɓari nong ɓari (722) sǝ ɓǝà yi ɓǝl Kǝrǝsti ka; (2) Kǝɓicau amur domurǝm mala Yahuda twal a kpa mala domurǝm mala Isǝrayila kya pur a bàkú mǝnana Murǝm Nebukaneza mala amǝ Babila yi li Urǝshalima nǝ lwa sǝ kiɗiki, a bàkú mǝnana ue apǝlǝa gbǝman-tongno nǝ lumi-tongno-nong-tàrú bwamdǝ tongno-nong-mwashat (586) sǝ ɓǝà yi ɓǝl Kǝrǝsti ka. Malǝmcenî yi masǝlǝte nǝ caugilǝe amur Gedaliya kǝla nggwamna mala Yahuda aɓata yálmúrû mala amǝ Babila, andǝ cau mǝnana à tasǝì sǝ à yi ne amur panzǝ Murǝm Jehoyacin mala Yahuda a ndàkurban a Babila ka.</para>
  <para style="ip">Amǝnia yì agir'murmwana mala nzalinì ka à yi kumban atà cau mala ɗwanyi domǝsǝcau mala amurǝma andǝ aɓwana mala Isǝrayila andǝ Yahuda. Kìɗìkya mǝnana a kiɗiki Urǝshalima andǝ pwano mǝnana à pwan aɓwana mala Yahuda pas sǝ à umnǝia a bǝri-nzali ka, nda ɓegìr nggea mǝgule mǝnana yinǝ nggaɗi aɓa cau-ɓaraɓara mala Isǝrayila ka.</para>
  <para style="ip">Mǝɓangnǝa mala Ɓakuli mana pur a kúnban a pakkiagir aɓa malǝmce <char style="bk">2 Amurǝma </char> ka nda Ilisha mǝnana ak túrô a bu Iliya ka.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka acau.</para>
  <para style="io1">Domurǝm mana gau ka ka <char style="ior"><ref loc="2KI 1:1-17:41">1:1--17:41</ref></char></para>
  <para style="io2">Mǝɓangnǝa Ilisha <char style="ior"><ref loc="2KI 1:1-8:15">1:1--8:15</ref></char></para>
  <para style="io2">Amurǝma mala Yahuda andǝ Isǝrayila <char style="ior"><ref loc="2KI 8:16-17:4">8:16--17:4</ref></char></para>
  <para style="io2">Kpa mala Samariya <char style="ior"><ref loc="2KI 17:5-41">17:5-41</ref></char></para>
  <para style="io1">Domurǝm mala Yahuda <char style="ior"><ref loc="2KI 18:1-25:30">18:1--25:30</ref> </char></para>
  <para style="io2">Lo aban Hezekiya ka kya bwal ban Yahuda <char style="ior"><ref loc="2KI 18:1-21:26">18:1--21:26</ref> </char></para>
  <para style="io2">Yálmúrû mala Josiya <char style="ior"><ref loc="2KI 22:1-23:30">22:1--23:30</ref> </char></para>
  <para style="io2">Amurǝma mǝ'nzǝmoe mala Yahuda <char style="ior"><ref loc="2KI 23:31-24:20">23:31--24:20</ref> </char></para>
  <para style="io2">Kpa mala Urǝshalima <char style="ior"><ref loc="2KI 25:1-30">25:1-30</ref></char></para>
  <chapter number="1" style="c" sid="2KI 1" />
  <para style="s1">Ɓashi mala Yahweh amur Ahaziya</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 1:1" />Anzǝm lú mala Ahap ka, nzali Mowap mgbicau arǝ Isǝrayila.<verse eid="2KI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 1:2" />A ɓè pwari ka [bǝsa murǝm mala Isǝrayila] yì Ahaziya, putǝli a nre ka akpamgbang mala kurǝm-kuli<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">kurǝm-kuli </char><char style="ft" closed="false">ko &lt;&lt;ɓá kurǝm-kuli,&gt;&gt; ko &lt;&lt;nkanggari múr-kurǝm&gt;&gt;</char></note> mala palta male a Samariya, yi kpa a nzali, sǝ nong nǝ rǝkwana. Nda tasǝ amǝ'na-túrbân nǝ cau ama, &lt;&lt;Wu kyane, wu ɗìkambancau a ban Ba'al-Zebup, ɓakuli mala Ekǝron,<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="fq" closed="false">Ekǝron </char><char style="ft" closed="false">ɓè nggea-là mala amǝ'Filisti</char></note> ace mǝnana mǝ sǝlǝa ko rǝkwana man ngga nǝ̀ malì rǝàm.&gt;&gt;<verse eid="2KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 1:3" />Sǝama mǝturonjar mala Yahweh ne Iliya ɓwa'Tishbe <note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 17:1">1Amur 17:1</ref>; <ref loc="1KI 21:17">21:17</ref></char>.</note> ama, &lt;&lt;Lo, kya kum amǝ'na-túrbân mala murǝm Samariya, sǝ wu nea wia ama, &lt;Nda acemǝnana Ɓakuli pa kàm a Isǝrayila raka, sǝ wu kǝ o ace ɗìbancau a ban Ba'al-Zebup, ɓakuli mala Ekǝron ngga le?&gt; <verse eid="2KI 1:3" /><verse number="4" style="v" sid="2KI 1:4" />Acemani ka, wu banggi murǝm ama Yahweh bang ama, &lt;A pà wunǝ loapì kal-nongŋo mǝnana a nong aɓalǝi ka ɗàng; mbak-kàngkàng awu nǝ wǔ.&gt; &gt;&gt; Nda Iliya lo wari ka.<verse eid="2KI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 1:5" />Amǝ'na-túrbân nyare aban murǝm, sǝ murǝm ɗia ama, &lt;&lt;Mana tsǝa sǝ wu nyare?&gt;&gt;<verse eid="2KI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 1:6" />À eari wi ama, &lt;&lt;Ɓè ɓwabura yi kum sǝm, sǝ bangga sǝm ama, &lt;Wu nyar aban murǝm mǝnana túr wun ngga, sǝ wu ne wi ama, Mǝnia ka nda cau mǝnana Yahweh kǝ bang ngga: Nda acemǝnana Ɓakuli pa kàm a Isǝrayila raka, sǝ a kǝ túr aɓwana ace ɗìbancau a ban Ba'al-Zebup, ɓakuli mala Ekǝron ngga le? Acemani ka, a pà wunǝ loapì kal-nongŋo mǝnana a nong aɓalǝi ka ɗàng; mbak-kàngkàng awu nǝ wǔ!&gt; &gt;&gt;<verse eid="2KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 1:7" />Murǝm ɗia ama, &lt;&lt;Lang sǝ ɓwê pa, yì ɓwa mǝnana wu je wunǝia, sǝ na wun amǝnia yì acau ka?&gt;&gt;<verse eid="2KI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 1:8" />À eari wi ama, &lt;&lt;<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 13:4">Zak 13:4</ref>; <ref loc="MAT 3:4">Mat 3:4</ref>; <ref loc="MRK 1:6">Mar 1:6</ref></char>.</note>Ɓwê oasǝ agir-nggūrǝu mala nyang arǝì, sǝ kùr nggur-ɓunu mala nggû a taɓuni.&gt;&gt;</para>
  <para style="p" vid="2KI 1:8">Murǝm bang ama, &lt;&lt;Iliya ɓwa'Tishbe na.&gt;&gt;<verse eid="2KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 1:9" />Pǝlǝa murǝm tasǝ mǝ'sàrǝ̀ban amur amǝ'lwa lumi-tongno, nǝ aburana male lumi-tongno atè aban Iliya. Mǝ'sàrǝ̀ban wari aban Iliya mǝnana ndaban do amur muna-nkono ka, sǝ ne Iliya ama, &lt;&lt;Ɓwa mala Ɓakuli, murǝm bang ama wu sulǝo!&gt;&gt;<verse eid="2KI 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 1:10" />Iliya nyesǝi mǝ'sàrǝ̀ban amur amǝ'lwa lumi-tongno ama, &lt;&lt;Ɓǝ̀ mǝ nda ɓwa mala Ɓakuli ka, ɓǝ̀ ɓǝsa sulǝ nǝ kuli, sǝ ɓǝ̀ pisǝo wunǝ aburana mô lumi-tongno.&gt;&gt; Kara bǝsa sulǝ nǝ kuli sǝ pisǝ mǝ'sàrǝ̀ban mǝno andǝ aburana male lumi-tongno.<verse eid="2KI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 1:11" />Murǝm nyare tasǝ ɓè mǝ'sàrǝ̀ban amur amǝ'lwa lumi-tongno, nǝ aburana male lumi-tongno atè aban Iliya. Mǝ'sàrǝ̀ban man ne Iliya ama, &lt;&lt;Ɓwa mala Ɓakuli, murǝm bang ama wu sulǝ akaurǝa!&gt;&gt;<verse eid="2KI 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 1:12" />Iliya earî wi ama, &lt;&lt;Ɓǝ̀ mǝ nda ɓwa mala Ɓakuli ka, ɓǝ̀ bǝsa sulǝ nǝ kuli, sǝ ɓǝ̀ pisǝo wunǝ aburana mô lumi-tongno!&gt;&gt; Kara bǝsa mala Ɓakuli sulǝ nǝ kuli, sǝ pisǝì andǝ aburana male lumi-tongno.<verse eid="2KI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 1:13" />Ɗǝm ngga, murǝm tasǝ tàruia mǝ'sàrǝ̀ban amur amǝ'lwa lumi-tongno, nǝ aburana male lumi-tongno atè. Mǝnia yì tàruia mǝ'sàrǝ̀ban ngga wario, sǝ ɓun a nzali amur ankūnǝi aɓadǝm Iliya, sǝ zǝm ɓwamuru abaní, ne wi ama, &lt;&lt;Ɓwa mala Ɓakuli, ida, ɓwamuram, sǝ wu ɗeki yilǝmem andǝ ayilǝmi aguro mò mǝnia lumi-tongno ka ɓǝà kum gulo a mǝsǝo. <verse eid="2KI 1:13" /><verse number="14" style="v" sid="2KI 1:14" />Sǝni, bǝsa sulǝ nǝ kuli sǝ pisǝ amǝ'sàrǝ̀ban mǝdǝmbe ɓari, komǝye ka andǝ aburana male lumi-tongno mǝnana atè ka. Sǝ adyan ngga, sǝn mǝsǝswatǝ̀r mem, amsǝ yilǝmem.&gt;&gt;<verse eid="2KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 1:15" />Mǝturonjar mala Yahweh banggi Iliya ama, &lt;&lt;Sulǝo kya atè, cè ɓangciu pakko arǝì ɗàng.&gt;&gt; Nda Iliya lo, sulǝ andǝi sǝ à wari aban murǝm.<verse eid="2KI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 1:16" />Pǝlǝa Iliya banggi Murǝm Ahaziya ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh bang ngga: &lt;Nda acemǝnana Ɓakuli pa kàm a Isǝrayila, mǝnana awu nǝ ɗìbancau abaní amur cau male raka, sǝ a túr amǝ'na-túrbân ɓǝà kya ɗìbancau a ban Ba'al-Zebup, ɓakuli mala Ekǝron ngga le? Acemani ka, a pà wunǝ loapì kal-nongŋo mǝnana a nong aɓalǝi ka ɗàng, mbak-kàngkàng awu nǝ wǔ!&gt; &gt;&gt;<verse eid="2KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 1:17" />Nda Ahaziya wǔ kǝla mǝnana cau mala Yahweh bangŋi nǝ kún Iliya ka.</para>
  <para style="p" vid="2KI 1:17">Sǝ acemǝnana Ahaziya pànǝ muna-ɓwabura raka, Jehoram [mǝ'eambi] duk murǝm a bancame male, a ɓaria pǝlǝa mala do-bunomurǝm mala Jehoram muna-ɓwabura mala Jehoshafa, amur Yahuda. <verse eid="2KI 1:17" /><verse number="18" style="v" sid="2KI 1:18" />Acili atúró mǝnana Ahaziya pea ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="2KI 1:18" /></para>
  <chapter eid="2KI 1" />
  <chapter number="2" style="c" sid="2KI 2" />
  <para style="s1">À twal Iliya aban o a kuli</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 2:1" />Adyan ngga, lang pwari gbàshìnà mǝnana Yahweh nǝ̀ twal Iliya aɓa gyaɗace nǝ̀ umnǝi a kuli ka, Iliya andǝ <note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 19:19-21">1Amur 19:19-21</ref></char>.</note>Elisha na a njar aban nying Gilgal. <verse eid="2KI 2:1" /><verse number="2" style="v" sid="2KI 2:2" />Sǝ Iliya ne Elisha ama, &lt;&lt;Ida, kundǝ kani, acemǝnana Yahweh túrnǎm a Betel.&gt;&gt;</para>
  <para style="p" vid="2KI 2:2">Sǝ Elisha bang ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam, sǝ mbak-kàngkàng a ndakam ngga, pà mǝ nǝ nyio ɗang.&gt;&gt; Nda à o a Betel ka.<verse eid="2KI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 2:3" />Sǝ <note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 4:1">4:1</ref>; <ref loc="2KI 4:38">4:38</ref>; <ref loc="2KI 5:22">5:22</ref>; <ref loc="2KI 6:1">6:1</ref>; <ref loc="2KI 9:1">9:1</ref>; <ref loc="1KI 20:35">1Amur 20:35</ref></char>.</note>nggǝsan mala amǝ'ɓangnǝa mǝnana a Betel ka, à puro à yiu aban Elisha, sǝ à ne wi ama, &lt;&lt;A sǝlǝ mbak ama Yahweh nǝ̀ twal mǝtala-ɓala mò arǝò yalung?&gt;&gt;</para>
  <para style="p" vid="2KI 2:3">Elisha nyesǝia wia ama, &lt;&lt;E, ǝn sǝlǝna; wu duk piu.&gt;&gt;<verse eid="2KI 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 2:4" />Iliya ne Elisha ama, &lt;&lt;Elisha, ida duk kani, acemǝnana Yahweh túrnǎm a Jeriko.&gt;&gt;</para>
  <para style="p" vid="2KI 2:4">Sǝ Elisha bang ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam, sǝ mbak-kàngkàng a ndakam ngga, pà mǝ nǝ nyio ɗang.&gt;&gt; Pǝlǝa à o a Jeriko.<verse eid="2KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 2:5" />Nggǝsan mala amǝ'ɓangnǝa mǝnana a Jeriko ka, à wari tù aban Elisha, sǝ à ne wi ama, &lt;&lt;A sǝlǝ mbak ama yalung ngga, Yahweh nǝ̀ twal mǝtala-ɓala mò arǝò?&gt;&gt;</para>
  <para style="p" vid="2KI 2:5">Sǝ Elisha nyesǝia wia ama, &lt;&lt;E, ǝn sǝlǝna; wu duk piu.&gt;&gt;<verse eid="2KI 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 2:6" />Pǝlǝa Iliya ne Elisha ama, &lt;&lt;Ida, duk kani, acemǝnana Yahweh túrnǎm a Jodan.&gt;&gt;</para>
  <para style="p" vid="2KI 2:6">Sǝ Elisha nyesǝi wi ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam, sǝ mbak-kàngkàng a ndakam ngga, pà mǝ nǝ nyio ɗang.&gt;&gt; Nda yià kǝm ngga, à lidǝmba nǝ gya ka.<verse eid="2KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 2:7" />Aburana lumi-tongno mala nggǝsan mala amǝ'ɓangnǝa wario, sǝ à cam zak nǝ ban mǝnana Iliya andǝ Elisha cam kam a kún Nggeasala Jodan ngga. <verse eid="2KI 2:7" /><verse number="8" style="v" sid="2KI 2:8" />Iliya panzǝ gwado male, karki sǝ walna mùr nǝi. Kara mùr gau banì ɓari, sǝ à gya amur nzali mǝ'ime yià kǝm, à yàl a nkaring.<verse eid="2KI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 2:9" />Anzǝm mana à yàlǝ́nì Nggeasala Jodan ngga, Iliya banggi Elisha ama, &lt;&lt;Zǝm gìr mǝnana mǝ nǝ pàkkô ka, sǝɓǝ̀ à twalam arǝò.&gt;&gt; Elisha ne wi ama, &lt;&lt;Ida, ɓǝ̀ kāmbe ɓari mala bangŋo mò sulǝ amuram.&gt;&gt; <verse eid="2KI 2:9" /><verse number="10" style="v" sid="2KI 2:10" />Sǝ Iliya ne wi ama, &lt;&lt;A zǝmna gìr mǝkwane; kat andǝ amani ka, ɓǝ̀ a sǝnam lang à ndaban twalam arǝò ka, awu nǝ kum gìr mǝnana a zǝm ngga. Sǝama ɓǝ̀ a sǝnam raka, a pà wunǝ kumi ɗàng.&gt;&gt;<verse eid="2KI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 2:11" />Sǝ lang à ndaban gya sǝ à kǝ nacau ka, kara <note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 6:17">6:17</ref></char>.</note>waru-pǝr mala bǝsa puro nǝ apǝr bǝsa mana à kǝ nunni ka, à yi gau nrea. Sǝ à fwà Iliya aban o kuli aɓa gyaɗace. <verse eid="2KI 2:11" /><verse number="12" style="v" sid="2KI 2:12" />Elisha sǝni, sǝ tunǝban bang-bang ama, &lt;&lt;Dâ! Dâ! <note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 13:14">13:14</ref> </char>.</note>Awaru-pǝr andǝ amǝpǝr mala Isǝrayila!&gt;&gt;</para>
  <para style="p" vid="2KI 2:12">Sǝ Elisha nyare sǝni ɗàng. Pǝlǝa bwal daura male sannì, gauwi ɓari. <verse eid="2KI 2:12" /><verse number="13" style="v" sid="2KI 2:13" />Pǝlǝa twal gwado mala Iliya mǝnana kpa arǝì ka, sǝ nyare yi came a kún Nggeasala Jodan. <verse eid="2KI 2:13" /><verse number="14" style="v" sid="2KI 2:14" />Twal gwado mala Iliya mǝnana kpa arǝì ka, sǝ wal mùr nǝi, sǝ bang ama, &lt;&lt;Yahweh, Ɓakuli mala Iliya na ke?&gt;&gt; Sǝ lang walna mùr ka, mùr gau arǝ abanì ɓari, sǝ Elisha gya yàl a nkaring.<verse eid="2KI 2:14" /></para>
  <para style="s">Elisha twal bancame mala Iliya</para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 2:15" />Adyan ngga, nggǝsan mala amǝ'ɓangnǝa mǝnana a Jeriko, mǝnana à kǝ sǝni ka, à bang ama, &lt;&lt;Bangŋo mala Iliya sulǝna amur Elisha.&gt;&gt; À wari ace kúllè, sǝ à ɓun a nzali aɓadǝmbi. <verse eid="2KI 2:15" /><verse number="16" style="v" sid="2KI 2:16" />À banggi wi ama, &lt;&lt;Sǝni ado, aburana mǝ'rǝcandǝe nakam aɓalǝ aguro mò lumi-tongno. Ida, earia wia ɓǝà kyane ace alta mǝtala-ɓala mò. Earka, <note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 18:12">1Amur 18:12</ref></char>.</note>Bangŋo mala Yahweh twalǝni a kuli, sǝ kya tsǝ́ngŋǝ̀nì amur ɓè nkono ko aɓa ɓè dulum.&gt;&gt;</para>
  <para style="p" vid="2KI 2:16">Sǝ Elisha nyesǝia wia ama, &lt;&lt;Awo, wu kǝa túriá ɗàng.&gt;&gt;<verse eid="2KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 2:17" />Sǝama lang à ɓuakiarǝi ka earia wia, nea wia ama, &lt;&lt;Wu túriá.&gt;&gt; Pǝlǝa à túr aburana lumi-tongno. À camarǝ alte nongŋo tàrú, sǝ à kumi ɗàng. <verse eid="2KI 2:17" /><verse number="18" style="v" sid="2KI 2:18" />Elisha na piu a Jeriko lang à nyar abaní ka. Sǝ Elisha banggia wia ama, &lt;&lt;Ən bang ma wun nǝma, &lt;Wu kǝa ká raka re?&gt; &gt;&gt;<verse eid="2KI 2:18" /></para>
  <para style="s">Gir'ndali mǝdǝmbe mala Elisha</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 2:19" />A ɓè pwari ka, aburana mala nggea-là Jeriko ne Elisha ama, &lt;&lt;Ɓwamǝgule, sǝni, ban mǝnana là mǝnia na kam ngga ɓoaro, sǝama mùr male ka ɓoar ɗàng, sǝ nzalî ka kǝ pusǝ gìrɓaban pepè ɗàng.&gt;&gt;<verse eid="2KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 2:20" />Elisha nea wia ama, &lt;&lt;Wu yinǝam nǝ bǝsa tasau, sǝ wu ɗàrǝ́ tuɓamur aɓalǝi.&gt;&gt; Nda à yinǝi wi nǝi ka.<verse eid="2KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 2:21" />Pǝlǝa puro wari a tūli-mùr [mala lê], sǝ so tuɓamurnî aɓalǝi, sǝ bang ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh na ka: &lt;Ən twalna kwánó mala mùr man. Pà nǝ̀ nyare nǝ̀ yinǝ lú ko nǝ̀ ɗwanyi pusǝ ɓǝle ɗàng.&gt; &gt;&gt; <verse eid="2KI 2:21" /><verse number="22" style="v" sid="2KI 2:22" />Nda mùrnî pǝlǝ mǝɓoarne ka ba yalung, kǝla cau mǝnana Elisha bangŋi ka.<verse eid="2KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 2:23" />Elisha nying Jeriko sǝ bwal njar aban ká a Betel. Lang nda a njar aban o ka, aɓea amuna pur aɓa nggea-lê, sǝ à sàkkiarǝì, à ne wi ama, &lt;&lt;Upì ban mǝnia, we mǝ'múr-swara! Upì ban mǝnia, we mǝ'múr-swara!&gt;&gt; <verse eid="2KI 2:23" /><verse number="24" style="v" sid="2KI 2:24" />Elisha pǝlǝá, sǝ lang sǝnia ka, suia aɓa lullǝ Yahweh. Kara abiya mǝ'nggaule ɓari pur aɓa ndà-nggun, sǝ à sàngi lumi-ine-nong-ɓari atà amunè. <verse eid="2KI 2:24" /><verse number="25" style="v" sid="2KI 2:25" />Elisha nying ban mǝno ka, o a <note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 19:26">Jes 19:26</ref>; <ref loc="1KI 18:19">1Amur 18:19</ref>; <ref loc="1KI 20">20</ref></char>.</note>Nkono Kamel, sǝ nǝnzǝ́mò ka nyar a Samariya.<verse eid="2KI 2:25" /></para>
  <chapter eid="2KI 2" />
  <chapter number="3" style="c" sid="2KI 3" />
  <para style="s1">Munǝo anre Isǝrayila andǝ Mowap</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 3:1" />A lum-bwamdǝ-tongno-nong-tàruia pǝlǝa mala yálmúrû mala Jehoshafa murǝm Yahuda ka, Joram<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="fq" closed="false">Joram </char><char style="ft" closed="false">Jehoram</char></note> muna-ɓwabura mala Ahap duk murǝm Isǝrayila a Samariya, sǝ yálmúr aɓwana apǝlǝa lum-nong-ɓari. <verse eid="2KI 3:1" /><verse number="2" style="v" sid="2KI 3:2" />Joram pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, sǝama pa kǝla mala tárrí andǝ nggé ɗàng, acemǝnana arki kúnamúrú mala Ba'al mǝnana tárrí akdǝmba pè ka. <verse eid="2KI 3:2" /><verse number="3" style="v" sid="2KI 3:3" />Kat andǝ mǝno ka, lidǝmba nǝ pakki acauɓikea mǝnana Jerobuam muna-ɓwabura mala Nebat peǎ, <note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1KI 14:16">1Amur 14:16</ref> </char>.</note> sǝ tsǝk Isǝrayila a pě ka; pǝlǝ nzǝmi arǝ peǎ ɗàng.<verse eid="2KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 3:4" />Adyan ngga, Mesha murǝm Mowap ka, mǝlǝsǝ anzur na, sǝ koya pǝlǝa ka, dumǝna púp nǝ̀ mbwe cemi mala amuna-nzur á-gbǝman-mwashat andǝ nggú agam á-gbǝman-mwashat aban murǝm Isǝrayila. <verse eid="2KI 3:4" /><verse number="5" style="v" sid="2KI 3:5" />Sǝama anzǝm lú mala Ahap ka, murǝm Mowap mgbicau arǝ murǝm Isǝrayila. <verse eid="2KI 3:5" /><verse number="6" style="v" sid="2KI 3:6" />Acemani ka, Murǝm Joram purî ɓá Samariya a bàkú mǝno, sǝ ramba amǝ'lwa mala Isǝrayila kat. <verse eid="2KI 3:6" /><verse number="7" style="v" sid="2KI 3:7" />Sǝ túrban nǝ cau aban Jehoshafa murǝm Yahuda ama: &lt;&lt;Murǝm Mowap mgbinacau arǝàm. Awu nǝ ká atàm a munǝo arǝ Mowap le?&gt;&gt;</para>
  <para style="p" vid="2KI 3:7">Sǝ Jehoshafa eari wi ama, &lt;&lt;Mǝ nǝ ká atò. Mim sǝnǝ we ka sǝm nda mwashat. Aɓwana mem ngga aɓwana mò na, sǝ apǝr mem ngga apǝr mò na.&gt;&gt; <verse eid="2KI 3:7" /><verse number="8" style="v" sid="2KI 3:8" />Pǝlǝa Jehoshafa ɗìban ama, &lt;&lt;Nǝ ya njar sǝ sǝm nǝ̀ kàra?&gt;&gt;</para>
  <para style="p" vid="2KI 3:8">Joram eari wi ama, &lt;&lt;Nǝ njar ɓabondo mala Edom.&gt;&gt;<verse eid="2KI 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 3:9" />Nda murǝm Isǝrayila pur andǝ murǝm Yahuda andǝ murǝm Edom. Anzǝm mana à pàngŋǝ̀nà nongŋo tongno-nong-ɓari aban gya gumbǝliban ngga, mùr pà kàm ɗǝm acea andǝ agirkusǝu mǝnana ateà ka ɗàng. <verse eid="2KI 3:9" /><verse number="10" style="v" sid="2KI 3:10" />Pǝlǝa murǝm Isǝrayila bang ama, &lt;&lt;Mbak-kàngkàng, Yahweh yinanǝ sǝm, sǝm amurǝma mǝnia tàrú ka abanɓwáná ace túr sǝm a ɓabù murǝm Mowap.&gt;&gt;<verse eid="2KI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 3:11" />Jehoshafa ɗìban ama, &lt;&lt;Kǝ ɓè mǝɓangnǝa mala Yahweh pa akani, mǝnana sǝm nǝ̀ ɗìbancau aban Yahweh nǝbani ka re?&gt;&gt;</para>
  <para style="p" vid="2KI 3:11">Mwashat atà amǝgulo mala murǝm Isǝrayila ear ama, &lt;&lt;Elisha muna-ɓwabura mala Shafat na kani. Muna-ɓala mala Iliya na ɗiɗyal.&gt;&gt;<verse eid="2KI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 3:12" />Jehoshafa bang ama, &lt;&lt;E, Elisha ka, ndanǝ cau mala Yahweh a kúni.&gt;&gt; Nda murǝm Isǝrayila andǝ Jehoshafa andǝ murǝm Edom wari aban Elisha ka.<verse eid="2KI 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 3:13" />Sǝ Elisha ne murǝm Isǝrayila ama, &lt;&lt;Mana kpapiam sǝnǝ we? Kya aban amǝ'ɓangnǝa mala tárró andǝ amǝ'ɓangnǝa mala nggò.&gt;&gt;</para>
  <para style="p" vid="2KI 3:13">Sǝ murǝm Isǝrayila ear ama, &lt;&lt;Awo, Yahweh na yinǝ sǝm, sǝm amurǝma mǝnia tàrú ka abanɓwáná ace túr sǝm a ɓabù Mowap.&gt;&gt;<verse eid="2KI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 3:14" />Sǝ Elisha bang ama, &lt;&lt;Mbak-kàngkàng Yahweh, Mǝtala Abangŋo, mǝnana ǝn camgiyi aɓadǝmbi nakam ngga, ɓǝ̀ pa ace mǝnana ǝn nggǝ pè Jehoshafa murǝm Yahuda gulo raka, ɓǝ́ pà mǝ nǝ falǝ nǝ we ko mǝ nǝ sǝno ɗàng. <verse eid="2KI 3:14" /><verse number="15" style="v" sid="2KI 3:15" />Sǝama adyan ngga, wu yinǝam nǝ mǝ'wal jerang.&gt;&gt; Sǝ lang mǝ'wal jerang naban wal jerang ngga, bù Yahweh sulǝ amur Elisha. <verse eid="2KI 3:15" /><verse number="16" style="v" sid="2KI 3:16" />Sǝ bang ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh bang ngga: &lt;Mǝ nǝ tsǝk myalmur mǝ'ime man ɓǝ̀ lùmsǝ nǝ atūli-mùr,&gt; <verse eid="2KI 3:16" /><verse number="17" style="v" sid="2KI 3:17" />acemǝnana mǝnia ka nda cau mǝnana Yahweh kǝ na ka, &lt;Pà wu nǝ̀ ok ɓua mala gung ɗàng, sǝ pà wu nǝ̀ sǝn kǝ mbulo ɗàng, sǝ kat andǝ amani ka, myalmur mǝnia nǝ̀ lùmsǝ nǝ mùr, sǝ wun nǝ̀ nu, wun wunǝ andá ma'wun andǝ acili agirkusǝu ma'wun.&gt; <verse eid="2KI 3:17" /><verse number="18" style="v" sid="2KI 3:18" />Mǝnia ka gìr mǝhalkuǐ na a mǝsǝ Yahweh; ɗǝm ngga nǝ̀ túr amǝ'Mowap a ɓabù wun. <verse eid="2KI 3:18" /><verse number="19" style="v" sid="2KI 3:19" />Wun nǝ̀ soa munǝo arǝ koya kanggǝrang nggea-là, andǝ koya là mǝgule. Wun nǝ̀ mak koya nggun mǝɓoarne, sǝ wun nǝ̀ lùmsǝki atūli-mùr kat nǝ atali, sǝ wun nǝ̀ kiɗiki koya ɓaban mǝɓoarne nǝ atali.&gt;&gt;<verse eid="2KI 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 3:20" />Lang ban fana, nǝ bu-pwari mala pà gìr'nkila ka, kara mùr pur nǝ njar Edom, sǝ nzali lumsǝ nǝ mur.<verse eid="2KI 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 3:21" />Lang amǝ'Mowap kat ok ama amurǝma yina ace munǝo arǝia ka, à ram rǝia abanɓwáná; koya ɓwabura, lagga andǝ ɓwamǝgule mǝnana kārǝ́na nǝ̀ twal girbura ka, à puro sǝ à kya came a nzong-nzali malea. <verse eid="2KI 3:21" /><verse number="22" style="v" sid="2KI 3:22" />Sǝ lang à lo nǝ dǝmbari ɗiɗyal ka, pwari tǎ amur mùr, sǝ amǝ'Mowap sǝn mùr mǝnana a ɓadǝmbia ka báng bìng-bìng kǝla nkila. <verse eid="2KI 3:22" /><verse number="23" style="v" sid="2KI 3:23" />Amǝ'Mowap na ama, &lt;&lt;Man ngga nkila na; mbak-kàngkàng amǝno yì amurǝma ka à munǝna arǝarǝia sǝ à walna-lú rǝarǝia. Adyan ngga, wun amǝ'Mowap wu fa, ɓǝ̀ sǝm kya pwan gǝna-lwa!&gt;&gt;<verse eid="2KI 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 3:24" />Sǝama lang à yiu a kàttì mala Isǝrayila ka, amǝ'Isǝrayila lo arǝia nǝ munǝo sǝ à walia. Amǝ'Mowap ɓangŋa aɓadǝm amǝ'Isǝrayila, sǝ amǝ'Isǝrayila kùtí aɓa nzali mala amǝ'Mowap aban walia. <verse eid="2KI 3:24" /><verse number="25" style="v" sid="2KI 3:25" />À kiɗiki anggea-là mala amǝ'Mowap, sǝ koya ɓwabura ka túr tali aɓa koya ɓaban mǝɓoarne, à gìr múrí nǝ atali. À lùmsǝki atūli-mùr kat, sǝ à makki anggun mǝɓoarne kat. Kǝ nggea-là mǝnana ueo nǝmurǝi aɓa nzali Mowap ka nda Kir-Hareset. Amǝ'túr-ntamso gumbǝli, sǝ à munǝ arǝì. <verse eid="2KI 3:25" /><verse number="26" style="v" sid="2KI 3:26" />Lang murǝm Mowap sǝni ama munǝo no kǝ gandǝi ka, pwan amǝ'lwa gbǝman-tongno-nong-ɓari (700) atè nǝ anggeabyau sǝ ɓariki nǝ̀ sana ace ɓangŋa nǝ̀ ká aban murǝm Edom,<note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="fq" closed="false">ace ɓangŋa nǝ̀ ká aban murǝm Edom </char><char style="ft" closed="false">ko &lt;&lt;nǝ̀ ká aban murǝm Aram&gt;&gt;</char></note> sǝama à gandǝi ɗàng. <verse eid="2KI 3:26" /><verse number="27" style="v" sid="2KI 3:27" />Pǝlǝa murǝm bwal muna-ɓwabura muna-dǝmba male mǝnana nǝ̀ duk murǝm anzǝmi ka, sǝ pana ɓoro mala pa'girnkila mala pisǝe kǝring nǝi [aban ɓakuli mala amǝ'Mowap] amur sheran mala nggea-lê. Kara bumlulla mǝkǝ̀rkǝ́rnì lo arǝ Isǝrayila, sǝ Isǝrayila nyarnǝte arǝ munǝe, sǝ à nyar a nzali malea.<verse eid="2KI 3:27" /></para>
  <chapter eid="2KI 3" />
  <chapter number="4" style="c" sid="2KI 4" />
  <para style="s1">Elisha bwalì ɓè mā-lú mǝtǝr</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 4:1" />Adyan ngga, mālá ɓe ɓwabura a nggǝsan mala amǝ'ɓangnǝa warinǝ ɓua male aban Elisha ama, &lt;&lt;Guro mò, yì burém ngga wuna, sǝ a sǝlǝna ama yì ka mǝɓanggi Yahweh na. Sǝama ɓwa mǝnana kǝ kpata burém tangna ka, ndya yiu ace pwan amuna mem ɓari, ɓǝà pǝlǝa aguro male ka.&gt;&gt;<verse eid="2KI 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 4:2" />Sǝ Elisha ɗì ama, &lt;&lt;Mana a kǝ earce mǝ pakko? Banggam, mana a ndanǝi a ɓala?&gt;&gt;</para>
  <para style="p" vid="2KI 4:2">Ɓwame earî Elisha ama, &lt;&lt;Guro mò pànǝ kǝgir a ɓala ɗàng, shekǝ mùrú olif bǝti na ue aɓa muna-dù ka.&gt;&gt;<verse eid="2KI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 4:3" />Pǝlǝa Elisha ne wi ama, &lt;&lt;Kya alta ankwaring mǝnana kǝgir pa aɓalǝia raka a ban aɓio amǝ'murkala. Kǝa alta ankwaring bǝti ɗàng. <verse eid="2KI 4:3" /><verse number="4" style="v" sid="2KI 4:4" />Sǝ we wunǝ amuna-burana mô ka, wu kùtí a kurǝm sǝ wu gìr kun-nda. Solǝ mùrú olif mǝno ka aɓalǝ ankwaringnì kat. Nkwaring mǝnana lumsǝ ka, tusǝi tsǝi a nkanggariban.&gt;&gt;<verse eid="2KI 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 4:5" />Pǝlǝa ɓwame upi ban Elisha, sǝ yì andǝ amuna-burana male kùtí a kurǝm sǝ à gìr kun-nda. À yinǝi wi nǝ ankwaring sǝ camarǝ solǝ mùrú aɓalǝia. <verse eid="2KI 4:5" /><verse number="6" style="v" sid="2KI 4:6" />Lang ankwaring lumsǝkina nǝ mùrú ka, ne muna-ɓwabura male ama, &lt;&lt;Wu yinǝam nǝ ɓè nkwaring.&gt;&gt;</para>
  <para style="p" vid="2KI 4:6">Sǝ muna-ɓwabure earî wi ama, &lt;&lt;Ɓè nkwaring pà kàm ɗàng.&gt;&gt; Kara solǝo mala mùrú kasǝa.<verse eid="2KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 4:7" />Pǝlǝa puro kya ne Elisha ɓwa mala Ɓakuli, sǝ Elisha banggi wi ama, &lt;&lt;Kya mak mùruî sǝ wu mbwe atangna mò, sǝ cili ka nda aceo wunǝ amunio.&gt;&gt;<verse eid="2KI 4:7" /></para>
  <para style="s1">Elisha andǝ ɓwama Shunem</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 4:8" />A ɓè pwari ka, Elisha wari a Shunem, a ban mǝnana ɓè ɓwama mǝkume nakam nǝdo ka. Ɓwama man ɓuakiarǝ Elisha ɓǝ̀ lì girlina. Sǝ yi do ama, pwari mǝnana kat Elisha kútí nǝ njargula mǝno ka, nǝ̀ kàr ace lì girlina. <verse eid="2KI 4:8" /><verse number="9" style="v" sid="2KI 4:9" />Ɓwama man pǝlǝa ne burí ama, &lt;&lt;Sǝni, ǝn sǝlǝna ama ɓwa mǝnia kǝ kútí nǝ njargula man pwari-pwari ka, ɓwa mǝfele mala Ɓakuli na.&gt;&gt; <verse eid="2KI 4:9" /><verse number="10" style="v" sid="2KI 4:10" />Ɓǝ̀ sǝm ɓakkî wi muna-kurǝm a múr-kurǝm ma'sǝm nǝ asheran, sǝ ɓǝ̀ sǝm tsǝki wi gyangŋan-nongŋo, andǝ kpamgbang-tsǝk-agir, sǝ pitǝla aɓalǝi, ace mǝnana ɓǝ̀ aya pwari sǝ yiu aban sǝm ngga, nǝ̀ sulǝ a banì.<verse eid="2KI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 4:11" />A ɓè pwari ka, Elisha yiu sǝ kútí aɓa ndà mǝno, sǝ usǝlǝ kam. <verse eid="2KI 4:11" /><verse number="12" style="v" sid="2KI 4:12" />Pǝlǝa ne Gehazi muna-ɓala male ama, &lt;&lt;Tunǝ ɓwama Shunem man.&gt;&gt; Lang tunǝni ka, ɓwame yi came aɓadǝm Elisha. <verse eid="2KI 4:12" /><verse number="13" style="v" sid="2KI 4:13" />Sǝ Elisha banggi Gehazi ama, &lt;&lt;Ida ɗì ama, &lt;Sǝni, a ɗenyina nǝ sǝm nǝ agir mǝnia kat a pea ace sǝm ngga. Mana a kǝ earce ɓǝà pakko? A kǝ earce mǝ nacau nǝ murǝm ko mǝ'sàrǝ̀ban mala amǝ'lwa aceo le?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 4:13">Ɓwame ear ama, &lt;&lt;Mim ngga mǝ ndanǝdo aɓalǝ aɓwana mem.&gt;&gt;<verse eid="2KI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 4:14" />Sǝ Elisha ɗì Gehazi ama, &lt;&lt;Mana ado à nǝ̀ pà aceì?&gt;&gt;</para>
  <para style="p" vid="2KI 4:14">Gehazi eari wi ama, &lt;&lt;Pànǝ muna-ɓwabura ɗàng, sǝ burí ka ena.&gt;&gt;<verse eid="2KI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 4:15" />Elisha ama, &lt;&lt;Tunǝi ɓǝ̀ yiu ɗǝm.&gt;&gt; Sǝ lang Gehazi tunǝni ka, ɓwame yi came a kun-nda. <verse eid="2KI 4:15" /><verse number="16" style="v" sid="2KI 4:16" />Sǝ Elisha ne wi ama, &lt;&lt;A kúnì kǝla man a pǝlǝa mǝnana kǝ yiu ka, awu nǝ bwal muna-ɓwabura a buo.&gt;&gt;</para>
  <para style="p" vid="2KI 4:16">Sǝ ɓwame na ama, &lt;&lt;Awo, ɓwamǝgule mem, we ɓwa mala Ɓakuli, kǝa ne guro mò nyir ɗang.&gt;&gt;<verse eid="2KI 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 4:17" />Sǝama muna kpa a bum ɓwame, sǝ lang pǝlǝa kàrna a karǝa mala kúnì ka, ɓǝl muna-ɓwabura, kǝla mǝnana Elisha banggi wi ka.<verse eid="2KI 4:17" /></para>
  <para style="s1">Elisha loasǝ lú muna-ɓwabura mala ɓwama Shunem</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 4:18" />Lang munê gulna ka, o atà tárrí a ɓaban aban amǝ'pwan-gìrɓaban, a ɓè pwari. <verse eid="2KI 4:18" /><verse number="19" style="v" sid="2KI 4:19" />Sǝ munê ɓua aban tárrí ama, &lt;&lt;Oi, ɓamuram, ɓamuram!&gt;&gt;</para>
  <para style="p" vid="2KI 4:19">Tárrí ne mwashat atà amǝ'túró-ɓala male ama, &lt;&lt;Twali kyan nǝi aban nggè.&gt;&gt; <verse eid="2KI 4:19" /><verse number="20" style="v" sid="2KI 4:20" />Sǝ lang twalni yinanǝi aban nggè ka, munê nong a byal nggè bà pwarizǝkya, sǝ paklú. <verse eid="2KI 4:20" /><verse number="21" style="v" sid="2KI 4:21" />Ɓwame eauwe wario kya nongsǝ munê amur gyangŋan-nongŋo mala ɓwa mala Ɓakuli, gìr kún ndà amurí, sǝ puro.<verse eid="2KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 4:22" />Pǝlǝa tunǝ burí sǝ ne wi ama, &lt;&lt;Ida, tàsǝâm mwashat atà amǝ'túró-ɓala, sǝ mǝdambǝriso mwashat, ace mǝnana mǝ kya aban ɓwa mala Ɓakuli akaurǝa sǝ mǝ nyare.&gt;&gt;<verse eid="2KI 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 4:23" />Sǝ burí ɗì ama, &lt;&lt;Palang sǝ awu nǝ ká abaní yalung? Yalung ngga, pwari mǝdǝmbe mala <note caller="+" style="f"><char style="fr" closed="false">4:23 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="NUM 28:11">Ɓal 28:11</ref></char>.</note>Bǝsa Zongŋo na ɗang, sǝ pwari Sabbat na gbal ɗàng.&gt;&gt;</para>
  <para style="p" vid="2KI 4:23">Ɓwame ear ama, &lt;&lt;Koman ngga nda jam.&gt;&gt;<verse eid="2KI 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 4:24" />Pǝlǝa ɓwame tsǝk buno-nzǝm a nzǝm mǝdambǝriso, sǝ ne guro male ama, &lt;&lt;Fá akaurǝa; kǝa amsǝ larri ɗàng she ɓǝn nano ka.&gt;&gt; <verse eid="2KI 4:24" /><verse number="25" style="v" sid="2KI 4:25" />Nda ɓwame lo sǝ wari aban ɓwa mala Ɓakuli a Nkono Kamel.</para>
  <para style="p" vid="2KI 4:25">Lang ɓwa mala Ɓakuli sǝni kuko aban yiu ka, ne Gehazi guro male ama, &lt;&lt;Sǝni, ɓwama Shunem no kǝ yiu ka. <verse eid="2KI 4:25" /><verse number="26" style="v" sid="2KI 4:26" />Ɓangŋa kya kúllí ado, sǝ wu ɗî ama, &lt;A nda jam le? Burio ka nda jam? Sǝ munio ka nda jam le?&gt; &gt;&gt;</para>
  <para style="p" vid="2KI 4:26">Sǝ ɓwame ear ama, &lt;&lt;Koman ngga nda jam.&gt;&gt;<verse eid="2KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 4:27" />Lang yina aban ɓwa mala Ɓakuli a nkono ka, yi kùrì arǝ akusǝi. Gehazi wario nǝ̀ jambǝrǝ ɓwame. Sǝ ɓwa mala Ɓakuli ne wi ama, &lt;&lt;Ɗeki, kǝa pǝrki ɗàng! Nda aɓa bumkiɗikea mǝlime, sǝ Yahweh sǝmbǝrǝam cê, nam ɗàng.&gt;&gt;<verse eid="2KI 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 4:28" />Pǝlǝa ɓwame bang ama, &lt;&lt;Ɓwamǝgule mem, ǝn zǝmbo nǝma wu pam muna-ɓwabura le? Ən banggo mbak nǝma, &lt;Kǝa swarkiam ɗang&gt; re?&gt;&gt;<verse eid="2KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 4:29" />Pǝlǝa Elisha banggi Gehazi ama, &lt;&lt;Kàr nggea-daura mô, kùrì a taɓuno, sǝ wu twal gara mem a buo, sǝ wu ɓangŋa. Ɓǝ̀ wu je wunǝ kǝɓwa a njar ka, kǝa makki-wi-kún ɗàng, sǝ ɓǝ̀ kǝɓwa makko-kún ngga, kǝa akì wi ɗàng. Nongsǝ gara mem a múrbum munê.&gt;&gt;<verse eid="2KI 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 4:30" />Sǝama nggea muna bang ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam nǝyilǝmu, sǝ mbak-kàngkàng a ndakam nǝyilǝmu ka, pa mǝ nǝ nyio ɗàng.&gt;&gt; Nda Elisha lo o atà ɓwame ka.<verse eid="2KI 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 4:31" />Gehazi akia wia dǝmba, sǝ kya nongsǝ gara a múrbum munê, sǝama munê nacau ɗàng, sǝ dǝurǝ rǝì ɗàng. Acemani ka, Gehazi nyar aban Elisha, sǝ banggi wi ama, &lt;&lt;Mune lo ɗàng.&gt;&gt;<verse eid="2KI 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 4:32" />Lang Elisha yi kutina a ɓalae ka, yi sǝni ka, munê wuna sǝ à nongsǝni amur gyangŋan-nongŋo male. <verse eid="2KI 4:32" /><verse number="33" style="v" sid="2KI 4:33" />Pǝlǝa kutio sǝ gìr kun-nda amúria nǝ mbup-ɓàriá, sǝ pakhiwi aban Yahweh. <verse eid="2KI 4:33" /><verse number="34" style="v" sid="2KI 4:34" />Pǝlǝa eauwe nongŋo amur munê, sǝ tsǝk kúni arǝ kún munê, amǝsǝi amur amǝsǝ munê, sǝ abui amur abú munê. Sǝ lang sárǝ́ rǝì amur munê ka, rǝ muna pak lùlù. <verse eid="2KI 4:34" /><verse number="35" style="v" sid="2KI 4:35" />Pǝlǝa lo, sǝ gya kàrìban aɓa kurǝm. Sǝ nyare sárǝ́ rǝì amur muna ɗǝm. Muna pàk-atǝsho kusǝ tongno-nong-ɓari, sǝ mǝn amǝsǝi. <verse eid="2KI 4:35" /><verse number="36" style="v" sid="2KI 4:36" />Elisha pǝlǝa tunǝ Gehazi, sǝ ne wi ama, &lt;&lt;Tunǝ ɓwama Shunem man!&gt;&gt; Pǝlǝa Gehazi tunǝ ɓwame. Lang ɓwame yina abaní ka, Elisha ne wi ama, &lt;&lt;Twal munio.&gt;&gt; <verse eid="2KI 4:36" /><verse number="37" style="v" sid="2KI 4:37" />Ɓwame kutio sǝ kpa a kusǝ Elisha, ɓun a nzali. Pǝlǝa twal muni sǝ puro.<verse eid="2KI 4:37" /></para>
  <para style="s">Elisha tsǝk mbú mana nǝ barya arǝì ka <optbreak /> pǝlǝ mǝɓoarne</para>
  <para style="p">
    <verse number="38" style="v" sid="2KI 4:38" />Elisha wari ɗǝm a Gilgal. Nzal-gula nakam aɓa nzalinì. Sǝ lang nggǝsan mala amǝ'ɓangnǝa naban do aɓadǝmbi ka, banggi guro male ama, &lt;&lt;Tsǝk nkwaring mǝgule a bǝsa, sǝ wu lam mbú-gbǝlya ace aburana man.&gt;&gt;<verse eid="2KI 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2KI 4:39" />Ɓeɓwa aɓalǝia wari a ɓabondo ace alta ambúgir, sǝ kya kum mbwàrio-lâ-alú. Pǝlǝa pwan aɓǝla mbwàrio mǝno sǝ yi kasǝkia aɓa nkwaring, sǝ súrǝ̀ girnì ɗàng. <verse eid="2KI 4:39" /><verse number="40" style="v" sid="2KI 4:40" />Pǝlǝa à solǝ mbuî ace aburane ɓǝà li. Sǝ lang à tita lili ka, à ɓua ama, &lt;&lt;Ɓwa mala Ɓakuli, barya nakam aɓa mbú mǝnia!&gt;&gt; À gandǝ li ɗàng.<verse eid="2KI 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 4:41" />Sǝ Elisha na ama, &lt;&lt;Wu yinǝam nǝ muku.&gt;&gt; Pǝlǝa soe amur mbuî aɓa nkwaring, sǝ na ama, &lt;&lt;Wu pe aɓwana ɓǝà li.&gt;&gt; Sǝ à kum kǝgìr mǝɓike aɓa mbuî ɗǝm ɗàng.<verse eid="2KI 4:41" /></para>
  <para style="s">Elisha hatǝki girlina ace amǝ'ɓangnǝa</para>
  <para style="p">
    <verse number="42" style="v" sid="2KI 4:42" />Ɓè ɓwabura pur a Ba'al-Shalisha, sǝ yinǝì ɓwa mala Ɓakuli agbatali bǝredi lumi-ɓari mǝnana à pè nǝ mǝssa-bálì mǝnana tita ɓǝla a ɓaban ngga, atārǝia andǝ akir mǝssa mǝpwale aɓa buku. Sǝ Elisha bang ama &lt;&lt;Pe aɓwana ɓǝà li.&gt;&gt;<verse eid="2KI 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2KI 4:43" />Sǝ guro male na ama, &lt;&lt;Lang sǝ mǝ nǝ tsǝk girlina mǝnia [bǝti] ka aɓadǝm aburana gbǝman-mwashat?&gt;&gt;</para>
  <para style="p" vid="2KI 4:43">Sǝ Elisha nyare ne wi ama, &lt;&lt;Pe aɓwana ɓǝà li. Mǝnia ka nda cau mǝnana Yahweh bang ngga, &lt;À nǝ̀ li, sǝ cili nǝ̀ ueo.&gt; &gt;&gt; <verse eid="2KI 4:43" /><verse number="44" style="v" sid="2KI 4:44" />Pǝlǝa guro male tsǝk girline aɓadǝmbia, à li, sǝ à nying cili, kǝla mǝnana cau mala Yahweh bang ngga.<verse eid="2KI 4:44" /></para>
  <chapter eid="2KI 4" />
  <chapter number="5" style="c" sid="2KI 5" />
  <para style="s1">Twalban kwánó dakali mala Na'aman</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 5:1" />Adyan ngga ɓè ɓwabura na kam à tunǝki ama Naaman,<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 4:27">Luk 4:27</ref></char>.</note> mǝ'sàrǝ̀ban mala amǝ'lwa mala murǝm Suriya. Ndanǝ gulo sǝ kum earmúrú kǝ̀rkǝ́r a mǝsǝ ɓwamǝgule male, acemǝnana nǝ yì sǝ Yahweh pe Suriya limurǝm. Yì ka kanggǝrang mǝ'lwa na, sǝama mǝkwánó nggû na.<verse eid="2KI 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2KI 5:2" />A ɓè tǝlliban mǝnana amǝ'Suriya warinǝi amur Isǝrayila ka, amǝ'Suriya twalǝna ɓè muna-ɓwama a nzali Isǝrayila, sǝ yi duk mǝtúró-ɓadǝm mālá Naaman. <verse eid="2KI 5:2" /><verse number="3" style="v" sid="2KI 5:3" />Muna-ɓwama Isǝrayila man ne mālá-mǝtala'ɓala male ama, &lt;&lt;Ɓǝ̀ ɓwamǝgule mem nǝ̀ gandǝ kum mǝɓangnǝa mǝnana nda a Samariya ka, mǝɓangnǝa mǝno nǝ̀ twalîban dakali male.&gt;&gt;<verse eid="2KI 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 5:4" />Nda Naaman wario kya banggi murǝm cau mǝnana muna-ɓwama Isǝrayila man bang ngga. <verse eid="2KI 5:4" /><verse number="5" style="v" sid="2KI 5:5" />Sǝ murǝm Suriya bang ama, &lt;&lt;Kya ado. Mǝ nǝ tasǝ cautera aban murǝm Isǝrayila.&gt;&gt; Nda Naaman wario, sǝ twal amǝsǝ bolo-azǝrfa á-lumi-tàrú (30,000), andǝ amǝsǝ bolo-njengǝlan á-tongno-nong-mwashat (6,000), andǝ abǝsa agir-nggūrǝu lum a buì ka. <verse eid="2KI 5:5" /><verse number="6" style="v" sid="2KI 5:6" />Aɓa cautera mǝnana Na'aman warinǝi aban murǝm Isǝrayila ka, murǝm Suriya kǝ̀ bang ama, &lt;&lt;Nǝ mǝnia yì cautera ka, ǝn nggǝ tasǝ guro mem Naaman a bano, ace mǝnana wu twaliban kwánó nggû male ka.&gt;&gt;<verse eid="2KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 5:7" />Lang murǝm Isǝrayila ɓal mǝno yì cautera ka, kara san nggea-daura male sǝ na ama, &lt;&lt;Mǝ nda Ɓakuli le? Mǝ nǝ gandǝnǝ wal ɓwa, sǝ mǝ nyesǝ ɓwê nǝyilǝmu ɗǝm le? Palang sǝ murǝm Suriya tasǝ ɓwa abanam ama mǝ twalban dakali mala ɓwê? Usheni, wu sǝni, ndaban altacau arǝàm!&gt;&gt;<verse eid="2KI 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 5:8" />Sǝama lang Elisha ɓwa mala Ɓakuli ok ama murǝm Isǝrayila san daura male ka, túrban nǝ cau a baní ama, &lt;&lt;Ace mana sǝ a san daura mô? Tasǝ ɓwabure ɓǝ̀ yiu abanam, sǝ nǝ̀ sǝlǝ ama mǝɓangnǝa nakam a Isǝrayila.&gt;&gt; <verse eid="2KI 5:8" /><verse number="9" style="v" sid="2KI 5:9" />Nda Naaman wario, nǝ apǝr andǝ awaru-pǝr male, sǝ kya cam a kún ɓala mala Elisha ka. <verse eid="2KI 5:9" /><verse number="10" style="v" sid="2KI 5:10" />Sǝ Elisha túr mǝ'na-túrbân nǝ cau aban Naaman ama, &lt;&lt;Kyane kya sussǝ a Nggeasala Jodan kusǝ tongno-nong-ɓari, sǝ nggūrǝo nǝ̀ nyara-nggunì, sǝ awu nǝ ɓoarnsari.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 14:7">Pǝris 14:7</ref></char>.</note><verse eid="2KI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 5:11" />Sǝ Naaman ngga bumi-lullo, nyare o, kǝ na ama, &lt;&lt;Ən twali nǝma, mbak-kàngkàng yì ka nǝ̀ pur abanam, sǝ nǝ̀ came, nǝ̀ pakhiwi nǝ lullǝ Yahweh Ɓakuli male, sǝ nǝ̀ lǝmdǝ buì arǝàm, nǝ̀ twàlâm-ban kwánó-bǝsa. <verse eid="2KI 5:11" /><verse number="12" style="v" sid="2KI 5:12" />Anggeasala Abana andǝ Farpar, yià anggeasala mala Damaska ka, à ɓoaro-akútì koya nggeasala a Isǝrayila re? Pà mǝ nǝ gandǝnǝ sussǝ aɓalǝia sǝ rǝam nǝ̀ ɓoarnsari ɗang re?&gt;&gt; Nda pǝlǝa, nyare umnǝ bumlulla ka.<verse eid="2KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 5:13" />Sǝama aguro male yiu abaní sǝ à ne wi ama, &lt;&lt;Ɓwamǝgule, ɓǝ̀ mǝɓangnǝa bangŋǝno ama wu pak gìr mǝkwane ka, ɓǝ́ a pangmi re? Ado ka, ace mana sǝ a pà wunǝ nggá sussǝo, kǝla mǝnana banggo, sǝ rǝo nǝ̀ mal ka ɗang?&gt;&gt; <verse eid="2KI 5:13" /><verse number="14" style="v" sid="2KI 5:14" />Nda Naaman sulǝo wario, lim a mùr kusǝ tongno-nong-ɓari a Nggeasala Jodan, kǝla mǝnana ɓwa mala Ɓakuli ne wi ka, sǝ ngguí nyare pàk kǝla rǝ muna mǝkyauwe, sǝ rǝì ɓoarnsari.<verse eid="2KI 5:14" /></para>
  <para style="s1">Nzumon mala Gehazi</para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 5:15" />Pǝlǝa Naaman nyar aban ɓwa mala Ɓakuli, yì andǝ aburana male mǝnana kat atè ka, sǝ yi came aɓadǝm Elisha. Sǝ bang ama, &lt;&lt;Ado ka, ǝn sǝlǝna ama kǝ ɓè Ɓakuli pà kàm aɓa ɓanza kat ɗàng, she a Isǝrayila! Ida, ak ɓoro a bù guro mò.&gt;&gt;<verse eid="2KI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 5:16" />Sǝ Elisha bang ama, &lt;&lt;<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 3:14">3:14</ref>; <ref loc="1KI 17:1">1Amur 17:1</ref></char>.</note>Mbak-kàngkàng Yahweh nakam, mǝnana ǝn camgiyi aɓadǝmbi ka, pà mǝ nǝ ak kǝgir ɗàng.&gt;&gt; Sǝ Naaman ɓuaki arǝì ɓǝ̀ é, sǝ Elisha ka ginǝe.<verse eid="2KI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 5:17" />Pǝlǝa Naaman bang ama, &lt;&lt;Ɓǝ̀ a pà wunǝ é raka, ida earâm mǝ ɗàrǝ́ nzali ban mǝnia ka kpǝm, ɓǝ̀ bik twalo nzǝm apǝr-mǝdambǝriso ɓari,<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">[mǝ umnǝi a là mem ace ɓak gyangŋan nǝi] </char></note> ace mǝnana twal ado aban ká a dǝmba ka, mim guro mò ka, pà mǝ nǝ nyare mǝ nǝ pà gir'nkila mala pisǝe kǝring, ko pa ɓoro aban aɓea aɓakuli ɗǝm ɗàng she aban Yahweh. <verse eid="2KI 5:17" /><verse number="18" style="v" sid="2KI 5:18" />Sǝama ɓǝ̀ Yahweh twàlâm-ban mǝnia yì gìr ka, mim guro mò: Lang mǝ nǝ tsǝkta murǝm aɓa ndà mala Rimmon [ɓakuli male] ace peri a banì, sǝ sǝm nǝ̀ peri sǝnǝi ka, ɓǝ̀ Yahweh twalî guro mò banì ace mani.&gt;&gt; <verse eid="2KI 5:18" /><verse number="19" style="v" sid="2KI 5:19" />Elisha ne wi ama, &lt;&lt;O aɓa rǝpwala.&gt;&gt;</para>
  <para style="p" vid="2KI 5:19">Sǝama lang Naaman umni wi zak ka, <verse eid="2KI 5:19" /><verse number="20" style="v" sid="2KI 5:20" /><note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 4:12">4:12</ref></char>.</note>Gehazi, yì guro mala Elisha ɓwa mala Ɓakuli ka, ne ɓamurì ama, &lt;&lt;Sǝni, ɓwamǝgule mem nyìngŋǝ̀nà Naaman ɓwa'Suriya mǝnia ka, ak kǝgir a buì aɓalǝ agir mǝnana yinǝia ka ɗàng. Mbak-kàngkàng Yahweh nakam ngga, mǝ nǝ ɓangŋa atè, mǝ nggá ak ɓegìr a buì.&gt;&gt;<verse eid="2KI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 5:21" />Nda Gehazi ɓangŋa atà Naaman. Sǝ lang Naaman sǝn ɓeɓwa aban ɓangŋa atè ka, sulǝî waru-pǝr male ace kúllí ɓwê, sǝ ɗì ama, &lt;&lt;Jam le?&gt;&gt;<verse eid="2KI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 5:22" />Sǝ Gehazi eari wi ama, &lt;&lt;Koman ngga nda jam. Ɓwamǝgule mem túràm, mǝ banggo ama, &lt;Sǝni, alaggana ɓari mala nggǝsan mala amǝ'ɓangnǝa pur a nzali múr ankono mala Ifǝrem, sǝ à yina abanam adyan. Ida, pea wia amǝsǝ bolo-azǝrfa á-tàrú (3,000) andǝ agir-nggūrǝu banì ɓari.&gt; &gt;&gt;<verse eid="2KI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 5:23" />Naaman ne wi ama, &lt;&lt;Ida, ak amǝsǝ bolo-azǝrfa á-tongno-nong-mwashat (6,000.)&gt;&gt; Pǝlǝa Naaman tsǝk Gehazi ɓǝ̀ ak agirnì; sǝ kùr amǝsǝ bolo-azǝrfa á-tongno-nong-mwashat (6,000) aɓalǝ aluru ɓari, sǝ atārǝia andǝ agir-nggūrǝu banì ɓari ka, pè ɓari atà aguro male ɓǝà twalî Gehazi, ɓǝà kyanbi wi nǝia aɓadǝmbi. <verse eid="2KI 5:23" /><verse number="24" style="v" sid="2KI 5:24" />Lang Gehazi bingŋǝna mgbangban ngga, ak agirnì a bù aguronì sǝ tsǝia a ɓala. Pǝlǝa tasǝ aburane ɓǝà nyare. <verse eid="2KI 5:24" /><verse number="25" style="v" sid="2KI 5:25" />Pǝlǝa Gehazi kutio yi came aɓadǝm ɓwamǝgule male; sǝ Elisha ɗì ama, &lt;&lt;A wari ke, Gehazi?&gt;&gt; Gehazi eari wi ama, &lt;&lt;Guro mò wari a kǝ ban ɗang.&gt;&gt; <verse eid="2KI 5:25" /><verse number="26" style="v" sid="2KI 5:26" />Sǝ Elisha ne Gehazi ama, &lt;&lt;Bangŋo mem pa atò, lang ɓwabure sulǝî waru-pǝr male ace kúllió ka re? Mǝnia ka nda pwari ak boalo, andǝ agir-nggūrǝu, andǝ mùrú olif, andǝ aɓaban-anap, andǝ anzur, andǝ ajamnda, andǝ aguro aburana andǝ aguro amamǝna le? <verse eid="2KI 5:26" /><verse number="27" style="v" sid="2KI 5:27" />Acemani ka, dakali mala Naaman nǝ̀ lanzǝ arǝò wunǝ amǝ'keo tàtǝ́k.&gt;&gt;Nda Gehazi purî ɓadǝm Elisha, sǝ <note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 4:6">Pur 4:6</ref>; <ref loc="NUM 12:10">Ɓal 12:10</ref></char>.</note>dakali bwali, rǝì pwasǝo kǝla talimbulo ka.<verse eid="2KI 5:27" /></para>
  <chapter eid="2KI 5" />
  <chapter number="6" style="c" sid="2KI 6" />
  <para style="s">Elisha tsǝk mǝsǝ bero kyal amur mùr</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 6:1" />Pwari mwashat ka, nggǝsan mala amǝ'ɓangnǝa ne Elisha ama, &lt;&lt;Sǝni, ban mǝnia sǝm dukiyi kam aɓadǝmbo ka, ɓiki kyapa sǝm. <verse eid="2KI 6:1" /><verse number="2" style="v" sid="2KI 6:2" />Ida, eara sǝm ɓǝ̀ sǝm kya a Jodan, ace mǝnana koyan atà sǝm ngga ɓǝ̀ kya kasǝ gbǝlang nggun a banì, sǝ sǝm nǝ̀ yia pàkkî ɓamur rǝ sǝm ban mǝnana sǝm nǝ̀ duk kam ngga.&gt;&gt; Sǝ Elisha banggia wia ama, &lt;&lt;Wu kyane.&gt;&gt; <verse eid="2KI 6:2" /><verse number="3" style="v" sid="2KI 6:3" />Sǝ ɓwa mwashat ateà banggi wi ama, &lt;&lt;Ida, ɓǝ̀ awu nǝ ear ka, kya atà sǝm, sǝm aguro mò.&gt;&gt; Sǝ pea wia eare ama, &lt;&lt;Mǝ nǝ ká.&gt;&gt; <verse eid="2KI 6:3" /><verse number="4" style="v" sid="2KI 6:4" />Nda wari atea ka. Sǝ lang à bwalǝna Jodan ngga, à tita kasǝki anggun. <verse eid="2KI 6:4" /><verse number="5" style="v" sid="2KI 6:5" />Sǝ lang ɓeɓwa naban kasǝ nggun ngga, mǝsǝ bero male puro kpa a mùr. Mak'zwalo ama, &lt;&lt;Oi Ɓwamǝgule mem! Ən angnǝ'â.&gt;&gt;<verse eid="2KI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 6:6" />Pǝlǝa ɓwa mala Ɓakuli ɗì ama, &lt;&lt;Ake sǝ kpa?&gt;&gt; Lang lǝmdǝni wi banì ka, kasǝ muna gara sǝ túrí a banì, kara tsǝk mǝsǝ bero kyale. <verse eid="2KI 6:6" /><verse number="7" style="v" sid="2KI 6:7" />Sǝ ne wi ama, &lt;&lt;Twalì.&gt;&gt; Pǝlǝa lǝmdǝ buì twalì.<verse eid="2KI 6:7" /></para>
  <para style="s1">Apǝr andǝ awaru-pǝr mala bǝsa</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 6:8" />A kǝ pwari, mǝnana murǝm Suriya na aɓa munǝo andǝ Isǝrayila ka, tunǝ kpapi mala tàɓala andǝ amǝtúró male sǝ na ama, &lt;&lt;Mǝ nǝ tsǝk kàttì mem mala kánǝ munǝo a ban man andǝ ban mǝno.&gt;&gt;<verse eid="2KI 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 6:9" />Sǝama ɓwa mala Ɓakuli túrban nǝ cau aban murǝm Isǝrayila ama: &lt;&lt;Tsǝkiro, cè a kar nǝ ban man ɗang, acemǝnana amǝ'Suriya na ban sulǝ ace ká a banì.&gt;&gt; <verse eid="2KI 6:9" /><verse number="10" style="v" sid="2KI 6:10" />Sǝ murǝm Isǝrayila tasǝ cau a ban mǝnana mǝɓangnǝa lǝmdǝni wi sǝ nunakiri arǝì ka. Anggo sǝ amsǝ ɓamurì pà kusǝ mwashat ɗang pà kusǝ ɓari ɗàng.<verse eid="2KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 6:11" />Sǝ ɓabum murǝm mala Suriya lul kǝ̀rkǝ́r ace mǝnia yì gìr ka, sǝ tunǝ amǝtúró male sǝ ɗia ama, &lt;&lt;Pà wu nǝ̀ lǝmdǝam ɓwa mǝnana aɓalǝ sǝm, nda atà murǝm Isǝrayila ka re?&gt;&gt; <verse eid="2KI 6:11" /><verse number="12" style="v" sid="2KI 6:12" />Sǝ mwashat atà amǝtúró male banggi wi ama, &lt;&lt;Ɓwamǝgule mem, murǝm, kǝ ɓwa pà kàm aɓalǝ sǝm ɗang; Elisha na, yì mǝɓangnǝa mǝnana ndanǝdo a Isǝrayila ka. Kǝ banggi murǝm Isǝrayila acau mǝnana kat a ne a ndà-nongŋo mô ka.&gt;&gt;<verse eid="2KI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 6:13" />Sǝ murǝm bang ama, &lt;&lt;Wu kyane, wu sǝn ban mǝnana nda kam ngga, ace mǝnana mǝ tasǝ aburana mem ɓǝà kya bwali.&gt;&gt; Sǝ à banggi wi ama, &lt;&lt;Ndanǝdo a Dotan.&gt;&gt; <verse eid="2KI 6:13" /><verse number="14" style="v" sid="2KI 6:14" />Nda tasǝ apǝr andǝ awaru-pǝr andǝ amǝ'lwa mǝ'làkke, sǝ à wari nǝ du à kya gumbǝli nggea-lê.<verse eid="2KI 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 6:15" />Lang mǝtúró-ɓadǝm ɓwa mala Ɓakuli lo nǝ dǝmbari ɗiɗyal sǝ pur a nza ka, kara sǝni, amǝ'lwa nǝ apǝr andǝ awaru-pǝr gumbǝlina nggea-là kat. Sǝ banggi ɓwamǝgule male ama, &lt;&lt;Sǝm kutina aɓa tanni, ɓwamǝgule, mana sǝm nǝ̀ pa?&gt;&gt; <verse eid="2KI 6:15" /><verse number="16" style="v" sid="2KI 6:16" />Ɓwamǝgule male nyesǝî wi ama, &lt;&lt;Cè ɓangciu pakko ɗàng, acemǝnana aɓwana mana atà sǝm ngga, à kútì amǝnana à nda ateà ka.&gt;&gt; <verse eid="2KI 6:16" /><verse number="17" style="v" sid="2KI 6:17" />Pǝlǝa Elisha pakhiwi ama, &lt;&lt;Yahweh, mǝn mǝsǝi ɓǝ̀ sǝni.&gt;&gt; Yahweh mǝn mǝsǝ lagga man, sǝ sǝni ka, múr ankono lumsǝna nǝ apǝr andǝ awaru-pǝr mala bǝsa, à gumbǝlina Elisha.<verse eid="2KI 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 6:18" />Sǝ lang amǝ'Suriya sulǝ aban yiu arǝì ka, Elisha pakhiwi aban Yahweh ama, &lt;&lt;Ida, tsǝk aɓwana man ɓǝà pǝlǝ ante.&gt;&gt; Pǝlǝa Yahweh tsǝia à pǝlǝ ante, kǝla mǝnana cau mala Elisha bang ngga.<verse eid="2KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 6:19" />Elisha banggia wia ama, &lt;&lt;Njargulê nda mǝna ɗang, sǝ nggea-lê nda man ɗang; wu yiu atàm, sǝ mǝ nǝ kánǝ wun aban ɓwa mǝnana wu alkiyite ka.&gt;&gt; Sǝ gingnǝia aban kánǝia a Samariya.<verse eid="2KI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 6:20" />Lang à kutina aɓa Samariya ka, Elisha pakhiwi ama, &lt;&lt;Yahweh, mǝn mǝsǝ aburana mǝnia ka ace mǝnana ɓǝà sǝnban.&gt;&gt; Sǝ Yahweh mǝn mǝsǝia, à sǝn ɓamuria ka, à nda a tsùrú mala Samariya.<verse eid="2KI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 6:21" />Lang murǝm Isǝrayila sǝnia ka, ɗì Elisha ama, &lt;&lt;Tárrám, mǝ wal-luia le?&gt;&gt; <verse eid="2KI 6:21" /><verse number="22" style="v" sid="2KI 6:22" />Elisha eari wi ama, &lt;&lt;Awo, kǝa wal-luia ɗàng. Awu nǝ wal-lú aɓwana mana a nda mǝnana a bwalia bwalban-guro nǝ nggeabyau andǝ nta mò raka le? Tsǝkia wia girlina andǝ girnùná aɓadǝmbia ɓǝà li sǝ ɓǝà nú, sǝ wu ɗekia ɓǝà nyar aban mǝtala-ɓala malea.&gt;&gt; <verse eid="2KI 6:22" /><verse number="23" style="v" sid="2KI 6:23" />Nda murǝm pàk girlina-nàtà mǝgule acea; sǝ anzǝm mana à lina sǝ à nùnà ka, tasǝia ɓǝà o, sǝ à nyar aban mǝtala-ɓala malea. Twal a bàkú mǝno ka, amǝ'Suriya tamsǝ yinǝ tǝlliban a Isǝrayila.<verse eid="2KI 6:23" /></para>
  <para style="s1">Amǝ'lwa mala Suriya gumbǝli Samariya</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 6:24" />Nǝnzǝ́mò ka murǝm Ben-Hadat mala Suriya ramba amǝ'lwa male kat, sǝ à wari a Samariya à gumbǝli. <verse eid="2KI 6:24" /><verse number="25" style="v" sid="2KI 6:25" />Nzal-gula kpa a Samariya, sǝ mǝno yì gumbǝliban ngga lidǝmba gandǝa yi do ama à kǝ mak ɓamur mǝdambǝriso mǝsǝ bolo-azǝrfa lumi-tongno-nong-tàrú (80), sǝ kap mala ciuta-akutu ka, à kǝ mé mǝsǝ bolo-azǝrfa tongno.<verse eid="2KI 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 6:26" />A ɓè fara murǝm mala Isǝrayila na ban kútí nǝban sheran mala nggea-là, sǝ ɓè ɓwama loasǝ gì bang ama, &lt;&lt;Bwalam nggam, ɓwamǝgule mem, murǝm!&gt;&gt;<verse eid="2KI 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 6:27" />Sǝ murǝm earî wi ama, &lt;&lt;Ɓǝ̀ Yahweh nda mǝnana nǝ̀ bwalo kàm raka, mana mǝ nǝ gandǝ pá? Mǝ ndanǝ mǝsǝsa a katǝra ko mùr-anap mana mǝ nǝ po ka le?&gt;&gt; <verse eid="2KI 6:27" /><verse number="28" style="v" sid="2KI 6:28" />Sǝ murǝm ɗi ama, &lt;&lt;Nggearǝ man sàmbó ɗe nǒ?&gt;&gt; Sǝ ɓwame banggi wi ama, &lt;&lt;Ɓè ɓwama banggam ama ɓǝn pà munem ɓǝ̀ sǝm shè yalung, sǝ lí ka sǝm nǝ̀ shak male. <verse eid="2KI 6:28" /><verse number="29" style="v" sid="2KI 6:29" />Nda sǝm lam mem sǝm shè, sǝ banfana ka, ǝn ne wi nǝma, ɓǝ̀ yinǝ male ɓǝ̀ sǝm shè. Sǝ yì ka, sǝmbǝrǝ male.&gt;&gt;<verse eid="2KI 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 6:30" />Lang murǝm ok acau mala ɓwame ka, san gìr'nggūrǝu male. Sǝ lang kutio kǝ gya aban ká a nkanggari sheran ngga, aɓwe sǝni ka, daura-ɓalǝu mǝnana oasǝ ka anggubyau-doatú<note caller="+" style="f"><char style="fr" closed="false">6:30 </char><char style="fq" closed="false">anggubyau-doatú </char><char style="ft" closed="false">ko &lt;&lt;asanginagìr&gt;&gt;</char></note> na. <verse eid="2KI 6:30" /><verse number="31" style="v" sid="2KI 6:31" />Pǝlǝa bang ama, &lt;&lt;Ɓǝ̀ Ɓakuli ɓashiàm sǝ yale ɓǝ̀ ɓǝsǝlǝi kǝ̀rkǝ́r, ɓǝ̀ ɓamur Elisha, muna-ɓwabura mala Shafat, ue a myali yalung ngga.&gt;&gt;<verse eid="2KI 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 6:32" />Elisha ka nda ban do a ɓala male atārǝia andǝ aɓwana-mǝgule mala là. Murǝm tasǝ ɓè ɓwabura ɓǝ̀ akidǝmba, sǝ kaniama ɓwê bik ka, Elisha banggi aɓwana-mǝgule mǝno ama, &lt;&lt;Wu sǝni, man yì mǝ'walki-alú ka tasǝna ɓeɓwa ɓǝ̀ yi kasǝ ɓamuram? Lang wu sǝni mǝ'njarnì yina ka, wu gìr kunkurǝm sǝ wu eangnǝ arǝì. Gǝshi kusǝ mǝtala-ɓala male nda mǝno anzǝmi ka re?&gt;&gt; <verse eid="2KI 6:32" /><verse number="33" style="v" sid="2KI 6:33" />Lang Elisha na ban nacau piu ka, mǝ'njarnì yi tusǝo. Sǝ murǝm bang ama,<note caller="+" style="f"><char style="fr" closed="false">6:33 </char><char style="fq" closed="false">mǝ'njarnì yi tusǝo. Sǝ murǝm bang ama, </char><char style="ft" closed="false">Ibǝru gilǝ ama: mǝ'njarnì yi tusǝo sǝ bang ama,</char></note> &lt;&lt;Wu sǝni, mǝnia yì gìr mǝɓike ka, pur nǝban Yahweh. Palang sǝ mǝ nǝ kundǝ arǝ Yahweh ɗǝm?&gt;&gt;<verse eid="2KI 6:33" /></para>
  <chapter eid="2KI 6" />
  <chapter number="7" style="c" sid="2KI 7" />
  <para style="s1">Elisha pacau mala kum girlina</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 7:1" />Elisha ear ama, &lt;&lt;Wu kwakikir wun arǝ cau mala Yahweh! Yahweh bang ama, &lt;Lí nǝ bu-pwari kǝla man ngga, à nǝ̀ mak tasau mwashat mala muku mǝɓǝlke a kún shekel mwashat, sǝ tasau ɓari mala mǝssa-bálì ka, à nǝ̀ me a kún shekel mwashat, a bankutio aɓa nggea-là Samariya.&gt; &gt;&gt; <verse eid="2KI 7:1" /><verse number="2" style="v" sid="2KI 7:2" />Sǝ mǝtamurǝm mǝnana pàkkiyi murǝm gbasha ka, bang ama, &lt;&lt;Sǝni, ko ɓǝ̀ Yahweh nǝ̀ mǝngi afongǝran bumkuli ka, mǝna yì gìr ka nǝ̀ pàk le?&gt;&gt; Elisha banggi wi ama, &lt;&lt;Awu nǝ sǝni nǝ mǝsǝo, sǝ a pa wunǝ lì ko bǝti aɓalǝi ɗàng.&gt;&gt;<verse eid="2KI 7:2" /></para>
  <para style="s">Amǝ'Suriya ɓangŋa</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 7:3" />Adyan ngga aburana ine mǝnana amǝkwánó nggû<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt" closed="false"><ref loc="LEV 13">Pǝris 13</ref>; <ref loc="2KI 5">2Amur 5</ref></char></note> na ka, à nda ban do a bankutio mala kún nggea-là. À ne rǝia ama, &lt;&lt;Ace mana sǝ sǝm nǝ̀ duk kani aban kúndǝô sheɓǝ̀ sǝm wukina ka? <verse eid="2KI 7:3" /><verse number="4" style="v" sid="2KI 7:4" />Ɓǝ̀ sǝm na ama, &lt;Sǝm nǝ̀ kùtí aɓa nggea-là&gt; ka, nzala na aɓa nggea-là, sǝm nǝ̀ nggá wù kàm; sǝ ɓǝ̀ sǝm duk kani ka, sǝm nǝ̀ wù gbal. Ado ka, fa sǝm nǝ̀ umì a kàttì mala amǝ'Suriya, ɓǝ̀ sǝm kya ɓun abania! Ɓǝ̀ à nying sǝm nǝyilǝmu ka, sǝm nǝ̀ auwa; sǝ ɓǝ̀ à wal-lú sǝm ngga, kǝgir pà kàm sǝm nǝ̀ gandǝ pàk ɗàng, sǝm nǝ̀ wǔ.&gt;&gt; <verse eid="2KI 7:4" /><verse number="5" style="v" sid="2KI 7:5" />Nda à lo nǝ pwarikpǝra, à o a kàttì mala amǝ'Suriya; lang à bwal ban kàttì mala amǝ'Suriya ka, kǝ ɓwa pà kàm ɗàng. <verse eid="2KI 7:5" /><verse number="6" style="v" sid="2KI 7:6" />Yahweh angŋa-dǝmba tsǝ̀ngŋǝ̀nà amǝ'lwa mala amǝ'Suriya à ok gǝshi awaru-pǝr andǝ gǝshi apǝr, nggearǝ loasǝban mala bundǝo mala amǝ'lwa; sǝ à nea rǝia ama, &lt;&lt;Wu sǝni, murǝm Isǝrayila kúrna amurǝma mala amǝ'Hitti andǝ amurǝma mala amǝ'Masar, ɓǝà yiu arǝ sǝm.&gt;&gt; <verse eid="2KI 7:6" /><verse number="7" style="v" sid="2KI 7:7" />Acemani ka à lo, sǝ à um nǝ mire nǝ bù pwarikpǝra; à nying agumli malea, andǝ apǝr malea, andǝ amǝdambǝriso malea; sǝ nggearǝ kàttì ka, à nyì atàrǝì, sǝ à ɓangŋa ace amsǝ yilǝmia.<verse eid="2KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 7:8" />Lang amǝkwánó nggû yina a nkanggari kàttì ka, à kùtí aɓa ɓè gumli sǝ à li à nu. À pwan bolo-azǝrfa, andǝ bolo-njengǝlan, andǝ agir-nggūrǝu, sǝ à kya sǝmbǝrǝia. Pǝlǝa à nyare, à yi kútí aɓa ɓè gumli, sǝ à pwan agir kàm gbal, à kya sǝmbǝrǝia.<verse eid="2KI 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 7:9" />Pǝlǝa à ne arǝia ama, &lt;&lt;Sǝm pà aban pak mǝɓoarne ɗàng. Pwari man yalung ngga, pwari mala bǝsacau mǝɓoarne na, sǝ sǝm ne kǝɓwa ɗàng; ɓǝ̀ sǝm kúndǝô ba kwaro mala ban ngga, girpatanni nǝ̀ kum sǝm. Acemani ka, wu yiu ɓǝ̀ sǝm kya bangce aban amǝ'ɓala mala murǝm.&gt;&gt;<verse eid="2KI 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 7:10" />Nda sǝ à yi tunǝ amǝ'yál kún nggea-là. À banggia wia ama, &lt;&lt;Sǝm wari a kàttì mala amǝ'Suriya sǝ sǝm sǝni ka, kǝɓwa pà kàm ɗàng. Yale sǝm ok kǝ gì ɓwa ɗàng. Sǝama apǝr andǝ amǝdambǝriso ka, à nda kam piu a ban mǝnana à kùria kam ngga, sǝ agumli ka à nda atàrǝia.&gt;&gt; <verse eid="2KI 7:10" /><verse number="11" style="v" sid="2KI 7:11" />Pǝlǝa amǝ'yál kún nggea-là tunǝban sǝ à hamnǝ cê aban amǝ'ɓala murǝm. <verse eid="2KI 7:11" /><verse number="12" style="v" sid="2KI 7:12" />Pǝlǝa murǝm lo nǝ du sǝ banggi amǝtè ama, &lt;&lt;Mǝ nǝ na wun gìr mǝnana amǝ'Suriya pakka sǝm ngga. À sǝlǝna ama sǝm nda aɓa nzala, nda à purî ɓá kàttì malea ace ká sǝmbǝrǝa a ɓawan, nǝ ɗenyicau ama, &lt;Lang à purnì ɓá nggea-là ka, sǝm nǝ̀ bwalkia nǝyilǝmia sǝ sǝm nǝ̀ kùtí aɓa nggea-lê.&gt; &gt;&gt; <verse eid="2KI 7:12" /><verse number="13" style="v" sid="2KI 7:13" />Mwashat atà amǝtè ear ama, &lt;&lt;Ida, ɓǝ̀ aɓea aburana pwan tongno atà apǝr mǝnana à ue aɓa nggea-là ka, ɓǝà kyane. Ɓǝ̀ à au ka, à nda kǝla cili ɓwabundǝa mala Isǝrayila mǝnana ue aɓa nggea-là ka. Sǝ ɓǝ̀ à wù ka, à nǝ̀ pa kǝla ɓwabundǝa mala Isǝrayila mǝnana à kiɗikina ka. Ɓǝ̀ sǝm tasǝia ɓǝà kya sǝn gìr mǝnana kǝ kumban a kàttì mala amǝ'Suriya ka.&gt;&gt;<verse eid="2KI 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 7:14" />Nda à twal awaru-pǝr ɓari nǝ apǝr sǝ murǝm turia ɓǝà kya súrǝ̀ mana kum amǝ'lwa mala Suriya; banggia wia ama, &lt;&lt;Wu kyane, wu kya sǝnì.&gt;&gt;<verse eid="2KI 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 7:15" />À o ateà ɗār aban ká a Nggeasala Jodan. Njargula lumsǝ nǝ agir-nggūrǝu andǝ agirtúró mǝnana amǝ'Suriya sukkia aɓa mire malea ka. Pǝlǝa amǝnjar nyare à yi banggi murǝm.<verse eid="2KI 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 7:16" />Nda sǝ aɓwe puro à kya pwan gǝna-lwa mǝnana kat ue a kàttì mala amǝ'Suriya ka. À mak tasau mwashat mala muku mǝɓǝlke a kún shekel mwashat, sǝ tasau ɓari mala mǝssa-bálì ka, à me a kún shekel mwashat, kǝla mǝnana Yahweh bang ngga.<verse eid="2KI 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 7:17" />Adyan ngga murǝm tsǝ̀ngŋǝ̀nà mǝtè mǝnana pàkkiyi wi gbasha ka, ɓǝ̀ duk mǝ'sàrǝ̀ban a kún nggea-là. Sǝama lang ɓwabundǝa na ban ramggi'rǝia ace puro a kún nggea-là ka, à parki, wǔ, kǝla mǝnana ɓwa mala Ɓakuli bang a pwari mǝno murǝm warinǝi a baní ka. <verse eid="2KI 7:17" /><verse number="18" style="v" sid="2KI 7:18" />Mǝnia yì gìr ka yi kumban kǝla mana Elisha ɓwa mala Ɓakuli angŋa-dǝmba nanì murǝm ama, &lt;&lt;Tasau ɓari mala mǝssa-bálì ka, à nǝ̀ me a kún shekel mwashat, sǝ tasau mwashat mala muku mǝɓǝlke ka, à nǝ̀ me a kún shekel mwashat, lí nǝ bu-pwari kǝla mǝnia ka a bankutio aɓa nggea-là Samariya.&gt;&gt; <verse eid="2KI 7:18" /><verse number="19" style="v" sid="2KI 7:19" />Sǝama mǝno yì mǝtamurǝm ngga ɓinǝ earnǝ cê; nyesǝî ɓwa mala Ɓakuli ama, &lt;&lt;Ko ɓǝ̀ Yahweh nǝ̀ mǝngi afongǝran bumkuli ka, mǝna yì gìr ka nǝ̀ pàk le?&gt;&gt; Sǝ ɓwa mala Ɓakuli ne wi ama, &lt;&lt;Awu nǝ sǝni nǝ mǝsǝo, sǝ a pa wunǝ lì ko bǝti aɓalǝi ɗàng.&gt;&gt; <verse eid="2KI 7:19" /><verse number="20" style="v" sid="2KI 7:20" />Anggo sǝ yi kumi; aɓwe parki a kún nggea-là, wǔ.<verse eid="2KI 7:20" /></para>
  <chapter eid="2KI 7" />
  <chapter number="8" style="c" sid="2KI 8" />
  <para style="s">Murǝm nyesǝî ɓwama Shunem nzali male</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 8:1" />Adyan ngga, Elisha angŋa-dǝmba bangŋǝni ɓwama mǝnana nyesǝî muni a yilǝmu ka<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 4:8-37">2Amur 4:8-37</ref></char>.</note> ama, &lt;&lt;Lo wunǝ amǝ'ɓala mò kat, wu o a ban mǝnana kat wun nǝ̀ gandǝ ká ace do kam bǝti ka, acemǝnana Yahweh bangŋǝ́nà ama nzal-gula nǝ̀ kpa, sǝ nǝ̀ twal apǝlǝa tongno-nong-ɓari.<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="GEN 41:27">Tite 41:27</ref>,<ref loc="GEN 41:54">54</ref> </char>.</note>&gt;&gt; <verse eid="2KI 8:1" /><verse number="2" style="v" sid="2KI 8:2" />Anggo sǝ ɓwame lo sǝ kya pa kǝla mǝnana cau mala ɓwa mala Ɓakuli bang ngga. Yì andǝ amǝ'ɓala male ka à lo, sǝ à kya do a nzali mala amǝ'Filisti apǝlǝa tongno-nong-ɓari. <verse eid="2KI 8:2" /><verse number="3" style="v" sid="2KI 8:3" />Sǝ anzǝm apǝlǝa tongno-nong-ɓari ka, ɓwame nyarî nzali mala amǝ'Filisti, sǝ wari aban murǝm, kya zǝmbi wi ace mǝnana ɓǝ̀ nyesǝî wi ɓala male andǝ ɓaban male ka. <verse eid="2KI 8:3" /><verse number="4" style="v" sid="2KI 8:4" />Anggo ka murǝm na ban ɗi Gehazi, <note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="2KI 4:12">2Amur 4:12</ref>; <ref loc="2KI 5:20-27">5:20-27</ref></char>.</note> lagga mala ɓwa mala Ɓakuli, amur agir mǝgulke mǝnana kat Elisha peǎ ka. <verse eid="2KI 8:4" /><verse number="5" style="v" sid="2KI 8:5" />Sǝ lang Gehazi na ban bǝlì murǝm ɓá nyesǝe mana Elisha nyesǝ lú muna nǝ yilǝmu ka, ɓwame mǝnana Elisha nyesǝî muni nǝ yilǝmu ka, yiu ace zǝmbi murǝm ace ɓala male andǝ ɓaban male. Pǝlǝa Gehazi bang ama, &lt;&lt;Ɓwamǝgule mem, we murǝm, ɓwame nda mǝnia, sǝ muni mǝnana Elisha nyesǝi nǝ yilǝmu ka<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="2KI 4:35">2Amur 4:35</ref></char>.</note> ndya ka.&gt;&gt; <verse eid="2KI 8:5" /><verse number="6" style="v" sid="2KI 8:6" />Sǝ lang murǝm ɗì ɓwame ka, ɓwame banggi wi acê. Pǝlǝa murǝm twal mwashat atà amǝgulo male, banggi wi ama, &lt;&lt;Nyesǝ agir mǝnana amala ɓwama mǝnia na ka kat, kpapi andǝ agirɓaban mala aɓabanì mǝnana à pwan ngga, tite a pwari mǝnana nyingŋǝ̀nà nzalinì ka, ba yalung.&gt;&gt;<verse eid="2KI 8:6" /></para>
  <para style="s">Hazayel wal-lú Ben-Hadat</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 8:7" />Adyan ngga, Elisha wari a Damaska. Sǝ Ben-Hadat <note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="2KI 6:24">2Amur 6:24</ref></char>.</note> murǝm Suriya ka nda aɓa rǝkwana. Pǝlǝa à ne wi ama, &lt;&lt;Ɓwa mala Ɓakuli yina kani.&gt;&gt; <verse eid="2KI 8:7" /><verse number="8" style="v" sid="2KI 8:8" />Pǝlǝa murǝm banggi Hazayel ama, &lt;&lt;Twal ɓoro a buo, sǝ wu kyane, kya kum ɓwa mala Ɓakuli, wu ɗìbancau a ban Yahweh nǝbani, ama, &lt;Rǝkwana mǝnia a rǝàm ngga nǝ̀ mal le?&gt; &gt;&gt;<verse eid="2KI 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 8:9" />Pǝlǝa Hazayel wario nǝ̀ nggá kumi, sǝ twal ɓoro a buì ace Elisha; ɓoro mala agir mǝɓoarne ɗàngɗáng mala Damaska, mǝnana à pàk twalo mala nzǝm akalakadambi lumi-ine ka. Lang bingŋǝnà ka, yi cam a ɓadǝm Elisha sǝ bang ama, &lt;&lt;Muna-ɓwabura mô<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="2KI 5:13">2Amur 5:13</ref></char>.</note> Ben-Hadat murǝm Suriya na túrǎm a bano ka, kǝ ɗiban ama, &lt;Rǝkwana mǝnia a rǝàm ngga nǝ̀ mal le?&gt; &gt;&gt; <verse eid="2KI 8:9" /><verse number="10" style="v" sid="2KI 8:10" />Sǝ Elisha ne wi ama, &lt;&lt;Kyane, kya ne wi ama, &lt;Ɓafo, rǝkwane nǝ̀ malì rǝò,&gt; sǝama Yahweh lǝmdǝnam ama, mbak-kàngkàng nǝ̀ wǔ.&gt;&gt; <verse eid="2KI 8:10" /><verse number="11" style="v" sid="2KI 8:11" />Sǝ Elisha soa mǝsǝi sǝni nzolong, she lang Hazayel ka kǝsǝkya pakki wi. Pǝlǝa ɓwa mala Ɓakuli sak a ɓua. <verse eid="2KI 8:11" /><verse number="12" style="v" sid="2KI 8:12" />Sǝ Hazayel ɗì ama, &lt;&lt;Palang sǝ mǝtala-ɓala mem sa a ɓua?&gt;&gt; Elisha ear ama, &lt;&lt;Acemǝnana ǝn súrǝ́nà rǝ ɓealɓikea mǝnana awu nǝ pakkî amǝ'Isǝrayila ka. Awu nǝ soa bǝsa arǝ akanggǝrang-ban malea, sǝ awu nǝ wal-lú amuna-burana malea nǝ nggeabyau, sǝ awu nǝ arki ɓamur amuna mǝkeke malea shakat-shakat, sǝ awu nǝ zanzǝki bum amǝ'nggeamur malea.<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa; </char><char style="xt"><ref loc="1KI 19:17">1Amur 19:17</ref>; <ref loc="2KI 10:32-33">2Amur 10:32-33</ref>; <ref loc="2KI 13:3">13:3</ref></char>.</note>&gt;&gt;<verse eid="2KI 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 8:13" />Sǝ Hazayel ɗì ama, &lt;&lt;Yana nda mim guro mò, mǝnana ǝn kútì nvwa raka, sǝ mǝ nǝ gandǝ pak mǝnia yì gìr mǝgule ka?&gt;&gt; Elisha eari wi ama, &lt;&lt;Yahweh lǝmdǝnam ama awu nǝ duk murǝm Suriya.&gt;&gt;<verse eid="2KI 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 8:14" />Pǝlǝa Hazayel nying ban Elisha sǝ wari aban mǝtala-ɓala male, Ben-Hadat. Sǝ mǝtala-ɓala male ɗì ama, &lt;&lt;Mana Elisha banggo?&gt;&gt; Sǝ eari ama, &lt;&lt;Banggam ama, mǝsǝcau rǝkwane nǝ̀ malì rǝò.&gt;&gt; <verse eid="2KI 8:14" /><verse number="15" style="v" sid="2KI 8:15" />Sǝ lang ban nǝ nggá fà ka, Hazayel twal kungtung, liuwi a mùr, pǝlǝa kùmsǝî Ben-Hadat a ɓamǝsǝi she lang Ben-Hadat wuna ka. Pǝlǝa Hazayel duk murǝm a bancame male.<verse eid="2KI 8:15" /></para>
  <para style="s">Jehoram duk murǝm a Yahuda</para>
  <para style="r">(<ref loc="2CH 21:2-20">2 Acau la Apwari 21:2-20</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 8:16" />A tongnoia pǝlǝa mala do-bunomurǝm mala Joram, muna-ɓwabura mala Ahap, amur Isǝrayila, arǝ anonggio mǝnana Jehoshafat nda murǝm Yahuda ka, Jehoram muna-ɓwabura mala Jehoshafat, duk murǝm Yahuda. <verse eid="2KI 8:16" /><verse number="17" style="v" sid="2KI 8:17" />Apǝlǝa ɓǝlban male na lumi-tàrú-nong-ɓari (32) lang duk murǝm ngga, sǝ do-bunomurǝm male ka, apǝlǝa tongno-nong-tàrú (8) na, a Urǝshalima. <verse eid="2KI 8:17" /><verse number="18" style="v" sid="2KI 8:18" />Yì ka kpata kusǝ amurǝma mala Isǝrayila, kǝla mǝnana ɓala mala Ahap pàk ka, acemǝnana al ɓoarnsarile Ahap duk māmí. Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka. <verse eid="2KI 8:18" /><verse number="19" style="v" sid="2KI 8:19" />Kat andǝ amani ka, Yahweh eare nǝ̀ kiɗiki Yahuda ɗàng, acemǝnana angŋa-dǝmba panacau aban guro male Dauda<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 11:36">1Amur 11:36</ref>; <ref loc="1KI 15:4">15:4</ref></char>.</note> ama, amuna-burana male ɓǝà lidǝmba amur buno-murǝm, ɓǝà kǝ tá kǝla pitǝla tàtǝ́k.<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 21:7">2Acau 21:7</ref></char>.</note><verse eid="2KI 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 8:20" />A nza mala murǝm Jehoram ngga, nzali Edom mgbicau, purî ɓata yálban mala Yahuda, sǝ à tsǝk murǝm malea. <verse eid="2KI 8:20" /><verse number="21" style="v" sid="2KI 8:21" />Pǝlǝa Joram yàl-nkaring andǝ amǝ'lwa andǝ awaru-pǝr male, sǝ à wari a Zahir. A kano ka amǝ'lwa mala Edom kària aɓalǝu. Sǝama nǝ du ka, Jehoram andǝ amǝ'sàrǝ̀ban mala awaru-pǝr male ar nǝ ɓalǝ amǝ'lwa mala Edom sǝ à auwa. Sǝ amǝ'lwa mala Jehoram ngga, à ɓangŋa à o arǝ agumli malea. <verse eid="2KI 8:21" /><verse number="22" style="v" sid="2KI 8:22" />Anggo sǝ Edom mgbicau arǝ domurǝm mala Yahuda ba yalung. A bàkú mǝno ka, Libna gbal ka mgbicau.<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 21:13">Jes 21:13</ref>; <ref loc="2KI 19:8">2Amur 19:8</ref></char>.</note><verse eid="2KI 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 8:23" />Acili agir mǝnana à kumban a do-bunomurǝm mala Joram, andǝ agir mǝnana kat pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 8:23" /><verse number="24" style="v" sid="2KI 8:24" />Anggo sǝ Joram usǝlǝ atà akê, sǝ à tsǝì ateà a nggea-là mala Dauda; sǝ Ahaziya muna-ɓwabura male duk murǝm a bancame male.<note caller="+" style="f"><char style="fr" closed="false">8:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 22:40">1Amur 22:40</ref>; <ref loc="2KI 1:17">2Amur 1:17</ref></char>.</note><verse eid="2KI 8:24" /></para>
  <para style="s">Ahaziya duk murǝm a Yahuda</para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 8:25" />A lum-nong-ɓaria (12) pǝlǝa mala do-bunomurǝm mala Joram, muna-ɓwabura mala Ahap<note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 22:1-6">2Acau 22:1-6</ref></char> .</note> murǝm Isǝrayila ka, Ahaziya muna-ɓwabura mala Jehoram duk murǝm amur Yahuda.<note caller="+" style="f"><char style="fr" closed="false">8:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 9:29">2Amur 9:29</ref></char>.</note> <verse eid="2KI 8:25" /><verse number="26" style="v" sid="2KI 8:26" />Apǝlǝa ɓǝlban mala Ahaziya lang duk murǝm ngga, à nda lumi-ɓari-nong-ɓari (22), sǝ yálmúr aɓwana pǝlǝa mwashat a Urǝshalima. Lullǝ ngge nda Ataliya; ngge ka mǝkà Omri<note caller="+" style="f"><char style="fr" closed="false">8:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 16:23">1Amur 16:23</ref>; <ref loc="2CH 22:2">2Acau 22:2</ref></char>.</note> murǝm Isǝrayila na. <verse eid="2KI 8:26" /><verse number="27" style="v" sid="2KI 8:27" />Yì gbal ka, twalkusǝ pakkiagir mala ɓala mala Ahap, sǝ pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, kǝla mana ɓala mala Ahap pàk ka, acemǝnana yì ka nkil amǝ'ɓala mala Ahap na.<verse eid="2KI 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 8:28" />Ahaziya kpapi ɓamúrì andǝ Joram muna-ɓwabura mala Ahap ace kánǝ lwa arǝ Hazayel murǝm mala amǝ'Suriya a Ramot Gilǝyat, sǝ amǝ'Suriya tsǝkî Joram anpenye. <verse eid="2KI 8:28" /><verse number="29" style="v" sid="2KI 8:29" />Pǝlǝa murǝm Joram nyar a Jezǝril ace mǝnana ɓǝ̀ kya sonzǝ anpenye mǝnana amǝ'Suriya tsǝki wi a Rama, lang wari nǝ̀ lwa arǝ Hazayel murǝm Suriya ka. Sǝ Ahaziya, muna-ɓwabura mala Jehoram murǝm Yahuda wari ace mǝnana ɓǝ̀ kya sǝn Joram muna-ɓwabura mala Ahap a Jezǝril,<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 21:1">1Amur 21:1</ref></char>.</note> acemǝnana Joram ngga mǝrǝkwana na ka.<verse eid="2KI 8:29" /></para>
  <chapter eid="2KI 8" />
  <chapter number="9" style="c" sid="2KI 9" />
  <para style="s">À ɗārǝ́ Jehu ɓǝ̀ duk murǝm a Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 9:1" />Adyan ngga Elisha mǝɓangnǝa tunǝ ɓwa mwashat a nggǝsan mala amǝ'ɓangnǝa sǝ ne wi ama, &lt;&lt;Kàr kún nggea-daura mô, kùrrì a taɓuno, sǝ wu twal dù mùrú olif mǝnia ka a buo, sǝ wu o a Ramot Gilǝyat. <verse eid="2KI 9:1" /><verse number="2" style="v" sid="2KI 9:2" />Lang a bwalǝna ka, alta Jehu muna-ɓwabura mala Jehoshafat, mǝkà Nimshi. Pusǝì zak aɓalǝ aɓî, sǝ wu kyan nǝi aɓa ɓè kurǝm ɓaɓalǝu. <verse eid="2KI 9:2" /><verse number="3" style="v" sid="2KI 9:3" />Sǝ wu twal mùrú mǝnana aɓa dù ka, solǝì wi a ɓamuri, sǝ wu bang ama, &lt;Mǝnia ka nda cau mǝnana Yahweh bang ngga: Ən ɗārǝno, a nda murǝm amúr Isǝrayila.&gt; Anzǝm mǝno ka, mǝn kunkurǝm sǝ wu ɓang akaurǝa wu o; kǝa dǝndi ɗàng.&gt;&gt;<verse eid="2KI 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 9:4" />Pǝlǝa lagga mǝno, yì lagga mǝɓangnǝa ka wari a Ramot Gilǝyat. <verse eid="2KI 9:4" /><verse number="5" style="v" sid="2KI 9:5" />Sǝ lang bingŋǝ́nà ka, kya kum amǝ'sàrǝ̀ban-lwa na ban do atārǝia. Sǝ bang ama, &lt;&lt;Mǝ ndanǝ cau a bano, mǝ'sàrǝ̀ban.&gt;&gt; Sǝ Jehu ɗì ama, &lt;&lt;Aban yan mwashat atà sǝm?&gt;&gt; Sǝ laggè bang ama, &lt;&lt;Abano, we mǝ'sàrǝ̀ban.&gt;&gt; <verse eid="2KI 9:5" /><verse number="6" style="v" sid="2KI 9:6" />Pǝlǝa Jehu lo kútí a ɓala. Sǝ lagga mǝno solǝ mùruî a ɓamur Jehu, sǝ ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh, yì Ɓakuli mala Isǝrayila na ka: Ən ɗārǝó, a nda murǝm amúr aɓwana mala Yahweh, amúr Isǝrayila. <verse eid="2KI 9:6" /><verse number="7" style="v" sid="2KI 9:7" />Awu nǝ kiɗiki ɓala mala Ahap ɓwamǝgule mò, ace mǝnana mǝ mbwegìr-akúnì nkila mala aguro mem amǝ'ɓangnǝa, andǝ nkila mala aguro mala Yahweh mǝnana kat Jezebel sukki ka. <verse eid="2KI 9:7" /><verse number="8" style="v" sid="2KI 9:8" />Ɓala mala Ahap puppup ka, dumǝna púp nǝ̀ kìɗìkì, sǝ mǝ nǝ twalta koya muna-ɓwabura mǝnana pur a nkila mala Ahap ka, a Isǝrayila, ko guro, ko mǝnana nda atàrǝì ka. <verse eid="2KI 9:8" /><verse number="9" style="v" sid="2KI 9:9" />Sǝ mǝ nǝ kiɗiki ɓala mala Ahap kǝla mǝnana ǝn kiɗiki ɓala mala Jerobuam muna-ɓwabura mala Nebat, andǝ mala Ba'asha muna-ɓwabura mala Ahija ka. <verse eid="2KI 9:9" /><verse number="10" style="v" sid="2KI 9:10" />Sǝ anvwa nǝ̀ shak nyam Jezebel amur nzali a Jezǝril, sǝ kǝɓwa pà nǝ̀ tsǝk-luí ɗàng.&gt;&gt; Pǝlǝa laggè mǝn kunkurǝm, ɓangŋa o akaurǝa.<verse eid="2KI 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 9:11" />Lang Jehu pur aban amǝ'sàrǝ̀ban mala ɓwamǝgule male ka, à ɗi ama, &lt;&lt;Nda jam le? Palang sǝ mǝɓanggya man yiu a bano?&gt;&gt; Sǝ earia wia ama, &lt;&lt;Wu súrǝ́nà rǝ ɓwê andǝ acau male.&gt;&gt; <verse eid="2KI 9:11" /><verse number="12" style="v" sid="2KI 9:12" />Sǝ à ne wi ama, &lt;&lt;Mǝno nda mǝsǝcau ɗang; bangga sǝm ado.&gt;&gt; Pǝlǝa Jehu nea wia ama, &lt;&lt;Mǝnia ka nda gìr mǝnana banggam ngga, ama, &lt;Yahweh bang ama, Ən ɗārǝo, a nda murǝm amúr Isǝrayila.&gt; &gt;&gt; <verse eid="2KI 9:12" /><verse number="13" style="v" sid="2KI 9:13" />Pǝlǝa koya ɓwabura ateà ka, swár nggea-daura male akaurǝa sǝ sárǝí a kusǝ Jehu amúr aban-eauwe. À twang njawe, sǝ à loasǝ gia ama, &lt;&lt;Jehu ka murǝma!&gt;&gt;<verse eid="2KI 9:13" /></para>
  <para style="s">Jehu wal-lú Joram andǝ Ahaziya</para>
  <para style="p">
    <verse number="14-15" style="v" sid="2KI 9:14-15" />(Adyan ngga Murǝm Joram andǝ amǝ'lwa mala Isǝrayila kat ka, à warina a Ramot Gilǝyat ace mgbàllì amǝ'lwa mala Hazayel murǝm Suriya arǝ yinǝ lwa a Ramot Gilǝyat. Sǝama Murǝm Joram ngga, à tsǝki wi anpenye a munǝo mǝno andǝ Hazayel murǝm Suriya ka, sǝ nyare a Jezǝril ace ká sonzǝ anpenye mǝnana amǝ'Suriya tsǝki wi ka.) Nda Jehu muna-ɓwabura mala Jehoshafat, mǝkà Nimshi kùrkún amur Joram nǝ̀ wal-luí ka. Banggi aɓî amǝ'sàrǝ̀ban-lwa ama, &lt;&lt;Ɓǝ̀ mǝnia nda ɗenyicau ma'wun ngga, kǝɓwa ɓǝkǝa swár zàng ɓǝ̀ purî ɓá nggea-là ace ká bangce a Jezǝril ɗàng.&gt;&gt; <verse eid="2KI 9:14-15" /><verse number="16" style="v" sid="2KI 9:16" />Pǝlǝa Jehu lo eau aɓa waru-pǝr male, sǝ o a Jezǝril, acemǝnana Joram na kam aban nongŋo nǝ rǝkwana. Sǝ Ahaziya murǝm Yahuda gbal ka, nda kam abanì, acemǝnana angŋa-dǝmba warina ace sǝn Joram ngga.<verse eid="2KI 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 9:17" />Adyan ngga mǝ'sǝn múr nggea-là ka nda ban came amúr ndà-kulí mǝnana a Jezǝril ka, sǝ sǝn Jehu andǝ amǝtè aban yiu, sǝ loasǝ gì bang ama, &lt;&lt;Ən nggǝ sǝn nggǝsan mala aburana aban yiu.&gt;&gt; Sǝ Joram tasǝ cau ama, &lt;&lt;Wu twal mǝpǝr mwashat, wu túrí ɓǝ̀ kya kumia, sǝ ɓǝ̀ ɗia ama, &lt;Wu yiu aɓa rǝpwala le?&gt; &gt;&gt;<verse eid="2KI 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 9:18" />Nda ɓè ɓwabura a nzǝm pǝr wario kya kumia, sǝ bang ama, &lt;&lt;Murǝm na ama, &lt;Wu yiu aɓa rǝpwala le?&gt; &gt;&gt; Sǝ Jehu ear ama, &lt;&lt;Mana oasǝo arǝ dorǝpwala? Pǝlǝa atàm, sǝ wu yiu.&gt;&gt; Sǝ mǝ'sǝn múr nggea-là nyesǝ cau ama, &lt;&lt;Mǝ'na-túrbân bingŋǝna bania, sǝama pà aban nyare ɗang.&gt;&gt;<verse eid="2KI 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 9:19" />Pǝlǝa murǝm tasǝ ɓaria mǝpǝr, mǝnana wari abania sǝ banggia wia ama, &lt;&lt;Mǝnia ka nda cau mǝnana murǝm na ka, &lt;Wu yiu aɓa rǝpwala le?&gt; &gt;&gt; Sǝ Jehu pa eare ama, &lt;&lt;Mana oasǝo arǝ dorǝpwala? Pǝlǝa atàm, sǝ wu yiu.&gt;&gt;<verse eid="2KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 9:20" />Ɗǝm ngga mǝ'sǝn múr nggea-là nyesǝ cau ama, &lt;&lt;Bingŋǝna bania, sǝama pà aban nyare ɗang. Ɓwa mǝnana kǝ kok waru-pǝr a dǝmba ka, kǝ koe kǝla koě mala Jehu muna-ɓwabura mala Nimshi; kǝ koe wak.&gt;&gt;<verse eid="2KI 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 9:21" />Joram na ama, &lt;&lt;Wu kùrâm waru-pǝr mem arǝ apǝr.&gt;&gt; Lang à kùrna waru-pǝr arǝ apǝr ka, Murǝm Joram mala Isǝrayila andǝ Murǝm Ahaziya mala Yahuda puro, koyan ngga aɓa waru-pǝr male, ace ká je andǝ Jehu, sǝ à kya kum Jehu a ban nzali ɓaban mǝnana ɗiɗyal mala Nabot ɓwa'Jezǝril na ka. <verse eid="2KI 9:21" /><verse number="22" style="v" sid="2KI 9:22" />Sǝ lang Joram sǝn Jehu ka, ɗì ama, &lt;&lt;A yiu aɓa rǝpwala le, Jehu?&gt;&gt; Pǝlǝa earî wi ama, &lt;&lt;Ya dorǝpwala nǝ̀ pàk kàm mǝnana peri atà ankúl andǝ pakkiagir monzǝo mala nggo Jezebel ak koya ban ngga?&gt;&gt; <verse eid="2KI 9:22" /><verse number="23" style="v" sid="2KI 9:23" />Kara Joram wuli múr waru-pǝr male, ace ɓangŋa nǝ̀ o akaurǝa, sǝ kǝ ne Ahaziya ama, &lt;&lt;Ɓosǝkiban na, Ahaziya!&gt;&gt; <verse eid="2KI 9:23" /><verse number="24" style="v" sid="2KI 9:24" />Sǝ Jehu nun nta male nǝ rǝcandǝa male kat, ta Joram a nzǝmi nǝ mundi, kya tusǝ dunkile. Joram swárô kpa aɓa waru-pǝr male. <verse eid="2KI 9:24" /><verse number="25" style="v" sid="2KI 9:25" />Jehu banggi Bitkar, mǝ'pakkî-gbasha ama, &lt;&lt;Twali túrí aɓa nzali ɓaban mǝnana ɗiɗyal mala Nabot ɓwa'Jezǝril na ka. Ɓǝ̀ ɓalǝo kasǝa ama mim sǝnǝ we ka, sǝm nda mǝnana sǝm nda ban gya a nzǝm apǝr atà tárrí Ahap, lang Yahweh bang ɓashi mǝnia amurí ka ama: <verse eid="2KI 9:25" /><verse number="26" style="v" sid="2KI 9:26" />&lt;Kǝla mǝnana mbak-kàngkàng ǝn sǝn nkila mala Nabot andǝ mala amuni yilung ngga, mǝ nǝ mbwekô-akúní gìr mǝnana a pak ka, a mǝnia yì nzali ɓaban ngga.&gt; Ado ka, twali túrí amúr nzalî kǝla mana cau mala Yahweh na ka.&gt;&gt;<verse eid="2KI 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 9:27" />Lang Ahaziya murǝm Yahuda sǝn gìr mǝnana kumban ngga, ɓangŋa dǝshi Bet-Hagan. Sǝ Jehu pǝrte kǝ bang ama, &lt;&lt;Ɓǝà tè gbal.&gt;&gt; Pǝlǝa à tè aɓa waru-pǝr male amúr njar eauwe mala ɓangŋaban Gur, mǝnana nda a nkanggari Ibǝliyam ngga. Sǝ Ahaziya ɓangŋa akaurǝa o a Megido, sǝ kya wû kàm. <verse eid="2KI 9:27" /><verse number="28" style="v" sid="2KI 9:28" />Aguro male twal luí aɓa waru-pǝr, à umnǝi a Urǝshalima, sǝ à kya tsǝì a ɓembe-ɓa-tali male atà akê aɓa nggea-là mala Dauda.<verse eid="2KI 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 9:29" />Nda aɓa lum-nong-mwashatia pǝlǝa mala do-bunomurǝm mala Joram muna-ɓwabura mala Ahap, sǝ Ahaziya duk murǝm amúr Yahuda.<verse eid="2KI 9:29" /></para>
  <para style="s">Jehu wal-lú Jezebel</para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 9:30" />Pǝlǝa Jehu wari a Jezǝril. Lang Jezebel okce gìr mǝnana kumban ngga, hasǝki agir a mǝsǝi, sǝ gilǝki nyang-múrí, pǝlǝa came kǝ sǝnban a mǝsǝkurǝm. <verse eid="2KI 9:30" /><verse number="31" style="v" sid="2KI 9:31" />Lang Jehu nǝ̀ kùtí a kunɓala ka, Jezebel ɗì ama, &lt;&lt;A yiu aɓa rǝpwala le, <note caller="+" style="f"><char style="fr" closed="false">9:31 </char><char style="fq" closed="false">Zǝmri: </char><char style="ft" closed="false">Cau-sangban na arǝ Jehu ace kánǝ ɗenyicau mala arǝ Zǝmri mǝnana ak bunomurǝm sǝ yálmúrû male ka mala anonggio tongno-nong-ɓari na kutǝl; ɓalli aɓa: </char><char style="xt"><ref loc="1KI 16:8-20">1Amur 16:8-20</ref></char>.</note>Zǝmri mǝ'wal-lú ɓwamǝgule male?&gt;&gt; <verse eid="2KI 9:31" /><verse number="32" style="v" sid="2KI 9:32" />Sǝ Jehu loasǝ ɓamǝsǝi sǝnban nǝban mǝsǝkurǝm, sǝ bang ama, &lt;&lt;Yana kana nda atàm? Yana?&gt;&gt; Aɓea abaran lǝmdǝ ɓamǝsǝia a mǝsǝkurǝm, à sǝni. <verse eid="2KI 9:32" /><verse number="33" style="v" sid="2KI 9:33" />Jehu bang ama, &lt;&lt;Wu ramtè ɓǝ̀ yi kpa a nzali!&gt;&gt; Nda à ramtè yi kpa a nzali, sǝ apǝr andǝ waru-pǝr mala Jehu gya amurí à parki, nkile takkya arǝ bumkurǝm sǝ arǝ apǝr.<verse eid="2KI 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 9:34" />Jehu pǝlǝa kutio kya lili sǝ nu. Sǝ bang ama, &lt;&lt;Wu twal lú man yì suna ɓwama ka, sǝ wu kya tsǝî, acemǝnana yì ka ɓoarnsarile murǝm na ka.&gt;&gt; <verse eid="2KI 9:34" /><verse number="35" style="v" sid="2KI 9:35" />Sǝama lang à wario à nǝ̀ nggá tsǝì ka, à kya kum kǝ bare rǝì ɗàng, shekǝ nkpoula ɓamuri andǝ amu akusǝi andǝ abui. <verse eid="2KI 9:35" /><verse number="36" style="v" sid="2KI 9:36" />Pǝlǝa à nyare à kya ne Jehu. Pǝlǝa bang ama, &lt;&lt;Cau mala Yahweh mǝnana bangŋi nǝ kún guro male Iliya, ɓwa'Tishbe ka yi lúmsǝ̀nà. Bang ama: &lt;Aɓa mǝnia yì nzali ɓaban a Jezǝril ka, anvwa nǝ̀ shak nyam Jezebel, <verse eid="2KI 9:36" /><verse number="37" style="v" sid="2KI 9:37" />sǝ lú Jezebel ka dumǝna púp nǝ̀ duk kǝla gìgí amur nzali ɓaban mǝnana a Jezǝril ka. Kǝɓwa pà nǝ̀ gandǝ na ama: Mǝnia ka nda Jezebel ka&gt; ɗang.&gt;&gt;<verse eid="2KI 9:37" /></para>
  <chapter eid="2KI 9" />
  <chapter number="10" style="c" sid="2KI 10" />
  <para style="s">Jehu twalta nggurkwar mala Ahap</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 10:1" />Adyan ngga Ahap ndanǝ amuna andǝ amǝkau aburana lumi-tongno-nong-ɓari a Samariya. Nda Jehu gilǝ acauterǝa, turaban nǝia a Samariya, aban amǝ'yálmúrû mala Jezǝril, andǝ aɓwana-mǝgule, andǝ amǝ'tsǝkir amuna andǝ amǝkà Ahap ama, <verse eid="2KI 10:1" /><verse number="2" style="v" sid="2KI 10:2" />&lt;&lt;Ado ka, acemǝnana awaru-pǝr, andǝ apǝr, andǝ kanggǝrang nggea-là andǝ agirbura ka à nda a bu wun ngga, lang cauterǝa mǝnia nǝ̀ yia bwalban wun ani ka, <verse eid="2KI 10:2" /><verse number="3" style="v" sid="2KI 10:3" />wu twal ɓwa mǝnana mǝɓoarne na sǝ nda pepè ka, atà amuna-burana mala mǝtala-ɓala ma'wun, Murǝm Ahap. Wu dumsǝi amur buno-murǝm mala tárrí. Sǝ wu gilǝ rǝ wun ace munǝ ace ɓala mala mǝtala-ɓala ma'wun.&gt;&gt;<verse eid="2KI 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 10:4" />Sǝ yià ka ɓangciu bwalia kǝ̀rkǝ́r sǝ à na ama, &lt;&lt;Sǝni, amurǝma ɓari<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">amurǝma ɓari </char><char style="ft" closed="false">Murǝm Joram andǝ Murǝm Ahaziya.</char></note> gandǝ camakuni ɗàng; lang sǝ sǝm nǝ̀ gandǝi?&gt;&gt; <verse eid="2KI 10:4" /><verse number="5" style="v" sid="2KI 10:5" />Nda ɓwa mǝnana nda amúr ɓala-murǝm, andǝ ɓwa mǝnana nda amúr nggea-là, atārǝia andǝ aɓwana-mǝgule andǝ amǝ'tsǝkir amuna-murǝm ngga, à túrban nǝ cau aban Jehu ama, &lt;&lt;Sǝm nda ka guro mò, gir mǝnana kat a bangga sǝm ngga, sǝm nǝ̀ pè. Pà sǝm nǝ̀ twal kǝ ɓwa ɓǝ̀ duk murǝm ɗàng. Pàk gìr mǝnana kat ɓoarô a sǝne mò ka.&gt;&gt;<verse eid="2KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 10:6" />Pǝlǝa Jehu gilǝia wia ɓaria cauterǝa, banggia wia ama, &lt;&lt;Ɓǝ̀ mbak wu nda a buì mem, sǝ wun nǝ̀ kpata cau mem ngga, wu twal aɓamur aburana mǝnana amuna andǝ amǝkà mǝtala-ɓala ma'wun na ka a bu wun, sǝ wu yinǝia abanam a Jezǝril, lí nǝ bu-pwari kǝla man.&gt;&gt; Adyan ngga amuna andǝ amǝkà Murǝm Ahap, yià lumi-tongno-nong-ɓari ka, à nda aɓata tsǝkiru mala aɓwana-mǝgule mala nggea-lê. <verse eid="2KI 10:6" /><verse number="7" style="v" sid="2KI 10:7" />Lang cauterǝa yi bwalǝna bania ka, à bwalki amuna andǝ amǝ'kà Ahap à pwangi-myalia, aɓwana lumi-tongno-nong-ɓari. Sǝ à tsǝk aɓamuria aɓalǝ andakade, à túrban nǝia a baní a Jezǝril. <verse eid="2KI 10:7" /><verse number="8" style="v" sid="2KI 10:8" />Lang amǝ'na-túrbân yina ka, à banggi Jehu ama, &lt;&lt;À yina nǝ aɓamur amuna andǝ amǝkà Murǝm Ahap.&gt;&gt; Sǝ Jehu bang ama, &lt;&lt;Wu gwalikia amurǝarǝia arǝ abanì ɓari a bankutio mala kún nggea-là ba kwaro mala bân.&gt;&gt;<verse eid="2KI 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 10:9" />Nǝ dǝmbari ka, Jehu puro kya came a banì. Pǝlǝa banggi aɓwe kat ama, &lt;&lt;Mǝ nda mǝnana ǝn kùrkún amur mǝtala-ɓala mem, Murǝm Joram sǝ ǝn wal-luí ka. Wun nda ka amǝ'kunpwasǝa amur mani. Sǝama aburana man kat kǎ, yan wal-luia le? <verse eid="2KI 10:9" /><verse number="10" style="v" sid="2KI 10:10" />Wu sǝlǝa ama, kǝ ɓè pà kàm aɓa cau mala Yahweh, mǝnana Yahweh bangŋi amúr ɓala mala Ahap sǝ pà nǝ̀ lùmsǝ raka ɗàng. Yahweh pàngŋǝ̀nà gìr mǝnana kat pacau ace nǝ kún guro male Iliya ka.&gt;&gt; <verse eid="2KI 10:10" /><verse number="11" style="v" sid="2KI 10:11" />Anggo sǝ Jehu wal-lú aɓwana mǝnana kat à ue a ɓala mala Ahap a Jezǝril ka, kat andǝ aɓwana-mǝgule male, andǝ agyajam-ndà male, andǝ apǝris male. Nyinggi wi kǝ ɓwa nǝyilǝmu ɗang.<verse eid="2KI 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 10:12" />Jehu pǝlǝa lo a ban mǝno ka o a Samariya. Lang nda ban o amur njar sǝ yi bwalǝna Bet-Eket mala Ayálgír ka, <verse eid="2KI 10:12" /><verse number="13" style="v" sid="2KI 10:13" />je andǝ aɓea aɓǝla mala Ahaziya murǝm Yahuda, sǝ ɗia ama, &lt;&lt;Wu nda ka yani?&gt;&gt; Pǝlǝa à pe wi eare ama, &lt;&lt;Sǝm nda ka aɓǝla mala Ahaziya. Sǝm yiu ace sǝn amuna-murǝm andǝ amuna mala nggeau-murǝm.&gt;&gt; <verse eid="2KI 10:13" /><verse number="14" style="v" sid="2KI 10:14" />Sǝ Jehu bang ama, &lt;&lt;Wu bwalkia nǝyilǝmu!&gt;&gt;Nda à bwalkia, yia lumi-ine-nong-ɓari (42) nǝyilǝmia, sǝ à wal-luia a ban tūli-mùr mala Bet-Eket ka; nying kǝɓwa ateà ɗàng.<verse eid="2KI 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 10:15" />Lang lo a banì ka, kya je andǝ Jehonadap muna-ɓwabura mala Rekap, nda ban yiu a baní. Jehu makkìkun, sǝ bang ama, &lt;&lt;Ɓabumo na arǝàm kat kǝla mǝnana memma arǝò ka le?&gt;&gt; Jehonadap eari wi ama, &lt;&lt;E, nda anggo.&gt;&gt; Sǝ Jehu bang ama, &lt;&lt;Ɓǝ̀ nda anggo ka, pam buo.&gt;&gt; Pǝlǝa Jehonadap pe wi buì sǝ Jehu bwali eamsǝi atè aɓa waru-pǝr. <verse eid="2KI 10:15" /><verse number="16" style="v" sid="2KI 10:16" />Jehu bang ama, &lt;&lt;Yiu atàm yi sǝn ɓabumpina mem ace Yahweh.&gt;&gt; Nda twali atè aɓa waru-pǝr male ka.<verse eid="2KI 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 10:17" />Lang Jehu yina a Samariya ka, wal-lú aɓwana mǝnana kat à ueo sǝ à nda ka amǝ'ɓala mala Ahap a Samariya ka; twaltea kat, kǝla mǝnana cau mala Yahweh ne nǝ kún Iliya ka.<verse eid="2KI 10:17" /></para>
  <para style="s">Jehu wal-lú amǝ'peri aban Ba'al kat</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 10:18" />Jehu ram ɓwapǝndǝa kat sǝ banggia wia ama, &lt;&lt;Ahap kpata Ba'al bǝti, Jehu nǝ̀ kpate kpǝm! <verse eid="2KI 10:18" /><verse number="19" style="v" sid="2KI 10:19" />Acemani ka, wu tunǝâm amǝ'ɓangnǝa mala Ba'al kat, yià amǝ'peri a baní kat, andǝ apǝris male kat. Ɓǝ̀ kǝɓwa ɓǝkǝa ue ɗang, acemǝnana mǝ nǝ pa nggea gir'nkila mǝgule aban Ba'al. Ɓwa mǝnana ginǝ yiu ka, nǝ̀ ɗwanyi yilǝmi.&gt;&gt; Sǝama Jehu ka, kutan na kǝ pa ace twalta amǝ'peri aban Ba'al ka.<verse eid="2KI 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 10:20" />Sǝ Jehu bang ama, &lt;&lt;Wu tàr pwari ramba abanɓwáná ace pagulo aban Ba'al.&gt;&gt; Pǝlǝa à hamnǝi. <verse eid="2KI 10:20" /><verse number="21" style="v" sid="2KI 10:21" />Jehu tasǝ cau aɓa Isǝrayila kat, sǝ amǝ'kpata Ba'al yiu, kǝɓwa mwashat ue ateà mǝnana yiu raka ɗang. À yiu aɓa ndà mala Ba'al; sǝ ndà mala Ba'al lumsǝ ɓukyat-ɓukyat. <verse eid="2KI 10:21" /><verse number="22" style="v" sid="2KI 10:22" />Jehu banggi ɓwa mǝnana tsǝkiyikir ban tsǝk anggea-daura ka ama, &lt;&lt;Pusǝ anggea-daura ace amǝ'peri aban Ba'al kat!&gt;&gt; Sǝ pusǝ anggea-daure abania. <verse eid="2KI 10:22" /><verse number="23" style="v" sid="2KI 10:23" />Pǝlǝa Jehu kùtí aɓa ndà mala Ba'al, atārǝia andǝ Jehonadap muna-ɓwabura mala Rekap, sǝ banggi amǝ'peri aban Ba'al ama, &lt;&lt;Wu pelǝkiban wu sǝni ace mǝnana ɓekǝ guro mala Yahweh ɓǝkǝa pa akani aɓalǝ wun ɗàng, shekǝ amǝ'peri aban Ba'al.&gt;&gt; <verse eid="2KI 10:23" /><verse number="24" style="v" sid="2KI 10:24" />Pǝlǝa à kùtí ace pa gìr'nkila andǝ ɓoro mala pisǝe kǝring. Sǝama Jehu ka angŋa-dǝmba tamsǝna aburana male lumi-tongno-nong-tàrú a nza sǝ nunakiria ama, &lt;&lt;Ɓwa mǝnana kat earî kǝɓwa mwashat atà aɓwana mǝnana ǝn pa wun a bu wun sǝ ɓwar ka, nda a kún yilǝmi.&gt;&gt;<verse eid="2KI 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 10:25" />Lang Jehu nǝ̀ mal pa ɓoro mala pisǝe kǝring ani ka, banggi amǝ'yalban andǝ amǝgulo-lwa ama, &lt;&lt;Wu kutio wu wal-luia! Ɓǝ̀ kǝɓwa ɓǝkǝa au ɗàng!&gt;&gt; Nda amǝ'yalban andǝ amǝgulo-lwa kat wal-luia nǝ kún nggeabyau, sǝ à túrki aluia a nza; sǝ à kùtí aɓa kurǝm-ɓaɓalǝu mala ndà mala Ba'al. <verse eid="2KI 10:25" /><verse number="26" style="v" sid="2KI 10:26" />À pusǝki atondong mala peri aɓa ndà Ba'al, à pisǝia. <verse eid="2KI 10:26" /><verse number="27" style="v" sid="2KI 10:27" />À kiɗiki ankúl mala Ba'al, à arki ndà mala Ba'al, sǝ à nyesǝì pǝlǝ ban doagung, ba yalung.<verse eid="2KI 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 10:28" />Anggo sǝ Jehu esǝki peri aban Ba'al aɓa Isǝrayila. <verse eid="2KI 10:28" /><verse number="29" style="v" sid="2KI 10:29" />Kat andǝ amani ka, Jehu pǝlǝ nzǝmi arǝ acauɓikea mala Jerobuam muna-ɓwabura mala Nebat, mǝnana tsǝk Isǝrayila pàk ka ɗàng; peri aban amuna-jamnda njengǝlan mǝnana a Betel andǝ Dan ngga.<verse eid="2KI 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2KI 10:30" />Yahweh banggi Jehu ama, &lt;&lt;A pángŋǝ̀nà pepè. A pángŋǝ̀nà gìr mǝnana pwasǝbumam ngga, sǝ a pángŋǝ́nì ɓala Ahap kǝla mǝnana nda a ɓabumam ngga. Acemani ka, amunio andǝ amǝkeo nǝ̀ do amur buno-murǝm mala Isǝrayila ba inea nza.&gt;&gt; <verse eid="2KI 10:30" /><verse number="31" style="v" sid="2KI 10:31" />Sǝama Jehu tsǝkiri kpata nggurcau mala Yahweh, Ɓakuli mala Isǝrayila nǝ ɓabumi kat ɗàng. Pǝlǝ nzǝmi arǝ acauɓikea mala Jerobuam, mǝnana tsǝk Isǝrayila pè ka ɗàng.<verse eid="2KI 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 10:32" />A bàkú mǝno ka Yahweh tita amsǝ tangŋa mala nzong-nzali mala Isǝrayila; Hazayel lì ka abú-nzali mala Isǝrayila a lwa <verse eid="2KI 10:32" /><verse number="33" style="v" sid="2KI 10:33" />a takuli mala Jodan. Lì abu-nzali kat mala Gilǝyat, andǝ Gad, andǝ Ruben, andǝ Manasa, twal a Aruwa a myalmúr Arnon, kútí nǝɓa Gilǝyat sǝ kya puro a Bashan.<verse eid="2KI 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 10:34" />Acili agir mǝnana à kumban a do-bunomurǝm mala Jehu, andǝ agir mǝnana kat peǎ, andǝ rǝcandǝa male kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 10:34" /><verse number="35" style="v" sid="2KI 10:35" />Jehu usǝlǝ atà akê sǝ à tsǝì a Samariya. Muna-ɓwabura male Jehowahaz duk murǝm a kunì. <verse eid="2KI 10:35" /><verse number="36" style="v" sid="2KI 10:36" />Jehu yálmúr Isǝrayila apǝlǝa lumi-ɓari-bwamdǝ-tongno-nong-tàrú (28) a Samariya.<verse eid="2KI 10:36" /></para>
  <chapter eid="2KI 10" />
  <chapter number="11" style="c" sid="2KI 11" />
  <para style="s">Ataliya mā-murǝm mala Yahuda</para>
  <para style="r">(<ref loc="2CH 22:10-23:15">2 Acau la Apwari 22:10--23:15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 11:1" />Lang Ataliya nggea Ahaziya, ok ama muna-ɓwabura male wuna ka, lo, twalta tau-murǝm puppup. <verse eid="2KI 11:1" /><verse number="2" style="v" sid="2KI 11:2" />Sǝama <note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2CH 22:11">2Acau 22:11</ref> </char>.</note>Jehosheba, ɓoarnsarile Murǝm Joram, mǝnana mǝ'nggaula Ahaziya na ka, twal Jehohash muna-ɓwabura mala Ahaziya aɓa sǝmbǝrǝa, sǝ pusǝì aɓalǝ acili amǝtau-murǝm mǝnana zuku à nǝ̀ wal-luia ka. Wario kya sǝmbǝrǝì andǝ mǝ'iulǝe aɓa ndà-nongŋo. Anggo sǝ à sǝmbǝrǝì arǝ Ataliya, sǝ apî lú. <verse eid="2KI 11:2" /><verse number="3" style="v" sid="2KI 11:3" />Ue aɓa sǝmbǝrǝa andǝ mǝ'iulǝe a ɓala mala Yahweh apǝlǝa tongno-nong-mwashat, mǝnana Ataliya nda mǝ'yálmúr nzali Yahuda ka.<verse eid="2KI 11:3" /></para>
  <para style="s">À ɗārǝ́ Jehohash duk murǝm Yahuda</para>
  <para style="r">(<ref loc="2CH 23:1-21">2 Acau la Apwari 23:1-21</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 11:4" />A tongno-nong-ɓaria pǝlǝa ka, Jehoyada pǝris mǝgule túrban à tunǝ amǝgulo-lwa amur anggǝsan gbǝman-gbǝman mala amǝ'yáltà murǝm andǝ mala amǝ'yál palta, ɓǝà yiu a baní a ɓala mala Yahweh. Kùrcau andǝia, sǝ tsǝia à kángir mala pù-anzǝm, a ɓala mala Yahweh. Pǝlǝa lǝmdǝia wia muna-ɓwabura mala murǝm. <verse eid="2KI 11:4" /><verse number="5" style="v" sid="2KI 11:5" />Tsǝkia wia nzongcau ama, &lt;&lt;Mǝnia ka nda gìr mǝnana dumǝna púp wun nǝ̀ pàk ka: mwashat atà anggǝsan ma'wun tàrú mǝnana à nda a túró a pwari Sabbat ka, mwashat aɓa gauwe tàrú mala nggǝsan mǝnia ka, à nǝ̀ yál kún palta mala murǝm. <verse eid="2KI 11:5" /><verse number="6" style="v" sid="2KI 11:6" />Ɓè gauwe nǝ̀ camyale a kún Njarkutio mǝnana à tunǝi ama Sur ka, sǝ tàruià gauwe nǝ̀ camyale a kún njarkutio mǝnana a nzǝm amǝ'yál palta ka. Wun nǝ̀ yál koya buban mala palta. <verse eid="2KI 11:6" /><verse number="7" style="v" sid="2KI 11:7" />Anggǝsan ma'wun ɓari mǝnana à pa a túró a pwari Sabbat raka, à nǝ̀ yál ɓala mala Yahweh sǝ à nǝ̀ pakki murǝm [Jehohash] gbasha. <verse eid="2KI 11:7" /><verse number="8" style="v" sid="2KI 11:8" />Wu gumbǝli murǝm, koya ɓwa ka nǝ agirbura male a buì. Ɓwa mǝnana kat ar-njar dǝshi wun ngga, wu wal-luí. Wu gbashita murǝm a koya ban nǝ̀ ká ka.&gt;&gt;<verse eid="2KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 11:9" />Amǝgulo-lwa pak kǝla mǝnana Jehoyada pǝris tsǝia ɓǝà pak ka: koyan ngga yinǝ aburana male, amǝnana à nda a túró a pwari Sabbat ka, andǝ amǝnana à pa a túró a pwari Sabbat mǝno raka; à yiu kat aban Jehoyada pǝris. <verse eid="2KI 11:9" /><verse number="10" style="v" sid="2KI 11:10" />Pǝris pe amǝgulo-lwa amur anggǝsan gbǝman-gbǝman mǝnia ka anzo andǝ atongŋo mala Dauda, mǝnana à tsǝia a ɓala mala Yahweh ka. <verse eid="2KI 11:10" /><verse number="11" style="v" sid="2KI 11:11" />Amǝ'yáltà murǝm twal bancame malea, koyan ngga nǝ agirbura male a bui. À tsaɗi a kunarǝia twal a buì njar-kunmur mala ɓala mala Yahweh kya bwal buì njar-nza; à kàrì gyangŋan andǝ ɓalae, ace yál murǝm a koya buì. <verse eid="2KI 11:11" /><verse number="12" style="v" sid="2KI 11:12" />Jehoyada pǝlǝa yinǝ muna-ɓwabura mala murǝm a nza, sǝ oasǝi wi jeko-murǝm a múrí, sǝ pe wi Malǝmce Kùrcau sǝ hamnǝi ama nda murǝm. À ɗārǝi sǝ aɓwe wal ɓabuia, à loasǝ gia ama, &lt;&lt;Ɓǝ̀ yilǝmi murǝm sauwa!&gt;&gt;<verse eid="2KI 11:12" /></para>
  <para style="s">Lú mala Ataliya</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 11:13" />Lang Ataliya ok giu mak-gāwàn mala amǝ'yáltà murǝm andǝ acili aɓwe ka, puro wari aban aɓwe a ɓala mala Yahweh. <verse eid="2KI 11:13" /><verse number="14" style="v" sid="2KI 11:14" />Peliban sǝ sǝn murǝm aban came a nkanggari ɓè nggun-gbasha, mǝnana nda bancame mala murǝm a ɓala mala Yahweh ka. Amǝgulo-lwa andǝ amǝ'twang-njawe na ban came a nkanggari murǝm, sǝ aɓwe kat mala nzalinì na ban pàk-banɓoarnado, à kǝ twang anjawe. Ataliya bwal daura male sannì,<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="fq" closed="false">bwal daura male sannì </char><char style="ft" closed="false">ko &lt;&lt;kara bumkiɗikea bwali kǝ̀rkǝ́r.&gt;&gt;</char></note> sǝ mak-zwalo ama, &lt;&lt;Makban! Makban!&gt;&gt;<verse eid="2KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 11:15" />Pǝlǝa Jehoyada pǝris banggi amǝgulo-lwa amur anggǝsan gbǝman-gbǝman ama, &lt;&lt;Wu pùrnǝí a nre ka amǝ'yálban, sǝ ɓǝ̀ kǝɓwa lo nǝ̀ kpate ka, wu wal-luí nǝ nggeabyau.&gt;&gt; Yì pǝris ka bangŋǝna ama, &lt;&lt;Ɓǝà kǝa wal-luí a ɓala mala Yahweh ɗàng.&gt;&gt; <verse eid="2KI 11:15" /><verse number="16" style="v" sid="2KI 11:16" />Nda à gbami Ataliya sǝ à umnǝi a kún njarkutio mala apǝr aɓa palta, kam sǝ à wal-luí.<verse eid="2KI 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 11:17" />Jehoyada tsǝk murǝm andǝ aɓwana, à kùrcau andǝ Yahweh ama à nǝ̀ duk aɓwana mala Yahweh; sǝ tsǝk murǝm à kùrcau andǝ aɓwe. <verse eid="2KI 11:17" /><verse number="18" style="v" sid="2KI 11:18" />Pǝlǝa aɓwana mala nzalinì kat wari a ndà mala Ba'al, à arki. À arki agyangŋan andǝ aɓǝ̀nzál mala Ba'al rǝkǝs-rǝkǝs. Sǝ à wal-lú Matan, pǝris mala Ba'al aɓadǝm agyangŋan mǝno. Pǝlǝa Jehoyada pǝris tsǝk amǝ'camyale amur ɓala mala Yahweh. <verse eid="2KI 11:18" /><verse number="19" style="v" sid="2KI 11:19" />Twal amǝgulo-lwa mala anggǝsan gbǝman-gbǝman, andǝ amǝ'yáltà murǝm, andǝ amǝ'yál palta andǝ aɓwana mala nzalinì kat, sǝ yia atārǝia à lo a ɓala mala Yahweh ka, à tsǝkta murǝm Jehohash aban ká a palta. À kùtí a ɓala mala murǝm nǝ kún njarkutio mala amǝ'yáltà murǝm. Sǝ murǝm kya eauwe do amur buno-murǝm. <verse eid="2KI 11:19" /><verse number="20" style="v" sid="2KI 11:20" />Aɓwana mala nzalinì kat pakkiɗire. Nggea-là kat do aɓa rǝpwala anzǝm mana à walna-lú Ataliya a palta nǝ nggeabyau ka. <verse eid="2KI 11:20" /><verse number="21" style="v" sid="2KI 11:21" />Jehohash ndanǝ apǝlǝa ɓǝlban tongno-nong-ɓari lang duk murǝm ngga.<verse eid="2KI 11:21" /></para>
  <chapter eid="2KI 11" />
  <chapter number="12" style="c" sid="2KI 12" />
  <para style="s">Jehohash duk murǝm a Yahuda</para>
  <para style="r">(<ref loc="2CH 24:1-16">2 Acau la Apwari 24:1-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 12:1" />Nda aɓa tongno-nong-ɓaria pǝlǝa mala do-bunomurǝm mala Jehu murǝm Isǝrayila sǝ Jehohash<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">Jehohash </char><char style="ft" closed="false">ka, ɓè njar mala gilǝ lullǝ &lt;&lt;Johash&gt;&gt; na.</char></note> duk murǝm Yahuda, sǝ yálmúr aɓwana a Urǝshalima apǝlǝa lumi-ine. Lullǝ ngge nda Zibiya ɓwama Biyasheba. <verse eid="2KI 12:1" /><verse number="2" style="v" sid="2KI 12:2" />Jehohash pàk gìr mǝnana pwasǝbum Yahweh ka aɓa do-yilǝmu male kat kǝla mǝnana Jehoyada pǝris kàni wi ka. <verse eid="2KI 12:2" /><verse number="3" style="v" sid="2KI 12:3" />Kat andǝ amani ka, amgbangban-peri atà ankúl ka, à kiɗikia ɗàng; amǝ Isǝrayila lidǝmba nǝ ká pà gìr'nkila andǝ aɓoro amur amgbangban-peri atà ankúl.<verse eid="2KI 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 12:4" />Jehohash banggi apǝris ama, &lt;&lt;Dumǝna púp wun nǝ̀ aki aboalo mǝnana kat aɓwe kǝ yinǝia ace paɓoro mǝfele a ɓala mala Yahweh ka. Wu ea andǝ aboalo mǝnana kat à kasǝî koya ɓwa mana à ɓalli ɓǝ̀ pà ka, andǝ aboalo mana aɓwana pà, nǝ eare mala ɓabum ngga. <verse eid="2KI 12:4" /><verse number="5" style="v" sid="2KI 12:5" />Koyan atà apǝris ka, ɓǝ̀ ak aboale a bù aɓwana mǝnana à súrǝì ka. Sǝ dumǝna púp ɓǝà pàktúró nǝi ace gilǝki ban mǝnana kat à sǝni kìɗìkì arǝ ɓala mala Yahweh ka.&gt;&gt;<verse eid="2KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 12:6" />Sǝama yi bik lumi-ɓari-nong-tàruià pǝlǝa mala do-bunomurǝm mala Jehohash ka, apǝris tita pàk ɓekǝ túró gilǝki ɓalae ɗàng. <verse eid="2KI 12:6" /><verse number="7" style="v" sid="2KI 12:7" />Acemani ka, murǝm Jehohash tunǝ Jehoyada pǝris, andǝ acili apǝris sǝ ɗia ama, &lt;&lt;Palang sǝ wu pa aban gilǝki abân mǝnana à kìɗìkì arǝ ɓala mala Yahweh ka ɗàng? Ado ka, wu kǝa nyare wu bwal boalo mǝnana wu ak a bù aɓwana mǝnana à súrǝ̀ wun ngga ɗàng. Dumǝna púp wun nǝ̀ pà aboale ace gilǝki ɓala mala Yahweh.&gt;&gt; <verse eid="2KI 12:7" /><verse number="8" style="v" sid="2KI 12:8" />Nda apǝris ear ama à pà nǝ̀ ak boalo a bù aɓwe ɗǝm ɗàng, sǝ yia ɗǝm ngga à ear ama ɓǝ̀ aɓea aɓwana ak túró gilǝki ɓala mala Yahweh.<verse eid="2KI 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 12:9" />Pǝlǝa Jehoyada pǝris twal akwati-kpamgbang sǝ tusǝ tūli amur gírkuní, sǝ kya tsǝì atà bu-mǝli mala gyangŋan, tù nǝ bankutio a ɓala mala Yahweh. Apǝris mǝnana à camyale a kún bankutio ka, à tsǝk aboalo mǝnana kat aɓwe yinǝia a ɓala mala Yahweh ka aɓalǝi. <verse eid="2KI 12:9" /><verse number="10" style="v" sid="2KI 12:10" />Pwari mǝnana kat à sǝni ama akwatinî lùmsǝ̀nà nǝ boalo ka, mǝgilǝgir mala murǝm andǝ pǝris mǝgule nǝ̀ ɓal boalo mǝnana à yinanǝi a ɓala mala Yahweh ka, sǝ à nǝ̀ kùrki aɓalǝ aluru. <verse eid="2KI 12:10" /><verse number="11" style="v" sid="2KI 12:11" />Pǝlǝa à nǝ̀ pa boalo mǝnana à kārǝkina dǝmbǝrya male ka, a bù aɓwana mǝnana à tsǝia ace sǝntà-túrô ɓala mala Yahweh ka, ace mǝnana ɓǝà mbwe ka amǝ'ɓǎ andǝ amǝ'gbàlì-gìr mana à pàk túrô a ɓala mala Yahweh ka, <verse eid="2KI 12:11" /><verse number="12" style="v" sid="2KI 12:12" />andǝ amǝ'ɓakɓa-tali, andǝ amǝ'ɓun-tali. À pàktúró nǝ boale gbal ace kúrki agbǝlang-nggea'nggun andǝ atali mǝnana à kpalikinia ka, ace gilǝki abân mǝnana à kìɗìkì arǝ ɓala mala Yahweh ka, andǝ mbwegìr ace acili atúró mǝnana kat à peǎ mala gilǝki ɓalae ka. <verse eid="2KI 12:12" /><verse number="13" style="v" sid="2KI 12:13" />Sǝama à pàktúró nǝ boalo mǝnana à yinǝi a ɓala mala Yahweh ka ace pàk ankenye, andǝ amǝmyal, andǝ atasau, andǝ agàgàtú, ko ɓekǝ tanggǝla mala bolo-njengǝlan ko bolo-azǝrfa ɗang; <verse eid="2KI 12:13" /><verse number="14" style="v" sid="2KI 12:14" />à pà boale a ɓabu amǝ'túró mǝnana à pàktúró nǝi ace gilǝki ɓala mala Yahweh ka. <verse eid="2KI 12:14" /><verse number="15" style="v" sid="2KI 12:15" />À ɗice kǝ bǝlɓacau mala aboalo a ban aɓwana mǝnana à pea wia boalo a buia ace mbwe ka amǝ'túró ka ɗàng, acemǝnana à kǝ pàktúró nǝ mǝsǝcau. <verse eid="2KI 12:15" /><verse number="16" style="v" sid="2KI 12:16" />Aboalo mǝnana aɓwe pa kǝla pàgir mala mbwegìr ace kumcau, <note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 5:15">Pǝris 5:15</ref>,<ref loc="LEV 5:18">18</ref></char> .</note> ko pàgir ace cauɓikea <note caller="+" style="f"><char style="fr" closed="false">12:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 4:24">Pǝris 4:24</ref>,<ref loc="LEV 4:29">29</ref> </char>.</note> ka, à yinǝia a ɓala mala Yahweh ɗàng; mala apǝris na.<verse eid="2KI 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 12:17" />A bàkú mǝno ka, Hazayel murǝm Suriya lo wari nǝ munǝo arǝ nggea-là Gat sǝ e. Pǝlǝa tsǝk múrí nǝ̀ kánǝ munǝo arǝ Urǝshalima. <verse eid="2KI 12:17" /><verse number="18" style="v" sid="2KI 12:18" />Ace mgbàllì mǝno ka, Jehohash murǝm Yahuda pwan aɓoro mǝfele mǝnana kat akê Jehoshafat, andǝ Jehoram, andǝ tárrí Ahaziya, amurǝma mala Yahuda angŋa-dǝmba à pània aban Yahweh ka. Kpapia andǝ agir mǝfele mǝnana yì nǝnggearǝì angŋa-dǝmba pània aban Yahweh, andǝ bolo-njengǝlan mǝnana kat à kumi aɓalǝ andà-tsǝk agir-ɓoarna mala ɓala mala Yahweh, andǝ mala ɓala-murǝm ngga, sǝ túrban nǝ amǝnia yì agir ka aban Hazayel murǝm Suriya; nda sǝ Hazayel nyarnanǝte, yiu arǝ Urǝshalima raka.<verse eid="2KI 12:18" /></para>
  <para style="s">Lú mala Jehohash</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 12:19" />Acili agir mǝnana à kumban a do-bunomurǝm mala Jehohash andǝ agir mǝnana kat pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 12:19" /><verse number="20" style="v" sid="2KI 12:20" />Amǝtè lo à kùrkunia amurí sǝ à wal-lú Jehohash a Bet-Millo, amur njar ká a Sila. <verse eid="2KI 12:20" /><verse number="21" style="v" sid="2KI 12:21" />Amǝtè mǝnana à wal-luí ka, à nda ka Jozakar muna-ɓwabura mala Shimeyat andǝ Jehozabat muna-ɓwabura mala Shoma. À tsǝklú Jehohash a ɓembe-ɓa-tali mala akê a nggea-là mala Dauda. Muna-ɓwabura male Amaziya duk murǝm a bancame male.<verse eid="2KI 12:21" /></para>
  <chapter eid="2KI 12" />
  <chapter number="13" style="c" sid="2KI 13" />
  <para style="s">Jehowahaz yálmúr Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 13:1" />Nda aɓa lumi-ɓari-nong-tàruià (23) pǝlǝa mala do-bunomurǝm mala Jehohash muna-ɓwabura mala Ahaziya murǝm Yahuda sǝ Jehowahaz muna-ɓwabura mala Jehu duk murǝm amur Isǝrayila a Samariya, sǝ yálmúr aɓwana apǝlǝa lum-bwandǝ-tongno-nong-ɓari (17). <verse eid="2KI 13:1" /><verse number="2" style="v" sid="2KI 13:2" />Yì ka, pàkki agir mǝnana amǝɓike na a mǝsǝ Yahweh ka. Kpata pàkki acauɓikea mǝnana Jerobuam, muna-ɓwabura mala Nebat pàk ka, cauɓikea male mǝnana tsǝk Isǝrayila pè ka. Nying buì arǝ peǎ ɗàng. <verse eid="2KI 13:2" /><verse number="3" style="v" sid="2KI 13:3" />Nda sǝ bum Yahweh lul kǝ̀rkǝ́r arǝ amǝ Isǝrayila, sǝ camarǝ tasǝia a ɓabu Hazayel murǝm mala amǝ Suriya, sǝ a ɓabu Ben-Hadat muna-ɓwabura mala Hazayel ka.<verse eid="2KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 13:4" />Pǝlǝa Jehowahaz zǝm ɓwamuru a ban Yahweh, sǝ Yahweh ok hiwi male, acemǝnana Yahweh sǝn parban mǝnana amǝ Isǝrayila na aɓate ka; yì parban mǝnana murǝm Suriya kǝ parna Isǝrayila nǝi ka. <verse eid="2KI 13:4" /><verse number="5" style="v" sid="2KI 13:5" />(Pǝlǝa Yahweh yinǝì Isǝrayila mǝ'akmúrià sǝ à kum panzǝban a ɓabu rǝcandǝa mala Suriya. Acemani ka, amǝ Isǝrayila do aɓalǝ alá malea kǝla mana ɗiɗyal ka, jam. <verse eid="2KI 13:5" /><verse number="6" style="v" sid="2KI 13:6" />Kat andǝ amani ka, à gapitarǝia andǝ acauɓikea mala ɓala mala Jerobuam ɗàng, acauɓikea male mǝnana tsǝk Isǝrayila pè ka; à lidǝmba aɓalǝia. Tondong mala Ashera ue kam aɓa Samariya.) <verse eid="2KI 13:6" /><verse number="7" style="v" sid="2KI 13:7" />Kǝ amǝ'lwa ueo a bù Jehowahaz ɗàng shé amǝpǝr lumi-tongno, andǝ awaru-pǝr lum, andǝ asoje-kusǝu á-lum; acilia kat ka murǝm Suriya kiɗikinia sǝ parkinia a ɓakusǝi kǝla tú.<verse eid="2KI 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 13:8" />Adyan ngga acili agir mǝnana à kumban a do-bunomurǝm mala Jehowahaz, andǝ atúró mǝnana kat pàkkia, andǝ rǝcandǝa male ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 13:8" /><verse number="9" style="v" sid="2KI 13:9" />Jehowahaz paklú sǝ à tsǝk-luí a Samariya. Muna-ɓwabura male Jehohash ak bancame male kǝla murǝm.<verse eid="2KI 13:9" /></para>
  <para style="s">Jehohash duk murǝm Isǝrayila</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 13:10" />A lumi-tàrú-bwamdǝ-tongno-nong-ɓaria (37) pǝlǝa mala do-bunomurǝm mala Johash amur Yahuda ka, Jehohash muna-ɓwabura mala Jehowahaz duk murǝm mala Isǝrayila, yálmúr aɓwana a Samariya apǝlǝa lum-bwamdǝ-tongno-nong-mwashat (16). <verse eid="2KI 13:10" /><verse number="11" style="v" sid="2KI 13:11" />Yì ka, pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka. Pǝlǝ nzǝmi arǝ acauɓikea kat mala Jerobuam muna-ɓwabura mala Nebat ɗàng, acauɓikea male mǝnana tsǝk Isǝrayila pè ka; Jehohash lidǝmba aɓalǝ acauɓikea mǝno. <verse eid="2KI 13:11" /><verse number="12" style="v" sid="2KI 13:12" />Adyan ngga acili agir mǝnana à kumban a do-bunomurǝm mala Jehohash, atúró mǝnana kat pàkkia, andǝ rǝcandǝa male mǝnana munǝ nǝi arǝ Amaziya murǝm Yahuda ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 13:12" /><verse number="13" style="v" sid="2KI 13:13" />Johash paklú atà akê, sǝ à tsǝì a Samariya atà amurǝma mala Isǝrayila. Sǝ Jerobuam eau a buno-murǝm male.<verse eid="2KI 13:13" /></para>
  <para style="s">Lú mala Elisha</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 13:14" />Adyan ngga, Elisha twal nǝ rǝkwana mǝnana nǝ̀ kánǝi a lú ka, pǝlǝa Johash murǝm Isǝrayila wari a baní sǝ ɓua aɓadǝmbi, kǝ na ama, &lt;&lt;Oi dâ! Oi dâ! Awaru-pǝr mala Isǝrayila andǝ amǝpǝr male!&gt;&gt;<verse eid="2KI 13:14" /></para>
  <para style="p">
    <verse number="15-16" style="v" sid="2KI 13:15-16" />Elisha banggi wi ama, &lt;&lt;Twal nta andǝ amundi.&gt;&gt; Sǝ Johash twal nta andǝ amundi. Elisha tsǝk abui amur abú murǝm <verse eid="2KI 13:15-16" /><verse number="17" style="v" sid="2KI 13:17" />sǝ bang ama, &lt;&lt;Mǝn mǝsǝkurǝm mǝnana sǝn takuli ka.&gt;&gt; Sǝ yì gbal ka mǝni. Pǝlǝa Elisha bang ama, &lt;&lt;Túr mundi!&gt;&gt; Johash túr mundi, sǝ Elisha na ama, &lt;&lt;Mǝno ka nda mundi mala limurǝm mala Yahweh, andǝ mundi mala limurǝm amur Suriya. Awu nǝ gandǝ amǝ'Suriya a munǝo a Afek ba a kiɗikinia kat-kat ka.&gt;&gt;<verse eid="2KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 13:18" />Sǝ Elisha bang ama, &lt;&lt;Bwal acili amundi sǝ wu zuɓiki nzali nǝia.&gt;&gt; Pǝlǝa Johash bwalia sǝ zuɓiki nzali nǝia kusǝ tàrú, sǝ came. <verse eid="2KI 13:18" /><verse number="19" style="v" sid="2KI 13:19" />Bum ɓwa mala Ɓakuli lul arǝì, sǝ banggi wi ama, &lt;&lt;Ɓǝ́ a zuɓikina nzali kusǝ tongno ko tongno-nong-mwashat wuni; anggo ka ɓǝ́ a gandǝna Suriya sǝ a kiɗikini kat-kat. Sǝ ado ka kusǝ tàrú ɓǝ̀rɓǝ̀r na awu nǝ gandǝ Suriya ka.&gt;&gt;<verse eid="2KI 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 13:20" />Elisha yi paklú sǝ à tsǝì a ɓembe.</para>
  <para style="p" vid="2KI 13:20">Adyan ngga anggǝsan mala amǝ'tǝllìban mala amǝ'Mowap kǝ kútí nǝ lúllô aɓa nzalinì koya tita pǝlǝa. <verse eid="2KI 13:20" /><verse number="21" style="v" sid="2KI 13:21" />A ɓè fara ka, aɓea aburana na ban tsǝklú ɓè ɓwabura, kara à sǝn ɓè nggǝsan mala amǝ'tǝllìban, pǝlǝa à túr lú ɓwabure a ɓembe-ɓa-tali mala Elisha. Lang lú ɓwabure je ka amú Elisha ka, kara lo nǝyilǝmu, cam amur akusǝi.<verse eid="2KI 13:21" /></para>
  <para style="s">Isǝrayila nyare-ak anggea-là a bù Suriya</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 13:22" />Adyan ngga, Hazayel murǝm Suriya par Isǝrayila aɓa do-bunomurǝm mala Jehowahaz kat. <verse eid="2KI 13:22" /><verse number="23" style="v" sid="2KI 13:23" />Sǝama Yahweh ɓwamuria, sǝn mǝsǝswatǝr malea. Lǝmdǝia wia earmúrú atàcau mala kùrcau male andǝ Ibǝrayim, andǝ Ishaku, andǝ Yakupu. Earce ama, nǝ̀ kiɗikia ko nǝ̀ pusǝia ɓǝà purî ɓadǝmbi ɗàng ba yalung. <verse eid="2KI 13:23" /><verse number="24" style="v" sid="2KI 13:24" />Lang Hazayel murǝm Suriya wuna ka, Ben-Hadat muna-ɓwabura male duk murǝm a bancame male. <verse eid="2KI 13:24" /><verse number="25" style="v" sid="2KI 13:25" />Pǝlǝa Jehohash muna-ɓwabura mala Jehowahaz nyare-ak anggea-là mǝnana ɗiɗyal Ben-Hadat muna-ɓwabura mala Hazayel lia a bù tárrí Jehowahaz ka. Johash lì nǝ munǝo kusǝ tàrú, pǝlǝa nyare-ak anggea-là mala Isǝrayila.<verse eid="2KI 13:25" /></para>
  <chapter eid="2KI 13" />
  <chapter number="14" style="c" sid="2KI 14" />
  <para style="s">Do-bunomurǝm mala Amaziya a Yahuda</para>
  <para style="r">(<ref loc="2CH 25:1-24">2 Acau la Apwari 25:1-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 14:1" />A ɓaria pǝlǝa mala do-bunomurǝm mala Johash muna-ɓwabura mala Jehowahaz murǝm Isǝrayila ka, Amaziya muna-ɓwabura mala Johash duk murǝm a Yahuda. <verse eid="2KI 14:1" /><verse number="2" style="v" sid="2KI 14:2" />Ndanǝ apǝlǝa lumi-ɓari-bwamdǝ-tongno (25) lang tita do-bunomurǝm ngga, sǝ yálmúr aɓwana a Urǝshalima apǝlǝa lumi-ɓari-bwamdǝ-tongno-nong-ine (29). Lullǝ ngge nda Jehowadin, ɓwama Urǝshalima. <verse eid="2KI 14:2" /><verse number="3" style="v" sid="2KI 14:3" />Amaziya pàkki agir pas mǝnana à pwasǝbum Yahweh ka, kat andǝ amani ka, pà kǝla mala kè Murǝm Dauda ɗàng. Aɓa koman kat ka, kpata kusǝ tárrí Johash. <verse eid="2KI 14:3" /><verse number="4" style="v" sid="2KI 14:4" />Sǝama amgbangban-peri atà ankúl ka kiɗikia ɗàng; amǝ Isǝrayila lidǝmba nǝ ká pà gìr'nkila andǝ aɓoro amur amgbangban-peri atà ankúl mǝno.<verse eid="2KI 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 14:5" />Lang Amaziya kumǝna kusǝu-came kàngkàng kǝla murǝm ngga, wal-lú ka amǝ'tamurǝm mǝnana à wal-lú tárrí ka. <verse eid="2KI 14:5" /><verse number="6" style="v" sid="2KI 14:6" />Sǝama wal-lú ka amuna-burana mala aɓwana mana à wal-lú tárrí ka ɗàng. Kpata nzongcau mala Yahweh, kǝla mǝnana à gilǝì aɓa Malǝmce Nzongcau mala Musa, mana aɓalǝi ka Yahweh tsǝk nzongcau ama, &lt;&lt;Atárru ka, à pà nǝ̀ wal-luia atàcau mala amuna malea ɗàng, sǝ amuna gbal ka, à pà nǝ̀ wal-luia atàcau mala atárrià ɗang; koyan ngga, nǝ̀ wǔ atàcau mala cauɓikea male.&gt;&gt;<verse eid="2KI 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 14:7" />Amaziya wal-lú ka amǝ'lwa mala amǝ Edom á-lum (10,000), a Ɓangŋaban Tuɓamur. Limurǝm amur là Sela a munǝo, sǝ nggaɗi lullǝ lê, à tunǝi ama, Jokteel, lullǝu mǝnana nda kam ba yalung ngga. <verse eid="2KI 14:7" /><verse number="8" style="v" sid="2KI 14:8" />Pǝlǝa Amaziya tasǝ amǝ'na-túrbân aban Jehohash, muna-ɓwabura mala Jehowahaz, muna-ɓwabura mala Jehu, murǝm Isǝrayila, nǝ cau ama, &lt;&lt;Yiu, ɓǝ̀ sǝm je ɓamǝsǝu andǝ ɓamǝsǝu.&gt;&gt;<verse eid="2KI 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 14:9" />Sǝ Jehohash, murǝm Isǝrayila, nyesǝî Amaziya cau ama, &lt;&lt;Zwe mǝnana a Lebano ka, tasǝ cau aban nggun-seda a Lebano ama, &lt;Pà ɓoarnsarileo aban muna-ɓwabura mem ɓǝ̀ duk māmí.&gt; Sǝ ɓè nyam-bondo mala Lebano, puro nǝ̀ ya kútí ka, parki zwenì a nzali! <verse eid="2KI 14:9" /><verse number="10" style="v" sid="2KI 14:10" />Mǝsǝcau na ama a gandǝna Edom, sǝ gìrnî no po jali ka. Sǝama do a là, pàk-banɓoarnado mala limurǝm mò. Palang ado, sǝ awu nǝ altacau, mǝnana nǝ̀ yinǝ kpa mô, andǝ kpa mala Yahuda atò ka?&gt;&gt;<verse eid="2KI 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 14:11" />Sǝ Amaziya ka, falǝnǝ nunkiru mǝno ɗang, nda Jehohash, murǝm Isǝrayila pur atè. Sǝ yì andǝ Amaziya murǝm Yahuda, à yi je-munǝo ɓamǝsǝu andǝ ɓamǝsǝu, a Bet-Shemesh, aɓa Yahuda. <verse eid="2KI 14:11" /><verse number="12" style="v" sid="2KI 14:12" />Amǝ'lwa mala Isǝrayila gandǝ amǝ'lwa mala Yahuda, sǝ koya mǝ'lwa mala Yahuda ka ɓangŋa o a gumli male. <verse eid="2KI 14:12" /><verse number="13" style="v" sid="2KI 14:13" />Jehohash murǝm Isǝrayila gbami Amaziya murǝm Yahuda, muna-ɓwabura mala Jehohash, mǝkà Ahaziya, a Bet-Shemesh. Sǝ yì andǝ amǝ'lwa male wari a Urǝshalima, à arki sheran mala Urǝshalima bik ɓakusǝu gbǝman-tongno-nong-mwashat (600), tite a Kún-la Ifǝrem, kya bwal ban Kún-la Bankara. <verse eid="2KI 14:13" /><verse number="14" style="v" sid="2KI 14:14" />Pwan bolo-njengǝlan andǝ bolo-azǝrfa kat, andǝ atanggǝla mǝnana kat à kumia a ɓala mala Yahweh, sǝ aɓalǝ andà-tsǝk agir-ɓoarna mala ɓala-murǝm ngga, sǝ pwan aɓwana aɓa nggúr, umnǝia kat a Samariya.<verse eid="2KI 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 14:15" />Acili agir mǝnana à kumban aɓa do-bunomurǝm mala Jehohash, andǝ atúró mǝnana kat pàkkia, andǝ agir-zǝ́kíban male, andǝ amunǝki-amunǝo male andǝ Amaziya, murǝm Yahuda ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="2KI 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 14:16" />Jehohash usǝlǝ atà akê, sǝ à tsǝkluí a Samariya, atà amurǝma mala Isǝrayila. Sǝ muna-ɓwabura male, Jerobuam, duk murǝm a bancame male. <verse eid="2KI 14:16" /><verse number="17" style="v" sid="2KI 14:17" />Murǝm Amaziya muna-ɓwabura mala Johash, mala Yahuda, dum nǝyilǝmu apǝlǝa lum-bwamdǝ-tongno (15), anzǝm lú mala Jehohash muna-ɓwabura mala Jehowahaz, murǝm Isǝrayila. <verse eid="2KI 14:17" /><verse number="18" style="v" sid="2KI 14:18" />Acili agir mǝnana à kumban aɓa do-bunomurǝm mala Amaziya ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char><verse eid="2KI 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 14:19" />Aɓwana kùrkunarǝia amur Amaziya a Urǝshalima, nda ɓangŋa o a Lakish. Sǝama à tasǝ amǝ'wal-lú atè a Lakish, à kya wal-luí abanì. <verse eid="2KI 14:19" /><verse number="20" style="v" sid="2KI 14:20" />À twal luí a nzǝm apǝr sǝ à yi tsǝî a ɓembe a Urǝshalima atà akê a nggea-là mala Dauda.<verse eid="2KI 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 14:21" />Pǝlǝa amǝ Yahuda kat twal Azariya,<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="fq" closed="false">Azariya </char><char style="ft" closed="false">mǝnana à tunǝi gbal ama &lt;&lt;Uzziya&gt;&gt; ka. </char></note> mǝnana a bàkú mǝno ka ndanǝ apǝlǝa lum-bwamdǝ-tongno-nong-mwashat (16) ka, sǝ à tsǝì duk murǝm, a bancame mala tárrí, Amaziya. <verse eid="2KI 14:21" /><verse number="22" style="v" sid="2KI 14:22" />Azariya yi ɓǝsǝlǝ ɓak là Ela, sǝ nyesǝi aɓata domurǝm mala Yahuda anzǝm mǝnana murǝm [tárrí Amaziya] wuna à tsǝ̀ngŋǝ̀nì atà akê ka.<verse eid="2KI 14:22" /></para>
  <para style="s">Murǝm Jerobuam II yálmúr Isǝrayila</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 14:23" />A lum-bwamdǝ-tongnoia pǝlǝa mala do-bunomurǝm mala Amaziya, muna-ɓwabura mala Johash murǝm Yahuda ka, Jerobuam, muna-ɓwabura mala Johash, duk murǝm mala Isǝrayila, sǝ yálmúr aɓwana a Samariya apǝlǝa lumi-ine-nong-mwashat (41). <verse eid="2KI 14:23" /><verse number="24" style="v" sid="2KI 14:24" />Pàkki agir mǝnana amǝɓike na a mǝsǝ Yahweh ka. Tamsǝ pakkia ulang acauɓikea mala Jerobuam, muna-ɓwabura mala Nebat mǝnana kat tsǝk amǝ Isǝrayila à pàkkia ka ɗàng. <verse eid="2KI 14:24" /><verse number="25" style="v" sid="2KI 14:25" />Sǝ yì nda ɓwa mǝnana nyesǝ anzong-nzali mala Isǝrayila, twal a Lebo-Hamat a njar-nza, aban ká a kún nggeamùr mala Araba, a njar-kúnmur, kǝla mǝnana cau mala Yahweh, Ɓakuli mala Isǝrayila bangŋi nǝ kún guro male Yunana, muna-ɓwabura mala Amittai, mǝɓangnǝa, mǝnana pur a Gat Hefa ka.<verse eid="2KI 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 14:26" />Yahweh ka, sǝnǝna tanni mǝkǝ̀rkǝ́rnì mǝnana koyan a Isǝrayila kǝ nu ka, ko guro, ko ɓwa mana aguro na raka; kǝɓwa pà kàm mǝnana nǝ̀ bwalì Isǝrayila ka ɗàng. <verse eid="2KI 14:26" /><verse number="27" style="v" sid="2KI 14:27" />Sǝ acemǝnana Yahweh bangma ama, nǝ̀ esǝki lullǝ Isǝrayila a ɓanza raka, amsǝia nǝ bu Jerobuam, muna-ɓwabura mala Johash [murǝm Isǝrayila].<verse eid="2KI 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 14:28" />Adyan ngga acili agir mǝnana à kumban a do-bunomurǝm mala Jerobuam, atúró mǝnana kat pàkkia, andǝ rǝcandǝa male, andǝ alimurǝm male a lwa, kpapi andǝ nyesǝe mǝnana nyesǝ anggea-là Damaska andǝ Hamat, mǝnana ɗiɗyal amala nzali Yahuda na ka, aɓata Isǝrayila ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 14:28" /><verse number="29" style="v" sid="2KI 14:29" />Jerobuam yi paklú atà akê, amurǝma mala Isǝrayila. Muna-ɓwabura male, Zakariya, duk murǝm a bancame male.<verse eid="2KI 14:29" /></para>
  <chapter eid="2KI 14" />
  <chapter number="15" style="c" sid="2KI 15" />
  <para style="s">Azariya duk murǝm Yahuda</para>
  <para style="r">(<ref loc="2CH 26:1-23">2 Acau la Apwari 26:1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 15:1" />A lumi-ɓari-bwamdǝ-tongno-nong-ɓaria (27) pǝlǝa mala do-bunomurǝm mala Jerobuam murǝm Isǝrayila ka, Azariya,<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">Azariya </char><char style="ft" closed="false">mǝnana à tunǝi gbal ama Uzziya ka </char></note> muna-ɓwabura mala Amaziya, duk murǝm mala Yahuda. <verse eid="2KI 15:1" /><verse number="2" style="v" sid="2KI 15:2" />Ndanǝ apǝlǝa lum-bwamdǝ-tongno-nong-mwashat (16) sǝ duk murǝm. Yálmúr aɓwana a Urǝshalima apǝlǝa lumi-tongno-nong-ɓari (52). Lullǝ ngge nda Jekoliya ɓwama Urǝshalima. <verse eid="2KI 15:2" /><verse number="3" style="v" sid="2KI 15:3" />Azariya pàkki agir mǝnana à pwasǝbum Yahweh ka, kǝla mǝnana tárrí Amaziya pàk ka. <verse eid="2KI 15:3" /><verse number="4" style="v" sid="2KI 15:4" />Kat andǝ amani ka, kiɗiki amgbangban-peri atà ankúl ɗàng. Amǝ Isǝrayila lidǝmba nǝ pà gìr'nkila andǝ aɓoro amur amgbangban-peri atà ankúl mǝno.<verse eid="2KI 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 15:5" />Sǝ Yahweh kwak murǝm Azariya nǝ kwánó nggû, sǝ duk mǝkwánó nggû ba pwari lú male.<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2CH 26:16-21">2Acau 26:16-21</ref></char>.</note> Dum nǝmurǝì a ɓè ɓala zak. Jotam, muna-ɓwabura male, nda mana bwal ɓala-murǝm sǝ yálmúr aɓwana a nzalinì ka.<verse eid="2KI 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2KI 15:6" />Acili agir mǝnana à kumban a do-bunomurǝm mala Azariya, kpapi andǝ atúró mǝnana pàkkia kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 15:6" /><verse number="7" style="v" sid="2KI 15:7" />Azariya paklú sǝ à tsǝì atà akê a nggea-là mala Dauda. Muna-ɓwabura male Jotam duk murǝm a bancame male.<verse eid="2KI 15:7" /></para>
  <para style="s">Do-bunomurǝm mala Zakariya amur Isǝrayila</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 15:8" />A lumi-tàrú-bwamdǝ-tongno-nong-tàruià (38) pǝlǝa mala do-bunomurǝm mala Azariya murǝm Yahuda ka, Zakariya, muna-ɓwabura mala Jerobuam, duk murǝm mala Isǝrayila, sǝ yálmúr aɓwana a Samariya azongŋo tongno-nong-mwashat (6). <verse eid="2KI 15:8" /><verse number="9" style="v" sid="2KI 15:9" />Pàkki agir pas mǝnana à pwasǝbum Yahweh raka, kǝla mǝnana akê pàk ka. Tamsǝ pakki acauɓikea mǝnana Jerobuam, muna-ɓwabura mala Nebat tsǝk Isǝrayila pàkkia ka ɗàng.<verse eid="2KI 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 15:10" />Pǝlǝa Shallum, muna-ɓwabura mala Jabesh kùrkún amur Zakariya. Wali me a nzali a ɓaɓwa,<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="fq" closed="false">a ɓaɓwa </char><char style="ft" closed="false">ko a Ibǝleyam </char></note> wal-luí sǝ ak bunomurǝm, duk murǝm a bancame male. <verse eid="2KI 15:10" /><verse number="11" style="v" sid="2KI 15:11" />Acili agir mǝnana à kumban a do-bunomurǝm mala Zakariya ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 15:11" /><verse number="12" style="v" sid="2KI 15:12" />Lú male yinǝ lùmsǝo mala cau mala Yahweh aban Jehu, mǝnana ama: &lt;&lt;Amunio andǝ amǝkeo nǝ̀ do amur buno-murǝm mala Isǝrayila ba inea nza.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 10:30">2Amur 10:30</ref></char>.</note> Anggo sǝ yi kumban.<verse eid="2KI 15:12" /></para>
  <para style="s">Shallum murǝm Isǝrayila</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 15:13" />Pǝlǝa Shallum, muna-ɓwabura mala Jabesh tita do-bunomurǝm amur Isǝrayila, a lumi-tàrú-bwamdǝ-tongno-nong-inea (39) pǝlǝa mala yálmúrû mala Murǝm Azariya amur Yahuda. Do-bunomurǝm mala Shallum a Samariya ka, zongŋo mwashat na ɓǝ̀rɓǝ̀r. <verse eid="2KI 15:13" /><verse number="14" style="v" sid="2KI 15:14" />Sǝ Menahem, muna-ɓwabura mala Gadi, pur a Tǝrza, yiu a Samariya. Yi wal-lú Shallum, muna-ɓwabura mala Jabesh, sǝ ak bancame male kǝla murǝm a Samariya.<verse eid="2KI 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 15:15" />Acili agir mǝnana à kumban a do-bunomurǝm mala Shallum, andǝ kùrkún mǝnana pè ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="2KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 15:16" />A bàkú mǝno Menahem pur a Tǝrza sǝ amur njar aban yiu ka, yi kiɗiki nggea-là Tifsa andǝ aɓwana mǝnana à ndanǝdo a nggea-lê, andǝ amuna-là mǝnana à kàrì banì ka, acemǝnana à ɓinǝ ɓun aɓate. Yale zanzǝki bum amamǝna mǝnana à ndanǝ amuna a bumia ka.<verse eid="2KI 15:16" /></para>
  <para style="s">Yálmúrû mala Menahem a Isǝrayila</para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 15:17" />Menahem muna-ɓwabura mala Gadi, tita do-bunomurǝm male amur Isǝrayila, a lumi-tàrú-bwamdǝ-tongno-nong-inea (39) pǝlǝa mala do-bunomurǝm mala Azariya a Yahuda. Menahem yálmúr aɓwana a Samariya apǝlǝa lum. <verse eid="2KI 15:17" /><verse number="18" style="v" sid="2KI 15:18" />Pàkki agir mǝnana amǝɓike na a mǝsǝ Yahweh ka. Aɓa do male kat ka ɓinǝ pǝlǝ nzǝmi arǝ pakki acauɓikea mǝnana Jerobuam, muna-ɓwabura mala Nebat pàkkia, sǝ tsǝk amǝ Isǝrayila à pàkkia ka.<verse eid="2KI 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 15:19" />Pǝlǝa Pul,<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="fq" closed="false">Pul </char><char style="ft" closed="false">ka ɓè lullǝ Tigǝlat-Pilesa III na.</char></note> murǝm mala nzali Assuriya, yi kútí nǝ rǝcandǝa mala lwa aɓa nzali Isǝrayila. Sǝ Menahem pè Pul bolo-azǝrfa tyang á-lumi-tàrú-nong-ine (34,000) ace mǝnana ɓǝ̀ Pul pè wi gbasha mala lidǝmba a domurǝm male, andǝ kum rǝcandǝa kàm mala bwalmúr nzali male kàngkàng ngga. <verse eid="2KI 15:19" /><verse number="20" style="v" sid="2KI 15:20" />Menahem kum bolo-azǝrfa mǝnia ka nǝ cemi amǝkume mǝnana kat aɓa Isǝrayila ka; ak mǝsǝ bolo-azǝrfa lumi-tongno-tongno (50) a bù koyan atea, sǝ pè murǝm Assuriya. Nda sǝ murǝm Assuriya ɗeki cau mala munǝo, nyingŋǝna nzali Isǝrayila ka.<verse eid="2KI 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 15:21" />Acili agir mǝnana à kumban a do-bunomurǝm mala Menahem andǝ atúró mǝnana pàkkia kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="2KI 15:21" /><verse number="22" style="v" sid="2KI 15:22" />Menahem paklú atà akê, sǝ muna-ɓwabura male, Pekahiya duk murǝm a bancame male.<verse eid="2KI 15:22" /></para>
  <para style="s">Pekahiya duk murǝm mala Isǝrayila</para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 15:23" />Nda a lumi-tongnoia (50) pǝlǝa mala do-bunomurǝm mala Azariya a Yahuda sǝ Pekahiya muna-ɓwabura mala Menahem duk murǝm amur Isǝrayila. Pekahiya yálmúr aɓwana a Samariya apǝlǝa ɓari. <verse eid="2KI 15:23" /><verse number="24" style="v" sid="2KI 15:24" />Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka. Ɓinǝ pǝlǝ nzǝmi arǝ pakkia ulang acauɓikea mǝnana Jerobuam, muna-ɓwabura mala Nebat pàkkia, sǝ tsǝk Isǝrayila pàkkia ka. <verse eid="2KI 15:24" /><verse number="25" style="v" sid="2KI 15:25" />Sǝ Peka muna-ɓwabura mala Remaliya ɓwamǝgule-lwa male, kùrkún amurí, yì Pekahiya. Sǝ nǝ pagbasha mala aɓea aburana lumi-tongno mana à pur a Gilǝyat, andǝ Argop, andǝ Ariye ka, à yinǝ munǝo arǝì a ban-mǝcandǝe mala ɓala-murǝm, mana a Samariya ka, sǝ à wal-lú Pekahiya. Peka pǝlǝa ak bancame male kǝla murǝm.<verse eid="2KI 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 15:26" />Acili agir mǝnana à kumban aɓa do-bunomurǝm mala Pekahiya, andǝ atúró mǝnana pàkkia kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="2KI 15:26" /></para>
  <para style="s">Peka yálmúr Isǝrayila</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 15:27" />Nda a lumi-tongno-nong-ɓaria (52) pǝlǝa mala do-bunomurǝm mala Azariya a Yahuda sǝ Peka, muna-ɓwabura mala Remaliya, tita yálmúrû a Isǝrayila. Yálmúr aɓwana a Samariya apǝlǝa lumi-ɓari. <verse eid="2KI 15:27" /><verse number="28" style="v" sid="2KI 15:28" />Peka pàkki agir mǝnana amǝɓike na a mǝsǝ Yahweh ka. Ɓinǝ pǝlǝ nzǝmi arǝ pakki acauɓikea mǝnana Jerobuam, muna-ɓwabura mala Nebat pàkkia sǝ tsǝk Isǝrayila pàkkia ka.<verse eid="2KI 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 15:29" />Sǝ a bàkú mana Peka, nda murǝm mala Isǝrayila ka, Murǝm Tigǝlat-Pilesa, mala Assuriya, yiu nǝ munǝo arǝ Isǝrayila. Yi ak abu-nzali Ijon, andǝ Abel-Bet-Ma'aka, andǝ Janoha, andǝ Kedesh, andǝ Hazo, andǝ Gilǝyat, andǝ Galili, andǝ bu-nzali Naftali kat. Pwan aɓwana mǝnana aɓalǝ abu-nzali man ngga umnǝia a Assuriya. <verse eid="2KI 15:29" /><verse number="30" style="v" sid="2KI 15:30" />Pǝlǝa Hosheya, muna-ɓwabura mala Ela, kùrkún amur Peka, muna-ɓwabura mala Remaliya. Yiu arǝì nǝ munǝo, wal-luí, sǝ duk murǝm a Isǝrayila, a lumi-ɓaria pǝlǝa mala yálmúrû mala Jotam, muna-ɓwabura mala Uzziya a Yahuda.<verse eid="2KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 15:31" />Acili agir mǝnana à kumban aɓa do-bunomurǝm mala Peka, andǝ atúró mǝnana pàkkia kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="2KI 15:31" /></para>
  <para style="s">Jotam yálmúr Yahuda</para>
  <para style="r">(<ref loc="2CH 27:1-9">2 Acau la Apwari 27:1-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 15:32" />A ɓaria pǝlǝa mala yálmúrû mala Peka, muna-ɓwabura mala Remaliya murǝm Isǝrayila ka, Jotam, muna-ɓwabura mala Azariya duk murǝm a Yahuda. <verse eid="2KI 15:32" /><verse number="33" style="v" sid="2KI 15:33" />Ndanǝ apǝlǝa lumi-ɓari-bwamdǝ-tongno (25), sǝ duk murǝm, sǝ yálmúr aɓwana a Urǝshalima apǝlǝa lum-bwamdǝ-tongno-nong-mwashat. Lullǝ ngge nda Jerusha, ɓoarnsarile Zadok. <verse eid="2KI 15:33" /><verse number="34" style="v" sid="2KI 15:34" />Yì ka, pàkki agir mǝnana amǝɓoarne na a mǝsǝ Yahweh ka, kǝla mǝnana tárrí Uzziya pàk ka. <verse eid="2KI 15:34" /><verse number="35" style="v" sid="2KI 15:35" />Kat andǝ amani ka, amgbangban-peri atà ankúl ka, à kiɗikia ɗàng. Amǝ Isǝrayila lidǝmba nǝ pà gìr'nkila andǝ aɓoro amur amgbangban-peri atà ankúl mǝno.<verse eid="2KI 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 15:36" />Acili agir mǝnana à kumban, a do-bunomurǝm mala Jotam, andǝ atúró mǝnana kat pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 15:36" /><verse number="37" style="v" sid="2KI 15:37" />(Aɓalǝ anonggio mǝno ka, Yahweh tita tasǝ Rezon murǝm mala Aram,<note caller="+" style="f"><char style="fr" closed="false">15:37 </char><char style="fq" closed="false">Aram </char><char style="ft" closed="false">ko Suriya.</char></note> andǝ Murǝm Peka, muna-ɓwabura mala Remaliya, ɓǝà yinǝ munǝo arǝ Yahuda.) <verse eid="2KI 15:37" /><verse number="38" style="v" sid="2KI 15:38" />Jotam yi wú sǝ à tsǝì atà akê, a nggea-là mala kè Dauda. Muna-ɓwabura male, Ahaz, duk murǝm a bancame male.<verse eid="2KI 15:38" /></para>
  <chapter eid="2KI 15" />
  <chapter number="16" style="c" sid="2KI 16" />
  <para style="s">Do-bunomurǝm mala Ahaz a Yahuda</para>
  <para style="r">(<ref loc="2CH 28:1-27">2 Acau la Apwari 28:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 16:1" />A tongno-nong-ɓaria pǝlǝa mala do-bunomurǝm mala Peka muna-ɓwabura mala Remaliya ka, Ahaz muna-ɓwabura mala Jotam duk murǝm amur Yahuda. <verse eid="2KI 16:1" /><verse number="2" style="v" sid="2KI 16:2" />Apǝlǝa ɓǝlban mala Ahaz ka à nda lumi-ɓari lang tita yálmúrû ka, sǝ yálmúr aɓwana a Urǝshalima arǝ apǝlǝa lum-bwamdǝ-tongno-nong-mwashat. Pàk gìr mǝnana mǝɓoarne na a mǝsǝ Yahweh Ɓakuli male, kǝla mǝnana kè Dauda pàk ka ɗàng. <verse eid="2KI 16:2" /><verse number="3" style="v" sid="2KI 16:3" />Yì ka kpata kusǝ pakkia agir mala amurǝma mala Isǝrayila. Yale pisǝ muna-ɓwabura male a bǝsa kǝla paɓoro aban ankúl; pè aɓa kpata pakkiagir mala aɓwapǝndǝa mala anzali mǝnana Yahweh pǝria à purî ɓadǝm amǝ Isǝrayila ka. <verse eid="2KI 16:3" /><verse number="4" style="v" sid="2KI 16:4" />Sǝ pà gìr'nkila andǝ aɓoro amur amgbangban-peri atà ankúl, andǝ múr ankono, sǝ à tǝr koya nggun mǝpwale.<verse eid="2KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 16:5" />A bàkú mǝno ka, Rezin murǝm mala Suriya andǝ Peka muna-ɓwabura mala Remaliya, murǝm mala amǝ Isǝrayila, à yiu ace lwa-lwa arǝ Urǝshalima, sǝ à gumbǝli Ahaz, sǝama à gandǝ limurǝm amurí ɗàng. <verse eid="2KI 16:5" /><verse number="6" style="v" sid="2KI 16:6" />(A bákuì mǝno ka, Rezin murǝm mala Suriya<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="fq" closed="false">Suriya </char><char style="ft" closed="false">ko Edom </char></note> ak nggea-là Elat, nyesǝi aɓata nzali Suriya sǝ pǝr aburana mala nzali Yahuda ɓǝà purî ɓá Elat. Sǝ amǝ'Suriya<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="fq" closed="false">amǝ'Suriya </char><char style="ft" closed="false">ko amǝ'Edom </char></note> yiu a Elat, ban mǝnana à yi duk kam ba yalung ngga.) <verse eid="2KI 16:6" /><verse number="7" style="v" sid="2KI 16:7" />Nda Ahaz tasǝ amǝ'na-túrbân aban Tigǝlat-Pilesa murǝm mala Assuriya ama, &lt;&lt;Mǝ nda guro mò, sǝ mǝ nda munio. Yiu amsǝam a ɓabu murǝm Suriya, sǝ a ɓabu murǝm Isǝrayila, mǝnana à kǝ yinǝ munǝo arǝàm ngga.&gt;&gt; <verse eid="2KI 16:7" /><verse number="8" style="v" sid="2KI 16:8" />Ahaz gbal ka twal bolo-azǝrfa andǝ bolo-njengǝlan mǝnana à kumi a ɓala mala Yahweh, sǝ aɓalǝ andà-tsǝk agir-ɓoarna mala ɓala-murǝm ngga. Tasǝna ɓoro nǝi aban murǝm Assuriya. <verse eid="2KI 16:8" /><verse number="9" style="v" sid="2KI 16:9" />Nda murǝm Assuriya pàk gìr mǝnana Ahaz zǝmbì ace ka. Yì andǝ amǝ'lwa male lo sǝ à umnǝ lwa arǝ Damaska, sǝ à kya e, sǝ à pwan aɓwana mana à ndanǝdo a Damaska ka aɓa-nggur, à umnǝia a bǝri-nzali a Kir.<note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="fq" closed="false">Kir </char><char style="ft" closed="false">nggea-là mala Assuriya </char></note> Pǝlǝa à wal-lú Murǝm Rezin.<verse eid="2KI 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 16:10" />Lang Murǝm Ahaz wari a Damaska nǝ̀ nggá sǝn Tigǝlat-Pilesa murǝm mala Assuriya ka, kya sǝn gyangŋan-peri mǝnana à ɓè a Damaska ka. Sǝ Murǝm Ahaz terǝî Yuriya pǝris nyoulǝa-pa mala gyangŋanì andǝ kutan mala ɓak ulangni gǝ̀rgǝ̀r. <verse eid="2KI 16:10" /><verse number="11" style="v" sid="2KI 16:11" />Pǝlǝa Yuriya pǝris ɓak gyangŋan mǝno; kpate kǝla mǝnana kat Murǝm Ahaz túrban nǝi a Damaska sǝ à yinǝi ka. Yuriya pǝris mal ɓě sǝɓǝ̀ Murǝm Ahaz nyarî Damaska. <verse eid="2KI 16:11" /><verse number="12" style="v" sid="2KI 16:12" />Lang murǝm nyarî Damaska sǝ sǝn gyangŋanì ka, sung tù abaní sǝ pà ɓoro mala gìr'nkila amurí. <verse eid="2KI 16:12" /><verse number="13" style="v" sid="2KI 16:13" />Pa ɓoro male mala pisǝe kǝring, andǝ ɓoro male mala mǝsǝsa. Solǝ ɓoro male mala girnùná, sǝ watsǝki nkila mala pagir male mala do-rǝpwala amur gyangŋanì. <verse eid="2KI 16:13" /><verse number="14" style="v" sid="2KI 16:14" />Sǝ gyangŋan bolo-bángŋá mǝnana cam aɓadǝm Yahweh ka, Murǝm Ahaz pusǝì a bancame male a ɓadǝm ɓala mala Yahweh, a nre gyangŋan male andǝ ɓala mala Yahweh, sǝ kya tsǝì a bù njar-nza mala gyangŋan male. <verse eid="2KI 16:14" /><verse number="15" style="v" sid="2KI 16:15" />Murǝm Ahaz pe Yuriya pǝris nzongcau ama, &lt;&lt;Amur gyangŋan mǝgule<note caller="+" style="f"><char style="fr" closed="false">16:15 </char><char style="fq" closed="false">gyangŋan mǝgule </char><char style="ft" closed="false">yì bǝsa gyangŋan mǝnana murǝm loa ɓě ka </char></note> ka, awu nǝ pisǝ gir'nkila mala pisǝe kǝring mala dǝmbari, andǝ pagir mala mǝsǝsa mala pwarikpǝra, andǝ pagir mala pisǝe kǝring mala murǝm, andǝ pagir male mala mǝsǝsa, atārǝia andǝ pa girnkila mala pisǝe kǝring mala aɓwana mana à nda aɓa nzali kat ka, andǝ apagir malea mala mǝsǝsa, sǝ apagir malea mala girnùná. Sǝ awu nǝ watsǝki nkila kat mala apagir mala pisǝe kǝring, andǝ nkila kat mala agir'nkila amurí; sǝ gyangŋan bolo-bángŋá ka nda acem mǝ ɗibancau kàm.&gt;&gt; <verse eid="2KI 16:15" /><verse number="16" style="v" sid="2KI 16:16" />Yuriya pǝris pàk mǝnia ka kat, kǝla mǝnana murǝm Ahaz tsǝki wi nzongcau ka.<verse eid="2KI 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 16:17" />Murǝm Ahaz kasǝki anggun awaru-ramggite, sǝ pusǝki ankenye mǝnana amuria ka. Pusǝ kaɓa-nkenye mǝnana a nzǝm ajamnda bolo-bángŋá ka, sǝ sulǝì tamsǝì amur akpamgbǝlang tali. <verse eid="2KI 16:17" /><verse number="18" style="v" sid="2KI 16:18" />Ɗǝm ngga tara mǝnana à tsǝì a ɓala mala Yahweh, mǝnana aɓwe kǝ gya aɓate ace kùtí a ɓala mala Yahweh a pwari Sabbat ka, Ahaz pusǝì, sǝ gìr kunkurǝm nza mǝnana murǝm kǝ kútí kam a ɓala mala Yahweh ka. Pàk mǝnia ka ace pwasǝbum murǝm Assuriya.<verse eid="2KI 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 16:19" />Adyan ngga, acili agir mǝnana à kumban a do-bunomurǝm mala Ahaz, andǝ atúró mǝnana pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 16:19" /><verse number="20" style="v" sid="2KI 16:20" />Ahaz paklú atà akê, sǝ à tsǝì atea a nggea-là mala Dauda. Muna-ɓwabura male Hezekiya duk murǝm a bancame male.<verse eid="2KI 16:20" /></para>
  <chapter eid="2KI 16" />
  <chapter number="17" style="c" sid="2KI 17" />
  <para style="s">Hosheya duk murǝm a Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 17:1" />A lum-nong-ɓaria pǝlǝa mala do-bunomurǝm mala Ahaz murǝm Yahuda ka, Hosheya muna-ɓwabura mala Ela tita yálmúrû amur Isǝrayila. Yálmúr aɓwana a Samariya arǝ apǝlǝa tongno-nong-ine. <verse eid="2KI 17:1" /><verse number="2" style="v" sid="2KI 17:2" />Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, sǝama pà kǝla mala amurǝma mala Isǝrayila mǝnana à akidǝmba ka ɗàng. <verse eid="2KI 17:2" /><verse number="3" style="v" sid="2KI 17:3" />Shalmanesa murǝm mala Assuriya yinǝ munǝo arǝ Hosheya, sǝ Hosheya pà ɓamúrì aɓate, kǝ mbwe boalo-cemi a baní. <verse eid="2KI 17:3" /><verse number="4" style="v" sid="2KI 17:4" />Sǝ murǝm mala Assuriya yi sǝlǝa ama Hosheya na arǝ kanì nǝ̀ mgbicau. Hosheya angŋa-dǝmba tasǝna amǝ'na-túrbân aban So murǝm mala Masar, sǝ ɓinǝna mbwe boalo-cemi aban murǝm mala Assuriya, kǝla mǝnana pakkiyi ɗiɗyal koya pǝlǝa ka. Acemani ka, murǝm mala Assuriya gbami Hosheya sǝ túrrí a ndàkurban.<verse eid="2KI 17:4" /></para>
  <para style="s1">À pwan Isǝrayila à umnǝia a bǝri-nzali a Assuriya</para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 17:5" />Murǝm mala Assuriya andǝ amǝ'lwa male yi kútí aɓa nzali Isǝrayila kat nǝ rǝcandǝa mala lwa. Lang à yi bingŋǝna nggea-là Samariya ka, à gumbǝlì, à kasǝkun anjar kat, puro pà kàm ɗàng sǝ kutio pà kàm ɗàng, kya bik apǝlǝa tàrú. <verse eid="2KI 17:5" /><verse number="6" style="v" sid="2KI 17:6" />A tongno-nong-inea pǝlǝa mala do-bunomurǝm mala Hosheya ka, nggea-là Samariya kpa aɓa rǝcandǝa mala murǝm mala Assuriya. Bwalki amǝ Isǝrayila pusǝia aɓa nzali malea nǝ rǝcandǝa, umnǝia a nzali Assuriya. Wario kya dumsǝ aɓea aɓwana ateà a Hala, ɓè ban tù nǝ kún Nggeasala Habo, a bu-nzali Gozan, sǝ acilia ka dumsǝia aɓalǝ alá mala amǝ Medes.<verse eid="2KI 17:6" /></para>
  <para style="s">Gìr mǝnana tsǝa sǝ Isǝrayila kpa ka</para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 17:7" />Mǝnia yì gìr mur'mwana ka yiu amur amǝ Isǝrayila acemǝnana à pàkkî Yahweh Ɓakuli malea cauɓikea, yì Ɓakuli mǝnana pusǝia à purî ɓá nzali Masar, sǝ panzǝia aɓata rǝcandǝa mala Firona murǝm mala Masar ka. À peri aban aɓea aɓakuli; <verse eid="2KI 17:7" /><verse number="8" style="v" sid="2KI 17:8" />à bwal akúncau mala aɓwapǝndǝa mala anzali mǝnana Yahweh pǝria ɓǝà nyinggi wia ban ngga, sǝ à kpata akúncau mǝnana amurǝma mala Isǝrayila yinǝia ka. <verse eid="2KI 17:8" /><verse number="9" style="v" sid="2KI 17:9" />Sǝ amǝ Isǝrayila pàkkî Yahweh Ɓakuli malea agir mǝɓike aɓa sǝmbǝrǝa, agir mǝnana ɓoaro ɓǝà pea raka. À ɓakkî ɓamuria amgbangban-peri atà ankúl arǝ alá malea kat, twal arǝ amuna-là aban ká arǝ kanggǝrang nggea-là. <verse eid="2KI 17:9" /><verse number="10" style="v" sid="2KI 17:10" />À tamsǝî ɓamuria akúnamúrú andǝ atondong mala peri aban Ashera, amur koya mgbangban andǝ tǝrtà koya nggun mǝpwale. <verse eid="2KI 17:10" /><verse number="11" style="v" sid="2KI 17:11" />À pāki agir'nkila amur amgbangban-peri atà ankúl kat, kǝla mala aɓwapǝndǝa mala anzali mana Yahweh loasǝtea ɓǝà nyinggia wia ban ngga. À pakkiagir mǝɓike mǝnana lulbum Yahweh ka. <verse eid="2KI 17:11" /><verse number="12" style="v" sid="2KI 17:12" />À peri aban ankúl, kat andǝ mani ama Yahweh bangŋǝnia wia ama, &lt;&lt;Pà wu nǝ̀ pàk gìr mǝnia ka ɗàng.&gt;&gt; <verse eid="2KI 17:12" /><verse number="13" style="v" sid="2KI 17:13" />Yahweh nunakir Isǝrayila andǝ Yahuda tùtù nǝ kún koya mǝɓangnǝa andǝ koya mǝ'sǝna ama, &lt;&lt;Wu vwakibu wun arǝ anjar mala ɓealɓikea ma'wun, sǝ wu bwal anzongcau mem andǝ anê mem, yì nggurcau mǝnana ǝn tsǝki aká wun nzongcau nǝma ɓǝà kpate, sǝ ǝn tasǝa wuni nǝ bu aguro mem amǝ'ɓangnǝa ka.&gt;&gt;<verse eid="2KI 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 17:14" />Sǝama yia ka, à kwakikiria ɗàng, à dumnǝ ɓamurcandǝa kǝla ɓamurcandǝa mala akeâ, mana à earnǝ Yahweh Ɓakuli malea raka. <verse eid="2KI 17:14" /><verse number="15" style="v" sid="2KI 17:15" />À ginǝki anê andǝ kùrcau mǝnana pè andǝ akeâ ka, sǝ à ɓǝsǝki anunkiru mǝnana pea wia ka. À kpata ankul ɓana, sǝ acemani ka à pǝlǝ aɓwaɓana, à twalkusǝ aɓwapǝndǝa mala anzali mǝnana à gumbǝlia ka, kat andǝ amani ama Yahweh angŋa-dǝmba tsǝngŋǝnia wia nzongcau ama ɓǝà kǝa pàk kǝla yia raka. <verse eid="2KI 17:15" /><verse number="16" style="v" sid="2KI 17:16" />À vwakibuia arǝ anzongcau mala Yahweh Ɓakuli malea kat; à ɓakkî ɓamuria aɓǝ̀nzál-bolo mala amuna-ndá ɓari; à pàk tondong mala Ashera. À peri aban pwari andǝ zongŋo andǝ anlero, sǝ à kpata Ba'al. <verse eid="2KI 17:16" /><verse number="17" style="v" sid="2KI 17:17" />À pisǝ amuna-burana andǝ amuna-mamǝna malea a bǝsa kǝla apa'girnkila. À pàkkiagir nggár andǝ agir monzǝo sǝ à mak ɓamuria aban pakki agir mǝnana amǝɓike na a mǝsǝ Yahweh, sǝ à lulbumi ka. <verse eid="2KI 17:17" /><verse number="18" style="v" sid="2KI 17:18" />Acemani ka, bum Yahweh lul kǝ̀rkǝ́r arǝ Isǝrayila, sǝ pǝria à purî ɓadǝmbi. Kǝɓwa ue ɗang, shekǝ taù mala Yahuda.<verse eid="2KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 17:19" />Yahuda gbal ka bwal anzongcau mala Yahweh Ɓakuli malea ɗàng; à gya aɓalǝ akúncau mǝnana Isǝrayila yinǝia ka. <verse eid="2KI 17:19" /><verse number="20" style="v" sid="2KI 17:20" />Nda Yahweh ginǝki amǝkà Isǝrayila kat, túriá aɓa tanni sǝ tasǝia a ɓabu amǝ'tǝllìban, she lang pusǝnia à purni ɓadǝmbi ka.<verse eid="2KI 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 17:21" />Lang Yahweh sanǝna Isǝrayila arǝ ɓala mala Dauda ka, amǝ Isǝrayila tsǝk Jerobuam muna-ɓwabura mala Nebat duk murǝm. Sǝ Jerobuam nun Isǝrayila à ɗeki kpata Yahweh, sǝ tsǝia à pàk cauɓikea mǝgule. <verse eid="2KI 17:21" /><verse number="22" style="v" sid="2KI 17:22" />Amǝ Isǝrayila gya aɓalǝ acauɓikea mǝnana Jerobuam pàk ka kat. À nyingbuia arǝia ɗàng, <verse eid="2KI 17:22" /><verse number="23" style="v" sid="2KI 17:23" />she lang Yahweh pusǝnia à purnì ɓadǝmbi, kǝla mǝnana akdǝmba bangŋi nǝ kún aguro male amǝ'ɓangnǝa kat ka. Nda à pwan amǝ Isǝrayila à umnǝia a bǝri-nzali a Assuriya ba yalung ngga.<verse eid="2KI 17:23" /></para>
  <para style="s">Amǝ'kúnɗàngna do a nzali Isǝrayila</para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 17:24" />Murǝm mala Assuriya yinǝ aɓwana mǝnana à lo a Babila, a Kuta, a Avva, a Hamat andǝ Sefarvayim ngga, sǝ dumsǝia aɓalǝ anggea-là mala Samariya a kúnì amǝ Isǝrayila. Sǝ à akban aɓa Samariya kat, à do arǝ anggea-là malea. <verse eid="2KI 17:24" /><verse number="25" style="v" sid="2KI 17:25" />Lang à tita do kano ka, à ɓanggi Yahweh ɗàng. Acemani ka, Yahweh tasǝ a'im a ɓālǝia, a'im wal-lú aɓea aɓwana ateà. <verse eid="2KI 17:25" /><verse number="26" style="v" sid="2KI 17:26" />Pǝlǝa à banggi murǝm mala Assuriya ama, &lt;&lt;Aɓwapǝndǝa mala anzali mǝnana a yinǝia sǝ a dumsǝia aɓalǝ anggea-là mala Samariya ka, à súrǝ̀ nggurcau mala ɓakuli mala lě ɗàng. Ace mǝno ka, tasǝna a'im a ɓālǝia; a'im na kǝ wal-luia ka, acemǝnana à súrǝ̀ nggurcau mala ɓakuli mala lě ɗàng.&gt;&gt; <verse eid="2KI 17:26" /><verse number="27" style="v" sid="2KI 17:27" />Pǝlǝa murǝm mala Assuriya pà nzongcau ama, &lt;&lt;Wu twal mwashat atà apǝris mǝnana wu pwania kano ka; sǝ tasǝì ɓǝ̀ kyane, ɓǝ̀ kya duk kam sǝ ɓǝ̀ kania wia nggurcau mala ɓakuli mala lě.&gt;&gt; <verse eid="2KI 17:27" /><verse number="28" style="v" sid="2KI 17:28" />Pǝlǝa mwashat atà apǝris mǝnana à pwania a Samariya ka yiu sǝ kya do a Betel, sǝ kania wia lang sǝ à nǝ̀ ɓanggi Yahweh.<verse eid="2KI 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 17:29" />Sǝama komǝye atà aɓwapǝndǝa mǝno ka, à pàk aɓakuli malea sǝ à tsǝkia aɓalǝ andaka-ankúl mala amgbangban-peri mǝnana amǝ Samariya akdǝmba ɓakkia ka; koya aɓwapǝndǝa ka, à pàk mǝnia ka arǝ anggea-là malea mǝnana à duk kam ngga. <verse eid="2KI 17:29" /><verse number="30" style="v" sid="2KI 17:30" />Amǝ'Babila pàk Sukkot-Benot, amǝ'Kuta pàk Nergal, amǝ'Hamat pàk Ashima, <verse eid="2KI 17:30" /><verse number="31" style="v" sid="2KI 17:31" />sǝ amǝ'Avva pàk Nibaz andǝ Tartak; sǝ amǝ'Sefarvayim pisǝ amunia a bǝsa aban Adǝramelek andǝ Anamelek, aɓakuli mala Sefarvayim. <verse eid="2KI 17:31" /><verse number="32" style="v" sid="2KI 17:32" />À ɓanggi Yahweh, sǝama à twal aɓwana ɗàngɗáng aɓa ɓinalea ɓǝà duk apǝris mala andaka-ankúl amur amgbangban-peri, sǝ apǝris man pāki agir'nkila acea aɓalǝ andaka-ankúl mala agyangŋan-peri ka. <verse eid="2KI 17:32" /><verse number="33" style="v" sid="2KI 17:33" />Anggo sǝ à ɓanggi Yahweh, sǝama, à kpata aɓakuli malea gbal; à pè kǝla mǝnana à kǝ pe arǝ anzali mana à pwania kàm ngga.<verse eid="2KI 17:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2KI 17:34" />Anggo sǝ à lidǝmba nǝ pe kǝla pě mǝ'ɗiɗyali malea ba yalung. À peri aban Yahweh ɗàng, acemǝnana à kpata anê, ko akanìgìr, ko anggurcau, ko anzongcau, mana Yahweh pè amǝkà Yakupu mǝnana tunǝi ama Isǝrayila ka ɗàng. <verse eid="2KI 17:34" /><verse number="35" style="v" sid="2KI 17:35" />Lang Yahweh kùrcau nǝia ka, pea wia mǝnia yì nzongcau ka ama, &lt;&lt;Pà wun nǝ̀ ɓanggi aɓea aɓakuli, ko wun nǝ̀ ɓun a ɓadǝmbia, ko wun nǝ̀ kpata acau malea, ko wun nǝ̀ pà gir'nkila mala pisǝe kǝring abania ɗàng. <verse eid="2KI 17:35" /><verse number="36" style="v" sid="2KI 17:36" />Wun nǝ̀ ɓanggi Yahweh, mǝnana pusǝ wun wu purî ɓá nzali Masar nǝ kaɓa rǝcandǝa andǝ mazo mala nggwarbui ka. Abaní sǝ wun nǝ̀ ɓunno, sǝ abaní sǝ wun nǝ̀ pà gir'nkila mala pisǝe kǝring. <verse eid="2KI 17:36" /><verse number="37" style="v" sid="2KI 17:37" />Sǝ anê, andǝ akanìgìr, andǝ anggurcau, andǝ anzongcau, mǝnana gilǝa wunia ka, dumǝna púp wun nǝ̀ kpatea, wun nǝ̀ peǎ nǝ tsǝkiru arǝ apwari kat. Pà wun nǝ̀ ɓanggi aɓea aɓakuli ɗang. <verse eid="2KI 17:37" /><verse number="38" style="v" sid="2KI 17:38" />Pà wun nǝ̀ lorǝ kùrcau mǝnana ǝn kur sǝnǝa wun ngga ɗang. Pà wun nǝ̀ ɓanggi aɓea ɓakuli ɗang. <verse eid="2KI 17:38" /><verse number="39" style="v" sid="2KI 17:39" />A kún mani ka, wun nǝ̀ ɓanggi Yahweh Ɓakuli ma'wun, sǝ yì ka nǝ̀ amsǝ wun a ɓabu aɓiwun-amǝbura kat.&gt;&gt; <verse eid="2KI 17:39" /><verse number="40" style="v" sid="2KI 17:40" />Kat andǝ amani ka, à kwakikiria ɗàng, à kpata anjar mǝ'e malea.<verse eid="2KI 17:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="2KI 17:41" />Anggo sǝ aɓwapǝndǝa mala anzali man ɓanggi Yahweh, sǝ à kpata acau mala aɓǝ̀nzál malea mǝnana à shària ka gbal. Amuna malea pàk anggo, amǝ'keà pàk kǝ gìrnî gbal. À lidǝmba nǝ pe kǝla mǝnana akeâ pàk ka ba yalung.<verse eid="2KI 17:41" /></para>
  <chapter eid="2KI 17" />
  <chapter number="18" style="c" sid="2KI 18" />
  <para style="s">Hezekiya duk murǝm a Yahuda</para>
  <para style="r">(<ref loc="2CH 29:1">2 Acau la Apwari 29:1</ref>,<ref loc="2CH 29:2">2</ref>; <ref loc="2CH 31:1">31:1</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 18:1" />A tàruià pǝlǝa mala do-bunomurǝm mala Hosheya muna-ɓwabura mala Ela murǝm mala Isǝrayila ka, Hezekiya muna-ɓwabura mala Ahaz murǝm mala Yahuda tita yálmúrû. <verse eid="2KI 18:1" /><verse number="2" style="v" sid="2KI 18:2" />Ndanǝ apǝlǝa lumi-ɓari-bwamdǝ-tongno (25) lang duk murǝm ngga, sǝ do a bunomurǝm a Urǝshalima arǝ apǝlǝa lumi-ɓari-bwamdǝ-tongno-nong-ine (29). Lullǝ ngge nda Abi ɓoarnsarile Zakariya. <verse eid="2KI 18:2" /><verse number="3" style="v" sid="2KI 18:3" />Pàk gìr mǝnana pwasǝbum Yahweh ka, kǝla mǝnana kè Dauda pàk ka. <verse eid="2KI 18:3" /><verse number="4" style="v" sid="2KI 18:4" />Kiɗiki amgbangban-peri atà ankúl, arki akúnamúrú, sǝ kwarki atondong peri mala Ashera. Ɗǝm ngga n'yau bolo-bángŋá mǝnana Musa pè ka, ɓungi gucik-gucik, acemǝnana ba pwari mǝno ka amǝ Isǝrayila kǝ pāki aɓoro a baní; à tunǝi ama Nehushtan.<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="fq" closed="false">Nehushtan </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fq">n'yau </char> sǝ <char style="fq">bolo-bángŋá </char>.</note> <verse eid="2KI 18:4" /><verse number="5" style="v" sid="2KI 18:5" />Murǝm Hezekiya Guli arǝ Yahweh Ɓakuli mala Isǝrayila. Kǝɓwa pà kàm kǝla yì atà amurǝma kat mala Yahuda ɗàng, ko anzǝmi ko a dǝmbi. <verse eid="2KI 18:5" /><verse number="6" style="v" sid="2KI 18:6" />Bwal kàngkàng arǝ Yahweh, sǝ pǝlǝ nzǝmi arǝ kpate ɗàng. Bwal anzongcau mǝnana Yahweh pè Musa ka. <verse eid="2KI 18:6" /><verse number="7" style="v" sid="2KI 18:7" />Yahweh na atè koya pwari. Ɓǝ̀ aya ban sǝ pǝlǝ ka, kǝ hangǝli. Mgbicau arǝ murǝm Assuriya, ginǝ kpate. <verse eid="2KI 18:7" /><verse number="8" style="v" sid="2KI 18:8" />Lì amǝ'Filisti a lwa aban ká ɗār a Gaza andǝ abân aɓa nzong-nzali male, lo a muna-là<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="fq" closed="false">muna-là </char><char style="ft" closed="false">Ibǝru: ndà-kulí mala mǝ'sǝn múr nggea-là.</char></note> aban ká a nggea-là mǝnana à gumbǝlia nǝ sheran ngga.<verse eid="2KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 18:9" />A inea pǝlǝa mala do-bunomurǝm mala Hezekiya, mǝnana nda tongno-nong-ɓaria pǝlǝa mala yálmúrû mala Murǝm Hoshiya muna-ɓwabura mala Ela mala Isǝrayila ka, Shalmanesa murǝm mala Assuriya yiu nǝ lwa arǝ Isǝrayila a Samariya, sǝ gumbǝli nggea-lê. <verse eid="2KI 18:9" /><verse number="10" style="v" sid="2KI 18:10" />A masǝlǝata apǝlǝa tàrú ka, Shalmanesa ak nggea-là Samariya. Aɓa tongno-nong-mwashatia pǝlǝa mala do-bunomurǝm mala Hezekiya, a tongno-nong-inea pǝlǝa mala yálmúrû mala Hoshiya a Isǝrayila ka, Samariya kpa. <verse eid="2KI 18:10" /><verse number="11" style="v" sid="2KI 18:11" />Murǝm mala Assuriya pwan amǝ Isǝrayila umnǝia a nzali Assuriya. Kya dumsǝ aɓea aɓwana ateà a Hala, ɓè là tù nǝ kún Nggeasala Habo, a bu-nzali Gozan. Acilia ka dumsǝia aɓalǝ alá mala amǝ Medes. <verse eid="2KI 18:11" /><verse number="12" style="v" sid="2KI 18:12" />(Mǝnia yì gìr ka, kumban acemǝnana à oaki Yahweh Ɓakuli malea ɗang; à pàk kpakpak arǝ kùrcau male mǝnana pàk andǝia ka. Agir mǝnana kat Musa guro mala Yahweh banggia wia ka, à ginǝ okiru, sǝ à lùmsǝia ɗàng.)<verse eid="2KI 18:12" /></para>
  <para style="s">Murǝm mala Assuriya yinǝ munǝo arǝ Yahuda</para>
  <para style="r">(<ref loc="2CH 32:1-19">2 Acau la Apwari 32:1-19</ref>; <ref loc="ISA 36:1-22">Ishaya 36:1-22</ref>; <ref loc="JER 36:1-39:4">Irmya 36:1--39:4</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 18:13" />Aɓa lum-nong-inea pǝlǝa mala do-bunomurǝm mala Murǝm Hezekiya ka,<note caller="+" style="f"><char style="fr" closed="false">18:13 </char><char style="ft" closed="false">Lum-nong-inea pǝlǝa mala do-bunomurǝm mala Murǝm Hezekiya ka, nda a pǝlǝa 701 </char><char style="sc">B.C.</char></note> Murǝm Senakerip mala amǝ Assuriya wari nǝ munǝo arǝ akanggǝrang nggea-là mala amǝ Yahuda, sǝ ea. <verse eid="2KI 18:13" /><verse number="14" style="v" sid="2KI 18:14" />Murǝm Hezekiya túrban arǝ murǝm mala Assuriya a Lakish ama, &lt;&lt;Ən ɓwarkina; nyesǝ amǝ'lwa mô ɓǝà purî banam; mǝ nǝ mbweo cemi mǝnana kat a nam ama ɓǝn mbwe ka.&gt;&gt; Nda murǝm mala Assuriya tsǝk Murǝm Hezekiya mala Yahuda ɓǝ̀ mbwe tyang á-lum (10,000) mala bolo-azǝrfa andǝ tyang á-mwashat (1,000) mala bolo-njengǝlan ngga. <verse eid="2KI 18:14" /><verse number="15" style="v" sid="2KI 18:15" />Sǝ Hezekiya pe wi bolo-azǝrfa mǝnana kat nda kam a ɓala mala Yahweh andǝ mana aɓalǝ andà-tsǝk agir-ɓoarna mǝnana a palta ka. <verse eid="2KI 18:15" /><verse number="16" style="v" sid="2KI 18:16" />A bàkú mǝno ka, Hezekiya fasǝki bolo-njengǝlan mǝnana à gìrna múr alǝpi kunakurǝm mala ɓala mala Yahweh nǝi ka, andǝ bolo-njengǝlan mǝnana yì nǝ ɓamurì akdǝmba gìrna rǝ anggun-kúnakurǝm nǝi ka, sǝ pè murǝm mala Assuriya.<verse eid="2KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 18:17" />Pǝlǝa murǝm mala Assuriya túr murǝm-lwa male, andǝ ɓwamǝgule-palta male andǝ mǝ'ak-kúní aban Murǝm Hezekiya a Urǝshalima. À lo a Lakish, nǝ amǝ'lwa mǝlakke-pas ateà aban ká a Urǝshalima. À eauwe sǝ à yiu a Urǝshalima. Lang à bingŋǝna ka, à yi cam a ban dā'ngal mala guguri mǝnana a kwàrban ngga, amur njargula ká a patal mala mǝ'láki-anggubyau. <verse eid="2KI 18:17" /><verse number="18" style="v" sid="2KI 18:18" />À tunǝ murǝm, sǝ Eliyakim muna-ɓwabura mala Hilkiya, mǝnana nda ɓwamǝgule-palta ka, puro atārǝia andǝ Shepna mǝgilǝgir, andǝ Jowa muna-ɓwabura mala Asap mǝ'twalcau aɓa malǝmce, ace ká kumia.<verse eid="2KI 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 18:19" />Ɓwamǝgule-lwa mala Assuriya banggia wia ama:</para>
  <para style="pi" vid="2KI 18:19">&lt;&lt;Wu banggi Hezekiya: Mǝnia ka nda cau mǝnana murǝm mǝgule, yì murǝm mala Assuriya kǝ na ka: Mana a gūlì arǝì mǝnana po mǝnia yì mǝsǝkàngkàngŋa ka? <verse eid="2KI 18:19" /><verse number="20" style="v" sid="2KI 18:20" />A kǝ sǝni kǝla cau a mburkun ngga nda kutan andǝ rǝcandǝa mala lwa le? Yan a gūlikiyi arǝì mǝnana tsǝo a mgbicau arǝàm ngga? <verse eid="2KI 18:20" /><verse number="21" style="v" sid="2KI 18:21" />Ado ka, Masar na a kǝ gūlì arǝì ka re? Masar ka kùrrí mǝ'arre na mǝnana ɓǝ̀ ɓwa eangnǝ arǝì ka, nǝ̀ swàrì a buì ka! Anggo sǝ Firona murǝm Masar pa aban aɓwana mǝnana kat à gūlì arǝì ka. <verse eid="2KI 18:21" /><verse number="22" style="v" sid="2KI 18:22" />Sǝ ɓǝ̀ wu banggam ama, Yahweh Ɓakuli ma'wun na wu kǝ gūlì arǝì ka, yì nda mǝnana mbak Hezekiya bǝbbǝriki amgbangban-peri andǝ agyangŋan male, sǝ banggi aɓwana mala Yahuda andǝ Urǝshalima ama, &lt;Dumǝna púp wun nǝ̀ peri a ban gyangŋan mǝnia a Urǝshalima&gt; ka re? <verse eid="2KI 18:22" /><verse number="23" style="v" sid="2KI 18:23" />Ado ka, yiu, wu earcau wunǝ mǝtala-ɓala mem murǝm mala Assuriya, sǝ mǝ nǝ po apǝr á-ɓari (2,000), ɓǝ̀ awu nǝ gandǝ kum amǝ'koea ka. <verse eid="2KI 18:23" /><verse number="24" style="v" sid="2KI 18:24" />Lang sǝ awu nǝ gandǝ pǝr ɓwa mwashat atà arítǎu mala amǝgulo-lwa mala mǝtala-ɓala mem, mǝnana gūliarǝu mò ka nda arǝ Masar ɓǝ̀ po awaru-pǝr andǝ amǝpǝr ka?<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Ko: </char><char style="fqa" closed="false">A pà wu nǝ gandǝ pǝr ɓwa mwashat atà arítǎu mala amǝgulo-lwa mala mǝtala-ɓala mem ɗàng, kat andǝ amani ama a gūlì arǝ Masar ɓǝ̀ po awaru-pǝr andǝ amǝpǝr ka!</char></note> <verse eid="2KI 18:24" /><verse number="25" style="v" sid="2KI 18:25" />Ko a kǝ sǝni kǝla yiu mem nǝ munǝo a ban mǝnia ace kiɗike ka, nê mala Yahweh na re? Yahweh na mǝnana banggam ama, &lt;Eauwe kya arǝ nzali man, kya kiɗiki ka.&gt; &gt;&gt;<verse eid="2KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 18:26" />Pǝlǝa Eliyakim muna-ɓwabura mala Hilkiya andǝ Shepna sǝ Jowa banggi Ɓwamǝgule-lwa mala Assuriya ama, &lt;&lt;Ida, na sǝm cau, sǝm aguro mò, nǝ kún Aram, acemǝnana sǝm ok kúni cim. Kǝa na sǝm cau nǝ kún Ibǝru ɗàng, acemǝnana aɓwana mǝnana à cam amur sheran ngga à nǝ̀ oè.&gt;&gt;<verse eid="2KI 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 18:27" />Sǝ Ɓwamǝgule-lwa nea wia ama:</para>
  <para style="pi" vid="2KI 18:27">&lt;&lt;Pà aban wun andǝ murǝm ma'wun nǝmurǝ wun sǝ mǝtala-ɓala mem túrǎm mǝ bang acau mǝnia ka ɗàng; nda gbal aban aɓwana mǝnana à cam amur sheran ngga, mana wun wunǝia ka, wun nǝ̀ lì ciuta wun sǝ wun nǝ̀ nu sanzǝata wun ngga.&gt;&gt;<verse eid="2KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 18:28" />Pǝlǝa Ɓwamǝgule-lwa lo cam-nǝ-came sǝ loasǝ gì kpǝm bangcau nǝ kún Ibǝru ama:</para>
  <para style="pi" vid="2KI 18:28">&lt;&lt;Wu kwakikir wun arǝ cau mala murǝm mǝgule, yì murǝm mala Assuriya. <verse eid="2KI 18:28" /><verse number="29" style="v" sid="2KI 18:29" />Murǝm ama: Wu kǝa earî Hezekiya ɓǝ̀ swarki wun ɗàng, acemǝnana pà nǝ̀ gandǝ amsǝ wun a ɓabuam ɗàng. <verse eid="2KI 18:29" /><verse number="30" style="v" sid="2KI 18:30" />Wu kǝa earî Hezekiya ɓǝ̀ ɓosǝki wun, wu gūlì arǝ Yahweh ama, &lt;Mbak-kàngkàng, Yahweh nǝ̀ amsǝ sǝm; nggea-là mǝnia pà nǝ̀ kpa a ɓabu murǝm mala Assuriya ɗàng.&gt; <verse eid="2KI 18:30" /><verse number="31" style="v" sid="2KI 18:31" />Wu kǝa kwakikir wun arǝ Hezekiya ɗàng! Mǝnia nda cau mǝnana murǝm mala Assuriya bang ngga ama: &lt;Wu purî ɓá nggea-là, wu yiu abanam, wu alta dorǝpwala nǝ mim, sǝ koyan atà wun ngga, nǝ̀ lì ɓǝlanggun anap andǝ ɓǝla-vwari male, sǝ nǝ̀ nu mùr a tūli-mùr male. <verse eid="2KI 18:31" /><verse number="32" style="v" sid="2KI 18:32" />Pǝlǝa mǝ nǝ yia kánǝ wun a ɓè nzali mǝnana nda kǝla ma'wun ngga, nzali mǝnana ndanǝ mǝsǝsa andǝ bǝsa mùr-anap mǝɓoarne ka, nzali mǝnana ndanǝ girlina andǝ aɓaban-anap, nzali mǝnana ndanǝ anggun olif andǝ mur'nyi ka. Anggo ka wun nǝ̀ dum nǝyilǝmu, pà wun nǝ̀ wù ɗàng! Wu kǝa kwakikir wun arǝ Hezekiya ɓǝ̀ ɓosǝki wun ama, &lt;&lt;Yahweh nǝ̀ amsǝ sǝm&gt;&gt; ɗang. <verse eid="2KI 18:32" /><verse number="33" style="v" sid="2KI 18:33" />Kǝ ɓè atà aɓakuli mala anzali na kam, mǝnana akmúr nzali male a bù murǝm mala Assuriya a kǝ fara ka le? <verse eid="2KI 18:33" /><verse number="34" style="v" sid="2KI 18:34" />Aɓakuli mala anggea-là Hamat andǝ Arpat na ke? Sǝ aɓakuli mala alá Sefarvayim andǝ Hena andǝ Ivva na ke? À gandǝ akmúr Samariya a ɓabuam le? <verse eid="2KI 18:34" /><verse number="35" style="v" sid="2KI 18:35" />Mǝye na atà aɓakuli mala amǝno yì anzali ka, amsǝ nzali male a buam? Sǝ lang sǝ Yahweh nǝ̀ akmúr Urǝshalima a ɓabuam?&gt; &gt;&gt;<verse eid="2KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 18:36" />Sǝ aɓwe ka à pwal piu; kǝɓwa nyesǝ kǝ cau ɗàng, acemǝnana murǝm angŋa-dǝmba pànà nzongcau ama, &lt;&lt;Kǝɓwa ɓǝkǝa pǝlǝi wi kǝ cau ɗàng.&gt;&gt;<verse eid="2KI 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="2KI 18:37" />Pǝlǝa Eliyakim muna-ɓwabura mala Hilkiya, mǝnana nda ɓwamǝgule-palta, atārǝia andǝ Shepna mǝgilǝgir, andǝ Jowa muna-ɓwabura mala Asap mǝ'twalcau aɓa malǝmce, nyar aban Hezekiya. Koyan atea ka sàn daura mǝnana arǝì ka [aɓa bumkiɗikea], sǝ à kùtí aban Hezekiya, à ne wi gìr mǝnana kat Ɓwamǝgule-lwa mala Assuriya bang ngga.<verse eid="2KI 18:37" /></para>
  <chapter eid="2KI 18" />
  <chapter number="19" style="c" sid="2KI 19" />
  <para style="s">Hezekiya alta kwarkiru <optbreak /> a ban mǝɓangnǝa Ishaya</para>
  <para style="r">(<ref loc="ISA 37:1-13">Ishaya 37:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 19:1" />Lang Murǝm Hezekiya ok mǝnia yì cau ka, sàn daura rǝì sǝ oasǝ daura-doatú,<note caller="+" style="f"><char style="fr" closed="false">19:1 </char><char style="fq" closed="false">daura-doatú </char><char style="ft" closed="false">ko asanginagìr </char></note> sǝ o a Ɓala mala Yahweh. <verse eid="2KI 19:1" /><verse number="2" style="v" sid="2KI 19:2" />Túr Eliyakim ɓwamǝgule-palta, andǝ Shepna mǝgilǝgir andǝ aɓwana-mǝgule mala apǝris, mǝnana yià gbal ka à oasǝ adaura-doatú arǝia ka, ɓǝà kyan nǝ cau mǝnia ka aban mǝɓangnǝa Ishaya, muna-ɓwabura mala Amoz ama: <verse eid="2KI 19:2" /><verse number="3" style="v" sid="2KI 19:3" />&lt;&lt;Mǝnia ka nda cau mǝnana Hezekiya bang ngga ama: &lt;Pwari man yalung ngga, pwari kwanban na, pwari gimban na, sǝ pwari kyauwikiban na. Sǝm nda kǝla ɓwama mǝnana malanǝ̀ gbáshí, sǝ rǝcandǝa mala gbáshí-muna pa kàm raka. <verse eid="2KI 19:3" /><verse number="4" style="v" sid="2KI 19:4" />Earka Yahweh Ɓakuli mô nǝ̀ ok acau mala Ɓwamǝgule-lwa, mǝnana mǝtala-ɓala male murǝm Assuriya túrí ɓǝ̀ yi soabum Ɓakuli mǝyilǝmui nǝia ka, sǝ nǝ̀ gimbi ace acau mǝnana nea ka. Acemani ka, pakhiwi ace cili sǝm mǝnana sǝm ue nǝyilǝmu ka.&gt; &gt;&gt;<verse eid="2KI 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 19:5" />Lang amǝtúró-ɓadǝm Hezekiya wari aban Ishaya ka, <verse eid="2KI 19:5" /><verse number="6" style="v" sid="2KI 19:6" />Ishaya banggia wia ama, &lt;&lt;Wu banggi mǝtala-ɓala ma'wun mǝnia yì cau ka ama: &lt;Mǝnia ka nda cau mǝnana Yahweh na ka: Cè ɓangciu pàkkô arǝ acauɓana mǝnana a oea a kún amuna-ɓala mala murǝm Assuriya, mǝnana à nea arǝàm ngga ɗàng. <verse eid="2KI 19:6" /><verse number="7" style="v" sid="2KI 19:7" />Mim nǝ nggearam ngga, mǝ nǝ tsǝk ɓekǝ bangŋo a ɓālǝi, mǝnana nǝ̀ ok na'ongŋale mana nǝ̀ tsǝì nǝ̀ nyar a nzali male ka. Mǝ nǝ tsǝa à nǝ̀ wal-luí aɓa nzali male nǝ nggeabyau.&gt; &gt;&gt;<verse eid="2KI 19:7" /></para>
  <para style="s">Nabura mala Senakerip arǝ Yahweh</para>
  <para style="r">(<ref loc="ISA 37:8-20">Ishaya 37:8-20</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 19:8" />Lang Ɓwamǝgule-lwa mala Assuriya ok ama murǝm mala Assuriya longŋǝni nggea-là Lakish ka, pǝlǝa nyare o, sǝ kya kum murǝm male ka nda aɓa lwa arǝ nggea-là Libna. <verse eid="2KI 19:8" /><verse number="9" style="v" sid="2KI 19:9" />Zuku anzǝm mǝno ka, Senakerip, murǝm mala Assuriya ok cau ama Tirhaka murǝm mala Kush na a njar aban yiu nǝ munǝo arǝì. Pǝlǝa tasǝ amǝ'na-túrbân ɗǝm aban Hezekiya murǝm Yahuda ama, <verse eid="2KI 19:9" /><verse number="10" style="v" sid="2KI 19:10" />&lt;&lt;Wu ne Hezekiya murǝm Yahuda mǝnia yì cau ka: &lt;Kǝa earî Ɓakuli mô mǝnana a gūlì arǝì ka ɓǝ̀ swarkio ama &lt;&lt;Urǝshalima pà nǝ̀ kpa a ɓabu murǝm mala Assuriya raka ɗàng.&gt;&gt; <verse eid="2KI 19:10" /><verse number="11" style="v" sid="2KI 19:11" />We nǝ nggearǝo ka a ongŋǝnace gìr mǝnana murǝm Assuriya pangnǝ anzali mǝnana kat kiɗikia kat-kat ka; a kǝ sǝni kǝla a nda mǝnana awu nǝ au ka le? <verse eid="2KI 19:11" /><verse number="12" style="v" sid="2KI 19:12" />Anzali mǝnana akêm kiɗikia, yì anzali Gozan, andǝ Haran, andǝ Rezep, andǝ amǝ Iden mǝnana à kya do a Tel-Asar ka, aɓakuli malea amsǝia le? <verse eid="2KI 19:12" /><verse number="13" style="v" sid="2KI 19:13" />Murǝm mala Hamat, andǝ mala Arpat, andǝ mala Layir, andǝ murǝm mala nggea-là Sefarvayim, andǝ Hena, sǝ Ivva ka, à nda ke?&gt; &gt;&gt;<verse eid="2KI 19:13" /></para>
  <para style="s">Hiwi mala Hezekiya</para>
  <para style="r">(<ref loc="ISA 37:14-20">Ishaya 37:14-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 19:14" />Hezekiya ak cautera mǝno a bu amǝ'na-túrbân, sǝ lang ɓalni ka, pǝlǝa wari a ɓala mala Yahweh sǝ sárǝí aɓadǝm Yahweh. <verse eid="2KI 19:14" /><verse number="15" style="v" sid="2KI 19:15" />Sǝ Hezekiya pakhiwi aban Yahweh ama, &lt;&lt;We Yahweh, Ɓakuli mala Isǝrayila, mǝnana do amur bunomurǝm amur aCerup ka! We nǝmurǝo a nda Ɓakuli mala adomurǝm mala ɓanza kat. A nda mǝnana a pak kuli andǝ nzali ka. <verse eid="2KI 19:15" /><verse number="16" style="v" sid="2KI 19:16" />We Yahweh, kwakikiro sǝ wu ó. Mǝn amǝsǝo, Yahweh, sǝ wu sǝni. Ok acau mala Senakerip, mǝnana turaban nǝi ace soabum Ɓakuli mǝyilǝmui ka! <verse eid="2KI 19:16" /><verse number="17" style="v" sid="2KI 19:17" />Mǝsǝcau, Yahweh, amurǝma mala Assuriya kiɗikina aɓwapǝndǝa andǝ anzali malea, <verse eid="2KI 19:17" /><verse number="18" style="v" sid="2KI 19:18" />sǝ à pisǝna aɓakuli malea a bǝsa; à kiɗikia acemǝnana amǝno ka aɓakuli na ɗang; atúróbù mala ɓwapǝndǝa na mǝnana à pea nǝ nggun andǝ tali ka. <verse eid="2KI 19:18" /><verse number="19" style="v" sid="2KI 19:19" />Sǝama ado ka, Yahweh Ɓakuli ma'sǝm, amsǝ sǝm a ɓabui, ace mǝnana adomurǝm mala ɓanza kat ɓǝà sǝlǝa ama, we nǝmurǝo, Yahweh, a nda Ɓakuli.&gt;&gt;<verse eid="2KI 19:19" /></para>
  <para style="s">Nyesǝcau mala Ɓakuli <optbreak /> nǝ kún Ishaya mǝɓangnǝa</para>
  <para style="r">(<ref loc="ISA 37:21-35">Ishaya 37:21-35</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 19:20" />Pǝlǝa Ishaya muna-ɓwabura mala Amoz túrban nǝ cau mǝnia ka aban Hezekiya ama: &lt;&lt;Yahweh Ɓakuli mala Isǝrayila bang ama: &lt;Ən ongŋǝna hiwi mǝnana wu pè abanam, amur Senakerip murǝm mala Assuriya ka.&gt; <verse eid="2KI 19:20" /><verse number="21" style="v" sid="2KI 19:21" />Mǝnia ka, nda cau mǝnana Yahweh bang amurí ka:</para>
  <para style="q1" vid="2KI 19:21">&lt;&lt;Nsari ɓoarnsarile Siyona kǝ ɓǝsǝkio,</para>
  <para style="q2" vid="2KI 19:21">kǝ oalǒ;</para>
  <para style="q1" vid="2KI 19:21">Ɓoarnsarile Urǝshalima kǝ dǝurǝ múrí arǝò!<verse eid="2KI 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2KI 19:22" />Yana a soabumi sǝ a namǝɓane arǝì?</para>
  <para style="q1" vid="2KI 19:22">Yana a loasǝi wi gio,</para>
  <para style="q2" vid="2KI 19:22">sǝ yana a twani nǝ twalkirǝu?</para>
  <para style="q1" vid="2KI 19:22">A nda arǝ Mǝfele mala Isǝrayila!<verse eid="2KI 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2KI 19:23" />Nǝ kún amǝ'na-túrbân mô a soabum Mǝtalabangŋo;</para>
  <para style="q2" vid="2KI 19:23">a na ama:</para>
  <para style="q1" vid="2KI 19:23">&lt;Nǝ awaru-pǝr mem mǝ'làkke</para>
  <para style="q1" vid="2KI 19:23">ǝn eauna amur ankono mǝ'dāhre,</para>
  <para style="q2" vid="2KI 19:23">ǝn warina arǝ ankanggariban mala Lebano.</para>
  <para style="q2" vid="2KI 19:23">Ən makkina anggun-seda mǝ'dāh'rike male,</para>
  <para style="q2" vid="2KI 19:23">andǝ anggun-sapǝre mǝɓoarne-katkat male.</para>
  <para style="q1" vid="2KI 19:23">Ən kutikina arǝ agíríban mala bando male,</para>
  <para style="q2" vid="2KI 19:23">yì patal mala ndà-nggun pusǝ aɓǝlagir male.<verse eid="2KI 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2KI 19:24" />Ən tǝmgina atūli-mùr aɓalǝ abǝri-nzali,</para>
  <para style="q2" vid="2KI 19:24">sǝ ǝn nuna mùr arǝ abanì.</para>
  <para style="q1" vid="2KI 19:24">Nǝ ɓakusǝam ǝn sonzǝ amyal-múr mala Masar kat.&gt;<verse eid="2KI 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2KI 19:25" />Sǝama a ok mbak?</para>
  <para style="q1" vid="2KI 19:25">Twal a pwarian ǝn kwakì.</para>
  <para style="q1" vid="2KI 19:25">Ɓara-ɓara ǝn kanì,</para>
  <para style="q2" vid="2KI 19:25">sǝ ado ka ǝn yinanǝi ɓǝ̀ yi lùmsǝó,</para>
  <para style="q1" vid="2KI 19:25">ama nǝ̀ pà aɓa rǝcandǝa mò,</para>
  <para style="q2" vid="2KI 19:25">wu nyesǝ akanggǝrang anggea-là</para>
  <para style="q2" vid="2KI 19:25">ɓǝà pǝlǝ agigi mala atali.<verse eid="2KI 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2KI 19:26" />Aɓwana mana aɓalǝia ka,</para>
  <para style="q2" vid="2KI 19:26">à nǝ̀ ɗwanyi rǝcandǝa,</para>
  <para style="q1" vid="2KI 19:26">sǝ acemani ka,</para>
  <para style="q2" vid="2KI 19:26">ɓangciu nǝ̀ bwalia</para>
  <para style="q2" vid="2KI 19:26">sǝ múrià nǝ̀ zurì.</para>
  <para style="q1" vid="2KI 19:26">À nǝ̀ yauwi kǝla agirpwala mala ɓawan,</para>
  <para style="q2" vid="2KI 19:26">kǝla lolloapì bondo mǝpwale;</para>
  <para style="q1" vid="2KI 19:26">sǝ kǝla bondo a múr-kurǝm,</para>
  <para style="q2" vid="2KI 19:26">mǝnana kaniama nǝ̀ gul ka,</para>
  <para style="q2" vid="2KI 19:26">gùngpi mala ɓá pǝɗanban pisǝni, imǝna ka.<verse eid="2KI 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2KI 19:27" />Ən súrǝ́nàrǝ lo mô andǝ do mô,<note caller="+" style="f"><char style="fr" closed="false">19:27 </char><char style="fq" closed="false">lo mô andǝ do mô </char><char style="ft" closed="false">kǝla mana aɓa: </char><char style="xt"><ref loc="ISA 37:27">Isha 37:27</ref> </char>.</note></para>
  <para style="q2" vid="2KI 19:27">puro mô andǝ kutio mô,</para>
  <para style="q2" vid="2KI 19:27">andǝ bumlulla mô arǝàm.<verse eid="2KI 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2KI 19:28" />Sǝ acemǝnana a pak-bumlulla arǝàm,</para>
  <para style="q2" vid="2KI 19:28">sǝ twalɓamurǝu mô yina a kiram ngga,</para>
  <para style="q1" vid="2KI 19:28">mǝ nǝ kwárǒ nǝ nli mem a lullǝo</para>
  <para style="q2" vid="2KI 19:28">sǝ mǝ nǝ oasǝo nggwiandan mem a kuno</para>
  <para style="q1" vid="2KI 19:28">sǝ mǝ nǝ nyesǝo</para>
  <para style="q2" vid="2KI 19:28">a njar mǝnana a yiu kam ngga.<verse eid="2KI 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 19:29" />&lt;&lt;Sǝ we Hezekiya ka, mǝnia ka, nda nǝ̀ duk gir'lǝmdǝa a bano ka:</para>
  <para style="q1" vid="2KI 19:29">&lt;&lt;Aɓa pǝlǝa mǝnia ka, wun nǝ̀ lì gìr</para>
  <para style="q2" vid="2KI 19:29">mǝnana pur atàrǝì a ɓaban</para>
  <para style="q2" vid="2KI 19:29">à ɓeali-nǝ-ɓeale raka,</para>
  <para style="q1" vid="2KI 19:29">sǝ a ɓaria pǝlǝa ka,</para>
  <para style="q2" vid="2KI 19:29">gìr mǝnana tò nǝ nggearǝì aɓa mǝno ka.</para>
  <para style="q1" vid="2KI 19:29">Sǝama a tàruià pǝlǝa ka, wu ɓealɓeale</para>
  <para style="q2" vid="2KI 19:29">sǝ wu pwan gir-ɓaban;</para>
  <para style="q1" vid="2KI 19:29">wu pandǝki anggun-anap</para>
  <para style="q2" vid="2KI 19:29">aɓalǝ aɓaban-anap sǝ wu lì ɓǝlea.<verse eid="2KI 19:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2KI 19:30" />Aɓwana mǝnana à auwa</para>
  <para style="q1" vid="2KI 19:30">sǝ à ueo a ɓala mala Yahuda ka,</para>
  <para style="q2" vid="2KI 19:30">à nǝ̀ soa nlerǝia a nzali ɗǝm,</para>
  <para style="q2" vid="2KI 19:30">sǝ à nǝ̀ pusǝ ɓǝlea a kuli.<note caller="+" style="f"><char style="fr" closed="false">19:30 </char><char style="fq" closed="false">à nǝ̀ soa nlerǝia a nzali ɗǝm, sǝ à nǝ̀ pusǝ ɓǝlea a kuli </char><char style="ft" closed="false">ko &lt;&lt;à nǝ̀ hangǝli, sǝ à nǝ̀ ɓǝl amuna pas.&gt;&gt;</char></note><verse eid="2KI 19:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="2KI 19:31" />Acemǝnana aɓwana na kam mǝnana à ue ka</para>
  <para style="q2" vid="2KI 19:31">à nǝ̀ lo aɓa Urǝshalima,</para>
  <para style="q1" vid="2KI 19:31">aɓwana mǝnana à au ka,</para>
  <para style="q2" vid="2KI 19:31">à nǝ̀ pur a Nkono Siyona.</para>
  <para style="m" vid="2KI 19:31">Ɓabumpina mala Yahweh nǝ̀ pàk mani.<verse eid="2KI 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2KI 19:32" />&lt;&lt;Acemani ka, mǝnia nda cau mala Yahweh amur murǝm mala Assuriya ama:</para>
  <para style="q1" vid="2KI 19:32">&lt;&lt; &lt;Pà nǝ̀ kùtí aɓa nggea-là mǝnia,</para>
  <para style="q2" vid="2KI 19:32">ko nǝ̀ túr mundi kam ɗàng.</para>
  <para style="q1" vid="2KI 19:32">Pà nǝ̀ yiu arǝì nǝ ntongŋo,</para>
  <para style="q2" vid="2KI 19:32">ko nǝ̀ ɓak mgbangban arǝ sheran male</para>
  <para style="q2" vid="2KI 19:32">ace eau amurí ka ɗàng.<verse eid="2KI 19:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2KI 19:33" />Njar mǝnana yiu nǝi ka,</para>
  <para style="q2" vid="2KI 19:33">nda nǝ̀ nyar nǝi ka.</para>
  <para style="q1" vid="2KI 19:33">Pà nǝ̀ kùtí aɓa nggea-là man ɗang.</para>
  <para style="q4" vid="2KI 19:33">Mim Yahweh ka mǝ nǝ̀ ne.<verse eid="2KI 19:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2KI 19:34" />Mǝ nǝ duk ntongŋo amur mǝnia yì nggea-là ka,</para>
  <para style="q2" vid="2KI 19:34">ace amsǝe, ace lullǝam</para>
  <para style="q2" vid="2KI 19:34">sǝ ace guro mem Dauda.&gt; &gt;&gt;<verse eid="2KI 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2KI 19:35" />Aɓa du mǝno ka, mǝturonjar mala Yahweh puro wari a kàttì mala amǝ'lwa mala amǝ'Assuriya, wal-lú aɓwana á-gbǝman-mwashat nǝ á-lumi-tongno-nong-tàrú-bwamdǝ-tongno (185,000). Ban fana nǝ dǝmbari ka, à sǝn alú aban bwamdǝo a koya ban. <verse eid="2KI 19:35" /><verse number="36" style="v" sid="2KI 19:36" />Nda sǝ Senakerip murǝm mala Assuriya, nyare o a là, kya do a Nineva ka. <verse eid="2KI 19:36" /><verse number="37" style="v" sid="2KI 19:37" />Sǝ lang nda aban peri aban ɓakuli male Nisrok ka, amuna-burana male Adǝramelek andǝ Shareza wal-luí nǝ nggeabyau, sǝ à ɓangŋa à o a nzali Ararat, sǝ muna-ɓwabura male Esarhadon duk murǝm a bancame male.<verse eid="2KI 19:37" /></para>
  <chapter eid="2KI 19" />
  <chapter number="20" style="c" sid="2KI 20" />
  <para style="s">Nongkwánó mala Hezekiya</para>
  <para style="r">(<ref loc="2CH 32:24-26">2 Acau la Apwari 32:24-26</ref>; <ref loc="ISA 38:1-8">Ishaya 38:1-8</ref>,<ref loc="ISA 38:21">21</ref>,<ref loc="ISA 38:22">22</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 20:1" />Aɓalǝ anonggio mǝno ka, Hezekiya nongkwánó mǝnana ue bǝti ɓǝ́ wuna ka. Ishaya mǝɓangnǝa muna-ɓwabura mala Amoz yiu abaní, banggi wi ama, &lt;&lt;Yahweh kǝ na ama, &lt;Tsǝk agir a kǝkarì a ɓala mò, acemǝnana a ndo awu nǝ wǔ, a pà nǝ au ɗàng.&gt; &gt;&gt; <verse eid="2KI 20:1" /><verse number="2" style="v" sid="2KI 20:2" />Pǝlǝa Hezekiya pǝlǝ ɓamǝsǝi arǝ bumkurǝm sǝ pakhiwi aban Yahweh ama, <verse eid="2KI 20:2" /><verse number="3" style="v" sid="2KI 20:3" />&lt;&lt;Yahweh, mǝ ndaban zǝmbo, ɗenyinǝ gya mem mǝnana ǝn gya aɓadǝmbo aɓa mǝsǝcau andǝ ɓabumam kat ka, sǝ wu ɗenyi ama ǝn pangŋǝ̀nà gìr mǝnana mǝɓoarne na a mǝsǝo ka.&gt;&gt; Sǝ Hezekiya ɓua, ɓua mǝkwanbani.<verse eid="2KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 20:4" />Ishaya na piu a tsùrú mala patal mala ɓala-murǝm sǝ cau mala Yahweh yiu abaní ama, <verse eid="2KI 20:4" /><verse number="5" style="v" sid="2KI 20:5" />&lt;&lt;Nyare kya banggi Hezekiya, múrû amur aɓwana mem ama, &lt;Mǝnia ka nda cau mǝnana Yahweh Ɓakuli mala keò Dauda kǝ na ka: Ən ongŋǝna zǝmba mô, sǝ ǝn sǝnǝna mǝrǝm mô mǝnana a sukki ka. Mǝ nǝ twalôban rǝkwana mò. Anzǝm nongŋo ɓari tite yalung ngga, awu nǝ loapi kala, awu nǝ ká peri a ɓala mala Yahweh. <verse eid="2KI 20:5" /><verse number="6" style="v" sid="2KI 20:6" />Mǝ nǝ tsǝkô aɓea apǝlǝa lum-bwamdǝ-tongno (15) amur anonggio mala do-yilǝmu mô. Sǝ mǝ nǝ amsǝo wunǝ nggea-là mǝnia ka a ɓabu murǝm mala Assuriya. Mǝ nǝ zǝ̀kì nggea-là mǝnia ka ace gulo mem, sǝ atàcau mala guro mem Dauda.&gt; &gt;&gt;<verse eid="2KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 20:7" />Pǝlǝa Ishaya banggi amǝtúró-ɓadǝm murǝm ama, &lt;&lt;Wu betǝki ɓǝla vwari, sǝ wu lanzǝi wi amur ceakúmsǝǎm, ace mǝnana ɓǝ̀ sonzǝ ka.&gt;&gt;<verse eid="2KI 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 20:8" />Pǝlǝa Hezekiya ɗì Ishaya ama, &lt;&lt;Ya gìr'lǝmdǝa na mǝnana nǝ̀ lǝmdǝ ama Yahweh nǝ̀ twàlâm-ban rǝkwana man, mǝ nǝ loapi kala anzǝm nongŋo ɓari, tite yalung, sǝ mǝ nǝ ká peri a ɓala mala Yahweh ka?&gt;&gt; <verse eid="2KI 20:8" /><verse number="9" style="v" sid="2KI 20:9" />Ishaya eari wi ama, &lt;&lt;Mǝnia ka nda gìr'lǝmdǝa mǝnana Yahweh kǝ po ace lǝmdǝò ama, Yahweh nǝ̀ pàk gìr mǝnana pàcau ace ka. A kǝ earce ama yilǝm ɓǝ̀ sung a dǝmba twalkusǝu lum le, ko ɓǝ̀ nyar nǝte twalkusǝu lum?&gt;&gt; <verse eid="2KI 20:9" /><verse number="10" style="v" sid="2KI 20:10" />Hezekiya ear ama, &lt;&lt;Nda halku ɓǝ̀ yilǝm sung a dǝmba twalkusǝu lum; a kún mani ka, ɓǝ̀ nyar nǝte twalkusǝu lum.&gt;&gt; <verse eid="2KI 20:10" /><verse number="11" style="v" sid="2KI 20:11" />Nda Ishaya mǝɓangnǝa pakhiwi aban Yahweh, sǝ Yahweh tsǝa yilǝm nyar nǝte twalkusǝu lum, amur ban-eauwe mala Ahaz ka.<verse eid="2KI 20:11" /></para>
  <para style="s">Amǝ'na-túrbân pur a Babila à yiu aban Hezekiya</para>
  <para style="r">(<ref loc="ISA 39:1-8">Ishaya 39:1-8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="2KI 20:12" />A bàkú mǝno ka, Merodak-Baladan muna-ɓwabura mala Baladan, murǝm mala Babila, túrban nǝ acautera andǝ ɓoro aban Hezekiya nǝ bu amǝ'na-túrbân, acemǝnana ok ama Hezekiya nongkwánó ka. <verse eid="2KI 20:12" /><verse number="13" style="v" sid="2KI 20:13" />Hezekiya gingsǝia. Pǝlǝa lǝmdǝia wia agir mǝnana kat à nda aɓalǝ andà-tsǝk agir-ɓoarna male ka; bolo-azǝrfa, andǝ bolo-njengǝlan, andǝ agir-mǝ'kuskushi, andǝ mùrú olif mǝrǝmɓoarne. Ɗǝm ngga warinǝia à kya sǝn agir-munǝo male, andǝ koya gìrɓoarna mǝnana kat a ɓala-murǝm ngga. Kǝgir pà kàm a ɓala male, ko aɓa nzali-murǝm male mǝnana Hezekiya lǝmdǝia wia raka ɗàng.<verse eid="2KI 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 20:14" />Pǝlǝa Ishaya mǝɓangnǝa yiu aban Murǝm Hezekiya, sǝ ɗì ama, &lt;&lt;Aburana mǝnia ka à pur aya ban sǝ à yiu? Mana aburane banggo?&gt;&gt; Hezekiya eari wi ama, &lt;&lt;À pur a ɓè nzali kuko, a Babila.&gt;&gt;<verse eid="2KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 20:15" />Ishaya ɗì ɗǝm ama, &lt;&lt;Mana à sǝni a palta mô?&gt;&gt; Hezekiya eari wi ama, &lt;&lt;À sǝna koman kat a palta mem. Koman mǝnana kat nda aɓalǝ andà-tsǝk agir-ɓoarna mem ngga, ǝn lǝmdǝia wia.&gt;&gt;<verse eid="2KI 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 20:16" />Pǝlǝa Ishaya banggi wi ama, &lt;&lt;Kwakikiro, ok cau mala Yahweh, <verse eid="2KI 20:16" /><verse number="17" style="v" sid="2KI 20:17" />&lt;Mbak-kàngkàng, pwari na kǝ yiu ka, mǝnana koman kat mana nda aɓa palta mô, andǝ agir mǝnana kat akeô rambia, twal a pwarian yi pur ado ka, à nǝ̀ pwania à nǝ̀ umnǝia a Babila. Kǝgir pà kàm à nǝ̀ nyi ɗàng. Mim Yahweh, mǝ nǝ̀ na. <verse eid="2KI 20:17" /><verse number="18" style="v" sid="2KI 20:18" />Aɓea amuna-burana mô mǝnana à nǝ̀ ɓǝlô wia ka, à nǝ̀ pwania à nǝ̀ umnǝia arǝò, à nǝ̀ nggá pǝlǝ abedǝran andǝ amǝtúró-ɓadǝm murǝm mala Babila a palta male.&gt; &gt;&gt;<verse eid="2KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 20:19" />Pǝlǝa Hezekiya banggi Ishaya ama, &lt;&lt;Cau mala Yahweh mǝnana a bangŋi ka, mǝɓoarne na.&gt;&gt; Hezekiya bang mǝno acemǝnana aɓa ɗenyicau male ka, nda rǝ na ama, &lt;&lt;Ko ɓǝ̀ mǝno kumban ngga, do-rǝpwala andǝ gbàshá nǝ̀ pà a do-yilǝmu mem!&gt;&gt;<verse eid="2KI 20:19" /></para>
  <para style="s">Lú mala Hezekiya</para>
  <para style="r">(<ref loc="2CH 32:32-33">2 Acau la Apwari 32:32-33</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 20:20" />Acili agir mǝnana à kumban a do-bunomurǝm mala Hezekiya andǝ atúró mǝnana kat pàkkia aɓa rǝcandǝa male, andǝ ɓah mǝnana ɓàk gǝndǝli-mùr andǝ myalmur'tǝtanzali mǝnana tǝmi ace yinǝ mùr aɓa nggea-là ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 20:20" /><verse number="21" style="v" sid="2KI 20:21" />Hezekiya yi wú atà akê, sǝ muna-ɓwabura male Manasa ak bancame male kǝla murǝm.<verse eid="2KI 20:21" /></para>
  <chapter eid="2KI 20" />
  <chapter number="21" style="c" sid="2KI 21" />
  <para style="s">Yálmúrû mala Manasa a nzali Yahuda</para>
  <para style="r">(<ref loc="2CH 33:1-20">2 Acau la Apwari 33:1-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 21:1" />Manasa ka apǝlǝa male na lum-nong-ɓari (12) lang duk murǝm ngga. Yálmúr aɓwana a Urǝshalima arǝ apǝlǝa lumi-tongno-bwamdǝ-tongno (55). Lullǝ nggé nda Hefziba. <verse eid="2KI 21:1" /><verse number="2" style="v" sid="2KI 21:2" />Pàkki agir mǝnana amǝɓike na a mǝsǝ Yahweh ka, nǝ kpata akúncau mǝɓeami mala aɓwapǝndǝa mǝnana Yahweh pǝria a ɓadǝmbǝ amǝ Isǝrayila ka. <verse eid="2KI 21:2" /><verse number="3" style="v" sid="2KI 21:3" />Yì ka nyare ɓakki agyangŋan-peri mala ankúl mǝnana tárrí Hezekaya akdǝmba kiɗikia ka; loasǝ agyangŋan ace Ba'al, sǝ pandǝ tondong mala Ashera, kǝla mǝnana Ahap murǝm mala Isǝrayila pè ka. Yì ɗǝm ngga ɓun a ɓadǝmbǝ anlero mǝnana a kùli ka sǝ peri abania. <verse eid="2KI 21:3" /><verse number="4" style="v" sid="2KI 21:4" />Ɓakki agyangŋan mala ankúl a ɓala mala Yahweh, ban mǝnana Yahweh bangcau amurí ama, &lt;&lt;A kani a Urǝshalima sǝ lullǝàm nǝ̀ ueo tàtǝ́k&gt;&gt; ka.<note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 12:11">Nggur 12:11</ref>,<ref loc="DEU 12:14">14</ref>; <ref loc="1KI 11:13">1Amur 11:13</ref></char>.</note> <verse eid="2KI 21:4" /><verse number="5" style="v" sid="2KI 21:5" />Aɓalǝ apatal ɓari mala ɓala mala Yahweh ka, ɓakki agyangŋan ace anlero mǝnana kat a bumkuli ka. <verse eid="2KI 21:5" /><verse number="6" style="v" sid="2KI 21:6" />Paɓoro nǝ muna-ɓwabura male nǝ pisǝe kǝring a bǝsa.<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">aban Molek, ɓakuli mala amǝ'Mowap</char></note> Kutia pàkkiagir monzǝo, andǝ mala ɓángnǝ́'ɓángna andǝ mala sǝ̀lǝ̀ɓǝla. Kǝ wari a ɗibancau aban amǝ'ɗikalú andǝ amǝ'nggár. Pàkki agir pas mǝnana amǝɓike na kǝ̀rkǝ́r a mǝsǝ Yahweh ka, agir mǝnana à lulbum Yahweh kǝ̀rkǝ́r ka. <verse eid="2KI 21:6" /><verse number="7" style="v" sid="2KI 21:7" />Pàk ɓǝ̀nzál mala ashera sǝ tamsǝi a ɓala mala Yahweh, ban mǝnana Yahweh akdǝmba bángŋǝ́nì Dauda, sǝ bángŋǝ́nì muna-ɓwabura male Solomon ama, &lt;&lt;Ɓala mǝnia a Urǝshalima, mǝnana ǝn tarì aɓalǝ atau mala Isǝrayila kat ka, nǝ̀ duk bando mem tàtǝ́k.<note caller="+" style="f"><char style="fr" closed="false">21:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 12:5">Nggur 12:5</ref>; <ref loc="1KI 11:32">1Amur 11:32</ref></char>.</note> <verse eid="2KI 21:7" /><verse number="8" style="v" sid="2KI 21:8" />Pà mǝ nǝ tsǝk akusǝ Isǝrayila ɓǝ̀ gali ɗǝm ɓǝ̀ purî ɓá nzali mǝnia mǝnana ǝn pê akeâ ka ɗàng, ɓǝ̀ mbak-kàngkàng à nǝ̀ duk nǝ tsǝkiru à nǝ̀ bwal anzongcau mem kat, andǝ Nggurcau mǝnana kat guro mem Musa pea wia ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2SA 7:10">2Sam 7:10</ref>; <ref loc="1KI 9:1-9">1Amur 9:1-9</ref></char>.</note> <verse eid="2KI 21:8" /><verse number="9" style="v" sid="2KI 21:9" />Sǝ yià ka, à okiru ɗang. Manasa ɓosǝkia, à pàk ɓealɓikea kya kútì mala aɓwapǝndǝa mǝnana Yahweh kiɗikia sǝ amǝ Isǝrayila yi kútí aɓa nzalinì ka.<verse eid="2KI 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 21:10" />Sǝ Yahweh bangcau nǝ kún aguro male amǝ'ɓangnǝa ama: <verse eid="2KI 21:10" /><verse number="11" style="v" sid="2KI 21:11" />&lt;&lt;Acemǝnana Manasa murǝm mala Yahuda pàngŋǝ̀nà aman yì agir'ɓeami, kútínì ɓealɓikea mana amǝ'Amor pè aɓa nzalinì ɗiɗyal, sǝ acemǝnana warina nǝ Yahuda aɓa pàk cauɓikea atàcau mala ankúl male ka, <verse eid="2KI 21:11" /><verse number="12" style="v" sid="2KI 21:12" />mim Yahweh Ɓakuli mala Isǝrayila, ado ka, mǝ ndarǝ na ama: &lt;Mǝ ndo mǝ nǝ yinǝ gìr'mur'mwana amur Urǝshalima andǝ Yahuda. Ɓwa mǝnana kat okce ka, nǝ̀ gǝggǝli. <verse eid="2KI 21:12" /><verse number="13" style="v" sid="2KI 21:13" />Mǝ nǝ pàkkî Urǝshalima gìrkwanban ulang mǝnana ǝn pakkì Samariya, andǝ gìr'kwanrǝu ulang mǝnana ǝn pakkì Murǝm Ahap mala Isǝrayila andǝ amǝkè ka. Sǝ mǝ nǝ twalta aɓwana mana aɓa Urǝshalima ka ɗǝɗak, kǝla mana ɓwa esǝki ɓá kwár sǝ pǝlǝi kùmsǝì ka. <verse eid="2KI 21:13" /><verse number="14" style="v" sid="2KI 21:14" />Sǝ mǝ nǝ vwakibuam arǝ aɓwana mem mǝnana à ueo nǝyilǝmu ka, sǝ mǝ nǝ tasǝia a ɓabu aɓiamǝbura ɓǝà gandǝia. À nǝ̀ pǝrtea sǝ à nǝ̀ gbǝwi agir-ɓoarna mala nzali malea kǝla gǝna-lwa. <verse eid="2KI 21:14" /><verse number="15" style="v" sid="2KI 21:15" />Mǝ nǝ pàk mǝnia ka acemǝnana aɓwana mem pàngŋǝ́nàm gìr mǝnana mǝɓike na a mǝsǝam ngga, sǝ à camarǝ lulbumam twal a pwari mǝnana à akeâ purî Masar ka, ba yalung.&gt; &gt;&gt;<verse eid="2KI 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2KI 21:16" />Ɗǝm ngga, Manasa sukki nkila mala amǝ'kunpwasǝa pas, gandǝa lùmsǝ Urǝshalima nǝ nkila, lo a gírí là aban ká ɓè buì mala gírí là. Pàk mǝnia ka tsǝa-amur cauɓikea mǝnana tsǝk Yahuda aɓa pě nǝ pak ɓealɓikea a mǝsǝ Yahweh ka.<verse eid="2KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 21:17" />Acili agir mǝnana à kumban a do-bunomurǝm mala Manasa, andǝ atúró mǝnana kat pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 21:17" /><verse number="18" style="v" sid="2KI 21:18" />Sǝ Manasa yi wú atà akê sǝ à tsǝì a ɓaban-girpwala mala palta male, yì ɓaban-girpwala mala Uzza, sǝ Amon muna-ɓwabura male ak bancame male kǝla murǝm.<verse eid="2KI 21:18" /></para>
  <para style="s">Amon duk murǝm Yahuda</para>
  <para style="r">(<ref loc="2CH 33:21-25">2 Acau la Apwari 33:21-25</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 21:19" />Amon ngga, ndanǝ apǝlǝa lumi-ɓari-nong-ɓari (22) sǝ tita yálmúrû, sǝ yálmúr aɓwana arǝ apǝlǝa ɓari a Urǝshalima. Lullǝ nggé nda Meshulemet, muna-ɓwama mala Haruz, ɓwa Yotba. <verse eid="2KI 21:19" /><verse number="20" style="v" sid="2KI 21:20" />Yì ka pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, kǝla mǝnana tárrí Manasa pàk ka. <verse eid="2KI 21:20" /><verse number="21" style="v" sid="2KI 21:21" />Kpata kusǝ tárrí, peri aban ankúl mǝnana tárrí kpatea sǝ ɓun aɓadǝmbia ka. <verse eid="2KI 21:21" /><verse number="22" style="v" sid="2KI 21:22" />Vwakibuì arǝ Yahweh Ɓakuli mala akê, sǝ mgbikiri arǝ anzongcau mala Yahweh.<verse eid="2KI 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2KI 21:23" />Amǝtúró mala Murǝm Amon kùrkunia amurí, à wal-luí a palta male. <verse eid="2KI 21:23" /><verse number="24" style="v" sid="2KI 21:24" />Sǝama aɓwana mala nzalinì wal-lú aɓwana mǝnana à kùrkunia amur Murǝm Amon ngga, sǝ à tsǝk Josiya muna-ɓwabura male duk murǝm mana kpate ka.<verse eid="2KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 21:25" />Acili atúró mǝnana Amon peǎ ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 21:25" /><verse number="26" style="v" sid="2KI 21:26" />À tsǝk-luí a ɓembe male a ɓaban-girpwala mala Uzza, sǝ Josiya muna-ɓwabura male duk murǝm a bancame male.<verse eid="2KI 21:26" /></para>
  <chapter eid="2KI 21" />
  <chapter number="22" style="c" sid="2KI 22" />
  <para style="s">Josiya duk murǝm a Yahuda</para>
  <para style="r">(<ref loc="2CH 34:1-2">2 Acau la Apwari 34:1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 22:1" />Apǝlǝa ɓǝlban mala Josiya na tongno-nong-tàrú lang duk murǝm ngga, sǝ yálmúr aɓwana a Urǝshalima arǝ apǝlǝa lumi-tàrú-nong-mwashat (31). Lullǝ ngge nda Jedida, muna-ɓwama mala Adaya, ɓwama Bozǝkat. <verse eid="2KI 22:1" /><verse number="2" style="v" sid="2KI 22:2" />Josiya pàk gìr mǝnana mǝɓoarne na ka, aɓadǝm Yahweh, sǝ ging pepè a njar mala kè Dauda, kyang a bu-mǝli ko a bu-mǝnggare ɗàng.<verse eid="2KI 22:2" /></para>
  <para style="s">Hilkiya kum Malǝmce Nggurcau mala Ɓakuli</para>
  <para style="r">(<ref loc="2CH 34:8-28">2 Acau la Apwari 34:8-28</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="2KI 22:3" />A lum-bwamdǝ-tongno-nong-tàruia pǝlǝa mala do-bunomurǝm male ka, Murǝm Josiya túr mǝgilǝgir Shafan, muna-ɓwabura mala Azaliya, mǝkà Meshulam, a ɓala mala Yahweh nǝ cau ama: <verse eid="2KI 22:3" /><verse number="4" style="v" sid="2KI 22:4" />&lt;&lt;Kya ban Hilkiya pǝris mǝgule, banggi wi ɓǝ̀ ɓal boalo mǝnana aɓwe yinǝi a ɓala mala Yahweh sǝ amǝ'ɗenyinǝ kun-nda rambi ka; <verse eid="2KI 22:4" /><verse number="5" style="v" sid="2KI 22:5" />banggi wi ɓǝ̀ pa boale a bu aɓwana mana à tsǝia ace sǝntà-túrô ɓala mala Yahweh ka, ace mǝnana ɓǝà mbwe ka amǝ'túró mana à kǝ pàk túró ace gilǝki abân mana à kiɗiki arǝ ɓala mala Yahweh ka, <verse eid="2KI 22:5" /><verse number="6" style="v" sid="2KI 22:6" />yia amǝ'gbàlì-gìr, andǝ amǝ'ɓǎ, andǝ amǝ'ɓakɓa-tali. Ɗǝm ngga, nea wia ɓǝà paktúró nǝ boale ace kúr agbǝlang nggun, andǝ atali mǝnana à shàrkinia ka ace gilǝki ɓalae. <verse eid="2KI 22:6" /><verse number="7" style="v" sid="2KI 22:7" />Sǝama ɓǝkǝa na ama à nǝ̀ ɗice bǝltakusǝ boalo mǝnana à pea wia ka ɗàng, acemǝnana yia ka, à kǝ paktúró pepè nǝ mǝsǝcau.&gt;&gt;<verse eid="2KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 22:8" />Pǝlǝa Hilkiya, yì pǝris mǝgule banggi Shafan mǝgilǝgir ama, &lt;&lt;Ən kumǝna Malǝmce mala Nggurcau a ɓala mala Yahweh.&gt;&gt; Pǝlǝa Hilkiya pe Shafan malǝmcenî, sǝ ɓallià wia. <verse eid="2KI 22:8" /><verse number="9" style="v" sid="2KI 22:9" />Pǝlǝa Shafan mǝgilǝgir wari aban murǝm, yinǝì murǝm nǝ cau ama, &lt;&lt;Aguro mò twalǝna boalo mǝnana kat à kumi a ɓala mala Yahweh ka, sǝ à pànì a bu amǝtúró, amǝ'ɗenyinǝ agir a ɓala mala Yahweh.&gt;&gt; <verse eid="2KI 22:9" /><verse number="10" style="v" sid="2KI 22:10" />Pǝlǝa Shafan mǝgilǝgir banggi murǝm ama, &lt;&lt;Ɓè malǝmce nia Hilkiya pǝris mǝgule pam ngga.&gt;&gt; Pǝlǝa Shafan mǝgilǝgir ɓal malǝmcenî bwāng, aɓadǝm murǝm.<verse eid="2KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2KI 22:11" />Lang murǝm ok acau mala Malǝmce Nggurcau ka, kara san nggea-daura male. <verse eid="2KI 22:11" /><verse number="12" style="v" sid="2KI 22:12" />Pǝlǝa murǝm banggi Hilkiya pǝris mǝgule, andǝ Ahikam, muna-ɓwabura mala Shafan, andǝ Akbo, muna-ɓwabura mala Mikaya, andǝ Shafan mǝgilǝgir, andǝ Asaya, mǝtúró-ɓadǝm murǝm ama: <verse eid="2KI 22:12" /><verse number="13" style="v" sid="2KI 22:13" />&lt;&lt;Wu kyane, wu ɗibancau a ban Yahweh, acem, sǝ ace aɓwe, sǝ ace Yahuda kat, amur cau mǝnana nda a gilǝe aɓa mǝnia yì malǝmce, mana à kumi ka; acemǝnana, nggea bumlulla-mǝɓike mala Yahweh ka, ndarǝ earki-bǝsa amur sǝm, atàcau mala ɗwanyi okiru mala aká sǝm, mǝnana à kpata agir mǝnana à gilǝia aɓa mǝnia yì malǝmce ka raka; sǝ sǝm ngga, sǝm pàk gìr mǝnana kat bang ama dumǝna púp ɓǝ̀ sǝm pè ka ɗàng.&gt;&gt;<verse eid="2KI 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2KI 22:14" />Nda Hilkiya pǝris mǝgule, andǝ Ahikam, andǝ Akbo, andǝ Shafan, andǝ Asaya, wari ace ɗibancau a ban māɓangnǝa Hulda, mǝnana ndanǝdo a Ɓaria Buban mala Urǝshalima ka. Burí Shallum muna-ɓwabura mala Tikva, mǝkà Harhas ka, nda mǝ'ɗenyinǝ adaura-pǝris. À bangcau nǝ Hulda.<verse eid="2KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 22:15" />Pǝlǝa Hulda banggia wia ama, &lt;&lt;Mǝnia ka, nda cau mǝnana Yahweh, yì Ɓakuli mala Isǝrayila bang ngga: &lt;Wu banggi ɓwabura mǝnana túr wun abanam ngga, ama, <verse eid="2KI 22:15" /><verse number="16" style="v" sid="2KI 22:16" />mǝnia ka, nda cau mǝnana Yahweh bang ngga, ama: Wu sǝni, mǝ ndo mǝ nǝ yinǝ gir'murmwana amur ban mǝnia ka, sǝ amur aɓwana mǝnana à ndanǝdo aɓalǝi ka, kǝla mǝnana à gilǝì aɓa malǝmce mana murǝm mala Yahuda ɓalli ka. <verse eid="2KI 22:16" /><verse number="17" style="v" sid="2KI 22:17" />Mǝnia ka nǝ̀ kumban acemǝnana yia ka, à ginǝkiam, à pàɓoro mala pisǝgir ace loasǝ yele aban aɓea aɓakuli, à lulbumam nǝ ankul mǝnana à pea nǝ buia ka. Acemani ka, bumlulla-mǝɓike mem nǝ̀ earke amur ban mǝnia ka, sǝ pà mǝ nǝ sukki bumam ɗàng.&gt;<verse eid="2KI 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 22:18" />&lt;&lt;Sǝ wu banggi murǝm mala Yahuda mǝnana túr wun ɓǝ̀ wu ɗibancau a ban Yahweh ka, ama, &lt;Mǝnia ka, nda cau mǝnana Yahweh, yì Ɓakuli mala Isǝrayila, bang amur cau mǝnana a ok ka: <verse eid="2KI 22:18" /><verse number="19" style="v" sid="2KI 22:19" />Acemǝnana a ndanǝ ɓabum pwanzali, sǝ a nongsǝmuro aɓadǝm Yahweh, lang a ok cau mǝnana ǝn bang arǝ ban mǝnia andǝ aɓwana mana à ndanǝdo aɓalǝi, ama à nǝ̀ pǝlǝ ɓarwan andǝ suban, sǝ a san daura mô, a ɓua aɓadǝmbam ngga, mim gbal ka ǝn ongŋǝna ɓua mô, mim Yahweh. <verse eid="2KI 22:19" /><verse number="20" style="v" sid="2KI 22:20" />Acemani ka, sǝni, mǝ nǝ nyio, awu nǝ wǔ aɓa rǝpwala, atà akeô, sǝ à nǝ̀ tsǝo a ɓembe mô. Mǝsǝo pà nǝ̀ sǝn agir'murmwana mǝnana mǝ nǝ yinǝia amur mǝnia yì ban ngga ɗàng.&gt; &gt;&gt; Sǝ à nyesǝ cau mǝnia ka aban murǝm.<verse eid="2KI 22:20" /></para>
  <chapter eid="2KI 22" />
  <chapter number="23" style="c" sid="2KI 23" />
  <para style="s">Atúró mǝɓoarne mala Josiya</para>
  <para style="r">(<ref loc="2CH 34:29-33">2 Acau la Apwari 34:29-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 23:1" />Pǝlǝa Murǝm Josiya tunǝ aɓwana-mǝgule mala Yahuda andǝ mala Urǝshalima ɓǝà ramba abaní. <verse eid="2KI 23:1" /><verse number="2" style="v" sid="2KI 23:2" />Sǝ murǝm wari a ɓala mala Yahweh andǝ aburana mala Yahuda kat, andǝ amǝ'do aɓa Urǝshalima atè; apǝris, andǝ amǝ'ɓangnǝa, andǝ aɓwana kat, amuna andǝ aɓwana-mǝgule. Pǝlǝa ɓallià wia, acau kat mala Malǝmce mala Kùrcau, mǝnana à kumi a ɓala mala Yahweh ka, à oè a kiria. <verse eid="2KI 23:2" /><verse number="3" style="v" sid="2KI 23:3" />Pǝlǝa murǝm cam a nkanggari nggun-gbasha [mala murǝm],<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="fq" closed="false">nkanggari nggun-gbasha [mala murǝm] </char><char style="ft" closed="false">ban mala gara mala murǝm ɓǝ̀ nǝ̀ hamnǝ cau ka.</char></note> <note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 11:14">2Amur 11:14</ref></char>.</note> sǝ kùrcau aɓadǝm Yahweh, ama nǝ̀ kpata Yahweh, nǝ̀ bwal anzongcau male, andǝ anggurcau male, andǝ anê male, nǝ ɓabumi kat andǝ yilǝmi kat. Pàcau ama nǝ̀ tsǝk acau mala kùrcau mǝnia ka aɓa túrô, kǝla mǝnana à gilǝì aɓa mǝnia yì malǝmce ka. Sǝ aɓwana kat paɓamuria, à eare à nǝ̀ kùti aɓa mǝnia yì kùrcau ka.<verse eid="2KI 23:3" /></para>
  <para style="s1">Josiya kpata kanigir mala Nggurcau mala Ɓakuli</para>
  <para style="r">(<ref loc="2CH 34:3-7">2 Acau la Apwari 34:3-7</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="2KI 23:4" />Pǝlǝa murǝm pà nzongcau aban Hilkiya pǝris mǝgule, andǝ acili apǝris mana à kwaɗite ka, andǝ amǝ'ɗenyinǝ kun-nda ama, agir mǝnana kat à pea ace peri aban Ba'al, andǝ Ashera, sǝ ace peri aban anleuro mala bumkuli, mǝnana à nda a ɓala mala Yahweh ka, ɓǝà pusǝkia kat a nza, ɓǝà purî ɓala mala Yahweh; sǝ murǝm kya pisǝ agir mǝnia ka kat anzǝm nggea-là Urǝshalima, a ban mǝnana nda tù a ban Ɓangŋaban Kidǝron ngga, sǝ pwan tú mala agir mǝnia à pisǝia ka, umnǝia a Betel. <verse eid="2KI 23:4" /><verse number="5" style="v" sid="2KI 23:5" />Apǝris mala ankúl mǝnana amurǝma mǝdǝmbe mala Yahuda twalia ɓǝà kǝ pàɓoro amur agyangŋan-peri aɓalǝ anggea-là mala Yahuda, andǝ abân mǝnana à kàrì Urǝshalima ka, Murǝm Josiya sulǝia kat; yià andǝ amǝnana à pisǝ aɓoro mala loasǝ yele mǝrǝmɓoarne aban Ba'al, andǝ pwari, andǝ zongŋo, andǝ asabisa, andǝ anlero mǝnana kat a kùli ka. <verse eid="2KI 23:5" /><verse number="6" style="v" sid="2KI 23:6" />Pǝlǝa twal tondong mala Ashera mǝnana a ɓala mala Yahweh ka, umnǝi a Ɓangŋaban Kidǝron, anzǝm nggea-là Urǝshalima, sǝ kya pisǝì kàm. Pǝlǝa goe pǝlǝ muku, sǝ mesǝki tuí amur aɓembe mala aɓwana. <verse eid="2KI 23:6" /><verse number="7" style="v" sid="2KI 23:7" />Sǝ arki akurǝm mǝnana aburana amǝ'gyatarǝu duk kam a ɓala mala Yahweh, a ban mǝnana amamǝna kǝ tāki alagìr-gbarban ace Ashera ka.<verse eid="2KI 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 23:8" />Apǝris mǝnana kat à ndanǝdo aɓalǝ alá mala Yahuda, mǝnana à kǝ pāki aɓoro amur amgbangban-peri arǝ abân mǝno ka, Josiya yinǝia kat a Urǝshalima, sǝ kiɗiki agyangŋan-peri malea, tite a Geba kya bik Biyasheba. Sǝ nggearǝ amgbangban-peri mǝnana a nkanggari bankutio a kun-nggealà [Biyasheba], mǝnana Jesǝwa, nggwamna mala nggea-lê ɓè ka, Josiya bǝbbǝrikia.<verse eid="2KI 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2KI 23:9" />Earî apǝris mala agyangŋan-peri mǝno ɓǝà pàk túró-pǝris amur gyangŋan mala Yahweh mǝnana a Urǝshalima ka ɗàng. Sǝama earia wia ɓǝà li bǝredi mǝnana burè pà arǝì raka, mǝnana à pà ace aɓia apǝris ka.<verse eid="2KI 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 23:10" />Ɗǝm ngga, Murǝm Josiya kiɗiki gyangŋan mala Tofet <note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="fq" closed="false">gyangŋan mala Tofet: </char><char style="ft" closed="false">ban-peri aban nkúl Molek.</char></note> mǝnana a Ɓangŋaban Hinom ngga, ace mǝnana kǝɓwa ɓǝkǝa pà gir'nkila nǝ muna-ɓwabura ko muna-ɓwama male kǝla pàgir mala pisǝe kǝring aban nkúl Molek ɗàng. <verse eid="2KI 23:10" /><verse number="11" style="v" sid="2KI 23:11" />Ɗǝm ngga, pisǝ apǝr<note caller="+" style="f"><char style="fr" closed="false">23:11 </char><char style="fq" closed="false">apǝr </char><char style="ft" closed="false">&lt;&lt;aɓǝ̀nzál mala apǝr&gt;&gt;</char></note> mǝnana amurǝma mǝɗiɗyalni mala Yahuda tamsǝkia a bankutio a ɓala mala Yahweh ace peri aban pwari ka; amǝno yì apǝr mǝnana à camgi a nkanggari kurǝm mala ɓè mǝgulo lullǝi ama Natan-Melek ka, pisǝia. Josiya pǝlǝa pisǝ awaru-pǝr mǝnana à tària ace peri aban pwari ka. <verse eid="2KI 23:11" /><verse number="12" style="v" sid="2KI 23:12" />Agyangŋan mana amurǝma mala Yahuda akdǝmba à ɓakkia a múr-kurǝm mala kurǝm-kuli mala Murǝm Ahaz ka, Murǝm Josiya arkia, sǝ arki agyangŋan mǝnana Murǝm Manasa ɓakkia aɓalǝ apatal ɓari mǝnana a ɓala mala Yahweh ka. Josiya goea à pǝlǝ mukuì sǝ sukki túià a Ɓangŋaban Kidǝron. <verse eid="2KI 23:12" /><verse number="13" style="v" sid="2KI 23:13" />Anzǝm mǝno ka, Murǝm Josiya kiɗiki amgbangban-peri a takuli mala Urǝshalima, nǝban njar-kunmur mala Nkono mala Kiɗiki, yì amgbangban-peri mǝnana Murǝm Solomon akdǝmba pea ace peri aban Ashtarot, gìrɓeami, yì mā-ɓakuli mala amǝ'Sidon, andǝ Kemosh, gìrɓeami, yì ɓakuli mala amǝ'Mowap, andǝ Molek, gìrɓeami, yì ɓakuli mala amǝ'Amon. <verse eid="2KI 23:13" /><verse number="14" style="v" sid="2KI 23:14" />Arki akúnamúrú, mesǝkia mwashat-mwashat, kwarki ɓǝ̀nzál mala Ashera kasǝki, sǝ lúmsǝ́ banì nǝ amú ɓwapǝndǝa.<verse eid="2KI 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2KI 23:15" />A Betel ka, bǝbbǝriki gyangŋan andǝ mgbangban-peri mǝnana Jerobuam muna-ɓwabura mala Nebat pè, sǝ tsǝk Isǝrayila aɓa cauɓikea ka; pisǝ agir mala mgbangban-perini sǝ goea à pǝlǝ muku; pǝlǝa pisǝ ɓǝ̀nzál mala Ashera. <verse eid="2KI 23:15" /><verse number="16" style="v" sid="2KI 23:16" />Lang Murǝm Josiya pǝlǝ rǝì, pelǝban ngga, sǝn aɓembe abanì amur mgbangban. Pǝlǝa pà nzongcau ama ɓǝà pusǝki amú mana aɓalǝia ka, sǝ pisǝia amur gyangŋanì, pǝndǝki ɓǝ̀ pǝlǝ gìrɓeami. Mǝnia ka nda lùmsǝ cau mala Yahweh mǝnana akdǝmba hamnǝi nǝ kún ɓwa mala Ɓakuli mǝnana hamnǝ acau mala agir mǝnia ka.<note caller="+" style="f"><char style="fr" closed="false">23:16 </char><char style="ft" closed="false">Mǝɓangnǝa hamnǝ acau mǝnia ka à malaká ɓǝl Murǝm Josiya ɗàng: </char><char style="xt"><ref loc="1KI 13:2-5">1Amur 13:2-5</ref> </char>.</note><verse eid="2KI 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2KI 23:17" />Pǝlǝa murǝm ɗiban ama, &lt;&lt;Ya tali-ɓembe na mǝno, ǝn nggǝ sǝni ka?&gt;&gt; Aburana mala nggea-lê banggi wi ama, &lt;&lt;Mǝno ka nda ɓembe mala ɓwa mala Ɓakuli, mana pur a Yahuda, sǝ yi hamnǝ acau mala mǝnia yì gìr a pe adyan arǝ gyangŋan mala Betel ka.&gt;&gt;<verse eid="2KI 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 23:18" />Josiya pǝlǝa pa eare ama, &lt;&lt;Wu ɗeki, kǝɓwa ɓǝkǝa je amuí ɗàng.&gt;&gt; Nda sǝ à ɗeki amuí à jea ɗàng, andǝ amu mǝɓangnǝa mana pur a Samariya ka.<verse eid="2KI 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2KI 23:19" />Ɗǝm ngga, aɓala mala amgbangban-peri aban ankúl mǝnana amurǝma mǝɗiɗyalni mala Isǝrayila akdǝmba ɓakia, aɓalǝ anggea-là mala Samariya, sǝ lulbum Yahweh ka, Josiya bǝbbǝrikia kat. Pangnǝia kǝla mǝnana pè a Betel ka.<verse eid="2KI 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 23:20" />Apǝris mala amgbangban-peri mǝnana à nda arǝ abân mǝno ka, Josiya wal-luia kat amur agyangŋan malea, sǝ pisǝ amuia amur agyangŋanì. Pǝlǝa nyare o a Urǝshalima.<verse eid="2KI 23:20" /></para>
  <para style="s">Josiya nyare kwakita Lamsan Yàlîmurû a nggùnì</para>
  <para style="r">(<ref loc="2CH 35:1-19">2 Acau la Apwari 35:1-19</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="2KI 23:21" />Sǝ Murǝm Josiya pà nzongcau aban aɓwe kat, ama: &lt;&lt;Dumǝna púp, wun nǝ̀ pàk lamsan Yàlîmurû aban Yahweh, Ɓakuli ma'wun, kǝla mǝnana à gilǝì aɓa mǝnia yì Malǝmce mala Kùrcau ka.&gt;&gt; <verse eid="2KI 23:21" /><verse number="22" style="v" sid="2KI 23:22" />Murǝm pà mǝnia yì hama ka acemǝnana lamsan mala Yàlîmurû kǝla mǝnia ka, aɓwe pè a kǝ fara ɗàng: ko a bàkú mana akasǝla yálmúr Isǝrayila, ko arǝ anza mala amurǝma mala Isǝrayila andǝ mala Yahuda ɗàng. <verse eid="2KI 23:22" /><verse number="23" style="v" sid="2KI 23:23" />Sǝama, a lum-bwamdǝ-tongno-nong-tàruia pǝlǝa mala do-bunomurǝm mala Josiya ka, à pàk mǝnia yì lamsan mala Yàlîmurû ka ace gusǝlǝ Yahweh, a Urǝshalima.<verse eid="2KI 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2KI 23:24" />Ɗǝm ngga, amǝ'ɗikalú, andǝ amǝ'monzǝo kat, andǝ ankúl mala ɓala andǝ aɓǝ̀nzál peri kat, andǝ agir'ɓeami mǝnana kat à sǝnia aɓa nzali Yahuda andǝ Urǝshalima ka, Josiya twaltea ɗǝɗak. Yì ka, pàk mǝnia ka anggo, ace mǝnana ɓǝ̀ lùmsǝ cau mala agir mǝnana à gilǝia aɓa malǝmce mana Hilkiya pǝris kumi a ɓala mala Yahweh ka. <verse eid="2KI 23:24" /><verse number="25" style="v" sid="2KI 23:25" />Kǝ murǝm pà kàm kǝla Josiya, a dǝmba nǝi, mǝnana pǝlǝ aban Yahweh, nǝ ɓabumi kat, andǝ yilǝmi kat, andǝ rǝcandǝa male kat, nǝ̀ kpata Nggurcau mala Musa puppup ka ɗàng; sǝ kǝ ɓè pà kàm kǝla yì, mǝnana lo anzǝmi ka ɗàng.<verse eid="2KI 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2KI 23:26" />Kat andǝ amani ka, Yahweh pǝlǝ nzǝmi arǝ ukkio mala nggea bumlulla-mǝɓike male ɗàng, yì bumlulla-mǝɓike male mǝnana pì arǝ nzali Yahuda, atàcau mala agir-lulbum mǝnana kat Murǝm Manasa akdǝmba peǎ, sǝ lullabumi nǝia ka. <verse eid="2KI 23:26" /><verse number="27" style="v" sid="2KI 23:27" />Nda sǝ Yahweh bang ama, &lt;&lt;Mǝ nǝ pusǝ Yahuda ɓǝ̀ upì ɓamǝsǝàm, kǝla mǝnana ǝn pusǝ Isǝrayila, nying ɓamǝsǝàm ngga; sǝ mǝ nǝ ɓinǝki Urǝshalima, yì nggea-là mǝnana ǝn tarì, andǝ ɓala mǝnia mǝnana ǝn bangcau amurí ama, &lt;Akano sǝ Lullǝam nǝ̀ pak&gt; ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 12:11">Nggur 12:11</ref>; <ref loc="1KI 9:3">1Amur 9:3</ref>; <ref loc="2KI 21:4">2Amur 21:4</ref></char></note><verse eid="2KI 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2KI 23:28" />Acili agir mǝnana à kumban a do-bunomurǝm mala Josiya, andǝ agir mǝnana kat pàkkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char><verse eid="2KI 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2KI 23:29" />A bàkú mala yálmúrû mala Josiya ka, Firona Neko, murǝm mala Masar puro andǝ amǝ'lwa male aban ká je andǝ murǝm mala Assuriya a Nggeasala Yiufǝretis. Murǝm Josiya andǝ amǝ'lwa male pur'atè à nǝ̀ nggá kumi nǝ munǝo. Sǝ lang à je a Megido ka, Firona Neco wal-luí. <verse eid="2KI 23:29" /><verse number="30" style="v" sid="2KI 23:30" />Amǝtúró male twal luí a Megido aɓa waru-pǝr, à yinǝi a Urǝshalima, sǝ à yi tsǝî a ɓembe-ɓa-tali male. Sǝ aɓwana mala nzalinì twal Jehowahaz muna-ɓwabura mala Josiya, à ɗārǝi, duk murǝm a bancame mala tárrí.<verse eid="2KI 23:30" /></para>
  <para style="s">Yálmúrû mala Jehowahaz a Yahuda</para>
  <para style="r">(<ref loc="2CH 36:2-4">2 Acau la Apwari 36:2-4</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="2KI 23:31" />Jehowahaz ka, ndanǝ apǝlǝa lumi-ɓari-nong-tàrú (23) sǝ duk murǝm. Yálmúr aɓwana a Urǝshalima azongŋo tàrú. Lullǝ nggé nda Hamutal, muna-ɓwama mala Irmya ɓwa Libǝna. <verse eid="2KI 23:31" /><verse number="32" style="v" sid="2KI 23:32" />Yì ka, pàkki agir mǝnana amǝɓike na a ɓadǝm Yahweh ka, kǝla mǝnana kat akê pàk ka.<note caller="+" style="f"><char style="fr" closed="false">23:32 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 21:2-7">2Amur 21:2-7</ref> </char>.</note><verse eid="2KI 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2KI 23:33" />Firona Neco yi gbami Jehowahaz, túrrí a ndàkurban a Ribǝla, a nzali Hamat, ace mǝnana ɓǝkǝa duk murǝm a Urǝshalima raka. Sǝ tsǝk nzali Yahuda ɓǝ̀ mbwe cemi mala bolo-azǝrfa tyang á-tàrú nǝ gbǝman-ine (3,400), andǝ bolo-njengǝlan tyang lumi-tàrú-nong-ine (34). <verse eid="2KI 23:33" /><verse number="34" style="v" sid="2KI 23:34" />Pǝlǝa Firona Neco, tsǝk Eliyakim, ɓè muna-ɓwabura mala Josiya, ɓǝ̀ duk murǝm a kúnì tárrí Josiya, sǝ nggaɗi lullǝ Eliyakim, tunǝi ama, Jehoyakim. Sǝ Jehowahaz ka, Firona Neco twali umnǝi a Masar aɓa nsolo, nda kya paklú kàm ngga. <verse eid="2KI 23:34" /><verse number="35" style="v" sid="2KI 23:35" />Jehoyakim mbwe Firona Neco bolo-azǝrfa andǝ bolo-njengǝlan, kǝla mǝnana tsǝki wi ɓǝ̀ mbwe ka. Sǝama she lang cemina aɓwe a nzalinì ka sǝ kum bolo-azǝrfa andǝ bolo-njengǝlan mǝno. Tsǝk koyan ngga, mbwe gìr mǝnana karǝa arǝ kume male ka.<verse eid="2KI 23:35" /></para>
  <para style="s">Yálmúrû mala Jehoyakim amur nzali Yahuda</para>
  <para style="r">(<ref loc="2CH 36:5-8">2 Acau la Apwari 36:5-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="2KI 23:36" />Jehoyakim ngga, ndanǝ apǝlǝa lumi-ɓari-bwamdǝ-tongno (25), sǝ duk murǝm. Yálmúr aɓwana apǝlǝa lum-nong-mwashat a Urǝshalima. Lullǝ nggé nda Zebida, muna-ɓwama mala Pedaya, ɓwa Ruma. <verse eid="2KI 23:36" /><verse number="37" style="v" sid="2KI 23:37" />Jehoyakim pàkki agir mǝnana amǝɓike na aɓadǝm Yahweh ka, kǝla mǝnana kat akê pàk ka.<verse eid="2KI 23:37" /></para>
  <chapter eid="2KI 23" />
  <chapter number="24" style="c" sid="2KI 24" />
  <para style="s">Aɓiu-mǝbura ak nggea-là Urǝshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 24:1" />A nza mala yálmúrû mala Jehoyakim ngga,<note caller="+" style="f"><char style="fr" closed="false">24:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 36:6">2Acau 36:6</ref>; <ref loc="JER 25:1">Ir 25:1</ref>,<ref loc="JER 25:9">9</ref>; <ref loc="DAN 1:1">Dan 1:1</ref> </char>. </note> Nebukaneza murǝm Babila yi kútí nǝ rǝcandǝa-lwa aɓa nzali Yahuda sǝ e. Murǝm Jehoyakim nongsǝmúrí aɓata Nebukaneza sǝ tsǝì mbwe cemi abaní arǝ apǝlǝa tàrú. Sǝama nǝnzǝ́mò ka, Murǝm Jehoyakim pǝlǝa arǝì, mgbicau arǝì. <verse eid="2KI 24:1" /><verse number="2" style="v" sid="2KI 24:2" />Yahweh pǝlǝa tasǝ amǝ'tǝllìban mala amǝ'Babila,<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JER 32:28">Ir 32:28</ref>,<ref loc="JER 32:29">29</ref>; <ref loc="JER 35:11">35:11</ref></char>.</note> andǝ mala amǝ'Suriya, andǝ mala amǝ'Mowap arǝ Jehoyakim. Tasǝia ɓǝà kiɗiki nzali Yahuda, kǝla mǝnana cau male bang nǝ kún aguro male amǝ'ɓangnǝa ka.<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 20:17">2Amur 20:17</ref>; <ref loc="2KI 21:12-14">21:12-14</ref>; <ref loc="2KI 23:27">23:27</ref> </char>.</note> <verse eid="2KI 24:2" /><verse number="3" style="v" sid="2KI 24:3" />Mbak-kàngkàng Yahweh na, mǝnana bangcau sǝ gìr mǝnia kum nzali Yahuda ka, ace mǝnana nǝ̀ pusǝia ɓǝà purî ɓadǝmbi, atàcau mala acauɓikea mǝnana kat Manasa peǎ ka,<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 21:11">2Amur 21:11</ref>; <ref loc="2KI 23:26">23:26</ref> </char>.</note> <verse eid="2KI 24:3" /><verse number="4" style="v" sid="2KI 24:4" />sǝ ɗǝm ngga ace nkila mala amǝ'kunpwasǝa mǝnana sukkì ka; yì Manasa ka lùmsǝ Urǝshalima nǝ nkila mala amǝ'kunpwasǝa,<note caller="+" style="f"><char style="fr" closed="false">24:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 21:16">2Amur 21:16</ref> </char>.</note> sǝ Yahweh ear ama nǝ̀ twalbani ɗàng.<verse eid="2KI 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2KI 24:5" />Acili agir mǝnana à kumban a yálmúrû mala Jehoyakim, andǝ agir mǝnana kat peǎ ka, à nda aɓa gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="2KI 24:5" /><verse number="6" style="v" sid="2KI 24:6" />Jehoyakim usǝlǝo atà akê. Sǝ muna-ɓwabura male Jehoyacin duk murǝm a bancame male.<verse eid="2KI 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2KI 24:7" />Adyan ngga murǝm Masar nyare purî ɓá nzali male [ace ká lwa] ɗǝm ɗàng, acemǝnana murǝm Babila lina bu-nzali mǝnana nda aɓata murǝm Masar ɗiɗyal ka, twal a myalmúr nzong-nzali Masar aban ká a Nggeasala Yiufǝretis.<verse eid="2KI 24:7" /></para>
  <para style="s">Jehoyacin murǝm Yahuda</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 24:8" />Apǝlǝa mala Jehoyacin na lum-bwamdǝ-tongno-nong-tàrú (18) lang duk murǝm ngga, sǝ yálmúr aɓwana a Urǝshalima azongŋo tàrú. Lullǝ nggé nda Nehushta ɓoarnsarile Elnatan mala Urǝshalima. <verse eid="2KI 24:8" /><verse number="9" style="v" sid="2KI 24:9" />Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, kǝla mǝnana tárrí pàk ka.<verse eid="2KI 24:9" /></para>
  <para style="s">À pwan Isǝrayila à umnǝia <optbreak /> a bǝri-nzali a Babila</para>
  <para style="r">(<ref loc="2CH 36:9">2 Acau la Apwari 36:9</ref>,<ref loc="2CH 36:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="2KI 24:10" />A nza mǝno ka, amǝ'sàrǝ̀ban-lwa mala Murǝm Nebukaneza mala Babila yinǝ munǝo arǝ Urǝshalima sǝ à gumbǝ́lì aɓalǝu.<note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 1:1">Dan 1:1</ref> </char>.</note> <verse eid="2KI 24:10" /><verse number="11" style="v" sid="2KI 24:11" />Nebukaneza murǝm Babila yiu lang amǝ'sàrǝ̀ban-lwa male na ban gumbǝli nggea-là Urǝshalima ka. <verse eid="2KI 24:11" /><verse number="12" style="v" sid="2KI 24:12" />Jehoyacin murǝm mala Yahuda puro, atārǝia andǝ nggè, andǝ amǝtúró male, andǝ amǝtè, andǝ amǝgulo male, andǝ amǝtúró palta male, sǝ à kya ɓun aban murǝm Babila. Sǝ murǝm Babila gbami Jehoyacin bwalban-guro. Agir mǝnia ka, à kumban a tongno-nong-tàruià pǝlǝa mala do-bunomurǝm mala Nebukaneza.<verse eid="2KI 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 24:13" />Kǝla mǝnana Yahweh akdǝmba bang ngga, Nebukaneza pwan agir-gǝna mala ɓala mala Yahweh kat, andǝ agir-gǝna mala palta mala murǝm kat a ban mǝno. Atanggǝla mala bolo-njengǝlan mǝnana kat Murǝm Solomon mala Isǝrayila akdǝmba peǎ ace ɓala mala Yahweh ka,<note caller="+" style="f"><char style="fr" closed="false">24:13 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1KI 7:48-50">1Amur 7:48-50</ref> </char>.</note> kasǝkia mgbeatuk-mgbeatuk. <verse eid="2KI 24:13" /><verse number="14" style="v" sid="2KI 24:14" />Pwan ɓwabundǝa mala Urǝshalima kat,<note caller="+" style="f"><char style="fr" closed="false">24:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 24:1">Ir 24:1</ref></char>.</note> aɓwana á-lum (10,000), umnǝia a bǝri-nzali; kat andǝ amǝgulo, andǝ akanggǝrang aburana kat, andǝ amǝ'túróbù kat, andǝ amǝ'ntùl kat. Nying kǝɓwa ɗàng shé amǝ'tǝ̀r mala nzalinì. <verse eid="2KI 24:14" /><verse number="15" style="v" sid="2KI 24:15" />Umnǝ Jehoyacin a Babila, atārǝia andǝ nggeà murǝm andǝ amāmí, andǝ amǝtúró palta male, andǝ amǝgulo mala nzalinì. Pwania a Urǝshalima sǝ umnǝia a bǝri-nzali a Babila. <verse eid="2KI 24:15" /><verse number="16" style="v" sid="2KI 24:16" />Akanggǝrang aburana kat ka, à nda á-tongno-nong-ɓari (7,000), sǝ amǝ'túróbù andǝ amǝ'ntùl ka, à nda á-mwashat (1,000). Yià kat ka à nda dwat sǝ à kārǝ́na pùr lwa; yià mǝnia ka, murǝm Babila pwania kǝla aguro, umnǝia a Babila. <verse eid="2KI 24:16" /><verse number="17" style="v" sid="2KI 24:17" />Murǝm Babila tsǝk Mataniya, mǝ'eam tár Jehoyacin ɓǝ̀ duk murǝm a bancame mala Jehoyacin, sǝ nggaɗi wi lullǝu ama Zedekiya.<verse eid="2KI 24:17" /></para>
  <para style="s">Yálmúrû mala Zedekiya a Yahuda</para>
  <para style="r">(<ref loc="2CH 36:11-16">2 Acau la Apwari 36:11-16</ref>; <ref loc="JER 52:1-3">Irmya 52:1-3</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 24:18" />Apǝlǝa ɓǝlban mala Zedekiya ka à nda lumi-ɓari-nong-mwashat (21) lang duk murǝm ngga. Yálmúr aɓwana a Urǝshalima arǝ apǝlǝa lum-nong-mwashat (11). Lullǝ nggé nda Hamutal, ɓoarnsarile Irmya ɓwa Libǝna. <verse eid="2KI 24:18" /><verse number="19" style="v" sid="2KI 24:19" />Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, kǝla mǝnana Jehoyakim akdǝmba pàk ka.<verse eid="2KI 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2KI 24:20" />Amǝnia yì agir ka à yi kumban atàcau mala bumlulla mala Yahweh arǝ aɓwana mala Urǝshalima andǝ Yahuda, sǝ a masǝlǝate ka yi pusǝia à purî ɓadǝmbi, ramtea ɓǝà o arǝ anzali mǝnana amalea na raka.<verse eid="2KI 24:20" /></para>
  <chapter eid="2KI 24" />
  <chapter number="25" style="c" sid="2KI 25" />
  <para style="s">Kpa mala Yahuda andǝ o male a bǝri-nzali</para>
  <para style="r">(<ref loc="2CH 36:17-21">2 Acau la Apwari 36:17-21</ref>; <ref loc="JER 52:3-30">Irmya 52:3-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2KI 25:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">25:1 </char>
      <char style="ft" closed="false">Sǝni aɓa: </char>
      <char style="xt">
        <ref loc="JER 21:1-10">Ir 21:1-10</ref>; <ref loc="JER 34:1-5">34:1-5</ref>; <ref loc="EZK 24:2">Ezǝk 24:2</ref></char>.</note>Zedekiya yi mgbicau arǝ Nebukaneza murǝm mala nzali Babila. Nda Nebukaneza wari nǝ amǝ'lwa male kat arǝ Urǝshalima a lumia pwari mala lumia zongŋo, a tongno-nong-inea pǝlǝa mala do-bunomurǝm mala Zedekiya ka. À tsǝki agumli nǝ nza à kàrì nggea-là Urǝshalima, sǝ à eamsǝki nzali arǝ sheran mala nggea-lê, à gumbǝli. <verse eid="2KI 25:1" /><verse number="2" style="v" sid="2KI 25:2" />Anggo sǝ Urǝshalima ueo aɓata gumbǝliban mala lwa ba lum-nong-mwashatia pǝlǝa mala do-bunomurǝm mala Zedekiya. <verse eid="2KI 25:2" /><verse number="3" style="v" sid="2KI 25:3" />A tongno-nong-inea pwari mala inea zongŋo mala mǝno yì pǝlǝa ka, nzal-gula candǝna aɓa nggea-là, girlina malǝna kat. <verse eid="2KI 25:3" /><verse number="4" style="v" sid="2KI 25:4" />Pǝlǝa amǝ'lwa mala Babila arnjar arǝ sheran mala nggea-là ace kutio. Murǝm Zedekiya andǝ amǝ'lwa male kat ka, à earce ama à nǝ̀ purî ɓá nggea-lê ace ɓangŋa, sǝama amǝ'lwa mala Babila na kam à gumbǝli nggea-lê. Nda murǝm andǝ amǝ'lwa male kúndǝô, sǝ lang dù pǝndǝna ka, à pùr nǝ njar kún nggea-là mǝnana a nre ka asheran ɓari, a nkanggari ɓaban-girpwala mala murǝm ngga. À ɓang nǝ njargula ɓawan-pǝɗanban. <verse eid="2KI 25:4" /><verse number="5" style="v" sid="2KI 25:5" />Sǝama amǝ'lwa mala Babila pǝrta Murǝm Zedekiya. À kya kasǝmuri a ɓawanban mala Jeriko. Amǝ'yáltè mesǝ kat à ɗekibaní. <verse eid="2KI 25:5" /><verse number="6" style="v" sid="2KI 25:6" />Amǝ'lwa mala Babila gbami, sǝ à yinǝi aɓadǝm murǝm mala Babila a Ribǝla, ban mǝnana à kasǝî-ɓashi kam ngga. <verse eid="2KI 25:6" /><verse number="7" style="v" sid="2KI 25:7" />À wal-lú amuna-burana mala Zedekiya a ɓadǝmbi, pǝlǝa à pusǝki amǝsǝ Zedekiya, sǝ à kùrrì nǝ ansolo bolo-bángŋá, à umnǝi a nzali Babila.<verse eid="2KI 25:7" /></para>
  <para style="s">Nebukaneza kiɗiki Urǝshalima</para>
  <para style="p">
    <verse number="8" style="v" sid="2KI 25:8" />A tongno-nong-ɓaria pwari mala tongnoia zongŋo, a lum-bwamdǝ-tongno-nong-inea pǝlǝa mala do-bunomurǝm mala Murǝm Nebukaneza murǝm mala Babila ka, Nebuzaradan, mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm mala Babila, yiu a Urǝshalima. <verse eid="2KI 25:8" /><verse number="9" style="v" sid="2KI 25:9" />Yi soa bǝsa pisǝ ɓala mala Yahweh andǝ ɓala-murǝm, andǝ aɓala mǝnana kat aɓa Urǝshalima ka; koya ɓala mǝgule ka pisǝi zuppi a nzali. <verse eid="2KI 25:9" /><verse number="10" style="v" sid="2KI 25:10" />Amǝ'lwa mala amǝ'Babila, mǝnana kat à nda atà mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm ngga, à arki sheran mǝnana gumbǝli Urǝshalima ka, à sukki a nzali. <verse eid="2KI 25:10" /><verse number="11" style="v" sid="2KI 25:11" />Cili ɓwapǝndǝa mǝnana à ueo aɓa nggea-là andǝ amǝ'lwa mala amǝ Yahuda mǝnana à ɓangŋa à nying ban malea, à yi nongsǝmúrià aban murǝm Babila, andǝ acili amǝ'túróbù ka, Nebuzaradan, mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm pwania umnǝia a nzali Babila. <verse eid="2KI 25:11" /><verse number="12" style="v" sid="2KI 25:12" />Kǝ aɓwana mǝnana nyia ka, à nda ka mǝnana tǝ̀r malea woribani ka. Ɗekia ɓǝà ueo a nzali Yahuda, sǝ tsǝia ɓǝà kǝ pak túró arǝ aɓaban, sǝ ɓǝà kǝ ɗenyinǝ anggun anap.<verse eid="2KI 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2KI 25:13" />Anggun-gbasha mala bolo-bángŋá mǝnana a ɓala mala Yahweh, andǝ awaru-ramggite mala bolo-bángŋá, andǝ kaɓa-nkenye bolo-bángŋá, yì &lt;&lt;Nggeamùr&gt;&gt; mǝnana a ɓala mala Yahweh ka, amǝ'lwa mala amǝ'Babila arkia mwashat-mwashat, sǝ à pwan a'arkina bolo-bángŋe à umnǝia a Babila. <verse eid="2KI 25:13" /><verse number="14" style="v" sid="2KI 25:14" />Sǝ à pwan ankwaring-bolo, andǝ ashebǝl, andǝ ashirkǝm, andǝ atasau mala loasǝ yele mǝ'rǝmɓoarne, andǝ atanggǝla mǝnana kat apǝris pàngŋǝ̀nà-túró nǝia aɓa ndà-peri ka. À pwania kat. <verse eid="2KI 25:14" /><verse number="15" style="v" sid="2KI 25:15" />Ɗǝm ngga, atasau-bǝsa andǝ amuna-nkenye mǝnana à peǎ nǝ bolo-njengǝlan andǝ bolo-azǝrfa ka, Nebuzaradan mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm pwania umnǝia. <verse eid="2KI 25:15" /><verse number="16" style="v" sid="2KI 25:16" />Bolo-bángŋá mǝnana à pàngŋǝ̀nà agir mǝnia nǝi, yì anggun-gbasha ɓari, andǝ kaɓa-nkenye mana à tunǝi ama &lt;&lt;Nggeamùr,&gt;&gt; andǝ awaru-ramggite, amǝnana Murǝm Solomon akdǝmba peǎ ace ɓala mala Yahweh ka, nda kpǝm, à gandǝnǝ karǝ dǝmbǝrya male ɗàng. <verse eid="2KI 25:16" /><verse number="17" style="v" sid="2KI 25:17" />Komǝye atà anggun-gbasha mǝnia ɓari ka, dāh'rya male na ɓakusǝu tongno-nong-ɓari. Sǝ gumtǝli bolo-bángŋá a ɓong koya nggun-gbasha mǝnia ka, dāh'rya male na ɓakusǝu ine nǝ gauwa-tsùrú. Sǝ koya gumtǝli ka, à mbàkì rǝì nǝ zanzǝa ndāmbú bolo-bángŋá, sǝ à kàrì nǝ atǝkrǝk mala anlang mala aɓǝla-mɓǝring bolo-bángŋá.<verse eid="2KI 25:17" /></para>
  <para style="s">À pwan amǝ Yahuda à umnǝia a nzali Babila</para>
  <para style="p">
    <verse number="18" style="v" sid="2KI 25:18" />Amur mǝno ka, Nebuzaradan, mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm bwal Serayia pǝris mǝgule, andǝ Zafaniya pǝris mǝnana kwaɗita mǝdǝmbe ka, sǝ aɓwana tàrú amǝ'ɗenyinǝ akunkurǝm mala Ndàmǝgule, bwalia kat kùria. <verse eid="2KI 25:18" /><verse number="19" style="v" sid="2KI 25:19" />Aɓalǝ aɓwana mǝnana à ueo a ban sǝmbǝrǝa aɓa nggea-là ka, bwal mǝ'sàrǝ̀ban mala amǝ'lwa mala amǝ Yahuda, andǝ aɓwana tongno amǝ'pa kwarkiru aban murǝm. Nyare bwal mǝgilǝgir mala mǝ'sàrǝ̀ban mala amǝ'lwa, yì ɓwa mǝnana nda mǝ'tunǝ aburana ɓǝà pur lwa ka; andǝ aɓea aɓwana amǝgulo lumi-tongno-nong-mwashat mǝnana à kumia aɓa nggea-là ka; yia kat ka, bwalia kùria. <verse eid="2KI 25:19" /><verse number="20" style="v" sid="2KI 25:20" />Yì Nebuzaradan mǝ'sàrǝ̀ban amur amǝ'yáltà murǝm ngga, warinǝ aɓwana mǝnia kat ka, aban murǝm mala Babila a Ribǝla <verse eid="2KI 25:20" /><verse number="21" style="v" sid="2KI 25:21" />a bu-nzali Hamat. Akano ka murǝm mala Babila tsǝa à wal-luia kat. Anggo sǝ à pusǝ aɓwana mala Yahuda nǝ rǝcandǝa aɓa nzali malea, à umnǝia a bǝri-nzali.<verse eid="2KI 25:21" /></para>
  <para style="s">À tsǝk Gedaliya duk nggwamna mala Yahuda</para>
  <para style="p">
    <verse number="22" style="v" sid="2KI 25:22" />Nebukaneza murǝm mala Babila twal Gedaliya muna-ɓwabura mala Ahikam, mǝkà Shafan, ɓǝ̀ duk nggwamna amur aɓwana mǝnana à ɗekia ɓǝà ueo aɓa nzali Yahuda ka.<note caller="+" style="f"><char style="fr" closed="false">25:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 39:14">Ir 39:14</ref>; <ref loc="JER 40:7-9">40:7-9</ref></char></note> <verse eid="2KI 25:22" /><verse number="23" style="v" sid="2KI 25:23" />Adyan ngga lang amǝgulo-lwa kat mala Yahuda [mǝnana à nda ban sǝmbǝrǝa a ɓawan] andǝ aburana malea okcau ama, murǝm mala Babila tsǝ̀ngŋǝ̀nà Gedaliya nda nggwamna ka, à yiu andǝ aburana malea aban Gedaliya a Mizpa; à nda ka Ishmayel muna-ɓwabura mala Netaniya, andǝ Johanan muna-ɓwabura mala Kareya, andǝ Serayia muna-ɓwabura mala Tanhumet ɓwa Netofa, andǝ Ja'azaniya muna-ɓwabura mala ɓwa Bet-Ma'aka, andǝ aburana malea kat. <verse eid="2KI 25:23" /><verse number="24" style="v" sid="2KI 25:24" />Gedaliya kánbiagir, yia andǝ aburana malea ama, &lt;&lt;Cè ɓangciu pàkka wun arǝ amǝgulo-lwa mala amǝ'Babila ɗàng. Wu do aɓa nzalinì sǝ wu nongsǝmúr wun aɓata murǝm Babila, sǝ koman ngga nǝ̀ gingga wun a kǝkarì.&gt;&gt;<verse eid="2KI 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2KI 25:25" />Sǝama aɓa tongno-nong-ɓaria zongŋo ka, Ishmayel muna-ɓwabura mala Netaniya, mǝkà Elishama, mǝnana nda a tau-murǝm ngga, yiu andǝ aburana male lum, à yi wal-lú Gedaliya, andǝ aɓea amǝ'Yahudi andǝ amǝ'Babila mǝnana à nda atè a Mizpa ka. <verse eid="2KI 25:25" /><verse number="26" style="v" sid="2KI 25:26" />Pǝlǝa aɓwe kat, muntulo andǝ ɓwamǝgule, andǝ amǝgulo-lwa à lo à o a Masar, acemǝnana ɓangciu bwalia arǝ gìr mǝnana amǝ'Babila nǝ̀ yia pàk ka.<verse eid="2KI 25:26" /></para>
  <para style="s">À panzǝ Jehoyacin a ndàkurban a Babila</para>
  <para style="p">
    <verse number="27" style="v" sid="2KI 25:27" />A lumi-tàrú-bwamdǝ-tongno-nong-ɓaria (37) pǝlǝa anzǝm umnǝ Jehoyacin murǝm mala Yahuda a bǝri-nzali ka, Murǝm Evil-Merodak mala nzali Babila eau a buno-murǝm mala amǝ'Babila. Yì ka, lǝmdǝì Jehoyacin murǝm mala Yahuda pěmǝɓoarne. A lumi-ɓari-bwamdǝ-tongno-nong-ɓaria (27) pwari mala lum-nong-ɓaria zongŋo mala pǝlǝa mǝnana tinata yálmúrû nǝi ka, panzǝ Jehoyacin pusǝì a ndàkurban. <verse eid="2KI 25:27" /><verse number="28" style="v" sid="2KI 25:28" />Bangcau nǝi aɓa ɓukɓuka, sǝ pe wi bancame amur abancame mala acili amurǝma mǝnana à nda andǝi a nzali Babila ka. <verse eid="2KI 25:28" /><verse number="29" style="v" sid="2KI 25:29" />Acemani ka, earî Jehoyacin ɓǝ̀ swar adaura-ndàkurban mǝnana arǝì ka, ɓǝ̀ oasǝ abǝsa daura mǝɓoarne mǝnana pe wi ka. Sǝ earî Jehoyacin ɓǝ̀ kǝ lili a kpamgbang-ligirlina mala murǝm bà cili do-yilǝmu male. <verse eid="2KI 25:29" /><verse number="30" style="v" sid="2KI 25:30" />Ɗǝm ngga aɓa cili do-yilǝmu mala Jehoyacin kat ka, murǝm mala Babila kǝ pe wi boalo koya pwari, ace mǝnana ɓǝ̀ kúr gìr mǝnana pàktǝle ka.<verse eid="2KI 25:30" /></para>
  <chapter eid="2KI 25" />
</usx>