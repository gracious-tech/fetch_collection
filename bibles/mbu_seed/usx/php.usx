<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Mbula</book>
  <para style="h">Amǝ Filipi</para>
  <para style="toc3">Filp</para>
  <para style="toc2">Amǝ Filipi</para>
  <para style="toc1">Amǝ Filipi</para>
  <para style="mt2">Cautera mala Bulǝs aban ká a ban</para>
  <para style="mt1">AMƏ FILIPI</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Cautera mala Bulǝs aban ká a ban Amǝ Filipi </char> ka, Bulǝs nǝ̀ gilǝì ace ikǝlisiya mana a Filipi, a bàkú mana yì ka, nda aɓa kùrban ngga. A bàkú mǝno ka aɓea amǝtúró kwaɗi mǝnana à earnǝ kanigir male raka à nda aban soaki ɓabumi, sǝ yì ka, nda aɓa bumkiɗikea ace kanigir nyir mǝnana ndakam aɓa ikǝlisiya a nggea-là Filipi ka. Kat andǝ amǝno ka cau ɓá cauterǝa man ngga, lùmsǝ nǝ bumpwasǝa andǝ ɓabum candǝa mǝnana kǝ̀ paɓamuru mǝ'kǝ̀rkǝ́r nì mala Bulǝs a ban Yesu Kǝrǝsti nda ɓǝ̀rɓǝ̀r nǝ̀ gandǝ mǝngge ka.</para>
  <para style="ip">Bulǝs tite nǝ pak yàwá a ban amǝkwaɗi mala amǝ Filipi ace ɓoro mǝnana à túrì wi ban nǝi ɓǝ̀ pakki wi gbasha aɓa tǝle male ka. Kat andǝ atanni male ka, ɓak ɓabumia ɓǝà kum mǝsǝkang-kangŋa aɓalǝ atanni malea. Ɓuakia rǝia ɓǝà kum ulang ɓealu mala nongsǝmúrû mala Yesu, ɓǝà kǝa earî ɓabum mala earce ɓamur rǝu andǝ twàlɓamúrû ɓǝ̀ gingnǝia ɗàng. Kasǝ ɓālǝia ama do malea aɓa kpapi andǝa Kǝrǝsti Yesu ka, ɓoro mala ɓwamuru mala Ɓakuli na abania ace paɓamuru malea; pa ace kpata Nggurcau mala amǝ Yahudi ɗàng. Gilǝ cau amur banɓoarnado andǝ dorǝpwala mǝnana Ɓakuli kǝ pe aɓwana mǝnana à kpapi múrià andǝa Kǝrǝsti ka.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Makkun<char style="ior"><ref loc="PHP 1:1-11">1:1-11</ref> </char></para>
  <para style="io1">Aɓealu mǝnana Bulǝs kum ɓamúrì aɓalǝia ka<char style="ior"><ref loc="PHP 1:12-26">1:12-26</ref> </char></para>
  <para style="io1">Do aɓa Kǝrǝsti<char style="ior"><ref loc="PHP 1:27-2:18">1:27--2:18</ref> </char></para>
  <para style="io1">Atúró mǝnana à ndakam ace Timoti andǝ Apafuroditus ka<char style="ior"><ref loc="PHP 2:19-30">2:19-30</ref> </char></para>
  <para style="io1">Nunkiru arǝ aɓibura andǝ agir mur'mwana<char style="ior"><ref loc="PHP 3:1-4:9">3:1--4:9</ref> </char></para>
  <para style="io1">Bulǝs andǝ agyajam male amǝ Filipi<char style="ior"><ref loc="PHP 4:10-20">4:10-20</ref> </char></para>
  <para style="io1">Masǝlǝata cau<char style="ior"><ref loc="PHP 4:21-23">4:21-23</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="s">Makkun mala Bulǝs andǝ Timoti</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />Cauterǝa mǝnia ka, pur nǝban Bulǝs andǝ Timoti, aguro mala Kǝrǝsti Yesu.</para>
  <para style="p" vid="PHP 1:1">Aban ká a ban aɓwana amǝ fele mala Ɓakuli a Filipi, yia mǝnana à nda aɓa dotarǝu andǝa Kǝrǝsti Yesu ka, kat andǝ aɓwana-mǝgule andǝ amǝ'bwalturo ɓá ndahiwi.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 16:12">Atúró 16:12</ref></char>.</note><verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />Ɓǝ̀ Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti, pa wun ɓwamuru andǝ dorǝpwala.<verse eid="PHP 1:2" /></para>
  <para style="s">Yàwá andǝ hiwi mala Bulǝs</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />Ɓǝ̀ aya pwari sǝ ǝn ɗenyinǝ wun ngga, ǝn nggǝ pakki Ɓakuli mem yàwá. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />Hiwi mem ace wun kat ko aya pwari ka, ǝn nggǝ pê nǝ bumpwasǝa, <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />acemǝnana wu pam gbasha aɓa hamnǝ Cau Amsǝban mala Kǝrǝsti, twalo a bu-pwari mǝnana wu tita oe ka, yi puro adyan. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />Mim ngga, mǝ ndanǝ makɓalǝu ama Ɓakuli mǝnana tita mǝnia yì túró mǝɓoarne aɓalǝ wun ngga, nǝ̀ lidǝmba nǝi aban ká masǝlǝe a Pwari mǝnana Kǝrǝsti Yesu nǝ̀ nyar nǝi ka.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 1:8">1Kor 1:8</ref></char>.</note><verse eid="PHP 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 1:7" />Ɓǝ̀ ǝn twal wun kat anggo ka, ǝn ɓwarki ɗang, acemǝnana ɓabumam nda arǝ wun. Wun kat ka wu nda atàm, wu nda arǝ bwalàm arǝ mǝnia yì túró Ɓakuli pam aɓa ɓwamuru male ka, kat aɓa kùrban mem, andǝ bǝl ɓá Cau Amsǝban, andǝ lǝmdǝì aɓwana mǝsǝcau mǝnana aɓalǝi ka. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />Ɓakuli súrǝ́nà rǝ lime mala earcearǝu mǝnana mǝ ndanǝi ace wun, andǝ nzal wun mǝnana kat ǝn nggǝ oe, nǝ ulang earceban mǝnana Kǝrǝsti Yesu ndanǝi ace wun ngga.<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />Sǝ hiwi mem ngga, nda mǝnana ama earcearǝu ma'wun ɓǝ̀ lidǝmba nǝ gulo, sǝ ɓǝ̀ wu lùmsǝ nǝ súrǝè andǝ bwaltagir mǝlime. <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />Acemǝnana ǝn nggǝ earce ama, ɓǝ̀ wu bwalta gìr mǝnana ɓoaro kutibanì wun nǝ̀ twal ka, sǝ anggo ka wun nǝ̀ dukdo ɓoarnsari andǝ ɗwanyicau-arǝǔ, ace Pwari nyare mala Kǝrǝsti. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />Wu lùmsǝ nǝ aɓealu mala docauɓoarna, mǝnana Yesu Kǝrǝsti pea aɓalǝ wun ngga. Mǝnia ka, nǝ̀ pè Ɓakuli gulo andǝ ɓwangsǝban.<verse eid="PHP 1:11" /></para>
  <para style="s">Banɓoari Bulǝs ama à hamǝna <optbreak /> nǝ cau mala Yesu</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />Ado ka ǝn nggǝ earce ɓǝ̀ wu sǝlǝa, wun amǝ'eamrǝarǝu, ama agir mǝnana à kumam kani ka, à nda à tsǝk Cau Amsǝban akiban ngga. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />Àkǝ̀ cè sǝ aɓwana mǝnana akani, andǝ amǝ'yál palta kat ka, à sǝlǝ ama mǝ nda aɓa nsolo ace Kǝrǝsti.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 28:30">Atúró 28:30</ref></char>.</note> <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />Sǝ ace kùro mǝnana à kùram a ndàkurban ngga, bangula amǝ'eamrǝarǝu mǝnana akani ka, à kum ɓabumcandǝa sǝ à bang cau mala Ɓakuli nǝ rǝcandǝa, ɓangciu pà kàm ɗàng.<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />Mǝsǝcau na ama aɓea ɓwana kǝ̀ hamnǝ cau mala Kǝrǝsti ace mwararǝu andǝ mɓali, sǝ aɓea ka, à kǝ hamnǝi nǝ ɓabum mǝɓoarne. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />Amǝnia yia ɓwana nǝnzǝ́mò ka, à kǝ hama ace earcearǝu mǝnana à ndanǝi arǝàm ngga. Acemǝnana à sǝlǝna ama Mǝtalabangŋo twalam ace bǝl ɓá Cau Amsǝban. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />Aɓea mǝno ka, à kǝ hamnǝ cau mala Kǝrǝsti nǝ mǝsǝcau ɗàng, à kǝ hamnǝi nǝ mwararǝu, à kǝ sǝni kǝla à nǝ̀ tsǝa ɓǝ̀ rǝam kwanam aɓa kùrban mǝnana mǝ ndakam ngga. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />Sǝ mǝno ka kiɗiki kǝgìr ɗàng! Ko ɓǝ̀ nda aɓa mǝsǝcau ko aɓa nyir ka, à hamǝna nǝ Kǝrǝsti, sǝ aɓa mǝno ka ǝn nggǝ pak banɓoarnado.</para>
  <para style="p" vid="PHP 1:18">E, sǝ mǝ nǝ lidǝmba nǝ pak banɓoarnado, <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />acemǝnana ǝn sǝlǝna ama nǝ ahiwi ma'wun, andǝ gbasha mǝnana Bangŋo mala Yesu Kǝrǝsti pam ngga, agir mǝnana à kumam ngga, à nǝ̀ nggá duk panzǝban mem. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />Ən nggǝ sǝn dǝmba nǝ tsǝkɓalǝu ama pà mǝ nǝ nu kǝsǝkya ɗang ko bǝti. A kúnì ka mǝ nǝ kum mǝsǝkang-kangŋa pepè, acemǝnana ado, kǝla mǝnana a koya pwari ka, Kǝrǝsti nǝ̀ kum gulo a ɓalǝam, ko nǝ yilǝmu ko aɓa lú. <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />A banam ngga, do nǝ yilǝmu ka nda ace Kǝrǝsti, sǝ ɓǝ̀ ǝn wu ka, ɓoaro kutibanì.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 2:20">Gal 2:20</ref></char>.</note> <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />Sǝama ɓǝ̀ ǝn dum nǝyilǝmu a nggūrǝu ka, mǝ nǝ pak atúró mǝɓoarne kpǝm ace Kǝrǝsti. Mim ado ka, mǝsǝcau, ǝn súrǝ̀ ko mǝ ye nda ɓoaro kútì ɓì ka ɗàng. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />Ɓabumam gau ɓari: Eare mem ngga, mǝ nǝ o mǝ nǝ nggá do sǝnǝa Kǝrǝsti, acemǝnana mǝnia ka nda nǝ̀ ɓoaram nǝ̀ kutibanì ka. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />Sǝ ace wun ngga, ndanǝ ɓoaro ɓǝ̀ ǝn lidǝmba nǝ yilǝmu a nggūrǝu. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />Sǝ acemǝnana ǝn earǝna nǝ mǝno ka, ǝn sǝlǝna ama mǝ nǝ lidǝmba nǝ do nǝ yilǝmu ace mǝnana ɓǝ̀ ǝn duk gbasha ma'wun kat, ɓǝ̀ wu gulo, sǝ wu kum banɓoarnado mala paɓamuru. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />Sǝ ɓǝ̀ ǝn yina a ban wun ɗǝm ngga, wun nǝ̀ nggori nǝ Kǝrǝsti Yesu kǝ̀rkǝ́r ace gir mǝnana kǝ pè a ɓalǝam ngga.<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />Ado ka, gir mǝnana ɓoaribanì ka, nda mǝnana ama wu do kǝla aɓwana mala Kǝrǝsti, nǝ bwal ɓamur rǝ wun aɓa njar mala Cau Amsǝban. Sǝ ko ɓǝ̀ ǝn yiu ɗǝm a sǝn wun, ko ǝn yiu raka, mǝ nǝ ok ce came ma'wun kàngkàng aɓa Bangŋo andǝ ɓabum mǝ'mwashati andǝ ɓariki a tarǝ wun ace paɓamuru ma'wun arǝ Cau Amsǝban. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />Wu kǝa dum nǝ ɓangciu a ɓadǝm aɓi wun amǝbura ɗang. Mǝno ka, nda nǝ̀ lǝmdǝia wia ama à nǝ̀ nggá kiɗiki, sǝ wun ngga wu nǝ̀ àwá. Mǝnia ka nda pe mala Ɓakuli. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />Acemǝnana dǝmbu mana wu kùmô arǝ pakki Kǝrǝsti túró ka, pà ace paɓamuru nǝmurǝì a baní ɗàng, nda gbal acemǝnana ama wu nǝ̀ nu tanni ace ka. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />Mǝnia yì wara ka sǝm nda atè sǝnǝa wun. Wu sǝnǝna ɓariki mem, sǝ wu ongŋǝna ce mǝno ado mǝ nda aɓalǝi ka.<note caller="+" style="f"><char style="fr" closed="false">1:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 16:19-40">Atúró 16:19-40</ref></char>.</note><verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">Nyesǝ ɓamuru kǝla mala Kǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />Ado ka, ɓakɓabum nda kam aɓa Kǝrǝsti, sǝ girikiban nda kam aɓa earcearǝu male, sǝ Bangŋo mala Ɓakuli ka, kǝ yinǝ dotarǝu mwashat a rǝarǝu. Ɓakuli pana wun sǝn mǝsǝswatǝr mala rǝarǝu andǝ lǝmdǝ pe mǝɓoarne. <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />Ace mani ka, wu ciem ɓǝ̀ banɓoarnado mem lùmsǝo! Wu earnǝ rǝarǝ wun. Wu lǝmdǝià rǝ wun earcearǝu. Wu do aɓa kpapi ɓamuru aɓa ɗenyicau ma'wun, kǝla wu nda mwashat ɓǝ̀rɓǝ̀r. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />Gìr mǝnana kat wun nǝ̀ pè ka, wu kǝa pe nǝ earce-ɓamuru, ko twàlɓamúrû ɗang; wu nongsǝ ɓamur rǝ wun, wu twal aɓi wun kǝla à kútì wun. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />Wu tsǝkir aɓwana kǝla mǝnana wun nǝ̀ tsǝkir ɓamur rǝ wun ngga.<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 12:10">Rom 12:10</ref>; <ref loc="ROM 15:1-2">15:1-2</ref></char>.</note><verse eid="PHP 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />Ɓǝ̀ ɓabum wun pa kǝla mala Kǝrǝsti Yesu:<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />Kat andǝ mani ama nda</para>
  <para style="q2" vid="PHP 2:6">mwashat andǝ Ɓakuli ka,</para>
  <para style="q1" vid="PHP 2:6">twali púp ama nǝ̀ karǝ rǝì</para>
  <para style="q2" vid="PHP 2:6">arǝ Ɓakuli ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 1:1">Yoh 1:1</ref></char>.</note><verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />Yàle yì ka, sukki agir kat,</para>
  <para style="q2" vid="PHP 2:7">nyesǝ ɓamúrì kǝla</para>
  <para style="q1" vid="PHP 2:7">kǝgìr ɗàng,</para>
  <para style="q2" vid="PHP 2:7">sǝ pa ɓamúrì kǝla guro,</para>
  <para style="q1" vid="PHP 2:7">yi pa kǝla ɓwapǝndǝa</para>
  <para style="q2" vid="PHP 2:7">aɓa nggūrǝu.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 11:29">Mat 11:29</ref>; <ref loc="MAT 20:28">20:28</ref></char>.</note><verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />Sǝ lang pusǝna rǝì kǝla</para>
  <para style="q2" vid="PHP 2:8">ɓwapǝndǝa aɓa nggūrǝu ka,</para>
  <para style="q1" vid="PHP 2:8">yi nongsǝ muri</para>
  <para style="q2" vid="PHP 2:8">kǝ oki Ɓakuli kiru</para>
  <para style="q1" vid="PHP 2:8">bà lú, nggearǝ lú mana</para>
  <para style="q2" vid="PHP 2:8">amur nggun-gangndǝi<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="fq" closed="false">lú mana amur nggun-gangndǝi: </char><char style="ft" closed="false">ko &lt;&lt;ulang lú mǝnana lú súban na ka.&gt;&gt;</char></note> ka!<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 8:9">2Kor 8:9</ref>; <ref loc="HEB 5:8">Ib 5:8</ref></char>.</note><verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />Ace mani ka,</para>
  <para style="q2" vid="PHP 2:9">Ɓakuli gusǝlǝi,</para>
  <para style="q1" vid="PHP 2:9">tsǝì a bancame mǝnana kútì</para>
  <para style="q2" vid="PHP 2:9">aban kat ka.</para>
  <para style="q1" vid="PHP 2:9">Sǝ pe wi lullǝu mana</para>
  <para style="q2" vid="PHP 2:9">kàrmúr alullǝu kat,<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 10:9">Rom 10:9</ref>; <ref loc="ROM 14:9">14:9</ref>; <ref loc="EPH 1:20-21">Afi 1:20-21</ref></char>.</note><verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />ace mǝnana nǝ lullǝ</para>
  <para style="q2" vid="PHP 2:10">Yesu ka, koya nkūnu,</para>
  <para style="q1" vid="PHP 2:10">mala agir mana a kùli,</para>
  <para style="q2" vid="PHP 2:10">andǝa mana a nzali,</para>
  <para style="q1" vid="PHP 2:10">andǝa mana a tà-nzali ka,</para>
  <para style="q2" vid="PHP 2:10">à nǝ̀ kūndǝǒ.<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 45:23">Isha 45:23</ref>; <ref loc="ISA 49:18">49:18</ref></char>.</note><verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />Sǝ koya lasǝu ka,</para>
  <para style="q2" vid="PHP 2:11">nǝ̀ bang bwāng ama,</para>
  <para style="q1" vid="PHP 2:11">&lt;&lt;Yesu Kǝrǝsti ka</para>
  <para style="q2" vid="PHP 2:11">Mǝtalabangŋo na,&gt;&gt;</para>
  <para style="q1" vid="PHP 2:11">ace gusǝlǝ Ɓakuli Tárrú.<verse eid="PHP 2:11" /></para>
  <para style="s">Lǝmdǝ tǎlaban ace Kǝrǝsti</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />Wun agyajam mem mǝnana ǝn earkiyi acea raka, mǝnana mǝ ndá aban wun ngga, wu kǝ ok kiru pwari-pwari. Sǝ ado mǝnana ǝn pâ aban wun raka, ɓoaro ɓǝ̀ okiru ma'wun ɓǝ̀ kútì mǝno. Wu pak túró mala amsǝban ma'wun nǝ ɓangciu andǝ rǝɓǝla. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />Ɓakuli ka, nda rǝ pak túró aɓalǝ wun, ɓǝ̀ pà wun rǝcandǝa andǝ ɓabum mala pak gìr mǝnana nǝ̀ pwasǝbumi ka.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 15:10">1Kor 15:10</ref></char>.</note><verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />Wu pusǝ nggwani andǝ makgìr aɓalǝ agir mǝnana kat wu pakkiyi ka. <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />Anggo ka, wun nǝ̀ duk amuna mala Ɓakuli, amǝ ɗwanyicau-arǝǔ, amǝ ɓabum ɓoarnsari, andǝa mǝnana à pà nǝ̀ kum kǝ mǝɓane a rǝia raka. Wun nǝ̀ dukdo anggo aɓalǝ aɓwana mala nza mǝ ɗwanyi mǝsǝcau andǝ mǝ kpata njar kiɗiki, mǝnana wun nǝ̀ nggǝ tǎ aɓalǝi kǝla anlero aɓa ɓanza ka.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:5">Nggur 32:5</ref>; <ref loc="MAT 5:45">Mat 5:45</ref>,<ref loc="MAT 5:48">48</ref></char>.</note> <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />Sǝ aɓa doe anggo ɓǝ̀ wu kǝ bwal kàngkàng arǝ cau mǝnana pākiyi yilǝmu ka. Ɓǝ̀ wu kǝ pa anggo ka, a pwari mǝnana Kǝrǝsti nǝ̀ nyar nǝi ka, mǝ nǝ nggori nǝ wun, sǝ mǝ nǝ sǝlǝ gbal ama túró mem andǝ ɓariki mem ngga, à pà ɓà ɗang. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />Paɓamuru andǝ atúró ma'wun aɓa kpata Mǝtalabangŋo ka, à ndà kǝla pa ɓoro a baní. Sǝ ko ɓǝ̀ yi do ama à nda rǝ ɗārǝ́ yilǝmem kǝla gìr-ɗārǝa amur mǝnia yì ɓoro mala paɓamuru ma'wun ngga, bumam nǝ̀ pwasǝo, sǝm nǝ̀ pak banɓoarnado a tarǝ sǝm kat. <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />Wun gbal ka, ban nǝ̀ ɓoara wun, wun nǝ̀ pakkiɗire atàm.<verse eid="PHP 2:18" /></para>
  <para style="s">Bulǝs ɓwangsǝ Timoti <optbreak /> andǝ Apafuroditus</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />Ɓǝ̀ Mǝtalabangŋo Yesu ear ka, mǝ ndanǝ tsǝkɓalǝu ama mǝ nǝ tasǝta Timoti aban wun, adyan tù, ace mǝnana ɓǝn yi kum ɓakɓabum arǝ cau mǝnana mǝ nǝ yia oè amur wun ngga. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />Ən panǝ kǝɓwa kǝla yì, Timoti, mǝnana kǝ tsǝkir wun pepe aɓa mǝsǝcau ka ɗàng. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />Koyan ngga, gìr mǝnana ɓabumi earkiyi ce ka nda pakkiyi ka, à tsǝkir túró mala Yesu Kǝrǝsti ɗàng. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />Sǝ Timoti ka, wu sǝlǝna ama lǝmdǝna ɓamúrì ama kārǝ́na ɓwa. Pàngŋǝ̀nà túró atàm kǝla muna andǝ tárrí. Yì ka, bwalàm nggàm aɓa túró hamnǝ Cau Amsǝban. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />Ace mani ka, mǝ nda rǝ tsǝkɓalǝam ama ɓǝ̀n súrǝ́nà rǝgir mǝnana mǝ nda aɓalǝi ka, mǝ nǝ túrí a ban wun. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />Mǝ ndanǝ tsǝkɓalǝu arǝ Mǝtalabangŋo ama mim nǝ nggearǝam ngga mǝ nǝ ká a ban wun, banì pà nǝ̀ sau ɗang.<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />Ən sǝni, ndanǝ ɓoaro ɓǝ̀n nyesǝa wun Apafuroditus, mǝ'eambam, ɓiam mǝtúró andǝ ɓiam soje. Yì ɗǝm ngga nda ɓwa mǝnana wu túrí ɓǝ̀ tsǝkiram aɓa dotǝle mem ngga. <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />Ado ka, rǝì kǝ ɓǝla ace sǝn wun. Banɓoari wi ɗàng, mǝnana sǝlǝ ama wu ongŋǝna ce rǝkwana male ka. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />Aɓa mǝsǝcau ka, rǝì kwani kǝ̀rkǝ́r, yàle ue bǝti ɓǝ́ wuna. Sǝ Ɓakuli ka, sǝn mǝsǝswatǝr male andǝ mem gbal, sǝ amsǝi, ace mǝnana bumkiɗikea mem ɓǝ̀ kǝa gul kǝ̀rkǝ́r ɗàng. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />Bumam kǝ pi ɓǝ̀n tasǝa wun tè ɗǝm, acemǝnana ǝn sǝlǝna ama ɓǝ̀ wun sǝni ɗǝm ngga, ɓabum wun nǝ̀ pakkiɗire, sǝ mim gbal ka ɓabumam nǝ̀ nongŋo. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />Wu gingsǝi nǝ earcearǝu mala amǝkwaɗi, nǝ banɓoarnado pepè, andǝ pagulo, kǝla mǝnana ɓoaro ɓǝà pea amǝ pakki Mǝtalabangŋo túró ka. <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />Acemǝnana apî lú bǝti aban pakki Kǝrǝsti túró. Twal yilǝmi a kun kǝgìr ɗàng aɓa pakkam túró mǝnana ɓǝ́ wun nda wun nǝ̀ pakkam ngga.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">Kǝa gūlì arǝ nggūrǝu ɗang</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />A masǝlǝate ka, wun amǝ'eambǝam, ɓǝ̀ ban ɓoara wun ama, wu nda ka mala Mǝtalabangŋo. Ɓǝsǝlǝ gilǝ agir mǝnana ǝn gilǝa wunia a dǝmba ka, kwan rǝam ɗang. Nda ace yál paɓamuru ma'wun.<verse eid="PHP 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 3:2" />Wu tsǝkir wun arǝ anvwa mǝno, amǝ'ɓealɓikea, mǝnana à cam kingging nǝ cau mala kasǝ-ɓatau ace kum amsǝban ngga. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />Sǝm mǝnana sǝm nggǝ peri aban Ɓakuli aɓa Bangŋo ka, sǝm nda ka aɓwana mǝnana à kasǝa sǝm ɓatau aɓa mǝsǝcau ka. Sǝm ngga, sǝm nggǝ nggori nǝ Kǝrǝsti Yesu, sǝm gūlì arǝ agir mǝnana à pè aɓa nggūrǝu ka ɗang,<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 2:28-29">Rom 2:28-29</ref>; <ref loc="GAL 6:14-15">Gal 6:14-15</ref></char>.</note> <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />kat andǝ amani ama mǝ nǝ gandǝ jali nǝ amǝno yì agir ka.</para>
  <para style="p" vid="PHP 3:4">Ɓǝ̀ aɓwana nakam mǝnana à kǝ sǝni kǝla à ndanǝ agir mǝnana à nǝ̀ jali nǝia ka, mǝ ndanǝia pas mǝnana à kútì malea ka. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />Acemǝnana à kasǝam ɓatam a tongno-nong-tàruià nongŋo anzǝm ɓǝlám,<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:12">Tite 17:12</ref>; <ref loc="LEV 12:3">Pǝris 12:3</ref></char>.</note> mǝ nda ɓwa Isǝrayila, a tau mala Benjami, ɓwa Yahudi mǝɓafoe. Sǝ ɓǝ̀ nda ace kpata Nggurcau mala Musa ka, mǝ nda ɓwa Farisi, mǝnana à ndanǝ bumpina arǝ kpata Nggurcau ka.<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 11:1">Rom 11:1</ref>; <ref loc="ACT 23:6">Atúró 23:6</ref>; <ref loc="ACT 26:4">26:4</ref>,<ref loc="ACT 26:5">5</ref></char>.</note> <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />Ɓǝ̀ nda a cau mala pakki Ɓakuli túró nǝ bumpina ka, ɓafo ǝn pe ikǝlisiya tanni kǝ̀rkǝ́r. Sǝ ɓǝ̀ kàr a buì mala docauɓoarna aɓa kpata Nggurcau ka, ko ǝn yallì kǝ ɓè ɗang.<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 8:3">Atúró 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>.</note><verse eid="PHP 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PHP 3:7" />Agir mǝnana ɗiɗyal ǝn nggǝ twalia kǝla agirkuma ka, adyan ngga, ǝn nyesǝia ɓà, ace cau mala Kǝrǝsti. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />Sǝ kǝgìr pà kàm à nǝ̀ kànì arǝ súrǝ̀ Kǝrǝsti Yesu Mǝtalem ɗàng. Ən nying girbunda kat ace cau male. Ən sukkinia, ǝn twalia à pà a kun kǝgìr ɗàng, ace mǝnana ɓǝ̀ ǝn kum Kǝrǝsti, <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />sǝ ɓǝ̀ sǝm duk mwashat sǝni. Ən nggǝ twal cauɓoarna mala ɓamúràm mǝnana à kumgiyi ace kpata Nggurcau ka kǝgìr na ɗǝm ɗàng; she kǝ mǝnana à kumnggiki nǝ paɓamuru aban Kǝrǝsti ka. Acemǝnana njar mana Ɓakuli nǝ tsǝk sǝm, sǝm nǝ̀ duk aɓwana mǝɓoarne a kàne male ka, ndǎ ɓǝ̀ sǝm pa ɓamur sǝm aban Kǝrǝsti ka. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />Ən nggǝ earce súrǝ̀ Kǝrǝsti andǝ rǝcandǝa mǝnana loasǝi a ɓembe ka. Ən earǝna mǝ kum kāmbe mem aɓa nu tanni atè, mǝ nǝ wú a cau male, <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />nǝ́ tsǝkɓalǝu ama, ko lang ngga mǝ nǝ kum lo a ɓembe.<verse eid="PHP 3:11" /></para>
  <para style="s">Ɓariki aban ká lùmsǝ túró</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />Mim ngga ǝn twali ama ǝn bwalǝna ban came ɗang, sǝ ǝn malaká lùmsǝ gbal ɗang. Mǝ nda aban ɓariki mǝ nǝ kum gìr mǝnana Kǝrǝsti Yesu ciem, ǝn duk male ace ka. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />Wun amǝ'eambǝam, ǝn twali kǝla ǝn kumǝni ɗang. Gìr mǝnana mwashat ǝn nggǝ pak ka, nda mǝ lórǝ́ gìr mǝnana kutina ka, sǝ mǝ soa mǝsǝu atà gìr mǝnana nda a dǝmbam ngga. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />Ən pa rǝcandǝa arǝ ɓangmire aban ká masǝlǝate, ace mǝnana mǝ kum tangnakusǝu a kùli, mǝnana Ɓakuli tunǝam ace nǝ̀ pam aɓa Kǝrǝsti Yesu ka.<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />Sǝm mǝnana kat sǝm gulna aɓa Kǝrǝsti ka, ɓǝ̀ sǝm sǝni anggo. Sǝ ɓǝ̀ aɓea ɓwana atà wun, à ndanǝ ɓekǝ ɗenyicau ɗàng ngga, Ɓakuli nǝ̀ mǝngia wun ɓālǝi. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />Sǝm ngga, ɓǝ̀ sǝm bwal kàngkàng arǝ bancame mǝnana sǝm bingŋǝna kam ngga.<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />Wun amǝ'eambǝam, wu twal kusǝam, sǝ wu kànì arǝ aɓwana mǝnana à kǝ twal kusǝu mǝnana sǝm lǝmdǝa wun ngga.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 4:16">1Kor 4:16</ref>; <ref loc="1CO 11:1">11:1</ref></char>.</note> <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />Kǝla mǝnana ǝn nunkir wun tùtù ɗiɗyal ka, sǝ adyan ngga, mǝ nda ban ɓǝsǝlǝa wunì ɗǝm nǝ mǝrǝm a mǝsǝam, ama aɓwana pas ka, aɓia amǝbura mala nggun-gangndǝi mala Kǝrǝsti<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fq" closed="false">aɓia amǝbura mala nggun-gangndǝi mala Kǝrǝsti: </char><char style="ft" closed="false">Ko &lt;&lt;Aɓwana mǝnana à ɓinǝce kanigir amur lú mala Yesu amur nggun-gangndǝi ka.&gt;&gt;</char></note> na. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />Masǝlǝatea ka, kìɗìkì na. Ɓakuli malea nda bumia, agir kǝsǝkya à nda ka agir jali malea, sǝ ɓabumia ka nda amur agir ɓanza. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />Sǝ ma'sǝm ngga, sǝm nda ka aɓwana mala kùli. Sǝm nda ban kundǝ nyare yiu mala Mǝ'amsǝ sǝm nǝ kuli, yì Mǝtalabangŋo Yesu Kǝrǝsti. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />Nǝ́ rǝcandǝa male mala gandǝ nyesǝ agir kat aɓata yálban male ka, nǝ̀ yia nggaɗi nggūrǝ sǝm mǝ ká lui ɓǝ̀ pâ kǝla nggūrǝì mǝɓoarɓwe.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 15:35-58">1Kor 15:35-58</ref>; <ref loc="COL 3:4">Kol 3:4</ref></char>.</note><verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />Ace mani ka, wun amǝ'eambǝam, wu cam kàngkàng aɓa kpata Mǝtalabangŋo. Wun mǝnana ǝn earkiyi earce wun raka, sǝ ɓabumam kǝ pi ace sǝn wun ngga, wu nda ka banɓoarnado mem andǝ mbulan-gulo mem.<verse eid="PHP 4:1" /></para>
  <para style="s">Bulǝs ɓakɓabum amǝ kpata <optbreak /> Mǝtalabangŋo</para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />Ən nggǝ ɓuaki arǝ Yudiya sǝ ǝn nggǝ ɓuaki arǝ Sǝntǝki, wu earnǝ rǝarǝ wun, acemǝnana wun ngga, wu nda ka mala Mǝtalabangŋo. <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />E, ǝn nggǝ zǝmbo gbal, we ɓiam mǝtúró mǝɓafoe. Bwalì amamǝna mǝnia ka. Yia ka à pak túró kǝ̀rkǝ́r atàm aban hamnǝ Cau Amsǝban, atarǝ sǝm sǝnǝa Kǝlemen andǝ acili aɓiam amǝtúró, mǝnana alullǝia ka, à nda aɓa Malǝmce mala Yilǝmu ka.<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />Wu dum nǝ banɓoarnado aɓa dotarǝu ma'wun wunǝa Mǝtalabangŋo, a koya pwari ka. Nyare mǝ nǝ na wun ɗǝm: Wu pak banɓoarnado! <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />Ɓǝ̀ ɓwapǝndǝa sǝn domunyi ma'wun aɓa girbunda kat. Pà nǝ̀ sau ɗang, Mǝtalabangŋo nǝ̀ yiu. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />Kǝgìr ɓǝ̀ kǝa tsǝk wun a do-tiki nǝ múrú ɗang. Aɓa koya gìr ka, wu pakhiwi nǝ zǝmba, wu lǝmdǝì Ɓakuli agir mǝnana wu earkiyicea ka, sǝ wu kǝ pak yàwá.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 6:25-34">Mat 6:25-34</ref></char>.</note> <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />Sǝ dorǝpwala mala Ɓakuli, mǝnana kǝɓwa pà nǝ̀ bwalte raka, nǝ̀ bwal ɓabum wun andǝ ɗenyicau ma'wun aɓa Kǝrǝsti Yesu.<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />A masǝlǝate ka, wun amǝ'eamrǝarǝu, ɓǝ̀ ɗenyicau ma'wun ɓǝ̀ do amur gìr mǝnana kat mǝsǝcau na, nǝ̀ yinǝ gulo, à nǝ̀ pè aɓa kpate a njarì, mǝɓoarnsari na, mǝɓoarne na, andǝ mǝnana à nǝ̀ earce ka. Gìr mǝnana kat karban nǝ̀ ɓoaro, sǝ gìr mǝnana kat kàrmúr ɓoaro ko nǝ̀ yinǝ ɓwangsǝban ngga, wu tsǝk ɗenyicau ma'wun amúrià. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />Agir mǝnana kat wu kanì, wu oè, wu é, sǝ wu sǝn arǝàm ngga, wu cia aɓa túró. Sǝ Ɓakuli mǝnana kǝ pa dorǝpwala ka, nǝ̀ do atà wun.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 15:33">Rom 15:33</ref></char>.</note><verse eid="PHP 4:9" /></para>
  <para style="s">Bulǝs lǝmdǝ yàwá ace <optbreak /> aɓoro mana à pe wi ka</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />Ban kǝ ɓoaram kǝ̀rkǝ́r nǝ Mǝtalabangŋo, ama wu lǝmdǝna ɗenyinǝban ma'wun acem ɗǝm. Ən sǝlǝna ama wu kǝ ɗenyinǝ mim koya pwari, sǝ banì sauwuna bǝti mǝnana wu kum dǝmbu mala bwalàm nggàm raka. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />Ən pa aban bang mǝnia yì cau ka, acemǝnana mǝ nda aɓa tǝle ka ɗàng. Mim ngga ǝn kánìna do ɗǝmba nǝ gir mǝnana kat mǝ ndanǝi ka, <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />Ən súrǝ́nà rǝ do aɓa tǝle andǝ kume. Ən kánìna do aɓa koya gir; ko aɓa ɗǝmbǝo, ko aɓa nzala, ko aɓa kume kpǝm, ko aɓa ɗwanye. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />Mǝ nǝ gandǝ pak koya gìr ka, nǝ rǝcandǝa mǝnana Kǝrǝsti kǝ pam ngga.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />Kat andǝ amǝno ka, gbasha mǝnana wu pakkam aɓalǝ atanni mem ngga, ndanǝ ɓoaro. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />Wun amǝ Filipi ka, wu sǝlǝna ama aɓalǝ anonggio mala tita túró hamnǝ Cau Amsǝban mem, lang ǝn nying Masǝdoniya ka, kǝ wun nda kǝ ikǝlisiya mǝnana bwalàm nggàm, aɓa paɓoro ka. Kǝ ɓè ikǝlisiya pa kàm anggo ɗàng.<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 11:9">2Kor 11:9</ref></char>.</note> <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />Ko mǝnana mǝ nda a Tasalonika ka, wu túràmban nǝ aɓoro, ace pàkkam gbasha, pà kusǝ mwashat ɗang.<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 17:1">Atúró 17:1</ref>; <ref loc="1TH 2:9">1Tas 2:9</ref></char>.</note> <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />Ən pa aban bang mǝnia yì cau ka acemǝnana mǝ nda rǝ alta ɓoro aban wun ngga ɗàng. Nda ace mǝnana ɓǝ̀ wu kum tangnakusǝu mala pěmǝɓoarne ma'wun ngga. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />Ado ka, ǝn kumǝna agir mǝnana kat ɓǝ̀n pangnǝia ka, yàle nǝ mur amurí. Ən lumsǝna nǝ agirbunda kǝ̀rkǝ́r nǝ aɓoro mǝnana wu tasǝamban nǝia nǝ bu Apafuroditus ka. À nda kǝla aɓoro mǝɓoarne mǝnana agir'a na a ban Ɓakuli sǝ à kǝ pwasǝbumi ka.<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 29:18">Pur 29:18</ref></char>.</note> <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />Ɓakuli mem nǝ̀ pà wun koya gìr mǝnana wu kǝ paktǝle ka, aɓa kume male nggea mǝ'nyangsangnì<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="fq" closed="false">mǝ'nyangsangnì: </char><char style="ft" closed="false">ko &lt;&lt;mǝɓoarne,&gt;&gt; ko &lt;&lt;mǝgule.&gt;&gt;</char></note> nǝ bu Kǝrǝsti Yesu.<verse eid="PHP 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 4:20" />Adyan ngga, ɓǝ̀ gulo o a ban Ɓakuli, yì Tár sǝm, málá male pà kàm ɗàng. Ɓǝ̀ do anggo.<verse eid="PHP 4:20" /></para>
  <para style="s">Masǝlǝata makkun</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />Wu pà makkun mem a ban amǝkpata Kǝrǝsti Yesu. Amǝ'eamrǝarǝu mǝnana sǝm nda atarǝ sǝm ngga, à kǝ makka wun kún. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />Aɓwana mala Ɓakuli kat kǝ makka wun kún, nggeamurǝmi ka amǝnana aɓa ɓala mala Kaisar<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="fq" closed="false">Kaisar: </char><char style="ft" closed="false">Mǝnia ka nda murǝm mǝgule mala amǝ Roma.</char></note> ka.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />Ɓǝ̀ ɓwamuru mala Mǝtalabangŋo Yesu Kǝrǝsti do atà wun kat.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>