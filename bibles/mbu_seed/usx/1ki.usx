<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1KI" style="id">- Mbula</book>
  <para style="h">1Amurǝma</para>
  <para style="toc3">1Amur</para>
  <para style="toc2">1 Amurǝm</para>
  <para style="toc1">1 Amurǝma</para>
  <para style="mt1">AMURƏMA MƏDƏMBE</para>
  <para style="is">MƏNCAU</para>
  <para style="im">
    <char style="bk">Malǝmce mǝdǝmbe mala amurǝma</char> ka lidǝmba nǝ acau-ɓaraɓara mala amurǝma mala amǝ'Isǝrayila mǝnana à tite bangcau malea aɓalǝ amalǝmce mǝnana à tunǝia ama Samuyila ka. À nǝ̀ gandǝ gauwi arǝ abanì tàrú: (1) Liɓala mala Solomon kǝla murǝm amur Isǝrayila andǝ Yahuda, andǝ lú mala tárrí Dauda. (2) Yálmúrû mala Solomon andǝ atúró-zǝ́kí'lullǝu male, nggeamurǝmi mana twal ɗenyicau ka nda ɓak Ndámǝgule a Urǝshalima. (3) Gauwa mala nzali arǝ abanì ɓari: domurǝm mala njarnza andǝ mala njarkunmur; sǝ acau-ɓaraɓara mala amurǝma mana à yálmúr adomurǝm man ngga yi pur a bàkú mǝnana ue apǝlǝa gbǝman-tongno-nong-tàrú nǝ lumi-tongno (850) sǝ ɓǝà ɓǝl Kǝrǝsti ka.</para>
  <para style="ip">Aɓalǝ amalǝmce mala <char style="bk">1</char> andǝ <char style="bk">2 Amurǝma </char> ka, ko mǝyani atà amǝ'yálmúrû ka, a kasǝi wi ɓashi nǝ lang sǝ paɓamuru male pa aban Ɓakuli, sǝ hangǝli mala nzali male ka gyar arǝ mǝno yì paɓamuru male ka. Peri atà ankúl andǝ mgbicau, a ɓè buì ka, nda mǝnana warinǝ ban aɓa kìɗìkì ka. Amurǝma mana kat a domurǝm mala njar-nza ka, à kpa, kǝɓwa ateà pàk mǝɓoarne ɗàng. Sǝ gìr mǝnana à gilǝa amur amurǝma mala Yahuda ka, lǝmdǝ ama aɓea ateà kpa sǝ aɓea ɓariki à pàk mǝɓoarne.</para>
  <para style="ip">Aɓwana aɓa malǝmce <char style="bk">1 Amurǝma </char> mǝnana à pur a kúnban aɓa pàkkiagir ka, à nda ka amǝ'ɓangnǝa mala Mǝtalabangŋo; amǝno yì amǝ'mǝsǝkàng-kàngŋa mana à nakiyi cau a kúnì Ɓakuli, mǝnana à nunkir aɓwana ɓǝà kǝa peri atà ankúl ɗàng, sǝ ɓǝà kǝa mgbiki Ɓakuli kiru raka. Nggeamurǝmi mǝɓangnǝa mǝnana pur a kúnban ngga, nda Iliya andǝ kǝɓicau mala wara andǝ limurǝm male amur apǝris mala Ba'al (kùré 18).</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Masǝlǝata yálmúrû mala Dauda <char style="ior"><ref loc="1KI 1:1-2:12">1:1--2:12</ref></char></para>
  <para style="io1">Solomon duk murǝm <char style="ior"><ref loc="1KI 2:13-46">2:13-46</ref></char></para>
  <para style="io1">Yálmúrû mala Solomon <char style="ior"><ref loc="1KI 3:1-11:43">3:1--11:43</ref></char></para>
  <para style="io2">Apǝlǝa mǝdǝmbe <char style="ior"><ref loc="1KI 3:1-4:34">3:1--4:34</ref></char></para>
  <para style="io2">A ɓak Ndámǝgule <char style="ior"><ref loc="1KI 5:1-8:66">5:1--8:66</ref></char></para>
  <para style="io2">Apǝlǝa mǝ'nzǝmoe <char style="ior"><ref loc="1KI 9:1-11:43">9:1--11:43</ref></char></para>
  <para style="io1">Domurǝm mǝnana gau ka <char style="ior"><ref loc="1KI 12:1-22:53">12:1--22:53</ref></char></para>
  <para style="io2">Mgbicau mala atau mǝnana a njarnza ka <char style="ior"><ref loc="1KI 12:1-14:20">12:1--14:20</ref> </char></para>
  <para style="io2">Amurǝma mala Yahuda andǝ mala Isǝrayila <char style="ior"><ref loc="1KI 14:21-16:34">14:21--16:34</ref></char></para>
  <para style="io2">Iliya mǝɓangnǝa mala Ɓakuli<char style="ior"><ref loc="1KI 17:1-19:21">17:1--19:21</ref></char></para>
  <para style="io2">Murǝm Ahap mala Isǝrayila <char style="ior"><ref loc="1KI 20:1-22:40">20:1--22:40</ref></char></para>
  <para style="io2">Jehoshafat mala Yahuda andǝ Ahaziya mala Isǝrayila<char style="ior"><ref loc="1KI 22:41-53">22:41-53</ref></char></para>
  <chapter number="1" style="c" sid="1KI 1" />
  <para style="s1">Murǝm Dauda aɓa è male</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 1:1" />Adyan ngga, Murǝm Dauda enà kutsuk; sǝ kat andǝ amani ama à kùmsǝi wi akungtung amurí ka, gandǝ tsǝî ok rǝì lùlù ɗàng. <verse eid="1KI 1:1" /><verse number="2" style="v" sid="1KI 1:2" />Nda amǝ'túró-ɓala male banggi wi ama, &lt;&lt;Ɓwamǝgule murǝm, eara sǝm ɓǝ̀ sǝm kumbo mǝ'nsari mǝnana nǝ̀ do atò, nǝ nggǝ ɗenyinǝ we ka. Ɓǝ̀ kǝ nong a nkanggario ace mǝnana ɓǝ̀ tsǝk rǝò wu oê lùlù ka.&gt;&gt;<verse eid="1KI 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 1:3" />Pǝlǝa à alta nsari mǝɓoarnsarì aɓa nzong-nzali Isǝrayila kat, sǝ à kum Abishag ɓwama Shunam,<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="JOS 19:18">Jes 19:18</ref></char>.</note> sǝ à yinǝi aban murǝm. <verse eid="1KI 1:3" /><verse number="4" style="v" sid="1KI 1:4" />Muna-ɓwame ka ɓoarnsari kǝ̀rkǝ́r; sǝ yì ka ɗenyinǝ murǝm kǝ pakki wi túró-ɓadǝmbi, sǝama murǝm pak-ɓwama nǝi ɗàng.<verse eid="1KI 1:4" /></para>
  <para style="s1">Adonija ɓariki nǝ̀ duk murǝm</para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 1:5" />Adyan ngga, <note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="2SA 3:4">2Sam 3:4</ref></char>.</note>Adonija muna-ɓwabura mala Haggit [mālá Dauda] gusǝlǝ ɓamurǝì, sǝ bang ama, &lt;&lt;Mǝ nǝ duk murǝm.&gt;&gt; Pǝlǝa kumbi ɓamurǝì awaru-pǝr andǝ amǝpǝr, sǝ alta aburana lumi-tongno ɓǝà kǝ ɓangŋa a ɓadǝmbi. <verse eid="1KI 1:5" /><verse number="6" style="v" sid="1KI 1:6" />Tárrí Dauda gimbi a kǝ̀ pwari ko ɗì ama, &lt;&lt;Palang sǝ a pak gìr ani ko anggo ka&gt;&gt; ɗàng. Adonija ka ɓwabura mǝɓoarjami na, sǝ yì na kpanzǝm Absalom ngga.<verse eid="1KI 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 1:7" />Adonija kùrkún andǝ Jowap muna-ɓwabura mala Zeruya andǝ Abiyata pǝris; sǝ à kpata Adonija, à bwali wi. <verse eid="1KI 1:7" /><verse number="8" style="v" sid="1KI 1:8" />Sǝama Zadok pǝris, andǝ Benaya muna-ɓwabura mala Jehoyada, andǝ <note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="2SA 12:1">2Sam 12:1</ref></char>.</note>Natan mǝɓangnǝa, andǝ Shimeyi, andǝ Reyi, sǝ akanggǝrang aburana mala Dauda ka, à pa atà Adonija ɗàng.<verse eid="1KI 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 1:9" />Adonija pǝlǝa pa gir'nkila nǝ anzur, andǝ andá-rya, andǝ ajamnda mǝ'nyange a Tali mala Zohelet, mǝnana nda a nkanggari En-Rogel ka. Adonija tunǝ amǝ'eambi-aburana, yia amuna-burana mala murǝm, andǝ amǝ'tamurǝm mala Yahuda kat. <verse eid="1KI 1:9" /><verse number="10" style="v" sid="1KI 1:10" />Sǝama tunǝ Natan mǝɓangnǝa andǝ Benaya andǝ akanggǝrang aburana andǝ mǝ'eambi Solomon ɗàng.<verse eid="1KI 1:10" /></para>
  <para style="s1">Natan andǝ Basheba aɓadǝm Dauda</para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 1:11" />Pǝlǝa Natan ɗì Basheba, nggea Solomon ama, &lt;&lt;A malaká ok ama Adonija muna-ɓwabura mala Haggit pǝlǝna murǝm, sǝ Dauda ɓwamǝgule ma'sǝm ngga sǝlǝ kǝcau amurí ɗàng re? <verse eid="1KI 1:11" /><verse number="12" style="v" sid="1KI 1:12" />Ado ka, yiu ɓǝ̀n po kwarkiru, ace mǝnana wu amsǝ yilǝmo andǝ yilǝmi muna-ɓwabura mô Solomon ngga. <verse eid="1KI 1:12" /><verse number="13" style="v" sid="1KI 1:13" />Kútí aban Murǝm Dauda adyadyan, sǝ wu ne wi ama, &lt;We ɓwamǝgule mem murǝm ngga, a kánbam, mim guro mò ama, Solomon muna-ɓwabura mô nǝ̀ duk murǝm anzǝmo, sǝ yì na mǝnana nǝ̀ do amur buno-murǝm mò ka re? Sǝ palang ado sǝ Adonija dumǝna murǝm?&gt; <verse eid="1KI 1:13" /><verse number="14" style="v" sid="1KI 1:14" />Lang a nda piu aban nacau nǝ murǝm ngga, mim gbal ka mǝ nǝ kutio anzǝmo, sǝ mǝ nǝ banggi wi ama, cau mǝnana a nakiyi ka mǝsǝcaua.&gt;&gt;<verse eid="1KI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 1:15" />Nda Basheba wari aban murǝm aɓa ndà-nongŋo male ka; a bàkú mǝno ka, murǝm ena kutsuk, sǝ Abishag ɓwama Shunam na kǝ ɗenyinǝi ka. <verse eid="1KI 1:15" /><verse number="16" style="v" sid="1KI 1:16" />Basheba ɓun a nzali, aɓadǝm murǝm, pe murǝm gulo. Sǝ murǝm ɗì ama, &lt;&lt;Mana a kǝ earce?&gt;&gt;<verse eid="1KI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 1:17" />Pǝlǝa earî murǝm ama, &lt;&lt;Ɓwamǝgule mem, a kánbam, mim guro mò, nǝ lullǝ Yahweh Ɓakuli mô ama, Solomon muna-ɓwabura mô na nǝ̀ duk murǝm anzǝmo ka, sǝ yì na nǝ̀ do amur buno-murǝm mò ka. <verse eid="1KI 1:17" /><verse number="18" style="v" sid="1KI 1:18" />Sǝ ado ka, sǝni Adonija dumǝna murǝm, sǝ we ɓwamǝgule mem murǝm ngga, a sǝlǝce ɗàng. <verse eid="1KI 1:18" /><verse number="19" style="v" sid="1KI 1:19" />Adonija pàna gìr'nkila nǝ anda-rya, andǝ ajamnda mǝ'nyange andǝ anzur pas, sǝ tunǝna amuna-burana mala murǝm kat, andǝ Abiyata pǝris, andǝ Jowap mǝ'sàrǝ̀ban mala amǝ'lwa, sǝ Solomon guro mò ka tunǝi ɗàng. <verse eid="1KI 1:19" /><verse number="20" style="v" sid="1KI 1:20" />Sǝ ado ka ɓwamǝgule mem murǝm, mǝsǝ Isǝrayila kat ka nda arǝò, ace mǝnana wu banggia wia ɓwa mǝnana nǝ̀ do amur buno-murǝm mala ɓwamǝgule mem murǝm, anzǝmi ka. <verse eid="1KI 1:20" /><verse number="21" style="v" sid="1KI 1:21" />Ɓǝ̀ ana raka, anzǝm mǝnana ɓwamǝgule mem murǝm umǝna a ntulo atà akê ka, mim sǝnǝ muna-ɓwabura mem Solomon ngga, à nǝ̀ nyesǝ sǝm, sǝm nda ka amǝ'yàl-nzongcau.&gt;&gt;<verse eid="1KI 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 1:22" />Lang Basheba naban nacau andǝ murǝm ngga, kara Natan mǝɓangnǝa yi kutio. <verse eid="1KI 1:22" /><verse number="23" style="v" sid="1KI 1:23" />Sǝ amǝgulo mala murǝm banggi wi ama, &lt;&lt;Natan mǝɓangnǝa nia ka.&gt;&gt; Sǝ lang Natan yina aɓadǝm murǝm ngga, ɓunno aɓadǝm murǝm nǝ ɓamǝsǝi a nzali.<verse eid="1KI 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 1:24" />Pǝlǝa Natan bang ama, &lt;&lt;Ɓwamǝgule mem murǝm, a bangŋǝna ama, Adonija nda ɓwa mǝnana nǝ̀ duk murǝm anzǝmo, sǝ nǝ̀ do amur buno-murǝm mò ka le? <verse eid="1KI 1:24" /><verse number="25" style="v" sid="1KI 1:25" />Acemǝnana yalung ngga, umǝna kya pàna gìr'nkila nǝ anda-rya, andǝ ajamnda mǝ'nyange, andǝ anzur pas, sǝ tunǝna amuna-burana mala murǝm, andǝ amǝ'sàrǝ̀ban mala amǝ'lwa,<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fq" closed="false">amǝ'sàrǝ̀ban mala amǝ'lwa </char><char style="ft" closed="false">ko &lt;&lt;andǝ Jowap, mǝ'sàrǝ̀ban mala amǝ'lwa&gt;&gt; </char></note> andǝ Abiyata pǝris. Ado-mǝno ka, à ndaban lili andǝ nugìr aɓadǝmbi, à kǝ bang ama, &lt;Ɓǝ̀ yilǝmo sauwa, Murǝm Adonija!&gt; <verse eid="1KI 1:25" /><verse number="26" style="v" sid="1KI 1:26" />Sǝama mim, guro mò, andǝ Zadok pǝris, andǝ Benaya muna-ɓwabura mala Jehoyada, sǝ guro mò Solomon ngga, Adonija tunǝ sǝm ɗàng. <verse eid="1KI 1:26" /><verse number="27" style="v" sid="1KI 1:27" />Mǝnia yì gìr ka, ɓwamǝgule mem murǝm nǝ̀ pè le, sǝ a bangga sǝm, sǝm aguro mò ɓwa mǝnana nǝ̀ do amur buno-murǝm mala ɓwamǝgule mem murǝm, anzǝmi ka ɗàng?&gt;&gt;<verse eid="1KI 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 1:28" />Pǝlǝa Murǝm Dauda bang ama, &lt;&lt;Wu tunǝâm Basheba.&gt;&gt; Nda Basheba nyare yi kútí a ban murǝm, cam aɓadǝmbi. <verse eid="1KI 1:28" /><verse number="29" style="v" sid="1KI 1:29" />Sǝ murǝm kángir ama, &lt;&lt;Kǝla mǝnana Yahweh nakam nǝyilǝmu, mǝnana amsǝ yilǝmem aɓa koya tanni, <verse eid="1KI 1:29" /><verse number="30" style="v" sid="1KI 1:30" />sǝ kǝla mǝnana ǝn kánbo nǝ Yahweh, Ɓakuli mala Isǝrayila, ama, &lt;Munio Solomon nǝ̀ duk murǝm anzǝmam, sǝ nǝ̀ do amur buno-murǝm mem a kúnèm&gt; ngga, anggo sǝ mǝ nǝ pè yalung.&gt;&gt; <verse eid="1KI 1:30" /><verse number="31" style="v" sid="1KI 1:31" />Pǝlǝa Basheba ɓun amur ankūnǝi nǝ ɓamǝsǝi a nzali, pà gulo aban murǝm, sǝ bang ama, &lt;&lt;Ɓǝ̀ yilǝmi ɓwamǝgule mem Murǝm Dauda sauwa tàtǝ́k!&gt;&gt;<verse eid="1KI 1:31" /></para>
  <para style="s">Dauda twal Solomon ɓǝ̀ duk murǝm</para>
  <para style="p">
    <verse number="32" style="v" sid="1KI 1:32" />Murǝm Dauda na ama, &lt;&lt;Wu tunǝâm Zadok pǝris, andǝ Natan mǝɓangnǝa, sǝ Benaya muna-ɓwabura mala Jehoyada.&gt;&gt; Lang à yina aɓadǝm murǝm ngga, <verse eid="1KI 1:32" /><verse number="33" style="v" sid="1KI 1:33" />murǝm banggia wia ama, &lt;&lt;Wu twal Solomon andǝ amǝgulo mala ɓwamǝgule ma'wun atà wun, sǝ wu tsǝk Solomon muna-ɓwabura mem ɓǝ̀ eauwe a nzǝm pǝr-mǝdambǝriso mem, sǝ wu kyan nǝi a <note caller="+" style="f"><char style="fr" closed="false">1:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="2CH 32:30">2Acau 32:30</ref>; <ref loc="2CH 33:14">33:14</ref></char>.</note>Gihon. <verse eid="1KI 1:33" /><verse number="34" style="v" sid="1KI 1:34" />A ban mǝno ka, Zadok pǝris andǝ Natan mǝɓangnǝa ɓǝà ɗārǝi, ɓǝ̀ duk murǝm amur Isǝrayila. Sǝ wu twang njawe, wu bang ama, &lt;Ɓǝ̀ yilǝmo sauwa, Murǝm Solomon!&gt; <verse eid="1KI 1:34" /><verse number="35" style="v" sid="1KI 1:35" />Pǝlǝa wun nǝ̀ tsǝktè, sǝ nǝ̀ yia do amur buno-murǝm mem, acemǝnana yì na nǝ̀ duk murǝm a kúnèm ngga. Sǝ ǝn twalni ɓǝ̀ duk mǝ'yálmúrû amur Isǝrayila sǝ amur Yahuda.&gt;&gt;<verse eid="1KI 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 1:36" />Benaya muna-ɓwabura mala Jehoyada earî murǝm ama, &lt;&lt;Ɓǝ̀ do anggo! Ɓǝ̀ Yahweh Ɓakuli mala ɓwamǝgule mem tsǝì ɓǝ̀ do anggo. <verse eid="1KI 1:36" /><verse number="37" style="v" sid="1KI 1:37" />Kǝla mǝnana Yahweh pà atà ɓwamǝgule mem murǝm ɗiɗyal ka, anggo gbal ɓǝ̀ pà atà Solomon, sǝ ɓǝ̀ tsǝk buno-murǝm male ɓǝ̀ gulo ɓǝ̀ kútì buno-murǝm mala ɓwamǝgule mem Murǝm Dauda!&gt;&gt;<verse eid="1KI 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 1:38" />Nda Zadok pǝris, andǝ Natan mǝɓangnǝa, andǝ Benaya muna-ɓwabura mala Jehoyada, andǝ amǝ'Keret andǝ amǝ'Pelet wario à kya tsǝk Solomon eauwe a nzǝm pǝr-mǝdambǝriso mala Murǝm Dauda, sǝ à yinǝi a Gihon. <verse eid="1KI 1:38" /><verse number="39" style="v" sid="1KI 1:39" />Zadok pǝris twal njawe mala mùrú mǝnana nda aɓa Tara mǝfele ka, sǝ ɗārǝ́ Solomon. Pǝlǝa à twang njawe, sǝ aɓwana kat loasǝ gia à bang ama, &lt;&lt;Ɓǝ̀ yilǝmi Murǝm Solomon sauwa!&gt;&gt; <verse eid="1KI 1:39" /><verse number="40" style="v" sid="1KI 1:40" />Sǝ aɓwana kat kpa aban ká atè a ɓala, nǝ twang antetu, nǝ banɓoarnado kǝ̀rkǝ́r, gandǝa nzali gǝggǝli atàcau mala già.<verse eid="1KI 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 1:41" />Adonija andǝ abǝri mǝnana kat atè ka ok giu, lang à kǝ mal pàkkiɗire ani ka. Sǝ lang Jowap ok gi njawe ka, ɗìban ama, &lt;&lt;Mana tsǝk là sǝ lo gǝting le?&gt;&gt; <verse eid="1KI 1:41" /><verse number="42" style="v" sid="1KI 1:42" />Lang ndaban nacau piu ka, kara Jonatan muna-ɓwabura mala Abiyata pǝris yi tusǝo. Sǝ Adonija bang ama, &lt;&lt;Yiu kutio. Ɓwa mǝɓoarne kǝla we ka dumǝna púp a yinanǝ bǝsacau mǝɓoarne.&gt;&gt;<verse eid="1KI 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1KI 1:43" />Jonatan eari wi ama, &lt;&lt;Awo! Ɓwamǝgule ma'sǝm Murǝm Dauda tsǝ̀ngŋǝ̀nà Solomon dumǝna murǝm. <verse eid="1KI 1:43" /><verse number="44" style="v" sid="1KI 1:44" />Murǝm tasǝna Zadok pǝris, andǝ Natan mǝɓangnǝa, andǝ Benaya muna-ɓwabura mala Jehoyada, andǝ amǝ'Keret andǝ amǝ'Pelet atè. À tsǝ̀ngŋǝ̀nì eauna a nzǝm pǝr-mǝdambǝriso mala murǝm. <verse eid="1KI 1:44" /><verse number="45" style="v" sid="1KI 1:45" />Sǝ Zadok pǝris andǝ Natan mǝɓangnǝa ɗārǝ́ni ɓǝ̀ duk murǝm a Gihon, sǝ à longŋǝ́nà a ban mǝno nǝ banɓoarnado, gandǝa nggea-là lo gǝting. Mǝno ka nda loasǝban mǝnana wu oè ka. <verse eid="1KI 1:45" /><verse number="46" style="v" sid="1KI 1:46" />Mǝno na nǝmurǝì ɗàng, Solomon na aban do amur buno-murǝm. <verse eid="1KI 1:46" /><verse number="47" style="v" sid="1KI 1:47" />Sǝ ɗǝm ngga, amǝgulo mala murǝm warina aban ɓwamǝgule ma'sǝm Murǝm Dauda ace makkìkun, nǝ cau ama, &lt;Ɓǝ̀ Ɓakuli mô tsǝk lullǝ Solomon, muna-ɓwabura mô ɓǝ̀ zǝ́kí ɓǝ̀ kútì mò, sǝ ɓǝ̀ tsǝk do-bunomurǝm male ɓǝ̀ kútì mò!&gt; Pǝlǝa murǝm timuri aɓa peri amur gyangŋan-nongŋo male.<note caller="+" style="f"><char style="fr" closed="false">1:47 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="GEN 47:31">Tite 47:31</ref></char>.</note> <verse eid="1KI 1:47" /><verse number="48" style="v" sid="1KI 1:48" />Ɗǝm ngga, murǝm bang ama, &lt;Ɓwangsǝban ɓǝ̀ pa aban Yahweh, yì Ɓakuli mala Isǝrayila, mǝnana pànâm muna [a nggurkwar mem] ɓǝ̀ do amur buno-murǝm mem yalung, sǝ eare ǝn sǝnǝni nǝ mǝsǝam ngga.&gt; &gt;&gt;<verse eid="1KI 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1KI 1:49" />Kara abǝri mala Adonija kat lo nǝ ɓangciu, sǝ koyana ateà ka bwal njar male aban o. <verse eid="1KI 1:49" /><verse number="50" style="v" sid="1KI 1:50" />Sǝ Adonija ka ɓangciu pàkki wi arǝ Solomon. Nda lo wario sǝ kya bwal anjawe mala gyangŋan ngga. <verse eid="1KI 1:50" /><verse number="51" style="v" sid="1KI 1:51" />Pǝlǝa à ne Solomon ama, &lt;&lt;Sǝni, Adonija ka ɓangciu kǝ pakki wi arǝ Murǝm Solomon, sǝ ado ka ndarǝ gyare arǝ anjawe mala gyangŋan, sǝ kǝ na ama, &lt;Ɓǝ̀ Murǝm Solomon kánbam peatu ama, pa nǝ̀ wal-lú guro male nǝ nggeabyau ɗàng.&gt; &gt;&gt;<verse eid="1KI 1:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1KI 1:52" />Sǝ Solomon bang ama, &lt;&lt;Ɓǝ̀ yì ka nǝ̀ lǝmdǝ ɓamúrì ɓwa mǝɓoarne na ka, kǝ nyang-múrí mwashat pa nǝ̀ kpa a nzali ɗàng; sǝama ɓǝ̀ à kumi nǝ ɓealɓikea ka, à nǝ̀ wal-luí.&gt;&gt; <verse eid="1KI 1:52" /><verse number="53" style="v" sid="1KI 1:53" />Nda Solomon tasǝ aburana, sǝ à wario à kya bwal Adonija ɓǝ̀ sulǝî gyangŋan ngga. Pǝlǝa à yinǝi, sǝ yi ɓunno a nzali aɓadǝm Murǝm Solomon. Sǝ Murǝm Solomon ne wi ama, &lt;&lt;O a ɓala mò.&gt;&gt;<verse eid="1KI 1:53" /></para>
  <chapter eid="1KI 1" />
  <chapter number="2" style="c" sid="1KI 2" />
  <para style="s1">Kwarkiru mǝnana Dauda kwarkir muni Solomon ngga</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 2:1" />Lang pwari lú mala Dauda gbàshìnà ka, tunǝ muni Solomon sǝ pe wi mǝnia yì kwarkiru ka, ama: <verse eid="1KI 2:1" /><verse number="2" style="v" sid="1KI 2:2" />&lt;&lt;Mǝ ndo mǝ nǝ o a ban mǝnana koya ɓwa a ɓanza nǝ̀ u kam ngga. <note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="JOS 1:6-7">Jes 1:6-7</ref></char>.</note>Kum ɓabumcandǝa, sǝ wu lǝmdǝ ɓamuro kǝla ɓwabura-ɓwa. <verse eid="1KI 2:2" /><verse number="3" style="v" sid="1KI 2:3" />Tsǝkiro arǝ pàk gìr mǝnana Yahweh Ɓakuli mô tsǝkô ama wu pe ka. Gya arǝ anjar male, sǝ wu kpata akwarkiru andǝ anê male, bwal anzongcau andǝ anggurcau male kǝla mǝnana à gilǝì aɓa Nggurcau mala Musa ka. Anggo sǝ awu nǝ̀ kum lidǝmba aɓa koman kat a pakkiyi ka andǝ ban mǝnana kat awu nǝ̀ ká kam ngga. <verse eid="1KI 2:3" /><verse number="4" style="v" sid="1KI 2:4" />Ɓǝ̀ a kpata cau mala Yahweh ka, nǝ̀ lùmsǝ pàcau male mǝnana pam ama: &lt;Ɓǝ̀ amunio tsǝkiria arǝ do malea, sǝ à kpatam aɓa mǝsǝcau nǝ ɓabumia andǝ yilǝmia kat ka, a pà wunǝ ɗwanyi mwashat ateà mǝnana nǝ̀ do amur buno-murǝm mala Isǝrayila ka ɗàng.&gt;<verse eid="1KI 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 2:5" />&lt;&lt;Ɗǝm ngga, a ndanǝ sǝlǝe mala gìr mǝnana Jowap muna-ɓwabura mala Zeruya pakkam ngga; yì gir mǝnana pakki amǝ'sàrǝ̀ban ɓari mala amǝ'lwa mala Isǝrayila ka, yià Abǝna muna-ɓwabura mala Ner andǝ Amasa muna-ɓwabura mala Jeta, mǝnana wal-luia ace mbwegìr-akúnì nkila mǝnana à sukki aɓa lwa, a bàkú mala dorǝpwala ka, sǝ nǝ dé-nkila mǝno ka, pǝndǝkina nggur-ɓunu mǝnana a taɓuni ka andǝ ankura mǝnana a kusǝi ka. <verse eid="1KI 2:5" /><verse number="6" style="v" sid="1KI 2:6" />Pàkki wi kǝla mǝnana sǝlǝe mò lǝmdǝo ka, sǝama kǝa ɗeki ɓǝ̀ wù aɓa rǝpwala a ě male ɗàng.<verse eid="1KI 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 2:7" />&lt;&lt;Sǝ lǝmdǝì amuna-burana mala <note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="2SA 19:31-38">2Sam 19:31-38</ref></char>.</note>Barzilayi ɓwa'Gilǝya pěmǝɓoarne. Nyia ɓǝà pa aɓalǝ aɓwana mǝnana à nǝ̀ nggǝ li girlina amur kpamgbang-ligirlina mô ka, acemǝnana nda anggo sǝ à yiu ace bwalam-nggam lang mǝ ndaban ɓanggi mǝ'eambo Absalom ngga.<verse eid="1KI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 2:8" />&lt;&lt;Sǝ ɗǝm ngga, cè ɓalǝo lorǝ Shimeyi muna-ɓwabura mala Gera, yì ɓwa tàu mala Benjami a là Bahurim ɗàng. Yì nda mǝnana suem nǝ ɓikina suban, a pwari mǝno ǝn wari a <note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="2SA 17:24">2Sam 17:24</ref></char>.</note>Mahanayim ngga. Kat andǝ amani ama, lang yiu ace kúlliam a Nggeasala Jodan ngga, ǝn kánbi wi nǝ lullǝ Yahweh ama, &lt;Mǝ pà mǝ nǝ wal-luio nǝ nggeabyau raka,&gt; <verse eid="1KI 2:8" /><verse number="9" style="v" sid="1KI 2:9" />adyan ngga, kǝa ɗeki ɓǝ̀ uɓà ɗàng. We ka, a nda ɓwa mǝ'kwarè. Awu nǝ súrǝ̀ gir mǝnana ɓoaro wu pakki wi ka, sǝ awu nǝ tasǝte a ɓembe nǝ sukki nkile aɓa ě male.&gt;&gt;<verse eid="1KI 2:9" /></para>
  <para style="s1">Lú mala Dauda</para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 2:10" />Pǝlǝa Dauda paklú, sǝ à tsǝkbani a Urǝshalima, yì Nggea-là mala Dauda. <verse eid="1KI 2:10" /><verse number="11" style="v" sid="1KI 2:11" />Dauda yálmúr Isǝrayila apǝlǝa lumi-ine (40); apǝlǝa tongno-nong-ɓari (7) a Hebǝron, sǝ apǝlǝa lumi-tàrú nǝ mǝsǝi tàrú (33) a Urǝshalima. <verse eid="1KI 2:11" /><verse number="12" style="v" sid="1KI 2:12" />Nda Solomon do amur buno-murǝm mala tárrí Dauda, sǝ domurǝm male kum kusǝu-came kàngkàng.<verse eid="1KI 2:12" /></para>
  <para style="s1">Lú mala Adonija</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 2:13" />A ɓè pwari ka, Adonija mǝnana nggè nda Haggit ka, wari aban Basheba nggea Solomon. Basheba ɗì ama, &lt;&lt;A yiu jam le?&gt;&gt;</para>
  <para style="p" vid="1KI 2:13">Adonija eari wi ama, &lt;&lt;E, ǝn yiu jam.&gt;&gt; <verse eid="1KI 2:13" /><verse number="14" style="v" sid="1KI 2:14" />Pǝlǝa Adonija na ama, &lt;&lt;Mǝ ndanǝ ɓè cau mǝnana ǝn nggǝ earce banggo ka.&gt;&gt;</para>
  <para style="p" vid="1KI 2:14">Basheba ne wi ama, &lt;&lt;Na cê.&gt;&gt;<verse eid="1KI 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 2:15" />Adonija ne wi ama, &lt;&lt;A sǝlǝna ama domurǝm ngga mema, sǝ Isǝrayila kat ka tsǝkɓalǝi arǝàm ama mǝ duk murǝm. Sǝama, agir nggaɗi, nda domurǝm nyare a bù mǝkyauwem ngga, acemǝnana anggo sǝ pur nǝban Yahweh ama yì ka ɓǝ̀ duk murǝm. <verse eid="1KI 2:15" /><verse number="16" style="v" sid="1KI 2:16" />Ado ka, mǝ ndanǝ zǝmba mwashat aban ká bano. Kǝa giram nǝi ɗàng.&gt;&gt;</para>
  <para style="p" vid="1KI 2:16">Basheba eari wi ama, &lt;&lt;Nacau.&gt;&gt;<verse eid="1KI 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 2:17" />Pǝlǝa Adonija bang ama, &lt;&lt;Ida, ne Murǝm Solomon ɓǝ̀ pam Abishag ɓwama Shunam ɓǝ̀ duk māmám. Yì murǝm ngga, pa nǝ̀ ɓinǝ ɗàng.&gt;&gt;<verse eid="1KI 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 2:18" />Basheba eari wi ama, &lt;&lt;Ndanǝ ɓoaro, mǝ nǝ nacau nǝ murǝm aceo.&gt;&gt;<verse eid="1KI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 2:19" />Lang Basheba wari aban Murǝm Solomon ace nacau nǝi a kúnì Adonija ka, murǝm lo ace gingsǝe, sǝ ɓunbi wi. Pǝlǝa dumnǝdo amur buno-murǝm male, sǝ bang ama ɓǝà yinǝ buno ace nggè, sǝ nggè do a buì mǝli.<verse eid="1KI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 2:20" />Pǝlǝa Basheba bang ama, &lt;&lt;Mǝ ndanǝ zǝmba bǝti a bano; kǝa giram nǝi ɗàng.&gt;&gt;</para>
  <para style="p" vid="1KI 2:20">Murǝm eari wi ama, &lt;&lt;Nâ, banggam cê, mǝ nǝ pàkkô girnì.&gt;&gt;<verse eid="1KI 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 2:21" />Nda Basheba ne wi ama, &lt;&lt;Ɓǝà pè Adonija mǝ'eambǝo, Abishag ɓwama Shunam ɓǝ̀ duk māmí.&gt;&gt;<verse eid="1KI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 2:22" />Murǝm Solomon earî nggè ama, &lt;&lt;Palang sǝ a zǝm Abishag ɓwama Shunem ace Adonija? Zǝmbi wi domurǝm gbal, acemǝnana yì ka mǝgulem ma, sǝ Abiyata pǝris andǝ Jowap muna-ɓwabura mala Zeruya ka, à nda atè!&gt;&gt;<verse eid="1KI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 2:23" />Pǝlǝa Murǝm Solomon kángir nǝ Yahweh ama, &lt;&lt;Ɓǝ̀ Ɓakuli ɓashiàm sǝ yale ɓǝ̀ ɓǝsǝlǝi kǝ̀rkǝ́r, ɓǝ̀ mǝnia yì zǝmba ka, nunbi Adonija lú male raka! <verse eid="1KI 2:23" /><verse number="24" style="v" sid="1KI 2:24" />Sǝ ado ka, kǝla mǝnana Yahweh nakam nǝyilǝmu, yì mǝnana tamsǝna-kusǝam kàngkàng, sǝ dumsǝnam amur buno-murǝm mala tárrám Dauda, sǝ tsǝ̀ngŋǝ̀nà nggurkwar mem dumǝna tau-murǝm, kǝla mǝnana pàcau ka, dumǝna púp ama Adonija ka, à nǝ̀ wal-luí yalung!&gt;&gt; <verse eid="1KI 2:24" /><verse number="25" style="v" sid="1KI 2:25" />Nda Murǝm Solomon tasǝ Benaya muna-ɓwabura mala Jehoyada, sǝ wario kya zuɓi Adonija wal-luí.<verse eid="1KI 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 2:26" />Sǝ murǝm ne Abiyata pǝris ama, &lt;&lt;Nyare o a Anatot là mò, a nzali mô. A karǝna ɓǝà wal-luio, sǝama pa mǝ nǝ wal-luio adyan ɗàng, <note caller="+" style="f"><char style="fr" closed="false">2:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 23:6">1Sam 23:6</ref>; <ref loc="2SA 15:24">2Sam 15:24</ref>; <ref loc="2SA 15:29">2Sam 15:29</ref></char>.</note>acemǝnana wun nda mǝnana wu twalkiyi Akwati Kùrcau mala Yahweh Ɓakuli aɓadǝm tárrám Dauda, sǝ acemǝnana a nda atà tárrám aɓalǝ atanni male kat ka.&gt;&gt; <verse eid="1KI 2:26" /><verse number="27" style="v" sid="1KI 2:27" />Nda Solomon pǝr Abiyata a túró-pǝris mala Yahweh ka. Sǝ mǝno ka lumsǝ <note caller="+" style="f"><char style="fr" closed="false">2:27 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1SA 2:27-36">1Sam 2:27-36</ref></char>.</note>cau mala Yahweh, mǝnana Yahweh ne a Shilo amur ɓala [nggurkwar] mala Eli ka.<verse eid="1KI 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 2:28" />Lang Jowap ok cè gir mǝnana kum Adonija ka, kara ɓangŋa wari a Tara mǝfele mala Yahweh, kya bwal anjawe gyangŋan. Mǝno ka nda acemǝnana Jowap pu'nzǝm Adonija, sǝama pu'nzǝm Absalom ɗàng. <verse eid="1KI 2:28" /><verse number="29" style="v" sid="1KI 2:29" />À banggi Murǝm Solomon ama Jowap ɓangŋǝna warina a Tara mala Yahweh, sǝ nda a nkanggari gyangŋan. Pǝlǝa Solomon tasǝ Benaya muna-ɓwabura mala Jehoyada ama, &lt;&lt;Kyane, kya wal-luí!&gt;&gt;<verse eid="1KI 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 2:30" />Nda Benaya wari aɓa Tara mala Yahweh, sǝ ne Jowap ama, &lt;&lt;Murǝm na ama wu puro.&gt;&gt;</para>
  <para style="p" vid="1KI 2:30">Sǝ Jowap eari wi ama, &lt;&lt;Awo, mǝ nǝ wù kani.&gt;&gt;</para>
  <para style="p" vid="1KI 2:30">Benaya nyare wari aban murǝm sǝ banggi wi cau mǝnana Jowap na ka.<verse eid="1KI 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 2:31" />Pǝlǝa murǝm ne Benaya ama, &lt;&lt;Pàk kǝla mǝnana na ka. Wal-luí sǝ wu tsǝî. Anggo sǝ bafe mala nkila mǝnana Jowap sukki ɓà ka, nǝ̀ upi muram andǝ múr ɓala mala tárrám. <verse eid="1KI 2:31" /><verse number="32" style="v" sid="1KI 2:32" />Yahweh nǝ̀ mbweki wi a kúnì nkila mǝnana sukki ka, acemǝnana pà nǝ sǝlǝe mala tárrám Dauda ɗàng, wal-lú aburana ɓari nǝ nggeabyau, yià Abǝna muna-ɓwabura mala Ner, mǝ'sàrǝ̀ban mala amǝ'lwa mala Isǝrayila andǝ Amasa muna-ɓwabura mala Jeta, mǝ'sàrǝ̀ban mala amǝ'lwa mala Yahuda, aburana mǝnana à kútì nǝ cauɓoarna andǝ ɓoaro ka. <verse eid="1KI 2:32" /><verse number="33" style="v" sid="1KI 2:33" />Ɓǝ̀ bafe mala nkila malea nyar amur Jowap andǝ amǝ'ke tàtǝ́k. Sǝama amur Dauda andǝ nggurkwar male, andǝ ɓala male andǝ buno-murǝm male ka, ɓǝ̀ dorǝpwala pà kam nǝban Yahweh tàtǝ́k.&gt;&gt;<verse eid="1KI 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 2:34" />Pǝlǝa Benaya muna-ɓwabura mala Jehoyada wari aban gyangŋan sǝ zuɓi Jowap, wal-luí. À tsǝkbani a ɓala male a pǝɗanban. <verse eid="1KI 2:34" /><verse number="35" style="v" sid="1KI 2:35" />Murǝm twal Benaya muna-ɓwabura mala Jehoyada ɓǝ̀ duk mǝ'sàrǝ̀ban amur amǝ'lwa a kúnì Jowap, sǝ murǝm tsǝk Zadok pǝris ɓǝ̀ ak bancame mala Abiyata.<verse eid="1KI 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 2:36" />Pǝlǝa murǝm túrban ɓǝà tunǝ Shimeyi, sǝ banggi wi ama, &lt;&lt;Ɓakkî ɓamúrò ɓala a Urǝshalima, sǝ wu duk kam. Sǝama kǝa purì banì ace ká a ɓekǝ ban ɗàng. <verse eid="1KI 2:36" /><verse number="37" style="v" sid="1KI 2:37" />Pwari mǝnana a nying Urǝshalima sǝ a yálì Ɓangŋaban Kidǝron ngga, sǝlǝ ama mbak-kàngkàng awu nǝ̀ wǔ, sǝ nkila mò nǝ̀ ueo amuro.&gt;&gt;<verse eid="1KI 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 2:38" />Shimeyi eari murǝm ama, &lt;&lt;Cau mǝnana a bang ngga mǝɓoarne na. Guro mò nǝ̀ pak kǝla mǝnana ɓwamǝgule mem murǝm na ka.&gt;&gt; Nda Shimeyi do a Urǝshalima anonggio pas ka.<verse eid="1KI 2:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 2:39" />Sǝama anzǝm apǝlǝa tàrú ka, aguro mala Shimeyi ɓari ɓangŋa à o aban Akish muna-ɓwabura mala Ma'aka, murǝm Gat. Sǝ lang à banggi Shimeyi ama, &lt;&lt;Aguro mò na a Gat&gt;&gt; ka, <verse eid="1KI 2:39" /><verse number="40" style="v" sid="1KI 2:40" />Shimeyi lo sǝ tsǝki mǝdambǝriso male gir-do a nzǝmi, sǝ o a Gat a ban Akish ace alta aguro male. Shimeyi puro wari a Gat kya nyesǝ aguro male.<verse eid="1KI 2:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 2:41" />Lang à banggi Solomon ama Shimeyi nyingŋǝna Urǝshalima, warina a Gat sǝ nyarna ka, <verse eid="1KI 2:41" /><verse number="42" style="v" sid="1KI 2:42" />murǝm túrban à tunǝ Shimeyi sǝ ne wi ama, &lt;&lt;Ən tsǝo a kángir nǝ lullǝ Yahweh, sǝ ǝn nunkiro nǝma, &lt;A pwari mǝnana a nying Urǝshalima sǝ a o akǝ ban ngga, mbak-kàngkàng awu nǝ wù&gt; re? Sǝ we ka, a banggam ama, &lt;Cau mǝnana a bang ngga mǝɓoarne na. Mǝ nǝ kpate.&gt; <verse eid="1KI 2:42" /><verse number="43" style="v" sid="1KI 2:43" />Palang ado, sǝ a par kángir-nǝ-pàcau mǝnana a kána aɓa lullǝ Yahweh, sǝ a kpata cau mǝnana ǝn tsǝko nzongcau arǝì ka ɗàng?&gt;&gt;<verse eid="1KI 2:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 2:44" />Murǝm nyare ne Shimeyi ama, &lt;&lt;A sǝlǝna a ɓabumo yì ɓealɓikea mǝnana kat a pakkì tárrám Dauda ka. Adyan ngga, Yahweh nǝ̀ nyesǝô ɓealɓikea mô amuro. <verse eid="1KI 2:44" /><verse number="45" style="v" sid="1KI 2:45" />Sǝ Yahweh ka nǝ̀ tsǝkam bù, sǝ buno-murǝm mala Dauda nǝ̀ kum kusǝu-came pepè aɓadǝm Yahweh tàtǝ́k.&gt;&gt;<verse eid="1KI 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="1KI 2:46" />Pǝlǝa murǝm pe Benaya muna-ɓwabura mala Jehoyada nzongcau, nda Benaya puro wario kya wal-lú Shimeyi ka.</para>
  <para style="p" vid="1KI 2:46">Adyan ngga, domurǝm kumǝna kusǝu-came kàngkàng a bù Solomon.<verse eid="1KI 2:46" /></para>
  <chapter eid="1KI 2" />
  <chapter number="3" style="c" sid="1KI 3" />
  <para style="s1">Solomon zǝmbi Ɓakuli ɓǝ̀ pe wi sǝlǝe</para>
  <para style="r">(<ref loc="2CH 1:3-12">2 Acau la Apwari 1:3-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 3:1" />Solomon kùrɓǝla nǝ Firona, murǝm mala Masar. Al muna-ɓwama mala Firona, twali yinǝi a Nggea-là mala Dauda, sǝɓǝ̀ yi mal ɓak palta male, andǝ ɓala mala Yahweh, andǝ sheran mǝnana gumbǝli Urǝshalima ka. <verse eid="1KI 3:1" /><verse number="2" style="v" sid="1KI 3:2" />Arǝ apwari mǝno ka, aɓwana kǝ paɓoro mala agir'nkila malea arǝ amgbangban-peri atà ankúl mala alá malea acemǝnana à malaká ɓak ɓala ace Yahweh peatu ɗàng. <verse eid="1KI 3:2" /><verse number="3" style="v" sid="1KI 3:3" />Solomon <note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 6:5">Nggur 6:5</ref>; <ref loc="DEU 30:16">30:16</ref>; <ref loc="DEU 20">20</ref></char>.</note>earce Yahweh sǝ kpata kwarkiru mala tárrí Dauda, sǝama yì Solomon gbal ka, pà gir'nkila nǝ agirkusǝu sǝ paɓoro mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne amur amgbangban-peri atà ankúl.<verse eid="1KI 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 3:4" />A ɓè pwari ka, Murǝm Solomon wari a Gibiyon nǝ̀ nggá pà gir'nkila, acemǝnana akanó sǝ mgbangban-peri mǝgule pa. Amur gyangŋan mǝnana a ban mǝno ka sǝ Solomon kǝ pa gir'nkila nǝ agirkusǝu á-mwashat. <verse eid="1KI 3:4" /><verse number="5" style="v" sid="1KI 3:5" />A bu-dù mǝno ka <note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 9:2">9:2</ref>; <ref loc="1KI 11:9">11:9</ref></char>.</note>Yahweh yipì Solomon a lòrǝo a Gibiyon. Ɓakuli ne wi ama, &lt;&lt;Zǝm gir mǝnana kat a earkiyice ama mǝ po ka.&gt;&gt;<verse eid="1KI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 3:6" />Solomon bang ama, &lt;&lt;A lǝmdǝni guro mò, tárrám Dauda earcearǝu mǝgule mǝnana malkiyi raka acemǝnana gya aɓadǝmbo nǝ mǝsǝcau, andǝ ɓealɓoarna, sǝ nǝ ɓabumi kat. Sǝ a linadǝmba nǝ mǝnia yì earcearǝu mǝgule mana malkiyi raka, sǝ a panì wi muna-ɓwabura ɓǝ̀ do amur buno-murǝm male yalung.<verse eid="1KI 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 3:7" />&lt;&lt;Ado ka, Yahweh Ɓakuli mem, a tsǝ́ngŋǝ̀nám, mim guro mò amur buno-murǝm a kúnì tárrám Dauda, kat andǝ amani ama mǝ nda muna mǝkyauwe ka. Ən súrǝ̀ puro andǝ kutio ɗang. <verse eid="1KI 3:7" /><verse number="8" style="v" sid="1KI 3:8" />Mǝ ndya aɓalǝ aɓwana mô mǝnana a tària ka, nzali mǝgule mala aɓwapǝndǝa mǝnana à pà nǝ̀ gandǝ ɓallia raka, ace ɓiki làkkì malea. <verse eid="1KI 3:8" /><verse number="9" style="v" sid="1KI 3:9" />Acemani ka, pam ɓabum bwaltakusǝ gir, ace mǝnana mǝ súrǝ̀ lang sǝ mǝ nǝ yálmúr aɓwana mô aɓa mǝsǝcau, sǝ ɓǝn gauta mǝɓoarne andǝ mǝɓane. Ɓǝ̀ ana raka, yana ɓwe nǝ̀ gandǝ yálmúr aɓwana mǝgule mò man?&gt;&gt;<verse eid="1KI 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 3:10" />Mǝno yì gìr Solomon zǝm ngga pwasǝbum Yahweh. <verse eid="1KI 3:10" /><verse number="11" style="v" sid="1KI 3:11" />Pǝlǝa Ɓakuli ne wi ama, &lt;&lt;Acemǝnana a zǝmba ace kum sǝlǝe mala yálmúr aɓwana aɓa mǝsǝcau, sǝ a zǝmbi ɓamuro sauwa mala yilǝmu, ko kume, ko lú mala aɓio-mǝbura raka, <verse eid="1KI 3:11" /><verse number="12" style="v" sid="1KI 3:12" />mǝ nǝ pak gìr mǝnana a zǝm ngga. <note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 4:29-31">4:29-31</ref>; <ref loc="1KI 5:12">5:12</ref>; <ref loc="1KI 10:23-24">10:23-24</ref>; <ref loc="SNG 1:16">Ear 1:16</ref></char>.</note>Mǝ ndya ǝn nggǝ po ɓabum mala sǝlǝe andǝ bwaltakusǝ gir, mǝnana kǝɓwa pà kàm a dǝmba nǝ we kum ulangyi, sǝ kǝɓwa pà kàm nǝ̀ lo anzǝmo nǝ̀ kum ulangyi ka ɗàng. <verse eid="1KI 3:12" /><verse number="13" style="v" sid="1KI 3:13" />Ɗǝm ngga, mǝ ndya ǝn nggǝ po gìr mǝnana a zǝm raka, gulo andǝ kume, mǝnana à pà nǝ̀ kànì kǝ murǝm arǝò, a do'nza mò raka. <verse eid="1KI 3:13" /><verse number="14" style="v" sid="1KI 3:14" />Sǝ ɓǝ̀ awu nǝ kpata anjar mem, awu nǝ bwal anggurcau andǝ anzongcau mem, kǝla mǝnana tárró Dauda pak ka, mǝ nǝ tsǝk anonggio mô à nǝ̀ sau a ɓanza.&gt;&gt;<verse eid="1KI 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 3:15" />Solomon pǝlǝa loapi ntulo, sǝni ka lòrǝo na lòrǝ̀ ka.</para>
  <para style="p" vid="1KI 3:15">Pǝlǝa nyar a Urǝshalima, yi cam a ɓadǝm Akwati Kùrcau mala Yahweh, sǝ pà ɓoro nǝ agirkusǝu mala pisǝe kǝring andǝ mala dotarǝu. Pǝlǝa tunǝ amǝ'tè kat, ace lì girlina banɓoarnado.<verse eid="1KI 3:15" /></para>
  <para style="s1">Solomon lǝmdǝ sǝlǝe arǝ pak ɓashi mǝkwane</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 3:16" />A ɓè fara ka, amāgúng ɓari yiu aɓadǝm Murǝm Solomon ace ɓashi. <verse eid="1KI 3:16" /><verse number="17" style="v" sid="1KI 3:17" />Mwashat ateà bang ama, &lt;&lt;Ɓǝ̀ rǝo pwalo Murǝm, mim sǝnǝ ɓwama man ngga, sǝm do a ɓala mǝmwashati. Ən gbáshí muna, sǝ yi ka ndakam atàm a ɓala. <verse eid="1KI 3:17" /><verse number="18" style="v" sid="1KI 3:18" />Anzǝm nongŋo tàrú ka, pǝlǝa gbáshí muna gbal. Sǝm nda sǝm ɓari nǝmurǝ sǝm; kǝɓwa pa atà sǝm a ɓala ɗàng; kǝ sǝm ɓari na mana a ɓala ka. <verse eid="1KI 3:18" /><verse number="19" style="v" sid="1KI 3:19" />Nǝ dú ka, ɓwama mǝnia [ɗǝ́nggǝ́lya aɓa ntulo], nong amur muni, muni wú. <verse eid="1KI 3:19" /><verse number="20" style="v" sid="1KI 3:20" />Pǝlǝa lo nǝ ɓadu yi twal munem a ɓadǝmbam, mǝnana mǝ nda a ntulo ka. Kya nongsǝ munem a ɓadǝmbi, sǝ yi nongsǝàm lú muni a ɓadǝmbam. <verse eid="1KI 3:20" /><verse number="21" style="v" sid="1KI 3:21" />Lang ǝn lo nǝ dǝmbari mǝ nǝ pe munem kiura ka, kara lú muna na ǝn sǝn ngga! Bankwarna ka, ǝn pelǝki muna pepè, sǝ ǝn sǝni ka munem mǝnana ǝn ɓǝl ka nda ɗang.&gt;&gt;<verse eid="1KI 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 3:22" />Sǝ ɓè ɓwama mǝno ka, bang ama, &lt;&lt;Awo! Muna mǝnana nǝyilǝmu ka mema, sǝ lú muna ka mona!&gt;&gt;</para>
  <para style="p" vid="1KI 3:22">Sǝ ɓwama mǝdǝmbe ka ɓinǝe, na ama, &lt;&lt;Awo! Lú muna ka mona; sǝ muna mǝnana nǝyilǝmu ka mema!&gt;&gt; Anggo sǝ à camarǝ makgìr a ɓadǝm murǝm.<verse eid="1KI 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 3:23" />Murǝm pǝlǝa bang ama, &lt;&lt;Koyan atà wun ngga bang ama muna mǝnana nǝyilǝmu ka male na, sǝ lú muna ka nda mala ɓì.&gt;&gt; <verse eid="1KI 3:23" /><verse number="24" style="v" sid="1KI 3:24" />Pǝlǝa murǝm túrban ama, &lt;&lt;Wu yinǝàm nǝ nggeabyau!&gt;&gt; Lang à yinanǝ nggeabyau ka, <verse eid="1KI 3:24" /><verse number="25" style="v" sid="1KI 3:25" />murǝm bang ama, &lt;&lt;Wu kwar muna mǝnana nǝyilǝmu ka, wu gauwi ɓari, wu pè koya ɓwama ateà ka banì mwashat mala agauwe ɓari mala munê.&gt;&gt;<verse eid="1KI 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 3:26" />Sǝ ɓwama mǝnana nda nggea muna mǝnana nǝyilǝmu ka, ɓabumi ndǝli nǝ mǝsǝswatǝr ace muni. Ɓwame ne murǝm ama, &lt;&lt;Awo, ɓwamǝgule mem! Wu pe wi munê mǝnana nǝyilǝmu ka. Usheni, wu kǝa wal-luí ɗàng!&gt;&gt;</para>
  <para style="p" vid="1KI 3:26">Sǝ ɓè ɓwama mǝno ka bang ama, &lt;&lt;Ɓǝà kǝa pam ɗàng, sǝ ɓǝà kǝa pe wi ɗàng. Ɓǝà gauwi ɓari!&gt;&gt;<verse eid="1KI 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 3:27" />Pǝlǝa murǝm kasǝ ɓashi bang ama, &lt;&lt;Wu kǝa wal-lú munê ɗàng. Wu pe ɓwama mǝnana earce muna ɓǝ̀ dum nǝyilǝmu ka. Yì nda kǝ nggea munê.&gt;&gt;<verse eid="1KI 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 3:28" />Lang amǝ'Isǝrayila ok cau mala kasǝ ɓashi mǝnana Murǝm Solomon kasǝ ka, à lùmsǝ nǝ pagulo kǝ̀rkǝ́r arǝì, acemǝnana à sǝn sǝlǝe mǝnana Ɓakuli pe wi mala pakɓashi aɓa mǝsǝcau ka.<verse eid="1KI 3:28" /></para>
  <chapter eid="1KI 3" />
  <chapter number="4" style="c" sid="1KI 4" />
  <para style="s1">Amǝgulo mala Solomon</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 4:1" />Adyan ngga, Solomon nda murǝm amur Isǝrayila puppup. <verse eid="1KI 4:1" /><verse number="2" style="v" sid="1KI 4:2" />Sǝ amǝnia ka, à nda ka amǝgulo male:</para>
  <para style="li1" vid="1KI 4:2">Azariya muna-ɓwabura mala Zadok ka nda pǝris;<verse eid="1KI 4:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="1KI 4:3" />Elihoref andǝ Ahija amuna-burana mala Shisha ka, à nda ka amǝ'gilǝgir;</para>
  <para style="li1" vid="1KI 4:3">Jehoshafat muna-ɓwabura mala Ahilud nda mǝ'twalcau aɓa malǝmce;<verse eid="1KI 4:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="1KI 4:4" />Benaya muna-ɓwabura mala Jehoyada nda mǝ'sàrǝ̀ban mala amǝ'lwa;</para>
  <para style="li1" vid="1KI 4:4">Zadok andǝ Abiyata ka, à nda ka apǝris;<verse eid="1KI 4:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="1KI 4:5" />Azariya muna-ɓwabura mala Natan ngga, nda ɓwamǝgule mala amǝgulo;</para>
  <para style="li1" vid="1KI 4:5">Zabud muna-ɓwabura mala Natan ngga, nda pǝris, sǝ nda gyajam mala murǝm;<verse eid="1KI 4:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="1KI 4:6" />Ahishar nda ɓwamǝgule mala ɓala-murǝm;</para>
  <para style="li1" vid="1KI 4:6">Adoniram muna-ɓwabura mala Abda nda mǝɗenyi nǝ túró-púp.<verse eid="1KI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 4:7" />Solomon ngga ndanǝ anggwamna lum-nong-ɓari amur Isǝrayila kat, mǝnana à kǝ yinǝi wi nǝ girlina aceì andǝ ɓala-murǝm ngga. Koya nggwamna ka, kǝ yinǝ girlina mala zongŋo mwashat aɓa pǝlǝa. <verse eid="1KI 4:7" /><verse number="8" style="v" sid="1KI 4:8" />Amǝnia ka, à nda ka alullǝ anggwamnê:</para>
  <para style="li1" vid="1KI 4:8">Ben-Hur, a bu-nzali múr ankono mala Ifǝrem;<verse eid="1KI 4:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="1KI 4:9" />Ben-Deker, a nggea-là Makaz, andǝ Sha'albin andǝ Bet-Shemesh, andǝ Elon-Bet-Hanan;<verse eid="1KI 4:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="1KI 4:10" />Ben-Hesed, a nggea-là Arubbot (Soko andǝ anzali mala Hefer kat ka, à nda aɓate.)<verse eid="1KI 4:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="1KI 4:11" />Ben-Abinadap, a Nafat-Dor (yì na al Tafat ɓoarnsarile Solomon ngga);<verse eid="1KI 4:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="1KI 4:12" />Ba'ana muna-ɓwabura mala Ahilud, a Ta'anak andǝ Megiddo, andǝ Bet-Shan mǝnana nda a nkanggari Zaretan ɓǝ a sùlǝî Jezǝril ka, sǝ lo a Bet-Shan aban ká Abel-Mehola, sǝ sárǝ́ aban ká Jokmeyam;<verse eid="1KI 4:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="1KI 4:13" />Ben-Geber, a Ramot Gilǝyat (alá mala Jayir muna-ɓwabura mala Manasa, mǝnana à nda a Gilǝyat, andǝ bareban mala Argop mǝnana nda a Bashan ngga, anggea-là mǝgulke lumi-tongno-nong-mwashat (60) mana à ndanǝ asheran sǝ akún nggea-lê ka, à pea nǝ bolo-bángŋá ka, à nda aɓate.)<verse eid="1KI 4:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="1KI 4:14" />Ahinadap muna-ɓwabura mala Iddo, a Mahanayim.<verse eid="1KI 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="1KI 4:15" />Ahima'az (mǝnana al Basemat ɓoarnsarile Solomon ngga), a Naftali;<verse eid="1KI 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="1KI 4:16" />Ba'ana muna-ɓwabura mala Hushai, a Asha andǝ Beyalot;<verse eid="1KI 4:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="1KI 4:17" />Jehoshafat muna-ɓwabura mala Paruwa, a Isaka;<verse eid="1KI 4:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="1KI 4:18" />Shimeyi muna-ɓwabura mala Ela, a Benjami;<verse eid="1KI 4:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="1KI 4:19" />Geber muna-ɓwabura mala Uri, a Gilǝyat (yì nzali mala Sihon murǝm mala amǝ'Amor andǝ nzali mala Og murǝm mala Bashan); sǝ yì ka nda mǝgulo nǝmurǝi mǝnana nda amur nzalinì ka.<verse eid="1KI 4:19" /></para>
  <para style="s1">Gǝna andǝ sǝlǝe mala Solomon</para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 4:20" />Aɓwana mala Yahuda andǝ Isǝrayila lakki kǝ̀rkǝ́r kǝla <note caller="+" style="f"><char style="fr" closed="false">4:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 22:17">Tite 22:17</ref></char>.</note>mǝsǝsala a kún nggeamùr; à lili, à nu sǝ banɓoaria wia. <verse eid="1KI 4:20" /><verse number="21" style="v" sid="1KI 4:21" /><note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 15:18">Tite 15:18</ref>; <ref loc="2CH 9:26">2Acau 9:26</ref></char>.</note>Sǝ Solomon yálmúr adomurǝm kat tite a Nggeasala Yiufǝretis aban ká nzali mala amǝ'Filisti, sǝ sárǝ́ aban ká kún nzong-nzali mala amǝ'Masar. <note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="PSA 68:29">Ang 68:29</ref>; <ref loc="PSA 72:10-11">72:10-11</ref></char>.</note>Amǝnia yì anzali ka, à kǝ yinǝì Solomon boalo-cemi, sǝ à kǝ pàkki wi túró ba do-yilǝmu male kat.<verse eid="1KI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 4:22" />Girlina mala Solomon a pwari mwashat ka, buku lumi-tàrú (30) mala muku mǝssa-alkama na andǝ buku lumi-tongno-nong-mwashat (60) mala muku mǝssa, <verse eid="1KI 4:22" /><verse number="23" style="v" sid="1KI 4:23" />andǝ andá mǝnana à lǝsǝia a ɓala ka lum (10), andǝ andá mǝnana à lǝsǝia a bondo ka lumi-ɓari (20), andǝ anzur andǝ ambul gbǝman-mwashat (100), sǝ ambamba andǝ aɓwacembe andǝ alùrú, sǝ anggu mǝnyangge. <verse eid="1KI 4:23" /><verse number="24" style="v" sid="1KI 4:24" />Solomon yálmúr bareban kat andǝ amurǝma mǝnana a njar-nzali mala Yiufǝretis ka, twal a Tifsa aban ká Gaza, sǝ do aɓa rǝpwala andǝ anzali mǝnana a nkanggari ka. <verse eid="1KI 4:24" /><verse number="25" style="v" sid="1KI 4:25" />Aɓa do-yilǝmu mala Solomon kat ka Yahuda andǝ Isǝrayila duk jam, twal a Dan aban ká Biyasheba. Koya ɓala ka ndanǝ male yì anggun-anap andǝ anggun-vwari.<verse eid="1KI 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 4:26" />Solomon ndanǝ andà-ka-pǝr á-lumi-ine (40,000) ace apǝr male mǝnana à kǝ nun awaru-pǝr male ka, andǝ amǝpǝr á-lum-nong-ɓari (12,000).<verse eid="1KI 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 4:27" />Koya nggwamna ka, ndanǝ zongŋo male mǝnana kǝ yinǝi Murǝm Solomon girlina sǝ ace aɓwana mǝnana à kǝ̀ li girlina atārǝia andǝa murǝm ngga. À yinǝ gir mǝnana kat murǝm earkiyice ka. <verse eid="1KI 4:27" /><verse number="28" style="v" sid="1KI 4:28" />Ɗǝm ngga, à yinǝ mǝssa-bálì andǝ bondo ace apǝr andǝ apǝr-lwa a ban mǝnana à earce ɓǝà kyan nǝia kam ngga; koyan ngga pè kǝla mǝnana à tsǝki wi ka.<verse eid="1KI 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 4:29" />Ɓakuli pè Solomon sǝlǝe mǝgule andǝ bwaltagir mǝlime, andǝ súrǝè, kǝla làkkì mala mǝsǝsala a kún nggeamùr. <verse eid="1KI 4:29" /><verse number="30" style="v" sid="1KI 4:30" />Sǝlǝe mala Solomon kútì sǝlǝe mala aɓwana mǝnana kat a takuli ka, andǝ sǝlǝe mala nzali Masar kat. <verse eid="1KI 4:30" /><verse number="31" style="v" sid="1KI 4:31" />Solomon kútì koya ɓwa ka nǝ sǝlǝe; sǝlǝe male kútì mala Etan ɓwa Ezǝra, andǝ Heman, andǝ Kalkol, andǝ Darda, amuna-burana mala Mahol. Lullǝì mesǝe aɓalǝ anzali mǝnana kat à gumbǝliban ngga. <verse eid="1KI 4:31" /><verse number="32" style="v" sid="1KI 4:32" />Solomon bang acau <note caller="+" style="f"><char style="fr" closed="false">4:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="PRO 1:1">Pas 1:1</ref>; <ref loc="ECC 12:9">Ham 12:9</ref></char>.</note>pasǝlǝe á-tàrú (3,000) sǝ tsǝk <note caller="+" style="f"><char style="fr" closed="false">4:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="SNG 1:1">Ear 1:1</ref></char>.</note>anggyal á-mwashat nǝ mǝsǝi tongno (1,005). <verse eid="1KI 4:32" /><verse number="33" style="v" sid="1KI 4:33" />Bangcau amur agirpwala, tite nǝ anggun-Seda mala Lebano yi sulǝo amur bondo hissop mǝnana kǝ to arǝ sheran ngga. Ɗǝm ngga, bangcau amur agirkusǝu, andǝ anyal, andǝ agir-nzali, andǝ anji. <verse eid="1KI 4:33" /><verse number="34" style="v" sid="1KI 4:34" />Aɓwana mala anzali kat yiu ace ok sǝlǝe mala Solomon; à purkio arǝ abân mala amurǝma kat mala ɓanza mǝnana à ok cau mala sǝlǝe mala Solomon ngga.<verse eid="1KI 4:34" /></para>
  <chapter eid="1KI 4" />
  <chapter number="5" style="c" sid="1KI 5" />
  <para style="s1">Solomon ramba agir ɓak ɓala mala Yahweh</para>
  <para style="r">(<ref loc="2CH 2:1-18">2 Acau la Apwari 2:1-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 5:1" />Lang Hiram murǝm Taya ok ama à ɗārǝna Solomon ɓǝ̀ duk murǝm a kúnì tárrí ka, tasǝ amǝ'túró-ɓala male abanì [ɓǝà makkìkún] acemǝnana Hiram ngga, gyajam mala Dauda na aɓa do malea kat.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 5:11">2Sam 5:11</ref>; <ref loc="1CH 14:1">1Acau 14:1</ref></char>.</note> <verse eid="1KI 5:1" /><verse number="2" style="v" sid="1KI 5:2" />Solomon túrban nǝ cau aban Hiram ama:<verse eid="1KI 5:2" /></para>
  <para style="pi">
    <verse number="3" style="v" sid="1KI 5:3" />&lt;&lt;A sǝlǝna ama tárrám Dauda ka gandǝnǝ ɓak ɓala ace lullǝ Yahweh Ɓakuli male ɗàng, atàcau mala alwa-lwa mǝnana aɓi-mǝbura gumbǝli nǝi ka, she lang Yahweh pàni wi limurǝm amúrià ka. <verse eid="1KI 5:3" /><verse number="4" style="v" sid="1KI 5:4" />Sǝ ado ka, Yahweh Ɓakuli mem panam usǝlǝo a koya buì ka. Ən pànǝ ɓekǝ ɓiu-mǝbura ko gìr-kumban mǝɓike ɗàng. <verse eid="1KI 5:4" /><verse number="5" style="v" sid="1KI 5:5" />Acemani ka, mǝ ndarǝ na nǝma mǝ nǝ ɓak ɓala ace lullǝ Yahweh Ɓakuli mem, <note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 7:13">2Sam 7:13</ref>; <ref loc="1CH 17:12">1Acau 17:12</ref>; <ref loc="1CH 22:10">22:10</ref>; <ref loc="1CH 28:6">28:6</ref></char>.</note>kǝla mǝnana Yahweh banggi tárrám Dauda, ama, &lt;Munio mǝnana Mǝ nǝ tsǝi amur buno-murǝm a kunio ka, nda mǝnana nǝ̀ ɓak ɓala ace lullǝam ngga.&gt;<verse eid="1KI 5:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="1KI 5:6" />&lt;&lt;Acemani ka, tsǝa ɓǝà kasǝâm anggun-seda mala Lebano. Aburana mem andǝ amô nǝ̀ paktúró atārǝia, sǝ mǝ nǝ mbweka aburana mô gìr mǝnana kat awu nǝ kasǝ ka; sǝ kǝla mǝnana a sǝlǝ ka, kǝɓwa pà kàm aɓalǝ sǝm mǝnana sǝlǝ kasǝ nggun kǝla amǝ'Sidon ma'wun ngga ɗàng.&gt;&gt;<verse eid="1KI 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 5:7" />Lang Hiram ok cau mala Solomon ngga, banɓoari wi kǝ̀rkǝ́r sǝ bang ama, &lt;&lt;Ɓwangsǝban ɓǝ̀ pa aban Yahweh a pwari man yalung ngga, acemǝnana panî Dauda muna-ɓwabura mǝ'sǝlǝe ace yálmúr mǝnia yì nzali mǝgule ka.&gt;&gt; <verse eid="1KI 5:7" /><verse number="8" style="v" sid="1KI 5:8" />Hiram tasǝî Solomon ban nǝ cau ama:</para>
  <para style="pi" vid="1KI 5:8">&lt;&lt;Ən ongŋǝna cau mǝnana a tasǝami ka. Ən earna mǝ nǝ po akpamgbang mala nggun-seda andǝ mala nggun-sapǝre mǝnana a earce ka. <verse eid="1KI 5:8" /><verse number="9" style="v" sid="1KI 5:9" />Aburana mem nǝ̀ pwania a Lebano, sǝ à nǝ̀ kánia a kún nggeamùr. Sǝ mǝ nǝ tsǝa à nǝ̀ kurkia arǝarǝia, sǝ à nǝ̀ kyalnǝia amur nggeamùr aban ká a ban mǝnana a bang ngga. A ban mǝno ka, mǝ nǝ tsǝa à nǝ̀ panzǝkia, sǝ awu nǝ̀ pwania. Gìr mǝnana ǝn earce wu pam ngga nda girlina ace aɓwana mem mana a palta.&gt;&gt;<verse eid="1KI 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 5:10" />Nda Hiram pè Solomon agbǝlang nggun-seda andǝ amala nggun-sapǝre mǝnana kat earce ka. <verse eid="1KI 5:10" /><verse number="11" style="v" sid="1KI 5:11" />Solomon pǝlǝa pè Hiram abuku mala mǝssa-alkama á-lumi-ɓari (20,000) andǝ mùrú olif lita á-gbǝman-ine (400,000) ace linǝ aɓwana male; anggo sǝ kǝ pe wi koya pǝlǝa. <verse eid="1KI 5:11" /><verse number="12" style="v" sid="1KI 5:12" />Yahweh pè Solomon sǝlǝe kǝla mǝnana kánbi wi ka. Sǝ Hiram andǝ Solomon kùrcau arǝarǝia mala do aɓa rǝpwala.<verse eid="1KI 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 5:13" />Murǝm Solomon tsǝk aɓwana á-lumi-tàrú (30,000) aɓa túró-púp arǝ abân aɓa Isǝrayila kat. <verse eid="1KI 5:13" /><verse number="14" style="v" sid="1KI 5:14" />Tasǝia a Lebano ace pàk túrô, aɓwana á-lum (10,000) koya zongŋo. Koya ɓwa ka pàk zongŋo mwashat a Lebano, sǝ nǝ̀ nyare a là nǝ̀ pàk azongŋo ɓari. Adoniram nda ɓwamǝgule amúrià ace sǝntà túrè. <verse eid="1KI 5:14" /><verse number="15" style="v" sid="1KI 5:15" />Solomon ngga ndanǝ amǝ'pwan-tali á-lumi-tongno-nong-ɓari (70,000), andǝ amǝ'kasǝ-tali, andǝ amǝ'kpalikirǝ-tali á-lumi-tongno-nong-tàrú (80,000) amur ankono, <verse eid="1KI 5:15" /><verse number="16" style="v" sid="1KI 5:16" />sǝ ndanǝ amǝ'sǝntà-túrô á-tàrú nǝ gbǝman-tàrú (3,300) ace gingnǝ amǝ'túrô. <verse eid="1KI 5:16" /><verse number="17" style="v" sid="1KI 5:17" />Aɓa kpata nê mala murǝm Solomon ngga, amǝ'túrô pusǝki atali mǝgulke andǝ amǝɓoarne a ban mǝnana à ɓunnia ka, sǝ à gilǝkirǝia ace nongsǝ kusǝɓa mala ɓala mala Yahweh. <verse eid="1KI 5:17" /><verse number="18" style="v" sid="1KI 5:18" />Anggo sǝ amǝ'ɓa mǝnana Solomon andǝ Hiram yinǝia, andǝ aburana mala <note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 13:5">Jes 13:5</ref>; <ref loc="EZK 27:9">Ezǝk 27:9</ref></char>.</note>Gebal ka à pàk túró mala kasǝ anggun, andǝ gilǝkirǝ atali ace ɓak ɓala mala Yahweh.<verse eid="1KI 5:18" /></para>
  <chapter eid="1KI 5" />
  <chapter number="6" style="c" sid="1KI 6" />
  <para style="s">Solomon ɓak ɓala mala Yahweh a Urǝshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 6:1" />Anzǝm apǝlǝa gbǝman-ine nǝ lumi-tongno-nong-tàrú (480) mǝnana amǝ Isǝrayila purnǝì nzali Masar, a inea pǝlǝa mala do-bunomurǝm mala Solomon amur amǝ Isǝrayila, a ɓaria zongŋo, zongŋo Ziv ka, Solomon tita túró mala ɓak ɓala mala Yahweh. <verse eid="1KI 6:1" /><verse number="2" style="v" sid="1KI 6:2" />Ɓala mǝnana Murǝm Solomon ɓakkî Yahweh ka, sauwa male ka ɓakusǝu lumi-tongno-nong-ine (90) na, tangŋa male ka ɓakusǝu lumi-tàrú (30) na, sǝ dāh'rya male ka ɓakusǝu lumi-ine-bwamdǝ-tongno (45) na. <verse eid="1KI 6:2" /><verse number="3" style="v" sid="1KI 6:3" />Sauwa mala Jamloro mǝnana sarǝa a ɓadǝm, sǝ karǝa arǝ sauwa mala ban-mǝfele mala ɓalae ka, ɓakusǝu lumi-tàrú (30) na. Sǝ tangŋa male mǝnana purî ɓadǝm Ban-mǝfele ka ɓakusǝu lum-bwamdǝ-tongno (15) na. <verse eid="1KI 6:3" /><verse number="4" style="v" sid="1KI 6:4" />Pàk amǝsǝkurǝm mǝɓweari mǝnana à eau-kam a kuli arǝ bumkurǝm mala ɓalae ka. <verse eid="1KI 6:4" /><verse number="5" style="v" sid="1KI 6:5" />Nongsǝ kusǝɓa mǝtangŋe mǝnana kàrìban kat ka, arǝ abumkurǝm mala ankanggariban mala Ban-mǝfele andǝ nzǝm Ban Nggea-mǝfele, sǝ ɓakki akurǝm-giriban amurí kàrìban. <verse eid="1KI 6:5" /><verse number="6" style="v" sid="1KI 6:6" />Tangŋa mala akurǝm mǝnana a nzali ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú (7 ½) na; tangŋa mala akurǝm-kuli mǝnana amur amǝnana a nzali ka, ɓakusǝu tongno-nong-ine (9) na, sǝ akurǝm-kuli mǝnana à masǝlǝa a kuli ka, tangŋa malea na ɓakusǝu lum nǝ gauwa-tsùrú (10 ½). Nying abân pa gbasha à kàrìban a nza arǝ bumkurǝm mala ɓalae ace mǝnana anggun-gbasha mana à tamsǝkia ace pa gbasha arǝ akurǝm-kuli ka ɓǝa kǝa kutiki arǝ abumkurǝm mala ɓalae ɗàng.<verse eid="1KI 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 6:7" />Lang à ndarǝ ɓak ɓalae ka, kǝ atali mǝnana à gilǝkinarǝia a ban mǝnana à ɓunnia kàm ngga, nda à pàngŋǝ̀nà-túró nǝia ka; à ok ɓekǝ gi ndolo, ko bero, ko mala ɓekǝ girtúró mala bolo-candǝa aɓa ɓalae lang à ndarǝ ɓe ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="1KI 5:17">1Amur 5:17</ref></char>.</note><verse eid="1KI 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 6:8" />Bankutio aban ká aɓa kurǝm-nzali ka, nda atà bu-mǝli mala ɓalae; njar ban-eauwe mǝpurǝke na kam aɓalǝi mǝnana à nǝ̀ eau nǝi aban ká a kurǝm-kuli mǝnana a tsùrú ka, sǝ lo akano a kurǝm-kuli mǝnana a tsùrú ka, ɓè na kam ace eauwe aban ká a masǝlǝata kurǝm-kuli mǝnana a ɓongban ngga. <verse eid="1KI 6:8" /><verse number="9" style="v" sid="1KI 6:9" />Anggo sǝ Solomon ɓak ɓalae sǝ mali; sǝ gìr múrí nǝ agbǝlang andǝ akpamgbang mala nggun-seda. <verse eid="1KI 6:9" /><verse number="10" style="v" sid="1KI 6:10" />Dāh'rya mala koya kurǝm [andǝ kurǝm-kuli] mǝno ɓakkia ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú (7 ½) na; sǝ kpapikia arǝ ɓalae nǝ agbǝlang nggun-seda.<verse eid="1KI 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 6:11" />Pǝlǝa cau mala Yahweh yiu aban Solomon ama, <verse eid="1KI 6:11" /><verse number="12" style="v" sid="1KI 6:12" />&lt;&lt;Amur cau mala ɓala mǝnia a kǝ ɓè ka, ɓǝ̀ awu nǝ kpata anê mem, awu nǝ gya aɓalǝ anggurcau mem sǝ awu nǝ dum nǝ okiru arǝ anzongcau mem kat ka, mǝ nǝ lùmsǝ pacau mem a bano, yì pacau mǝnana ǝn pa aban tárró Dauda ka. <verse eid="1KI 6:12" /><verse number="13" style="v" sid="1KI 6:13" />Mǝ nǝ do aɓalǝ amǝ Isǝrayila sǝ pà mǝ nǝ pǝlǝ nzǝmam arǝ aɓwana mem Isǝrayila ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 25:8">Pur 25:8</ref>; <ref loc="DEU 31:6">Nggur 31:6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="JOS 1:5">Jes 1:5</ref></char>.</note><verse eid="1KI 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 6:14" />Nda Solomon ɓak ɓalae sǝ mali ka. <verse eid="1KI 6:14" /><verse number="15" style="v" sid="1KI 6:15" />Tsǝki akpamgbang mala nggun-seda a nkanggariarǝia à gìr abumkurǝm andǝ nkigir mala ɓalae nǝ ɓalǝu; sǝ a nzali a ɓakurǝm ngga nongsǝki akpamgbang mala nggun-sapǝre. <verse eid="1KI 6:15" /><verse number="16" style="v" sid="1KI 6:16" />Twal arǝ bumkurǝm mala nzǝmban nǝ ɓá ɓalae ka, kasǝ banfana ɓakusǝu lumi-tàrú (30), sǝ kàrì nǝ atsarkan mala akpamgbang nggun-seda, lo a nzali kya bik ban nkigir; ɓak mǝnia ka ace mǝnana ɓǝ̀ duk ban-mǝfele mǝ'ɓaɓalǝuî, yì Ban Nggea-mǝfele. <verse eid="1KI 6:16" /><verse number="17" style="v" sid="1KI 6:17" />A ɓadǝm Ban Nggea-mǝfele mǝnia ka, nda Ban-mǝfele. Sauwa male ka ɓakusǝu lumi-tongno-nong-mwashat (60) na. <verse eid="1KI 6:17" /><verse number="18" style="v" sid="1KI 6:18" />Abumkurǝm mala ɓá ɓalae ka, à gìria kat nǝ akpamgbang mala nggun-seda; kǝ tali pa kàm mǝnana à nyì lǝmdǝ ka ɗàng. Sǝ arǝ akpamgbang mala nggun-seda mǝnia aɓa ɓalae ka, à shàr pǎ mala afufe andǝ apwasǝo-bondo.<verse eid="1KI 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 6:19" />Solomon gilǝki ban aɓa Ban Nggea-mǝfele, ace tsǝk Akwati Kùrcau mala Yahweh kàm. <verse eid="1KI 6:19" /><verse number="20" style="v" sid="1KI 6:20" />A ɓadǝm Ban Nggea-mǝfele ka, gyangŋan mala nggun-seda na kam. Sauwa mala Ban Nggea-mǝfele ka karǝa andǝ tangŋa andǝ dāh'rya male, sǝ ɓakusǝu lumi-tàrú (30) na. Solomon tasǝ ɓālǝi nǝ bolo-njengǝlan mǝɓoarne. <verse eid="1KI 6:20" /><verse number="21" style="v" sid="1KI 6:21" />Solomon tasǝ cili ɓá ɓalae nǝ bolo-njengǝlan mǝɓoarne, sǝ pàk ansolo bolo-njengǝlan ace gbàr bankutio aɓa Ban Nggea-mǝfele, sǝ tasǝ ɓālǝi nǝ bolo-njengǝlan. <verse eid="1KI 6:21" /><verse number="22" style="v" sid="1KI 6:22" />Tasǝ ɓá ɓalae puppup nǝ bolo-njengǝlan she lang gìrnì kat-kat ka; sǝ gyangŋan mǝnana a ɓadǝm Ban Nggea-mǝfele ka, tasǝ rǝi kat nǝ bolo-njengǝlan.<verse eid="1KI 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 6:23" />Aɓa Ban Nggea-mǝfele ka, tsǝk aɓǝ̀nzál mala acerup ɓari mǝnana à shària nǝ nggun olif ka; dāh'rya mala komǝye atea ka ɓakusǝu lum-bwamdǝ-tongno (15) na. <verse eid="1KI 6:23" /><verse number="24" style="v" sid="1KI 6:24" />Sauwa mala nkpamtari cerup ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú (7 ½) na, sǝ sauwa mala ɓè nkpamtari cerup ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú (7 ½) na. Sǝ mǝnna mala ankpamtari cerup ka ɓakusǝu lum-bwamdǝ-tongno na. <verse eid="1KI 6:24" /><verse number="25" style="v" sid="1KI 6:25" />Anggo gbal, mǝnna mala ankpamtari ɓaria cerup ka ɓakusǝu lum-bwamdǝ-tongno na; acerup mǝnia ɓari ka à kārǝ́ gǝ̀rgǝ̀r a gulo malea andǝ nggunrǝia, <verse eid="1KI 6:25" /><verse number="26" style="v" sid="1KI 6:26" />sǝ dāh'rya mala komǝye atea ka ɓakusǝu lum-bwamdǝ-tongno na. <verse eid="1KI 6:26" /><verse number="27" style="v" sid="1KI 6:27" />Tamsǝ acerup mǝnia ka à came a nkanggariarǝia aɓa Ban Nggea-mǝfele, ankpamtaria mǝnna. Nkpamtari mwashat mala cerup man mwashat ka mǝnna je rǝ bumkurǝm a bu-mǝli, sǝ nkpamtari mwashat mala ɓè cerup ka mǝnna je rǝ bumkurǝm a bu-mǝnggare, sǝ ɓaria nkpamtari koya cerup ka mǝnna je mala ɓì a tsùrú; <verse eid="1KI 6:27" /><verse number="28" style="v" sid="1KI 6:28" />Solomon tasǝ rǝ acerup mǝnia ka nǝ bolo-njengǝlan.<verse eid="1KI 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 6:29" />Abumkurǝm mala akurǝm mǝnia ɓari, yì Ban-mǝfele andǝ Ban Nggea-mǝfele ka, à mbàkì rǝia kat nǝ acerup, andǝ anggun-nkangga andǝ apwasǝo-bondo mǝnana à shària ka. <verse eid="1KI 6:29" /><verse number="30" style="v" sid="1KI 6:30" />Tasǝ ɓālǝ-akurǝm mala ɓalae nǝ bolo-njengǝlan, yì ɓālǝ Ban-mǝfele andǝ ɓālǝ Ban Nggea-mǝfele yia kǝm. <verse eid="1KI 6:30" /><verse number="31" style="v" sid="1KI 6:31" />Ace bankutio aɓa Ban Nggea-mǝfele ka, à pàk alǝpikúnkurǝm, nǝ nggun olif, sǝ tangŋa mala anggun-kun'ndá andǝ múr-kun'ndá ka gauwe mwashat aɓa gauwe tongno mala tangŋa mala Ban-mǝfele na. <verse eid="1KI 6:31" /><verse number="32" style="v" sid="1KI 6:32" />Alǝpikúnkurǝm mǝnia à pea nǝ nggun olif ka, à mbàkì rǝia nǝ acerup, andǝ anggun-nkangga andǝ apwasǝo-bondo mǝnana à shària ka; sǝ acerup, andǝ anggun-nkangga andǝ apwasǝo-bondo ka, à gìr múrià nǝ bolo-njengǝlan mǝnana à walki ka. <verse eid="1KI 6:32" /><verse number="33" style="v" sid="1KI 6:33" />Bankutio aɓa Ban-mǝfele gbal ka pàkki wi anggun-kun'ndá nǝ nggun olif, sǝ tangŋa male ka, gauwe mwashat aɓa gauwe ine mala tangŋa mala Ban-mǝfele na. <verse eid="1KI 6:33" /><verse number="34" style="v" sid="1KI 6:34" />Ɗǝm ngga pàk alǝpikúnkurǝm ɓari nǝ nggun-sapǝre, sǝ komǝye atea ka ndanǝ ambui ɓari mana à kǝ pǝlǝa aɓalǝ ankpako malea ka. <verse eid="1KI 6:34" /><verse number="35" style="v" sid="1KI 6:35" />Shàr acerup, andǝ anggun-nkangga andǝ apwasǝo-bondo arǝ alǝpikúnkurǝmì, sǝ tasǝ rǝia lǝkǝt-lǝkǝt nǝ bolo-njengǝlan.<verse eid="1KI 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 6:36" />Sheran mala patal mǝɓalǝuî mala ɓalae ka ɓè nǝ anggea-tali mǝnana à ɓunnia ka, abwamdǝe tàrú amurǝarǝia, sǝ bwamdǝe mwashat mala agbǝlang nggun-seda.<verse eid="1KI 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 6:37" />A inea pǝlǝa mala do-bunomurǝm mala Solomon, a zongŋo Ziv ka, à mal nongsǝ kusǝɓa mala ɓala mala Yahweh; <verse eid="1KI 6:37" /><verse number="38" style="v" sid="1KI 6:38" />sǝ à yi mal túró ɓak ɓalae kat, andǝ agir mǝnana kat à tsǝa aɓa nyoulǝa-pa male ka, a lum-nong-mwashatia pǝlǝa mala do-bunomurǝm mala Solomon, aɓa tongno-nong-tàruià zongŋo, zongŋo Bul. Twal Solomon apǝlǝa tongno-nong-ɓari sǝ mal ɓak ɓalae.<verse eid="1KI 6:38" /></para>
  <chapter eid="1KI 6" />
  <chapter number="7" style="c" sid="1KI 7" />
  <para style="s">Solomon ɓak palta male</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 7:1" />Solomon ɓakkî ɓamúrì palta. Mal ɓě aɓalǝ apǝlǝa lum-nong-tàrú. <verse eid="1KI 7:1" /><verse number="2" style="v" sid="1KI 7:2" />Ɗǝm ngga ɓak ɓè ɓala à tunǝi ama &lt;&lt;Palta mala Ndà-nggun Lebano.&gt;&gt; Sauwa male ka ɓakusǝu gbǝman nǝ lumi-tongno na, tangŋa male ka ɓakusǝu lumi-tongno-nong-ɓari-bwamdǝ-tongno na, sǝ dāh'rya male ka ɓakusǝu lumi-ine bwamdǝ tongno na. Kwákítè nǝ anggea-nggun mala nggun-seda mǝnana à tamsǝkia arǝ asangbǝlang ine ka, sǝ nongsǝki agbǝlang nggun-seda mǝsake amúrià. <verse eid="1KI 7:2" /><verse number="3" style="v" sid="1KI 7:3" />Anggea-nggunî camggi lum-bwamdǝ-tongno a koya sangbǝlang; agbǝlang nggun mǝnia mǝnana à nongsǝkia amúr akurǝm ngga, à ndà lumi-ine-bwamdǝ-tongno. Pàk múr-kurǝm nǝ akpamgbang seda. <verse eid="1KI 7:3" /><verse number="4" style="v" sid="1KI 7:4" />Arǝ koya bumkurǝm ɓari mǝnana à nda nkāɓe rǝarǝia ka, asangbǝlang tàrú mala anggun-mǝsǝkurǝm na kam. Asangbǝlang mala amǝsǝkurǝm a buì mwashat ka, à sǝn ɓamǝsǝarǝia andǝ asangbǝlang mala aɓia a ɓè ɓuì. <verse eid="1KI 7:4" /><verse number="5" style="v" sid="1KI 7:5" />Anggun-kúnakurǝm andǝ anggun-mǝsǝkurǝm kat ka, à pea kàlkàl. Asangbǝlang mala amǝsǝkurǝm arǝ bumkurǝm a buì mwashat ka, à sǝn ɓamǝsǝarǝia andǝ asangbǝlang mala amǝsǝkurǝm a ɓè bù bumkurǝm.<verse eid="1KI 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 7:6" />Solomon nyare ɓak ɓè ɓǎ à tunǝi ama Jamloro mala Anggun-gbasha. Sauwa male ka ɓakusǝu lumi-tongno-nong-ɓari bwamdǝ tongno na, sǝ tangŋa male ka ɓakusǝu lumi-ine-bwamdǝ-tongno na. Ndanǝ tara a ɓadǝmbi mǝnana anggun-gbasha na à bwali ka. <verse eid="1KI 7:6" /><verse number="7" style="v" sid="1KI 7:7" />Yì ɗǝm ngga ɓak ɓè Jamloro mala Buno-ɓashi, ban mǝnana nǝ̀ nggâ pak ɓashi kàm ngga. Gilǝki rǝ abumkurǝmnì nǝ akpamgbang mala nggun-seda, lo a kusǝkurǝm kya bik ban nkigir.<verse eid="1KI 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 7:8" />Ɓala male mǝnana nǝ̀ duk kam ngga, ɓè gbal anggo. Ɓè aɓa ɓè patal mǝnana nda a nzǝm Jamloro mala Buno-ɓashi ka. Ɗǝm ngga Solomon ɓak ɓè ɓala ace ɓoarnsarile Firona, mǝnana ali ka. <verse eid="1KI 7:8" /><verse number="9" style="v" sid="1KI 7:9" />Aɓah mǝnia kat ka, à ɓeǎ nǝ atali mǝnana kumea'kwan ngga, twal a kusǝɓa kya bik kusǝ-nkigir; anggo sǝ pàk kat a nza aban ká a nggea patal. À gilǝkirǝ atali mǝnia ka a ban mǝnana à ɓunnia kàm ngga; à shària nǝ byau-minǝu, kunia karǝ gǝ̀rgǝ̀r a koya nkanggaria. <verse eid="1KI 7:9" /><verse number="10" style="v" sid="1KI 7:10" />Kusǝɓa ka, akaɓa tali mǝnana kumea'kwan ngga nda à nongsǝkia kam ngga. Sakkya malea ka, ɓakusǝu lum-bwamdǝ-tongno na, sǝ aɓea ka ɓakusǝu lum-nong-ɓari na. <verse eid="1KI 7:10" /><verse number="11" style="v" sid="1KI 7:11" />Amur kusǝɓa ka, à tsǝk aɓea atali mǝnana à kasǝia, gulkio malea pǎ kǝla mǝnana à earcea ɓǝà pàk ka, sǝ à nongsǝki agbǝlang nggun-seda amuria. <verse eid="1KI 7:11" /><verse number="12" style="v" sid="1KI 7:12" />Asheran mǝnana à kàrì patal mala palta ka, à ɓeǎ nǝ atali mǝnana à gilǝkirǝia ka, sǝ à nongsǝkia amurǝarǝia andǝ agbǝlang nggun-seda. Anggo gbal sǝ à ɓak sheran mala patal mǝ'ɓaɓalǝuî mala ɓala mala Yahweh, sǝ anggo gbal sǝ à ɓak jamloro male.<verse eid="1KI 7:12" /></para>
  <para style="s">Túró mala Hiram a ɓak agir ɓá ɓala mala Yahweh</para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 7:13" />Murǝm Solomon túrban a Taya sǝ à yinǝ Hiram, <verse eid="1KI 7:13" /><verse number="14" style="v" sid="1KI 7:14" />mǝnana nggè ka mā-lú na a tàu mala Naftali; tárrí ka ɓwa Taya na, sǝ mǝ'túróbù mala tulki agir nǝ bolo-bángŋá na ɗiɗyal. Hiram nǝnggearǝì ka kwaro sǝ bwaltagir aɓa sǝlǝ túróbù mala pakkiagir ɗàngɗáng nǝ bolo-bángŋá.<verse eid="1KI 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 7:15" />Ɓak anggun-gbasha ɓari nǝ bolo-bángŋá; dāh'rya mala nggun-gbasha mwashat ka, ɓakusǝu lumi-ɓari bwamdǝ tongno-nong-ɓari na. Ɓālǝi na fourok sǝ sauwa mala nggur mǝnana kàrì nyane mala nggun-gbasha ka, ɓakusǝu lum bwamdǝ tongno-nong-tàrú na (18). <verse eid="1KI 7:15" /><verse number="16" style="v" sid="1KI 7:16" />Ɗǝm ngga ɓak agumtǝli bolo-bángŋá ace tsǝia a ɓong anggun-gbasha man. Dāh'rya mala koya gumtǝli ka, ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú na. <verse eid="1KI 7:16" /><verse number="17" style="v" sid="1KI 7:17" />Pǝlǝa pàk ansolo mala bolo-bángŋá tongno-nong-ɓari, sǝ teǎ a nkanggariarǝia, à pǎ kǝla zanzǝa ndāmbú, ace mbàkì rǝ agumtǝli mǝno a ɓong anggun-gbasha ka, nǝia; koya gumtǝli ka, tsǝki wi zanzǝa ndāmbú bolo-bángŋá amurí. <verse eid="1KI 7:17" /><verse number="18" style="v" sid="1KI 7:18" />Lang ɓak anggun-gbasha mǝnia ka, pàk anlang mala aɓǝla mɓǝring nǝ bolo-bángŋá, sǝ arǝ koya nggun-gbasha ka, kàrì nǝ atǝkrǝk ɓari mala anlangnì a múrbân, tù a ban mǝnana zanzǝa ndāmbú bolo-bángŋá kùmsǝ amur gumtǝli a ɓongban ngga. <verse eid="1KI 7:18" /><verse number="19" style="v" sid="1KI 7:19" />Agumtǝli bolo-bángŋá mǝno a ɓong anggun-gbasha aɓa jamloro ka, à pǎ kǝla afufe ɓake. À cam a kuli ɓakusǝu tongno-nong-mwashat, <verse eid="1KI 7:19" /><verse number="20" style="v" sid="1KI 7:20" />sǝ à nda aɓa ɓegìr kǝla pǎ mala nkenye, mǝnana came amur zanzǝa ndāmbú bolo-bángŋá ka. Koya gumtǝli bolo-bángŋá ka, ndanǝ aɓǝla mɓǝring gbǝman-ɓari arǝ atǝkrǝk mala anlang mǝnana à kàrì ka.<verse eid="1KI 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 7:21" />Hiram tamsǝ anggun-gbasha mǝnia ɓari ka à bwal tara bankutio aɓa Ndàmǝgule. Nggun-gbasha mǝnana tamsǝi a bu-mǝli ka, tunǝi ama Jakin; sǝ mǝnana tamsǝi a bu-mǝnggare ka tunǝi ama Boaz. <verse eid="1KI 7:21" /><verse number="22" style="v" sid="1KI 7:22" />Agumtǝli bolo-bángŋá mǝnana a ɓong anggun-gbasha ka, à peǎ kǝla afufe ɓake. Anggo sǝ túró mala anggun-gbasha yi malâ.<verse eid="1KI 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 7:23" />Pǝlǝa Hiram ɓak kaɓa-nkenye nǝ bolo-bángŋá sǝ tunǝi ama &lt;&lt;Nggeamùr.&gt;&gt; Yì nkenye ka nda tǝkrǝk, sǝ mǝnna mala kúní ka ɓakusǝu lum-bwamdǝ-tongno na. Lime male ka ɓakusǝu tongno-nong-ɓari nǝ gauwa-tsùrú na, sǝ sauwa mala nggur mǝnana kàrì kúní ka, ɓakusǝu lumi-ine-bwamdǝ-tongno na. <verse eid="1KI 7:23" /><verse number="24" style="v" sid="1KI 7:24" />Lang Hiram ɓak nkenyenì ka, ɓak nlang mala agir kǝla amuna-dù, à lanzǝ aɓata kún nkenyenì nǝ nza, sǝ à kàrì kat arǝ asangbǝlang ɓari. Koya ɓakusǝu mwashat nǝ gauwa-tsùrú mala sauwa mala nggur mǝnana kàrì kún nkenyenì ka, amuna-dù na kam lum. <verse eid="1KI 7:24" /><verse number="25" style="v" sid="1KI 7:25" />Hiram ɓak ajamnda lum-nong-ɓari, sǝ tsǝk nkenyenì a nzǝmia. Tamsǝ tàrú a nkanggariarǝia, ɓamǝsǝia sǝn njar-nza, tàrú sǝn njar-nzali, tàrú sǝn njar-kúnmur, sǝ tàrú sǝn takuli; myaltea pǝlǝ nǝ ɓalǝu; nkenyenì cam a nzǝmia. <verse eid="1KI 7:25" /><verse number="26" style="v" sid="1KI 7:26" />Nyane mala kún nkenyenì ka amuna-bu ine na. Kúni ka à pè kǝla mala kap sǝ pùr fufe pwasǝo ɓake; lime male kǝ twal galon á-lum-nong-mwashat (11,000) mala mùr.<verse eid="1KI 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 7:27" />Ɗǝm ngga Hiram pàk awaru-ramggite lum nǝ bolo-bángŋá; koya waru-ramggite ka sauwa male na ɓakusǝu tongno-nong-mwashat, tangŋa male na ɓakusǝu tongno-nong-mwashat, sǝ dāh'rya male na ɓakusǝu ine nǝ gauwa-tsùrú. <verse eid="1KI 7:27" /><verse number="28" style="v" sid="1KI 7:28" />Pàk abumban mala awaru-ramggite man nǝ alǝpi, mǝnana à kpapikia, à camggi kàngkàng arǝ anggunia ka. <verse eid="1KI 7:28" /><verse number="29" style="v" sid="1KI 7:29" />Sǝ amur alǝpi mǝnia à camge a nre ka anggunia ka, nyoulǝa-pa mala a'im, andǝ ajamnda, andǝ acerup na kam; a murbân andǝ ɓata anyoulǝa-pa mala a'im, andǝ ajamnda mǝnia arǝ alǝpi ka, mbakigir na kam mala apwasǝo'bondo-mbup mǝnana à gyarkia ka. <verse eid="1KI 7:29" /><verse number="30" style="v" sid="1KI 7:30" />Koya waru-ramggite ka, ndanǝ akusǝu-pǝlǝkya ine nǝ agara-pǝlǝkya malea mala bolo-bángŋá. Amur koya waru-ramggite, sǝ arǝ abankara male ine ka, akusǝ-pira nakam mǝnana à ɓeǎ ace pagbasha a tǝta nkenye ka; à mbàkì rǝ akusǝ-pira man nǝ apwasǝo'bondo-mbup a koya nkanggaria. <verse eid="1KI 7:30" /><verse number="31" style="v" sid="1KI 7:31" />Amur koya waru-ramggite ka, fourong ban na kam, kúní na gbuluk ace tamsǝ nkenye; eapi múr waru-ramggite nǝ ɓakusǝu mwashat-nǝ-gauwa-tsùrú (1 ½); mbúr-kúní na tǝkrǝk sǝ nda ɓiktik; tangŋa mala kúní ka, ɓakusǝu ɓari nǝ gauwa-ɓǝnggǝt (2 ¼) na; mbakigir mala nyoulǝa-pa mala apwasǝo'bondo-mbup nakam arǝì. Alǝpi mala awaru-ramggite ka, à nda kàlkàl; à pà tǝkrǝk ɗàng. <verse eid="1KI 7:31" /><verse number="32" style="v" sid="1KI 7:32" />Akusǝu-pǝlǝkya mǝnia ine ka, à sùlǝî alǝpi a nzali. Agara-pǝlǝkya mala akusǝu-pǝlǝkya ka à kpapia arǝ waru-ramggite. Dāh'rya mala koya kusǝu-pǝlǝkya ka, ɓakusǝu ɓari nǝ gauwa-ɓǝnggǝt (2 ¼) na. <verse eid="1KI 7:32" /><verse number="33" style="v" sid="1KI 7:33" />À pàk akusǝu-pǝlǝkyanì kǝla akusǝu-pǝlǝkya mala waru-pǝr; agara-pǝlǝkya malea, andǝ agaregare malea, andǝ amundi malea, andǝ ankpako-tsuru malea ka, à ɓeǎ nǝ bolo-bángŋá. <verse eid="1KI 7:33" /><verse number="34" style="v" sid="1KI 7:34" />Akusǝ-pira nakam ine arǝ abankara ine mala koya waru-ramggite; akusǝ-piranì ka à ɓeǎ arǝ waru-ramggite. <verse eid="1KI 7:34" /><verse number="35" style="v" sid="1KI 7:35" />A múrbân mala koya waru-ramggite ka, ɓegìr na kam tǝkrǝk, sǝ dāh'rya male ka gauwa-ɓǝkǝt (¾) mala ɓakusǝu mwashat na; anggunì andǝ alǝpi ka à kpapia arǝ waru-ramggite. <verse eid="1KI 7:35" /><verse number="36" style="v" sid="1KI 7:36" />Amur alǝpi mǝnana arǝ abumban andǝ anggunia ka, nyoulǝa-pa mala acerup, andǝ a'im, andǝ anggun-nkangga na kam, komǝye ka a male yì bân; sǝ à gumbǝlia nǝ mbakigir mala apwasǝo'bondo-mbup-mbup. <verse eid="1KI 7:36" /><verse number="37" style="v" sid="1KI 7:37" />Anggo sǝ Hiram pàk awaru-ramggite mǝno lum ngga; peǎ kat a pě mǝ'mwashati; à nda mwashat a gulo malea andǝ pǎ malea.<verse eid="1KI 7:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 7:38" />Ɗǝm ngga Hiram pàk ankenye lum nǝ bolo-bángŋá; mwashat ace koya waru-ramggite. Tangŋa mala koya nkenye ka ɓakusǝu tongno-nong-mwashat na, sǝ nǝ̀ gandǝ twal mùr galon gbǝman-ɓari nǝ lumi-ɓari. <verse eid="1KI 7:38" /><verse number="39" style="v" sid="1KI 7:39" />Tsǝk awaru-ramggite tongno a bù njar-kúnmur mala ndàmǝgule, sǝ tongno a bù njar-nza; sǝ tamsǝ kaɓa-nkenyenì a bankara mala ndàmǝgule a tsùrú mala njar-kúnmur andǝ takuli.<verse eid="1KI 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 7:40" />Hiram nyare pàk ankwaring-bolo, andǝ ashebǝl, andǝ amuna-nkenye. Nǝ amǝno ka sǝ masǝlǝ túró mǝnana kat Solomon tsǝki wi ɓǝ̀ pè ace ɓala mala Yahweh ka:<verse eid="1KI 7:40" /></para>
  <para style="li1">
    <verse number="41" style="v" sid="1KI 7:41" />anggun-gbasha ɓari;</para>
  <para style="li1" vid="1KI 7:41">agumtǝli bolo-bángŋá ɓari mǝnana pǎ malea na kǝla nkenye a ɓong anggun-gbasha man;</para>
  <para style="li1" vid="1KI 7:41">azanzǝa ndāmbú mala nsolo bolo-bángŋá mana à teǎ a nkanggariarǝia ace kùmsǝ múr agumtǝli bolo-bángŋá mǝnana pǎ malea na kǝla nkenye a ɓong anggun-gbasha;<verse eid="1KI 7:41" /></para>
  <para style="li1">
    <verse number="42" style="v" sid="1KI 7:42" />anlang mala aɓǝla mɓǝring gbǝman-ine ace azanzǝa ndāmbú ɓari; anlang ɓari mala aɓǝla mɓǝring ace koya zanzǝa ndámbú mǝnana à kùmsǝ múr agumtǝli bolo-bángŋá ka, mǝnana pǎ malea na kǝla nkenye a ɓong anggun-gbasha ka;<verse eid="1KI 7:42" /></para>
  <para style="li1">
    <verse number="43" style="v" sid="1KI 7:43" />awaru-ramggite lum andǝ ankenye malea lum;<verse eid="1KI 7:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="1KI 7:44" />kaɓa-nkenye andǝ ajamnda bolo-bángŋá lum-nong-ɓari aɓate;<verse eid="1KI 7:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="1KI 7:45" />ankwaring-bolo, andǝ ashebǝl, andǝ amuna-nkenye.</para>
  <para style="p" vid="1KI 7:45">Atanggǝla mǝnia kat aɓa ɓala mala Yahweh mǝnana Hiram peǎ ace Murǝm Solomon ngga, peǎ nǝ bolo-bángŋá mǝnana à kolǝ rǝi sǝ kǝ tâ'nzama ka. <verse eid="1KI 7:45" /><verse number="46" style="v" sid="1KI 7:46" />Murǝm tsǝk amǝ'túró à peǎ ani: bolo-bángŋá mǝnana panzǝ a bǝsa ka, à solǝi aɓalǝ ankpoulo agirnì mǝnana à ɓeǎ nǝ dǝɓang ngga. À pàk túrè a Ɓangŋaban mala Nggeasala Jodan, a nre ka anggea-là Sukkot andǝ Zaretan.<verse eid="1KI 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="1KI 7:47" />Solomon nying atanggǝla mǝnia ka anggo, karǝki dǝmbǝrya malea ɗàng, acemǝnana à làkkì pas. À súrǝ̀ dǝmbǝrya mala bolo-bángŋá mǝnana à pàngŋǝ̀nà-túró nǝi ka ɗàng. <verse eid="1KI 7:47" /><verse number="48" style="v" sid="1KI 7:48" />Ɗǝm ngga Solomon banggi amǝ'túró ɓǝà pàk amǝnia yì agir mala ɓá ɓala mala Yahweh ka nǝ bolo-njengǝlan:</para>
  <para style="li1" vid="1KI 7:48">gyangŋan bolo-njengǝlan;</para>
  <para style="li1" vid="1KI 7:48">kpamgbang bolo-njengǝlan mǝnana à kǝ tsǝk Bǝredi mala Ɓadǝm Yahweh amurì ka;<verse eid="1KI 7:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="1KI 7:49" />agir-tàmsǝ apitǝla mala bolo-njengǝlan mǝɓoarne (tongno a bù-mǝlì sǝ tongno a bu-mǝnggare a ɓadǝm Ban Nggea Mǝfele);</para>
  <para style="li1" vid="1KI 7:49">andǝ mbakigir mala apwasǝo-bondo, andǝ apitǝla, andǝ a-mǝmyál, mǝnana à peǎ nǝ bolo-njengǝlan ngga;<verse eid="1KI 7:49" /></para>
  <para style="li1">
    <verse number="50" style="v" sid="1KI 7:50" />amuna-bàng, amǝmyal, amuna-nkenye, andǝ acembe, andǝ atasau-bǝsa, mǝnana à peǎ nǝ bolo-njengǝlan ngga;</para>
  <para style="li1" vid="1KI 7:50">ankpako ace gyar alǝpikúnkurǝm mala kurǝm mǝ'ɓaɓalǝuî, yì Ban Nggea Mǝfele, andǝ mala alǝpikúnkurǝm mala kaɓa-jamloro mala ɓalae.<verse eid="1KI 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 7:51" />Lang Murǝm Solomon malna pàk túró mǝnana pè ace ɓala mala Yahweh ka, pǝlǝa yinǝ agir mǝnana tárrí Dauda tària ace Ɓakuli ka: bolo-azǝrfa, bolo-njengǝlan andǝ atanggǝla, sǝ tsǝia aɓalǝ andà-tsǝk agir-ɓoarna mala ɓala mala Yahweh.<verse eid="1KI 7:51" /></para>
  <chapter eid="1KI 7" />
  <chapter number="8" style="c" sid="1KI 8" />
  <para style="s">À yinǝ Akwati Kùrcau aɓa ɓala mala Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 8:1" />Pǝlǝa Solomon tunǝ amúr-là mala Isǝrayila andǝ aɓwana-mǝgule amur atau mala amǝ Isǝrayila kat ɓǝà yi dapi a baní a Urǝshalima. Tunǝia ace mǝnana ɓǝà yi twal Akwati Kùrcau mala Yahweh a ban mǝnana à tsǝì kàm a Siyona, yì Nggea-là mala Dauda ka. <verse eid="1KI 8:1" /><verse number="2" style="v" sid="1KI 8:2" />Pǝlǝa aburana mala Isǝrayila kat ramba aɓadǝm Murǝm Solomon, a Lamsan mala Agumli, mǝnana à kǝ pe a zongŋo Etanim, yì tongno-nong-ɓaria zongŋo ka.<verse eid="1KI 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 8:3" />Lang aɓwana-mǝgule mala Isǝrayila kat yina ka, apǝris twal Akwati Kùrcau. <verse eid="1KI 8:3" /><verse number="4" style="v" sid="1KI 8:4" />Apǝris andǝ amǝ'Lawi u Tara Ban-peri, sǝ à pwania andǝ agir mǝfele mǝnana aɓalǝi ka kat, andǝ Akwati Kùrcau, à yinǝia a ɓala mala Yahweh. <verse eid="1KI 8:4" /><verse number="5" style="v" sid="1KI 8:5" />Murǝm Solomon andǝ amǝ Isǝrayila puppup mǝnana à yi ramba a baní aɓadǝm Akwati Kùrcau ka, à pa ɓoro mala gìr'nkila nǝ anzur andǝ ajamnda pas mǝnana à gandǝ ɓallia raka ace ɓiki lakkì malea.<verse eid="1KI 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 8:6" />Pǝlǝa apǝris yinǝ Akwati Kùrcau mala Yahweh à kútí nǝi a bancame male aɓata ankpamtari acerup, aɓa kurǝm mǝ'ɓaɓalǝuî, yì Ban Nggea Mǝfele mala ɓala mala Yahweh. <verse eid="1KI 8:6" /><verse number="7" style="v" sid="1KI 8:7" />Sǝ acerup mǝnana ankpamtaria mǝnna amur ban mǝnana à tsǝk Akwati kàm ngga, à túr yilǝm amur Akwati andǝ agare. <verse eid="1KI 8:7" /><verse number="8" style="v" sid="1KI 8:8" />Ace ɓiki sakkya mala agare mǝnia ka, ɓwa nǝ̀ gandǝ sǝn kúnià ɓǝ̀ cam aɓa Ban Mǝfele aɓadǝm Ban Nggea Mǝfele ka, sǝama nǝ nza ka, ɓwa pà nǝ̀ gandǝ sǝnia ɗàng. À nda kam a ban mǝno ba yalung. <verse eid="1KI 8:8" /><verse number="9" style="v" sid="1KI 8:9" />Kǝgir pà kàm aɓa Akwatinî ɗàng, shekǝ akpamgbǝlang tali ɓari mana Musa tsǝia aɓalǝi a Nkono Horep, ban mǝnana Yahweh kùtí aɓa kùrcau nǝ amǝ Isǝrayila, lang à purî ɓá nzali Masar ka.<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 25:21">Pur 25:21</ref>; <ref loc="EXO 40:20">40:20</ref>; <ref loc="DEU 10:2">Nggur 10:2</ref>,<ref loc="DEU 10:5">5</ref>; <ref loc="HEB 9:4">Ib 9:4</ref> </char>.</note><verse eid="1KI 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 8:10" />Lang apǝris purî Ban Mǝfele ka, pǝrɓang yi lumsǝ ɓala mala Yahweh, <verse eid="1KI 8:10" /><verse number="11" style="v" sid="1KI 8:11" />sǝ à gandǝ came ace pàk túró malea ɗàng atàcau mala pǝrɓang, acemǝnana tǎ mala ɓoarɓwa mala Yahweh lùmsǝ ɓá ɓala male.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 40:34">Pur 40:34</ref>,<ref loc="EXO 40:35">35</ref>; <ref loc="2CH 5:13">2Acau 5:13</ref>,<ref loc="2CH 5:14">14</ref>; <ref loc="2CH 7:1">7:1</ref>,<ref loc="2CH 7:2">2</ref>; <ref loc="EZK 10:3">Ezǝk 10:3</ref>,<ref loc="EZK 10:4">4</ref></char>.</note><verse eid="1KI 8:11" /></para>
  <para style="s">Solomon ɓwangsǝ Yahweh</para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 8:12" />Pǝlǝa Solomon bang ama:</para>
  <para style="q1" vid="1KI 8:12">Yahweh bangŋǝna ama, yì ka nǝ̀ do aɓa pǝndǝa mǝcikcikni;<verse eid="1KI 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1KI 8:13" />sǝ mim ngga, ndya ǝn ɓangŋǝna kaɓa ɓala mǝɓoarɓwe aceo,</para>
  <para style="q1" vid="1KI 8:13">ban mǝnana nda aceo, wu duk kam tàtǝ́k ka.<verse eid="1KI 8:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1KI 8:14" />Pǝlǝa murǝm pǝlǝrǝì, sǝ tsǝki ɓwabundǝa mala Isǝrayila bù; sǝ ɓwabundǝa mala Isǝrayila kat cam-nǝ-came. <verse eid="1KI 8:14" /><verse number="15" style="v" sid="1KI 8:15" />Sǝ bang ama:</para>
  <para style="q1" vid="1KI 8:15">Ɓǝ̀ ɓwangsǝban pa aban Yahweh, Ɓakuli mala Isǝrayila.</para>
  <para style="q1" vid="1KI 8:15">Gìr mǝnana pàcau ace nǝ kúni, aban tárrám, Dauda ka,</para>
  <para style="q2" vid="1KI 8:15">lùmsǝ̀nì nǝ rǝcandǝa male.</para>
  <para style="q1" vid="1KI 8:15">Bang ama,<verse eid="1KI 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1KI 8:16" />&lt;&lt;Twal a pwari mǝnana ǝn pusǝ aɓwana mem Isǝrayila,</para>
  <para style="q2" vid="1KI 8:16">à purî ɓá nzali Masar ka,</para>
  <para style="q1" vid="1KI 8:16">ǝn twal-ma ɓekǝ nggea-là aɓalǝ atau kat mala Isǝrayila,</para>
  <para style="q2" vid="1KI 8:16">ama mǝ nǝ ɓak ɓala kàm,</para>
  <para style="q2" vid="1KI 8:16">ace mǝnana ɓǝ̀ lullǝam pàk kàm ngga ɗàng.</para>
  <para style="q1" vid="1KI 8:16">Sǝama, ǝn twalǝna Dauda ɓǝ̀ duk murǝm</para>
  <para style="q2" vid="1KI 8:16">amur aɓwana mem, Isǝrayila.&gt;&gt;<verse eid="1KI 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1KI 8:17" />Sǝ tárrám Dauda ka, ndanǝi a ɓabumi</para>
  <para style="q1" vid="1KI 8:17">nǝ̀ ɓak ɓala ace lullǝ Yahweh,</para>
  <para style="q2" vid="1KI 8:17">yì Ɓakuli mala Isǝrayila.<verse eid="1KI 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1KI 8:18" />Sǝama, Yahweh banggi tárrám Dauda ama,</para>
  <para style="q1" vid="1KI 8:18">&lt;&lt;A pangŋǝ̀nà mǝɓoarne, yi mana a tsǝngŋǝ̀nà a ɓabumo ama,</para>
  <para style="q1" vid="1KI 8:18">awu nǝ ɓak ɓala ace lullǝam ngga.<verse eid="1KI 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1KI 8:19" />Kat andǝ amani ka, a nda mǝnana a nǝ ɓak ɓalae ka ɗàng.</para>
  <para style="q1" vid="1KI 8:19">Muna-ɓwabura mô, mǝnana à nǝ̀ ɓǝlô wi ka,</para>
  <para style="q2" vid="1KI 8:19">nda ɓwa mǝnana nǝ̀ ɓak ɓala ace lullǝam ngga.&gt;&gt;<verse eid="1KI 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1KI 8:20" />Adyan ngga Yahweh lumsǝna pacau male mǝnana bangce ka.</para>
  <para style="q1" vid="1KI 8:20">Sǝ mim ngga, ǝn longŋǝna a bancame mala tárrám, Dauda,</para>
  <para style="q2" vid="1KI 8:20">sǝ mǝ ndya ǝn do amur buno-murǝm mala Isǝrayila,</para>
  <para style="q2" vid="1KI 8:20">kǝla mǝnana Yahweh pacau ka.</para>
  <para style="q1" vid="1KI 8:20">Sǝ ǝn ɓangŋǝna ɓala ace lullǝ Yahweh,</para>
  <para style="q1" vid="1KI 8:20">yì Ɓakuli mala Isǝrayila.<verse eid="1KI 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1KI 8:21" />Sǝ ǝn gilǝkina bân ace yì Akwati,</para>
  <para style="q2" vid="1KI 8:21">mǝnana kùrcau mala Yahweh na kam aɓalǝi ka,</para>
  <para style="q1" vid="1KI 8:21">yì kùrcau mǝnana pè nǝ aká-sǝm,</para>
  <para style="q2" vid="1KI 8:21">a bàkú mǝnana pusǝia à purî ɓá nzali Masar ka.<verse eid="1KI 8:21" /></para>
  <para style="s">Hiwi ace mǝn ndàmǝgule mana Solomon ɓak ka</para>
  <para style="m">
    <verse number="22" style="v" sid="1KI 8:22" />Pǝlǝa Solomon came aɓadǝm gyangŋan mala Yahweh, a ɓadǝm ramba mala Isǝrayila kat, sǝ sárǝ́ abui aban ká kuli, <verse eid="1KI 8:22" /><verse number="23" style="v" sid="1KI 8:23" />sǝ bang ama:</para>
  <para style="q1" vid="1KI 8:23">We Yahweh, Ɓakuli mala Isǝrayila,</para>
  <para style="q1" vid="1KI 8:23">kǝ Ɓakuli pa kàm, kǝla we, a kuli ko a nzali, a ɓanza ɗàng.</para>
  <para style="q1" vid="1KI 8:23">A kǝ bwal kùrcau mò,</para>
  <para style="q1" vid="1KI 8:23">sǝ a kǝ lǝmdǝ earcearǝu mana kǝ mal raka,</para>
  <para style="q2" vid="1KI 8:23">aban aguro mò mǝnana à kǝ gya aɓadǝmbo nǝ ɓabumia kat ka.<verse eid="1KI 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1KI 8:24" />A bwalǝna pacau mò mǝnana a pe aban guro mò, Dauda,</para>
  <para style="q2" vid="1KI 8:24">yì tárrám ngga.</para>
  <para style="q1" vid="1KI 8:24">A ne nǝ kúno, sǝ ndya a lumsǝni nǝ rǝcandǝa mò yalung ngga.<verse eid="1KI 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1KI 8:25" />Sǝ adyan ngga, We Yahweh, Ɓakuli mala Isǝrayila,</para>
  <para style="q1" vid="1KI 8:25">kpata pacau mǝnana a pe aban guro mò, Dauda, yì tárrám,</para>
  <para style="q1" vid="1KI 8:25">mǝnana a banggi wi ama,</para>
  <para style="q1" vid="1KI 8:25">&lt;&lt;A pà wu nǝ ɗwanyi ɓwa a nggurkwar mò mǝnana nǝ̀ do aɓadǝmbam,</para>
  <para style="q2" vid="1KI 8:25">amur buno-murǝm mala Isǝrayila ka ɗàng,</para>
  <para style="q1" vid="1KI 8:25">ɓǝ̀ mbak-kàngkàng amǝkeo tsǝkiria pepè arǝ njar malea,</para>
  <para style="q1" vid="1KI 8:25">à nǝ̀ gya aɓadǝmbam kǝla mǝnana a gya aɓadǝmbam ngga.&gt;&gt;<verse eid="1KI 8:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1KI 8:26" />Sǝ adyan ngga, We Ɓakuli mala Isǝrayila,</para>
  <para style="q1" vid="1KI 8:26">ɗeki ɓǝ̀ pacau mò mana a pe aban guro mò Dauda, yì tárrám ngga,</para>
  <para style="q2" vid="1KI 8:26">ɓǝ̀ purmǝsǝi.<verse eid="1KI 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1KI 8:27" />Sǝ yì Ɓakuli, mǝsǝcau ka, nǝ̀ do a ɓanza le?</para>
  <para style="q1" vid="1KI 8:27">Nggearǝ kuli, yì kuli kano ɓong-ɓong ngga,</para>
  <para style="q1" vid="1KI 8:27">pà nǝ̀ gandǝ karǝ eo aɓalǝi ɗàng;</para>
  <para style="q2" vid="1KI 8:27">sǝ koshi mǝnia yì ɓala ǝn ɓê ka!<verse eid="1KI 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1KI 8:28" />Kat andǝ amani ka, We Yahweh, Ɓakuli mem,</para>
  <para style="q1" vid="1KI 8:28">awu nǝ kwakikiro arǝ hiwi andǝ zǝmba mem, mim guro mò,</para>
  <para style="q1" vid="1KI 8:28">wu ok ɓua mem andǝ hiwi,</para>
  <para style="q2" vid="1KI 8:28">mana mim guro mò ǝn nggǝ yinǝi aɓadǝmbo yalung ngga.<verse eid="1KI 8:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1KI 8:29" />Tsǝk mǝsǝo arǝ ɓala man, du andǝ pwari,</para>
  <para style="q1" vid="1KI 8:29">yì ban mǝnana a bangŋǝna ama,</para>
  <para style="q2" vid="1KI 8:29">&lt;&lt;Lullǝam ngga, nǝ̀ pa a banì,&gt;&gt;</para>
  <para style="q1" vid="1KI 8:29">sǝ ace mǝnana wu kwakikiro arǝ hiwi mala guro mò,</para>
  <para style="q2" vid="1KI 8:29">mana ǝn nggǝ pa a bano nǝ pǝlǝ ɓamǝsǝam nǝ'njar ban mǝnia ka.<verse eid="1KI 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1KI 8:30" />Kwakikiro arǝ zǝmba mala guro mò,</para>
  <para style="q1" vid="1KI 8:30">andǝ mala aɓwana mô, amǝ Isǝrayila,</para>
  <para style="q2" vid="1KI 8:30">a koya pwari à pakhiwi a bano</para>
  <para style="q2" vid="1KI 8:30">nǝ pǝlǝ ɓamǝsǝia nǝ'njar ban mǝnia ka.</para>
  <para style="q1" vid="1KI 8:30">A ban-do mô a kuli ka, awu nǝ ok sǝm;</para>
  <para style="q1" vid="1KI 8:30">sǝ lang a ongŋǝna ka, twala-sǝm-banì.<verse eid="1KI 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1KI 8:31" />Ɓǝ̀ ɓwa ka, à tsǝkî-cau-arǝì mala pàkkî ɓì mǝ'murkala mǝɓane,</para>
  <para style="q2" vid="1KI 8:31">sǝ à tsǝì ɓǝ̀ kángìr,<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 22:7-12">Pur 22:7-12</ref>; <ref loc="NUM 5:11-31">Ɓal 5:11-31</ref></char>.</note></para>
  <para style="q1" vid="1KI 8:31">sǝ yiu aɓadǝm gyangŋan mò a ɓala man,</para>
  <para style="q2" vid="1KI 8:31">sǝ kán ama, &lt;&lt;Ən pe ɗàng&gt;&gt; ngga;<verse eid="1KI 8:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1KI 8:32" />awu nǝ oè a kuli, a nǝ kasǝ-ɓashi.</para>
  <para style="q1" vid="1KI 8:32">Sǝ awu nǝ ɓashì aguro mò,</para>
  <para style="q1" vid="1KI 8:32">nǝ kasǝ'ɓashi-lú amur ɓwa mǝnana a kumi nǝ-cau'arǝì ka,</para>
  <para style="q2" vid="1KI 8:32">sǝ awu nǝ nyesǝi wi bafe mala ɓeali amurí,</para>
  <para style="q1" vid="1KI 8:32">sǝ mǝɓealɓoarna ka, awu nǝ pe wi tangnakusǝi</para>
  <para style="q2" vid="1KI 8:32">mǝnana kārǝ́ arǝ ɓealɓoarna male ka.<verse eid="1KI 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1KI 8:33" />Sǝ lang aɓwana mò Isǝrayila ka,</para>
  <para style="q1" vid="1KI 8:33">aɓiu-mǝbura malea gandǝnia a munǝo,</para>
  <para style="q2" vid="1KI 8:33">acemǝnana à pàngŋǝ́nò cauɓikea ka,</para>
  <para style="q1" vid="1KI 8:33">sǝ ɓǝ̀ à pǝlǝ ɗǝm a bano, à earnǝ lullǝo,</para>
  <para style="q1" vid="1KI 8:33">à pakhiwi sǝ à zǝmba a bano ace bwalia-wia,</para>
  <para style="q2" vid="1KI 8:33">a ɓala mǝnia ka,<verse eid="1KI 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1KI 8:34" />awu nǝ ok hiwi malea a kuli,</para>
  <para style="q1" vid="1KI 8:34">sǝ awu nǝ twalban cauɓikea mala aɓwana mô, Isǝrayila,</para>
  <para style="q1" vid="1KI 8:34">sǝ awu nǝ nyesǝia ɗǝm,</para>
  <para style="q2" vid="1KI 8:34">a nzali mǝnana a pea akeâ ka.<verse eid="1KI 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1KI 8:35" />Sǝ lang kuli ka, à gìrì sǝ mbulo pa kàm raka,</para>
  <para style="q1" vid="1KI 8:35">acemǝnana à pàngŋǝ́nò cauɓikea,</para>
  <para style="q1" vid="1KI 8:35">sǝ ɓǝ̀ à pakhiwi a bano nǝ pǝlǝ ɓamǝsǝia nǝ'njar ban mǝnia,</para>
  <para style="q1" vid="1KI 8:35">sǝ à earnǝ lullǝo,</para>
  <para style="q1" vid="1KI 8:35">sǝ à pǝlǝ nzǝmia arǝ cauɓikea malea,</para>
  <para style="q1" vid="1KI 8:35">acemǝnana a yinǝ gir-kwanrǝu amúrià ka,<verse eid="1KI 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1KI 8:36" />awu nǝ oea a kuli,</para>
  <para style="q1" vid="1KI 8:36">sǝ awu nǝ twalban cauɓikea mala aguro mò,</para>
  <para style="q2" vid="1KI 8:36">aɓwana mô Isǝrayila,</para>
  <para style="q1" vid="1KI 8:36">ace mǝnana awu nǝ kània wia njar mǝɓoarne mala gingnǝ ɓealia;</para>
  <para style="q1" vid="1KI 8:36">sǝ wu tasǝ mbulo amur nzali mô,</para>
  <para style="q1" vid="1KI 8:36">yì nzali mǝnana a panì aɓwana mô dumǝna nzali liɓala malea ka.<verse eid="1KI 8:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="1KI 8:37" />Sǝ ɓǝ̀ nzal-gula yi kpa aɓa nzali,</para>
  <para style="q1" vid="1KI 8:37">sǝ ɓǝ̀ kwánó-ɓikea sulǝo amur aɓwana,</para>
  <para style="q1" vid="1KI 8:37">sǝ ɓǝ̀ agirɓaban malea kiɗiki atàcau mala nyàɗàng,</para>
  <para style="q2" vid="1KI 8:37">ko kwàpì, ko kpa mala doshi, ko sa mala nggwaso,</para>
  <para style="q1" vid="1KI 8:37">sǝ ɓǝ̀ ɓibura malea kutio aɓa nzali malea</para>
  <para style="q1" vid="1KI 8:37">sǝ gumbǝli anggea-là malea nǝ munǝo;</para>
  <para style="q1" vid="1KI 8:37">ɓǝya kwánó-twàl-là na,</para>
  <para style="q1" vid="1KI 8:37">ko ɓǝya rǝkwana na sǝ kumia ka;<verse eid="1KI 8:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="1KI 8:38" />ɓǝya hiwi à pè, ɓǝya zǝmba na à yinǝi,</para>
  <para style="q2" vid="1KI 8:38">ko mala ɓwa mwashat na,</para>
  <para style="q2" vid="1KI 8:38">ko mala aɓwana mô Isǝrayila na kat ka,</para>
  <para style="q1" vid="1KI 8:38">koyan ngga súrǝ́nà rǝ tanni mana kumi ka,</para>
  <para style="q1" vid="1KI 8:38">sǝ lang à nǝ̀ mǝn abuia aɓa hiwi nǝ'njar ban mǝnia yì ɓala ka,<verse eid="1KI 8:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="1KI 8:39" />we ka, oeǎ a kuli, yì ban-do mô,</para>
  <para style="q1" vid="1KI 8:39">twalbani sǝ wu pak nê mò.</para>
  <para style="q1" vid="1KI 8:39">A súrǝ̀ ɓabum koya ɓwa ka;</para>
  <para style="q1" vid="1KI 8:39">we nǝmurǝo a nda mǝnana a súrǝ̀ ɓabum amuna ɓwapǝndǝa kat ka.</para>
  <para style="q1" vid="1KI 8:39">Acemani ka, pè koyan ngga gìr mǝnana karǝ arǝ anjar male ka,<verse eid="1KI 8:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="1KI 8:40" />ace mǝnana ɓǝà ɓanggo aɓalǝ anonggio kat mala do malea</para>
  <para style="q2" vid="1KI 8:40">aɓa nzali mǝnana a pê akeâ ka.<verse eid="1KI 8:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="1KI 8:41" />Anggo gbal, koya ɓwa mǝnana bǝriɓwa na,</para>
  <para style="q2" vid="1KI 8:41">mǝnana ɓwa Isǝrayila na raka,</para>
  <para style="q2" vid="1KI 8:41">mana pur a ɓe nzali, a ban mǝsauwe,</para>
  <para style="q1" vid="1KI 8:41">sǝ yiu atàcau mala lullǝo ka,<verse eid="1KI 8:41" /></para>
  <para style="q2">
    <verse number="42" style="v" sid="1KI 8:42" />(acemǝnana à nǝ̀ okce lullǝo mǝgule,</para>
  <para style="q2" vid="1KI 8:42">andǝ kaɓa rǝcandǝa mò andǝ mazo mala nggwarbuo),</para>
  <para style="q1" vid="1KI 8:42">sǝ ɓǝ̀ yiu sǝ pakhiwi a bano</para>
  <para style="q2" vid="1KI 8:42">nǝ pǝlǝ ɓamǝsǝi nǝ'njar ban ɓala mǝnia ka,<verse eid="1KI 8:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="1KI 8:43" />ok hiwi male a kuli, bando mô.</para>
  <para style="q1" vid="1KI 8:43">Pàk gìr mǝnana kat yì bǝriɓwa zǝmba a bano ka,</para>
  <para style="q1" vid="1KI 8:43">ace mǝnana aɓwapǝndǝa mala ɓanza kat ɓǝà súrǝ̀ lullǝo,</para>
  <para style="q2" vid="1KI 8:43">sǝ ɓǝà ɓanggo, kǝla mǝnana aɓwana mô Isǝrayila kǝ pak ka,</para>
  <para style="q1" vid="1KI 8:43">sǝ ɓǝà sǝlǝ gbal ama, ɓala mǝnia ǝn ɓê ka,</para>
  <para style="q2" vid="1KI 8:43">à kǝ tunǝi nǝ lullǝo.<verse eid="1KI 8:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="1KI 8:44" />Ɓǝ̀ aɓwana mô puro ace ká munǝo arǝ ɓimǝbura malea,</para>
  <para style="q2" vid="1KI 8:44">a koya ban mǝnana kat awu nǝ tasǝia kàm,</para>
  <para style="q1" vid="1KI 8:44">sǝ à pakhiwi a bano Yahweh,</para>
  <para style="q2" vid="1KI 8:44">nǝ'njar ban nggea-là mǝnana a twalni,</para>
  <para style="q2" vid="1KI 8:44">andǝ ɓala mǝnana ǝn ɓê, ace lullǝo ka,<verse eid="1KI 8:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="1KI 8:45" />ok hiwi malea a kuli andǝ zǝmba malea,</para>
  <para style="q1" vid="1KI 8:45">sǝ wu kasǝ-ɓashi, wu pea wia gìr mǝnana malea na ka.<verse eid="1KI 8:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="1KI 8:46" />Sǝama, ɓǝ̀ à pakkô cauɓikea ka -</para>
  <para style="q2" vid="1KI 8:46">
    <note caller="+" style="f">
      <char style="fr" closed="false">8:46 </char>
      <char style="ft" closed="false">Ɓalli aɓa: </char>
      <char style="xt">
        <ref loc="PRO 20:9">Pas 20:9</ref>; <ref loc="ECC 7:20">Ham 7:20</ref>; <ref loc="ROM 3:23">Rom 3:23</ref>; <ref loc="JAS 3:2">Jem 3:2</ref>; <ref loc="1JN 1:8">1Yoh 1:8</ref>,<ref loc="1JN 1:10">10</ref> </char>.</note>acemǝnana kǝɓwa pà kàm mana kǝ pak cauɓikea raka ɗàng -</para>
  <para style="q1" vid="1KI 8:46">sǝ a pak-bumlulla nǝia, a tasǝia a ɓabu ɓiumǝbura,</para>
  <para style="q1" vid="1KI 8:46">sǝ à pwania à umnǝia aɓa gbámiban<note caller="+" style="f"><char style="fr" closed="false">8:46 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 26:34">Pǝris 26:34</ref>,<ref loc="LEV 26:44">44</ref>; <ref loc="DEU 28:36">Nggur 28:36</ref>,<ref loc="DEU 28:64">64</ref></char>.</note> a nzali mala ɓiumǝbura,</para>
  <para style="q2" vid="1KI 8:46">a ban mana nda kuko ko mana nda tù ka,<verse eid="1KI 8:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="1KI 8:47" />sǝ ɓǝ̀ à nggaɗi ɓabumia aɓa nzali mana à pwanǝnia</para>
  <para style="q2" vid="1KI 8:47">à umǝna nǝia kàm kǝla aguro,</para>
  <para style="q1" vid="1KI 8:47">sǝ à pwanzali, à zǝmbô,</para>
  <para style="q2" vid="1KI 8:47">aɓa nzali mala aɓwana mǝnana à bwalia kǝla aguro ka, ama,</para>
  <para style="q1" vid="1KI 8:47">&lt;&lt;Sǝm pàngŋǝ̀nà cauɓikea, sǝ sǝm pàngŋǝ̀nà gìr mǝɓike andǝ caukpaka.&gt;&gt;<verse eid="1KI 8:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="1KI 8:48" />Sǝ ɓǝ̀ à nyar a bano nǝ ɓabumia kat</para>
  <para style="q1" vid="1KI 8:48">andǝ ɗenyicau malea kat,</para>
  <para style="q2" vid="1KI 8:48">aɓa nzali mala aɓiamǝbura mana à pwania, à umnǝia kǝla aguro,</para>
  <para style="q1" vid="1KI 8:48">sǝ à pakhiwi a bano nǝ pǝlǝ ɓamǝsǝia nǝ'njar ban nzali mǝnana a pe akeâ,</para>
  <para style="q2" vid="1KI 8:48">yì nggea-là mana a twalni, andǝ ɓala mǝnia,</para>
  <para style="q2" vid="1KI 8:48">mana ǝn ɓê ace lullǝo ka,<verse eid="1KI 8:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="1KI 8:49" />ok hiwi andǝ zǝmba malea a kuli, ban-do mô,</para>
  <para style="q1" vid="1KI 8:49">sǝ wu kasǝ-ɓashi, wu pea wia gìr mǝnana malea na ka.<verse eid="1KI 8:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="1KI 8:50" />Twaliâbanì, yia aɓwana mô mǝnana à pàkkô cauɓikea ka.</para>
  <para style="q1" vid="1KI 8:50">Twaliâban akpakpak mǝnana à pàkkô ka.</para>
  <para style="q1" vid="1KI 8:50">Tsǝk aɓwana mǝnana à pwania sǝ à bwalia bwalban-guro ka,</para>
  <para style="q2" vid="1KI 8:50">ɓǝà sǝn mǝsǝswatǝr malea.<verse eid="1KI 8:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="1KI 8:51" />Yià ka aɓwana mô na andǝ agirkuma mò;<note caller="+" style="f"><char style="fr" closed="false">8:51 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 32:11">Pur 32:11</ref>; <ref loc="DEU 9:26">Nggur 9:26</ref>,<ref loc="DEU 9:29">29</ref></char>.</note></para>
  <para style="q1" vid="1KI 8:51">a pusǝia à purî ɓá nzali Masar,</para>
  <para style="q1" vid="1KI 8:51">à purî ɓá ndà-bǝsa mala panzǝ bolo-candǝa.<note caller="+" style="f"><char style="fr" closed="false">8:51 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:20">Nggur 4:20</ref></char>.</note><verse eid="1KI 8:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="1KI 8:52" />Ɓǝ̀ amǝsǝo mǝnna aban zǝmba mala guro mò,</para>
  <para style="q1" vid="1KI 8:52">andǝ azǝmba mala aɓwana mô, Isǝrayila.</para>
  <para style="q1" vid="1KI 8:52">Kwakikiro arǝia a pwari mǝnana kat à yinǝ ɓua malea a bano ka.<verse eid="1KI 8:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="1KI 8:53" />A nda mǝnana a taria-ɗàng aɓalǝ aɓwapǝndǝa kat</para>
  <para style="q1" vid="1KI 8:53">mala ɓanza ace mǝnana ɓǝà duk girkuma mò,</para>
  <para style="q1" vid="1KI 8:53">kǝla mǝnana a bang nǝ kún Musa, yì guro mò,</para>
  <para style="q1" vid="1KI 8:53">a bàkú mana a pusǝ aká-sǝm,</para>
  <para style="q1" vid="1KI 8:53">à purî ɓá nzali Masar ka, we Yahweh, Ɓakuli.<verse eid="1KI 8:53" /></para>
  <para style="s">Tsǝkbu mala Solomon amur ɓwabundǝa</para>
  <para style="p">
    <verse number="54" style="v" sid="1KI 8:54" />Lang Solomon malǝna amǝnia yì ahiwi andǝ azǝmba kat aban Yahweh ka, pǝlǝa loapi ɓadǝm gyangŋan mala Yahweh, ban mǝnana kūndǝ kam loasǝ abui a kuli ka. <verse eid="1KI 8:54" /><verse number="55" style="v" sid="1KI 8:55" />Cam-nǝ-came sǝ tsǝkî ɓwabundǝa mala Isǝrayila bù puppup, nǝ loasǝ gì kpǝm, ama <verse eid="1KI 8:55" /><verse number="56" style="v" sid="1KI 8:56" />&lt;&lt;Ɓwangsǝban ɓǝ pa aban Yahweh, mǝnana pànî aɓwana male, Isǝrayila usǝlǝo, kǝla mǝnana pacau ace kat ka. Ko kǝ mwashat kpa a nzali aɓalǝ acau male ɗàng; yì apacau mǝɓoarne male, mǝnana kat bangŋi nǝ kún Musa, guro male ka. <verse eid="1KI 8:56" /><verse number="57" style="v" sid="1KI 8:57" />Ɓǝ̀ Yahweh, Ɓakuli ma'sǝm, pà atà sǝm, kǝla mǝnana pà atà aká-sǝm ngga. Ɓǝ̀ kǝa nying sǝm, ko nǝ̀ bwakibuì arǝ sǝm ɗàng, <verse eid="1KI 8:57" /><verse number="58" style="v" sid="1KI 8:58" />ace mǝnana ɓǝ̀ pà sǝm ɓabum mala earce pàk kàne male aɓa koman kat, sǝ ɓǝ̀ sǝm bwal anzongcau, andǝ anê, andǝ anggurcau male, mǝnana tsǝkî aká-sǝm ngga.<verse eid="1KI 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="1KI 8:59" />&lt;&lt;Adyan ngga, ɓǝ̀ do ama, acau mem mǝnia, mǝnana ǝn yinǝia aɓa hiwi aɓadǝm Yahweh Ɓakuli ma'sǝm ngga, ɓǝà ueo a ɓadǝmbi, du andǝ pwari. Ɓǝ̀ camata guro male andǝ aɓwana male Isǝrayila ɓǝà kum gìr mana malea na sǝ à pàktǝle, kǝla mǝnana koya pwari yinǝi ka. <verse eid="1KI 8:59" /><verse number="60" style="v" sid="1KI 8:60" />Anggo sǝ aɓwapǝndǝa kat mala ɓanza nǝ̀ sǝlǝ ama, Yahweh ka, nda Ɓakuli; kǝɓè pà kàm ɗàng. <verse eid="1KI 8:60" /><verse number="61" style="v" sid="1KI 8:61" />Acemani ka, wu nying ɓabum wun kat-kat aban Yahweh, Ɓakuli ma'sǝm. Wu kpata anê male sǝ wu bwal anzongcau male, kǝla mana wu kǝ pak yalung ngga.&gt;&gt;<verse eid="1KI 8:61" /></para>
  <para style="s">Solomon pà agir-nkila</para>
  <para style="p">
    <verse number="62" style="v" sid="1KI 8:62" />Pǝlǝa murǝm andǝ Isǝrayila kat atè, pà gìr'nkila aɓadǝm Yahweh. <verse eid="1KI 8:62" /><verse number="63" style="v" sid="1KI 8:63" />Solomon pà ɓoro mala dotarǝu aban Yahweh: pà andá-rya á-lumi-ɓari-nong-ɓari (22,000) andǝ anzur á-gbǝman-mwashat nǝ á-lumi-ɓari (120,000). Nda murǝm andǝ amǝ Isǝrayila kat, tàr ɓala mala Yahweh aban Yahweh. <verse eid="1KI 8:63" /><verse number="64" style="v" sid="1KI 8:64" />Sǝ a kǝ pwari mǝno ka, Solomon ɗārǝ́ tsùrú mala patal mǝnana nda aɓadǝm ɓala mala Yahweh ka, acemǝnana nda a ban mǝno sǝ pà agir'nkila mala pisǝe kǝring, andǝ apagir mala mǝsǝsa, andǝ mùrú-nyama mala apagir mala dotarǝu. Pè anggo acemǝnana gyangŋan mala bolo-bángŋá mana nda aɓadǝm Yahweh ka, ɓiki kyauwe ace ak agir'nkila mala pisǝe kǝring, andǝ apagir mala mǝsǝsa, andǝ mùrú-nyama mala apagir mala dotarǝu mǝno kat ka.<verse eid="1KI 8:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="1KI 8:65" />Nda Solomon andǝ Isǝrayila kat atè, à pàkkiɗire mala Lamsan mala Agumli, aɓadǝm Yahweh Ɓakuli ma'sǝm, a bàkú mǝno ka. Ɓwabundǝa kǝ̀rkǝ́r purkio arǝ abân kat aɓa nzalinì, twal a Lebo-Hamat kya puro a Myalmúr mala Masar, sǝ à yi ramba. Mǝnia yì pàkkiɗire ka, twal anonggio tongno-nong-ɓari, sǝ aɓea anonggio tongno-nong-ɓari ɗǝm; kpapi-kat ka twal anonggio lum-nong-ine à ndaban pe.<note caller="+" style="f"><char style="fr" closed="false">8:65 </char><char style="ft" closed="false">Tàr gyangŋan twal anonggio tongno-nong-ɓari, sǝ Lamsan mala Agumli twal anonggio tongno-nong-ɓari, kǝla mǝnana à gilǝì aɓa: </char><char style="xt"><ref loc="2CH 7:9">2Acau 7:9</ref> </char> ka.</note><verse eid="1KI 8:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1KI 8:66" />A tongno-nong-tàruià nongŋo ka, Solomon mesǝ aɓwana ɓǝà o, sǝ à tsǝki murǝm bù, sǝ à o arǝ ala malea nǝ banɓoarnado andǝ bumpwasǝa, ace pěmǝɓoarne mǝnana Yahweh lǝmdǝi aban guro male Dauda, sǝ aban Isǝrayila yia aɓwana male ka.<verse eid="1KI 8:66" /></para>
  <chapter eid="1KI 8" />
  <chapter number="9" style="c" sid="1KI 9" />
  <para style="s">Yahweh lǝmdǝ rǝì aban Solomon</para>
  <para style="m">
    <verse number="1" style="v" sid="1KI 9:1" />Lang Solomon malǝna ɓak ɓala mala Yahweh andǝ ɓala mala murǝm andǝ gir mǝnana kat Solomon earkiyice nǝ̀ ɓè ka, <verse eid="1KI 9:1" /><verse number="2" style="v" sid="1KI 9:2" />Yahweh ɓǝsǝlǝ lǝmdǝ rǝì aban Solomon kǝla mǝnana lǝmdǝ rǝì a baní a Gibiyon ngga.<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1KI 3:5">1Amur 3:5</ref>; <ref loc="1KI 11:9">11:9</ref> </char>.</note> <verse eid="1KI 9:2" /><verse number="3" style="v" sid="1KI 9:3" />Yahweh ne wi ama:</para>
  <para style="pi" vid="1KI 9:3">Ən ongŋǝna hiwi mò andǝ azǝmba mô, mǝnana a peǎ a ɓadǝmbam ngga. Ən tarna mǝnia yì ɓala a ɓê ka, ǝn tsǝ́ngŋǝ̀nà lullǝàm kàm tàtǝ́k, sǝ mǝsǝam andǝ ɓabumam ngga à nǝ̀ duk kam koya pwari.<verse eid="1KI 9:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="1KI 9:4" />Ɓǝ̀ we ka, awu nǝ gya aɓadǝmbam, kǝla mǝnana tárró Dauda gya aɓadǝmbam nǝ ɓabum mǝ'mǝsǝcaunì andǝ came kporong ngga, sǝ awu nǝ pàk gìr mǝnana kat ǝn banggo nǝma wu pê, sǝ awu nǝ kpata anê andǝ angguracau mem ngga, <verse eid="1KI 9:4" /><verse number="5" style="v" sid="1KI 9:5" />mǝ nǝ tamsǝkusǝ buno-murǝm mala domurǝm mò amur Isǝrayila tàtǝ́k, kǝla mǝnana ǝn pacau aban tárró Dauda ama, &lt;&lt;A pà wu nǝ ɗwanyi kǝɓwa mò, amur buno-murǝm mala Isǝrayila ɗàng&gt;&gt; ngga.<verse eid="1KI 9:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="1KI 9:6" />Sǝama ɓǝ̀ we, ko amǝkeo, wun nǝ̀ pǝlǝàm nzǝm wun, pà wu nǝ̀ kpata anzongcau andǝ anê mem, mǝnana ǝn tsǝka wuni aɓadǝm wun raka, sǝ wun nǝ̀ kpata aɓea aɓakuli, wun nǝ̀ peri abania ka, <verse eid="1KI 9:6" /><verse number="7" style="v" sid="1KI 9:7" />mǝ nǝ kasǝ Isǝrayila ɓǝ̀ purî ɓá nzali mǝnana ǝn pania wia ka,<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 26:33">Pǝris 26:33</ref>; <ref loc="DEU 4:26">Nggur 4:26</ref>; <ref loc="DEU 28:63">28:63</ref>; <ref loc="2KI 17:23">2Amur 17:23</ref>; <ref loc="2KI 25:21">25:21</ref></char>.</note> sǝ ɓala mǝnana ǝn tarì ace lullǝam ngga, mǝ nǝ túrí ɓǝ̀ purî ɓamǝsǝam,<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 12:5">Nggur 12:5</ref>; <ref loc="1KI 8:20">1Amur 8:20</ref>; <ref loc="JER 7:14">Ir 7:14</ref></char>.</note> sǝ Isǝrayila ka, nǝ̀ dum nǝ ɓǝsǝkiban andǝ oalban aban aɓwapǝndǝa kat.<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:37">Nggur 28:37</ref>; <ref loc="PSA 44:14">Ang 44:14</ref></char>.</note> <verse eid="1KI 9:7" /><verse number="8" style="v" sid="1KI 9:8" />Kat andǝ amani ama à gusǝlǝ mǝnia yì ɓala ka, nǝ̀ duk gìgí. Ɓwa mǝnana kat gyakuti nǝbani ka, nǝ̀ pàk-ndalì, sǝ nǝ̀ sonzǝî-nggê sǝ nǝ̀ na ama, &lt;&lt;Mana tsǝa sǝ Yahweh pàngnǝ nzali man andǝ ɓala mǝnia ani?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 26:32">Pǝris 26:32</ref>; <ref loc="DEU 29:24-26">Nggur 29:24-26</ref>; <ref loc="JER 22:8">Ir 22:8</ref>,<ref loc="JER 22:9">9</ref>; <ref loc="MAT 23:38">Mat 23:38</ref> </char>.</note> <verse eid="1KI 9:8" /><verse number="9" style="v" sid="1KI 9:9" />Sǝ à nǝ̀ pà eare ama, &lt;&lt;Nda acemǝnana à bwakibuia arǝ Yahweh Ɓakuli malea, mǝnana pusǝ atárrià à purî ɓá nzali Masar ka, sǝ à kùr arǝ aɓea aɓakuli, à peri abania, sǝ à kpatea ka. Nda sǝ Yahweh yinǝ mǝnia yì gir'murmwana ka amuria.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 29:25">Nggur 29:25</ref>; <ref loc="DEU 31:29">31:29</ref></char>.</note><verse eid="1KI 9:9" /></para>
  <para style="s">Solomon masǝlǝ túró ɓǎ male</para>
  <para style="r">(<ref loc="2CH 8:1-18">2 Acau la Apwari 8:1-18</ref>)</para>
  <para style="m">
    <verse number="10" style="v" sid="1KI 9:10" />A masǝlǝata apǝlǝa lumi-ɓari, mǝnana twal Solomon sǝ ɓak aɓala mǝno ɓari, yì ɓala mala Yahweh andǝ palta mala murǝm, <verse eid="1KI 9:10" /><verse number="11" style="v" sid="1KI 9:11" />sǝ Hiram murǝm mala amǝ Taya panî Solomon anggun-seda andǝ anggun-sapǝre, andǝ bolo-njengǝlan kǝla mǝnana ɓabumi earkiyice ka, Murǝm Solomon pè Hiram anggea-là lumi-ɓari aɓa nzali Galili. <verse eid="1KI 9:11" /><verse number="12" style="v" sid="1KI 9:12" />Sǝama lang Hiram pur a Taya nǝ̀ ya sǝn anggea-là mǝnana Solomon pe wi ka, bumipwasǝ arǝia ɗàng. <verse eid="1KI 9:12" /><verse number="13" style="v" sid="1KI 9:13" />Hiram bang ama, &lt;&lt;Mǝ'eambam, ya ulang anggea-là na mǝnia a pam ngga?&gt;&gt; Nda sǝ à tunǝna banì ama Kabul<note caller="+" style="f"><char style="fr" closed="false">9:13</char><char style="fq" closed="false">Kabul</char><char style="ft" closed="false">nǝ kún Ibǝru nda kǝla</char><char style="fqa" closed="false">ɓoaro ace kǝgir ɗàng.</char></note> ba yalung ngga. <verse eid="1KI 9:13" /><verse number="14" style="v" sid="1KI 9:14" />Adyan ngga Hiram tasǝnì murǝm bolo-njengǝlan tyang á-tongno (5,000).<verse eid="1KI 9:14" /></para>
  <para style="s">Acili atúró mala Solomon</para>
  <para style="m">
    <verse number="15" style="v" sid="1KI 9:15" />Mǝnia ka nda gìr mǝnana à tsǝì a gilǝe mala túró-púp mǝnana Murǝm Solomon cemi ace ɓak ɓala mala Yahweh andǝ palta male ka, andǝ Millo, andǝ sheran mana gumbǝli Urǝshalima, andǝ Hazo andǝ Megido, andǝ Geza ka. <verse eid="1KI 9:15" /><verse number="16" style="v" sid="1KI 9:16" />(Firona murǝm Masar ka angŋa dǝmba warina nǝ munǝo arǝ Geza sǝ angŋǝni. Soani wi bǝsa pisǝni. Walna-lú amǝ'Kan'ana mǝnana à do aɓa nggea-lê ka, sǝ panî ɓoarnsarile, yì mālá Solomon kǝla ɓoro mala isǝban; <verse eid="1KI 9:16" /><verse number="17" style="v" sid="1KI 9:17" />acemani ka, Solomon ɓǝsǝlǝ ɓak Geza.) Sǝ ɓak Bet-Horon mǝnana nda a ɓangŋaban ngga, <verse eid="1KI 9:17" /><verse number="18" style="v" sid="1KI 9:18" />andǝ Baalat, andǝ Tadmo a njenza, <verse eid="1KI 9:18" /><verse number="19" style="v" sid="1KI 9:19" />andǝ anggea-là mala tsǝk-gǝna mǝnana kat amale na ka, andǝ anggea-là mǝnana tsǝk awaru-pǝr andǝ apǝr male kàm ngga. Solomon ɓak gìr mǝnana kat ɓoari wi nǝ̀ ɓè ka a Urǝshalima, andǝ Lebano, andǝ ɓá nzali puppup mana nda aɓata yálban male ka.<verse eid="1KI 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 9:20" />Aɓwana na kam piu atà amǝ'Amor, andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Hivi, andǝ amǝ'Jebus, mana à ueo aɓa nzalinì, mǝnana amǝ Isǝrayila na raka. <verse eid="1KI 9:20" /><verse number="21" style="v" sid="1KI 9:21" />Amǝkea mǝnana à ueo anzǝmia aɓa nzalinì, yia mǝnana amǝ Isǝrayila gandǝ tària ace kiɗikia kat-kat raka,<note caller="+" style="f"><char style="fr" closed="false">9:21 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JDG 1:21-36">Akas 1:21-36</ref>; <ref loc="JDG 3:1">3:1</ref>; <ref loc="2CH 8:7-8">2Acau 8:7-8</ref></char>.</note> Solomon tsǝia púp ɓǝà duk aguro, sǝ anggo sǝ à pa ba yalung. <verse eid="1KI 9:21" /><verse number="22" style="v" sid="1KI 9:22" />Sǝama Solomon tsǝk kǝɓwa atà amǝ Isǝrayila ɓǝ̀ duk guro ɗàng. Yia ka, à nda ka amǝ'lwa, amǝ'túró-ɓadǝmbi, andǝ amǝgulo-lwa male, andǝ amǝkok awaru-pǝr male, andǝ amǝpǝr male.<verse eid="1KI 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 9:23" />Solomon twal amǝgulo gbǝman-tongno nǝ lumi-tongno (550) sǝ tsǝia à nda ka amǝ'sǝntà-túrô mala Solomon; yia na à yálmúr aɓwana mǝnana à pàkkiyi túrè ka.<verse eid="1KI 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 9:24" />Zuku anzǝm mana ɓoarnsarile Firona purni nggea-là mala Dauda sǝ yina a ɓala male mana Solomon ɓakkî wi ka, nda Solomon ɓak Millo ka.<verse eid="1KI 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 9:25" />Kusǝ tàrú aɓa pǝlǝa mwashat Solomon kǝ pa ɓoro mala pisǝe kǝring andǝ ɓoro mala dotarǝu amúr gyangŋan mǝnana ɓakkî Yahweh ka. Kǝ paɓoro mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ateà, amúr gyangŋan mǝnana nda aɓadǝm Yahweh ka. Anggo sǝ Solomon yi masǝlǝ ɓak ɓalae.<verse eid="1KI 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 9:26" />Ɗǝm ngga Solomon gballì awaru-bǝsa a Eziyon-Geba, tù aban Elot, a kún Nggeamùr Nzuno a nzali Edom. <verse eid="1KI 9:26" /><verse number="27" style="v" sid="1KI 9:27" />Sǝ Hiram tasǝ amǝtúró male ɓǝà kpapibu andǝ amǝ'samsǝa aɓa nggeamùr mǝnana à ndanǝ sǝlǝe amúr nggeamùr ka, atārǝia andǝ aguro mala Solomon. <verse eid="1KI 9:27" /><verse number="28" style="v" sid="1KI 9:28" />À wari a Ofir sǝ à pwan tyang á-lum-nong-ine (14,000) mala bolo-njengǝlan abanì, sǝ à yinǝì Murǝm Solomon wi.<verse eid="1KI 9:28" /></para>
  <chapter eid="1KI 9" />
  <chapter number="10" style="c" sid="1KI 10" />
  <para style="s">Mā-murǝm mala amǝ Sheba yiu <optbreak /> a sǝn Murǝm Solomon</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 10:1" />Lang mā-murǝm mala amǝ Sheba okcau mala zǝ́kí mala Solomon mǝnana yinǝ pagulo arǝ lullǝ Yahweh ka, lo yiu nǝ aɗikiban mǝkwane, nǝ̀ mwam Solomon nǝia. <verse eid="1KI 10:1" /><verse number="2" style="v" sid="1KI 10:2" />Yiu atārǝia andǝ amǝ'tè kaɓa nyangsang; à yi tusǝ a Urǝshalima nǝ akalakadambi mǝnana à tsaɗi a nzǝmarǝia nǝ atwalo a nzǝmia ka; atwalo mala agir-mǝ'kuskushi, andǝ bolo-njengǝlan kǝ̀rkǝ́r, andǝ atali-gǝna. Sǝ lang yina aban Solomon ngga, ɗìkí nǝ acau amur agir mǝnana kat yì Mā-murǝm ndanǝi a ɓabumi nǝ̀ ɗìkí ka. <verse eid="1KI 10:2" /><verse number="3" style="v" sid="1KI 10:3" />Solomon pe wi eare arǝ aɗikiaban male kat; ɓekǝ cau pà kàm mǝnana ama kwan kǝ̀rkǝ́r Solomon gandǝ bǝ́lì wi ɓālǝi raka ɗàng. <verse eid="1KI 10:3" /><verse number="4" style="v" sid="1KI 10:4" />Mā-murǝm mala amǝ Sheba yi sǝn Solomon ngga mǝ'sǝlǝe na kǝ̀rkǝ́r. Sǝ lang sǝn palta mǝnana Solomon ɓak ka, <verse eid="1KI 10:4" /><verse number="5" style="v" sid="1KI 10:5" />andǝ agirlina mǝnana à tsǝia a ban-li male, andǝ do mala amǝ'tè, andǝ amǝtúró-ɓadǝm Solomon aɓalǝ adaura-murǝm malea, andǝ amǝ'pa-girnùná male, andǝ agir'nkila mǝnana à kǝ pisǝia ace paɓoro aban Yahweh aɓa ndàmǝgule ka, gìrnî tsǝì mǝn kúni aban ndali.<verse eid="1KI 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 10:6" />Ne Solomon ama, &lt;&lt;Cau mǝnana aɓwana yi banggam a nzali mem amúr acau mò andǝ sǝlǝe mò ka mǝsǝcaua, <verse eid="1KI 10:6" /><verse number="7" style="v" sid="1KI 10:7" />sǝama ǝn earnǝ acau mǝno ka ɗàng, she lang ǝn yina sǝ amǝsǝam sǝnǝni ka. Sǝ mǝsǝcau ka, gauwa-tsùrú mala ceì ka, à banggam ɗàng. Sǝlǝe mò andǝ gǝna mò ka à kútì mǝnana à bangŋi ǝn oê ka. <verse eid="1KI 10:7" /><verse number="8" style="v" sid="1KI 10:8" />Aɓwana mô ka amǝ'múrɓoarna na! Amǝ'túró mô mǝnana à kǝ cam a ɓadǝmbo à kǝ ok acau sǝlǝe mò ka, amǝ'múrɓoarna na!<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 8:34">Pas 8:34</ref> </char>.</note> <verse eid="1KI 10:8" /><verse number="9" style="v" sid="1KI 10:9" />Ɓwangsǝban ngga ɓǝà pè Yahweh Ɓakuli mô, mǝnana banɓoari wi arǝò, sǝ dumsǝo amúr buno-murǝm mala Isǝrayila ka!<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2SA 22:20">2Sam 22:20</ref>; <ref loc="1KI 5:7">1Amur 5:7</ref></char>.</note> Ace earcearǝu mǝnana Yahweh ndanǝi arǝ Isǝrayila, yì earcearǝu mǝnana málá male pà kàm raka, twalǝno wu duk murǝm ace mǝnana wu lǝmdǝ mǝsǝcau a ɓashi andǝ ɓealɓoarna.&gt;&gt;<verse eid="1KI 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 10:10" />Pǝlǝa mā-murǝm mala amǝ Sheba pè Solomon bolo-njengǝlan mǝnana dǝmbǝrya male ka tyang á-ine (4,000) na ka; ɗǝm ngga pè wi atali-gǝna pas andǝ agir-mǝ'kuskushi kǝ̀rkǝ́r. Anzǝm mǝno ka, kǝɓwa nyare yiu nǝ agir-mǝ'kuskushi mǝkǝ̀rkǝ́rnì kǝla mǝnana mā-murǝm mala amǝ Sheba pè Murǝm Solomon ngga ɗàng. <verse eid="1KI 10:10" /><verse number="11" style="v" sid="1KI 10:11" />Nyarɗǝm ngga, awaru-bǝsa mala Hiram mǝnana à wari a Ofir sǝ à yinǝ bolo-njengǝlan ngga, à yinǝ nggun almu gbal a buia, andǝ atali-gǝna kaɓa-kpǝm. <verse eid="1KI 10:11" /><verse number="12" style="v" sid="1KI 10:12" />Murǝm paktúró nǝ nggun almu ace nggun-gbasha mala ɓala mala Yahweh, sǝ ace palta mala murǝm, sǝ ɗǝm ngga ace shàr adànà andǝ azangŋan ace amǝ'nggyal. Ulang mǝno yì nggun almu ka, à yinǝi ko à sǝni ɗǝm ɗàng ba yalung.<verse eid="1KI 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 10:13" />Murǝm Solomon pè mā-murǝm Sheba agir mǝnana kat earkicea ka; gìr mǝnana kat ɗice, tsǝa-amur agir mǝnana murǝm pàni wi ka, Murǝm Solomon pè wi aɓa nyangsang mala pàbu male. Pǝlǝa nyare o a nzali male andǝ amǝtè.<verse eid="1KI 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 10:14" />Dǝmbǝrya mala bolo-njengǝlan mǝnana Solomon kumo a pǝlǝa mwashat ka, nda tyang á-lumi-ɓari bwamdǝ tongno (25,000),<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">Ib: </char><char style="fqa" closed="false">talent gbǝman-tongno-nong-mwashat nǝ lumi-tongno-nong-mwashat bwamdǝ tongno-nong-mwashat (666). </char></note> <verse eid="1KI 10:14" /><verse number="15" style="v" sid="1KI 10:15" />ɗeki amǝnana kum aɓa cemi mǝnana à yinǝì wi nǝi a bu amǝ'nggali, andǝ mǝnana kum aban amǝ'kúrkúró andǝ amǝ'makkiagir, andǝ mǝnana kum a bu amurǝma mana kat nǝ njar-nzali ka, andǝ mǝnana nǝban anggwamna mala nzalinì ka. <verse eid="1KI 10:15" /><verse number="16" style="v" sid="1KI 10:16" />Murǝm Solomon pàk antongŋo mǝgulke gbǝman-ɓari mala bolo-njengǝlan mǝnana à walki ka, sǝ koya ntongŋo ka tyang tongno-nong-ɓari mala bolo-njengǝlan na à pè nǝi ka. <verse eid="1KI 10:16" /><verse number="17" style="v" sid="1KI 10:17" />Sǝ pàk antongŋo mǝkeke gbǝman-tàrú (300) mala bolo-njengǝlan mǝnana à walki ka; pàktúró nǝ tyang ɓari mala bolo-njengǝlan sǝ pàk komǝye ateà ka. Sǝ murǝm tsǝk atongŋo mǝnia kat ka a Palta mala Ndà-nggun Lebano.<verse eid="1KI 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 10:18" />Ɗǝm ngga, murǝm pàk nggea buno-murǝm nǝ aminǝ-nzu sǝ à tasǝ rǝi nǝ bolo-njengǝlan mǝɓoarne kat-kat. <verse eid="1KI 10:18" /><verse number="19" style="v" sid="1KI 10:19" />Buno-murǝmì ka ndanǝ aban-eauwe tongno-nong-mwashat, sǝ múr buno-murǝmì ka kàr kunggurung. Sǝ amur koya bu buno-murǝmì ka, ban nongsǝ myalbu na kam, sǝ ɓǝ̀nzál mala im na kam gbal aban came a nkanggari koya ban nongsǝ myalbu ka. <verse eid="1KI 10:19" /><verse number="20" style="v" sid="1KI 10:20" />Aɓǝ̀nzál mala a'im na kam lum-nong-ɓari mǝnana à came amur aban-eauwe tongno-nong-mwashat ka, mwashat a koya kúnban mala akúnban ɓari mala koya ban-eauwe. À pàk ulangyi a kǝ pwara, a ɓè domurǝm ɗàng. <verse eid="1KI 10:20" /><verse number="21" style="v" sid="1KI 10:21" />Akwap kat mala nugìr mala Murǝm Solomon ngga, à peǎ nǝ bolo-njengǝlan, sǝ atanggǝla mala Palta mala Ndà-nggun Lebano kat ka, à peǎ nǝ bolo-njengǝlan mǝɓoarne. Ɓekǝ gìr pà kàm mǝnana à pè nǝ azǝrfa ka ɗàng; acemǝnana à twal azǝrfa kǝla kǝgir na ɗàng a nza mala Solomon. <verse eid="1KI 10:21" /><verse number="22" style="v" sid="1KI 10:22" />Murǝm ngga ndanǝ awaru-bǝsa pas mala twal gya mǝsauwe amur nggeamùr andǝ awaru-bǝsa mala Hiram. Kusǝ mwashat aɓa koya pǝlǝa tàrú ka, à kǝ yinǝ bolo-njengǝlan, andǝ bolo-azǝrfa, andǝ aminǝ-nzu, andǝ agbakǝm, andǝ anyál-murǝm.<verse eid="1KI 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 10:23" />Nda Murǝm Solomon yi kútì amurǝma mala ɓanza nǝ gǝna andǝ sǝlǝe. <verse eid="1KI 10:23" /><verse number="24" style="v" sid="1KI 10:24" />Ɓanza kat alta yiu aɓadǝm Solomon ace ok sǝlǝe male, mǝnana Ɓakuli pe wi a ɓabumi ka. <verse eid="1KI 10:24" /><verse number="25" style="v" sid="1KI 10:25" />Pǝlǝa anzǝm pǝlǝa, koyan mǝnana yiu ka, yinǝ aɓoro male: agir bolo-azǝrfa andǝ bolo-njengǝlan, agir-nggūrǝu, andǝ agirbura, andǝ agir-mǝ'kuskushi, andǝ apǝr, andǝ apǝr-mǝdambǝriso.<verse eid="1KI 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 10:26" />Pǝlǝa Solomon ramba awaru-pǝr andǝ amǝ'pǝ̀r abanɓwáná. Ndanǝ awaru-pǝr á-mwashat nǝ gbǝman-ine (1,400) andǝ amǝ'pǝ̀r á-lum-nong-ɓari (12,000) mǝnana tsǝia arǝ anggea-là mala awaru-pǝr ka, sǝ tsǝk aɓea atè a Urǝshalima. <verse eid="1KI 10:26" /><verse number="27" style="v" sid="1KI 10:27" />Murǝm Solomon tsǝa, bolo-azǝrfa na kam a koya ban aɓa Urǝshalima kǝla amǝsǝtali, sǝ tsǝa, aɓwana kǝ kum nggun-seda kpǝm kǝla nggun-vwari mǝnana kǝ gul a kusǝ ankono ka. <verse eid="1KI 10:27" /><verse number="28" style="v" sid="1KI 10:28" />Apǝr mala Solomon ngga à kúria a Masar andǝ Kuwe sǝ à yinǝia. Amǝ'nggali mala ɓala-murǝm kúria a Kuwe. <verse eid="1KI 10:28" /><verse number="29" style="v" sid="1KI 10:29" />Waru-pǝr mwashat ka à kúrí a kún shekel gbǝman-tongno-nong-mwashat (600) mala bolo-azǝrfa a Masar sǝ à yinǝi, sǝ pǝ̀r mwashat ka a kún shekel gbǝman-mwashat-nǝ-lumi-tongno (150) mala bolo-azǝrfa. Yià gbal ka à kǝ makki awaru-pǝr andǝ apǝr mǝnia ka aban amurǝma mala amǝ'Hitti andǝ amurǝma mala amǝ'Suriya kat, ace umnǝia arǝ anzali malea.<verse eid="1KI 10:29" /></para>
  <chapter eid="1KI 10" />
  <chapter number="11" style="c" sid="1KI 11" />
  <para style="s">Amālá Murǝm Solomon pǝlǝ ɓabumi <optbreak /> nying njar mala Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 11:1" />Murǝm Solomon earce amamǝna pas mǝnana amǝ Isǝrayila na raka. Tsǝa-amur muna-ɓwama mala murǝm Masar mǝnana al ka, yì ɗǝm ngga alki amamǝna mala amǝ'Mowap, andǝ amǝ'Amon, andǝ amǝ'Edom, andǝ amǝ'Sidon, andǝ amǝ'Hitti. <verse eid="1KI 11:1" /><verse number="2" style="v" sid="1KI 11:2" />Amǝnia ka à nda ka aɓwapǝndǝa mǝnana Yahweh bangŋǝni amǝ Isǝrayila ama, &lt;&lt;Pà wu nǝ̀ al rǝarǝ wun wunǝia ɗàng, acemǝnana à nǝ̀ pǝlǝ ɓabum wun aban kpata ankúl malea.&gt;&gt; Sǝ Solomon ngga ɓinǝe, dambǝa arǝ earce amamǝna man. <verse eid="1KI 11:2" /><verse number="3" style="v" sid="1KI 11:3" />Ndanǝ amamǝna gbǝman-tongno-nong-ɓari (700) mǝnana amuna-amurǝma na, andǝ amā-twala gbǝman-tàrú (300). Sǝ aɓa mǝsǝcau, amāmí mǝnia yi pǝlǝ ɓabumi, nying kpata Ɓakuli. <verse eid="1KI 11:3" /><verse number="4" style="v" sid="1KI 11:4" />Yi do ama lang Solomon yi twal ě ka, amāmí pǝlǝna ɓabumi aban peri atà aɓea aɓakuli. Pà ɓabumi kat aban kpata Yahweh Ɓakuli male, kǝla mǝnana tárrí Dauda pàk ka ɗàng. <verse eid="1KI 11:4" /><verse number="5" style="v" sid="1KI 11:5" />Solomon yi kútí a peri atà nkúl mala amǝ'Sidon, mǝnana à tunǝki ama Ashterot, andǝ peri atà nkúl gìr'ɓeami mala amǝ'Amon, mǝnana à tunǝki ama Molek ka. <verse eid="1KI 11:5" /><verse number="6" style="v" sid="1KI 11:6" />Anggo sǝ Solomon pàk gìr mǝnana mǝɓane na a mǝsǝ Yahweh ka; kpata Yahweh nǝ ɓabumi kat kǝla mǝnana tárrí Dauda pàk ka, ɗàng. <verse eid="1KI 11:6" /><verse number="7" style="v" sid="1KI 11:7" />Solomon kya ɓak amgbangban ndàka-ankúl ace Kemosh, yì nkúl gìr'ɓeami mala amǝ'Mowap, andǝ ban-peri ace Molek, yì nkúl gìr'ɓeami mala amǝ'Amon, amur Nkono, nǝ njar-takuli mala Urǝshalima. <verse eid="1KI 11:7" /><verse number="8" style="v" sid="1KI 11:8" />Yì ɗǝm ngga, ɓakki agyangŋan mala ndàka-ankúl mǝnana abǝri amāmí kat kǝ paɓoro mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne, sǝ à kǝ pa gìr'nkila kàm aban ankúl malea ka.<verse eid="1KI 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 11:9" />Bum Yahweh lul kǝ̀rkǝ́r arǝ Solomon, acemǝnana ɓabumi pǝlǝa, nying Yahweh, yì Ɓakuli mala amǝ Isǝrayila, mǝnana lǝmdǝ rǝì a baní kusǝ ɓari ka.<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1KI 3:5">1Amur 3:5</ref>; <ref loc="1KI 9:2">9:2</ref></char>.</note> <verse eid="1KI 11:9" /><verse number="10" style="v" sid="1KI 11:10" />Kat andǝ amani ama Ɓakuli nunkir Solomon arǝ peri atà ankúl ka, Solomon ginǝ kpata cau mǝnana Yahweh banggi wi ka. <verse eid="1KI 11:10" /><verse number="11" style="v" sid="1KI 11:11" />Acemani ka, Yahweh banggi Solomon ama, &lt;&lt;Acemǝnana gìr mǝnia ka pǝlǝno ɓealo, sǝ a ginǝna kpata kùrcau mem andǝ nzongcau mem, mǝnana ǝn tsǝko ka, mǝ ndarǝ banggo, mbak-kàngkàng mǝ ndo mǝ nǝ san domurǝm arǝò, mǝ nǝ pè mwashat atà amǝ'tò. <verse eid="1KI 11:11" /><verse number="12" style="v" sid="1KI 11:12" />Sǝama atàcau mala tárró Dauda ka, pà mǝ nǝ san domurǝmì a do-yilǝmu mô ɗàng. Mǝ nǝ sannì a bu munio. <verse eid="1KI 11:12" /><verse number="13" style="v" sid="1KI 11:13" />Kat andǝ amani ka, pà mǝ nǝ é kat ɗàng; mǝ nǝ nyinggi munio tàu mwashat atàcau mala guro mem Dauda, sǝ atàcau mala Urǝshalima, nggea-là mem mǝnana ǝn tarì ka.&gt;&gt;<verse eid="1KI 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 11:14" />Pǝlǝa Yahweh loasǝ ɓè ɓiumǝbura arǝ Solomon, Hadat ɓwa Edom. Yì ka nda a tàu-murǝm a nzali Edom.<verse eid="1KI 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 11:15" />
    <note caller="+" style="f">
      <char style="fr" closed="false">11:15 </char>
      <char style="ft" closed="false">Ɓalli aɓa: </char>
      <char style="xt">
        <ref loc="2SA 8:14">2Sam 8:14</ref>; <ref loc="1CH 18:12">1Acau 18:12</ref>,<ref loc="1CH 18:13">13</ref></char>.</note>Ɗiɗyal mǝnana Dauda na aɓa munǝo andǝ Edom ngga, Jowap mǝ'sàrǝ̀ban mala amǝ'lwa wari a lúmsǝ́ lú aɓwana mǝnana à wallia ka, sǝ yì Jowap ka wal-lú aburana mǝnana à nda a Edom ngga kat. <verse eid="1KI 11:15" /><verse number="16" style="v" sid="1KI 11:16" />(Jowap andǝ amǝ'lwa mala Isǝrayila puppup ka à ue kano zongŋo tongno-nong-mwashat, she lang walna-lú aburana mǝnana a Edom ngga kat). <verse eid="1KI 11:16" /><verse number="17" style="v" sid="1KI 11:17" />Sǝama Hadat, mǝnana a bàkú mǝno ka muntulo na piu ka, ɓangŋa o a Masar atārǝia andǝ aɓea amǝ'Edom mǝnana aguro mala tárrí na ka. <verse eid="1KI 11:17" /><verse number="18" style="v" sid="1KI 11:18" />À twal gya a Midiyan sǝ à kya bik Paran; à twal aɓea aburana ateà a Paran sǝ à o a Masar, aban Firona murǝm Masar mǝnana pe wi ɓala, pe wi girlina sǝ pe wi nzali ka. <verse eid="1KI 11:18" /><verse number="19" style="v" sid="1KI 11:19" />Hadat ka kum murɓoarna mǝgule a mǝsǝ Firona, mǝnana tsǝa Firona pe wi ɓwama, mǝ'kyauwa Tapines mā-murǝm, ɓǝ̀ duk māmí ka. <verse eid="1KI 11:19" /><verse number="20" style="v" sid="1KI 11:20" />Sǝ mǝ'kyauwa Tapines ɓǝlî wi muna-ɓwabura lullǝi ama Genubat. Tapines lǝsǝì a ɓala mala Firona; sǝ Genubat gulo atà amuna mala Firona a ɓala mala Firona.<verse eid="1KI 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 11:21" />Lang Hadat ok a Masar ama Dauda pàngŋǝ̀nà-lú, sǝ Jowap mǝ'sàrǝ̀ban mala amǝ-lwa wuna ka, Hadat banggi Firona ama, &lt;&lt;Ɗekiam ɓǝ̀n o a nzali mem.&gt;&gt;<verse eid="1KI 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 11:22" />Sǝ Firona ɗì ama, &lt;&lt;Mana a ɗwanyi kani a banam mǝnana tsǝa sǝ ado a kǝ alta o a nzali mô ka?&gt;&gt;</para>
  <para style="p" vid="1KI 11:22">Pǝlǝa eari wi ama, &lt;&lt;Ən ɗwanyi kǝgir ɗàng, sǝama ida, ɗekiam ɓǝn o.&gt;&gt;<verse eid="1KI 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 11:23" />Ɓè mǝbura mǝnana Ɓakuli nyare loasǝi arǝ Solomon ngga nda Rezon muna-ɓwabura mala Eliyada, mǝnana ɓangŋa nying mǝtala-ɓala male Hadadeza, murǝm Zoba ka. <verse eid="1KI 11:23" /><verse number="24" style="v" sid="1KI 11:24" />Yì ka rambǝa aburana atè sǝ duk ɓwamǝgule amur amǝ'mgbicau. Anzǝm mǝnana Dauda walǝna amǝ Zoba ka, Rezon andǝ aburana male ɓangŋa à o a Damaska, à kya duk kam sǝ à tsǝì duk murǝm a Damaska. <verse eid="1KI 11:24" /><verse number="25" style="v" sid="1KI 11:25" />Rezon ngga ɓimǝbura mala Isǝrayila na aɓa do-yilǝmu mala Solomon kat, sǝ pàkkî Isǝrayila mǝɓike kǝla mǝnana Hadat pàk ka. Rezon ɓinǝmǝsǝ Isǝrayila sǝ duk murǝm a Suriya.<verse eid="1KI 11:25" /></para>
  <para style="s">Mgbicau mala Jerobuam</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 11:26" />Ɓeɓwa mǝnana mgbicau arǝ Murǝm Solomon ngga nda Jerobuam, ɓè mǝtúró mala Solomon. Tárrí nda Nebat, ɓwa Ifǝrem mala Zereda. Lullǝ ngge, mǝnana mā-lú na ka nda Zeruwa. <verse eid="1KI 11:26" /><verse number="27" style="v" sid="1KI 11:27" />Mǝnia ka nda gìr mǝnana tsǝa sǝ Jerobuam mgbicau arǝ murǝm ngga: Lang Solomon na aban ɓak Millo, sǝ ndarǝ gilǝki ban mǝnana ara arǝ sheran mala nggea-là mala tárrí Dauda ka, <verse eid="1KI 11:27" /><verse number="28" style="v" sid="1KI 11:28" />yi sǝn lagga man, yì Jerobuam ngga mǝ'ɓiki-túró na ka, pǝlǝa murǝm twali tsǝì ɓǝ̀ duk mǝ'ɗenyinǝ túró-púp mala ɓala mala Yisǝfu.<verse eid="1KI 11:28" /></para>
  <para style="s">Ɓangnǝa ama Domurǝm mala Isǝrayila nǝ̀ gau ɓari</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 11:29" />A ɓè pwari mwashat Jerobuam na aban purrì ɓá Urǝshalima sǝ je andǝ mǝɓangnǝa Ahija, ɓwa Shilo, a njar. Ahija ka, bǝsa daura na túr arǝì ka. À kǝ nda yia ɓari nǝmurǝia a nzǝm la. <verse eid="1KI 11:29" /><verse number="30" style="v" sid="1KI 11:30" />Pǝlǝa Ahija bwal bǝsa daura mǝnana nda arǝì ka, sàngi arǝ abanì lum-nong-ɓari. <verse eid="1KI 11:30" /><verse number="31" style="v" sid="1KI 11:31" />Pǝlǝa ne Jerobuam ama, &lt;&lt;Ang asanginè lum mala daure ace ɓamúrò, acemǝnana Yahweh Ɓakuli mala amǝ Isǝrayila bang ama, &lt;Sǝni, Mǝ ndo mǝ nǝ san domurǝm mala amǝ Isǝrayila a bù Solomon, sǝ mǝ nǝ nyesǝ lum atà atau malea mǝ nǝ po. <verse eid="1KI 11:31" /><verse number="32" style="v" sid="1KI 11:32" />Sǝama atàcau mala guro mem Dauda, sǝ atàcau mala Urǝshalima, yì nggea-là mǝnana ǝn tarrì aɓalǝ atau mala amǝ Isǝrayila ka, mǝ nǝ nyinggi wi tàu mwashat. <verse eid="1KI 11:32" /><verse number="33" style="v" sid="1KI 11:33" />Mǝ nǝ ak domurǝm arǝ Solomon acemǝnana yì ka ginǝkinam, kutina a peri aban Ashterot, yì nkúl mǝɓwame mala amǝ'Sidon; andǝ Kemosh, yì nkúl mala amǝ'Mowap; sǝ aban Molek, yì nkúl mala amǝ'Amon. Yì ka kpata anjar mem, pak gìr mǝnana nǝ̀ pwasǝbumam ngga ɗàng. Yì ka kpata nê mem andǝ sà'arǝban mem kǝla mǝnana tárrí Dauda pàk ka ɗàng.<verse eid="1KI 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 11:34" />&lt;&lt; &lt;Kat andǝ amani ka, pà mǝ nǝ ak domurǝm kat arǝ Solomon ado ɗàng. Atàcau mala guro mem Dauda mǝnana ǝn tarì, sǝ kpata anzongcau mem andǝ anê mem ngga, mǝ nǝ nying Solomon ɓǝ̀ lidǝmba kǝla murǝm arǝ acili anonggio mala do ɓanza male kat. <verse eid="1KI 11:34" /><verse number="35" style="v" sid="1KI 11:35" />Mǝ nǝ yia ak domurǝm a bù munì sǝ mǝ nǝ po atau lum. <verse eid="1KI 11:35" /><verse number="36" style="v" sid="1KI 11:36" />Munì nǝ̀ duk murǝm amur tàu mwashat, ace mǝnana ɓǝ̀ tàu mala guro mem Dauda ɓǝ̀ lidǝmba amur buno-murǝm, ɓǝ̀ kǝ tá kǝla pitǝla a Urǝshalima, yì nggea-là mǝnana ǝn tarì mǝ nǝ tsǝk lullǝam kàm ngga. <verse eid="1KI 11:36" /><verse number="37" style="v" sid="1KI 11:37" />Sǝ we ka, mǝ nǝ tsǝo wu duk murǝm mala Isǝrayila, sǝ awu nǝ yálmúr agir mǝnana kat a earce a ɓabumo ka. <verse eid="1KI 11:37" /><verse number="38" style="v" sid="1KI 11:38" />Ɓǝ̀ a kwakikiro arǝ agir mǝnana kat ǝn nô, sǝ a kpata anjar mem, sǝ awu nǝ pàk gìr mǝnana nda jik abanam, awu nǝ kpata anê mem andǝ anzongcau mem, kǝla mǝnana guro mem Dauda pàk ka, mǝ nǝ cam atò. Mǝ nǝ tsǝǒ wu duk murǝm amur Isǝrayila, sǝ mǝ nǝ tsǝk munio andǝ amǝ'keò à nǝ̀ lidǝmba nǝ do amur buno-murǝm, do-bunomurǝm mǝnana pà nǝ̀ mal raka, kǝla mǝnana ǝn pakki Dauda ka. <verse eid="1KI 11:38" /><verse number="39" style="v" sid="1KI 11:39" />Ace cauɓikea mala Solomon ngga, mǝ nǝ pakkî amǝkà Dauda gìr'kwanban, sǝ mǝnia ka pà nǝ̀ duk gìr'kwanban mǝnana málá male pà kàm raka ɗàng.&gt; &gt;&gt;<verse eid="1KI 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 11:40" />Solomon ɓariki nǝ̀ wal-lú Jerobuam, sǝ Jerobuam ngga ɓangŋa o a Masar kya kum ban-auwa a ban Shishak, murǝm mala amǝ Masar. Jerobuam ue kano a Masar bà lú mala Solomon.<verse eid="1KI 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 11:41" />Adyan ngga, acili atúró mala Solomon, andǝ agir mana kat pàkkia, andǝ sǝlǝe male ka, à nda kam a gilǝe aɓa Malǝmce mala Atúró mala Solomon. <verse eid="1KI 11:41" /><verse number="42" style="v" sid="1KI 11:42" />Yálban mala Solomon a Urǝshalima, amur Isǝrayila kat ka, apǝlǝa lumi-ine (40) na. <verse eid="1KI 11:42" /><verse number="43" style="v" sid="1KI 11:43" />Sǝ Solomon paklú, sǝ à tsǝì a nggea-là mala tárrí Dauda. Sǝ muna-ɓwabura male Rehobuam duk murǝm a bancame male.<verse eid="1KI 11:43" /></para>
  <chapter eid="1KI 11" />
  <chapter number="12" style="c" sid="1KI 12" />
  <para style="s">Domurǝm purî bù Rehobuam</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 12:1" />Rehobuam wari a Shekem, acemǝnana akanó ka amǝ Isǝrayila kat yi ramǝna à nǝ̀ pe wi gara-murǝm. <verse eid="1KI 12:1" /><verse number="2" style="v" sid="1KI 12:2" />Lang Jerobuam muna-ɓwabura mala Nebat nǝ̀ ok cau mǝno ka, nyàrî Masar, (acemǝnana yì ɗiɗyal ka ɓangŋa o a Masar kya ue kam ace apî bù Murǝm Solomon.) <verse eid="1KI 12:2" /><verse number="3" style="v" sid="1KI 12:3" />Aɓwana-mǝgule mala Isǝrayila túrnaban atè ɓǝ̀ yiu, sǝ yì Jerobuam andǝ amǝ Isǝrayila kat, à wari atārǝia aban Rehobuam, à nǝ̀ nggá nacau nǝi. À banggi Rehobuam ama, <verse eid="1KI 12:3" /><verse number="4" style="v" sid="1KI 12:4" />&lt;&lt;Tárró para sǝm twalo mǝdǝmbǝre amur sǝm. Ado ka, ɓǝ̀ awu nǝ amsǝa sǝm túró-gula mǝnana tsǝk sǝm a pě, sǝ awu nǝ amsǝa sǝm boalo-cemi mǝkǝ̀rkǝ́rnì mǝnana kasǝa sǝm ngga, sǝm nǝ̀ duk aɓwana aɓato nǝ ɓabum sǝm mwashat.&gt;&gt;<verse eid="1KI 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 12:5" />Rehobuam earia wia ama, &lt;&lt;Wu pam nongŋo tàrú mǝ nǝ pak ɗenyicau amur mǝnia yì cau ka. Anzǝm mǝno ka, wu nyare wu yiu ace ok eare mem amurí.&gt;&gt; Pǝlǝa aɓwana mesǝe à o.<verse eid="1KI 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 12:6" />Murǝm Rehobuam pǝlǝa alta dǒ andǝ aɓwana-mǝgule, mǝnana à pākiyi tárrí Solomon kwarkiru a do-yilǝmu male ka. Ɗia ama, &lt;&lt;Ya kwarkiru na wun nǝ̀ pam, arǝ cau mǝnana ɓoaro mǝ nyesǝì aɓwana mǝnia ka?&gt;&gt;<verse eid="1KI 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 12:7" />À banggi wi ama, &lt;&lt;Ɓǝ̀ yalung awu nǝ eare, awu nǝ duk mǝtúró-ɓadǝm aɓwana mǝnia, sǝ awu nǝ pea wia gìr mǝnana à zǝmba, sǝ awu nǝ nyesǝia wia cau mǝnana nǝ̀ ɓoaria wia ka, à nǝ̀ duk aɓwana aɓato tàtǝ́k.&gt;&gt;<verse eid="1KI 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 12:8" />Sǝ Rehobuam ngga ginǝki kwarkiru mǝnana aɓwana-mǝgule pe wi ka. A kún mani ka o aban alaggana mǝnana à ndàlo andǝi, mǝnana twalia ado à nda ka amǝ'kwarkiru male ka, kya ɗia mana nda sǝne malea amur ceì. <verse eid="1KI 12:8" /><verse number="9" style="v" sid="1KI 12:9" />Ɗia ama, &lt;&lt;Mana nda kwarkiru ma'wun? Ya cau na mǝ nǝ nyesǝî aɓwana mǝnana à kǝ earce ama mǝ amsǝia wia twalo mǝdǝmbǝre mǝnana tárrám paria wia amúrià ka?&gt;&gt;<verse eid="1KI 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 12:10" />Alaggana eari wi ama, &lt;&lt;Mǝnia ka ndà cau mǝnana awu nǝ nggá nyesǝî aɓwana mǝnana à bang ama wu amsǝia wia twalo mǝdǝmbǝre mǝnana tárró paria wia amúrià ka: &lt;Munabuam mǝkyauwe nyane kútì byal tárrám! <verse eid="1KI 12:10" /><verse number="11" style="v" sid="1KI 12:11" />E, tárrám tsǝka wun twalo mǝdǝmbǝre amur wun, sǝ mǝ ndo mǝ nǝ tsǝka wun dǝmbǝrya amur ɓè. Yì ka kwak wun nǝ nkamso, sǝ mim ngga mǝ nǝ tāki wun nǝ agenye.&gt; &gt;&gt;<verse eid="1KI 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 12:12" />Anzǝm anongŋo tàrú ka Jerobuam andǝ aɓwana kat nyare à nǝ̀ yia ok cau mǝnana Murǝm Rehobuam nǝ̀ nyesǝia wia, kǝla mǝnana akdǝmba nea wia ka. <verse eid="1KI 12:12" /><verse number="13" style="v" sid="1KI 12:13" />Sǝ Murǝm Rehobuam ngga yi kpākiarǝ aɓwana mǝno. Ginǝki kwarkiru mǝnana aɓwana-mǝgule pè wi ka, <verse eid="1KI 12:13" /><verse number="14" style="v" sid="1KI 12:14" />kpata kwarkiru mǝnana alaggana pe wi ka. Banggi aɓwana mǝno ka ama, &lt;&lt;Tárrám tsǝka wun twalo mǝdǝmbǝre, sǝ mim ngga, mǝ nǝ tsǝka wun dǝmbǝrya amur ɓè! Tárrám kwak wun nǝ nkamso, sǝ mim ngga, mǝ nǝ tāki wun nǝ agenye!&gt;&gt;<verse eid="1KI 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 12:15" />Murǝm ngga falǝnǝ cau mala aɓwana ɗàng. Mǝnia ka pě mala Yahweh na sǝ acau yi pǝlǝa ani ace mǝnana ɓǝà lùmsǝ cau mala Yahweh mǝnana ne Jerobuam muna-ɓwabura mala Nebat nǝ kún mǝɓangnǝa Ahija ɓwa Shilo ka.<verse eid="1KI 12:15" /></para>
  <para style="s">Gauwa mala domurǝm</para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 12:16" />Lang Isǝrayila kat sǝni ama murǝm ginǝna ok cau malea ka, pǝlǝa à nyesǝî murǝm cau ama:</para>
  <para style="q1" vid="1KI 12:16">&lt;&lt;Mana nda kāmbe ma'sǝm aɓa Dauda?</para>
  <para style="q1" vid="1KI 12:16">Sǝm panǝ kǝ liɓala aɓa muna mala Jeshi ɗàng.</para>
  <para style="q1" vid="1KI 12:16">Wun amǝ Isǝrayila, koyan ngga ɓǝ̀ nyar aɓa gumli male.</para>
  <para style="q1" vid="1KI 12:16">We Dauda ka, ɗenyinǝ ɓala mò.&gt;&gt;</para>
  <para style="p" vid="1KI 12:16">Nǝ mǝno ka koya ɓwa Isǝrayila ka nyar a ɓala male. <verse eid="1KI 12:16" /><verse number="17" style="v" sid="1KI 12:17" />Sǝama Rehobuam yálmúr amǝ Isǝrayila mǝnana à ndanǝdo arǝ anggea-là mala Yahuda ka. <verse eid="1KI 12:17" /><verse number="18" style="v" sid="1KI 12:18" />Pǝlǝa Murǝm Rehobuam túr Adoram mǝnana nda mǝ'sàrǝ̀ban amúr aɓwana mǝnana à tsǝia a túró-púp ka, sǝ Isǝrayila kat ɓukki nǝ atali à wal-luí. Lang cê yi bik ban Murǝm Rehobuam ngga, yàl aɓa waru-pǝr male tsuk-tsuk sǝ ɓangŋa akaurǝa o a Urǝshalima. <verse eid="1KI 12:18" /><verse number="19" style="v" sid="1KI 12:19" />Anggo sǝ Isǝrayila dum nǝ mgbicau arǝ ɓala mala Dauda ba yalung.<verse eid="1KI 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 12:20" />Sǝ lang Isǝrayila kat ongŋǝna ama Jerobuam nyarǝna ka, à túrban à kya tunǝi ɓǝ̀ yiu a ban rambǝa mala ɓwabundǝa kat, sǝ à tsǝì duk murǝm amúr Isǝrayila kat. Kǝɓwa pà kàm mǝnana kpata ɓala mala Dauda ka ɗang, shekǝ tàu mala Yahuda nǝmurǝi.<verse eid="1KI 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 12:21" />Lang Rehobuam yina a Urǝshalima ka, ram ɓala mala Yahuda kat, andǝ tàu mala Benjami, aburana á-gbǝman-mwashat nǝ á-lumi-tongno-nong-tàrú (180,000), amǝ'lwa mǝnana à tarkia ka, ace kánǝ munǝo arǝ ɓala mala Isǝrayila, ace mǝnana ɓǝà nyesǝ domurǝm ɗǝm aban Rehobuam muna-ɓwabura mala Solomon. <verse eid="1KI 12:21" /><verse number="22" style="v" sid="1KI 12:22" />Sǝama cau mala Ɓakuli yiu aban Shemaya ɓwa mala Ɓakuli ama: <verse eid="1KI 12:22" /><verse number="23" style="v" sid="1KI 12:23" />&lt;&lt;Banggi Rehobuam muna-ɓwabura mala Solomon, murǝm mala Yahuda, andǝ ɓala mala Yahuda andǝ Benjami kat, andǝ acili aɓwana ama, <verse eid="1KI 12:23" /><verse number="24" style="v" sid="1KI 12:24" />&lt;Mǝnia ka nda cau mǝnana Yahweh bang ngga: Pà wu nǝ kánǝ lwa arǝ amǝ'eam wun, yia amǝ Isǝrayila ɗàng. Koyan ngga ɓǝ̀ nyar a ɓala male, acemǝnana mǝnia ka pě mema.&gt; &gt;&gt;</para>
  <para style="p" vid="1KI 12:24">Nda à kwakikiria arǝ cau mala Yahweh, sǝ koyan ngga nyare a ɓala male ɗǝm, kǝla mǝnana cau mala Yahweh bang ngga.<verse eid="1KI 12:24" /></para>
  <para style="s">Jerobuam ɓak aɓǝ̀nzál mala bolo-njengǝlan</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 12:25" />Pǝlǝa Jerobuam ɓak nggea-là Shekem a nzali múr ankono mala Ifǝrem sǝ duk kam. Sǝ purî banì ka, kya ɓak Penǝwel. <verse eid="1KI 12:25" /><verse number="26" style="v" sid="1KI 12:26" />Sǝ Jerobuam bang a ɓabumi ama, &lt;&lt;Ɓǝ̀ ǝn tsǝkiram raka domurǝm ngga nǝ̀ nyar a bu ɓala mala Dauda. <verse eid="1KI 12:26" /><verse number="27" style="v" sid="1KI 12:27" />Ɓǝ̀ aɓwana man o ace pà gìr'nkila aɓa ɓala mala Yahweh a Urǝshalima ka, ɓabum aɓwana man nǝ̀ gandǝ nyar ɗǝm aban ɓwamǝgule malea, aban Rehobuam murǝm Yahuda, sǝ à nǝ̀ wal-luem, à nǝ̀ nyar aban Rehobuam murǝm Yahuda.&gt;&gt; <verse eid="1KI 12:27" /><verse number="28" style="v" sid="1KI 12:28" />Anzǝm tàɓala andǝ amǝ'pa-kwarkiru male ka, murǝm ɓak aɓǝ̀nzál mala muna-ndá ɓari nǝ bolo-njengǝlan. Sǝ banggi aɓwana ama, &lt;&lt;Wu sauna kǝ̀rkǝ́r arǝ nyarke ma'wun arǝ ká a Urǝshalima ace peri. Wu sǝni, wun amǝ Isǝrayila, aɓakuli ma'wun mǝnana à pusǝ wun, wu purî ɓá nzali Masar ka, à ndya ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 32:4">Pur 32:4</ref>,<ref loc="EXO 32:8">8</ref></char>.</note> <verse eid="1KI 12:28" /><verse number="29" style="v" sid="1KI 12:29" />Pǝlǝa tsǝk mwashat a Betel, sǝ ɓè ka tsǝì a Dan. <verse eid="1KI 12:29" /><verse number="30" style="v" sid="1KI 12:30" />Sǝ mǝnia yì gìr ka duk cauɓikea, acemǝnana aɓwana ateà kǝ o ace peri aɓadǝm ɓǝ̀nzál mala muna-ndá mǝnana a Betel ka, sǝ aɓea ka à kǝ o ɗār a Dan ace peri aɓadǝm ɓe ɓǝ̀nzál mala muna-ndá mǝno.<verse eid="1KI 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 12:31" />Jerobuam ɗǝm ngga ɓakki amgbangban-peri atà ankúl, sǝ twal apǝris aɓalǝ aɓwana kat, aɓwana mǝnana à pùr atau mala Lawi raka. <verse eid="1KI 12:31" /><verse number="32" style="v" sid="1KI 12:32" />Sǝ tita lamsan a lum-nong-tongnoia pwari mala tongno-nong-tàruià zongŋo, kǝla lamsan mǝnana à kǝ pakkiɗire male a Yahuda ka, sǝ pāki agir'nkila amur gyangŋan. Mǝnia yì gìr ka pè a Betel; pà gìr'nkila aban aɓǝ̀nzál mala amuna-ndá mǝnana peǎ ka. Sǝ yì ɗǝm ngga, tsǝk apǝris arǝ amgbangban-peri atà ankúl mǝnana ɓakkia a Betel ka. <verse eid="1KI 12:32" /><verse number="33" style="v" sid="1KI 12:33" />Aɓa tongno-nong-tàruià zongŋo, a lum-nong-tongnoia pwari, pwari mǝnana yì nǝmurǝi na twal a ɓabumi ka, Jerobuam wari aban gyangŋan mǝnana ɓè a Betel ka. Sǝ ham lamsan ace amǝ Isǝrayila, pǝlǝa gbàshìban gyangŋan ace pa ɓoro mala pisǝ mùrú-mǝrǝmɓoarne.<verse eid="1KI 12:33" /></para>
  <chapter eid="1KI 12" />
  <chapter number="13" style="c" sid="1KI 13" />
  <para style="s">Ɓè mǝɓangnǝa mala Ɓakuli soa Jerobuam</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 13:1" />Zuku ka, ɓè ɓwa mala Ɓakuli mǝnana Yahweh tasǝì ka, puro a bu-nzali Yahuda sǝ yiu a Betel. Lang bingŋǝna ka, yi kum Jerobuam na aban came a nkanggari gyangŋan aɓa gilǝrǝu nǝ̀ pà ɓoro mala loasǝ yele. <verse eid="1KI 13:1" /><verse number="2" style="v" sid="1KI 13:2" />Pǝlǝa ɓwa mala Ɓakuli loasǝ gì kpǝm bangcau aɓa rǝcandǝa mala cau mǝnana Yahweh pe wi amur gyangŋan man ngga ama, &lt;&lt;We gyangŋan, gyangŋan! Mǝnia ka nda cau mǝnana Yahweh bang ngga, &lt;À nǝ̀ ɓǝl muna-ɓwabura a ɓala mala Dauda, lùllǝì ama Josiya. Apǝris mala amgbangban-peri atà ankúl mǝnana à kǝ yiu kani ace loasǝ yele amuro ka, muna-ɓwabura man nǝ̀ yia pwangi-myalia kǝla gìr'nkila amuro, sǝ à nǝ̀ pisǝ amú ɓwapǝndǝa amuro.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">Ɓal lùmsǝo mala hama mǝnia ka aɓa: </char><char style="xt"><ref loc="2KI 23:15-20">2Amur 23:15-20</ref></char>.</note> <verse eid="1KI 13:2" /><verse number="3" style="v" sid="1KI 13:3" />Pǝlǝa na ɗǝm a mǝno yì pwari ka ama, &lt;&lt;Mǝnia ka nda gìr mǝnana nǝ̀ lǝmdǝa ama Yahweh nana cau mǝnia ka: &lt;Sǝni, gyangŋan mǝnia nǝ̀ ar gbas, sǝ tú mǝnana amurí ka nǝ̀ solǝo.&gt; &gt;&gt;<verse eid="1KI 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 13:4" />Lang Murǝm Jerobuam ok cau mala ɓwa mala Ɓakuli, mǝnana ne amur gyangŋan a Betel ka, Jerobuam lǝmdǝ muna-bui arǝì nǝban gyangŋan, sǝ banggi aguro male ama, &lt;&lt;Wu gbami ɓwabura mǝna ka!&gt;&gt; Sǝ buì mǝnana lǝmdǝi arǝ ɓwa mala Ɓakuli ka shì kwangong, gandǝ nyesǝi ɗǝm a rǝì ɗàng. <verse eid="1KI 13:4" /><verse number="5" style="v" sid="1KI 13:5" />Gyangŋan gau gbas, sǝ tú mǝnana amurí ka sukki a nzali, kǝla mǝnana cau mala ɓwa mala Ɓakuli lǝmdǝ ama Yahweh bangŋǝ́nà ama gìrnî nǝ̀ kumban ngga.<verse eid="1KI 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 13:6" />Pǝlǝa ɓuaki arǝ ɓwa mala Ɓakuli ama, &lt;&lt;Ida, pakhiwi acem, zǝmbî Yahweh Ɓakuli mô ɓǝ̀ sǝn'mǝsǝswatǝr mem, ɓǝ̀ nyesǝâm buam abanì.&gt;&gt; Sǝ ɓwa mala Ɓakuli pakhiwi aban Yahweh, sǝ murǝm ngga à nyesǝî buì a banì sǝ nyare pa kǝla mana ɗiɗyal ka.<verse eid="1KI 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 13:7" />Pǝlǝa ne ɓwa mala Ɓakuli ama, &lt;&lt;Yiu atàm a ɓala wu li girlina, sǝ ɓǝn pô tangnakusǝu.&gt;&gt; <verse eid="1KI 13:7" /><verse number="8" style="v" sid="1KI 13:8" />Sǝ ɓwa mala Ɓakuli ka ear ama, &lt;&lt;Ko ɓǝ̀ awu nǝ pàm gauwa-tsùrú mala ɓala mò ka, pà mǝ nǝ ká atò ɗàng, sǝ pà mǝ nǝ li girlina ko mǝ nǝ nu kǝgir kani ɗang, <verse eid="1KI 13:8" /><verse number="9" style="v" sid="1KI 13:9" />acemǝnana Yahweh tsǝkam nzongcau ama, mǝ nggá li kǝgir ko mǝ nu kǝgir ɗàng, sǝ mǝ nggá nyar nǝ njargula mǝnana ǝn wari nǝi ka ɗàng.&gt;&gt; <verse eid="1KI 13:9" /><verse number="10" style="v" sid="1KI 13:10" />Nda nyare o nǝ ɓè njargula ka, kpata njargula mǝnana yiu nǝi a Betel ka ɗàng.<verse eid="1KI 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 13:11" />A bàkú mǝno ka ɓè jamgula mǝɓangnǝa na kam nǝdo a Betel. Amuna-burana male yiu abani sǝ à banggi wi cau mala gìr mǝnana kat ɓwa mala Ɓakuli pak a pwari mǝno ka, andǝ cau mǝnana banggi murǝm ngga. <verse eid="1KI 13:11" /><verse number="12" style="v" sid="1KI 13:12" />Tárrià ɗia ama, &lt;&lt;Nǝ ya njargula sǝ kàra?&gt;&gt; Sǝ amuna-burana male lǝmdǝi wi njar mǝnana ɓwa mala Ɓakuli mǝnana pùr a Yahuda ka, um nǝi ka. <verse eid="1KI 13:12" /><verse number="13" style="v" sid="1KI 13:13" />Sǝ banggi amuna-burana male ama, &lt;&lt;Wu tsǝkam buno-nzǝm a nzǝm mǝdambǝriso.&gt;&gt; Pǝlǝa à tsǝki wi buno-nzǝm a nzǝm mǝdambǝriso, sǝ eau amurí. <verse eid="1KI 13:13" /><verse number="14" style="v" sid="1KI 13:14" />Sǝ o atà ɓwa mala Ɓakuli, kya kumi aban do a tǝr nggun mǝgule. Sǝ ɗì ama, &lt;&lt;A nda ɓwa mala Ɓakuli mǝnana pùr a Yahuda ka le?&gt;&gt; Sǝ Ɓwa mala Ɓakuli eari wi ama, &lt;&lt;Mǝ nda.&gt;&gt; <verse eid="1KI 13:14" /><verse number="15" style="v" sid="1KI 13:15" />Sǝ jamgula mǝɓangnǝa banggi wi ama, &lt;&lt;Yiu atàm a ɓala, wu li girlina.&gt;&gt; <verse eid="1KI 13:15" /><verse number="16" style="v" sid="1KI 13:16" />Ɓwa mala Ɓakuli banggi wi ama, &lt;&lt;Pà mǝ nǝ gandǝ nyar atò, ko mǝ nǝ kútí a ɓala mò ɗàng. Sǝ pà mǝ nǝ li girlina ko mǝ nǝ nu kǝgir atò a ban mǝnia ka ɗàng, <verse eid="1KI 13:16" /><verse number="17" style="v" sid="1KI 13:17" />acemǝnana cau mala Yahweh bangŋǝ́nàm ama: &lt;A pà wunǝ lì kǝgir ko awu nǝ nu kǝgir a ban mǝno ka ɗàng, sǝ a pà wunǝ nyar nǝ njargula mǝnana a yiu nǝi ka ɗàng.&gt; &gt;&gt;<verse eid="1KI 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 13:18" />Sǝ jamgula mǝɓangnǝa banggi wi ama, &lt;&lt;Mim gbal ka, mǝ nda mǝɓangnǝa kǝla we. Yahweh tasǝ cau male nǝ kún mǝturonjar male ɓǝ̀ banggam ama mǝ yinǝ we a ɓala mem, wu li girlina sǝ wu nu gìr atàm.&gt;&gt; Sǝama nyir na ne wi ka. <verse eid="1KI 13:18" /><verse number="19" style="v" sid="1KI 13:19" />Nda ɓwa mala Ɓakuli nyar andǝi, sǝ à kya li girlina, à nu gìr a ɓala male ka. <verse eid="1KI 13:19" /><verse number="20" style="v" sid="1KI 13:20" />Lang à nda piu aban do a ban-li ka, cau mala Yahweh yiu aban mǝnia yì mǝɓangnǝa mǝnana nyesǝ ɓwa mala Ɓakuli ɓǝ̀ nyar ka; <verse eid="1KI 13:20" /><verse number="21" style="v" sid="1KI 13:21" />sǝ loasǝ gì bàng-bàng ne ɓwa mala Ɓakuli mǝnana pùr a Yahuda ka ama, &lt;&lt;Mǝnia ka nda cau mala Yahweh: &lt;A mgbinacau arǝ cau mala Yahweh Ɓakuli mô, sǝ a kpata nzongcau male ɗàng; <verse eid="1KI 13:21" /><verse number="22" style="v" sid="1KI 13:22" />a nyarna, a lina girlina sǝ a nuna gìr a ban mǝnana ǝn pǝro arǝì ka; acemani ka, à pà nǝ̀ tsǝk-luio a ɓembe-ɓa-tali mala akeo ɗàng.&gt; &gt;&gt;<verse eid="1KI 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 13:23" />Anzǝm mǝnana ɓwa mala Ɓakuli lina sǝ nuna gìr ka, mǝɓangnǝa mǝnana nyesǝi yinǝi ka tsǝki wi buno-nzǝm amur mǝdambǝriso. <verse eid="1KI 13:23" /><verse number="24" style="v" sid="1KI 13:24" />Sǝ lang nda njar aban o ka, ɓè im kumi sǝ wal-luí, sǝ nying luí aban nongŋo amur njargula, sǝ mǝdambǝriso andǝ im kǝm ngga à nda aban came a nkanggari. <verse eid="1KI 13:24" /><verse number="25" style="v" sid="1KI 13:25" />Aɓea amǝgya-kutio sǝn luí aban nongŋo amur njargula andǝ im aban came a nkanggari, sǝ à warinǝ bǝsacê a là mǝnana yì jamgula mǝɓangnǝa duk kam ngga. <verse eid="1KI 13:25" /><verse number="26" style="v" sid="1KI 13:26" />Lang mǝɓangnǝa mǝnana kya nyesǝi a njar ok cê ka na ama, &lt;&lt;Ɓwa mala Ɓakuli mǝnana mgbicau arǝ cau mala Yahweh ka nda. Yahweh tasǝni a ɓabu im, sǝ im sangini, walna-luí kǝla mǝnana cau mala Yahweh bang ngga.&gt;&gt; <verse eid="1KI 13:26" /><verse number="27" style="v" sid="1KI 13:27" />Sǝ banggi amuna-burana male ama ɓǝà tsǝki wi buno-nzǝm amur mǝdambǝriso, sǝ à pàk anggo. <verse eid="1KI 13:27" /><verse number="28" style="v" sid="1KI 13:28" />Pǝlǝa lo wario sǝ kya kum luí aban nongŋo amur njargula, andǝ mǝdambǝriso andǝ im aban came a nkanggari; im ngga shè ɗàng sǝ je mǝdambǝriso gbal ɗàng. <verse eid="1KI 13:28" /><verse number="29" style="v" sid="1KI 13:29" />Nda jamgula mǝɓangnǝa imsǝ lú ɓwa mala Ɓakuli sǝ nongsǝi a nzǝm mǝdambǝrisonî, sǝ nyesǝi a là male yì jamgula mǝɓangnǝa, ace ɓuě, sǝ ace tsǝk-luí. <verse eid="1KI 13:29" /><verse number="30" style="v" sid="1KI 13:30" />Nongsǝ luí a ɓembe-ɓa-tali male sǝ à ɓuè ama, &lt;&lt;Oi, mǝ'eambam!&gt;&gt; <verse eid="1KI 13:30" /><verse number="31" style="v" sid="1KI 13:31" />Anzǝm mǝnana tsǝ̀ngŋǝ̀nà luí ka, banggi amuna-burana male ama, &lt;&lt;Lang ǝn wuna ka, wu tsǝk luem a ɓembe-ɓa-tali mǝnana à tsǝk ɓwa mala Ɓakuli kam ngga; wu nongsǝ amuem a nkanggari amale. <verse eid="1KI 13:31" /><verse number="32" style="v" sid="1KI 13:32" />Cau mǝnana Yahweh banggi wi ɓǝ̀ yi hama arǝ gyangŋan a Betel, sǝ arǝ andaka-ankúl mala amgbangban-peri mǝnana kat arǝ anggea-là mala amǝ Samariya ka, ɓafo nǝ̀ yia lùmsǝo.&gt;&gt;<verse eid="1KI 13:32" /></para>
  <para style="s">Cauɓikea mala Jerobuam mana yinǝ nggurlú male ka</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 13:33" />Anzǝm mǝnia yì gìr mǝnana kumban ngga, Jerobuam pǝlǝ nzǝmi arǝ anjar mǝɓike male ɗàng; yì ka lidǝmba nǝ twal aɓwana aɓalǝ aɓwe kat, sǝ tsǝia ɓǝà duk apǝris mala amgbangban-peri atà ankúl. Ɓwa mǝnana kat ear ka, kùri wi pǝris mala mgbangban-peri. <verse eid="1KI 13:33" /><verse number="34" style="v" sid="1KI 13:34" />Nǝ gir mǝnia pè ka, nunbi ɓala male bafe mala cauɓikea mǝnana warinǝi a kpa andǝ kiɗiki male kàng a ɓanza ka.<verse eid="1KI 13:34" /></para>
  <chapter eid="1KI 13" />
  <chapter number="14" style="c" sid="1KI 14" />
  <para style="s">Lú mala muna-ɓwabura mala Jerobuam</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 14:1" />A bàkú mǝno ka, Abija muna-ɓwabura mala Jerobuam nongkwánó.<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:12">1Amur 14:12</ref>,<ref loc="1KI 14:17-18">17-18</ref></char>.</note> <verse eid="1KI 14:1" /><verse number="2" style="v" sid="1KI 14:2" />Pǝlǝa Jerobuam ne māmí ama, &lt;&lt;Ida, lo sǝ wu ɓosǝki rǝo,<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 28:8">1Sam 28:8</ref>; <ref loc="2SA 14:2-3">2Sam 14:2-3</ref></char>.</note> ace mǝnana ɓǝà kǝa sǝlǝa ama a nda mālá Jerobuam raka, sǝ wu o a Shilo. Ahija mǝɓangnǝa mǝnana bangcau amuram ama mǝ nǝ duk murǝm amur aɓwana mǝnia ka, ndakam a banì. <verse eid="1KI 14:2" /><verse number="3" style="v" sid="1KI 14:3" />Twal agbatali bǝredi lum, aɓea agbatali kyak, sǝ mur'nyi aɓa dù a buo, sǝ wu kya abaní. Yì ka nǝ̀ banggo gìr mǝnana nǝ̀ kum muna ka.&gt;&gt;<verse eid="1KI 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 14:4" />Mālá Jerobuam pǝlǝa pàk anggo. Lo wari a Shilo, a ɓala mala Ahija. Adyan ngga Ahija ka, kǝ sǝnban ɗang, acemǝnana gulǝna, sǝ amǝsǝi wuna.<note caller="+" style="f"><char style="fr" closed="false">14:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 3:2">1Sam 3:2</ref>; <ref loc="1SA 4:15">4:15</ref></char>.</note> <verse eid="1KI 14:4" /><verse number="5" style="v" sid="1KI 14:5" />Pǝlǝa Yahweh banggi Ahija ama, &lt;&lt;Sǝni, mālá Jerobuam ndya kǝ yiu ace ɗìbancau a bano amur muni ka, acemǝnana muna ka mǝrǝkwana na. Banggi wi cau mǝnana mǝ nǝ po wu banggi wi ka.&gt;&gt;</para>
  <para style="p" vid="1KI 14:5">Lang ɓwame warina ka, ɓosǝki rǝì kǝla ɓè ɓwama na ɗàng. <verse eid="1KI 14:5" /><verse number="6" style="v" sid="1KI 14:6" />Sǝama lang Ahija nǝ̀ ok kusǝi aban kútí a kunkurǝm ngga, bang ama, &lt;&lt;Kutio yiu, mālá Jerobuam. Palang sǝ a ɓosǝki rǝo kǝla ɓeɓwa ɗàng? Mim ngga, à tasǝam a bano nǝ bǝsacau mǝnana pà nǝ̀ ɓoarô ǒ raka. <verse eid="1KI 14:6" /><verse number="7" style="v" sid="1KI 14:7" />Kyane, kya ne Jerobuam ama, mǝnia ka nda cau mǝnana Yahweh, Ɓakuli mala Isǝrayila kǝ bang ngga: &lt;Ən loasǝo aɓalǝ aɓwana, sǝ ǝn tsǝo a duk múrû amur aɓwana mem Isǝrayila. <verse eid="1KI 14:7" /><verse number="8" style="v" sid="1KI 14:8" />Ən san domurǝm arǝ ɓala mala Dauda sǝ ǝn pô.<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 11:28-31">1Amur 11:28-31</ref>; <ref loc="1KI 16:2">16:2</ref></char>.</note> Sǝ we ka, a pa kǝla guro mem Dauda ɗàng, mǝnana bwal anzongcau mem, sǝ kpatam nǝ ɓabumi kat ka. Kǝgìr mǝnana nda pepè a mǝsǝàm ngga nda kǝ pak ka. <verse eid="1KI 14:8" /><verse number="9" style="v" sid="1KI 14:9" />Ɓealɓikea mô mǝnana a pê ka kutini mala aɓwana mǝnana à ako-dǝmba [duk murǝm] ngga.<note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="1KI 16:25">1Amur 16:25</ref>,<ref loc="1KI 16:30">30</ref></char></note> A pangŋǝni ɓamuro aɓea aɓakuli, <note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="EXO 34:17">Pur 34:17</ref> </char>.</note>aɓǝ̀nzál bolo; a lulbumam, sǝ a túrnǎm nǝ nzǝmó.<note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NEH 9:26">Nehe 9:26</ref>; <ref loc="PSA 50:17">Ang 50:17</ref></char>.</note> <verse eid="1KI 14:9" /><verse number="10" style="v" sid="1KI 14:10" />Ace mani ka, sǝni, mǝ ndo mǝ nǝ yinǝ gir'murmwana amur ɓala mala Jerobuam. Mǝ nǝ tsǝa koya muna-ɓwabura mǝnana à ɓǝlî Jerobuam a Isǝrayila ka nǝ̀ wǔ, ko guro ko mǝnana nda atàrǝì ka. Mǝ nǝ pisǝ ɓala mala Jerobuam kǝla mǝnana ɓwa kǝ pisǝ ciunda sheɓǝ̀ pina kat-kat ka. <verse eid="1KI 14:10" /><verse number="11" style="v" sid="1KI 14:11" />Ɓwa mǝnana kat mala Jerobuam na, sǝ wǔ a nggea-là ka, anvwa nǝ̀ she; sǝ ɓwa mǝnana kat wǔ a ɓawanban ngga, anyal mǝnana à nda a bumkuli ka à nǝ̀ lì. Mim Yahweh ka ǝn nani.&gt;<verse eid="1KI 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 14:12" />&lt;&lt;Adyan ngga lo, o a ɓala mò. Lang kusǝo nǝ̀ kùtí aɓa nggea-là ka, munê nǝ̀ wú.<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:17">1Amur 14:17</ref></char>.</note> <verse eid="1KI 14:12" /><verse number="13" style="v" sid="1KI 14:13" />Sǝ Isǝrayila kat ka nǝ̀ ɓua aceì, sǝ à nǝ̀ tsǝkbani. Kǝ yì nǝmurǝì aɓalǝ amuna mala Jerobuam nda mǝnana à nǝ̀ tsǝì a ɓembe ka, acemǝnana kǝ yì nǝmurǝì atà amǝɓala mala Jerobuam nda mǝnana à kum ɓekǝ gìr aɓalǝi mǝnana mǝɓoarne na aban Yahweh Ɓakuli mala Isǝrayila ka.<verse eid="1KI 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1KI 14:14" />&lt;&lt;Ɗǝm ngga, Yahweh nǝ̀ loasǝì ɓamúrì ɓè murǝm amur Isǝrayila, mǝnana nǝ̀ nggá yinǝ málá mala ɓala mala Jerobuam ngga. Sǝ mǝnia ka nǝ̀ kumban yalung, yale ado. <verse eid="1KI 14:14" /><verse number="15" style="v" sid="1KI 14:15" />Yahweh nǝ̀ wal Isǝrayila gandǝa nǝ̀ ɓǝl-rak'rak kǝla mǝnana nzuno kǝ dǝurǝkio a mùrɓangŋa ka; Yahweh nǝ̀ u Isǝrayila būt aɓa nzali mǝɓoarne mǝnia pè akeâ ka,<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 29:28">Nggur 29:28</ref></char>.</note> sǝ nǝ̀ mesǝia ɓǝà kya purrì Nggeasala Yiufǝretis, acemǝnana à lulbum Yahweh nǝ atondong mala Ashera mǝnana à peǎ ace peri abania ka.<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 34:14-15">Pur 34:14-15</ref>; <ref loc="DEU 12:3-4">Nggur 12:3-4</ref></char>.</note> <verse eid="1KI 14:15" /><verse number="16" style="v" sid="1KI 14:16" />Yì ka nǝ̀ vwakibuì arǝ Isǝrayila atàcau mala acauɓikea mala Jerobuam mǝnana Jerobuam peǎ, sǝ tsǝk Isǝrayila pàk acauɓikê atè ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="1KI 12:28-33">1Amur 12:28-33</ref>; <ref loc="1KI 13:34">13:34</ref>; <ref loc="1KI 15:30">15:30</ref></char></note><verse eid="1KI 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 14:17" />Pǝlǝa mālá Jerobuam lo o, sǝ yiu a Tǝrza. Sǝ lang bik bankutio a ɓala ka, munê wǔ. <verse eid="1KI 14:17" /><verse number="18" style="v" sid="1KI 14:18" />Sǝ Isǝrayila kat tsǝì a ɓembe, à ɓuè kǝla mǝnana cau mala Yahweh bangŋi nǝ kún guro male, yì Ahija mǝɓangnǝa ka.<verse eid="1KI 14:18" /></para>
  <para style="s">Lú mala Jerobuam</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 14:19" />Adyan ngga, acili atúró mala Jerobuam, a'lwa mǝnana lwa,<note caller="+" style="f"><char style="fr" closed="false">14:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:30">1Amur 14:30</ref>; <ref loc="2CH 13:2-20">2Acau 13:2-20</ref> </char>.</note> andǝ yálmúrû male ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="1KI 14:19" /><verse number="20" style="v" sid="1KI 14:20" />Jerobuam yálmúr aɓwana apǝlǝa lumi-ɓari (20), pǝlǝa usǝlǝ atà akê. Sǝ muna-ɓwabura male Nadap duk murǝm a bancame male.<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:25-26">1Amur 15:25-26</ref></char>.</note><verse eid="1KI 14:20" /></para>
  <para style="s">Yálmúrû mala Rehobuam a Yahuda</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 14:21" />Adyan ngga, Rehobuam muna-ɓwabura mala Solomon ngga nda murǝm a Yahuda.<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft">Ɓalli gbal aɓa: 1Amur 12:1-24</char>.</note> Ndanǝ apǝlǝa lumi-ine-nong-mwashat (41) a ɓanza lang duk murǝm ngga, sǝ yálmúr aɓwana apǝlǝa lum-bwandǝ-tongno-nong-ɓari (17) a Urǝshalima, yì nggea-là mǝnana Yahweh twali aɓalǝ atau mala Isǝrayila kat ama nǝ̀ tsǝk lullǝi kam ngga. Lullǝ nggea Rehobuam nda Naama, ɓwa'Amon.<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 12:13">2Acau 12:13</ref></char>.</note><verse eid="1KI 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 14:22" />Yahuda pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, tsǝk Yahweh a mɓali kútì mǝnana akeâ tsǝì pàk ka nǝ acauɓikea malea mǝnana à pàkki wi ka. <verse eid="1KI 14:22" /><verse number="23" style="v" sid="1KI 14:23" />Yià ɗǝm ngga à pàkkî ɓamuria andaka-ankúl sǝ à tamsǝki akúnamúrú mala peri,<note caller="+" style="f"><char style="fr" closed="false">14:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:24">Pur 23:24</ref>; <ref loc="DEU 16:21-22">Nggur 16:21-22</ref></char>.</note> andǝ atondong mala Ashera amur koya mgbang-ban andǝ tǝ́r koya nggun pwala. <verse eid="1KI 14:23" /><verse number="24" style="v" sid="1KI 14:24" />Ɗǝm ngga, aburana na kam aɓa nzalinì mǝnana à mak ɓamuria aɓa gyatarǝu mala ɓwabura-nǝ-nongnǝ-ɓwabura ace boalo ka arǝ andaka-ankúl mǝnia ka.<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 23:17">Nggur 23:17</ref></char>.</note> Amǝ Isǝrayila kùtí aɓa pàkki amǝnia yì agir ɓeami kat mala aɓwapǝndǝa mǝnana Yahweh pǝria a ɓadǝmbia ka.<verse eid="1KI 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 14:25" />A tongnia pǝlǝa mala yálmúrû mala Murǝm Rehobuam ngga, Shishak murǝm Masar<note caller="+" style="f"><char style="fr" closed="false">14:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 11:40">1Amur 11:40</ref></char>.</note> yiu nǝ̀ lwa arǝ Urǝshalima. <verse eid="1KI 14:25" /><verse number="26" style="v" sid="1KI 14:26" />Yi pwan agǝna-ramba mǝnana a ɓala mala Yahweh, andǝ agǝna-ramba mǝnana a palta mala murǝm ngga, umnǝia. Pwan koman kat. Pwan atongŋo bolo-njengǝlan mǝnana Solomon peǎ ka.<note caller="+" style="f"><char style="fr" closed="false">14:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 10:16-17">1Amur 10:16-17</ref></char>.</note> <verse eid="1KI 14:26" /><verse number="27" style="v" sid="1KI 14:27" />Nda Murǝm Rehobuam pàk atongŋo bolo-bángŋá a kúnì amǝno, sǝ tsǝia a ɓabu amǝ'sàrǝ̀ban mala amǝ'yalban mǝnana à kǝ yál bankutio a palta mala murǝm ngga. <verse eid="1KI 14:27" /><verse number="28" style="v" sid="1KI 14:28" />Sǝ koya pwari murǝm kútí a ɓala mala Yahweh ka, amǝ'yalban nǝ̀ twal antongŋo mǝnia ka a buia, sǝ nǝnzǝ́mò ka à nǝ̀ nyesǝia a kurǝm mala amǝ'yalban.<verse eid="1KI 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 14:29" />Adyan ngga, acili agir mǝnana à kumban aɓa yálban mala Rehobuam, andǝ atúró mǝnana kat peǎ<note caller="+" style="f"><char style="fr" closed="false">14:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 12:15-16">2Acau 12:15-16</ref></char>.</note> ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="1KI 14:29" /><verse number="30" style="v" sid="1KI 14:30" />Sǝ lwa camarǝ lo anre Rehobuam andǝ Jerobuam bà. <verse eid="1KI 14:30" /><verse number="31" style="v" sid="1KI 14:31" />Rehobuam yi usǝlǝ atà akê, sǝ à tsǝk-luí a ɓembe-ɓa-tali atà akê a nggea-là mala Dauda. Lullǝ ngge nda Naama, ɓwa'Amon. Sǝ muna-ɓwabura male Abijam<note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="1KI 15:1-8">1Amur 15:1-8</ref>; <ref loc="2CH 11:20">2Acau 11:20</ref>; <ref loc="2CH 13:1-14">13:1-14</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="ft" closed="false">Yì ɗǝm ngga à tunǝi ama </char><char style="fqa" closed="false">Abija </char></note> duk murǝm a bancame male.<verse eid="1KI 14:31" /></para>
  <chapter eid="1KI 14" />
  <chapter number="15" style="c" sid="1KI 15" />
  <para style="s">Abijam duk murǝm a Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 15:1" />A lum-bwamdǝ-tongno-nong-tàruia (18) pǝlǝa mala yálmúrû mala Jerobuam muna-ɓwabura mala Nebat ka, Abijam duk murǝm amur Yahuda. <verse eid="1KI 15:1" /><verse number="2" style="v" sid="1KI 15:2" />Yálmúr aɓwana a Urǝshalima apǝlǝa tàrú; lullǝ ngge nda Ma'aka,<note caller="+" style="f"><char style="fr" closed="false">15:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:10">1Amur 15:10</ref>,<ref loc="1KI 15:13">13</ref>; <ref loc="2CH 13:2">2Acau 13:2</ref></char>.</note> ɓoarnsarile Abishalom. <verse eid="1KI 15:2" /><verse number="3" style="v" sid="1KI 15:3" />Yì ka kpata pàkkiagir cauɓikea mǝnana tárrí akdǝmba peǎ ka, sǝ pà ɓabumi kat nǝ mǝsǝcau aɓadǝm Yahweh Ɓakuli male, kǝla mǝnana ɓabum kè Dauda pàk ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 9:4">1Amur 9:4</ref>; <ref loc="1KI 11:4">11:4</ref></char>.</note> <verse eid="1KI 15:3" /><verse number="4" style="v" sid="1KI 15:4" />Sǝ atàcau mala Dauda ka, Yahweh Ɓakuli male pè Abijam muna-ɓwabura ɓǝ̀ lo a kusǝi, kǝla pitǝla [ɓǝ̀ kǝ tá] a Urǝshalima, sǝ ɓǝ̀ tamsǝkusǝ Urǝshalima kàngkàng. <verse eid="1KI 15:4" /><verse number="5" style="v" sid="1KI 15:5" />Mǝnia ka nda acemǝnana Dauda pàk gìr mǝnana nda pepè a mǝsǝ Yahweh ka, sǝ burice komǝye atà anzongcau male ɗàng, aɓa do-yilǝmu male kat, she aɓa cau mala Yuriya <note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 11:3">2Sam 11:3</ref>,<ref loc="2SA 11:15-17">15-17</ref>; <ref loc="2SA 12:9-10">12:9-10</ref></char>.</note> ɓwa'Hitti. <verse eid="1KI 15:5" /><verse number="6" style="v" sid="1KI 15:6" />Lwa mǝnana tinate anre Rehobuam<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="fq" closed="false">Rehobuam </char><char style="ft" closed="false">Aɓea amalǝmce Ibǝru mǝnana à gilǝia nǝ bu ka ama, </char><char style="fq" closed="false">Abijam</char></note> andǝ Jerobuam ngga lidǝmba aɓa do-yilǝmu mala Abijam kat. <verse eid="1KI 15:6" /><verse number="7" style="v" sid="1KI 15:7" />Acili agir mǝnana à kumban, andǝ agir mǝnana kat à peǎ aɓa yálmúrû mala Abijam ngga, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char><note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:29">1Amur 14:29</ref></char>.</note> Sǝ lwa ka nda kam anre Abijam andǝ Jerobuam.<verse eid="1KI 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 15:8" />Sǝ Abijam yi usǝlǝo atà akê, pǝlǝa à tsǝk-luí aɓa nggea-là mala Dauda. Sǝ muna-ɓwabura male Asa duk murǝm a bancame male.<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:31">1Amur 14:31</ref>; <ref loc="2CH 14">2Acau 14</ref></char>.</note><verse eid="1KI 15:8" /></para>
  <para style="s">Yálban mala Asa a Yahuda</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 15:9" />A lum-nong-ɓaria pǝlǝa mala yálmúrû mala Jerobuam murǝm Isǝrayila ka, Asa duk murǝm amur Yahuda, <verse eid="1KI 15:9" /><verse number="10" style="v" sid="1KI 15:10" />sǝ yálmúr aɓwana a Urǝshalima apǝlǝa lumi-ine-nong-mwashat (41). Lullǝ ke-mǝɓwame nda Ma'aka, ɓoarnsarile Abishalom. <verse eid="1KI 15:10" /><verse number="11" style="v" sid="1KI 15:11" />Asa pàk gìr mǝnana nda pepè a mǝsǝ Yahweh ka, kǝla mǝnana kè Dauda pàk ka. <verse eid="1KI 15:11" /><verse number="12" style="v" sid="1KI 15:12" />Pǝr aburana amǝ'gyatarǝu mala ɓwabura-nǝ-nongnǝ-ɓwabura, à purî ɓá nzalî, sǝ pusǝki aɓǝ̀nzál mǝnana kat atarrí peǎ ka. <verse eid="1KI 15:12" /><verse number="13" style="v" sid="1KI 15:13" />Yì ɗǝm ngga pusǝ ke-mǝɓwame Ma'aka arǝ duk nggeau-murǝm, acemǝnana ɓak ɓǝ̀nzál gir ɓeami ace Ashera ka. Pǝlǝa Asa kwarki mǝno yì ɓǝ̀nzál ka, sǝ pisǝi a ɓangŋaban Kidǝron.<note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 23:6">2Amur 23:6</ref></char>.</note> <verse eid="1KI 15:13" /><verse number="14" style="v" sid="1KI 15:14" />Sǝama amgbangban-peri atà ankúl na kat à kiɗikia ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 22:43">1Amur 22:43</ref></char>.</note> Kat andǝ amani ka, Asa kpata Yahweh nǝ ɓabumi kat aɓa do-yilǝmu male kat. <verse eid="1KI 15:14" /><verse number="15" style="v" sid="1KI 15:15" />Yì ka yinǝ agir bolo-azǝrfa, andǝ agir bolo-njengǝlan andǝ atanggǝla mǝnana yì andǝ tárrí tàrnia ace Yahweh ka, a ɓala mala Yahweh.<verse eid="1KI 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 15:16" />Asa andǝ Ba'asha murǝm Isǝrayila camarǝ lwa-lwa arǝarǝia aɓa do-yilǝmu malea kat.<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:32">1Amur 15:32</ref></char>.</note> <verse eid="1KI 15:16" /><verse number="17" style="v" sid="1KI 15:17" />Ba'asha murǝm Isǝrayila wari nǝ lwa arǝ Yahuda,<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 16:1-6">2Acau 16:1-6</ref></char> </note> sǝ kutia ɓak nggea-là Rama ace mǝnana nǝ̀ tamsǝ koyaɓwa mǝnana earce ama nǝ̀ pùro, ko nǝ̀ kùtí aɓa nzong-nzali mala Asa murǝm Yahuda ka. <verse eid="1KI 15:17" /><verse number="18" style="v" sid="1KI 15:18" />Pǝlǝa Murǝm Asa pwan agir bolo-azǝrfa andǝ agir bolo-njengǝlan mǝnana kat à ɗekia aɓalǝ andà-tsǝk agir-ɓoarna mala ɓala mala Yahweh, andǝ amǝnana a ɓala-murǝm ngga, sǝ pè amǝ'túró-ɓala male a buia. Pǝlǝa banggia wia ɓǝà kyan nǝia ɓǝà kya pê Ben-Hadat muna-ɓwabura mala Tabrimon, muna-ɓwabura mala Heziyon murǝm Suriya, mǝnana ndanǝdo a Damaska ka,<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 11:23-24">1Amur 11:23-24</ref></char>.</note> sǝ ɓǝà banggi wi ama, <verse eid="1KI 15:18" /><verse number="19" style="v" sid="1KI 15:19" />&lt;&lt;Ɓǝ̀ sǝm kùrcau, mim sǝnǝ we, kǝla mǝnana nda kam ɗiɗyal anre tárrám andǝ tárró ka.<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 5:12">1Amur 5:12</ref>; <ref loc="2CH 16:7">2Acau 16:7</ref></char>.</note> Sǝni, mǝ ndya ǝn nggǝ tasǝô agir bolo-azǝrfa andǝ agir bolo-njengǝlan kǝla ɓoro ka. Ado ka, kyane, kya panzǝ kùrcau mǝnana anre wun wunǝ Ba'asha murǝm Isǝrayila ka,<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:27-28">1Amur 15:27-28</ref></char>.</note> ace mǝnana ɓǝ̀ ɗekiǎm ngga.&gt;&gt; <verse eid="1KI 15:19" /><verse number="20" style="v" sid="1KI 15:20" />Pǝlǝa Ben-Hadat kpata cau mala Murǝm Asa sǝ tasǝ amǝ'sàrǝ̀ban mala amǝ'lwa male sǝ à wari nǝ munǝo arǝ anggea-là mala Isǝrayila. À limurǝm amur alá Ijon, andǝ Dan, andǝ Abel-Bet-Ma'aka, andǝ Chineret kat, andǝ bu-nzali Naftali kat. <verse eid="1KI 15:20" /><verse number="21" style="v" sid="1KI 15:21" />Sǝ lang Ba'asha okce ka, tamsǝ túró ɓak sheran mǝnana a Rama ka, sǝ o kya do a Tǝrza. <verse eid="1KI 15:21" /><verse number="22" style="v" sid="1KI 15:22" />Pǝlǝa Murǝm Asa hamnǝi aɓa Yahuda kat ama koyan andǝ koyan, à tàr kǝɓwa ɗàng, ɓǝà kya a Rama. Sǝ à pwan atali, andǝ agbǝlang nggun mǝnana Ba'asha na arǝ pàngŋǝ̀nà-túró nǝia aban ɓak Rama ka, à umnǝia. Murǝm Asa pàktúró nǝ atali andǝ agbǝlang nggun mǝno ka sǝ ɓak Geba,<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 18:24">Jes 18:24</ref>; <ref loc="JOS 21:17">21:17</ref></char>.</note> là a bu-nzali Benjami, andǝ là Mizpa.<verse eid="1KI 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 15:23" />Adyan ngga, acili agir mǝnana kat à kumban aɓa yálmúrû mala Asa, andǝ rǝcandǝa male kat, andǝ agir mǝnana kat peǎ, andǝ anggea-là mǝnana ɓakkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> Sǝama lang Asa kya è ka, kum kwánó a kusǝi.<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 16:12">2Acau 16:12</ref></char>.</note> <verse eid="1KI 15:23" /><verse number="24" style="v" sid="1KI 15:24" />Sǝ Asa yi usǝlǝo atà akê, pǝlǝa à tsǝk-luí a ɓembe-ɓa-tali atà akê aɓa nggea-là mala kè Dauda. Sǝ muna-ɓwabura male Jehoshafat duk murǝm a bancame male.<verse eid="1KI 15:24" /></para>
  <para style="s">Nadap duk murǝm a Isǝrayila</para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 15:25" />A ɓaria pǝlǝa mala yálmúrû mala Asa amur Yahuda ka, Nadap muna-ɓwabura mala Jerobuam duk murǝm mala Isǝrayila, sǝ yálmúr Isǝrayila apǝlǝa ɓari. <verse eid="1KI 15:25" /><verse number="26" style="v" sid="1KI 15:26" />Yì ka pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka. Kpata kusǝ tárrí aban ɓǝsǝlǝ cauɓikea mala tárrí mǝnana tsǝk Isǝrayila pè ka.<verse eid="1KI 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 15:27" />Ba'asha muna-ɓwabura mala Ahija, mǝnana nda a tàu mala Isaka ka, kùrkûn amur Nadap. Lang Nadap andǝ amǝ'lwa male kat wari nǝ munǝo arǝ Gibeton,<note caller="+" style="f"><char style="fr" closed="false">15:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 19:44">Jes 19:44</ref>; <ref loc="1KI 16:15">1Amur 16:15</ref></char>.</note> ɓè là aɓa nzong-nzali mala amǝ'Filisti, sǝ à kya gumbǝli lě ka, Ba'asha wal-lú Nadap abanì. <verse eid="1KI 15:27" /><verse number="28" style="v" sid="1KI 15:28" />Ba'asha wal-luí a tàruià pǝlǝa mala yálmúrû mala Asa murǝm Yahuda, sǝ duk murǝm a bancame male. <verse eid="1KI 15:28" /><verse number="29" style="v" sid="1KI 15:29" />Tù anzǝm mǝnana dumǝna murǝm ngga, wal-lú amǝ'ɓala mala Jerobuam puppup. Ɗeki kǝɓwa nǝyilǝmu a ɓala mala Jerobuam ɗang, she lang twalnatea kang, kǝla mǝnana cau mala Yahweh bangŋi nǝ kun guro male Ahija ɓwa'Shilo<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 14:10">1Amur 14:10</ref></char>.</note> ka. <verse eid="1KI 15:29" /><verse number="30" style="v" sid="1KI 15:30" />Mǝnia ka yi pa acemǝnana Jerobuam loasǝ bumlulla mala Yahweh, Ɓakuli mala Isǝrayila nǝ acauɓikea mǝnana peǎ, sǝ tsǝk Isǝrayila peǎ ka.<verse eid="1KI 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 15:31" />Adyan ngga, acili agir mǝnana à kumban aɓa yálban mala Nadap, andǝ agir mǝnana peǎ kat ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="1KI 15:31" /><verse number="32" style="v" sid="1KI 15:32" />Sǝ munǝo lidǝmba anre Asa andǝ Ba'asha murǝm Isǝrayila aɓa do-yilǝmu malea kat.<verse eid="1KI 15:32" /></para>
  <para style="s">Ba'asha duk murǝm a Isǝrayila</para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 15:33" />A tàruia pǝlǝa mala yálban mala Asa murǝm Yahuda ka, Ba'asha muna-ɓwabura mala Ahija duk murǝm amur Isǝrayila kat, a Tǝrza, sǝ yálmúr aɓwana apǝlǝa lumi-ɓari-nong-ine (24). <verse eid="1KI 15:33" /><verse number="34" style="v" sid="1KI 15:34" />Yì ka pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka; kpata kusǝ Jerobuam aban ɓǝsǝlǝ cauɓikea male mǝnana pè sǝ tsǝk Isǝrayila pè ka.<verse eid="1KI 15:34" /></para>
  <chapter eid="1KI 15" />
  <chapter number="16" style="c" sid="1KI 16" />
  <para style="s">Ɓangnǝa arǝ Ba'asha</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 16:1" />Cau mala Yahweh yiu aban <note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 19:2">2Acau 19:2</ref>; <ref loc="2CH 20:34">20:34</ref></char>.</note>Jehu muna-ɓwabura mala Hanani amur kpa-kiɗìkì mala Ba'asha ama, <verse eid="1KI 16:1" /><verse number="2" style="v" sid="1KI 16:2" />&lt;&lt;Ən loasǝo aɓa tú, sǝ ǝn tsǝo a duk múrû amur aɓwana mem Isǝrayila, sǝama a <note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:34">15:34</ref></char>.</note>twalkusǝ Jerobuam, a tsǝk aɓwana mem Isǝrayila à pàk cauɓikea, à lulbumam nǝ acauɓikea malea. <verse eid="1KI 16:2" /><verse number="3" style="v" sid="1KI 16:3" />Acemani ka, mǝ ndo mǝ nǝ esǝkio, we Ba'asha wunǝ ɓala mò kat; sǝ mǝ nǝ tsǝk ɓala mò ɓǝ̀ pa kǝla ɓala mala Jerobuam muna-ɓwabura mala Nebat. <verse eid="1KI 16:3" /><verse number="4" style="v" sid="1KI 16:4" />Koya ɓwa atà amǝɓala mò mǝnana wù aɓa là ka, anvwa nǝ̀ shè, sǝ mǝnana wù a ɓawan ngga, anyal mǝnana a bumkuli ka à nǝ̀ lì.&gt;&gt;<verse eid="1KI 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 16:5" />Adyan ngga, acili agir mǝnana kat à kumban aɓa yálmúrû mala Ba'asha, andǝ agir mǝnana kat peǎ, andǝ rǝcandǝa male ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="1KI 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 16:6" />Ba'asha usǝlǝo atà akê sǝ à tsǝk-luí a Tǝrza; sǝ Ela muna-ɓwabura male duk murǝm a bancame male.<verse eid="1KI 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 16:7" />Cau mala Yahweh yiu nǝban mǝɓangnǝa Jehu muna-ɓwabura mala Hanani, amur Ba'asha sǝ amur ɓala male, ace aɓealɓikea mala Ba'asha mǝnana kat pàkkia a mǝsǝ Yahweh ka, sǝ ace lulbum mǝnana lulbum Yahweh nǝ atúró mǝnana buì peǎ, kǝla mǝnana ɓala mala Jerobuam pa, sǝ nǝ mǝno ka yinǝ kiɗikiban male ka.<verse eid="1KI 16:7" /></para>
  <para style="s">Ela yálmúr Isǝrayila</para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 16:8" />Aɓa lumi-ɓari-bwamdǝ-tongno-nong-mwashatia (26) pǝlǝa mala yálmúrû mala Asa murǝm mala Yahuda ka, Ela muna-ɓwabura mala Ba'asha duk murǝm amur Isǝrayila, sǝ yálmúr aɓwana a Tǝrza apǝlǝa ɓari. <verse eid="1KI 16:8" /><verse number="9" style="v" sid="1KI 16:9" />Mǝtúró-ɓadembi Zǝmri, mǝnana nda mǝ'sàrǝ̀ban amur gauwa-tsùrú mala awaru-pǝr male ka, kùrkún amurí. Adyan ngga, Ela na a Tǝrza aban nu-mba andǝ wal-wale a ɓala mala Arza, mǝnana nda mǝ'ɗenyinǝ ɓala mala murǝm a Tǝrza ka. <verse eid="1KI 16:9" /><verse number="10" style="v" sid="1KI 16:10" />Pǝlǝa Zǝmri yi kútí a ɓala, sǝ wali wal-luí. (Mǝnia ka kumban a lumi-ɓari-bwamdǝ-tongno-nong-ɓaria pǝlǝa mala yálmúrû mala Asa murǝm Yahuda.) Zǝmri ak bancame mala Ela kǝla murǝm.<verse eid="1KI 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 16:11" />Lang Zǝmri tinata yálmúrû zuku anzǝm mana eauna a buno-murǝm male ka, wal-lú amǝɓala mala Ba'asha kat. Nyinggi wi kǝ ɓwabura ko mwashat atà aɓǝla male ko agyajam male ɗàng. <verse eid="1KI 16:11" /><verse number="12" style="v" sid="1KI 16:12" />Anggo sǝ Zǝmri kiɗiki ɓala mala Ba'asha puppup, kǝla mǝnana cau mala Yahweh bangŋi nǝ kún mǝɓangnǝa Jehu amur Ba'asha ka, <verse eid="1KI 16:12" /><verse number="13" style="v" sid="1KI 16:13" />atàcau mala acauɓikea mala Ba'asha kat, andǝ acauɓikea mala muna-ɓwabura male Ela, mana à peǎ, sǝ à tsǝk Isǝrayila peǎ, sǝ à <note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:21">Nggur 32:21</ref></char>.</note>soabum Yahweh, Ɓakuli mala Isǝrayila, à lulbumi nǝ agirɓana, aɓǝ̀nzál malea ka. <verse eid="1KI 16:13" /><verse number="14" style="v" sid="1KI 16:14" />Adyan ngga, acili agir mǝnana kat à kumban aɓa yálmúrû mala Ela, andǝ agir mǝnana kat peǎ ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="1KI 16:14" /></para>
  <para style="s">Do-bunomurǝm mala Zǝmri</para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 16:15" />Zǝmri tita yálmúr Isǝrayila aɓa lumi-ɓari-bwamdǝ-tongno-nong-ɓaria pǝlǝa mala yálmúrû mala Asa murǝm Yahuda, sǝama yálmúrû male a Tǝrza ka, mala nongŋo tongno-nong-ɓari na. A bàkú mǝno ka amǝ'lwa na a kàttì aban gumbǝli Gibeton, ɓè là mala amǝ'Filisti, nǝ lwa. <verse eid="1KI 16:15" /><verse number="16" style="v" sid="1KI 16:16" />Lang amǝ Isǝrayila mǝnana à ramba a kàttì ok ama Zǝmri kùrnakun amur murǝm sǝ walna-luí ka, amǝ Isǝrayila kat twal Omǝri, mǝ'sàrǝ̀ban mala amǝ'lwa, akǝ mǝno yì pwari ka, aɓa kàttì, ɓǝ̀ duk murǝm Isǝrayila. <verse eid="1KI 16:16" /><verse number="17" style="v" sid="1KI 16:17" />Pǝlǝa Omǝri andǝ amǝ'lwa mala Isǝrayila kat atè loapi Gibeton sǝ à kya gumbǝli Tǝrza. <verse eid="1KI 16:17" /><verse number="18" style="v" sid="1KI 16:18" />Lang Zǝmri sǝni ama à angŋa nggea-là ka, kútí aɓa kanggǝrang-ban mala ɓala mala murǝm sǝ soa bǝsa, pisǝ ɓamúrì andǝ ɓala mala murǝm kam. <verse eid="1KI 16:18" /><verse number="19" style="v" sid="1KI 16:19" />Mǝnia ka kumban atàcau mala acauɓikea male mǝnana peǎ ka. Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, sǝ kpata anjar mala Jerobuam aban ɓǝsǝlǝ cauɓikea mǝnana pè sǝ tsǝk Isǝrayila pè ka. <verse eid="1KI 16:19" /><verse number="20" style="v" sid="1KI 16:20" />Ado ka, acili agir mǝnana à kumban aɓa yálban mala Zǝmri, andǝ kùrkún male amur Ela ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char><verse eid="1KI 16:20" /></para>
  <para style="s">Omǝri duk murǝm a Isǝrayila</para>
  <para style="p">
    <verse number="21" style="v" sid="1KI 16:21" />A bàkú mǝno ka, amǝ Isǝrayila gau arǝ abanì ɓari: gauwa-tsùrú mala aɓwe o atà Tibǝni muna-ɓwabura mala Ginat ace tsǝe ɓǝ̀ duk murǝm, sǝ cili gauwa-tsùrú ka, o atà Omǝri. <verse eid="1KI 16:21" /><verse number="22" style="v" sid="1KI 16:22" />Sǝama aɓwana mǝnana à o atà Omǝri ka, à ɓākì aɓwana mana à nda atà Tibǝni ka. Nda Tibǝni wǔ, sǝ Omǝri duk murǝm ngga.<verse eid="1KI 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 16:23" />Nda a lumi-tàrú-nǝ-mǝsǝi-mwashatia pǝlǝa mala yálmúrû mala Asa murǝm Yahuda sǝ Omǝri duk murǝm amur Isǝrayila. Yálmúr aɓwana apǝlǝa lum-nong-ɓari; tongno-nong-mwashat mala apǝlǝa yálmúrû male mǝnia ka nda a Tǝrza.<verse eid="1KI 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 16:24" />Pǝlǝa Omǝri kúr mgbangban mala Samariya a bù Shema a kún mǝsǝ bolo-azǝrfa á-tongno-nong-mwashat, sǝ ɓak nggea-là amur mgbangbanì sǝ pe wi lullǝu ama Samariya; twali arǝ lullǝu Shema, mǝnana nda mǝtala mgbangbanì ɗiɗyal ka.<verse eid="1KI 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 16:25" />Omǝri pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, sǝ cauɓikea male kútì mala aɓwana mǝnana kat à nda dǝmba nǝi ka. <verse eid="1KI 16:25" /><verse number="26" style="v" sid="1KI 16:26" />Yì ka kpata anjar mala Jerobuam muna-ɓwabura mala Nebat kat aban ɓǝsǝlǝ acauɓikea mǝnana peǎ sǝ tsǝk Isǝrayila peǎ ka. À lulbum Yahweh Ɓakuli mala Isǝrayila nǝ agirɓana, aɓǝ̀nzál malea.<verse eid="1KI 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 16:27" />Adyan ngga, acili atúró mǝnana Omǝri peǎ, andǝ rǝcandǝa male mǝnana lǝmdǝi ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="1KI 16:27" /><verse number="28" style="v" sid="1KI 16:28" />Omǝri yi usǝlǝ atà akê sǝ à tsǝk-luí a Samariya; sǝ muna-ɓwabura male Ahap duk murǝm a bancame male.<verse eid="1KI 16:28" /></para>
  <para style="s">Do-bunomurǝm mala Ahap a Isǝrayila</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 16:29" />Ahap muna-ɓwabura mala Omǝri yi duk murǝm Isǝrayila a lumi-tàrú-bwamdǝ-tongno-nong-tàruià (38) pǝlǝa mala yálmúrû mala Asa amur Yahuda, sǝ yálmúr Isǝrayila a Samariya apǝlǝa lumi-ɓari-nong-ɓari (22).<verse eid="1KI 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 16:30" />Ahap muna-ɓwabura mala Omǝri pàkkia agir mǝnana amǝɓike na a mǝsǝ Yahweh ka <note caller="+" style="f"><char style="fr" closed="false">16:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 21:25">21:25</ref></char>.</note>kútì mala aɓwana mǝnana kat à nda dǝmba nǝi ka. <verse eid="1KI 16:30" /><verse number="31" style="v" sid="1KI 16:31" />Twalkusǝ Jerobuam muna-ɓwabura mala Nebat a baní ka, gìr na bǝtikulyak, nda kya al Jezebel<note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 7:3-4">Nggur 7:3-4</ref>; <ref loc="1KI 18:4">1Amur 18:4</ref>,<ref loc="1KI 18:13">13</ref>; <ref loc="REV 2:20">Sǝn 2:20</ref></char>.</note> ɓoarnsarile Etba'al murǝm mala amǝ Sidon,<note caller="+" style="f"><char style="fr" closed="false">16:31</char><char style="fq" closed="false">Sidon </char><char style="ft" closed="false">ngga nda mwashat atà anggea-là mǝcandǝe a Fonishiya a kún nggeamùr Mediterani nǝ njar-nza mala Isǝrayila; yalung ngga nda a njar-kunmur mala Lebano.</char></note> sǝ kútí a <note caller="+" style="f"><char style="fr" closed="false">16:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 21:25-26">21:25-26</ref></char>.</note>peri aban Ba'al. <verse eid="1KI 16:31" /><verse number="32" style="v" sid="1KI 16:32" />Loasǝ gyangŋan ace Ba'al a ɓala mala Ba'al, mǝnana ɓè a Samariya ka. <verse eid="1KI 16:32" /><verse number="33" style="v" sid="1KI 16:33" />Ahap ɗǝm ngga tsǝk tondong mala <note caller="+" style="f"><char style="fr" closed="false">16:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 18:19">18:19</ref>; <ref loc="2KI 13:6">2Amur 13:6</ref>; <ref loc="2KI 17:10">17:10</ref>; <ref loc="2KI 21:3">21:3</ref>; <ref loc="2CH 14:3">2Acau 14:3</ref></char>.</note>Ashera; Ahap pàk agir kam piu ɓǝ̀ soabum Yahweh, lulbum Ɓakuli mala Isǝrayila kútì amurǝma mala amǝ Isǝrayila mana a ɓadǝmbi ka kat.<verse eid="1KI 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 16:34" />A nza male sǝ Hiyel ɓwa'Betel ɓak Jeriko. Kwakita kusǝɓa nǝ ɓwarban Abiram muna dǝmba male, sǝ oasǝ akún-la nǝ ɓwarban mǝtankwang male Segup, kǝla mǝnana cau mala Yahweh bang nǝ kún <note caller="+" style="f"><char style="fr" closed="false">16:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 6:26">Jes 6:26</ref></char>.</note>Jesǝwa muna-ɓwabura mala Nun ngga.<verse eid="1KI 16:34" /></para>
  <chapter eid="1KI 16" />
  <chapter number="17" style="c" sid="1KI 17" />
  <para style="s">Mǝɓangnǝa Iliya ham ama à nǝ̀ pàk tǝla mbulo</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 17:1" />Ɓè mǝɓangnǝa lùllǝì ama Iliya, ɓwa Tishbe, a bù-nzali Gilǝyat, yiu sǝ banggi Murǝm Ahap ama, &lt;&lt;Mbak-kàngkàng Yahweh Ɓakuli mala Isǝrayila nakam, mǝnana ǝn camgiyi a ɓadǝmbi ka, twal ado aban ká arǝ apǝlǝa mǝnana à kǝ yiu ka, ncimna pa nǝ̀ kpa ɗang,<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 4:25">Luk 4:25</ref>; <ref loc="JAS 5:17">Jem 5:17</ref></char>.</note> sǝ mbulo pa nǝ̀ nya ɗang, she ɓǝ̀n bangŋǝna ama mbulo ɓǝ̀ nya ka.&gt;&gt;<verse eid="1KI 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1KI 17:2" />Anzǝm mǝno ka, cau mala Yahweh yiu aban Iliya ama, <verse eid="1KI 17:2" /><verse number="3" style="v" sid="1KI 17:3" />&lt;&lt;Nying ban mǝnia ka, sǝ wu o nǝ njar-takuli, kya sǝmbǝrǝa a ban myalmúr Kerit, mǝnana nda a njar-takuli mala Nggeasala Jodan ngga. <verse eid="1KI 17:3" /><verse number="4" style="v" sid="1KI 17:4" />Awu nǝ nggǝ nu mùr a mǝno yì myalmúr ka; ǝn tasǝna agang'lang ɓǝà kǝ po girlina a banì.&gt;&gt;<verse eid="1KI 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 17:5" />Nda Iliya lo wario sǝ kpata cau mala Yahweh; wario kya do a nkanggari myalmúr Kerit, mǝnana nda a njar-takuli mala Nggeasala Jodan ngga. <verse eid="1KI 17:5" /><verse number="6" style="v" sid="1KI 17:6" />Agang'lang kǝ yinǝì wi nǝ bǝredi andǝ nyama koya dǝmbari andǝ pwarikpǝra; sǝ kǝ nu mùr a mǝno yì myalmúr ka. <verse eid="1KI 17:6" /><verse number="7" style="v" sid="1KI 17:7" />Sǝama nǝnzǝ́mò ka, mùr mala mǝno yì myalmúr ka yi im kat, acemǝnana mbulo nya aɓa nzali mǝno ɗàng.<verse eid="1KI 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 17:8" />Pǝlǝa cau mala Yahweh yiu abani, ama, <verse eid="1KI 17:8" /><verse number="9" style="v" sid="1KI 17:9" />&lt;&lt;Lo, o a <note caller="+" style="f"><char style="fr" closed="false">17:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="OBA 1:20">Oba 1:20</ref>; <ref loc="LUK 4:26">Luk 4:26</ref></char>.</note>Zarefat, là mana nda tù aban nggea-là Sidon ngga, sǝ wu duk kanó. Sǝni, ǝn tsǝ́ngŋǝ̀nà ɓè mā-lú a ban mǝno ka ɓǝ̀ po girlina.&gt;&gt;<verse eid="1KI 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 17:10" />Nda Iliya lo sǝ wari a Zarefat ka. Lang yina nǝ̀ kùtí a là ka, sǝn ɓè mā-lú aban ram mǝsǝ'nggun; pǝlǝa tunǝi sǝ banggi wi ama, &lt;&lt;Ida, yinǝàm nǝ mùr bǝti aɓa dù, ace mǝnana mǝ nu ka.&gt;&gt; <verse eid="1KI 17:10" /><verse number="11" style="v" sid="1KI 17:11" />Lang ndaban o nǝ̀ nggá yinǝ mùr ka, Iliya tunǝi sǝ banggi wi ama, &lt;&lt;Ida, yinǝàm nǝ bǝredi bǝti gbal a buo!&gt;&gt;<verse eid="1KI 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 17:12" />Ɓwame nyesǝi wi ama, &lt;&lt;Ən kán nǝ Yahweh Ɓakuli mô mǝyilǝmui, ǝn panǝ ɓekǝ bǝredi a ɓala mem ɗàng. Kǝ gìr mana mǝ ndanǝi ka, muku na a ɓabù aɓa kwar, andǝ mùrú olif bǝti aɓa muna-dù. Ən pur kani ace tàrki mǝsǝ'nggun mǝ kyan nǝi a ɓala ace bwal bǝsa, ace mǝnana mǝ lam masǝlǝata girlina acem sǝnǝ munem, ɓǝ̀ sǝm li sǝ ɓǝ̀ sǝm wú.&gt;&gt;<verse eid="1KI 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 17:13" />Sǝ Iliya banggi wi ama, &lt;&lt;Cè ɓangciu pakko ɗàng, kyane pa kǝla mana a bang ngga; sǝama a tadǝmbe ka pàkkam bǝredi bǝti nǝ gir mǝnana a ndanǝi ka, yinǝàm nǝi, anzǝm mǝno ka, sǝ wu pàk ɓè aceo wunǝ munio. <verse eid="1KI 17:13" /><verse number="14" style="v" sid="1KI 17:14" />Mǝnia ka nda cau mǝnana Yahweh, yì Ɓakuli mala amǝ Isǝrayila na ka: &lt;Muku mana aɓa kwar ka pà nǝ̀ mal ɗang, sǝ mùrú mana aɓa dù ka pà nǝ̀ gatti ɗang, she pwari mana Mim Yahweh, mǝ nǝ tasǝ mbulo ɓǝ̀ nya amur nzali ka.&gt; &gt;&gt;<verse eid="1KI 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 17:15" />Pǝlǝa mā-lú man o kya pa kǝla mǝnana Iliya banggi wi ka; sǝ koya pwari, arǝ anonggio pas ka, girlina nakam mana mā-lú man, andǝ amǝɓala male, andǝ Iliya, à li sǝ kārǝia ka. <verse eid="1KI 17:15" /><verse number="16" style="v" sid="1KI 17:16" />Muku mana aɓa kwar ka mal ɗang, sǝ mùrú mana aɓa dù ka gatti ɗang, kǝla cau mala Yahweh mana bangŋi nǝ kún Iliya ka.<verse eid="1KI 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 17:17" />Anzǝm mǝnia ka, mā-lú man, mana gbal nda mǝtala-ɓala ka, muni nong kwánó; rǝkwane ɓike, sǝ lidǝmba nǝ ɓike kǝ̀rkǝ́r; a masǝlǝate ka lin'ueo mala munê yi kasǝa.<verse eid="1KI 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 17:18" />Ɓwame banggi Iliya ama, &lt;&lt;Mana kpapiam sǝnǝ we, we ɓwa mala Ɓakuli? A yiu kani ace pusǝta cauɓikea mem, sǝ wu yinǝ lú mala munem le?&gt;&gt;<verse eid="1KI 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 17:19" />Iliya banggi wi ama, &lt;&lt;Yinǝàm nǝ munio.&gt;&gt; Pǝlǝa ak muna a bù nggè, sǝ eau nǝi a kurǝm-kuli, ban mǝnana sulǝ kam ngga. Wario kya nongsǝ munê amur gyangŋan-nongŋo male. <verse eid="1KI 17:19" /><verse number="20" style="v" sid="1KI 17:20" />Pǝlǝa loasǝ gì ɓua aɓa hiwi aban Yahweh, ama, &lt;&lt;Yahweh Ɓakuli mem, mā-lú mǝnia ka nda pàm bansulǝo kani a ɓala male ka; palang ɗǝm sǝ a yinǝ múrɓikea amurí, a wal-lú muni?&gt;&gt; <verse eid="1KI 17:20" /><verse number="21" style="v" sid="1KI 17:21" />Pǝlǝa Iliya sárǝ́ rǝì amúr muna kusǝ tàrú, sǝ ɓua aban Yahweh ama, &lt;&lt;Yahweh Ɓakuli mem, ida, ɗeki yilǝmi muna man ɓǝ̀ nyare aɓa nyami ɗǝm.&gt;&gt;<verse eid="1KI 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 17:22" />Yahweh ok ɓua mala Iliya; muna tita lin'ueo ɗǝm sǝ lo nǝyilǝmu. <verse eid="1KI 17:22" /><verse number="23" style="v" sid="1KI 17:23" />Iliya twal munê sǝ sulǝ nǝi a ɓaɓala, sǝ nyesǝi pè nggè; pǝlǝa Iliya bang ama, &lt;&lt;Sǝni, munio nia nǝyilǝmu ka.&gt;&gt;<verse eid="1KI 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 17:24" />Nda ɓwame banggi Iliya ama, &lt;&lt;Ado ka, ǝn sǝlǝna ama a nda ɓwa mala Ɓakuli, sǝ cau mala Yahweh a kuno ka mǝsǝcaua.&gt;&gt;<verse eid="1KI 17:24" /></para>
  <chapter eid="1KI 17" />
  <chapter number="18" style="c" sid="1KI 18" />
  <para style="s">Obadiya je andǝ Iliya</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 18:1" />Anzǝm anongŋo pas ka, cau mala Yahweh yiu aban Iliya aɓa tàruià pǝlǝa [mala tǝla-mbulo] ama, &lt;&lt;Kyane, lǝmdǝ ɓamurò aban Ahap, sǝ mǝ nǝ sulǝ mbulo amur nzali.&gt;&gt; <verse eid="1KI 18:1" /><verse number="2" style="v" sid="1KI 18:2" />Nda Iliya wario, nǝ̀ nggá lǝmdǝ ɓamurì aban Ahap ka. Adyan ngga, nzal-gula candǝna a Samariya, <verse eid="1KI 18:2" /><verse number="3" style="v" sid="1KI 18:3" />sǝ Ahap tunǝ Obadiya<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">Obadiya mǝnia ka, nda mana gilǝ Malǝmce mala Obadiya ka ɗàng.</char></note> mǝnana nda mǝ'ɗenyinǝ ɓala-murǝm ngga. (Obadiya ka, ɓwa na kǝ ɓanggi Yahweh kǝ̀rkǝ́r; <verse eid="1KI 18:3" /><verse number="4" style="v" sid="1KI 18:4" />acemǝnana lang Jezebel nǝ̀ nggǝ wal-lú amǝ'ɓangnǝa mala Yahweh ka, Obadiya twal amǝ'ɓangnǝa gbǝman-mwashat (100), sǝ kya sǝmbǝria arǝ agumi-ɓa-tali ɓari, lumi-tongno aɓa komǝye, sǝ kǝ pea wia girlina andǝ mur.) <verse eid="1KI 18:4" /><verse number="5" style="v" sid="1KI 18:5" />Ahap ne Obadiya ama, &lt;&lt;Gya aɓa nzalinì aban amgbeaɗe-mur kat andǝ aɓangŋaban kat. Earka sǝm nǝ̀ kum bondo ace amsǝ yilǝmi apǝr andǝ apǝr-mǝdambǝriso, ace mǝnana ɓǝ̀ sǝm nggá ɓwarban agirkusǝu kat ɗàng.&gt;&gt; <verse eid="1KI 18:5" /><verse number="6" style="v" sid="1KI 18:6" />Nda sǝ à gau nzali mana à nǝ̀ gya aɓalǝi ka anrea; Ahap o a buì mwashat sǝ Obadiya um nǝ ɓè buì.<verse eid="1KI 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 18:7" />Lang Obadiya na aban ká ka, kara Iliya yi kumi, súrǝì sǝ ɓun aɓadǝmbi a nzali sǝ na ama, &lt;&lt;A nda le, ɓwamǝgule mem Iliya?&gt;&gt;<verse eid="1KI 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 18:8" />Iliya eari wi ama, &lt;&lt;Mǝ nda. Kyane banggi mǝtala-ɓala mò ama, &lt;Iliya na kani!&gt; &gt;&gt;<verse eid="1KI 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 18:9" />Obadiya banggi wi ama, &lt;&lt;Ya cauɓikea na ǝn pakko sǝ a kǝ tasǝam, mim guro mò a ɓabu Ahap ɓǝ̀ wal-luem? <verse eid="1KI 18:9" /><verse number="10" style="v" sid="1KI 18:10" />Ən kánbo nǝ yilǝmi Yahweh Ɓakuli mô, kǝ nzali, ko domurǝm pa kàm mǝnana mǝtala-ɓala mem túrban nggam ɓǝà alto raka. Sǝ nzali, ko domurǝm mǝnana kat bang ama, &lt;Pa kani raka,&gt; tsǝia à kángìr ama à sǝno ɗang. <verse eid="1KI 18:10" /><verse number="11" style="v" sid="1KI 18:11" />Sǝ ado ka, a kǝ nam ama, Kya ne mǝtala-ɓala mò ama, &lt;Iliya na kani.&gt; <verse eid="1KI 18:11" /><verse number="12" style="v" sid="1KI 18:12" />Nǝ̀ gandǝ do ama, lang ǝn nggǝ nyio ka, <note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="2KI 2:16">2Amur 2:16</ref>; <ref loc="EZK 3:12">Ezǝk 3:12</ref>,<ref loc="EZK 3:14">14</ref>; <ref loc="EZK 8:3">8:3</ref>; <ref loc="ACT 8:39">Atúró 8:39</ref></char></note>Bangŋo mala Yahweh nǝ̀ um nǝ we a ban mǝnana ǝn súrǝì raka, sǝ ɓǝ̀ ǝn kya nanì Ahap sǝ yiu sǝ kumo raka, nǝ̀ wal-luem. Sǝama mim guro mò, twal a lo mem ngga, mǝ nda mǝɓanggi Yahweh. <verse eid="1KI 18:12" /><verse number="13" style="v" sid="1KI 18:13" />Mǝtala-ɓala mem, à nô gìr mǝnana ǝn pa, lang Jezebel na aban wal-lú amǝ'ɓangnǝa mala Yahweh ka re? Mǝnana ǝn sǝmbǝrǝ amǝ'ɓangnǝa mala Yahweh gbǝman-mwashat (100), aɓalǝ agumi-ɓa-tali ɓari, lumi-tongno aɓa komǝye, sǝ ǝn warinǝia nǝ girlina andǝ mur ka? <verse eid="1KI 18:13" /><verse number="14" style="v" sid="1KI 18:14" />Sǝ ado ka, a kǝ nam ama, kyane ne mǝtala-ɓala mò ama, &lt;Iliya na kani.&gt; Nǝ̀ wal-luem!&gt;&gt;<verse eid="1KI 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 18:15" />Iliya bang ama, &lt;&lt;Mbak-kàngkàng Yahweh, Mǝtala Abangŋo, mǝnana ǝn camgiyi aɓadǝmbi nakam ngga, mǝ nǝ lǝmdǝ ɓamúràm abaní yalung.&gt;&gt; <verse eid="1KI 18:15" /><verse number="16" style="v" sid="1KI 18:16" />Nda sǝ Obadiya wari aban Ahap kya banggi wi, sǝ Ahap wario kya kum Iliya ka.<verse eid="1KI 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 18:17" />Lang Ahap sǝn Iliya ka, Ahap ɗì ama, &lt;&lt;A nda man le, we mǝpè Isǝrayila tanni?&gt;&gt; <verse eid="1KI 18:17" /><verse number="18" style="v" sid="1KI 18:18" />Iliya pe wi eare ama, &lt;&lt;Ən pe Isǝrayila tanni ɗàng; kǝ awu nda, we wunǝ ɓala mala tarró, lang wu vwakibu wun arǝ anzongcau mala Yahweh, sǝ wu kpata aBa'al ka. <verse eid="1KI 18:18" /><verse number="19" style="v" sid="1KI 18:19" />Ado ka, túrban ɓǝà rambam Isǝrayila kat a Nkono Kamel. Sǝ wu yinǝ amǝ'ɓangnǝa mala Ba'al gbǝman-ine-nǝ-lumi-tongno andǝ amǝ'ɓangnǝa mala Ashera gbǝman-ine, mǝnana à likiyili a kpamgbang-lǐ mala Jezebel ka.<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="fq" closed="false">mǝnana à likiyili a kpamgbang-lǐ mala Jezebel ka </char><char style="ft" closed="false">ko &lt;&lt;mǝnana Jezebel na kǝ linǝia ka.&gt;&gt;</char></note>&gt;&gt;<verse eid="1KI 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 18:20" />Nda sǝ Ahap wari aban amǝ Isǝrayila kat, sǝ ramba amǝ'ɓangnǝa abanɓwáná a Nkono Kamel ka. <verse eid="1KI 18:20" /><verse number="21" style="v" sid="1KI 18:21" />Iliya sung tù aban aɓwe sǝ bang ama, &lt;&lt;Nǝ̀ sau lang sǝ wun nǝ̀ nggǝ ɗenggǝli a nre ka aɗenyicau ɓari?<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="JOS 24:15">Jes 24:15</ref>; <ref loc="MAT 6:24">Mat 6:24</ref> </char>.</note> Ɓǝ̀ Yahweh nda Ɓakuli ka wu kpate, sǝ ɓǝ̀ Ba'al na ka, wu kpate.&gt;&gt; Sǝ kǝɓwa pǝlǝi wi kǝ cau ɗàng.<verse eid="1KI 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 18:22" />Pǝlǝa Iliya banggia wia ama, &lt;&lt;Mim, nǝmurǝam, kǝ mǝ nda mǝɓangnǝa mala Yahweh mana ue ka; sǝama amǝ'ɓangnǝa mala Ba'al ka, à nda gbǝman-ine-nǝ-lumi-tongno. <verse eid="1KI 18:22" /><verse number="23" style="v" sid="1KI 18:23" />Ado ka, wu pà sǝm ajamnda ɓari, sǝ ɓǝà twalî ɓamuria jamnda mwashat, ɓǝà sàngi nyamia ɓǝà tsǝkia amur gimsa, sǝ ɓǝà kǝa tsǝk bǝsa atè ɗàng. Sǝ mim ngga, mǝ nǝ sàngi ɓè jamnda man, mǝ nǝ tsǝì amur gimsa sǝ pà mǝ nǝ tsǝk bǝsa atè ɗàng. <verse eid="1KI 18:23" /><verse number="24" style="v" sid="1KI 18:24" />Wu tunǝ ɓakuli ma'wun, sǝ mǝ nǝ tunǝ Yahweh. Ɓakuli mana pa eare nǝ bǝsa ka, ɓǝ̀ duk Ɓakuli.&gt;&gt; Aɓwe kat pa eare ama, &lt;&lt;Cau mǝnana a ne ka, nda jik.&gt;&gt; <verse eid="1KI 18:24" /><verse number="25" style="v" sid="1KI 18:25" />Iliya ne amǝ'ɓangnǝa mala Ba'al ama, &lt;&lt;Wu tàrî ɓamur rǝ wun jamnda mwashat, wu sàngi a dǝmba, acemǝnana wu nda pas, sǝ wu tunǝ ɓakuli ma'wun, sǝama wu kǝa tsǝki wi bǝsa ɗàng.&gt;&gt;<verse eid="1KI 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 18:26" />Nda à twal jamnda mǝnana à pea wia ka, à sàngi, sǝ à pakhiwi aban Ba'al twal a dǝmbari aban ká pwarizǝkya, à kǝ na ama, &lt;&lt;Ba'al ok sǝm!&gt;&gt; Sǝama à ok kǝ giu ɗàng, sǝ kǝɓwa pea wia eare ɗang. À camarǝ zurkio, sǝ à kǝ gumbǝli gyangŋan mǝnana à ɓè ka. <verse eid="1KI 18:26" /><verse number="27" style="v" sid="1KI 18:27" />Nǝ pwarizǝkya ka, Iliya ɓangginǝia, na ama, &lt;&lt;Wu loasǝ gi wun kpǝm, yì ka ɓakuli na. Earka nda aban pakɗenyicau, ko nda aban doagung, ko twalnabǝri, ko nda a ntulo, wu loasǝi.&gt;&gt;<verse eid="1KI 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 18:28" />Nda à loasǝ gia kàm kpǝm, sǝ kǝla mana kuncau malea kania wia ka, à cangi rǝia nǝ anggeabyau andǝ amunabyau, gandǝa nkila tita ɗārǝ arǝia. <verse eid="1KI 18:28" /><verse number="29" style="v" sid="1KI 18:29" />Lang pwari wulina ka, à camarǝ ɓangnǝa ba bu-pwari paɓoro pwarikpǝra, sǝama à ok kǝ giu ɗàng, sǝ kǝɓwa pa eare ɗang, sǝ kǝɓwa falǝnǝia ɗàng.<verse eid="1KI 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1KI 18:30" />Iliya pǝlǝa ne aɓwe ama, &lt;&lt;Wu sung abanam!&gt;&gt; Pǝlǝa aɓwana kat yiu abani. Sǝ gilǝki gyangŋan mala Yahweh mǝnana à arkini ka. <verse eid="1KI 18:30" /><verse number="31" style="v" sid="1KI 18:31" />Iliya twal atali lum-nong-ɓari kǝla mana làkkì mala atau mala amuna-burana mala kèa Yakupu pàk ka, yì keà mǝnana cau mala Yahweh yiu abaní ama, &lt;&lt;Isǝrayila nǝ̀ duk lullǝo&gt;&gt; ka.<note caller="+" style="f"><char style="fr" closed="false">18:31 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 32:28">Tite 32:28</ref>; <ref loc="GEN 35:10">35:10</ref>; <ref loc="2KI 17:34">2Amur 17:34</ref></char>.</note> <verse eid="1KI 18:31" /><verse number="32" style="v" sid="1KI 18:32" />Nǝ amǝno yì atali ka sǝ ɓak gyangŋan aɓa lullǝ Yahweh. Sǝ gwam dā'ngal kàrì, mǝnana nǝ̀ gandǝ twal mùr lita lum-nong-ine ka. <verse eid="1KI 18:32" /><verse number="33" style="v" sid="1KI 18:33" />Gilǝki gimsa amurí sǝ sàngi jamnda sǝ nongsǝki amur gimsa. Pǝlǝa banggia wia ama, &lt;&lt;Wu lùmsǝ aganggǝlang ine nǝ mur, sǝ wu solǝi amur paɓoro mala pisǝe kǝring, sǝ amur gimsa.&gt;&gt; <verse eid="1KI 18:33" /><verse number="34" style="v" sid="1KI 18:34" />Sǝ bang ama, &lt;&lt;Wu pè kusǝ ɓari,&gt;&gt; sǝ à pe kusǝ ɓari. Nea wia ɗǝm ama, &lt;&lt;Wu pè kusǝ tàrú,&gt;&gt; sǝ à pè kusǝ tàrú. <verse eid="1KI 18:34" /><verse number="35" style="v" sid="1KI 18:35" />Mùrnî aki gyangŋan yi lumsǝ mǝno yì dā'ngal ka.<verse eid="1KI 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1KI 18:36" />Lang bu-pwari mala pa ɓoro mala pwarikpǝra pángŋǝ̀nà ka, Iliya mǝɓangnǝa sung tù, sǝ bang ama, &lt;&lt;Yahweh Ɓakuli mala Ibǝrayim, andǝ Ishaku, andǝ Isǝrayila, tsǝa ɓǝ̀ aɓwana sǝlǝ yalung a Isǝrayila ama, a nda Ɓakuli, sǝ ɓǝà sǝlǝ ama, mǝ nda guro mò, sǝ ɓǝà sǝlǝ ama, amǝnia yì agir ǝn pea ka, cau mò na ǝn kpate ka. <verse eid="1KI 18:36" /><verse number="37" style="v" sid="1KI 18:37" />Oem, we Yahweh, oem, ace mǝnana ɓǝ̀ amǝnia yì aɓwana ka ɓǝà sǝlǝ ama, we Yahweh ka, a nda Ɓakuli, sǝ a nda aban pǝlǝ ɓabumia ɓǝà nyar ɗǝm a bano.&gt;&gt;<verse eid="1KI 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1KI 18:38" />Kara bǝsa mala Yahweh sulǝo pisǝ gir'nkila mala pisǝe kǝring mǝnia, andǝ gimsa andǝ atali, andǝ kǝkǝri, sǝ imsǝ mùr mǝnana nda aɓa dā'ngal ka.<verse eid="1KI 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 18:39" />Lang aɓwe sǝni ka, à kpa nzali nǝ ɓamǝsǝia. À na ama, &lt;&lt;Yahweh nda Ɓakuli, Yahweh nda Ɓakuli.&gt;&gt;<verse eid="1KI 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1KI 18:40" />Sǝ Iliya nea wia ama, &lt;&lt;Wu bwalki amǝ'ɓangnǝa mala Ba'al! Wu kǝa earî kǝ mwashat ateà ɓǝ̀ ɓwar ɗang!&gt;&gt; À bwalkia; sǝ Iliya sulǝia a ɓangŋaban Kishon, wal-luia kat abanì.<verse eid="1KI 18:40" /></para>
  <para style="s">Yahweh sulǝ mbulo</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 18:41" />Pǝlǝa Iliya ne Ahap ama, &lt;&lt;O, kya lili sǝ wu nu, acemǝnana ǝn nggǝ ok gǝshi mbulo mǝcandǝe.&gt;&gt;<verse eid="1KI 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 18:42" />Nda Ahap o nǝ̀ nggá lìli sǝ nǝ̀ nu, sǝ Iliya ka eau a ɓong Nkono Kamel; ɓun a nzali, sǝ oasǝ ɓamuri a nre ka ankūnǝi. <verse eid="1KI 18:42" /><verse number="43" style="v" sid="1KI 18:43" />Ne guro male ama, &lt;&lt;Eauwe kya sǝnban nǝ njar nggeamùr.&gt;&gt; Sǝ eauwe kya sǝnban, sǝ bang ama, &lt;&lt;Kǝgir pà kàm ɗàng.&gt;&gt; Sǝ ne wi ɗǝm ama, &lt;&lt;Kyan ɗǝm&gt;&gt; kusǝ tongno-nong-ɓari.<verse eid="1KI 18:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="1KI 18:44" />A tongno-nong-ɓaria kusǝu ka, guro male bang ama, &lt;&lt;Ən sǝn pǝrɓang mǝkyauwe kǝla ɓabu ɓwa, eauwe kǝ yiu amur nggeamùr.&gt;&gt;</para>
  <para style="p" vid="1KI 18:44">Sǝ Iliya ne wi ama, &lt;&lt;Kyane ne Ahap ama, &lt;Kùr waru-pǝr mò [arǝ apǝr], sǝ wu sulǝ akaurǝa, ace mǝnana mbulo ɓǝkǝa kasǝkuno raka.&gt; &gt;&gt;<verse eid="1KI 18:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 18:45" />Zuku ka, pǝrɓang pǝndǝna nǝ mbulo cikcik, gung longŋa ɓua, sǝ mbulo mǝcandǝe sulǝo. Ahap lo nǝ waru-pǝr male, nǝ̀ nyare a Jezǝril. <verse eid="1KI 18:45" /><verse number="46" style="v" sid="1KI 18:46" />Rǝcandǝa mala Yahweh sulǝ amur Iliya, sǝ kàr nggea-daura male kùrì a taɓuni, ɓangŋa yi kútì Ahap, akidǝmba amur njar aban ká a bankutio a Jezǝril.<verse eid="1KI 18:46" /></para>
  <chapter eid="1KI 18" />
  <chapter number="19" style="c" sid="1KI 19" />
  <para style="s1">Iliya ɓanggi Jezebel</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 19:1" />Ahap ne Jezebel gìr mǝnana kat Iliya pàk ka, andǝ ulang walban mǝnana <note caller="+" style="f"><char style="fr" closed="false">19:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 18:40">18:40</ref></char>.</note>wal amǝ'ɓangnǝa [mala Ba'al] kat nǝ nggeabyau ka. <verse eid="1KI 19:1" /><verse number="2" style="v" sid="1KI 19:2" />Pǝlǝa Jezebel tasǝ mǝ'na-túrbân aban Iliya nǝ cau ama, &lt;&lt;Ɓǝ̀ aɓakuli pangnǝ mim, yale ɓǝ̀ kútì mǝno, ɓǝ̀ ǝn twal yilǝmo kǝla mǝnana a twal yilǝmi amǝ'ɓangnǝa mala Ba'al, liwi nǝ bu-pwari kǝla man raka.&gt;&gt; <verse eid="1KI 19:2" /><verse number="3" style="v" sid="1KI 19:3" />Ɓangciu pàkki Iliya, pǝlǝa lo ɓangŋa ace amsǝ yilǝmi. Sǝ lang yi bik <note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:31">Tite 21:31</ref></char>.</note>Biyasheba mǝnana a bu-nzali Yahuda ka, pǝlǝa nying guro male abanì.<verse eid="1KI 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 19:4" />Sǝama yì Iliya nǝ ɓamurǝi ka, twal gya mala nongŋo mwashat a ɓabondo, sǝ yi dumnǝdo a tǝrta muna-nggun. Sǝ zǝmbi Ɓakuli ace mǝnana ɓǝ̀ twal yilǝmi ka, bang ama, &lt;&lt;Karǝna anggo ado, We Yahweh, twal yilǝmem acemǝnana ǝn kútì akâ ɗàng.&gt;&gt; <verse eid="1KI 19:4" /><verse number="5" style="v" sid="1KI 19:5" />Pǝlǝa sarǝa nong'ntullo a tǝrta ɓè muna-nggun. Kara ɓè mǝturonjar je, sǝ ne wi ama, &lt;&lt;Lo, lìli.&gt;&gt; <verse eid="1KI 19:5" /><verse number="6" style="v" sid="1KI 19:6" />Lang sǝnban ngga, sǝn kyak mǝnana à lurǝi amur nkalang bǝsa ka andǝ mùr aɓa dù nǝ ban múrí. Nda li sǝ nu, sǝ nong-nongŋo ɗǝm ngga. <verse eid="1KI 19:6" /><verse number="7" style="v" sid="1KI 19:7" />Mǝturonjar mala Yahweh nyare yiu ɗǝm sǝ je Iliya, ne wi ama, &lt;&lt;Lo, lìli, acemǝnana gya mǝnana a dǝmbo ka mǝsauwe na.&gt;&gt;) <verse eid="1KI 19:7" /><verse number="8" style="v" sid="1KI 19:8" />Nda Iliya lo, li sǝ nu, sǝ kum rǝcandǝa mala gya mala <note caller="+" style="f"><char style="fr" closed="false">19:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 19:8">19:8</ref>; <ref loc="EXO 24:18">Pur 24:18</ref>; <ref loc="EXO 34:28">34:28</ref>; <ref loc="DEU 9:9">Nggur 9:9</ref>; <ref loc="DEU 18">18</ref>; <ref loc="MAT 4:2">Mat 4:2</ref>; <ref loc="MRK 1:13">Mar 1:13</ref>; <ref loc="LUK 4:2">Luk 4:2</ref></char>.</note>nongŋo lumi-ine dù andǝ pwari, aban ká Horep, yì nkono mala Ɓakuli ka.<verse eid="1KI 19:8" /></para>
  <para style="s1">Yahweh ne Iliya cau a Horep</para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 19:9" />A ban mǝno ka, Iliya yi kútí aɓa gumi-ɓa'tali, sǝ nongŋo abanì; pǝlǝa Yahweh ɗì ama, &lt;&lt;Iliya, mana a kǝ pak kani?&gt;&gt; <verse eid="1KI 19:9" /><verse number="10" style="v" sid="1KI 19:10" />Iliya eari wi ama, &lt;&lt;Mǝ ndanǝ <note caller="+" style="f"><char style="fr" closed="false">19:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 25:11">Ɓal 25:11</ref>; <ref loc="NUM 13">13</ref></char>.</note>ɓabumpina kǝ̀rkǝ́r ace Yahweh, Ɓakuli Mǝtala Abangŋo; acemǝnana amǝ'Isǝrayila ka, à vwakinabuia arǝ kùrcau mò, à arkina agyangŋan mò, sǝ à walna amǝ'ɓangnǝa mô nǝ nggeabyau. Kǝ mǝ nda ǝn ueo, nǝmurǝam ngga, sǝ à ndaban alta yilǝmem à nǝ̀ twali.&gt;&gt; <verse eid="1KI 19:10" /><verse number="11" style="v" sid="1KI 19:11" />Yahweh ne wi ama, &lt;&lt;Puro kya cam amur nkono aɓadǝm Yahweh, acemǝnana Yahweh no nǝ̀ ya kútí nǝ banì.&gt;&gt;</para>
  <para style="p" vid="1KI 19:11">Pǝlǝa ɓè nggea gung mǝcandǝe san nkonoe, sǝ arki atali bǝti-bǝti aɓadǝm Yahweh, sǝama Yahweh pà kàm aɓa gungnì ɗàng. Anzǝm gung ngga, nzali gǝggǝli, sǝama Yahweh pà kàm aɓa gǝggǝli mala nzali mǝno ɗàng. <verse eid="1KI 19:11" /><verse number="12" style="v" sid="1KI 19:12" />Anzǝm gǝggǝli mala nzali ka, bǝsa sǎ, sǝama Yahweh pà kàm aɓa bǝshe ɗàng. Anzǝm bǝshe ka, mǝgiu mǝɓuɓɓuki yiu. <verse eid="1KI 19:12" /><verse number="13" style="v" sid="1KI 19:13" />Sǝ lang Iliya ok giuì ka, gìr ɓamǝsǝi nǝ daura-murɓe male, sǝ wario kya came a bankutio aɓa gumi-ɓa'talinì.</para>
  <para style="p" vid="1KI 19:13">Pǝlǝa ɓè giu ɗì ama, &lt;&lt;Iliya, mana a kǝ pak kani?&gt;&gt; <verse eid="1KI 19:13" /><verse number="14" style="v" sid="1KI 19:14" />Iliya eari wi ama, &lt;&lt;Mǝ ndanǝ ɓabumpina kǝ̀rkǝ́r ace Yahweh, Ɓakuli Mǝtala Abangŋo. Amǝ'Isǝrayila ka, à vwakinabuia arǝ kùrcau mò, à arkina agyangŋan mò, sǝ à walna amǝ'ɓangnǝa mô nǝ nggeabyau. Kǝ mǝ nda ǝn ueo, nǝmurǝam ngga, sǝ à ndaban alta yilǝmem à nǝ̀ twali.&gt;&gt;<verse eid="1KI 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 19:15" />Sǝ Yahweh banggi wi ama, &lt;&lt;Nyar a kusǝo, kya a ɓabondo mala Damaska. Sǝ ɓǝ̀ a bingŋǝna ka, awu nǝ ɗārǝ Hazayel ɓǝ̀ duk murǝm amur Suriya. <verse eid="1KI 19:15" /><verse number="16" style="v" sid="1KI 19:16" /><note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 9:1-6">2Amur 9:1-6</ref></char>.</note>Sǝ awu nǝ ɗārǝ Jehu muna-ɓwabura mala Nimshi ɓǝ̀ duk murǝm amur Isǝrayila, andǝ Elisha muna-ɓwabura mala Shafat mala Abel-Mehola, ɓǝ̀ duk mǝɓangnǝa a kunio. <verse eid="1KI 19:16" /><verse number="17" style="v" sid="1KI 19:17" />Ɓwa mǝnana apî nggeabyau mala Hazayel ka, Jehu nǝ̀ wal-luí, sǝ ɓwa mǝnana apî nggeabyau mala Jehu ka, Elisha nǝ̀ wal-lú ɓwe. <verse eid="1KI 19:17" /><verse number="18" style="v" sid="1KI 19:18" />Kat andǝ mǝno ka, Mǝ ndanǝ amǝkpatam á-tongno-nong-ɓari (7,000) kàm piu a Isǝrayila, mǝnana à ɓun nǝ ankūnǝia aɓadǝm Ba'al ɗàng, sǝ à peri abaní raka.&gt;&gt;<verse eid="1KI 19:18" /></para>
  <para style="s1">Ɓakuli tunǝ Elisha</para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 19:19" />Nda Iliya loapi ban mǝno, sǝ kya kum Elisha muna-ɓwabura mala Shafat aban rikrya nǝ andá-rya mala nggun-rya lum-nong-ɓari, sǝ yì Elisha ka, nda mǝnana kǝ rikrya nǝ lum-nong-ɓaria nggun-rya ka. Pǝlǝa Iliya gya kútí nǝbani sǝ túrì wi daura-murɓe male amurí. <verse eid="1KI 19:19" /><verse number="20" style="v" sid="1KI 19:20" />Elisha nying anda-rya male, ɓangŋa atà Iliya, sǝ ne wi ama, &lt;&lt;Ida, nyem mǝ nyare mǝ nggya tsǝk tárrám andǝ nggem a-ndà, sǝ mǝ nǝ kpato.&gt;&gt; Iliya eari wi ama, &lt;&lt;Nyare kyane, ǝn tamsǝo arǝ ká abania ɗàng.&gt;&gt; <verse eid="1KI 19:20" /><verse number="21" style="v" sid="1KI 19:21" />Nda Elisha nyarî tà Iliya, kya bwal anda-rya mala nggun-rya mwashat mǝno, pa'girnkila nǝia. Paktúró nǝ agirtúró rya sǝ lam nyamia, sǝ pè aɓwana à shè. Pǝlǝa lo o atà Iliya, pǝlǝ muna-ɓala male.<figure style="fig" alt="Oxen of Elisha" file="11_1Kings19.19_OxPlowYoke.jpg" size="col" loc="19:21" copy="Gordon's Graphics" ref="19:19-21">Anda-rya mala Elisha</figure><verse eid="1KI 19:21" /></para>
  <chapter eid="1KI 19" />
  <chapter number="20" style="c" sid="1KI 20" />
  <para style="s1">Suriya munǝ arǝ Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 20:1" />Adyan ngga, Ben-Hadat murǝm Suriya ramba amǝ'lwa male kat abanɓwáná. Amurǝma lumi-tàrú-nong-ɓari na kam atè, andǝ apǝr andǝ awaru-pǝr. Eauwe wario kya gumbǝli Samariya, sǝ soa munǝo arǝì. <verse eid="1KI 20:1" /><verse number="2" style="v" sid="1KI 20:2" />Pǝlǝa Ben-Hadat tasǝ amǝ'na-túrbân aban Ahap murǝm Isǝrayila aɓa nggea-lê, ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Ben-Hadat bang ngga ama: <verse eid="1KI 20:2" /><verse number="3" style="v" sid="1KI 20:3" />&lt;Bolo-azǝrfa mô, andǝ bolo-njengǝlan mò ka à mema; sǝ amāmó amǝɓoarkinsari andǝ amunio ka, à mema.&gt; &gt;&gt;<verse eid="1KI 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 20:4" />Murǝm Isǝrayila eari wi ama, &lt;&lt;Kǝla mǝnana a bangŋi ka, ɓwamǝgule mem, we murǝm, mim sǝnǝ agir mǝnana kat mǝ ndanǝia ka, à mona.&gt;&gt;<verse eid="1KI 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 20:5" />Amǝ'na-túrbân nyar ɗǝm, sǝ à bang ama, &lt;&lt;Ben-Hadat na ama: &lt;Ən túròban nǝ cau nǝma wu pam bolo-azǝrfa mô, andǝ bolo-njengǝlan mò, andǝ amāmó, sǝ amunio. <verse eid="1KI 20:5" /><verse number="6" style="v" sid="1KI 20:6" />Sǝama liwi nǝ bu-pwari kǝla man ngga, mǝ nǝ tasǝ amǝ'túró-ɓala mem ɓǝà kya pelǝki ɓala mò andǝ aɓala mala aɓwana mô a là, sǝ agir mǝnana kat a earkiyicea ka, à nǝ̀ pwania arǝò, à nǝ̀ umnǝia.&gt; &gt;&gt;<verse eid="1KI 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 20:7" />Pǝlǝa murǝm Isǝrayila tunǝ aɓwana-mǝgule kat mala nzali Isǝrayila, sǝ banggia wia ama, &lt;&lt;Wu sǝni, man yì ɓwabura ka ndaban altacau, acemǝnana túrban ama mǝ pe wi amāmám, andǝ amunem, andǝ bolo-azǝrfa mem, andǝ bolo-njengǝlan mem, sǝ ǝn ɓinǝi wi ɗàng.&gt;&gt; <verse eid="1KI 20:7" /><verse number="8" style="v" sid="1KI 20:8" />Aɓwana-mǝgule kat andǝ aɓwana kat ne wi ama, &lt;&lt;Kǝa kwakikiro ko a ear cau male ɗàng.&gt;&gt;<verse eid="1KI 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 20:9" />Nda Ahap ne amǝ'na-túrbân mala Ben-Hadat ama, &lt;&lt;Wu banggi ɓwamǝgule mem, murǝm ama, &lt;Guro mò nǝ̀ pàk gìr mǝnana kat a alte a dǝmbe ka, sǝama mǝnia yì gir a kǝ alte nǝnzǝ́mò ka, pa mǝ nǝ gandǝnǝ pe ɗàng.&gt; &gt;&gt; Pǝlǝa amǝ'na-túrbân mala Ben-Hadat nyare, à kya ne wi cau mǝnana Ahap bang ngga. <verse eid="1KI 20:9" /><verse number="10" style="v" sid="1KI 20:10" />Ben-Hadat túrban ɓǝà ne wi ama, &lt;&lt;Ɓǝ̀ aɓakuli wal-luem, yi mǝnana ɓǝn warina amǝ'kpatam pas mǝnana à nǝ̀ kiɗiki Samariya raka. À nǝ̀ kiɗiki nggea-lê yale tú mala nzali Samariya ka pà nǝ̀ lùmsǝ ɓabuia ɗàng.&gt;&gt;<verse eid="1KI 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 20:11" />Sǝ murǝm mala Isǝrayila ear ama, &lt;&lt;Wu ne wi ama, &lt;Mǝ'lwa mǝɓoarne ka, kǝ nggori anzǝm mǝnana lina lwa ka. Mǝ'lwa mǝɓoarne ka, kǝ nggori a tita lwa ɗàng.&gt; &gt;&gt; <verse eid="1KI 20:11" /><verse number="12" style="v" sid="1KI 20:12" />Ben-Hadat ok man yì cau ka lang ndaban nukiagir andǝ amurǝma aɓalǝ agumli malea ka. Pǝlǝa ne aburana male ama, &lt;&lt;Wu gilǝ rǝ wun ace kánǝ munǝo.&gt;&gt; Nda koyanale ka twal bancame male ka.<verse eid="1KI 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 20:13" />Anggo ka, ɓè mǝɓangnǝa yiu aban Ahap murǝm mala Isǝrayila sǝ ne wi ama, &lt;&lt;Yahweh bang ama, a sǝn lakki mala amǝ'lwa man re? Sǝni, yalung ngga mǝ nǝ túrià a ɓabuo, sǝ awu nǝ̀ sǝlǝ ama mǝ nda Yahweh.&gt;&gt; <verse eid="1KI 20:13" /><verse number="14" style="v" sid="1KI 20:14" />Sǝ Ahap ɗiban ama, &lt;&lt;Nǝ bù yana, sǝ à nǝ̀ túrià a ɓabuam?&gt;&gt;</para>
  <para style="p" vid="1KI 20:14">Mǝɓangnǝa mǝno ne wi ama, &lt;&lt;Yahweh bang ama, nǝ bù alaggana mǝnana à nda aɓata anggwamna mala abu-nzali ka.&gt;&gt;</para>
  <para style="p" vid="1KI 20:14">Ahap nyare ɗiban ama, &lt;&lt;Yana nǝ̀ tita kánǝ munǝo?&gt;&gt;</para>
  <para style="p" vid="1KI 20:14">Pǝlǝa mǝɓangnǝa eari wi ama, &lt;&lt;A nda.&gt;&gt;<verse eid="1KI 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 20:15" />Pǝlǝa Ahap ramba alaggana mala anggwamna mala abu-nzali, yià gbǝman-ɓari nǝ lumi-tàrú-nong-ɓari (232). Nyar ɗǝm ngga, ramba amǝ'lwa mala Isǝrayila kat, yià á-tongno-nong-ɓari (7,000). <verse eid="1KI 20:15" /><verse number="16" style="v" sid="1KI 20:16" />À wari nǝ pwarizǝkya. Sǝ Ben-Hadat ka, nda aban nu-mba andǝ wal-wale aɓalǝ agumli, yì andǝ amurǝma lumi-tàrú-nong-ɓari mǝnana à yiu ace bwali wi ka. <verse eid="1KI 20:16" /><verse number="17" style="v" sid="1KI 20:17" />Alaggana mala anggwamna mala abu-nzali tita puro a dǝmba aban ká munǝo. Pǝlǝa Ben-Hadat tasǝ amǝ'shenzǝban, sǝ à yi ne wi ama, &lt;&lt;Aburana naban pur aɓa Samariya.&gt;&gt; <verse eid="1KI 20:17" /><verse number="18" style="v" sid="1KI 20:18" />Murǝm Ben-Hadat banggia wia ama, &lt;&lt;Wu bwalia wu yinǝia andǝamǝsǝia, ko ɓǝ̀ à yiu ace munǝo, ko ace alta dorǝpwala ka.&gt;&gt;<verse eid="1KI 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 20:19" />Nda alaggana mala anggwamna mala abu-nzali purî ɓá nggea-lê, sǝ amǝ'lwa kpatea. <verse eid="1KI 20:19" /><verse number="20" style="v" sid="1KI 20:20" />Koyanale ka wal-lú ɓimǝbura. Amǝ'Suriya ɓangŋa, sǝ amǝ'Isǝrayila pǝrtea. Sǝama Ben-Hadat murǝm Suriya ɓangŋa auwa a nzǝm pǝr atārǝia andǝ aɓea amǝ'pǝ̀r male. <verse eid="1KI 20:20" /><verse number="21" style="v" sid="1KI 20:21" />Pǝlǝa murǝm Isǝrayila puro wario kya pwan apǝr andǝ awaru-pǝr, sǝ wal amǝ'Suriya nǝ walban mǝgule.<verse eid="1KI 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1KI 20:22" />Pǝlǝa mǝɓangnǝe yiu aban murǝm Isǝrayila, sǝ banggi wi ama, &lt;&lt;Kyane, candǝ rǝo sǝ wu gilǝ rǝo amur gir mǝnana ɓoaro wu pe ka, acemǝnana nǝ kún gbangŋan mala pǝlǝa mǝnana kǝ yiu ka, murǝm Suriya na nǝ̀ nyare nǝ̀ yipa wun nǝ munǝo ka.&gt;&gt;<verse eid="1KI 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1KI 20:23" />Pǝlǝa amǝgulo mala murǝm Suriya ne Ben-Hadat ama, &lt;&lt;Aɓakuli malea ka, aɓakuli mala mgbangban na, nda gìr mǝnana tsǝa sǝ à gandǝ sǝm ngga. Sǝama ɓǝ̀ sǝm munǝ arǝia a dulum ngga, ɓafo sǝm nǝ̀ gandǝia. <verse eid="1KI 20:23" /><verse number="24" style="v" sid="1KI 20:24" />Ado ka, pàk gìr mǝnia ka: Pusǝ amurǝma a bancame malea, sǝ wu nggaɗia nǝ amǝ'sàrǝ̀ban, <verse eid="1KI 20:24" /><verse number="25" style="v" sid="1KI 20:25" />sǝ wu ram amǝ'lwa andǝ apǝr, andǝ awaru-pǝr mǝnana lakki malea na kǝla mǝnana a dǝmbe ka. Pǝlǝa sǝm nǝ̀ arǝia a dulum, anggo ka sǝ sǝm nǝ̀ gandǝia.&gt;&gt; Ben-Hadat kwakikiri arǝ cau malea, sǝ pè anggo.<verse eid="1KI 20:25" /></para>
  <para style="s">Ahap gandǝ Ben-Hadat ɗǝm</para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 20:26" />Lang ɓè pǝlǝa yi karna ka, Ben-Hadat ramba amǝ'lwa male, sǝ à eauwe à wari a Afek ace munǝ arǝ amǝ'Isǝrayila. <verse eid="1KI 20:26" /><verse number="27" style="v" sid="1KI 20:27" />Sǝ amǝ'Isǝrayila ka, à ramǝna sǝ à pania wia agir-munǝo mǝnana à nǝ̀ munǝ nǝia arǝ amǝ'Suriya ka. Pǝlǝa à wario à kya tsǝk kàttì malea aɓadǝmba amǝ'Suriya kǝla amuna domwan ɓari mala ambul, sǝ amǝ'Suriya ka, à lumsǝ patal. <verse eid="1KI 20:27" /><verse number="28" style="v" sid="1KI 20:28" />Sǝ ɓè ɓwa mala Ɓakuli yiu aban murǝm mala Isǝrayila, sǝ banggi wi ama, &lt;&lt;Yahweh na ama, &lt;Acemǝnana amǝ'Suriya nana ama, &lt;&lt;Yahweh ka ɓakuli mala amgbangban na, yì ka ɓakuli mala adulum na raka,&gt;&gt; acemani ka mǝ nǝ pa amǝ'lwa mǝlake man a ɓabuo, sǝ awu nǝ sǝlǝ ama mǝ nda Yahweh.&gt; &gt;&gt;<verse eid="1KI 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 20:29" />Amǝ'lwa mǝnia kǝm ngga, à tsǝk akattì malea nkāɓe nǝ rǝarǝia. Pǝlǝa a tongno-nong-ɓaria pwari ka, à je munǝo. Amǝ'Isǝrayila wal-lú asoje-kusǝu mala amǝ'Suriya á-gbǝman mwashat (100,000) a pwari mwashat. <verse eid="1KI 20:29" /><verse number="30" style="v" sid="1KI 20:30" />Sǝ acili amǝ'Suriya ka, à ɓangŋa aban kutikio aɓa nggea-là Afek, sǝ sheran kpa amúr aburana á-lumi-ɓari-bwamdǝ-tongno-nong-ɓari (27,000) mǝnana à ue ka.</para>
  <para style="p" vid="1KI 20:30">Ben-Hadat gbal ka, ɓangŋa kútí aɓa ɓè kurǝm-ɓaɓalǝu mala nggea-lê. <verse eid="1KI 20:30" /><verse number="31" style="v" sid="1KI 20:31" />Pǝlǝa amǝgulo mala Ben-Hadat yiu abaní sǝ à ne wi ama, &lt;&lt;Sǝni, adyan ngga sǝm ongŋǝna ama amurǝma mala ɓala Isǝrayila ka, amǝ'sǝn-mǝsǝswatǝr na. Ɓǝ̀ sǝm kùrki <note caller="+" style="f"><char style="fr" closed="false">20:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 3:31">2Sam 3:31</ref></char>.</note> anggubyau-bumkiɗikea<note caller="+" style="f"><char style="fr" closed="false">20:31 </char><char style="fq" closed="false">anggubyau-bumkiɗikea </char><char style="ft" closed="false">ko &lt;&lt;asanginagìr&gt;&gt;</char></note> a taɓunǝ sǝm, sǝ ɓǝ̀ sǝm ɗúrki anggur arǝ amyal sǝm, sǝ ɓǝ̀ sǝm kya aban murǝm mala Isǝrayila earka nǝ̀ nying sǝm nǝyilǝmu.&gt;&gt; <verse eid="1KI 20:31" /><verse number="32" style="v" sid="1KI 20:32" />Nda à kùrki anggubyau-bumkiɗikea a taɓunia, sǝ à ɗúrki anggur a myalia, sǝ à wari aban murǝm Isǝrayila, à kya ne wi ama, &lt;&lt;Guro mò Ben-Hadat bang ama, &lt;Ida, nyem nǝyilǝmu.&gt; &gt;&gt; Sǝ murǝm Isǝrayila ɗia ama, &lt;&lt;Nda nǝyilǝmu piu le? Yì ka mǝ'eambǝam na.&gt;&gt;<verse eid="1KI 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1KI 20:33" />Adyan ngga, aburane na aban alte à nǝ̀ ok cau mǝno. Pǝlǝa à ear akaurǝa, à na ama, &lt;&lt;E, mǝ'eambǝo Ben-Hadat nda nǝyilǝmu.&gt;&gt; Osso Ahap banggia wia ama, &lt;&lt;Wu kyane wu yinǝi.&gt;&gt; Lang Ben-Hadat yina ka, Ahap tsǝì eau atè aɓa waru-pǝr male.<verse eid="1KI 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 20:34" />Ben-Hadat banggi Ahap ama, &lt;&lt;Mǝ nǝ nyesǝô <note caller="+" style="f"><char style="fr" closed="false">20:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 15:20">15:20</ref></char>.</note>anggea-là mǝnana tárrám ea arǝ tárró ka. Sǝ awu nǝ gandǝ tsǝk alimo a Damaska, kǝla mǝnana tárrám pè a Samariya ka.&gt;&gt; Ahap ne Ben-Hadat ama, &lt;&lt;Mǝ nǝ nyio wu o, kǝla mǝnana sǝm ear amur man yì cau ka.&gt;&gt; Nda à kùrcau andǝi, sǝ nyì u ka.<verse eid="1KI 20:34" /></para>
  <para style="s">Ɓè mǝɓangnǝa ɓǝsǝki gìr mǝnana Ahap pè ka</para>
  <para style="p">
    <verse number="35" style="v" sid="1KI 20:35" />Yahweh banggi ɓeɓwa aɓa nggǝsan mala amǝ'ɓangnǝa ama ɓǝ̀ ne ɓi ama, &lt;&lt;Ida, tùlam.&gt;&gt; Sǝama ɓwê ɓinǝ<note caller="+" style="f"><char style="fr" closed="false">20:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 2:3">2Amur 2:3</ref>; <ref loc="2KI 5">5</ref>; <ref loc="2KI 7">7</ref>; <ref loc="2KI 15">15</ref></char>.</note> tùle. <verse eid="1KI 20:35" /><verse number="36" style="v" sid="1KI 20:36" />Pǝlǝa banggi wi ama, &lt;&lt;Acemǝnana a kpata gi Yahweh raka, lang awu nǝ nying banam ani ka, im nǝ̀ wal-luio.&gt;&gt; Anzǝm mǝnana ɓwabure umǝna ka, kya je andǝ im, sǝ imnì wal-luí. <verse eid="1KI 20:36" /><verse number="37" style="v" sid="1KI 20:37" />Pǝlǝa mǝɓangnǝe kum ɓè ɓwabura, sǝ ne wi ama, &lt;&lt;Ida, tùlam.&gt;&gt; Sǝ ɓwabure tùllì, tsǝki wi npenye. <verse eid="1KI 20:37" /><verse number="38" style="v" sid="1KI 20:38" />Nda mǝɓangnǝe <note caller="+" style="f"><char style="fr" closed="false">20:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 28:8">1Sam 28:8</ref></char>.</note>ɓosǝki rǝi marǝki bugir a ɓamǝsǝi, sǝ wario kya do a gírí njargula ace kundǝ kutio mala murǝm. <verse eid="1KI 20:38" /><verse number="39" style="v" sid="1KI 20:39" />Lang murǝm naban kútí ka, mǝɓangnǝa man tunǝi sǝ banggi wi ama, &lt;&lt;Mim guro mò ka, ǝn purna mǝ nǝ ká aɓa tsùrú mala munǝo ka, kara ɓè mǝ'lwa wulio sǝ yinǝ ɓè ɓwabura abanam sǝ nam ama, &lt;Yál ɓwabura mǝnia ka; ɓǝ̀ ɓwar ka, nda a kún yilǝmo, sǝ ana raka, awu nǝ mbwe mǝsǝ bolo-azǝrfa á-tàrú.&gt; <verse eid="1KI 20:39" /><verse number="40" style="v" sid="1KI 20:40" />Sǝ lang guro mò naban pakki agir kaní sǝ akanó ka, kara ɓwabure ɓwaro o.&gt;&gt;</para>
  <para style="p" vid="1KI 20:40">Pǝlǝa murǝm ne wi ama, &lt;&lt;Anggo sǝ ɓashi mò nǝ̀ pa; we nǝ nggearǝo ka, a kasǝna ɓashi.&gt;&gt;<verse eid="1KI 20:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 20:41" />Pǝlǝa mǝɓangnǝa man panzǝki bugir mǝnana marǝkina ɓamǝsǝi nǝi ka tsuk-tsuk, sǝ murǝm mala Isǝrayila súrǝì ama yì ka mwashat na aɓalǝ amǝ'ɓangnǝa.<verse eid="1KI 20:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1KI 20:42" />Mǝɓangnǝe banggi wi ama, &lt;&lt;Yahweh na ama, &lt;A nyingŋǝna ɓwa mǝnana ǝn tàrni ace kiɗike ka umǝna. Acemani ka, nǝ yilǝmo sǝ awu nǝ mbwe a kúnì yilǝmi, sǝ nǝ ayilǝmi aɓwana mô sǝ à nǝ̀ mbwe a kúnì ayilǝmi aɓwana male.&gt; &gt;&gt; <verse eid="1KI 20:42" /><verse number="43" style="v" sid="1KI 20:43" />Murǝm Isǝrayila nyar a ɓala-murǝm male a Samariya nǝ bumkiɗikea andǝ bumlulla.<verse eid="1KI 20:43" /></para>
  <chapter eid="1KI 20" />
  <chapter number="21" style="c" sid="1KI 21" />
  <para style="s1">Jezebel wal-lú Nabot ace ɓaban-anap male</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 21:1" />Adyan ngga, Nabot ɓwa'Jezǝril ka ndanǝ ɓaban-anap a Jezǝril, a nkanggari ɓala mala Ahap murǝm Samariya. <verse eid="1KI 21:1" /><verse number="2" style="v" sid="1KI 21:2" />A ɓè pwari ka, Ahap ne Nabot ama, &lt;&lt;Pam ɓaban-anap mô, mǝ rik agir mbú kàm, acemǝnana ɓabanì na tù nǝban ɓala mem, sǝ mǝ nǝ po ɓè ɓaban-anap mǝnana kútì mǝno ka a kúnì. Sǝ ɓǝ̀ a kǝ earce ka, mǝ nǝ po boalo mǝnana karǝ arǝ gulo mala nzalî ka.&gt;&gt;<verse eid="1KI 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1KI 21:3" />Sǝ Nabot nyesǝi Ahap cau ama, &lt;&lt;Ɓǝ̀ Yahweh twalbani mǝnana mǝ po nzali liɓala mala akâ ka.&gt;&gt; <verse eid="1KI 21:3" /><verse number="4" style="v" sid="1KI 21:4" />Nda Ahap nyar a ɓala male nǝ bumkiɗikea andǝ bumlulla ace cau mǝnana Nabot ɓwa Jezǝril banggi wi ka, acemǝnana Nabot nani wi ama, &lt;&lt;Pa mǝ nǝ po nzali liɓala mala akâ ɗàng.&gt;&gt; Nda Ahap nongŋo amur gyangŋan-nongŋo male, pǝlǝ mǝsǝi nǝ rǝ kurǝm, sǝ ɓinǝ li girlina.<verse eid="1KI 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 21:5" />Sǝama māmí Jezebel yiu abaní, sǝ ɗì ama, &lt;&lt;Palang sǝ banɓikio anggo, sǝ a ɓinǝ ligirlina?&gt;&gt; <verse eid="1KI 21:5" /><verse number="6" style="v" sid="1KI 21:6" />Ahap eari māmí ama, &lt;&lt;Nda acemǝnana ǝn banggi Nabot ɓwa'Jezǝril ama, &lt;Makkam ɓaban-anap mô, ko ɓǝ̀ a kǝ earce ka, mǝ nǝ po ɓè ɓaban-anap a kúnì.&gt; Sǝ yì ka banggam ama, &lt;Pa mǝ nǝ po ɓaban-anap mem&gt; ɗàng.&gt;&gt;<verse eid="1KI 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 21:7" />Sǝ māmí Jezebel ne wi ama, &lt;&lt;A nda murǝm Isǝrayila re? Lo ligirlina, sǝ ɓǝ̀ banɓoaro. Mǝ nǝ po ɓaban-anap mala Nabot ɓwa'Jezǝril.&gt;&gt;<verse eid="1KI 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 21:8" />Nda Jezebel gilǝ acautera nǝ lullǝ Ahap, sǝ tsǝk gbalmo parbu mala Ahap amur acautera nì, sǝ tasǝia aban aɓwana-mǝgule andǝ amǝgulo mǝnana à ndanǝdo a nggea-là mǝnana Nabot nakam ngga. <verse eid="1KI 21:8" /><verse number="9" style="v" sid="1KI 21:9" />Sǝ gilǝ aɓalǝ acautera nì ama, &lt;&lt;Wu tsǝk pwari gilmur, sǝ wu tunǝ kpapi mala aɓwana abanɓwáná. Wu pe Nabot bando aɓadǝmba aɓwe. <verse eid="1KI 21:9" /><verse number="10" style="v" sid="1KI 21:10" />Wu tsǝk <note caller="+" style="f"><char style="fr" closed="false">21:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 13:13">Nggur 13:13</ref></char>.</note>amǝ'ɓealɓana ɓari a nkāɓe mala Nabot, sǝ ɓǝà tsǝki wi cau arǝì, ama, &lt;A na mǝɓane<note caller="+" style="f"><char style="fr" closed="false">21:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 22:28">Pur 22:28</ref>; <ref loc="LEV 24:16">Pǝris 24:16</ref></char>.</note> amur Ɓakuli andǝ murǝm.&gt; Sǝ wu pusǝì, wu kya ɓukki nǝ atali ɓǝ̀ wǔ.&gt;&gt;<verse eid="1KI 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 21:11" />Sǝ aburana mala nggea-là Jezǝril, yià aɓwana-mǝgule andǝ amǝgulo mǝnana à ndanǝdo a nggea-là mala Nabot ka, à pǎ kǝla mǝnana Jezebel gilǝia wia ka. Kǝla mǝnana à gilǝì aɓalǝ acautera mǝnana tasǝia wia ka, <verse eid="1KI 21:11" /><verse number="12" style="v" sid="1KI 21:12" />à tunǝ gilmur, sǝ à tsǝk Nabot aɓadǝmba aɓwe. <verse eid="1KI 21:12" /><verse number="13" style="v" sid="1KI 21:13" />Pǝlǝa amǝ'ɓealɓana ɓari yi do a nkāɓe Nabot. Amǝ'ɓealɓana mǝno yinǝ cau amurì a ɓadǝmba aɓwana, à bang ama, &lt;&lt;Nabot na mǝɓane amur Ɓakuli andǝ murǝm.&gt;&gt; Nda à pusǝì a nzǝm nggea-lê, sǝ à ɓukki nǝ atali wǔ ka. <verse eid="1KI 21:13" /><verse number="14" style="v" sid="1KI 21:14" />Pǝlǝa à tasǝî Jezebel cau ama, &lt;&lt;Nabot ka à ɓukkinì nǝ atali, wuna.&gt;&gt;<verse eid="1KI 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 21:15" />Lang Jezebel ongŋǝna ama à ɓukkina Nabot nǝ atali sǝ wuna ka, Jezebel ne Ahap ama, &lt;&lt;Lo, kyane ak girkuma mala ɓaban-anap mala Nabot ɓwa'Jezǝril mǝnana ginǝ po a kúnì boalo ka, acemǝnana Nabot pà kàm nǝyilǝmu ɗǝm ɗàng, wuna.&gt;&gt; <verse eid="1KI 21:15" /><verse number="16" style="v" sid="1KI 21:16" />Lang Ahap ongŋǝna ama Nabot wuna ka, Ahap pǝlǝa lo sulǝ aban ká a ɓaban-anap mala Nabot ɓwa'Jezǝril, ace ak girkuma mala Nabot.<verse eid="1KI 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1KI 21:17" />Pǝlǝa cau mala Yahweh yiu aban Iliya ɓwa'Tishbe, ama, <verse eid="1KI 21:17" /><verse number="18" style="v" sid="1KI 21:18" />&lt;&lt;Lo, sulǝo kyane, kya kum Ahap murǝm Isǝrayila, mǝnana nda a Samariya ka; sǝni, yì ka, nda a ɓaban-anap mala Nabot, ban mǝnana wari ace ak girkuma mala Nabot ka. <verse eid="1KI 21:18" /><verse number="19" style="v" sid="1KI 21:19" />Awu nǝ banggi wi ama, &lt;A walna ɓwa, sǝ a angŋǝna girkuma male?&gt; Sǝ awu nǝ ne wi ama, Yahweh bang ama, &lt;A ban mǝnana anva lenzǝki nkila Nabot ka, akǝ̀ banì sǝ anva nǝ̀ lenzǝki nkilio.&gt; &gt;&gt;<verse eid="1KI 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1KI 21:20" />Lang Ahap sǝn Iliya ka, ɗì ama, &lt;&lt;A kumǝnam le, we ɓiamǝbura?&gt;&gt; Iliya eari wi ama, &lt;&lt;Ən kumǝno, acemǝnana a pana ɓamurò aban pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka. <verse eid="1KI 21:20" /><verse number="21" style="v" sid="1KI 21:21" />Sǝni, Yahweh bang ama, &lt;Mǝ nǝ yinǝ gìr'mur'mwana amuro, sǝ mǝ nǝ kiɗikio kat-kat. Mǝ nǝ wal-luio, sǝ Mǝ nǝ wal-lú koya muna-ɓwabura mô mǝnana guro na andǝ mǝnana guro na raka a Isǝrayila. <verse eid="1KI 21:21" /><verse number="22" style="v" sid="1KI 21:22" />Mǝ nǝ tsǝk ɓala mò ɓǝ̀ pa kǝla ɓala mala Jerobuam muna-ɓwabura mala Nebat, sǝ kǝla ɓala mala Ba'asha muna-ɓwabura mala Ahija, acemǝnana a lulbumam, sǝ a tsǝ́ngŋǝ̀nà Isǝrayila pàngŋǝ̀nà cauɓikea. <verse eid="1KI 21:22" /><verse number="23" style="v" sid="1KI 21:23" />Sǝ amur Jezebel ka, anva nǝ̀ shak nyami a bân sheran mala Jezǝril.<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="fq" closed="false">a bân sheran mala Jezǝril </char><char style="ft" closed="false">Cau mǝnia nǝ kún Ibǝru ka, à bwalte ɗàng.</char></note> <note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2KI 9:10">2Amur 9:10</ref>,<ref loc="2KI 9:30-37">30-37</ref></char>.</note> <verse eid="1KI 21:23" /><verse number="24" style="v" sid="1KI 21:24" />Koyaɓwa a ɓala mala Ahap mǝnana nǝ̀ wù aɓa nggea-là ka, anva nǝ̀ shak ɓwe, sǝ koyaɓwa mǝnana wù a ɓabondo ka, anyal mǝnana a bumkuli ka nǝ̀ li ɓwê.&gt; &gt;&gt;<verse eid="1KI 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 21:25" />(Ɓè kǝɓwa pà kàm mǝnana pa ɓamurì arǝ pak ɓealɓikea a mǝsǝ Yahweh kǝla Ahap, mǝnana Jezebel soakite ka ɗàng. <verse eid="1KI 21:25" /><verse number="26" style="v" sid="1KI 21:26" />Ahap pàkki agir mǝɓike kǝ̀rkǝ́r. Peri aban ɓǝ̀nzál, kǝla mǝnana amǝ'Amor kǝ pàk ka, yià mǝnana Yahweh pǝria aɓadǝm amǝ'Isǝrayila ka.)<verse eid="1KI 21:26" /></para>
  <para style="s1">Pwanzali mala Ahap</para>
  <para style="p">
    <verse number="27" style="v" sid="1KI 21:27" />Lang Ahap ok acau man a kún Iliya ka, san daura male sǝ túr nggubyau-bumkiɗikea<note caller="+" style="f"><char style="fr" closed="false">21:27 </char><char style="fq" closed="false">nggubyau-bumkiɗikea </char><char style="ft" closed="false">ko &lt;&lt;asanginagìr&gt;&gt;</char></note> arǝì, sǝ gilmur, do aɓa bumkiɗikea sǝ kǝ ging ɓukɓuk.<verse eid="1KI 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 21:28" />Sǝ cau mala Yahweh yiu aban Iliya ɓwa'Tishbe, ama, <verse eid="1KI 21:28" /><verse number="29" style="v" sid="1KI 21:29" />&lt;&lt;A sǝnǝna ulang nongsǝmúrû mǝnana Ahap nongsǝi aɓadǝmbam ngga? Acemǝnana nongsǝmúrì aɓadǝmbam ngga, pa mǝ nǝ yinǝ gìr'mur'mwana a ɓàkú male ɗàng; <note caller="+" style="f"><char style="fr" closed="false">21:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 9:25">2Amur 9:25</ref></char>.</note>sǝama mǝ nǝ yinǝ gìr'mur'mwana amur ɓala male, a ɓàkú mala muna-ɓwabura male.&gt;&gt;<verse eid="1KI 21:29" /></para>
  <chapter eid="1KI 21" />
  <chapter number="22" style="c" sid="1KI 22" />
  <para style="s1">Ahap andǝ amǝ'ɓangnǝa mǝ'nyirì</para>
  <para style="r">(<ref loc="2CH 18:2-27">2 Acau la Apwari 18:2-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="1KI 22:1" />À pàk apǝlǝa tàrú, munǝo pa kàm anre Suriya andǝ Isǝrayila ɗàng. <verse eid="1KI 22:1" /><verse number="2" style="v" sid="1KI 22:2" />Sǝama a tàruià pǝlǝê ka, Jehoshafat murǝm Yahuda wari a sǝn murǝm Isǝrayila. <verse eid="1KI 22:2" /><verse number="3" style="v" sid="1KI 22:3" />Sǝ Ahap murǝm Isǝrayila ne amǝ'tè ama, &lt;&lt;Wu sǝlǝ ama Ramot Gilǝyat ka nzali ma'sǝma, sǝ sǝm duk kún sǝm ɗǝong, sǝm é a ɓabù murǝm Suriya ɗàng?&gt;&gt;<verse eid="1KI 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1KI 22:4" />Sǝ Ahap ɗì Jehoshafat ama, &lt;&lt;Awu nǝ̀ ká atam aban munǝo a Ramot Gilǝyat le?&gt;&gt; Sǝ Jehoshafat eari wi ama, &lt;&lt;Mim sǝnǝ we ka, sǝm nda mwashat, aɓwana mem ngga à nda mwashat andǝ aɓwana mô, sǝ apǝr mem ngga apǝr mò na.&gt;&gt;<verse eid="1KI 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1KI 22:5" />Sǝama Jehoshafat banggi murǝm Isǝrayila ama, &lt;&lt;Ɗìbancau peatu amur mana Yahweh nâ.&gt;&gt;<verse eid="1KI 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1KI 22:6" />Pǝlǝa murǝm Isǝrayila ramba amǝ'ɓangnǝa abanɓwáná, kǝla aɓwana gbǝman ine, sǝ ɗia ama, &lt;&lt;Mǝ kyan nǝ munǝo arǝ Ramot Gilǝyat le, ko mǝ nggá ká ɗàng?&gt;&gt;</para>
  <para style="p" vid="1KI 22:6">Sǝ à eari wi ama, &lt;&lt;Kyane, acemǝnana Yahweh nǝ̀ pa nggea-lê a ɓabù murǝm.&gt;&gt;<verse eid="1KI 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1KI 22:7" />Sǝama Jehoshafat ɗìban ama, &lt;&lt;Kǝ ɓè mǝɓangnǝa mala Yahweh pà kàm akani mǝnana sǝm nǝ̀ ɗìbancau nǝbani ka re?&gt;&gt;<verse eid="1KI 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1KI 22:8" />Sǝ murǝm Isǝrayila ne wi ama, &lt;&lt;Ɓè ɓwa nakam mwashat mǝnana sǝm nǝ̀ gandǝnǝ ɗìbancau aban Yahweh nǝbani ka. Ɓwe nda Mikaya muna-ɓwabura mala Imla, sǝama ǝn nggǝ earce ɗàng, acemǝnana kǝ ɓangnǝ-ɓangnǝa mǝɓoarne amuram ɗàng, she mǝɓike.&gt;&gt;</para>
  <para style="p" vid="1KI 22:8">Sǝ Jehoshafat bang ama, &lt;&lt;Murǝm, kǝa nacau anggo ɗang.&gt;&gt;<verse eid="1KI 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1KI 22:9" />Pǝlǝa murǝm tunǝ ɓè mǝgulo male, sǝ ne wi ama, &lt;&lt;Yinǝàm nǝ Mikaya muna-ɓwabura mala Imla akaurǝa.&gt;&gt;<verse eid="1KI 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1KI 22:10" />Adyan ngga, Murǝm Isǝrayila andǝ Jehoshafat murǝm Yahuda ka, à ndaban dumnǝdo amur abuno-murǝm aɓalǝ adaura-murǝm malea, a ban katǝra a kún bankutio mala Samariya, sǝ amǝ'ɓangnǝa kat kǝ ɓangnǝ-ɓangnǝa aɓadǝmbǝia.<verse eid="1KI 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1KI 22:11" />Sǝ Zedekiya muna-ɓwabura mala Kena'ana pakkî ɓamurì njawe bolo-candǝa, sǝ na ama, &lt;&lt;Yahweh bang ama, &lt;Nǝ mǝnia ka, sǝ a awu nǝ tulki amǝ'Suriya she ɓǝà kiɗikina ka.&gt; &gt;&gt;<verse eid="1KI 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1KI 22:12" />Sǝ amǝ'ɓangnǝa kat ka, à ɓangnǝ-ɓangnǝa anggo, sǝ à bang ama, &lt;&lt;Kya munǝ arǝ Ramot Gilǝyat, awu nǝ̀ limurǝm; Yahweh nǝ̀ pa nggea-lê a ɓabù murǝm.&gt;&gt;<verse eid="1KI 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1KI 22:13" />Sǝ mǝ'na-túrbân mǝnana wari a tunǝ Mikaya ka, banggi wi ama, &lt;&lt;Sǝni, acau mala amǝ'ɓangnǝa ka, amǝ'mwashati na, sǝ acau mǝɓoarne na aban murǝm. Ɓǝ̀ cau mò yiu mwashat kǝla malea, sǝ wu nacau mǝɓoarne.&gt;&gt; <verse eid="1KI 22:13" /><verse number="14" style="v" sid="1KI 22:14" />Sǝama Mikaya bang ama, &lt;&lt;Ən kanbo nǝ yilǝmi Yahweh Ɓakuli mô, cau mǝnana Yahweh nǝ̀ nam ngga, kǝ cê na mǝ nǝ bang ngga.&gt;&gt;<verse eid="1KI 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1KI 22:15" />Sǝ lang Mikaya yina aban murǝm ngga, murǝm Ahap ɗi ama, &lt;&lt;Mikaya, ɓǝ̀ sǝm kya munǝo arǝ Ramot Gilǝyat le ko ɓǝ̀ sǝm nggá ká ɗàng?&gt;&gt; Mikaya eari wi ama, &lt;&lt;Kya arǝia, awu nǝ̀ limurǝm; sǝ Yahweh nǝ̀ po nggea-lê a ɓabuo.&gt;&gt;<verse eid="1KI 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1KI 22:16" />Sǝ murǝm Ahap ne wi ama, &lt;&lt;Kusǝ shen sǝ mǝ nǝ tsǝo wu kángìr nǝ lullǝ Yahweh ama wu kǝa nam kǝcau ɗàng she kǝ mǝsǝcau?&gt;&gt; <verse eid="1KI 22:16" /><verse number="17" style="v" sid="1KI 22:17" />Pǝlǝa Mikaya ne wi ama, &lt;&lt;Ən sǝn Isǝrayila kat mǝsǝe amur ankono, kǝla anzur mǝnana à pànǝ yalu raka. Sǝ Yahweh bang ama, &lt;Amǝnia ka à pànǝ yalu ɗàng; koyanale ka ɓǝ̀ nyar a ɓala male aɓa rǝpwala.&gt; &gt;&gt;<verse eid="1KI 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1KI 22:18" />Murǝm Isǝrayila banggi Jehoshafat ama, &lt;&lt;Ən banggo mǝni nǝma Mikaya pà nǝ̀ ɓangnǝ-ɓangnǝa mǝɓoarne amuram ɗàng, she mǝɓane re?&gt;&gt;<verse eid="1KI 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1KI 22:19" />Mikaya lidǝmba nǝ nacau ama, &lt;&lt;Acemani ka, ok cau mala Yahweh: <note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 6:1">Isha 6:1</ref>; <ref loc="DAN 7:9">Dan 7:9</ref>; <ref loc="REV 4:2">Sǝn 4:2</ref></char>.</note>Ən sǝn Yahweh aban do amur buno-murǝm male, andǝ abangŋo mǝnana kat a kuli ka aban came a nkanggari a bui-mǝli andǝ bui-mǝnggare; <verse eid="1KI 22:19" /><verse number="20" style="v" sid="1KI 22:20" />sǝ Yahweh bang ama, &lt;Yana nǝ̀ swár Ahap acemǝnana ɓǝ̀ kya kpa a Ramot Gilǝyat ka?&gt; Sǝ koyanale ka nacau a sǝne male. <verse eid="1KI 22:20" /><verse number="21" style="v" sid="1KI 22:21" />Pǝlǝa ɓè bangŋo puro yi cam aɓadǝm Yahweh, sǝ na ama, &lt;Mǝ nǝ swárí.&gt; <verse eid="1KI 22:21" /><verse number="22" style="v" sid="1KI 22:22" />Sǝ Yahweh ɗì ama, &lt;Nǝ ya njar sǝ awu nǝ̀ swárí?&gt; Sǝ bangŋonì ear ama, &lt;Mǝ ne nggá pǝlǝ bangŋo mǝ'nyirì a kún amǝ'ɓangnǝa male kat.&gt; Sǝ Yahweh ne wi ama, &lt;Kya swárí, awu nǝ̀ limurǝm. Puro kya pa anggo.&gt; <verse eid="1KI 22:22" /><verse number="23" style="v" sid="1KI 22:23" />Ado ka, sǝni Yahweh tsǝ̀ngŋǝ́nà bangŋo mala nyir a kún amǝ'ɓangnǝa man kat, sǝ Yahweh nana ama gìr'mur'mwana nǝ̀ kumǒ.&gt;&gt;<verse eid="1KI 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1KI 22:24" />Pǝlǝa Zedekiya muna-ɓwabura mala Kena'ana sung tù aban Mikaya, koè a takiri, sǝ ɗì ama, &lt;&lt;Lang sǝ bangŋo mala Yahweh nǝ̀ purî rǝam, sǝ nǝ̀ nacau nǝ we?&gt;&gt;<verse eid="1KI 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1KI 22:25" />Sǝ Mikaya eari wi ama, &lt;&lt;Awu nǝ̀ sǝni a pwari mǝno a kutina aɓa kurǝm ɓalǝu ace sǝmbǝrǝ ɓamúrò ka.&gt;&gt;<verse eid="1KI 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1KI 22:26" />Pǝlǝa murǝm Isǝrayila bang ama, &lt;&lt;Wu bwal Mikaya wu nyesǝi aban Amon yì nggwamna mala nggea-lê, sǝ aban Johash muna-ɓwabura mala murǝm, <verse eid="1KI 22:26" /><verse number="27" style="v" sid="1KI 22:27" />sǝ wu nea wia ama, &lt;Mǝnia ka nda cau mǝnana murǝm bang ngga: Wu tsǝk mǝnia yi ɓwa ka a ndàkurban, sǝ wu kǝa pe wi kǝgir ɗàng she bǝredi andǝ mùr, bà pwari mǝnana mǝ nǝ nyar nǝi jam ngga.&gt; &gt;&gt;<verse eid="1KI 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1KI 22:28" />Mikaya bang ama, &lt;&lt;Ɓǝ̀ a nyar jam ngga, Yahweh nacau nǝ mim ɗang.&gt;&gt; Mikaya nyare na ɗǝm ama, &lt;&lt;Koyan ngga, ɓǝ̀ okcau mǝnana ǝn bang ngga!&gt;&gt;<verse eid="1KI 22:28" /></para>
  <para style="s1">Munǝo andǝ lú mala Ahap</para>
  <para style="r">(<ref loc="2CH 18:28-34">2 Acau la Apwari 18:28-34</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="1KI 22:29" />Nda Ahap murǝm Isǝrayila andǝ Jehoshafat murǝm Yahuda eauwe, à wari a Ramot Gilǝyat. <verse eid="1KI 22:29" /><verse number="30" style="v" sid="1KI 22:30" />Sǝ murǝm Isǝrayila ne Jehoshafat ama, &lt;&lt;Mǝ nǝ ɓosǝki rǝam mǝ nǝ ká a kún munǝo, sǝama we ka oasǝ adaura-murǝm mo.&gt;&gt; Pǝlǝa murǝm Isǝrayila ɓosǝki rǝi, sǝ wari a kún munǝo.<verse eid="1KI 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1KI 22:31" />Adyan ngga, murǝm Suriya nani amǝ'sàrǝ̀ban mala awaru-pǝr male lumi-tàrú-nong-ɓari ama, &lt;&lt;Wu kǝa munǝo arǝ kǝɓwa ɗang, ko ɓwamǝgule ko ɓwamǝkyauwe, she murǝm Isǝrayila nǝmurǝì.&gt;&gt; <verse eid="1KI 22:31" /><verse number="32" style="v" sid="1KI 22:32" />Sǝ lang amǝ'sàrǝ̀ban mala murǝm Suriya sǝn Jehoshafat ka, à bang ama, &lt;&lt;Ɓafo murǝm Isǝrayila na.&gt;&gt; Nda à pǝlǝa arǝì nǝ munǝo, sǝ Jehoshafat mak-zwalo. <verse eid="1KI 22:32" /><verse number="33" style="v" sid="1KI 22:33" />Sǝ lang amǝ'sàrǝ̀ban mala awaru-pǝr sǝni ama murǝm Isǝrayila na raka, à pǝlǝ nzǝmia arǝ pǝrte.<verse eid="1KI 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1KI 22:34" />Sǝama ɓeɓwa nun mundi male, sǝ túrí ɓà, kara ta murǝm Isǝrayila anre ban mǝnana kún adaura-bolo male kpapi kam ngga. Acemani ka, Ahap banggi mǝkwak waru-pǝr male ama, &lt;&lt;Pǝlǝá, sǝ wu pusǝam aɓa munǝo, acemǝnana à tsǝgŋǝ́nàm npenye.&gt;&gt; <verse eid="1KI 22:34" /><verse number="35" style="v" sid="1KI 22:35" />Munǝo lidǝmba a pwari mǝno, sǝ murǝm Isǝrayila eangnǝ arǝ waru-pǝr sǝ ɓamǝsǝi pǝlǝ nǝ ban amǝ'Suriya, ba lú male nǝ pwarikpǝra. Sǝ nkila mala npenye male solǝ arǝ waru-pǝr. <verse eid="1KI 22:35" /><verse number="36" style="v" sid="1KI 22:36" />Lang pwari nǝ̀ nggǝ kpa ka, à banggia amǝ'lwa ama, &lt;&lt;Koya ɓwabura ka ɓǝ̀ nyar a là male andǝ nzali male!&gt;&gt;<verse eid="1KI 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="1KI 22:37" />Nda murǝm Isǝrayila wǔ, sǝ à yinǝ luí a Samariya, à tsǝì abanì. <verse eid="1KI 22:37" /><verse number="38" style="v" sid="1KI 22:38" />Sǝ à lak nkila mǝnana sukki arǝ waru-pǝr ka a guguri mala Samariya (mǝnia ka nda guguri mǝnana amā-gung kǝ sussǝ kam ngga). Anva lenzǝki nkile, <note caller="+" style="f"><char style="fr" closed="false">22:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 21:19">21:19</ref></char>.</note>kǝla mǝnana cau mala Yahweh bang ngga.<verse eid="1KI 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1KI 22:39" />Acili atúró mala Ahap andǝ agir mǝnana pea kat, andǝ aɓala minǝ-nzu mǝnana ɓeǎ, andǝ anggea-là mǝnana gilǝkia ka, à nda kam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Isǝrayila.</char> <verse eid="1KI 22:39" /><verse number="40" style="v" sid="1KI 22:40" />Nda Ahap wǔ atà akê, sǝ Ahaziya muna-ɓwabura male twal bancame mala tárrí, duk murǝm ngga.<verse eid="1KI 22:40" /></para>
  <para style="s1">Jehoshafat duk murǝm Yahuda</para>
  <para style="r">(<ref loc="2CH 20:31">2 Acau la Apwari 20:31</ref>; <ref loc="2CH 21:1">21:1</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="1KI 22:41" />Jehoshafat muna-ɓwabura mala Asa, tita yálmúr Yahuda a inea pǝlǝa mala do-bunomurǝm mala Ahap murǝm Isǝrayila. <verse eid="1KI 22:41" /><verse number="42" style="v" sid="1KI 22:42" />Jehoshafat ka apǝlǝa ɓǝlban male lumi-tàrú-bwamdǝ-tongno (35) sǝ yi duk murǝm. Yálmúr Urǝshalima apǝlǝa lumi-ɓari-bwamdǝ-tongno (25). Lullǝ nggè nda Azuba, ɓoarnsarile Shilhi. <verse eid="1KI 22:42" /><verse number="43" style="v" sid="1KI 22:43" />Yì ka twalkusǝ tárrí Asa, sǝ pǝlǝ nzǝmi arǝ njar mala tárrí ɗàng. Pàk gìr mǝnana nda pepè a mǝsǝ Yahweh ka. Sǝama kiɗikia amgbangban-peri atà ankúl ɗàng; amǝ'Isǝrayila lidǝmba nǝ paɓoro mala gìr'nkila andǝ mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne amur amgbangban-peri atà ankúl. <verse eid="1KI 22:43" /><verse number="44" style="v" sid="1KI 22:44" />Jehoshafat do aɓa rǝpwala andǝ murǝm Isǝrayila.<verse eid="1KI 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="1KI 22:45" />Acili atúró mala Jehoshafat, andǝ rǝcandǝa male mǝnana lǝmdǝi, andǝ amunǝo mǝnana munǝ ka, à ndakam a gilǝe aɓa <char style="bk">Malǝmce mala Acau-ɓaraɓara mala Amurǝma mala Yahuda.</char> <verse eid="1KI 22:45" /><verse number="46" style="v" sid="1KI 22:46" />Acili amǝ'gyagung, mǝnana à ue a ɓàkú mala tárrí Asa ka, Jehoshafat pusǝia à purî ɓá nzali. <verse eid="1KI 22:46" /><verse number="47" style="v" sid="1KI 22:47" />A bákuì ka, nzali Edom pànǝ murǝm ɗàng, mǝkwaɗitè na duk murǝm ngga.<verse eid="1KI 22:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="1KI 22:48" />Jehoshafat pàk waru-mur mala Tarshish ace o a <note caller="+" style="f"><char style="fr" closed="false">22:48 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 9:28">9:28</ref></char>.</note>Ofir ace yinǝ bolo-njengǝlan, sǝama à lo gya ɗàng, acemǝnana waruî arkia a <note caller="+" style="f"><char style="fr" closed="false">22:48 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 9:26">9:26</ref></char>.</note>Eziyon Geber <verse eid="1KI 22:48" /><verse number="49" style="v" sid="1KI 22:49" />Pǝlǝa Ahaziya muna-ɓwabura mala Ahap banggi Jehoshafat ama, &lt;&lt;Nying amǝ'túró mem andǝ amǝ'túró mô ɓǝà o aɓalǝ awaru-mur.&gt;&gt; Sǝama Jehoshafat ɓinǝe. <verse eid="1KI 22:49" /><verse number="50" style="v" sid="1KI 22:50" />Sǝ Jehoshafat nongŋo atà akê, sǝ à tsǝì atà akê a nggea-là mala kê Dauda, sǝ Jehoram muna-ɓwabura male duk murǝm.<verse eid="1KI 22:50" /></para>
  <para style="s1">Ahaziya duk murǝm Isǝrayila</para>
  <para style="p">
    <verse number="51" style="v" sid="1KI 22:51" />Ahaziya muna-ɓwabura mala Ahap tita yálmúr Isǝrayila a Samariya a lum-bwamdǝ-tongno-nong-ɓaria pǝlǝa mǝnana Jehoshafat nda murǝm Yahuda ka, sǝ yálmúr Isǝrayila pǝlǝa ɓari. <verse eid="1KI 22:51" /><verse number="52" style="v" sid="1KI 22:52" />Pàk gìr mǝnana mǝɓike na a mǝsǝ Yahweh ka, sǝ twalkusǝ tárrí andǝ nggè, sǝ kpata njar mala Jerobuam muna-ɓwabura mala Nebat mǝnana tsǝk Isǝrayila à pàk cauɓikea ka. <verse eid="1KI 22:52" /><verse number="53" style="v" sid="1KI 22:53" />Kpata Ba'al sǝ peri abaní. Tsǝk Yahweh Ɓakuli mala Isǝrayila bumi lúllô, kǝla mǝnana tárrí pàk ka.<verse eid="1KI 22:53" /></para>
  <chapter eid="1KI 22" />
</usx>