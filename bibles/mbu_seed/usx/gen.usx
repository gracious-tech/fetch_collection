<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Mbula</book>
  <para style="h">Tite</para>
  <para style="toc1">Malǝmce Mǝdǝmbe mala Musa mana à kǝ tunǝì ama Tite ka</para>
  <para style="toc2">Tite</para>
  <para style="toc3">Tite</para>
  <para style="mt1">TITE</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">Lullǝu mǝnia ama <char style="bk">Tite </char> ka ɓālǝi nda &lt;&lt;tita gìr.&gt;&gt; Mǝnia yì malǝmce mala Tite ka kǝ bangcau amur pusǝ ɓanza, puro mala ɓwapǝndǝa, kutio mala cauɓikea andǝ tanni mana a ɓanza ka, andǝ njar mǝnana Ɓakuli kǝ pangnǝ aɓwapǝndǝa ka. Malǝmce mala <char style="bk">Tite</char> ka à nǝ̀ gandǝ gauwi arǝ abanì ɓari: (1) Kùré 1-11; Pusǝ ɓanza andǝ cau amur do mala share-nza mala ɓwapǝndǝa a nggea dǝmbe. Aɓa mǝnia ka à bang cau mala Adamu andǝ Hawawu, Kayinu andǝ Habila, Nuhu andǝ Mùr-gùla, sǝ nggea-là ndà-kulí mǝ'dāhre mala Babila. (2) Kùré 12-50; Cau ɓara-ɓara mala akáu mala amǝ Isǝrayila a nggea dǝmbe. Kau malea mǝdǝmbe ka nda Ibǝrayim, mǝnana à súrǝì pepè ace pàɓamuru andǝ okiru male aban Ɓakuli ka. Acau mǝnana à yi kpata mǝno ka, à nda ka acau-doyilǝmu mala muni Ishaku, andǝ mala mǝ'kè Yakupu (mǝnana à tunǝki ama Isǝrayila) ka, andǝ mala amuna-burana lum-nong-ɓari mala Yakupu, mǝnana à yi duk atárrú mala atau lum-nong-ɓari mala amǝ Isǝrayila ka. À twal nggeamurǝm cau amur mwashat atà amuna-burana male, Yisǝfu, andǝ agir mǝnana à yi kumban sǝ Yakupu andǝ amuna-burana male andǝ amǝ'ɓala malea yiu ace do a nzali Masar ka. Kat andǝ amani ama malǝmce mǝnia ka kǝ bang kǝɓicau amur aɓwana ka, gìr mǝnana Ɓakuli pê ka, nda cau mǝgule andǝ mǝdǝmbe kat. Cenî tite nǝ cau pu'nzǝm ama Ɓakuli na pusǝ ɓanza ka, sǝ masǝlǝi nǝ pacau ama Ɓakuli nǝ̀ lidǝmba nǝ lǝmdǝ ɗenyinǝban male ace aɓwana male. Aɓa malǝmce mǝnia kat ka, mūgula ɓwa ka nda Ɓakuli, mǝnana kǝ pak ɓashi sǝ kwarkir aɓwana mana à kǝ pak mǝɓane ka, kǝ gingnǝ aɓwana male sǝ kǝ bwalia wia kàm, kǝ tsǝia a njar aɓa do ɓanza malea, twal a tite aban ká masǝlǝate. Mǝnia yì malǝmce share-ɓanza ka à gìlǝì ace kum caugilǝa amur paɓamuru mala aɓwana, ace mǝnana ɓǝà tsǝì tàtǝ́k ace pà sǝlǝe amur agirkumban mǝnana à kutina ka, andǝ kwakita tǝr gir mǝnana à nǝ̀ earnǝi ama mǝsǝcau na, sǝ anggo ka ɓǝ̀ tsǝk mǝno yì paɓamuru aban Ɓakuli ka ɓǝ̀ dum nǝyilǝmu.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Pusǝ ɓanza andǝ ɓwapǝndǝa <char style="ior"><ref loc="GEN 1:1-2:25">1:1--2:25</ref> </char></para>
  <para style="io1">Kutio mala cauɓikea andǝ tanni <char style="ior"><ref loc="GEN 3:1-24">3:1-24</ref> </char></para>
  <para style="io1">Twal aban Adamu a ban ká aban Nuhu <char style="ior"><ref loc="GEN 4:1-5:32">4:1--5:32</ref> </char></para>
  <para style="io1">Nuhu andǝ Mùr-gùla <char style="ior"><ref loc="GEN 6:1-10:32">6:1--10:32</ref> </char></para>
  <para style="io1">Nggea-là ndà-kulí mǝ'dāhre mala Babila <char style="ior"><ref loc="GEN 11:1-9">11:1-9</ref> </char></para>
  <para style="io1">Twal aban Shem a ban ká aban Ibǝrayim <char style="ior"><ref loc="GEN 11:10-32">11:10-32</ref></char></para>
  <para style="io1">Akáu: Ibǝrayim, Ishaku, Yakupu <char style="ior"><ref loc="GEN 12:1-35:29">12:1--35:29</ref></char></para>
  <para style="io1">Amǝ'kà Isǝwa <char style="ior"><ref loc="GEN 36:1-43">36:1-43</ref></char></para>
  <para style="io1">Yisǝfu andǝ amǝ'eambi <char style="ior"><ref loc="GEN 37:1-45:28">37:1--45:28</ref></char></para>
  <para style="io1">Amǝ Isǝrayila a Masar <char style="ior"><ref loc="GEN 46:1-50:26">46:1--50:26</ref></char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="ms">Ani sǝ Ɓakuli pusǝ agir kat</para>
  <para style="s">Ɓakuli pusǝ kùli andǝ nzali</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />A tite ka Ɓakuli pusǝ kùli andǝ nzali.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 90:2">Ang 90:2</ref></char>.</note> <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />Nzali ka pur kǝgìr ɗàng, nda kam anggo ɗulkǝm. Pǝndǝa gir mur mùr mǝlime. Sǝ Bangŋo mala Ɓakuli ka camarǝ gāɗi amur mùr.<verse eid="GEN 1:2" /></para>
  <para style="s">Ɓakuli pak tǎlaban</para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 1:3" />Sǝ Ɓakuli na ama, &lt;&lt;Ɓǝ̀ tǎlaban pusǝ rǝi.&gt;&gt; Pǝlǝa tǎlaban puro.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 4:6">2Kor 4:6</ref></char> .</note> <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />Ɓakuli sǝni ka tǎlaban ɓoaro, pǝlǝa tsǝk nzong anre tǎlaban andǝ pǝndǝa. <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />Ɓakuli tunǝ tǎlaban ama, &lt;&lt;pwari&gt;&gt; sǝ pǝndǝa ka tunǝi ama, &lt;&lt;dù.&gt;&gt; Pwari kya kpa, sǝ ban yi kwaro; mǝno nda nongŋo mǝdǝmbe.<verse eid="GEN 1:5" /></para>
  <para style="s">Ɓakuli pak bumkuli, andǝ nza, andǝ nggeamùr</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />Sǝ Ɓakuli bang ama, &lt;&lt;Ɓǝ̀ nreban gau mùr mana a kùli andǝ mana a nzali ka.&gt;&gt; <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />Anggo sǝ pa. Ɓakuli tsǝk mǝnia yì nreban ngga yi nongŋo anre mùr mana a nzali andǝ mana a kùli ka. <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />Ɓakuli tunǝ mǝnia yì nreban ngga ama, &lt;&lt;bumkuli.&gt;&gt; Pwari kya kpa, sǝ ban yi kwaro; mǝno nda ɓaria nongŋo.<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />Ɓakuli na ama, &lt;&lt;Ɓǝ̀ mùr mǝnana aɓata bumkuli ka, dapi a banɓwáná, sǝ ɓǝ̀ nza sa.&gt;&gt; Anggo sǝ pa. <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />Ɓakuli tunǝ nza ama, &lt;&lt;kwàrban&gt;&gt; sǝ ramba mala mùr ka tunǝi ama, &lt;&lt;nggeamùr.&gt;&gt; Ɓakuli sǝni ka ɓoaro.<verse eid="GEN 1:10" /></para>
  <para style="s">Ɓakuli pak abondo andǝ anggun</para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 1:11" />Ɓakuli na ama, &lt;&lt;Ɓǝ̀ nzali pusǝ agirpwala: abondo andǝ mbúgir mǝnana à nǝ̀ pusǝ mǝsǝia ka, andǝ anggun mǝnana à nǝ̀ pusǝ ɓǝlea nǝ amǝsǝia aɓalǝia ka. Komǝyenani le ka ɓǝ̀ pusǝ ulang male yì ɓeali.&gt;&gt; Anggo sǝ pa. <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />Nzali pusǝ agirpwala: abondo andǝ ambúgir mǝnana à kǝ pusǝ mǝsǝia ulangyia, andǝ anggun mǝnana à kǝ pusǝ ɓǝlea nǝ amǝsǝia aɓalǝia ka ulangyia. Ɓakuli sǝni ka ɓoaro. <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />Pwari kya kpa, sǝ ban yi kwaro; mǝno nda tàruià nongŋo.<verse eid="GEN 1:13" /></para>
  <para style="s">Ɓakuli pak pwari andǝ zongŋo</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />Pǝlǝa Ɓakuli na ama, &lt;&lt;Ɓǝ̀ atǎlaban pusǝ rǝia a bumkuli, ɓǝà gau nre pwari andǝ du. Ɓǝà duk agir-lǝmdǝa ace lǝmdǝ anongŋo, andǝ apǝlǝa, andǝ akúnì. <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />Sǝ amǝnia yì atǎlaban ngga ɓǝà tá a bumkuli amur ɓanza.&gt;&gt; Anggo sǝ pa. <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />Nda Ɓakuli pàk atǎlaban mǝgulke ɓari. Mǝgule mala ɓì, yì pwari ka, ɓǝ̀ kǝ tá nǝ pwari, sǝ mǝkyauwe, yì zongŋo ka, ɓǝ̀ kǝ tá nǝ du. Ɓakuli nyar ɗǝm ngga pusǝ anlero.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:19">Nggur 4:19</ref>; <ref loc="PSA 136:7-9">Ang 136:7-9</ref></char>.</note> <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />Ɓakuli tsǝk amǝnia yì atǎlaban ngga a bumkuli ɓǝà kǝ tá amúr ɓanza. <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />Ɓǝà kǝ yálmúr pwari andǝ du, sǝ ɓǝà gau nre tǎlaban andǝ pǝndǝa. Sǝ Ɓakuli sǝni ka ɓoaro. <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />Pwari kya kpa, sǝ ban yi kwaro. Mǝno nda inea nongŋo.<verse eid="GEN 1:19" /></para>
  <para style="s">Ɓakuli pak agirkusǝu andǝ anji andǝ anyal</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />Ɓakuli na ama, &lt;&lt;Ɓǝ̀ mùr lùmsǝ nǝ anji andǝ acili agir mǝyilǝmui mǝnana a mùr ka. Ɓǝ̀ bumkuli lùmsǝ nǝ koya ulang nyal.&gt;&gt; <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />Nda Ɓakuli pusǝki agirkusǝu mǝgulke mǝnana a nggeamùr, andǝ koya gìr mǝnana nǝyilǝmu kǝ ging mbǝl-mbǝl a mùr ka, andǝ koya ulang nyal. Ɓakuli sǝni ka ɓoaro.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 104:25">Ang 104:25</ref></char>.</note> <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />Sǝ Ɓakuli tsǝkia wia bù, na ama, &lt;&lt;Wu ɓǝla, wu hatǝki, wu aki nggeamùr, sǝ ɓǝ̀ anyal hatǝki ɓanza.&gt;&gt; <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />Pwari kya kpa, sǝ ban yi kwaro; mǝno ka nda tongnoia nongŋo.<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />Ɓakuli nyare na ama, &lt;&lt;Ɓǝ̀ nzali pusǝ koya ulang gìr mǝnana nǝyilǝmu ka: agirkusǝu andǝ agir-nzali mǝnana à kǝ púrǝ́ki nǝ múrbumia a nzali ka, andǝ koya ulang nyam-bondo andǝ nyam-ɓala.&gt;&gt; Anggo sǝ pa. <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />Ɓakuli pusǝ koya ulang girkusǝu, anyam-ɓala andǝ anyam-bondo, andǝ koya gìr mǝnana kǝ kuɗǝki a nzali ka. Ɓakuli sǝni ka ɓoaro.<verse eid="GEN 1:25" /></para>
  <para style="s">Ɓakuli pak ɓwabura andǝ ɓwama</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />Pǝlǝa Ɓakuli na ama, &lt;&lt;Ɓǝ̀ sǝm pàk ɓwapǝndǝa<note caller="+" style="f"><char style="fr" closed="false">1:26 </char><char style="fq" closed="false">ɓwapǝndǝa </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fqa">adamu</char>.</note> ɓǝ̀ pa kǝla sǝm, ɓǝ̀ pur sǝm, ace mǝnana ɓǝ̀ yálmúr anji mǝnana aɓa nggeamùr, andǝ anyal mǝnana a bumkuli ka, agir-nzali andǝ agirkusǝu mǝnana kat à kǝ gāli a nzǝm-nzali, andǝ ɓanza kat, andǝ agir-yilǝmu mǝnana kat à kǝ pūrǝki nǝ múrbumia a nzali ka.&gt;&gt;<verse eid="GEN 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 1:27" />Nda Ɓakuli pusǝ ɓwapǝndǝa kǝla yì.</para>
  <para style="q2" vid="GEN 1:27">Aɓa purban male yì Ɓakuli sǝ pusǝì.</para>
  <para style="q2" vid="GEN 1:27">Pàk ɓwapǝndǝa ɓwabura andǝ ɓwama.<verse eid="GEN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 1:28" />Ɓakuli tsǝkia wia bù sǝ nea wia ama, &lt;&lt;Wu ɓǝla, wu hatǝki; wu lùmsǝ ɓanza. Wu akí ɓanza sǝ wu ɓunni.<note caller="+" style="f"><char style="fr" closed="false">1:28 </char><char style="fq" closed="false">wu ɓunni </char><char style="ft" closed="false">ko &lt;&lt;wu yálmúrí.&gt;&gt;</char></note> Wu yálmúr anji mǝnana a mùr andǝ anyal mǝnana a bumkuli, andǝ koya gìr mǝnana ndanǝ yilǝmu kǝ gya a nzǝm-nzali ka.&gt;&gt;<verse eid="GEN 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 1:29" />Pǝlǝa Ɓakuli nea wia ama, &lt;&lt;Ən pana wun koya mbúgir andǝ bondo mǝnana kǝ pusǝ ɓeali a nzǝm-nzali kat ka, andǝ koya nggun mǝnana kǝ pusǝ ɓǝle nǝ mǝsǝì aɓalǝi ka. À nda ace girlina ma'wun. <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />Ən pana koya ulang mbúgir andǝ koya girpwala, nda girlina mala anyam-bondo mǝnana a ɓanza, andǝ anyal mǝnana a bumkuli, andǝ anyama mǝnana à kǝ pūrǝ nǝ múrbumia a nzali ka, andǝ koya gìr mǝnana ndanǝ yilǝmu ka.&gt;&gt; Anggo sǝ pa.<verse eid="GEN 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 1:31" />Ɓakuli sǝn gìr mǝnana pè kat ka, ɓoar kǝ̀rkǝ́r. Pwari kya kpa, sǝ ban yi kwaro; mǝno nda tongno-nong-mwashatia nongŋo.<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="s">Ɓakuli usǝlǝi atúró male</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />Anggo sǝ pusǝ kùli andǝ nzali andǝ agir mǝnana aɓalǝia kat ka yiu a masǝlǝate. <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />A tongno-nong-ɓaria nongŋo ka, Ɓakuli malǝna túró male mǝnana pàk ka, sǝ usǝlǝo.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:8-11">Pur 20:8-11</ref>; <ref loc="EXO 31:17">31:17</ref>; <ref loc="DEU 5:12-14">Nggur 5:12-14</ref>; <ref loc="HEB 4:4">Ib 4:4</ref></char>.</note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />Ɓakuli tsǝkbu amúr tongno-nong-ɓaria pwari, sǝ nyesǝi duk pwari mǝfele, acemǝnana nda pwari mǝnana usǝlǝ nǝi arǝ atúró male mǝnana kat pa, mala pusǝki agir ka.<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:11">Pur 20:11</ref>; <ref loc="EXO 31:17">31:17</ref></char>.</note><verse eid="GEN 2:3" /></para>
  <para style="s">Ɓaban Iden</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />Anggo sǝ à pusǝ kùli andǝ nzali.</para>
  <para style="p" vid="GEN 2:4">Lang Mǝtalabangŋo Ɓakuli pusǝna kùli andǝ nzali ka, <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />ɓekǝ girpwala pa kàm a ɓanza ɗàng, sǝ ɓekǝ mǝsǝɓeale to gbal a nzali ɗang. Gìrnî pa anggo acemǝnana Mǝtalabangŋo Ɓakuli malaká nya mbulo ɓǝ̀ liu nzali ɗang, sǝ kǝ ɓwapǝndǝa pa kàm nǝ̀ rik nzali ɗang. <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />Amaɗi na mǝnana à kǝ tu mùr a nzali ace liu ban ngga.<verse eid="GEN 2:6" /></para>
  <para style="s">Ɓakuli tsǝk bu amur ɓwabura <optbreak /> andǝ ɓwama mǝdǝmbe</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />Pǝlǝa Mǝtalabangŋo Ɓakuli ɓak ɓwa<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">ɓwa </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fqa">adamu </char>.</note> nǝ muku nzali,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">nzali </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fqa">adamah</char> .</note> sǝ pyaupi wi n-yali mala yilǝmu aɓa lùllǝì, sǝ yì ɓwa ka pang nǝyilǝmu.<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 103:14">Ang 103:14</ref>; <ref loc="ECC 12:7">Ham 12:7</ref>; <ref loc="1CO 15:47">1Kor 15:47</ref></char>.</note><verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />Mǝtalabangŋo Ɓakuli pǝlǝa tsǝk ɓaban a Iden nǝ njar-takuli sǝ pandǝki anggun kàm; a kàm sǝ tsǝk ɓwa mǝnana pè ka. <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />Mǝtalabangŋo Ɓakuli tsǝk anggun ɗàngɗáng ɓǝà to a ɓabanì: anggun mǝɓoarsǝne andǝ amǝɓoarli. A tsùrú mala ɓabanì ka anggun nakam ɓari, nggun-yilǝmu andǝ nggun mala pà sǝlǝe mala gìr mǝɓoarne andǝ mǝɓane. <verse eid="GEN 2:9" /><verse number="10" style="v" sid="GEN 2:10" />Ɓè nggeasala pur a Iden kǝ pa mùr a ɓabanì; lo kano ka kya gauwa arǝ amyalmúr ine. <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />Mǝdǝmbe ka à tunǝi ama Pishon; ɓangŋa pǝlǝki arǝ abân aɓa nzali Havila, nzali mana à kǝ kum bolo-njengǝlan kam ngga. <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />(Bolo-njengǝlan mala nzali mǝno ka mǝɓoarne na; akàm ɗǝm ngga à kǝ kum myang mǝ'rǝmɓoarne andǝ atali gǝna.) <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />Ɓaria myalmúr ka nda Gihon; ɓangŋa pǝlǝki arǝ abân aɓa nzali Kush. <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />Tàruià myalmúr ka nda Tigris; ɓangŋa pǝlǝ nǝ bantakuli mala nzali Assuriya. Inea myalmúr ka nda Yiufǝretis.<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />Mǝtalabangŋo Ɓakuli tsǝk ɓwabura man a ɓaban mala anggun a Iden, ɓǝ̀ kǝ paktúró aɓalǝi, sǝ ɓǝ̀ kǝ yállí. <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />Mǝtalabangŋo Ɓakuli nunkiri yì ɓwabura ama, &lt;&lt;A earǝ́nò ama wu li ɓǝla koya nggun a mǝnia yì ɓaban mala anggun ngga. <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />Sǝama kǝa na ama awu nǝ li ɓǝlanggun mala pà sǝlǝe mala gìr mǝɓoarne andǝ mǝɓane ɗàng. A pwari mana a li ka, ɓafo, awu nǝ wǔ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 30:15">Nggur 30:15</ref>,<ref loc="DEU 30:19-20">19-20</ref>; <ref loc="ROM 6:23">Rom 6:23</ref>; <ref loc="1TI 5:6">1Tim 5:6</ref>; <ref loc="JAS 1:15">Jem 1:15</ref></char>.</note><verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />Pǝlǝa Mǝtalabangŋo Ɓakuli na ama, &lt;&lt;Ɓoaro ɓǝ̀ ɓwabura mǝnia ka ɓǝ̀ do nǝmurǝì ɗàng. Mǝ nǝ pakki wi mǝ'bwali wi, mǝnana karǝ arǝì ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 11:9">1Kor 11:9</ref>; <ref loc="1TI 2:13">1Tim 2:13</ref></char>.</note><verse eid="GEN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 2:19" />Mǝtalabangŋo Ɓakuli ka, pàngŋǝ̀nà túró nǝ muku-nzali ɓangŋǝna anyama mǝnana à kǝ gya a kwàrban, andǝ anyal mǝnana à kǝ yal a bumkuli ka. Yinǝia a ban mǝnia yì ɓwa ka, nǝ̀ sǝni lang sǝ nǝ̀ tunǝia. Ɓǝ̀ mana sǝ mǝnia yì ɓwabura tunǝna koya gìr mǝnana ndanǝ yilǝmu nǝi ka, dumǝna lùllǝì. <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />Ɓwabura man tsǝki agirkusǝu kat lullǝu: anyal mǝnana kat à kǝ yal a bumkuli, andǝ anyam-ɓala kat, andǝ anyam-bondo kat.</para>
  <para style="p" vid="GEN 2:20">Sǝ male yì ɓwabura ka, à kumbi wi kǝ gbasha mǝnana karǝ arǝì ka ɗàng. <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />Pǝlǝa Mǝtalabangŋo Ɓakuli tsǝk ɓwabura ɓǝ̀ koa nggea ntulo mǝlime. Ndarǝ nong ntulo ka, Mǝtalabangŋo Ɓakuli pusǝ mu nkanggari ɓwabure mwashat sǝ lúmsǝ banì nǝ nyama. <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />Pǝlǝa Mǝtalabangŋo Ɓakuli pak ɓwama nǝ mǝnia yì mu pusǝì a nkanggari ɓwabura ka, sǝ yinǝi aban ɓwaburè.<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 11:8">1Kor 11:8</ref>,<ref loc="1CO 11:12">12</ref></char>.</note><verse eid="GEN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 2:23" />Ɓwabura man na ama,</para>
  <para style="q1" vid="GEN 2:23">&lt;&lt;Mǝnia adyan ngga mǔ na</para>
  <para style="q2" vid="GEN 2:23">à pusǝì aɓalǝ amuem;</para>
  <para style="q2" vid="GEN 2:23">sǝ nyama na mala nyamam!</para>
  <para style="q1" vid="GEN 2:23">À nǝ̀ tunǝi ama, &lt;ɓwama&gt;</para>
  <para style="q2" vid="GEN 2:23">acemǝnana à pusǝì arǝ ɓwabura.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:28-30">Afi 5:28-30</ref></char>.</note><verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />Nda gìr mana tsǝa sǝ ɓwabura nǝ̀ ɗeki tárrí andǝ ngge, sǝ nǝ̀ lanzǝa arǝ māmí, sǝ yia kǝm ngga à dumǝna nyama mwashat.<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 2:15">Mal 2:15</ref>; <ref loc="MAT 19:5">Mat 19:5</ref>; <ref loc="MRK 10:7-8">Mar 10:7-8</ref>; <ref loc="1CO 6:16">1Kor 6:16</ref>; <ref loc="EPH 5:31">Afi 5:31</ref></char>.</note><verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />Anggo ka, yì ɓwabura andǝ māmí ka, à ndanǝ ɓatea, sǝ kǝsǝkea pakkia wia ɗàng. <figure style="fig" alt="Adam and Eve in the garden of Eden" file="BA03001BW.TIF" size="col" loc="2:25" copy="Bass and Halftones Images" ref="2:15-25">Adamu andǝ Hawawu a ɓaban mala Iden</figure><verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">Adamu andǝ Hawawu mgbiki Ɓakuli kiru</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />Atà anyam-bondo mǝnana Mǝtalabangŋo Ɓakuli pusǝia ka, n'yau na mǝnana kútiǎ kat nǝ kutan ngga. Ɓè kǝ pwari ka, n'yau ɗì ɓwama ama, &lt;&lt;Mbak-kàngkàng Ɓakuli bang ama, &lt;Wu kǝa li kǝ ɓǝlanggun mǝnana a ɓaban mala anggun ngga ɗàng le?&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:16">Mat 10:16</ref>; <ref loc="2CO 11:3">2Kor 11:3</ref>; <ref loc="REV 12:9">Sǝn 12:9</ref>; <ref loc="REV 20:2">20:2</ref></char>.</note><verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />Ɓwama eari n'yau ama, &lt;&lt;Sǝm nǝ̀ gandǝ li aɓǝlanggun mǝnana a ɓaban mala anggun ngga. <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />Sǝama Ɓakuli bangga sǝm ama, kǝ ɓǝlanggun mǝnana came a ɓaɓalǝu mala ɓaban mala anggun ngga, nda pà sǝm nǝ̀ je, ko sǝm nǝ̀ li raka; ɓǝ̀ sǝm je, ko ɓǝ̀ sǝm li ka, sǝm nǝ̀ wú.&gt;&gt;<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />N'yau eari ɓwama ama, &lt;&lt;Mǝsǝcau ka pà wun nǝ̀ wu ɗàng.<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 4:44">Yoh 4:44</ref></char>.</note> <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />Acemǝnana Ɓakuli sǝlǝna ama, ɓǝ̀ wu li ɓǝlanggun man ngga, amǝsǝ wun nǝ̀ mǝnna, sǝ wun nǝ̀ do kǝla Ɓakuli, wun nǝ̀ súrǝ̀ mǝɓoarne andǝ mǝɓane.&gt;&gt; <figure style="fig" alt="Satan deceived Eve" file="CO00606B.TIF" size="col" loc="3:5" copy="Cook OT Images" ref="3:1-5">Shetan swarki Hawawu</figure><verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />Lang ɓwama sǝna ɓǝla-nggunì ndanǝ ɓoaro ace girlina, sǝ ɓoarsǝna, ɗǝm ngga sǝn ɓoaro mala sǝlǝe mǝnana nǝ̀ kùmô arǝì, a ɓabumi ka, kara tù atà aɓǝla-nggunì lì. Sǝ pè burí, pǝlǝa yì ka lì gbal.<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1TI 2:14">1Tim 2:14</ref>; <ref loc="JAS 1:14-15">Jem 1:14-15</ref>; <ref loc="1JN 2:16">1Yoh 2:16</ref></char>.</note> <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />Anggo kara mǝsǝia yia kǝm mǝnna, kǝsǝkea bwalia acemǝnana à yi sǝlǝa ama à nda nǝ ɓatea. Pǝlǝa à ɓungi ambú nggun vwari à gbàrǝna ɓatea nǝi.<verse eid="GEN 3:7" /></para>
  <para style="s">Ɓakuli ɓashì Adamu andǝ Hawawu andǝ N'yau</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />Nǝ́ pwarikpǝra mǝno ka, ɓwaburè andǝ māmí ok gǝshi kusǝ Mǝtalabangŋo Ɓakuli aban gya a ɓaban mala anggun. Kara à ɓangŋa à sǝmbǝrǝì Mǝtalabangŋo Ɓakuli aɓalǝ anggun mǝnana a ɓaban ngga. <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />Pǝlǝa Mǝtalabangŋo Ɓakuli tunǝban ɗì ɓwaburè ama, &lt;&lt;A nda ke lè?&gt;&gt;<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />Yi ka eare ama, &lt;&lt;Ən ok gǝshi kusǝo aban gya a ɓaban mala anggun, ɓangciu pàkkam, nda sǝ ǝn sǝmbǝrǝ ka, acemǝnana mǝ nda nǝ ɓatam.&gt;&gt;<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />Mǝtalabangŋo Ɓakuli ɗì ama, &lt;&lt;Yana nô ama a nda nǝ ɓato? Ko a lina ɓǝlanggun mǝnana ǝn nô nǝma wu kǝa li raka lè?&gt;&gt;<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />Pǝlǝa ɓwaburè ne Mǝtalabangŋo Ɓakuli ama, &lt;&lt;Ɓwama mǝnana a pam ɓǝ̀ sǝm duk sǝni ka, nda pam ɓǝlanggun sǝ ǝn li ka.&gt;&gt;<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />Mǝtalabangŋo Ɓakuli pǝlǝa ɗì ɓwama ama, &lt;&lt;Mana mǝnia a pak ka?&gt;&gt; Ɓwama eare ama, &lt;&lt;N'yau swarkiam, nda gìr mana tsǝa sǝ ǝn li ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:11">Rom 7:11</ref>; <ref loc="2CO 11:3">2Kor 11:3</ref>; <ref loc="1TI 2:14">1Tim 2:14</ref></char>.</note><verse eid="GEN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />Pǝlǝa Mǝtalabangŋo Ɓakuli ne n'yau ama, &lt;&lt;Acemǝnana a pángŋǝ̀nà mǝnia ka,</para>
  <para style="q1" vid="GEN 3:14">&lt;&lt;Súban na amuro mǝnana kútì</para>
  <para style="q2" vid="GEN 3:14">mala koya girkusǝu ka:</para>
  <para style="q2" vid="GEN 3:14">anyam-ɓala andǝ anyam-bondo.</para>
  <para style="q1" vid="GEN 3:14">Awu nǝ pūrǝki nǝ múrbumo,</para>
  <para style="q2" vid="GEN 3:14">awu nǝ li nzali a do-yilǝmu mô kat.<verse eid="GEN 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 3:15" />Mǝ nǝ tsǝk do-ɓibura a nre wun,</para>
  <para style="q2" vid="GEN 3:15">wunǝ ɓwama man,</para>
  <para style="q1" vid="GEN 3:15">amunio andǝ amǝ'keò nǝ̀ duk</para>
  <para style="q2" vid="GEN 3:15">ɓibura mala amuni andǝ amǝkè.</para>
  <para style="q1" vid="GEN 3:15">We ka, awu nǝ kwar mǝkè a nkpalkusǝi,</para>
  <para style="q2" vid="GEN 3:15">sǝ yì ka, nǝ̀ ar ɓamuro.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 2:14">Ib 2:14</ref>; <ref loc="1JN 3:8">1Yoh 3:8</ref></char>.</note><verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />Ɓwama ka Ɓakuli ne wi ama,</para>
  <para style="q1" vid="GEN 3:16">&lt;&lt;Mǝ nǝ hatǝki kwanban mô</para>
  <para style="q2" vid="GEN 3:16">aɓa ɓǝlmuna;</para>
  <para style="q2" vid="GEN 3:16">aɓa kwanban sǝ awu nǝ gbáshí muna.</para>
  <para style="q1" vid="GEN 3:16">Kat andǝ amani ka, nzal burio nǝ̀ aki ɓalǝo,</para>
  <para style="q2" vid="GEN 3:16">sǝ yì ka nǝ̀ duk murǝm amuro.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 16:21">Yoh 16:21</ref>; <ref loc="1TI 2:15">1Tim 2:15</ref></char>.</note><verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />Mala ɓwabura ka, Ɓakuli ne wi ama, &lt;&lt;Acemǝnana a kwakikiro arǝ māmó, sǝ a lina ɓǝlanggun mǝnana ǝn nunkiro<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="fq" closed="false">nunkiro </char><char style="ft" closed="false">ko </char><char style="fqa">tsǝko nzongcau</char>.</note> nǝma wu kǝa lì raka,</para>
  <para style="q1" vid="GEN 3:17">&lt;&lt;Nzali twalǝna súban amurí</para>
  <para style="q2" vid="GEN 3:17">akǝ cau mò.</para>
  <para style="q1" vid="GEN 3:17">Do mô bà, a nǝ tanni aɓa túró mǝcandǝe</para>
  <para style="q2" vid="GEN 3:17">sǝ a nǝ kum girlina.<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 8:20-22">Rom 8:20-22</ref></char>.</note><verse eid="GEN 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 3:18" />Nzali nǝ̀ pusǝô azwe</para>
  <para style="q2" vid="GEN 3:18">andǝ amǝzwezwe,</para>
  <para style="q1" vid="GEN 3:18">sǝ kat andǝ amani ka, awu nǝ li</para>
  <para style="q2" vid="GEN 3:18">ɓǝla abondo mǝnana nzali</para>
  <para style="q2" vid="GEN 3:18">nǝ̀ pusǝ ka.<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 6:8">Ib 6:8</ref></char>.</note><verse eid="GEN 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 3:19" />Nǝ piban a nggun-muro</para>
  <para style="q2" vid="GEN 3:19">sǝ awu nǝ kum girlina,</para>
  <para style="q2" vid="GEN 3:19">mana a nǝ lì ka,</para>
  <para style="q1" vid="GEN 3:19">bà pwari mǝnana awu nǝ wǔ</para>
  <para style="q2" vid="GEN 3:19">a nǝ nyare a nzali ka;</para>
  <para style="q2" vid="GEN 3:19">acemǝnana nǝ tú-nzali sǝ à peo.</para>
  <para style="q1" vid="GEN 3:19">We ka a nda nzali,</para>
  <para style="q2" vid="GEN 3:19">sǝ a nzali sǝ a nǝ nyare a nǝ o.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 90:3">Ang 90:3</ref>; <ref loc="PSA 104:29">104:29</ref>; <ref loc="ECC 12:7">Ham 12:7</ref></char>.</note><verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />Ɓwabura, yì Adamu ka, tsǝkî māmí lullǝu ama Hawawu,<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="fq" closed="false">Hawawu </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fqa" closed="false">Eve </char><char style="ft" closed="false">sǝ ɓālǝi nda </char><char style="fqa">aɓwana mǝ'yilǝmui</char>.</note> acemǝnana yì na nǝ̀ duk nggea ka ɓwapǝndǝa kat mana à ndanǝ yilǝmu ka.<verse eid="GEN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 3:21" />Mǝtalabangŋo Ɓakuli pakki Adamu andǝ māmí agirkùrarǝu nǝ nggû, ɓǝà gbàrǝna rǝia nǝi.<verse eid="GEN 3:21" /></para>
  <para style="s">Ɓakuli pǝr Adamu andǝ Hawawu a ɓaban</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />Sǝ Mǝtalabangŋo Ɓakuli na ama, &lt;&lt;Ɓwapǝndǝa adyan ngga dumǝna kǝla sǝm, súrǝ́nà rǝ mǝɓoarne andǝ mǝɓane. Ɓǝ̀ sǝm eari wi lǝmdǝ buì sǝ tù ɓǝlanggun mala nggun-yilǝmu gbal, sǝ lì ka, nǝ̀ duk bà, pà nǝ̀ wù ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="REV 2:7">Sǝn 2:7</ref></char>.</note> <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />Acemani ka Mǝtalabangŋo Ɓakuli pǝrì pusǝì a Iden, yì ɓaban mala anggun, ama ɓǝ̀ kyane ɓǝ̀ kya rik nzali mǝnana à pusǝì kàm ngga. <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />Anzǝm mǝnana pǝrna ɓwabure pusǝni ka, Mǝtalabangŋo Ɓakuli pǝlǝa tamsǝ acerup, akanggǝrang amǝ'yál ban mala Ɓakuli, nǝ njar-takuli a ɓaban mala anggun a Iden, sǝ tsǝk nggeabyau mǝnana kǝ earki nǝ lasǝ-bǝsa sǝ kǝ pǝlǝki a koya buì ka, ɓǝà kǝ yál njargula ká aban nggun-yilǝmu.<verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">Kayinu andǝ Habila</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />Adamu nongnǝ māmí Hawawu, pǝlǝa muna kpa a bum māmí, sǝ ɓǝl Kayinu. Pǝlǝa Hawawu bang ama, &lt;&lt;Nǝ ɓwamuru mala Mǝtalabangŋo ka, ǝn ɓǝlǝna muna-ɓwabura.&gt;&gt; <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />Nǝnzǝ́mò ka yi ɓǝl mǝ'eambi, tsǝki wi lullǝu ama Habila.</para>
  <para style="p" vid="GEN 4:2">Habila twal túró yál agirkusǝu, sǝ Kayinu twal túró rya. <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />Lang kún pwan gir-ɓaban karna ka, Kayinu yinǝì Mǝtalabangŋo ɓoro mala aɓǝla agir-ɓaban.<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:19">Pur 23:19</ref>; <ref loc="EXO 34:26">34:26</ref>; <ref loc="NEH 10:35">Nehe 10:35</ref></char>.</note> <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />Sǝ Habila ka yinǝ ɓoro male mala agirkusǝu, atà amǝ'nyange mǝnana à ɓǝlia a dǝmba a domwan male ka. Mǝtalabangŋo earnǝ Habila andǝ ɓoro male.<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="EXO 13:12">Pur 13:12</ref>; <ref loc="NUM 18:17">Ɓal 18:17</ref>; <ref loc="PRO 3:9">Pas 3:9</ref>; </char><char style="xt"><ref loc="HEB 11:4">Ib 11:4</ref></char>.</note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />Sǝ mala Kayinu andǝ ɓoro male ka, Mǝtalabangŋo earnǝia ɗàng. Mǝnia ka tsǝk Kayinu bumi lul kǝ̀rkǝ́r, kara rǝmsǝ dǝmbì.<verse eid="GEN 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 4:6" />Pǝlǝa Mǝtalabangŋo ɗì Kayinu ama, &lt;&lt;Palang sǝ bumo lúllô? Palang sǝ a rǝmsǝ dǝmbò? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />Ɓǝ̀ a pak gìr mǝnana mǝɓoarne na ka, à pà nǝ̀ eo re? Sǝ ɓǝ̀ a pàk mǝɓane ka, cauɓikea na kùmsǝó a kunɓala kǝ alte nǝ̀ parǒ aɓate ka, sǝama dumǝna púp wu limurǝm amurí.&gt;&gt;<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />Ɓè kǝ pwari ka Kayinu ne mǝ'eambi Habila ama, &lt;&lt;Tsǝktam a ɓabondo.&gt;&gt; Lang à nda ɓabondo ka, Kayinu kara lo bwal mǝ'eambi Habila wali wú.<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 23:35">Mat 23:35</ref>; <ref loc="LUK 11:51">Luk 11:51</ref>; <ref loc="1JN 3:12-15">1Yoh 3:12-15</ref>; <ref loc="JUD 1:11">Yahu 11</ref></char>.</note><verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />Mǝtalabangŋo ɗì Kayinu ama, &lt;&lt;Mǝ'eambo, Habila ka, nda kǝshe?&gt;&gt; Kara pǝlǝì Mǝtalabangŋo ama, &lt;&lt;Ən súrǝ̀ banì ɗàng. Nggeari ka, mǝ nda mǝ'yál mǝ'eambam le?&gt;&gt;<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />Mǝtalabangŋo ne wi ama, &lt;&lt;Mana man a pak ka? Kwakikiro! Nkila mǝ'kyauweo ka ndya kǝ ɓua abanam a nzali ka!<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 35:33">Ɓal 35:33</ref>; <ref loc="DEU 21:1-9">Nggur 21:1-9</ref>; <ref loc="HEB 12:24">Ib 12:24</ref>; <ref loc="REV 6:9-10">Sǝn 6:9-10</ref></char>.</note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />Adyan ngga, súban na amuro, sǝ à pǝrǝno a nzali mǝnana mǝn kúni kǝ nu nkila mǝ'eambo mǝnana a sukki ka.<verse eid="GEN 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 4:12" />&lt;&lt;Ɓǝ̀ a rik mǝnia yì nzali ka, pà nǝ̀ pusǝo kǝ girlina mǝɓoarne ɗàng. A dumǝna mǝgya-kusǝu, mǝnana pà nǝ̀ do aban mǝ mwashati a ɓanza raka.&gt;&gt; <verse eid="GEN 4:12" /><verse number="13" style="v" sid="GEN 4:13" />Pǝlǝa Kayinu ne Mǝtalabangŋo ama, &lt;&lt;Tanni mala cauɓikea mem man kútì rǝcandǝa mem.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="fq" closed="false">Tanni mala cauɓikea mem man kútì rǝcandǝa mem. </char><char style="ft" closed="false">Ko &lt;&lt;Gìrkwanban man kútì mana mǝ nǝ gandǝ twaltwale ka.&gt;&gt; </char></note> <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />Yalung ngga a ndarǝ pǝram mǝ purî nzali mǝnia ka mǝ nying ɓadǝmbo; mǝ nǝ duk mǝgya-kusǝu a ɓanza, ban-usǝlǝo pa kàm a buam ɗàng, sǝ ɓwa mǝnana kat kumam ngga nǝ̀ wal-luem.&gt;&gt;<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />Sǝ Mǝtalabangŋo banggi wi ama, &lt;&lt;Pà nǝ̀ pa anggo ɗàng; ɓǝ̀ kǝ ɓwa wal-luio ka, mǝ nǝ wal atà aɓwana male tongno-nong-ɓari.&gt;&gt; Pǝlǝa Mǝtalabangŋo tsǝki Kayinu nyoulǝa ace mǝnana ɓǝ̀ kǝ ɓwa kumi ka, ɓǝ̀ kǝa wal-luí raka. <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />Nda Kayinu nying ɓadǝm Mǝtalabangŋo o kya do a nzali Nod, nǝ njar-takuli mala Iden ngga.<verse eid="GEN 4:16" /></para>
  <para style="s">Ɓwapǝndǝa tita do la</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />Kayinu nong nǝ māmí, sǝ muna kpa a bumi sǝ ɓǝl Inok. Kayinu ka nda aban ɓak nggea-là, sǝ lě ka tunǝi nǝ lullǝ muna-ɓwabura male Inok. <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />Inok ɓǝl muna-ɓwabura à tunǝi ama Irad. Irad yi ɓǝl muna-ɓwabura lùllǝì ama Mehujayel. Mehujayel yi duk tár Metushayel, sǝ Metushayel ka nda tár Lamek. <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />Lamek al amamǝna ɓari; māmí mǝdǝmbe ka nda Ada, sǝ ɓaria nda Zila. <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />Ada ɓǝl Jabal, mǝnana nda tár amǝ'do aɓalǝ agumli andǝ amǝ'yál agir ka. <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />Lullǝ mǝ'eambi nda Jubal, mǝnana nda tár amǝ'wal zangŋan andǝ amǝ'twang ntetu ka. <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />Zila gbal ka ɓǝl muna à tunǝi ama Tubal-Kayinu, mǝnana yi pǝlǝ mǝ'ntùl kǝ tulki ambalang agirtúró nǝ bolo-bángŋá andǝ bolo-candǝa ka. Mǝ'kyauwa Tubal-Kayinu muna-ɓwama nda Naama.<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />Lamek banggi amāmí ama,</para>
  <para style="q1" vid="GEN 4:23">&lt;&lt;Ada andǝ Zila, wu kwakikir wun arǝàm;</para>
  <para style="q2" vid="GEN 4:23">wun amālá Lamek, wu ok cau mem.</para>
  <para style="q1" vid="GEN 4:23">Ən walna-lú acemǝnana ɓwe tsǝkam penye ka,</para>
  <para style="q2" vid="GEN 4:23">Lagga ɓwa na ǝn wal-luí</para>
  <para style="q2" vid="GEN 4:23">acemǝnana tùlam ngga.<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />Ɓǝ̀ ayilǝmu tongno-nong-ɓari na à nǝ̀ ɗwanyi</para>
  <para style="q2" vid="GEN 4:24">ace wal-lú Kayinu ka,</para>
  <para style="q1" vid="GEN 4:24">ayilǝmu lumi-tongno-nong-ɓari</para>
  <para style="q1" vid="GEN 4:24">bwamdǝ tongno-nong-ɓari (77) na</para>
  <para style="q2" vid="GEN 4:24">à nǝ̀ ɗwanyi ace wal-luem ngga.&gt;&gt;<verse eid="GEN 4:24" /></para>
  <para style="s">À ɓǝl Set</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />Adamu nyare nongnǝ māmí, pǝlǝa ɓǝlî wi ɓè muna-ɓwabura ɗǝm. Māmí tsǝki muna lullǝu ama Set. Ne ɓamúrì ama, &lt;&lt;Ɓakuli panam muna-ɓwabura a kun Habila mana Kayinu wal-luí ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Set nǝ kún Ibǝru ka ɓālǝi nda </char><char style="fqa">Pana</char>.</note> <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />Set gbal ka ɓǝl muna-ɓwabura, pǝlǝa tsǝki wi lullǝu ama Enosh.</para>
  <para style="p" vid="GEN 4:26">A kǝ nzê mǝno ka sǝ aɓwapǝndǝa tita tunǝ lullǝ Mǝtalabangŋo aɓa peri.<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:8">Tite 12:8</ref>; <ref loc="GEN 26:25">26:25</ref>; <ref loc="1KI 18:24">1Amur 18:24</ref>; <ref loc="PSA 116:17">Ang 116:17</ref>; <ref loc="JOL 2:32">Jol 2:32</ref>; <ref loc="ZEP 3:9">Zaf 3:9</ref>; <ref loc="1CO 1:2">1Kor 1:2</ref></char>.</note><verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">Nggurkwar mala Set</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />Mǝnia ka nda tsaɗi mala atau mǝnana à pur aɓa Adamu, kǝla mǝnana à gilǝì ɓara-ɓara ka. Ɓakuli pusǝ ɓwapǝndǝa<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fq" closed="false">ɓwapǝndǝa </char><char style="ft" closed="false">nǝ kún Ibǝru ka nda </char><char style="fqa">adamu</char>.</note> ka, peǎ a purban male yì Ɓakuli. <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />Pusǝia ɓwabura andǝ ɓwama; lang pusǝia ka, tsǝkia wia bù sǝ tunǝia ama &lt;&lt;ɓwapǝndǝa.&gt;&gt;<verse eid="GEN 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 5:3" />Lang Adamu pángŋǝ̀nà pǝlǝa gbǝman-mwashat nǝ lumi-tàrú (130) a ɓanza ka, yi ɓǝl muna-ɓwabura kǝla yì, a purban male, sǝ pe wi lullǝu ama Set. <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />Anzǝm ɓǝl Set ka, Adamu pak aɓea apǝlǝa gbǝman-tongno-nong-tàrú (800) a ɓanza; sǝ yi duk tár aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />Apǝlǝa do ɓanza mala Adamu kat ka nda gbǝman-tongno-nong-ine nǝ lumi-tàrú (930). Anzǝm mǝno ka yi wu.<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />Lang Set pàngŋǝ̀nà pǝlǝa gbǝman-mwashat nǝ mǝsǝi tongno (105) a ɓanza ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Enosh. <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />Anzǝm ɓǝl Enosh ka, Set pak aɓea apǝlǝa gbǝman-tongno-nong-tàrú nǝ mǝsǝi tongno-nong-ɓari (807) a ɓanza; ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />Apǝlǝa do ɓanza mala Set kat ka nda gbǝman-tongno-nong-ine nǝ lum-nong-ɓari (912), sǝ yi wu.<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />Lang Enosh pàngŋǝ̀nà apǝlǝa lumi-tongno-nong-ine (90) a ɓanza ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Kenan. <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />Anzǝm ɓǝl Kenan ngga, Enosh pakki aɓea pǝlǝa gbǝman-tongno-nong-tàrú nǝ lum-nong-tongno (815) a ɓanza; ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />Do ɓanza mala Enosh kat ka apǝlǝa gbǝman-tongno-nong-ine mǝsǝi tongno (905) na, sǝ yi wú.<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />Lang Kenan pàngŋǝ̀nà apǝlǝa lumi-tongno-nong-ɓari (70) ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Mahalale. <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />Kenan pàk aɓea apǝlǝa gbǝman-tongno-nong-tàrú nǝ lumi-ine (840) a ɓanza anzǝm ɓǝl Mahalale. Sǝ yi ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />Do ɓanza mala Kenan kat ka, pàk apǝlǝa gbǝman-tongno-nong-ine nǝ lum (910), sǝ yi wú.<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />Lang Mahalale pàngŋǝ̀nà apǝlǝa lumi-tongno-nong-mwashat nǝ mǝsǝi tongno (65) ka, yi ɓǝl muna-ɓwabura lùllǝì ama Jared. <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />Anzǝm ɓǝl Jared ka, Mahalale pàk aɓea apǝlǝa gbǝman-tongno-nong-tàrú nǝ lumi-tàrú (830) a ɓanza. Sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />Do ɓanza mala Mahalale kat ka apǝlǝa gbǝman-tongno-nong-tàrú nǝ lumi-tongno-nong-ine nǝ mǝsǝi tongno (895) na, sǝ yi wu.<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />Lang Jared pàngŋǝ̀nà apǝlǝa gbǝman-mwashat nǝ lumi-tongno-nong-mwashat nǝ mǝsǝi ɓari (162) ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Inok. <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />Anzǝm ɓǝl Inok ka, Jared pàk aɓea apǝlǝa gbǝman-tongno-nong-tàrú (800) a ɓanza. Sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />Do ɓanza mala Jared kat ka apǝlǝa gbǝman-tongno-nong-ine nǝ lumi-tongno-nong-mwashat nǝ mǝsǝi ɓari (962) na, sǝ yi wú.<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />Lang Inok pàngŋǝ̀nà apǝlǝa lumi-tongno-nong mwashat nǝ mǝsǝi tongno (65) ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Metusela. <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />Anzǝm ɓǝl Metusela ka, Inok kpata njar mala Ɓakuli arǝ apǝlǝa gbǝman-tàrú (300) a do ɓanza male. Sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />Do ɓanza mala Inok kat ka apǝlǝa gbǝman-tàrú nǝ lumi-tongno-nong-mwashat nǝ mǝsǝi tongno (365) na. <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />Aɓa do ɓanza male kat ka, Inok kpata njar mala Ɓakuli. A ɓè fara ka Ɓakuli yi twal Inok umnǝi, à nyare à sǝni ɗǝm ɗàng.<verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />Lang Metusela pàngŋǝ̀nà apǝlǝa gbǝman-mwashat nǝ lumi-tongno-nong-tàrú nǝ mǝsǝi tongno-nong-ɓari (187) ka, yi ɓǝl muna-ɓwabura, lùllǝì ama Lamek. <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />Anzǝm ɓǝl Lamek ka, Metusela pàk aɓea apǝlǝa gbǝman-tongno-nong-ɓari nǝ lumi-tongno-nong-tàrú nǝ mǝsǝi ɓari (782) a ɓanza. Sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />Do ɓanza mala Metusela kat ka, apǝlǝa gbǝman-tongno-nong-ine nǝ lumi-tongno-nong-mwashat nǝ mǝsǝi tongno-nong-ine (969) na, sǝ yi wú.<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />Lang Lamek pàngŋǝ̀nà apǝlǝa gbǝman-mwashat nǝ lumi-tongno-nong-tàrú nǝ mǝsǝi ɓari (182) ka, yi ɓǝl muna-ɓwabura.<verse eid="GEN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 5:29" />Lamek tsǝki muni muna-ɓwabura lullǝu ama Nuhu,<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="ft" closed="false">Lullǝu mǝnia ama </char><char style="fq" closed="false">Nuhu </char><char style="ft" closed="false">ka nda kǝla cau nǝ kún Ibǝru ama </char><char style="fqa" closed="false">kum usǝlǝo </char><char style="ft" closed="false">ko </char><char style="fqa">kum girikiban</char>.</note> sǝ na ama, &lt;&lt;Nǝ̀ yina sǝm nǝ girikiban aɓalǝ atanni andǝ atúró rikrya ma'sǝm a nzali mǝnana Mǝtalabangŋo sulǝ súban amurí ka.&gt;&gt; <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />Anzǝm ɓǝl Nuhu ka, Lamek pàk aɓea apǝlǝa gbǝman-tongno nǝ lumi-tongno-nong-ine nǝ mǝsǝi tongno (595) a ɓanza. Sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna. <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />Do ɓanza mala Lamek kat ka, apǝlǝa gbǝman-tongno-nong-ɓari nǝ lumi-tongno-nong-ɓari nǝ mǝsǝi tongno-nong-ɓari (777) na, sǝ yi wú.<verse eid="GEN 5:31" /></para>
  <para style="s">Nggurkwar mala Nuhu</para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />Lang Nuhu pàngŋǝ̀nà apǝlǝa gbǝman-tongno (500) ka, yi ɓǝl amuna-burana tàrú, lullǝia ama Shem andǝ Ham andǝ Jafet.<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">Yiu mala mùr-gùla</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />Lang ɓwapǝndǝa tinata làkkì a ɓanza sǝ à ɓǝlki amuna-mamǝna ka, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />amuna mala Ɓakuli<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq">amuna mala Ɓakuli</char> ka à kǝ sǝni kǝla amǝturonjar mala Ɓakuli na, ko abangŋo na mǝnana à twal nggūrǝ aɓwapǝndǝa ka, ko aɓea amurǝma na a pwarian mǝnana à twal ɓamuria ama à nda ka aɓakuli ka.</note> sǝn ɓoarkinsari mala amuna-mamǝna mala aɓwapǝndǝa, nda à yiu à yì twalki amana à earkicea ateà ka, ɓǝà duk amālea.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JOB 1:6">Ayu 1:6</ref>; <ref loc="JOB 2:1">2:1</ref>; <ref loc="JOB 38:7">38:7</ref>; <ref loc="1PE 3:19-20">1Bit 3:19-20</ref>; <ref loc="JUD 1:6">Yahu 6</ref></char>.</note> <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />Pǝlǝa Mǝtalabangŋo bang ama, &lt;&lt;Bangŋo mem pà nǝ̀ lidǝmba nǝ do aɓa ɓwapǝndǝa do mana málá male pà kàm raka ɗàng,<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fq" closed="false">pà nǝ̀ lidǝmba nǝ do aɓa ɓwapǝndǝa do mana málá male pà kàm raka ɗàng </char><char style="ft" closed="false">ko: </char><char style="fqa">pà nǝ̀ lidǝmba nǝ núngírǝu andǝ ɓwapǝndǝa bà ɗàng</char>.</note> acemǝnana yì ka nǝ̀ nggá wǔ.<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="fq" closed="false">nǝ̀ nggá wǔ </char><char style="ft" closed="false">ko: </char><char style="fqa">kiɗikina a njar male</char>.</note> Sauwa mala do ɓanza male pà nǝ̀ kútì apǝlǝa gbǝman-mwashat nǝ lumi-ɓari (120) ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 5:16-17">Gal 5:16-17</ref></char>.</note><verse eid="GEN 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 6:4" />A bàkú mǝno sǝ a nzǝmi ka, akwatǝman-ɓwa, yia Nefilim<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">Nefilim </char><char style="ft" closed="false">ngga yakǝla à nda ka amǝ'turonjar mala Ɓakuli mana à kpana ka. (</char><char style="xt"><ref loc="1PE 3:20">1Bit 3:20</ref></char>).</note> ngga, à ndakam a ɓanza, sǝ lang amuna mala Ɓakuli nongnǝ amuna-mamǝna mala aɓwapǝndǝa ka à ɓǝlki amunia. À nda ka akanggǝrang aɓwana, amǝ'lwa mǝnana lullǝia zǝ́kí ɗiɗyal ka.<verse eid="GEN 6:4" /></para>
  <para style="s">Ɓakuli tsǝki Nuhu bù</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />Mǝtalabangŋo pelǝki ɓikipa mala ɓealɓikea mala ɓwapǝndǝa a ɓanza, sǝ sǝni ka koya ɗenyicau mala ɓabum ɓwapǝndǝa ka mǝɓike na koya pwari.<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 8:21">Tite 8:21</ref>; <ref loc="PSA 14:1-3">Ang 14:1-3</ref>; <ref loc="PRO 6:18">Pas 6:18</ref>; <ref loc="MAT 15:19">Mat 15:19</ref>; <ref loc="ROM 1:28-32">Rom 1:28-32</ref></char>.</note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />Mǝtalabangŋo pak ɓǝnsǝlǝma nǝ pusǝ ɓwapǝndǝa aɓa ɓanza. Gìrnî ɓungi ɓabumi kǝ̀rkǝ́r.<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 23:19">Ɓal 23:19</ref>; <ref loc="1SA 15:11">1Sam 15:11</ref>,<ref loc="1SA 15:29">29</ref>; <ref loc="2SA 24:16">2Sam 24:16</ref>; <ref loc="JOL 2:13">Jol 2:13</ref></char>.</note> <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />Sǝ Mǝtalabangŋo bang ama, &lt;&lt;Mǝ nǝ esǝki ɓwapǝndǝa mǝnana ǝn pe ka a ɓanza; mǝ nǝ kiɗikia atārǝia andǝ agirkusǝu mǝgulke, andǝ amǝkèke mǝnana à kǝ ɓang amur nzali, andǝ anyal mǝnana a bumkuli ka. Ən pak ɓǝnsǝlǝma nǝ pea.&gt;&gt; <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />Sǝ mala Nuhu ka, kum earmúrú aban Mǝtalabangŋo.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 19:19">Tite 19:19</ref>; <ref loc="EXO 33:17">Pur 33:17</ref>; <ref loc="LUK 1:30">Luk 1:30</ref></char>.</note><verse eid="GEN 6:8" /></para>
  <para style="s">Ɓakuli ne Nuhu ɓǝ̀ gballì nggea-waru</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />Mǝnia ka nda cau mǝnana à gilǝì amur Nuhu andǝ ɓala male ka. Nuhu ka nggea mǝɓealɓoarna na aban Ɓakuli; atà aɓwana mǝnana a nza male ka, kǝ yì na do male pàk jik ka. Nuhu kpata njar mala Ɓakuli. <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />Nuhu ka ndanǝ amuna-burana tàrú. Lullǝia ma: Shem, sǝ Ham, andǝ Jafet.<verse eid="GEN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 6:11" />Ɓakuli sǝni adyan ngga ɓanza ka kǝ cauɓikea nda mùrú hasǝa mala ɓwapǝndǝa, nyare lùmsǝ nǝ caukpaka.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="fq" closed="false">caukpaka </char><char style="ft" closed="false">ko </char><char style="fqa">ɓealɓikea</char>.</note> <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />Ɓakuli pelǝki ka, cauɓikea marǝkina ɓanza kàngkàng, acemǝnana koyan a ɓanza ka anjar male kiɗikina nǝ ɓealɓikea.<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="JOB 22:15-17">Ayu 22:15-17</ref>; <ref loc="PSA 14:2-3">Ang 14:2-3</ref>; <ref loc="PSA 53:2-3">53:2-3</ref></char>.</note> <verse eid="GEN 6:12" /><verse number="13" style="v" sid="GEN 6:13" />Ɓakuli pǝlǝa ne Nuhu ama, &lt;&lt;Mǝ ndo mǝ nǝ twalta ɓwapǝndǝa kat, acemǝnana ɓanza lùmsǝ nǝ caukpaka. Mǝsǝcau ka, mǝ nǝ kiɗiki ɓwapǝndǝa andǝ ɓanza. <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />We ka gballî ɓamur rǝò nggea-waru nǝ nggun gofa, sǝ wu lanzǝ ɓālǝi andǝ nzǝmi nǝ myang mǝcandǝe mǝnana mùr pà nǝ̀ sùr kàm raka. Kasǝki akurǝm aɓalǝi. <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />Ani sǝ awu nǝ gballì warunì: Sauwa male ka, kusǝu gbǝman-ine nǝ lumi-tongno (450). Tangŋa male ka kusǝu lumi-tongno-nong-ɓari bwamdǝ tongno (75). Sǝ dāh'rya male ka, kusǝu lumi-ine bwamdǝ-tongno na (45). <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />Gballì mùrí, sǝ wu nying nreban mǝnana tangŋa male ka ɓakusǝu mwashat na nǝ tsùrú aɓata mùrí sǝ arǝ agírǝí, ɓǝ̀ kàrìban kat. Gballì ɓá warunì ɓǝ̀ pangnǝ aɓalǝ akurǝm a nzali, a ɓalǝu, sǝ a kùli, sǝ wu tsǝk kun waru a nkanggari. <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />Sǝni! Mǝ ndo mǝ nǝ yinǝ nggea mùr-gùla a ɓanza mǝnana nǝ̀ yia twalta gìr mana kat ndanǝ yilǝmu ka. Koman a ɓanza kǝ lin'ueo ka nǝ̀ wú.<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 7:4">Tite 7:4</ref>; <ref loc="2PE 2:5">2Bit 2:5</ref></char>.</note> <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />Sǝama we ka, mǝ nǝ tamsǝ kùrcau mem a nre sǝm, sǝm nǝ we. Awu nǝ kútí aɓa waru, we sǝ māmó, sǝ amunio andǝ amālia.<note caller="+" style="f"><char style="fr" closed="false">6:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 9:9-16">Tite 9:9-16</ref>; <ref loc="GEN 17:7">17:7</ref></char>.</note> <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />Awu nǝ yinǝ koya ulang girkusǝu ɓari-ɓari: jamne andǝ mǝ'nggaule, atò a waru, ace mǝnana wu amsǝia ka. <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />Koya ulang nyal ka, awu nǝ oasǝ ɓari-ɓari a waru, sǝ koya ulang girkusǝu ka, awu nǝ oasǝ ɓari-ɓari a waru, andǝ koya ulang gìr mǝyilǝmui mǝnana kǝ ɓang a nzali ka ɓari-ɓari, ɓǝà yiu atò aɓa waru. <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />Awu nǝ ram koya ulang girlina ma'wun, sǝ mala agirkusǝu, mana nǝ̀ karǝban kat ka.&gt;&gt;<verse eid="GEN 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 6:22" />Nuhu pàk koya gìr ka a nggùnì kǝla mǝnana Ɓakuli ne wi ka.<note caller="+" style="f"><char style="fr" closed="false">6:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 7:5">Tite 7:5</ref></char>.</note> <figure style="fig" alt="Noah made an ark" file="CO00626B.TIF" size="col" loc="6:22" copy="Cook OT Images" ref="6:9-22">Nuhu gballì nggea-waru</figure><verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">Ɓakuli tasǝ mùr-gùla ɓǝ̀ yi aki ɓanza</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />Mǝtalabangŋo ne Nuhu ama, &lt;&lt;Yiu kùtí aɓa nggea-waru, we wunǝ amǝ'ɓala mò kat, acemǝnana a nda kǝ ɓwa mǝnana ǝn sǝni mǝ'ɓealɓoarna aɓalǝ aɓwana mana à ndanǝ yilǝmu ado ka.<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 24:38-39">Mat 24:38-39</ref>; <ref loc="LUK 17:26-27">Luk 17:26-27</ref>; <ref loc="HEB 11:7">Ib 11:7</ref></char>.</note> <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />Twal koya girkusǝu mǝnana mǝɓoarne<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 8:20">Tite 8:20</ref>; <ref loc="LEV 11:1-31">Pǝris 11:1-31</ref>; <ref loc="DEU 14:3-20">Nggur 14:3-20</ref></char>.</note> na ace girlina ka, jamne tongno-nong-ɓari sǝ mamǝne tongno-nong-ɓari, wu yinǝia atò aɓa nggea-waru. Ɗǝm ngga twal ɓari-ɓari atà koya girkusǝu mǝnana gìr'ɓeami na ace girlina ka, komǝye ka jamne andǝ mamǝna, ɓǝà kùtí atò a waru. <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />Twal atò ɗǝm koya nyal mǝnana kǝ yal a kùli ka tongno-nong-ɓari, komǝyenani ka jamne andǝ mamǝne. Pàk mǝnia ka ace mǝnana atà koya ulang girkusǝu andǝ koya ulang nyal ka, ɓǝà kum amǝnana à nǝ̀ pangnǝ yilǝmu ace ɓǝla malea a ɓanza ɗǝm ngga. <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />Anzǝm nongŋo tongno-nong-ɓari, tite ado ka, mǝ ndo mǝ nǝ nya mbulo mǝnana nǝ̀ nggǝ nya dù lumi-ine andǝ pwari lumi-ine. Aɓa pě anggo ka, mǝ nǝ twalta koya gìr mana nǝyilǝmu ǝn pê a ɓanza ka.&gt;&gt; <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />Nuhu pàk koya gìr mǝnana kat Mǝtalabangŋo banggi wi ɓǝ̀ pàk ka.<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 6:22">Tite 6:22</ref></char>.</note><verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />Nuhu ka ndanǝ apǝlǝa gbǝman-tongno-nong-mwashat (600) sǝ mùr-gùla yi aki ɓanza. <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />Yì andǝ māmí, andǝ amuni andǝ amālia, à kùtí aɓa nggea-waru ace apî mùr-gùla. <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />Koya ulang girkusǝu andǝ koya ulang nyal, yia ɓari-ɓari; amǝnana Ɓakuli bang ama amǝɓoarne na ace girlina, andǝ amǝnana bang ama agir'ɓeami na ka. Kpapi andǝ amǝnana à kǝ ɓang a kwàr nzali ka. Komǝye ateà ka, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />jamne andǝ mamǝne, à yiu aban Nuhu à yì kútí aɓa nggea-waru, kǝla mǝnana Ɓakuli banggi Nuhu ɓǝ̀ pàk ka. <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />Anzǝm nongŋo tongno-nong-ɓari ka, mùr-gùla yi aki ɓanza.<verse eid="GEN 7:10" /></para>
  <para style="s">Ɓakuli amsǝ Nuhu andǝ ɓala male</para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />Aɓa pǝlǝa mǝnana Nuhu lùmsǝ̀nà pǝlǝa gbǝman-tongno-nong-mwashat (600) nǝi a ɓanza, a lum bwamdǝ tongno-nong-ɓaria pwari mala ɓaria zongŋo ka, akun atūli-mùr mǝnana atà nzali kat ka à mǝngia, sǝ mbulo ɓun nǝ bumkuli kpana-kpana. <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />Mbulo nya aɓa ɓanza twal nongŋo lumi-ine, du andǝ pwari.<verse eid="GEN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 7:13" />Akǝ mǝno yì pwari mbulo tinata nya nǝi ka, Nuhu andǝ amuna-burana male tàrú, Shem, andǝ Ham, sǝ Jafet, à kùtí aɓa waru atārǝia andǝ mālá Nuhu andǝ amālá amuna-burana male mǝno tàrú ka. <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />À oasǝ akoya girkusǝu ateà a waru: anyam-bondo andǝ anyam-ɓala, amǝgulke andǝ amǝkèke, andǝ koya ulang nyal. <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />Girbunda man kat kǝ lin'ueo ka, à yiu ɓari-ɓari à yì kùtí atà Nuhu a waru. <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />Agirkusǝu mana à kútí ka, jamne andǝ mǝ'nggaule mala koya ulang gìr-yilǝmu na, kǝla mǝnana Ɓakuli ne wi yì Nuhu ka. Pǝlǝa Mǝtalabangŋo gìr kun waru nǝ Nuhu aɓalǝi.<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />Mùr-gùla camarǝ yiu sǝ kǝ lime a ɓanza kya bwal nongŋo lumi-ine. Mùr lo gul kǝ̀rkǝ́r, kara loasǝ waru a kùli. Waru kya purrì múr ɓanza piku-piku. <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />Mùr long nǝ lo ana kpana-kpana amúr ɓanza kat, waru kǝ kyal nǝmurǝì amúr mùr. <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />Mùr camarǝ lo gandǝa kya kongsǝ ankono mǝ'dāh'rike kat mala koya ban a ɓanza. <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />A masǝlǝate ka, mùr kya lim kǝ̀rkǝ́r yàle ankono mana à kutiban kat nǝ dāh'rya ka, mùr kongsǝ múrià nǝ lime ɓakusǝu lumi-ɓari nǝ mǝsǝì ɓari (22). <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />Koya gìr nani mana ndanǝ yilǝmu ka, wù kat: anyal, anyam-ɓala andǝ anyam-bondo, amuna-nyama mǝkèke mǝnana à kǝ kuɗǝki a kwàr nzali, andǝ ɓwapǝndǝa kat, wu puppup. <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />Koya gìr mana kǝ lin'ueo sǝ do a ɓanza man ngga, tè twal kat. <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />Mǝtalabangŋo twalta koya gìr mana kǝ lin'ueo a ɓanza man ngga: aɓwana, agirkusǝu, agir-yilǝmu mǝkèke mǝnana à kǝ ɓang a kwàr nzali, andǝ anyal mǝnana a bumkuli ka, twaltea kat a ɓanza. Kǝ aɓwana mana à au ka, à nda ka Nuhu andǝ aɓwana mǝnana atè aɓa waru ka. <note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1PE 3:20">1Bit 3:20</ref>; <ref loc="2PE 2:5">2Bit 2:5</ref></char>.</note><verse eid="GEN 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 7:24" />Mùr aki ɓanza pàk nongŋo gbǝman-mwashat nǝ lumi-tongno (150).<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">Masǝlǝata mùr-gùla</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />Sǝ cau mala Nuhu andǝ anyam-ɓabondo andǝ anyam-ɓala mana atè aɓa waru ka nda a ɓabum Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 19:29">Tite 19:29</ref>; <ref loc="EXO 2:24">Pur 2:24</ref>; <ref loc="1SA 1:19">1Sam 1:19</ref>; <ref loc="PSA 105:42">Ang 105:42</ref></char>.</note> Nda tasǝ gung ɓǝ̀ ɓua amur ɓanza, mùr pǝlǝa tita sonzǝo. <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />Amáɗí-mùr mana a tà-nzali ka à tākya, ɓunno mala mùr mana nǝ bumkuli kpana-kpana ka amsǝa, sǝ mbulo tukio. <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />Mùr pǝlǝa tita nyar ɓukɓuk aban sonzǝo a ɓanza. Lang yi lùmsǝ̀nà anongŋo gbǝman nǝ lumi-tongno (150) ka, mùr sonzǝna adyan pepè. <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />Aɓa lum bwamdǝ-tongno-nong-ɓaria pwari mala tongno-nong-ɓaria zongŋo ka, nggea-waru yi came amúr ɓè nkono aɓalǝ ankono mala nzali Ararat. <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />Mùr lidǝmba nǝ nyar nǝ te yi pur a lumia zongŋo. Aɓa pwari mǝdǝmbe mala lumia zongŋo ka, ɓong ankono sa a nza. <verse eid="GEN 8:5" /><verse number="6" style="v" sid="GEN 8:6" />Anzǝm anongŋo lumi-ine ka, Nuhu mǝn fongǝran mǝnana pè arǝ nggea-waru ka, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />pǝlǝa tasǝ gang'lang ɓǝ̀ puro. Gang'langnì camarǝ gāli, nǝ̀ ká sǝ nǝ̀ nyare bà ime mala mùr a nzǝm-nzali. <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />Anzǝm mǝno bǝti ka, Nuhu tasǝ kutu ɓǝ̀ kya sǝni ko mùr sonzǝna, nza sangna. <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />Kutu gandǝ kum ban sulǝo ɗang acemǝnana mùr nakam più, akban kat a ɓanza. Kutu pǝlǝa nyare aban Nuhu a waru. Nuhu lǝmdǝ bui a fongǝran, ak kutu, sǝ nyesǝi aɓa nggea-waru. <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />Anzǝm nongŋo tongno-nong-ɓari ka, Nuhu nyare tasǝ kutu ɗǝm ɓǝ̀ puro. <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />Lang pwari nǝ̀ ká kpa ka, kutu nyare yiu, sǝ Nuhu sǝni ka, mbú nggun-olif mǝpwale na a kúni. Nda Nuhu sǝlǝa ama mùr-gùla nyarna nǝ te. <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />Nuhu kundǝ ɗǝm aɓea nongŋo tongno-nong-ɓari, sǝ nyare tasǝ kutu ɓǝ̀ kyane. Lang kutu umna ka nyare yiu ɗǝm ɗàng. <figure style="fig" alt="Dove returned to Noah with olive leaf in its mouth." file="CO00632B.TIF" size="col" loc="8:12" copy="Cook OT" ref="8:8-12">Kutu nyar nǝ mbu nggun-olif a kúni aban Nuhu</figure><verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />Adyan ngga, Nuhu ndanǝ apǝlǝa a ɓanza gbǝman-tongno-nong-mwashat nǝ mǝsǝì mwashat (601). A pwari mǝdǝmbe mala zongŋo mǝdǝmbe mala mǝno yì pǝlǝa ka, mùr sonzǝni ɓanza. Nuhu pǝlǝa loasǝ gìr mǝnana kùmsǝ̀ múr waru ka. Lang nǝ̀ sǝnban ngga nzali imǝna. <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />Aɓa lumi-ɓari bwamdǝ tongno-nong ɓaria (27) pwari mala ɓaria zongŋo ka, ɓanza imǝna kat!<verse eid="GEN 8:14" /></para>
  <para style="s">Bǝsa tite</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />Pǝlǝa Ɓakuli ne Nuhu ama, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />&lt;&lt;Wu pùrrî ɓá waru, we sǝ māmó, sǝ amunio andǝ amālia. <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />Pusǝ koya gìr-yilǝmu mana atò a waru ka: anyal, andǝ agirkusǝu andǝ amǝnana àkǝ kuɗǝki a kwàr nzali ka: ace mǝnana ɓǝà yi ɓǝla, ɓǝà hatǝki, ɓǝà aki ɓanza ka.&gt;&gt;<verse eid="GEN 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 8:18" />Nda Nuhu pùrrî ɓá waru, yì andǝ māmí andǝ amuni andǝ amālia. <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />Sǝ koya girkusǝu, koya gìr mana kǝ pūrǝki nǝ múrbumi a nzali, andǝ koya nyal, andǝ koya gìr mana kǝ gya a ɓanza ka, à pùrrî ɓá waru kat, koya mbalangni a ɓinalea.<verse eid="GEN 8:19" /></para>
  <para style="s">Pàcau mala Ɓakuli aban Nuhu</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />Pǝlǝa Nuhu ɓakkî Mǝtalabangŋo gyangŋan; twal atà koya girkusǝu andǝ nyal mǝnana amǝɓoarne na ace girlina ka, pana gir'nkila mala pisǝe kǝring nǝia amur gyangŋan. <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />Mǝtalabangŋo ka banɓoari wi nǝ ok rǝm mǝno yì ɓoro ka. Ne ɓamúrì ama, &lt;&lt;Pà mǝ nǝ sú nzali ɗǝm ace cau mala ɓwapǝndǝa ɗang, ko kat andǝ amani ama koya ɗenyicau malea lùmsǝo nǝ ɓealɓikea twal a lo-ɓwa malea ka. Pa mǝ nǝ nyar ɗǝm mǝ nǝ kiɗiki gìr mǝnana ǝn pe, mana ndanǝ yilǝmu ka ɗàng. <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />Ɓǝ̀ mbak sǝ ɓanza na kam ngga, pwari ɓeale, sǝ pwari cane, kunɗwal andǝ gungpi, mbulo sǝ kunte, pwari andǝ du, à pà nǝ̀ ue ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 33:20-21">Ir 33:20-21</ref>,<ref loc="JER 33:25-26">25-26</ref></char>.</note><verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">Ɓakuli kùrcau nǝ Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />Ɓakuli tsǝki Nuhu andǝ amuni bu sǝ nea wia ama:</para>
  <para style="pi" vid="GEN 9:1">Wu ɓǝla, wu hatǝki, wu lùmsǝ ɓanza.<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 1:28">Tite 1:28</ref>; <ref loc="GEN 8:17">8:17</ref>; <ref loc="GEN 9:7">9:7</ref>; <ref loc="GEN 35:11">35:11</ref></char>.</note> <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />Koya nyam-bondo, sǝ koya nyal a bumkuli, andǝ koya gìr mǝnana kǝ kuɗǝki a nzǝm-nzali, andǝ anji kat a nggeamùr, à nǝ̀ nggǝ ɓangga wun sǝ múrià nǝ̀ kària arǝ wun. Ən pana wunia kat a bù wun. <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />Koya gìr mǝnana kǝ gya sǝ ndanǝ yilǝmu ka, nǝ̀ duk girlina ma'wun. Kǝla mǝnana ǝn pa wun agirpwala ɓǝà duk girlina ma'wun ngga, ǝn pana wun girbunda kat. <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />Kǝgìr mǝnana pa wu nǝ li raka nda nyama mǝnana yilǝmi na aɓa nyami più ka, mǝnana nda nkile ka.<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 3:17">Pǝris 3:17</ref>; <ref loc="LEV 7:20">7:20</ref>; <ref loc="LEV 17:10-16">17:10-16</ref>; <ref loc="LEV 19:26">19:26</ref>; <ref loc="DEU 12:16">Nggur 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref>; <ref loc="1SA 14:34">1Sam 14:34</ref>; <ref loc="ACT 15:20">Atúró 15:20</ref>,<ref loc="ACT 15:29">29</ref></char>.</note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />Ɓwa mǝnana twal yilǝmi ɓwa ka, mǝ nǝ ɗice mǝno yì yilǝmu ka a bu kǝ ɓwe. Sǝ ɓǝ̀ girkusǝu na gbal sǝ wal-lú ɓwa ka, girkusǝunì gbal ka ɓǝà wali ɓǝ̀ wú.<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:13">Pur 20:13</ref>; <ref loc="EXO 21:28">21:28</ref></char>.</note><verse eid="GEN 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 9:6" />Ɓǝ̀ yana sǝ twal yilǝmi ɓwa ka,</para>
  <para style="q2" vid="GEN 9:6">yì gbal ka à nǝ̀ twal yilǝmi,</para>
  <para style="q1" vid="GEN 9:6">acemǝnana Ɓakuli pak ɓwapǝndǝa</para>
  <para style="q2" vid="GEN 9:6">aɓa purban male.<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 21:12-14">Pur 21:12-14</ref>; <ref loc="LEV 24:17">Pǝris 24:17</ref>; <ref loc="NUM 35:33">Ɓal 35:33</ref>; <ref loc="MAT 26:52">Mat 26:52</ref></char>.</note><verse eid="GEN 9:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="GEN 9:7" />Wun ngga, wu ɓǝla, wu hatǝki, wu akiban a ɓanza.<verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />Pǝlǝa Ɓakuli ne Nuhu andǝ amuni ama, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />&lt;&lt;Mǝ ndya ǝn nggǝ tamsǝ kùrcau mem sǝnǝa wun andǝ amuna wun andǝ amǝkà wun, <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />sǝ nǝ́ koya girkusǝu mǝnana kutio atà wun aɓa waru ka; anyal, andǝ anyam-ɓala andǝ nyam-bondo; andǝ koya gìr nani mǝnana ndanǝ yilǝmu a ɓanza ka. <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />Mǝ ndya ǝn nggǝ tamsǝ kusǝ kùrcau mem nǝ wun ngga: Mùr-gùla pa nǝ̀ nyar ɗǝm nǝ̀ twalta yilǝmu ɗàng. À pà nǝ̀ kiɗiki ɓanza ɗǝm nǝ nggea mùr-gùla ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 54:9-10">Isha 54:9-10</ref></char>.</note><verse eid="GEN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 9:12" />Ɓakuli nyare na ama, &lt;&lt;Mǝnia ka nda gìr'lǝmdǝa mala kùrcau mǝnia ǝn nggǝ kùrì a nrem sǝm sǝnǝa wun andǝ koya gìr mana nǝyilǝmu atà wun ngga, kùrcau mana nda ace anza mǝnana à kǝ yiu peatu ka: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />Ən tsǝ́ngŋǝ̀nà npāring aɓalǝ apǝrɓang. Nda gìr'lǝmdǝa mem mala kùrcau a nrem andǝ ɓanza ka. <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />Ɓǝ̀ nda aya pwari sǝ ǝn sulǝ apǝrɓang amur ɓanza, sǝ npāring pusǝrǝi aɓalǝ apǝrɓang ngga, <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />mǝ nǝ ɗenyi nǝ kùrcau mem mǝnia ǝn pangnǝ wun andǝ koya ambalang agir mǝnana à ndanǝ yilǝmu ka. Nggea mùr-gùla pa nǝ̀ nyare nǝ̀ twalta yilǝmu ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 26:42">Pǝris 26:42</ref>,<ref loc="LEV 26:45">45</ref>; <ref loc="DEU 7:9">Nggur 7:9</ref>; <ref loc="1KI 8:23">1Amur 8:23</ref>; <ref loc="EZK 16:60">Ezǝk 16:60</ref></char>.</note> <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />Ɓǝ̀ aya pwari sǝ npāring pusǝrǝi aɓalǝ apǝrɓang ngga, mǝ nǝ sǝnì, sǝ ɓalǝam nǝ̀ kasǝa arǝ kùrcau mana málá male pà kàm raka, mǝnana a nre Ɓakuli andǝ yilǝmu kat a ɓanza ka.&gt;&gt;<verse eid="GEN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 9:17" />Pǝlǝa Ɓakuli ne Nuhu ama, &lt;&lt;Mǝnia yì npāring ngga, nda gìr'lǝmdǝa mala kùrcau mǝnana ǝn tsǝì a nrem andǝ yilǝmu kat a ɓanza ka.&gt;&gt;<verse eid="GEN 9:17" /></para>
  <para style="s">Nuhu nu mùr anap sǝ wali</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />Amuna-burana mala Nuhu mana à purî ɓá waru ka à nda ka Shem, andǝ Ham sǝ Jafet. Ham ɓǝl muna-ɓwabura lùllǝì ama Kan'ana. <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />Amǝnia yì amuna-burana mala Nuhu tàrú ka, à nda à yi ɓǝl ɓwapǝndǝa kat mana à mesǝ a koya ban a ɓanza ka.<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />Nuhu ka mǝrya na sǝ nda tita tsǝk ɓaban mala anggun-anap ka. <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />A ɓè pwari ka, Nuhu nu mùr-ɓǝlanggun anap mǝhangŋe kǝ̀rkǝ́r, mùr anap wàlì, pǝlǝa kpa nong nǝ ɓate aɓa tara male. <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />Ham, tár Kan'ana ka sǝn tárrí aban nongŋo nǝ ɓate. Pǝlǝa puro wari a nza kya banggi amǝ'eambi mǝnia ɓari ka. <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />Sǝ Shem andǝ Jafet ka, à twal lagir à mǝni a nzǝmia sǝ à ging nǝ nzǝm à yi kùmsǝî tárrià amurí, gìr ɓate. À pǝlǝ mǝsǝia nǝ ɓe ban ɗàng, à sǝn ɓata tárrià ɗàng. <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />Lang dǝm Nuhu kwarna ka, yi sǝlǝce gìr mǝnana Ham, muni mǝkyauwe pakki wi ka. <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />Bang ama,</para>
  <para style="q1" vid="GEN 9:25">&lt;&lt;Súban ɓǝ yiu amúr Kan'ana!</para>
  <para style="q2" vid="GEN 9:25">Yì ka nǝ̀ duk guro mala aguro</para>
  <para style="q2" vid="GEN 9:25">aban amǝ'eambi.<verse eid="GEN 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26" />Ɓwangsǝban ɓǝ pa aban Mǝtalabangŋo, Ɓakuli mala Shem!</para>
  <para style="q2" vid="GEN 9:26">Kan'ana nǝ̀ duk guro mala Shem.<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />Ɓakuli ɓǝ̀ tangsǝ nzong-nzali mala Jafet!</para>
  <para style="q1" vid="GEN 9:27">Amuna male andǝ amǝkè nǝ̀ do atārǝia andǝ aɓwana mala Shem!</para>
  <para style="q2" vid="GEN 9:27">Kan'ana nǝ̀ duk guro mala Jafet.&gt;&gt;<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />Anzǝm pa mala mùr-gùla ka, Nuhu pàk aɓea pǝlǝa gbǝman-tàrú nǝ lumi-tongno (350). <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />Do ɓanza mala Nuhu kat ka pǝlǝa gbǝman-tongno-nong-ine nǝ lumi-tongno na (950). Anzǝm mǝno ka sǝ yi wú.<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s1">Amuna andǝ amǝkau a tàu mala Nuhu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />Amǝnia ka à nda ka amuna andǝ amǝkau a tàu mala Shem, andǝ Ham, andǝ Jafet, yì amuna-burana mala Nuhu. Yia mǝnia tàrú ka à ɓǝlki amuna anzǝm málá mala mùr-gùla.<verse eid="GEN 10:1" /></para>
  <para style="s2">Tau mala Jafet</para>
  <para style="li1">
    <verse number="2" style="v" sid="GEN 10:2" />Amuna-burana mala Jafet<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Jafet </char><char style="ft" closed="false">ka nda tár amǝ Gǝrik.</char></note> ka à nda ka:</para>
  <para style="li2" vid="GEN 10:2">Goma<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Goma </char><char style="ft" closed="false">ka nda tár amǝ Cimmeri.</char></note>, Magog, Madai<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Madai </char><char style="ft" closed="false">ka nda tár amǝ Medes a nzali Assuriya.</char></note>, Javan<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Javan </char><char style="ft" closed="false">ngga nda tár amǝ Hellen.</char></note>, Tubal, Meshek<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Meshek </char><char style="ft" closed="false">ka nda tár amǝ Musku.</char></note> andǝ Tiras<note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="fq" closed="false">Tiras </char><char style="ft" closed="false">ka nda tár amǝ nzali Tǝres.</char></note>.<verse eid="GEN 10:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="GEN 10:3" />Amuna andǝ amǝkà Goma ka à nda ka:</para>
  <para style="li2" vid="GEN 10:3">Amǝ Asǝkena, amǝ Rifat andǝ amǝ Togama.<verse eid="GEN 10:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="GEN 10:4" />Amuna andǝ amǝkà Javan ngga à nda ka ɓwapǝndǝa mala anzali:</para>
  <para style="li2" vid="GEN 10:4">Elisha, Tarshi,<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">Tarshi </char><char style="ft" closed="false">ka nda nzali Sǝpen.</char></note> Kitim,<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">Kitim </char><char style="ft" closed="false">ngga nda nzali Sayipǝrus.</char></note> andǝ Rodanim<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="fq" closed="false">Rodanim </char><char style="ft" closed="false">ngga nda nzali luran Rodis.</char></note>.<verse eid="GEN 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 10:5" />(A tǝrta aɓwana mǝnia ka sǝ aɓwapǝndǝa mǝnana à duki arǝ aluran aɓa nggeamùr andǝ akún nggeamùr ka à puro. À nda ka amǝkà Jafet mǝnana à mesǝe arǝ anzali ɗàngɗáng, sǝ koyan ateà ka à súrǝì nǝ kún male, sǝ tàu male, andǝ nzali male mǝnana pàk kàm ngga.)<verse eid="GEN 10:5" /></para>
  <para style="s2">Tau mala Ham</para>
  <para style="li1">
    <verse number="6" style="v" sid="GEN 10:6" />Amuna-burana mala Ham ngga à nda ka:</para>
  <para style="li2" vid="GEN 10:6">Kush<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Kush </char><char style="ft" closed="false">ka nda nzali Nubiya, Itiyopiya andǝ Sudan.</char></note>, Mizǝrayim<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Amǝkà </char><char style="fq" closed="false">Mizǝrayim </char><char style="ft" closed="false">na à do a nzali Masar ka.</char></note>, Put<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Amǝkà </char><char style="fq" closed="false">Put </char><char style="ft" closed="false">kya do a nzali Libiya.</char></note> andǝ Kan'ana.<verse eid="GEN 10:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="GEN 10:7" />Amuna mala Kush ka à nda ka</para>
  <para style="li2" vid="GEN 10:7">Seba,<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Seba </char><char style="ft" closed="false">ka à do a nzali Masar.</char></note> Havila,<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Havila </char><char style="ft" closed="false">ka à do a takuli mala nzali Arabiya.</char></note> Sapta,<note caller="+" style="f"><char style="fr" closed="false">10:7</char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Sapta </char><char style="ft" closed="false">ka à do a bu njar-nzali mala kún nggeamùr mala amǝ Pashia.</char></note> Raama,<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Raama </char><char style="ft" closed="false">ka à do nre njar kún múr andǝ njar-nzali a nzali Arabiya.</char></note> andǝ Sapteka.<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Sapteka </char><char style="ft" closed="false">ka à do a Samudeka a kún nggeamùr mala amǝ Pashia</char></note></para>
  <para style="li1" vid="GEN 10:7">Amuna mala Raama ka à nda ka</para>
  <para style="li2" vid="GEN 10:7">Sheba<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Amǝ </char><char style="fq" closed="false">Sheba </char><char style="ft" closed="false">ka à nda ka amǝ nzali njar kún múr mala nzali Arabiya.</char></note> andǝ Dedan.<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="fq" closed="false">Dedan </char><char style="ft" closed="false">ngga à nda ka amǝ nzali njar-nza mala nzali Arabiya.</char></note><verse eid="GEN 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="GEN 10:8" />Ɓè ɓwa atà amǝkà Kush ka nda Nimro. Yì Nimro ka nda ɓwa mǝnana tita duk ɓwa mǝcandǝe a ɓanza ka. <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />Nǝ́ pâ gbasha mala Mǝtalabangŋo ka, yi duk nggeà kanggǝrang mǝ'nta. Acemani ka aɓwana kǝ na ama, &lt;&lt;Ɓǝ̀ Mǝtalabangŋo tsǝo wu duk kanggǝrang mǝ'nta kǝla Nimro!&gt;&gt; <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />Anggea-là mǝnana à ɓoaro à kutiban kat aɓata nzali-murǝm mala Nimro a nzali Shinar<note caller="+" style="f"><char style="fr" closed="false">10:10 </char><char style="fq" closed="false">Shinar </char><char style="ft" closed="false">ka nda nzali-murǝm mala Babiloniya a njar-kúnmur aɓa nzali-gula Mesopotamiya a pwarian ɓara-ɓara; Amǝ nzali Babiloniya limurǝm a lwa amur amǝ nzali Isǝrayila kǝla pǝlǝa gbǝman tongno-nong-mwashat, kaniama ɓǝ̀ Kǝrǝsti yiu (600 BC). À pwan amǝ Isǝrayila à umnǝia a do bǝri-nzali a nggea-là Babila (ban mǝnana Daniyel kya duk mǝpà kwarkiru aban murǝm kam, sǝ Ezǝkiyel kum sǝna aɓa bangŋo kam ngga).</char></note> ka à nda ka Babila, andǝ Erek, andǝ Akat andǝ Kalne. <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />Nimro pur a nzali Shinar sǝ o a nzali Assuriya kya ɓakia anggea-là Nineva, andǝ Rehobot-Ir, andǝ Kalne<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MIC 5:6">Mik 5:6</ref></char>.</note> <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />andǝ Resen kàm. Resen ngga nggea-là na a nre Nineva andǝ nggea-là mǝgule Kalne.<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />Mizǝrayim<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="fq" closed="false">Mizǝrayim </char><char style="ft" closed="false">nda lullǝ nzali Masar nǝ kún Ibǝru.</char></note> ngga nda tár a Lud,<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="fq" closed="false">Lud </char><char style="ft" closed="false">ka nda yi duk nzali Lidiya ka.</char></note> Anam, Lehap, Naftu, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />Patǝru, Kasǝlu, andǝ Kafto.<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="fq" closed="false">Kafto </char><char style="ft" closed="false">ka nda luran Kǝreti.</char></note> Arǝ abân mǝnia ka sǝ amǝ Filisti puro à yiu.<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />Muna-ɓwabura mǝkyauwe mala Ham yì Kan'ana ka nda yi duk tár Sidon andǝ amǝ'Hitti ka. <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />Kan'ana ɗǝm ngga nda kàka amǝ'Jebus, amǝ'Amor, amǝ'Girgash, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />amǝ'Hivi, amǝ'Arkit, amǝ'Sǝni, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />amǝ'Arǝvad, amǝ'Zema, andǝ amǝ'Hamat.</para>
  <para style="b" vid="GEN 10:18" />
  <para style="p" vid="GEN 10:18">Nǝ nzǝ́mò ka aɓwapǝndǝa mǝnia à pùr a tàu mala Kan'ana ka, à yi mesǝke. <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />Acemani ka nzong-nzali mala amǝ'Kan'ana tangŋa tite a ban nggea-là Sidon sǝ sulǝo yi puro aban là Gera, pǝlǝa twalo a là Gaza sǝ sárǝ́ aban ká arǝ alá Sodom, Gomora, Adǝma andǝ Zeboyim, sǝ kya masǝlǝa a Lasha.<verse eid="GEN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 10:20" />Amǝno yì aɓwana kat ka, à pur a tàu mala Ham. Koyan ateà ka à súrǝì nǝ tàu male, sǝ kún male, sǝ bu-nzali male, andǝ nzali male mǝnana pàk kàm ngga.<verse eid="GEN 10:20" /></para>
  <para style="s2">Tau mala Shem</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />Shem mǝnana nda mǝgula Jafet ka à ɓǝlî wi amuna-burana gbal. Shem ngga nda kàka Eba andǝ amuni andǝ amǝkè kat.<verse eid="GEN 10:21" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="22" style="v" sid="GEN 10:22" />Amuna-burana mala Shem ngga à nda ka:</para>
  <para style="li2" vid="GEN 10:22">Elam, Asshur, Arfakza, Lud andǝ Aram.<verse eid="GEN 10:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 10:23" />Aɓwapǝndǝa mǝnana a tàu mala Aram ngga à nda ka:</para>
  <para style="li2" vid="GEN 10:23">Amǝ'Uz, amǝ'Hul, amǝ'Geta andǝ amǝ'Meshek.<verse eid="GEN 10:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 10:24" />Arfakza ka nda tár Shela, sǝ Shela ka nda tár Eba.<verse eid="GEN 10:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 10:25" />À ɓǝlî Eba amuna-burana ɓari.</para>
  <para style="li2" vid="GEN 10:25">Ɓè man mwashat ka à tunǝi ama Pele,<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fq" closed="false">Pele </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;mesǝe.&gt;&gt;</char></note> acemǝnana a nza male sǝ aɓwapǝndǝa mesǝe arǝ abân aɓa ɓanza; mǝ'eambi nda Joktan.<verse eid="GEN 10:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 10:26" />Joktan ngga nda tár a</para>
  <para style="li2" vid="GEN 10:26">Almoda, Shelep, Hazamave, Jera, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />Hadoram, Uzal, Dikǝla, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />Obal, Abimayel, Sheba, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />Ofir, Havila, andǝ amǝ'Jobap. Yia mǝnia kat ka, à nda ka amǝkà Joktan.<verse eid="GEN 10:29" /></para>
  <para style="b" />
  <para style="m">
    <verse number="30" style="v" sid="GEN 10:30" />Nzali-do mala aɓwana mǝnia kat ka, tite a Mesha sǝ sarǝa kya puro a Sefar, nzali múr ankono a njar-takuli.<verse eid="GEN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 10:31" />Amǝno ka, à nda ka amuna andǝ amǝkà Shem. Koyan ateà ka à súrǝì nǝ tàu male, sǝ kún male, sǝ bu-nzali male, andǝ nzali male mǝnana pàk kàm ngga.<verse eid="GEN 10:31" /></para>
  <para style="b" />
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />Aɓwapǝndǝa mǝno kat ka à nda ka amuna andǝ amǝkau mala amuna-burana mala Nuhu, koyan ngga nǝ nggurkwar mala tàu male, aɓalǝ anzali malea. Twalo abania sǝ aɓwapǝndǝa mesǝe arǝ aban aɓa ɓanza kat, anzǝm mùr-gùla.<note caller="+" style="f"><char style="fr" closed="false">10:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 9:19">Tite 9:19</ref></char>.</note><verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">Ɓakuli mesǝki aɓwana arǝ aban pas</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />Anggo ka kǝ kún mǝmwashati na ɓwapǝndǝa nakiyi a ɓanza kat ka, sǝ acau mǝmwashati na gbal à kǝ puro a kunia ka. <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />Lang ɓwapǝndǝa tita tùrki arǝ abân nǝ bù takuli ka, à kya kum ɓè ɓawanban a Shinar<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="fq" closed="false">Shinar </char><char style="ft" closed="false">ka nda nzali Babila.</char></note> pǝlǝa à duk kam. <note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 10:10">Tite 10:10</ref></char>.</note><verse eid="GEN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 11:3" />Sǝ à nea rǝia ama, &lt;&lt;Ɓǝ̀ sǝm ɓak atobali, sǝ ɓǝ̀ sǝm twania a bǝsa pepè.&gt;&gt; À paktúró nǝ dǝɓang ɗurǝkya a kúnì tali, sǝ kwalta do nda shiminti malea. <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />Pǝlǝa à na ama, &lt;&lt;Wu fani, ɓǝ̀ sǝm ɓàngŋǝ́nì nggea-là nǝ ndà-kulí nggea mǝ'dāhre mǝnana ɓǝ̀ u ɓong-ɓong a kùli ka, ace mǝnana ɓǝ̀ sǝm kumbi ɓamur rǝ sǝm lullǝu, sǝ ɓǝ̀ sǝm kǝa mesǝkì tarǝ sǝm aɓa ɓanza raka.&gt;&gt; <verse eid="GEN 11:4" /><verse number="5" style="v" sid="GEN 11:5" />Sǝ Mǝtalabangŋo sulǝo yiua sǝn nggea-là andǝ nggeaɓa mǝɓong-ɓongni mǝnana aɓwapǝndǝa ɓakkiyi ka. <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />Mǝtalabangŋo na ama, &lt;&lt;Ɓǝ̀ kǝla aɓwana mwashat, sǝ kún mǝmwashati na à nakiyi ka, sǝ à tita pàk gìr kǝla mǝnia ka, kǝgìr pà kàm mǝnana à kùr kunarǝia à nǝ̀ pè sǝ nǝ̀ gandǝia ka ɗàng. <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />Wu yiu sǝm nǝ̀ sùlǝ́nì, ɓǝ̀ sǝm kya zurǝkini kunia, ace mǝnana ɓǝà kǝa bwalta acau mǝnana à nakiyi arǝarǝia ka ɗàng.&gt;&gt;<verse eid="GEN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 11:8" />Nda Mǝtalabangŋo mesǝkia akanó arǝ aban aɓa ɓanza, kara à tamsǝ ɓak mǝno yì nggea-là ka. <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />Nda gìrnî sǝ à tsǝki banì lullǝu ama, Babel, acemǝnana akǝ banì sǝ Mǝtalabangŋo zurǝki kún mala ɓanza kat. A kàm ɗǝm sǝ Mǝtalabangŋo mesǝki aɓwana a bum ɓanza kat. <figure style="fig" alt="Tower of Babel" file="CO00638B.TIF" size="col" loc="11:9" copy="Cook OT images" ref="11:1-9">Nggea-là nǝ ndà-kulí nggea mǝ'dāhre mala Babila</figure><verse eid="GEN 11:9" /></para>
  <para style="s">Tau mala Shem</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />Mǝnia ka nda cau mǝnana à gilǝì amur Shem andǝ aɓwana mana a tàu male ka.</para>
  <para style="p" vid="GEN 11:10">Shem ngga ndanǝ pǝlǝa gbǝman-mwashat (100) sǝ ɓǝl Arfakza; ɓǝli a ɓaria pǝlǝa anzǝm yiu mala mùr-gùla. <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />Anzǝm ɓǝl Arfakza ka, Shem nyare pàk aɓea pǝlǝa gbǝman-tongno (500) a ɓanza sǝ ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />Lang Arfakza pàngŋǝ̀nà pǝlǝa lumi-tàrú bwamdǝ tongno (35) ka, yi ɓǝl Shela. <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />Anzǝm ɓǝl Shela ka, Arfakza pàk aɓea pǝlǝa gbǝman-ine nǝ mǝsǝi tàrú (403) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />Lang Shela pàngŋǝ̀nà pǝlǝa lumi-tàrú (30) ka, yi ɓǝl Eba <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />Anzǝm ɓǝl Eba ka, Shela pàk aɓea pǝlǝa gbǝman-ine nǝ mǝsǝi tàrú (403) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />Lang Eba pàngŋǝ̀nà pǝlǝa lumi-tàrú nǝ mǝsǝ ine (34) ka, yi ɓǝl Pele. <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />Anzǝm ɓǝl Pele ka, Eba pàk aɓea pǝlǝa gbǝman-ine nǝ lumi-tàrú (430) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />Lang Pele pàngŋǝ̀nà pǝlǝa lumi-tàrú (30) ka, yi ɓǝl Reyu. <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />Anzǝm ɓǝl Reyu ka, Pele pàk aɓea pǝlǝa gbǝman-ɓari bwamdǝ tongno-nong-ine (209) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />Lang Reyu pàngŋǝ̀nà pǝlǝa lumi-tàrú nǝ mǝsǝi ɓari (32) ka, yi ɓǝl Seru. <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />Anzǝm ɓǝl Seru ka, Reyu pàk aɓea pǝlǝa gbǝman-ɓari bwamdǝ tongno-nong-ɓari (207) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />Lang Seru pàngŋǝ̀nà pǝlǝa lumi-tàrú (30) ka, yi ɓǝl Naho. <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />Anzǝm ɓǝl Naho ka, Seru pàk aɓea pǝlǝa gbǝman-ɓari (200) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />Lang Naho pàngŋǝ̀nà pǝlǝa lumi-ɓari bwamdǝ tongno-nong-ine (29) ka, yi ɓǝl Tera. <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />Anzǝm ɓǝl Tera ka, Naho pàk aɓea pǝlǝa gbǝman-mwashat nǝ lum bwamdǝ tongno-nong-ine (119) a ɓanza. Aɓalǝ apǝlǝa mǝno ka, ɓǝlki aɓea amuna-burana andǝ amuna-mamǝna.<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />Anzǝm mana Tera pàngŋǝ̀nà pǝlǝa lumi-tongno-nong-ɓari (70) ka, yi ɓǝl a Ibǝram, andǝ Naho sǝ Haran.<verse eid="GEN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />Mǝnia ka nda cau mǝnana à gilǝì amur Tera andǝ aɓwana mana a tàu male ka.</para>
  <para style="p" vid="GEN 11:27">Tera ɓǝl a Ibǝram, andǝ Naho sǝ Haran. Haran yi ɓǝl Lotu. <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />Haran aki tárrí dǝmba paklú a nggea-là Ur a nzali mala amǝ Chaldi, ban mǝnana à ɓǝli kàm ngga. <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />Ibǝram andǝ Naho yia kǝm à alki amamǝna. Mālá Ibǝram nda Sarayi, sǝ mālá Naho nda Milka. Milka andǝ mǝkyauwe muna-ɓwama Iska ka, à nda ka amuna-mamǝna mala Haran. <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />Sarayi ka nkombi na, ɓǝl muna ɗàng.<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />Tera tùrlà nying Ur nǝ̀ o a nzali Kan'ana. Twal muni Ibǝram andǝ mǝkè Lotu, muna mala Haran, andǝ nkili Sarayi yì mālá Ibǝram atè. Amur njar aban ká ka, à yi cam a nggea-là Haran, pǝlǝa à duk kano. <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />Lang Tera lùmsǝna pǝlǝa gbǝman-ɓari bwamdǝ tongno (205) ka, paklú kanó a Haran.<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">Ɓakuli tunǝ Ibǝram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />Mǝtalabangŋo ne Ibǝram ama, &lt;&lt;Purî nzali ma'wun, puro nying aɓwana mô, andǝ ɓala mala tárró. O a nzali mǝnana mǝ nǝ lǝmdǝo wi ka.<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 15:7">Tite 15:7</ref>; <ref loc="ACT 7:3">Atúró 7:3</ref>; <ref loc="HEB 11:8">Ib 11:8</ref></char>.</note><verse eid="GEN 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 12:2" />&lt;&lt;Mǝ nǝ tsǝo awu nǝ duk nzali mala aɓwapǝndǝa mǝ'làkke.</para>
  <para style="q1" vid="GEN 12:2">Mǝ nǝ tsǝko bù,</para>
  <para style="q2" vid="GEN 12:2">mǝ nǝ tsǝa lullǝo nǝ̀ zǝkya,</para>
  <para style="q2" vid="GEN 12:2">sǝ awu nǝ duk mǝgulo kǝ̀rkǝ́r.</para>
  <para style="q2" vid="GEN 12:2">Nǝbano sǝ aɓwana nǝ̀ kum tsǝkbu.<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />Aɓwana mǝnana à tsǝko bù ka,</para>
  <para style="q2" vid="GEN 12:3">mǝ nǝ tsǝkia wia bù</para>
  <para style="q1" vid="GEN 12:3">sǝ aɓwana mǝnana à suio ka, mǝ nǝ suia.</para>
  <para style="q1" vid="GEN 12:3">Sǝ atau mala aɓwapǝndǝa kat a ɓanza ka,</para>
  <para style="q2" vid="GEN 12:3">à nǝ̀ kum tsǝkbu nǝbano.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 18:18">Tite 18:18</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="GEN 28:14">28:14</ref>; <ref loc="ACT 3:25">Atúró 3:25</ref>; <ref loc="GAL 3:8">Gal 3:8</ref></char>.</note><verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />Ibǝram bwal njargula o kǝla mǝnana Mǝtalabangŋo banggi wi ka; Lotu gbal ka o atè. Ibǝram nǝ̀ nying nzali Haran ngga, ndanǝ apǝlǝa lumi-tongno-nong-ɓari nǝ mǝsǝì tongno (75). <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />Ibǝram twal māmí Sarayi andǝ mǝkine Lotu andǝ gǝna malea mǝnana kat à ram ngga, andǝ aɓwapǝndǝa mǝnana à ndanǝi a Haran ngga, sǝ à bwal njargula aban o a nzali Kan'ana.</para>
  <para style="p" vid="GEN 12:5">Lang à bingŋǝna ka, <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />Ibǝram gya arǝ aban aɓa nzali Kan'ana yi bwal Shekem. A banì ka tsǝk gumli a tǝ́r ɓe nggun mǝgule mana à tunǝki ama nggun Moreh ka. A mǝno yì bàkú ka amǝ'Kan'ana nakam nǝdo a nzalinì. <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />Mǝtalabangŋo pusǝrǝi aban Ibǝram, sǝ ne wi ama, &lt;&lt;Nzali mǝnia a sǝngiyi ka, mǝ nǝ pè amunio andǝ amǝ'keò.&gt;&gt; Pǝlǝa Ibǝram ɓak gyangŋan kàm ace Mǝtalabangŋo, mǝnana pusǝrǝi a baní ka.<verse eid="GEN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 12:8" />Ibǝram loapi Shekem, twal gya o a nzali múr ankono a takuli mala là Betel. Kya tsǝk gumli male a ɓè ban mǝnana Betel na a bui mala njar-nzali, sǝ là Ai ka nda a bui mala njar-takuli ka. A ban mǝno ka Ibǝram nyare ɓak gyangŋan ace Mǝtalabangŋo, sǝ peri aban Mǝtalabangŋo. <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />Ibǝram nyare lo lidǝmba nǝ gya, kǝ turki arǝ abân bǝti-bǝti, tsǝk múrí nǝ̀ ká a Negev.<verse eid="GEN 12:9" /></para>
  <para style="s">Ibǝram andǝ Sarayi a Masar</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />Nzala yi kpa aɓa nzali Kan'ana. Nzalè ɓiki pa kǝ̀rkǝ́r nda Ibǝram lo nǝ̀ o a nzali Masar nǝ̀ nggá duk kam bǝti. <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />Lang malanǝ̀ kùtí a Masar ka, banggi māmí Sarayi ama, &lt;&lt;Sǝni pé, ǝn sǝlǝna ama a nda ɓwama nggea mǝɓoarnsari. <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />Ɓǝ̀ aɓwana mǝnana a Masar sǝno ka, à nǝ̀ na ama a nda māmám; pǝlǝa à nǝ̀ wal-luem ace mǝnana à nǝ̀ twalo wu duk malea ka. <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />Acemani ka, ida, banggia wia ama a nda mǝkyauwem; sǝ atàcau mò ka à nǝ̀ ɗekiǎm nǝ yilǝmu sǝ à nǝ̀ pakkam mǝɓoarne.&gt;&gt;<verse eid="GEN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 12:14" />Lang Ibǝram yina aɓa nzali Masar ka, amǝ Masar sǝn Sarayi ka ɓwama nggea mǝɓoarnsari na. <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />Lang amǝ tamurǝm Masar sǝni ka, à kya bang cau mala ɓoarnsari male aban Firona, murǝm malea. Nda à yiu à yi twal Sarayi à umnǝi a ɓala-murǝm. <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />Murǝm pakki Ibǝram mǝɓoarne atàcau mala Sarayi; pè Ibǝram anzur, andá, andambǝritso jamne andǝ amamǝne, amǝ'túró-ɓala aburana andǝ amamǝna, andǝ akalakadambi.<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />Sǝ acemǝnana murǝm Firona twal Sarayi, mālá Ibǝram ngga, Mǝtalabangŋo tasǝ nggea kwánó mǝɓike amur murǝm Firona andǝ amǝɓala male. <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />Acemani ka, murǝm Firona túrban à tunǝ Ibǝram, sǝ banggi wi ama, &lt;&lt;Mana mǝnia a pakkam ngga? Mana tsǝa sǝ a ɓinǝ banggàm ama yi ka māmó na. <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />Palang sǝ a bang ama yi ka mǝ'kyauweo na, sǝ mǝno ka tsǝa ǝn twali ɓǝ̀ duk māmám? Ado ka māmó nya ka. Twali sǝ wu o!&gt;&gt; <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />Pǝlǝa murǝm Firona tasǝ aburana male nǝ cau amur Ibǝram, sǝ à kya pusǝì purî ɓá nzali Masar, yì andǝ māmí andǝ koman mana kat male na ka.<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">Ibǝram andǝ Lotu gappì tarǝia</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />Acemǝno ka, Ibǝram loapi Nzali Masar sǝ nyare a Negev. Twal māmí andǝ agirkuma male kat atè. Lotu gbal ka o atè. <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />Ibǝram ngga mǝkume na kǝ̀rkǝ́r. Ndanǝ adomwan mala agirkusǝu, andǝ azǝrfa andǝ bolo-njengǝlan. <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />Twal gya kǝ turkio arǝ aban bǝti-bǝti, lo a Negev yi pur a Betel. Yi bik ban mǝnana tsǝk gumli male sǝ duk kàm a tadǝmbe a nre Betel andǝ Ai ka. <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />Mǝnia ka nda ban mǝnana Ibǝram ɓak gyangŋan kàm a nggea dǝmbe, sǝ peri aban Mǝtalabangŋo ka.<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />Lotu mǝnana o atà Ibǝram ngga, ndanǝ anzur andǝ ambulpǝndǝa, andǝ agumli. <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />Sǝ acemǝnana à ndanǝ agirkusǝu kǝ̀rkǝ́r ka, nzali yál agir karǝia mǝnana yia ɓari à nǝ̀ do abanarǝia ka ɗàng. <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />Nda kúnɓuàna lo a nre ka ayálgír mala Ibǝram andǝa mala Lotu ka. (A mǝno yì bàkú ka, amǝ'Kan'ana andǝ amǝ'Periz na kam gbal a kǝ nzali mǝno nǝdo.)<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />Pǝlǝa Ibǝram ne Lotu ama, &lt;&lt;Ən nggǝ zǝmbô, kúnɓuana ɓǝ kǝa lo a nre sǝm, ko a nre ka ayálgír mò andǝ amem ɗàng, acemǝnana sǝm nda mwashat. <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />Nggea nzali mǝnia kat ka pà mbak a ɓadǝmbo? Ida, ɓǝ̀ sǝm gapita rǝ sǝm. Twal buì mǝnana a earce ka, ɓǝ̀ sǝm gauwa. Ɓǝ̀ a o nǝ bu mǝ'nggare ka, mǝ nǝ um nǝ bu mǝlì, sǝ ɓǝ̀ a nǝ u gbal nǝ bu mǝlì ka, mǝ nǝ o nǝ bu mǝ'nggare.&gt;&gt;<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />Lotu loasǝ mǝsǝì sǝn nzali mana kàrì ɓangŋaban kún Mur Jodan kya pur a Zowar, sǝ sǝni ka, nzali na mǝnana kǝ kum mùr pepè ka, kǝla nzali ɓaban mala anggun mala Mǝtalabangŋo, ko kǝla nzali Masar. (Anggo ka Mǝtalabangŋo malaká kiɗiki Sodom andǝ Gomora ɗàng.) <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />Pǝlǝa Lotu twal ɓangŋaban nzali kún Mur Jodan ace ɓamúrì, sǝ bwal njargula o nǝ njar-takuli. Anggo sǝ Lotu gapitarǝia andǝ kine Ibǝram. <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />Ibǝram do a kǝ nzali Kan'ana, sǝ Lotu ka tùro kya do aɓalǝ anggea-là mala dulum, tsǝk agumli male duk kam a nkanggari Sodom. <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />Sǝ amǝ Sodom ngga, amǝ'ɓealɓikea na kǝ̀rkǝ́r (à kǝ pakki Mǝtalabangŋo cauɓikea ko aya pwari.)<verse eid="GEN 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />Anzǝm mana Lotu nyìngŋǝ̀nà Ibǝram ngga, Mǝtalabangŋo ne Ibǝram ama, &lt;&lt;Loasǝ mǝsǝo pé a kǝ ban mana a cam kam ngga, sǝnban kàrìban; sǝn njar-nza, sǝn njar-kunmur, sǝn njar-takuli, sǝ wu sǝn njar-nzali. <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />Nzali mǝnana kat mǝsǝo gandǝ sǝne ka, mǝ nǝ po wi, we wunǝ amunio andǝ amǝ'keò bà, málá male pà kàm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 15:18">15:18</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 24:7">24:7</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="GEN 28:13">28:13</ref>; <ref loc="GEN 35:12">35:12</ref>; <ref loc="DEU 34:4">Nggur 34:4</ref>; <ref loc="2CH 20:7">2Acau 20:7</ref>; <ref loc="ACT 7:5">Atúró 7:5</ref></char>.</note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />Mǝ nǝ tsǝk amunio andǝ amǝ'keò à nǝ̀ làkkì kǝla mǝsǝsala mana a nzali ka. Ɓǝ̀ kǝ ɓwa nǝ̀ gandǝ ɓal làkkì mala mǝsǝsala mǝnana a nzali ka, ɓwe nǝ̀ gandǝ ɓal amunio andǝ amǝ'keò.<note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 16:10">Tite 16:10</ref>; <ref loc="GEN 28:14">28:14</ref>; <ref loc="NUM 23:10">Ɓal 23:10</ref></char>.</note> <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />Lo, gya aɓa sauwa mala nzali andǝ tangŋa male, acemǝnana mǝ nǝ po wi.&gt;&gt;<verse eid="GEN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 13:18" />Pǝlǝa Ibǝram o kya tsǝk agumli male do aban anggun mǝgulke mala Mamǝre, mǝnana a Hebǝron ngga. Akanó sǝ kya ɓakki Mǝtalabangŋo gyangŋan.<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">Ibǝram amsǝ Lotu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />A bàkú mǝno ka lwa yi lo a nre ka nzali mala buban mǝno. Amrafel murǝm nzali Shinar, Ariyok murǝm nzali Elasa, Kedolaoma murǝm nzali Elam, andǝ Tidal murǝm nzali Goyim <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />à dapi à oa munǝo arǝ Bera murǝm nzali Sodom, Birsha murǝm nzali Gomora, Shinap murǝm nzali Adǝma, Shemeba murǝm nzali Zeboyim, andǝ murǝm nzali Bela (mana à tunǝi ama nzali Zowar ka). <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />Amurǝma mǝnia tongno nǝnzǝ́mò andǝ amǝ'lwa malea ka à yi ramba a Dulum mala Sidim (mana à tunǝi ama Nggeamùr Tuɓamur ka).<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="fq" closed="false">Nggeamùr Tuɓamur </char><char style="ft" closed="false">ka nda mǝnana à tunǝi yalung ama Luna Nggeamùr ka.</char></note> <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />Amǝnia yì amurǝma ka à pak pǝlǝa lum-nong-ɓari à nda ɓata parban mala Murǝm Kedolaoma, sǝama a lum-nong-tàruià pǝlǝa ka à mgbicau arǝì. <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />A lum-nong-inea pǝlǝa ka Murǝm Kedolaoma andǝ amurǝma mǝnana atè ka, à yiu nǝ amǝ'lwa malea à yì soa munǝo arǝ amǝ'Refa mala nzali Ashterot-Karnem, amǝ'Zuz mala nzali Ham, amǝ'Emit mala nzali Shave-Kiriatem, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />andǝ amǝ'Hor mala Seyir, nzali múr ankono, sǝ à gandǝia aban ká ɗār a El-paran, ɓè ban a masǝlǝata pǝɗanban. <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />Pǝlǝa à wulio à yiu a nggea-là Kadesh (mana à tunǝi ama En-Mishpat ka). À lì nzali mala amǝ'Amalek kat nǝ lwa sǝ à gandǝ amǝ'Amor mǝnana à ndanǝdo a là Hazazon-Tamar ka.<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />Pǝlǝa amurǝma mala anzali Sodom, Gomora, Adǝma, Zebo, andǝ Bela (mana à tunǝi ama Zowar ka) andǝ amǝ'lwa malea kat puro à yi ram rǝia ace lwa a Dulum mala Sidim. <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />À soa munǝo arǝ Kedolaoma murǝm nzali Elam, Tidal murǝm nzali Goyim, Amrafel murǝm nzali Shinar andǝ Ariyok murǝm nzali Elasa, yia andǝ amǝ'lwa malea kat. Amurǝma ine arǝ tongno. <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />Ɓá Ɓangŋaban Sidim ngga lùmsǝ nǝ atūli kwalta pas. Lang amǝ'lwa mala amurǝma mala anzali Sodom andǝ Gomora ɓanggi munǝo ama à nǝ̀ u ka, à kya kpakia aɓalǝ atūli kwalta; acili amurǝma tàrú andǝ amǝ'lwa malea mǝnia munǝo gandǝia ka, à ɓangŋa à kya eaki amur ankono. <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />Amǝ'lwa mala amurǝma man ine à limurǝm ngga, à pwan kume mala amǝ Sodom andǝ Gomora andǝ girlina malea kat; pǝlǝa à bwal njar à o. <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />Mǝkina Ibǝram, yi Lotu mǝnana ndanǝdo a Sodom ngga, à pwan kume male gbal kat sǝ à bwali.<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />Ɓè ɓwa mǝnana apî kún munǝo ka, ɓangŋa yiu nǝ cau mǝnia ka aban Ibǝram ɓwa Ibǝru. Ibǝram ngga ndanǝdo a là-gumli male aban anggun mǝgulke mala Mamǝre ɓwa Amor. Mamǝre andǝ amǝ'eambi, yia Eshkol andǝ Aner ka, à kùrkún arǝia andǝ Ibǝram à nǝ̀ bwalia rǝia kàm arǝ aɓia-mǝbura ɓǝ̀ munǝo lo ka. <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />Lang Ibǝram ok ama mǝkine Lotu ka à bwalǝni ka, ramba aburana amǝtúró male gbǝman-tàrú nǝ lum-bwamdǝ-tongno-nong-tàrú [318] mǝnana à ɓǝlia a ɓala male, sǝ à kania wia lwa ka. Yì andǝia kat ka à lo pǝrta aɓia-mǝbura, yia amǝ'lwa mala Kedolaoma, sǝ à kya bwaltea kuko a njar-nza a bu-nzali Dan. <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />A ban mǝno ka Ibǝram gau amǝ'lwa male mbop-mbop. Lang dù pǝndǝna ka Ibǝram andǝ amǝ'lwa male yasǝlǝ aɓia-mǝbura nǝ munǝo arǝ anjar ɗàng-ɗáng sǝ à gandǝia. À mesǝia sǝ à pǝrtea kuko à kya bik Hoba, mǝnana nda a njar-nza mala nggea-là Damaska ka. <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />Ibǝram ak agir mǝnana kat aɓwana mǝno pwania ka, sǝ nyesǝ mǝkine Lotu andǝ agirkuma male, atārǝia andǝ amamǝna andǝ acili aɓwana mǝnana aɓia-mǝbura bwalkia ka.<verse eid="GEN 14:16" /></para>
  <para style="s">Melkizedek tsǝki Ibǝram bu</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />Lang Ibǝram nyarni limurǝm a lwa amur Kedolaoma andǝ amurǝma mana atè sǝ nda njar nǝ̀ o a là ka, murǝm Sodom puro wari a kúllè a Ɓangŋaban Shave (mǝnana à tunǝi gbal ama Ɓangŋaban mala Murǝm ngga).<note caller="+" style="f"><char style="fr" closed="false">14:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 7:1-4">Ib 7:1-4</ref>,<ref loc="HEB 7:10">10</ref></char>.</note><verse eid="GEN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 14:18" />Ɓè murǝm mǝnana à tunǝi ama Melkizedek, murǝm mala nggea-là Salem, yiu aban Ibǝram. Wari nǝì Ibǝram bǝredi andǝ múr ɓǝlanggun anap. Yì ka pǝris na mala Ɓakuli Mana Karban Kat nǝ Gulo ka. <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />Tsǝki Ibǝram bu, kǝ bang ama,</para>
  <para style="q1" vid="GEN 14:19">&lt;&lt;Ɓǝ̀ bu Ɓakuli Mana Karban Kat nǝ Gulo,</para>
  <para style="q1" vid="GEN 14:19">yì mana pusǝ kùli andǝ nzali ka,</para>
  <para style="q2" vid="GEN 14:19">do amur Ibǝram!<verse eid="GEN 14:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 14:20" />Ɓwangsǝban ɓǝ pa aban Ɓakuli Mana Karban Kat nǝ Gulo,</para>
  <para style="q2" vid="GEN 14:20">mǝnana po limurǝm amur aɓio amǝbura ka.&gt;&gt;</para>
  <para style="m" vid="GEN 14:20">Pǝlǝa Ibǝram pè Melkizedek kāmbe mala agir mǝnana kat ea a bu aɓi-mǝbura a lwa ka.<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 7:4">Ib 7:4</ref></char>.</note><verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />Nǝ nzǝ́mò ka Murǝm Sodom banggi Ibǝram ama, &lt;&lt;Pam aɓwana mem mǝnana a amsǝia ka, sǝ agirkuma ka, umnǝia ɓǝà duk amô.&gt;&gt;<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />Sǝ Ibǝram ngga earî murǝm Sodom ama, &lt;&lt;Ən loasǝ buam a kùli ǝn kánagìr aban Mǝtalabangŋo, Ɓakuli Mana Karban Kat nǝ Gulo ka, Mǝtala kùli andǝ nzali <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ama pà mǝ nǝ twal kǝgìr mǝnana mona ka ɗàng, ko ɓǝ̀ nkonggúr ko nggúr-nkura na ka. Anggo ka a pà nǝ gandǝ bang ama, &lt;Mǝ nda mǝnana ǝn tsǝa sǝ Ibǝram pǝlǝ mǝgǝna ka&gt; ɗàng. <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />Pà mǝ nǝ ak kǝgìr ace ɓamúràm ɗàng she gìr mǝnana amǝ'lwa mem lì ka. Sǝama aburana mǝnana à dapi ɓamuria atàm a lwa mǝnia, yia Aner, Eshkol andǝ Mamǝre ka, ɓǝà pea wia kāmbe malea aɓa girkuma mǝnana à pwano a ban lwa ka.&gt;&gt;<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">Ɓakuli kùrcau nǝ Ibǝram</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />Anzǝm mǝnia ka, Mǝtalabangŋo nacau nǝ Ibǝram aɓa sǝna ama:</para>
  <para style="q1" vid="GEN 15:1">&lt;&lt;Ɓangciu ɓǝ̀ kǝa pakko ɗàng,</para>
  <para style="q2" vid="GEN 15:1">Ibǝram,</para>
  <para style="q1" vid="GEN 15:1">Mǝ nda ntongŋo mò,</para>
  <para style="q2" vid="GEN 15:1">nggea tangnakusǝo mǝgule.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 33:29">Nggur 33:29</ref>; <ref loc="2SA 22:3">2Sam 22:3</ref>,<ref loc="2SA 22:31">31</ref>; <ref loc="PSA 3:3">Ang 3:3</ref>; <ref loc="PSA 7:10">7:10</ref></char>.</note><verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />Sǝ Ibǝram na ama, &lt;&lt;Mǝtalabangŋo Ɓakuli, mana nda ɓoaro mala tangnakusǝu mò abanam, yì mǝnana ǝn panǝ muna raka, kǝ muna-ɓala mem Eliyeza, ɓwa Damaska na nǝ̀ liɓala mem ngga?&gt;&gt; <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />Ibǝram na ɗǝm ama, &lt;&lt;A pam amuna ɗang; acemani ka, mǝtúró-ɓala mǝnana à ɓǝli a ɓala mem ngga nda nǝ̀ liɓala mem ngga ra.&gt;&gt;<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />Pǝlǝa cau mala Ɓakuli yiu a baní ama, &lt;&lt;Mǝnia yì ɓwa ka pà nǝ̀ liɓala mò ɗàng. Muna-ɓwabura mô mǝnana awu nǝ bǝl ka nda nǝ̀ liɓala mò ka.&gt;&gt; <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />Mǝtalabangŋo pǝlǝa pusǝì a nza, sǝ ne wi ama, &lt;&lt;Loasǝ mǝsǝo a kùli pé, sǝ ɓal anlero ɓǝ̀ a nǝ gandǝì ka.&gt;&gt; Sǝ ne wi ama, &lt;&lt;Mǝno ka nda làkkì mala amunio andǝ amǝ'keò.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="GEN 22:17">Tite 22:17</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="EXO 32:13">Pur 32:13</ref>; <ref loc="DEU 1:10">Nggur 1:10</ref>; <ref loc="DEU 10:22">10:22</ref>; <ref loc="1CH 27:23">1Acau 27:23</ref>; <ref loc="ROM 4:18">Rom 4:18</ref>; <ref loc="HEB 11:12">Ib 11:12</ref>.</char></note><verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />Ibǝram earnǝ Mǝtalabangŋo, sǝ Mǝtalabangŋo twali yì ka mǝɓealɓoarna na.<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 4:3">Rom 4:3</ref>,<ref loc="ROM 4:9">9</ref>,<ref loc="ROM 4:22">22</ref>; <ref loc="GAL 3:6">Gal 3:6</ref></char>.</note><verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />Nyar ɗǝm Mǝtalabangŋo ne wi ama, &lt;&lt;Mǝ nda Yahweh, mana pusǝo a purì ɓá nggea-là Ur a nzali mala amǝ'Chaldi ace po mǝnia yì nzali ɓǝ̀ duk girkuma mò ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:1">Tite 12:1</ref>; <ref loc="NEH 9:7-8">Nehe 9:7-8</ref>; <ref loc="ACT 7:2-4">Atúró 7:2-4</ref></char>.</note><verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />Sǝ Ibǝram ɗì ama, &lt;&lt;Mǝtalabangŋo, Ɓakuli, lang sǝ mǝ nǝ sǝlǝ ama mǝnia yì nzali ka nǝ̀ duk girkuma mem?&gt;&gt;<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />Mǝtalabangŋo nyesǝi wi ama, &lt;&lt;Yinǝàm nǝ muna-ndá, andǝ muna-mbul, andǝ muna-gam, komǝye ka mbule tàrú, atārǝia andǝ kutugangyi andǝ muna-kutumurǝm.&gt;&gt;<verse eid="GEN 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 15:10" />Ibǝram yinǝ agir mǝnia kat a baní, pǝlǝa komǝye ateà ka zanzǝi aɓalǝu ɓari, sǝ nongsǝ abare man a nkanggari arǝia. Sǝ mala anyal ka zanzǝia ɗàng. <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />Adǝkǝlaki yiu à yi sulǝo amur alúgir mǝnia à nǝ̀ lia sǝ Ibǝram pǝria. <verse eid="GEN 15:11" /><verse number="12" style="v" sid="GEN 15:12" />Lang pwari na rǝ kpa ka, Ibǝram ko a nggea ntulo mǝlime, pǝlǝa ɓe pǝndǝa cikcik mǝpà ɓangciunì yi gir múrí. <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />Pǝlǝa Mǝtalabangŋo ne Ibǝram ama, &lt;&lt;Sǝlǝ fa ama amǝ'keò nǝ̀ nggá duk abǝri a ɓè nzali mǝnana malea na raka. Amǝ nzali mǝno nǝ̀ tsǝia à nǝ̀ duk aguro, à nǝ̀ paria aɓata tanni arǝ pǝlǝa gbǝman-ine (400).<note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:40">Pur 12:40</ref>; <ref loc="GAL 3:17">Gal 3:17</ref></char>.</note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />Sǝama mǝ nǝ lǝmdǝ ɓashi mem amur mǝno yì nzali nǝ̀ nggá dumsǝ aɓwana mô a guro ka. Nǝnzǝ́mò ka aɓwana mô nǝ̀ purî ɓá nzali mǝno, à nǝ̀ pur nǝ agirkuma mǝ'làkke a buia.<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:6">Pur 6:6</ref>; <ref loc="EXO 7:4">7:4</ref>; <ref loc="EXO 12:12">12:12</ref></char>.</note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />Sǝ we ka, ɓǝ̀ a ena ě mǝɓoarne mala akapana ka, sǝ a wúnǝ́ wu aɓa rǝpwala. À nǝ̀ tsǝkbaniò atà akeô.<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 25:8">Tite 25:8</ref></char>.</note> <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />A inea nza mala do ɓanza mala amunio andǝ amǝ'keò ka, à nǝ̀ nyare à nǝ̀ yiu a nzali mǝnia ɗǝm. Mǝno ka pà nǝ̀ pa adyan ɗang acemǝnana cauɓikea mala amǝ'Amor<note caller="+" style="f"><char style="fr" closed="false">15:16 </char><char style="fq" closed="false">cauɓikea mala amǝ'Amor </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1KI 21:26">1Amur 21:26</ref>; <ref loc="AMO 2:9">Amo 2:9</ref> </char>.</note> malaká bik ban mǝnana nǝ̀ tsǝa mǝ nǝ tasǝ ɓashi mem amúrià ado ka ɗàng.&gt;&gt;<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />Lang pwari kpana sǝ ban bwalna ka, muna nkenye mana nǝ nkalang-bǝsa aɓalǝi kǝ loasǝ yele, andǝ ɓukan mana kǝ earki bǝsa ka, à yi puro sǝ à kùtí a nre ka anyama mǝnia à sangia ka.<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">Mǝnia ka nda lǝmdǝ ama Ɓakuli pana eare male arǝ kùrcau male mana pè nǝ Ibǝrayim ngga. A nza mǝno ka ɓǝ̀ ɓwa kùrcau ka, nǝ̀ lǝmdǝ ama mǝsǝcau na nakiyi ka nǝ pak gìr ani: nǝ̀ pwan-myal girkusǝu, nǝ̀ ɓwe sǝ nǝ̀ nongsǝ abare ɗàngɗáng. Nǝ̀ gya nǝ̀ kùtí a nre ka bare man sǝ nǝ̀ nggǝ bangcau ama, &lt;&lt;Mǝnia yì gìr ɓǝ̀ kumam ɓǝ̀n bwal kùrcau mǝnia raka.&gt;&gt;</char></note> <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />A pwari mǝno ka Mǝtalabangŋo kùrcau nǝ Ibǝram ama, &lt;&lt;Mǝ nǝ pè amunio andǝ amǝ'keò nzali mǝnia, twal a kún myalmúr mala amǝ Masar aban ká kún nggeasala mǝgule, yi Yiufǝretis;<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 17:8">17:8</ref>; <ref loc="GEN 24:7">24:7</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="NUM 34:2">Ɓal 34:2</ref>; <ref loc="EXO 23:31">Pur 23:31</ref>; <ref loc="NUM 34:1-15">Ɓal 34:1-15</ref>; <ref loc="DEU 1:7-8">Nggur 1:7-8</ref>; <ref loc="DEU 34:4">34:4</ref>; <ref loc="JOS 21:43">Jes 21:43</ref>; <ref loc="2KI 24:7">2Amur 24:7</ref>; <ref loc="NEH 9:8">Nehe 9:8</ref>; <ref loc="ACT 7:5">Atúró 7:5</ref></char>.</note> <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />kat andǝ nzali mala amǝ'Ken, andǝ amǝ'Keniz, andǝ amǝ'Kadǝmon, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Refa, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />andǝ amǝ'Amor, andǝ amǝ'Kan'ana, andǝ amǝ'Girgash, sǝ amǝ'Jebus.&gt;&gt;<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">Hajara andǝ Ishmayel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />Sarayi, mālá Ibǝram ngga, ɓǝlî wi kǝ muna ɗang. Sǝama yì ka ndanǝ muna-ɓwama mǝ'bwali wi túró a ɓala, ɓwama Masar na, lùllǝì ama, Hajara. <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />Acemani ka, Sarayi ne Ibǝram ama, &lt;&lt;Sǝni, Mǝtalabangŋo gìrnam nǝ ɓǝlmuna. Ida kyane, kútí atà muna-ɓala mem, yakǝla mǝ nǝ kum amuna nǝ njarbaní.&gt;&gt;</para>
  <para style="p" vid="GEN 16:2">Ibǝram pǝlǝa ear nǝ cau mana Sarayi ne wi ka. <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />Anzǝm mana Ibǝram dumǝna pǝlǝa lum a nzali Kan'ana ka, Sarayi twal Hajara, muna-ɓala male, ɓwa Masar, sǝ pè burí Ibǝram, ɓǝ̀ duk māmí. <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />Ibǝram kùtí atà Hajara, sǝ kum muna a bumi.</para>
  <para style="p" vid="GEN 16:4">Lang Hajara sǝni muna kpana a bumi ka, tita būrǝce Sarayi mǝtala-ɓala male. <verse eid="GEN 16:4" /><verse number="5" style="v" sid="GEN 16:5" />Sarayi pǝlǝa ne Ibǝram ama, &lt;&lt;A nda a yinǝ mǝnia yì ɓǝsǝkiban ǝn nggǝ kumi ka amuram. Ən twal muna-ɓala mem ǝn po wu pak-ɓwama nǝi, sǝ lang yi sǝni kumna muna a bumi ka, kǝ nyesǝcem-ɓà. Ɓǝ̀ Mǝtalabangŋo pak ɓashi a nre sǝm sǝnǝ we.&gt;&gt;<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />Pǝlǝa Ibǝram ne wi ama, &lt;&lt;Yì ka mǝguro mò na aɓata rǝcandǝa mò. Pang nǝi kǝla mǝnana a sǝni nda ɓoaro kutibanì ka.&gt;&gt; Pǝlǝa Sarayi kùtí a ɓìkî Hajara nǝ patanni, nda Hajara ɓangŋa o nying ɓala ka.<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />Mǝturonjar mala Mǝtalabangŋo kum Hajara tù a ban ɓe mgbeɗe mùr aɓa pǝɗanban a njenza; mǝno ka nda mgbeɗe mùr mǝnana a gírí njargula ká a Shur ka. <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />Ne wi ama, &lt;&lt;Hajara, mǝguro mala Sarayi, a pur ake, sǝ a nǝ ká ake?&gt;&gt;</para>
  <para style="p" vid="GEN 16:8">Eari wi ama, &lt;&lt;Mǝ nda aban ɓangŋa mǝ nǝ upi ban Mǝtala-ɓala mem, Sarayi.&gt;&gt;<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />Pǝlǝa Mǝturonjar mala Mǝtalabangŋo banggi wi ama, &lt;&lt;Nyare aban mǝtala-ɓala mò, kya pa ɓamuro aɓata rǝcandǝa male.&gt;&gt; <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />Mǝturonjar mala Mǝtalabangŋo lidǝmba nǝ cau ama, &lt;&lt;Mǝ nǝ hatǝki amunio andǝ amǝ'keò, yàle làkkì malea ka kǝ ɓwa pà nǝ̀ gandǝ ɓallia ɗàng.&gt;&gt;<verse eid="GEN 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 16:11" />Mǝturonjar mala Mǝtalabangŋo ne wi ɗǝm ama,</para>
  <para style="q1" vid="GEN 16:11">&lt;&lt;We ka a ndanǝ muna a bumo ado,</para>
  <para style="q2" vid="GEN 16:11">sǝ awu nǝ ɓǝl muna-ɓwabura.</para>
  <para style="q1" vid="GEN 16:11">Awu nǝ tsǝki wi lullǝ ama Ishmayel,<note caller="+" style="f"><char style="fr" closed="false">16:11 </char><char style="fq" closed="false">Ishmayel </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">Ɓakuli kǝ ó. </char></note></para>
  <para style="q2" vid="GEN 16:11">acemǝnana Mǝtalabangŋo ongŋǝna ɓua andǝ pǝ́lǝ́kí nǝ ɓalǝu mô.<verse eid="GEN 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 16:12" />Yì ka nǝ̀ pa kǝla mǝdambǝriso bondo;</para>
  <para style="q2" vid="GEN 16:12">nǝ̀ do nǝ bumɓikea arǝ koya ɓwa,</para>
  <para style="q2" vid="GEN 16:12">sǝ koya ɓwa ka nǝ̀ do nǝ bumɓikea arǝì.</para>
  <para style="q1" vid="GEN 16:12">Nǝ̀ ɓìkìdo aban aɓǝla male kat.&gt;&gt;<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />Acemani ka Hajara pe Mǝtalabangŋo man bangcau nǝi ka lullǝu ama: El Roi; yì ka bang ama, &lt;&lt;Ən sǝna Ɓwa mǝnana sǝngiyiam ngga.&gt;&gt; <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />Nda gìr mǝnana tsǝa sǝ à tunǝ tūli-mùr mǝno ka ama &lt;&lt;Biya-Lahai-Royi.<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="fq" closed="false">Biya-Lahai-Royi </char><char style="ft" closed="false">ka ɓālǝi ka ndà &lt;&lt;Tūli-mùr mala Ɓwa Mǝyilǝmu mǝnana Sǝngiyiam ngga.&gt;&gt;</char></note>&gt;&gt; Tūli-mùrnî nakam yalung a nre Kadesh andǝ Bered.<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />Hajara yi ɓǝlì Ibǝram muna-ɓwabura, sǝ Ibǝram tsǝki muna lullǝu ama Ishmayel. <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />Ibǝram adyan ngga ndanǝ apǝlǝa lumi-tongno-nong-tàrú bwamdǝ tongno-nong-mwashat [86] mana Hajara ɓǝlì wi Ishmayel ka.<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">Ɓakuli kùrcau nǝ Ibǝram andǝ amuni andǝ amǝkè</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />Lang Ibǝram bwalǝna apǝlǝa lumi-tongno-nong-ine bwamdǝ tongno-nong-ine (99) ka, Mǝtalabangŋo pusǝrǝi a baní sǝ ne wi ama, &lt;&lt;Mǝ nda Ɓakuli mana Karban Kat ne Gulo ka; kpata njar mem koya pwari, sǝ wu dukdo ɗwanyicau-arǝǔ. <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />Mǝ nǝ tsǝk kùrcau mem mǝnana a nrem sǝm nǝ we ka ɓǝ̀ yi lumsǝo, sǝ mǝ nǝ po amuna andǝ amǝkau à nǝ̀ làkkì pas.&gt;&gt;<verse eid="GEN 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 17:3" />Ibǝram kùndǝó nǝ ɓamǝsǝi a nzali. Pǝlǝa Ɓakuli ne wi ama, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />&lt;&lt;Mǝnia ka nda kùrcau mem mana sǝm nǝ we ka: Awu nǝ duk tár akún pas. <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />À pà nǝ̀ tunǝo ɗǝm ama Ibǝram<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">Ibǝram </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;Tárrú mǝnana à gusǝli ka.&gt;&gt;</char></note> ɗàng, lùllǝò adyan ngga nda Ibǝrayim,<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="fq" closed="false">Ibǝrayim </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;Tár aɓwabundǝa.&gt;&gt;</char></note> acemǝnana ǝn tsǝ́ngŋǝ̀nó a nda tár akún pas. <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />Mǝ nǝ tsǝo awu nǝ sa kǝ̀rkǝ́r. Amunio andǝ amǝ'keò nǝ̀ duk akún pas, amurǝma nǝ̀ pur a tàu mò. <verse eid="GEN 17:6" /><verse number="7" style="v" sid="GEN 17:7" />Mǝ nǝ tsǝk mǝnia yì kùrcau ka nǝ̀ do bà a nre sǝm, sǝm nǝ we, andǝ amunio, andǝ amǝ'keò, andǝ amǝnana à kǝ yiu a nzǝmia ka. Mǝ nǝ duk Ɓakuli mò andǝ malea.<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:7">Pur 6:7</ref>; <ref loc="LEV 11:45">Pǝris 11:45</ref>; <ref loc="LEV 26:12">26:12</ref>,<ref loc="LEV 26:45">45</ref>; <ref loc="DEU 29:13">Nggur 29:13</ref>; <ref loc="HEB 11:16">Ib 11:16</ref>; <ref loc="REV 21:7">Sǝn 21:7</ref></char>.</note> <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />Nzali Kan'ana mǝnana kat ado a ndakam kǝla bǝri ka, mǝ nǝ pò wi, wunǝ amunio atò, ace mǝnana ɓǝ̀ duk girkuma mala ɓala mò bà. Mǝ nǝ duk Ɓakuli malea.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 3:16">Gal 3:16</ref></char>.</note><verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />Ɓakuli pǝlǝa ne Ibǝrayim ama, &lt;&lt;Mò ado ka, nda mǝnana ama wu kpata mǝnia yì kùrcau ka, we wunǝ amunio andǝ amǝ'keò, andǝ amǝnana à malaká ɓǝlia raka. <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />Mǝnia ka nda kùrcau mem sǝnǝ we andǝ amunio andǝ amǝ'keò, kùrcau mǝnana wun nǝ̀ kpate ka: Koya ɓwabura atà wun ngga à nǝ̀ kasǝî wi ɓate. <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />Nggú mǝnana a kun ɓatau wun ngga, à nǝ̀ kasǝì. Mǝnia ka nda nǝ̀ lǝmdǝ ama kùrcau nakam a nre sǝm, sǝnǝ awun ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:48">Pur 12:48</ref>; <ref loc="ACT 7:8">Atúró 7:8</ref>; <ref loc="ROM 4:11">Rom 4:11</ref></char>.</note> <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />Twal ado aban ká arǝ anza ma'wun mǝnana kat à nǝ̀ yiu ka, koya muna-ɓwabura mǝnana à ɓǝli sǝ bingŋǝna nongŋo tongno-nong-tàrú ka, dumǝna púp à nǝ̀ kasǝî wi ɓate. Mǝnia yì nzongcau ka pà ace amǝ'ɓala mò nǝmurǝia ɗàng, nda gbal ace amǝ'ɓala mala aguro mǝnana à ɓǝlia a ɓala mò, andǝ mala aguro mǝnana à kúria nǝ boalo a bù ɓwa kúnɗàngna mǝnana pà a tàu mò raka. <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />Koyan kat ateà ka dumǝna púp à nǝ̀ kasǝî wi ɓate, ko à ɓǝl ɓwe a ɓala mò ko à kúrí nǝ boalo. Kasǝ-ɓatau ka nǝ̀ do nda gìr'lǝmdǝa ngguont a nggūrǝ wun mala kùrcau mem nǝ wun, mǝnana málá male pà kàm raka. <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />Koya ɓwabura mǝnana à kasǝî wi ɓate ɗàng, sǝ ɓinǝ kasǝ ɓate ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana mem ɗǝm ɗàng, acemǝnana, yì ka mgbinakiru arǝ kùrcau mem.<verse eid="GEN 17:14" /></para>
  <para style="s">Ɓakuli ne Ibǝrayim ama Sarayi nǝ̀ <optbreak />ɓǝlî wi muna-ɓwabura</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />Ɓakuli nyare ne Ibǝrayim ama, &lt;&lt;Mala māmó Sarayi ka, à pà nǝ̀ nggǝ tunǝi ɗǝm ama Sarayi<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">Sarayi </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓoarnsarile murǝm.&gt;&gt; </char></note> ɗàng. Twal ado aban ká dǝmba ka lùllǝì nda Saratu.<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">Saratu </char><char style="ft" closed="false">ko &lt;&lt;Mā-murǝm.&gt;&gt;</char></note> <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />Mǝ nǝ tsǝki wi bu, sǝ mǝ nǝ pò muna-ɓwabura nǝ kǝ buì. Mǝ nǝ tsǝki wi bu, ace mǝnana ɓǝ̀ duk nggeau mala akún pas. Amurǝma pas à nǝ̀ pur nǝ baní.&gt;&gt;<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />Pǝlǝa Ibǝrayim kùndǝó nǝ ɓamǝsǝi a nzali; oalo sǝ ne ɓamúrì ama, &lt;&lt;Ɓwa mǝnana ndanǝ apǝlǝa lumi-lum ngga nǝ̀ ɓǝl muna le? Sǝ nggearǝ Saratu ka, nǝ̀ ɓǝl muna le, yì mǝnana ndanǝ apǝlǝa lumi-tongno-nong-ine ka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 18:12">Tite 18:12</ref></char>.</note> <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />Ibǝrayim ne Ɓakuli ama, &lt;&lt;Mǝnia yì tsǝkbu ɓǝ̀ do mala Ishmayel!&gt;&gt;<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />Pǝlǝa Ɓakuli ne wi ama, &lt;&lt;Awo, nggearǝ māmó Saratu nǝ̀ ɓǝ̀lô muna-ɓwabura, sǝ awu nǝ tsǝki wi lullǝu ama Ishaku.<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">Ishaku </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Oalo.&gt;&gt;</char></note> Mǝ nǝ tamsǝkusǝ kùrcau mem sǝm nǝi, kùrcau mǝnana pà nǝ̀ mal raka, ace yì andǝ amuni andǝ amǝkè mana a nzǝmi ka. <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />Sǝ mala Ishmayel gbal ka, ǝn ongŋǝno. Ɓafo mǝ nǝ tsǝki wi bu; mǝ nǝ tsǝì nǝ̀ ɓǝla, nǝ̀ hatǝki kǝ̀rkǝ́r. Nǝ̀ duk tár amurǝma lum-nong-ɓari, sǝ mǝ nǝ tsǝì nǝ̀ do nǝ nzali mǝgule.<note caller="+" style="f"><char style="fr" closed="false">17:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 25:13-16">Tite 25:13-16</ref></char>.</note> <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />Sǝama kùrcau mem ngga mǝ nǝ tamsǝkusǝi nǝ múr Ishaku, mǝnana Saratu nǝ̀ ɓǝ̀lô wi a kúnì ani a pǝlǝa mǝno kǝ yiu ka.&gt;&gt; <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />Lang Ɓakuli malna nacau nǝ Ibǝrayim ngga, o nying Ibǝrayim.<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />Akǝ mǝno yì pwari ka, Ibǝrayim twal muni Ishmayel andǝ koya ɓwabura andǝ muna-ɓwabura mǝnana à ɓǝli a ɓala male, andǝ mǝnana à kúrí nǝ boalo ka, sǝ kasǝî koyan ateà ka ɓate, kǝla mǝnana Ɓakuli banggi wi ɓǝ̀ pàk ka. <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />Ibǝrayim ngga ndanǝ pǝlǝa lumi-tongno-nong-ine bwamdǝ tongno-nong-ine (99) sǝ à kasǝî wi ɓate. <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />Ishmayel ka ndanǝ pǝlǝa lum-nong-tàrú sǝ Ibǝrayim kasǝî wi ɓate. <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />Ibǝrayim andǝ muni Ishmayel yia kǝm ngga à kasǝia wia ɓatea akǝ mǝno yì pwari mǝmwashati. <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />Aburana andǝ amuna-burana a ɓala mala Ibǝrayim kat, amǝnana à ɓǝlia a ɓala male andǝ amǝnana à kúria nǝ boalo a bù bǝri ka, yia kat à kasǝia wia ɓatea atà Ibǝrayim.<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">Ɓakuli pa cau mala pè Ibǝrayim andǝ Saratu muna-ɓwabura</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />Mǝtalabangŋo nyare pusǝrǝi aban Ibǝrayim a là-gumli male mana a ban anggun mǝgulke mala Mamǝre ka. Ɓè pwari, nǝ pwarizǝkya, Ibǝrayim na ban do a kún ndà-gumli male. <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />Loasǝ mǝsǝi ka sǝn aburana tàrú aban came tù a ban mǝno. Lang sǝnia ka, pǝlǝa loapi kún ndà-gumli male akaurǝa wari abania nǝ̀ gingsǝia. Kùndǝ nǝ ɓamǝsǝi a nzali makkia wia kún.<verse eid="GEN 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 18:3" />Bang cau nǝia ama, &lt;&lt;Wun aɓwana-mǝgule, ǝn nggǝ zǝmba wun, ɓǝ̀n kumǝna earmúrú a ban wun ngga, ida, wu kǝa kutiam wun nǝ̀ o sǝ wu kàr a ɓala mem, mim guro ma'wun ɗàng pé. <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />Ida, wu came mǝ yinǝa wun nǝ mùr wu lákkí akusǝ wun, sǝ wu usǝlǝo a tǝr nggun mǝnia ka. <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />Ɗǝm ngga mǝ nǝ yinǝa nǝ wun girlina bǝti ɓǝ̀ wu par ɓalǝ wun nǝi<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="fq" closed="false">wu par ɓalǝ wun nǝi </char><char style="ft" closed="false">ko wu li ace mǝnana ɓǝ̀ pà wun rǝcandǝa.</char></note> sǝ wu lidǝmbǝa nǝ gya ma'wun. Wu earâm mǝ pakka wun anggo acemǝnana wu yina akani abanam ngga.&gt;&gt;</para>
  <para style="p" vid="GEN 18:5">Pǝlǝa à nyesǝi wi ama, &lt;&lt;Sǝm pakko yàwá; sǝm earna, pa kǝla mǝnana a bang ngga.&gt;&gt;<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />Ibǝrayim pǝlǝa ɓangŋa kútí aɓa ndà-gumli male sǝ banggi Saratu ama, &lt;&lt;Fà rǝo, ɗàrǝ́ muku mǝɓǝlke a muna-kwár tàrú, karkia wia nɗǝmo.&gt;&gt; <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />Anzǝm mǝnana nana anggo ka, pǝlǝa ɓangŋa wari a domwan kya bwal muna-ndá mǝ'nyane, mǝnana nyame nǝ̀ ɓǝlki amala shě ka, sǝ pè ɓè mǝtúró-ɓala male. Pǝlǝa mǝtúró-ɓala pwan-myali, sàngi nyami sǝ lambi akaurǝa. <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />Ibǝrayim pǝlǝa ɗàrǝ́ kiura mǝɓwal-ɓwali andǝ mǝbwale sǝ twal nyam muna-ndá mǝnana à lambi ka, yinǝia aban abǝri a tǝr nggun. Pea wia girline nǝ nggearǝì ɓǝà li, sǝ cam abania a tǝr nggun sǝ à kǝ lìli.<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />Pǝlǝa à ɗì Ibǝrayim ama, &lt;&lt;Māmó Saratu ka nda ake?&gt;&gt;</para>
  <para style="p" vid="GEN 18:9">Earia wia ama, &lt;&lt;Nda aɓa gumli.&gt;&gt;<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />Ɓwamǝgule malea bang cau ama, &lt;&lt;A bàkú mǝnia mala pǝlǝa mǝnana kǝ yiu ka, mǝ nǝ nyare mǝ yiu, sǝ māmó Saratu ka, nǝ̀ kum muna-ɓwabura.&gt;&gt;</para>
  <para style="p" vid="GEN 18:10">Saratu ka nda a nzǝmi a kún gumli aban kwakikiri arǝ cau. <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />Ibǝrayim andǝ Saratu ka à ena kǝ̀rkǝ́r, sǝ yàle Saratu ka bumkwana kasǝni wi. <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />Nda Saratu oalo a ɓabumi kǝ ne ɓamurì ama, &lt;&lt;Mim mǝnana ǝn pǝlǝna ɓwagula ka, lang sǝ mǝ nǝ ok banɓoarna mala nongnǝban ɗǝm? Sǝ mǝno ka nda nǝmurǝì ɗàng, nggearǝ mǝtala-ɓala mem yì burém ngga ena gbal.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:17">Tite 17:17</ref></char>.</note><verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />Pǝlǝa Mǝtalabangŋo ɗì Ibǝrayim ama, &lt;&lt;Palang sǝ Saratu oalo sǝ bang ama kǝ sǝni kǝla pà nǝ̀ gandǝ ɓǝl muna ado mǝnana ena ka ɗàng? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />Kǝgir kàm kwan kǝ̀rkǝ́r mǝnana Mǝtalabangŋo pà nǝ̀ gandǝ pe raka le? Kǝla mǝnana ǝn na ka, a kàra mala pǝlǝa ka, mǝ nǝ nyare mǝ yiu, sǝ Saratu ka, nǝ̀ ɓǝl muna-ɓwabura.&gt;&gt;<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />Saratu ka ɓangciu pakki wi, nda na nyir bang ama, &lt;&lt;Ən oal ɗang.&gt;&gt;</para>
  <para style="p" vid="GEN 18:15">Sǝ Mǝtalabangŋo na ama, &lt;&lt;E, a oalo.&gt;&gt;<verse eid="GEN 18:15" /></para>
  <para style="s">Ibǝrayim zǝmba ace Sodom</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />Pǝlǝa aburana mǝno lo à nǝ̀ o. À tsǝk múrià aban ká a ban mǝnana à nǝ̀ gandǝ dili mǝsǝia kàm à nǝ̀ sǝn nggea-là Sodom ngga. Ibǝrayim wari andǝia nǝ̀ tsǝkteà a njargula. <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />Pǝlǝa Mǝtalabangŋo bang ama, &lt;&lt;Mǝ nǝ sǝmbǝrǝì Ibǝrayim gìr mǝnana ǝn nggǝ ká pě ka le? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />Aɓwapǝndǝa a tàu mala Ibǝrayim ngga mbak-kàngkàng à nǝ̀ làkkì kǝ̀rkǝ́r, à nǝ̀ nggá duk nzali mǝgule, sǝ acili anzali ɓanza kat ka à nǝ̀ kum tsǝkbu nǝ baní. <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />Ən tarni aɓalǝ aɓwana ace mǝnana ɓǝ̀ tsǝk amuni andǝ amǝkè kat a njar ɓǝà okam, ɓǝà kasǝ ɓashi a njari sǝ ɓǝà pè aɓa kpata mǝsǝcau. Anggo ka sǝ mǝ nǝ pakki Ibǝrayim agir mǝnana kat ǝn pacau acea ka.&gt;&gt;<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />Pǝlǝa Mǝtalabangŋo ne Ibǝrayim ama, &lt;&lt;Ən ongŋǝna ɓua mala aɓwana arǝ atúró ɓealɓikea mǝkǝ̀rkǝ́rnì mala amǝ Sodom andǝ amǝ Gomora. Acauɓikea malea ɓikipa. <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />Mǝ nǝ nggá sǝni ko gìr mǝnana à pè ka ɓike male kārǝa arǝ ɓua mala aɓwana amúrià mǝnana yiu abanam ngga. Ɓǝ̀ pa anggo raka, mǝ nǝ sǝlǝa.&gt;&gt;<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />Pǝlǝa ɓari atà aburana mǝnia bwal njar aban o nǝ njar ban Sodom, sǝ Ibǝrayim ngga ueo aban came a ɓadǝm Mǝtalabangŋo. <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />Ibǝrayim pǝlǝa sung tù a ban Mǝtalabangŋo sǝ ɗì ama, &lt;&lt;Ɓafo awu nǝ dapi amǝ'ɓealɓoarna andǝ amǝ'ɓealɓikea a nǝ twaltea le? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />Ɓǝ̀ amǝ'ɓealɓoarna nakam lumi-tongno aɓa nggea-lê ka, a nǝ kìɗikì le? A pà nǝ twalbanì atàcau mala amǝ'ɓealɓoarna mǝnia lumi-tongno aɓalǝi ka ɗàng? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />Mǝno ka ɓǝ̀ sappi bano, we murǝmɓashi amur koyan kat a ɓanza, mǝnana ɓǝà bang ama awu nǝ wal-lú amǝ'ɓealɓoarna atà amǝ'ɓealɓikea, sǝ a nǝ pangnǝ amǝ'ɓealɓoarna a njar mǝmwashati kǝla mǝnana awu nǝ pangnǝ amǝ'ɓealɓikea ka. A pà wunǝ pè ɗàng acemǝnana we mana a nda murǝmɓashi amur koyan kat a ɓanza ka, a nǝ pàk gìr mǝnana nda a njarì ka.&gt;&gt;<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />Mǝtalabangŋo bang ama, &lt;&lt;Ɓǝ̀n kum aɓwana amǝ'ɓealɓoarna lumi-tongno aɓa nggea-là Sodom ngga, pà mǝ nǝ kìɗikì ɗàng.&gt;&gt;<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />Pǝlǝa Ibǝrayim nacau ɗǝm ama, &lt;&lt;Ida twàlâm-ban mǝsǝcandǝa mem mala lidǝmba nǝ nacau nǝ we Mǝtalabangŋo, acemǝnana mǝ nda nzali andǝ tú. <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />Ɓǝà bang ama amǝ'ɓealɓoarna nakam lumi-ine bwamdǝ tongno aɓa nggea-là Sodom ngga, awu nǝ kìɗikì acemǝnana kǝ à ndo lumi-ine bwamdǝ tongno ka le?&gt;&gt;</para>
  <para style="p" vid="GEN 18:28">Mǝtalabangŋo eari wi ama, &lt;&lt;Pà mǝ nǝ kìɗikì nggea-lê ɗàng ɓǝ̀n kum amǝ'ɓealɓoarna lumi-ine bwamdǝ tongno aɓalǝi ka.&gt;&gt;<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />Ibǝrayim nyare ne wi cau ɗǝm ama, &lt;&lt;Yakǝla à nǝ̀ kum amǝ'ɓealɓoarna lumi-ine aɓalǝi ka, awu nǝ kìɗikì le?&gt;&gt; Mǝtalabangŋo nyesǝi wi ama, &lt;&lt;Pà mǝ nǝ kìɗikì ɗàng atàcau mala amǝ'ɓealɓoarna lumi-ine aɓalǝi.&gt;&gt;<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />Pǝlǝa Ibǝrayim bang ama, &lt;&lt;Cè bum Mǝtalabangŋo lúllô arǝàm ɗàng, ida earâm mǝ nacau ɗǝm. Ɓǝ̀ amǝ'ɓealɓoarna nakam lumi-tàrú aɓa nggea-lê ka, awu nǝ nggaɗi bumo arǝ kiɗikè le?&gt;&gt;</para>
  <para style="p" vid="GEN 18:30">Mǝtalabangŋo eare ama, &lt;&lt;Pà mǝ nǝ kìɗikì ɗàng ɓǝ̀n kum amǝ'ɓealɓoarna kam lumi-tàrú ka.&gt;&gt;<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />Ibǝrayim bang ama, &lt;&lt;Ida, mǝno ado ǝn pángŋǝ̀nà nǝ mǝsǝkang-kangŋa mǝ nô cau ka, Mǝtalabangŋo, ɓǝ̀ ndo ama lumi-ɓari na nǝmurǝì à nǝ̀ kum kam ngga, mana a nǝ pa?&gt;&gt;</para>
  <para style="p" vid="GEN 18:31">Mǝtalabangŋo na ama, &lt;&lt;Pà mǝ nǝ kìɗikì ɗàng ɓǝ̀n kum lumi-ɓari ka.&gt;&gt;<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />Ibǝrayim bang ama, &lt;&lt;Ɓǝ̀ bum Mǝtalabangŋo ɓǝ̀ kǝa lúllô arǝàm ɗàng. Ida, earâm mǝ nacau ɗǝm kusǝ mwashat. Mana awu nǝ pa ɓǝà kum amǝ'ɓealɓoarna sǝ kǝ à ndo lum kam ngga?&gt;&gt;</para>
  <para style="p" vid="GEN 18:32">Mǝtalabangŋo eari wi ama, &lt;&lt;Pà mǝ nǝ kìɗikì ɗàng atàcau mala aɓwana mǝno lum ngga.&gt;&gt;<verse eid="GEN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 18:33" />Ibǝrayim nyare nacau ɗǝm ɗàng, sǝ lang Mǝtalabangŋo malna nacau nǝ Ibǝrayim ngga, pǝlǝa o, sǝ Ibǝrayim nyare a ɓala.<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">À kìɗìki Sodom andǝ Gomora</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />Amǝturonjar mǝno ɓari yiu a Sodom nǝ pwarikpǝra. À yi kum Lotu aban do a kún nggea-là. Lang sǝnia ka, lo akaurǝa wari abania, ɓunno a nzali makkia wia kún. <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />Banggia wia ama, &lt;&lt;Wun aɓwana-mǝgule, ida wu kàr a ɓala mem, wu lákkí akusǝ wun sǝ wu nongŋo. Ɓǝ̀ banfana ka, wun nǝ̀ gandǝ bwal njar nǝ dǝmbari ɗiɗyal wun nǝ̀ uki a o ma'wun.&gt;&gt;</para>
  <para style="p" vid="GEN 19:2">À bang ama, &lt;&lt;Awo, sǝm ngga sǝm nǝ̀ nongŋo a ban-kpapí mala nggea-là a kún limo.&gt;&gt;<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />Sǝ Lotu ka pìtea, camarǝ ɓuaki arǝia ɓǝà yi nongŋo a ɓala male. Pǝlǝa à eare à wari atè a ɓala male. Kya tsǝk amǝ'túró-ɓala male à pakkia wia girlina mǝɓoarne sǝ à lurǝia wia bǝredi,<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="fq" closed="false">bǝredi: </char><char style="ft" closed="false">Mǝnia ka nda ulang bǝredi mana à kǝ lurǝi akaurǝa ace abǝri ka.</char></note> pǝlǝa à li.<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />Kaniama abǝri man nǝ̀ o a ndà ka, aburana purkio a koya bareban mala nggea-là Sodom, alo-ɓwa andǝ aɓwana-mǝgule kat, à yì kārì ɓala mala Lotu. <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />À tunǝ Lotu nǝ nza sǝ à ɗiban ama, &lt;&lt;Aburana mǝnana à yiu à yi sulǝo a ɓala mò nǝ pwarikpǝra man yalung ngga, à ndake? Pusǝa sǝmia ace mǝnana ɓǝ̀ sǝm nongnǝia ka.&gt;&gt;<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />Lotu puro wari abania a nza pǝlǝa gìr kunkurǝm a nzǝmi <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />sǝ banggia wia ama, &lt;&lt;Wun aɓiam, ǝn nggǝ zǝmba wun, wu kǝa pàk mǝnia yì túró mǝɓike ka ɗàng. <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />Wu sǝni, mǝ ndanǝ amunem amuna-mamǝna ɓari mǝnana à malaká súrǝ̀ ɓwabura raka. Ən nggǝ zǝmba wun, wu came mǝ nǝ yinǝà wun nǝia a nza, sǝ wun nǝ̀ gandǝ pangnǝia kǝla mǝnana wu earce ka. Sǝ mala aburana mǝnia ka, wu kǝa jea ɗàng, acemǝnana yia ka, abǝri na mǝnana à yiu abanam, sǝ à nda aɓata yálban mala ɓala mem ngga.&gt;&gt;<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />À sà'arǝì ama, &lt;&lt;Nyara sǝm anggo!&gt;&gt; Pǝlǝa à bang ama, &lt;&lt;Mǝnia yì ɓwa ka yiu kǝla bǝri a nzali ma'sǝm, sǝ ado ka kǝ earce ama nǝ̀ duk ɓwamǝgule amur sǝm, nǝ̀ kania sǝm gìr mǝnana ɓoaro ɓǝ̀ sǝm pàk ka! Nyingga sǝm njar, ɓǝ̀ ana raka sǝm nǝ̀ pakko gìr mǝnana nǝ̀ ɓike nǝ̀ kútì mǝnana sǝm nǝ̀ pangnǝia ka.&gt;&gt; Pǝlǝa à soa aban yiu arǝ Lotu, à yi nggiki ama à nǝ̀ ɓun kunkurǝm.<verse eid="GEN 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 19:10" />Sǝ amǝturonjar mǝno aɓalǝi ka, à mǝn kunkurǝm, à bwal Lotu à nunni, à nyesǝi aɓa ɓala sǝ à gìr kunkurǝm. <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />Pǝlǝa à soapi aɓwana mǝno ntedu, alo-ɓwa andǝ aɓwana-mǝgule kat, yia mǝno a kunkurǝm a nza nǝ ɓala ka. Mǝsǝia gandǝ sǝnban mǝnana à nǝ̀ súrǝ̀ ban mǝnana kunkurǝm nakam ngga ɗàng.<verse eid="GEN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />Amǝturonjar mǝno banggi Lotu ama, &lt;&lt;Ko a ndanǝ aɓea ɓǝla mò, ko amunio amuna-burana ko amuna-mamǝna, ko ankilo abura amunio, mǝnana à ndanǝ do a ban mǝnia ka? Yinǝia ɓǝà purî ɓá nggea-là mǝnia, <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />acemǝnana sǝm ndo sǝm nǝ̀ kìɗìki nggea-là mǝnia ka. Ɓua mala ɓwapǝndǝa aban Mǝtalabangŋo amur aɓwana mala nggea-là mǝnia ka gul kǝ̀rkǝ́r, nda tasǝ sǝm ɓǝ̀ sǝm yi kiɗikì ka.&gt;&gt;<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />Pǝlǝa Lotu puro wari aban ankili, aburana mǝnana à pur'amur amuna-mamǝna male ka. Banggia wia ama, &lt;&lt;Wu fà rǝ wun wu purî ɓá nggea-là mǝnia ka, acemǝnana Mǝtalabangŋo no nǝ̀ kìɗíkì ka!&gt;&gt; Sǝ yia ankili ka, à twali ama ndoro na pàkkiyi ka.<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />Lang ban na rǝ ká kwáró ka, amǝturonjar pîtà Lotu nǝ cau ama, &lt;&lt;Fà rǝo! Twal māmó andǝ amunio ɓari amuna-mamǝna mǝnana à ndakani a bano ka. Wu puro adyan wu o, ɓǝ̀ ana raka wun nǝ̀ ɗwanyi yilǝmi wun ɓǝ̀ à nǝ̀ sulǝ ɓashi amur nggea-là ka!&gt;&gt;<verse eid="GEN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 19:16" />Lotu dǝndi kǝ pǝlǝki rǝì, nda amǝturonjar kpa garabui, andǝ garabu māmí, andǝ agarabu amuni ɓari amuna-mamǝna sǝ à nunnia à pusǝia ɓǝà purî ɓá nggea-là jam. Amǝturonjar pak mǝno ka acemǝnana Mǝtalabangŋo sǝn mǝsǝswatǝr mala Lotu andǝ amǝɓala male. <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />Lang amǝturonjar pusǝnia à yina a nzǝm nggea-là ka, mwashat atà amǝturonjar banggia ama, &lt;&lt;Wu ɓangŋa ace amsǝ yilǝmi wun! Wu kǝa pǝlǝ mǝsǝ wun anzǝm wun, sǝ wu kǝa came àkǝ ban aɓa dulum ɗàng. Wu ɓang nǝ mire wu o amúr ankono, ɓǝ̀ ana raka wun nǝ̀ kìɗìkì!&gt;&gt;<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />Sǝ Lotu ka bang ama, &lt;&lt;Awo, ɓwamǝgule, ida kǝa tsǝk sǝm ɓǝ̀ sǝm pàk mǝno ka ɗàng. <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />Sǝni, mim guro mò ka, a lǝ́mdǝ́nàm earmúrú kǝ̀rkǝ́r sǝ a pàngŋǝ́nàm cauɓoarna mǝnana a amsǝ yilǝmem ngga. Sǝama pà mǝ nǝ gandǝ ɓangŋa aban ká a ban ankono ɗàng; kaniama mǝ nǝ bik ka, mǝnia yì gìr'mur'mwana ka nǝ̀ kumam a njar, sǝ mǝ nǝ wú. <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />Sǝni, ɓè là nya kani tù mǝnana ɓwa nǝ̀ gandǝ ɓangŋa nǝ̀ ká kàm ngga. Ida, earâm ɓǝ̀n kyan nggam. Là mǝkyauwe na, sǝ a kàm ngga yilǝmem nǝ̀ kum àwá.&gt;&gt;<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />Mǝturonjar eari wi ama, &lt;&lt;Ən earǝ́nò, pàk gìr mǝnana a zǝm ngga. Pà mǝ nǝ kìɗiki mǝno yì là a bangce ka ɗàng. <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />Sǝama fà rǝo! Ɓangŋa! Pà mǝ nǝ pàk kǝgir ɗàng sheɓǝ̀ a bingŋǝna banì ka.&gt;&gt;</para>
  <para style="p" vid="GEN 19:22">Acemani ka à tunǝ lullǝ lê ama Zowar.<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="fq" closed="false">Zowar </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">mǝkyauwe.</char></note><verse eid="GEN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />Lang pwari na rǝ eau ka sǝ Lotu andǝ amǝɓala male yi bik Zowar.<verse eid="GEN 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 19:24" />Kara Mǝtalabangŋo nya mǝsǝtali-earbǝsa andǝ bǝsa amur anggea-là Sodom andǝ Gomora. Yì mǝsǝtali-earbǝsa ka pùr nǝban Mǝtalabangŋo a kùli. <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />Anggo sǝ Mǝtalabangŋo kìɗìki anggea-là mǝno andǝ abân aɓa mǝno yì dulum ngga puppup, sǝ twalta aɓwapǝndǝa mǝnana kat aɓalǝ anggea-lê, andǝ koya girpwala mala nzali mǝno ka. <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />Sǝ mālá Lotu mǝnana nda a nzǝm burí ka, pǝlǝ mǝsǝì sǝnban a nzǝmi, kara nggun-rǝì pǝlǝ tali tuɓamur aban came.<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />Banfa nǝ dǝmbari ɗiɗyal ka Ibǝrayim puro wari a ban mǝnana cam kàm a tadǝmbe a ɓadǝm Mǝtalabangŋo ka. <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />Dìlì mǝsǝì sǝnban nǝ njar Sodom andǝ Gomora andǝ nzali ɓá mǝno yì dulum ngga, sǝ sǝni ka, yele na aban lo amur nzali mǝno kat kǝla ɓá ndà-bǝsa.<verse eid="GEN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 19:29" />Lang Ɓakuli kiɗiki anggea-là mala dulum mǝnana Lotu duk kam ngga, ɗenyinǝ zǝmba mala Ibǝrayim, pǝlǝa pusǝ Lotu ɓǝ̀ apî kìɗìkìban mǝnana yiu amur amǝno yì anggea-là ka.<verse eid="GEN 19:29" /></para>
  <para style="s">Tǝrta amǝ'Mowap andǝ amǝ'Amon</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />Lotu ka ɓangciu pakki wi arǝ do a Zowar, pǝlǝa yì andǝ amuni ɓari amuna-mamǝna à tùro à kya do amur ankono, aɓa ɓè gumi-ɓa'tali. <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />Ɓè fara ka, muni mǝgule ne mǝkyauwe ama, &lt;&lt;Tár sǝm ngga ena, sǝ kǝ ɓwabura pa kàm kaní nǝ̀ kùtí aban sǝm, kǝla mǝnana aɓwana pàkkiyi a koya bân a ɓanza ka ɗàng. <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />Yiu ɓǝ̀ sǝm pè wi mùr-anap ɓǝ̀ nu ɓǝ̀ walì, sǝ sǝm nǝ̀ nongnǝi ace mǝnana ɓǝ̀ sǝm kum amuna, ɓǝ̀ tàu ma'sǝm nǝban tár sǝm ngga ɓǝ̀ kǝa kasǝ raka.&gt;&gt;<verse eid="GEN 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 19:33" />A dù mǝno ka à tsǝk tárrià nu mùr-anap kǝ̀rkǝ́r sǝ walì. Pǝlǝa muna mǝgule muna-ɓwama yiu yi nongnǝ tárrí. Sǝ yì tárrí ka súrǝ̀ bu-pwari mǝnana muni yi nongnǝi sǝ lo u ka ɗàng.<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />Banfa nǝ dǝmbari ka, muna-ɓwama mǝgule banggi mǝkyauwe ama, &lt;&lt;Aɓa dù mǝnia kútí ka, ǝn warina ǝn nongŋǝna nǝ tár sǝm. A dù man yalung ngga, ɓǝ̀ sǝm pè wi mùr-anap ɗǝm ɓǝ̀ nu ɓǝ̀ walì, sǝ wu kyane wu kya nongnǝi. Anggo ka sǝm nǝ̀ kum amuna, ace mǝnana ɓǝ̀ tàu ma'sǝm nǝban tár sǝm ngga ɓǝ̀ kǝa kasǝ raka.&gt;&gt; <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />Nda à tsǝk tárrià nu mùr-anap walì a dù mǝno gbal, sǝ muni muna-ɓwama mǝkyauwe wario kya nongnǝi. Yì ɗǝm ngga sǝlǝce yiu mǝnana muni yi nongnǝi sǝ lo u ka ɗàng.<verse eid="GEN 19:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 19:36" />Anggo sǝ amunà Lotu amuna-mamǝna yia kǝm à kum muna a bumia nǝban tárrià. <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />Muni muna-ɓwama mǝgule ɓǝl muna-ɓwabura, sǝ tsǝki wi lullǝu ama Mowap; yì nda tár amǝ'Mowap ba yalung. <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />Muni muna-ɓwama mǝkyauwe gbal ka ɓǝl muna-ɓwabura, sǝ tsǝki wi lullǝu ama Ben-Ami; yì nda tár amǝ'Amon ba yalung.<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">Ibǝrayim swarki Murǝm Abimelek</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />Pǝlǝa Ibǝrayim tùro nying Mamǝre umnǝ Pǝɗanban Negev, sǝ kya do kǝla bǝri a ɓè ban à tunǝki ama Gera, a nre Kadesh andǝ Shur.<note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 26:1">Tite 26:1</ref>,<ref loc="GEN 26:6">6</ref></char>.</note> <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />Ibǝrayim ne aɓwana mala là mǝno ama māmí Saratu ka, mǝ'eambi na. Nda Abimelek, murǝm Gera, túrban à kya yinǝì wì nǝ Saratu a baní a palta male.<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:13">Tite 12:13</ref>; <ref loc="GEN 26:7">26:7</ref></char>.</note><verse eid="GEN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 20:3" />Sǝama nǝ dù ka, Ɓakuli yiu aban Abimelek aɓa lòrǝo sǝ ne wi ama, &lt;&lt;A nda lú ɓwa, acemǝnana ɓwama mana a twali ka, mā-ala na.&gt;&gt; <verse eid="GEN 20:3" /><verse number="4" style="v" sid="GEN 20:4" />Sǝ Abimelek ka malaká sungŋo abani peatu ɗàng, nda bang ama, &lt;&lt;Ɓakuli, awu nǝ twalta aɓwapǝndǝa mǝnana à pàk kǝ cauɓikea raka lè? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />Ibǝrayim nǝ nggearǝì banggam ama Saratu ka mǝ'eambi na, sǝ yì Saratu gbal ka anggo sǝ banggam. Ən pak gìr mǝnana ǝn pak ka nǝ ɓabum mǝpwat-pwati andǝ kunpwasǝa.&gt;&gt;<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />Pǝlǝa Ɓakuli ne wi aɓa mǝno yì lòrǝo ka ama, &lt;&lt;E, ǝn sǝlǝna ama ɓabumo na pwat-pwat, nda gìr mǝnana tsǝa sǝ ǝn tamsǝo arǝ pakkam cauɓikea ka; ǝn ɗekio wu kúmsǝí ɗàng. <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />Ado ka, nyesǝ ɓwame kyane kya pê burí, acemǝnana yì burí ka mǝɓangnǝa na. Yì ka nǝ̀ pakko hiwi sǝ awu nǝ dum nǝyilǝmu. Sǝ ɓǝ̀a nyesǝi wi māmí raka, awu nǝ sǝlǝa ama ɓafo we wunǝ amǝ'ɓala mò puppup ka, wun nǝ̀ wǔ.&gt;&gt;<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />Abimelek lo nǝ dǝmbari ɗiɗyal, tunǝ amǝ'túró-ɓala male kat sǝ nea wia gìr mǝnana kat kumban ngga. Lang à ok cê ka, ɓangciu bwalia. <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />Pǝlǝa Abimelek túrban à tunǝ Ibǝrayim ɓǝ̀ yiu a baní, sǝ ɗì ama, &lt;&lt;Mana mǝnia a pakka sǝm ani ka? Ya cauɓikea na ǝn pakko mǝnana nǝ̀ tsǝa sǝ a nǝ yinǝ ulang mǝnia yì gìr'mur'mwana amuram andǝ nzali-murǝm mem ngga? A pàngŋǝ́nàm gìr mǝnana ɓoaro ɓwa ɓǝ̀ pè raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:19">Tite 12:19</ref></char>.</note> <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />Osso Abimelek ɗì Ibǝrayim ama, &lt;&lt;Mana nda ɗenyicau mò sǝ a pak mǝnia yì gìr ka?&gt;&gt;<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />Ibǝrayim eari wi ama, &lt;&lt;Ən pê anggo acemǝnana ɗenyicau mem ngga nda mana ama, kǝɓwa pà kàm a ban mǝnia mǝnana kǝ ɓanggi Ɓakuli ka ɗàng, sǝ à nǝ̀ wal-luem ace mǝnana à nǝ̀ ak māmám ngga. <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />Sǝ ɓafo ka, yì, yì Saratu ka mǝ'eambam na. Sǝm nda eambuta-tárrú sǝni, nggea sǝm na pà mwashat raka. Sǝ ǝn ali duk māmám. <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />Lang Ɓakuli tunǝam ɓǝ̀n nying ɓala mala tárrám sǝ mǝ nggǝ gya arǝ abân ngga,<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:1">Tite 12:1</ref></char>.</note> ǝn banggi wi nǝma, &lt;Mǝnia ka nda pěmǝɓoarne mǝnana awu nǝ lǝmdǝàm ngga: Ban mǝnana kat sǝm nǝ̀ ká kàm ngga, banggi aɓwana ama mǝ nda mǝ'eambo.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:13">Tite 12:13</ref></char>.</note><verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />Abimelek pǝlǝa yinǝ anzur andǝ andá, andǝ aguro aburana andǝ amamǝna, pè Ibǝrayim. Sǝ nyesǝî Ibǝrayim māmí, Saratu. <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />Pǝlǝa Abimelek ne Ibǝrayim ama, &lt;&lt;Sǝni, nzali mem ngga, ndya a ɓadǝmbo ka. Ban mana kat wariò a mǝsǝo ka, duk kàm.&gt;&gt;<verse eid="GEN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 20:16" />Ne Saratu ama, &lt;&lt;Mǝ ndya ǝn nggǝ pè &lt;mǝ'eambo&gt; agbatali bolo azǝrfa á-mwashat (1,000) ka. Mǝnia ka mbweban na a bano ace ɓekǝ mǝɓane mǝnana yakǝla ǝn pangnò, sǝ ace lǝmdǝì aɓwana mana atò ka ama kǝ mǝɓane pà kàm a rǝò ɗàng.&gt;&gt;<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="GEN 20:17-18" />Acemǝnana Murǝm Abimelek twal Saratu, mālá Ibǝrayim ngga, Mǝtalabangŋo tamsǝ ɓǝlmuna mala koya ɓwama a palta mala Abimelek. Nda Ibǝrayim pàk hiwi aban Ɓakuli ace Abimelek, sǝ Ɓakuli sonzǝi. Ɗǝm ngga sonzǝ mālá Abimelek andǝ amā-guro male sǝ à kum ɓǝlmuna.<verse eid="GEN 20:17-18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">Saratu ɓǝlî Ibǝrayim muna-ɓwabura</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />Mǝtalabangŋo ɓwamur Saratu kǝla mǝnana na ka, sǝ pàkkî Saratu kǝla mǝnana pàcau ka.<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:16">Tite 17:16</ref>; <ref loc="GEN 18:10">18:10</ref>; <ref loc="GAL 4:23">Gal 4:23</ref></char>.</note> <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />Muna kpa a bum Saratu, ɓǝlî Ibǝrayim muna-ɓwabura aɓa ě male. Mǝnia ka yi lumsǝo a kǝ kúnì mǝnana Ɓakuli na ama à nǝ̀ ɓǝl munê ka.<note caller="+" style="f"><char style="fr" closed="false">21:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:21">Tite 17:21</ref>; <ref loc="GEN 18:10">18:10</ref>,<ref loc="GEN 18:14">14</ref>; <ref loc="HEB 11:11">Ib 11:11</ref></char>.</note> <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />Ibǝrayim pǝlǝa tsǝki muna-ɓwabura mǝnana Saratu ɓǝlî wi ka lullǝu ama Ishaku. <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />Anzǝm nongŋo tongno-nong-tàrú mala ɓǝl Ishaku ka, Ibǝrayim kasǝî wi ɓate kǝla mana Ɓakuli bang ngga. <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />Ibǝrayim ngga, ndanǝ apǝlǝa lumi-lum mǝnana à ɓǝl Ishaku ka.<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:1">Tite 17:1</ref>,<ref loc="GEN 17:17">17</ref>; <ref loc="GEN 18:10">18:10</ref>; <ref loc="ROM 4:19">Rom 4:19</ref></char>.</note> <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />Saratu na ama, &lt;&lt;Ɓakuli yinǝnàm nǝ oalo. Ɓwa mǝnana kat okce ka nǝ̀ bwalàm oalo.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 18:12-15">Tite 18:12-15</ref></char>.</note> <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />Nyare na ɗǝm ama, &lt;&lt;Yana nǝ̀ gandǝ ne Ibǝrayim ama Saratu nǝ̀ pe amuna kiura? Sǝ kat andǝa ě male ka, ǝn ɓǝlî wi muna-ɓwabura!&gt;&gt;<verse eid="GEN 21:7" /></para>
  <para style="s">À pǝ̀r Hajara andǝ muni Ishmayel</para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />Muna, yì Ishaku ka, yi gulo, sǝ a pwari mǝnana à nǝ̀ būrǝi ka, Ibǝrayim tunǝ dapi ace ligirlina mǝgule. <verse eid="GEN 21:8" /><verse number="9" style="v" sid="GEN 21:9" />Ɓè pwari ka Saratu sǝn Ishmayel, muna mǝnana Hajara, ɓwama Masar ɓǝlî Ibǝrayim ngga, aban pak ndoro nǝ Ishaku, muna-ɓwabura mala Saratu. <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />Nda Saratu ne Ibǝrayim ama, &lt;&lt;Pǝ̀r mā-guro man andǝ muni ɓǝà o. Muna-ɓwabura mala ɓwama man pà nǝ̀ liɓala atà muna-ɓwabura mem Ishaku ɗàng.&gt;&gt;<verse eid="GEN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 21:11" />Cau mǝnia ka zurǝi ɗenyicau mala Ibǝrayim kǝ̀rkǝ́r, acemǝnana Ishmayel gbal ka muni na. <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />Sǝ Ɓakuli banggi Ibǝrayim ama, &lt;&lt;Cè ɓabumo zurǝi amur cau mala muna, ko mala muna-ɓwama mǝtúró-ɓala mò ɗàng. Pàk gìr mǝnana kat Saratu kǝ banggo ka, acemǝnana nǝban Ishaku sǝ à nǝ̀ ɓal amǝ'keò. <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />Ɗǝm ngga mǝ nǝ tsǝk muna-ɓwabura mala mā-guro mò nǝ̀ duk kàka aɓwapǝndǝa mala nzali mǝgule, acemǝnana yì gbal ka munio na ka.&gt;&gt;<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />Banfa nǝ dǝmbari ɗiɗyal ka, Ibǝrayim twal girlina andǝ mùr a dù sǝ pè Hajara. Tsǝki wi a múrí sǝ tasǝ takwari andǝ muna ɓǝà o. Hajara andǝ muna o à kǝ gāli a ɓabondo mala amǝ Biyasheba.<verse eid="GEN 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 21:15" />Lang à nùnà mùr mana a dù kat ka, Hajara nongsǝ muna a yilǝm mala ɓè karwan, <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />sǝ o kya duk zak kǝla sauwa mala ban mǝnana ɓǝà túr mundi ka nǝ̀ ká kàm ngga. Bang a ɗenyicau male ama, &lt;&lt;Pà mǝ nǝ gandǝ do sǝ mǝ nggǝ sǝn munem nǝ̀ nggǝ wú ɗàng.&gt;&gt; Lang kya dumǝna zak ka, túrkuni a ɓua, mǝrǝm kǝ sukkio a mǝsǝi.<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />Ɓakuli ok gi muna aban ɓua. Mǝturonjar mala Ɓakuli tunǝ Hajara nǝ kuli sǝ ne wi cau ama, &lt;&lt;Man pùr arǝò le, Hajara? Cè ɓangciu pakko ɗàng; Ɓakuli ongŋǝna gì muna a ban mǝno nongŋo kǝ ɓua kàm ngga. <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />Lo kyane a baní, loasǝi sǝ wu bwali a buo wu girikì. Mǝ nǝ nggá tsǝk amǝkè à nǝ̀ pǝlǝ ɓwapǝndǝa mala nzali mǝgule.&gt;&gt;<verse eid="GEN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 21:19" />Pǝlǝa Ɓakuli mǝn mǝsǝi sǝn tūli-mùr nǝ mur aɓalǝi. Nda wario kya lùmsǝ dù nǝ mur sǝ pè muna nu.<verse eid="GEN 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 21:20" />Ɓakuli ka nda atà muna bà gulo male. Gulo aɓa pǝɗanban sǝ pǝlǝ nggea mǝ'sǝlǝ túr mundi. <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />Do a pǝɗanban mala nzali Paran. Nggè alì wi ɓwama nzali Masar.<verse eid="GEN 21:21" /></para>
  <para style="s">Kùrcau a nre Ibǝrayim andǝ Abimelek a Biyasheba</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />A bàkú mǝno ka murǝm Abimelek andǝ Fiko, mǝ'sàrǝ̀ban amur amǝ'lwa male yiu aban Ibǝrayim, sǝ ne Ibǝrayim ama, &lt;&lt;Ɓakuli na atò aɓa koman kat a pak ka. <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />Ado ka kánbàm gìr àkǝ̀ ban mǝnia ka, aɓa lullǝ Ɓakuli ama a pà nǝ swarkiam, ko amuna mem, ko amǝkèm ɗàng. Kǝla mǝnana ǝn do nǝ ɓabum-mwashat arǝò ka, dumnǝ ɓabum-mwashat arǝàm sǝ arǝ aɓwana mǝnana kat aɓa nzali mǝnia a dukiyi kam ado kǝla bǝri ka.&gt;&gt;<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />Ibǝrayim na ama, &lt;&lt;Ən nggǝ kánbò, mǝ nǝ pàk anggo.&gt;&gt;<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />Pǝlǝa Ibǝrayim nggwani aban Abimelek amur cau mala tūli-mùr mǝnana amǝtúró mala Abimelek e nǝ rǝcandǝa a bu amǝtúró male ka. <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />Sǝ Abimelek bang ama, &lt;&lt;Ən súrǝ̀ yana ɓwe na pàk mǝno yi gìr ka ɗàng. A banggàm ɗàng, sǝ ǝn ok kǝ cau amurí ɗàng she yalung.&gt;&gt;<verse eid="GEN 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 21:27" />Pǝlǝa Ibǝrayim yinǝ aɓea anzur andǝ andá male yi pe Abimelek, sǝ yia kǝm à kùrkûn arǝarǝia mala dotarǝu aɓa rǝpwala. <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />Ibǝrayim ɗǝm ngga tàrki amuna-nzur tongno-nong-ɓari a domwan male, sǝ tsǝia tàràng. <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />Abimelek ɗì Ibǝrayim ama, &lt;&lt;Amuna-nzur mǝnia tongno-nong-ɓari a pusǝia aɓa domwan sǝ a tsǝia tàràng ngga, mana nda tǝ́rí?&gt;&gt;<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />Ibǝrayim eari wi ama, &lt;&lt;Ən nggǝ earce nǝma wu ak amuna-nzur mǝnia tongno-nong-ɓari ka a buam, ace lǝmdǝa a ɓaɓwa ama a earna tūli-mùr mǝnia ka mema acemǝnana mǝ nda ǝn tǝmi ka.&gt;&gt;<verse eid="GEN 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 21:31" />Acemani ka à tunǝ banì ama Biyasheba,<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fq" closed="false">Biyasheba </char><char style="ft" closed="false">ka ɓālǝi nda</char><char style="fqa" closed="false">tūli-mùr mala tongno-nong-ɓari</char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">tūli-mùr mala kùrkûn a rǝu.</char></note> acemǝnana aburana mǝnia ɓari ka, à pacau arǝarǝia nǝ kángìr a banì.<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />Lang à malna pacau arǝarǝia nǝ kángìr a Biyasheba ka, Abimelek andǝ Fiko, mǝ'sàrǝ̀ban amur amǝ'lwa male ka, à nyare à o a nzali malea, nzali mala amǝ Filisti. <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />Ibǝrayim yi pandǝ nggun zāmbo a Biyasheba. A banì ka pàk hiwi aban Mǝtalabangŋo, yì Ɓakuli mǝnana nda tàtǝ́k ka. <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />Anggo sǝ Ibǝrayim do kǝla bǝri a nzali mala amǝ Filisti banì sauwa.<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">Ɓakuli karǝ́ki Ibǝrayim</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />Nǝnzǝ́mò ka, Ɓakuli kárǝ́ki Ibǝrayim. Ne wi ama, &lt;&lt;Ibǝrayim!&gt;&gt; Sǝ Ibǝrayim eare ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />Pǝlǝa Ɓakuli ne wi ama, &lt;&lt;Kyane twal muna-ɓwabura mô, kǝ muna mô mwashat ɓǝ̀rɓǝ̀r, Ishaku, mǝnana a earkiyi ace raka, sǝ wu kyan nǝi a nzali Moriya. Kyane pana ɓoro nǝi kǝla gir'nkila mala pisǝe kǝring, akanó amúr ɓè mǝ'nkono mǝnana mǝ nǝ kanio rǝì ka.&gt;&gt;<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />Nǝ bu-dǝmbari ɗiɗyal, Ibǝrayim lo arki nggun-bǝsa mana nǝ̀ karǝ pisǝ mǝno yì pàgir mala pisǝe kǝring ngga, pǝlǝa tsǝki mǝdambǝriso male twalo a nzǝmi. Loasǝ aɓea amǝ'túró-ɓala male ɓari atè, sǝ muni Ishaku. Pǝlǝa à bwal njar aban ká a ban mǝnana Ɓakuli ne wi cè ka.<verse eid="GEN 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 22:4" />A tàruià nongŋo ka Ibǝrayim loasǝ mǝsǝì sǝn banì kuko. <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />Pǝlǝa ne amǝ'túró-ɓala male ama, &lt;&lt;Wu cam kani, wun andǝ mǝdambǝriso, wu kundǝ sǝm. Mim sǝnǝ muna ka, sǝm nǝ̀ ká kano a dǝmba. Sǝm nǝ̀ nggá peri sǝ sǝm nǝ̀ nyare aban wun.&gt;&gt;<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />Ibǝrayim twal nggun-bǝsa mala pisǝ gir'nkila kǝring, parì muni Ishaku amurí. Sǝ yì ka twal bǝsa andǝ munabyau a bui. Yia ɓari à bwalna njargula aban o ka, <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />Ishaku tunǝ tárrí ama, &lt;&lt;Dàdá?&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Ibǝrayim eari wi ama, &lt;&lt;Mana girnì na, munem?&gt;&gt;</para>
  <para style="p" vid="GEN 22:7">Ishaku lidǝmba ama, &lt;&lt;Bǝsa andǝ gimsa ka à ndya ka, sǝ nggearǝ mǝgam mala pagìr mala pisǝe kǝring ngga, nda male kǝshe?&gt;&gt;<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />Ibǝrayim eari wi ama, &lt;&lt;Ɓakuli nǝ nggeari ka nǝ̀ yinǝ mǝgam mala pa gir'nkila ace pisǝì kǝring, munem.&gt;&gt; Yia kǝm ngga pǝlǝa à lidǝmbǝa aban o atārǝia.<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />Lang à kya bwalna banì mǝnana Ɓakuli kani wi ka, Ibǝrayim ɓak gyangŋan, sǝ gilǝki nggun-bǝsa amurí. Pǝlǝa bwal muni Ishaku tà ka abui andǝ akusǝi sǝ nongsǝi amur nggun-bǝsa mǝnana amur gyangŋan ngga. <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />Sǝ Ibǝrayim lǝmdǝ bui twal byau nǝ̀ wal muni. <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />Sǝama mǝturonjar mala Mǝtalabangŋo tunǝi nǝ kuli ama, &lt;&lt;Ibǝrayim! Ibǝrayim!&gt;&gt;</para>
  <para style="p" vid="GEN 22:11">Yi ka pǝlǝa eare ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />Mǝturonjar ne wi ama, &lt;&lt;Kǝa tsǝk buo arǝ mǝnia yì muna ka ɗàng. Kǝa pakki wi kǝgìr ɗàng. Ən sǝlǝna adyan ama a kǝ ɓanggi Ɓakuli, acemǝnana kǝ munio mǝnia mwashat ɓǝ̀rɓǝ̀r ka, cè kwánǒ arǝàm ɗang.&gt;&gt;<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />Ibǝrayim loasǝ mǝsǝì nǝ̀ sǝnban ngga, kara sǝn mǝgam nǝ anjawe sorǝkina aɓa karwan. Pǝlǝa wario kya pusǝ mǝgam mǝno, sǝ yi pwanmyali, pana gir'nkila mala pisǝe kǝring nǝi a kúnì muni Ishaku. <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />Ibǝrayim pǝlǝa tunǝ banì ama, &lt;&lt;Yahweh Yireh.&gt;&gt; Ɓālǝi ama, &lt;&lt;Yahweh nǝ̀ pa.&gt;&gt; Adyan ngga aɓwana kǝ paktúró nǝi aɓa cau pasǝlǝe ama, &lt;&lt;Amur nkono mala Yahweh ka, à nǝ̀ pà gìr kàm.&gt;&gt;<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />Mǝturonjar mala Mǝtalabangŋo tunǝ Ibǝrayim nǝ kuli ɓaria tunǝban, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />sǝ ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Mǝtalabangŋo na ka: Acemǝnana a okam, sǝ a giram nǝ kǝ muna-ɓwabura mò mǝnia mwashat ɓǝ̀rɓǝ̀r raka, ǝn kánǝna nǝ ɓamúràm ama, <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />mǝsǝcau ka, mǝ nǝ tsǝko bù. Mǝ nǝ tsǝk amunio andǝ amǝ'keò à nǝ̀ làkkì pas mǝnana à pà nǝ̀ gandǝ ɓallia raka. À nǝ̀ làkkì kǝla anlero a bumkuli andǝ làkkì mala mǝsǝsala a kun nggeamùr. Amunio andǝ amǝ'keò ka, à nǝ̀ limurǝm amur aɓia-mǝbura, sǝ à nǝ̀ ak anggea-là malea nǝ rǝcandǝa ɓǝà duk malea.<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 11:12">Ib 11:12</ref></char>.</note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />Nǝban amunio andǝ amǝ'keò sǝ akún mǝnana a ɓanza kat ka, à nǝ̀ kum tsǝkbu, yia kat, acemǝnana a okam ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:3">Tite 12:3</ref>; <ref loc="GEN 26:4">26:4</ref>; <ref loc="ACT 3:25">Atúró 3:25</ref>; <ref loc="GAL 3:8">Gal 3:8</ref></char>.</note><verse eid="GEN 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 22:19" />Pǝlǝa Ibǝrayim nyare aban amǝ'túró-ɓala male sǝ à bwal njar atārǝia aban nyare a Biyasheba. Ibǝrayim lidǝmba nǝ do a Biyasheba.<verse eid="GEN 22:19" /></para>
  <para style="s">Nggurkwar mala Naho</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />Anzǝm agir mǝnia ka, à banggi Ibǝrayim ama Milka, mālá mǝ'eambi Naho ɓǝlǝ́ni wi amuna-burana. <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />Ɓwa mǝdǝmbe malea ka à tunǝi ama Uz, ɓwa mǝnana kpá'nzǝm mǝdǝmba ka nda Buz, sǝ amana à kpá'nzǝmia ka à nda ka Kemuyel, yì tár Aram, kàka amǝ'Aramiya, <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />sǝ Kesed, andǝ Hazo, andǝ Pildash, andǝ Jilap andǝ Betuwel. <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />Betuwel nda tár Rabeka. Milka ɓǝlî Naho, mǝ'eam Ibǝrayim amǝnia yì amuna-burana tongno-nong-tàrú ka. Amúr amǝnia yì amuna-burana tongno-nong-tàrú nǝ bu Milka ka, <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />Naho nyare kum aɓea amuna nǝ bu mā-twala male mana à tunǝi ama Ruma ka. Alullǝ amuna mala Ruma nda ka: Teba, andǝ Gaham, andǝ Tahash, sǝ Ma'aka.<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">Lú andǝ tsǝkban mala Saratu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />Saratu pàk apǝlǝa gbǝman-mwashat nǝ lumi-ɓari bwamdǝ tongno-nong-ɓari (127) a ɓanza, <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />sǝ yi wú a Kiriyat Arba (là mǝnana à tunǝki ama Hebǝron ngga) a nzali Kan'ana; sǝ Ibǝrayim kùtí a ɓala kya ɓua lú male nǝ sukki mǝrǝm.<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />Ibǝrayim pǝlǝa loapi ban ɓua lú māmí sǝ bangcau nǝ amǝ'Hitti ama, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />&lt;&lt;Mǝ nda ɓwa kúnɗàngna, sǝ ǝn do aɓalǝ wun kǝla bǝri. Ida, wu pam nzali kani aɓalǝ wun ace mǝnana ɓǝ̀n tsǝk lú mem kàm ɓǝ̀ gǝshì ɓamǝsǝam ngga.&gt;&gt;<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />Amǝ'Hitti eari wi ama, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />&lt;&lt;Ɓwamǝgule, kwakikiro arǝ sǝm, sǝm nggǝ sǝno nǝ gulo mala muna murǝm Ɓakuli aɓalǝ sǝm. Tsǝk lú mò a koya ɓembe-ɓa-tali mǝnana a sǝni nda ɓoaro ka. Kǝɓwa pà kàm atà sǝm nǝ̀ gironǝ ɓembe-ɓa-tali male ama nǝ̀ tamsǝo arǝ tsǝk lú mò ɗàng.&gt;&gt;<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />Pǝlǝa Ibǝrayim lo sǝ ɓunbî aɓwana mala là mǝno, yì amǝ'Hitti. <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />Sǝ banggia wia ama, &lt;&lt;Ɓǝ̀ wu earǝ́nàm mǝ tsǝk lú mem, ɓǝ̀ gǝshì ɓamǝsǝam ngga, wu kwakikir wun arǝàm: wu zǝmbâm Efǝron muna-ɓwabura mala Zohar, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ace mǝnana ɓǝ̀ pam gumi-ɓa'tali mǝnana nda a ɓaban male a ban mǝnana à tunǝi ama Makpela ka; nda kano a masǝlǝata kún ɓaban male. Wu zǝmbamì ɓǝ̀ makkamì. Mǝ nǝ mbwe boale kat a mǝsǝ amǝ'nakún, ace mǝnana ɓǝ̀ duk girkuma mem, kǝla ban ace tsǝk lú.&gt;&gt;<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />Efǝron ɓwa Hitti nǝ nggeari ka ndakam aban do aɓalǝ acili amǝ'Hitti. Pǝlǝa Efǝron ɓwa Hitti earî Ibǝrayim cau sǝ koyan atà aɓwana-mǝgule mala là ka, à nda kǝ kwakikiria ka. <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />Bang ama, &lt;&lt;Awo, ɓwamǝgule, kwakikiro oěm, ɓaban ngga ǝn pano wi kat, sǝ ǝn pano gumi-ɓa'tali mǝnana aɓalǝi ka. Akani a ɓadǝm aɓwana mem, ǝn pano wi. Tsǝk lú mò.&gt;&gt;<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />Ibǝrayim nyare ɓunno a ɓadǝm aɓwana mala là mǝno <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />sǝ bangcau nǝ Efǝron, a kir aɓwana mala là mǝno ka ama, &lt;&lt;Kwakikiro arǝàm, ɓǝ̀ awu nǝ ear ka. Mǝ nǝ mbweo boalo ɓabanì. Banggam shen nda boale, sǝ mim ngga mǝ nǝ po wi. Ak boale a buam acemǝnana mǝ tsǝk lú mem kàm ngga.&gt;&gt;<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />Efǝron earî Ibǝrayim ama, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />&lt;&lt;Ɓwamǝgule, kwakikiro arǝàm. Ɓaban mǝnana boale ka gbatali bolo azǝrfa gbǝman-ine na ka, ɓè kǝgìr mǝgule na a nrem sǝnǝ we le? Tsǝk lú mò.&gt;&gt;<verse eid="GEN 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 23:16" />Ibǝrayim eare nǝ̀ pà boalo mǝno Efǝron kasǝa sǝ amǝ'Hitti oè ka. Pǝlǝa Ibǝrayim kárǝì Efǝron dǝmbǝrya mala mǝsǝbolo azǝrfa gbǝman-ine, mǝnana kasǝa sǝ amǝ'Hitti oè ka; pàktúró nǝ sǝkel mala azǝrfa mǝnana amǝ'kúrkúró nǝ agir a nza mǝno kǝ pàktúró nǝi ka.<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />Anggo sǝ ɓaban mǝnana ɗiɗyal mala Efǝron na a Makpela, nǝ bu takuli mala Mamǝre, andǝ gumi-ɓa'tali mǝnana aɓalǝi, andǝ anggun mǝnana kat aɓalǝi aban ká nzong kún ɓabanì, andǝ abân mǝnana à kàrì ka, à pǝlǝ girkuma mala Ibǝrayim. <note caller="+" style="f"><char style="fr" closed="false">23:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 25:9">Tite 25:9</ref>; <ref loc="GEN 49:29-32">49:29-32</ref>; <ref loc="GEN 50:13">50:13</ref></char>.</note> <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />Amǝ'Hitti mǝnana kat à wari kano a ban kpapi mala là a kún nggea-là ka, à eare ama ɓaban andǝ koman kat aɓalǝi ka, pǝlǝna girkuma mala Ibǝrayim.<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />Anzǝm mǝno ka, Ibǝrayim tsǝk lú māmí Saratu a gumi-ɓa'tali mǝnana a ɓaban a Makpela tù nǝ nggea-là Mamǝre, mǝnana ba yalung à tunǝi ama Hebǝron, a nzali Kan'ana ka. <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />Anggo sǝ ɓaban mǝno mǝnana ɗiɗyal mala amǝ'Hitti na, andǝ gumi-ɓa'tali mǝnana aɓalǝi ka, pǝlǝ girkuma mala Ibǝrayim ɓǝ̀ duk nzali ɓembe.<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">Ibǝrayim túr mǝtúró-ɓala male <optbreak /> ɓǝ̀ kya kumbì Ishaku ɓwama</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />Ibǝrayim adyan ngga enà pǝlǝna jamgula, sǝ Mǝtalabangŋo ka tsǝngŋǝ́nì bù aɓa koman kat. <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />Pwari mwashat Ibǝrayim bangcau nǝ ɓwamǝgule amur acili amǝ'túró-ɓala male, mǝnana koman kat mala Ibǝrayim ngga nda a buì ka, ama, &lt;&lt;Ida, tsǝk buo aɓa byalam sǝ wu kánbam gìr. <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />Kán nǝ Mǝtalabangŋo Ɓakuli, mǝtala kùli andǝ nzali ama, a pà nǝ earî munem ɓǝ̀ al ɓwama atà amuna-mamǝna mala amǝ'Kan'ana, mǝnana mǝ ndanǝ do aɓalǝia ka ɗàng. <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />Kǝpǝna awu nǝ o a nzali mem, aban aɓǝla mem, wu kya kumbì munem Ishaku ɓwama kàm.&gt;&gt;<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />Pǝlǝa yì mǝtúró-ɓala ka ɗì ama, &lt;&lt;Ɓǝ̀n wario sǝ ǝn kum ɓwama atà aɓǝla mò, sǝ yakǝla pà nǝ̀ eare nǝ̀ nying là male nǝ̀ twal gya mǝsauwe nǝ̀ yiu atàm a nzali man raka; ɓǝ̀n twal Ishaku mǝ nyesǝi kano ɓǝ̀ kya do aɓalǝ aɓwana mò a là mǝnana a pur kàm ngga le?&gt;&gt;<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />Ibǝrayim eari wi ama, &lt;&lt;Awo, tsǝkiro, cala a twal munem a kyan nǝi akano ɗàng! <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />Mǝtalabangŋo Ɓakuli, mǝtala kùli pùsǝám ɓǝ̀n purì ɓala mala tárrám andǝ nzali mana à ɓǝ̀lám kam ngga. Yinǝam kani sǝ banggam cau nǝ kángìr ama, nǝ̀ pè amunem andǝ amǝ'kèm nzali mǝnia ka. Yì ka nǝ̀ tasǝ mǝturonjar male ɓǝ̀ ako dǝmba ace mǝnana wu kumbì munem ɓwama kanó. <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />Sǝ ɓǝ̀ ɓwame ɓinǝe ama pà nǝ̀ yiu atò raka, a purni ɓata kána mem mǝnia ka. Sǝ cè kǝgìr tsǝo a twal munem a umnǝi kano ɗàng!&gt;&gt;<verse eid="GEN 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 24:9" />Nda mǝtúró-ɓala man tsǝk buì aɓa byal Ibǝrayim mǝtala-ɓala male, sǝ kángìr ama nǝ̀ kpata cau mǝnana Ibǝrayim banggi wi ka.<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />Pǝlǝa mǝtúró-ɓala man twal lum aɓalǝ akalakadambi mala mǝtala-ɓala male, sǝ gilǝ twalo a nzǝmia mala agir mǝɓoarne ɗàng-ɗáng mǝnana mǝtala-ɓala male pè wi ɓǝ̀ umnǝia a buì ace paɓoro ka. Twal gya aban o a bu-nzali <note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 23:4">Nggur 23:4</ref>; <ref loc="JDG 3:8">Akas 3:8</ref></char>.</note>Aram-Naharayim.<note caller="+" style="f"><char style="fr" closed="false">24:10 </char><char style="fq" closed="false">Aram-Naharayim </char><char style="ft" closed="false">ngga nda nzali Mesopotamiya.</char></note> Kutio wari a nggea-là mala a Naho, mǝ'eam Ibǝrayim. <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />Lang bingŋǝ́nà ka, tsǝk akalakadambi à ɓunno amur ankūnǝia a ban ɓe mgbeɗe mùr a nzǝm la. Ndanǝ pwarikpǝra nǝ bu-pwari mana amamǝna kǝ puro ace to mùr ka. <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />Pàk hiwi ama, &lt;&lt;Mǝtalabangŋo, Ɓakuli mala mǝtala-ɓala mem Ibǝrayim, ǝn nggǝ zǝmbo, tsǝa ɓǝ̀ gya mem kum lùmsǝo yalung. Lǝmdǝ domǝsǝcau mò aban mǝtala-ɓala mem Ibǝrayim. <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />Sǝni, mǝ ndya ǝn came a kún mgbeɗe mùr mǝnia ka, sǝ amamǝna mala aɓwana mǝnana à nda a là mǝnia ka, à ndya à kǝ yiua to mùr ka. <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />Zǝmba mem ngga ndya ani ka: Ɓǝ̀n ne ɓeɓwa atà amuna-mamǝna ama, &lt;Ida, pàm mùr mana aɓa bàng mò ka ɓǝ̀n nu,&gt; sǝ nǝ̀ bang ama, &lt;Ang nu, sǝ mǝ nǝ pè akalakadambi mô mùr ɓǝà nu gbal&gt; ka, ɓǝ̀ do nda muna-ɓwama mǝnana a tarì ace guro mò Ishaku, ɓǝ̀ duk māmí ka. Anggo ka sǝ mǝ nǝ sǝlǝa ama a lǝmdǝna domǝsǝcau aban mǝtala-ɓala mem.&gt;&gt;<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />Malaká mal pàk hiwi ɗàng, Rabeka yi tusǝo nǝ bàng amurí. Yì Rabeka ka muna Betuwel muna-ɓwabura mala Milka, mālá Naho mǝ'eam Ibǝrayim na. <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />Rabeka ka, ɓanggî ɓoarnsari male, sǝ gulna kārǝ́na doɓala, sǝ malaká je andǝ kǝ ɓwabura ɗang. Yi sulǝo a kún mgbeɗe mùr, lùmsǝ bàng male nǝ mùr, pǝlǝa eauwe. <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />Mǝtúró-ɓala mala Ibǝrayim tù nǝ mire atè, ne wi ama, &lt;&lt;Ida, pàm mùr a bàng mò ɓǝ̀n nu.&gt;&gt; <verse eid="GEN 24:17" /><verse number="18" style="v" sid="GEN 24:18" />Ne wi ama, &lt;&lt;Ɓwamǝgule, mùr nia ka nu.&gt;&gt; Pǝlǝa sulǝ bàng akaurǝa a myal-bui, sǝ danggǝri kún bàng pè wi mùr nu. <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />Anzǝm mana pàni wi mùr nùnà ka, bang ama, &lt;&lt;Mǝ nǝ ɗarǝî akalakadambi mò mùr gbal ɓǝà nu sheɓǝ̀ kārǝ́nia ka.&gt;&gt; <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />Pǝlǝa nyesǝ cili mùr mǝno a bàng ngga solǝi akaurǝa aɓa nkenye-mùr mala agirkusǝu, sǝ nyar nǝ mire a kún tūli-mùr, sǝ camarǝ dàrǝ́kì akalakadambi male mùr mana kárǝìa kat ka.<verse eid="GEN 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 24:21" />Ɓwabura man came kǝ sǝni kúni ɗǝong, kǝ ndali ko Mǝtalabangŋo tsǝngŋǝ̀nà gya male kumǝna lùmsǝo. <verse eid="GEN 24:21" /><verse number="22" style="v" sid="GEN 24:22" />Anzǝm mana akalakadambi malna nù mùr ka, ɓwabura man pusǝ nyanye<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">Dǝmbǝrya male ka mǝtyang 6 na.</char></note> andǝ agirgarabu ɓari amǝɓoarne kǝ̀rkǝ́r, mǝnana à pea nǝ bolo-njengǝlan ngga. Oasǝi wi nyanye a lùllǝì, sǝ oasǝi wi agirgarabu arǝ abui. <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />Pǝlǝa ɗì ama, &lt;&lt;Ən zǝmbo, banggam yana nda tárró? Ɗǝm ngga banggam, ban nakam a ɓala mala tárró mǝnana mim sǝnǝ aburana mǝnia atàm ngga sǝm nǝ̀ gandǝ nong kàm yalung ngga le?&gt;&gt;<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />Rabeka eari wi ama, &lt;&lt;Mǝ nda muna mala Betuwel. Kâ mǝɓwabure nda Naho, sǝ kâ mǝɓwame nda Milka. <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />E, sǝm ndanǝ ban mǝnana wun kat wun nǝ̀ gandǝ nong kam yalung a ɓala ma'sǝm, sǝ ɗǝm ngga sǝm ndanǝ mǝsǝkuri andǝ dǝmo kpǝm ace akalakadambi ma'wun.&gt;&gt;<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />Ɓwabura man ti múrí sǝ peri aban Mǝtalabangŋo, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />bang ama, &lt;&lt;Ɓwangsǝban ɓǝ̀ pà aban Mǝtalabangŋo, yì Ɓakuli mala mǝtala-ɓala mem Ibǝrayim. Yì ka nying buì arǝ lǝmdǝ pěmǝɓoarne andǝ kpata pacau male aban mǝtala-ɓala mem ɗàng. Mǝtalabangŋo gingŋǝ́nànǝ mim kporong aban aɓǝla mala mǝtala-ɓala mem.&gt;&gt;<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />Nsari man twal mire o aban amǝɓala mala nggè, sǝ kya bang cau mala agir mǝnia kat. <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />Nsari yì Rabeka ka, ndanǝ mǝgula muna-ɓwabura, lùllǝì ama Laban. Laban puro akaurǝa aban ká aban mgbeɗe mùr nǝ̀ nggá kum mǝtúró-ɓala mala Ibǝrayim. <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />Lang sǝn agirgarabu arǝ abu mǝ'eambi Rabeka andǝ nyanye-lullǝu, sǝ ok cau mǝnana mǝ'eambi yi na, mǝnana ɓwabure banggi wi ka, puro wario sǝ yi sǝn ɓwabure aban came a ban akalakadambi a kún mgbeɗe mùr. <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />Pǝlǝa gingsǝ ɓwabure sǝ ne wi ama, &lt;&lt;Yiu atàm a ɓala. A nda ɓwa mǝnana Mǝtalabangŋo tsǝngŋǝ́nì bù ka. Ɓoaro wu cam kani a nza ɗàng. Mǝ ndanǝ ban aceo a ɓala mem, sǝ ban nakam ace akalakadambi mô.&gt;&gt;<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />Nda ɓwabure, yì mǝtúró-ɓala mala Ibǝrayim o a ɓala, sǝ kya sulǝ atwalo mǝnana a nzǝm akalakadambi ka. À yinǝ mǝsǝkuri andǝ dǝmo à pè akalakadambi, sǝ à ɗàrǝ́ mùr à pè mǝtúró-ɓala mala Ibǝrayim andǝ aburana mana atè ka ɓǝà lakki akusǝia. <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />Lang à yinǝia wia girlina ɓǝà lì ka, mǝtúró-ɓala mala Ibǝrayim bang ama, &lt;&lt;Pà mǝ nǝ lìli ɗang she ɓǝ̀n bangŋǝ́nà wun gìr mǝnana yinǝ mim ngga.&gt;&gt;</para>
  <para style="p" vid="GEN 24:33">Laban bang ama, &lt;&lt;Lidǝmba bangga sǝm.&gt;&gt;<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />Pǝlǝa ɓwabure tite ama, &lt;&lt;Mǝ nda mǝtúró-ɓala mala Ibǝrayim. <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />Mǝtala-ɓala mem ngga Mǝtalabangŋo tsǝki wi bu kǝ̀rkǝ́r, sǝ tsǝì duk mǝgǝna. Ɓakuli pe wi adomwan mala andá, andǝ ambulpǝndǝa, andǝ anzur; sǝ pè wi azǝrfa, andǝ bolo-njengǝlan, andǝ aguro aburana andǝ amamǝna, andǝ akalakadambi, andǝ amǝdambǝriso. <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />Saratu, mālá mǝtala-ɓala mem ngga ɓǝlî wi muna-ɓwabura a ě male, sǝ mǝtala-ɓala mem pàni wi a buì koman mǝnana kat male na ka. <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />Mǝtala-ɓala mem tsǝem ǝn kánbì wi gìr ama mǝ nǝ kpata cau male. Bang ama, &lt;Cè a alì munem ɓwama atà ansarina mala amǝ'Kan'ana mǝnana mǝ ndanǝ do a nzali malea ka ɗàng. <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />A kún mani ka, o aban aɓwana mala tárrám, aban aɓǝla mem, sǝ wu kya alì ɓwama kàm.&gt; <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />Sǝ ǝn ɗî mǝtala-ɓala mem nǝma, &lt;Mana mǝ nǝ pa, ɓǝ̀n kum ɓwama mǝnana nǝ̀ eare nǝ̀ yiu atàm raka?&gt; <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />Nyesǝâm cau ama, &lt;Mǝtalabangŋo mǝnana ǝn kpakiyi atà njar male koya pwari ka, nǝ̀ tasǝ mǝturonjar male atò, nǝ̀ tsǝk gya mô ɓǝ̀ kum lùmsǝo. Awu nǝ kumbì munem ɓwama atà aɓwana mem, a ɓala mala tárrám. <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />Sǝama ɓǝ̀a wari aban aɓǝla mem, sǝ à ɓinǝe ama à pà nǝ̀ earî ɓwame ɓǝ̀ yiu atò raka, a purni ɓata kána mò mǝnia ka.&gt;<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />&lt;&lt;Lang ǝn yiu yalung a kún mgbeɗe mùr ka, ǝn pak hiwi ama, &lt;Mǝtalabangŋo, Ɓakuli mala mǝtala-ɓala mem Ibǝrayim, ǝn zǝmbo, ɗeki gya mǝnia ǝn twalo sǝ ǝn yiu kani ka ɓǝ̀ kum lùmsǝo. <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />Mǝ ndya ǝn came a kún mgbeɗe mùr ka. Ɓǝ̀ kǝ muna-ɓwama<note caller="+" style="f"><char style="fr" closed="false">24:43 </char><char style="fq" closed="false">muna-ɓwama </char><char style="ft" closed="false">ko &lt;&lt;nsari.&gt;&gt;</char></note> puro yiua to mùr ka, mǝ nǝ zǝmbi wi ɓǝ̀ pàm mùr a bàng male ɓǝ̀n nu. <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />Ɓǝ̀ eare pàm mùr sǝ bang gbal ama nǝ̀ ɗarǝî akalakadambi mem mùr ka, ɓǝ̀ do ama yì nda ɓwama mǝnana a tarni ɓǝ̀ duk mālá muna mala mǝtala-ɓala mem ngga.&gt;<verse eid="GEN 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 24:45" />&lt;&lt;Kaniama mǝ nǝ mal pàk hiwi mem ngga, Rabeka yi tusǝo nǝ bàng a múrí sǝ kutio sulǝo a tūli mgbeɗe mùr, ɗàrǝ́ mur. Ən banggi wi nǝma, &lt;Ida, pàm mùr mǝ nu.&gt; <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />Kara sulǝ bàng male a myal bui sǝ na ama, &lt;Nu, sǝ mǝ nǝ ɗarǝî akalakadambi mô gbal ɓǝà nu.&gt; Nda ǝn nu, sǝ kutio kya ɗarǝî akalakadambi mem mùr à nu. <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />Osso ǝn ɗî nǝma, &lt;Yana nda tárró?&gt; Pǝlǝa earâm ama, &lt;Tárrám nda Betuwel, muna mala Naho mǝnana à ɓǝl andǝ Milka ka.&gt; Pǝlǝa ǝn twal nyanye-lullǝu ǝn oasǝi wi, sǝ ǝn oasǝi wi agirgarabu arǝ amyal-bui. <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />Sǝ ǝn ɓunno ǝn peri aban Mǝtalabangŋo. Ən ɓwangsǝ Mǝtalabangŋo, yì Ɓakuli mala mǝtala-ɓala mem Ibǝrayim, mǝnana gingnǝ mim kporong aban ɓǝla mala mǝtala-ɓala mem, ban mǝnana ǝn yi kum ɓoarnsarile ɓǝ̀ duk mālá muna mala mǝtala-ɓala mem ngga. <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />Ado ka wu banggam, wun nǝ̀ lǝmdǝ pěmǝɓoarne andǝ domǝsǝcau aban mǝtala-ɓala mem, wun nǝ̀ pàk gìr mǝnana ǝn nggǝ ɗice ka le? Sǝ ɓǝ̀ pà wun nǝ̀ pàk raka, wu banggam gbal, ace mǝnana mǝ bwal njar mǝnana mǝ nǝ u kam ngga.&gt;&gt;<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />Pǝlǝa Laban andǝ Betuwel eari wi ama, &lt;&lt;Gìr mǝnia ka pur nǝban Mǝtalabangŋo; sǝm panǝ kǝ cau mǝnana sǝm nǝ̀ na ka ɗàng. <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />Rabeka ka ndya ka; twali wu o. Ɓǝ̀ kya duk mālá muna-ɓwabura mala mǝtala-ɓala mò, kǝla mǝnana Mǝtalabangŋo nǝ nggeari bang ngga.&gt;&gt;<verse eid="GEN 24:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="GEN 24:52" />Lang mǝtúró-ɓala mala Ibǝrayim ok cau mǝnia ka, ɓunno a nzali sǝ peri aban Mǝtalabangŋo. <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />Pǝlǝa pusǝ agir-nggūrǝu andǝ agir gilǝki rǝu mǝnana à pea nǝ bolo-azǝrfa andǝ bolo-njengǝlan ngga, sǝ pè Rabeka. Nyar ɗǝm pè mǝ'eambi andǝ ngge aɓoro mana boalea pà bǝti raka.<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />Pǝlǝa mǝtúró-ɓala mala Ibǝrayim andǝ aburana mana atè ka à lǐ sǝ à nǔ, sǝ à nong kanó. Lang ban fana nǝ dǝmbari ka, mǝtúró-ɓala mala Ibǝrayim bang ama, &lt;&lt;Ən nggǝ earce nǝma ɓǝ̀ wu ɗekiam mǝ nǝ nyare aban Mǝtala-ɓala mem.&gt;&gt;<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />Sǝ mǝ'eam Rabeka andǝ ngge ka à bang ama, &lt;&lt;Ɗeki Rabeka ɓǝ̀ ue kani atà sǝm, kǝla nongŋo lum; anzǝm mǝno ka sǝ nǝ̀ o.&gt;&gt;<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />Sǝ yì ka na ama, &lt;&lt;Wu kǝa tsǝem ɓǝ̀n dǝndi ɗang. Mǝtalabangŋo tsǝngŋǝ̀nà gya mem kumǝna lùmsǝo; wu ɗekiam mǝ nyare aban Mǝtala-ɓala mem.&gt;&gt;<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />À eari wi ama, &lt;&lt;Cam lâ ɓǝ̀ sǝm tunǝ muna-ɓwama, yì Rabeka, ɓǝ̀ sǝm ɗì ɓǝ̀ na sǝm eare mala ɓabumi.&gt;&gt;<verse eid="GEN 24:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="GEN 24:58" />Osso à tunǝ Rabeka sǝ à ɗì ama, &lt;&lt;A kǝ earce wun nǝ̀ o wunǝ ɓwa man le?&gt;&gt;</para>
  <para style="p" vid="GEN 24:58">Rabeka eare ama, &lt;&lt;E.&gt;&gt;<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />Nda aɓwana mala Rabeka ɗeki ɓǝ̀ o atārǝia andǝ ɓwama mǝnana iulǝi ka, andǝ mǝtúró-ɓala mala Ibǝrayim andǝ aburana mana atè ka. <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />À tsǝktè nǝ mǝnia yì acau mǝɓoarne mala tsǝkbu ka ama:</para>
  <para style="q1" vid="GEN 24:60">Ɓǝ̀ Ɓakuli tsǝo, we mǝ'eam sǝm,</para>
  <para style="q2" vid="GEN 24:60">wu duk nggea ka amuna nyangsang!</para>
  <para style="q1" vid="GEN 24:60">Ɓǝ̀ Ɓakuli tsǝa amunio andǝ amǝ'keo</para>
  <para style="q2" vid="GEN 24:60">ɓǝà lì ka nggea-là mala aɓia-mǝbura!<verse eid="GEN 24:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="GEN 24:61" />Pǝlǝa Rabeka andǝ amuna-mamǝna amǝ'túró-ɓala mǝnana à pe wi ka, à gilǝ atwalo malea sǝ à eaki a nzǝm akalakadambi, à nǝ̀ o andǝ mǝtúró-ɓala mala Ibǝrayim. Nda à bwal njargula aban o ka.<verse eid="GEN 24:61" /></para>
  <para style="s">Ishaku kúllí māmí</para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />Ishaku nyàrî Biya-Lahai-Royi; yì ka ndanǝ do a nzali Negev. <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />Ɓè pwarikpǝra ka puro kǝ gya aban pakki aɗenyicau a banfana a nzǝm là-gumli malea. Lang loasǝ mǝsǝi ka, sǝn akalakadambi aban yiu. <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />Lang Rabeka loasǝ mǝsǝi gbal sǝn Ishaku ka, zúrró sùlǝî nzǝm kalakadambi male <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />sǝ ɗì mǝtúró-ɓala mala Ibǝrayim ama, &lt;&lt;Yana ɓwe nda mǝno kǝ gya a banfana kǝ yiu a kúllí sǝm ngga?&gt;&gt;</para>
  <para style="p" vid="GEN 24:65">Mǝtúró-ɓala mala Ibǝrayim earî wi ama, &lt;&lt;Mǝtala-ɓala mem ma.&gt;&gt; Kara Rabeka gìr múrí nǝ nggubyau-koarǝu male.<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />Lang à bwalna ka, mǝtúró-ɓala mala Ibǝrayim bǝ́lì Ishaku kún-bǝri ɗǝɗak. <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />Pǝlǝa Ishaku kútí nǝ Rabeka aɓa gumli mala nggè Saratu. Twal Rabeka sǝ pǝlǝ māmí. Ishaku earce Rabeka. Nda Ishaku kum girikiban anzǝm lú mala nggè ka.<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">Nggurkwar mala Ibǝrayim nǝ bu Ketura</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">25:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1CH 1:32-33">1Acau 1:32-33</ref>
      </char>.</note> Ibǝrayim al ɓè ɓwama lùllǝì ama Ketura. <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />Ɓǝlî wi amuna mǝnia: Zimran, andǝ Jokshan, andǝ Medan, andǝ Midiyan, andǝ Ishbak, sǝ Shua. <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />Jokshan nda tár a Sheba andǝ Dedan. A tǝrta Dedan sǝ amǝ'Asshurim, andǝ amǝ'Letushim, andǝ amǝ Leumim yi puro. <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />Amuna-burana mala Midiyan ngga, à nda ka Efa, andǝ Efer, andǝ Hanok, andǝ Abida sǝ Elda. Yià mǝnia kat ka, à nda ka amuna andǝ amǝ'kau nǝ bu Ketura.<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />Koman mǝnana kat Ibǝrayim ndanǝi ka nyinggi muni Ishaku ɓǝ̀ do nda mǝliɓala male. <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />Sǝ mala amuna-burana mǝnana acili amāmí ɓǝlî wi ka, pākia wia aɓoro. Sǝ nda andǝa-yilǝmu peatu ka, gbara tasǝia ɓǝà o a ɓè nzali a njar-takuli, ɓǝà upi ban muni Ishaku.<verse eid="GEN 25:6" /></para>
  <para style="s">Lú mala Ibǝrayim andǝ tsǝkban male</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />Do ɓanza mala Ibǝrayim kat ka, apǝlǝa gbǝman-mwashat nǝ lumi-tongno-nong-ɓari bwamdǝ tongno na (175). <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />Ibǝrayim yi wú, lú mala kaɓa-ɓwa, anzǝm do ɓanza mǝsauwe aɓa rǝpwala pepè. À tsǝì atà akê. <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />Amuna-burana male, Ishaku andǝ Ishmayel tsǝk-luí a gumi-ɓa'tali a Makpela, tù a ban là Mamǝre a ɓaban mǝnana ɗiɗyal ka mala Efǝron muna-ɓwabura mala Zohar, ɓwa'Hitti na ka. <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />Mǝno yì nzali ka nda ɓaban mǝnana Ibǝrayim akdǝmba kúrí a bu amǝ'Hitti ka. A kàm sǝ à tsǝk-lú Ibǝrayim a nkanggari māmí Saratu. <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />Anzǝm lú mala Ibǝrayim ngga, Ɓakuli tsǝki muni Ishaku bu. Ishaku tùro yi do tù aban là mǝnana à tunǝi ama Biya-Lahai-Royi ka.<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 16:14">Tite 16:14</ref></char>.</note><verse eid="GEN 25:11" /></para>
  <para style="s">Amuna andǝ amǝkau a nggurkwar mala Ishmayel</para>
  <para style="r">(<ref loc="1CH 1:28-31">1 Acau la Apwari 1:28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />Mǝnia ka nda tsaɗya mala amuna andǝ amǝkau a nggurkwar mala Ishmayel, muna mala Ibǝrayim nǝ bu Hajara ɓwama Masar sǝ mǝtúró-ɓala mala Saratu.<verse eid="GEN 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 25:13" />Amǝnia ka à nda ka alullǝ amuna-burana mala Ishmayel; à ɓallia kǝla mǝnana à ɓǝlia ka: muna-dǝmba mala Ishmayel nda Nebayot. A nzǝmi ka à yi ɓǝl Keda, andǝ Adǝbil, andǝ Mibsam, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />andǝ Mishma, andǝ Duma, andǝ Masa, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />andǝ Hadat, andǝ Tema, andǝ Jetur, andǝ Nafish, sǝ Kedema.<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:20">Tite 17:20</ref></char>.</note> <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />Amǝnia yì amuna-burana lum-nong-ɓari mala Ishmayel ka, à yi duk atár anzali. Ko yan ateà ka à tunǝ lullǝ nzali andǝ bando male nǝ lullǝì. <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />Do ɓanza mala Ishmayel kat ka, pǝlǝa gbǝman-mwashat nǝ lumi-tàrú bwamdǝ tongno-nong-ɓari (137) na. Do ɓanza male malâ pǝlǝa wu, sǝ à tsǝkbani atà akê. <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />Amuni andǝ amǝkè do a bu-nzali mǝnana nongŋo a nre Havila andǝ Shur, tù nǝ nzong-nzali Masar a njar-takuli, ɓǝ̀ ɓwa nǝ̀ umnǝ nzali Asshur<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">Nzali </char><char style="it">Asshur</char> ka nda nzali Saina.</note> ka. Tārǝtè kya dupi aɓǝla male zak.<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="fq" closed="false">Tārǝtè kya dupi aɓǝla male zak </char><char style="ft" closed="false">ko &lt;&lt;do aɓa ɓìkìdo aban aɓǝla male.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 16:12">Tite 16:12</ref></char>.</note><verse eid="GEN 25:18" /></para>
  <para style="s">Ishaku andǝ amuni</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />Mǝnia ka nda tàu mala Ishaku muna mala Ibǝrayim.</para>
  <para style="p" vid="GEN 25:19">Ibǝrayim nda tár Ishaku. <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />Ishaku ka ndanǝ apǝlǝa lumi-ine sǝ al Rabeka, muna mala Betuwel, ɓwa'Aram, mǝnana pùr a nzali Padan Aram ngga.<note caller="+" style="f"><char style="fr" closed="false">25:20 </char><char style="ft" closed="false">Padan Aram ngga nda nzali Mesopotamiya.</char></note> Yì Rabeka ɗǝm ngga nda mǝ'nggaula Laban, ɓwa'Aram.<verse eid="GEN 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 25:21" />Rabeka ka nkombi na, acemani ka Ishaku ɓua aban Mǝtalabangŋo ace māmí ace mǝnana ɓǝ̀ kum muna ka. Mǝtalabangŋo ok ɓua male pǝlǝa muna kpa a bum māmí Rabeka. <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />Amuna man ngga à kǝ warwara a bum nggea. Rabeka bang ama, &lt;&lt;Man tsǝa sǝ mǝnia yì gìr kǝ kumam?&gt;&gt; Pǝlǝa wario kya ɗìbancau aban Mǝtalabangŋo.<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />Mǝtalabangŋo ne wi ama,</para>
  <para style="q1" vid="GEN 25:23">&lt;&lt;Atár anzali ɓari na a bumo.</para>
  <para style="q1" vid="GEN 25:23">Aɓwana ɓari mǝnia a bumo ka,</para>
  <para style="q2" vid="GEN 25:23">à nǝ̀ nggá duk anzali ɓari,</para>
  <para style="q2" vid="GEN 25:23">sǝ à nǝ̀ duk ɓìbura arǝarǝia.</para>
  <para style="q1" vid="GEN 25:23">Nzali mala ɓwa man mwashat ka,</para>
  <para style="q2" vid="GEN 25:23">nǝ̀ kútì nzali mala ɓì nǝ rǝcandǝa.</para>
  <para style="q1" vid="GEN 25:23">Aɓwana mala muna-dǝmba ka,</para>
  <para style="q2" vid="GEN 25:23">à nǝ̀ nggá duk aguro aɓata aɓwana mala mǝkyauwe.&gt;&gt;<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />Lang pwari gbáshí kārǝ́na ka, à sǝni ka amuna pasa na mǝnana a bum Rabeka ka. <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />Mǝdǝmbe nǝ̀ yia pùr ka mǝ'nggubangŋa na, sǝ rǝi ka nyáng na kat kǝla daura mana à tè nǝ nyáng ngga. Pǝlǝa à tsǝki wi lullǝu ama Isǝwa. <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />Anzǝmi ka, mǝ'eambi yi tusǝ nǝ bui aban gbami myalkusǝ Isǝwa. Acemani ka, à tsǝki wi lullǝu ama Yakupu.<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="fq" closed="false">Yakupu </char><char style="ft" closed="false">ka ɓālǝi nda gbami myalkusǝu.</char></note> Ishaku ka ndanǝ apǝlǝa lumi-tongno-nong-mwashat (60) mana Rabeka gbáshí apasa man ngga.<verse eid="GEN 25:26" /></para>
  <para style="s">Isǝwa mak gulo male mala muna-dǝmba</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />Lang amuna-burana man gulna ka, Isǝwa yi duk mǝ'sǝlǝ pǝra ace sǝlǝ ɓombo male. Kǝ mal apwari male aban gya a njenza. Sǝ mǝ'eambi Yakupu ka, mǝkúnɗǝong na, dukiyi male a ɓala. <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />Ishaku ka earce Isǝwa acemǝnana ban kǝ ɓoari wi arǝ shak nyam-bondo mǝnana Isǝwa kǝ walo kǝ yinǝi ka. Sǝ Rabeka ka kǝ earce Yakupu.<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />A ɓè fara, Yakupu na ban lam mbú sǝ Isǝwa nyàrî ɓabondo, aulǝna sǝ nzala kǝ wali. <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />Ne Yakupu ama, &lt;&lt;Ɗàrǝâm mbú mǝbangŋe mò mǝna pé, nzala earam ɗàng.&gt;&gt; (Akani sǝ Isǝwa kum lullǝ mǝnana ama, Edom<note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="fq" closed="false">Edom </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;mǝbangŋe.&gt;&gt;</char></note> ngga.)<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />Yakupu eari wi ama, &lt;&lt;Mǝ nǝ pò, ɓǝ̀ awu nǝ nyinggam bancame mala gulo mò mala muna-dǝmba ka.<note caller="+" style="f"><char style="fr" closed="false">25:31 </char><char style="fq" closed="false">bancame mala gulo mò mala muna-dǝmba ka: </char><char style="ft" closed="false">Mǝnia nda gulo male kǝla muna-dǝmba, andǝ do ɓwamǝgule amúr ɓala andǝ liɓala mala tárrí.</char></note>&gt;&gt;<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />Isǝwa ama, &lt;&lt;Mana nda ɓoaro mala gulo mala muna-dǝmba abanam mǝnana nzala no kǝ earce wal-luem ngga? Mǝ nǝ pò wi.&gt;&gt;<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />Sǝ Yakupu ne wi ama, &lt;&lt;Kánbàm gìr peatu ama awu nǝ pàmì.&gt;&gt; Nda Isǝwa kángìr, makkì Yakupu bancame mala gulo male mala muna-dǝmba ka.<verse eid="GEN 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 25:34" />Pǝlǝa Yakupu pe Isǝwa npan sǝ ɗarǝî wi mbú mǝsǝ-nkunding. Isǝwa li sǝ nugìr atè, pǝlǝa lo o.</para>
  <para style="p" vid="GEN 25:34">Anggo sǝ Isǝwa ɓǝsǝki gulo male mala muna-dǝmba.<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">Mǝtalabangŋo tsǝki Ishaku bù</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />Nggea nzal-gula kpa aɓa nzali mǝno kǝla kǝ mǝnana kpa a pwarian, a nza mala Ibǝrayim ngga. Nda Ishaku tùro o aban Abimelek, murǝm mala amǝ Filisti, a Gera ka. <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />Mǝtalabangŋo pusǝrǝi aban Ishaku sǝ ne wi ama, &lt;&lt;Kǝa sulǝo aban ká a Masar ɗàng; do a nzali mǝnana mǝ nǝ lǝmdǝo wu do kam ngga. <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />Do akani a mǝnia yì nzali ka zuku, mǝ nda atò, mǝ nǝ tsǝko bù. Anzali mǝnia kat ka, mǝ nǝ po wia, wunǝ amunio andǝ amǝ'keò, sǝ mǝ nǝ lùmsǝ kùrcau mem mǝnana ǝn kánbì tárró Ibǝrayim ngga.<note caller="+" style="f"><char style="fr" closed="false">26:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:2-3">Tite 12:2-3</ref></char>.</note> <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />Mǝ nǝ tsǝa amunio andǝ amǝ'keò nǝ̀ làkkì kǝla anlero a bumkuli, sǝ mǝ nǝ pea wia amǝnia yì anzali ka. Aɓwapǝndǝa mǝnana a ɓanza kat ka, à nǝ̀ kum tsǝkbu mem nǝban amunio andǝ amǝ'keò. <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />Mǝ nǝ pàk mǝnia ka acemǝnana Ibǝrayim kwakikiri arǝàm, sǝ kpata anzongcau, andǝ angguracau, andǝ anê, andǝ akwarkiru mem ngga.&gt;&gt; <verse eid="GEN 26:5" /><verse number="6" style="v" sid="GEN 26:6" />Nda Ishaku akrǝi duk gbal a Gera ka.<verse eid="GEN 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 26:7" />Lang aɓwana mǝnana a ban mǝno ɗice māmí Rabeka abani ka, bang ama mǝ'eambi muna-ɓwama na. Ɓangciu pakki wi arǝ bang ama māmí na acemǝnana pàk ɗenyicau ama, &lt;&lt;Rabeka ka ɓwama nggea mǝɓoarnsari na, sǝ ace mǝno ka, aɓwana mala ban mǝnia nǝ̀ wal-luem ace twal Rabeka.&gt;&gt;<verse eid="GEN 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 26:8" />Anzǝm mana Ishaku dumǝna banì sauna akanó ka, a ɓè fara ka Abimelek Murǝm mala amǝ Filisti pelǝban a mǝsǝkurǝm mala ndà-kulí male, kara sǝni ka, Ishaku na aban pakkiɗire-earban andǝ māmí Rabeka. <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />Nda Abimelek túrban ɓǝà tunǝ Ishaku sǝ ne wi ama, &lt;&lt;Ashe Rabeka ka māmó na! Sǝ palang sǝ a bangga sǝm ama mǝ'eambo na?&gt;&gt;</para>
  <para style="p" vid="GEN 26:9">Ishaku eari wi ama, &lt;&lt;Ɓangciu na pàkkam ama ɓǝ̀n bang nǝma māmám na ka, yakǝla ɓeɓwa nǝ̀ wal-luem ace mǝnana nǝ̀ twali ka.&gt;&gt;<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />Pǝlǝa Abimelek bang ama, &lt;&lt;Mana nda mǝnia yì gìr a pakka sǝm ngga? Ɓǝ́ ɓeɓwa atà aburana mem nongŋǝna nǝi. Sǝ ɓǝ̀ pàngŋǝ̀nà anggo ka, sǝm dumǝna amǝ'cauɓikea mala ɓealɓikea mǝgule.&gt;&gt;<verse eid="GEN 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 26:11" />Pǝlǝa Abimelek pà nzongcau aban aɓwana male kat ama: &lt;&lt;Ɓwa mǝnana je ɓwabura man ko māmí ka, à nǝ̀ wal-luí.&gt;&gt;<verse eid="GEN 26:11" /></para>
  <para style="s">Kúnɓuana amur atūli-mùr</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />Ishaku ɓealɓeale a mǝno yì nzali ka, sǝ àkǝ̀ mǝno yì pǝlǝa ka, kum girlina kǝ̀rkǝ́r acemǝnana Mǝtalabangŋo tsǝkbui amurí. <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />Yì ka kum gǝna, sǝ kume male kǝ lidǝmba nǝ gulo, gandǝa kya duk nggea mǝgǝna kǝ̀rkǝ́r. <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />Ndanǝ adomwan mala andá andǝ adomwan mala anzur andǝ ambul, andǝ aguro pas, gandǝa amǝ Filisti kǝ mwárí. <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />(Amǝ'Filisti ka à yi lúmsǝ́kina atūli-mùr mala Ishaku kat; atūli-mùr mǝnana amǝ'túró-ɓala mala tárrí Ibǝrayim tǝmgia ɗiɗyal a nza male ka. À lúmsǝ́kia kat nǝ nzali.)<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:25-32">Tite 21:25-32</ref></char>.</note><verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />A masǝlǝate ka Abimelek banggi Ishaku ama, &lt;&lt;O nying sǝm. We adyan ngga a kutina sǝm nǝ rǝcandǝa.&gt;&gt;<verse eid="GEN 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 26:17" />Nda Ishaku tùro upi ban mǝno, kya tsǝk là-gumli male a Ɓangŋaban mala Gera, sǝ duk kam. <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />Ishaku nyare busǝlǝki atūli-mùr mǝnana à tǝmgia ɗiɗyal a nza mala tárrí Ibǝrayim ngga, yì atūli-mùr mǝnana amǝ Filisti yi lúmsǝ́kia nǝ nzali anzǝm lú mala Ibǝrayim ngga. Ishaku pè atūli-mùr mǝno àkǝ lullǝu mana tárrí akdǝmba pea wia ɗiɗyal ka.<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />Amǝ'túró-ɓala mala Ishaku tǝm tūli aɓa pǝɗanban, sǝ à kum mùr mǝɓoarnsari kǝ pur kàm. <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />Sǝ ayálgír mala amǝ Gera yiu à yi makgir, sǝ kunia ɓua andǝ ayálgír mala Ishaku ama, &lt;&lt;Tūli-mùr mǝnia ka ma'sǝma!&gt;&gt; Nda Ishaku tsǝki tūli-mùr mǝno ka lullǝu ama Esek<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="fq" closed="false">Esek </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;kúnɓuàna.&gt;&gt;</char></note> acemǝnana kunia ɓua amurí ka. <verse eid="GEN 26:20" /><verse number="21" style="v" sid="GEN 26:21" />Pǝlǝa amǝ'túró-ɓala male o à kya tǝm ɓè tūli-mùr, sǝ mǝno ɗǝm ngga kunia ɓua amurí andǝia. Nda Ishaku tsǝkî tūli-mùrnî lullǝu ama Sitnah.<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="fq" closed="false">Sitnah </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;ɓibura.&gt;&gt;</char></note> <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />Pǝlǝa Ishaku andǝ amǝ ɓala male gǝshì ban mǝno sǝ o a ɓè ban ɗàng, à kya tǝm ɓè tūli-mùr kàm. Kǝ ɓwa makgir amur mǝnia yì tūli-mùr ka ɗàng. Nda Ishaku tsǝki wi lullǝu ama Rehobot.<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="fq" closed="false">Rehobot </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;makrǝu.&gt;&gt;</char></note> Yì ka bang ama, &lt;&lt;Adyan ngga Mǝtalabangŋo pana sǝm ban makrǝu, sǝm nǝ̀ nyakǝti sǝ túró ma'sǝm nǝ̀ kum lidǝmba kàm aɓa nzali mǝnia ka.&gt;&gt;<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />Ishaku loapi ban mǝno tùro o a Biyasheba. <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />A bu du mǝno ka, Mǝtalabangŋo pusǝrǝi abani sǝ bang ama, &lt;&lt;Mǝ nda Ɓakuli mala tárró Ibǝrayim. Ɓangciu ɓǝ̀ kǝa pakko ɗàng, acemǝnana mǝ nda atò. Mǝ nǝ tsǝko bù sǝ mǝ nǝ hatǝki amunio andǝ amǝkeo àtàcau mala guro mem Ibǝrayim.&gt;&gt;<verse eid="GEN 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 26:25" />Ishaku ɓak gyangŋan a ban mǝno, sǝ ɓua aban Mǝtalabangŋo aɓa peri. A ban mǝno ka tsǝk là-gumli male, sǝ amǝ'túró-ɓala male tǝm tūli-mùr.<verse eid="GEN 26:25" /></para>
  <para style="s">Ishaku andǝ Abimelek kùrcau amur do aɓa rǝpwala</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />Aɓa mǝno anggo ka, Abimelek andǝ Ahuzat mǝpà kwarkiru male, andǝ Fiko ɓwamǝgule amur amǝ'lwa male pur a Gera, sǝ à yiu aban Ishaku. <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />Ishaku ɗia ama, &lt;&lt;Ace mana sǝ wu yiu abanam, yì mana ɗiɗyal ka wu ɓinǝmǝsǝàm, wu pakkam mǝɓane, sǝ wu pǝram ɓǝ̀n nying nzali ma'wun ngga?&gt;&gt;<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />À eari wi ama, &lt;&lt;Sǝm sǝni a banfana ama mǝsǝcau ka, Mǝtalabangŋo na atò. Nda sǝm nggǝ earce ama ɓoaro ɓǝ̀ sǝm kángìr sǝm nǝ we, kángìr mala do aɓa rǝpwala a nre rǝarǝ sǝm. Eara sǝm ɓǝ̀ sǝm kùrcau nǝ we amur mǝno, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />ace mǝnana wu kǝa yiu nǝ munǝo arǝ sǝm ɗàng, kǝla mǝnana sǝm ngga sǝm pakko mǝɓane raka. Do mô a ban sǝm ngga sǝm pàkkô cauɓoarna, sǝ sǝm yi tasǝto a o aɓa rǝpwala. Sǝ ado ka Mǝtalabangŋo tsǝ̀ngŋǝ́nò bù.&gt;&gt;<verse eid="GEN 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 26:30" />Pǝlǝa Ishaku tsǝa à pàkki agirlina andǝ agir-nùná ɗàngɗáng acea. À li sǝ à nu atārǝia. <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />Ban fana nǝ tadǝmbari ɗiɗyal ka, aburana man andǝ Ishaku kánbia rǝia gìr ama à nǝ̀ kpata cau mǝnana à bang ama à nǝ̀ pàk ka. Pǝlǝa Ishaku tasǝia ɓǝà o; à bwal njargula à o aɓa rǝpwala.<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />A pwari mǝno ka amǝ'túró-ɓala mala Ishaku yiu à yì banggi wi cau mala bǝsa tūli-mùr mǝnana à mal tǝ̀mé ka, ama à kum mùr kàm. <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />Nda tsǝki wi lullǝu ama Shiba,<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">Shiba </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;kángìr ko tongno-nong ɓari.&gt;&gt; </char></note> sǝ yi pur a yalung ngga lullǝ la mǝno ka, à súrǝì nǝ Biyasheba.<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">Biyasheba </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">tūli-mùr mala kángìr </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">tūli-mùr mala tongno-nong-ɓari. </char></note><note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:25-30">Tite 21:25-30</ref></char>.</note><verse eid="GEN 26:33" /></para>
  <para style="s">Isǝwa alki amamǝna mala amǝ'Kan'ana</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />Lang Isǝwa lùmsǝ̀nà pǝlǝa lumi-ine mala do ɓanza male ka, al amamǝna ɓari amǝ'Hitti, Judit ɓoarnsarile Beri, andǝ Basemat ɓoarnsarile Elon. <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />Amamǝna mǝnia ɓari ka, à yinǝi Ishaku andǝ Rabeka bumkiɗikea kǝ̀rkǝ́r.<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">Yakupu iu tsǝkbu mala Isǝwa arǝì</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />Lang Ishaku ènà sǝ amǝsǝi kǝ sǝnban ɗǝm pepè raka, tunǝ Isǝwa muna-dǝmba male ama, &lt;&lt;Isǝwa.&gt;&gt;</para>
  <para style="p" vid="GEN 27:1">Pǝlǝa Isǝwa ear ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />Ishaku ne wi ama, &lt;&lt;Sǝni, ǝn ènà, sǝ ǝn súrǝ̀ pwari lú mem ɗàng. <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />Ida, twal ntà mò andǝ kpǝliba, kya a bondo kya ɓomɓombo walâm nyama, <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />sǝ wu lambam girlina mǝnana ǝn earkiyi ace raka pé. Yinǝàm nǝi mǝ li, mǝ tsǝko buam, sǝ mǝ wú.&gt;&gt;<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />Cau mǝnana Ishaku na aban ne muni ka, Rabeka na aban oe. Lang Isǝwa umǝna a ɓombo ka, <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />Rabeka pǝlǝa tunǝ muni Yakupu sǝ ne wi ama, &lt;&lt;Ən ok tárró kǝ ne mǝ'eambo Isǝwa ama, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />ɓǝ̀ kya wali wi nyam ɓombo, ɓǝ̀ yi lambi wi girlina mǝɓoarne nǝ̀ li, sǝ nǝ̀ tsǝki wi bù a ɓadǝm Mǝtalabangŋo sǝ ɓǝ̀ wú. <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />Ado ka, we munem, ida kwakikiro arǝàm sǝ wu pak gìr mǝnana ǝn no nǝma wu pak ka. <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />Kya aɓa domwan wu yinǝàm nǝ amuna-mbùl amǝɓoarne ɓari, mǝ nǝ ya lambî tárró girlina mǝnana earkiyice ka. <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />Awu nǝ kánǝí wu kya pe tárró ɓǝ̀ lî, ɓǝ̀ tsǝko bù, sǝ ɓǝ̀ wǔ.&gt;&gt;<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />Yakupu pǝlǝì nggè Rabeka ama, &lt;&lt;A sǝlǝna ama Isǝwa ka nyáng na arǝì, sǝ mim ngga rǝàm na halhal.<note caller="+" style="f"><char style="fr" closed="false">27:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 25:25">Tite 25:25</ref></char>.</note> <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />Ɓǝ̀ tárrám kya je rǝàm ngga mǝ nǝ pàk lang? Nǝ̀ na ama ǝnggǝ earce ɓangginǝi, sǝ a kúnì tsǝkbu ka nǝ̀ suem.&gt;&gt;<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />Pǝlǝa nggè pǝlǝi wi ama, &lt;&lt;Munem, ɓǝ̀ súbanì yiu amuram. We ka pàk gìr mǝnana ǝn no nǝma wu pak ka; kyane kya yinǝàm nǝia.&gt;&gt;<verse eid="GEN 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 27:14" />Nda Yakupu o kya yinǝì nggè nǝ ambulnì. Rabeka yi lam girlina mǝɓoarne mǝnana Ishaku kǝ earce ka. <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />Pǝlǝa Rabeka twal daura mǝɓoarne mala Isǝwa, mǝnana nda a ɓala ka, oasǝì Yakupu muni mǝkyauwe, <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />sǝ gìr abui andǝ myali nǝ nyáng ambulnì. <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />Pǝlǝa pè Yakupu nɗǝmo andǝ mbú mǝɓoarne mǝnana lam ngga.<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />Yakupu twal girlina umnǝi aban tárrí sǝ kya ne wi ama, &lt;&lt;Dàdá.&gt;&gt;</para>
  <para style="p" vid="GEN 27:18">Ishaku eari wi ama, &lt;&lt;Woi, munem, a nda yana ɗê?&gt;&gt;<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />Yakupu eari wi ama, &lt;&lt;Mǝ nda Isǝwa muna-dǝmba mò. Ən pángŋǝ̀nà gìr mǝnana a nam ama ɓǝ̀n pak ka. Nyame ndya ka. Ida, lo dumnǝdo, li girlina sǝ wu tsǝkam bù.&gt;&gt;<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />Ishaku ɗì ama, &lt;&lt;A pak lang sǝ a kaurǝa kum nyame anggo tù, munem?&gt;&gt;</para>
  <para style="p" vid="GEN 27:20">Yakupu pǝlǝi wi ama, &lt;&lt;Mǝtalabangŋo Ɓakuli mò na tsǝa sǝ ǝn kumi tù ka.&gt;&gt;<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />Ishaku pǝlǝa ne Yakupu ama, &lt;&lt;Sung abanam pě mǝ jeo, munem, mǝ sǝlǝa ko mǝsǝcau a nda Isǝwa ko a nda ɗang.&gt;&gt;<verse eid="GEN 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 27:22" />Pǝlǝa Yakupu sungŋo aban tárrí, sǝ Ishaku je rǝì sǝ na ama, &lt;&lt;Giu ka mala Yakupu na, sǝ abú ka à mala Isǝwa na.&gt;&gt; <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />Yì ka ɓwàrki arǝ súrǝ̀ Yakupu, acemǝnana abuí ka à ndanǝ nyáng arǝia kǝla mala Isǝwa. Nda Ishaku gilǝrǝi nǝ̀ tsǝki wi bù, <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />sǝ ɗì ɗǝm ama, &lt;&lt;Mbak-kàngkàng a nda munem Isǝwa le?&gt;&gt;</para>
  <para style="p" vid="GEN 27:24">Isǝwa pè wi eare ama, &lt;&lt;È, mǝ nda.&gt;&gt;<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />Pǝlǝa Ishaku ne wi ama, &lt;&lt;Sungsǝàmi a banam ace mǝnana mǝ li nyam-bondo mala munem mǝ tsǝko bù.&gt;&gt; Nda Yakupu twal girlina pè tárrí lǐ, sǝ pe wi mùr-ɓǝlanggun anap nuì. <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />Ishaku ne muni ama, &lt;&lt;Ida, sung abanam kùram a rǝo, munem.&gt;&gt;<verse eid="GEN 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 27:27" />Yakupu pǝlǝa sungŋo a baní sǝ kùrì arǝì. Lang Ishaku ok rǝm daura rǝì ka, tsǝki wi bu sǝ na ama,</para>
  <para style="q1" vid="GEN 27:27">&lt;&lt;Rǝm munem na kǝla rǝm ɓabondo</para>
  <para style="q2" vid="GEN 27:27">mǝnana Mǝtalabangŋo tsǝ̀ngŋǝ́nì wi bù ka.<verse eid="GEN 27:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="GEN 27:28" />Ɓǝ̀ Ɓakuli pò ncimna nǝ kuli</para>
  <para style="q2" vid="GEN 27:28">andǝ nzali mǝɓoarne mǝnana nǝ pusǝ mǝssa kpǝm</para>
  <para style="q2" vid="GEN 27:28">andǝ mùr-ɓǝlanggun anap ka.<verse eid="GEN 27:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="GEN 27:29" />Aɓwapǝndǝa pas nǝ̀ duk amǝ'túró mô,</para>
  <para style="q2" vid="GEN 27:29">sǝ aɓwapǝndǝa mala nzali nǝ̀ ɓun a ɓadǝmbo.</para>
  <para style="q1" vid="GEN 27:29">Awu nǝ duk ɓwamǝgule amur amǝ'eambo</para>
  <para style="q2" vid="GEN 27:29">sǝ amuna mala nggò nǝ̀ kùndǝó a ɓadǝmbo.</para>
  <para style="q1" vid="GEN 27:29">Aɓwana mǝnana kat à sueo ka, à nǝ̀ suia,</para>
  <para style="q2" vid="GEN 27:29">sǝ aɓwana mǝnana à tsǝko bù ka, à nǝ̀ tsǝkia wia bù.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:3">Tite 12:3</ref>; <ref loc="NUM 24:9">Ɓal 24:9</ref></char>.</note><verse eid="GEN 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />Lang Ishaku mal tsǝki Yakupu bù, sǝ Yakupu puro nǝ̀ nggǝ u ka, nda Isǝwa kǝ nyàrî ɓombo ka. <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />Isǝwa lam girlina mǝɓoarne sǝ twali wari nǝi aban tárrí. Pǝlǝa ne tárrí ama, &lt;&lt;Dàdá, ida lo dumnǝdo lì girlina mem mala nyam-bondo, sǝ wu tsǝkam bù.&gt;&gt;<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />Ishaku ɗì ama, &lt;&lt;A nda yana?&gt;&gt;</para>
  <para style="p" vid="GEN 27:32">Isǝwa pe wi eare ama, &lt;&lt;Mǝ nda muna-dǝmba mò Isǝwa.&gt;&gt;<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />Rǝ Ishaku kútia ɓǝ̀l rang-rang sǝ na ama, &lt;&lt;Yana ɓwe na kya ɓomɓombo yinǝàm nǝ girlina? Ən lina girlinê adyan sǝ a yiu, sǝ ǝn tsǝ́ngŋǝ̀nì wi bu, sǝ yì tsǝkbu ka dumǝna anggo male na.&gt;&gt;<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />Lang Isǝwa ok cau mala tárrí ka, sak zwalo mala ɓua kwanban, ne tárrí ama, &lt;&lt;Dàdá, tsǝkam bù, mim gbal ka tsǝkam bù!&gt;&gt;<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />Tárrí ne wi ama, &lt;&lt;Mǝ'eambo yiu kani yi swarkiam, angŋǝna tsǝkbu mò.&gt;&gt;<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />Isǝwa na ama, &lt;&lt;Ɓà sǝ à pè wi lullǝu ama Yakupu<note caller="+" style="f"><char style="fr" closed="false">27:36 </char><char style="fq" closed="false">Yakupu</char><char style="ft" closed="false">: Lullǝu mǝnia ka à oè nǝ kún Ibǝru kǝla &lt;&lt;ɓǝmbǝri.&gt;&gt; </char></note> ɗàng, ɓǝmbǝrinǎm ado kusǝ ɓari. Angŋǝnàm gulo ɓǝlban mem mala muna-dǝmba, sǝ ado ɗǝm ngga angŋǝnàm tsǝkbu mem!&gt;&gt; Pǝlǝa ɗì tárrí ama, &lt;&lt;Kǝ ɓè tsǝkbu ueo mǝnana awu nǝ tsǝkam ngga re?&gt;&gt;<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />Ishaku ne wi ama, &lt;&lt;Ən angŋa dǝmba ǝn tsǝ́ngŋǝ̀nì ɓǝ̀ do ɓwamǝgule amuro, sǝ ǝn pana amǝ'eambi kat ɓǝà duk aguro male. Ən mǝnǝni wi njar mala hatǝki a kum mǝssa andǝ mùr-ɓǝlanggun anap. Man ɗǝm ado mǝ nǝ pa aceo le, munem?&gt;&gt;<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />Isǝwa lidǝmba nǝ zǝmbi tárrí ama, &lt;&lt;Kǝ ɓè tsǝkbu mwashat pa kàm mǝnana awu nǝ tsǝkam ngga re, Dàdá? Mim gbal ka tsǝkam bù!&gt;&gt; Sǝ Isǝwa loasǝ gì sak ɓua.<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />Ishaku nǝ̀ mǝn kúní ka ne wi ama,</para>
  <para style="q1" vid="GEN 27:39">&lt;&lt;Kwakikiro ǒ .</para>
  <para style="q1" vid="GEN 27:39">Nzali-rya mala bando mò ka</para>
  <para style="q1" vid="GEN 27:39">nǝ̀ duk pǝɗan ban,</para>
  <para style="q2" vid="GEN 27:39">sǝ mbulo pa nǝ̀ nggǝ sulǝ kam ɗàng.<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />Nǝ́ nggeabyau mò sǝ awu nǝ kúmbi ɓamúr rǝò do.</para>
  <para style="q1" vid="GEN 27:40">Awu nǝ dupi mǝ'eambo guro.</para>
  <para style="q1" vid="GEN 27:40">Sǝama ɓǝ̀ a longna a nǝ ak garabuo ka,</para>
  <para style="q2" vid="GEN 27:40">awu nǝ purî ɓatè.&gt;&gt;<verse eid="GEN 27:40" /></para>
  <para style="s">Yakupu ɓangŋa o atà Laban</para>
  <para style="m">
    <verse number="41" style="v" sid="GEN 27:41" />Nda Isǝwa ɓinǝmǝsǝ Yakupu ace gìr mǝnana Yakupu pè, tsǝk tárrià pè wi tsǝkbu mǝnana male yì Isǝwa na ka. Ɓalbure a ɓabumi ama, &lt;&lt;Pwari doatu ace lú mala tár sǝm gbàshìnà; anzǝmi ka, she mǝ nǝ wal-lú mǝ'eambam Yakupu.&gt;&gt; <verse eid="GEN 27:41" /><verse number="42" style="v" sid="GEN 27:42" />Lang ɓè ɓwa yi banggi Rabeka gìr mǝnana muna-dǝmba male Isǝwa shame nǝ̀ pè ka, túrban atà Yakupu yi ne wi ama, &lt;&lt;Mǝ'eambo Isǝwa na kǝ ɓalburio ama nǝ wal-lueó ace gìr mǝnana à pakki wi ka. <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />Ado ka munem, pàk gìr mǝnana ǝn nggǝ banggo ka: Lo ɓangŋa o aban mǝ'eambam Laban a Haran. <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />Kyane duk kanó a banì she ɓǝ̀ bumlulla mala mǝ'eambo pwalǝna ka. <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />Ue kano she ɓǝ̀ bumlulla male sulǝna, sǝ ɓālǝi lorǝna gìr mǝnana a pakki wi ka. Mǝ nǝ túrban atò wu nyare. Ace mana sǝ mǝ nǝ ɗwanyiban wun kǝm a pwari mwashat?&gt;&gt;<verse eid="GEN 27:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />Pǝlǝa Rabeka ne Ishaku ama, &lt;&lt;Banshirìnam, sǝ ǝn aulǝna nǝ amālá Isǝwa amǝ'Hitti mǝnia. Ɓǝ̀ Yakupu nǝ̀ al ɓwama a nzali mǝnia, atà mamǝna mala amǝ'Hitti kǝla amǝnia ka, lú nǝ̀ ɓoarîbanì abanam.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 26:34-35">Tite 26:34-35</ref>; <ref loc="GEN 28:8">28:8</ref></char>.</note><verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />Acemani ka Ishaku tunǝ Yakupu tsǝki wi bù sǝ banggi wi ama, &lt;&lt;Cè a al kǝ ɓwama Kan'ana ɗàng. <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />Lo o a nzali Padan Aram, a ɓala mala keò Betuwel, kya al ɓwama atà amuna-mamǝna mala kìnò Laban. <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />Ɓǝ̀ Ɓakuli Mana Karban Kat nǝ Gulo<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="fq" closed="false">Ɓakuli Mana Karban Kat nǝ Gulo </char><char style="ft" closed="false">ka nda El-Shaddai nǝ kún Ibǝru.</char></note> ka tsǝko bù! Ɓǝ̀ tsǝa wu ɓǝla wu hatǝki, ɓǝ̀ tsǝktàu mò gulo ɓǝ̀ duk aɓwapǝndǝa mǝ'làkke pas. <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />Ɓǝ̀ Ɓakuli tsǝa tsǝkbu mǝnana tsǝki Ibǝrayim ngga ɓǝ̀ sulǝo amuro wunǝ aɓwana mǝnana a tàu mò ka. Ɓǝ̀ nzali mǝnana a nda aɓalǝi ado kǝla bǝri ka ɓǝ̀ duk mò acemǝnana Ɓakuli panì Ibǝrayim nzalinì.&gt;&gt; <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />Nda Ishaku pusǝbǝri Yakupu ɓǝ̀ o, sǝ Yakupu bwal njar aban o a nzali Padan Aram. Wario nǝ̀ nggá do atà kine Laban, muna mala Betuwel ɓwa'Aram sǝ mǝ'eam Rabeka, nggea ka yì Yakupu andǝ Isǝwa.<verse eid="GEN 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />Isǝwa yi sǝlǝ ama, tárrí Ishaku tsǝ̀ngŋǝ́nì Yakupu bù sǝ tasǝnate ɓǝ̀ o a nzali Padan Aram ɓǝ̀ kya al ɓwama kàm, sǝ lang tárrí na rǝ tsǝki Yakupu bù ka, nunkiri ama ɓǝ̀ kǝa al ɓwama Kan'ana ɗàng. <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />Yakupu okî tárrí andǝ ngge sǝ o a nzali Padan Aram. <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />Lang gìrnî yi kpākì Isǝwa ama tárrí andǝ ngge earce amamǝna mala amǝ'Kan'ana raka,<note caller="+" style="f"><char style="fr" closed="false">28:8 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 24:3">Tite 24:3</ref>; <ref loc="GEN 26:34-35">26:34-35</ref>; <ref loc="GEN 27:46">27:46</ref></char>.</note> <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />lo gbal o atà Ishmayel mǝ'eam tárrí kya al ɓè muna-ɓwama mala Ishmayel, yinǝi amur amamǝna mǝnana ndanǝia ɗiɗyal ka. Bǝsa māmí ka lùllǝì nda Mahalat. Yì ka nda mǝ'kyauwa Nebayot ɓè muna-ɓwama mala Ishmayel muna Ibǝrayim.<verse eid="GEN 28:9" /></para>
  <para style="s">Lorǝo mala Yakupu a Betel</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />Yakupu nying Biyasheba bwal njar aban o a Haran.<note caller="+" style="f"><char style="fr" closed="false">28:10 </char><char style="fq" closed="false">Haran </char><char style="ft" closed="false">ngga nggea-là na a nzali Padan Aram.</char></note> <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />Yi bwal ɓè ban nǝ pwarikpǝra sǝ giliki banì nǝ̀ nong nggam. Twal ɓè tali a banì loasǝna múrí nǝi. Pǝlǝa ko a ntulo a banì. <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />Aɓa lòrǝo kara sǝni ka, à loasǝna njar-eauwe, tǝ́rtè lo a nzali sǝ múrí kya bwal kùli. Sǝ sǝni ka, amǝturonjar mala Ɓakuli à kǝ eauwe sǝ à kǝ sulǝo amurí. <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />Nyare sǝni amurí a kùli ka, Mǝtalabangŋo na aban came sǝ na ama, &lt;&lt;Mǝ nda Yahweh Ɓakuli mala keò Ibǝrayim, sǝ Mǝ nda Ɓakuli mala tárró Ishaku. Nzali mǝnana a nong amurí ka, mǝ nǝ po wi wunǝ amǝ'keò. <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />Tàu mò nǝ làkkì kǝla tú nzali. À nǝ̀ mesǝe arǝ abuban ɗàngɗáng, nǝ njar-nzali andǝ njar-takuli, nǝ njar-nza andǝ njar-kunmur. Aɓwapǝndǝa kat a ɓanza nǝ̀ kum tsǝkbu nǝbano sǝ nǝban amunio andǝ amǝ'keò.<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 12:3">Tite 12:3</ref>; <ref loc="GEN 13:14-16">13:14-16</ref>; <ref loc="GEN 17:4-6">17:4-6</ref>; <ref loc="GEN 24:7">24:7</ref></char>.</note> <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />Sǝni, mǝ nda atò, sǝ mǝ nǝ yálo, a koya ban kat a nǝ ká kam ngga, sǝ mǝ nǝ nggá nyesǝo ɗǝm aɓa mǝnia yi nzali ka. Pà mǝ nǝ nyio ɗang she ɓǝ̀n pángŋǝ́nò agir mǝnana kat ǝn no nǝma mǝ nǝ pakko ka.&gt;&gt;<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />Yakupu loapi ntulo sǝ na ama, &lt;&lt;Mǝsǝcau Mǝtalabangŋo na a ban mǝnia sǝ ko ǝn sǝlǝ ɗang!&gt;&gt; <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />Ɓangciu pakki wi gbal sǝ na ama, &lt;&lt;Man yì ban ngga nda ɓiki kàrmúrû ka! Kǝ ban nda man ɗang, ɓala mala Ɓakuli na; nda kǝ bankutio mala ká kùli.&gt;&gt;<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />Ban fanà nǝ ban'mbul-mbul ka Yakupu lo sǝ twal tali mǝnana loasǝna múrí nǝi ka, tamsǝì sǝ pǝlǝa ɗārǝí nǝ mùrú. <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />Tsǝkî banì lullǝu ama Betel,<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="fq" closed="false">Betel </char><char style="ft" closed="false">ka ɓālǝi nda ɓala mala Ɓakuli.</char></note> sǝ ɗiɗyal ka à kǝ tunǝ banì ama Luz.<verse eid="GEN 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 28:20" />Yakupu pǝlǝa pàcau nǝ-shambum aɓadǝm Ɓakuli ama: &lt;&lt;Ɓǝ̀ awu nǝ do atàm, a nǝ yálǎm aɓa mǝnia yì gya ǝn nggǝ twalo, sǝ awu nǝ pàm girlina kunam andǝ agir-nggūrǝu mǝnana mǝ nǝ oasǝo, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />sǝ ɓǝ̀n nyar bǎng a ɓala mala tárrám ngga, Mǝtalabangŋo nǝ̀ duk Ɓakuli mem. <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />Mǝnia yì tali ǝn tamsǝì ka, nǝ̀ duk ɓala mala Ɓakuli, sǝ mǝ nǝ po kāmbe mwashat aɓa lum mala girbunda mǝnana kat awu nǝ pàm ngga.&gt;&gt;<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">Yakupu yi bik ɓala mala Laban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />Yakupu lidǝmba nǝ gya male, yi bwal nzali mala aɓwana mǝnana a takuli ka. <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />Lang loasǝ mǝsǝi ka, kara sǝn tūli-mùr a banfana nǝ domwan tàrú mala anzur aban nongŋo a nkanggari à kǝ kundǝ pàmur. Nggea tali mǝgule gìr kún tūli-mùrnî.<verse eid="GEN 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 29:3" />(A là mǝno ka she ɓǝ̀ adomwan yi ramǝna kat ka, sǝ ayálgír nǝ̀ ramta tali à nǝ̀ pea anzur mùr. Sǝ ɓǝà malǝna ka, à nǝ̀ nyesǝ tali a kún tūli-mùr.)<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />Yakupu wari aban ayálgírnì sǝ ɗia ama, &lt;&lt;Wun amǝ'eambam, wu pur nǝ kǝshe?&gt;&gt;</para>
  <para style="p" vid="GEN 29:4">À eari wi ama, &lt;&lt;Sǝm pur a Haran.&gt;&gt;<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />Pǝlǝa ɗia ama, &lt;&lt;Wu súrǝ̀ Laban mǝ'kà Naho le?&gt;&gt;</para>
  <para style="p" vid="GEN 29:5">À bang ama, &lt;&lt;E, sǝm súrǝì.&gt;&gt;<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />Pǝlǝa Yakupu ɗia ama, &lt;&lt;Nda bǎng le?&gt;&gt;</para>
  <para style="p" vid="GEN 29:6">À pè wi eare ama, &lt;&lt;Nda bǎng. Sǝni, munì Rahila nda mǝno kǝ yiu nǝ anzur male ka.&gt;&gt;<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />Yakupu na ama, &lt;&lt;Wu sǝni, pwari malaká kārǝa à nǝ̀ nyesǝ agirkusǝu a domwan ɗàng. Wu pea wia mùr sǝ wu nyesǝia aban likiagir a bondo.&gt;&gt;<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />À pǝlǝi wi ama, &lt;&lt;Pà sǝm nǝ̀ pak mǝno ka ɗàng she ɓǝ̀ adomwan yina kat ka; sǝ sǝm nǝ̀ gǝ́shí tali sǝm nǝ̀ pè anzur mùr.&gt;&gt;<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />Yakupu naban nacau più sǝ Rahila yi tusǝ nǝ anzur mala tárrí. Yì Rahila ka, nda mǝyál anzur mala tárrí. <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />Lang Yakupu sǝn Rahila, muna mala kine Laban andǝ domwan mala Laban ngga, wario kya gǝ́shí tali mǝnana gìr kún tūli-mùr ka, pè anzur mala kine mùr. <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />Pǝlǝa Yakupu pàkkî Rahila popuro<note caller="+" style="f"><char style="fr" closed="false">29:11 </char><char style="fq" closed="false">pàkkî Rahila popuro </char><char style="ft" closed="false">ko &lt;&lt;yi je Rahila a nkí nǝ mburkuni.&gt;&gt;</char></note> sǝ loasǝ gì aban ɓua ace banɓoarnado. <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />Yakupu banggi Rahila ama, &lt;&lt;Mǝ nda ɓǝla mala tárró, muna mala Rabeka.&gt;&gt;</para>
  <para style="p" vid="GEN 29:12">Rahila pǝlǝa ɓangŋa o kya ne tárrí.<verse eid="GEN 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 29:13" />Sǝ lang Laban ok ama mǝkine Yakupu yina ka, lo nǝ mire nǝ̀ nggá kumi. Mǝn abui kùr Yakupu zǝp, gingsǝi sǝ umnǝi a ɓala. Lang Yakupu bǝlǝni wi kúni kat ka, <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />Laban loasǝ gì na ama, &lt;&lt;Mǝsǝcau, a nda muem andǝ nyamam.&gt;&gt; Nda Yakupu do atà Laban zongŋo mwashat ka.<verse eid="GEN 29:14" /></para>
  <para style="s">Yakupu pàktúró ace Rahila andǝ Liya</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />Laban ne Yakupu ama, &lt;&lt;A pà wunǝ pàkkam túró ɓà acemǝnana a nda ɓǝla mem ngga ɗàng. Banggàm ya tangnakusǝu na a earkice mǝ po?&gt;&gt;<verse eid="GEN 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 29:16" />Laban ngga ndanǝ amuna-mamǝna ɓari; muna mǝgule ka lùllǝì nda Liya, sǝ mǝkyauwe ka lùllǝì nda Rahila <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />Liya ka amǝsǝi ɓoarsǝna<note caller="+" style="f"><char style="fr" closed="false">29:17 </char><char style="ft" closed="false">Cau mǝnia à gilǝì akani nǝ kún Ibǝru ka à bwalte pepè ɗàng.</char></note> sǝ Rahila ka ɓamǝsǝi ɓoarnsari sǝ ndanǝ nggunrǝu mǝnana à nǝ̀ earce ka. <verse eid="GEN 29:17" /><verse number="18" style="v" sid="GEN 29:18" />Yakupu ka kǝ earce Rahila sǝ ne kine ama, &lt;&lt;Mǝ nǝ pàkkô túró mala pǝlǝa tongno-nong ɓari, ɓǝ̀ awu nǝ earâm mǝ al Rahila ka.&gt;&gt;<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />Laban ne Yakupu ama, &lt;&lt;Pò Rahila ka nǝ̀ ɓoaram nǝ̀ kútì mǝnana mǝ nǝ pè ɓeɓwa ka. We ka do atàm pàkkam túró.&gt;&gt; <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />Nda Yakupu pàktúró apǝlǝa tongno-nong-ɓari ace Rahila sǝ yàle sǝni a baní kǝla anongŋo na bǝti ace ulang earban mǝnana ndanǝi ace Rahila ka.<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />A masǝlǝate ka, Yakupu ne Laban ama, &lt;&lt;Apǝlǝa mala túró mem lùmsǝ̀nà. Pam māmám. Ən nggǝ earce nǝma mǝ nǝ kutio a baní.&gt;&gt;<verse eid="GEN 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 29:22" />Pǝlǝa Laban tunǝki aɓwana a cengge ɓǝà yiu ace ligirlina mala isǝban. <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />Sǝ lang ban bwalnà ka, yinǝ Liya yi pe Yakupu, sǝ Yakupu kùtí a baní. <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />(Laban twal muna-ɓwama mǝtúró-ɓala male Zilpa pè Liya ɓǝ̀ duk muna-ɓala male.) <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />Lang banfana ka Yakupu yi sǝni ka, ashe Liya na. Pǝlǝa ɗì Laban ama, &lt;&lt;Mana mǝnia a pakkàm ani ka? Ən pakko túró ace Rahila re? Sǝ palang sǝ a ɓosǝkiam anggo?&gt;&gt;<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />Laban nyesǝi wi ama, &lt;&lt;Kuncau ma'sǝm ear ama muna-ɓwama mǝkyauwe ɓǝ̀ albura amur mǝgule ɗàng. <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />Kúndǝô ɓǝ̀ limo mala pakkiɗire isǝban mǝnia ɓǝ̀ kutio, sǝ sǝm nǝ̀ pò mǝkyauwe gbal, ɓǝ̀ awu nǝ eare awu nǝ pàktúró mala ɓè pǝlǝa tongno-nong-ɓari ɗǝm ngga.&gt;&gt;<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />Yakupu pǝlǝa eare pè kǝla mǝnana Laban bang ngga. Limo mwashat anzǝm pakkiɗire isǝban mala Liya ka, Laban pè wi Rahila ɓǝ̀ duk māmí gbal. <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />(Laban pè Rahila guro male Bilha ɓǝ̀ duk muna-ɓala male.) <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />Yakupu kùtí aban Rahila gbal, sǝ earce Rahila kútì mǝnana earce Liya ka, pǝlǝa do pakki Laban túró mala ɓè pǝlǝa tongno-nong-ɓari ɗǝm.<verse eid="GEN 29:30" /></para>
  <para style="s">Amuna mǝnana Yakupu ɓǝl ka</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />Lang Mǝtalabangŋo sǝni Liya ka à eàrì pepè raka, pǝlǝa pè wi ɓǝlmuna sǝ mala Rahila ka, duk nkombi. <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />Liya kum muna a bumi sǝ ɓǝl muna-ɓwabura, sǝ pe wi lullǝu ama Ruben.<note caller="+" style="f"><char style="fr" closed="false">29:32 </char><char style="fq" closed="false">Ruben </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;sǝna tanni mem.&gt;&gt;</char></note> Pǝlǝa bang ama, &lt;&lt;Mǝtalabangŋo sǝna tanni mem, ado ka burém nǝ̀ earám.&gt;&gt;<verse eid="GEN 29:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 29:33" />Nyare kum muna a bumi ɗǝm, ɓǝl ɓè muna-ɓwabura, sǝ pè wi lullǝu ama Shimiyon.<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="fq" closed="false">Shimiyon </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;Ongŋǝna.&gt;&gt;</char></note> Pǝlǝa bang ama, &lt;&lt;Mǝtalabangŋo pam mǝnia yi muna acemǝnana yi ok ama à eàrám ɗang.&gt;&gt;<verse eid="GEN 29:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 29:34" />Nyar ɗǝm kum muna a bumi, ɓǝl ɓè muna-ɓwabura, pè wi lullǝu ama Lawi.<note caller="+" style="f"><char style="fr" closed="false">29:34 </char><char style="fq" closed="false">Lawi </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Lanzǝ arǝ.&gt;&gt;</char></note> Pǝlǝa bang ama, &lt;&lt;Ado ka burém nǝ̀ tà arǝàm, acemǝnana ǝn ɓǝlǝni wi amuna-burana tàrú.&gt;&gt;<verse eid="GEN 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 29:35" />Nyar ɗǝm kum muna a bumi ɓǝl ɓè muna-ɓwabura sǝ pe wi lullǝu ama, Yahuda.<note caller="+" style="f"><char style="fr" closed="false">29:35 </char><char style="fq" closed="false">Yahuda </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓwangsǝban.&gt;&gt;</char></note> Pǝlǝa bang ama, &lt;&lt;Ado ka mǝ nǝ ɓwangsǝ Mǝtalabangŋo.&gt;&gt; Sǝ ɓǝlmuna kasǝi wi.<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />Lang Rahila sǝni pà nǝ̀ gandǝ ɓǝlî Yakupu muna raka, kara mɓali pakki wi arǝ mǝgule muna-ɓwama. Pǝlǝa zǝmbi Yakupu ama, &lt;&lt;Pam amuna, ɓǝ̀ ana raka mǝ nǝ wú!&gt;&gt;<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />Kara bum Yakupu lul kǝ̀rkǝ́r arǝ Rahila, sǝ ɗì ama, &lt;&lt;Mǝ nda Ɓakuli le? Yì nda ɓwa mǝnana po ɓǝlmuna raka!&gt;&gt;<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />Pǝlǝa Rahila banggi wi ama, &lt;&lt;Twal mǝtúró-ɓala mem, Bilha, pàk-ɓwama nǝi. Yì ka nǝ̀ ɓǝlâm amuna, sǝ nǝbaní sǝ mǝ nǝ kum mem gbal yìa amǝɓala.&gt;&gt;<verse eid="GEN 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 30:4" />Nda Rahila pè Yakupu mǝtúró-ɓala male, yì Bilha, ɓǝ̀ duk māmí, pǝlǝa pàngŋǝ̀nà-ɓwama nǝi. <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />Bilha kum muna a bumi, ɓǝ̀lî Yakupu muna-ɓwabura. <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />Rahila bang ama, &lt;&lt;Ɓakuli angŋamuram! Ongŋǝna ɓua mem, nda pam muna-ɓwabura ka.&gt;&gt; Acemani ka tsǝki munê lullǝu ama Dan.<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="fq" closed="false">Dan </char><char style="ft" closed="false">ngga ɓālǝi nda</char><char style="fqa" closed="false">angŋa muram. </char></note><verse eid="GEN 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 30:7" />Nyare Bilha kum muna a bumi, ɓǝ̀lî Yakupu ɓè muna-ɓwabura. <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />Pǝlǝa Rahila bang ama, &lt;&lt;Ən warǝ̀nà wara kǝ̀rkǝ́r mala Ɓakuli sǝnǝ mǝ'eambam muna-ɓwama, sǝ ndo ǝn nggǝ limurǝm amurí ka!&gt;&gt; Acemani ka tsǝki muna lullǝu ama Naftali.<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="fq" closed="false">Naftali </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">wara mem. </char></note><verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />Lang Liya sǝni kǝ kum muna a bumi ɗǝm raka, twal muna-ɓala male, yì Zilpa, pè Yakupu ɓǝ̀ duk māmí. <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />Zilpa, muna-ɓala mala Liya ɓǝ̀lî Yakupu muna-ɓwabura. <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />Liya pǝlǝa bang ama, &lt;&lt;Ən kumǝna múrɓoarna!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">&lt;&lt;Nggǝsan amǝ'lwa ndya à kǝ yiu ka!&gt;&gt;</char></note> Nda tsǝki wi lullǝu ama, Gad.<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="fq" closed="false">Gad </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">múrɓoarna. </char></note><verse eid="GEN 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 30:12" />Nyare Zilpa ɓǝ̀lî Yakupu ɓaria muna-ɓwabura. <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />Pǝlǝa Liya bang ama, &lt;&lt;Ən kumǝna bumpwasǝa kǝ̀rkǝ́r! Adyan ngga acili amamǝna nǝ̀ pàk bumpwasǝa atàm.&gt;&gt; Nda tsǝki muna lullǝu ama, Asha.<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fq" closed="false">Asha </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">bumpwasǝa. </char></note><verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />A ɓè pwari, nǝ kún cangi amǝsa, Ruben wari a ɓabondo sǝ kum dude,<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="fq" closed="false">dude: </char><char style="ft" closed="false">girpwala mana amamǝna kǝ shak nlerǝtè ace mǝnana ɓǝ̀ bwalia wia kàm ɓǝà kum muna-bum ngga.</char></note> pǝlǝa uí sǝ yinǝì nggè Liya wi. Rahila zǝmbî Liya ama, &lt;&lt;Ida, pam bǝti aɓa dude mana munio yinǝo wi ka.&gt;&gt;<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />Sǝ Liya ka nyesǝi wi cau ama, &lt;&lt;Karǝma re, yi mǝnana a ak burém arǝàm ngga? Ado ka awu nǝ nyar ɗǝm a nǝ ak dude mana munem yinǝi ka le?&gt;&gt;</para>
  <para style="p" vid="GEN 30:15">Rahila ama, &lt;&lt;Pam dude bǝti mana munio yinǝo wi ka, sǝ Yakupu ka, ɓǝ̀ nongnǝ we a dù man yalung ngga.&gt;&gt;<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />Lang Yakupu naban nyàrî ɓabondo nǝ pwarikpana mǝno ka, Liya lo wari a kuliè, sǝ banggi wi ama, &lt;&lt;A bù dù man yalung ngga a nǝ yiu, awu nǝ nong atàm, acemǝnana ǝn angŋa dǝmba ǝn mbwena aceo nǝ dude mǝnana munem yinǝi ka.&gt;&gt; Nda sǝ Yakupu nongnǝ Liya a bù mǝno yi dù ka. <verse eid="GEN 30:16" /><verse number="17" style="v" sid="GEN 30:17" />Ɓakuli ok hiwi mala Liya; kum muna a bumi ɗǝm sǝ ɓǝlî Yakupu tongnoia muna-ɓwabura. <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />Pǝlǝa Liya bang ama, &lt;&lt;Ɓakuli panam tangnakusǝam acemǝnana ǝn pe burém muna-ɓala mem ɓǝ̀ duk māmí ka.&gt;&gt; Nda tsǝki muna lullǝu ama Isaka.<note caller="+" style="f"><char style="fr" closed="false">30:18 </char><char style="fq" closed="false">Isaka </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">tangnakusǝu. </char></note><verse eid="GEN 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 30:19" />Liya nyare kum muna a bumi ɗǝm, ɓǝlî Yakupu tongno-nong-mwashatia muna-ɓwabura. <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />Liya pǝlǝa bang ama, &lt;&lt;Ɓakuli panam ɓoro mǝɓoarne. Adyan ngga burém nǝ̀ nggǝ pakkam gìr nǝ gusǝlǝban, acemǝnana ǝn pani wi amuna-burana tongno-nong-mwashat.&gt;&gt; Nda tsǝki muna lullǝu ama, Zebulu.<note caller="+" style="f"><char style="fr" closed="false">30:20 </char><char style="fq" closed="false">Zebulu </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">gusǝlǝban. </char></note><verse eid="GEN 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 30:21" />Nǝnzǝ́mò ka Liya yi ɓǝl muna-ɓwama, sǝ tsǝki wi lullǝu ama, Dina.<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />Pǝlǝa Ɓakuli ɗenyinǝ Rahila. Ok ɓua male, sǝ pe wi ɓwamuru mala ɓǝl amuna. <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />Muna kpa a bumi, ɓǝl muna-ɓwabura sǝ bang ama, &lt;&lt;Ɓakuli pusǝ̀nam a kǝsǝkya mala do nkombi. <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />Ɓǝ̀ Mǝtalabangŋo kārǝàm ɓè muna-ɓwabura a ɓala mem.&gt;&gt; Pǝlǝa tsǝki muna lullǝu ama, Yisǝfu.<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="fq" closed="false">Yisǝfu </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">ɓǝ̀ kārǝàm ɓè.</char></note><verse eid="GEN 30:24" /></para>
  <para style="s">Gǝna mala Yakupu gamsǝa</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />Banì sau ɗang, anzǝm mǝnana Rahila ɓǝlna Yisǝfu ka, Yakupu banggi Laban ama, &lt;&lt;Nyem ɓǝ̀ ǝn o a là, a nzali mem. <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />Pàm amāmám andǝ amunèm, mǝnana ǝn pakko túró acea ka, sǝ wu ɗekiam mǝ bwal njar mǝ o. Ko nggearǝ we nǝ ɓamurò ka, a súrǝ́nà rǝ túró mǝcandǝe mǝnana ǝn pakko ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">30:26 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 29:18">Tite 29:18</ref>,<ref loc="GEN 29:20">20</ref>,<ref loc="GEN 29:27">27</ref>; <ref loc="HOS 12:12">Hos 12:12</ref></char>.</note><verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />Sǝ Laban ngga pè wi eare ama, &lt;&lt;Ida, ɓǝ̀ bumo pwasǝo arǝàm ngga, duk a kani, acemǝnana Mim ngga aɓa sǝnsǝna sǝ ǝn yi sǝlǝa ama Mǝtalabangŋo tsǝkam buì, àtàcau mò. <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />Banggam, mana nda tangnakusǝo; gìr mǝnana kat a earce ka mǝ nǝ mbweo.&gt;&gt;<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />Yakupu pà eare ama, &lt;&lt;A sǝlǝna rǝ cê túró mǝcandǝe mǝnana ǝn pakko ka, sǝ a sǝlǝna ama adomwan mala agirkusǝu mô ka mǝ nda ǝn ɗenyi nǝia ka. A buàm sǝ à hatǝki. <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />Kaniama mǝ yiu a bano ka, agirkusǝu mô ka à nda bǝti, à làkkì ɗàng. Sǝ adyan, nǝ yiu mem ngga, gǝna andǝ kume mò gulna kpǝm. Mǝtalabangŋo tsǝ̀ngŋǝ́nò bù nǝ túró mǝnana kat ǝn pê ka. Sǝ ado ka, nǝ̀ ká aya pwari sǝ mǝ nǝ tita pàk gìr mala buam ace gulo mala ɓala mem gbal?&gt;&gt;<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />Laban ɗì ɗǝm ama, &lt;&lt;Shen sǝ a earce mǝ mbweo?&gt;&gt;</para>
  <para style="p" vid="GEN 30:31">Yakupu pè wi eare ama, &lt;&lt;Kǝa pam kǝgìr ɗàng. Gìr mwashat nda mǝnana awu nǝ pàkkam, sǝ mǝ nǝ lidǝmba nǝ ɗenyinǝ agirkusǝu mô ka. <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />Came ɓǝ̀n pelǝki agirkusǝu arǝ adomwan mò yalung, ɓǝ̀n pusǝ koya nzur mǝnana ndanǝ abân mǝpǝndǝe arǝì, andǝ koya nzur mǝpǝndǝe aɓalǝ amuna-nzur, andǝ koya mbulpǝndǝa mǝnana ndanǝ aban mǝpwasǝe arǝì, ko amǝnana mùr rǝià na ɗàng-ɗáng ngga. Amǝnia ka à nda ka mǝnana awu nǝ pam mia, amala mbweban mem ngga. <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />A dǝmba ka, ɓǝ̀ a yi sǝngi agirkusǝu mǝnana a pam mala mbweban ngga, a nǝ sǝlǝa ama ǝn tǝpǝrio ɗang. Sǝ ɓǝ̀ a kum aɓa domwan mem ambul-pǝndǝa mǝnana à pànǝ ban mǝpwasǝke arǝia, ko ana raka, anzur mǝnana amǝpǝndǝe na raka, anggo sǝ awu nǝ sǝlǝa ama ǝn iuwia arǝò.&gt;&gt;<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />Laban nyesǝi wi cau ama, &lt;&lt;E, ǝn earna ɓǝ̀ do anggo, kǝla mana a bang ngga.&gt;&gt; <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />Sǝama nǝ kǝ pwari mǝno ka, Laban wario kya pusǝki ambul-pǝndǝa kat, ajamne andǝ amǝ'nggaule mǝnana à ndanǝ abân mǝpwasǝe arǝia, sǝ pusǝki anzur mǝnana amǝpǝndǝe na ka, nyesǝia a bu amuna-burana male ɓǝà ɗenyi nǝia. <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />Pǝlǝa twal gya mala anongŋo tàrú nǝ adomwan man upi ban mǝnana Yakupu duk kam ngga. Kat andǝ amǝno ka, Yakupu lidǝmba nǝ ɗenyinǝ cili agirkusǝu mala Laban.<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />Yakupu pǝlǝa wario kya kasǝki agara mǝpwale mala nggun libǝne, andǝ mala nggun lus, andǝ mala nggun armon, sǝ komǝye ka fasǝki nggwate arǝ aɓea ban arǝì ɓǝ̀ lǝmdǝ abân mǝpwasǝe. <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />Pǝlǝa tsǝkia a ban ankenye-mùr mala agirkusǝu, ace mǝnana amunagara ka ɓǝà pa a ɓadǝmbǝ agirkusǝu ɓǝà nǝ̀ yiu a nu mur ka. Pè anggo acemǝnana agirkusǝu ka à kǝ eau rǝia ɓǝà yiu a nu mur ka. <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />Lang agirkusǝu eau rǝia a ɓadǝmbǝ amunagara mǝno à fasǝkia a lǝmdǝ abân mǝpwasǝe andǝ mǝpǝndǝe arǝia ka, à ɓǝl amunia mana à ndanǝ abân mǝpwasǝe andǝ mǝpǝndǝe arǝia ka.<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />Yakupu pusǝ amǝno yì amuna-nzur ka ɓǝà cam ɗàng, sǝ ɓǝà kǝa pà aɓa domwan mala Laban ɗàng. Ɓǝ̀ agirkusǝu nǝ̀ eau'eawe ka, Yakupu tsǝk anzur male mǝno ɓǝà sǝn ɓamǝsǝa rǝia andǝ agirkusǝu mǝnana a domwan mala Laban, amana à ndanǝ abân mǝpǝndǝe andǝ aban mǝpwasǝe arǝia ka. Anggo sǝ Yakupu kum male yì domwan, sǝ eare kpapia andǝ agirkusǝu mala Laban ɗàng.<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />Ɓǝ̀ bàkú eau'eawe mala agirkusǝu amǝ'rǝcandǝe karǝ ka, Yakupu nǝ̀ nongsǝ agara mǝno fasǝki rǝia ka a ɓadǝmbia aɓalǝ ankenye-mùr malea, ace mǝnana ɓǝà eau rǝia a ban agare ka.<verse eid="GEN 30:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 30:42" />Sǝ ɓǝ̀ agirkusǝu mǝnana à pànǝ rǝcandǝa raka à nǝ̀ eau rǝia ka, kǝ pak mǝno ka ɗàng. Aɓa pě anggo ka agirkusǝu mǝnana à pànǝ rǝcandǝa raka, à nda ka mala Laban, sǝ amǝ'rǝcandǝe ka à nda ka mala Yakupu.<verse eid="GEN 30:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 30:43" />Anggo sǝ Yakupu pǝlǝ mǝkume kǝ̀rkǝ́r. Yi dum nǝ adomwan mala agirkusǝu kpǝm, andǝ amǝ'túró-ɓala aburana andǝ amamǝna, andǝ akalakadambi andǝ andambǝritso.<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">Yakupu ɓangŋa o nying ban Laban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />Yakupu ok ama amuna mala Laban ngga à nda ban bang ama, &lt;&lt;Yakupu pwana gìr mǝnana kat tár sǝm ndanǝi ka. Gǝna male kat ka kumi aɓa gìr mǝnana mala tár sǝm na ka.&gt;&gt; <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />Sǝ Yakupu sǝni ɗǝm ngga ɓamǝsǝ Laban panzǝ arǝì kǝla mǝnana kǝ pak ɗiɗyal ka ɗàng.<verse eid="GEN 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 31:3" />Pǝlǝa Mǝtalabangŋo banggi Yakupu ama, &lt;&lt;Lo, nyare o a nzali la mala tárró, nzali mala akeo, andǝ mala aɓǝla mò, sǝ mim ngga mǝ pà atò.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 28:15">Tite 28:15</ref>; <ref loc="GEN 32:10">32:10</ref></char>.</note><verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />Nda Yakupu túrban atà Rahila andǝ Liya ɓǝà yiu ɓǝà yì kumi a ɓabondo a ban mǝnana kǝ yál domwan mala ambul male kàm ngga. <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />Banggia wia ama, &lt;&lt;Ən sǝni ka tár wun kǝ twalam ɗǝm nǝ earmúrú kǝla mana ɗiɗyal ka ɗàng. Sǝama, Ɓakuli mala tárrám ngga nda atàm. <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />Wun kǝm ngga wu sǝlǝna rǝ ulang túró mǝkǝ̀rkǝ́rnì mǝnana ǝn pakki tár wun nǝ rǝcandǝa mem kat ka. <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />Kat andǝ amani ka, ɓǝmbǝriam, nggaɗi mbweban mem kusǝ lum. Sǝama Ɓakuli eari wi pàkkam kǝgìr mǝɓane ɗàng. <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />Ɓǝ̀ bang ama, &lt;Ambul mǝnana rǝia pwasǝ ka à nǝ̀ duk mbweban mò&gt; ka, kara domwan kat ka à ɓǝl amuna amǝ rǝpwasǝke. Sǝ ɓǝ̀ nggaɗi bumi sǝ bang ama, &lt;Ambul mǝnana amǝ rǝ'nyoulǝke nda mǝ nǝ po à nǝ̀ duk mbweban mò&gt; ka, kara domwan kat ka à ɓǝl amuna mǝnana amǝ rǝ'nyoulǝke na ka.&gt;&gt; <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />Anggo sǝ Ɓakuli fwa agirkusǝu mala tár wun sǝ pam mia.<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />&lt;&lt;A ɓè pwari, nǝ kún eau'eawe mala agirkusǝu, aɓa lòrǝo ǝn loasǝ mǝsǝam sǝ ǝn sǝni ka, agbato mǝnana à kǝ eau amǝ'nggaulea a domwan ngga, à nda ka mǝnana rǝia nyoulǝkya, andǝ amǝnana rǝia dok-dok, andǝ amǝnana rǝia mbulet-mbulet ka. <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />Mǝturonjar mala Ɓakuli tunǝam aɓa mǝno yì lòrǝo ka ama, &lt;Yakupu!&gt; Sǝ ǝn eare nǝma, &lt;Uong! Mǝ ndya ka.&gt; <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />Pǝlǝa banggàm ama, &lt;Loasǝ mǝsǝo, sǝni, agbato mǝnana à kǝ eau amǝ'nggaulea a domwan ngga amǝnana rǝia nyoulǝkya, andǝ amǝnana rǝia dok-dok, andǝ amǝnana rǝia mbulet-mbulet ka à nda. Mǝ nda ban pak mǝnia ka ɓǝ̀ pa anggo acemǝnana ǝn sǝnǝna cè gìr mǝnana Laban kǝ pakko ka. <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />Mǝ nda Ɓakuli mǝnana ǝn pusǝ rǝàm a bano a Betel, ban mǝnana a kwaki nggea tali sǝ a ɗārǝí nǝ mùrú, sǝ a pàcau nǝ-shambum abanam ngga. Adyan ngga, lo purî nzali mǝnia ka, nyare a nzali mô mǝnana à ɓǝ̀lo kam ngga.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">31:13 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 28:18-19">Tite 28:18-19</ref></char>.</note><verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />Rahila andǝ Liya pè Yakupu eare ama, &lt;&lt;Ɓè kǝ kāmbe ko liɓala ueka sǝm a ɓala mala tár sǝm le? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />Yàle yì ka kǝ pangnǝ sǝm kǝla sǝm nda ka amǝ'kúnɗàngna. Mak sǝm, sǝ gǝna mǝnana à pe wi amur sǝm ngga, kara lìnì arǝ sǝm. <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />Kume mǝnia mǝnana kat Ɓakuli fwê a bu tár sǝm ngga, ma'sǝma sǝnǝ amuna ma'sǝm. Acemani ka, lidǝmba pàk gìr mǝnana kat Ɓakuli banggo ama wu pe ka.&gt;&gt;<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />Nda Yakupu eamsǝ amāmí andǝ amuni anzǝm akalakadambi ka. <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />Pwan agirkusǝu male kat andǝ agirkuma male mǝnana ramba a Padan Aram ngga. Pǝlǝa bwal njar aban o a nzali Kan'ana, nǝ̀ nyar aban tárrí Ishaku. <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />Aɓa mǝno anggo ka Laban pà a là ɗàng. Umǝna a ban mǝnana à kǝ mwaki wi nyang anzur male ka, sǝ a nzǝmi ka Rahila iu aɓǝ̀nzál mala amǝɓala mala tárrí. Pwania umnǝia a bui. <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />Yakupu ɓosǝki Laban ɓwa'Aram, eare ɓǝ̀ sǝlǝa ama kǝ umnǝ o ɗang. <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />Yakupu pwan agirkuma male kat sǝ bwal njar aban o akaurǝa. Wario kya yàllî Nggeasala Yiufǝretis, pǝlǝa tsǝkmuri aban o a Gilǝyat, nzali múr ankono.<verse eid="GEN 31:21" /></para>
  <para style="s">Laban ɓangŋa ta Yakupu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />Anzǝm nongŋo tàrú ka, à banggi Laban ama Yakupu andǝ amǝɓala male ɓangŋǝna, à umǝna. <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />Nda pwan aburana male atè sǝ à lo ɓangŋa ta Yakupu. Twalia nongŋo tongno-nong ɓari sǝ à yi bwalte amúr ankono mala nzali Gilǝyat. <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />A bù dù mǝno ka, Ɓakuli pusǝrǝi aban Laban ɓwa'Aram aɓa lòrǝo, banggi wi ama, &lt;&lt;Nggǝ nunkiro, kǝa na ama awu nǝ ne Yakupu kǝ cau, ko mǝɓoarne ko mǝɓane ɗàng.&gt;&gt;<verse eid="GEN 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 31:25" />Yakupu ka angŋa dǝmba à tsǝkina agumli malea amur ɓè nkono sǝ Laban yi kasǝmúrí. Sǝ yì Laban gbal andǝ aɓwana male ka, à yi tsǝkia malea yì agumli tù aban agumli do mala Yakupu akanó amur nkono a nzali Gilǝyat.<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />Laban pǝlǝa ɗì Yakupu ama, &lt;&lt;Mana mǝnana a pak anggo ka? A ɓosǝkiam, a pwan amuna-mamǝna mem a ɓangŋa a umnǝia kǝla aguro mana à bwalia a kún lwa ka. <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />Palang sǝ a pakkam kutan, a swárô a o aɓa sǝmbǝrǝa? Palang sǝ a ɓinǝ banggàm ama a ndo a nǝ o, sǝ anggo ka ɓǝ́ mǝ nǝ tsǝkto nǝ banɓoarnado mala li girlina pakkiɗire, andǝ nggyal, andǝ nggwam mǝnana àkǝ te nǝ walki aɓǝm, andǝ azangŋan ngga? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />A earam mǝ bwal amunem andǝ amǝ'kem mǝ kùria arǝàm mǝ tsǝiandà ɗàng. We ka, a pángŋǝ̀nà ɓwaɓana! <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />Mǝ ndanǝ rǝcandǝa mala pàkkô mǝɓane, sǝama, Ɓakuli mala tárró lǝmdǝ rǝi abanam nǝ bu du mana kútí ka, aban nunkiram ama mǝ kǝa nô kǝcau, ko mǝɓoarne ko mǝɓane ɗàng. <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />Ən sǝlǝna nǝma a o acemǝnana ɓabumo kǝ pi arǝ earce nyare a ɓala mala tárró. Sǝ ace mana sǝ a iu aɓǝ̀nzál mem?&gt;&gt;<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />Yakupu pe Laban eare ama, &lt;&lt;Ən o aɓa sǝmbǝrǝa acemǝnana ɓangciu pakkam. Ən twali nǝma a nǝ ak amuna-mamǝna mô arǝàm nǝ rǝcandǝa. <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />Sǝ cau mala aɓǝ̀nzál mô ka, ɓwa mǝnana kat a kumi nǝ agirnì a bui ka, à nǝ̀ wal-luí. A ɓadǝm aɓǝla ma'sǝm akani, sǝngiaban nǝ nggearǝo ko awu nǝ kum ɓè kǝgir mǝnana mò na ka; sǝ ɓǝ̀ a kum ngga, twali.&gt;&gt; Sǝ Yakupu ka sǝlǝ ama, Rahila iuna amǝno yì aɓǝ̀nzál mala tárrí Laban ngga ɗàng.<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />Pǝlǝa Laban kùtí altaban aɓa gumli mala Yakupu, andǝ ɓá gumli mala Liya, andǝ mala amuna-mamǝna amǝ'túró-ɓala malea, sǝ ko kum kǝgìr ɗàng. A masǝlǝate ka, yi kútí aɓa gumli mala Rahila. <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />Yì Rahila ka angŋa dǝmba twalna aɓǝ̀nzálnì oasǝnia aɓa luru gyare arǝ buno-nzǝm kalakadambi sǝ nda aban do amúrià. Laban alta ban aɓa gumli kat, sǝ ko kum kǝgìr ɗàng.<verse eid="GEN 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 31:35" />Rahila banggi tárrí ama, &lt;&lt;Dâ, ida bumo ɓǝ̀ kǝa lúllô arǝàm acemǝnana ǝn gandǝ lo ǝn cam nǝ came a ɓadǝmbo ǝn po gulo raka; mǝ nda aɓa bumkwana mem.&gt;&gt; Anggo sǝ Laban lidǝmba nǝ altaban sǝ kum amǝno yì aɓǝ̀nzál ka ɗàng.<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />Kara Yakupu pàk bumlulla, munǝki arǝ Laban ama, &lt;&lt;Ya gìr mǝɓane na mǝnana ǝn pak ka? Ya cauɓikea na mǝnana ǝn pa, sǝ a lo atam ngga? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />Ado mǝno a sǝnginaban aɓalǝ agir mem kat ka, ya gìr ɓala mò na a kumô? Tsǝk gìrnî kani a ɓadǝm aɓwana mô andǝ amem, sǝ yia ka ɓǝà gau cau, ɓǝà kasǝ cè mǝnana a nre sǝm ngga.<verse eid="GEN 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 31:38" />&lt;&lt;Ən dumǝna sǝnǝ we bwalna pǝlǝa lumi-ɓari adyan. Atà anzur andǝ ambul-pǝndǝa mô ka, kǝ ɓè sulǝmuna ɗang, sǝ yàle ǝn shak ma atà agam a domwan mò ɗàng. <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />Pwari mana kat nyamɓikea wal mwashat atà agirkusǝu mò, ko bwali san ɓè bare ka, ǝn yiu ma nǝi a bano ǝn lǝmdǝo ɗàng. Ən twal mǝno yì ɗwanyi ka amuram. Ɓǝ̀ aya pwari sǝ à iu mwashat atà agirkusǝu mô, ko nǝ du ko nǝ pwari ka, a ɗice mǝ mbwe nǝ ɓe a kúnì aɓalǝ agirkusǝu mem. <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />Ən camarǝ pakko túró nǝ tanni aɓa banpina nǝ pwari zǝkya, aɓa ɗwal andǝ ɗwanyi nong'ntullo nǝ du. <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />E, apǝlǝa lumi-ɓari ǝn pak túró guro a ɓala mò. Ən pak túró mala apǝlǝa lum-nong-ine ace al amuna-mamǝna mô ɓari, sǝ apǝlǝa tongno-nong mwashat ace kum anzur andǝ ambul-pǝndǝa mǝnia a pam a domwan mò ɓǝà do nda mbweban mem ngga. Aɓalǝ apǝlǝa mǝno mǝ nda aban pakko túró ka, a camarǝ nggaɗiki mbweban mem kusǝ lum!<note caller="+" style="f"><char style="fr" closed="false">31:41 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 29:27">Tite 29:27</ref>,<ref loc="GEN 29:30">30</ref></char>.</note> <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />Ɓǝ̀ pà ama Ɓakuli mala kèm Ibǝrayim, yì Ɓakuli mana tárrám Ishaku kǝ ɓanggi wi ka, pang ma atàm raka, ɓǝ́ a tasǝnatam nǝ ɓabuam atàrǝì. Sǝama Ɓakuli sǝnǝna tanni mem andǝ túró mǝnana ǝn pe nǝ buam ngga. Nda gìr mǝnana tsǝa nǝ bu du mana yilung ngga Ɓakuli pak ɓashi male, nunkiro ka.&gt;&gt;<verse eid="GEN 31:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />Laban pǝlǝa pè wi eare ama, &lt;&lt;Amamǝna mǝnia ka amunem na, sǝ amuna ka amǝ'kem na, sǝ adomwan mala agirkusǝu gbal ka, amem na. Yàle agir mǝnana kat a sǝnia kani ka, amem na. Sǝ mana girni mǝ nǝ gandǝ pa ace amunem andǝ amunia mǝnana à ɓǝlki ka? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />Yiu ɓǝ̀ sǝm kùrcau, mim sǝ we. Mǝnia ka nǝ̀ lǝmdǝ ama eare nakam a nre sǝm.&gt;&gt;<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />Nda Yakupu twal tali kwákítè ɓǝ̀ cam nǝ came a nzali ɓǝ̀ duk tali-kwakya.<note caller="+" style="f"><char style="fr" closed="false">31:45 </char><char style="fq" closed="false">tali-kwakya </char><char style="ft" closed="false">ko gìr ɗenyi.</char></note> <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />Sǝ banggi aɓwana male, amǝɓala male, ama, &lt;&lt;Wu pwangi amuna-tali, wu ramgia.&gt;&gt; Pǝlǝa à ramgi atali, à eamsǝia amur rǝarǝia. Pǝlǝa Yakupu andǝ Laban dumnǝdo a ban atali mǝnana a eamsǝia amur rǝarǝia ka, sǝ à li girlina atārǝia. <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />Laban tunǝ banì ama, Jegar-Sahaduta, sǝ Yakupu ka tunǝi ama, Galiyet.<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft" closed="false">Jegar-Sahaduta ka kún Aramayik na, sǝ Galiyet ka kún Ibǝru na. Alullǝu mǝnia yia kǝm ngga ɓālǝi nda &lt;&lt;gwali mala atali nakún.&gt;&gt;</char></note><verse eid="GEN 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="GEN 31:48" />Pǝlǝa Laban ham ama, &lt;&lt;Mǝnia yì atali à rambia ka, à nǝ̀ duk gir nakún mala kùrcau ma'sǝm yalung.&gt;&gt; Nda gìr mǝnana tsǝa sǝ tunǝ banì ama, Galiyet ka. <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />Laban ɗǝm ngga bang ama, &lt;&lt;Yahweh ɓǝ̀ tsǝk mǝsǝi arǝ sǝm, mim sǝ we, ace mǝnana ɓǝ̀ sǝm bwal mǝnia yì kùrcau, anzǝm mǝnana sǝm gauni tarǝ sǝm ngga. Acemani ka tunǝ banì ɗǝm ama Mizǝpa.<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="fq" closed="false">Mizǝpa </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;ban tsǝk mǝsǝu.&gt;&gt;</char></note> <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />Ɓǝ̀ a pakki amuna-mamǝna mem gìr mǝɓane, ko a al aɓea amamǝna amúrià sǝ ko ǝn sǝlǝce raka, ɗenyi ama Ɓakuli ka nda mǝ'nakún a nre sǝm sǝnǝ we.&gt;&gt;<verse eid="GEN 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="GEN 31:51" />Laban nyare banggi Yakupu ama, &lt;&lt;Sǝn atali mǝnia à gwalikia ka pepè, sǝ sǝn nggea tali mǝnia ǝn kwakì a nrem sǝnǝ we ka pepè. <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />Mǝnia yì atali à gwalì ka à dumǝna gìr nakún, sǝ mǝnia yì tali kwaki ka dumǝna gìr nakún. À nǝ̀ came kǝla agir kasǝɓalǝu ama pà mǝ nǝ yàllî ban mala atali mǝnia à gwalì ka aban ká a nzali mô ace pakko mǝɓane ɗàng, sǝ we gbal ka a pa wunǝ yàllî mǝnia yi nzong, ban mala atali mǝnia à gwalì andǝ tali mǝnia kwakì ka aban ká a nzali mem ace pakkam mǝɓane ɗàng. <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />Ən nggǝ tunǝ Ɓakuli mala Ibǝrayim andǝ Ɓakuli mala Naho, yì Ɓakuli mala tárrià ɓǝ̀ pàk ɓashi a nre sǝm.&gt;&gt; Pǝlǝa Yakupu pàcau nǝ kángìr aɓa lullǝ Ɓakuli mǝnana tárrí Ishaku kǝ ɓanggi wi ka. <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />Yakupu pwan-myal girkusǝu pana gìr'nkila nǝi a kǝ banì, amur nkono mǝno, sǝ tunǝ aɓwana male ɓǝà yiu ɓǝà yi li girlina. Lang à lina girlina ka, à nong kano amur nkono bankwaria.<verse eid="GEN 31:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 31:55" />Nǝ bu dǝmbari ɗiɗyal ka, Laban yi kùr amǝkè andǝ amuni amuna-mamǝna zǝp nǝ abui, tsǝkia wia bù sǝ tsǝiandà, pǝlǝa bwal njar nyare o a nzali male.<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">Yakupu gilǝ rǝì ace je andǝ Isǝwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />Lang Yakupu bwalǝna njar aban lidǝmba nǝ gya male ka, amǝturonjar mala Ɓakuli yi kumi. <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />Lang sǝnia ka, bang ama, &lt;&lt;Ban mǝnia ka kàttì mala Ɓakuli na!&gt;&gt; Pǝlǝa tunǝ banì ama, Mahanayim.<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">Mahanayim </char><char style="ft" closed="false">ngga nda &lt;&lt;akattì ɓari.&gt;&gt;</char></note><verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />Yakupu tasǝ amǝ'na-túrbân, à aki wi dǝmba à wari aban mǝ'eambi Isǝwa, mǝnana ndanǝ do a buban Seyir, a nzali Edom ngga. <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />Kwarkiria ama, &lt;&lt;Mǝnia ka nda cau mǝnana wun nǝ̀ banggi ɓwamǝgule mem, Isǝwa ka: &lt;Guro mò Yakupu kǝ bang ama, ǝn o a bǝri a ban Laban sǝ ǝn kya do atè bà pwari man yalung ngga. <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />Mǝ ndanǝ andá, andǝ andambǝritso, andǝ anzur, andǝ ambul-pǝndǝa, andǝ amǝ'túró-ɓala, amamǝna andǝ aburana. Ən nggǝ tasǝ cau mǝnia ka a bano ɓwamǝgule, ace alta ɓwamuru mala kum akban a bano.&gt; &gt;&gt;<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />Anzǝm mana amǝ'na-turbanì kya nana kún-turban mǝnana à túriá nǝi sǝ à nyarǝna aban Yakupu ka, à yi banggi wi ama, &lt;&lt;Sǝm wari aban mǝ'eambo, yi Isǝwa, sǝ bangga sǝm ama nda a njargula aban yiu a bano, atārǝia andǝ aburana male gbǝman-ine atè!&gt;&gt;<verse eid="GEN 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 32:7" />Nǝ ɓangciu arǝì andǝ ɓālǝkasǝkya, Yakupu pǝlǝa gau aɓwana mǝnana atè ka arǝ abanì ɓari. Anggo gbal sǝ gau adomwan mala anzur, andǝ ambul-pǝndǝa, andǝ andá, andǝ mala akalakadambi. <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />Ɗenyicau male ka nda mǝnana ama, &lt;&lt;Ɓǝ̀ Isǝwa yiu nǝ munǝo arǝ banì mwashat mala aɓwana andǝ agirkusǝu male ka, ɓè banì man mwashat ka nǝ̀ gandǝ ɓangŋa nǝ̀ àwá.&gt;&gt;<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />Pǝlǝa Yakupu pakhiwi ama, &lt;&lt;We Ɓakuli mala kèm Ibǝrayim, sǝ Ɓakuli mala tárrám Ishaku, We Mǝtalabangŋo, mǝnana a banggàm ama, &lt;Nyare o a nzali mô, aban aɓwana mô, sǝ mǝ nǝ pakko mǝɓoarne&gt; ka.<note caller="+" style="f"><char style="fr" closed="false">32:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 31:3">Tite 31:3</ref>,<ref loc="GEN 31:13">13</ref></char>.</note> <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />Ən kārǝa mǝ nǝ kum pěmǝɓoarne andǝ domǝsǝcau mǝnana a lǝmdǝam, yi mim guro mò ka ɗàng. Acemǝnana ɗiɗyal mana ǝn nying là, ǝn yi yàl a nkaring Nggeasala Jodan ngga, kǝ mǝgara nda gìr mǝnana mǝ ndanǝi a buam ngga. Sǝ adyan ngga, mǝ ndya nǝ agirkuma à lùmsǝ kàttì ɓari ka! <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />Ida, amsǝam a bu mǝ'eambam, Isǝwa, acemǝnana ɓangciu kǝ pakkam ama, ndo nǝ̀ yiu nǝ munǝo arǝàm, mim sǝnǝ anggea ka amuna andǝ amuna. <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />A bangŋǝna ama, &lt;Nǝ mǝsǝcau, mǝ nǝ tsǝko bu, mǝ nǝ pakko mǝɓoarne, amǝkeo nǝ̀ làkkì pas kǝla mǝsǝsala mala nggeamùr, mǝnana à pà nǝ̀ gandǝ ɓallia raka.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">32:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 22:17">Tite 22:17</ref>; <ref loc="GEN 28:13-15">28:13-15</ref></char>.</note><verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />Yakupu nongŋo akǝ banì mǝno ka a dù mǝno. Pǝlǝa tàr aɓea girkusǝu ace paɓoro aban mǝ'eambi, Isǝwa ani: <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />Ambul-pǝndǝa amǝ'nggaule gbǝman-ɓari sǝ agbato lumi-ɓari, anzur amǝ'nggaule gbǝman-ɓari, andǝ agam lumi-ɓari, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />akalakadambi amǝ'nggaule lumi-tàrú andǝ amunia, andǝ andá lumi-ine, andǝ ajamnda lum, andǝ amǝdambǝriso amǝ'nggaule lumi-ɓari, sǝ amǝdambǝriso ajamne lum. <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />Pǝlǝa gaki agirkusǝu mǝnia ka arǝ adomwan, sǝ pà koya domwan a bu amǝ'túró-ɓala male ɗàngɗáng. Banggia wia ama, &lt;&lt;Wu akàm dǝmba, wu um nǝ agirkusǝu, sǝ a ká ma'wun ngga, wu kǝa gbashi tarǝ wun ɗàng. Nreban ɓǝ̀ nong zak a nre domwan andǝ domwan mala agirkusǝu.&gt;&gt;<verse eid="GEN 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 32:17" />Yakupu pǝlǝa kwarkir mǝtúró-ɓala mǝnana nda a dǝmba ka ama, &lt;&lt;Ɓǝ̀ a yi jena wunǝ mǝ'eambam Isǝwa, sǝ ɗio ama, &lt;A nda mǝtúró-ɓala mala yana? Sǝ a nǝ ká ke? Sǝ yana nda mǝtala agirkusǝu mǝnia a ɓadǝmbo ka?&gt; <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />Pǝlǝa awu nǝ pe wi eare ama, &lt;Amala guro mò Yakupu na. Ɓoro na túrnaban nǝi aban ɓwamǝgule male, Isǝwa. Sǝ yì Yakupu ka nda kǝ yiu anzǝm sǝm ngga.&gt; &gt;&gt;<verse eid="GEN 32:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 32:19" />Nǝ kǝ kwarkiru mǝno ka Yakupu kwarkir ɓaria, andǝ tàruia, andǝ acili amǝ'túró-ɓala gbal mǝnana tsǝia à kǝ pǝ̀r adomwan ngga ama, &lt;&lt;Wun nǝ̀ banggi Isǝwa kǝ cau mǝ'mwashati ɓǝ̀ wu jena wunǝi ka, <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />sǝ wun nǝ̀ banggi wi ɗǝm ama, &lt;Sǝni guro mò Yakupu ka ndya kǝ yiu anzǝm sǝm ngga.&gt; &gt;&gt; Yakupu pàk ɗenyicau ama, &lt;&lt;Mǝ nǝ ɓariki mǝ nǝ pwasǝlǝ ɓabumi nǝ agir ɓoro mǝnana mǝ nǝ ak dǝmba mǝ nǝ tasǝi wi ka. Sǝ nǝnzǝ́mò, ɓǝ̀ ǝn yiu ǝn yi kumi ǝn sǝn ɓamǝsǝi ka, yakǝla nǝ̀ eam nǝ dotarǝu.&gt;&gt;<verse eid="GEN 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 32:21" />Anggo sǝ aɓoro ak dǝmba aban ká a ɓadǝmbi, sǝ yì Yakupu nǝ ɓamúrì ka, ueo anzǝ́mò, nongŋo aɓa gumli a ban mǝno sulǝ kam ngga a dù mǝno.<verse eid="GEN 32:21" /></para>
  <para style="s">Yakupu warwara andǝ Ɓakuli</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />Nǝ bu du mǝno ka, Yakupu lo, twal amāmí mǝnana ɓari ka, andǝ amamǝna amǝ'túró-ɓala male mǝnana ɓari ka, andǝ amuna-burana male yia lum-nong-mwashat, pǝlǝa à sulǝo a Mùr Jabok a ban mǝnana lim raka sǝ à eauwe a ɓè nkaring. <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />Lang eamsǝnia à eauna a nkaring Mùr Jabok ka, pǝlǝa tasǝ acili agirkuma male kat à eauwe a nkaring ateà, <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />sǝ yì ka ueo anzǝ́mò, nǝmurǝì.</para>
  <para style="p" vid="GEN 32:24">Kara ɓe ɓwa yiu, à warwara andǝi bà kwaro mala ban.<note caller="+" style="f"><char style="fr" closed="false">32:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 12:3-4">Hos 12:3-4</ref></char>.</note> <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />Lang ɓwe sǝni gandǝ mak Yakupu nǝ wara raka, pǝlǝa tùl mú nkpakota Yakupu, kara nkpako ɓuni songŋo. <figure style="fig" alt="Jacob wrestle with God" file="CO00686B.TIF" size="col" loc="32:25" ref="32:22-25">Yakupu warwara andǝ Ɓakuli</figure><verse eid="GEN 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 32:26" />Ɓweni bang ama, &lt;&lt;Nyem, ɓǝ̀ ǝn o, acemǝnana ban malanǝ̀ kwaro!&gt;&gt; Sǝ Yakupu ka pǝlǝi wi ama, &lt;&lt;Pà mǝ nǝ ɗekio wu u ɗang, she ɓǝa tsǝ́ngŋǝ̀nàm bù ka.&gt;&gt;<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />Pǝlǝa ɓweni ɗì ama, &lt;&lt;Lùllǝò ɗe a mana?&gt;&gt;</para>
  <para style="p" vid="GEN 32:27">Pǝlǝa pe wi eare ama, &lt;&lt;Yakupu.&gt;&gt;<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />Ɓweni banggi wi ama, &lt;&lt;À pà nǝ̀ tunǝo ɗǝm ama Yakupu ɗàng; twal adyan ngga à nǝ̀ nggǝ tunǝo ama, Isǝrayila,<note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="fq" closed="false">Isǝrayila </char><char style="ft" closed="false">nǝ kún Ibǝru ka à oè kǝla ama &lt;&lt;warwara andǝ Ɓakuli.&gt;&gt;</char></note> acemǝnana a warwara wunǝ Ɓakuli andǝ aɓwapǝndǝa, sǝ rǝcandǝa mò amsǝ ɗang.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 35:10">Tite 35:10</ref>; <ref loc="2KI 17:34">2Amur 17:34</ref></char>.</note><verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />Yakupu na ama, &lt;&lt;banggàm lùllǝò pé.&gt;&gt;</para>
  <para style="p" vid="GEN 32:29">Pǝlǝa ɓwenî ɗì ama, &lt;&lt;Ace mana sǝ a kǝ earce súrǝ̀ lullǝam?&gt;&gt; Pǝlǝa tsǝki Yakupu bù abanì.<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />Yakupu bang ama, &lt;&lt;Ən sǝna Ɓakuli a ɓamǝsǝi, kat andǝa mani ka, yilǝmem kum àwá.&gt;&gt; Pǝlǝa Yakupu tsǝki banì lullǝu ama, Penǝyel.<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="fq" closed="false">Penǝyel</char><char style="ft" closed="false">ka nda &lt;&lt;ɓamǝsǝ Ɓakuli.&gt;&gt;</char></note><verse eid="GEN 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 32:31" />Pwari na aban eauwe, yi mana Yakupu nǝ nggǝ nying Penǝyel aban o ka. Kǝ zanggǝɗi aban gya, ace npenye mǝnana kúmô a nkpakote ka. <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />Nda gìr mǝnana tsǝa bà yalung amǝ Isǝrayila kǝ li mazo nkpakota koya nyama raka, ace gìr mǝnana kum Yakupu, à tùllì amur mazo nkpakote ka.<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">Yakupu andǝ Isǝwa gilǝki nrea</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />Yakupu loasǝ mǝsǝi sǝn Isǝwa aban yiu, yì andǝ aburana male gbǝman-ine. Pǝlǝa gakkia amuna a nre ka Liya, andǝ Rahila, andǝ amamǝna ɓari amǝ'túró-ɓala male. <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />Tsǝk amamǝna amǝ'túró-ɓala andǝ amunia a dǝmba, sǝ Liya andǝ amuni kpatea, sǝ Rahila andǝ muni Yisǝfu masǝlǝia wia a nzǝ́mò. <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />Sǝ yì Yakupu nǝ nggearǝì ka akia wia dǝmba aban ká. Lang gbàshìnà ban mǝ'eambi ka, kara ɓunbî wi kusǝ tongno-nong-ɓari a ɓadǝmbi.<verse eid="GEN 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 33:4" />Sǝ Isǝwa ka ɓangŋa aban yiu abani, soak abui a myali, kùrì zǝp. Yià kǝm ngga, à túr kunia aban ɓua. <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />Lang Isǝwa loasǝ mǝsǝi sǝn amamǝna andǝ amuna ka, pǝlǝa ɗì Yakupu ama, &lt;&lt;A yana mǝnia wu nda wunǝia ka?&gt;&gt;</para>
  <para style="p" vid="GEN 33:5">Yakupu pǝlǝa pe wi eare ama, &lt;&lt;Amuna na mǝnana Ɓakuli ɓwamur guro mò pe wi ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 48:9">Tite 48:9</ref>; <ref loc="PSA 127:3">Ang 127:3</ref>; <ref loc="ISA 8:18">Isha 8:18</ref></char>.</note><verse eid="GEN 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 33:6" />Pǝlǝa amamǝna amǝ'túró-ɓala andǝ amunia yiu à yi ɓun a ɓadǝmbi. <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />Anggo sǝ Liya andǝ amuni kpatea, à yiu à yi ɓun a nzali a ɓadǝmbi. A masǝlǝate ka, Yisǝfu, sǝ Rahila, yia gbal ka, à yiu à yi ɓun a nzali a ɓadǝm Isǝwa.<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />Isǝwa ɗì Yakupu ama, &lt;&lt;Man nda ɓalǝ amǝnia yia girkusǝu andǝ adomwan ǝn je sǝnǝia aban yiu ka?&gt;&gt;</para>
  <para style="p" vid="GEN 33:8">Yakupu pe wi eare ama, &lt;&lt;Aɓoro na ǝn yinǝo wia ka, ace kum ɓwamuru andǝ akban a bano, we ɓwamǝgule mem.&gt;&gt;<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />Sǝ Isǝwa ne wi ama, &lt;&lt;Mǝ'eambam, mǝ ndanǝ agir kpǝm mǝnana à kàrǝ́nǎm ngga. Bwal agir mǝnana amô na ka.&gt;&gt;<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />Yakupu ɓinǝi wi ama, &lt;&lt;Awo, ɓǝ̀ ǝn kumǝna earmúrú a bano ka, ida ak mǝnia yi ɓoro ka a buam. Acemǝnana, sǝna mǝno ado ǝn sǝn ɓamǝsǝo sǝ a angŋǝnam ngga, nda kǝla ǝn sǝna ɓamǝsǝ Ɓakuli. <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />Ən nggǝ zǝmbo, ak ɓoro mǝnia ǝn yinǝo nǝi ka, acemǝnana Ɓakuli ka lǝ́mdǝ́nàm pěmǝɓoarne male kǝ̀rkǝ́r sǝ pànâm koman mǝnana kat ɓoaro ɓǝ̀n pang nǝi ka.&gt;&gt; Sǝ acemǝnana Yakupu camarǝ pità Isǝwa ka, a masǝlǝate ka, Isǝwa eare ak aɓoronì.<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />Pǝlǝa Isǝwa bang ama, &lt;&lt;Ado ka wu fa, ɓǝ̀ sǝm twal gya ɓǝ̀ sǝm o. Mǝ nǝ dupa wun a dǝmba.&gt;&gt;<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />Sǝ Yakupu eari wi ama, &lt;&lt;Ɓwamǝgule mem, a sǝlǝna ama, aɓea amuna atà sǝm ngga à ɓiki keke, sǝ adomwan mala ambul andǝ andá gbal ka à ndanǝ amunia ateà mǝnana à nda kúnkiura ka. Dumǝna púp mǝ nǝ ɗenyi nǝia. Ɓǝ̀n pǝrtea akaurǝa, ko ɓǝ̀ mala nongŋo mwashat na ka, à nǝ̀ wuki kat. <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />Nggǝ zǝmbo, ɓǝ̀ nǝ̀ ɓoar ka, ɓwamǝgule mem, ak dǝmba o. Sǝm nǝ̀ nggǝ kpato ɓukɓuk aban yiu, nǝ gya mǝnana pà nǝ̀ kwanbi agirkusǝu andǝ amuna raka. Mǝ nǝ nggá kúmǒ a Seyir.&gt;&gt;<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />Isǝwa pǝlǝa eare ama, &lt;&lt;Ida, ɗeki lâ ɓǝ̀n nying aɓea burana mem atà wun.&gt;&gt;</para>
  <para style="p" vid="GEN 33:15">Yakupu pǝlǝi wi ama, &lt;&lt;Awo, sheɓǝ̀ a pángŋǝ̀nà anggo ka ɗàng. Mim ngga earmúrú a bano na ǝn earkiyice mǝ kum ngga, ɓwamǝgule mem!&gt;&gt;<verse eid="GEN 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 33:16" />Pǝlǝa Isǝwa nyare a kusǝì a kǝ pwari mǝno aban o a Seyir. <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />Sǝ Yakupu ka, o a Sukkot. Akano ka kya pakki ɓamúrì bando, sǝ tǝmgi atara ace agirkusǝu male. Nda gìr mǝnana tsǝa sǝ à tunǝ banì ama, Sukkot<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="fq" closed="false">Sukkot </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Atara.&gt;&gt;</char></note> ka.<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />Anzǝm mana Yakupu nyìngŋǝ̀nà Padan Aram<note caller="+" style="f"><char style="fr" closed="false">33:18 </char><char style="fq" closed="false">Padan Aram </char><char style="ft" closed="false">nda Njar-nza mala nzali Suriya.</char></note> ngga, yiu jam a nggea-là Shekem, a nzali Kan'ana. Akano sǝ tsǝk kàttì nǝ agumli male, duk kam a nzǝm la. <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />Pǝlǝa Yakupu kúr nzali mǝno tsǝk agumli male kàm ngga; kúrí a bù amuna-burana mala Hamo, tár Shekem, a kún mǝsǝ bolo-azǝrfa<note caller="+" style="f"><char style="fr" closed="false">33:19 </char><char style="fq" closed="false">mǝsǝ bolo-azǝrfa </char><char style="ft" closed="false">ka à kǝ kárǝ́ dǝmbǝrya male sǝ à nǝ̀ pa ace kúr gìr.</char></note> gbǝman-mwashat. <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />A kǝ ban mǝno, Yakupu ɓak gyangŋan, pǝlǝa tunǝi ama, El Elohe Isǝrayila.<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="fq" closed="false">El Elohe Isǝrayila </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓakuli, Ɓakuli mala Isǝrayila.&gt;&gt; Ko &lt;&lt;Ɓakuli mala Isǝrayila ka Mǝgulo na.&gt;&gt;</char></note><verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">Mbweban a kúnì pě mǝɓane mǝnana Shekem pak ka</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />A ɓè pwari ka, Dina muna-ɓwama mala Liya, mǝnana à ɓǝl andǝ Yakupu ka, lo wari ama nǝ̀ nggá sǝn aɓi ansarina mǝnana à do a bu-nzali mana à ndakam nǝ do ka.<note caller="+" style="f"><char style="fr" closed="false">34:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt" closed="false"><ref loc="GEN 30:21">Tite 30:21</ref>.</char></note> <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />Lang Shekem, muna-ɓwabura mala Hamo ɓwa Hivi, mǝnana nda murǝm mala mǝno yì bu-nzali, nǝ sǝn Dina ka, kara bwali nǝ rǝcandǝa pàngŋǝ̀nà ɓwama nǝi, kìɗikì. <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />Sǝ yì Shekem ngga, cè Dina, yì muna-ɓwama mala Yakupu ɓoari wi, pǝlǝa ɓariki nǝ̀ tsǝa ɓǝ̀ ɓwama earì; ne wi cau ɓukɓuk nǝ kún lǝmdǝ earban, ɓǝ nuni arǝì. <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />Pǝlǝa Shekem ne tárrí Hamo, ama, &lt;&lt;Ən nggǝ earce nǝma wu alàm muna-ɓwama man ɓǝ̀ duk māmám.&gt;&gt;<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />Yakupu yi ok ama Shekem kìɗìkìna muna-ɓwama male Dina, sǝ acemǝnana amuni amuna-burana ka, à nda a ɓabondo aban yál agir ka, na kǝ cau ɗàng. Kúndǝô she ɓǝà nyàrnà ka.<verse eid="GEN 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 34:6" />Hamo, tár Shekem, puro wari aban Yakupu nǝ̀ nggá bangcau nǝi amur cenî. <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />Anggo ka, amuna-burana mala Yakupu nyàrǝ́nì ɓabondo. Lang à ongŋǝna ama à kìdìki mǝ'eambia muna-ɓwama ka, gìrnî kwanrǝia, sǝ à pàk bumlulla kǝ̀rkǝ́r nǝ man yì gìr Shekem pè, mǝnana ɓoaro ɓǝà pè raka; nggea gìr pà kǝsǝkya arǝ aɓwana mala Isǝrayila na, mǝnana kìɗìki mǝ'eambia muna-ɓwama mala Yakupu ka.<verse eid="GEN 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 34:8" />Sǝ Hamo ka bang cau nǝ Yakupu andǝ amuna-burana male. Banggia wia ama, &lt;&lt;Muna-ɓwabura mem Shekem, nǝ mǝsǝcau ka, kǝ earce muna-ɓwama ma'wun, sǝ ɓabumi kat umǝna arǝì. Ɓǝ̀ wun nǝ̀ earka, ida, wu pè wi ɓǝ̀ ali. <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />Ɓǝ̀ sǝm eare alban ɓǝ̀ pà a nre rǝarǝ sǝm. Wu pà sǝm amuna-mamǝna ma'wun, sǝ sǝm nǝ̀ pà wun amuna-mamǝna ma'sǝm. <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />Wun nǝ̀ gandǝ do akani aɓalǝ sǝm a nzali ma'sǝm. Wu do sǝ wu gya a koya ban wu earce ka, wu pàk nggaliki atà sǝm, wu kúrki anzali sǝ wu ɓakki aɓala ɓǝà duk agirkuma ma'wun.&gt;&gt;<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />Pǝlǝa Shekem nacau nǝ tár Dina andǝ amǝ'eam Dina ama, &lt;&lt;Ən nggǝ zǝmba wun, wu lǝmdǝàm earmúrú, wu earâm ɓǝ̀n al Dina. Mǝ nǝ pa wun gìr mǝnana kat wu ɗìce ka. <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />Ko ɓǝ̀ mana nda gǝna mǝnana wun nǝ̀ kasǝa, andǝ agir mana mǝ nǝ mbwe amur ɓwama ka, mǝ nǝ yia mbwe nǝ banɓoarnado, ɓǝ̀ wun nǝ̀ pam muna-ɓwama man ɓǝ̀ duk māmám ngga.&gt;&gt;<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />Amuna-burana mala Yakupu pa kǝla à earǝna. À nyesǝî Shekem andǝ tárrí Hamo cau nǝ kún ɓosǝkiban, acemǝnana kìɗìkìna mǝ'eambia, yi Dina. <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />À banggia wia ama, &lt;&lt;Pà sǝm nǝ̀ eare ɓǝ̀ sǝm al wun ɗàng, acemǝnana wun ngga, à kasǝa wun ɓata wun ɗàng; gìr kǝsǝkya na aban sǝm, ɓǝ̀ mǝ'eam sǝm muna-ɓwama al ɓwa mǝnana à kasǝî wi ɓate raka! <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />Gìr mwashat nda mǝnana nǝ̀ tsǝa sǝ sǝm nǝ̀ eara wun ngga: ɓǝ̀ wun mǝnana kat wu nda ka aburana, à nǝ̀ kasǝa wun ɓata wun, kǝla mana sǝm ngga à kasǝa sǝm ɓata sǝm ngga.<note caller="+" style="f"><char style="fr" closed="false">34:15 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 17:23-27">Tite 17:23-27</ref></char>.</note> <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />Anggo sǝ sǝm nǝ̀ pà wun amuna-mamǝna ma'sǝm, sǝ wun gbal ka, wun nǝ̀ pà sǝm amuna-mamǝna ma'wun. Sǝm nǝ̀ do atà wun, sǝ sǝm sǝnǝa wun ngga, sǝm nǝ̀ duk aɓwana amǝ'mwashati. <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />Sǝ ɓǝ̀ pà wun nǝ̀ eare anggo, à nǝ̀ kasǝa wun ɓata wun raka, sǝm nǝ̀ twal mǝ'eam sǝm, sǝm nǝ̀ bwal njargula, sǝm nǝ̀ o.&gt;&gt;<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />Acau mǝnia ka à ɓoarì Hamo andǝ muna-ɓwabura male Shekem. <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />Sǝ yì lagga Shekem ngga, kìɗìki pwari arǝ pak gìr mǝnana à earce ama ɓǝ̀ pàk ka ɗàng, acemǝnana kǝ earce Dina muna-ɓwama mala Yakupu nǝ rǝɓǝla, sǝ ɗǝm ngga yì nda ɓwa mǝnana à kǝ pe wi gulo kútì acili aɓwana kat a ɓala mala tárrí ka.<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />Pǝlǝa Shekem andǝ tárrí Hamo lo à wari aban kpapi-kùrcau mala là a kún nggea-là. À kya bang cau nǝ aɓwana-mǝgule mala là malea ama: <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />&lt;&lt;Aɓwana mǝnia ka, amǝ do ɓa-rǝpwala nǝ aɓwana na; ɓǝ̀ sǝm earia wia ɓǝà duk kani aɓalǝ sǝm, ɓǝà gya koya ban à earce ká a nzali ma'sǝm ngga. Nzali ka gul kpǝm nǝ̀ karǝ sǝm sǝnǝia. Sǝm nǝ̀ al amuna-mamǝna malea, sǝ yia gbal ka, à nǝ̀ al ama'sǝm yì amuna-mamǝna. <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />Gìr mwashat mǝnana à bang ama sǝm nǝ̀ pa sǝ à nǝ̀ eare à nǝ̀ do aɓalǝ sǝm, sǝ sǝm nǝ̀ duk aɓwana mwashat sǝnǝia ka, nda mana ama koya ɓwabura atà sǝm ngga, ɓǝà kasǝî wi ɓate, kǝla mana yia gbal ka à kasǝ ɓatea ka. <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />Ɓǝ̀ sǝm pa anggo ka, adomwan mala andá malea, andǝ agirkuma malea, andǝ agirkusǝu malea kat nǝ̀ duk ama'sǝm. Acemani ka, ɓǝ̀ sǝm eare ɓǝ̀ sǝm pàk gìr mǝnana à earkiyice nǝ sǝm ɓǝ̀ sǝm pàk ka, sǝ yia ka à nǝ̀ eare à nǝ̀ do aɓalǝ sǝm.&gt;&gt;<verse eid="GEN 34:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 34:24" />Aɓwana mǝnana kat à puro sǝ à wari a kún nggea-là ka, à earnǝ cau mala Hamo andǝ mala muni Shekem. Koya ɓwabura andǝ muna-ɓwabura mǝnana à nda kǝ là mǝno ka, à kasǝî wi ɓate.<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />Nongŋo tàrú anzǝm mǝno, lang penye mala kasǝ-ɓatau nggeangsǝkina, sǝ à nda ɓá kwanban più ka, ɓari atà amuna-burana mala Yakupu, yì Shimiyon andǝ Lawi, amǝ'eam Dina, twal anggea-byau malea, sǝ à wario à kya kútí aɓa nggea-là hamama. Pǝlǝa à wal-lú koya ɓwabura a mǝno yì nggea-là ka. <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />À wal-lú Hamo andǝ muni Shekem gbal nǝ anggea-byau malea, sǝ à pusǝ mǝ'kyauwea, Dina a ɓala mala Shekem, sǝ à puro à o a là-gumli malea. <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />Anzǝm mǝno ka, acili amuna-burana mala Yakupu yi tusǝo. Lang à yi sǝn alú aburana mǝnana à walia ka, kara à kutio à pwan kume mala là mǝno ka, atàcau mala mǝ'kyauwea muna-ɓwama mǝnana à kìɗikì ka. <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />À pwan ambul, andǝ andá, andǝ andambǝritso malea, mǝnana à kumia aɓa nggea-là, andǝ amǝnana a nzǝm la andǝ ɓabondo ka. <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />À pwan gǝna mala aɓwana mala là mǝno kat, andǝ agir mǝnana kat arǝ aɓala malea ka. À bwalki amamǝna malea kat andǝ amuna à umnǝia.<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />Nǝnzǝ́mò ka Yakupu ne Shimiyon andǝ Lawi ama, &lt;&lt;Wu kùmǝ́nàm cau! Wu tsǝ̀ngŋǝ̀nám aɓwana mala nzali mǝnia nǝ̀ ɓinǝcem, yià amǝ'Kan'ana andǝ amǝ'Periz. Mǝ nda bǝti, ǝn làkkì ɗàng; ɓǝà ram rǝia sǝ à yiu nǝ munǝo arǝàm ngga, à nǝ̀ yia twaltam, mim sǝnǝ amǝ'ɓala mem kat!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">34:30 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 46:26-27">Tite 46:26-27</ref>; <ref loc="1CH 16:19">1Acau 16:19</ref>; <ref loc="PSA 105:12">Ang 105:12</ref></char>.</note><verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />Sǝ yia ka à pà eare ama, &lt;&lt;Lang ɗe sǝ à nǝ̀ pang nǝ mǝ'eam sǝm muna-ɓwama kǝla mā-gyatarǝu?&gt;&gt;<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">Yakupu andǝ amǝɓala male nyare a Betel</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />Ɓakuli banggi Yakupu ama, &lt;&lt;Lo, o a Betel sǝ wu do abanì. Ɓak gyangŋan abanì acem, mim Ɓakuli mǝnana ǝn lǝmdǝ rǝàm a bano mana a ndaban ɓangŋa ace upi ban mǝ'eambo Isǝwa ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">35:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 28:19">Tite 28:19</ref></char>.</note><verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />Pǝlǝa Yakupu banggi amǝ'ɓala male andǝ aɓwana mana kat à nda atè ka ama, &lt;&lt;Wu pusǝki aɓǝ̀nzál mala peri aban abǝri aɓakuli mǝnana à nda bu wun ngga, wu lak rǝ'wun, sǝ wu nggaɗi agir-nggūrǝu ma'wun.<note caller="+" style="f"><char style="fr" closed="false">35:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 31:19">Tite 31:19</ref>; <ref loc="JOS 24:23">Jes 24:23</ref>; <ref loc="1SA 7:3">1Sam 7:3</ref></char>.</note> <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />Ɓǝ̀ sǝm lo sǝm nǝ̀ umì a Betel. Akano ka mǝ nǝ nggá ɓakkî Ɓakuli gyangŋan, yì Ɓakuli mana ok hiwi mem a pwari tanni mem, sǝ nda atàm a koya ban ǝn wari kam ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">35:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 28:10-22">Tite 28:10-22</ref></char>.</note><verse eid="GEN 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 35:4" />Nda à pè Yakupu abǝri ɓakuli mǝnana a buia ka kat, andǝ agirkiru mana a kiria ka. Yakupu lúmsǝiǎ a tǝrta nggun mǝgule mǝnana a Shekem ngga. <verse eid="GEN 35:4" /><verse number="5" style="v" sid="GEN 35:5" />Lang à puro à nǝ̀ o ka, nggea ǝn'ò mǝnana pùr nǝban Ɓakuli ka sulǝo amur alá mǝnana à nda a ban mǝno ka. Acemani ka kǝɓwa lo ama nǝ̀ pǝ̀rta amuna mala Yakupu ama nǝ̀ pàkkia wia kǝgìr ɗàng.<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:27">Pur 23:27</ref></char>.</note><verse eid="GEN 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 35:6" />Nda sǝ Yakupu andǝ aɓwana mana atè ka à yi bik Luz (mǝnana à tunǝi gbal ama Betel ka) a nzali Kan'ana. <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />Yakupu ɓak gyangŋan kano sǝ tunǝ lullǝ banì ama El Betel,<note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="fq" closed="false">El Betel </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓakuli mala Betel.&gt;&gt;</char></note> acemǝnana Ɓakuli lǝmdǝ rǝì a baní a ban mǝno lang nda rǝ ɓangŋa nǝ̀ upi ban mǝ'eambi Isǝwa ka.<verse eid="GEN 35:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 35:8" />Bǝti anzǝm mǝnia ka, Debora,<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="fq" closed="false">Debora </char><char style="ft" closed="false">ka a bang cau male a: </char><char style="xt"><ref loc="GEN 24:59">Tite 24:59</ref></char>.</note> yì ɓwagula mǝnana ɗiɗyal nda iulǝ Rabeka mālá Ishaku a muna ka, paklú. À tsǝk-luí a tà nggun mǝgule aɓa ɓangŋaban mǝnana a Betel ka. Sǝ à tsǝkî nggunî lullǝu ama, &lt;&lt;Nggea-nggun sukkimǝrǝm.<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="fq" closed="false">Nggea-nggun sukkimǝrǝm </char><char style="ft" closed="false">ko Allon Bacuth nǝ kún Ibǝru.</char></note>&gt;&gt;<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />Nyare mǝno Yakupu nyàrî Padan Aram ngga, Ɓakuli lǝmdǝ rǝì a baní ɗǝm a Betel. Ɓakuli tsǝki wi bù <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />banggi wi ama, &lt;&lt;Lùllǝò nda Yakupu, sǝama à pà nǝ̀ nggǝ tunǝo ɗǝm ama Yakupu ɗàng. Twal ado aban ká dǝmba ka, lùllǝò nda Isǝrayila.&gt;&gt; Anggo sǝ Ɓakuli nggaɗi wi lullǝu ama Isǝrayila.<note caller="+" style="f"><char style="fr" closed="false">35:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 32:28">Tite 32:28</ref></char>.</note><verse eid="GEN 35:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 35:11" />Pǝlǝa Ɓakuli banggi wi ama, &lt;&lt;Mǝ nda Ɓakuli Mana Karban Kat nǝ Gulo<note caller="+" style="f"><char style="fr" closed="false">35:11 </char><char style="fq" closed="false">Ɓakuli Mana Karban Kat nǝ Gulo </char><char style="ft" closed="false">nda El-Shaddai nǝ kún Ibǝru.</char></note> ka. Ɓǝl amuna sǝ wu hatǝki! Tau mò nǝ̀ duk nzali mǝgule sǝ nǝ̀ ɓǝl anzali pas. Aɓalǝ amǝ'keò ka amurǝma nǝ̀ puro!<note caller="+" style="f"><char style="fr" closed="false">35:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="GEN 17:6">Tite 17:6</ref>,<ref loc="GEN 17:16">16</ref>; <ref loc="GEN 36:31">36:31</ref>.</char></note> <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />Nzali mǝnana ǝn pê Ibǝrayim andǝ Ishaku ka mǝ nǝ po wì, sǝ mǝ nǝ pè amunio andǝ amǝ'keo mǝnana à nǝ̀ ɓǝlia a nzǝmo ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">35:12 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 26:3-4">26:3-4</ref>; <ref loc="GEN 28:13">28:13</ref>; <ref loc="EXO 32:13">Pur 32:13</ref></char>.</note> <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />Pǝlǝa Ɓakuli upi ban mǝno nacau nǝ Yakupu kàm ngga.<verse eid="GEN 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 35:14" />A ban mǝno Ɓakuli nacau nǝi ka, Yakupu twal nggea tali sǝ kwaki, ɓǝ̀ cam nǝ came. Pǝlǝa solǝ mùr-ɓǝlanggun anap amurí kǝla paɓoro aban Ɓakuli; ɗǝm ngga ɗārǝi nǝ mùrú olif ɓǝ̀ tàrì, ban-peri aban Ɓakuli na.<note caller="+" style="f"><char style="fr" closed="false">35:14 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 28:18-19">Tite 28:18-19</ref>; <ref loc="GEN 31:45">31:45</ref></char>.</note> <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />Yakupu pǝlǝa tsǝki ban mǝnia Ɓakuli na cau nǝi kàm ngga lullǝu ama Betel.<note caller="+" style="f"><char style="fr" closed="false">35:15 </char><char style="fq" closed="false">Betel </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓala mala Ɓakuli.&gt;&gt;</char></note><verse eid="GEN 35:15" /></para>
  <para style="s">Lú mala Rahila</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />Yakupu andǝ amǝ'ɓala male tùro à nying Betel, sǝ lang à nda njar à malanǝ̀ bik Efǝrat ka, Rahila twal gbáshí, sǝ nda aɓa kwanban mala gbáshí. <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />Lang tanni kwanban mala gbáshí male yi ɓikina ka, ɓwama mǝ'bwal gbáshí ne wi ama, &lt;&lt;Cè ɓangciu pàkkô ɗàng, Rahila; a ɓǝ́lǝnà muna-ɓwabura.&gt;&gt; <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />Sǝ aɓa mǝno anggo ka yilǝmi na rǝ purì rǝì, sǝ lang nǝ̀ tusǝ masǝlǝata lin'ueo male ka, tsǝkî muna lullǝu ama, Ben-oni.<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">Ben-oni </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;muna bumkiɗikea mem.&gt;&gt;</char></note> Sǝ tár muna ka tunǝi ama, Benjami.<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">Benjami </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;muna bu-mǝlì mem.&gt;&gt; </char></note><verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />Lang Rahila wù ka à tsǝk-luí a nkanggari njargula ká Efǝrat, là mǝnana yalung à súrǝì ama Betalami ka.<note caller="+" style="f"><char style="fr" closed="false">35:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MIC 5:2">Mik 5:2</ref>; <ref loc="MAT 2:18">Mat 2:18</ref></char>.</note> <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />Yakupu loasǝ nggea-tali tàmsǝì abanì, sǝ nda lǝmdǝ ban ɓembe mala Rahila ka bà yalung.<verse eid="GEN 35:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 35:21" />Pǝlǝa Isǝrayila andǝ amǝ'ɓala male lidǝmba nǝ gya à o à kya tsǝk là-gumli malea a ɓè buì mala ɓè ban à tunǝi ama, Migdal-Eda.<note caller="+" style="f"><char style="fr" closed="false">35:21 </char><char style="fq" closed="false">Migdal-Eda </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ban mǝ'dāhre ace sǝn múr adomwan.&gt;&gt; </char></note><verse eid="GEN 35:21" /></para>
  <para style="s">Amuna-burana mala Yakupu</para>
  <para style="r">(<ref loc="1CH 2:1-2">1 Acau la Apwari 2:1-2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />Lang Isǝrayila na ban do a nzali mǝno ka, Ruben pàk-ɓwama nǝ Bilha, mwashat atà mā-guro mala tárrí. Isǝrayila ok cè.<note caller="+" style="f"><char style="fr" closed="false">35:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 49:3-4">Tite 49:3-4</ref></char>.</note></para>
  <para style="p" vid="GEN 35:22">
    <note caller="+" style="f">
      <char style="fr" closed="false">35:22 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1CH 2:1-2">1Acau 2:1-2</ref>
      </char>.</note>Amuna-burana mala Yakupu ka à nda lum-nong-ɓari:<verse eid="GEN 35:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 35:23" />Amuna-burana nǝ bu Liya ka à nda ka Ruben (muna-dǝmba mala Yakupu), andǝ Shimiyon, andǝ Lawi, andǝ Yahuda, andǝ Isaka, sǝ Zebulu.<verse eid="GEN 35:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 35:24" />Amuna-burana nǝ bu Rahila ka à nda ka Yisǝfu andǝ Benjami.<verse eid="GEN 35:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 35:25" />Amuna-burana nǝ bu Bilha, mǝtúró-ɓala mala Rahila ka, à nda ka Dan andǝ Naftali.<verse eid="GEN 35:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="GEN 35:26" />Amuna-burana nǝ bu Zilpa, mǝtúró-ɓala mala Liya ka, à nda ka Gad andǝ Asha.</para>
  <para style="m" vid="GEN 35:26">Amǝno ka à nda ka amuna-burana mǝnana à ɓǝlî Yakupu a Padan Aram ngga.<verse eid="GEN 35:26" /></para>
  <para style="s">Lú mala Ishaku</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />Nda Yakupu nyare a là aban tárrí Ishaku a Mamǝre, a Kiriyat-Arba mǝnana à súrǝì yalung ama Hebǝron, yì ban mǝnana Ibǝrayim andǝ Ishaku duk kam kǝla abǝri ka.<note caller="+" style="f"><char style="fr" closed="false">35:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 13:18">Tite 13:18</ref>; <ref loc="GEN 18:1">18:1</ref>; <ref loc="GEN 23:19">23:19</ref></char>.</note> <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />Ishaku pàk apǝlǝa gbǝman mwashat nǝ lumi-tongno-nong-tàrú [180] a ɓanza <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />sǝ yi wú, lú mala kaɓa-ɓwa, sǝ à tsǝkbani atà akê. Amuna-burana male, Isǝwa andǝ Yakupu, na à tsǝì ka.<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">Tàu mala Isǝwa</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />Mǝnia ka nda tsaɗya mala amuna andǝ amǝ'kau a tàu mala Isǝwa (yì Edom) kǝla mǝnana à gilǝì ka.<verse eid="GEN 36:1" /></para>
  <para style="pi1">
    <verse number="2" style="v" sid="GEN 36:2" />Amālá Isǝwa ka alia atà amamǝna mala amǝ'Kan'ana. À nda ka: Ada ɓoarnsarile Elon ɓwa Hitti, andǝ Oholibama mǝnana Anah ɓǝl andǝ māmí mǝ'kà Zibiyon ɓwa Hivi, <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />sǝ Basǝmat muna-ɓwama mala Ishmayel sǝ ɗǝm ngga nda mǝ'kyauwa Nebayot ka.<verse eid="GEN 36:3" /></para>
  <para style="pi1">
    <verse number="4" style="v" sid="GEN 36:4" />Ada ɓǝlî Isǝwa muna-ɓwabura à tunǝi ama Elifas. Basemat ɓǝl muna-ɓwabura à tunǝi ama Rewel, <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />sǝ Oholibama ɓǝl a Jewus, andǝ Jalam, andǝ Kora. À ɓǝlî Isǝwa amǝnia yi amuna kat ka aɓa nzali Kan'ana.<verse eid="GEN 36:5" /></para>
  <para style="pi1">
    <verse number="6" style="v" sid="GEN 36:6" />Isǝwa pwan amāmí andǝ amuni amuna-burana andǝ amuna-mamǝna andǝ acili aɓwana mǝnana a ɓala male ka kat, sǝ pwan adomwan mala andá andǝ acili agirkusǝu male, andǝ agirkuma mǝnana kat kúmô aɓa nzali Kan'ana ka, sǝ tùro o a ɓè nzali kuko nǝban mǝ'eambi Yakupu. <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />Agirkusǝu malea làkkì kǝ̀rkǝ́r mǝnana à pà nǝ̀ gandǝ do atārǝia a ban mǝmwashati raka; nzali mǝnana à ndakam nǝ do ka karǝia yia kǝm ɗàng ace ɓiki làkkì mala andá malea. <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />Nda Isǝwa (mana à tùnǝì gbal ama Edom ngga) wario kya dukla a Seyir, nzali múr ankono ka.<note caller="+" style="f"><char style="fr" closed="false">36:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 27:39-40">Tite 27:39-40</ref></char>.</note><verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />Mǝnia ka nda tsaɗya mala aɓwapǝndǝa mǝnana à pur a nggurkwar mala Isǝwa, yì tár amǝ'Edom, mǝnana à do a Seyir, nzali múr ankono ka.<verse eid="GEN 36:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 36:10" />Alullǝ amuna-burana mala Isǝwa ka à nda ka:</para>
  <para style="li2" vid="GEN 36:10">Elifas, muna mala Ada mālá Isǝwa, andǝ Rewel, muna mala Basemat ɓè mālá Isǝwa.<verse eid="GEN 36:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 36:11" />Amuna-burana mala Elifas ka à nda ka:</para>
  <para style="li2" vid="GEN 36:11">Teman, andǝ Omar, andǝ Zefo, andǝ Gatam, andǝ Kenas.<verse eid="GEN 36:11" /></para>
  <para style="li2">
    <verse number="12" style="v" sid="GEN 36:12" />Elifas, muna-ɓwabura mala Isǝwa ɗǝm ngga twal ɓè ɓwama lùllǝì ama Timna, mǝnana ɓǝlî wi ɓè muna-ɓwabura, yì Amalek. Amǝno ka, à nda ka amǝ'kà Isǝwa nǝ bu māmí Ada.<verse eid="GEN 36:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 36:13" />Amuna-burana mala Rewel ka à nda ka:</para>
  <para style="li2" vid="GEN 36:13">Nahat, andǝ Zera, andǝ Shama, andǝ Miza. À nda ka amǝ'kà Isǝwa nǝ bu māmí Basemat.<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />Mālá Isǝwa yì Oholibama, mǝnana muna-ɓwama mala Anah, sǝ mǝ'kà Zibiyon na ka, ɓǝlî Isǝwa amuna-burana; à nda ka:</para>
  <para style="li2" vid="GEN 36:14">Jewus, andǝ Jalam, andǝ Kora.<verse eid="GEN 36:14" /></para>
  <para style="b" />
  <para style="s">Amúr-la a nggurkwar mala Isǝwa</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />Amǝnia ka à nda ka aɓwana a nggurkwar mala Isǝwa mana à yi duk amúr-là ka:</para>
  <para style="li1" vid="GEN 36:15">Amuna-burana mala Elifas muna-dǝmba mala Isǝwa ka, à nda ka:</para>
  <para style="li2" vid="GEN 36:15">Amúr-là Teman, andǝ Omar, andǝ Zefo, andǝ Kenas, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />andǝ Kora, andǝ Gatam, andǝ Amalek. Yia mǝnia ka à nda ka amúr-là a tàu mala Elifas a nzali Edom; yia ka amǝ'kà Ada na.<verse eid="GEN 36:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 36:17" />Muna-ɓwabura mala Isǝwa, yì Rewel ka nda tár a:</para>
  <para style="li2" vid="GEN 36:17">Amúr-là Nahat, andǝ Zera, andǝ Shama, andǝ Miza. Yia mǝnia ka à nda ka amúr-là a tàu mala Rewel a nzali Edom; à nda ka amǝ'kà Basemat mālá Isǝwa.<verse eid="GEN 36:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="GEN 36:18" />Amuna-burana mala Isǝwa nǝ bu māmí Oholibama ka, à nda ka:</para>
  <para style="li2" vid="GEN 36:18">Amúr-là Jewus, andǝ Jalam andǝ Kora. Amǝnia ka à nda ka amúr-là mǝnana à pur a tàu mala mālá Isǝwa, Oholibama muna-ɓwama mala Anah ka.<verse eid="GEN 36:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 36:19" />Yia mǝno kat ka à nda ka aɓwapǝndǝa mǝnana à pur a nggurkwar mala Isǝwa, yì Edom ngga.<verse eid="GEN 36:19" /></para>
  <para style="s">Amuna andǝ amǝ'kà Seyir</para>
  <para style="r">(<ref loc="1CH 1:38-42">1 Acau la Apwari 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />Akún mǝnana à nda ka amǝ nzali Edom ɓara-ɓara ka tǝrtea pur nǝban amǝnia yì amuna andǝ amǝkà Seyir ɓwa Hori ka:</para>
  <para style="li1" vid="GEN 36:20">Lotan, andǝ Shobal, andǝ Zibiyon, andǝ Anah, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />andǝ Dishon, andǝ Eza, andǝ Dishan. Koyan ateà ka yi duk múr-là mala ɓè kún mala amǝ'Hor, yì aɓwana a nggurkwar mala Seyir a nzali Edom.<verse eid="GEN 36:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="GEN 36:22" />Amuna-burana mala Lotan mǝnana à yi duk tár akún ngga, à nda ka:</para>
  <para style="li2" vid="GEN 36:22">Hori andǝ Homam. Timna ka muna-ɓwama mǝ'kyauwa Lotan na.<verse eid="GEN 36:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 36:23" />Amuna-burana mala Shobal mǝnana à yi duk tár akún ngga, à nda ka:</para>
  <para style="li2" vid="GEN 36:23">Alvan, andǝ Manahat, andǝ Ebal, andǝ Shefo, andǝ Onam.<verse eid="GEN 36:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 36:24" />Amuna-burana mala Zibiyon mǝnana à yi duk tár akún ngga, à nda ka:</para>
  <para style="li2" vid="GEN 36:24">Ayah andǝ Anah. Anah mǝnia ka nda ɓwa mǝnana tita kum amgbeaɗe mala mùrpina a ɓabondo a ban yál amǝdambǝriso mala tárrí Zibiyon ngga.<verse eid="GEN 36:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="GEN 36:25" />Anah ka nda tár Dishon; Anah ɗǝm ngga ndanǝ muna-ɓwama à tunǝi ama Oholibama.<verse eid="GEN 36:25" /></para>
  <para style="li2">
    <verse number="26" style="v" sid="GEN 36:26" />Dishon ngga nda yi duk tár akún mala</para>
  <para style="li2" vid="GEN 36:26">amǝ'Hemdan, andǝ amǝ'Eshban, andǝ amǝ'Itǝran, andǝ amǝ'Keran.<verse eid="GEN 36:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="GEN 36:27" />Eza nda tár akún mala</para>
  <para style="li2" vid="GEN 36:27">amǝ'Bilhan, andǝ amǝ'Zaavan andǝ amǝ'Akan.<verse eid="GEN 36:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="GEN 36:28" />Dishan nda tár akún mala:</para>
  <para style="li2" vid="GEN 36:28">amǝ'Uz andǝ amǝ'Aran.<verse eid="GEN 36:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="GEN 36:29" />Amǝnia ka à nda ka amúr-là mala amǝ'Hor:</para>
  <para style="li2" vid="GEN 36:29">Múr-là Lotan, andǝ Múr-là Shobal, andǝ Múr-là Zibiyon, andǝ Múr-là Anah, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />andǝ Múr-là Dishon, andǝ Múr-là Eza, sǝ Múr-là Dishan. Yia mǝnia ka, à nda ka amúr-là mala amǝ'Hor kǝla mǝnana à gakkia arǝ abân aɓa nzali Seyir ka.<verse eid="GEN 36:30" /></para>
  <para style="s">Amurǝma mala nzali Edom</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 Acau la Apwari 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />Kaniama à nǝ̀ yia kum amurǝma a nzali Isǝrayila ka, amurǝma mǝnia ka à nda mǝnana à yálmúr aɓwana a nzali Edom, kǝla mǝnana à kpatarǝia ani ka:<verse eid="GEN 36:31" /></para>
  <para style="li2">
    <verse number="32" style="v" sid="GEN 36:32" />Bela muna-ɓwabura mala Beyo ɓwa nggea-là Dinhaba ka nda murǝm Edom.<verse eid="GEN 36:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="GEN 36:33" />Anzǝm lú mala Bela ka, Jobap muna-ɓwabura mala Zera ɓwa nggea-là Bozǝra yi eauwe a buno-murǝm.<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />Lang Jobap wuna ka, Husham ɓwa nzali Teman yi duk murǝm a kúnì.<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />Lang Husham wuna ka, Hadat muna-ɓwabura mala Bedat, mǝnana gandǝ amǝ'Midiyan a lwa aɓa nzali Mowap ka, nda à yi pe wi buno-murǝm ngga. Lullǝ nggea-là male nda Avit.<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />Lang Hadat wuna ka, Samla ɓwa nggea-là Masǝreka yi eauwe a buno-murǝm.<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />Lang Samla wuna ka, Shawul ɓwa nggea-là Rehobot a kún nggeasala, yi eauwe a buno-murǝm.<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />Lang Shawul wuna ka, Baal-Hanan muna mala Akbuo yi eauwe a buno-murǝm.<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />Lang Baal-Hanan muna mala Akbuo wuna ka, Hadat yi eauwe a buno-murǝm. À tunǝ lullǝ nggea-là male ama Pau. Lullǝ māmí ka nda Mehetabel muna-ɓwama mala Matǝred, muna-ɓwama mala Me-Zahap.<verse eid="GEN 36:39" /></para>
  <para style="b" />
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />Amǝnia ka à nda ka amúr-là mǝnana à pur a tàu mala Isǝwa ka; à tunǝia nǝ alullǝia, koyan ngga nǝ kún male andǝ bu-nzali male:</para>
  <para style="li1" vid="GEN 36:40">Timna, andǝ Alva, andǝ Jetet, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />andǝ Oholibama, andǝ Ela, andǝ Pinon, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />andǝ Kenas, andǝ Teman, andǝ Mibza, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />andǝ Magdiel, sǝ Iram.</para>
  <para style="b" vid="GEN 36:43" />
  <para style="p" vid="GEN 36:43">Yia mǝno ka à nda ka amúr-là a nzali Edom. Isǝwa nda keà mǝnana à pur a tǝrtè ka. Koyan ngga nǝ ban male mǝnana duk kam aɓa nzali Edom ngga.<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">Yakupu andǝ amuna-burana male</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />Yakupu lidǝmba nǝ do a nzali Kan'ana, nzali mǝnana tárrí duk kam ɗiɗyal ka.<verse eid="GEN 37:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 37:2" />Mǝnia ka nda cau amur ɓala mala Yakupu.</para>
  <para style="p" vid="GEN 37:2">Yisǝfu, mǝlagga aɓa lum bwamdǝ tongno-nong-ɓaria pǝlǝa male ka, nda ban yál agir andǝ amǝgule. Amǝgule mǝnia ka à nda ka amuna-burana mala Bilha andǝ Zilpa, amālá tárrí. Yisǝfu kǝ yinǝi tárrià cau mǝɓane amúrià.<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />Isǝrayila, yì Yakupu ka earce Yisǝfu kútì acilia amuni kat, acemǝnana à ɓǝlî wi Yisǝfu aɓa e male. Swàrî Yisǝfu nggea-daura mǝ'ɓoarjamnì. <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />Lang amǝ'eambi sǝni tárrià earce kútiǎ kat ka, pǝlǝa à twal ɓinǝmǝsǝì. À gandǝ ne kǝcau mǝɓuɓɓuki ani ɗang.<verse eid="GEN 37:4" /></para>
  <para style="s">Alorǝo mala Yisǝfu</para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />Ɓè du nakam Yisǝfu lòrǝo, sǝ lang ne amǝ'eambi lòrǝê ka, kara à nyare à ɓinǝmǝsǝì kàm kpǝm. <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />Nea wia ama, &lt;&lt;Wu kwakikir wun arǝ mǝnia yì lòrǝo ǝn lorǝ ka, pé: <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />Lang ǝn loasǝ mǝsǝàm ngga, ǝn sǝni, sǝm nda a ɓaban aban kùrki akúnò mǝssa, kara kùnò mǝssa mem lo cam nǝ came. Sǝ akúnò ma'wun lo à kàrì mem aɓalǝu sǝ à kùndǝi wi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">37:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 42:6">Tite 42:6</ref>,<ref loc="GEN 42:9">9</ref>; <ref loc="GEN 43:26">43:26</ref>; <ref loc="GEN 44:14">44:14</ref></char>.</note><verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />Amǝ'eambi pǝlǝa à pǝlǝi wi ama, &lt;&lt;A sǝne mò ka awu nǝ duk murǝm amur sǝm, ko ana raka awu nǝ duk gbani ma'sǝm le?&gt;&gt; Nyare à ɓinǝmǝsǝì kàm kpǝm ace lòrǝo male andǝ acau mǝnana na ka.<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />Nyare lòrǝ ɗǝm, pǝlǝa nea amǝ'eambi ama, &lt;&lt;Ɓè lòrǝo nya ɗǝm ǝn lorǝ ka, wu kwakikir wun. Mǝnia yalung ngga, pwari andǝ zongŋo sǝ anlero lum-nong-mwashat kùndǝó a ɓadǝmbam.&gt;&gt;<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />Mǝnia ka ne tárrí andǝ amǝ'eambi, sǝ tárrí sà'arǝì ama, &lt;&lt;Ya ulang lòrǝo nda mǝna ka? A nda rǝ na ama nggò, sǝ mim, sǝ amǝ'eambo sǝm nǝ̀ yia ɓungio a nzali a ɓadǝmbo?&gt;&gt; <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />Amǝ'eambi kara à mwar arǝì, sǝ mala tárrí ka bwal cê kǝ ɗenyi nǝi a bumi.<note caller="+" style="f"><char style="fr" closed="false">37:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 7:9">Atúró 7:9</ref></char>.</note><verse eid="GEN 37:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />Ɓè pwari ka, amǝ'eam Yisǝfu wari a yál adomwan mala agirkusǝu mala tárrià a Shekem. <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />Yakupu ne Yisǝfu ama, &lt;&lt;Amǝ'eambo na aban yál adomwan mala agirkusǝu a Shekem. Yiu mǝ nǝ túrǒ abania.&gt;&gt;</para>
  <para style="p" vid="GEN 37:13">Pǝlǝa ne tárrí ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />Tárrí ne wi ama, &lt;&lt;Kyan pé, kya sǝntà amǝ'gulio, ko yia andǝ adomwan ngga à nda jam, sǝ wu nyare wu yi banggàm.&gt;&gt; Nda tárrí tsǝkte sǝ ɗeki a ɓangŋaban Hebǝron, pǝlǝa bwal njar aban o.</para>
  <para style="p" vid="GEN 37:14">Lang Yisǝfu yi bik Shekem ngga, <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />ɓè ɓwabura sǝni nda aban sokkikuni a ɓabondo sǝ ɗì ama, &lt;&lt;Mana a alkiyite le?&gt;&gt;<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />Yisǝfu eari wi ama, &lt;&lt;Mǝ nda rǝ alta amǝ'eambam. Ida, ko a nǝ gandǝ banggàm ban mǝnana à kǝ yál adomwan mala agirkusǝu malea kàm ngga?&gt;&gt;<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />Ɓwabure ama, &lt;&lt;À nyingǝna ban mǝnia. Ən oea à bang ama à nǝ̀ o a Dotan.&gt;&gt; Nda Yisǝfu nying ban mǝno, kutio o nǝ̀ nggá kum amǝgule a Dotan ngga.<verse eid="GEN 37:17" /></para>
  <para style="s">Amǝ'eam Yisǝfu me mak guro</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />Nda kuko aban ká, mǝsǝia kpa arǝì. Malaká bwal ɗang, à kurkunarǝia amurí ama à nǝ̀ wal-luí. <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />À ne arǝia ma, &lt;&lt;Wu sǝni, mǝ'lorǝki alorǝo man ngga ndya kǝ yiu ka! <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />Ɓǝ̀ yiu sǝm nǝ̀ yia wal-luí adyan, sǝ sǝm nǝ̀ túr luí aɓa ɓè tūli kani. Sǝm nǝ̀ na ama nyam-candǝa na bwali ka. Sǝm nǝ̀ sǝni ko lang sǝ lòrǝo male nǝ̀ yia lùmsǝó.&gt;&gt;<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />Lang Ruben ongŋǝna mǝnia ka, ɓariki nǝ̀ amsǝi a ɓabuia. Nea wia ama, &lt;&lt;Ɓǝ̀ sǝm kǝa twal yilǝmi ɗàng. <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />Wu kǝa sukki nkila ɗàng. Wu túrí aɓa tūli-mùr mǝ'ime mǝnia kani a ɓabondo ka. Sǝama wu kǝa na ama wun nǝ̀ tsǝk bu wun arǝì, wun nǝ̀ tsǝki wi npenye ɗàng.&gt;&gt; Ruben ngga bang anggo ace mǝnana nǝ̀ amsǝ Yisǝfu a buia, nǝ̀ tasǝ takwari ɓǝ̀ nyare aban tárrí ka.<verse eid="GEN 37:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 37:23" />Lang Yisǝfu yi bwalǝna ban amǝ'eambi ka, kara à swárì wi nggea-daura male, yì nggea-daura mǝ'ɓoarjamnì male man arǝì ka. <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />Pǝlǝa à twali à túrí aɓa tūli. Tūlinì ka ɓālǝi na kpokǝrok; ɓālǝi ka mǝ'ime na.<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />À ɓuntea à do à nǝ̀ lìli, sǝ lang à loasǝ mǝsǝia ka, à sǝn amǝ'fuli nǝ akalakadambi malea, à tsaɗi atārǝia aban yiu; amǝ'Ishmayel na à pur nǝ Gilǝyat. Twalo mǝnana a nzǝm akalakadambi malea ka lùmsǝ nǝ muku agir mǝ'rǝmɓoarne, andǝ mùrú-hasǝa mǝ'rǝmɓoarne, andǝ myang mala wal rǝkwangya andǝ kwanban. À nda mur njargula à nǝ̀ kánǝia a Masar.<verse eid="GEN 37:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 37:26" />Yahuda ne amǝ'eambi ama, &lt;&lt;Mana sǝm nǝ̀ kúmô mǝnana ɓǝ̀ sǝm wal-lú mǝ'eam sǝm, sǝm sǝmbǝrǝ cè ka? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />Ɓǝ̀ sǝm makkì amǝ'fuli mala amǝ'Ishmayel mǝno à kǝ yiu ka. Ɓǝ̀ sǝm kǝa tsǝki wi npenye ɗàng; kǝla yì ka nkila sǝm na ɗe andǝ nyam sǝm!&gt;&gt; Amǝ'eambi kara à earcau male.<verse eid="GEN 37:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 37:28" />Lang amǝ'Ishmayel, yia mǝnana amǝ'fuli mala nzali Midiyan na, à yiu à nǝ̀ kútí ka, amǝ'eam Yisǝfu nunni à pusǝì aɓa tūli, sǝ à makkia wia yì a kun gbatali boalo azǝrfa<note caller="+" style="f"><char style="fr" closed="false">37:28 </char><char style="fq" closed="false">gbatali boalo azǝrfa: </char><char style="ft" closed="false">boalo mǝnia ka à kǝ kárǝ́ki dǝmbǝrya nǝ kārǝa.</char></note> lumi-ɓari. Sǝ amǝ'fuli man twal Yisǝfu, à umnǝi a Masar.<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />Lang Ruben nyare wari a tūli, sǝ sǝni ka Yisǝfu pà kàm aɓalǝi raka, kara bwal daura male sannì.<note caller="+" style="f"><char style="fr" closed="false">37:29 </char><char style="fq" closed="false">kara bwal daura male sannì </char><char style="ft" closed="false">ko &lt;&lt;kara bumkiɗikea bwali kǝ̀rkǝ́r.&gt;&gt;</char></note> <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />Nyar aban amǝ'eambi, sǝ na ama, &lt;&lt;Munê pa kàm a tūli ɗang! Lang sǝ mǝ nǝ pa ado?&gt;&gt;<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />Pǝlǝa à twal nggea-daura mala Yisǝfu, à pari aɓa nkila mala muna-mbul mǝnana à pwan-myali ka. <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />À twal nggea-daura mǝ'ɓoarjamnì mǝnia ka, à wari nǝi aban tárrià sǝ à banggi wi ama, &lt;&lt;Sǝm kum daura mǝnia ka a ɓabondo. Ida, pelǝki wu sǝni ko nggea-daura mala munio na.&gt;&gt;<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />Lang sǝni ka kara súrǝì sǝ bang ama, &lt;&lt;Daura mala munem na! Ɓè nyam-bondo walni shangni! Munem Yisǝfu ka nyam-bondo sangini!&gt;&gt;<verse eid="GEN 37:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 37:34" />Bumkiɗikea atàcau mala muni tsǝk Yakupu bwal daura male sannì, pǝlǝa oasǝ asanginagìr arǝì. Twal anongŋo pas nda ban ɓua ace muni. <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />Amuni amuna-burana andǝ amuna-mamǝna kat yiu abani à nǝ̀ giriki, sǝ yì ka ɓinǝ girikiban. Bang ama, &lt;&lt;Awo, mǝ nǝ ɓua munem mǝ nǝ wǔ mǝ o atè a Shewol.<note caller="+" style="f"><char style="fr" closed="false">37:35 </char><char style="fq" closed="false">Shewol </char><char style="ft" closed="false">ka nda ɓanza mala alú.</char></note>&gt;&gt; Nda lidǝmba nǝ ɓua muni Yisǝfu ka.<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />Anggo ka amǝ'Midiyan amǝ'Fuli kya mangŋǝna Yisǝfu a Masar aban Potifa, ɓè mǝbuno mala Firona, murǝm Masar, gbani mala aɓwana-mǝgule mala amǝ'yáltà murǝm.<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">Tamar ɓosǝki Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />A ɓè bàkú ka, Yahuda nying amǝ'eambi pǝlǝa kutio o nǝ̀ nggá do atà ɓè ɓwabura ɓwa Adulam lùllǝì ama Hira. <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />A ban mǝno ka Yahuda je andǝ ɓè muna-ɓwama Kan'ana lùllǝ tárrí ama Shua. Al muna-ɓwame <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />sǝ ɓǝlî wi muna-ɓwabura. Tsǝkî munê lullǝu ama Er. <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />Nyare muna kpa a bumi sǝ ɓǝl ɓè muna-ɓwabura tsǝki wi lullǝu ama Onan. <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />Nyar ɗǝm ɓǝl ɓè muna-ɓwabura, sǝ tsǝki wi lullǝu ama Shela. Mǝnia ka a Kezip sǝ à ɓǝli.<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />Lang Er, yì muna-dǝmba mala Yahuda gulna ka, tárrí alì wi ɓwama. Lullǝ ɓwame ama Tamar. <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />Sǝ Er ka pàk gìr mǝnana mǝɓike na aban Mǝtalabangŋo ka; nda Mǝtalabangŋo wal-luí ka.<verse eid="GEN 38:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 38:8" />Anzǝm lú mala Er ka, Yahuda ne Onan ama, &lt;&lt;Kúti aban mā-lú mala mǝguleo. Lùmsǝ túró mô abani kǝla mǝ'eam burí, ace mǝnana mǝ'eambo ɓǝ̀ kum amuna nǝbano.&gt;&gt; <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />Sǝ Onan ngga earnǝ mǝno ka ɗàng acemǝnana sǝlǝna ama amunè ka à pà nǝ̀ duk amale ɗàng. Acemani ka ɓǝ̀ nda rǝ nongnǝ mā-lú mala mǝ'eambi ka nǝ̀ sukki mùr-ɓwabura a nza. Kǝ pê anggo ace mǝnana ɓwame ɓǝ̀ kǝa kum muna a bumi ɓǝ̀ ɓǝlî mǝ'eambi raka. <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />Gìr mǝno Onan pè ka, gìr mǝɓike na aban Mǝtalabangŋo; nda Mǝtalabangŋo walì wú gbal ka.<verse eid="GEN 38:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 38:11" />Yahuda pǝlǝa ne nkili Tamar ama, &lt;&lt;Nyar a ɓala aban tárró kya duk kàm kǝla mā-lú sheɓǝ̀ munem Shela gulna ka.&gt;&gt; Yahuda bang mǝno ka acemǝnana ɓangciu pàkki wi ama Shela nǝ̀ wú kǝla mǝnana amǝ'eambi wù ka. Nda Tamar o kya do a ɓala mala tárrí ka.<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />Anzǝm aɓea apǝlǝa ka mālá Yahuda, muna-ɓwama mala Shua, wú. Anzǝm mana Yahuda kumǝna girikiban ngga,<note caller="+" style="f"><char style="fr" closed="false">38:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 24:67">Tite 24:67</ref>; <ref loc="GEN 37:35">37:35</ref></char>.</note> lo wari a Timna, a ban mǝnana à kǝ mwaki wi nyang anzur male ka. Gyajam male Hira ɓwa Adulam wari atè.<verse eid="GEN 38:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 38:13" />Ɓè ɓwa banggi Tamar ama, &lt;&lt;Nkilo na a njar aban o a Timna nǝ̀ nggá bwalì aburana mana à kǝ mwaki wi nyang anzur male ka.&gt;&gt; <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />Tamar pǝlǝa swár anggūbyau-mā-lú male sǝ kùmsǝ nggubyau-koarǝu amurí ace ɓosǝki rǝì. Yi do a kún njarkutio a Enayim, ɓè là a njargula ká Timna. Yì ka sǝlǝna ama muna mǝkyauwe mala Yahuda, yì Shela ka gulna dumǝna ɓwabura, sǝ Yahuda pàk kǝgìr ace yinǝi ɓǝ̀ yi duk mālá Shela ɗàng.<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />Lang Yahuda nǝ̀ yia kutio sǝ sǝni ka, twali ama ɓè mā-gyatarǝu na, acemǝnana kùmsǝ ɓamǝsǝi. <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />Yahuda ka gandǝ sǝlǝa ama nkili na ɗang, pǝlǝa kàra abani a gírí njargula, sǝ ne wi ama, &lt;&lt;Ida, yiu mǝ kya kútí a bano.&gt;&gt;</para>
  <para style="p" vid="GEN 38:16">Pǝlǝa ɗì ama, &lt;&lt;Mana awu nǝ pam ace mǝnana wu kútí a banam ngga?&gt;&gt;<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />Bang ama, &lt;&lt;Mǝ nǝ túròban nǝ muna-mbul atà ambul mala domwan mem.&gt;&gt;</para>
  <para style="p" vid="GEN 38:17">Pǝlǝa ɗì ama, &lt;&lt;Sǝ ya gìr'kùrban na awu nǝ tsǝì mǝ bwali a buam bà a túrnaban nǝ muna-mbulni ka?&gt;&gt;<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />Yahuda bang ama, &lt;&lt;Ya ulang gìr'kùrban na a earce mǝ tsǝk ka?&gt;&gt;</para>
  <para style="p" vid="GEN 38:18">Eari wi ama, &lt;&lt;Pam gìrparbu mò andǝ nggurrì mǝnana gyar arǝì a myalo ka, andǝ gara-gya mò mǝnana a buo ka.&gt;&gt; Yahuda pè wi agir man.</para>
  <para style="p" vid="GEN 38:18">Pǝlǝa kútí a baní, sǝ muna kpa a bumi. <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />Tamar lo o a ɓala, kya swár lagìr koarǝu male sǝ oasǝ anggūbyau-mā-lú male ɗǝm.<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />Lang Yahuda nyarna a là ka, kya túr gyajam male Hira, ɓwa Adulam, nǝ muna-mbul ɓǝ̀ kyan nǝi ɓǝ̀ pè ɓwame sǝ ɓǝ̀ aki wi agir mǝnana pà ka. Sǝ lang Hira wari ka, kya kum ɓwame ɗàng. <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />Pǝlǝa ɗì ka aɓwana mǝnana à do a ban mǝno ka ama, &lt;&lt;Mā-gyatarǝu mǝnana dukiyi kani a kún njarkutio a Enayim ngga, nda ake?&gt;&gt;</para>
  <para style="p" vid="GEN 38:21">Sǝ yia ka à eari wi ama, &lt;&lt;Sǝm pànǝ ɓekǝ mā-gyatarǝu kani ɗang.&gt;&gt;<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />Nda Hira nyare sǝ banggi Yahuda ama, &lt;&lt;Ən kumi ɗàng, sǝ aɓwana mǝnana à duk kano ka à bang ama, ɓekǝ mā-gyatarǝu pà kàm a banì ɗàng.&gt;&gt;<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />Yahuda pǝlǝa bang ama, &lt;&lt;Ɗeki ɓǝ̀ bwal agirnì a buì. Ɓǝ̀ sǝm lidǝmba nǝ alte ka, sǝm nǝ̀ pǝlǝ gìr'oalban aban aɓwana. Mim ngga ǝn túrnì wi ban nǝ muna-mbul, a warina sǝ a kumi ɗàng.&gt;&gt;<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />Anzǝm zongŋo tàrú ka aɓwana yi banggi Yahuda ama, &lt;&lt;Nkilo Tamar ka kutina gyatarǝì, sǝ ado ka ndanǝ muna a bumi.&gt;&gt;</para>
  <para style="p" vid="GEN 38:24">Yahuda bang ama, &lt;&lt;Wu pusǝì ɓǝà pisǝì ɓǝ̀ wú!&gt;&gt;<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />Lang aɓwana wario à nǝ̀ pusǝì ka, Tamar túr ɓeɓwa aban nkili, nǝ cau ama, &lt;&lt;Ɓwabura mǝnana twàlâm muna ka nda mǝtala agir mǝnia ka. Ida, pelǝki wu sǝni ko a nǝ súrǝ̀ yana nda mǝtala gìrparbu andǝ nggurrì andǝ gara-gya mǝnia ka.&gt;&gt;<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />Yahuda yi súrǝ̀ agirnì sǝ na ama, &lt;&lt;Cau male ɓoaro kútì mem, acemǝnana ǝn pak ɓè kǝgìr ace mǝnana ɓǝ̀ yiu a ɓala aban munem Shela, ɓǝ̀ yi duk māmí kǝla mǝnana ǝn pacau ace ka ɗàng.&gt;&gt; Yahuda nyare nongnǝ Tamar ɗǝm ɗàng.<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />Lang zongŋo gbáshí bingŋǝna ka, amuna-pasa na mǝnana a bumi ka. <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />Lang nda rǝ gbáshí ka, mwashat atà pasa pusǝ bui a nza; mǝ'bwal-gbáshí pǝlǝa kùrî wi nkonggúr mǝbangŋe a garabui sǝ bang ama, &lt;&lt;Mǝnia ka nda tita puro ka.&gt;&gt; <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />Sǝ lang nyesǝ bui ka, mǝ'eambi yi puro. Mǝ'bwal-gbáshí pǝlǝa bang ama, &lt;&lt;Ani sǝ a yi sanban a puro!&gt;&gt; Nda tsǝki wi lullǝu ama Perez.<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="fq" closed="false">Perez </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">Sanban puro. </char></note> <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />Nǝnzǝ́mò ka mǝ'eambi mǝnana nǝ nkonggúr mǝbangŋe a garabui ka yi puro sǝ à tsǝki wi lullǝu ama Zera.<note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="fq" closed="false">Zera </char><char style="ft" closed="false">ka ɓālǝi nda </char><char style="fqa" closed="false">bángŋá mala pwari a tita puro male nǝ dǝmbari.</char></note> <note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="RUT 4:12">Rut 4:12</ref>; <ref loc="1CH 2:3-4">1Acau 2:3-4</ref>; <ref loc="MAT 1:3">Mat 1:3</ref></char>.</note><verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">Ɓakuli tsǝki Yisǝfu bù a Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />Amǝ'Ishmayel yinǝ Yisǝfu a Masar. Potifa ka nda ɓè mǝbuno mala Firona, murǝm Masar, gbani mala aɓwana-mǝgule mala amǝ'yáltà murǝm. Yì nda ɓwa mǝnana yi kúmó kúr Yisǝfu guro a bu amǝ'Ishmayel ka.<verse eid="GEN 39:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 39:2" />Mǝtalabangŋo na atà Yisǝfu. Koman kat pa aɓalǝ atúró male kǝla guro a ɓala mala mǝtala-ɓala male, yì ɓwa Masar ka, kǝ kum lidǝmba. <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />Lang mǝtala-ɓala mala Yisǝfu sǝni bu Mǝtalabangŋo na amur Yisǝfu, sǝ ɗǝm ngga Mǝtalabangŋo kǝ pe wi lidǝmba arǝ komana mǝnana kat nda a buì ka, <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />bumi pwasǝo arǝ Yisǝfu, pǝlǝa nyesǝi duk mǝkwaɗitè. Tsǝk Yisǝfu duk mǝɗenyi nǝ ɓala male, sǝ nyinggi wi agirkuma male kat a buì. <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />Twal a kǝ pwari mana nyesǝna ɓala male andǝ agirkuma male kat a ɓabù Yisǝfu ka, Mǝtalabangŋo tsǝki ɓala mala ɓwabura Masar bu àkǝ̀ cè Yisǝfu. Tsǝkbu mala Mǝtalabangŋo mǝnia ka do amur komana mǝnana kat mala Potifa na ka, a ɓala sǝ a ɓaban. <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />Nda Potifa nying komana kat ndanǝi ka a bu Yisǝfu ɓǝ̀ kǝ ɗenyi nǝia. Potifa nyare tsǝk ɓamúrì aɓa ɗenyi nǝ ɓe kǝgìr ɗǝm ɗàng. Kǝ girlina mǝnana nǝ̀ li ka nda nakiyice ka.</para>
  <para style="p" vid="GEN 39:6">Yisǝfu ka nda dwat, sǝ nggunrǝi ɓoaro, ɓoarjam pepè. <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />Banì sau ɗang mālá Potifa tita tsǝk mǝsǝi arǝ Yisǝfu. A ɓè pwari ka ne Yisǝfu ama, &lt;&lt;Yiu nongnǝ mim.&gt;&gt;<verse eid="GEN 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 39:8" />Sǝ Yisǝfu ka ɓinǝe, ne wi ama, &lt;&lt;Sǝni, Mǝtala-ɓala mem earnǝ mim, nying koman kat mana male na ka a buam. Kǝgìr oasǝi ɗǝm arǝ kǝgìr a ɓala ɗàng. <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />Kǝ ɓwa pà kàm atà amǝtúró a ɓala man kútiǎm nǝ gulo ɗang. Mǝtala-ɓala mem gìram nǝ kǝgìr ɗàng shekǝ we, acemǝnana a ndà māmí. Sǝ ado ka palang sǝ mǝ nǝ pàk mǝnia yì túró ɓealɓikea mǝgule ka, sǝ mǝ nǝ pàk cauɓikea aban Ɓakuli?&gt;&gt;<verse eid="GEN 39:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 39:10" />Ɓwama mǝnia lidǝmba nǝ pità Yisǝfu nǝ cau pwari-pwari, sǝ Yisǝfu ka ɓinǝ oki wi, ginggi wi zak, sǝ eare gbashì baní ɗàng.<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />Ɓè pwari ka, Yisǝfu wari a ɓaɓala ace pàkki atúró male, sǝ acili amǝtúró ka kǝ ɓwa pà kàm ateà a ɓala ɗàng. <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />Ɓwama man yiu yi gbami daura-múrɓì mala Yisǝfu, sǝ ne wi ama, &lt;&lt;Yiu nongnǝ mim!&gt;&gt; Yisǝfu gwamsǝ rǝì swárô nying daura-múrɓì male a bu ɓwame, ɓangŋa puro nying ɓala.<verse eid="GEN 39:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 39:13" />Lang ɓwama man sǝni Yisǝfu ɓàngŋǝ̀nà umǝna sǝ nyingŋǝna daura-múrɓì male a buì ka, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />pǝlǝa tunǝban, nda amǝ'túró-ɓala male ɓangŋa à yiu. Nea wia ama, &lt;&lt;Wu sǝni, burém yinǝ mǝnia yì guro ɓwa Ibǝru akani ace mana ɓǝ̀ yi ɓangginǝ sǝm! Ndya yiu yi kútí atàm a kurǝm ama nǝ̀ nongnǝ mim, nda ǝn mak'zwalo ka. <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />Lang oem ǝn loasǝ giem ǝn mak'zwalo ka, nda puro ɓangŋa o nying daura-múrɓì male a nkanggariam ngga.&gt;&gt;<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />Pǝlǝa ɓwama man nyesǝ daura-múrɓì tsǝì abani bà nyare mala burí a ɓala. <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />Lang burí yina ka, twal cê banggi wi ama, &lt;&lt;Mǝno yì guro ɓwa Ibǝru a yina sǝm nǝi ka, yi kútí atàm a kurǝm ama nǝ̀ ɓangginǝ mim; <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />sǝ lang ǝn loasǝ giem ǝn mak'zwalo ka, kara sarǝa mire o nying daura-múrɓì male abanam, purî ɓala.&gt;&gt;<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />Lang mǝtala-ɓala male ok cau mǝnia māmí banggi wi amur gir mǝnana Yisǝfu pè ka, kara bumi lul kǝ̀rkǝ́r. <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />Mǝtala-ɓala mala Yisǝfu pǝlǝa twal Yisǝfu umnǝi kya túrí a ndàkurban, a ban mǝnana à kǝ tsǝk apusǝna mala murǝm kàm ngga. Yisǝfu ueo kano a ndàkurban. <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />Sǝ Mǝtalabangŋo ka nda atè; sǝntǝ̀r mala Yisǝfu pǝlǝa pè wi múrɓoarna a mǝsǝ ɓwamǝgule mala túró yál ndàkurban. <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />Ɓwamǝgule mala túró yál ndàkurban tsǝk Yisǝfu amúr aɓwana mana kat à kàsǝ̀kúnià a ndàkurban ngga ɓǝ̀ kǝ ɗenyinǝia, sǝ nyinggi wi ɓǝ̀ kǝ sǝntà koya túró mǝnana kat à kǝ pè a ban mǝno ka. <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />Ɓwamǝgule mala túró yál ndàkurban nyare tsǝk ɓamúrì aɓa ɗenyi nǝ ɓè kǝgìr ɗǝm mǝnana nyingŋǝ́nì Yisǝfu a buì ka ɗàng. Mǝtalabangŋo ka nda atà Yisǝfu sǝ pè wi lidǝmba aɓa koman mǝnana kat kǝ pàk ka.<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">Yisǝfu mǝngi ɓalǝ alorǝo ɓari</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />Anzǝmi bǝti ka, ɓwamǝgule mǝ'pa-girnùná, andǝ ɓwamǝgule mǝ'lurǝgìr mala Murǝm Firona ka à pàk mǝɓane. <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />Bum Firona lul kǝ̀rkǝ́r arǝ amǝbuno man ɓari, yì a ɓwamǝgule mǝ'pa-girnùná, andǝ ɓwamǝgule mǝ'lurǝgìr. <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />Pǝlǝa tasǝtea a ndàkurban a ɓala mala ɓwamǝgule mala amǝ'yál murǝm, àkǝ̀ ban mǝnana à oasǝ Yisǝfu kàm ngga. <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />Bania sauwa aɓa ndàkurban, sǝ ɓwamǝgule mala túró yál ndàkurban tsǝk Yisǝfu ɓǝ̀ duk guro mala ɗenyi nǝ aburana man ɓari ka.<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />Aɓa du mwashat ka aburana mǝnia, yia ɓwamǝgule mǝ'pa-girnùná, andǝ ɓwamǝgule mǝ'lurǝgìr mala murǝm Masar, yia kǝm à lòrǝo sǝ koyan ngga ɓá lòrǝo male ka nda ɗàng.<verse eid="GEN 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 40:6" />Lang Yisǝfu wari abania nǝ dǝmbari yi sǝnia ka, à nda ɓá bumkiɗikea. <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />Pǝlǝa ɗì aɓwana-mǝgule mala murǝm Firona mǝnana à nda a ndàkurban andǝi a ɓala mala mǝtala-ɓala male ka ama, &lt;&lt;Márǝ̀ wun sǝ wu kùrɓamǝsǝ wun anggo yalung?&gt;&gt; <verse eid="GEN 40:7" /><verse number="8" style="v" sid="GEN 40:8" />À pè wi eare ama, &lt;&lt;Alorǝo na sǝm lòrǝ̀ ka sǝ kǝɓwa pà kàm nǝ̀ mǝngia sǝm ɓālǝia ɗàng.&gt;&gt;</para>
  <para style="p" vid="GEN 40:8">Yisǝfu pǝlǝa nea wia ama, &lt;&lt;Mǝngi ɓalǝ alorǝo ka Ɓakuli na pākiyi ka re? Ida, wu nam alorǝè.&gt;&gt;<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />Pǝlǝa ɓwamǝgule mǝ'pa-girnùná ne Yisǝfu lòrǝo male ama, &lt;&lt;Aɓa lòrǝo mem, ǝn sǝni ka, nggun anap, na a ɓadǝmbam; <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />sǝ yì nggun anap ka ndanǝ abui tàrú. Lang ambui nǝ̀ to ka, pǝlǝa sak pwasǝe sǝ adangŋanshi ɓǝle kya bángŋá. <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />Kap nugìr mala murǝm ngga nda a buam, pǝlǝa ǝn kasǝ mwashat atà adangŋanshi ɓǝla anap ǝn kam mùrì aɓa kap, sǝ ǝn pê murǝm a bui.&gt;&gt;<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />Yisǝfu ne wi ama, &lt;&lt;Ɓá lòrǝê ndya ka: abu-nggun tàrú ka nongŋo tàrú na. <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />Anzǝm nongŋo tàrú ka, murǝm nǝ̀ twalôbanì, nǝ̀ nyesǝo a bancame mò mana ɗiɗyal ka. A nǝ nggǝ pê Murǝm kap nugìr male a buì kǝla mana ɗiɗyal a nda mǝ'pa-girnùná male ka. <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />Sǝ ǝn nggǝ zǝmbô, ɓǝ̀ agir ɓoarno ka ɗenyi nǝ mim. Ida, kya nacem a ɓadǝm murǝm ace mǝnana ɓǝ̀ pusǝam ɓǝ̀n purì ɓá ndàkurban man. <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />À iuwam nǝ iuwe a nzali mem, nzali mala amǝ Ibǝru, sǝ akani a Masar ka, ǝn pak kǝgìr mǝnana tsǝa à nǝ̀ oasǝam a ndàkurban ace ka ɗàng.&gt;&gt;<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />Lang ɓwamǝgule mǝ'lurǝgìr sǝni mǝngi ɓá lòrǝo mǝno ɓoar ka, pǝlǝa ne Yisǝfu ama, &lt;&lt;Mim gbal aɓa lòrǝo mem ngga, ǝn sǝni ka, ǝn twal azace bǝredi tàrú aɓalǝarǝia amuram. <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />Aɓa zace mǝnana amur aɓi ka, agirlina nakam ɗàngɗáng mǝnana à lurǝì murǝm ngga, sǝ anyal sulǝo à kǝ fwakia amuram à kǝ lia.&gt;&gt;<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />Yisǝfu ne wi ama, &lt;&lt;Ɓá lòrǝo mò ndya ka: azace tàrú ka anongŋo tàrú na. <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />Aɓa nongŋo tàrú ka murǝm nǝ̀ kasǝ ɓamuro sǝ nǝ̀ gyar nggunrǝo a nggun, sǝ anyal nǝ̀ yiu à nǝ̀ fwaki nyam rǝo.&gt;&gt;<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />A tàruià nongŋo, mǝnana nda pwari ɗenyinǝ ɓǝlban mala Firona ka, Firona gilǝki do mala lì girlina banɓoarnado ace amǝ'tè andǝ amǝ'túró male kat. Túrban ɓǝà kya pusǝ ɓwamǝgule mǝ'pa-girnùná, andǝ ɓwamǝgule mǝ'lurǝgìr male ɓǝà yinǝia a ɓadǝm acili amǝ'tè. <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />Nyesǝ ɓwamǝgule mǝ'pa-girnùná a bancame male, ace mǝnana ɓǝ̀ lidǝmba nǝ túró male mala pè murǝm girnùná, <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />sǝ ɓwamǝgule mǝ'lurǝgìr ka à wal-luí. Agir mǝno kat yi pa anggo kǝla mǝnana Yisǝfu bang ngga. <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />Kat andǝ mani ka, ɓwamǝgule mǝ'pa-girnùná ka ɓālǝi kasǝ arǝ Yisǝfu ɗàng; ɓālǝi lorǝi.<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">Yisǝfu mǝngi ɓalǝ alorǝo mala Firona</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />Anzǝm mana pǝlǝa ɓari lùmsǝna ka, Firona murǝm Masar lòrǝ̀ ama cam a kún Nggeasala Nayel. <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />Aɓa lòrǝo male ka, sǝn andá tongno-nong-ɓari amǝ'nyange ɓùlɓùl, à pùr aɓa mùr sǝ à kǝ li bondo mǝpwale a kún nggeasala. <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />Pǝlǝa sǝn aɓea andá tongno-nong-ɓari, aman ngga amǝ'eamdǝke kwakǝɗak na. À pùr aɓa mùr à yi cam a kún nggeasala a nkanggari amǝ'nyange mǝno. <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />Kara andá amǝ'eamdǝke kwakǝɗak mǝnia shak amǝ'nyange ɓùlɓùl mǝno. Pǝlǝa mǝsǝ Firona sapî ntulo.<verse eid="GEN 41:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 41:5" />Ntulo nyare e, sǝ lòrǝ̀ ɗǝm; sǝni ka kuri-mǝssa mwashat nǝ amur-mǝssa tongno-nong-ɓari amǝɓoarne, amǝɓǝle aban gulo amurí. <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />Nǝnzǝ́mò ka nyare sǝn aɓea amur-mǝssa tongno-nong-ɓari amǝkwetǝke mǝnana gùngpi mala takuli imsǝia kaksǝkǝrak ka, à yi to. <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />Sǝ amur-mǝssa amǝkwetǝke mǝnia ka à yi myal amur-mǝssa amǝɓoarne, amǝɓǝle mǝno. Mǝsǝ Firona sak a ntulo sǝ yi sǝlǝ ama lòrǝo na.<verse eid="GEN 41:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 41:8" />Ban yi fana ka ɗenyicau mala Firona zurì, nda túrban ɓǝà tunǝ amǝ'pakki agir nggár andǝ amǝ'sǝlǝe mala nzali Masar. Firona nea wia alorǝo male, sǝ kǝ ɓwa ateà gandǝ mǝngi wi ɓalǝ alorǝo male ɗàng.<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />Pǝlǝa ɓwamǝgule mǝ'pa-girnùná mala Firona banggi Firona ama, &lt;&lt;Yalung ngga ɓalǝam kasǝna arǝ gatti mem. <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />A ɓè pwari mana kútí ka, bum Murǝm lúllô arǝ aguro male sǝ tasǝta sǝm a ndàkurban, mim sǝnǝ ɓwamǝgule mǝ'lurǝgìr, a ɓala mala ɓwamǝgule mala amǝ'yáltà murǝm. <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />A ɓè du mwashat koyan atà sǝm ngga lòrǝo, sǝ ɓalǝ alorǝe ka à nda ɗàngɗáng. <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />Ɓè mǝlagga ɓwa Ibǝru, guro mala ɓwamǝgule mǝ'yáltà murǝm nakam atà sǝm. Sǝm ne wi alorǝo ma'sǝm, sǝ mǝngia sǝm ɓālǝia. <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />Anggo sǝ yi lùmsǝó kǝla mǝnana bangga sǝm ngga: à nyesǝam a bantúró mem, sǝ mǝ'lurǝgìr ka à gyari a nggun.&gt;&gt;<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />Pǝlǝa Firona túrban ɓǝà kya pusǝ Yisǝfu aɓa ndàkurban ɓǝà yinǝi tsuk-tsuk. Sǝ anzǝm mana Yisǝfu mwana-mwâ ka, nggaɗi agir'ngūrǝì sǝ o a ɓadǝm Firona.<verse eid="GEN 41:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 41:15" />Firona ne Yisǝfu ama, &lt;&lt;Ən lorǝ lorǝo sǝ kǝ ɓwa gandǝ mǝngiàm ɓālǝi ɗàng. Sǝ ǝn ok ama ɓǝà nô lòrǝo ka, a kǝ gandǝ mǝngi ɓālǝi.&gt;&gt;<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />Yisǝfu pǝlǝì Firona ama, &lt;&lt;Mǝ nda ǝn pakkiyi ka ɗàng, sǝama Ɓakuli ka nǝ̀ mǝngio ɓá lòrǝo mô.&gt;&gt;<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />Firona ne Yisǝfu ama, &lt;&lt;Aɓa lòrǝo mem, ǝn sǝni ka, mǝ nda aban came a kún Nggeasala Nayel. <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />Ən sǝn andá tongno-nong-ɓari amǝ'nyange ɓùlɓùl, à pur aɓa mùr sǝ à tita li bondo mǝpwale a kún nggeasala. <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />Nyare ǝn sǝn aɓea andá tongno-nong-ɓari amǝ'eamdǝke kwakǝɗak. Ən malaká sǝn ulang andá amǝ'ɓikijamnì kǝla amǝno a ɓè kǝban aɓa nzali Masar ɗàng. <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />Amǝnia yì aɓikina andá tongno-nong-ɓari amǝ'eamdǝke ka, à shak amǝ'nyange mǝno ǝn sǝnia a dǝmba ka. <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />Sǝ anzǝm mǝnana à shanŋǝnia ka, kǝ ɓwa pà nǝ̀ sǝlǝ ama à shangŋǝna amǝ'nyange mǝno ka ɗang, acemǝnana à ndakam akǝ banì kwakǝɗak. Pǝlǝa mǝsǝam sapî ntulo.<verse eid="GEN 41:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 41:22" />&lt;&lt;Aɓa lòrǝo mem ɗǝm, ǝn sǝni ka, kuri-mǝssa mwashat pusǝ amur-mǝssa tongno-nong-ɓari amǝ'ɓoarne mǝnana à ɓǝl gbatsǝkǝrak ka. <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />Nyare ǝn sǝni ɗǝm ngga aɓea amur-mǝssa tongno-nong-ɓari amǝkwetǝke yi puro. Amǝnia ka gùngpi ɓá pǝɗanban imsǝnia katsak. <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />Kara amur-mǝssa amǝkwetǝke mǝnia myal amǝɓoarne mǝno.</para>
  <para style="p" vid="GEN 41:24">&lt;&lt;Ən banggi amǝ'pakki agir nggár lòrǝê, sǝ kǝ ɓwa ateà gandǝ mǝngiàm ɓālǝi ɗàng.&gt;&gt;<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />Pǝlǝa Yisǝfu ne Firona ama, &lt;&lt;Alorǝo mò ka à nda mwashat. Ɓakuli lǝmdǝnò gìr mǝnana kǝ earce pê ka. <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />Amǝno yì andá amǝ'nyange tongno-nong-ɓari ka, apǝlǝa tongno-nong-ɓari na, sǝ amur-mǝssa mǝɓoarne mǝno tongno-nong-ɓari ka, apǝlǝa tongno-nong-ɓari na. Alorǝè ka à nda mwashat. <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />Andá amǝ'eamdǝke mǝno tongno-nong-ɓari mǝnana à pur nǝnzǝ́mò, andǝ amur-mǝssa amǝkwetǝke mǝno gùngpi ɓá pǝɗanban tsǝia à wulì sǝ imsǝia ka, apǝlǝa tongno-nong-ɓari mala nzal-gula na. <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />Kǝ ndo kǝla mǝnana ǝn banggo ka, Murǝm: Ɓakuli lǝmdǝnò we Murǝm, gìr mǝnana ndo nǝ̀ pè ka. <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />Apǝlǝa tongno-nong-ɓari mǝnana Ɓakuli nǝ hatǝki nzali Masar nǝ girlina ka, à nda aban yiu. <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />Sǝ anzǝmi ka, nzal-gula nǝ̀ kpa aɓa nzali Masar aɓa pǝlǝa tongno-nong-ɓari, mǝnana nǝ̀ tsǝa à nǝ̀ lorǝce kume mala nzali Masar ka. Nzal-gulê nǝ̀ kiɗiki nzali Masar. <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />Nzal-gulê nǝ̀ ɓikipa mǝnana nǝ̀ tsǝa à nǝ̀ lorǝce hatǝki mala girlina a Masar. <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />À ɓǝsǝlǝò lorǝê kusǝ ɓari ace lǝmdǝ ama Ɓakuli kasǝna cê ama, mǝno nda gìr mǝnana zuku ka nǝ̀ kumban ngga.<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />&lt;&lt;Acemani ka, ɓǝ̀ Murǝm tàr ɓwa mwashat, mǝnana ndanǝ sǝlǝe andǝ sǝndǝmba ka, ɓǝ̀ tsǝì amur nzali Masar. <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />Ɓǝ̀ tsǝk aɓea aɓwana-mǝgule mǝnana à nǝ̀ nggǝ ak kāmbe mwashat aɓa tongno mala agirɓaban mǝnana à nǝ̀ kum aɓalǝ apǝlǝa tongno-nong-ɓari mala kum ɗǝmbo ka. <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />Ɓǝ̀ tsǝia ɓǝà ram girlina mǝnana kat à nǝ̀ kúmô aɓalǝ apǝlǝa mǝɓoarne mǝnana àkǝ yiu ka, sǝ ɓǝ̀ pea wia rǝcandǝa nǝ bu Murǝm ɓǝà tsǝk mǝsǝsa arǝ abah ace kum girlina a là, sǝ ɓǝà tsǝkir girlinê. <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />Mǝnia yì girlina ka à nǝ̀ tsǝì ace kum girlina mǝnana nǝ̀ karǝ aɓwana aɓalǝ apǝlǝa tongno-nong-ɓari mala nzal-gula mǝnana kǝ yiu amur nzali Masar ka. Anggo sǝ nzala pa nǝ̀ twalta aɓwana ɗàng.&gt;&gt;<verse eid="GEN 41:36" /></para>
  <para style="s">Yisǝfu duk nggwamna mala nzali Masar</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />Firona andǝ amǝtè kat ka, à earnǝ cau mǝnana Yisǝfu banggia wia ka. <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />Firona pǝlǝa ɗì amǝtè ama, &lt;&lt;Yana sǝm nǝ̀ kúmô mǝnana nǝ̀ kútì ɓwa man, mǝnana Bangŋo mala Ɓakuli na aɓalǝi ka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">41:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 31:3">Pur 31:3</ref>; <ref loc="EXO 35:31">35:31</ref>; <ref loc="JDG 6:34">Akas 6:34</ref>; <ref loc="JDG 14:6">14:6</ref>; <ref loc="1SA 10:6">1Sam 10:6</ref>; <ref loc="1SA 16:13">16:13</ref>; <ref loc="ISA 11:2">Isha 11:2</ref>; <ref loc="DAN 5:14">Dan 5:14</ref></char>.</note> <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />Pǝlǝa Firona ne Yisǝfu ama, &lt;&lt;Ɓakuli na lǝmdǝo mǝnia yì agir kat ka, kǝ ɓwa pà kàm ndanǝ sǝlǝe andǝ súrǝ̀gir kǝla we ɗang. <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />A nda mana mǝ nǝ tsǝo amur nzali mem ngga. Cau mǝnana pur a kuno ka, nda aɓwana mem nǝ̀ kpate ka. Kǝ mim Firona murǝm, nda mǝnana mǝ nǝ kútiǒ nǝ gulo ka.&gt;&gt;<verse eid="GEN 41:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 41:41" />Sǝ Firona ne Yisǝfu ama, &lt;&lt;Ado ka ǝn tsǝ́ngŋǝ̀nó a nda nggwamna amur nzali Masar kat.&gt;&gt; <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />Pǝlǝa Firona pusǝ gbalmo-gulo male mǝnana a munabuì ka, oasǝì Yisǝfu a munabuì, sǝ turì wi daura nggubyau-linǝn mǝ'ɓoarjamnì arǝì sǝ oasǝi wi nlang bolo-njengǝlan a myali. <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />Firona eamsǝi aɓa ɓaria waru-pǝr mala murǝm, sǝ à kǝ hamnǝi a ɓadǝmbi ama, &lt;&lt;Wu ɓunno amur ankūnǝ wun!&gt;&gt; Anggo sǝ tsǝì duk nggwamna amur nzali Masar kat.<verse eid="GEN 41:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="GEN 41:44" />Firona ne Yisǝfu ɗǝm ama, &lt;&lt;Mǝ nda murǝm, sǝ kǝɓwa pà nǝ̀ loasǝ bui ko nǝ̀ twal kusǝì a nzali man ɗang she nǝ cau mǝnana pur a kuno ka.&gt;&gt;<verse eid="GEN 41:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 41:45" />Pǝlǝa Firona tsǝki Yisǝfu lullǝu mala amǝ Masar ama, Zafǝnat-Panǝya,<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="fq" closed="false">Zafǝnat-Panǝya </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ɓakuli nacau sǝ cê pàngnǝ yilǝmu.&gt;&gt;</char></note> sǝ pè wi Asenat,<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="fq" closed="false">Asenat </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Mala Ɓakuli.&gt;&gt;</char></note> ɓoarnsarile Potifera, ɓè pǝris mala ndà-peri a nggea-là On, ɓǝ̀ duk māmí. Nda aɓwana zǝ̀kìce Yisǝfu aɓa nzali Masar kat.<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />Yisǝfu ka ndanǝ pǝlǝa lumi-tàrú sǝ tita túró a ban Firona murǝm Masar. Firona pè Yisǝfu túró a buì, sǝ pè wi gara ɓǝ̀ duk nggwamna amur nzali Masar kat.<note caller="+" style="f"><char style="fr" closed="false">41:46 </char><char style="fq" closed="false">Firona pè Yisǝfu túró a buì, sǝ pè wi gara ɓǝ̀ duk nggwamna amur nzali Masar kat. </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">Yisǝfu pǝlǝa nying ɓadǝm Murǝm sǝ twal gya mala pelǝki abân a koya buban mala nzali Masar kat. </char></note><verse eid="GEN 41:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="GEN 41:47" />Aɓalǝ apǝlǝa tongno-nong-ɓari mala ɗǝmbo ka, nzali pusǝ girlina kǝ̀rkǝ́r. <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />Sǝ aɓalǝ amǝno yì apǝlǝa ka, Yisǝfu ram girlina mǝnana à rì aɓa nzali Masar ka. A koya nggea-là ka, à so mǝsǝsa mǝnana à pusǝì arǝ aɓaban malea ka aɓalǝ abah. <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />À gwali mǝsǝsa kǝla sala mǝnana a kún nggeamùr ka, gandǝa Yisǝfu tamsǝ kārǝki gìr mǝnana aɓwana kǝ yinǝi ka. Girlina ramba à gandǝ ɓallè ɗàng.<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />Kaniama apǝlǝa mala nzala nǝ̀ yiu ka, Yisǝfu kum amuna-burana ɓari, mǝnana Asenat nsari mala Potifera, pǝris mala On ɓǝlî wi ka. <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />Yisǝfu tsǝkî muna-dǝmba male lullǝu ama Manasa,<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="fq" closed="false">Manasa </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;ɓalǝam lorǝna.&gt;&gt;</char></note> acemǝnana bang ama, &lt;&lt;Ɓakuli tsǝ́ngŋǝ̀nà ɓalǝam lorǝna tanni mem andǝ ɓala mala tárrám.&gt;&gt; <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />Ɓaria muna-ɓwabura ka, Yisǝfu tsǝki wi lullǝu ama Ifǝrem,<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="fq" closed="false">Ifǝrem </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;do nǝ ɓǝlmuna.&gt;&gt;</char></note> acemǝnana bang ama, &lt;&lt;Ɓakuli panam amuna a nzali tanni mem.&gt;&gt;<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />Apǝlǝa tongno-nong-ɓari mala hatǝki mala girlina a nzali Masar yiu a masǝlǝate, <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />sǝ apǝlǝa mala nzal-gula tite, kǝla mǝnana Yisǝfu bang ngga. Nzala kpa arǝ aɓea anzali kat, sǝ aɓa nzali Masar kat ka, girlina na kam kǝ̀rkǝ́r. <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />Lang nzala kútí arǝ amǝ Masar ka, à warinǝ ɓua malea aban Firona murǝm ace girlina. Firona murǝm banggia wia ama, &lt;&lt;Wu kya ban Yisǝfu, sǝ gìr mana kat bangga wun ngga, wu pè.&gt;&gt; <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />Lang nzala akinaban kat aɓa nzali ka, pǝlǝa Yisǝfu mǝngi abân tsǝk agirlina kat, sǝ makki amǝ Masar girlina, acemǝnana nzala ɓikina aɓa nzali Masar. <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />Aɓwana arǝ abân a bum ɓanza kat yiu a Masar ace kúr girlina aban Yisǝfu, acemǝnana nzala akina ɓanza kat.<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">Amǝ'eam Yisǝfu yiu a kúr girlina a Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />Lang Yakupu ok ama mǝsǝsa na a Masar ka, ne amuni ama, &lt;&lt;Palang sǝ wu kǝ sǝngi rǝarǝ wun? <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />Ən ok ama mǝsǝsa kúró na a Masar. Wu o wu kya kúr mǝsǝsa ace mǝnana ɓǝ̀ sǝm apî nzala, ɓǝ̀ ana raka ndo sǝm nǝ̀ wukio.&gt;&gt;<verse eid="GEN 42:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 42:3" />Pǝlǝa amǝ'gula Yisǝfu yia lum, à wari a Masar a kúr mǝsǝsa. <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />Sǝ Yakupu ka earî Benjami, mǝ'kyauwa Yisǝfu ɓǝ̀ o ateà ɗàng, acemǝnana ǝn'ò kǝ pakki tárrí cè ɓè kǝgir mǝɓane kum muna ɗàng.<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />Nda amuna-burana mala Yakupu wario andǝ aɓea aɓwana a Masar ace kúr girlina ka, acemǝnana nzala kpana gbal a nzali Kan'ana.<verse eid="GEN 42:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 42:6" />Sǝ acemǝnana Yisǝfu nda nggwamna mala Masar sǝ nda mǝnana makkiyi aɓwana girlina ka, amǝ'eambi wari a baní, à kya ɓunno a ɓadǝmbi nǝ ɓamǝsǝia a nzali. <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />Lang Yisǝfu sǝn amǝ'eambi ka, kara súrǝ̀ia sǝ pa kǝla súrǝ̀ia ɗàng, kǝ nea wia cau nǝ lúllô. Ɗia ama, &lt;&lt;Wu pur a ya la?&gt;&gt;</para>
  <para style="p" vid="GEN 42:7">À pe wi eare ama, &lt;&lt;Sǝm pur a nzali Kan'ana, sǝm yiua kúr girlina.&gt;&gt;<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />Yisǝfu ka súrǝ̀ amǝ'eambi, sǝ yia ka à súrǝì ɗàng. <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />Ɓalǝ Yisǝfu kasǝ arǝ alorǝo male amúrià apǝlǝa pas mana à kutiki ka, sǝ nea wia ama, &lt;&lt;Wun nda ka amǝ'shenzǝ-nzali, wu yiua sǝn fě mala nzali ma'sǝm.&gt;&gt;<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />Sǝ à pǝlǝi wi ama, &lt;&lt;Awo, ɓwamǝgule, sǝm yiu kǝla aguro mò, girlina na sǝm yiua kúrè ka. <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />Sǝm kat ka sǝm nda ka amuna mala ɓwa mwashat, sǝm nda ka amǝ'shenzǝ-nzali ɗang ɓwamǝgule, sǝm nda ka aɓwana amǝ'ɓafoe.&gt;&gt;<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />Yisǝfu pǝlǝia wia ama, &lt;&lt;Ən earnǝ wun ɗàng! Wu yiua sǝn fě mala nzali ma'sǝm.&gt;&gt;<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />Sǝ à pǝlǝi wi ama, &lt;&lt;Ɓwamǝgule, sǝm aguro mò ka, sǝm nda ka amuna-burana lum-nong-ɓari a bù tár sǝm a nzali Kan'ana. Mǝtankwang ma'sǝm ngga nda andǝ tár sǝm a là ado, sǝ ɓè mǝ'eam sǝm mwashat ka wuna.&gt;&gt;<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />Yisǝfu pǝlǝia wia ama, &lt;&lt;Kǝla mǝnana ǝn na ka: Wun ngga wu nda ka amǝ'shenzǝ-nzali! <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />Ani sǝ mǝ nǝ súrǝ̀ mǝsǝcau: Mbak-kàngkàng Firona nakam ngga, pà wu nǝ nying Masar ɗàng sheɓǝ̀ wu yina nǝ mǝ'kyauwa wun ngga! <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />Wu túr mwashat aɓalǝ wun ɓǝ̀ kya yinǝ mǝ'kyauwa wun; cili wun ngga mǝ nǝ gìr wun a ndà, she ɓǝ̀ cau mǝnana wu na ka, yi purna ama mǝsǝcau na ka. Ɓǝ̀ ana raka ǝn kánbà wun nǝ yilǝmi Firona, wun nda ka amǝ'shenzǝ-nzali!&gt;&gt; <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />Pǝlǝa gìria a ndà nongŋo tàrú.<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />A tàruià nongŋo ka, Yisǝfu nea wia ama, &lt;&lt;Mim ngga ǝn nggǝ ɓanggi Ɓakuli. Gìr mwashat na wun nǝ̀ pa sǝ mǝ nǝ nying wun nǝyilǝmu ka. <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />Ɓǝ̀ wu nda ka aɓwana amǝ'ɓafoe ka, wu tàr ɓwa mwashat aɓalǝ wun ɓǝ̀ ueo kani a ndàkurban, sǝ cili wun ngga wu umnǝ girlina aban amǝ'ɓala ma'wun mǝnana à nda aɓa nzala ka. <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />Sǝ dumǝna púp wun nǝ̀ yinǝ mǝ'kyauwa wun abanam, ace mǝnana ɓǝ̀n sǝlǝ ama mbak-kàngkàng wu nda aban na mǝsǝcau, sǝ pà mǝ nǝ wal-lú wun ɗàng.&gt;&gt; Sǝ yia ka à ear ama à nǝ̀ pa anggo.<verse eid="GEN 42:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 42:21" />Sǝ à ne arǝia ama, &lt;&lt;Mǝsǝcau gìr mǝɓane mǝnana sǝm pakkî mǝ'kyauwa sǝm ɗiɗyal ka, nda mǝno sǝm nggǝ kum tangnakusǝu tanni male ka. A bàkú mǝno ka sǝm sǝn tanni mǝnana nda aɓalǝi, mana kǝ ɓua kǝ zǝmba sǝm, sǝ sǝm ginǝ oě ka; nda gìr mǝnana tsǝa sǝ tanni mǝnia sulǝo amur sǝm ngga.&gt;&gt;<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />Pǝlǝa Ruben nea wia ama, &lt;&lt;Ən bangga wun a pwari mǝno nǝma wu kǝa tsǝk bù arǝ muna man ama wun nǝ̀ pàkkî wi cauɓikea ɗang sǝ wu ginǝe! Ado ka dumǝna púp sǝm nǝ̀ mbwe nkila male mǝnana sǝm sukki ka.&gt;&gt; <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />Yia ka à sǝlǝ ama Yisǝfu kǝ ok cau mǝnana à kǝ na ka ɗàng, acemǝnana ɓè ɓwa na Yisǝfu yinǝi kǝ nyesǝia wia cau nǝ kún malea ka. <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />Yisǝfu gǝshì bania sǝ sukki mǝrǝm, pǝlǝa imsǝ mǝsǝi sǝ nyar abania nea wia cau. Pǝlǝa tsǝa à bwal Shimiyon à taka abui akǝ ɓadǝmbia.<verse eid="GEN 42:24" /></para>
  <para style="s">Amǝ'eam Yisǝfu nyare a Kan'ana</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />Yisǝfu pǝlǝa ne amǝ'túró male ɓǝà lùmsǝki abuku mala amǝ'eambi nǝ mǝsǝsa sǝ ɓǝà nyesǝî koya ɓwa ka boalo male mǝnana pǎ ace kúr mǝsǝsa ka aɓa buku male, sǝ ɓǝà pea wia girlina mǝnana à nǝ̀ li aban o a njar ka. Anggo gbal sǝ à pakkia wia. <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />À tsǝk abuku mǝsǝsa malea a nzǝm amǝdambǝriso malea sǝ à kpa a njar.<verse eid="GEN 42:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 42:27" />Lang à yi bwalǝna ban mǝnana à nǝ̀ nong kam ngga, ɓè ɓwa ateà mǝn kún buku male nǝ̀ pè mǝdambǝriso male girlina, kara sǝni ka boalo male na a kún buku. <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />Ne amǝ'eambi ama, &lt;&lt;À nyesǝnàm boalo mem. Wu sǝni, ndya aɓa buku mem ngga!&gt;&gt;</para>
  <para style="p" vid="GEN 42:28">Ɓabumia yasǝlǝia, ɓangciu pakkia wia pǝlǝa à ɗì rǝia ama, &lt;&lt;Ya gìr na mǝnia Ɓakuli pakka sǝm ngga?&gt;&gt;<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />Lang à yi bwalna ban tárrià a nzali Kan'ana ka, à twal cau mala gìr mǝnana kumia kat ka à ne wi. À bang ama, <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />&lt;&lt;Ɓwabura mǝnana nda nggwamna amur nzali Masar ka na sǝm cau nǝ pekiban ama sǝm nda ka amǝ'shenzǝ-nzali malea. <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />Sǝm ne wi ama, sǝm nda ka aɓwana amǝ'ɓafoe, sǝm nda ka amǝ'shenzǝ-nzali ɗang. <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />Sǝm ngga sǝm nda lum-nong-ɓari a bu tár sǝm, mwashat wuna, sǝ mǝtankwang ma'sǝm ngga nda a ban tár sǝm a nzali Kan'ana.&gt;&gt;<verse eid="GEN 42:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 42:33" />Pǝlǝa ɓwabure mǝnana nda nggwamna mala nzalinì ka na sǝm ama, &lt;&lt;Gìr mǝnana wun nǝ̀ pa sǝ mǝ nǝ earnǝ wun ngga nda mǝnana ama, wun nǝ̀ nying mǝ'eam wun mwashat abanam, sǝ cili wun ɓǝ̀ umnǝ girlina aban amǝ'ɓala ma'wun mǝnana aɓa nzala ka. <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />Wu kya yinǝ mǝtankwang ma'wun abanam. Anggo sǝ mǝ nǝ ear ama wun nda ka aɓwana amǝ'ɓafoe, wu yiua shenzǝ-nzali ɗang. Pǝlǝa mǝ nǝ panzǝà wun mǝ'eam wun, sǝ wun nǝ̀ lidǝmba nǝ kúró a nzali ma'sǝm.&gt;&gt;<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />Lang koyan ngga ndaban solǝki mǝsǝsa mana aɓa buku male ka, à sǝni ka, koya ɓwa ka boalo male mǝnana pà ace kúr mǝsǝsa ka, nda aɓa buku male; sǝ lang à sǝn boale ka, yia andǝ tárrià ka ɓabumia tù mùr. <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />Tárrià Yakupu banggia wia ama, &lt;&lt;Wu malǝna amuna arǝàm. Yisǝfu umá; Shimiyon umá; sǝ ado ka wu kǝ earce wun nǝ̀ umnǝ Benjami ɗǝm. Kǝ mǝ nda mǝno tanni kǝ kumam ngga.&gt;&gt;<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />Pǝlǝa Ruben ne tárrí ama, &lt;&lt;Ɓǝ̀n nyesǝ Benjami a bano raka, wal-lú ka amuna-burana mem ɓari. Nyi a buam, mim ngga mǝ nǝ nyesǝô wi.&gt;&gt;<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />Sǝ Yakupu ka nyesǝi wi ama, &lt;&lt;Munem pà nǝ̀ ká atà wun ɗàng. Mǝ'eambi wuna, kǝ yì na ue nǝmurǝi ka. Ɓǝ̀ ɓè kǝgìr mǝɓane kumi a njar, a gya mǝno wun nǝ̀ twal ka, wun ndo wun nǝ̀ tasǝtam nǝ mbù amuram a Shewol<note caller="+" style="f"><char style="fr" closed="false">42:38 </char><char style="fq" closed="false">Shewol </char><char style="ft" closed="false">ka nda ɓanza mala alú.</char></note> nǝ bumkiɗikea.&gt;&gt;<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">Ɓaria twalbǝri mala amǝ'eam Yisǝfu aban ká a Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />Adyan ngga nzala ɓikina kǝ̀rkǝ́r a nzali Kan'ana. <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />Lang Yakupu andǝ amǝ'ɓala male lina mǝsǝsa mǝnana à kùró a Masar ka, Yakupu banggia wia ama, &lt;&lt;Wu nyar a Masar wu kya kúrà sǝm mǝsǝsa ɗǝm.&gt;&gt;<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />Yahuda banggi wi ama, &lt;&lt;Ɓwabura mǝnana makka sǝm mǝsǝsa ka, nunkir sǝm nǝ pekiban ama, &lt;Pà mǝ nǝ eara wun, wun nǝ̀ kùtí abanam ace sǝnam ɗang, she ɓǝ̀ wu yina nǝ mǝ'eam wun atà wun ngga.&gt; <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />Ɓǝ̀ awu nǝ eare a nǝ tasǝ mǝ'kyauwa sǝm atà sǝm ngga, sǝm nǝ̀ o a Masar ace kúr mǝsǝsa. <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />Sǝ ɓǝ̀ a pà nǝ tasǝì raka, pà sǝm nǝ̀ ká akanó ɗang, acemǝnana ɓwabure bangŋǝ́nà ama, &lt;Pà wun nǝ̀ sǝn ɓamǝsǝàm ɗàng she ɓǝ̀ mǝ'kyauwa wun na atà wun ngga.&gt; &gt;&gt;<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />Isǝrayila, yì Yakupu ɗia ama, &lt;&lt;Palang sǝ wu yinǝàm nǝ tanni mǝnia amuram nǝ banggi ɓwabure ama wu ndanǝ ɓe mǝ'eam wun le?&gt;&gt;<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />À earî wi ama, &lt;&lt;Ɓwabure ɗiki sǝm pepè amur ɓamur rǝ sǝm andǝ ɓala ma'sǝm ama, &lt;Tár wun nakam nǝyilǝmu più le? Wu ndanǝ ɓe mǝ'eambu le?&gt; Dumǝna púp sǝm nǝ̀ pe wi eare amur aɗikiban mǝnana ɗiki sǝm ngga. Lang sǝ sǝm nǝ̀ sǝlǝa ama nǝ̀ bang ama, &lt;Wu yinǝ mǝ'kyauwa wun atà wun?&gt; &gt;&gt;<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />Pǝlǝa Yahuda banggi tárrí Isǝrayila ama, &lt;&lt;Nyinggam yì muna a buam sǝ sǝm nǝ̀ lo sǝm nǝ̀ o, ace mǝnana sǝm sǝnǝ we, andǝ amuna mǝkèke ma'sǝm gbal ka, ɓǝ̀ sǝm àwá, ɓǝ̀ sǝm ngga wukî nzala ɗang. <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />Muna ka, mǝ nda rǝ kánbò, mim nǝ nggearǝam, mǝ nǝ yállí. Ɓǝ̀ ǝn nyesǝi ǝn yinǝi a bano ǝn yi tamsǝi a ɓadǝmbo raka, ɓǝ̀ cê pà amuram bà. <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />Ɓǝ̀ sǝm kìdìkima pwari raka, ɓǝ́ adyan ngga sǝm warina sǝ nyarna kusǝ ɓari.&gt;&gt;<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />Pǝlǝa tárrià banggia wia ama, &lt;&lt;Ɓǝ̀ ɓekǝ njar pà kàm sǝm nǝ̀ purî ɓá mǝnia yì cau raka, wu pàk gìr mǝnia ka: wu twal atà aɓea agir mǝɓoarne mala nzali mǝnia ka aɓalǝ abuku ma'wun, wu kyan nǝia kǝla ɓoro aban ɓwabure; wu ɗàrǝ́ myang bǝti, andǝ mùr-nyì bǝti, andǝ mùrú-hasǝa andǝ mukugìr mǝ'rǝmɓoarne, andǝ mǝsǝbyara, sǝ ɓǝla-ngbamso, wu kya pe wi. <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />Wu twal boalo mana kàr boalo kúr mǝsǝsae kusǝ ɓari ka, ace mǝnana ɓǝ̀ wu kya nyesǝ aboalo mana wu kumia a kún abuku ma'wun ngga. Yakǝla à ɓwarki nǝ ɓwarkio sǝ à tsǝka wunia aɓalǝ abuku ma'wun. <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />Wu twal mǝ'eam wun atà wun, wu bwal njar wu nyare aban ɓwabure. <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />Ɓǝ̀ Ɓakuli mana Karban nǝ Gulo Kat ka tsǝa ɓǝ̀ ɓwabure sǝn mǝsǝswatǝr ma'wun ace mǝnana ɓǝ̀ nying Shimiyon andǝ Benjami ɓǝ̀ wu nyar wunǝia. Ma mem ngga ɓǝ̀ dumǝna púp ama mǝ ɗwanyi amuna mem ngga, mǝ nǝ ɗwanyia.&gt;&gt;<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />Nda amuna mala Yakupu kùr aɓoro mana tárrià pà ka, à twal boalo mana karǝ kúr mǝsǝsa mǝno kusǝ ɓari ka, sǝ ɗǝm ngga à twal Benjami ateà, sǝ à bwal njargula à o a Masar. Wario malea ka, à kya kutio à cam a ɓadǝm Yisǝfu. <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />Lang Yisǝfu sǝn Benjami ateà ka, banggi ɓwamǝgule mala amǝ'túró-ɓala male ama, &lt;&lt;Kyan nǝ aburana mǝnia ka a ɓala mem. Yia ka à nǝ̀ lì girlina-pwari atàm yalung. O kya pwan-myal girkusǝu sǝ ɓǝà lam girlina.&gt;&gt; <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />Mǝtúró-ɓala man pa kǝla mǝnana à banggi wi ka, wari nǝ amǝ'eam Yisǝfu a ɓala mala Yisǝfu.<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />Amǝ'eam Yisǝfu ka ɓangciu bwalia kǝ̀rkǝ́r lang à sǝni à nda rǝ umnǝia a ɓala mala Yisǝfu ka. À bangŋi arǝarǝia ama, &lt;&lt;Yi ka nda rǝ kánǝ sǝm ace aboalo mǝnana sǝm kumia aɓalǝ abuku ma'sǝm, a yiu ma'sǝm mǝdǝmbe ka. Nda rǝ alta njar arǝ sǝm ace mǝnana nǝ̀ kum sǝm nǝ cau, ace bwalki sǝm ɓǝ̀ sǝm duk aguro sǝ nǝ̀ ak amǝdambǝriso ma'sǝm arǝ sǝm ngga.&gt;&gt;<verse eid="GEN 43:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 43:19" />Lang à bingŋǝ́nà kún ɓala ka, à sungŋo aban mǝtúró-ɓala mana amúr ɓala mala Yisǝfu ka <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />sǝ à bang cau nǝi ama, &lt;&lt;Ɓwamǝgule, Ida, kwakikiro arǝ sǝm. Sǝm yina kani ɗiɗyal ace kúr girlina. <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />A njar aban o a là ka, sǝm sulǝo a ɓè ban ace usǝlǝo, sǝ sǝm mǝngi abuku ma'sǝm, kara koyan atà sǝm ngga sǝn boalo male mǝnana kat pà ace kúr mǝsǝsa ka, a kún buku male. Yiu ma'sǝm mǝnia ka, ndya sǝm nyesǝ aboale ka. <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />Aɓea boalo nya gbal sǝm yinǝia a bù sǝm ace kúr mǝsǝsa ɗǝm ngga. Sǝm súrǝ̀ ɓwa mǝnana tsǝka sǝm aboalo mǝno aɓalǝ abuku ma'sǝm ngga ɗàng.&gt;&gt;<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />Mǝtúró-ɓala man banggia wia ama, &lt;&lt;Wu nongsǝ ɓalǝ wun. Cè ɓangciu pàkka wun ɗàng. Ɓakuli ma'wun, yì Ɓakuli mala tár wun, nda mǝnana tsǝka wun mǝnia yì gǝna aɓalǝ abuku ma'wun ngga, acemǝnana boalo mana wu mbwe a pwari mǝno ace kúr mǝsǝsa ka, mǝ nda ǝn ak boale ka.&gt;&gt; Sǝ kutio wario kya panzǝ Shimiyon a ndàkurban, pusǝì yinǝi abania.<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />Mǝtúró-ɓala man pǝlǝa kútinǝia a ɓala mala Yisǝfu. Pea wia mùr ɓǝà lakki akusǝia sǝ peà amǝdambǝriso malea girlina. <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />Banggia wia ama ɓǝ̀ pwari eauna a ɓongŋu ka, à nǝ̀ lì girlina atārǝia andǝ Yisǝfu. Nda à gilǝkice aɓoro mana à nǝ̀ pè Yisǝfu ɓǝ̀ yina ka.<verse eid="GEN 43:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 43:26" />Lang Yisǝfu yina a ɓala ka, à pè wi aɓoro mǝnana à yinǝì wi ka, pǝlǝa à ɓun a nzali a ɓadǝmbi. <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />Anzǝm mana mangŋǝ́nià-kún ngga, ɗìban ama, &lt;&lt;Lang tár wun, yì jamgula mǝnana wu banggam cau male a pwari mǝno ka? Ndakam più andǝamǝsǝi le?&gt;&gt;<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />À eari wi ama, &lt;&lt;E, tár sǝm, yì guro mò ka ndakam più andǝamǝsǝi, sǝ nda bǎng.&gt;&gt; Nyare à ɓunno a nzali a ɓadǝmbi.<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />Lang Yisǝfu loasǝ mǝsǝi sǝn mǝ'eambi Benjami, mǝnana à nda nggeau mwashat ka, ɗia ama, &lt;&lt;Mǝnia nda mǝ'kyauwa wun mǝnana wu banggam cau male ka le? Ɓǝ̀ Ɓakuli tsǝko bù, munem.&gt;&gt; <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />Kara Yisǝfu lo a kaurǝa nying banià, acemǝnana mǝrǝm yi lùmsǝ mǝsǝi, ue bǝti ɓǝ́ sangna a ɓua; earcearǝu mǝkǝ̀rkǝ́rnì ace mǝkyauwe na yi lùmsǝ bumi ka. Wario kya kútí a kurǝm male sǝ ɓua kàm. <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />Anzǝm mǝno ka, lak ɓamǝsǝi sǝ puro yiu abania ɗǝm, imsǝ mǝsǝi. Banggi amǝ'túró-ɓala male ama ɓǝà gau girlina. <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />Yisǝfu do a banli male nǝmurǝi, sǝ amǝ'eambi ka à tsǝkia wia amalea yì akwar girlina a ban malea ɗàng. Amǝ Masar do a malea yì banli tarang, acemǝnana amǝ Masar kǝ lìli a kwar mwashat andǝ amǝ Ibǝru ɗàng; mǝno ka gìr ɓeami na aban amǝ Masar. <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />Amǝ'eam Yisǝfu do a banli malea à kǝ sǝn ɓamǝsǝ arǝia andǝ Yisǝfu. À dumsǝia nǝ kpata pǝlǝa mala ɓǝlban malea, tite aban muna-dǝmba aban ká aban mǝtankwang malea. Lang à sǝn do mǝno à dumsǝia ka, à sǝngi rǝarǝia nǝ ndali. <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />Girlina ka a ɓadǝm Yisǝfu sǝ à ɗarǝi à pe koyan ngga. À ɗarǝî Benjami male kpǝm kusǝ tongno kútì mǝnana à ɗarǝî koyan atà acili amǝ'eambi ka. Nda à lì girlina sǝ à nu girnùná atārǝia andǝ Yisǝfu, sǝ à makrǝia nǝ banɓoarnado ka.<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">Yisǝfu kārǝki amǝ'eambi kārǝkiban mǝ'nzǝ́moè</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />Lang amǝ'eambi gilǝnarǝia à nǝ̀ o ka, Yisǝfu banggi ɓwamǝgule amur amǝ'túró-ɓala male ama, &lt;&lt;Lùmsǝ abuku mala aburana man nǝ mǝsǝsa kǝla mana à nǝ̀ gandǝ twale ka, sǝ nyesǝî koyan ateà ka boalo male; oasǝkia wia a kún abuku malea. <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />Sǝ oasǝ kap azǝrfa mala nugìr mem aɓa buku mala mǝtankwang malea, atārǝia andǝ boalo male mǝnana pà ace kúr mǝsǝsa ka.&gt;&gt; Mǝtúró-ɓala man pa kǝla mǝnana Yisǝfu banggi wi ka.<verse eid="GEN 44:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 44:3" />Ban fana nǝ dǝmbari ɗiɗyal ka, amǝ'túró-ɓala mala Yisǝfu tsǝktea ɓǝà o, pǝlǝa à bwal njar aban o nǝ amǝdambǝriso malea. <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />Lang à purnì nzǝm la sǝ à malaká o ɗār raka, Yisǝfu banggi ɓwamǝgule amur amǝ'túró-ɓala male ama, &lt;&lt;Lo pyangnǝata aburana mǝno! Ɓǝ̀ a kya bwalnateà ka, bang ama, &lt;Ace mana sǝ wu mbweban nǝ mǝɓane a kún mǝɓoarne? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />Ace mana sǝ wu iu kap nugìr mala mǝtala-ɓala mem? Nugìr na nǝmurǝi mǝnana mǝtala-ɓala mem kǝ nu aɓa mǝno yì kap ka ɗàng, aɓalǝi gbal sǝ kǝ ɓangnǝ-ɓangnǝa. Gìr mǝnana wu pè ka nggea mǝɓane na!&gt; &gt;&gt;<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />Lang mǝtúró-ɓala man kya bwalteà ka, ɓǝsǝlǝ amǝnia yì acau ka. <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />À eari wi ama, &lt;&lt;Mana girnì na a nakiyicau amurí, ɓwamǝgule, nǝ bang ulang mǝnia yì cau ka? Kpekpe pà sǝm nǝ̀ pàk kǝgìr kǝla mǝno ka ɗàng. <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />We ka a sǝlǝna ama aboalo mǝnana sǝm kya kumia a kún abuku ma'sǝm akanó a nzali Kan'ana ka, sǝm nyesǝô wia. Sǝ ace mana sǝ sǝm nǝ̀ kùtí a iu azǝrfa ko bolo-njengǝlan a ɓala mala mǝtala-ɓala mò? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />Ɓwamǝgule, ɓǝ̀ a kum mǝnia yì kap a bù kǝ ɓwa atà sǝm ngga, ɓǝà wal-luí, sǝ cili sǝm ngga sǝm nǝ̀ duk aguro mò.&gt;&gt;<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />Ɓwabure bang ama, &lt;&lt;E, ǝn earna, mǝ nǝ pàk gìr mǝnana wu bang ngga. Sǝama ɓwa mǝnana twal mǝnia yì kap ka nda mǝnana nǝ̀ duk guro mem ngga, sǝ cili wun ngga wun nǝ̀ o atà rǝ wun.&gt;&gt; <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />Pǝlǝa koyan ateà ka sulǝ buku mǝnana a nzǝm mǝdambǝriso male ka, sǝ mǝn kún buku. <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />Pǝlǝa mǝtúró-ɓala man kùtí a alta kap man aɓa koya buku ka. Tite nǝ buku mala muna-dǝmba sǝ yi masǝlǝi nǝ buku mala mǝtankwang malea. Yi kum kapni aɓa buku mala Benjami. <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />Lang amǝ'eambu man sǝn gìr man ngga, yia kat ka à sangi anggea-daura malea ace bumkiɗikea. Pǝlǝa koya ɓwa ka eamsǝ twalo a nzǝm mǝdambǝriso male, sǝ à nyare a nggea-là.<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />Yisǝfu ka nda a ɓala male più sǝ Yahuda andǝ amǝ'eambi nyare à yiu. À yi kpa a nzali a ɓadǝmbi. <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />Yisǝfu ɗia ama, &lt;&lt;Mana mǝnia wu pàk ka? Wu sǝlǝ mbak ama ɓwa kǝla mim ngga nǝ̀ gandǝ súrǝ̀ gir mǝnana nda aɓa sǝmbǝrǝa ka nǝ ɓangnǝ-ɓangnǝa?&gt;&gt;<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />Yahuda eari wi ama, &lt;&lt;Ya cau sǝm ndanǝi sǝm nǝ̀ na, mǝtala-ɓala mem? Lang sǝ sǝm nǝ̀ bǝlkun sǝm? Mana sǝm nǝ̀ gandǝ pa ace lakɓamur rǝ'sǝm? Ɓakuli pusǝnatà cauɓikea mala aguro mò. Sǝm kat sǝnǝ ɓwa mǝnana à kumi nǝ kapni ka, sǝm pǝlǝna aguro mò.&gt;&gt;<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />Yisǝfu bang ama, &lt;&lt;Awo, pà anggo ɗàng! Pà mǝ nǝ pàk gìr kǝla mǝno ka ɗàng. Ɓwa mǝnana à kumi nǝ kap ka, yì nǝmurǝi nda nǝ̀ duk guro mem ngga. Cili wun ngga wu nyare wu o a là nǝ rǝpwala aban tár wun.&gt;&gt;<verse eid="GEN 44:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />Yahuda sung tù aban Yisǝfu sǝ bang ama, &lt;&lt;Ɓwamǝgule, ida, earâm mǝ nacau nǝ we. Cè bumo lúllô arǝàm, mim guro mò ɗàng, acemǝnana rǝcandǝa mò ka nda mwashat andǝ mala murǝm.<verse eid="GEN 44:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 44:19" />&lt;&lt;Ɓwamǝgule mem, a ɗî sǝm ko tár sǝm ngga ndakam più nǝyilǝmu, sǝ ɗǝm ngga we ama ko sǝm ndanǝ ɓe mǝ'eambu. <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />Sǝm earô ɓwamǝgule ama, &lt;E, tár sǝm ngga ndakam nǝyilǝmu, sǝama ena kǝ̀rkǝ́r. Yì tár sǝm ngga ndanǝ muna-ɓwabura mǝkyauwe mǝnana à ɓǝlî wi a ě male ka. Muni mǝnia ka ndanǝ mǝgule mǝnana wuna ka, sǝ ado ka yì nda kǝ muna mala nggè mǝnana ueo nǝyilǝmu ka; tárrí kǝ earce kǝ̀rkǝ́r.&gt;<verse eid="GEN 44:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 44:21" />&lt;&lt;A bangga sǝm ama, &lt;Wu yinǝ mǝno yì mǝ'kyauwa wun ngga akani ace mǝnana mǝ sǝni nǝ amǝsǝàm ngga.&gt; <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />Sǝ sǝm banggo ɓwamǝgule ama, &lt;Mune ka pà sǝm nǝ̀ gandǝ pusǝì ɓǝ̀ nying tárrí ɗàng; ɓǝ̀ nying tárrí ka, tárrí nǝ̀ wǔ.&gt; <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />Sǝ a bangga sǝm ama, &lt;Ɓǝ̀ wu nyare wu yiu sǝ mǝ'kyauwa wun mǝno pà atà wun raka, pà mǝ nǝ eara wun ɓǝ̀ wu sǝn ɓamǝsǝam ɗǝm ɗàng.&gt;<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />&lt;&lt;Lang sǝm nyare a là aban tár sǝm guro mò ka, sǝm kya banggi wi acau mǝnana we ɓwamǝgule a bangga sǝm ngga.<verse eid="GEN 44:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 44:25" />&lt;&lt;Nǝnzǝ́mò ka tár sǝm yi bangga sǝm ama ɓǝ̀ sǝm nyare a Masar ace kúr girlina. <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />Sǝm banggi wi ama, &lt;Pà sǝm nǝ̀ gandǝ nyare sǝm nǝ̀ ká a Masar ɗàng she ɓǝ̀ mǝ'kyauwa sǝm na atà sǝm ngga. À pà nǝ̀ eara sǝm ɓǝ̀ sǝm sǝn ɓamǝsǝ ɓwabura mǝno a Masar ka ɗàng, she ɓǝ̀ mǝ'kyauwa sǝm ngga nda atà sǝm ngga.&gt;<verse eid="GEN 44:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 44:27" />&lt;&lt;Pǝlǝa tár sǝm, guro mò bangga sǝm ama, &lt;Wu sǝlǝna ama māmám Rahila ɓǝlâm amuna-burana ɓari. <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />Ɓè man mwashat ka ǝn ɗwanyini. Anyam-candǝa sangina nyami a ɓabondo, acemǝnana ǝn nyare ǝn sǝni ɗǝm ɗàng lang umǝna ka. <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />Ɓǝ̀ wu twal mǝnia arǝàm ado sǝ ɓè kǝgìr kya kumǝni ka, wun nǝ̀ tàsǝám, mim mǝjamgula a Shewol<note caller="+" style="f"><char style="fr" closed="false">44:29 </char><char style="fq" closed="false">Shewol </char><char style="ft" closed="false">ka nda ɓanza mala alú.</char></note> nǝ bumkiɗikea.&gt;<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />&lt;&lt;Ado ka ɓǝ̀ ǝn nyare sǝ ǝn o aban tár sǝm, yì guro mò, sǝ yì tár sǝm mǝnana yilǝmi muna nda yilǝmi ka, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />yi sǝni muna ka pà atàm raka, nǝ̀ kasǝa nǝ̀ wú. Sǝ sǝm aguro mò ka, sǝm nǝ̀ duk amǝ'cauɓikea mala tasǝta mǝjamgula ma'sǝm, yì guro mò, nǝ mbù amurí a Shewol aɓa bumkiɗikea. <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />Ən kánbì tár sǝm gìr ama mǝ nǝ nyesǝ munê a là jam. Sǝ ado ɓǝ̀n nyesǝì wi muna raka, mǝ nǝ twal twalo mala do nǝ cau arǝàm a ɓadǝm tárrám aɓa cili do mem kat.<verse eid="GEN 44:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 44:33" />&lt;&lt;Acemani ka, ida, ɗeki ɓǝ̀n ue kani kǝla guro mò a kúnì mǝtankwang ma'sǝm, sǝ ɗeki yì muna ka ɓǝ̀ o a là atārǝia andǝ acili amǝgule. <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />Lang sǝ mǝ nǝ nyare mǝ nǝ ká aban tár sǝm sǝ yì muna ka pà kàm atàm ɗàng? Pà mǝ nǝ gandǝ came mǝ nǝ sǝn gìr'mur'mwana mǝnana nǝ̀ sulǝo amur tárrám ngga ɗàng.&gt;&gt;<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">Yisǝfu lǝmdǝ ɓamúrì aban amǝ'eambi</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />Yisǝfu ka gandǝ bwal ɓabumi a ɓadǝmba amǝtè kat ɗàng, nda loasǝ gì bang ama, &lt;&lt;Wu tsǝk koyan ngga ɓǝà purî banam.&gt;&gt; Kǝɓwa pà kam atà Yisǝfu ɗàng lang banggi amǝ'eambi yan nda yì ka.<note caller="+" style="f"><char style="fr" closed="false">45:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 7:13">Atúró 7:13</ref></char>.</note> <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />Sǝ loasǝ gì sak a ɓua nǝ tusǝki ɓālǝi gandǝ amǝ Masar mǝnana a nza ka à oè, sǝ cê ak ɓá palta mala murǝm. <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />Yisǝfu banggi amǝ'eambi ama, &lt;&lt;Mǝ nda Yisǝfu! Tár sǝm nakam nǝyilǝmu più le?&gt;&gt;</para>
  <para style="p" vid="GEN 45:3">Amǝ'eambi gandǝ nyesǝì wi kǝ cau ɗàng, acemǝnana nggea ɓangciu bwalia kǝ̀rkǝ́r a ɓadǝmbi. <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />Yisǝfu ne amǝ'eambi ama, &lt;&lt;Ida, wu yiu abanam tù.&gt;&gt;</para>
  <para style="p" vid="GEN 45:4">Pǝlǝa à sungŋo abani, sǝ na ama, &lt;&lt;Mǝ nda Yisǝfu, mǝ'eam wun, mǝnana wu mé sǝ à yinǝi a Masar ka.<note caller="+" style="f"><char style="fr" closed="false">45:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 37:18-36">Tite 37:18-36</ref></char>.</note> <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />Sǝ ado ka, wu kǝa pàk bumkiɗikea ɗang, sǝ cè bum wun lúllô arǝ ɓamur rǝ wun ama wu mém sǝ à yinǝ mim kani ka ɗàng. Ɓakuli ka nda ak dǝmba tasǝam mǝ akà wun dǝmba yiu kani ace amsǝ yilǝmi aɓwana.<note caller="+" style="f"><char style="fr" closed="false">45:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 50:20">Tite 50:20</ref>; <ref loc="PSA 105:17">Ang 105:17</ref></char>.</note> <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />Mǝnia nda ɓaria pǝlǝa mala nzala aɓa nzali mǝnia ka; apǝlǝa tongno nakam più mǝnana nzala man nǝ̀ lidǝmba, sǝ aɓalǝia ka rya pa kàm ɗàng, sǝ pwan gìrɓaban pa kàm ɗàng. <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />Ɓakuli tasǝam mǝ akà wun dǝmba ace tsǝkcè atsǝktau a ɓanza ace wun, sǝ ɓǝà amsǝ ayilǝmi wun nǝ mǝnia yì kaɓa amsǝban ngga. <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />Ace mǝno ka, wun nda wu tasǝam kani ka ɗàng, Ɓakuli na. Pànâm bancame kani mǝ do mǝkwarkiru aban murǝm, kǝla ɓwamǝgule amur ɓala male kat, sǝ mǝ'yálmúr nzali Masar kat.<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />&lt;&lt;Ado ka wu nyare aban tárrám akaurǝa, wu banggi wi ama, &lt;Mǝnia ka nda cau mana munio Yisǝfu na ka: Ɓakuli tsǝ́ngŋǝ̀nám mǝ nda nggwamna amur nzali Masar kat. Acemani ka, yiu a nzali Masar; kǝa dǝndi ɗang! <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />Awu nǝ ya do a bu-nzali Goshen; awu nǝ do abanam tù, we wunǝ amunio andǝ amǝkeo, andǝ adomwan mala andá, andǝ mbulpǝndǝa, andǝ anzur mô, andǝ koman mǝnana kat a ndanǝi ka. <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />A ban mǝno ka mǝ nǝ pà wun girlina acemǝnana apǝlǝa tongno mala nzala nakam più; sǝ ǝn earce nǝma we wunǝ amǝ'ɓala mò andǝ agirkusǝu mô ka ɓǝ̀ wu kútí a do tapwasǝa ɗàng.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">45:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 47:12">Tite 47:12</ref>; <ref loc="GEN 50:21">50:21</ref></char>.</note><verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />&lt;&lt;Wun nǝ nggearǝ wun ngga, wun ndo wu kǝ sǝni nǝ amǝsǝ wun, sǝ mǝ'eambam Benjami gbal ka ndo kǝ sǝni nǝ mǝsǝì ama, mǝ nda ǝn nggǝ na wun cau nǝ kunam ngga. <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />Wu banggi tárrám cau mala gulo mǝnana kat à pàm a Masar andǝ koman mǝnana kat wu sǝni ka. Sǝ wu yinǝ tárrám akani akaurǝa!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 7:14">Atúró 7:14</ref></char>.</note><verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />Pǝlǝa Yisǝfu mǝn abui kùr mǝ'eambi Benjami a myali sǝ ɓua sukki mǝrǝm; Benjami gbal kǝ ɓua sǝ bwali arǝì. <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />Nǝ ɓua a kúni più, Yisǝfu mǝn abui kùr acili amǝ'eambi mwashat-mwashat, koyan ngga ateà. Anzǝm mǝno ka, amǝ'eambi nacau nǝi.<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />Lang cau yì mǝsǝe aban ká a palta mala murǝm ama amǝ'eam Yisǝfu yina ka, Murǝm Firona andǝ amǝ'tè ka banɓoaria wia. <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />Firona ne Yisǝfu ama, &lt;&lt;Banggi amǝ'eambo ama: &lt;Wu tsǝk twalo a nzǝm amǝdambǝriso ma'wun wu nyare a nzali Kan'ana. <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />Ɓǝ̀ wu warina ka, wu kya yinǝ tár wun andǝ amǝ'ɓala male ɓǝà tùr kani a Masar. Mǝ nǝ pà wun bu-nzali yál agir mǝnana ɓoaro kutibanì kat a Masar ka, sǝ wun nǝ̀ li gìr mǝɓoarne mala nzalinì.&gt;<verse eid="GEN 45:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 45:19" />&lt;&lt;Ɗǝm ngga banggi amǝ'eambo ama: &lt;Wu twal aɓea awaru-pǝr mala Masar atà wun ace pwan amuna ma'wun, andǝ amālá wun, andǝ tár wun, wu yiu wunǝia kani akaurǝa.<note caller="+" style="f"><char style="fr" closed="false">45:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 46:5">Tite 46:5</ref></char>.</note> <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />Wu kǝa pè ɓamur rǝ wun tanni arǝ pwan agir ɓala ma'wun ɗàng. Acemǝnana koya mǝɓoarne aɓa nzali Masar kat ka nǝ̀ duk ma'wun.&gt; &gt;&gt;<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />Anggo sǝ amuna mala Yakupu pa kǝla mǝnana à banggia wia ka. Yisǝfu peà wia awaru-pǝr andǝ girlina mǝnana à nǝ̀ lì a njar, kǝla mǝnana murǝm Firona bang ngga. <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />Ɗǝm ngga pè koyan ateà ka bǝsa anggea-daura; sǝ mala Benjami ka pè wi boalo azǝrfa mǝsǝì gbǝman-tàrú andǝ bǝsa anggea-daura tongno. <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />Sǝ tárrí ka túrìwìban nǝ amǝdambǝriso lum ajamne nǝ atwalo mala agir mǝɓoarne mala nzali Masar a nzǝmia, sǝ amǝdambǝriso lum amǝ'nggaule nǝ atwalo mala mǝsǝsa, andǝ agirlina, andǝ agirshake, ace gya male aban yiu a Masar.<verse eid="GEN 45:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 45:24" />Pǝlǝa Yisǝfu tasǝ amǝ'eambi ɓǝà o, sǝ lang à bwal njar aban o ka, banggia wia ama, &lt;&lt;Cè wu munǝ a njar fa!&gt;&gt;<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />Nda à nying Masar sǝ à nyare aban tárrià Yakupu a nzali Kan'ana. <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />À kya banggi tárrià ama, &lt;&lt;Yisǝfu nakam nǝyilǝmu! Yàle yì nda nggwamna mala nzali Masar kat!&gt;&gt; Cau mǝnia yipì Yakupu nǝ yasǝlǝban, sǝ túrí aɓa dǝmpǝndǝa; earnǝi ama cê ka mǝsǝcau na ɗang. <verse eid="GEN 45:26" /><verse number="27" style="v" sid="GEN 45:27" />Sǝama lang à banggi wi acau mǝnana kat Yisǝfu banggia wia, sǝ lang sǝn awaru-pǝr mǝnana Yisǝfu tasǝia ɓǝà yi twali nǝia ɓǝà kyan nǝi a Masar ka, kara dǝmbi kwaro. <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />Bang ama, &lt;&lt;Cau mǝnana wu bang ngga karǝna, ǝn earǝ̀nà nǝi. Munem Yisǝfu ka ndakam nǝyilǝmu. Mǝ nǝ ká sǝni sǝ mǝ wú!&gt;&gt;<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">Yakupu andǝ amǝ'ɓala male tùr a Masar</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />Nda Isǝrayila, yì Yakupu tita gya male, pwan gìr mǝnana kat ndanǝi ka. Lang yi bik Biyasheba ka, pà agir'nkila aban Ɓakuli mala tárrí Ishaku. <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />Ɓakuli tunǝ Isǝrayila aɓa sǝna nǝ du, sǝ ne wi cau ama, &lt;&lt;Yakupu, Yakupu!&gt;&gt;</para>
  <para style="p" vid="GEN 46:2">Pǝlǝa ear ama, &lt;&lt;Mǝ ndya ka.&gt;&gt;<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />Ɓakuli bang ama, &lt;&lt;Mǝ nda Ɓakuli, yì Ɓakuli mala tárró. Cè ɓangciu pakko arǝ ká a Masar ɗàng, acemǝnana mǝ nǝ tsǝa tàu mò nǝ̀ hatǝki, awu nǝ duk aɓwana mala nzali mǝgule akanó. <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />Mǝ nǝ ká atò a Masar, sǝ nǝnzǝ́mò ka, mim nǝ nggearǝam, mǝ nǝ nyesǝ tau mò à nǝ̀ nyare a nzali mǝnia ɗǝm. We ka a nǝ wú a Masar, sǝ Yisǝfu nǝ̀ pà a nkanggario a lú mò.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">46:4 </char><char style="fq" closed="false">sǝ Yisǝfu nǝ̀ pà a nkanggario a lú mò. </char><char style="ft" closed="false">Ko &lt;&lt;sǝ Yisǝfu nǝ̀ kùmsǝ amǝsǝo.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">46:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 50:1">Tite 50:1</ref></char>.</note><verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />Pǝlǝa Yakupu loapi Biyasheba nǝ̀ o a Masar. Nda amuna mala Isǝrayila twal tárrià yì Yakupu, sǝ à tsǝì aɓa waru-pǝr mǝnana Firona Murǝm Masar túrìwìban nǝi ka, sǝ à tsǝk amuna malea, andǝ amālia aɓalǝ acili awaru-pǝr. <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />À pwan agirkusǝu malea, andǝ agirkuma malea mǝnana à kúmô aɓa nzali Kan'ana ka, sǝ à o a Masar. Yakupu twal amǝ'ɓala male kat atè: <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />yìa amuna-burana male andǝ amǝkè amuna-burana, andǝ amuna-mamǝna male andǝ amǝkè amuna-mamǝna; yì tau male kat oa tè.<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />
    <note caller="+" style="f">
      <char style="fr" closed="false">46:8 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EXO 1:1-5">Pur 1:1-5</ref>
      </char>.</note>Amǝnia ka, à nda ka alullǝ amuna-burana mala Isǝrayila, yì Yakupu, mǝnana à pwan rǝia sǝ à wari andǝi a Masar ka:</para>
  <para style="li1" vid="GEN 46:8">Ruben yì muna-dǝmba male ka, <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:9">à nda ka Hanok, andǝ Palu, andǝ Hezǝron, andǝ Karmi.<verse eid="GEN 46:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="GEN 46:10" />Muni Shimiyon pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:10">à nda ka Jemuyel, andǝ Jamin, andǝ Ohat, andǝ Jakin, andǝ Zohar, sǝ Shawul mǝnana nggè ka ɓwama Kan'ana na ka.<verse eid="GEN 46:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="GEN 46:11" />Lawi pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:11">à nda ka Gashon, andǝ Kohat, andǝ Merari.<verse eid="GEN 46:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="GEN 46:12" />Yahuda pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:12">à nda ka Shela, andǝ Perez andǝ Zera. (Amuna-burana mala Yahuda, yia Er andǝ Onan ngga, à akdǝmba à wǔ a nzali Kan'ana.)</para>
  <para style="li2" vid="GEN 46:12">Perez pwan amuna-burana male:</para>
  <para style="li3" vid="GEN 46:12">À nda ka Hezǝron andǝ Hamul.<verse eid="GEN 46:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="GEN 46:13" />Isaka pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:13">à nda ka Tola, andǝ Puwa, andǝ Jashup, andǝ Shimiron.<verse eid="GEN 46:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="GEN 46:14" />Zebulu pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:14">à nda ka Seret, andǝ Elon andǝ Jali.<verse eid="GEN 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 46:15" />Amǝno ka à nda ka amuna-burana mǝnana Liya ɓǝlî Yakupu a Padan Aram ngga, sǝ ɓoarnsarile Dina. Làkkì mala amuna andǝ amǝkà Yakupu amuna-burana nǝ bu Liya ka, à nda lumi-tàrú-nong-tàrú (33).<verse eid="GEN 46:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="GEN 46:16" />Muna-ɓwabura male Gad pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:16">à nda ka Zefon, andǝ Hagi, andǝ Shuni, andǝ Ezǝbon, andǝ Eri, andǝ Arodi, andǝ Areli.<verse eid="GEN 46:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="GEN 46:17" />Asha pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:17">à nda ka Imǝna, andǝ Ishva, andǝ Ishvi andǝ Beriya.</para>
  <para style="li2" vid="GEN 46:17">Mǝkyauwea muna-ɓwama Sera ka nda ateà.</para>
  <para style="li2" vid="GEN 46:17">Beriya gbal ka pwan amuna-burana male:</para>
  <para style="li3" vid="GEN 46:17">À nda ka Heba andǝ Malkiyel.<verse eid="GEN 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 46:18" />Amǝno ka à nda ka amuna andǝ amǝkau mǝnana à ɓǝlî Yakupu nǝ bu Zilpa, yì muna-ɓwama mǝtúró-ɓala mala Laban mǝnana twali pè muni muna-ɓwama Liya, ɓǝ̀ duk muna-ɓala male ka. Yia kat ka à nda lum bwamdǝ tongno-nong-mwashat.<verse eid="GEN 46:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="GEN 46:19" />Amuna-burana mala Yakupu mǝnana à ɓǝl andǝ māmí Rahila ka à nda ka:</para>
  <para style="li2" vid="GEN 46:19">Yisǝfu andǝ Benjami. <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />Yisǝfu ka ak dǝmba nda a Masar, ban mǝnana à ɓǝlî wi amuna-burana ɓari:</para>
  <para style="li3" vid="GEN 46:20">À nda ka Manasa andǝ Ifǝrem. Nggea nda Asenat, ɓoarnsarile Potifera, ɓè pǝris a On, yì Heliyopolis.<note caller="+" style="f"><char style="fr" closed="false">46:20 </char><char style="fq" closed="false">Heliyopolis </char><char style="ft" closed="false">ka nda nggea-là &lt;&lt;On.&gt;&gt;</char></note><verse eid="GEN 46:20" /></para>
  <para style="li2">
    <verse number="21" style="v" sid="GEN 46:21" />Benjami pwan amuna-burana male gbal:</para>
  <para style="li3" vid="GEN 46:21">À nda ka Bela, andǝ Becha, andǝ Ashbel, andǝ Gera, andǝ Naaman, andǝ Ehi, andǝ Rosh, andǝ Mupim, andǝ Hupim, sǝ Arǝd.<verse eid="GEN 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 46:22" />Amǝno ka à nda ka amuna-burana mala Rahila andǝ amǝkè, mǝnana ɓǝlî Yakupu ka. Yia kat ka à nda lum nong ine.<verse eid="GEN 46:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="GEN 46:23" />Muna-ɓwabura male Dan twal muni:</para>
  <para style="li2" vid="GEN 46:23">Hushim.<verse eid="GEN 46:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="GEN 46:24" />Muna-ɓwabura male Naftali pwan amuna-burana male:</para>
  <para style="li2" vid="GEN 46:24">à nda ka Jaziyel, andǝ Guni, andǝ Jeza, andǝ Shilem.<verse eid="GEN 46:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="GEN 46:25" />Amǝno ka à nda ka amuna andǝ amǝkau mǝnana à ɓǝlî Yakupu nǝ bu Bilha, yì muna-ɓwama mǝtúró-ɓala mala Laban mǝnana twali pè muni muna-ɓwama Rahila, ɓǝ̀ duk muna-ɓala male ka. Yia kat à nda tongno-nong-ɓari.<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />Amuna andǝ amǝkà Yakupu mǝnana à wari a Masar andǝi ka làkkì malea kat ka nda lumi-tongno-nong-mwashat nǝ mǝsǝi tongno-nong-mwashat (66). Amālá amuni ka à ɓallia ɗàng. <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />Kpapì andǝ amuna-burana mala Yisǝfu mǝnana à ɓǝlî wi a Masar ka, làkkì mala amǝ'ɓala mala Yakupu, yia kat a nzali Masar ka lumi-tongno-nong-ɓari na (70).<note caller="+" style="f"><char style="fr" closed="false">46:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 1:5">Pur 1:5</ref>; <ref loc="DEU 10:22">Nggur 10:22</ref>; <ref loc="ACT 7:14">Atúró 7:14</ref></char>.</note><verse eid="GEN 46:27" /></para>
  <para style="s">Yakupu andǝ amǝ'ɓala male bik Masar</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />Lang à gbàshìnà Masar ka, Yakupu tasǝ Yahuda ɓǝ̀ aki wi dǝmba ká aban Yisǝfu, ɓǝ̀ banggi wi ama ɓǝ̀ kumia a Goshen. Lang Yakupu andǝ amǝ'ɓala male yi bingŋǝna ka, <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />Yisǝfu kùtí aɓa waru-pǝr male sǝ o a Goshen nǝ̀ nggá je andǝ tárrí, Isǝrayila. Lang à yì je ka, Yisǝfu mǝn abui yi kùr tárrí a myali sǝ ɓua banì sauwa. <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />Isǝrayila, Yakupu ne Yisǝfu ama, &lt;&lt;Ado ka mǝ nǝ gandǝ wú, acemǝnana ǝn sǝnǝno sǝ ǝn sǝlǝna ama a ndakam più nǝyilǝmu ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">46:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 2:29-30">Luk 2:29-30</ref></char>.</note><verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />Pǝlǝa Yisǝfu banggi amǝ'eambi andǝ acili amǝ'ɓala mala tárrí ama, &lt;&lt;Dumǝna púp mǝ kyane mǝ kya banggi Firona murǝm ama amǝ'eambam andǝ amǝ'ɓala mala tárrám kat, mǝnana à do a nzali Kan'ana ka, à yina abanam. <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />Mǝ nǝ banggi wi ama wun ngga wu nda ka ayálgír, amǝ ɗenyi nǝ agirkusǝu, sǝ wu yina nǝ adomwan mala anzur, andǝ ambulpǝndǝa, andǝ andá ma'wun, andǝ koman mǝnana kat ma'wun na ka. <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />Ɓǝ̀ Firona murǝm tunǝ wun sǝ ɗì wun ama, mana nda túró ma'wun ngga, <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />wu ne wi ama, &lt;Sǝm nda ka ayálgír. Ɗenyinǝ agirkusǝu nda túró ma'sǝm a do ma'sǝm kat, kǝla mǝnana aká sǝm pàk ka.&gt; Anggo ka nǝ̀ eara wun ɓǝ̀ wu do a bu-nzali Goshen.&gt;&gt; Yisǝfu bang mǝnia ka acemǝnana koya yálgír mala anzur ka gìr'ɓeami na aban amǝ Masar.<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="s">Yakupu tsǝki Murǝm Masar bu</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />Pǝlǝa Yisǝfu kùtí a ban Murǝm Firona sǝ banggi wi ama, &lt;&lt;Tárrám andǝ amǝ'eambam puro a nzali Kan'ana, à yi sulǝna. À yinǝ anzur, andǝ ambulpǝndǝa, andǝ andá malea, andǝ koya gìr mǝnana malea na ka. Ado ka à nda a bu-nzali Goshen.&gt;&gt;<verse eid="GEN 47:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 47:2" />Pǝlǝa Yisǝfu twal tongno atà amǝ'eambi, kútí nǝia sǝ lǝmdǝia aban Firona. <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />Firona ɗì amǝ'eam Yisǝfu ama, &lt;&lt;Mana nda túró ma'wun?&gt;&gt;</para>
  <para style="p" vid="GEN 47:3">À eari wi ama, &lt;&lt;Sǝm aguro mò ka, sǝm nda ka amǝ yál agir, kǝla mǝnana aká sǝm pàk ka.&gt;&gt; <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />Nyare à banggi Firona murǝm ama, &lt;&lt;Sǝm yiua do bǝti a nzali mǝnia, acemǝnana a nzali Kan'ana ka nzala ɓikina, sǝ ko kǝ girlina ko bondo pa kàm agirkusǝu ma'sǝm nǝ̀ lì ɗàng. Sǝm nggǝ zǝmbô, eara sǝm ɓǝ̀ sǝm do a bu-nzali Goshen.&gt;&gt;<verse eid="GEN 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 47:5" />Pǝlǝa Firona banggi Yisǝfu ama, &lt;&lt;Tárró andǝ amǝ'eambo yina a bano. <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />Nzali Masar ka nda a ɓadǝmbo. Dumsǝia a ban mǝɓoarne kat-kat mala nzali man. Awu nǝ gandǝ kánǝia ɓǝà do a bu-nzali Goshen. Ɓǝ̀ akǝ aɓwana nakam ateà mǝsǝia kàngkàng ngga, tsǝia ɓǝà kǝ yálàm agirkusǝu mem.&gt;&gt;<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />Pǝlǝa Yisǝfu yinǝ tárrí Yakupu aban Murǝm Firona, sǝ Yakupu tsǝkî Firona bù.<verse eid="GEN 47:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 47:8" />Firona ɗì ama, &lt;&lt;Apǝlǝa mô shen a ɓanza?&gt;&gt;<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />Yakupu eari wi ama, &lt;&lt;Do-yilǝmu mem mala gya arǝ abân kǝla bǝri ka, apǝlǝa gbǝman-mwashat nǝ lumi-tàrú na (130). Amǝno yì apǝlǝa ka à nda bǝti sǝ à kwano; à bik lakkì mala apǝlǝa mala akêm aɓa gya-bǝri malea ɗàng.&gt;&gt; <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />Pǝlǝa Yakupu tsǝki Firona bu ɗǝm sǝ purî ɓadǝm Firona.<verse eid="GEN 47:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 47:11" />Nda Yisǝfu kumbi tárrí andǝ amǝ'eambi bando. Kasǝia wia bân ɓǝ̀ duk girkuma malea a bu-nzali mǝɓoarne mala nzali Masar, tù aban nggea-là Ramisi, kǝla mǝnana Firona bang ngga. <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />Sǝ Yisǝfu pè tárrí, andǝ amǝ'eambi, andǝ acili amǝ'ɓala mala tárrí girlina; koyan ngga pè wi girlina mǝnana kārǝa arǝ làkkì mala amuni ka.<verse eid="GEN 47:12" /></para>
  <para style="s">Gingnǝban mala Yisǝfu a bakú nzala</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />Nzala yi ɓiki kam kpǝm, girlina malâ a koya ban aɓa nzali Masar andǝ ɓá nzali Kan'ana, sǝ aɓwana kútí a tanni kǝ̀rkǝ́r, atàcau mala ɗwanyi girlina. <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />Nda Yisǝfu kútí a makkì aɓwana mǝsǝsa mǝnana à soe aɓalǝ abah ka, ɓǝà kúrô. Anggo sǝ ak boalo mana kat aɓa nzali Masar andǝ nzali Kan'ana ka, sǝ tsǝì a ndaboalo mala Firona, Murǝm. <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />Lang boalo yi malnì bù aɓwana a Masar andǝ Kan'ana ka, amǝ Masar pur kat, à yiu aban Yisǝfu sǝ à bang ama, &lt;&lt;Pà sǝm girlina. Ace mana sǝ sǝm nǝ̀ wuki kani a mǝsǝo? Boalo ma'sǝm malǝna kat.&gt;&gt;<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />Pǝlǝa Yisǝfu earia wia ma, &lt;&lt;Ɓǝ̀ wu pànǝ boalo raka, wu pàm agirkusǝu ma'wun sǝ mǝ nǝ pà wun girlina a kúnì agirkusǝu.&gt;&gt;<verse eid="GEN 47:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 47:17" />Nda à yinǝ agirkusǝu malea aban Yisǝfu, sǝ Yisǝfu pea wia girlina a kúnì apǝr, andǝ anzur, andǝ ambul, andǝ andá, andǝ amǝdambǝriso malea ka. Aɓa pǝlǝa mǝno ka, pea wia girlina a kúnì agirkusǝu malea.<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />Lang pǝlǝa mǝno kutina ka, à yiu abani a ɓaria pǝlǝa sǝ à ne wi ama, &lt;&lt;Pà sǝm nǝ̀ sǝmbǝrǝò wi ɗàng, we mǝtala-ɓala ma'sǝm, ama, boalo ma'sǝm malna, sǝ agirkusǝu ma'sǝm ngga amona. Kǝgìr ueo mǝnana sǝm nǝ̀ po ka ɗàng, shekǝ ɓamur rǝ sǝm andǝ aɓaban ma'sǝm. <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />Kǝa ɗeki sǝm ɓǝ̀ sǝm wukio, sǝ aɓaban ma'sǝm kìɗìkì ɗàng. Pà sǝm girlina mǝnana sǝm nǝ̀ li sǝ sǝm nǝ̀ dum nǝyilǝmu ka, andǝ mǝsǝɓeale mǝnana sǝm nǝ̀ ɓeal ka, ace mǝnana aɓaban ma'sǝm ɓǝà kǝa duk pǝɗanban raka. Kúr sǝm sǝnǝ aɓaban ma'sǝm a kúnì girlina. Sǝm nǝ̀ duk aguro mala Firona Murǝm.&gt;&gt;<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />Anggo sǝ Yisǝfu kúr aɓaban mǝnana kat a Masar ka à duk aɓaban mala Firona Murǝm. Amǝ Masar kat makki wi aɓaban malea acemǝnana nzala ɓikipa; sǝ nzali kat yi duk girkuma mala Firona Murǝm. <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />Yisǝfu yi nyesǝ aɓwana kat à pǝlǝ aguro mala Firona, tite a nzong-nzali aban ká ɓè nzong-nzali mala Masar. <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />Kǝ anzali mǝnana kúria raka à nda ka nzali mala apǝris. Apǝris mak anzali malea ɗàng acemǝnana girlina malea ka, kǝ pur nǝ ɓala mala Firona Murǝm, sǝ mǝno ka kǝ kārǝia.<verse eid="GEN 47:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 47:23" />Pǝlǝa Yisǝfu banggi amǝ Masar ama, &lt;&lt;Ado mǝnana ǝn kúrnà wun wunǝ aɓaban ma'wun ace Firona ka, mǝ nǝ pà wun mǝsǝɓeale wu kya ɓeali arǝ aɓabanì. <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />Ɓǝ̀ pwari pwan gìrɓaban kārǝ́na ka, wun nǝ̀ pè Firona banì mwashat aɓa gauwe tongno mala gìr mǝnana wu kum ngga. Cili ka ma'wun na ace mǝsǝɓeale, sǝ ace girlina mala amuna ma'wun andǝ acili amǝ'ɓala ma'wun.&gt;&gt;<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />À pà eare ama, &lt;&lt;Ɓwamǝgule, a ámsǝ̀nà ayilǝmi sǝm! Sǝm kumǝna earmúrú a bano, sǝ sǝm earna sǝm nǝ̀ duk aguro mala Firona.&gt;&gt;<verse eid="GEN 47:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 47:26" />Nda Yisǝfu tsǝì dumǝna nzongcau mǝnana à kùrì a nzali Masar, sǝ bà yalung ngga ndakam, ama banì mwashat aɓa gauwe tongno mala gìrɓaban ngga, mala Firona na. Kǝ aɓaban mala apǝris na à pǝlǝ mala Firona raka.<verse eid="GEN 47:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />Isǝrayila andǝ amǝ'ɓala male yì dukla a Masar, a bu-nzali Goshen. A ban mǝno ka, yi sau ɗang à kum gǝna, sǝ à ɓǝlki amuna, à hatǝki kǝ̀rkǝ́r.<verse eid="GEN 47:27" /></para>
  <para style="s">Yakupu tsǝk Yisǝfu kángìr pà nǝ̀ tsǝk-luí a Masar ɗàng</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 47:28" />Yakupu pàk apǝlǝa lum bwamdǝ tongno-nong-ɓari a Masar anzǝm yiu male. Acemani ka, apǝlǝa mala do ɓanza mala Yakupu kat ka gbǝman mwashat nǝ lumi-ine bwamdǝ tongno-nong-ɓari na (147). <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />Lang pwari lú mala Isǝrayila gbàshìnà ka, túrban à tunǝ muna-ɓwabura male Yisǝfu, sǝ ne wi ama, &lt;&lt;Ɓǝ̀ bumo pwasǝo arǝàm ngga, ida, tsǝk buo aɓa byalam sǝ wu kángìr ama awu nǝ lǝmdǝàm pěmǝɓoarne sǝ a pà nǝ mém arǝ gir mǝnana mǝ nǝ banggo ado ka ɗàng: Kǝa tsǝk luem a Masar ɗàng. <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />Ɓǝ̀ ǝn wuna, ǝn umǝna atà akêm ngga, twal luem, pur nǝi aɓa Masar sǝ kya tsǝem a ban mǝnana à tsǝia kàm ngga.<note caller="+" style="f"><char style="fr" closed="false">47:30 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 23:17-19">Tite 23:17-19</ref>; <ref loc="GEN 25:9">25:9</ref>; <ref loc="GEN 35:29">35:29</ref>; <ref loc="GEN 49:29-32">49:29-32</ref></char>.</note>&gt;&gt;</para>
  <para style="p" vid="GEN 47:30">Pǝlǝa Yisǝfu pà eare ama, &lt;&lt;Mǝ nǝ pǎ kǝla mǝnana a bang ngga.&gt;&gt;<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />Yakupu ama, &lt;&lt;Kánbàm.&gt;&gt; Nda Yisǝfu kánbì wi ka. Pǝlǝa Yakupu pǝlǝ rǝì amur gyangŋan-nongŋo male<note caller="+" style="f"><char style="fr" closed="false">47:31 </char><char style="fq" closed="false">pǝlǝ rǝì amur gyangŋan-nongŋo male sǝ peri </char><char style="ft" closed="false">ko &lt;&lt;kùndǝó arǝ gara male sǝ peri.&gt;&gt;</char></note> sǝ peri.<note caller="+" style="f"><char style="fr" closed="false">47:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 11:21">Ib 11:21</ref></char>.</note><verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">Yakupu tsǝkî Ifǝrem andǝ Manasa bù</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />A ɓè pwari, anzǝm mǝnia ka, ɓeɓwa banggi Yisǝfu ama, &lt;&lt;Tárró ka rǝì eari wi ɗàng.&gt;&gt; Nda Yisǝfu wari a sǝn tárrí, atārǝia andǝ amuna-burana male ɓari, Manasa andǝ Ifǝrem.<verse eid="GEN 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 48:2" />Lang Yisǝfu yi bwalǝna ka, ɓeɓwa banggi Yakupu ama, &lt;&lt;Muna-ɓwabura mô Yisǝfu nya yiua sǝno ka.&gt;&gt; Pǝlǝa Yakupu candǝki amǝsǝi lo, do a kún gyangŋan-nongŋo male.<verse eid="GEN 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 48:3" />Yakupu banggi Yisǝfu ama, &lt;&lt;Ɓakuli mana Karban nǝ Gulo Kat ka, pusǝrǝi abanam a Luz, a nzali Kan'ana, tsǝkam bù.<note caller="+" style="f"><char style="fr" closed="false">48:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 28:13">Tite 28:13</ref>,<ref loc="GEN 28:19">19</ref>; <ref loc="GEN 35:6">35:6</ref>,<ref loc="GEN 35:9">9</ref></char>.</note> <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />Banggam ama, &lt;Mǝ nǝ tsǝo, awu nǝ ɓǝl amuna pas, sǝ awu nǝ hatǝki. Mǝ nǝ tsǝk tàu mò nǝ̀ gulo nǝ̀ pǝlǝ aɓwapǝndǝa mala anzali.<note caller="+" style="f"><char style="fr" closed="false">48:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:4">Tite 17:4</ref>,<ref loc="GEN 17:8">8</ref>; <ref loc="GEN 28:3-4">28:3-4</ref>; <ref loc="GEN 35:11-12">35:11-12</ref></char>.</note> Sǝ mǝ nǝ pè tàu mò mǝnia yi nzali Kan'ana ka, ɓǝ̀ duk malea, girkuma malea mǝnana málá male pà kàm raka.&gt; &gt;&gt;<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />Pǝlǝa Yakupu lidǝmba nǝ cau ama, &lt;&lt;Adyan ngga, amuna-burana mô ɓari, Ifǝrem andǝ Manasa, mǝnana a ɓǝlia kani a nzali Masar ka, à dumǝna amunem. Yia ka à dumǝna kǝla Ruben andǝ Shimiyon, amuna-burana mem. <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />Sǝama amuna mana à nǝ̀ ɓǝ̀lô wia nǝnzǝ́mò ka, à dumǝna amô; à nǝ̀ kum liɓala mala nzali nǝban amǝ'eambia, kǝla Ifǝrem andǝ Manasa.<verse eid="GEN 48:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 48:7" />&lt;&lt;A pwarian, mana mǝ ndarǝ nyari Padan Aram ngga, nggò Rahila yi wú a nkanggariam a nzali Kan'ana. Sǝm nda peatu amur njar, sappi Efǝrat (mǝnana à tunǝi gbal ama Betalami ka) ɗàng. Nǝ bumkiɗikea, sǝ ǝn tsǝk luí a kǝ ban mǝnana wù kàm ngga, a nkanggari njargula ká Efǝrat.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">48:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 35:16-19">Tite 35:16-19</ref></char>.</note><verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />Pǝlǝa Yakupu pǝlǝ mǝsǝi sǝn amuna-burana mala Yisǝfu, sǝ ɗì ama, &lt;&lt;Ayana mǝnia ka?&gt;&gt;<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />Yisǝfu pè tárrí eare ama, &lt;&lt;Amuna-burana mǝnana Ɓakuli pam kani a Masar ka, à nda.&gt;&gt;</para>
  <para style="p" vid="GEN 48:9">Tárrí banggi wi ama, &lt;&lt;Ida, yinǝia abanam tù ace mǝnana ɓǝ̀n tsǝkia wia bù ka.&gt;&gt;<verse eid="GEN 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 48:10" />Yakupu ka, ena, kǝ sǝnban pepè ɗàng. Nda Yisǝfu yinǝ amuna a baní tù, sǝ Yakupu mǝn abui, sǝ kùria arǝì bwalia kàngkàng. <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />Yakupu pǝlǝa aban Yisǝfu sǝ ne wi ama, &lt;&lt;Ən sǝlǝa nǝma mǝ nǝ sǝn ɓamǝsǝo ɗǝm ɗàng, sǝ ado ka, Ɓakuli earǝ́nàm ǝn sǝnǝna nggearǝ amunio!&gt;&gt;<verse eid="GEN 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 48:12" />Pǝlǝa Yisǝfu pusǝ amuna a nre ka ankūnǝ keâ, sǝ ɓunno a ɓadǝmbi nǝ ɓamǝsǝi a nzali.<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />Pǝlǝa Yisǝfu yinǝ amuna man nǝ mbup-ɓàriá tù aban tárrí Isǝrayila. Bwal muni mǝkyauwe Ifǝrem a buì mǝlì sǝ tsǝì atà bu mǝ'nggare mala Yakupu, sǝ muni mǝgule Manasa ka bwali a buì mǝ'nggare tsǝì atà bu mǝlì mala Isǝrayila.<verse eid="GEN 48:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 48:14" />Sǝ Yakupu ka, sárǝ́ abui a nkāɓe rǝarǝia, tsǝk buì mǝlì a ɓamur Ifǝrem, kat andǝ amani ama yì nda muna mǝkyauwe ka, sǝ buì mǝ'nggare ka tsǝì a ɓamur Manasa, kat andǝ amani ama Manasa nda muna-dǝmba ka.<verse eid="GEN 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 48:15" />Pǝlǝa tsǝkî Yisǝfu bù nǝ na ama,</para>
  <para style="q1" vid="GEN 48:15">&lt;&lt;Ɓǝ̀ Ɓakuli mǝnana kâ Ibǝrayim andǝ tárrám Ishaku</para>
  <para style="q2" vid="GEN 48:15">kpata njar male ka, tsǝkî amuna man bù.</para>
  <para style="q1" vid="GEN 48:15">Ɓǝ̀ Ɓakuli mǝnana yálǎm aɓa do mem kat,</para>
  <para style="q2" vid="GEN 48:15">bà yalung ngga,</para>
  <para style="q2" vid="GEN 48:15">tsǝkia wia bù.<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />Ɓǝ̀ mǝturonjar mǝnana akmúrám amsǝam a ɓabù ɓealɓikea kat ka,</para>
  <para style="q2" vid="GEN 48:16">tsǝki amuna mǝnia ka bù.</para>
  <para style="q1" vid="GEN 48:16">Ɓǝ̀ do ama yìa ka à nǝ̀ kánǝ lullǝàm,</para>
  <para style="q2" vid="GEN 48:16">andǝ lullǝ kèm Ibǝrayim,</para>
  <para style="q2" vid="GEN 48:16">andǝ lullǝ tárrám Ishaku a dǝmba.</para>
  <para style="q1" vid="GEN 48:16">Ɓǝ̀ Ɓakuli pea wia amuna andǝ amǝkau</para>
  <para style="q2" vid="GEN 48:16">ɓǝà hatǝki ɓǝà pǝlǝ aɓwabundǝa a ɓanza.&gt;&gt;<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />Yisǝfu ka, earce gìr mǝno tárrí pè ka ɗàng, mǝnana tsǝk buì mǝlì amur muni mǝkyauwe ka. Nda ɓariki nǝ̀ loasǝ bù-mǝlì mala tárrí amur Ifǝrem nǝ̀ kánǝí amur Manasa. <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />Banggi tárrí ama, &lt;&lt;Dàdá, kǝa pè anggo ɗàng. Mǝnia ka, nda muna-dǝmba. Tsǝk buo mǝlì amurí.&gt;&gt;<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />Tárrí ɓinǝe, pǝlǝi wi ama, &lt;&lt;Ən sǝlǝna, munem, ǝn súrǝ̀ gir mǝnana ǝn pakki ka. Mǝsǝcau na, Manasa ka, nǝ̀ nggá duk ɓwabundǝa mala nzali mǝgule. Sǝ ko ɓǝ̀ lang le ka, mǝkyauwe Ifǝrem ngga, nǝ̀ kútì nǝ gulo. Acemǝnana amǝkè nǝ̀ nggá duk ɓwabundǝa mala anzali.&gt;&gt;<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />Nda Yakupu tsǝki amuna-burana mǝno bù a pwari mǝno, kǝ na ama,</para>
  <para style="q1" vid="GEN 48:20">&lt;&lt;Amǝ Isǝrayila nǝ̀ paktúró nǝ alullǝ wun,</para>
  <para style="q2" vid="GEN 48:20">ɓǝ̀ à nǝ̀ tsǝki aɓwana bù ka. À nǝ̀ bang ama,</para>
  <para style="q1" vid="GEN 48:20">&lt;Ɓǝ̀ Ɓakuli tsǝk wun wu dum nǝ kume mala lidǝmba, kǝla mala Ifǝrem andǝ Manasa.&gt; &gt;&gt;</para>
  <para style="m" vid="GEN 48:20">Anggo sǝ Yakupu tsǝk Ifǝrem amur Manasa.<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />Pǝlǝa Isǝrayila yì Yakupu ne Yisǝfu ama, &lt;&lt;Sǝni, málá mǝ nǝ wǔ, sǝ Ɓakuli ka nda atà wun. Yì ka nǝ̀ nyesǝ wun a nzali mala aká wun, yì nzali Kan'ana. <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />Sǝ we mǝnana a nda amur amǝ'eambo ka, mǝ nda ban po nzali mǝɓoarne mala pal nkono mǝnana a Shekem ngga.<note caller="+" style="f"><char style="fr" closed="false">48:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 24:32">Jes 24:32</ref></char>.</note> Nzali mǝno ka ǝn é nǝ â arǝ amǝ'Amor a lwa nǝ nggeabyau mem andǝ nta mem.&gt;&gt;<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">Yakupu tsǝki amuni bù</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />Yakupu pǝlǝa tunǝ amuna-burana male sǝ bang ama, &lt;&lt;Wu yiu wu yi ramba abanam mǝ bangga wun gìr mǝnana nǝ̀ yia kum wun arǝ anza mǝnana à nǝ̀ yiu ka.<verse eid="GEN 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />&lt;&lt;Wu yi ramba wu ǒ,</para>
  <para style="q2" vid="GEN 49:2">wun amuna-burana mala Yakupu;</para>
  <para style="q1" vid="GEN 49:2">wu kwakikir wun</para>
  <para style="q2" vid="GEN 49:2">arǝ tár wun Isǝrayila.<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />&lt;&lt;We Ruben, a nda muna-dǝmba mem,</para>
  <para style="q2" vid="GEN 49:3">ǝn ɓǝ́ló aɓa rǝcandǝa mala lo-ɓwa mem;</para>
  <para style="q2" vid="GEN 49:3">arǝò sǝ tita ɓwabura-ɓwa mem lǝmdǝa.</para>
  <para style="q1" vid="GEN 49:3">Aɓa gulo ka a nda mǝdǝmba mala amunem,</para>
  <para style="q2" vid="GEN 49:3">a kútiǎ kat nǝ rǝcandǝa.<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />Sǝ acemǝnana a ɗwanyi bwal ɓamuro,</para>
  <para style="q1" vid="GEN 49:4">a songnǝo kǝla nggeamùr ka,</para>
  <para style="q2" vid="GEN 49:4">a pà nǝ duk mǝdǝmba ɗǝm ɗàng.</para>
  <para style="q1" vid="GEN 49:4">Acemǝnana a kutio a ndà-nongŋo mala tárró,</para>
  <para style="q2" vid="GEN 49:4">a nongnǝ māmí.</para>
  <para style="q1" vid="GEN 49:4">We, a eauwe a gyangŋan-nongŋo mem</para>
  <para style="q2" vid="GEN 49:4">a pǝndǝki! <note caller="+" style="f"><char style="fr" closed="false">49:4 </char><char style="ft" closed="false">ɓalli aɓa: </char><char style="xt"><ref loc="GEN 35:22">Tite 35:22</ref></char>.</note><verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />&lt;&lt;Shimiyon andǝ Lawi ka,</para>
  <para style="q2" vid="GEN 49:5">njar malea mwashat aɓa ɓealɓikea.</para>
  <para style="q1" vid="GEN 49:5">Anggea-byau malea ka,</para>
  <para style="q2" vid="GEN 49:5">agirbura mala lúllô na. <note caller="+" style="f"><char style="fr" closed="false">49:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 34:25">Tite 34:25</ref>,<ref loc="GEN 34:30">30</ref></char>.</note><verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />Yilǝmem, kǝa kútí aɓa kùrkún ɓa-sǝmbǝrǝa malea ɗàng,</para>
  <para style="q2" vid="GEN 49:6">bangŋo mem, kǝa oasǝ ɓamuro aɓa dapi malea ɗàng,</para>
  <para style="q1" vid="GEN 49:6">acemǝnana à wal-lú aɓa bumlulla malea.</para>
  <para style="q2" vid="GEN 49:6">À gbakǝri ajamnda ace pakkiɗire.<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />Bumlulla malea ka mala ɓìkìbura na;</para>
  <para style="q2" vid="GEN 49:7">ɓǝ̀ súban sulǝo amurí.</para>
  <para style="q1" vid="GEN 49:7">Bumkpǝmna malea ka mala pàkkiagir ɗwanyi sǝn mǝsǝswatǝr na.</para>
  <para style="q1" vid="GEN 49:7">Mǝ nǝ mesǝkia aɓa nzali Isǝrayila.</para>
  <para style="q2" vid="GEN 49:7">Mǝ nǝ mesǝkia aɓalǝ aɓwana mala Yakupu. <note caller="+" style="f"><char style="fr" closed="false">49:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 32:28">Tite 32:28</ref></char>.</note><verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />&lt;&lt;Yahuda, amǝ'eambo nǝ̀ ɓwangsǝo;</para>
  <para style="q2" vid="GEN 49:8">buo nǝ̀ kpa myal aɓio amǝbura;</para>
  <para style="q2" vid="GEN 49:8">amuna-burana mala tárró nǝ̀ ɓun a nzali a ɓadǝmbo.<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />Munem Yahuda, a ndà muna-im,</para>
  <para style="q2" vid="GEN 49:9">mǝnana nǝ̀ ɓangŋatà nyama nǝ̀ wali</para>
  <para style="q2" vid="GEN 49:9">sǝ nǝ̀ nyare a mpù male ka.</para>
  <para style="q1" vid="GEN 49:9">Kǝla im awu nǝ sarǝa a nǝ nongŋo,</para>
  <para style="q1" vid="GEN 49:9">kǝla nggeàɓwaná im,</para>
  <para style="q2" vid="GEN 49:9">yana ɓwe nǝ̀ kum ɓabumcandǝa nǝ̀ zorǝǒ?<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />Gara-murǝm pà nǝ̀ purî bù Yahuda ɗàng,</para>
  <para style="q2" vid="GEN 49:10">yálmúr aɓwana ka nǝ̀ pà a tàu male</para>
  <para style="q2" vid="GEN 49:10">bà yiu mala ɓwa mǝnana garè ka male na ka,</para>
  <para style="q2" vid="GEN 49:10">sǝ aɓwapǝndǝa ka à nǝ̀ ɓun a ɓadǝmbi,</para>
  <para style="q2" vid="GEN 49:10">à nǝ̀ oki wi.<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />Nǝ̀ kùr mǝdambǝriso male arǝ nggun-anap,</para>
  <para style="q2" vid="GEN 49:11">muna-mǝdambǝriso male ka nǝ̀ kùrì</para>
  <para style="q2" vid="GEN 49:11">arǝ bu nggun-anap mǝɓoarne mala aɓî;</para>
  <para style="q1" vid="GEN 49:11">nǝ̀ lákkí adaura male aɓa mùr-ɓǝlanggun anap,</para>
  <para style="q2" vid="GEN 49:11">adaura-múrɓì male ka nǝ̀ lákkia</para>
  <para style="q2" vid="GEN 49:11">nǝ mùr-ɓǝlanggun anap mǝbangŋe.<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />Amǝsǝì nǝ̀ bang bìng-bìng ace nu mùr-ɓǝlanggun anap,</para>
  <para style="q2" vid="GEN 49:12">aminǝi nǝ pwasǝ pwat-pwat ace nu kiura.<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />&lt;&lt;Zebulu ka nǝ̀ do a kún nggeamùr</para>
  <para style="q2" vid="GEN 49:13">sǝ ban male nǝ̀ duk ban kpasha mala awaru-mur;</para>
  <para style="q2" vid="GEN 49:13">nzong-nzali male nǝ̀ bik nggea-là Sidon.<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />&lt;&lt;Isaka ka mǝdambǝriso mǝ'ɓiki twal twalo na.</para>
  <para style="q2" vid="GEN 49:14">Nǝ̀ nongŋo a nzali ace ak twalo mǝdǝmbǝre a nzǝmi.<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />Ɓǝ̀ sǝn ɓoaro mala ban usǝlǝo male,</para>
  <para style="q1" vid="GEN 49:15">sǝ ɓǝ̀ nzali-do male pwasǝbumi ka,</para>
  <para style="q2" vid="GEN 49:15">nǝ̀ eare nǝ̀ twalki atwalo mǝdǝmbǝre a kwàrì.</para>
  <para style="q2" vid="GEN 49:15">Nǝ̀ eare nǝ̀ pak túró guro.<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />&lt;&lt;Dan ngga nǝ̀ duk mǝ'ɓashi mǝ'mǝsǝcaunì</para>
  <para style="q2" vid="GEN 49:16">amur aɓwana male kǝla mana acili atau mala Isǝrayila nǝ̀ pàk ka.<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />Dan nǝ̀ do kǝla n'yau a nkanggari njargula,</para>
  <para style="q2" vid="GEN 49:17">kǝla n'yau-barya aban nongŋo a gírí njarkusǝu.</para>
  <para style="q1" vid="GEN 49:17">Nǝ̀ kwar pǝr mana kǝ kútí ka a kusǝì</para>
  <para style="q2" vid="GEN 49:17">sǝ mǝkwak pǝr nǝ̀ puro nǝ̀ kpa nǝ nzǝmi.<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />&lt;&lt;We Mǝtalabangŋo, ǝn nggǝ soa mǝsǝam arǝò</para>
  <para style="q2" vid="GEN 49:18">ace kum amsǝban mò.<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />&lt;&lt;Amǝ'iuban nǝ agirbura a buià à nǝ̀ eau amúr Gad hǝrkit nǝ kiɗikiban,</para>
  <para style="q2" vid="GEN 49:19">sǝ yì ka nǝ̀ pǝlǝ arǝia nǝ munǝo nǝ̀ pǝrtea.<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />&lt;&lt;Asha ka nǝ̀ lìli, lǐ mala agirlina mǝɓoarne,</para>
  <para style="q2" vid="GEN 49:20">sǝ nǝ̀ pusǝ girlina mǝnana ndanǝ ɓoaro ace amurǝma ka.<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />&lt;&lt;Naftali ka nda kǝla mbamba mǝnana nda atarǝì ka;</para>
  <para style="q2" vid="GEN 49:21">nǝ̀ ɓangŋa aban ká a ban mǝnana bumi earce ka.</para>
  <para style="q2" vid="GEN 49:21">Nǝ̀ ɓǝlki amuna amǝɓoarsǝne.<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />&lt;&lt;Yisǝfu ka nggun anap mǝ'pa ɓǝle na,</para>
  <para style="q2" vid="GEN 49:22">mǝnana à pandǝi a kún mgbeɗe mùr ka;</para>
  <para style="q2" vid="GEN 49:22">abui to à eauwe amur sheran.<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />Amǝ ɓinǝmǝsǝì soa munǝo arǝì nǝ lúllô mǝkǝ̀rkǝ́rnì.</para>
  <para style="q2" vid="GEN 49:23">À pǝrte nǝ anta andǝ amundi malea.<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />Sǝama nta male ue ɓandang,</para>
  <para style="q2" vid="GEN 49:24">anggwarbui cam kàngkàng,</para>
  <para style="q1" vid="GEN 49:24">atàcau mala bu Mǝ'rǝcandǝa mala Yakupu,</para>
  <para style="q2" vid="GEN 49:24">atàcau mala Yálgír, Tali mala Isǝrayila,<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />atàcau mala Ɓakuli mala tárró,</para>
  <para style="q2" vid="GEN 49:25">yì Ɓakuli mǝnana bwalkiyio kàm ngga.</para>
  <para style="q1" vid="GEN 49:25">Ɓakuli mǝnana Kàrban Kat nǝ Gulo ka nǝ̀ tsǝko bù mala nya mbulo nǝ kuli;</para>
  <para style="q2" vid="GEN 49:25">nǝ̀ tsǝko bù nǝ pô mùr a tà-nzali;</para>
  <para style="q1" vid="GEN 49:25">nǝ̀ tsǝko bù mǝnana we wunǝ agirkusǝu mô ka</para>
  <para style="q2" vid="GEN 49:25">wun nǝ̀ ɓǝl nyangsang.<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />Atsǝkbu mǝnana ǝn earce Ɓakuli ɓǝ̀ pò ka amǝgulke na.</para>
  <para style="q2" vid="GEN 49:26">À gulo à kútì atsǝkbu mala tárrám andǝ mala kèm;</para>
  <para style="q2" vid="GEN 49:26">à kútì atsǝkbu mala ankono share ɓanza;</para>
  <para style="q2" vid="GEN 49:26">à kútì agǝna mala amgbang-ban mana à nda tàtǝ́k ka.</para>
  <para style="q1" vid="GEN 49:26">Yia kat ɓǝà sulǝo amuro, we Yisǝfu,</para>
  <para style="q2" vid="GEN 49:26">acemǝnana a nda murǝm aɓalǝ amǝ'eambo.<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />&lt;&lt;Benjami ka nvwa-bondo mǝ'ɓiki pak-nzal nyam-pǝra na;</para>
  <para style="q2" vid="GEN 49:27">nǝ dǝmbari ka nǝ̀ wal nyam-pǝra male,</para>
  <para style="q2" vid="GEN 49:27">nǝ pwarikpǝra ka nǝ̀ sàngi nyami.&gt;&gt;<verse eid="GEN 49:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />Amǝnia kat ka à nda ka tàu lum-nong-ɓari mala amǝ Isǝrayila, sǝ amǝnia yì acau ka à nda ka cau mǝnana tárrià banggia wia mana ndarǝ tsǝkia wia bù, kǝ pè koyan ateà ka tsǝkbu mǝnana kārǝa arǝì ka.<verse eid="GEN 49:28" /></para>
  <para style="s">Lú mala Yakupu andǝ tsǝkban male</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />Pǝlǝa Yakupu pè amuni amǝnia yì akwarkiru ka ama: &lt;&lt;Mǝ ndo mǝ nǝ wǔ mǝ nǝ o atà akêm mǝnana à akàm dǝmba à wuna ka. Wu tsǝk luem a ban mǝnana à tsǝk aɓea akêm kàm, a gumi-ɓa'tali a ɓaban mǝnana ɗiɗyal ka mala Efǝron ɓwa Hitti na ka. <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />Mǝno yì gumi-ɓa'tali a ɓaban a Makpela, tù nǝban là Mamǝre, a nzali Kan'ana ka, Ibǝrayim kúrí atārǝia andǝ ɓabanì a bu Efǝron ɓwa Hitti, ɓǝ̀ do nda ban tsǝk alú male.<note caller="+" style="f"><char style="fr" closed="false">49:30 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 23:3-20">Tite 23:3-20</ref></char>.</note> <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />A banì sǝ à tsǝk lú Ibǝrayim andǝ lú māmí Saratu; a banì sǝ à tsǝk lú Ishaku andǝ lú māmí Rabeka, sǝ a banì sǝ ǝn tsǝk lú Liya. <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />Ɓabanì andǝ gumi-ɓa'tali mana aɓalǝi ka à kúrí a bu amǝ'Hitti.&gt;&gt;<verse eid="GEN 49:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 49:33" />Lang Yakupu malna pa amǝnia yì akwarkiru aban amuni amuna-burana ka, nyare sarǝa akusǝi amur gyangŋan-nongŋo, lin'ueo male kasǝa, à kpapì atà akê.<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="s">À umnǝ lú Yakupu a Kan'ana ace tsǝkban</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />Yisǝfu lo kùmsǝ amur tárrí, kùrrì zǝp nǝ abui sǝ kǝ ɓua aceì. <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />Pǝlǝa banggi amǝtúró male, yì amǝ'ɓuri ama ɓǝà gilǝki lú tárrí Yakupu ace tsǝie. Anggo gbal sǝ à pa. <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />Túrè twalia anongŋo lumi-ine, acemǝnana mǝno ka nda làkkì mala anonggio mala mal túró gilǝki lú sǝ à nǝ̀ tsǝì. Amǝ Masar ɓua lú Yakupu anongŋo lumi-tongno-nong-ɓari (70).<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />Lang anonggio mala ɓua-lú kutina ka, Yisǝfu banggi amǝ'tamurǝm Firona ama, &lt;&lt;Ɓǝ̀ bum wun pwasǝ arǝàm ngga, ida wu kyan nǝ mǝnia yì càu ka a kunièm aban Firona Murǝm. Wu banggi wi ama, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />&lt;Mǝnana Tárrám malanǝ̀ wu ka, tsǝem ɓǝ̀n kángìr ama mǝ nǝ tsǝk luí a ɓembe mǝnana tǝmbî ɓamúrì a nzali Kan'ana ka. Acemani ka, ǝn nggǝ zǝmbô pé, ɗekiam ɓǝ̀n kyane mǝ tsǝk lú tárrám a Kan'ana, sǝ mǝ nyare.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">50:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 47:29-31">Tite 47:29-31</ref></char>. </note><verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />Firona Murǝm nyesǝi wi càu ama, &lt;&lt;Kyane kya tsǝk lú tárró kǝla mǝnana tsǝo a kánbì wi ama awu nǝ pàk ka.&gt;&gt;<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />Nda Yisǝfu lo oa tsǝk-lú tárrí ka. Aɓwana-mǝgule kat mala Firona Murǝm, andǝ amǝ'pè murǝm kwarkiru, andǝ aɓwana-mǝgule kat mala nzali Masar o atè. <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />Amǝɓala mala Yisǝfu, andǝ amǝ'eambi, andǝ acili amǝɓala mala tárrí yia kat à o atè. Kǝ amuna-mǝkèke malea, andǝ adomwan mala anzur, andǝ ambul andǝ andá malea na à ɗekia a bu-nzali Goshen ngga. <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />Aɓwana aɓalǝ awaru-pǝr sǝ a nzǝm apǝr gbal ka à o atè. Nggea ramba mala ɓwabundǝa na kǝ̀rkǝ́r.<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />Lang à yi bingŋǝna katǝra mala Atat, a nkaring Nggeasala Jodan ngga, à lo keban andǝ ɓua lú Yakupu kàm kǝ̀rkǝ́r. Akanó ka, Yisǝfu twal anonggio tongno-nong-ɓari aban dokúnɓembe andǝ ɓua-lú tárrí. <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />Lang amǝ'Kan'ana mǝnana à do a nzali mǝno sǝnia aban ɓua andǝ keban a katǝra mala Atat ka, à bang ama, &lt;&lt;Mǝnia ka ɓua-lú mǝkǝ̀rkǝ́rnì mala amǝ Masar na.&gt;&gt; Nda gìr mǝnana tsǝa sǝ à tunǝ banì ama Abel-Mizǝrayim ngga;<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="fq" closed="false">Abel-Mizǝrayim </char><char style="ft" closed="false">ngga nda &lt;&lt;ɓua-lú mǝkǝ̀rkǝ́rnì mala amǝ Masar.&gt;&gt;</char></note> nda kano a nkaring Mùr Jodan.<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />Anggo sǝ amuna-burana mala Yakupu pa kǝla mǝnana banggia wia ka.<note caller="+" style="f"><char style="fr" closed="false">50:12 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 47:30">Tite 47:30</ref>; <ref loc="GEN 49:29-32">49:29-32</ref></char>.</note> <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />À twal lú tárrià à umnǝi a nzali Kan'ana. À kya tsǝi a gumi-ɓa'tali a ɓaban a Makpela, tù nǝban là Mamǝre. Mǝno yì ɓaban ngga nda mana Ibǝrayim kúrí a bu Efǝron ɓwa Hitti, ɓǝ̀ do nda ban tsǝk alú male ka.<note caller="+" style="f"><char style="fr" closed="false">50:13 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 23:17-20">Tite 23:17-20</ref>; <ref loc="GEN 25:9">25:9</ref>; <ref loc="GEN 35:29">35:29</ref></char>.</note><verse eid="GEN 50:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 50:14" />Anzǝm mana Yisǝfu tsǝ̀ngŋǝ̀nà lú tárrí ka, nyar a Masar, atārǝia andǝ amǝ'eambi andǝ acili aɓwana mǝnana kat à o atè ace tsǝkban mala tárrí ka.<verse eid="GEN 50:14" /></para>
  <para style="s">Yisǝfu nongsǝ ɓabum amǝ'eambi</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />Lang amǝ'eam Yisǝfu sǝni tárrià wuna ka, à bang ama, &lt;&lt;Yakǝla Yisǝfu ndanǝ bumlulla mala agir mǝɓike mǝnana kat sǝm pakki wi ka più a bumi, nǝ̀ yia mbwe sǝm nǝ mǝɓike gbal.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">50:15 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 37:28">Tite 37:28</ref>; <ref loc="GEN 42:21-22">42:21-22</ref></char>.</note> <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />Nda à túrban ɓǝà banggi Yisǝfu mǝnia yi càu ka ama, &lt;&lt;Kaniama tárró nǝ̀ wù ka, bangga sǝm càu mǝnia ka, ama: <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />&lt;Wu banggi Yisǝfu ida ɓǝ̀ twali amǝ'eambi ban acauɓikea andǝ agir mǝɓane mǝnana à pea, mala tanni mǝnana à pe wi ɗiɗyal a njar mana ɓoar raka.&gt; Nda sǝm nggǝ zǝmbo, twali aguro mala Ɓakuli mala tárró banì.&gt;&gt; Lang cau mǝnia yina a baní ka, Yisǝfu ɓua sukki mǝrǝm. <verse eid="GEN 50:17" /><verse number="18" style="v" sid="GEN 50:18" />Amǝ'eambi gbal ka à yiu à yi kpa a nzali a ɓadǝmbi; à bang ama, &lt;&lt;Sǝm ndya ka; sǝm nda ka aguro mò.&gt;&gt;<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />Sǝ Yisǝfu ka nea wia ama, &lt;&lt;Ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Mǝ nda Ɓakuli le? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />Mala wun ngga, wu sham a ɓabum wun ama wun nǝ̀ pàkkam gìr mana nǝ̀ kwanrǝàm ngga, sǝ Ɓakuli ka kànì ama gìr mǝɓoarne na nǝ̀ pur aɓalǝi ka, ace mǝnana ɓǝà amsǝ ayilǝmi aɓwana pas, kǝla mǝno yalung sǝm nggǝ sǝni kǝ pàk ka.<note caller="+" style="f"><char style="fr" closed="false">50:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 47:5">Tite 47:5</ref>; <ref loc="ROM 8:28">Rom 8:28</ref></char>.</note> <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />Acemani ka, ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Mǝ nǝ ɗenyinǝ wun andǝ amuna ma'wun.&gt;&gt; Pǝlǝa ɓak ɓabumia sǝ nea wia acau mǝɓoarne.<verse eid="GEN 50:21" /></para>
  <para style="s">Masǝlǝata anonggio andǝ lú mala Yisǝfu</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />Yisǝfu do a Masar andǝ ɓala mala tárrí kat. Dǒ lùmsǝ apǝlǝa lumi-lum nǝ mǝsǝì lum (110). <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />Mǝnana Yisǝfu ka nda andǝamǝsǝì ka, sǝn amuna andǝ amǝkà Ifǝrem. Ɗǝm ngga à ɓǝl amuna mala Makir, muna mala Manasa a mǝsǝì; amuna mǝnia ka Yisǝfu ea amuni na.<verse eid="GEN 50:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 50:24" />Yisǝfu pǝlǝa nea amǝ'eambi ama, &lt;&lt;Málá mǝ nǝ wǔ, sǝ ɓafo ka Ɓakuli nǝ̀ yia bwala wun nggàm. Nǝ̀ pusǝ wun a nzali man, nǝ̀ nyesǝ wun a nzali mǝnana kánbì Ibǝrayim, sǝ Ishaku, sǝ Yakupu, ama nǝ̀ pea wia ka.&gt;&gt;<verse eid="GEN 50:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 50:25" />Pǝlǝa Yisǝfu tsǝk amuna mala Isǝrayila à kánbì wi ama, &lt;&lt;Mbak-kàngkàng Ɓakuli ka nǝ̀ yiu aban wun, sǝ wun nǝ̀ pwan amuem akani.&gt;&gt;<verse eid="GEN 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 50:26" />Nda Yisǝfu yi wú mana apǝlǝa male bingŋǝna gbǝman-mwashat nǝ lum (110) ngga. Lang à gilǝkina luí ka, à nongsǝi aɓa kpamgbang tsǝk-lú a Masar.<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>