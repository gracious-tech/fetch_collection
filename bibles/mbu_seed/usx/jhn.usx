<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Mbula</book>
  <para style="h">Yohana</para>
  <para style="toc3">Yoh</para>
  <para style="toc2">Yohana</para>
  <para style="toc1">Cau amsǝban a nê mala Yohana</para>
  <para style="mt2">Cau amsǝban a nê mala</para>
  <para style="mt1">YOHANA</para>
  <para style="imt">Mǝncau</para>
  <para style="im">Mwashat atà alaggana mala Yesu, yì Yohana ka, nda gilǝ mǝnia yì malǝmce ka. À kǝ sǝni kǝla à gilǝ mǝnia yì Cau Amsǝban ngga a pǝlǝa 85 anzǝm ɓǝlban mala Yesu.</para>
  <para style="ip">
    <char style="bk">Yì Cau Amsǝban a nê mala Yohana</char> ka lǝmdǝa sǝm ama Yesu nda Cau mala Ɓakuli, yì Cau mǝnana te pà nǝ̀ mal raka, mǝnana &lt;&lt;yi duk ɓwamǝpǝndǝe sǝ do aɓalǝ sǝm ngga.&gt;&gt; (<char style="xt"><ref loc="JHN 1:14">Yoh 1:14</ref></char>) À gilǝì ace mǝnana amǝ ɓallè ka ɓǝa earnǝi ama Yesu nda Mǝ'amsǝban mǝnana à pacau ace ka, yì Muna mala Ɓakuli, sǝ ɗǝm ngga nǝ́ paɓamuru malea a baní ka ɓǝà kum yilǝmu (<char style="xt"><ref loc="JHN 20:31">Yoh 20:31</ref>.</char>)</para>
  <para style="ip">
    <char style="bk">Yohana </char> kǝ bangŋi nǝ rǝcandǝa ama ɓoro mala yilǝmu mǝnana málá male pà kàm raka à kǝ kumi nǝban Kǝrǝsti, yì ɓoro mǝnana kǝ tite ado sǝ nǝ̀ ngga yiu aban aɓwana mǝnana à earnǝ Yesu ama nda njargula, andǝ mǝsǝcau, andǝ yilǝmu ka. <char style="bk">Yohana</char> pak túró nǝ agir mala koya pwari mǝnana aɓwana súrǝ̀ia pepe ka ace lǝmdǝ mǝsǝcau mala agir ɓá bangŋo, agir kǝla &lt;&lt;mur&gt;&gt;, &lt;&lt;bǝredi ko girlina&gt;&gt;, &lt;&lt;tǎlaban&gt;&gt;, &lt;&lt;yalgir andǝ anzur male&gt;&gt;, &lt;&lt;kun-nda&gt;&gt;, &lt;&lt;njargula&gt;&gt;, &lt;&lt;nggun anap andǝ aɓǝle&gt;&gt;, sǝ &lt;&lt;yilǝmu.&gt;&gt;</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Tita cau<char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref></char></para>
  <para style="io1">Yohana Mǝbatisǝma andǝ alaggana mǝdǝmbe mala Yesu<char style="ior"><ref loc="JHN 1:19-51">1:19-51</ref></char></para>
  <para style="io1">Túró mala Yesu a ban aɓwana<char style="ior"><ref loc="JHN 2:1-12:50">2:1--12:50</ref></char></para>
  <para style="io1">Masǝlǝata anonggio mala Yesu arǝ ban mala Urǝshalima sǝ aɓalǝi<char style="ior"><ref loc="JHN 13:1-19:42">13:1--19:42</ref></char></para>
  <para style="io1">Lo ɓembe mala Mǝtalabangŋo andǝ lǝmdǝrǝu male arǝ anjar ɗàngɗáng<char style="ior"><ref loc="JHN 20:1-31">20:1-31</ref></char></para>
  <para style="io1">Masǝlǝata cau: Yesu lǝmdǝ rǝì ɗǝm a Galili<char style="ior"><ref loc="JHN 21:1-25">21:1-25</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">Cau duk ɓwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="JHN 1:1" />Kaniama Ɓakuli nǝ̀</para>
  <para style="q2" vid="JHN 1:1">pusǝ ɓanza ka,</para>
  <para style="q1" vid="JHN 1:1">Cau ni nda kam,</para>
  <para style="q2" vid="JHN 1:1">sǝ mǝno yì Cau ka</para>
  <para style="q1" vid="JHN 1:1">à nda tàrǝia andǝ Ɓakuli;</para>
  <para style="q2" vid="JHN 1:1">sǝ yì, yì Cau ka Ɓakuli na.<verse eid="JHN 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="JHN 1:2" />A tite ka à nda</para>
  <para style="q2" vid="JHN 1:2">andǝ Ɓakuli.<verse eid="JHN 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JHN 1:3" />Nǝ yi sǝ Ɓakuli pusǝ agir kat.</para>
  <para style="q1" vid="JHN 1:3">Kǝgìr pà kàm mwashat</para>
  <para style="q2" vid="JHN 1:3">mana à pusǝì mǝnana</para>
  <para style="q2" vid="JHN 1:3">nǝ yi sǝ à pusǝì raka.<verse eid="JHN 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JHN 1:4" />Yì nda tǝr yilǝmu,</para>
  <para style="q2" vid="JHN 1:4">sǝ mǝnia yì yilǝmu</para>
  <para style="q1" vid="JHN 1:4">ka yiu nǝ tǎlaban</para>
  <para style="q2" vid="JHN 1:4">aban ɓwapǝndǝa.<verse eid="JHN 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JHN 1:5" />Sǝ yì tǎlaban ngga</para>
  <para style="q2" vid="JHN 1:5">kǝ ta aɓa pǝndǝa</para>
  <para style="q1" vid="JHN 1:5">sǝ pǝndǝa ka gandǝ</para>
  <para style="q2" vid="JHN 1:5">bwalte ɗàng!<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">sǝ pǝndǝa ka gandǝ bwalte ɗàng: </char><char style="ft" closed="false">Ko &lt;&lt;sǝ pǝndǝa ka pà nǝ̀ gandǝ limge ɗang.&gt;&gt;</char></note><verse eid="JHN 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JHN 1:6" />Ɓè ɓwa yiu,</para>
  <para style="q2" vid="JHN 1:6">mǝ'njar mǝnana</para>
  <para style="q1" vid="JHN 1:6">Ɓakuli túrí ka,</para>
  <para style="q2" vid="JHN 1:6">lùllǝì ama Yohana.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:1">Mat 3:1</ref>; <ref loc="MRK 1:4">Mar 1:4</ref>; <ref loc="LUK 3:1">Luk 3:1</ref>,<ref loc="LUK 3:2">2</ref></char>.</note><verse eid="JHN 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JHN 1:7" />Yiu yi ne ɓwapǝndǝa</para>
  <para style="q2" vid="JHN 1:7">cau amur mǝnia</para>
  <para style="q1" vid="JHN 1:7">yì tǎlaban ngga,</para>
  <para style="q2" vid="JHN 1:7">ace mǝnana ɓǝ̀</para>
  <para style="q1" vid="JHN 1:7">ɓwapǝndǝa kat ok</para>
  <para style="q2" vid="JHN 1:7">mǝnia yì cau ka, ɓǝ̀ é.<verse eid="JHN 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JHN 1:8" />Yohana nǝ ɓamúrì ka</para>
  <para style="q2" vid="JHN 1:8">nda tǎlabanì ɗang;</para>
  <para style="q1" vid="JHN 1:8">yì ka, yiu ace nacau</para>
  <para style="q2" vid="JHN 1:8">amur tǎlabanì.<verse eid="JHN 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JHN 1:9" />Tǎlaban mǝ'mǝsǝcau nì,</para>
  <para style="q2" vid="JHN 1:9">mǝnana kǝ ta aban</para>
  <para style="q1" vid="JHN 1:9">ɓwapǝndǝa kat ka,</para>
  <para style="q2" vid="JHN 1:9">ndo kǝ yiu a ɓanza ka.<verse eid="JHN 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="JHN 1:10" />Yì Cau ka nda a ɓanza,</para>
  <para style="q2" vid="JHN 1:10">sǝ kat andǝ amani ama</para>
  <para style="q1" vid="JHN 1:10">nǝ yi sǝ à pusǝ ɓanza ka,</para>
  <para style="q2" vid="JHN 1:10">ɓanza súrǝì ɗàng.<verse eid="JHN 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="JHN 1:11" />Yiu aban aɓwana</para>
  <para style="q2" vid="JHN 1:11">mǝnana amale na ka,</para>
  <para style="q2" vid="JHN 1:11">sǝ amale é ɗàng.<verse eid="JHN 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="JHN 1:12" />Sǝ aɓwana mǝnana kat à é,</para>
  <para style="q2" vid="JHN 1:12">à pa ɓamuria a baní ka,</para>
  <para style="q1" vid="JHN 1:12">pània wia rǝcandǝa</para>
  <para style="q2" vid="JHN 1:12">ɓǝà duk amuna</para>
  <para style="q1" vid="JHN 1:12">mala Ɓakuli.<verse eid="JHN 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JHN 1:13" />Ɓǝlban malea ka,</para>
  <para style="q2" vid="JHN 1:13">mala nkila na</para>
  <para style="q1" vid="JHN 1:13">andǝ nggūrǝu ɗang.</para>
  <para style="q1" vid="JHN 1:13">Pa aɓa kpapi</para>
  <para style="q2" vid="JHN 1:13">mala ɓwama andǝ</para>
  <para style="q2" vid="JHN 1:13">ɓwabura ɗang.</para>
  <para style="q1" vid="JHN 1:13">Mǝnia ka pe mala Ɓakuli na.<verse eid="JHN 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="JHN 1:14" />Mǝnia yì Cau ka</para>
  <para style="q1" vid="JHN 1:14">yi duk ɓwamǝpǝndǝe,</para>
  <para style="q2" vid="JHN 1:14">sǝ yi duk zuku aɓalǝ sǝm.</para>
  <para style="q1" vid="JHN 1:14">Sǝm sǝna gulo male,</para>
  <para style="q2" vid="JHN 1:14">gulo mala kǝ̀ Muna</para>
  <para style="q1" vid="JHN 1:14">mwashat ɓǝ̀rɓǝ̀r, mana pur</para>
  <para style="q2" vid="JHN 1:14">nǝban Tárrí Ɓakuli ka,</para>
  <para style="q1" vid="JHN 1:14">lùmsǝo nǝ ɓwamuru</para>
  <para style="q2" vid="JHN 1:14">andǝ mǝsǝcau.<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />Yohana ne aɓwana cau amurí nǝ giu mǝcandǝe ama, &lt;&lt;Mǝnia ka nda ɓwa mǝnana ǝn na wun cau amurí nǝma nda ban yiu a nzǝmam ngga, sǝ yì ka, kútiǎm nǝ gulo, acemǝnana yì ka, ndakam ɗiɗyal sǝ à yì ɓǝ̀lám.&gt;&gt; <verse eid="JHN 1:15" /><verse number="16" style="v" sid="JHN 1:16" />Aɓa ɓwamuru andǝ mǝnbu male sǝ tsǝka sǝm bu kat, kǝ pa sǝm agir mǝɓoarne a nzǝmarǝia. <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />Ɓakuli pa sǝm Nggurcau nǝ bu Musa, sǝ nǝ bu Yesu Kǝrǝsti sǝ pa sǝm ɓwamuru andǝ mǝsǝcau. <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />Kǝ ɓwa sǝn ma Ɓakuli àkǝ̀ pwari ɗàng, she kǝ Muni mǝnana à nda mwashat andǝ yi, sǝ nda a nkanggari ka. Yì nda tsǝa sǝ sǝm súrǝ̀ Tárrí ka.<verse eid="JHN 1:18" /></para>
  <para style="s">Yohana Mǝbatisǝma nda Kǝrǝsti ɗàng</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matiu 3:1-12</ref>; <ref loc="MRK 1:1-18">Markus 1:1-18</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />Aɓwana-mǝgule mala amǝ Yahudi mǝnana a Urǝshalima ka à túr apǝris andǝ Amǝ'Lawi ɓǝà kya ɗì Yohana ama, yì ka, nda yana le?<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />Yohana sǝmbǝrǝia wia kǝgìr ɗàng, banggia wia mǝsǝcau ama, &lt;&lt;Mǝ nda Kǝrǝsti<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="fq">Kǝrǝsti </char> (nǝ kún Gǝrik) ko Mezaya (nǝ kún Ibǝru) ka ɓālǝi nda: <char style="ft" closed="false">Ɓwa mǝnana à ɗārǝì wi mùrú olif amurí, mǝnana lǝmdǝ ama Ɓakuli tsǝ́ngŋǝ̀nì a buno-gulo andǝ rǝcandǝa ka.</char></note> ɗàng.&gt;&gt;<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />À ɗì ama, &lt;&lt;Sǝ we ka a nda yana? A nda Iliya le?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 18:15">Nggur 18:15</ref>; <ref loc="MAL 4:5">Mal 4:5</ref></char>.</note> Yohana earia wia ama, &lt;&lt;Awo, mǝ nda yì ɗàng.&gt;&gt; Sǝ à ɗì ama, &lt;&lt;A nda mǝɓangnǝa mala Ɓakuli mǝnana sǝm nggǝ kundǝmuri ka le?&gt;&gt; Earia wia ama, &lt;&lt;Awo.&gt;&gt;<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />A masǝlǝate ka à ɗì ama, &lt;&lt;Na sǝm cau mǝnana ɓǝ̀ sǝm nyesǝi aɓwana mǝnana à túr sǝm ngga. A kǝ twali ɓamuro ama a nda yana?&gt;&gt;<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />Yohana earia wia nǝ cau mala Ishaya mǝɓangnǝa mala Ɓakuli ama, &lt;&lt;Mǝ nda gìu mǝnana kǝ hama a ɓabondo ka, ama, &lt;Wu tsǝk njargula ɓǝ cam kporong ace Mǝtalabangŋo.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:3">Isha 40:3</ref></char>.</note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />Aɓea amǝ Farisi mǝnana à túriá ka, <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />à ɗì Yohana ama, &lt;&lt;Sǝ ɓǝ̀ a nda Kǝrǝsti,<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">Sǝn cau amur Kǝrǝsti a </char><char style="fv" closed="false">1:20.</char></note> ko Iliya, ko mǝno yì mǝɓangnǝa mala Ɓakuli raka, palang sǝ a kǝ pakki aɓwana batisǝma?&gt;&gt;<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />Yohana earia wia ama, &lt;&lt;Ən nggǝ pakki aɓwana batisǝma nǝ mùr, sǝ ɓeɓwa nda came aɓalǝ wun mǝnana wu súrǝì raka, <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />yì ka, nda ɓwa mǝnana kǝ yiu a tam tù ka, ǝn kārǝa mǝ nǝ panzǝ anggur-nkura male ka ɗàng.&gt;&gt;<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />Mǝnia yì gir ka à pè a Betani, a nkaring Nggeasala Jodan, àkǝ̀ ban mǝnana Yohana pakkiyi batisǝma kam ngga.<verse eid="JHN 1:28" /></para>
  <para style="s">Yesu nda Mǝgam mala Ɓakuli</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />Ɓè ban fana ka, Yohana sǝn Yesu aban yiu nǝ bani, sǝ pǝlǝa na ama, &lt;&lt;Wu sǝn Mǝgam mala Ɓakuli, mǝnana twalkiyi cauɓikea mala ɓanza ka! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />Mǝnia ka nda ɓwa mǝnana ǝn na ce ama, &lt;Ɓè ɓwa nda kǝ yiu atàm ngga. Yì ka, kútiǎm nǝ gulo, acemǝnana yì ka, ndakam ɗiɗyal sǝ à yì ɓǝlam.&gt; <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />Nggearǝ mim ngga ǝn súrǝì ɗiɗyal ɗang, sǝ tǝr yiu mem mǝnana ǝn nggǝ pakki aɓwana batisǝma nǝ mùr ka nda ace mǝnana ɓǝà lǝmdǝì amǝ Isǝrayila rǝì ka.&gt;&gt;<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />Pǝlǝa Yohana bang gìr mǝnana súrǝì amurí ka ani: &lt;&lt;Ən sǝn Bangŋo mala Ɓakuli kǝla kutu, sulǝ nǝ kuli yi do amurí. <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />Ɓǝ́ pà mǝ nǝ súrǝì ɗàng, ɓǝ̀ Ɓakuli mǝnana tasǝam ama ɓǝ̀n yi pakki aɓwana batisǝma nǝ múr ka nda nam raka. Nam ama, &lt;Ɓwa mǝnana a sǝni Bangŋo mem sulǝo yi do amurí ka, nda ɓwa mǝnana nǝ̀ pakki aɓwana batisǝma nǝ Bangŋo Mǝfele ka.&gt; <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />Ən sǝnǝni sǝ ǝn nggǝ bangcau amurí ama, yì ka, nda Muna mala Ɓakuli.&gt;&gt;<verse eid="JHN 1:34" /></para>
  <para style="s">Alaggana mana Yesu tita tunǝia ka</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />Ɓè ban fana ka, Yohana nda kano ɗǝm andǝ aɓea alaggana male ɓari. <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />Lang nǝ̀ sǝn Yesu aban kutio ka, na ama, &lt;&lt;Wu sǝn Mǝgam mala Ɓakuli!&gt;&gt;<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />Lang alaggana mǝnia ɓari à ongŋǝni náná anggo ka, kara à o atà Yesu. <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />Yesu nǝ̀ pǝlǝ rǝì ka, kara sǝnia aban yiu atè, sǝ ɗia ama, <char style="wj">&lt;&lt;Mana wu earki ce?&gt;&gt;</char></para>
  <para style="p" vid="JHN 1:38">À eare ama, &lt;&lt;Rabbi a ya ban sǝ a pa?&gt;&gt; (Rabbi ka ɓālǝi nda Malǝm.)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />Yesu earia wia ama, <char style="wj">&lt;&lt;Wu yiu wu yi sǝni.&gt;&gt;</char></para>
  <para style="p" vid="JHN 1:39">À pǝlǝa à wario à kya sǝn ban-do male. Sǝ à kya do atè bà du. Anggo ka bu-pwari ine nǝ pwarikpǝra na.<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />Ɓè ɓwa mwashat atà mǝnia yì aɓwana ɓari mǝnana à ok cau mǝnana Yohana na ka nda Andǝru, mǝ'eam Shiman Bitǝrus. <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />Andǝru pǝlǝa kum mǝ'eambi Shiman, sǝ ne wi ama, &lt;&lt;Sǝm kumǝna Mezaya (Tǝr Mezaya nda Kǝrǝsti, Mǝ'amsǝban mǝnana Ɓakuli bang ama nǝ̀ tasǝi ka.)&gt;&gt; <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />Sǝ yiu nǝ Shiman aban Yesu.</para>
  <para style="p" vid="JHN 1:42">Yesu sǝni kyap-kyap, sǝ na ama, <char style="wj">&lt;&lt;A nda Shiman muna mala Yohana. À nǝ̀ tunǝo ama, Kefas.&gt;&gt;</char> (Tǝr Kefas nda Bitǝrus, ɓālǝi ama, Tali.)<verse eid="JHN 1:42" /></para>
  <para style="s">Yesu tunǝ Filip andǝ Nataniyel</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />Ɓè ban fana ka, Yesu twali a ɓabumi ama nǝ̀ o a Galili. Yi kum Filip sǝ ne wi ama, <char style="wj">&lt;&lt;Yiu atàm.&gt;&gt;</char><verse eid="JHN 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44" />Filip ka ɓwa Beseda na, la mala Andǝru andǝ Bitǝrus. <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />Filip alta Nataniyel yi kumi sǝ ne wi ama, &lt;&lt;Sǝm kumǝna ɓwa mǝnana Musa gilǝgir amurí aɓa malǝmce Nggurcau mala Musa, andǝ mǝnana à gilǝa aɓa malǝmce mala amǝ'ɓangnǝa mala Ɓakuli ka, yì Yesu ɓwa Nazarat, muna mala Yisǝfu.&gt;&gt;<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />Nataniyel na ama, &lt;&lt;A Nazarat! Kǝ gir mǝɓoarne nǝ̀ pur a Nazarat gbal?&gt;&gt; Filip ne wi ama, &lt;&lt;Yiu sǝni.&gt;&gt;<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />Lang Yesu sǝn Nataniyel aban yiu ka, nacau amurí ama, <char style="wj">&lt;&lt;Mǝnia ka ɓwa Isǝrayila mǝɓafoe na, mǝnana pànǝ nyir arǝì raka.&gt;&gt;</char><verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />Nataniyel ɗì Yesu ama, &lt;&lt;A pak lang sǝ a súrǝàm?&gt;&gt;</para>
  <para style="p" vid="JHN 1:48">Yesu eari wi ama, <char style="wj">&lt;&lt;Mǝnana a nda a tǝta nggun vwari ka, ǝn angŋa dǝmba ǝn sǝnǝ no, sǝ Filip tunǝo.&gt;&gt;</char><verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />Pǝlǝa Nataniyel ne Yesu ama, &lt;&lt;Rabbi, a nda Muna mala Ɓakuli! A nda Murǝm mala amǝ Isǝrayila!&gt;&gt;<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />Yesu ne Nataniyel ama, <char style="wj">&lt;&lt;A earnǝ mim acemǝnana ǝn banggo nǝma, ǝn sǝno a tǝta nggun vwari ka le? A nǝ sǝn agir mǝgulke mǝnana à kútì man ngga.&gt;&gt;</char> <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />Yesu nyare nea wia ama, <char style="wj">&lt;&lt;Ən nggǝ na wun mǝsǝcau, wun nǝ̀ sǝn kùli nǝ mǝnna, andǝ amǝturonjar mala Ɓakuli aban eauwe andǝ sulǝo amur Muna mala Ɓwa.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">1:51 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 28:12">Tite 28:12</ref></char>.</note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">Yesu tsǝk mùr pǝlǝ <optbreak /> mùr-ɓǝlanggun anap</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />A tàruià nongŋo ka, à ndanǝ isǝban a Kana a nzali Galili, sǝ nggea Yesu ndakam abanì. <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />À tunǝ Yesu andǝ alaggana male aban isǝbanì. <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />À nda ɓá pakkiɗire ka, mùr-ɓǝlanggun anap málá a rǝia.<figure style="fig" alt="Fruit of the vine" file="hk00111c.tif" size="col" loc="JHN 2:3" copy="Horace Knowles" ref="2:3">Ɓǝlanggun anap</figure> Nggea Yesu yi ne wi ama, &lt;&lt;Mùr ɓǝlanggun anap malea malǝna.&gt;&gt;<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />Pǝlǝa Yesu eari wi ama, <char style="wj">&lt;&lt;Nnâ, palang sǝ a oasǝam aɓa ce? Bu-pwari mala lǝmdǝrǝu mem malaká karǝ peatu ɗàng.&gt;&gt;</char><verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />Nggea Yesu ne amǝ gau girlina ama, &lt;&lt;Wu pàk gìr mǝnana kat bangga wun ngga.&gt;&gt;<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />Àkǝ̀ banì ka, aganggǝlang mǝnana à kwária aɓa tali ka à ndakam, yia tongno-nong-mwashat; amǝnana amǝ Yahudi kǝ soak mùr aɓalǝia à kǝ lákkína rǝia nǝi andǝ agir ace peri a ɓadǝm Ɓakuli ka. Ko mǝ ye ka kǝ twal amunabang-mùr lumi-ɓari ko lumi-tàrú.<verse eid="JHN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7" />Yesu ne amǝ gau girlina ama, <char style="wj">&lt;&lt;Wu to mùr wu lumsǝki aganggǝlang.&gt;&gt;</char> Sǝ à lumsǝkia kat nǝ mur.<verse eid="JHN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8" />Sǝ nea wia ama, <char style="wj">&lt;&lt;Adyan ngga wu ɗàrǝa wu kya pe ɓwamǝgule mala pakkiɗire isǝban.&gt;&gt;</char> Pǝlǝa à ɗàrǝa à wari wi nǝi. <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />Sǝ ɓwamǝgule mala pakkiɗire isǝban ok mùr mǝnana à nyesǝi pǝlǝna mùr-ɓǝlanggun anap ka. Sǝ yì ka, súrǝ̀ ban mǝnana à pusǝ mǝnia yì mùr-ɓǝlanggun anap kàm ngga ɗàng (sǝ amǝ gau girlina mǝnana à ɗàrǝ́ mùr nì ka à sǝlǝna). Sǝ pǝlǝa tunǝ bura-māfela a giriban. <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />Sǝ na ama, &lt;&lt;Aɓwana pak ka à kǝ yinǝ mùr-ɓǝlanggun anap mǝɓoarne a dǝmba, ɓǝ̀ abǝri nùna karǝnia ka, sǝ à kǝ yiu nǝ mǝnana twal tè ka; sǝ mò ka a tsǝk mǝɓoarne a nzǝ́mò!&gt;&gt;<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />Gir'ndǝliki mǝnia Yesu pè a Kana, a nzali Galili ka, nda mǝdǝmbe mala agir-ndali male mǝnana lǝmdǝ gulo male ka. Sǝ alaggana male sǝni à pa ɓamuria a baní.<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />Anzǝm man ngga, Yesu andǝ ngge andǝ amǝ'eambi andǝ alaggana male o a Kapanahum sǝ à kya nonggi kam zuku.<verse eid="JHN 2:12" /></para>
  <para style="s">Yesu pǝr amǝ kúrkúró a <optbreak /> Ndàmǝgule mala Ɓakuli</para>
  <para style="r">(<ref loc="MAT 21:12-13">Matiu 21:12-13</ref>; <ref loc="MRK 11:15-17">Markus 11:15-17</ref>; <ref loc="LUK 19:45-46">Luka 19:45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />Lang pwari Lamsan Yàlîmurû mala amǝ Yahudi gbashìnà ka, Yesu o a Urǝshalima.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:1-27">Pur 12:1-27</ref></char>.</note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />Kya kum amǝ makki andá, andǝ anzur andǝ akutu, andǝ aɓwana mǝnana à dumǝna nǝ do aban nggaɗi boalo ka, aɓa Ndàmǝgule mala Ɓakuli. <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />Pǝlǝa Yesu peau nkamso nǝ nggúr sǝ pǝria kat, andǝ anzur, andǝ andá, ɓǝà purî ɓá Ndàmǝgule mala Ɓakuli. Sǝ ndǝlǝkí agir, mesǝki amǝsǝ-boalo mala amǝ nggaɗi boalo. <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />Sǝ ne amǝ makki akutu ama, <char style="wj">&lt;&lt;Wu pusǝ agir mǝnia ka aban man! Wu kǝa nyesǝ Ɓala mala Tárrám ɓǝ̀ duk limo ɗang!&gt;&gt;</char><verse eid="JHN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 2:17" />Sǝ ɓalǝ alaggana male kasǝa arǝ cau mǝnana Malǝmce na ama, &lt;&lt;Rǝɓǝla mem arǝ Ɓala mo we Ɓakuli ka, nǝ̀ earke a ɓalǝam kǝla bǝsa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:9">Ang 69:9</ref></char>.</note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />Aɓwana-mǝgule mala amǝ Yahudi ɗì Yesu ama, &lt;&lt;Ya gir'ndǝlǝki na ado awu nǝ pa, mǝnana nǝ̀ lǝmdǝa sǝm ama, Ɓakuli pano rǝcandǝa mala pak mǝnia yì gir ka?&gt;&gt;<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />Yesu earia wia ama, <char style="wj">&lt;&lt;Wu arki man yì Ndàmǝgule mala Ɓakuli ka, sǝ aɓa nongŋo tàrú ka mǝ nǝ loasǝi ɗǝm.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:61">Mat 26:61</ref>; <ref loc="MAT 27:40">Mat 27:40</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="MRK 15:29">Mar 15:29</ref></char>.</note><verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />Pǝlǝa amǝ Yahudi ne wi ama, &lt;&lt;Ndàmǝgule mala Ɓakuli mǝnana twal amǝɓa pǝlǝa lumi-ine bwamdǝ tongno-nong-mwashat sǝ à ɓè ka, a na ama awu nǝ ɓè aɓa nongŋo tàrú?&gt;&gt;<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />Sǝ Ndàmǝgule mala Ɓakuli mǝnana Yesu nakiyi ce ka, nda nggūrǝì. <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />Anzǝm mǝnana Yesu longŋǝni ɓembe ka, sǝ ɓalǝ alaggana male kasǝa ama, Yesu nania wia. Pǝlǝa à earnǝ Malǝmce andǝ acau mǝnana Yesu nea wia ka.<verse eid="JHN 2:22" /></para>
  <para style="s">Yesu súrǝ̀ ɓabum ɓwapǝndǝa</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />Mǝnana Yesu nda a Urǝshalima a pwari Lamsan Yàlîmurû ka, aɓwana pas à sǝn agir-ndǝlǝki mǝnana pea ka, pǝlǝa à pà ɓamuria a baní. <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />Sǝ Yesu ka earnǝia ɗàng, acemǝnana súrǝ́nà rǝ ɓwapǝndǝa kat. <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />Yesu pà aban alte ɓǝ̀ kǝɓwa ɓǝ̀ ne wi cau amur ɓwapǝndǝa ɗàng, acemǝnana yì nǝ ɓamúrì ka súrǝ́nà rǝ ɓabum ɓwapǝndǝa.<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">Yesu bǝ́lì Nikodimus ɓá ɓaria ɓǝlban</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />Ɓè ɓwa ndakam atà aɓwana-mǝgule, amǝ kùrcau mala amǝ Yahudi, mǝnana lùllǝì ama Nikodimus ka. Nda aɓalǝ amǝ Farisi. <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />Ɓwabura man yiu aban Yesu nǝ dú, sǝ yi ne wi ama, &lt;&lt;Malǝm, sǝm sǝlǝna ama a nda mǝkànìgìr mǝnana Ɓakuli túrí ka. Kǝ ɓwa pà kàm nǝ̀ gandǝ pakki agir-ndǝlǝki mǝnana a pakkiyi ka ɗàng, yi mǝnana ɓǝ̀ Ɓakuli pa atè raka.&gt;&gt;<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />Yesu eari wi ama, <char style="wj">&lt;&lt;Mǝ nda ban nô mǝsǝcau, ɓǝà ɓǝsǝlǝ ɓǝl ɓwa raka, pà nǝ̀ kutio aɓa domurǝm mala Ɓakuli ɗang.&gt;&gt;</char><verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />Nikodimus ɗiban ama, &lt;&lt;Lang sǝ à nǝ̀ ɓǝsǝlǝ ɓǝl ɓwa mǝnana gulna ka? Nǝ̀ kútí a bum ngge ɗǝm sǝ à nǝ̀ ɓǝsǝlǝ ɓǝle lè?&gt;&gt;<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />Yesu ne wi ama, <char style="wj">&lt;&lt;Mǝ nda ban nô mǝsǝcau, kǝɓwa pà nǝ̀ kutio aɓa domurǝm mala Ɓakuli ɗang, she ɓǝà ɓǝlǝni nǝ mùr andǝ Bangŋo mala Ɓakuli ka.</char> <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" /><char style="wj">Tárrú andǝ nggeau à nda à ɓǝlkiyi ɓwapǝndǝa ka, sǝ ɓǝlban ɓá Bangŋo ka, túró mala Bangŋo mala Ɓakuli na.</char> <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" /><char style="wj">Kǝa ndali nǝ cau mǝnana ǝn banggo nǝma, &lt;Dumǝna púp à nǝ̀ basǝ ɓǝl wun ngga&gt; ɗàng.</char> <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" /><char style="wj">Gung kǝ ɓua kǝ o aban mǝnana earce nǝ̀ ká kàm ngga. Wu kǝ ok gǝshi, sǝ wu súrǝ̀ ban mǝnana purkiyi kam andǝ ban mǝnana kákiyi kam ngga ɗàng. Anggo sǝ ɓwa mǝnana à basǝ ɓǝle aɓa Bangŋo mala Ɓakuli ka pa.&gt;&gt;</char><verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />Nikodimus ɗì ama, &lt;&lt;Lang sǝ mǝnia yì ɓǝlban ngga nǝ̀ gandǝ pa?&gt;&gt;<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />Yesu pǝlǝa eari wi ama, <char style="wj">&lt;&lt;Nggearǝ we ka a nda ɓwamǝgule aɓa kànìgìr a nzali Isǝrayila, sǝ a súrǝ̀ mǝnia yì gìr ka ɗàng?</char> <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" /><char style="wj">Mǝ nda ban nô mǝsǝcau, gìr mǝnana sǝm súrǝì, andǝ mǝnana sǝm sǝn ngga, nda sǝm nakiyia wun ce ka. Kat andǝ amani ka wu ɓinǝ ak cau mǝnana sǝm nggǝ na wun ngga.</char> <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" /><char style="wj">Ən na wun cau mala agir mǝnana a ɓanza man ngga, sǝ wu earnǝ mim ɗang, lang sǝ wun nǝ̀ earnǝ mim yì mǝnana ɓǝ̀ ǝn na wun cau mala agir mǝnana a kùli ka?</char> <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" /><char style="wj">Kǝ ɓwa malaká eau a kùli ɗang, she kǝ yì mǝnana sulǝ nǝ kuli ka, yì Muna mala Ɓwa, mǝnana nda a kùli ka.</char><verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />
    <char style="wj">&lt;&lt;Kǝla mǝnana Musa loasǝ n'yau amur gara a ɓabondo ka, anggo sǝ dumǝna púp à nǝ̀ loasǝ Muna mala Ɓwa a kùli,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="NUM 21:9">Ɓal 21:9</ref>
      </char>.</note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" /><char style="wj">acemǝnana koya ɓwa mǝnana kat pa ɓamúrì a baní ka ɓǝ̀ kǝa kìɗìkì ɗàng, yì ka ɓǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char><verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />
    <char style="wj">&lt;&lt;Ɓakuli ka earce ɓanza kǝ̀rkǝ́r, sǝ yi pâ kǝ̀ Muna male mwashat ace mǝnana ɓwa mana kat pà ɓamúrì a baní ka ɓǝ̀ kǝa kìɗìkì ɓǝ̀ ueɓà ɗàng, ɓǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char> <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" /><char style="wj">Ɓakuli tasǝ Muni ɓǝ̀ yì ɓashì ɓanza ɗàng, tasǝì ɓǝ̀ yì amsǝ ɓanza.</char><verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />
    <char style="wj">&lt;&lt;Ɓwa mǝnana kat pà ɓamúrì aban Muna mala Ɓakuli ka, pà aɓata ɓashi ɗàng. Sǝ ɓwa mǝnana kat ɓinǝ pà ɓamúrì ka, à angŋa dǝmba à kasǝna ɓashi ɓǝ̀ sulǝo amurí, acemǝnana ɓinǝ pà ɓamúrì aban Muna mwashat ɓǝ̀rɓǝ̀r mala Ɓakuli ka.</char> <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" /><char style="wj">Tǝ́r ɓashi mala Ɓakuli ka nda mǝnana ama, tǎlaban yiu a ɓanza, sǝ ɓwapǝndǝa earce pǝndǝa kútì tǎlaban, acemǝnana atúró malea ka amǝɓealɓike na.</char> <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" /><char style="wj">Ɓwa mǝnana kat kǝ pak gìr mǝɓike ka, kǝ ginǝ tǎlaban, sǝ pà nǝ̀ yiu aban tǎlaban ɗang, ace mǝnana ɓǝ̀ tǎlaban ɓǝ̀ kǝa lǝmdǝ atúró ɓealɓikea male ɗàng.</char> <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" /><char style="wj">Sǝ ɓwa mǝnana kǝ pak gìr aɓa mǝsǝcau ka, kǝ yiu aban tǎlaban, ace mǝnana ɓǝ̀ tǎlaban lǝmdǝ atúró male, mǝnana pea nǝ́ ɓanggi Ɓakuli ka.&gt;&gt;</char><verse eid="JHN 3:21" /></para>
  <para style="s">Cau mana Yohana Mǝbatisǝma <optbreak /> bang amur Yesu ka</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />Anzǝm man ngga, Yesu andǝ alaggana male nying Urǝshalima sǝ à o arǝ aɓea muna-là aɓa bu-nzali Yahudi. À kya pakkia anonggio kam, aban pakki aɓwana batisǝma. <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" /><note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 14:3">Mat 14:3</ref>,<ref loc="MAT 14:4">4</ref>; <ref loc="MRK 6:17">Mar 6:17</ref>,<ref loc="MRK 6:18">18</ref>; <ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>.</note> Yohana gbal ka nda aban pak batisǝma a Ainon mǝnana a ban Salim ngga, acemǝnana mùr nda abanì kpǝm. Ɓwapǝndǝa camarǝ yiu a baní, sǝ kǝ pakkia wia batisǝma. <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />(Anggo ka à malaká oasǝ Yohana a ndàkurban peatu ɗàng.)<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />Aɓea alaggana mala Yohana andǝ ɓeɓwa Yahudi, à lo makgìr amur kúncau mala lákkí rǝu andǝ lákkí agir ace peri aban Ɓakuli. <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />Sǝ alaggana mala Yohana yiu a baní à yì ne wi ama, &lt;&lt;Rabbi, ɓālǝo kasǝa arǝ ɓwa mǝnana wu nda wunǝi a nkaring Nggeasala Jodan, yì mǝnana a bangga sǝm cau amurí ka? Sǝni, nda kǝ̀ pàkkî aɓwana batisǝma ka, sǝ aɓwana pwanǝna rǝia kat aban ká a baní.&gt;&gt;<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />Pǝlǝa Yohana na ama:</para>
  <para style="pi" vid="JHN 3:27">Ɓakuli ka nda kǝ pe ɓwa túró mǝnana nǝ̀ pak ka. <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />Wun, nǝ ɓamur rǝ wun ngga, wun nǝ̀ nakunam mǝnana ǝn bang nǝma, &lt;&lt;Mǝ nda Kǝrǝsti, Mǝ'amsǝban ɗang. À túrǎm nǝ túrô ɓǝ̀n aki wi dǝmba yiu.&gt;&gt;<verse eid="JHN 3:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="JHN 3:29" />Māfela ka mālá bura-māfela na; sǝ murǝm gyajam mala bura-māfela mǝnana cam aban kundǝe kǝ kwakikiri arǝì ka, ban kǝ ɓoari wi arǝ ok gì bura-māfela. Mim gbal ka, ban kǝ ɓoaram arǝ cau mǝno wu banggàm ngga. <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />Dumǝna púp ama, nǝ̀ nggǝ lidǝmba nǝ gulo, sǝ mim ngga mǝ nǝ nggǝ amsǝa.<verse eid="JHN 3:30" /></para>
  <para style="s">Ɓwa mǝnana sulǝ nǝ kuli ka</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />Ɓwa mǝnana pur nǝ kuli ka, nda mǝnana ndanǝ gulo kútì acili aɓwana kat ka. Ɓwa mǝnana ndakani a ɓanza ka, mala ɓanza na, sǝ acau male ka a mala ɓanza na. Sǝ ɓwa mǝnana sulǝ nǝ kuli ka, ndanǝ gulo kútì aɓwana kat. <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />Yì ka, yiu, yi bǝlkuni amur gir mǝnana sǝna sǝ ok ka, sǝ kǝɓwa ak cau male ɗàng. <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />Sǝ ɓwa mǝnana kat ak cau male ka earǝna ama cau mala Ɓakuli ka mǝsǝcau na. <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />Ɓwa mǝnana Ɓakuli túrí ka, kǝ na gì Ɓakuli, acemǝnana Ɓakuli soapi wi Bangŋo male puppup. <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />Ɓakuli earce Muni sǝ nyinggi wi girbunda kat a buì.<note caller="+" style="f"><char style="fr" closed="false">3:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 11:27">Mat 11:27</ref>; <ref loc="LUK 10:22">Luk 10:22</ref></char>.</note> <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />Koya ɓwa na sǝ pà ɓamúrì aban Muna mala Ɓakuli ka, ndanǝ yilǝmu mǝnana málá male pà kàm raka. Sǝ ɓwa mǝnana kat ɓinǝ Muna mala Ɓakuli ka pà nǝ̀ kum yilǝmu ɗang, bumlulla mala Ɓakuli ka nǝ̀ ueo amurí.<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">Yesu nacau andǝ ɓe ɓwama Samariya</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />Yesu sǝlǝ ama amǝ Farisi ongŋǝna ce ama yì ka, nda arǝ kum amǝkpate pas sǝ nda arǝ pakkia wia batisǝma kútì mala Yohana. <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />(Aɓa mǝsǝcau ka, Yesu nǝ ɓamúrì ka pakki kǝɓwa batisǝma ɗàng, alaggana male na à pakkiyi ka.) <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />Lang Yesu yi sǝlǝ ama amǝ Farisi ongŋǝna ama amǝkpate nǝ̀ nggǝ̀ làkkì ka, nying bu-nzali Yahudi, nyare o ɗǝm a bu-nzali Galili. <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />O male ka dumǝni wi púp nǝ̀ ara aɓa nzali Samariya.<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />Lang yina a nzali Samariya ka, pǝlǝa yiu a ɓe la mǝnana à tunǝki ama Saika ka; banì sapi nzali mǝnana Yakupu pe muni Yisǝfu a pwarian ngga ɗang.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 33:19">Tite 33:19</ref>; <ref loc="JOS 24:32">Jes 24:32</ref></char>.</note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />Tūli-mùr mala Yakupu ka, nda abanì. Yesu aulǝna nǝ gya nǝ pwari zǝkya ka, yi do a kun tūli-mùrî nǝ̀ usǝlǝo.<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />Ɓè ɓwama Samariya yiu a to mùr, sǝ Yesu ne wi ama, <char style="wj">&lt;&lt;Ɗàrǝâm mùr mǝ nu.&gt;&gt;</char> <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />(Anggo ka alaggana male warina a kúr girlina aɓa là.)<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />Sǝ ɓwame pǝlǝa ne Yesu ama, &lt;&lt;A nda ɓwa Yahudi, sǝ mǝ nda ɓwa Samariya. Lang sǝ a nǝ zǝm mùr-nùná a buam yi mǝnana kǝgìr kǝ kpapi amǝ Yahudi andǝ amǝ Samariya raka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZR 4:1-5">Ezr 4:1-5</ref>; <ref loc="NEH 4:1-2">Nehe 4:1-2</ref></char>.</note> <note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">kǝgìr kǝ kpapi amǝ Yahudi andǝ amǝ Samariya raka: </char><char style="ft" closed="false">Ko &lt;&lt;amǝ Yahudi nukiyi gir ko à likiyi gir a kwar mwashat andǝ amǝ Samariya raka.&gt;&gt;</char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />Yesu eari wi ama, <char style="wj">&lt;&lt;Ɓǝ̀ a súrǝ́nà rǝ ɓoro mǝnana Ɓakuli ndanǝi aceo, andǝ ɓwa mǝnana zǝmggiyio mùr-nùná ka, ɓǝ́ a zǝmni wi mùr mǝnana pākiyi yilǝmu ka, sǝ yì ka, nǝ̀ po.&gt;&gt;</char><verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />Ɓwame na ama, &lt;&lt;Ɓwamǝgule, a panǝ gir nun mur ɗang, sǝ tūli ka mǝlime na. Ake sǝ a nǝ kum mǝnia yì mur mǝnana kǝ pa yilǝmu ka? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />A kútì kà sǝm Yakupu mǝnana pà sǝm mǝnia yì tūli, mǝnana yì nǝ nggearǝì, andǝ amuni, andǝ agirkusǝu malea à nu mur kàm ngga le?&gt;&gt;<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />Pǝlǝa Yesu ne wi ama, <char style="wj">&lt;&lt;Ɓwa mǝnana kat nu mùr man ngga nǝ̀ ok mǝsamur ɗǝm.</char> <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" /><char style="wj">Sǝ ɓwa mana kat nǝ̀ nu mùr mǝnana mǝ nǝ pe wi ka, pà nǝ̀ ok mǝsamur ɗǝm ɗàng. Mùr mǝnana mǝ nǝ pe wi ka, nǝ̀ duk mgbeɗe mùr a bumi mana nǝ̀ nggǝ pe wi yilǝmu mǝnana tè pà nǝ̀ mal raka.&gt;&gt;</char><verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />Ɓwame banggi wi ama, &lt;&lt;Ɓwamǝgule, pam mǝnia yì mur ka, ace mǝnana mǝsamur ɓǝ̀ kǝa walam ɗǝm ɗàng, sǝ ɓǝ̀n ngga nyarki kani aban toki mur raka.&gt;&gt;<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />Yesu ne wi ama, <char style="wj">&lt;&lt;Kyane kya tunǝ burio wu yiu.&gt;&gt;</char><verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />Ɓwame ne Yesu ama, &lt;&lt;Ən panǝ bura ɗang.&gt;&gt;</para>
  <para style="p" vid="JHN 4:17">Yesu banggi wi ama, <char style="wj">&lt;&lt;A bangŋǝna mǝsǝcau yì mǝnana a na ama, a panǝ bura raka.</char> <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" /><char style="wj">Mǝsǝcau ka nda mǝnana ama, a dumǝna nǝ aburana tongno, sǝ ɓwa mǝno ado a nda tè ka burio na ɗang. Cau mǝnana a ne ka mǝsǝcau na.&gt;&gt;</char><verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />Ɓwame na ama, &lt;&lt;Ɓwamǝgule, ǝn nggǝ sǝni kǝla we ka a nda mǝɓangnǝa mala Ɓakuli. <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />Aká sǝm peri a ban Ɓakuli amur nkono Gerizim man, sǝ wun amǝ Yahudi ka, wu na ama Urǝshalima nda ban mǝnana duk púp sǝm nǝ̀ peri kàm ngga.&gt;&gt;<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />Yesu eari wi ama, <char style="wj">&lt;&lt;Ɓwama, earnǝ cau mǝnana ǝn nggǝ banggo ka. Pwari nda kǝ yiu ka mǝnana peri a ban Ɓakuli ka, pà nǝ̀ pa amur nkono man ko aɓa Urǝshalima ka ɗàng.</char> <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" /><char style="wj">Wun amǝ Samariya ka, wu kǝ peri a ban ɓwa mǝnana wu súrǝì raka, sǝ sǝm, amǝ Yahudi ka, sǝm sùrǝ́nà rǝ ɓwa mǝnana sǝm nggǝ peri a baní ka. Acemǝnana amsǝban ngga pur nǝban amǝ Yahudi.</char> <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" /><char style="wj">Sǝ pwari nda kǝ yiu ka, yàle pwari nì yina, mǝnana amǝperi mǝ'mǝsǝcau nì nǝ̀ nggá peri a ban Ɓakuli nǝ ɓabumia kat nǝ mǝsǝcau. Yia ka à nda ka ulang amǝperi mǝnana Ɓakuli earkiyi cea ka.</char> <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" /><char style="wj">Ɓakuli ka Bangŋo na, sǝ amǝperi a baní ka, dumǝna púp, à nǝ̀ peri nǝ ɓabumia kat nǝ mǝsǝcau.&gt;&gt;</char><verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />Pǝlǝa ɓwame ne Yesu ama, &lt;&lt;Ən sǝlǝna ama, Mǝ'amsǝban mǝnana à kǝ tunǝi ama Kǝrǝsti ka nǝ̀ yiu. Ɓǝ̀ yina ka, nǝ̀ yia mǝngia sǝm ɓalǝ agir kat.&gt;&gt;<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />Sǝ Yesu banggi wi ama, <char style="wj">&lt;&lt;Mim ɓwa mǝnana ado nakiyi cau nǝ we ka, Mǝ nda kǝ yì.&gt;&gt;</char><verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />Anggo ka, alaggana mala Yesu yi tusǝo, à ndali mǝnana à yì kumi aban nacau andǝ ɓwama ka. Sǝ kǝɓwa ɗì ɓwame ama, mana a alkite ka ɗàng. Sǝ kǝɓwa ɗì gbal ama, ace mana sǝ a kǝ nacau nǝ ɓwame ka ɗàng.<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />Sǝ ɓwame nying bàng-mùr male nyare o a la kya ne aɓwana ama, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />&lt;&lt;Wu yiu, wu yi sǝn ɓwa mǝnana nam koya gìr nani ǝn pa aɓa do mem ngga! Ko ɓwa man nda Kǝrǝsti Mǝ'amsǝban le?&gt;&gt; <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />Pǝlǝa ɓwapǝndǝa purrì là à yiu a ban Yesu.<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />Anggo ka, alaggana mala Yesu zǝmbi wi ama, &lt;&lt;Rabbi, yiu li girlina.&gt;&gt;<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />Yesu pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Mǝ ndanǝ girlina mǝnana wu súrǝ̀ kǝgìr amurí raka.&gt;&gt;</char><verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />Sǝ alaggana male kutia ɗiki rǝia ama, &lt;&lt;Kǝ ɓwa yinǝì wi nǝ girlina le?&gt;&gt;<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />Yesu nea wia ama:</para>
  <para style="pi" vid="JHN 4:34">
    <char style="wj">Girlina mem nda ɓǝ̀n pak gir mǝnana Tárrám mana túrǎm ngga earkiyi ce, sǝ ɓǝ̀n masǝlǝta túró male mǝnana pam ɓǝ̀n pe ka.</char> <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" /><char style="wj">Wun nǝ̀ naki mbak ama, ueo zongŋo ine à nǝ̀ pwan girɓaban? Sǝ ǝn nggǝ na wun, wu loasǝ amǝsǝ wun, wu sǝn agirɓaban, à ɓǝlna, à kārǝ́na pwano.</char><verse eid="JHN 4:35" /></para>
  <para style="pi">
    <verse number="36" style="v" sid="JHN 4:36" />
    <char style="wj">Ɓwa mǝnana nda ban pwan girɓaban ngga, Ɓakuli na arǝ pe wi tangnakusǝi, sǝ ndarǝ pwan girɓaban mala yilǝmu mǝnana tè pà nǝ̀ mal raka; ace mani ka mǝɓeale andǝ mǝ'pwan girɓaban ngga ban nǝ ɓoaria wia atārǝia.</char> <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" /><char style="wj">Anggo ka cau mǝnana à kǝ ne ama, &lt;&lt;Ɓè ɓwa ɓeale, sǝ ɓeɓwa pwan&gt;&gt; ngga, dumǝna mǝsǝcau.</char> <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" /><char style="wj">Ən tasǝ wun, wu kya pwan girɓaban mǝnana wu nda wu ɓeal raka; aɓea aɓwana nda à ɓeale, sǝ wun ngga wu kya kum tangnakusǝ túró mǝnana à pak ka.</char><verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />Amǝ Samariya pas a mǝno yì là ka, à pa ɓamuria a ban Yesu atàcau mala ɓwama mǝnana banggia wia ama, &lt;&lt;Nam koya gìr nani ǝn pa aɓa do mem ngga.&gt;&gt; <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />Lang amǝ Samariyi yiu a ban Yesu ka, à yì zǝmbi wi ɓǝ̀ do ateà, pǝlǝa Yesu do pak nongŋo ɓari a bania.<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />Ɓwamǝpǝndǝe pas ɗǝm à yì pa ɓamuria a ban Yesu ace cau male. <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />Pǝlǝa yia ka à ne mǝno yì ɓwama ka ama, &lt;&lt;Ado ka pa ace cau mo sǝ sǝm pà ɓamur sǝm a baní ka ɗàng, nggearǝ sǝm ngga sǝm ongŋǝni nǝ kir sǝm. Sǝm sǝlǝna ama, aɓa mǝsǝcau ka, yì nda Mǝ'amsǝ ɓanza.&gt;&gt;<verse eid="JHN 4:42" /></para>
  <para style="s">Yesu twalban rǝkwana <optbreak /> mala muna mala <optbreak /> ɓè mǝtamurǝm</para>
  <para style="r">(<ref loc="MAT 8:5-13">Matiu 8:5-13</ref>; <ref loc="LUK 7:1-10">Luka 7:1-10</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />Anzǝm mǝnana Yesu pàngŋǝ̀nà nongŋo ɓari a banì ka, lo o a Galili. <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />Yesu nǝ ɓamúrì ka bangŋǝna ama, &lt;&lt;À kǝ pê mǝɓangnǝa mala Ɓakuli gulo a la male ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:44 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 13:57">Mat 13:57</ref>; <ref loc="MRK 6:4">Mar 6:4</ref>; <ref loc="LUK 4:24">Luk 4:24</ref></char>.</note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />Lang yi bwalǝna Galili ka, ɓwapǝndǝa gingsǝi à é nǝ bu ɓari, acemǝnana yia ka à warina a Urǝshalima a ban Lamsan Yàlîmurû, sǝ à sǝnǝna agir mǝnana Yesu pea a banì kat ka.<note caller="+" style="f"><char style="fr" closed="false">4:45 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 2:23">Yoh 2:23</ref></char>.</note><verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />Aɓa gya mala Yesu aɓa nzali Galili ka, kya kútí ɗǝm a Kana, la mǝnana tsǝk mùr pǝlǝ mùr-ɓǝlanggun anap kàm ngga.<note caller="+" style="f"><char style="fr" closed="false">4:46 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 2:1-11">Yoh 2:1-11</ref></char>.</note> Ɓè mǝtamurǝm nda kam a Kapanahum, muni ka mǝkwánó na. <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />Lang mǝnia yì ɓwa ongŋǝna ama Yesu nyìngŋǝ̀nà bu-nzali Yahudi yina a Galili ka, pǝlǝa wari a baní kya zǝmbi wi ɓǝ̀ yiu a Kapanahum ɓǝ̀ kya twalban rǝkwana mala muni mǝnana nda kúnlú ka. <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />Sǝ Yesu ne wi ama, <char style="wj">&lt;&lt;Ɓǝ̀ wu sǝn gìr-gyambǝliban andǝ gir'ndǝlǝki raka pà wun nǝ̀ earnǝ mim ɗang.&gt;&gt;</char><verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />Mǝtamurǝm ni pǝlǝa ne Yesu ama, &lt;&lt;Ɓwamǝgule, yiu atàm tù, ce munem masǝlǝa arǝàm ɗàng.&gt;&gt;<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />Yesu ne wi ama, <char style="wj">&lt;&lt;Kyane, munio pà nǝ̀ wu ɗàng.&gt;&gt;</char> Ɓwabura man earnǝ cau mala Yesu, pǝlǝa nyare aban o. <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />Nda ban o ka, amuna-ɓala male yi kasǝi a njar à ne wi ama, &lt;&lt;Munio ka auna, rǝì malǝna.&gt;&gt;<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />Sǝ ɗia ama, &lt;&lt;Nǝ ya bu-pwari sǝ rǝ muna tita malâ?&gt;&gt; Sǝ à ne wi ama, &lt;&lt;Nda yilung nǝ bu-pwari mwashat mala pwari, sǝ ɓauwa nyi.&gt;&gt; <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />Pǝlǝa ɓalǝ tár muna kasǝa ama, nda aɓa kǝ bu-pwari mǝnana Yesu ne wi nǝi ama, <char style="wj">&lt;&lt;Kyane, munio pà nǝ̀ wu ɗàng.&gt;&gt;</char> Pǝlǝa yì andǝ amǝ'ɓala male pà ɓamuria aban Yesu.<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />Mǝnia ka nda ɓaria gir'ndǝlǝki mǝnana Yesu pè ka. Pè anzǝm mǝnana nyìngŋǝ̀nà bu-nzali Yahudi yina a Galili ka.<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">Yesu twali gbakǝre ban rǝkwana</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />Anzǝm man ngga, Yesu wari a Urǝshalima a ɓe lamsan mala amǝ Yahudi. <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />Aɓa Urǝshalima ka, ɓe guguri nakam a Kun njar mala anzur mǝnana à tunǝki nǝ kun mala amǝ Yahudi ama Beseda ka. À gumbǝli nǝ atara tongno. <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />Aɓalǝ amǝnia yì atara ka sǝ amǝ rǝkwana pas, ante, andǝ agbakǝre andǝ aɓwana mǝnana aɓea barea wu ka, à kǝ nongŋo [aban kundǝ zurǝì mùr.] <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />Acemǝnana arǝ aɓea apwari ka, mǝturonjar mala Mǝtalabangŋo kǝ zurǝi mùr. Anzǝm zurǝi mùr ka, mǝkwánó mǝnana ak dǝmba kutio a mùr ka, ɓǝ̀ ya ulang kwánó ndanǝi ka, nǝ̀ mal kat. <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />Ɓè ɓwabura nakam abanì, pàngŋǝ̀nà apǝlǝa lumi-tàrú-bwamdǝ-tongno-nong-tàrú aban nongŋo nǝ rǝkwana. <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />Yesu sǝni aban nongŋo, sǝ sǝlǝna ama sauwuna aɓa rǝkwana male, pǝlǝa ɗì ama, &lt;&lt;A kǝ́ earce ɓǝa twalo ban rǝkwana mo le?&gt;&gt;<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />Mǝkwánó ear ama, &lt;&lt;Ɓwamǝgule, ǝn panǝ kǝɓwa a muram, mǝnana ɓǝa zurina mùr ka nǝ̀ ramtam aɓa guguri ka ɗang. Ɓǝ̀ mǝ nda ban ɓariki mǝ nǝ kútí ka, kara ɓeɓwa nǝ̀ akàm dǝmba.&gt;&gt;<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />Yesu ne wi ama, &lt;&lt;Lo, twal kala mo o!&gt;&gt; <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />Àkǝ̀ banì rǝkwana male malâ, lo twal kala male aban o.</para>
  <para style="p" vid="JHN 5:9">Pwari mǝnana à pak mǝnia yì gir ka pwari Sabbat na, pwari usǝlǝo mala amǝ Yahudi. <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />Pǝlǝa aɓwana-mǝgule mala amǝ Yahudi ne ɓwa mǝnana à twali wi ban rǝkwana ka ama, &lt;&lt;Yalung ngga pwari usǝlǝo na, Nggurcau ma'sǝm eare ama wu twal kal nongŋo mo a pwari usǝlǝo ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NEH 13:19">Nehe 13:19</ref>; <ref loc="JER 17:21">Ir 17:21</ref></char>.</note><verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />Pǝlǝa nea wia ama, &lt;&lt;Ɓwa mǝnana twàlâm-ban rǝkwana ka nǝ̀ nam ama, mǝ twal kala mem mǝ o.&gt;&gt;<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />Sǝ à ɗì ama, &lt;&lt;Yana ɓwe na no ama wu pak mǝnia yì gir ka?&gt;&gt;<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />Ɓwa mǝnana à twali wi ban rǝkwana ka súrǝ̀ yana nda Yesu ɗang, acemǝnana ɓwapǝndǝa làkkì pas abanì, sǝ Yesu kongŋǝna aɓalǝ aɓwana.<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />Anzǝm mani ka Yesu kumi aɓa Ndàmǝgule mala Ɓakuli, sǝ ne wi ama, &lt;&lt;Sǝni ado ka à twalǝ́nò ban rǝkwana, nying pàkki acauɓikea, ɓǝ̀ ana raka gìr mǝɓane mǝnana kútì mǝno ka nǝ̀ kumǒ.&gt;&gt; <verse eid="JHN 5:14" /><verse number="15" style="v" sid="JHN 5:15" />Pǝlǝa ɓwe o kya ne aɓwana-mǝgule mala amǝ Yahudi ama Yesu nǝ̀ twali wi ban rǝkwana male. <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />Pǝlǝa yia amǝ Yahudi ka à tsǝk Yesu a dǝmba, acemǝnana twalban rǝkwana a pwari Sabbat, pwari usǝlǝo. <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />Yesu banggia wia ama, &lt;&lt;Ko aya pwari ka Tárrám nda mur túró, ace mani ka dumǝna púp ama, mim gbal ka mǝ nǝ pak túró.&gt;&gt;<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />Ace mani ka, aɓwana-mǝgule mala amǝ Yahudi ɓariki kǝ̀rkǝ́r ama à nǝ̀ wal-lú Yesu, acemǝnana yàl nzongcau mala Sabbat nǝmurǝì ɗàng, tunǝ Ɓakuli ama Tárrí. Anggo ka ndaban karǝ ɓamúrì arǝ Ɓakuli.<verse eid="JHN 5:18" /></para>
  <para style="s">Rǝcandǝa mala Yesu <optbreak /> Muna mala Ɓakuli</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />Yesu earia wia ama:</para>
  <para style="pi" vid="JHN 5:19">Ən nggǝ na wun mǝsǝcau, pà mǝ nǝ pak kǝgìr aɓa ɓamúràm ɗang. Kǝ gìr mǝnana ǝn sǝn Tárrám Ɓakuli pak ka, nda ǝn pakkiyi ka. Gìr mǝnana kat Tárrám pak ka, nda mana ǝn pakkiyi ka. <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />Ɓakuli Tárrú ka kǝ earcem mim Muni, sǝ kǝ lǝmdǝam agir mǝnana kat yì nǝ nggearǝì pakkiyi ka. Yàle nǝ̀ lǝmdǝam agir mǝgulke mǝnana à kútì man ngga, sǝ wun kat wun nǝ̀ nggǝ ndalǝki. <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />Kǝla mǝnana Ɓakuli Tárrám kǝ loasǝ alú sǝ kǝ pea wia yilǝmu ka, anggo sǝ mim Muni ka mǝ nǝ pea aɓwana mǝnana ǝn earce mǝ nǝ pea wia ka yilǝmu.<verse eid="JHN 5:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="JHN 5:22" />Tárrám nǝ ɓamúrì ka kǝ ɓashi kǝɓwa ɗàng, panam mim Muni rǝcandǝa mala ɓashi kat, <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ace mǝnana ɓǝ̀ aɓwana kat pam gulo kǝla mǝnana à pe Tárrám Ɓakuli ka. Ɓwa mǝnana kat pam gulo raka, pà aban pê Tárrám mǝnana tasǝam ngga gulo ɗang. <verse eid="JHN 5:23" /><verse number="24" style="v" sid="JHN 5:24" />Mǝ nda ban na wun mǝsǝcau, ɓwa mǝnana kat kǝ ok cau mem, sǝ kǝ pa ɓamúrì a ban Tárrám mǝnana tasǝam ngga, ndanǝ yilǝmu mǝnana masǝlǝate pà kàm raka. Ɓashi pà nǝ̀ sulǝo amurí ɗang, yì ka, angŋǝna dǝmba yàlǝ́nì lú, kutina a yilǝmu.<verse eid="JHN 5:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JHN 5:25" />Mǝ nda ban na wun mǝsǝcau, pwari nda ban yiu, yàle pwari nì pàngŋǝ̀nà, mǝnana aɓwana mana alú na ka à nǝ̀ ok gi Muna mala Ɓakuli, sǝ aɓwana mǝnana à o ka, à nǝ̀ long nǝ yilǝmu. <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />Kǝla mǝnana Tárrám Ɓakuli nda tǝr yilǝmu ka, anggo gbal panam mim Muni ɓǝ̀ ǝn duk tǝr yilǝmu. <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />Sǝ ɗǝm ngga panam rǝcandǝa mala ɓashi, acemǝnana mǝ nda Muna mala Ɓwa.<verse eid="JHN 5:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="JHN 5:28" />Wu kǝa ndali arǝ man ɗang, pwari nda kǝ yiu ka, mǝnana alú mana aɓalǝ aɓembe malea ka, à nǝ̀ ok gi Muna mala Ɓwa <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />sǝ à nǝ̀ purî ɓalǝ aɓembe. Aɓwana mǝnana à pak mǝɓoarne ka, à nǝ̀ lo à nǝ̀ kutia yilǝmu, sǝ aɓwana mǝnana à pak mǝɓane ka, à nǝ̀ lo sǝ à nǝ̀ kum ɓashi.<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 12:2">Dan 12:2</ref></char>.</note><verse eid="JHN 5:29" /></para>
  <para style="pi">
    <verse number="30" style="v" sid="JHN 5:30" />Pa mǝ nǝ pak ɓè kǝgìr aɓa rǝcandǝa mem ɗàng. Ən nggǝ pak ɓashi mem à pě mǝnana Ɓakuli banggàm ɓǝ̀n nggǝ pe ka. Ace mani ka, ɓashi mem ngga nda amur njarì, acemǝnana ǝn pa aban ɓariki mǝ nǝ pak gìr mǝnana ǝn earkiyice ka ɗàng. Kǝ nggearǝ mǝsǝrǝ gir mǝnana Tárrám mana túrǎm ngga earkiyi ce ka, nda ǝn nggǝ pe ka.<verse eid="JHN 5:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="JHN 5:31" />Ɓǝ̀ ǝn nacau amur ɓamúràm ngga, cau mem ka, à pà nǝ̀ é kǝla mǝsǝcau ɗang. <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />Sǝa ma ɓeɓwa nda kam mǝnana kǝ nakunam ngga, sǝ ǝn sǝlǝna ama acau mǝnana nea a muram ngga mǝsǝcau na.<verse eid="JHN 5:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="JHN 5:33" />Yohana Mǝbatisǝma nda ɓwa mǝnana wu tasǝ amǝturonjar ma'wun a baní, sǝ na wun mǝsǝcau a muram ngga.<note caller="+" style="f"><char style="fr" closed="false">5:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 1:19-27">Yoh 1:19-27</ref>; <ref loc="JHN 3:27-30">3:27-30</ref></char>.</note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />Kat andǝ amani ka, ǝn pa aban came amur nakún mala ɓwamǝpǝndǝe ɗang; mǝ nda ban na anggo ace mǝnana wun ngga ɓǝ̀ wu kum àwá. <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />Yohana ka nda kǝla pitǝla mana kǝ earke sǝ kǝ ta ka, sǝ wun ngga wu eare wun nǝ̀ pak banɓoarnado zuku arǝ tǎlaban male.<verse eid="JHN 5:35" /></para>
  <para style="pi">
    <verse number="36" style="v" sid="JHN 5:36" />Sǝ mǝ ndanǝ mem yi nakún a muram mǝnana kútì mana Yohana na a muram ngga. Agir mǝnana ǝn nggǝ pakkia ka, atúró mǝnana Tárrám pam ama ɓǝ̀n pakkia ka à nda. À kǝ̀ nakunam, sǝ à kǝ̀ lǝmdǝ ama Tárrám nǝ̀ túrǎm.<verse eid="JHN 5:36" /></para>
  <para style="pi">
    <verse number="37" style="v" sid="JHN 5:37" />Sǝ Tárrám mǝnana tasǝam ngga náná kunam. Wu malaká ok gì àkǝ̀ pwari ɗàng, sǝ wu malaká sǝn ɓamǝsǝi gbal ɗàng.<note caller="+" style="f"><char style="fr" closed="false">5:37 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char>.</note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />Sǝ wun ngga nggearǝ cau male pa a ɓabum wun ɗàng, acemǝnana wu earnǝ mim mǝnana Ɓakuli tasǝi ka ɗàng.<verse eid="JHN 5:38" /></para>
  <para style="pi">
    <verse number="39" style="v" sid="JHN 5:39" />Wu kǝ ɓalla andǝ mǝngi ɓá Malǝmce, acemǝnana wu kǝ sǝni kǝla aɓalǝi sǝ wu nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka, sǝ aman yì acau wu ɓalkiyi ka, mǝ nda à nakiyi cau a muram ngga. <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />Kat andǝ amani ka, wu ɓinǝ yiu a banam ace kum yilǝmu.<verse eid="JHN 5:40" /></para>
  <para style="pi">
    <verse number="41" style="v" sid="JHN 5:41" />Ɓwangsǝban mala ɓwapǝndǝa nda ǝn alkite ka ɗàng. <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />Sǝ mim ngga ǝn súrǝ́nà rǝ wun, ɗǝm ngga ǝn sǝlǝna nǝma wu pànǝ earce Ɓakuli a ɓabum wun ɗàng. <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />Ən yiu aɓa lullǝ Tárrám, sǝ wun ngga wu em ɗang, sǝ ɓǝ̀ ɓeɓwa yiu aɓa rǝcandǝa male ka wun nǝ̀ earnǝi, wun nǝ̀ é. <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />Lang sǝ wun nǝ̀ earnǝ mim, yi mǝnana wu kǝ earce ak ɓwangsǝban arǝarǝ wun, sǝ wu kǝ ɓariki ama wun nǝ̀ kum ɓwangsǝban a ban ɓwa mǝnana yì mwashat nda Ɓakuli ka, ɗàng?<verse eid="JHN 5:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="JHN 5:45" />Wu kǝa sǝni kǝla mǝ nda ɓwa mǝnana nǝ̀ oasǝkimur wun a ban Tárrám ka ɗàng. Musa mǝnana wu tsǝkɓalǝ wun arǝì ka, nda kǝ ɓwa mǝnana nǝ̀ oasǝki mur wun ngga. <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />Ɓǝ̀ kàngkàng wu earǝna nǝ Musa ka, ɓǝ́ wu earǝna nǝ mim, acemǝnana mǝ nda ɓwa mǝnana Musa gilǝ cau a muram ngga. <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />Sǝ mǝnana wu ginǝ earnǝ gir mǝnana Musa gilǝ ka, lang sǝ wun nǝ̀ earnǝ gir mǝnana ǝn na ka?<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">Yesu linǝ́ aɓwana á-tongno</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matiu 14:13-21</ref>; <ref loc="MRK 6:30-44">Markus 6:30-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />A ɓe pwari anzǝm man ngga Yesu eauwe a nkaring Garang Galili, mǝnana à tunǝki gbal ama, Garang Tiberiya ka. <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />Ɓwabunda mǝ'làkke o atè, acemǝnana à sǝn agir-ndǝlǝki mǝnana twalban rǝkwana ka. <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />Yesu pǝlǝa eauwe amur nkono sǝ do andǝ alaggana male. <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />Anggo ka pwari Lamsan Yàlîmurû<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">Lamsan Yàlîmurû: </char><char style="ft" closed="false">Pakkiɗire ace ɗenyi nǝ pwari purî ɓá do guro mala amǝ Isǝrayila aɓa nzali Masar.</char></note> mala amǝ Yahudi gbashìnà. <verse eid="JHN 6:4" /><verse number="5" style="v" sid="JHN 6:5" />Lang Yesu loasǝ muri sǝn nggea làkkì mala ɓwapǝndǝa aban yiu a baní ka, pǝlǝa ɗì Filip ama, &lt;&lt;Ake sǝ sǝm nǝ̀ kúr girlina mǝnana aɓwabundǝa man kat nǝ̀ lì ka?&gt;&gt; <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />Yesu na mǝnia yì cau ka nǝ̀ mwam Filip; aɓa mǝsǝcau ka súrǝ́nà rǝ gir mǝnana nǝ̀ pak ka.<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />Filip eari wi ama, &lt;&lt;Ko ɓǝ̀ dinari<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="fq" closed="false">dinari: </char><char style="ft" closed="false">Ko &lt;&lt;boalo túró zongŋo tongno-nong-tàrú.&gt;&gt;</char></note> na à nǝ̀ walo ace kúr girlina mǝnana ɓǝ̀ koya ɓwa nani ka ɓǝ̀ li ka, pà nǝ̀ karǝ ɗang.&gt;&gt;<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />Sǝ ɓeɓwa mwashat aɓalǝ alaggana male, Andǝru mǝ'eam Shiman Bitǝrus, ne Yesu ama, <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />&lt;&lt;Ɓè mǝlagga ndya a kani nǝ agbatali nɗǝmo muku-bale tongno andǝ anji ɓari, sǝ mǝno ka, nǝ̀ karǝ man a ban mǝnia yì làkkì mala ɓwabundǝa ka.&gt;&gt;<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />Yesu ne alaggana male ama, &lt;&lt;Wu ne aɓwana ɓǝà dumnǝdo.&gt;&gt; Pǝlǝa yia kat à do amur munabondo a banì. (Làkkì mala aburana nǝmurǝia ka bwal á-tongno.) <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />Yesu pǝlǝa twal akuro-nɗǝmo, pakki Ɓakuli yàwá, sǝ gaki aɓwana mǝno à dumnǝdo ka. Anggo sǝ pang nǝ anji. Yia mǝno kat ka à lìli girlina kárǝìa. <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />Anzǝm mǝnana à ɗǝmgina kat ka, pǝlǝa Yesu ne alaggana male ama, &lt;&lt;Wu ramgi acili girlina mǝnana à ué ka ace mǝnana kǝgìr ɓǝ̀ kǝa kìɗìkì ɗang.&gt;&gt; <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />Pǝlǝa à ramgi ɓwangine girlina mǝnana ɓwapǝndǝa li sǝ à nying cili aɓa kuro-nɗǝmo muku-bale tongno ka, à lumsǝki andakade lum-nong-ɓari nǝia.<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />Lang aɓwana mǝno nǝ sǝn gir'gyambǝliban mǝnana Yesu pe ka, à na ama, &lt;&lt;Mǝsǝcau, mǝnia yì ɓwa ka nda mǝɓangnǝa mala Ɓakuli mǝnana sǝm kundǝkiyi yiu male a ɓanza ka!&gt;&gt; <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />Sǝ lang Yesu yi sǝlǝna ama, à ndo à nǝ̀ yia bwali à nǝ̀ tsǝì ɓǝ̀ dupia wia murǝm púp ka, pǝlǝa nyar zàng amur nkono nǝmurǝì.<verse eid="JHN 6:15" /></para>
  <para style="s">Yesu gya amúr mùr</para>
  <para style="r">(<ref loc="MAT 14:22-33">Matiu 14:22-33</ref>; <ref loc="MRK 6:45-52">Markus 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />Lang pwari kpana ka, alaggana mala Yesu kutio aban ká a kun garang. <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />À kya eauwe aɓa waru à nǝ̀ nyare aban o a nkaring garang a Kapanahum. Anggo ka ban bwalǝna sǝ Yesu malaká yiu abania ɗang. <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />Banì sau ɗang nggea gung mǝcandǝe lo ɓua sǝ nda rǝ eaki nkono amúr mùr. <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />Anzǝm mǝnana à samsǝna, à bwalǝna kǝla mel tàrú ko ine ka, kara à sǝn Yesu aban gya amúr mùr, kǝ yiu nǝ ban waru, sǝ yia ka ɓangciu pakkia wia kǝ̀rkǝ́r. <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />Sǝ Yesu banggia wia ama, &lt;&lt;Mǝ nda, ɓǝ̀ ɓangciu ɓǝ̀ kǝa pakka wun ɗang.&gt;&gt; <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />Pǝlǝa à eare à twali ateà aɓa waru, sǝ zuku ka waru yi kpashina a kún múr aban mǝnana à tsǝk múrià kam ngga.<verse eid="JHN 6:21" /></para>
  <para style="s">Aɓwana alta Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />Ban fana ka, ɓwabundǝa mǝnana ueo a nkaring mur mǝnana Yesu nyi ka, à yì sǝlǝ ama, kǝ waru na mwashat abanì, sǝ à sǝlǝna ama Yesu eauwe atà alaggana male ɗang, sǝ o malea ka pà ateà ɗang. <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />Aɓea waru mǝnana à pùr a Tiberiya ka à yiu à kya kpashi tù nǝ́ ban mǝnana Mǝtalabangŋo pak yàwá amur girlina sǝ pè ɓwapǝndǝa à li kam ngga. <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />Lang ɓwabundǝa sǝni ka Yesu andǝ alaggana male pà abanì raka, à kutiki aɓalǝ awaru mǝno sǝ à o a Kapanahum, aban alta Yesu.<verse eid="JHN 6:24" /></para>
  <para style="s">Yesu nda girlina mala yilǝmu</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />Lang à yì kumǝni a ɓe nkaring garang ngga, à ɗì ama, &lt;&lt;Rabbi,<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="fq" closed="false">Rabbi: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkanigir, ko Malǝm&gt;&gt;</char></note> a ya pwari sǝ a yiu kani?&gt;&gt;<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />Yesu earia wia ama, &lt;&lt;Mǝ nda ban na wun mǝsǝcau, wu pà aban altam acemǝnana wu sǝn agir-ndǝlǝki ka ɗang, nda ace girlina mǝnana wu li wu ɗǝmnggi ka. <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />Sǝ wu kǝa wu pak túró ace girlina mǝnana kǝ kiɗiki ka ɗang; wu pak túró ace girlina mǝnana nǝ̀ pà wun yilǝmu mǝnana málá male pà kàm raka. Mǝnia ka nda girlina mǝnana Muna mala Ɓwa nǝ̀ pà wun ngga, acemǝnana Tárrú, yì Ɓakuli ka, tsǝ̀ngŋǝ̀nà buì ama earǝna nǝi.&gt;&gt;<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />Pǝlǝa à ɗì Yesu ama, &lt;&lt;Mana sǝm nǝ̀ pa ace mǝnana ɓǝ̀ sǝm pàk gìr mana Ɓakuli earce ama ɓǝ̀ sǝm pàk ka?&gt;&gt; <verse eid="JHN 6:28" /><verse number="29" style="v" sid="JHN 6:29" />Yesu earia wia ama, &lt;&lt;Gìr mǝnana Ɓakuli earkiyice ama ɓǝ̀ wu pàk ka, nda mǝnana ama, wu pa ɓamur wun aban ɓwa mǝnana túrí ka.&gt;&gt;<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />À ɗì Yesu ama, &lt;&lt;Sǝ, ya ulang gìr pa-ndǝlǝki na a nǝ pa ace mǝnana ɓǝ̀ sǝm sǝni sǝ ɓǝ̀ sǝm earnǝ we ka? Mana awu nǝ pa? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />Aká sǝm li girlina mǝnana à tunǝki ama &lt;Manna&gt; ka aɓa gya malea aɓa pǝɗanban a njenza. Malǝmce na ama, &lt;Musa pea wia girlina mǝnana pur nǝ kuli ka ɓǝà li.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 16:4">Pur 16:4</ref>; <ref loc="PSA 78:24-25">Ang 78:24-25</ref>; <ref loc="NEH 9:15">Nehe 9:15</ref></char>.</note><verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />Yesu nea wia ama, &lt;&lt;Mǝ nda ban bangga wun mǝsǝcau, Musa nǝ̀ pa wun girlina mǝnana pur a kùli ka ɗàng, Tárrám na pà wun ngga. Sǝ adyan ngga ndya kǝ pà wun girlina mǝ'mǝsǝcau nì mǝnana pur a kùli ka. <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />Girlina mǝ'mǝsǝcau nì mǝnana Ɓakuli pākiyi ka nda Ɓwa mǝnana sulǝ nǝ kuli sǝ kǝ pè ɓanza yilǝmu ka.&gt;&gt;<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />À ne Yesu ama, &lt;&lt;Ɓwamǝgule, wú kǝ̀ pa sǝm mǝnia yì girlina ka pwari-pwari.&gt;&gt;<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />Pǝlǝa Yesu bang ama:</para>
  <para style="pi" vid="JHN 6:35">&lt;&lt;Mǝ nda girlina mala yilǝmu. Ɓwa mǝnana kat yiu abanam ngga pà nǝ̀ ok nzala ɗǝm ɗàng, sǝ ɓwa mǝnana kat pàɓamuri abanam ngga pà nǝ̀ ok mǝsamur ɗàng ko bǝti. <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />Sǝ ado ka ǝn bangga wun ama wu sǝnǝnam nǝ amǝsǝ wun sǝ kat andǝ amani ka wu earnǝ mim ɗang. <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />Ɓwa mǝnana kat Tárrám pam ngga nǝ̀ yiu abanam, sǝ ɓwa mǝnana kat yiu abanam ngga pà mǝ nǝ ɓínǝì ɗàng.<verse eid="JHN 6:37" /></para>
  <para style="pi">
    <verse number="38" style="v" sid="JHN 6:38" />&lt;&lt;Ən sulǝ nǝ kuli ace pak gìr ɓamúràm ɗàng, ǝn yiu ace pak túró mala Tárrám mǝnana tasǝam ngga. <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />Sǝ mǝnia ka nda kànì mala Tárrám mǝnana tasǝam ngga, ama mǝ kǝa turta kǝɓwa aɓalǝ aɓwana mǝnana pam ngga ɗàng, sǝ a kun mani ka ɓǝn loasǝia kat nǝ yilǝmu a masǝlǝata apwari. <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />Gìr mǝnana Tárrám earkiyice ka, nda mǝnana ama ɓwa mana kat sǝn Muni sǝ paɓamuri a baní ka, ɓǝ̀ kum yilǝmu mǝnana málá male pà kàm raka, sǝ mim gbal ka mǝ nǝ loasǝi nǝ yilǝmu a masǝlǝata apwari.&gt;&gt;<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />Ace mǝno yì cau ka aɓwana-mǝgule mala amǝ Yahudi tita nggwani acemǝnana Yesu bang ama yì ka, nda girlina mǝnana sulǝ nǝ kuli ka. <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />À bang ama, Yesu ka nda muna mala Yisǝfu, mǝnana à súrǝ̀ tárrí andǝ ngge ka. Sǝ palang, adyan sǝ nǝ̀ na ama, sulǝ nǝ kuli?<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />Pǝlǝa Yesu earia wia ama:</para>
  <para style="pi" vid="JHN 6:43">&lt;&lt;Wu ɗeki nggwani a rǝarǝ wun. <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />Kǝɓwa pà nǝ̀ yiu abanam, mǝnana ɓǝ̀ Tárrám mana túrǎm ngga nǝ̀ nunni arǝàm raka. Sǝ mim ngga mǝ nǝ loasǝi nǝ yilǝmu a masǝlǝata apwari. <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />Kǝla mǝnana à gilǝì aɓa Malǝmce mala amǝ'ɓangnǝa ka: &lt;Yia kat ka, Ɓakuli nda nǝ̀ kania wia gìr ka.&gt;<note caller="+" style="f"><char style="fr" closed="false">6:45 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 54:13">Isha 54:13</ref></char>.</note> Lǝmdǝ ama, ɓwa mǝnana kat kǝ kwakikiri arǝ Ɓakuli Tárrú sǝ kǝ kànì a baní ka, nǝ̀ yiu a banam.<verse eid="JHN 6:45" /></para>
  <para style="pi">
    <verse number="46" style="v" sid="JHN 6:46" />&lt;&lt;Mǝnia ka pa aban lǝmdǝ ama, ɓekǝ ɓwamǝpǝndǝe ka sǝnǝna Ɓakuli ɗang; kǝ mim ɓwa mǝnana pur nǝban Ɓakuli ka, nda kǝ mana sǝn Ɓakuli Tárrú ka. <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />Mǝ nda ban bangga wun mǝsǝcau, ɓwa mǝnana paɓamuri abanam ngga, ndanǝ yilǝmu mǝnana málá male pà kàm raka.<verse eid="JHN 6:47" /></para>
  <para style="pi">
    <verse number="48" style="v" sid="JHN 6:48" />&lt;&lt;Mǝ nda girlina mala yilǝmu. <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />Aká wun li girlina mǝnana à tunǝki ama &lt;Manna&gt; ka aɓa pǝɗanban a njenza, sǝ kat andǝ amani ka à wu. <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />Sǝ girlina mǝnana pur nǝ kuli ka ndya ka. Ɓwa mǝnana kat li mǝnia yì girlina ka pà nǝ̀ wu ɗàng. <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />Mǝ nda girlina mala yilǝmu mǝnana sulǝ nǝ kuli ka. Ɓwa mǝnana kat li mǝnia yì girlina ka nǝ̀ dumnǝ yilǝmu mǝnana málá male pà kàm raka. Sǝ mǝnia yì girlina ka nyam nggūrǝam na, mǝnana mǝ nǝ pa ace mǝnana ɓǝ̀ ɓanza kum yilǝmu ka.&gt;&gt;<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />Pǝlǝa amǝ Yahudi kutia makgìr arǝarǝia, sǝ à na ama, &lt;&lt;Lang sǝ ɓwa man nǝ̀ pà sǝm nyam nggūrǝì ama ɓǝ̀ sǝm li?&gt;&gt;<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />Yesu banggia wia ama:</para>
  <para style="pi" vid="JHN 6:53">&lt;&lt;Mǝ nda ban bangga wun mǝsǝcau, ɓǝ̀ wu li nyam nggūrǝ Muna mala Ɓwa sǝ wu nu nkile raka, wu pànǝ yilǝmu aɓalǝ wun ɗàng. <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />Ɓwa mǝnana kat li nyamam sǝ nu nkílèm ngga, ndanǝ yilǝmu mǝnana málá male pà kàm raka, sǝ mǝ nǝ loasǝi nǝ yilǝmu a masǝlǝata apwari. <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />Acemǝnana nyam nggūrǝam ngga girlina mǝ'mǝsǝcau nì na, sǝ nkílèm ngga girnùná mǝ'mǝsǝcau nì na. <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />Ɓwa mǝnana kat li nyam nggūrǝam, sǝ nu nkílèm ngga, nda aban do a ɓalǝam, sǝ mim gbal mǝ ndanǝ do aɓalǝi.<verse eid="JHN 6:56" /></para>
  <para style="pi">
    <verse number="57" style="v" sid="JHN 6:57" />&lt;&lt;Kǝla mǝnana Tárrám mana nǝ yilǝmu ka túrǎm, sǝ àtàcau male sǝ ǝn dum nǝ yilǝmu ka, anggo gbal ɓwa mǝnana li nyam nggūrǝam ngga nǝ̀ dum nǝ yilǝmu àtàcau mem. <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />Mǝnia ka nda girlina mǝnana sulǝ nǝ kuli ka. Pà kǝla &lt;Manna&gt; mǝnana aká wun li sǝ nǝnzǝ́mò ka à yì wuki ka ɗàng. Sǝ ɓwa mǝnana li nyam nggūrǝam ngga pà nǝ̀ wu ɗàng, nǝ̀ kum yilǝmu mǝnana pà nǝ̀ mal raka.&gt;&gt;<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />Yesu banggí amǝnia yì acau ka, mǝnana nda aban kanigir aɓa ndakpapi mala amǝ Yahudi aɓa Kapanahum ngga.<verse eid="JHN 6:59" /></para>
  <para style="s">Acau Yilǝmu mǝnana málá <optbreak /> male pà kàm raka</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />Amǝkpate pas ok man yì cau ka sǝ à na ama, &lt;&lt;Man yi kanigir ka kwanǝna, yana nǝ̀ gandǝ é?&gt;&gt;<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />Kǝɓwa ne wi ɗàng, sǝ Yesu ka sǝlǝna ama alaggana male nda aban nggwani amur man yì kanigir ka, pǝlǝa nea wia ama, &lt;&lt;Kànìgìr man tsǝk wun bum wun kiɗiki le? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />Mana nǝ̀ duk ɗenyicau ma'wun yi mǝnana ɓǝ̀ wu sǝn Muna mala Ɓwa aban o a kùli aban mǝnana pur kàm ngga? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />Bangŋo mala Ɓakuli nda pākiyi yilǝmu ka; ɓariki mala ɓwapǝndǝa pa nǝ̀ pà yilǝmu ɗang. Acau mǝnana ǝn bangga wun ngga a mala bangŋo na andǝ yilǝmu. <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />Sǝ aɓea aɓwana atà wun ngga à earnǝ cau mem ɗàng.&gt;&gt; Yesu ka angŋǝna dǝmba súrǝ́nà rǝ aɓwana mǝnana à earnǝi raka, andǝ ɓwa mǝnana nǝ̀ nggá me ka. <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />Pǝlǝa nea wia ama, &lt;&lt;Mǝnia ka nda gir mǝnana tsǝa sǝ ǝn na wun ama, kǝɓwa pà nǝ̀ gandǝ yiu abanam ɗang, she ɓǝ̀ Tárrám earǝnì wi ka.&gt;&gt;<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />Ace cau mǝnana Yesu na ka, twal àkǝ̀ pwari mǝno ka, amǝkpate pas nyàrî te, à o à ɗeki.<verse eid="JHN 6:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67" />Yesu pǝlǝ rǝi aban alaggana male mana lum-nong-ɓari ka sǝ ɗia ama, &lt;&lt;Sǝ wun ngga, wu nǝ̀ o gbal le?&gt;&gt;<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />Shiman Bitǝrus eari wi ama, &lt;&lt;Mǝtala sǝm, aban yan sǝ sǝm nǝ̀ ká le? A nda mǝnana nǝ cau mala pà yilǝmu mǝnana pà nǝ̀ mal raka.<note caller="+" style="f"><char style="fr" closed="false">6:68 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:16">Mat 16:16</ref>; <ref loc="MRK 8:29">Mar 8:29</ref>; <ref loc="LUK 9:20">Luk 9:20</ref></char>.</note> <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />Sǝ adyan ngga sǝm pànà ɓamur sǝm, sǝ sǝm sǝlǝna ama a nda kǝ Mǝfele mǝnana pur aban Ɓakuli ka.&gt;&gt;<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />Pǝlǝa Yesu pa eare ama, &lt;&lt;Ən tar wun, wun lum-nong-ɓari. Sǝ ɓeɓwa atà wun ngga shetan na!&gt;&gt; <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />Yahuda muna mala Shiman Iskariyoti, nda ɓwa mǝnana Yesu nakiyi cau amurí ka. Kat andǝ amani ama nda aɓalǝ alaggana male mǝnana lum-nong-ɓari ka, yì nda ɓwa mǝnana nǝ̀ nggá me ka.<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">Amǝ'eam Yesu earnǝi ɗang</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />Anzǝm man ngga, Yesu gya aɓa nzali Galili; eare kutio aɓa bu-nzali Yahudi ɗang, acemǝnana aɓwana-mǝgule mala amǝ Yahudi mǝnana akanó ka, à nda ban alte à nǝ̀ wal-luí. <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />Sǝ lang Lamsan Do aɓalǝ Agumli, mala amǝ Yahudi gbashìnà ka,<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">Ɓalli cê aɓa: </char><char style="xt"><ref loc="EXO 23:16">Pur 23:16</ref>; <ref loc="LEV 23:34">Pǝris 23:34</ref>; <ref loc="DEU 16:13">Nggur 16:13</ref></char>.</note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />amǝ'eam Yesu ne wi ama, &lt;&lt;Kyane a bu-nzali Yahudi, ace mǝnana ɓǝ̀ alaggana mò ɓǝà kya sǝn agir-ndali mǝnana a kǝ pea ka. <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />Kǝɓwa pà kàm mǝnana kǝ earce ɓǝ̀ aɓwana súrǝì, sǝ nǝ̀ nggǝ pakki atúró aɓa sǝmbǝrǝa ka ɗàng. Sǝ acemǝnana a kǝ pakki amǝnia yì agir ka, puro lǝmdǝ rǝò ɓǝ̀ ɓanza súrǝ̀o.&gt;&gt; <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />Nggearǝ amǝ'eam Yesu nǝ ɓamuria ka, à earnǝi à paɓamuria a baní ɗàng.<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Pwari mem mǝnana mǝ nǝ pur nǝi a banfana ka, malaká karǝ peatu ɗàng, sǝ ma'wun ngga koya pwari ka ma'wun na.</char> <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" /><char style="wj">Ɓanza pa nǝ ɓinǝ mǝsǝ wun ɗàng, sǝ mim ngga kǝ ɓinǝ mǝsǝam, acemǝnana ǝn nggǝ bang aɓealɓikea mǝnana kǝ pak ka.</char> <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" /><char style="wj">Wu kyane. Mim ngga pà mǝ nǝ ká ado ɗàng, acemǝnana pwari mem malaká karǝ ɗang.&gt;&gt;</char> <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />Anzǝm mǝnana Yesu bangŋǝnia wia cau anggo ka, pǝlǝa akrǝi zuku a Galili.<verse eid="JHN 7:9" /></para>
  <para style="s">Yesu wari a ban Lamsan <optbreak /> mala Do aɓalǝ Agumli</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />Anzǝm mǝnana amǝ'eambi umna a ban Lamsan ka, Yesu gbal ka wari ɗǝong, pusǝrǝi ɗàng. <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />Aɓwana-mǝgule mala amǝ Yahudi camarǝ alte a ban Lamsan, à kǝ ɗikiban ama, &lt;&lt;Ɓwe nda ake le?&gt;&gt;<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />Aɓwabundǝa kǝ nacau nggùr-nggùr amur Yesu. Aɓea ɓwana ama, &lt;&lt;Yì ka, ɓwa mǝɓoarne na.&gt;&gt;</para>
  <para style="p" vid="JHN 7:12">Sǝ aɓea ɓwana gbal ka ama, &lt;&lt;Awo, yì ka, mǝ'swarkiban na.&gt;&gt; <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />Sǝ kǝɓwa puro nacau bwāng amurí ɗàng, acemǝnana à kǝ ɓanggi aɓwana-mǝgule mala amǝ Yahudi.<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />Lang à warina ɗār aɓa Lamsan, à gauwuni a tsùrú ka, Yesu kutio aɓa Ndàmǝgule mala Ɓakuli, pǝlǝa tita kani aɓwana gìr. <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />Sǝ aɓwana-mǝgule mala amǝ Yahudi ka à ndali kǝ̀rkǝ́r, à na ama, &lt;&lt;Lang sǝ ɓwa man súrǝ̀ gir ani kǝ̀rkǝ́r, yi mǝnana kǝɓwa kani wi raka?&gt;&gt;<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />Pǝlǝa Yesu nea wia ama:</para>
  <para style="pi" vid="JHN 7:16">
    <char style="wj">Agir mǝnana ǝn nggǝ kania wun ngga à mem na ɗang, à puro a ban Ɓakuli mǝnana tasǝam ngga.</char> <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" /><char style="wj">Ɓwa mǝnana kat earǝna ama nǝ̀ pak gìr mǝnana Ɓakuli earkiyi ce ka, nǝ̀ sǝlǝa ko kanigir mem ngga pur nǝ ban Ɓakuli, ko mala ɓamur rǝàm nda ǝn nggǝ na ka.</char> <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" /><char style="wj">Ɓwa mǝnana kǝ nacau aɓa ɓamur rǝì ka, gulo mala ɓamur rǝì nda alkiyite ka, sǝ ɓwa mǝnana kǝ pak gìr ace gulo mala ɓwa mǝnana túrí ka, ɓwa mǝ'mǝsǝcau nì na, ɓe kǝgìr nyir pa a ɓālǝi ɗàng.</char> <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" /><char style="wj">Musa nǝ̀ pà wun Nggurcau re? Sǝ kǝɓwa atà wun kpate ɗàng. Ace mana sǝ wu kǝ earce ama wun nǝ̀ wal-luem?</char><verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />Ɓwabunda mǝnana ram ngga ne wi ama, &lt;&lt;We ka, kukwar na a rǝò. Yana alkiyito ama nǝ̀ wal-luio?&gt;&gt;<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />Pǝlǝa Yesu earia wia ama, <char style="wj">&lt;&lt;Ən pak gir'ndǝlǝki mwashat ɓǝ̀rɓǝ̀r a pwari Sabbat, sǝ wun kat ka wu pak ndali.</char> <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" /><char style="wj">Musa pà wun Nggurcau mala kasǝ-ɓatau, kat andǝ amani ama yì nǝ̀ tite raka, aká wun nǝ̀ tite. Ace mani ka wu kǝ kasǝi muna ɓate a pwari Sabbat, pwari usǝlǝo.</char><note caller="+" style="f"><char style="fr" closed="false">7:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:10">Tite 17:10</ref>; <ref loc="LEV 12:3">Pǝris 12:3</ref></char>.</note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" /><char style="wj">Ɓǝ̀ pwari mana à tsǝa ace kasǝî muna-ɓwabura ɓate, kpa a pwari Sabbat, pwari usǝlǝo ka, wu kǝ lidǝmba nǝ pe, ace mǝnana ɓǝà kǝa yàl Nggurcau mala Musa raka. Palang sǝ bum wun lúllô a rǝàm acemǝnana ǝn twali ɓwa ban rǝkwana a pwari Sabbat ka?</char> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" /><char style="wj">Wu kǝa wu pak ɓashi ace sǝn ɓamǝsǝu ɗang. Wu pak ɓashi amur gìr mǝnana mǝsǝcau na ka.&gt;&gt;</char><verse eid="JHN 7:24" /></para>
  <para style="s">Yesu ka, nda Kǝrǝsti, Mǝ'amsǝban le?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />Pǝlǝa aɓea amǝ Urǝshalima na ama, &lt;&lt;Nggearǝ ɓwa mǝnia nda mbak aɓwana-mǝgule mala amǝ Yahudi alkiyite ama à nǝ̀ wal-luí ka re? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />Sǝ ndya came kǝ nacau a banfana ka, sǝ kǝɓwa loasǝ kun arǝì ɗàng. Ko aɓwana-mǝgule ka, à earǝna adyan ama mǝsǝcau yì ka, nda Kǝrǝsti, yì ɓwa mǝnana Ɓakuli tarì ka le? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />Màlà mǝnia yì ɓwa ka sǝm sùrǝ́nà rǝ ban mǝnana pur kàm ngga. Sǝ ɓǝ̀ Kǝrǝsti yiu ka, kǝɓwa pà nǝ̀ súrǝ̀ ban mǝnana pur kàm ngga ɗàng.&gt;&gt;<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />Mǝnana Yesu nda ban kanigìr aɓa Ndàmǝgule mala Ɓakuli ka, loasǝ gi kpǝm na ama, <char style="wj">&lt;&lt;Kàngkàng wu súrǝàm andǝ ban mǝnana ǝn pur kàm ngga? Mim ngga ǝn yiu ace cau mala ɓamur rǝàm ɗàng. Tárrám mǝnana tasǝam ngga mǝ'mǝsǝcau na. Wun ngga wu súrǝì ɗàng.</char> <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" /><char style="wj">Mim ngga ǝn súrǝì, acemǝnana a baní sǝ ǝn puro, sǝ yì nǝ̀ túrǎm.&gt;&gt;</char><verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />Lang Yesu bangŋǝna cau man anggo ka, aɓwana-mǝgule mala amǝ Yahudi ɓariki ama à nǝ̀ bwali, sǝ kǝɓwa tsǝk bu arǝì ɗàng, acemǝnana pwari male malaká pak ɗàng. <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />Sǝ aɓa mǝno anggo kat ka aɓwana pas aɓalǝ aɓwana mǝnana à ram ngga à pà ɓamuria a ban Yesu. À kǝ na ama, &lt;&lt;Ɓǝ̀ Kǝrǝsti, yì ɓwa mǝnana Ɓakuli tarì, yiu ka, nǝ̀ yia pakki agir-ndǝlǝki mǝnana à kútì mana mǝnia yì ɓwa ka pakkia ka le?&gt;&gt;<verse eid="JHN 7:31" /></para>
  <para style="s">À tasǝ amǝ yálban ɓǝà <optbreak /> kya bwal Yesu</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />Amǝ Farisi ok ɓwabundǝa aban sherǝ amǝnia yì acau ka amur Yesu, pǝlǝa yia andǝ agbani pǝris tasǝ amǝ'yál Ndàmǝgule mala Ɓakuli ama ɓǝà kya bwali.<verse eid="JHN 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33" />Yesu nea wia ama, <char style="wj">&lt;&lt;Mǝ ndakani ado atà wun zuku, sǝ mǝ nǝ nyare mǝ nǝ o a ban Tárrám mǝnana tasǝam ngga.</char> <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" /><char style="wj">Wun nǝ̀ altam, sǝ pa wu nǝ̀ kumam ɗang; sǝ ban mǝnana mǝ ndakam ngga pa wu nǝ̀ gandǝ ká kàm ɗàng.&gt;&gt;</char><verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />Sǝ aɓwana-mǝgule mala amǝ Yahudi nacau arǝarǝia ama, &lt;&lt;Nggearǝì ka, ake sǝ nǝ̀ ká le, mǝnana pà sǝm nǝ̀ sǝni raka? Ko nǝ̀ ká a ban aɓwana ma'sǝm mǝnana à mesǝkea arǝ alá mala amǝ Gǝrik ka, sǝ nǝ̀ nggá kània amǝ Gǝrik agir gbal le? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />Sǝ ɓālǝi aman, yi mǝnana na ama, sǝm nǝ̀ alte sǝ pà sǝm nǝ̀ kumi ɗàng; sǝ ɗǝm ngga na ama, ban mǝnana ndakam ngga pà sǝm nǝ̀ gandǝ ká kàm ɗàng?&gt;&gt;<verse eid="JHN 7:36" /></para>
  <para style="s">Mùr mǝnana kǝ pa yilǝmu ka</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />A masǝlǝata pwari, mǝnana ndà pwari mǝgule mala Lamsan ngga, Yesu lo came sǝ loasǝ gì kpǝm na ama, <char style="wj">&lt;&lt;Ɓwa mǝnana kat kǝ ok mǝsamur ka ɓǝ̀ yiu a banam ɓǝ̀ yi nu.</char><note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 23:36">Pǝris 23:36</ref></char>.</note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" /><char style="wj">Ɓwa mǝnana kat pà ɓamur rǝì a banam ngga, a bumi sǝ amealmur mala mùr mǝpà yilǝmu nǝ̀ puro, à nǝ̀ nggǝ ɓangŋa, kǝla mǝnana Malǝmce na ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">7:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 47:1">Ezǝk 47:1</ref>; <ref loc="ZEC 14:8">Zak 14:8</ref></char>.</note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />Yesu ndaban nacau amur kǝ Bangŋo mǝnana aɓwana mana à pà ɓamuria a baní ka, à nǝ̀ nggá kum ngga. Sǝ a pwari mǝno gbal anggo ka à malaká pà Bangŋo nì ɗàng, acemǝnana Yesu malaká loapi ɓembe kutia aɓa gulo male peatu raka.<verse eid="JHN 7:39" /></para>
  <para style="s">Kun aɓwana gaki amur Yesu</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />Lang à nǝ̀ ok cau mǝnana Yesu na ka, aɓea ɓwana na ama, &lt;&lt;Mǝsǝcau na, mǝnia yì ɓwa ka nda Mǝɓangnǝa mala Ɓakuli mǝnana sǝm kundǝkiyi ka.&gt;&gt;<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />Sǝ aɓea ɓwana na ama, &lt;&lt;Kǝ yì nda Kǝrǝsti, Mǝ'amsǝban.&gt;&gt; Aɓea ɓwana bang ama, &lt;&lt;Palang sǝ Kǝrǝsti ka nǝ̀ pur a Galili? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />Malǝmce na ama, Kǝrǝsti Mǝ'amsǝban ngga nǝ̀ pur a tàu mala Dauda, sǝ à nǝ̀ ɓǝli a Betalami, la mǝnana Dauda dukam ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">7:42 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 7:12">2Sam 7:12</ref>; <ref loc="MIC 5:2">Mik 5:2</ref></char>.</note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />Kara kun aɓwana gakina amur Yesu. <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />Aɓea aɓwana ka eare malea ka à nǝ̀ bwal Yesu, sǝ kǝɓwa gandǝ tsǝk bu arǝì ɗàng.<verse eid="JHN 7:44" /></para>
  <para style="s">Ɗwanyi pa ɓamuru mala aɓwana <optbreak /> mǝgule mala amǝ Yahudi</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />Sǝ lang amǝ'yál Ndàmǝgule nyarǝna ka, agbani pǝris andǝ amǝ Farisi ɗia ama, &lt;&lt;Palang sǝ wu bwali wu yinǝi ɗàng?&gt;&gt;<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />Amǝ'yálban banggia wia ama, &lt;&lt;Kǝɓwa pà kàm mǝnana kǝ nacau kǝla mala mǝnia yì ɓwa ka ɗàng.&gt;&gt;<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />Sǝ amǝ Farisi pǝlǝa à nea wia ama, &lt;&lt;Wun gbal ka yi ɓosǝkina ta kun wun le? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />Wu ok àkǝ̀ pwari ama kǝɓwa aɓalǝ aɓwana-mǝgule mala amǝ Yahudi ko amǝ Farisi, pà ɓamúrì a baní le? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />Sǝ ɓwabundǝa mǝnia à kǝ gyate ka, à súrǝ̀ Nzongcau mala Musa raka, à nda a ɓata súban mala Ɓakuli!&gt;&gt;<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />Nikodimus ndakam a banì. Yì ka, nda aɓalǝ amǝ Farisi, amǝ kùrcau, sǝ nda ɓwamǝgule mǝnana wari a ban Yesu ɗiɗyal ka. Ɗiban ama,<note caller="+" style="f"><char style="fr" closed="false">7:50 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 3:1-2">Yoh 3:1-2</ref></char>.</note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />&lt;&lt;Nggearǝì ka, Nggurcau ma'sǝm eara sǝm ama ɓǝ̀ sǝm kasǝ ɓashi amur ɓwa mǝnana à ok kǝcau a kúni, sǝ sǝm súrǝ̀ gir mǝnana pàk la raka le?&gt;&gt;<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />Sǝ à pe wi eare ama, &lt;&lt;Tino, we gbal ka a pur nǝ Galili le? Kyane kya bǝlki ɓá Malǝmce ɓukɓuk sǝ awu nǝ sǝlǝ ama kǝ mǝɓangnǝa pa nǝ̀ pur a Galili ɗàng.&gt;&gt;<verse eid="JHN 7:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 7:53" />[Sǝ koyan le ka nyare o a ɓala male.<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">Yesu twalî ɓè ɓwama <optbreak /> ban cauɓikea male</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />Yesu ka, eau amur Nkono mala anggun Olif. <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />Ban fana nǝ tadǝmbari ka, nyare wari a Ndàmǝgule mala Ɓakuli. Sǝ ɓwapǝndǝa yiu ramba a baní, pǝlǝa do tita kania wia gìr. <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />Amalǝm Nggurcau mala Musa andǝ amǝ Farisi yiu nǝ ɓe ɓwama mǝnana à bwalia amur rǝarǝia andǝ ɓe ɓwabura ka, sǝ à yì tamsǝi a ɓadǝm ɓwapǝndǝa. <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />À ɗì Yesu ama, &lt;&lt;Malǝm, ɓwama man ngga à bwali amur rǝarǝia andǝ ɓwabura. <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" /><note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 20:10">Pǝris 20:10</ref>; <ref loc="DEU 22:22-24">Nggur 22:22-24</ref></char>.</note> Nggurcau mala Musa bang ama ɓwama mǝnana pàk ulang man yì gìr ka, ɓǝà ɓukki nǝ atali ɓǝ̀ wú. Sǝ ado ka, mana a na amurí?&gt;&gt; <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />Ɗiban mǝnia aɓwana ɗì Yesu ka, gbǝ́lî na à dambi Yesu ka, acemǝnana ɓǝ̀ na ɓekǝ cau sǝ à nǝ̀ bwali nǝi ka.</para>
  <para style="p" vid="JHN 8:6">Sǝ Yesu ka kū`ndǝó kǝ gilǝgir a nzali nǝ munabuì. <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />Lang à camarǝ ɗike ka, pǝlǝa loasǝ múrí sǝ nea wia ama, <char style="wj">&lt;&lt;Ɓwa mǝnana atà wun pànǝ cauɓikea raka, ɓǝ̀ tita túr tali.&gt;&gt;</char> <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />Sǝ nyare kū`ndǝó aban gilǝgir a nzali. <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />Lang amalǝm nggurcau andǝ amǝ Farisi ongŋǝna cau mǝnana Yesu na ka, kara à purkî banì mwashat-mwashat, tite a ban ɓwamǝgule. Sǝ à nying Yesu nǝmurǝì andǝ ɓwame aban came aɓalǝ aɓwana.<verse eid="JHN 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 8:10" />Yesu lo cam nǝ came, sǝ ɗì ɓwame ama, <char style="wj">&lt;&lt;Aɓwana mǝnana à yiu nǝ we ka, à nda ke le? Kǝɓwa pà kàm ateà mǝnana ueo nǝ̀ pakko ɓashi-lú ka re?&gt;&gt;</char><verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />Pǝlǝa eare ama, &lt;&lt;Awo, Ɓwamǝgule, kǝɓwa pà kàm ɗàng.&gt;&gt;</para>
  <para style="p" vid="JHN 8:11">Yesu banggi wi ama, <char style="wj">&lt;&lt;Nggearǝ mim gbal ka ǝn kasǝò ɓashi-lú ɗàng. Kyane, sǝ kǝa pak cauɓikea ɗǝm ɗàng.&gt;&gt;</char>]<verse eid="JHN 8:11" /></para>
  <para style="s">Yesu nda tǎlaban mala ɓanza</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />Yesu nyar ɗǝm banggi aɓwana ama, <char style="wj">&lt;&lt;Mǝ nda tǎlaban mala ɓanza! Ɓwa mǝnana kat kpatam ngga, pà nǝ̀ gya aɓa pǝndǝa ɗang, nǝ̀ kum tǎlaban mala yilǝmu.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:14">Mat 5:14</ref>; <ref loc="JHN 9:5">Yoh 9:5</ref></char>.</note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />Amǝ Farisi ne wi ama, &lt;&lt;Ado ka a ndaban nakún ɓamuro, cau mò ka à pà nǝ̀ é ama mǝsǝcau na ka ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 5:31">Yoh 5:31</ref></char>.</note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />Sǝ Yesu nea wia ama:</para>
  <para style="pi" vid="JHN 8:14">
    <char style="wj">Ko ɓǝ̀ ǝn nakún ɓamúràm ngga, cau mem ngga à nǝ̀ earnǝi, acemǝnana ǝn súrǝ́nà rǝ ban mǝnana ǝn pur kàm ngga, sǝ ǝn súrǝ́nà rǝ ban mǝnana mǝ nǝ ká kàm ngga. Sǝ wun ngga, wu súrǝ̀ ban mǝnana ǝn pur kàm, andǝ ban mǝnana mǝ nǝ ká kàm ngga ɗàng.</char> <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" /><char style="wj">Wu kǝ pak ɓashi aɓa nggūrǝu, sǝ mim ngga ǝn nggǝ ɓashi kǝɓwa ɗàng.</char> <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" /><char style="wj">Sǝ ɓǝà na ama ǝn nggǝ pak ɓashi ka, ɓashi mem ngga mǝsǝcau na, acemǝnana ǝn pa nǝmurǝam atà ɓashi ɗàng, Tárrám mǝnana tasǝam ngga nda atàm.</char> <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" /><char style="wj">Nggurcau ma'wun bang ama, ɓǝ̀ kún aɓwana ɓari yiu mwashat amur cau ka, cê ka mǝsǝcau na.</char><note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 19:15">Nggur 19:15</ref></char>.</note> <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" /><char style="wj">Sǝ mim ngga, ǝn nakún ɓamúràm, sǝ Tárrám mǝnana tasǝam ngga nakunam gbal.</char><verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />Sǝ à ɗì ama, &lt;&lt;Tárró na ake?&gt;&gt;</para>
  <para style="p" vid="JHN 8:19">Pǝlǝa Yesu earia wia ama, <char style="wj">&lt;&lt;Wu súrǝàm ɗang, sǝ wu súrǝ̀ Tárrám ɗang. Ɓǝ̀ wu sùrǝ́nà rǝam ngga, ɓǝ́ wu sùrǝ́nà rǝ Tárrám gbal.&gt;&gt;</char><verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />Yesu naki amǝnia yì acau ka mǝnana nda rǝ kanigir a buban mǝnana à kǝ tsǝk boalo kam andǝ agir mǝɓoarne aɓa Ndàmǝgule mala Ɓakuli ka. Sǝ kǝɓwa bwali ɗàng, acemǝnana pwari male malaká karǝ ɗang.<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />Yesu nea wia ɗǝm ama, <char style="wj">&lt;&lt;Mǝ ndo mǝ nǝ o; ɓǝn umna ka, wu nǝ̀ altam, sǝ wu nǝ̀ wú aɓalǝ acauɓikea ma'wun. Pa wu nǝ̀ gandǝ ká aban mǝnana mǝ nǝ ká kam ngga ɗang.&gt;&gt;</char><verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />Pǝlǝa aɓwana-mǝgule mala amǝ Yahudi ɗiban ama, &lt;&lt;Nggearǝì ka nda ban earce nǝ̀ wal ɓamúrì le? Mana tsǝa sǝ na ama, pà sǝm nǝ̀ gandǝ ká aban mǝnana nǝ̀ ká kam ngga ɗang?&gt;&gt;<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />Yesu ear ama, <char style="wj">&lt;&lt;Tǝta wun ngga a ɓanza mǝnia a nzali ka sǝ pa, sǝ mim ngga ǝn pur nǝ kuli. Wu nda ka mala ɓanza man, sǝ mim ngga mǝ nda mala ɓanza man ɗang.</char> <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" /><char style="wj">Nda gir mǝnana tsǝa sǝ ǝn na wun ama wu nǝ̀ wú aɓalǝ acauɓikea ma'wun ngga; ɓǝ̀ wu earnǝ mim ama Mǝ Nda</char><note caller="+" style="f"><char style="fr" closed="false">8:24 </char><char style="fq" closed="false">Mǝ Nda: </char><char style="ft" closed="false">Aban amǝ Yahudi ka lullǝu mana karban kat nǝ fele à tunǝ Ɓakuli nǝi ka nda &lt;&lt;Yahweh,&gt;&gt; sǝ ɓālǝi ka nda &lt;&lt;Mǝ nda.&gt;&gt; Arǝ aɓea ban aɓa Cau Amsǝban a nê mala Yohana ka, Yesu pak túró nǝ &lt;&lt;Mǝ Nda&gt;&gt; ace mǝnana ɓǝ̀ lǝmdǝ ama yì nda ɓwe.</char></note> <char style="wj">ɓwa mǝnana ǝn na nǝma Mǝ Nda ka raka, wu nǝ̀ wú aɓalǝ acauɓikea ma'wun.&gt;&gt;</char><verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />Pǝlǝa à ɗì Yesu ama, &lt;&lt;A nda yana?&gt;&gt;</para>
  <para style="p" vid="JHN 8:25">Sǝ Yesu earia wia ama, <char style="wj">&lt;&lt;Mǝ nda kǝ ɓwa mǝnana ǝn na wun a dǝmbe nǝma mǝ nda ka.</char> <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" /><char style="wj">Mǝ ndanǝ acau pas amur wun, mǝnana mǝ nǝ ɓashia wun nǝia ka, sǝ pa mǝ nǝ pè ɗàng. Tárrám mǝnana tasǝam ngga mǝ'mǝsǝcau na, sǝ ǝn nggǝ ne ɓanza gir mǝnana ǝn ok a kúni ka.&gt;&gt;</char><verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />Sǝ kǝɓwa sǝlǝa ateà ama Yesu na ban nea wia cau amur Tárrí Ɓakuli ɗang. <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />Ace mǝno ka, Yesu nea wia ama, <char style="wj">&lt;&lt;A pwari mǝnana wu loasǝna Muna mala Ɓwa a kùli amur nggun-gangndǝi ka, akanó sǝ wun nǝ̀ sǝlǝ ama Mǝ Nda ɓwa mǝnana ǝn na wun nǝma Mǝ Nda ka. A pwari mǝno sǝ wun nǝ̀ sǝlǝ gbal ama ǝn nggǝ pak kǝgìr aɓa rǝcandǝa mem ɗàng. Kǝ gìr mǝnana Tárrám kaniam ngga kǝ nda ǝn nggǝ na ka.</char> <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" /><char style="wj">Ɓwa mǝnana tasǝam ngga nda atàm; nyem nǝmurǝam ɗàng. Acemǝnana koya pwari ka ǝn nggǝ pak gìr mǝnana kǝ pwasǝbumi ka.&gt;&gt;</char> <verse eid="JHN 8:29" /><verse number="30" style="v" sid="JHN 8:30" />Pas atà aɓwana mǝnana à ok Yesu aban na amǝnia yì acau ka à pà ɓamuria a baní.<verse eid="JHN 8:30" /></para>
  <para style="s">Kǝ mǝsǝcau nda nǝ̀ panzǝ wun ngga</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />Yesu ne aɓwana mǝnana à pà ɓamuria a baní ka ama, <char style="wj">&lt;&lt;Ɓǝ̀ wu kpata kanigir mem ngga, wu nda ka amǝkpatam amǝ'mǝsǝcau nì.</char> <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" /><char style="wj">Sǝ wun nǝ̀ súrǝ̀ mǝsǝcau, sǝ mǝsǝcau ka nǝ̀ panzǝki wun.&gt;&gt;</char><verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />Pǝlǝa à eari wi ama, &lt;&lt;Sǝm ngga, sǝm nda ka amǝkau mala Ibǝrayim, sǝm duk aguro mala kǝɓwa àkǝ̀ pwari ɗàng. Lang sǝ a nǝ na sǝm ama à nǝ̀ panzǝ sǝm?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:9">Mat 3:9</ref>; <ref loc="LUK 3:8">Luk 3:8</ref></char>.</note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />Yesu nea wia ama:</para>
  <para style="pi" vid="JHN 8:34">
    <char style="wj">Mǝ nda ban na wun mǝsǝcau, ɓwa mǝnana kat kǝ pak cauɓikea ka, guro mala cauɓikea na.</char> <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" /><char style="wj">Guro pà nǝ̀ do a ɓala nǝ̀ ue kam ɗàng, sǝ muna ka, mala ɓala na, do male a ɓala ka pà nǝ́ masǝlǝate ɗàng.</char> <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" /><char style="wj">Ɓǝ̀ Muna mala Ɓakuli nǝ̀ panzǝo ka, panzǝban mò ka mǝ'mǝsǝcaunì na.</char> <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" /><char style="wj">Ən sǝlǝna ama wu nda ka amǝkau mala Ibǝrayim, sǝama wu kǝ earce walam, acemǝnana wu eari cau mem ɓǝ̀ kum ban-do a ɓabum wun ɗàng.</char> <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" /><char style="wj">Mim ngga ǝn nggǝ bang gìr mǝnana ǝn sǝni aban Tárrám ngga. Sǝ wun ngga wu kǝ pak gìr mǝnana tár wun kǝ na wun ngga.</char><verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />Sǝ à eare ama, &lt;&lt;Ibǝrayim nda kà-sǝm.&gt;&gt;</para>
  <para style="p" vid="JHN 8:39">Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ kàngkàng wu nda ka amǝkau mala Ibǝrayim ngga, wun nǝ̀ pak agir mǝnana Ibǝrayim pea ka.</char> <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" /><char style="wj">Wu kǝ earce ama wun nǝ̀ wal-luem, acemǝnana ǝn bangga wun mǝsǝcau mana ǝn o a kún Ɓakuli ka. Sǝ Ibǝrayim pak kǝgìr anggo ɗàng.</char> <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" /><char style="wj">Wu nda rǝ pak gìr mǝnana nggearǝ tár wun pakkiyi ka.&gt;&gt;</char></para>
  <para style="p" vid="JHN 8:41">Amǝ Yahudi ne wi ama, &lt;&lt;Ɓakuli nda kǝ Tár sǝm, sǝm nda ka muna tà-jam ɗang.&gt;&gt;<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />Sǝ Yesu nea wia ama:</para>
  <para style="pi" vid="JHN 8:42">
    <char style="wj">Ɓǝ̀ tár wun nda Ɓakuli ka, wun nǝ̀ earcem, acemǝnana ǝn pur aban Ɓakuli, sǝ ado ka mǝ ndakani. Ən yipì ɓamúràm ɗàng, Ɓakuli nǝ̀ túrǎm.</char> <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" /><char style="wj">Man tsǝa sǝ wu bwalta acau mǝnana ǝn nggǝ na wun ngga ɗàng? Nda ace mǝnana wu gandǝ ok cau mem ɗàng.</char> <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" /><char style="wj">Wun nda ka muna mala tár wun yì Shetan, sǝ wu kǝ earce lumsǝî tár wun kún atúró male. Yì ka, tita walki-alú ɗiɗyal, sǝ kǝ earce mǝsǝcau ɗàng, acemǝnana mǝsǝcau pà aɓalǝi ɗàng. Ɓǝ̀ ndarǝ na nyir ka nda ban lǝmdǝ girbui, acemǝnana yì ka, mǝ nyir na, sǝ nda tár amǝ nyir kat.</char><verse eid="JHN 8:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="JHN 8:45" />
    <char style="wj">Sǝ acemǝnana ǝn nggǝ na mǝsǝcau ka, wu earnǝ mim ɗang.</char> <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" /><char style="wj">Yana atà wun nǝ̀ lǝmdǝ buì arǝ kǝ cauɓikea mǝnana ǝn pê ka? Sǝ ɓǝ̀ mǝsǝcau na ǝn nggǝ bang ngga, mana tsǝa sǝ wu ginǝ earnǝ mim?</char> <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" /><char style="wj">Ɓwa mǝnana mala Ɓakuli na ka kǝ kwakikiri arǝ cau mala Ɓakuli. Sǝ wun ngga wun nda ka mala Ɓakuli ɗang, nda gìr mǝnana tsǝa sǝ wu kǝ kwaki kir wun arǝì raka.</char><verse eid="JHN 8:47" /></para>
  <para style="s">Yesu akì Ibǝrayim dǝmba</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />Sǝ aɓwana-mǝgule mala amǝ Yahudi ɗì Yesu ama, &lt;&lt;Cau mǝnana sǝm na ama a nda ɓwa Samariya sǝ kukwar nda arǝò ka mǝsǝcau na re?&gt;&gt;<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Ən panǝ kukwar arǝàm ɗang. Ən nggǝ pê Tárrám gulo sǝ wu kǝ nyesǝam ɓà.</char> <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" /><char style="wj">Ən pa aban alita ɓamúràm gulo ɗang. Tárrám na kǝ alamta gulo ka, sǝ yì nda ɓwa mǝnana pakkiyi ɓashi mǝ'mǝsǝcau nì ka.</char> <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" /><char style="wj">Mǝ nda ban bangga wun mǝsǝcau, ɓwa mǝnana kǝ kpata cau mem ngga pà nǝ̀ wu ɗàng.&gt;&gt;</char><verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />Pǝlǝa aɓwana-mǝgule mala amǝ Yahudi ne wi ama, &lt;&lt;Ado sǝ sǝm sǝlǝa aɓa mǝsǝcau ama, a ndanǝ kukwar arǝò! Nggearǝ Ibǝrayim ngga wǔ, sǝ amǝ'ɓangnǝa mala Ɓakuli wú, pǝlǝa a nǝ yia na sǝm ama, &lt;Ɓǝ̀ ɓwa kpata cau mem ka pà nǝ̀ wu ɗang.&gt; <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />A kútì kà-sǝm Ibǝrayim le? Yì ka, wǔ, sǝ amǝ'ɓangnǝa mala Ɓakuli gbal ka à wǔ. Sǝ we ka a kǝ sǝni kǝla a nda yana?&gt;&gt;<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />Yesu earia wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ ǝn pê ɓamúràm gulo ka, gulê pà a kún kǝgìr ɗàng. Sǝ Tárrám mǝnana wu kǝ twali ama nda Ɓakuli ma'wun ngga, nda mǝnana pākiyam gulo ka.</char> <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" /><char style="wj">Wun ngga wu súrǝì ɗàng, sǝ mim ngga ǝn súrǝì. Ɓǝ̀ ǝn na ama ǝn súrǝì raka, mǝ nda mǝ'nyir kǝla wun. Sǝ mim ngga ǝn súrǝì, sǝ ǝn nggǝ kpata cau male.</char> <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" /><char style="wj">Kà wun Ibǝrayim ngga, pak banɓoarnado ama nǝ̀ sǝn pwari yiu mem, pǝlǝa sǝni sǝ bumi pwasǝo.&gt;&gt;</char><verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />Pǝlǝa amǝ Yahudi banggi Yesu ama, &lt;&lt;A malaká bwal pǝlǝa lumi-tongno ɗang, sǝ lang sǝ a nǝ na ama a sǝn Ibǝrayim?&gt;&gt;<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />Yesu earia wia ama, <char style="wj">&lt;&lt;Mǝ nggǝ bangga wun mǝsǝcau, kaniama à nǝ̀ ɓǝl Ibǝrayim ngga, &lt;Mǝ ndakam.</char>&gt;<note caller="+" style="f"><char style="fr" closed="false">8:58 </char><char style="fq" closed="false">Mǝ ndakam: </char><char style="ft" closed="false">Mǝnia yì cau ama &lt;&lt;Mǝ ndakam&gt;&gt; ko &lt;&lt;Mǝ nda&gt;&gt; ka lǝmdǝ ama Yesu na arǝ na ama yì ka, Ɓakuli na, kǝla mana Ɓakuli tunǝ ɓamúrì ama &lt;&lt;Mǝ nda&gt;&gt; aɓa malǝmce </char><char style="xt"><ref loc="EXO 3:14">Pur 3:14</ref></char> ka.</note>&gt;&gt; <verse eid="JHN 8:58" /><verse number="59" style="v" sid="JHN 8:59" />À nǝ̀ ok mǝno yì cau ka, kara à pwan atali ama à nǝ̀ ɓukki, sǝ Yesu gbar rǝì, pǝlǝa puro nying Ndàmǝgule mala Ɓakuli.<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">Yesu mǝn mǝsǝ ɓwa mana <optbreak /> à ɓǝlì nte na ka</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />Yesu nda ban kutio pǝlǝa sǝn ɓeɓwa mǝnana à ɓǝlì nte na ka. <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />Alaggana male ɗì ama, &lt;&lt;Malǝm, cauɓikea mala yana tsǝa sǝ à ɓǝl ɓwa mǝnia ka nte? Cauɓikea male na le, ko mala angge na andǝ tárrí?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 13:2">Luk 13:2</ref>; <ref loc="ACT 28:4">Atúró 28:4</ref>; <ref loc="EZK 18:20">Ezǝk 18:20</ref>; <ref loc="EXO 20:5">Pur 20:5</ref></char>.</note><verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />Yesu nea wia ama, <char style="wj">&lt;&lt;Pà ace cauɓikea male, ko mala tárrí andǝ ngge sǝ à ɓǝlì nte na ka ɗàng. À ɓǝlì anggo ace mǝnana ɓǝa lǝmdǝ túró mala Ɓakuli amurí.</char><note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 11:4">Yoh 11:4</ref></char>.</note> <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" /><char style="wj">Ado mǝnana pwari ndakam ngga, dumǝna púp sǝm nǝ̀ pak túró mala Tárrám mǝnana tasǝam ngga. Dù nda kǝ yiu, mǝnana kǝɓwa pà nǝ̀ pak túró raka.</char> <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" /><char style="wj">Ado mǝnana mǝ nda a ɓanza ka, mǝ nda tǎlaban mala ɓanza.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:14">Mat 5:14</ref>; <ref loc="JHN 1:4">Yoh 1:4</ref>; <ref loc="JHN 8:12">8:12</ref>; <ref loc="JHN 12:46">12:46</ref></char>.</note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />Lang Yesu naná cau anggo ka, pǝlǝa tau ntāra a nzali sǝ torǝi pǝlǝ dǝɓang, sǝ hasǝì ɓwabure arǝ amǝsǝì. <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />Sǝ ne wi ama, <char style="wj">&lt;&lt;Kyane kya lak ɓamǝsǝo a guguri Silowam.&gt;&gt;</char> (Silowam ngga ɓālǝi nda &lt;&lt;Mǝnana à tàsǝì ka.&gt;&gt;) Pǝlǝa ɓwabure wario, kya lak ɓamǝsǝi. Nǝ̀ nyar ka amǝsǝì longŋǝna à nǝ̀ nggǝ sǝnban.<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />Aɓi amǝ njarmurkala andǝ aɓwana mǝnana à súrǝì ama mǝ zǝmgi agir na ɗiɗyal ka, à ɗì rǝia ama, &lt;&lt;Ɓwa mǝnia ka nda mbo dukiyi kani aban zǝmgi agir ka?&gt;&gt; <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />Aɓea ɓwana na ama, &lt;&lt;Kǝ nda.&gt;&gt;</para>
  <para style="p" vid="JHN 9:9">Sǝ aɓea ɓwana bang ama, &lt;&lt;Awo, nda ɗang, à pur rǝia nǝ puro.&gt;&gt;</para>
  <para style="p" vid="JHN 9:9">Ɓwabure nǝ ɓamúrì pǝlǝa nea wia ama, &lt;&lt;Mǝ nda kǝ ɓwe.&gt;&gt;<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />Pǝlǝa à ɗì ama, &lt;&lt;Sǝ kar lang, sǝ a kǝ sǝnban?&gt;&gt;<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />Earia wia ama, &lt;&lt;Ɓwa mǝnana à tunǝki ama Yesu ka, nda torǝ dǝɓang sǝ hasǝami arǝ amǝsǝam, sǝ nam ama, ɓǝ̀ ǝn kya guguri Silowam mǝ lak ɓamǝsǝam kam. Pǝlǝa ǝn wario, ǝn lak mǝsǝam, nda sǝ ǝn tita sǝnban ngga.&gt;&gt;<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />À ɗì ama, &lt;&lt;Ɓwe ka nda a ke?&gt;&gt;</para>
  <para style="p" vid="JHN 9:12">Pǝlǝa nea wia ama, &lt;&lt;Ən sǝlǝ ɗang.&gt;&gt;<verse eid="JHN 9:12" /></para>
  <para style="s">Amǝ Farisi bǝlkusǝ twalban <optbreak /> rǝkwana mala nte</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />Pǝlǝa à twal ɓwabura mǝnia mǝnana nte na ɗiɗyal ka, à wari nǝi a ban amǝ Farisi, <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />acemǝnana pwari mǝno Yesu torǝna dǝɓang nǝi sǝ hasǝi ɓwabure arǝ amǝsǝì, sǝ amǝsǝì mǝn ngga, pwari Sabbat na, pwari usǝlǝo mala amǝ Yahudi. <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />Pǝlǝa amǝ Farisi nyare à ɗì ɓwabure lang sǝ kum sǝnban male. Pǝlǝa nea wia ama, &lt;&lt;Hasǝam dǝɓang arǝ amǝsǝam, ǝn lak ɓamǝsǝam, sǝ ado ka ǝn nggǝ sǝnban.&gt;&gt;<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />Aɓea amǝ Farisi na ama, &lt;&lt;Mǝnia yì ɓwa yì Yesu ka, pur nǝ ban Ɓakuli ɗang, acemǝnana gusǝlǝ Sabbat ɗang.&gt;&gt;</para>
  <para style="p" vid="JHN 9:16">Sǝ aɓea ɓwana ɗiban ama, &lt;&lt;Lang sǝ mǝ'cauɓikea nǝ pak a'ulang amǝnia yì agir-ndǝlǝki ka le?&gt;&gt; Kara aɗenyicau malea ginggia rǝia ɗàngɗáng.<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />Anzǝm man ngga pǝlǝa à nyare a ban ɓwabure à ɗì ɗǝm ama, &lt;&lt;We ado ka, mana a na amur mǝno yì ɓwa mǝnana mǝnbo amǝsǝo ka?&gt;&gt;</para>
  <para style="p" vid="JHN 9:17">Pǝlǝa earia wia ama, &lt;&lt;Yì ka, mǝɓangnǝa mala Ɓakuli na.&gt;&gt;<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />Aɓwana-mǝgule mala amǝ Yahudi ka, à ear ama mǝnia yì ɓwa ka nte na ɗiɗyal sǝ ado ka kǝ sǝnban ɗang. Pǝlǝa a túrban ɓǝa tunǝ tárrí andǝ ngge. <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />Sǝ à ɗia ama, &lt;&lt;Mǝnia yì muna ka wun nǝ̀ ɓǝlì le? Wu na ama à ɓǝlì ka nte na? Sǝ kar lang ado sǝ kǝ sǝnban?&gt;&gt;<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />A tárrí andǝ ngge eare ama, &lt;&lt;Sǝm sǝlǝna ama muna ka ma'sǝm na, sǝ sǝm sǝlǝna gbal ama sǝm ɓǝlì ka nte na. <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />Sǝ cau mala sǝnban male andǝ ɓwa mǝnana mǝnbi wi amǝsǝì ka, sǝm sǝlǝ ce ɗang. Wu ɗì, kārǝ́na ɓwa, nǝ̀ gandǝ na kúni.&gt;&gt; <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />Atarrí andǝ ngge ka à na mǝnia yì cau anggo acemǝnana à kǝ ɓanggi aɓwana-mǝgule mala amǝ Yahudi. Amǝnia yì aɓwana-mǝgule ka à bangŋǝna a dǝmba ama, ɓwa mǝnana earnǝ Yesu ama nda Kǝrǝsti Mǝ'amsǝban ngga, à nǝ̀ pǝri pà nǝ̀ nggǝ yiu aɓa ndakpapi ɗǝm ɗàng. <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />Nda gìr mǝnana tsǝa sǝ à na ama, &lt;&lt;Wu ɗì, acemǝnana yì ka, kārǝ́na ɓwa&gt;&gt; ka.<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />Aɓwana-mǝgule nyar ɓaria à tunǝ ɓwa mǝno nte na ɗiɗyal ka, sǝ à ne wi ama, &lt;&lt;Pe Ɓakuli gulo, na sǝm mǝsǝcau! Sǝm sǝlǝna ama ɓwabura mǝnana mǝnbo amǝsǝo ka mǝ'cauɓikea na.&gt;&gt; <verse eid="JHN 9:24" /><verse number="25" style="v" sid="JHN 9:25" />Ɓwabure earia wia ama, &lt;&lt;Ən sǝlǝ ɗang ko mǝ'cauɓikea na, ko mǝ'cauɓikea na ɗang. Gìr mǝnana ǝn sǝlǝ ka nda mǝnana ama, ɗiɗyal ka mǝ nda nte, sǝ ado ka ǝn nggǝ sǝnban.&gt;&gt; <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />À ɗì ɗǝm ama, &lt;&lt;Pakko lang sǝ mǝnbo amǝsǝo?&gt;&gt;<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />Sǝ earia wia ama, &lt;&lt;Ən nanà wun mǝni, sǝ wu ginǝ kwaki kir wun. Ace mana sǝ wu kǝ earce oe ɗǝm? Wu kǝ earce wun nǝ̀ pǝlǝ amǝkpate gbal le?&gt;&gt;<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />Kara à lo a rǝi nǝ sanggiban, à ne wi ama, &lt;&lt;A nda mǝnana a kpakiyi atà mǝno yì ɓwa ka, sǝm ngga sǝm nda ka amǝkpata Musa. <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />Sǝm sǝlǝna ama, Ɓakuli nacau nǝ Musa, sǝ mala ɓwabura mǝno ka, yàle sǝm súrǝ̀ ban mǝnana pur kam ngga ɗàng!&gt;&gt;<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />Sǝ ɓwabure banggia wia ama, &lt;&lt;Kúk! Wu okam kǝcau. Wu súrǝ̀ ban mǝnana pur kam ngga ɗàng, sǝ gandǝ mǝnbam amǝsǝam! <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />Sǝm sǝlǝna ama, Ɓakuli pakkiyi gir mǝnana amǝ'cauɓikea na ama ɓǝ̀ pakkia wia ka ɗàng; sǝama ɓǝ̀ kǝɓwa kǝ pe Ɓakuli gulo sǝ kǝ kpata gìr mǝnana kǝ earce ama ɓǝa pe ka, Ɓakuli nǝ̀ kwakikiri nǝ̀ oki wi. <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />Twal a share ta ɓanza ka, sǝm o àkǝ pwari ama kǝɓwa gandǝ mǝn mǝsǝ kǝɓwa mǝnana à ɓǝli nte na ka ɗàng. <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />Ɓǝ̀ man yì ɓwa ka pur a ban Ɓakuli raka, pà nǝ̀ gandǝ pe ɗàng.&gt;&gt;<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />Pǝlǝa à ne wi ama, &lt;&lt;We mǝnana gbal à ɓǝ̀lo aɓa cauɓikea, sǝ à gulo aɓa cauɓikea ka, a kǝ ɓariki ama, awu nǝ kania sǝm gìr?&gt;&gt; Kara à pǝrì purî ɓá ndakpapi.<verse eid="JHN 9:34" /></para>
  <para style="s">Do nte aɓa bangŋo</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />Lang Yesu ok ce gìr mǝnana à pakki ɓwabure ka, kya kum ɓwabure sǝ ɗì ama, <char style="wj">&lt;&lt;A earǝna nǝ Muna mala Ɓwa le?&gt;&gt;</char><verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />Ɓwabure eari wi ama, &lt;&lt;Ɓwamǝgule, banggàm, yana ɓwe nda Muna mala Ɓwa, ace mǝnana ɓǝ̀n earnǝi ɓǝ̀n pà ɓamúràm a baní?&gt;&gt;<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />Yesu ne wi ama, <char style="wj">&lt;&lt;A angŋa dǝmba a sǝnǝni, mǝ nda kǝ ɓwe mǝnana ado ǝn nakiyio cau ka.&gt;&gt;</char><verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />Kara ɓwabure kū`ndǝó a ɓadǝm Yesu peri, sǝ na ama, &lt;&lt;Mǝtalem, e, ǝn earǝna, ǝn panà ɓamúràm a bano.&gt;&gt;<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />Pǝlǝa Yesu na ama, <char style="wj">&lt;&lt;Ən yiu aɓa ɓanza man ace ɓashi, ace mǝnana ɓǝ̀ ante kum sǝnban, sǝ aɓwana mǝnana à kǝ sǝnban ngga, ɓǝa pǝlǝ ante.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 5:27">Yoh 5:27</ref>; <ref loc="JHN 3:19">3:19</ref>; <ref loc="MAT 15:14">Mat 15:14</ref></char>.</note><verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />Aɓea amǝ Farisi mana aban came tù a banì ka, ok cau mǝnana Yesu na ka, pǝlǝa à ɗì ama, &lt;&lt;A nda ban na ama, sǝm nda ka nte le?&gt;&gt;<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />Sǝ Yesu pǝlǝia wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ wu nda ka nte ka, ɓǝ́ mur wun pà nǝ̀ halǝki wun arǝ acauɓikea ma'wun ɗàng. Sǝ mǝno ado wun ne nǝ ɓamurǝ wun ama wun nǝ̀ nggǝ sǝnban ngga, lǝmdǝna ama, cauɓikea ma'wun ngga nda kam amur wun più.&gt;&gt;</char><verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">Yálgír mǝɓoarne andǝ anzur male</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />Yesu na ama:</para>
  <para style="pi" vid="JHN 10:1">
    <char style="wj">Mǝ nda ban bangga wun mǝsǝcau, ɓwa mǝnana kútí aɓa domwan mala anzur nǝ kun-nda raka, sǝ kútí nǝ ɓekǝ njar ɗàng ngga, mǝn'í na sǝ mǝɓǝmbǝriban na.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 6:34">Mar 6:34</ref>
      </char>.</note> <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" /><char style="wj">Sǝ ɓwa mǝnana kútì nǝ kun-nda ka, nda mǝ'yál anzur.</char> <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" /><char style="wj">Mǝtsǝkir kun-nda nǝ̀ mǝnbi wi kun-nda; anzur nǝ̀ ok gi mǝ'yália ɓǝ̀ tunǝia nǝ lullǝia ka, sǝ nǝ̀ kà nǝia a nza.</char><verse eid="JHN 10:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="JHN 10:4" />
    <char style="wj">Anzǝm mǝnana pusǝna anzur male kat a nza ka, kǝ upia wia a dǝmba, sǝ anzur kǝ kpate acemǝnana à sùrǝ́nà rǝ gi.</char> <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" /><char style="wj">Anzur pa nǝ̀ gya atà bǝri-ɓwa ɗang; à nǝ̀ ɓanggi wi, acemǝnana à súrǝ̀ gi ɗàng.</char><verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />Yesu nea wia man yì cau aɓa ɓi, sǝ yia ka à bwalta gìr mǝnana nakiyi ka ɗàng.<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />Ace mǝno ka Yesu bǝlia wia ɓālǝi ama:</para>
  <para style="pi" vid="JHN 10:7">
    <char style="wj">Mǝ nda ban na wun mǝsǝcau, mǝ nda kun-nda mala anzur.</char> <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" /><char style="wj">Acili aɓwana mǝnana kat à akàm dǝmba à yiu ka, amǝn'í na andǝ amǝ'ɓǝmbǝriban. Anzur mǝ'mǝsǝcau nì okia wia ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 23:1">Ir 23:1</ref>; <ref loc="EZK 34:2">Ezǝk 34:2</ref></char>.</note> <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" /><char style="wj">Mǝ ndà kun-nda. Ɓwa mǝnana kat kútí nǝ banam ngga nǝ̀ kum àwá; nǝ̀ kutio sǝ nǝ̀ puro, sǝ nǝ̀ kum girlina.</char><verse eid="JHN 10:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="JHN 10:10" />
    <char style="wj">Mǝn'í ka kǝ yiu ace iun'í, ace wal-lú, andǝ kiɗiki gir. Sǝ mim ngga ǝn yiu ace pea aɓwana yilǝmu, andǝ do mǝɓoarne mǝnana lùmsǝo a koya njarì ka.</char> <verse eid="JHN 10:10" /><verse number="11" style="v" sid="JHN 10:11" /><char style="wj">Mǝ nda yálgír mǝɓoarne. Yálgír mǝɓoarne ka kǝ pa yilǝmi, nǝ̀ wu ace anzur male. </char><note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:11">Isha 40:11</ref>; <ref loc="EZK 34:11">Ezǝk 34:11</ref>; <ref loc="HEB 13:20">Ib 13:20</ref>; <ref loc="1PE 5:4">1Bit 5:4</ref>; <ref loc="REV 7:17">Sǝn 7:17</ref>; <ref loc="1JN 3:16">1Yoh 3:16</ref>; <ref loc="JHN 15:13">Yoh 15:13</ref></char>.</note> <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" /><char style="wj">Sǝ ɓwa mǝnana à twali à kǝ mbwe, ace tsǝkir anzur, sǝ yì ka, yálgír na ɗang, sǝ anzur ka a male na raka, ɓǝ̀ sǝn nvwa-bondo aban yiu ka, nǝ̀ nying anzur nǝ̀ ɓangŋa, sǝ nvwa-bondo nǝ̀ bwal atà anzur sǝ nǝ̀ mesǝkia.</char> <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" /><char style="wj">Ɓwa mǝnana à twali a túró-boalo ace yál agir ka, nǝ̀ ɓangŋa acemǝnana yì ka, túró-boalo nda pakkiyi ka, kǝgìr oasǝi arǝ anzur nì ɗàng.</char><verse eid="JHN 10:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="JHN 10:14" />
    <char style="wj">Mǝ nda yálgír mǝɓoarne; ǝn súrǝ̀ anzur mem, sǝ yia gbal ka à súrǝàm,</char> <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" /><char style="wj">kǝla mǝnana Tárrám súrǝàm, sǝ ǝn súrǝ̀ Tárrám ka. Ən pa yilǝmem ace anzur mem.</char><note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 11:24">Mat 11:24</ref></char>.</note> <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" /><char style="wj">Mǝ ndanǝ aɓea anzur mem mǝnana à pà aɓa domwan man raka. Dumǝna púp mǝ nǝ yinǝia gbal. À nǝ̀ kwaki kiria à nǝ̀ ok giem, sǝ domwan ngga nǝ̀ duk mwashat, nǝ yálgír mwashat.</char><note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 56:8">Isha 56:8</ref>; <ref loc="JHN 11:52">Yoh 11:52</ref>; <ref loc="JHN 17:20">17:20</ref>; <ref loc="EPH 2:13-18">Afi 2:13-18</ref>; <ref loc="1PE 2:25">1Bit 2:25</ref></char>.</note><verse eid="JHN 10:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="JHN 10:17" />
    <char style="wj">Tárrám kǝ earcem acemǝnana ǝn eare mǝ nǝ pà yilǝmem mǝ nǝ wu, ace mana ɓǝ̀n é ɗǝm ɓǝ̀n lo nǝ yilǝmu ka.</char> <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" /><char style="wj">Kǝɓwa pà nǝ̀ twal yilǝmem a rǝàm ɗàng. Ən nggǝ pa yilǝmem nǝ eare mem. Mǝ ndanǝ rǝcandǝa mǝ nǝ pà yilǝmem, sǝ mǝ ndanǝ rǝcandǝa mǝnana mǝ nǝ é ɗǝm ngga. Mǝnia ka nda nzongcau mǝnana Tárrám pam ama ɓǝ̀ ǝn pak ka.</char><verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />Lang Yesu banggina acau mǝnia ka, kara ɗenyicau mala amǝ Yahudi a rǝi gakya. <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />Aɓea aɓwana pas aɓalǝia à bang ama, &lt;&lt;Yì ka, ndanǝ kukwar arǝì! Pà aɓa ɗenyicau male ɗàng! Ace man sǝ wu kǝ kwaki kir wun arǝì?&gt;&gt;<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />Sǝ acili aɓwana ka à bang ama, &lt;&lt;Ɓwa mǝnana ndanǝ kukwar arǝì ka, pà nǝ̀ bang amǝnia yì acau ka ɗàng! Lang sǝ kukwar nǝ̀ mǝn mǝsǝ ante?&gt;&gt;<verse eid="JHN 10:21" /></para>
  <para style="s">Aɓwana-mǝgule mala amǝ Yahudi <optbreak /> ginǝki Yesu</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />Nda nǝ kunɗwal, sǝ yi karǝ nǝ kúnì Hanuka, yì Lamsan ace ɗenyi nǝ bákú mǝnana à tàr Ndàmǝgule nǝi ace Ɓakuli, aɓa Urǝshalima ka. <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />Ɓè pwari ka, Yesu gya kǝ kutio aɓa ɓè buì mala Ndàmǝgule mala Ɓakuli, mǝnana à tunǝki ama Tara mala Solomon ngga.<note caller="+" style="f"><char style="fr" closed="false">10:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 3:11">Atúró 3:11</ref>; <ref loc="ACT 5:12">5:12</ref></char>.</note><verse eid="JHN 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 10:24" />Aɓwana-mǝgule mala amǝ Yahudi yi ramba a baní, sǝ à ɗì ama, &lt;&lt;Lang sǝ a nǝ nying sǝm anggo aɓa pǝndǝa? Ɓǝ̀ a nda Kǝrǝsti ka, Pura sǝm bwāng, bangga sǝm.&gt;&gt;<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />Yesu nyesǝia wia ama:</para>
  <para style="pi" vid="JHN 10:25">
    <char style="wj">Ən angŋa dǝmba ǝn nanà wun, sǝ wun ngga, wu earnǝ mim ɗang. Atúró mǝnana ǝn nggǝ pea aɓa rǝcandǝa mala Tárrám ngga, à nda à lǝmdǝ koyan nda mim ngga.</char> <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" /><char style="wj">Sǝ wun ngga wu earnǝ mim ɗang, acemǝnana wu nda ka nzur mem ɗàng.</char> <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" /><char style="wj">Anzur mem kǝ ok giem; ǝn súrǝ̀ia, sǝ à kǝ kpatam.</char> <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" /><char style="wj">Ən nggǝ pea wia yilǝmu mǝnana málá male pà kàm raka, sǝ à pà nǝ̀ kìɗìkì à nǝ̀ ueɓà ɗàng. Kǝɓwa pà nǝ̀ fea a buam ɗàng.</char> <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" /><char style="wj">Tárrám mǝnana pam mia ka kútì koyan ngga kat nǝ rǝcandǝa. Kǝɓwa pà nǝ̀ gandǝ ea arǝì ɗàng.</char> <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" /><char style="wj">Mim sǝnǝ Tárrám ka sǝm nda mwashat.</char><verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />Amǝ Yahudi pwan atali ɗǝm ama à nǝ̀ ɓukki. <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />Sǝ Yesu nea wia ama, <char style="wj">&lt;&lt;Ən pakkina agir mǝɓoarne pas, a ɓadǝm wun, mǝnana Tárrám túrǎm ama ɓǝ̀n pea ka. Nda ace mǝye mwashat aɓalǝia sǝ wu kǝ earce wun nǝ̀ ɓukkiam?&gt;&gt;</char><verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />Pǝlǝa à eari wi ama, &lt;&lt;Pà ace kǝ agir mǝɓoarne mǝnana à pea, sǝ sǝm earce ama sǝm nǝ̀ ɓukkio ka ɗàng. Nda ace cau ɓǝsǝki Ɓakuli mǝnana a na ka. We ka, a nda ɓwamǝpǝndǝe sǝ a kǝ twal ɓamuro a nda Ɓakuli!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 24:16">Pǝris 24:16</ref>; <ref loc="MRK 14:64">Mar 14:64</ref></char>.</note><verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />Yesu earia wia ama:</para>
  <para style="pi" vid="JHN 10:34">
    <char style="wj">Pà akàm à gilǝe aɓa Malǝmce Nggurcau ma'wun mbo, mǝnana Ɓakuli bang ama, &lt;&lt;Wu nda ka aɓakuli&gt;&gt; ka re?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:34 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 8:17">Yoh 8:17</ref>; <ref loc="PSA 82:6">Ang 82:6</ref></char>.</note> <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" /><char style="wj">Wu sǝlǝna ama cau mǝnana Malǝmce bang ngga makgìr pà arǝì ɗàng, camǝna anggo pà nǝ̀ nggaɗi ɗang. Sǝ ɓǝa aɓwana mǝno à ak cau mǝno ka, à tunǝia ama &lt;&lt;aɓakuli&gt;&gt; ka,</char> <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" /><char style="wj">ace mana sǝ wu twali ama cau ɓǝsǝki Ɓakuli na ǝn na ka, mǝnana ǝn bang nǝma &lt;&lt;Mǝ nda Muna mala Ɓakuli,&gt;&gt; yì mim mǝnana Ɓakuli tàram sǝ tasǝam a ɓanza ka?</char> <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" /><char style="wj">Wu kǝa earnǝ mim ɗang ɓǝ̀ atúró mǝnana ǝn pakkiyi ka a mala Tárrám Ɓakuli na raka.</char> <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" /><char style="wj">Sǝ ɓǝ̀ atúró male na ǝn pakkiyi ka, ɓǝ̀ pà wu nǝ̀ earnǝ mim raka, wu earnǝ agir-ndali mǝnana ǝn pea ka, ace mǝnana ɓǝ̀ wu sǝlǝa, sǝ ɓǝ̀ kpaka wun ama, Tárrám ngga nda a ɓalǝam, sǝ mim ngga mǝ nda aɓa Tárrám.</char><verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />Nyar ɗǝm ngga, à ɓariki ama à nǝ̀ bwal Yesu, kara purî ɓabuia. <verse eid="JHN 10:39" /><verse number="40" style="v" sid="JHN 10:40" />O kya yàl a nkaring Mùr mala Jodan, yi pur a ban mǝnana Yohana pakkiyi batisǝma kam atà dǝmbe ka. Akanó sǝ kya do. <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />Aɓwana pas yiu a baní, à kǝ bang arǝarǝia ama, &lt;&lt;Yohana pak kǝ gir'ndǝlǝki ɗàng, sǝama acau mǝnana ne amur man yì ɓwa ka, à yì pur a mǝsǝcau.&gt;&gt; <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />Pas atà aɓwana mǝnana abanì ka à pà ɓamuria aban Yesu.<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">Lo mala Liazaro a ɓembe</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />Ɓè ɓwabura nda kam lùllǝì ama Liazaro. Rǝì pakki wi. Yì andǝ amǝ'eambi amuna-mamǝna ɓari, Maryamu andǝ Marta ka, à ndanǝ do a Betani.<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 11:1">Mar 11:1</ref>; <ref loc="LUK 10:38">Luk 10:38</ref></char>.</note> <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />Mǝnia yì Maryamu mǝ'eambi Liazaro nong nǝ rǝkwana ka, nda kǝ ɓwama mǝnana nǝnzǝ́mò yiu soapi Mǝtalabangŋo Yesu mùrú mǝ'rǝmɓoarne arǝ akusǝi, sǝ esǝki wi nǝ nyang-múrí ka.<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 12:3">Yoh 12:3</ref>; <ref loc="LUK 7:38">Luk 7:38</ref>; <ref loc="MRK 14:3">Mar 14:3</ref></char>.</note> <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />Amǝ'eambu amamǝna mǝnia ɓari ka, à túrban atà Mǝtalabangŋo Yesu ɓǝa ne wi ama, gyajam male, mǝnana earkiyi ace raka, rǝì eari wi ɗang.<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />Lang Yesu yi ok ce ka, na ama, <char style="wj">&lt;&lt;Rǝkwana mala Liazaro ka pà nǝ̀ ká nǝi a lú ɗang, nda ace lǝmdǝ gulo mala Ɓakuli, sǝ àkǝ̀ ce gbal sǝ Muna mala Ɓakuli nǝ̀ kum gulo.&gt;&gt;</char> <verse eid="JHN 11:4" /><verse number="5" style="v" sid="JHN 11:5" />Yesu ka earce Marta andǝ amǝ'eambi Maryamu andǝ Liazaro. <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />Kat andǝ a mani ka, lang ok ce rǝkwana mala Liazaro ka, akrǝi pak aɓea nongŋo ɓari aban mǝnana ndakam ngga.<verse eid="JHN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 11:7" />Anzǝm mani ka pǝlǝa banggi alaggana male ama, <char style="wj">&lt;&lt;Wu fa sǝm nǝ̀ nyare a Yahudi.&gt;&gt;</char><verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />Sǝ alaggana male ne wi ama, &lt;&lt;Malǝm, àkǝ̀ dyan tù, sǝ amǝ Yahudi lo ama à nǝ̀ ɓukkio nǝ atali, sǝ a kǝ na ama a nǝ nyar kano ɗǝm le?&gt;&gt;<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />Pǝlǝa Yesu earia wia ama, <char style="wj">&lt;&lt;Abúpwari mala tǎlaban aɓa pwari mwashat ka à nda lum-nong-ɓari. Nǝ pwari ka ɓwa nǝ̀ gandǝ gya pà nǝ̀ anndǝ ɗang, acemǝnana kǝ sǝn tǎlaban mala ɓanza man.</char> <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" /><char style="wj">Sǝ nǝ dú ka, à nǝ̀ gandǝ annda, acemǝnana à pànǝ tǎlaban ɗang.&gt;&gt;</char> <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Gyajam ma'sǝm yì Liazaro ka kongŋǝna a ntulo, sǝ ado ka mǝ nǝ ká kàm mǝ nǝ nggá loasǝi.&gt;&gt;</char><verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />Sǝ alaggana male na ama, &lt;&lt;Mǝtalabangŋo, ɓǝ̀ nda a ntulo ka, lǝmdǝ ama rǝì nǝ̀ malâ.&gt;&gt; <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />Yia ka à twali ama mǝsǝrǝ ntulo na Yesu nakiyi ce ama Liazaro nonggi ka, sǝ Yesu ka nda arǝ na ama Liazaro wuna.<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />Pǝlǝa Yesu pùrria wia kwas, banggia wia ama, <char style="wj">&lt;&lt;Liazaro ka wuna.</char> <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" /><char style="wj">Sǝ ace wun ngga, ban kǝ ɓoaram mǝnana ǝn pa abanì raka, acemǝnana ado wuni sǝ wun nǝ̀ pà ɓamur wun a banam pepe. Wu lo, sǝm nǝ̀ o a baní.&gt;&gt;</char><verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />Toma (mǝnana à tunǝki ama Pasa ka) ne aɓi alaggana ama, &lt;&lt;Wu longŋi kat sǝm nǝ̀ o atà Malǝm, ace mǝnana ɓǝ̀ sǝm kya wu atè!&gt;&gt;<verse eid="JHN 11:16" /></para>
  <para style="s">Yesu nda lo mala lú andǝ yilǝmu</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />Lang Yesu bwalǝna Betani ka, à banggi wi ama, Liazaro pàngŋǝ̀nà nongŋo ine a ɓembe. <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />Betani ka sapi Urǝshalima ɗang, nda a baní tù, yàle bwal mel ɓari ɗang, <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />sǝ amǝ Yahudi pas yiu aban Marta andǝ Maryamu, à yiua girikia ace lú mala mǝ'eambia.<note caller="+" style="f"><char style="fr" closed="false">11:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOB 2:11">Ayu 2:11</ref></char>.</note><verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />Lang Marta ongŋǝna ama Yesu na kǝ yiu ka, puro nǝ̀ nggá kúllì. Sǝ Maryamu ka ueo a ɓala. <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />Marta ne Yesu ama, &lt;&lt;Mǝtalabangŋo, ɓǝ̀ pǝlǝ ama a ndakani ka, ɓǝ́ mǝ'eambam pa nǝ̀ wu ɗàng! <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />Sǝ ǝn sǝlǝna ama, ko ado ka Ɓakuli nǝ̀ po gìr mǝnana kat a zǝm ngga.&gt;&gt;<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />Yesu pǝlǝa banggi wi ama, <char style="wj">&lt;&lt;Mǝ'eambǝo nǝ̀ lo nǝ yilǝmu ɗǝm.&gt;&gt;</char><verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />Marta na ama, &lt;&lt;Ən sǝlǝna ama nǝ̀ lo nǝ yilǝmu a lo mala alú a masǝlǝata apwari.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 12:2">Dan 12:2</ref>; <ref loc="JHN 5:28">Yoh 5:28</ref>; <ref loc="ACT 24:15">Atúró 24:15</ref></char>.</note><verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />Yesu ne wi ama, <char style="wj">&lt;&lt;Mǝ nda lo mala alú sǝ mǝ nda yilǝmu. Ɓwa mǝnana kat pà ɓamúrì a banam ngga, ko ɓǝ̀ wù ka, nǝ̀ lo nǝ yilǝmu.</char> <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" /><char style="wj">Sǝ ɓwa mǝnana kat nda nǝmǝsǝi sǝ pà ɓamúrì a banam ngga, pà nǝ̀ wù ɗang. A earǝna nǝ cau man le?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 6:47">Yoh 6:47</ref>; <ref loc="JHN 8:51">8:51</ref></char>.</note><verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />Pǝlǝa Marta eari wi ama, &lt;&lt;E, Mǝtalabangŋo, ǝn earǝna nǝ we, ama a nda Kǝrǝsti Mǝ'amsǝban, Muna mala Ɓakuli, mǝnana Ɓakuli bang ama nǝ̀ yiu a ɓanza ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:16">Mat 16:16</ref></char>.</note><verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />Marta pǝlǝa nyare kya tunǝ mǝ'eambi Maryamu a giriban, sǝ ne wi ama, &lt;&lt;Malǝm yina, sǝ kǝ earce sǝno.&gt;&gt; <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />Lang Maryamu nǝ̀ ok anggo ka, kara lo a kaurǝa, wari a baní. <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />Yesu ka malaká bwal là peatu ɗàng, nda àkǝ̀ ban mǝnana Marta kumi kàm ngga. <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />Lang aɓwana mǝnana atà Maryamu a ɓala, aban girike, sǝni lo pur tsuk-tsuk ka, à lo atè. À twali ama kǝ um nǝ o a ɓembe nǝ̀ nggá ɓua abanì.<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />Maryamu yi bwal ban Yesu. Lang mǝsǝì nǝ̀ kpa arǝ Yesu ka, yi kūndǝo a ɓadǝmbi, kǝ na ama, &lt;&lt;Mǝtalabangŋo, ɓǝ̀ pǝlǝ ama a nda kani ka, ɓǝ́ mǝ'eambam wù ma ɗang!&gt;&gt;<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />Lang Yesu sǝni aban ɓua, sǝ sǝn aɓwana mǝnana à yiu atè ka aban ɓua gbal ka, gìr nî je Yesu a ɓabumi kǝ̀rkǝ́r. <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />Pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Ake ɗe sǝ wu tsǝì?&gt;&gt;</char></para>
  <para style="p" vid="JHN 11:34">Sǝ à ne wi ama, &lt;&lt;Mǝtalabangŋo, yiu sǝni.&gt;&gt;<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />Yesu sukki mǝrǝm. <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />Aɓwana mǝnana aban came abanì ka à na ama, &lt;&lt;Wu sǝn ɓekǝ earcearǝu mǝnana ndanǝi arǝì ka!&gt;&gt;<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />Sǝ aɓia aɓwana na ama, &lt;&lt;Mǝnia yì ɓwa ka gandǝ mǝn mǝsǝ nte, anggo re? Man tsǝa sǝ gandǝ tamsǝ lú mala Liazaro ɗàng?&gt;&gt;<verse eid="JHN 11:37" /></para>
  <para style="s">Yesu loasǝ Liazaro a ɓembe</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />Nǝ́ cê kùlkùl a ɓabumi più ka, Yesu yi bik ban ɓembe. Ɓembe ka à gwami aɓa tali, sǝ à gìr kúni nǝ tali.<note caller="+" style="f"><char style="fr" closed="false">11:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 27:60">Mat 27:60</ref>; <ref loc="MRK 15:46">Mar 15:46</ref>; <ref loc="LUK 24:2">Luk 24:2</ref>; <ref loc="JHN 20:11">Yoh 20:11</ref></char>.</note> <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />Yesu na ama, <char style="wj">&lt;&lt;Wu gǝshi talî!&gt;&gt;</char></para>
  <para style="p" vid="JHN 11:39">Sǝ Marta mǝ'eam lú ne Yesu ama, &lt;&lt;Mǝtalabangŋo, lú ka à tsǝì pàngŋǝ̀nà nongŋo ine adyan. Rǝmban mǝɓike nǝ̀ akiban!&gt;&gt;<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />Yesu banggi wi ama, <char style="wj">&lt;&lt;Ən no nǝma ɓǝ̀ a earnǝ mim ngga a nǝ sǝn gulo mala Ɓakuli re?&gt;&gt;</char><verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />Pǝlǝa aɓea ɓwana mǝnana abanì ka à gǝshi talî. Yesu loasǝ mǝsǝì a kùli sǝ na ama, <char style="wj">&lt;&lt;We Dâ, ǝn pakko yàwá mǝnana a ongŋǝnam ngga.</char> <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" /><char style="wj">Ən sǝlǝna nǝma ko aya pwari ka a kǝ oem, sǝ ado ka ǝn na mǝnia yì cau ka ace aɓwana man kani ka, ace mǝnana ɓǝà ear ama a nǝ̀ túrǎm.&gt;&gt;</char><verse eid="JHN 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43" />Lang bangŋǝna anggo ka, sǝ tunǝban nǝ giu mǝcandǝe, ama, <char style="wj">&lt;&lt;Liazaro, puro!&gt;&gt;</char> <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />Pǝlǝa Liazaro mǝnana lú na ka puro, abuí andǝ akusǝi ka, à mārǝkia nǝ bugir, sǝ ɓamǝsǝi ka, à mārǝi nǝ nggubyau. Yesu banggia wia ama, <char style="wj">&lt;&lt;Wu panzǝi, sǝ wu nyi ɓǝ̀ o!&gt;&gt;</char> <figure style="fig" alt="Lazarus comes out of the tomb." file="WA03868b.tif" size="col" loc="JHN 11:44" copy="Wade Images" ref="11:44">Liazaro purî ɓembe</figure><verse eid="JHN 11:44" /></para>
  <para style="s">Kùrkûn amur Yesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Matiu 26:1-5</ref>; <ref loc="MRK 14:1">Markus 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Luka 22:1</ref>,<ref loc="LUK 22:2">2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />Pas atà aɓwana mǝnana à yiua makki Maryamu kun, sǝ à sǝn gìr mǝnia Yesu pè ka, à pà ɓamuria a baní. <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />Sǝ aɓea ateà ka à o aban amǝ Farisi à kya banggia wia gìr mǝnana Yesu pè ka. <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />Pǝlǝa amǝ Farisi andǝ agbani pǝris tunǝ do mala amǝkùrcau. À ɗì rǝia ama, &lt;&lt;Mana ado sǝm nǝ̀ pa? Aɓa mǝsǝcau ka, ɓwa mǝnia nda kǝ pakki agir-ndǝlǝki pas ka! <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />Ɓǝ̀ sǝm ɗeki sǝ lidǝmba anggo ka, muna-ɓwapǝndǝa kat nǝ̀ earnǝi. Sǝ amǝ lwa mala amǝ Roma nǝ̀ yia kiɗiki Ndàmǝgule mala Ɓakuli ma'sǝm andǝ nzali ma'sǝm!&gt;&gt;<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />Mwashat aɓalǝia, mǝnana à tunǝki ama Kayafas, mǝnana nda Pǝris Mǝgule a bàkú mǝno ka, bang ama, &lt;&lt;Wu súrǝ̀ cau mǝnana wu nakiyi ka ɗàng! <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />Wu sǝlǝ mbo ama nǝ̀ ɓoaribanì ɓǝ̀ ɓwa mwashat wu ace aɓwana, amur mǝnana amǝ Roma ɓǝà yi twalta aɓwana mala nzali Yahudi ma'sǝm ngga?&gt;&gt; <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />Mǝnia yì cau Kayafas ne ka, bangŋe mala ɓamúrì na ɗang. Acemǝnana yì nda Pǝris Mǝgule a mǝno yì pǝlǝa ka, nda ɓangnǝ-ɓangnǝa ama, Yesu nǝ̀ yia wu ace aɓwana mala nzali Yahudi ka. <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />Sǝ pà ace amǝ Yahudi nǝmurǝia ɗàng, nda gbal ace acilia aɓwana kat arǝ anzali aɓa ɓanza, amǝnana à nǝ̀ yia pà ɓamuria aban Ɓakuli, sǝ nǝ̀ dapi ɓamuria kat ɓǝa yi duk mwashat ka.<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />Twal amǝno yì pwari ka, aɓwana-mǝgule mala amǝ Yahudi kutia alkita anjar mǝnana à nǝ̀ wal-lú Yesu ka. <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />Ace mani ka Yesu nyare ging ɗǝm bwāng aɓalǝ amǝ Yahudi ɗang. Nying Urǝshalima sǝ o a njenza, aɓa pǝɗanban tù a ban ɓè muna-là mǝnana à tunǝi ama Ifǝrem ngga. Akanó sǝ kya do andǝ alaggana male.<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />Lang pwari Lamsan mala Yàlîmurû gbashìnà ka, amǝ Yahudi pas purkio arǝ aɓea aban aɓa nzali Yahudi sǝ à o a Urǝshalima, ace mǝnana ɓǝà kya gilǝki rǝia aɓa peri ace man yì Lamsan ngga. <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />À camarǝ alta Yesu. À yì came aɓa Ndàmǝgule mala Ɓakuli sǝ à kǝ ɗiki rǝarǝia ama, &lt;&lt;Lang sǝ wu sǝni? Nǝ̀ yiu a man yì Lamsan ngga le?&gt;&gt; <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />Anggo ka agbani Pǝris andǝ amǝ Farisi angŋa dǝmba à hamǝna ama, ɓǝ̀ kǝɓwa súrǝ́nà rǝ ban mǝnana Yesu nda kam ngga, ɓwe ɓǝ̀ yì na ce, ace mǝnana à nǝ̀ bwali ka.<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">Maryamu soapi Yesu <optbreak /> mùrú mǝ'rǝmɓoarne</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matiu 26:6-13</ref>; <ref loc="MRK 14:3-9">Markus 14:3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />Lang Lamsan Yàlîmurû ueo nongŋo tongno-nong-mwashat ka, Yesu wari a Betani, muna-là mala Liazaro, ɓwa mǝnana wu, sǝ Yesu loasǝi nǝ yilǝmu ka.<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:6-11">Mat 26:6-11</ref>; <ref loc="MRK 14:3-9">Mar 14:3-9</ref>; <ref loc="LUK 7:37-38">Luk 7:37-38</ref></char>.</note> <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />À lam girlina mala pwarikpǝra ace pè Yesu gulo. Marta nda gaki girlina ka, sǝ Liazaro ka nda aɓalǝ aɓwana mǝnana à lì girlina andǝ Yesu ka. <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />Pǝlǝa Maryamu twal muna-dù mùrú mǝ'rǝmɓoarne, mǝnana à pè nǝ nard mǝɓoarnsari, sǝ kúrè pa bǝti raka, soe arǝ akusǝ Yesu, sǝ hasǝkia nǝ nyang múrí. Kara rǝm mùrú mǝɓoarne man aki ɓala kat.<verse eid="JHN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4" />Sǝ Yahuda Iskariyoti, mwashat atà alaggana mǝnana nǝ̀ nggá mak Yesu ka, na ama,<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 6:71">Yoh 6:71</ref>; <ref loc="JHN 13:26">13:26</ref></char>.</note> <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />&lt;&lt;Mana tsǝa sǝ à ginǝ mak man yì mùrú ka a kún dinari gbǝman-tàrú, sǝ boale ka à pè mia amǝ'tǝ̀r ɗàng?&gt;&gt; <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />Yahuda ka bang anggo, pà acemǝnana kǝ ɓuàce amǝ'tǝ̀r ka ɗàng, nda acemǝnana yì ka, mǝn'í na ka; sǝ acemǝnana yì nda mǝbwal ndaboalo mala alaggana mala Yesu ka, pak ka kǝ iu aɓa boale ace ɓamur rǝì.<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />Sǝ Yesu na ama, <char style="wj">&lt;&lt;Wu nying ɓwama man zàng! Gìr mǝnana pe ka nda ace gilǝki luem ace pwari tsǝkban mem.</char> <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" /><char style="wj">Wun ngga, wu nda a tarǝ wun wunǝ amǝ'tǝ̀r ko aya pwari ka, sǝ mim ngga ǝn pa atà wun koya pwari ɗàng.&gt;&gt;</char><verse eid="JHN 12:8" /></para>
  <para style="s">Kùrkûn amur Liazaro à nǝ̀ wal-luí</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />Amǝ Yahudi pas ongŋǝna ama Yesu warina a Betani. Pǝlǝa à waria sǝne andǝ Liazaro mǝnana Yesu loasǝi nǝ yilǝmu a ɓembe ka. <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />Pǝlǝa agbani Pǝris kurkunarǝia, à nǝ̀ wal Liazaro gbal, <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />acemǝnana nda ace loasǝe nǝ yilǝmu a ɓembe sǝ pas aɓalǝ amǝ Yahudi kǝ ginǝkia, sǝ à kǝ pa ɓamuria a ban Yesu.<verse eid="JHN 12:11" /></para>
  <para style="s">Kutio limurǝm mala Yesu aɓa Urǝshalima</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matiu 21:1-11</ref>; <ref loc="MRK 11:1-11">Markus 11:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />Ban fana ka, aɓwana pas mǝnana à yiu ace Lamsan Yàlîmurû ka, à yì ok ama Yesu nda njar aban yiu a Urǝshalima. <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />Pǝlǝa à twalki ambú nkangga a buia sǝ à puro à nǝ̀ ká kúllì. À kǝ mak-gāwàn, à kǝ na ama,</para>
  <para style="q1" vid="JHN 12:13">&lt;&lt;Wu ɓwangsǝki Ɓakuli!</para>
  <para style="q1" vid="JHN 12:13">Tsǝkbu mala Ɓakuli na</para>
  <para style="q2" vid="JHN 12:13">amur ɓwa mǝnana kǝ yiu</para>
  <para style="q1" vid="JHN 12:13">aɓa lullǝ Mǝtalabangŋo</para>
  <para style="q2" vid="JHN 12:13">Ɓakuli ka!</para>
  <para style="q1" vid="JHN 12:13">Tsǝkbu mala Ɓakuli na</para>
  <para style="q2" vid="JHN 12:13">amur Murǝm mala</para>
  <para style="q1" vid="JHN 12:13">amǝ Isǝrayila!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 118:25">Ang 118:25</ref>,<ref loc="PSA 118:26">26</ref></char>.</note><verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />Yesu kum muna ndambǝritso sǝ eauwe do a nzǝmi, kǝla mǝnana Malǝmce na ka ama,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />&lt;&lt;Wun amǝ Siyona,</para>
  <para style="q2" vid="JHN 12:15">ɓangciu ɓǝ̀ kǝa</para>
  <para style="q1" vid="JHN 12:15">pakka wun ɗàng!</para>
  <para style="q1" vid="JHN 12:15">Murǝm ma'wun ndya</para>
  <para style="q2" vid="JHN 12:15">kǝ yiu anzǝm muna</para>
  <para style="q2" vid="JHN 12:15">ndambǝritso ka!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 9:9">Zak 9:9</ref></char>.</note><verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />A dǝmbe ka alaggana mala Yesu bwalta amǝnia yì agir ka ama lùmsǝo mala ɓangnǝa na ka ɗàng. Anzǝm mǝnana Ɓakuli loasǝna Yesu nǝ yilǝmu a ɓembe, sǝ Yesu kutina aɓa ɓoarɓwa male ka, nda sǝ ɓālǝia kasǝna arǝ gir mǝnana kumban ngga, sǝ à yì sǝlǝ ama agir mǝnia kat ka, à nda kam à gilǝe amur Kǝrǝsti aɓa Malǝmce.<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />Ɓwabunda mǝnana à nda atà Yesu a pwari mǝnana tunǝ Liazaro ɓǝ̀ purî ɓembe, sǝ loasǝi nǝ yilǝmu ka, à camarǝ banggia aɓwana cau mala gìr mǝnana à sǝn ngga. <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />Gìr mǝnana tsǝa sǝ ɓwabundǝa puro waria kúllí Yesu ka, nda acemǝnana à ongŋǝna ama pak mǝnia yì gir'lǝmdǝa ka. <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />Pǝlǝa amǝ Farisi ne arǝarǝia ama, &lt;&lt;Wu sǝni, túró mǝɓane nda sǝm pakkiyi ka. Ɓanza pwana rǝì kat umna kpate!&gt;&gt;<verse eid="JHN 12:19" /></para>
  <para style="s">Yesu nacau amur lú male</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />Aɓea amǝ Gǝrik nda aɓalǝ aɓwana mǝnana à waria peri a Urǝshalima a Lamsan Yàlîmurû ka. <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />À yiu a ban Filip, mǝnana yì gbal ka pur a Beseda aɓa Galili ka, sǝ à zǝmba ama, &lt;&lt;Ɓwamǝgule, sǝm nggǝ earce sǝn Yesu.&gt;&gt; <verse eid="JHN 12:21" /><verse number="22" style="v" sid="JHN 12:22" />Pǝlǝa Filip wario kya banggi Andǝru, sǝ yia kǝm à kutio à kya banggi Yesu.<verse eid="JHN 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23" />Yesu nyesǝia wia ama:</para>
  <para style="pi" vid="JHN 12:23">
    <char style="wj">Ado ka pwarî yina, yì mǝnana Ɓakuli nǝ̀ lǝmdǝ gulo mala Muna mala Ɓwa ka.</char> <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" /><char style="wj">Mǝ nda ban bangga wun mǝsǝcau, ɓǝ̀ mǝsǝ mǝssa kpa a nzali sǝ wu raka, nǝ̀ ueo anggo nǝmurǝì mwashat. Sǝ ɓǝ̀ wu ka, nǝ̀ pusǝ amǝsǝì pas.</char> <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" /><char style="wj">Ɓwa mǝnana kat kǝ earce yilǝmi ka, nǝ̀ ɗwanyibanì, sǝ ɓwa mǝnana ginǝki yilǝmi a man yì ɓanza ka, nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char> <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" /><char style="wj">Ɓwa mǝnana kat earce nǝ̀ do a ɓatam ngga, dumǝna púp nǝ̀ yiu atàm, ace mǝnana ban mǝnana kat mǝ nda kam ngga, àkǝ̀ banì sǝ guro mem nǝ̀ pa. Sǝ Tárrám gbal ka nǝ̀ gusǝlǝ ɓwa mǝnana kat pà ɓamúrì kǝ pak túró a ɓatam ngga.</char><verse eid="JHN 12:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="JHN 12:27" />
    <char style="wj">Ado ka ɓabumam kǝ pi, sǝ aman sǝ mǝ nǝ na? Mǝ nǝ na nǝma, &lt;&lt;Dâ, amsǝam aɓa mǝnia yì tanni ka ɓǝ̀ kǝa sulǝ amuram ɗàng&gt;&gt; le? Awo! Mǝnia ka nda tǝr yiu mem, acemǝnana ɓǝ̀n kutio aɓa mǝnia yì bu-pwari mala tanni ka.</char> <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" /><char style="wj">We Dâ, yinǝ gulo ace lùllǝò!</char></para>
  <para style="p" vid="JHN 12:28">Kara Ɓakuli nacau nǝ kuli ama, &lt;&lt;Ən angŋa dǝmba ǝn gusǝlǝna lullǝam, sǝ Mǝ nǝ gusǝlǝi ɗǝm.&gt;&gt; <verse eid="JHN 12:28" /><verse number="29" style="v" sid="JHN 12:29" />Lang ɓwabundǝa mǝnana à came a banì à ok man yì giu ka, cilia twali ama mgbarangce na. Aɓea ɓwana ka à bang ama, &lt;&lt;Mǝturonjar mala Ɓakuli nda ne wi cau ka!&gt;&gt;<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Man yì giu ka pà acem sǝ yiu ɗang, nda ace wun.</char> <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" /><char style="wj">Pwari mala pakkî mǝnia yì ɓanza ɓashi ka, kārǝ́na; ado sǝ Ɓakuli ak murǝm arǝ Shetan, yì murǝm mala ɓanza man.</char> <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" /><char style="wj">Sǝ anzǝm mǝnana à loasǝnam amur nggun-gangndǝi ka, mǝ nǝ nun ɓwapǝndǝa kat a banam.&gt;&gt;</char> <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />Yesu bang anggo acemǝnana ɓǝ̀ lǝmdǝ ulang lú mǝnana nǝ wu ka.<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />Ɓwabunda pǝlǝa ne Yesu ama, &lt;&lt;Sǝm ok aɓa Nggurcau mala Musa ama, Kǝrǝsti ka nǝ̀ dum nǝ yilǝmu mǝnana málá male pà kàm raka.<note caller="+" style="f"><char style="fr" closed="false">12:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 110:4">Ang 110:4</ref>; <ref loc="ISA 9:7">Isha 9:7</ref>; <ref loc="EZK 37:24">Ezǝk 37:24</ref>,<ref loc="EZK 37:25">25</ref>; <ref loc="DAN 7:14">Dan 7:14</ref></char>.</note> Sǝ lang sǝ a na ama, &lt;Dumǝna púp, à nǝ̀ loasǝ Muna mala Ɓwa amur nggun-gangndǝi?&gt; Yana ɓwe nda man yì &lt;Muna mala Ɓwa&gt; ka?&gt;&gt;<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />Yesu earia wia ama, <char style="wj">&lt;&lt;Tǎlaban ngga nda a ban wun ado, sǝ banì pà nǝ̀ sau ɗang. Wu gya aɓa mǝnia yì tǎlaban ado mǝnana nda a ban wun ngga, ace mǝnana ɓǝ̀ pǝndǝa ɓǝ̀ kǝa gìr amur wun ɗàng. Aɓwana mǝnana à kǝ gya aɓa pǝndǝa ka, à kǝ gandǝ sǝn ban mǝnana à káki kam ngga ɗàng.</char> <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" /><char style="wj">Wu gūlì arǝ tǎlabanì ado mǝnana nda a ban wun ngga, ace mǝnana ɓǝ̀ wu duk amuna mala tǎlaban.&gt;&gt;</char></para>
  <para style="p" vid="JHN 12:36">Anzǝm mana Yesu naná man yì cau ka, pǝlǝa upia wia, à sǝni ɗǝm ɗàng. <verse eid="JHN 12:36" /><verse number="37" style="v" sid="JHN 12:37" />Kat andǝ agir-ndǝlǝki mǝnana lǝmdǝ bu Ɓakuli, mǝnana Yesu peǎ a ɓadǝmbia ka, à pà ɓamuria a baní ɗàng. <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />Mǝnia ka, nda ace lùmsǝ ɓangnǝa mala Ishaya mǝnana bang ama,</para>
  <para style="q1" vid="JHN 12:38">&lt;&lt;Mǝtalabangŋo,</para>
  <para style="q2" vid="JHN 12:38">yana ɓwe na earnǝ cau</para>
  <para style="q1" vid="JHN 12:38">mǝnana sǝm bang ngga,</para>
  <para style="q2" vid="JHN 12:38">sǝ a ban yan sǝ à</para>
  <para style="q1" vid="JHN 12:38">lǝmdǝ rǝcandǝa mala</para>
  <para style="q2" vid="JHN 12:38">Mǝtalabangŋo?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:1">Isha 53:1</ref></char>.</note><verse eid="JHN 12:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="JHN 12:39" />Ace mani ka à ginǝ earnǝ Yesu, acemǝnana Ishaya angŋa dǝmba bangŋǝna ama,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />&lt;&lt;Mǝtalabangŋo girkina amǝsǝia,</para>
  <para style="q2" vid="JHN 12:40">ɗǝm ngga girkina ɓabumia.</para>
  <para style="q1" vid="JHN 12:40">Gìrkia ace mǝnana amǝsǝia</para>
  <para style="q2" vid="JHN 12:40">ɓǝà kǝa sǝnban ɗang,</para>
  <para style="q1" vid="JHN 12:40">sǝ ɓabumia ɓǝ̀ kǝa kum</para>
  <para style="q2" vid="JHN 12:40">sǝlǝe ɗàng,</para>
  <para style="q1" vid="JHN 12:40">sǝ à pà nǝ̀ nyàre a banam</para>
  <para style="q2" vid="JHN 12:40">ace mǝnana ɓǝ̀n</para>
  <para style="q2" vid="JHN 12:40">sonzǝia ka raka.<note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 6:10">Isha 6:10</ref></char>.</note>&gt;&gt;<verse eid="JHN 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41" />Ishaya bang man yì cau ka, acemǝnana ak dǝmba sǝn gulo mala Yesu ɗiɗyal, sǝ bangcau amurí.<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />Kat andǝ amani ama pas atà aɓwana-mǝgule mala amǝ Yahudi, pà ɓamuria a ban Yesu ka, à bang ce a ban aɓwana bwāng ɗang, acemǝnana à kǝ ɓanggi amǝ Farisi ɓǝà kǝa pǝria aɓa ndakpapi ɗàng. <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />Yia ka à kǝ earce ɓwangsǝban mala ɓwapǝndǝa amur ɓwangsǝban mala Ɓakuli.<verse eid="JHN 12:43" /></para>
  <para style="s">Cau mala Yesu nǝ̀ ɓashi aɓwana</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />Pǝlǝa Yesu loasǝ gì kpǝm sǝ na ama:</para>
  <para style="pi" vid="JHN 12:44">
    <char style="wj">Ɓwa mǝnana kat gūlì arǝàm, mǝ nda gūlikiyi arǝàm nǝmurǝam ngga ɗàng, ndaban gūlì gbal arǝ Tárrám mǝnana tasǝam ngga.</char> <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" /><char style="wj">Ɓwa mǝnana kat sǝnam ngga sǝna Tárrám mǝnana tasǝam ngga.</char> <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" /><char style="wj">Ən yiu kǝla tǎlaban ace pa tǎlaban aɓa pǝndǝa mala ɓanza man, ace mǝnana ɓwa mana kat pà ɓamúrì a banam ngga, ɓǝ̀ kǝa ueo aɓa pǝndǝa ɗang.</char><verse eid="JHN 12:46" /></para>
  <para style="pi">
    <verse number="47" style="v" sid="JHN 12:47" />
    <char style="wj">Ɓwa mǝnana kat ok kanigir mem, sǝ kpate raka, mǝ nda mǝ nǝ ɓashi wi ka ɗàng. Pa ace ɓashi sǝ ǝn yiu a ɓanza ɗang, ǝn yiu ace amsǝ ɓanza.</char> <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" /><char style="wj">Aɓwana mǝnana kat à ginǝam sǝ à ginǝ ak cau mem ngga, à ndanǝ mǝ'ɓashi mǝnana nǝ̀ ɓashia wia ka. Acau mǝnana ǝn nea ka, à nǝ̀ mea a ɓashi a masǝlǝata apwari!</char> <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" /><char style="wj">Agir mǝnana kat ǝn nggǝ kània ka, à pà aɓa rǝcandǝa mem ɗàng, Tárrám mǝnana tàsǝàm ngga, nǝ̀ pam nzongcau arǝ mana ɓǝ̀n na sǝ lang sǝ mǝ nǝ né.</char> <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" /><char style="wj">Sǝ ǝn sǝlǝna ama anzongcau male ka à nǝ̀ kánǝ ɓwa aɓa yilǝmu mǝnana málá male pà kàm raka. Gìr mǝnana ǝn naki ka nda gìr mǝnana kat Tárrám banggàm mǝ na ka.</char><verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">Yesu lákkí akusǝ alaggana male</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />Ué bǝti à nǝ̀ tita Lamsan Yàlîmurû, sǝ Yesu sǝlǝna ama bu-pwari male yina mǝnana nǝ̀ nying ɓanza nǝ̀ o aban Tárrí ka. Yì ka, earnace aɓwana male mǝnana à nda a ɓanza man ngga, sǝ ado ka lǝmdǝia wia earcearǝu mǝnana malkiyi raka.<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />Yesu andǝ alaggana male ka à nda ban lí nǝ pwarikpǝra. Shetan angŋa dǝmba tsǝ̀ngŋǝ̀nà ɗenyicau mala mak Yesu a ɓabum Yahuda Iskariyoti muna mala Shiman.<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 6:71">Yoh 6:71</ref>; <ref loc="MRK 14:10">Mar 14:10</ref></char>.</note> <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />Yesu sǝlǝna ama Ɓakuli Tárrú pani wi rǝcandǝa amur agir kat, sǝ sǝlǝna gbal ama pur nǝban Ɓakuli, sǝ ndo nǝ̀ nyare nǝ̀ o a baní ka. <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />Ace mani ka loapi múr girlina, swár nggea-daura male, sǝ kùr nggubyau esǝki rǝǔ a taɓuni. <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />Pǝlǝa solǝ mùr a nkenye, sǝ tita lákkí akusǝ alaggana male sǝ kǝ esǝkia nǝ nggubyau esǝki rǝǔ mǝnana a taɓuni ka.<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 7:44">Luk 7:44</ref>; <ref loc="LUK 22:27">22:27</ref></char>.</note> <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />Lang Yesu yiu a ban Shiman Bitǝrus ka, Bitǝrus ɗì ama, &lt;&lt;Mǝtalabangŋo, a nda a nǝ lákkàm akusǝam ngga le?&gt;&gt;<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />Pǝlǝa Yesu eari wi ama, <char style="wj">&lt;&lt;A pà nǝ súrǝ̀ gir mǝnana ado ǝn pakkiyi ka ɗang, sǝ nǝnzǝ́mò ka a nǝ nggá sǝlǝa.&gt;&gt;</char><verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />Shiman Bitǝrus banggi wi ama, &lt;&lt;Awo, a pà nǝ lákkàm akusǝam ɗang!&gt;&gt;</para>
  <para style="p" vid="JHN 13:8">Sǝ Yesu ne wi ma, <char style="wj">&lt;&lt;Ɓǝn lákkò akusǝo raka, a pà nǝ duk mǝkpatam ɗǝm ɗàng.&gt;&gt;</char><verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />Sǝ Shiman Bitǝrus pè wi eare ama, &lt;&lt;Mǝtalabangŋo, akusǝam nda nǝmurǝia a nǝ lak ka ɗàng, lákkàm abuam andǝ ɓamuram gbal!&gt;&gt;<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />Pǝlǝa Yesu na ama, <char style="wj">&lt;&lt;Ɓwa mǝnana sussǝna ka, akusǝi na à nǝ̀ bangce lea ka. Sǝ wu fànà kat, kǝ ɓwa mwashat nda ueo atà wun ngga.&gt;&gt;</char> <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />Yesu ka angŋa dǝmba súrǝ́nà rǝ ɓwa mǝnana nǝ̀ nggá me ka. Nda gìr mǝnana tsǝa sǝ bang ama, <char style="wj">&lt;&lt;Wun kat sǝ wu fà ɗàng.&gt;&gt;</char><verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />Anzǝm mǝnana langŋǝnia wia akusǝia ka, pǝlǝa nyesǝ daura male oasǝi arǝì, sǝ nyare kya do a ban-do male. Pǝlǝa nea wia ama:</para>
  <para style="pi" vid="JHN 13:12">
    <char style="wj">Wu súrǝ̀ gir mǝno ado ǝn pakka wun ngga le?</char> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" /><char style="wj">Wu kǝ tunǝam ama Malǝm, sǝ Mǝtalabangŋo. Sǝ wu ɓwarki ɗang, anggo sǝ ǝn pa.</char> <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" /><char style="wj">Sǝ mǝnana mim Mǝtala wun andǝ Mǝkania wun gìr, ǝn lákkà wun akusǝ wun ngga, wun gbal ka dumǝna amur wun, wun nǝ̀ lákkià rǝ wun akusǝu.</char> <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" /><char style="wj">Ado ka, gìr mǝnana ǝn pê ka, kusǝu na ǝn tsǝka wun ngga, ace mǝnana ɓǝ̀ wu kǝ pakkia rǝ wun anggo ka.</char><note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1PE 2:21">1Bit 2:21</ref></char>.</note> <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" /><char style="wj">Mǝ nda ban bangga wun mǝsǝcau, kǝ guro pà kàm gulo kútì mǝtala-ɓala male ɗàng, sǝ kǝ mǝturonjar pà kàm nǝ́ gulo kútì ɓwa mǝnana túrí ka ɗàng.</char> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" /><char style="wj">Mǝno ado wu sùrǝ́nà rǝ mǝnia yì mǝsǝcau ka, ɓǝ̀ wu tsǝì aɓa túró ka Ɓakuli nǝ̀ tsǝka wun buì!</char><note caller="+" style="f"><char style="fr" closed="false">13:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 11:28">Luk 11:28</ref>; <ref loc="JAS 1:25">Jem 1:25</ref></char>.</note><verse eid="JHN 13:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="JHN 13:18" />
    <char style="wj">Ən pa aban nacau amur wun kat ɗàng, acemǝnana ǝn súrǝ́nà rǝ aɓwana mǝnana ǝn tarkia ka. Sǝ cau mǝnana Malǝmce mala Ɓakuli bang ama, &lt;&lt;Kǝ yì, yì ɓwa mǝnana oasǝ buì atàm a kwar ka nda pǝlǝ arǝàm ngga,&gt;&gt; dumǝna púp nǝ̀ lùmsǝo.</char> <note caller="+" style="f"><char style="fr" closed="false">13:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 41:9">Ang 41:9</ref></char>.</note><verse eid="JHN 13:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="JHN 13:19" />
    <char style="wj">Mǝ nda aban na wun man yì cau ka ado sǝ ɓǝ̀ yi lumsǝo, ace mǝnana ɓǝ̀ yi lumsǝna ka, wun nǝ̀ earnǝ mim ama &lt;&lt;Mǝ Nda kǝ ɓwe mǝnana ǝn na nǝma Mǝ nda ka.&gt;&gt;</char> <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" /><char style="wj">Sǝ mǝ nda ban bangga wun mǝsǝcau: ɓwa mana kat ak ɓwa mǝnana ǝn túrí ka, mǝ nda akiyiam gbal ka, sǝ ɓwa mana kat em ngga, nda rǝ ak Tárrám mǝnana tasǝam ngga.</char><note caller="+" style="f"><char style="fr" closed="false">13:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref></char>.</note><verse eid="JHN 13:20" /></para>
  <para style="s">Yesu sǝlǝna ama Yahuda nǝ̀ ngga me</para>
  <para style="r">(<ref loc="MAT 26:20-25">Matiu 26:20-25</ref>; <ref loc="MRK 14:17-21">Markus 14:17-21</ref>; <ref loc="LUK 22:21-23">Luka 22:21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />Anzǝm mana Yesu bangŋǝna man yì cau ka, bumkiɗikea ɓākì kǝ̀rkǝ́r aɓa bangŋo, sǝ ne bwāng ama, <char style="wj">&lt;&lt;Mǝ nda ban bangga wun mǝsǝcau, ɓeɓwa nda aɓalǝ wun nǝ̀ nggá mem.&gt;&gt;</char><verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />Kara alaggana male sǝngi rǝarǝia, à kǝ ndali ko yana ateà nakiyi cau amurí. <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />Ɓè lagga mǝnana Yesu earkiyi ace raka nda a ban-do a nkanggari Yesu. <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />Pǝlǝa Shiman Bitǝrus lǝmdǝì cau nǝ bui ama ɓǝ̀ ɗì Yesu, ɓǝ̀ na ɓwa mǝnana nakiyi cau amurí ka.<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />Pǝlǝa lagga mǝno pǝlǝ rǝi aban Yesu sǝ ɗì ama, &lt;&lt;Mǝtalabangŋo, yana ɓwe atà sǝm a nakiyi cau amurí le?&gt;&gt;<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />Yesu pa eare ama, <char style="wj">&lt;&lt;Nda ɓwa mǝnana ado mǝ nǝ oasǝ nɗǝmo a mbú mǝ nǝ pè wi ka.&gt;&gt;</char> Pǝlǝa Yesu ɓwan nɗǝmo, ɗàrǝ́ mbú, sǝ pè Yahuda muna mala Shiman Iskariyoti. <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />Lang Yahuda ak nɗǝmo she ka, kara Shetan kutia rǝì. Sǝ Yesu ne wi ama, <char style="wj">&lt;&lt;Lo tsuk-tsuk, kya pak gìr mǝnana a nǝ pak ka.&gt;&gt;</char> <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />Sǝ kǝɓwa pà kàm ateà a ban-li mǝnana súrǝ̀ gir mǝnana tsǝa sǝ Yesu ne wi man yì cau ka ɗàng. <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />Sǝ acemǝnana Yahuda nda mǝbwal boalo malea ka, aɓea laggana kǝ sǝni kǝla Yesu nda ban ne wi ɓǝ̀ kyane ɓǝ̀ kya kúr gìr mǝnana à nǝ̀ pàngŋǝ̀nà túró nǝi ace Lamsan ngga. Ko a na raka, ɓǝ̀ kya pê amǝ'tǝ̀r aɓa boalo mǝnana a buì ka. <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />Anzǝm mana Yahuda shekina nɗǝmo ka, pǝlǝa lo tù puro. Sǝ du pǝndǝna.<verse eid="JHN 13:30" /></para>
  <para style="s">Bǝsa nzongcau</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />Anzǝm mana Yahuda nyìngŋǝ̀nà banì ka, Yesu na ama:</para>
  <para style="pi" vid="JHN 13:31">
    <char style="wj">Ado ka pwari kārǝ́na mǝnana Muna mala Ɓwa nǝ̀ kutio aɓa gulo male ka, sǝ Ɓakuli ka, nǝ̀ kum gulo atà kusǝì.</char> <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" /><char style="wj">Sǝ acemǝnana Ɓakuli nǝ̀ kum gulo atà kusǝ Muni ka, banì pà nǝ̀ sau ɗang, Ɓakuli nǝ̀ pè Muni gulo.</char><verse eid="JHN 13:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="JHN 13:33" />
    <char style="wj">Wun amunem, mǝ nda mǝ nǝ do atà wun zuku. Wun nǝ̀ altam, sǝ kǝla mǝnana ǝn banggi aɓwana-mǝgule mala amǝ Yahudi ka, ban mǝnana ǝn kákiyi kam ngga, pà wu nǝ̀ gandǝ ká kàm ɗàng.</char><verse eid="JHN 13:33" /></para>
  <para style="pi">
    <verse number="34" style="v" sid="JHN 13:34" />
    <char style="wj">Sǝ ace mǝno ka mǝ ndarǝ pa wun bǝsa nzongcau: Wu earce rǝarǝ wun. Kǝla mǝnana ǝn earce wun ngga, anggo sǝ wun nǝ̀ dum nǝ earcea rǝ wun.</char> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" /><char style="wj">Ɓǝ̀ wu ndanǝ earcea rǝ wun ngga, aɓwana kat nǝ̀ sǝlǝ ama wu nda ka amǝkpatam.</char><verse eid="JHN 13:35" /></para>
  <para style="s">Yesu sǝlǝna ama Bitǝrus nǝ̀ makgìr súrǝè</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matiu 26:31-35</ref>; <ref loc="MRK 14:27-31">Markus 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />Shiman Bitǝrus ɗì Yesu ama, &lt;&lt;Mǝtalabangŋo, a nǝ ká a ke le?&gt;&gt;</para>
  <para style="p" vid="JHN 13:36">Yesu eari wi ama, <char style="wj">&lt;&lt;Ado ka a pà nǝ gandǝ ká atàm aban mǝnana mǝ nǝ ká kàm ngga ɗàng, sǝ nǝnzǝ́mò ka a nǝ gandǝ yiu atàm.&gt;&gt;</char><verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />Pǝlǝa Bitǝrus ɗì ama, &lt;&lt;Mǝtalabangŋo, ace mana sǝ pà mǝ nǝ gandǝ ká atò ado ɗàng? Ən earǝna mǝ nǝ wu aceo.&gt;&gt;<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />Yesu ear ama, <char style="wj">&lt;&lt;A na ama a nǝ pà yilǝmio, a nǝ wu acem ɓafo? Mǝ nda ban banggo mǝsǝcau, kaniama nggǔ nǝ̀ ɓua ka, a nǝ makgirem kusǝ tàrú ama a súrǝàm ɗàng.&gt;&gt;</char><verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">Yesu nda njargula ká aban Ɓakuli</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />
    <char style="wj">&lt;&lt;Ɓabum wun ɓǝ̀ kǝa kiɗiki ɗàng. Wu pà ɓamur wun aban Ɓakuli, sǝ wu pà ɓamur wun gbal abanam.</char> <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" /><char style="wj">Aɓa ɓala mala Tárrám ngga aban-do nda kam pas. Ɓǝ̀ pa anggo raka ɓǝn bangŋǝna wun. Mǝ ká mǝ nǝ nggá gilǝki ban-do ace wun.</char> <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" /><char style="wj">Sǝ ɓǝ̀ ǝn warina ǝn gilǝkina wun ban-do ka, mǝ nǝ nyare mǝ nǝ yia kúllí wun, ace mǝnana ban mana mǝ nda kam ngga, abanì sǝ wun nǝ̀ pǎ.</char> <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" /><char style="wj">Wu sùrǝ́nà rǝ njargula ká a ban mǝnana mǝ nǝ ká kàm ngga.&gt;&gt;</char><verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />Toma ne wi ama, &lt;&lt;Mǝtalabangŋo, sǝm súrǝ̀ ban mǝnana a nǝ ká kàm ngga ɗàng, sǝ lang sǝ sǝm nǝ̀ súrǝ̀ njar ká a banì le?&gt;&gt;<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />Yesu eari wi ama, <char style="wj">&lt;&lt;Mǝ nda njargula, Mǝ nda mǝsǝcau, sǝ Mǝ nda yilǝmu; kǝɓwa pà nǝ̀ ká aban Ɓakuli Tárrú ɗang she nǝ banam.</char> <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" /><char style="wj">Ɓǝ̀ wu sùrǝ́nà rǝàm ngga, wu sùrǝ́nà rǝ Tárrám. Sǝ twal ado aban ká a dǝmba ka wu sùrǝ́nà rǝì, sǝ wu sǝnǝ nǝi.&gt;&gt;</char><verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />Pǝlǝa Filip ne wi ama, &lt;&lt;Mǝtalabangŋo, lǝmdǝa sǝm yì Tárrú; mani ka kārǝ́na sǝm.&gt;&gt;<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />Yesu ne wi ama:</para>
  <para style="pi" vid="JHN 14:9">
    <char style="wj">Filip, ǝn sauwuna nǝ do atà wun, sǝ bà ado ka a malaká súrǝàm ɗàng? Ɓwa mǝnana sǝnǝnam ngga sǝnǝna Tárrám. Sǝ palang sǝ a kǝ na ama mǝ lǝmdǝa wun rǝì?</char> <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" /><char style="wj">A ear mbo ama mǝ nda aɓa Tárrám, sǝ Tárrám ngga nda a ɓalǝam? Acau mǝnana ǝn nggǝ na wun ngga à pur nǝ banam ɗàng, Tárrám mǝnana dukiyi a ɓalǝam ngga nǝ̀ pakkiyi túró male nǝ mim.</char> <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" /><char style="wj">Wu earnǝ mim ama mǝ nda aɓa Tárrám, sǝ Tárrám ngga nda a ɓalǝam. Sǝ ɓǝ̀ ana raka, wu earnǝ mim ace atúró mǝnana wu sǝnam ǝn nggǝ pea ka.</char> <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" /><char style="wj">Mǝ nda ban bangga wun mǝsǝcau, ɓwa mǝnana pà ɓamúrì a banam ngga, nǝ̀ pàk agir-ndali kǝla amǝnana ǝn pea ka. Yàle nǝ̀ pàkki agir mǝgulke mǝnana à kútì amǝnana ǝn pea ka, acemǝnana mǝ ndo mǝ nǝ o aban Tárrám.</char> <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" /><char style="wj">Sǝ mǝ nǝ pàk gìr mǝnana kat wu zǝmba aɓa lullǝam ngga, acemǝnana Muna ka ɓǝ̀ yinǝì Tárrí gulo.</char><note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 7:7">Mat 7:7</ref>; <ref loc="JHN 15:7">Yoh 15:7</ref>,<ref loc="JHN 15:16">16</ref>; <ref loc="JHN 16:23">16:23</ref>; <ref loc="JAS 1:5">Jem 1:5</ref></char>.</note> <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" /><char style="wj">Wu zǝm gir mǝnana kat wu earkiyi ce ka aɓa lullǝam, mǝ nǝ pè.</char><verse eid="JHN 14:14" /></para>
  <para style="s">Yesu pàcau mala Bangŋo Mǝfele</para>
  <para style="pi">
    <verse number="15" style="v" sid="JHN 14:15" />
    <char style="wj">Ɓǝ̀ wu kǝ earcem ngga, wun nǝ̀ kpata anzongcau mem.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:15 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 15:10">Yoh 15:10</ref>; <ref loc="1JN 5:3">1Yoh 5:3</ref>; <ref loc="2JN 1:6">2Yoh 6</ref></char>.</note> <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" /><char style="wj">Sǝ mǝ nǝ zǝmbi Tárrám, sǝ nǝ̀ pa wun Mǝbwala wun nggam, mǝnana nǝ̀ yia do atà wun bà málá male ka.</char> <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" /><char style="wj">Yì nda kǝ Bangŋo mana kǝ lǝmdǝ mǝsǝcau amur Ɓakuli ka. Amǝ'kpata ɓanza pa nǝ̀ gandǝ é ɗàng, acemǝnana à kǝ sǝni ɗàng, sǝ à súrǝì ɗàng. Sǝ wun ngga wu súrǝì, acemǝnana ndanǝ do atà wun ado, sǝ nǝnzǝ́mò ka nǝ̀ nggá do a ɓabum wun.</char><verse eid="JHN 14:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="JHN 14:18" />
    <char style="wj">Ɓǝ̀ ǝn umna ka, pà mǝ nǝ nying wun kǝla akáwá ɗang, mǝ nǝ yiu a ban wun.</char> <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" /><char style="wj">Banì pà nǝ̀ sau ɗang, ɓanza pà nǝ̀ sǝnam ɗǝm ɗàng, sǝ wun ngga wun nǝ̀ sǝnam. Sǝ acemǝnana mǝ ndanǝ yilǝmu ka, wun gbal ka wun nǝ̀ dum nǝ yilǝmu.</char> <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" /><char style="wj">Ɓǝ̀ pwarî mǝno yina ka, wun nǝ̀ sǝlǝ ama mǝ nda aɓa Tárrám, sǝ wun ngga wu nda a ɓalǝam, sǝ mǝ nda aɓalǝ wun.</char> <verse eid="JHN 14:20" /><verse number="21" style="v" sid="JHN 14:21" /><char style="wj">Ɓwa mǝnana kat ak anzongcau mem sǝ kǝ kpatea ka, nda ɓwa mǝnana kǝ earcem ngga. Sǝ ɓwa mǝnana kǝ earcem ngga, Tárrám nǝ̀ earce ɓwe, sǝ mim gbal ka mǝ nǝ earce, mǝ nǝ lǝmdǝ ɓamúràm a baní.</char><verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />Pǝlǝa Yahuda (mǝnana nda Yahuda Iskariyoti raka) banggi wi ama, &lt;&lt;Mǝtalabangŋo, mana tsǝa sǝ a nǝ lǝmdǝ ɓamuro a ban sǝm, sǝ a pà nǝ lǝmdǝì ɓanza kat ɓamuro ɗàng?&gt;&gt;<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />Yesu eari wi ama:</para>
  <para style="pi" vid="JHN 14:23">
    <char style="wj">Ɓwa mǝnana kat earcem ngga, nǝ̀ kpata kanigir mem, Tárrám nǝ̀ earce, sǝ mim sǝnǝ Tárrám ngga, sǝm nǝ̀ yiu a baní sǝm nǝ̀ do atè.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:23 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1JN 2:24">1Yoh 2:24</ref>; <ref loc="REV 21:3">Sǝn 21:3</ref></char>.</note> <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" /><char style="wj">Ɓwa mǝnana kǝ earcem raka, pà nǝ̀ kpata kanigir mem ɗàng. Sǝ acau mǝnia wu kǝ oea ka, à mem na ɗang, à pur nǝ ban Tárrám mǝnana tasǝam ngga.</char><verse eid="JHN 14:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="JHN 14:25" />
    <char style="wj">Amǝnia yì acau ka, ǝn nggǝ bangga wunia acemǝnana mǝ nda aban wun ado.</char> <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" /><char style="wj">Sǝ Mǝ'pa wun gbasha, yì Bangŋo Mǝfele, mǝnana Tárrám nǝ̀ tasǝi aɓa lullǝam ngga, nǝ̀ yia kania wun agirbunda kat, sǝ nǝ̀ kasǝɓalǝ wun arǝ agir mǝnana kat, ǝn bangga wun ngga.</char><verse eid="JHN 14:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="JHN 14:27" />
    <char style="wj">Mǝ ndya ǝn nggǝ nying wun nǝ dorǝpwala ka. Sǝ mǝnia yì dorǝpwala ǝn pākiyi ka, ɓanza pànǝi nǝ̀ pà ɗàng. Acemani ka, ɓabum wun ɓǝ̀ kǝa kiɗiki ɗàng, sǝ ɓangciu ɓǝ̀ kǝa pàkka wun ɗàng.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 16:33">Yoh 16:33</ref>; <ref loc="PHP 4:7">Filp 4:7</ref>; <ref loc="COL 3:15">Kol 3:15</ref>; <ref loc="JHN 20:19">Yoh 20:19</ref></char>.</note><verse eid="JHN 14:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="JHN 14:28" />
    <char style="wj">Wu ɗenyinǝ cau mǝnana ǝn bangga wun ama, mǝ nǝ o, sǝ mǝ nggá nyar aban wun ɗǝm ngga. Ɓǝ̀ mǝsǝcau wu earǝnacem ngga, ban nǝ̀ ɓoara wun ace o mem aban Tárrám, mǝnana kútiǎm nǝ gulo ka.</char><verse eid="JHN 14:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="JHN 14:29" />
    <char style="wj">Ən nanà wun ce amǝnia yì agir ka ado sǝ ɓǝà yì lumsǝo, ace mǝnana ɓǝà yì lumsǝna ka, wun nǝ̀ ear ama cau mem ngga mǝsǝcau na.</char> <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" /><char style="wj">Pà mǝ nǝ samsǝ ban cau mǝnana mǝ nǝ na wun ngga ɗǝm ɗàng, acemǝnana murǝm mala ɓanza man ndya kǝ yiu ka, sǝ pànǝ rǝcandǝa amuram ɗàng.</char> <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" /><char style="wj">Mǝ nǝ pak gìr mǝnana Tárrám banggàm ɓǝ̀ ǝn pak ka, ace mǝnana koyan a ɓanza ka ɓǝ̀ sǝlǝ ama ǝn nggǝ earce Tárrám.</char></para>
  <para style="pi" vid="JHN 14:31">
    <char style="wj">Wu lo, ɓǝ̀ sǝm o.</char><verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">Yesu nda nggun anap mǝ'mǝsǝcaunì</para>
  <para style="pi">
    <verse number="1" style="v" sid="JHN 15:1" />
    <char style="wj">Mǝ nda nggun anap mǝ'mǝsǝcaunì, sǝ Tárrám nda mǝtsǝkkir ɓaban.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 5:1-7">Isha 5:1-7</ref>; <ref loc="EZK 19:10">Ezǝk 19:10</ref>; <ref loc="MRK 12:1-9">Mar 12:1-9</ref>; <ref loc="MAT 15:13">Mat 15:13</ref>; <ref loc="ROM 11:17">Rom 11:17</ref></char>.</note> <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" /><char style="wj">Ko ya bu-nggun a ɓalǝam mǝnana kǝ pa ɓǝle raka, kǝ kasǝi kǝ túrí a nzali, sǝ abu-nggun mǝnana à kǝ pa ɓǝlea ka, kǝ gilǝkicea ace mǝnana ɓǝà ɓoaro ɓǝà pa ɓǝlea kpǝm ngga.</char> <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" /><char style="wj">Cau mǝnana ǝn kania wun ngga gilǝkina wun, wu fànà.</char><verse eid="JHN 15:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="JHN 15:4" />
    <char style="wj">Wu do a ɓalǝam sǝ mim ngga mǝ nǝ do aɓalǝ wun. Kǝla mǝnana bu-nggun anap pà nǝ̀ gandǝ pa ɓǝle nǝmurǝì raka, she ɓǝ̀ dumǝna aɓa nggea ngguni ka, anggo gbal sǝ wun ngga pà wù nǝ̀ gandǝ pa ɓǝla wun ɗang, she ɓǝ̀ wu dumǝna a ɓalǝam ngga.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:4 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 6:56">Yoh 6:56</ref>; <ref loc="1JN 2:6">1Yoh 2:6</ref></char>.</note><verse eid="JHN 15:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="JHN 15:5" />
    <char style="wj">Mǝ nda nggun-anap, sǝ wu nda ka bu-nggun. Ɓǝ̀ ɓwa do a ɓalǝam, sǝ ǝn do a ɓālǝi ka, nǝ̀ pusǝ ɓǝle kpǝm. Ɓǝ̀ nǝ́ mim raka pà wù nǝ̀ gandǝ pak ɓè kǝgìr ɗàng.</char> <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" /><char style="wj">Ɓǝ̀ koya ɓwa na sǝ do a ɓalǝam raka, nda kǝla bu-nggun mǝnana à túrí sǝ im ngga; a'ulang abu-nggun mǝno ka aɓwana kǝ ramgia, à nǝ̀ soea aɓa bǝsa à nǝ̀ pisǝia.</char><verse eid="JHN 15:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="JHN 15:7" />
    <char style="wj">Sǝ ɓǝ̀ wu do a ɓalǝam, sǝ cau mem do aɓalǝ wun ngga, wu zǝmbi Ɓakuli gir mǝnana kat wu earkiyice ka, sǝ nǝ̀ pa wun girnî.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:7 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 14:13">Yoh 14:13</ref>; <ref loc="JHN 16:23">16:23</ref>; <ref loc="MAT 7:7">Mat 7:7</ref>; <ref loc="JAS 1:5">Jem 1:5</ref></char>.</note> <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" /><char style="wj">Ɓǝ̀ wu pusǝ aɓǝla wun kpǝm ngga, nda lǝmdǝ ama wu nda ka laggana mem ngga. Sǝ mǝno gbal ka nda nǝ̀ yinǝì Tárrám nǝ́ gulo ka.</char><verse eid="JHN 15:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="JHN 15:9" />
    <char style="wj">Kǝla mǝnana Tárrám kǝ earcem ngga, anggo sǝ ǝn nggǝ earce wun. Wu do aɓa earcearǝu mem.</char> <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" /><char style="wj">Ɓǝ̀ wu kpata anzongcau mem ngga, wun nǝ̀ do aɓa earcearǝu mem, kǝla mǝnana ǝn kpata anzongcau mala Tárrám sǝ ǝn do aɓa earcearǝu male ka.</char><verse eid="JHN 15:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="JHN 15:11" />
    <char style="wj">Ən bangga wun agir mǝnia ka, ace mǝnana ɓǝ̀ bumpwasǝa mem do aɓalǝ wun, sǝ ɗǝm ngga, ɓǝ̀ bumpwasǝa ma'wun ɓǝ̀ lùmsǝo.</char> <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" /><char style="wj">Mǝnia ka nda nzongcau mem: Wu earce rǝarǝ wun kǝla mǝnana ǝn earce wun ngga.</char><note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 13:34">Yoh 13:34</ref></char>.</note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" /><char style="wj">Earcearǝu mǝgule mǝnana kat ɓwa nǝ̀ lǝmdǝì agyajam male ka, nda mǝnana ɓǝ̀ pà yilǝmi acea ka.</char><note caller="+" style="f"><char style="fr" closed="false">15:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 5:7">Rom 5:7</ref>; <ref loc="JHN 10:11">Yoh 10:11</ref></char>.</note> <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" /><char style="wj">Ɓǝ̀ wu kǝ pak gìr mǝnana ǝn bangga wun nǝma wu pak ka, wu nda ka gyajam mem.</char><note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:4">Luk 12:4</ref></char>.</note> <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" /><char style="wj">Pa mǝ nǝ tunǝ wun ɗǝm ama aguro ɗàng, acemǝnana guro ka súrǝ̀ gir mǝnana mǝtala-ɓala male kǝ pak ka ɗàng. Ado ka, wu nda ka gyajam mem, acemǝnana ǝn nanà wun gìr mana kat ǝn ok a kún Tárrám ka.</char><verse eid="JHN 15:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="JHN 15:16" />
    <char style="wj">Wun nǝ̀ tàram ɗang, mǝ nda mǝnana ǝn târ wun, sǝ ǝn pa wun túró nǝma wu kya pâ ɓǝla wun, ulang ɓǝle mǝnana pà nǝ̀ kiɗiki raka. Anggo ka sǝ Tárrám nǝ̀ pa wun gìr mǝnana kat wu zǝmbi wi aɓa lullǝam ngga.</char> <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" /><char style="wj">Mǝnia ka nda nzongcau mǝnana ǝn pa wun ngga: Wu earce rǝarǝ wun.</char><verse eid="JHN 15:17" /></para>
  <para style="s">Ɓinǝmǝsǝu mala ɓanza arǝ <optbreak /> amǝkpata Yesu</para>
  <para style="pi">
    <verse number="18" style="v" sid="JHN 15:18" />
    <char style="wj">Ɓǝ̀ ɓanza ɓinǝmǝsǝ wun ngga, wu sǝlǝ ama, ɓinǝna mǝsǝam gbal a dǝmba.</char> <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" /><char style="wj">Ɓǝ̀ wu nda ka mala ɓanza ka, ɓanza nǝ̀ earce wun kǝla amale. Sǝ ado ka wu nda ka mala ɓanza ɗàng. Acemǝnana ǝn tarki wun ɓǝ̀ wu purî ɓá ɓanza ka, nda tsǝa sǝ ɓanza kǝ ɓinǝmǝsǝ wun ngga.</char> <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" /><char style="wj">Wu ɗenyinǝ cau mǝnana ǝn bangga wun nǝma, &lt;&lt;Kǝ guro pà kàm gulo kútì mǝtala-ɓala male ɗàng.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:24">Mat 10:24</ref>; <ref loc="LUK 6:40">Luk 6:40</ref>; <ref loc="JHN 13:16">Yoh 13:16</ref>; <ref loc="1CO 4:12">1Kor 4:12</ref>; <ref loc="ACT 4:17">Atúró 4:17</ref>; <ref loc="1PE 4:14">1Bit 4:14</ref>; <ref loc="REV 2:3">Sǝn 2:3</ref></char>.</note> <char style="wj">Ɓǝà pàm tanni ka, à nǝ̀ pà wun tanni gbal. Sǝ ɓǝ̀ pǝlǝa ama à kpanatà kanigir mem ngga, à nǝ̀ kpata kanigir ma'wun gbal.</char><verse eid="JHN 15:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="JHN 15:21" />
    <char style="wj">À nǝ̀ pakka wun amǝnia yì agir kat ka atàcau mem, acemǝnana à súrǝ̀ Tárrám mǝnana tasǝam ngga ɗàng.</char> <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" /><char style="wj">Ɓǝ̀ ǝn yiu ma ǝn yi namia cau raka, ɓǝ́ cauɓikea pa a ɓamuria ɗàng. Sǝ ado ka à pànǝ kun nacau ace acauɓikea malea ɗàng.</char><verse eid="JHN 15:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="JHN 15:23" />
    <char style="wj">Ɓwa mǝnana kat ɓinǝ mǝsǝam ngga, ɓinǝna mǝsǝ Tárrám gbal.</char> <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" /><char style="wj">Ɓǝ̀ ǝn pakki ma agir mǝnana kǝɓwa malaká pea aɓalǝia raka, ɓǝ́ à pà nǝ̀ kumia nǝ cauɓikea ɗang. Sǝ ado ka à sǝnǝna amǝnia yì agir-ndali ǝn pea ka, sǝ kat andǝ mǝno ka, à ɓinǝ mǝsǝam sǝnǝ Tárrám.</char> <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" /><char style="wj">Mǝnia ka nda yi lùmsǝ gir mǝnana à gilǝì aɓa Malǝmce mala Ɓakuli ama: &lt;&lt;À ɓinǝ mǝsǝam ɓà, tǝri pà kàm ɗàng.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 35:19">Ang 35:19</ref>; <ref loc="PSA 69:4">69:4</ref></char>.</note><verse eid="JHN 15:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="JHN 15:26" />
    <char style="wj">Nǝ nzǝ́mò ka mǝ nǝ tasǝa wun Mǝbwali aɓwana, yì Bangŋo mala mǝsǝcau mǝnana nǝ̀ pur nǝban Tár sǝm aban yiu a ban wun ngga, nǝ̀ yia bang kúni kat amuram.</char> <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" /><char style="wj">Sǝ wun gbal ka, dumǝna ama wun nǝ̀ nakunam a ban aɓwana, acemǝnana tita túró mem ngga sǝm nda a tarǝ sǝm sǝnǝa wun.</char><verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="pi">
    <verse number="1" style="v" sid="JHN 16:1" />
    <char style="wj">Ən na wun amǝnia yì acau ka, ace mǝnana wu kǝa vwaki bu wun arǝ paɓamuru ma'wun a banam ɗàng.</char> <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" /><char style="wj">À nǝ̀ pǝr wun arǝ yiu aɓalǝ andakpapi, sǝ pwari na kǝ yiu ka, mana ɓwa mǝnana wal-lú wun ngga nǝ̀ twali ama nda ban pakki Ɓakuli túró.</char><note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 9:22">Yoh 9:22</ref>; <ref loc="ACT 26:9-11">Atúró 26:9-11</ref>; <ref loc="ISA 66:5">Isha 66:5</ref></char>.</note> <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" /><char style="wj">À nǝ̀ pakka wun amǝnia yì agir ka acemǝnana à malaká súrǝ̀ Tárrám ɗàng, sǝ à malaká surǝam gbal ɗàng.</char> <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" /><char style="wj">Mǝ nda arǝ bangga wun agir mǝnia ka ado, ace mǝnana ɓǝ̀ pwari nì yi kārǝ́na, sǝ à tinata pa wun tanni ka, ɓǝ̀ ɓalǝ wun kasǝa ama ǝn nunna kir wun. Ən bangga wun agir mǝnia ka atadǝmbe ɗàng, acemǝnana banem nǝ̀ sauwa atà wun.</char><verse eid="JHN 16:4" /></para>
  <para style="s">Túró mala Bangŋo mala Ɓakuli</para>
  <para style="pi">
    <verse number="5" style="v" sid="JHN 16:5" />
    <char style="wj">Ado ka, mǝ ndo mǝ nǝ nyare a ban Tárrám mǝnana tasǝam ngga, sǝ kǝɓwa aɓalǝ wun ɗiem ban mǝnana mǝ nǝ ká kam ngga ɗàng.</char> <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" /><char style="wj">Sǝ acemǝnana ǝn bangga wun ngga, kara wu lùmsǝ nǝ bumkiɗikea.</char> <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" /><char style="wj">Sǝ aɓa mǝsǝcau ka, o mem ngga nda ace ɓoaro ma'wun. Ɓǝn o raka, Ɓwa mǝnana nǝ̀ kwarkir wun, yì Bangŋo mala Ɓakuli ka, pà nǝ̀ yiu ɗang. Sǝ ɓǝn o ka, mǝ nǝ nggá tasǝi ɓǝ̀ yiu a ban wun.</char><verse eid="JHN 16:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="JHN 16:8" />
    <char style="wj">Sǝ ɓǝ̀ yina ka, nǝ̀ yia pusǝta aɓwana a ɓanza, nǝ̀ lǝmdǝia wia ɓwarkio mala ɗenyicau malea amur cauɓikea, andǝ gir mana nda a njarì, sǝ amur ɓashi mala Ɓakuli mana kǝ yiu ka.</char> <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" /><char style="wj">Nǝ̀ lǝmdǝì aɓwana ama cauɓikea malea ka, nda mǝnana ama à ginǝ pa ɓamuria a banam ngga.</char> <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" /><char style="wj">Nǝ̀ lǝmdǝìa wia ɓwarkio malea amur gir mǝnana nda pepè a njarì ka, acemǝnana mǝ ndo mǝ nǝ nyare mǝ nǝ o a ban Tárrám, sǝ pà wu nǝ̀ sǝnam ɗǝm ɗàng.</char> <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" /><char style="wj">Ɗǝm ngga nǝ̀ lǝmdǝì aɓwana ama ɓashi na amúrià acemǝnana Ɓakuli angŋa dǝmba kasǝna ɓashi amur Shetan, yì murǝm mala Ɓanza mǝnia ka.</char><verse eid="JHN 16:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="JHN 16:12" />
    <char style="wj">Mǝ ndanǝ agir kam pas mǝnana ǝn earce na wun ngga, sǝ pà wu nǝ̀ gandǝ ea ado ɗàng.</char> <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" /><char style="wj">Sǝ ɓǝ̀ Bangŋo, mǝnana kǝ lǝmdǝ mǝsǝcau amur Ɓakuli, yina ka, nǝ̀ yia kania wun ɓǝ̀ wu súrǝ̀ mǝsǝcau mǝnana kat kǝ pur a ban Ɓakuli ka. Pà nǝ̀ ɓun cau a ɓamúrì ɗàng, kǝgìr mǝnana ok a kun Ɓakuli ka, kǝ nda nǝ̀ bang ngga. Sǝ nǝ̀ bangga wun ce agir mǝnana à malaká yiu peatu raka.</char> <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" /><char style="wj">Yì ka, nǝ̀ yinǝàm nǝ gulo, acemǝnana nǝ̀ twal cau mana ǝn ne ka sǝ nǝ̀ mǝngia wun ɓālǝi.</char> <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" /><char style="wj">Agir mǝnana kat mala Tárrám na ka amem na. Nda gìr mana tsǝa sǝ ǝn na wun nǝma, Bangŋo ni nǝ̀ twal cau mǝnana mem na ka sǝ nǝ̀ mǝngia wun ɓālǝi.</char><verse eid="JHN 16:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="JHN 16:16" />
    <char style="wj">Zuku ka pà wu nǝ̀ sǝnam ɗǝm ɗàng. Sǝ zuku anzǝmi ka wun nǝ̀ sǝnam ɗǝm.</char><verse eid="JHN 16:16" /></para>
  <para style="s">Bumkiɗikea mala alaggana male <optbreak /> nǝ̀ pǝlǝ bumpwasǝa</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />Aɓea alaggana male ɗiki rǝarǝia ama, &lt;&lt;Mana nda ɓacau male mǝnana ama, &lt;Zuku ka pà wu nǝ̀ sǝnam ɗang, sǝ zuku anzǝmi ka wu nǝ̀ sǝnam.&gt; Sǝ ɗǝm ngga ama, &lt;Mǝ ndo mǝ nǝ o a ban Tárrám&gt; ka? <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />Sǝ &lt;Zuku&gt; mǝnana nakiyi ce ka, ɓālǝi aman le? Sǝm súrǝ̀ gir mǝnana nakiyi ka ɗàng!&gt;&gt;<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />Yesu sǝlǝna ama à kǝ earce à nǝ̀ ɗì amurí, pǝlǝa nea wia ama:</para>
  <para style="pi" vid="JHN 16:19">
    <char style="wj">Wu ndarǝ ɗiki rǝarǝ wun amur man nda ɓacau mǝnana ǝn na nǝma, &lt;&lt;Zuku ka pà wu nǝ̀ sǝnam ɗang, sǝ zuku anzǝmi ka wun nǝ̀ sǝnam ɗǝm&gt;&gt; ngga le?</char> <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" /><char style="wj">Mǝ ndarǝ na wun mǝsǝcau: Wun nǝ̀ ɓua nǝ mǝrǝm, andǝ keban, amur gir mǝnana nǝ̀ kumam ngga, sǝ amǝ ɓanza ka à nǝ̀ pak bumpwasǝa. Wun nǝ̀ pak bumkiɗikea, sǝ bumkiɗikea ma'wun nǝ̀ yia pǝlǝ bumpwasǝa.</char><verse eid="JHN 16:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="JHN 16:21" />
    <char style="wj">Ɓǝ̀ ɓwama malanǝ̀ gbáshí ka kǝ kutio aɓa tanni kwanban mala gbáshí acemǝnana pwari male yina; sǝ ɓǝ̀ yi gbashina ka, ɓālǝi lorǝna kwanban mala gbáshí, acemǝnana ban na ban ɓoari wi nǝ́ ɓǝl bǝsa muna a ɓanza.</char> <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" /><char style="wj">Anggo sǝ wu pa: Adyan ngga wu ndanǝ bumkiɗikea, sǝ ǝn nggǝ na wun ama, mǝ nǝ nggá sǝn wun ɗǝm, sǝ ɓabum wun ngga nǝ̀ pakkiɗire, ulang bumpwasǝa mǝnana kǝɓwa pà nǝ̀ é arǝ wun raka.</char><verse eid="JHN 16:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="JHN 16:23" />
    <char style="wj">A pwari mǝno ka, pà wu nǝ̀ zǝm kǝgìr ɗǝm a banam ɗàng. Ən nggǝ bangga wun mǝsǝcau, Tárrám nǝ̀ pa wun gir mǝnana kat wu zǝmba aɓa lullǝam ngga.</char> <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" /><char style="wj">Yàle ado ka wu malaká zǝm kǝgìr aɓa lullǝam ɗàng: wu zǝmba sǝ à nǝ̀ pà wun, sǝ bumpwasǝa ma'wun nǝ̀ lùmsǝo.</char><verse eid="JHN 16:24" /></para>
  <para style="s">Yesu nǝ̀ limurǝm amur ɓanza</para>
  <para style="pi">
    <verse number="25" style="v" sid="JHN 16:25" />
    <char style="wj">Ən na wun amǝnia yì acau ka nǝ cauɓaɓi, sǝ pwari na kǝ yiu ka mǝnana pà mǝ nǝ na wun cau ɗǝm nǝ cauɓaɓi raka. Mǝ nǝ pusǝa wun cau a banfana amur Tárrám.</char> <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" /><char style="wj">Sǝ wun nǝ̀ zǝmba aɓa lullǝam. Ən pa aban na nǝma mǝ nǝ zǝmbi Tárrám amur wun ɗang.</char> <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" /><char style="wj">Tárrám nǝ ɓamúrì ka kǝ earce wun kǝ̀rkǝ́r, acemǝnana wu kǝ earcem, sǝ acemǝnana wu earnǝ mim ama ǝn pur nǝ bani ka.</char> <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" /><char style="wj">Ən pur a ban Tárrám sǝ ǝn yiu a ɓanza, sǝ ado ka, mǝ ndo mǝ nǝ nying ɓanza mǝ nǝ nyare a ban Tárrám.</char><verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />Pǝlǝa alaggana male banggi wi ama, &lt;&lt;Ado wuni sǝ a kǝ pusǝa sǝm cau a banfana. Cauɓaɓe na a banggiyi ɗǝm ngga ɗàng. <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />Adyan ngga sǝm sǝlǝna ama we ka a súrǝ̀ agir kat, ɓwa pà nǝ̀ na ama nǝ̀ ɗio kǝ cau ɗàng. Ace mǝno ka sǝm earǝna ama we ka a pur nǝban Ɓakuli.&gt;&gt;<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />Yesu pǝlǝa eare ama:</para>
  <para style="pi" vid="JHN 16:31">
    <char style="wj">Ado ka, wu earǝna nǝ mim le?</char> <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" /><char style="wj">Wu sǝni, pwari na kǝ yiu ka, yàle nggearǝ pwari nì yina, yì mǝnana wun kat ka, wun nǝ̀ mesǝke, koyan ngga nǝ̀ bwal njar male, wun nǝ̀ ɗekiam nǝmurǝam. Sǝ ǝn pa gbal nǝmurǝam ɗàng, acemǝnana Tárrám nda atàm.</char><note caller="+" style="f"><char style="fr" closed="false">16:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 4:23">Yoh 4:23</ref>; <ref loc="MRK 14:27">Mar 14:27</ref>; <ref loc="ZEC 13:7">Zak 13:7</ref></char>.</note> <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" /><char style="wj">Ən bangga wun amǝnia yì acau ka, acemǝnana a ɓalǝam ngga wun nǝ̀ kum dorǝpwala. Aɓa mǝnia yì ɓanza ka, wun nǝ̀ kum patanni, sǝama ɓabum wun ɓǝ̀ kǝa ɓungi ɗang! Ən linamurǝm amur ɓanza!</char><note caller="+" style="f"><char style="fr" closed="false">16:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 14:27">Yoh 14:27</ref>; <ref loc="JHN 15:18">15:18</ref>; <ref loc="ROM 8:37">Rom 8:37</ref>; <ref loc="2CO 2:14">2Kor 2:14</ref>; <ref loc="REV 3:21">Sǝn 3:21</ref></char>.</note><verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">Yesu pàk hiwi ace amǝkpate</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />Anzǝm mǝnana Yesu malǝna naki acau mǝnia ka, pǝlǝa loasǝ mǝsǝì a kùli, sǝ pàk hiwi ama:</para>
  <para style="pi" vid="JHN 17:1">
    <char style="wj">Dâ, adyan ngga bu-pwarî yina. Gusǝlǝ Munio ace mǝnana ɓǝ̀ Munio pò gulo mô ka.</char> <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" /><char style="wj">A panì wi rǝcandǝa amur ɓanza kat, ɓǝ̀ pea aɓwana mǝnana a yinǝia a baní ɓǝà duk amǝkpate ka, yilǝmu mǝnana málá male pà kàm raka.</char> <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" /><char style="wj">Sǝ mǝnia ka nda njar kum yilǝmu mǝnana pà nǝ̀ mal raka, ɓǝà súrǝ̀o, kǝ we Ɓakuli Mǝ'mǝsǝcau nì, andǝ Munio Yesu Kǝrǝsti mǝnana a túrí aɓa ɓanza ka.</char> <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" /><char style="wj">Ən yinǝno nǝ́ gulo a ɓanza man, acemǝnana ǝn malǝna túró mô mana a pam ama ɓǝ̀n pê ka.</char> <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" /><char style="wj">Sǝ ado ka, Dâ, nyesǝâm gulo a ɓadǝmbo, gulo mǝnana mǝ ndanǝi sǝnǝ we ɗiɗyal sǝ a yi pusǝ ɓanza ka.</char><verse eid="JHN 17:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="JHN 17:6" />
    <char style="wj">Ən lǝmdǝni aɓwana mǝnana a pam mia a ɓanza ka rǝò. Yia ka amô na. A nǝ̀ pam mia, sǝ à kpanatà cau mò.</char> <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" /><char style="wj">Yia adyan ngga à sǝlǝna ama koya gìr mǝ ndanǝi ka kǝ pur nǝ bano.</char> <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" /><char style="wj">Ən pania wia cau mǝnana a pam ngga, sǝ yia gbal ka à angŋǝni; à sǝlǝna ama mǝsǝcau na ǝn pur a bano, sǝ à earǝna ama a nǝ̀ túrǎm.</char><verse eid="JHN 17:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="JHN 17:9" />
    <char style="wj">Hiwi mem ngga, pà ace ɓanza ɗàng, nda kǝ cea, aɓwana mǝnana a pam ngga, acemǝnana yia ka amô na.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">17:9 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 22:32">Luk 22:32</ref>; <ref loc="JHN 14:16">Yoh 14:16</ref></char>.</note> <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" /><char style="wj">Aɓwana mǝnana kat mǝ ndanǝia ka amô na, sǝ a nda a pamia ka, ace mǝnana ɓǝà lǝmdǝ gulo mem aɓalǝia ka.</char><verse eid="JHN 17:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="JHN 17:11" />
    <char style="wj">Ado ka mǝ ndo mǝ nǝ nying ɓanza, mǝ nǝ nyare a bano, sǝ yia ka à ndakani a ɓanza più. Dâ Ɓakuli Mǝfele! Yália, nǝ rǝcandǝa mala lùllǝò mǝnana a pam ngga, acemǝnana yia ka ɓǝà duk mwashat kǝla mǝnana sǝm nda mwashat sǝnǝ we ka.</char> <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" /><char style="wj">A do mem sǝnǝia ka, ǝn yália, sǝ ǝn bwalia nǝ rǝcandǝa mala lùllǝò mǝnana a pam ngga. Kǝ ɓè ɓwàr ateà ɗàng, she kǝ yì ɓwa mǝnana dupî ká kìɗìkì ka, acemǝnana cau mò mana à gilǝì aɓa Malǝmce ka, ɓǝ̀ lùmsǝo.</char><verse eid="JHN 17:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="JHN 17:13" />
    <char style="wj">Adyan ngga mǝ ndya ǝn nggǝ ká a bano ka. Ən nggǝ banggia wia amǝnia yia cau mǝnana mǝ ndakani più amǝnia yì ɓanza ka, acemǝnana ɓǝà lùmsǝ nǝ bumpwasǝa mem.</char> <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" /><char style="wj">Ən pania wia cau mò, sǝ ɓanza kǝ ɓinǝ mǝsǝia, acemǝnana yia ka à nda ka mala ɓanza ɗàng, kǝla mǝnana mim ngga mǝ nda mala ɓanza raka.</char><verse eid="JHN 17:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="JHN 17:15" />
    <char style="wj">Ən pa aban zǝmba nǝma wu pusǝia, ɓǝà nying ɓanza ɗàng. Mǝ nda aban zǝmba ama, wu bwalia, ɓǝà kǝa kútí a ɓabù Shetan, mǝɓealɓikea ɗang.</char> <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" /><char style="wj">Yia ka à mala ɓanza mǝnia na ɗang kǝla mǝnana mim ngga mǝ nda mala ɓanza raka.</char> <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" /><char style="wj">Tària ɓǝà duk amô nǝ mǝsǝcau mò; cau mò ka nda kǝ mǝsǝcau.</char> <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" /><char style="wj">Kǝla mǝnana a túrǎm aɓa ɓanza ka, anggo gbal sǝ ǝn nggǝ túriá aɓa ɓanza.</char> <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" /><char style="wj">Sǝ àkǝ̀ cea sǝ ǝn tàr ɓamúràm ɓǝ̀n duk mô, acemǝnana yia gbal ka, ɓǝà tàr ɓamuria aceo ɓǝà duk amô aɓa mǝsǝcau.</char><verse eid="JHN 17:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="JHN 17:20" />
    <char style="wj">Hiwi mem ngga pà ace alaggana mem mǝnia nǝmurǝia ɗàng, nda gbal ace aɓwana mǝnana à nǝ̀ yia ak Cau Amsǝban mǝnana amǝkpatam nǝ̀ hamnǝi a banià ka.</char> <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" /><char style="wj">Ən nggǝ pak hiwi nǝma yia kat ka ɓǝà duk mwashat, kǝla mǝnana mim sǝnǝ we, sǝm nda mwashat ka. Dâ, kǝla mǝnana a nda a ɓalǝam, sǝ mǝ nda a ɓālǝo ka, yia gbal ka ɓǝà do aɓalǝ sǝm, ace mǝnana ɓanza ɓǝ̀ eare ama a nǝ̀ túrǎm ngga.</char><verse eid="JHN 17:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="JHN 17:22" />
    <char style="wj">Ən pania wia gulo mǝnana a pam ngga, acemǝnana ɓǝà duk mwashat, kǝla mǝnana mim sǝnǝ we sǝm nda mwashat ka.</char> <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" /><char style="wj">Mim sǝnǝia ka sǝm nda mwashat, sǝ mim sǝnǝ we ka sǝm nda mwashat. Cia, ɓǝà kum ulang mǝnia yì dotarǝu mǝɓoarne ka aɓalǝia, ace mǝnana amǝɓanza ɓǝà sǝlǝ ama a nǝ̀ túrǎm, sǝ ɓǝà sǝlǝ gbal ama a kǝ earcea kǝla mǝnana a kǝ earcem ngga.</char><verse eid="JHN 17:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="JHN 17:24" />
    <char style="wj">Dâ! Ən nggǝ earce nǝma aɓwana mǝnana a pamia ka, ɓǝà do atàm a ban mǝnana mǝ nda kam ngga; sǝ ɓǝà sǝn gulo mem mǝnana a pam, acemǝnana a kǝ earcem sǝ a yi pusǝ ɓanza ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">17:24 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 1:14">Yoh 1:14</ref>; <ref loc="JHN 17:5">17:5</ref>; <ref loc="MAT 25:34">Mat 25:34</ref></char>.</note> <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" /><char style="wj">We Dâ Mǝ'cauɓoarna! Ɓanza súrǝ̀o ɗàng, sǝ mim ngga ǝn súrǝ̀o, sǝ amǝnia yì alaggana mem ngga, à sǝlǝna ama a nǝ̀ túrǎm.</char> <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" /><char style="wj">Ən lǝmdǝnia wia rǝò, sǝ mǝ nǝ lidǝmba nǝ lǝmdǝia wia rǝò ɗǝm, ace mǝnana earcearǝu mana a ndanǝi arǝàm ngga ɓǝ̀ do aɓalǝia, sǝ mim ngga mǝ nǝ duk gbal aɓalǝia.</char><verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">À bwal Yesu</para>
  <para style="r">(<ref loc="MAT 27:47-56">Matiu 27:47-56</ref>; <ref loc="MRK 14:43-50">Markus 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />Anzǝm mǝnana Yesu malǝna hiwi ka, pǝlǝa lo andǝ alaggana male à eauwe a nkaring mala ɓangŋaban Kidǝron. À kya kutio a ɓè ɓaban mala anggun olif.<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:30">Mat 26:30</ref>,<ref loc="MAT 26:36">36</ref>; <ref loc="MRK 14:26">Mar 14:26</ref>,<ref loc="MRK 14:32">32</ref>; <ref loc="LUK 22:39">Luk 22:39</ref>; <ref loc="2SA 15:23">2Sam 15:23</ref></char>.</note><verse eid="JHN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2" />Yahuda, mǝnana mak Yesu ka, súrǝ́nà rǝ banì, acemǝnana kusǝ pas Yesu kǝ dapi kam andǝ alaggana male. <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />Agbani Pǝris andǝ amǝ Farisi tasǝ amǝ'yál Ndàmǝgule mala Ɓakuli andǝ aɓea soje mala amǝ Roma, ɓǝa kyane atà Yahuda aban mǝnana Yesu nakam ngga. À kur rǝia nǝ agirbura, sǝ à bwal bǝsa arǝ aɓukan, andǝ apitǝla, pǝlǝa à puro à yì tusǝo a ɓabanì.<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref></char>.</note> <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />Sǝ Yesu ka angŋa dǝmba sǝlǝna gir mǝnana nǝ̀ kumi ka, pǝlǝa puro cam a ɓadǝmbia, sǝ ɗia ama, <char style="wj">&lt;&lt;Yana ɓwe na wu alkite?&gt;&gt;</char><verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />À eare ama, &lt;&lt;Yesu ɓwa Nazarat.&gt;&gt;</para>
  <para style="p" vid="JHN 18:5">Banggia wia ama, &lt;&lt;Mǝ Nda.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:14">Pur 3:14</ref></char>.</note></para>
  <para style="p" vid="JHN 18:5">Yahuda, yì ɓwa mǝnana mak Yesu ka, nda aban came ateà. <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />Lang Yesu banggia wia ama, &lt;&lt;Mǝ Nda&gt;&gt; ka, kara à nyar nǝ nzǝmia à sukki a nzali. <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />Pǝlǝa Yesu nyare ɗia ama, <char style="wj">&lt;&lt;Yana ɓwe na wu alkiyite le?&gt;&gt;</char></para>
  <para style="p" vid="JHN 18:7">À eare ama, &lt;&lt;Yesu Ɓwa Nazarat.&gt;&gt;<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />Yesu eare ama, <char style="wj">&lt;&lt;Ən nanà wun nǝma Mǝ Nda. Sǝ ɓǝ̀ mǝ nda wu alkiyitam ngga, wu ɗeki alaggana mem mǝnia ka ɓǝa o.&gt;&gt;</char> <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />Mǝnia ka pa anggo ace mǝnana cau mana pur a kúni ka ɓǝ̀ lùmsǝo, mǝnana ama, <char style="wj">&lt;&lt;Dâ, aɓalǝ aɓwana mǝnana a pam ngga, ǝn turta kǝɓwa mwashat ɗang.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 17:12">Yoh 17:12</ref>; <ref loc="JHN 6:39">6:39</ref></char>.</note><verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />Shiman Bitǝrus kwetǝ nggeabyau, kwarǝna guro mala Pǝris Mǝgule nǝi, kasǝ kiri mǝlì kpat. (Lullǝ mǝno yì guro nda Malchus.) <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />Yesu banggi Bitǝrus ama, <char style="wj">&lt;&lt;Nyesǝ nggeabyau mo oasǝi a ndè! A kǝ sǝni kǝla pa mǝ nǝ nu kwap mala tanni mǝnana Tárrám pam ama ɓǝn nu ka re?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 10:38">Mar 10:38</ref>; <ref loc="MRK 14:36">14:36</ref></char>.</note><verse eid="JHN 18:11" /></para>
  <para style="s">Yesu a ɓadǝm Annas Pǝris Mǝgule</para>
  <para style="r">(<ref loc="MAT 26:57-58">Matiu 26:57-58</ref>; <ref loc="MRK 14:53-54">Markus 14:53-54</ref>; <ref loc="LUK 22:54">Luka 22:54</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />Pǝlǝa asoje andǝ mǝ'sàrǝ̀ban malea, andǝ amǝ munagara mala amǝ Yahudi, bwal Yesu, sǝ à taka abui. <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />A tadǝmbe ka à umnǝ Yesu a ɓadǝm Annas, nkil Kayafas, yì Pǝris Mǝgule a mǝno yì pǝlǝa ka. <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />Kǝ Kayafas mǝno nda kwarkir aɓwana-mǝgule mala amǝ Yahudi ama ndanǝ ɓoaro ɓǝ̀ ɓwa mwashat wú a kún aɓwana mala amǝ Yahudi ka.<note caller="+" style="f"><char style="fr" closed="false">18:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 11:49-51">Yoh 11:49-51</ref></char>.</note><verse eid="JHN 18:14" /></para>
  <para style="s">Shiman Bitǝrus makgìr súrǝ̀ Yesu</para>
  <para style="r">(<ref loc="MAT 26:69-70">Matiu 26:69-70</ref>; <ref loc="MRK 14:66-68">Markus 14:66-68</ref>; <ref loc="LUK 22:55-57">Luka 22:55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />Shiman Bitǝrus andǝ ɓe lagga mala Yesu wari a ban mǝnana à kútí nǝ Yesu kàm ngga. Mǝnia yì lagga ka Pǝris Mǝgule súrǝì pepè, nda sǝ à eari wi kutio aɓa ɓala mala Pǝris Mǝgule ka. <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />Bitǝrus ka ueo aban came a kunɓala nǝ nza. Sǝ mǝnia yì lagga mana pǝris mǝgule súrǝì ka, nyare yiu yi nacau nǝ muna-ɓwama mǝnana à tamsǝi ace yál kunɓala ka, pǝlǝa earî Bitǝrus ɓǝ̀ kutio. <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />Muna-ɓwame ɗì Bitǝrus ama, &lt;&lt;A nda gbal aɓalǝ amǝkpata ɓwa mǝno à bwali ka le?&gt;&gt;</para>
  <para style="p" vid="JHN 18:17">Bitǝrus eari wi ama, &lt;&lt;Awo, ǝn pa aɓalǝia ɗàng.&gt;&gt;<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />Ɗwal nda kam kǝ̀rkǝ́r, pǝlǝa amǝtúró palta andǝ amǝ munagara bwal bǝsa, à kǝ dandǝ rǝia. Sǝ Bitǝrus yiu, yi cam a bania a kun bǝsa.<verse eid="JHN 18:18" /></para>
  <para style="s">Pǝris Mǝgule ɗiki Yesu</para>
  <para style="r">(<ref loc="MAT 26:59-66">Matiu 26:59-66</ref>; <ref loc="MRK 14:55-64">Markus 14:55-64</ref>; <ref loc="LUK 22:66-71">Luka 22:66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />Pǝlǝa Pǝris Mǝgule tita ɗiki Yesu amur alaggana male andǝ kanigir male. <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />Yesu banggi wi ama, <char style="wj">&lt;&lt;Acau mem ngga ǝn nea bwāng a ɓadǝm ɓwapǝndǝa kat. Sǝ ko aya pwari ka mǝ ndaban kanigir arǝ ndakpapi andǝ Ndàmǝgule mala Ɓakuli, ban ramba mala amǝ Yahudi. Ən na kǝ cau aɓa sǝmbǝrǝa ɗang.</char> <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" /><char style="wj">Sǝ ace man sǝ à kǝ ɗìkiam? Ɗì ka aɓwana mǝnana à ok cau mana ǝn na ka. Yia ka à súrǝ́nà rǝ cau mǝnana ǝn na ka.&gt;&gt;</char><verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />Lang Yesu bangŋǝna anggo ka, ɓeɓwa aɓalǝ amǝ yál Ndàmǝgule, mǝnana came a banì, kwak Yesu a takiri, sǝ bang ama, &lt;&lt;Anggo sǝ a nǝ pǝlǝì Pǝris Mǝgule cau?&gt;&gt;<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />Pǝlǝa Yesu ear ama, <char style="wj">&lt;&lt;Ɓǝ̀ ǝn nacau mǝnana mǝɓane na ka, banggàm ɓá ɓwarke, sǝ ɓǝ̀ mǝsǝcau na ǝn na ka, mana nda tǝr koem a takiram?&gt;&gt;</char><verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />Anggo, andǝa kǝ tà bu mǝnana à tàkà abu Yesu ka, sǝ Annas tasǝte a ban Kayafas, yì Pǝris Mǝgule.<verse eid="JHN 18:24" /></para>
  <para style="s">Ɓaria andǝ tàruià tǝmce <optbreak /> súrǝ̀ Yesu mala Bitǝrus</para>
  <para style="r">(<ref loc="MAT 26:71-75">Matiu 26:71-75</ref>; <ref loc="MRK 14:69-72">Markus 14:69-72</ref>; <ref loc="LUK 22:58-62">Luka 22:58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />Aɓa mǝno anggo ka, Shiman Bitǝrus nda àkǝ̀ bancame a kun bǝsa, aban dandǝ rǝì. Sǝ aɓwana a banì ɗì ama, &lt;&lt;We ka, a pa aɓalǝ alaggana mala ɓwa mǝno re?&gt;&gt; Pǝlǝa yì ka, tǝmce, na ama, &lt;&lt;Awo, ǝn pa aɓalǝia ɗàng.&gt;&gt;<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />Sǝ ɓeɓwa mwashat aɓalǝ aguro mala Pǝris Mǝgule, ɓǝla mala ɓwa mǝnana Bitǝrus kasǝ kiri ka, nacau ama, &lt;&lt;Ən sǝno mǝni atà Yesu akanó a ɓaban re?&gt;&gt;<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />Bitǝrus nyare tǝmce, ama, &lt;&lt;Awo mǝ nda ɗang.&gt;&gt; Anggo ka, kara nggu ɓua.<verse eid="JHN 18:27" /></para>
  <para style="s">A warinǝ Yesu a ɓadǝm Bilatus</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matiu 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Markus 15:1-5</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />Nǝ dǝmbari ɗiɗyal ka à pusǝ Yesu a ɓala mala Kayafas, à um nǝi a banmǝgule mala Nggwamna, ɓwa Roma. Sǝ aɓwana-mǝgule mala amǝ Yahudi, mǝnana à tsǝki Yesu cau atè ka, à ɓinǝ kutio aɓa palta mala Nggwamna, acemǝnana ɓǝà kútí ka, à nǝ̀ pǝndǝki ɓamuria, mǝnana nǝ̀ tsǝa à pà nǝ̀ kùmô à nǝ̀ li girlina Lamsan Yàlîmurû raka.<note caller="+" style="f"><char style="fr" closed="false">18:28 </char><char style="fq" closed="false">à nǝ̀ pǝndǝki ɓamuria, mǝnana nǝ̀ tsǝa à pà nǝ̀ kùmô à nǝ̀ li girlina Lamsan Yàlîmurû raka: </char><char style="ft" closed="false">Amǝ Yahudi mǝnana à je aɓwana mala acilia anzali ko à gbashi bania tù a dǝm Lamsan Yàlîmurû ka à earia wia ɓǝa li girlina Lamsan Yàlîmurû ɗang.</char></note> <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />Ace mǝno ka, Bilatus pur a bania, sǝ ɗia ama, &lt;&lt;Ya cau na wu yiu nǝi amur mǝnia yì ɓwa ka le?&gt;&gt;<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />Pǝlǝa à eare ama, &lt;&lt;Ɓǝ̀ ɓwa mǝnia ka, mǝ'ɓealɓikea na raka, ɓǝ́ pa sǝm nǝ̀ yiu nǝi a bano ɗàng.&gt;&gt;<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />Bilatus pǝlǝa banggia wia ama, &lt;&lt;Ɓǝ̀ nda anggo ka, wu um nǝi, wu kya ɓashi wi nǝ nggurcau ma'wun la.&gt;&gt;</para>
  <para style="p" vid="JHN 18:31">Pǝlǝa amǝ Yahudi eare ama, &lt;&lt;Sǝm pà nǝ́ rǝcandǝa mala kasǝ ɓashi-lú amur kǝɓwa ɗàng.&gt;&gt; <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />Mǝnia ka lùmsǝ cau mǝnana Yesu bang amur ulang lú mǝnana nǝ̀ wu ka.<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 3:14">Yoh 3:14</ref>; <ref loc="JHN 12:32">12:32</ref></char>.</note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />Pǝlǝa Bilatus nyare aɓa palta male sǝ túrban ɓǝà kútí nǝ Yesu a baní. Ɗì Yesu ama, &lt;&lt;A nda murǝm mala amǝ Yahudi le?&gt;&gt;<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />Yesu eari wi ama, <char style="wj">&lt;&lt;Mǝnia yì ɗiban ngga, a twali a mala ɓamuro le ko aɓea ɓwana na à no cau a muram ngga?&gt;&gt;</char><verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />Bilatus ne wi ama, &lt;&lt;Mim ngga mǝ nda ɓwa Yahudi le? Aɓwana mô andǝ agbani pǝris ma'wun na à yiu nǝ we a ɓashi a banam ngga. Mana ɗe a pa?&gt;&gt;<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />Yesu eare ama, <char style="wj">&lt;&lt;Domurǝm mem ngga mala ɓanza mǝnia na ɗang. Ɓǝ̀ pǝlǝ ama mala ɓanza man na ka, ɓǝ́ amǝkpatam nǝ̀ munǝo acem, à pà nǝ̀ eari aɓwana-mǝgule mala amǝ Yahudi ɓǝà bwalam ɗang. Awo, domurǝm mem ngga mala ɓanza man na ɗang.&gt;&gt;</char><verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />Bilatus pǝlǝa ne Yesu ama, &lt;&lt;Ashe a nda murǝm!&gt;&gt;</para>
  <para style="p" vid="JHN 18:37">Yesu eari wi ama, <char style="wj">&lt;&lt;A bang ama mǝ nda murǝm. Ace kǝ mani sǝ à ɓǝ̀lám, sǝ yiu mem a ɓanza ka nda ace na mǝsǝcau, sǝ ɓwa mǝnana kat kǝ camata mǝsǝcau ka, kǝ kwakikiri kǝ ok giem.&gt;&gt;</char><verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />Pǝlǝa Bilatus ɗì ama, &lt;&lt;Mana nda mǝsǝcau?&gt;&gt;</para>
  <para style="s" vid="JHN 18:38">Bilatus pà Yesu ɓǝà wal-luí</para>
  <para style="r" vid="JHN 18:38">(<ref loc="MAT 27:15-31">Matiu 27:15-31</ref>; <ref loc="MRK 15:6-20">Markus 15:6-20</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>)</para>
  <para style="p" vid="JHN 18:38">Bilatus nyare puro a ban amǝ Yahudi sǝ banggia wia ama, &lt;&lt;Mim ngga ǝn kumi nǝ ɓekǝ cauɓikea ɗang! <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />Sǝ wun amǝ Yahudi ka, ko aya pǝlǝa sǝ ɓǝ̀ yi karǝ nǝ Lamsan Yàlîmurû ka, pàk ka wu kǝ earce ama ɓǝn panzǝa wun ɓwa mwashat atà aɓwana mǝnana à kùria a ndàkurban ngga. Ado ka, wu earce ɓǝn panzǝa wun mǝnia yì &lt;Murǝm mala amǝ Yahudi&gt; ka le?&gt;&gt;<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />Sǝ à nyesǝi wi nǝ loasǝban ama, &lt;&lt;Awo, ɓwa mǝnia na à nǝ̀ panzǝa sǝmi ka ɗàng! Panzǝa sǝm Barabbas!&gt;&gt; (Barabbas ka à bwali acemǝnana yì ka, mǝ'mgbicau na.)<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />Bilatus pǝlǝa tsǝa à kwak Yesu nǝ kamso. <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />Asoje marǝki zwe kǝla mbulan-murǝm sǝ à oasǝì Yesu a ɓamúrí. À túrì wi daura ulang mala amurǝma arǝì, <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />sǝ à kǝ nyarke a ɓadǝmbi, à kǝ ne wi cau ɓanginǝban ama, &lt;&lt;Ɓǝ̀ rǝo pwalo, we murǝm mala amǝ Yahudi!&gt;&gt; Sǝ à kǝ koe a ɓamǝsǝi nǝ ɓabuia.<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />Bilatus pǝlǝa pur ɗǝm a ban aɓwana-mǝgule mala amǝ Yahudi sǝ nea wia ama, &lt;&lt;Wu kwaki kir wun! Mǝ ndo mǝ nǝ pusǝì, mǝ nǝ yinǝi a ban wun, sǝama wu sǝlǝ ama mim ngga ǝn kumi nǝ ɓekǝ cauɓikea ɗang.&gt;&gt; <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />Pǝlǝa Yesu pur a bania a nza, nǝ mbulan zwe a múrí andǝ daura mala amurǝma arǝì. Sǝ Bilatus nea wia ama, &lt;&lt;Ɓwe ndya ka!&gt;&gt;<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />Lang agbani pǝris andǝ amǝ'yál Ndàmǝgule nǝ̀ sǝni ka, à loasǝ già a kùli à na ama, &lt;&lt;Gbàllì a nggun-gangndǝi! Gbàllì a nggun-gangndǝi!&gt;&gt;</para>
  <para style="p" vid="JHN 19:6">Bilatus na ama, &lt;&lt;Wu twali la, wu kya gbàllì a nggun-gangndǝi nǝ ɓamur rǝ wun! Acemǝnana mim ngga ǝn kumi nǝ ɓekǝ cauɓikea ɗang.&gt;&gt;<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />Pǝlǝa aɓwana-mǝgule mala amǝ Yahudi eari wi ama, &lt;&lt;Aɓa nggurcau ma'sǝm ngga, ɓoaro ɓǝ̀ wú, acemǝnana twal ɓamúrì ama yì ka, Muna mala Ɓakuli na!&gt;&gt;<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />Lang Bilatus nǝ̀ ok man yì cau ka, gir nî pe wi ɓangciu kǝ̀rkǝ́r. <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />Pǝlǝa nyesǝ Yesu wari nǝi aɓa palta ɗǝm sǝ ɗì ama, &lt;&lt;We ka, a pur a ya ban?&gt;&gt;</para>
  <para style="p" vid="JHN 19:9">Sǝ Yesu ka duk kúni più, pǝlǝi wi kǝ cau ɗàng. <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />Bilatus banggi wi ama, &lt;&lt;A pà nǝ nam cau ɗang? A sǝlǝ mbak ama mǝ ndanǝ rǝcandǝa mǝ nǝ panzǝo, ko mǝ nǝ tsǝa ɓǝà gbàllio a nggun-gangndǝi?&gt;&gt;<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />Yesu eari wi ama, <char style="wj">&lt;&lt;A pà nǝ kum rǝcandǝa a muram ɗàng, yi mǝnana ɓǝ̀ Ɓakuli pamo raka. Ace mǝno ka, ɓwa mǝnana tasǝam aɓa buo ka, cauɓikea male gulo kútì mò.&gt;&gt;</char> <verse eid="JHN 19:11" /><verse number="12" style="v" sid="JHN 19:12" />Lang Bilatus ok mǝnia yì cau ka, pǝlǝa ɓariki nǝ̀ alta njargula mǝnana nǝ̀ pusǝna Yesu nǝi ka. Sǝ aɓwana-mǝgule mala amǝ Yahudi ka, à loasǝ già bàng-bàng ama, &lt;&lt;Ɓǝ̀ a panzǝ ɓwa mǝnia sǝ au ka, lǝmdǝ ama a nda gyajam mala Kaisar, Mǝtala nzali ɗang! Acemǝnana ɓwa mana kat twal ɓamúrì ama yì ka, murǝm na ka, ɓwe ka mǝ'mgbicau na arǝ Mǝtala nzali!&gt;&gt;<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />Lang Bilatus nǝ̀ ok cau mǝno ka, pǝlǝa pusǝ Yesu a banfana sǝ eauwe do amur buno ɓashi mǝnana à kǝ tunǝi ama, &lt;&lt;Ban múr tali&gt;&gt; ka. (Nǝ kun Ibǝru ka à kǝ tunǝi ama, &lt;&lt;Gabbata.&gt;&gt;) <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />Anggo ka pwarizǝkya gbàshìnà a pwari gilǝrǝu ace Lamsan Yàlîmurû. Pǝlǝa Bilatus banggi amǝ Yahudi ama, &lt;&lt;Wu sǝni, murǝm ma'wun ndya ka!&gt;&gt;<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />Kara yia kat à lo arǝì gǝu ama, &lt;&lt;Wali ɓǝ̀ wu! Wali ɓǝ̀ wu! Gbàllì a nggun-gangndǝi!&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">Bilatus ɗia ama, &lt;&lt;Mana! Wu earce ɓǝ̀n gballì murǝm ma'wun a nggun le?&gt;&gt;</para>
  <para style="p" vid="JHN 19:15">Pǝlǝa agbani pǝris malea ear ama, &lt;&lt;Kǝ murǝm pa a bu sǝm ɗàng, she kǝ Kaisar, Mǝtala nzali mala amǝ Roma!&gt;&gt; <verse eid="JHN 19:15" /><verse number="16" style="v" sid="JHN 19:16" />Gandǝa Bilatus pea wia Yesu, ɓǝà kya gbàllì amur nggun-gangndǝi ka.</para>
  <para style="p" vid="JHN 19:16">Sǝ à bwal Yesu à um nǝi.<verse eid="JHN 19:16" /></para>
  <para style="s">À gbàllì Yesu amur nggun-gangndǝi</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matiu 27:32-44</ref>; <ref loc="MRK 15:21-32">Markus 15:21-32</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />À tsǝki wi nggun-gangndǝi mǝnana à nǝ̀ ká gbàllì amurí ka, a meali, sǝ pur aban ká a ban mǝnana à kǝ tunǝi ama &lt;&lt;Ban kpouloɓamuru&gt;&gt; ka. Nǝ kun Ibǝru ka, à tunǝ banì ama, &lt;&lt;Golgota.&gt;&gt; <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />Àkǝ̀ banì sǝ à gbàllì Yesu amur nggun-gangndǝi. À gbàllì aɓea aɓwana ɓari gbal andǝ Yesu, mwashat atà buì mǝlì sǝ ɓè ka atà buì mǝ'nggare, sǝ Yesu ka nda aɓa ɓalǝu.<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />Bilatus gilǝgir arǝ gbǝlang kpamgbang sǝ tsǝa à gbàllì arǝ nggun-gangndǝi amur Yesu. Cau mǝnana gilǝ ka nda, &lt;&lt;Yesu Ɓwa Nazarat, Murǝm Mala Amǝ Yahudi.&gt;&gt; <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />Ban mǝnana à gbàllì Yesu kàm ngga, sau nǝ là ɗàng, aɓwana pas ɓal mǝnia yì gìr à gilǝì ka, acemǝnana à gilǝì nǝ kún mala amǝ Ibǝru, andǝ kún mala amǝ Latin, andǝ kún mala amǝ Gǝrik. <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />Sǝ agbani pǝris wari a ban Bilatus à kya banggi wi ama, &lt;&lt;Kǝa gilǝ ama, &lt;Yì ka, nda Murǝm mala amǝ Yahudi&gt; ɗàng. Ɓoaro male ka à nǝ̀ gilǝ ama, &lt;Ɓwa mǝnia ka bang ama, yì nda Murǝm mala amǝ Yahudi.&gt; &gt;&gt;<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />Bilatus nyesǝia wia ama, &lt;&lt;Awo! Gìr mǝnana ǝn gilǝna ka dumǝna anggo.&gt;&gt;<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />Anzǝm mǝnana asoje gbàllìnà Yesu amur nggun-gangndǝi ka, à pwan agir-nggūrǝì à gauwia banì ine, sǝ koya soje ka twal banì mwashat. Sǝ nggea-daura male mǝnana à tè nǝ nggubyau mwashat, kunkpakǝri pa arǝì raka, à twali gbal. <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />Pǝlǝa à nea rǝia ama, &lt;&lt;Ɓǝ̀ sǝm ngga na ama sǝm nǝ̀ sàngi daura man ɗang, a kun mani ka, ɓǝ̀ sǝm kocàca amurí, ɓwa mǝnana lì ka ɓǝ̀ twali.&gt;&gt; Mǝnia yì gìr ka yi pa anggo ace mǝnana ɓǝ̀ lùmsǝ cau mala Ɓakuli mǝnana bang ama,</para>
  <para style="q1" vid="JHN 19:24">&lt;&lt;À gakkia rǝia adaura mem</para>
  <para style="q2" vid="JHN 19:24">sǝ à kocàca ace</para>
  <para style="q1" vid="JHN 19:24">nggea-daura mem.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:18">Ang 22:18</ref></char>.</note></para>
  <para style="m" vid="JHN 19:24">Mǝnia ka nda gìr mǝnana asoje pê ka.<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />Nggea Yesu, andǝ mǝ'eam ngge mǝɓwame, andǝ Maryamu mālá Kilobas, andǝ Maryamu Ɓwa Magdala ka, à ndaban came tù a ban nggun-gangndǝi mǝnana à gbàllì Yesu amurí ka. <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />Yesu sǝn nggè andǝ ɓe lagga male mǝnana earkiyi ace raka aban came a banì; pǝlǝa banggi nggè ama, <char style="wj">&lt;&lt;Nnâ, munio ndya ka.&gt;&gt;</char><verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />Sǝ ne mǝnia yì lagga male ka ama, <char style="wj">&lt;&lt;We ka, nggo ndya ka.&gt;&gt;</char> Twal a pwari mǝno ka, mǝnia yì lagga mala Yesu ka, um nǝ nggea Yesu a ɓala male.<verse eid="JHN 19:27" /></para>
  <para style="s">Lú mala Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matiu 27:45-56</ref>; <ref loc="MRK 15:33-41">Markus 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />Yesu sǝlǝna ama ado ka agir mǝnana kat Ɓakuli túrí ɓǝ̀ yi pea ka, malǝna pea, sǝ ace mǝnana ɓǝ̀ cau mala Malǝmce mala Ɓakuli ɓǝ̀ lùmsǝ ka, bang ama, <char style="wj">&lt;&lt;Ən nggǝ ok mǝsamur.&gt;&gt;</char><verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />Kwar ndakam a banì, mǝnana lùmsǝ nǝ mùr-ɓǝlanggun anap mǝhangŋe ka, pǝlǝa asoje par soso aɓalǝi, sǝ à loasǝi a kun gara, à tsǝki wi a kúni ɓǝ̀ nu. <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />Lang Yesu sonzǝ mur anap nì ka, na ama, <char style="wj">&lt;&lt;Malǝna!&gt;&gt;</char></para>
  <para style="p" vid="JHN 19:30">Pǝlǝa dili múrí sǝ pa yilǝmi.<verse eid="JHN 19:30" /></para>
  <para style="s">À zuɓi Yesu nǝ kaɗa a mǝsǝnkanggari</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />Pwari mǝno ka pwari gilǝrǝu na, acemǝnana ɓǝ̀ ban fana ka, pwari Sabbat na. Sǝ aɓwana-mǝgule mala amǝ Yahudi ka, à pà nǝ̀ earce ɓǝ̀ alú ueo akanó aban gyare amur anggun-gangndi, ɓǝà bwal ɓè pwari mǝno kǝ yiu ka ɗàng. Ace mani ka à banggi Bilatus ama, ɓǝ̀ earia wia ɓǝà ɓungi akusǝ aɓwana mǝnana à gbàllia amur anggun-gangndi ka. À earce pe anggo ace mǝnana ɓǝà wu tù à nǝ̀ sulǝ aluia a nzali. À zǝmba anggo acemǝnana mǝnia yì pwari Sabbat ka, pwari mǝfele na a ban amǝ Yahudi, sǝ ɗǝm ngga pwari mǝgule na, acemǝnana yi karǝ nǝ Pwari Lamsan ngga. <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />Asoje pǝlǝa à wario à kya ɓungi akusǝ aɓwana mǝnana à gbàllia a bu mǝlì andǝ bu mǝ'nggare mala Yesu ka. <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />Lang à yiu a ban Yesu ka, à sǝni ka Yesu angŋa dǝmba wuna, sǝ à ɗeki, à ɓungi akusǝi ɗàng. <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />Sǝa ma, mwashat aɓalǝ amǝnia yì asoje ka, zuɓi Yesu a nkanggari nǝ kaɗa, kara nkila andǝ mùr puro aban sukkio. <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />Ɓwa mǝnana sǝn mǝnia yì gìr ka, nda bang ce ka, sǝ cau mǝnana na ka mǝsǝcau na, ace mǝnana wun gbal ka ɓǝ̀ wu ak cê, sǝ ɓǝ̀ wu pa ɓamur wun. <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />Mǝnia yì gìr ka pa anggo ace mǝnana ɓǝ̀ lùmsǝ cau mala Ɓakuli mǝnana à gilǝì aɓa Malǝmce ama, &lt;&lt;À pà nǝ̀ ɓun mu kǝ bare ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:36 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:46">Pur 12:46</ref>; <ref loc="NUM 9:12">Ɓal 9:12</ref>; <ref loc="PSA 34:20">Ang 34:20</ref></char>.</note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />Sǝ ɓè ban ɗǝm aɓa Malǝmce mala Ɓakuli bang ama, &lt;&lt;Aɓwana nǝ̀ sǝn ɓwa mǝnana à zuɓi nǝ kaɗa ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 12:10">Zak 12:10</ref>; <ref loc="REV 1:7">Sǝn 1:7</ref></char>.</note><verse eid="JHN 19:37" /></para>
  <para style="s">À tsǝk Yesu a ɓembe</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matiu 27:57-61</ref>; <ref loc="MRK 15:42-47">Markus 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />Nǝ nzǝ́mò ka, Yisǝfu, ɓwa Arimatiya zǝmbi Bilatus ama, nǝ̀ twal lú Yesu. (Yì Yisǝfu ka mǝkpata Yesu na aɓa sǝmbǝrǝa, acemǝnana kǝ ɓanggi aɓwana-mǝgule mala amǝ Yahudi.) Bilatus pǝlǝa earî wi ɓǝ̀ twali. Nda sǝ Yisǝfu wario kya twal lú Yesu um nǝi ka. <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" /><note caller="+" style="f"><char style="fr" closed="false">19:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 3:1">Yoh 3:1</ref>,<ref loc="JHN 3:2">2</ref></char>.</note> Nikodimus, ɓwabura mǝnana ɗiɗyal yiu a ban Yesu nǝ du ka, wari atà Yisǝfu. Yinǝ mùrú mǝ'rǝmɓoarne, a buì, ace hasǝi lú. Mùruî ka à pè nǝ myang nggun mǝr mana à zurǝì andǝ muku nggun-alus ka. Dǝmbǝrya male na tyang lumi-tàrú. <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />Aburana mǝnia yia kǝm ngga à twal lú Yesu sǝ à marǝki aɓa nggurbyau pwasǝa andǝ mùrú mǝ'rǝmɓoarne, kǝla mǝnana amǝ Yahudi kǝ pang nǝ lú sǝ à nǝ̀ tsǝì ka. <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />A ban mǝnana à gbàllì Yesu kàm ngga, ɓe ɓaban nda kam nǝ ɓembe aɓalǝi, mǝnana à kwarí aɓa sorotali ka, bǝshe na, à malaká tsǝk kǝɓwa kàm ɗàng. <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />Sǝ acemǝnana pwari mǝno ka pwari gilǝrǝu na ace Sabbat andǝ Lamsan Yàlîmurû mala amǝ Yahudi ka, sǝ acemǝnana gbal mǝno yì ɓembe ka nda a bania tù ka, à tsǝk lú Yesu aɓalǝi.<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">Lo mala Yesu a ɓembe nǝ yilǝmu</para>
  <para style="r">(<ref loc="MAT 28:1-8">Matiu 28:1-8</ref>; <ref loc="MRK 16:1-8">Markus 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />Anzǝm pwari Sabbat nǝ tadǝmbari ɗiɗyal, ban na mbul-mbul più, Maryamu Ɓwama Magdala wari a ɓembe, sǝ kya sǝni ka tali mǝnana à girna kun ɓembe nǝi ka, à gǝshini. <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />Pǝlǝa nyar nǝ mire aban ká aban Shiman Bitǝrus andǝ ɓe lagga, mǝnana Yesu kǝ earce kǝ̀rkǝ́r ka, sǝ banggia wia ama, &lt;&lt;À pusǝna Mǝtala sǝm Yesu a ɓembe, sǝ sǝm súrǝ̀ ban mǝnana à wari nǝi kam ngga ɗang!&gt;&gt;<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />Pǝlǝa Bitǝrus andǝ mǝno yì ɓe lagga ka, à puro à dǝshi ɓembe. <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />Yia kǝm ngga à nda aban ká nǝ mire, sǝ mǝno yì ɓe lagga ka ɓangŋa aki Bitǝrus dǝmba yi bik ban ɓembe. <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />Pǝlǝa dili muri a kun ɓembe, sǝn anggubyau-múr lú aɓa ɓembe sǝ kútí ɗang. <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />Lang Shiman Bitǝrus yiu nǝnzǝ́mò ka, kara kútí nǝ kútiô aɓa ɓembe. Yì gbal ka kǝ anggubyau-múr lú nda sǝn ngga, <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />sǝ nggurbyau mǝnana à marǝkina ɓamur Yesu nǝi ka, pà aban acili anggurbyau mǝnana à tsǝ̀ngŋǝ̀nàban Yesu nǝia ka ɗàng; male ka à kàrrì à nongsǝi ɗàng. <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />Sǝ lagga mǝnana akdǝmba ɓangŋa yiu a kún ɓembe ka, kútí gbal aɓa ɓembe; sǝn agir nì kat, sǝ ear ama mǝsǝcau na, Yesu longŋǝni ɓembe. <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />Kaniama gìr mǝnia ka nǝ̀ yia kumban ngga, yìa ka, à bwalta cau mala Malǝmce mala Ɓakuli mǝnana bang ama, Yesu nǝ̀ loapi ɓembe nǝ yilǝmu ka ɗàng. <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />Pǝlǝa alaggana mǝno nyare à o a la.<verse eid="JHN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />Sǝ Maryamu ka came a nza a kún ɓembe aban ɓuá. Nǝ́ ɓuá a kúni, sǝ dìlì múrí nǝ̀ sǝn ɓá ɓembe. <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />Kara sǝn amǝturonjar mala Ɓakuli ɓari nǝ agir-pwasǝa arǝia, aban do, aban mǝnana à nongsǝ lú Yesu kàm ɗiɗyal ka. Mwashat ka do nǝ ban ɓamúrí, sǝ ɓè mǝnia mwashat ka nda a bu ban akusǝi. <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />Sǝ à ɗì Maryamu ama, &lt;&lt;Ɓwama, mana pur arǝò sǝ a kǝ ɓua le?&gt;&gt;</para>
  <para style="p" vid="JHN 20:13">Pǝlǝa Maryamu earia wia ama, &lt;&lt;Aɓwana twalna Mǝtalem à umna nǝi, sǝ ǝn súrǝ̀ ban mǝnana à tsǝì kàm ngga ɗàng!&gt;&gt;<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />Sǝ pǝlǝ rǝì, nǝ̀ u ka, kara sǝn Yesu aban came a baní, sǝ sǝlǝ ama Yesu na ɗang. <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />Pǝlǝa Yesu ɗì ama, <char style="wj">&lt;&lt;Ɓwama, mana pur arǝò sǝ a kǝ ɓua? Yana ɗe a alkite?&gt;&gt;</char></para>
  <para style="p" vid="JHN 20:15">Maryamu kǝ sǝni kǝla yì ka, mǝtala ɓaban na, pǝlǝa ne wi ama, &lt;&lt;Ɓwamǝgule, ɓǝ̀ a nda a twali ka, banggàm ban mǝnana a tsǝì kàm ngga, ace mǝnana ɓǝ̀n kyane ɓǝ̀n kya twali ka.&gt;&gt;<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />Pǝlǝa Yesu tunǝi nǝ lùllǝì ama, <char style="wj">&lt;&lt;Maryamu!&gt;&gt;</char></para>
  <para style="p" vid="JHN 20:16">Pǝlǝa pǝlǝ rǝì a baní sǝ na ama, &lt;&lt;Rabbonai!&gt;&gt; (Mǝnia nǝ kun Ibǝru ka nda &lt;&lt;Malǝm.&gt;&gt;)<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />Yesu ne wi ama, <char style="wj">&lt;&lt;Ce a kúr a rǝàm ɗàng, acemǝnana ǝn malaká nyare aban Tárrám a kùli peatu ɗàng. Ado ka, kyane aban amǝ'eambǝam, alaggana mem, kya banggia wia ama, Mǝ ndo mǝ nǝ nyare aban Tárrám, mǝnana nda Tárrià ka, aban Ɓakuli mem, mǝnana nda Ɓakuli malea ka.&gt;&gt;</char><verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />Anggo sǝ Maryamu Ɓwama Magdala wario kya kum alaggana mala Yesu sǝ banggia wia ama, &lt;&lt;Ən sǝnǝna Mǝtalabangŋo Yesu!&gt;&gt; Pǝlǝa banggia wia cau mǝnana Yesu banggi wi ka.<verse eid="JHN 20:18" /></para>
  <para style="s">Yesu pusǝrǝi aban alaggana male</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matiu 28:16-20</ref>; <ref loc="MRK 16:14-18">Markus 16:14-18</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />Nǝ pwarikpǝra a mǝno yì pwari a nzǝm pwari Sabbat ka, alaggana mala Yesu nda atārǝia aɓa kurǝm. À girki akunkurǝm acemǝnana à kǝ ɓanggi aɓwana-mǝgule mala amǝ Yahudi. Ɓālǝia ama nǝ̀ kasǝ ka, kara à sǝn Yesu purna, camǝna aɓalǝia, sǝ nea wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ rǝ wun pwalo.&gt;&gt;</char> <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />Lang bangŋǝna anggo ka, pǝlǝa lǝmdǝia wia anpenye mǝnana arǝ abui andǝ nkanggari ka. Alaggane lùmsǝ nǝ banɓoarnado acemǝnana à sǝnǝna Mǝtalabangŋo ka.<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />Yesu banggia wia ɗǝm ama, <char style="wj">&lt;&lt;Ɓǝ̀ rǝ wun pwalo. Kǝla mǝnana Tárrám túrǎm ngga, anggo gbal sǝ ǝn nggǝ túr wun.&gt;&gt;</char> <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />Pǝlǝa pyaupia wia lin'ueo amúrià sǝ na ama, <char style="wj">&lt;&lt;Wu ak Bangŋo Mǝfele.</char> <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" /><char style="wj">Ɓǝ̀ wu twali aɓwana ban acauɓikea malea ka, à twalǝnia wia banì. Sǝ ɓǝ̀ wu twalia wia banì raka, yia ka à twalia wia banì gbal ɗàng.&gt;&gt;</char><verse eid="JHN 20:23" /></para>
  <para style="s">Yesu lǝmdǝ ɓamúrì aban Toma</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />Toma, mwashat aɓalǝ alaggana lum-nong-ɓari, mǝnana à kǝ tunǝi ama Pasa ka, pa aɓalǝia, a pwari mǝno Yesu yiu abania ka ɗang. <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />Pǝlǝa aɓi alaggana banggi wi ama, &lt;&lt;Sǝm sǝnǝna Mǝtalabangŋo!&gt;&gt;</para>
  <para style="p" vid="JHN 20:25">Sǝ Toma banggia wia ama, &lt;&lt;Mim ngga pà mǝ nǝ earnǝ mǝno ka ɗàng, she ɓǝn sǝnǝna akun anpenye mala akūsà mǝnana arǝ abui, sǝ ǝn jena kun anpenye nǝ munabuam, sǝ ǝn tsǝ́ngŋǝ̀nà buam arǝ penye mǝnana a nkanggari ka.&gt;&gt;<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />Anzǝm nongŋo tongno-nong-tàrú ka, alaggana nda ɗǝm atārǝia a ɓala andǝ Toma, sǝ akunakurǝm ngga à girkinia kat; kara Yesu yi cam ɗǝm aɓalǝia sǝ bang ama, <char style="wj">&lt;&lt;Ɓǝ̀ rǝ wun pwalo.&gt;&gt;</char> <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />Pǝlǝa lǝmdǝì Toma abui sǝ ne wi ama, <char style="wj">&lt;&lt;Sǝn abuam; sǝ wu tsǝk muna-buo kani; sárǝ́ buo tsǝì arǝ penye mana a mǝsǝ nkanggariam ngga. Ɗeki ɓabum tuti mo, earnǝ cau!&gt;&gt;</char><verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />Toma pǝlǝa eari Yesu ama, &lt;&lt;Mǝtalem andǝ Ɓakuli mem!&gt;&gt;<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />Yesu pǝlǝa ne wi ama, <char style="wj">&lt;&lt;Nda acemǝnana a sǝnǝnam ngga, sǝ a nǝ earnǝ mim le? Aɓwana mǝnana à sǝnam raka, sǝ à ak cau mem nǝ ɓabumia kat ka, à ndanǝ tsǝkbu mala Ɓakuli!&gt;&gt;</char><verse eid="JHN 20:29" /></para>
  <para style="s">Gir mǝnana tsǝa sǝ à gilǝ <optbreak /> mǝnia yì malǝmce ka</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />Yesu pakki aɓea agir-ndǝlǝki pas a mǝsǝ alaggana male, mǝnana à gilǝia aɓa malǝmce mǝnia raka. <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />Sǝ amǝnia à gilǝia ka, nda ace mǝnana ɓǝ̀ wu earnǝi ama Yesu nda Kǝrǝsti, Mǝ'amsǝban, Muna mala Ɓakuli; sǝ aɓa paɓamuru ma'wun a baní ka, wu nǝ̀ kum yilǝmu aɓa rǝcandǝa mala lùllǝì.<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">Yesu pusǝrǝi aban alaggana <optbreak /> male a Galili</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />Nǝ nzǝ́mò ka, Yesu nyar ɗǝm pusǝrǝi a ban alaggana male a kun Garang Tiberiya. Ani sǝ gir nî pa. <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />Shiman Bitǝrus, sǝ Toma mǝnana à tunǝki ama Pasa ka, andǝ Nataniyel ɓwa Kana mala Galili, andǝ amuna-burana mala Zabadi, andǝ aɓea alaggana mala Yesu ɓari, à nda atārǝia kat. <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />Pǝlǝa Shiman Bitǝrus banggi aɓi ama, &lt;&lt;Mim ngga mǝ ndo mǝ nǝ o a taula.&gt;&gt;</para>
  <para style="p" vid="JHN 21:3">Sǝ aɓi banggi wi gbal ama, &lt;&lt;Sǝm nǝ̀ ká atò.&gt;&gt; Pǝlǝa yia kat à eauwe a waru malea aban ká taula. Sǝ a bu du mǝno ka à bwal kǝgìr ɗang.<verse eid="JHN 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4" />Ban kwarǝna, pwari nǝ̀ nggǝ eau ka, Yesu yiu yi came a kun mur sǝ yia alaggana ka à sǝlǝ ama Yesu na ɗang. <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />Pǝlǝa tunǝban ɗia ama, <char style="wj">&lt;&lt;Wun alaggana, wu bwal kǝ nji le?&gt;&gt;</char></para>
  <para style="p" vid="JHN 21:5">À ear ama, &lt;&lt;Awo!&gt;&gt;<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />Pǝlǝa Yesu banggia wia ama, <char style="wj">&lt;&lt;Wu túr ndámbú ma'wun atà bu mǝlì mala waru, wu nǝ̀ bwal nji!&gt;&gt;</char> Pǝlǝa à túr ndámbú a mùr sǝ à bwal nji kǝ̀rkǝ́r, yàle à gandǝ nun ndámbú, à eamsǝi aɓa waru ɗang, acemǝnana anji làkkì pas aɓa ndámbú.<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />Sǝ lagga mǝnana Yesu earkiyi ace raka ne Bitǝrus ama, &lt;&lt;Mǝtalabangŋo na!&gt;&gt; Lang Shiman Bitǝrus oè ama Mǝtalabangŋo na ka, kara twal daura male mǝnana swárí sǝ kútí a túró ka, oasǝi arǝì, tǎ zurro a mùr sǝ oakio aban ká a kún mùr. <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />Acili alaggana ueo aɓa waru aban nungi ndámbú mǝnana lùmsǝ nǝ nji ka, aban ká a nza. Ban mǝnana waru nda kam aɓa mùr ka sau nǝ nza ɗàng; sauwa male nda kǝla kusǝu gbǝman-tàrú.<verse eid="JHN 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 21:9" />Lang à nǝ̀ yia eau a nza ka, à sǝn nkalang bǝsa aban earke nǝ anji-twana amurí andǝ bǝredi a banì. <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />Yesu banggia wia ama, &lt;&lt;Wu yiu nǝ aɓea anji aɓalǝ amǝnana wu bwal adyan ngga.&gt;&gt;<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />Pǝlǝa Shiman Bitǝrus eauwe aɓa waru sǝ kya nun ndámbú eamsǝi a kún nza. Ndámbú lùmsǝ nǝ anji mǝgulke gbǝman-nǝ-lumi-tongno nǝ mǝsǝì tàrú (153), sǝ kat andǝ làkkì mala anji mǝno ka, ko bǝti ndámbú san ɗàng. <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />Yesu pǝlǝa tunǝia ama, <char style="wj">&lt;&lt;Wu yiu wu lìli!&gt;&gt;</char> Sǝ kǝɓwa pà kàm atà alaggana male, mǝnana gandǝ ɗî ama, a nda yana le ka ɗàng, acemǝnana yia kat ka, à sǝlǝna ama Mǝtalabangŋo na. <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />Pǝlǝa Yesu twal bǝredi pea wia, anggo gbal sǝ pang nǝ anji.<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />Mǝnia ka nda tàruià pusǝrǝu mala Yesu a ban alaggana male anzǝm loapi ɓembe male.<verse eid="JHN 21:14" /></para>
  <para style="s">Yesu andǝ Bitǝrus</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />Anzǝm mǝnana à lina girlina ka, Yesu pǝlǝa ɗì Shiman Bitǝrus ama, <char style="wj">&lt;&lt;Shiman muna mala Yohana, a earcem kútì amǝnia ka le?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="fq" closed="false">a earcem kútì amǝnia ka le: </char><char style="ft" closed="false">Ko &lt;&lt;a earcem amur agir mǝnia ka le?&gt;&gt;</char></note></para>
  <para style="p" vid="JHN 21:15">Bitǝrus eare ama, <char style="wj">&lt;&lt;E, Mǝtalabangŋo, a sǝlǝna ama ǝn nggǝ earceo.&gt;&gt;</char></para>
  <para style="p" vid="JHN 21:15">Yesu banggi wi ama, <char style="wj">&lt;&lt;Ɗenyi nǝ amuna-nzur mem.&gt;&gt;</char><verse eid="JHN 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16" />Yesu ɗì ɗǝm ama, <char style="wj">&lt;&lt;Shiman muna mala Yohana, a earcem le?&gt;&gt;</char></para>
  <para style="p" vid="JHN 21:16">Shiman ama, &lt;&lt;E, Mǝtalabangŋo, a sǝlǝna ama ǝn nggǝ earceo.&gt;&gt;</para>
  <para style="p" vid="JHN 21:16">Yesu ne wi ama, <char style="wj">&lt;&lt;Tsǝkir anzur mem.&gt;&gt;</char> <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />Yesu nyare ɗì Shiman Bitǝrus tàruià ɗiban ɗǝm ama, <char style="wj">&lt;&lt;Shiman muna mala Yohana, a kǝ earcem le?&gt;&gt;</char></para>
  <para style="p" vid="JHN 21:17">Bum Bitǝrus kìɗìkì nǝ mǝnia yì tàruià ɗiban ngga. Nda sǝ ne Yesu ama, &lt;&lt;Mǝtalabangŋo, a súrǝ̀ agir kat. A sǝlǝna ama mim ngga ǝn nggǝ earceo!&gt;&gt;</para>
  <para style="p" vid="JHN 21:17">Pǝlǝa Yesu banggi wi ama, <char style="wj">&lt;&lt;Tsǝkir anzur mem.</char> <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" /><char style="wj">Mǝ nda ban banggo mǝsǝcau: mǝnana a kǝ long-nǝ-lo ka, a kǝ gandǝ oasǝ agir a rǝo sǝ a kǝ wari a ban mǝnana kat a earce a nǝ ká kàm ngga. Sǝ ɓǝ̀ a enà ka, a nǝ sárǝ́ abuo, sǝ aɓea ɓwana ɗàng nda à nǝ̀ oasǝo agir a rǝò, sǝ à nǝ̀ ká nǝ we, a ban mǝnana a earce ká kàm raka.&gt;&gt;</char><verse eid="JHN 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 21:19" />Yesu na anggo ace mǝnana ɓǝ̀ lǝmdǝ ulang njar mǝnana Bitǝrus nǝ̀ wù nǝi ka, mǝnana nǝ̀ gusǝlǝ lullǝ Ɓakuli ka. Pǝlǝa Yesu ne wi ama, <char style="wj">&lt;&lt;Yiu atàm.&gt;&gt;</char><verse eid="JHN 21:19" /></para>
  <para style="s">Yesu andǝ lagga mana <optbreak /> earkiyi ce ka</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />Bitǝrus pǝlǝ rǝì sǝ sǝn lagga mǝnana Yesu earkiyi ace raka a nzǝmia, aban yiu ateà. Yì nda kǝ lagga mǝnana eangnǝ arǝ Yesu a masǝlǝata ligirlina malea, sǝ ɗìkiyi Yesu ama, &lt;&lt;Mǝtalabangŋo, yana ɓwe na nǝ̀ meo ka?&gt;&gt; <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />Lang Bitǝrus nǝ̀ sǝni ka, pǝlǝa ɗì Yesu ama, &lt;&lt;Mǝtalabangŋo, sǝ lagga man ngga, mana nǝ̀ kumi?&gt;&gt;<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />Yesu eari wi ama, <char style="wj">&lt;&lt;Ɓǝ̀ ǝn eare nǝma yì ka, ɓǝ̀ do nǝ yilǝmu bà nyare mem ngga, mana oasǝo aɓalǝi? We ka, kpatam!&gt;&gt;</char><verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />Kara cau akban aɓalǝ acili amǝkpata Yesu ama mǝnia yì lagga ka, pà nǝ̀ wu ɗàng. Sǝ anggo sǝ Yesu na ɗang. Yesu ka bang nǝ bang ama, &lt;&lt;Ɓǝ̀ ǝn eare nǝma yì ka, ɓǝ̀ do nǝ yilǝmu bà nyare mem ngga, mana oasǝo?&gt;&gt;<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />Mǝnia yì lagga ka nda mǝnana bang cau amur agir mǝnia, sǝ gilǝia aɓa Malǝmce ka. Sǝ sǝm sǝlǝna ama cau mǝnana na ka, mǝsǝcau na.<verse eid="JHN 21:24" /></para>
  <para style="s">Masǝlǝata cau</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />Aɓea agir ndakam pas mǝnana Yesu pea ka, yàle ɓǝà na ama, à nǝ̀ kpatea mwashat-mwashat à nǝ̀ gilǝia kat ka, ǝn nggǝ sǝni nǝma ɓanza kat ka, pà nǝ̀ gandǝ bwal amalǝmce mǝnana à nǝ̀ gilǝia ka ɗàng.<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>