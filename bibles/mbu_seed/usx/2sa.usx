<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Mbula</book>
  <para style="h">2 Samuyila</para>
  <para style="toc3">2 Sam</para>
  <para style="toc2">2 Samu</para>
  <para style="toc1">2 Samuyila</para>
  <para style="mt1">ƁARIA SAMUYILA</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">Malǝmce <char style="k">Ɓaria Samuyila </char> mǝnana nda kpata Samuyila Mǝdǝmbe ka bangcau amur acau-ɓaraɓara mala yálmúrû mala murǝm Dauda, tite a bu-nzali Yahuda a njar-kúnmur (akùré 1-4), sǝ amur nzalî puppup, kpapi andǝ Isǝrayila mǝnana a njar-nza ka (akùré 5-24). Mǝnia ka caugilǝa na mǝnana à gilǝì kǝla mǝnana kumban ngga, amur wara mǝnana Dauda war andǝ aɓimǝbura mana à nda aɓa nzali male sǝ andǝ arǝcandǝa mala abǝri-nzali ka, ace tangsǝ domurǝm male andǝ tsǝk bunomurǝm male ɓǝ̀ pangnǝ rǝcandǝa. Dauda ka à lǝmdǝi ɓwa na mǝnana ndanǝ gūliarǝu mǝlime andǝ paɓamuru aban Ɓakuli ka, sǝ ɗǝm ngga ɓwa na mǝnana gandǝnǝ nun ɓabum aɓwana male ɓǝà kùr ɓamuria arǝ kpate nǝ ɓabumia mwashat ka. Kat andǝ amani ka, à lǝmndǝ Dauda kǝla ɓwa mǝnana a ɓè pwari ka kǝ sǝn mǝsǝswatǝr ɗàng, sǝ kǝ pàkki acauɓikea mǝɓike nǝ eare male ace mǝnana nǝ̀ pàk gìr mǝnana nggūrǝì andǝ bumi earkiyice ka. Sǝama lang Natan mǝɓangnǝa mala Yahweh kumi nǝ cau mala acauɓikea male ka, Dauda ear ama mǝsǝcau pàkki acauɓikê, sǝ ak nunkiru mana Ɓakuli tasǝì ka.</para>
  <para style="ip">Do-yilǝmu mala Dauda andǝ agir mǝnana peǎ ka, ɓoarî amǝ Isǝrayila kǝ̀rkǝ́r. Sǝ mǝno tsǝa lang nzali malea yi kútí aɓa tanni arǝ anza mǝnana à yiu nǝnzǝ́mò, sǝ à earce alta ɓè murǝm ngga, à earce ɓwa mǝnana &lt;&lt;muna mala Dauda&gt;&gt; na ko &lt;&lt;mǝ'kà Dauda na&gt;&gt; ka, mǝnana nda a nggurkwar mala Dauda, sǝ nǝ̀ pàk kǝla yì ka.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Dauda yálmúr bu-nzali Yahuda <char style="ior"><ref loc="2SA 1:1-4:12">1:1--4:12</ref></char></para>
  <para style="io1">Dauda yálmúr Isǝrayila kat <char style="ior"><ref loc="2SA 5:1-24:25">5:1--24:25</ref> </char></para>
  <para style="io2">Apǝlǝa mǝdǝmbe <char style="ior"><ref loc="2SA 5:1-10:19">5:1--10:19</ref></char></para>
  <para style="io2">Dauda andǝ Batsheba <char style="ior"><ref loc="2SA 11:1-12:25">11:1--12:25</ref></char></para>
  <para style="io2">Azunggǝliban andǝ adomǝkwane <char style="ior"><ref loc="2SA 12:26-20:26">12:26--20:26</ref></char></para>
  <para style="io2">Apǝlǝa mǝ'nzǝ́moè <char style="ior"><ref loc="2SA 21:1-24:25">21:1--24:25</ref></char></para>
  <chapter number="1" style="c" sid="2SA 1" />
  <para style="s">Dauda okce lú mala Sawul</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1" />Anzǝm lú mala Sawul, lang Dauda nyàrǝ́nì wal amǝ'Amalek ka, pǝlǝa ueo a Zikǝlag nongŋo ɓari. <verse eid="2SA 1:1" /><verse number="2" style="v" sid="2SA 1:2" />A tàruia nongŋo ka, ɓè ɓwabura mǝnana pur a kàttì mala Sawul ka yiu, nǝ gìr'nggūrǝu mǝsanne arǝì nǝ tú a ɓamuri. Sǝ lang bwalǝna ban Dauda ka, ɓunno, kpa nǝ ɓamǝsǝi a nzali. <verse eid="2SA 1:2" /><verse number="3" style="v" sid="2SA 1:3" />Dauda ɗì ama, &lt;&lt;A pur nǝ kǝshe sǝ a yiu?&gt;&gt; Sǝ ɓwabure pe wi eare ama, &lt;&lt;Ən ɓwar nǝ ɓwaro aɓa kàttì mala amǝ Isǝrayila.&gt;&gt; <verse eid="2SA 1:3" /><verse number="4" style="v" sid="2SA 1:4" />Pǝlǝa Dauda ɗì ama, &lt;&lt;Lang sǝ gìrnî pǎ? Banggam.&gt;&gt; Pǝlǝa eari wi ama, &lt;&lt;Aɓwe ɓàngŋǝ́nì kun-munǝo, sǝ ɗǝm ngga pas atà aburana ka, à wuna, sǝ Sawul andǝ muna-ɓwabura male Jonatan gbal ka, à wuna.&gt;&gt; <verse eid="2SA 1:4" /><verse number="5" style="v" sid="2SA 1:5" />Dauda ɗì lagga mǝno banggiyi wi cau ka ama, &lt;&lt;Lang sǝ a sǝlǝ ama, Sawul andǝ muna-ɓwabura male Jonatan ngga à wuna?&gt;&gt; <verse eid="2SA 1:5" /><verse number="6" style="v" sid="2SA 1:6" />Laggè bang ama, &lt;&lt;Mǝ nda amúr nkono Gilbowa, sǝ ǝn yakiarǝ Sawul aban eangnǝe arǝ nkongŋo male, sǝ awaru-pǝr andǝ amǝ'pǝ̀r na tù aban yiu amurí. <verse eid="2SA 1:6" /><verse number="7" style="v" sid="2SA 1:7" />Lang pǝlǝ mǝsǝi a nzǝmi ka, sǝnam, pǝlǝa tunǝam, sǝ ǝn eari wi, nǝma, &lt;Mǝ ndya ka.&gt; <verse eid="2SA 1:7" /><verse number="8" style="v" sid="2SA 1:8" />Sǝ ɗiem ama, &lt;A nda yana?&gt; Ən eari wi nǝma, &lt;Mǝ nda ɓwa'Amalek.&gt; <verse eid="2SA 1:8" /><verse number="9" style="v" sid="2SA 1:9" />Pǝlǝa banggam ama, &lt;Yiu cam a nkanggariam sǝ wu wal-luem, acemǝnana mǝ nda aɓa tanni mǝkǝ̀rkǝ́rnì mala lú, sǝ yilǝmem malaká pur ɗàng.&gt; <verse eid="2SA 1:9" /><verse number="10" style="v" sid="2SA 1:10" />Nda ǝn cam a nkanggari sǝ ǝn wal-luí ka, acemǝnana ǝn sǝlǝna nǝma pà nǝ̀ au ɗàng anzǝm mana ɓǝ̀ kpana ka. Sǝ ǝn twal mbulan-murǝm mǝnana a ɓamúrí ka andǝ mbaga mǝnana a nggwarbui ka. À ndya ǝn yinǝì ɓwamǝgule mem nǝia ka.&gt;&gt;<verse eid="2SA 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11" />Pǝlǝa Dauda bwal nggea-daura male sannì,<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">bwal nggea-daura male sannì </char><char style="ft" closed="false">ko &lt;&lt;bumkiɗikea bwali kǝ̀rkǝ́r.&gt;&gt;</char></note> sǝ aburana mǝnana kat à nda atè ka, à pàk anggo gbal. <verse eid="2SA 1:11" /><verse number="12" style="v" sid="2SA 1:12" />À pak-bumkiɗikea, à ɓua, sǝ à gilmur ba pwarikpǝra, ace Sawul andǝ muna-ɓwabura male Jonatan, sǝ ace aɓwana mala Yahweh andǝ ɓala Isǝrayila, acemǝnana à wal-luia a kun-munǝo ka.<verse eid="2SA 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13" />Pǝlǝa Dauda ɗì lagga mǝno yinǝi wi nǝ cau ka ama, &lt;&lt;A pur a ya ban?&gt;&gt; Pǝlǝa eari wi ama, &lt;&lt;Mǝ nda muna mala ɓwa'kúnɗàngna, ɓwa'Amalek.&gt;&gt; <verse eid="2SA 1:13" /><verse number="14" style="v" sid="2SA 1:14" />Dauda banggi wi ama, &lt;&lt;Pàk lang sǝ ɓangciu pàkkô arǝ loasǝ buo ace wal-lú ɓwa mǝnana Yahweh tàrì ka ɗàng?&gt;&gt; <verse eid="2SA 1:14" /><verse number="15" style="v" sid="2SA 1:15" />Pǝlǝa Dauda tunǝ mwashat atà alaggana male, sǝ banggi wi ama, &lt;&lt;Kya wal-luí.&gt;&gt; Nda walì sǝ wù ka. <verse eid="2SA 1:15" /><verse number="16" style="v" sid="2SA 1:16" />Sǝ Dauda bang ama, &lt;&lt;Bafe mala nkiliò ɓǝ̀ ue amuro, acemǝnana we nǝ kuno sǝ a bang ama, &lt;Ən wal-lú ɓwa mala Yahweh mǝnana à ɗārǝi ka.&gt; &gt;&gt;<verse eid="2SA 1:16" /></para>
  <para style="s">Nggyal keban mala Dauda ace Sawul andǝ Jonatan</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17" />Sǝ Dauda tsǝk mǝnia yì nggyal keban ngga, sǝ keban amur Sawul andǝ muna-ɓwabura male Jonatan. <verse eid="2SA 1:17" /><verse number="18" style="v" sid="2SA 1:18" />Sǝ bang ama, ɓǝ̀ à kànî amǝ'kau mala Yahuda mǝnia yì nggyal keban mǝnana à tunǝi ama Nggyal mala Nta ka; nda kam a gilǝe aɓa Malǝmce mala Jashar:<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="fq" closed="false">Malǝmce mala Jashar: </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">Malǝmce mala Amǝ'ɓealu-pǝrapǝra.</char></note><verse eid="2SA 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19" />We Isǝrayila, amǝgulo mô amǝ'ɓoarɓwe ka, à walna-luia amur ankono mò.</para>
  <para style="q2" vid="2SA 1:19">Akanggǝrang aburana kpana!<verse eid="2SA 1:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20" />Wu kǝa nace a Gat ɗàng,</para>
  <para style="q1" vid="2SA 1:20">wu kǝa hamnǝ ce amur anjarɓala mala Ashkelon ɗàng,</para>
  <para style="q1" vid="2SA 1:20">cè amuna-mamǝna mala amǝ'Filisti pàkkiɗire,</para>
  <para style="q1" vid="2SA 1:20">cè amuna-mamǝna mala amǝ'ɗwanyi-kasǝ-ɓatau pàk-banɓoarnado.<verse eid="2SA 1:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21" />Wun ankónó mala Gilbowa, mbulo ko ncimna ɓǝkǝa nya amur wun ɗàng,</para>
  <para style="q2" vid="2SA 1:21">ko amur aɓaban ma'wun mala pusǝ mǝsǝsa ace apaɓoro ɗang.</para>
  <para style="q1" vid="2SA 1:21">Acemǝnana akàm sǝ à ɓǝsǝki antongŋo mala akanggǝrang amǝ'lwa.</para>
  <para style="q2" vid="2SA 1:21">Ntongŋo mala Sawul ka à hasǝi wi mùrú ɗàng.<verse eid="2SA 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22" />Nta mala Jonatan nyarnǝ te arǝ nkila,</para>
  <para style="q1" vid="2SA 1:22">ko arǝ mùrú-nyama mala akanggǝrang amǝ'lwa mǝnana wal-luia ka ɗàng;</para>
  <para style="q1" vid="2SA 1:22">sǝ nggeabyau mala Sawul ka nyar ɓà ɗàng.<verse eid="2SA 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23" />Sawul andǝ Jonatan ngga,</para>
  <para style="q1" vid="2SA 1:23">aɓwana earcea sǝ à pwasǝbum aɓwana.</para>
  <para style="q2" vid="2SA 1:23">Aɓa yilǝmu andǝ lú ka, à gau ɗang.</para>
  <para style="q1" vid="2SA 1:23">À kútì ankwang nǝ kaurǝa;</para>
  <para style="q1" vid="2SA 1:23">à kútì a'im nǝ rǝcandǝa.<verse eid="2SA 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24" />Wun amuna-mamǝna mala Isǝrayila, wu ɓua ace Sawul,</para>
  <para style="q2" vid="2SA 1:24">acemǝnana yì nda ɓwa mǝnana oasǝa wun agir-nggūrǝu mǝɓoarne amǝɓoarsǝne,</para>
  <para style="q2" vid="2SA 1:24">sǝ gilǝkirǝ adaura ma'wun nǝ agir-njengǝlan ngga.<verse eid="2SA 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25" />Akanggǝrang aburana kpana a ban lwa!</para>
  <para style="q1" vid="2SA 1:25">Lú Jonatan na aban nongŋo amur ankono.<verse eid="2SA 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26" />Mǝ nda aɓa bumkiɗikea aceo, mǝ'eambam Jonatan;</para>
  <para style="q1" vid="2SA 1:26">A ndanǝ ɓoaro abanam!</para>
  <para style="q1" vid="2SA 1:26">Earcearǝu mô abanam ngga gir'ndali na kǝ̀rkǝ́r,</para>
  <para style="q2" vid="2SA 1:26">kútì earban mala ɓwama.<verse eid="2SA 1:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27" />Akanggǝrang aburana kpana,</para>
  <para style="q2" vid="2SA 1:27">sǝ agirbura mala lwa uenaɓà!<verse eid="2SA 1:27" /></para>
  <chapter eid="2SA 1" />
  <chapter number="2" style="c" sid="2SA 2" />
  <para style="s">À ɗārǝ́ Dauda ɓǝ̀ duk murǝm mala Yahuda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1" />Anzǝm mǝnia ka, Dauda ɗì Yahweh ama, &lt;&lt;Mǝ kya aɓa mwashat atà alá mala Yahuda le?&gt;&gt; Sǝ Yahweh banggi wi ama, &lt;&lt;Kyane.&gt;&gt; Dauda ɗiban ama, &lt;&lt;Ake sǝ mǝ ká?&gt;&gt; Yahweh banggi wi ama, &lt;&lt;A Hebǝron.&gt;&gt; <verse eid="2SA 2:1" /><verse number="2" style="v" sid="2SA 2:2" />Pǝlǝa Dauda lo wari abanì andǝ amāmí gbal, Ahinoam ɓwama Jezǝril, andǝ Abigiyel mā-lú mala Nabal ɓwama Karmi. <verse eid="2SA 2:2" /><verse number="3" style="v" sid="2SA 2:3" />Sǝ Dauda yinǝ aburana mǝnana à nda atè ka, koyan ngga andǝ amǝ'ɓala male; sǝ à duki arǝ alá mǝnana aɓa Hebǝron ngga.<verse eid="2SA 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 2:4" />Sǝ aburana mala Yahuda yiu a Hebǝron, sǝ à ɗārǝ́ Dauda ɓǝ̀ duk murǝm amur ɓala Yahuda. Lang à banggi Dauda ama, &lt;&lt;Aburana mala Jabesh-Gilǝyat na à tsǝklú Sawul ka,&gt;&gt; <verse eid="2SA 2:4" /><verse number="5" style="v" sid="2SA 2:5" />Dauda tasǝ amǝ'na-túrbân nǝ cau aban aburana mala Jabesh-Gilǝyat ama, &lt;&lt;Ɓǝ̀ Yahweh tsǝka wun bù, ace pěmǝɓoarne mǝnia wu lǝmdǝì Sawul ɓwamǝgule ma'wun, nǝ tsǝkluí ka. <verse eid="2SA 2:5" /><verse number="6" style="v" sid="2SA 2:6" />Ado ka, ɓǝ̀ Yahweh lǝmdǝa wun earcearǝu male mǝnana kǝ gǝshi raka, andǝ domǝsǝcau male. Sǝ mim gbal ka, mǝ nǝ pàkka wun mǝɓoarne ace gìr mǝnana wu pè ka. <verse eid="2SA 2:6" /><verse number="7" style="v" sid="2SA 2:7" />Acemani ka, wu dum nǝ rǝcandǝa andǝ mǝsǝkàngkàngŋa, acemǝnana Sawul mǝtala-ɓala ma'wun ngga pàngŋǝ̀nà-lú, sǝ aɓwana mala Yahuda ɗārǝ́nam mǝ duk murǝm amúria.&gt;&gt;<verse eid="2SA 2:7" /></para>
  <para style="s">Kúnɓuàna anre ɓala mala Dauda andǝ ɓala mala Sawul</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8" />Sǝama Abǝna muna-ɓwabura mala Ner, mǝ'sàrǝ̀ban mala amǝ'lwa mala Sawul ka, twal Ishboshet muna-ɓwabura mala Sawul sǝ yinǝi a Mahanayim. <verse eid="2SA 2:8" /><verse number="9" style="v" sid="2SA 2:9" />Tsǝì duk murǝm amur abu-nzali Gilǝyat, andǝ Ashuri, andǝ Jezǝril, andǝ Ifǝrem andǝ Benjami andǝ Isǝrayila kat.<verse eid="2SA 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10" />Ishboshet muna-ɓwabura mala Sawul ka, ndanǝ apǝlǝa lumi-ine lang à tsǝì duk murǝm amur Isǝrayila ka, sǝ yì ka pàk apǝlǝa ɓari a buno-murǝm. Sǝ ɓala mala Yahuda ka, kpata Dauda. <verse eid="2SA 2:10" /><verse number="11" style="v" sid="2SA 2:11" />Sauwa mala bàkú mǝnana Dauda nda murǝm a Hebǝron amur ɓala mala Yahuda ka, apǝlǝa tongno-nong-ɓari andǝ azongŋo tongno-nong-mwashat na.<verse eid="2SA 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12" />Abǝna muna-ɓwabura mala Ner, atārǝia andǝ aburana mala Ishboshet muna-ɓwabura mala Sawul ka, à lo a Mahanayim sǝ à o a Gibiyon. <verse eid="2SA 2:12" /><verse number="13" style="v" sid="2SA 2:13" />Jowap muna-ɓwabura mala Zeruya<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">Zeruya </char><char style="ft" closed="false">ka ɓwama na, mǝ'nggaula Dauda.</char></note> andǝ aburana mala Dauda puro sǝ à kya je andǝia a guguri mǝnana a Gibiyon ngga. Nggǝsan mwashat do a buì mala guguri man, sǝ ɓè nggǝsan ngga do a nkaring mala guguri. <verse eid="2SA 2:13" /><verse number="14" style="v" sid="2SA 2:14" />Abǝna banggi Jowap ama, &lt;&lt;Ado ka, ɓǝ̀ sǝm tsǝk aɓea alaggana ma'sǝm ɓǝà pur ace munǝo, ɓwa andǝ ɓwa arǝarǝia, a ɓadǝm sǝm.&gt;&gt; Sǝ Jowap bang ama, &lt;&lt;Ɓǝ̀ à lo.&gt;&gt; <verse eid="2SA 2:14" /><verse number="15" style="v" sid="2SA 2:15" />Nda à lo, à cam-nǝ-came sǝ à ɓallia; aburana lum-nong-ɓari a buì mala Benjami andǝ Ishboshet muna-ɓwabura mala Sawul, sǝ aburana lum-nong-ɓari a buì mala Dauda. <verse eid="2SA 2:15" /><verse number="16" style="v" sid="2SA 2:16" />Koyanale ka bwal ɓì a ɓamúrí sǝ zuɓi nkanggari-bum ɓì nǝ byau male, sǝ à kpa nzali à wǔ atārǝia. Nda tsǝa sǝ mǝno yì ban a Gibiyon ngga, à tunǝi ama, Helkat-hazurim ngga.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">Helkat-hazurim </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;ɓatuli ko nzawara mala akun-byau.&gt;&gt;</char></note><verse eid="2SA 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17" />Mǝsǝ munǝo bangŋa a pwari mǝno. Aburana mala Dauda gandǝ Abǝna andǝ aburana mala Isǝrayila. <verse eid="2SA 2:17" /><verse number="18" style="v" sid="2SA 2:18" />Amuna-burana mala Zeruya tàrú, à nda abanì: Jowap, andǝ Abishai, sǝ Asahel. Asahel ka, mǝɓiki mire na kǝla mbamba a bondo. <verse eid="2SA 2:18" /><verse number="19" style="v" sid="2SA 2:19" />Asahel pǝrta Abǝna, ɓinǝ kyang atà bui-mǝli ko mǝnggare, aban pǝrte. <verse eid="2SA 2:19" /><verse number="20" style="v" sid="2SA 2:20" />Pǝlǝa Abǝna pǝlǝ mǝsǝi a nzǝmi sǝ na ama, &lt;&lt;A nda le, Asahel?&gt;&gt; Asahel ear ama, &lt;&lt;E, mǝ nda.&gt;&gt; <verse eid="2SA 2:20" /><verse number="21" style="v" sid="2SA 2:21" />Abǝna banggi wi ama, &lt;&lt;Kyang atà buo mǝlì ko mǝnggare; gbami mwashat atà alaggana, sǝ wu ak agirbura male arǝì.&gt;&gt; Sǝ Asahel ka, ɗeki pǝrte ɗàng. <verse eid="2SA 2:21" /><verse number="22" style="v" sid="2SA 2:22" />Nyare Abǝna sà'arǝ Asahel ama, &lt;&lt;Nying pǝrtam. Kǝa tsǝem ɓǝn wal-luio ɗàng. Ɓǝ̀ ǝn wal-luio ka, lang sǝ mǝ nǝ sǝn mǝ'eambo Jowap a ɓamǝsǝi?&gt;&gt; <verse eid="2SA 2:22" /><verse number="23" style="v" sid="2SA 2:23" />Sǝ Asahel ka, ɓinǝ kyangye. Nda Abǝna zuɓi a bumi nǝ tǝta nzo male ka. Nzoe kò kya pur a nzǝmi; Asahel kpa a nzali abanì sǝ wǔ a ɓadǝm Abǝna. Ɓwa mǝnana kat yiu a ban mǝnana Asahel kpa sǝ wù kam ngga, ɓwe cam gǝs.<verse eid="2SA 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24" />Sǝ Jowap andǝ Abishai ka à pyangnǝata Abǝna. Lang pwari nǝ nggǝ ká kpa ka, à bwal ban mgbangban mala Ammah, tù a ban Giya, a njar ká ɓabondo Gibiyon. <verse eid="2SA 2:24" /><verse number="25" style="v" sid="2SA 2:25" />Pǝlǝa aɓwana mala Benjami ram rǝia abanɓwáná anzǝm Abǝna, sǝ à cam amur mgbangban.<verse eid="2SA 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26" />Pǝlǝa Abǝna tunǝ Jowap sǝ ɗì ama, &lt;&lt;Dumǝna púp sǝm nǝ̀ lidǝmba nǝ wal-lú rǝarǝ sǝm le? A sǝlǝ mbak ama nǝ̀ nggá duk mǝlulle a masǝlǝate? Nǝ̀ sau lang sǝ awu nǝ sà'arǝ aɓwana mô ɓǝà nying pǝrta amǝ'eambia?&gt;&gt; <verse eid="2SA 2:26" /><verse number="27" style="v" sid="2SA 2:27" />Jowap eari wi ama, &lt;&lt;Kǝla mǝnana Ɓakuli na kam nǝyilǝmu ka, ɓǝ̀ a bangma cau man raka, mbak-kàngkàng aɓwana man pa nǝ̀ vwakibuia arǝ pǝrta amǝ'eambia ɗàng ba dǝmbari.&gt;&gt; <verse eid="2SA 2:27" /><verse number="28" style="v" sid="2SA 2:28" />Nda Jowap twang njawe, sǝ aburane kat go-gǝs; à lidǝmba nǝ pǝrta Isǝrayila, ko à munǝ ɗǝm ɗàng.<verse eid="2SA 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29" />Osso Abǝna andǝ aburana male gya nǝɓa Araba aɓa dù mǝno kat. À yàlî Nggeasala Jodan, sǝ à lidǝmba nǝ gya aɓa dǝmbari mǝno ba à yi bik Mahanayim.<verse eid="2SA 2:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30" />Lang Jowap nyarǝnì pǝrta Abǝna ka, ramba amǝ'lwa male pupup abanɓwáná. Sǝni ka, aburana mala Dauda lum-bwamdǝ-tongno-nong-ine andǝ Asahel ka, à pà kàm ɗàng. <verse eid="2SA 2:30" /><verse number="31" style="v" sid="2SA 2:31" />Sǝama aburana mala Dauda wal-lú aburana mala Benjami gbǝman-tàrú nǝ lumi-tongno-nong-mwashat mǝnana à nda atà Abǝna ka. <verse eid="2SA 2:31" /><verse number="32" style="v" sid="2SA 2:32" />Jowap andǝ aburana male twal lú Asahel sǝ à kya tsǝî a ɓembe mala tárrí a Betalami. Pǝlǝa à gya aɓa dù kat sǝ à yi bwal Hebǝron a kwaro-la-ban.<verse eid="2SA 2:32" /></para>
  <chapter eid="2SA 2" />
  <chapter number="3" style="c" sid="2SA 3" />
  <para style="m">
    <verse number="1" style="v" sid="2SA 3:1" />Munǝo mǝnana anre ɓala mala Sawul andǝ ɓala mala Dauda ka, tè sauwa. Làkkì mala aɓwana mǝnana à nda atà Dauda ka, lidǝmba nǝ gulo kǝ̀rkǝ́r, sǝ làkkì mala aɓwana mǝnana à nda atà ɓala mala Sawul ka, camarǝ amsǝa.<verse eid="2SA 3:1" /></para>
  <para style="s">Amuna-burana mǝnana à ɓǝlî Dauda a Hebǝron ngga</para>
  <para style="r">(<ref loc="1CH 3:1-4">1 Acau la Apwari 3:1-4</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 3:2" />À ɓǝlî Dauda amuna-burana a Hebǝron:</para>
  <para style="li1" vid="2SA 3:2">Muna-dǝmba male nda Amnon, nǝ bu Ahinoam, ɓwama Jezǝril;<verse eid="2SA 3:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3" />ɓaria muni nda Kileyap, nǝ bu Abigiyel,<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1SA 25:3-42">1Sam 25:3-42</ref></char>.</note> mā-lú mala Nabal, ɓwama Kamel;</para>
  <para style="li1" vid="2SA 3:3">tàruia muni nda Absalom, nǝ bu Ma'aka, ɓoarnsarile Talmai, murǝm Geshur;<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1SA 27:8">1Sam 27:8</ref>; <ref loc="2SA 13:37-38">2Sam 13:37-38</ref>; <ref loc="2SA 14:32">14:32</ref>; <ref loc="2SA 15:8">15:8</ref></char>.</note><verse eid="2SA 3:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4" />inea muni nda Adonija, nǝ bu Haggit;</para>
  <para style="li1" vid="2SA 3:4">tongnoia muni, nda Shefatiya, nǝ bu Abital;<verse eid="2SA 3:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5" />tongno-nong-mwashatia muni nda Itǝreyam, nǝ bu Eglah, mālá Dauda.</para>
  <para style="m" vid="2SA 3:5">Amuna-burana mǝnia ka, à ɓǝlî Dauda a Hebǝron.<verse eid="2SA 3:5" /></para>
  <para style="s">Abǝna o atà Dauda</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6" />Lang munǝo mǝnana anre ɓala mala Sawul andǝ ɓala mala Dauda lidǝmba ka, Abǝna camarǝ kumbi ɓamúrì rǝcandǝa kpǝm a ɓala mala Sawul. <verse eid="2SA 3:6" /><verse number="7" style="v" sid="2SA 3:7" />Sawul ɗiɗyal ka ndanǝ mā-twala mǝnana à tunǝki ama Rizpa, muna-ɓwama mala Ayah ka. Ɓè fara ka, Ishboshet banggi Abǝna ama, &lt;&lt;Ace mana, sǝ a kútí aban mā-twala mala tárrám?&gt;&gt;<verse eid="2SA 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8" />Kara Abǝna ka, bumi lul kǝ̀rkǝ́r nǝ cau mǝnana Ishboshet bang ngga. Pǝlǝa nyesǝi wi cau ama, &lt;&lt;Mǝ nda ɓamur nvwa a buì mala Yahuda le?<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">A twalam kǝla mǝ nda ɓwa mǝɓane mǝ nǝ mak wun a bù Yahuda le.</char></note> Twal a tite ba yalung, ǝn lǝmdǝ domǝsǝcau arǝ ɓala mala tarró, Sawul andǝ aɓǝla, andǝ agyajam male. Ən tasǝ wun ɓǝ̀ wu kpa a ɓabu Dauda ɗàng. Kat andǝ amani ka, a tsǝkam-cau-arǝàm mala pàk cauɓikea nǝ ɓwama mǝnia ka! <verse eid="2SA 3:8" /><verse number="9" style="v" sid="2SA 3:9" />Ɓǝ̀ Ɓakuli ɓashiam, sǝ yale ɓǝ̀ wal-luem, mim Abǝna, ɓǝ̀ ǝn pakkì Dauda gìr kǝla mǝnana Yahweh kánbi wi ama nǝ̀ pàkki wi ka, raka. <verse eid="2SA 3:9" /><verse number="10" style="v" sid="2SA 3:10" />Mǝ nǝ tusǝ domurǝm ɓǝ̀ nying ɓala mala Sawul, sǝ mǝ nǝ tamsǝkusǝ bunomurǝm mala Dauda, amur Isǝrayila andǝ Yahuda, twal a Dan aban ká Biyasheba.&gt;&gt; <verse eid="2SA 3:10" /><verse number="11" style="v" sid="2SA 3:11" />Sǝ Ishboshet ka, nyare ne Abǝna kǝ cau ɗǝm ɗang, acemǝnana ɓangciu pàkki wi arǝì.<verse eid="2SA 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12" />Pǝlǝa Abǝna tasǝa amǝ'na-túrbân ɓǝà kyanbi wi aban Dauda nǝ cau ama, &lt;&lt;Nzali ka, mala yana ɗe? Kùrcau nǝ mim, sǝ mǝ nǝ bwalo kàm, ace yinǝ Isǝrayila kat a bano.&gt;&gt;<verse eid="2SA 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13" />Pǝlǝa Dauda bang ama, &lt;&lt;Yàwá, mǝ nǝ kùrcau sǝnǝ we, sǝama, ǝn nggǝ earce gìr mwashat nǝ we: A pà wunǝ sǝn ɓamǝsǝàm ɗàng sheɓǝ̀ we, atà dǝmbe ka, a yinanǝ Mikal, muna-ɓwama mala Sawul, lang awu nǝ yiu a sǝnam ngga.&gt;&gt;<verse eid="2SA 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 3:14" />Pǝlǝa Dauda tasǝ amǝ'na-túrbân aban Ishboshet, muna-ɓwabura mala Sawul, ɓǝà banggi wi ama, &lt;&lt;Pam māmám, yì Mikal, mǝnana ǝn pur'amuri mǝ alí nǝ nggú-ɓata amǝ'Filisti gbǝman-mwashat ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1SA 18:20-25">1Sam 18:20-25</ref> </char>.</note><verse eid="2SA 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15" />Anggo, Ishboshet túrban sǝ à ak Mikal arǝ burí, Paltiyel, muna-ɓwabura mala Layish. <verse eid="2SA 3:15" /><verse number="16" style="v" sid="2SA 3:16" />Kat andǝ amani anggo ka, burí o atè, camarǝ ɓua aceì, amur njar kat aban ká ɗār a Bahurim. Pǝlǝa Abǝna banggi wi ama, &lt;&lt;Nyare o!&gt;&gt; Sǝ nyare o.<verse eid="2SA 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17" />Pǝlǝa Abǝna nacau nǝ aɓwana-mǝgule mala Isǝrayila ama, &lt;&lt;Banì sauwuna adyan, mana wu kǝ earce ama, wun nǝ̀ tsǝk Dauda ɓǝ̀ duk murǝm ma'wun ngga. <verse eid="2SA 3:17" /><verse number="18" style="v" sid="2SA 3:18" />Ado ka, wu pè wi, ɓǝ̀ duk murǝm! Yahweh ka panacau aban Dauda ama, &lt;Nǝ bu guro mem Dauda, sǝ mǝ nǝ amsǝ aɓwana mem, Isǝrayila, a bù amǝ'Filisti sǝ a bù aɓia-mǝbura kat.&gt; &gt;&gt;<verse eid="2SA 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19" />Pǝlǝa Abǝna nacau nǝ amǝ'tàu mala Benjami. Sǝ wari a Hebǝron, ace banggi Dauda gìr mǝnana kat Isǝrayila andǝ ɓala mala Benjami puppup earǝnace ama à nǝ̀ pàk ka.<verse eid="2SA 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 3:20" />Lang Abǝna andǝ aburana male lumi-ɓari atè yiu aban Dauda a Hebǝron ngga, Dauda pak girlina-nàtà ace Abǝna andǝ aburana mǝnana à yiu atè ka. <verse eid="2SA 3:20" /><verse number="21" style="v" sid="2SA 3:21" />Pǝlǝa Abǝna banggi Dauda ama, &lt;&lt;Earam, ɓǝ̀ ǝn o mǝ kya ram Isǝrayila kat, ace ɓwamǝgule mem, murǝm, ace mǝnana ɓǝà kùrcau nǝ we, sǝ ace mǝnana wu yálmúr gìr mǝnana kat ɓabumo earkice ka.&gt;&gt; Nda Dauda tasǝ Abǝna o aɓa rǝpwala ka.<verse eid="2SA 3:21" /></para>
  <para style="s">Jowap wal-lú Abǝna</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22" />Zuku ka, aburana mala Dauda andǝ Jowap nyarǝnì ban mǝnana à wari kam ace tǝlliban ngga, sǝ à yinǝ gǝna-lwa kpǝm a buia. Sǝ Abǝna ka, pà a ban Dauda a Hebǝron ɗàng, acemǝnana Dauda tasǝni, umǝna aɓa rǝpwala. <verse eid="2SA 3:22" /><verse number="23" style="v" sid="2SA 3:23" />Lang Jowap, andǝ amǝ'lwa mǝnana kat atè à yi bwalǝna ka, aɓwana banggi Jowap ama, &lt;&lt;Abǝna, muna-ɓwabura mala Ner, yiu aban murǝm, sǝ murǝm ɗekini ɓǝ̀ o, sǝ umǝna aɓa rǝpwala.&gt;&gt;<verse eid="2SA 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24" />Pǝlǝa Jowap wari aban murǝm, sǝ ɗì ama, &lt;&lt;Mana mǝnia a pê ka? Abǝna yiu a bano! Palang sǝ a ɗeki o? Sǝ ado ka nyarǝna umǝna! <verse eid="2SA 3:24" /><verse number="25" style="v" sid="2SA 3:25" />We ka, a súrǝ́nà rǝ Abǝna, muna-ɓwabura mala Ner; yiu male ka, nda ace swárkiǒ, sǝ ɓǝ̀ súrǝ̀ puro mô andǝ nyare mô, sǝ ɓǝ̀ súrǝ̀ gir mǝnana kat a pakkiyi ka.&gt;&gt;<verse eid="2SA 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26" />Jowap pǝlǝa nying ban Dauda, sǝ tasǝ amǝ'na-túrbân atà Abǝna, ama ɓǝà banggi wi ɓǝ̀ nyare. À kya kumi a ban tūli-mùr mǝnana a Sirah ka, sǝ à nyesǝì à yinǝi. (Sǝ Dauda ka, sǝlǝce gìrnî ɗàng.) <verse eid="2SA 3:26" /><verse number="27" style="v" sid="2SA 3:27" />Lang Abǝna nyarǝna yina a Hebǝron ngga, Jowap warinǝi aɓa ɓè muna kurǝm a kún nggea-là, kǝla nǝ̀ nacau nǝi, kǝ yia ɓari. Sǝ abanì ka, Jowap kara soa Abǝna nǝ byau a bumi, wal-luí, ace mbwegìr akúnì nkila mala mǝ'eambi Asahel.<verse eid="2SA 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28" />Nǝnzǝ́mò, lang Dauda okce mǝnia yì gìr ka, bang ama, &lt;&lt;Mim sǝnǝ nzali domurǝm mem, aɓadǝm Yahweh tàtǝ́k ka, bù sǝm pà aɓa cau mala sukki nkila mala Abǝna muna-ɓwabura mala Ner ɗàng. <verse eid="2SA 3:28" /><verse number="29" style="v" sid="2SA 3:29" />Ɓǝ̀ bafe mala nkila male sulǝ a ɓamur Jowap sǝ amur ɓala mala tárrí kat! Ɓǝ̀ ɓala mala Jowap ɓǝkǝa ɗwanyi ɓwa mǝnana ndanǝ penye mana mùrgìr kǝ sur kam, ko ndanǝ kwánó nggû,<note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="fq" closed="false">kwánó nggû </char><char style="ft" closed="false">ko ɓè kwánó mǝɓike mala nggū rǝu mana kǝ ak rǝ ɓwa ka.</char></note> ko muna-ɓwabura mǝnana nggilung-ɓwa na, ko mǝnana à wal-luí nǝ nggeabyau, ko kǝ paktǝla girlina ka ɗàng.&gt;&gt;<verse eid="2SA 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30" />(Jowap andǝ mǝ'eambi Abishai ka, à wal-lú Abǝna acemǝnana, yì na mǝnana wal-lú mǝ'eambia Asahel, a kun-munǝo a Gibiyon ngga.)<verse eid="2SA 3:30" /></para>
  <para style="s">Dauda ɓua-lú Abǝna</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31" />Pǝlǝa Dauda banggi Jowap andǝ aɓwana mana kat andǝi ka, ama, &lt;&lt;Wu sàngi agir-nggūrǝu ma'wun, wu oasǝ anggubyau-doatú<note caller="+" style="f"><char style="fr" closed="false">3:31 </char><char style="fq" closed="false">anggubyau-doatú </char><char style="ft" closed="false">ko &lt;&lt;asanginagìr&gt;&gt;</char></note> arǝ wun, sǝ wu ɓua aɓadǝm Abǝna.&gt;&gt; Murǝm Dauda nǝ ɓamuri ka, gya anzǝm aɓwana mana à twal kpamgbang-lú ka.<verse eid="2SA 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 3:32" />Pǝlǝa à tsǝk-lú Abǝna a Hebǝron; murǝm loasǝ gì ɓua a ɓembe mala Abǝna. Sǝ aɓwana kat ɓua Abǝna.<verse eid="2SA 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33" />Pǝlǝa murǝm tù mǝnia yì nggyal keban ngga, amur Abǝna, ama:</para>
  <para style="q1" vid="2SA 3:33">Ɓoaro ɓǝ̀ Abǝna wǔ kǝla wù mala gǝmɓwa le?<verse eid="2SA 3:33" /></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34" />À tà ka abuo ɗàng,</para>
  <para style="q2" vid="2SA 3:34">sǝ akusǝo pà aɓa nsolo ɗang.</para>
  <para style="q1" vid="2SA 3:34">Kǝla mǝnana ɓwabura nǝ̀ kpa aɓadǝm amǝ'ɓealɓikea ka, anggo sǝ a kpa.</para>
  <para style="m" vid="2SA 3:34">Aɓwe kat ɓua aceì ɗǝm.<verse eid="2SA 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35" />Pǝlǝa aɓwe yiu aban Dauda, sǝ à ɓuakiarǝi ɓǝ̀ lì girlina sǝ pwari na piu a kuli. Sǝ Dauda ka, kángìr ama, &lt;&lt;Ɓǝ̀ Ɓakuli ɓashiam, yale ɓǝ̀ wal-luem ɓǝ̀ ǝn tsǝk girlina ko ɓè kǝgir a kunam sǝ pwari kpa ka!&gt;&gt; <verse eid="2SA 3:35" /><verse number="36" style="v" sid="2SA 3:36" />Sǝ aɓwana kat falǝnǝ mǝnia ka, sǝ gìrnî pwasǝbumia. Yale koya gìr murǝm pè ka, pwasǝbum aɓwe kat. <verse eid="2SA 3:36" /><verse number="37" style="v" sid="2SA 3:37" />Nda aɓwana kat andǝ Isǝrayila kat yi bwalte, a pwari mǝno ka, ama, murǝm ngga, buì pà aɓa wal-lú Abǝna, muna-ɓwabura mala Ner ɗàng.<verse eid="2SA 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38" />Pǝlǝa murǝm banggi amǝ'túró male ama, &lt;&lt;Wu sǝlǝ mbak ama, ɓwamǝgule nggea ɓwabura mǝcandǝe kpana yalung a Isǝrayila? <verse eid="2SA 3:38" /><verse number="39" style="v" sid="2SA 3:39" />Yalung ngga, rǝàm-wukina, kat andǝ amani ama, mǝ nda murǝm mana à ɗārǝí ka. Aburana mǝnia, yià amuna mala Zeruya ka, à dupam nǝ kwanô kǝ̀rkǝ́r. Ɓǝ̀ Yahweh mbwe mǝtúró-ɓikea akúnì gìr mǝnana kārǝa arǝ ɓealɓikea male ka!&gt;&gt;<verse eid="2SA 3:39" /></para>
  <chapter eid="2SA 3" />
  <chapter number="4" style="c" sid="2SA 4" />
  <para style="s">À wal-lú Ishboshet</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1" />Lang Ishboshet, muna-ɓwabura mala Sawul ongŋǝna ama, Abǝna wuna a Hebǝron ngga, ɓabumi ɓunggio, sǝ Isǝrayila kat ka, múrí-kàrì. <verse eid="2SA 4:1" /><verse number="2" style="v" sid="2SA 4:2" />A bàkú mǝno ka, muna-ɓwabura mala Sawul, yì Ishboshet ka, ndanǝ aburana ɓari mǝnana à nda ka amǝ'sàrǝ̀ban amur anggǝsan mala amǝ'lwa ace kánǝ tǝlliban ngga. Mwashat ateà ka, lullǝi ama, Baanah, sǝ ɓè ka, lullǝi ama, Rekap; yia mǝnia ka, amuna-burana mala Rimon, ɓwa Beerot a tàu mala Benjami na. (Beerot ka à ɓalli aɓa bu-nzali Benjami, <verse eid="2SA 4:2" /><verse number="3" style="v" sid="2SA 4:3" />acemǝnana aɓwana mala Beerot ka, à ɓangŋa à nying Gittem, sǝ à yi do kǝla abǝri mǝnana à yiu ace dola ka, sǝ à nda kam ba yalung.)<verse eid="2SA 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4" />Jonatan, muna-ɓwabura mala Sawul ka, ndanǝ muna-ɓwabura, mǝnana gbakǝri arǝ akusǝi ka. Yì ka, ndanǝ apǝlǝa tongno, sǝ cau pur a Jezǝril ama à walna Sawul andǝ Jonatan a munǝo. Mǝ'iulǝe twali ɓangŋa nǝ̀ umnǝi akaurǝa, sǝama lang nda aban ɓangŋa nǝ̀ o akaurǝa ka, kara muna kpa, nda duk gbakǝre ka. Lullǝi nda Mefiboshet.<verse eid="2SA 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5" />Rekap andǝ Baanah, amuna-burana mala Rimon, ɓwa Beerot ka, à lo aban ká a ɓala mala Ishboshet. À kya bik banì nǝ pwarizǝkya, lang yì ka, ndaban nongŋo ace usǝlǝo mala pwarizǝkya ka. <verse eid="2SA 4:5" /><verse number="6" style="v" sid="2SA 4:6" />Ɓwama mǝ'yál kunɓala ka nda aban nyaulǝki mǝssa-alkama; ntulo-ayiki sǝ koa ntulo; nda Rekap andǝ mǝ'eambi yi kútí zàng ngga.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Gk: Ib </char><char style="fqa" closed="false">Pǝlǝa à kùtí aɓa ɓala, kǝla à nǝ̀ ɗàrǝ́ mǝssa-alkama, sǝ à zuɓi a bumi. Pǝlǝa Rekap andǝ mǝ'eambi Baanah, à ɓangŋa à o.</char></note><verse eid="2SA 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7" />Lang à kutina aɓa ɓala ka, à kum Ishboshet, ndaban nongŋo amur gyangŋan-nongŋo aɓa ndà-nongŋo male. À zuɓi, à wal-luí, sǝ à kasǝ ɓamúrí. Pǝlǝa à twal ɓamúrí sǝ à gingnǝi nǝ njar Araba dùkkù-dúkkú, <verse eid="2SA 4:7" /><verse number="8" style="v" sid="2SA 4:8" />sǝ à yinǝ ɓamur Ishboshet aban Dauda a Hebǝron. Sǝ à banggi murǝm ama, &lt;&lt;Ɓamur Ishboshet nia ka, yì muna-ɓwabura mala Sawul, ɓiomǝbura, mǝnana alta yilǝmo ka; Yahweh mbwenî ɓwamǝgule mem, yì murǝm akúnì, amur Sawul andǝ nggurkwar male.&gt;&gt;<verse eid="2SA 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9" />Sǝama Dauda nyesǝî Rekap andǝ mǝ'eambi Baanah, amuna-burana mala Rimon cau ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam, mǝnana akmúr yilǝmem aɓa koya tanni mana kumam ngga, <verse eid="2SA 4:9" /><verse number="10" style="v" sid="2SA 4:10" />lang ɓeɓwa yiu a Zikǝlag sǝ banggam ama, &lt;Sawul wuna ka,&gt; ɓwê twali ama, ndarǝ yinǝàm nǝ bǝsacau mǝɓoarne. Sǝama ǝn bwal ɓwenî, ǝn wal-luí. Mǝno ka, nda tangnakusǝu mana ǝn pe wi ace bǝsacau male ka! <verse eid="2SA 4:10" /><verse number="11" style="v" sid="2SA 4:11" />Sǝ acemǝnana wun aburana amǝɓealɓike, wu walna-lú mǝ'kunpwasǝa a ɓala male, sǝ amur gyangŋan-nongŋo male ka, mǝ nǝ pàkka wun gìr mǝnana ɓike-kútìbanì ka. Pà mǝ nǝ ɗice nkile a bù wun, sǝ mǝ nǝ kiɗiki wun a ɓanza re?&gt;&gt;<verse eid="2SA 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12" />Nda Dauda, pè alaggana male nzongcau, sǝ à wal-luia ka. À kasǝki abuia andǝ akusǝia, sǝ à gyarkia tù a ban guguri mǝnana a Hebǝron ngga. Sǝama ɓamur Ishboshet ka, à twali à kya tsǝî a ɓembe-ɓa-tali mala Abǝna, a Hebǝron.<verse eid="2SA 4:12" /></para>
  <chapter eid="2SA 4" />
  <chapter number="5" style="c" sid="2SA 5" />
  <para style="s">Dauda duk murǝm Isǝrayila</para>
  <para style="r">(<ref loc="1CH 11:1-3">1 Acau la Apwari 11:1-3</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1" />Pǝlǝa atau mala Isǝrayila kat yiu aban Dauda a Hebǝron, sǝ à ne wi ama, &lt;&lt;Sǝni, sǝm nda ka nkiliò andǝ nyamo. <verse eid="2SA 5:1" /><verse number="2" style="v" sid="2SA 5:2" />Ɗiɗyal mǝnana Sawul nda murǝm amur sǝm ngga, a ndà ɓwamǝgule amur amǝ'lwa mala Isǝrayila. Sǝ Yahweh banggo ama, &lt;Awu nǝ duk mǝ'yál aɓwana mem Isǝrayila, sǝ awu nǝ duk murǝm amur Isǝrayila.&gt; &gt;&gt;<verse eid="2SA 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3" />Akanó a Hebǝron Murǝm Dauda kùrcau nǝ aɓwana-mǝgule mala Isǝrayila kat a ɓadǝm Yahweh lang à yina aban murǝm ngga. À ɗārǝ́ Dauda nǝ mùrú olif ɓǝ̀ duk murǝm amur Isǝrayila. <verse eid="2SA 5:3" /><verse number="4" style="v" sid="2SA 5:4" />Dauda ka, ndanǝ apǝlǝa lumi-tàrú a ɓanza sǝ tita yálmúrû. Pàk apǝlǝa lumi-ine a buno-murǝm. <verse eid="2SA 5:4" /><verse number="5" style="v" sid="2SA 5:5" />A Hebǝron ngga pàk apǝlǝa tongno-nong-ɓari nǝ azongŋo tongno-nong-mwashat nda murǝm amur Yahuda, sǝ a Urǝshalima ka, pàk apǝlǝa lumi-tàrú nǝ mǝsǝì tàrú nda murǝm amur Isǝrayila kat andǝ Yahuda.<verse eid="2SA 5:5" /></para>
  <para style="s">Dauda lì Urǝshalima a lwa</para>
  <para style="r">(<ref loc="1CH 11:4-9">1 Acau la Apwari 11:4-9</ref>; <ref loc="1CH 14:1-2">14:1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6" />Pǝlǝa murǝm lo andǝ aburana male sǝ à wari a Urǝshalima ace kánǝ lwa arǝ amǝ'Jebus, yì aɓwana mǝnana à nda à tita do a mǝno yì là ɗiɗyal sǝ à ndakam ngga. Amǝ'Jebus sà'arǝ Dauda ama, &lt;&lt;A pà nǝ kútí kani ɗang! Nggearǝ ante andǝ gbakǝre ma'sǝm kārǝ́na à nǝ̀ mgbalio.&gt;&gt; Yia amǝ'Jebus ka à kǝ twali ama Dauda pà nǝ̀ gandǝ kútí kano nǝ̀ ak là arǝia ɗàng, nda tsǝa sǝ à bang anggo ka. <verse eid="2SA 5:6" /><verse number="7" style="v" sid="2SA 5:7" />Sǝ kat andǝ amani ka, Dauda ak ban-mǝcandǝe mala Siyona mǝnana ado à kǝ tunǝi ama Nggea-là mala Dauda ka. <verse eid="2SA 5:7" /><verse number="8" style="v" sid="2SA 5:8" />A pwari mǝno ka Dauda bang ama, &lt;&lt;Ɓwa mǝnana kat nǝ̀ kánǝ munǝo arǝ amǝ'Jebus ka, dumǝna púp nǝ̀ kàr nǝ njar-tǝta'nzali mala mùr sǝ nǝ̀ bik ban amǝno yì &lt;agbakǝre andǝ ante,&gt; mǝnana à nda ka aɓibura mala Dauda ka.&gt;&gt; Acemani ka, à bang ama, agbakǝre andǝ ante pa nǝ kùtí a <note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="fq" closed="false">ɓalae </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">ɓala mala Yahweh.</char></note>ɓalae ɗàng.<verse eid="2SA 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9" />Anggo sǝ Dauda nyesǝ ban-mǝcandǝe pǝlǝ là do male, sǝ tunǝi ama Nggea-là mala Dauda. Sǝ Dauda ɓakiaɓa kàrì banì, tite a ban Millo aban ká a ɓalǝu. <verse eid="2SA 5:9" /><verse number="10" style="v" sid="2SA 5:10" />Anggo sǝ Dauda lidǝmba nǝ gulo aɓa rǝcandǝa mala yálban, acemǝnana Yahweh Ɓakuli mǝnana Karban kat nǝ Gulo ka nda atè.<verse eid="2SA 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11" />Hiram, Murǝm mala nzali Taya tasǝ amǝ'na-túrbân aban Dauda, nǝ agbǝlang nggun-seda, andǝ amǝ'túró shàr-nggun andǝ gballi-nggun, andǝ amǝ'túró ɓun-tali ace ɓak sheran, sǝ à ɓakkî Dauda ɓala. <verse eid="2SA 5:11" /><verse number="12" style="v" sid="2SA 5:12" />Nda Dauda yi sǝlǝ ama Yahweh dumsǝni mbak-kàngkàng yì nda murǝm amur Isǝrayila, sǝ ɗǝm ngga Yahweh hangǝlina domurǝm male atàcau mala aɓwana male Isǝrayila.<verse eid="2SA 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13" />Anzǝm mǝnana Dauda tùrǝ́nǝì Hebǝron sǝ yina a Urǝshalima ka, twalki amā-twala sǝ alki amamǝna amur amǝnana ndanǝia ka, sǝ à ɓǝlî Dauda amuna-burana andǝ amuna-mamǝna amur amǝnana ndanǝia ka. <verse eid="2SA 5:13" /><verse number="14" style="v" sid="2SA 5:14" />Amǝnia ka à nda ka alullǝ amuna-burana mala Dauda mǝnana à ɓǝlia a Urǝshalima ka: Shamuwa, andǝ Shobap, andǝ Natan, andǝ Solomon, <verse eid="2SA 5:14" /><verse number="15" style="v" sid="2SA 5:15" />andǝ Ibǝhar, andǝ Elishuwa, andǝ Nefeg, andǝ Jafiya, <verse eid="2SA 5:15" /><verse number="16" style="v" sid="2SA 5:16" />andǝ Elishama, andǝ Eliyada, sǝ Elifelet.<verse eid="2SA 5:16" /></para>
  <para style="s">Dauda munǝo andǝ amǝ'Filisti</para>
  <para style="r">(<ref loc="1CH 14:8-17">1 Acau la Apwari 14:8-17</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17" />Lang amǝ'Filisti ok ama à ɗārǝ́na Dauda nda murǝm amur Isǝrayila ka, amǝ'Filisti kat o a alta Dauda ace gbamì. Sǝama Dauda okce, nda sulǝo wari aɓa kanggǝrang-ban ngga. <verse eid="2SA 5:17" /><verse number="18" style="v" sid="2SA 5:18" />Adyan ngga amǝ'Filisti yiu, sǝ à mesǝ aɓa Ɓangŋaban Refayim. <verse eid="2SA 5:18" /><verse number="19" style="v" sid="2SA 5:19" />Pǝlǝa Dauda alta nê mala Yahweh ama, &lt;&lt;Mǝ kyan nǝ munǝo arǝ amǝ'Filisti le? Awu nǝ tasǝia aɓa buam le?&gt;&gt; Sǝ Yahweh earî Dauda ama, &lt;&lt;E, kyane. Mbak-kàngkàng mǝ nǝ tasǝ amǝ'Filisti aɓa buo.&gt;&gt;<verse eid="2SA 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20" />Nda Dauda wari a Baal-perazim sǝ gandǝ amǝ'Filisti abanì; sǝ bang ama, &lt;&lt;Yahweh ar aɓalǝ aɓiam-mǝbura a ɓadǝmbam kǝla ara mala mùrɓangŋa.&gt;&gt; Acemani ka, tunǝ lullǝ banì ama Baal-perazim.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">Baal-perazim </char><char style="ft" closed="false">ngga ɓālǝi nda &lt;&lt;Ɓwamǝgule mǝnana kǝ ar ban, ko kǝ san ban ngga.&gt;&gt;</char></note> <verse eid="2SA 5:20" /><verse number="21" style="v" sid="2SA 5:21" />Amǝ'Filisti nying aɓǝ̀nzál malea a banì, sǝ Dauda andǝ aburana male pwania à umnǝia.<verse eid="2SA 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22" />Amǝ'Filisti yiu ɗǝm, sǝ à yi mesǝ aɓa Ɓangŋaban Refayim. <verse eid="2SA 5:22" /><verse number="23" style="v" sid="2SA 5:23" />Sǝ lang Dauda ɗìbancau a ban Yahweh ka, Yahweh banggi wi ama, &lt;&lt;A pa wunǝ ká arǝia [kporong] ɗàng. A kún mani ka, kàr nǝnzǝmia sǝ wu yiu arǝia nǝ ɓadǝm anggun nkǝling-kǝling. <verse eid="2SA 5:23" /><verse number="24" style="v" sid="2SA 5:24" />Sǝ lang awu nǝ ok gì gya mala twalkusǝu-anzǝmarǝia ani a ɓong anggun nkǝling-kǝling ngga, gbaratè akaurǝa, acemǝnana anggo ka, Yahweh angŋǝ́nò-dǝmba purna a ɓadǝmbo ace ká wàl amǝ'lwa mala amǝ'Filisti.&gt;&gt; <verse eid="2SA 5:24" /><verse number="25" style="v" sid="2SA 5:25" />Nda Dauda pàk gìrnî kǝla mǝnana Yahweh tsǝki wi nzongcau ka, wàl amǝ'Filisti tite a Gibiyon aban ká ɗār a Geza.<verse eid="2SA 5:25" /></para>
  <chapter eid="2SA 5" />
  <chapter number="6" style="c" sid="2SA 6" />
  <para style="s">Dauda yinǝ Akwati Kùrcau a Urǝshalima</para>
  <para style="r">(<ref loc="1CH 13:1-14">1 Acau la Apwari 13:1-14</ref>; <ref loc="1CH 15:1-16:3">15:1--16:3,43</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1" />Dauda nyare ramba aburana mala Isǝrayila mǝnana à tarkia ka kat abanɓwáná, aɓwana á-lumi-tàrú. <verse eid="2SA 6:1" /><verse number="2" style="v" sid="2SA 6:2" />Pǝlǝa Dauda lo andǝ aburana mǝnana kat à nda atè ka, sǝ à wari a Baala<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">Baala </char><char style="ft" closed="false">Mǝnia ka ɓè lullǝu na ace Kiriat-Jarim.</char></note> aɓa bu-nzali Yahuda, ace twal Akwati Kùrcau a ban mǝno, à nǝ̀ yinǝi, yì Akwati Kùrcau mala Ɓakuli, mǝnana à tunǝi nǝ Lullǝì, nggearǝ lullǝ Yahweh, Mǝtala Abangŋo, mǝnana do amur bunomurǝm a nre ka acerup amur Akwatinî ka. <verse eid="2SA 6:2" /><verse number="3" style="v" sid="2SA 6:3" />À tamsǝ Akwati Kùrcau mala Ɓakuli amur bǝsa keke-ndá sǝ à pur nǝi a ɓala mala Aminadap, mǝnana nda amur mgbangban ngga. Uzza andǝ Ahiyo, amuna-burana mala Aminadap ka à nda à kǝ gingnǝ bǝsa keke-ndê ka. <verse eid="2SA 6:3" /><verse number="4" style="v" sid="2SA 6:4" />À pur nǝi nǝ Akwati Kùrcau mala Ɓakuli amurí, a ɓala mala Aminadap, mǝnana nda amur mgbangban ngga. Ahiyo na aban gya a ɓadǝm Akwatini. <verse eid="2SA 6:4" /><verse number="5" style="v" sid="2SA 6:5" />Sǝ Dauda andǝ ɓala Isǝrayila kat ka, à ndaban pakkiɗire, à kǝ yalke aɓadǝm Yahweh, nǝ nggyal andǝ walki adànà andǝ azangŋan, andǝ akarata-bu, andǝ awassak, andǝ akpaksha.<verse eid="2SA 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6" />Sǝama lang à yina a katǝra mala Nakon ngga, ndǎ annda, pǝlǝa Uzza lǝmdǝ buì bwal Akwati Kùrcau mala Ɓakuli [ace mǝnana ɓǝkǝa kpa raka.] <verse eid="2SA 6:6" /><verse number="7" style="v" sid="2SA 6:7" />Kara bumlulla mala Yahweh earke arǝ Uzza, sǝ Ɓakuli koè túrí a nzali a banì atàcau mala mǝnia yì yàl-nzong ngga. Nda Uzza wù akǝ banì a nkanggari Akwati mala Ɓakuli ka. <verse eid="2SA 6:7" /><verse number="8" style="v" sid="2SA 6:8" />Sǝ bum Dauda lúllô ace ara mala bumlulla mala Yahweh amur Uzza; nda tunǝ lullǝ banì ama Perez Uzza,<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="fq" closed="false">Perez Uzza </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Ara arǝ Uzza.&gt;&gt;</char></note> sǝ anggo sǝ à kǝ tunǝi piu ba yalung ngga.<verse eid="2SA 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9" />Ɓangciu pàkkî Dauda arǝ Yahweh a pwari mǝno ka, sǝ bang ama, &lt;&lt;Lang sǝ Akwati mala Yahweh nǝ̀ yiu abanam?&gt;&gt; <verse eid="2SA 6:9" /><verse number="10" style="v" sid="2SA 6:10" />Dauda eare nǝ̀ yinǝ Akwati Kùrcau mala Yahweh aɓa Nggea-là mala Dauda ɗàng; a kún mani ka kàrnǝi a ɓala mala Obed-Edom ɓwa'Gitti. <verse eid="2SA 6:10" /><verse number="11" style="v" sid="2SA 6:11" />Nda Akwati Kùrcau mala Yahweh ue a ɓala mala Obed-Edom azongŋo tàrú, sǝ Yahweh tsǝkî Obed-Edom bù andǝ amǝ'ɓala male kat.<verse eid="2SA 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12" />Cau yiu aban Dauda ama, &lt;&lt;Yahweh tsǝngŋǝ́nì ɓala mala Obed-Edom bù andǝ gir mǝnana kat ndanǝi ka, atàcau mala Akwati mala Ɓakuli.&gt;&gt; Nda Dauda wario kya twal Akwati Kùrcau mala Ɓakuli a ɓala mala Obed-Edom, sǝ yinǝi a Nggea-là mala Dauda nǝ banɓoarnado ka. <verse eid="2SA 6:12" /><verse number="13" style="v" sid="2SA 6:13" />Lang aburana mana à kǝ twal Akwati mala Yahweh twalna kusǝia tongno-nong-mwashat ka, Dauda pà gir'nkila nǝ jamnda andǝ muna-ndǎ mǝ'nyane. <verse eid="2SA 6:13" /><verse number="14" style="v" sid="2SA 6:14" />Dauda oasǝ efot<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fq" closed="false">efot </char><char style="ft" closed="false">ka daura-múrɓì mala adaura-pǝris na. Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 28:4-28">Pur 28:4-28</ref>; <ref loc="1SA 2:18">1Sam 2:18</ref></char>.</note> mala nggubyau linǝn arǝì sǝ ndaban ta'nggwam nǝ rǝcandǝa male kat aɓadǝm Yahweh. <verse eid="2SA 6:14" /><verse number="15" style="v" sid="2SA 6:15" />Anggo sǝ Dauda andǝ ɓala Isǝrayila kat yinǝ Akwati mala Yahweh, nǝ ɓuà-gāwàn andǝ twang anjawe.<verse eid="2SA 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16" />Sǝ lang à ndaban kútí nǝ Akwati mala Yahweh aɓa Nggea-là mala Dauda ka, Mikal, ɓoarnsarile Sawul sǝnban a mǝsǝkurǝm. Sǝ lang sǝn Murǝm Dauda aban yalke sǝ kǝ ta'nggwam a ɓadǝm Yahweh ka, kara ɓǝsǝki Dauda a ɓabumi.<verse eid="2SA 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17" />À kùtí nǝ Akwati Kùrcau mala Yahweh sǝ à kya tamsǝi a ban male, aɓa tara mǝnana à loasǝi aceì ka; sǝ Dauda pāki apagir mala pisǝe kǝring andǝ apagir mala dotarǝu aɓadǝm Yahweh. <verse eid="2SA 6:17" /><verse number="18" style="v" sid="2SA 6:18" />Anzǝm mǝnana Dauda malna pāki apagir mala pisǝe kǝring andǝ apagir mala dotarǝu ka, tsǝkî aɓwana bù aɓa lullǝ Yahweh, Mǝtala Abangŋo. <verse eid="2SA 6:18" /><verse number="19" style="v" sid="2SA 6:19" />Sǝ gakì aɓwe kat, aɓa ɓwabundǝa mala Isǝrayila puppup, bǝredi, andǝ nyama, andǝ kyak mala dabino, andǝ kyak mala ɓǝla-anap mǝ'ime; pè koyan ngga kāmbe, aburana andǝ amamǝna kat. Anzǝm mǝno ka aɓwana mesǝ kat, sǝ koyan ngga nyar a ɓala male.<verse eid="2SA 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20" />Pǝlǝa Dauda nyare nǝ̀ ká a ɓala ace tsǝkî amǝ'ɓala male bù. Sǝama [māmí] Mikal muna-ɓwama mala Sawul puro nǝ̀ nggá kúllì, sǝ bang ama, &lt;&lt;Ɓafo yalung ngga murǝm Isǝrayila pànî ɓamúrì gulo kpana-kpana, mǝnana swár agir'nggūrǝì sǝ pur nǝ ɓarǝì aɓa ɗwanyi kǝsǝkya, a mǝsǝ aguro male, aburana andǝ amamǝna, kǝla mǝnana mwashat atà aburana mǝɓane kǝ pak ka!&gt;&gt;<verse eid="2SA 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21" />Pǝlǝa Dauda earî Mikal ama, &lt;&lt;Mǝ nda [aban ta'nggwam] aɓadǝm Yahweh, mǝnana nying tárró andǝ ɓala male kat sǝ twalam, nyesǝam mǝ duk mǝdǝmba amur Isǝrayila aɓwana mala Yahweh ka. Acemani ka, mǝ nǝ pakkiɗire aɓadǝm Yahweh. <verse eid="2SA 6:21" /><verse number="22" style="v" sid="2SA 6:22" />Mǝ nǝ tsǝk ɓamúràm aɓa kǝsǝkya mǝnana kútì mǝno ka, sǝ mǝ nǝ dum nǝ kyauwikiban a mǝsǝàm. Sǝama a mǝsǝ aguro amamǝna mǝno a bangcea ka, mǝ nǝ dum nǝ gulo!&gt;&gt; <verse eid="2SA 6:22" /><verse number="23" style="v" sid="2SA 6:23" />Nda Mikal, muna-ɓwama mala Sawul ue nkombi na aɓa do-yilǝmu male kat.<verse eid="2SA 6:23" /></para>
  <chapter eid="2SA 6" />
  <chapter number="7" style="c" sid="2SA 7" />
  <para style="s">Yahweh pàcau aban Dauda</para>
  <para style="r">(<ref loc="1CH 17:1-27">1 Acau la Apwari 17:1-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1" />Murǝm Dauda ka, Yahweh pe wi usǝlǝo, yállí arǝ aɓi-mǝbura mǝnana kat à gumbǝli ka, sǝ yi do a ɓala male. <verse eid="2SA 7:1" /><verse number="2" style="v" sid="2SA 7:2" />Pǝlǝa murǝm ne Natan mǝɓangnǝa ama, &lt;&lt;Sǝni, mǝ ndya ǝn do a ɓala mǝnana à ɓè nǝ nggun-seda<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="fq" closed="false">nggun-seda </char><char style="ft" closed="false">ko nggun mǝɓoarjami </char></note> ka, sǝ Akwati Kùrcau mala Yahweh ka nda kano aɓa tara.&gt;&gt;<verse eid="2SA 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3" />Natan earî murǝm ama, &lt;&lt;Pàk gìr mǝnana kat a ndanǝi a ɓabumo ka, acemǝnana Yahweh na atò.&gt;&gt;<verse eid="2SA 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4" />Sǝama àkǝ̀ dù mǝno ka Yahweh ne Natan ama:<verse eid="2SA 7:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="2SA 7:5" />&lt;&lt;Kyane kya ne guro mem Dauda ama, &lt;Mǝnia ka nda cau mala Yahweh: A nda mǝnana awu nǝ ɓakkam ɓala mǝ duk kam ngga le? <verse eid="2SA 7:5" /><verse number="6" style="v" sid="2SA 7:6" />Twal a pwarian mǝnana ǝn pusǝ amǝ Isǝrayila a Masar bà yalung ngga, ǝn duk ma aɓa ɓekǝ ɓala ɗàng. Ən nggǝ turki nǝ turkio arǝ abân, aɓa gumli kǝla ban-do mem. <verse eid="2SA 7:6" /><verse number="7" style="v" sid="2SA 7:7" />Arǝ abân mǝnana kat ǝn gingnǝ amǝ Isǝrayila kat kàm ngga, ǝn ɓua nǝ kǝ ɓwa atà aɓwana-mǝgule mǝnana ǝn twalia ace yál aɓwana mem amǝ Isǝrayila ka ama, &lt;&lt;Ace mana sǝ wu ɓakkam ɓala nǝ nggun-seda raka le?&gt;&gt; &gt;<verse eid="2SA 7:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="2SA 7:8" />&lt;&lt;Acemani ka, banggi guro mem Dauda ama: &lt;Mǝnia ka nda cau mǝnana Yahweh Mǝtala Abangŋo kǝ bang ngga: Ən twalo a ban yál-agir a bondo, a ban gyata anzur andǝ ambul, sǝ ǝn nyesǝo a pǝlǝ mǝgulo amur aɓwana mem Isǝrayila. <verse eid="2SA 7:8" /><verse number="9" style="v" sid="2SA 7:9" />Ban mǝnana kat a wari kam ngga, mǝ nda atò, sǝ ǝn twalta aɓio-amǝbura kat a ɓadǝmbo. Ado ka mǝ nǝ tsǝk lullǝo nǝ̀ zǝ́kí kpǝm, kǝla mala aɓwana amǝgulke mala ɓanza. <verse eid="2SA 7:9" /><verse number="10" style="v" sid="2SA 7:10" />Mǝ nǝ kumbi aɓwana mem Isǝrayila ban-do, sǝ mǝ nǝ dumsǝia kàm, ace mǝnana ɓǝà do a nzali mǝnana malea na ka, sǝ kǝ ɓwa pà nǝ̀ zorǝia ɗǝm ɗàng. Aɓwana amǝɓealɓike pà nǝ̀ paria ɗǝm, kǝla mǝnana à pangnǝia ɗiɗyal, <verse eid="2SA 7:10" /><verse number="11" style="v" sid="2SA 7:11" />tite arǝ apǝlǝa mǝnana ǝn twal akasǝla amur aɓwana mem Isǝrayila ka ɗàng. Sǝ mǝ nǝ po usǝlǝo arǝ aɓio-amǝbura. Mim Yahweh ǝn nggǝ nô ama, nǝnggearǝam, mǝ nǝ tsǝo nggurkwar mò ɓǝ̀ duk ɓala-murǝm. <verse eid="2SA 7:11" /><verse number="12" style="v" sid="2SA 7:12" />Lang a yi wuna, à tsǝ̀ngŋǝ̀nó atà akeô ka, mǝ nǝ loasǝ mwashat atà amunio, mǝnana nǝ̀ pùr a tǝrto ka, ɓǝ̀ duk murǝm a buno mô, sǝ mǝ nǝ tsǝk domurǝm male ɓǝ̀ cam nǝ rǝcandǝa. <verse eid="2SA 7:12" /><verse number="13" style="v" sid="2SA 7:13" />Yì nda ɓwa mǝnana nǝ̀ ɓak ɓala ace lullǝam ngga. Sǝ buno-murǝm mala domurǝm male ka, mǝ nǝ kwákítè nǝ̀ cam kàngkàng, málá male pà kàm ɗàng. <verse eid="2SA 7:13" /><verse number="14" style="v" sid="2SA 7:14" />Mǝ nǝ duk tárrû abaní, sǝ yì ka nǝ̀ duk munem. Ɓǝ̀ pàk cauɓikea ka, mǝ nǝ gilǝki, mǝ nǝ kwarkiri nǝ nkamso, kǝla mǝnana koya tárrú nǝ̀ pàngnǝ muni ka. <verse eid="2SA 7:14" /><verse number="15" style="v" sid="2SA 7:15" />Sǝ pěmǝɓoarne aɓa earcearǝu mem mana kǝ dǝurǝ raka, pà nǝ̀ nyingte, kǝla mǝnana ǝn twali arǝ Sawul ka ɗàng, yì Sawul mǝnana ǝn pusǝì ace mǝnana wu duk murǝm ngga. <verse eid="2SA 7:15" /><verse number="16" style="v" sid="2SA 7:16" />Ɓala mò andǝ domurǝm mò ka, à nǝ̀ lidǝmba a ɓadǝmbam, tè pà nǝ̀ mal ɗang, sǝ buno-murǝm mò ka, nǝ̀ cam kàngkàng masǝlǝate pà kàm ɗàng.&gt; &gt;&gt;<verse eid="2SA 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17" />Natan banggi Dauda acau mǝnia ka kat kǝla mǝnana à lǝmdǝì wi aɓa sǝna mǝnia kat ka.<verse eid="2SA 7:17" /></para>
  <para style="s">Hiwi yàwá mala Dauda</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18" />Pǝlǝa Murǝm Dauda wario sǝ kya do aɓadǝm Yahweh, sǝ bang ama:</para>
  <para style="pi" vid="2SA 7:18">&lt;&lt;Mǝ nda yana, sǝ mana nda ɓala mem, mǝnana We Mǝtalabangŋo Ɓakuli, a pakki agir mǝnia kat acem ngga? <verse eid="2SA 7:18" /><verse number="19" style="v" sid="2SA 7:19" />Sǝ kat andǝ amani ka, mǝno a mǝsǝo, We Mǝtalabangŋo Ɓakuli ka, gìr mǝ kyauwe na, acemǝnana a nyare a nacau amur ɓala mem, mim guro mò, amur gìr mǝnana awu nǝ̀ pè, arǝ anza mǝnana à nǝ̀ yiu kuko ka. We Mǝtalabangŋo Ɓakuli ka a nda rǝ pangnǝ mim kǝla mǝ nda ɓeɓwa mǝgulo kǝ̀rkǝ́r. <verse eid="2SA 7:19" /><verse number="20" style="v" sid="2SA 7:20" />Mana ɗǝm mim Dauda, mǝ nǝ gandǝ banggo? A súrǝ́nà yan nda mim, guro mò, We Mǝtalabangŋo Ɓakuli. <verse eid="2SA 7:20" /><verse number="21" style="v" sid="2SA 7:21" />Nda atàcau mala pacau mò, sǝ aɓa kpata kàne mò sǝ a pàk mǝnia yì gìr mǝgule ka, ace tsǝem mim guro mò, mǝ sǝlǝce ka. <verse eid="2SA 7:21" /><verse number="22" style="v" sid="2SA 7:22" />Acemani ka, gulo ka mona, We Ɓakuli Yahweh! Kǝ ɓwa pà kàm kǝla we ɗàng, sǝ kǝ Ɓakuli pa kàm ɗàng she we, kǝla gìr mǝnana kat sǝm oè nǝ akir sǝm ngga! <verse eid="2SA 7:22" /><verse number="23" style="v" sid="2SA 7:23" />Ya nzali mala aɓwapǝndǝa na kam kǝla aɓwana mô Isǝrayila, yì nzali mwashat a ɓanza mǝnana We Ɓakuli a pur ace ká akmúria ɓǝà duk aɓwana mô, sǝ ace kumbì ɓamúrò lullǝu ka? A pàkki agir mǝgulke andǝ agir kàrmúrû acea, nǝ pǝr nzali mala aɓwapǝndǝa andǝ aɓakuli malea a ɓadǝmbia, yia aɓwana mô mǝnana a akmúria ace ɓamúrò a Masar ka.<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:32-38">Nggur 4:32-38</ref></char>.</note> <verse eid="2SA 7:23" /><verse number="24" style="v" sid="2SA 7:24" />A tamsǝ Isǝrayila kàngkàng ace ɓamúrò, ɓǝ̀ duk aɓwana mô tàtǝ́k, sǝ We Yahweh ka, a duk Ɓakuli malea.<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:7">Pur 6:7</ref>; <ref loc="DEU 26:18">Nggur 26:18</ref></char>.</note> <verse eid="2SA 7:24" /><verse number="25" style="v" sid="2SA 7:25" />Sǝ adyan ngga, We Yahweh Ɓakuli, cau mǝnana a ne amuram mim guro mò, sǝ amur ɓala mem ngga, lùmsǝì ɓǝ̀ kum came tàtǝ́k. Pè kǝla mǝnana a ne ka, <verse eid="2SA 7:25" /><verse number="26" style="v" sid="2SA 7:26" />ace mǝnana lullǝo ɓǝ̀ dum nǝ gulo tàtǝ́k ka. Sǝ aɓwana nǝ̀ bang ama, &lt;Yahweh, Mǝtala Abangŋo, nda Ɓakuli amur Isǝrayila!&gt; Sǝ ɓala mala guro mò, mim Dauda ka ɓǝ̀ lidǝmba aɓadǝmbo tàtǝ́k. <verse eid="2SA 7:26" /><verse number="27" style="v" sid="2SA 7:27" />We Yahweh, Mǝtala Abangŋo, yì Ɓakuli mala Isǝrayila ka, a lǝmdǝni abanam, mim guro mò ama, awu nǝ ɓakkâm ɓala.<note caller="+" style="f"><char style="fr" closed="false">7:27 </char><char style="fq" closed="false">awu nǝ ɓakkâm ɓala </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">awu nǝ tsǝk amunem andǝ amǝ'kem à nǝ̀ duk amurǝma.</char></note> Nda gìr mǝnana tsǝa sǝ mim guro mò ka, ǝn kum mǝsǝkàngkàngŋa mala pakhiwi a bano ani ka. <verse eid="2SA 7:27" /><verse number="28" style="v" sid="2SA 7:28" />Ado ka, We Mǝtalabangŋo Ɓakuli, a nda Ɓakuli, sǝ acau mò ka mǝsǝcau na. A panacau mala mǝnia yì gìr mǝɓoarne ka abanam, mim guro mò. <verse eid="2SA 7:28" /><verse number="29" style="v" sid="2SA 7:29" />Acemani ka, ɓǝ̀ bumo pwasǝo wu tsǝki ɓala mala guro mò bù, ace mǝnana ɓǝ̀ lidǝmba tàtǝ́k aɓadǝmbo. We Mǝtalabangŋo Ɓakuli ka, a angŋa-dǝmba a nanacau, sǝ nǝ tsǝkbu mò ka, ɓala mala guro mò nǝ̀ kum tsǝkbu tàtǝ́k.&gt;&gt;<verse eid="2SA 7:29" /></para>
  <chapter eid="2SA 7" />
  <chapter number="8" style="c" sid="2SA 8" />
  <para style="s">Alimurǝm mala Dauda a lwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">8:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1CH 18:1-17">1Acau 18:1-17</ref>; <ref loc="PSA 60">Ang 60</ref></char>.</note>Anzǝm mǝnia ka, Dauda gandǝ amǝ'Filisti a lwa, sǝ yinǝia aɓata rǝcandǝa male; sǝ ak nggea-là Meteg Ammah a ɓabù amǝ'Filisti.<verse eid="2SA 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2" />Ɗǝm ngga, Dauda gandǝ nzali Mowap a lwa. Pǝlǝa tsǝk amǝ'Mowap à nonggi a nzali a nkanggari-arǝia. Karǝki sarǝa mala nongŋo malea nǝ nggúr. Abanì ɓari aɓa gauwe tàrú mala aɓwana mǝno ka, wal-luia, sǝ nying banì mwashat nǝyilǝmu. Amǝ'Mowap duk aguro mala Dauda, sǝ à yinǝì wi nǝ agir-cemi<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">sǝ à yinǝì wi nǝ agir-cemi </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">sǝ kǝ cemia.</char></note>.<verse eid="2SA 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3" />Lang Dauda puro ace ká nyesǝ bu-nzali mǝnana a ban Nggeasala Yiufǝretis, aɓata rǝcandǝa male ka, gandǝ Hadadeza muna-ɓwabura mala Rehop, murǝm Zoba a lwa amur njar.<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">Ko: </char><char style="fqa" closed="false">Lang Hadadeza muna-ɓwabura mala Rehop, murǝm Zoba puro ace ká nyesǝ bu-nzali mǝnana a ban Nggeasala Yiufǝretis, aɓata rǝcandǝa male ka, Dauda gandǝi a lwa amur njar.</char></note> <verse eid="2SA 8:3" /><verse number="4" style="v" sid="2SA 8:4" />Dauda gbami amǝpǝr á-mwashat nǝ gbǝman-tongno-nong-ɓari (1,700) andǝ asoje-kusǝu á-lumi-ɓari (20,000) arǝ murǝm Zoba. Sǝ Dauda kasǝki amazo kusǝ apǝr mǝno kat, sǝama nying aɓea ɗǝkǝm mǝnana à nǝ̀ nggǝ ɓangnǝ awaru-pǝr gbǝman-mwashat ka (100).<verse eid="2SA 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5" />Sǝ lang amǝ'Aram mala Damaska yiu ace bwalì Hadadeza murǝm Zoba munǝo ka, Dauda wal-lú amǝ'lwa malea á-lumi-ɓari-nong-ɓari (22,000). <verse eid="2SA 8:5" /><verse number="6" style="v" sid="2SA 8:6" />Dauda tamsǝ anggǝsan mala amǝ'lwa aɓalǝ amǝ'Aram a Damaska. Amǝ'Aram duk aguro mala Dauda, sǝ à yinǝì wi nǝ agir-cemi. Yahweh pè Dauda limurǝm arǝ abân mǝnana kat wari kam ngga.<verse eid="2SA 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7" />Dauda ak atongŋo bolo-njengǝlan mǝnana à nda a bù amǝgulo mala Hadadeza ka, sǝ yinǝia a Urǝshalima. <verse eid="2SA 8:7" /><verse number="8" style="v" sid="2SA 8:8" />Ɗǝm ngga, Murǝm Dauda pwan bolo-bángŋá kpǝm a Teba andǝ Berotai, anggea-là mala Hadadeza.<verse eid="2SA 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9" />Lang Toyi murǝm Hamat ok ama Dauda gandǝna amǝ'lwa mala Hadadeza puppup ka, <verse eid="2SA 8:9" /><verse number="10" style="v" sid="2SA 8:10" />pǝlǝa tasǝ Joram muna-ɓwabura male aban Murǝm Dauda, ɓǝ̀ kya makki-wi-kûn sǝ ɓǝ̀ tsǝki wi bù ace limurǝm mǝnana kum a lwa amur Hadadeza ka. Toyi pàk anggo acemǝnana ɗiɗyal ka Hadadeza camarǝ lwa-lwa andǝ Toyi tùtù. Joram yinǝì murǝm Dauda agirtúró mǝnana à pea nǝ bolo-azǝrfa, andǝ bolo-njengǝlan, andǝ bolo-bángŋá ka a buì.<verse eid="2SA 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11" />Murǝm Dauda tàr amǝnia yì agir ka ace Yahweh, atārǝia andǝ bolo-azǝrfa andǝ bolo-njengǝlan mana ea arǝ anzali mǝnana ɓunnia ka: <verse eid="2SA 8:11" /><verse number="12" style="v" sid="2SA 8:12" />yià anggea-là mala Aram,<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="fq" closed="false">Aram </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">Edom</char></note> andǝ Mowap, andǝ amala amǝ'Amon, andǝ amǝ'Filisti, andǝ amǝ'Amalek. Tària kat andǝ agǝna-lwa mǝnana pwania arǝ Hadadeza muna-ɓwabura mala Rehop, murǝm Zoba ka.<verse eid="2SA 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13" />Lullǝ Dauda zǝ́kí, lang nyarǝni wal-lú aburana á-lum-bwamdǝ-tongno-nong-tàrú (18,000) mala amǝ'Aram<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="fq" closed="false">amǝ'Aram </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">amǝ'Edom</char></note> a Ɓangŋaban Tuɓamur ka. <verse eid="2SA 8:13" /><verse number="14" style="v" sid="2SA 8:14" />Pǝlǝa tamsǝ anggǝsan mala amǝ'lwa male a Edom, sǝ amǝ'Edom kat pǝlǝ aguro male. Yahweh pè Dauda limurǝm arǝ abân mǝnana kat wari kam ngga.<verse eid="2SA 8:14" /></para>
  <para style="s">Amǝgulo mala Dauda</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15" />Nda Dauda yálmúr Isǝrayila kat ka; sǝ pàkgìr aɓa mǝsǝcau andǝ ɓealɓoarna ace aɓwana male kat.<verse eid="2SA 8:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="2SA 8:16" />
    <note caller="+" style="f">
      <char style="fr" closed="false">8:16 </char>
      <char style="ft" closed="false">Sǝni gbal aɓa kùré 20:23-26 mala malǝmce mǝnia ka.</char>
    </note>Jowap mǝnana nggè nda Zeruya ka, nda mǝ'sàrǝ̀ban amur amǝ'lwa mala Dauda;</para>
  <para style="li1" vid="2SA 8:16">Jehoshafat muna-ɓwabura mala Ahilud nda mǝ'tsǝkacau aɓa malǝmce;<verse eid="2SA 8:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="2SA 8:17" />Zadok muna-ɓwabura mala Ahitup andǝ Ahimelek muna-ɓwabura mala Abiyata ka, à nda ka apǝris;</para>
  <para style="li1" vid="2SA 8:17">Serayia ka, mǝgilǝgir mala murǝm na;<verse eid="2SA 8:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="2SA 8:18" />Benaya muna-ɓwabura mala Jehoyada ka nda ɓwamǝgule mala amǝ'Keret andǝ amǝ'Pelet;<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="fq" closed="false">amǝ'Keret andǝ amǝ'Pelet </char><char style="ft" closed="false">ka à nda ka amǝ'yáltà murǝm.</char></note></para>
  <para style="li1" vid="2SA 8:18">sǝ amuna-burana mala Dauda ka, à nda ka apǝris.<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="fq" closed="false">apǝris </char><char style="ft" closed="false">ko amǝ'bwal-kuntúrô mala murǝm ko amǝ'tà murǝm.</char></note><verse eid="2SA 8:18" /></para>
  <chapter eid="2SA 8" />
  <chapter number="9" style="c" sid="2SA 9" />
  <para style="s">Dauda lǝmdǝì Mefiboshet pěmǝɓoarne</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1" />Pǝlǝa Dauda ɗìban ama, &lt;&lt;Kǝɓwa ueo atà amǝ'ɓala mala Sawul, mǝnana mǝ nǝ lǝmdǝì wi pěmǝɓoarne atàcau mala Jonatan ngga re?&gt;&gt;<verse eid="2SA 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2" />Adyan ngga, ɓè mǝturo-ɓala nakam a ɓala mala Sawul, lùllǝì ama <note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 16:1-4">2Sam 16:1-4</ref>; <ref loc="2SA 19:17">19:17</ref>; <ref loc="2SA 19:29">19:29</ref></char>.</note>Ziba. À tunǝi, sǝ yiu aɓadǝm Dauda. Pǝlǝa murǝm Dauda ɗì ama, &lt;&lt;A nda Ziba le?&gt;&gt;</para>
  <para style="p" vid="2SA 9:2">Ziba ear ama, &lt;&lt;E, mǝ nda, mim guro mò.&gt;&gt;<verse eid="2SA 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3" />Murǝm ɗì ama, &lt;&lt;Kǝɓwa pà kàm a ɓala mala Sawul mana ue mǝ nǝ lǝmdǝì wi pěmǝɓoarne mala Ɓakuli ka re?&gt;&gt;</para>
  <para style="p" vid="2SA 9:3">Ziba earî murǝm ama, &lt;&lt;Ɓè muna-ɓwabura mala Jonatan nakam; gbakǝre na arǝ akusǝi kǝm.&gt;&gt;<verse eid="2SA 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4" />Murǝm ɗìban ama, &lt;&lt;Ndake?&gt;&gt;</para>
  <para style="p" vid="2SA 9:4">Ziba pe wi eare ama, &lt;&lt;Nda a ɓala mala Makir muna-ɓwabura mala Ammiyel a Lo-Debar.&gt;&gt;<verse eid="2SA 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5" />Pǝlǝa murǝm Dauda túrban a ɓala mala Makir muna-ɓwabura mala Ammiyel, a Lo-Debar, sǝ à kya yinǝ Mefiboshet.<verse eid="2SA 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6" />Lang <note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2SA 16:4">2Sam 16:4</ref>; <ref loc="2SA 19:24">19:24</ref>; <ref loc="2SA 19:25">19:25</ref>; <ref loc="2SA 19:30">19:30</ref>; <ref loc="2SA 21:7">21:7</ref></char>.</note>Mefiboshet muna-ɓwabura mala Jonatan, mǝ'kà Sawul yina aban Dauda ka, yi ɓun a nzali ace pe wi gulo.</para>
  <para style="p" vid="2SA 9:6">Dauda tunǝban ama, &lt;&lt;Mefiboshet!&gt;&gt;</para>
  <para style="p" vid="2SA 9:6">Pǝlǝa Mefiboshet ear ama, &lt;&lt;Mǝ ndya ka, mim guro mò.&gt;&gt;<verse eid="2SA 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7" />Dauda ne wi ama, &lt;&lt;Ɓangciu ɓǝkǝa pakko ɗàng, acemǝnana mǝ nǝ lǝmdǝo pěmǝɓoarne atàcau mala tárró Jonatan. Mǝ nǝ nyesǝô anzali mala keò Sawul, sǝ awu nǝ̀ nggǝ ligirlina a kpamgbang-lǐ mem.&gt;&gt;<verse eid="2SA 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8" />Nda Mefiboshet nyare ɓun a nzali sǝ bang ama, &lt;&lt;Mǝ nda yana mǝnana awu nǝ̀ ɗenyinǝ mim ngga? Yì mim guro mò mǝnana ǝn kútì luna nva nǝ gulo raka.&gt;&gt;<verse eid="2SA 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9" />Pǝlǝa Dauda tunǝ Ziba, mǝtúró mala Sawul, sǝ ne wi ama, &lt;&lt;Ən pani Mefiboshet mǝ'kà mǝtala-ɓala mò agir mǝnana kat amala Sawul andǝ ɓala male na ka. <verse eid="2SA 9:9" /><verse number="10" style="v" sid="2SA 9:10" />We wunǝ amuna-burana mô, sǝ amǝ'túró-ɓala mò ka, wun nǝ̀ nggǝ rikì wi ɓaban male, sǝ wun nǝ̀ nggǝ yinǝi wi agirɓaban male, ace mǝnana ɓǝ̀ wu kúmbi muna-ɓwabura mala mǝtala-ɓala mò girlina mǝnana nǝ̀ lì ka. Sǝama Mefiboshet mǝ'kà mǝtala-ɓala mò ka, nǝ̀ nggǝ ligirlina a kpamgbang-lǐ mem koya pwari.&gt;&gt; (A bàkú mǝno ka, Ziba ndanǝ amuna-burana lum-bwamdǝ-tongno andǝ amǝ'túró-ɓala lumi-ɓari.)<verse eid="2SA 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11" />Pǝlǝa Ziba banggi murǝm ama, &lt;&lt;Mim guro mò ka, mǝ nǝ̀ pàk gìr kat kǝla mǝnana we, mǝtala-ɓala mem, yì murǝm, a nam ama mǝ pak ka.&gt;&gt; Nda Mefiboshet ligirlina a kpamgbang-lǐ mala murǝm Dauda, kǝla mwashat aɓalǝ amuna-burana mala murǝm ngga.<verse eid="2SA 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12" />Mefiboshet ndanǝ muna-ɓwabura lo-ɓwa, lùllǝì ama <note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1CH 8:34">1Acau 8:34</ref></char>.</note>Mika. Sǝ aɓwana mǝnana kat à ndanǝdo a ɓala mala Ziba ka, à duk amǝ'túró mala Mefiboshet. <verse eid="2SA 9:12" /><verse number="13" style="v" sid="2SA 9:13" />Nda Mefiboshet do a Urǝshalima, acemǝnana kǝ ligirlina a kpamgbang-lǐ mala murǝm koya pwari ka. Yì ka, gbakǝre na arǝ akusǝi kǝm.<verse eid="2SA 9:13" /></para>
  <chapter eid="2SA 9" />
  <chapter number="10" style="c" sid="2SA 10" />
  <para style="s">Dauda gandǝ amǝ'Amon andǝ amǝ'Aram a munǝo</para>
  <para style="r">(<ref loc="1CH 19:1-19">1 Acau la Apwari 19:1-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1" />Anzǝm mǝnia ka, Nahash murǝm mala amǝ'Amon paklú, sǝ Hanun muna-ɓwabura male eau a buno-murǝm. <verse eid="2SA 10:1" /><verse number="2" style="v" sid="2SA 10:2" />Pǝlǝa Dauda bang ama, &lt;&lt;Mǝ nǝ lǝmdǝì Hanun muna-ɓwabura mala <note caller="+" style="f"><char style="fr" closed="false">10:2 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1SA 11:1">1Sam 11:1</ref></char>.</note>Nahash pěmǝɓoarne kǝla mǝnana tárrí lǝmdǝam pěmǝɓoarne ka.&gt;&gt; Nda Dauda tasǝ aɓea amǝ'túró male ace giriki Hanun atàcau mala lú mala tárrí ka. Lang amǝ'túró mala Dauda yiu a nzali mala amǝ'Amon ngga, <verse eid="2SA 10:2" /><verse number="3" style="v" sid="2SA 10:3" />amǝgulo mala amǝ'Amon banggi Hanun ɓwamǝgule malea ama, &lt;&lt;A kǝ sǝni kǝla Dauda naban gusǝlǝ tárró, mǝnana tasǝ amǝgirikiban a bano ka le? Awo, Dauda tasǝia a bano ace shenzǝ nggea-là ma'sǝm andǝ pelǝki ɓālǝi, ace mǝnana ɓǝà yinǝ kpa-kiɗìkì male ka!&gt;&gt; <verse eid="2SA 10:3" /><verse number="4" style="v" sid="2SA 10:4" />Nda Hanun gbami amǝtúró mala Dauda, sǝ mwaki koyan atea ka gauwa-tsùrú mala mbotokuni. Pǝlǝa kasǝki anggea-daura malea aɓalǝu yi sulǝ a ɓunnia, sǝ tasǝia ɓǝà o.<verse eid="2SA 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5" />Lang à banggi Dauda mǝnia yì cau ka, tasǝ amǝ'na-túrbân ɓǝà kya kumia, sǝ ɓǝà banggia wia ama, &lt;&lt;Wu ue a Jeriko sheɓǝ̀ ambotokun wun twangŋǝna ka, sǝ wu nyar a là.&gt;&gt; Acemǝnana gìr mǝno à pàkkia wia ka tsǝia aɓa kǝsǝkya kǝ̀rkǝ́r.<verse eid="2SA 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6" />Lang amǝ'Amon sǝni ama à pàngŋǝ̀nà gìr mǝnana tsǝa Dauda nǝ̀ ɓinǝmǝsǝia ka, à túrban sǝ à pà boalo aban amǝ'lwa mala aɓea anzali ɓǝà yi camatea: asoje-kusǝu á-lumi-ɓari (20,000) mala amǝ'Aram mala bu-nzali Bet-Rehop andǝ amǝ'Aram mala bu-nzali Zoba, andǝ murǝm mala Ma'aka nǝ aburana á-mwashat (1,000) atè, sǝ aburana á-lum-nong-ɓari (12,000) mala bu-nzali Top.<verse eid="2SA 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7" />Lang Dauda okce ka, tasǝ Jowap andǝ amǝ'lwa puppup, yià akanggǝrang aburana, ɓǝà kya munǝo arǝia. <verse eid="2SA 10:7" /><verse number="8" style="v" sid="2SA 10:8" />Amǝ'Amon puro, sǝ à tsaɗi akunarǝia a bankutio mala kún nggea-là [Rabba] ace munǝo, sǝ amǝ'Aram mala Zoba andǝ Rehop, andǝ aburana mala Top andǝ Ma'aka ka, à twal bancame malea tarang a ɓawan.<verse eid="2SA 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9" />Lang Jowap sǝni ama nzong-kún'munǝo nakam aɓadǝmbi sǝ ɓè nakam a nzǝmi, ace yiu arǝì ka, tàrki aɓea aburana aɓalǝ aburana mǝnana à ɓoarî acili aburana kat a Isǝrayila ka, pǝlǝa tamsǝia aɓa gilǝrǝu ace tùl andǝ amǝ'Aram. <verse eid="2SA 10:9" /><verse number="10" style="v" sid="2SA 10:10" />Sǝ acili aburana ka, Jowap nyia a ɓabù mǝ'eambǝi Abishai, sǝ tamsǝia aɓa gilǝrǝu ace tùl andǝ amǝ'Amon. <verse eid="2SA 10:10" /><verse number="11" style="v" sid="2SA 10:11" />Jowap ne Abishai ama, &lt;&lt;Ɓǝ̀ amǝ'Aram kutiam nǝ rǝcandǝa ka, awu nǝ yiu ace bwalàm; sǝ ɓǝ̀ amǝ'Amon kútiǒ nǝ rǝcandǝa ka, mǝ nǝ ká ace bwalò. <verse eid="2SA 10:11" /><verse number="12" style="v" sid="2SA 10:12" />Ɓǝ̀ mǝsǝ sǝm candǝe, sǝ ɓǝ̀ sǝm munǝ nǝ mǝsǝkang-kangŋa ace aɓwana ma'sǝm, sǝ ace anggea-là mala Ɓakuli ma'sǝm! Ɓǝ̀ Yahweh pàk gìr mǝnana ɓoari wi a mǝsǝi ka.&gt;&gt;<verse eid="2SA 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13" />Nda Jowap andǝ amǝ'lwa mǝnana à nda atè ka, à sung tù ace munǝo arǝ amǝ'Aram, kara amǝ'Aram ndǝli nǝ mire aɓadǝmbi. <verse eid="2SA 10:13" /><verse number="14" style="v" sid="2SA 10:14" />Sǝ lang amǝ'Amon sǝni ama amǝ'Aram ɓangŋǝna ka, yià gbal ka à ndǝli nǝ mire aɓadǝm Abishai, sǝ à kya kutikio aɓa nggea-là malea. Pǝlǝa Jowap nyarî munǝo arǝ amǝ'Amon, sǝ yiu a Urǝshalima.<verse eid="2SA 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15" />Sǝama lang amǝ'Aram sǝnǝni ama amǝ'Isǝrayila gandǝnia ka, à nyare à ram rǝia abanɓwáná. <verse eid="2SA 10:15" /><verse number="16" style="v" sid="2SA 10:16" />Pǝlǝa Hadadeza murǝm Zoba túrban nǝ cau aban amǝ'Aram mǝnana à nda a takuli mala Nggeasala Yiufǝretis ka; sǝ à yiu a Helam; sǝ Shobak mǝ'sàrǝ̀ban mala amǝ'lwa mala Hadadeza duk múrià.<verse eid="2SA 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17" />Lang Dauda okce ka, ram Isǝrayila kat abanɓwáná, à yàlî Nggeasala Jodan, sǝ à wari a Helam. Pǝlǝa amǝ'Aram gilǝrǝia a nzong-kún'munǝo ace ká je andǝ Dauda, sǝ à soa munǝo arǝì. <verse eid="2SA 10:17" /><verse number="18" style="v" sid="2SA 10:18" />Sǝama amǝ'Aram ndǝli nǝ mire aɓadǝm Isǝrayila; sǝ Dauda wal-lú amǝkok awaru-pǝr gbǝman-tongno-nong-ɓari (700) andǝ amǝpǝr á-lumi-ine (40,000), sǝ Shobak mǝ'sàrǝ̀ban mala amǝ'lwa malea ka, à kwarí, sǝ wù abanì. <verse eid="2SA 10:18" /><verse number="19" style="v" sid="2SA 10:19" />Lang amurǝma mǝnana kat à nda aɓata Hadadeza sǝni Isǝrayila gandǝnia ka, à alta dorǝpwala nǝ Isǝrayila, sǝ à duk aguro malea. Nda ɓangciu pàkki amǝ'Aram arǝ ká bwali amǝ'Amon ɗǝm ngga.<verse eid="2SA 10:19" /></para>
  <chapter eid="2SA 10" />
  <chapter number="11" style="c" sid="2SA 11" />
  <para style="s">Cauɓikea mǝgule mǝnana Dauda pàk ka</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1" />Nǝ kún gbangŋan, a bù-pǝlǝa mǝnana amurǝma kǝ umnǝi a lwa ka, Dauda tasǝ Jowap andǝ amǝtè andǝ [amǝ'lwa mala] Isǝrayila puppup ɓǝà o a munǝo arǝ amǝ'Amon. À kya kiɗiki amǝ'Amon, sǝ à kàrì Rabba, nggea-là malea a ɓalǝu. Sǝ yì Dauda ka ue a Urǝshalima.<verse eid="2SA 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2" />A ɓè pwarikpǝra ka, Dauda loapi ban nongŋo sǝ ndaban gya a múr-kurǝm mala palta, kara sǝn ɓè ɓwama aban sussǝo. Mǝnia yì ɓwama ka ɓoarnsari kǝ̀rkǝ́r. <verse eid="2SA 11:2" /><verse number="3" style="v" sid="2SA 11:3" />Pǝlǝa Dauda túrban ɓǝà kya ɗice yana nda mǝno yì ɓwama ka. Ɓwa mǝnana à túrí ka nyare yi banggi wi ama, &lt;&lt;Ɓwame ka lùllǝì nda Basheba muna-ɓwama mala Eliyam, sǝ yì nda mālá Yuriya ɓwa'Hitti.&gt;&gt;<verse eid="2SA 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 11:4" />Pǝlǝa Dauda túr amǝ'na-túrbân ɓǝà kya yinǝi; sǝ lang ɓwame yina a palta ka, Dauda yi nong nǝi. (Mǝno yì ɓwama ka ndo kǝ mal lakɓamuru male anzǝm sukkio mala nkila bumkwana male ka.) Pǝlǝa ɓwame nyare o a ɓala male. <verse eid="2SA 11:4" /><verse number="5" style="v" sid="2SA 11:5" />Nǝnzǝ́mò lang Basheba yi sǝlǝ ama muna kpana a bumi ka, túrban ɓǝà kya banggi Dauda ama zongŋo kutini.<verse eid="2SA 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6" />Pǝlǝa Dauda túrban nǝ cau aban Jowap ama, &lt;&lt;Tàsǝâm Yuriya ɓwa'Hitti ɓǝ̀ yiu.&gt;&gt; Nda Jowap tasǝta Yuriya aban Dauda ka. <verse eid="2SA 11:6" /><verse number="7" style="v" sid="2SA 11:7" />Lang Yuriya yina aban Dauda ka, Dauda ɗi ama, &lt;&lt;Lang Jowap andǝ amǝ'lwa? Sǝ lang ká mala munǝo?&gt;&gt; <verse eid="2SA 11:7" /><verse number="8" style="v" sid="2SA 11:8" />Pǝlǝa Dauda banggi Yuriya ama, &lt;&lt;Kya a ɓala mò, sǝ wu lakki akusǝo.&gt;&gt; Nda Yuriya nying palta, sǝ murǝm tasǝban nǝ ɓoro ama ɓǝà pe wi. <verse eid="2SA 11:8" /><verse number="9" style="v" sid="2SA 11:9" />Sǝama Yuriya ka, o a ɓala male ɗàng; nongŋo a kún ɓala mala murǝm atārǝia andǝ amǝ'túró mala mǝtala-ɓala male kat. <verse eid="2SA 11:9" /><verse number="10" style="v" sid="2SA 11:10" />Lang à banggi Dauda ama Yuriya o a ɓala male raka, Dauda ɗì Yuriya ama, &lt;&lt;A nyari gya mǝsauwe adyan. Palang sǝ a wari a ɓala mò ɗàng?&gt;&gt;<verse eid="2SA 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11" />Yuriya earî Dauda ama, &lt;&lt;Akwati Kùrcau, andǝ Isǝrayila andǝ Yahuda ka, à ndaban do aɓalǝ agumli; sǝ ɓwamǝgule mem Jowap andǝ aburana mala mǝtala-ɓala mem ngga, à nda a kàttì a patal. Palang sǝ ado ka mǝ nǝ ká a ɓala mem, mǝ li sǝ mǝ nu, sǝ mǝ nong nǝ māmám? Ən kanbo nǝ yilǝmo, pà mǝ nǝ pàk gìr kǝla man ɗang!&gt;&gt;<verse eid="2SA 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12" />Pǝlǝa Dauda ne Yuriya ama, &lt;&lt;Kúndǝ nongŋo mwashat ɗǝm, sǝ lí ka mǝ nǝ nyio wu nyare.&gt;&gt; Nda Yuriya ueo a Urǝshalima a pwari mǝno andǝ pwari mǝnana anzǝm mǝno ka. <verse eid="2SA 11:12" /><verse number="13" style="v" sid="2SA 11:13" />Pǝlǝa Dauda tunǝ Yuriya ɓǝ̀ yiu ɓǝ̀ lìli sǝ ɓǝ̀ nu atè, sǝ tsǝk Yuriya mba-walì. Sǝama nǝ pwarikpǝra ka, Yuriya puro wario kya nongŋo a kala male aɓalǝ aguro mala mǝtala-ɓala male; wari a ɓala male ɗàng.<verse eid="2SA 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14" />Banfana nǝ dǝmbari ka, Dauda gilǝ cauterǝa aban ká aban Jowap sǝ pè Yuriya ɓǝ̀ kya pe wi. <verse eid="2SA 11:14" /><verse number="15" style="v" sid="2SA 11:15" />Aɓa mǝno yì cauterǝa ka, Dauda narǝ ne Jowap ama, &lt;&lt;Tasǝ Yuriya a dǝmba a kun-munǝo a ban mǝnana munǝo candǝ kam ngga. Sǝ wu nyar nǝ ta wun, wu nying Yuriya ace mǝnana ɓǝà walì ɓǝ̀ wú.&gt;&gt;<verse eid="2SA 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16" />Nda lang Jowap yinanǝ amǝ'lwa, à kárìna nggea-là Rabba ka, tasǝ Yuriya ɓǝ̀ o a buì mǝnana sǝlǝna ama a kàm sǝ akanggǝrang aburana mala aɓia-mǝbura pàk ka. <verse eid="2SA 11:16" /><verse number="17" style="v" sid="2SA 11:17" />Lang amǝ'lwa mala aɓia-mǝbura mǝnana aɓa nggea-là purna sǝ à soa munǝo arǝ Jowap ka, à wal aɓea amǝ'lwa mala Dauda. Yuriya ɓwa'Hitti ka nda atà aɓwana mǝnana à walia ka.<verse eid="2SA 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18" />Pǝlǝa Jowap tasǝban nǝ cau ɓǝà kya ne Dauda amur gìr mǝnana kat kǝ kumban a kún lwa ka. <verse eid="2SA 11:18" /><verse number="19" style="v" sid="2SA 11:19" />Sǝ banggi mǝ'na-túrbân cau ama, &lt;&lt;Anzǝm mana a malǝna banggi murǝm acau mala agir mǝnana kat à kumban ngga, <verse eid="2SA 11:19" /><verse number="20" style="v" sid="2SA 11:20" />yakǝla bum murǝm nǝ̀ lúllô sǝ nǝ̀ ɗiban ama, &lt;Palang sǝ wu gbàshìban nggea-lê nǝ munǝo? Wu sǝlǝ mbo ama à nǝ̀ túr mundi nǝ múr sheran? <verse eid="2SA 11:20" /><verse number="21" style="v" sid="2SA 11:21" />Yana wal-lú Abimelek muna-ɓwabura mala Jerubbeshet?<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="fq" closed="false">Jerubbeshet </char><char style="ft" closed="false">ka à súrǝì gbal ama </char><char style="fqa" closed="false">Jerub-ba'al </char><char style="ft" closed="false">(ko Gidiyon)</char></note> Ɓwama na mǝnana túr muna-taligo nǝ múr sheran amurí, sǝ wali wù ka re?<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JDG 9:50-54">Akas 9:50-54</ref></char>.</note> Palang sǝ wu wari tù aban sheran?&gt; Pǝlǝa awu nǝ ne wi ama, &lt;Guro mò, yì Yuriya ɓwa'Hitti gbal ka wuna.&gt; &gt;&gt;<verse eid="2SA 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22" />Nda mǝ'na-túrbân mǝno puro o, sǝ yi banggi Dauda acau mǝnana kat Jowap tasǝi ɓǝ̀ yi nea ka. <verse eid="2SA 11:22" /><verse number="23" style="v" sid="2SA 11:23" />Mǝ'na-túrbân mǝno ne Dauda ama, &lt;&lt;Bù aɓisǝm-mǝbura twalki arǝ sǝm, sǝ à pur atà sǝm a patal ace munǝo arǝ sǝm, sǝama sǝm cambia wia kàngkàng aban ká ɗār a bankutio mala kún nggea-lê. <verse eid="2SA 11:23" /><verse number="24" style="v" sid="2SA 11:24" />Pǝlǝa amǝ'nta malea túr amundi nǝ múr sheran arǝ sǝm aguro mò, sǝ aɓea aɓwana atà aburana mala murǝm wù. Guro mo, yì Yuriya ɓwa'Hitti gbal ka wuna.&gt;&gt;<verse eid="2SA 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25" />Pǝlǝa Dauda banggi mǝ'na-túrbân mǝno ama, &lt;&lt;Banggi Jowap mǝnia yì cau ka ama, &lt;Kǝa ɗeki mǝnia yì gìr kumban ngga ɓǝ̀ zurǝì ɗenyicau mò ɗàng, acemǝnana nggeabyau kǝ tàr ɓwa mǝnana nǝ̀ wal ka ɗàng. Wu lidǝmba nǝ nggiki nggea-lê nǝ munǝo, sǝ wu kiɗiki.&gt; Ɓakɓabumi nǝ amǝnia yì acau ka.&gt;&gt;<verse eid="2SA 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26" />Lang Basheba, mālá Yuriya ongŋǝna ama burí wuna ka, keban ace burí. <verse eid="2SA 11:26" /><verse number="27" style="v" sid="2SA 11:27" />Anzǝm mǝnana Basheba malǝna ɓua burí ka, Dauda twali yinǝi a ɓala male yi duk māmí, sǝ ɓǝlî wi muna-ɓwabura. Sǝama mǝnia yì gìr Dauda pè ka, kiɗikibum Yahweh.<verse eid="2SA 11:27" /></para>
  <chapter eid="2SA 11" />
  <chapter number="12" style="c" sid="2SA 12" />
  <para style="s">Ɓakuli Yahweh gim Murǝm Dauda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1" />Yahweh túr Natan mǝɓangnǝa aban Dauda. Lang Natan yina aban Dauda ka, bang ama, &lt;&lt;Aburana nakam ɓari aɓa ɓè nggea-là, mwashat ka mǝkume na sǝ ɓì ka mǝ'tǝ̀r na. <verse eid="2SA 12:1" /><verse number="2" style="v" sid="2SA 12:2" />Mǝkume ka ndanǝ andá andǝ anzur pas, <verse eid="2SA 12:2" /><verse number="3" style="v" sid="2SA 12:3" />sǝ mǝ'tǝ̀r ka pànǝ kǝgìr ɗàng she kǝ mǝ-nzur mǝnana kúrrô lǝsǝì gul andǝ amuni ka. Mǝnia yì muna-nzur ka kǝ lili aɓa kwar mǝ'mwashati andǝ mǝtale, kǝ nù mùr aɓa kwar nû mùr male, sǝ pak ka mǝtale nǝ̀ nongsǝì a byalí. Mǝnia yì muna-nzur a baní ka nda kǝla ɓoarnsarile.<verse eid="2SA 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4" />&lt;&lt;A ɓè pwari ka, bǝri yipì mǝkume a ɓala male. Mǝkume ka earce ama nǝ̀ wàl mwashat atà agirkusǝu male nǝ̀ pak girlina ace bǝri mǝnana sulǝ a baní ka ɗàng; a kún mani ka, wario kya bwal kǝ muna-nzur mwashat mala mǝ'tǝ̀r man wàlì, lambǝî bǝri male.&gt;&gt;<verse eid="2SA 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5" />Bum Dauda lul kǝ̀rkǝ́r arǝ mǝkume man. Kángìr aban Natan ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam ngga, ɓwa mǝnana pak mǝnia yì gìr ka ɓoaro ɓǝà wal-luí! <verse eid="2SA 12:5" /><verse number="6" style="v" sid="2SA 12:6" />Dumǝna púp nǝ̀ mbwekî mǝ'tǝ̀r man anzur ine a kúnì mwashat, ace mǝnia yì gìr pè ka, acemǝnana pànǝ sǝn mǝsǝswatǝr ɗàng.&gt;&gt;<verse eid="2SA 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7" />Natan ne Dauda ama, &lt;&lt;A nda kǝ ɓwe! Yahweh Ɓakuli mala Isǝrayila na ama: &lt;Ən ɗārǝo a duk murǝm amur Isǝrayila, sǝ ǝn amsǝo a ɓabù rǝcandǝa mala Sawul. <verse eid="2SA 12:7" /><verse number="8" style="v" sid="2SA 12:8" />Ən po ɓala mala mǝtala-ɓala mò andǝ amāmí aɓata yálban mò. Ən po ɓala mala Isǝrayila andǝ mala Yahuda. Sǝ ɓǝ̀ mǝnia kat ka karǝo raka, ɓǝ́n pano mǝnana kútì ka. <verse eid="2SA 12:8" /><verse number="9" style="v" sid="2SA 12:9" />Ace mana sǝ a būrǝce cau mala Yahweh, ace pàk gìr mǝnana mǝɓike na ka a mǝsǝì? A wal-lú Yuriya ɓwa'Hitti nǝ nggeabyau mala amǝ'Amon, sǝ a twal māmí ɓǝ̀ duk mô. <verse eid="2SA 12:9" /><verse number="10" style="v" sid="2SA 12:10" />Twal ado aban ká a dǝmba ka, ɓala mò pà nǝ̀ usǝlǝi lú mala aɓwana kam mǝnana à nǝ̀ walia nǝ nggeabyau ka ɗàng, acemǝnana a ɓǝsǝkiam, sǝ a twal mālá Yuriya ɓǝ̀ duk māmó.&gt;<verse eid="2SA 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11" />&lt;&lt;Yahweh bang ama: &lt;Ace man yì gìr a pe ka, Mǝ nǝ tsǝk zunggǝliban ɓǝ̀ lo arǝò a ɓala mò. Akǝ mǝsǝo Mǝ nǝ twal amāmó Mǝ nǝ pe ɓè ɓwa mǝnana nda a bano tù ka; nǝ̀ nongnǝia a ɓaɓwa bwāng. <verse eid="2SA 12:11" /><verse number="12" style="v" sid="2SA 12:12" />A pê aɓa sǝmbǝrǝa, sǝ Mim ngga, Mǝ nǝ tsǝk mǝnia yì gìr ka ɓǝ̀ yi pa nǝ pwari a kùli, a ɓamǝsǝ amǝ Isǝrayila kat.&gt; &gt;&gt;<verse eid="2SA 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13" />Pǝlǝa Dauda banggi Natan ama, &lt;&lt;Ən pangŋǝ́nì Yahweh cauɓikea.&gt;&gt;</para>
  <para style="p" vid="2SA 12:13">Sǝ Natan eari wi ama, &lt;&lt;Yahweh twalǝno banì. A pà nǝ̀ wù ɗàng. <verse eid="2SA 12:13" /><verse number="14" style="v" sid="2SA 12:14" />Sǝama acemǝnana a pakce Yahweh ɓà nǝ mǝno yì gìr a pe ka, muna mǝnana à ɓǝ̀lô ka nǝ̀ wú.&gt;&gt; <verse eid="2SA 12:14" /><verse number="15" style="v" sid="2SA 12:15" />Pǝlǝa Natan nyare o a ɓala male.</para>
  <para style="p" vid="2SA 12:15">Sǝ Yahweh tsǝk muna mǝnana mālá Yuriya ɓǝlî Dauda ka bwal nǝ rǝkwana. <verse eid="2SA 12:15" /><verse number="16" style="v" sid="2SA 12:16" />Dauda zǝmbî Yahweh ace munê. Gilmùr sǝ kya kútí a ɓala, mal dù kat ndaban nongŋo a nzali. <verse eid="2SA 12:16" /><verse number="17" style="v" sid="2SA 12:17" />Aɓwana-mǝgule mala ɓala male yiu abani ace loasǝe ɓǝ̀ loapi nzali ɓǝ̀ li girlina andǝia, sǝama ginǝe. <verse eid="2SA 12:17" /><verse number="18" style="v" sid="2SA 12:18" />A tongno-nong-ɓaria nongŋo ka, munê paklú. Ɓangciu pàkki amǝ'túró-ɓala mala Dauda arǝ banggi wi ama munê pàngŋǝ̀nà-lú, acemǝnana à pakɗenyicau ama, &lt;&lt;Lang munê ndanǝ yilǝmu piu ka, sǝm ne wi cau sǝ kwakikiri arǝ sǝm ɗàng. Lang ado sǝ sǝm nǝ̀ ne wi ama munê wuna? Earka, nǝ̀ pàkki ɓamurì gìr mǝɓane.&gt;&gt;<verse eid="2SA 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19" />Sǝama lang Dauda sǝn amǝ'túró-ɓala male naban sherǝki-acau arǝarǝia ka, yi sǝlǝ ama munê wuna. Nda Dauda ɗia ama, &lt;&lt;Mune wuna le?&gt;&gt;</para>
  <para style="p" vid="2SA 12:19">À ear ama, &lt;&lt;E, wuna.&gt;&gt;<verse eid="2SA 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20" />Pǝlǝa Dauda loapi nzali, sǝ sussǝo, hasǝ mùrú, sǝ nggaɗi agir-nggūrǝu male. Sǝ o a ɓala mala Yahweh kya peri. Osso nyare yiu a ɓala male sǝ bang ama ɓǝà pe wi girlina; à yinǝi wi nǝ girlina sǝ lìli.<verse eid="2SA 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21" />Pǝlǝa amǝ'túró-ɓala mala Dauda ɗì ama, &lt;&lt;Mana man a pàk ka? A gilmùr sǝ a pak-bumkiɗikea ace munio lang ndanǝ yilǝmu ka, sǝama lang munê wuna ka, a lo sǝ a li girlina.&gt;&gt;<verse eid="2SA 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22" />Dauda ear ama, &lt;&lt;Lang munê na nǝyilǝmu piu ka, ǝn gilmùr sǝ ǝn pak-bumkiɗikea acemǝnana ǝn pakɗenyicau ama, &lt;Yana sǝlǝa ko ear ka Yahweh nǝ̀ ɓwamuram, sǝ nǝ̀ nying munê nǝyilǝmu?&gt; <verse eid="2SA 12:22" /><verse number="23" style="v" sid="2SA 12:23" />Sǝama ado ka, munê wuna; palang sǝ mǝ nǝ gilmùr? Mǝ nǝ gandǝnǝ nyesǝ munê ɗǝm le? Mǝ nǝ ká abaní. Yì ka pà nǝ̀ nyar abanam ɗàng.&gt;&gt;<verse eid="2SA 12:23" /></para>
  <para style="s">Ɓǝlban mala Solomon</para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24" />Dauda giriki māmí Basheba, sǝ kútí abani, nong nǝi. Basheba ɓǝl muna-ɓwabura, sǝ tunǝi ama Solomon. Yahweh earce munê, <verse eid="2SA 12:24" /><verse number="25" style="v" sid="2SA 12:25" />sǝ tasǝ cau nǝban Natan mǝɓangnǝa ama ɓǝà tunǝ munê ama <note caller="+" style="f"><char style="fr" closed="false">12:25 </char><char style="fq" closed="false">Jedidia </char><char style="ft" closed="false">ka ɓālǝi nda ɓwa mana Yahweh earce ka.</char></note>Jedidia.<verse eid="2SA 12:25" /></para>
  <para style="s">Masǝlǝata lwa nǝ amǝ'Amon</para>
  <para style="r">(<ref loc="1CH 20:1-3">1 Acau la Apwari 20:1-3</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26" />Aɓa mǝno anggo ka Jowap narǝ munǝ arǝ Rabba, nggea-là mala amǝ'Amon, sǝ angŋǝna kanggǝrang-ban mala murǝm malea. <verse eid="2SA 12:26" /><verse number="27" style="v" sid="2SA 12:27" />Jowap pǝlǝa tasǝ amǝ'na-túrbân aban Dauda nǝ cau ama, &lt;&lt;Ən munǝna arǝ Rabba, sǝ ǝn angŋǝna máɗí-mùr malea arǝia. <verse eid="2SA 12:27" /><verse number="28" style="v" sid="2SA 12:28" />Ado ka, ramba acilia amǝ'lwa abanɓwáná sǝ wu gumbǝli nggea-lê wu e; ɓǝ̀ ana raka, mǝ nǝ e, sǝ à nǝ̀ tunǝi nǝ lullǝam.&gt;&gt;<verse eid="2SA 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29" />Nda Dauda ramba amǝ'lwa kat abanɓwáná, sǝ wari a Rabba, munǝ arǝ nggea-lê sǝ e ka. <verse eid="2SA 12:29" /><verse number="30" style="v" sid="2SA 12:30" />Sǝ ak mbulan-murǝm mǝnana a ɓamur murǝm<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">a ɓamur Milkom, </char><char style="ft" closed="false">ɓakuli mala amǝ'Amon; Milkom gbal ka à tunǝi ama Molek.</char></note> malea ka, sǝ à oasǝì Dauda a ɓamuri. Mbulan-murǝmì ka à pè nǝ bolo-njengǝlan sǝ à nbákí nǝ amǝsǝ tali-gǝna; dǝmbǝrya male na talent mwashat.<note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="fq" closed="false">talent mwashat </char><char style="ft" closed="false">ko tyang lumi-tàrú-nong-ine.</char></note> Dauda pwan gǝna-lwa kpǝm a nggea-lê. <verse eid="2SA 12:30" /><verse number="31" style="v" sid="2SA 12:31" />Ɗǝm ngga, Dauda pusǝ aɓwana mǝnana aɓa nggea-lê ka, sǝ tsǝia púp arǝ atúró mǝcandǝe ɓǝà pea nǝ byau zanzǝki nggun, andǝ asoro bolo-candǝa, andǝ abero bolo-candǝa. Sǝ tsǝia ɗǝm aɓa túró ɓak tobali. Pàkkî anggea-là mala amǝ'Amon amǝnia yì gìr ka kat. Pǝlǝa Dauda andǝ amǝ'lwa kat nyar a Urǝshalima.<verse eid="2SA 12:31" /></para>
  <chapter eid="2SA 12" />
  <chapter number="13" style="c" sid="2SA 13" />
  <para style="s">Amnon gbárí Tamar</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1" />Adyan ngga, <note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 3:2-3">3:2-3</ref>; <ref loc="1CH 3:2">1Acau 3:2</ref>,<ref loc="1CH 3:9">9</ref></char>.</note>Absalom muna-ɓwabura mala Dauda ka ndanǝ mǝ'nggaula mǝɓoarnsarì, lùllǝì ama Tamar; sǝ Amnon muna-ɓwabura mala Dauda ka earce Tamar.<verse eid="2SA 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2" />Amnon ngga suno mǝ'nggaule Tamar ɓākì kǝ̀rkǝ́r gandǝa tsǝk ɓamurì bwal nǝ rǝkwana. Sǝama Amnon kǝ sǝni ndanǝ kwano sǝ nǝ̀ pakki wi kǝgìr acemǝnana yì Tamar ka súrǝ̀ ɓwabura ɗàng.<verse eid="2SA 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3" />Sǝ Amnon ngga ndanǝ gyajam, lullǝì ama Jonadap muna-ɓwabura mala Shimeya,<note caller="+" style="f"><char style="fr" closed="false">13:3 </char><char style="ft" closed="false">Ko </char><char style="fqa">Shama</char> kǝla mǝnana aɓa: <char style="xt"><ref loc="1SA 16:9">1Sam 16:9</ref>; <ref loc="1SA 17:13">17:13</ref>; <ref loc="1CH 2:13">1Acau 2:13</ref></char>.</note> mǝ'eam Dauda. Jonadap ka mǝkutan na kǝ̀rkǝ́r. <verse eid="2SA 13:3" /><verse number="4" style="v" sid="2SA 13:4" />Jonadap ɗì Amnon ama, &lt;&lt;Palang sǝ akǝ̀ kiɗiki ɓamǝsǝo anggo kǝ̀rkǝ́r koya dǝmbari ka, we muna-ɓwabura mala murǝm? A pà nǝ banggam re?&gt;&gt;</para>
  <para style="p" vid="2SA 13:4">Amnon ne wi ama, &lt;&lt;Ən nggǝ earce Tamar, mǝ'nggaula mǝ'eambǝam Absalom.&gt;&gt;<verse eid="2SA 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5" />Jonadap banggi wi ama, &lt;&lt;Nongnǝ-nongŋo amúr gyangŋan-nongŋo mô, sǝ wu ɓosǝki rǝo kǝla a pà jam ɗàng. Ɓǝ̀ tárró yiu ace sǝno ka, ne wi ama, &lt;Ida, nying mǝ'nggaulem Tamar ɓǝ̀ yi pam bǝredi mǝ shê, sǝ ɓǝ̀ lam girlina a mǝsǝam, ace mǝnana mǝ sǝni sǝ mǝ lî a buì ka.&gt; &gt;&gt;<verse eid="2SA 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6" />Nda Amnon nongnǝ-nongŋo, sǝ ɓosǝki rǝì kǝla pà jam ɗàng. Lang murǝm yiu a sǝne ka, Amnon banggi murǝm ama, &lt;&lt;Ida, nying mǝ'nggaulem Tamar ɓǝ̀ yi pàkkam agbatali kyak ɓari a mǝsǝam, ace mǝnana mǝ li a ɓabuì ka.&gt;&gt;<verse eid="2SA 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7" />Pǝlǝa Dauda túrban nǝ cau aban Tamar a ɓala ama, &lt;&lt;Ida, kya ɓala mala mǝ'eambo Amnon ado, kya lambì wi girlina.&gt;&gt; <verse eid="2SA 13:7" /><verse number="8" style="v" sid="2SA 13:8" />Nda Tamar wari a ɓala mala mǝ'eambi Amnon, sǝ kumi ndaban nongŋo. Pǝlǝa Tamar twal dyar bǝredi, pàk agbatali kyak nǝi a mǝsǝ Amnon, sǝ lurǝia. <verse eid="2SA 13:8" /><verse number="9" style="v" sid="2SA 13:9" />Pǝlǝa yinǝ agbatali kyak man aɓa tasau yi tamsǝi wi a ɓadǝmbi; sǝama Amnon ɓinǝ shè.</para>
  <para style="p" vid="2SA 13:9">Amnon bang ama, &lt;&lt;Wu pusǝ koyana ka ɓǝ̀ purî ban mǝnia ka.&gt;&gt; Sǝ koyan ngga puro nyì. <verse eid="2SA 13:9" /><verse number="10" style="v" sid="2SA 13:10" />Pǝlǝa Amnon banggi Tamar ama, &lt;&lt;Yinǝ girline aɓa ndà-nongŋo mem, ace mǝnana mǝ li a ɓabuo ka.&gt;&gt; Sǝ Tamar twal agbatali kyak mǝnana pea ka, sǝ yinǝì mǝ'eambi Amnon aɓa ndà-nongŋo male. <verse eid="2SA 13:10" /><verse number="11" style="v" sid="2SA 13:11" />Lang yina nǝia abaní tù ɓǝ̀ lì ka, kara Amnon gbami, sǝ ne wi ama, &lt;&lt;Mǝ'nggaulem, yiu mǝ nongnǝ we!&gt;&gt;<verse eid="2SA 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12" />Tamar ne wi ama, &lt;&lt;Awo, mǝ'eambǝam, kǝa kiɗikiam ɗàng! Gìr kǝla mǝnia ka, ɓǝà kǝa pè a Isǝrayila ɗàng.<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 18:9">Pǝris 18:9</ref>,<ref loc="LEV 18:11">11</ref>; <ref loc="LEV 20:17">20:17</ref></char>.</note> Kǝa pàk mǝnia yì gìr-kǝsǝkya mala ɓwaɓana ɗàng. <verse eid="2SA 13:12" /><verse number="13" style="v" sid="2SA 13:13" />Sǝ mim ngga, aya bân sǝ mǝ tsǝk muram atàcau mala kǝsǝkya? Sǝ we ka, awu nǝ̀ duk mwashat aɓalǝ agǝmɓwa amǝɓealɓike a Isǝrayila. Ida, nacau nǝ murǝm; acemǝnana yì ka pà nǝ̀ giro nǝ mim ɗang.&gt;&gt; <verse eid="2SA 13:13" /><verse number="14" style="v" sid="2SA 13:14" />Sǝ Amnon ngga ɓinǝ kwakikiri arǝì, sǝ acemǝnana kútì nǝ rǝcandǝa ka, gbárí, kiɗiki.<verse eid="2SA 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15" />Anzǝm mǝno ka, Amnon twal nǝ nggea ɓinǝmǝsǝu mǝgule arǝ Tamar. Yale ɓinǝmǝsǝu mǝnana ɓinǝi nǝi ka, gulo kútì suno mana oè aceì a tadǝmbe ka. Amnon ne Tamar ama, &lt;&lt;Lo, puro o!&gt;&gt;<verse eid="2SA 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16" />Sǝ Tamar banggi wi ama, &lt;&lt;Awo, mǝɓane mǝnia a kǝ pè nǝ pǝram ngga, ɓiki kǝ̀rkǝ́r kútì gìr mǝnana a pángnǝ́nàm ngga.&gt;&gt; Sǝ yì Amnon ngga, kwakikiri arǝì ɗàng. <verse eid="2SA 13:16" /><verse number="17" style="v" sid="2SA 13:17" />Pǝlǝa tunǝ lagga male mǝtúró-ɓadǝmbi sǝ ne wi ama, &lt;&lt;Usheni, pusǝ ɓwama mǝnia ka, ramtè a nza adyadyan ɓǝ̀ upi ɓadǝmbam, sǝ wu kumli kunkurǝm anzǝmi.&gt;&gt; <verse eid="2SA 13:17" /><verse number="18" style="v" sid="2SA 13:18" />Nda mǝtúró-ɓadǝm Amnon pusǝ Tamar, ramtè a nza sǝ kumli kunkurǝm anzǝmi ka. Tamar ka ndanǝ daura mǝlime mǝnana bwal ban akusǝi nǝ abui mǝsake ka arǝì, acemǝnana mǝnia ka nda ulang daura mana amuna-mamǝna mala murǝm mana à malaká súrǝ̀ ɓwabura raka, à kǝ oasǝ arǝia ka. <verse eid="2SA 13:18" /><verse number="19" style="v" sid="2SA 13:19" />Tamar ɗàrǝ́ tú, soe a ɓamúrí, sǝ bwal daura mǝlime mǝnana bwal ban akusǝi nǝ abui mǝsake, mǝnana arǝì ka, sannì. Tsǝk abui a ɓamúrí, sǝ loasǝ gì kǝ ɓua aban o.<verse eid="2SA 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20" />Absalom mǝ'eam Tamar, ɗì Tamar ama, &lt;&lt;Mǝ'eambo Amnoê ka tsǝo-púp nongnǝ we le? Ado ka, pwalo kǝa ɓua ɗàng, mǝ'nggaulem; yì ka mǝ'eambo na, kǝa tsǝk cau mǝnia ka a ɓabumo ɗàng.&gt;&gt;Nda Tamar ueo anggo nǝmurǝì aɓa bumkiɗikea a ɓala mala mǝ'eambi Absalom ngga.<verse eid="2SA 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21" />Lang murǝm Dauda ok acau mǝnia kat ka, bumi lul kǝ̀rkǝ́r. <verse eid="2SA 13:21" /><verse number="22" style="v" sid="2SA 13:22" />Absalom ne Amnon kǝ cau, ko mǝɓoarne ko mǝɓane ɗàng. Absalom ɓinǝmǝsǝ Amnon, acemǝnana kiɗikina mǝ'nggaule Tamar.<verse eid="2SA 13:22" /></para>
  <para style="s">Absalom wal-lú Amnon</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23" />Anzǝm mana apǝlǝa ɓari kutina ka, Absalom ramba amǝ'túró male ace mwaki wi nyang anzur male a Ba'al Hazo, là mǝnana nda tù a nzong-nzali Ifǝrem ngga. Sǝ tunǝ amuna-burana mala murǝm ɓǝà yiu atè ace lili-banɓoarnado abanì. <verse eid="2SA 13:23" /><verse number="24" style="v" sid="2SA 13:24" />Pǝlǝa Absalom wari aban murǝm Dauda, sǝ banggi wi ama, &lt;&lt;Sǝni, mim guro mò ka ǝn tunǝna amǝ'mwa-nyang nzur ace mwakam nyang anzur mem. Ida, ɓǝ̀ murǝm andǝ amǝ'túró male yiu ace lili-banɓoarnado atà sǝm.&gt;&gt;<verse eid="2SA 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25" />Sǝama murǝm banggi Absalom ama, &lt;&lt;Awo, munem, pà sǝm nǝ̀ ká kat ɗàng, ace mǝnana ɓǝ̀ sǝm nggá dupo twalo raka.&gt;&gt; Kat andǝ amani ama Absalom ɓuaki arǝì ka, ɓinǝe pà nǝ̀ ká ɗàng, sǝama tsǝki wi bù.<verse eid="2SA 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26" />Pǝlǝa Absalom bang ama, &lt;&lt;Ɓǝ̀ a pà wunǝ ká raka, ida, ɗeki mǝ'eambǝam Amnon ɓǝ̀ kya atà sǝm.&gt;&gt;</para>
  <para style="p" vid="2SA 13:26">Murǝm ɗì ama, &lt;&lt;Ace mana sǝ a kǝ earce ama ɓǝ̀ kya atò?&gt;&gt; <verse eid="2SA 13:26" /><verse number="27" style="v" sid="2SA 13:27" />Sǝama Absalom nyare ɓuaki arǝì, nda murǝm Dauda nying Amnon andǝ amuna-burana mala murǝm kat à o atà Absalom ngga.<verse eid="2SA 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28" />Absalom tsǝki amǝtúró male cau ama, &lt;&lt;Wu tsǝkmǝsǝ wun arǝ Amnon, lang nda aɓa banɓoarna mala walo-mba, sǝ ǝn bangga wun nǝma, &lt;Wu wali&gt; ka, pǝlǝa wun nǝ̀ wal-lui. Cè ɓangciu pàkka wun ɗàng; mǝ nda mǝnana ǝn bangga wun nǝma ɓǝ̀ wu pè ka re? Wu cam kàngkàng, sǝ ɓǝ̀ mǝsǝ wun candǝe.&gt;&gt; <verse eid="2SA 13:28" /><verse number="29" style="v" sid="2SA 13:29" />Alaggana mala Absalom pàkkî Amnon kǝla mǝnana Absalom banggia wia ka. Nda amuna-burana mala murǝm lo, sǝ koyana ateà ka, eau a nzǝm pǝr-mǝdambǝriso<note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="fq" closed="false">pǝr-mǝdambǝriso </char><char style="ft" closed="false">Mǝnia yì ulang pǝ̀r ka, à kǝ kumi aɓa eau'eawe mala pǝ̀r andǝ mǝdambǝriso.</char></note> male, sǝ à ɓangŋa akaurǝa à o.<verse eid="2SA 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30" />Lang à nda piu a njargula ka, cau yi bik ban Dauda ama, &lt;&lt;Absalom walna amuna-burana mala murǝm, sǝ kǝɓwa au ateà ɗàng.&gt;&gt; <verse eid="2SA 13:30" /><verse number="31" style="v" sid="2SA 13:31" />Pǝlǝa murǝm lo, san daura male,<note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="fq" closed="false">san daura male </char><char style="ft" closed="false">ace bumkiɗikea</char></note> sǝ nongŋo a nzali; amǝtúró male mǝnana kat à nda ban came abanì ka, à sanggia adaura malea gbal.<verse eid="2SA 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32" />Jonadap, muna-ɓwabura mala Shimeya, mǝ'eam Dauda, na ama, &lt;&lt;Ɓwamǝgule mem ɓǝkǝa twali ama amuna-burana male, amuna-murǝm na kat à wal-luia ka ɗàng; Amnon nǝmurǝi na wù ka. Mǝnia ka nda gìr mǝnana Absalom kànì a ɓabumi nǝ̀ pè, twal a pwari mǝnana Amnon gbárí mǝ'nggaule Tamar ka. <verse eid="2SA 13:32" /><verse number="33" style="v" sid="2SA 13:33" />Acemani ka, ɓwamǝgule mem murǝm ɓǝkǝa falǝnǝ cau mana ama, amuna-burana mala murǝm na kat à wù ka ɗàng; Amnon na nǝmurǝi wù ka.&gt;&gt;<verse eid="2SA 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34" />Sǝ anggo ka, Absalom ɓangŋǝna. Lagga mǝnana cam yale amur nggea-là ka loasǝ mǝsǝi sǝ pelǝban, kara sǝn aɓwana pas aban yiu nǝ njargula mana a nzǝmi ka, a nkanggari mgbangban.<verse eid="2SA 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35" />Jonadap banggi murǝm ama, &lt;&lt;Sǝni, amuna-burana mala murǝm nia à kǝ yiu ka! Nda kǝla mǝnana guro mò ne ka.&gt;&gt; <verse eid="2SA 13:35" /><verse number="36" style="v" sid="2SA 13:36" />Tù anzǝm mǝnana Jonadap malǝna nacau ka, amuna-burana mala murǝm yi tusǝo, sǝ à loasǝ già, à ɓua. Murǝm andǝ amǝtúró male kat gbal ka, à ɓua, nggea ɓua mǝkwanbani.<verse eid="2SA 13:36" /></para>
  <para style="p">
    <verse number="37-38" style="v" sid="2SA 13:37-38" />Sǝ Absalom ngga ɓangŋa o aban <note caller="+" style="f"><char style="fr" closed="false">13:37-38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 3:3">3:3</ref>; <ref loc="1CH 3:2">1Acau 3:2</ref></char>.</note>Talmai muna-ɓwabura mala Ammihud, murǝm mala <note caller="+" style="f"><char style="fr" closed="false">13:37-38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 14:23">14:23</ref>; <ref loc="2SA 14:32">14:32</ref>; <ref loc="2SA 15:8">15:8</ref></char>.</note>Geshur, sǝ ue kano pǝlǝa tàrú. Twal anonggio pas Dauda ɓua ace muna-ɓwabura male, Amnon; <verse eid="2SA 13:37-38" /><verse number="39" style="v" sid="2SA 13:39" />sǝama lang murǝm Dauda kumǝna girikiban amur lú mala Amnon ngga, ɓabumi o arǝ Absalom, sǝ pak-nzal sǝne.<verse eid="2SA 13:39" /></para>
  <chapter eid="2SA 13" />
  <chapter number="14" style="c" sid="2SA 14" />
  <para style="s">Absalom nyar a Urǝshalima</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1" />Adyan ngga, Jowap muna-ɓwabura mala Zeruya yi sǝlǝ ama, ɓabum murǝm nyarǝna aban Absalom. <verse eid="2SA 14:1" /><verse number="2" style="v" sid="2SA 14:2" />Pǝlǝa Jowap túrban atà ɓè ɓwama mǝ'sǝlǝe, mǝnana ndanǝdo a Tekowa ka, sǝ ne wi ama, &lt;&lt;Ɓosǝki rǝo kǝla a nda aɓa ɓua-lú, sǝ wu oasǝ anggubyau ɓua-lú. Kǝa hasǝ mùrú ɗàng; pǎ kǝla ɓwama mǝnana twalǝna anonggio pas nda aɓa bumkiɗikea ace ɓwa male mǝnana wù ka. <verse eid="2SA 14:2" /><verse number="3" style="v" sid="2SA 14:3" />Sǝ wu kya aban murǝm, wu ne wi cau mǝnana mǝ nǝ banggo wu na ka.&gt;&gt; Sǝ Jowap pe wi cau a kúni.<verse eid="2SA 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4" />Lang ɓwama Tekowa man warina aban murǝm ngga, sárǝ́ nǝ ɓamǝsǝi a nzali nǝ pagulo, sǝ na ama, &lt;&lt;Amsǝam, murǝm.&gt;&gt; <verse eid="2SA 14:4" /><verse number="5" style="v" sid="2SA 14:5" />Sǝ murǝm ɗì ama, &lt;&lt;Mana gyammo?&gt;&gt; Pǝlǝa ear ama, &lt;&lt;Mǝ nda mā-lú, burém wuna. <verse eid="2SA 14:5" /><verse number="6" style="v" sid="2SA 14:6" />Sǝ guro mò ka ndanǝ amuna-burana ɓari, sǝ à munǝo arǝaria a dalang. Kǝɓwa pà kàm nǝ̀ gauwia ɗàng; man mwashat ka wal ɓi, wal-luí. <verse eid="2SA 14:6" /><verse number="7" style="v" sid="2SA 14:7" />Sǝ adyan ngga, aɓǝla mem kat longŋǝna amuram, a na ama, &lt;Pà ɓwa mana wal mǝ'eambi ka, ace mǝnana sǝm nǝ̀ wal-lui a kún yilǝmi mǝ'eambi mǝnana wal-lui ka. Ɓǝ̀ ǝn pak mǝnia ka à nǝ̀ kiɗiki mǝliɓala gbal. Anggo sǝ à nǝ̀ limgi nkalang bǝsa mem mǝnana ue ka, sǝ à pà nǝ̀ nyinggi burém lullǝu ko mǝ'kau a ɓanza ɗàng.&gt; &gt;&gt;<verse eid="2SA 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8" />Pǝlǝa murǝm ne ɓwama man ama, &lt;&lt;O a ɓala mò, sǝ mǝ nǝ tsǝa à nǝ̀ tsǝkiro.&gt;&gt; <verse eid="2SA 14:8" /><verse number="9" style="v" sid="2SA 14:9" />Osso ɓwama Tekowa man ne murǝm ama, &lt;&lt;Ɓǝ̀ aɓwana kum cauɓikea aɓa cau mǝnia a twal ace bwalam ngga, ɓǝ̀ bafe mala cauɓike do a muram, ɓwamǝgule mem, murǝm, sǝ ɓǝ̀ do amur ɓala mala tárrám; ɓǝ̀ murǝm andǝ bunomurǝm male ɓǝ̀ dum nǝ ɗwanyicau-arǝǔ.&gt;&gt; <verse eid="2SA 14:9" /><verse number="10" style="v" sid="2SA 14:10" />Murǝm ne wi ama, &lt;&lt;Ɓǝ̀ kǝɓwa na kǝ cau amuro ka, yinǝi abanam, sǝ pà nǝ jeo ɗǝm ɗàng.&gt;&gt; <verse eid="2SA 14:10" /><verse number="11" style="v" sid="2SA 14:11" />Pǝlǝa ɓwame na ama, &lt;&lt;Ida, ɓǝ̀ murǝm zǝmbi Yahweh Ɓakuli male ama mǝ'mbweban-akúnì nkila mana à sukki ka, ɓǝkǝa wal-lú ɗǝm ɗàng, sǝ ɓǝ̀ munem ngga, ɓǝà kǝa kiɗiki ɗàng.&gt;&gt; Sǝ murǝm bang ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam ngga, nyang mur munio mwashat pà nǝ̀ kpa a nzali ɗàng.&gt;&gt; <verse eid="2SA 14:11" /><verse number="12" style="v" sid="2SA 14:12" />Pǝlǝa ɓwama man na ama, &lt;&lt;Ida, nying guro mò ɓǝ̀ nacau nǝ ɓwamǝgule mem, yi murǝm.&gt;&gt; Sǝ murǝm banggi wi ama, &lt;&lt;Nacau.&gt;&gt; <verse eid="2SA 14:12" /><verse number="13" style="v" sid="2SA 14:13" />Osso ɓwame na ama, &lt;&lt;Palang sǝ a twal cau mǝɓane a bumo kǝla mǝnia ka, arǝ aɓwana mala Ɓakuli? Acemǝnana twalkusǝu mǝnia murǝm twal amur cau man ngga, kasǝni ɓamúrì ɓashi, mǝnana ɓinǝ nyesǝ muni ɓǝ̀ nyar a là ka, muni mana pǝri o a ɓè nzali ka. <verse eid="2SA 14:13" /><verse number="14" style="v" sid="2SA 14:14" />Sǝm kat ka dumǝna púp sǝm nǝ̀ nggá wú; sǝ sǝm nda kǝla mùr mǝnana à solǝi a nzali, sǝ à pà nǝ̀ gandǝ rambi ɗǝm raka. Ɓakuli ka pà nǝ̀ twal yilǝmu ɗàng; kǝ pak njar mala nyesǝ ɓwa mǝnana a pǝri a là ka, ace mǝnana ɓǝkǝa ue a nza raka. <verse eid="2SA 14:14" /><verse number="15" style="v" sid="2SA 14:15" />Sǝ adyan ngga, ǝn yiu ace banggi ɓwamǝgule mem murǝm mǝnia yì cau ka, acemǝnana aɓwe tsǝem ɓangciu pakkam. Sǝ mim guro mò ka ǝn pakɗenyicau ama, mǝ nǝ bangcau nǝ murǝm; yakǝla nǝ̀ pè guro male gìr mǝnana zǝm ngga. <verse eid="2SA 14:15" /><verse number="16" style="v" sid="2SA 14:16" />Ən sǝlǝna ama murǝm nǝ̀ kwakikiri, sǝ nǝ̀ amsǝam a ɓabù ɓwa mana kǝ alte nǝ̀ wal-lú munem sǝ nǝ̀ kiɗikiam, sǝ anggo ka nǝ̀ twalta sǝm aɓa nzali liɓala mǝnana Ɓakuli pê aɓwana male ka. <verse eid="2SA 14:16" /><verse number="17" style="v" sid="2SA 14:17" />Sǝ adyan ngga, mim guro mò, ǝn nggǝ na nǝma, &lt;Ida, ɓǝ̀ cau mala ɓwamǝgule mem murǝm yinǝàm nǝ usǝlǝo,&gt; acemǝnana ɓwamǝgule mem murǝm ngga, nda kǝla mǝturonjar mala Ɓakuli mana kǝ súrǝ̀ mǝɓoarne andǝ mǝɓike ka. Ɓǝ̀ Yahweh Ɓakuli mô do atò!&gt;&gt;<verse eid="2SA 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18" />Pǝlǝa murǝm earî ɓwama man ama, &lt;&lt;Cè a sǝmbǝrǝam kǝgir mǝnana mǝ nǝ ɗio ka ɗàng.&gt;&gt;Sǝ ɓwame na ama, &lt;&lt;Ɓǝ̀ ɓwamǝgule mem murǝm ɓǝ̀ nacau.&gt;&gt; <verse eid="2SA 14:18" /><verse number="19" style="v" sid="2SA 14:19" />Murǝm ɗì ama, &lt;&lt;Bù Jowap pa aɓa mǝnia yì gìr a pàkki kat ka ɗang?&gt;&gt; Ɓwama man eare sǝ na ama, &lt;&lt;Kǝla mana a ndakam nǝyilǝmu ka, ɓwamǝgule mem murǝm, ɓwa pà nǝ̀ kyang atà bu-mǝli ko mǝnggare lang ɓwamǝgule mem murǝm ɗiban ngga ɗàng. E, guro mò Jowap nda mǝnana banggam ama mǝ pak gìr mǝnia ka; yì na tsǝkam acau mǝnia kat a kunam ngga. <verse eid="2SA 14:19" /><verse number="20" style="v" sid="2SA 14:20" />Guro mò Jowap na mǝnana pàk mǝnia yì gìr ka, ace mana ɓǝ̀ tsǝo wu nggaɗi ɗenyicau mò amur gìr mǝnana kǝ̀ u ka. Sǝama ɓwamǝgule mem ngga ndanǝ kwaro kǝla kwaro mala mǝturonjar mala Ɓakuli ace súrǝ̀ agir mǝnana kat a ɓanza ka.&gt;&gt;<verse eid="2SA 14:20" /></para>
  <para style="s">À nyesǝ Absalom a là</para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21" />Pǝlǝa murǝm ne Jowap ama, &lt;&lt;Adyan ngga, ǝn earǝ́nò wu pak gìr mǝnana a earkiyice ka. Kyane kya nyesǝ laggè, yi Absalom.&gt;&gt; <verse eid="2SA 14:21" /><verse number="22" style="v" sid="2SA 14:22" />Pǝlǝa Jowap kpa nǝ ɓamǝsǝi a nzali, pe murǝm gulo sǝ tsǝki wi bù. Sǝ Jowap na ama, &lt;&lt;Yalung sǝ guro mò sǝlǝ ama ǝn kumǝna earmúrú a bano, ɓwamǝgule mem murǝm, mǝnana a panam gìr mǝnana ǝn zǝm ngga.&gt;&gt; <verse eid="2SA 14:22" /><verse number="23" style="v" sid="2SA 14:23" />Nda Jowap lo sǝ wari a Geshur, sǝ kya nyesǝ Absalom a Urǝshalima ka. <verse eid="2SA 14:23" /><verse number="24" style="v" sid="2SA 14:24" />Sǝ murǝm bang ama, &lt;&lt;Ɓǝ̀ kya do a ɓala male zak; ɓǝ̀ kǝa yiu a ɓadǝmbǝam ɗàng.&gt;&gt; Nda Absalom do a ɓala male zak, sǝ yiu aɓadǝm murǝm raka.<verse eid="2SA 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25" />Adyan ngga, kǝɓwa pà kàm a Isǝrayila mana aɓwana ɓwangsǝi ace ɓoarjam male kǝla Absalom ngga ɗàng. Twal a ɓakusǝi kya pur a kwar ɓamuri ka, kǝ mǝɓane pà kàm arǝì ɗàng. <verse eid="2SA 14:25" /><verse number="26" style="v" sid="2SA 14:26" />Kǝ kasǝki nyang múrí a masǝlǝata koya pǝlǝa; ɓǝ̀ dǝmbǝrì wi ka, kǝ kasǝki; ɓǝ̀ kārǝ́ dǝmbǝrya mala nyang múrí ka, kǝ bik shekel gbǝman-ɓari, aɓa kpata shekel mala murǝm. <verse eid="2SA 14:26" /><verse number="27" style="v" sid="2SA 14:27" />À ɓǝlî Absalom amuna-burana tàrú, sǝ muna-ɓwama mwashat mana lullǝì ama Tamar ka. Tamar ka ɓwama mǝɓoarnsari na.<verse eid="2SA 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28" />Absalom ngga do lùmsǝ apǝlǝa ɓari a Urǝshalima, kútí aɓadǝm murǝm ɗàng. <verse eid="2SA 14:28" /><verse number="29" style="v" sid="2SA 14:29" />Pǝlǝa Absalom túrban atà Jowap, ace mǝnana nǝ̀ túrí aban murǝm ngga, sǝ Jowap ka yiu abaní ɗàng. Nyare túrban atè ɓaria, sǝ Jowap ka ɓinǝ yiu. <verse eid="2SA 14:29" /><verse number="30" style="v" sid="2SA 14:30" />Pǝlǝa Absalom ne amǝtúró male ama, &lt;&lt;Wu sǝni, ɓaban mala Jowap ka nda nzong andǝ mem, sǝ ndanǝ mǝssa-bálì kam. Wu kyane, wu soaki wi bǝsa.&gt;&gt; Nda amǝtúró mala Absalom wario sǝ à soaki ɓabanì bǝsa ka.<verse eid="2SA 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31" />Jowap lo sǝ wari aban Absalom a ɓala male, sǝ ɗì ama, &lt;&lt;Ace mana sǝ amǝ'túró mô kya soaki ɓaban mem bǝsa?&gt;&gt; <verse eid="2SA 14:31" /><verse number="32" style="v" sid="2SA 14:32" />Absalom pè wi eare ama, &lt;&lt;Nda acemǝnana ǝn túrban atò ama, wu yiu ɓǝ̀n túrǒ aban murǝm ngga, sǝ a ɓinǝ yiu. Ən earce nǝma wu kya aban murǝm sǝ wu ɗikamì ama, &lt;Ace mana sǝ ǝn nying Geshur sǝ ǝn yiu kani? Nǝ̀ ɓoaribani ɓǝ̀ mǝ nda kano piu ka.&gt; Ado ka, ǝn nggǝ earce nǝma wu pak njar acem ɓǝ̀n kútí aɓadǝm murǝm; sǝ ɓǝ̀ kumam nǝ kǝ cauɓikea arǝàm ngga, ɓǝ̀ wal-luem.&gt;&gt;<verse eid="2SA 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33" />Pǝlǝa Jowap wari aban murǝm sǝ ne wi mǝnia yì cau ka. Pǝlǝa murǝm túrban atà Absalom ɓǝ̀ yi kútí abaní. Sǝ Absalom yiu aɓadǝm murǝm, sǝ kūndǝ nǝ ɓamǝsǝi a nzali aɓadǝm murǝm; sǝ murǝm gingsǝi kùrì zǝp.<verse eid="2SA 14:33" /></para>
  <chapter eid="2SA 14" />
  <chapter number="15" style="c" sid="2SA 15" />
  <para style="s">Absalom kùrkún amur Dauda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1" />Anzǝm mǝnia ka, Absalom kumbi ɓamurì waru-pǝr andǝ apǝr, andǝ aburana lumi-tongno ɓǝà kǝ ɓang a ɓadǝmbi. <verse eid="2SA 15:1" /><verse number="2" style="v" sid="2SA 15:2" />Pàkka, Absalom nǝ̀ lo nǝ dǝmbari ɗiɗyal sǝ nǝ̀ cam a gírí njargula mala kun-nggealà. Sǝ lang kǝ ɓwa nǝ̀ yiu a wuliban aɓadǝm murǝm ace kasǝ-ɓashi ka, Absalom nǝ̀ tunǝi, sǝ nǝ̀ ɗi ama &lt;&lt;A pur aya la?&gt;&gt; Sǝ ɓǝ̀ na ama &lt;&lt;Guro mò pur a bu-nzali mala Isǝrayila man ko mǝno ka,&gt;&gt; <verse eid="2SA 15:2" /><verse number="3" style="v" sid="2SA 15:3" />Absalom nǝ̀ banggi wi ama, &lt;&lt;Sǝni acau mò ka à ɓoaro sǝ ɓafo na, sǝama kǝɓwa pà kàm mǝnana murǝm twali ɓǝ̀ oeo ka ɗàng.&gt;&gt; <verse eid="2SA 15:3" /><verse number="4" style="v" sid="2SA 15:4" />Pǝlǝa Absalom nǝ na ama, &lt;&lt;Sǝni, ɓǝ̀ à na ama mǝ nda mǝɓashi aɓa nzali man ngga, ɓǝ́ koyan mana ndanǝ ɓekǝ kúnɓuana ko wuliban ngga, nǝ̀ yinǝi abanam, sǝ mǝ nǝ pàk ɓashi-mǝsǝcau.&gt;&gt; <verse eid="2SA 15:4" /><verse number="5" style="v" sid="2SA 15:5" />Sǝ koya pwari ɓwa sung abaní ace pe wi gulo ka, nǝ̀ sárǝ́ abui, nǝ̀ bwali sǝ nǝ̀ kùrrì zǝp. <verse eid="2SA 15:5" /><verse number="6" style="v" sid="2SA 15:6" />Anggo sǝ Absalom kǝ pakki amǝ Isǝrayila mana à yiu aban murǝm ace ɓashi ka. Ani sǝ Absalom iu ɓabum aburana mala Isǝrayila.<verse eid="2SA 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7" />Anzǝm apǝlǝa ine ka, Absalom ne murǝm ama, &lt;&lt;Ida, earam ɓǝn kya a Hebǝron ace mbwe kángir mem mana ǝn kánbi Yahweh ka. <verse eid="2SA 15:7" /><verse number="8" style="v" sid="2SA 15:8" />Lang mǝ nda aban do a Geshur a nzali Aram ngga, ǝn pacau nǝ kána, ama, &lt;Mǝsǝcau ɓǝ̀ Yahweh nǝ̀ nyesǝam a Urǝshalima ka, mǝ nǝ nggá peri abaní.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 28:20-21">Tite 28:20-21</ref>; <ref loc="1SA 1:11">1Sam 1:11</ref></char>.</note> <verse eid="2SA 15:8" /><verse number="9" style="v" sid="2SA 15:9" />Pǝlǝa murǝm banggi wi ama, &lt;&lt;Kya aɓa rǝpwala.&gt;&gt; Nda lo sǝ o a Hebǝron ngga.<verse eid="2SA 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10" />Sǝama Absalom tasǝ amǝ'na-túrbân aban atau mala Isǝrayila kat, aɓa sǝmbǝrǝa, nǝ cau ama, &lt;&lt;Lang wu ongŋǝna ɓua mala njawe ka, tsuk-tsuk wu bang ama, &lt;Absalom nda murǝm a Hebǝron!&gt; &gt;&gt; <verse eid="2SA 15:10" /><verse number="11" style="v" sid="2SA 15:11" />Absalom umnǝ aburana gbǝman-ɓari mǝnana tunǝia à pur a Urǝshalima andǝi ka, sǝ à wari aɓa kunpwasǝa malea, sǝ à sǝlǝ kǝ cau ɗàng. <verse eid="2SA 15:11" /><verse number="12" style="v" sid="2SA 15:12" />Sǝ lang Absalom na aban pāki apagir mala gir'nkila ka, túrban atà Ahitofel ɓwa'Gilo, mǝkwarkir Dauda, a Gilo là male. Kùrkûn malea candǝe, sǝ aɓwana mana à nda atà Absalom ngga à lidǝmba nǝ lakki.<verse eid="2SA 15:12" /></para>
  <para style="s">Dauda ɓangŋa nying Urǝshalima</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13" />Sau ɗang ɓè mǝ'na-túrbân yiu aban Dauda sǝ ne wi ama, &lt;&lt;Ɓabum aburana mala Isǝrayila umǝna atà Absalom.&gt;&gt; <verse eid="2SA 15:13" /><verse number="14" style="v" sid="2SA 15:14" />Pǝlǝa Dauda ne aguro male mana kat atè a Urǝshalima ka ama, &lt;&lt;Wu lo, ɓǝ̀ sǝm ɓangŋa akaurǝa, ɓǝ̀ ana raka pà sǝm nǝ̀ apî Absalom ɗàng. Wu o akaurǝa, cè kasǝmúr sǝm tù, sǝ yinǝ mǝɓike amur sǝm, sǝ nǝ̀ wal-lú koyan mǝnana nda aɓa nggea-là ka nǝ nggeabyau.&gt;&gt; <verse eid="2SA 15:14" /><verse number="15" style="v" sid="2SA 15:15" />Aguro mala murǝm ne murǝm ama, &lt;&lt;Sǝni, sǝm aguro mò ka, sǝm nda aɓa gilǝrǝu ace pàk gìr mǝnana kat we mǝtala-ɓala ma'sǝm murǝm, a twalo awu nǝ pàk ka.&gt;&gt; <verse eid="2SA 15:15" /><verse number="16" style="v" sid="2SA 15:16" />Nda murǝm pur andǝ amǝ'ɓala male kat atè. Sǝama murǝm nying amā-twala lum ɓǝà ueo ace tsǝkir ɓala. <verse eid="2SA 15:16" /><verse number="17" style="v" sid="2SA 15:17" />Sǝ murǝm puro, andǝ aɓwe kat atè. Sǝ à yi cam a masǝlǝata là.<verse eid="2SA 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 15:18" />Pǝlǝa amǝgulo male kat cam a nkanggari, sǝ amǝ'Keret andǝ amǝ'Pelet<note caller="+" style="f"><char style="fr" closed="false">15:18 </char><char style="fq" closed="false">amǝ'Keret andǝ amǝ'Pelet </char><char style="ft" closed="false">ka à nda ka amǝ'yáltà murǝm.</char></note> kat gya sǝ à kùtí a ɓadǝmbi. Sǝ amǝ'Gitti kat, yì aburana gbǝman-tongno-nong-mwashat mana à kpate a Gat ka, à gya à yi kutio aɓadǝm murǝm. <verse eid="2SA 15:18" /><verse number="19" style="v" sid="2SA 15:19" />Pǝlǝa murǝm ne Ittai ɓwa'Gitti ama, &lt;&lt;Palang sǝ a o atà sǝm gbal? Nyare, o kya do atà murǝm, acemǝnana we ka, a nda bǝri-ɓwa, sǝ ɗǝm ngga a nying nzali mô sǝ a yiu ace àwá. Nyar a ɓala mò. <verse eid="2SA 15:19" /><verse number="20" style="v" sid="2SA 15:20" />Kǝ yilung sǝ a yiu, sǝ yalung ngga mǝ nǝ tsǝo a sokki-kún atà sǝm le? Yale ǝn súrǝ̀ ban mǝnana ǝn kákiyi kam ngga? Nyare o, twal amǝ'eambo atò. Ɓǝ̀ Yahweh lǝmdǝo earcearǝu mǝnana kǝ nggaɗi raka andǝ domǝsǝcau.&gt;&gt;<verse eid="2SA 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21" />Sǝ Ittai earî murǝm ama, &lt;&lt;Mbak-kàngkàng Yahweh nakam, sǝ ɓwamǝgule mem murǝm na kam nǝyilǝmu ka, ban mǝnana kat ɓwamǝgule mem murǝm nǝ̀ pàk kàm, ko aɓa lú ko yilǝmu ka, a kǝ banì sǝ mim guro mò nǝ̀ pa.&gt;&gt; <verse eid="2SA 15:21" /><verse number="22" style="v" sid="2SA 15:22" />Pǝlǝa Dauda ne Ittai ama, &lt;&lt;Ɓǝ̀ nda ana ka, fa.&gt;&gt; Pǝlǝa Ittai ɓwa'Gitti gya kutio, andǝ aburana male kat, andǝ amuna mǝkeke mǝnana kat atè ka. <verse eid="2SA 15:22" /><verse number="23" style="v" sid="2SA 15:23" />Sǝ là kat kpa ɓua bang-bang lang Dauda andǝ aɓwana mǝnana atè kat nǝ̀ nggǝ kùtí ka. Sǝ murǝm yàlî ɓangŋaban Kidǝron, sǝ aburana male kpa, sǝ yià kat à twal njargula o a ɓabondo.<verse eid="2SA 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24" />Pǝlǝa Abiyata yiu, sǝ Zadok yiu gbal andǝ amǝ'Lawi kat, nǝ Akwati Kùrcau mala Ɓakuli a buia. Sǝ à yi tamsǝ Akwati Kùrcau mala Ɓakuli a nzali she lang aɓwana kat kutina, à purǝnì ɓá nggea-là ka. <verse eid="2SA 15:24" /><verse number="25" style="v" sid="2SA 15:25" />Pǝlǝa murǝm ne Zadok ama, &lt;&lt;Wu nyesǝ Akwati Kùrcau aɓa nggea-là. Ɓǝ̀ ǝn kum earmúrú a mǝsǝ Yahweh ka, nǝ̀ nyesǝam sǝ nǝ̀ tsǝa ɓǝn sǝni, andǝ bando male. <verse eid="2SA 15:25" /><verse number="26" style="v" sid="2SA 15:26" />Sǝ ɓǝ̀ na ama, &lt;Banɓoaram arǝò raka,&gt; mǝ ndya ka, ɓǝ̀ pakkam gìr mǝnana sǝni nda ɓoari wi ka.&gt;&gt; <verse eid="2SA 15:26" /><verse number="27" style="v" sid="2SA 15:27" />Murǝm banggi Zadok pǝris ɗǝm ama, &lt;&lt;A nda mǝ'sǝna re? Nyare o aɓa nggea-là aɓa rǝpwala, we wunǝ amuna-burana mô ɓari, Ahimaz andǝ Abiyata. <verse eid="2SA 15:27" /><verse number="28" style="v" sid="2SA 15:28" />Sǝni, mǝ nǝ kúndǝô a ban yálì nkaring mùr nǝ njar mana umnǝ ɓabondo ka, she ɓǝn angŋa cau a bano ka.&gt;&gt; <verse eid="2SA 15:28" /><verse number="29" style="v" sid="2SA 15:29" />Osso Zadok andǝ Abiyata twal Akwati Kùrcau mala Ɓakuli, à nyesǝi a Urǝshalima, sǝ à ue kano.<verse eid="2SA 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30" />Sǝ Dauda ka eau a bum Nkono Olif, kǝ ɓua aban ká nǝ ɓakusǝi, sǝ gìr múrí. Sǝ aɓwana mǝnana kat atè ka, à gìr múrià sǝ à kǝ eauwe, nǝ ɓua a kunia aban ká.<verse eid="2SA 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 15:31" />Ɓeɓwa ne Dauda ama, &lt;&lt;Ahitofel na aɓalǝa amǝ'kùrkûn atà Absalom.&gt;&gt; Pǝlǝa Dauda pakhiwi ama, &lt;&lt;Yahweh, ida, nyesǝ kwarkiru mala Ahitofel ɓǝ̀ duk cau mǝɓangge.&gt;&gt;<verse eid="2SA 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32" />Lang Dauda bik ɓong Nkono Olif, a ban mǝnana aɓwana kǝ peri kàm aban Ɓakuli ka, Hushai ɓwa'Arki yiu ace je andǝi, nǝ daura-murɓe male mǝnana à sannì ka, sǝ tú na a ɓamuri. <verse eid="2SA 15:32" /><verse number="33" style="v" sid="2SA 15:33" />Dauda ne wi ama, &lt;&lt;Ɓǝ̀ a o atàm ngga, awu nǝ dupam twalo. <verse eid="2SA 15:33" /><verse number="34" style="v" sid="2SA 15:34" />Sǝama ɓǝ̀ a nyar a nggea-là, sǝ a ne Absalom ama, &lt;Mǝ nǝ duk guro mò, murǝm; kǝla mǝnana mǝ nda guro mala tárró ɗiɗyal ka, anggo sǝ mǝ nǝ duk guro mò adyan&gt; ngga, anggo sǝ awu nǝ gandǝâmce kwarkiru mala Ahitofel. <verse eid="2SA 15:34" /><verse number="35" style="v" sid="2SA 15:35" />Zadok andǝ Abiyata yià apǝris ka, à pà atò kano re? Acemani ka, gìr mǝnana kat a oê a ɓala mala murǝm ngga, banggi Zadok andǝ Abiyata yià apǝris. <verse eid="2SA 15:35" /><verse number="36" style="v" sid="2SA 15:36" />Sǝni, amuna-burana malea ɓari, Ahima'az muna-ɓwabura mala Zadok, andǝ Jonatan muna-ɓwabura mala Abiyata ka, à nda kano ateà. Wun nǝ̀ túriá abanam nǝ cau mǝnana kat wu ok ka.&gt;&gt; <verse eid="2SA 15:36" /><verse number="37" style="v" sid="2SA 15:37" />Nda Hushai, gyajam mala Dauda, yiu aɓa nggea-là ka; yiu male karǝ nǝ kutio mala Absalom aɓa Urǝshalima.<verse eid="2SA 15:37" /></para>
  <chapter eid="2SA 15" />
  <chapter number="16" style="c" sid="2SA 16" />
  <para style="s">Dauda andǝ Ziba</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1" />Lang Dauda kutini ɓong nkono<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Nkono Olif</char></note> ka, Ziba guro<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 9:12">2Sam 9:12</ref></char>.</note> mala Mefiboshet kya kumi nǝ amǝdambǝriso ɓari mǝnana à twal agbatali bǝredi gbǝman-ɓari, andǝ adangŋanshi ɓǝla-anap mǝ'ime gbǝman-mwashat, sǝ ɓǝla-vwari gbǝman-mwashat, andǝ sambǝram mana à lùmsǝì nǝ mùr-anap ka. <verse eid="2SA 16:1" /><verse number="2" style="v" sid="2SA 16:2" />Pǝlǝa murǝm ɗì Ziba ama, &lt;&lt;Ace mana sǝ a yinǝ amǝnia yì agir ka?&gt;&gt; Pǝlǝa Ziba eari wi ama, &lt;&lt;Amǝdambǝriso mǝnia ka à nda ace amǝ'ɓala murǝm ɓǝà kǝ eau a nzǝmia, sǝ bǝredi andǝ ɓǝla-vwari ka, à nda ace alaggana ɓǝà shea, sǝ mùr-anap ka, nda ace aɓwana mǝnana à aulǝa aɓa pǝɗanban ngga.&gt;&gt; <verse eid="2SA 16:2" /><verse number="3" style="v" sid="2SA 16:3" />Murǝm nyare ɗì ama, &lt;&lt;Muna-ɓwabura mala mǝtala-ɓala mò ka nda ke?&gt;&gt; Ziba banggi murǝm ama, &lt;&lt;Nda a Urǝshalima; yì ka bang ama, Yalung ngga ɓala mala Isǝrayila nǝ̀ nyesǝî wi domurǝm mala tárrí.&gt;&gt; <verse eid="2SA 16:3" /><verse number="4" style="v" sid="2SA 16:4" />Murǝm pǝlǝa banggi Ziba ama, &lt;&lt;Sǝni, agir mǝnana kat à mala Mefiboshet na ka à dumǝna amô.<note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 9:3-11">2Sam 9:3-11</ref></char>.</note>&gt;&gt; Sǝ Ziba bang ama, &lt;&lt;Ən ɓun aɓadǝmbo; eare ɓǝn kum earmúrú a bano, we ɓwamǝgule mem, murǝm.&gt;&gt;<verse eid="2SA 16:4" /></para>
  <para style="s">Shimeyi sú Dauda</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5" />Lang Murǝm Dauda yiu a Bahurim ngga, ɓè ɓwabura mǝnana pur a nggurkwar mala ɓala mala Sawul, lullǝi ama Shimeyi, muna-ɓwabura mala Gera ka, pur aban yiu, sǝ lang yina ka, camarǝ sáng Dauda. <verse eid="2SA 16:5" /><verse number="6" style="v" sid="2SA 16:6" />Ɓukki Dauda nǝ̀ atali, sǝ ɓukki aguro mala murǝm Dauda gbal, sǝ anggo ka, aɓwana kat andǝ akanggǝrang aburana ka à nda a koya buì mala Dauda. <verse eid="2SA 16:6" /><verse number="7" style="v" sid="2SA 16:7" />Sǝ Shimeyi kǝ sangban ama, &lt;&lt;Upi ban mǝnia ka, upi ban mǝnia ka, we mǝ'sukki-nkila, we ɓwa mǝɓane!<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 22:28">Pur 22:28</ref></char>.</note> <verse eid="2SA 16:7" /><verse number="8" style="v" sid="2SA 16:8" />Yahweh mbweno a kúnì nkila mala amǝ'ɓala mala Sawul mǝnana kat a sukki, sǝ a ak bunomurǝm male ka. Yahweh pana domurǝmì a ɓabu munio Absalom. Sǝni, ɓealɓikea mô yina amuro acemǝnana a nda mǝ'sukki-nkila.&gt;&gt;<verse eid="2SA 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9" />Pǝlǝa Abishai muna-ɓwabura mala Zeruya banggi murǝm ama, &lt;&lt;Ace mana sǝ lu-nvwa mǝnia nǝ̀ sáng ɓwamǝgule mem, yì murǝm? Ɗekiam mǝ kyane mǝ kasǝ ɓamuri.&gt;&gt; <verse eid="2SA 16:9" /><verse number="10" style="v" sid="2SA 16:10" />Sǝama murǝm bang ama, &lt;&lt;Mana kpapi sǝm sǝnǝa wun le, wun amuna-burana mala Zeruya? Ɓǝ̀ nda aban sangban acemǝnana Yahweh banggi wi ama, &lt;Sáng Dauda&gt; ka, yana ɗe nǝ̀ bang ama, &lt;Palang sǝ a pak ana?&gt; &gt;&gt; <verse eid="2SA 16:10" /><verse number="11" style="v" sid="2SA 16:11" />Pǝlǝa Dauda ne Abishai andǝ aguro male kat ama, &lt;&lt;Wu sǝni, munem mǝnana ǝn ɓǝli nǝ tam ngga, nda aban alta yilǝmem; palang sǝ nǝ̀ duk gir'ndali nǝ ɓwa'Benjami mǝnia ka? Ɗeki ɓǝ̀ sangban, acemǝnana Yahweh na mǝnana banggi wi ama ɓǝ̀ sangban ngga. <verse eid="2SA 16:11" /><verse number="12" style="v" sid="2SA 16:12" />Yakǝla Yahweh nǝ̀ sǝn mǝɓane mǝnana à pàkkam ngga, sǝ nǝ̀ mbwem a kúnì nǝ mǝɓoarne atàcau mala sangban male yalung.&gt;&gt; <verse eid="2SA 16:12" /><verse number="13" style="v" sid="2SA 16:13" />Nda Dauda andǝ aburana male lidǝmba aban o amur njargula, sǝ Shimeyi kǝ gya a nkanggari nkono, a nkāɓe nǝ Dauda, sǝ kǝ sanggi, kǝ túrki wi atali, sǝ kǝ loasǝi wi tú. <verse eid="2SA 16:13" /><verse number="14" style="v" sid="2SA 16:14" />Lang murǝm andǝ aɓwana mǝnana à nda atè, à yi bwal ban Nggeasala Jodan ngga, à aulǝna. Pǝlǝa à usǝlǝ abanì.<verse eid="2SA 16:14" /></para>
  <para style="s">Absalom kùtí a Urǝshalima</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15" />Ado ka, Absalom andǝ aɓwana kat, yì aburana mala Isǝrayila, à yiu a Urǝshalima, sǝ Ahitofel ka nda atè. <verse eid="2SA 16:15" /><verse number="16" style="v" sid="2SA 16:16" />Sǝ lang Hushai ɓwa'Arki, gyajam mala Dauda yiu aban Absalom ngga, yi ne Absalom ama, &lt;&lt;Ɓǝ̀ yilǝmio sauwa we murǝm! Ɓǝ̀ yilǝmio sauwa we murǝm!&gt;&gt; <verse eid="2SA 16:16" /><verse number="17" style="v" sid="2SA 16:17" />Pǝlǝa Absalom banggi Hushai ama, &lt;&lt;Mǝnia ka nda earcearǝu mǝnana awu nǝ lǝmdǝì gyajam mô le? Ace mana sǝ a o atà gyajam mô ɗang?&gt;&gt; <verse eid="2SA 16:17" /><verse number="18" style="v" sid="2SA 16:18" />Hushai eari wi ama, &lt;&lt;Awo, ɓwa mǝnana Yahweh, andǝ aɓwana mǝnia, andǝ amǝ Isǝrayila kat twal ka, mǝ nǝ duk male, sǝ mǝ nǝ ue atè. <verse eid="2SA 16:18" /><verse number="19" style="v" sid="2SA 16:19" />Sǝ ɗǝm ngga, yana mǝ nǝ duk guro male? Muni na re? Kǝla mǝnana ǝn duk guro mala tárró ka, anggo gbal sǝ mǝ nǝ duk guro mò.&gt;&gt;<verse eid="2SA 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20" />Pǝlǝa Absalom ne Ahitofel ama, &lt;&lt;Pà sǝm kwarkiru mô. Mana ɓǝ̀ sǝm pa?&gt;&gt; <verse eid="2SA 16:20" /><verse number="21" style="v" sid="2SA 16:21" />Ahitofel banggi Absalom ama, &lt;&lt;Kyane kya nongnǝ amā-twala mala tárró mǝnana ɗekia ɓǝ̀ à kǝ tsǝkir ɓala ka, sǝ Isǝrayila kat nǝ̀ okce ama a pani tárró kǝsǝkya a ɓaɓwa, sǝ aɓwana mǝnana à nda atò ka, à nǝ̀ kum mǝsǝkang-kangŋa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="2SA 12:11-12">2Sam 12:11-12</ref></char>.</note> <verse eid="2SA 16:21" /><verse number="22" style="v" sid="2SA 16:22" />Nda à tsǝkî Absalom tara a múr-kurǝm, pǝlǝa Absalom nongnǝ amā-twala mala tárrí a mǝsǝ amǝ Isǝrayila kat ka. <verse eid="2SA 16:22" /><verse number="23" style="v" sid="2SA 16:23" />Absalom kpata kwarkiru mala Ahitofel kǝla mǝnana Dauda pàk ka. Koya cau mǝnana pur a kún Ahitofel ka, à kǝ sǝn sǝlǝe aɓalǝi kǝla cau mǝnana pur a kún Ɓakuli nǝnggearǝì ka.<verse eid="2SA 16:23" /></para>
  <chapter eid="2SA 16" />
  <chapter number="17" style="c" sid="2SA 17" />
  <para style="s">Hushai amsǝ Dauda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1" />Ahitofel ne Absalom ɗǝm ama, &lt;&lt;Ɗeki ɓǝ̀n twal aburana á-lum-nong-ɓari, sǝ mǝ nǝ lo mǝ nǝ pyangnǝ atà Dauda a du man yalung ngga. <verse eid="2SA 17:1" /><verse number="2" style="v" sid="2SA 17:2" />Lang aulǝna sǝ ɓabumi ɓungina ka, mǝ nǝ eau amurí, sǝ mǝ nǝ pe wi ɓangciu, sǝ aɓwana mǝnana à nda atè kat ka, à nǝ̀ ɓang nǝ mire. Kǝ murǝm nǝmurǝi nda mǝ nǝ wal-luí ka, <verse eid="2SA 17:2" /><verse number="3" style="v" sid="2SA 17:3" />sǝ mǝ nǝ nyesǝô aɓwana mǝno kat a bano. Kǝ yilǝmi ɓwa mwashat nda mǝnana a alkiyite ka, sǝ aɓwana kat ka, à nǝ̀ do aɓa rǝpwala.&gt;&gt; <verse eid="2SA 17:3" /><verse number="4" style="v" sid="2SA 17:4" />Sǝ mǝno yì kwarkiru ka pwasǝbum Absalom andǝ aɓwana-mǝgule mala Isǝrayila kat.<verse eid="2SA 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5" />Pǝlǝa Absalom bang ama, &lt;&lt;Wu tunǝ Hushai ɓwa'Arki gbal ɓǝ̀ sǝm o cau mǝnana nǝ na ka.&gt;&gt; <verse eid="2SA 17:5" /><verse number="6" style="v" sid="2SA 17:6" />Sǝ lang Hushai yina aban Absalom ngga, Absalom ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Ahitofel bang ngga; ɓǝ̀ sǝm pak kǝla mǝnana na ka le? Ɓǝ̀ pa anggo raka, we ka bangŋa.&gt;&gt;<verse eid="2SA 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7" />Pǝlǝa Hushai ne Absalom ama, &lt;&lt;Mǝnia adyan ngga, cau mǝnana Ahitofel bang ngga, mǝɓoarne na ɗang.&gt;&gt; <verse eid="2SA 17:7" /><verse number="8" style="v" sid="2SA 17:8" />Hushai bang ama, &lt;&lt;A sǝlǝna ama tárró andǝ aburana male ka, akanggǝrang aɓwana na, sǝ à ndanǝ bumlulla mǝkǝ̀rkǝ́rnì kǝla nyam-candǝa mǝnana à gauwi andǝ amuni a ɓawanban ngga.<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 17:12">Pas 17:12</ref>; <ref loc="HOS 13:8">Hos 13:8</ref></char>.</note> Ko anggo raka, tárró ka gbani lwa na; pà nǝ̀ nong atà aɓwana aɓa dù ɗàng. <verse eid="2SA 17:8" /><verse number="9" style="v" sid="2SA 17:9" />Sǝni, ko ado ka, sǝmbǝrǝna a ɓekǝ tūli, ko a ɓekǝ ban. Ɓǝ̀ puro sǝ yiu arǝ wun nǝ munǝo, sǝ wal atà aburana mô kpokyak ka, cau nǝ̀ mesǝ ama, &lt;À walna aɓwana mǝnana à nda atà Absalom ngga.&gt; <verse eid="2SA 17:9" /><verse number="10" style="v" sid="2SA 17:10" />Ko nggearǝ ɓwabura-ɓwa mǝnana ɓabumi na kǝla ɓabum im<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="AMO 3:8">Amo 3:8</ref></char>.</note> ngga, ɓangciu nǝ̀ pakki wi, sǝ ɓabumi nǝ̀ tùmùr, acemǝnana Isǝrayila kat ka sǝlǝna ama tárró ka kanggǝrang ɓwabura na, sǝ aɓwana mǝnana à nda atè ka, amǝ'mǝsǝkàng-kàngŋa na. <verse eid="2SA 17:10" /><verse number="11" style="v" sid="2SA 17:11" />Sǝama kwarkiru mem ngga, nda mǝnana ama Isǝrayila kat ɓǝ̀ ramba a bano abanɓwáná, twal a Dan, aban ká a Biyasheba; lakki malea ɓǝ̀ pa kǝla sala a kún nggeamùr,<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 22:17">Tite 22:17</ref></char>.</note> sǝ wu kya a lwa nǝ nggearǝo. <verse eid="2SA 17:11" /><verse number="12" style="v" sid="2SA 17:12" />Pǝlǝa sǝm nǝ̀ ká amurí a ɓè ban mǝnana à nǝ̀ gandǝ kume kàm ngga, sǝ sǝm nǝ̀ sulǝ amurí kǝla sulǝo mala ncimna a nzali, sǝ yì andǝ aburana mǝnana à nda atè ka, kǝɓwa pà nǝ̀ au ɗàng. <verse eid="2SA 17:12" /><verse number="13" style="v" sid="2SA 17:13" />Ɓǝ̀ nyar nǝnzǝmi sǝ kútí a ɓekǝ nggea-là ka, Isǝrayila kat ka nǝ̀ yinǝ anggur ɓǝ̀ kàrì nggea-lê, sǝ sǝm nǝ̀ nunni aɓa ɓangŋaban, sheɓǝ̀ tali mwashat pa kàm mǝnana nǝ̀ ue kam raka.&gt;&gt; <verse eid="2SA 17:13" /><verse number="14" style="v" sid="2SA 17:14" />Pǝlǝa Absalom andǝ amǝ Isǝrayila kat bang ama, &lt;&lt;Kwarkiru mala Hushai ɓwa'Arki ɓoarî mala Ahitofel.&gt;&gt; (Yahweh ka, angŋǝna dǝmba tsǝ̀ngŋǝ̀nà<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 21:30">Pas 21:30</ref>; <ref loc="1CO 1:19">1Kor 1:19</ref></char>.</note> ama nǝ̀ kiɗiki<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="2SA 15:31-34">2Sam 15:31-34</ref></char></note> kwarkiru mǝɓoarne mala Ahitofel, ace mǝnana Yahweh nǝ̀ yinǝ gir'murmwana amur Absalom ngga.)<verse eid="2SA 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15" />Pǝlǝa Hushai banggi Zadok andǝ Abiyata yià apǝris ama, &lt;&lt;Kwarkiru mǝnana Ahitofel pe Absalom andǝ aɓwana-mǝgule mala amǝ Isǝrayila ka, ndya ani ka, sǝ mim ngga kwarkiru mana ǝn pa ka, ani sǝ pa. <verse eid="2SA 17:15" /><verse number="16" style="v" sid="2SA 17:16" />Ado ka, túrban tsuk-tsuk ɓǝà banggi Dauda ama, &lt;Kǝa nong a kún nggeasala, ban yàl nkaring mala ká a ɓabondo yalung ɗàng; ɓariki yàl a nkaring,&gt; ɓǝ̀ ana raka, murǝm andǝ aɓwana mǝnana atè kat ka, à nǝ̀ kiɗikia.&gt;&gt;<verse eid="2SA 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17" />Adyan ngga, Jonatan andǝ Ahimaz ka, à nda aban kúndǝô a En-Rogel. Ɓè guro muna-ɓwama na kǝ wario kǝ banggia wia, sǝ yià gbal ka à nǝ̀ ká à nǝ̀ banggi Murǝm Dauda, ace mǝnana ɓǝà kǝa sǝnia aban kútí aɓa nggea-là raka. <verse eid="2SA 17:17" /><verse number="18" style="v" sid="2SA 17:18" />Sǝama ɓekǝ lagga sǝnia sǝ kya ne Absalom. Anggo sǝ yià kǝm ngga à o tsuk-tsuk, sǝ à bik ɓala mala ɓekǝ ɓwabura a Bahurim mǝnana ndanǝ tūli-mùr a ɓala male ka. Sǝ à sulǝ aɓa tūli-mùrnî. <verse eid="2SA 17:18" /><verse number="19" style="v" sid="2SA 17:19" />Pǝlǝa mālá ɓwabure twal kál-anzǝgir, sárǝí a kún tūli-mùrnî sǝ anzǝ mǝsǝsa amurí. Kǝɓwa sǝlǝce gìr mǝnana pàk ka ɗàng. <verse eid="2SA 17:19" /><verse number="20" style="v" sid="2SA 17:20" />Lang aguro mala Absalom yiu aban ɓwame a ɓala ka, à ɗi ama, &lt;&lt;Ahimaz andǝ Jonatan ngga à ndake?&gt;&gt; Pǝlǝa ɓwame banggia wia ama, &lt;&lt;À yàlnà a nkaring guguri.&gt;&gt; Lang à kya altea sǝ à gandǝ kumia raka, à nyar a Urǝshalima.<verse eid="2SA 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21" />Anzǝm mǝnana à umǝna ka, aburane eapi ɓá tūli-mùrnî, sǝ à wario à kya ne Murǝm Dauda. À banggi Dauda ama, &lt;&lt;Lo, o tsuk-tsuk kya yàl a nkaring mùr, acemǝnana Ahitofel pana kwarkiru amuro ani.&gt;&gt; <verse eid="2SA 17:21" /><verse number="22" style="v" sid="2SA 17:22" />Pǝlǝa Dauda lo andǝ aɓwana mǝnana à nda atè ka, sǝ à kya yàlî Mùr Jodan. Kaniama ban nǝ̀ fa ka, kǝ ɓwa pà kàm mǝnana malaká yàlî Jodan raka ɗàng.<verse eid="2SA 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23" />Lang Ahitofel sǝni ama à kpata kwarkiru male raka, sárǝ́ gir-do a nzǝm mǝdambǝriso male, lo o a nggea-là male. Wario kya tsǝk ɓala male a nggùnì sǝ gyar ɓamúrì,<note caller="+" style="f"><char style="fr" closed="false">17:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 27:5">Mat 27:5</ref></char>.</note> wǔ, sǝ à tsǝì a ɓembe-ɓa-tali mala tárrí.<verse eid="2SA 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24" />Pǝlǝa Dauda yiu a Mahanayim. Sǝ Absalom andǝ aburana mala Isǝrayila kat ka, à yàlî Mùr Jodan. <verse eid="2SA 17:24" /><verse number="25" style="v" sid="2SA 17:25" />Absalom angŋa-dǝmba tsǝ̀ngŋǝ̀nà Amasa<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="fq" closed="false">Amasa </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 19:13">2Sam 19:13</ref>; <ref loc="2SA 20:9-12">20:9-12</ref>; <ref loc="1KI 2:5">1Amur 2:5</ref>,<ref loc="1KI 2:32">32</ref></char>.</note> amur amǝ'lwa, a kúnì Jowap. Amasa ka muna-ɓwabura mala ɓè ɓwa na, mǝnana à kǝ tunǝi ama Itǝra, ɓwa'Ishmayel, mǝnana al Abigiyel muna-ɓwama mala Nahash,<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="fq" closed="false">Nahash </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CH 2:13">1Acau 2:13</ref>,<ref loc="1CH 2:16">16</ref> </char>.</note> mǝ'eam Zeruya, nggea Jowap ka. <verse eid="2SA 17:25" /><verse number="26" style="v" sid="2SA 17:26" />Sǝ Isǝrayila andǝ Absalom ngga à tsǝk kàttì a nzali Gilǝyat.<verse eid="2SA 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27" />Lang Dauda yiu a Mahanayim ngga, Shobi muna-ɓwabura mala Nahash,<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="fq" closed="false">Nahash </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 10:1-2">2Sam 10:1-2</ref></char>.</note> ɓwa'Amon mǝnana pur a Rabba, andǝ Makir muna-ɓwabura mala Amiyel mǝnana pur a Lo-debar ka,<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="fq" closed="false">Lo-debar </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 9:4">2Sam 9:4</ref></char></note> andǝ Barzilayi ɓwa'Gilǝya mǝnana pur a Rogelim<note caller="+" style="f"><char style="fr" closed="false">17:27 </char><char style="fq" closed="false">Rogelim </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 19:31-32">2Sam 19:31-32</ref>; <ref loc="1KI 2:7">1Amur 2:7</ref>; <ref loc="EZR 2:61">Ezr 2:61</ref></char>.</note> ngga, <verse eid="2SA 17:27" /><verse number="28" style="v" sid="2SA 17:28" />à yinǝ akal-nongŋo, andǝ ankenye, andǝ ankwaring-dǝɓang, sǝ mǝssa mǝnana à lurǝi ka, andǝ mǝssa-alkama, andǝ mǝssa-bálì, andǝ muku, andǝ gwalong, andǝ mǝsǝ-nkunding, <verse eid="2SA 17:28" /><verse number="29" style="v" sid="2SA 17:29" />andǝ mur-nyi, sǝ kiura mǝbwale, andǝ anzur, andǝ kiura-mǝpange, à pe Dauda andǝ aɓwana mǝnana à nda atè ka ɓǝà li, acemǝnana à bang ama, &lt;&lt;Aɓwana mǝnia ka nzala walǝnia, à aulǝna, sǝ mǝsamur walǝnia aɓa pǝɗanban.&gt;&gt;<verse eid="2SA 17:29" /></para>
  <chapter eid="2SA 17" />
  <chapter number="18" style="c" sid="2SA 18" />
  <para style="s">À gandǝ Absalom a lwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1" />Pǝlǝa Dauda ramba aburana mǝnana à nda atè ka, sǝ tsǝk amǝ'sàrǝ̀ban mala aá andǝ amǝ'sàrǝ̀ban mala agbǝman amúrià. <verse eid="2SA 18:1" /><verse number="2" style="v" sid="2SA 18:2" />Pǝlǝa Dauda tasǝ amǝ'lwa ɓǝà kyane; tsǝk banì mwashat aɓa gauwe tàrú malea aɓata sàrǝ̀ban mala Jowap, sǝ ɓè banì mwashat aɓa gauwe tàrú ka, nda aɓata sàrǝ̀ban mala Abishai muna-ɓwabura mala Zeruya, mǝ'eam Jowap, sǝ tàruia banì mwashat aɓa gauwe tàrú ka, nda aɓata sàrǝ̀ban mala Ittayi ɓwa'Gitti. Pǝlǝa murǝm banggi aburane ama, &lt;&lt;Mim nǝ ɓamúràm gbal ka, mǝ nǝ ká sǝnǝa wun.&gt;&gt; <verse eid="2SA 18:2" /><verse number="3" style="v" sid="2SA 18:3" />Sǝama aburane ne wi ama, &lt;&lt;A pà wu nǝ pur ace ká [munǝo] atà sǝm ɗàng. Acemǝnana ɓǝ̀ sǝm ɓang ngga, à pa nǝ̀ falǝnǝ sǝm ɗàng. Sǝ ko ɓǝ̀ gauwa-tsùrú ma'sǝm wù ka, à pa nǝ̀ falǝnǝ sǝm ɗàng. Sǝ we ka, a nda akúnì lakki mala aɓwana ma'sǝm á-lum. Acemani ka, nǝ̀ ɓoaribani wu tasǝa sǝm gbasha nǝ ɓá nggea-là.&gt;&gt; <verse eid="2SA 18:3" /><verse number="4" style="v" sid="2SA 18:4" />Pǝlǝa murǝm banggia wia ama, &lt;&lt;Koyagir mǝnana kat, wu sǝni nda ɓoaro kutibani ka, mǝ nǝ pe.&gt;&gt; Nda murǝm cam a nkanggari bankutio [mala Mahanayim], sǝ aburana male kat ging-gya twalkusǝu-anzǝmarǝia sǝ à kǝ kutio aban puro arǝ anggǝsanì malea, mala agbǝman andǝ aá.<verse eid="2SA 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 18:5" />Pǝlǝa murǝm tsǝki Jowap andǝ Abishai andǝ Ittai nzongcau ama, &lt;&lt;Lagga man, yì Absalom ngga, wu pangnǝi ɓukɓuk, acem.&gt;&gt; Sǝ amǝ'lwa kat ok cau mǝno murǝm ne amǝ'sàrǝ̀ban, amur Absalom ngga.<verse eid="2SA 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6" />Nda amǝ'lwa mala Dauda purî ɓá nggea-là aban ká lwa arǝ Isǝrayila. Mǝnia yì munǝo ka, à pe a ndà-nggun mala bu-nzali Ifǝrem. <verse eid="2SA 18:6" /><verse number="7" style="v" sid="2SA 18:7" />Akano ka, amǝ'lwa mala Dauda gandǝ amǝ'lwa mala Isǝrayila. Sǝ aɓwana mǝnana à wal-luia ka, à nda kpǝm. À wal-lú aɓwana á-lumi-ɓari (20,000). <verse eid="2SA 18:7" /><verse number="8" style="v" sid="2SA 18:8" />Kara lwa ara ak ɓá nzali kat, sǝ ɓwabundǝa wù kǝ̀rkǝ́r. Yale làkkì mala aɓwana mǝnana à wù atàcau mala agir'mur'mwana mǝnana kum aɓwe aɓa ndà-nggun ngga, kútì làkkì mala aɓwana mǝnana à wal-luia nǝ nggeabyau ka.<verse eid="2SA 18:8" /></para>
  <para style="s">Lú mala Absalom</para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9" />Lang munǝo na arǝ lidǝmba ka, Absalom kya jakiarǝ aburana mala Dauda. Sǝ yì ka, ɓariki nǝ̀ ɓangŋa a nzǝm pǝr-mǝdambǝriso male ace àwá, sǝama lang pǝr-mǝdambǝriso ɓangŋa kútí aɓata ɓè nggun mǝgule mana abu-nggunì na zukǝtǝp ka, kara ɓamúrí gbāli a nre ka abu-nggunì. Sǝ pǝr-mǝdambǝrisonî lidǝmba nǝ o, ɗeki aban gyare a nre bumkuli andǝ nzali.<verse eid="2SA 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10" />Mwashat aɓalǝ aburana mala Dauda sǝn mǝnia yì gìr ka, sǝ banggi Jowap ama, &lt;&lt;Ən sǝn Absalom aban gyare arǝ ɓè bu-nggun mǝgule.&gt;&gt; <verse eid="2SA 18:10" /><verse number="11" style="v" sid="2SA 18:11" />Jowap pǝlǝa ɗì ɓwabure ama, &lt;&lt;Mana! A sǝni? Palang sǝ a ɓinǝ wal-luí, a túrí a nzali akǝ̀ banì ɗàng? Yale ɓǝ́n pano amǝsǝ bolo-azǝrfa shekel lum andǝ nggur-ɓunu mala amǝ'lwa.&gt;&gt;<verse eid="2SA 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12" />Sǝ ɓwabure eari wi ama, &lt;&lt;Ko ɓǝ̀ a pam amǝsǝ bolo-azǝrfa shekel á-mwashat aɓa buam ngga, pà mǝ nǝ tsǝk buam arǝ muna-ɓwabura mala murǝm ɗàng, acemǝnana sǝm kat ka, sǝm oè nǝ kir sǝm, lang murǝm tsǝko nzongcau wunǝ Abishai andǝ Ittai, ama, &lt;Wu tsǝkir mǝlagga, yì Absalom, acem.&gt; <verse eid="2SA 18:12" /><verse number="13" style="v" sid="2SA 18:13" />Sǝ ɓǝn mangŋǝna murǝm, ǝn walna-lú muna-ɓwabura male ka, murǝm nǝ̀ yia sǝlǝ nǝnzǝ́mò ama, mǝ nda mǝnana ǝn wal-lú muni ka, sǝ we nǝ nggearǝo ka, awu nǝ nyem.&gt;&gt;<verse eid="2SA 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14" />Pǝlǝa Jowap bang ama, &lt;&lt;Mim ngga, pa mǝ nǝ kiɗiki pwari kǝla mǝnia sǝnǝ we ɗàng.&gt;&gt; Pǝlǝa Jowap twal ankongŋo tàrú a bui, wari aban Absalom, mǝnana nda nǝyilǝmu piu, aban gyare a bu-nggun mǝgule ka. Pǝlǝa zuɓiki nǝ ankongŋo mǝno ka a kun-ɓalǝi. <verse eid="2SA 18:14" /><verse number="15" style="v" sid="2SA 18:15" />Pǝlǝa lum aɓalǝ amǝ'bwal-agirmunǝo mala Jowap, gumbǝli Absalom a ɓalǝu, à tǝmnggi, sǝ à wal-luí.<verse eid="2SA 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16" />Pǝlǝa Jowap twang njawe, nda amǝ'lwa male nyarî pǝrta amǝ'lwa mala Isǝrayila, acemǝnana Jowap tamsǝia ka. <verse eid="2SA 18:16" /><verse number="17" style="v" sid="2SA 18:17" />À twal Absalom, à túrí aɓa tūli mǝlime aɓa ndà-nggun, sǝ à ramba atali amurí gum-gum. Sǝ anggo ka, amǝ Isǝrayila kat ɓangŋǝna, koyanale ka umǝna a ɓala male.<verse eid="2SA 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18" />(Mǝnana Absalom malaká wù raka, tsǝkî ɓamúrì nggea tali, a Ɓangŋaban mala Murǝm, ace mǝnana ɓǝ̀ duk gir'lǝmndǝa ace lidǝmba mala lullǝi ka. Acemǝnana pakɗenyicau ama, &lt;&lt;Mim ngga, ǝn panǝ muna-ɓwabura mana nǝ lidǝmba nǝ lullǝam a ɓanza, mana à nǝ̀ nggǝ ɗenyinǝ mim nǝi ka ɗàng.&gt;&gt; Pǝlǝa tunǝ nggea tali mǝno nǝ lullǝì. Anggo sǝ à kǝ tunǝi ama, &lt;&lt;Nggea tali mala Absalom,&gt;&gt; ba yalung.)<note caller="+" style="f"><char style="fr" closed="false">18:18 </char><char style="ft" closed="false">Absalom tsǝk nggea tali mǝnia ka a bàkú mǝnana malaká ɓǝl amuna-burana male raka (</char><char style="xt"><ref loc="2SA 14:27">2Sam 14:27</ref></char>); ko à wukina sǝ tsǝk talinì.</note><verse eid="2SA 18:18" /></para>
  <para style="s">Cau mala lú mala Absalom <optbreak /> andǝ bumkiɗikea mala murǝm Dauda</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19" />Pǝlǝa Ahima'az muna-ɓwabura mala Zadok bang ama, &lt;&lt;Came, ɓǝn ɓangŋa, ɓǝn kyan nǝ bǝsacau man aban murǝm; mǝ nǝ nggá ne wi ama Yahweh kasǝna-ɓashi, angŋamurí a bù aɓi-mǝbura.&gt;&gt;<verse eid="2SA 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20" />Pǝlǝa Jowap ne wi ama, &lt;&lt;A nda mǝnana awu nǝ ká nǝ mǝnia yì bǝsacau yalung ngga ɗàng. Awu nǝ gandǝnǝ ká nǝi wi nǝ cê a ɓè pwari, sǝama dumǝna púp a pà wu nǝ ká nǝ cê yalung ɗàng, acemǝnana muna-ɓwabura mala murǝm [yì Absalom] ngga, pàngŋǝ̀nà-lú.&gt;&gt;<verse eid="2SA 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21" />Pǝlǝa Jowap ne ɓè ɓwa'Kush ama, &lt;&lt;We, kya banggi murǝm gìr mǝnana a sǝni ka.&gt;&gt; Pǝlǝa ɓwa'Kush ɓun aɓadǝm Jowap, sǝ ɓangŋa aban o.<verse eid="2SA 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22" />Pǝlǝa Ahima'az, muna-ɓwabura mala Zadok ne Jowap ɗǝm ama, &lt;&lt;Ko palang le ka, ida, came mǝ ɓangŋa atà ɓwa'Kush mǝno.&gt;&gt; Sǝ Jowap pe wi eare ama, &lt;&lt;Muna-ɓwabura mem, ace mana sǝ a kǝ earce ama a nǝ ká? We ka, a panǝ kǝ tangnakusǝu mǝnana awu nǝ̀ kum ace mǝnia yì bǝsacau ka ɗang.&gt;&gt;<verse eid="2SA 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23" />Pǝlǝa Ahima'az bang ama, &lt;&lt;Ko palang le ka, mǝ nǝ ɓangŋa, mǝ nǝ ká.&gt;&gt;</para>
  <para style="p" vid="2SA 18:23">Pǝlǝa Jowap bang ama, &lt;&lt;Ɓangŋa!&gt;&gt; Pǝlǝa Ahima'az ɓangŋa, um nǝ njar ɓawanban, sǝ ɓangŋa akì ɓwa'Kush dǝmba.<verse eid="2SA 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24" />Lang Dauda na ban do anre kúnɓala mana nǝ ɓalǝu andǝ mana nǝ nza mala nggea-lê ka, mǝ'sǝn múr nggea-là eau a kuli amur kún nggea-là nǝ rǝ sheran. Lang loasǝ mǝsǝi sǝnban ngga, kara sǝn ɓè ɓwabura aban ɓang nǝmurǝi aban yiu nǝbania. <verse eid="2SA 18:24" /><verse number="25" style="v" sid="2SA 18:25" />Pǝlǝa mǝ'sǝn múr nggea-là tunǝ murǝm sǝ banggi wi gìr mǝnana sǝn ngga. Murǝm pǝlǝa bang ama, &lt;&lt;Ɓǝ̀ ɓwe na nǝmurǝi ka, dumǝna púp ndanǝ bǝsacau.&gt;&gt; Sǝ ɓwe kǝ gbàshìban tù kǝ yiu. <verse eid="2SA 18:25" /><verse number="26" style="v" sid="2SA 18:26" />Pǝlǝa mǝ'sǝn múr nggea-là sǝn ɓè ɓwabura aban yiu nǝ mire, pǝlǝa tunǝ mǝ'yál kunɓala sǝ bang ama, &lt;&lt;Sǝni, ɓè ɓwabura nia ɗǝm kǝ yiu nǝ mire nǝmurǝi ka!&gt;&gt; Pǝlǝa murǝm bang ama, &lt;&lt;Yì gbal ka, dumǝna púp ndaban yinǝ bǝsacau.&gt;&gt; <verse eid="2SA 18:26" /><verse number="27" style="v" sid="2SA 18:27" />Pǝlǝa mǝ'sǝn múr nggea-là na ama, &lt;&lt;Ən nggǝ sǝni, ɓwa mǝdǝmbe ka, kǝ ɓangŋa kǝla Ahima'az muna-ɓwabura mala Zadok.&gt;&gt; Murǝm pǝlǝa bang ama, &lt;&lt;Yì ka, ɓwa mǝɓoarne na. Ndaban yinǝ bǝsacau mǝɓoarne.&gt;&gt;<verse eid="2SA 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28" />Pǝlǝa Ahima'az loasǝ gì tunǝ murǝm sǝ ne wi ama, &lt;&lt;Koman kat ka, nda pepè!&gt;&gt; Pǝlǝa yì ka, ɓùn aɓadǝm murǝm nǝ ɓamǝsǝi a nzali, sǝ bang ama, &lt;&lt;Ɓǝ̀ ɓwangsǝban pa aban Yahweh Ɓakuli mô, mǝnana pàna amǝ'mgbicau a ɓabuo ka, yià mǝnana à loasǝ buia arǝ ɓwamǝgule mem murǝm ngga.&gt;&gt;<verse eid="2SA 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29" />Pǝlǝa murǝm ɗìban ama, &lt;&lt;Nggearǝ lagga, yì Absalom ngga, nda jam le?&gt;&gt; Pǝlǝa Ahima'az pa eare ama, &lt;&lt;Lang Jowap guro mò tasǝam ama ɓǝn yiu ka, ǝn sǝn ban ngga, zurina kǝ̀rkǝ́r. Sǝama, ǝn súrǝ̀ mana girni na ɗang.&gt;&gt;<verse eid="2SA 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30" />Pǝlǝa murǝm bang ama, &lt;&lt;Nyar a nkanggariban, kúndǝô.&gt;&gt; Nda yi ka, nyar a nkanggariban, sǝ cam a kǝ banì.<verse eid="2SA 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31" />Pǝlǝa ɓwa'Kush yi tusǝo, sǝ bang ama, &lt;&lt;Ɓwamǝgule mem, murǝm, ok mǝnia yì bǝsacau mǝɓoarne ka! Yahweh amsǝno yalung, a ɓabù aɓwana mǝnana kat à mgbicau arǝò ka.&gt;&gt;<verse eid="2SA 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32" />Pǝlǝa murǝm ɗì ɓwa'Kush ama, &lt;&lt;Mǝlagga Absalom ngga, nda jam le?&gt;&gt; Pǝlǝa ɓwa'Kush pa eare ama, &lt;&lt;Ɓǝ̀ aɓi-mǝbura kat mala ɓwamǝgule mem murǝm, andǝ aɓwana mǝnana kat à mgbicau arǝì ace ɓealɓikea ka, ɓǝà pa kǝla mǝno yì lagga ka!&gt;&gt;<verse eid="2SA 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33" />Pǝlǝa murǝm ngga, rǝì twal ɓǝla. Sǝ eauwe, wari a kurǝm-kuli mana amur kunɓala ka, ɓua kàm. A njar aban ká ka, kǝ ɓua kǝ na ama: &lt;&lt;Oi, muna-ɓwabura mem Absalom! Muna-ɓwabura mem, muna-ɓwabura mem Absalom! Ɓǝ̀ pǝlǝa ama, mǝ nda mǝnana ǝn wú a kunio ka, ɓǝ́ ɓoarna, oi muna-ɓwabura mem Absalom, muna-ɓwabura mem!&gt;&gt;<verse eid="2SA 18:33" /></para>
  <chapter eid="2SA 18" />
  <chapter number="19" style="c" sid="2SA 19" />
  <para style="s">Dauda andǝ Jowap</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1" />Pǝlǝa à banggi Jowap ama, &lt;&lt;Sǝni, murǝm ngga, ndaban ɓua sǝ kǝ keban ace Absalom.&gt;&gt; <verse eid="2SA 19:1" /><verse number="2" style="v" sid="2SA 19:2" />Limurǝm mǝnana à kumi a pwari mǝno ka, yi pǝlǝia amǝ'lwa kat ɓua-lú, acemǝnana a pwari mǝno ka, aɓwe ok ama, &lt;&lt;Murǝm na ban pak-bumkiɗikea ace muni.&gt;&gt;<verse eid="2SA 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 19:3" />Sǝ aburane kùtí zàng aɓa nggea-lê [Mahanayim] a pwari mǝno, kǝla aɓwana mǝnana à ɓangŋa a kun-munǝo, kǝsǝkea pakkia wia, sǝ à swár zàng à kùtí aɓa nggea-là ka. <verse eid="2SA 19:3" /><verse number="4" style="v" sid="2SA 19:4" />Murǝm ngga gìr ɓamǝsǝi, sǝ sa a ɓua, kǝ na ama, &lt;&lt;Oi, muna-ɓwabura mem Absalom! Oi, Absalom, muna-ɓwabura mem, muna-ɓwabura mem!&gt;&gt;<verse eid="2SA 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5" />Pǝlǝa Jowap kùtí aɓa ɓala, aban murǝm, sǝ banggi wi ama, &lt;&lt;Yalung ngga, a panì aburana mô kat kǝsǝkea, yià aɓwana mǝnana à nda à amsǝ yilǝmo andǝ ayilǝmi amuna-burana andǝ amuna-mamǝna mô, andǝ ayilǝmi amāmó andǝ amā-twala mô ka. <verse eid="2SA 19:5" /><verse number="6" style="v" sid="2SA 19:6" />We ka, a kǝ earce aɓwana mana à kǝ ɓinǝmǝsǝo ka, sǝ a kǝ ɓinǝmǝsǝ aɓwana mana à kǝ earceo ka. Acemǝnana yalung ngga, a lǝmdǝni bwāng ama, amǝ'sàrǝ̀ban andǝ aburana mô ka, à nda ka kǝgir a bano ɗàng. Mim ngga, ǝn sǝlǝna ama, ban nǝ ɓoaro yalung, mǝnana ɓǝ̀ Absalom ngga nda nǝyilǝmu, sǝ sǝm kat ka, sǝm wukina ka. <verse eid="2SA 19:6" /><verse number="7" style="v" sid="2SA 19:7" />Adyan ngga, puro kya ɓakɓabum aburana mô. Mim ngga, ǝn kánagìr nǝ Yahweh, ɓǝ̀ a puro, a wari raka, kǝ ɓwabura pà kàm mǝnana nǝ̀ ue atò, a bu-dù man yalung ngga ɗàng. Sǝ mǝnia yì gìr ka, nǝ̀ duk mǝɓike kǝ̀rkǝ́r, mǝnana kútì agir'murmwana mǝnana kat à kumo, twal a lagga mò, ba yalung ngga.&gt;&gt;<verse eid="2SA 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8" />Pǝlǝa murǝm lo, kya do a ban-do male a kún nggea-là. Lang à banggi aɓwana ama, &lt;&lt;Murǝm na aban do a kún nggea-là ka,&gt;&gt; pǝlǝa yià kat ka, à yiu aɓadǝmbi. (Aɓa mǝno anggo ka, amǝ Isǝrayila [mǝnana à nda atà Absalom ngga] à angŋa-dǝmba à ɓangŋǝna, koyan ngga nyarna a ɓala male.)<verse eid="2SA 19:8" /></para>
  <para style="s">Dauda nyar a Urǝshalima</para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9" />Sǝ aɓalǝ atau mala Isǝrayila ka, aɓwana camarǝ makgir arǝarǝia, à kǝ bang ama, &lt;&lt;Murǝm ngga, nda mǝnana akmúr sǝm a ɓabu aɓisǝm-mǝbura ka; yi ka, nda ɓwa mǝnana amsǝ sǝm a ɓabu amǝ'Filisti ka. Sǝ adyan ngga, ɓangŋǝna nyingŋǝna nzali ace mǝnana ɓǝ̀ apî Absalom ngga; <verse eid="2SA 19:9" /><verse number="10" style="v" sid="2SA 19:10" />sǝ Absalom, mǝnana sǝm ɗārǝí, ɓǝ̀ duk murǝm amur sǝm ngga, wuna a kun-munǝo. Sǝ palang ado sǝ wu na kǝ cau, ace nyesǝ murǝm ɗàng?&gt;&gt;<verse eid="2SA 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11" />Pǝlǝa Dauda tasǝ mǝnia yì cau ka, aban Zadok andǝ Abiyata, yià apǝris, ama: &lt;&lt;Wu ɗikâm aɓwana-mǝgule mala Yahuda ama, &lt;Palang ado, sǝ wun nda ka aɓwana mana, she nǝnzǝ́mò, sǝ wun nǝ̀ nyesǝ murǝm a ɓala male ka, yi mǝnana gìr mana kat à bangŋi aɓa Isǝrayila ka, kutina a kir murǝm ngga? <verse eid="2SA 19:11" /><verse number="12" style="v" sid="2SA 19:12" />Wu nda ka amǝ'eambǝam; wu nda ka nggūrǝam andǝ nkila mem! Sǝ ace mana sǝ wun nda ka aɓwana mǝnana she nǝnzǝ́mò sǝ wun nǝ̀ nyesǝ murǝm a palta ka?&gt; <verse eid="2SA 19:12" /><verse number="13" style="v" sid="2SA 19:13" />Sǝ wu ne Amasa ama, &lt;We ka, a nda nggūrǝam andǝ nkila mem re? Ɓǝ̀ Ɓakuli pakkam gìr, yale ɓǝ̀ wal-luem, yi mana ɓǝn twalo a duk mǝ'sàrǝ̀ban amur amǝ'lwa mem, a kúnì Jowap raka.&gt; &gt;&gt; <verse eid="2SA 19:13" /><verse number="14" style="v" sid="2SA 19:14" />Nda Amasa pwanɓabum aburana mala Yahuda kat, kǝla ɓwa mwashat, sǝ à tasǝî murǝm cau ama, &lt;&lt;Nyar aban sǝm, we wunǝ aburana mana kat à nda atò ka.&gt;&gt; <verse eid="2SA 19:14" /><verse number="15" style="v" sid="2SA 19:15" />Pǝlǝa murǝm nyare, yiu a Jodan. Adyan ngga, aburana mala Yahuda yina a Gilgal, ace mǝnana ɓǝà kya kum murǝm, sǝ ɓǝà yinǝi a nkaring Mùr Jodan ngga.<verse eid="2SA 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 19:16" />Sǝ Shimeyi, muna-ɓwabura mala Gera, ɓwa'Benjami, mana pur a Bahurim ngga, fà rǝì akaurǝa andǝ aburana mala Yahuda, à wari a kúllí Murǝm Dauda. <verse eid="2SA 19:16" /><verse number="17" style="v" sid="2SA 19:17" />Yiu atārǝia andǝ aburana a tàu mala Benjami, ɓwa á-mwashat, andǝ Ziba, muna-ɓala mala Sawul, mǝnana yiu andǝ amuna-burana male lum-nong-tongno, andǝ amǝ'túró-ɓala male, lumi-ɓari ka. Yia ka, à fà rǝia, à wari a kúllí murǝm, a Jodan. <verse eid="2SA 19:17" /><verse number="18" style="v" sid="2SA 19:18" />Yia ka, à yàlî mùr Jodan, a ban yàl nkaring, ace eamsǝki amǝ'ɓala mala murǝm a nkaring, ace mǝnana à nǝ̀ pwasǝbum murǝm ngga. Pǝlǝa Shimeyi, muna-ɓwabura mala Gera, ɓùn amur ankūnǝi a nzali, aɓadǝm murǝm, <verse eid="2SA 19:18" /><verse number="19" style="v" sid="2SA 19:19" />sǝ banggi wi ama, &lt;&lt;We murǝm, ɓwamǝgule mem, ida, twàlâm-ban cauɓikea mem, cè a ɗenyinǝ gir mǝɓike mǝnana guro mò pá a pwari mǝnana ɓwamǝgule mem nying Urǝshalima ka ɗàng. Ida, murǝm ɓǝkǝa bwal mǝnia yì gìr ka a ɓabumi ɗàng. <verse eid="2SA 19:19" /><verse number="20" style="v" sid="2SA 19:20" />Acemǝnana mim guro mò ka, ǝn sǝlǝna nǝma, ǝn pangŋa cauɓikea. Nda gir mǝnana tsǝa sǝ mim, aɓalǝ aɓwana kat, mala ɓala mala Yisǝfu ka, ǝn ak dǝmba, ǝn yiu, mǝ nǝ yia kum murǝm, ɓwamǝgule mem ngga.&gt;&gt;<verse eid="2SA 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21" />Pǝlǝa Abishai, muna-ɓwabura mala Zeruya bang ama, &lt;&lt;Ɓoaro Shimeyi ka, ɓǝà wal-luí, acemǝnana yì ka sú ɓwa mǝnana Yahweh ɗārǝi ka re!&gt;&gt; <verse eid="2SA 19:21" /><verse number="22" style="v" sid="2SA 19:22" />Sǝama Dauda bang ama, &lt;&lt;Man oasǝ wun arǝàm le, wun amuna-burana mala Zeruya, mǝnana wun nǝ̀ dupam kǝla ɓibura a pwari man yalung ngga? Ɓoaro ɓǝà wal-lú kǝɓwa aɓa Isǝrayila a pwari man yalung ngga le? Mim ngga, ǝn sǝlǝ mbak ama, yalung ngga mǝ nda murǝm amur Isǝrayila re?&gt;&gt; <verse eid="2SA 19:22" /><verse number="23" style="v" sid="2SA 19:23" />Pǝlǝa murǝm banggi Shimeyi ama, &lt;&lt;A pà wu nǝ wù ɗàng.&gt;&gt; Anggo sǝ murǝm kánbi wi.<verse eid="2SA 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24" />Sǝ Mefiboshet, mǝ'kà Sawul gbal ka, wario kya kum murǝm. Yi ka, lak akusǝi ɗàng, amsǝ mbotakuni ɗàng sǝ yale lak agir-nggūrǝu male ɗàng, twal a pwari mǝnana murǝm nying là, sǝ uk ka, ba pwari mǝnana murǝm nyar nǝi jam ngga. <verse eid="2SA 19:24" /><verse number="25" style="v" sid="2SA 19:25" />Lang nying Urǝshalima, sǝ yiu aban murǝm ngga, murǝm ɗì ama, &lt;&lt;Palang sǝ a ɓinǝ ká atàm, Mefiboshet?&gt;&gt; <verse eid="2SA 19:25" /><verse number="26" style="v" sid="2SA 19:26" />Mefiboshet pa eare ama, &lt;&lt;We ɓwamǝgule mem, murǝm, mǝturo-ɓala mem Ziba, nda mǝnana swarkiam ngga. Mim guro mò ka, mǝ nda gbakǝre, nda ǝn banggi wi nǝma, &lt;Tsǝkam gir-do anzǝm mǝdambǝriso, ace mǝnana ɓǝn koè ɓǝ̀ sǝm u sǝnǝ murǝm&gt; ngga. <verse eid="2SA 19:26" /><verse number="27" style="v" sid="2SA 19:27" />Sǝ yì ado ka, yi mangŋa guro mò, aban ɓwamǝgule mem, murǝm. Sǝama, ɓwamǝgule mem, murǝm ngga, nda kǝla mǝturonjar mala Ɓakuli; acemani ka, pàk gìr mǝnana kat pwasǝbumo ka. <verse eid="2SA 19:27" /><verse number="28" style="v" sid="2SA 19:28" />Mim sǝnǝ amǝ'ɓala mala tárrám ngga, ɓǝ́ a walna sǝm, sǝama a kún mani ka, a earam mǝ li girlina a ban-li mô. Ɓwamǝgule mem, murǝm, mana ɗǝm ado mǝ nǝ zǝmba, mǝnana nǝ̀ kútì mǝno ka?&gt;&gt;<verse eid="2SA 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29" />Pǝlǝa murǝm banggi wi ama, &lt;&lt;Cau mana a ne ka, karǝna anggo. Mim ngga, ǝn tsǝngŋa nzongcau ama, ɓǝà gau nzali ma'wun, anre wun, wun nǝ Ziba, a tsùrú.&gt;&gt;<verse eid="2SA 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30" />Sǝ Mefiboshet banggi murǝm ama, &lt;&lt;Ɗeki ɓǝ twal koyagir ka, yi mana yalung ado ɓwamǝgule mem, murǝm nyarǝna jam ngga.&gt;&gt;<verse eid="2SA 19:30" /></para>
  <para style="s">Dauda lǝmdǝì Barzilayi pěmǝɓoarne</para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31" />Barzilayi, ɓwa'Gilǝya gbal ka, pur a Rogelim, sǝ wari atà murǝm ace tsǝkte aban yàlî Nggeasala a Jodan, sǝ nǝ̀ tsǝiandà aban o a là. <verse eid="2SA 19:31" /><verse number="32" style="v" sid="2SA 19:32" />Barzilayi ka, jamgula na, apǝlǝa male na lumi-tongno-nong-tàrú. Yi ka, nda ɓwa mǝnana ɗenyinǝ murǝm, linǝi, aɓa do male kat a Mahanayim ngga, acemǝnana yì ka, mǝgǝna na kǝ̀rkǝ́r.<verse eid="2SA 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 19:33" />Pǝlǝa murǝm banggi Barzilayi ama, &lt;&lt;Fa, ɓǝ̀ sǝm yàl a nkaring sǝnǝ we, ace mǝnana wu kya do a banam a Urǝshalima ka. Sǝ mim ngga, mǝ nǝ ɗenyinǝ we abanì.&gt;&gt;<verse eid="2SA 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34" />Pǝlǝa Barzilayi pe murǝm eare ama, &lt;&lt;Apǝlǝa uekam shen, mala do nǝyilǝmu, mǝnana ɓoaro mǝ o a Urǝshalima sǝnǝ murǝm ngga? <verse eid="2SA 19:34" /><verse number="35" style="v" sid="2SA 19:35" />Adyan ngga, mǝ ndanǝ apǝlǝa lumi-tongno-nong-tàrú a ɓanza. Mǝ nǝ gandǝ gauta gìr mǝnana nǝ̀ ɓoaram ngga, andǝ mǝnana pà nǝ̀ ɓoaram raka le? Mim guro mò ka, mǝ nǝ gandǝ ok ɓoaro mala girlina ko girnùná ɗǝm le? Mǝ nǝ gandǝ ok gì aɓwana aban tu'nggyal ɗǝm le? Palang ado, sǝ mim guro mò ka, mǝ nǝ duk ɓè twalo aban ɓwamǝgule mem, murǝm? <verse eid="2SA 19:35" /><verse number="36" style="v" sid="2SA 19:36" />Ən kārǝa mǝ kum tangnakusǝu mǝgule kǝla mǝnia ka ɗàng. Mim guro mò ka, mǝ nǝ yàlî Jodan atārǝia andǝ murǝm aban ká dǝmba bǝti. <verse eid="2SA 19:36" /><verse number="37" style="v" sid="2SA 19:37" />Ida, nying guro mò, ɓǝ̀ nyare ɓǝ̀ o, ace mǝnana ɓǝn kya wú a là mem, tù aban ɓembe mala tárrám andǝ nggem. Sǝama, guro mò, yì Kimham ngga, ndya ka. Nyì ɓǝ̀ yàl a nkaring atò, ɓwamǝgule mem, murǝm. Pakki wi gìr mǝnana kat, a sǝni nda ɓoar a mǝsǝo ka.&gt;&gt;<verse eid="2SA 19:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38" />Pǝlǝa murǝm bang ama, &lt;&lt;Kimham ngga, sǝm nǝ̀ yàl a nkaring sǝnǝi, sǝ mǝ nǝ pakki wi gìr mǝnana kat a sǝni nda ɓoar ka. Sǝ gìr mǝnana kat a earkiyice abanam ngga, mǝ nǝ pakko wi.&gt;&gt;<verse eid="2SA 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39" />Pǝlǝa aɓwana kat, yàlî Nggeasala Jodan; sǝ lang murǝm yàlǝ́nì nkaring ngga, mǝn abui kùr Barzilayi zǝp, tsǝki wi bù, sǝ tsǝiandà. Nda Barzilayi nyare o a là male ka.<verse eid="2SA 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40" />Pǝlǝa murǝm kutio wari a Gilgal, sǝ Kimham o atè. Aɓwana mala Yahuda kat, andǝ gauwa-tsùrú mala amǝ Isǝrayila, tsǝkta murǝm amur njar, aban o a là.<verse eid="2SA 19:40" /></para>
  <para style="s">Tàu mala Yahuda andǝ Isǝrayila makgir amur murǝm</para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41" />Banì sau ɗang, aburana mala Isǝrayila kat yiu aban murǝm, sǝ à ɗì ama, &lt;&lt;Palang sǝ amǝ'eam sǝm, aburana mala Yahuda, iuo arǝ sǝm sǝ à eamsǝ murǝm andǝ amǝ'ɓala male, à yàlî Jodan, atārǝia andǝ aburana male kat?&gt;&gt; <verse eid="2SA 19:41" /><verse number="42" style="v" sid="2SA 19:42" />Pǝlǝa aburana mala Yahuda pe aburana mala Isǝrayila eare ama, &lt;&lt;Nda acemǝnana murǝm ngga, ɓǝla-nggurkwar ma'sǝm na ka. Sǝ palang ado sǝ bum wun lúllô amur mǝnia yì gìr ka? Ado ka, sǝm lì ɓekǝ gìr mala murǝm le? Sǝ wu sǝni sǝm twal ɓekǝ gìr abaní ace ɓamurǝ sǝm le?&gt;&gt;<verse eid="2SA 19:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43" />Pǝlǝa aburana mala Isǝrayila, pe aburana mala Yahuda eare ama, &lt;&lt;Sǝm ngga, sǝm ndanǝ atau lum aɓa domurǝm, acemani ka, rǝcandǝa mǝnana sǝm ndanǝi mala bang ama Dauda ka murǝm ma'sǝm na ka kútì ma'wun. Mana tsǝa ado sǝ wu ɓǝsǝki sǝm? Sǝm nda mǝnana sǝm tita nacau mala nyesǝ murǝm ma'sǝm ngga re?&gt;&gt; Sǝama nacau mala aburana mala Yahuda nǝ bumpina ka, kútì mala aburana mala Isǝrayila.<verse eid="2SA 19:43" /></para>
  <chapter eid="2SA 19" />
  <chapter number="20" style="c" sid="2SA 20" />
  <para style="s">Sheba mgbicau arǝ Dauda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1" />Ɓè ɓwabura <note caller="+" style="f"><char style="fr" closed="false">20:1 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="DEU 13:13">Nggur 13:13</ref></char>.</note>mǝ'ɓealɓana na kam, lullǝi ama Sheba, muna-ɓwabura mala Bikǝri, a tàu mala Benjami. Yì ka, ɓua njawe sǝ bang ama,</para>
  <para style="q1" vid="2SA 20:1">&lt;&lt;Sǝm pànǝ kǝ kāmbe aɓa Dauda ɗàng,</para>
  <para style="q2" vid="2SA 20:1">Sǝ sǝm pànǝ kǝ nzali liɓala aɓa muna-ɓwabura mala Jeshi ɗàng.</para>
  <para style="q1" vid="2SA 20:1">Isǝrayila, koyanale ka ɓǝ̀ nyar a gumli male!&gt;&gt;<verse eid="2SA 20:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="2SA 20:2" />Nda aburana mala Isǝrayila kat nying Dauda, sǝ à kpata Sheba muna-ɓwabura mala Bikǝri ka. Sǝama aburana mala Yahuda lanzǝ atà murǝm malea, twal a Jodan aban ká Urǝshalima.<verse eid="2SA 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3" />Lang Murǝm Dauda nyar a ɓala male a Urǝshalima ka, pwan amā-twala male lum mǝnana nyia ace ɗenyinǝ ɓala ka, tsǝia a ɓè ɓala, sǝ tamsǝ amǝ'yálban ɓǝà kǝ yália. Kǝ pea wia gìr mǝnana kat à paktǝle ka, sǝama pak-ɓwama nǝia ɗàng. À kasǝkunia a ɓala ba pwari lú malea, à do kǝla amā-lú.<verse eid="2SA 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4" />Pǝlǝa murǝm banggi <note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 17:25">2Sam 17:25</ref>; <ref loc="2SA 19:13">19:13</ref></char>.</note>Amasa ama, &lt;&lt;Rambam aburana mala Yahuda abanɓwáná aɓa nongŋo tàrú, sǝ wu yiu wunǝia.&gt;&gt; <verse eid="2SA 20:4" /><verse number="5" style="v" sid="2SA 20:5" />Nda Amasa puro ace ká tunǝ aburana mala Yahuda abanɓwáná ka, sǝama banì sauwa kútì anonggio mǝnana murǝm kasǝi wi ka.<verse eid="2SA 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6" />Sǝ Dauda banggi Abishai ama, &lt;&lt;Adyan ngga, Sheba muna-ɓwabura mala Bikǝri nǝ̀ pàkka sǝm gìr mǝɓane nǝ̀ kútì mǝnana Absalom pàk ka. Twal aburana mem, sǝ wu ɓangŋa atè, ɓǝ̀ ana raka nǝ̀ kumbi ɓamúrì akanggǝrang anggea-là, sǝ nǝ̀ ɓwar arǝ sǝm.&gt;&gt;<verse eid="2SA 20:6" /></para>
  <para style="s">Jowap wal-lú Amasa</para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 20:7" />Nda aburana mala Jowap andǝ amǝ'Keret andǝ amǝ'Pelet andǝ akanggǝrang amǝ'lwa kat purî ɓá Urǝshalima, aɓata sàrǝ̀ban mala Abishai, sǝ à oa pǝrta Sheba muna-ɓwabura mala Bikǝri.<verse eid="2SA 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8" />Lang à yi bik ban tali mǝgule a Gibiyon ngga, Amasa yi kumia. Jowap ka, ndanǝ adaura-murǝm male mala amǝ'lwa arǝì, nǝ nggeabyau aɓa ndè mǝnana marǝ nggurrì a taɓuni ka. Lang Jowap sungŋo nǝ̀ ká a ban Amasa ka, nggeabyaunì swárô kpa a nzali.<verse eid="2SA 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9" />Jowap ɗì Amasa ama, &lt;&lt;Mǝ'eambǝam, a nda jam le?&gt;&gt; Pǝlǝa bwal Amasa a mbotokuni nǝ bui-mǝli, ace mǝnana nǝ̀ kùrrì zǝp, mala makkun ngga. <verse eid="2SA 20:9" /><verse number="10" style="v" sid="2SA 20:10" />Sǝ Amasa ka, sǝn byau mǝnana a bù Jowap ka ɗàng. Nda Jowap zuɓi Amasa nǝ byau a bumi, sǝ amuna-lungŋe solǝ a nzali. Amasa wǔ, nǝ zuɓiban mwashat ɓǝ̀rɓǝ̀r.<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="1KI 2:5">1Amur 2:5</ref></char>.</note> Pǝlǝa Jowap andǝ mǝ'eambi Abishai pǝrta Sheba muna-ɓwabura mala Bikǝri. <verse eid="2SA 20:10" /><verse number="11" style="v" sid="2SA 20:11" />Mwashat aɓalǝ alaggana mala Jowap cam amur lú Amasa, sǝ loasǝ gì na ama, &lt;&lt;Ɓwa mǝnana kat earmúr Jowap, sǝ ɓwa mǝnana kat nda anzǝm Dauda ka, ɓǝ̀ kpata Jowap!&gt;&gt; <verse eid="2SA 20:11" /><verse number="12" style="v" sid="2SA 20:12" />Amasa nongŋo aban mgbangtǝki aɓa nkila male a tsùrú mala njargula, sǝ koya mǝ'lwa mǝnana yiu a banì ka, go kusǝi came. Sǝ lang lagga man sǝni ama koyan mǝnana yiu a ban Amasa ka, cam piu ka, nda sungsǝki Amasa ɓǝ̀ gǝshì múr njargula, warinǝi a ɓawan, sǝ kùmsǝi wi kungtung amurí ka. <verse eid="2SA 20:12" /><verse number="13" style="v" sid="2SA 20:13" />Lang à gǝshina lú Amasa nyingŋǝ̀nà múr njargula ka, aɓwana kat o atà Jowap ace pǝrta Sheba, muna-ɓwabura mala Bikǝri.<verse eid="2SA 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14" />Sheba gya atà atau mala Isǝrayila kat yi pur a Abel-Bet-Ma'aka, andǝ ɓá bù-nzali mala amǝ'Beri puppup; à ramba abanɓwáná, sǝ à o atè. <verse eid="2SA 20:14" /><verse number="15" style="v" sid="2SA 20:15" />Amǝ'lwa mala Jowap kat yiu sǝ à gumbǝli nggea-là Abel-Bet-Ma'aka sǝ Sheba na aɓa nggea-lê. Pǝlǝa à ɓak mgbangban mǝnana eau a kuli aban ká arǝ nggea-lê, sǝ kya cam nǝ nza arǝ kanggǝrang tali mǝnana nggea-lê cam amurí ka. Sǝ aɓwana mǝnana kat atà Jowap ka, à kùtí a tǝmgi kusǝ sheranî, ace mǝnana à nǝ̀ me a nzali ka. <verse eid="2SA 20:15" /><verse number="16" style="v" sid="2SA 20:16" />Pǝlǝa ɓè ɓwama mǝ'sǝlǝe tunǝban nǝɓa nggea-lê ama, &lt;&lt;Wu kwakikir wun! Wu kwakikir wun! Ida, wu ne Jowap ama ɓǝ̀ yiu kani ace mǝnana mǝ bangcau nǝi ka.&gt;&gt; <verse eid="2SA 20:16" /><verse number="17" style="v" sid="2SA 20:17" />Lang Jowap sung tù aban ɓwame ka, ɓwame ɗi ama, &lt;&lt;A nda Jowap le?&gt;&gt;</para>
  <para style="p" vid="2SA 20:17">Jowap ear ama, &lt;&lt;E, mǝ nda.&gt;&gt;</para>
  <para style="p" vid="2SA 20:17">Pǝlǝa ne wi ama, &lt;&lt;Kwakikiro arǝ cau mǝnana guro mò nǝ̀ banggo ka.&gt;&gt;</para>
  <para style="p" vid="2SA 20:17">Jowap eari wi ama, &lt;&lt;Mǝ nda ǝn nggǝ oeo ka.&gt;&gt;<verse eid="2SA 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18" />Pǝlǝa ɓwame nacau, ama, &lt;&lt;A pwarian ngga aɓwana kǝ̀ bang ama, &lt;Wu alta kwarkiru a Abel,&gt; sǝ anggo sǝ à gilǝki cau. <verse eid="2SA 20:18" /><verse number="19" style="v" sid="2SA 20:19" />Sǝm nda aɓalǝ aɓwana mana à earce dorǝpwala andǝ domǝsǝcau a Isǝrayila ka. Wun ndarǝ alte ama wun nǝ̀ wal-lú nggea-là mǝnana nggeau na a Isǝrayila ka. Palang sǝ wun nǝ̀ kiɗiki nzali liɓala mǝnana mala Yahweh na ka?&gt;&gt;<verse eid="2SA 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20" />Jowap pe wi eare ama, &lt;&lt;Ɓǝ̀ sappi banam, ɓǝ̀ sappi banam mǝnana ama mǝ pisǝì ko mǝ bǝbbǝriki ka. <verse eid="2SA 20:20" /><verse number="21" style="v" sid="2SA 20:21" />Cê pa anggo ɗàng. Ɓè ɓwabura na ǝn alkiyite ka, lullǝi ama Sheba muna-ɓwabura mala Bikǝri, ɓwa nzali múr-ankono mala Ifǝrem. Yì ka loasǝ bui aɓa mgbicau arǝ murǝm, nggearǝ murǝm Dauda. Wu pa mǝnia yì ɓwabura ka, sǝ mǝ nǝ nying nggea-lê.&gt;&gt;</para>
  <para style="p" vid="2SA 20:21">Ɓwame ne Jowap ama, &lt;&lt;Sǝni, sǝm nǝ̀ túrò ɓamuri amúr sheran.&gt;&gt;<verse eid="2SA 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22" />Pǝlǝa ɓwame wari nǝ kwaro male aban aɓwana mǝnana kat aɓa nggea-lê ka. À kasǝ ɓamur Sheba muna-ɓwabura mala Bikǝri, sǝ à túrì Jowap. Nda Jowap twang njawe, sǝ aburana male mesǝe, à nying nggea-lê, koyan ngga nyar a là male ka. Pǝlǝa Jowap nyar a Urǝshalima aban murǝm.<verse eid="2SA 20:22" /></para>
  <para style="s">Amǝgulo mala Dauda</para>
  <para style="r">(<ref loc="2SA 8:15-18">2 Samu 8:15-18</ref>; <ref loc="1CH 18:14-17">1 Acau la Apwari 18:14-17</ref>)</para>
  <para style="li1">
    <verse number="23" style="v" sid="2SA 20:23" />
    <note caller="+" style="f">
      <char style="fr" closed="false">20:23 </char>
      <char style="ft" closed="false">Sǝni aɓa: </char>
      <char style="xt">
        <ref loc="2SA 8:16-18">2Sam 8:16-18</ref>; <ref loc="1KI 4:3-6">1Amur 4:3-6</ref></char>.</note>Jowap nda gbani amur amǝ'lwa mala Isǝrayila kat;</para>
  <para style="li1" vid="2SA 20:23">Benaya muna-ɓwabura mala Jehoyada nda mǝ'sàrǝ̀ban amur amǝ'Keret andǝ amǝ'Pelet,<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="fq" closed="false">amǝ'Keret andǝ amǝ'Pelet </char><char style="ft" closed="false">ka à nda ka amǝ'yáltà murǝm.</char></note><verse eid="2SA 20:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="2SA 20:24" />Adoniram nda ɓwamǝgule amur aɓwana mana à tsǝia aɓa túró púp ka,</para>
  <para style="li1" vid="2SA 20:24">sǝ Jehoshafat muna-ɓwabura mala Ahilud nda mǝ'twalcau aɓa malǝmce;<verse eid="2SA 20:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 20:25" />Sheva nda mǝgilǝgir,</para>
  <para style="li1" vid="2SA 20:25">sǝ Zadok andǝ Abiyata ka, à nda ka apǝris,<verse eid="2SA 20:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 20:26" />sǝ Ira ɓwa'Jayir gbal ka, pǝris mala Dauda na.<verse eid="2SA 20:26" /></para>
  <chapter eid="2SA 20" />
  <chapter number="21" style="c" sid="2SA 21" />
  <para style="s">Dauda mbwekî amǝ'Gibiyon a kúnì gìr <optbreak /> mǝnana à pàkkia wia ka</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1" />A nza mala yálmúrû mala Dauda ka, nzal-gula kpa mǝnana twal apǝlǝa tàrú a nzǝmarǝia ka, nda Dauda alta ɓamǝsǝ Yahweh ka. Sǝ Yahweh bang ama, &lt;&lt;Mǝnia ka nda atàcau mala Sawul andǝ ɓala-nkila male, acemǝnana wal-lú amǝ'Gibiyon.&gt;&gt;<verse eid="2SA 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2" />Nda murǝm Dauda tunǝ amǝ'Gibiyon sǝ nacau nǝia ka. (Amǝ'Gibiyon ngga à pur a nggurkwar mala Isǝrayila ɗàng; à nda ka amǝ'Amor mǝnana à ueo, mana amǝ Isǝrayila kánbia wia ama à nǝ̀ ɗekia nǝyilǝmu ka;<note caller="+" style="f"><char style="fr" closed="false">21:2 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="JOS 9:3-17">Jes 9:3-17</ref></char>.</note> sǝama Sawul alte nǝ̀ twaltea aɓa bumpina male ace aɓwana mala Isǝrayila andǝ Yahuda). <verse eid="2SA 21:2" /><verse number="3" style="v" sid="2SA 21:3" />Sǝ Dauda ɗì amǝ'Gibiyon ama, &lt;&lt;Mana ɓǝn pa ace wun? Sǝ mana ɓǝn pa a kúnì mǝɓane mǝnana à pàkka wun, mǝnana nǝ̀ tsǝa wun nǝ̀ tsǝki aɓwana mala Yahweh bù ka?&gt;&gt; <verse eid="2SA 21:3" /><verse number="4" style="v" sid="2SA 21:4" />Pǝlǝa amǝ'Gibiyon earî wi ama, &lt;&lt;Cau mǝnana anre sǝm sǝnǝa Sawul andǝ ɓala male ka, bolo-zǝnariya ko bolo-njengǝlan pà nǝ̀ gilǝki ɗàng; sǝ pà aɓa rǝcandǝa ma'sǝm ɓǝ̀ sǝm wal-lú kǝɓwa a Isǝrayila ɗàng.&gt;&gt; Sǝ Dauda ɗia ama, &lt;&lt;Sǝ mana ado wu kǝ earce ama mǝ pa ace wun?&gt;&gt; <verse eid="2SA 21:4" /><verse number="5" style="v" sid="2SA 21:5" />À earî murǝm ama, &lt;&lt;Ɓwa mǝnana wal-lú sǝm, sǝ hamce ama nǝ̀ twalta sǝm, ace mǝnana kǝɓwa atà sǝm ɓǝkǝa ue nǝyilǝmu a ɓekǝ ban aɓa nzong-nzali mala Isǝrayila raka, <verse eid="2SA 21:5" /><verse number="6" style="v" sid="2SA 21:6" />ɓǝà pa sǝm aɓwana tongno-nong-ɓari atà amuna-burana male, sǝ sǝm nǝ̀ gyaria aɓadǝm Yahweh a Gibiya, là mala Sawul, yì ɓwa mǝnana Yahweh tàrì ka.&gt;&gt;</para>
  <para style="p" vid="2SA 21:6">Sǝ murǝm bang ama, &lt;&lt;Mǝ nǝ pa wunia.&gt;&gt;<verse eid="2SA 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7" />Sǝama ace kána mǝnana anre Dauda andǝ Jonatan a ɓadǝm Yahweh ka,<note caller="+" style="f"><char style="fr" closed="false">21:7 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1SA 18:3">1Sam 18:3</ref>; <ref loc="1SA 20:12-17">20:12-17</ref>; <ref loc="1SA 23:18">23:18</ref>; <ref loc="2SA 9:1-7">2Sam 9:1-7</ref></char>.</note> murǝm nying Mefiboshet muna-ɓwabura mala Jonatan mǝ'kà Sawul ɓǝ̀ auwa. <verse eid="2SA 21:7" /><verse number="8" style="v" sid="2SA 21:8" />Pǝlǝa murǝm twal amuna-burana ɓari, Armoni andǝ Mefiboshet, amuna mala Rizpa ɓoarnsarile Aiya mǝnana ɓǝlî Sawul ka, andǝ amuna-burana tongno, mǝnana Merap ɓoarnsarile Sawul ɓǝlî Adǝriyel muna-ɓwabura mala Barzilayi ɓwa Mehola ka. <verse eid="2SA 21:8" /><verse number="9" style="v" sid="2SA 21:9" />Dauda tasǝ amuna-burana mǝnia ka a ɓabu amǝ'Gibiyon, sǝ à gyaria amur ɓè muna-nkono aɓadǝm Yahweh; yià mǝno tongno-nong-ɓari ka à wù atārǝia. À wal-luia aɓalǝ anonggio mǝdǝmbe mala pwan-gìrɓaban, a bàkú tita pwan mǝssa-bálì.<verse eid="2SA 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10" />Pǝlǝa Rizpa ɓoarnsarile Aiya twal lagir-doatu,<note caller="+" style="f"><char style="fr" closed="false">21:10 </char><char style="fq" closed="false">lagir-doatu </char><char style="ft" closed="false">ko &lt;&lt;sangina-lagìr&gt;&gt;</char></note> sǝ sárǝi ace ɓamúrì amur tali, a bàkú tita pwan-gìrɓaban ba kpa mala mbulo nǝ kuli amur aluî. Sǝ earî anyal a bumkuli ɓǝà sulǝ amuria nǝ pwari, ko anyam-bondo nǝ du ɗàng. <verse eid="2SA 21:10" /><verse number="11" style="v" sid="2SA 21:11" />Aɓwana yi banggi Dauda gìr mǝnana Rizpa ɓoarnsarile Aiya, mā-twala mala Sawul pàk ka. <verse eid="2SA 21:11" /><verse number="12" style="v" sid="2SA 21:12" />Pǝlǝa Dauda wario kya pwan amú Sawul andǝ amú muna-ɓwabura male Jonatan a ban aburana mala Jabesh-Gilǝyat. Amǝ Jabesh-Gilǝyat ka à akdǝmba à kya iu amuia a nzawara mala Bet-shan, ban mǝnana amǝ'Filisti gyaria kam, a pwari mǝnana amǝ'Filisti wal-lú Sawul amur Nkono Gilbowa ka. <verse eid="2SA 21:12" /><verse number="13" style="v" sid="2SA 21:13" />Dauda twal amú Sawul andǝ amú muni Jonatan a ban mǝno sǝ yinǝia. Ɗǝm ngga à ramba amú aburana mǝno mǝnana à gyaria ka. <verse eid="2SA 21:13" /><verse number="14" style="v" sid="2SA 21:14" />À lumsǝ amú Sawul andǝ amú muni Jonatan a ɓembe-ɓa-tali mala tárrí Kish a Zela aɓa bu-nzali Benjami. Koman kat ka à pè kǝla mǝnana murǝm bang ngga. Anzǝm mǝno ka, sǝ Ɓakuli ok hiwi ace nzalî.<verse eid="2SA 21:14" /></para>
  <para style="s">Munǝki-amunǝo arǝ akáɓá-ɓwa mala amǝ'Filisti</para>
  <para style="r">(<ref loc="1CH 20:4-8">1 Acau la Apwari 20:4-8</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15" />Ɓè fara ka, munǝo lo ɗǝm a nre ka amǝ'Filisti andǝ amǝ'Isǝrayila. Dauda andǝ aburana male atè wari a mǝno yì munǝo ka, sǝ lang à nda aɓa munǝo arǝ amǝ'Filisti ka, Dauda aulǝa. <verse eid="2SA 21:15" /><verse number="16" style="v" sid="2SA 21:16" />Pǝlǝa Isǝbibenop, ɓwa'Filisti, mwashat atà amǝ'kau mala akáɓá-ɓwa, mǝnana dǝmbǝrya mala kaɗa male ka, tyang tàrú nǝ gauwa-tsùrú na (3.5), sǝ kùr rǝi nǝ bǝsa nggeabyau ka, bang ama nǝ̀ wal-lú Dauda. <verse eid="2SA 21:16" /><verse number="17" style="v" sid="2SA 21:17" />Sǝama, Abishai muna-ɓwabura mala Zeruya, yiu yi bwalì Dauda kàm, sǝ wal-lú ɓwa'Filistinî. Pǝlǝa aburana mala Dauda kánbi wi ama, &lt;&lt;A pà wunǝ yiu a lwa ɗǝm atà sǝm ɗàng, ace mǝnana wu kǝa limgi tǎlaban mala Isǝrayila raka.&gt;&gt;<verse eid="2SA 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18" />Anzǝm mǝno ka ɓè munǝo lo ɗǝm andǝ amǝ'Filisti a Gop. A bàkú mǝno ka, Sibekai ɓwa Husha, wal-lú Saf, mwashat atà amǝ'kau mala akáɓá-ɓwa.<verse eid="2SA 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19" />A ɓè munǝo ɗǝm andǝ amǝ'Filisti a Gop ka, Elhanan muna-ɓwabura mala Jaare-oregim, ɓwa'Betalami, wal-lú mǝ'eam Golaya ɓwa'Gitti, mǝnana tondong kaɗa male nyane kǝla muna-nggun-so ka.<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="1SA 17:7">1Sam 17:7</ref></char>.</note><verse eid="2SA 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20" />Ɓè munǝo lo ɗǝm a Gat. A banì ka ɓè ɓwabura nakam kaɓa nggurung mǝnana a koya bui ka, ndanǝ amuna-bu tongno-nong-mwashat, sǝ amuna-kusǝu tongno-nong-mwashat a koya kusǝi; kpapi kat ka à nda lumi-ɓari-nong-ine; yì gbal ka mǝ'kau mala akáɓá-ɓwa na. <verse eid="2SA 21:20" /><verse number="21" style="v" sid="2SA 21:21" />Sǝ lang ɓǝsǝki Isǝrayila ka, Jonatan muna-ɓwabura mala Shimeyi, mǝ'eam Dauda wal-lui.<verse eid="2SA 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22" />Akáɓá-ɓwa mǝnia ine ka, amǝ'kau mala akáɓá-ɓwa mala Gat na, sǝ à wù nǝ bù Dauda andǝ aburana male.<verse eid="2SA 21:22" /></para>
  <chapter eid="2SA 21" />
  <chapter number="22" style="c" sid="2SA 22" />
  <para style="s">Dauda tùkî Yahweh nggyal</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1" />Sǝ Dauda bang acau mala nggyal mǝnia ka aban Yahweh, a bàkú mǝnana amsǝi a bù aɓi-mǝbura kat, sǝ a bù Sawul ka <verse eid="2SA 22:1" /><verse number="2" style="v" sid="2SA 22:2" />ama,</para>
  <para style="q1" vid="2SA 22:2">&lt;&lt;Yahweh nda tali mem,</para>
  <para style="q1" vid="2SA 22:2">ban-sǝmbǝrǝa mem</para>
  <para style="q2" vid="2SA 22:2">andǝ mǝ'amsǝam;<verse eid="2SA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 22:3" />We Ɓakuli, tali mem,</para>
  <para style="q2" vid="2SA 22:3">mǝnana aɓalǝo sǝ ǝn nggǝ kum ban-auwa ka;</para>
  <para style="q1" vid="2SA 22:3">ntongŋo mem andǝ rǝcandǝa mala amsǝban mem,</para>
  <para style="q1" vid="2SA 22:3">kanggǝrang-ban andǝ ban-auwa mem;</para>
  <para style="q2" vid="2SA 22:3">mǝ'amsǝam a ɓabù ɓìkìbura.<verse eid="2SA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4" />Ən ɓua aban Yahweh, yì mǝnana kārǝ́na ɓǝà ɓwangsǝi ka;</para>
  <para style="q2" vid="2SA 22:4">Anggo sǝ mǝ nǝ kum amsǝban a ɓabù aɓiam-mǝbura.<verse eid="2SA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5" />Lú gumbǝliam kǝla eaki-nkono mala mùr;</para>
  <para style="q2" vid="2SA 22:5">mùrɓangŋa mala kiɗikiban ɓakiam;<verse eid="2SA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6" />Anggur mala Shewol taɓǝlikiam;</para>
  <para style="q2" vid="2SA 22:6">agbǝli mala lú puratam.<verse eid="2SA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7" />Aɓa nggikiban mem ngga, ǝn ɓua aban Yahweh,</para>
  <para style="q2" vid="2SA 22:7">ǝn ɓua aban Ɓakuli mem.</para>
  <para style="q1" vid="2SA 22:7">Ok giem aɓa ndà male;</para>
  <para style="q2" vid="2SA 22:7">sǝ ɓua mem ace gbasha kútí a kiri.<verse eid="2SA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8" />Pǝlǝa ɓanza dǝurǝo sǝ gǝggǝli,</para>
  <para style="q2" vid="2SA 22:8">akusǝɓa mala kuli ɓǝl-ryak'ryak</para>
  <para style="q2" vid="2SA 22:8">sǝ à dǝurǝkio;</para>
  <para style="q2" vid="2SA 22:8">à gǝggǝli acemǝnana bumi-lullo.<verse eid="2SA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9" />Yele pur a ɓá lullǝi;</para>
  <para style="q2" vid="2SA 22:9">bǝsa mǝ'earke pur a ɓá kúni,</para>
  <para style="q2" vid="2SA 22:9">nkalang mǝnana nggangsǝ ka ear-bǝsa nǝ baní.<verse eid="2SA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10" />Dìlì kuli sǝ sulǝo,</para>
  <para style="q1" vid="2SA 22:10">pǝndǝa mǝcikciki na aɓata akusǝi.<verse eid="2SA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11" />Eau a nzǝm cerup sǝ yàlé;</para>
  <para style="q2" vid="2SA 22:11">e, à sǝni a nkpamtari gung.<note caller="+" style="f"><char style="fr" closed="false">22:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="PSA 18:10">Ang 18:10</ref></char>.</note><verse eid="2SA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12" />Tsǝk pǝndǝa mǝnana gumbǝlì ka, pǝlǝ tara male,</para>
  <para style="q2" vid="2SA 22:12">pǝrɓang mana lùmsǝ nǝ mur ka kàrì.<note caller="+" style="f"><char style="fr" closed="false">22:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="PSA 18:11">Ang 18:11</ref></char>.</note><verse eid="2SA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13" />Tǎlaban mana aɓadǝmbi ka,</para>
  <para style="q2" vid="2SA 22:13">tsǝk nkalang bǝsa lo earke.<verse eid="2SA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14" />Yahweh sa a kuli kǝla mgbarangce.</para>
  <para style="q2" vid="2SA 22:14">Ɓakuli mana Karban Kat nǝ Gulo ka loasǝ gì.<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOB 37:4">Ayu 37:4</ref></char>.</note><verse eid="2SA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15" />Túr amundi sǝ mesǝ aɓi-mǝbura,</para>
  <para style="q2" vid="2SA 22:15">liki'nzama male zurìmúria.<verse eid="2SA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16" />Abân-mǝlime mala nggeamùr ndǝlya,</para>
  <para style="q2" vid="2SA 22:16">akusǝɓa mala ɓanza nong kwas,</para>
  <para style="q1" vid="2SA 22:16">lang Yahweh gimban,</para>
  <para style="q2" vid="2SA 22:16">sǝ pyau n'yali a ɓá lullǝi ka.<verse eid="2SA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17" />Sárǝ́ bui nǝ kuli sǝ twalam;</para>
  <para style="q2" vid="2SA 22:17">eamsǝam a ban-mǝlime aɓa nggeamùr.<verse eid="2SA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18" />Amsǝam a ɓabù ɓiam-mǝbura mǝ'rǝcandǝe,</para>
  <para style="q2" vid="2SA 22:18">a ɓabù aɓwana mana à ɓinǝmǝsǝàm ngga, acemǝnana rǝcandǝa malea ɓākì mem.<verse eid="2SA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19" />À sulǝ amuram a pwari murɓikea mem,</para>
  <para style="q2" vid="2SA 22:19">sǝama Yahweh pam gbasha.<verse eid="2SA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20" />Sǝ ɗǝm ngga pusǝam, yinǝ mim aɓa dalang.</para>
  <para style="q2" vid="2SA 22:20">Amsǝam, acemǝnana bumipwasǝ arǝàm.<verse eid="2SA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21" />Yahweh pàngnǝ mim kǝla mǝnana karǝ arǝ ɓealɓoarna mem ngga;</para>
  <para style="q2" vid="2SA 22:21">pam tangnakusǝ ɗwanyicau-arǝǔ mem.<verse eid="2SA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22" />Ən kpanata anjargula mala Yahweh,</para>
  <para style="q2" vid="2SA 22:22">sǝ ǝn kyanggi Ɓakuli mem aban ká pàk ɓealɓikea ɗang.<verse eid="2SA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23" />Anggurcau male kat ka, à nda aɓadǝmbam,</para>
  <para style="q2" vid="2SA 22:23">sǝ ǝn kyanggi anê male ɗàng.<verse eid="2SA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24" />Mǝ nda jik aɓadǝmbi.</para>
  <para style="q2" vid="2SA 22:24">Ən bwal ɓamúràm arǝ cauɓikea.<verse eid="2SA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25" />Acemani ka Yahweh panam tangnakusǝu kǝla mana karǝ arǝ ɓealɓoarna mem ngga,</para>
  <para style="q2" vid="2SA 22:25">kǝla mana karǝ arǝ doɓoarnsari mem aɓadǝmbi ka.<verse eid="2SA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26" />Aban amǝ lǝmdǝ mǝsǝswatǝr ka, awu nǝ lǝmdǝ mǝsǝswatǝr,</para>
  <para style="q2" vid="2SA 22:26">aban amǝ'ɗwanyicau-arǝu ka, awu nǝ lǝmdǝ ɓamúrò, a nda mǝ'ɗwanyicau-arǝu.<verse eid="2SA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27" />Aban amǝ'doɓoarnsari ka, awu nǝ lǝmdǝ ɓamúrò mǝ'doɓoarnsari,</para>
  <para style="q2" vid="2SA 22:27">aban amǝ'kìɗìkì ka, awu nǝ lǝmdǝ ɓamúrò mǝɓìkìdo.<verse eid="2SA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28" />Awu nǝ amsǝ aɓwana mǝnana à paria ka,</para>
  <para style="q2" vid="2SA 22:28">sǝama amǝsǝo na arǝ amǝtwàlɓamúrû, ace nyesǝia a nzali.<verse eid="2SA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29" />A nda pitǝla mem, Yahweh.</para>
  <para style="q2" vid="2SA 22:29">Yahweh kǝ̀ tâ aɓa pǝndǝa mem.<verse eid="2SA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30" />Nǝ we ka, mǝ nǝ gandǝ loasǝtà amǝ'tǝllìban,</para>
  <para style="q2" vid="2SA 22:30">nǝ pagbasha mala Ɓakuli mem ngga, mǝ nǝ yàlî múr sheran.<verse eid="2SA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31" />Mala Ɓakuli ka, njar male na jik.</para>
  <para style="q2" vid="2SA 22:31">Cau mala Yahweh ka à mwamǝni.</para>
  <para style="q1" vid="2SA 22:31">Yi ka, ntongŋo na</para>
  <para style="q2" vid="2SA 22:31">aban aɓwana mana à kùmsǝ a baní ka.<verse eid="2SA 22:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32" />Yana nda Ɓakuli, ɓǝ̀ Yahweh na raka?</para>
  <para style="q2" vid="2SA 22:32">Sǝ yana nda tali, ɓǝ̀ Ɓakuli na raka?<verse eid="2SA 22:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33" />Ɓakuli nda ban-auwa mǝcandǝe mem,</para>
  <para style="q2" vid="2SA 22:33">sǝ kǝ tsǝk njar mem ɓǝ̀ duk jik.<verse eid="2SA 22:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34" />Tsǝk akusǝam ɓǝà soa nzali kǝla mala mbamba,</para>
  <para style="q2" vid="2SA 22:34">sǝ tamsǝam amur abân mǝ'dāhre.<verse eid="2SA 22:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35" />Kǝ kanì abuam munǝo,</para>
  <para style="q2" vid="2SA 22:35">ace mǝnana ɓǝ̀ anggwarbuam gandǝ kar nta mala bolo-bángŋá.<verse eid="2SA 22:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36" />Sǝ ɗǝm ngga à panam ntongŋo mala amsǝban mô;</para>
  <para style="q2" vid="2SA 22:36">sǝ pagbasha mô dumsǝnam a gulo.<verse eid="2SA 22:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37" />A tangsǝna njar ace akusǝam,</para>
  <para style="q2" vid="2SA 22:37">ace mǝnana akusǝam ɓǝà kǝa shambǝrǝ raka.<verse eid="2SA 22:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38" />Ən pǝrnata aɓiam-mǝbura, sǝ ǝn kiɗikinia.</para>
  <para style="q2" vid="2SA 22:38">Ən pǝlǝ nzǝmam ɗàng she lang ǝn malnia ka.<verse eid="2SA 22:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39" />Ən twalnatea, ǝn zuɓikia sǝ à gandǝ lo ɗang.</para>
  <para style="q2" vid="2SA 22:39">E, à kpaki a nzali a kusǝam.<verse eid="2SA 22:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40" />A mārǝnam nǝ rǝcandǝa ace munǝo;</para>
  <para style="q2" vid="2SA 22:40">Aɓwana mǝnana à lo arǝàm ngga, a ɓunginia aɓatam.<verse eid="2SA 22:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41" />A tsǝ́ngŋǝ̀nà aɓiam-mǝbura à pǝlǝam nzǝmia,</para>
  <para style="q2" vid="2SA 22:41">ace mǝnana ɓǝn kiɗiki aɓwana mǝnana à ɓinǝmǝsǝam ngga.<verse eid="2SA 22:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42" />À pelǝban, sǝ kǝɓwa pà kàm nǝ̀ amsǝia ɗàng;</para>
  <para style="q2" vid="2SA 22:42">à ɓua aban Yahweh, sǝ okia wia ɗàng.<verse eid="2SA 22:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43" />Pǝlǝa ǝn goea kǝla muku nzali.</para>
  <para style="q2" vid="2SA 22:43">Ən nyakia sǝ ǝn parkia kǝla dǝɓang a njarɓala, sǝ ǝn mesǝkia.<verse eid="2SA 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44" />A amsǝnam aɓa kúnɓuàna sǝnǝ aɓwana mem.</para>
  <para style="q2" vid="2SA 22:44">A tsǝ́ngŋǝ̀nám ǝn dumǝna múrû amur anzali.</para>
  <para style="q1" vid="2SA 22:44">Aɓwana mana ǝn súrǝ̀ia raka, à pàk túróɓadǝmbu aɓadǝmbam.<verse eid="2SA 22:44" /></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45" />Amǝkúnɗàngna nǝ̀ paɓamuria abanam,</para>
  <para style="q2" vid="2SA 22:45">Lang à ok cau nǝ o ani amuram ngga, à nǝ̀ oakam.<verse eid="2SA 22:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46" />Ɓabum amǝkúnɗàngna nǝ̀ ɓungio,</para>
  <para style="q2" vid="2SA 22:46">à nǝ̀ purkî ɓalǝ abân-sǝmbǝrǝa malea,</para>
  <para style="q2" vid="2SA 22:46">sǝ à nǝ̀ yiu nǝ rǝɓǝla.<verse eid="2SA 22:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47" />Yahweh na nǝ yilǝmu!</para>
  <para style="q2" vid="2SA 22:47">Ɓwangsǝban ɓǝ̀ pa aban Tali mem!</para>
  <para style="q1" vid="2SA 22:47">Gulo ka mala Ɓakuli na,</para>
  <para style="q2" vid="2SA 22:47">Tali mala amsǝban mem.<verse eid="2SA 22:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48" />Yì nda Ɓakuli mǝnana mbwekiyiam akúnì,</para>
  <para style="q2" vid="2SA 22:48">mǝnana kǝ yinǝ aɓwapǝndǝa aɓatam,<verse eid="2SA 22:48" /></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49" />mǝnana pusǝam ǝn purì bù aɓiam-mǝbura ka.</para>
  <para style="q1" vid="2SA 22:49">E, a kǝ loasǝam mǝ kútì aɓwana mǝnana à kǝ lo arǝàm ngga.</para>
  <para style="q2" vid="2SA 22:49">A kǝ amsǝam a bù ɓwa mǝɓìkìbura.<verse eid="2SA 22:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50" />Acemani ka, mǝ nǝ po yàwá, we Yahweh, aɓalǝ anzali,</para>
  <para style="q2" vid="2SA 22:50">sǝ mǝ nǝ tùki anggyal ɓwangsǝki lullǝo.<verse eid="2SA 22:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51" />Pè murǝm male amsǝban mǝgule,</para>
  <para style="q2" vid="2SA 22:51">sǝ kǝ lǝmdǝì ɓwa male mana ɗārǝì ka, earcearǝu mǝnana kǝ gǝshi raka,</para>
  <para style="q2" vid="2SA 22:51">aban Dauda andǝ amǝɓala male tàtǝ́k.&gt;&gt;<verse eid="2SA 22:51" /></para>
  <chapter eid="2SA 22" />
  <chapter number="23" style="c" sid="2SA 23" />
  <para style="s">Masǝlǝata acau mala Dauda</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1" />Amǝnia ka, à nda ka masǝlǝata acau mala Dauda:</para>
  <para style="q1" vid="2SA 23:1">Acau mǝnana à pùr a kún Dauda muna-ɓwabura mala Jeshi;</para>
  <para style="q2" vid="2SA 23:1">acau mala ɓwa mǝnana à loasǝi a buno gulo,</para>
  <para style="q1" vid="2SA 23:1">yì ɓwa mǝnana Ɓakuli mala Yakupu ɗārǝì ka,</para>
  <para style="q2" vid="2SA 23:1">yì mǝ'nggyal ɓoarna mala Isǝrayila:<verse eid="2SA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2" />Bangŋo mala Yahweh bangcau nǝ kunam,</para>
  <para style="q2" vid="2SA 23:2">cau male na a lasǝam.<verse eid="2SA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3" />Ɓakuli mala Isǝrayila nanacau,</para>
  <para style="q2" vid="2SA 23:3">Tali mala Isǝrayila nanàm ama,</para>
  <para style="q1" vid="2SA 23:3">&lt;&lt;Ɓwa mǝnana kǝ yálmúr aɓwana nǝ ɓealɓoarna,</para>
  <para style="q2" vid="2SA 23:3">mǝnana kǝ yálmúrû nǝ ɓanggi Ɓakuli ka,<verse eid="2SA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4" />nǝ̀ pa kǝla tǎlaban mala dǝmbari, lang pwari nǝ nggǝ eau ka,</para>
  <para style="q2" vid="2SA 23:4">dǝmbari mǝnana pànǝ apǝrɓang raka,</para>
  <para style="q1" vid="2SA 23:4">lang lolloapì bondo nǝ nggǝ to a nzali,</para>
  <para style="q2" vid="2SA 23:4">aɓa tā-pwari anzǝm nya mala mbulo ka.<verse eid="2SA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5" />Aɓa mǝsǝcau ka, anggo sǝ ɓala mem pa aban Ɓakuli re?</para>
  <para style="q1" vid="2SA 23:5">Yì ka kutina aɓa kùrcau nǝ mim,</para>
  <para style="q2" vid="2SA 23:5">pàcau mǝnana málá male pà kàm raka,</para>
  <para style="q2" vid="2SA 23:5">kùrcau mǝnana gilǝkice aɓa koyagir, sǝ kwakite kàngkàng ngga.</para>
  <para style="q1" vid="2SA 23:5">Mǝno nda amsǝban mem kat,</para>
  <para style="q2" vid="2SA 23:5">andǝ suno mem kat.</para>
  <para style="q1" vid="2SA 23:5">Pà nǝ̀ tsǝì ɓǝ̀ gul re?<verse eid="2SA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6" />Sǝama amǝ'ɓealɓikea ka, à nda kǝla azwe mǝnana à nǝ̀ sukkia ka,</para>
  <para style="q2" vid="2SA 23:6">acemǝnana kǝɓwa pa nǝ̀ jea nǝ bui ɗàng.<verse eid="2SA 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7" />Ɓwa mǝnana nǝ̀ jea ka,</para>
  <para style="q2" vid="2SA 23:7">dumǝna púp nǝ̀ kùr rǝi nǝ gara-bolo ko gara nzo.</para>
  <para style="q1" vid="2SA 23:7">Sǝ à nǝ̀ pisǝia a bǝsa kàng a kǝ banì.&gt;&gt;<verse eid="2SA 23:7" /></para>
  <para style="s">Akanggǝrang aburana mala Dauda</para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8" />Amǝnia ka, à nda ka alullǝ akanggǝrang aɓwana mǝnana Dauda ndanǝia ka: Joshep-Basshebet ɓwa Tachemon, nda mǝdǝmba mala amǝgulo-lwa, sǝ à tunǝi ɗǝm ama Adino, ɓwa Ezni; wal-lú aɓwana gbǝman-tongno-nong-tàrú (800) aɓa lwa mwashat.<verse eid="2SA 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9" />Ɓwa mǝnana kpate ka, nda Eleaza muna-ɓwabura mala Dodo, muna-ɓwabura mala Ahohi; nda mwashat atà akanggǝrang amǝ'lwa tàrú mana atà Dauda, lang à cam kàngkàng a kún amǝ'Filisti mǝnana à yi ramba abanɓwáná ace lwa, sǝ aburana mala Isǝrayila nyar nǝtea ka. <verse eid="2SA 23:9" /><verse number="10" style="v" sid="2SA 23:10" />Yì ka, lo sǝ wal amǝ'Filisti ba aulǝa pàkki wi, gandǝa buì shiuri arǝ nggeabyau; sǝ a mǝno yì pwari ka, Yahweh yinǝ limurǝm mǝgule; sǝ lang amǝ'lwa nyare à yiu anzǝmi ka, kǝ gìr mǝnana à pàk ka, nda pwan gǝna-lwa mala aɓiu-mǝbura mǝnana à wal-luia ka.<verse eid="2SA 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11" />Sǝ Shamma muna-ɓwabura mala Agi ɓwa Harar kpa. Lang amǝ'Filisti ram rǝia abanɓwáná a Lehi a ban ɓè ɓaban mǝnana lùmsǝ nǝ gwalong ngga, acili amǝ'lwa mala Isǝrayila ɓanggi amǝ'Filisti. <verse eid="2SA 23:11" /><verse number="12" style="v" sid="2SA 23:12" />Sǝama yì Shamma ka cam a tsùrú mala ɓabanì, munǝ ace, sǝ wal amǝ'Filisti, sǝ Yahweh yinǝì Isǝrayila limurǝm mǝgule.<verse eid="2SA 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13" />Pǝlǝa akanggǝrang amǝ'lwa mǝnia tàrú aɓalǝ amǝgulo lumi-tàrú mala amǝ'lwa ka, à sulǝo sǝ à yiu aban Dauda a gumi-ɓa'tali mǝnana a Adulam ngga nǝ kún pwan-gìrɓaban, a bàkú mǝnana amǝ'lwa mala amǝ'Filisti duk-katti a ɓangŋaban Refayim ngga. <verse eid="2SA 23:13" /><verse number="14" style="v" sid="2SA 23:14" />A mǝno yì bàkú ka, Dauda na a kanggǝrang-ban, sǝ amǝ'Filisti ka, à angŋa Betalami sǝ à tamsǝna ɓè nggǝsan mala amǝ'lwa malea abanì. <verse eid="2SA 23:14" /><verse number="15" style="v" sid="2SA 23:15" />Sǝ Dauda ɓua mǝsamur kǝ̀rkǝ́r, na ama, &lt;&lt;Mǝsamur mala mùr tūli-mùr mǝnana a kún là mala Betalami ka, walnam kǝ̀rkǝ́r. Mǝ nǝ earce, ɓǝ̀ ɓeɓwa nǝ̀ ɗàrǝa nǝ̀ pàm ngga!&gt;&gt; <verse eid="2SA 23:15" /><verse number="16" style="v" sid="2SA 23:16" />Akanggǝrang amǝ'lwa man tàrú ka, à ar nǝɓalǝ amǝ'lwa mǝnana aɓa kàttì mala amǝ'Filisti ka, à kya ɗàrǝ́ mùr a tūli-mùr mǝnana a kún là mala Betalami ka, sǝ à twali à yinǝì Dauda. Sǝama ɓinǝ nuie; solǝi a nzali aɓadǝm Yahweh. <verse eid="2SA 23:16" /><verse number="17" style="v" sid="2SA 23:17" />Bang ama, &lt;&lt;Ɓǝ̀ sappi banam, Yahweh, mǝnana ɓǝn nu mùr man ngga! Mǝnia ka nkila mala aburana na mǝnana à twal yilǝmia a kún buia ka re?&gt;&gt; Acemani ka, Dauda nu mùrnî ɗàng. Akanggǝrang aburana man tàrú ka, à na à pàk amǝnia yì agir ka.<verse eid="2SA 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18" />Abishai, mǝ'eam Jowap, muna-ɓwabura mala Zeruya nda ɓwamǝgule amur amǝ'lwa mǝno lumi-tàrú ka. Pàktúró nǝ kaɗa male a munǝo arǝ aburana gbǝman-tàrú (300), sǝ wal-luia, sǝ kum lullǝu atà akanggǝrang amǝ'lwa mǝno tàrú ka. <verse eid="2SA 23:18" /><verse number="19" style="v" sid="2SA 23:19" />Yì na mǝnana lullǝì zǝ́kí kútì mala aɓwana man lumi-tàrú ka, acemani ka, à twali pǝlǝ mǝ'sàrǝ̀ban amuria; sǝama, à ɓalli aɓalǝ amǝ'lwa man tàrú ka ɗàng.<verse eid="2SA 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20" />Benaya muna-ɓwabura mala Jehoyada ka, kanggǝrang ɓwa na mǝnana pur a Kabzil ka; pàkki agir gyambǝliban mǝgulke. Yì na mǝnana wal amuna-burana ɓari mala Ariyel ɓwa Mowap ka. Ɗǝm ngga, a pwari mana talimbulo kpani ka, sulǝ atà im aɓa tūli, sǝ wal-luí kàm. <verse eid="2SA 23:20" /><verse number="21" style="v" sid="2SA 23:21" />Wal-lú ɓè ɓwa'Masar, kaɓa ɓwa. Ɓwa'Masar mǝno ka, ndanǝ nkongŋo a bui, sǝama Benaya sulǝ atè nǝ gara-kwalta, ak nkongŋo a bu ɓwa'Masarnî, sǝ wal-luí nǝi. <verse eid="2SA 23:21" /><verse number="22" style="v" sid="2SA 23:22" />Amǝno ka, à nda ka agir mǝnana Benaya muna-ɓwabura mala Jehoyada pea ka, sǝ kumbi ɓamúrì lullǝu atà akanggǝrang amǝ'lwa mǝno tàrú ka. <verse eid="2SA 23:22" /><verse number="23" style="v" sid="2SA 23:23" />Lullǝì zǝ́kí kútì mala aɓwana man lumi-tàrú ka, sǝama bwalta amǝno tàrú ka ɗàng. Sǝ Dauda twali tsǝì, duk ɓwamǝgule amur amǝ'yáltè.<verse eid="2SA 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 23:24" />Aɓea aɓwana aɓalǝ aɓwana mǝno lumi-tàrú ka, à nda ka:</para>
  <para style="li1" vid="2SA 23:24">Asahel mǝ'eam Jowap;</para>
  <para style="li1" vid="2SA 23:24">Elhanan muna-ɓwabura mala Dodo ɓwa Betalami;<verse eid="2SA 23:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 23:25" />Shamma ɓwa Harot,</para>
  <para style="li1" vid="2SA 23:25">Elika ɓwa Harot;<verse eid="2SA 23:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 23:26" />Helez ɓwa Palti;</para>
  <para style="li1" vid="2SA 23:26">Ira muna-ɓwabura mala Ikkesh ɓwa Tekowa;<verse eid="2SA 23:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="2SA 23:27" />Abiyeza ɓwa Anatot;</para>
  <para style="li1" vid="2SA 23:27">Mebunayi ɓwa Hushati;<verse eid="2SA 23:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="2SA 23:28" />Zalmon ɓwa Ahohi;</para>
  <para style="li1" vid="2SA 23:28">Maharayi ɓwa Netofa;<verse eid="2SA 23:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="2SA 23:29" />Helep muna-ɓwabura mala Baana ɓwa Netofa;</para>
  <para style="li1" vid="2SA 23:29">Ittayi muna-ɓwabura mala Ribayi ɓwa Gibiya mala bu-nzali Benjami;<verse eid="2SA 23:29" /></para>
  <para style="li1">
    <verse number="30" style="v" sid="2SA 23:30" />Benaya ɓwa Piraton;</para>
  <para style="li1" vid="2SA 23:30">Hiddayi ɓwa mala amealmur Gaash;<verse eid="2SA 23:30" /></para>
  <para style="li1">
    <verse number="31" style="v" sid="2SA 23:31" />Abi-albon ɓwa Arbati;</para>
  <para style="li1" vid="2SA 23:31">Azǝmavet ɓwa Barhum;<verse eid="2SA 23:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="2SA 23:32" />Eliyaba ɓwa Shaalboni;</para>
  <para style="li1" vid="2SA 23:32">amuna-burana mala Jashen;</para>
  <para style="li1" vid="2SA 23:32">sǝ Jonatan;<verse eid="2SA 23:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="2SA 23:33" />Shamma ɓwa Harar;</para>
  <para style="li1" vid="2SA 23:33">Ayiyam muna-ɓwabura mala Sharar ɓwa Arar;<verse eid="2SA 23:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="2SA 23:34" />Elifelet muna-ɓwabura mala Ahasbayi, muna-ɓwabura mala ɓwa Ma'aka;</para>
  <para style="li1" vid="2SA 23:34">Eliyam muna-ɓwabura mala Ahitofel ɓwa Gilo;<verse eid="2SA 23:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="2SA 23:35" />Hezǝro ɓwa Kamel;</para>
  <para style="li1" vid="2SA 23:35">Pa'arayi ɓwa Arbi;<verse eid="2SA 23:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="2SA 23:36" />Igal muna-ɓwabura mala Natan ɓwa Zoba;</para>
  <para style="li1" vid="2SA 23:36">Bani ɓwa Gad;<verse eid="2SA 23:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="2SA 23:37" />Zelek ɓwa Amon;</para>
  <para style="li1" vid="2SA 23:37">Naharayi ɓwa Beerot, mǝ-bwal-agirmunǝo mala Jowap muna-ɓwabura mala Zuriya;<verse eid="2SA 23:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="2SA 23:38" />Ira ɓwa Itǝri;</para>
  <para style="li1" vid="2SA 23:38">Garep ɓwa Itǝri;<verse eid="2SA 23:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="2SA 23:39" />sǝ Yuriya ɓwa Hitti. Yià kat ka, à nda lumi-tàrú bwamdǝ tongno-nong-ɓari (37).<verse eid="2SA 23:39" /></para>
  <chapter eid="2SA 23" />
  <chapter number="24" style="c" sid="2SA 24" />
  <para style="s">Dauda ɓal amǝ'lwa</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1" />Ɗǝm ngga bumlulla mala Yahweh earki amur Isǝrayila, soakita Dauda arǝia ɓǝ̀ banggia wia ama, &lt;&lt;Wu kyane wu ɓal amǝ Isǝrayila andǝ amǝ Yahuda.&gt;&gt; <verse eid="2SA 24:1" /><verse number="2" style="v" sid="2SA 24:2" />Pǝlǝa murǝm banggi Jowap mǝ'sàrǝ̀ban mala amǝ'lwa mǝnana atè ka ama, &lt;&lt;Wu kya aɓalǝ atau mala Isǝrayila tite a Dan aban ká Biyasheba, sǝ wu pwan alullǝ amǝ'lwa, ace mǝnana ɓǝn súrǝ̀ lakki malea.&gt;&gt; <verse eid="2SA 24:2" /><verse number="3" style="v" sid="2SA 24:3" />Sǝ Jowap ne wi ama, &lt;&lt;Ɓǝ̀ Yahweh Ɓakuli mô hatǝki aɓwana kusǝ gbǝman, sǝ ɓǝ̀ mǝsǝ ɓwamǝgule mem murǝm ɓǝ̀ sǝni. Sǝama mana tsǝa sǝ ɓwamǝgule mem murǝm earce nǝ̀ pàk mǝnia yì gìr ka?&gt;&gt;<verse eid="2SA 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4" />Kat andǝ mani ka, cau mala murǝm par mala Jowap andǝ amǝsà'arǝ amǝ'lwa, pǝlǝa à nying ɓadǝm murǝm, à o a pwan alullǝ amǝ'lwa mala Isǝrayila.<verse eid="2SA 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5" />À yàl nkaring Jodan, à kya tsǝk kàttì a Aruwa, a njar-kunmur mala nggea-là mǝnana a tsùrú mala ɓangŋaban, a bu-nzali Gad ka. À lo kano ka, à wari a Jaza. <verse eid="2SA 24:5" /><verse number="6" style="v" sid="2SA 24:6" />Pǝlǝa à yiu a Gilǝyat, andǝ bu-nzali mala Tatim-Hodshi, sǝ à yiu a Dan-jaan, sǝ à pǝlǝa aban ká a Sidon; <verse eid="2SA 24:6" /><verse number="7" style="v" sid="2SA 24:7" />sǝ à yiu a kanggǝrang-ban mala Taya andǝ anggea-là mala amǝ'Hivi andǝ mala amǝ'Kan'ana kat; sǝ à pur aban ká nǝ [Negev], njar-kunmur mala Yahuda a Biyasheba. <verse eid="2SA 24:7" /><verse number="8" style="v" sid="2SA 24:8" />Sǝ lang à gingŋǝ́na aɓa nzalî kat ka, à yi bik Urǝshalima a masǝlǝata zongŋo tongno-nong-ine nǝ anongŋo lumi-ɓari. <verse eid="2SA 24:8" /><verse number="9" style="v" sid="2SA 24:9" />Jowap pe murǝm lakkì mala aɓwana mǝnana à ɓallia ka: aɓa Isǝrayila ka, akanggǝrang aɓwana mǝnana à kǝ bwal nggeabyau ka, à nda á-gbǝman-tongno-nong-tàrú (800,000), sǝ amǝ Yahuda ka, à nda á-gbǝman-tongno (500,000).<verse eid="2SA 24:9" /></para>
  <para style="s">Ɓashi mala Yahweh arǝ cauɓikea mala Dauda</para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10" />Ɓabum Dauda tè anzǝm mana ɓallǝna aɓwana ka. Sǝ Dauda ne Yahweh ama, &lt;&lt;Ən pàngŋǝ́nà cauɓikea mǝgule nǝ gìr mǝnana ǝn pàk ka. Sǝama ado ka, ida, Yahweh twalî guro mò ban mǝɓane mǝnana pàk ka, acemǝnana ǝn pàngŋǝ́nà gìr ɓwaɓana.&gt;&gt; <verse eid="2SA 24:10" /><verse number="11" style="v" sid="2SA 24:11" />Sǝ lang Dauda lo nǝ dǝmbari ka, cau mala Yahweh yiu aban mǝɓangnǝa Gad, mǝ'sǝna mala Dauda ama, <verse eid="2SA 24:11" /><verse number="12" style="v" sid="2SA 24:12" />&lt;&lt;Kya banggi Dauda ama, &lt;Yahweh kǝ na ama, mǝ nda rǝ po agir tàrú. Twal mwashat atea, mǝnana Mǝ nǝ yinǝi amuro ka.&gt; &gt;&gt; <verse eid="2SA 24:12" /><verse number="13" style="v" sid="2SA 24:13" />Nda Gad yiu aban Dauda sǝ banggi wi cê ama, &lt;&lt;Ɓǝ̀ nzal-gula mala pǝlǝa tàrú yipo aɓa nzali mô le, ko awu nǝ ɓang a ɓadǝmba aɓio-mǝbura sǝ à nǝ̀ nggǝ pǝrto mala azongŋo tàrú le, ko ɓǝ̀ kwánó-twàl-là sulǝ aɓa nzali mô mala nongŋo tàrú? Ado ka, ɓalkiɓabumo sǝ wu nam, ya pa'eare na ɓabumo twalo, ace mǝnana mǝ kya banggi ɓwa mǝnana túrǎm ngga.&gt;&gt; <verse eid="2SA 24:13" /><verse number="14" style="v" sid="2SA 24:14" />Pǝlǝa Dauda banggi Gad ama, &lt;&lt;Mǝ nda aɓa nggikiban kǝ̀rkǝ́r. Nǝ̀ ɓoaribani ɓǝ̀ sǝm kpa a ɓabù Yahweh, acemǝnana mǝsǝswatǝr male gulo; pà mǝ nǝ eare ɓǝ̀ sǝm kpa a ɓabù ɓwapǝndǝa ɗang.&gt;&gt;<verse eid="2SA 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15" />Nda Yahweh tasǝ kwánó-twàl-là amur Isǝrayila, twal a dǝmbari mǝno aban ká masǝlǝata anonggio mǝnana à kasǝ ka. Sǝ aburana á-lumi-tongno-nong-ɓari (70,000) wǔ, twal a Dan aban ká a Biyasheba. <verse eid="2SA 24:15" /><verse number="16" style="v" sid="2SA 24:16" />Lang mǝturonjar mala Yahweh sárǝ́ bui sǝ lǝmdǝi nǝban Urǝshalima ace kiɗike ka, Yahweh nggaɗi ɗenyicau male arǝ mǝno yi gir'murmwana ka, sǝ ne mǝturonjar mǝnana kǝ kiɗiki aɓwana ka ama, &lt;&lt;Karǝna! Ado ka nyesǝ buo.&gt;&gt; Sǝ mǝturonjar mala Yahweh ka, nda a katǝra mala Arauna ɓwa'Jebus.<verse eid="2SA 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17" />Dauda sǝn mǝturonjar mǝnana kǝ kiɗiki aɓwana ka. Pǝlǝa ne Yahweh ama, &lt;&lt;Sǝni, mǝ nda mǝnana ǝn pak cauɓikea ka; mǝ nda mǝnana ǝn pak mǝɓike ka. Sǝ anzur mǝnia ka, mana à pa? Ida, ɗeki buo ɓǝ̀ pǝlǝ arǝàm sǝnǝ ɓala mala tárrám.&gt;&gt;<verse eid="2SA 24:17" /></para>
  <para style="s">Dauda ɓak gyangŋan</para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18" />Gad yiu aban Dauda a mǝno yì pwari ka, sǝ banggi wi ama, &lt;&lt;Eauwe, kya ɓakkì Yahweh gyangŋan a katǝra mala Arauna ɓwa'Jebus.&gt;&gt; <verse eid="2SA 24:18" /><verse number="19" style="v" sid="2SA 24:19" />Nda Dauda lo aɓa kpata cau mala Gad kǝla mǝnana Yahweh na ka. <verse eid="2SA 24:19" /><verse number="20" style="v" sid="2SA 24:20" />Lang Arauna dili mǝsǝi sǝ sǝn murǝm andǝ amǝtúró male dǝshini aban yiu ka, pǝlǝa wario kya ɓun a ɓadǝm murǝm nǝ ɓamǝsǝi a nzali. <verse eid="2SA 24:20" /><verse number="21" style="v" sid="2SA 24:21" />Sǝ Arauna bang ama, &lt;&lt;Mana yinǝ ɓwamǝgule mem murǝm abanam, mim guro male?&gt;&gt;</para>
  <para style="p" vid="2SA 24:21">Dauda banggi wi ama, &lt;&lt;Ace kúr katǝra a buo, ace mǝnana mǝ ɓakkì Yahweh gyangŋan, ace tamsǝ mǝnia yi kwánó-ɓikea ka, ɓǝ̀ nying aɓwe.&gt;&gt;<verse eid="2SA 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22" />Arauna ne Dauda ama, &lt;&lt;Ɓǝ̀ ɓwamǝgule mem murǝm twali sǝ ɓǝ̀ paɓoro mala gìr mǝnana ɓoari wi ka. Sǝni, ajamnda mem nia ka, twalia ace paɓoro mala pisǝe kǝring. Sǝ agara nyagir andǝ anggun-rya malea nia ka ace gimsa. <verse eid="2SA 24:22" /><verse number="23" style="v" sid="2SA 24:23" />Agir mǝnia kat ka, we murǝm, mim Arauna ǝn panì murǝm.&gt;&gt; Sǝ Arauna banggi murǝm ɗǝm ama, &lt;&lt;Ɓǝ̀ Yahweh Ɓakuli mô ak ɓoro mô.&gt;&gt;<verse eid="2SA 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24" />Sǝama murǝm ne Arauna ama, &lt;&lt;Awo; mǝ nǝ kúrí nǝ kúró. Pà mǝ nǝ paɓoro mala pisǝe kǝring aban Yahweh Ɓakuli mem sǝ ǝn mbwe kǝgìr ace raka ɗàng.&gt;&gt; Nda Dauda kúr katǝranî andǝ ajamndè a kún mǝsǝboalo shekel lumi-tongno ka. <verse eid="2SA 24:24" /><verse number="25" style="v" sid="2SA 24:25" />Dauda ɓakkî Yahweh gyangŋan abanì, sǝ pa agir'nkila mala pisǝe kǝring andǝ apaɓoro mala dotarǝu. Pǝlǝa Yahweh ok hiwi male amur nzalinì, sǝ twalî Isǝrayila kwánó-ɓikê.<verse eid="2SA 24:25" /></para>
  <chapter eid="2SA 24" />
</usx>