<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Mbula</book>
  <para style="h">2 Amǝ Tasalonika</para>
  <para style="toc3">2Tas</para>
  <para style="toc2">2 Amǝ Tasalonika</para>
  <para style="toc1">2 Amǝ Tasalonika</para>
  <para style="mt2">Ɓaria Cauterǝa mala Bulǝs aban ká a ban</para>
  <para style="mt1">AMƏ TASALONIKA</para>
  <para style="imt">Mǝncau</para>
  <para style="im">Zuriki mala ɗenyicau amur cau mala nyare yiu mala Kǝrǝsti ka, lidǝmba nǝ kúnɓuàna aɓa ikǝlisiya mǝnana a Tasalonika ka. <char style="bk">Ɓaria Cautera mala Bulǝs aban ká aban Amǝ Tasalonika </char> ka, bang cau amur twale mala aɓwana mǝnana ama, pwari yiu mala Mǝtalabangŋo ka angŋa dǝmba yina. Bulǝs gilǝki mǝnia yì cau à ne anggo ka, aban lǝmdǝia aɓwana ama, kaniama Kǝrǝsti nǝ̀ nyare nǝ̀ yiu ka, túró mǝɓane andǝ ɓealɓikea ka à nǝ̀ ká a dǝmba à nǝ̀ ngga ɓiki pa aɓata nggwamnati mala ɓeɓwa mǝnana nda aɓa sǝmbǝrǝa, à tunǝki ama &lt;&lt;Ɓwa mala Cauɓikea&gt;&gt;, mǝnana nǝ̀ ɓínǝì Kǝrǝsti ka.</para>
  <para style="ip">Yì, mǝ'mishan ngga, tsǝkcau nǝ rǝcandǝa ama ndanǝ ɓoaro aɓwana mǝnana à kǝ ɓal mǝnia yì cau ka, ɓǝa tamsǝ kusǝia aɓa paɓamuru malea, ko ɓǝa kutia do ká-mǝɓane andǝ nutanni ka, ɓǝa kǝ pak túró nǝ buia ace linǝ ɓamuria kǝla mǝnana Bulǝs andǝ aɓi amǝtúró pak ka, sǝ ɓǝa lidǝmba nǝ do pěmǝɓoarne.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Mǝncau<char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">Ɓwangsǝban andǝ lǝmdǝ earnǝban<char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref></char></para>
  <para style="io1">Akwarkiru amur yiu mala Kǝrǝsti<char style="ior"><ref loc="2TH 2:1-17">2:1-17</ref></char></para>
  <para style="io1">Cau ɓakɓabum amur do nǝ ɓealu mala Kǝrǝsta<char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref></char></para>
  <para style="io1">Masǝlǝatacau<char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref></char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">Makkun mala Bulǝs</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />Mǝnia yì cauterǝa ka, pur nǝban Bulǝs andǝ Silas andǝ Timoti.</para>
  <para style="p" vid="2TH 1:1">Aban ká aban ikǝlisiya mala amǝ Tasalonika, aɓwana mala Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 17:1">Atúró 17:1</ref></char>.</note> <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />Ɓǝ̀ ɓwamuru andǝ dorǝpwala mala Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti, do atà wun.<verse eid="2TH 1:2" /></para>
  <para style="s">Ɓakɓabum aɓa tanni</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />Wun amǝ'eam sǝm, dumǝna sǝm púp ɓǝ̀ sǝm nggǝ ɓwangsǝ Ɓakuli a koya pwari, ace wun, sǝ anggo ka ndanǝ ɓoaro acemǝnana paɓamuru ma'wun ngga, nda rǝ lidǝmba kǝ̀rkǝ́r, sǝ earcearǝu mǝnana wu ndanǝi arǝarǝ wun ngga ndarǝ gulo. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />Ace mani ka, sǝm nǝ́ ɓamur rǝ sǝm ngga, sǝm nggǝ jali nǝ wun aban a'ikǝlisiya mala Ɓakuli. Sǝm nggǝ jali ace came ma'wun kàngkàng andǝ paɓamuru ma'wun aɓalǝ apatanni mǝnana wu kǝ kúmô, andǝ adomǝkwane mǝnana wu kǝ dumnǝ gandǝrǝu aɓalǝia ka.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />Amǝnia ka à lǝmdǝ ama Ɓakuli kǝ pak ɓashi male nǝ mǝsǝcau, sǝ a masǝlǝate ka nǝ̀ tsǝk wun wu nǝ̀ duk aɓwana mǝnana à kàrǝ́na à nǝ̀ kutia Domurǝm male mǝnana wu kǝ nu tanni ace ka. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />Ɓakuli ka, mǝ'mǝsǝcau na: Nǝ̀ yia mbwe ka aɓwana mǝnana à kǝ pa wun tanni ka, nǝ tanni, <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />sǝ wun mǝnana wu kǝ nu tanni ka nǝ̀ yia pa wun usǝlǝo sǝ nǝ̀ pa sǝm gbal. Nǝ̀ yia pak mǝnia ka a pwari mǝnana Mǝtalabangŋo Yesu nǝ̀ yia pusǝna rǝì nǝi nǝ kuli aɓa bǝsa mǝ earke, nǝ amǝturonjar mǝcandǝe male atè. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />Nǝ̀ yia ɓasha aɓwana mǝnana kat à súrǝ̀ Ɓakuli raka, andǝ amana à ɓinǝ kpata Cau Amsǝban mala Mǝtala sǝm Yesu ka. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />Yia ka, à nǝ̀ pea wia tanni mala kiɗikiban mǝnana málá male pà kàm raka. À gauwuni tārǝia andǝ Mǝtalabangŋo andǝ tá mala rǝcandǝa male<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 2:10">Isha 2:10</ref></char>.</note> <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />a pwari mǝno nǝ̀ yiu nǝi ace ak gulo andǝ ɓwangsǝkiban a bu aɓwana male mǝnana tària andǝ amǝnana kat à pà ɓamuria a baní ka. Wun gbal ka wu nǝ̀ pa aɓalǝia, acemǝnana wu earnǝ cau mǝnana sǝm bangga wun amurí ka.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />Nda gir mǝnana tsǝa koya pwari ka, sǝm nggǝ pakka wun hiwi. Sǝm nggǝ zǝmbi Ɓakuli ɓǝ̀ tsǝk wun, ɓǝ̀ wu dukdo mǝnana karǝ arǝ ulang do mǝnana tunǝ wun ace ka, sǝ ɓǝ̀ pa wun rǝcandǝa mala lùmsǝ pakki agir mǝɓoarne mǝnana kat paɓamuru ma'wun tsǝk wun a pě ka. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />Anggo ka, lullǝ Mǝtala sǝm Yesu nǝ̀ kum gulo nǝban wun, sǝ wu nǝ̀ kum gbal nǝbaní, nǝ ɓwamuru mala Ɓakuli ma'sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">Ɓwa mala Cauɓikea</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />Sǝm nggǝ earce lǝmdǝa wun gir amur cau mala nyare yiu mala Mǝtala sǝm Yesu Kǝrǝsti, andǝ dapi ma'sǝm a banɓwáná a baní.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1TH 4:15-17">1Tas 4:15-17</ref></char>.</note> Sǝm nggǝ zǝmba wun, wun amǝ'eamrǝarǝu ama, <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />wu kǝa kaurǝa arǝ dǝurǝo ɗang. Sǝ ɓǝ̀ ɓabum wun ɓǝ̀ kǝa lo, nǝ cau mǝnana aɓea ɓwana na ama Pwari mala Mǝtalabangŋo angŋa dǝmba yina pale ka ɗàng. À nǝ̀ gandǝ bang ama à sǝni aɓa bangŋo, ko à oe a kún ɓeɓwa, ko à ɓalli aɓa ɓè cauterǝa mǝnana à twali ama pur nǝban sǝm ngga. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />Wu kǝa eare ɓǝ̀ kǝɓwa swarki wun ɗàng ko bǝti. Acemǝnana mǝno yì pwari ka pà nǝ̀ yiu peatu ɗang she ɓǝ̀ masǝlǝata Mgbicau arǝ Ɓakuli yina, sǝ Ɓwa mala Cauɓikea pusǝna rǝì, mǝno yì ɓwa mǝnana dupî ká kìɗìkì ka. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />Yì ka, nda ɓiu-mǝbura mǝnana kǝ loasǝ ɓamúrì amur Ɓakuli andǝ agir mǝnana kat aɓwana kǝ peri abania ka. Yàle nǝ̀ kutio a Ndàmǝgule mala Ɓakuli nǝ̀ duk kam, nǝ̀ na ama yì nda Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 11:36">Dan 11:36</ref></char>.</note><verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />Ɓalǝ wun kasǝ mbo ama ǝn bangga wun cau amur amǝnia yi agir ka mǝnana mǝ nda atà wun ɗiɗyal ka? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />Sǝ wu sùrǝ́nà rǝ gir mǝnana kǝ tamsǝi mǝnia yì Ɓwa mala Cauɓikea arǝ pusǝrǝi ado ka. À eari wi ɓǝ̀ pusǝrǝi ado ɗàng sheɓǝ̀ pwari mǝnana à tsǝki wi yi pangŋǝ̀nà ka. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />Rǝcandǝa mala ɓealɓikea ka, angŋa dǝmba nǝ̀ nggǝ pak túró aɓa sǝmbǝrǝa, sǝ anggo ka, nǝ̀ ueo aɓa sǝmbǝrǝa she ɓǝà gǝshina ɓwa mǝnana akiyì njar male ka. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />Sǝ à nǝ̀ yia lǝmdǝí, yì Ɓwa mala Cauɓikea, mǝnana Mǝtalabangŋo Yesu nǝ̀ wal-luí nǝ yálí kúni, sǝ nǝ̀ kiɗiki rǝcandǝa male nǝ̀ nyesǝi ɓà, nǝ́ tǎ mala ɓoarɓwa mala yiu male ka.<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 11:4">Isha 11:4</ref></char>.</note> <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />Yì Ɓwa mala Cauɓikea man ngga, nǝ̀ yiu nǝ rǝcandǝa mala Shetan, nǝ̀ yia pakki agir-ndǝlǝki, andǝ agir-lǝmdǝa, andǝ agir-gyambǝliban mǝ'nyirnì ɗàngɗáng.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 24:24">Mat 24:24</ref></char>.</note> <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />Yì ka, nǝ̀ pak túró nǝ koya nggaman swarkiban mǝnana ɓealɓikea kǝ yiu nǝi ka, amur aɓwana mǝnana à kǝ ká nǝ ká kìɗìkì ka. Amǝnia yì aɓwana ka, à nǝ̀ kìɗìkì, acemǝnana à ginǝ ak mǝsǝcau sǝ à ginǝ earce mǝsǝcau a ɓabumia, mǝnana nda nǝ̀ yinǝia ɓǝà kum amsǝban ngga. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />Ace mani ka, Ɓakuli nǝ̀ tasǝia wia swarkiban mǝcandǝe, à nǝ̀ earnǝ nyir. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />Anggo ka aɓwana mǝnana kat à ginǝ earnǝ mǝsǝcau, à pak banɓoarnado aɓa ɓealɓikea ka, à nǝ̀ kasǝia wia ɓashi lú.<verse eid="2TH 2:12" /></para>
  <para style="s">Wu tamsǝ kusǝ wun kàngkàng <optbreak /> wun amǝkpata Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />Sǝ sǝm ngga, ndanǝ ɓoaro ɓǝ̀ sǝm nggǝ pakki Ɓakuli yàwá ace wun, wun amǝ'eamrǝarǝu mǝnana Mǝtalabangŋo earkiyi acea raka. Ɓakuli ka tàrki wun kǝla aɓǝla agir mǝdǝmbe ace amsǝ wun, ɓǝ̀ wu duk aɓwana male, nǝ rǝcandǝa mala Bangŋo male, sǝ nǝ paɓamuru ma'wun arǝ mǝsǝcau ka. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />Yì nǝ̀ tunǝ wun, nǝ Cau Amsǝban mǝnana sǝm hamnǝi a ban wun ngga, ace mǝnana ɓǝ̀ wu kum kāmbe aɓa gulo mala Mǝtala sǝm Yesu Kǝrǝsti. <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />Ace mani ka, wun amǝ'eamrǝarǝu, wu tamsǝ kusǝ wun kàngkàng, wu bwal mǝsǝcau mǝnana sǝm kania wun kat aɓa bang cau, andǝ cauterǝa ka.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />Sǝm nggǝ zǝmba ama Mǝtala sǝm Yesu Kǝrǝsti nǝ nggearǝì, andǝ Ɓakuli Tár sǝm mǝnana earce sǝm, sǝ aɓa ɓwamuru male ka, pana sǝm girikiban mǝnana málá male pà kàm raka, andǝ tsǝkɓalǝu mǝgule ka, <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />ɓǝ̀ ɓak ɓabum wun sǝ ɓǝ̀ pà wun rǝcandǝa mala pě andǝ ne mǝɓoarne.<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">Bulǝs zǝmba ama ɓǝa tsǝì aɓa hiwi</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />A masǝlǝate ka, wun amǝ'eamrǝarǝu, wu tsǝk sǝm aɓa hiwi, ace mǝnana ɓǝ̀ Cau mala Mǝtalabangŋo ɓǝ̀ lidǝmba, ɓǝ̀ akiban a ban aɓwana kat nǝ mire, sǝ ɓǝa é nǝ gusǝlǝban kǝla mǝnana pa aɓalǝ wun ngga. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />Wu kǝ pak hiwi ɗǝm ama, Ɓakuli nǝ̀ bwala sǝm nggam, nǝ̀ amsǝ sǝm a bu aɓwana amǝɓane, amǝ'ɓealɓikea. Acemǝnana aɓwana kat sǝ à paɓamuria a ban Mǝtalabangŋo Yesu ɗàng. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />Sǝ Mǝtalabangŋo ka, à nǝ̀ gūlì arǝì. Nǝ̀ pa wun rǝcandǝa, nǝ̀ yál wun a bu yì Mǝɓealɓikea. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />Sǝm ndanǝ makɓalǝu arǝ Mǝtalabangŋo amur wun ama, wu nda aban pak agir mǝnana sǝm bangga wun ngga, sǝ wu nǝ̀ lidǝmba nǝ pea. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />Ən nggǝ zǝmba ɓǝ̀ Mǝtalabangŋo kyan nǝ ɓabum wun arǝ lǝmdǝ earcearǝu ulang mala Ɓakuli, andǝ do gandǝrǝu mana Kǝrǝsti kǝ pâ ka.<verse eid="2TH 3:5" /></para>
  <para style="s">Nunkiru arǝ do ɓà</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />Wun amǝ'eamrǝarǝu, sǝm nggǝ na wun aɓa lullǝ Mǝtala sǝm Yesu Kǝrǝsti ama, wu purî njar mala aɓwana mǝnana à na ama yia ka amǝkpata Yesu na, sǝ à kǝ dukdo nkundǝr, à kǝ kpata agir mǝnana sǝm kania wun ngga raka. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />Wun nǝ ɓamur rǝ wun ngga, wu sǝlǝna ama ɓoaro ɓǝ̀ wu twal kusǝ sǝm. Sǝm ngga, sǝm duk do nkundǝr aɓalǝ wun ɗàng. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />Sǝm li girlina mala kǝɓwa sǝ sǝm ginǝ mbwe gìr a kúnì ɗàng. Sǝm pak túró nǝ rǝcandǝa ma'sǝm du andǝ pwari, ace mǝnana ɓǝ̀ sǝm ngga duk twalo amur kǝɓwa ɗàng. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />Sǝm ngga, sǝm ndanǝ rǝcandǝa mǝnana sǝm nǝ̀ na wun ama ɓǝ̀ wu pa sǝm girlina ka, sǝ sǝm pe anggo ɗàng acemǝnana sǝm earce dupa wun gìrkànì. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />Sǝ mǝnana sǝm nda aɓalǝ wun ɗiɗyal ka, sǝm nggǝ na wun ama, &lt;&lt;Ɓwa mǝnana kat ɓinǝe, pà nǝ̀ pak túró raka, ɓǝ̀ kǝa li girlina gbal ɗàng.&gt;&gt;<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />Sǝm bang anggo, acemǝnana sǝm nggǝ ok ama, aɓea aɓwana nda aɓalǝ wun mǝnana à kǝ dukdo ɓana, à kǝ pak kǝ túró raka. Kǝ túró malea nda kutiki aɓalǝ acau mala aɓwana. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />Aɓa lullǝ Mǝtalabangŋo Yesu Kǝrǝsti ka, sǝm nggǝ cia sǝ sǝm nggǝ zǝmbia wia, ɓǝa dum nǝ hamírǝu, ɓǝa pǝlǝ buia, ace mǝnana ɓǝa linǝ ɓamuria ka. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />Sǝ wun, amǝ'eambǝam ngga, wu kǝa aulǝ nǝ pěmǝɓoarne ɗàng.<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />Wu tsǝkir wun arǝ ɓwa mǝnana ɓinǝ kpata cau mǝnana sǝm ne aɓa mǝnia yì cauterǝa ka. Wu purî njargula male, ace mǝnana ɓǝ̀ kǝsǝkya kumi. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />Sǝ wu kǝa twali kǝla ɓi wun mǝbura ɗang, wu nunkiri, kǝla mǝ'eam wun.<verse eid="2TH 3:15" /></para>
  <para style="s">Masǝlǝata makkun mala Bulǝs</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />Ado ka, ɓǝ̀ Mǝtala dorǝpwala nǝ nggearǝì, pa wun dorǝpwala ko aya pwari, a koya njargula kat. Mǝtalabangŋo ɓǝ̀ do atà wun kat.<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />Mim Bulǝs ka, nǝ buam sǝ ǝn gilǝ mǝnia yì makkun ngga. Mim ngga, anggo sǝ ǝn nggǝ tsǝk buam arǝ koya cauterǝa mem; anggo sǝ ǝn nggǝ gilǝgir. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />Ɓǝ̀ ɓwamuru mala Mǝtala sǝm Yesu Kǝrǝsti, do atà wun kat.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>