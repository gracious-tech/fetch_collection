<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Mbula</book>
  <para style="h">Markus</para>
  <para style="toc3">Mar</para>
  <para style="toc2">Markus</para>
  <para style="toc1">Cau amsǝban a nê mala Markus</para>
  <para style="mt2">Cau amsǝban a nê mala</para>
  <para style="mt1">MARKUS</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Cau Amsǝban a nê mala Markus ka </char> nda &lt;&lt;Bǝsa Cau mǝɓoarne amur Yesu Kǝrǝsti, Muna mala Ɓakuli.&gt;&gt; Yesu ka à lǝmdǝí kǝla ɓwa mǝnana ɓǝ̀ bangcau ka nǝ̀ lùmsǝì, sǝ yì ɗǝm ngga ndanǝ gara. Gara male ka à sǝni arǝ kanigir male, andǝ rǝcandǝa male amur akukwar, andǝ twalban cauɓikea mala aɓwana. Yesu tunǝ ɓamúrì ama yì nda Muna mala Ɓwa, mǝnana yiu ace mana nǝ̀ yia pa ɓamúrì ace pusǝ aɓwana male aɓalǝ acauɓikea.</para>
  <para style="ip">
    <char style="bk">Markus </char> nacau amur agir mana Yesu pea, andǝ acau mana nea, andǝ akanìgìr male. Bang cau bǝti amur Yohana Mǝbatisǝma, andǝ batisǝma mala Yesu, andǝ kārǝkiban male ka, pǝlǝa kutio aban bangcau amur túró mala Yesu mala twalban rǝkwana andǝ kanigir. Aban ká masǝlǝate ka <char style="bk">Markus </char> bangcau amur agir mǝnana à kum Yesu a masǝlǝata do yilǝmu male aɓa ɓanza, nggeamurǝmi ka gbaliban male amur nggun-gangndǝi, andǝ lo male a ɓembe.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Tita mǝnia yì Bǝsa Cau Mǝɓoarne ka<char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">Túró mala Yesu bwāng aɓa Galili<char style="ior"><ref loc="MRK 1:14-9:50">1:14--9:50</ref></char></para>
  <para style="io1">Lo a Galili aban ká Urǝshalima<char style="ior"><ref loc="MRK 10:1-52">10:1-52</ref></char></para>
  <para style="io1">Masǝlǝata limo, aɓa Urǝshalima sǝ arǝ aban tù nǝ Urǝshalima<char style="ior"><ref loc="MRK 11:1-15:47">11:1--15:47</ref></char></para>
  <para style="io1">Lo mala Yesu a ɓembe<char style="ior"><ref loc="MRK 16:1-8">16:1-8</ref></char></para>
  <para style="io1">Pusǝrǝu andǝ eauwe mala Mǝtalabangŋo mǝnana nǝ yilǝmu ka aban ká a kùli<char style="ior"><ref loc="MRK 16:9-20">16:9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Hama mala Yohana Mǝbatisǝma</para>
  <para style="r">(<ref loc="MAT 3:1-12">Matiu 3:1-12</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohana 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ani sǝ Cau Amsǝban mala Yesu Kǝrǝsti, Muna mala Ɓakuli tite.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Kǝla mana à gilǝì aɓa malǝmce mala Ishaya, mǝɓangnǝa mala Ɓakuli ka, Ɓakuli bang ama:</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Mǝ ndya ǝn nggǝ túr</para>
  <para style="q2" vid="MRK 1:2">mǝturonjar mem</para>
  <para style="q1" vid="MRK 1:2">ɓǝ̀ ako dǝmba,</para>
  <para style="q2" vid="MRK 1:2">ɓǝ̀ yi gilǝkio tanjargula.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:20">Pur 23:20</ref>; <ref loc="MAL 3:1">Mal 3:1</ref></char>.</note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />&lt;&lt;Giu mala ɓeɓwa</para>
  <para style="q2" vid="MRK 1:3">kǝ tunǝban a njenza ama,</para>
  <para style="q1" vid="MRK 1:3">&lt;Wu gilǝki tanjar</para>
  <para style="q2" vid="MRK 1:3">ace Mǝtalabangŋo!</para>
  <para style="q1" vid="MRK 1:3">Wu tamsǝi wi atanjar pǝrapǝra</para>
  <para style="q2" vid="MRK 1:3">ɓǝ̀ ging nggam!&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:3">Isha 40:3</ref></char>.</note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Mǝnia yì mǝturonjar ka nda Yohana Mǝbatisǝma. Puro yiu kǝ hamnǝ Cau Amsǝban a ban aɓwana aɓa pǝɗanban a njenza ama, &lt;&lt;Wu pwanzali wu ɗeki bu wun arǝ acauɓikea ma'wun, Ɓakuli nǝ̀ twala wun bania, sǝ dumǝna púp ɓǝa pakka wun batisǝma.&gt;&gt; <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Ɓwabunda puro arǝ acilia alá aɓa nzali Yahudi, andǝ ɓá Urǝshalima aban yiu a sǝne sǝ à nǝ̀ ok hama male. À kǝ bang acauɓikea malea, sǝ Yohana kǝ pakkia wia batisǝma a kún Nggeasala Jodan. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Agir-nggūrǝu male yì Yohana ka, à pea nǝ nggu kalakadambi, sǝ nggur-ɓunu male ka nggú-bángŋá na. Girlina male ka doshi na andǝ mur'nyi mǝnana kúmó ɓun kano a ɓabondo ka.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 1:8">2Amur 1:8</ref></char>.</note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Kǝ hama, kǝ bang ama, &lt;&lt;Ɓè ɓwa nda kǝ yiu a nzǝmam ngga. Gulo kútiǎm kǝ̀rkǝ́r, ko anggur nkura kusǝì ka ǝn kārǝa mǝ nǝ kū`ndǝó mǝ nǝ panzǝia ɗàng. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Nǝ mur sǝ ǝn nggǝ pakka wun batisǝma, sǝ yì ka, nǝ̀ pakka wun batisǝma nǝ Bangŋo Mǝfele!&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">Batisǝma andǝ kārǝkiban mala Yesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Matiu 3:13-17</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Aɓalǝ amǝno yì anonggio ka, Yesu pur a Nazarat, a bu-nzali Galili. Yohana yi pakki wi batisǝma a Nggeasala Jodan. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yesu na aban eapi mùr ani ka, kara sǝn kùli mǝna. Bangŋo Mǝfele sulǝo aban yiu amurí kǝla kutu. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Gì Ɓakuli pur nǝ kuli na ama, &lt;&lt;A nda Munem mǝnana ǝn earkiyi ace raka; ban kǝ ɓoaram a rǝo kǝ̀rkǝ́r.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 22:2">Tite 22:2</ref>; <ref loc="PSA 2:7">Ang 2:7</ref>; <ref loc="ISA 42:1">Isha 42:1</ref>; <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 9:7">Mar 9:7</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char>.</note> <verse eid="MRK 1:11" /><verse number="12" style="v" sid="MRK 1:12" />Zuku ka, Bangŋo loasǝ Yesu aban ká aɓa pǝɗanban a njenza. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Nda kano aɓa pǝɗanban a njenza, nongŋo lumi-ine, Shetan na aban karǝke. Yesu ka nda nǝmurǝì andǝ anyam ɓabondo mana a banì ka. Amǝturonjar mala Ɓakuli yiu à yì bwalì wi kàm.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesu tita tunǝ amǝ kpate</para>
  <para style="r">(<ref loc="MAT 4:12-22">Matiu 4:12-22</ref>; <ref loc="LUK 4:14">Luka 4:14</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Anzǝm mana à bwalǝna Yohana à oasǝni a ndàkurban ngga, Yesu o a nzali Galili, kǝ hamnǝ Cau Amsǝban mala Ɓakuli. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Kǝ bang ama, <char style="wj">&lt;&lt;Pwari kārǝ́na! Domurǝm mala Ɓakuli gbashìnà tù! Wu pwanzali wu ɗeki bu wun arǝ acauɓikea ma'wun, wu earnǝ Cau Amsǝban wu é!&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:2">Mat 3:2</ref></char>.</note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Lang Yesu nda ban gya a kun Nggeamùr Galili ka, mǝsǝì kpa arǝ Shiman andǝ mǝ'eambi Andǝru, aban taula nǝ andámbú, acemǝnana yia ka amǝbwalki anji na. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesu nea wia ama, <char style="wj">&lt;&lt;Wu yiu atàm, mǝ nǝ tsǝk wun wu nǝ̀ duk amǝbwalki aɓwana.&gt;&gt;</char> <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Àkǝ̀ banì kara à ɗeki andámbú malea, à kpate.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Nǝ̀ tùr a dǝmba bǝti anggo ka, nyare sǝn Jemis, muna mala Zabadi atārǝia andǝ mǝ'eambi Yohana. Yia ka à nda aɓa waru aban gilǝki andámbú malea. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Yesu tunǝia. Pǝlǝa à ɗeki tárrià yì Zabadi aɓa waru andǝ aɓwana mǝnana à twalia ace nun ndāmbú ka, à o atè.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesu pusǝ kukwar arǝ ɓwa</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luka 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Yesu andǝ alaggana male wari a Kapanahum. Pwari Sabbat karna ka Yesu kutio a ndakpapi, tita kanigir kam. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Kànìgìr male pakkia wia ndali, acemǝnana kǝ kania wia gìr nǝ sǝlǝe andǝ rǝcandǝa, pa kǝla mala amalǝm Nggurcau ɗàng.<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 7:28">Mat 7:28</ref>,<ref loc="MAT 7:29">29</ref></char>.</note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Àkǝ̀ banì mǝno ka, ɓeɓwa ndakam nǝ bangŋo mǝɓane arǝì aɓa ndakpapi, lo mak'zwalo, kǝ na ama, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;We Yesu ɓwa Nazarat, mana a earkiyice arǝ sǝm? A yiua kiɗiki sǝm, a nǝ mal sǝm le? Ən súrǝ̀o, a nda Ɓwa Mǝfele mala Ɓakuli!&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesu sà arǝ kukwar, ne wi ama, <char style="wj">&lt;&lt;Duk kuno più, purî rǝ ɓwa man!&gt;&gt;</char><verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Bangŋo mǝɓane dǝkǝrǝki nǝ rǝcandǝa, mak'zwalo, pǝlǝa purî rǝi. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Ɓwapǝndǝa ndali kǝ̀rkǝ́r gandǝa à kǝ ɗiki rǝarǝia ama, &lt;&lt;Mana aman? Ɓè kǝ bǝsa kanigir na nǝ rǝcandǝa! Nggearǝ abangŋo mǝɓane ka, kǝ sàrǝia sǝ à kǝ oki wi.&gt;&gt;<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Àkǝ̀ dyadyan cau male akiban a bu-nzali Galili kat.<verse eid="MRK 1:28" /></para>
  <para style="s">Yesu twali aɓwana pas <optbreak /> ban rǝkwana</para>
  <para style="r">(<ref loc="MAT 8:14-25">Matiu 8:14-25</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Yesu nǝ̀ purî ɓá ndakpapi ani ka, yì, andǝ Jemis andǝ Yohana, à kutio a ɓala mala Shiman andǝ Andǝru. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Nkil Shiman mǝɓwame ka nda aban nongŋo, ɓauwa eari wi ɗàng, pǝlǝa à banggi Yesu cau mala rǝkwana male. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yesu kutio a baní kya bwali a garabui loasǝi. Ɓauwa purì rǝì, pǝlǝa lo pea wia girlina.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Lang pwari kpana ka, amǝ lě yiu nǝ amǝkwánó, andǝ aɓwana mǝnana à ndanǝ akukwar aɓa nyamia ka, a baní. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Ɓwapǝndǝa mana a là kat ka à dapi a kunɓala. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Yesu twalban arǝkwana ɗàngɗáng arǝ aɓwana sǝ pusǝki akukwar pas. Sǝ acemǝnana akukwar súrǝ́nà rǝì ama yì nda Muna mala Ɓakuli ka, earia wia ɓǝà nacau ɗàng.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesu o a pak hiwi nǝmurǝì</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luka 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Nǝ dǝmbari ɗiɗyal, ban malaká fa pepe ɗàng, Yesu purî ɓá là o a ban mǝnana kǝɓwa pà kàm raka, kya pak hiwi. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Shiman andǝ aɓi à puro aban alte. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Lang à kya kumǝni ka, à ne wi ama, &lt;&lt;Koyana le ka nda ban alto!&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Yesu earia wia ama, <char style="wj">&lt;&lt;Wu fa sǝm nǝ̀ kánì arǝ acili amuna-là mana akani tù ka. Mǝ nǝ nggá hamnǝ Cau Amsǝban kam gbal, acemǝnana nda kǝgìr mǝnana yinǝ mim ngga.&gt;&gt;</char><verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Pǝlǝa gya aɓa nzali Galili kat, kutio arǝ andakpapi malea aban hamnǝ Cau Amsǝban, sǝ kǝ pusǝ akukwar arǝ aɓwana.<note caller="+" style="f"><char style="fr" closed="false">1:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>.</note><verse eid="MRK 1:39" /></para>
  <para style="s">Yesu twali mǝdakali <optbreak /> ban rǝkwana</para>
  <para style="r">(<ref loc="MAT 8:1-4">Matiu 8:1-4</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ɓè ɓwa mǝdakali yiu yi kū`ndǝó a ɓadǝm Yesu, zǝmbi wi ama, &lt;&lt;Ɓǝ̀ a nǝ ear ka, a nǝ gandǝ twàlâm-ban mǝnia yì kwánó ka ɓǝ̀ rǝàm ɓoarnsari.&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Mǝsǝswatǝr bwal Yesu kǝ̀rkǝ́r, pǝlǝa lǝmdǝ buì jena rǝì nǝi, ne wi ama, <char style="wj">&lt;&lt;Ən earǝna, ɓǝ̀ rǝò malâ!&gt;&gt;</char> <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Àkǝ̀ banì kara dakali malǝna, rǝì ɓoarnansari. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Yesu ne wi cau nunkiri, pǝlǝa tasǝi ɓǝ̀ o. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Ne wi ama, <char style="wj">&lt;&lt;Kǝa ne kǝɓwa ce ɗàng. A kún mani ka, kutio kya lǝmdǝ ɓamuro a ban pǝris ɓǝ̀ pelǝkio. Sǝ ace mǝnana ɓǝ̀ koyan ngga ɓǝ̀ sǝlǝ ama rǝò malǝna ka, kyane kya pa ɓoro-bu a Ndàmǝgule kǝla mǝnana Musa kasǝa ace sonzǝo mala rǝò ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">1:44 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 14:1-32">Pǝris 14:1-32</ref></char>.</note><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Sǝama lang purna ka, kara tita mesǝ ce a koya ban ngga. Gìr nî tsǝa Yesu gandǝ kutio a ɓekǝ là a ɓamǝsǝ aɓwana ɗang, ak rǝì arǝ aban mǝnana kǝɓwa pà kàm raka. Kat andǝ amani ka, ɓwapǝndǝa puro a koya ban ngga aban yiu a baní.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesu twalban kwánó rǝwuna</para>
  <para style="r">(<ref loc="MAT 9:1-8">Matiu 9:1-8</ref>; <ref loc="LUK 5:15-26">Luka 5:15-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Anzǝm anongŋo bǝti ka, Yesu nyare a Kapanahum. Ceì akiban ama nyarǝna nda a ɓala. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Zuku ka ɓwabundǝa yiu yi lumsǝna ban kàngkàng, yi pur a kun ɓala, ko kǝ ban oasǝ kusǝu pa kàm ɗang. Lang Yesu na aban hambia wia nǝ cau mala Ɓakuli ka, <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />aɓea aɓwana, yia ine, à twal ɓe mǝrǝkwana mǝnana sú arǝ abui andǝ akusǝi ka, aɓa kala, à yiu nǝi aban Yesu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Sǝ acemǝnana ɓwapǝndǝa làkkì kǝ̀rkǝ́r, à kum njargula kútí nǝi a ɓadǝmbi raka, à pǝlǝa à eau nǝ múr kurǝm, à mǝn njar kam, sǝ à sulǝ mǝrǝkwana aɓa kala, nǝ anggúr, a ɓadǝm Yesu. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Lang Yesu sǝn gūliarǝu malea arǝì ka, pǝlǝa ne mǝrǝkwana ama, <char style="wj">&lt;&lt;Laggalem, à twalǝno ban acauɓikea mô.&gt;&gt;</char><verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Aɓea malǝm Nggurcau ndakam aban do, à kǝ pakki aɗenyicau arǝarǝia ama, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt;Palang sǝ mǝnia yì ɓwa ka bang ulang cau man? Nyesǝ ɓamúrì kǝla nda Ɓakuli! Kǝ Ɓakuli raka, yana ɓwe nǝ̀ gandǝ twalban cauɓikea?&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Anggo ka kara Yesu sǝlǝ ɗenyicau mǝnana a ɓabumia ka, sǝ ɗia ama, <char style="wj">&lt;&lt;Palang sǝ wu kǝ ndali amur mǝnia yì agir ka a ɓabum wun?</char> <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" /><char style="wj">Mǝye na kwano kutibanì, yi mǝnana ɓǝà ne mǝkwánó ama, &lt;À twalǝno ban acauɓikea mô&gt; ka le, ko ɓǝà na ama, &lt;Lo, twal kala mô, sǝ wu gya&gt; ka?</char> <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" /><char style="wj">Sǝ ace mǝnana ɓǝ̀ wu sǝlǝ ama Muna mala Ɓwa ka, ndanǝ rǝcandǝa akani a ɓanza, mala twalban cauɓikea ka, mǝ ndo mǝ nǝ lǝmdǝa wun ngga.&gt;&gt;</char> Pǝlǝa ne mǝkwánó ama, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" /><char style="wj">&lt;&lt;Mǝ́ nǝ̀ banggo, lo, twal kala mô, o a ɓala!&gt;&gt;</char><verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Pǝlǝa mǝkwánó lo, twal kala male, àkǝ̀ ɓamǝsǝia kat, aban o. Koyan ngga gìr nî pakki wi ndali, à gusǝlǝ Ɓakuli à kǝ bang ama, &lt;&lt;Sǝm malaká sǝn ulang mǝnia yì gìr ka ɗàng!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">Yesu tunǝ Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Matiu 9:9-13</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesu nyare puro o a kun Nggeamùr Galili. Ɓwabunda puro aban ká a baní, pǝlǝa kania wia gìr. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nda ban kutio ka, mǝsǝì kpa arǝ Lawi, muna mala Alfiyus, dumǝna aban ak boalo-cemi, aɓa mǝdanki cemi. Yesu ne wi ama, <char style="wj">&lt;&lt;Yiu atàm.&gt;&gt;</char> Pǝlǝa Lawi lo o atè. <verse eid="MRK 2:14" /><verse number="15" style="v" sid="MRK 2:15" />Anzǝm mǝno ka Yesu do aban li girlina a ɓala mala Lawi. Amǝcemi pas andǝ amǝnana aɓwana twalia ama amǝ'cauɓikea na ka, à yì do à kǝ lili andǝ Yesu andǝ alaggana male. Aɓwana ulang amǝnia ka à ndakam pas mǝnana à kǝ gya atà Yesu ka. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Lang amalǝm Nggurcau mala Musa mǝnana amǝ Farisi na, à sǝn Yesu aban lili andǝ amǝ'cauɓikea andǝ amǝcemi ka, à ɗì ka laggana male ama, &lt;&lt;Palang sǝ kǝ lili andǝ amǝcemi andǝ amǝ'cauɓikea?&gt;&gt; <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Yesu nǝ̀ oè ka, nea wia ama, <char style="wj">&lt;&lt;Aɓwana mǝnana rǝia bǎng ngga, à kǝ alta mǝsonzǝo ɗang, she amǝkwánó. Ən yiu ace tunǝ aɓwana mǝnana à kǝ sǝni kǝla amǝ'cauɓoarna na ka ɗàng, ǝn yiu ace tunǝ amǝ'cauɓikea.&gt;&gt;</char><verse eid="MRK 2:17" /></para>
  <para style="s">Ɗiban amur gilmùr</para>
  <para style="r">(<ref loc="MAT 9:14-17">Matiu 9:14-17</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Ɓè pwari nakam alaggana mala Yohana Mǝbatisǝma andǝ amǝ Farisi à nda ban gilmùr. Aɓea ɓwana yiu aban Yesu à yì ɗì ama, &lt;&lt;Palang sǝ alaggana mala Yohana andǝ mala amǝ Farisi ka, à kǝ gilmùr, sǝ alaggana mò ka à kǝ gil ɗang?&gt;&gt; <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />Yesu nea wia ama, <char style="wj">&lt;&lt;Lang sǝ agyajam mala bura-māfela nǝ̀ gilmùr yi mǝnana nda abania peatu ka? Ɓǝà nda atārǝia andǝ bura-māfela ka, à pà nǝ̀ gilmùr ɗàng.</char> <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" /><char style="wj">Pwari mǝnana à twalǝna bura-māfela a rǝia ka, akàm sǝ yia ka à nǝ̀ gilmùr.</char><verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />
    <char style="wj">&lt;&lt;Kǝɓwa pà nǝ̀ twal nggubyau mǝbǝshe sǝ nǝ̀ mbàkìnà mǝ'e nǝi ka ɗàng. Ɓǝ̀ pè anggo ka, nggubyau mǝbǝshe nǝ̀ kpami, nǝ̀ san nggubyau mǝ'e, nggea sana mǝgule.</char> <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" /><char style="wj">Sǝ kǝɓwa pà nǝ̀ solǝ mùr-ɓǝlanggun anap mǝbǝshe aɓa eakǝna sambǝram mala mùr-ɓǝlanggun anap ɗang. Ɓǝ̀ pa anggo ka, mùr-ɓǝlanggun anap nǝ̀ vwali nǝ̀ ar luru, sǝ mùr-ɓǝlanggun anap andǝ sambǝram kǝm ngga à nǝ̀ ueɓà. Mùr ɓǝlanggun anap mǝbǝshe ka a sambǝram mǝbǝshe sǝ à nǝ̀ soe.&gt;&gt;</char><verse eid="MRK 2:22" /></para>
  <para style="s">Ɓwamǝgule amur Sabbat</para>
  <para style="r">(<ref loc="MAT 12:1-8">Matiu 12:1-8</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />A ɓè pwari Sabbat, pwari usǝlǝo mala amǝ Yahudi, Yesu andǝ alaggana male gya à kǝ kútí nǝban aɓea aɓaban mǝssa. À nǝ̀ nggǝ ká ka, alaggana male kùtí a harki kir mǝssa à kǝ she.<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 23:25">Nggur 23:25</ref></char>.</note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Pǝlǝa amǝ Farisi ne wi ama, &lt;&lt;Sǝni, palang sǝ alaggana mo kǝ yàl Nggurcau, à kǝ pak túró kasǝki mǝssa a pwari Sabbat?&gt;&gt; <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Wu ɓal gìr mǝnana Dauda pak ka re, yi mǝnana yì andǝ amǝtè ka, nzala walia sǝ à kùtí a alta girlina ka?</char> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" /><char style="wj">Yiu yi kutio aɓa Nda mala Ɓakuli (a bàkì mǝnana Abiyata nda pǝris mǝgule ka), yàl Nggurcau, shak bǝredi mǝnana à tarrì ace Ɓakuli, mǝnana apǝris na nǝmurǝia ɓoaro ɓǝa shak ka. Pǝlǝa pe aɓwana mǝnana atè ka gbal, à she.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">2:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 21:1-6">1Sam 21:1-6</ref>; <ref loc="LEV 24:9">Pǝris 24:9</ref></char>.</note> <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Sabbat, pwari usǝlǝo mala amǝ Yahudi ka, à pè ace ɓwapǝndǝa, à pak ɓwapǝndǝa ace Sabbat ɗang.</char> <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" /><char style="wj">Ace mani ka, mim Muna mala Ɓwa ka, mǝ nda Mǝtalabangŋo sǝ mǝ nda mǝtala Sabbat gbal.&gt;&gt;</char><verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesu twalban rǝkwana <optbreak /> a pwari Sabbat</para>
  <para style="r">(<ref loc="MAT 12:9-14">Matiu 12:9-14</ref>; <ref loc="LUK 6:6-11">Luka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />A ɓekǝ pwari ka Yesu nyare kutio a ndakpapi. Ɓè ɓwa nakam buì wu. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Amǝ Farisi ka, mǝsǝia ue arǝì à nǝ̀ sǝni ko nǝ̀ twalban rǝkwana a pwari Sabbat, pwari usǝlǝo mala amǝ Yahudi. Ace mǝnana à nǝ̀ kum cau mǝnana, à nǝ̀ bwali nǝi ka.<verse eid="MRK 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 3:3" />Yesu ne ɓwa mǝnana buì wu ka ama, <char style="wj">&lt;&lt;Lo, yiu yi cam kani a ɓadǝm aɓwana.&gt;&gt;</char> <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Yesu pǝlǝa ɗì aɓwana ama, <char style="wj">&lt;&lt;Mǝ ye na nggurcau eare ɓǝà pè a pwari Sabbat, ɓǝà pak mǝɓoarne le ko ɓǝà pak mǝɓane? Ɓǝà amsǝ yilǝmu le ko ɓǝà kiɗiki?&gt;&gt;</char> Kara à duk kunia più.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Pǝlǝ rǝì anggo sǝnia nǝ bumlulla, nǝ bumkiɗikea kǝ̀rkǝ́r arǝ murcandǝa malea, pǝlǝa ne mǝkwánó ama, <char style="wj">&lt;&lt;Sárǝ́ buo.&gt;&gt;</char> Lang mǝrǝkwana sárǝ́ buì ka, kara rǝì mala, buì nyarǝna pàngŋǝ̀nà pepè! <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Kara amǝ Farisi puro a nza, à kya kum aɓwana mala Hirǝdus, à kùrkún arǝarǝia andǝia, amur wal-lú Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s">Ɓwabunda o atà Yesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesu lo andǝ alaggana male à nyare a kun nggeamùr. Ɓwabunda pas puro o atè. À pur arǝ aban aɓa Galili, andǝ Yahudi, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />andǝ Urǝshalima, andǝ bu-nzali Idumiya, andǝ nkaring Nggeasala Jodan; sǝ aɓea ka à pur kuko nǝ abu-nzali mala amǝ Taya andǝ Sidon, à yiu atè. Cau mala agir-ndali mana kat kǝ pakki ka mǝsǝe akiban, nda ɓwabundǝa pas puro yiua sǝne ka. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ace ɓiki làkkì mala ɓwapǝndǝa ka, pǝlǝa ne alaggana male ama ɓǝà alta muna-waru nǝ̀ eau kam, ɓǝ̀ ɓwapǝndǝa ɓǝ̀ kǝa nggiki ɗàng. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />A mǝno yì pwari ka twalǝ́nì aɓwana pas ban arǝkwana malea, nda aɓea amǝkwánó ɗàngɗáng kǝ ramgiban aban ká dǝmba à nǝ̀ je rǝì. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Ɓǝ̀ aɓwana mǝnana nǝ akukwar aɓa nyamia sǝni nǝ sǝna ani ka, à yì sukki nǝ sukkio a ɓadǝmbi nǝ zwalo a kunia, à kǝ na ama, &lt;&lt;A nda Muna mala Ɓakuli!&gt;&gt; <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Sǝ yì ka, nunkir akukwar nì kǝ̀rkǝ́r ama ɓǝa kǝa na yan nda yì ɗang.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesu tàrki amǝ Mishan <optbreak /> lum nong-ɓari</para>
  <para style="r">(<ref loc="MAT 10:1-4">Matiu 10:1-4</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesu eauwe amur nkono, sǝ tunǝ aɓwana mǝnana earki cea ka, pǝlǝa à eauwe atè. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Kya tarki aɓwana lum nong-ɓari sǝ pea wia lullǝu ama amǝ'mishan. Yia ka à nǝ̀ do atè, sǝ nǝ̀ nggǝ tasǝia ɓǝa kya hamnǝ Cau Amsǝban, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />sǝ pea wia rǝcandǝa mala pǝr akukwar ɓǝà purkî rǝ aɓwana. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Atà aɓwana lum nong-ɓari mǝnana tarkia ka</para>
  <para style="li" vid="MRK 3:16">Shiman ndakam (yi mǝnana tsǝki wi lullǝu ama Bitǝrus ka).<verse eid="MRK 3:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="MRK 3:17" />Jemis muna mala Zabadi, andǝ mǝ'eambi Yohana (mana tsǝkia wia lullǝu ama Boanajis: ɓālǝi ama, Amuna mala Mgbarangce) ka, à ndakam ateà.<verse eid="MRK 3:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="MRK 3:18" />Andǝru,</para>
  <para style="li" vid="MRK 3:18">andǝ Filip,</para>
  <para style="li" vid="MRK 3:18">andǝ Batalomi,</para>
  <para style="li" vid="MRK 3:18">andǝ Matiu,</para>
  <para style="li" vid="MRK 3:18">andǝ Toma,</para>
  <para style="li" vid="MRK 3:18">sǝ Jemis muna mala Alfiyus,</para>
  <para style="li" vid="MRK 3:18">sǝ Tadawus ka, à ndakam gbal ateà.</para>
  <para style="li" vid="MRK 3:18">Acilia ka à nda ka Shiman yì ɓwa mǝnana earkiyi ace là male raka,<verse eid="MRK 3:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="MRK 3:19" />sǝ Yahuda Iskariyoti mǝnana me ka.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu ka kutì murǝm mala akukwar</para>
  <para style="r">(<ref loc="MAT 12:22-32">Matiu 12:22-32</ref>; <ref loc="LUK 11:14-23">Luka 11:14-23</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Yesu kutio a ɓè ɓala. Ɓwabunda yiu yi ram ɗǝm, mǝnana tsǝa yì andǝ alaggana male ka à gandǝ li girlina raka. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Lang amǝ ɓala male nǝ̀ ok ce ka, à puro à wari ama à nǝ̀ nggá bwali, à nǝ̀ um nǝi, acemǝnana a nê malea ka, &lt;&lt;Múrí pǝlǝna.&gt;&gt; <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Sǝ amalǝm Nggurcau mala Musa mǝnana à pur nǝ Urǝshalima ka, à kǝ na ama, &lt;&lt;Be'elzebul, murǝm mala akukwar kutio arǝì. Nda gìr mǝnana tsǝa sǝ ndanǝ rǝcandǝa mala pǝr akukwar ɓǝà pur ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>.</note> <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Pǝlǝa Yesu tunǝia sǝ nea wia cau nǝ kanicau ama, <char style="wj">&lt;&lt;Palang sǝ Shetan nǝ̀ pǝr Shetan?</char> <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" /><char style="wj">Nzali murǝm mǝnana aɓwana male gakkia à kǝ munǝo arǝarǝia ka, pà nǝ̀ cam ɗang.</char> <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" /><char style="wj">Sǝ ɓǝ̀ ɓala gau rǝì aban munǝo arǝarǝia ka, mǝno yì ɓalae gbal ka, pà nǝ̀ cam ɗang.</char> <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" /><char style="wj">Anggo gbal, ɓǝ̀ Shetan lo arǝ ɓamur rǝì sǝ gau ka, pà nǝ̀ cam ɗang, male malǝna.</char> <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" /><char style="wj">Mǝsǝcau ka, ɓwa pa nǝ̀ gandǝ kutio a ɓala mala candǝna ɓwa nǝ̀ pwan girkuma male ɗàng, she ɓǝ̀ angŋǝna dǝmba tana abui andǝ akusǝi ka, sǝ nǝ̀ gandǝ pwan girɓala male.</char><verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />
    <char style="wj">&lt;&lt;Ən nggǝ na wun mǝsǝcau, koya cauɓikea ka à nǝ̀ twalî muna ɓwapǝndǝa banì andǝ koya cau kyauwikiban mǝnana pur a kunia ka.</char> <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><char style="wj">Sǝama cauɓikea nacau kyauwikiban arǝ Bangŋo Mǝfele ka, à pà nǝ̀ twalbani ɗàng, cauɓikea na mǝnana nǝ̀ um nǝ ɓwa a lú mǝnana málá male pà kàm raka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">3:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:10">Luk 12:10</ref></char>.</note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesu nea wia mǝnia yì cau ka, acemǝnana à kǝ na ama, &lt;&lt;Yì ka, ndanǝ kukwar atè.&gt;&gt;<verse eid="MRK 3:30" /></para>
  <para style="s">Nggea Yesu andǝ amǝ'eambi</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matiu 13:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Anggo ka nggeà Yesu andǝ amǝ'eambi à yina à yì cam a nza, sǝ à túrban ama ɓǝà tunǝi. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ɓwabunda ndya à ramba à kàrì aɓalǝu ka, pǝlǝa ɓeɓwa ne wi ama, &lt;&lt;Nggò andǝ amǝ'eambo à nda a nza à kǝ ɗìceò ka.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesu nǝ̀ ear ka nea wia ama, <char style="wj">&lt;&lt;Yana nda nggèm sǝ ayana à nda ka amǝ'eambam?&gt;&gt;</char> <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Pǝlǝ mǝsǝì arǝ aɓwana mǝnana à ramba à kàrì aɓalǝu ka, sǝ na ama, <char style="wj">&lt;&lt;Anggem andǝ amǝ'eambam ndya ka!</char> <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" /><char style="wj">Ɓwa mǝnana kat kǝ pak kàne mala Ɓakuli ka, nda mǝ'eambam, sǝ nggèm.&gt;&gt;</char><verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Kanicau arǝ mǝɓeale</para>
  <para style="r">(<ref loc="MAT 13:1-9">Matiu 13:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yesu tita kanigir ɗǝm a kún nggeamùr. Ɓwabunda ramba rǝì kǝ̀rkǝ́r, gandǝa eauwe do a waru amur nggeamùr, sǝ ɓwapǝndǝa cam a kunmur.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 5:1-3">Luk 5:1-3</ref></char>.</note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Kania wia agir pas nǝ kanicau. Aɓa kanigir male ka nea wia ama, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" /><char style="wj">&lt;&lt;Wu kwaki kir wun! Mǝ'rya puro o aban ɓeale.</char> <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" /><char style="wj">Lang nda aban kok mǝsǝɓeale ka, aɓea sukkio amur njargula, amuna-nyal yiu à yì tarkia kat.</char> <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" /><char style="wj">Aɓea sukkio amur mǝsǝtali, aban mǝnana nzali pà kàm pepè raka. Banì sau ɗang, kara mǝssa puro, acemana nzali banì lim ɗàng.</char> <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" /><char style="wj">Lang pwari ta bàng-bàng ngga, kara à wuli, à ime, acemǝnana nlerǝia bwal nzali pepè ɗàng.</char> <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" /><char style="wj">Aman ngga à sukkio aɓa mǝsǝ zwe, azwe lo gulo, kara à sorǝki amuna mǝssa kat, ko à ɓǝl ɗàng.</char> <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" /><char style="wj">Aɓea ka, à sukkio a nzǝm nzali mǝɓoarne. À gulo, à mǝn rǝia, à ɓǝl nggangsang, aman kusǝ lumi-tàrú, sǝ aman lumi tongno-nong-mwashat, nggearǝ aman ngga lumi-lum mala gìr mǝnana à ɓeal ka.&gt;&gt;</char> <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓwa mǝnana ndanǝ akiru okban ngga, ɓǝ̀ ǒ sǝ ɓǝ̀ kpākì wi.&gt;&gt;</char><verse eid="MRK 4:9" /></para>
  <para style="s">Yesu bǝl ɓá kanicau arǝ mǝɓeale</para>
  <para style="r">(<ref loc="MAT 13:10-23">Matiu 13:10-23</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref>,<ref loc="LUK 8:11-15">11-15</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Lang Yesu nda nǝmurǝì ka, aɓea ɓwana mǝnana à ok kanigir ka à yiu a baní atārǝia andǝ alaggana male sǝ à ɗì ɓǝ̀ bǝlia wia ɓalǝ akanicau nì. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Nea wia ama:</para>
  <para style="pi" vid="MRK 4:11">
    <char style="wj">Ma'wun ngga gir'sǝmbǝrǝa aɓa domurǝm mala Ɓakuli ka à pana wuni ɓǝ̀ wu súrǝì. Sǝama aɓwana mana à pa aɓalǝ wun raka, koya gìr ka à nǝ̀ banggia wia nǝ kanicau.</char> <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" /><char style="wj">Acemǝnana,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">&lt;&lt;Ɓǝ̀ mala sǝnban nǝ </char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">mǝsǝu na ka,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">à nǝ̀ sǝna,</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">sǝ à pà nǝ̀ bwalte ɗàng.</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">Ɓǝ̀ okban na nǝ kiru ka,</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">à nǝ̀ o,</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">sǝ à pà nǝ̀ súrǝì ɗàng.</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">Ɓǝ̀ ana raka à nǝ̀ nyare abanam</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">sǝ à nǝ̀ twalia wia banì!&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:12 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 6:9">Isha 6:9</ref>,<ref loc="ISA 6:10">10</ref></char>.</note><verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Pǝlǝa Yesu nea wia ama:</para>
  <para style="pi" vid="MRK 4:13">
    <char style="wj">Ɓǝ̀ wu bwalta ɓá mǝnia yì kanicau raka, lang sǝ wun nǝ̀ bwalta ɓá ɓekǝ kanicau?</char> <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" /><char style="wj">Mǝ'rya ka cau mala Ɓakuli na ɓeal ka.</char> <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" /><char style="wj">Aɓea aɓwana ka à nda kǝla mǝsǝɓeale mǝnana kpa amur njargula ka. Lang à ok cau ka, Shetan gya kaurǝa yi tarki cau mana à ɓeali a ɓabumia ka.</char> <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" /><char style="wj">Aɓea aɓwana ka à nda kǝla mǝsǝɓeale mǝnana à sukki amur mǝsǝtali ka. À ok cau mala Ɓakuli ka, a é àkǝ̀ dyadyan nǝ bumpwasǝa.</char> <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" /><char style="wj">Sǝ acemǝnana à pànǝ́ nlerǝia raka, bania sau ɗang. Ɓǝ̀ tanni ko mursana lo atà ce ka, àkǝ̀ dyadyan à nying buia.</char><verse eid="MRK 4:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="MRK 4:18" />
    <char style="wj">Aɓea gbal ka à nda kǝla mǝsǝɓeale mǝnana sukkio aɓa mǝsǝ zwe ka. Yia ka à ok cau mala Ɓakuli,</char> <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" /><char style="wj">sǝama bumpina mala pǝrta gìr ɓanza andǝ earce kume, andǝ suno ace acili agir ɗàngɗáng, à shak ce kat, ko kǝ kina pusǝ ɓǝle ɗàng.</char> <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" /><char style="wj">Aɓea ka à nda kǝla mǝsǝɓeale mǝnana à ɓeali a nzali mǝɓoarne ka, à ok cau, à é, ɓǝla a ɓabumia; aman banì lumi-tàrú, aman lumi-tongno-nong-mwashat, aman ngga lumi-lum mala gìr mǝnana à ɓeal ka.</char><verse eid="MRK 4:20" /></para>
  <para style="s">Tamsǝ pitǝla aban tamsǝe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luka 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yesu nea wia ama:</para>
  <para style="pi" vid="MRK 4:21">
    <char style="wj">À nǝ̀ tsǝk bǝsa a pitǝla sǝ à nǝ̀ kùmsǝî kǝrǝm amurí ko à nǝ̀ oasǝi aɓata gado le? Amur gìr tamsǝe sǝ à nǝ̀ tsǝì re?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:21 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Luk 11:33</ref></char>.</note> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><char style="wj">Anggo gbal gìr kat mala cau mala Ɓakuli, mǝnana sǝmbǝrǝa aɓwana bwalte raka, à nǝ̀ nggá pusǝì a banfana, ɓǝ̀ aɓwana súrǝì.</char><note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Luk 12:2</ref></char>.</note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" /><char style="wj">Ɓǝ̀ ɓwa ndanǝ kir okban ngga, ɓǝ̀ o.</char><verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Nyare lidǝmba nǝ cau ama:</para>
  <para style="pi" vid="MRK 4:24">
    <char style="wj">Wu parkir wun arǝ gir mana wu kǝ ok ka. Sǝlǝe mǝnana Ɓakuli nǝ pa wun ngga nǝ̀ kārǝí arǝ kwakikiru ma'wun arǝ cau. Yàle nǝ̀ pa wun sǝlǝe mǝnana kutibanì ka, ɓǝ̀ wu duk amǝ kwakikiru pepè ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:24 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="LUK 6:38">Luk 6:38</ref></char>.</note> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><char style="wj">Aɓwana mǝnana à kǝ kwakikiria arǝ kanigir mem ngga, Ɓakuli nǝ̀ tsǝkia wia ɓe sǝlǝe kam amur mǝnana à ndanǝi ka, sǝ aɓwana mǝnana à kǝ ginǝ kwakikiria arǝ kanigir mem ngga, ko nggearǝ bǝti mǝnana à ndanǝi ka, à nǝ̀ é a rǝia.</char><note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luk 19:26</ref></char>.</note><verse eid="MRK 4:25" /></para>
  <para style="s">Kanicau arǝ ɓeale mǝnana kǝ soa ka</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesu nyare nea wia ama:</para>
  <para style="pi" vid="MRK 4:26">
    <char style="wj">Domurǝm mala Ɓakuli ka, nda kǝla ɓwa mana kok mǝsǝɓeale a nzǝm-nzali ka.</char> <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" /><char style="wj">Dù andǝ pwari, ko nong ntulo ko lo, ɓeale man kǝ soa. Puro male andǝ gulo male ka, yì mǝ'rya nǝ ɓamúrì ka bwalte ɗàng.</char> <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" /><char style="wj">Nzali nǝ nggearǝì kǝ ɓǝl mǝssa, tite ka mǝsǝɓeale soa, yi gulo, pusǝ múrí, anzǝm man ngga pusǝ ɓǝle.</char> <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" /><char style="wj">Lang ɓǝ̀ mǝssa ɓǝlna ka, mǝ'rya nǝ̀ túr amǝtúró nǝ abyau ɓǝà cani, acemǝnana pwari cane karna.</char><note caller="+" style="f"><char style="fr" closed="false">4:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 3:13">Jol 3:13</ref></char>.</note><verse eid="MRK 4:29" /></para>
  <para style="s">Kanicau arǝ mǝsǝ musta</para>
  <para style="r">(<ref loc="MAT 13:30-32">Matiu 13:30-32</ref>; <ref loc="LUK 13:18-19">Luka 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Ɗǝm ngga Yesu bang ama:</para>
  <para style="pi" vid="MRK 4:30">
    <char style="wj">Domurǝm mala Ɓakuli ka sǝm nǝ̀ kànì arǝ mana? Ya ulang kanicau nani sǝm nǝ̀ kànì arǝì?</char> <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" /><char style="wj">Nda kǝla mǝsǝ musta mǝnana nda kyauwe kútì acili amǝsǝɓeale kat, à twali à ɓeali a nzali ka.</char> <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" /><char style="wj">Sǝ ɓǝà ɓealni ka, kǝ gulo kǝ kútì acili agirɓaban kat; kǝ mǝngi abui kǝ̀rkǝ́r mana anyal mǝnana a bum kùli ka, à kǝ gandǝ bwal ndà amurí.</char><verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesu yiu nǝ aɓea kanicau pas ulang amǝnia ka, aban kani aɓwana gìr a njargula mǝnana à nǝ̀ bwalǝna ta kanigir male nǝi ka. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Nea wia kǝ cau mana pà nǝ kanicau raka ɗàng. Sǝa ma ɓǝà nda nǝmurǝia andǝ alaggana male ka, kǝ tarkya aɓa ko man ngga.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesu tamsǝ gung-mbulo</para>
  <para style="r">(<ref loc="MAT 8:23-27">Matiu 8:23-27</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />A kǝ pwari mǝno nǝ pwarikpǝra ka, Yesu ne alaggana male ama, <char style="wj">&lt;&lt;Wu fa sǝm nǝ̀ yàle a ɓè nkaring garang.&gt;&gt;</char> <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Pǝlǝa à twal Yesu a muna waru nǝmurǝì, à ɗeki ɓwabundǝa a nzǝmia. Aɓea waru kpate. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Kara nggea gung-mbulo mǝcandǝe lo ɓua kǝ̀rkǝ́r, kǝ wal mùr kǝ ali aɓa waru, ue bǝti waru nǝ̀ ko. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesu ka nda a ntulo a tǝrtà waru, amúr gìr-loasǝmúrû. Alaggana loasǝi, à ne wi ama, &lt;&lt;Malǝm, kǝgìr oasǝo ɗang ɓǝ̀ sǝm limnggi ko?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yesu par buì lo, pǝlǝa sà arǝ gung ɓwam, sǝ ne mùr ama, <char style="wj">&lt;&lt;Ɓǝ̀ ban pwalo atò!&gt;&gt;</char> Kara gung nyare kùr kǝkǝs, ban pwal ɗǝong. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Palang sǝ ɓangciu pakka wun? Wu nda aɓa ɗwanyi gūlì a rǝàm più le?&gt;&gt;</char> <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Ɓangciu bwalia kǝ̀rkǝ́r, pǝlǝa à ɗì rǝarǝia ama, &lt;&lt;Ya ulang ɓwa nda mǝnia ka? Gung andǝ mùr à kǝ oki wi!&gt;&gt;<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesu pusǝ kukwar arǝ <optbreak /> ɓwa a Garasa</para>
  <para style="r">(<ref loc="MAT 8:28-34">Matiu 8:28-34</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu andǝ alaggana male yi eauwe a nkaring nggeamùr, a bu-nzali mala amǝ Gerasin. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Yesu nǝ̀ eapi waru ani ka, ɓeɓwa nǝ kukwar aɓa nyami pur nǝ ɓalǝ aɓembe, yi kasǝa kúni. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Mǝnia yì ɓwa ka, akiyi rǝì a nre ka aɓembe. Kǝ ɓwa gandǝ bwale kùrrì dumsǝi aban mǝ'mwashati ɗàng, ko ɓǝ̀ a nsolo sǝ à oasǝi ka. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Kusǝ pas pàk ka à nǝ̀ taka abui andǝ akusǝi nǝ nsolo andǝ anko, sǝama nǝ̀ ɓungia gucik-gucik. Kǝ ɓwa pà kàm nǝ rǝcandǝa bwale ɗàng. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Du andǝ pwari ndaban gāli a nre ka aɓembe andǝ mur ankono, kǝ makki'zwalo, sǝ kǝ cangi rǝì nǝ atali.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Lang mǝsǝì nǝ̀ kpa arǝ Yesu kuko ka, kara sarǝa a mire, kya kū`ndǝó amur ankūnǝi a ɓadǝmbi. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Mak'zwalo bàng-bàng na ama, &lt;&lt;Yesu, Muna mala Ɓakuli mana Karban Kat ka! Mana a kǝ earce pak nǝ mim? Ən zǝmbo nǝ lullǝ Ɓakuli ama kǝa pam tanni ɗàng!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 16:17">Atúró 16:17</ref>; <ref loc="HEB 7:1">Ib 7:1</ref>; <ref loc="MRK 1:24">Mar 1:24</ref></char>.</note> <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Bang anggo acemǝnana Yesu angŋa-dǝmba nani wi ama, <char style="wj">&lt;&lt;We bangŋo mǝɓane, purî ɓá rǝ ɓwa mǝnia ka.&gt;&gt;</char><verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Pǝlǝa Yesu ɗì bangŋo ama, <char style="wj">&lt;&lt;Lùllǝò a mana?&gt;&gt;</char></para>
  <para style="p" vid="MRK 5:9">Eare ama, &lt;&lt;Lullǝam nda pas, acemǝnana sǝm nda pas aɓa rǝ ɓwa mǝnia ka!&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Pǝlǝa abangŋo mǝɓane mǝnana arǝ ɓwabure ka à camarǝ ɓuaki arǝ Yesu ama ɓǝ̀ kǝa pǝria ɓǝà ɗeki mǝno yì bu-nzali ka ɗàng.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Àkǝ̀ bania tù a pal nkono ka, atǝmbǝrǝm-ɓala nda kam pas aban likiali. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Abangŋo mǝɓane zǝmbi Yesu ama, &lt;&lt;Eara sǝm ɓǝ̀ sǝm kutio arǝ atǝmbǝrǝm-ɓala.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesu eari wia ɓǝà kyane. Pǝlǝa abangŋo mǝɓane man purrì rǝ ɓwabure, à kya kutio aɓa nyam atǝmbǝrǝm-ɓala. Sǝ kara atǝmbǝrǝm-ɓala yia kat, mǝnana làkkì malea nda á-ɓari ka, à giɓi nǝ mire a pal nkono à kya ɓunno a kun gwanyi mǝ'dāhre, à sukkio aɓa nggeamùr, à ko kat abanì.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Amǝ'yál atǝmbǝrǝm-ɓala ɓangŋa à kya na ce a la andǝ amuna-là aɓa bu-nzali banì. Ɓwabunda puro yiu a sǝn gìr mǝnana kumban ngga. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Lang à yina aban Yesu ka, à yì kum ɓwa mǝnana nǝ akukwar a ɓa'nyami ɗiɗyal ka dumǝna nǝ agir-nggūrǝu arǝì, nyarǝna aɓa ɗenyicau male pepe. Gìr nî pea wia ɓangciu kat. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Aɓwana mǝnana à sǝn gìr nî mana kumban ngga, à kanî aɓwana ce puro mala akukwar andǝ gir mana kum atǝmbǝrǝm-ɓala ka. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Pǝlǝa aɓwana tita ɓuaki arǝ Yesu ɓǝ̀ purî bu-nzali malea.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Lang Yesu na aban eauwe a waru ka, ɓwa mǝnana a pusǝî wi akukwar arǝì ka yiu yi zǝmbi wi ama nǝ̀ o atè. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Yesu eari wi ɗang, ne wi ama, <char style="wj">&lt;&lt;O a ɓala, aban aɓwana mo, kya banggia wia ce túró mǝgule mǝnana Mǝtalabangŋo pakko, andǝ ɓwamuru mǝnana lǝmdǝo ka.&gt;&gt;</char> <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Pǝlǝa ɓwabure kutio o, kǝ hamnǝ ce nggea túró mǝgule mǝnana Yesu pakki wi ka, arǝ alá lum mǝnana à tunǝkia ama Dekapolis ka. Ɓwapǝndǝa mǝnana ok mǝnia yì cau ka, a ndali.<verse eid="MRK 5:20" /></para>
  <para style="s">Muna-ɓwama mala Jarus <optbreak /> andǝ ɓwama mǝrǝkwana</para>
  <para style="r">(<ref loc="MAT 9:18-26">Matiu 9:18-26</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesu andǝ alaggana male eauwe a waru a nyare a ɓe nkaring nggeamùr. Lang à yì kpashi ka, ɓwabundǝa yi ramba à kàrì, a kun nggeamùr. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Ɓè ɓwamǝgule mala ndakpapi, lùllǝì ama Jarus, yiu a baní. Nǝ̀ yia sǝn Yesu ka, pǝlǝa kpa a ɓadǝmbi,<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="LUK 13:14">Luk 13:14</ref>; <ref loc="ACT 13:15">Atúró 13:15</ref>; <ref loc="ACT 18:8">18:8</ref>,<ref loc="ACT 18:17">17</ref></char></note> <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />ɓuakia rǝì kǝ̀rkǝ́r ama, &lt;&lt;Muna-ɓwama mem ngga rǝì eari wi ɗang, mala nǝ̀ wu. Ən nggǝ zǝmbǝo, yiu yi tsǝk buo arǝì; twali wi ban rǝkwana male, ɓǝ̀ àwá!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 6:7">Mar 6:7</ref>; <ref loc="MRK 7:32">7:32</ref>; <ref loc="MRK 8:23">8:23</ref>; <ref loc="ACT 9:17">Atúró 9:17</ref>; <ref loc="ACT 28:8">28:8</ref></char>.</note><verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Yesu pǝlǝa wari atè. Ɓwapǝndǝa pas kana aban ká atà Yesu, gandǝa à kǝ nggiki. <verse eid="MRK 5:24" /><verse number="25" style="v" sid="MRK 5:25" />Ɓè ɓwama nda kam aɓalǝ aɓwana, mǝnana apǝlǝkia lum-nong-ɓari nkila na aban sukkio arǝì. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Kat andǝ amani ama amǝ sonzǝo pas pe wi ɓuri, mal gǝna male kat atà ɓuri ka, ko rǝì mal ɗang; kara rǝpangŋa male kǝ kánǝká a dǝmba nǝ ɓike. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Lang ongŋǝna ce Yesu ka, pǝlǝa yiu yi kar nǝ nzǝmi aɓalǝ aɓwana sǝ je daura male, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />nǝ ɗenyicau a ɓabumi ama, &lt;&lt;Ko ɓǝ̀ daura male na ǝn je ka, rǝam nǝ̀ malâ.&gt;&gt;<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Àkǝ̀ banì kara sukkio mala nkila male kasǝa. Sǝ oè gbal arǝì ama rǝì malǝna, à panzǝni aɓa tanni.<verse eid="MRK 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30" />Anggo ka kara Yesu sǝlǝ ama rǝcandǝa purna arǝì. Pǝlǝ rǝì aban ɓwabundǝa, sǝ ɗiban ama, <char style="wj">&lt;&lt;Yana je daura mem?&gt;&gt;</char><verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Alaggana male eari wi ama, &lt;&lt;A kǝ sǝn ɓwapǝndǝa mana kǝ nggikio ka, a nyare a ɗiban ama, &lt;Yana jem le?&gt; &gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Yesu lidǝmba nǝ sǝnban ɓwa mǝnana pak mǝnia yì gìr ka. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Ɓwama man sǝlǝna rǝ gir mǝnana kumi ka, puro yiu nǝ ɓangciu yi kpa a ɓadǝmbi, nǝ rǝɓǝla, bǝ́lì wi mǝsǝcau kat. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesu ne wi ama, <char style="wj">&lt;&lt;Munem, gūliarǝu mô a rǝàm twalǝno ban rǝkwana. O aɓa rǝpwala. Tanni mò malǝna.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">5:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 7:50">Luk 7:50</ref>; <ref loc="MRK 10:52">Mar 10:52</ref></char>.</note><verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Kun Yesu malaká pwal ɗang, aɓea ɓwana mǝnana à pur nǝ ɓala mala Jarus, ɓwamǝgule mala ndakpapi ka, à nǝ̀ yia tusǝo. À yì ne wi ama, &lt;&lt;Munio pàngŋǝ̀nà lú, kǝa pe Malǝm tanni ɓà ɗang.&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Yesu tsǝkia wia kir ce ɗàng, pǝlǝa ne ɓwamǝgule ndakpapi ama, <char style="wj">&lt;&lt;Cala ɓangciu pakko ɗàng. Makɓalǝo a rǝàm.&gt;&gt;</char> <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Pǝlǝa Yesu tamsǝ ɓwabundǝa. Eari kǝɓwa ɓǝ̀ kya atè ɗàng, she Bitǝrus, andǝ Jemis sǝ Yohana, mǝ'eam Jemis. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Lang à bingŋǝna ɓala mala Jarus, yì ɓwamǝgule ndakpapi ka, Yesu kya kum ban ngga zurina kǝ̀rkǝ́r nǝ loàsǝ̀ban mala ɓwapǝndǝa aban ɓua andǝ makki'zwalo. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yi kutio a ɓala, pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Mana pur arǝ wun sǝ wu kǝ ɓua, wu mesǝke ani watsak? Muna ka wu ɗàng, nda a ntulo!&gt;&gt;</char> <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Kara à oali nǝ oalo. Yesu pǝlǝa pǝria pusǝia a nza kat, sǝ tunǝ tár muna andǝ ngge, andǝ alaggana male mǝnana atè ka, à kutio aɓa ndà aban mǝnana muna nong kam ngga. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Kya bwali a garabui sǝ ne wi ama, <char style="wj">&lt;&lt;Talita kum!&gt;&gt;</char> Ɓālǝi ama, <char style="wj">&lt;&lt;Muna-ɓwama, lo!&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">5:41 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 7:14">Luk 7:14</ref>; <ref loc="ACT 9:40">Atúró 9:40</ref></char>.</note><verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Kara mǝnia yì muna-ɓwama, mǝnana apǝlǝa male na lum-nong-ɓari ka, lo sǝ tita gya! Ko yan ngga ndali kǝ̀rkǝ́r. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesu tsǝkia wia nzongcau mǝcandǝe ama ɓǝà kǝa ne kǝɓwa ce ɗang. Pǝlǝa banggia wia ɓǝa pe muna-ɓwame girlina ɓǝ̀ li.<note caller="+" style="f"><char style="fr" closed="false">5:43 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 1:43-44">Mar 1:43-44</ref>; <ref loc="MRK 7:36">7:36</ref></char>.</note><verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">À ginǝ Yesu a Nazarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Matiu 13:53-58</ref>; <ref loc="LUK 4:26-30">Luka 4:26-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesu pǝlǝa nying mǝno yì bu-nzali ka, nyare andǝ alaggana male a Nazarat, la male. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />A pwari Sabbat mǝnana kar ka, yì pwari usǝlǝo mala amǝ Yahudi, Yesu tita kanigir aɓa ndakpapi. Aɓwana mǝnana kat à oe ka, à ndali kǝ̀rkǝ́r, pǝlǝa à ɗiban ama, &lt;&lt;Ake sǝ mǝnia yì ɓwa ka kum mǝnia yì sǝlǝe andǝ rǝcandǝa mala pakkia ulang amǝnia yì agir-ndali ka? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Kafinta man na mbak? Yì nda muna mala Maryamu mbo, sǝ amǝ'eambi Jemis, Yisǝfu, Yahuda andǝ Shiman, andǝ amǝ'eambi amuna mamǝna pa kani aban sǝm re?&gt;&gt; Kara bumia kiɗiki arǝì, à ginǝ earnǝi.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Yesu pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Mǝɓangnǝa mala Ɓakuli ka, à kǝ pe wi gulo a koya ban ngga, she àkǝ̀ la male, aɓalǝ aɓwana male, a nggearǝ kǝ amǝ ɓala male.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 4:43">Yoh 4:43</ref>,<ref loc="JHN 4:44">44</ref></char>.</note> <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ace ɗwanyi earnǝban malea arǝì ka gandǝ pakkia kǝ túró mǝgulke ɗang, kǝ amǝkwánó shen à nda ka mǝnana tsǝkbu amúrià sǝ twalia wia ban rǝkwana ka. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Ndali kǝ̀rkǝ́r nǝ ɗwanyi pa ɓamuru malea a baní. Pǝlǝa kutio arǝ amuna-là kǝ kanigir kam.<verse eid="MRK 6:6" /></para>
  <para style="s">Yesu tasǝ alaggana mana <optbreak /> lum-nong-ɓari ka</para>
  <para style="r">(<ref loc="MAT 10:5-15">Matiu 10:5-15</ref>; <ref loc="LUK 9:1-6">Luka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Yesu tunǝ alaggana male mana lum-nong-ɓari ka, tasǝia ɓari-ɓari, pea wia rǝcandǝa amur akukwar. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Kwarkiria ani: &lt;&lt;Wu kǝa twal kǝgìr ace gya ɗang, ko girlina, ko luru, ko boalo a lǝpan. Kǝ gara gya nda wu nǝ̀ twal ka.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 10:4-11">Luk 10:4-11</ref></char>.</note> <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Wu oasǝ ankura, wu kǝa twal daura ɓari ɗang.&gt;&gt; <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Nyare banggia wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ ya ɓala na wu kútí kam sǝ à ak wun ngga, wu do a ɓalae she pwari mǝnana wun nǝ̀ nying le ka.</char> <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><char style="wj">Sǝ ɓǝ̀ wu wari àkǝ̀ ban sǝ à ɓinǝ ak wun ko à ginǝ cau ma'wun ngga, wu kǝtǝriki tú mǝnana a kusǝ wun ngga, ɓǝ̀ wun nǝ̀ nying banì ka. Ɓǝ̀ dupia wia gir'lǝmdǝa ama, bu wun pa aɓa ɓashi mǝnana nǝ̀ yiu amúrià ka ɗàng!&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 13:51">Atúró 13:51</ref></char>.</note><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Pǝlǝa alaggane puro, à kǝ hambi aɓwana ama ɓǝa pwanzali ɓǝa ɗeki buia arǝ acauɓikea malea. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />À pusǝki akukwar arǝ aɓwana pas, à hasǝ mùrú amur amǝ rǝkwana pas, sǝ à twalia wia ban arǝkwana.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JAS 5:14">Jem 5:14</ref></char>.</note><verse eid="MRK 6:13" /></para>
  <para style="s">Lú mala Yohana Mǝbatisǝma</para>
  <para style="r">(<ref loc="MAT 14:1-12">Matiu 14:1-12</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luk 9:19</ref></char>.</note>Murǝm Hirǝdus Antipas ok ce amǝnia yì agir ka, acemǝnana lullǝ Yesu akiban. Aɓea aɓwana kǝ na ama, &lt;&lt;Yohana Mǝbatisǝma na loapi ɓembe ka! Nda gìr nî sǝ kum mǝnia yì rǝcandǝa pakki agir-ndali ka.&gt;&gt; <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Aɓea aɓwana ama, &lt;&lt;Iliya na.&gt;&gt; Sǝ aɓea aɓwana ka à bang ama, &lt;&lt;Ɓè kǝ mǝɓangnǝa mala Ɓakuli ulang amǝnana a pwarian ngga nda.&gt;&gt; <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Lang Hirǝdus ok ce ka, na ama, &lt;&lt;Yohana Mǝbatisǝma mǝnana ǝn kasǝ meali ka, nda loapi ɓembe ka!&gt;&gt;<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />
    <note caller="+" style="f">
      <char style="fr" closed="false">6:17 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref></char>.</note>Hirǝdus nǝ nggearǝì ka tasǝna aɓwana à kya bwalǝna Yohana, à oasǝni a ndàkurban. Pak mǝnia ka ace Hirǝdiya, mala mǝ'eambi Filip, mǝnana yì, yì Hirǝdus ali atè ka. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Nda acemǝnana Yohana Mǝbatisǝma ka, camarǝ ne Hirǝdus ama, &lt;&lt;Nggurcau ear ama wu dum nǝ mala mǝ'eambo ɗang!&gt;&gt;<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Nda gìr nî sǝ Hirǝdiya bwal Yohana a bumi, kǝ earce wal-luí ka, sǝ ɓǝ̀ pà nǝ́ eare mala Hirǝdus raka, pà nǝ̀ gandǝ pakki wi kǝgìr ɗang. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Hirǝdus ka, kǝ ɓanggi Yohana; sǝ acemǝnana sǝlǝna ama Yohana ka ɓwa mǝɓoarne na, ɗǝm ngga ɓwa mala Ɓakuli na ka, kǝ yállí, eare ama kǝgìr je ɗang. A koya pwari sǝ ɓǝ̀ Yohana bangcau andǝ Hirǝdus ka, ban kǝ ɓiki Hirǝdus kǝ̀rkǝ́r. Sǝ kat andǝ amani ka, kǝ earce kwakikiri arǝ Yohana.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />A masǝlǝate ka Hirǝdiya kum dǝmbǝu, a pwari pakkiɗire ɓǝlban mala Hirǝdus. À lamgi agirlina, à turkiban arǝ amǝtè, andǝ akasǝla, andǝ aɓwana-mǝgule mǝnana a bu-nzali Galili ka. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Muna-ɓwama mala Hirǝdiya puro aɓa tūli sǝ ta'nggwam nǝ ta ana, ban ɓoari Hirǝdus andǝ abǝri mǝnana tunǝia li ka. Gandǝa Murǝm banggi muna-ɓwama ama, &lt;&lt;Zǝm ko mana gir nî kat a earki ce ka, mǝ nǝ po wi.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Murǝm pe wi cau ama, &lt;&lt;Gìr mǝnana kat a zǝmbam ngga, ko ɓǝ̀ mǝ nǝ gau nzali domurǝm mem a ɓalǝu ka, mǝ nǝ po wi.&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Kara muna-ɓwama man nyare aban ngge, ɗì ama, &lt;&lt;Mana ado mǝ nǝ zǝm le?&gt;&gt; Ngge ne wi ama, &lt;&lt;Ne wi ama ɓǝa po ɓamur Yohana Mǝbatisǝma.&gt;&gt; <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Kara nyare a kaurǝa aban murǝm sǝ ne wi ama, &lt;&lt;Ən nggǝ earce nǝma wu pam ɓamur Yohana Mǝbatisǝma aɓa tasau àkǝ̀ dyadyan!&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Ɓabum murǝm kiɗiki kǝ̀rkǝ́r, sǝ ace kána mǝnana kána a ɓamǝsǝ abǝri male ka, gandǝ ginǝì wi ɗàng. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Àkǝ̀ banì sǝ murǝm tasǝ mǝwalki alú, ne wi ama ɓǝ̀ kyane a ndàkurban, ɓǝ̀ kasǝ ɓamur Yohana sǝ ɓǝ̀ yinǝi. Ɓwabure pǝlǝa wario kya kasǝ ɓamur Yohana a ndàkurban <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />sǝ yinǝi aɓa tasau yi pe muna-ɓwame. Yì gbal ka kutio kya pe nggè. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Lang alaggana mala Yohana ok ce ka, à wario à kya twal lui à yì tsǝì a ɓembe.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesu linǝ́ aɓwana á-tongno</para>
  <para style="r">(<ref loc="MAT 14:13-21">Matiu 14:13-21</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohana 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Amǝ'mishan mala Yesu nyàrî túró hama sǝ à yiu a baní, à naki wi ce agir mǝnana kat à pakki ka andǝ agir mǝnana à kànì ka. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Yesu pǝlǝa na ama, <char style="wj">&lt;&lt;Wu fani sǝm nǝ̀ sunyi aban mǝnana kǝɓwa pà kàm raka, wu kya usǝlǝo.&gt;&gt;</char> Bang anggo acemǝnana ɓwapǝndǝa pas camarǝ yiu sǝ à kǝ o, ko à kum njar à lili ɗang.<verse eid="MRK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32" />Nda à eauwe a waru aban ká aban mǝnana kǝɓwa pà kàm raka, yia na nǝmurǝia. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ɓwapǝndǝa pas mǝnana à sǝnia aban o ka, à súrǝ̀ia, pǝlǝa à ɓangŋa a kun nggeamùr aban ká. Ɓwapǝndǝa puro à koya la ka nǝ kusǝia, à kya kasǝ múrià. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Lang Yesu nǝ̀ eapi waru ka, sǝn làkkì mala ɓwapǝndǝa, mǝsǝswatǝr malea bwali kǝ̀rkǝ́r, acemǝnana à nda kǝla anzur mǝnana yalgir pa ateà raka. Pǝlǝa tita kania wia agir pas.<note caller="+" style="f"><char style="fr" closed="false">6:34</char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 27:17">Ɓal 27:17</ref>; <ref loc="1KI 22:17">1Amur 22:17</ref>; <ref loc="2CH 18:16">2Acau 18:16</ref>; <ref loc="EZK 34:5">Ezǝk 34:5</ref>; <ref loc="MAT 9:36">Mat 9:36</ref></char>.</note><verse eid="MRK 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35" />Anggo ka pwari na arǝ ká kpa, alaggana male yiu a baní à yì ne wi ama, &lt;&lt;Ban mǝnia ka kǝɓwa pà kàm ɗang, ɗǝm ngga pwari kpana. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Ɓoaro male ka, ɗeki aɓwana ɓǝa o arǝ amuna-là aban mǝnana à nǝ̀ kum girlina kam ngga.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Sǝ Yesu nea wia ama, <char style="wj">&lt;&lt;Wu pea wia ɓe kǝgìr ɓǝa li.&gt;&gt;</char> À ɗì ama, &lt;&lt;Sǝm nǝ̀ kum ake? Sǝm nǝ̀ nggá pak túró boalo mala zongŋo tongno-nong-tàrú sǝ sǝm nǝ̀ kur girlina mǝnana nǝ̀ karǝ amǝnia yia aɓwana ka le?&gt;&gt; <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Pǝlǝa Yesu ɗia ama, <char style="wj">&lt;&lt;Bǝredi na shen a bu wun? Wu kyane wu sǝnban.&gt;&gt;</char> À kya sǝnban sǝ à yì ne wi ama, &lt;&lt;Sǝm ndanǝ bǝredi tongno nǝ nji ɓari.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Yesu pǝlǝa nea wia ama ɓǝa tsǝk aɓwana kat ɓǝa do mbop-mbop amur bondo mǝpwale. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Pǝlǝa à do mbop-mbop. Aɓea aɓwana ka à do gbǝman-gbǝman, sǝ aɓea ka, à do lumi tongno-tongno.<verse eid="MRK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 6:41" />Pǝlǝa Yesu twal agbatali bǝredi mǝnia tongno andǝ anji ɓari ka a buì. Loasǝ mǝsǝì a kùli, pak hiwi amúrià. Pǝlǝa ɓwanggi agbatali bǝredi, pe alaggana male ɓǝa gakkia aɓwana. Ɗǝm ngga ɓwanggi anji mǝnia ɓari ka pea wia, ace mǝnana koyan ngga ɓǝ̀ kùmô. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Ɓwapǝndǝa man kat ka à lìli à ɗǝmbǝo. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Alaggana ram cili ɓwangine bǝredi andǝ nji mǝnana ue ka, à lùmsǝ azace lum nong-ɓari. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Aburana nǝmurǝia mǝnana à lìli ka, ɓwa á-tongno na.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesu gya amur mùr</para>
  <para style="r">(<ref loc="MAT 14:22-31">Matiu 14:22-31</ref>; <ref loc="JHN 6:16-21">Yohana 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Tù anzǝm mǝno ka, Yesu tsǝk alaggana male ama ɓǝà eauwe a waru, ɓǝà aki dǝmba ɓǝà o a Beseda, sǝ yì ka, kúndǝô nǝ̀ ne aɓwabundǝa ɓǝà o a la. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Anzǝm mǝnana tsǝ̀ngŋǝ̀nà aɓwana a ndà ka, pǝlǝa eauwe o a pak hiwi amur nkono.<verse eid="MRK 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47" />Lang ban bwalǝna ka, alaggana male ka à nda aɓa waru aɓa gauwa mala nggeamùr, sǝ Yesu ka nda nǝmurǝì a nza. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Sǝn alaggana male ka à nǝ̀ nggǝ tanniki nǝ samsǝa kǝ̀rkǝ́r arǝ gung andǝ eaki-nkono mala mùr, acemǝnana gung soea. Nǝ du anzǝm ɓaria ɓua mala nggu ka, Yesu yi gbashi bania, kǝ gya amur mùr. Yi pa kǝla nǝ̀ kutia. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />À nǝ̀ sǝni aban gya amur nggeamùr ka, à twali ama kukwar na. À mak'zwalo bàng-bàng, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />acemǝnana yia kat ka à sǝni, sǝ ǝn'ò pakkia wia kǝ̀rkǝ́r. Anggo ka, Yesu sà'arǝia ama, <char style="wj">&lt;&lt;Wu candǝ mǝsǝ wun! Mǝ nda. Ɓangciu ɓǝ̀ kǝa pakka wun ɗang!&gt;&gt;</char> <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Pǝlǝa yiu eauwe ateà a waru, gung nyare kur kǝs-kǝs. Yia ka à ndali kǝ̀rkǝ́r, nǝ gya male amur mùr, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />sǝ ɗǝm ngga, acemǝnana yia ka à bwalta ɓá gir'ndali mala linǝ́ aɓwana á-tongno nǝ bǝredi ka ɗang, ɗenyicau malea shilina, à gandǝ é ɗang.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesu sonzǝ amǝkwánó a Jenasaret</para>
  <para style="r">(<ref loc="MAT 14:34-36">Matiu 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Lang à eauna ka, à kya kpashi nǝ bu-nzali Jenasaret, à kùr waru akanó a kunto. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Lang à nǝ̀ eapi waru ani ka, ɓwapǝndǝa kara sǝlǝ ama Yesu na. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Pǝlǝa à purkio nǝ mire, à pwan amǝkwánó amur aleso, à warinǝia aban mǝnana à ok gǝshì kam ngga. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Koya ban Yesu kar kam ngga: aɓalǝ amuna-là, andǝ alamǝgule, andǝ anzǝm alá ka, à nongsǝ amǝ rǝkwana a kun alimo. À zǝmbi wi ama ko ɓǝ̀ kun daura male na ka, à nǝ̀ je; sǝ aɓwana mǝnana kat à je ka, à kum sonzǝban.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Kànìgìr amur kpata akúncau mala akáu</para>
  <para style="r">(<ref loc="MAT 15:1-9">Matiu 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />A ɓè pwari ka aɓea amǝ Farisi andǝ aɓea malǝm Nggurcau mala Musa mǝnana à pur nǝ Urǝshalima ka, à yì ram rǝia a ban Yesu. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />À sǝn aɓea alaggana mala Yesu ka, à kǝ lili nǝ abu mǝ pǝndǝke. Lǝmdǝ ama à lak abuia ɗàng. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(Amǝ Farisi andǝ acili amǝ Yahudi kat ɓǝ̀ à nǝ̀ lìli ka, she à nǝ̀ lákkí abuia kǝla mǝnana kúncau kànì ka; à bwal kúncau mǝnana à kumô a bu akeâ ka. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Ɓǝ̀ à nyàrî limo ka, à pà nǝ̀ li kǝgìr ɗàng, she ɓǝà lákkína a rǝia nǝ mùr ka. À kǝ kpata aɓea akúncau kàm pas, kǝla pàkkiagir mala lákkí akwar, andǝ ankwaring, andǝ ankenye bolo, andǝ abuno-banli.)<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Nda amǝ Farisi andǝ amalǝm Nggurcau mala Musa ɗì Yesu ama, &lt;&lt;Palang sǝ alaggana mô ka à kǝ kpata kúncau mana aká sǝm nyingga sǝm ngga ɗàng? À kǝ lili nǝ abu mǝ pǝndǝke.&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Pǝlǝa Yesu earia wia ama:</para>
  <para style="pi" vid="MRK 7:6">
    <char style="wj">Wun amǝ'kúnɓárína, ɓangnǝa mala Ishaya amur wun ngga, mǝsǝcau na, yi mǝnana gilǝa ama:</char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">&lt;&lt;Amǝnia yì aɓwana ka</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">à kǝ pam gulo </char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">nǝ mburkunia,</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">sǝ ɓabumia ka,</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">nda kuko nǝ mim.</char><verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />
    <char style="wj">À kǝ peri a banam aɓa nyir,</char></para>
  <para style="q1" vid="MRK 7:7">
    <char style="wj">akanìgìr malea ka,</char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">anggurcau mala</char></para>
  <para style="q1" vid="MRK 7:7">
    <char style="wj">ɓwapǝndǝa na!&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7:7 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 29:13">Isha 29:13</ref>
      </char>.</note><verse eid="MRK 7:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="MRK 7:8" />
    <char style="wj">Wu fa ka anzongcau mala Ɓakuli wu sukkia, sǝ wu karǝ akúncau mala ɓwapǝndǝa wu bwalia kàngkàng.</char><verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Nyare nea wia ama:</para>
  <para style="pi" vid="MRK 7:9">
    <char style="wj">Wu twali ama wu ndanǝ kutan mǝnana wu ginǝki anzongcau mala Ɓakuli, ace mǝnana wun nǝ̀ bwal a ma'wun akúncau ka!</char> <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" /><char style="wj">Musa ka bangga wun mbo ama, &lt;&lt;Pè tárró andǝ nggo gulo,&gt;&gt; sǝ ɗǝm ngga bang ama, &lt;&lt;Ɓǝ̀ ɓwa sanggi tárrí ko sanggi nggè ka, ɓǝà wal-luí&gt;&gt; re?</char><note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12">Pur 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">Nggur 5:16</ref>; <ref loc="LEV 20:9">Pǝris 20:9</ref></char>.</note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" /><char style="wj">Sǝ wun ngga, wu na ama ɓǝ̀ ɓwa ndanǝ ɓe kǝgìr mǝnana nǝ̀ pe tárrí ko nggè ace bwalia wia kàm, sǝ ginǝ pea wia, bang ama, &lt;&lt;Mǝnia ka ǝn pani Ɓakuli&gt;&gt; ka, ɓiki ɗang.</char> <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" /><char style="wj">Mǝno ka wu ndarǝ ne ɓwe ɓǝ̀ kǝa ɗenyi nǝ tárrí ko nggè nǝ gir mǝnana à ɗwanyi ka ɗàng.</char> <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" /><char style="wj">Anggo sǝ kanigir mǝnana wu ak a bu aká wun sǝ wu kǝ pea aɓwana ka, kǝ twal bancame mala cau mala Ɓakuli, kǝ nyesǝi ɓà. Aɓea gir nda kam pas kǝla amǝno mǝnana wu kǝ pea ka.</char><verse eid="MRK 7:13" /></para>
  <para style="s">Gìr mǝnana kǝ pǝndǝki ɓwa <optbreak /> a ban Ɓakuli ka</para>
  <para style="r">(<ref loc="MAT 15:10-20">Matiu 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesu nyare tunǝ ɓwabundǝa a bani tù ɓǝà okcau. Nea wia ama, <char style="wj">&lt;&lt;Wu kwaki kir wun kat wu o, sǝ wu ɓariki wu bwalta tǝr mǝnia yì cau ka.</char> <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" /><char style="wj">Gìr mǝnana nǝ nza sǝ kǝ kutio a bum ɓwa ka, nda mǝnana kǝ pǝndǝki ɓwe a ɓadǝm Ɓakuli ka ɗàng; gìr mǝnana kǝ puro a ɓabum ɓwa ka, nda mǝnana nǝ̀ pǝndǝki ɓwa ka.</char> <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" /><char style="wj">(Ɓwa mǝnana ndanǝ kiru okban ngga, ɓǝ̀ o.&gt;&gt;)</char><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Anzǝm mana Yesu nyìngŋǝ̀nà ɓwapǝndǝa sǝ kutina a ɓala ka, alaggana male yiu a bani à yì ɗî ɓá mǝnia yì kanicau ka. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Pǝlǝa Yesu ɗia ama, <char style="wj">&lt;&lt;Wun gbal ka ɓamur wun dǝmbǝri le? Wu sǝlǝ mbo ama girlina mǝnana nǝ nza sǝ ɓwa li sǝ kutio arǝì ka, pà nǝ̀ gandǝ tsǝi nǝ̀ pǝndǝki ɗang?</char> <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" /><char style="wj">Girlina ka kǝ kutio a ɓabum ɓwa ɗàng; aɓa munalungye a bumi sǝ kǝ kutio sǝ nǝ̀ nggá pur a nza.&gt;&gt;</char> (Mǝnia yì cau Yesu ne ka, lǝmdǝ ama koya girlina ka mǝɓoarnsari na a ban Ɓakuli.)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Lidǝmba na ama:</para>
  <para style="pi" vid="MRK 7:20">
    <char style="wj">Gìr mǝnana kǝ pur nǝ ɓabum ɓwa ka, nda gìr mǝnana pǝndǝkiyi ɓwa ka.</char> <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" /><char style="wj">Acemǝnana nda nǝ ɓalǝu, a ɓabum ɓwa, sǝ aɗenyicau mǝɓane kǝ puro, kìɗìkì mala nongginǝban, ǝn'í, walki alú, panzǝzana,</char> <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" /><char style="wj">nzumon, bwal ɓwa a bum, swarkiban, shamgir mala ɓwa, twal lullǝu, gusǝlǝ-múrû andǝ ɓwaɓana.</char> <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" /><char style="wj">Amǝnia yì agir mǝɓane kat ka, à kǝ pur aɓa ɗenyicau mala ɓwa; à nda ka gir mǝnana à kǝ pǝndǝki ɓwa ka.</char><verse eid="MRK 7:23" /></para>
  <para style="s">Gūliarǝu mala ɓe ɓwama</para>
  <para style="r">(<ref loc="MAT 15:21-28">Matiu 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesu nying bu-nzali Galili, o a bu-nzali Taya andǝ Sidon. Kutio a ɓè ɓala, sǝ eare ama ɓǝ̀ kǝɓwa ɓǝ̀ sǝlǝ ce ɗàng; kat andǝ amani ka, aɓwana sǝlǝa. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Sau ɗang, ɓè ɓwama nda kam mǝnana muni muna-ɓwama ka ndanǝ kukwar mǝɓike a ɓa'nyami ka, ok ce Yesu, kara yiu yi kpa a ɓadǝmbi. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Ɓwame ka ɓwa Yahudi na ɗang, ɓwa Gǝrik na, à ɓǝli a bàrèban Fonishiya aɓa bu-nzali Suriya. Yi zǝmbi Yesu ɓǝ̀ pusǝ kukwar mǝnana arǝ muni ka. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesu ne wi ama, <char style="wj">&lt;&lt;Ɓǝ̀ amuna, amǝɓala mem, amǝ Yahudi, ɓǝà li ɓǝà ɗǝmbo peatu. Acemǝnana ɓoaro ɓǝà twal girlina mala amuna ɓǝà túrì anvwa, aɓwana mǝnana amǝ Yahudi na raka ɗàng.&gt;&gt;</char><verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Pǝlǝa ɓwame ne Yesu ama, &lt;&lt;Mǝna ka mǝsǝcau na, Ɓwamǝgule, sǝama ko a ban li ka anvwa kǝ kumô à kǝ li ɓwangine mala girlina mala amuna mǝnana kǝ sukkio a nzali ka.&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Yesu ne wi ama, <char style="wj">&lt;&lt;Ace cau mò mǝno a bangŋi ka, kyane, kukwar purni rǝ munio!&gt;&gt;</char><verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Pǝlǝa ɓwame nyare a ɓala kya kum muni aban nongŋo ɗǝong aɓa kala, kukwar purni ɓa'nyami.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesu twalî mǝ talasǝɓunna <optbreak /> rǝkwana male</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Yesu pǝlǝa nying bu-nzali Taya, ara a Sidon, kya puro a kún nggeamùr Galili, aɓa bu-nzali Dekapolis. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Aɓea aɓwana yinǝi wi nǝ ɓeɓwa mǝnana mǝkir'ara na sǝ mǝtalasǝ-ɓunna na. À zǝmbi wi ɓǝ̀ tsǝk bu amur ɓwe ɓǝ̀ sonzǝi.<verse eid="MRK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33" />Yesu pusǝ ɓwe zak à purî ɓalǝ aɓwabundǝa, sǝ oasǝ amunabuì aɓa kir ɓwabure, pǝlǝa tau ntāra arǝ amunabuì sǝ tsǝki ɓwe a lasǝi. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Yesu pǝlǝa loasǝ mǝsǝì a kùli, tusǝ ɓālǝi nǝ mǝsǝswatǝr, sǝ na ama, <char style="wj">&lt;&lt;Efata!&gt;&gt;</char> Tǝri ama, <char style="wj">&lt;&lt;Mǝnnǎ!&gt;&gt;</char><verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Kara akir ɓwabure mǝnnǎ, sǝ tita okban. Talasǝi panzǝa, kǝ nacau pepe. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesu pǝlǝa ne ɓwabundǝa ama ɓǝà kǝa ne kǝɓwa ce ɗàng. Kǝla à tsǝkta aɓwana nǝ tsǝa, ama ɓǝà ar cê, à kutio aban bang cè. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Gìr nî pea wia ndali kǝ̀rkǝ́r, à camarǝ ɓǝsǝlǝki ce ama, &lt;&lt;Koya gìr mana kǝ pè ka mǝɓoarne na!&gt;&gt; À nyare à na ama, &lt;&lt;Nggearǝ amǝ kir'ara ka kǝ tsǝia à kǝ okban, sǝ amǝ talasǝɓunna ka, pea wia nacau!&gt;&gt;<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesu linǝ́ aɓwana á-ine</para>
  <para style="r">(<ref loc="MAT 15:32-39">Matiu 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Aɓalǝ amǝno yia apwari ka, ɓwabundǝa yi ram kǝ̀rkǝ́r. Girlina pa kàm à nǝ̀ li ɗang. Yesu pǝlǝa tunǝ alaggana male sǝ nea wia ama, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" /><char style="wj">&lt;&lt;Mǝsǝswatǝr mala ɓwapǝndǝa man bwalam kǝ̀rkǝ́r. À ndakani atàm nongŋo tàrú yalung, sǝ ko kǝgìr pà kàm à nǝ̀ li ɗang.</char> <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" /><char style="wj">Ɓǝ̀ ǝn tasǝtea ama ɓǝa o nǝ nzala ka, mǝsǝpǝndǝa nǝ̀ mea a njargula, acemǝnana aɓea aɓwana ateà ka a puro aban sauwa.&gt;&gt;</char><verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Alaggana male pǝlǝi wi ama, &lt;&lt;A ya ban a ɓabondo man sǝ sǝm nǝ̀ kum girlina mana nǝ̀ linǝ́ ɓwapǝndǝa man ngga?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesu ɗia ama, <char style="wj">&lt;&lt;Agbatali bǝredi shen a bu wun ɗe?&gt;&gt;</char></para>
  <para style="p" vid="MRK 8:5">À eare ama, &lt;&lt;Tongno-nong-ɓari.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Nda Yesu ne ɓwabundǝa ama ɓǝa dum nǝ do a nzali. Sǝ twal agbatali bǝredi mana tongno-nong-ɓari ka, oaso pakki Ɓakuli yàwá, sǝ ɓwanggia. Pea alaggana male ɓǝa gaki aɓwabundǝa, sǝ à gaki gbal. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />À ndanǝ amǝ nji a buia bǝti. Yesu pǝlǝa pak yàwá amúrià gbal, sǝ banggia wia ama ɓǝa gaki aɓwana.<verse eid="MRK 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 8:8" />Ɓwapǝndǝa lili, à ɗǝmbǝo. Anzǝm man ngga, alaggana male tàrki cili aɓwangina girlina mǝnana à ueo ka, à lùmsǝ azace mǝgulke tongno-nong-ɓari. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Aburana kǝla á-ine à nda aɓalǝ aɓwabundǝa aban nì. Pǝlǝa Yesu ne ɓwabundǝa ama ɓǝa mǝsǝe, ɓǝà o a là. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Lang tsǝ̀ngŋǝ̀nà aɓwana a ndà ka, yi eauwe a waru andǝ alaggana male, pǝlǝa à nyare a bu-nzali mala ban mǝnana à tunǝki ama Dalmanuta ka.<verse eid="MRK 8:10" /></para>
  <para style="s">Amǝ Farisi earce sǝn gir'lǝmdǝa</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Lang amǝ Farisi ongŋǝna ama Yesu yina ka, à yiu à yì tita makgìr andǝi. À nǝ̀ kārǝki ka, à ɗì ama ɓǝ̀ lǝmdǝia wia gir'lǝmdǝa nǝ ban Ɓakuli, mǝnana nǝ̀ lǝmdǝ rǝcandǝa male ka.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char>.</note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Pǝlǝa Yesu tusǝ ɓālǝi kpǝm aɓa bangŋo male, sǝ na ama, <char style="wj">&lt;&lt;Palang sǝ aɓwana mǝnana a nza man kǝ earce sǝn gir'lǝmdǝa mǝ'pa ndali? Ən nggǝ na wun mǝsǝcau, pa mǝ nǝ pe aɓwana mǝnana a nza man kǝ gir'lǝmdǝa ɗang.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref></char>.</note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Pǝlǝa ɗekia, eauwe a waru, nyare a kusǝì o a ɓè nkaring nggeamùr.<verse eid="MRK 8:13" /></para>
  <para style="s">Yis mala amǝ Farisi <optbreak /> andǝ mala Hirǝdus</para>
  <para style="r">(<ref loc="MAT 16:5-12">Matiu 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Alaggana ka ɓālǝia lorǝo à yiu nǝ girlina abuia ɗang, kǝ gbatali bǝredi mwashat na à ndanǝi aɓa waru ka. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Lang à ndarǝ o aɓa waru ka, Yesu nun kiria ama, <char style="wj">&lt;&lt;Wu parkir wun arǝ yis mala amǝ Farisi andǝ mala Hirǝdus.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:1">Luk 12:1</ref></char>.</note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />À tita naki ce arǝarǝia ama bang anggo acemǝnana à yinǝ bǝredi a buia raka.<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yesu sǝlǝna rǝ cau mǝnana à nakiyi ka, pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Palang sǝ wu kǝ naki acau arǝarǝ wun ama wu twal bǝredi a bu wun ɗang? Nggearǝ wun ngga, wu kǝ gandǝ súrǝ̀ gir ko wu bwalta gìr mbo? Ɓabum wun na più aɓa candǝe, kǝ gandǝ twal cau ɗang?</char> <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><char style="wj">Amǝsǝ wun andǝ akir wun girki le? Ɓalǝ wun kasǝ arǝ kǝ cau re?</char><note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 5:21">Ir 5:21</ref>; <ref loc="EZK 12:2">Ezǝk 12:2</ref>; <ref loc="MRK 4:12">Mar 4:12</ref></char>.</note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" /><char style="wj">Mǝnana ǝn linǝ́ aɓwana á-tongno nǝ agbatali bǝredi tongno ka, cili mǝnana ueo, wu tàrki ka, wu pwano arǝ azace shen ɗe?&gt;&gt;</char></para>
  <para style="p" vid="MRK 8:19">À ear ama, &lt;&lt;Lum nong-ɓari.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Yesu nyare ɗia ama, <char style="wj">&lt;&lt;Sǝ mǝnana ɗǝm ǝn linǝ́ aɓwana á-ine nǝ agbatali bǝredi tongno-nong-ɓari ka, cili mǝnana ueo, wu tàrki ka, wu pwan arǝ azace shen?&gt;&gt;</char> À eare ama, &lt;&lt;Tongno-nong-ɓari.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Ado ka wu súrǝ̀ gir mǝnana ǝn banggi cau amurí ka re?&gt;&gt;</char><verse eid="MRK 8:21" /></para>
  <para style="s">Yesu mǝnbi nte mǝsǝì a Beseda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />À yì bik Beseda. Aɓea aɓwana yiu nǝ ɓe nte. À yì zǝmbi Yesu ama ɓǝ̀ tsǝk buì arǝì, ɓǝ̀ mǝnbi wi mǝsǝì. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesu bwal nte a garabui pusǝì anzǝm la. Pǝlǝa tappî ntāra a mǝsǝì sǝ tsǝk buì a murí, sǝ ɗì ama, <char style="wj">&lt;&lt;A kǝ sǝn kǝgìr ado le?&gt;&gt;</char><verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Pǝlǝa nte man loasǝ múrí a kùli, na ama, &lt;&lt;E, ǝn nggǝ sǝn aɓwana, sǝ ǝn nggǝ sǝnia pepe ɗang. À nda kǝla anggun mǝnana à kǝ ging ngga.&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Yesu nyare tsǝk abui a mǝsǝ nte mǝno ɗǝm, kara amǝsǝì mǝn gamama, kǝ sǝnban gǝraɗau. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesu tasǝ te ama ɓǝ̀ o a la, ne wi ama, <char style="wj">&lt;&lt;Ce a kar nǝ ɓá mǝnia yì muna-là ka ɗàng, ɓǝ̀ awu nǝ o ka.&gt;&gt;</char><verse eid="MRK 8:26" /></para>
  <para style="s">Cau mana pur a kun Bitǝrus <optbreak /> amur Yesu ka</para>
  <para style="r">(<ref loc="MAT 16:18-20">Matiu 16:18-20</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yesu lo andǝ alaggana male à nying bu-nzali Galili, à o arǝ amuna-là tù nǝ ban nggea-là Kaisariya Filipi. Amur njar ka, Yesu ɗia ama <char style="wj">&lt;&lt;Aɓwana kǝ bang ama mǝ nda yana?&gt;&gt;</char><verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />À eari wi ama, &lt;&lt;Aɓea ɓwana kǝ na ama, a nda Yohana Mǝbatisǝma, aɓea ɓwana ka ama, a nda Iliya, sǝ aɓea ɓwana ka ama a nda ɓekǝ mǝɓangnǝa mala Ɓakuli.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 6:14">Mar 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>.</note><verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Sǝ wun ngga, wu na ama mǝ nda yana?&gt;&gt;</char></para>
  <para style="p" vid="MRK 8:29">Bitǝrus eare ama, &lt;&lt;A nda Kǝrǝsti, Mǝ'amsǝban.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 6:68">Yoh 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>.</note> <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Yesu nunkiria ama ɓǝa kǝa ne kǝɓwa cau amurí ɗang.<verse eid="MRK 8:30" /></para>
  <para style="s">Yesu nacau amur lú male</para>
  <para style="r">(<ref loc="MAT 16:21-28">Matiu 16:21-28</ref>; <ref loc="LUK 9:2-27">Luka 9:2-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Pǝlǝa tita banggia wia gìr mǝnana nǝ̀ kumi ka. Na ama, <char style="wj">&lt;&lt;Muna mala Ɓwa ka nǝ̀ nu tanni ɗàngɗáng. Aɓwana-mǝgule andǝ agbani pǝris, andǝ amalǝm Nggurcau mala Musa nǝ̀ ɓinǝ mǝsǝì, à nǝ̀ wal-luí. Sǝ a tàruià nongŋo ka, nǝ̀ lo nǝ yilǝmu.&gt;&gt;</char> <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Banggia wia mǝnia yì cau ka bwāng. Pǝlǝa Bitǝrus tunǝi a nkanggariban, gimbi arǝ cau mǝnana ne ka.<verse eid="MRK 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33" />Yesu pǝlǝ rǝi sǝn alaggana male, pǝlǝa sà arǝ Bitǝrus ama, <char style="wj">&lt;&lt;Gǝshi banam, we Shetan! Ɗenyicau mo ka mala Ɓakuli na ɗang, mala ɓwapǝndǝa na!&gt;&gt;</char><verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Pǝlǝa tunǝ ɓwabundǝa, andǝ alaggana male, nea wia ama:</para>
  <para style="pi" vid="MRK 8:34">
    <char style="wj">Ɓǝ̀ ɓwa twal ama nǝ̀ duk mǝkpatam ngga, dumǝna púp ɓwe nǝ̀ nying kpata agir mala ɓamúrì. Ɓwe nǝ̀ twal takusǝam aɓa gandǝrǝu mala nutanni andǝ lú ulang mem amur nggun-gangndǝi, sǝ nǝ̀ yiu atàm arǝ aban mǝnana kat mǝ nǝ ká akàm ngga.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:34 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref></char>.</note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><char style="wj">Acemǝnana ɓwa mana kǝ earce amsǝ yilǝmi ka, nǝ̀ ɗwanyibanì, sǝ ɓwa mǝnana turta yilǝmi acem andǝ ce Cau Amsǝban ngga, nǝ̀ kumi.</char><note caller="+" style="f"><char style="fr" closed="false">8:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref></char>.</note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" /><char style="wj">Mana nǝ̀ purî ɓwa yì mǝnana ɓǝ̀ kum girbunda mala ɓanza kat, sǝ turta yilǝmi ka?</char> <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" /><char style="wj">Mana gir nì na ɓwa na nǝi nǝ̀ pe Ɓakuli ace mǝnana ɓǝ̀ kum yilǝmu mǝnana málá male pà kàm raka?</char><verse eid="MRK 8:37" /></para>
  <para style="pi">
    <verse number="38" style="v" sid="MRK 8:38" />
    <char style="wj">Ɓwa mǝnana kat kǝsǝkya kǝ pakki wi arǝàm sǝ arǝ cau mem aɓa mǝnia yì ɓanza mǝ ɗwanyi do nǝ mǝsǝcau aban Ɓakuli, andǝ mǝnana lùmsǝ nǝ cauɓikea ka, mim Muna mala Ɓwa ka, kǝsǝkya nǝ̀ pàkkam gbal arǝì a pwari mǝnana mǝ nǝ nyar nǝi aɓa ɓoarɓwa mala Tárrám, andǝ amǝturonjar mǝfele male ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">8:38 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 9:26">Luk 9:26</ref>
      </char>.</note><verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesu lidǝmba nǝ nacau ama:</para>
  <para style="pi" vid="MRK 9:1">
    <char style="wj">Ɓafo, ǝn nggǝ bangga wun, aɓalǝ wun mǝnia wu cam ngga, aɓea aɓwana nakam mǝnana à pà nǝ̀ wu raka, she ɓǝa sǝna Domurǝm mala Ɓakuli yina nǝ rǝcandǝa ka.</char><verse eid="MRK 9:1" /></para>
  <para style="s">Nggurǝ Yesu nggaɗi</para>
  <para style="r">(<ref loc="MAT 17:1-13">Matiu 17:1-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Anzǝm nongŋo tongno-nong-mwashat ka, Yesu tunǝ Bitǝrus, sǝ Jemis, sǝ Yohana. Pǝlǝa um nǝia amur nkono mǝ'dāhre, nǝmurǝia. Akanó ka rǝ Yesu twalo nggaɗi àkǝ̀ ɓamǝsǝia.<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2PE 1:17">2Bit 1:17</ref>,<ref loc="2PE 1:18">18</ref></char>.</note> <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Anggubyau rǝì pwasǝ tyal-tyal mǝnana kǝɓwa pà kàm a ɓanza mǝnia ka nǝ̀ gandǝ lak gìr nǝ̀ fa anggo raka. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Kara Iliya, andǝ Musa, à pusǝrǝia à kǝ nacau nǝ Yesu.<figure style="fig" alt="Jesus transfigured." file="WA03858b.tif" size="col" loc="MRK 9:4" copy="Wadé Images" ref="9:4">Rǝ Yesu nggaɗi.</figure><verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Bitǝrus ne Yesu ama, &lt;&lt;Malǝm, yàwá, mǝnana ado sǝm ndakani ka. Sǝm nǝ̀ kar gumli tàrú, mwashat ka nda aceo, mwashat ka nda ace Musa, sǝ man mwashat ka nda ace Iliya.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Yì andǝ aɓi ka ɓangciu bwalia kǝ̀rkǝ́r, yàle súrǝ̀ gir mǝnana nakiyi cau amurí ka ɗang.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Pǝlǝa pǝrɓang puro yi gir múrià. Gi Ɓakuli pur nǝ ɓá pǝrɓang ama, &lt;&lt;Mǝnia ka nda Munem mǝnana ǝn earkiyi ace raka. Wu oki wi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char>.</note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />À nǝ̀ loasǝ mǝsǝia ka, ko à sǝn kǝɓwa ɗang, kǝ Yesu na nǝmurǝì.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />À nda aban sùlǝî mur nkono ka, Yesu nunkiria nea wia ama, <char style="wj">&lt;&lt;Wu kǝa ne kǝɓwa ce gìr mǝnana wu sǝn ngga ɗang, she ɓǝ̀ Muna mala Ɓwa longŋǝni ɓembe ka.&gt;&gt;</char> <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Pǝlǝa à bwal ce gbal àkǝ̀ rǝarǝia, à kutio amur naki acau amur, &lt;&lt;Loapi ɓembe ka ɓālǝi nda mana?&gt;&gt;<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Pǝlǝa à ɗì Yesu ama, &lt;&lt;Palang sǝ amalǝm Nggurcau mala Musa bang ama, Iliya nǝ̀ aki Kǝrǝsti dǝmba yiu?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 4:5">Mal 4:5</ref>; <ref loc="MAT 11:14">Mat 11:14</ref></char>.</note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesu earia wia ama, <char style="wj">&lt;&lt;E, Iliya nǝ̀ yiu a dǝmba, nǝ̀ yia gilǝki agir kat ɓǝà duk pepè. Sǝ Malǝmce ka, na gbal mbo ama, Muna mala Ɓwa ka nǝ̀ tanni kǝ̀rkǝ́r sǝ à nǝ̀ ɓinǝi?</char> <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" /><char style="wj">Sǝa ma ǝn nggǝ bangga wun, Iliya angŋǝna dǝmba yina, sǝ à pangŋǝni koya gìr mǝnana yia ka à earce ka, kǝla mǝnana à gilǝì amurí ka.&gt;&gt;</char><verse eid="MRK 9:13" /></para>
  <para style="s">Yesu pusǝ kukwar arǝ muna</para>
  <para style="r">(<ref loc="MAT 17:14-21">Matiu 17:14-21</ref>; <ref loc="LUK 9:37-49">Luka 9:37-49</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Lang à nyarǝna aban acili alaggana ka, à sǝn ɓwapǝndǝa kǝ̀rkǝ́r rambǝa a rǝia, sǝ aɓea amalǝm Nggurcau mala Musa na aban makgìr andǝia. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Lang ɓwabundǝa nǝ̀ sǝn Yesu ka, à ndali kǝ̀rkǝ́r, sǝ à swár a mire à yì makki wi kun. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesu ɗì ka laggana male ama, <char style="wj">&lt;&lt;Mana gir ni wu makkiyigìr wunǝia amurí?&gt;&gt;</char><verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Ɓè ɓwa aɓa ɓwabundǝa kasǝa ama, &lt;&lt;Malǝm, ǝn yiu nǝ munem a bano ace mǝnana wu twali ban rǝkwana ka. Ndanǝ kukwar arǝì, mǝnana kǝ eari wi nacau raka. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Ɓǝ̀ loarǝi ka, nǝ̀ me a nzali, ntāra nǝ̀ gupi a kúni, nǝ̀ nggǝ go minǝì, sǝ nǝ̀ shiuri kwanggong. Nda ǝn ne alaggana mo nǝma ɓǝa pusǝì sǝ à gandǝi ɗang.&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesu nea wia ama, <char style="wj">&lt;&lt;Wun amǝ ɗwanyi earnǝ Ɓakuli! Banem nǝ̀ sau lang atà wun sǝ wu nǝ̀ kani earnǝ cau? Banem nǝ̀ sau lang aban twal gandǝa nǝ wun? Wu yinǝàm nǝ munê!&gt;&gt;</char><verse eid="MRK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20" />À pǝlǝa à yiu nǝ muna. Lang kukwar nǝ̀ sǝn Yesu ka, kara kàr muna dǝkǝrǝki kǝ̀rkǝ́r, túrí a nzali. Muna camarǝ ɗǝnggǝliki, ntāra kǝ gupi a kúni.<verse eid="MRK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21" />Yesu ɗì tár muna ama, <char style="wj">&lt;&lt;Aya pwari sǝ mǝnia yì gìr ka tikì tè?&gt;&gt;</char></para>
  <para style="p" vid="MRK 9:21">Pǝlǝa eare ama, &lt;&lt;Tikì tè a muntulo. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />A ɓè pwari ka kǝ me a bǝsa ko a mùr, ama nǝ̀ wal-luí. Sǝa ma ɓǝ̀ a nǝ gandǝi ka, sǝn mǝsǝswatǝr ma'sǝm, bwala sǝm nggam!&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Yesu ɗì ama, <char style="wj">&lt;&lt;Ace mana sǝ a na ama, &lt;ɓǝ̀ a nǝ gandǝi ka?&gt; Ko man ngga nǝ̀ gandǝ pa a ban ɓwa mǝnana earnǝ cau mala Ɓakuli nǝ ɓabumi kat ka.&gt;&gt;</char><verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Tár muna ear nǝ rǝɓǝla ama, &lt;&lt;Ən earǝna ǝn pana ɓamúràm, bwalàm nggàm ɓǝ̀ ǝn limurǝm amur ɗwanyi paɓamuru mem!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Lang Yesu sǝn ɓwapǝndǝa nǝ̀ nggǝ kana aban yiu ka, kara sà arǝ kukwar ama, <char style="wj">&lt;&lt;We kukwar mala kir ara andǝ mala talasǝɓunna, ǝn nggǝ banggo nǝma, purrì rǝì, cea nyare a kútí kam ɗǝm ɗàng!&gt;&gt;</char><verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Kukwar mak'zwalo, pūrǝki muna wak, sǝ purî nyami. Muna nong kpoklyak, kǝla wu nǝ wú, gandǝa aɓea aɓwana bang ama, &lt;&lt;Wuna!&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Yesu bwali a garabui, loasǝi amur akusǝi, pǝlǝa lo came.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Anzǝm mana Yesu nyarǝna a ɓala ka, alaggana male ɗiì a sǝmbǝrǝa, ama, &lt;&lt;Palang sǝ sǝm gandǝ pusǝ mǝno yì kukwar ka ɗàng?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Yesu nea wia ama, <char style="wj">&lt;&lt;Ulang mǝnia yì kukwar ka, kǝ hiwi andǝ gilmùr nda nǝ̀ pusǝì ka.&gt;&gt;</char><verse eid="MRK 9:29" /></para>
  <para style="s">Yesu bangce lú male</para>
  <para style="r">(<ref loc="MAT 17:22-23">Matiu 17:22-23</ref>; <ref loc="LUK 9:43-45">Luka 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />À ɗeki ban mǝno à ara aɓa bu-nzali Galili. Yesu ear ama ɓǝ̀ kǝɓwa súrǝ̀ ban mǝnana à ndakam ngga ɗàng, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />acemǝnana nda aban kani alaggana male gìr. Nea wia ama, <char style="wj">&lt;&lt;Muna mala Ɓwa ka, à nǝ̀ kurakuro nǝi a ban aɓwana. À nǝ̀ wal-luí, sǝ a tàruià nongŋo ka nǝ̀ lo nǝ yilǝmu.&gt;&gt;</char> <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Sǝ ko à bwalta gìr mǝnana banggiyi ka ɗàng, sǝ ɓangciu pakkia wia ɓǝà ɗì amurí.<verse eid="MRK 9:32" /></para>
  <para style="s">Yana gulo kútìban kat?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Matiu 18:1-5</ref>; <ref loc="LUK 9:40-48">Luka 9:40-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Pǝlǝa à yiu a Kapanahum. Yi dumǝna a ɓala ka, Yesu ɗì ka laggana male ama, <char style="wj">&lt;&lt;Mana wu makkiyigìr amurí a tanjar aban yiu?&gt;&gt;</char> <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Pǝlǝa à do kunia ɗǝong, acemǝnana a njargula ka, à makgìr amur ko yana aɓalǝia nda ɓwamǝgule kat.<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 22:24">Luk 22:24</ref></char>.</note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Lang Yesu dumǝna nǝ do ka, pǝlǝa tunǝ alaggana male lum nong-ɓari, nea wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ ɓwa earce duk mǝdǝmba ka, dumǝna púp ɓwe nǝ̀ duk mǝ'nzǝ́mò, sǝ nǝ̀ duk guro mala aɓi kat.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">Mar 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char>.</note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Pǝlǝa loasǝ muna mǝkyauwe tamsǝi a ɓadǝmbia. Núnní a nkanggari rǝi, sǝ nea wia ama, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><char style="wj">&lt;&lt;Ɓwa mǝnana ak muna kǝla mǝnia aɓa lullǝam ngga, Mǝ nda akiyiam ngga. Sǝ ɓwa mǝnana em ngga, Mǝ nda akiyiam nǝmurǝam ngga ɗàng, nda ban ak Tárrám mǝnana tasǝam ngga.&gt;&gt;</char><verse eid="MRK 9:37" /></para>
  <para style="s">Ɓwa mǝnana ɓinǝ sǝm raka <optbreak /> nda atà sǝm</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luka 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohana ne wi ama, &lt;&lt;Malǝm, sǝm sǝn ɓè ɓwabura aban pusǝki akukwar aɓa lùllǝò, sǝ sǝm pǝrki, acemǝnana yì ka, pa aɓalǝ sǝm ɗang.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Yesu ne wi ama:</para>
  <para style="pi" vid="MRK 9:39">
    <char style="wj">Ce wu pǝrki ɗàng. Kǝɓwa pà kàm nǝ̀ pak gìr'ndali aɓa lullǝam, sǝ nyar tù nǝ̀ bang mǝɓane a muram ɗàng.</char> <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><char style="wj">Ɓwa mǝnana kat ɓinǝ ce sǝm raka, nda atà sǝm.</char><note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Luk 11:23</ref></char>.</note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><char style="wj">Ɓafo ǝn nggǝ bangga wun, ɓǝ̀ koyana sǝ pà wun mùr-nùná aɓa lullǝam, acemǝnana wu nda ka mala Kǝrǝsti ka, pà nǝ̀ ɗwanyi tangnakusǝi ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">9:41 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:42">Mat 10:42</ref></char>.</note><verse eid="MRK 9:41" /></para>
  <para style="s">Tsǝk ɓwa ɓǝ̀ pak cauɓikea</para>
  <para style="r">(<ref loc="MAT 18:9-10">Matiu 18:9-10</ref>; <ref loc="LUK 19:1-2">Luka 19:1-2</ref>)</para>
  <para style="pi">
    <verse number="42" style="v" sid="MRK 9:42" />
    <char style="wj">Ɓǝ̀ koyana sǝ tsǝk mwashat aɓalǝ amuna mǝnana à earnǝ mim, sǝ pàk cauɓikea ka, nǝ̀ ɓoaribani ɓǝà ɗurri wi nggea taligo a meali, sǝ ɓǝà túrí aɓa nggeamùr.</char> <verse eid="MRK 9:42" /><verse number="43-44" style="v" sid="MRK 9:43-44" /><note caller="+" style="f"><char style="fr" closed="false">9:43-44 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:30">Mat 5:30</ref></char>.</note><char style="wj">Ace mani ka, ɓǝ̀ buo kǝ cio a kǝ pak cauɓikea ka, kasǝi kpat. Nǝ̀ ɓoaribani wu kutio a yilǝmu mana málá male pà kàm raka nǝ bu mwashat, amur mana a nǝ dum nǝ abuo ɓari sǝ à nǝ̀ túrǒ aɓa lú-bǝsa, aban mǝnana bǝsa male kǝ limgi raka.</char><note caller="+" style="f"><char style="fr" closed="false">9:43-44 </char><char style="fq" closed="false">aban mǝnana bǝsa male kǝ limgi raka: </char><char style="ft" closed="false">Aɓea malǝmce mǝnana à gilǝì nǝ bu ka à tsǝa amurí ama, &lt;&lt;Aban mǝnana anggwaso male kǝ wu ɗang, sǝ bǝsa male kǝ limgi gbal raka.&gt;&gt;</char></note> <verse eid="MRK 9:43-44" /><verse number="45-46" style="v" sid="MRK 9:45-46" /><char style="wj">Ɓǝ̀ kusǝo nda kǝ cio a kǝ pak cauɓikea ka, kasǝi kpat. Nǝ̀ ɓoaribani wu kutio a yilǝmu mana málá male pà kàm raka nǝ kusǝu-kasǝa, amur mana a nǝ dum nǝ akusǝu ɓari sǝ à nǝ̀ túrǒ aɓa lú-bǝsa ka.</char><note caller="+" style="f"><char style="fr" closed="false">9:45-46 </char><char style="ft" closed="false">Aɓea malǝmce mǝnana à gilǝia nǝ bu ka à tsǝa amurí ama, &lt;&lt;Aban mǝnana nggwaso male pà nǝ̀ wu ɗang, sǝ bǝsa male pà nǝ̀ limgi gbal raka.&gt;&gt;</char></note><verse eid="MRK 9:45-46" /></para>
  <para style="mi">
    <verse number="47" style="v" sid="MRK 9:47" />
    <char style="wj">Sǝ ɓǝ̀ mǝsǝo nda kǝ cio a kǝ pak cauɓikea, pusǝì túrí! Nǝ̀ ɓoaribani wu kutio a domurǝm mala Ɓakuli nǝ mǝsǝu mwashat, amur mana a nǝ dum nǝ amǝsǝu ɓari sǝ à nǝ̀ túrǒ aɓa lú-bǝsa ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9:47 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 5:29">Mat 5:29</ref>
      </char>.</note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" /><char style="wj">Akanó ka &lt;&lt;nggwaso mana nǝ̀ nggǝ lia ka, pà nǝ̀ wu ɗàng, sǝ bǝsa mana nǝ̀ nggǝ pisǝkia ka, pà nǝ̀ limgi ɗang.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:48 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:24">Isha 66:24</ref></char>.</note><verse eid="MRK 9:48" /></para>
  <para style="pi">
    <verse number="49" style="v" sid="MRK 9:49" />
    <char style="wj">Koyan ngga nǝ bǝsa sǝ à nǝ̀ tsǝì nǝ̀ ɓoarnsari.</char><verse eid="MRK 9:49" /></para>
  <para style="pi">
    <verse number="50" style="v" sid="MRK 9:50" />
    <char style="wj">Tuɓamur ka ɓoaro, sǝ ɓǝ̀ cyauwe male purrínì wi ka, nǝ mana sǝ à nǝ̀ tsǝì nǝ̀ cyàu ɗǝm? Wu dum nǝ ɓealu kǝla tuɓamur arǝarǝ wun, wu dum nǝ dorǝpwala arǝarǝ wun.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9:50 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>.</note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Kànìgìr amur gau doɓala</para>
  <para style="r">(<ref loc="MAT 19:1-2">Matiu 19:1-2</ref>; <ref loc="LUK 16:8-20">Luka 16:8-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Yesu ɗeki Kapanahum, wari a bu-nzali Yahudi, a nkaring Mùr Jodan. Ɓwabunda yi ram ɗǝm a bani à kàrì aɓalǝu, pǝlǝa kania wia gìr kǝla mǝnana pàkkiyi ka.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Aɓea amǝ Farisi yiu à yì kārǝki nǝ ɗiban ama, &lt;&lt;Nggurcau eare ama ɓǝ̀ ɓwa ɓǝ̀ pǝr māmí le?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesu pǝlǝa earia wia nǝ ɗiban ama, <char style="wj">&lt;&lt;Mana ɗe Musa bang aɓa nggurcau amur gau-doɓala?&gt;&gt;</char><verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />À nyesǝi wi ama, &lt;&lt;Musa eare ama, ɓǝ̀ ɓwa ɓǝ̀ gilǝî ɓwama takada gau doɓala, sǝ ɓǝ̀ tasǝ takwari ɓǝ̀ o.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 24:1-4">Nggur 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref></char>.</note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesu nea wia ama, <char style="wj">&lt;&lt;Nda ace murcandǝa ma'wun sǝ Musa gilǝa wun mǝnia yì nggurcau ka.</char> <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" /><char style="wj">Sǝ mǝno ka nda njar mala Ɓakuli ɗang. A tita pusǝ ɓanza ka, &lt;Ɓakuli pusǝ ɓwapǝndǝa, ɓwabura andǝ ɓwama,&gt; kǝla mana Malǝmce na ka.</char><note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 1:27">Tite 1:27</ref>; <ref loc="GEN 5:1">5:1</ref>,<ref loc="GEN 5:2">2</ref></char>.</note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" /><char style="wj">&lt;Ace mani ka, ɓwabura nǝ̀ nying tárrí andǝ ngge, nǝ̀ yia lanzǝa arǝ māmí.</char><note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 2:24">Tite 2:24</ref></char>.</note> <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" /><char style="wj">Yia ɓari ka à dumǝna nggūrǝu mǝ'mwashati.&gt; À pa ɗǝm ɓari ɗàng, à nda mwashat.</char> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" /><char style="wj">Ace mani ka, gìr mǝnana Ɓakuli kpapi ka, ɓwa ɓǝ̀ kǝa gauwi ɗàng.&gt;&gt;</char><verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Lang à nyarǝna a ɓala ka, alaggana mala Yesu ɗì amur mǝnia yì cau ka. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ koyana sǝ pǝr māmí sǝ al ɓe ɓwama ka, nda rǝ pakki ɓwama mǝdǝmbe cauɓikea mala nongnǝban a nza nǝ doɓala nǝ ɓaria ɓwama.</char><note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref></char>.</note> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" /><char style="wj">Sǝ ɓǝ̀ ɓwama nda gbal nying burí, sǝ kya al ɓe ɓwabura ka, nda rǝ pak cauɓikea mala nongnǝban a nza nǝ doɓala.&gt;&gt;</char><verse eid="MRK 10:12" /></para>
  <para style="s">Yesu tsǝki amuna bu</para>
  <para style="r">(<ref loc="MAT 19:13-15">Matiu 19:13-15</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Aɓea ɓwana yiu nǝ amuna aban Yesu ɓǝ̀ tsǝkia bu, pǝlǝa alaggana male lo à sà a rǝia.<verse eid="MRK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 10:14" />Lang Yesu nǝ̀ sǝn mǝnia yì gìr ka, bumi lúllô arǝ alaggana male. Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Wu ɗekia amuna ɓǝa yiu abanam, wu kǝa pǝria ɗang. Acemǝnana domurǝm mala Ɓakuli ka, nda ace aɓwana mǝnana à nda kǝla amǝnia yia amuna ka.</char> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><char style="wj">Ən nggǝ bangga wun ɓafo, ɓwa mǝnana pà nǝ̀ ak domurǝm mala Ɓakuli kǝla muna mǝkyauwe raka, pà nǝ̀ kútí kam ɗàng.&gt;&gt;</char> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Pǝlǝa twal amuna a kikili, sǝ tsǝk buì a ɓamur koyan ateà ka, sǝ tsǝkia wia bu.<verse eid="MRK 10:16" /></para>
  <para style="s">Lagga mǝkume</para>
  <para style="r">(<ref loc="MAT 19:16-30">Matiu 19:16-30</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Lang Yesu longŋǝna nǝ̀ o ka, ɓeɓwa ɓangŋa atè kya kū`ndǝó a ɓadǝmbi, sǝ zǝmbi wi ama, &lt;&lt;Malǝm mǝɓoarne, mana gir ni mǝ nǝ pa sǝ mǝ nǝ kum yilǝmu mǝnana málá male pà kàm raka?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesu ɗì ama, <char style="wj">&lt;&lt;Palang sǝ a tunǝam ama Malǝm mǝɓoarne? Kǝɓwa pà kàm mǝɓoarne na ɗang, kǝ Ɓakuli na nǝmurǝì ɓǝ̀rɓǝ̀r.</char> <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" /><char style="wj">A súrǝ̀ anzongcau mǝnia ka: &lt;Kǝa wal-lú ɗang, kǝa pak cauɓikea nongnǝban a nza nǝ doɓala ɗang, kǝa iun'í ɗang, kǝa na nyir ɗang, kǝa ɓǝmbǝriban ɗang, gusǝlǝ tárró andǝ nggo.&gt; &gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12-16">Pur 20:12-16</ref>; <ref loc="DEU 5:16-20">Nggur 5:16-20</ref></char>.</note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Pǝlǝa ɓwabure na ama, &lt;&lt;Malǝm, yàle mǝ nda muna sǝ ǝn bwal amǝnia yì anzongcau ka.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesu sǝni sǝnban earcearǝu, pǝlǝa ne wi ama, <char style="wj">&lt;&lt;Gìr mwashat sǝ a ɗwanyi, o, kya mak girkuma mo kat, sǝ wu gakì amǝ'tǝ̀r boale, awu nǝ kum gǝna a kùli. Sǝ wu yiu wu yi kpatam.&gt;&gt;</char> <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Lang nǝ̀ ok mǝnia yì cau ka, nun nggúr a dǝmbǝi. Pǝlǝ rǝì o nǝ ɓabumkiɗikea, acemǝnana yì ka, ndanǝ kume kǝ̀rkǝ́r.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesu pǝlǝ rǝì sǝnban, pǝlǝa ne alaggana male ama, <char style="wj">&lt;&lt;Amǝkume ka, nǝ kwanbia wia sǝ à nǝ̀ kutio a domurǝm mala Ɓakuli!&gt;&gt;</char><verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Cau male pakki alaggana male ndali. Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Wun amuna, kutio a domurǝm mala Ɓakuli ka kwano na a gir nì ɗang fa!</char> <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" /><char style="wj">Kutio mala mǝkume aɓa domurǝm mala Ɓakuli ka kwano kútì kutio mala kalakadambi a tūli nlerǝman.&gt;&gt;</char><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Alaggana ndali kǝ̀rkǝ́r. À ɗiki rǝarǝia ama, &lt;&lt;Sǝ yana ado nǝ̀ au le?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesu sǝnia kyap-kyap, sǝ na ama, <char style="wj">&lt;&lt;Ɓǝ̀ mala ɓwapǝndǝa na ka, mǝ gandǝe pà kàm ɗang, sǝama pa anggo aban Ɓakuli ɗang. Aban Ɓakuli ka koman ngga nǝ̀ gandǝ pa.&gt;&gt;</char><verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Bitǝrus pǝlǝa kasǝi ama, &lt;&lt;Sǝni, sǝm ɗekina koyagir ka, sǝm yiu a kpato!&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesu pǝlǝi wi ama, <char style="wj">&lt;&lt;Ɓafo na, ǝn nggǝ na wun ngga, ɓǝ̀ ɓwa ɗeki ɓala, ko amǝ'eambi amuna-burana, andǝ amuna-mamǝna, ko nggè ko tárrí, ko amuna, ko aɓaban acem andǝ ce hamnǝ Cau Amsǝban ngga,</char> <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" /><char style="wj">nǝ̀ kum tangnakusǝi. A ɓanza mǝnia ka, nǝ̀ kum aɓala, amǝ'eambu aburana andǝ amamǝna, anggeau, amuna, andǝ aɓaban; amǝnana làkkì malea nǝ̀ ká kusǝ gbǝman mala amǝnana ɗekia ka. Nǝ̀ kumia atārǝia andǝ nutanni gbal. Sǝ a ɓanza mǝnana kǝ yiu ka nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char> <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><char style="wj">Aɓwana pas mǝnana à nda tyang-tyang ado ka, à nǝ̀ nggá būrǝcea, sǝ amǝnana à būrǝcea ado ka, à nǝ̀ nggá duk tyang-tyang.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">10:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Luk 13:30</ref></char>.</note><verse eid="MRK 10:31" /></para>
  <para style="s">Yesu nacau ɗǝm amur lú male</para>
  <para style="r">(<ref loc="MAT 20:17-19">Matiu 20:17-19</ref>; <ref loc="LUK 18:30-32">Luka 18:30-32</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />À nda aban o a Urǝshalima ka, Yesu ak dǝmba kǝ ká sǝ alaggana male na atè. Alaggana male ndali kǝ̀rkǝ́r, sǝ acili aɓwana mǝnana à kǝ yiu ateà ka ɓangciu pakkia wia, acemǝnana a Urǝshalima ka, aɓwana nda kam pas mǝnana à ɓinǝmǝsǝì ka. Pǝlǝa Yesu tunǝ alaggana male lum-nong-ɓari a giriban, sǝ banggia wia koyagir mǝnana nǝ̀ nggá kumi ka. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Nea wia ama, <char style="wj">&lt;&lt;Sǝm ndya sǝm kǝ eauwe aban o a Urǝshalima ka. Muna mala Ɓwa ka à nǝ̀ nggá kúrnà kúró nǝi, a ban agbani pǝris andǝ amǝkani Nggurcau mala Musa. À nǝ̀ kasǝi wi ɓashi lú, sǝ à nǝ̀ tasǝi a bu aɓwana mǝnana amǝ Yahudi na raka.</char> <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" /><char style="wj">Yia ka à nǝ̀ oali, à nǝ̀ tapî ntāra arǝì, à nǝ̀ koè, sǝ à nǝ̀ wal-luí. Sǝa ma anzǝm anongŋo tàrú ka nǝ̀ lo nǝ yilǝmu.&gt;&gt;</char><verse eid="MRK 10:34" /></para>
  <para style="s">Zǝmba mala Jemis andǝ Yohana</para>
  <para style="r">(<ref loc="MAT 20:20-28">Matiu 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />À nǝ̀ nggǝ ká a njar ka, Jemis andǝ Yohana, amuna-burana mala Zabadi, à yiu a baní tù à yì ne wi ama, &lt;&lt;Malǝm, sǝm nggǝ earce ama wu pakka sǝm gìr mǝnana sǝm nǝ̀ zǝmbo wu pak ka!&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Yesu pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Mana wu earkiyice mǝ pakka wun?&gt;&gt;</char><verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />À eari wi ama, &lt;&lt;Pwari mǝnana a nǝ do a buno-murǝm mǝɓoarɓwe mò ka, ɓǝ̀ mwashat atà sǝm ɓǝ̀ do a buo mǝlì, sǝ ɓeɓwa ɓǝ̀ do a buo mǝ'nggare aɓa ɓoarɓwa mò.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yesu earia wia ama, <char style="wj">&lt;&lt;Wu súrǝ̀ gir mǝnana wu zǝmgiyi ka ɗàng. Wun nǝ̀ gandǝ nu aɓa kwap mala tanni mǝnana málá mǝ nǝ nu kàm ngga, ko wun nǝ̀ gandǝ ak batisǝma mala walban lú kǝla mǝnana dumǝnam púp à nǝ̀ wal luem ngga le?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:50">Luk 12:50</ref></char>.</note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />À pǝlǝa à eare ama, &lt;&lt;Sǝm nǝ̀ gandǝi.&gt;&gt; Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓafo na wun nǝ̀ nu aɓa kwap mǝnana dupǝnam púp mǝ nǝ nu kàm ngga, sǝ à nǝ̀ pakka wun batisǝma mǝnana dumǝnam púp à nǝ̀ pakkam ngga.</char> <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" /><char style="wj">Sǝa ma, pa aɓa buam ɓǝ̀n tsǝk ɓwa ɓǝ̀ do atà buam mǝlì, ko a buam mǝ'nggare ka ɗàng. Ɓakuli gilǝki amǝno yì aban ngga ace aɓwana mǝnana tarkia ka.&gt;&gt;</char><verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Lang acilia alaggana mana lum nǝ̀ ok gìr mǝno Jemis andǝ Yohana alkite ka, bumia lúllô. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Pǝlǝa Yesu tunǝia à yì ramba, sǝ nea wia ama, <char style="wj">&lt;&lt;Kǝla mana wu sǝlǝ ka, aɓwana mǝnana à súrǝ̀ia ama à nda ka murǝma, ko à nda ka ɓwana-mǝgule a ɓanza man ngga, à kǝ lǝmdǝ rǝcandǝa amur aɓwana mana à nda aɓatea ka.</char> <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><char style="wj">Sǝa ma atà wun ngga, pà nǝ̀ pa anggo ɗàng. Ɓwa mǝnana kǝ earce nǝ̀ duk ɓwamǝgule atà wun ngga, dumǝna púp nǝ̀ duk rítǎu mala acilia.</char><note caller="+" style="f"><char style="fr" closed="false">10:43 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 22:25">Luk 22:25</ref>,<ref loc="LUK 22:26">26</ref></char>.</note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" /><char style="wj">Sǝ ɓwa mǝnana earce ama nǝ̀ duk mǝ dǝmba</char><note caller="+" style="f"><char style="fr" closed="false">10:44 </char><char style="fq" closed="false">mǝ dǝmba </char><char style="ft" closed="false">Ko &lt;&lt;gbani&gt;&gt;</char></note> <char style="wj">ka, dumǝna púp nǝ̀ duk guro mala aɓi kat.</char> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" /><char style="wj">Ko nggearǝ Muna mala Ɓwa ka yiu ace mǝnana nǝ̀ do sǝ ɓǝ̀ aɓwana pakki wi túró ka ɗàng. Yì ka, yiu ace mǝnana nǝ̀ pakki aɓwana túró, sǝ ɓǝ̀ pà yilǝmi ace amsǝ</char><note caller="+" style="f"><char style="fr" closed="false">10:45 </char><char style="fq" closed="false">amsǝ: </char><char style="ft" closed="false">Ko &lt;&lt;akmúr&gt;&gt;</char></note> <char style="wj">ɓwabundǝa pas.&gt;&gt;</char><verse eid="MRK 10:45" /></para>
  <para style="s">Nte Bartimawus kum sǝnban</para>
  <para style="r">(<ref loc="MAT 20:29-34">Matiu 20:29-34</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Yesu andǝ alaggana male yi bik Jeriko. Lang a nda aban purrì ɓá Jeriko ka, aɓwana pas kana ateà. Ɓè nte nda kam lùllǝì ama Bartimawus, muna mala Timawus, dumǝna a girǝi njargula aban zǝmgi agir. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Lang nǝ̀ ok ama Yesu Ɓwa Nazarat nda kǝ kútí ka, tita loasǝ gi kǝ na ama, &lt;&lt;Yesu, Mǝkà Dauda, sǝn mǝsǝswatǝr mem!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Aɓwana pas loarǝì, à pyau wi ɓǝ̀ pwalo. Kara nyare loasǝ gi kàm kpǝm ama, &lt;&lt;Mǝkà Dauda, sǝn mǝsǝswatǝr mem!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Lang Yesu oè ka, pǝlǝ rǝì sǝ came, na ama, <char style="wj">&lt;&lt;Wu tunǝì ɓǝ̀ yiu.&gt;&gt;</char> Pǝlǝa à tunǝì yì nte, à ne wi ama, &lt;&lt;Ɓǝ̀ banɓoaro, lo, nda kǝ tunǝo ka.&gt;&gt; <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Kara túr gìrkùmsǝo male anggo, lo pǝrpǝr yiu a ban Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesu ɗì ama, <char style="wj">&lt;&lt;Mana a earce ama mǝ pakko?&gt;&gt;</char> Nte man pǝlǝa ne wi ama, &lt;&lt;Malǝm, ǝn nggǝ earce sǝnban!&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesu ne wi ama, <char style="wj">&lt;&lt;Kyane, gūliarǝu mo arǝ Ɓakuli twalǝno ban rǝkwana.&gt;&gt;</char> Àkǝ̀ banì kara sǝnban, pǝlǝa kpata Yesu aban o a njargula.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Aɓwana gingsǝ Yesu nǝ <optbreak /> ɓwangsǝban a Urǝshalima</para>
  <para style="r">(<ref loc="MAT 21:1-11">Matiu 21:1-11</ref>; <ref loc="LUK 19:28-40">Luka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohana 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Lang Yesu andǝ alaggana male mala à nǝ̀ bik Urǝshalima ka, à yì bwal ban alá Betafaji andǝ Betani, amur Nkono mala anggun Olif. Yesu tasǝ ɓari aɓalǝ alaggana male, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />nea wia ama, <char style="wj">&lt;&lt;Wu kyane a muna-là mǝnana a dǝm wun ngga. Wun nǝ̀ kútí kam ani ka, wun nǝ̀ kum mǝdambǝriso mǝnana kǝɓwa malaká eau a nzǝmi raka. Wu panzǝi wu yiu nǝi kani.</char> <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" /><char style="wj">Ɓǝ̀ kǝɓwa ɗì wun ama palang sǝ wu kǝ panzǝi le ka, wu ne wi ama, &lt;Ɓwamǝgule ma'sǝm kǝ earce. Banì pà nǝ̀ sau ɗang nǝ̀ nyesǝi.&gt; &gt;&gt;</char><verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Pǝlǝa alaggana mǝnia ɓari ka à wario à kya kum mǝdambǝriso à kùrni a kun ɓala a girǝi njargula. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />À nda ban panzǝe ka, aɓea aɓwana mǝnana à ndakam aban came ka, à ɗiban ama, &lt;&lt;Mana wu pakkiyia, wu nda ban panzǝ mǝdambǝriso mǝna?&gt;&gt; <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Pǝlǝa à nyesǝia wia cau kǝla mǝnana Yesu nea wia ka. Pǝlǝa à nyinggia wia mǝdambǝriso, à um nǝi.<verse eid="MRK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 11:7" />Lang à yina nǝ mǝdambǝriso aban Yesu ka, à makki adaura malea a nzǝmi, pǝlǝa Yesu eauwe do amurí.<verse eid="MRK 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 11:8" />Aɓwana pas atà ɓwabundǝa sárǝ́ki adaura malea a tanjargula, sǝ aɓea ɓwana ka, malea ka ambú ka nggun nda à kasǝkya, à sarǝkia a tanjargula ka.<verse eid="MRK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 11:9" />Aɓwana mǝnana a ɓadǝm Yesu andǝ aɓwana mǝnana a nzǝmi aban ká ka, à loasǝ già ama,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Wu ɓwangsǝ Ɓakuli!</para>
  <para style="q1" vid="MRK 11:9">Tsǝkbu ɓǝ do amur ɓwa</para>
  <para style="q2" vid="MRK 11:9">mana kǝ yiu aɓa</para>
  <para style="q2" vid="MRK 11:9">lullǝ Mǝtalabangŋo ka!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 118:25">Ang 118:25</ref>,<ref loc="PSA 118:26">26</ref></char>.</note><verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Ɓǝ̀ tsǝkbu do amur domurǝm</para>
  <para style="q1" vid="MRK 11:10">mana kǝ yiu,</para>
  <para style="q2" vid="MRK 11:10">mala kà-sǝm Dauda ka!</para>
  <para style="q1" vid="MRK 11:10">Ɓwangsǝban a ban Ɓakuli</para>
  <para style="q2" vid="MRK 11:10">kano a kùli!&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Anggo sǝ Yesu kutio aɓa Urǝshalima, pǝlǝa wari aɓa Ndàmǝgule mala Ɓakuli. Loasǝ mǝsǝì sǝn koman ngga, sǝ acemǝnana pwari kutina ka, pǝlǝ kusǝì puro, o a Betani andǝ alaggana male mana lum nong-ɓari ka.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesu sú nggun vwari</para>
  <para style="r">(<ref loc="MAT 21:18-22">Matiu 21:18-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ban fa ka, à nying Betani à nyare a Urǝshalima. Yesu ka ok nzala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Lang nǝ̀ sǝn nggun vwari a ɓadǝmbi nǝ ambuí ka, kyangye aban ká a baní ama yakǝla nǝ̀ kum ɓǝle kàm. Yiu ka yi kum kǝgìr ɗàng, kǝ mbuí na nǝmurǝì, acemǝnana kunɓǝla mala vwari malaká karǝ ɗang. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Pǝlǝa Yesu ne nggunî ama, <char style="wj">&lt;&lt;Kǝ ɓwa pà nǝ̀ li ɓǝleo ɗǝm ɗàng!&gt;&gt;</char> Alaggana male ok mǝnia yì cau ne ka.<verse eid="MRK 11:14" /></para>
  <para style="s">Yesu pǝr aɓwana aɓa Ndàmǝgule</para>
  <para style="r">(<ref loc="MAT 21:12-17">Matiu 21:12-17</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:18-22">Yohana 2:18-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Anzǝm mana Yesu andǝ alaggana male yi bwalǝna Urǝshalima ka, pǝlǝa kutio aɓa Ndàmǝgule mala Ɓakuli, kara tita pǝr aɓwana mǝnana à kǝ kúrkúró andǝ makki agirkúró aɓa Ndàmǝgule ka. Ramgi ta atebǝl mala amǝ nggaɗi boalo andǝ abenci mala amǝ makki akutumurǝm. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Sǝ eare ɓǝ̀ kǝɓwa kútí nǝ girkúró aɓa Ndàmǝgule mala Ɓakuli ɗang. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Pǝlǝa tita kania wia gìr. Nea wia ama, <char style="wj">&lt;&lt;À gilǝ mbo a Malǝmce ama, &lt;Ɓala mem ngga, à nǝ̀ tunǝi ama ɓala hiwi ace aɓwana arǝ anzali kat,&gt; sǝ wu ngga, wu nyesǝi pǝlǝ npu mala amǝ'ɓǝmbǝriban!&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 56:7">Isha 56:7</ref>; <ref loc="JER 7:11">Ir 7:11</ref></char>.</note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Agbani pǝris andǝ amalǝm Nggurcau mala Musa ok mǝnia yì cau ka. Pǝlǝa à tita alta njar mǝnana à nǝ̀ wal-luí nǝi ka. Sǝ yia ka, ɓangciu kǝ pakkia wia arǝì, acemǝnana ɓwapǝndǝa kat ka ndali nǝ kanigir male.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Lang pwari kpana ka, Yesu andǝ alaggana male purrì ɓá nggea-là.<verse eid="MRK 11:19" /></para>
  <para style="s">Nggun vwari wuli</para>
  <para style="r">(<ref loc="MAT 21:20-22">Matiu 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Ban fana nǝ dǝmbari à nǝ̀ nggǝ kútí nǝ ban nggun vwari mǝnana Yesu suí ka, kara à sǝni ka imǝna, yi bwal a nlerǝe. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Ɓalǝ Bitǝrus kasǝa arǝ cau mǝnana Yesu banggi nggunî ka, pǝlǝa ne Yesu ama, &lt;&lt;Malǝm, sǝni! Nggun vwari mǝnana a suí ka imǝna!&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesu ear ama, <char style="wj">&lt;&lt;Wu pà ɓabum wun arǝ earnǝ Ɓakuli.</char> <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><char style="wj">Ən nggǝ bangga wun mǝsǝcau, koyana sǝ ne nkono man ama, &lt;Lo o, kya kpa aɓa nggeamùr&gt; sǝ ɓǝ̀ earnǝi a yilǝmi, sǝ ɓabumi tuti amur cau mǝnana bang ngga raka, cau mǝnana bang ngga nǝ̀ yia pa.</char><note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 13:2">1Kor 13:2</ref></char>.</note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" /><char style="wj">Ace mani ka ǝn nggǝ bangga wun, ɓǝ̀ mana wu zǝmba aɓa hiwi ka, wu ear ama wu kumǝni. Anggo ka sǝ nǝ̀ duk ma'wun.</char><verse eid="MRK 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 11:25" />
    <char style="wj">&lt;&lt;Ɓǝ̀ wu came aban pak hiwi, sǝ wu ndanǝ kǝgìr a bum wun arǝ kǝɓwa ka, wu twalbani, ace mǝnana Tár wun mǝnana a kùli ka ɓǝ̀ twala wun ban acauɓikea ma'wun.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:25 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 6:14">Mat 6:14</ref>,<ref loc="MAT 6:15">15</ref></char>.</note> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" /><char style="wj">Sǝ ɓǝ̀ wu twalbani raka, anggo sǝ Tár wun mǝnana a kùli ka, pà nǝ̀ twala wun ban acauɓikea ma'wun ɗàng.&gt;&gt;</char><verse eid="MRK 11:26" /></para>
  <para style="s">Ɗiban amur rǝcandǝa mala Yesu</para>
  <para style="r">(<ref loc="MAT 21:23-29">Matiu 21:23-29</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Sǝ à nyare à yiu ɗǝm a Urǝshalima. Lang Yesu nda aban gya aɓa Ndàmǝgule mala Ɓakuli ka, agbani pǝris andǝ amalǝm Nggurcau mala Musa, andǝ aɓwana-mǝgule yiu a baní. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />À yì ɗì ama, &lt;&lt;Nǝ́ ya rǝcandǝa nani sǝ a kǝ pakki amǝnia yì agir ka, sǝ yana mǝnana po rǝcandǝa mala pakkia ka?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesu eari wia ama, <char style="wj">&lt;&lt;Mǝ nǝ ɗì wun, ɗìban mwashat. Ɓǝ̀ wu bangŋǝ́nàm gìr mǝnana ǝn ɗî wun ngga, sǝ mǝ nǝ bangga wun rǝ ɓwa mǝnana pam mǝnia yì rǝcandǝa sǝ ǝn nggǝ pakki amǝnia yì agir ka.</char> <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" /><char style="wj">Wu banggàm, batisǝma mala Yohana ka, pur nǝ kuli le ko nǝ ban ɓwapǝndǝa?&gt;&gt;</char><verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />À pǝlǝki ce arǝarǝia ama, &lt;&lt;Ɓǝ̀ sǝm bang ama, pur nǝ kuli ka, nǝ̀ ɗì sǝm mana tsǝa sǝ sǝm ginǝ earnǝ Yohana. <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Sǝ pa sǝm nǝ̀ na gbal ama pur nǝ ban ɓwapǝndǝa ɗang.&gt;&gt; Ɓangciu pakkia wia arǝ bang anggo, acemǝnana koyan ngga twali ama Yohana ka mǝɓangnǝa mala Ɓakuli mǝɓafoe na. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Pǝlǝa à nyesǝî Yesu cau ama, &lt;&lt;Sǝm súrǝì ɗàng.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Yesu nea wia ama, <char style="wj">&lt;&lt;Mim gbal ka pà mǝ nǝ na wun rǝ ɓwa mǝnana pam mǝnia yì rǝcandǝa ǝn nggǝ pakkina agir nǝi ka ɗàng.&gt;&gt;</char><verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Kanicau arǝ amǝ'rya mǝɓealɓike</para>
  <para style="r">(<ref loc="MAT 21:33-46">Matiu 21:33-46</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesu tita kania wia gìr nǝ kanicau ama:</para>
  <para style="pi" vid="MRK 12:1">
    <char style="wj">Ɓè ɓwa tsǝk ɓaban nggun anap. Kàrì nǝ nkāndan, sǝ tǝm tūli aɓa tali ace kambǝ mur ɓǝlanggun anap. Ɓak ban mǝ'dāhre mǝnana à nǝ̀ nggǝ cam amurí aban yál ɓaban ngga. Pǝlǝa nyesǝ ɓaban nì pana haya nǝi a bu amǝ'rya, sǝ kutio o a bǝri a ɓe nzali.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 5:1">Isha 5:1</ref>,<ref loc="ISA 5:2">2</ref></char>.</note><verse eid="MRK 12:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="MRK 12:2" />
    <char style="wj">Kunɓǝla mala anap karna ka, pǝlǝa tasǝ ɓe mǝtúró ɓala male aban amǝ'rya ɓǝa kya aki wi ɓǝla anap a ɓaban.</char> <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" /><char style="wj">Sǝ amǝ'rya bwal mǝtúró ɓala man, à walki, sǝ a tasǝ takwari o nǝ ɓabui.</char><verse eid="MRK 12:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="MRK 12:4" />
    <char style="wj">Nyare mǝtala ɓaban tasǝ ɓe mǝtúró ɓala abania. À yì wali à tsǝki wi penye a ɓamúrí, à pe wi kǝsǝkya kǝ̀rkǝ́r.</char> <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" /><char style="wj">Nyar ɗǝm tù tasǝ ɓe mǝtúró ɓala. Mǝnia ka à yì wal-luí. Pǝlǝa tasǝ aɓea amǝtúró ɓala pas, aman ngga à kwea, acilia ka à wal-luia.</char><verse eid="MRK 12:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="MRK 12:6" />
    <char style="wj">Kǝ ɓwa mwashat mǝnana ueo mǝtala ɓaban nǝ̀ túr ka, muna male mana earkiyi ace raka nda. Túrí a nggea tankwang kat, ne ɓamúrì ama, &lt;&lt;À nǝ̀ pè munem gulo.&gt;&gt;</char> <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" /><char style="wj">Kara amǝ'rya ne a rǝia ama, &lt;&lt;Muna mala mǝtala ɓaban, mǝnana nǝ̀ liɓala ka nda man. Wu ɗeki ɓǝ̀ yiu, sǝm nǝ̀ yia wal-luí, sǝ mǝnia yì ɓaban ngga nǝ̀ duk ma'sǝm!&gt;&gt;</char> <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" /><char style="wj">Pǝlǝa à bwali à wali wú, à twali à túrí anzǝm ɓaban.</char><verse eid="MRK 12:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MRK 12:9" />
    <char style="wj">Sǝ mana ado mǝtala ɓaban nǝ̀ pa? Nǝ̀ yiu nǝ̀ yia wal-lú ka amǝ'rya mǝno ka, sǝ nǝ̀ nyesǝ ɓaban nǝ̀ pea aɓea aɓwana.</char> <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" /><char style="wj">Wun ngga wu ɓal mǝnia yì ban ngga mbo aɓa Malǝmce, mǝnana ama:</char></para>
  <para style="q1" vid="MRK 12:10">
    <char style="wj">&lt;&lt;Tali mǝnana amǝɓa ɓinǝi ka,</char></para>
  <para style="q2" vid="MRK 12:10">
    <char style="wj">nda ɗǝm yi bwal kusǝɓa</char></para>
  <para style="q2" vid="MRK 12:10">
    <char style="wj">kàngkàng ngga.</char><verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />
    <char style="wj">Mǝnia yì gìr ka</char></para>
  <para style="q2" vid="MRK 12:11">
    <char style="wj">Mǝtalabangŋo na pe ka,</char></para>
  <para style="q2" vid="MRK 12:11">
    <char style="wj">sǝ gìr ndali na aban sǝm?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:11 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 118:22">Ang 118:22</ref>,<ref loc="PSA 118:23">23</ref></char>.</note>&gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Pǝlǝa aɓwana-mǝgule mala amǝ Yahudi alta njargula mǝnana à nǝ̀ bwali nǝi ka, acemǝnana à sǝlǝna ama bang mǝnia yì kanicau ka a rǝia. Sǝa ma acemǝnana àkǝ̀ ɓanggi ɓwabundǝa ka, à ɗeki à pǝlǝ rǝia, à o.<verse eid="MRK 12:12" /></para>
  <para style="s">Mbwe boalo-cemi aban Kaisar</para>
  <para style="r">(<ref loc="MAT 22:15-22">Matiu 22:15-22</ref>; <ref loc="LUK 20:20-25">Luka 20:20-25</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Anzǝm man ngga, à tasǝî Yesu aɓea amǝ Farisi andǝ aɓwana mala Hirǝdus ace mǝnana ɓǝà bwali aɓa nacau male ka. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />À yiu a baní à yì na ama, &lt;&lt;Malǝm, sǝm sǝlǝna ama we ka a kǝ came amur mǝsǝcau. Kǝɓwa pà kàm nǝ̀ púrǝǒ atà buì male ka ɗàng, acemǝnana ɓwapǝndǝa kat a bano ka à twalia à nda mwashat. A kǝ kani njargula mala Ɓakuli nǝ mǝsǝcau. Sǝm nggǝ earce wu bangga sǝm; nggurcau eare ama ɓǝ̀ sǝm mbwe boalo-cemi a ban Kaisar, yì murǝm mǝgule mala amǝ Roma le, ko pà a njarì ɗang? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ɓǝ̀ sǝm mbwe le ko ɓǝ̀ sǝm ngga mbwe ɗàng?&gt;&gt;</para>
  <para style="p" vid="MRK 12:15">Yesu ka sǝlǝna kutan malea, pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Palang sǝ wu kǝ earce tambam? Wu yinǝàm nǝ mǝsǝboalo ma'wun mǝ sǝni!&gt;&gt;</char><verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />À pǝlǝa à yinǝi wi nǝ mǝsǝboalo, sǝ ɗia ama, <char style="wj">&lt;&lt;Foto ɓamǝsǝ yana mǝnia, sǝ parbu mala yana mana amurí ka?&gt;&gt;</char> À eari wi ama, &lt;&lt;Mala Kaisar na.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Wu pe Kaisar gìr mǝnana mala Kaisar na ka, sǝ wu pe Ɓakuli gir mǝnana mala Ɓakuli na ka.&gt;&gt;</char></para>
  <para style="p" vid="MRK 12:17">Kara yia ka à ndali kǝ̀rkǝ́r nǝ nyesǝcau male.<verse eid="MRK 12:17" /></para>
  <para style="s">Ɗiban amur doɓala andǝ <optbreak /> loapi ɓembe nǝ yilǝmu</para>
  <para style="r">(<ref loc="MAT 22:23-33">Matiu 22:23-33</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Pǝlǝa amǝ Saduki, mǝnana à bang ama loapi ɓembe pa kàm raka, à yiu a baní nǝ ɗiban.<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 23:8">Atúró 23:8</ref></char>.</note> <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />À na ama, &lt;&lt;Malǝm, Musa gilǝa sǝm ama ɓǝ̀ mǝ'eam ɓwa wu sǝ ɗeki māmí amuna pa a buì raka, ɓwa mǝno ka dupi wi púp ɓǝ̀ twal mālá lú, ɓǝ̀ ɓǝli mǝ'eambi amuna.<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 25:5">Nggur 25:5</ref>,<ref loc="DEU 25:6">6</ref></char>.</note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Aɓea amǝ'eambu nakam tongno-nong-ɓari. Mǝdǝmbe al ɓwama, sǝ wu, ɗeki kǝ muna ɗang. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ɓwa mǝnana kpa nzǝmi ka twal mālá lú, a do andǝ yi. Yì gbal ka yi wú, ɗeki kǝ muna ɗang. Anggo gbal nǝ tàruià. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Yi mal múrià kat, yia mǝnia tongno-nong-ɓari ka, ko kǝɓwa kum muna ɗang. A masǝlǝate ka ɓwame yi wu gbal. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Ado ka, à pwari mǝnana aɓwana nǝ̀ loapi ɓembe nǝi ka, ɓwame ka nǝ̀ duk mālá yana aɓalǝia, yi mǝnana yia kat à dum nǝi ka?&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesu earia wia ama:</para>
  <para style="pi" vid="MRK 12:24">
    <char style="wj">Ɓwarkio ma'wun ngga nda mǝnana ama wu súrǝ̀ Malǝmce andǝ rǝcandǝa mala Ɓakuli ɗang.</char> <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" /><char style="wj">A pwari lo mala alú a ɓembe ka, alban pà kàm ɗàng. Aɓwana nǝ̀ do kǝla amǝturonjar a kùli.</char> <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" /><char style="wj">Sǝ amur cau mala lo mala alú ka, wu ɓal mbo aɓa malǝmce mala Musa, amur mǝ'nkwarki mǝnana kǝ earki bǝsa ka? Nda anzǝm mǝnana a Ibǝrayim andǝ Ishaku andǝ Yakupu wukina, sǝ apǝlǝkia pas yi kutikina ka, sǝ Ɓakuli yi bangcau nǝ Musa ama, &lt;&lt;Mǝ nda Ɓakuli mala Ibǝrayim, andǝ Ɓakuli mala Ishaku, andǝ Ɓakuli mala Yakupu.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:6">Pur 3:6</ref></char>.</note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" /><char style="wj">Mǝnia ka lǝmdǝ ama yì ka, Ɓakuli mala alú na ɗang; mala aɓwana mǝnana nǝ yilǝmu ka nda. Wun ngga, wu ɓwarki kǝ̀rkǝ́r!</char><verse eid="MRK 12:27" /></para>
  <para style="s">Nzongcau mǝgule kat</para>
  <para style="r">(<ref loc="MAT 22:34-40">Matiu 22:34-40</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />
    <note caller="+" style="f">
      <char style="fr" closed="false">12:28 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 10:25-28">Luk 10:25-28</ref>
      </char>.</note>Ɓè malǝm Nggurcau mala Musa nda aban came a banì kǝ ok cau mǝno amǝ Saduki kǝ makgìr amurí andǝ Yesu ka. Lang sǝni Yesu nyesǝnia wia cau pepe ka, pǝlǝa ɗì Yesu ama, &lt;&lt;Aɓalǝ anzongcau kat ka, mǝyenani nda kútì aɓea kat?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesu eare ama, <char style="wj">&lt;&lt;Mǝgule mǝnana kútìban kat ka nda mǝnia ka: &lt;Wu kwaki kir wun, wun amǝ Isǝrayila, Mǝtalabangŋo Ɓakuli ma'sǝm ngga, nda mwashat.</char> <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" /><char style="wj">Earce Mǝtalabangŋo Ɓakuli mo nǝ ɓabumo kat, andǝ yilǝmo kat, andǝ ɗenyicau mo kat, andǝ rǝcandǝa mo kat.&gt;</char><note caller="+" style="f"><char style="fr" closed="false">12:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 6:4">Nggur 6:4</ref>,<ref loc="DEU 6:5">5</ref></char>.</note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" /><char style="wj">Ɓaria nda mǝnia: &lt;Earce ɓio mǝ'murkala kǝla mǝnana a earce ɓamuro ka.&gt; Kǝ ɓè nzongcau pà kàm kútì amǝnia ka ɗàng.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">12:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:18">Pǝris 19:18</ref></char>.</note><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Malǝm Nggurcau mala Musa eari Yesu ama, &lt;&lt;Kǝ ndo a bangŋi ka, Malǝm! A ɓwarki ɗang, yi mana a na ama, Ɓakuli ka nda mwashat, kǝ ɓe pà kàm ɗang. Kǝ Yì na nǝmurǝì.<note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:35">Nggur 4:35</ref>,<ref loc="DEU 4:36">36</ref></char>.</note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Ɓǝ̀ ǝn earce nǝ ɓabumam kat, nǝ sǝlǝe mem kat, nǝ rǝcandǝa mem kat, sǝ ɓǝ̀ ǝn earce ɓiam mǝ'murkala kǝla mǝnana ǝn earce ɓamúràm ngga. Mǝnia ka kǝ pwasǝbum Ɓakuli kútì apagir mala pisǝe kǝring andǝ pāki agir'nkila kat.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 6:6">Hos 6:6</ref></char>.</note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Lang Yesu sǝni ɓwabure nyesǝna cau aɓa sǝlǝe ka, pǝlǝa ne wi ama, <char style="wj">&lt;&lt;We ka, a pa kuko nǝ ban domurǝm mala Ɓakuli ɗang.&gt;&gt;</char></para>
  <para style="p" vid="MRK 12:34">Anzǝm mǝno ka, kǝɓwa nyare ɗì ɓekǝ cau ɗang.<verse eid="MRK 12:34" /></para>
  <para style="s">Yesu Kǝrǝsti ka muna mala yana?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Matiu 22:41-46</ref>; <ref loc="LUK 20:41-44">Luka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Lang Yesu na aban kanigir a Ndàmǝgule mala Ɓakuli ka, ɗiban ama, <char style="wj">&lt;&lt;Palang sǝ amalǝm Nggurcau mala Musa kǝ bang ama Kǝrǝsti ka muna mala Dauda</char><note caller="+" style="f"><char style="fr" closed="false">12:35 </char><char style="fq" closed="false">muna mala Dauda: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkà Dauda.&gt;&gt;</char></note> <char style="wj">na?</char> <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" /><char style="wj">Dauda nǝ nggearǝì ka, nacau aɓa Bangŋo Mǝfele ama:</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">&lt;&lt;Mǝtalabangŋo ne </char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">Mǝtalem ama,</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">&lt;Do a buno gulo,</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">atà buam mǝlì</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">she ɓǝ̀ ǝn nyesǝna aɓio-mǝbura </char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">a ɓakusǝo ka.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:36 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 110:1">Ang 110:1</ref>
      </char>.</note><verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />
    <char style="wj">Yi mǝnana Dauda nǝ ɓamúrì tunǝ Kǝrǝsti ama, &lt;Mǝtalem&gt; ngga, lang sǝ Kǝrǝsti nǝ̀ duk muni?&gt;&gt;</char></para>
  <para style="p" vid="MRK 12:37">Ɓwabunda kwaki kiria arǝì nǝ banɓoarnado.<verse eid="MRK 12:37" /></para>
  <para style="s">Yesu pusǝta amǝkani <optbreak /> Nggurcau mala Musa</para>
  <para style="r">(<ref loc="MAT 23:1-36">Matiu 23:1-36</ref>; <ref loc="LUK 11:37-54">Luka 11:37-54</ref>; <ref loc="LUK 20:45-47">Luka 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Yesu aɓa kanigir male ka, nea wia ama:</para>
  <para style="pi" vid="MRK 12:38">
    <char style="wj">Wu parkir wun arǝ amǝkani Nggurcau mala Musa! Acemǝnana yia ka, à earce gya aɓalǝ anggea daura aban ak makkun aɓa limo.</char> <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" /><char style="wj">Yia ka, à kǝ earce ban-do mǝɓoarne aɓalǝ andakpapi andǝ aban-pakkiɗire.</char> <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" /><char style="wj">Yia nda à kǝ ɓǝmbǝri amā-lú arǝ agirkuma malea, sǝ à nǝ̀ ɓosǝki aɓwana nǝ pakki ahiwi mǝsauwe mala lǝmdǝ ɓamuria ama yia ka amǝ fele na. Ace mǝno ka ɓashi malea nǝ̀ gul kǝ̀rkǝ́r.</char><verse eid="MRK 12:40" /></para>
  <para style="s">Pa ɓoro mala ɓe mā-lú</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luka 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesu na aɓa Ndàmǝgule mala Ɓakuli, do nǝ ban mana à kǝ turki boalo kam ngga. Mǝsǝì ueo arǝ ɓwapǝndǝa mǝnana kǝ turki boalo aɓa kwar ak boalo ka. Amǝkume pas turki aboalo kpǝm. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Ɓè mǝ'tǝ̀r mā-lú yiu yi tsǝk anini ɓari, mǝnana bwalta kwapo mwashat raka. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Yesu tunǝ alaggana male a baní, sǝ nea wia ama, <char style="wj">&lt;&lt;Ən nggǝ na wun ɓafo, mǝnia yì mā-lú mǝ'tǝ̀r man ngga, nda túr gìr mana kútìban kat aɓa kwar ak boalo ka.</char> <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" /><char style="wj">Acemǝnana acili aɓwana kat ka, à tù nǝ tú aɓa kume malea, sǝ yì ka, kǝgìr mana ueo nǝ̀ linali nǝi ka, nda yi túrí kat ka.&gt;&gt;</char><verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Agir-ndali mala masǝlǝata <optbreak /> doɓanza andǝ tanni</para>
  <para style="r">(<ref loc="MAT 24:1-14">Matiu 24:1-14</ref>; <ref loc="LUK 21:5-19">Luka 21:5-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Lang Yesu na aban purrì ɓá Ndàmǝgule mala Ɓakuli ka, ɓeɓwa atà alaggana male ne wi ama, &lt;&lt;Malǝm, sǝn sǝlǝcame andǝ gulo mala ɓah mǝnia! Sǝn ɓoarjam mala anggea tali mǝnana à ɓe nǝi ka!&gt;&gt;<figure style="fig" alt="The Temple in Jesus's time." file="lb00250c.tif" size="col" loc="MAR 13:1" copy="Horace Knowles" ref="13:1">Ndàmǝgule mala Ɓakuli a nza mala Yesu.</figure><verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesu ear ama, <char style="wj">&lt;&lt;Wu sǝn aɓah mǝgulke mǝnia ka re? À nǝ̀ yia arkia kat à nǝ̀ sukkia a nzali. Kǝ ɓe tali pà kàm mǝnana nǝ̀ nongŋo amur ɓi ka ɗang!&gt;&gt;</char><verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Nǝ nzǝ́mò , lang Yesu dumǝna amur Nkono Olif, mǝnana ɓangŋaban na gau nrea andǝ Ndàmǝgule mala Ɓakuli ka, Bitǝrus, andǝ Jemis, andǝ Yohana, sǝ Andǝru, à yiu a baní nǝmurǝì sǝ à ɗì cau. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />À na ama, &lt;&lt;Bangga sǝm, aya pwari sǝ amǝnia yì agir ka à nǝ̀ pa? Sǝ mana nda gir'lǝmdǝa ama amǝnia yia agir kat ka à malá à nǝ̀ lùmsǝo?&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesu nea wia ama:</para>
  <para style="pi" vid="MRK 13:5">
    <char style="wj">Wu tsǝkir wun ɓǝ̀ kǝɓwa ɓǝ̀ kǝa ɓosǝki wun ɗàng.</char> <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" /><char style="wj">Aɓwana pas nǝ̀ yiu à nǝ̀ nggǝ bang ama, &lt;&lt;Mǝ nda Kǝrǝsti.&gt;&gt; À nǝ̀ pak túró nǝ lullǝam à nǝ̀ ɓosǝki aɓwana pas.</char><verse eid="MRK 13:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="MRK 13:7" />
    <char style="wj">Ɓǝ̀ wu ok ce a'lwa ko na'ongŋale amur cau mala a'lwa ka, ɓǝ̀ ɓalǝ wun ɓǝ̀ kǝa kasǝki ɗang. Amǝnia yì agir ka dumǝna púp à nǝ̀ pa, sǝ masǝlǝata ɓanza ka nda peatu, nǝ̀ yiu.</char> <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" /><char style="wj">Ɓè kun nǝ̀ lo nǝ lwa arǝ ɓe kun, sǝ nzalimurǝm nǝ̀ lo nǝ lwa arǝ ɓe nzalimurǝm. Dǝurǝo mala nzali nǝ̀ pa arǝ aban ɗàngɗáng aɓa ɓanza, sǝ nzala gbal ka nǝ̀ kpa. Sǝa ma, amǝnia ka tita gìr'mur'mwana na peatu.</char><verse eid="MRK 13:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MRK 13:9" />
    <char style="wj">Wu do nǝ yál ɓamur rǝ wun! À nǝ̀ oasǝki mur wun aban amǝ ɓashi, à nǝ̀ kwak wun arǝ andakpapi. Sǝ acemǝnana wu nda ka amǝ kpatam ngga, à nǝ̀ kánǝ wun a ɓashi a ɓadǝmba anggwamna andǝ amurǝma. Aɓa mǝno anggo ka wun nǝ̀ kùmô wun nǝ̀ duk amǝ'nakunam abania.</char> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" /><char style="wj">Sǝ Cau Amsǝban ngga, nda gìr mana dumǝna púp à nǝ̀ hamnǝi atadǝmbe arǝ anzali kat ka.</char><verse eid="MRK 13:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MRK 13:11" />
    <char style="wj">Sǝ ɓǝà bwal wun, à warinǝ wun aɓa ɓashi ka, ɓǝ̀ ɓalǝ wun ɓǝ̀ kǝa akdǝmba kasǝkya arǝ cau mǝnana wun nǝ̀ na ka ɗàng. Kǝ cau mǝnana à nǝ̀ pa wun a ɓabum wun àkǝ̀ banì ka, nda wun nǝ̀ na ka. Acemǝnana wun nda wun nǝ̀ na ce ka ɗàng, Bangŋo Mǝfele na.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:11 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 10:17-20">Mat 10:17-20</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>.</note><verse eid="MRK 13:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="MRK 13:12" />
    <char style="wj">Mǝ'eambǝu nǝ̀ pà mǝ'eambi ɓǝa wal-luí. Tárrú nǝ̀ pà muni. Amuna nǝ̀ lo arǝ atárrià andǝ anggea à nǝ̀ tsǝa ɓǝà wal-luia mak.</char> <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><char style="wj">Ɓwapǝndǝa kat nǝ̀ ɓinǝmǝsǝ wun acemǝnana wu nda ka amǝ kpatam ngga, sǝ ɓwa mana shak minǝì kàngkàng, aɓa gūlì arǝàm aban ká a masǝlǝate ka, ɓwe nǝ̀ àwá.</char><note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:22">Mat 10:22</ref></char>.</note><verse eid="MRK 13:13" /></para>
  <para style="s">Nggea tanni mǝgule</para>
  <para style="r">(<ref loc="MAT 24:15-18">Matiu 24:15-18</ref>; <ref loc="LUK 21:20-24">Luka 21:20-24</ref>)</para>
  <para style="pi">
    <verse number="14" style="v" sid="MRK 13:14" />
    <char style="wj">A pwari mǝno ka ɓǝ̀ wu sǝna &lt;&lt;yì gìr mɓeami mǝnana nǝ̀ yiu nǝ pǝndǝkea mala Ndàperi, sǝ nǝ̀ tsǝa aɓwana nǝ̀ ginǝki kutio kam,&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char>.</note> <char style="wj">yi kutina camǝna aban mǝfele, ban mana ɓoaro ɓǝ̀ came abanì raka, mǝ ɓalgìr ka ɓǝ̀ sǝlǝa! Aɓwana mana à do a nzali Yahudi ka, ɓǝà ɓangŋa ɓǝà o amur ankono.</char> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><char style="wj">Ɓwa mǝnana amur kurǝm male ka, ɓǝ̀ sulǝ ka, ɓǝ̀ kǝa na ama nǝ̀ kútí a ɓala nǝ̀ twal kǝgìr sǝ nǝ̀ ɓang ɗàng.</char> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" /><char style="wj">Ɓwa mǝnana nda a ɓabondo ka, ɓǝ̀ kǝa nyare ama nǝ̀ twal nggea-daura male ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">13:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 17:31">Luk 17:31</ref></char>.</note> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" /><char style="wj">Caukwanban na, aɓalǝ anonggio mǝno, nǝ amamǝna mana nǝ amuna a bumia andǝ amǝnana nǝ amuna a kun kiura ka!</char> <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" /><char style="wj">Wu pak hiwi ama amǝnia yia agir ka ɓǝà kǝa pak nǝ kún mbulo ɗang.</char> <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" /><char style="wj">Acemǝnana amǝno yia anongge ka, a mala tanni na kǝ̀rkǝ́r, mǝnana ulangni pà kàm àkǝ̀ bàkú raka, twalo a shareta ɓanza mǝnana Ɓakuli pusǝna ɓanza ka, yi bwal ado mǝno ka, sǝ à pà nǝ̀ kum ulangni gbal a dǝmba ɗàng.</char> <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" /><char style="wj">Ɓǝ̀ Mǝtalabangŋo kasǝ ma acilia nonggeo mǝno raka, kǝɓwa pà kàm nǝ̀ au ɗàng. Sǝ ace aɓwana male mǝnana tarkia nǝ nggearǝì ka, amsǝna acili anongge.</char><verse eid="MRK 13:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="MRK 13:21" />
    <char style="wj">Aɓalǝ amǝno yia apwari ka, ɓǝ̀ ɓwa bangga wun ama, &lt;&lt;Wu sǝni, Kǝrǝsti ndya ka!&gt;&gt; Ko, &lt;&lt;Wu sǝni, ndako ka!&gt;&gt; Wu kǝa ear ɗang.</char> <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" /><char style="wj">Acemǝnana akǝrǝsti mǝ'nyirnì andǝ amǝ'ɓangnǝa mǝ'nyirnì à nǝ̀ purkio, à nǝ̀ pakki agir-lǝmdǝa andǝ agir-ndǝlǝki ɗàngɗáng, ace ɓosǝki aɓwana mǝnana Ɓakuli tarkia ka, ɓǝ̀ à nǝ̀ gandǝi ka.</char> <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" /><char style="wj">Ace mani ka, wu tsǝkir wun, ǝn angŋa dǝmba ǝn bangŋǝna wun kaniama ɓǝà pa.</char><verse eid="MRK 13:23" /></para>
  <para style="s">Nyare yiu mala Muna mala Ɓwa</para>
  <para style="r">(<ref loc="MAT 24:29-35">Matiu 24:29-35</ref>; <ref loc="LUK 21:25-38">Luka 21:25-38</ref>)</para>
  <para style="pi">
    <verse number="24" style="v" sid="MRK 13:24" />
    <char style="wj">Aɓalǝ amǝno yia anonggio anzǝm nggea tanni ka,</char></para>
  <para style="q1" vid="MRK 13:24">
    <char style="wj">À nǝ̀ kongsǝ pwari aɓa pǝndǝa.</char></para>
  <para style="q2" vid="MRK 13:24">
    <char style="wj">Sǝ zongŋo ka pà nǝ̀ ta ɗàng.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:24 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 13:10">Isha 13:10</ref>; <ref loc="EZK 32:7">Ezǝk 32:7</ref>; <ref loc="JOL 2:10">Jol 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12">Sǝn 6:12</ref></char>.</note><verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />
    <char style="wj">Anlero nǝ̀ pur a kùli</char></para>
  <para style="q2" vid="MRK 13:25">
    <char style="wj">à nǝ̀ sukkio.</char></para>
  <para style="q1" vid="MRK 13:25">
    <char style="wj">Agir mǝgulke mǝnana a kùli ka,</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:25 </char>
      <char style="fq" closed="false">Agir mǝgulke mǝnana a kùli ka: </char>
      <char style="ft" closed="false">A nza mana a pwarian ngga aɓwana twali ama anlero mana a kùli ka à ndanǝ abangŋo mana à kǝ lǝmdǝ rǝcandǝa amur agir mana à kǝ kumban a ɓanza ka.</char>
    </note></para>
  <para style="q2" vid="MRK 13:25">
    <char style="wj">à nǝ̀ dǝurǝkya.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:25 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 34:4">Isha 34:4</ref>; <ref loc="REV 6:13">Sǝn 6:13</ref>; <ref loc="JOL 2:10">Jol 2:10</ref></char>.</note><verse eid="MRK 13:25" /></para>
  <para style="mi">
    <verse number="26" style="v" sid="MRK 13:26" />
    <char style="wj">A nzǝm mǝno ka sǝ ɓwapǝndǝa nǝ̀ sǝn Muna mala Ɓwa aban yiu aɓalǝ apǝrɓang nǝ rǝcandǝa mǝgule andǝ ɓoarɓwa.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:26 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="REV 1:7">Sǝn 1:7</ref></char>.</note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" /><char style="wj">Sǝ nǝ̀ tasǝ amǝturonjar male ɓǝà yi ramgi aɓwana male mǝnana tarkia ka aɓa ɓanza kat; nǝ takuli, nǝ njar-nzali, nǝ njar-kúnmur, sǝ nǝ njar-nza, arǝ aban kat, aban ká arǝ akúnbân mala ɓanza andǝ akúnbân mala kùli.</char><verse eid="MRK 13:27" /></para>
  <para style="s">Kanicau arǝ nggun vwari</para>
  <para style="r">(<ref loc="MAT 24:32-35">Matiu 24:32-35</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="pi">
    <verse number="28" style="v" sid="MRK 13:28" />
    <char style="wj">Wu kànì gìr arǝ nggun vwari. Ɓǝ̀ ambui tinata pǝlǝ pwale sǝ à nǝ̀ nggǝ to lolloapì ambui ka, wu sǝlǝ ama mbulo malanǝ̀ sulǝo.</char> <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" /><char style="wj">Ana gbal ɓǝ̀ wu sǝn amǝnia yia agir à nǝ̀ nggǝ pakki ka, wu sǝlǝ ama yiu mem gbàshìnà, nda a nggearǝ kunɓala.</char> <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" /><char style="wj">Ən nggǝ bangga wun ɓafo, nza man ngga, pà nǝ̀ kútí ɗang, she ɓǝ̀ amǝnia yia agir pángŋǝ̀nà ka.</char> <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" /><char style="wj">Nzali andǝ kùli ka tea nǝ̀ malâ, sǝ cau mem ngga tè pà nǝ̀ mal ɗang.</char><verse eid="MRK 13:31" /></para>
  <para style="s">Wu dum nǝ gilǝkirǝu</para>
  <para style="r">(<ref loc="MAT 24:36-44">Matiu 24:36-44</ref>; <ref loc="LUK 21:26-34">Luka 21:26-34</ref>)</para>
  <para style="pi">
    <verse number="32" style="v" sid="MRK 13:32" />
    <char style="wj">Kǝ ɓwa súrǝ̀ pwari ko bu-pwari mǝnana agir mǝnia nǝ̀ nggá pang nǝi ka ɗang. Amǝturonjar mǝnana a kùli gbal ka, à súrǝì ɗang. Nggearǝ mim Muna mala Ɓakuli ka, ǝn súrǝì ɗang. Kǝ Tárrám nǝmurǝì nda mana sǝlǝ ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:32 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 24:36">Mat 24:36</ref>
      </char>.</note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" /><char style="wj">Wu do aɓa gilǝrǝu, wu dum nǝ mǝsǝ wun; acemǝnana wu súrǝ̀ pwari mǝnana bu-pwari mǝno nǝ̀ yiu nǝi ka ɗang.</char> <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><char style="wj">Yiu mala Muna mala Ɓwa ka à nǝ̀ kànì arǝ ɓwa mǝnana lo nǝ̀ o a bǝri ka. Nǝ̀ ɗeki ɓala ka, nying túró a bu aguro male, koyan ngga nǝ túró mǝnana nǝ̀ nggǝ pak ka. Sǝ ne mǝ'yál kunɓala ɓǝ̀ kundǝmur nyare male.</char><note caller="+" style="f"><char style="fr" closed="false">13:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:36-38">Luk 12:36-38</ref></char>.</note> <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" /><char style="wj">Ace mani ka, wu do nǝ mǝsǝ wun aɓa gilǝrǝu, acemǝnana wu súrǝ̀ pwari mǝnana Mǝtala ɓala nǝ̀ nyar nǝi ka ɗàng; ko nǝ pwarikpana, ko nǝ ɓadu, ko nǝ ɓua mala nggǔ, ko nǝ dǝmbari.</char> <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" /><char style="wj">Sǝ ɓǝ̀ yiu nǝ gya yasǝlǝban ngga, ɓǝ̀ kǝa kum wun a ntulo ɗàng.</char> <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" /><char style="wj">Mǝ ndarǝ na wun cau mana ǝn nggǝ ne koyana le ka, wu dum nǝ mǝsǝ wun aɓa gilǝrǝu!</char><verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">À soapi Yesu mùrú a Betani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Matiu 26:6-13</ref>; <ref loc="JHN 12:1-8">Yohana 12:1-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Anongŋo ɓari a dǝm Lamsan mala Yàlîmurû andǝ Lamsan mala Bǝredi mǝnana Yis pa arǝì raka, agbani pǝris andǝ amalǝm Nggurcau mala Musa ka, à nda ban alta njar aɓa sǝmbǝrǝa, mǝnana à nǝ̀ bwalǝna Yesu nǝi à nǝ̀ wal-luí ka.<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:1-27">Pur 12:1-27</ref></char>.</note> <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />À eare ama, &lt;&lt;Ɓǝ̀ kǝa pa a pwari pakkiɗire ɗang, ɓǝ̀ ana raka ɓwapǝndǝa nǝ̀ lo arǝ sǝm.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Aɓa mǝno anggo ka Yesu na aɓa Betani, nda aban lili a ɓala mala Shiman mǝnana mǝdakali na ɗiɗyal ka. Ɓè ɓwama kutio nǝ muna-bang mǝnana à ɓe nǝ tali alabasta ka, nǝ mùrú mǝ'rǝmɓoarne aɓalǝi, mǝnana boale pa bǝti raka. Mùruî ka nard<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="fq" closed="false">nard </char><char style="ft" closed="false">ka ɓe mùrú na aɓwana a pwarian kǝ kambǝi arǝ nlerǝ ta ɓe bondo nzali mala amǝ Indiya ace pà rǝmban mǝɓoarne.</char></note> na nǝmurǝì, à zurǝi andǝ kǝgìr ɗàng. Ɓwama man yi ɓun girkun muna-bang pǝlǝa solǝì Yesu mùruî a ɓamúrí.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>.</note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Aɓea aɓwana mǝnana atà Yesu aban li ka, bumia kiɗiki, à ne arǝarǝia ama, &lt;&lt;Ace mana sǝ à kiɗiki mùrú mǝnia ka anggo? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Acemǝnana mǝnia yì mùrú ka à nǝ̀ gandǝ me amur gìr mǝnana kútì boalo dinari gbǝman tàrú, sǝ boale ka à nǝ̀ gakkia amǝ'tǝ̀r!&gt;&gt; À munǝki arǝ ɓwama mǝno kǝ̀rkǝ́r.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Sǝ Yesu ka na ama:</para>
  <para style="pi" vid="MRK 14:6">
    <char style="wj">Wu ɗeki ɓwama man ɗǝong. Ace mana sǝ wu kǝ peki le? Yì ka, pàngŋǝ́nàm gìr mǝɓoarne.</char> <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" /><char style="wj">Wu nda a tarǝ wun wunǝ amǝ'tǝ̀r pwari-pwari. Wu nǝ̀ gandǝ pakkia wia pepe ko aya pwari bum wun kànì ka. Sǝ mim ngga, pà wu nǝ̀ kumam ko aya pwari ka ɗang.</char><note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 15:1">Nggur 15:1</ref></char>.</note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" /><char style="wj">Yì ka, pàngŋǝ̀nà gìr mǝnana gandǝi ka, ak dǝmba soapam mùrú a nggūrǝam, acau mala cem a ɓembe.</char> <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" /><char style="wj">Ɓafo, ǝn nggǝ bangga wun, ɓǝ̀ aya ban a ɓanza mǝnana kat à nǝ̀ hamnǝ Cau Amsǝban nggam ngga, gìr mǝnana mǝnia yì ɓwama pe ka, à nǝ̀ ɗenyi nǝi, à nǝ̀ na ce.</char><verse eid="MRK 14:9" /></para>
  <para style="s">Yahuda mak Yesu</para>
  <para style="r">(<ref loc="MAT 20:14-16">Matiu 20:14-16</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Pǝlǝa Yahuda Iskariyoti, mwashat aɓalǝ alaggana mana lum-nong-ɓari ka, puro wari aban agbani pǝris, nǝ̀ nggá mak Yesu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Banɓoaria agbani pǝris nǝ ok mǝnia yì cau ka, pǝlǝa à eare ama à nǝ̀ pe wi boalo. Yì gbal ka tita alta njar mǝnana nǝ̀ pea wia Yesu nǝi ka.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesu li girlina Paska <optbreak /> andǝ alaggana male</para>
  <para style="r">(<ref loc="MAT 26:17-25">Matiu 26:17-25</ref>; <ref loc="LUK 22:14-23">Luka 22:14-23</ref>; <ref loc="JHN 13:21-30">Yohana 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Nda a pwari mǝnana à tinata Lamsan mala Bǝredi mana Yis pa arǝì raka, kǝ pwari mǝnana à kasǝkiyi meal mǝgam mala Lamsan Yàlîmurû nǝi ka. Alaggana mala Yesu ɗì ama, &lt;&lt;Aya ban sǝ a kǝ earce ɓǝ̀ sǝm nggea gilǝkio ban ace li girlina Yàlîmurû?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Pǝlǝa tasǝ aɓea alaggana male ɓari, nea wia ama, <char style="wj">&lt;&lt;Wu kyane a nggea-là, ɓǝ̀ wun nǝ̀ nggá kútí ka, wun nǝ̀ gāsǝ wunǝ ɓe ɓwabura nǝ bàng-mùr a kwari, wu kya atè.</char> <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" /><char style="wj">Ɓǝ̀ aya ɓala sǝ kútí ka, wu ne mǝtala ɓalae ama, &lt;Malǝm kǝ ɗiban ama, kurǝm mala abǝri mǝnana mǝ nǝ li girlina Yàlîmurû kam sǝnǝa alaggana mem ngga ndake?&gt;</char> <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" /><char style="wj">Nǝ̀ lǝmdǝa wun kurǝm kùli mǝgule, mana à gilǝkina ɓālǝi pepè ka. Wu kya pakka sǝm girlina kam.&gt;&gt;</char><verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Pǝlǝa alaggane o, à kya kutio a nggeale, sǝ à kya kum agir kǝla mǝnana Yesu nea wia ka, sǝ à pak girlina Yàlîmurû kam.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Nǝ pwari kpǝra ka, Yesu yiu andǝ alaggana male mana lum-nong-ɓari ka.<note caller="+" style="f"><char style="fr" closed="false">14:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 41:9">Ang 41:9</ref></char>.</note> <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Lang à yì dumǝna aban li ka, Yesu na ama, <char style="wj">&lt;&lt;Ɓafo, ǝn nggǝ bangga wun, ɓwa mwashat aɓalǝ wun aban li atàm, nǝ̀ nggá mem.&gt;&gt;</char><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Bumia kiɗiki, sǝ koyan aɓalǝia ka ɗì ama, &lt;&lt;Mǝ nda le?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yì ka, earia wia ama, <char style="wj">&lt;&lt;Mwashat aɓalǝ wun lum-nong-ɓari, mǝnana kǝ oasǝ buì atàm ado a kwar ka, nda.</char> <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" /><char style="wj">Muna mala Ɓwa ka nǝ̀ wu púp, kǝla mana à gilǝì amurí aɓa Malǝmce ka. Sǝama, caukwanban na nǝ ɓwa mǝnana nǝ̀ mak Muna mala Ɓwa ka! Nǝ̀ ɓoaribanì, yi mǝnana mǝnia yì ɓwa ka à ɓǝli raka!&gt;&gt;</char><verse eid="MRK 14:21" /></para>
  <para style="s">Nu jibi mala Mǝtalabangŋo</para>
  <para style="r">(<ref loc="MAT 26:26-30">Matiu 26:26-30</ref>; <ref loc="LUK 22:14-23">Luka 22:14-23</ref>; <ref loc="1CO 11:23-25">1 Amǝ Korinti 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Lang à nda amur li girlina ka, Yesu twal bǝredi, sǝ pak yàwá, sǝ ɓwani, pea alaggana male, nea wia ama, <char style="wj">&lt;&lt;Wu é wu she, nggūrǝam ma.&gt;&gt;</char><verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Pǝlǝa twal kwap, pak yàwá, sǝ pea wia, à nu àkǝ̀ ɓālǝi yia kat. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Mǝnia ka nda nkílèm mana à sukki ace aɓwana pas ka. Nda nkila mana tsǝkiyi bǝsa kùrcau mǝnana Ɓakuli pa aban aɓwana male, aɓa túró ka.</char><note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 24:8">Pur 24:8</ref>; <ref loc="JER 31:31-34">Ir 31:31-34</ref></char>.</note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" /><char style="wj">Ən nggǝ na wun ɓafo, pa mǝ nǝ nu mùr-ɓǝlanggun anap man ɗǝm ɗàng, she a pwari mǝno, mǝ nǝ nui bǝshe a domurǝm mala Ɓakuli ka.&gt;&gt;</char><verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Anzǝm mana à tuna nggyal ka, à puro à o a Nkono Olif.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesu bang ama Bitǝrus <optbreak /> nǝ̀ tǝmce súrǝè</para>
  <para style="r">(<ref loc="MAT 26:31-35">Matiu 26:31-35</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />A njar aban o ka Yesu nea wia ama, <char style="wj">&lt;&lt;Wun kat wu nǝ̀ ɓangŋa wu nǝ̀ nyem, acemǝnana à gilǝa a muram aɓa Malǝmce ama,</char></para>
  <para style="q1" vid="MRK 14:27">
    <char style="wj">&lt;&lt; &lt;Ɓakuli nǝ̀ wal yálgír,</char></para>
  <para style="q2" vid="MRK 14:27">
    <char style="wj">sǝ anzur ka à nǝ̀ mesǝke.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ZEC 13:7">Zak 13:7</ref>
      </char>.</note><verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />
    <char style="wj">Sǝa ma anzǝm mǝnana ǝn longŋǝni ɓembe nǝ yilǝmu ka, mǝ nǝ akà wun dǝmba aban ká a Galili, sǝm nǝ̀ nggá je kam.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:28 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 28:16">Mat 28:16</ref>
      </char>.</note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Bitǝrus pǝlǝi wi ama, &lt;&lt;Ko ɓǝa aɓwana kat à nǝ̀ ɓangŋa à nǝ̀ nyio ka, mem ngga pà mǝ nǝ ɓang ɗang!&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesu ne wi ama, <char style="wj">&lt;&lt;Ɓafo, ǝn nggǝ no ama, yalung, nǝ bu du mǝnia ka, kaniama ɓǝ̀ nggu ɓua kúni ɓari ka, we nǝ nggearǝo a nǝ makgirem kusǝ tàrú ama, a súrǝàm ɗang.&gt;&gt;</char><verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Bitǝrus ɓinǝcau kpékpé ama, &lt;&lt;Ko ɓǝà na ama dupǝnam púp ama mǝ wu sǝnǝ we ka, pà mǝ nǝ makgìr súrǝ̀o ɗàng.&gt;&gt; Acilia alaggana kat gbal ka à na kǝ cau mǝ'mwashati.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesu pak hiwi a Gefsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Matiu 26:36-46</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Pǝlǝa Yesu andǝ alaggana male o a ɓekǝ ban ndakam à tunǝki ama Gefsemani aɓalǝ anggun olif. Yesu ne alaggana male ama, <char style="wj">&lt;&lt;Wu duk kani, mǝ nǝ nggá pak hiwi.&gt;&gt;</char> <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Twal Bitǝrus, andǝ Jemis, andǝ Yohana atè, sǝ tita bumkiɗikea kǝ̀rkǝ́r, ban pakki wi ɓà. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Yilǝmem ngga nda aɓa tanni kǝla ɓǝ̀ purî rǝàm. Wu duk kani nǝ mǝsǝ wun atàm.&gt;&gt;</char><verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Kutio o a dǝmba anggo, kya kpa nzali, sǝ pak hiwi ama ɓǝ̀ nǝ̀ gandǝnǝ pa ka, pwari tanni mǝnana kǝ yiu ka ɓǝ̀ sharibani. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Na ama, &lt;&lt;<char style="wj">Dâ</char><note caller="+" style="f"><char style="fr" closed="false">14:36 </char><char style="fq" closed="false">Dâ: </char><char style="ft" closed="false">Mǝnia nǝ kún Aramayik ka nda &lt;&lt;Abba.&gt;&gt;</char></note>, <char style="wj">gìr kat a bano ka kǝ gandǝ pa. Ən nggǝ zǝmbô, gǝsham mǝnia yì kwap mala tanni ka. Kat andǝ amani ka, ɓǝ̀ kànì mala ɓabumo ɓǝ̀ pa, mem na ɗang.&gt;&gt;</char><verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Pǝlǝa nyare yiu aban alaggana male yi kumia ka à nda a ntulo. Ne Bitǝrus ama, <char style="wj">&lt;&lt;Shiman, a nda ntulo le? A pà nǝ gandǝ do nǝ mǝsǝo atàm ko bu-pwari mwashat ɗang re?</char> <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" /><char style="wj">Wu dum nǝ mǝsǝ wun, wu pak hiwi, ace mǝnana ɓǝ̀ wu kǝa kutio aɓa kārǝkiban ɗang. Bangŋo ka earǝna, sǝ nggūrǝu ka, yauwiki.&gt;&gt;</char><verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Yesu nyar ɗǝm a kusǝì, o kya pak hiwi; ɓǝsǝlǝ kǝ cau mǝ'mwashati. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Lang nyare yiu aban alaggana male ka, yi kumia ɗǝm a ntulo, acemǝnana mǝsǝia dǝmbǝrikina. À súrǝ̀ cau mǝnana à nǝ̀ ne wi ka ɗàng.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Lang nyar abania tàruià ka, banggia wia ama, <char style="wj">&lt;&lt;Wu nda a ntulo più aban usǝlǝo le? Kārǝ́na! Pwari pàngŋǝ̀nà! Wu sǝni, Muna mala Ɓwa ka à mangŋǝ́nì a ban amǝ'cauɓikea.</char> <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" /><char style="wj">Wu lo, ɓǝ̀ sǝm o! Mǝ'mem ngga, ndya kǝ yiu ka!&gt;&gt;</char><verse eid="MRK 14:42" /></para>
  <para style="s">À bwal Yesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Matiu 26:47-56</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Anggo kun Yesu malaká pwal ɗàng, Yahuda, mwashat aɓalǝ aman lum-nong-ɓari ka nǝ̀ yia tusǝo. Ndanǝ aɓwana atè pas nǝ akafe andǝ agbǝlang gara abuia, aɓwana mana agbani pǝris, andǝ amalǝm Nggurcau mala Musa andǝ aɓwana-mǝgule tasǝia ka. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Ɓwa mǝnana me, yì Yahuda ka, angŋa dǝmba kàninià wia ama, &lt;&lt;Ɓwa mǝnana mǝ nǝ kùrrì zǝp ka, nda kǝ ɓwe. Wu bwali, wu tà buì kàngkàng, wu um nǝi.&gt;&gt;<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Yiu mala Yahuda ka yi kútí nǝ kutio aban Yesu, ne wi ama, &lt;&lt;Malǝm!&gt;&gt; Sǝ kùrrì zǝp. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Pǝlǝa acilia aɓwana mǝno yiu à gbami Yesu à bwali taptap.<verse eid="MRK 14:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 14:47" />Sǝ ɓeɓwa mwashat aɓalǝ aɓwana mǝnana atà Yesu ka, kwetǝ kafe male, kwarǝna guro mala pǝris mǝgule nǝi, kasǝ kiri kpat.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Wu yiu nǝ akafe andǝ agbǝlang gara ace bwalam kǝla mǝ nda mǝɓǝmbǝriban?</char> <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><char style="wj">Ko aya pwari ka mǝ nda sǝnǝa wun, aban kanigir aɓa Ndàmǝgule mala Ɓakuli. Mana tsǝa sǝ wu bwalam ɗang? Sǝama mǝnia ka pa anggo acemǝnana ɓǝà lùmsǝ cau mala Malǝmce.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">14:49 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char>.</note> <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Pǝlǝa alaggana male ɓangŋa, à ɗeki.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Ɓè lagga ndakam kǝ kpa ateà a nzǝ́mò , yì ka, daura pa arǝì ɗàng, she kǝ gìrkùmsǝo nda mǝnana arǝì ka. Aburana mǝno ɓariki ama à nǝ̀ bwali, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />kara panzǝ lagir, ɓangŋa, um nǝ ɓate.<verse eid="MRK 14:52" /></para>
  <para style="s">À warinǝ Yesu a ban ɓashi</para>
  <para style="r">(<ref loc="MAT 26:57-68">Matiu 26:57-68</ref>; <ref loc="LUK 22:54-55">Luka 22:54-55</ref>; <ref loc="JHN 18:13-24">Yohana 18:13-24</ref>)</para>
  <para style="m">
    <verse number="53" style="v" sid="MRK 14:53" />À warinǝ Yesu a ɓala mala pǝris mǝgule, ban mǝnana agbani apǝris, andǝ akapana, andǝ amalǝm Nggurcau mala Musa, yi ram kam ngga. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Bitǝrus ka kpate kuko, kya kutio chatchat aɓa ɓala mala Pǝris Mǝgule. A kàm ngga, kya do atà amǝ'yálban aban dandǝ rǝì a kun bǝsa.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Akanó aɓalǝi ka, agbani pǝris andǝ amǝ'ɓashi mala amǝ Yahudi kat, à nda aban alta cau mǝnana nǝ̀ pur a kun Yesu mǝnana à nǝ̀ pàngŋǝ̀nà túró nǝi ace wal-luí ka, sǝ ko à kum ɗang. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Aɓwana pas yi naki anyir amurí, sǝ kat andǝ amani ka, kunia yiu mwashat ɗang. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />A masǝlǝate ka, aɓea aɓwana lo a came, a na mǝnia yì nyir ka amur Yesu, ama, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Sǝm oè bang ama, &lt;Mǝ nǝ arki Ndàmǝgule mala Ɓakuli mǝnana à ɓè nǝ bu ka, sǝ anzǝm nongŋo tàrú ka, mǝ nǝ ɓak ɓè mǝnana à ɓè nǝ bu raka.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:58 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 2:19">Yoh 2:19</ref></char>.</note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ko a nggearǝ ɓá mani mǝno ka, kunia yiu ɗàngɗáng.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Pǝlǝa pǝris mǝgule lo came amúrià, sǝ ɗì Yesu ama, &lt;&lt;A pà nǝ bǝl kuno re? A panǝ cau mana awu nǝ na amur acau mǝnana aɓwana mǝnia kǝ na amuro ka re?&gt;&gt; <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Sǝ Yesu ka duk kúni più, na kǝ cau ɗàng. Nyare pǝris mǝgule ɗì ama, &lt;&lt;A nda Kǝrǝsti, yì Muna mala Ɓakuli le?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesu ear ama, <char style="wj">&lt;&lt;Mǝ nda!</char></para>
  <para style="q1" vid="MRK 14:62">
    <char style="wj">&lt;&lt;Sǝ pà nǝ̀ sau ɗang wun nǝ̀ sǝn</char></para>
  <para style="q2" vid="MRK 14:62">
    <char style="wj">Muna mala Ɓwa aban do,</char></para>
  <para style="q1" vid="MRK 14:62">
    <char style="wj">a buno mala rǝcandǝa,</char></para>
  <para style="q2" vid="MRK 14:62">
    <char style="wj">a bù-mǝlì mala Ɓakuli,</char></para>
  <para style="q1" vid="MRK 14:62">
    <char style="wj">aban yiu aɓalǝ apǝrɓang</char></para>
  <para style="q2" vid="MRK 14:62">
    <char style="wj">nǝ kuli.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14:62 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DAN 7:13">Dan 7:13</ref>
      </char>.</note><verse eid="MRK 14:62" /></para>
  <para style="m">
    <verse number="63" style="v" sid="MRK 14:63" />Pǝris mǝgule kara bwal daura male sannì kǝr, ace lǝmdǝ kàrmúrû male, sǝ ɗiban ama, &lt;&lt;À yá ulang amǝ'nakún ɗǝm sǝm alkiyitea? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Wu ongŋǝna cauɓana mǝnana ne amur Ɓakuli ka, sǝ mana wu na?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">Yia kat ka à kasǝi wi ɓashi lú, ama kārǝ́na ɓǝ̀ wú.<note caller="+" style="f"><char style="fr" closed="false">14:64 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 24:15">Pǝris 24:15</ref>,<ref loc="LEV 24:16">16</ref></char>.</note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Aɓea aɓwana ateà à tita tàkki wi ntāra arǝì, à kur amǝsǝì, sǝ à tulki nǝ abuia, à na ama, &lt;&lt;Bangga sǝm, ko yana walo!&gt;&gt; Sǝ amǝ'yálban bwali à kǝ kwaki a takiri, aban umnǝe.<verse eid="MRK 14:65" /></para>
  <para style="s">Bitǝrus tǝmce súrǝ̀ Yesu</para>
  <para style="r">(<ref loc="MAT 26:67-75">Matiu 26:67-75</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18:15-18</ref>,<ref loc="JHN 18:26-27">26-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Bitǝrus ka nda più nǝ nzali a banfana aɓa ɓala. Ɓè muna ɓwama, muna-ɓala mala pǝris mǝgule, yiu. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Lang nǝ̀ sǝn Bitǝrus aban do a kun bǝsa ka, sǝni kyap-kyap, sǝ ne wi ama, &lt;&lt;We gbal ka a nda atà Yesu Ɓwa Nazarat!&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Bitǝrus pǝlǝa tǝmce, na ama, &lt;&lt;Ən súrǝ̀ gir mǝnana a nakiyi cau amurí ka ɗàng.&gt;&gt; Pǝlǝ kusǝì ka puro nǝ kunɓala. Kara nggu ɓua.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Lang muna ɓwama, muna-ɓala sǝni kano ka, ne aɓwana mǝnana à cam a banì ka ama, &lt;&lt;Mǝnia yì ɓwa ka, nda ateà!&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Bitǝrus nyare tǝmce ɗǝm.</para>
  <para style="p" vid="MRK 14:70">Zuku ka aɓwana mǝnana à cam a banì ka, à ne Bitǝrus ama, &lt;&lt;Mǝsǝcau, a nda aɓalǝia, acemǝnana a nda ɓwa Galili!&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Bitǝrus ka kutia kángìr ama, &lt;&lt;Ɓǝ̀ súban yiu a muram ɓǝ̀ nyir na ǝn nakiyi ka; mǝnia yì ɓwa wu nakiyi ce ka ǝn súrǝì ɗàng!&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Banì sau ɗang, nggu ɓua ɓaria kúni. Kara ɓalǝ Bitǝrus kasǝ arǝ cau mǝnana Yesu ne wi ama, <char style="wj">&lt;&lt;Kaniama ɓǝ̀ nggu ɓua kúni ɓari ka, a nǝ bang kusǝ tàrú ama a súrǝàm ɗàng.&gt;&gt;</char> Sǝ Bitǝrus kpa ɓua.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">À yiu nǝ Yesu a ɓadǝm Bilatus</para>
  <para style="r">(<ref loc="MAT 27:1-2">Matiu 27:1-2</ref>,<ref loc="MAT 27:11-19">11-19</ref>; <ref loc="LUK 23:1-5">Luka 23:1-5</ref>; <ref loc="JHN 18:20-38">Yohana 18:20-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Nǝ dǝmbari ɗiɗyal ka, agbani pǝris andǝ akapana, andǝ amalǝm Nggurcau mala Musa, andǝ amǝ'ɓashi kat, à yì ear amur cau mwashat. À ta bu Yesu, à um nǝi aban Bilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Bilatus ɗì Yesu ama, &lt;&lt;A nda murǝm mala amǝ Yahudi le?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Yesu eari wi ama, <char style="wj">&lt;&lt;E, kǝ ndo a ne ka.&gt;&gt;</char><verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Agbani pǝris yiu nǝ acau ɗàngɗáng amurí. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Pǝlǝa Bilatus nyare ɗì ama, &lt;&lt;A pa wu nǝ na kuno re? Mana awu nǝ na amur mǝnia yì acau ɗàngɗáng à kǝ nea a muro ka!&gt;&gt; <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Yesu nyare loasǝ kúni ɗǝm ɗàng. Gìr nî pè Bilatus ndali.<verse eid="MRK 15:5" /></para>
  <para style="s">À kasǝi Yesu ɓashi lú</para>
  <para style="r">(<ref loc="MAT 27:15-27">Matiu 27:15-27</ref>; <ref loc="LUK 23:13-25">Luka 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yohana 18:39--19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />A koya Lamsan Yàlîmurû ka, Bilatus kǝ panzǝ pursǝna mwashat mǝnana aɓwana zǝmba ace ka. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Ɓè pursǝna nakam lùllǝì ama Barabbas, à kùrrì acemǝnana yì andǝ aɓea amǝ'candǝmúrû ka, à wal-lú a pwari zunggǝli mala là. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Ɓwabunda kutio aban Bilatus, à yì zǝmbi wi ama, ɓǝ̀ pàk gìr mǝnana pakkiyia wia ka.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Bilatus ɗiban ama, &lt;&lt;Wu earce mǝ panzǝa wun Murǝm mala amǝ Yahudi le?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Yì ka, sǝlǝna ama, ace mwararǝu sǝ agbani pǝris yiu nǝ Yesu a baní.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Sǝ agbani pǝris soakita ɓwapǝndǝa ama ɓǝà ne Bilatus ɓǝ̀ panzǝ Barabbas a kun Yesu.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Bilatus pǝlǝa ɗia ama, &lt;&lt;Sǝ mana ado mǝ pakki man yì ɓwa wu tunǝki ama murǝm mala amǝ Yahudi ka?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />A lo gǝu ama, &lt;&lt;Gballì a nggun-gangndǝi!&gt;&gt; <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Bilatus ɗia ama, &lt;&lt;Ace mana? Ya cauɓikea na pàk le?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">À nyare à loasǝ già kǝ̀rkǝ́r ama, &lt;&lt;Gballì a nggun-gangndǝi!&gt;&gt; <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Sǝ acemǝnana Bilatus earce ama nǝ̀ pwasǝbumia ka, pǝlǝa panzǝia wia Barabbas. Tsǝa à kwak Yesu, pǝlǝa pea asoje mala amǝ Roma ɓǝà kya gbàllì a nggun-gangndǝi.<verse eid="MRK 15:15" /></para>
  <para style="s">Asoje oal Yesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Matiu 27:27-31</ref>; <ref loc="JHN 19:2-3">Yohana 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Asoje umnǝ Yesu a palta a ban-mǝgule mala nggwamna, pǝlǝa à yì rambǝ acili asoje kat. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />À makki wi daura murǝm arǝì, à mārǝ́ mbulan nǝ zwe, à oasǝi wi a ɓamúrí. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Pǝlǝa à tita tunǝki ama, &lt;&lt;Ɓǝ̀ rǝo pwalo, murǝm mala amǝ Yahudi!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />À walki a ɓamúrí nǝ gara. À tappî ntāra, à kū`ndǝó amur ankūnǝia kǝla à nda ban pe wi gulo.<verse eid="MRK 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 15:20" />Anzǝm mǝnana à pangŋǝni wi amǝnia yì agir oalban ngga, à swár daura murǝm mana à oasǝi wi ka, pǝlǝa à túrì wi amale yì adaura. Sǝ à pusǝì aban ká gbàlle.<verse eid="MRK 15:20" /></para>
  <para style="s">À gbàllì Yesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Matiu 27:32-44</ref>; <ref loc="LUK 23:26-43">Luka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohana 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Ɓè ɓwa Sayirin nda ban kutio, lùllǝì ama Shiman, tár a Alizanda andǝ Rufus,<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 16:13">Rom 16:13</ref></char>.</note> pur nǝ muna-là aban yiu a nggea-là. Asoje tsǝì púp ɓǝ̀ twal nggun-gangndǝi mala Yesu.<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />À warinǝ Yesu a ban mǝnana à tunǝki ama Golgota, ɓālǝi ama, &lt;&lt;Ban mǝnana nda kǝla nkpoula Ɓamuru&gt;&gt; ka. <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />À pe wi mùr-anap mana à zurǝì andǝ mǝr<note caller="+" style="f"><char style="fr" closed="false">15:23 </char><char style="fq" closed="false">mǝr </char><char style="ft" closed="false">ka myang rǝ ɓe nggun na à kǝ pángŋǝ̀nà ɓuri wal rǝkwangya nǝi.</char></note> ka ama ɓǝ̀ nu, sǝ ginǝki.<verse eid="MRK 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 15:24" />Pǝlǝa à gbàllì amur nggun-gangndǝi. À kocàca, à gaki agir-nggūrǝu male.<note caller="+" style="f"><char style="fr" closed="false">15:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:18">Ang 22:18</ref></char>.</note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />A bu-pwari tongno-nong-ine mala dǝmbari sǝ à gbàllì. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Cauɓikea mana à bang ama pak ka, à gilǝì a kùli amurí arǝ nggun-gangndǝi ama: &lt;&lt;MURƏM MALA AMƏ YAHUDI&gt;&gt; <verse eid="MRK 15:26" /><verse number="27-28" style="v" sid="MRK 15:27-28" />À gbàllì atārǝia andǝ amǝ'ɓǝmbǝriban ɓari, man a buì mǝlì sǝ man a buì mǝ'nggare.<note caller="+" style="f"><char style="fr" closed="false">15:27-28 </char><char style="ft" closed="false">Aɓea malǝmce mǝnana à gilǝia nǝ bu ka à tsǝk mǝsǝì 28 ama, &lt;&lt;Anggo ka lùmsǝ cau ɓá Malǝmce mǝnana ama, &lt;À oasǝi aɓalǝ amǝ'cauɓikea&gt; ka.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">15:27-28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:12">Isha 53:12</ref></char>.</note><verse eid="MRK 15:27-28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Aɓwana, amǝgya kutio kǝ sanggì, à kǝ piki múrià, à kǝ na ama, &lt;&lt;Kui! We ɓwa mǝnana a nǝ arki Ndàmǝgule mala Ɓakuli, sǝ a nǝ ɓe aɓa nongŋo tàrú ka.<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:7">Ang 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="JHN 2:19">Yoh 2:19</ref></char>.</note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Sùlǝî mur nggun-gangndǝi, amsǝ ɓamur rǝò!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Ana gbal sǝ agbani pǝris andǝ amalǝm Nggurcau mala Musa, à kǝ naki acau arǝia nǝ akún oalban arǝ Yesu ama, &lt;&lt;Amsǝ aɓwana, sǝ gandǝ amsǝ ɓamur rǝì ɗàng! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Ɓǝ̀ yì nda Kǝrǝsti, Murǝm mala amǝ Isǝrayila ka, ɓǝ̀ sùlǝî múr nggun-gangndǝi adyan! Ɓǝ̀ sǝm sǝni, sǝ sǝm nǝ̀ paɓamur sǝm a baní!&gt;&gt;</para>
  <para style="p" vid="MRK 15:32">Aɓwana mǝnana à gbàllia a nggun andǝi ka, yia gbal ka à sanggì.<verse eid="MRK 15:32" /></para>
  <para style="s">Lú mala Yesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Matiu 27:45-56</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Lang pwari zǝkina ka, pǝndǝa yi gir ban kat bwal bu-pwari tàrú mala pwarikpǝra. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Nǝ bu-pwari tàrú mala pwarikpǝra ka, Yesu mǝn kúni bang ama, <char style="wj">&lt;&lt;Eloi, Eloi, lama sabatani?&gt;&gt;</char> Ɓālǝi ama, <char style="wj">&lt;&lt;Ɓakuli mem, Ɓakuli mem, palang sǝ a túràm nzǝ́mó?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:1">Ang 22:1</ref></char>.</note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Lang aɓea aɓwana mana à cam a banì, à oè ka, à na ama, &lt;&lt;Wu oè, nda ban tunǝki Iliya.&gt;&gt; <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Ɓè ɓwa ɓangŋa kya par soso aɓa mùr-anap mǝhangŋe, sǝ tsǝì a kun tondong, pǝlǝa lǝmdǝì Yesu ama ɓǝ̀ nu. Pǝlǝa ɓwe bang ama, &lt;&lt;Ɗeki, sǝm nǝ̀ sǝni, yakǝla Iliya nǝ̀ yiu nǝ̀ yia sùlǝì.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:36 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:21">Ang 69:21</ref></char>.</note> <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Yesu mak'zwalo bàng-bàng, pǝlǝa yilǝmi puro.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Kara lagir mǝtangŋe mǝnana à kasǝna ban mǝfele nǝi, mana aɓa Ndàmǝgule mala Ɓakuli ka, san aɓalǝu ɓari, twal a kùli yi zur a nzali.<note caller="+" style="f"><char style="fr" closed="false">15:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 26:31-33">Pur 26:31-33</ref></char>.</note><verse eid="MRK 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 15:39" />Ɓwamǝgule mala asoje mǝnana came pǝlǝ ɓamǝsǝi nǝ ban Yesu ka, lang ok ɓua mala Yesu, sǝ sǝn wu male ka, bang ama, &lt;&lt;Ɓafo, mǝnia yì ɓwa ka, Muna mala Ɓakuli na!&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Aɓea amamǝna cam a banì zak, à kǝ sǝnban. Maryamu Ɓwa Magdala, Maryamu nggea Jemis mǝkyauwe andǝ Yisǝfu, sǝ Salomi à nda aɓalǝ amamǝne.<note caller="+" style="f"><char style="fr" closed="false">15:40 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>.</note> <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />A Galili ka, amǝnia yia amamǝna ka, à nda à pàkkî Yesu gbasha ka. Aɓea amamǝna mǝnana à yiu atārǝia a Urǝshalima ka à ndakam gbal.<verse eid="MRK 15:41" /></para>
  <para style="s">Tsǝkban mala Yesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Matiu 27:57-61</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Agir mǝnia ka, à yì pa a pwari Jumma, mǝnana nda pwari gilǝrǝu ace pwari Sabbat, pwari usǝlǝo ka, nǝ pwarikpǝre. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yisǝfu ɓwa Arimatiya, mana nda aɓalǝ amǝkùrcau mala amǝ Yahudi, sǝ yì nǝ ɓamúrì ka, ndaban kundǝ yiu mala domurǝm mala Ɓakuli ka, wario nǝ mǝsǝkang-kangŋa a ban Bilatus, kya zǝm lú Yesu.<verse eid="MRK 15:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 15:44" />Lang Bilatus ongŋǝna ama Yesu wuna ka, gìr nî pe wi ndali. Pǝlǝa tunǝ ɓwamǝgule mala asoje ɗì ko Yesu wuna. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Lang ongŋǝna a kun ɓwamǝgule mala asoje ama Yesu wuna ka, pǝlǝa pè Yisǝfu lú Yesu.<verse eid="MRK 15:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 15:46" />Yisǝfu pǝlǝa kúr anggurbyau tsǝkban, yiu yi sulǝ lú, marǝki nǝ anggurbyau, sǝ tsǝì a ɓembe mǝnana à tǝmi a bum tali ka. Ramta tali girna kúni nǝi. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Maryamu Ɓwa Magdala andǝ Maryamu nggea Yisǝfu sǝn ban mǝnana à tsǝì kam ngga.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Yesu loapi ɓembe</para>
  <para style="r">(<ref loc="MAT 28:1-10">Matiu 28:1-10</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Lang Sabbat, pwari usǝlǝo kutina ka, Maryamu Ɓwa Magdala, andǝ Maryamu nggea Jemis, andǝ Salomi, à kúr amuku agir-mǝ'kuskushi mala pà rǝmban mǝɓoarne ace mǝnana à nǝ̀ ká à nǝ̀ hasǝi lú Yesu ka. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Nǝ dǝmbari ɗiɗyal a pwari Ladi, pwari nǝ̀ eau ani ka, à bwalǝna njargula aban ká a ɓembe. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Pǝlǝa à kǝ ɗiki rǝarǝia ama, &lt;&lt;Yana nǝ̀ gǝsha sǝm tali mǝnana a girna kun ɓembe nǝi ka?&gt;&gt; <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Lang à nǝ̀ loasǝ mǝsǝia ka, kara à sǝn nggea tali mǝgule man ngga à gǝshini. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />À nǝ̀ kutio a ɓembe ka, à sǝn ɓe lagga nǝ daura mǝpwasǝe dumǝna atà bù-mǝlì. Ɓangciu pakkia wia.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Pǝlǝa nea wia ama, &lt;&lt;Wu kǝa ɓang ɗàng. Wu nda ban sǝnban Yesu Ɓwa Nazarat, mǝnana à gbàllì ka. Longŋǝna! Pa kani ɗang. Wu sǝn ban mǝnana à nongsǝi kàm ngga. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Ado ka wu kyane wu kya ne alaggana male andǝ Bitǝrus ama nda nǝ̀ akà wun dǝmba ká a bu-nzali Galili. Akanó ka wun nǝ̀ nggá sǝni, kǝla mǝnana na wun ngga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref></char>.</note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Amamǝna man puro à nying ɓembe nǝ mire aban o nǝ rǝɓǝla, ban pakkia wia ɓà. À ne kǝɓwa ce ɗàng, acemǝnana ɓangciu pakkia wia.<verse eid="MRK 16:8" /></para>
  <para style="s">Yesu pusǝrǝi a ban Maryamu <optbreak /> ɓwa Magdala</para>
  <para style="r">(<ref loc="MAT 28:9-10">Matiu 28:9-10</ref>; <ref loc="JHN 20:11-18">Yohana 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />[Lang Yesu longŋǝna nǝ yilǝmu a pwari Ladi ka, yi pusǝrǝi a ban Maryamu Ɓwa Magdala mǝnana pusǝ akukwar tongno-nong-ɓari arǝì ka. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Pǝlǝa wario kya ne alaggana male mana à nda andǝi ɗiɗyal ka. À nda ban ɓua, à nda rǝ pak bumkiɗikea. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Sǝ lang à ok ama Yesu ndanǝ yilǝmu, sǝ yì, yì Maryamu ɓwa Magdala sǝnǝni ka, à ear ɗang.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesu pusǝrǝi a ban <optbreak /> alaggana ɓari</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luka 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Anzǝm man ngga, Yesu yi pusǝrǝi a ban aɓea alaggana male ɓari nǝ ɓamǝsǝu mǝnana à súrǝì nǝi raka, lang à nda njar aban ká a nzǝm nggea-là ka. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />À nyare à yì ne aɓia, sǝ yia gbal ka à eare ama mǝsǝcau na ɗang.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesu pusǝrǝi a ban <optbreak /> alaggana male <optbreak /> lum-nong-mwashat</para>
  <para style="r">(<ref loc="MAT 28:16-20">Matiu 28:16-20</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20:19-23</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Nǝ nzǝ́mò ka Yesu yi pusǝrǝi a ban alaggana man lum-nong-mwashat ka aban li girlina atārǝia. Pǝlǝa nunkiria ace ɗwanyi earnǝ cau andǝ murcandǝa malea mǝnana à ɓinǝ akcau mala aɓwana mǝnana à sǝni anzǝm loapi ɓembe male ka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Pǝlǝa nea wia ama:</para>
  <para style="pi" vid="MRK 16:15">
    <char style="wj">Wu kyane aɓa ɓanza kat, wu hamnǝ Cau Amsǝban a ban ɓwapǝndǝa kat.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:15 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ACT 1:8">Atúró 1:8</ref>
      </char>.</note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" /><char style="wj">Ɓwa mǝnana ak Cau Amsǝban, paɓamuri, sǝ à pakki wi batisǝma ka, nǝ̀ àwá, sǝ ɓwa mǝnana ɓinǝ ak Cau Amsǝban, paɓamuri raka, ɓashi nǝ̀ sulǝ amurí.</char> <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" /><char style="wj">Aɓwana mǝnana à paɓamuria a banam ngga, amǝnia yia agir-lǝmdǝa ka à nǝ̀ kpatea: Aɓa lullǝam à nǝ̀ pusǝ akukwar, à nǝ̀ nakia cau nǝ abǝsa kún.</char> <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" /><char style="wj">À nǝ̀ kpa an'yau nǝ buia, sǝ ɓǝà nu barya ka, pà nǝ̀ pakkia wia kǝgìr ɗàng. À nǝ̀ tsǝk buia amur amǝkwánó, sǝ amǝkwánó ka rǝia nǝ̀ kum rǝcandǝa.</char><verse eid="MRK 16:18" /></para>
  <para style="s">À twal Yesu aban ká kùli</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luka 24:50-53</ref>; <ref loc="ACT 1:9-11">Amǝ Mishan 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Anzǝm mǝnana Mǝtalabangŋo Yesu nania cau ka, kara à twali à um nǝi a kùli, kya do a bù-mǝlì mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 1:9-11">Atúró 1:9-11</ref></char>.</note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Pǝlǝa alaggana male puro à oa hamnǝ cau a koya ban ngga. Mǝtalabangŋo pak túró nǝia sǝ tsǝa aɓwana earnǝ cau malea nǝ agir-ndali mǝnana à kǝ gyata ce ka.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>