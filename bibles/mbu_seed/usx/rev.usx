<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Mbula</book>
  <para style="h">Sǝna mala Yohana</para>
  <para style="toc3">Sǝn</para>
  <para style="toc2">Sǝna</para>
  <para style="toc1">Sǝna</para>
  <para style="mt1">Sǝna</para>
  <para style="mt2">mala Yohana</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Sǝna mala Yohana </char> ka à gilǝì a bàkú mǝnana amǝkpata Yesu na arǝ kum patanni ace paɓamuru malea a bani ka. À gilǝì ace pe amǝ ɓalle tsǝkɓalǝu andǝ ɓakɓabum, sǝ kwarkiru ace do nǝ mǝsǝcau aɓalǝ apwari mala tanni andǝ patanni.</para>
  <para style="ip">Bangula mǝnia yì malǝmce ka lùmsǝ nǝ asǝna aɓa bangŋo, andǝ asǝndǝmba, andǝ agir-lǝmdǝa mana amǝkpata Yesu mǝnana ɗiɗyal ka à nǝ̀ gandǝ bwaltea, sǝama a ban acilia aɓwana kat ka à duk gir'sǝmbǝrǝa. À camarǝ ɓǝsǝlǝki nacau mala asǝngir aɓa bangŋo arǝ anjar ɗàngɗáng, mana lǝmdǝ ama amǝno yì agir kat ka, à nǝ̀ kumban a koya nza mala ɓwapǝndǝa. Mugula cau mǝnana aɓalǝi ka nda mǝnana ama, nǝ ban Kǝrǝsti Mǝtalabangŋo, sǝ Ɓakuli nǝ limurǝm amur aɓi-mǝbura kpapia kat, a masǝlǝate, kat andǝ Shetan, sǝ nǝ̀ mbwe ka aɓwana male amǝ'mǝsǝcau nì tangnakusǝu mala atsǝkbu mala bǝsa kùli andǝ bǝsa ɓanza, ɓǝ̀ mǝnia yì limurǝm yi lumsǝna ka.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Mǝn Cau<char style="ior"><ref loc="REV 1:1-8">1:1-8</ref></char></para>
  <para style="io1">Mǝn sǝne aɓa bangŋo andǝ acauterǝa aban ká aban a'ikǝlisiya tongno-nong-ɓari<char style="ior"><ref loc="REV 1:9-3:22">1:9--3:22</ref></char></para>
  <para style="io1">Malǝmce mǝnana à lanzǝ kúni nǝ agbatali myang tongno-nong-ɓari ka<char style="ior"><ref loc="REV 4:1-8:1">4:1--8:1</ref></char></para>
  <para style="io1">Anjawe tongno-nong-ɓari<char style="ior"><ref loc="REV 8:2-11:19">8:2--11:19</ref></char></para>
  <para style="io1">Dǝragon andǝ anyamɓikea ɓari<char style="ior"><ref loc="REV 12:1-13:18">12:1--13:18</ref></char></para>
  <para style="io1">Asǝndǝmba aɓa bangŋo ɗàngɗáng<char style="ior"><ref loc="REV 14:1-15:8">14:1--15:8</ref></char></para>
  <para style="io1">Bumlulla mala Ɓakuli aɓalǝ atasau tongno-nong-ɓari<char style="ior"><ref loc="REV 16:1-21">16:1-21</ref></char></para>
  <para style="io1">Kiɗikea mala Babila andǝ limurǝm amur nyamɓikea, andǝ mǝɓangnǝa mǝ'nyirì, andǝ Mǝɓealɓikea<char style="ior"><ref loc="REV 17:1-20:10">17:1--20:10</ref></char></para>
  <para style="io1">Masǝlǝata ɓashi<char style="ior"><ref loc="REV 20:11-15">20:11-15</ref></char></para>
  <para style="io1">Bǝsa kùli, andǝ bǝsa nzali, sǝ bǝsa Urǝshalima<char style="ior"><ref loc="REV 21:1-22:5">21:1--22:5</ref></char></para>
  <para style="io1">Masǝlǝata cau<char style="ior"><ref loc="REV 22:6-21">22:6-21</ref></char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">Cau mǝnana Yohana bang <optbreak /> amur mǝnia yì Sǝna ka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />Mǝnia ka nda sǝngir aɓa bangŋo nǝ bu Yesu Kǝrǝsti mǝnana Ɓakuli pe wi acemǝnana ɓǝ̀ lǝmdǝì aguro male agir mǝnana duk púp à nǝ̀ yia kutio, banì pà nǝ̀ sau raka.<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">banì pà nǝ̀ sau raka </char><char style="ft" closed="false">ko &lt;&lt;akaurǝa, dǝndi pà kàm ɗàng&gt;&gt; </char></note> Yesu túr mǝturonjar male ɓǝ̀ yì mǝngi mǝnia yì girsǝna aɓa bangŋo ka a ban guro male, Yohana. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />Yohana yì bang gìr mǝnana kat sǝna, amur Cau mala Ɓakuli, andǝ agir mǝnana Yesu Kǝrǝsti pea sǝ nea ka.<verse eid="REV 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 1:3" />Ɓwa mǝnana kǝ ɓal acau mala ɓangnǝa<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="fq" closed="false">Ɓwa mǝnana kǝ ɓal acau mala ɓangnǝa: </char><char style="ft" closed="false">Ko &lt;&lt;Ɓwa mǝnana kǝ ɓallia aɓwana acau mala ɓangnǝa mǝnia ɓǝà oè.&gt;&gt;</char></note> mǝnia nǝ loasǝ giu, andǝ aɓwana mǝnana à kǝ oe, sǝ à kǝ kpata agir mǝnana à gilǝia aɓalǝi ka, à ndanǝ tsǝkbu, acemǝnana pwari pa mala agir mǝnia ka gbàshìnà tù.<verse eid="REV 1:3" /></para>
  <para style="s">Makkun mala Yohana aban ká <optbreak /> aban a'ikǝlisiya tongno <optbreak /> nong-ɓari</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />Cautera mǝnia ka pur a banam, Yohana, aban ká a ban a'ikǝlisiya tongno-nong-ɓari aɓa nzali Asiya.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">nzali Asiya: </char><char style="ft" closed="false">Mǝnia ka nda nzali Asiya a nza mala nggwamnati mala amǝ Roma.</char></note></para>
  <para style="p" vid="REV 1:4">Ən nggǝ shamba wun ɓwamuru andǝ do rǝpwala mǝnana à kǝ pur nǝban Ɓakuli ka. Yì Ɓakuli ka nda mana ndakam ado, mǝnana ndakam a pwarian, sǝ nda mǝnana nǝ̀ pàk kàm a dǝmba ka.</para>
  <para style="p" vid="REV 1:4">Ɗǝm ngga ǝn nggǝ shamba wun ɓwamuru andǝ do rǝpwala mǝnana à kǝ pur nǝban abangŋo tongno-nong-ɓari mǝnana à nda a ɓadǝm buno-murǝm mala Ɓakuli ka.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:14">Pur 3:14</ref></char>.</note><verse eid="REV 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 1:5" />Sǝ ǝn nggǝ shamba wun ɓwamuru andǝ do rǝpwala mǝnana à kǝ pur nǝban Yesu Kǝrǝsti ka. Yì Yesu Kǝrǝsti ka nda mǝ'nakún mala Ɓakuli aɓa mǝsǝcau, mǝdǝmba mala aɓwana mǝnana à kǝ loapi ɓembe anzǝm lú ka. Sǝ yì nda mǝ'yálmúrû amur amurǝma mala ɓanza. Yì nda mǝnana earmǝsǝ sǝm, sǝ panzǝna sǝm aɓalǝ acauɓikea ma'sǝm nǝ nkila male,<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 89:27">Ang 89:27</ref></char>.</note> <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" />sǝ nyesǝ sǝm, sǝm pǝlǝna apǝris a Domurǝm mala Ɓakuli, yì Tárrí ka. Ɓǝ̀ gulo kat andǝ rǝcandǝa duk male, masǝlǝate pà kàm ɗang!<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 19:6">Pur 19:6</ref>; <ref loc="ISA 61:6">Isha 61:6</ref></char>.</note> Ɓǝ̀ do anggo.<verse eid="REV 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7" />Wu sǝni! Ndya kǝ yiu</para>
  <para style="q2" vid="REV 1:7">andǝ apǝrɓang ngga.</para>
  <para style="q1" vid="REV 1:7">Koya mǝsǝu ka nǝ̀ sǝni,</para>
  <para style="q2" vid="REV 1:7">kat andǝ aɓwana mǝnana</para>
  <para style="q1" vid="REV 1:7">à zuɓi nǝ kaɗa ka;</para>
  <para style="q1" vid="REV 1:7">sǝ akún mǝnana kat a ɓanza ka,</para>
  <para style="q2" vid="REV 1:7">à nǝ̀ ɓua atàcau male.</para>
  <para style="q1" vid="REV 1:7">E, anggo sǝ ɓǝ̀ pa!<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="MAT 24:30">Mat 24:30</ref>; <ref loc="MRK 14:62">Mar 14:62</ref>; <ref loc="JHN 19:34-37">Yoh 19:34-37</ref>; <ref loc="ZEC 12:10">Zak 12:10</ref></char>.</note> Ɓǝ̀ do anggo.<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />Ɓakuli Mǝtalabangŋo na ama, &lt;&lt;Mǝ nda Alfa, ǝn tita agir kat, sǝ mǝ nda Omega, mǝ nǝ masǝlǝ ta agir kat. Mǝ nda mǝnana mǝ ndakam ado, andǝ mǝnana a pwarian, andǝ mǝnana kǝ yiu a dǝmba ka. Mǝ nda mǝnana nǝ Rǝcandǝa ǝn Karmur Gulo kat ka!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:14">Pur 3:14</ref></char>.</note><verse eid="REV 1:8" /></para>
  <para style="s">Yohana sǝn Mǝtala sǝm <optbreak /> mǝnana loapi ɓembe ka</para>
  <para style="m">
    <verse number="9" style="v" sid="REV 1:9" />Mim Yohana, mǝ'eam wun andǝ ɓi wun aɓa nutanni, sǝ aɓa Domurǝm mala Ɓakuli, andǝ gandǝrǝu, amǝnana à dumǝna ma'sǝm aɓa Yesu ka, mǝ nda aɓa luran mǝnana à tunǝki ama Patmos ka. À twalam à yì túrǎm akani acemǝnana ǝn hamnǝ cau mala Ɓakuli, sǝ ace nakún Yesu ka. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />A pwari mǝnana à tàrrì ace Mǝtalabangŋo ka, Bangŋo mala Ɓakuli em, kara ǝn ok ɓekǝ giu mǝcandǝe kǝla ɓua mala njawe, a nzǝmam. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />Kǝ na ama, <char style="wj">&lt;&lt;Gilǝ agir mǝnana a kǝ sǝnia ka aɓa malǝmce. Sǝ wu teri aban a'ikǝlisiya mǝnia tongno-nong-ɓari ka, amǝnana arǝ anggea-là Afisu, andǝ Sǝmirna, andǝ Pargamu, andǝ Tiyatǝra, andǝ Sardis, andǝ Filadefiya, sǝ Lawodisi ka.&gt;&gt;</char><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />Lang ǝn pǝlǝa mǝ nǝ sǝn yana ɓwe nakiyiam cau ka, kara ǝn sǝn apitǝla zǝnariya tongno-nong-ɓari.<figure style="fig" alt="The seven golden lampstands" file="bk00154c.tif" size="col" loc="REV 1:12" copy="Horace Knowles" ref="1:12">Apitǝla zǝnariya tongno-nong-ɓari</figure> <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />Aban came aɓalǝ apitǝla mǝnia à cam ka, ɓeɓwa ndakam &lt;&lt;kǝla Muna mala Ɓwa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="DAN 10:5">10:5</ref></char>.</note> Ɓwe oasǝ daura mǝlime mǝnana yi sulǝo arǝ akusǝi, sǝ mārǝ́ bugir zǝnariya a kikili. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />Ɓamuri andǝ nyang-múrí ka amǝpwasǝe na kǝla buke, à pwasǝ pwapwat kǝla talimbulo; sǝ amǝsǝì na kǝla lasǝ bǝsa mǝnana kǝ earki ka. <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />Akusǝi kǝ tà'nzama kǝla bolo-ntùl mǝbangŋe mǝnana nggangsǝa aɓa bǝsa-ntul ka, sǝ nacau male ka gì na kǝla gǝshi gǝggǝli mala nggeamùr aɓa songnǝo male.<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 1:24">Ezǝk 1:24</ref>; <ref loc="DAN 10:5">Dan 10:5</ref>,<ref loc="DAN 10:6">6</ref></char>.</note> <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />Bwal anlero tongno-nong-ɓari a buì-mǝlì, sǝ nggeabyau mǝnana nǝ akúní mǝceauwe ɓari ka, puro a ɓakuni. Ɓamǝsǝi kǝ tà'nzama kǝla ta mala pwari aɓa zǝkya male.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 34:29">Pur 34:29</ref></char>.</note><verse eid="REV 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17" />Lang mǝ nǝ yia sǝni ka, kara ǝn kpa a nzali a kusǝì kǝla ɓwa mǝnana wuna ka. Pǝlǝa yi tsǝk buì-mǝlì a muram sǝ nam ama:</para>
  <para style="pi" vid="REV 1:17">
    <char style="wj">Ɓangciu ɓǝ̀ kǝa pakko ɗàng! Mǝ nda Mǝdǝmba, ǝn tita agir kat, sǝ mǝ nda Mǝtankwang, mǝ nǝ masǝlǝ agir kat!</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:17 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 44:2">Isha 44:2</ref>,<ref loc="ISA 44:6">6</ref></char>.</note> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" /><char style="wj">Mǝ nda mǝnana nǝyilǝmu ka. Ɗiɗyal ka ǝn wú, sǝ sǝni, mǝ ndya nǝ amǝsǝam ngga, masǝlǝate pà kàm ɗàng. Akyî mala Lú andǝ Domurǝm mala Lú ka à nda aɓa buam.</char><verse eid="REV 1:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="REV 1:19" />
    <char style="wj">Gìr mǝnana a sǝni ka gilǝì; amǝnana ado, andǝa mǝnana à nǝ̀ yia pǎ anzǝm amǝnia ka.</char> <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" /><char style="wj">Mǝnia ka nda ɓá cau ɓa-sǝmbǝrǝa amur anlero tongno-nong-ɓari mana a sǝnia aɓa buam-mǝlì, andǝ ɓá cau ɓa-sǝmbǝrǝa amur apitǝla zǝnariya tongno-nong-ɓari ka. Anlero mǝnia tongno-nong-ɓari ka, à nda ka amǝturonjar mala a'ikǝlisiya tongno-nong-ɓari, yì akpapi mala amǝkpata Yesu. Sǝ apitǝla tongno-nong-ɓari ka, à nda ka yià a'ikǝlisiya tongno-nong-ɓari.</char><verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Afisu ka</para>
  <para style="m">
    <verse number="1" style="v" sid="REV 2:1" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya, mǝnana a Afisu ka, ama:</char></para>
  <para style="mi" vid="REV 2:1">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝban Yì ɓwa mǝnana bwal anlero tongno-nong-ɓari a buì-mǝlì, sǝ kǝ gya aɓalǝ apitǝla zǝnariya tongno-nong-ɓari ka.</char><verse eid="REV 2:1" /></para>
  <para style="mi">
    <verse number="2" style="v" sid="REV 2:2" />
    <char style="wj">Ən súrǝ́nà rǝ atúró mô, andǝ mǝsǝkang-kangŋa mô arǝ túró, andǝ munyi mò aɓa tanni. Ən sǝlǝna ama we ka, a kǝ earnǝ aɓwana amǝ'ɓealɓikea ɗang. Aɓwana mǝnana à bang ama à nda ka amǝ'mishan, sǝ nda raka, a mwamngginia, sǝ a kumia ka amǝ'nyir na.</char> <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" /><char style="wj">Ən sǝlǝna ama we ka, a cam kàngkàng, a dum nǝ gandǝrǝu aɓa nutanni ace lullǝam, sǝ a aulǝ ɗang.</char><verse eid="REV 2:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 2:4" />
    <char style="wj">Sǝa ma mǝnia ka nda gìr mǝnana ǝn earnǝi a rǝò raka: A pǝlǝni earcearǝu mô mǝdǝmbe nzǝ́mó!</char> <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" /><char style="wj">Ɗenyi nǝ bancame mô mǝnana a ndakam ɗiɗyal sǝ a yi kpa ka! Pǝlǝ nzǝ́mó arǝ acauɓikea mô sǝ wu nyare arǝ agir mǝnana a pakkiyi ɗiɗyal atadǝmbe ka. Ɓǝ̀ a pǝlǝ nzǝ́mó arǝ cauɓikea mô a pwanzali raka, mǝ nǝ yipò, sǝ mǝ nǝ yia twal pitǝla mò a ban came male.</char> <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" /><char style="wj">Aɓa mǝno she ka gìr mǝnana banɓoaram nǝi a rǝò ka nda mǝnia ka: A ɓinǝmǝsǝ pakkiagir ɓealɓikea mala amǝ Nikolata, amǝnana mim gbal ka ǝn ɓinǝia ka.</char><verse eid="REV 2:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="REV 2:7" />
    <char style="wj">Ɓwa mǝnana ndanǝ kir ok ban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka! Koya ɓwa na mǝnana kat cam kàngkàng sǝ limurǝm ngga, mǝ nǝ eari wi ɓǝ̀ li ɓǝlanggun mala nggun yilǝmu mǝnana a ɓaban mala Ɓakuli ka.</char><verse eid="REV 2:7" /></para>
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Sǝmirna ka</para>
  <para style="m">
    <verse number="8" style="v" sid="REV 2:8" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Sǝmirna ka ama:</char></para>
  <para style="mi" vid="REV 2:8">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝban Yì ɓwa mǝnana nda Mǝdǝmbe andǝ Masǝlǝate, mǝnana wǔ sǝ lo nǝ yilǝmu ɗǝm ngga.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:8 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 44:6">Isha 44:6</ref>
      </char>.</note><verse eid="REV 2:8" /></para>
  <para style="mi">
    <verse number="9" style="v" sid="REV 2:9" />
    <char style="wj">Ən sǝlǝna rǝ ce tanni mǝnana a nda aɓalǝi ka. Sǝ ǝn sǝlǝna rǝ ce tǝ̀r mò, sǝ kat andǝ mǝno ka, a nda mǝkume! Mǝ ndanǝ sǝlǝe mala acau kiɗikiɓwa mǝnana amǝ ɓinǝmǝsǝo bang amuro ka; yia ka à nda ka aɓwana mǝnana à twalî ɓamuria ama à nda ka amǝ Yahudi, sǝ à nda raka. Aɓwana mala ndakpapi mala Shetan na.</char> <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" /><char style="wj">Ɓangciu ɓǝ̀ kǝa pakko arǝ tanni mǝnana ndo nǝ̀ kúmǒ ka ɗàng. Sǝni, Shetan ndo nǝ̀ nggá oasǝ aɓea aɓwana atà wun a ndàkurban ace mwam wun, sǝ ndo wun nǝ̀ kum tanni mǝkwane arǝ anonggio lum. Wu bwal paɓamuru ma'wun a banam pepè, ko ɓǝ̀ nǝ̀ ká lú ka, sǝ mim ngga mǝ nǝ pa wun tangnakusǝu mala yilǝmu.</char><note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 1:12">Dan 1:12</ref></char>.</note><verse eid="REV 2:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 2:11" />
    <char style="wj">Ɓwa mǝnana ndanǝ kir ok ban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka. Ɓwa mǝnana limurǝm ngga, ɓaria lú, pà nǝ̀ je ɗàng ko bǝti.</char><verse eid="REV 2:11" /></para>
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Pargamu ka</para>
  <para style="m">
    <verse number="12" style="v" sid="REV 2:12" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Pargamu ka ama:</char></para>
  <para style="pi" vid="REV 2:12">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝban Yì ɓwa mǝnana ndanǝ nggeabyau mǝceauwe mana akúní nda ɓari ka.</char><verse eid="REV 2:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="REV 2:13" />
    <char style="wj">Ən sǝlǝna ama ban mǝnana a ndakam nǝ do ka, buno-murǝm mala Shetan nda a banì. Sǝ kat andǝ mǝno ka, a cam kàngkàng aɓa kpatam. A makgìr paɓamuru mô a banam ɗàng, ko a nggearǝ bákú mǝnana à wal-lú Antipas, mǝ'nakunam mǝ'mǝsǝcau nì, mǝnana à wal-luí acem, a nggea-là ma'wun, àkǝ̀ ban mǝnana Shetan duki kam ngga.</char><verse eid="REV 2:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="REV 2:14" />
    <char style="wj">Sǝama mǝ ndanǝ agir bǝti mǝnana ǝn ɓinǝcea a rǝò ka: A kǝ earnǝ aɓea aɓwana a ɓālǝo mǝnana à bwal kanigir mala Bil'am, yì ɓwa mǝnana lǝmdǝì Balak njargula mǝnana nǝ̀ tsǝk amǝ Isǝrayila ɓǝà ɓwarki tanjar ka. Yi kania wia, ɓǝà li girlina mǝnana à tsǝì atà ankúl ka, sǝ ɓǝà pak cauɓikea nongginǝ-rǝarǝu.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="NUM 25:1-2">Ɓal 25:1-2</ref>; <ref loc="NUM 31:16">31:16</ref>; <ref loc="DEU 20:18">Nggur 20:18</ref></char>.</note> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" /><char style="wj">Ɗǝm ngga a ndanǝ aɓwana mǝnana à kǝ kpata kanigir mala amǝ Nikolata ka.</char> <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" /><char style="wj">Pwanzali, nying buo arǝ acauɓikea mô. Ɓǝ̀ ana raka, mǝ nǝ yipò nǝ yasǝlǝban, sǝ mǝ nǝ ká nǝ́ munǝo arǝ aɓwana mǝno nǝ́ nggeabyau mǝnana a kunam ngga.</char><verse eid="REV 2:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="REV 2:17" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:17 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 78:24">Ang 78:24</ref>; <ref loc="ISA 62:2">Isha 62:2</ref></char>.</note>
    <char style="wj">Ɓwa mǝnana ndanǝ kir okban ngga ɓǝ̀ ok cau mǝnana Bangŋo kǝ ne a'ikǝlisiya ka!</char></para>
  <para style="pi" vid="REV 2:17">
    <char style="wj">Ɓwa mǝnana kat cam kàngkàng limurǝm ngga, mǝ nǝ pè wi girlina-manna, mǝnana à sǝmbǝrǝi a kùli ka, ɓǝ̀ li. Ɗǝm ngga mǝ nǝ pe wi tali mǝpwasǝe mǝnana ndanǝ bǝsa lullǝu mana a nyoulǝì amurí ka. Lullǝuî ka, kǝɓwa súrǝì ɗàng she kǝ yì ɓwa mǝnana à pè wi mǝno yì tali-pwasǝa ka.</char><verse eid="REV 2:17" /></para>
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Tiyatǝra ka</para>
  <para style="m">
    <verse number="18" style="v" sid="REV 2:18" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Tiyatǝra ka ama:</char></para>
  <para style="pi" vid="REV 2:18">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝban Muna mala Ɓakuli ka. Yì nda ɓwa mana amǝsǝì kǝ earke kǝla lasǝ bǝsa, sǝ akusǝi kǝ ta gǝraɗau kǝla bolo mǝbangŋe mǝnana à kolǝi ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:18 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DAN 10:6">Dan 10:6</ref>
      </char>.</note><verse eid="REV 2:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="REV 2:19" />
    <char style="wj">Ən súrǝ̀ atúró mô. Ən sǝna earcearǝu mô, andǝ paɓamuru mô a banam, andǝ túróperi mò, andǝ munyi mò aɓa gandǝrǝu. Sǝ ǝn sǝna lidǝmba mò aɓalǝ amǝnia yì agir ka kat.</char><verse eid="REV 2:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="REV 2:20" />
    <char style="wj">Sǝama mǝnia nda gìr mǝnana ǝn ɓínǝì arǝò ka. A kǝ eari Jezebel, ɓwama mǝno tunǝki ɓamúrì ama māɓangnǝa ka, kǝ tsǝk aguro mem ɓǝà ɓwarki tanjar, ɓǝà li girlina mǝnana à tsǝì atà ankúl, sǝ ɓǝà pak cauɓikea nongginǝ-rǝarǝia.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:20 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1KI 16:31">1Amur 16:31</ref>; <ref loc="2KI 9:22">2Amur 9:22</ref>,<ref loc="2KI 9:30">30</ref>; <ref loc="NUM 25:1">Ɓal 25:1</ref></char>.</note> <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" /><char style="wj">Ən kúndǝô arǝì ɓǝ̀ pwanzali ɓǝ̀ pǝlǝ nzǝmi arǝ acauɓikea male, sǝ eare ama nǝ̀ pǝlǝa nǝ̀ nying kìɗìkì mala nongginǝ rǝarǝu male ɗàng.</char><verse eid="REV 2:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="REV 2:22" />
    <char style="wj">Ace mǝno ka, mǝ ndo mǝ nǝ túrí aɓa rǝkwana mǝɓike mǝnana nǝ̀ nongsǝì a kala aɓa tanni kǝ̀rkǝ́r ka. Sǝ aɓwana mǝnana à pak cauɓikea nongginǝban andǝ yì ka, à nǝ̀ tanni gbal atè kǝ̀rkǝ́r, she ɓǝà pwana'nzali à nyìngŋǝ̀nà agir ɓealɓikea mǝnana à pa andǝ yì ka.</char> <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" /><char style="wj">Mǝ nǝ twalta amǝkpate nǝ lú. Anggo sǝ a'ikǝlisiya kat nǝ̀ sǝlǝ ama Mǝ nda mǝnana ǝn nggǝ sǝn ɓabum andǝ ɗenyicau mala koyana le ka. Mǝ nǝ pè koyana atà wun ngga tangnakusǝu mala gìr mǝnana pak ka.</char><note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 17:10">Ir 17:10</ref>; <ref loc="PSA 62:12">Ang 62:12</ref></char>.</note><verse eid="REV 2:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="REV 2:24" />
    <char style="wj">Sǝ cili wun a Tiyatǝra, wun mǝnana kat wu kǝ̀ kpata mǝno yì kanigir mǝɓane raka, yì wun mǝnana wu kutio aɓa súrǝ̀ kanigir nyir mǝnana aɓea aɓwana tunǝi ama &lt;&lt;agir ɓa-sǝmbǝrǝa mǝlime mala Shetan&gt;&gt; ngga raka, ǝn nggǝ na wun ama: Pa mǝ nǝ tsǝka wun ɓè kǝgìr mǝdǝmbǝre amur mǝnana ǝn pana wun ngga ɗàng.</char> <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" /><char style="wj">Sǝa ma gìr mǝnana wu ndanǝi ka, wu bwali kàngkàng she ɓǝ̀n yina ka.</char><verse eid="REV 2:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="REV 2:26" />
    <char style="wj">Ɓwa mǝnana limurǝm, yì mǝnana kpata cau mem aban ká masǝlǝate ka, mǝ nǝ pè wi gara-murǝm amur anzali.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:26 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 2:8-9">Ang 2:8-9</ref>
      </char>.</note><verse eid="REV 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="REV 2:27" />
    <char style="wj">&lt;&lt;Nǝ̀ yália nǝ gara bolo;</char></para>
  <para style="q2" vid="REV 2:27">
    <char style="wj">sǝ aɓwana mǝnana </char></para>
  <para style="q1" vid="REV 2:27">
    <char style="wj">à ɓinǝcau ka,</char></para>
  <para style="q2" vid="REV 2:27">
    <char style="wj">nǝ̀ arkia, nǝ̀ mesǝkia </char></para>
  <para style="q1" vid="REV 2:27">
    <char style="wj">mwashat-mwashat</char></para>
  <para style="q2" vid="REV 2:27">
    <char style="wj">kǝla mgbakkǝra nkenye.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 2:9">Ang 2:9</ref>
      </char>.</note><verse eid="REV 2:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="REV 2:28" />
    <char style="wj">Mǝ nǝ pè wi mǝnia yì rǝcandǝa, kǝla mǝnana Tárrám pam ngga; sǝ ɗǝm ngga mǝ nǝ pè wi nlero dǝmbari!</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2:28 </char>
      <char style="fq" closed="false">nlero dǝmbari: </char>
      <char style="ft" closed="false">Gulo mǝnana à pe ɓwa mana limurǝm ngga.</char>
    </note><verse eid="REV 2:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="REV 2:29" />
    <char style="wj">Ɓwa mǝnana ndanǝ kir okban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka!</char><verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Sardis ka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Sardis ka ama:</char></para>
  <para style="pi" vid="REV 3:1">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝban Yì ɓwa mǝnana bwal abangŋo tongno-nong-ɓari mala Ɓakuli andǝ anlero tongno-nong-ɓari a buì ka.</char></para>
  <para style="mi" vid="REV 3:1">
    <char style="wj">Ən súrǝ̀ atúró mo. Aɓwana kǝ twalo ama a ndanǝ yilǝmu, sǝ mǝsǝcau ka, a nda lú.</char> <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" /><char style="wj">Lo, sangsǝ amǝsǝo! Agir mǝnana à ueoko sǝ à malanǝ̀ wu ka, loasǝia ɓǝà dum nǝ rǝcandǝa. Ən kum atúró mo a ɓadǝm Ɓakuli mem ngga, à gatti.</char> <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><char style="wj">Nyesǝ ɓālǝo nǝ nzǝ́mó, ɗenyi nǝ agir mǝnana a ok atadǝmbe, sǝ a pa ɓabumo a rǝia ka; bwalia kàngkàng, sǝ wu pǝlǝ nzǝ́mó arǝ acauɓikea mô. Ɓǝ̀ mǝsǝo sa sǝ a lo raka, mǝ nǝ yipò a bu-pwari mǝnana a tsǝk ɓālǝo raka, kǝla yiu mala mǝn'í.</char><verse eid="REV 3:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 3:4" />
    <char style="wj">Akaná a Sardis she ka aɓwana ndakam bǝti mǝnana à pǝndǝki adaura malea nǝ cauɓikea raka. Mǝ nǝ ging sǝnǝia aɓalǝ adaura pwasǝa, acemǝnana yià ka à kārǝ́na.</char> <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><char style="wj">Ɓwa mǝnana limurǝm ngga mǝ nǝ oasǝi wi daura pwasǝa arǝì kǝla mǝno, sǝ pà mǝ nǝ kasǝ lullǝì ɗàng aɓa Malǝmce Yilǝmu. Mǝ nǝ bang ce a ɓadǝm Tárrám andǝ amǝturonjar male ama yì ka, mem na.</char><note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 32:32">Pur 32:32</ref>; <ref loc="PSA 69:28">Ang 69:28</ref>; <ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="MAT 10:32">Mat 10:32</ref></char>.</note><verse eid="REV 3:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="REV 3:6" />
    <char style="wj">Ɓwa mǝnana ndanǝ kir okban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka!</char><verse eid="REV 3:6" /></para>
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mana a Filadefiya ka</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Filadefiya ka ama: </char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">Mǝnia ka nda cauterǝa </char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">mǝnana pur nǝban </char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">Yì ɓwa mana nda Mǝfele</char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">sǝ nda Mǝ'mǝsǝcau ka,</char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">yì ɓwa mana bwal kyî </char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">mala Dauda</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:7 </char>
      <char style="fq" closed="false">kyî mala Dauda: </char>
      <char style="ft" closed="false">Ko &lt;&lt;Garamurǝm amur domurǝm mala Dauda.&gt;&gt;</char>
    </note> <char style="wj">a buì ka.</char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">Gìr mǝnana mǝnǝni ka,</char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">kǝɓwa kārǝa</char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">nǝ̀ gìrì ɗàng,</char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">sǝ gìr mǝnana gìrnì ka,</char></para>
  <para style="q1" vid="REV 3:7">
    <char style="wj">kǝɓwa kārǝa </char></para>
  <para style="q2" vid="REV 3:7">
    <char style="wj">nǝ̀ mǝnni ɗàng.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:7 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EXO 32:32">Pur 32:32</ref>; <ref loc="PSA 69:28">Ang 69:28</ref>; <ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="MAT 10:32">Mat 10:32</ref></char>.</note><verse eid="REV 3:7" /></para>
  <para style="mi">
    <verse number="8" style="v" sid="REV 3:8" />
    <char style="wj">Ən súrǝ̀ atúró mo. Sǝni ǝn mǝnbǝno kunkurǝm a ɓadǝmbo mǝnana kǝɓwa kārǝa nǝ̀ gìrì raka. Ən sǝlǝna ama rǝcandǝa mo na bǝti, sǝ kat andǝ amǝno ka, a bwal cau mem, a kpate, sǝ a ginǝce lullǝam ɗang.</char> <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" /><char style="wj">Ado ka a nǝ sǝn gìr mǝnana mǝ nǝ pàkkî amǝno yì aɓwana mana à nda ka amǝ ndakpapi mala Shetan ngga. À bang ama yia ka amǝ Yahudi, aɓwana mala Ɓakuli na,</char><note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="fq">à </char> À bang ama yia ka amǝ Yahudi, aɓwana mala Ɓakuli na: <char style="ft" closed="false">Ko &lt;&lt;À bang ama à nda ka aɓwana mana Ɓakuli tària ka.&gt;&gt;</char></note> <char style="wj">sǝ nyir na à nakiyi ka. Ən nggǝ banggo, mǝ nǝ cia à nǝ̀ yiu a bano, à nǝ̀ yia ɓun a nzali a ɓadǝmbo, sǝ à nǝ̀ eare ama wun nda ka kǝ aɓwana mǝnana ǝn nggǝ earcea ka.</char><note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 60:14">Isha 60:14</ref>; <ref loc="ISA 49:23">49:23</ref>; <ref loc="ISA 43:4">43:4</ref></char>.</note> <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" /><char style="wj">Acemǝnana a kpana ta nzongcau mem a do nǝ gandǝrǝu aɓa mǝkwane nǝ munyi ka, mǝ nǝ yállǒ, a nǝ apî pwari mala nggea tanni mǝnana kǝ yiu amur ɓwapǝndǝa kat a ɓanza, ace mwam aɓwana mǝnana a mala ɓanza na ka.</char> <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" /><char style="wj">Banì pà nǝ̀ sau ɗang, mǝ ndya ǝn nggǝ yiu ka. Bwal gir mǝnana a ndanǝi ka kàngkàng, ace mǝnana kǝɓwa ɓǝ̀ kǝa ako tangnakusǝu mbulan-murǝm mo raka.</char> <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><char style="wj">Ɓwa mǝnana limurǝm ngga, mǝ nǝ tsǝì nǝ̀ duk tanggea-nggun, aɓa ndàmǝgule mala Ɓakuli mem, sǝ pà nǝ̀ purî ɓālǝi ɗǝm ɗàng. Mǝ nǝ nyoulǝî wi arǝì lullǝ Ɓakuli mem andǝ lullǝ bǝsa Urǝshalima mǝnana kǝ sulǝ nǝ kuli ka, yì nggea-là mala Ɓakuli mem; ɗǝm ngga mǝ nǝ nyoulǝî wi bǝsa lullǝam arǝì.</char><note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 62:2">Isha 62:2</ref>; <ref loc="EZK 48:32">Ezǝk 48:32</ref>; <ref loc="REV 21:1">Sǝn 21:1</ref></char>.</note> <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" /><char style="wj">Ɓwa mǝnana ndanǝ kir okban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka!</char><verse eid="REV 3:13" /></para>
  <para style="s">Cautera a ban ikǝlisiya <optbreak /> mǝnana a Lawodisi ka</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />
    <char style="wj">Gilǝî mǝturonjar mala ikǝlisiya mǝnana a Lawodisi ka ama:</char></para>
  <para style="pi" vid="REV 3:14">
    <char style="wj">Mǝnia ka nda cauterǝa mǝnana pur nǝ bani, yì ɓwa mǝnana nda Lùmsǝo mala apacau mala Ɓakuli, mǝ'nakún mǝ'mǝsǝcau nì sǝ mǝɓafoe, mǝ'yálban</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:14 </char>
      <char style="fq" closed="false">mǝ'yálban </char>
      <char style="ft" closed="false">ko </char>
      <char style="fqa" closed="false">tita puro</char>
      <char style="ft" closed="false">ko </char>
      <char style="fqa" closed="false">tǝ́r.</char>
    </note> <char style="wj">amur agirbunda mǝnana Ɓakuli pusǝia ka.</char><note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 89:27">Ang 89:27</ref>; <ref loc="PRO 8:22">Pas 8:22</ref>; <ref loc="JHN 1:1-3">Yoh 1:1-3</ref></char>.</note> <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" /><char style="wj">Ən súrǝ̀ atúró mo, ama we ka, a pî ɗang, sǝ a pwal ɗang. Eare mem ngga, ɓǝ́ a nda kùlkùl ko ɗwal!</char> <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" /><char style="wj">Sǝ acemǝnana a nda lùlù, a pwal ɗang, sǝ a pî raka, mǝ ndo mǝ nǝ polǝo.</char> <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" /><char style="wj">A kǝ ne ɓamuro ama a nda mǝkume, a rambǝna gǝna, sǝ a ɗwanyi kǝgìr ɗang! Sǝ a sǝlǝ ɗang ama we ka a nda mǝtapwasǝa, gir-mǝsǝswatǝr, mǝ'tǝ̀r, nte, sǝ a ndanǝ ɓato.</char><note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 12:8">Hos 12:8</ref></char>.</note> <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" /><char style="wj">Ace mǝno ka, ǝn nggǝ kwarkiro wu kúr zǝnariya mǝɓoarne a buam, zǝnariya mǝnana à gilǝkice nǝ bǝsa ka, ace mǝnana wu duk mǝkume. Kúr agir-nggūrǝu mǝpwasǝe a buam, mǝnana a nǝ oasǝo a rǝò sǝ a nǝ kùmsǝ do-gbǝrangtang mô mǝpà kǝsǝke ka. Sǝ wu kúr mùru-ɓuri mǝsǝu a buam, mǝnana awu nǝ hasǝ a mǝsǝo ace mǝnana wu sǝnban ngga!</char> <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" /><char style="wj">Aɓwana mǝnana kat ǝn earcea ka, ǝn nggǝ sâ rǝia, sǝ ǝn nggǝ kwarkiria. Ace mǝno ka, pak bumkiɗikea, sǝ wu pǝlǝ nzǝ́mó arǝ aɓealɓikea mô nǝ ɓabumo kat!</char><note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 3:12">Pas 3:12</ref></char>.</note><verse eid="REV 3:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="REV 3:20" />
    <char style="wj">Sǝni! Mǝ ndya ǝn came a kunkurǝm ǝn nggǝ pàk kou ka! Ɓwa mǝnana kat ok giem sǝ mǝn kunkurǝm ngga, mǝ nǝ kutio atè, sǝ sǝm nǝ̀ lìli a tarǝ sǝm sǝnǝi, kǝla agyajam.</char><verse eid="REV 3:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="REV 3:21" />
    <char style="wj">Ɓwa mǝnana limurǝm ngga mǝ nǝ yinǝi nǝ̀ yia do atàm</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:21 </char>
      <char style="fq" closed="false">atàm </char>
      <char style="ft" closed="false">ko </char>
      <char style="fqa" closed="false">a nkanggariam </char>
    </note> amur buno-murǝm mem, kǝla mǝnana ǝn limurǝm sǝ ǝn yi do atà Tárrám amur buno-murǝm male ka.<verse eid="REV 3:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="REV 3:22" />
    <char style="wj">Ɓwa mǝnana ndanǝ kir okban ngga, ɓǝ̀ ok cau mǝnana Bangŋo kǝ banggi a'ikǝlisiya ka!</char><verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">Peri mǝnana a kùli ka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />Anzǝm mǝno ka, ǝn soa mǝsǝam kara ǝn sǝn kunkurǝm a kùli mǝnana à mǝnni sǝ à nyi atarǝì ka. Sǝ yì gìu mǝnana ǝn oe atadǝmbe nam cau kǝla ɓua mala njawe ka, bang ama, <char style="wj">&lt;&lt;Yiu kani a kùli, mǝ nǝ lǝmdǝo gìr mǝnana nǝ̀ yia kumban anzǝm mǝnia ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 19:16">Pur 19:16</ref>,<ref loc="EXO 19:24">24</ref></char>.</note> <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />Kara Bangŋo mala Ɓakuli em. Ən sǝn buno-murǝm a kùli sǝ ǝn sǝn ɓeɓwa aban do amurí.<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 1:26-28">Ezǝk 1:26-28</ref></char>.</note> <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />Ɓwa mǝno do amur buno-murǝm ngga, ɓamǝsǝi kǝ tâ'nzama, kǝla tǎ mala atali jaspa andǝ kaneliya. Sǝ tà'nzama mala tali emeral ka, kàrì buno-murǝm male kǝla npāring. <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />Aɓea abuno-murǝm lumi-ɓari-nong-ine gumbǝli mǝnia yì buno-murǝm ngga a ɓalǝu, nǝ aɓwana-mǝgule lumi-ɓari-nong-ine aban do amúrià. À oasǝ adaura pwasǝa arǝia andǝ ambulan zǝnariya a ɓamuria. <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />Liki'nzama mala tǎlaban, sǝ akia mala agiu andǝ sàkkya mala mgbarangce ka, à kǝ pur nǝban buno-murǝm nì. A ɓadǝm buno-murǝm nì ka aɓukan nakam tongno-nong-ɓari à kǝ earke nǝ bǝsa. Amǝnia ka, à nda ka bangŋo tongno-nong-ɓari mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 19:16">Pur 19:16</ref>; <ref loc="REV 8:5">Sǝn 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="EZK 1:13">Ezǝk 1:13</ref>; <ref loc="REV 1:4">Sǝn 1:4</ref>; <ref loc="ZEC 4:2">Zak 4:2</ref></char>.</note> <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />A ɓadǝm mǝnia yì buno-murǝm ɗǝm ngga, ǝn sǝn ɓè gìr sarǝa nongŋo kǝla nggeamùr mǝnana à pè nǝ gǝlas ka. Esǝke kwár gǝraɗau kǝla talimbulo.</para>
  <para style="p" vid="REV 4:6">Agir-yilǝmu ine mǝnana à lùmsǝ nǝ amǝsǝu a ɓadǝmbia andǝ nzǝmia ka, à came a ɓaɓalǝu a koya buban mala buno-murǝm nì.<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 1:5">Ezǝk 1:5</ref>,<ref loc="EZK 1:18">18</ref></char>.</note> <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />Mǝdǝmbe mala amǝnia yì agir-yilǝmu ka, nda kǝla im; ɓaria ka nda kǝla jamnda; tàruià ka ndanǝ ɓamǝsǝu kǝla mala ɓwapǝndǝa; sǝ inea ka nda kǝla nkwàng mǝnana kǝ yal ka.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 1:10">Ezǝk 1:10</ref></char>.</note> <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />Komǝye na atà mǝnia yì agir-yilǝmu ka ndanǝ abu-nyál tongno-nong-mwashat. Rǝia kat ka lùmsǝ nǝ amǝsǝu a ɓalǝu andǝ nza. Du andǝ pwari à usǝlǝki ɗang, à nda rǝ tu nggyal ama,</para>
  <para style="q1" vid="REV 4:8">&lt;&lt;Mǝfele, Mǝfele, Mǝfele</para>
  <para style="q2" vid="REV 4:8">nda Mǝtalabangŋo Ɓakuli</para>
  <para style="q1" vid="REV 4:8">mana Karmur Gulo kat,</para>
  <para style="q2" vid="REV 4:8">mana ndakam ɗiɗyal,</para>
  <para style="q1" vid="REV 4:8">ndakam ado,</para>
  <para style="q2" vid="REV 4:8">sǝ nda kǝ yiu ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 6:2-3">Isha 6:2-3</ref></char>.</note><verse eid="REV 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 4:9" />Agir-yilǝmu nì lidǝmba nǝ pa ɓwangsǝban, andǝ gulo, andǝ yàwá a ban ɓwa mǝnana do amur buno-murǝm, mǝnana ndanǝ yilǝmu mana málá male pà kàm raka.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 47:8">Ang 47:8</ref></char>.</note> <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />Aɓa mǝno anggo ka aɓwana-mǝgule lumi-ɓari-nong-ine ka, à nǝ̀ kpa a nzali a ɓadǝm ɓwa mǝnana do amur buno-murǝm ngga. À nǝ̀ peri a bani, yì ɓwa mana ndanǝ yilǝmu mana málá male pà kàm raka. Lang ɓǝ̀ à nda aɓa peri anggo ka, à nǝ̀ nongsǝ ambulan-murǝm malea a ɓadǝm buno-murǝm nì sǝ à nǝ̀ bang ama:<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />&lt;&lt;A kārǝ́na,</para>
  <para style="q2" vid="REV 4:11">We Mǝtalabangŋo</para>
  <para style="q2" vid="REV 4:11">Ɓakuli ma'sǝm.</para>
  <para style="q1" vid="REV 4:11">A kārǝ́na</para>
  <para style="q2" vid="REV 4:11">ɓǝà ɓwangsǝo,</para>
  <para style="q1" vid="REV 4:11">ɓǝà po gulo,</para>
  <para style="q2" vid="REV 4:11">sǝ wu ak rǝcandǝa.</para>
  <para style="q1" vid="REV 4:11">Acemǝnana a nda mana</para>
  <para style="q2" vid="REV 4:11">a pusǝ agir kat ka.</para>
  <para style="q1" vid="REV 4:11">Kani mala ɓabumo na</para>
  <para style="q2" vid="REV 4:11">sǝ a pusǝia,</para>
  <para style="q1" vid="REV 4:11">sǝ do malea gbal ka,</para>
  <para style="q2" vid="REV 4:11">kani mala ɓabumo na.&gt;&gt;<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">Mǝgam ak malǝmce <optbreak /> mana à kǝ̀ karì ka nǝ̀ panzǝi</para>
  <para style="m">
    <verse number="1" style="v" sid="REV 5:1" />A ɓabù mǝlì mala Yì ɓwa mǝnana do amur buno-murǝm ngga, ǝn sǝn ɓè malǝmce mana à kǝ̀ karì ka,<figure style="fig" alt="Scroll" file="hk00153c.tif" size="col" loc="REV 5:1" copy="Horace Knowles" ref="5:1">Malǝmce mǝnana à kǝ karì ka.</figure> mǝnana à gilǝ cau kàm ɓālǝi andǝ nzǝmi, sǝ à lanzǝ kúni nǝ agbatali myang arǝ abanì tongno-nong-ɓari ka.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 2:9">Ezǝk 2:9</ref>; <ref loc="ISA 29:11">Isha 29:11</ref></char>.</note> <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />Sǝ ǝn sǝn ɓè nggea kanggǝrang mǝturonjar mala Ɓakuli came loasǝ gì bàng-bàng, aban hama ama,</para>
  <para style="qc" vid="REV 5:2">&lt;&lt;Yana ɓwe kārǝa nǝ fasǝki amyang mǝnia à lanzǝkina kún mǝnia yì malǝmce nǝi ka, sǝ nǝ̀ panzǝi?&gt;&gt;<verse eid="REV 5:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="REV 5:3" />Sǝ ko kǝɓwa pà kàm a kùli, ko a nzali, ko a tà-nzali, mǝnana kārǝa nǝ̀ mǝn mǝnia yì malǝmce, ko nǝ̀ sǝn gìr mǝnana à gilǝì aɓalǝi ka ɗàng.<verse eid="REV 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 5:4" />Pǝlǝa ǝn kpa ɓua kǝ̀rkǝ́r, acemǝnana à kum kǝɓwa mǝnana kārǝa nǝ̀ mǝn mǝnia yì malǝmce, ko nǝ̀ sǝn ɓālǝi ka ɗàng. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />Pǝlǝa mwashat atà aɓwana-mǝgule mǝno lumi-ɓari-nong-ine ka nam ama, &lt;&lt;Pwalo, ce a ɓua ɗàng! Sǝni, ɓwa mǝnana à tunǝki ama Im, a tàu mala Yahuda, sǝ ɗǝm ngga Mǝkà murǝm Dauda na ka, linamurǝm mǝnana tsǝì kārǝ́na nǝ̀ fasǝki amyang-kun yì malǝmce, mǝnana à lanzǝi nǝia ka, sǝ nǝ̀ mǝnni.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 49:9">Tite 49:9</ref></char>.</note><verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />Pǝlǝa ǝn sǝn Mǝgam mǝnana pa kǝla à pwan-myali ka, nda aban came nǝ ɓaɓalǝu a ban buno-murǝm, sǝ agir-yilǝmu mǝno ine andǝ aɓwana-mǝgule ka, à kàrì aɓalǝu. Ndanǝ anjawe tongno-nong-ɓari andǝ amǝsǝu tongno-nong-ɓari, amǝnana à nda ka bangŋo tongno-nong-ɓari mala Ɓakuli mǝnana à tasǝia arǝ aban kat aɓa ɓanza ka.<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:7">Isha 53:7</ref>; <ref loc="ZEC 4:10">Zak 4:10</ref></char>.</note><verse eid="REV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 5:7" />Mǝgam nì pǝlǝa yiu yi ak malǝmce nî a bù-mǝlì mala Yì ɓwa mǝnana do amur buno-murǝm ngga. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />Lang angŋǝna malǝmcenî ka, agir-yilǝmu mǝno ine andǝ aɓwana-mǝgule lumi-ɓari-nong-ine ka, à sarǝa a nzali a ɓadǝm Mǝgam. Koyana ateà ka ndanǝ zangŋan, sǝ à bwal amuna-nkenye bolo-njengǝlan a buia mǝnana à lùmsǝia nǝ muku-gìr ace loasǝ yele mǝ'rǝmɓoarne ka; yì muku-gìr ace loasǝ yele mǝ'rǝmɓoarne ka nda ka ahiwi mala aɓwana mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 141:2">Ang 141:2</ref></char>.</note> <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />Pǝlǝa agir-yilǝmu andǝ aɓwana-mǝgule mǝno tù bǝsa nggyal ama:</para>
  <para style="q1" vid="REV 5:9">&lt;&lt;A kārǝ́na wu ak</para>
  <para style="q2" vid="REV 5:9">malǝmce nî,</para>
  <para style="q2" vid="REV 5:9">sǝ wu fasǝki amyang-kuni.</para>
  <para style="q1" vid="REV 5:9">Acemǝnana we ka</para>
  <para style="q2" vid="REV 5:9">à pwan-myalo,</para>
  <para style="q2" vid="REV 5:9">sǝ nǝ nkilio sǝ a akmúr</para>
  <para style="q1" vid="REV 5:9">aɓwapǝndǝa ace Ɓakuli,</para>
  <para style="q2" vid="REV 5:9">aɓa koya kún,</para>
  <para style="q1" vid="REV 5:9">andǝ koya lasǝu,</para>
  <para style="q2" vid="REV 5:9">andǝ aɓwana arǝ</para>
  <para style="q2" vid="REV 5:9">anzali ɗàngɗáng.<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 33:3">Ang 33:3</ref>; <ref loc="ISA 42:10">Isha 42:10</ref></char>.</note><verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />A nyésǝnia à</para>
  <para style="q1" vid="REV 5:10">pǝlǝna aɓwana</para>
  <para style="q2" vid="REV 5:10">mǝnana Ɓakuli ma'sǝm</para>
  <para style="q1" vid="REV 5:10">nda murǝm amúrià,</para>
  <para style="q2" vid="REV 5:10">sǝ apǝris ace</para>
  <para style="q1" vid="REV 5:10">pakki wi túró,</para>
  <para style="q2" vid="REV 5:10">sǝ à nǝ̀ duk agbani<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="fq" closed="false">à nǝ̀ duk agbani </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">à nǝ̀ duk amǝ'yálmúrû </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">à nǝ̀ duk amurǝma</char></note></para>
  <para style="q2" vid="REV 5:10">a ɓanza.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 19:6">Pur 19:6</ref>; <ref loc="ISA 61:6">Isha 61:6</ref></char>.</note><verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />Lang mǝ ndaban sǝnban ngga, ǝn ok gì amǝturonjar mala Ɓakuli pas. Làkkì malea na á-pas andǝ amilǝyan amur amilǝyan! À gumbǝli buno-murǝm andǝ agir-yilǝmu andǝ aɓwana-mǝgule aɓalǝu.<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:10">Dan 7:10</ref></char>.</note> <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />À loasǝ già a kùli à tu-nggyal ama:</para>
  <para style="q1" vid="REV 5:12">&lt;&lt;Mǝgam mǝnana à</para>
  <para style="q2" vid="REV 5:12">pwan-myali ka,</para>
  <para style="q1" vid="REV 5:12">kārǝ́na ɓǝ̀ ak gara-murǝm,</para>
  <para style="q2" vid="REV 5:12">andǝ kume,</para>
  <para style="q1" vid="REV 5:12">andǝ sǝlǝe, andǝ rǝcandǝa,</para>
  <para style="q2" vid="REV 5:12">andǝ gusǝlǝban,</para>
  <para style="q1" vid="REV 5:12">andǝ ɓoarɓwa,</para>
  <para style="q2" vid="REV 5:12">andǝ ɓwangsǝban!&gt;&gt;<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />Pǝlǝa ǝn ok agir mǝnana kat Ɓakuli pusǝia ka, amǝnana a kùli, andǝa mǝnana a nzali, andǝa mǝnana a tǝta nzali, andǝa mǝnana a tamur ka, andǝ koya gìr mǝnana kat aɓalǝia ka aban ɓwangsǝki Ɓakuli. À tu-nggyal ama:</para>
  <para style="q1" vid="REV 5:13">&lt;&lt;Ɓwangsǝban andǝ gulo,</para>
  <para style="q2" vid="REV 5:13">andǝ ɓoarɓwa,</para>
  <para style="q1" vid="REV 5:13">andǝ rǝcandǝa ka,</para>
  <para style="q2" vid="REV 5:13">ɓǝà pè Yì ɓwa mǝnana</para>
  <para style="q1" vid="REV 5:13">do amur buno-murǝm ngga</para>
  <para style="q2" vid="REV 5:13">sǝ ɓǝà pè Mǝgam,</para>
  <para style="q1" vid="REV 5:13">málá male pà kàm ɗàng!&gt;&gt;<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />Agir-yilǝmu mǝno ine ka, à ear ama, &lt;&lt;Amin, ɓǝ̀ do anggo!&gt;&gt; Sǝ aɓwana-mǝgule ka, à kpa a nzali aban peri.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">Mǝgam fasǝki agbatali <optbreak /> myang-kun malǝmce</para>
  <para style="m">
    <verse number="1" style="v" sid="REV 6:1" />Mǝ ndarǝ sǝne sǝ Mǝgam fasǝ mǝdǝmbe mala agbatali myang tongno-nong-ɓari mǝnana à lanzǝ kum mǝno yì malǝmce mana à kǝ̀ karì ka. Pǝlǝa ǝn ok mwashat atà agir-yilǝmu mǝno ine ka, bangcau nǝ giu kǝla sa mala mgbarangce, ama, &lt;&lt;Yiu!&gt;&gt; <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />Pǝlǝa ǝn soa mǝsǝam, kara ǝn sǝn pǝ̀r mǝpwasǝe a ɓadǝmbam aban came! Ɓwa mǝnana a nzǝmi kwakiyi ka, ndanǝ nta a buì. À oasǝi wi jeko amurí, sǝ puro kǝ tswaki aban ká kǝla mǝlimurǝm mana she nǝ̀ limurǝm arǝa lwa ka.<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 1:18">Zak 1:18</ref>; <ref loc="ZEC 6:1-3">6:1-3</ref></char>.</note><verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />Lang Mǝgam fasǝ ɓaria gbatali myang ngga, ǝn ok ɓaria gir-yilǝmu na ama, &lt;&lt;Yiu!&gt;&gt; <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />Pǝlǝa ɓè pǝ̀r puro yi came! Mǝnia ka mǝbangŋe na, sǝ ɓwa mǝnana a nzǝmi kwakiyi ka, à pè wi rǝcandǝa ɓǝ̀ kiɗiki dotarǝu a ɓanza, sǝ ɓǝ̀ tsǝk aɓwapǝndǝa ɓǝà kǝ wal-lú ka rǝia. À pè wi nggeabyau mǝgule a buì.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />Lang Mǝgam nì fasǝ tàruià gbatali myang ngga, ǝn ok tàruià gir-yilǝmu na ama, &lt;&lt;Yiu!&gt;&gt; Ən loasǝ mǝsǝam, pǝlǝa ǝn sǝn pǝ̀r mǝpǝndǝe puro yi came! Ɓwa mǝnana a nzǝmi kwakiyi ka bwal sǝkel <figure style="fig" alt="A pair of scales" file="hk00156c.tif" size="col" loc="REV 6:5" copy="Horace Knowles" ref="6:5">Sǝkel</figure> a buì. <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />Pǝlǝa ǝn ok giu kǝla pur nǝban agir-yilǝmu mǝno ine ka. Na ama, &lt;&lt;Tasau mwashat mala muku yare ka, nda à nǝ̀ pǎ nda tangnakusǝu mala túró pwari mwashat ka. Sǝ tasau tàrú mala muku mǝssa bálì ka, nda à nǝ̀ pǎ nda tangnakusǝu mala túró pwari mwashat ka. Sǝ ce wu kiɗiki mùrú andǝ mùr-anap ɗàng!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 6:25">2Amur 6:25</ref></char>.</note><verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />Lang Mǝgam fasǝ inea gbatali myang ngga, ǝn ok gi inea gir-yilǝmu na ama, &lt;&lt;Yiu!&gt;&gt; <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />Pǝlǝa ǝn sǝni ka, ɓè pǝ̀r mǝ'gwalani puro yi came! Ɓwa mǝnana kwakiyi ka, lùllǝì ama Lú, sǝ Domurǝm mala Lú kǝ gya atè tù. Yia Lú andǝ Domurǝm mala Lú ka, à pea wia rǝcandǝa mala pàktúró nǝ lwa, andǝ nzala, andǝ kwánó-ɓikea, sǝ anyam-candǝa mǝnana a ɓanza ka, ɓǝà kiɗiki banì mwashat aɓa gauwe ine mala ɓanza.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 13:14">Hos 13:14</ref>; <ref loc="EZK 5:12">Ezǝk 5:12</ref>; <ref loc="EZK 14:21">14:21</ref></char>.</note><verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />Lang Mǝgam fasǝ tongnoia gbatali myang ngga, kara ǝn sǝn ayilǝmi aɓwana aban ramba aɓata gyangŋan-ɗārǝâ; à nda ka aɓwana mǝnana à wal-luia ace earnǝ cau mala Ɓakuli andǝ bangŋe aban aɓwana ka. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />À loasǝ già kǝ̀rkǝ́r à ɓua aban Ɓakuli ama, &lt;&lt;She aya fara le, we Mǝtalabangŋo mǝnana a Karban kat ka! We mǝfele andǝ mǝ'mǝsǝcau nì, aya fara sǝ a nǝ pakki ɓanza ɓashi, sǝ a ya pwari sǝ a nǝ mbwea ace nkila ma'sǝm mǝnana à sukki ka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 1:12">Zak 1:12</ref>; <ref loc="PSA 79:5">Ang 79:5</ref>; <ref loc="GEN 4:10">Tite 4:10</ref></char>.</note> <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />Pǝlǝa à pe ko yana ateà ka nggea-daura pwasǝa, sǝ à banggia wia ama ɓǝà do, ɓǝà kundǝ kam bǝti, she ɓǝ̀ làkkì mala aɓia amǝtúró andǝ amǝ'eambia mǝnana à nǝ̀ wal-luia, kǝla mǝnana à walia ka, lùmsǝ̀nà ka.<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />Mǝ ndarǝ sǝne sǝ Mǝgam fasǝ tongno-nong-mwashatia gbatali myang. Kara nzali dǝurǝki kǝ̀rkǝ́r. Pwari twalo pǝndǝ cikcik kǝla nggubyau-pǝndǝa, zongŋo pǝlǝ mǝbangŋe kǝla nkila,<note caller="+" style="f"><char style="fr" closed="false">6:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 2:10">Jol 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="ACT 2:20">Atúró 2:20</ref>; <ref loc="ISA 13:10">Isha 13:10</ref>; <ref loc="ISA 3:15">3:15</ref>; <ref loc="MAT 24:29">Mat 24:29</ref>; <ref loc="MRK 13:24-25">Mar 13:24-25</ref>; <ref loc="LUK 21:25">Luk 21:25</ref></char>.</note> <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />sǝ anlero mǝnana a kùli ka, à sukkio a nzali, kǝla amgbangŋa vwari mǝnana gung mǝcandǝe dǝurǝki nggunia, sǝ à sukki a nzali ka.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 34:4">Isha 34:4</ref></char>.</note> <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />Kuli karkya kǝla kar kala, sǝ koya nkono andǝ luran ngga, à ui aban came male.<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />Pǝlǝa amurǝma mala ɓanza, andǝ amǝ'yálmúr aɓwana, andǝ amǝgulo mala asoje, andǝ amǝkume, andǝ aɓwana amǝcandǝe, andǝ koya guro andǝ aɓwana à dukdo ɓamuria ka, à ɓangŋa, à kya sǝmbǝrǝa aɓalǝ agumi andǝ anre ka atali mala ankono.<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 2:10">Isha 2:10</ref></char>.</note> <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />À ɓuaki arǝ ankono andǝ atali ama, &lt;&lt;Wu kpa amur sǝm, wu sǝmbǝrǝ sǝm ace mǝnana Yì ɓwa mana do amur buno-murǝm ngga, ɓǝ̀ kǝa sǝn sǝm raka, sǝ ɓǝ̀ sǝm apî bumlulla mǝɓike mala Mǝgam!<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 10:8">Hos 10:8</ref></char>.</note> <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />Acemǝnana pwari mǝgule mala lǝmdǝ bumlulla mǝɓike malea yina, sǝ yana ɓwe nǝ̀ came?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 2:11">Jol 2:11</ref>; <ref loc="MAL 3:2">Mal 3:2</ref></char>.</note><verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">Ɓakuli nǝ tsǝk ntongŋo <optbreak /> amur aɓwana male</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />Anzǝm mǝno ka ǝn sǝn amǝturonjar mala Ɓakuli ine aban came arǝ abumban ine mala ɓanza. À kùr agúng mǝnana à kǝ lo ɓua nǝ abuban ine mala ɓaɓanza ka, ace mǝnana gung ɓǝ̀ kǝa ɓua amur nzali ko nggeamùr, ko anggun raka.<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 6:5">Zak 6:5</ref></char>.</note> <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />Pǝlǝa ǝn sǝn ɓè mǝturonjar aban eauwe a kùli nǝ njar-takuli, nǝ gbǝlman-parbu mala Ɓakuli mǝyilǝmuì a buì. Loasǝ gi bàng-bàng nacau nǝ amǝturonjar mǝno ine ka, yia mǝnana Ɓakuli pania wia rǝcandǝa ɓǝà kiɗiki nzali andǝ nggeamùr ka, ama, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />&lt;&lt;Wu came! Wu kǝa na ama wun nǝ̀ je nzali, ko nggeamùr ko anggun ama wun nǝ̀ kiɗikia ka ɗàng, she ɓǝ̀ sǝm tsǝ̀ngŋǝ́nì aguro mala Ɓakuli ma'sǝm nyoulǝa mala parbu a kundǝmbǝia ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 9:4">Ezǝk 9:4</ref></char>.</note><verse eid="REV 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4" />Pǝlǝa ǝn oe à na làkkì mala aɓwana mǝnana à tsǝkia wia nyoulǝa mala parbu a kún dǝmbia ka; aɓwana á-gbǝman-mwashat nǝ á-lumi-ine-nong-ine [144,000], aɓalǝ atau mala amǝ Isǝrayila.<verse eid="REV 7:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="REV 7:5" />Aɓa tàu mala Yahuda ka, aɓwana á-lum-nong-ɓari nda à tsǝkia wia nyoulǝa mala parbu ka.</para>
  <para style="li1" vid="REV 7:5">Aɓa tàu mala Ruben ngga aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:5">Aɓa tàu mala Gad ka aɓwana á-lum-nong-ɓari na.<verse eid="REV 7:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="REV 7:6" />Aɓa tàu mala Asha ka aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:6">Aɓa tàu mala Naftali ka aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:6">Aɓa tàu mala Manasa ka aɓwana á-lum-nong-ɓari na.<verse eid="REV 7:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="REV 7:7" />Aɓa tàu mala Shimiyon ngga aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:7">Aɓa tàu mala Lawi ka aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:7">Aɓa tàu mala Isaka ka aɓwana á-lum-nong-ɓari na.<verse eid="REV 7:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="REV 7:8" />Aɓa tàu mala Zebulu ngga aɓwana á-lum-nong-ɓari na.</para>
  <para style="li1" vid="REV 7:8">Aɓa tàu mala Yisǝfu ka aɓwana á-lum-nong-ɓari na,</para>
  <para style="li1" vid="REV 7:8">sǝ aɓa tàu mala Benjami ngga aɓwana á-lum-nong-ɓari na à tsǝkia wia nyoulǝa mala parbu ka.<verse eid="REV 7:8" /></para>
  <para style="s">Nggea làkkì mala ɓwabundǝa <optbreak /> ɓwangsǝ Ɓakuli</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />Anzǝm mǝnia ka ǝn sǝn nggea ramba mala ɓwabundǝa kǝ̀rkǝ́r, mǝnana kǝɓwa pà nǝ̀ gandǝ ɓallia raka. À pur arǝa koya nzali, andǝ akûn, andǝ aɓwana mala atau ɗàngɗáng, andǝ alasǝu, sǝ à came a ɓadǝm buno-murǝm andǝ ɓadǝm Mǝgam. À oasǝ anggea-daura pwasǝa a rǝia sǝ à bwal ambú nkangga a buia. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />À loasǝ già kpǝm à kǝ na ama,</para>
  <para style="q1" vid="REV 7:10">&lt;&lt;Amsǝban ngga kǝ yiu</para>
  <para style="q2" vid="REV 7:10">nǝban Ɓakuli ma'sǝm,</para>
  <para style="q1" vid="REV 7:10">mǝnana do amur</para>
  <para style="q2" vid="REV 7:10">buno-murǝm ngga,</para>
  <para style="q1" vid="REV 7:10">sǝ nǝban Mǝgam!&gt;&gt;<verse eid="REV 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="REV 7:11" />Sǝ amǝturonjar mala Ɓakuli kat ka, à nda à came, à kàrì buno-murǝm andǝ aɓwana-mǝgule andǝ agir-yilǝmu ine aɓalǝu ka. À sarǝa a ɓadǝm buno-murǝm nǝ ɓamǝsǝia a nzali sǝ à peri aban Ɓakuli, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />à kǝ na ama,</para>
  <para style="q1" vid="REV 7:12">&lt;&lt;Ɓǝ̀ do anggo! Ɓwangsǝban</para>
  <para style="q2" vid="REV 7:12">andǝ ɓoarɓwa,</para>
  <para style="q1" vid="REV 7:12">andǝ sǝlǝe, andǝ yàwá,</para>
  <para style="q2" vid="REV 7:12">andǝ gulo,</para>
  <para style="q1" vid="REV 7:12">andǝ gara-murǝm,</para>
  <para style="q2" vid="REV 7:12">andǝ rǝcandǝa ka,</para>
  <para style="q1" vid="REV 7:12">a mala Ɓakuli ma'sǝm na,</para>
  <para style="q2" vid="REV 7:12">mǝnana mala male</para>
  <para style="q1" vid="REV 7:12">pà kàm raka. Ɓǝ̀ do anggo!&gt;&gt;<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />Pǝlǝa mwashat atà aɓwana-mǝgule ɗiem ama, &lt;&lt;Ayana à nda ka aɓwana mǝnia aɓalǝ adaura pwasǝa ka, sǝ aya ban sǝ à puro?&gt;&gt;<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />Sǝ ǝn eari wi nǝma, &lt;&lt;Ɓwamǝgule, a nda mana a sǝlǝ ka.&gt;&gt;</para>
  <para style="p" vid="REV 7:14">Pǝlǝa nam ama, &lt;&lt;Amǝnia ka, à nda ka ɓwana mǝnana à purî ɓá nggea tanni mǝgule ka. À lákkína adaura malea sǝ à tsǝ̀ngŋǝ̀nia à pǝlǝna amǝpwasǝe aɓa nkila mala Mǝgam.<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="GEN 49:11">Tite 49:11</ref></char>.</note><verse eid="REV 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="REV 7:15" />&lt;&lt;Nda tsǝa sǝ à came</para>
  <para style="q2" vid="REV 7:15">a ɓadǝm buno-murǝm</para>
  <para style="q1" vid="REV 7:15">mala Ɓakuli</para>
  <para style="q2" vid="REV 7:15">sǝ à kǝ pakki wi túróperi,</para>
  <para style="q1" vid="REV 7:15">du andǝ pwari,</para>
  <para style="q2" vid="REV 7:15">aɓa Ndàmǝgule male ka;</para>
  <para style="q1" vid="REV 7:15">sǝ Yì ɓwa mǝnana do</para>
  <para style="q2" vid="REV 7:15">amur buno-murǝm ngga,</para>
  <para style="q2" vid="REV 7:15">nǝ̀ dupia wia tara amúrià.<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />À pà nǝ̀ ok nzala</para>
  <para style="q2" vid="REV 7:16">ɗǝm ɗàng ko bǝti,</para>
  <para style="q1" vid="REV 7:16">sǝ mǝsamur pà nǝ̀</para>
  <para style="q2" vid="REV 7:16">nyare nǝ̀ walia ɗǝm</para>
  <para style="q2" vid="REV 7:16">ɗàng ko bǝti.</para>
  <para style="q1" vid="REV 7:16">Pwari pà nǝ̀ walia ɗǝm</para>
  <para style="q2" vid="REV 7:16">ɗàng ko bǝti,</para>
  <para style="q1" vid="REV 7:16">sǝ ɓekǝ tosǝkiban mala</para>
  <para style="q2" vid="REV 7:16">banpina pà nǝ̀</para>
  <para style="q1" vid="REV 7:16">yiu amúrià ɗǝm</para>
  <para style="q2" vid="REV 7:16">ɗàng ko bǝti.<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 49:10">Isha 49:10</ref>; <ref loc="PSA 121:6">Ang 121:6</ref></char>.</note><verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />Acemǝnana Mǝgam</para>
  <para style="q2" vid="REV 7:17">mana nda a ɓaɓalǝu</para>
  <para style="q1" vid="REV 7:17">aban buno-murǝm ngga,</para>
  <para style="q2" vid="REV 7:17">nǝ̀ dupia wia yálgír amúrià;</para>
  <para style="q1" vid="REV 7:17">nǝ̀ kánǝia aban amgbeaɗe</para>
  <para style="q2" vid="REV 7:17">mǝnana à pākiyi</para>
  <para style="q2" vid="REV 7:17">mùr yilǝmu ka.</para>
  <para style="q1" vid="REV 7:17">Sǝ Ɓakuli ka nǝ̀</para>
  <para style="q2" vid="REV 7:17">esǝkia wia mǝrǝm</para>
  <para style="q1" vid="REV 7:17">kat a mǝsǝia.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 34:23">Ezǝk 34:23</ref>; <ref loc="PSA 23:2">Ang 23:2</ref>; <ref loc="ISA 25:8">Isha 25:8</ref>; <ref loc="ISA 49:10">49:10</ref></char>.</note><verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">Mǝgam fasǝ tongno-nong <optbreak /> ɓaria gbatali myang</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />Lang Mǝgam fasǝ tongno-nong-ɓaria gbatali myang ngga, ban nyare pwal ɗǝong a kùli, yi pur a gauwa-tsùrú mala bu-pwari mwashat. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />Pǝlǝa ǝn sǝn amǝturonjar tongno-nong-ɓari mǝnana à camgiyi a ɓadǝm Ɓakuli ka, à pea wia anjawe tongno-nong-ɓari.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />Sǝ ɓè mǝturonjar mala Ɓakuli yiu yi came a ɓadǝm gyangŋan nǝ muna-nkenye bolo-njengǝlan a buì. À pè wi muku-gìr kpǝm ace loasǝ yele mǝ'rǝmɓoarne, ace mǝnana ɓǝ̀ kpapi andǝ ahiwi mala aɓwana mala Ɓakuli kat, sǝ ɓǝ̀ pisǝì, amur gyangŋan bolo-njengǝlan mǝnana cam a ɓadǝm buno-murǝm ngga.<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="AMO 9:1">Amo 9:1</ref>; <ref loc="PSA 141:2">Ang 141:2</ref></char>.</note> <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />Yele mala muku-gìr loasǝ yele mǝ'rǝmɓoarne mǝnana kǝ lo a bu mǝturonjar ka, kpapya andǝ ahiwi mala aɓwana mala Ɓakuli, sǝ à eauwe aban ká aban Ɓakuli. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />Pǝlǝa mǝturonjar twal muna-nkenye mala muku-gìr loasǝ yele mǝ'rǝmɓoarne, lumsǝì nǝ nkalang-bǝsa mǝnana pwan aɓa bǝsa mana amur gyangŋan ngga, sǝ nyesǝi turí, mesǝke aban yiu a nzali a ɓanza. Kara mgbarangce sàkkya, ban gǝggǝli, tǎlaban liki'nzama, sǝ nzali dǝurǝkio.<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 16:12">Pǝris 16:12</ref>; <ref loc="EZK 10:2">Ezǝk 10:2</ref></char>.</note><verse eid="REV 8:5" /></para>
  <para style="s">Twanggi anjawe yiu nǝ <optbreak /> kiɗiki mala agir</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />Pǝlǝa amǝturonjar mǝno tongno-nong-ɓari nǝ́ anjawe a buia ka, à gilǝ rǝia à nǝ̀ twang njawe.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />Lang mǝturonjar mǝdǝmbe twang njawe male ka, kara bǝsa andǝ mǝsǝtali-mbulo, mǝnana kpapi andǝ nkila ka puro, kǝ solǝo aban yiu a nzali amur ɓanza. Banì mwashat aɓalǝ agauwe tàrú mala nzali ka bwal bǝsa; banì mwashat aɓalǝ agauwe tàrú mala anggun pi kǝring, sǝ abondo mǝpwale kat ka, à pi kǝring.<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 9:23-25">Pur 9:23-25</ref></char>.</note><verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />Ɓaria mǝturonjar twang njawe male. Kara à túr ɓè kǝgìr kǝla nggea nkono mǝgule mǝnana kǝ earki nǝ bǝsa ka, yi kpa aɓa nggeamùr. Banì mwashat aɓalǝ agauwe tàrú mala nggeamùr ka, pǝlǝ nkila.<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:25">Ir 51:25</ref></char>.</note> <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />Banì mwashat aɓalǝ agauwe tàrú mala agir-yilǝmu mǝnana aɓa nggeamùr ka, à wukio. Sǝ banì mwashat aɓalǝ agauwe tàrú mala awaru-bǝsa a nggeamùr ka, à kiɗikia.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />Lang tàruià mǝturonjar twang njawe male ka, ɓè nggea nlero mǝgule kasǝa a kùli aban yiu a nzali. Kǝ earki nǝ bǝsa kǝla ɓukan, yi kpa amur banì mwashat aɓalǝ agauwe tàrú mala amúr mǝnana aɓalǝ anggeasala andǝ amgbeaɗe ka.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 14:12">Isha 14:12</ref></char>.</note> <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />À tunǝki nlero nî ama Mǝlulle. Yi tsǝk banì mwashat aɓalǝ agauwe tàrú mala amúr nggeasala à pǝlǝ mǝ'lùlle. Sǝ aɓwana pas mǝnana à nu mur nî ka à wukio, ace lúllô male.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />Anzǝm twang njawe mala inea mǝturonjar ka, Ɓakuli tulkia pwari andǝ zongŋo andǝ anlero, sǝ ace mǝno ka à ɗwanyi banì mwashat aɓalǝ agauwe tàrú mala tǎ malea. Sǝ anggo ka banì mwashat aɓalǝ agauwe tàrú mala tǎlaban nǝ pwari andǝ du ka à lǝmdǝ ɗang.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />Lang ǝn soa mǝsǝam aban sǝnban ngga, ǝn ok gì nkwang mana nda ban yale, kǝ kútí nǝ bumkuli ka, kǝ hamnǝ cau nǝ giu bàng-bàng ama: &lt;&lt;Gìr mur'mwana! Gìr mur'mwana! Gìr mur'mwana amur aɓwana mǝnana à do a ɓanza ka, ace agir mǝnana à nǝ̀ yia kumban anzǝm twang njawe mala acili amǝturonjar tàrú mǝnana à ueo, sǝ à malanǝ̀ twang ngga!&gt;&gt;<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="s">Tongnoia twang njawe yiu nǝ <optbreak /> gìr mur'mwana mǝdǝmbe</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />Lang tongnoia mǝturonjar twang njawe male ka, ǝn sǝn ɓe nlero mǝnana pur nǝ kuli, yi kpa a ɓanza ka. À pe mǝnia yì nlero ka kyî mala mǝn kun tūli-tàtǝkǝtè. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />Lang mǝn kun tūli-tàtǝkǝtè ka, kara yele kǝ purki kam kǝla yele mala bǝsa ɓá ndà-nggun. Ɓamǝsǝ pwari andǝ bumkuli pǝlǝ pǝndǝa nǝ yele mǝnana kǝ pur aɓa tūli-tàtǝkǝtè ka.<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 19:28">Tite 19:28</ref>; <ref loc="EXO 19:18">Pur 19:18</ref>; <ref loc="JOL 2:10">Jol 2:10</ref></char>.</note> <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />Adoshi purkio aɓa yele nì à ara aɓa ɓanza. À pea amǝnia yì adoshi ka rǝcandǝa mala tākiban kǝla agenye ɓanza.<note caller="+" style="f"><char style="fr" closed="false">9:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 10:12-15">Pur 10:12-15</ref></char>.</note> <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />À nea wia ama ɓǝà kǝa je bondo ko agirpwala ko anggun mala ɓanza, ama à nǝ̀ tākia ɗang. Kǝ aɓwana mǝnana à pànǝ́ nyoulǝa mala parbu mala Ɓakuli a kundǝmbǝia raka, à nda à nǝ̀ tākia ka.<note caller="+" style="f"><char style="fr" closed="false">9:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 9:4">Ezǝk 9:4</ref></char>.</note> <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />Ɓakuli eari adoshi man ɓǝà wal-lú ka aɓwana mǝnia ka ɗang. Kǝ tanni na à nǝ̀ pea wia ka, bà mala malà azongŋo tongno. Sǝ kwanban mala patanni malea na kǝla tāban mala genye. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />Aɓalǝ azongŋo mǝno tongno ka, ɓwapǝndǝa nǝ alta lú, sǝ à pà nǝ̀ kumi ɗang; à nǝ̀ sham ce wu, sǝ lú ka, nǝ̀ upia wia kuko.<note caller="+" style="f"><char style="fr" closed="false">9:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOB 3:21">Ayu 3:21</ref></char>.</note><verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />Amǝnia yia adoshi ka, à nda kǝla apǝr mǝnana à gilǝkia ace ká munǝo ka. À ndanǝ agir a ɓamuria kǝla ambulan zǝnariya, sǝ aɓamǝsǝia na kǝla ɓamǝsǝ ɓwapǝndǝa.<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 2:4">Jol 2:4</ref></char>.</note> <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />Nyang múrià na kǝla nyang mur amamǝna, sǝ aminǝia na kǝla aminǝ im.<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 1:6">Jol 1:6</ref></char>.</note> <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />Mǝntongŋo damɓalǝia na kǝla ntongŋo mǝnana à pe nǝ bolo mǝcandǝe; sǝ gǝshi amburia na kǝla gǝshi kusǝ apǝr andǝ awaru-pǝr pas mǝnana à kǝ soamire aban ká kun munǝo ka.<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 2:5">Jol 2:5</ref></char>.</note> <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />À ndanǝ anggilatau mǝnana à kǝ tākiban kǝla agenye ka. Anggilatea ka, à ndanǝ rǝcandǝa mala jiki aɓwana zongŋo tongno. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />Murǝm malea ka nda mǝturonjar mala tūli-tàtǝkǝtè. Lùllǝì nǝ kun Ibǝru ka nda Abbadon, sǝ nǝ kun Gǝrik ka nda Apoliyon, Mǝkiɗikiban.<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />Gìr mur'mwana mǝdǝmbe kutina. Aɓea agir mur'mwana ɓari na à kǝ yiu ka.<verse eid="REV 9:12" /></para>
  <para style="s">Twang njawe mala tongno <optbreak /> nong-mwashatia mǝturonjar <optbreak /> yiu nǝ́ ɓaria gìr mur'mwana</para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />Tongno-nong-mwashatia mǝturonjar twang njawe male. Pǝlǝa ǝn ok giu pur nǝ kun anjawe mala gyangŋan zǝnariya mǝnana nda aban came a ɓadǝm Ɓakuli ka.<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:1-3">Pur 30:1-3</ref></char>.</note> <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />Kǝ ne tongno-nong-mwashatia mǝturonjar mǝnana nǝ njawe a buì ka ama, &lt;&lt;Panzǝ amǝturonjar ine mǝnana à kùria a kun Nggeasala mǝgule, yì Yiufǝretis ka.&gt;&gt; <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />Pǝlǝa à panzǝ amǝturonjar nì ine, mǝnana yia ka à cia nǝ tsǝa aɓa gilǝrǝu ace mǝnia yì bu-pwari mala mǝnia yì pwari, andǝ zongŋo, andǝ pǝlǝa ka. Ado ka à panzǝnia ɓǝà wal-lú banì mwashat aɓalǝ agauwe tàrú mala ɓwapǝndǝa kat a ɓanza. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />Ən ok ɓeɓwa banggàm làkkì mala amǝ'pǝ̀r mǝnana ateà anzǝm apǝr aban ká munǝo ka ama à nda milǝyan-gbǝman-ɓari.<verse eid="REV 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17" />Aɓa mǝnia yì sǝngir aɓa bangŋo à lǝmdǝam ngga, ǝn sǝn apǝr nì andǝ amǝ'pǝ̀r aban do a nzǝmia. Adaura-bolo mǝnana amǝ'pǝ̀r oasǝ a kikilia ka, aɓea ka amǝbangŋe na, aɓea ka amǝgbǝ̀lwì na, sǝ aɓea ka amǝ'gwalani. Apǝr ka, ɓamuria nda kǝla mala im, sǝ bǝsa andǝ yele andǝ tali solfo mǝ'earke nǝ bǝsa ka, à kǝ pur aɓa kunia. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />Amǝnia yia agirpatanni tàrú ka: bǝsa andǝ yele andǝ tali solfo mǝ'earke nǝ bǝsa, mǝnana à kǝ pur aɓa kun apǝr mǝno ka, à twalta mwashat aɓalǝ agauwe tàrú mala ɓwapǝndǝa kat a ɓanza. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />Rǝcandǝa mala apǝr mǝnia ka nda a ɓakunia andǝ nggilatea; acemǝnana anggilatea ka à nda kǝla an'yau; à ndanǝ rǝcandǝa mala kwarki aɓwana.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />Cili ɓwapǝndǝa mǝnana àwá, agirpatanni mǝnia walia raka, à ginǝ pak bumkiɗikea arǝ aɓealɓikea malea, à ginǝ nyare a ban Ɓakuli. À lidǝmba nǝ peri a ɓadǝmbǝ akukwar andǝ ankúl mala zǝnariya andǝ azǝrfa, andǝ bolo-bángŋá, andǝ tali, andǝ nggun; amǝnana à kǝ sǝnban ɗang, à kǝ okban ɗang, sǝ à kǝ ging raka! <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />Sǝ ɗǝm ngga à ginǝ pwanzali à nǝ̀ pǝlǝ nzǝmia arǝ pakkiagir malea mala walki-alú, andǝ kpata agirmonzǝo, andǝ kìɗìkì mala nongginǝ rǝarǝu, andǝ iki'an'i.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">Ɓakuli nǝ masǝlǝ kani male tù</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />Pǝlǝa ǝn sǝn ɓè kanggǝrang mǝturonjar mala Ɓakuli pur nǝ kuli, kǝ sulǝo aban yiu. Pǝrɓang gumbǝli rǝì sǝ npāring kàrì múrí. Ɓamǝsǝi tǎ kǝla pwari, sǝ agarakusǝi ka, à nda kǝla atanggea-nggun bǝsa. <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />Bwal mǝ'malǝmce mǝnana à mǝnni ka a buì. Yiu yi tamsǝ kusǝì mǝlì amur nggeamùr, sǝ kusǝì mǝ'nggare ka tamsǝi amur kwàrban. <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />Pǝlǝa loasǝ gì ɓua gāwàn bàng-bàng, kǝla arkwar mala im. Lang mak gāwàn ngga, agiu mgbarangce tongno-nong-ɓari nacau. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />Lang agiu mgbarangce tongno-nong-ɓari nacau ka, nǝma mǝ nǝ gilǝ cê, sǝ kara ǝn ok giu pur nǝ kuli nam ama, &lt;&lt;Cau mǝnana agiu mgbarangce tongno-nong-ɓari bang ngga, ɓǝ̀ cê duk gir'sǝmbǝrǝa! Cè a gilǝì ɗàng.&gt;&gt;<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />Pǝlǝa mǝturonjar mǝno ǝn sǝni came amúr nggeamùr andǝ kwàrban ngga, loasǝ buì mǝlì a kùli,<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:40">Nggur 32:40</ref>; <ref loc="DAN 12:7">Dan 12:7</ref></char>.</note> <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />sǝ kángìr nǝ lullǝ Ɓakuli. Kángìr nǝ lullǝ Ɓakuli mǝnana nǝ yilǝmu mana masǝlǝate pà kàm raka, mǝnana pusǝ kuli, andǝ nzali, andǝ nggeamùr, andǝ agir mǝnana aɓalǝia kat ka. Pǝlǝa mǝturonjar na ama, &lt;&lt;Pwari pà kàm ɗǝm ɗàng! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />Ɓǝ̀ tongno-nong-ɓaria mǝturonjar twang njawe male ka, gìr mǝnana Ɓakuli kanì nǝ̀ pè sǝ à sǝmbǝrǝ ce ka, nǝ̀ yia lùmsǝo. Nǝ̀ yia puro kǝla mǝnana bangŋi a banfana aban aguro, amǝ'ɓangnǝa male ka.&gt;&gt;<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />Pǝlǝa ɓwa mǝnana ǝn ok gì nacau nǝ kuli ka, nam cau ɗǝm ama, &lt;&lt;Kyane kya ak mǝ'malǝmce mǝno à mǝnni a bù mǝturonjar mǝnana came amúr nggeamùr andǝ kwàrban ngga.&gt;&gt;<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />Nda ǝn wari aban mǝturonjar sǝ ǝn ne wi nǝma ɓǝ̀ pàm mǝ'malǝmce mǝkyauwe nì ka. Pǝlǝa banggàm ama, &lt;&lt;Ang, twali shè. Awu nǝ oè pǝlpǝl a kuno kǝla mùr-nyì, sǝ ɓǝ̀ a mealǝni ka, nǝ̀ nggá pǝlǝ mǝhangŋe a bumo.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 2:8">Ezǝk 2:8</ref>; <ref loc="EZK 3:1-3">3:1-3</ref></char>.</note><verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />Pǝlǝa ǝn ak mǝ'malǝmce nî a bù mǝturonjar, sǝ ǝn she. Ən oe ka nda pǝlpǝl a kunam kǝla mùr-nyì, sǝ lang ǝn mealǝni ka, bumam twalo hangŋa. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />Sǝ nam ama, &lt;&lt;Dumǝna púp awu nǝ hamnǝ cau amur aɓwapǝndǝa, andǝ anzali, andǝ akún, andǝ amurǝma pas.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 1:10">Ir 1:10</ref></char>.</note><verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">Amǝ'nakún ɓari mala <optbreak /> Ɓakuli nǝ hamnǝ cau male</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />Sǝ Ɓakuli pam munagara kārǝki sauwa mala gìr, sǝ nam ama, &lt;&lt;Kyane kya kārǝki ɓá Ndàmǝgule mala Ɓakuli andǝ gyangŋan paɓoro, sǝ wu ɓal aɓwana mǝnana à kǝ peri aɓa Nda ka.<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 40:3">Ezǝk 40:3</ref></char>.</note> <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />Sǝama banfana mǝnana a nza nǝ Ndàmǝgule, à kàrì nǝ sheran ngga, cè a kārǝki ɗàng, acemǝnana ban nì ka à pànî aɓwana mǝnana à súrǝ̀ Ɓakuli raka. Yià ka, Urǝshalima, nggea-là mǝfele nǝ̀ kpa aɓa rǝcandǝa malea, à nǝ̀ parki, arǝ azongŋo lumi-ine-nong-ɓari.<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 12:3">Zak 12:3</ref>; <ref loc="ISA 63:18">Isha 63:18</ref>; <ref loc="LUK 21:24">Luk 21:24</ref></char>.</note> <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />Sǝ mǝ nǝ pè amǝ'nakún mem mǝnia ɓari ka rǝcandǝa, à nǝ̀ twal anonggio mǝno á-mwashat nǝ gbǝman-ɓari nǝ́ lumi-tongno-nong-mwashat ka (1,260), à nǝ̀ nggǝ hamnǝ cau mala Ɓakuli, nǝ́ anggubyau gwado a rǝia.&gt;&gt; <verse eid="REV 11:3" /><verse number="4" style="v" sid="REV 11:4" />Yià mǝnia ka, à nda ka anggun olif ɓari andǝ apitǝla ɓari mǝnana à cam a ɓadǝm Mǝtala ɓanza ka.<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 4:3">Zak 4:3</ref>,<ref loc="ZEC 4:11-14">11-14</ref></char>.</note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />Ɓǝ̀ kǝ ɓwa earce ama nǝ̀ pakkia wia gìr mǝɓane ka, bǝsa kǝ puro aɓa kunia kǝ twalta aɓia-mǝbura. Anggo sǝ ɓwa mǝnana kat earce nǝ̀ pakkia wia kǝgìr mǝɓane ka, she nǝ̀ wu.<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 1:10">2Amur 1:10</ref>; <ref loc="JER 5:14">Ir 5:14</ref></char>.</note> <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />À ndanǝ rǝcandǝa amur bumkuli, à nǝ̀ tamsǝ mbulo pà nǝ̀ nya ɗang. Sǝ à ndanǝ rǝcandǝa mala tsǝk amúr arǝ aban kat ɓǝà pǝlǝ nkila. Ɗǝm ngga à ndanǝ rǝcandǝa mala kwak ɓanza nǝ koya ulang agir mur'mwana, sǝ à nǝ̀ gandǝ ɓǝsǝlǝki pe kǝla mǝnana à earce ka.<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 17:1">1Amur 17:1</ref>; <ref loc="EXO 7:17">Pur 7:17</ref>,<ref loc="EXO 7:19">19</ref></char>.</note><verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />Anzǝm mǝnana ɓǝà malǝna nakún malea ka, nyamɓikea mǝnana nǝ̀ puro aɓa tūli-tàtǝkǝtè ka, nǝ̀ yiu nǝ lwa-lwa a rǝia, nǝ̀ gandǝia sǝ nǝ̀ wal-luia.<note caller="+" style="f"><char style="fr" closed="false">11:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:3">Dan 7:3</ref>,<ref loc="DAN 7:7">7</ref>,<ref loc="DAN 7:21">21</ref></char>.</note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />Luia nǝ̀ nongŋo amur njargula aɓa nggea-là mǝnana a kún-ndunocau ka à tunǝi ama Sodom andǝ Masar, sǝ akàm gbal sǝ à gbàllì Mǝtalea amur nggun-gangndǝi ka.<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 1:9">Isha 1:9</ref></char>.</note> <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />Nǝ̀ twal nongŋo tàrú nǝ tsùrú, aɓwana arǝ a koya la, andǝ koya tàu, andǝ koya kún, andǝ koya ɓwapǝndǝa ka, à nǝ̀ nggǝ sǝn luia aban nongŋo, acemǝnana à eari kǝɓwa ɓǝ̀ tsǝia a ɓembe raka. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />Aɓwana a ɓanza ka, ban nǝ ɓoaria wia ace gìr mǝnana kum amǝ'nakún mǝnia ɓari ka. À nǝ̀ pakkiɗire sǝ à nǝ̀ turia rǝia ban nǝ́ aɓoro acemǝnana yià amǝ'nakún mǝnia ɓari ka, à nda à yinǝia aɓwana a ɓanza tanni mǝɓike kǝ̀rkǝ́r ka.<verse eid="REV 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11" />Sǝ anzǝm anongŋo mǝno tàrú nǝ tsùrú ka, Ɓakuli pyaupia wia lin'ueo mǝ'pa yilǝmui a rǝia. À lo à cam amur akusǝia; sǝ aɓwana mǝnana kat à kǝ sǝnia ka, nggea ǝn'ò bwalia kǝ̀rkǝ́r.<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 37:5">Ezǝk 37:5</ref>,<ref loc="EZK 37:10">10</ref></char>.</note> <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />Pǝlǝa giu mǝcandǝe pur nǝ kuli tunǝ amǝ'nakún mǝnia ɓari ka ama, &lt;&lt;Wu yiu kani a kùli!&gt;&gt; Sǝ à lo aban eauwe a kùli aɓa pǝrɓang. Aɓia-mǝbura soapia wia mǝsǝu à kǝ sǝnia.<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 2:11">2Amur 2:11</ref></char>.</note><verse eid="REV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13" />Aɓa kǝ bu-pwari mǝno ka, nggea dǝurǝo mala nzali mǝ'kǝ̀rkǝ́r nì kumban, mǝnana kiɗiki banì mwashat aɓa gauwe lum mala nggea-là, sǝ wal ɓwapǝndǝa á-tongno-nong-ɓari (7,000) ka. Cili ɓwapǝndǝa ka, ɓangciu pakkia wia kǝ̀rkǝ́r sǝ à ɓwangsǝ gulo mala Ɓakuli mǝnana a kùli ka.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />Ɓaria gìr mur'mwana kutina, sǝ tàruià gìr mur'mwana nda kǝ yiu atè tù ka!<verse eid="REV 11:14" /></para>
  <para style="s">Tongno-nong-ɓaria <optbreak /> twang njawe yiu nǝ <optbreak /> tàruià gìr mur'mwana</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />Pǝlǝa tongno-nong-ɓaria mǝturonjar twang njawe male, kara agiu lo kǝ̀rkǝ́r a kùli à kǝ na ama,</para>
  <para style="q1" vid="REV 11:15">&lt;&lt;Agara-murǝm mala</para>
  <para style="q2" vid="REV 11:15">ɓanza man ngga</para>
  <para style="q1" vid="REV 11:15">à nyarǝna a ɓá bu</para>
  <para style="q2" vid="REV 11:15">Mǝtala sǝm andǝ</para>
  <para style="q2" vid="REV 11:15">ɓá bu Kǝrǝsti male.</para>
  <para style="q1" vid="REV 11:15">Sǝ domurǝm male ka</para>
  <para style="q2" vid="REV 11:15">masǝlǝate pà kàm ɗàng!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:28">Ang 22:28</ref>; <ref loc="DAN 7:14">Dan 7:14</ref>,<ref loc="DAN 7:27">27</ref></char>.</note><verse eid="REV 11:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="REV 11:16" />Sǝ aɓwana-mǝgule lumi-ɓari-nong-ine, mǝnana à ndaban do amur abuno-murǝm a ɓadǝm Ɓakuli ka, à kpa a nzali, sǝ à peri a ban Ɓakuli. <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />À na ama,</para>
  <para style="q1" vid="REV 11:17">&lt;&lt;We Ɓakuli Mǝtalabangŋo</para>
  <para style="q2" vid="REV 11:17">mana a Karmur Gulo kat,</para>
  <para style="q1" vid="REV 11:17">we mǝnana a nda kam ado,</para>
  <para style="q2" vid="REV 11:17">andǝ mǝnana nda</para>
  <para style="q1" vid="REV 11:17">kam ɗiɗyal ka,</para>
  <para style="q2" vid="REV 11:17">sǝm nggǝ pakko yàwá,</para>
  <para style="q1" vid="REV 11:17">acemǝnana a angŋǝna</para>
  <para style="q2" vid="REV 11:17">rǝcandǝa mò mǝgule,</para>
  <para style="q1" vid="REV 11:17">sǝ a tinata mò yì yálban</para>
  <para style="q2" vid="REV 11:17">amur agir.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />Aɓwana arǝ anzali</para>
  <para style="q2" vid="REV 11:18">pak bumlulla,</para>
  <para style="q1" vid="REV 11:18">sǝ ado gbal ka,</para>
  <para style="q2" vid="REV 11:18">pwari mala bumlulla</para>
  <para style="q2" vid="REV 11:18">mò yina.</para>
  <para style="q1" vid="REV 11:18">Pwari pàngŋǝ̀nà</para>
  <para style="q2" vid="REV 11:18">mǝnana awu nǝ pakki</para>
  <para style="q2" vid="REV 11:18">alú ɓashi nǝi ka.</para>
  <para style="q1" vid="REV 11:18">Sǝ aguro mò,</para>
  <para style="q2" vid="REV 11:18">amǝ'ɓangnǝa ka,</para>
  <para style="q1" vid="REV 11:18">awu nǝ peà wia</para>
  <para style="q2" vid="REV 11:18">tangnakusǝia,</para>
  <para style="q1" vid="REV 11:18">andǝ aɓwana mô</para>
  <para style="q2" vid="REV 11:18">amǝfele,</para>
  <para style="q1" vid="REV 11:18">andǝ aɓwana kat,</para>
  <para style="q2" vid="REV 11:18">ɓwa mǝkyauwe andǝ</para>
  <para style="q1" vid="REV 11:18">ɓwa mǝgule,</para>
  <para style="q2" vid="REV 11:18">amǝnana à kǝ ɓanggo</para>
  <para style="q2" vid="REV 11:18">aɓa pagulo ka.</para>
  <para style="q1" vid="REV 11:18">Pwari yina mǝnana</para>
  <para style="q2" vid="REV 11:18">awu nǝ kiɗiki aɓwana</para>
  <para style="q1" vid="REV 11:18">mǝnana à kǝ kiɗiki</para>
  <para style="q2" vid="REV 11:18">ɓanza ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 2:1">Ang 2:1</ref></char>.</note><verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />Pǝlǝa à mǝn kun Ndàmǝgule mala Ɓakuli mana a kùli ka, sǝ Akwati Kùrcau male ka à sǝni kàm aɓa Ndàmǝgule.<note caller="+" style="f"><char style="fr" closed="false">11:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 8:1-6">1Amur 8:1-6</ref></char>.</note> Kara tǎlaban liki'nzama, ban gǝggǝli, mgbarangce sàkkya, nzali dǝurǝkio, sǝ mǝsǝtali-mbulo mǝgulke ra.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">Ɓwama ɓǝl muna sǝ <optbreak /> Dǝragon ama nǝ̀ wal-luí</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />Pǝlǝa ɓè nggea gir'lǝmdǝa mǝ'pa ndali pusǝrǝi a kùli. Ɓè ɓwama na oasǝ pwari arǝì nda agir-nggūrǝu male, sǝ tamsǝ akusǝi amur zongŋo. À oasǝi wi jeko<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fq" closed="false">jeko: </char><char style="ft" closed="false">Ulang mala amǝ Gǝrik.</char></note> a ɓamúrí mǝnana ndanǝ anlero lum-nong-ɓari arǝì ka.<figure style="fig" alt="A wreath on one's head." file="bk00157c.tif" size="col" loc="REV 12:1" copy="Knowles images" ref="12:1">Jeko amur ɓwa</figure> <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />Ɓwame gongŋǝna, malanǝ̀ gbáshí, sǝ kwanban andǝ tanni mala gbáshí ka, tsǝì kǝ ɓua.<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MIC 4:10">Mik 4:10</ref></char>.</note><verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />Nyare ɓè gir'pandali mǝgule pusǝrǝi a kùli. Kaɓa ɓè nggea Dǝragon mǝbangŋe na, ndanǝ aɓamuri tongno-nong-ɓari andǝ anjawe lum, sǝ amur koya ɓamúrí ka ndanǝ sukuru-murǝm kàm.<note caller="+" style="f"><char style="fr" closed="false">12:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:7">Dan 7:7</ref></char>.</note> <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />Yì Dǝragon ngga, wuli nggilate pwan banì mwashat aɓalǝ agauwe tàrú mala anlero mǝnana a kùli ka, rangsǝia a ɓanza. Sǝ yi came a ɓadǝm ɓwama mǝno kǝ gbashí ka, ace mǝnana ɓǝ̀ gbashína ani ka nǝ̀ shak muni.<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 8:10">Dan 8:10</ref></char>.</note> <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />Ɓwame gbáshí muna-ɓwabura mǝnana nǝ̀ yál aɓwana kat a ɓanza nǝ gara bolo ka. Sǝ muna ka, Ɓakuli fwê, twali um nǝi a baní, kya dumsǝi atè amur buno-murǝm male.<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:7">Isha 66:7</ref>; <ref loc="PSA 2:9">Ang 2:9</ref>; <ref loc="PSA 110:1">110:1</ref></char>.</note> <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />Ɓwame ɓangŋa, o a ɓabondo, a ban mǝnana Ɓakuli gilǝkini wi nǝ̀ tsǝkiri kàm aɓalǝ anonggio á-mwashat nǝ́ gbǝman-ɓari nǝ́ lumi-tongno-nong-mwashat ka [1,260].<verse eid="REV 12:6" /></para>
  <para style="s">Makel lo munǝo arǝ Dǝragon</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />Pǝlǝa munǝo lo a kùli. Ɓè gbani mǝturonjar mala Ɓakuli, yì Makel ka, lo andǝ amǝturonjar mǝnana atè ka sǝ à soa munǝo arǝ Dǝragon; sǝ Dǝragon andǝ amǝturonjar male gbal ka, à oa munǝo a rǝia<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 10:13">Dan 10:13</ref></char>.</note>. <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />Sǝ Dǝragon ngga munǝo gandǝi. Yì andǝ amǝturonjar male ka, à ɗwanyi bancame malea a kùli. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />Nda à ramta mǝnia yì nggea kaɓǝne Dǝragon, mǝno yì share n'yau mǝnana à tunǝki ama Mǝɓealɓikea sǝ Shetan, mǝnana kǝ swarkita aɓwana kat aɓa ɓanza ka. Yì Dǝragon andǝ amǝturonjar male kat ka, à ramtea a kùli à yì kpa a nzali a ɓanza!<note caller="+" style="f"><char style="fr" closed="false">12:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 3:1">Tite 3:1</ref>,<ref loc="GEN 3:14-15">14-15</ref>; <ref loc="ZEC 3:1">Zak 3:1</ref></char>.</note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />Pǝlǝa ǝn ok ɓeɓwa a kùli loasǝ gi kǝ̀rkǝ́r bang cau ama:</para>
  <para style="q1" vid="REV 12:10">&lt;&lt;Adyan ngga, amsǝban</para>
  <para style="q2" vid="REV 12:10">andǝ rǝcandǝa,</para>
  <para style="q2" vid="REV 12:10">andǝ Domurǝm mala</para>
  <para style="q1" vid="REV 12:10">Ɓakuli ma'sǝm,</para>
  <para style="q2" vid="REV 12:10">andǝ gara-murǝm mala</para>
  <para style="q1" vid="REV 12:10">Kǝrǝsti male ka, à yina!</para>
  <para style="q1" vid="REV 12:10">Acemǝnana mǝ'yinǝ</para>
  <para style="q2" vid="REV 12:10">acauɓashi</para>
  <para style="q1" vid="REV 12:10">amur amǝ'eam sǝm,</para>
  <para style="q2" vid="REV 12:10">mǝnana kǝ oasǝkimuria,</para>
  <para style="q2" vid="REV 12:10">a ɓadǝm Ɓakuli ma'sǝm,</para>
  <para style="q1" vid="REV 12:10">du andǝ pwari ka,</para>
  <para style="q2" vid="REV 12:10">à ramǝna tè a ɓanza!<note caller="+" style="f"><char style="fr" closed="false">12:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOB 1:9-11">Ayu 1:9-11</ref></char>.</note><verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />À limurǝm amurí</para>
  <para style="q2" vid="REV 12:11">nǝ nkila mala Mǝgam,</para>
  <para style="q1" vid="REV 12:11">andǝ nakún malea</para>
  <para style="q2" vid="REV 12:11">nǝ mǝsǝcau</para>
  <para style="q1" vid="REV 12:11">amur Mǝgam</para>
  <para style="q2" vid="REV 12:11">a ɓadǝmbǝ aɓwana;</para>
  <para style="q1" vid="REV 12:11">yia ka à eare</para>
  <para style="q2" vid="REV 12:11">à pa yilǝmia,</para>
  <para style="q1" vid="REV 12:11">à nyar nǝ tea ɗàng</para>
  <para style="q2" vid="REV 12:11">yi pur a lú malea.<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />Ace mǝno ka,</para>
  <para style="q2" vid="REV 12:12">pak banɓoarnado,</para>
  <para style="q2" vid="REV 12:12">We kùli!</para>
  <para style="q1" vid="REV 12:12">Sǝ wun mǝnana kat</para>
  <para style="q2" vid="REV 12:12">wu do a kùli ka,</para>
  <para style="q1" vid="REV 12:12">wu pak banɓoarnado!</para>
  <para style="q1" vid="REV 12:12">Sǝ mala nzali andǝ</para>
  <para style="q2" vid="REV 12:12">nggeamùr ka,</para>
  <para style="q1" vid="REV 12:12">gìr'mur'mwana amur wun,</para>
  <para style="q2" vid="REV 12:12">acemana Mǝɓealɓikea,</para>
  <para style="q1" vid="REV 12:12">yì Shetan ngga,</para>
  <para style="q2" vid="REV 12:12">sulǝna a ban wun.</para>
  <para style="q1" vid="REV 12:12">Lùmsǝ nǝ bumlulla kǝ̀rkǝ́r,</para>
  <para style="q2" vid="REV 12:12">acemǝnana sǝlǝna ama</para>
  <para style="q1" vid="REV 12:12">pwari ueki wi bǝti.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 44:23">Isha 44:23</ref>; <ref loc="ISA 49:13">49:13</ref></char>.</note><verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />Lang Dǝragon sǝni à ramna tè kpana a ɓanza ka, pǝlǝa lo pǝrta ɓwama mǝno, mǝnana ɓǝl muna-ɓwabura ka. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />Sǝ ɓwama ka, Ɓakuli pe wi abu-nyál ɓari mala nggea nkwang mǝgule ɓǝ̀ yàle ɓǝ̀ o a ban mǝnana à gilǝki wi a ɓabondo ka; akanó ka, à nǝ̀ tsǝkiri pǝlǝa tàrú nǝ tsùrú, Dǝragon pà nǝ̀ gandǝ kumi ɗang.<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:25">Dan 7:25</ref>; <ref loc="DAN 12:7">12:7</ref></char>.</note> <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />Dǝragon pǝlǝa mǝn kúni polǝ mùr-gùla atà ɓwama ace mǝnana ɓǝ̀ mùr ɓǝ̀ kya pwani ɓǝ̀ um nǝi ka. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />Sǝ nzali ka bwalì ɓwama kàm; nzali mǝn kúni sonzǝ mùr nggeasala mǝnana Dǝragon polǝi ka. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />Gìr mǝnia ka pè Dǝragon bumlulla kǝ̀rkǝ́r arǝ ɓwama man. Nda nyare o nǝ̀ ká munǝo arǝ cili amuna mala ɓwame, yia aɓwana mǝnana kat à kǝ kpata anzongcau mala Ɓakuli, sǝ à duk amǝ nakún Yesu nǝ mǝsǝcau ka. <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />[Dǝragon pǝlǝa yi came a sala a kun nggeamùr.]<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">Nyamɓikea mǝnana puro <optbreak /> aɓa nggeamùr ka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />Sǝ ǝn sǝn ɓekǝ nyamɓikea aban puro aɓa nggeamùr. Ndanǝ aɓamuru tongno-nong-ɓari andǝ anjawe lum. Amur koya njawe male ka sukuru-murǝm nda kam, sǝ arǝ koya ɓamúrí ka lullǝu na kam à gilǝì, sǝ koya lullǝu ka cau ɓǝsǝkiban na arǝ Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:1-6">Dan 7:1-6</ref></char>.</note> <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />Mǝnia yì nyamɓikea ǝn sǝni ka, nda kǝla mǝmburi. Akusǝi na kǝla akusǝ nyam-bondo mǝnana à tunǝki ama biya, sǝ kúni na kǝla kun im. Dǝragon nyesǝ rǝcandǝa male, andǝ buno-murǝm male, andǝ gara-murǝm male pe wi.<figure style="fig" alt="Bear" file="lb00048c.tif" size="col" loc="REV 13:2" copy="Knowles images" ref="13:2">Biya</figure> <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />Mwashat atà aɓamur nyamɓikea man ngga pa kǝla à tsǝki wi mpenye mǝnana ɓǝ́ nǝ̀ wal-luí, sǝ mpenyeni yì sonzǝ ka. Ɓanza kat pu aban ká atè nǝ ndali. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />Ɓwapǝndǝa peri aban Dǝragon, acemǝnana nyesǝ gara-murǝm male pe nyamɓikea ka; nyare à peri aban nyamɓikea, sǝ à kǝ na ama, &lt;&lt;Yana ɓwe na kǝla yì nyamɓikea? Yana ɓwe na nǝ̀ gandǝ ká nǝ lwa arǝì?&gt;&gt; <verse eid="REV 13:4" /><verse number="5" style="v" sid="REV 13:5" />Yì nyamɓikea ka à eari wi kutia banggi acau twàlɓamúrû andǝ ɓǝsǝki Ɓakuli, sǝ ɓǝ̀ pakkia agir mala lǝmdǝ rǝcandǝa mǝnana à pe wi ka, bà zongŋo lumi-ine-nong-ɓari.<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:8">Dan 7:8</ref></char>.</note> <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />Mǝn kúni aban kyauwiki Ɓakuli andǝ na mǝɓane arǝ lùllǝì, andǝ ban-do mala Ɓakuli, andǝ aɓwana mǝnana à do a kùli ka. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />À nyinggi wi njar ɓǝ̀ lwa'lwa arǝ aɓwana mǝfele mala Ɓakuli, sǝ ɓǝ̀ limurǝm amúrià. Sǝ à pe wi rǝcandǝa amur koya tàu, andǝ kun, andǝ aɓwapǝndǝa, andǝ nzali.<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:21">Dan 7:21</ref></char>.</note> <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />Aɓwana mǝnana kat à do a ɓanza ka, à nǝ̀ peri aban nyamɓikea, yì aɓwana mǝnana tite a share ɓanza ka, lullǝia pà kàm a gilǝe aɓa Malǝmce raka, yì Malǝmce Yilǝmu mala Mǝgam<note caller="+" style="f"><char style="fr" closed="false">13:8 </char><char style="fq" closed="false">Malǝmce Yilǝmu mala Mǝgam</char><char style="ft" closed="false">ngga, nda malǝmce mǝnana, tite a share ɓanza yi pur ado mǝno ka, Yesu Kǝrǝsti, mǝnana sukki nkile ace lak acauɓikea mala aɓwana ka, kǝ oasǝkia alullǝ aɓwana kam mǝnana à nǝ̀ pea wia yilǝmu mǝnana málá male pà kàm raka.</char></note> mǝnana à pwan-myali ka.<verse eid="REV 13:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="REV 13:9" />Ɓwa mǝnana kat</para>
  <para style="q2" vid="REV 13:9">ndanǝ kir okban ngga</para>
  <para style="q2" vid="REV 13:9">ɓǝ̀ o.<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 4:23">Mar 4:23</ref></char>.</note><verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />&lt;&lt;Ɓwa mǝnana kat à</para>
  <para style="q2" vid="REV 13:10">kasǝi wi bwalban</para>
  <para style="q1" vid="REV 13:10">a guro ka,</para>
  <para style="q2" vid="REV 13:10">à nǝ̀ bwali nǝ̀ o a guro.</para>
  <para style="q1" vid="REV 13:10">Ɓwa mǝnana kat</para>
  <para style="q2" vid="REV 13:10">à kasǝi wi wal-luí</para>
  <para style="q1" vid="REV 13:10">nǝ nggeabyau ka,</para>
  <para style="q2" vid="REV 13:10">nǝ nggeabyau sǝ</para>
  <para style="q2" vid="REV 13:10">à nǝ̀ walì.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 15:2">Ir 15:2</ref>; <ref loc="JER 43:11">43:11</ref></char>.</note></para>
  <para style="m" vid="REV 13:10">Mǝnia ka kwarkiru na ace aɓwana amǝ'mǝsǝcau nì mala Ɓakuli, ɓǝà cam kàngkàng sǝ ɓǝà dum nǝ paɓamuru a baní aɓa koya tanni ka.<verse eid="REV 13:10" /></para>
  <para style="s">Ɓè Nyamɓikea mǝnana <optbreak /> pur a nzali ka</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />Pǝlǝa ǝn sǝn ɓè nyamɓikea aban puro nǝ ɓá nzali. Ndanǝ anjawe ɓari kǝla mala gam, sǝ kǝ nacau kǝla dǝragon. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />Kǝ lǝmdǝ rǝcandǝa mala nyamɓikea mǝdǝmbe. Tsǝk ɓanza andǝ aɓwana mǝnana nǝ do aɓalǝi ka púp ɓǝà peri aban nyamɓikea mǝdǝmbe mǝno mpenye mǝɓike male sonzǝ ka. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />Mǝnia yì nyamɓikea ka, pakki agir-ndali mǝgulke; kǝ tsǝa bǝsa nǝ̀ pur a kùli aban yiu a nzali a mǝsǝ aɓwana kat. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />Nǝ agir-ndǝlǝki mǝnana à eari wi ɓǝ̀ pea a ɓadǝm nyamɓikea mǝdǝmbe ka, twalo swarki aɓwana mǝnana kat à nda ka amǝkpata ɓanza man ngga. Cia ɓǝà ɓak ɓǝ̀nzál mala nyamɓikea mǝdǝmbe mǝnana à tsǝki wi mpenye nǝ nggeabyau ɓǝ́ nǝ̀ wal-luí sǝ yi au ka.<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 13:1-5">Nggur 13:1-5</ref></char>.</note> <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />Mǝnia yì ɓaria nyamɓikea ka kum rǝcandǝa mala pe ɓǝ̀nzál mala nyamɓikea mǝdǝmbe yilǝmu ace mǝnana ɓǝ̀ gandǝ nacau ka. Pǝlǝa ɓǝ̀nzál mala nyamɓikea tsǝa ama ɓwa mǝnana kat ɓinǝe ama pà nǝ̀ peri a baní raka, ɓǝà wal-luí. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />Tsǝk koyana le ka, ɓwa mǝkyauwe andǝ ɓwa mǝgule, amǝkume andǝ amǝ'tǝ̀r, aguro andǝ aɓwana mǝnana à ndanǝ do ɓamuria ka, ɓǝà canbia wia nyoulǝa anzǝm buia mǝlì ko a kundǝmbǝia. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />Ɓwa mǝnana kat panǝ mǝnia yì nyoulǝa raka à eari wi ɓǝ̀ kúr kǝgìr ko ɓǝ̀ mak kǝgìr ɗang. Mǝnia yì nyoulǝa ka, lullǝu mala nyamɓikea na, ko lámbà mala lùllǝì na. <verse eid="REV 13:17" /><verse number="18" style="v" sid="REV 13:18" />Aɓa mǝnia ka, sǝlǝe na à kǝ̀ earce ɓwa ɓǝ̀ dum nǝi ka. Ɓwa mǝnana kwarô sǝ nǝ̀ pak ɗenyicau mǝlime ka, ɓǝ̀ kwam ɓá mǝnia yì lámbà mala nyamɓikea ka, ɓǝ̀ bwalte, acemǝnana lambe ka, lámbà mala ɓwapǝndǝa na. Lámbà male ka nda gbǝman tongno-nong-mwashat, nǝ lumi-tongno-nong-mwashat, nǝ mǝsǝì tongno-nong-mwashat [666].<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">Mǝgam andǝ amǝtè <optbreak /> 144,000 tu-nggyal <optbreak /> a ɓadǝm buno-murǝm</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />Lang ǝn soa mǝsǝam ngga, ǝn sǝn Mǝgam aban came amur Nkono Siyona andǝ aɓwana á-gbǝman mwashat nǝ á-lumi-ine bwamdǝ ine [144,000] atè, aɓwana mǝnana à gilǝnia wia lùllǝì andǝ lullǝ Tárrí a kundǝmbǝia ka.<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 9:4">Ezǝk 9:4</ref></char>.</note> <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />Pǝlǝa ǝn ok giu pur nǝ kuli, pàkkam kǝla gǝshi gǝggǝli mala nggeamùr aɓa songnǝo male, ko kǝla ime mala mbulo. Ən ok giu nî ka, nda kǝla amǝ walki azangŋan aban walki azangŋan malea. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />Aɓwana mǝno á-gbǝman mwashat nǝ á-lumi-ine bwamdǝ ine ka, à ndarǝ tu bǝsa nggyal a ɓadǝm buno-murǝm, andǝ ɓadǝm agir-yilǝmu ine andǝ aɓwana-mǝgule. Kǝ ɓwa pà kàm gandǝ kani mǝno yì nggyal ka ɗang, shekǝ yia mǝno á-gbǝman mwashat nǝ á-lumi-ine bwamdǝ ine, mǝnana à akmúria aɓa ɓanza ka. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />À nda ka aɓwana mǝnana à pǝndǝki ɓamuria nǝ nongginǝ amamǝna raka. À bwal ɓamuria aɓa doɓoarnsari, kǝla ansarina mǝnana à súrǝ̀ kǝ ɓwabura raka. À kǝ kpata Mǝgam arǝ aban mǝnana kat kǝ wari kam ngga. Ɓakuli akmúria aɓalǝ acili ɓwapǝndǝa a ɓanza ɓǝà do à nda ka ɓǝlagir mǝdǝmbe mǝnana à nǝ̀ pànà ɓoro nǝia aban Ɓakuli andǝ Mǝgam ngga. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />À súrǝ̀ia nǝ kǝ nyir a kunia ɗàng. Amǝ ɗwanyicau-arǝǔ na.<verse eid="REV 14:5" /></para>
  <para style="s">Amǝturonjar tàrú yiu nǝ <optbreak /> acau hama mala Ɓakuli</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />Pǝlǝa ǝn sǝn ɓè mǝturonjar mala Ɓakuli aban yale ɓong-ɓong a bumkuli. Ndarǝ yiu nǝ Cau Amsǝban mǝnana masǝlǝate pà kàm raka, ace mǝnana nǝ̀ yia hamnǝi a ban aɓwana a ɓanza, a ban koya nzali, andǝ koya tàu, andǝ koya kún, andǝ koya ɓwapǝndǝa ka. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />Pǝlǝa loasǝ gì kpǝm hama ama, &lt;&lt;Wu ɓanggi Ɓakuli, sǝ wu pe wi gulo! Acemǝnana pwari ɓashi male yina. Wu peri a baní, yì ɓwa mǝnana pusǝ kuli, andǝ nzali, andǝ nggeamùr, andǝ amáɗí-mùr ka.&gt;&gt;<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />Pǝlǝa ɓaria mǝturonjar kpata mǝno sǝ kǝ na ama, &lt;&lt;Nggea-là mǝgule Babila ka kpana, yì ɓwama mǝnana tsǝk aɓwana arǝ anzali ɓanza à nu mùr-anap mala npel mala kìɗìkì nongginǝ rǝarǝu male ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 21:9">Isha 21:9</ref></char>.</note><verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />Pǝlǝa tàruià mǝturonjar kpatea, aban hama nǝ giu bangbang. Kǝ na ama: &lt;&lt;Ɓwa mǝnana kat peri a ban nyamɓikea andǝ ɓǝ̀nzál male, sǝ ak nyoulǝa male a kundǝmbǝi ko a nzǝmbui ka, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ɓwe gbal ka nǝ̀ nu mùr-anap mala bumlulla mala Ɓakuli. Yì bumlulla mala Ɓakuli mǝnana à solǝi andǝa lúllô male mǝcandǝe aɓa kwar bum-ukkia male ka. Sǝ ɓwe nǝ̀ nu nggea tanni kǝ̀rkǝ́r aɓa bǝsa andǝ atalibǝsa, a ɓadǝmbǝ amǝturonjar mǝfele andǝ ɓadǝm Mǝgam.<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:7">Ir 51:7</ref>; <ref loc="GEN 19:24">Tite 19:24</ref></char>.</note> <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />Yele-bǝsa ɓá tanni malea ka, nǝ̀ nggǝ lo aban ká kùli, pà nǝ̀ mal ɗang. Sǝ à pà nǝ̀ kum usǝlǝo ɗang du andǝ pwari, yia aɓwana mǝnana à peri a ban nyamɓikea andǝ ɓǝ̀nzál male, andǝ ɓwa mǝnana kat ak nyoulǝa mala lùllǝì ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 34:10">Isha 34:10</ref></char>.</note> <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />Mǝnia ka kwarkiru na ace aɓwana amǝ'mǝsǝcau nì mala Ɓakuli, yia mǝnana à kǝ kpata anzongcau mala Ɓakuli, sǝ à dum nǝ mǝsǝcau a ban Yesu ka, ɓǝà cam kàngkàng nǝ gandǝrǝu.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />Pǝlǝa ǝn ok ɓè giu pur nǝ kuli kǝ na ama, &lt;&lt;Gilǝ cau mǝnia ka:</para>
  <para style="q1" vid="REV 14:13">&lt;&lt; &lt;Twal ado aban ká dǝmba ka,</para>
  <para style="q2" vid="REV 14:13">tsǝkbu mala Ɓakuli na</para>
  <para style="q1" vid="REV 14:13">amur aɓwana mǝnana</para>
  <para style="q2" vid="REV 14:13">à wu aɓa dotarǝu</para>
  <para style="q1" vid="REV 14:13">malea andǝ</para>
  <para style="q2" vid="REV 14:13">Mǝtalabangŋo ka!&gt; &gt;&gt;</para>
  <para style="p" vid="REV 14:13">Bangŋo mala Ɓakuli kǝ na ama, &lt;&lt;E, mǝsǝtacau, à nǝ̀ kum usǝlǝo aɓalǝ atúró malea, acemǝnana atúró mǝɓoarne malea mǝnana à pea ka, à kǝ ongsǝô ateà.&gt;&gt;<verse eid="REV 14:13" /></para>
  <para style="s">Pwari pwan girɓaban <optbreak /> mala ɓanza yina</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />Mǝ nda rǝ sǝnban ngga, ǝn sǝn pǝrɓang mǝpwasǝe yi puro andǝ ɓeɓwa kǝla Muna mala Ɓwa aban do amurí. Ndanǝ jeko zǝnariya amurí sǝ bwal nshiri mǝceauwe a buì.<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:13">Dan 7:13</ref></char>.</note> <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />Pǝlǝa ɓè mǝturonjar mala Ɓakuli purî ɓá Ndàmǝgule mǝnana a kùli ka yi came. Loasǝ gi kpǝm ne ɓwa mǝno do amur pǝrɓang ngga ama, &lt;&lt;Pǝlǝ nshiri mô sǝ wu tita ùmó, acemǝnana pwari pwan ɓǝla-ɓaban yina. Ɓanza ka ɓǝlǝna a mala pwan ɓǝle!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 3:13">Jol 3:13</ref>; <ref loc="MAT 13:30">Mat 13:30</ref></char>.</note> <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />Pǝlǝa ɓwa mǝno do amur pǝrɓang ngga wuli nshiri male amur ɓanza, sǝ um girɓaban mala ɓanza rambi.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />Anzǝm mǝno ka, ɓè mǝturonjar mala Ɓakuli purî ɓá Ndàmǝgule mǝnana a kùli ka, sǝ yì gbal ka ndanǝ nshiri mǝceauwe a buì. <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />Nyar ɗǝm ngga ɓè mǝturonjar mǝnana nǝ rǝcandǝa amur bǝsa ka, purî ban gyangŋan yi came. Loasǝ gi bàng-bàng ne mǝturonjar mǝno nǝ nshiri mǝceauwe a buì ka, ama, &lt;&lt;Loasǝ nshiri mô, kasǝki adangŋanshi ɓǝla nggun-anap a ɓaban-anap mala ɓanza, acemǝnana aɓǝle ka, à ɓǝlna!&gt;&gt; <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />Pǝlǝa mǝturonjar wuli nshiri male amur ɓanza, kasǝki aɓǝla nggun-anap male, sǝ sukkia aɓa tūli ɓá nggea tali kamggi mùr-anap, yì tūli bumlulla mǝgule mala Ɓakuli. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />À parki amǝno yì aɓǝla nggun-anap ka aɓa yì tūli ɓá nggea tali kamnggigir, mǝnana nda anzǝm la ka. Nkila ɓun aɓa tūlî aban solǝo, kǝ ɓangŋa kǝla mùr nggeasala, o kya bik kilomita gbǝman tàrú,<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="fq" closed="false">kilomita gbǝman tàrú: </char><char style="ft" closed="false">ko mel gbǝman ɓari.</char></note> sǝ lime male ka nǝ̀ kongsǝ ɓamúr pǝ̀r mǝnana cam nǝ came ka.<note caller="+" style="f"><char style="fr" closed="false">14:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 3:13">Jol 3:13</ref></char>.</note><verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">Amǝturonjar tongno nong-ɓari <optbreak /> yinǝ masǝlǝata agir tanni-twal-là</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />Anzǝm mǝno ka, ǝn sǝn ɓe gir'lǝmdǝa mǝgule andǝ mǝ'pa ndali, puro a kùli. Amǝturonjar na yia tongno-nong-ɓari, mǝnana à ndanǝ masǝlǝata agir yinǝ tanni-twal-là, mǝnana à nǝ̀ yia lǝmdǝ masǝlǝata bumlulla mǝgule mala Ɓakuli nǝia ka.<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 26:21">Pǝris 26:21</ref></char>.</note> <verse eid="REV 15:1" /><verse number="2" style="v" sid="REV 15:2" />Nyare ǝn sǝn ɓe kǝgìr kǝla nggeamùr gǝlas mǝnana à zurǝi andǝ bǝsa ka. Sǝ ɗǝm ngga ǝn sǝn aɓwana mǝnana à limurǝm amur nyamɓikea andǝ ɓǝ̀nzál male andǝ lámbà mala lùllǝì ka, aban came a kún mǝno yì nggeamùr gǝlas ka. Ko yan ateà ka, bwal mǝzangŋan mǝnana Ɓakuli pè wi ka, a buì. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />À nda rǝ tu nggyal mala Musa, yì guro mala Ɓakuli, andǝ nggyal mala Mǝgam; à kǝ na ama:</para>
  <para style="q1" vid="REV 15:3">&lt;&lt;We, Mǝtalabangŋo Ɓakuli,</para>
  <para style="q1" vid="REV 15:3">mǝnana a Karmur Gulo</para>
  <para style="q2" vid="REV 15:3">kat ka,</para>
  <para style="q1" vid="REV 15:3">a pakki atúró mǝgulke</para>
  <para style="q2" vid="REV 15:3">andǝ agir pa'ndali.</para>
  <para style="q1" vid="REV 15:3">Atúró mô kat ka,</para>
  <para style="q2" vid="REV 15:3">a kǝ́ pea aɓa</para>
  <para style="q1" vid="REV 15:3">mǝsǝcau andǝ kpate</para>
  <para style="q2" vid="REV 15:3">a njarnì,</para>
  <para style="q1" vid="REV 15:3">We Murǝm mala anzali!<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 15:1">Pur 15:1</ref>; <ref loc="PSA 145:17">Ang 145:17</ref></char>.</note><verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />Yana ɓwe na pà nǝ̀</para>
  <para style="q2" vid="REV 15:4">ɓanggo raka?</para>
  <para style="q1" vid="REV 15:4">Yana ɓwe na nǝ̀ ginǝ</para>
  <para style="q2" vid="REV 15:4">pe lùllǝò gulo,</para>
  <para style="q1" vid="REV 15:4">We Mǝtalabangŋo?</para>
  <para style="q1" vid="REV 15:4">We nǝmurǝo ɓǝ̀rɓǝ̀r,</para>
  <para style="q2" vid="REV 15:4">a nda Mǝfele.</para>
  <para style="q1" vid="REV 15:4">Aɓwana arǝ anzali kat,</para>
  <para style="q2" vid="REV 15:4">à nǝ̀ yia peri</para>
  <para style="q1" vid="REV 15:4">a ɓadǝmbo,</para>
  <para style="q2" vid="REV 15:4">acemǝnana atúró</para>
  <para style="q1" vid="REV 15:4">ɓealɓoarna mô ka,</para>
  <para style="q2" vid="REV 15:4">à pusǝna rǝia.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 10:7">Ir 10:7</ref>; <ref loc="PSA 86:9-10">Ang 86:9-10</ref></char>.</note><verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />Anzǝm mǝnia ka, ǝn sǝni à mǝn Ndàmǝgule mala Ɓakuli, yì Taragula mǝfele mana akanó a kùli ka,<note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 40:34">Pur 40:34</ref></char>.</note> <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />sǝ amǝturonjar nì tongno-nong-ɓari mǝnana à ndanǝ agir yinǝ tanni-twal-là ka, à nda ban purî ɓālǝi. À oasǝki anggea-daura pwasǝa mana à teǎ nǝ nggubyau linǝn mǝɓoarnsari ka a rǝia, sǝ à marǝki abugir mǝnana à peǎ nǝ bolo-njengǝlan ka, a kikilia. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />Mwashat atà agir-yilǝmu nì ine ka, yiu yi pè koyan atà amǝturonjar mǝno tongno-nong-ɓari ka, tasau mǝnana a tùllì nǝ zǝnariya ka. Amǝnia yia atasau ka, à lumsǝkia nǝ bumlulla mala Ɓakuli mana ndanǝ yilǝmu, málá male pà kàm raka. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />Kara Ndàmǝgule twalo lùmsǝ nǝ yele, mǝnana pur nǝ ɓá ɓoarɓwa andǝ rǝcandǝa mala Ɓakuli ka.<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="fq" closed="false">mǝnana pur nǝ ɓá ɓoarɓwa andǝ rǝcandǝa mala Ɓakuli ka. </char><char style="ft" closed="false">Ko &lt;&lt;mǝnana lǝmdǝa ama Ɓakuli aɓa ɓoarɓwa andǝ rǝcandǝa male ka nda abanì.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 5:13-14">2Acau 5:13-14</ref>; <ref loc="1KI 8:10-11">1Amur 8:10-11</ref>; <ref loc="ISA 6:4">Isha 6:4</ref>; <ref loc="EZK 44:4">Ezǝk 44:4</ref></char>.</note> Kǝ ɓwa pà nǝ̀ gandǝ kutio aɓa Ndàmǝgule ɗàng she ɓǝà amǝno yì agir tongno-nong-ɓari màlà yìnǝ́ tanni-twal-là, mǝnana a bu amǝturonjar tongno-nong-ɓari, à malǝna ka.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">À solǝki bumlulla mǝgule <optbreak /> mala Ɓakuli mana <optbreak /> aɓalǝ atasau ka</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />Pǝlǝa ǝn ok giu mǝcandǝe pur nǝ ɓá Ndàmǝgule, aban banggi amǝturonjar mǝno tongno-nong-ɓari ka ama, &lt;&lt;Wu kyane, wu kya solǝki bumlulla mǝgule mala Ɓakuli, mǝnana aɓalǝ atasau tongno-nong-ɓari ka, amur ɓanza!&gt;&gt;<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />Nda mǝturonjar mǝdǝmbe puro wario kya solǝ gìr ɓá tasau male amur ɓanza, kara anggea npenye-gula amǝɓike andǝ amǝkwanbanì purkio arǝ aɓwana mǝnana à ndanǝ nyoulǝa mala nyamɓikea, sǝ à peri aban ɓǝ̀nzál male ka.<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 9:10-11">Pur 9:10-11</ref>; <ref loc="DEU 28:35">Nggur 28:35</ref></char>.</note><verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />Ɓárià mǝturonjar solǝ gìr ɓá tasau male amur nggeamùr, kara nggeamùr pǝlǝ nkila, kǝla nkila lú ɓwa, sǝ agir mǝnana kat nǝ yilǝmu aɓa nggeamùr ka, à wukio.<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 7:17-21">Ezǝk 7:17-21</ref></char>.</note><verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />Tàruia mǝturonjar solǝ gìr ɓá tasau male amur anggeasala andǝ amáɗí-mùr, sǝ à pǝlǝ nkila. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />Ən ok mǝturonjar mǝnana tsǝkiyikir amúr ka bang ama:</para>
  <para style="q1" vid="REV 16:5">&lt;&lt;A pángŋǝ̀nà pepè aɓa</para>
  <para style="q2" vid="REV 16:5">mǝnia yi aɓashi ka,</para>
  <para style="q1" vid="REV 16:5">we Mǝfele mǝnana</para>
  <para style="q2" vid="REV 16:5">a ndakam ado</para>
  <para style="q2" vid="REV 16:5">sǝ a ndakam ɗiɗyal ka!<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />Yia ka, à sukki nkila</para>
  <para style="q2" vid="REV 16:6">mala aɓwana mô amǝfele,</para>
  <para style="q2" vid="REV 16:6">andǝ mala amǝ'ɓangnǝa mô.</para>
  <para style="q1" vid="REV 16:6">Ace mani ka,</para>
  <para style="q2" vid="REV 16:6">a pania wia nkila ɓǝà nu.</para>
  <para style="q1" vid="REV 16:6">À nda rǝ kum tangnakusǝia</para>
  <para style="q2" vid="REV 16:6">arǝ gir mǝnana karǝ</para>
  <para style="q1" vid="REV 16:6">arǝia ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 79:3">Ang 79:3</ref></char>.</note><verse eid="REV 16:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="REV 16:7" />Sǝ ǝn ok giu pur nǝban gyangŋan ɗārǝâ na ama:</para>
  <para style="q1" vid="REV 16:7">E, Mǝtalabangŋo Ɓakuli</para>
  <para style="q2" vid="REV 16:7">mǝnana a Karmur Gulo</para>
  <para style="q1" vid="REV 16:7">Kat ka,</para>
  <para style="q2" vid="REV 16:7">aɓashi mò ka,</para>
  <para style="q1" vid="REV 16:7">amǝ'mǝsǝcau nì na,</para>
  <para style="q2" vid="REV 16:7">sǝ à nda pepè!<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 119:137">Ang 119:137</ref></char>.</note><verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />Inea mǝturonjar solǝ gìr ɓá tasau male amur pwari, sǝ pwari tita pisǝki aɓwana nǝ bǝsa. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />Ace ɓiki pisǝkiban mala pipwari amur aɓwana ka, à kutia naki acau mǝɓane arǝ lullǝ Ɓakuli mǝnana ndanǝ rǝcandǝa amur amǝnia yì agir yinǝ tanni-twal-là ka. À ginǝe à pà nǝ̀ pwanzali à nǝ̀ pǝlǝ nzǝmia arǝ acauɓikea malea, à nǝ̀ pè Ɓakuli gulo ɗang.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />Tongnoia mǝturonjar solǝ gìr ɓá tasau male amur buno-murǝm mala nyamɓikea. Kara pǝndǝa gir mur domurǝm male, sǝ aɓwana mǝnana aɓata domurǝm male ka, à nǝmnggi minǝia ace kwanban mǝnana sulǝo amúrià ka.<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 10:21">Pur 10:21</ref></char>.</note> <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />À kutia naki acau ɓǝsǝkiban arǝ Ɓakuli, yì murǝm kùli, àtàcau mala kwanban andǝ anpenye mǝnana kumia ka. Sǝ à ginǝ pwanzali amur agir mǝɓane mǝnana à pakkia ka.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />Tongno-nong-mwashatia mǝturonjar solǝ gìr ɓá tasau male amur nggeasala mǝgule mǝnana à tunǝki ama Yiufǝretis ka. Sǝ mùr mana aɓa mǝnia yì nggeasala ka, ime ace mǝnana amurǝma andǝ amǝ'lwa malea, amǝnana à nǝ̀ yiu nǝ njar-takuli ka, ɓǝà kum njar kutio.<note caller="+" style="f"><char style="fr" closed="false">16:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 11:15-16">Isha 11:15-16</ref></char>.</note> <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />Pǝlǝa ǝn sǝn abangŋo mǝɓane tàrú, amǝnana à nda kǝla anɗwalung ngga. Mwashat ka, puro a ɓakun dǝragon, ɓè ka puro a ɓakun nyamɓikea, sǝ ɓè man ngga puro a ɓakun mǝɓangnǝa mǝ'nyir nì.<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 22:21-23">1Amur 22:21-23</ref>; <ref loc="EXO 8:3">Pur 8:3</ref></char>.</note> <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />À nda ka abangŋo mala akukwar mǝnana à kǝ pakki agir-ndali ka. À purkio aban o aban amurǝma mala ɓanza kat, à nǝ̀ nggá rambia ace lwa arǝ Mǝtalabangŋo, a Pwari Mǝgule mala Ɓakuli mǝnana Karban Kat ka.<verse eid="REV 16:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="REV 16:15" />
    <char style="wj">&lt;&lt;Wu sǝni, mǝ nǝ yiu aɓa yasǝlǝban kǝla mǝn'í. Tsǝkbu mala Ɓakuli nda amur ɓwa mǝnana kat kǝ dum nǝ mǝsǝì aɓa kundǝmuram, sǝ kǝ bwal agir-nggūrǝu male pepè, ace mǝnana ɓǝ̀ kǝa ging nǝ ɓate, ɓǝ̀ kum kǝsǝkya a mǝsǝ aɓwana raka!&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:15 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="1TH 5:2">1Tas 5:2</ref>
      </char>.</note><verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />Pǝlǝa abangŋo mǝɓane mǝno ramgi amurǝma andǝ amǝ'lwa malea a banɓwáná aban mǝnana à tunǝki nǝ kun Ibǝru ama Armagedon ngga.<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 9:27">2Amur 9:27</ref></char>.</note><verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />Sǝ tongno-nong-ɓaria mǝturonjar solǝ gìr ɓá tasau male aɓa gung. Nggea giu mǝcandǝe pur nǝ ban buno-murǝm aɓa Ndàmǝgule, bang ama, &lt;&lt;Malǝna!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:6">Isha 66:6</ref></char>.</note> <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />Kara tǎlaban liki'nzama, mgbarangce sàkkya, agiu akya, sǝ nzali dǝurǝki kǝ̀rkǝ́r. Ulang mǝno yì dǝurǝkya mala nzali ka, malaká kumban àkǝ̀ fara aɓa do mala ɓwapǝndǝa a ɓanza ɗàng.<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 19:16">Pur 19:16</ref>; <ref loc="DAN 12:1">Dan 12:1</ref></char>.</note> <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />Nggea-là mǝgule Babila ka, gau arǝ abanì tàrú, sǝ anggea-là mala anzali ɓanza pas ka, à kpakia, à sukki amur rǝarǝia. Nda sǝ Ɓakuli ɗenyi nǝ Babila Mǝgule, sǝ tsǝì ɓǝ̀ nu aɓa kwar mǝnana à lumsǝì nǝ mùr-anap mala bumlulla mǝgule male aɓa ukkio male ka. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />Ko ya luran ngga, ndǝrmi, sǝ ankono kat ka, à bǝbbǝri. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />Amǝsǝtali-mbulo mǝgulke, mǝnana dǝmbǝrya malea nda kǝla anggea-taligo ka, à ara a kùli aban yiu amur aɓwana a nzali. Aɓwana kutia bang cau mǝɓane arǝ Ɓakuli atàcau mala mǝnia yì gìr yinǝ tanni-twal-là nǝ mǝsǝtali-mbulo ka, acemǝnana gir nî ɓiki kǝ̀rkǝ́r.<note caller="+" style="f"><char style="fr" closed="false">16:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 9:23">Pur 9:23</ref></char>.</note><verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">Ɓashi mala Ɓakuli amur <optbreak /> mā-gyatarǝu mǝgule</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />Mwashat atà amǝturonjar tongno-nong-ɓari mǝnana nǝ atasau tongno-nong-ɓari ka, yiu a banam. Nam cau ama, &lt;&lt;Yiu atàm, mǝ nǝ lǝmdǝo ɓashi mala Ɓakuli mǝnana nǝ̀ yiu amur mā-gyatarǝu mǝgule, yì nggea-là mǝnana à ɓè a ban anggeasala pas ka.<note caller="+" style="f"><char style="fr" closed="false">17:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:13">Ir 51:13</ref></char>.</note> <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />Amurǝma mala ɓanza pak cauɓikea nongginǝban andǝi, sǝ aɓwana mǝnana à nda ka amǝɓanza man ngga, à ɓosǝkinia à nùnà mùr-anap mala cauɓikea male mala nongginǝ-rǝarǝu kǝ̀rkǝ́r, gandǝa à wal-wale.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 23:17">Isha 23:17</ref>; <ref loc="JER 25:15-16">Ir 25:15-16</ref></char>.</note><verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />Pǝlǝa mǝturonjar twalam aɓa bangŋo umnǝ mim aɓa ɓè pǝɗanban. Akanó ka ǝn sǝn ɓwama aban do anzǝm nyamɓikea mǝbangŋe mǝnana ndanǝ aɓamuru tongno-nong-ɓari andǝ anjawe lum, andǝ alullǝu sangban arǝ Ɓakuli, mǝnana à gilǝia arǝì kat ka. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" /><note caller="+" style="f"><char style="fr" closed="false">17:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:7">Ir 51:7</ref></char>.</note>Ɓwame oasǝ agir-nggūrǝu mana kúreà candǝ ka, sǝ mbàkì rǝì nǝ bolo-njengǝlan, andǝ amǝsǝtali-gǝna andǝ amǝsǝ-nlang mǝtà'nzame. Bwal kwap bolo-njengǝlan a buì, mǝnana lùmsǝ̀nà nǝ agir'ɓeami andǝ agir pǝndǝkea mala nonggi nǝ aburana male ka. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />Lullǝu na kam à gilǝì a kúndǝmbi mǝnana ɓālǝi ka gir'sǝmbǝrǝa na. Lullǝuî ama:</para>
  <para style="pc" vid="REV 17:5">BABILA, NGGEA-LÀ MƏGULE, NGGEAU MALA KOYA KÌƊÌKÌ MALA NONGGINƏ-RƏARƏU ANDƏ KOYA GÌR ƁEAMI A ƁANZA.<verse eid="REV 17:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="REV 17:6" />Ən sǝni ka, ɓwame nda aɓa wal-wale nǝ nkila mala aɓwana mala Ɓakuli, andǝ nkila mala aɓwana mǝnana à dum nǝ mǝsǝcau arǝ nakún Yesu ka.</para>
  <para style="p" vid="REV 17:6">Lang ǝn sǝni ka, gìr nî pam ndali kǝ̀rkǝ́r. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />Pǝlǝa mǝturonjar nam ama, &lt;&lt;Palang sǝ a pak ndali? Mǝ nǝ banggo gìr ɓa-sǝmbǝrǝa amur mǝnia yì ɓwama, andǝ mala yì nyamɓikea mǝno nǝ aɓamuru tongno-nong-ɓari andǝ anjawe lum, mǝnana ɓwame dukiyi a nzǝmi ka. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />Mǝno yì nyamɓikea a sǝni ka, ndakam ɗiɗyal nǝ yilǝmu, ado ka pà kàm ɗàng, sǝ banì pà nǝ̀ sau ɗang ndo nǝ̀ nggá puro aɓa tūli-tàtǝkǝtè, sǝ nǝ̀ kutio nǝ̀ ká lú mǝnana málá male pà kàm raka. Aɓwana mǝnana à do a ɓanza, amǝnana pur a share ɓanza ka, à gilǝ lullǝia aɓa Malǝmce Yilǝmu raka, à nǝ̀ ndali nǝ nyare-yiu mala man yì nyamɓikea mǝnana wú ɗiɗyal ka.<note caller="+" style="f"><char style="fr" closed="false">17:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:3">Dan 7:3</ref>; <ref loc="REV 3:5">Sǝn 3:5</ref></char>.</note><verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />&lt;&lt;Mǝnia ka, à kǝ earce ama ɓwa ɓǝ̀ dum nǝ sǝlǝe andǝ bwalta gìr. Aɓamuru tongno-nong-ɓari mala nyamɓikea ka, à nda ka nkono tongno-nong-ɓari mǝnana ɓwame dukiyi amúrià ka. Sǝ yia gbal ka, amurǝma na, yia mǝnia tongno-nong-ɓari ka. <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />Tongno ateà ka à wukina. Mwashat ka nda kam più amur buno-murǝm. Sǝ ɓè man mwashat ka, malaká yiu ɗang peatu. Ɓǝ̀ yina ka, do yálban male pà nǝ̀ sau ɗang. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />Yì nyamɓikea mǝnana ndakam ɗiɗyal nǝ yilǝmu, sǝ ado ka pà kàm raka, nda tongno-nong-tàruià murǝm. Sǝ yì ka, ndá mwashat atà amǝno yì amurǝma tongno-nong-ɓari ka, sǝ kǝ ká nǝ ká a lú male.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />&lt;&lt;Anjawe lum mala nyamɓikea mǝnana a sǝnia ka, amurǝma na lum, mǝnana à malaká ak gara-murǝm raka peatu, sǝama à nǝ̀ yia pea wia gara-murǝm. À nǝ̀ duk amurǝma aɓa pwari bǝti atà nyamɓikea.<note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:20-24">Dan 7:20-24</ref></char>.</note> <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />Yia kat mǝnia lum ngga, kunia mwashat. À nǝ̀ yia nyesǝ rǝcandǝa andǝ gara-murǝm malea à nǝ̀ pè nyamɓikea. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />Yia kat ka, à nǝ̀ kánǝ lwa arǝ Mǝgam, sǝ Mǝgam andǝ amǝtè, yia aɓwana male mǝnana tunǝia, sǝ tarkia, andǝ amǝ kpate aɓa mǝsǝcau ka, à nǝ̀ limurǝm amúrià. À limurǝm amúrià acemǝnana yì Mǝgam ngga, nda Gbani amur amǝtala anzali kat, sǝ nda Murǝm mala amurǝma kat.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 2:47">Dan 2:47</ref></char>.</note><verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />Pǝlǝa mǝturonjar banggàm ama, &lt;&lt;Amúr mǝnana a sǝnia a ban mǝnana yì mā-gyatarǝu dukiyi kam ngga, à nda ka ɓwana amǝ'làkke pas mala anzali, andǝ akún, andǝ atau, andǝ aɓwapǝndǝa. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />Yì nyamɓikea andǝ anjawe lum mǝnana a sǝnia ka, à nǝ̀ ɓinǝmǝsǝ mā-gyatarǝu man. À nǝ̀ swárì wi agir-nggūrǝì, à nǝ̀ nyi nǝ ɓate, à nǝ̀ shak nyami, sǝ acili abare ka, à nǝ̀ pisǝia a bǝsa. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />À nǝ̀ pak anggo, acemǝnana Ɓakuli tsǝ́ngŋǝ̀nà kànì male a ɓabumia, kànì male mǝnana à nǝ̀ pak nggearǝ gir mǝnana ɓabumi earkiyi ce ka. À nǝ̀ kpapi múrià, à nǝ̀ pè nyamɓikea gara-murǝm malea. Aɓa pě mǝno anggo ka, cau mǝnana Ɓakuli bang ngga, nǝ̀ yia lùmsǝo. <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />Man yì ɓwama a sǝni ka, nda mǝno yì nggea-là mǝgule mǝnana nda murǝm amur amurǝma mala ɓanza ka.&gt;&gt;<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">Kpa mala Babila</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />Anzǝm mǝno ka, ǝn sǝn ɓè mǝturonjar pur a kùli sǝ sulǝo aban yiu a ɓanza. Yì ka, ndanǝ rǝcandǝa kǝ̀rkǝ́r, sǝ tǎ mala ɓoarɓwa male tǎ aki ɓanza. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />Loasǝ gì bàng-bàng nacau ama:</para>
  <para style="q1" vid="REV 18:2">&lt;&lt;Babila kpana!</para>
  <para style="q1" vid="REV 18:2">Mǝno yì nggea-là</para>
  <para style="q2" vid="REV 18:2">mǝgule ka, kpana!</para>
  <para style="q1" vid="REV 18:2">Pǝlǝna ban-do</para>
  <para style="q2" vid="REV 18:2">mala akukwar.</para>
  <para style="q1" vid="REV 18:2">Pǝlǝna mpù mala</para>
  <para style="q2" vid="REV 18:2">koya bangŋo mǝɓane,</para>
  <para style="q1" vid="REV 18:2">andǝ ndá mala</para>
  <para style="q2" vid="REV 18:2">koya nyal mǝɓane,</para>
  <para style="q1" vid="REV 18:2">andǝ ban sǝmbǝrǝa mala</para>
  <para style="q2" vid="REV 18:2">koya nyama mǝɓane,</para>
  <para style="q1" vid="REV 18:2">andǝ mǝnana à ɓinǝce ka.<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 21:9">Isha 21:9</ref>; <ref loc="JER 50:39">Ir 50:39</ref></char>.</note><verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />Aɓwana arǝ anzali kat,</para>
  <para style="q2" vid="REV 18:3">à nùnà mùr-anap</para>
  <para style="q1" vid="REV 18:3">mala nshawari,</para>
  <para style="q2" vid="REV 18:3">andǝ kìɗìkì mala</para>
  <para style="q1" vid="REV 18:3">nonggi nǝ rǝarǝu male,</para>
  <para style="q2" vid="REV 18:3">sǝ walǝnia.</para>
  <para style="q1" vid="REV 18:3">Amurǝma mala ɓanza</para>
  <para style="q2" vid="REV 18:3">nonggina nǝi.</para>
  <para style="q1" vid="REV 18:3">Ace ɓiki earce do male</para>
  <para style="q2" vid="REV 18:3">aɓa banɓoarnado</para>
  <para style="q1" vid="REV 18:3">mala kume ka,</para>
  <para style="q2" vid="REV 18:3">tsǝ̀ngŋǝ̀nà amǝ nggāliki</para>
  <para style="q1" vid="REV 18:3">mala ɓanza à pǝlǝna</para>
  <para style="q2" vid="REV 18:3">amǝ gǝna.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 25:15">Ir 25:15</ref>,<ref loc="JER 25:27">27</ref></char>.</note><verse eid="REV 18:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="REV 18:4" />Pǝlǝa ǝn ok ɓè giu pur nǝ kuli kǝ na ama:</para>
  <para style="q1" vid="REV 18:4">&lt;&lt;Wu purî ɓālǝi,</para>
  <para style="q2" vid="REV 18:4">wun aɓwana mem.</para>
  <para style="q1" vid="REV 18:4">Wu kǝa oasǝ bu wun aɓalǝ</para>
  <para style="q2" vid="REV 18:4">acauɓikea male ɗàng,</para>
  <para style="q1" vid="REV 18:4">ɓǝ̀ ana raka,</para>
  <para style="q2" vid="REV 18:4">wun nǝ̀ nutanni atè</para>
  <para style="q1" vid="REV 18:4">arǝ agirtanni mǝnana</para>
  <para style="q2" vid="REV 18:4">à nǝ̀ sulǝo amurí ka.<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 48:20">Isha 48:20</ref>; <ref loc="JER 50:8">Ir 50:8</ref></char>.</note><verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />Acauɓikea male ka,</para>
  <para style="q1" vid="REV 18:5">à gwalikina amur rǝarǝia,</para>
  <para style="q2" vid="REV 18:5">à bingŋǝna kùli.</para>
  <para style="q1" vid="REV 18:5">Ɓakuli ɗenyina nǝ atúró</para>
  <para style="q2" vid="REV 18:5">ɓealɓikea male</para>
  <para style="q2" vid="REV 18:5">mǝnana pakkia ka.<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:9">Ir 51:9</ref></char>.</note><verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />Ɓǝà mbweki wi a kúnì,</para>
  <para style="q2" vid="REV 18:6">kǝla mǝnana pàkkî</para>
  <para style="q2" vid="REV 18:6">aɓea ɓwana ka.</para>
  <para style="q1" vid="REV 18:6">Ɓǝà tsǝì ɓǝ̀ mbwe kusǝ ɓari</para>
  <para style="q2" vid="REV 18:6">arǝ agir mǝnana pea ka.</para>
  <para style="q1" vid="REV 18:6">Ɓǝà mbwe ɓǝ̀ nu</para>
  <para style="q2" vid="REV 18:6">nggea mǝɓane mana</para>
  <para style="q1" vid="REV 18:6">lúllô male ka kar mǝnana</para>
  <para style="q2" vid="REV 18:6">pea aɓea ɓwana sǝ à nu ka,</para>
  <para style="q2" vid="REV 18:6">kusǝ ɓari.<note caller="+" style="f"><char style="fr" closed="false">18:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 137:8">Ang 137:8</ref></char>.</note><verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />Sokkite ɓǝ̀ tāpì aɓa</para>
  <para style="q2" vid="REV 18:7">tanni andǝ bumkiɗikea</para>
  <para style="q1" vid="REV 18:7">kǝla mǝnana pè ɓamúrì</para>
  <para style="q2" vid="REV 18:7">gulo andǝ do mǝɓoarne</para>
  <para style="q2" vid="REV 18:7">aɓa rǝpwala ka.</para>
  <para style="q1" vid="REV 18:7">Kǝ jali a ɓabumi ama,</para>
  <para style="q2" vid="REV 18:7">&lt;Mǝ nda mā-murǝm;</para>
  <para style="q2" vid="REV 18:7">mǝ nda mā-lú ɗàng.</para>
  <para style="q1" vid="REV 18:7">Kǝ gìr pà kàm</para>
  <para style="q2" vid="REV 18:7">nǝ̀ ciem mǝ nǝ pak</para>
  <para style="q2" vid="REV 18:7">bumkiɗikea ɗang.<note caller="+" style="f"><char style="fr" closed="false">18:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 47:8-9">Isha 47:8-9</ref></char>.</note>&gt;<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />Ace mani ka,</para>
  <para style="q2" vid="REV 18:8">agirpatanni mǝnana</para>
  <para style="q1" vid="REV 18:8">à nǝ̀ yinǝi wi nǝ bumkiɗikea,</para>
  <para style="q2" vid="REV 18:8">andǝ nzala,</para>
  <para style="q2" vid="REV 18:8">andǝ lú ka,</para>
  <para style="q1" vid="REV 18:8">à nǝ̀ yiu amurí</para>
  <para style="q2" vid="REV 18:8">aɓa pwari mwashat.</para>
  <para style="q1" vid="REV 18:8">Nǝ̀ yia pi aɓa bǝsa kǝring,</para>
  <para style="q2" vid="REV 18:8">acemǝnana Mǝtalabangŋo</para>
  <para style="q1" vid="REV 18:8">Ɓakuli mǝnana pakkiyi wi</para>
  <para style="q1" vid="REV 18:8">ɓashi ka,</para>
  <para style="q2" vid="REV 18:8">mǝ rǝcandǝa na.&gt;&gt;<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />Amurǝma mala ɓanza mǝnana à kutio aɓa kìɗìkì mala nonggi nǝ rǝarǝu andǝ yi, sǝ à do aɓa banɓoarnado andǝ li mǝɓoarne atè ka, à nǝ̀ ɓua, sǝ à nǝ̀ keban amurí, ɓǝà sǝnǝna yele mala bǝsa mǝnana kǝ pisǝì ka.<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 26:16-17">Ezǝk 26:16-17</ref></char>.</note> <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />Nggea tanni male mǝgule nǝ̀ pea wia ɓangciu kǝ̀rkǝ́r. À nǝ̀ cam kuko, sǝ à nǝ̀ keban amurí ama:</para>
  <para style="q1" vid="REV 18:10">&lt;&lt;Caukwanban!</para>
  <para style="q1" vid="REV 18:10">Caukwanban nǝ we Babila,</para>
  <para style="q2" vid="REV 18:10">nggea-là mǝgule,</para>
  <para style="q2" vid="REV 18:10">la murǝm!</para>
  <para style="q1" vid="REV 18:10">Aɓa bu-pwari mwashat</para>
  <para style="q2" vid="REV 18:10">ɓashi mala Ɓakuli</para>
  <para style="q1" vid="REV 18:10">yi sulǝna a muro!&gt;&gt;<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />Amǝ nggāliki aɓa ɓanza nǝ̀ ɓua, sǝ à nǝ̀ pak bumkiɗikea ace, acemǝnana kǝɓwa ueo kam nǝ̀ kúr agirmâ malea ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 27:36">Ezǝk 27:36</ref></char>.</note> <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />Agir-mâ mǝnana kúria nǝ boalo kǝ̀rkǝ́r sǝ à ram ngga, à nda ka zǝnariya andǝ azǝrfa, andǝ atali gǝna, andǝ sala-ɓá-nkombo. Aɓea ka à nda ka nggubyau-linǝn, amǝ rǝɓǝlke, andǝa mǝnana amurǝma makkiyi arǝia ka, andǝa mǝnana kúria pa bǝti raka. Aɓea ɗǝm ngga à nda ka agir mǝnana à shària nǝ nggun mǝɓoarne sǝ à hasǝkia wia amuru-mǝrǝmɓoarne ka, andǝ agir mǝnana à tùllia nǝ bolo-bángŋá, andǝ bolo-candǝa ka, andǝ agir mǝnana à ɓakkia nǝ tali mabǝl ka.<note caller="+" style="f"><char style="fr" closed="false">18:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 27:12-13">Ezǝk 27:12-13</ref>,<ref loc="EZK 27:21">21</ref></char>.</note> <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />Aɓea gir ɗǝm mana kúria ka, à nda ka amuku nggwato-nggun mǝɓoarne mala amǝ Asiya, andǝ amuku agir mǝɓoarne mǝnana à kunǝkiyia amur girlina. Myang-loasǝ-yele mǝ'rǝmɓoarne, andǝ myang pak ɓuri wal rǝkwangya, andǝ myang pak muru-mǝrǝmɓoarne na aɓalǝia. Acilia ka à nda ka mùr-ɓǝlanggun anap, andǝ mùrú nggun-olif, andǝ muku pak bǝredi mǝɓǝlke, andǝ mǝsǝ mǝssa-alkama, andǝ andá, andǝ anzur, andǝ apǝ́r, andǝ awaru-pǝr, andǝ aguro, andǝ ayilǝmi ɓwapǝndǝa. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />Amǝ nggāliki nǝ̀ bang ama,</para>
  <para style="q1" vid="REV 18:14">&lt;&lt;Agir mǝɓoarne mǝnana</para>
  <para style="q2" vid="REV 18:14">bumo earkiyicea,</para>
  <para style="q1" vid="REV 18:14">sǝ rǝo kǝ ɓǝla arǝia ka,</para>
  <para style="q2" vid="REV 18:14">à umna arǝò kat.</para>
  <para style="q1" vid="REV 18:14">Agirkuma mò kat,</para>
  <para style="q2" vid="REV 18:14">andǝ agir gilǝki rǝǔ mô ka,</para>
  <para style="q2" vid="REV 18:14">à ndǝrmina arǝò kat.</para>
  <para style="q1" vid="REV 18:14">A pa wu nǝ nyare awu nǝ</para>
  <para style="q2" vid="REV 18:14">kumia ɗǝm ɗàng.&gt;&gt;<verse eid="REV 18:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="REV 18:15" />Amǝ nggāliki mǝnana à kurkiyi wi kúró nǝ agir mǝnia, sǝ à kum gǝna malea arǝì ka, à nǝ̀ cam kuko, aɓa ɓangciu arǝ tanni mǝgule mǝnana sulǝo amurí ka. À nǝ̀ ɓua sǝ à nǝ̀ nggǝ keban amurí ama,<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 27:31">Ezǝk 27:31</ref>,<ref loc="EZK 27:36">36</ref></char>.</note><verse eid="REV 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 18:16" />&lt;&lt;Cau kwanban,</para>
  <para style="q2" vid="REV 18:16">cau kwanban nǝ Babila,</para>
  <para style="q2" vid="REV 18:16">nggea-là mǝgule!</para>
  <para style="q1" vid="REV 18:16">Ɗiɗyal ka, kǝ oasǝ</para>
  <para style="q2" vid="REV 18:16">anggubyau mā-murǝma</para>
  <para style="q1" vid="REV 18:16">mǝnana à teǎ nǝ</para>
  <para style="q2" vid="REV 18:16">nggubyau-linǝn mǝɓoarne ka.</para>
  <para style="q1" vid="REV 18:16">Kǝ oasǝ agir gilǝki rǝǔ</para>
  <para style="q2" vid="REV 18:16">mǝnana à peǎ nǝ bolo-njengǝlan,</para>
  <para style="q1" vid="REV 18:16">andǝ atali-gǝna,</para>
  <para style="q2" vid="REV 18:16">andǝ agir tà'nzama</para>
  <para style="q2" vid="REV 18:16">mǝɓoarne ka.<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />Ndo ka, aɓa bu-pwari</para>
  <para style="q1" vid="REV 18:17">mwashat,</para>
  <para style="q2" vid="REV 18:17">à kiɗikina nggea kume</para>
  <para style="q1" vid="REV 18:17">mǝgule male kat.&gt;&gt;</para>
  <para style="p" vid="REV 18:17">Koya mǝkwak waru-bǝsa andǝ aɓwana mǝnana kat à kǝ twal gya aɓa waru a nggeamùr, andǝ amǝtúró ɓá waru, andǝ aɓwana mǝnana kat túróbù ace kum gìr do la malea ka, nda a nggeamùr ka, à cam kuko.<note caller="+" style="f"><char style="fr" closed="false">18:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 23:14">Isha 23:14</ref>; <ref loc="EZK 27:26-30">Ezǝk 27:26-30</ref></char>.</note> <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />Lang à sǝn yele mala pi mala mǝnia yì nggea-là ka, à loasǝ già à na ama,</para>
  <para style="q1" vid="REV 18:18">&lt;&lt;Ɓè kǝ nggea-là kàm</para>
  <para style="q2" vid="REV 18:18">kǝla mǝnia yì nggea-là</para>
  <para style="q1" vid="REV 18:18">mǝgule ka le?&gt;&gt;<verse eid="REV 18:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="REV 18:19" />À pwan tú sǝ à soe amúrià, sǝ à mak'zwalo aban ɓua andǝ keban ama:</para>
  <para style="q1" vid="REV 18:19">&lt;&lt;Cau kwanban!</para>
  <para style="q2" vid="REV 18:19">Cau kwanban nǝ</para>
  <para style="q1" vid="REV 18:19">nggea-là mǝgule,</para>
  <para style="q2" vid="REV 18:19">ban mǝnana amǝtala</para>
  <para style="q1" vid="REV 18:19">awaru-bǝsa mǝnana</para>
  <para style="q2" vid="REV 18:19">à kǝ gya a nggeamùr,</para>
  <para style="q2" vid="REV 18:19">pǝlǝ amǝkume kàm ngga.</para>
  <para style="q1" vid="REV 18:19">Aɓa bu-pwari mwashat,</para>
  <para style="q2" vid="REV 18:19">kara à kiɗikini.<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 27:30-34">Ezǝk 27:30-34</ref></char>.</note><verse eid="REV 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />Wun mǝnana wu</para>
  <para style="q1" vid="REV 18:20">do a kùli ka,</para>
  <para style="q2" vid="REV 18:20">wu pak banɓoarnado amurí!</para>
  <para style="q1" vid="REV 18:20">Wun aɓwana mala Ɓakuli,</para>
  <para style="q2" vid="REV 18:20">andǝ amǝ'mishan,</para>
  <para style="q1" vid="REV 18:20">andǝ amǝ'ɓangnǝa mala Ɓakuli,</para>
  <para style="q2" vid="REV 18:20">wu pak banɓoarnado.</para>
  <para style="q1" vid="REV 18:20">Acemǝnana Ɓakuli</para>
  <para style="q2" vid="REV 18:20">pangŋǝni wi ɓashi</para>
  <para style="q1" vid="REV 18:20">ace kǝ wun.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 44:23">Isha 44:23</ref>; <ref loc="JER 51:48">Ir 51:48</ref></char>.</note><verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />Pǝlǝa ɓè mǝturonjar mǝ'rǝcandǝe imsǝ nggea tali mǝnana gulo male nda kǝla nggea taligo mǝgule ka. Yi túrí aɓa nggeamùr sǝ na ama,</para>
  <para style="q1" vid="REV 18:21">&lt;&lt;Kǝla mǝno ka,</para>
  <para style="q2" vid="REV 18:21">sǝ à nǝ̀ túr nggea-là</para>
  <para style="q1" vid="REV 18:21">Babila aɓa nggeamùr tsulǝm!</para>
  <para style="q1" vid="REV 18:21">Sǝ à pà nǝ̀ nyare</para>
  <para style="q2" vid="REV 18:21">à nǝ̀ sǝni ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:63">Ir 51:63</ref>; <ref loc="EZK 26:21">Ezǝk 26:21</ref></char>.</note><verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />Agí ka zangŋan</para>
  <para style="q2" vid="REV 18:22">andǝ amǝ'nggyal,</para>
  <para style="q1" vid="REV 18:22">andǝ agí ka ntetu,</para>
  <para style="q2" vid="REV 18:22">andǝ anjawe ka,</para>
  <para style="q1" vid="REV 18:22">à pà nǝ̀ nyare</para>
  <para style="q2" vid="REV 18:22">à nǝ̀ oea ɗǝm</para>
  <para style="q2" vid="REV 18:22">a ɓālǝo ɗàng.</para>
  <para style="q1" vid="REV 18:22">À pà nǝ̀ kum amǝ'túróbù</para>
  <para style="q2" vid="REV 18:22">andǝ koya ulang túróbù</para>
  <para style="q2" vid="REV 18:22">a ɓālǝo ɗǝm ɗàng.</para>
  <para style="q1" vid="REV 18:22">À pà nǝ̀ nyare</para>
  <para style="q2" vid="REV 18:22">à nǝ̀ ok gi gogô</para>
  <para style="q1" vid="REV 18:22">nǝ taligo ɗǝm</para>
  <para style="q2" vid="REV 18:22">a ɓālǝo ɗàng.<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 24:8">Isha 24:8</ref>; <ref loc="EZK 26:13">Ezǝk 26:13</ref></char>.</note><verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />Tǎ mala pitǝla pà nǝ̀</para>
  <para style="q2" vid="REV 18:23">nyare nǝ̀ tà ɗǝm</para>
  <para style="q2" vid="REV 18:23">a ɓālǝo ɗàng.</para>
  <para style="q1" vid="REV 18:23">À pà nǝ̀ nyare à nǝ̀ ok</para>
  <para style="q2" vid="REV 18:23">giu banɓoarnado mala</para>
  <para style="q1" vid="REV 18:23">amāfela andǝ abura-māfela</para>
  <para style="q2" vid="REV 18:23">ɗǝm a ɓālǝo ɗàng.</para>
  <para style="q1" vid="REV 18:23">Mǝnia ka pàk anggo</para>
  <para style="q2" vid="REV 18:23">acemana amǝ nggāliki mò,</para>
  <para style="q1" vid="REV 18:23">mǝnana à nda à kútìban kat</para>
  <para style="q2" vid="REV 18:23">ɗiɗyal nǝ rǝcandǝa aɓa</para>
  <para style="q1" vid="REV 18:23">kúrkúró andǝ ram gǝna</para>
  <para style="q2" vid="REV 18:23">a ɓanza ka,</para>
  <para style="q1" vid="REV 18:23">a ciá púp, nǝ́ agir</para>
  <para style="q2" vid="REV 18:23">monzǝo<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="fq" closed="false">Agir monzǝo </char><char style="ft" closed="false">ka, kpapi pyauta aɓwana andǝ ɗikalú andǝ pakki aɓuri mala kiɗiki ɓwa ko wal-lú.</char></note> mô,</para>
  <para style="q1" vid="REV 18:23">à swarkia aɓwana</para>
  <para style="q2" vid="REV 18:23">arǝ anzali kat.<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 25:10">Ir 25:10</ref></char>.</note><verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />Aɓa nggea-là Babila ka,</para>
  <para style="q2" vid="REV 18:24">à kum nkila mala</para>
  <para style="q1" vid="REV 18:24">amǝ'ɓangnǝa mala Ɓakuli,</para>
  <para style="q2" vid="REV 18:24">andǝ mala aɓwana</para>
  <para style="q1" vid="REV 18:24">mala Ɓakuli,</para>
  <para style="q2" vid="REV 18:24">andǝ aɓwana mǝnana kat</para>
  <para style="q1" vid="REV 18:24">à wal-luia a ɓanza ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 51:49">Ir 51:49</ref></char>.</note><verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s">Ɓwabunda tu-nggyal limurǝm a kùli</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />Anzǝm mǝnia ka, ǝn ok giu kǝla loàsǝ̀ban mala ɓwabundǝa mǝ'làkke kǝ̀rkǝ́r a kùli, à kǝ na ama,</para>
  <para style="q1" vid="REV 19:1">&lt;&lt;Haliluya!</para>
  <para style="q2" vid="REV 19:1">Amsǝban andǝ ɓoarɓwa</para>
  <para style="q1" vid="REV 19:1">andǝ rǝcandǝa ka,</para>
  <para style="q2" vid="REV 19:1">amala Ɓakuli ma'sǝm na.<verse eid="REV 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2" />Aɓashi male ka,</para>
  <para style="q2" vid="REV 19:2">kǝ pea aɓa mǝsǝcau</para>
  <para style="q2" vid="REV 19:2">andǝ kpate a nzongnì.</para>
  <para style="q1" vid="REV 19:2">Pàngŋǝ́nì mā-gyatarǝu</para>
  <para style="q2" vid="REV 19:2">mǝgule ɓashi;</para>
  <para style="q1" vid="REV 19:2">yì mā-gyatarǝu ka</para>
  <para style="q2" vid="REV 19:2">nda kiɗiki ɓanza</para>
  <para style="q1" vid="REV 19:2">nǝ ɓealu mǝɓane male</para>
  <para style="q2" vid="REV 19:2">mala gyatarǝu aban</para>
  <para style="q1" vid="REV 19:2">nonggi nǝ aburana ka.</para>
  <para style="q1" vid="REV 19:2">Ɓakuli pángŋǝ́nì wi mǝɓane</para>
  <para style="q2" vid="REV 19:2">a kunì walo mǝnana wal-lú</para>
  <para style="q1" vid="REV 19:2">aguro male ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:43">Nggur 32:43</ref></char>.</note><verse eid="REV 19:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="REV 19:3" />À nyare à loasǝ già ɗǝm kpǝm ama:</para>
  <para style="q1" vid="REV 19:3">&lt;&lt;Haliluya!</para>
  <para style="q2" vid="REV 19:3">Yele mǝnana kǝ lo aɓa</para>
  <para style="q1" vid="REV 19:3">pi mala mā-gyatarǝu</para>
  <para style="q2" vid="REV 19:3">mǝgule ka,</para>
  <para style="q1" vid="REV 19:3">nǝ̀ nggǝ o a kùli málá male</para>
  <para style="q2" vid="REV 19:3">pà kàm ɗàng!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 34:10">Isha 34:10</ref></char>.</note><verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />Aɓwana mǝgule lumi-ɓari-nong-ine andǝ agir-yilǝmu ka, à sarǝa a nzali aban peri a ɓadǝm Ɓakuli mǝnana do amur buno-murǝm ngga. À loasǝ già à bang ama:</para>
  <para style="q1" vid="REV 19:4">&lt;&lt;Ɓǝ̀ do anggo, Haliluya!&gt;&gt;<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />Pǝlǝa ɓè giu pur nǝban buno-murǝm, na ama:</para>
  <para style="q1" vid="REV 19:5">&lt;&lt;Wu ɓwangsǝ Ɓakuli ma'sǝm,</para>
  <para style="q2" vid="REV 19:5">wun aguro male kat,</para>
  <para style="q1" vid="REV 19:5">wun mana wu kǝ ɓanggi wi ka,</para>
  <para style="q2" vid="REV 19:5">twal aban ɓwa mǝkyauwe</para>
  <para style="q1" vid="REV 19:5">aban ká aban ɓwamǝgule!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 115:13">Ang 115:13</ref></char>.</note><verse eid="REV 19:5" /></para>
  <para style="s">Li girlina isǝ ɓwama mala Mǝgam</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />Sǝ ǝn ok ɓè giu ɗǝm, kǝla gì ɓwabundǝa mǝ'kǝ̀rkǝ́r nì aban mak gāwàn, kǝla gì songnǝo mala nggeamùr, sǝ kǝla nggea ime mala mbulo, à kǝ na ama:</para>
  <para style="q1" vid="REV 19:6">&lt;&lt;Haliluya!</para>
  <para style="q1" vid="REV 19:6">Mǝtalabangŋo Ɓakuli</para>
  <para style="q2" vid="REV 19:6">ma'sǝm mana Karban</para>
  <para style="q1" vid="REV 19:6">kat ka,</para>
  <para style="q2" vid="REV 19:6">nda Murǝm ado,</para>
  <para style="q1" vid="REV 19:6">sǝ gìr kat ka,</para>
  <para style="q2" vid="REV 19:6">nda aɓata yálban male.<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />Ɓǝ̀ sǝm pak banɓoarnado</para>
  <para style="q1" vid="REV 19:7">andǝ pakkiɗire,</para>
  <para style="q2" vid="REV 19:7">sǝ ɓǝ̀ sǝm pè wi gulo.</para>
  <para style="q1" vid="REV 19:7">Pwari isǝban mala</para>
  <para style="q2" vid="REV 19:7">Mǝgam yina,</para>
  <para style="q1" vid="REV 19:7">sǝ Māfela male ka,</para>
  <para style="q2" vid="REV 19:7">gilǝkina rǝì.<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 118:24">Ang 118:24</ref></char>.</note><verse eid="REV 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8" />À pani wi nggubyau</para>
  <para style="q2" vid="REV 19:8">linǝn mǝɓoarne,</para>
  <para style="q1" vid="REV 19:8">mǝpwasǝe pwapwat,</para>
  <para style="q2" vid="REV 19:8">ɓǝ̀ oasǝ arǝì.&gt;&gt;</para>
  <para style="m" vid="REV 19:8">Nggubyau linǝn mǝɓoarne ka, nda cam a kúnì atúró mǝɓoarne mala aɓwana mala Ɓakuli ka.<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />Pǝlǝa mǝturonjar banggàm ama, &lt;&lt;Gilǝ cau mǝnia ka: &lt;Tsǝkbu mala Ɓakuli nda amur aɓwana mǝnana à tunǝia aban ká a ban li girlina isǝban mala Mǝgam ngga!&gt; &gt;&gt; Sǝ na ɗǝm ama, &lt;&lt;Amǝnia ka, à nda ka cau mǝ'mǝsǝcaunì mala Ɓakuli.&gt;&gt;<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />Lang ǝn ok cau mǝno ka, kara ǝn kpa a nzali a ɓadǝm mǝturonjar nǝma mǝ nǝ peri a baní. Sǝ yì ka, banggàm ama, &lt;&lt;Awo, kǝa peri a banam ɗàng! Mim ngga mǝ nda ɓiò guro andǝ ɓi guro atà amǝ'eambo amǝkwaɗi, mǝnana à kǝ banggi aɓwana cau amur Yesu ka. Peri a ban Ɓakuli nǝmurǝì ɓǝ̀rɓǝ̀r, acemǝnana bangŋo mala ɓangnǝa nda cau mala Yesu.&gt;&gt;<verse eid="REV 19:10" /></para>
  <para style="s">Yesu puro nǝ̀ ká lwa arǝ <optbreak /> aɓwana mala Shetan</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />Pǝlǝa ǝn sǝn kùli mǝna, sǝ ǝn sǝn pǝ̀r mǝpwasǝe aban came kam. Ɓwa mǝnana do a nzǝmi kwakiyi ka, lùllǝì nda Mǝ'mǝsǝcaunì andǝ Mǝɓafoe. Aɓa ɓashiki aɓashi male andǝ munǝki amunǝo male ka, kǝ kpata agir kat a nzongnì.<note caller="+" style="f"><char style="fr" closed="false">19:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 1:1">Ezǝk 1:1</ref></char>.</note> <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />Amǝsǝì na kǝla bǝsa mǝnana kǝ earki ka, sǝ a ɓamúrí ka, asukuru-murǝm na kam pas. Ndanǝ lullǝu mǝnana à gilǝì arǝì, sǝ yì nǝmurǝì na súrǝ̀ lullǝuî ka. Kǝ ɓwa pà kàm ɗǝm súrǝì ɗàng.<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 10:6">Dan 10:6</ref></char>.</note> <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />Oasǝ nggea-daura mǝnana à parri aɓa nkila ka, sǝ lullǝu mǝnana à tunǝki nǝi ka, nda &lt;&lt;Cau mala Ɓakuli.&gt;&gt; <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />Amǝ'lwa mala kùli, mǝnana à túr adaura pwasǝa mala nggubyau linǝn a rǝia ka, à puro a nzǝm apǝr mǝpwasǝke, sǝ à kǝ yiu atè. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />A ɓakuni ka, nggeabyau mǝceauwe kǝ puro mǝnana nǝ̀ gandǝna aɓwana nǝi arǝ anzali, mǝnana à mgbikiru ka. &lt;&lt;Nǝ̀ yálmuria nǝ gara-bolo.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 2:9">Ang 2:9</ref></char>.</note> Nǝ̀ betǝki aɓi-mǝbura kǝla mǝnana ɓwa nǝ̀ betǝki aɓǝlanggun anap ace kàm mùr-anap ka. Nǝ̀ pàk mǝnia ka ace lǝmdǝ bumlulla mǝcandǝe mala Ɓakuli mana Karban kat ka amur amǝ'ɓealɓikea. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />Arǝ daura male a ban byali ka, lullǝu nakam à gilǝì ama:</para>
  <para style="pc" vid="REV 19:16">MURƏM MALA AMURƏMA ANDƏ GBANI AMUR AMƏTALA ANZALI.<note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 10:17">Nggur 10:17</ref>; <ref loc="DAN 2:47">Dan 2:47</ref></char>.</note><verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />Pǝlǝa ǝn sǝn ɓè mǝturonjar mala Ɓakuli aban came amur pwari a kùli. Loasǝ gì bàng-bàng nacau nǝ anyal mǝnana à kǝ yal a bumkuli ka ama: &lt;&lt;Wu yiu! Wu yì ramba ace lìli mǝgule mǝnana Ɓakuli gilǝkice ka.<note caller="+" style="f"><char style="fr" closed="false">19:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 39:4">Ezǝk 39:4</ref>,<ref loc="EZK 39:17-20">17-20</ref></char>.</note> <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />Wu yiu wu yì li nyam amurǝma, andǝ aɓwana amǝcandǝe, andǝ akanggǝrang amǝ'lwa. Wu yiu wu yì li nyam apǝ́r andǝ amǝ'pǝ̀r, nyam aɓwapǝndǝa kat, aguro andǝ aɓwana à dukdo ɓamuria ka, ɓwa mǝkyauwe andǝ ɓwa mǝgule.&gt;&gt;<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />Pǝlǝa ǝn sǝn nyamɓikea, andǝ amurǝma mala ɓanza, andǝ amǝ'lwa malea, à yì ramba a banɓwáná, à nǝ̀ kánǝ lwa arǝ ɓwa mǝno do anzǝm pǝr kwakiyi ka, sǝ arǝ amǝ'lwa male. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />Sǝ yì nyamɓikea ka, à bwali a tārǝia andǝ mǝɓangnǝa mǝ'nyirì mǝnana pakkiyi agir-ndali ace ka. Nǝ amǝno yì agir-ndali pea ka sǝ ɓosǝki ta aɓwana mǝnana à ak nyoulǝa mala nyamɓikea, sǝ à peri a ban ɓǝ̀nzál male ka. Nyamɓikea andǝ mǝɓangnǝa male mǝ'nyirì, yia kǝm, à túriá nǝ yilǝmia aɓa garang mala bǝsa mǝnana kǝ li nǝ atali ear-bǝsa ka. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />Amǝ'lwa malea ka, à twaltea kat nǝ nggeabyau mǝceauwe mǝnana kǝ pur a kún ɓwa mǝnana anzǝm pǝr kwakiyi ka. Sǝ adǝkǝlaki yi sulǝo amur aluia, à li gìr mǝnana kárǝìa ka.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">À bwal shetan à kùrrì ba <optbreak /> apǝlǝa á-mwashat</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />Ən sǝn ɓè mǝturonjar mala Ɓakuli puro a kùli aban yiu a nzali. Bwal gìr mǝn kun tūli-tàtǝkǝtè andǝ nsolo mǝgule a buì. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />Yiu yi gbami dǝragon, mǝno yì share n'yau mǝnana à tunǝki ama Mǝɓealɓikea ko Shetan ngga, sǝ kùrrì nǝ nsolo ɓǝ̀ pak apǝlǝa á-mwashat aɓa kùrban. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />Mǝturonjar pǝlǝa ramte aɓa tūli-tàtǝkǝtè, gir kúni sǝ kumlǝi, ace mǝnana ɓǝ̀ kǝa swarki aɓwana arǝ anzali ɗǝm raka, she ɓǝ̀ amǝno yì apǝlǝa á-mwashat malǝna ka. Anzǝm mǝno ka, dumǝna púp à nǝ̀ yia panzǝi arǝ apwari bǝti.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />Pǝlǝa ǝn sǝn abuno-murǝm sǝ aɓwana mǝnana à do amúrià ka, à pania rǝcandǝa mala pak ɓashi. Sǝ ǝn sǝn ayilǝmi aɓwana mǝnana à kasǝ ɓamuria ace nakún malea amur Yesu andǝ bang cau mala Ɓakuli ka. Yia ka, à peri a ban nyamɓikea ko ɓǝ̀nzál male ɗàng, sǝ à ak nyoulǝa male a kúndǝmbia ko arǝ abuia ɗàng. Yia kat, à lo nǝ yilǝmu ɗǝm, sǝ à duk amurǝma atà Kǝrǝsti arǝ apǝlǝa á-mwashat.<note caller="+" style="f"><char style="fr" closed="false">20:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:9">Dan 7:9</ref>,<ref loc="DAN 7:22">22</ref>,<ref loc="DAN 7:27">27</ref></char>.</note> <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />Mǝnia ka, nda lo nǝ yilǝmu mǝdǝmbe. (Acili aɓwana mǝnana à wuna ka, à lo nǝ yilǝmu ɗang she anzǝm mǝnana mǝno yì apǝlǝa á-mwashat malǝna ka.) <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />Amǝnia yia aɓwana à kum kāmbe aɓa lo a ɓembe nǝ yilǝmu a dǝmbe ka, à ndanǝ tsǝkbu mala Ɓakuli, sǝ yia ka amǝfele na. Ɓaria lú pà nǝ rǝcandǝa amúrià ɗàng. A kúnì ka, à nǝ̀ duk apǝris mala Ɓakuli andǝ mala Kǝrǝsti, sǝ à nǝ̀ duk amurǝma atà Kǝrǝsti arǝ apǝlǝa á-mwashat.<verse eid="REV 20:6" /></para>
  <para style="s">Kpa mala Shetan andǝ <optbreak /> masǝlǝata kìɗìkì male</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />Ɓǝ̀ apǝlǝa á-mwashat malǝna ka, à nǝ̀ panzǝ Shetan, nǝ̀ purî ɓá ndàkurban male. <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />Nǝ̀ o nǝ̀ nggá swarki aɓwana mala anzali, à nǝ̀ purkio arǝ abuban aɓa ɓanza kat, mǝnana à dapi kat ka, à tunǝia ama Gog andǝ Magog. Shetan nǝ̀ nggá rambia a banɓwáná ace ká lwa; làkkì malea ka ɓallè pà kàm ɗàng, kǝla làkkì mala amǝsǝsala a kun nggeamùr.<note caller="+" style="f"><char style="fr" closed="false">20:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 38:2">Ezǝk 38:2</ref>,<ref loc="EZK 38:9">9</ref>,<ref loc="EZK 38:15">15</ref></char>.</note> <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />Sǝ ǝn sǝnia à puro aban ká amur banfana mǝtangŋe mala ɓá ɓanza, à kya kārì kàttì mala aɓwana mala Ɓakuli andǝ nggea-là mǝnana Ɓakuli earkiyi ace raka, a ɓalǝu. Sǝama bǝsa puro a kùli yi sulǝo amúrià, pisǝia puppup. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />Sǝ yì Shetan, mǝnana swarkia ka, à ramte aɓa garang mala bǝsa mǝnana kǝ li nǝ atali ear-bǝsa ka, àkǝ̀ ban mǝnana à ramta nyamɓikea andǝ mǝɓangnǝa mǝ'nyirnì kàm ngga. À nǝ̀ ueo kano aɓa kum kwanban mǝ'kǝ̀rkǝ́r nì du andǝ pwari, mǝnana málá male pà kàm raka.<verse eid="REV 20:10" /></para>
  <para style="s">Masǝlǝata Ɓashi</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />Sǝ ǝn sǝn nggea buno-murǝm mǝpwasǝe andǝ ɓwa mǝnana do amurí ka. Nzali andǝ kuli ɓanggi ɓadǝmbi, à o à kya ndǝrmi, ko à nyare à sǝnia ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">20:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 114:7">Ang 114:7</ref></char>.</note> <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />Sǝ ǝn sǝn aɓwana mǝnana à wuna ka, ɓwa mǝgule andǝ ɓwa mǝkyauwe, aban came a ɓadǝm buno-murǝm nì. Pǝlǝa à mǝngi amalǝmce, sǝ à yì mǝn ɓè malǝmce, mǝnia ka nda Malǝmce Yilǝmu. Sǝ aɓwana mǝnana à wuna ka, à pakkia wia ɓashi arǝ agir mǝnana à pàk ka, kǝla mǝnana ndakam à gilǝia aɓalǝ amalǝmce mǝno ka. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />Nggeamùr ndǝli alú mǝnana aɓalǝi ka. Lú andǝ Domurǝm mala lú ka, à pusǝ alú-aɓwana mǝnana aɓalǝia ka. Sǝ koya ɓwa ka, à pakki wi ɓashi arǝ atúró male mǝnana pàk ka. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />Pǝlǝa à ramta Lú andǝ Domurǝm mala lú aɓa garang mǝnana kǝ li nǝ bǝsa ka. Mǝnia yì garang mala bǝsa ka, nda ɓaria lú. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />Sǝ ɓwa mǝnana kat lùllǝì pà kàm à gilǝì aɓa Malǝmce Yilǝmu<note caller="+" style="f"><char style="fr" closed="false">20:15 </char><char style="fq" closed="false">Malǝmce Yilǝmu: </char><char style="ft" closed="false">Mǝnia ka nda malǝmce mǝnana Ɓakuli gilǝkina alullǝ aɓwana mǝnana à nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka a ɓālǝi.</char></note> raka, à túrí aɓa garang mǝnana kǝ li nǝ bǝsa ka.<note caller="+" style="f"><char style="fr" closed="false">20:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="REV 3:5">Sǝn 3:5</ref></char>.</note><verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">Ɓakuli pusǝ bǝsa kùli <optbreak /> andǝ bǝsa nzali</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />Pǝlǝa ǝn sǝn kùli mǝbǝshe andǝ nzali mǝbǝshe. Kuli mǝnana ɗiɗyal andǝ nzali mǝnana ɗiɗyal ka, à ndǝrmina, sǝ nggeamùr gbal ka pà kàm ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">21:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:22">Isha 66:22</ref></char>.</note> <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />Sǝ ǝn sǝn Nggea-là Mǝfele, yì bǝsa Urǝshalima. Ən sǝni puro a ban Ɓakuli a kùli, sǝ kǝ sulǝo aban yiu. À gilǝkini pepè kǝla māfela mǝnana à gilǝkì wi rǝì aɓa ɓoarnsari ace ká a ban burí ka.<note caller="+" style="f"><char style="fr" closed="false">21:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 37:27">Ezǝk 37:27</ref></char>.</note> <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />Ən ok ɓè giu mǝgule pur nǝban buno-murǝm mala Ɓakuli, nacau ama:</para>
  <para style="pi" vid="REV 21:3">Wu sǝni, ban-do mala Ɓakuli adyan ngga, nda a ban aɓwana male! Yì ka, nǝ̀ do andǝia, sǝ yia ka, à nǝ̀ duk aɓwana male. Ɓakuli nǝ nggearǝì nǝ̀ do ateà.<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 25:8">Pur 25:8</ref>; <ref loc="EXO 29:45">29:45</ref>; <ref loc="LEV 26:11-13">Pǝris 26:11-13</ref>; <ref loc="2CO 6:16">2Kor 6:16</ref></char>.</note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />Nǝ̀ esǝki mǝrǝm kat a mǝsǝia, sǝ lú, andǝ bumkiɗikea, andǝ ɓua andǝ kwanban ngga, à pà nǝ̀ pàk kàm ɗǝm ɗàng. Amǝnia yì agir mǝnana ɗiɗyal ka, à umna ɗǝɗak.<note caller="+" style="f"><char style="fr" closed="false">21:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 25:8">Isha 25:8</ref>; <ref loc="ISA 35:10">35:10</ref>; <ref loc="ISA 65:19">65:19</ref></char>.</note><verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />Sǝ ɓwa mǝno do amur buno-murǝm ngga bang ama:</para>
  <para style="pi" vid="REV 21:5">Wu sǝni, mǝ ndo mǝ nǝ nyesǝ agir kat à nǝ̀ pǝlǝ bǝshe!</para>
  <para style="p" vid="REV 21:5">Pǝlǝa na ɗǝm ama:</para>
  <para style="pi" vid="REV 21:5">Gilǝ cau mǝnia ka, acemǝnana cau na, à nǝ̀ earnǝi, sǝ mǝsǝcau na.<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 43:19">Isha 43:19</ref></char>.</note><verse eid="REV 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6" />Ɗǝm ngga nam ama:</para>
  <para style="pi" vid="REV 21:6">Ko man kat ka à malǝna pě. Mǝ nda Tite, sǝ mǝ nda Masǝlǝate<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="fq" closed="false">Mǝ nda Tite, sǝ mǝ nda Masǝlǝate: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝ nda Alfa sǝ mǝ nda Omega.&gt;&gt;</char></note>. Ɓwa mǝnana kat mǝsamur wali ka, mǝ nǝ pe wi mùr ɓǝ̀ nu, aɓa mgbeɗe mùr mala yilǝmu, pà nǝ̀ mbwe kǝgìr ɗàng.<note caller="+" style="f"><char style="fr" closed="false">21:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 55:1">Isha 55:1</ref></char>.</note> <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />Ɓwa mǝnana kat limurǝm ngga, mǝ nǝ pe wi liɓala mala amǝnia yì agir ka, sǝ yì ka, nǝ̀ duk munem sǝ mǝ nǝ duk Ɓakuli male.<note caller="+" style="f"><char style="fr" closed="false">21:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 89:27-28">Ang 89:27-28</ref></char>.</note><verse eid="REV 21:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="REV 21:8" />Sǝ mǝnia ka nda gìr mǝnana nǝ̀ kum aɓwana mǝnana amǝ'ɓangciu na, andǝ amǝ pakki agir monzǝo<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="fq" closed="false">Agir monzǝo </char><char style="ft" closed="false">ka, kpapi pyauta aɓwana andǝ ɗikalú andǝ pakki aɓuri mala kiɗiki ɓwa ko wal-lú.</char></note>, andǝ amǝ ɗwanyi earnǝ mim, andǝ amǝ pakki agirɓana, andǝ amǝ walki alú, andǝ amǝ do kiɗikì mala nongginǝ-rǝarǝu na ka. Yia kat andǝ amǝ peri a ban ankúl andǝ alú, andǝ aɓwana mǝnana kat amǝ na'nyir na ka, à nǝ̀ ramtea aɓa garang mala bǝsa mǝnana kǝ li nǝ atali ear-bǝsa ka. Mǝnia ka, nda ɓaria lú.<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 30:33">Isha 30:33</ref></char>.</note><verse eid="REV 21:8" /></para>
  <para style="s">Mǝturonjar lǝmdǝì Yohana <optbreak /> Nggea-là mala Ɓakuli</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />Mwashat atà amǝturonjar mala Ɓakuli, yia mǝno tongno-nong-ɓari, mǝnana à bwal atasau mana à lumsǝkia nǝ masǝlǝata agir yinǝ tanni-twal-là ka, yiu a banam. Nam ama, &lt;&lt;Yiu, mǝ nǝ lǝmdǝo Mālá Mǝgam, yì Māfela male.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fq" closed="false">Mālá Mǝgam, yì Māfela male: </char><char style="ft" closed="false">Mǝnia ka ɓālǝi nda, aɓwana mala Ɓakuli, yia mǝnana à angŋǝna Cau Amsǝban mala Kǝrǝsti, sǝ à kpapina ɓamuria andǝi à nǝ̀ do andǝi andǝa Ɓakuli aɓa rǝpwala andǝ banɓoarnado, gauwa pa kàm ɗang, sǝ masǝlǝate pà kàm ɗang.</char></note> <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />Pǝlǝa twalam aɓa rǝcandǝa mala bangŋo, um nǝ mim amúr ɓe nkono mǝgule mǝnana nggea mǝ'dāhre na ka, sǝ lǝmdǝàm Nggea-là Mǝfele, Urǝshalima. Ən sǝni puro a ban Ɓakuli a kùli, sǝ kǝ sulǝo aban yiu.<note caller="+" style="f"><char style="fr" closed="false">21:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 40:2">Ezǝk 40:2</ref></char>.</note> <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />Ɓoarɓwa mala Ɓakuli tsǝì kǝ tâ'nzama tyal-tyal. Esǝke ɓoarnsari gǝraɗau kǝla kǝrstal. Gilǝkea male pepè kǝ twal mǝsǝu pǝlilip kǝla tali'gǝna, kǝla jaspa. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />Sheran mǝnana kàrì nggea-là ka, dāh'rya sǝ tangŋa, sǝ ndanǝ akunɓala arǝì lum-nong-ɓari. À tamsǝ amǝturonjar lum-nong-ɓari à kǝ yál akunɓala mala nggea-là. Amur koya kunɓala mǝnana arǝ sheran ngga, à gilǝ mwashat atà lullǝ atau lum-nong-ɓari mala amǝ Isǝrayila.<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 48:30-35">Ezǝk 48:30-35</ref></char>.</note> <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />À tsǝkia akunɓala tàrú-tàrú arǝ abuban ine mala nggea-là; tàrú nǝ njar-takuli, tàrú nǝ njar-nza, tàrú nǝ njar-kunmur, sǝ tàrú nǝ njar-nzali. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />Yì sheran mala nggea-là ka, à kwákítè amur akusǝɓa lum-nong-ɓari mǝnana à nongsǝia amur rǝarǝia ka. Arǝ koya kusǝɓa ka à gilǝ lullǝ mwashat atà amǝ'mishan lum-nong-ɓari mala Mǝgam.<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />Mǝturonjar mǝnana bangcau nǝ mim ngga ndanǝ mǝmunagara kārǝkigir a buì, a pè nǝ zǝnariya. Nǝ̀ ngga kārǝkina nggea-là nǝi andǝ akunɓala andǝ asheran male.<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EZK 21:15">Ezǝk 21:15</ref></char>.</note> <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />Lang mǝturonjar kārǝki nggea-là nǝ munagara kārǝkigir male ka, kumi ka sauwa male nda mwashat andǝ tangŋa male. Yàle dāh'rya male nda gbal mwashat andǝ sauwa andǝ tangŋa male, sǝ ko mǝ ye ateà kārǝi ka, kilomita á-ɓari nǝ gbǝman-ine<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">kilomita á-ɓari nǝ gbǝman-ine: </char><char style="ft" closed="false">ko &lt;&lt;mel á-mwashat nǝ gbǝman-tongno&gt;&gt;</char></note> na. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />Ɗǝm ngga kārǝki dāh'rya mala sheran mala nggea-là, sǝ kumi ka nda mita lumi-tongno-nong-mwashat [60 m]. Mǝturonjar kpata kārǝkigir mǝnana ɓwapǝndǝa kasǝ ka.<verse eid="REV 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 21:18" />Sheran mala nggea-là ka à ɓè nǝ atali mǝɓoarne, atali jaspa. Sǝ nggea-là ka, à ɓè nǝ zǝnariya kat, zǝnariya mǝnana à zurì nǝ kǝgìr raka, ɓālǝi ɓoarnsari gǝraɗau kǝla gǝlas. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />Sheran mala nggea-là ka, à kwákítè amur akusǝɓa mala atali-gǝna mǝɓoarne ɗàngɗáng lum-nong-ɓari. Kusǝɓa mǝnana à tsǝì a tadǝmbe ka, tali jaspa na. Ɓaria kusǝɓa mǝnana à nongsǝi amur mǝno ka, safir na. Tàruià ka, aget na. Inea ka emeral na.<note caller="+" style="f"><char style="fr" closed="false">21:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 54:11-12">Isha 54:11-12</ref></char>.</note> <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />Tongnoia ka, onis na. Tongno-nong-mwashatia ka, karnelia na. Tongno-nong-ɓaria ka, kǝrisolat na. Tongno-nong-tàruià ka, beril na. Tongno-nong-inea ka, tofas na. Lumia ka, kǝrisopǝras na. Lum-nong-mwashatia ka, jasinta na. Sǝ à masǝlǝte nǝ lum-nong-ɓaria kusǝɓa mǝnana à nongsǝi amur aɓi ka, nǝ tali amitis.<verse eid="REV 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 21:21" />Akunɓala lum-nong-ɓari mala nggea-là ka, à gilǝkia nǝ sala-ɓá-nkombo-nggeamùr; koya kunɓala ka, nǝ male yì ulangni sala-ɓá-nkombo mǝnana à pè nǝi ka. Sǝ njar mǝgule mǝnana aɓa nggea-là ka, à pè nǝ zǝnariya mǝnana ɓālǝi nong tyal-tyal nǝ ɓoarnsari kǝla gǝlas.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />Ən sǝn ma kǝ ndà-peri aɓa yì nggea-là ɗang, acemǝnana Mǝtalabangŋo Ɓakuli mǝnana Karmur Gulo kat andǝ Mǝgam ngga, à nda ka ndà-peri male. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />Sǝ yì nggea-là ka, pà nǝ̀ na ce pwari ko zongŋo ɓǝà tǎ amurí ɗàng, acemǝnana tǎ mala ɓoarɓwa mala Ɓakuli ka, kǝ pa tǎlaban aɓalǝi, sǝ Mǝgam ngga nda tǎlaban male.<note caller="+" style="f"><char style="fr" closed="false">21:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 24:23">Isha 24:23</ref>; <ref loc="ISA 60:1">60:1</ref>,<ref loc="ISA 60:19">19</ref></char>.</note> <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />Aɓwana mala anzali nǝ̀ gya aɓa tǎlaban male, sǝ amurǝma mala ɓanza nǝ̀ yiu nǝ agulo<note caller="+" style="f"><char style="fr" closed="false">21:24 </char><char style="fq" closed="false">agulo </char><char style="ft" closed="false">Ko &lt;&lt;aɓoarɓwa.&gt;&gt;</char></note> malea aɓalǝi. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />À pà nǝ̀ gìr akunɓala mala nggea-là ɗàng ko aya pwari ka, acemǝnana akanó ka, dù pà kàm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 60:11">Isha 60:11</ref></char>.</note> <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />Sǝ ɓoarɓwa andǝ gulo<note caller="+" style="f"><char style="fr" closed="false">21:26 </char><char style="fq" closed="false">gulo </char><char style="ft" closed="false">Ko &lt;&lt;Gǝna.&gt;&gt;</char></note> mala anzali ɓanza ka, à nǝ̀ yinǝia aɓalǝi. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />À pà nǝ̀ eare ɓè kǝgìr ɓeami ɓǝ̀ kútí kam ɗàng. Sǝ kǝɓwa pà kàm gbal mǝnana mǝ pakki agir kǝsǝkya na, ko mǝ ɗwanyi came amur mǝsǝcau na ka, nǝ̀ kútiô akano ɗàng; she kǝ aɓwana mǝnana lullǝia nda kam à gilǝnia aɓa Malǝmce Yilǝmu<note caller="+" style="f"><char style="fr" closed="false">21:27 </char><char style="fq" closed="false">Malǝmce Yilǝmu </char><char style="ft" closed="false">ka, nda malǝmce mǝnana aɓalǝi ka Ɓakuli gilǝkina alullǝ aɓwana mǝnana à nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char></note> mala Mǝgam ngga.<note caller="+" style="f"><char style="fr" closed="false">21:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 52:1">Isha 52:1</ref>; <ref loc="REV 3:5">Sǝn 3:5</ref></char>.</note><verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s">Yohana sǝn nggeasala <optbreak /> mala mùr yilǝmu</para>
  <para style="m">
    <verse number="1" style="v" sid="REV 22:1" />Ɗǝm ngga mǝturonjar lǝmdǝam nggeasala mala mùr pa yilǝmu. Mùr nî kwar gǝraɗau kǝla kǝrstal. Kǝ ɓun aban buno-murǝm mala Ɓakuli andǝ mala Mǝgam sǝ kǝ ɓangŋa. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />Ɓangŋa kǝ kútí nǝ ɓaɓalǝu mala njar mǝgule mala ɓá nggea-là. A koya nkaring mala kun mùr mala nggeasala ka, nggun nda kam mǝnana kǝ pa yilǝmu ka. Nggunî kǝ pusǝ a'ulang aɓǝle ɗàngɗáng lum-nong-ɓari aɓa pǝlǝa mwashat; koya zongŋo ka, kǝ pusǝ ulang male yì ɓǝle. Ambu nggunì ka ɓuri na ace walkwánó mala anzali mala aɓwapǝndǝa<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="fq" closed="false">ɓuri na ace walkwánó mala anzali mala aɓwapǝndǝa </char><char style="ft" closed="false">Ko &lt;&lt;nda ace twalban atanni mala aɓwapǝndǝa.&gt;&gt;</char></note>.<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 2:9">Tite 2:9</ref></char>.</note><verse eid="REV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3" />Súban ngga pà nǝ̀ pàk kàm ɗǝm amur kǝgìr aɓa mǝno yì nggea-là ka ɗàng. Ɓakuli nǝ nggearǝì, andǝ Mǝgam ngga, à nǝ̀ do aɓalǝi amur abuno-murǝm malea, sǝ aɓwana male nǝ̀ nggǝ peri a baní.<note caller="+" style="f"><char style="fr" closed="false">22:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 14:11">Zak 14:11</ref></char>.</note> <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />À nǝ̀ sǝn ɓamǝsǝi sǝ lùllǝì ka à nǝ̀ gilǝì a kundǝmbǝia.<note caller="+" style="f"><char style="fr" closed="false">22:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 17:15">Ang 17:15</ref></char>.</note> <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />Dù pà nǝ̀ nyare nǝ̀ pak ɗǝm ɗàng. À pà nǝ̀ earce pitǝla ko pwari ace pa tǎlaban ɗǝm ɗàng, acemǝnana Mǝtalabangŋo Ɓakuli ka, nda tǎlaban, nǝ̀ tǎ amúrià. Sǝ à nǝ̀ duk amurǝma masǝlǝate pà kàm ɗàng.<verse eid="REV 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />Pǝlǝa mǝturonjar banggàm ama:</para>
  <para style="pi" vid="REV 22:6">Amǝnia yì acau ka mǝsǝcau na sǝ à nǝ̀ earnǝia. Mǝtalabangŋo Ɓakuli mǝnana gingginǝ bangŋo mala amǝ'ɓangnǝa male ka, nda tasǝ mǝturonjar male ɓǝ̀ yì banggi aguro male, agir mǝnana à nǝ̀ yia pur púp banì pà nǝ̀ sau raka.<verse eid="REV 22:6" /></para>
  <para style="s">Yesu nia kǝ yiu ka</para>
  <para style="pi">
    <verse number="7" style="v" sid="REV 22:7" />Yesu kǝ na ama, <char style="wj">&lt;&lt;Wu sǝni, mǝ ndya ǝn nggǝ yiu adyan tù ka! Aɓwana mǝnana à kǝ kpata acau mala ɓangnǝa mǝnana à gilǝia aɓa mǝnia yì malǝmce ka, à ndanǝ tsǝkbu!&gt;&gt;</char><verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />Mim Yohana, mǝ nda mǝnana ǝn ó sǝ ǝn sǝn amǝnia yì agir ka. Lang ǝn ongŋǝnia sǝ ǝn sǝnǝnia ka, kara ǝn kpa a nzali mǝ nǝ peri a kusǝ mǝturonjar mala Ɓakuli mǝnana lǝmdǝam mia ka. <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />Sǝ yì ka, nam ama:</para>
  <para style="pi" vid="REV 22:9">Awo, kǝa peri abanam ɗang. Mǝ nda guro mala Ɓakuli, kǝla we wunǝ amǝ'eambo, amǝ'ɓangnǝa mala Ɓakuli, andǝ aɓwana mǝnana kat à kǝ kpata gir mǝnana à gilǝì aɓa mǝnia yì malǝmce ka. Peri aban Ɓakuli nǝmurǝì ɓǝ̀rɓǝ̀r!<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />Pǝlǝa kwarkiram ama:</para>
  <para style="pi" vid="REV 22:10">Kǝa na ama awu nǝ sǝmbǝrǝ ce acau mala ɓangnǝa mǝnana aɓa malǝmce mǝnia ka ɗàng, acemǝnana pwari gbàshìnà tù mana amǝnia yì agir kat ka à nǝ̀ kumban ngga.<verse eid="REV 22:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 22:11" />Ɓwa mǝnana kat kǝ pak gìr mǝɓane ka, ɓǝ̀ lidǝmba aɓa pàkkiagir mǝɓane. Ɓwa mǝnana kat mǝɓealɓikea na ka, ɓǝ̀ lidǝmba aɓa ɓealɓikea male. Ɓwa mǝnana mǝɓealɓoarna na ka, ɓǝ̀ lidǝmba aɓa do-ɓealɓoarna. Ɓwa mǝnana tàr ɓamúrì ɓǝ̀ duk mala Ɓakuli ka, ɓǝ̀ lidǝmba aɓa do tàr ɓamuru aban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">22:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 12:10">Dan 12:10</ref></char>.</note><verse eid="REV 22:11" /></para>
  <para style="mi">
    <verse number="12" style="v" sid="REV 22:12" />Yesu kǝ na ama, <char style="wj">&lt;&lt;Wu sǝni, mǝ ndya ǝn nggǝ yiu adyan tù ka! Atangnakusǝu mem na a buam, mǝ nǝ yia pè koya ɓwa ka tangnakusǝi mala gìr mǝnana karǝ arǝ túró mǝnana pàk ka.</char><note caller="+" style="f"><char style="fr" closed="false">22:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:10">Isha 40:10</ref>; <ref loc="JER 17:10">Ir 17:10</ref></char>.</note> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><char style="wj">Mǝ nda Alfa andǝ Omega, Mǝdǝmba andǝ Mǝtankwang, Tite andǝ Masǝlǝate.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 44:6">Isha 44:6</ref>; <ref loc="ISA 48:12">48:12</ref></char>.</note><verse eid="REV 22:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="REV 22:14" />Aɓwana mǝnana à kǝ lákkí anggea-daura malea, à do aɓa ɓoarnsari mala ɓabum ngga, à ndanǝ tsǝkbu. Ɓakuli nǝ̀ nyinggia wia ban arǝ kunɓala ɓǝà kutio aɓa yì nggea-là sǝ ɓǝà lì ɓǝlanggun mala nggun yilǝmu. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />A nza nǝ nggea-là ka à nda ka amǝ do kiɗìkì kǝla anvwa, andǝ amǝ pakkia gir monzǝo, andǝ amǝ pak cauɓikea nonggi nǝ rǝarǝu, andǝ amǝ walki-alú, andǝ amǝ peri aban ankúl andǝ alú, andǝ aɓwana mǝnana kat à kǝ earce pak túró nyir, sǝ amǝ swarkiban na ka.<verse eid="REV 22:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="REV 22:16" />
    <char style="wj">Mim Yesu, ǝn túr mǝturonjar mem ɓǝ̀ bangga wun amǝnia yì agir ka ace a'ikǝlisiya. Mǝ nda Mǝkà Murǝm Dauda, ǝn pur a tàu male. Mǝ nda nlero dǝmbari mǝ tàne.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:16 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 11:1">Isha 11:1</ref>,<ref loc="ISA 11:10">10</ref></char>.</note><verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />Bangŋo mala Ɓakuli andǝ Māfela, à kǝ na ama, &lt;&lt;Yiu!&gt;&gt;</para>
  <para style="p" vid="REV 22:17">Ɓwa mǝnana kat ok mǝnia yì cau ka, ɓǝ̀ na ama &lt;&lt;Yiu!&gt;&gt;</para>
  <para style="p" vid="REV 22:17">Ɓǝ̀ mǝsamur wal kǝɓwa ka, ɓǝ̀ yiu! Ɓwa mǝnana earce ka, ɓǝ̀ yi nu mur yilǝmu ɓà.<note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 55:1">Isha 55:1</ref></char>.</note><verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />Ən nggǝ nunkir koya ɓwa na kat kǝ ok acau mala ɓangnǝa mǝnana à gilǝia aɓa malǝmce mǝnia ka:</para>
  <para style="pi" vid="REV 22:18">Ɓǝ̀ kǝɓwa tsǝk ɓe amur agir mǝnana à gilǝe akani ka, Ɓakuli nǝ̀ tsǝki wi ɓe amur agir yinǝ tanni twal la mǝnana à kanicea aɓa mǝnia yì malǝmce ka. <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />Sǝ ɓǝ̀ kǝɓwa amsǝ ɓekǝ gìr aɓalǝ acau mala malǝmce ɓangnǝa mǝnia ka, Ɓakuli nǝ̀ amsǝi wi kāmbe male. Pà nǝ̀ kùmô nǝ̀ li ɓǝlanggun yilǝmu ɗang, sǝ pà nǝ̀ kutio aɓa nggea-là mǝfele mǝnana à kaniki ce aɓa mǝnia yì malǝmce ka ɗang.<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />Yì, yì ɓwa mǝnana kǝ bang ama amǝnia yì agir ka mǝsǝcau na ka, kǝ na ama, <char style="wj">&lt;&lt;E, mǝ ndya ǝn nggǝ yiu adyan tù ka!&gt;&gt;</char></para>
  <para style="p" vid="REV 22:20">&lt;&lt;Ɓǝ̀ do anggo! Yiu, Mǝtalabangŋo Yesu!&gt;&gt;<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />Ɓǝ̀ ɓwamuru mala Mǝtalabangŋo Yesu do atà aɓwana mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2TH 3:18">2Tas 3:18</ref></char>.</note><verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>