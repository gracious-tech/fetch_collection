<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Mbula</book>
  <para style="h">Matiu</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matiu</para>
  <para style="toc1">Cau Amsǝban a nê mala Matiu</para>
  <para style="mt2">Cau Amsǝban a nê mala</para>
  <para style="mt1">MATIU</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Cau Amsǝban a nê mala Matiu</char> ka kǝ na sǝm cau mǝɓoarne mǝnana ama Yesu nda Mǝ'amsǝban mana Ɓakuli pàcau ace, sǝ ɗǝm ngga ama yì nda ɓwa mǝnana nǝbani sǝ Ɓakuli lùmsǝ apàcau male mǝnana pea aɓwana male mana a nza mala Kùrcau Mǝ'e ka. Mǝnia yì bǝsa cau mǝɓoarne mǝnana yiu nǝ amsǝban ngga pa ace amǝ Yahudi, aɓwana mǝnana à ɓǝl Yesu sǝ gul aɓalǝia ka, nǝmurǝia ɗang, nda gbal ace ɓanza puppup.</para>
  <para style="ip">
    <char style="bk">Acau ɓá malǝmce mala Matiu</char> ka à nongsǝia nǝ tsǝkiru pepe aɓa sǝlǝpe. Tite nǝ ɓǝlban mala Yesu, yi bangce batisǝma andǝ kārǝkiban male, pǝlǝa yi twal acau mala túró hama, andǝ kanigir, andǝ twalban rǝkwana mala aɓwana a Galili. Anzǝm mǝnia ka <char style="bk">Cau Amsǝban mala Matiu </char> ka nyoulǝ cau mala gya mala Yesu twal a Galili aban ká a Urǝshalima, andǝ mala agir mǝnana à kumban aɓa limo mǝ'nzǝ́moè mala Yesu, sǝ yi masǝlǝi arǝ cau mala gballe a nggun andǝ loapi ɓembe male.</para>
  <para style="ip">Mǝnia yì Cau Amsǝban ngga nda ban lǝmdǝ ama Yesu ka nggea Mǝkanigir mǝgule na, mǝnana ndanǝ rǝcandǝa mala mǝngi ɓá Nggurcau mala Ɓakuli, andǝ kanigir amur Domurǝm mala Ɓakuli ka.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Tau andǝ ɓǝlban mala Yesu Kǝrǝsti<char style="ior"><ref loc="MAT 1:1-2:23">1:1--2:23</ref></char></para>
  <para style="io1">Túró mala Yohana Mǝbatisǝma<char style="ior"><ref loc="MAT 3:1-12:50">3:1--12:50</ref></char></para>
  <para style="io1">Batisǝma andǝ kārǝkiban mala Yesu<char style="ior"><ref loc="MAT 3:13-4:11">3:13--4:11</ref></char></para>
  <para style="io1">Túró mala Yesu a ban aɓwana a Galili<char style="ior"><ref loc="MAT 4:12-18:35">4:12--18:35</ref></char></para>
  <para style="io1">Gya mala Yesu twal a Galili aban ká Urǝshalima<char style="ior"><ref loc="MAT 19:1-20:34">19:1--20:34</ref></char></para>
  <para style="io1">Limo mǝ'nzǝ́moè mala Yesu tù nǝban Urǝshalima<char style="ior"><ref loc="MAT 21:1-27:66">21:1--27:66</ref></char></para>
  <para style="io1">Loapi ɓembe andǝ lǝmdǝrǝu mala Mǝtalabangŋo<char style="ior"><ref loc="MAT 28:1-20">28:1-20</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Tau mala Yesu</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luka 3:23-38</ref>)</para>
  <para style="m">
    <verse number="1" style="v" sid="MAT 1:1" />Aɓa malǝmce ka tàu mǝnana Yesu Kǝrǝsti, Mǝkà Dauda, Mǝkà Ibǝrayim, pùr kàm ngga ndya ka:<verse eid="MAT 1:1" /></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />Ibǝrayim ɓǝl Ishaku,</para>
  <para style="li1" vid="MAT 1:2">Ishaku ɓǝl Yakupu,</para>
  <para style="li1" vid="MAT 1:2">Yakupu ɓǝl a Yahuda</para>
  <para style="q1" vid="MAT 1:2">andǝ amǝ'eambi,<verse eid="MAT 1:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda ɓǝl Parisa</para>
  <para style="q1" vid="MAT 1:3">andǝ Zera.</para>
  <para style="q1" vid="MAT 1:3">Nggea nda Tamar.</para>
  <para style="li1" vid="MAT 1:3">Parisa nda tár Hezǝron,</para>
  <para style="li1" vid="MAT 1:3">Hezǝron ɓǝl Ram,<verse eid="MAT 1:3" /></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4" />Ram ɓǝl Aminadap,</para>
  <para style="li1" vid="MAT 1:4">Aminadap ɓǝl Nashon,</para>
  <para style="li1" vid="MAT 1:4">Nashon ɓǝl Salmon,<verse eid="MAT 1:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5" />Salmon ɓǝl Boaza.</para>
  <para style="q1" vid="MAT 1:5">Ngge nda Rahap.</para>
  <para style="li1" vid="MAT 1:5">Boaza ɓǝl Obet.</para>
  <para style="q1" vid="MAT 1:5">Nggea Obet nda Rut.</para>
  <para style="li1" vid="MAT 1:5">Obet ɓǝl Jeshi,<verse eid="MAT 1:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6" />Sǝ Jeshi yi ɓǝl murǝm</para>
  <para style="q1" vid="MAT 1:6">Dauda.</para>
  <para style="li1" vid="MAT 1:6">Dauda ɓǝl Solomon.</para>
  <para style="q1" vid="MAT 1:6">Nggea Solomon ɗiɗyal ka</para>
  <para style="q1" vid="MAT 1:6">mā-lú mala Yuriya na.<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="RUT 4:18-22">Rut 4:18-22</ref>; <ref loc="1CH 2:1-15">1Acau 2:1-15</ref></char>.</note><verse eid="MAT 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7" />Solomon ɓǝl Riabwam.</para>
  <para style="li1" vid="MAT 1:7">Riabwam ɓǝl Abija.</para>
  <para style="li1" vid="MAT 1:7">Abija ɓǝl Asa.<verse eid="MAT 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8" />Asa ɓǝl Jehoshafat.</para>
  <para style="li1" vid="MAT 1:8">Jehoshafat ɓǝl Joram.</para>
  <para style="li1" vid="MAT 1:8">Joram ɓǝl Uzziya.<verse eid="MAT 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9" />Uzziya ɓǝl Jotam.</para>
  <para style="li1" vid="MAT 1:9">Jotam ɓǝl Ahas.</para>
  <para style="li1" vid="MAT 1:9">Ahas ɓǝl Hezekiya,<verse eid="MAT 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10" />Hezekiya ɓǝl Manasa.</para>
  <para style="li1" vid="MAT 1:10">Manasa ɓǝl Amon.</para>
  <para style="li1" vid="MAT 1:10">Amon ɓǝl Josiya,<verse eid="MAT 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11" />sǝ Josiya yi ɓǝl Jekonaya</para>
  <para style="q1" vid="MAT 1:11">andǝ amǝ'eambi</para>
  <para style="q1" vid="MAT 1:11">(a bàkú mana a bwal amǝ</para>
  <para style="q1" vid="MAT 1:11">Isǝrayila a nzali malea</para>
  <para style="q1" vid="MAT 1:11">à um nǝia guro</para>
  <para style="q1" vid="MAT 1:11">a nzali Babila ka).<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 24:14">2Amur 24:14</ref>,<ref loc="2KI 24:15">15</ref>; <ref loc="2CH 36:10">2Acau 36:10</ref>; <ref loc="JER 27:19-21">Ir 27:19-21</ref></char>.</note><verse eid="MAT 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />A nzǝm mana à umna nǝia</para>
  <para style="q1" vid="MAT 1:12">a Babila ka</para>
  <para style="li1" vid="MAT 1:12">Jekonaya ɓǝl Shaltiyel.</para>
  <para style="li1" vid="MAT 1:12">Shaltiyel ɓǝl Jerubabel.<verse eid="MAT 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13" />Jerubabel ɓǝl Abiuda.</para>
  <para style="li1" vid="MAT 1:13">Abiuda ɓǝl Iliyakim.</para>
  <para style="li1" vid="MAT 1:13">Iliyakim ɓǝl Azura.<verse eid="MAT 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14" />Azura ɓǝl Zadok.</para>
  <para style="li1" vid="MAT 1:14">Zadok ɓǝl Akim.</para>
  <para style="li1" vid="MAT 1:14">Akim ɓǝl Eliyu.<verse eid="MAT 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliyu ɓǝl Eleaza.</para>
  <para style="li1" vid="MAT 1:15">Eleaza ɓǝl Matan.</para>
  <para style="li1" vid="MAT 1:15">Matan ɓǝl Yakupu.<verse eid="MAT 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16" />Sǝ Yakupu yi ɓǝl Yisǝfu,</para>
  <para style="q1" vid="MAT 1:16">bura Maryamu.</para>
  <para style="li1" vid="MAT 1:16">Maryamu nda yi ɓǝl Yesu,</para>
  <para style="q1" vid="MAT 1:16">mana à tunǝki ama Kǝrǝsti ka.<verse eid="MAT 1:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 1:17" />Lǝmdǝ ama tite arǝ Ibǝrayim yi bwal ban Dauda ka anza lum-nong-ine na. Sǝ lo a ban Dauda yi bwal bákú mala pwanban aban o a Babila ka anza lum-nong-ine na. Sǝ lo a bàkú mala pwanban aban o a Babila yi bwal ban Kǝrǝsti ka anza lum-nong-ine na.<verse eid="MAT 1:17" /></para>
  <para style="s">Ɓǝlban mala Yesu Kǝrǝsti</para>
  <para style="r">(<ref loc="LUK 2:1-17">Luka 2:1-17</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ani sǝ ɓǝl Yesu Kǝrǝsti pa. Nggè, yì Maryamu ka Yisǝfu pùr amurí nǝ̀ ali. Maryamu ka malaká yiu a ɓala mala Yisǝfu peatu ɗàng, sǝ muna kpa a bumi nǝ kanì mala Bangŋo Mǝfele. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Burí Yisǝfu, acemǝnana yì ka, ɓwa mǝɓoarne na ka, eare ama nǝ̀ pè wi kirsakya a mǝsǝ aɓwana ɗàng. Yì ka, pàk ɗenyicau ama à nǝ̀ gauwa aɓa sǝmbǝrǝa.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Lang nda mur mǝnia yì ɗenyicau ka, mǝturonjar mala Mǝtalabangŋo yi pusǝrǝi a baní a lòrǝo. Mǝturonjar banggi wi ama, &lt;&lt;Yisǝfu Mǝkà Dauda, ɓangciu ɓǝ̀ kǝa pakko arǝ twal Maryamu ɓǝ̀ duk māmó ɗàng. Acemǝnana muna mana a bumi ka pě mala Bangŋo Mǝfele na. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Yì ka, nǝ̀ ɓǝl muna-ɓwabura, sǝ awu nǝ tsǝki wi lullǝu ama Yesu, acemǝnana nǝ̀ yia amsǝ aɓwana male aɓalǝ acauɓikea malea ka.&gt;&gt;<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Agir mǝnia kat ka à yì pa anggo ace mǝnana ɓǝà lùmsǝ cau mala Mǝtalabangŋo mana puro a kún mǝɓangnǝa male ama:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />&lt;&lt;Nsari nǝ̀ kum muna-bum,</para>
  <para style="q2" vid="MAT 1:23">nǝ̀ ɓǝl muna-ɓwabura,</para>
  <para style="q1" vid="MAT 1:23">à nǝ̀ tunǝi ama Immanuyel,&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 7:14">Isha 7:14</ref></char>.</note></para>
  <para style="q2" vid="MAT 1:23">ɓālǝi ama,</para>
  <para style="q1" vid="MAT 1:23">&lt;&lt;Ɓakuli nda atà sǝm.&gt;&gt;<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Lang Yisǝfu loapi ntulo ka, pàk gìr mana mǝturonjar mala Mǝtalabangŋo banggi wi ka; twal Maryamu ɓǝ̀ duk māmí. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Sǝ yì ka, pak ɓwama nǝi ɗang yi pur a gbáshí muna-ɓwabura male, pǝlǝa tsǝki muna lullǝu ama Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Amǝ'sǝlǝe amur anlero <optbreak /> yiua sǝn Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />À ɓǝl Yesu a Betalami, a nzali Yahudi, a bàkú mǝnana Hirǝdus nda murǝm ngga. Tù anzǝm ɓǝl Yesu ka, amǝ'sǝlǝe amur anlero pur nǝ takuli sǝ à yiu a Urǝshalima, <figure style="fig" alt="Wise men from the East who came to see Jesus" file="CN01629b.tif" size="col" loc="2:1" copy="Cook NT Images" ref="Matiu 2:1">Amǝ'sǝle mana à pur nǝ takuli à yiua sǝn Yesu ka</figure> <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />à yì ɗiban ama, &lt;&lt;Murǝm mala amǝ Yahudi mǝnana à loa ɓǝle ka, nda ake? Sǝm sǝn nlero mala ɓǝle a takuli, nda sǝm yiua peri a baní ka.&gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Lang murǝm Hirǝdus ok mǝnia yì cau ka, ban ɓiki wi andǝ aɓwana kat a Urǝshalima mǝnana à ok ce ka. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Pǝlǝa tunǝ agbani pǝris andǝ amǝ'kànì Nggurcau rambia, sǝ ɗia cè ban mǝnana à nǝ̀ ɓǝl Kǝrǝsti kàm ngga. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Sǝ à ne wi ama, &lt;&lt;A Betalami a bu-nzali Yahudi. Mǝnia ka nda cau mǝnana mǝɓangnǝa mala Ɓakuli gilǝ ka:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />&lt;&lt; &lt;We Betalami,</para>
  <para style="q1" vid="MAT 2:6">a nzali Yahudi,</para>
  <para style="q2" vid="MAT 2:6">a gatti pale ɗàng</para>
  <para style="q1" vid="MAT 2:6">atà amurǝma</para>
  <para style="q2" vid="MAT 2:6">mala nzali Yahudi.</para>
  <para style="q1" vid="MAT 2:6">Acemǝnana a ɓālǝo</para>
  <para style="q2" vid="MAT 2:6">sǝ murǝm nǝ̀ puro,</para>
  <para style="q1" vid="MAT 2:6">mǝnana nǝ̀ yál</para>
  <para style="q2" vid="MAT 2:6">aɓwana mem</para>
  <para style="q2" vid="MAT 2:6">amǝ Isǝrayila ka.&gt;<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MIC 5:2">Mik 5:2</ref></char>.</note>&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Hirǝdus pǝlǝa tunǝ amǝ'sǝlǝgir mǝnia ka aɓa sǝmbǝrǝa sǝ ɗia pepè pwari mana à sǝna nleroe nǝi ka. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Pǝlǝa nea wia ama, &lt;&lt;Wu kyane a Betalami wu kya alta ban munê ɓukɓuk, ɓǝ̀ wu kumǝni ka, wu nyare wu yi banggàm, mim gbal ka mǝ nǝ ká peri a baní.&gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Lang à ongŋǝna cau mala murǝm ngga, à pǝlǝa à bwal njar malea aban o. Sǝ à nda rǝ o ka, kara à sǝn nlero mǝnana à sǝni ɗiɗyal a takuli ka, puro akia wia dǝmba aban ká, sǝ yi came amur ban mǝnana munê pàk kàm ngga. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Banɓoaria wia kǝ̀rkǝ́r arǝ sǝn mǝnia yì nlero ka. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />À nǝ̀ kutio a ɓala ka, à sǝn muna andǝ ngge Maryamu, sǝ à ɓunno a ɓadǝmbi, à peri. Pǝlǝa à panzǝki agǝna malea sǝ à pè wi aɓoro mala bolo-njengǝlan, andǝ myang-kwarra andǝ mǝr. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ɓakuli nunkiria a lòrǝo ama ɓǝà kǝa nyare a ban Hirǝdus ɗàng. Pǝlǝa à twal ɓè njargula ɗàng à nyare a nzali malea.<verse eid="MAT 2:12" /></para>
  <para style="s">À ɓang nǝ Yesu à um <optbreak /> nǝi a nzali Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Lang amǝ'sǝlǝe amur anlero umna ka, mǝturonjar mala Mǝtalabangŋo pusǝrǝi a ban Yisǝfu a lòrǝo sǝ banggi wi ama, &lt;&lt;Lo twal muna andǝ ngge wu ɓangŋa wu o a nzali Masar. Wu duk kano she ɓǝ̀n bangŋǝno ama wu nyar ka, acemǝnana Hirǝdus ka nda nǝ̀ nggá alta muna ama nǝ̀ wal-luí.&gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Sǝ Yisǝfu lo twal muna andǝ ngge àkǝ̀ bu dui sǝ à o a nzali Masar. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Akanó sǝ kya do bà lú mala Hirǝdus. Mǝnia ka yi lumsǝ cau mala Mǝtalabangŋo mana pur a kun mǝɓangnǝa male ama,</para>
  <para style="pc" vid="MAT 2:15">&lt;&lt;Aɓa nzali Masar sǝ ǝn tunǝ munem.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 11:1">Hos 11:1</ref></char>.</note><verse eid="MAT 2:15" /></para>
  <para style="s">Hirǝdus wal amuna-burana <optbreak /> amǝkèke a Betalami</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Lang Hirǝdus yi sǝlǝ ama amǝno yì amǝ'sǝlǝgir ɓosǝkini ka, bumi lul kǝ̀rkǝ́r. Pǝlǝa tasǝ asoje a Betalami andǝ alá mana a nkanggari ka à wal-lú amuna-burana mǝkèke mǝnana kat pǝlǝa malea ɓari andǝ a mǝnana à bwal raka, kārǝí arǝ pwari mǝnana ongŋǝna cê nǝi a kun amǝ'sǝlǝgir ka.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Aɓa mǝno anggo ka sǝ cau mǝnana pur a kun Irimiya mǝɓangnǝa ka yi lumsǝo, mana ama:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;&lt;À ok ɓuà mala</para>
  <para style="q2" vid="MAT 2:18">ɓeɓwa a Rama,</para>
  <para style="q1" vid="MAT 2:18">ɓuà keban andǝ</para>
  <para style="q2" vid="MAT 2:18">bumkiɗikea mǝ'kǝ̀rkǝ́r nì.</para>
  <para style="q1" vid="MAT 2:18">Rahila na kǝ ɓuà</para>
  <para style="q2" vid="MAT 2:18">ace amuni ka.</para>
  <para style="q1" vid="MAT 2:18">Ɓinǝ girikiban,</para>
  <para style="q2" vid="MAT 2:18">acemǝnana à wukina kat.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 31:15">Ir 31:15</ref></char>.</note><verse eid="MAT 2:18" /></para>
  <para style="s">Yisǝfu andǝ Maryamu twal <optbreak /> Yesu a nyare a Nazarat</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />A nzǝm lú mala Hirǝdus ka, mǝturonjar mala Mǝtalabangŋo pusǝrǝi a ban Yisǝfu a lòrǝo a nzali Masar. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Mǝturonjar ne wi ama, &lt;&lt;Lo twal muna andǝ ngge, nyare a nzali Isǝrayila, ace mǝnana Hirǝdus andǝ aɓwana mana à alkiyita yilǝmi muna ka à wukina.&gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Pǝlǝa Yisǝfu lo twal muna andǝ ngge, sǝ à nyare a nzali Isǝrayila. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Sǝ lang Yisǝfu ok ama Arkilawus nda duk murǝm Yahudi a nzǝm lú mala tárrí Hirǝdus ka, ɓangciu pakki wi arǝ ká a Yahudi. Sǝ mǝturonjar nunkiri a lòrǝo ka, pǝlǝa o a buì mala amǝ Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Nda à wario à kya do a ɓekǝ là mǝnana à tunǝki ama Nazarat ka. Mǝnia ka nda lùmsǝ cau mala amǝ'ɓangnǝa mala Ɓakuli mana ama, &lt;&lt;À nǝ̀ tunǝi ama ɓwa Nazarat.&gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yohana Mǝbatisǝma <optbreak /> gilǝki njar ace Yesu</para>
  <para style="r">(<ref loc="MRK 1:1-8">Markus 1:1-8</ref>; <ref loc="LUK 3:1-18">Luka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohana 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Arǝ abákú mǝno ka, Yohana Mǝbatisǝma yiu kǝ hamnǝ cau aɓa pǝɗanban a njenza a bu-nzali Yahudi <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />kǝ na ama, &lt;&lt;Wu pwanzali wu pǝlǝ nzǝm wun arǝ acauɓikea ma'wun, ace mǝnana Domurǝm mala kùli gbashina.&gt;&gt; <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana Mǝbatisǝma ka nda ɓwa mǝnana Ishaya mǝɓangnǝa mala Ɓakuli bang ce ama:</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Ɓè ɓwa kǝ hama</para>
  <para style="q2" vid="MAT 3:3">nǝ giu mǝcandǝe</para>
  <para style="q2" vid="MAT 3:3">aɓa pǝɗanban a njenza kǝ na ama,</para>
  <para style="q1" vid="MAT 3:3">&lt;Wu gilǝki tanjar</para>
  <para style="q2" vid="MAT 3:3">mala Mǝtalabangŋo.</para>
  <para style="q1" vid="MAT 3:3">Wu tamsǝ anjarkusǝu ace</para>
  <para style="q2" vid="MAT 3:3">pǝrapǝra.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:3">Isha 40:3</ref></char>.</note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Agir-nggūrǝu mala Yohana mana oasǝ ka à tea nǝ nyang kalakadambi. Nggur-ɓunu male ka nggú na. Girlina male ka doshi na andǝ nyi-pu.<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 1:8">2Amur 1:8</ref></char>.</note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ɓwapǝndǝa pur aɓa nggea-là Urǝshalima, andǝ aɓea la a bu-nzali Yahudi kat, andǝ bareban mala Nggeasala Jodan kat, à o a baní. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />À bang acauɓikea malea, sǝ pakkia wia batisǝma a Nggeasala Jodan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Sǝ lang Yohana sǝn amǝ Farisi andǝ amǝ Saduki à nǝ̀ nggǝ yiu pas a baní ace mǝnana ɓǝà pakkia wia batisǝma ka, nea wia ama, &lt;&lt;Wun amuna an'yau barya! Yan nun kir wun ama ɓǝ̀ wu ɓanggi ɓashi mala Ɓakuli mǝnana kǝ yiu ka?<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:34">Mat 12:34</ref>; <ref loc="MAT 23:33">23:33</ref></char>.</note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Wu pak agir mǝnana à nǝ̀ lǝmdǝ ama wu pwana'nzali, wu ɗekina acauɓikea ma'wun ngga. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Sǝ wu kǝa sǝni kǝla ɗenyicau ma'wun mǝnana ama Ibǝrayim ngga kà wun na ka, nǝ̀ amsǝ wun ɗàng. Ən nggǝ bangga wun, Ɓakuli nǝ̀ gandǝ loasǝ atali mǝnia à nǝ̀ pǝlǝì Ibǝrayim amǝkau. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ko ado ka Ɓakuli kwakina kun bero a tǝr anggun. Nggun mǝnana kat pusǝ ɓǝle mǝɓoarne raka, à nǝ̀ kwarí à nǝ̀ túrí a bǝsa.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />&lt;&lt;Ən nggǝ pakka wun batisǝma nǝ mur mǝnana nǝ̀ lǝmdǝ ama wu nyìngŋǝ̀nà acauɓikea ma'wun. Nǝnzǝ́mò ka, ɓeɓwa nda nǝ̀ nggá yiu mǝnana kútiǎm nǝ bangŋo ka, mǝnana yàle nkura kusǝì ka ǝn kārǝa mǝ bwali a buam ɗàng. Yì ka, nǝ̀ yia pakka wun batisǝma nǝ Bangŋo Mǝfele andǝ bǝsa. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Kwar sarǝgir male nda a buì, nǝ̀ yia pusǝ kwá arǝ mǝsǝsa a katǝra, nǝ̀ so mǝsǝsa a bà, sǝ kwá ka nǝ̀ pisǝì a bǝsa mǝnana pà nǝ̀ limgi raka.&gt;&gt;<verse eid="MAT 3:12" /></para>
  <para style="s">Yohana pakki Yesu batisǝma</para>
  <para style="r">(<ref loc="MRK 1:9-11">Markus 1:9-11</ref>; <ref loc="LUK 3:21-22">Luka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Aɓalǝ anonggio mǝno ka, Yesu pur a Galili sǝ yiu a Nggeasala Jodan ace mǝnana Yohana ɓǝ̀ yi pakki wi batisǝma ka. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Sǝ Yohana ka ɓariki ama nǝ̀ ɓinǝi wi. Ne wi ama, &lt;&lt;Mim ɓwan mǝ nǝ ká a bano ace batisǝma ka a nyare a yiu a banam mǝ pakko batisǝma!&gt;&gt;<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Sǝ Yesu pa eare ka ne wi ama, <char style="wj">&lt;&lt;Ɗeki ɓǝ̀ pa ana adyan. Anggo ka sǝ sǝm nǝ̀ lùmsǝ agir mǝnana kat Ɓakuli earkicea ka.&gt;&gt;</char> Pǝlǝa Yohana eare pakki wi batisǝma.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Lang Yohana malǝna pàkkî Yesu batisǝma, sǝ Yesu eapi mur ani ka, kara kùli mǝnna sǝ sǝn Bangŋo mala Ɓakuli aban sulǝo kǝla kutu, yi do amurí. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Aɓwana ok gi Ɓakuli nacau a kùli ama, &lt;&lt;Mǝnia ka nda Munem, mǝnana ǝn earkiyice, mǝnana bumam kǝ pwasǝa rǝì kǝ̀rkǝ́r ka.&gt;&gt;<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Shetan kārǝki Yesu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Markus 1:12-13</ref>; <ref loc="LUK 4:1-13">Luka 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Pǝlǝa Bangŋo Mǝfele loasǝ Yesu um nǝi aɓa pǝɗanban a ɓabondo ace mǝnana Shaitan ɓǝ̀ kya kārǝki ka.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 2:18">Ib 2:18</ref>; <ref loc="HEB 4:15">4:15</ref></char>.</note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Sǝ lang Yesu gilnamur pwari lumi-ine andǝ du lumi-ine ka, nzala wali kǝ̀rkǝ́r. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Mǝkārǝkiban pǝlǝa yiu a baní sǝ ne wi ama, &lt;&lt;Ɓǝ̀ a nda muna mala Ɓakuli ka, banggi atali mǝnia ɓǝà pǝlǝ nɗǝmo.&gt;&gt;<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Sǝ Yesu nyesǝi wi ama, <char style="wj">&lt;&lt;À gilǝ a Malǝmce mala Ɓakuli ama: </char></para>
  <para style="q1" vid="MAT 4:4">
    <char style="wj">&lt;&lt; &lt;Girlina nda nǝmurǝì</char></para>
  <para style="q2" vid="MAT 4:4">
    <char style="wj">tsǝkiyi ɓwa sǝ nǝ̀ dum </char></para>
  <para style="q2" vid="MAT 4:4">
    <char style="wj">nǝ yilǝmu ka ɗàng.</char></para>
  <para style="q1" vid="MAT 4:4">
    <char style="wj">Nda andǝ cau mǝnana </char></para>
  <para style="q2" vid="MAT 4:4">
    <char style="wj">kat kǝ pur a kun Ɓakuli ka.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:4 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DEU 8:3">Nggur 8:3</ref>
      </char>.</note> &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Pǝlǝa Shetan wari nǝ Yesu aɓa Urǝshalima nggea-là mǝfele, sǝ kya tamsǝi a ɓong Ndàmǝgule mala Ɓakuli, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />sǝ ne wi ama, &lt;&lt;Ɓǝ̀ a nda Muna mala Ɓakuli ka ta zurro a nzali! Acemǝnana à gilǝ aɓa Malǝmce mala Ɓakuli ama,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt; &lt;Ɓakuli nǝ̀ tsǝk amǝturonjar</para>
  <para style="q2" vid="MAT 4:6">male ɓǝ̀a tsǝkiro.</para>
  <para style="q1" vid="MAT 4:6">À nǝ̀ eo a ɓabuia,</para>
  <para style="q2" vid="MAT 4:6">ace mǝnana wu kǝa</para>
  <para style="q2" vid="MAT 4:6">tul kusǝo arǝ tali raka.&gt;<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 91:11">Ang 91:11</ref>,<ref loc="PSA 91:12">12</ref></char>.</note> &gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Sǝ Yesu pǝlǝi wi ama, <char style="wj">&lt;&lt;Malǝmce mala Ɓakuli bang gbal ama,</char></para>
  <para style="q1" vid="MAT 4:7">
    <char style="wj">&lt;&lt; &lt;Ce a kārǝki Mǝtalabangŋo </char></para>
  <para style="q2" vid="MAT 4:7">
    <char style="wj">Ɓakuli mo ɗang.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:7 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DEU 6:16">Nggur 6:16</ref>
      </char>.</note> &gt;&gt;<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Shetan nyar ɗǝm wari nǝ Yesu a ɓong ɓekǝ nkono nggea mǝ'dāhre, pǝlǝa lǝmdǝki wi ala-murǝm mǝnana kat a ɓanza ka andǝ gulo andǝ gǝna mǝnana aɓalǝia ka kat. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Sǝ ne wi ama, &lt;&lt;Ɓǝ̀ awu nǝ ɓun a ɓadǝmbam sǝ a nǝ peri a banam ngga, mǝ nǝ po amǝnia yì agir ka kat.&gt;&gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Yesu ne wi ama, <char style="wj">&lt;&lt;Shetan, upi banam! Malǝmce mala Ɓakuli ka na ama,</char></para>
  <para style="q1" vid="MAT 4:10">
    <char style="wj">&lt;&lt; &lt;Peri a ban Mǝtalabangŋo </char></para>
  <para style="q2" vid="MAT 4:10">
    <char style="wj">Ɓakuli mo,</char></para>
  <para style="q1" vid="MAT 4:10">
    <char style="wj">Kǝ yì mwashat ɓǝ̀rɓǝ̀r na </char></para>
  <para style="q2" vid="MAT 4:10">
    <char style="wj">a nǝ kpate ka.&gt; &gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4:10 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DEU 6:13">Nggur 6:13</ref>
      </char>.</note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Nda sǝ Shetan ɗekina Yesu ka, sǝ amǝturonjar yiu à yì bwalì wi kàm.<verse eid="MAT 4:11" /></para>
  <para style="s">Tita túró mala Yesu a Galili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Markus 1:14-15</ref>; <ref loc="LUK 4:14-15">Luka 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Lang Yesu ongŋǝna ama murǝm Hirǝdus Antipas kùrna Yohana a ndàkurban ngga, lo ɗeki nzali Yahudi o a bu-nzali Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Banì sau a Nazarat ɗang, tùro kya do a Kapanahum, a kun Garang Galili a buì mala amǝ Zebulu andǝ amǝ Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Mǝnia ka pa anggo ace mǝnana ɓǝà lùmsǝ cau mana pur a kun Ishaya mǝɓangnǝa mala Ɓakuli ka ama:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;&lt;Wu kwaki kir wun,</para>
  <para style="q1" vid="MAT 4:15">wun amǝ nzali Zebulu</para>
  <para style="q2" vid="MAT 4:15">andǝ Naftali.</para>
  <para style="q1" vid="MAT 4:15">Wun aɓwana mǝnana</para>
  <para style="q2" vid="MAT 4:15">wu do amur njargula ká</para>
  <para style="q1" vid="MAT 4:15">a kun Garang,</para>
  <para style="q2" vid="MAT 4:15">a nkaring Mur Jodan ngga.</para>
  <para style="q1" vid="MAT 4:15">Wu kwaki kir wun,</para>
  <para style="q2" vid="MAT 4:15">wun amǝ Galili,</para>
  <para style="q1" vid="MAT 4:15">la mala aɓwana mana</para>
  <para style="q2" vid="MAT 4:15">amǝ Yahudi na raka.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Aɓwana mǝnana</para>
  <para style="q2" vid="MAT 4:16">à do a pǝndǝa ka,</para>
  <para style="q2" vid="MAT 4:16">à sǝna tǎlaban mǝgule.</para>
  <para style="q1" vid="MAT 4:16">Yì aɓwana mǝnana</para>
  <para style="q2" vid="MAT 4:16">à do a yinggǝli lú ka,</para>
  <para style="q2" vid="MAT 4:16">tǎlaban sulǝna a bania.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 9:1">Isha 9:1</ref>,<ref loc="ISA 9:2">2</ref></char>.</note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Lo a bàkú mǝno ka Yesu tita hamnǝ cau, kǝ na ama, <char style="wj">&lt;&lt;Wu pwanzali, wu pǝlǝ nzǝm wun arǝ acauɓikea ma'wun, acemǝnana Domurǝm mala kùli gbashìnà.&gt;&gt;</char><verse eid="MAT 4:17" /></para>
  <para style="s">Yesu tunǝ amǝkpate amǝdǝmbe</para>
  <para style="r">(<ref loc="MRK 1:16-20">Markus 1:16-20</ref>; <ref loc="LUK 5:1-11">Luka 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yesu na ban gya a kun Garang Galili, sǝ mǝsǝì kpa arǝ aɓwana ɓari amǝ'eambǝu, Shiman mǝnana à tunǝki ama Bitǝrus ka andǝ mǝ'eambi Andǝru. À nda ban taula nǝ ndámbú aɓa Garang ace mǝnana yia ka bwal-nji nda túró malea. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesu nea wia ama, <char style="wj">&lt;&lt;Wu yiu a tam, mǝ nǝ tsǝk wun, wu nǝ̀ pǝlǝ amǝ oari aɓwana acem.&gt;&gt;</char> <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />À lo tù à nying andámbú malea sǝ à o atè.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Yesu nggǝ ká a dǝmba ka, yi sǝn aɓea amǝ'eambǝu ɓari ɗǝm, Jemis muna mala Zabadi andǝ mǝ'eambi Yohana. À nda ɓá waru andǝ tárrià Zabadi. À nda ban taliki andámbú malea. Pǝlǝa Yesu tunǝia. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />À lo à fwa rǝia à nying waru andǝ tárrià sǝ à o atè.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesu kanigir sǝ twali <optbreak /> aɓwana ban rǝkwana</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luka 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu gya aɓa nzali Galili kat kǝ kanigir aɓalǝ andakpapi mala amǝ Yahudi, sǝ kǝ hamnǝ Cau Amsǝban mala Domurǝm mala Ɓakuli amur aɓwana. Twalî aɓwana ban ambalang arǝpangŋa andǝ akwánó kat. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Cau male gya akiban aɓa bu-nzali Suriya kat. À yinǝi wi nǝ amǝkwánó ɗàngɗáng: a mǝnana à nda ɓá rǝkwana kǝ̀rkǝ́r, andǝ a mǝnana akukwar kutia rǝia, andǝ a mǝnana à ndanǝ kwánó wukiaban, andǝ a mǝnana ɓekǝ barea wu ka, yi twalia wia ban akwánó malea kat. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Ɓwabunda pas mǝnana à pur a bu-nzali Galili, andǝ Dekapolis<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fq" closed="false">Dekapolis: </char><char style="ft" closed="false">Ko &lt;&lt;ala lum.&gt;&gt;</char></note> ka, à pu atà Yesu. Aɓea gbal ka à purkio arǝ anggea-là Urǝshalima, andǝ mala acili abu-nzali mala amǝ Yahudi andǝ aban mǝnana a nkaring Nggeasala Jodan ngga, kat à o atè.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesu eau amur nkono <optbreak /> sǝ kanigir</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luka 6:20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Lang Yesu sǝn làkkì mala ɓwabundǝa ka, kya eauwe do a bum nkono. Alaggana male yiu a baní, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />sǝ tita kania wia gìr ama:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />
    <char style="wj">Aɓwana mǝnana à sǝlǝ ama</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">yia ka amǝ'tǝ̀r na </char></para>
  <para style="q1" vid="MAT 5:3">
    <char style="wj">aɓa bangŋo ka,</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q1" vid="MAT 5:3">
    <char style="wj">acemana Domurǝm mala</char></para>
  <para style="q2" vid="MAT 5:3">
    <char style="wj">kùli ka malea na.</char><verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />
    <char style="wj">Amǝ bumkiɗikea ka</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q1" vid="MAT 5:4">
    <char style="wj">acemǝnana à nǝ̀ kum</char></para>
  <para style="q2" vid="MAT 5:4">
    <char style="wj">girikiban.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:4 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 61:2">Isha 61:2</ref>
      </char>.</note><verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />
    <char style="wj">Amǝ nongsǝmúrû ka </char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q2" vid="MAT 5:5">
    <char style="wj">acemǝnana à nǝ̀ li ɓanza.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:5 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 37:11">Ang 37:11</ref>
      </char>.</note><verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />
    <char style="wj">Aɓwana mǝnana à</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">dum nǝ nzala</char></para>
  <para style="q1" vid="MAT 5:6">
    <char style="wj">andǝ mǝsamur mala</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">cauɓoarna a bumia ka,</char></para>
  <para style="q1" vid="MAT 5:6">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">acemǝnana à nǝ̀ kum</char></para>
  <para style="q2" vid="MAT 5:6">
    <char style="wj">ɗǝmsǝban.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:6 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 55:1">Isha 55:1</ref>,<ref loc="ISA 55:2">2</ref></char>.</note><verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />
    <char style="wj">Amǝ sǝn mǝsǝswatǝr ka</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q1" vid="MAT 5:7">
    <char style="wj">acemǝnana à nǝ̀ sǝn</char></para>
  <para style="q2" vid="MAT 5:7">
    <char style="wj">mǝsǝswatǝr malea.</char><verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />
    <char style="wj">Amǝ ɓabum mǝɓoarnsari ka </char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q2" vid="MAT 5:8">
    <char style="wj">acemǝnana à nǝ̀ sǝn Ɓakuli.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:8 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 24:3">Ang 24:3</ref>,<ref loc="PSA 24:4">4</ref></char>.</note><verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />
    <char style="wj">Amǝ gilǝki dotarǝu ka</char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q1" vid="MAT 5:9">
    <char style="wj">acemǝnana à nǝ̀ duk </char></para>
  <para style="q2" vid="MAT 5:9">
    <char style="wj">amuna mala Ɓakuli.</char><verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <char style="wj">Aɓwana mǝnana à kǝ</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">pea wia tanni </char></para>
  <para style="q1" vid="MAT 5:10">
    <char style="wj">ace cauɓoarna ka,</char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">à ndanǝ tsǝkbu mala Ɓakuli,</char></para>
  <para style="q1" vid="MAT 5:10">
    <char style="wj">acemǝnana Domurǝm </char></para>
  <para style="q2" vid="MAT 5:10">
    <char style="wj">mala kùli ka malea na.</char><verse eid="MAT 5:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MAT 5:11" />
    <char style="wj">Wu ndanǝ tsǝkbu mala Ɓakuli yi mǝnana aɓwana kǝ sáng wun, à kǝ pa wun tanni, à kǝ tsǝka wun acau mǝɓike ɗàngɗáng arǝ wun aɓa nyir, acemǝnana wu nda ka amǝkpatam ngga.</char> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><char style="wj">Wu pak bumpwasǝa, ban ɓǝ ɓoara wun, acemǝnana tangnakusǝ wun ngga mǝgule na a kùli. Anggo sǝ à pe amǝ'ɓangnǝa mala Ɓakuli mǝnana à akà wun dǝmba ka tanni.</char><note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CH 36:16">2Acau 36:16</ref>; <ref loc="MAT 23:37">Mat 23:37</ref>; <ref loc="ACT 7:52">Atúró 7:52</ref>; <ref loc="1TH 2:15">1Tas 2:15</ref>; <ref loc="JAS 5:10">Jem 5:10</ref></char>.</note><verse eid="MAT 5:12" /></para>
  <para style="s">Tuɓamur andǝ tǎlaban <optbreak /> mala ɓanza</para>
  <para style="r">(<ref loc="MRK 9:50">Markus 9:50</ref>; <ref loc="LUK 14:34-35">Luka 14:34-35</ref>)</para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 5:13" />
    <char style="wj">Wu nda ka tuɓamur mala ɓanza. Sǝ ɓǝ̀ tuɓamur ɗwanyi cyauwe male ka mana gir ni nǝ̀ tsǝì sǝ nǝ̀ cyau ɗǝm? Panǝ ɓoaro ɗǝm ɗàng; à nǝ̀ sukki aɓwana nǝ̀ parki a ɓakusǝia.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:13 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>.</note><verse eid="MAT 5:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="MAT 5:14" />
    <char style="wj">Wu nda ka tǎlaban mala ɓanza. Nggea-là mǝnana à ɓè amur tali ka pà nǝ̀ sǝmbǝrǝ ɗang.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 8:12">Yoh 8:12</ref>; <ref loc="JHN 9:5">9:5</ref></char>.</note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><char style="wj">À pà nǝ̀ tsǝk bǝsa a pitǝla sǝ à nǝ̀ kùmsǝî wi nkenye amurí ɗàng. A kun mani ka à nǝ̀ tamsǝi amur gir-tamsǝ pitǝla, a ban mǝnana nǝ̀ pa tǎlaban a ban aɓwana kat a ɓala ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 4:21">Mar 4:21</ref>; <ref loc="LUK 8:18">Luk 8:18</ref>; <ref loc="LUK 11:33">11:33</ref></char>.</note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><char style="wj">Anggo sǝ wun nǝ̀ nying tǎlaban ma'wun ɓǝ̀ ta a ɓadǝmbǝ aɓwana ace mǝnana ɓǝà sǝn atúró ɓoarna ma'wun, sǝ ɓǝà gusǝlǝ Tár wun mana a kùli ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 2:12">Ang 2:12</ref></char>.</note><verse eid="MAT 5:16" /></para>
  <para style="s">Nggurcau mala Musa</para>
  <para style="pi">
    <verse number="17" style="v" sid="MAT 5:17" />
    <char style="wj">Wu kǝa twali ama ǝn yiu ace tamsǝ Nggurcau mala Musa andǝ kanigir mala amǝ'ɓangnǝa mala Ɓakuli ɗang; ǝn yiu ace tamsǝia ɗang. Nda ace lùmsǝia.</char> <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><char style="wj">Ən nggǝ na wun mǝsǝcau, ɓǝ̀ kùli andǝ nzali ka tea mal raka, kǝ muna-cau pà kàm, sǝ ɓè kǝgìr bǝti pà kàm aɓa Nggurcau mala Musa mǝnana nǝ̀ ndǝrmi ka ɗàng, she ɓǝ̀ nê malea kat lùmsǝ̀nà ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 16:17">Luk 16:17</ref></char>.</note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" /><char style="wj">Ɓǝ̀ yana kat sǝ yàllî nzong mǝkyauwe mwashat aɓalǝ amǝnia yì anzongcau, sǝ kǝ kani aɓwana ama ɓǝà pa kǝla yì ka, nǝ̀ nggá duk rítǎu aɓa Domurǝm mala kùli. Sǝ ɓwa mǝnana kǝ kpata amǝnia yì anzongcau, sǝ kǝ kani aɓwana ama ɓǝà pa kǝla yì ka, nǝ̀ nggá duk ɓwamǝgule a Domurǝm mala kùli.</char> <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" /><char style="wj">Ən nggǝ na wun ama ɓǝ̀ ɓealɓoarna ma'wun kútì mala amǝ Farisi andǝ amǝkani Nggurcau mala Musa raka,</char><note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fqa" closed="false">ɓǝ̀ ɓealɓoarna ma'wun kútì mala amǝ Farisi andǝ amǝkani Nggurcau mala Musa raka: </char><char style="ft" closed="false">Ko &lt;&lt;ɓǝ̀ do mǝsǝcau ma'wun aɓa kpata gìr mǝnana Ɓakuli earkiyi ce ka kútì mala amǝ Farisi andǝ amǝkani Nggurcau mala Musa raka.&gt;&gt;</char></note> <char style="wj">wu pà wu nǝ̀ kum kutio aɓa Domurǝm mala kùli ɗang ko bǝti.</char><verse eid="MAT 5:20" /></para>
  <para style="s">Yesu kanigir amur bumlulla</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luka 12:57-59</ref>)</para>
  <para style="pi">
    <verse number="21" style="v" sid="MAT 5:21" />
    <char style="wj">Wu ongŋǝna à banggi aɓwana mǝnana a pwarian ngga ama, &lt;&lt;A pà wu nǝ́ wal-lú ɗang; ɓwa mǝnana wal-lú ka à nǝ̀ pakki wi ɓashi.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:21 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EXO 20:13">Pur 20:13</ref>; <ref loc="DEU 5:17">Nggur 5:17</ref></char>.</note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama ɓwa mǝnana bumi lúllô arǝ ɓi ka à nǝ̀ pakki wi ɓashi. Sǝ ɗǝm ngga à bang ama ɓwa mǝnana tunǝî ɓì ɓwaɓana ka à nǝ̀ kánǝi aban amǝ'ɓashi. Sǝ mim ngga ǝn nggǝ na wun ama ɓǝ̀ a ne ɓwa ama &lt;&lt;We ɓwazalǝa&gt;&gt; ka, a nda ɓá ká tanni mala ɓashi lú-bǝsa.</char><verse eid="MAT 5:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 5:23" />
    <char style="wj">Ɓǝ̀ a ndarǝ pa ɓoro mo a ban gyangŋan-peri sǝ ɓālǝo kasǝa ama ɓè kǝɓwa na kam ndanǝ cau a bumi arǝò ka,</char> <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" /><char style="wj">nying ɓoro mô aɓadǝm gyangŋan, nyare kya gilǝki cê wunǝ ɓwe peatu, sǝ wu yi pa ɓoro mô.</char><verse eid="MAT 5:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="MAT 5:25" />
    <char style="wj">Ɓǝ̀ kǝɓwa wulio ka, gbara gilǝki nre wun wunǝi a njar aban ká ndaɓashi. Ɓǝ̀ a na raka, nǝ̀ nggá kpapio wunǝ mǝ'ɓashi, sǝ mǝ'ɓashi ka nǝ̀ tasǝo a bu amǝ'munagara, sǝ à nǝ̀ nggá oasǝo a ndàkurban.</char> <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" /><char style="wj">Ən nggǝ no mǝsǝcau a pa nǝ́ purî nggúr ɗang sheɓǝ̀ a mbwena gìr mǝnana kat à kàsǝô ka.</char><verse eid="MAT 5:26" /></para>
  <para style="s">Kànìgìr mala Yesu amur <optbreak /> cauɓikea nongnǝban mǝnana pa aɓa alban raka</para>
  <para style="pi">
    <verse number="27" style="v" sid="MAT 5:27" />
    <char style="wj">Wu ongŋǝna à bang ama &lt;&lt;A pà wunǝ nongnǝ ɓwa mǝnana wu al rǝ wun wunǝi raka ɗàng.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EXO 20:14">Pur 20:14</ref>; <ref loc="DEU 5:18">Nggur 5:18</ref></char>.</note><verse eid="MAT 5:27" /></para>
  <para style="mi">
    <verse number="28" style="v" sid="MAT 5:28" />
    <char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama ɓwa mǝnana kat sǝn ɓwama nǝ sǝnban nshawari ka, angŋǝna dǝmba nongŋǝna nǝi a ɓabumi.</char> <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><char style="wj">Ɓǝ̀ mǝsǝo mǝlì kǝ tsǝo a kǝ pak cauɓikea ka, pusǝì túrí. Kǝpǝna wu ɗwanyi ɓekǝ bareo mwashat amur mǝnana ɓǝà túr nggūrǝo kat aɓa tūli-bǝsa ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 18:9">Mat 18:9</ref>; <ref loc="MRK 9:47">Mar 9:47</ref></char>.</note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><char style="wj">Sǝ ɓǝ̀ buo mǝlì kǝ tsǝo a kǝ pak cauɓikea ka, kasǝi túrí. Kǝpǝna wu ɗwanyi ɓekǝ bareo mwashat amur mǝnana ɓǝà túr nggūrǝo kat aɓa tūli-bǝsa ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 18:8">Mat 18:8</ref>; <ref loc="MRK 9:43">Mar 9:43</ref>,<ref loc="MRK 9:44">44</ref></char>.</note><verse eid="MAT 5:30" /></para>
  <para style="s">Yesu kanigir amur <optbreak /> gau doɓala</para>
  <para style="r">(<ref loc="MAT 19:9">Matiu 19:9</ref>; <ref loc="MRK 10:11-12">Markus 10:11-12</ref>; <ref loc="LUK 16:18">Luka 16:18</ref>)</para>
  <para style="pi">
    <verse number="31" style="v" sid="MAT 5:31" />
    <char style="wj">Ɗǝm ngga à bang ama, &lt;&lt;Ɓǝ̀ ɓwa nǝ̀ gau andǝ māmí ka, dumǝna púp nǝ̀ pè wi takada gauwa.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:31 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DEU 24:1-4">Nggur 24:1-4</ref>; <ref loc="MAT 19:7">Mat 19:7</ref>; <ref loc="MRK 10:4">Mar 10:4</ref></char>.</note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama ɓwa mǝnana pǝr māmí, sǝ pa ace cauɓikea mala nongnǝban a nza nǝ́ doɓala raka, ndarǝ tsǝie aɓa cauɓikea mala mǝ'nongginǝban nǝ aɓea aburana a nza nǝ́ doɓala. Sǝ ɓwa mǝnana al mǝnia yì ɓwama mǝnana burí pǝri ka, ndarǝ pak cauɓikea mala nongnǝ mālá ɓeɓwa.</char><verse eid="MAT 5:32" /></para>
  <para style="s">Kànìgìr mala Yesu <optbreak /> amur Kángir</para>
  <para style="pi">
    <verse number="33" style="v" sid="MAT 5:33" />
    <char style="wj">Sǝ ɗǝm ngga wu ongŋǝna à banggi aɓwana mǝnana a pwarian ngga ama, &lt;&lt;A pà nǝ́ kángìr aɓa nyir ɗang. She awu nǝ lùmsǝ agir mǝnana a kána a ɓadǝm Mǝtalabangŋo ama a nǝ pea ka.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:33 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LEV 19:12">Pǝris 19:12</ref>; <ref loc="NUM 30:2">Ɓal 30:2</ref>; <ref loc="DEU 23:21">Nggur 23:21</ref></char>.</note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama, wu kǝa kángìr ɗàng. Wu kǝa kángìr nǝ kùli ɗang, acemǝnana nda buno-murǝm mala Ɓakuli.</char><note caller="+" style="f"><char style="fr" closed="false">5:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JAS 5:12">Jem 5:12</ref>; <ref loc="ISA 66:1">Isha 66:1</ref>; <ref loc="MAT 23:22">Mat 23:22</ref></char>.</note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><char style="wj">Sǝ pà wu nǝ̀ kángìr gbal nǝ nzali ɗang, acemǝnana ndà buno'tsǝk-kusǝu male. Sǝ wu kǝa kán gbal nǝ Urǝshalima ɗàng, acemǝnana nda nggea-là mala Murǝm Mǝgule kat.</char><note caller="+" style="f"><char style="fr" closed="false">5:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:1">Isha 66:1</ref>; <ref loc="PSA 48:2">Ang 48:2</ref></char>.</note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" /><char style="wj">Sǝ kǝa kán nǝ ɓamuro ɗàng, acemǝnana a pà nǝ́ gandǝ pǝlǝ nyang muro mwashat ɓǝ̀ pwasǝo ko ɓǝ̀ pǝndǝ ka ɗàng.</char> <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" /><char style="wj">Ɗeki &lt;&lt;E&gt;&gt; mò ɓǝ̀ duk &lt;&lt;E,&gt;&gt; sǝ &lt;&lt;Awo&gt;&gt; mò ɓǝ̀ duk &lt;&lt;Awo&gt;&gt;; ɓǝ̀ wori mǝnia ka pur nǝ ban Mǝɓealɓikea.</char><verse eid="MAT 5:37" /></para>
  <para style="s">Yesu kanigir amur pě-gbal</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luka 6:29-30</ref>)</para>
  <para style="pi">
    <verse number="38" style="v" sid="MAT 5:38" />
    <char style="wj">Wu ongŋǝna à bang ama, &lt;&lt;Ar mǝsǝu a kún ar mǝsǝu, sǝ ɓun minǝu a kún ɓun minǝu.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:38 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EXO 21:24">Pur 21:24</ref>; <ref loc="LEV 24:20">Pǝris 24:20</ref>; <ref loc="DEU 19:19-21">Nggur 19:19-21</ref></char>.</note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama, kǝa nyesǝ mǝɓane a kún mǝɓane mǝnana à pakko ka ɗàng. Ɓǝ̀ ɓwa kweo a takiro mǝlì ka, pǝlǝi wi ɓè takiro.</char> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><char style="wj">Ɓǝ̀ ɓwa na ama nǝ̀ nggá wulio nǝ̀ ako daura mò ka, pe wi andǝ nggea-daura mò gbal.</char> <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" /><char style="wj">Ɓǝ̀ ɓwa tsǝo púp ama ɓǝ̀ wu o wunǝi mel mwashat ka, wu kyan wunǝi mel ɓari.</char> <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" /><char style="wj">Ɓǝ̀ ɓwa zǝmbo ka, pe wi, sǝ ɓwa mǝnana yiua ak tangna a buo ka, ce a girì nǝi ɗàng.</char><verse eid="MAT 5:42" /></para>
  <para style="s">Yesu kanigir amur <optbreak /> earce aɓio amǝbura</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luka 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="pi">
    <verse number="43" style="v" sid="MAT 5:43" />
    <char style="wj">Wu ongŋǝna à bang ama, &lt;&lt;Earce ɓio mǝ'murkala,&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">5:43 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LEV 19:18">Pǝris 19:18</ref>
      </char>.</note> <char style="wj">sǝ wu ɓinǝ ɓiomǝbura.</char> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama: Wu earce aɓi wun amǝbura sǝ wu kǝ pakhiwi ace aɓwana mǝnana à ɓinǝmǝsǝ wun sǝ à kǝ pa wun tanni ka.</char> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" /><char style="wj">Ɓǝ̀ wu pak anggo ka wun nǝ̀ duk amuna mala Tár wun mǝnana a kùli ka. Acemǝnana yì ka, kǝ tsǝk pwari male kǝ ta amur aɓwana amǝɓane andǝ amǝɓoarne, sǝ kǝ nya mbulo amur amǝ pàk cauɓoarna andǝ amǝ pàk ɓealɓikea.</char> <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" /><char style="wj">Ɓǝ̀ earcearǝu ma'wun ngga nda ace amǝ'earce wun nǝmurǝia ka, ya tangnakusǝu na wu ndanǝi? Nggearǝ amǝ'cauɓikea ka anggo sǝ à pakkiyia.</char> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" /><char style="wj">Sǝ ɓǝ̀ amǝ'eam wun na nǝmurǝia wu makkiyia kún ngga, nǝ man sǝ wu kútì acili aɓwana mǝnana amǝkpatam na raka? Nggearǝ amǝɓanza ka anggo sǝ à pakkiyia.</char> <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" /><char style="wj">Ace mǝno ka, wu lùmsǝ nǝ cauɓoarna kǝla mǝnana Tár wun mana a kùli ka lùmsǝ nǝ cauɓoarna ka.</char><note caller="+" style="f"><char style="fr" closed="false">5:48 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:2">Pǝris 19:2</ref></char>.</note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Yesu kanigir amur <optbreak /> pe amǝtǝle ɓoro</para>
  <para style="pi">
    <verse number="1" style="v" sid="MAT 6:1" />
    <char style="wj">Wu tsǝkir wun, wu kǝa pakki atúró-ɓoarna ma'wun a ɓamǝsǝ aɓwana ace mǝnana ɓǝà sǝn wun ngga ɗàng. Ɓǝ̀ wu kǝ pa anggo ka, pà wu nǝ̀ kum ɓekǝ tangnakusǝu a ban Tár wun mana a kùli ka ɗàng.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 23:5">Mat 23:5</ref>
      </char>.</note><verse eid="MAT 6:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="MAT 6:2" />
    <char style="wj">Ɓǝ̀ wun nǝ̀ pè amǝ'tǝlè ɓoro ka, wu kǝa ham nǝ ce, kǝla pě mala amǝ'kúnɓárína aɓalǝ andakpapi mala amǝ Yahudi andǝ mur anjarɓala ka ɗàng. À kǝ pa anggo ace mǝnana ɓǝ̀ aɓwana sǝn atúró-ɓoarna malea ɓǝà ɓwangsǝia. Ən nggǝ bangga wun mǝsǝcau, à angŋǝna tangnakusǝia puppup.</char> <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" /><char style="wj">Ɓǝ̀ awu nǝ pè amǝ'tǝlè ɓoro ka, ce a eare ɓè kǝɓwa sǝlǝce gìr mǝnana a pakkiyi ka ɗàng,</char> <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" /><char style="wj">ace mǝnana ɓǝ̀ pagìr mò ka ɓǝ̀ pa aɓa sǝmbǝrǝa. Sǝ Tárró mana kǝ sǝn gìr mǝnana a kǝ pè aɓa sǝmbǝrǝa ka nǝ̀ po tangnakusǝo.</char><verse eid="MAT 6:4" /></para>
  <para style="s">Kànìgìr mala Yesu amur Hiwi</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luka 11:2-4</ref>)</para>
  <para style="pi">
    <verse number="5" style="v" sid="MAT 6:5" />
    <char style="wj">Ɓǝ̀ wun nǝ̀ pakhiwi ka, wu kǝa pe a pě mala amǝ'kúnɓárína ɗang, mǝnana à kǝ earce camgi aɓalǝ andakpapi andǝ agauwata anjarɓala sǝ à nǝ̀ pakhiwi, ace mǝnana ɓǝ̀ aɓwana sǝnia ka. Ən nggǝ bangga wun mǝsǝcau à angŋǝna dǝmba à kumǝna tangnakusǝia.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:5 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 18:10-14">Luk 18:10-14</ref>
      </char>.</note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" /><char style="wj">Sǝ we ka, ɓǝ̀ awu nǝ pakhiwi ka, kutio aɓa ndà mò, gìr kun-nda sǝ pakhiwi aban Tárró mǝnana à sǝngiyi raka. Sǝ Tárró mana kǝ sǝn gìr mǝnana a kǝ pe aɓa sǝmbǝrǝa ka, nǝ̀ po tangnakusǝo.</char> <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" /><char style="wj">Sǝ ɓǝ̀ a nda ban pakhiwi ka, kǝa camarǝ ɓǝsǝlǝki acau mana ɓālǝia pà kàm raka, kǝla pě mala amǝ'kpatalú ka ɗàng. À kǝ̀ sǝni kǝla ɓǝsǝlǝki acau malea ka nǝ̀ tsǝa Ɓakuli nǝ̀ oea.</char> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" /><char style="wj">Wu kǝa pa kǝla yia ɗang, acemǝnana kaniama wun nǝ̀ zǝm ngga, Tár wun angŋǝna dǝmba súrǝ́nà rǝ gir mǝnana wu earkiyice ka.</char><verse eid="MAT 6:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 6:9" />
    <char style="wj">Ani ka, sǝ wun nǝ̀ pakhiwi:</char></para>
  <para style="q1" vid="MAT 6:9">
    <char style="wj">&lt;&lt;We Tár sǝm mǝnana a kùli ka,</char></para>
  <para style="q2" vid="MAT 6:9">
    <char style="wj">ɓǝ̀ lùllǝo kum gulo.</char><verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <char style="wj">Domurǝm mò ɓǝ̀ yiu.</char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">Gìr mǝnana a earkiyice ka,</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">ɓǝ̀ sǝm pe a ɓanza, </char></para>
  <para style="q1" vid="MAT 6:10">
    <char style="wj">kǝla mǝnana à kǝ pe</char></para>
  <para style="q2" vid="MAT 6:10">
    <char style="wj">a kùli ka. </char><verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />
    <char style="wj">Pa sǝm girlina mala yalung.</char><verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <char style="wj">Twala sǝm ban </char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">acauɓikea ma'sǝm,</char></para>
  <para style="q1" vid="MAT 6:12">
    <char style="wj">kǝla mǝnana sǝm</char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">nggǝ twali aɓwana</char></para>
  <para style="q1" vid="MAT 6:12">
    <char style="wj">mana à kǝ pakka sǝm </char></para>
  <para style="q2" vid="MAT 6:12">
    <char style="wj">cauɓikea ka.</char><verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <char style="wj">Bwala sǝm ɓǝ̀ sǝm kǝa kutio</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">aɓa kārǝkiban ɗang,</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">amsǝ sǝm a bu Mǝɓealɓikea.</char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="wj">[Domurǝm, andǝ rǝcandǝa, </char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">andǝ gulo ka amo na kat,</char></para>
  <para style="q2" vid="MAT 6:13">
    <char style="wj">mana masǝlǝate pà kàm raka,</char></para>
  <para style="q1" vid="MAT 6:13">
    <char style="wj">Ɓǝ̀ do anggo.]&gt;&gt;</char><verse eid="MAT 6:13" /></para>
  <para style="mi">
    <verse number="14" style="v" sid="MAT 6:14" />
    <char style="wj">Ɓǝ̀ wu twali aɓwana ban acauɓikea mana à kǝ pakka wun ngga, Tár wun mǝnana a kùli ka nǝ̀ twala wun banì gbal.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 11:25">Mar 11:25</ref>,<ref loc="MRK 11:26">26</ref></char>.</note> <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><char style="wj">Sǝ ɓǝ̀ wu twali aɓwana ban acauɓikea mana à kǝ pakka wun raka, Tár wun gbal ka pà nǝ̀ twala wun ban acauɓikea ma'wun ɗàng.</char><verse eid="MAT 6:15" /></para>
  <para style="s">Yesu kanigir amur Gilmur</para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 6:16" />
    <char style="wj">Ɓǝ̀ awu nǝ gilmùr ka, cè a kur ɓamǝsǝo kǝla pě mala amǝ'kúnɓárína ɗang. Pak ka à kǝ kiɗiki ɓamǝsǝia ace mǝnana ɓǝà lǝmdǝì aɓwana ama à ndarǝ gilmùr ka. Ən nggǝ na wun mǝsǝcau à angŋa dǝmba à kumǝna tangnakusǝia.</char> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" /><char style="wj">Sǝ we ka, ɓǝ̀ awu nǝ gilmùr ka, lak ɓamǝsǝo sǝ wu hasǝ mùrú.</char> <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" /><char style="wj">Anggo ka aɓwana pà nǝ̀ sǝlǝ ama a ndarǝ gilmùr ɗàng, she kǝ Tárró mǝnana à sǝngiyi raka. Sǝ Tárró mǝnana kǝ sǝn gìr mana a kǝ pe aɓa sǝmbǝrǝa ka nǝ̀ po tangnakusǝo.</char><verse eid="MAT 6:18" /></para>
  <para style="s">Kànìgìr mala Yesu amur <optbreak /> tsǝk gǝna a kùli</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luka 12:33-34</ref>)</para>
  <para style="pi">
    <verse number="19" style="v" sid="MAT 6:19" />
    <char style="wj">Wu kǝa rambi ɓamur rǝ wun gǝna a kani a ɓanza ɗàng, yì ban mǝnana a kàm ngga nkungga andǝ sásà nǝ̀ kiɗiki, sǝ amǝn'í nǝ̀ ɓun kam à nǝ̀ kutio à nǝ̀ pwani ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:19 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JAS 5:2">Jem 5:2</ref>,<ref loc="JAS 5:3">3</ref></char>.</note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><char style="wj">Ndikǝna wu tsǝk gǝna ma'wun a kùli, a ban mǝnana nkungga andǝ sásà pà nǝ̀ kiɗiki raka, sǝ ban na mǝnana amǝn'í pa nǝ̀ gandǝ kutio à nǝ̀ iun'í kam raka.</char> <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" /><char style="wj">Ban mǝnana gǝna mô pàk kàm ngga, a kàm sǝ ɓabumo nǝ̀ pa gbal.</char><verse eid="MAT 6:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="MAT 6:22" />
    <char style="wj">Mǝsǝu ka nda kǝla pitǝla mǝnana kǝ pe ɓwa tǎlaban ngga. Ɓǝ̀ amǝsǝ ɓwa ka amǝɓoarne na ka, nǝ̀ sǝn gìr mana pakkiyi ka pepè.</char> <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" /><char style="wj">Sǝ ɓǝ̀ amǝsǝ ɓwa ka amǝɓane na ka, pà nǝ̀ sǝn gìr mana pakki ka ɗang. Sǝ ɓǝ̀ ɓwa kǝ sǝn gìr mana pakki ka pepè raka, lǝmdǝ ama pǝndǝa mǝnana nda ɓālǝi ka mǝgule na kǝ̀rkǝ́r.</char><verse eid="MAT 6:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="MAT 6:24" />
    <char style="wj">Ɓwa pà nǝ̀ gandǝ duk guro mala amǝtala ɓala ɓari atārǝia ɗàng. She ɓweni nǝ̀ ɓinǝ mwashat ateà sǝ nǝ̀ earce ɓì, ko nǝ̀ pa ɓamúrì a ban ɓwa mwashat sǝ nǝ̀ ɓǝsǝki ɓì. Wu pà nǝ̀ gandǝ kpata Ɓakuli andǝ boalo atārǝia ɗàng.</char><verse eid="MAT 6:24" /></para>
  <para style="s">Yesu kanigir amur <optbreak /> gūlì arǝ Ɓakuli</para>
  <para style="r">(<ref loc="LUK 12:22-34">Luka 12:22-34</ref>)</para>
  <para style="pi">
    <verse number="25" style="v" sid="MAT 6:25" />
    <char style="wj">Nda ǝn nggǝ na wun ama, wu kǝa pe rǝ wun tanni nǝ ɗenyicau ɓangciu amur do ma'wun, ace gìr mǝnana wun nǝ̀ li andǝ mǝnana wun nǝ̀ nu ka ɗàng; ko ace gìr mǝnana wun nǝ̀ oasǝo arǝ wun ngga. Nggearǝì ka, yilǝmu kútì girlina re, sǝ nggūrǝu kútì agir-nggūrǝu re?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">6:25 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PHP 4:6">Filp 4:6</ref>; <ref loc="1PE 5:7">1Bit 5:7</ref></char>.</note> <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" /><char style="wj">Wu sǝn anyal a kùli; à kǝ ɓeal ɗang, à kǝ can ɗàng sǝ à kǝ rambǝa a bà ɗàng. Sǝ Tár wun mǝnana a kùli ka kǝ linǝia. Wun ngga wu kútì anyal re?</char> <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" /><char style="wj">Yana atà wun nǝ̀ gandǝ tsǝk anonggio mala yilǝmi ɓǝà yàl kàm bǝti nǝ́ pe rǝì tanni aɓa ɗenyicau?</char><verse eid="MAT 6:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="MAT 6:28" />
    <char style="wj">Palang sǝ wu kǝ pe rǝ wun tanni ɓà ace agir-nggūrǝu? Wu sǝn to mala apwasǝo-bondo mǝnana a tàkuri ka. À kǝ pak kǝ túró ɗang, sǝ à kǝ swàrî ɓamuria agir-nggūrǝu ɗang.</char> <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" /><char style="wj">Sǝ ǝn nggǝ na wun ama nggearǝ Murǝm Solomon aɓa gulo andǝ kume male ka oasǝ agir mǝ'ɓoarjamnì kǝla apwasǝo-bondo mǝnia ka ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">6:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 10:4-7">1Amur 10:4-7</ref>; <ref loc="2CH 9:3-6">2Acau 9:3-6</ref></char>.</note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" /><char style="wj">Ɓǝ̀ Ɓakuli kǝ pakki abondo agir-nggūrǝu anggo ka, mǝnana à ndakam yalung sǝ li ka à pisǝnia a bǝsa ka, pà nǝ̀ pakka wun agir-nggūrǝu mǝnana kútì mǝno ka re? Ma'wun ngga gūliarǝu mana wu ndanǝi a ban Ɓakuli ka nda ɓiki kyauwe ka!</char><note caller="+" style="f"><char style="fr" closed="false">6:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 8:26">Mat 8:26</ref>; <ref loc="MAT 14:31">14:31</ref>; <ref loc="MAT 16:8">16:8</ref></char>.</note> <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" /><char style="wj">Cè wu kǝa ɓuanǝbum wun ama, &lt;&lt;Mana sǝm nǝ̀ li, ko mana sǝm nǝ̀ nu, ko mana sǝm nǝ̀ oasǝo&gt;&gt; ka ɗàng.</char> <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" /><char style="wj">Amǝnia ka à nda ka gir mǝnana amǝɓanza alkiyitea ka. Tár wun mǝnana a kùli ka, sǝlǝna ama wu kǝ paktǝle amǝnia yì agir ka.</char> <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><char style="wj">Wu tsǝk alta Domurǝm mala Ɓakuli andǝ pakki agir mǝnana earkiyice ka a dǝmba, sǝ amǝnia yì agir kat ka, à nǝ̀ pa wun nia.</char> <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" /><char style="wj">Ɓalǝ wun ɓǝ̀ kǝa kasǝkya amur cau mala lí ɗàng, acemǝnana pwari mala lí ka ndanǝ amale yì tanni. Koya pwari ka ndanǝ atanni male mǝnana à kārǝa rǝì ka.</char><note caller="+" style="f"><char style="fr" closed="false">6:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 19:28">Mat 19:28</ref>; <ref loc="MRK 10:29-30">Mar 10:29-30</ref>; <ref loc="LUK 18:29-30">Luk 18:29-30</ref></char>.</note><verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Kǝa pakki aɓwana ɓashi ɗàng</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luka 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="pi">
    <verse number="1" style="v" sid="MAT 7:1" />
    <char style="wj">Wu kǝa pakki aɓwana ɓashi ɗang, ace mǝnana Ɓakuli ɓǝ̀ kǝa pakka wun ɓashi raka.</char> <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><char style="wj">Kǝla mǝnana wu kǝ ɓashia aɓwana ka, anggo sǝ Ɓakuli nǝ̀ ɓashia wun; sǝ kǝla mǝnana wu kǝ pang nǝ aɓwana ka, anggo sǝ Ɓakuli nǝ̀ pang nǝ wun.</char><note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 4:24">Mar 4:24</ref></char>.</note><verse eid="MAT 7:2" /></para>
  <para style="pi">
    <verse number="3" style="v" sid="MAT 7:3" />
    <char style="wj">Ace mana sǝ a kǝ sǝn kǝkar mǝnana a mǝsǝ ɓio ka, sǝ a sǝn gbǝlanggun mǝnana aɓa mò yì mǝsǝu ka ɗàng?</char> <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" /><char style="wj">Ɓǝ̀ a na raka, lang sǝ a nǝ ne ɓio ama came mǝ pusǝ kǝkar a mǝsǝo, sǝ we ka nggea gbǝlanggun na gaurǝ a mǝsǝo ka?</char> <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" /><char style="wj">We mǝ'kunɓarina, pusǝ gbǝlanggun mǝnana a mǝsǝo ka peatu, sǝ awu nǝ sǝnban pepè mǝnana a nǝ pusǝî ɓio kǝkar mana a mǝsǝì ka.</char><verse eid="MAT 7:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="MAT 7:6" />
    <char style="wj">Gìr mǝnana à tarì ace Ɓakuli ka wu kǝa pè anvwa ɗàng. Ɓǝ̀ wu pa anggo ka, à nǝ̀ kàrra à nǝ̀ nǝmnggi wun. Wu kǝa túrì atǝmbǝrǝm-ɓala agir mǝɓoarne ma'wun ɗàng. Ɓǝ̀ wu pa anggo ka, à nǝ̀ parkia a ɓakusǝia.</char><verse eid="MAT 7:6" /></para>
  <para style="s">Yesu kanigir amur <optbreak /> zǝmba a ban Ɓakuli</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luka 11:9-13</ref>)</para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 7:7" />
    <char style="wj">Wu zǝmba a ban Ɓakuli, nǝ̀ pà wun; wu alte a bu Ɓakuli, wun nǝ̀ kùmô; wu wali Ɓakuli kunkurǝm, nǝ̀ mǝnba wun.</char> <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" /><char style="wj">Ɓwa mǝnana kat zǝm ngga à nǝ̀ pe wi; ɓwa mǝnana alte ka nǝ̀ kùmô; sǝ ɓwa mǝnana wal kunkurǝm ngga, à nǝ̀ mǝnbi wi.</char><verse eid="MAT 7:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 7:9" />
    <char style="wj">Yana atà wun mǝnana ɓǝ̀ muni zǝmbi wi nɗǝmo ka, nǝ̀ pe wi tali?</char> <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" /><char style="wj">Ko ɓǝ̀ zǝmbi wi nji ka, nǝ̀ pe wi n'yau ka?</char> <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" /><char style="wj">Kat andǝ ɓealɓikea ma'wun ngga wu sǝlǝ pe amuna ma'wun aɓoro mǝɓoarne, sǝ nǝ Tár wun mǝnana a kùli ka? Ndanǝ ɓabum mana ɓoaro kutibanì ka nǝ̀ pe aɓwana mǝnana à zǝmbi wi ka, agir mǝɓoarne!</char> <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><char style="wj">Aɓa gìr kat ka, pakki aɓwana agir mǝnana a earkiyice ama ɓǝà pakko ka. Mǝnia ka nda ɓá Nggurcau mala Musa andǝ kanigir mala amǝ'ɓangnǝa mala Ɓakuli.</char><note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 6:31">Luk 6:31</ref></char>.</note><verse eid="MAT 7:12" /></para>
  <para style="s">Kunɓala ká Kùli andǝ <optbreak /> kunɓala ká Lú-bǝsa</para>
  <para style="r">(<ref loc="LUK 13:24">Luka 13:24</ref>)</para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 7:13" />
    <char style="wj">Wu kútí nǝ kunɓala mǝɓweari, acemǝnana kunɓala ká lú-bǝsa ka mǝtangŋe na, sǝ tanjarnì ka kwan ɗang. Aɓwana pas sǝ à kǝ kútí a njarnì.</char> <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><char style="wj">Sǝ kunɓala ká yilǝmu ka mǝɓweari na, sǝ tanjarnì ka mǝkwane na. Aɓwana mǝnana à kǝ kumi ka, à làkkì ɗàng.</char><verse eid="MAT 7:14" /></para>
  <para style="s">Aɓwana andǝ atúró malea</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luka 6:43-44</ref>; <ref loc="LUK 13:25-27">13:25-27</ref>)</para>
  <para style="pi">
    <verse number="15" style="v" sid="MAT 7:15" />
    <char style="wj">Wu tsǝkir wun arǝ amǝ'ɓangnǝa mǝ'nyirì. Pak ka à kǝ ɓosǝki rǝia kǝla anzur, sǝ mǝsǝrǝia ka anvwa bondo mǝ'lùlle na.</char> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><char style="wj">Wun nǝ̀ súrǝ̀ia arǝ atúró malea. Zwe pa nǝ̀ pusǝ ɓǝla anap ɗàng. Sǝ imdi pa nǝ̀ ɓǝl vwari ɗang.</char> <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" /><char style="wj">Anggo gbal koya nggun mǝɓoarne ka kǝ pusǝ ɓǝle mǝɓoarne, sǝ nggun mǝɓane ka kǝ pusǝ ɓǝle mǝɓane.</char> <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" /><char style="wj">Nggun mǝɓoarne pa nǝ̀ pusǝ ɓǝle mǝɓane ɗàng, sǝ nggun mǝɓane pa nǝ̀ pusǝ ɓǝle mǝɓoarne ɗàng.</char> <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><char style="wj">Nggun mǝnana kat pusǝ ɓǝle mǝɓoarne raka à nǝ̀ kasǝi à nǝ̀ túrí a bǝsa.</char><note caller="+" style="f"><char style="fr" closed="false">7:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 3:10">Mar 3:10</ref>; <ref loc="LUK 3:9">Luk 3:9</ref></char>.</note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><char style="wj">Anggo sǝ wun nǝ̀ súrǝ̀ amǝ'ɓangnǝa mǝ'nyir nì arǝ atúró malea.</char><note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:33">Mat 12:33</ref></char>.</note><verse eid="MAT 7:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="MAT 7:21" />
    <char style="wj">Aɓwana na mǝnana kat à kǝ tunǝam ama, &lt;&lt;Mǝtalabangŋo, Mǝtalabangŋo&gt;&gt; ka, sǝ à nǝ̀ kutio a Domurǝm mala kùli ka ɗàng, she ɓwa mǝnana kǝ pak gìr mana Tárrám mana a kùli ka earkiyice ka.</char> <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" /><char style="wj">A masǝlǝata apwari ka aɓwana pas nǝ̀ yiu à nǝ̀ nam ama, &lt;&lt;Mǝtalabangŋo, Mǝtalabangŋo, nǝ lùllǝò sǝ sǝm hamnǝ cau re, sǝ nǝ lùllǝò sǝ sǝm pusǝki akukwar, sǝm pakki agir-ndǝlǝki pas re?&gt;&gt;</char> <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" /><char style="wj">Pǝlǝa mǝ nǝ banggia wia ama, &lt;&lt;Ən súrǝ̀ wun pale ɗàng. Wu upi banam, wun amǝ'ɓealɓikea!&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 6:8">Ang 6:8</ref></char>.</note><verse eid="MAT 7:23" /></para>
  <para style="s">Kwakita kusǝɓa mala Mǝ'sǝlǝe <optbreak /> andǝ mala Gǝmɓwa</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luka 6:47-49</ref>)</para>
  <para style="pi">
    <verse number="24" style="v" sid="MAT 7:24" />
    <char style="wj">Ace mani ka, ɓwa mana kat kǝ ok amǝnia yì acau mem sǝ kǝ kpatea kǝ pea ka, à nǝ̀ kànì rǝì arǝ ɓwa mǝsǝle mǝnana ɓak ɓala male amur tali ka.</char> <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" /><char style="wj">Mbulo nya, mur lo akiban, gung-mbulo ɓua wal arǝ mǝnia yì ɓala ka. Sǝ ɓalae kpa ɗang, acemǝnana kusǝɓa ka à kwákítè amur tali.</char> <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" /><char style="wj">Sǝ ɓwa mana kat kǝ ok amǝnia yì acau mem sǝ kǝ kpatea raka à nǝ̀ kànì rǝì arǝ gǝmɓwa mǝnana ɓak ɓala male amur sala ka.</char> <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><char style="wj">Mbulo nya, mur lo akiban, gung-mbulo ɓua wal arǝ mǝnia yì ɓala ka. Sǝ ɓalae kpa, nggea kpa mǝcandǝe!</char><verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Lang Yesu malǝna naki amǝnia yì acau ka, aɓwabundǝa pak ndali arǝ kanigir male, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />acemǝnana kanigir male ka ndanǝ rǝcandǝa. Pa kǝla mala amǝkani Nggurcau malea ɗàng.<note caller="+" style="f"><char style="fr" closed="false">7:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 1:22">Mar 1:22</ref>; <ref loc="LUK 4:32">Luk 4:32</ref></char>.</note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesu twali ɓeɓwa ban <optbreak /> rǝkwana male</para>
  <para style="r">(<ref loc="MRK 1:40-45">Markus 1:40-45</ref>; <ref loc="LUK 5:12-16">Luka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Lang Yesu sùlǝ́nì múr nkono ka, ɓwabundǝa pas kana atè. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ɓè mǝdakali yiu a baní yi ɓunno a ɓadǝmbi sǝ na ama, &lt;&lt;Ɓwamǝgule, ɓǝ̀ a nǝ ear ka, a nǝ twàlâm-ban rǝkwana man ɓǝ̀ rǝam ɓoarnsari.&gt;&gt;<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Sǝ Yesu lǝmdǝ buì je ɓwabure sǝ na ama, <char style="wj">&lt;&lt;Ən earǝna, ɓǝ̀ rǝo ɓoarnsari.&gt;&gt;</char> Àkǝ̀ banì kara kwánó dakali nying rǝì. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Sǝ Yesu ne wi ama, <char style="wj">&lt;&lt;Kǝa ne kǝɓwa ɗàng. We ka, kyane kya lǝmdǝ rǝo a ban pǝris, sǝ wu pa ɓoro mǝnana Musa bang ama ɓǝà pà ka, mǝnana nǝ̀ lǝmdǝ twalban rǝkwana mo a bania ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 14:1-32">Pǝris 14:1-32</ref></char>.</note><verse eid="MAT 8:4" /></para>
  <para style="s">Gūliarǝu mala ɓè <optbreak /> Ɓwamǝgule Soje</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luka 7:1-10</ref>; <ref loc="JHN 4:43-54">Yohana 4:43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kutio mala Yesu aɓa nggea-là Kapanahum ka, ɓè ɓwamǝgule mala asoje yiu a baní kǝ zǝmbi wi <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />ama, &lt;&lt;Ɓwamǝgule, muna-ɓala mem na ban nongŋo a ɓala nǝ kwánó rǝwuna, nda aɓa tanni kǝ̀rkǝ́r.&gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesu ne wi ama, <char style="wj">&lt;&lt;Mǝ nǝ ká mǝ nǝ twali wi ban rǝkwane.&gt;&gt;</char><verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Ɓwamǝgule soje pǝlǝa eari wi ama, &lt;&lt;Ɓwamǝgule, ǝn kārǝa wu yiu a ɓala mem ɗang. Ne kwane cau, sǝ muna-ɓala mem ngga rǝì nǝ̀ mala. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Nggearǝ mim ngga mǝ nda aɓata ɓeɓwa sǝ mǝ ndanǝ asoje a ɓatam. Kani ɓǝ̀ ǝn ne mǝnia ama, &lt;Kyane&gt; ka, nǝ̀ ká; sǝ ɓǝ̀ ǝn ne mǝno ama, &lt;Yiu&gt; ka, nǝ̀ yiu. Ɓǝ̀ ǝn ne guro mem ama, &lt;Pak ani&gt; ka, nǝ̀ pa.&gt;&gt;<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Lang Yesu ok cau mǝnia ka, ce nî pe wi ndali. Sǝ pǝlǝa ne amǝkpate ama, <char style="wj">&lt;&lt;Ən nggǝ na wun mǝsǝcau, ǝn malaká kum kǝɓwa aɓa nzali Isǝrayila nǝ gūliarǝu mǝgule kǝla man ɗang.</char> <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><char style="wj">Mǝ ndarǝ bangga wun, a ɓwana pas nǝ̀ purkio arǝ aban ɗàngɗáng a bum ɓanza à nǝ̀ yia do a Domurǝm mala kùli, à nǝ̀ lìli banɓoarnado atǎ Ibǝrayim, andǝ Ishaku, andǝ Yakupu.</char><note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 13:29">Luk 13:29</ref></char>.</note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><char style="wj">Sǝ aɓwana mana ɓǝ́ à nda à nǝ̀ duk amǝ'ɓala-murǝm ngga à nǝ̀ ramtea a nza aɓa pǝndǝa. À nǝ̀ ɓua à nǝ̀ nǝmnggi munabuia.&gt;&gt;</char><verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Yesu pǝlǝa ne ɓwamǝgule soje ama, <char style="wj">&lt;&lt;O a ɓala. Kǝla mǝnana a pa ɓabumo arǝì ka, anggo sǝ nǝ̀ pa.&gt;&gt;</char></para>
  <para style="p" vid="MAT 8:13">Akǝ̀ ɓá nacau mǝno ka rǝ munê mala.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesu twali aɓwana pas <optbreak /> ban rǝkwana</para>
  <para style="r">(<ref loc="MRK 1:29-34">Markus 1:29-34</ref>; <ref loc="LUK 4:38-41">Luka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesu wari a ɓala mala Bitǝrus. Yi kum nkil Bitǝrus mǝɓwame aban nongŋo nǝ kwánó ɓauwa. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Sǝ Yesu je a garabui, kara ɓauwa mali rǝì. Pǝlǝa lo pe Yesu girlina.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Nǝ pwarikpǝra mǝno ka à yiu nǝ aɓwana pas a baní, amǝnana nǝ akukwar a rǝia ka. Pusǝ akukwar mǝno nǝ cau. Sǝ amǝkwánó ka twalia wia ban arǝkwana malea kat. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Yesu pak mǝnia yì gìr ka ace mǝnana ɓǝà lùmsǝ ɓangnǝa mala Ishaya mǝnana ama:</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Yi ak arǝpangŋa ma'sǝm</para>
  <para style="q2" vid="MAT 8:17">sǝ twal akwánó ma'sǝm.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:4">Isha 53:4</ref></char>.</note><verse eid="MAT 8:17" /></para>
  <para style="s">Gìr mǝnana aɓa <optbreak /> kpata Yesu ka</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luka 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Lang Yesu sǝn làkkì mala aɓwana mǝnana à yiu a baní ka, tsǝk alaggana male ɓǝà yàle a ɓè nkaring Garang. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Ɓè mǝkani Nggurcau yiu a baní sǝ ne wi ama, &lt;&lt;Malǝm, mǝ nǝ ká atò ko aya ban a nǝ ká kam ngga.&gt;&gt;<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesu ne wi ama, <char style="wj">&lt;&lt;Amǝ'nzǝgban ndanǝ atūli, sǝ amuna-nyal mana à kǝ gya kùli ka, à ndanǝ andea, sǝ Muna mala Ɓwa ka, pànǝ ban mǝnana nǝ̀ nong kam ngga ɗàng.&gt;&gt;</char><verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Ɓè mǝkpate yi ne wi ama, &lt;&lt;Ɓwamǝgule, nyem ɓǝ̀ ǝn kyane mǝ kya tsǝk lú tárrám peatu sǝ mǝ nyare mǝ nǝ yia kpato.&gt;&gt;<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Sǝ Yesu ne wi ama, <char style="wj">&lt;&lt;Nying alú ɓǝà tsǝk alú malea, sǝ we ka kpatam.&gt;&gt;</char><verse eid="MAT 8:22" /></para>
  <para style="s">Yesu tamsǝ gung mǝcandǝe</para>
  <para style="r">(<ref loc="MRK 4:35-41">Markus 4:35-41</ref>; <ref loc="LUK 8:22-25">Luka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Pǝlǝa Yesu kutio aɓa waru sǝ alaggana male eauwe atè. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Puro malea aɓa nggeamùr ka, kara nggea gung mǝcandǝe loarǝia, mur kǝ ali aɓa waru. Sǝ Yesu ka nda a ntulo. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Alaggana male wario à kya loasǝi sǝ à ne wi ama, &lt;&lt;Ɓwamǝgule, amsǝ sǝm, sǝm nda sǝm nǝ̀ limge!&gt;&gt;<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Sǝ nea wia ama, <char style="wj">&lt;&lt;Wun ngga, gūlì ma'wun arǝ Ɓakuli kyau fat. Palang sǝ ɓangciu pakka wun?&gt;&gt;</char> Pǝlǝa lo sà arǝ gung andǝ eaki-nkono mala nggeamùr. Kara ban pwal ateà ɗǝong.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Sǝ aɓwana mǝnia ka à ndali sǝ à na ama, &lt;&lt;Ya ulang ɓwa nda mǝnia, mǝnana gung andǝ eaki-nkono mala nggeamùr à kǝ oki wi ka?&gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Yesu pusǝ akukwar <optbreak /> arǝ aburana ɓari</para>
  <para style="r">(<ref loc="MRK 5:1-20">Markus 5:1-20</ref>; <ref loc="LUK 8:26-39">Luka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Lang Yesu yi eauna a nkaring garang, a bu-nzali mala amǝ Gadara ka, yi je andǝ aburana ɓari mǝnana à ndanǝ akukwar a rǝia ka. À pur aɓalǝ aɓembe sǝ à kǝ yiu a baní. Ɓiki lúllô malea tsǝa kǝɓwa kǝ kar a njargula mǝno ɗang. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />À loasǝ già arǝ Yesu ama, &lt;&lt;Mana a alkiyite arǝ sǝm, we Muna mala Ɓakuli? A yiua pa sǝm tanni sǝ pwari malaká karǝ ɗang le?&gt;&gt;<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Abania tù ka atǝmbǝrǝm-ɓala nia pas à kǝ lìli a domwan malea ka. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Akukwar nì pǝlǝa à zǝmbi Yesu ama, &lt;&lt;Ɓǝ̀ a nǝ pusǝ sǝm ngga, tasǝ sǝm aɓa domwan mala atǝmbǝrǝm-ɓala.&gt;&gt;<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesu nea wia ama, <char style="wj">&lt;&lt;Wu kyane!&gt;&gt;</char> Sǝ akukwar nì puro, à kya kutio arǝ atǝmbǝrǝm-ɓala. Pǝlǝa domwan mǝnia kat ka tù atārǝia nǝ mire, à kya ɓunno a kun gwanyi, a sukkio a mùr à wukio. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Amǝ'yál atǝmbǝrǝm-ɓala twal mire aban o a là. À kya bang gìr mǝnana kum atǝmbǝrǝm-ɓala ka andǝ cau mala aburana ɓari mǝnana à pusǝ akukwar arǝia ka. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Sǝ là pur kat, à yiu aban Yesu. À nǝ̀ yia sǝn Yesu ka, à ɓuakia rǝì ɓǝ̀ nying bu-nzali malea.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Yesu twali ɓè mǝrǝwuna <optbreak /> rǝkwana male</para>
  <para style="r">(<ref loc="MRK 2:1-12">Markus 2:1-12</ref>; <ref loc="LUK 5:17-26">Luka 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu pǝlǝa eauwe a waru, yàle a nkaring o a la male. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Aɓea aɓwana yinǝi wi nǝ ɓè mǝrǝwuna a kala. Lang Yesu sǝn gūliarǝu malea ka, ne mǝkwánó ama, <char style="wj">&lt;&lt;Nwangsǝ ɓabumo, munem, à twalǝno ban acauɓikea mò.&gt;&gt;</char><verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Aɓea amǝkani Nggurcau nea rǝia ama, &lt;&lt;Ɓwa mǝnia kǝ twal ɓamúrì ama yì ka, Ɓakuli na!&gt;&gt;<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Acemǝnana Yesu súrǝ́nà rǝ ɗenyicau malea ka, banggia wia ama, <char style="wj">&lt;&lt;Palang sǝ wu kǝ pak ɗenyicau mǝɓane a ɓabum wun anggo?</char> <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" /><char style="wj">Mǝ ye na kwano kútì ɓì: ɓǝà na ama, &lt;À twalǝno ban acauɓikea mô&gt; le, ko ɓǝà na ama, &lt;Lo gya?&gt;</char> <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" /><char style="wj">Sǝ ace mǝnana ɓǝ̀ wu sǝlǝ ama Muna mala Ɓwa ka ndanǝ rǝcandǝa a ɓanza nǝ̀ twalban acauɓikea ka, mǝ nǝ lǝmdǝa wun.&gt;&gt;</char> Pǝlǝa Yesu pǝlǝa aban mǝrǝwuna sǝ ne wi ama, <char style="wj">&lt;&lt;Lo kar kala mô o a ɓala mò.&gt;&gt;</char><verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Sǝ ɓwabure par buì lo o a ɓala. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Aɓwana mana à ram ngga, ɓangciu pakkia wia arǝ gir mana à sǝn ngga. À ɓwangsǝ Ɓakuli mǝnana pè aɓwana-mǝpǝndǝe ulang man yì rǝcandǝa ka.<verse eid="MAT 9:8" /></para>
  <para style="s">Yesu tunǝ Matiu ɓǝ̀ kpate</para>
  <para style="r">(<ref loc="MRK 2:13-17">Markus 2:13-17</ref>; <ref loc="LUK 5:27-32">Luka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu puro nǝ̀ kútí ka yi sǝn ɓeɓwa mana à tunǝki ama Matiu mǝ'ak boalo-cemi, aban do aɓa tara ak boalo-cemi. Yesu ne wi ama, <char style="wj">&lt;&lt;Yiu atàm.&gt;&gt;</char> Kara lo o atà Yesu.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Lang Yesu na ban li a ɓala ka, amǝ'aki aboalo-cemi pas andǝ aɓea aɓwana mana amǝ Farisi twalia amǝ'cauɓikea na ka, à yì do atà Yesu andǝ alaggana male a ban li. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Sǝ amǝ Farisi sǝn Yesu aban li andǝ aɓwana mǝnia ka, à ɗì alaggana male ama, &lt;&lt;Ace man sǝ ɓwamǝgule ma'wun kǝ lili andǝ amǝ'ak boalo-cemi andǝ amǝ'cauɓikea?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 15:1">Luk 15:1</ref>,<ref loc="LUK 15:2">2</ref></char>.</note> <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Yesu nǝ̀ ok man yì cau ka pǝlǝa earia wia ama, <char style="wj">&lt;&lt;Aɓwana mǝnana rǝia bang ngga kǝgìr oasǝia arǝ mǝsonzǝo ɗang; amǝkwánó na à alkiyita mǝpaɓuri ka.</char> <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><char style="wj">Wu kyane wu kya bǝl ɓá mǝnia yì nggurcau mana ama: &lt;Sǝn mǝsǝswatǝr na ǝn earkiyice ka, pà gìr'nkila na ɗang.&gt; Ən yiu ace tunǝ amǝ'cauɓoarna ɗang, nda ace amǝ'cauɓikea.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:7">Mat 12:7</ref>; <ref loc="HOS 6:6">Hos 6:6</ref></char>.</note><verse eid="MAT 9:13" /></para>
  <para style="s">Aɓwana ɗì Yesu amur gilmùr</para>
  <para style="r">(<ref loc="MRK 2:18-22">Markus 2:18-22</ref>; <ref loc="LUK 5:33-39">Luka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Àkǝ̀ pwari mǝno ka alaggana mala Yohana Mǝbatisǝma yiu a ban Yesu sǝ à ɗì ama, &lt;&lt;Man tsǝa sǝ sǝm sǝnǝ amǝ Farisi ka, sǝm nggǝ gilmùr sǝ alaggana mo ka à kǝ gilmùr ɗàng?&gt;&gt; <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Yesu nyesǝia wia ama:</para>
  <para style="pi" vid="MAT 9:15">
    <char style="wj">Lang sǝ agyajam mala bura-māfela nǝ̀ pak bumkiɗikea mǝnana nda a bania peatu ka? Pwari nǝ̀ nggá yiu à nǝ̀ yia twal bura-māfela a rǝia; a pwarî sǝ à nǝ̀ gilmùr.</char><verse eid="MAT 9:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 9:16" />
    <char style="wj">Kǝ ɓwa pà nǝ̀ kpakǝri eakǝna daura nǝ kasǝna nggubyau mǝbǝshe ɗàng. Ɓǝa pa anggo ka kasǝne mǝbǝshe nǝ̀ yia tsǝk eakǝna daurae nǝ̀ san kpǝm nǝ̀ wori man ɗiɗyal ka.</char><verse eid="MAT 9:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="MAT 9:17" />
    <char style="wj">Sǝ ɗǝm ngga, kǝɓwa pà nǝ̀ so bǝsa mùr-anap aɓalǝ asambǝram mǝ'e ɗàng. Ɓǝ̀ soe ka asambǝrami nǝ̀ arkia, sǝ mùr-anap ni nǝ̀ sukkio, sǝ asambǝrami nǝ̀ ueɓà. Bǝsa mùr-anap ka à kǝ soe aɓalǝ asambǝram mǝbǝshe. Anggo sǝ yia kǝm ngga à nǝ̀ àwá.</char><verse eid="MAT 9:17" /></para>
  <para style="s">Yesu loasǝ lú sǝ twalban rǝkwana</para>
  <para style="r">(<ref loc="MRK 5:21-43">Markus 5:21-43</ref>; <ref loc="LUK 8:40-56">Luka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Lang Yesu na ban nea wia amǝnia yì acau ka, ɓè ɓwamǝgule ndakpapi mala amǝ Yahudi yiu yi kū`ndǝó a ɓadǝmbi, ne wi ama, &lt;&lt;Ɓoarnsarilem wu àkǝ̀ dyadyan. Yiu tsǝk buo arǝì, sǝ mǝsǝì nǝ̀ sa nǝ̀ pak yilǝmu.&gt;&gt;<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Yesu pǝlǝa lo o atè, andǝ alaggana male.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Nǝ̀ nggǝ ká ka, ɓè ɓwama mǝnana nkila kǝ kángí arǝì apǝlǝkia lum-nong-ɓari ka, kar a nzǝmi yi je kun daura male. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Ne ɓamúrì ama, &lt;&lt;Ɓǝ̀ mǝ nǝ kumô mǝ je daura male ka, rǝam nǝ̀ málâ.&gt;&gt;<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Yesu pǝlǝ rǝì sǝni, sǝ ne wi ama, <char style="wj">&lt;&lt;Ɓwama, ɓangciu ɓǝ̀ kǝa pakko ɗàng! Gūliarǝu mo arǝàm twalǝno ban kwánó mo.&gt;&gt;</char> Àkǝ̀ banì mǝno sǝ rǝ ɓwame málá.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Kutio mala Yesu a ɓala mala mǝno yì ɓwamǝgule ka, yi sǝn amǝ'twang ntetu andǝ aɓwana mana à ramba à kǝ ɓua ka. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Wu mǝsǝe! Ɓoarnsarile wu nǝ wú ɗang. Nda a ntulo.&gt;&gt;</char> Kara à oali nǝ oalo. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Lang à tsǝ̀ngŋǝ̀nà aɓwana à purna a nza ka, Yesu kutio bwal ɓoarnsarile a garabui, sǝ lo dumnǝdo. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Mǝnia yì cau ka akiban kat aɓa mǝno yì bu-nzali ka.<verse eid="MAT 9:26" /></para>
  <para style="s">Yesu mǝn mǝsǝ ante</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu purni ban mǝno nǝ̀ nggǝ o ka, aɓea ante ɓari lo aban ká atè. À loasǝ già ama, &lt;&lt;Muna mala Dauda<note caller="+" style="f"><char style="fr" closed="false">9:27 </char><char style="fq" closed="false">Muna mala Dauda: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkà Dauda.&gt;&gt;</char></note>, ɓwamur sǝm!&gt;&gt;<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Lang Yesu kutina a ɓala ka, ante mǝnia yiu a baní, sǝ ɗia ama, <char style="wj">&lt;&lt;Wu earǝna nǝi ama mǝ nǝ gandǝ mǝn amǝsǝ wun le?&gt;&gt;</char></para>
  <para style="p" vid="MAT 9:28">À eare ama, &lt;&lt;E, Mǝtalabangŋo!&gt;&gt;<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Pǝlǝa je mǝsǝia sǝ na ama, <char style="wj">&lt;&lt;Kǝla mǝnana wu earǝna nǝi ka ɓǝ̀ dupa wun anggo.&gt;&gt;</char> <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Àkǝ̀ banì, mǝsǝia mǝna. Sǝ Yesu nunkiria pepè ama, <char style="wj">&lt;&lt;Wu kǝa ne kǝɓwa ce ɗàng.&gt;&gt;</char> <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Sǝa ma à puro à kya mesǝ ce Yesu a bu-nzali mǝno kat.<verse eid="MAT 9:31" /></para>
  <para style="s">Yesu tsǝk mǝtalasǝ-ɓunna nacau</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />À nda ban puro à nǝ̀ o ka, aɓea ɓwana yiu nǝ ɓeɓwa mǝnana kukwar kutia rǝì sǝ kǝ gandǝ nacau raka aban Yesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu pusǝ kukwar mǝnana arǝì ka, àkǝ̀ banì ɓwa mǝnana kǝ gandǝ nacau ɗiɗyal raka, tita nacau. Ɓwabunda ndali sǝ à na ama, &lt;&lt;Sǝm malaká sǝn kǝgìr kǝla man aɓa Isǝrayila ɗàng.&gt;&gt;<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Sǝ amǝ Farisi ka à yi bang ama nǝ murǝm mala akukwar sǝ Yesu kǝ pusǝki akukwar.<note caller="+" style="f"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:25">Mat 10:25</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luk 11:15</ref></char>.</note><verse eid="MAT 9:34" /></para>
  <para style="s">Yesu sǝn mǝsǝswatǝr <optbreak /> mala aɓwana</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu gya arǝ anggea-là andǝ amuna-là kat, aban kanigir aɓalǝ andakpapi mala amǝ Yahudi, kǝ hamnǝ Cau Amsǝban mala Domurǝm mala Ɓakuli, sǝ kǝ twalban akwánó andǝ arǝpangŋa kat.<note caller="+" style="f"><char style="fr" closed="false">9:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MRK 1:39">Mar 1:39</ref>; <ref loc="LUK 4:44">Luk 4:44</ref></char>.</note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Lang yi sǝn làkkì mala aɓwabundǝa ka, mǝsǝswatǝr malea pakki wi, acemǝnana à nda aɓa tanni. Kǝ mǝpyaumǝsǝu pa amúrià ɗàng, kǝla anzur mǝnana yalu pa amúrià raka.<note caller="+" style="f"><char style="fr" closed="false">9:36 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 27:17">Ɓal 27:17</ref>; <ref loc="1KI 22:17">1Amur 22:17</ref>; <ref loc="2CH 18:16">2Acau 18:16</ref>; <ref loc="EZK 34:5">Ezǝk 34:5</ref>; <ref loc="MRK 6:34">Mar 6:34</ref></char>.</note> <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Pǝlǝa ne alaggana male ama, <char style="wj">&lt;&lt;Túró Wal-mǝsa ka nda kpǝm, sǝ amǝtúró làkkì ɗàng.</char> <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" /><char style="wj">Wu zǝmbi Mǝtala-ɓaban ɓǝ̀ tasǝ amǝtúró ɓǝà yiu a ɓaban male.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">9:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 10:2">Luk 10:2</ref></char>.</note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Yesu túr Alaggana male <optbreak /> lum-nong-ɓari</para>
  <para style="r">(<ref loc="MRK 3:13-19">Markus 3:13-19</ref>; <ref loc="MRK 6:7-13">6:7-13</ref>; <ref loc="LUK 6:12-16">Luka 6:12-16</ref>; <ref loc="LUK 9:1-6">9:1-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu tunǝ alaggana male lum-nong-ɓari sǝ pea wia rǝcandǝa ɓǝà pusǝ abangŋo mǝɓane sǝ ɓǝà twalban koya kwánó andǝ rǝpangŋa.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Amǝnia ka à nda ka lullǝ amǝ'mishan lum-nong-ɓari: A dǝmba ka nda Shiman (mǝnana à tunǝki ama Bitǝrus ka) andǝ mǝ'eambi Andǝru; Jemis andǝ mǝ'eambi Yohana (amuna mala Zabadi); <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filip andǝ Batalomi; Toma, andǝ Matiu (mǝ'ak boalo-cemi); Jemis (muna mala Alfiyus), andǝ Tadawus; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Shiman (mǝ'earce came ace là male), sǝ Yahuda Iskariyoti (mǝnana mak Yesu ka).<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Yia mǝnia lum-nong-ɓari ka Yesu tasǝia sǝ nea wia ama:</para>
  <para style="pi" vid="MAT 10:5">
    <char style="wj">Wu kǝa ká a ban aɓwana mǝnana amǝ Yahudi na raka ɗàng. Wu kǝa kàr a ɓekǝ la mala amǝ Samariya ɗàng.</char> <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><char style="wj">Wu dǝshi anzur mala amǝ Isǝrayila mǝnana à ɓwarki ka.</char> <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" /><char style="wj">Ká ma'wun ngga, kǝ cau mǝnia ka nda wun nǝ̀ hamnǝi ka: &lt;&lt;Domurǝm mala kùli gbashìna.&gt;&gt;</char> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><char style="wj">Wu twalban rǝkwana, wu loasǝ alú, wu sonzǝ amǝdakali, wu pusǝki akukwar. Ɓà sǝ à pà wun. Wu pè aɓwana gbal ɓà.</char> <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" /><char style="wj">Wu kǝa twal kǝ boalo a bu wun ko a lǝpan ɗàng, koya ulangnì nani ka.</char> <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><char style="wj">Wu kǝa twal kǝ luru ko daura andǝ nkura nggaɗya, ko gara-gya a bu wun ɗàng. Mǝturo ka ɓǝà pè wi gìr mǝnana ɓoaro ɓǝ̀ kum ngga.</char><verse eid="MAT 10:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MAT 10:11" />
    <char style="wj">Ɓǝ̀ ya nggea-là ko muna-là wu kútí kam ngga, wu alta ɓwa mǝɓoarne mǝnana nǝ̀ ak wun ngga, wu sulǝo a baní bà pwari mǝnana wun nǝ̀ nyìngŋǝ̀nà lê nǝi ka.</char> <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" /><char style="wj">Ɓala mǝnana wun nǝ̀ kútí kam ngga, wu nea wia ama ɓǝ̀ rǝ wun pwalo.</char> <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" /><char style="wj">Ɓǝ̀ amǝɓalae ak wun ngga, ɓǝ̀ dorǝpwala ma'wun do ateà, sǝ ɓǝà ak wun raka, ɓǝ̀ dorǝpwala ma'wun nyare atà wun.</char> <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><char style="wj">Ɓǝ̀ ya ɓala ko là mǝnana gingsǝ wun ko kwakikiri arǝ cau ma'wun raka, ɓǝ̀ wun nǝ̀ nying banì ka, wu kǝtǝriki tú là malea mǝnana a kusǝ wun ngga.</char><note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 13:51">Atúró 13:51</ref></char>.</note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><char style="wj">Ən nggǝ na wun mǝsǝcau, a pwari ɓashi ka, amǝ Sodom andǝ amǝ Gomora ka, ɓashi malea nǝ̀ ɓoari mala ala mǝno.</char><verse eid="MAT 10:15" /></para>
  <para style="s">Tanni mana kǝ yiu amur <optbreak /> amǝkpata Yesu ka</para>
  <para style="r">(<ref loc="MRK 13:9-13">Markus 13:9-13</ref>; <ref loc="LUK 21:12-17">Luka 21:12-17</ref>)</para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 10:16" />
    <char style="wj">Mǝ ndya ǝn nggǝ túr wun kǝla anzur aɓalǝ anvwa bondo. Ace mani ka, wu dum nǝ kwaro kǝla an'yau, sǝ wu duk amǝ'ɗwanyicau arǝu kǝla akutu.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:16 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 10:3">Luk 10:3</ref>
      </char>.</note><verse eid="MAT 10:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="MAT 10:17" />
    <char style="wj">Wu par kir wun nǝ aɓwana. À nǝ̀ kánǝ wun aban amǝ'ɓashi. À nǝ̀ kok wun aɓalǝ andakpapi malea.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:17 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 13:9-11">Mar 13:9-11</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref></char>.</note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><char style="wj">À nǝ̀ kánǝ wun a ɓadǝmbǝ amurǝma andǝ amǝtala nzali ace cau mem, ace mǝnana ɓǝ̀ wu bang Cau Amsǝban mem abania sǝ aban aɓwana mǝnana amǝ Yahudi na raka.</char> <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" /><char style="wj">Sǝ ɓǝ̀ à yì bwalkina wun ngga, ɓalǝ wun ɓǝ̀ kǝa kasǝkia arǝ cau mǝnana wun nǝ̀ na ko lang sǝ wun nǝ̀ na ce ka ɗàng. Àkǝ̀ pwari mǝno Bangŋo mala Ɓakuli nǝ̀ pà wun cau mǝnana wun nǝ̀ na ka.</char> <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" /><char style="wj">Acemǝnana wu nda wun nǝ̀ nacau ka ɗàng, Bangŋo mala Tár wun na nǝ̀ nacau nǝ kún wun ngga.</char><verse eid="MAT 10:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="MAT 10:21" />
    <char style="wj">Mǝ'eambu nǝ̀ mak mǝ'eambi ɓǝà wali. Tárrú nǝ̀ mak muni ɓǝà wali. Amuna nǝ̀ pǝlǝa arǝ atárrià andǝ anggea sǝ à nǝ̀ tsǝa ɓǝà walia.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:21 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 13:12">Mar 13:12</ref>; <ref loc="LUK 21:16">Luk 21:16</ref></char>.</note> <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><char style="wj">Aɓwana kat à nǝ̀ ɓinǝmǝsǝ wun acem; sǝ ɓwa mǝnana cam kàngkàng aban ká masǝlǝate ka nǝ̀ àwá.</char><note caller="+" style="f"><char style="fr" closed="false">10:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 24:9">Mat 24:9</ref>,<ref loc="MAT 24:13">13</ref>; <ref loc="MRK 13:13">Mar 13:13</ref>; <ref loc="LUK 21:17">Luk 21:17</ref></char>.</note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" /><char style="wj">Ɓǝà pà wun tanni a ɓè la ka, wu ɓangŋa wu kya ɓè. Ən nggǝ na wun mǝsǝcau kaniama wun nǝ̀ mal gya arǝ alá mala amǝ Isǝrayila kat ka, Muna mala Ɓwa nyarǝna yina.</char><verse eid="MAT 10:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="MAT 10:24" />
    <char style="wj">Mǝ'eaulǝkigir kútì mǝkani wi gìr ɗàng. Sǝ muna-ɓala kútì mǝtala-ɓala male ɗàng.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:24 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 6:40">Luk 6:40</ref>; <ref loc="JHN 13:16">Yoh 13:16</ref>; <ref loc="JHN 15:20">15:20</ref></char>.</note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><char style="wj">Mǝ'eaulǝkigir ka ɓǝ̀ alte ɓǝ̀ kum do kǝla malǝm male, sǝ muna-ɓala ka ɓǝ̀ alte ɓǝ̀ kum do kǝla mǝtala-ɓala male. Ɓǝ̀ mǝtala-ɓala ka à tunǝi ama Murǝm mala akukwar<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fq" closed="false">Murǝm mala akukwar </char><char style="ft" closed="false">ko Be'elzebul ko Be'elzebup</char></note> ka, acili amǝɓala ka lullǝu mana à nǝ̀ tunǝia nǝi ka nǝ̀ ɓike nǝ̀ kutibanì!</char><note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 9:34">Mar 9:34</ref>; <ref loc="MRK 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luk 11:15</ref></char>.</note><verse eid="MAT 10:25" /></para>
  <para style="s">Ɓwa mǝnana wun nǝ̀ <optbreak /> ɓanggi wi ka</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luka 12:2-7</ref>)</para>
  <para style="pi">
    <verse number="26" style="v" sid="MAT 10:26" />
    <char style="wj">Ace mani ka ɓangciu ɓǝ̀ kǝa pakka wun arǝ aɓwana ɗàng. Gìr mǝnana à mbuɓɓǝ́ki tè ado ka tè nǝ̀ nggá puro, sǝ kǝgìr pà kàm mǝnana sǝmbǝrǝa sǝ à pà nǝ̀ sǝlǝce raka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:26 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luk 8:17</ref></char>.</note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" /><char style="wj">Acau mǝnia ǝn nggǝ na wun a pǝndǝa ka, wu kya nea a banfana. Cau mǝnana ǝn sherǝa wun a kir wun ngga, wu hamnǝ ce amur akurǝm.</char> <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" /><char style="wj">Wu kǝa ɓanggi aɓwana mǝnana à kǝ wal nggūrǝu ka ɗang; à pà nǝ̀ gandǝ je yilǝmu ɗang. Ɓwa mǝnana wun nǝ̀ ɓanggi wi ka nda kǝ Ɓakuli mwashat, mǝnana nǝ̀ kiɗiki nggūrǝu andǝ yilǝmu a lú-bǝsa ka.</char> <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" /><char style="wj">Amuna-nyal ɓari ka à kǝ mea kwapo mwashat re? Sǝ anggo ka kǝ ɓè pà kàm mwashat nǝ̀ kpa a nzali nǝ̀ wú sǝ pà nǝ́ sǝlǝe mala Tár wun raka.</char> <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" /><char style="wj">Nggearǝ anyiaun-ɓamur wun ngga à ɓalnia.</char> <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><char style="wj">Ace mani ka ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Wu kútì amuna-nyal kusǝ pas.</char><verse eid="MAT 10:31" /></para>
  <para style="s">Bang Paɓamuru mô <optbreak /> a dǝmbǝ aɓwana</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luka 12:8-9</ref>)</para>
  <para style="pi">
    <verse number="32" style="v" sid="MAT 10:32" />
    <char style="wj">Ɓwa mǝnana bang paɓamuru male arǝàm a dǝmbǝ aɓwana ka, mǝ nǝ twalce gbal ama yì ka, memna a ɓadǝm Tárrám mǝnana a kùli ka.</char> <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><char style="wj">Sǝ ɓwa mǝnana makgìr súrǝàm a dǝmbǝ aɓwana ka, mim gbal ka mǝ nǝ makgìr súrǝè a ɓadǝm Tárrám mǝnana a kùli ka.</char><note caller="+" style="f"><char style="fr" closed="false">10:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2TI 2:12">2Tim 2:12</ref></char>.</note><verse eid="MAT 10:33" /></para>
  <para style="s">Kpata Yesu nǝ̀ yiu nǝ gapitarǝu</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luka 12:51-53</ref>; <ref loc="LUK 14:26">14:26</ref>,<ref loc="LUK 14:27">27</ref>)</para>
  <para style="pi">
    <verse number="34" style="v" sid="MAT 10:34" />
    <char style="wj">Wu kǝa twali ama ǝn yiua yinǝi ɓanza dotarǝu. Awo, ǝn yiua yinǝ dotarǝu ɗang, ǝn yiua yinǝ nggeabyau.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:34 </char>
      <char style="fq" closed="false">nggeabyau: </char>
      <char style="ft" closed="false">Ko &lt;&lt;gapitarǝu ko lwa ko wal-lú.&gt;&gt;</char>
    </note> <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" /><char style="wj">Ən yiua pǝlǝ</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">&lt;&lt;Ɓwabura arǝ tárrí,</char></para>
  <para style="q2" vid="MAT 10:35">
    <char style="wj">muna-ɓwama arǝ ngge,</char></para>
  <para style="q1" vid="MAT 10:35">
    <char style="wj">sǝ ɓwama arǝ </char></para>
  <para style="q2" vid="MAT 10:35">
    <char style="wj">nkili-mǝɓwame;</char><verse eid="MAT 10:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="MAT 10:36" />
    <char style="wj">aɓwana mana a ɓala</char></para>
  <para style="q2" vid="MAT 10:36">
    <char style="wj">mala ɓwa ka,</char></para>
  <para style="q1" vid="MAT 10:36">
    <char style="wj">à nda à nǝ̀ pǝlǝ </char></para>
  <para style="q2" vid="MAT 10:36">
    <char style="wj">aɓi-mǝbura ka.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:36 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MIC 7:6">Mik 7:6</ref>
      </char>.</note><verse eid="MAT 10:36" /></para>
  <para style="pi">
    <verse number="37" style="v" sid="MAT 10:37" />
    <char style="wj">Ɓwa mǝnana earce tárrí ko nggè kútiǎm ngga, kārǝa nǝ̀ duk mǝkpatam ɗang. Ɓwa mǝnana earce muni mǝɓwabure ko mǝɓwame kútiǎm ngga, kārǝa nǝ̀ duk mǝkpatam ɗàng.</char> <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><char style="wj">Ɓwa mǝnana twal nggun-gangndǝi male sǝ yiu atàm raka, kārǝa nǝ̀ duk mǝkpatam ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:24">Mat 16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luk 9:23</ref></char>.</note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><char style="wj">Ɓwa mǝnana kǝ yál yilǝmi ace amsǝe ka nǝ̀ nggá ɗwanyibani, sǝ ɓwa mana túrtà yilǝmi acem ngga, nǝ̀ nggá kumi.</char><note caller="+" style="f"><char style="fr" closed="false">10:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref></char>.</note><verse eid="MAT 10:39" /></para>
  <para style="s">Atangnakusǝu</para>
  <para style="r">(<ref loc="MRK 9:41">Markus 9:41</ref>)</para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 10:40" />
    <char style="wj">Ɓwa mǝnana ak wun ngga mǝ nda akiyiam ngga. Sǝ ɓwa mana em ngga ndarǝ ak ɓwa mǝnana tasǝam ngga.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">10:40 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 9:48">Luk 9:48</ref>; <ref loc="LUK 10:16">10:16</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref>; <ref loc="MRK 10:37">Mar 10:37</ref></char>.</note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" /><char style="wj">Ɓwa mana ak mǝɓangnǝa mala Ɓakuli acemǝnana ama yì ka, ɓwa mala Ɓakuli na ka, nǝ̀ kum tangnakusǝu mala mǝɓangnǝa. Sǝ ɓwa mǝnana ak mǝ'cauɓoarna ace mǝnana ama yì ka, mǝ'cauɓoarna na ka à nǝ̀ pe wi tangnakusǝu mala mǝ'cauɓoarna.</char> <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><char style="wj">Ko ɓǝ̀ mùr pwala na a kwap sǝ koya ɓwa pè mwashat atà amǝkèke mǝnia, acemǝnana ama mǝkpatam na ka, ɓafo nǝ̀ kum tangnakusǝi.</char><verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Ɗiban mala Yohana <optbreak /> Mǝbatisǝma a ban Yesu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luka 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Anzǝm mana Yesu yi malǝna ne alaggana male lum-nong-ɓari amǝnia yì akwarkiru ka, pǝlǝa nying ban mǝno kutio o nǝ̀ nggá kanigir andǝ hamnǝ cau arǝ alá mala amǝ Galili.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yohana Mǝbatisǝma ka nda a ndàkurban sǝ ok cè agir mana Kǝrǝsti kǝ pea ka, pǝlǝa túr alaggana male <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ɓǝà kya ɗì ama, &lt;&lt;A nda Mǝ'amsǝban mǝnana sǝm kundǝkiyi múrí ka le, ko ɓǝ̀ sǝm tsǝk mǝsǝ sǝm arǝ ɓeɓwa ɗàng?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesu nyesǝia wia ama, <char style="wj">&lt;&lt;Wu nyare wu kya ban Yohana wu kya banggi wi cau mala agir mana wu kǝ sǝnia sǝ wu kǝ oea ka.</char> <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><char style="wj">Ante kǝ sǝnban, agbakǝre kǝ gya, à kǝ twali amǝdakali ban a akwánó-bǝsa malea, amǝkir'ara kǝ okban, à kǝ loasǝ alú, sǝ à kǝ hamnǝ Cau Amsǝban a ban amǝ'tǝ̀r.</char><note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 35:5">Isha 35:5</ref>,<ref loc="ISA 35:6">6</ref>; <ref loc="ISA 61:1">61:1</ref></char>.</note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><char style="wj">Tsǝkbu mala Ɓakuli na amur aɓwana mǝnana kum ɓè kǝgìr annda arǝàm raka.</char><note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="fq" closed="false">kum ɓè kǝgìr annda arǝàm raka: </char><char style="ft" closed="false">Ko &lt;&lt;kum ɓè kǝgìr arǝàm mǝnana nǝ̀ tsǝì nǝ̀ bwakibuì arǝ earnǝ mim ngga raka.&gt;&gt;</char></note>&gt;&gt;<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Lang alaggana mala Yohana purna à nǝ̀ nggǝ o ka, Yesu tita ne aɓwana cau amur Yohana ama:</para>
  <para style="pi" vid="MAT 11:7">
    <char style="wj">Mǝnana wu puro wu wari aɓa pǝɗanban a njenza aban Yohana ka, mana ɗe wu wari a sǝne? Wu wari a sǝn ndǝrdangŋa mǝnana gung kǝ dǝurǝki ka le?</char> <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" /><char style="wj">Ɓǝ̀ pa ana raka, mana wu puro wu wari a sǝne? Wu wari a sǝn ɓwa mana oasǝ agir-nggūrǝu mǝɓoarne arǝì ka le? Awo, aɓwana mǝnana à oasǝkiyi agir-nggūrǝu mǝɓoarne arǝia ka à nda aɓalǝ apalta mala amurǝma.</char> <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><char style="wj">Sǝ mana ɗe wu wari a sǝne? Mǝɓangnǝa na le? E, ǝn nggǝ bangga wun, yì ka kútì mǝɓangnǝa.</char> <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><char style="wj">Yì nda ɓwa mǝnana à gilǝ mǝnia yì cau amurí ka ama:</char></para>
  <para style="q1" vid="MAT 11:10">
    <char style="wj">&lt;&lt;Mǝ nǝ túr mǝturonjar </char></para>
  <para style="q2" vid="MAT 11:10">
    <char style="wj">mem a ɓadǝmbo,</char></para>
  <para style="q1" vid="MAT 11:10">
    <char style="wj">mǝnana nǝ̀ yia gilǝkio njar </char></para>
  <para style="q2" vid="MAT 11:10">
    <char style="wj">ace yiu mô ka.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:10 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAL 3:1">Mal 3:1</ref>
      </char>.</note><verse eid="MAT 11:10" /></para>
  <para style="mi">
    <verse number="11" style="v" sid="MAT 11:11" />
    <char style="wj">Ən nggǝ na wun mǝsǝcau: Atà ɓwapǝndǝa kat ka à malaká ɓǝl kǝɓwa a ɓanza man mǝnana kum gulo kútì mala Yohana Mǝbatisǝma ka ɗàng; sǝama ɓwa mǝkyauwe kat a Domurǝm mala kùli ka, kútì Yohana nǝ gulo.</char> <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><char style="wj">Lo a nza mala Yohana Mǝbatisǝma yi bwal a dyan ngga, Domurǝm mala Kùli ka kǝ nutanni kǝ̀rkǝ́r a bu aɓwana, sǝ amǝ bumpina ka à kǝ̀ é nǝ rǝcandǝa.</char> <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" /><char style="wj">Amǝ'ɓangnǝa mala Ɓakuli kat andǝ malǝmce Nggurcau mala Musa ka, à hamna nǝ cau amur Domurǝm mala Ɓakuli yi pur a pwari mala Yohana.</char><note caller="+" style="f"><char style="fr" closed="false">11:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 16:16">Luk 16:16</ref></char>.</note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><char style="wj">Sǝ ɓǝ̀ wun nǝ̀ eare wun nǝ̀ ak cau mǝnia ka, Yohana ka nda Iliya mǝnana à bang ama nǝ̀ yiu ka.</char><note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 4:5-6">Mal 4:5-6</ref>; <ref loc="MAT 17:10-13">Mat 17:10-13</ref>; <ref loc="MRK 9:11-13">Mar 9:11-13</ref></char>.</note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" /><char style="wj">Ɓwa mǝnana kat ndanǝ akiru okban ngga ɓǝ̀ ok cau.</char><verse eid="MAT 11:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 11:16" />
    <char style="wj">Arǝ mana sǝ mǝ nǝ kànì amǝ'nza man? À nda kǝla amuna mana à do aɓa limo sǝ à kǝ akiarǝia tunǝkiban nǝ cau ama:</char><verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />
    <char style="wj">&lt;&lt;Sǝm twangga wun ntetu,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">sǝ wu ta'nggwam ɗang;</char></para>
  <para style="q1" vid="MAT 11:17">
    <char style="wj">sǝm tuka wun nggyal ɓua lú,</char></para>
  <para style="q2" vid="MAT 11:17">
    <char style="wj">sǝ wu ɓua ɗàng.&gt;&gt;</char><verse eid="MAT 11:17" /></para>
  <para style="mi">
    <verse number="18" style="v" sid="MAT 11:18" />
    <char style="wj">Yohana yiu, liki kǝgìr ɗàng, sǝ nuki kǝgìr gbal ɗàng. À yi bang ama, &lt;&lt;Ndanǝ kukwar arǝì.&gt;&gt;</char> <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><char style="wj">Muna mala Ɓwa yiu kǝ li sǝ kǝ nu, à yi bang ama, &lt;&lt;Mǝligula na sǝ mǝ'ɓiki nu mur anap na, gyajam mala amǝ'aki aboalo-cemi andǝ acilia amǝ'cauɓikea ka.&gt;&gt; Sǝ sǝlǝe mala Ɓakuli ka à kǝ súrǝì arǝ túró male.</char><verse eid="MAT 11:19" /></para>
  <para style="s">Yesu ɓǝsǝki amǝɓinǝ pwanzali</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luka 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Yesu kùtí a naki acau nǝ bumkiɗikea amur alá mana kya pakki agir-ndali kàm kútì acili abân kat ka, acemǝnana à ɓinǝ pwanzali ɓǝà nying acauɓikea malea ka. Na ama:<verse eid="MAT 11:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="MAT 11:21" />
    <char style="wj">Wun amǝ Korazin, ban nǝ ɓikea wun! Wun amǝ Beseda, ban nǝ ɓikea wun! Ɓǝ̀ ama agir-ndali mǝnana ǝn pea aɓalǝ alá ma'wun ngga à nda ǝn pea arǝ alá mala amǝ Taya andǝ amǝ Sidon ngga, ɓǝ́ à oasǝkina asanginagìr arǝia sǝ à songŋǝna tú amúrià ɗiɗyal mana nǝ̀ lǝmdǝ ama à nyìngŋǝ̀nà acauɓikea malea ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:21 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 23:1-18">Isha 23:1-18</ref>; <ref loc="EZK 26:1-28:26">Ezǝk 26:1--28:26</ref>; <ref loc="JOL 3:4-8">Jol 3:4-8</ref>; <ref loc="AMO 1:9">Amo 1:9</ref>,<ref loc="AMO 1:10">10</ref>; <ref loc="ZEC 9:2-4">Zak 9:2-4</ref></char>.</note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" /><char style="wj">Sǝ mim ngga ǝn nggǝ na wun ama gìr mǝnana nǝ̀ kum wun a pwari ɓashi ka, nǝ̀ ɓike nǝ̀ kútì gìr mana nǝ̀ kum amǝ Taya andǝ amǝ Sidon ngga.</char><verse eid="MAT 11:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 11:23" />
    <char style="wj">Sǝ we Kapanahum ngga, ama à nǝ̀ loasǝo a kùli le? Awo, a nggearǝ nzali a tūli-lú sǝ à nǝ̀ yinǝ we. Ɓǝ̀ ama agir-ndali mana ǝn pakkia a ɓālǝo ka ǝn pangŋǝnia a Sodom ngga ɓǝ́ yalung ngga ndakam più.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:23 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 14:13-15">Isha 14:13-15</ref>; <ref loc="GEN 19:24-28">Tite 19:24-28</ref></char>.</note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><char style="wj">Sǝ ǝn nggǝ no ama, gìr mǝnana nǝ̀ kúmǒ a pwari ɓashi ka, nǝ̀ ɓike nǝ̀ kútì gìr mǝnana nǝ̀ kum nzali Sodom ngga.</char><note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 14:13-15">Isha 14:13-15</ref>; <ref loc="GEN 19:24-28">Tite 19:24-28</ref></char>.</note><verse eid="MAT 11:24" /></para>
  <para style="s">Yesu kǝ pe aɓwana male usǝlǝo</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luka 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />A pwari mǝno ka Yesu na ama:</para>
  <para style="pi" vid="MAT 11:25">
    <char style="wj">Ən nggǝ ɓwangsǝo, we Dâ, mǝtala kùli andǝ nzali, ace mǝnana a sǝmbǝrǝ agir mǝnia ka arǝ amǝ'sǝlǝgir andǝ amǝ sǝlǝcau, sǝ a lǝmdǝia a banfana aban amǝ'ɗwanyi-sǝlǝe.</char> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" /><char style="wj">E, Dâ, anggo sǝ ɓoarô ama ɓǝ̀ pa.</char><verse eid="MAT 11:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="MAT 11:27" />
    <char style="wj">Tárrám Ɓakuli panam agir kat a ɓabuam. Kǝ ɓwa súrǝàm yì Muni ɗàng, she kǝ yì Ɓakuli Tárrám; sǝ kǝɓwa súrǝ̀ Ɓakuli yì Tárrám ɗàng, she kǝ mim Muni andǝ aɓwana mana ǝn tarkia mǝ nǝ lǝmdǝ Ɓakuli Tárrám abania ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">11:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JHN 1:18">Yoh 1:18</ref>; <ref loc="JHN 3:35">3:35</ref>; <ref loc="JHN 10:15">10:15</ref></char>.</note><verse eid="MAT 11:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="MAT 11:28" />
    <char style="wj">Wu yiu abanam, wun mǝnana kat wu kǝ tanni sǝ twalo dǝmbǝrya wun ngga, mǝ nǝ pà wun usǝlǝo.</char> <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" /><char style="wj">Wu pa ɓamur rǝ wun aɓata nzongcau mem, kǝla mana nda-rya kǝ pa ɓamúrì aɓata nggun-rya ka. Acemǝnana mǝ nda ɓukɓuk, nǝ nwangsǝmuru a ɓabum ngga, wu kànì arǝàm, sǝ yilǝmi wun nǝ̀ kum usǝlǝo.</char><note caller="+" style="f"><char style="fr" closed="false">11:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 6:16">Ir 6:16</ref></char>.</note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" /><char style="wj">Nggun-rya mem ngga nda halku, sǝ twalo mem ngga nda hapǝlam.</char><verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Mǝtala Sabbat</para>
  <para style="r">(<ref loc="MRK 2:23-28">Markus 2:23-28</ref>; <ref loc="LUK 6:1-5">Luka 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Anzǝm amǝno yì acau ka, a ɓè pwari Sabbat Yesu andǝ alaggana male na aban gya nǝ ban aɓaban mǝssa. Alaggana male ka nzala walia sǝ à kùtí a harki kir mǝssa, à kǝ she.<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 23:25">Nggur 23:25</ref></char>.</note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Amǝ Farisi nǝ̀ yia sǝnia ka, à banggi Yesu ama, &lt;&lt;Sǝni, gìr mǝnia alaggana mô kǝ pè a pwari Sabbat ka, yàl Nggurcau ma'sǝm na.&gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Sǝ pǝlǝia wia ama:</para>
  <para style="pi" vid="MAT 12:3">
    <char style="wj">Wu ɓal gìr mǝnana Dauda pak a pwari mana yì andǝ ɓwana male ka nzala walia ka re?</char> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><char style="wj">Yi kutio a Ndà mala Ɓakuli sǝ yì andǝ aɓwana mana atè ka, à kya shak bǝredi mǝnana à tàrì ɓǝ̀ duk mǝfele ka, mana ɓoaro ɓǝà li ka ɗàng, ace mǝnana bǝredinî ka, nda ace apǝris nǝmurǝia.</char><note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1SA 21:1-6">1Sam 21:1-6</ref>; <ref loc="LEV 24:9">Pǝris 24:9</ref></char>.</note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><char style="wj">Ko wu ɓal mbo aɓa Nggurcau mala Musa ama, koya pwari Sabbat a Ndàmǝgule mala Ɓakuli ka apǝris kǝ yâl nzongcau mala Sabbat sǝ à sǝnia nǝ cauɓikea raka?</char><note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 28:9">Ɓal 28:9</ref>,<ref loc="NUM 28:10">10</ref></char>.</note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" /><char style="wj">Ən nggǝ na wun ama, ɓwa mǝnana kútì Ndàmǝgule mala Ɓakuli nǝ gulo ka nda kani.</char> <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><char style="wj">Ɓǝ̀ wu sùrǝ́nà rǝ ɓá mǝnia yì cau mǝnana ama, &lt;&lt;Mǝsǝswatǝr na ǝn earkiyice ka, pà gir'nkila na raka,&gt;&gt; ɓǝ́ pa wun nǝ̀ ɓǝsǝki aɓwana mana à panǝ cau arǝia raka ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 9:13">Mat 9:13</ref>; <ref loc="HOS 6:6">Hos 6:6</ref></char>.</note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" /><char style="wj">Mim, Muna mala Ɓwa ka Mǝ nda Mǝtala Sabbat.</char><verse eid="MAT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu nying ban mǝno ka, yi kutio aɓa ndakpapi malea. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Ɓè ɓwabura mǝnana ɓè buì wu ka ndakam abanì. Amǝ Farisi ka, à ndarǝ alta njar à nǝ̀ kum mǝɓane mǝnana à nǝ̀ na arǝ Yesu ka. Pǝlǝa à ɗì ama, &lt;&lt;Nggearǝì ka, Nggurcau ma'sǝm eare ama ɓǝà twalban rǝkwana a pwari Sabbat le?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Pǝlǝa earia wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ ɓè kǝɓwa atà wun ndanǝ nzur male, sǝ nzurnì yi kpa a tūli, a pwari Sabbat ka, ɓwe pà nǝ̀ nggá bwali nǝ̀ eamsǝi re?</char><note caller="+" style="f"><char style="fr" closed="false">12:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 14:5">Luk 14:5</ref></char>.</note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><char style="wj">Ɓwapǝndǝa ka kútì nzur. Acemani ka Nggurcau eare ama ɓǝà amsǝ ɓwa mana nda aɓa tanni ka a pwari Sabbat.&gt;&gt;</char><verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Pǝlǝa banggi ɓwabure ama, <char style="wj">&lt;&lt;Sárǝ́ buò.&gt;&gt;</char> Ɓwabure pǝlǝa sárǝ́ buì, sǝ buì nyare pak pepe kǝla ɓì. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Amǝ Farisi pǝlǝa à puro a nza à kya kurkunarǝia amur njar mǝnana à nǝ̀ kùmô à nǝ̀ wal Yesu ka.<verse eid="MAT 12:14" /></para>
  <para style="s">Yesu nda Guro mala Ɓakuli <optbreak /> mana tàrì ka</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu yi sǝlǝia wia ka, pǝlǝa nying banì. Aɓwana pas o atè. Amǝkwánó mǝnana aɓalǝia ka, Yesu yi twalia wia ban arǝkwana malea kat. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Yi nunkiria ɓǝà kǝa ne kǝɓwa yan nda yì ɗàng. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Mǝnia ka nda lùmsǝ cau mala Ishaya mǝɓangnǝa mala Ɓakuli ka. Na ama:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;&lt;Guro mem mǝnana</para>
  <para style="q1" vid="MAT 12:18">ǝn tarì ka ndya ka,</para>
  <para style="q2" vid="MAT 12:18">mǝnana ǝn nggǝ earce</para>
  <para style="q2" vid="MAT 12:18">sǝ bumam kǝ pwasǝa rǝì ka.</para>
  <para style="q1" vid="MAT 12:18">Mǝ nǝ tsǝki wi Bangŋo</para>
  <para style="q1" vid="MAT 12:18">mem amurí,</para>
  <para style="q2" vid="MAT 12:18">sǝ yì ka nǝ̀ hamnǝ ɓashi</para>
  <para style="q1" vid="MAT 12:18">mem mǝ'mǝsǝcaunì</para>
  <para style="q2" vid="MAT 12:18">aban aɓwana a ɓanza</para>
  <para style="q1" vid="MAT 12:18">ama à nǝ̀ kum amsǝban</para>
  <para style="q2" vid="MAT 12:18">a buàm.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Pà nǝ̀ pǝlǝki rǝì andǝ kǝɓwa,</para>
  <para style="q2" vid="MAT 12:19">ko nǝ̀ loàsǝ̀ban ɗang;</para>
  <para style="q1" vid="MAT 12:19">kǝɓwa pà nǝ̀ ok gì</para>
  <para style="q2" vid="MAT 12:19">aɓalǝ aɓwana ɗàng.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Yì ka, nda ɓukɓuk</para>
  <para style="q2" vid="MAT 12:20">aban aɓwana mǝnana</para>
  <para style="q2" vid="MAT 12:20">à pànǝ rǝcandǝa raka,</para>
  <para style="q1" vid="MAT 12:20">sǝ nǝ̀ sǝn mǝsǝswatǝr</para>
  <para style="q2" vid="MAT 12:20">mala aɓwana mǝnana</para>
  <para style="q1" vid="MAT 12:20">à nda ɓá tanni ka,</para>
  <para style="q2" vid="MAT 12:20">nǝ̀ bwalia wia kam. <note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="fq" closed="false">Yì ka, nda ɓukɓuk aban aɓwana mǝnana à pànǝ rǝcandǝa raka, sǝ nǝ̀ sǝn mǝsǝswatǝr mala aɓwana mǝnana à nda ɓá tanni ka, nǝ̀ bwalia wia kam. </char><char style="ft" closed="false">Ko: Nzuno mǝnana à pari ɓun ngga pà nǝ̀ kasǝi ɗàng, sǝ bǝsa mǝnana kǝ ɓariki nǝ̀ lo earke arǝ kǝkar ka pà nǝ̀ lìmì ɗàng. </char></note></para>
  <para style="q1" vid="MAT 12:20">Nǝ̀ lidǝmba nǝ pa rǝcandǝa</para>
  <para style="q2" vid="MAT 12:20">arǝ pe anggo</para>
  <para style="q1" vid="MAT 12:20">she ɓǝ̀ tsǝ̀ngŋǝ̀nà</para>
  <para style="q2" vid="MAT 12:20">kpata-mǝsǝcau</para>
  <para style="q1" vid="MAT 12:20">linamurǝm ngga.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Arǝì sǝ aɓwana kat</para>
  <para style="q2" vid="MAT 12:21">a ɓanza nǝ̀ tsǝkɓalǝia.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 42:1-4">Isha 42:1-4</ref></char>.</note><verse eid="MAT 12:21" /></para>
  <para style="s">Yesu kutì Murǝm mala Akukwar</para>
  <para style="r">(<ref loc="MRK 3:23-24">Markus 3:23-24</ref>; <ref loc="LUK 11:17-22">Luka 11:17-22</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Pǝlǝa aɓea ɓwana yinǝ ɓè nte mǝnana kukwar na arǝì sǝ mǝtalasǝ-ɓunna na ka, aban Yesu. Yesu twali wi ban kwánó male, sǝ ɓwe tita nacau sǝ kǝ sǝnban. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Ɓwabunda kat ndali sǝ à ɗìban ama, &lt;&lt;Ko Yesu ka nda Muna mala Dauda,<note caller="+" style="f"><char style="fr" closed="false">12:23 </char><char style="fq" closed="false">Muna mala Dauda: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkà Dauda.&gt;&gt;</char></note> Mǝ'amsǝban mǝnana sǝm kundǝkiyi yiu male ka le?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Sǝ amǝ Farisi ka, lang à ok mǝnia yì cau ka à bang ama, pa ɓà ɗàng, nǝ rǝcandǝa mala Be'elzebul, Murǝm mala akukwar sǝ kǝ pusǝki akukwar.<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 9:24">Mat 9:24</ref>; <ref loc="MAT 10:25">10:25</ref></char>.</note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Yesu súrǝ̀ ɗenyicau malea pǝlǝa nea wia ama:</para>
  <para style="pi" vid="MAT 12:25">
    <char style="wj">Nzali mana kat aɓwana male kǝ munǝo arǝarǝia ka</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:25 </char>
      <char style="fq" closed="false">Nzali mana kat aɓwana male kǝ munǝo arǝarǝia ka: </char>
      <char style="ft" closed="false">Ko &lt;&lt;Ɓǝ̀ kún murǝm kǝ ɓua andǝ amǝtè ka&gt;&gt;</char>
    </note> <char style="wj">domurǝm malea nǝ̀ kìɗìkì. Là ko ɓala mǝnana gau ka pà nǝ̀ cam ɗang.</char> <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" /><char style="wj">Ɓǝ̀ Shetan kǝ pusǝ Shetan ngga, ɓala gauna arǝì. Lang sǝ domurǝm male nǝ̀ came?</char> <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" /><char style="wj">Ɓǝ̀ ǝn nggǝ pusǝ akukwar nǝ rǝcandǝa mala Be'elzebul ka, nǝ mana sǝ aɓwana ma'wun kǝ pusǝia? Yia na à nǝ̀ ɓashia wun ngga.</char> <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" /><char style="wj">Sǝ ɓǝ̀ nǝ Bangŋo mala Ɓakuli sǝ ǝn nggǝ pusǝ akukwar ka, lǝmdǝ ama Domurǝm mala Ɓakuli yina aɓalǝ wun.</char><verse eid="MAT 12:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="MAT 12:29" />
    <char style="wj">Sǝ ɗǝm ngga, lang sǝ ɓwa nǝ̀ kutio a ɓala mala ɓwabura-ɓwa nǝ̀ pwan agirkuma male, sǝ ak dǝmba taka abú yì ɓwabura-ɓwa ɗàng? Ɓǝ̀ pa anggo raka pà nǝ̀ gandǝ pwan agirkuma male ɗàng.</char><verse eid="MAT 12:29" /></para>
  <para style="pi">
    <verse number="30" style="v" sid="MAT 12:30" />
    <char style="wj">Ɓwa mǝnana pà atàm raka nda a ɓibura nǝ mim, sǝ ɓwa mǝnana kǝ bwalàm ramgi gìr raka, ndarǝ mesǝke.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:30 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 9:40">Mar 9:40</ref>
      </char>.</note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" /><char style="wj">Ace mani ka ǝn nggǝ na wun ama, koya cauɓikea andǝ na caukyauwikiban mǝnana aɓwana ne amur Ɓakuli ka, à nǝ̀ twalbani, sǝ ɓwa mǝnana na caukyauwikiban amur Bangŋo mala Ɓakuli ka, à pà nǝ̀ twali wi banì ɗàng.</char> <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><char style="wj">Ɓwa mǝnana na caukyauwikiban amur Muna mala Ɓwa ka, à nǝ̀ twali wi banì, sǝ ɓwa mǝnana na caukyauwikiban amur Bangŋo Mǝfele ka, à pà nǝ̀ twali wi banì ɗang, a ɓanza mǝnia andǝ ɓanza mǝnana nǝ̀ yiu ka.</char><note caller="+" style="f"><char style="fr" closed="false">12:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:10">Luk 12:10</ref></char>.</note><verse eid="MAT 12:32" /></para>
  <para style="s">Nggun andǝ aɓǝle</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luka 6:43-45</ref>)</para>
  <para style="pi">
    <verse number="33" style="v" sid="MAT 12:33" />
    <char style="wj">Ɓǝ̀ nggun ɓoar ka ɓǝle gbal ka nǝ̀ ɓoaro, sǝ ɓǝ̀ nggun ngga mǝɓane na ka, ɓǝle gbal ka nǝ̀ duk mǝɓane; nggun ka à surǝ́ki arǝ ɓǝle.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:33 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 7:20">Mat 7:20</ref>; <ref loc="LUK 6:44">Luk 6:44</ref></char>.</note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><char style="wj">Wun amuna baffu, lang sǝ cau mǝɓoarne nǝ̀ pur a kun wun, yi mǝnana wu nda ka amǝ'ɓealɓikea ka? Gìr mǝnana nda a ɓabum ngga, nda kún banggiyi ka.</char><note caller="+" style="f"><char style="fr" closed="false">12:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 3:7">Mat 3:7</ref>; <ref loc="MAT 15:18">15:18</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">Luk 3:7</ref>; <ref loc="LUK 6:45">6:45</ref></char>.</note> <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><char style="wj">Ɓwa mǝɓoarne kǝ pusǝ aɓa cau mǝɓoarne mǝnana ramba a ɓabumi ka, sǝ ɓwa mǝɓane gbal ka, kǝ pusǝ aɓa mǝɓane mǝnana ramba a ɓabumi ka.</char> <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" /><char style="wj">Sǝ ǝn nggǝ na wun ama a pwari ɓashi ka, aɓwana nǝ̀ bǝlki ɓá koya cau mǝɓane na pur a kunia ka.</char> <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" /><char style="wj">Acau mǝnana à pur a kuno ka, à nda à nǝ̀ pakko ɓashi nǝia ka. À nǝ̀ amsǝo ko à nǝ̀ kùró.</char><verse eid="MAT 12:37" /></para>
  <para style="s">Aɓwana alta gir'lǝmdǝa nǝ kuli</para>
  <para style="r">(<ref loc="MRK 8:11-12">Markus 8:11-12</ref>; <ref loc="LUK 11:29-32">Luka 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Aɓea amǝ Farisi andǝ amǝkani Nggurcau ne wi ama, &lt;&lt;Malǝm, sǝm nggǝ earce sǝn ɓè kǝgìr mǝgule mǝnana nǝ̀ lǝmdǝa sǝm ama rǝcandǝa mò ka pur nǝban Ɓakuli.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:1">Mat 16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char>.</note><verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Sǝ nyesǝia wia ama:</para>
  <para style="pi" vid="MAT 12:39">
    <char style="wj">Kǝ nza mala amǝ'ɓealɓikea andǝ amǝ'ɗwanyi súrǝ̀ Ɓakuli na à nǝ̀ alta sǝn gìr'ndali ka. Sǝ ɓekǝ gìr'ndali pà kàm à nǝ̀ lǝmdǝa wun ɗàng shekǝ mala mǝɓangnǝa Yunana.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12:39 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 16:4">Mat 16:4</ref>; <ref loc="MRK 8:12">Mar 8:12</ref></char>.</note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><char style="wj">Kǝla mǝnana Yunana pak pwari tàrú andǝ du tàrú a bum nggea nji ka, anggo gbal sǝ Muna mala Ɓwa nǝ̀ pak pwari tàrú andǝ du tàrú aɓa nzali.</char><note caller="+" style="f"><char style="fr" closed="false">12:40 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JON 1:17">Yun 1:17</ref></char>.</note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><char style="wj">A pwari ɓashi ka amǝ Nineva nǝ̀ lo à nǝ̀ mak wun amǝ nza mǝnia. Acemǝnana à nying acauɓikea malea lang à oangna hama mala Yunana ka, sǝ ɓwa mǝnana kútì Yunana ka ndakani.</char><note caller="+" style="f"><char style="fr" closed="false">12:41 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JON 3:5">Yun 3:5</ref></char>.</note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><char style="wj">A pwari ɓashi ka Mā-murǝm mala amǝ Sheba nǝ̀ lo nǝ̀ mak amǝ nza man; acemǝnana pur a nzali male kuko a njar-kunmur sǝ yiu ace ok sǝlǝe mala Solomon; sǝ ɓwa mǝnana kútì Solomon ngga ndakani.</char><note caller="+" style="f"><char style="fr" closed="false">12:42 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 10:1-10">1Amur 10:1-10</ref>; <ref loc="2CH 9:1-12">2Acau 9:1-12</ref></char>.</note><verse eid="MAT 12:42" /></para>
  <para style="s">Nyare mala bangŋo mǝɓane</para>
  <para style="pi">
    <verse number="43" style="v" sid="MAT 12:43" />
    <char style="wj">Ɓǝ̀ bangŋo mǝɓane purî rǝ ɓwa ka, pak ka kǝ gāli arǝ aban mǝ'ime ace alta ban usǝlǝo, sǝ ɓǝ̀ kum raka,</char> <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" /><char style="wj">pǝlǝa nǝ̀ na ama, &lt;&lt;Mǝ nǝ nyare a ɓala mǝnana ǝn pur kàm ngga.&gt;&gt; Sǝ ɓǝ̀ nyare yi kum ɓala na atarǝì, à esǝkini sǝ à gilǝkini ka,</char> <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><char style="wj">pǝlǝa nǝ̀ o nǝ̀ nggá yinǝ aɓea bangŋo tongno-nong-ɓari mǝnana à kútì nǝ ɓealɓikea ka, sǝ à nǝ̀ yia kutio à nǝ̀ do aɓalǝi. Masǝlǝata mǝnia yì ɓwa ka nǝ̀ ɓike nǝ̀ kútì mǝdǝmbe. Anggo sǝ nǝ̀ pang nǝ nza mǝɓealɓike mǝnia.</char><verse eid="MAT 12:45" /></para>
  <para style="s">Nggea Yesu andǝ Amǝ'eambi</para>
  <para style="r">(<ref loc="MRK 3:31-35">Markus 3:31-35</ref>; <ref loc="LUK 8:19-21">Luka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesu na mur banggi ɓwabundǝa cau sǝ nggè andǝ amǝ'eambi yiu à yi came a nza. À kǝ earce ama à nǝ̀ bang cau nǝi. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ɓè ɓwa banggi wi ama, &lt;&lt;Sǝni, nggò andǝ amǝ'eambo nia came a nza ka, ama à nǝ̀ no cau.&gt;&gt;<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Pǝlǝa Yesu pǝlǝi wi ama, <char style="wj">&lt;&lt;Yana nda nggèm, sǝ ayana à nda ka amǝ'eambam?&gt;&gt;</char> <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Pǝlǝa lǝmdǝ buì arǝ alaggana male sǝ bang ama, <char style="wj">&lt;&lt;Amǝnia ka, à nda ka nggem andǝ amǝ'eambam.</char> <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="wj">Ɓwa mǝnana kat kǝ pak gìr mǝnana Tárrám mana a kùli ka earkiyice ka, nda mǝ'eambam, andǝ mǝ'nggaulem, andǝ nggem.&gt;&gt;</char><verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Kanicau arǝ Mǝɓeale</para>
  <para style="r">(<ref loc="MRK 4:1-9">Markus 4:1-9</ref>; <ref loc="LUK 8:4-8">Luka 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Àkǝ̀ pwari mǝno ka Yesu puro nying ɓala sǝ kya do a kún Garang. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Aɓwabundǝa mana à yì ramba a banì ka à làkkì kǝ̀rkǝ́r gandǝa eauwe do aɓa muna-waru, sǝ aɓwana kat came a kún mur.<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 5:1-3">Luk 5:1-3</ref></char>.</note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Pǝlǝa banggia wia agir pas nǝ́ kanicau. Na ama:</para>
  <para style="pi" vid="MAT 13:3">
    <char style="wj">Mǝ'rya puro wari a ɓeale.</char> <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" /><char style="wj">Lang ndarǝ kwak mǝsǝɓeale ka aɓea sukkio amur njargula, sǝ amuna-nyal sulǝo à yì tarkia.</char> <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" /><char style="wj">Aɓea kpa a mǝsǝtali, a ban mǝnana nzali pa akàm pepè raka. Zuku ka à yì sangna acemǝnana nzali banì lim ɗàng.</char> <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" /><char style="wj">Lang pwari camta ka, kara à wulì. À ime acemǝnana nlerǝia bwal nzali pepè ɗàng.</char> <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" /><char style="wj">Aɓea mǝsǝɓeale kpa aɓalǝ azwe. Azwe gulo à sorǝkia.</char> <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" /><char style="wj">Aɓea mǝsǝɓeale kpa amur nzali mǝɓoarne, à yì ɓǝl pas à kútì mǝsǝɓeale kusǝ gbǝman, aɓea ka kusǝ lumi-tongno-nong-mwashat, sǝ aɓea ka kusǝ lumi-tàrú.</char> <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" /><char style="wj">Ɓwa mǝnana ndanǝ akiru ka ɓǝ̀ o.</char><verse eid="MAT 13:9" /></para>
  <para style="s">Tǝr bangcau mala Yesu <optbreak /> nǝ akanicau</para>
  <para style="r">(<ref loc="MRK 4:10-12">Markus 4:10-12</ref>; <ref loc="LUK 8:9-10">Luka 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Alaggana male yiu a baní à ɗì ama, &lt;&lt;Ace mana sǝ a kǝ ne aɓwana cau nǝ kanicau?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesu earia wia ama:</para>
  <para style="pi" vid="MAT 13:11">
    <char style="wj">Súrǝ̀ gir-ɓasǝmbǝrǝa mala Domurǝm mala kùli ka à pana wuni, sǝ yia ka à pea wia ɗàng.</char> <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><char style="wj">Aɓwana mana à kǝ kwakikiria arǝ kanigir mem ngga à nǝ̀ pea wia ɓè sǝlǝ amur mǝnana à ndanǝi ka, sǝ à nǝ̀ kum súrǝ̀gir kpǝm. Sǝ aɓwana mana à kǝ kwaki kiria raka, kǝ mǝnana à ndanǝi ka à nǝ̀ é a rǝia.</char><note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 25:29">Mat 25:29</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luk 8:18</ref>; <ref loc="LUK 19:26">19:26</ref></char>.</note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" /><char style="wj">Mǝnia ka nda gìr mana tsǝa sǝ ǝn nggǝ nea wia cau nǝ kanicau ka.</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">À ndanǝ amǝsǝu,</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">sǝ à kǝ sǝnban ɗang;</char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">À ndanǝ akiru,</char></para>
  <para style="q2" vid="MAT 13:13">
    <char style="wj">sǝ à kǝ ok cau </char></para>
  <para style="q1" vid="MAT 13:13">
    <char style="wj">kpakia wia ɗàng.</char><verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />
    <char style="wj">Abania ka ɓangnǝa mala Ishaya yi lùmsǝó, mana ama:</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">&lt;&lt;Wun nǝ̀ nggǝ o,</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">sǝ pà nǝ̀ kpaka wun ɗàng.</char></para>
  <para style="q1" vid="MAT 13:14">
    <char style="wj">Wun nǝ̀ nggǝ sǝna,</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="wj">sǝ pà wu nǝ̀ bwalte ɗàng.</char><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="wj">Ɓabum aɓwana mǝnia ka </char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">jimgbǝrina;</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">à kǝ gandǝ okban </char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">nǝ akiria ɗàng,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">sǝ yià ka à girkina amǝsǝia.</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">Ɓǝ̀ ana raka mǝsǝia nǝ̀ sǝnban,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">à nǝ̀ okban nǝ akiria,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">à nǝ̀ bwalta ɓacau</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">nǝ ɓabumia,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">sǝ à nǝ̀ pǝlǝa, </char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="wj">à nǝ̀ nyare abanam,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="wj">sǝ mǝ nǝ sonzǝia.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13:15 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 6:9">Isha 6:9</ref>,<ref loc="ISA 6:10">10</ref></char>.</note><verse eid="MAT 13:15" /></para>
  <para style="mi">
    <verse number="16" style="v" sid="MAT 13:16" />
    <char style="wj">Ma'wun she ka múr wun ɓoaro. Acemǝnana amǝsǝ wun kǝ sǝnban, sǝ akir wun kǝ okban.</char> <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" /><char style="wj">Ən nggǝ bangga wun mǝsǝcau, amǝ'ɓangnǝa mala Ɓakuli andǝ aɓwana mala Ɓakuli pas pàk nzal sǝn gìr mana wu kǝ sǝn ngga, sǝ à kumô à sǝn ɗàng. À earǝna ce oě, sǝ à kumô à ok ɗàng.</char><verse eid="MAT 13:17" /></para>
  <para style="s">Yesu bǝlki ɓá kanicau <optbreak /> arǝ mǝɓeale</para>
  <para style="r">(<ref loc="MRK 4:13-20">Markus 4:13-20</ref>; <ref loc="LUK 8:11-15">Luka 8:11-15</ref>)</para>
  <para style="pi">
    <verse number="18" style="v" sid="MAT 13:18" />
    <char style="wj">Wu kwaki kir wun wu ok ɓá kanicau mala mǝɓeale:</char> <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" /><char style="wj">Ɓǝ̀ ɓwa ok cau mǝɓoarne amur Domurǝm mala kùli,</char><note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="fq" closed="false">Domurǝm mala kùli: </char><char style="ft" closed="false">Ko &lt;&lt;Domurǝm mala Ɓakuli amur aɓwana.&gt;&gt;</char></note> <char style="wj">sǝ cê kpākì wi raka, nda kǝla mǝsǝɓeale mana kpa a tanjargula ka. Mǝɓealɓikea kǝ yiu kǝ fwa gìr mana à ɓeali a ɓabumi ka.</char> <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" /><char style="wj">Mǝsǝɓeale mǝnana kpa amur taliban ngga cam a kún ɓwa mǝnana ok cê sǝ é tù nǝ bumpwasǝa.</char> <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" /><char style="wj">Sǝ acemǝnana nlerǝi ko a nzali raka, gandǝ came banì sau ɗang. Pwari mǝnana tanni yipì wi acemǝnana paɓamuri arǝ cau mala Ɓakuli ka, nǝ̀ kaurǝ a kpa.</char> <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" /><char style="wj">Mǝsǝɓeale mǝnana kpa aɓalǝ azwe ka, nda cam a kún ɓwa mana kǝ ok cê, sǝ bumpina arǝ alta agir mala ɓanza mǝnia andǝ swarkiban mala kume à yì marǝki sǝ à tsǝi pusǝ ɓǝle ɗàng.</char> <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" /><char style="wj">Sǝ mǝnana kpa amur nzali mǝɓoarne ka cam a kún ɓwa mǝnana ok cau mala Ɓakuli sǝ kpākì wi ka. A buì mǝnia ka pà ɓǝle gbǝman, a ɓè buì ka pà ɓǝle lumi-tongno-nong-mwashat, sǝ a ɓè ka lumi-tàrú.</char><verse eid="MAT 13:23" /></para>
  <para style="s">Kanicau amur mǝssa <optbreak /> andǝ nkwangŋan</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu nea wia ɓè kanicau ɗǝm ama:</para>
  <para style="pi" vid="MAT 13:24">
    <char style="wj">À nǝ̀ kànì Domurǝm mala kùli arǝ ɓeɓwa mǝnana ɓeal mǝsǝɓeale mǝɓoarne a ɓaban male ka.</char> <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="wj">Lang aɓwana nda ntulo kat ka, ɓimǝbura yiu yi ɓeal nkwangŋan aɓa mǝssa, sǝ pǝlǝa o.</char> <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" /><char style="wj">Mǝssa tita bwalo, sǝ nkwangŋan pusǝrǝi.</char><verse eid="MAT 13:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="MAT 13:27" />
    <char style="wj">Aguro mala mǝtala ɓabanì yiu a baní sǝ à ɗì ama, &lt;&lt;Ɓwamǝgule, mǝsǝɓeale mǝɓoarne na a ɓeal a ɓaban mô ka re? Sǝ ankwangŋan pur nǝ kǝshe?&gt;&gt;</char><verse eid="MAT 13:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="MAT 13:28" />
    <char style="wj">Sǝ na ama, &lt;&lt;Ɓiam-mǝbura nǝ pak gìr man.&gt;&gt;</char></para>
  <para style="pi" vid="MAT 13:28">
    <char style="wj">Sǝ aguro ɗì ama, &lt;&lt;A earce ama ɓǝ̀ sǝm kya ukkia le?&gt;&gt;</char><verse eid="MAT 13:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="MAT 13:29" />
    <char style="wj">Sǝ earia wia ama, &lt;&lt;Awo, acemǝnana ɓǝ̀ wu ndarǝ ukki ankwangŋan ngga, wun nǝ̀ gandǝ ukkia andǝa mǝssa.</char> <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><char style="wj">Wu ɗekia ɓǝà gulo atārǝia. Pwari wale ka mǝ nǝ ne amǝtúró ɓǝà tàr nkwangŋan ɓǝà kùrkia sǝ ɓǝà pisǝia. Sǝ mǝssa ka ɓǝà soapa mi a bà.&gt;&gt;</char><verse eid="MAT 13:30" /></para>
  <para style="s">Kanicau arǝ mǝsǝ musta</para>
  <para style="r">(<ref loc="MRK 4:30-32">Markus 4:30-32</ref>; <ref loc="LUK 13:18-21">Luka 13:18-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu banggia wia ɓè kanicau ɗǝm ama:</para>
  <para style="pi" vid="MAT 13:31">
    <char style="wj">À nǝ̀ kànì Domurǝm mana a kùli ka arǝ mǝsǝ musta, mǝnana ɓeɓwa twali sǝ ɓeali a ɓaban male ka.</char> <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><char style="wj">Atà amǝsǝɓeale kat ka nda mǝsǝì kèke kútìban ngga, sǝ ɓǝ̀ yi gulna ka kǝ gulo kǝ kútì acili agirpwala, sǝ kǝ pǝlǝ nggun mǝnana amuna-nyal mana a kùli ka à kǝ bwal ndà arǝ abui ka.</char><verse eid="MAT 13:32" /></para>
  <para style="s">Kanicau arǝ yist</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luka 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesu nea wia ɓè kanicau ɗǝm ama:</para>
  <para style="pi" vid="MAT 13:33">
    <char style="wj">Domurǝm mala kùli ka nda kǝla yist mǝnana ɓè ɓwama twali sǝ sùrǝì andǝ muku tasau tàrú, sǝ yi aki ɓá muku tsǝi vwali.</char><verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu ne aɓwana acau mǝnia ka kat nǝ akanicau. Kǝ cau pà kàm mǝnana banggia wia mana kanicau pà kàm raka. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Pak mǝnia ka ace mǝnana ɓǝà lùmsǝ cau mana mǝɓangnǝa mala Ɓakuli bang ama,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Mǝ nǝ mǝn kunam</para>
  <para style="q2" vid="MAT 13:35">nǝ kanicau,</para>
  <para style="q1" vid="MAT 13:35">Mǝ nǝ arkia wia ɓalǝ agir</para>
  <para style="q2" vid="MAT 13:35">mana à nda aɓa sǝmbǝrǝa</para>
  <para style="q1" vid="MAT 13:35">pur a tita ɓanza ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 78:2">Ang 78:2</ref></char>.</note><verse eid="MAT 13:35" /></para>
  <para style="s">Yesu bǝlki ɓá kanigir <optbreak /> amur nkwangŋan</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Yesu ɗeki ɓwabundǝa a nza pǝlǝa kutio a ɓala. Alaggana male kutio atè à yì ne wi ama, &lt;&lt;Bǝla sǝm ɓá kanicau mana amur nkwangŋan a ɓaban ngga.&gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Sǝ Yesu pǝlǝia wia ama:</para>
  <para style="pi" vid="MAT 13:37">
    <char style="wj">Ɓwa mǝnana ɓeal mǝsǝɓeale mǝɓoarne ka nda Muna mala Ɓwa.</char> <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" /><char style="wj">Ɓaban ngga nda ɓanza, sǝ amǝsǝɓeale mǝɓoarne ka à nda ka muna mala Ɓakuli a Domurǝm male. Sǝ ankwangŋan ngga à nda ka muna mala Mǝɓealɓikea.</char> <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" /><char style="wj">Ɓibura mǝnana ɓeal nkwangŋan ngga nda Shetan. Wal-mǝsa ka nda masǝlǝata ɓanza, sǝ amǝ'walmǝsa ka à nda ka amǝturonjar mala Ɓakuli.</char><verse eid="MAT 13:39" /></para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 13:40" />
    <char style="wj">Kǝla mǝnana à kǝ ram nkwangŋan sǝ à nǝ̀ pisǝì a bǝsa ka, anggo sǝ nǝ̀ pa a masǝlǝata ɓanza gbal.</char> <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><char style="wj">Muna mala Ɓwa nǝ̀ túr amǝturonjar male, ɓǝà yi pusǝ koya gìr mǝnana kat kǝ yiu nǝ cauɓikea, andǝ aɓwana mǝnana kat à kǝ pak gìr mǝɓane aɓa Domurǝm male ka.</char> <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><char style="wj">À nǝ̀ ramtea aɓa bǝsa mǝnana pi kǝ̀rkǝ́r ka. A ban mǝno ka à nǝ̀ nggǝ ɓua sǝ à nǝ̀ nggǝ nǝmggi munabuia.</char> <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><char style="wj">Sǝ amǝ'ɓealɓoarna ka à nǝ̀ tǎ kǝla pwari aɓa Domurǝm mala Tárrià. Ɓwa mǝnana ndanǝ kir okban ngga, ɓǝ̀ ǒ.</char><verse eid="MAT 13:43" /></para>
  <para style="s">Kanicau arǝ gǝna <optbreak /> mǝnana sǝmbǝrǝ ka</para>
  <para style="pi">
    <verse number="44" style="v" sid="MAT 13:44" />
    <char style="wj">Domurǝm mala kùli ka nda kǝla gǝna mǝnana sǝmbǝrǝa a ɓè ɓaban ngga. Ɓè ɓwa kumi sǝ sǝmbǝrǝi. Banɓoarnado tsǝi makki agirkuma male kat, yi kúr mǝno yì ɓaban ngga.</char><verse eid="MAT 13:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="MAT 13:45" />
    <char style="wj">Ɗǝm ngga Domurǝm mala kùli ka nda kǝla mǝ'nggaliki mǝnana kǝ alta nzali ka.</char> <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><char style="wj">Lang yi kumǝna mǝɓoarne ka, pǝlǝa nyare o kya makki agir male kat sǝ yi kúrí.</char><verse eid="MAT 13:46" /></para>
  <para style="s">Kànìgìr arǝ ndámbú</para>
  <para style="pi">
    <verse number="47" style="v" sid="MAT 13:47" />
    <char style="wj">Ɗǝm ngga, Domurǝm mana a kùli ka nda kǝla ndámbú mǝgule mǝnana à túrí a nggeamùr sǝ bwal koya ulang nji kat ka.</char> <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" /><char style="wj">Lang ndámbú lùmsǝ̀nà ka, amǝkpakya sunyi à yinǝi a nza. À yì do à tàrki anji mǝɓoarne aɓalǝ azace, sǝ amǝɓane ka à sukkia.</char> <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" /><char style="wj">Anggo sǝ nǝ̀ pa a masǝlǝata ɓanza. Amǝturonjar mala Ɓakuli nǝ̀ yiu à nǝ̀ yia pusǝki amǝ'ɓealɓikea aɓalǝ amǝ'ɓealɓoarna</char> <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" /><char style="wj">sǝ à nǝ̀ ramta amǝ'ɓealɓikea aɓa ndà-bǝsa. Akàm ngga à nǝ̀ ɓua à nǝ̀ nggǝ nǝmggi munabuia.</char><verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu ɗia ama, <char style="wj">&lt;&lt;Wu bwalǝna ta amǝnia yì acau ka le?&gt;&gt;</char></para>
  <para style="p" vid="MAT 13:51">À ear ama, &lt;&lt;E, kpana sǝm.&gt;&gt;<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Pǝlǝa nea wia ama <char style="wj">&lt;&lt;Ace mani ka, mǝ'eaulǝki Nggurcau mala Musa mǝnana à kani wi gìr, kum kwar-rǝǔ ace Domurǝm mala kùli ka, nda kǝla mǝtala-ɓala mǝnana kǝ pusǝ gǝna mǝbǝshe andǝ amǝ'e aɓa bah male ka.&gt;&gt;</char><verse eid="MAT 13:52" /></para>
  <para style="s">Amǝ Nazarat ɓinǝ Yesu</para>
  <para style="r">(<ref loc="MRK 6:1-6">Markus 6:1-6</ref>; <ref loc="LUK 4:16-30">Luka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Lang Yesu malǝna naki amǝnia yì akanicau ka, pǝlǝa loapi banì. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Nyare a là male a Nazarat. Tita kànî aɓwana gìr aɓa ndakpapi malea. Ɓwapǝndǝa ndali sǝ à ɗiban ama, &lt;&lt;Ake sǝ mǝnia yì ɓwa ka kum mǝnia yì sǝlǝe andǝ bangŋo mala pakki agir-ndǝlǝki ka? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Mǝnia ka muna mala kapinta na re? Nggè nda Maryamu sǝ amǝ'eambi nda ka Jemis, Yisǝfu, Shiman andǝ Yahuda re? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Sǝ amǝ'nggaule kat ka à pà atà sǝm akani re? Sǝ ake sǝ ɓwe man kum mǝnia yì agir kat ka?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Bumia lúllô arǝì, à ginǝ earnǝi.</para>
  <para style="p" vid="MAT 13:57">Pǝlǝa Yesu nea wia ama, <char style="wj">&lt;&lt;Mǝɓangnǝa a koya ban ngga, là kǝ pe wi gulo, sǝama a là male aɓalǝ aɓwana male ka, à pākiyi wi gulo ɗang.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">13:57 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 4:43">Yoh 4:43</ref>,<ref loc="JHN 4:44">44</ref></char>.</note><verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Pakki agir-ndǝlǝki pas a là male ɗàng ace ɗwanyi earnǝɓwa malea.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Lú mala Yohana Mǝbatisǝma</para>
  <para style="r">(<ref loc="MRK 6:14-29">Markus 6:14-29</ref>; <ref loc="LUK 9:7-9">Luka 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Aɓalǝ anonggio mǝno ka Hirǝdus murǝm mala bu-nzali Galili ok cau amur Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Ne amǝtè ama, &lt;&lt;Mǝnia ka Yohana Mǝbatisǝma na loapi ɓembe ka! Nda gìr mana tsǝa sǝ ndanǝ bangŋo mala pakki agir-ndali ka.&gt;&gt;<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Hirǝdus angŋǝna dǝmba bwalǝna Yohana kùrni sǝ oasǝni a ndàkurban. Kùrri ace Hirǝdiya mala Filip mǝ'eambi yì Hirǝdus.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref>; <ref loc="LEV 18:16">Pǝris 18:16</ref>; <ref loc="LEV 20:21">20:21</ref></char>.</note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Nda ace mana Yohana camarǝ banggi wi ɗiɗyal ama: &lt;&lt;Ɓoaro wu do wunǝ ɓwame ɗang.&gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Eare male yì Hirǝdus ka nǝ̀ wal-lú Yohana, sǝ ɓangciu pakki wi ama aɓwana nǝ̀ loasǝ munǝo, acemǝnana koyan ngga twal Yohana mǝɓangnǝa mala Ɓakuli na.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />A pwari pakkiɗire ɓǝlban mala Hirǝdus ka, nsari mala Hirǝdiya ta'nggwam mǝnana tsǝk Hirǝdus banɓoari wi kǝ̀rkǝ́r, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />gandǝa kánmbi wi gìr ama nǝ̀ pe wi ko mana zǝm ngga. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Yì muna ka nggè soakite ɓǝ̀ na ama, &lt;&lt;Ɓǝa pam ɓamur Yohana Mǝbatisǝma aɓa tasau akani adyan.&gt;&gt;<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Murǝm ngga bumi kìɗìkì, sǝ ace kángìr andǝ abǝri mana atè a ban li ka, gandǝa tsǝa ɓǝà pè muna-ɓwame gìr mǝnana zǝm ngga; <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />pǝlǝa tasǝ aɓwana à kya kasǝ ɓamur Yohana a ndàkurban. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />À yiu nǝ ɓamur Yohana aɓa tasau, sǝ à pè muna-ɓwame; pǝlǝa twali kya pê nggè. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Alaggana mala Yohana yiu à yì twal lui à tsǝkbani, sǝ à kutio à kya banggi Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesu linǝ aɓwana á-tongno</para>
  <para style="r">(<ref loc="MRK 6:32-44">Markus 6:32-44</ref>; <ref loc="LUK 9:10-17">Luka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohana 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Lang Yesu yi ok mǝnia yì cau ka, pǝlǝa eauwe a waru à samsǝa à o a ban mǝnana kǝɓwa pà kàm raka. Aɓwana nǝ̀ yia ok ama Yesu eauna a waru umna ka, à purkio arǝ alá malea à o atè nǝ kusǝia. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesu yi kpashi, nǝ̀ eapi waru ka sǝn ɓwabundǝa kǝ̀rkǝ́r aban rambǝa. Mǝsǝswatǝr malea pakki wi pǝlǝa twalia amǝkwánó mana aɓalǝia ka ban arǝkwana malea.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Pwari nǝ̀ yia kpa ka, alaggana male yiu a baní à yì ne wi ama, &lt;&lt;Ban mǝnia ka ɓabondo na, sǝ pwari kpana, nying ɓwabundǝa ɓǝà o arǝ amuna-là ɓǝà kya kúrì ɓamuria girlina.&gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓǝa ka o anggo ɗang, wu pea wia girlina ɓǝa li.&gt;&gt;</char><verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Sǝ à ne wi ama, &lt;&lt;Kǝ bǝredi tongno nǝ amǝnji ɓari nda mǝnana sǝm ndanǝi a bu sǝm ngga.&gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Sǝ na ama, <char style="wj">&lt;&lt;Wu yinǝàm nǝia akani.&gt;&gt;</char> <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Pǝlǝa tsǝk aɓwana ɓǝa do amur munabondo. Sǝ twal abǝredi mǝnia tongno andǝ anji ɓari ka, loasǝ mǝsǝì a kùli pakki Ɓakuli yàwá, sǝ ɓwanggia, pǝlǝa pe alaggana male, sǝ yia gbal ka à gakkia aɓwana. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Yia kat à li à ɗǝmbǝo. Sǝ alaggana male ramgi aɓwangine mana ue ka, à lùmsǝ azace lum-nong-ɓari. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Lakki mala aɓwana mana à lìli ka, aburana á-tongno na. Amamǝna andǝ amuna ka à ɓallia ɗang.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesu gya amur mùr</para>
  <para style="r">(<ref loc="MRK 6:45-52">Markus 6:45-52</ref>; <ref loc="JHN 6:15-21">Yohana 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Tù anzǝm man ngga Yesu ne alaggana male ɓǝà eauwe a waru ɓǝà aki dǝmba aban o a nkaring, sǝ yì ka, ueo ace nea aɓwana ɓǝà o a la. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Lang Yesu mesǝna ɓwapǝndǝa ka, pǝlǝa eauwe amur nkono nǝmurǝì ace pakhiwi. Ban yi bwalo nda akanó nǝmurǝì. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Anggo ka waru nyingŋǝ̀nà kún gwangyi umna ɗār aɓa mùr, sǝ nggea gung longŋǝna nǝ̀ nggǝ pea wia tanni.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Nǝ tadǝmbari mbul-mbul ka Yesu puro kǝ gya amur mùr aban yiu abania. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Lang alaggana male nǝ̀ sǝni aban gya amur mùr ka, ɓangciu pakkia wia. À mak'zwalo, à na ama, &lt;&lt;Kukwar na!&gt;&gt;<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Anggo ka kara Yesu nea wia cau ama, <char style="wj">&lt;&lt;Wu cam kàngkàng! Mǝ nda. Wu kǝa ɓang ɗàng.&gt;&gt;</char><verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pǝlǝa Bitǝrus ne wi ama, &lt;&lt;Mǝtalabangŋo, ɓǝ̀ a nda ka, banggàm ɓǝn gya amur mùr ɓǝn kyane a bano.&gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesu ne wi ama, <char style="wj">&lt;&lt;Yiu.&gt;&gt;</char></para>
  <para style="p" vid="MAT 14:29">Bitǝrus pǝlǝa sùlǝî ɓá waru sǝ gya amur mùr aban ká a ban Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Lang sǝn eaki-nkono mala mùr ka, ɓangciu pakki wi, kara tita ko a mùr. Mak zwalo ama, &lt;&lt;Mǝtalem, amsǝam!&gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Kara Yesu lǝmdǝ buì bwali sǝ ne wi ama, <char style="wj">&lt;&lt;We ka, gūliarǝu mo arǝàm kyau fat, palang sǝ a tuti a ɓabumo?&gt;&gt;</char><verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Lang à eauna aɓa waru ka kara gung kùro. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Aɓwana mǝnana aɓa waru ka à peri a baní, à na ama, &lt;&lt;Ɓafo, à nda Muna mala Ɓakuli.&gt;&gt;<verse eid="MAT 14:33" /></para>
  <para style="s">Yesu twali aɓwana pas <optbreak /> ban rǝkwana</para>
  <para style="r">(<ref loc="MRK 6:53-56">Markus 6:53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />À samsǝa à yì kpashi a nkaring mala amǝ Jenasaret. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Lang amǝ-le nǝ̀ yia sǝlǝ ama Yesu na ka, à turkiban arǝ aɓwana aɓalǝ amuna-là mana a ban mǝno ka. Aɓwana yiu nǝ amǝkwánó malea kat a baní. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />À zǝmbi wi ace mǝnana ɓǝ̀ amǝ rǝkwana ɓǝà je kun daura male ka. Sǝ aɓwana mana à je kat ka rǝkwana malea malâ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Kànìgìr mala aɓwana-mǝgule</para>
  <para style="r">(<ref loc="MRK 7:1-13">Markus 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Anzǝm mani ka aɓea amǝ Farisi andǝ amǝkani Nggurcau mala Musa pur a Urǝshalima, à yiu a ban Yesu sǝ à ɗì ama, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Mana tsǝa sǝ alaggana mo kǝ yàl nzongcau mala aká sǝm? À kǝ̀ lak buia sǝ à nǝ̀ lili ɗang!&gt;&gt;<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesu pǝlǝia wia ama:</para>
  <para style="pi" vid="MAT 15:3">
    <char style="wj">Sǝ ace man ɗe sǝ wu kǝ yàl nzongcau mala Ɓakuli ace pakki akanìgìr ma'wun?</char> <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><char style="wj">Ɓakuli ka bang ama, &lt;&lt;Pè tárró andǝ nggo gulo, sǝ ɓwa mǝnana sáng tárrí ko nggè ka, dumǝna púp à nǝ̀ wali ɓǝ̀ wú.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12">Pur 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="LEV 20:9">Pǝris 20:9</ref>; <ref loc="DEU 5:16">Nggur 5:16</ref></char>.</note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" /><char style="wj">Sǝ wun ngga wu bang ama ɓǝ̀ ɓwa ne tárrí ko nggè ama, &lt;&lt;Gìr mǝnana ɓǝ a wú nǝ́ kúmó a buam ace po gbasha ka, ǝn pani Ɓakuli ka,&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:5 </char><char style="fq" closed="false">ǝn pani Ɓakuli: </char><char style="ft" closed="false">Aɓa kpata kúncau mala amǝ Yahudi ka, ɓǝ̀ ɓwa bang ama gìr ka pani Ɓakuli ka, mǝno yì gìr ka dumǝna mala Ɓakuli, ɓwe pà nǝ̀ nyare nǝ̀ pàngŋǝ̀nà túró nǝi ace ɓamúrì, ko nǝ̀ pe nggè ko tárrí ka ɗang.</char></note> <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" /><char style="wj">ɓwe nǝ̀ gandǝ ginǝ pe tárrí ko nggè gulo nǝi. Anggo ka wu nyesǝna cau mala Ɓakuli ɓà ace pàkkiagir ma'wun.</char> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" /><char style="wj">Wun amǝ'kúnɓárína! Ɓangna mala Ishaya amur wun ngga nda a njarì, mǝnana bang ama:</char><verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />
    <char style="wj">&lt;&lt;Aɓwana mǝnia ka</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">à kǝ pam gulo </char></para>
  <para style="q1" vid="MAT 15:8">
    <char style="wj">nǝ mburkunia,</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">sǝ ɓabumia ka</char></para>
  <para style="q2" vid="MAT 15:8">
    <char style="wj">nda kuko nǝ mim.</char><verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />
    <char style="wj">Peri malea abanam ngga</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">mǝɓane na;</char></para>
  <para style="q1" vid="MAT 15:9">
    <char style="wj">akanìgìr malea ka</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">anzongcau mala</char></para>
  <para style="q1" vid="MAT 15:9">
    <char style="wj">ɓwapǝndǝa na</char></para>
  <para style="q2" vid="MAT 15:9">
    <char style="wj">à kaniki ka.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:9 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 29:13">Isha 29:13</ref>
      </char>.</note><verse eid="MAT 15:9" /></para>
  <para style="s">Agir mana à kǝ tsǝk ɓwa <optbreak /> sǝ kǝ pǝndǝki ka</para>
  <para style="r">(<ref loc="MRK 7:14-23">Markus 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Yesu tunǝ ɓwabundǝa sǝ banggia wia ama, <char style="wj">&lt;&lt;Wu kwaki kir wun ɓǝ̀ cau kpaka wun.</char> <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" /><char style="wj">Gìr mana kǝ kutio a kun ɓwa ka nda kǝ pǝndǝkì ka ɗang, cau mana purkiyi a kúni ka, nda mana kǝ tsǝi sǝ kǝ pǝndǝki ka.&gt;&gt;</char><verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Alaggana male pǝlǝa à yiu a baní sǝ à ɗì ama, &lt;&lt;A sǝlǝ ama bum amǝ Farisi lúllô arǝ cau mana a ne ka?&gt;&gt;<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Sǝ Yesu pǝlǝia wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ ya girpwala nani à pandǝi mǝnana Tárrám mana a kùli ka nǝ̀ pandǝi raka, à nǝ̀ ui.</char> <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><char style="wj">Wu ɗekia; yia ka à nda ka ante mana à kǝ bwalì ante gara ka. Ɓǝ̀ nte bwalì nte gara ka, yia kǝm ngga à nǝ̀ kpa tūli.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 6:39">Luk 6:39</ref></char>.</note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Bitǝrus ne wi ama, &lt;&lt;Bǝla sǝm ɓá kanicau mana ama girlina na kǝ tsǝk ɓwa sǝ kǝ pǝndǝki raka.&gt;&gt;<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yesu nea wia ama:</para>
  <para style="pi" vid="MAT 15:16">
    <char style="wj">Wun gbal ka cau kǝ kpaka wun re?</char> <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" /><char style="wj">Wu sǝlǝ mbo ama gìr mana kat kutio a kun ɓwa ka kǝ o a bumi, sǝ nǝ̀ nggá pur a nza?</char> <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><char style="wj">Sǝ agir mǝnana à kǝ pur a kun ɓwa ka à kǝ̀ yiu nǝ ɓabumi, sǝ à nda ka mǝnana à nǝ̀ tsǝk ɓwa nǝ̀ do nǝ pǝndǝkya ka.</char> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" /><char style="wj">Àkǝ̀ ɓabum ɓwa sǝ aɗenyicau mǝɓane kǝ puro; wal-lú, nongnǝban a nza nǝ doɓala, gyagung, ǝn'í, kùmsǝkûn, sǝ zalǝban.</char> <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" /><char style="wj">Amǝnia ka à nda ka gir mǝnana à nǝ̀ tsǝk ɓwa nǝ̀ pǝndǝki ka. Lìli nǝ abu mǝnana à lea raka pà nǝ̀ tsǝk ɓwa nǝ̀ pǝndǝki ɗang.</char><verse eid="MAT 15:20" /></para>
  <para style="s">Paɓamuru mala ɓwama Kan'ana</para>
  <para style="r">(<ref loc="MRK 7:24-30">Markus 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesu nying ban mǝno sǝ o a nzali mala amǝ Taya andǝ amǝ Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Ɓè ɓwama Kan'ana<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="fq" closed="false">ɓwama Kan'ana: </char><char style="ft" closed="false">Amǝ Kan'ana ka amǝ Isǝrayila na ɗang.</char></note> mǝnana do a mǝno yì bu ban ngga, yiu a baní nǝ ɓua ama, &lt;&lt;Mǝtalabangŋo, Muna mala Dauda<note caller="+" style="f"><char style="fr" closed="false">15:22 </char><char style="fq" closed="false">Muna mala Dauda: </char><char style="ft" closed="false">&lt;&lt;Ko Mǝkà Dauda.&gt;&gt;</char></note>, sǝn mǝsǝswatǝr mem! Ɓoarnsarilem ngga nda aɓa tanni kǝ̀rkǝ́r a ɓabù kukwar mǝnana kutia rǝì ka.&gt;&gt; <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Yesu pǝlǝi wi kǝ cau ɗang. Alaggana male yiu a baní sǝ à zǝmbi wi ama, &lt;&lt;Sǝnbi ɓwama mǝnia ka ɓacau male ɓǝ̀ o. Ace mǝnana camarǝ gya atà sǝm nǝ ɓua.&gt;&gt;<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesu pǝlǝia wia ama, <char style="wj">&lt;&lt;Kǝ anzur mala amǝ Isǝrayila mana à ɓwarki ka nda à túrǎm abania ka.&gt;&gt;</char><verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ɓwame yiu yi kū`ndǝó a ɓadǝmbi, sǝ na ama, &lt;&lt;Mǝtalabangŋo, bwalàm kàm!&gt;&gt;<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Yesu pǝlǝi wi ama, <char style="wj">&lt;&lt;Ɓoaro ɓǝà twal girlina mala amuna ɓǝà pè anvwa ɗàng.&gt;&gt;</char><verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ɓwame eare ama, &lt;&lt;E, Mǝtalabangŋo, nggearǝ anvwa ka à kǝ tarki aɓwangina girlina mǝnana à kǝ kpaki a nzali a ban-li mala amǝtalea ka.&gt;&gt;<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Yesu pǝlǝa ne wi ama, <char style="wj">&lt;&lt;Ɓwama, paɓamuru mô ka nggea mǝgule na! Zǝmba mô ka à ongŋǝni.&gt;&gt;</char> Kara àkǝ̀ banì rǝ muni malâ.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesu linǝ́ aɓwana á-ine</para>
  <para style="r">(<ref loc="MRK 8:1-10">Markus 8:1-10</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu nying ban mǝno sǝ gya a kun Garang mala amǝ Galili. Kya eauwe a bum ɓe nkono do akàm. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ɓwabunda pas yiu a baní. À yiu nǝ aɓwana mana à su ka, ante, a gbakǝre, amǝ'talasǝuɓunna andǝ acilia pas, à yì nongsǝia a ɓadǝmbi; sǝ twalia wia ban akwánó malea. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Ɓwapǝndǝa ndali lang à sǝn amǝ'talasǝuɓunna aban nacau, aɓwan à su ka à lo tak, agbakǝre lo à kǝ gya, sǝ ante kǝ sǝnban. Pǝlǝa à ɓwangsǝki Ɓakuli mala amǝ Isǝrayila.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu tunǝ alaggana male a baní sǝ nea wia ama, <char style="wj">&lt;&lt;Ən nggǝ sǝn mǝsǝswatǝr mala aɓwana mǝnia ka, acemǝnana à ndakani atàm nongŋo tàrú a dyan, andǝa nzala. Ɓǝa kǝa o anggo ɗang, ace mǝsǝpǝndǝa makkia a njar.&gt;&gt;</char><verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Pǝlǝa alaggana male ne wi ama, &lt;&lt;Ake sǝ sǝm nǝ̀ kum girlina a bondo mǝnia ka, mǝnana sǝm nǝ̀ linǝ aɓwana mǝnia pas ka?&gt;&gt;<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesu ɗia ama, <char style="wj">&lt;&lt;Agbatali bǝredi shen a bu wun ɗe?&gt;&gt;</char></para>
  <para style="p" vid="MAT 15:34">À ear ama, &lt;&lt;À nda tongno-nong-ɓari andǝ amǝnji bǝti.&gt;&gt;<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Pǝlǝa Yesu ne ɓwabundǝa ɓǝa do a nzali. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Sǝ twal abǝredi tongno nong-ɓari andǝ anji, lang pangŋǝni Ɓakuli yàwá ka, pǝlǝa ɓwanggia sǝ pe alaggana male. Sǝ yia gbal ka, à gaki aɓwana. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Ɓwabunda man kat ka lìli ɗǝmbǝo, nying cili. Alaggana male ramgi cili mana ueo ka, à pwano arǝ azace tongno-nong-ɓari.<verse eid="MAT 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 15:38" />Lakki mala aɓwana mana à lìli ka, aburana á-ine na. Amamǝna andǝ muna mana ateà ka à ɓallia ɗang.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Yesu pǝlǝa ne aɓwabundǝa ɓǝà o a la, sǝ kutio a waru o a bu-nzali Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Aɓwana alta gir'lǝmdǝa <optbreak /> a ban Yesu</para>
  <para style="r">(<ref loc="MRK 8:11-13">Markus 8:11-13</ref>; <ref loc="LUK 12:54-56">Luka 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Amǝ Farisi andǝ amǝ Saduki yiu a ban Yesu à nǝ̀ kārǝki. À zǝmbi wi ama ɓǝ̀ lǝmdǝia wia ɓekǝ gir'ndali mana nǝ̀ lǝmdǝ ama yì ka, pur nǝban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char>.</note><verse eid="MAT 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2" />Yesu pǝlǝia wia ama:</para>
  <para style="pi" vid="MAT 16:2">
    <char style="wj">Nǝ pwarikpǝra ka ɓǝ̀ wu sǝn kùli bang ngga wu kǝ na ama, &lt;&lt;Ban no nǝ̀ ɓoaro.&gt;&gt;</char> <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" /><char style="wj">Sǝ nǝ budǝmbari ɓǝ̀ wu sǝn kùli bangŋa sǝ ban pǝndǝ ka, wu na ama, &lt;&lt;Mbulo no nǝ̀ nya yalung.&gt;&gt; Wu kǝ gandǝ bang ɓá pa mala bumkuli, sǝ agir mana à kǝ lǝmdǝ pa mala nza man ngga wu bwaltea ɗàng.</char> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><char style="wj">Nza mala amǝ'ɓealɓikea andǝ amǝ'ɗwanyi ɓanggi Ɓakuli na à alkiyita gìr mana à nǝ̀ sǝn ngga. Sǝ à pà nǝ̀ lǝmdǝia ɓekǝ gir'lǝmdǝa ɗang, shekǝ mala Yunana.</char><note caller="+" style="f"><char style="fr" closed="false">16:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref></char>.</note></para>
  <para style="p" vid="MAT 16:4">Yesu pǝlǝa nyia o.<verse eid="MAT 16:4" /></para>
  <para style="s">Yist mala amǝ Farisi <optbreak /> andǝ amǝ Saduki</para>
  <para style="r">(<ref loc="MRK 8:14-21">Markus 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Lang alaggana mala Yesu eauwe a ɓè nkaring nggeamùr ka, à sǝni ka ɓālǝia lorǝo à twal bǝredi a buia ɗàng. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu nea wia ama, <char style="wj">&lt;&lt;Wu par kir wun, wu yál ɓamur rǝ wun arǝ yist mala amǝ Farisi andǝ amǝ Saduki.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 12:1">Luk 12:1</ref></char>.</note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Pǝlǝa alaggana male kùtí a nacau arǝarǝia ama, &lt;&lt;Bang anggo acemǝnana sǝm yiu nǝ bǝredi raka.&gt;&gt;<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yesu yi sǝlǝia wia nǝ cau mǝno à nakiyi ka sǝ ɗia ama, <char style="wj">&lt;&lt;Palang sǝ wu kǝ nacau arǝarǝ wun amur ɗwanyi bǝredi? Gūliarǝu ma'wun kyau fat!</char> <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><char style="wj">Wun ado ka wu kǝ gandǝ bwalta cau mbo? Ɓalǝ wun lorǝna ce abǝredi tongno mǝnana ǝn linǝ aɓwana á-tongno nǝi ka? Azace shen sǝ wu lùmsǝia nǝ aɓwangine?</char><note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 14:17-21">Mat 14:17-21</ref></char>.</note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="wj">Sǝ lang arǝ abǝredi tongno-nong-ɓari mǝnana ǝn linǝ aɓwana á-ine nǝi ka? Azace shen sǝ wu lùmsǝia nǝ aɓwangine mǝnana a ueo ka?</char><note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 15:34-38">Mat 15:34-38</ref></char>.</note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" /><char style="wj">Palang sǝ wu gandǝ sǝlǝ ama ǝn pa arǝ nacau amur bǝredi raka? Mǝ nda arǝ na ama wu par kir wun ce wu earnǝ yist mala amǝ Farisi andǝ amǝ Saduki ɗang.&gt;&gt;</char><verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Nda sǝ cê kpania wia ama pa arǝ nunkiria amur yist mana à tsǝkiyi arǝ bǝredi ka ɗàng. Nda arǝ nacau amur kanigir nyir mala amǝ Farisi andǝ amǝ Saduki.<verse eid="MAT 16:12" /></para>
  <para style="s">Bitǝrus bang ama <optbreak /> Yesu nda Kǝrǝsti</para>
  <para style="r">(<ref loc="MRK 8:27-30">Markus 8:27-30</ref>; <ref loc="LUK 9:18-21">Luka 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Lang Yesu yina a nzali Kaisariya Filipi ka, ɗì alaggana male ama, <char style="wj">&lt;&lt;Yana ɗe aɓwana kǝ na ama nda mim Muna mala Ɓwa?&gt;&gt;</char><verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Sǝ à pa eare ama, &lt;&lt;Aɓea aɓwana kǝ na ama a nda Yohana Mǝbatisǝma; aɓea ka à kǝ na ama, Iliya; sǝ aɓea gbal ka ama Irimiya ko mwashat aɓalǝ amǝ'ɓangnǝa mala Ɓakuli.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 14:1">Mat 14:1</ref>,<ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14">Mar 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>.</note><verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Pǝlǝa Yesu ɗia ma, <char style="wj">&lt;&lt;Sǝ wun ngga, wu kǝ na ama mǝ nda yan?&gt;&gt;</char><verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Shiman Bitǝrus pa eare ama, &lt;&lt;A nda Kǝrǝsti, Muna mala Ɓakuli mǝyilǝmuì.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 6:68">Yoh 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>.</note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesu ne wi ama:</para>
  <para style="pi" vid="MAT 16:17">
    <char style="wj">Tsǝkbu na muro, we Shiman muna mala Yunana, acemǝnana súrǝè mala ɓwapǝndǝa na lǝmdǝo mǝnia yì gìr ka ɗàng. Tárrám mǝnana a kùli ka nda.</char> <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><char style="wj">Sǝ we Bitǝrus ka a nda tali, sǝ amur tali mǝnia ka mǝ nǝ ɓak Ikǝlisiya mem, sǝ rǝcandǝa mala Lú pa nǝ̀ gandǝi ɗàng.</char> <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><char style="wj">Mǝ nǝ po akyî mala Domurǝm mǝnana a kùli ka; gìr mǝnana kat à kùrrì a ɓanza ka, anggo sǝ à nǝ̀ kùrrì a kùli, sǝ gìr mǝnana kat a panzǝi a ɓanza ka, anggo sǝ à nǝ̀ panzǝi a kùli.</char><note caller="+" style="f"><char style="fr" closed="false">16:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 18:18">Mat 18:18</ref>; <ref loc="JHN 20:23">Yoh 20:23</ref></char>.</note><verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Pǝlǝa nunkir alaggana male ama ɓǝa kǝa ne kǝɓwa ama yì nda Kǝrǝsti ɗàng.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesu bang cau amur lú male</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Markus 8:31--9:1</ref>; <ref loc="LUK 9:22-27">Luka 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Twal a pwari mǝno ka Yesu tita mǝngì alaggana male ɓá cau ama, <char style="wj">&lt;&lt;Dumǝna púp mǝ nǝ ká a Urǝshalima, mǝ nǝ ká nu tanni kǝ̀rkǝ́r a bu aɓwana-mǝgule, agbani pǝris andǝ amǝkani nggurcau. À nǝ̀ wal-luem, sǝama a tàruià nongŋo ka mǝ nǝ loapi ɓembe nǝ yilǝmu.&gt;&gt;</char><verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Bitǝrus pǝlǝa tunǝi zak sǝ pǝrki nǝ ce a kúni ama, &lt;&lt;Pà nǝ̀ pàk ɗàng, Mǝtalabangŋo. Kǝgìr pà nǝ̀ kúmǒ anggo ɗàng!&gt;&gt;<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Yesu pǝlǝa arǝ Bitǝrus sǝ ne wi ama, <char style="wj">&lt;&lt;Nyàrâm anggo, Shetan! A kǝ earce tsǝem mǝ annda, acemǝnana ɗenyicau mo ka mala Ɓakuli na ɗang, mala ɓwapǝndǝa na.&gt;&gt;</char><verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Pǝlǝa Yesu banggi alaggana male ama:</para>
  <para style="pi" vid="MAT 16:24">
    <char style="wj">Ɓwa mǝnana kat earce ama nǝ̀ yiu atàm nǝ̀ duk mǝkpatam ngga, dumǝna púp nǝ̀ nying ɗenyicau ɓamúrì, nǝ̀ twal nggun-gangndǝi male sǝ nǝ̀ kpatam.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">16:24 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref></char>.</note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><char style="wj">Ɓwa mana kat kǝ sǝni nǝ̀ amsǝ yilǝmi ka nǝ̀ nggá ɗwanyibanì, sǝ ɓwa mǝnana kǝ turta yilǝmi acem ngga, nǝ̀ nggá kumi.</char><note caller="+" style="f"><char style="fr" closed="false">16:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Yoh 12:25</ref></char>.</note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><char style="wj">Ɓǝ̀ ɓwa kum koya gìr a ɓanza man kat, sǝ ɗwanyi yilǝmu mǝnana málá male pà kàm raka, lǝmdǝ ama pà nǝ́ kǝgìr ɗàng. Sǝ ɓǝ̀ ɗwanyini yilǝmu mǝnana málá male pà kàm raka, pà nǝ́ kǝgìr mǝnana nǝ̀ pa sǝ nǝ̀ kumi ɗǝm ngga ɗàng.</char> <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><char style="wj">Acemǝnana Muna mala Ɓwa ka nǝ̀ nggá yiu aɓa gulo mala Tárrí, andǝ amǝturonjar male atè, sǝ nǝ̀ yia pè koyan ngga tangnakusǝi, ace gìr mǝnana pàk ka.</char><note caller="+" style="f"><char style="fr" closed="false">16:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 25:31">Mat 25:31</ref>; <ref loc="PSA 62:12">Ang 62:12</ref>; <ref loc="ROM 2:6">Rom 2:6</ref></char>.</note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" /><char style="wj">Ən nggǝ na wun aɓa mǝsǝcau ama, aɓea ɓwana na kani aban came mǝnana à pà nǝ̀ wù ɗàng sheɓǝ̀ à sǝna yiu mala Muna mala Ɓwa a Domurǝm male ka.</char><verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yesu lǝmdǝ ɓoarɓwa male</para>
  <para style="r">(<ref loc="MRK 9:2-13">Markus 9:2-13</ref>; <ref loc="LUK 9:28-36">Luka 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Anzǝm nongŋo tongno-nong-mwashat ka Yesu twal Bitǝrus, Jemis andǝ Yohana mǝ'eam Jemis, sǝ à o amur ɓè nkono mǝ'dāhre. À nda kano nǝmurǝia ka, <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />kara rǝ Yesu twalo nggaɗi a ɓamǝsǝia. Ɓamǝsǝi ta kǝla pwari, agir-nggūrǝì pǝlǝ amǝpwasǝe pwapwat.<verse eid="MAT 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 17:3" />Kara Musa andǝ Iliya puro à came, à kǝ nacau nǝ Yesu.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Pǝlǝa Bitǝrus ne Yesu ama, &lt;&lt;Mǝtalabangŋo, ndanǝ ɓoaro mǝnana sǝm nda kani ka. Ɓǝ̀ a nǝ ear ka, mǝ nǝ gilǝ agumli tàrú; mwashat aceo, mwashat ace Musa sǝ mwashat ace Iliya.&gt;&gt;<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Ndarǝ nacau più ka, kara pǝrɓang mǝpwasǝe pwapwat yi gir múrià, sǝ giu pur aɓa pǝrɓang na ama, &lt;&lt;Mǝnia ka nda Munem mǝnana ǝn earkiyi ace raka; mǝnana ban kǝ ɓoaram arǝì pepè ka. Wu ok cau male!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2PE 1:17">2Bit 1:17</ref>,<ref loc="2PE 1:18">18</ref>; <ref loc="GEN 22:2">Tite 22:2</ref>; <ref loc="ISA 42:1">Isha 42:1</ref>; <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref>; <ref loc="DEU 18:15">Nggur 18:15</ref></char>.</note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Lang alaggana male ok mǝnia yì giu ka, ǝn'ò pakkia wia kǝ̀rkǝ́r, pǝlǝa à kpa à kùmsǝ ɓamǝsǝia a nzali. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Sǝ Yesu yiu yi tsǝk buì a rǝia, sǝ nea wia ama, <char style="wj">&lt;&lt;Wu lo, ɓangciu ɓǝ̀ kǝa pakka wun ɗàng.&gt;&gt;</char> <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />À nǝ̀ loasǝ mǝsǝia ka, Yesu na kara à sǝni nǝmurǝì ka.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Lang à ndaban sùlǝî mur nkono ka, Yesu kwarkiria ama, <char style="wj">&lt;&lt;Wu kǝa ne kǝɓwa ce gìr mǝnana wu sǝn ngga ɗàng she ɓǝà loasǝna Muna mala Ɓwa a ɓembe ka.&gt;&gt;</char><verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Alaggana male pǝlǝa à ɗì ama, &lt;&lt;Sǝ ɓǝ̀ nda anggo ka, palang sǝ amǝkani nggurcau kǝ na ama she ɓǝ̀ Iliya angŋǝna dǝmba yina ka sǝ Kǝrǝsti nǝ̀ yiu?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 4:5">Mal 4:5</ref></char>.</note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Pǝlǝa Yesu eare ama, <char style="wj">&lt;&lt;Mǝsǝcau na à bang ngga, Iliya nǝ̀ ak tadǝmba nǝ̀ yiu, nǝ̀ yia gilǝki agir kat.</char> <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><char style="wj">Sǝ ǝn nggǝ na wun ama Iliya ka yina, sǝ à sǝlǝ ama yì na ɗang, sǝ à pàngŋǝ̀nì wi gìr mǝnana bumia earkiyice ka. Anggo gbal sǝ Muna mala Ɓwa nǝ̀ nu tanni a buia.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">17:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 11:14">Mat 11:14</ref></char>.</note> <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Nda sǝ alaggana male yi sǝlǝ ama ndarǝ bang cau amur Yohana Mǝbatisǝma ka.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesu pusǝ kukwar arǝ ɓè muna</para>
  <para style="r">(<ref loc="MRK 9:14-29">Markus 9:14-29</ref>; <ref loc="LUK 9:37-43a">Luka 9:37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Lang à sùlǝ́nì múr nkono à yina a ban ɓwabundǝa a nzali ka, ɓeɓwa yi kū`ndǝó a ɓadǝm Yesu <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />sǝ na ama, &lt;&lt;Mǝtalabangŋo, ǝn nggǝ zǝmbô, sǝn mǝsǝswatǝr mala laggalem. Ndanǝ kwánó wukiaban mǝnana kǝ pe wi tanni kǝ̀rkǝ́r ka. Kusǝ pas ɓǝ̀ loapi wi ka, kǝ kpa aɓa bǝsa ko mùr. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ən yinǝi aban alaggana mô, sǝ à gandǝ twalban kwanè ɗàng.&gt;&gt;<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesu pǝlǝa na ama, <char style="wj">&lt;&lt;Wun aɓwana mala nza mala kìɗìkì andǝ amǝ'ɗwanyi paɓamuru aban Ɓakuli! Nǝ̀ ngga ká a ya pwari sǝ mǝ nǝ do atà wun sǝ wun nǝ̀ kànì pàk ɓè kǝgìr? Nǝ̀ ngga ká a ya pwari sǝ mǝ nggǝ twal gandǝrǝu nǝ ɗwanyi earnǝ cau ma'wun arǝàm? Wu yinǝ munê abanam.&gt;&gt;</char> <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu pǝlǝa sà arǝ kukwar mǝnana arǝ muna ka. Pǝlǝa kukwar purî rǝì. Àkǝ̀ banì rǝ munê mala.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Nǝnzǝ́mò ka alaggana mala Yesu yiu a baní nǝmurǝì sǝ à ɗì ama, &lt;&lt;Mana tsǝa sǝ sǝm gandǝ pusǝ kukwarnì ɗang?&gt;&gt;<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesu nea wia ama:</para>
  <para style="pi" vid="MAT 17:20">
    <char style="wj">Nda acemǝnana paɓamuru ma'wun ngga gatti. Sǝama ǝn nggǝ na wun mǝsǝcau, ɓǝà bang ama wu earnǝ Ɓakuli bǝti kǝla kyauwe mala mǝsǝ musta ka, wun nǝ̀ gandǝ ne mǝnia yì nkono ka ama, &lt;&lt;Turî ban mǝnia, o kano&gt;&gt; sǝ yì ka, nǝ̀ turó. Ɓè kǝgìr pà kàm nǝ̀ gandǝ wun ɗàng.</char> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" /><char style="wj">[Sǝama ulang mǝnia yì kukwar ka, kǝ ear puro ɗang she nǝ hiwi andǝ gilmùr.]</char><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 21:21">Mat 21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref>; <ref loc="1CO 13:2">1Kor 13:2</ref></char>.</note><verse eid="MAT 17:21" /></para>
  <para style="s">Yesu nacau ɗǝm amur Lú male</para>
  <para style="r">(<ref loc="MRK 9:30-32">Markus 9:30-32</ref>; <ref loc="LUK 9:43b-45">Luka 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Lang alaggana male yi ramǝna kat a Galili ka, Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓè ɓwa ndo nǝ̀ nggá mak Muna mala Ɓwa a ban aɓwana,</char> <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" /><char style="wj">sǝ à nǝ̀ nggá wal-luí. A tàruià nongŋo ka nǝ̀ lo nǝyilǝmu.&gt;&gt;</char> Kara ban ɓiki alaggana male kǝ̀rkǝ́r.<verse eid="MAT 17:23" /></para>
  <para style="s">Yesu mbwe boalo cemi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Lang Yesu andǝ alaggana male bwalǝna Kapanahum ngga, amǝ'cemi ɓá Ndàmǝgule mala Ɓakuli yiu aban Bitǝrus sǝ à ɗì ama, &lt;&lt;Mǝtala-ɓala ma'wun ngga kǝ mbwe boalo cemi mala Ndàmǝgule re?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:13-15">Pur 30:13-15</ref>; <ref loc="EXO 38:26">38:26</ref></char>.</note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Bitǝrus earia wia ama, &lt;&lt;E, kǝ mbwe.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Pǝlǝa kutio a ɓala nǝ̀ nggá ne Yesu cè. Malaká loasǝ kúni ɗàng Yesu ak dǝmba ɗì ama, <char style="wj">&lt;&lt;Sǝ we Shiman ngga, lang sǝ a sǝni? A bu a yana sǝ amurǝm ɓanza akiyi boalo-cemi? A bu amǝtala là lè, ko a bu abǝri?&gt;&gt;</char><verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Bitǝrus eari wi ama, &lt;&lt;A bu abǝri.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Pǝlǝa Yesu ne wi ama, <char style="wj">&lt;&lt;Lǝmdǝ ama amǝtala là ka, à pa aɓa mbwe ɗàng.</char> <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" /><char style="wj">Sǝ ace mǝnana ɓǝ̀ sǝm ngga lulbumia raka, kyane a kun nggeamùr kya túr nli. Nji mǝnana awu nǝ tita bwale ka, mǝn kúni, a nǝ kum boalo kam. Twali kya mbwena boalo-cemi ma'sǝm nǝi, mem andǝ mô.&gt;&gt;</char><verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Yana nda ɓwamǝgule kat?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Markus 9:33-37</ref>; <ref loc="LUK 9:46-48">Luka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />A nzǝm mǝno bǝti ka alaggana mala Yesu yiu a baní sǝ à ɗì ama, &lt;&lt;Yana gulo kútìban kat a Domurǝm mala kùli?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 22:24">Luk 22:24</ref></char>.</note><verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Yesu pǝlǝa tunǝ ɓè muna mǝkyauwe sǝ tamsǝi aɓalǝia. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Sǝ na ama:</para>
  <para style="pi" vid="MAT 18:3">
    <char style="wj">Mǝsǝcau, ǝn nggǝ bangga wun, ɓǝ̀ wu nggaɗya wu do kǝla amuna mǝkèke raka, pà wu nǝ̀ kutio a Domurǝm mala kùli ɗang.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:3 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MRK 10:15">Mar 10:15</ref>; <ref loc="LUK 18:17">Luk 18:17</ref></char>.</note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" /><char style="wj">Sǝ ɓwa mǝnana kat nwangsǝ ɓamúrì kǝla muna mǝkyauwe man ngga nda ɓwamǝgule kat a Domurǝm mala kùli.</char><verse eid="MAT 18:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="MAT 18:5" />
    <char style="wj">Koya ɓwa sǝ ak muna mǝkyauwe kǝla mǝnia acem ngga, Mǝ nda akiyiam ngga.</char><verse eid="MAT 18:5" /></para>
  <para style="s">Tamban arǝ cauɓikea</para>
  <para style="r">(<ref loc="MRK 9:42-48">Markus 9:42-48</ref>; <ref loc="LUK 7:1-2">Luka 7:1-2</ref>)</para>
  <para style="pi">
    <verse number="6" style="v" sid="MAT 18:6" />
    <char style="wj">Ɓǝ̀ kǝɓwa tsǝk mwashat atà amuna mǝkèke mǝnia mǝnana à earnǝ mim sǝ pak cauɓikea ka, kǝpǝna ɓǝà ɗurri ɓwe taligo a meali sǝ ɓǝa túrí aɓa nggeamùr mǝlime.</char><verse eid="MAT 18:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 18:7" />
    <char style="wj">Caukwanban na nǝ ɓanza ace agir mǝnana à kǝ tsǝk aɓwana ɓǝà pak cauɓikea ka! Agir tamban ngga à nǝ̀ yiu púp. Sǝama caukwanban na nǝ ɓwa mǝnana à kǝ pur nǝbani ka!</char><verse eid="MAT 18:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="MAT 18:8" />
    <char style="wj">Ɓǝ̀ buo ko kusǝo kǝ tsǝo a kǝ pak cauɓikea ka, kasǝi túrí. Kǝpǝna wu kutio a yilǝmu nǝ bu-kasǝa ko kusǝu-kasǝa amur mǝnana wu dum nǝ abuo ɓari ko akusǝo ɓari sǝ ɓǝà túrǒ aɓa bǝsa mǝnana pà nǝ̀ limgi raka.</char> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><char style="wj">Ɓǝ̀ mǝsǝo kǝ tsǝo a kǝ pak cauɓikea ka, ui túrí. Kǝpǝna wu kutio a yilǝmu nǝ mǝsǝu mwashat amur mǝnana wu dum nǝ amǝsǝo ɓari sǝ ɓǝà túrǒ a lú-bǝsa ka.</char><note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:29">Mat 5:29</ref>,<ref loc="MAT 5:30">30</ref></char>.</note><verse eid="MAT 18:9" /></para>
  <para style="s">Kanicau arǝ nzur mǝnana ɓwàr ka</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luka 15:3-7</ref>)</para>
  <para style="pi">
    <verse number="10" style="v" sid="MAT 18:10" />
    <char style="wj">Wu tsǝkir wun, wu kǝa būrǝce mwashat atà amuna mǝkèke mǝnia ka ɗàng. Ən nggǝ na wun mǝsǝcau amǝturonjar malea a koya pwari ka, à nda aɓadǝm Tárrám mǝnana a kùli ka.</char> <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" /><char style="wj">[Muna mala Ɓwa yiu ace amsǝ aɓwana mǝnana à ɓwarki tanjar ka.]</char><note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 19:10">Luk 19:10</ref></char>.</note><verse eid="MAT 18:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="MAT 18:12" />
    <char style="wj">Lang sǝ wu sǝni, ɓǝ̀ ɓwa nanǝ anzur gbǝman sǝ mwashat ɓwarki ta ɓi ka, pà nǝ̀ nying amǝnia lumi-tongno-nong-ine bwamdǝ tongno-nong-ine ka amur nkono sǝ nǝ̀ oa alta mǝnana ɓwàr ka re?</char> <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" /><char style="wj">Sǝ ɓǝ̀ yi kumǝni ka, ǝn nggǝ na wun mǝsǝcau ban nǝ ɓoari wi ace nzur mǝnia mwashat ka nǝ̀ kútì mǝnana ndanǝi ace acili amǝno à ɓwarki raka.</char> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" /><char style="wj">Anggo gbal sǝ Tár wun mǝnana a kùli ka eare ama ɓǝ̀ mwashat atà amǝkèke mǝnia ka ɓǝ̀ ɓwàr raka.</char><verse eid="MAT 18:14" /></para>
  <para style="s">Mǝ'eambǝu mǝnana pakko cauɓikea</para>
  <para style="r">(<ref loc="LUK 17:3">Luka 17:3</ref>)</para>
  <para style="pi">
    <verse number="15" style="v" sid="MAT 18:15" />
    <char style="wj">Ɓǝ̀ mǝ'eambo pakko cauɓikea ka, kya bani nǝmurǝo lǝmdǝì wi cauɓikea male, a nre wun ɓari. Ɓǝ̀ oako ka, a nyesǝna mǝ'eambo a tanjar.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:15 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 17:3">Luk 17:3</ref>
      </char>.</note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><char style="wj">Sǝ ɓǝ̀ pà nǝ̀ oako raka, tunǝ atò ɓwa mwashat ko ɓari a baní. Acemǝnana mǝsǝcau ka à kǝ oe a kun aɓwana ɓari ko tàrú.</char> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" /><char style="wj">Ɓǝ̀ ginǝ ok ka, kyan nǝi a ban Ikǝlisiya. Sǝ ɓǝ̀ ginǝ okî Ikǝlisiya ka, nyesǝi kǝla mǝ ɗwanyi súrǝ̀ Ɓakuli ko mǝ'cauɓikea.</char><verse eid="MAT 18:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="MAT 18:18" />
    <char style="wj">Ən nggǝ na wun mǝsǝcau gìr mǝnana kat wu kùrrì a ɓanza ka, à nǝ̀ kùrrì a kùli, sǝ gìr mǝnana kat wu panzǝi a ɓanza ka, à nǝ̀ panzǝi a kùli.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:18 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 16:19">Mat 16:19</ref>; <ref loc="JHN 20:23">Yoh 20:23</ref></char>.</note><verse eid="MAT 18:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="MAT 18:19" />
    <char style="wj">Sǝ ǝn nggǝ na wun mǝsǝcau ama, ɓǝ̀ aɓwana ɓari atà wun akani a ɓanza à nǝ̀ eare amur koya gìr mǝnana wu nǝ̀ zǝm ngga, Tárrám mǝnana a kùli ka nǝ̀ pakka wuni.</char> <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><char style="wj">Ɓǝ̀ aya ban sǝ aɓwana ɓari ko tàrú dapi aɓa lullǝam ngga, Mǝ nda aɓalǝia.</char><verse eid="MAT 18:20" /></para>
  <para style="s">Kànìgìr arǝ guro mǝginǝ twalbani</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Pǝlǝa Bitǝrus yiu a ban Yesu sǝ ɗì ama, &lt;&lt;Mǝtalabangŋo, kusǝ shen sǝ ɓǝ̀ mǝ'eambam camarǝ pakkam cauɓikea ka ɓǝ̀ ǝn twali wi banì? Kusǝ tongno-nong-ɓari na le?&gt;&gt;<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesu eari wi ama:</para>
  <para style="pi" vid="MAT 18:22">
    <char style="wj">Awo, kusǝ tongno-nong-ɓari na ɗang, lumi tongno-nong-ɓari kusǝ tongno-nong-ɓari na!</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">18:22 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 17:3">Luk 17:3</ref>,<ref loc="LUK 17:4">4</ref>; <ref loc="GEN 4:24">Tite 4:24</ref></char>.</note><verse eid="MAT 18:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 18:23" />
    <char style="wj">Ace cau mǝnia ka à nǝ̀ kànì Domurǝm mala kùli arǝ ɓè murǝm mǝnana earce nǝ̀ bǝlki kusǝ agǝna male mǝnana a bu amǝ'túró-ɓala male ka.</char> <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" /><char style="wj">Lang tinata bǝlki kusǝ agǝne ka à kya yiu nǝ ɓè ɓwabura a ɓadǝmbi, mǝnana li tangna boalo kǝ̀rkǝ́r.</char> <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" /><char style="wj">Sǝ ace mǝnana ɓwabure gandǝ mbwe raka, ɓwamǝgule male tsǝa ɓǝa me, yì andǝ māmí andǝ amuni andǝ agirkuma male kat, ɓǝà mbwe tangnê nǝi.</char><verse eid="MAT 18:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="MAT 18:26" />
    <char style="wj">Mǝtúró-ɓala man pǝlǝa ɓun amur ankūnǝi a ɓadǝmbi sǝ zǝmba ama, &lt;&lt;Ɓwamǝgule, pakkam munyi, mǝ nǝ mbweko boalo mo kat.&gt;&gt;</char> <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" /><char style="wj">Murǝm yi sǝn mǝsǝswatǝr mala mǝtúró-ɓala man nda sǝ twaliban tangne sǝ nyi ɓǝ̀ o.</char><verse eid="MAT 18:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="MAT 18:28" />
    <char style="wj">Lang mǝtúró-ɓala man purna a nza ka, yi kum ɓi mǝtúró-ɓala mǝnana kǝ kpate tangna boalo bǝti ka. Pǝlǝa kpe a mǝsǝ'meali kàngkàng ne wi ama, &lt;&lt;Mbwem gir mǝnana ǝn nggǝ kpato ka.&gt;&gt;</char><verse eid="MAT 18:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="MAT 18:29" />
    <char style="wj">Ɓi mǝtúró-ɓala ɓun amur ankūnǝi sǝ zǝmbi wi ama, &lt;&lt;Pakkam munyi, mǝ nǝ mbweo.&gt;&gt;</char><verse eid="MAT 18:29" /></para>
  <para style="pi">
    <verse number="30" style="v" sid="MAT 18:30" />
    <char style="wj">Ɓwabure ɓinǝe. O kya tsǝa a oasǝ ɓi a ndàkurban ama she ɓǝ̀ mbwena tangna mǝnana kǝ kpate ka.</char> <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" /><char style="wj">Aɓi amǝtúró sǝn gìr man ngga bumia kìɗìkì, pǝlǝa à kya banggi ɓwamǝgule malea ce kat.</char><verse eid="MAT 18:31" /></para>
  <para style="pi">
    <verse number="32" style="v" sid="MAT 18:32" />
    <char style="wj">Ɓwamǝgule tunǝi ne wi ama, &lt;&lt;We mǝɓealɓikea, ǝn twalo ban tangna mo acemǝnana a zǝmbam ngga. </char> <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" /><char style="wj">Ɓoaro wu sǝn mǝsǝswatǝr mala ɓio mǝtúró kǝla mǝnana ǝn sǝn mo ka re?&gt;&gt;</char> <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" /><char style="wj">Bum ɓwamǝgule lul kǝ̀rkǝ́r, pǝlǝa tasǝ te a ndàkurban ɓǝa pe tanni, she ɓǝ̀ mbwena tangna mǝnana amurí kat ka.</char><verse eid="MAT 18:34" /></para>
  <para style="pi">
    <verse number="35" style="v" sid="MAT 18:35" />
    <char style="wj">Anggo gbal sǝ Tárrám mǝnana a kùli ka nǝ̀ pang nǝ ko yana ka aɓalǝ wun, yi mǝnana ɓǝ̀ wu twali amǝ'eam wun ban acauɓikea malea nǝ ɓabum wun mwashat raka.</char><verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Kànìgìr amur gau doɓala</para>
  <para style="r">(<ref loc="MRK 10:1-12">Markus 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Lang Yesu malǝna banggi acau mǝnia ka, nying bu-nzali Galili sǝ o a buì mala amǝ Yahudi a nkaring Nggeasala Jodan. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Ɓwabunda pas o atè, sǝ amǝ rǝkwana mana aɓalǝia ka twalia wia ban akwánó malea akanó.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Aɓea amǝ Farisi yiu aban Yesu, à yiua tambe. À yì ɗì ama, &lt;&lt;Nggearǝì ka, Nggurcau eari ɓwa ɓǝ̀ pǝr māmí ace ko man ngga le?&gt;&gt;<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Sǝ pǝlǝia wia ama, <char style="wj">&lt;&lt;Wu ɓalli mbo aɓa Malǝmce ama, &lt;A tite ka Mǝpusǝ-banza pak ɓwabura andǝ ɓwama,&gt;</char><note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 1:27">Tite 1:27</ref>; <ref loc="GEN 5:1">5:1</ref>,<ref loc="GEN 5:2">2</ref></char>.</note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><char style="wj">sǝ bang ama, &lt;Ace mǝnia ka ɓwabura nǝ̀ nying tárrí andǝ ngge sǝ nǝ̀ lanzǝ arǝ māmí. Yì andǝ māmí ka à dumǝna ɓwa mwashat?&gt;</char><note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 2:24">Tite 2:24</ref></char>.</note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><char style="wj">Lǝmdǝ ama yia ka à pa ɓari ɗǝm ɗàng, à nda mwashat. Ace mani ka aɓwana mana Ɓakuli kpapinia ka kǝɓwa ɓǝ̀ kǝa gauwia ɗang.&gt;&gt;</char><verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Pǝlǝa à ɗì ama, &lt;&lt;Ɓǝ̀ nda anggo ka, mana tsǝa sǝ Musa bang ama ɓwabura nǝ̀ gandǝ pe māmí takada gau doɓala sǝ nǝ̀ pǝri ɓǝ̀ o?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 24:1-4">Nggur 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref></char>.</note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesu pǝlǝia wia ama, <char style="wj">&lt;&lt;Musa eare ɓǝ̀ wu pǝr amālá wun ace ɓamúr-candǝa ma'wun. Sǝ a share ɓanza ka, gìrnî pa anggo ɗàng.</char> <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><char style="wj">Sǝ ǝn nggǝ na wun ama, ko yana mǝnana pǝr māmí sǝ pa ace nongnǝban a nza nǝ doɓala raka, sǝ kya al ɓè ɓwama ka, nda arǝ pak cauɓikea mala nongnǝban a nza nǝ doɓala</char><note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="fq" closed="false">nongnǝban a nza nǝ doɓala: </char><char style="ft" closed="false">ko &lt;&lt;ɗwanyi do nǝ mǝsǝcau arǝ doɓala.&gt;&gt;</char></note><char style="wj">.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref></char>.</note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Alaggana male pǝlǝa à ne wi ama, &lt;&lt;Ɓǝ̀ ce na anggo a nre ɓwabura andǝ ɓwama ka, kǝpǝna ɓǝ̀ ɓwa ɓǝ̀ kǝa al-ɓwama ɗàng.&gt;&gt;<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Pǝlǝa Yesu nyesǝia wia ama, <char style="wj">&lt;&lt;Koyan sǝ nǝ̀ ak mǝnia yì kanigir ka ɗang, she aɓwana mǝnana Ɓakuli pa ce nì acea ka.</char> <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" /><char style="wj">Aɓea ɓwana ka à pà nǝ̀ gandǝ al ɓwama ɗang acemǝnana à ɓǝlia ka abaran na; aɓea ka aɓwana nǝ̀ tsǝia sǝ à pǝlǝ abaran, sǝ aɓea ka à twalî ɓamuria à nǝ̀ do anggo ace pàkkiagir mala Domurǝm mala Ɓakuli nǝmurǝì. Ɓwa mǝnana nǝ̀ gandǝ ak mǝnia yì kanigir ka ɓǝ̀ é.&gt;&gt;</char><verse eid="MAT 19:12" /></para>
  <para style="s">Yesu tsǝkbu amur amuna</para>
  <para style="r">(<ref loc="MRK 10:13-16">Markus 10:13-16</ref>; <ref loc="LUK 18:15-17">Luka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Aɓea ɓwana yiu nǝ amuna a ban Yesu ace mǝnana ɓǝ̀ tsǝkbu amúrià sǝ ɓǝ̀ pakkia wia hiwi ka. Pǝlǝa alaggana mala Yesu lo, à sà arǝ aɓwana mǝno à yiu nǝ amuna ka.<verse eid="MAT 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14" />Sǝ Yesu na ama, <char style="wj">&lt;&lt;Wu nying amuna amǝkèke ɓǝa yiu abanam, wu kǝa pǝrkia ɗang, acemǝnana Domurǝm mala kùli ka nda ace aɓwana kǝla amuna mǝnia ka.&gt;&gt;</char> <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Lang Yesu tsǝ̀ngŋǝ̀nà bu amur amuna ka, pǝlǝa upi banì.<verse eid="MAT 19:15" /></para>
  <para style="s">Lagga mǝkume ɗì Yesu</para>
  <para style="r">(<ref loc="MRK 10:17-31">Markus 10:17-31</ref>; <ref loc="LUK 18:18-30">Luka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Ɓè ɓwa yiu a ban Yesu sǝ ɗì ama, &lt;&lt;Malǝm, ya gìr mǝɓoarne na mǝ nǝ pa sǝ mǝ kum yilǝmu mǝnana málá male pà kàm raka?&gt;&gt;<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesu nyesǝi wi ama, <char style="wj">&lt;&lt;Ace mana sǝ a kǝ ɗiem amur gir mǝnana mǝɓoarne na ka. Kǝ Ɓakuli nǝmurǝì nda mǝɓoarne. Sǝ ɓǝa earce a nǝ kum yilǝmu mǝnana málá male pà kàm raka, dumǝna púp a nǝ kpata anzongcau male.&gt;&gt;</char><verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Ɓwabure ɗì ama, &lt;&lt;Amǝ ye na?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Yesu eari wi ama, <char style="wj">&lt;&lt;Kǝa wal-lú ɗang, bwal rǝo arǝ amamǝna, kǝa iun'í ɗang, kǝa na nyir amur aɓwana ɗàng,</char><note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:13-16">Pur 20:13-16</ref>; <ref loc="DEU 5:20">Nggur 5:20</ref></char>.</note> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="wj">pe tárró andǝ nggo gulo, sǝ earce ɓio mǝkunɓala kǝla ɓamúrò.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12">Pur 20:12</ref>; <ref loc="DEU 5:16">Nggur 5:16</ref>; <ref loc="LEV 19:18">Pǝris 19:18</ref></char>.</note><verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />Lagga mǝno ne wi ama, &lt;&lt;Ən kpana ta anzongcau mǝnia kat. Mana ueo ɗǝm?&gt;&gt;<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Yesu nyesǝi wi ama, <char style="wj">&lt;&lt;Ɓǝ̀ a nǝ lùmsǝ nǝ cauɓoarna ka, o kya makki agirkuma mò, boale ka pè amǝ'tǝ̀r, awu nǝ kum gǝna a kùli. Sǝ wu yiu wu yi kpatam.&gt;&gt;</char><verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Lang lagga ok cau mǝnia ka, nyare o nǝ bumkiɗikea, acemǝnana yì ka, mǝkume na kǝ̀rkǝ́r.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Pǝlǝa Yesu ne alaggana male ama, <char style="wj">&lt;&lt;Ən nggǝ na wun mǝsǝcau, ndanǝ kwano ɓǝ̀ mǝkume ɓǝ̀ pa ɓamúrì ɓǝ̀ kutio a Domurǝm mala kùli.</char> <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" /><char style="wj">Ən nggǝ bangga wun ɗǝm, pa ɓamuru mala mǝkume aɓata yálmúrû mala Ɓakuli ka, kwano kútì kutio mala kalakadambi a tūli nlerǝman.&gt;&gt;</char><verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Lang alaggana male ok mǝnia yì cau ka, à ndali kǝ̀rkǝ́r sǝ à ɗì ama, &lt;&lt;Ɓǝ̀ nda anggo ka, yana ɓwe na nǝ̀ àwá?&gt;&gt;<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesu sǝnia kyap-kyap sǝ na ama, <char style="wj">&lt;&lt;Aban ɓwapǝndǝa ka mǝnia ka pà nǝ̀ pak ɗàng, sǝ a ban Ɓakuli ka koya gìr ka nǝ̀ gandǝ pa.&gt;&gt;</char><verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Pǝlǝa Bitǝrus nyesǝi wi ama, &lt;&lt;Sǝm nyìngŋǝ̀nà agir kat sǝm nda ban kpato, mana ado sǝm nǝ̀ kùmô?&gt;&gt;<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesu nea wia ama:</para>
  <para style="pi" vid="MAT 19:28">
    <char style="wj">Ən nggǝ na wun mǝsǝcau, a pwari mana bǝsa ɓanza nǝ̀ yiu ka, Muna mala Ɓwa nǝ̀ do a buno-murǝm mǝɓoarɓwe male. Sǝ wun mǝnana wu kǝ kpatam ngga, wu nǝ̀ do amur abuno-murǝm lum-nong-ɓari gbal. Wu nǝ̀ pakki atau mala amǝ Isǝrayila lum-nong-ɓari ɓashi.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">19:28 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 25:31">Mat 25:31</ref>; <ref loc="LUK 22:30">Luk 22:30</ref></char>.</note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><char style="wj">Sǝ ɓwa mǝnana kat nying ɓala ko amǝ'eambu andǝ amǝ'nggaula, ko tárrú, ko nggeau, ko amuna, ko anzali, ace lullǝam ngga, nǝ̀ kumia kusǝ gbǝman. Sǝ nǝ̀ kum yilǝmu mǝnana málá male pà kàm raka.</char> <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><char style="wj">Sǝama aɓwana pas mana aɓwana kǝ twalia tyang-tyang ngga, à nǝ̀ nggá pǝlǝ amana à būrǝcea ka, sǝ aɓwana pas mana à kǝ būrǝcea ka à nǝ̀ nggá duk aɓwana mana à nǝ̀ twalia tyang-tyang ngga.</char><note caller="+" style="f"><char style="fr" closed="false">19:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 20:16">Mat 20:16</ref>; <ref loc="LUK 13:30">Luk 13:30</ref></char>.</note><verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Kanicau arǝ amǝtúró ɓaban</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Yesu lidǝmba nǝ kanigir male ama:</para>
  <para style="pi" vid="MAT 20:1">
    <char style="wj">À nǝ̀ kànì Domurǝm mala kùli arǝ ɓè mǝtala ɓaban mǝnana pur nǝ dǝmbari ɗiɗyal ace alta amǝtúró ɓǝa kya pakki wi túró a ɓaban male ka.</char> <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" /><char style="wj">Yì ka, eare nǝ̀ pea wia dinari mwashat ace túró pwari mwashat. Pǝlǝa tasǝia a ɓaban male.</char><verse eid="MAT 20:2" /></para>
  <para style="pi">
    <verse number="3" style="v" sid="MAT 20:3" />
    <char style="wj">A bu-pwari tongno-nong-ine nǝ dǝmbari ka, yi kum aɓea aɓwana aban came ɓà a kún limo.</char> <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" /><char style="wj">Pǝlǝa nea wia ama, &lt;&lt;Wun gbal ka wu kya túró a ɓaban mem, mǝ nǝ mbwe wun gìr mǝnana kat nda ɓoaro ɓǝà pa wun ngga.&gt;&gt;</char> <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" /><char style="wj">Pǝlǝa à bwal njar à wario.</char></para>
  <para style="pi" vid="MAT 20:5">
    <char style="wj">Nyare pur ɗǝm nǝ pwarizǝkya andǝ wulio mala pwari kya pwan aɓea amǝ'túrô.</char> <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" /><char style="wj">A bu-pwari tongno mala pwarikpǝra ka, nyare puro kya kum aɓea aɓwana ɗǝm aban came à kǝ pak kǝgìr ɗang. Sǝ ɗia ama, &lt;&lt;Mana tsǝa sǝ pwari kpa wun kani aban came ɓà wu kǝ pak kǝgìr ɗang?&gt;&gt;</char><verse eid="MAT 20:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 20:7" />
    <char style="wj">À eari wi ama, &lt;&lt;Kǝ ɓwa pà sǝm túró mǝnana sǝm nǝ̀ pak ka ɗàng.&gt;&gt;</char></para>
  <para style="pi" vid="MAT 20:7">
    <char style="wj">Pǝlǝa nea wia ama, &lt;&lt;Wu kyan gbal a túró a ɓaban mem.&gt;&gt;</char><verse eid="MAT 20:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="MAT 20:8" />
    <char style="wj">Lang pwari kpana ka, mǝtala ɓaban ne ɓwa mǝnana tsǝi ɓǝ̀ kǝ sǝnbi wi ɓaban ngga ama, &lt;&lt;Tunǝ amǝtúró, mbwea tangnakusǝia. Tite amur amǝ'nzǝ́mò sǝ wu kya mur amǝdǝmba.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20:8 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LEV 19:13">Pǝris 19:13</ref>; <ref loc="DEU 24:15">Nggur 24:15</ref></char>.</note><verse eid="MAT 20:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 20:9" />
    <char style="wj">Aɓwana mana à twalia a bu-pwari tongno mala pwarikpǝra ka, ko yana ka à mbwe dinari mwashat.</char> <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" /><char style="wj">Amana à twalia nǝ dǝmbari ka à yiu nǝ tsǝkɓalǝu ama malea nǝ̀ kútì mala aɓwana mǝno ka. Sǝ kǝ boalo mǝ'mwashati na à pea wia ka.</char> <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" /><char style="wj">Lang à angŋǝna boalo ka, à tita nggwani arǝ mǝtala ɓaban.</char> <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" /><char style="wj">À bang ama, &lt;&lt;Aɓwana mǝnana à twalia túró nǝnzǝ́mò ka, à pak túró bu-pwari mwashat, kǝ ndo ka, sǝ à mbwe sǝm, sǝm karǝ sǝnǝia, sǝm mǝnana pwari wal sǝm málá amur sǝm aban túró ka.&gt;&gt;</char><verse eid="MAT 20:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 20:13" />
    <char style="wj">Pǝlǝa eari ɓeɓwa mwashat ateà ama, &lt;&lt;Ɓiam, ǝn lio ɗang. A ear amur dinari mwashat re?</char> <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" /><char style="wj">Twal gìr mǝnana à mbweo ka o. Nǝ eare mem sǝ ǝn mbweo kǝla mana ǝn mbwe ka amǝ'nzǝ́mò ka.</char> <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><char style="wj">Pa mǝ nǝ gandǝ pak gìr mana ǝn earce ka nǝ boalo mem re? A kǝ pak mɓali ace ɓoaro mem le?&gt;&gt;</char><verse eid="MAT 20:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 20:16" />
    <char style="wj">Anggo sǝ amǝ'nzǝ́mò à nǝ̀ pǝlǝ amǝdǝmba, sǝ amǝdǝmba nǝ̀ pǝlǝ amǝ'nzǝ́mò.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">20:16 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 19:30">Mat 19:30</ref>; <ref loc="MRK 10:31">Mar 10:31</ref>; <ref loc="LUK 13:30">Luk 13:30</ref></char>.</note><verse eid="MAT 20:16" /></para>
  <para style="s">Yesu bang cau ɗǝm amur lú male</para>
  <para style="r">(<ref loc="MRK 10:32-34">Markus 10:32-34</ref>; <ref loc="LUK 18:31-34">Luka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Lang Yesu nda aban o a Urǝshalima ka, tunǝ alaggana male lum-nong-ɓari a giriban, sǝ nea wia ama:<verse eid="MAT 20:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="MAT 20:18" />
    <char style="wj">Sǝm ndo sǝm nggǝ eauwe aban ká a Urǝshalima ka, sǝ Muna mala Ɓwa ka à nǝ̀ nggá me a ban agbani pǝris andǝ amǝkani Nggurcau. À nǝ̀ pakki wi ɓashi mǝnana nǝ̀ ká nǝi a lú ka.</char> <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" /><char style="wj">À nǝ̀ tasǝì a bu aɓwana mǝnana amǝ Yahudi na raka</char><note caller="+" style="f"><char style="fr" closed="false">20:19 </char><char style="fq" closed="false">aɓwana mǝnana amǝ Yahudi na raka: </char><char style="ft" closed="false">A mǝnia ka à nda ka amǝ Roma mana a bàkú mǝno ka amǝ Isǝrayila na aɓata nggwamnati malea ka.</char></note> <char style="wj">mǝnana à nǝ̀ ɓǝsǝki, à nǝ̀ koè, sǝ à nǝ̀ gbàllì a nggun-gangndǝi ka. A tàruià nongŋo ka nǝ̀ lo nǝ yilǝmu!</char><verse eid="MAT 20:19" /></para>
  <para style="s">Zǝmba mala nggea ka <optbreak /> Yohana andǝ Jemis</para>
  <para style="r">(<ref loc="MRK 10:35-45">Markus 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Nggea ka muna mala Zabadi yiu a ban Yesu nǝ amuni Yohana andǝ Jemis, sǝ yi kū`ndǝó a nzali sǝ zǝm ɓwamuru.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesu ɗì ama, <char style="wj">&lt;&lt;Mana a earkiyice?&gt;&gt;</char></para>
  <para style="p" vid="MAT 20:21">Pǝlǝa na ama, &lt;&lt;Mǝ nda aban zǝmba ama alaggalem mǝnia ɓari ka, wu tsǝk mwashat ɓǝ̀ do a buo mǝlì, sǝ ɓè mǝnia ka a buo mǝ'nggare a Domurǝm mò.&gt;&gt;<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesu nyesǝia wia ama, <char style="wj">&lt;&lt;Wu súrǝ̀ gir mǝnana wu zǝmgi ka ɗang. Wu nǝ̀ gandǝ nu tanni mǝnana ado mǝ nǝ nu ka le?&gt;&gt;</char></para>
  <para style="p" vid="MAT 20:22">À ear ama, &lt;&lt;E, sǝm nǝ̀ gandǝi.&gt;&gt;<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓafo, wu nǝ̀ gandǝ nu tanni mǝnana mǝ nǝ nu ka, sǝama pa ban-do a buam-mǝlì ko mǝ'nggare ka pà aɓa rǝcandǝa mem ɗang. Amǝnia yì aban ngga, à nda ace aɓwana mǝnana Tárrám gilǝkia wia ka.&gt;&gt;</char><verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Lang acili alaggana mala Yesu mǝnia lum ok ce ka, bumia lúllô arǝ amǝ'eambu mǝnia ɓari ka. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu pǝlǝa tunǝia abanarǝia sǝ na ama, <char style="wj">&lt;&lt;Wu sǝlǝa ama amurǝma mala mǝnia yì ɓanza ka à kǝ lǝmdǝ gulo amur aɓwana malea, sǝ aɓwana-mǝgule malea kǝ lǝmdǝia wia rǝcandǝa.</char> <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><char style="wj">Sǝ ma'wun ngga, anggo sǝ nǝ̀ pak ɗang. Ɓǝ̀ ya ɓwa na earce nǝ̀ duk ɓwamǝgule atà wun ngga, dumǝna púp nǝ̀ nyesǝ ɓamúrì nda muna-ɓala a ban wun.</char><note caller="+" style="f"><char style="fr" closed="false">20:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char>.</note> <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" /><char style="wj">Sǝ ɓwa mǝnana earce nǝ̀ duk murǝm ngga, dumǝna púp nǝ̀ duk guro ma'wun.</char> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><char style="wj">Nda kǝla Muna mala Ɓwa, mǝnana yiu ace dumsǝ aɓwana aguro raka. Yiu ace duk guro sǝ nǝ̀ pa yilǝmi ace amsǝ</char><note caller="+" style="f"><char style="fr" closed="false">20:28 </char><char style="fq" closed="false">amsǝ: </char><char style="ft" closed="false">Ko &lt;&lt;akmúr&gt;&gt;</char></note> <char style="wj">aɓwana pas.&gt;&gt;</char><verse eid="MAT 20:28" /></para>
  <para style="s">Ante ɓari kum sǝnban</para>
  <para style="r">(<ref loc="MRK 10:46-52">Markus 10:46-52</ref>; <ref loc="LUK 18:35-43">Luka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Lang Yesu andǝ alaggana male na rǝ purrì ɓá là Jeriko ka, aɓwana pas kana ateà. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Ante ɓari na ban do a girǝi njargula. Lang à ok ama Yesu na kǝ kútí ka, à loasǝ già ama, &lt;&lt;Mǝtalabangŋo, Muna mala Dauda,<note caller="+" style="f"><char style="fr" closed="false">20:30 </char><char style="fq" closed="false">Muna mala Dauda: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkà Dauda.&gt;&gt;</char></note> sǝn mǝsǝswatǝr ma'sǝm!&gt;&gt;<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Ɓwabunda sà arǝia ama ɓǝà duk kunia più. Sǝ à ɓinǝe, à loasǝ già bàng-bàng ama, &lt;&lt;Mǝtalabangŋo, Muna mala Dauda, sǝn mǝsǝswatǝr ma'sǝm!&gt;&gt;<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesu pǝlǝa came sǝ ɗia ama, <char style="wj">&lt;&lt;Mana wu earkiyice ɓǝ̀n pakka wun?&gt;&gt;</char><verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />À banggi wi ama, &lt;&lt;Ɓwamǝgule, sǝm nggǝ earce ɓǝ̀ mǝsǝ sǝm sǝnban.&gt;&gt;<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Yesu sǝn mǝsǝswatǝr malea sǝ tsǝk buì a mǝsǝia. Kara mǝsǝia mǝnna àkǝ̀ banì, pǝlǝa a o atè.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesu kutio a Urǝshalima</para>
  <para style="r">(<ref loc="MRK 11:1-11">Markus 11:1-11</ref>; <ref loc="LUK 19:28-38">Luka 19:28-38</ref>; <ref loc="JHN 12:12-19">Yohana 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Lang Yesu andǝ alaggana male gbàshìnà Urǝshalima ka à yì kara a muna-là mǝnana à tunǝi ama Betafaji, mana amur Nkono mala anggun Olif ka. Yesu túr alaggana male ɓari. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Banggia wia ama, <char style="wj">&lt;&lt;Wu kyane a muna-là mana a ɓadǝm wun ngga. Wun nǝ̀ kútí ani ka, wun nǝ̀ nggá kum mǝdambǝriso à kùrni nǝ muni atè. Wu panzǝi wu yinǝàm nǝi.</char> <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" /><char style="wj">Ɓǝ̀ kǝɓwa na wun kǝ cau ka, wu ne wi ama, Mǝtalabangŋo kǝ earcea. Nǝ̀ ɗekia wunia tù.&gt;&gt;</char><verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Mǝnia ka pa anggo ace mǝnana ɓǝà lùmsǝ ɓangnǝa mala Zakariya mǝnana ama:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Wu ne amǝ Urǝshalima ama,</para>
  <para style="q2" vid="MAT 21:5">Wu sǝni, murǝm ma'wun</para>
  <para style="q2" vid="MAT 21:5">ndya kǝ yiu a ban wun ngga!</para>
  <para style="q1" vid="MAT 21:5">Yì ka, mǝ'nwangsǝ-muru na,</para>
  <para style="q2" vid="MAT 21:5">kǝ yiu a nzǝm ndambǝritso.</para>
  <para style="q1" vid="MAT 21:5">A nzǝm muna-ndambǝritso</para>
  <para style="q2" vid="MAT 21:5">sǝ kǝ gya.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char>.</note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Pǝlǝa alaggana man wario à kya pak gìr mǝnana Yesu túriá ace ka. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />À kya yiu nǝ ndambǝritso andǝ muni. À makkia anggubyau malea a nzǝmia, pǝlǝa Yesu eauwe do. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ɓwabunda kǝ̀rkǝ́r sárǝ́ki anggubyau malea a tanjargula, acilia man ngga à kasǝki abu-nggun à nongsǝkia a tanjargula. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Aɓwabundǝa mǝnana a ɓadǝmbi andǝ amana a nzǝmi ka à loasǝ già ama,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Wu ɓwangsǝ Mǝkà Dauda!</para>
  <para style="q1" vid="MAT 21:9">Tsǝkbu mala Ɓakuli</para>
  <para style="q2" vid="MAT 21:9">nda muri,</para>
  <para style="q1" vid="MAT 21:9">yì ɓwa mǝnana kǝ yiu</para>
  <para style="q2" vid="MAT 21:9">aɓa lullǝ Mǝtalabangŋo ka!</para>
  <para style="q1" vid="MAT 21:9">Ɓǝà ɓwangsǝki Ɓakuli</para>
  <para style="q2" vid="MAT 21:9">akanó a kùli!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 118:25">Ang 118:25</ref>,<ref loc="PSA 118:26">26</ref></char>.</note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Lang Yesu kutina a Urǝshalima ka, nggea-là kat lo came amur kusǝì. Ɓwapǝndǝa ɗiban ama, &lt;&lt;Yana ɓwe nda man le?&gt;&gt;<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Aɓwabundǝa ear ama, &lt;&lt;Mǝnia ka Yesu na, Mǝɓangnǝa mala Ɓakuli mǝnana pur a Nazarat, a bu-nzali Galili ka.&gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Yesu pǝr amǝ kúrkúró aɓa Ndàmǝgule</para>
  <para style="r">(<ref loc="MRK 11:15-19">Markus 11:15-19</ref>; <ref loc="LUK 19:45-48">Luka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohana 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Lang Yesu kutio aɓa Ndàmǝgule mala Ɓakuli ka, pǝr amǝ'kúrkúró andǝ amǝ makkiagir, ramgita atebǝl mala amǝ nggaɗi boalo, sukkia, andǝ abuno mala amǝ makki akutumurǝm. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Nea wia ama, <char style="wj">&lt;&lt;Malǝmce mala Ɓakuli bang ama,</char></para>
  <para style="q1" vid="MAT 21:13">
    <char style="wj">&lt;&lt; &lt;Ɓala mem ngga</char></para>
  <para style="q2" vid="MAT 21:13">
    <char style="wj">à nǝ̀ tunǝi ama </char></para>
  <para style="q1" vid="MAT 21:13">
    <char style="wj">ndà ace pak hiwi,&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:13 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 56:7">Isha 56:7</ref>
      </char>.</note></para>
  <para style="q2" vid="MAT 21:13">
    <char style="wj">sǝ wu nyesǝi duk mpu</char></para>
  <para style="q1" vid="MAT 21:13">
    <char style="wj">mala amǝ'ɓǝmbǝriban!&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:13 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="JER 7:11">Ir 7:11</ref>
      </char>.</note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Ante andǝ agbakǝre yiu a baní aɓa Ndàmǝgule mala Ɓakuli, yi twalia wia ban akwánó malea. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Lang agbani pǝris andǝ amǝkani Nggurcau sǝn agir-ndali mǝnana peǎ, andǝ amuna mana à kǝ pak banɓoarnado aɓa Ndàmǝgule mala Ɓakuli ama, &lt;&lt;Ɓwangsǝkiban ngga dumǝna mala Muna mala Dauda&gt;&gt; ka, bumia lúllô.<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />Pǝlǝa à ɗì Yesu ama, &lt;&lt;A nǝ́ nggǝ̀ ok cau mǝnana amuna mǝnia kǝ ne ka?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Earia wia ama, <char style="wj">&lt;&lt;E, Mǝ nda ǝn nggǝ oea ka, sǝ wun ngga wu ɓalli mbo aɓa Malǝmce mala Ɓakuli ama,</char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">&lt;&lt; &lt;À tsǝk ɓwangsǝkiban</char></para>
  <para style="q2" vid="MAT 21:16">
    <char style="wj">a kún amuna mǝkèke </char></para>
  <para style="q1" vid="MAT 21:16">
    <char style="wj">andǝ abangna-muna?&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:16 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 8:2">Ang 8:2</ref>
      </char>.</note> &gt;&gt;<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Pǝlǝa nyia purî ɓá nggea-là o a Betani, a kàm sǝ kya nongŋo.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesu su nggun vwari</para>
  <para style="r">(<ref loc="MRK 11:12-14">Markus 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Nǝ dǝmbari ɗiɗyal Yesu nyàrî Betani, nda ban ká a Urǝshalima ka, nzala wali. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Mǝsǝì kpa arǝ nggun vwari a girǝi njargula, pǝlǝa sana wari a tǝrí. Sǝ kya kum kǝ ɓǝle ɗàng, mbui na nǝmurǝì. Pǝlǝa ne nggun ama, <char style="wj">&lt;&lt;A pà nǝ́ ɓǝl ɗǝm ɗàng!&gt;&gt;</char> Àkǝ̀ banì kara nggunî ime.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Alaggana nǝ̀ yia sǝni ka gìr nî pakkia wia gir'ndali gandǝa à ɗiban ama, &lt;&lt;Lang sǝ nggun vwari man kaurǝ ime anggo?&gt;&gt;<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓafo, ǝn nggǝ na wun, ɓǝ̀ wu ndanǝ paɓamuru sǝ wu tuti aɓa ɗenyicau raka, mǝnia yì gìr à pakki nggun ngga nda mana nǝmurǝì wun nǝ̀ gandǝ pe ka ɗàng. Ɓǝ̀ wun nǝ̀ ne mǝnia yì nkono ama, &lt;Lo, kya kpa aɓa nggeamùr&gt; ka, anggo sǝ nǝ̀ pa.</char><note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 13:2">1Kor 13:2</ref></char>.</note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" /><char style="wj">Gìr mǝnana kat wu zǝmba aɓa hiwi nǝ paɓamuru ka, wun nǝ̀ kumi.&gt;&gt;</char><verse eid="MAT 21:22" /></para>
  <para style="s">Amǝ Farisi ɗì Yesu amur <optbreak /> bangŋo male</para>
  <para style="r">(<ref loc="MRK 11:27-33">Markus 11:27-33</ref>; <ref loc="LUK 20:1-8">Luka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu kutio aɓa Ndàmǝgule mala Ɓakuli; lang nda ban kanigir ka agbani pǝris andǝ aɓwana-mǝgule mala amǝ Yahudi yiu a baní sǝ à ɗì ama, &lt;&lt;Nǝ́ yà bangŋo sǝ a kǝ pakki amǝnia yì agir ka, sǝ yana po bangŋo mala pakki agir nì?&gt;&gt;<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesu pǝlǝa earia wia ama, <char style="wj">&lt;&lt;Mǝ nǝ ɗì wun cau gbal mwashat, ɓǝ̀ wu panam eare ka sǝ mǝ nǝ bangga wun ko nǝ ya bangŋo sǝ ǝn nggǝ pakki amǝnia yì agir ka.</char> <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" /><char style="wj">Batisǝma mala Yohana ka, pur nǝ kǝshe? Pur nǝ ban Ɓakuli le ko pur nǝ ban ɓwapǝndǝa?&gt;&gt;</char></para>
  <para style="p" vid="MAT 21:25">À kùtí a pǝlǝki ce arǝarǝia ama, &lt;&lt;Ɓǝ̀ sǝm na ama, &lt;Pur nǝ ban Ɓakuli&gt; ka, nǝ̀ bangga sǝm ama, &lt;Sǝ palang sǝ wu ginǝ earnǝi?&gt; <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Sǝ ɓǝ̀ sǝm bang gbal ama, &lt;Pur nǝ ban ɓwapǝndǝa&gt; ka ɓangciu kǝ pakka sǝm arǝ aɓwana, acemǝnana ɓwapǝndǝa kat sǝlǝna ama Yohana ka mǝɓangnǝa mala Ɓakuli na.&gt;&gt;<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />Ace mani ka à ne wi ama, &lt;&lt;Sǝm sǝlǝ ɗang.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Yesu pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Mim gbal ka pà mǝ nǝ na wun ko nǝ ya bangŋo sǝ ǝn nggǝ pakki amǝnia yì agir ka ɗàng.</char><verse eid="MAT 21:27" /></para>
  <para style="s">Kanicau arǝ amuna ɓari</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />
    <char style="wj">&lt;&lt;Sǝ mana nda ɗenyicau ma'wun amur mǝnia yì cau mǝ nǝ bangga wun ngga? Ɓè ɓwa nakam nǝ amuna-burana ɓari. Wario a ban muna-dǝmba sǝ ne wi ama, &lt;Munem, kya ɓaban kya paktúró kam yalung.&gt;</char><verse eid="MAT 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29" />
    <char style="wj">&lt;&lt;Muna pǝlǝa ne tárrí ama, &lt;Pa mǝ nǝ ká ɗàng.&gt; Sǝa ma nǝnzǝ́mò ka ɓalki ɓabumi pǝlǝa wario.</char><verse eid="MAT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30" />
    <char style="wj">&lt;&lt;Tár amuna pǝlǝa kutio a ban ɓaria muni sǝ kya ne wi kǝcau mǝ'mwashati. Yì ka, earî tárrí ama nǝ̀ ká, sǝ wari ɗang.</char><verse eid="MAT 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31" />
    <char style="wj">&lt;&lt;Aɓalǝ amuna mǝnia ɓari ka yana pak gìr mǝnana tárrí earce ka?&gt;&gt;</char></para>
  <para style="p" vid="MAT 21:31">Pǝlǝa à earî Yesu ama mǝdǝmba na.</para>
  <para style="p" vid="MAT 21:31">Yesu pǝlǝa nea wia ama:</para>
  <para style="pi" vid="MAT 21:31">
    <char style="wj">Ən nggǝ bangga wun mǝsǝcau, amǝ'aki aboalo-cemi andǝ amā-gung à nǝ̀ akà wun dǝmba kutio a Domurǝm mala Ɓakuli.</char> <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><char style="wj">Yohana Mǝbatisǝma yiu yi kania wun tanjar mǝɓafoe, sǝ wu earnǝi ɗàng; sǝ amǝ'aki aboalo-cemi aɓa andǝ amā-gung earnǝi. Kat andǝ mǝnana wu sǝn mǝnia ka, wu nggaɗi ɗenyicau ma'wun wu earnǝi ɗàng.</char><note caller="+" style="f"><char style="fr" closed="false">21:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 3:12">Luk 3:12</ref>; <ref loc="LUK 7:29">7:29</ref>,<ref loc="LUK 7:30">30</ref></char>.</note><verse eid="MAT 21:32" /></para>
  <para style="s">Kanicau arǝ amǝtúró mana <optbreak /> à tsǝia sǝn ɓaban ngga</para>
  <para style="r">(<ref loc="MRK 12:1-12">Markus 12:1-12</ref>; <ref loc="LUK 20:9-19">Luka 20:9-19</ref>)</para>
  <para style="pi">
    <verse number="33" style="v" sid="MAT 21:33" />
    <char style="wj">Wu kwaki kir wun arǝ ɓè kanicau. Ɓè mǝ'rya tsǝk ɓaban anap, kàrì nǝ nkāndan, tǝm tūli kamggi anap aɓalǝi sǝ ɓak ban mǝ'dāhre ace mǝ'yale. Nyinggi aɓea amǝ'rya a buia ɓǝà kǝ sǝnbi wi, pǝlǝa o a bǝri.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:33 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 5:1">Isha 5:1</ref>,<ref loc="ISA 5:2">2</ref></char>.</note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" /><char style="wj">Kunɓǝla mala anap yi karna ka, túr aɓea amuna-ɓala male ɓǝà kya aki wi ɓǝla anap a bu amǝ'yál ɓaban.</char><verse eid="MAT 21:34" /></para>
  <para style="pi">
    <verse number="35" style="v" sid="MAT 21:35" />
    <char style="wj">Amǝ'rya yi bwal amuna-ɓala man. Mwashat ka à walki, ɓè ka à wali wú, sǝ ɓè man ngga à ɓukki nǝ atali.</char> <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" /><char style="wj">Mǝtala-ɓaban nyare tasǝ aɓea amuna-ɓala mana à làkkì à kútì amǝdǝmba ka. Kǝgìr mǝ'mwashati na amǝ'rya man yi pakkia wia ka.</char> <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" /><char style="wj">A masǝlǝate ka, pǝlǝa túr muni a bania. A nê male ka à nǝ̀ pè muni gulo.</char><verse eid="MAT 21:37" /></para>
  <para style="pi">
    <verse number="38" style="v" sid="MAT 21:38" />
    <char style="wj">Lang amǝ'rya man nǝ yia sǝn muni ka, à nea rǝia ama, &lt;&lt;Mǝliɓala nya kǝ yiu ka. Sǝm nǝ̀ yia wal-luí ace mǝnana ɓǝ̀ ɓaban duk ma'sǝm!&gt;&gt;</char> <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" /><char style="wj">Pǝlǝa à yì bwali à túrí a nzǝm nkāndan ɓaban sǝ à wali wú.</char><verse eid="MAT 21:39" /></para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 21:40" />
    <char style="wj">Sǝ ɓǝ̀ mǝtala ɓaban yiu ado ka, mana gir nì na nǝ̀ yia pangnǝ amǝ'rya mǝnia ka?</char><verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Agbani pǝris andǝ aɓwana-mǝgule earî wi ama, &lt;&lt;Nǝ̀ yia wal-lú amǝ'rya amǝ'ɓealɓikea man, sǝ nǝ̀ ak ɓaban nǝ̀ pea amǝ'rya mǝnana à nǝ̀ pè wi ɓǝlanggun ɓaban ɓǝ̀ kunɓǝle karna ka.&gt;&gt;<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesu pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Wu ɓal cau mana Malǝmce mala Ɓakuli bang ngga re? Mǝnana ama,</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">&lt;&lt; &lt;Tali mana amǝɓa ginǝi ka,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">nda yi pǝlǝ mǝɓoarne kat-kat ka.</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="wj">Mǝnia ka pé mala Ɓakuli na;</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="wj">Gìr ndali na a ban sǝm.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">21:42 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 118:22">Ang 118:22</ref>,<ref loc="PSA 118:23">23</ref></char>.</note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />
    <char style="wj">&lt;&lt;Sǝ ǝn nggǝ na wun ama Domurǝm mala Ɓakuli ka, à nǝ̀ é arǝ wun à nǝ̀ pè aɓwana mǝnana à nǝ̀ pak gìr mana Ɓakuli earkiyice ka.</char> <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" /><char style="wj">Ɓwa man kat kpa amur tali man ngga nǝ̀ ɓungio. Sǝ ɓwa mana tali man kpa amurí ka nǝ̀ betǝki.&gt;&gt;</char><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Lang agbani pǝris andǝ amǝ Farisi yi ok akanicau mala Yesu, sǝ à yì sǝlǝ ama nda arǝ bangcau amúrià ka, <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />à alte ama à nǝ̀ bwali, sǝ ɓangciu pakkia wia arǝ aɓwana, acemǝnana ɓwapǝndǝa pas earǝna ama Yesu ka mǝɓangnǝa na.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Kanicau arǝ Pakkiɗire Isǝ ɓwama</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luka 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu ne aɓwana cau ɗǝm nǝ akanicau ama:<verse eid="MAT 22:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="MAT 22:2" />
    <char style="wj">Domurǝm mala Ɓakuli ka à nǝ̀ kànì arǝ pakkiɗire mana ɓè murǝm tunǝo ace isǝ mālá muni ka.</char> <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" /><char style="wj">Túr amuna-ɓala male ɓǝà kya ne aɓwana mǝnana à tunǝia ka ɓǝà yiua pakkiɗire isǝban. À ginǝ yiu.</char><verse eid="MAT 22:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="MAT 22:4" />
    <char style="wj">Nyare túr aɓea amuna-ɓala male ɓǝà kya ne aɓwana mǝnana à tunǝia ka ama, &lt;&lt;Ən malǝna pak girlina kat. Ən walǝna ajamnda andǝ alo-nda amǝ'nyange mem. Girbunda kat ka à malǝna pe. Wu yiua pakkiɗire isǝban!&gt;&gt;</char><verse eid="MAT 22:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="MAT 22:5" />
    <char style="wj">Amǝnia yì aɓwana à tunǝia ka à tsǝk kiria ɗàng, à kùtí a pakkia agir malea mana ɓoaria wia ka. Ɓè ɓwa ka o a ɓaban male, sǝ ɓeɓwa ka o a ban kúrkúró male.</char> <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" /><char style="wj">Acilia man ngga à bwal amuna-ɓala male à pakkia wia mǝɓane sǝ à wal-luia.</char><verse eid="MAT 22:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 22:7" />
    <char style="wj">Bum murǝm man lul kǝ̀rkǝ́r; tasǝ asoje male à yì wal amǝwalkialu man, sǝ à pisǝ la malea.</char><verse eid="MAT 22:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="MAT 22:8" />
    <char style="wj">Pǝlǝa tunǝ amuna-ɓala male sǝ nea wia ama, &lt;&lt;Girbunda kat mala pakkiɗire isǝban ngga à malǝna pe. Sǝ aɓwana mǝnana ǝn tunǝia ka à kārǝa à nǝ̀ yiu a ban isǝban ɗang.</char> <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" /><char style="wj">Ado ka wu kyane amur agauwata anjarɓala sǝ wu tunǝ aɓwana mǝnana kat wu kumia a kàm ngga, ɓǝà yiua pakkiɗire.&gt;&gt;</char> <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" /><char style="wj">Nda amuna-ɓala man puro à o arǝ agauwata anjarɓala sǝ à tunǝki aɓwana mǝnana kat à kum ngga, amǝɓane andǝ amǝɓoarne. À yì lumsǝ ɓala isǝban.</char><verse eid="MAT 22:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MAT 22:11" />
    <char style="wj">Lang murǝm kutio nǝ̀ sǝn abǝri ka, mǝsǝì kpa arǝ ɓeɓwa na kam mana túr daura isǝban arǝì raka.</char> <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="wj">Pǝlǝa murǝm ɗì ama, &lt;&lt;Ɓiam, a kar lang sǝ a yiu kani daura isǝban pa a rǝo ɗàng?&gt;&gt; Yì ka, kum cau mǝnana nǝ̀ na ka ɗàng.</char><verse eid="MAT 22:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 22:13" />
    <char style="wj">Murǝm ne amuna-ɓala ama, &lt;&lt;Wu taka bui andǝ akusǝi, wu túrí a nza aɓa pǝndǝa. Akanó sǝ nǝ̀ ɓua nǝ̀ nggǝ nǝmnggi munabuì.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:13 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 8:12">Mat 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luk 13:28</ref></char>.</note><verse eid="MAT 22:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="MAT 22:14" />
    <char style="wj">Ɓakuli tunǝ aɓwana pas sǝ bǝti na à dum nǝ mǝsǝcau ɓǝ̀ Ɓakuli tària ka.</char><verse eid="MAT 22:14" /></para>
  <para style="s">Amǝ Farisi ɗì Yesu <optbreak /> amur mbwe boalo-cemi</para>
  <para style="r">(<ref loc="MRK 12:13-17">Markus 12:13-17</ref>; <ref loc="LUK 20:20-26">Luka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Amǝ Farisi o à kya kurkunarǝia amur njargula mǝnana à nǝ̀ bwali nǝi kàm aɓa nacau ka. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Pǝlǝa à túr amuna-ɓala malea andǝ aɓea ɓwana mala Hirǝdus a baní. À na ama, &lt;&lt;Malǝm, sǝm sǝlǝna ama we ka a nda ɓwa mǝɓafoe, ɗǝm ngga a kǝ kani tanjar mala Ɓakuli nǝ mǝsǝcau. A kǝ tàr ɓwa ɗang, acemǝnana aɓwana kat a bano ka à nda mwashat. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Bangga sǝm, a sǝne mo ka, ɓoaro ɓǝ̀ sǝm pè Kaisar, Murǝm mala amǝ Roma boalo-cemi le ko ɓoar ɗang?&gt;&gt;<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Yesu súrǝ́nà rǝ ɗenyicau malea mǝɓane kat pǝlǝa ɗia ama, <char style="wj">&lt;&lt;Wun amǝ'kúnɓárína, ace mana sǝ wu kǝ earce tambam?</char> <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" /><char style="wj">Wu lǝmdǝam mǝsǝboalo mana à mbwekina boalo cemi nǝi ka!&gt;&gt;</char></para>
  <para style="p" vid="MAT 22:19">À pǝlǝa à pè wi mǝsǝboale. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Sǝ ɗia ma, <char style="wj">&lt;&lt;Lullǝ yana andǝ foto mala yana arǝ mǝsǝboalo mǝnia ka?&gt;&gt;</char><verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />À eari wi ama, &lt;&lt;Mala Kaisar na.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Gìr mǝnana mala Kaisar na ka wu pè Kaisar, sǝ mǝnana mala Ɓakuli na ka wu pè Ɓakuli.&gt;&gt;</char> <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Lang à oè anggo ka, à ndali; kara à ɗeki à bwal njar malea à o.<verse eid="MAT 22:22" /></para>
  <para style="s">Amǝ Saduki ɗì Yesu <optbreak /> amur loapi ɓembe</para>
  <para style="r">(<ref loc="MRK 12:18-27">Markus 12:18-27</ref>; <ref loc="LUK 20:27-40">Luka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Àkǝ̀ pwari mǝno ka amǝ Saduki mǝnana à nakiyi ama loapi ɓembe pà kàm raka à yiu a ban Yesu à yì ɗì ama,<note caller="+" style="f"><char style="fr" closed="false">22:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 23:8">Atúró 23:8</ref></char>.</note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />&lt;&lt;Malǝm, Musa bang ama ɓǝ̀ ɓwa wu pànǝ muna raka mǝ'eambi ɓǝ̀ al māmí ɓǝ̀ ɓǝli lú amuna. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />A ban sǝm ɗiɗyal ka aɓea aɓwana tongno-nong-ɓari à nda amǝ'eambu. Mǝdǝmba malea al ɓwama sǝ wu ko kum muna andǝi ɗàng. Ɓwa mǝnana kpa a nzǝmi ka pǝlǝa twal ɓwame. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Anggo gbal sǝ kum ɓaria andǝ tàruià, kya bwal bu tongno-nong-ɓaria. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />A nzǝm lú malea kat ka, pǝlǝa ɓwame wu. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Sǝ ado ka, a pwari loapi ɓembe ka, yana aɓalǝia nda bura ɓwama, yì mana yia kat ka à dumǝna nǝi ka?&gt;&gt;<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesu pǝlǝa earia wia ama, <char style="wj">&lt;&lt;Wu ɓwarkio ace ɗwanyi súrǝ̀ Malǝmce andǝ rǝcandǝa mala Ɓakuli.</char> <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" /><char style="wj">A pwari loapi ɓembe ka alban pà kàm ɗǝm ɗàng. Ko yana le ka nǝ̀ do kǝla amǝturonjar mana a kùli ka.</char> <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" /><char style="wj">Sǝ amur loapi ɓembe ka, wu ɓal cau mana Ɓakuli bangga wun ngga re? Na ama,</char> <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="wj">&lt;Mǝ nda Ɓakuli mala Ibǝrayim, mala Ishaku, andǝ mala Yakupu.&gt; Ɓakuli ka mala alú na ɗang, mala aɓwana mana nǝyilǝmu ka nda.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:6">Pur 3:6</ref></char>.</note><verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Lang aɓwabundǝa ok mani ka, à ndali nǝ kanigir male.<verse eid="MAT 22:33" /></para>
  <para style="s">Nzongcau mana kàrmúr aɓi ka</para>
  <para style="r">(<ref loc="MRK 12:28-34">Markus 12:28-34</ref>; <ref loc="LUK 10:25-28">Luka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Lang amǝ Farisi ongŋǝna ama Yesu gandǝna amǝ Saduki ka, à ram rǝia à yiu. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Ɓè ɓwa aɓalǝia mǝnana súrǝ̀ Malǝmce mala Musa pepè ka, ɗì ama, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />&lt;&lt;Malǝm, atà anzongcau mǝnana aɓa Nggurcau mala Musa ka, mǝ yani na kútì aɓea?&gt;&gt; <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Yesu ne wi ama:</para>
  <para style="pi" vid="MAT 22:37">
    <char style="wj">&lt;&lt;Earce Mǝtalabangŋo, Ɓakuli mô nǝ ɓabumo mwashat, nǝ yilǝmo kat andǝ ɗenyicau mò kat.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:37 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DEU 6:5">Nggur 6:5</ref>
      </char>.</note><verse eid="MAT 22:37" /></para>
  <para style="pi">
    <verse number="38" style="v" sid="MAT 22:38" />
    <char style="wj">Mǝnia ka nda nzongcau mǝdǝmbe andǝ mǝgule mǝnana kútì aɓea kat ka.</char> <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><char style="wj">Mǝnana kpate ka nda kǝla yì, ama: &lt;&lt;Earce ɓio mǝkunɓala kǝla mǝnana a earce ɓamúrò ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:18">Pǝris 19:18</ref></char>.</note><verse eid="MAT 22:39" /></para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 22:40" />
    <char style="wj">Nggurcau kat andǝ Akanìgìr mala amǝ'ɓangnǝa mala Ɓakuli ka, à gyare arǝ anzongcau mǝnia ɓari ka.</char><verse eid="MAT 22:40" /></para>
  <para style="s">Yesu ɗì amǝ Farisi amur Mezaya</para>
  <para style="r">(<ref loc="MRK 12:35-37">Markus 12:35-37</ref>; <ref loc="LUK 20:41-45">Luka 20:41-45</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Lang amǝ Farisi ramǝna a banɓwáná ka, Yesu ɗia ama, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" /><char style="wj">&lt;&lt;Mana nda ɗenyicau ma'wun amur Mezaya?</char><note caller="+" style="f"><char style="fr" closed="false">22:42 </char><char style="fq" closed="false">Mezaya: </char><char style="ft" closed="false">Ko &lt;&lt;Kǝrǝsti&gt;&gt;</char></note> <char style="wj">Muna mala yana?&gt;&gt;</char></para>
  <para style="p" vid="MAT 22:42">À eare ama, &lt;&lt;Muna mala Dauda<note caller="+" style="f"><char style="fr" closed="false">22:42 </char><char style="fq" closed="false">Muna mala Dauda: </char><char style="ft" closed="false">Ko &lt;&lt;Mǝkà Dauda.&gt;&gt;</char></note> na.&gt;&gt;<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesu nea wia ama, <char style="wj">&lt;&lt;Ɓǝ̀ muna mala Dauda na ka, palang sǝ Dauda, nǝ́ kanì mala Bangŋo mala Ɓakuli a bumi ka, tunǝi ama &lt;Mǝtalem?&gt; Acemǝnana yì Dauda ka bang ama,</char><verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <char style="wj">&lt;&lt; &lt;Mǝtalabangŋo ne </char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">Mǝtalem ama:</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">Do a buam mǝlì,</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">she ɓǝ̀ ǝn tsǝ́ngŋǝ̀nà</char></para>
  <para style="q1" vid="MAT 22:44">
    <char style="wj">aɓio-amǝbura aɓata</char></para>
  <para style="q2" vid="MAT 22:44">
    <char style="wj">kusǝo ka.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">22:44 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 110:1">Ang 110:1</ref>
      </char>.</note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />
    <char style="wj">Sǝ ɓǝ̀ Dauda tunǝ Mezaya ama &lt;Mǝtalem&gt; ngga, palang sǝ Mezaya nǝ̀ pǝlǝ muni?&gt;&gt;</char><verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Kǝɓwa gandǝ nyesǝi wi cau ɗàng, sǝ àkǝ̀ pwarinì ka, kǝɓwa nyare ɗì ɗǝm ɗàng.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesu ɓǝsǝki amǝkani Nggurcau <optbreak /> andǝ amǝ Farisi</para>
  <para style="r">(<ref loc="MRK 12:38-39">Markus 12:38-39</ref>; <ref loc="LUK 11:43">Luka 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Pǝlǝa Yesu ne aɓwabundǝa andǝ alaggana male cau ama:<verse eid="MAT 23:1" /></para>
  <para style="pi">
    <verse number="2" style="v" sid="MAT 23:2" />
    <char style="wj">Amalǝm Nggurcau mala Musa andǝ amǝ Farisi ka à ndà kǝ aɓwana mǝnana à ndanǝ rǝcandǝa mala bǝlki aɓwana ɓá Nggurcau mala Musa ka.</char> <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><char style="wj">Ace mani ka wu kpata gìr mana kat à kania wun ngga, ɗǝm ngga wu pak gìr mana à bangga wun ama ɓǝ̀ wu pak ka. Sǝa ma wu kǝa kpata atúró malea ɗang, acemǝnana gìr mana à kǝ kani ka à kǝ pe ɗang.</char><verse eid="MAT 23:3" /></para>
  <para style="pi">
    <verse number="4" style="v" sid="MAT 23:4" />
    <char style="wj">Pak ka à kǝ yiu nǝ acau mǝkwane sǝ à nǝ̀ tsǝk aɓwana ama ɓǝa pea. Sǝ yia nǝ nggearǝia ka à pà nǝ̀ pak ko mwashat atà mǝno yì agir ka ɗang.</char><verse eid="MAT 23:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="MAT 23:5" />
    <char style="wj">Ko man à kǝ pak le ka à kǝ lǝmdǝki ɓǝ̀ aɓwana sǝni. Pak ka amuna-luru malea mala tsǝk amǝ'mbu-malǝmce mala cau mala Ɓakuli ka à kǝ pea ɓǝa tanggî mala acili aɓwana sǝ à nǝ̀ kùrkia a kundǝmbǝia andǝ amelbuia. Ankonggúr kun adaura malea ka amǝsake na.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:5 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="NUM 15:38">Ɓal 15:38</ref>; <ref loc="DEU 6:8">Nggur 6:8</ref>; <ref loc="MAT 6:1">Mat 6:1</ref></char>.</note> <figure style="fig" alt="Broad phylacteries and long fringes." file="lb00276c.tif" size="col" loc="MAT 23:5" copy="Knowles images" ref="23:5">Guru a kundǝmbǝu andǝ nkonggúr kún daura mǝsake.</figure> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><char style="wj">Ɓǝ̀ aɓwana rambǝa a ban pakkiɗire ka à kǝ earce ɓǝà pea wia aban-do mǝɓoarne. Ɓǝ̀ nda aɓa Ndakpapi ka, à earce abuno mǝnana à tsǝia ace aɓwana-mǝgule ka.</char> <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" /><char style="wj">À earce ɓǝ̀ aɓwana makkiakun nǝ pagulo aɓa limo, sǝ ɓǝa kǝ tunǝia ama, &lt;&lt;Malǝm.&gt;&gt;</char><verse eid="MAT 23:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="MAT 23:8" />
    <char style="wj">Wu kǝa eare ɓǝa tunǝ wun ama &lt;&lt;Malǝm&gt;&gt; ɗang. Wu nda ka amǝ'eamrǝarǝu kat. Malǝm ma'wun ngga nda mwashat ɓǝ̀rɓǝ̀r.</char> <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" /><char style="wj">Sǝ wu kǝa tunǝ kǝɓwa akani a ɓanza ama &lt;&lt;Tarrú&gt;&gt; ɗang, acemǝnana kǝ Tár wun na mwashat ɓǝ̀rɓǝ̀r a kùli.</char> <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" /><char style="wj">Sǝ ɓǝa kǝa tunǝ wun gbal ama &lt;&lt;Ɓwamǝgule&gt;&gt; ɗang acemǝnana kǝ ɓwamǝgule ma'wun nda Kǝrǝsti.</char> <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><char style="wj">Ɓwa mǝnana gulo kútì aɓi aɓalǝ wun ngga nda ɓwa mǝnana nǝ̀ duk muna-ɓala ma'wun ngga.</char><note caller="+" style="f"><char style="fr" closed="false">23:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="MRK 10:43">10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char>.</note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><char style="wj">Ɓwa mǝnana gusǝlǝ ɓamúrì ka, à nǝ̀ kyauwiki, sǝ ɓwa mǝnana kyamsǝ ɓamúrì ka à nǝ̀ gusǝlǝi.</char><note caller="+" style="f"><char style="fr" closed="false">23:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 14:11">Luk 14:11</ref>; <ref loc="LUK 18:14">18:14</ref></char>.</note><verse eid="MAT 23:12" /></para>
  <para style="s">Yesu ɓinǝce túró mala <optbreak /> amǝ'kúnɓárína</para>
  <para style="r">(<ref loc="MRK 12:40">Markus 12:40</ref>; <ref loc="LUK 11:39-42">Luka 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 23:13" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu gìr kun njar kutio a Domurǝm mala kùli arǝ aɓwana. Wun nǝ ɓamur rǝ wun ngga wu kútí ɗang, sǝ aɓwana mǝnana à earce ama à nǝ̀ kútí ka wu earia wia ɗàng.</char> <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><char style="wj">[Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu kǝ lǝmdǝ rǝ wun kǝla wu nda ka amǝ'ɓealɓoarne nǝ pakki ahiwi mǝsauwe, sǝ ɓafo ka wu nda mana wu kǝ kùmsǝkun amā-lú wu kǝ liki agirkuma malea arǝ ɓala malea ka. Acemani ka, Ɓakuli nǝ̀ pa wun tanni mana kutibanì ka kǝ̀rkǝ́r.]</char><verse eid="MAT 23:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="MAT 23:15" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu kǝ twal gya mǝsauwe arǝ anzali andǝ mur anggeamùr ace yinǝ ɓwa mwashat a tanjar ma'wun. Sǝ ɓǝ̀ wu yina nǝi ka pǝlǝa wu nyesǝi duk ɓwa-ká-lubǝsa kútì wun kusǝ ɓari.</char><verse eid="MAT 23:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="MAT 23:16" />
    <char style="wj">Caukwanban nǝ wun, wu nda ka ante mana à kǝ bwalì ante gara ka! Wu kǝ kani aɓwana ama: &lt;&lt;Ɓǝ̀ ɓwa kán nǝ Ndàmǝgule mala Ɓakuli ka, kángìrnî pà nǝ̀ bwali ɗàng; sǝama ɓǝ̀ ɓwa kán nǝ bolo-njengǝlan mana aɓa Ndàmǝgule ka, kángìrnî nǝ̀ bwali.&gt;&gt;</char> <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" /><char style="wj">Wun agǝm, ante! Bolo-njengǝlan andǝ Ndàmǝgule mǝnana tsǝk bolo-njengǝlan sǝ pak mǝfele ka, mǝyenani kútì ɓi?</char> <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="wj">Nyar ɗǝm ngga wu na ama, &lt;&lt;Ɓǝ̀ ɓwa kán nǝ gyangŋan paɓoro ka kángìrnî pà nǝ̀ bwali ɗàng; sǝ ɓǝ̀ ɓwa kán nǝ ɓoro mana amúr gyangŋan ngga nǝ̀ bwali.&gt;&gt;</char><figure style="fig" alt="Altar of Sacrifice" file="CO00843B.TIF" size="col" loc="MAT 23:18" ref="23:18">Gyangŋan pa ɓoro ko ɗārǝâ a ban Ɓakuli</figure> <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" /><char style="wj">Wun ante! Mǝyani gulo kútì ɓi: ɓoro mana amur gyangŋan ngga le, ko gyangŋan mana tsǝk ɓoro sǝ pak mǝfele ka?</char> <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" /><char style="wj">Ɓwa mana kán nǝ gyangŋan ngga, kánǝna nǝi andǝ gir mana amurí ka.</char> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" /><char style="wj">Ɓwa mana kán nǝ Ndàmǝgule mala Ɓakuli ka, kánǝna nǝi andǝ Ɓakuli mana do aɓalǝi ka.</char> <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><char style="wj">Ɓǝ̀ ɓwa kán nǝ kùli ka kánǝna nǝ buno-murǝm mala Ɓakuli andǝ Ɓakuli mana do amur buno-murǝm ngga.</char><note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 66:1">Isha 66:1</ref>; <ref loc="MAT 5:34">Mat 5:34</ref></char>.</note><verse eid="MAT 23:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 23:23" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu kǝ pe Ɓakuli gauwe mwashat aɓalǝ agauwe lum mala agir mǝkèke kǝla ambukagir ɓaban ma'wun, sǝ wu būrǝce agir mǝɓoarne mǝnana nggurcau kànì ka, kǝla bang mǝsǝcau, andǝ ɓwamuru, andǝ pak mǝɓoarne. Amǝnia ka à nda ka gir mǝnana ɓoaro ɓǝ̀ wu kǝ pea atārǝia andǝ acilia mǝno ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:23 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LEV 27:30">Pǝris 27:30</ref>
      </char>.</note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" /><char style="wj">Wu nda ka ante mana à kǝ bwalì ante gara ka! Wu tsǝk ɓamur rǝ wun wu kǝ kpata amuna nzongcau mala Nggurcau mana à bwal kǝ ban pepè raka, sǝ anzongcau amǝgulke mala Nggurcau ka, wu būrǝcea sǝ wu sǝlǝ ɗang.</char><verse eid="MAT 23:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="MAT 23:25" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu nda kǝla akwar andǝ atasau mana à lak nzǝmia pepè ka, sǝ ɓalǝ wun ngga lùmsǝ nǝ atúró ɓealɓikea andǝ mɓali.</char> <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" /><char style="wj">We ntei ɓwa Farisi! Tsǝkiro arǝ gilǝki ɓabumo ɓǝ̀ duk nǝ ɓoarnsari, sǝ aɓwana nǝ̀ sǝn atúró ɓoarna mô, à nǝ̀ earnǝia.</char><verse eid="MAT 23:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="MAT 23:27" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu nda kǝla aɓembe mana à tasǝ nzǝmia nǝ pyanti mǝpwasǝe ka; à ɓoarsǝna nǝ nza, sǝ ɓālǝia ka lùmsǝ nǝ amú mala alú andǝ agir ɓyakǝno.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:27 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ACT 23:3">Atúró 23:3</ref>
      </char>.</note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" /><char style="wj">Ana gbal, a nza ka, aɓwana kǝ sǝn wun kǝla wu nda ka amǝ'ɓealɓoarna, sǝ a ɓabum wun ngga, wu lùmsǝ nǝ swarkiban andǝ ɓealɓikea.</char><verse eid="MAT 23:28" /></para>
  <para style="s">Yesu na cè tanni mala <optbreak /> amǝ'kúnɓárína</para>
  <para style="r">(<ref loc="LUK 11:47-51">Luka 11:47-51</ref>)</para>
  <para style="pi">
    <verse number="29" style="v" sid="MAT 23:29" />
    <char style="wj">Caukwanban nǝ wun amǝ Farisi andǝ amǝkani Nggurcau mala Musa, wun amǝ'kúnɓárína! Wu kǝ ɓak aɓembe mala amǝ'ɓangnǝa mana aká wun wal-luia, sǝ wu kǝ gilǝkice mala amǝ'cauɓoarna mana aká wun wal-luia ka.</char> <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" /><char style="wj">Sǝ pak ka wu kǝ na ama, &lt;&lt;Ɓǝ̀ sǝm ndanǝ do mala aká sǝm a pwarian ngga, ɓǝ́ pà sǝm nǝ̀ pu nzǝm gir mǝnana aká sǝm pakkì amǝ'ɓangnǝa, à wal-luia ka ɗàng.&gt;&gt;</char> <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><char style="wj">Bangŋe ma'wun mǝnana ana ka lǝmdǝ ama wu nda ka amǝkau mala aɓwana mǝnana à wal amǝ'ɓangnǝa ka.</char> <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" /><char style="wj">Wu lidǝmba wu masǝlǝ kun cauɓikea mana aká wun tite ka!</char><verse eid="MAT 23:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="MAT 23:33" />
    <char style="wj">Wun an'yau, wun amuna baffu! Lang sǝ wun nǝ̀ apî ɓashi ká lú-bǝsa?</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:33 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 3:7">Mat 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luk 3:7</ref></char>.</note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" /><char style="wj">Acemani ka, mǝ ndo mǝ nǝ tura wun ban nǝ amǝ'ɓangnǝa, andǝ amǝ'sǝlǝe, andǝ amǝkànìgìr. Aɓea ateà ka wun nǝ̀ walia, wun nǝ̀ gbàllia a nggun; sǝ acilia ka wun nǝ̀ koea aɓalǝ andakpapi sǝ wun nǝ̀ pǝrtea arǝ alá, wun nǝ̀ pea wia tanni.</char> <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><char style="wj">Acemani ka, tangnakusǝu mǝɓane ace sukki nkila mala amǝ'ɓealɓoarna kat mana à walia a ɓanza ka, nǝ̀ nyare amur wun, tite arǝ Habila yí bwal ban Zakariya, muna mala Berikiya, mana wu wali a nre ban mǝfele andǝ gyangŋan ngga.</char><note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 4:8">Tite 4:8</ref>; <ref loc="2CH 24:20-22">2Acau 24:20-22</ref></char>.</note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" /><char style="wj">Mǝsǝcau, amǝnia yì atanni kat ka, à nǝ̀ kum aɓwana mana a nza man ngga.</char><verse eid="MAT 23:36" /></para>
  <para style="s">Yesu keban amur amǝ Urǝshalima</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luka 13:34-35</ref>)</para>
  <para style="pi">
    <verse number="37" style="v" sid="MAT 23:37" />
    <char style="wj">Oi amǝ Urǝshalima, amǝ Urǝshalima, wun amǝ'wal-lú amǝ'ɓangnǝa mala Ɓakuli, wun amǝ'ɓukki aɓwana mǝnana Ɓakuli túriá a ban wun ngga. Kusǝ shen Mǝ nda arǝ earce mǝ mǝn abuam amur wun kǝla mǝnana nggǔ kǝ mǝngi ankpamtari amur amuni ka, sǝ wu ginǝ nkang!</char> <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" /><char style="wj">Adyan ngga, Ndàmǝgule ma'wun ngga à ginǝkina wuni, uena atàrǝì.</char><note caller="+" style="f"><char style="fr" closed="false">23:38 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 22:5">Ir 22:5</ref></char>.</note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><char style="wj">Ən nggǝ na wun, twal a yalung ngga pa wu nǝ̀ sǝn mǝsǝam ɗǝm ɗàng, she pwari mǝnana wun nǝ̀ na ama,</char></para>
  <para style="q1" vid="MAT 23:39">
    <char style="wj">&lt;&lt;Tsǝkbu mala Ɓakuli na</char></para>
  <para style="q2" vid="MAT 23:39">
    <char style="wj">amur yì ɓwa mǝnana</char></para>
  <para style="q1" vid="MAT 23:39">
    <char style="wj">kǝ yiu aɓa lullǝ</char></para>
  <para style="q2" vid="MAT 23:39">
    <char style="wj">Mǝtalabangŋo ka.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">23:39 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="PSA 118:26">Ang 118:26</ref>
      </char>.</note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesu nacau amur masǝlǝata ɓanza</para>
  <para style="r">(<ref loc="MRK 13:1-13">Markus 13:1-13</ref>; <ref loc="LUK 21:5-19">Luka 21:5-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Lang Yesu nyìngŋǝ̀nà ɓá Ndàmǝgule mala Ɓakuli sǝ nda ban o ka, alaggana male yiu a baní sǝ à ne wi ama ɓǝ̀ sǝn a'ulang aɓah mala Ndàmǝgule mala Ɓakuli.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Wu sǝn aɓah mǝnia ka re? Ən nggǝ na wun mǝsǝcau à nǝ̀ yia arkia à nǝ̀ sukkia a nzali, kǝ tali pa nǝ̀ ueo aban came amur ɓi ɗang.&gt;&gt;</char><verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Nǝ nzǝ́mò ka Yesu yì do amur Nkono mala anggun Olif. Alaggana male yiu a baní nǝmurǝì sǝ à ne wi ama, &lt;&lt;Sǝm ama wu bangga sǝm, a ya pwari sǝ agir mǝnia ka nǝ̀ yia pa, sǝ mana nda gìr mǝnana nǝ̀ lǝmdǝ yiu mo andǝ masǝlǝata ɓanza ka?&gt;&gt;<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesu pǝlǝia wia ama:</para>
  <para style="pi" vid="MAT 24:4">
    <char style="wj">Wu tsǝkir wun, wu kǝa eare ɓǝ̀ kǝɓwa ɓosǝki wun ɗang.</char> <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><char style="wj">Acemǝnana aɓwana pas nǝ̀ nggá yiu aɓa lullǝam à nǝ̀ na ama à nda ka Kǝrǝsti, sǝ à nǝ̀ ɓosǝki aɓwana pas.</char><verse eid="MAT 24:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="MAT 24:6" />
    <char style="wj">Wu nǝ̀ ok ce a'lwa andǝ gǝshi a'lwa, cala ɓangciu pakka wun ɗàng. Amǝnia yì agir ka à nǝ̀ yia pa púp, sǝ masǝlǝata ɓanza ka nda più.</char> <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><char style="wj">Nzali nǝ ká lwa arǝ ɓe nzali. Murǝm nǝ̀ ká lwa arǝ ɓe murǝm. Nzala, andǝ akwánó twàl-là, andǝ dǝurǝo mala nzali nǝ pa arǝ aban ɗàngɗáng aɓa ɓanza.</char> <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" /><char style="wj">Amǝnia yì agir kat ka à nda ka tita tanni mǝnana kǝ yiu ka.</char><verse eid="MAT 24:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 24:9" />
    <char style="wj">À nǝ̀ yia bwalki wun, à nǝ̀ ká nǝ wun a ban aɓwana mǝnana à nǝ̀ pa wun tanni sǝ à nǝ̀ wal-lú wun ngga. Aɓwana arǝ anzali kat à nǝ̀ ɓinǝ mǝsǝ wun acemǝnana wu nda ka amǝ kpatam ngga.</char> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" /><char style="wj">Aɓalǝ amǝno yì apwari ka aɓwana pas nǝ̀ nying paɓamuru malea arǝàm, à nǝ̀ oasǝkimúr rǝarǝia sǝ à nǝ̀ ɓinǝmǝsǝ rǝarǝia.</char> <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><char style="wj">Amǝ'ɓangnǝa mǝ'nyirì pas nǝ̀ yia puro à nǝ̀ ɓosǝki aɓwana pas.</char> <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><char style="wj">Sǝ acemǝnana ɓealɓikea nǝ̀ yia làkkì ka, earcearǝu mala bangula aɓwana arǝarǝia ka nǝ̀ amsǝa,</char> <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><char style="wj">sǝama ɓwa mǝnana cam kàngkàng aɓa paɓamuru aban ká masǝlǝate ka, nǝ̀ àwá.</char> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" /><char style="wj">Sǝ mǝnia yì Cau Amsǝban</char><note caller="+" style="f"><char style="fr" closed="false">24:14 </char><char style="fq" closed="false">Cau Amsǝban </char><char style="ft" closed="false">ko Bǝsa Cau Mǝɓoarne</char></note> <char style="wj">mala Domurǝm mala kùli ka, à nǝ̀ hamnǝi aɓa ɓanza kat ace mǝnana aɓwana arǝ anzali kat ɓǝa o. A nzǝm mǝno ka sǝ masǝlǝata ɓanza nǝ̀ yiu.</char><verse eid="MAT 24:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="MAT 24:15" />
    <char style="wj">Wu nǝ̀ yia sǝn yì &lt;&lt;Gìr ɓeami mǝnana kǝ tsǝa Ɓakuli nǝ̀ nying ban-do male aɓalǝ aɓwana,&gt;&gt;</char> <note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char>.</note> <char style="wj">mana Daniyel mǝɓangnǝa mala Ɓakuli bang ce, camǝna a ban mǝfele aɓa Ndàmǝgule mala Ɓakuli. Sǝ ɓǝ̀ wu sǝnǝni ka, ɓwa mǝnana kǝ ɓal mǝnia yì cau ka ɓǝ̀ súrǝ̀ ɓālǝi.</char> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" /><char style="wj">Sǝ aɓwana mǝnana a nzali Yahudi ka ɓǝà ɓangŋa ɓǝà o aɓalǝ ankono.</char> <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><char style="wj">Ɓwa mǝnana nda amur kurǝm ngga ɓǝ̀ kǝa na ama nǝ̀ sulǝo nǝ̀ twal kǝgìr a ɓala ɗàng.</char> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" /><char style="wj">Ɓwa mǝnana nda a ɓaban ngga ɓǝ̀ kǝa na ama nǝ̀ nyare nǝ̀ nggá twal daura male ɗàng.</char> <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" /><char style="wj">Aɓalǝ amǝno yì apwari ka nǝ̀ duk gir ɓangciu kǝ̀rkǝ́r nǝ amǝ'munabum andǝ amǝ'nggeamur!</char> <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" /><char style="wj">Wu zǝmba ɓǝ̀ ɓangŋa ma'wun ɓǝ̀ kǝa pa a kunɗwal ko a pwari Sabbat ɗàng.</char> <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><char style="wj">Acemǝnana nggea tanni mǝgule nǝ̀ lo, mǝnana a puro mala ɓanza yi bwal ado ka, à malaká sǝn ulang yì ɗàng, sǝ à nzǝmi ka à pà nǝ̀ sǝn ulang yì ɗǝm ɗàng.</char> <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" /><char style="wj">Yàle ɓǝ̀ Ɓakuli amsǝ ma anonggio mala tanni mǝno raka, kǝɓwa pà kàm nǝ̀ au ɗàng, sǝama ace aɓwana mǝnana Ɓakuli tarkia ka nǝ̀ amsǝ anonggio mǝno.</char><verse eid="MAT 24:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 24:23" />
    <char style="wj">Ɓǝ̀ kǝɓwa puro sǝ na wun ama, &lt;&lt;Kǝrǝsti nia ka,&gt;&gt; ko &lt;&lt;Ndako ka,&gt;&gt; wu kǝa eare ama mǝsǝcau na ɗang.</char> <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" /><char style="wj">Acemǝnana akǝrǝsti mǝ'nyirì andǝ amǝ'ɓangnǝa mǝ'nyirì à nǝ̀ puro sǝ à nǝ̀ pakki agir-lǝmdǝa mǝgulke andǝ agir-ndali ace swarki aɓwana, yàle ɓǝà nǝ̀ gandǝi ka, nggearǝ aɓwana mǝnana Ɓakuli tarkia ka, à nǝ̀ ɓosǝkia.</char> <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" /><char style="wj">Wu tsǝkir wun, ǝn gbara ǝn bangŋǝna wun adyan.</char><verse eid="MAT 24:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="MAT 24:26" />
    <char style="wj">Ɓǝ̀ kǝɓwa na wun ama, &lt;&lt;Wu sǝni, Kǝrǝsti ndako a ɓabondo ka,&gt;&gt; ce wu kyan ɗang; ko ɓǝà na ama, &lt;&lt;Ndya sǝmbǝrǝa a ɓakurǝm ngga,&gt;&gt; wu kǝa earnǝi ɗang.</char> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" /><char style="wj">Yiu mala Muna mala Ɓwa ka nǝ̀ pa kǝla mǝnana tǎlaban kǝ li'nzama nǝ takuli sǝ aɓwana a njar-nzali kǝ sǝni ka.</char> <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" /><char style="wj">Ban mǝnana lugir nong kam ngga, abanì sǝ adǝkǝlaki nǝ̀ rambǝa.</char><verse eid="MAT 24:28" /></para>
  <para style="s">Nyare mala Muna mala Ɓwa</para>
  <para style="r">(<ref loc="MRK 13:24-27">Markus 13:24-27</ref>; <ref loc="LUK 21:25-28">Luka 21:25-28</ref>)</para>
  <para style="pi">
    <verse number="29" style="v" sid="MAT 24:29" />
    <char style="wj">Tù àkǝ̀ nzǝm tanni mǝnana aɓalǝ amǝno yì anonggio ka,</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">&lt;&lt;Pǝndǝa nǝ̀ gìr</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">ɓamǝsǝ pwari,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">sǝ zongŋo ka</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">pà nǝ̀ ta ɗǝm ɗàng;</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">anlero nǝ̀ purî kùli</char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">à nǝ̀ kpa,</char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">sǝ arǝcandǝa mǝnana </char></para>
  <para style="q1" vid="MAT 24:29">
    <char style="wj">a bumkuli ka </char></para>
  <para style="q2" vid="MAT 24:29">
    <char style="wj">à nǝ̀ dǝurǝkio.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">24:29 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ISA 13:10">Isha 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>; <ref loc="JOL 2:10">Jol 2:10</ref>,<ref loc="JOL 2:15">15</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="EZK 32:7">Ezǝk 32:7</ref>; <ref loc="REV 6:12">Sǝn 6:12</ref>,<ref loc="REV 6:13">13</ref></char>.</note><verse eid="MAT 24:29" /></para>
  <para style="pi">
    <verse number="30" style="v" sid="MAT 24:30" />
    <char style="wj">Sǝ anggo ka, gìr mǝnana nǝ̀ lǝmdǝ ama Muna mala Ɓwa na kǝ yiu ka nǝ̀ pusǝrǝi a kùli. Ɓwabunda man kat a ɓanza ka nǝ̀ ɓua. À nǝ̀ sǝn Muna mala Ɓwa aban yiu aɓalǝ apǝrɓang a bumkuli, nǝ rǝcandǝa andǝ ɓoarɓwa mǝgule</char>. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><char style="wj">Sǝ nǝ̀ tasǝ amǝturonjar male nǝ tunǝban gi njawe mǝgule, à nǝ̀ dapikia aɓwana male mǝnana à tarkia ka arǝ aban kat aɓa ɓanza.</char><verse eid="MAT 24:31" /></para>
  <para style="s">Yesu Kànìgìr nǝ nggun vwari</para>
  <para style="r">(<ref loc="MRK 13:28-31">Markus 13:28-31</ref>; <ref loc="LUK 21:29-33">Luka 21:29-33</ref>)</para>
  <para style="pi">
    <verse number="32" style="v" sid="MAT 24:32" />
    <char style="wj">Wu kànì mǝnia yì gìr ka arǝ nggun vwari; ɓǝ̀ tinata to sǝ nda ban pusǝ mbui ka, wu sǝlǝ ama mbulo gbashina.</char> <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" /><char style="wj">Ana gbal, ɓǝ̀ wu sǝna amǝnia yì agir ka, wu sǝlǝ ama pwari gbashina, nda kun ɓala tù.</char> <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" /><char style="wj">Ɓafo, ǝn nggǝ bangga wun, nza man pa nǝ̀ kútí ɓà ɗàng she ɓǝ̀ amǝnia yì agir ka à pàngŋǝ̀nà ka.</char> <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><char style="wj">Agir mǝnana a bumkuli andǝa mǝnana a nzali ka teà nǝ̀ malâ, sǝ cau mem ngga tè pà nǝ̀ mal ɗang.</char><verse eid="MAT 24:35" /></para>
  <para style="s">Kǝ ɓwa súrǝ̀ nongŋo <optbreak /> andǝ bu-pwari ɗang</para>
  <para style="r">(<ref loc="MRK 13:32-37">Markus 13:32-37</ref>; <ref loc="LUK 17:26-30">Luka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="pi">
    <verse number="36" style="v" sid="MAT 24:36" />
    <char style="wj">Kǝ ɓwa súrǝ̀ pwari ko bu-pwari mǝnana Muna mala Ɓwa nǝ̀ yiu nǝi ka ɗàng. Amǝturonjar mǝnana a kùli ka à súrǝì ɗàng, ko nggearǝ Muna mala Ɓakuli ka súrǝì ɗàng, she kǝ Ɓakuli nǝmurǝì.</char> <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" /><char style="wj">Kǝla mǝnana yi pa a nza mala Nuhu ka, anggo sǝ yiu mala Muna mala Ɓwa nǝ̀ pa.</char> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><char style="wj">A nza mǝnana mùr-gùla malaká yiu peatu raka, ɓwapǝndǝa kǝ lili, kǝ nu, sǝ à kǝ al rǝarǝia, yi bwal pwari kutio mala Nuhu aɓa nggea-waru.</char> <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" /><char style="wj">À sǝlǝ ama ɓè kǝgìr nǝ̀ yia kumia ɗàng, kara mùr-gùla yi pwania kat. Anggo sǝ yiu mala Muna mala Ɓwa nǝ̀ pa.</char><verse eid="MAT 24:39" /></para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 24:40" />
    <char style="wj">A pwari mǝno ka, à nǝ̀ kum aburana ɓari atārǝia a ɓaban; à nǝ̀ twal mwashat, à nǝ̀ ɗeki ɓè.</char> <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" /><char style="wj">À nǝ̀ kum amamǝna ɓari amur tali aban gogô, à nǝ̀ twal man mwashat ka, à nǝ̀ nying ɓè.</char><verse eid="MAT 24:41" /></para>
  <para style="pi">
    <verse number="42" style="v" sid="MAT 24:42" />
    <char style="wj">Ace mani ka, wu tsǝkir wun acemǝnana wu súrǝ̀ pwari mǝnana Mǝtala wun nǝ̀ yiu nǝi ka ɗàng.</char> <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><char style="wj">Sǝ wu sǝlǝ ama, ɓǝ̀ mǝtala-ɓala súrǝ̀ bu dù mǝnana mǝn'í nǝ̀ yiu nǝi ka, nǝ̀ dum nǝ mǝsǝì, pà nǝ̀ eare ɓǝà yi ɓun kunɓala male ɗàng.</char> <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" /><char style="wj">Anggo gbal wu dum nǝ gilǝrǝu, acemǝnana Muna mala Ɓwa nǝ̀ yiu a bu-pwari mǝnana wu pak ɗenyicau mala yiu male raka.</char><verse eid="MAT 24:44" /></para>
  <para style="s">Guro mǝ'mǝsǝcau nì andǝ <optbreak /> mana pànǝ mǝsǝcau raka</para>
  <para style="r">(<ref loc="LUK 12:35-48">Luka 12:35-48</ref>)</para>
  <para style="pi">
    <verse number="45" style="v" sid="MAT 24:45" />
    <char style="wj">Yana ɓwe nda guro mǝ'mǝsǝcau nì andǝ mǝ'sǝlǝe mǝnana mǝtala-ɓala male twali tsǝì amur acili aguro, ɓǝ̀ kǝ pea wia girlina a bu-pwari mǝnana kasǝ ka?</char> <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" /><char style="wj">Mǝnia yì guro ka ban nǝ ɓoari wi mǝnana ɓǝ̀ mǝtala ɓala male nyare yi kumi nǝ̀ nggǝ pak túrè ka.</char> <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><char style="wj">Mǝsǝcau ǝn nggǝ bangga wun, nǝ̀ yia tsǝì ɓǝ̀ kǝ ɗenyi nǝ kume male kat.</char> <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" /><char style="wj">Sǝ ɓǝ̀ guro mǝno ka mǝɓealɓikea na, sǝ ne ɓamúrì ama, &lt;&lt;Mǝtala-ɓala mem pà nǝ̀ yiu tù ɗàng.&gt;&gt;</char> <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" /><char style="wj">Sǝ tita kwaki aɓi aguro sǝ kutia li andǝ nuki agir atà amǝwalo mba ka,</char> <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" /><char style="wj">mǝtala-ɓala mala mǝno yì guro ka nǝ̀ yiu a pwari mǝnana tsǝk ɓālǝi raka, a bu-pwari mǝnana pànǝ sǝlǝ raka.</char> <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><char style="wj">Nǝ̀ yia koè nǝ̀ kasǝki wi anpenye, sǝ nǝ̀ ramte atà amǝ'kúnɓárína, abanì sǝ à nǝ̀ nggǝ ɓua à nǝ̀ nggǝ nǝmggi munabuia.</char><verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Kanicau arǝ ansarina lum</para>
  <para style="pi">
    <verse number="1" style="v" sid="MAT 25:1" />
    <char style="wj">A bàkú mǝno ka à nǝ̀ kànì Domurǝm mala kùli arǝ ansarina lum mǝnana à twal apitǝla malea sǝ à puro à nǝ̀ ká kúllímúr bura-māfela ka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">25:1 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 12:35">Luk 12:35</ref>
      </char>.</note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" /><char style="wj">Aman tongno ateà ka à kwar ɗang, sǝ aman tongno ka à kwaro.</char> <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" /><char style="wj">Aman à kwar raka à twal apitǝla malea sǝ à twal ɓè mùrú a buià ɗàng.</char> <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" /><char style="wj">Sǝ aman à kwar ka à twal apitǝla malea andǝ mùrú arǝ adú a buià.</char><verse eid="MAT 25:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="MAT 25:5" />
    <char style="wj">Bura-māfela ka banì sauwa yiu tù ɗàng, nda ntulo aki ansarina man gandǝa à koa ntulo kat.</char><verse eid="MAT 25:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="MAT 25:6" />
    <char style="wj">Nǝ ɓá dù ka à ok tunǝban ama, &lt;&lt;Bura-māfela ndya kǝ yiu ka! Wu puro, wu yi kullì!&gt;&gt;</char><verse eid="MAT 25:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="MAT 25:7" />
    <char style="wj">Pǝlǝa ansarina mǝnia lo kat sǝ à kùtí a gilǝki apitǝla malea.</char> <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" /><char style="wj">Ansarina mana à kwar raka à banggi aman à kwar ka ama, &lt;&lt;Wu ɗàrǝa sǝm mùrú ma'wun; apitǝla ma'sǝm ndya à kǝ wu ka.&gt;&gt;</char><verse eid="MAT 25:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="MAT 25:9" />
    <char style="wj">Pǝlǝa amǝkware earia wia ama, &lt;&lt;Awo, mùrú ka pà nǝ̀ karǝ sǝm sǝnǝa wun ɗàng. Ndikǝna wu kya ban amǝme wu kúr ma'wun.&gt;&gt;</char><verse eid="MAT 25:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="MAT 25:10" />
    <char style="wj">Lang à nda njar aban ká kúr mùrú ka, bura-māfela yi tusǝo. Ansarina mana à do aɓa gilǝrǝu ka à kutio atà bura-māfela a ban li girlina isǝban. Pǝlǝa à gir kunɓala.</char><verse eid="MAT 25:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="MAT 25:11" />
    <char style="wj">Zuku ka acili ansarina nyarǝna. À wal kunɓala sǝ à loasǝ già à na ama, &lt;&lt;Ɓwamǝgule! Ɓwamǝgule! Mǝnba sǝm kunɓala!&gt;&gt;</char><verse eid="MAT 25:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="MAT 25:12" />
    <char style="wj">Bura-māfela earia wia ama, &lt;&lt;Ɓafo, ǝn súrǝ̀ wun ɗàng.&gt;&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">25:12 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 13:25">Luk 13:25</ref>
      </char>.</note><verse eid="MAT 25:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="MAT 25:13" />Pǝlǝa Yesu masǝlǝ cau ama: <char style="wj">Ace mǝnana ɓǝ̀ mǝnia ɓǝ̀ kǝa kum wun raka, wu do aɓa tsǝk mǝsǝ wun, acemǝnana wu súrǝ̀ pwari ko bu-pwari mala yiu mem ɗàng.</char><verse eid="MAT 25:13" /></para>
  <para style="s">Kanicau arǝ amǝ'túró-ɓala tàrú</para>
  <para style="pi">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="wj">Sǝ ɗǝm ngga Domurǝm mala kùli ka nǝ̀ yia pa kǝla ɓeɓwa mana lo nǝ̀ oa bǝri ka, tunǝ amǝ'túró-ɓala male sǝ nyinggia wia agirkuma male a buià.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">25:14 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="LUK 19:11-27">Luk 19:11-27</ref>
      </char>.</note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><char style="wj">Man mwashat atà amǝ'túró-ɓala male ka pe wi luru mǝsǝboalo tongno, sǝ ɓè ka pe wi luru ɓari, sǝ ɓè man ngga pe wi luru mwashat. Kārǝí arǝ rǝcandǝa mana sǝni ko yana ateà nǝ̀ gandǝ pak nǝ boale ka. Pǝlǝa bwal njar o. </char> <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" /><char style="wj">Mǝtúró-ɓala mǝnana à pe wi luru mǝsǝboalo tongno ka wario kya nggāliki nǝi, pǝlǝa kum mùr luru tongno amur amǝno. </char> <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" /><char style="wj">Mǝtúró-ɓala mǝnana ak luru mǝsǝboalo ɓari ka wari gbal kya kum mùr luru ɓari amur amǝno. </char> <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" /><char style="wj">Mala mǝnia yì mǝtúró-ɓala ak luru mǝsǝboalo mwashat ka, puro o kya tǝm nzali, sǝmbǝrǝ boalo mala mǝtala-ɓala male kàm.</char><verse eid="MAT 25:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="MAT 25:19" />
    <char style="wj">Ɓwamǝgule mala amuna-ɓala ka banì sauwa a bǝri, sǝ kya nyare yi kútí a bǝlta kusǝ gìr mana amǝ'túró-ɓala mǝno pang nǝ aboalo male mana a buià ka.</char> <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" /><char style="wj">Ɓwabura mana à pe wi luru mǝsǝboalo tongno ka yiu nǝ aɓea aluru tongno mana kumô amur amǝno ka. Bang ama, &lt;&lt;Ɓwamǝgule, a pam luru mǝsǝboalo tongno, sǝ ǝn nggāliki nǝi. Sǝni, ndya ǝn kum aɓea tongno amur amǝno ka.&gt;&gt;</char><verse eid="MAT 25:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="MAT 25:21" />
    <char style="wj">Ɓwamǝgule male ne wi ama, &lt;&lt;À pángŋǝ̀nà pepè, a nda mǝtúró-ɓala mǝɓoarne andǝ mǝ'mǝsǝcau nì! A lǝmdǝ mǝsǝcau arǝ agir bǝti. Mǝ nǝ nyinggo agir pas a buò. Yiu li banɓoarnado mala mǝtala-ɓala mò!&gt;&gt;</char><verse eid="MAT 25:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="MAT 25:22" />
    <char style="wj">Ɓwabura mǝnana à pè wi luru mǝsǝboalo ɓari ka yiu gbal sǝ na ama, &lt;&lt;Ɓwamǝgule, a pam luru mǝsǝboalo ɓari. Sǝni, ndya ǝn kum mùr luru ɓari amur amǝno a pam ngga.&gt;&gt;</char><verse eid="MAT 25:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="MAT 25:23" />
    <char style="wj">Ɓwamǝgule male ne wi ama, &lt;&lt;A pángŋǝ̀nà pepè, a nda mǝtúró-ɓala mǝɓoarne andǝ mǝ'mǝsǝcau nì! A lǝmdǝ mǝsǝcau arǝ agir bǝti. Mǝ nǝ nyinggo agir pas a buò. Yiu li banɓoarnado mala mǝtala-ɓala mò!&gt;&gt;</char><verse eid="MAT 25:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="MAT 25:24" />
    <char style="wj">Mǝtúró-ɓala mana ak luru mǝsǝboalo mwashat ka yiu sǝ na ama, &lt;&lt;Ɓwamǝgule, ǝn súrǝ̀o. We ka, a nda ɓwa mǝkwane kǝ̀rkǝ́r. A kǝ cancane a ban mǝnana we ka a ɓeal kam raka, a kǝ ramgya a ban mǝnana we ka a kwak mǝsǝɓeale kam raka.</char> <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" /><char style="wj">Ɓangciu pakkam nda ǝn kya sǝmbǝrǝ boalo mô a nzali ka. Sǝni, ndya ka, ak gìr mò.&gt;&gt;</char><verse eid="MAT 25:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="MAT 25:26" />
    <char style="wj">Mǝtala-ɓala male eari wi ama, &lt;&lt;We mǝtúró mǝɓealɓike, mǝnkundǝr nì! A sǝlǝna she ama ǝn nggǝ cancane a ban mǝnana ǝn ɓeal kam raka, sǝ ǝn nggǝ ramgya a ban mǝnana ǝn kwak mǝsǝɓeale kam raka?</char> <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" /><char style="wj">Sǝ ɓǝ̀ nda anggo ka, ɓoaro male ka a tsǝ́ngŋǝ̀nà boalo mem a ban amǝbanki, sǝ nyare mem kǝla man ngga ɓǝ ǝn kumǝna boalo mem nǝ múr amurí.&gt;&gt;</char><verse eid="MAT 25:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="MAT 25:28" />
    <char style="wj">Pǝlǝa mǝtala-ɓala bang ama, &lt;&lt;Wu ak luru mǝsǝboalo mǝno ka arǝì, wu pè ɓwa mǝnana ndanǝ aluru lum ngga.</char> <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><char style="wj">Ɓwa mana ndanǝi ka à nǝ̀ tsǝki wi ɓè amurí, sǝ nǝ̀ kum kpǝm. Sǝ ɓwa mana pànǝi raka, nggearǝ mǝnana a buì bǝti ka à nǝ̀ é arǝì.</char><note caller="+" style="f"><char style="fr" closed="false">25:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luk 8:18</ref></char>.</note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><char style="wj">Sǝ wu ramta mǝnia yì mǝtúró-ɓala mǝɓane ka a nza aɓa pǝndǝa, a ban mana nǝ̀ nggá ɓua sǝ nǝ̀ nggǝ nǝmggi amunabuì ka.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">25:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 8:12">Mat 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luk 13:28</ref></char>.</note><verse eid="MAT 25:30" /></para>
  <para style="s">Masǝlǝata Ɓashi</para>
  <para style="pi">
    <verse number="31" style="v" sid="MAT 25:31" />
    <char style="wj">A pwari mana Muna mala Ɓwa nǝ̀ yiu aɓa gulo male, andǝ amǝturonjar kat atè ka, nǝ̀ yia do amur buno-murǝm male.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">25:31 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="MAT 16:27">Mat 16:27</ref>; <ref loc="MAT 19:28">19:28</ref></char>.</note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><char style="wj">Ɓwapǝndǝa man kat a ɓanza ka nǝ̀ ramba a ɓadǝmbi, sǝ nǝ̀ gau aɓwana aɓalǝ aɓwana kǝla mana yalgir kǝ gau anzur aɓalǝ ambul-pǝndǝa ka.</char> <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" /><char style="wj">Nǝ̀ tsǝk anzur atà buì mǝlì, sǝ ambul-pǝndǝa ka atà buì mǝ'nggare.</char><verse eid="MAT 25:33" /></para>
  <para style="pi">
    <verse number="34" style="v" sid="MAT 25:34" />
    <char style="wj">Sǝ Murǝm nǝ̀ ne aman a buì mǝlì ka ama, &lt;&lt;Wu yiu, wun aɓwana mana tsǝkbu mala Tárrám nda múr wun ngga. Wu yi ak Domurǝm mana à gilǝki ace wun pur a tita ɓanza ka.</char> <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><char style="wj">Acemǝnana nzala walam, wu pam girlina. Mǝsamur walam, wu pam mùr-nùná. Mǝ nda bǝri, wu em a ɓala.</char> <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" /><char style="wj">Mǝ ndanǝ ɓatam, wu pam agir-nggūrǝu. Mǝ nda aɓa rǝkwana, wu tsǝkiram. Mǝ nda aɓa ndàkurban, wu yiua makkam kûn.&gt;&gt;</char><verse eid="MAT 25:36" /></para>
  <para style="pi">
    <verse number="37" style="v" sid="MAT 25:37" />
    <char style="wj">Sǝ amǝ'ɓealɓoarna nǝ̀ eari wi ama, &lt;&lt;Mǝtalabangŋo, a ya pwari sǝ sǝm sǝno nǝ nzala sǝ sǝm po girlina, ko nǝ mǝsamur sǝ sǝm po mùr-nùná?</char> <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" /><char style="wj">A ya pwari sǝ sǝm kumǒ a nda bǝri sǝ sǝm yinǝǒ a ɓala, ko nǝ ɓato sǝ sǝm po agir-nggūrǝu?</char> <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" /><char style="wj">A ya pwari sǝ sǝm kumǒ nǝ rǝkwana ko aɓa ndàkurban sǝ sǝm yiua sǝno?&gt;&gt;</char><verse eid="MAT 25:39" /></para>
  <para style="pi">
    <verse number="40" style="v" sid="MAT 25:40" />
    <char style="wj">Pǝlǝa Murǝm nǝ̀ nyesǝia wia ama, &lt;&lt;Ɓafo, ǝn nggǝ bangga wun, gìr mana kat wu pakki mwashat atà aɓwana mem, ko nggearǝ mǝnana à kǝ sǝni nda ɓwa mǝkyauwe mala aɓî ka, Mǝ nda wu pakkam ngga.&gt;&gt;</char><verse eid="MAT 25:40" /></para>
  <para style="pi">
    <verse number="41" style="v" sid="MAT 25:41" />
    <char style="wj">Pǝlǝa nǝ̀ ne aɓwana mana a buì mǝ'nggare ka ama, &lt;&lt;Wu upi banam, wun mǝnana Ɓakuli su wun ngga! Wu kya ɓá bǝsa mǝnana li male pà nǝ̀ mal raka, mǝnana à pè ace Shetan andǝ amǝturonjar male ka.</char> <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" /><char style="wj">Acemǝnana nzala walam, wu pam girlina ɗang. Mǝsamur walam, wu pam mùr-nùná ɗang.</char> <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" /><char style="wj">Mǝ nda bǝri, wu em a ɓala ɗàng. Mǝ ndanǝ ɓatam, wu pam agir-nggūrǝu ɗang. Mǝ nda aɓa rǝkwana, ɗǝm ngga mǝ nda aɓa ndàkurban, wu yi makkam kún ɗang.&gt;&gt;</char><verse eid="MAT 25:43" /></para>
  <para style="pi">
    <verse number="44" style="v" sid="MAT 25:44" />
    <char style="wj">Sǝ yia gbal ka à nǝ̀ ear ama, &lt;&lt;Mǝtalabangŋo, a ya pwari sǝ sǝm kumǒ aɓa nzala, ko aɓa mǝsamur, ko a nda bǝri, ko a ndanǝ ɓato, ko a nda aɓa rǝkwana, ko aɓa ndàkurban, sǝ sǝm ginǝ ɗenyi nǝ we?&gt;&gt;</char><verse eid="MAT 25:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="MAT 25:45" />
    <char style="wj">Yì ka, nǝ̀ earia wia ama, &lt;&lt;Ɓafo, ǝn nggǝ bangga wun, gìr mana kat wu ginǝ pakki mwashat atà aɓwana mem, ko nggearǝ mǝnana à kǝ sǝni nda ɓwa mǝkyauwe mala aɓî ka, Mǝ nda wu ginǝ pakkam ngga.&gt;&gt;</char><verse eid="MAT 25:45" /></para>
  <para style="pi">
    <verse number="46" style="v" sid="MAT 25:46" />
    <char style="wj">Pǝlǝa amǝnia ka à nǝ̀ tasǝia ɓǝà kùtí aɓa tanni mana málá male pà kàm raka, sǝ amǝ'cauɓoarna ka à nǝ̀ kùtí aɓa yilǝmu mana masǝlǝate pà kàm raka.</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">25:46 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="DAN 12:2">Dan 12:2</ref>
      </char>.</note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Aɓwana-mǝgule dapi <optbreak /> kunarǝia à nǝ̀ wal Yesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Markus 14:1-2</ref>; <ref loc="LUK 22:1-2">Luka 22:1-2</ref>; <ref loc="JHN 11:45-53">Yohana 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Lang Yesu malǝna banggi aɓwana amǝnia yì acau kat ka, pǝlǝa ne alaggana male ama, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><char style="wj">&lt;&lt;Wu sǝlǝna ama ueo nongŋo ɓari sǝ Lamsan Yàlîmurû nǝ̀ tite. Aɓalǝ amǝno yì apwari mala Lamsan ngga sǝ ɓeɓwa nǝ̀ nggá mak Muna mala Ɓwa, a bu aɓi-mǝbura, sǝ à nǝ̀ nggá gbàllì a nggun-gangndǝi.&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:1-27">Pur 12:1-27</ref></char>.</note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />A bàkú mǝno ka agbani pǝris andǝ aɓwana-mǝgule mala amǝ Yahudi yi rambǝa a palta mala pǝris mǝgule mana à tunǝki ama Kayafas ka, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />sǝ à kurkunarǝia ama à nǝ̀ bwal Yesu a sǝmbǝrǝa à nǝ̀ wal-luí. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Pǝlǝa à nea rǝia ama, &lt;&lt;Ɓǝ̀ sǝm ká pak gìr man a pwari Lamsan Yàlîmurû ɗang, ɓǝ̀ sǝm pa anggo ka aɓwana nǝ̀ loasǝ munǝo a la.&gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Ɓè ɓwama soapi Yesu <optbreak /> mùrú amurí</para>
  <para style="r">(<ref loc="MRK 14:3-9">Markus 14:3-9</ref>; <ref loc="JHN 12:1-8">Yohana 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Aɓa mǝno anggo ka Yesu na a Betani a ɓala mala mǝdakali man yì Shiman ngga. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Dumǝna aban lili, pǝlǝa ɓè ɓwama yiu a baní nǝ mùrú mǝ'rǝmɓoarne, mana boale pa bǝti raka, aɓa muna-du mǝnana à ɓè nǝ ɓekǝ tali mana à tunǝki ama alabasta ka, yi solǝì Yesu a ɓamúrí.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Lang alaggana mala Yesu sǝn mǝnia yì gìr ka bumia kiɗiki, à na ama, &lt;&lt;Palang sǝ ɓwama man kiɗiki mùrú man ani? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Ɓoaro male ka ɓǝ́ à mangŋǝ́nì amur boalo mǝgule, sǝ boale ka à nǝ̀ pè amǝ'tǝ̀r.&gt;&gt;<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesu sǝlǝnia cau mǝno kat pǝlǝa nea wia ama:</para>
  <para style="pi" vid="MAT 26:10">
    <char style="wj">Palang sǝ wu kǝ zurǝi bum ɓwama man? Yì ka, pàngŋǝ́nàm gìr mana mǝɓoarne na ka.</char> <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" /><char style="wj">Wu nda atarǝ wun wunǝ amǝ'tǝ̀r ko a ya pwari ka, sǝ mim ngga pa mǝ nǝ pa atà wun ko a ya pwari ka ɗang.</char><note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 15:11">Nggur 15:11</ref></char>.</note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" /><char style="wj">Mùrú mǝnia ɓwama man soapam a rǝàm ngga, soe ace gilǝki tsǝk luem.</char> <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" /><char style="wj">Ɓafo ǝn nggǝ bangga wun, ko a ya ban aɓa ɓanza kat à nǝ̀ hamnǝ Cau Amsǝban man kam ngga, à nǝ̀ bang ce gìr mǝnia ɓwama man pe ka, ace ɗenyi nǝi.</char><verse eid="MAT 26:13" /></para>
  <para style="s">Yahuda eare nǝ̀ mak Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Markus 14:10-11</ref>; <ref loc="LUK 22:3-6">Luka 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Pǝlǝa ɓè ɓwa mwashat atà alaggana male mǝnia lum-nong-ɓari, mǝnana à tunǝki ama Yahuda Iskariyoti ka, puro wari a ban agbani pǝris <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />sǝ ɗia ama, &lt;&lt;Mana wu nǝ̀ eare wu nǝ̀ pam mana ɓǝ̀ ǝn pa wun Yesu a bu wun ngga?&gt;&gt; Pǝlǝa à ɓal boalo zǝnariya mǝsǝì lumi-tàrú sǝ à pe wi. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Lo àkǝ̀ pwari mǝno ka Yahuda kùtí a alta njar mana nǝ̀ pana Yesu nǝi a buia ka.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesu li girlina Lamsan <optbreak /> Yàlîmurû andǝ <optbreak /> alaggana male</para>
  <para style="r">(<ref loc="MRK 14:12-21">Markus 14:12-21</ref>; <ref loc="LUK 22:7-13">Luka 22:7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohana 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />A pwari mana à tinata pakkiɗire mala Bǝredi Mana à Tsǝki Yist raka, alaggana mala Yesu yiu a baní sǝ à ɗì ama, &lt;&lt;A ya ban sǝ a kǝ earce ɓǝ̀ sǝm gilǝkio girlina Lamsan Yàlîmurû?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Wu kya ɓá nggea-là a ban ɓeɓwa nda kam, wu ne wi ama, &lt;Malǝm ama pwari mana Ɓakuli tsǝki wi ka gbashìnà, nǝ̀ li girlina Lamsan Yàlîmurû a ɓala mo andǝ alaggana male.&gt; &gt;&gt;</char> <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Alaggana mala Yesu o à kya pa kǝla mana banggia wia ka, à kya lam girlina Lamsan Yàlîmurû.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Lang adyan pwari kpana ka, yi do a ban li andǝ alaggana male lum-nong-ɓari. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />À nda a ban li ka, pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Ɓafo ǝn nggǝ bangga wun, ɓeɓwa aɓalǝ wun nǝ̀ nggá mem.&gt;&gt;</char><verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Ɓabumia zuriki kǝ̀rkǝ́r sǝ ko yana ka tita ɗie ama, &lt;&lt;Mǝ nda le Mǝtalabangŋo?&gt;&gt;<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesu nǝ̀ ear ka na ama, <char style="wj">&lt;&lt;Ɓwa mana oasǝ buì a kwar atàm ngga, ɓwe na nǝ̀ nggá mem ngga.</char><note caller="+" style="f"><char style="fr" closed="false">26:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 41:9">Ang 41:9</ref></char>.</note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><char style="wj">Muna mala Ɓwa ka nǝ̀ wú kǝla mǝnana à gilǝì amurí ka. Sǝama caukwanban na nǝ ɓwa mana nǝ̀ mak Muna mala Ɓwa ka! Kǝpǝna mǝnia yì ɓwa ka à ɓǝli raka.&gt;&gt;</char><verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Pǝlǝa Yahuda, mana nda nǝ̀ nggá me ka ɗì ama, &lt;&lt;Malǝm, Mǝ nda le?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Yesu eari wi ama, <char style="wj">&lt;&lt;E, a nda.&gt;&gt;</char><verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />À nda ban li girlina ka, Yesu twal bǝredi, pak yàwá pǝlǝa ɓwani, pè alaggana male sǝ nea wia ama, <char style="wj">&lt;&lt;Wu ang, wu li; mǝnia ka nggūrǝam na.&gt;&gt;</char><verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Pǝlǝa twal kwap mala mùr anap, pak yàwá sǝ pea wia, na ama, <char style="wj">&lt;&lt;Wu nu aɓalǝi, wun kat.</char> <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><char style="wj">Mǝnia ka nda nkílèm mala kùrcau mǝbǝshe, mǝnana à sukki ace twalban acauɓikea mala aɓwana pas ka.</char><note caller="+" style="f"><char style="fr" closed="false">26:28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 24:8">Pur 24:8</ref>; <ref loc="JER 31:31-34">Ir 31:31-34</ref></char>.</note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" /><char style="wj">Ən nggǝ bangga wun, pa mǝ nǝ nu mǝnia yì mùr-ɓǝlanggun anap ka ɗǝm ɗàng she a mǝno yì pwari mǝnana mǝ nǝ nuì bǝshe sǝnǝa wun a Domurǝm mala Tárrám ka.&gt;&gt;</char><verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Lang à tuna nggyal ka, à puro à o a nkono mala anggun Olif.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesu bang ama Bitǝrus nǝ̀ tǝmce</para>
  <para style="r">(<ref loc="MRK 14:27-31">Markus 14:27-31</ref>; <ref loc="LUK 22:31-34">Luka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Lang à nda amur nkono Olif ka, Yesu pǝlǝa ne alaggana male ama, <char style="wj">&lt;&lt;A ɓá dù man yalung ngga, wun kat wun nǝ̀ mǝsǝe, wun nǝ̀ ɗekiam. Mǝnia ka nda acemǝnana aɓa Malǝmce ka Ɓakuli bang ama:</char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">&lt;&lt; &lt;Mǝ nǝ wal yalgir,</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">sǝ anzur mana a </char></para>
  <para style="q1" vid="MAT 26:31">
    <char style="wj">domwan ngga</char></para>
  <para style="q2" vid="MAT 26:31">
    <char style="wj">à nǝ̀ mesǝke.&gt;</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">26:31 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="ZEC 13:7">Zak 13:7</ref>
      </char>.</note><verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />
    <char style="wj">Sǝ a nzǝm lo mem a ɓembe ka, mǝ nǝ akà wun dǝmba aban ká a Galili.&gt;&gt;</char><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Bitǝrus eari wi ama, &lt;&lt;Ko ɓǝ̀ aɓwana kat ɓangŋa à ɗekio ka, mim ngga pà mǝ nǝ ɓang ɗàng.&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesu nyesǝi wi ama, <char style="wj">&lt;&lt;Mǝsǝcau, ǝn nggǝ banggo, àkǝ̀ bu dù mǝnia ka, kaniama nggǔ nǝ̀ ɓua ka awu nǝ tǝmcem kusǝ tàrú.&gt;&gt;</char><verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Bitǝrus bang ama, &lt;&lt;Ko ɓǝ̀ mǝ nǝ wu sǝnǝ we ka, pà mǝ nǝ ɓinǝo ɗang.&gt;&gt; Sǝ acili alaggana gbal ka à bang anggo.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesu pak hiwi a Gefsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Markus 14:32-42</ref>; <ref loc="LUK 22:39-46">Luka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Pǝlǝa Yesu andǝ alaggana male o a ɓè ban mana à tunǝki ama Gefsemani ka, sǝ nea wia ama, <char style="wj">&lt;&lt;Wu duk kani, mim ngga mǝ nǝ ká akanó mǝ nǝ pak hiwi.&gt;&gt;</char> <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Tunǝ Bitǝrus andǝ amuna mala Zabadi ɓari, Yohana andǝ Jemis atè, sǝ tita pak bumkiɗikea, sǝ ɓabumi zuriki. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Bumkiɗikea mǝnana a yilǝmem ngga gul kǝ̀rkǝ́r kǝla nǝ̀ wal luem. Wu duk kani, wu dum nǝ amǝsǝ wun atàm.&gt;&gt;</char><verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Tùr a dǝmba bǝti ka, kya kùmsǝ nǝ ɓamǝsǝi a nzali, pak hiwi ama, <char style="wj">&lt;&lt;Dâ, ɓǝ̀ awu nǝ ear ka, twàlâm mǝnia yì tanni ka. Sǝama mani ka gìr mǝnana bumo kànì ka nda, mem na ɗang.&gt;&gt;</char><verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Nyare yiu a ban alaggana male yi kumia ka à nda ntulo. Ne Bitǝrus ama, <char style="wj">&lt;&lt;Pà wu nǝ̀ gandǝ do atàm nǝ mǝsǝ wun bu-pwari mwashat ɗang mbo?</char> <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><char style="wj">Wu duk nǝ amǝsǝ wun, sǝ wu pak hiwi, ace mǝnana wu kǝa kutio aɓa kārǝkiban raka. Bangŋo ma'wun kǝ earce nǝ̀ pak gìr mǝɓoarne sǝ nggūrǝu ka pà nǝ́ rǝcandǝa ɗàng.&gt;&gt;</char><verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Nyar ɗǝm o kya pak ɓaria hiwi ama, <char style="wj">&lt;&lt;Dâ, ɓǝ̀ mǝnia yì tanni ka a pà nǝ́ twalami raka, she ɓǝ̀ ǝn nuni ka, kànì mò ɓǝ̀ pa.&gt;&gt;</char><verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Nyare yiu abania, yi kumia ɗǝm ngga à nda ntulo; amburmǝsǝia dǝmbǝrikina. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Pǝlǝa nyia o kya pak tàruià hiwi; ɓǝsǝlǝ kǝ cau mǝ'mwashati.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Nyare yiu a ban alaggana male sǝ banggia wia ama, <char style="wj">&lt;&lt;Wu nda a ntulo più aban usǝlǝo? Wu sǝni, bu-pwari yina à ndo à nǝ̀ pà Muna mala Ɓwa a bu amǝ'cauɓikea.</char> <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" /><char style="wj">Wu lo, sǝm nǝ̀ umi! Ɓwa mǝnana mak Muna mala Ɓwa ka ndya kǝ yiu ka!&gt;&gt;</char><verse eid="MAT 26:46" /></para>
  <para style="s">À bwal Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Markus 14:43-50</ref>; <ref loc="LUK 22:47-53">Luka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Nda ɓá nacau più, Yahuda mǝnana nda aɓalǝ alaggana male man lum-nong-ɓari ka, yi tusǝo. Yiu andǝ aɓwana pas nǝ anggea-byau andǝ agara a buia. Agbani pǝris andǝ aɓwana-mǝgule mala amǝ Yahudi nǝ̀ tasǝia. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yì ɓwa mǝnana mé ka angŋa dǝmba kàninià wia gìr mǝnana nǝ̀ pa sǝ à nǝ̀ súrǝì ka ama, &lt;&lt;Ɓwa mǝnana mǝ nǝ makkìkun, mǝ nǝ kùrrì ka, ɓwe na, wu bwali.&gt;&gt; <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Yahuda gya yi kútí kporong a ban Yesu, ne wi ama, &lt;&lt;Malǝm, ǝn nggǝ makkòkun.&gt;&gt; Pǝlǝa yi mǝn abui kùr Yesu zǝp.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesu banggi wi ama, <char style="wj">&lt;&lt;Ɓiam, pàk gìr mǝnana yinǝ we ka.&gt;&gt;</char></para>
  <para style="p" vid="MAT 26:50">Pǝlǝa aɓwana mǝno yi gbami Yesu, à bwali kàngkàng. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Anggo ka, ɓeɓwa aɓalǝ aɓwana mǝnana atà Yesu ka, kwetǝ nggeabyau male kwarǝna ɓè guro mala pǝris mǝgule nǝi, kasǝ mburkiri kpat.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Yesu ne wi ama, <char style="wj">&lt;&lt;Nyesǝ nggeabyau mò oasǝi a ndè, acemǝnana ɓwa kat mana kǝ munǝ nǝ nggeabyau ka, nǝ nggeabyau sǝ à nǝ̀ wali.</char> <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" /><char style="wj">Wu kǝ sǝni kǝla pà mǝ nǝ gandǝ zǝmbi Tárrám, sǝ nǝ̀ tasǝam amǝturonjar pas àkǝ̀ dyadyan à nǝ̀ yia munǝo acem re?</char> <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" /><char style="wj">Sǝ ɓǝ̀ ǝn pa anggo ka, lang sǝ cau mǝnana Malǝmce mala Ɓakuli bangŋi ama nǝ̀ pa ana ka nǝ̀ lùmsǝo?&gt;&gt;</char><verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Yesu ne ɓwabundǝa mǝnana yiua bwale ka ama, <char style="wj">&lt;&lt;Wu yiu nǝ anggea-byau andǝ agara ace bwalam kǝla mǝ nda mǝyàl-nzongcau? Ko aya pwari ka ǝn nggǝ do aɓa Ndàmǝgule mala Ɓakuli aban kanigir, sǝ wu bwalam ɗang.</char><note caller="+" style="f"><char style="fr" closed="false">26:55 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char>.</note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" /><char style="wj">Sǝ mǝnia kat ka pâ ace lùmsǝ cau mǝnana amǝ'ɓangnǝa mala Ɓakuli gilǝa a Malǝmce male ka.&gt;&gt;</char></para>
  <para style="p" vid="MAT 26:56">Nda alaggana male kat ɓangŋa à ɗeki nǝmurǝì ka.<verse eid="MAT 26:56" /></para>
  <para style="s">À wari nǝ Yesu a ɓadǝmbǝ amǝ'ɓashi</para>
  <para style="r">(<ref loc="MRK 14:53-65">Markus 14:53-65</ref>; <ref loc="LUK 22:54-55">Luka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yohana 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Aɓwana mǝno à bwal Yesu ka à um nǝi a ban pǝris mǝgule, yì Kayafas. Akanó sǝ amǝkani Nggurcau mala Musa andǝ aɓwana-mǝgule yi dapia. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Bitǝrus ka kpata Yesu a nzǝ́mò kuko aban ká a ɓala mala Pǝris Mǝgule. Yi kutio sǝ do atà amǝ'yálban nǝ̀ sǝn gìr mana à nǝ̀ pakki Yesu ka.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Yia agbani pǝris andǝ acili aɓwana-mǝgule ka à ndarǝ alte à nǝ̀ kum cau nyir amur Yesu mǝnana à nǝ̀ kùmô à nǝ̀ wal-luí nǝi ka, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />sǝ kat andǝ mani ama aɓwana pas puro à banggi acau nyir amurí ka, à kum ko mwashat ɗang.</para>
  <para style="p" vid="MAT 26:60">A masǝlǝate ka aɓea ɓwana ɓari puro. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />À na ama, &lt;&lt;Mǝnia yì ɓwa ka bang ama yì ka, nǝ̀ gandǝ arki Ndàmǝgule mala Ɓakuli sǝ nǝ̀ nyare nǝ̀ ɓè aɓa nongŋo tàrú.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 2:19">Yoh 2:19</ref></char>.</note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Pǝris mǝgule pǝlǝa lo cam nǝ came sǝ ne Yesu ama, &lt;&lt;A panǝ cau mǝnana awu nǝ bang amur mǝno yì cau ka re? Mana nda ɓá mǝnia yì cau à kǝ ne a muro ka?&gt;&gt; <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Yesu duk kúni più.</para>
  <para style="p" vid="MAT 26:63">Pǝris mǝgule ne wi ama, &lt;&lt;Ən nggǝ kpapio wunǝ Ɓakuli Mǝyilǝmuì wu bangga sǝm ko a nda Kǝrǝsti, Muna mala Ɓakuli?&gt;&gt;<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesu eare ama, <char style="wj">&lt;&lt;E, kǝ nda a bang ngga, sǝ ǝn nggǝ bangga wun kat,</char></para>
  <para style="q1" vid="MAT 26:64">
    <char style="wj">&lt;&lt; &lt;A dǝmba ka wun nǝ̀ sǝn</char></para>
  <para style="q2" vid="MAT 26:64">
    <char style="wj">Muna mala Ɓwa dumǝna </char></para>
  <para style="q1" vid="MAT 26:64">
    <char style="wj">atà bù-mǝlì mala </char></para>
  <para style="q2" vid="MAT 26:64">
    <char style="wj">Ɓakuli Mǝtalabangŋo,</char></para>
  <para style="q1" vid="MAT 26:64">
    <char style="wj">aban yiu aɓalǝ apǝrɓang</char></para>
  <para style="q2" vid="MAT 26:64">
    <char style="wj">a bumkuli.</char>&gt;<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DAN 7:13">Dan 7:13</ref></char>.</note>&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Kara Pǝris mǝgule bwal daura male sannì<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="fq" closed="false">bwal daura male sannì </char><char style="ft" closed="false">ace lǝmdǝ bumkiɗikea mǝkǝ̀rkǝ́rnì.</char></note> sǝ na ama, &lt;&lt;Nyesǝna ɓamúrì kǝla Ɓakuli! Ya cau nani sǝm alkiyite amurí nǝ̀ kútí mǝnia? Wu ongŋǝna cau ɓǝsǝki Ɓakuli mǝnana pur a kúni ka. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mana nda ɗenyicau ma'wun?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">À pǝlǝa à eari wi ama, &lt;&lt;Kārǝ́na ɓǝà wali ɓǝ̀ wú.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">26:66 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 24:15">Pǝris 24:15</ref>,<ref loc="LEV 24:16">16</ref></char>.</note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Pǝlǝa à tàkki ntāra a ɓamǝsǝi sǝ à tulki nǝ abuia. Aɓea ɓwana ka à kwaki a takiri<note caller="+" style="f"><char style="fr" closed="false">26:67 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 50:6">Isha 50:6</ref></char>.</note> <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />sǝ à na ama, &lt;&lt;Bangga sǝm, we Kǝrǝsti, yana nda ɓwa mǝnana walo ka?&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Bitǝrus bang ama súrǝ̀ <optbreak /> Yesu ɗàng</para>
  <para style="r">(<ref loc="MRK 14:66-72">Markus 14:66-72</ref>; <ref loc="LUK 22:56-62">Luka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Anggo ka Bitǝrus nda nǝ́ nza aban do aɓa palta. Ɓè muna-ɓwama mǝtúró-ɓala yiu a baní, ne wi ama, &lt;&lt;We gbal ka wu nda tarǝ wun wunǝ Yesu, Ɓwa Galili.&gt;&gt;<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Sǝ Bitǝrus ka makgìr a ɓadǝmbǝ aɓwana kat ama, &lt;&lt;Awo, ǝn súrǝ̀ gir mǝnana a banggiyi cau amurí ka ɗàng.&gt;&gt;<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Pǝlǝa puro a kun palta. Ɓè muna-ɓwama ɗàng sǝni pǝlǝa ne aɓwana mǝnana a baní ka ama, &lt;&lt;Ɓwa man ɗiɗyal ka nda atà Yesu Ɓwa Nazarat.&gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Bitǝrus nyare makgìr ɗǝm nǝ kána ama: &lt;&lt;Awo, ǝn súrǝ̀ ɓwe mǝno ɗang!&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Zuku ka aɓwana mǝno à nda ban came a banì ka à sungŋo a ban Bitǝrus sǝ à ne wi ama, &lt;&lt;Mǝsǝcau, we ka a nda aɓalǝia, acemǝnana lasǝo lǝmdǝ ama a nda ɓwa Galili.&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Pǝlǝa Bitǝrus kángìr sǝ na ama, &lt;&lt;Ɓǝ̀ Ɓakuli ɓǝ̀ kiɗikiam mǝnana ɓǝà na ama ǝn súrǝ̀ mǝnia yì ɓwa ka!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Anggo ka kara nggù ɓua. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Nda ɓalǝ Bitǝrus kasǝa arǝ cau mǝnana Yesu banggi wi ka ama, <char style="wj">&lt;&lt;Kaniama nggǔ nǝ ɓua ka, a nǝ na kusǝ tàrú ama a súrǝàm ɗàng.&gt;&gt;</char> Pǝlǝa puro a nza kya ɓua, ɓuà mǝkwanbanì.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">À umnǝ Yesu a ɓadǝm Bilatus</para>
  <para style="r">(<ref loc="MRK 15:1">Markus 15:1</ref>; <ref loc="LUK 23:1-2">Luka 23:1-2</ref>; <ref loc="JHN 18:28-32">Yohana 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Lang ban kwarna adyan ngga, agbani pǝris kat andǝ aɓwana-mǝgule à yì dapi à kurkunarǝia amur Yesu à nǝ̀ wal-luí. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />À taka bui sǝ à um nǝi a ban Bilatus ɓwa Roma, nggwamna mala bu-nzali Yahudi.<verse eid="MAT 27:2" /></para>
  <para style="s">Yahuda gyar ɓamúrì</para>
  <para style="r">(<ref loc="ACT 1:18-19">Amǝ Mishan 1:18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Lang Yahuda mana mak Yesu sǝni à kasǝna ɓashi à nǝ̀ wal Yesu ka, pak bumkiɗikea, pǝlǝa nyesǝî agbani pǝris andǝ aɓwana-mǝgule mǝsǝboalo zǝnariya lumi-tàrú mana ak a buia ka.<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 1:18">Atúró 1:18</ref>,<ref loc="ACT 1:19">19</ref></char>.</note> <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Nea wia ama, &lt;&lt;Ən pángŋǝ̀nà cauɓikea, mana ǝn mak ɓwa mǝnana pàk ɓekǝ cauɓikea raka.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">À pǝlǝa à ne wi ama, &lt;&lt;Man oasǝ sǝm aɓa mǝno ka? Māna ka mona nǝmurǝo.&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Pǝlǝa Yahuda twal boale ka sukki a nzali aɓa Ndàmǝgule mala Ɓakuli, sǝ puro o kya ɗur nggúr a myali gyar ɓamur rǝì.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Agbani pǝris pwan boale sǝ à na ama, &lt;&lt;Nggurcau bang ama ɓoaro ɓǝà tsǝk ulang mǝnia yì boalo ka aɓa ndaboalo mala Ndàmǝgule mala Ɓakuli ɗang, acemǝnana boalo nkila na.&gt;&gt; <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />À naki acau amur boale, sǝ à masǝlǝate ka à na ama à nǝ̀ kurǝ́na nzali mala mǝɓaki-ankwaring nǝi ɓǝ̀ duk ɓembe tsǝk abǝri. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Nda gìr mǝnana tsǝa sǝ à kǝ tunǝ banì yalung ama, &lt;&lt;Nzali Nkila&gt;&gt; ka. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Mǝnia ka nda lùmsǝ ɓangnǝa mala Irimiya mǝnana ama,</para>
  <para style="q1" vid="MAT 27:9">À twal boalo zǝnariya</para>
  <para style="q2" vid="MAT 27:9">mǝsǝì lumi-tàrú,</para>
  <para style="q1" vid="MAT 27:9">boalo mǝnana amǝ Isǝrayila</para>
  <para style="q2" vid="MAT 27:9">kasǝa à nǝ̀ pa amurí ka,<verse eid="MAT 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 27:10" />nda à kurǝ́na nzali mala</para>
  <para style="q2" vid="MAT 27:10">mǝɓaki-ankwaring nǝi ka,</para>
  <para style="q1" vid="MAT 27:10">kǝla mǝnana Mǝtalabangŋo</para>
  <para style="q2" vid="MAT 27:10">bang ngga.<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ZEC 11:12-13">Zak 11:12-13</ref></char>.</note><verse eid="MAT 27:10" /></para>
  <para style="s">Bilatus ɗiki Yesu acau</para>
  <para style="r">(<ref loc="MRK 15:2-5">Markus 15:2-5</ref>; <ref loc="LUK 23:3-5">Luka 23:3-5</ref>; <ref loc="JHN 18:33-38">Yohana 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesu yi came a ɓadǝm Bilatus ɓwa Roma, nggwamna amur bu-nzali Yahudi. Nggwamna ɗì ama, &lt;&lt;A nda murǝm mala amǝ Yahudi le?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Yesu eari wi ama, <char style="wj">&lt;&lt;E, nda kǝla mǝnana a bang ngga.&gt;&gt;</char><verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Lang agbani pǝris andǝ aɓwana-mǝgule yi banggi acau à tsǝki Yesu arǝì ka, duk kúni più.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Bilatus pǝlǝa ɗì ama, &lt;&lt;A ok acau mana aɓwana man kǝ na a muro ama a pak ka re?&gt;&gt;<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Sǝ Yesu loasǝ kúni amur ko kǝ cau mwashat ɗang. Gìr nî pakki nggwamna gir'ndali.<verse eid="MAT 27:14" /></para>
  <para style="s">À kasǝi Yesu ɓashi-lú</para>
  <para style="r">(<ref loc="MRK 15:6-15">Markus 15:6-15</ref>; <ref loc="LUK 23:13-26">Luka 23:13-26</ref>; <ref loc="JHN 18:39-19:16">Yohana 18:39--19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ko a ya pwari Lamsan Yàlîmurû ka pàk ka nggwamna kǝ panzǝ mwashat atà apursǝna mana aɓwabundǝa earce ka. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />A bakú mǝno ka ɓè pursǝna ndakam lùllǝì ama Barabbas.<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">Aɓea malǝmce mana à gilǝia nǝ bu ka à tsǝa ama lùllǝì nda </char><char style="fqa" closed="false">Yesu Barabbas; </char><char style="ft" closed="false">anggo gbal a 27:17.</char></note> Aɓwana súrǝì pepè nggea kanggǝrang mǝyàl-nzongcau na. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Lang ɓwabundǝa yi ramǝna ka, Bilatus ɗia ama, &lt;&lt;Yana mwashat wu earce ɓǝ̀ ǝn panzǝa wuni: Barabbas na le ko Yesu mana à tunǝki ama Kǝrǝsti ka?&gt;&gt; <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Yì ka, sǝlǝna ama mɓali na tsǝk aɓwana-mǝgule sǝ à yiu nǝ Yesu a baní ɓǝ̀ pakki wi ɓashi ka.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Lang Bilatus na ban do amur buno ɓashi ka, māmí túrìban nǝ cau ama, &lt;&lt;Pusǝki abuo, nying ɓwa mǝno andǝa kunpwasǝa male, acemǝnana ǝn tanni a lòrǝo kǝ̀rkǝ́r yalung atàcau male.&gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Agbani pǝris andǝ aɓwana-mǝgule ka à ɓorikitakun aɓwabundǝa ama ɓǝà ear ama Barabbas na ɓǝà nyì, sǝ Yesu ka ɓǝà wal-luí.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Bilatus nyare ɗì ɓwabundǝa ɗǝm ama, &lt;&lt;Atà aɓwana man ɓari ka yana mǝ nyi ɓǝ̀ o le?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">À ear ama, &lt;&lt;Barabbas!&gt;&gt; <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Bilatus pǝlǝa ɗia ama, &lt;&lt;Sǝ Yesu mana à tunǝki ama Kǝrǝsti ka, mana ɓǝ̀ ǝn pang nǝi?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">À loasǝ già kat ama, &lt;&lt;Ɓǝà gbàllì a nggun!&gt;&gt;<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Bilatus ɗia ama, &lt;&lt;Ace mana? Ya cauɓikea nani pa?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Sǝ ɓwabundǝa loasǝ già kǝ̀rkǝ́r ama, &lt;&lt;Ɓǝà gbàllì a nggun!&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Lang Bilatus sǝni pà nǝ̀ gandǝ pak kǝgìr raka, sǝ ɗǝm ngga aɓwana ndo à nǝ̀ loasǝ munǝo a kusǝ ce ka, twal mùr lákkí abui a ɓamǝsǝ aɓwabundǝa. Na ama, &lt;&lt;Buam pa aɓa nkila mala mǝnia yì ɓwa ka ɗàng. Māna ka ma'wun na!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 21:6-9">Nggur 21:6-9</ref></char>.</note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Ɓwabunda kat ear ama, &lt;&lt;Ɓǝ̀ nkile do amur sǝm sǝnǝ amuna ma'sǝm!&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Bilatus pǝlǝa panzǝia wia Barabbas, sǝ Yesu ka tsǝa ɓǝà koè, pǝlǝa tasǝi a buia ɓǝà kya gbàllì a nggun.<verse eid="MAT 27:26" /></para>
  <para style="s">Asoje ɓangginǝ Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Markus 15:16-20</ref>; <ref loc="JHN 19:2-3">Yohana 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Asoje mala nggwamna twal Yesu a um nǝi a bantúró mǝgule malea sǝ à kya rambǝ acili asoje a kārì a ɓalǝu. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />À swárki wi adaura rǝì sǝ à túrì wi daura-murǝm mǝbangŋe. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />À alta zwe à tana jeko nǝi sǝ à oasǝi wi a ɓamúrí. À pè wi gara a buì mǝlì sǝ à ɓun a ɓadǝmbi à kǝ ɓangginǝi ama, &lt;&lt;Ɓǝ̀ rǝo pwalo, Murǝm mala amǝ Yahudi!&gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />À tàkki ntāra arǝì, pǝlǝa à ak gara mana a buì ka à walki nǝi a ɓamúrí. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Lang à ɓanggina nǝi ka pǝlǝa à swárì wi daura-murǝm mana à túrì wi ka, sǝ à nyesǝ amale à túrì wi arǝì. À kútí nǝi aban ká gbàlle.<verse eid="MAT 27:31" /></para>
  <para style="s">À gballì Yesu a nggun-gangndǝi</para>
  <para style="r">(<ref loc="MRK 15:22-32">Markus 15:22-32</ref>; <ref loc="LUK 23:27-43">Luka 23:27-43</ref>; <ref loc="JHN 19:17-27">Yohana 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Lang à purni ɓá nggea-là ka, à kya je andǝ ɓeɓwa mala nggea-là Sayirin, lùllǝì ama Shiman. À tsǝi púp ɓǝ̀ aki Yesu twal nggun-gangndǝi.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />À yì bik ban mǝnana à tunǝki ama Golgota ka (ban mala nkpoula ɓamuru). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Akanó à pè Yesu mùr-anap mana à zurǝì andǝ ɓe mùrgìr mǝ'lùlle ama ɓǝ̀ nui. Lang oè a kúni ka, ɓinǝi.<note caller="+" style="f"><char style="fr" closed="false">27:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:21">Ang 69:21</ref></char>.</note><verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Asoje pǝlǝa à gballì Yesu a nggun-gangndǝi sǝ à kocàca amur adaura male, à gakkia rǝia.<note caller="+" style="f"><char style="fr" closed="false">27:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:18">Ang 22:18</ref></char>.</note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Pǝlǝa à kya dum nǝ do a banì à yalí. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />À gilǝ cau mana à ɓashì wi nǝi ka sǝ à gbàllì arǝ nggun amurí, ama: ƁWA MƏNIA KA NDA YESU, MURƏM MALA AMƏ YAHUDI. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />À gbàllì Yesu andǝ aɓea aɓwana ɓari amǝ-akiagir mala aɓwana nǝ mazo, arǝ anggun-gangndi malea, mwashat a buì mǝlì sǝ ɓè a buì mǝ'nggare.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Aɓwana mana à kǝ kútí a njargula ka à sanggì, à pikimuria a mala oalban<note caller="+" style="f"><char style="fr" closed="false">27:39 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:7">Ang 22:7</ref>; <ref loc="PSA 109:25">109:25</ref></char>.</note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />à kǝ na ama, &lt;&lt;We ɓwan a nǝ arki Ndàmǝgule mala Ɓakuli sǝ a nǝ ɓè aɓa nongŋo-tàrú ka, amsǝ ɓamuro wuni ra. Ɓǝ̀ a nda Muna mala Ɓakuli ka, sùlǝî mur nggun-gangndǝi mana ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:40 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:61">Mat 26:61</ref>; <ref loc="JHN 2:19">Yoh 2:19</ref></char>.</note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Agbani pǝris andǝ amalǝm nggurcau andǝ aɓwana-mǝgule gbal ka à ɓangginǝi anggo. <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />A na ama, &lt;&lt;Yì ka, amsǝ aɓea ɓwana sǝ gandǝ amsǝ ɓamur rǝì ɗàng! Ɓǝ̀ yì nda Murǝm mala amǝ Isǝrayila ka, ɓǝ̀ sùlǝî múr nggun-gangndǝi man ado, sǝ sǝm nǝ̀ earnǝi. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Yì ka, gūlì arǝ Ɓakuli, sǝ na ama yì ka, Muna mala Ɓakuli na. Ɓǝ̀ Ɓakuli earce nǝ̀ amsǝi ka, ɓǝ̀ amsǝi ado sǝm nǝ̀ sǝni.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:43 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:8">Ang 22:8</ref></char>.</note><verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />Amǝ-akiagir mala aɓwana nǝ mazo man à gbàllia andǝi ka à ne wi acau mǝɓane gbal.<verse eid="MAT 27:44" /></para>
  <para style="s">Lú mala Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Markus 15:33-41</ref>; <ref loc="LUK 23:44-49">Luka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Nǝ bu-pwari lum-nong-ɓari mala pwari a kùli ka, kara pǝndǝa yi gir ban, yi pur a bu-pwari tàrú. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Lang à ndarǝ gbashi bu-pwari tàrú mǝno ka, Yesu loasǝ gì kpǝm na ama, <char style="wj">&lt;&lt;Eli, Eli, lama sabatani?&gt;&gt;</char> Ɓālǝi ama, <char style="wj">&lt;&lt;Ɓakuli mem, Ɓakuli mem, palang sǝ a pǝlǝàm nzǝmó?&gt;&gt;</char><note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 22:1">Ang 22:1</ref></char>.</note><verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Lang aɓea ɓwana mana à came a banì à ok Yesu ka, à na ama, &lt;&lt;Ndarǝ tunǝ Iliya.&gt;&gt;<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Ɓè ɓwa aɓalǝia ɓang tsuk-tsuk kya twal soso, parri aɓa mùr-anap mǝhangŋe pǝlǝa oasǝi a kun gara lǝmdǝì wi ama ɓǝ̀ nu.<note caller="+" style="f"><char style="fr" closed="false">27:48 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:21">Ang 69:21</ref></char>.</note><verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Acili aɓwana mǝno ka a na ama, &lt;&lt;Came sǝm nǝ̀ sǝni ko yakǝla Iliya nǝ̀ yiu nǝ̀ yia amsǝi.&gt;&gt;<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yesu nyar ɗǝm loasǝ gì ɓua nǝ rǝcandǝa, pǝlǝa yilǝmi purî rǝì.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Aɓa mǝno anggo ka kara lagir mǝnana à kasǝna ban mǝfele nǝi aɓa Ndàmǝgule mala Ɓakuli ka san a kùli kya bwal nzali, gau a ɓalǝu ɓari. Nzali dǝurǝo, atali arkia.<note caller="+" style="f"><char style="fr" closed="false">27:51 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 26:31-33">Pur 26:31-33</ref></char>.</note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Aɓembe mǝngya, sǝ aɓwana mala Ɓakuli mǝnana à wu ɗiɗyal ka, à lo nǝ yilǝmu. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />À purkî ɓalǝ aɓembe. Anzǝm lo mala Yesu a ɓembe ka, à yì kutio aɓa nggea-là mǝfele, à lǝmdǝ rǝia aban aɓwana pas.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Lang ɓwamǝgule mala asoje andǝ asoje mǝno à tamsǝia yál Yesu sǝn dǝurǝo mala nzali andǝ agir mana à kumban kat ka, ɓangciu pakkia wia kǝ̀rkǝ́r, sǝ à na ama, &lt;&lt;Ɓafo, ɓwa man ngga Muna mala Ɓakuli na.&gt;&gt;<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Amamǝna nda a banì pas mana à pur a Galili sǝ à yiu atà Yesu ace ɗenyi nǝi ka. À cam zak à kǝ sǝn gìr mǝnana kǝ kumban kat ka.<note caller="+" style="f"><char style="fr" closed="false">27:55 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>.</note> <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Maryamu Ɓwa Magdala, sǝ Maryamu nggea ka Jemis andǝ Yisǝfu, andǝ nggea ka amuna mala Zabadi, à ndakam aɓalǝ amamǝne.<verse eid="MAT 27:56" /></para>
  <para style="s">Tsǝkban Yesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Markus 15:42-47</ref>; <ref loc="LUK 23:50-56">Luka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Lang pwari kpana ka, ɓè mǝkume, ɓwa Arimatiya yiu. Lùllǝì ama Yisǝfu. Yì gbal ka mǝkpata Yesu na. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Kutio o a ban Bilatus kya zǝmba ɓǝà pè wi lú Yesu. Bilatus pǝlǝa bang ama ɓǝà pè wi. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yisǝfu ka twal lú Yesu sǝ marǝki aɓa lagir mǝpwasǝe mǝɓoarnsari <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />pǝlǝa tsǝi a ɓembe male mǝbǝshe mana tǝmi a nsoro tali ka. Ramgita nggea tali mǝtangŋe girna kun ɓembe nǝi pǝlǝa kutio o. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu Ɓwa Magdala andǝ ɓe Maryamu à yì do akanó a ɓadǝm ɓembe.<verse eid="MAT 27:61" /></para>
  <para style="s">À tsǝk asoje à yál <optbreak /> ɓembe mala Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Lang ban fa ka, nda pwari Sabbat, agbani pǝris andǝ amǝ Farisi yi ramba a ɓadǝm Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />À ne wi ama, &lt;&lt;Ɓwamǝgule, ɓalǝ sǝm kasǝa ama mana mǝno yì mǝ'swárki aɓwana ndanǝ yilǝmu ka, bang ama nongŋo tàrú a nzǝm lú male ka, nǝ̀ loapi ɓembe.<note caller="+" style="f"><char style="fr" closed="false">27:63 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:21">Mat 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>,<ref loc="MRK 10:34">34</ref>; <ref loc="LUK 9:22">Luk 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref></char>.</note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Nda sǝm ama wu tsǝa ɓǝà kǝ̀ yál ɓembe she ɓǝ̀ anongŋo tàrú lumsǝna ka. Ɓǝ̀ ana raka yakǝla alaggana male nǝ̀ yia iu lui sǝ à nǝ̀ banggi aɓwana ama long nǝ lo a ɓembe. Sǝ mǝnia yì swarkiban nǝnzǝ́mò ka nǝ̀ kútì mǝdǝmbe nǝ ɓike.&gt;&gt;<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Bilatus banggia wia ama, &lt;&lt;Wu kya tsǝk asoje ɓǝà yál ɓembe pepè aɓa njar mǝnana kat wu nǝ̀ gandǝ pe ka.&gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Pǝlǝa à o à kya tsǝk parbu mala murǝm amur ɓembe ace mǝnana ɓǝ̀ ɓwa je ka à nǝ̀ sǝlǝa, sǝ à tamsǝ asoje ɓǝà yál banì.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Ɓakuli loasǝ Yesu nǝ yilǝmu</para>
  <para style="r">(<ref loc="MRK 16:1-8">Markus 16:1-8</ref>; <ref loc="LUK 24:1-12">Luka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />A nzǝm pwari Sabbat, nǝ dǝmbari ɗiɗyal a pwari Ladi ka, Maryamu Ɓwa Magdala andǝ ɓe Maryamu waria sǝn ɓembe.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />Lang ngga, kara nzali dǝurǝo kǝ̀rkǝ́r. Mǝturonjar mala Mǝtalabangŋo pur a kùli yi sulǝo, ramta tali mana à girna kun ɓembe nǝi ka, pǝlǝa do amurí. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Rǝì kǝ ta gbǝang kǝla li'nzama mala mbulo; anggubyau male pwasǝ pwapwat kǝla buke. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Amǝ'yál ɓembe sǝni ka, rǝia ɓǝla nǝ nggea ɓangciu, sǝ à kya kpa nzali kǝla aɓwana mana à wuna ka.<figure style="fig" alt="An angel rolls the stone away fron entrance of the tomb and sits on it." file="WA03930b.tif" size="col" loc="MAT 28:4" copy="Wade images" ref="28:4">Mǝturonjar ramta tali mana à girna kun ɓembe nǝi ka, pǝlǝa do amurí.</figure><verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Mǝturonjar ne amamǝne ama, &lt;&lt;Ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Ən sǝlǝna ama wu nda ban alta Yesu mana à gbàllì a nggun ka. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Pa akani ɗang; Ɓakuli loasǝni nǝ yilǝmu, kǝla mǝnana bangga wun ngga. Wu yiu wu yi sǝn ban mana nong kam ngga. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Sǝ wu nyare a kaurǝa wu kya ne alaggana male ama, &lt;Longŋǝna nǝ yilǝmu, ɗǝm ngga nda akà wun dǝmba kǝ ká a Galili ka. Wun nǝ̀ nggá sǝni akanó.&gt; Ɓalǝ wun ɓǝ̀ kasǝa ama ǝn bangŋǝna wun ngga.&gt;&gt;<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Amamǝna man nying ɓembe tsuk-tsuk. Ɓangciu pakkia wia sǝ bumia pwasǝ kǝ̀rkǝ́r. À ɓangŋa à nǝ̀ nggá banggi alaggana male ce. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />À nda njar aban ká ka, kara Yesu yi kasǝa a dǝmbia, nea wia ama, <char style="wj">&lt;&lt;Ən nggǝ makka wun kun.&gt;&gt;</char> À pǝlǝa à yiu a baní tù, à yì kurrì zǝp arǝ akusǝi, sǝ à peri. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesu pǝlǝa nea wia ama, <char style="wj">&lt;&lt;Ɓangciu ɓǝ̀ kǝa pakka wun ɗàng. Wu kyane wu kya ne amǝ'eambam ɓǝà o a Galili, à nǝ̀ nggá sǝnam kam.&gt;&gt;</char><verse eid="MAT 28:10" /></para>
  <para style="s">Cau mana amǝ'yál ɓembe bang ngga</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Lang amamǝna man nda ban o ka, aɓea amǝ'yálban mǝnana à cia yál ɓembe ka, à o aɓa nggea-là à kya banggi agbani pǝris ce gìr mǝnana kumban kat ka. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Agbani pǝris andǝ aɓwana-mǝgule ramba à kurkunarǝia. À twal nggea boalo mǝgule à pea soje. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />À nea wia ama, &lt;&lt;Wu bang ama wu nda ntulo nǝ du sǝ alaggana male yiu à yì iuwi à um nǝi. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Ko ɓǝ̀ nggwamna<note caller="+" style="f"><char style="fr" closed="false">28:14 </char><char style="fq" closed="false">nggwamna: </char><char style="ft" closed="false">Buntu Bilatus</char></note> ok ce ka, sǝm nǝ̀ nggá oasǝkì cau arǝì pà nǝ̀ pakka wun kǝgìr ɗàng.&gt;&gt; <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Pǝlǝa asoje ak boalo sǝ à kpata cau man gbal à banggia wia ka. Mǝnia yì cau ka aki kún amǝ Yahudi yi pur a yalung.<verse eid="MAT 28:15" /></para>
  <para style="s">Túró mǝgule mana Yesu pè <optbreak /> alaggana male ka</para>
  <para style="r">(<ref loc="MRK 16:14-16">Markus 16:14-16</ref>; <ref loc="LUK 24:36-49">Luka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20:19-23</ref>; <ref loc="ACT 1:6-8">Amǝ Mishan 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Alaggana man lum-nong-mwashat ka à kutio à o a Galili, amur nkono mana Yesu banggia wia ama ɓǝà kyan kam ngga.<note caller="+" style="f"><char style="fr" closed="false">28:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref></char>.</note> <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Lang à sǝni ka, à ɓun a ɓadǝmbi à peri; sǝama aɓea aɓwana ateà ka à ear ama Yesu na ɗang. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesu pǝlǝa yiu a bania sǝ na ama:</para>
  <para style="pi" vid="MAT 28:18">
    <char style="wj">&lt;&lt;Rǝcandǝa mǝnana a kùli andǝ mana a ɓanza kat ka Ɓakuli panami!</char> <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><char style="wj">Ace mǝno ka, wu kyane a ban ɓwapǝndǝa arǝ anzali kat, wu yinǝia ɓǝà pǝlǝ amǝkpatam. Wu pakkia wia batisǝma aɓa lullǝ Ɓakuli Tárrû, andǝ mala Muni, andǝ mala Bangŋo Mǝfele.</char><note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 1:8">Atúró 1:8</ref></char>.</note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><char style="wj">Wu kania wia ɓǝà kpata agir mana kat ǝn bangga wun ngga. Mǝ nda atà wun kàngkàng a koya pwari ka, bà masǝlǝata ɓanza.&gt;&gt;</char><verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>