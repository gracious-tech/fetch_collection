<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Mbula</book>
  <para style="h">2 Yohana</para>
  <para style="toc3">2Yoh</para>
  <para style="toc2">2 Yohana</para>
  <para style="toc1">Ɓaria Cauterǝa mala Yohana</para>
  <para style="mt2">Ɓaria Cauterǝa mala</para>
  <para style="mt1">YOHANA</para>
  <para style="imt">Mǝncau</para>
  <para style="ip">
    <char style="bk">Ɓaria Cauterǝa mala Yohana</char> ka ɓe ɓwamǝgule amur amǝkwaɗi nǝ gilǝì aban ká aban ɓe ndahiwi andǝ amǝkpata Yesu mǝnana aɓalǝi ka. Mǝnia yì cau mgbeatuk ka zǝmba na ace earce rǝarǝu andǝ nunkiru arǝ amalǝm mǝ'nyir nì andǝ akanìgìr malea.</para>
  <para style="iot">Agir mǝnana aɓalǝi ka</para>
  <para style="io1">Mǝncau<char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">Gulo mala earcearǝu<char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">Nunkiru arǝ kanigir mǝ'nyir nì<char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">Masǝlǝatacau<char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">Makkun</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Mǝnia yì cauterǝa ka, pur nǝ banam, mim jamgula Yohana aban ká a ban Nggeaka amuna mǝnana Ɓakuli tárì, andǝ amuni,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Nggeaka amuna mǝnana Ɓakuli tárì, andǝ amuni: </char><char style="ft" closed="false">Mǝnia ka yakǝla ɓe ikǝlisiya na andǝ amǝkwaɗi mǝnana aɓalǝi ka.</char></note> mǝnana ǝn earcea nǝ mǝsǝcau ka. Mǝ nda nǝmurǝam ǝn earkiyi ace wun ngga ɗàng, sǝm nda kat sǝnǝ aɓwana mǝnana à sùrǝ́nà rǝ mǝsǝcau ka. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Sǝm nggǝ earce wun àkǝ̀ ce mǝsǝcau mǝnana nda aɓalǝ sǝm, sǝ nǝ̀ do atà sǝm, málá male pà kàm raka.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Ɓǝ̀ ɓwamuru, andǝ mǝsǝswatǝr, andǝ dorǝpwala mala Ɓakuli Tárrú andǝ Yesu Kǝrǝsti, Muna male, do atà sǝm aɓa mǝsǝcau andǝ earcearǝu.<verse eid="2JN 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Banɓoaram kǝ̀rkǝ́r, yi mǝnana ǝn kum aɓea amunio aban do aɓa mǝsǝcau, kǝla mǝnana Ɓakuli Tárrú tsǝka sǝmi ka. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Adyan ngga, we Nggeaka amuna, ǝn nggǝ zǝmbǝo, ɓǝ̀ sǝm earce rǝarǝ sǝm. Mǝnia ka bǝsa nzongcau na ǝn nggǝ gilǝa wun ngga ɗang; nda kǝ nzongcau mǝnana sǝm ndanǝi a tite ka.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 13:34">Yoh 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char>.</note> <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Mǝnia yì earcearǝu ǝn nakiyi cau amurí ka ɓālǝi nda mǝnana ama ɓǝ̀ sǝm dumnǝ okiru arǝ anzongcau mala Ɓakuli. Kǝla mǝnana wu ok a tadǝmbe ka, nzongcau nì nda mǝnana ama, wu kǝ gya aɓa earcearǝu.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Ən bang mǝnia ka acemǝnana amǝ swarkiban pas mana à ear ama Yesu Kǝrǝsti yiu aɓa nggūrǝu raka, à kutina a ɓanza. Ɓwa kǝla ulang amǝno ka, mǝ'swarkiban na sǝ ɓimǝbura mala Kǝrǝsti na. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Wu tsǝkir wun, ace mǝnana wu kǝa ɗwanyi tangnakusǝu túró ma'wun ɗang. Wu ak tangnakusǝ wun ɗǝɗak. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Ɓwa mǝnana yàl-nzong aban ká dǝmba, kpata mǝnia yì kanigir mala Kǝrǝsti raka, súrǝ̀ Ɓakuli ɗang. Sǝ ɓwa mǝnana lidǝmba aɓa kanigir mala Kǝrǝsti ka, nda aɓa dotarǝu andǝa Ɓakuli Tárrú andǝ Muni. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Ɓǝ̀ kǝɓwa yiu aɓa kpapi ma'wun, sǝ yiu nǝ mǝnia yì kanigir raka, wu kǝa é arǝ aɓala ma'wun, ko wu tsǝiandà ɗang. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Ɓwa mǝnana kat ak mǝnia yì ɓwa ka, oasǝna buì aɓa túró ɓealɓikea male.<verse eid="2JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Mǝ ndanǝ acau mǝnana ǝn earce mǝ nǝ na wun ngga, sǝ ǝn earce mǝ nǝ gilǝia nǝ gilǝe ɗang. Acemǝnana mǝ ndanǝ tsǝkɓalǝu mala yiu aban wun tù, sǝ mǝ nǝ yia na wun nǝ nggearǝam, ace mǝnana ɓǝ̀ banɓoarnado ma'sǝm lùmsǝo.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Amuna mala mǝ'nggauleo<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">Amuna mala mǝ'nggauleo: </char><char style="ft" closed="false">Amǝnia ka à nda ka amǝkwaɗi mǝnana aɓa ikǝlisiya mǝnana mǝgilǝgir mǝnia pak kam ngga.</char></note> mǝnana Ɓakuli tárì ka, à kǝ makko kun.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>