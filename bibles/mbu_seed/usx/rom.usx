<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Mbula</book>
  <para style="h">Amǝ Roma</para>
  <para style="toc3">Rom</para>
  <para style="toc2">Amǝ Roma</para>
  <para style="toc1">Cauterǝa mala Bulǝs aban ká a ban amǝ Roma</para>
  <para style="mt2">Cauterǝa mala Bulǝs aban ká a ban</para>
  <para style="mt1">AMƏ ROMA</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Cautera mala Bulǝs aban ká aban amǝ Roma </char> ka Bulǝs gilǝì ace bǝlki ɓá bwaltagir male amur paɓamuru mǝnana ndakam aɓa kpata Kǝrǝsti, andǝ gir mana mǝnia yì paɓamuru kǝ yinǝi aɓa do mala amǝkwaɗi ka. Mugulacau ka nda mǝnana ama, ɓwapǝndǝa kat ka à nda aɓa ɓealu mǝɓane mala <char style="bk">cauɓikea</char> sǝ àwá pà kàm ɗàng. Ɗǝm ngga, sǝm kat ka sǝm nda ka amǝ'cauɓikea aɓadǝm Ɓakuli, kun nacau pà kàm a bu sǝm ɗàng. Sǝama Ɓakuli gilǝkina njar mala purî ɓá mǝnia yì ɓealu nggea mǝɓike andǝ mǝpà ɓangciunì ka, mǝnana yi túr Muni Yesu ɓǝ̀ yi wú ace acauɓikea ma'sǝm ngga. Nǝ́ <char style="bk">ɓwamuru</char> male ka, Ɓakuli kǝ twal sǝm, sǝm mǝnana sǝm pa ɓamuru aban Kǝrǝsti ka, sǝm nda ka amǝ'cauɓoarna a baní. Nǝ́ paɓamuru ka, dupǝna sǝm púp ɓǝ̀ sǝm ak mǝnia yì ɓoro mala Ɓakuli, sǝ ɓǝ̀ sǝm tita <char style="bk">dukdo mala amǝ kpata Kǝrǝsti.</char> Mǝnia yì Cau Amsǝban mǝgule ka dumǝna púp à nǝ̀ hamnǝi a koya ban, aban aɓwana aɓa ɓanza kat.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Aɓwana mǝnana amǝ Yahudi na raka andǝ cauɓikea<char style="ior"><ref loc="ROM 1:1-32">1:1-32</ref></char></para>
  <para style="io1">Amǝ Yahudi andǝ cauɓikea<char style="ior"><ref loc="ROM 2:1-29">2:1-29</ref></char></para>
  <para style="io1">Njar amsǝban mala Ɓakuli<char style="ior"><ref loc="ROM 3:1-4:25">3:1--4:25</ref></char></para>
  <para style="io1">Paɓamuru andǝ nggurcau<char style="ior"><ref loc="ROM 5:1-21">5:1-21</ref></char></para>
  <para style="io1">Bǝsa yilǝmu aɓa Kǝrǝsti<char style="ior"><ref loc="ROM 6:1-21">6:1-21</ref></char></para>
  <para style="io1">Bangŋo Mǝfele aɓa do mala mǝkwaɗi<char style="ior"><ref loc="ROM 8:1-17">8:1-17</ref></char></para>
  <para style="io1">Isǝrayila aɓa kàni mala Ɓakuli<char style="ior"><ref loc="ROM 9:1-11:32">9:1--11:32</ref></char></para>
  <para style="io1">Ɓealǝu mala amǝkwaɗi<char style="ior"><ref loc="ROM 12:1-15:13">12:1--15:13</ref></char></para>
  <para style="io1">Masǝlǝata cau andǝ makkiakun<char style="ior"><ref loc="ROM 15:14-16:27">15:14--16:27</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">Makkun mala Bulǝs</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Mǝnia yì cauterǝa ka pur nǝban Bulǝs, guro mala Kǝrǝsti Yesu, mǝnana Ɓakuli tunǝi ɓǝ̀ duk mǝ'mishan, sǝ tàrrì ace túró hamnǝ bǝsa Cau Mǝɓoarne mala Ɓakuli ka. <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />Ɓakuli pacau ace mǝnia yì Cau Amsǝban ngga, ɓara-ɓara nǝban amǝ'ɓangnǝa male aɓa Malǝmce Mǝfele. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Cau Amsǝban ngga, ndá amur Muni, mǝnana do ɓanza male ka à ɓǝli a tàu mala Dauda. <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />Sǝ à yì lǝmdǝí, Muna mala Ɓakuli na, nǝ loasǝo mǝnana à loasǝi a ɓembe nǝ rǝcandǝa mala Bangŋo Mǝfele ka. Yì nda Yesu Kǝrǝsti Mǝtala sǝm.<verse eid="ROM 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 1:5" />Nǝ ban Kǝrǝsti sǝ Ɓakuli pa sǝm ɓwamuru andǝ ɓoro mala do mǝ'mishan, ɓǝ̀ sǝm ne aɓwana arǝ anzali a koya ban ngga, gìr mǝnana Ɓakuli pa acea ka, ace mǝnana ɓǝà paɓamuria, ɓǝà oki wi sǝ anggo ka lùllǝì ɓǝ̀ kum gulo.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 26:16-18">Atúró 26:16-18</ref>; <ref loc="ROM 15:17">Rom 15:17</ref>; <ref loc="GAL 2:7">Gal 2:7</ref>,<ref loc="GAL 2:9">9</ref></char>.</note> <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Wun ngga, wu nda aɓalǝ aɓwana mǝnana à tunǝia ɓǝà duk amala Yesu Kǝrǝsti ka.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Ən nggǝ gilǝa wun, wun kat a Roma, mǝnana Ɓakuli earce wun sǝ tunǝ wun ɓǝ̀ wu duk amale ka.</para>
  <para style="p" vid="ROM 1:7">Ɓǝ̀ Ɓakuli Tár sǝm andǝ Mǝtalabangŋo Yesu Kǝrǝsti, pa wun ɓwamuru andǝ dorǝpwala.<verse eid="ROM 1:7" /></para>
  <para style="s">Bulǝs earǝna cè ká Roma</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />A tite ka, ǝn nggǝ pakki Ɓakuli mem yàwá nǝban Yesu Kǝrǝsti ace wun kat, acemǝnana paɓamuru ma'wun a baní ka, ɓanza kat ongŋǝna cè. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Ɓakuli mǝnana ǝn nggǝ pakki wi túró nǝ ɓabumam kat, aɓa hamnǝ Cau Amsǝban mala Muni ka, nda mǝ'nakunam ama ǝn nggǝ pakhiwi ace wun tùtù. <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Aɓa hiwi mem koya pwari ka, ǝn nggǝ zǝmba ɓǝ̀ Ɓakuli ear ka, ko ɓǝ̀ lang ngga ɓǝ̀ ǝn kum njar a masǝlǝate ɓǝ̀ ǝn kya aban wun.<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />Mim ngga ǝn earce kǝ̀rkǝ́r a ɓabumam ɓǝ̀ ǝn kya sǝn wun, ɓǝ̀ ǝn pa wun aɓoro ɓá Bangŋo mǝnana nǝ̀ pa wun rǝcandǝa ka. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Gìr mana ǝn nakiyi ka nda mana ama, ǝn nggǝ earce ɓak ɓabum wun nǝ paɓamuru mem, sǝ mim gbal ka mǝ kum ɓakɓabum nǝ ma'wun yì paɓamuru.<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />Wun amǝ'eambǝam, ǝn nggǝ earce ɓǝ̀ wu sǝlǝ ama ǝn kànì a ɓabumam kusǝ pas mǝ nǝ ká a sǝn wun, sǝ ǝn kum njar ɗàng, bà ado. Ən nggǝ earce yinǝ aɓwana aɓalǝ wun aban Yesu, kǝla mǝnana ǝn kum aɓea aɓwana aɓalǝ akún arǝ aɓea anzali ka.<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 19:21">Atúró 19:21</ref></char>.</note><verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />Dumǝnam púp ɓǝ̀ ǝn pakki amǝ Gǝrik andǝ aɓwana mǝnana amǝ Gǝrik na raka túró, amǝ sǝlǝe andǝ amǝ ɗwanyi sǝlǝe. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Ace mani ka, ɓabumam kǝ pi arǝ ká aban wun gbal, wun mǝnana aɓa Roma ka, ɓǝ̀ ǝn kya hamnǝ Cau Amsǝban.<verse eid="ROM 1:15" /></para>
  <para style="s">Rǝcandǝa mala Cau Amsǝban <optbreak /> mala Ɓakuli</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Mim ngga kǝsǝkya kǝ pakkam arǝ Cau Amsǝban mala Kǝrǝsti ɗàng, acemǝnana mǝnia ka rǝcandǝa mala Ɓakuli na ace amsǝ aɓwana mana à paɓamuria ka, tite nǝ ɓwa Yahudi, sǝ ɓwa mǝnana ɓwa Yahudi na raka.<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 8:38">Mar 8:38</ref>; <ref loc="1CO 1:18">1Kor 1:18</ref>,<ref loc="1CO 1:24">24</ref></char>.</note> <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Yì Cau Amsǝban ngga, ndá kǝ̀ lǝmdǝa sǝm lang sǝ Ɓakuli kǝ nggaɗi sǝm, ɓǝ̀ sǝm pǝlǝ aɓwana amǝɓoarne a ɓadǝmbi. Mǝnia ka kǝ pa anggo nǝ gūlì arǝ Kǝrǝsti, twal a tite kya pur a masǝlǝate, kǝla mǝnana Malǝmce na ka ama: &lt;&lt;Ɓwa mǝnana kumǝna akban aban Ɓakuli ka, nǝ̀ dumnǝ yilǝmu aɓa gūlì arǝ Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="fq" closed="false">nǝ̀ dumnǝ yilǝmu aɓa gūlì arǝ Ɓakuli: </char><char style="ft" closed="false">Ko: &lt;&lt;nǝ̀ dukdo gūlì arǝ Ɓakuli.&gt;&gt;</char></note>&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HAB 2:4">Hab 2:4</ref></char>.</note><verse eid="ROM 1:17" /></para>
  <para style="s">Bumlulla mala Ɓakuli <optbreak /> amur cauɓikea</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Ɓakuli kǝ lǝmdǝ bumlulla male nǝ kuli amur amǝ'cauɓikea andǝ amǝ'ɓealɓikea mǝnana à kǝ par mǝsǝcau nǝ aɓealɓikea malea ka, <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />acemǝnana gir mana ɓoaro ɓǝa súrǝì amur Ɓakuli ka, sǝmbǝrǝia wia ɗàng. Ɓakuli ka lǝmdǝnia wia a banfana. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Ɗiɗyal mǝnana Ɓakuli pusǝ ɓanza ka, ɓwapǝndǝa sǝnǝna nzali andǝ kuli. Nǝ agir mǝnana Ɓakuli pea ka, à sǝnǝna aɓǝalu male bwāng, kǝla rǝcandǝa male mana kǝ mal raka, andǝ pǎ male mala Ɓakuli. Ace mani ka, à pànǝ kun nacau ace ɗwanyi súrǝ̀ Ɓakuli ɗang ko bǝti!<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />E, à sùrǝ́nà Ɓakuli, sǝ à ɓinǝ peri a baní kǝla Ɓakuli, à kǝ pakki wi yàwá ɗang. A kun mani ka, ɗenyicau malea pǝlǝ mǝɓane, sǝ ɓabumia do a pǝndǝa.<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 4:17">Afi 4:17</ref>,<ref loc="EPH 4:18">18</ref></char>.</note> <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />A nê malea ka, à nda ka amǝ'sǝlǝe, sǝama yia ka, à kwar ɗang. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Amur mǝnana ɓǝà peri aban Ɓakuli mǝɓoarɓwe mǝnana nǝ yilǝmu málá male pà kàm raka, à kara à kutia peri aban aɓǝ̀nzál mǝnana à pea kǝla ɓwapǝndǝa andǝ anyal, andǝ agirkusǝu andǝ agir-nzali ka.<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:16-18">Nggur 4:16-18</ref>; <ref loc="ACT 17:29">Atúró 17:29</ref></char>.</note><verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Ace mani ka, Ɓakuli vwaki buì a rǝia aɓa pakkia agir ɓeami malea mala nonggi nǝ rǝarǝu, mǝnana ɓabumia earkiyi ce ka, sǝ à kutia pakkia agir kǝsǝkya arǝarǝia. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Yia ka à nggaɗi mǝsǝcau mala Ɓakuli nǝ nyir, sǝ à kǝ peri aban agir mǝnana Ɓakuli pusǝia ka. À ɗeki nggearǝ Ɓakuli mǝnana pusǝ agir kat, mǝnana ɓoaro ɓǝà kpate, ɓǝà ɓwangsǝi bà ka! Ɓǝ̀ do anggo.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Acemǝnana à pa anggo ka, nda Ɓakuli nyia aɓalǝ anpel mala agir kǝsǝkya malea. Nggearǝ amamǝna malea ka à nying dolabura, à kǝ pak ɓwama nǝ rǝarǝia. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Anggo gbal sǝ aburana nying nongŋo nǝ amālea, à kútí aban nonggi nǝ rǝarǝia. Aburana kǝ pak agir kǝsǝkya nǝ rǝarǝia. Nda gìr mǝnana tsǝa sǝ à nunbi ɓamuria ɓashi andǝ tanni, atàcau mala mǝno yì agir mǝɓane mǝnana à kǝ pakkia ka.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Acemǝnana amǝno yì aɓwana ka à ɓinǝ pak túró nǝ sǝlǝe mala Ɓakuli ka, Ɓakuli nyia gbal andǝ aɗenyicau mǝɓane malea, ɗekia ɓǝà pakkia agir mǝnana ɓoaro ɓǝà pea raka. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Yia ka, do malea lùmsǝ nǝ koya ulang túró ɓealɓikea, andǝ mɓali, andǝ ɓinǝmuru andǝ mwararǝu, andǝ walki-alú, andǝ munǝki-amunǝo, andǝ swarkiban, andǝ ce'shiria, andǝ twal lullǝú. <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />Yia ka à kǝ nacau mǝɓane anzǝm aɓwana, amǝɓinǝ mur Ɓakuli na, à kǝ okban ɗang, à ndanǝ twalmuru, andǝ nggori. Ɗenyicau malea ka nda aɓa pusǝki abǝsa njar mala pakkia agir mǝɓane, sǝ à kǝ okî amǝɓǝlia ɗàng. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />À pànǝ ɓabum ɗang, à kǝ lumsǝ cau malea mǝnana à ne ka ɗàng. Yia ka à lǝmdǝkiyi pěmǝɓoarne ɗàng, sǝ à pànǝ mǝsǝswatǝr arǝ aɓwana ɗàng. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />À sǝlǝna ama nzongcau mala Ɓakuli bang ama, aɓwana mǝnana à kǝ pakkia ulang amǝnia yì agir ka, à nǝ̀ ká lú. Sǝ kat andǝ sǝlǝe mǝno ka, à go amur pakkia agir nì nǝmurǝia ɗàng, à kǝ earnǝ aɓwana mǝnana à kǝ pakkia agir nì ka.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Ɓashi mǝɓafoe mala Ɓakuli <optbreak /> amur cauɓikea</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />We ka, a kǝ twali ama a nǝ́ pakki amǝno yì aɓwana ka ɓashi, sǝ a nda kǝla yia nǝ ɓealɓikea, a panǝ kun nacau ɗang! Ɓǝ̀ we ka a na ama yia ka amǝ'ɓealɓikea na ɓǝa pea wia tanni ka, a ndaban pakki ɓamuro ɓashi, acemǝnana we mana a kǝ ɓashi aɓea ɓwana ka, kǝ àkǝ̀ gir nì na gbal a pakkiyi ka.<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 7:1">Mat 7:1</ref>; <ref loc="LUK 6:37">Luk 6:37</ref></char>.</note> <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Sǝm sǝlǝna ama Ɓakuli aɓa pe male mala kpata mǝsǝcau ka, nǝ̀ ɓashi koyana mǝnana pakkiyi a'ulang agir mǝnana ani ka. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Mǝnana a kǝ ɓashi aɓwana ace pakki amǝnia yì agir ka, a kǝ sǝni kǝla a nǝ apî ɓashi mala Ɓakuli le, yi mana kǝ àkǝ̀ gir nì na a pakkiyi gbal ka? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />We ka, a sǝn nggea ɓwamuru, andǝ twal gandǝa, andǝ munyi mala Ɓakuli mǝnana ndanǝi a rǝo raka re? Mǝnia ka kǝgìr na a bano re? A sǝlǝ ado ama ɓwamuru male ka nda ace mǝnana nǝ̀ nyesǝo wu pwanzali a baní, wu nying buo arǝ cauɓikea ka re?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />Sǝ acemǝnana we ka a ndanǝ murcandǝa, a ɓinǝ nying buo arǝ cauɓikea ka, a nda rǝ rambǝi ɓamuro candǝna tanni. Acemǝnana pwari mala bumlulla na kǝ yiu ka, mǝnana ɓashi mǝɓafoe mala Ɓakuli nǝ̀ lǝmdǝ rǝì ka. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Ɓakuli nǝ̀ ɓashi koyana le ka amur gir mǝnana pak ka.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 62:12">Ang 62:12</ref>; <ref loc="PRO 24:12">Pas 24:12</ref>; <ref loc="MAT 16:27">Mat 16:27</ref>; <ref loc="1CO 3:8">1Kor 3:8</ref>; <ref loc="2CO 5:10">2Kor 5:10</ref>; <ref loc="REV 22:12">Sǝn 22:12</ref></char>.</note> <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Aɓwana mǝnana à lidǝmba nǝ pěmǝɓoarne sǝ à kǝ alta ɓoarɓwa, andǝ gulo, andǝ do api-lú nǝban Ɓakuli ka, Ɓakuli nǝ̀ pea wia yilǝmu mǝnana málá male pà kàm raka. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Sǝ bumlulla andǝ bumpina male ka nǝ̀ sulǝo amur amǝ'earce ɓamuria, andǝ amǝɓinǝ kpata mǝsǝcau ace gya atà ɓealɓikea. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Nggea tanni nakam andǝ rǝpina amur aɓwana mǝnana à lidǝmba nǝ gya aɓa ɓealɓikea ka. Nǝ̀ tite nǝ ɓwa Yahudi sǝ ɓwa mǝnana ɓwa Yahudi na raka. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Sǝ aɓwana mǝnana à kǝ pak mǝɓoarne ka, ɓoarɓwa andǝ gulo andǝ dorǝpwala mala Ɓakuli nǝ̀ sulǝo amúrià. Tite nǝ ɓwa Yahudi sǝ ɓwa mǝnana ɓwa Yahudi na raka. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Mǝnia ka nda acemǝnana Ɓakuli ka, kǝ tàrban ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 10:17">Nggur 10:17</ref>; <ref loc="2CH 19:7">2Acau 19:7</ref>; <ref loc="GAL 2:6">Gal 2:6</ref>; <ref loc="EPH 2:9">Afi 2:9</ref>; <ref loc="COL 3:25">Kol 3:25</ref>; <ref loc="1PE 1:17">1Bit 1:17</ref></char>.</note><verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Aɓwana mǝnana amǝ Yahudi na ɗang sǝ à súrǝ̀ Nggurcau mala Ɓakuli mǝnana pe Musa raka, ɓǝa pak cauɓikea ka à nǝ̀ kiɗikia. Ɓashi malea ka, pà nǝ̀ pang nǝ Nggurcau mala Ɓakuli mǝnana à gilǝì nǝ gilǝe ka ɗang. Sǝ aɓwana mǝnana à súrǝ̀ Nggurcau ka, à nǝ̀ ɓashia wia nǝ gir mǝnana Nggurcau na ka.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 3:19">Rom 3:19</ref>; <ref loc="1CO 9:21">1Kor 9:21</ref></char>.</note> <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Sǝ pà ace ok Nggurcau nǝmurǝì sǝ ɓwa nǝ̀ duk mǝɓoarne a ban Ɓakuli ɗang, nda atārǝia andǝ pak agir mǝnana Nggurcau bang ngga.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JAS 1:22-23">Jem 1:22-23</ref>,<ref loc="JAS 1:25">25</ref></char>.</note> <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />Ko nggearǝ aɓwana mǝnana amǝ Yahudi na ɗang, mǝnana à pà nǝ́ Nggurcau mala Ɓakuli raka, à kǝ̀ lǝmdǝa ama Nggurcau mala Ɓakuli ndakam a ɓabumia. Acemǝnana ɓǝ̀ ɗenyicau malea lǝmdǝia wia gir sǝ à pè, sǝ karǝ nǝ cau mǝnana Nggurcau bang ngga, yia ka à dumǝna nggurcau mala ɓamuria, kat andǝ amani ama à pànǝ Nggurcau raka. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />À lǝmdǝí aɓa pě ama Nggurcau mala Ɓakuli ka à gilǝni a ɓabumia, sǝ ɓabumia andǝ ɗenyicau malea ka, à kǝ lǝmdǝià wia ko à ɓwarkina, ko à nda ban pak mǝɓoarne. <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Sǝ mǝnia ka nda Cau Amsǝban mǝnana ǝn nggǝ hamnǝi ka, ama pwari nda kǝ yiu ka, mana Ɓakuli nǝ̀ ɓashi aɓwana amur aɗenyicau ɓa-sǝmbǝrǝa malea nǝ bu Yesu Kǝrǝsti.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ECC 12:14">Ham 12:14</ref>; <ref loc="ROM 16:25">Rom 16:25</ref>; <ref loc="1CO 4:5">1Kor 4:5</ref></char>.</note><verse eid="ROM 2:16" /></para>
  <para style="s">Amǝ Yahudi andǝ Nggurcau <optbreak /> mala Musa</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />We mǝnana a kǝ tunǝ ɓamuro ama a nda ɓwa Yahudi, a kǝ gūlì arǝ Nggurcau sǝ a kǝ nggori nǝ Ɓakuli. <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />A súrǝ́nà rǝgir mǝnana Ɓakuli earkiyi ce ama wu pak ka; a súrǝ́nà rǝ mǝsǝcau acemǝnana à kanino anggurcau male. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />A ndanǝ sǝlǝe kàngkàng ama a nda mǝbwalgara mala ante, sǝ a nda tǎlaban mala aɓwana mǝnana à do aɓa pǝndǝa ka. <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />A kǝ sǝni kǝla a nǝ duk mǝkwarkir amǝ ɗwanyi sǝlǝe andǝ mǝkania amuna gir aɓa njar mala Ɓakuli, acemǝnana súrǝ̀gir andǝ mǝsǝcau kat ka ndakam aɓa Nggurcau ka. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />We mǝnana a kǝ kani aɓwana gir ka, palang sǝ a pà nǝ́ kani ɓamuro ɗang? A banggi aɓwana ama ɓǝa kǝa iun'í ɗang, sǝ we nǝ ɓamuro ka, a kǝ iun'í re? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />A na ama ɓǝa kǝa nongnǝban a nza nǝ doɓala ɗang, sǝ we ka a kǝ pak cauɓikea nongnǝban a nza nǝ doɓala re? A kǝ ɓinǝce peri atà ankúl, sǝama a kǝ pak túró nǝ agir mǝnana à iuwia nǝ iuwe a ndà mala alú ka re? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />A kǝ nggori ama a súrǝ́nà rǝ Nggurcau mala Ɓakuli, sǝama à kǝ pe wi gulo ɗang, acemǝnana à kǝ pár Nggurcau male. <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Pà ɓà sǝ Malǝmce bang ama, &lt;&lt;Ace cau ma'wun, wun amǝ Yahudi sǝ aɓwana mǝnana arǝ acili anzali ka à kǝ pak ce Ɓakuli ɓà&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 52:5">Isha 52:5</ref>; <ref loc="EZK 36:22">Ezǝk 36:22</ref></char>.</note> ɗang.<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Kasǝ-ɓatau ka ndanǝ gir mǝɓoarne atè ɓǝ̀ wu kǝ kpata Nggurcau mala Ɓakuli ka. Sǝ ɓǝ̀ wu kǝ pár Nggurcau mala Ɓakuli ka, wu dumǝna kǝla weama à kasǝa wun ɓatau ɗang. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Sǝ aɓwana mǝnana amǝ Yahudi na raka, ɓǝa kpata Nggurcau mala Ɓakuli ka, Ɓakuli pa nǝ̀ twalia kǝla weama à kasǝnia wia ɓatau re? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Mǝsǝcau ka, nda mǝnana ama aɓwana mǝnana à kasǝ ɓatea raka, mana à bwal Nggurcau mala Ɓakuli ka, à nǝ̀ mak wun nǝ ɓashi, wun amǝ Yahudi mana à kasǝ ɓata wun, wu ndanǝ Nggurcau mala Ɓakuli, sǝ wu kǝ kpate raka.<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />Duk ɓwa Yahudi mǝɓafoe ka, pà acemǝnana ɓwa ka à ɓǝlì a tàu mala amǝ Yahudi, ko acemǝnana à kasǝî wi ɓate ka ɗang. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Awo pa anggo ɗang, ɓwa Yahudi mǝɓafoe ka, nda ɓwa mǝnana ɓabumi ka à nggaɗini, nrě gilǝkina andǝa Ɓakuli; sǝ mǝno ka túró mala Bangŋo mala Ɓakuli na, kpata Nggurcau na ɗang. Ɓwa kǝla mǝno ka, ɓwangsǝban male kǝ pur aban ɓwapǝndǝa ɗang, kǝ pur nǝban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">2:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 30:6">Nggur 30:6</ref></char>.</note><verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">Ɓakuli ka kǝ nggaɗi ɗang</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Nǝ mana sǝ duk ɓwa Yahudi ka kutina ban nǝi le? Ko a na raka, kasǝ-ɓatau ka kǝgìr na le? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />E, duk ɓwa Yahudi ka agir mǝɓoarne nakam kpem aɓalǝi! A tite ka Ɓakuli pea amǝ Yahudi acau male a buia.<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />Mǝsǝcau ka, aɓea ɓwana aɓalǝia ka à kpata cau mala Ɓakuli kǝla mǝnana à bang ama à nǝ̀ pak ka ɗang. Sǝ ɗwanyi kpata cau malea kâ, nggaɗi domǝsǝcau mala Ɓakuli le? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Ko bǝti! Sǝ ɓǝ̀ koyan ngga mǝ'nyir na ka, Ɓakuli ka mǝ'mǝsǝcau na. Kǝla mǝnana Malǝmce bang ngga:</para>
  <para style="q1" vid="ROM 3:4">&lt;&lt;À nǝ̀ kúmǒ nǝ mǝsǝcau,</para>
  <para style="q2" vid="ROM 3:4">aɓa cau mana a na ka,</para>
  <para style="q1" vid="ROM 3:4">sǝ ɓǝà wulio ka,</para>
  <para style="q2" vid="ROM 3:4">a nǝ li ɓashi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 51:4">Ang 51:4</ref></char>.</note><verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Sǝ ɓǝ̀ ɓealɓikea ma'sǝm kǝ lǝmdǝ cauɓoarna mala Ɓakuli ka, aman sǝ sǝm nǝ̀ na? Sǝm nǝ̀ na ama Ɓakuli pángŋǝ̀nà kpak, yì mǝnana ɓǝ̀ so bumlulla male amur sǝm ngga le? (Mǝnia ka nê mala ɓwapǝndǝa na.) <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Ko bǝti! Ɓǝ̀ Ɓakuli ka mǝ'cauɓoarna na raka, palang sǝ nǝ̀ karǝ pakki ɓanza ɓashi? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Sǝ ɓǝ̀ ɓwa nǝ̀ gandǝ na ɗǝm ama, &lt;&lt;Palang sǝ Ɓakuli nǝ̀ ɓashiam ama mǝ nda mǝ'cauɓikea, yi mǝnana ɗwanyi na mǝsǝcau mema, lǝmdǝ mǝsǝcau male a banfana, sǝ kárǝì wi ɓoarɓwa mǝgule ka?&gt;&gt; <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Pǝlǝa aɓea ɓwana tsǝka sǝm cau, ama sǝm na ama, &lt;&lt;Lidǝmba ma'sǝm aɓa cauɓikea ka, nǝ̀ nggá yinǝ gir mǝɓoarne!&gt;&gt; Aɓwana mǝnana à na mǝnia yì cau ka, ɓoaro ɓǝa kasǝia wia ɓashi mǝnana karǝ a rǝia ka.<verse eid="ROM 3:8" /></para>
  <para style="s">Ɓwapǝndǝa kat ka <optbreak /> amǝ cauɓikea na</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Sǝm amǝ Yahudi ado ka, sǝm nǝ̀ ne ɓamur rǝ sǝm ama sǝm kútì acili aɓwana le? Awo, sǝm kútia ɗàng ko bǝti! Acemǝnana sǝm angŋǝna dǝmba sǝm lǝmdǝna ama ɓwapǝndǝa kat, amǝ Yahudi andǝ aɓwana mǝnana amǝ Yahudi na raka, à nda aɓata rǝcandǝa mala cauɓikea. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Kǝla mǝnana Malǝmce na ka:</para>
  <para style="q1" vid="ROM 3:10">&lt;&lt;Kǝɓwa pà kàm mana</para>
  <para style="q1" vid="ROM 3:10">mǝ'cauɓoarna na ka ɗàng,</para>
  <para style="q2" vid="ROM 3:10">ko kǝɓwa mwashat</para>
  <para style="q2" vid="ROM 3:10">pà kàm ɗàng.<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />Kǝɓwa pà kàm</para>
  <para style="q1" vid="ROM 3:11">nǝ́ sǝlǝe ɗàng,</para>
  <para style="q2" vid="ROM 3:11">kǝɓwa pà kàm mwashat</para>
  <para style="q2" vid="ROM 3:11">kǝ alta Ɓakuli ɗang.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Yia kat ka à pǝlǝni</para>
  <para style="q1" vid="ROM 3:12">Ɓakuli nzǝmia;</para>
  <para style="q2" vid="ROM 3:12">yia kat ka à uena ɓà.</para>
  <para style="q1" vid="ROM 3:12">Kǝɓwa pà kàm mǝnana kǝ</para>
  <para style="q1" vid="ROM 3:12">pak gìr mǝɓoarne ka ɗàng,</para>
  <para style="q2" vid="ROM 3:12">ko ɓwa mwashat</para>
  <para style="q2" vid="ROM 3:12">pà kàm ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 14:1-3">Ang 14:1-3</ref>; <ref loc="PSA 53:1-3">53:1-3</ref></char>.</note><verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />&lt;&lt;Acau malea ka</para>
  <para style="q1" vid="ROM 3:13">amǝɓike na,</para>
  <para style="q2" vid="ROM 3:13">kǝla rǝmban mǝnana</para>
  <para style="q1" vid="ROM 3:13">kǝ puro aɓa ɓembe</para>
  <para style="q2" vid="ROM 3:13">mana à gìrì raka.</para>
  <para style="q1" vid="ROM 3:13">Lasǝia ka lùmsǝ nǝ nyir.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 5:9">Ang 5:9</ref></char>.</note></para>
  <para style="q1" vid="ROM 3:13">&lt;&lt;Barya mala n'yau</para>
  <para style="q2" vid="ROM 3:13">kǝ surkio a kunia.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 140:3">Ang 140:3</ref></char>.</note><verse eid="ROM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />&lt;&lt;Kunia lùmsǝ nǝ</para>
  <para style="q2" vid="ROM 3:14">súban andǝ nggaro-cau.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 10:7">Ang 10:7</ref></char>.</note><verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />&lt;&lt;À kǝ̀ kaurǝa aban</para>
  <para style="q2" vid="ROM 3:15">sukki nkila.<verse eid="ROM 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ROM 3:16" />Kiɗiki andǝ bumkpǝmna ka,</para>
  <para style="q2" vid="ROM 3:16">nda ateà a koya ban.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Yia ka à súrǝ̀ njar mala</para>
  <para style="q2" vid="ROM 3:17">dorǝpwala ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 59:7-8">Isha 59:7-8</ref></char>.</note><verse eid="ROM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ROM 3:18" />&lt;&lt;À pànǝ ɓangciu mala</para>
  <para style="q2" vid="ROM 3:18">Ɓakuli ɗang, ko bǝti.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 36:1">Ang 36:1</ref></char>.</note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Sǝm sǝlǝna ama gìr mǝnana kat Nggurcau na ka, nda aban ne aɓwana mǝnana à nda aɓata Nggurcau ka, ace mǝnana ɓǝ̀ ɓwa ɓǝ̀ kǝa kum kún nacau ɗàng, sǝ ɓanza kat ka à nǝ̀ yinǝi a ɓadǝm ɓashi mala Ɓakuli. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Kǝ ɓwa pà kàm nǝ̀ duk mǝ'cauɓoarna a ɓadǝm Ɓakuli acemǝnana bwal Nggurcau ka ɗàng. Gìr mǝnana Nggurcau pakki ka, nda lǝmdǝa sǝm ulang do cauɓikea ma'sǝm.<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 143:2">Ang 143:2</ref>; <ref loc="GAL 2:16">Gal 2:16</ref></char>.</note><verse eid="ROM 3:20" /></para>
  <para style="s">Kǝrǝsti twalǝna atanni ma'sǝm</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Sǝ a dyan ngga Ɓakuli lǝmdǝna njargula mǝnana aɓwana nǝ̀ duk amǝɓoarne a baní nǝi ka, pa atārǝia andǝ pak gìr mǝnana Nggurcau bang ngga ɗàng, kǝla mǝnana Nggurcau mala Musa andǝ amǝ'ɓangnǝa mala Ɓakuli nakún amurí ɗiɗyal ka. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />À nǝ̀ pǝlǝ sǝm, sǝm nǝ̀ duk amǝ'cauɓoarna aban Ɓakuli ace paɓamur sǝm aban Yesu Kǝrǝsti. Mǝnia ka anggo sǝ pa nǝ koyana mǝnana paɓamuri aban Kǝrǝsti ka, tàrban pa kàm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 2:16">Gal 2:16</ref></char>.</note> <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Acemǝnana koyan ngga pàngŋǝ̀nà cauɓikea, sǝm kat ka sǝm gattì doɓoarɓwa mala Ɓakuli<note caller="+" style="f"><char style="fr" closed="false">3:23 </char><char style="fq" closed="false">sǝm gattì doɓoarɓwa mala Ɓakuli </char><char style="ft" closed="false">ko &lt;&lt;sǝm nda kuko nǝ bancame mǝɓoarɓwe mala Ɓakuli mana kasǝa ace kum amsǝban ngga.&gt;&gt;</char></note>. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Kat andǝ amani ka, Ɓakuli nǝ ɓwamuru male<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="fq" closed="false">Ɓakuli nǝ ɓwamuru male </char><char style="ft" closed="false">ko: Ɓakuli nǝ ɓwamuru male, mǝnana mbwegìr pà arǝì raka.</char></note>, nyesǝ sǝm, sǝm duk amǝ'cauɓoarna. Yì ka, pak mǝnia ka nǝ bu Kǝrǝsti Yesu, mǝnana akmúr sǝm ngga. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Ɓakuli pa Yesu ɓǝ̀ sukki nkile ace mǝnana nǝ mǝno ka, aɓwana nǝ̀ kum twalban cauɓikea. Aɓwana mǝnana à paɓamuria aban Yesu ama pà yilǝmi, sukki nkile acea ka, Ɓakuli nyesǝnia amǝ'cauɓoarna na a baní. Mǝnia yì nkila à sukki ka, lǝmdǝ ama Ɓakuli ka mǝ'cauɓoarna na, acemǝnana arǝ anza mǝnana ɗiɗyal ka, pàk munyi nǝ aɓwana, tsǝkir ce acauɓikea malea ɗàng. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Pak mǝnia ka ace lǝmdǝ do mǝsǝcau male a nza mǝnia adyan ngga, ace mǝnana yì nǝ ɓamúrì ka, ɓǝ̀ duk mǝ mǝsǝcau, sǝ nǝ̀ tsǝk amǝ'cauɓikea mǝnana kat à pà ɓamuria aban Yesu ka, ɓǝà duk amǝ'cauɓoarna a baní.<note caller="+" style="f"><char style="fr" closed="false">3:26 </char><char style="fq" closed="false">ɓǝà duk amǝ'cauɓoarna a baní: </char><char style="ft" closed="false">Ko &lt;&lt;ɓǝà esǝki acauɓikea malea mǝnana à ramba amúrià ka, ɓǝà kum akban a baní.&gt;&gt;</char></note><verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Sǝm nǝ̀ nggori ado ama sǝm pàngŋǝ̀nà kǝgìr mǝnana tsǝa sǝ Ɓakuli ak sǝm ngga le? Awo, nggori pà kàm ɗang! Sǝ́ nda ace mana sǝ Ɓakuli ak sǝm? Nda acemǝnana sǝm kpata Nggurcau male ka le? Awo! Ɓakuli ak sǝm acemǝnana sǝm earnǝi, sǝm pa ɓamur sǝm aban Kǝrǝsti ka. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Ace mani ka, sǝm duk amǝ'cauɓoarna aban Ɓakuli acemǝnana sǝm pa ɓamur sǝm ngga, pa ace bwal Nggurcau ɗàng. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Sǝ ana raka, Ɓakuli ka, mala amǝ Yahudi na nǝmurǝia le? Yì ka, Ɓakuli mala acili anzali na kat gbal re? E, nda acea. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Sǝ acemǝnana Ɓakuli ka nda mwashat amur aɓwana kat ka, kǝ tsǝk aɓwana ɓǝà pǝlǝ amǝ'cauɓoarna, yi mana ɓǝà pà ɓamuria aban Kǝrǝsti ka, ko amǝ Yahudi, ko aɓwana mǝnana amǝ Yahudi na raka.<note caller="+" style="f"><char style="fr" closed="false">3:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 6:4">Nggur 6:4</ref>; <ref loc="GAL 3:20">Gal 3:20</ref></char>.</note> <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Sǝ acemǝnana sǝm dàrrìna arǝ pa ɓamuru aban Kǝrǝsti ka, lǝmdǝ ama Nggurcau ka sǝm turni le? Awo, ko bǝti! Aɓa mǝsǝcau ka, sǝm puna anzǝm Nggurcau.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Paɓamuru mala Ibǝrayim</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Mana ado sǝm nǝ̀ na amur Ibǝrayim, yì kà-aɓwana ma'sǝm aɓa nggūrǝu? Mana gir nì na yi sǝlǝa amur cau mala do mǝ'cauɓoarna aban Ɓakuli? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Ɓǝa atúró mǝɓoarne male, mǝnana pea ka nda tsǝa sǝ Ɓakuli é mǝ'cauɓoarna na ka, ɓǝ́ ndanǝ kǝgìr mǝnana nǝ̀ nggori nǝi ka. Sǝ Ibǝrayim ngga pà nǝ̀ gandǝ nggori aban Ɓakuli ɗang. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Acemǝnana Malǝmce bangga sǝm ama, &lt;&lt;Ibǝrayim ngga earnǝ Ɓakuli, sǝ Ɓakuli é mǝ'cauɓoarna na ace paɓamuru male.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 15:6">Tite 15:6</ref>; <ref loc="GAL 3:6">Gal 3:6</ref></char>.</note><verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />Ɓǝ̀ ɓwa pak túró sǝ à mbwe ka, ɓoro na à pe wi ka ɗang, tangnakusǝu túró male na kum ngga. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Sǝ Ɓakuli ka kǝ twal ɓwa ɓǝ̀ do mǝ'cauɓoarna na, sǝ pa ace atúró male ɗang, nda ace paɓamuru male aban Ɓakuli, mǝnana twalkiyiban cauɓikea mala amǝ'cauɓikea ka. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Dauda nacau amur mǝnia gbal. Cau male lǝmdǝ ulang tsǝkbu mǝnana nda amur ɓwa mana Ɓakuli nyesǝi mǝ'cauɓoarna na, kat andǝ amani ama pak kǝ túró ace raka. Na ama:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />&lt;&lt;Tsǝkbu mala Ɓakuli na</para>
  <para style="q2" vid="ROM 4:7">amur aɓwana mǝnana</para>
  <para style="q1" vid="ROM 4:7">à twalǝnia wia ban</para>
  <para style="q1" vid="ROM 4:7">amgbikiru malea,</para>
  <para style="q2" vid="ROM 4:7">sǝ à esǝkinia wia acauɓikea</para>
  <para style="q2" vid="ROM 4:7">malea ka.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />E, tsǝkbu na amur ɓwa</para>
  <para style="q2" vid="ROM 4:8">mǝnana acauɓikea male ka</para>
  <para style="q1" vid="ROM 4:8">Mǝtalabangŋo pà nǝ̀</para>
  <para style="q2" vid="ROM 4:8">cia a bumi raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 32:1">Ang 32:1</ref>,<ref loc="PSA 32:2">2</ref></char>.</note><verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Nggearǝ mǝnia yì tsǝkbu mǝnana Dauda nakiyi ce ka, nda ace amǝ Yahudi nǝmurǝia le ko nda gbal ace aɓwana mǝnana amǝ Yahudi na raka? Sǝm bang ama à gìlǝì aɓa Malǝmce ama, &lt;&lt;Ibǝrayim ngga earnǝ Ɓakuli, pà ɓamúrì a baní, sǝ Ɓakuli é mǝ'cauɓoarna na.&gt;&gt; <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Sǝ lang sǝ Ɓakuli é? Ɓakuli é mǝ'cauɓoarna na anzǝm mǝnana à kasǝni wi ɓate<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fq" closed="false">kasǝni wi ɓate: </char><char style="ft" closed="false">Kasǝ-ɓatau aban amǝ Yahudi ka nda lǝmdǝ ama ɓwa ka mala Ɓakuli na.</char></note> ka le, ko Ɓakuli é anggo sǝ ɓǝa yi kasǝî wi ɓate? Ɓakuli ak Ibǝrayim sǝ à yì kasǝî wi ɓate nǝnzǝ́mò! <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />Yì kasǝ-ɓatau mǝnana à kasǝi Ibǝrayim ngga nda gìr mǝnana lǝmdǝ ama, nǝ́ paɓamuru male aban Ɓakuli ka, Ɓakuli earǝna angŋǝni, ama yì ka, mǝ'cauɓoarna na a baní, sǝ à yì kasǝî wi ɓate. Ace mani ka, Ibǝrayim nda tár aɓwana mǝnana kat à pà ɓamuria aban Ɓakuli sǝ Ɓakuli kǝ ea amǝ'cauɓoarna na, kat andǝ amani ama à kasǝia wia ɓatea raka.<note caller="+" style="f"><char style="fr" closed="false">4:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:10">Tite 17:10</ref>,<ref loc="GEN 17:11">11</ref></char>.</note> <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Sǝ Ibǝrayim ɗǝm ngga, nda tár aɓwana mǝnana à kasǝia wia ɓatea, yia mǝnana kasǝ-ɓatau nda à kasǝia wia nǝmurǝì ka ɗàng, yia gbal ka à twalkusǝ ulang paɓamuru mala Ibǝrayim, mǝnana ndanǝi sǝ nǝnzǝ́mò à yì kasǝî wi ɓate ka.<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Mǝnana Ɓakuli pacau aban Ibǝrayim andǝ amǝkè ama nǝ̀ tsǝkia wia bu sǝ ɓanza kat nǝ̀ duk malea ka, pa acemǝnana Ibǝrayim bwal Nggurcau mala Ɓakuli ka ɗàng. Nda acemǝnana yì ka, earnǝ Ɓakuli, gūlì arǝì ama nǝ̀ pak gìr mǝnana bang ngga. Sǝ ace mǝno ka Ɓakuli é mǝ'cauɓoarna na.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:4-6">Tite 17:4-6</ref>; <ref loc="GEN 22:17">22:17</ref>,<ref loc="GEN 22:18">18</ref>; <ref loc="GAL 3:29">Gal 3:29</ref></char>.</note> <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Ɓǝ̀ pàcau mala Ɓakuli ka nda ace aɓwana mǝnana à bwal Nggurcau male mana pe Musa ka, lǝmdǝ ama gūlì arǝ Ɓakuli ace mǝnana ɓǝ̀ nyesǝ sǝm ɓǝ̀ sǝm duk amǝ'cauɓoarna ka nda ɓà. Sǝ ɗǝm ngga nǝ̀ lǝmdǝ ama gūlì arǝì gbal ace kum gìr mǝnana pàcau ace ka nda ɓà.<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 3:18">Gal 3:18</ref></char>.</note> <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Yàl Nggurcau kǝ nun bumlulla mala Ɓakuli amur aɓwana mǝnana à kǝ ɓariki ama à nǝ̀ bwali ka. Sǝ ɓǝ̀ Nggurcau pà kàm raka, yàl Nggurcau gbal ka, pà kàm ɗang!<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Ace mani ka, nǝ́ gūlì arǝ Ɓakuli sǝ ɓwa nǝ̀ kum gìr mǝnana Ɓakuli pàcau ace ka. Ɓakuli pe anggo ace mǝnana ɓǝa sǝlǝ kàngkàng ama gìr mǝnana pàcau ace ka nǝ̀ ɓwamur aɓwana nǝi, yia aɓwana mǝnana kat amuna mala Ibǝrayim na ka. Mǝno yì ɓwamuru ka pa ace amǝ Yahudi mǝnana à kpakiyi atà Nggurcau ka nǝmurǝia ɗàng, nda gbal ace aɓwana mǝnana à earnǝ Ɓakuli, à gūlì arǝì kǝla mala Ibǝrayim ngga. Ibǝrayim ngga nda tár sǝm kat.<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 3:7">Gal 3:7</ref></char>.</note> <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Kǝla mǝnana à gilǝì aɓa Malǝmce ka, Ɓakuli ne wi ama, &lt;&lt;Mim ngga ǝn tsǝ́ngŋǝno a dumǝna tárrú amur aɓwana arǝ anzali pas.&gt;&gt; Mǝnia ka pa anggo, acemǝnana Ibǝrayim earnǝ Ɓakuli mana kǝ loasǝ alú nǝ yilǝmu sǝ kǝ pusǝ agir mǝbǝshe aban mǝnana kǝgìr pà kàm raka.<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:5">Tite 17:5</ref></char>.</note><verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Kat andǝ amani ama kǝgìr pà kàm mana nǝ̀ pe Ibǝrayim tsǝkɓalǝu ama nǝ̀ kum muna raka, lidǝmba nǝ tsǝkɓalǝu. Pa eare ama nǝ̀ duk tárrú amur aɓwana arǝ anzali pas, acemǝnana Ɓakuli bangŋǝni wi ama, &lt;&lt;Anggo sǝ làkkì mala amǝ'keò nǝ̀ pa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 15:5">Tite 15:5</ref></char>.</note> <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Ibǝrayim ngga apǝlǝa male málá à nǝ̀ lùmsǝ gbǝman mwashat. Yi sǝni ka ena a nggūrǝì, mǝnana à nǝ̀ twali ama yì ka, lú na. Sǝ ɗǝm ngga yi sǝn māmí Saratu ka ena, sǝ gandǝ ɓǝlî wi muna ɗang. Kat andǝ amǝno ka, paɓamuru mala Ibǝrayim aban Ɓakuli ka, gatti ɗang.<note caller="+" style="f"><char style="fr" closed="false">4:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:17">Tite 17:17</ref></char>.</note> <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Pa eare mala Ibǝrayim nǝ́ gir mǝnana Ɓakuli na ama nǝ̀ pè ka, dǝurǝ ɗang. Aɓa mǝsǝcau ka, paɓamuru male aban Ɓakuli lidǝmba nǝ rǝcandǝa, andǝ gusǝlǝ Ɓakuli. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Yì ka, earǝna nǝi nǝ ɓabumi kat ama Ɓakuli ka ndanǝ rǝcandǝa nǝ̀ lùmsǝ gir mǝnana bangŋǝna ama nǝ̀ pè ka. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Sǝ ace paɓamuru male yì Ibǝrayim ngga, &lt;&lt;Ɓakuli é mǝ'cauɓoarna na.&gt;&gt; <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Cau mǝno à bangŋi ama, &lt;&lt;Ɓakuli é mǝ'cauɓoarna na&gt;&gt; ka, pa ace Ibǝrayim nǝmurǝì sǝ à gilǝì ɗàng. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />Nda gbal ace sǝm sǝ à gilǝì, sǝm mǝnana Ɓakuli nǝ̀ ak sǝm kǝla amǝ'cauɓoarna, acemǝnana sǝm pa ɓamur sǝm a baní, yì ɓwa mana loasǝ Yesu Mǝtala sǝm a ɓembe ka. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Ɓakuli pa Yesu ɓǝà wal-luí ace acauɓikea ma'sǝm, sǝ yì loasǝi nǝyilǝmu ace mǝnana ɓǝà pǝlǝ sǝm ɓǝ̀ sǝm duk amǝ'cauɓoarna aban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="fq" closed="false">ɓǝà pǝlǝ sǝm ɓǝ̀ sǝm duk amǝ'cauɓoarna aban Ɓakuli: </char><char style="ft" closed="false">Ko &lt;&lt;ɓǝà gilǝki dotarǝu ma'sǝm sǝnǝa Ɓakuli.&gt;&gt;</char></note> <note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:4">Isha 53:4</ref>,<ref loc="ISA 53:5">5</ref>; <ref loc="2CO 5:21">2Kor 5:21</ref></char>.</note><verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Gūlì arǝ Kǝrǝsti kǝ yinǝ <optbreak /> dorǝpwala andǝ banɓoarnado</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Acemǝnana ado ka sǝm kumǝna akban aban Ɓakuli atàcau mala paɓamuru ka, sǝm ndanǝ dorǝpwala a nre sǝm sǝnǝa Ɓakuli nǝ bu Mǝtala sǝm Yesu Kǝrǝsti. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Ndá àkǝ̀ cè gūliarǝu ma'sǝm arǝ Kǝrǝsti sǝ yinǝ sǝm aɓa ɓwamuru mala Ɓakuli mǝnana ado sǝm do aɓalǝi ka. Acemani ka, sǝm nggǝ nggori nǝ tsǝkɓalǝu mǝnana sǝm ndanǝi mala kùmô atà Ɓakuli yi gulo andǝ ɓoarɓwa male ka.<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 2:18">Afi 2:18</ref>; <ref loc="EPH 3:12">3:12</ref>; <ref loc="HEB 10:19-20">Ib 10:19-20</ref></char>.</note> <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Ban kǝ ɓoara sǝm gbal, yi mǝnana ɓǝ̀ sǝm kútí aɓalǝ atanni ka. Acemǝnana sǝm sǝlǝna ama tanni ka, nǝ̀ yina sǝm nǝ do gandǝrǝu,<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 5:11">Rom 5:11</ref>; <ref loc="2CO 12:10">2Kor 12:10</ref>; <ref loc="JAS 1:3">Jem 1:3</ref></char>.</note> <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />sǝ do gandǝrǝu ka, kǝ yinǝ ɓealu mǝɓoarne, sǝ ɓealu mǝɓoarne kǝ tsǝa tsǝkɓalǝu ma'sǝm mala kum amsǝban kǝ dǝurǝ ɗang. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Sǝ mǝnia yì tsǝkɓalǝu ka, pà nǝ̀ tsǝa sǝm nǝ̀ nu kǝsǝkya ɗang, acemǝnana Ɓakuli pana sǝm ɓoro male, yì Bangŋo Mǝfele, ɓǝ̀ lùmsǝ ɓabum sǝm nǝ earcearǝu male.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Mǝnana sǝm nda più aɓa ɗwanyi rǝcandǝa sǝ sǝm pànǝ ban àwá raka, Kǝrǝsti yi wú ace sǝm amǝ'cauɓikea, a pwari mǝnana Ɓakuli kànì ka. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Ndanǝ kwano aban aɓwana pas mǝnana ɓwa nǝ̀ wú ace mǝ'cauɓoarna ka, earka ɓwa nǝ̀ gandǝ wú ace mǝpagbasha. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Sǝ Ɓakuli ka lǝmdǝa sǝm earcearǝu male ani: Mǝnana sǝm nda ka amǝ'cauɓikea più ka, Kǝrǝsti yi wú ace sǝm.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />Acemǝnana ado ka à angŋǝna sǝm, sǝm dumǝna amǝ'cauɓoarna aban Ɓakuli nǝ nkila mala Kǝrǝsti ka, lǝmdǝ ama kàngkàng aɓa pě mǝnana kútì mǝno ka, sǝm nǝ̀ kum àwá a ɓabù bumlulla mala Ɓakuli nǝ baní! <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Kat aɓa do ma'sǝm ɗiɗyal mǝnana sǝm nda ka aɓibura mala Ɓakuli ka, à yì gilǝki nre sǝm sǝnǝa Ɓakuli nǝ lú mala Muni mana yi wú ace sǝm ngga. Ɓǝ̀ mǝno ka yi pa anggo ka, lǝmdǝ ama kàngkàng aɓa pě mǝnana kútì mǝno ka, sǝm nǝ̀ kum àwá, mǝnana ado ka à yina nǝ sǝm aɓa dotarǝu sǝnǝa Ɓakuli ka. Mǝnia ka nda acemǝnana yì Muna mala Ɓakuli ka ndakam nǝ yilǝmu. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Sǝ mǝno ka nda nǝmurǝì ɗàng; sǝm nda aɓa banɓoarnado ace bǝsa dotarǝu ma'sǝm sǝnǝa Ɓakuli ace gìr mǝnana pè nǝ bu Mǝtala sǝm Yesu Kǝrǝsti ka. Yì Kǝrǝsti ka, nda ɓwa mǝnana pǝlǝ sǝm ado, nre sǝm gilǝki sǝnǝa Ɓakuli ka.<verse eid="ROM 5:11" /></para>
  <para style="s">Gìr mǝnana gau Adamu <optbreak /> andǝ Kǝrǝsti ka</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Lang Adamu pángŋǝ̀nà cauɓikea ka, kara cauɓikea kutio a ɓanza. Cauɓikea mala Adamu ka nda yinǝ lú, sǝ lú pǝlǝa mǝsǝe amur koyan ngga, acemǝnana koyan ngga pàngŋǝ̀nà cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 3:6">Tite 3:6</ref>; <ref loc="1CO 15:21-22">1Kor 15:21-22</ref>; <ref loc="ROM 6:23">Rom 6:23</ref>; <ref loc="JAS 1:15">Jem 1:15</ref></char>.</note> <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Kaniama à nǝ̀ pa Nggurcau ka, cauɓikea ndakam ɗiɗyal a ɓanza. Sǝ duk cauɓikea ɗang, acemǝnana à malaká pa Nggurcau peatu mǝnana à nǝ̀ yàlli wi ka ɗàng. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Kat andǝ amani ka, ɓwapǝndǝa kǝ wú, twal a nza mala Adamu yi bwal a nza mala Musa, kpapi andǝ nggearǝ aɓwana mǝnana cauɓikea malea ka yàl nzongcau na kǝla mǝnana Adamu pak ka raka, lú do amúrià kat. Yì Adamu ka gir'lǝmdǝa na, kǝ lǝmdǝ Kǝrǝsti mǝnana nǝ̀ nggá yiu peatu ka.<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 15:22">1Kor 15:22</ref>,<ref loc="1CO 15:45">45</ref></char>.</note><verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Sǝ cauɓikea mala Adamu andǝ ɓoro mala Ɓakuli ka, à nda ɗàngɗáng. Acemǝnana cauɓikea mala mǝnia yì ɓwa mwashat, yì Adamu ka, yinǝ lú amur aɓwana pas. Sǝ ɓwamuru mala Ɓakuli ka gulo kútì mǝno kuko, anggo gbal sǝ ɓoro male mala twalban cauɓikea aban aɓwana pas pa, yì ɓoro mana aɓa ɓwamuru mǝnana yiu nǝ bu mǝnia yì ɓwa mwashat, yì Yesu Kǝrǝsti ka. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Sǝ gìr mǝnana ɓwamuru mala Ɓakuli pusǝ ka, ndá ɗàng andǝ gir mǝnana cauɓikea mala mǝnia yì ɓwa mwashat, pusǝ ka. Acemǝnana cauɓikea mala Adamu ka yinǝban aɓa kasǝ ɓashi-lú, sǝ ɓoro mala Ɓakuli ka kǝ warinǝ sǝm a kum kutio aban Ɓakuli, ko kat andǝa mǝnana ama sǝm kpa aɓalǝ acauɓikea pas ka. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Cauɓikea mala ɓwa mwashat, yì Adamu, tsǝa lú do amur aɓwana kat, nǝ bu mǝno yì ɓwa ka. Sǝ gìr mǝnana kàrmur mǝno ka nda, kum ɓwamuru mǝgule mala Ɓakuli andǝ pa ɓoro mala duk aɓwana amǝ'cauɓoarna nǝ bu ɓwa mwashat, yì Yesu Kǝrǝsti. Sǝ aɓwana mǝnana kat à kum mǝnia yì ɓwamuru andǝ ɓoro ka, à nǝ̀ duk amǝ yálmúrû<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="fq" closed="false">amǝ yálmúrû </char><char style="ft" closed="false">ko &lt;&lt;amurǝma.&gt;&gt;</char></note> aɓa do malea nǝ bu Yesu Kǝrǝsti.<note caller="+" style="f"><char style="fr" closed="false">5:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2TI 2:12">2Tim 2:12</ref>; <ref loc="REV 22:5">Sǝn 22:5</ref></char>.</note><verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Ace mani ka, kǝla mǝnana cauɓikea mwashat mala Adamu yinǝ kasǝ ɓashi-lú amur aɓwana kat ka, anggo gbal sǝ túró cauɓoarna mwashat mala Kǝrǝsti kǝ yinǝ akban a ban Ɓakuli andǝ yilǝmu ace aɓwana kat. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Sǝ kǝla mǝnana nǝ mgbikiru mala ɓwa mwashat ka, aɓwana pas pǝlǝ amǝ'cauɓikea ka, anggo gbal atàcau mala okiru mala ɓwa mwashat ka, aɓwana pas nǝ̀ duk amǝ'cauɓoarna.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />À pà Nggurcau mala Ɓakuli, ace mǝnana ɓǝ̀ aɓwana sǝn lime andǝ gulo mala cauɓikea malea. Sǝ ban mǝnana rǝcandǝa mala cauɓikea lidǝmba kǝ marǝki ɓwapǝndǝa kàngkàng ka, ɓwamuru mala Ɓakuli kǝ gulo kǝ tùr a dǝmba kàm kǝ̀rkǝ́r.<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:7-8">Rom 7:7-8</ref>; <ref loc="GAL 3:19">Gal 3:19</ref>; <ref loc="1TI 1:14">1Tim 1:14</ref></char>.</note> <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Sǝ kǝla mana cauɓikea do amur ɓwapǝndǝa kat a njar mala lú ka, anggo gbal ɓwamuru mala Ɓakuli ɓǝ̀ duk murǝm. Mǝnia yì ɓwamuru mala Ɓakuli ka kǝ yinǝ aɓwana ɓǝà kum akban a baní, sǝ aɓa mǝno ka ɓǝà kum yilǝmu mǝnana málá male pà kàm raka, nǝ bu Yesu Kǝrǝsti Mǝtala sǝm.<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:23">Rom 6:23</ref></char>.</note><verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Wuki cauɓikea andǝ do nǝ <optbreak /> yilǝmu aɓa Yesu Kǝrǝsti</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Mana ɗǝm sǝm nǝ̀ na? Sǝm nǝ̀ lidǝmba aɓa cauɓikea, ace mǝnana ɓǝ̀ ɓwamuru ɓǝ̀ gul ka le?<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 3:8">Rom 3:8</ref>; <ref loc="ROM 6:15">6:15</ref></char>.</note> <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Awo! Ɓakuli twalbani! Lang sǝ sǝm mǝnana sǝm angŋa dǝmba sǝm wunî cauɓikea ka, sǝm nǝ̀ lidǝmba nǝ do ɗǝm aɓalǝi le?<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:4">Rom 7:4</ref>,<ref loc="ROM 7:6">6</ref>; <ref loc="GAL 2:19">Gal 2:19</ref>; <ref loc="1PE 2:24">1Bit 2:24</ref></char>.</note> <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Wu sǝlǝ mbak ama batisǝma mǝnana à pakka sǝm aɓa Yesu Kǝrǝsti ka, lǝmdǝ ama sǝm dumǝna mwashat sǝnǝia, aɓa lú male? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Sǝm ngga, sǝm wú, sǝ à tsǝk sǝm a ɓembe sǝnǝa Kǝrǝsti nǝ batisǝma mǝnana à pakka sǝm ngga. Kǝla mǝnana Kǝrǝsti loapi ɓembe nǝ yilǝmu aɓa rǝcandǝa mala Ɓakuli Tárrú ka, sǝm gbal ka, sǝm nǝ̀ dukdo bǝsa yilǝmu.<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 2:12">Kol 2:12</ref></char>.</note><verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Sǝ acemǝnana sǝm dumǝna mwashat sǝnǝa Kǝrǝsti aɓa lú male ka, sǝm gbal ka, sǝm nǝ̀ loapi ɓembe nǝ yilǝmu kǝla yì.<note caller="+" style="f"><char style="fr" closed="false">6:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 4:10">2Kor 4:10</ref>; <ref loc="COL 2:12">Kol 2:12</ref></char>.</note> <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Sǝm sǝlǝna ama, ɓeal sǝm mǝ'e ka, à gbàllìnì amur nggun-gangndǝi andǝa Kǝrǝsti, ace mǝnana ɓǝ̀ rǝcandǝa mala kpata ɓamur rǝ sǝm mǝ'cauɓike ka ɓǝ̀ kiɗikea, sǝ anggo ka ɓǝ̀ sǝm ngga duk aguro aɓata cauɓikea ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:24">Rom 7:24</ref>; <ref loc="COL 2:13">Kol 2:13</ref></char>.</note> <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Sǝ ɓwa mǝnana wuna andǝa Kǝrǝsti ka, à panzǝni, cauɓikea panǝ rǝcandǝa amurí ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1PE 4:1">1Bit 4:1</ref></char>.</note><verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Sǝ ɓǝ̀ sǝm wuna sǝnǝa Kǝrǝsti ka, sǝm pana eare ama sǝm nǝ̀ dum nǝ yilǝmu sǝnǝia.<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2TI 2:11">2Tim 2:11</ref></char>.</note> <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Sǝm sǝlǝna ama acemǝnana Kǝrǝsti ka à loasǝi a ɓembe ka, pà nǝ̀ sǝn lú ɗǝm ɗàng; lú panǝ rǝcandǝa amurí ɗǝm ɗàng.<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 2:24">Atúró 2:24</ref>; <ref loc="REV 1:18">Sǝn 1:18</ref></char>.</note> <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Lú male mǝnana wu ka, wuki cauɓikea kusǝ mwashat ɓǝ̀rɓǝ̀r, sǝ do male nǝyilǝmu ka, dupî Ɓakuli.<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />Anggo gbal, wu sǝn ɓamur rǝ wun ado, wu nda ka alú aban cauɓikea, sǝ aban Ɓakuli ka, wu ndanǝ yilǝmu aɓa Kǝrǝsti Yesu.<note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:4">Rom 7:4</ref>,<ref loc="ROM 7:6">6</ref>; <ref loc="GAL 2:19">Gal 2:19</ref>; <ref loc="1PE 2:24">1Bit 2:24</ref></char>.</note><verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />Ace mani ka wu kǝa eari cauɓikea ɓǝ̀ do amur nggūrǝ wun mǝnana kǝ̀ ká nǝ ká a lú ka, ɓǝ̀ tsǝk wun a kpata anpel male ɗàng. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Wu kǝa pà abare nggūrǝ wun aban cauɓikea ɓǝà duk agirtúró mala ɓealɓikea ɗang. A kún mani ka, wu pè Ɓakuli rǝwun, kǝla aɓwana mǝnana à loasǝnia a lú, à kumǝna yilǝmu ka; sǝ wu pà abare wun aban Ɓakuli ɓǝà duk agirtúró ace túró cauɓoarna.<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:19">Rom 6:19</ref>; <ref loc="ROM 7:5">7:5</ref>; <ref loc="ROM 12:1">12:1</ref></char>.</note> <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Cauɓikea ka pà nǝ̀ duk gbani amur wun ɗang, acemǝnana wu pà ɗǝm aɓata Nggurcau ɗàng, wu nda aɓata ɓwamuru mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 8:2">Rom 8:2</ref></char>.</note><verse eid="ROM 6:14" /></para>
  <para style="s">Aguro ace cauɓoarna</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Lang sǝ wu sǝni ado ɗe? Sǝm nǝ̀ lidǝmba nǝ pak cauɓikea, acemǝnana sǝm pa aɓata Nggurcau ɗàng, sǝm nda aɓata ɓwamuru mala Ɓakuli ka le? Awo, pà nǝ̀ pak ɗàng! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Wu sǝlǝ mbak ama, ɓwa mǝnana wu pa ɓamur rǝ wun, wu kǝ oki wi kǝla aguro ka, wu dumǝna aguro male, ko mala cauɓikea na, mǝnana nǝ̀ kánǝ wun a lú, ko mala okiru mǝnana nǝ̀ kánǝ wun a docauɓoarna ka?<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 6:24">Mat 6:24</ref>; <ref loc="JHN 8:34">Yoh 8:34</ref>; <ref loc="ROM 12:1">Rom 12:1</ref></char>.</note> <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Ɓǝ̀ sǝm pakki Ɓakuli yàwá ama, wun mǝnana ɗiɗyal, wu nda ka aguro mala cauɓikea ka, adyan ngga, wu kpana atà mǝsǝcau mǝnana wu kumi aɓa kanigir ka, nǝ ɓabum wun kat. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Adyan ngga, à panzǝna wun a bu cauɓikea, ado ka, wu dumǝna aguro mala cauɓoarna.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />Ən bangga wun cau nǝ kanicau arǝ duk guro aɓa nggūrǝu atàcau mala gattya mala ɗenyicau ma'wun arǝ bwalta agir mala bangŋo. Kǝla mǝnana ɗiɗyal, wu pà ɓamur rǝ wun kǝla aguro, wu lidǝmba nǝ lime aɓa pakki agirɓana andǝ atúró ɓealɓikea ka, anggo gbal ado ka, wun nǝ̀ pà ɓamur rǝ wun kat, wu duk aguro mala cauɓoarna aban ká do mǝfele. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Mǝnana ɗiɗyal wu nda ka aguro mala cauɓikea ka, kǝgìr oasǝ wun arǝ do cauɓoarna ɗang. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Sǝ ya gìr mǝɓoarne na wu kùmô aɓa pakki amǝno yì agir ɗiɗyal, mǝnana adyan ngga à dupa wun agir kǝsǝkya ka? Masǝlǝata mǝno yì agir ka, nda lú! <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Sǝ ado ka, à panzǝkina wun a bu cauɓikea, wu dumǝna aguro mala Ɓakuli, gìr mǝnana wun nǝ̀ kum aɓalǝi ka nda do mǝfele, sǝ masǝlǝate ka nda yilǝmu mǝnana málá male pà kàm raka. <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Tangnakusǝ cauɓikea ka, lú na, sǝ ɓoro mala Ɓakuli ka, nda yilǝmu mǝnana málá male pà kàm raka, nǝ bu Kǝrǝsti Yesu Mǝtala sǝm.<note caller="+" style="f"><char style="fr" closed="false">6:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 5:12">Rom 5:12</ref>,<ref loc="ROM 5:21">21</ref>; <ref loc="GAL 6:7-8">Gal 6:7-8</ref></char>.</note><verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Cau mǝnana Nggurcau <optbreak /> mala Musa bang <optbreak /> amur doɓala ka</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Sǝ wun amǝ'eambǝam mǝnana wu súrǝ̀ Nggurcau ka, wu sǝlǝ mbak ama Nggurcau ka ndanǝ rǝcandǝa amur ɓwa yi mǝnana ɓǝ̀ ɓwe ka ndanǝ yilǝmu più ka? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Wu sǝni ani: à nê mala Nggurcau ka, ɓwama pa nǝ̀ nying burí ɗang, yi mana ɓǝ̀ burí nanǝ yilǝmu ka. Sǝ ɓǝ̀ burí wu ka, ɓwame purni mǝno yì Nggurcau mala doɓala ka.<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 7:39">1Kor 7:39</ref></char>.</note> <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Ace mani ka, ɓǝ̀ mǝnia yì ɓwama puro al ɓe ɓwabura sǝ burí na nǝ mǝsǝì ka, nda aɓa pak cauɓikea nongnǝban a nza nǝ doɓala. Sǝ ɓǝ̀ burí pak lú ka, ɓwame purni mǝno yì Nggurcau ka, nǝ̀ gandǝ al ɓe ɓwabura, sǝ ɓǝ̀ pa anggo ka, pa aɓa pak cauɓikea nongnǝban a nza nǝ doɓala ɗàng.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Anggo gbal, wun amǝ'eambǝam, wun gbal ka wu wunî Nggurcau, acemǝnana wu nda aɓa nggūrǝ Kǝrǝsti a lú male. Ado ka, wu nda ka mala Kǝrǝsti, mana à loasǝi a ɓembe ka, ace mǝnana ɓǝ̀ sǝm pusǝ atúró mǝɓoarne ace Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:2">Rom 6:2</ref>,<ref loc="ROM 6:11">11</ref>; <ref loc="GAL 2:19">Gal 2:19</ref>; <ref loc="COL 1:22">Kol 1:22</ref></char>.</note> <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Aɓa do ma'sǝm ɗiɗyal mǝnana nggūrǝ sǝm na kǝ gingnǝ sǝm ngga, anpel mala cauɓikea mana Nggurcau loasǝia aɓa nyam sǝm ngga, à ndarǝ pak túró, sǝ ko man sǝm pak kat ka, mala ká lú na.<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:13">Rom 6:13</ref>,<ref loc="ROM 6:21">21</ref>; <ref loc="ROM 8:8">8:8</ref>; <ref loc="JAS 1:15">Jem 1:15</ref></char>.</note> <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Sǝ adyan ngga, sǝm purnì Nggurcau, acemǝnana sǝm wuna aban agir mǝnana ɗiɗyal à bwal sǝm a guro ka. Sǝm ado ka, sǝm nggǝ pak túró ɗǝm a njar mǝ'e mala Nggurcau mana à gilǝì nǝ́ gilǝa ka ɗàng; túró ma'sǝm a dyan ngga, nda a njar mǝbǝshe mala Bangŋo.<verse eid="ROM 7:6" /></para>
  <para style="s">Nggurcau mala Ɓakuli kǝ <optbreak /> lǝmdǝ túró cauɓikea ma'sǝm</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Sǝ mana ado sǝm nǝ̀ na? Nggearǝ Nggurcau ka, cauɓikea na le? Awo! Pa anggo ɗang! Ɓǝ̀ pà ace Nggurcau raka, ɓǝ́ pà mǝ nǝ súrǝ̀ cauɓikea ɗang. Ɓǝ́ pa mǝ nǝ sǝlǝ ce cauɓikea mala sham gìr mala ɓwa ɗang, mǝnana ɓǝ̀ Nggurcau bang ma ama, &lt;&lt;Kǝa sham gìr raka&gt;&gt; ɗang.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:17">Pur 20:17</ref>; <ref loc="DEU 5:21">Nggur 5:21</ref></char>.</note> <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Sǝ cauɓikea ka, paktúró nǝ mǝnia yì nzongcau ka, pǝlǝa loasǝ ambalang shamgìr ɗàngɗáng a ɓalǝam! Sǝ ɓǝ̀ pa ace cau mala nzongcau raka, ɓǝ́ cauɓikea ka lugir na. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Mǝnana ǝn malaká sǝlǝ ce nzongcau raka, mǝ ndanǝ yilǝmu; sǝ lang nzongcau yina ka, cauɓikea long nǝ yilǝmu, sǝ ǝn pǝlǝ lú. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Nggearǝ nzongcau mǝnana ɓoaro ɓǝ̀ lǝmdǝam njargula yilǝmu ka, pǝlǝa wal-luem.<note caller="+" style="f"><char style="fr" closed="false">7:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 18:5">Pǝris 18:5</ref>; <ref loc="ROM 10:5">Rom 10:5</ref></char>.</note><verse eid="ROM 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 7:11" />Cauɓikea kara kum njar atà nzongcau, pǝlǝa swarkiam, sǝ pak túró nǝ nzongcau, wal-luem.<note caller="+" style="f"><char style="fr" closed="false">7:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 3:13">Tite 3:13</ref></char>.</note><verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />Ace mani ka, Nggurcau ka mǝfele na, sǝ nzongcau ka mǝfele na, sǝ nda pepè, sǝ mǝɓoarne na. <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />Ado ka, gìr mǝɓoarne yinǝàm nǝ lú le? Awo, pa anggo ɗàng! Kǝ cauɓikea nda paktúró nǝ gir mǝɓoarne, sǝ yinǝàm nǝ lú, ace mǝnana cauɓikea ka, ɓǝà súrǝì ama cauɓikea na. Sǝ atàcau mala nzongcau ka, cauɓikea nǝ̀ lǝmdǝ ɓike male kǝ̀rkǝ́r.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Sǝm sǝlǝna ama Nggurcau ka, gìr mala Bangŋo na, sǝ mim ngga mǝ nda ɓwa aɓa nggūrǝu, guro aɓata cauɓikea. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Ən bwalta agir mǝnana ǝn pakki ka ɗàng, acemǝnana gìr mǝnana ǝn earkiyi ce pe ka nda ǝn pakkiyi ka ɗàng. Sǝ gìr mǝnana ǝn ɓinǝce ka, nda ǝn pakkiyi ka.<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 5:17">Gal 5:17</ref></char>.</note> <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Sǝ ɓǝ̀ ǝn nggǝ pak gìr mǝnana ǝn earkiyi ce pe raka, ǝn earǝna ama Nggurcau ka, ndanǝ ɓoaro. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Ace mani ka, mǝ nda mǝnana ɗǝm ǝn pakkiyi mǝnia yì gir mǝɓane ka ɗàng, kǝ cauɓikea mǝnana do a ɓalǝam ngga, nda pakkiyi ka. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Ən sǝlǝna nǝma kǝgìr mǝɓoarne pa a ɓalǝam, aɓa nggūrǝam ɗàng. Ən nggǝ earce pak gir mǝnana pepè ka, sǝ ǝn gandǝ pe ɗàng. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Ən gandǝ pak mǝɓoarne mǝnana ɓoaro ɓǝ̀ ǝn pe ka ɗàng, kǝ mǝɓike mǝnana ǝn earkiyi ce pe raka, nda ǝn nggǝ pak ka. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Sǝ ɓǝ̀ ǝn nggǝ pak gìr mǝnana ǝn earkiyi ce pe raka, mǝnia ka lǝmdǝ ama, mǝ nda ɗǝm ǝn pakkiyi mǝnia yì gìr ka ɗàng, kǝ cauɓikea mǝnana do a ɓalǝam ngga nda pakkiyi gìr nì ka.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Anggo sǝ yi dupam nggurcau, mǝnana ɓǝ̀ ǝn earce nǝma mǝ nǝ pak mǝɓoarne ka, ǝn gandǝ pe ɗàng, kara ǝn kum ɓamúràm aban pak mǝɓike. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Aɓa yilǝmem ngga ban kǝ ɓoaram arǝ Nggurcau mala Ɓakuli. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Sǝama ǝn nggǝ sǝn ɓekǝ rǝcandǝa a ɓalǝam aban munǝo arǝ ɓabumam, kǝ ciem mǝ duk guro aɓata nggurcau mala cauɓikea mǝnana do a ɓalǝam ngga. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ya ulang dotanni nda mem! Yana nǝ̀ amsǝam aɓa mǝnia yì nggūrǝu mǝnana kǝ kánǝ mim a lú ka le? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Sǝm pakki Ɓakuli yàwá, ace amsǝban mǝnana ndakam nǝ bu Yesu Kǝrǝsti, Mǝtala sǝm ngga!</para>
  <para style="p" vid="ROM 7:25">Mǝno ka nda gìr mǝnana ado mǝ nda ɓālǝi ka: a ɓabumam ngga, ǝn earnace kpata Nggurcau mala Ɓakuli, sǝ nǝ nggūrǝam ngga, mǝ nda guro mala túró cauɓikea.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Do ɓá Bangŋo</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Adyan ngga ɓashi pà kàm ɗǝm amur aɓwana mǝnana à nda aɓa Kǝrǝsti Yesu ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 5:16">Rom 5:16</ref></char>.</note> <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Acemǝnana, nggurcau mala Bangŋo mǝnana yinǝa sǝm yilǝmu aɓa Kǝrǝsti Yesu ka, panzǝkina sǝm a bu nggurcau mala cauɓikea andǝ lú.<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 15:45">1Kor 15:45</ref>; <ref loc="ROM 6:14">Rom 6:14</ref>,<ref loc="ROM 6:18">18</ref></char>.</note> <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Gìr mǝnana Nggurcau mala Musa gandǝ pe raka, atàcau mala gatti mala nggūrǝ ɓwapǝndǝa mǝ'cauɓike ka, Ɓakuli yi pe. Yi tasǝ Muni ɓǝ̀ yiu aɓa nggūrǝu mǝnana nda kǝla nggūrǝ sǝm aɓwapǝndǝa mǝ'cauɓike ka, ɓǝ̀ yi pa ɓamúrì kǝla gir'nkila ace twal cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="fq" closed="false">twal cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;ace panzǝki rǝcandǝa mala cauɓikea amur sǝm.&gt;&gt;</char></note> Aɓa pě mǝnia anggo ka Ɓakuli yinǝ kasǝ-ɓashi amur cauɓikea, kiɗiki rǝcandǝa male aɓa mǝno yì nggūrǝu mala ɓwapǝndǝa ka.<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 13:39">Atúró 13:39</ref>; <ref loc="HEB 2:14">Ib 2:14</ref>; <ref loc="HEB 7:18">7:18</ref>; <ref loc="HEB 10:1-2">10:1-2</ref>; <ref loc="PHP 2:7">Filp 2:7</ref></char>.</note> <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Ɓakuli pe anggo ace mǝnana nzongcau mala Nggurcau male, arǝ anjarì kat ka, ɓǝ̀ kum lùmsǝo puppup kǝla mana earkiyice ka, aɓalǝ sǝm, sǝm mǝnana do ma'sǝm ngga nggūrǝu na sǝm ginggiyi atè raka, Bangŋo na ka.<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 3:31">Rom 3:31</ref>; <ref loc="GAL 5:16">Gal 5:16</ref>,<ref loc="GAL 5:25">25</ref></char>.</note><verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Aɓwana mǝnana do malea ka, à kǝ kpata gìr mana nggūrǝu kǝ banggia wia ka, ɓabumia nǝ̀ pa arǝ gir mǝnana nggūrǝu earkiyice ka. Sǝ aɓwana mǝnana do malea ka, Bangŋo na kǝ gingnǝia ka, ɓabumia nǝ̀ pa arǝ gir mǝnana Bangŋo earkiyice ka.<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 5:19-25">Gal 5:19-25</ref></char>.</note> <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Ɓǝ̀ nggūrǝu na kǝ gingnǝ ɗenyicau ma'wun, masǝlǝate ka lú na. Sǝ ɓǝ̀ Bangŋo na kǝ gingnǝ ɗenyicau ma'wun, masǝlǝate ka yilǝmu na andǝ dorǝpwala.<note caller="+" style="f"><char style="fr" closed="false">8:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:21">Rom 6:21</ref>; <ref loc="ROM 8:13">8:13</ref>,<ref loc="ROM 8:27">27</ref>; <ref loc="GAL 6:8">Gal 6:8</ref></char>.</note> <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Lǝmdǝ ama aɓwana mǝnana à dum nǝ ɓabum mala kpata nggūrǝu ka, à dumǝna aɓibura mala Ɓakuli; yia ka à kǝ kpata nzongcau mala Ɓakuli ɗang, sǝ aɓa mǝsǝcau ka, à pà nǝ̀ gandǝ kpate ɗàng. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Aɓwana mǝnana nggūrǝu na kǝ gingnǝia ka, à pà nǝ̀ gandǝ pwasǝbum Ɓakuli ɗang.<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 7:5">Rom 7:5</ref></char>.</note><verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Sǝ wun ngga, nggūrǝu mala cauɓikea na gingginǝ wun ngga ɗàng, Bangŋo na, ɓǝ̀ Bangŋo mala Ɓakuli na dukiyi a ɓabum wun ngga. Ɓwa mǝnana pànǝ Bangŋo mala Kǝrǝsti a ɓabumi raka, ɓwe ka màlà Kǝrǝsti na ɗang.<note caller="+" style="f"><char style="fr" closed="false">8:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 3:16">1Kor 3:16</ref>; <ref loc="1CO 6:19">6:19</ref>; <ref loc="2CO 6:16">2Kor 6:16</ref>; <ref loc="2TI 1:14">2Tim 1:14</ref></char>.</note> <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Sǝ ɓǝ̀ Kǝrǝsti na a ɓabum wun, kat andǝ amani ama nggūrǝ wun ngga lú na atàcau mala cauɓikea ka, Bangŋo kǝ tsǝa ɓǝ̀ wu dum nǝ yilǝmu, acemǝnana à gilǝkina nre wun wunǝa Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 2:20">Gal 2:20</ref>; <ref loc="EPH 3:17">Afi 3:17</ref></char>.</note> <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Ɓǝ̀ Bangŋo mala Ɓakuli mǝnana loasǝ Yesu a ɓembe, nda aban do a ɓabum wun, anggo gbal kǝla mǝnana Ɓakuli loasǝ Kǝrǝsti a ɓembe ka, nǝ̀ pè nggūrǝ wun mǝnana dupî lú ka yilǝmu, nǝ bu Bangŋo male mǝnana dukiyi a ɓabum wun ngga.<note caller="+" style="f"><char style="fr" closed="false">8:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 3:16">Kol 3:16</ref>; <ref loc="JHN 5:21">Yoh 5:21</ref></char>.</note><verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Ace mani ka, wun amǝ'eambǝam, tangna na amur sǝm, sǝ tangnê ka nda mǝnana ama ɓǝ̀ sǝm ngga dukdo kpata gìr mǝnana nggūrǝu earkiyice ka ɗàng. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Ɓǝ̀ wu kǝ dukdo kpata nê mala nggūrǝu ka, wun nǝ̀ wú. Sǝama ɓǝ̀ aɓa rǝcandǝa mala Bangŋo, wu tamsǝ pakkia atúró cauɓikea mala nggūrǝu, à wù mak ka, wun nǝ̀ dum nǝ yilǝmu.<note caller="+" style="f"><char style="fr" closed="false">8:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 8:6">Rom 8:6</ref>; <ref loc="COL 3:5">Kol 3:5</ref></char>.</note> <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Aɓwana mǝnana Bangŋo mala Ɓakuli na kǝ gingnǝia ka, à nda ka muna mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">8:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 5:18">Gal 5:18</ref></char>.</note> <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Bangŋo mǝnana à pà wun ngga, nda mǝnana nǝ̀ tsǝk wun a guro aban ká do ɓangciu ɗǝm ngga ɗàng. Bangŋo mala pǝlǝ wun ɓǝ̀ wu duk amuna mala Ɓakuli na. Sǝ nǝ́ rǝcandǝa mala Bangŋo ka, koyan atà sǝm ngga nǝ̀ ɓua a ban Ɓakuli, nǝ̀ tunǝi ama, &lt;&lt;Dàdá!<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="fq" closed="false">Dàdá: </char><char style="ft" closed="false">nǝ kún Aramayik ka nda </char><char style="fqa" closed="false">&lt;&lt;Abba.&gt;&gt;</char></note>&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 14:36">Mar 14:36</ref>; <ref loc="ROM 9:4">Rom 9:4</ref>; <ref loc="GAL 4:5-7">Gal 4:5-7</ref></char>.</note> <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Bangŋo mala Ɓakuli nǝ ɓamúrì ka, kǝ bangga sǝm a ɓabum sǝm ama sǝm nda ka amuna mala Ɓakuli. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Sǝ acemǝnana sǝm nda ka amuna male ka, sǝm nǝ̀ kum kāmbe ma'sǝm mala liɓala male, mǝnana tsǝì ace aɓwana male ka. Ɗǝm ngga, sǝm nǝ̀ kum sǝnǝa Yesu, gìr mǝnana kat Ɓakuli tsǝì ace ka. Ɓǝ̀ kàngkàng sǝm nu tanni atà Kǝrǝsti ulang mǝnana nu ka, sǝm nǝ̀ kum gbal aɓa male yì gulo.<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 3:29">Gal 3:29</ref>; <ref loc="GAL 4:7">4:7</ref>; <ref loc="2CO 1:5">2Kor 1:5</ref>,<ref loc="2CO 1:7">7</ref>; <ref loc="2TI 2:12">2Tim 2:12</ref>; <ref loc="1PE 4:13">1Bit 4:13</ref></char>.</note><verse eid="ROM 8:17" /></para>
  <para style="s">Gulo mǝnana nǝ̀ yiu ka</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ən nggǝ sǝni, atanni mǝno sǝm nggǝ nu ado ka, à kārǝa à nǝ̀ kāria arǝ gulo mǝnana à nǝ̀ nggá lǝmdǝa sǝmi nǝnzǝ́mò ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">8:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 4:17">2Kor 4:17</ref>; <ref loc="COL 3:4">Kol 3:4</ref>; <ref loc="1PE 5:1">1Bit 5:1</ref></char>.</note> <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Agirbunda mǝnana Ɓakuli pusǝia ka, à ndarǝ kúndǝô, nǝ rǝɓǝla, arǝ pwari mǝno Ɓakuli nǝ̀ lǝmdǝ rǝ amuna male amǝ'ɓafoe nǝi ka.<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1PE 1:7">1Bit 1:7</ref>,<ref loc="1PE 1:13">13</ref>; <ref loc="1JN 3:2">1Yoh 3:2</ref></char>.</note> <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Girbunda kat mana Ɓakuli pusǝì ka kum ɓamúrì aɓata do ɗwanyi kum-lùmsǝó mala kàne male, kǝ pǝlǝki nǝ ɓālǝi ɓà. Sǝ mǝnia ka pà acemǝnana eare male na ka ɗàng, pě mala Ɓakuli mana tsǝì a ɓālǝi ka nda. Kat andǝ amani ka, tsǝkɓalǝu na kam<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 3:17-19">Tite 3:17-19</ref>; <ref loc="ECC 1:2">Ham 1:2</ref></char>.</note> <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ama, ɓanza nǝ ɓamúrì ka, nǝ̀ nggá kum amsǝban a bu kùrban mala kìɗìkì<note caller="+" style="f"><char style="fr" closed="false">8:21 </char><char style="fq" closed="false">a bu kùrban mala kìɗìkì </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">&lt;&lt;mala purî ɓá nsolo mala dupî ká lú andǝ rǝmbo.&gt;&gt;</char></note> male, sǝ à nǝ̀ yinǝi aɓa kum-ɓamúrû mǝɓoarɓwe mala amuna mala Ɓakuli.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Sǝm sǝlǝna ama agir mǝnana à pusǝia a ɓanza kat ka, à nda ban imge aɓa kwanban, kǝla ɓwama mǝnana nda aɓa kwanban mala gbáshí ka, bà yalung. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Sǝ yì agir ka, à nda mǝnana nǝmurǝia à kǝ imgi ka ɗàng; nggearǝ sǝm mǝnana sǝm kumǝna Bangŋo Mǝfele mana ndà mǝdǝmbe mala aɓoro mǝnana Ɓakuli nǝ̀ pa sǝm ngga, sǝm nggǝ imge aɓa ɓalǝ sǝm. Sǝ aɓa imge anggo ka, sǝm nggǝ kúndǝ arǝ Ɓakuli nǝ rǝɓǝla, ɓǝ̀ yinǝ sǝm aɓa kum lùmsǝo ma'sǝm a baní mala duk amuna male, mǝnana anggūrǝ sǝm nǝ̀ kum panzǝban a bu cauɓikea, andǝ tanni, andǝ lú ka.<note caller="+" style="f"><char style="fr" closed="false">8:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2CO 1:22">2Kor 1:22</ref>; <ref loc="2CO 5:2">5:2</ref>,<ref loc="2CO 5:4">4</ref>; <ref loc="GAL 5:5">Gal 5:5</ref></char>.</note><verse eid="ROM 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 8:24" />Àkǝ̀ ɓá mǝnia yì tsǝkɓalǝu sǝ sǝm kum àwá.<note caller="+" style="f"><char style="fr" closed="false">8:24 </char><char style="fq" closed="false">Àkǝ̀ ɓá mǝnia yì tsǝkɓalǝu sǝ sǝm kum àwá. </char><char style="ft" closed="false">Ko &lt;&lt;À pà sǝm mǝnia yì tsǝkɓalǝu lang à amsǝ sǝm ngga.&gt;&gt;</char></note> Sǝama tsǝkɓalǝu mǝnana ado à nǝ̀ gandǝ sǝni nǝ mǝsǝu ka, à pà nǝ̀ na ama tsǝkɓalǝu na ɗang. Lang sǝ ɓwa nǝ̀ tsǝkɓalǝi ado arǝ gir mǝnana ndanǝi a buì kǝ sǝni ka? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Sǝ ɓǝ̀ sǝm ndanǝ tsǝkɓalǝu arǝ gir mǝnana ado sǝm pà nǝi peatu, sǝm sǝni raka, sǝm nǝ̀ kúndǝ gir nî nǝ domunyi.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Anggo gbal, Bangŋo ka kǝ bwala sǝm nggam aɓa gatti ma'sǝm. Acemǝnana sǝm ngga, sǝm súrǝ̀ lang sǝ sǝm nǝ̀ pak hiwi, kǝla mǝnana ɓoaro ɓǝ̀ sǝm pak ka ɗàng, sǝama Bangŋo mala Ɓakuli nǝ nggearǝì ka, kǝ pak hiwi ace sǝm, nǝ imge mǝnana à pà nǝ̀ gandǝ cie aɓa cau raka. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Sǝ Ɓakuli mǝnana sǝngiyi ɓabum ngga, súrǝ́nà rǝ ɗenyicau mala Bangŋo. Acemǝnana Bangŋo kǝ zǝmba ace aɓwana mala Ɓakuli, amur gir mǝnana nê mala Ɓakuli na ka.<note caller="+" style="f"><char style="fr" closed="false">8:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 139:1-2">Ang 139:1-2</ref>; <ref loc="LUK 16:15">Luk 16:15</ref>; <ref loc="REV 2:23">Sǝn 2:23</ref>; <ref loc="ROM 8:6">Rom 8:6</ref>,<ref loc="ROM 8:34">34</ref></char>.</note><verse eid="ROM 8:27" /></para>
  <para style="s">Sǝm kútì amǝ limurǝm</para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Sǝ sǝm sǝlǝna ama Ɓakuli kǝ tsǝk agir kat ɓǝà pang nǝ ɓoaro, ace lidǝmba mala aɓwana mǝnana à kǝ earce ka, aɓwana male mǝnana tunǝia ace kpata kàne male ka. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Aɓwana mǝnana Ɓakuli angŋa dǝmba twalǝ̀nia ka,<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="fq" closed="false">angŋa dǝmba twalǝ̀nia ka: </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">&lt;&lt;angŋa dǝmba súrǝ́nia à nda ka male ka.&gt;&gt;</char></note> nda gbal tària ɓǝà do kǝla Muni, ace mǝnana ɓǝ̀ Muni duk muna-dǝmba aɓalǝ amǝ'eambi mǝnana pas ka.<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 9:23">Rom 9:23</ref>; <ref loc="ROM 11:2">11:2</ref>; <ref loc="1PE 1:2">1Bit 1:2</ref>,<ref loc="1PE 1:20">20</ref>; <ref loc="EPH 1:5">Afi 1:5</ref>,<ref loc="EPH 1:11">11</ref></char>.</note> <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Sǝ aɓwana mǝnana Ɓakuli tària ka, à nda ka amǝnana gbal tunǝia ka, sǝ aɓwana mǝnana tunǝia ka, angŋǝnia, à dumǝna aɓwana amǝ'cauɓoarna a baní, sǝ aɓwana mǝnana angŋǝnia ka, à nda gbal yinǝia aɓa kum gulo male ka.<verse eid="ROM 8:30" /></para>
  <para style="s">Earcearǝu mala Ɓakuli</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Sǝ mana ado sǝm nǝ̀ na, amur amǝnia yì agir ka? Ɓǝ̀ Ɓakuli ka nda atà sǝm ngga, yana ɓwe nǝ̀ lo arǝ sǝm?<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 118:6">Ang 118:6</ref></char>.</note> <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Ɓakuli ka girban nǝ Muni ɗàng, pà Muni ace sǝm kat! Sǝ ɓǝ̀ pà Muni ace sǝm ngga, pà nǝ̀ gandǝ pa sǝm ɓoro nǝ agir gbal kat re?<note caller="+" style="f"><char style="fr" closed="false">8:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JHN 3:16">Yoh 3:16</ref>; <ref loc="ROM 4:25">Rom 4:25</ref></char>.</note> <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Yana ɓwe na nǝ̀ wuli aɓwana mǝnana Ɓakuli tària ka? Kǝ ɓwa pà kàm ɗàng! Acemǝnana Ɓakuli nǝ́ ɓamúrì nǝ̀ cia sǝ à duk amǝ'cauɓoarna!<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LUK 18:7">Luk 18:7</ref>; <ref loc="ISA 50:8-9">Isha 50:8-9</ref></char>.</note> <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Yana ɓwe na ado kasǝkiyi ɓashi amur sǝm? Yesu Kǝrǝsti na le, yì ɓwa mǝnana yi wú, sǝ lo nǝ yilǝmu, nda a bù-mǝlì mala Ɓakuli, kǝ zǝmba ace sǝm ngga le? <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Sǝ, yana nǝ̀ gau sǝm sǝnǝa earcearǝu mala Kǝrǝsti? Tanni na nǝ̀ tsǝk ka le, ko do mǝkwane, ko pàtanni, ko nzala na, ko tǝ̀r na, ko kum ɓamuru aɓa ká-mǝɓane na, ko a na raka, lú na le? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Kǝla mǝnana Malǝmce na ka,</para>
  <para style="q1" vid="ROM 8:36">&lt;&lt;Nda aceò, we</para>
  <para style="q2" vid="ROM 8:36">Mǝtalabangŋo</para>
  <para style="q1" vid="ROM 8:36">sǝ sǝm nggǝ sǝn tanni,</para>
  <para style="q2" vid="ROM 8:36">a koya pwari ka,</para>
  <para style="q2" vid="ROM 8:36">mǝnana nǝ̀ kánǝban a lú ka.</para>
  <para style="q1" vid="ROM 8:36">Sǝm ado ka sǝm nda</para>
  <para style="q2" vid="ROM 8:36">kǝla anzur mǝnana</para>
  <para style="q1" vid="ROM 8:36">à nǝ̀ nggá pwangi</para>
  <para style="q2" vid="ROM 8:36">myalia ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:36 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 44:22">Ang 44:22</ref></char>.</note><verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Awo! Aɓalǝ amǝnia yì agir kat ka, sǝm kútì amǝ'limurǝm, nǝ bu Kǝrǝsti mǝnana earce sǝm ngga! <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Ən earǝna nǝi a ɓabumam ama kǝgìr pà nǝ̀ gau sǝm sǝnǝa earcearǝu mala Ɓakuli ɗàng. Ko ɓǝ̀ lú na, ko àwá, ko amǝturonjar, ko arǝcandǝa mala akukwar, ko ɓǝ̀ ya rǝcandǝa nani ka, à kārǝa à nǝ̀ gau sǝm ɗàng. Ko ɓǝ̀ agir mǝnana à kǝ kumban a nza man, ko a nza mǝno nǝ̀ yiu ka, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ko agir mǝnana a kùli, andǝa mǝnana atà nzali ka, à karǝ ɗang. Kǝgìr pà kàm aɓa ɓanza man, mǝnana nǝ̀ gandǝ gau sǝm sǝnǝa earcearǝu mala Ɓakuli, mana aɓa Kǝrǝsti Yesu Mǝtala sǝm ngga ɗàng.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Ɓakuli andǝ aɓwana male</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Mim ngga mǝsǝcau nda ǝn nggǝ na aɓa Kǝrǝsti ka. Giu-ɓabumam mǝnana Bangŋo Mǝfele nda ginggiyi nǝi ka, kǝ lǝmdǝam ama kàngkàng nyir na ǝn nakiyi ka ɗang ɓǝn na wun nǝma <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />mǝ ndanǝ bumkiɗikea kǝ̀rkǝ́r andǝ pi mala ɓabum koya pwari <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />ace aɓwana mem, amǝ'eambǝam aɓa nggūrǝu ka. Ən earǝna ɓǝà suem, ko ɓǝà gau sǝm sǝnǝa Kǝrǝsti, ɓǝ̀ mǝno ka nǝ̀ kánǝia ɓǝà kum amsǝban ngga. <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />Yia ka à nda ka amǝ'kàu mala Isǝrayila; Ɓakuli tárìa ɓǝà duk amuna male; Ɓakuli lǝmdǝ gulo male kǝla Ɓakuli a bania. Kùrcau andǝia, sǝ pea wia Nggurcau male. Pea wia peri mala ɓa-ndàmǝgule andǝ apacau male. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />A Ibǝrayim, andǝ Yakupu, andǝ Ishaku ka à nda ka keà mǝnana nǝ bania sǝ tàu ɓǝlban aɓa nggūrǝu mala Kǝrǝsti pur ka. Ɓwangsǝban mǝnana málá male pà kàm raka ɓǝà pè Ɓakuli mǝnana nda amur aɓwana kat ka! Ɓǝ̀ do anggo.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Ado ka mǝ nda rǝ na ama Ɓakuli ka gandǝ lùmsǝ pàcau male aban Isǝrayila ɗàng le? Awo pa anggo ɗàng, acemǝnana aɓwana mǝnana à ɓǝlia a Isǝrayila ka, kat sǝ à nda ka ɓwana mala Ɓakuli ɗang! <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Sǝ ɗǝm ngga aɓwana nda mǝnana kat teà pur nǝ ban Ibǝrayim, sǝ à nda ka amuna mala Ɓakuli ka ɗàng. Ɓakuli ka bangŋǝni Ibǝrayim ama, &lt;&lt;Aɓa Ishaku sǝ amǝ'keò mǝnana ǝn po cau acea ka, à nǝ̀ puro.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 21:12">Tite 21:12</ref></char>.</note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Mǝnia ka lǝmdǝ ama amuna mǝnana à ɓǝlia aɓa nggūrǝu a tàu mala Ibǝrayim ngga, à nda mǝnana à nda ka muna mala Ɓakuli ka ɗàng. Kǝ amuna mǝnana à ɓǝlia atàcau mala kùrcau mala Ɓakuli ka, à nda ka mǝnana à súrǝ̀ia kǝla amǝkau mala Ibǝrayim ngga. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Ani sǝ Ɓakuli bang pàcau male aban Ibǝrayim: &lt;&lt;Pǝlǝa mǝnia nǝ̀ yia kàr ka, mǝ nǝ nyare, sǝ Saratu nǝ̀ ɓǝl muna-ɓwabura.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 18:10">Tite 18:10</ref></char>.</note><verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Sǝ mǝno nda nǝmurǝì ɗàng, Rabeka gbal ka ɓǝl amuna-burana ɓari. Sǝ amǝno yì amuna ka tárrià mwashat, yì kà-sǝm Ishaku. <verse eid="ROM 9:10" /><verse number="11-12" style="v" sid="ROM 9:11-12" />Sǝ lang Rabeka málá nǝ̀ gbáshí amǝnia yì apasa ka, Ɓakuli ne wi ama, &lt;&lt;Muna-dǝmba nǝ̀ do aɓata ɓwamǝkyauwe.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:11-12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 25:23">Tite 25:23</ref></char>.</note> Ɓakuli bang mǝnia ka kaniama à nǝ̀ ɓǝlia, sǝ kaniama à nǝ̀ súrǝ̀ mǝɓoarne ko mǝɓane ka. Mǝnia ka lǝmdǝ ama Ɓakuli ka, nda rǝ pak gìr mǝnana ɓabumi kànì nǝ̀ pè ka, twal a tite; pa ace ɓè kǝgìr mǝnana amuna mǝnia pak ka ɗàng, nda ace gìr mǝnana Ɓakuli earce sǝ twal ka. <verse eid="ROM 9:11-12" /><verse number="13" style="v" sid="ROM 9:13" />Kǝla mǝnana Malǝmce na ama, &lt;&lt;Yakupu ka ǝn earǝna ce, sǝ Isǝwa ka ǝn ɓinǝna mǝsǝì.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 1:2">Mal 1:2</ref>,<ref loc="MAL 1:3">3</ref></char>.</note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Sǝ aman sǝ sǝm nǝ̀ bang amur mǝno? Ɓakuli ka pak mǝɓike le? Awo! Pak mǝɓike ɗàng! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Acemǝnana Ɓakuli banggi Musa ama,</para>
  <para style="q1" vid="ROM 9:15">&lt;&lt;Mim ngga, mǝ nǝ lǝmdǝ</para>
  <para style="q2" vid="ROM 9:15">ɓwamuru aban ɓwa mǝnana</para>
  <para style="q2" vid="ROM 9:15">mǝ nǝ lǝmdǝì wi ɓwamuru ka.</para>
  <para style="q1" vid="ROM 9:15">Sǝ mǝ nǝ sǝn mǝsǝswatǝr</para>
  <para style="q2" vid="ROM 9:15">mala ɓwa mǝnana kat mǝ nǝ</para>
  <para style="q1" vid="ROM 9:15">sǝn mǝsǝswatǝr male ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 33:19">Pur 33:19</ref></char>.</note><verse eid="ROM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16" />Ace mani ka, Ɓakuli na twalkiyi ɓwa mǝnana nǝ̀ lǝmdǝì wi ɓwamuru ka. Sǝ twalban male ka kǝ kpata gìr mǝnana aɓwana earce ko à ɓariki pe ka ɗàng. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Aɓa Malǝmce ka, Ɓakuli banggi Murǝm mala amǝ Masar ama, &lt;&lt;Ən dumsǝo a buno-murǝm, ace lǝmdǝ rǝcandǝa mem a ɓālǝo, sǝ ɓanza kat ɓǝ̀ ok ce lullǝam.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 9:16">Pur 9:16</ref></char>.</note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Ace mani ka, Ɓakuli kǝ lǝmdǝ ɓwamuru male amur ko yana eare nǝ̀ lǝmdǝì ɓwamuru ka, sǝ kǝ candǝmúr ɓwa mǝnana eare nǝ̀ candǝmúrí ka.<verse eid="ROM 9:18" /></para>
  <para style="s">Bumlulla andǝ ɓwamuru <optbreak /> mala Ɓakuli</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Sǝ anggo ka, wun nǝ̀ gandǝ nam ama, &lt;&lt;Ɓǝ̀ ko man kat ka nda a bu Ɓakuli, sǝ yì nda gingginǝi ka, ace mana sǝ kǝ sǝn mǝɓane arǝ acauɓikea ma'sǝm più? Yana ɓwe nda ɗe nǝ̀ gandǝ ɓinǝ kàne male?&gt;&gt; <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Sǝ a nda yana, we ɓwapǝndǝa, yì mǝnana awu nǝ pǝlǝcau a kun Ɓakuli ka? &lt;&lt;Gìr mǝnana à pè nǝ́ pa ka, nǝ̀ gandǝ banggi ɓwa mǝnana pè ka ama, &lt;Palang sǝ a pem ani&gt; le?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 29:16">Isha 29:16</ref>; <ref loc="ISA 45:9">45:9</ref></char>.</note> <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Mǝɓaki-ankwaring ngga, pà nǝ́ rǝcandǝa mǝnana nǝ̀ ɓak nkwaring ace túró mǝgule andǝ nkwaring ace koya túró nani ka, aɓa ɗuro-dǝɓang mǝ'mwashati re?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Anggo gbal, ɓǝ̀ Ɓakuli earce ka, nǝ̀ gandǝ ukki bumlulla male amur aɓwana, sǝ nǝ̀ lǝmdǝ rǝcandǝa male. Sǝa ma yì ka, pak munyi nǝ gandǝrǝu nǝ aɓwana mǝnana ɓoaro ɓǝ̀ lǝmdǝia wia bumlulla ka, yia mǝnana à dupî ká kìɗìkì ka. <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Pak munyi ace mǝnana ɓǝ̀ lǝmdǝ kume mǝnana ndakam aɓa gulo male ace aɓwana mǝnana ɓwamuria ka, yia amǝnana akdǝmba tàriá ɓǝà kum kāmbe mala ɓoarɓwa male ka. <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />Sǝm nda ka mǝno yì aɓwana tàr sǝm ace ɓwamuru ka, sǝm mǝnana tunǝ sǝm aɓalǝ amǝ Yahudi, sǝ aɓalǝ aɓwana mala acili anzali gbal ka. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Kǝla mǝnana bang aɓa Malǝmce mala Hosiya ama:</para>
  <para style="q1" vid="ROM 9:25">&lt;&lt;Aɓwana mana</para>
  <para style="q2" vid="ROM 9:25">amem na raka,</para>
  <para style="q1" vid="ROM 9:25">mǝ nǝ tunǝia ama,</para>
  <para style="q2" vid="ROM 9:25">&lt;Aɓwana mem.&gt;</para>
  <para style="q1" vid="ROM 9:25">Aɓwana mǝnana</para>
  <para style="q2" vid="ROM 9:25">ǝn earcea raka,</para>
  <para style="q1" vid="ROM 9:25">mǝ nǝ tunǝia ama,</para>
  <para style="q2" vid="ROM 9:25">&lt;Aɓwana mem mǝnana</para>
  <para style="q1" vid="ROM 9:25">ǝn earkiyi acea raka.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 2:23">Hos 2:23</ref></char>.</note><verse eid="ROM 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="ROM 9:26" />Ɗǝm ngga,</para>
  <para style="q1" vid="ROM 9:26">&lt;&lt;Aban mana à banggia wia</para>
  <para style="q1" vid="ROM 9:26">ɗiɗyal ama,</para>
  <para style="q2" vid="ROM 9:26">&lt;Wun nda ka aɓwana</para>
  <para style="q1" vid="ROM 9:26">mem raka,&gt;</para>
  <para style="q2" vid="ROM 9:26">àkǝ̀ banì sǝ à nǝ̀ tunǝia ama,</para>
  <para style="q2" vid="ROM 9:26">&lt;Amuna mala Ɓakuli</para>
  <para style="q1" vid="ROM 9:26">mǝyilǝmui.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HOS 1:10">Hos 1:10</ref></char>.</note><verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />Ishaya ɓua ace amǝ Isǝrayila ama:</para>
  <para style="q1" vid="ROM 9:27">&lt;&lt;Ko ɓǝà na ama</para>
  <para style="q2" vid="ROM 9:27">làkkì mala amǝ Isǝrayila</para>
  <para style="q1" vid="ROM 9:27">ka nda kǝla sala a kun</para>
  <para style="q1" vid="ROM 9:27">nggeamùr ka,</para>
  <para style="q2" vid="ROM 9:27">kǝ bǝti aɓalǝia nda</para>
  <para style="q2" vid="ROM 9:27">à nǝ̀ kum àwá ka.<verse eid="ROM 9:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ROM 9:28" />Ɓakuli ka nǝ̀ yia sulǝ</para>
  <para style="q2" vid="ROM 9:28">ɓashi male mǝnana</para>
  <para style="q2" vid="ROM 9:28">kasǝni ka puppup amur ɓanza.</para>
  <para style="q1" vid="ROM 9:28">Banì pà nǝ̀ sau ɗang,</para>
  <para style="q2" vid="ROM 9:28">nǝ̀ yia pe tsuk-tsuk.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:28 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 10:22">Isha 10:22</ref>,<ref loc="ISA 10:23">23</ref></char>.</note><verse eid="ROM 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ROM 9:29" />Kǝla mǝnana Ishaya ak dǝmba bang ama:</para>
  <para style="q1" vid="ROM 9:29">&lt;&lt;Ɓǝ̀ Mǝtala Abangŋo</para>
  <para style="q1" vid="ROM 9:29">nyingma sǝm amǝkau raka,</para>
  <para style="q2" vid="ROM 9:29">ɓǝ́ sǝm dumǝna kǝla</para>
  <para style="q1" vid="ROM 9:29">amǝ Sodom,</para>
  <para style="q2" vid="ROM 9:29">ɓǝ́ sǝm pǝlǝna kǝla</para>
  <para style="q1" vid="ROM 9:29">amǝ Gomora.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:29 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 1:9">Isha 1:9</ref></char>.</note><verse eid="ROM 9:29" /></para>
  <para style="s">Ɓinǝ earnǝ cau mala Isǝrayila <optbreak /> arǝ Cau Amsǝban</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />Sǝ aman sǝ sǝm bangŋa? Aɓwana mala acili anzali mǝnana à kǝ kpata Nggurcau mala Ɓakuli raka, Ɓakuli nyesǝnia à pǝlǝna amǝ'cauɓoarna a baní, atàcau mala gūliarǝu malea arǝ Kǝrǝsti. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Sǝ amǝ Isǝrayila, mǝnana à ɓariki kǝ̀rkǝ́r à nǝ̀ kpata Nggurcau mǝnana ɓǝ́ nǝ̀ kánǝia aɓa kum do cauɓoarna aban Ɓakuli ka, ko à kumi ɗàng. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Palang ado sǝ à gandǝ kume ɗàng? À gandǝ kume ɗàng acemǝnana à kpate aɓa gūlì arǝ Ɓakuli ɗang, yia ka à gūlì amur ɓariki malea arǝ agir mǝnana à pea ka. Nda gìr mǝnana tsǝa sǝ à annda amur &lt;&lt;Tali annda&gt;&gt; ka.<note caller="+" style="f"><char style="fr" closed="false">9:32 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="1PE 2:6">1Bit 2:6</ref>,<ref loc="1PE 2:8">8</ref></char>.</note> <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Kǝla mǝnana à gilǝì aɓa Malǝmce ama:</para>
  <para style="q1" vid="ROM 9:33">&lt;&lt;Sǝni, mǝ ndya ǝn nggǝ</para>
  <para style="q1" vid="ROM 9:33">tsǝk muna-tali a Siyona,</para>
  <para style="q2" vid="ROM 9:33">mǝnana nǝ̀ tsǝk aɓwana</para>
  <para style="q1" vid="ROM 9:33">à nǝ̀ anndǝ́ ka,</para>
  <para style="q2" vid="ROM 9:33">andǝ nggea-tali mǝnana</para>
  <para style="q2" vid="ROM 9:33">nǝ̀ cia à nǝ̀ kpa ka.</para>
  <para style="q1" vid="ROM 9:33">Sǝa ma ɓwa mǝnana é</para>
  <para style="q1" vid="ROM 9:33">gūlì a rǝi ka,</para>
  <para style="q2" vid="ROM 9:33">pà nǝ̀ kum kǝsǝkya ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 8:14">Isha 8:14</ref>; <ref loc="ISA 28:16">28:16</ref></char>.</note><verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Wun amǝ'eambǝam, ɓabumam andǝ zǝmba mem aban Ɓakuli ka, nda ace amǝ Isǝrayila ɓǝà kum àwá. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Mǝ nda rǝ nakunia aɓa mǝsǝcau ama yia ka à ndanǝ bumpina arǝ kpata Ɓakuli, sǝ bumpina malea ka, pa aɓa sǝlǝe ɗàng. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Acemǝnana yia ka à bwalta njargula mǝnana Ɓakuli akiyina aɓwana nǝi ɓǝà duk amǝ cauɓoarna a baní ka ɗàng, sǝ ɗǝm ngga à kutia kwakita malea yì njar mala kum akban aban Ɓakuli, nǝ ɓariki malea arǝ bwal Nggurcau. Ace mani ka, à pa ɓamuria arǝ njar mala Ɓakuli mǝnana kǝ pǝlǝna aɓwana nǝi ɓǝà duk amǝ'cauɓoarna ka ɗàng. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Kǝrǝsti ka yi malǝna túró mala nê mǝnana Ɓakuli pà Nggurcau ace ka. Ace mǝno ka aɓwana mǝnana kat à earnǝi à paɓamuria a baní ka, à nyesǝnia amǝ'cauɓoarna na aban Ɓakuli.<verse eid="ROM 10:4" /></para>
  <para style="s">Amsǝban ngga nda ace ko yana ka</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Amur njar mala do mǝ'cauɓoarna a ban Ɓakuli, mǝnana à kumnggiyi nǝ bwal Nggurcau ka, Musa gilǝ ama, &lt;&lt;Ɓwa mǝnana kat kpata Nggurcau lùmsǝ agir mǝnana kat nzongcau male na ka, ɓwe nda nǝ̀ kum yilǝmu ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 18:5">Pǝris 18:5</ref></char>.</note> <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Sǝ ɓwa mǝnana pàɓamuru male aɓa gūlì arǝ Kǝrǝsti nda yinǝi wi kum akban aban Ɓakuli ka, pà nǝ̀ ɗiban a ɗenyicau male ama, &lt;&lt;Yana nǝ̀ eau a kùli, ace mǝnana nǝ̀ nggá sulǝ Kǝrǝsti a nzali ka&gt;&gt; ɗàng?<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 30:13">Nggur 30:13</ref></char>.</note> <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Pà nǝ̀ ɗiban gbal ama, &lt;&lt;Yana nǝ̀ sulǝo a tà-nzali, ace mǝnana nǝ̀ nggá loasǝ Kǝrǝsti a ɓembe ka&gt;&gt; ɗàng?<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 30:13">Nggur 30:13</ref></char>.</note><verse eid="ROM 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 10:8" />Cau mala Amsǝban mǝnana à nǝ̀ kumi nǝ gūlì arǝ Kǝrǝsti, mana nda cau mǝnana sǝm nggǝ hamnǝi ka, pà kuko ɗàng. Yàle Malǝmce mala Ɓakuli ka bang ama: &lt;&lt;Ceì ka nda a bano tù, nda a mburkuno, sǝ nda a ɓabumo.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 30:14">Nggur 30:14</ref></char>.</note> <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Ɓǝ̀ awu nǝ bang nǝ kúno ama, &lt;&lt;Yesu ka Mǝtalabangŋo na,&gt;&gt; sǝ a nǝ earnǝi nǝ mǝsǝcau a ɓabumo ama Ɓakuli loasǝi a ɓembe ka, a nǝ kum amsǝban. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Acemǝnana nǝ ɓabum sǝ ɓwa nǝ̀ eare nǝ̀ pà ɓamúrì aban Kǝrǝsti, sǝ aɓa pě anggo ka Ɓakuli angŋǝni mǝ'cauɓoarna na; sǝ ɗǝm ngga nǝ kûn sǝ ɓwa nǝ̀ bang paɓamuru male aban Kǝrǝsti, sǝ aɓa pě anggo ka kumǝna amsǝban. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Kǝla mǝnana Malǝmce na ka, &lt;&lt;Ɓwa mǝnana kat paɓamuri a baní ka, pà nǝ̀ nu kǝsǝkya ɗang.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 28:16">Isha 28:16</ref></char>.</note> <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Aɓa mǝnia ka kǝgìr gakkita ɓwa Yahudi andǝ ɓwa mǝnana ɓwa Yahudi na raka ɗàng. Yia kat ka, à ndanǝ Mǝtalabangŋo mwashat mǝnana nda Mǝtalabangŋo amur aɓwana kat, sǝ atsǝkbu male mǝnana nyangsang ngga kǝ soapia aɓwana mǝnana kat à kǝ warinǝ ɓua malea a baní ka. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Kǝla mǝnana Malǝmce bang ngga: &lt;&lt;Ɓwa mǝnana kat kǝ ɓua a ban Mǝtalabangŋo kǝ tunǝ lullǝ Mǝtalabangŋo ka, nǝ̀ kum amsǝban.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOL 2:32">Jol 2:32</ref></char>.</note><verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Sǝama lang sǝ à nǝ̀ tunǝi ɓǝ̀ amsǝia, yi mǝnana ɓǝà pa ɓamuria a baní raka? Sǝ lang sǝ à nǝ̀ paɓamuria a baní, yi mǝnana à malaká ok kǝcau amurí raka? Sǝ lang sǝ à nǝ̀ ok cau amurí, yi mǝnana kǝɓwa hambia wia ce raka? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Sǝ lang sǝ aɓwana nǝ̀ hamnǝ cau, yi mǝnana Ɓakuli túriá raka? Kǝla mǝnana à gilǝì ka: &lt;&lt;Yiu mala aɓwana mǝnana à kǝ hamnǝ Cau Amsǝban ngga gìr mǝɓoarne na kǝ̀rkǝ́r!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 52:7">Isha 52:7</ref></char>.</note><verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />Sǝama aɓwana kat sǝ ak man yì Cau Amsǝban ngga ɗàng. Acemǝnana Ishaya, mǝɓangnǝa mala Ɓakuli nǝ ɓamur rǝì ka, bang ama: &lt;&lt;Mǝtalabangŋo, ya ɓwa na earnǝ cau mana sǝm hamnǝi ka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 53:1">Isha 53:1</ref></char>.</note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Ace mani ka, paɓamuru ka kǝ yiu aɓa ok cau mala Ɓakuli, yì Cau Amsǝban mala Kǝrǝsti mǝnana à hamnǝi ka.<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GAL 3:2">Gal 3:2</ref>,<ref loc="GAL 3:5">5</ref></char>.</note> <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Sǝ ǝn ɗiban nǝma: nggearǝì ka, à ok ce re? E, à ongŋǝna. Malǝmce ka bang ama:</para>
  <para style="q1" vid="ROM 10:18">&lt;&lt;Cau ka angŋǝna ɓanza kat,</para>
  <para style="q2" vid="ROM 10:18">acau malea kutikina arǝ aban,</para>
  <para style="q1" vid="ROM 10:18">kya bwal masǝlǝata ɓanza.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 19:4">Ang 19:4</ref></char>.</note><verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Sǝ ǝn nggǝ ɗiban ɗǝm nǝma: &lt;&lt;Nggearǝì ka, amǝ Isǝrayila bwalta ce re? E, à bwalte, acemǝnana a nza mala Musa ka, Ɓakuli bang ama,</para>
  <para style="q1" vid="ROM 10:19">&lt;&lt;Mǝ nǝ tsǝa,</para>
  <para style="q2" vid="ROM 10:19">wun nǝ̀ pak mɓali arǝ aɓwana</para>
  <para style="q1" vid="ROM 10:19">mǝnana à karǝ kǝgìr raka.</para>
  <para style="q1" vid="ROM 10:19">Mǝ nǝ tsǝa,</para>
  <para style="q2" vid="ROM 10:19">bum wun nǝ lúllô,</para>
  <para style="q1" vid="ROM 10:19">arǝ cili anzali mǝnana</para>
  <para style="q2" vid="ROM 10:19">à súrǝ̀ kǝgìr raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:21">Nggur 32:21</ref></char>.</note><verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Ɗǝm ngga Ishaya nacau nǝ rǝcandǝa ama,</para>
  <para style="q1" vid="ROM 10:20">&lt;&lt;Aɓwana mǝnana</para>
  <para style="q1" vid="ROM 10:20">à altam raka,</para>
  <para style="q2" vid="ROM 10:20">à nda à kumam ngga.</para>
  <para style="q1" vid="ROM 10:20">Ən lǝmdǝ ɓamúràm</para>
  <para style="q2" vid="ROM 10:20">aban aɓwana mǝnana</para>
  <para style="q1" vid="ROM 10:20">à ɗìcem raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">10:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 65:1">Isha 65:1</ref></char>.</note><verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Sǝ amur amǝ Isǝrayila ka, Ɓakuli na ama,</para>
  <para style="q1" vid="ROM 10:21">&lt;&lt;Ən mǝn abuam</para>
  <para style="q2" vid="ROM 10:21">aɓa pwari kat</para>
  <para style="q1" vid="ROM 10:21">ace ak amǝnia yì</para>
  <para style="q2" vid="ROM 10:21">amǝ'mgbikiru</para>
  <para style="q1" vid="ROM 10:21">andǝ amǝ'murcandǝa&gt;&gt; ka.<note caller="+" style="f"><char style="fr" closed="false">10:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 65:2">Isha 65:2</ref></char>.</note><verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Ɓwamuru mala Ɓakuli <optbreak /> amur Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Ən ɗiban ama, nggearǝì ka, Ɓakuli ginǝna aɓwana male lè? Awo, ginǝia ɗàng! Nggearǝ mim nǝ ɓamur rǝàm ngga, mǝ nda ɓwa Isǝrayila, mǝkà Ibǝrayim, a tàu mala Benjami. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Awo, ko bǝti, Ɓakuli ginǝ aɓwana male mǝnana tària a tita ɓanza ka ɗàng. Ɓalǝ wun kasǝ mbo arǝ ɓua mala Iliya aban Ɓakuli amur amǝ Isǝrayila? Na ama, <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />&lt;&lt;Mǝtalabangŋo, à walna-lú ka amǝ'ɓangnǝa mô, sǝ à arkina aban-peri mò; kǝ mǝ nda nǝmurǝam ǝn ueo ka, sǝ à ndo à kǝ alta yilǝmem gbal ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 19:10">1Amur 19:10</ref>,<ref loc="1KI 19:14">14</ref></char>.</note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Sǝ a man sǝ Ɓakuli pǝlǝ wi ɗe? Ne wi ama, &lt;&lt;Mǝ ndanǝ aɓwana á-tongno-nong-ɓari (7,000) mǝnana à ɓunbî Ba'al<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="fq" closed="false">Ba'al: </char><char style="ft" closed="false">Mǝnia ka nda &lt;&lt;ɓakuli mǝ'nyirì.&gt;&gt;</char></note> raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 19:18">1Amur 19:18</ref></char>.</note> <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Kǝ nda anggo yalung, aɓwana nda kam kpokyak mǝnana ɓwamuru mala Ɓakuli tària ka. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Sǝ ɓǝ̀ nda ace ɓwamuru mala Ɓakuli ka, lǝmdǝ ama pà ace atúró-ɓoarna mǝnana aɓwana pàk ka ɗàng. Ɓǝ̀ ana raka, ɓǝ́ ɓwamuru mala Ɓakuli ka pà nǝ̀ duk ɓwamuru ɓafo ɗàng.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Sǝ ado ka mana sǝm bang le? Ani sǝ ce pa, bangula amǝ Isǝrayila ka, à kum ɓwamuru mala Ɓakuli mǝnana à alkiyite ka ɗàng. Aɓwana aɓalǝia mǝnana Ɓakuli tària ka, à nda à kum ngga. Acilia ka ɓabumia tǝra, à mgbikiru arǝ tunǝban mala Ɓakuli. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Kǝla mǝnana Malǝmce na ka,</para>
  <para style="q1" vid="ROM 11:8">&lt;&lt;Ɓakuli cia a ntulo</para>
  <para style="q1" vid="ROM 11:8">mǝdǝmbǝre,</para>
  <para style="q2" vid="ROM 11:8">peà wia amǝsǝu mǝnana</para>
  <para style="q1" vid="ROM 11:8">à pà nǝ̀ sǝnban ɗang,</para>
  <para style="q2" vid="ROM 11:8">andǝ akiru mǝnana</para>
  <para style="q1" vid="ROM 11:8">à pà nǝ̀ okban raka,</para>
  <para style="q2" vid="ROM 11:8">bà yalung.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 29:4">Nggur 29:4</ref>; <ref loc="ISA 29:10">Isha 29:10</ref></char>.</note><verse eid="ROM 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="ROM 11:9" />Nyar ɗǝm ngga Dauda na ama,</para>
  <para style="q1" vid="ROM 11:9">&lt;&lt;Likiali malea ɓǝ̀</para>
  <para style="q2" vid="ROM 11:9">dupia wia gir'swárban</para>
  <para style="q1" vid="ROM 11:9">aban ká kpa aɓa gbǝ́lî,</para>
  <para style="q2" vid="ROM 11:9">ɓǝ̀ dupia wia tali annda,</para>
  <para style="q1" vid="ROM 11:9">sǝ ɓǝà kum mǝɓane</para>
  <para style="q2" vid="ROM 11:9">mana kārǝa rǝia ka!<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Pǝndǝa ɓǝ̀ gìr amǝsǝia,</para>
  <para style="q2" vid="ROM 11:10">ace mǝnana ɓǝà kǝa</para>
  <para style="q1" vid="ROM 11:10">sǝnban ɗang,</para>
  <para style="q2" vid="ROM 11:10">sǝ ɓǝà ueo aɓata</para>
  <para style="q1" vid="ROM 11:10">dǝmbǝrya mala</para>
  <para style="q1" vid="ROM 11:10">atanni malea,</para>
  <para style="q2" vid="ROM 11:10">málá male pà kàm ɗàng.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:22">Ang 69:22</ref>,<ref loc="PSA 69:23">23</ref></char>.</note><verse eid="ROM 11:10" /></para>
  <para style="s">Aɓwana mǝnana amǝ <optbreak /> Isǝrayila na raka <optbreak /> à kum amsǝban</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Ən ɗiban ɗǝm nǝma, nggearǝ annda mǝnana amǝ Isǝrayila annda sǝ à kpa ka, à kpana anggo à pà nǝ̀ lo re? Awo, pà anggo ɗàng! Atà cau mala cauɓikea malea ka, amsǝban yina aban aɓwana mala acili anzali mana amǝ Isǝrayila na raka, ace mǝnana yia amǝ Isǝrayila ka ɓǝà dum nǝ mɓali arǝ amǝno yia ɓwana ka. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Pě mǝɓane mala amǝ Isǝrayila, mana à ginǝki amsǝban mana Ɓakuli yinǝia wia nǝi ka, yinǝì ɓanza kume. Sǝ aɓwana arǝ acili anzali gbal ka à kumǝna àwá, atàcau mala kpa malea, yia amǝ Isǝrayila ka. Ɓǝ̀ nda anggo ka, ɗenyi nǝ ulang gulo mala atsǝkbu mǝnana à nǝ̀ yiu amur ɓanza, ace nyare malea, yia amǝ Isǝrayila kat aban Ɓakuli ka!<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />Mǝ nda rǝ na wun cau ado, wun aɓwana mǝnana amǝ Yahudi na raka. Acemǝnana mǝ nda mǝ'mishan mana à tasǝam aban wun ngga, ǝn nggǝ gusǝlǝce túró mem. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Aɓa mǝno anggo ka, ǝn nggǝ earce nǝma, ɓǝ̀ nǝ̀ gandǝ pa ka, mǝ nǝ tsǝk amǝ Isǝrayila, aɓwana mem aɓa nggūrǝu, ɓǝà dum nǝ mɓali mala kum gìr mana wu ndanǝi ka, ace mǝnana ɓǝ̀ ǝn amsǝ aɓwana aɓalǝia. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Ɓǝ̀ ginǝban mǝnana Ɓakuli ginǝia ka, yinǝ amsǝban aban acilia aɓwana a ɓanza ka, lang sǝ ea nǝ̀ pa? Nǝ̀ duk pa yilǝmu aban aɓwana mǝnana à wuna ka!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />Ibǝrayim andǝ acilia akáu mana a pwarian ngga, Ɓakuli tària à duk amale. Anggo gbal sǝ amǝkea nǝ̀ pa, à nǝ̀ duk a mala Ɓakuli. Kǝla mǝnana ɓǝ̀ dyar bǝredi andǝa kǝringni ka mǝfele na ka, ɓwannè gbal ka nǝ̀ do mǝfele na. Sǝ ɓǝ̀ anlerǝ nggun ngga amǝfele na ka, nggearǝ abuí gbal ka amǝfele na.<verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />Ɓakuli ginǝkina pas atà amǝ Yahudi kǝla mǝnana à kǝ kpalǝki abu nggun ngga. Sǝ wun aɓwana mǝnana amǝ Yahudi na raka, wun mǝnana Ɓakuli angŋǝna wun ngga, wu nda kǝla abu-nggun mùrú-bondo mǝnana à zwaɓia arǝ nggun mùrú-ɓala ka. Wu angŋa ban came mala aɓea bu-nggun mǝnana à kpalǝkia arǝ nggun-mùrú-ɓala ka. Ace mani ka, wu ongŋǝna banɓoarna tsǝkbu mala Ɓakuli mǝnana pa ace Ibǝrayim andǝ amǝkè ka. <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />Acemani ka, wu kǝa nggori ace zwaɓi mǝnana à zwaɓi wun, wu akban came mala abu-nggun mǝnana à kpalǝkia ka ɗàng. Wu nda mǝnana wu bwalkiyi nlerǝ nggun ngga ɗàng, nlerǝ nggun nǝ̀ bwalkiyi wun.<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />Sǝ wun ngga, wun nǝ̀ na ama, &lt;&lt;E, abu-nggun ngga à kpalǝkia ace mǝnana ɓǝà zwaɓiǎm arǝì ka.&gt;&gt; <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />E, mǝnia ka mǝsǝcau na, à kpalǝki abu nggun mǝno ace ɗwanyi paɓamuru malea nǝ mǝsǝcau aban Kǝrǝsti. Sǝ pǝlǝa à zwaɓi wun acemǝnana wu pà ɓamur wun ngga. Sǝ paɓamuru ma'wun ɓǝ̀ kǝa tsǝk wun, wu dum nǝ twàlɓamúrû ɗang, wu dum nǝ ɓanggi Ɓakuli. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Sǝ ɓǝ̀ Ɓakuli ka kpalǝki abu nggun mǝnana a lo andǝ nggun ngga, sǝ nǝ wun mǝnana à zwaɓi wun nǝ zwaɓio ka le?<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Wu sǝn pěmǝɓoarne andǝ ɓinǝce mǝɓane mala Ɓakuli. Ɓashi male ka nda hakǝrak arǝ aɓwana mǝnana à pàk mǝɓane ka, sǝ wun ngga kǝ pakka wun mǝɓoarne, ɓǝ̀ wu lidǝmba aɓa pěmǝɓoarne male ka. Ɓǝ̀ ana raka, wun gbal ka nǝ̀ kpali wun. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Sǝ ɓǝ̀ amǝ Isǝrayila nǝ̀ ɗeki mgbikiru malea, à nǝ̀ paɓamuria ka, à nǝ̀ nyare à nǝ̀ zwaɓia ɗǝm, acemǝnana Ɓakuli ka ndanǝ rǝcandǝa nǝ̀ nyesǝia, nǝ̀ lanzǝia arǝ nggun mǝnana à kasǝia arǝì ka. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />A masǝlǝate ka, wun aɓwana mǝnana amǝ Isǝrayila na raka, wu nda kǝla abu-nggun mùrú-bondo mǝnana à kasǝia, à yì zwaɓia arǝ nggun mùrú-ɓala, mǝnana ɓoaro ɓǝà pè anggo raka. Sǝ amǝ Isǝrayila ka, à nda kǝla nggun-mùrú-ɓala; sǝ pà nǝ̀ kwanbi Ɓakuli ɗang, mana nǝ̀ nyesǝia, kǝla abu-nggun mǝnana à kasǝia ka, nǝ̀ cia ɗǝm a ban came malea ka.<verse eid="ROM 11:24" /></para>
  <para style="s">Ɓwamuru mala Ɓakuli <optbreak /> amur aɓwana kat</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Wun amǝ'eamrǝarǝu, Ən nggǝ earce ɓǝ̀ wu súrǝ̀ mǝnia yì cau mana nda aɓa sǝmbǝrǝa ɗiɗyal sǝ adyan ngga, Ɓakuli pusǝni a banfana ka, ace mǝnana wu kǝa dum nǝ twàlɓamúrû raka. Murcandǝa mǝnia yipì amǝ Isǝrayila ka, nǝ̀ nggá malâ, ɓǝ̀ làkkì mala aɓwana mǝnana amǝ Isǝrayila na raka, mǝnana à nǝ̀ kum amsǝban mala Ɓakuli, yi lúmsǝ̀nà ka. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Sǝ ɓǝ̀ mǝno yi pángŋǝ̀nà anggo ka, amǝ Isǝrayila kat ka à nǝ̀ kum àwá. Kǝla mǝnana Malǝmce na ka:</para>
  <para style="q1" vid="ROM 11:26">&lt;&lt;Mǝ'amsǝban ngga,</para>
  <para style="q1" vid="ROM 11:26">nǝ̀ pur a Urǝshalima;</para>
  <para style="q2" vid="ROM 11:26">nǝ̀ pǝlǝ múr amǝ Isǝrayila</para>
  <para style="q1" vid="ROM 11:26">ɓǝà purî ɓá ɗwanyi</para>
  <para style="q2" vid="ROM 11:26">súrǝ̀ Ɓakuli.<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Sǝ mǝnia ka nǝ̀ duk</para>
  <para style="q1" vid="ROM 11:27">kùrcau mem sǝnǝia ama,</para>
  <para style="q2" vid="ROM 11:27">mǝ nǝ twalia wia ban</para>
  <para style="q1" vid="ROM 11:27">acauɓikea malea.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 59:20">Isha 59:20</ref>,<ref loc="ISA 59:21">21</ref>; <ref loc="ISA 27:9">27:9</ref>; <ref loc="JER 31:33">Ir 31:33</ref>,<ref loc="JER 31:34">34</ref></char>.</note><verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Acemǝnana amǝ Isǝrayila ɓinǝce Cau Amsǝban ngga, à dumǝna aɓibura mala Ɓakuli, sǝ mǝno ka, nda ace ɓoaro ma'wun, wun aɓwana mǝnana amǝ Isǝrayila na raka. Sǝ atàcau mala twalban mala Ɓakuli mǝnana tàr akeâ ɓǝà duk aɓwana male ka, kǝ earcea più. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Ɓakuli ka, kǝ nggaɗi bumi arǝ aɓoro male aban aɓwana, mana nǝ̀ ea arǝia ɗǝm ngga ɗàng, sǝ aɓwana mana tunǝia sǝ tària ka, pà nǝ̀ ginǝkia ɗàng. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Ɗiɗyal ka, wun aɓwana mǝnana amǝ Isǝrayila na raka, wu nda ka amǝ mgbikiru aban Ɓakuli; sǝ adyan ngga wu kumǝna ɓwamuru, acemǝnana amǝ Isǝrayila lǝmdǝì Ɓakuli mgbikiru ka. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Yia amǝ Isǝrayila a dyan ngga, à nda ɓá mgbikî Ɓakuli kiru, sǝ kǝla mana Ɓakuli lǝmdǝa wun ɓwamuru ka, yia gbal ka, à nǝ̀ kum ɓwamuru. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Ɓakuli ka, tsǝk aɓwana kat aɓata kùrban mala mgbikiru, ace mǝnana nǝ̀ lǝmdǝ ɓwamuru male aban koyana le ka.<verse eid="ROM 11:32" /></para>
  <para style="s">Ɓwangsǝban aban Ɓakuli</para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33" />E, gulo mala kume mala</para>
  <para style="q2" vid="ROM 11:33">Ɓakuli, andǝ sǝlǝe,</para>
  <para style="q1" vid="ROM 11:33">andǝ súrǝè male ka,</para>
  <para style="q2" vid="ROM 11:33">kǝgìr pà kàm à nǝ̀ kànì arǝì ɗàng!<note caller="+" style="f"><char style="fr" closed="false">11:33 </char><char style="fq" closed="false">kǝgìr pà kàm à nǝ̀ kànì arǝì ɗàng! </char><char style="ft" closed="false">Ko: maɗani pà kàm ɗàng. </char></note></para>
  <para style="q1" vid="ROM 11:33">Yana nǝ̀ gandǝ mǝngi ɓalǝ</para>
  <para style="q2" vid="ROM 11:33">anê male!</para>
  <para style="q1" vid="ROM 11:33">Yana ɓwe nǝ̀ gandǝ súrǝ̀</para>
  <para style="q2" vid="ROM 11:33">anjar male!<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />&lt;&lt;Yana súrǝ̀ ɓabum</para>
  <para style="q2" vid="ROM 11:34">Mǝtalabangŋo?</para>
  <para style="q1" vid="ROM 11:34">Yana ɓwe nǝ̀ gandǝ</para>
  <para style="q2" vid="ROM 11:34">pè wi kwarkiru?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 40:13">Isha 40:13</ref></char>.</note><verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />&lt;&lt;Sǝ yana ɓwe pè</para>
  <para style="q2" vid="ROM 11:35">Ɓakuli kǝgìr,</para>
  <para style="q1" vid="ROM 11:35">mǝnana kǝ earce ɓǝ̀ Ɓakuli</para>
  <para style="q2" vid="ROM 11:35">mbwe ka?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:35 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOB 41:11">Ayu 41:11</ref></char>.</note><verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />Agirbunda kat ka,</para>
  <para style="q1" vid="ROM 11:36">à pur nǝ baní,</para>
  <para style="q2" vid="ROM 11:36">sǝ nǝ rǝcandǝa male</para>
  <para style="q1" vid="ROM 11:36">sǝ agir kat pa,</para>
  <para style="q2" vid="ROM 11:36">sǝ à nda ace gulo male.</para>
  <para style="q1" vid="ROM 11:36">Gulo kat ka,</para>
  <para style="q2" vid="ROM 11:36">ɓǝ̀ duk male,</para>
  <para style="q2" vid="ROM 11:36">masǝlǝate pà kàm ɗàng!</para>
  <para style="q1" vid="ROM 11:36">Ɓǝ̀ do anggo.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Túró mala amǝkwaɗi aban <optbreak /> Ɓakuli andǝ aɓwana</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Ace mani ka, wun amǝ'eambǝam, ǝn nggǝ ɓuakia rǝ wun, nǝ ɓwamuru mala Ɓakuli, wu pa rǝwun aban Ɓakuli, kǝla gìr'nkila mǝyilǝmui, mǝnana wun nǝ̀ duk amale, sǝ nǝ̀ pwasǝbumi ka. Mǝnia ka nda peri ma'wun mǝɓafoe a baní.<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:13">Rom 6:13</ref>,<ref loc="ROM 6:16">16</ref>,<ref loc="ROM 6:19">19</ref>; <ref loc="1PE 2:5">1Bit 2:5</ref></char>.</note> <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Wu kǝa kpata ɓealu andǝ kúncau mala mǝnia yì ɓanza ka ɗàng. Wu ɗeki Ɓakuli ɓǝ̀ nggaɗi wun nǝ tsǝk ɗenyicau ma'wun ɓǝ̀ duk bǝshe. Anggo sǝ wun nǝ̀ gandǝ súrǝ̀ nê mala Ɓakuli, mǝnana mǝɓoarne na, andǝ mǝnana nǝ̀ duk gir'a a baní, sǝ nda pepè ka.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Nǝ ɓwamuru mǝnana à pam ngga, ǝn nggǝ banggi koyan atà wun ngga, ɓǝ̀ kǝa twal ɓamúrì kǝ̀rkǝ́r ɓǝ̀ kútì bancame male ɗàng. Ɓǝ̀ ɗenyicau mala koya ɓwa ka, ɓǝ̀ karǝ arǝ paɓamuru male mǝnana Ɓakuli pe wi ka. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Kǝla mǝnana nggùnrǝu ka abare nda pas, sǝ koya bare ka túró male nda ɗàng ngga,<note caller="+" style="f"><char style="fr" closed="false">12:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 12:12-14">1Kor 12:12-14</ref>; <ref loc="EPH 4:4">Afi 4:4</ref>,<ref loc="EPH 4:16">16</ref></char>.</note> <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />anggo, aɓa Kǝrǝsti ka, sǝm mǝnana sǝm nda pas ka, sǝm dumǝna nggūrǝu mwashat, sǝ sǝm nda ace rǝarǝ sǝm.<note caller="+" style="f"><char style="fr" closed="false">12:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 10:17">1Kor 10:17</ref>; <ref loc="1CO 12:20">12:20</ref>,<ref loc="1CO 12:27">27</ref>; <ref loc="EPH 4:25">Afi 4:25</ref></char>.</note> <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Sǝm ndanǝ aɓoro ɗàngɗáng aɓa ɓwamuru mǝnana Ɓakuli pa sǝm ngga. Ɓǝ̀ mò yì ɓoro nda na gì Ɓakuli ka, pè a njarì mǝnana karǝ arǝ paɓamuru mò ka.<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 7:7">1Kor 7:7</ref>; <ref loc="1CO 12:4-11">12:4-11</ref>; <ref loc="1PE 4:10-11">1Bit 4:10-11</ref></char>.</note> <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Ɓǝ̀ pakkia aɓwana túró nda mò yì ɓoro ka, wú kǝ pê aɓa mǝsǝcau. Ɓǝ̀ mò ka kanigir na ka, wú kǝ kania aɓwana gìr. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Ɓǝ̀ mò ka ɓakɓabum aɓwana na ka, wú kǝ pak túró ɓakɓabum. Ɓǝ̀ pàbù nda mò yì ɓoro ka, wú kǝ pê nǝ ɓabumo mwashat. Ɓǝ̀ mò ka túró lidǝmba nǝ aɓwana na ka, wú kǝ pê nǝ ɓabumpina. Sǝ ɓǝ̀ lǝmdǝ ɓwamuru nda mò ka, wú kǝ lǝmdǝí nǝ banɓoarnado.<verse eid="ROM 12:8" /></para>
  <para style="s">Do mala mǝkpata Ɓakuli <optbreak /> aɓa earcearǝu</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Earcearǝu ka, ɓǝà pè nǝ mǝsǝcau. Wu ginǝki ɓealɓikea, sǝ wu bwal gìr mǝnana mǝɓoarne na ka kàngkàng. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Wu earce rǝarǝ wun nǝ earceban mǝ'mǝsǝcau nì. Ɓǝ̀ ban ɓoara wun arǝ pe rǝarǝ wun gulo. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Ce wu duk amǝnkundǝr, amǝ'ɗwanyi rǝɓǝla arǝ túró ɗang, wu duk amǝ bumpina aɓa pakki Mǝtalabangŋo túró nǝ ɓabum wun kat. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Wu dum nǝ banɓoarnado aɓa tsǝkɓalǝu ma'wun; wu dum nǝ munyi aɓa tanni; wu do aɓa pak hiwi koya pwari.<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 1:14">Atúró 1:14</ref>; <ref loc="ROM 5:2">Rom 5:2</ref>; <ref loc="1TH 1">1Tas</ref></char>.</note> <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Wu kǝ gau gìr ma'wun ace bwalia aɓwana mala Ɓakuli mǝnana à nda aɓa tǝle ka; wu do nǝ ɓealu mala ak abǝri.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Wu tsǝki aɓwana mǝnana à kǝ pa wun tanni ka bù; wu tsǝkia wia bù, ce wu suia ɗàng.<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 5:44">Mat 5:44</ref>; <ref loc="LUK 6:28">Luk 6:28</ref></char>.</note> <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Wu pak banɓoarnado wunǝ aɓwana mǝnana à kǝ pak banɓoarnado ka; wu ɓua wunǝ aɓwana mǝnana à kǝ ɓua ka. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Wu do aɓa dotarǝu mala amǝ'eamrǝarǝu; wu kǝa twal ɓamur wun ɗàng; wu dum nǝ earce kpapi ɓamuru wunǝ aɓwana mǝnana acili aɓwana twali à pà kun ɓe kǝgìr raka. Wu kǝa twali kǝla wu kútì aɓwana nǝ sǝlǝe ɗàng.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Ce wu nyesǝî kǝ ɓwa ɓealɓikea ace ɓealɓikea ɗang. Wu pak gìr mǝnana nǝ̀ lǝmdǝì aɓwana kat pěmǝɓoarne ma'wun ngga.<note caller="+" style="f"><char style="fr" closed="false">12:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 20:22">Pas 20:22</ref>; <ref loc="2CO 8:21">2Kor 8:21</ref>; <ref loc="1TH 5:15">1Tas 5:15</ref></char>.</note> <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Ɓǝ̀ nǝ̀ gandǝ pa ka, wu do aɓa dorǝpwala wunǝ aɓwana kat.<note caller="+" style="f"><char style="fr" closed="false">12:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="ROM 14:19">Rom 14:19</ref></char>.</note> <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Wun amǝ'eambǝam mǝnana ǝn earkiyicea ka, wu kǝa pak mǝɓane a kun mǝɓane mǝnana à pakka wun ngga ɗàng. Wu nyinggi Ɓakuli mbwe tangnakusǝu aɓa ɓashi male. Acemǝnana Mǝtalabangŋo bang aɓa Malǝmce ama,</para>
  <para style="q1" vid="ROM 12:19">&lt;&lt;Mbweban a kúnì ka</para>
  <para style="q2" vid="ROM 12:19">mem na,</para>
  <para style="q2" vid="ROM 12:19">mǝ nǝ mbwe.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:18">Pǝris 19:18</ref>; <ref loc="DEU 32:35">Nggur 32:35</ref>; <ref loc="HEB 10:30">Ib 10:30</ref></char>.</note><verse eid="ROM 12:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 12:20" />A kun mani, kǝla mana Malǝmce na ka,</para>
  <para style="q1" vid="ROM 12:20">&lt;&lt;Ɓǝ̀ ɓio-mǝbura nda</para>
  <para style="q1" vid="ROM 12:20">aɓa nzala ka,</para>
  <para style="q2" vid="ROM 12:20">pe wi girlina;</para>
  <para style="q1" vid="ROM 12:20">ɓǝ̀ mǝsamur wali ka,</para>
  <para style="q2" vid="ROM 12:20">pe wi mùr ɓǝ̀ nu.</para>
  <para style="q1" vid="ROM 12:20">Aɓa pě anggo ka,</para>
  <para style="q2" vid="ROM 12:20">a nǝ rambi wi</para>
  <para style="q1" vid="ROM 12:20">nkalang-bǝsa</para>
  <para style="q2" vid="ROM 12:20">mǝ earke a mùrí.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 25:21">Pas 25:21</ref>,<ref loc="PRO 25:22">22</ref></char>.</note><verse eid="ROM 12:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 12:21" />Wu kǝa eari ɓealɓikea ɓǝ̀ limurǝm amur wun ɗàng, wu limurǝm amur ɓealɓikea nǝ pěmǝɓoarne.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Pagulo aban aɓwana mana <optbreak /> a cia amur wun ngga</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Ko ya ɓwa ka ɓǝ̀ nyesǝ ɓamúrì aɓata aɓwana mǝnana à pea wia gara yálban ngga, acemǝnana ɓekǝ gara-murǝm pà kàm mǝnana pur nǝ ban Ɓakuli raka ɗàng; sǝ aɓwana mǝnana à bwalkiyi gara-murǝm ado ka, Ɓakuli nǝ̀ cia.<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="TIT 3:1">Tit 3:1</ref>; <ref loc="1PE 2:13-14">1Bit 2:13-14</ref>; <ref loc="PRO 8:15">Pas 8:15</ref>; <ref loc="JHN 19:11">Yoh 19:11</ref></char>.</note> <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Acemani ka, ɓwa mǝnana kat mgbicau a rǝia ka, ndarǝ mgbicau arǝ gir mǝnana Ɓakuli nǝ̀ kwakite ka. Sǝ aɓwana mǝnana kat à mgbicau a rǝia ka, à nǝ̀ nunbi ɓamuria ɓashi. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Ayálban ngga à cia ace pa ɓangciu aban aɓwana mǝnana à kǝ pak mǝɓoarne ka ɗàng, she aban amǝ'ɓealɓikea. Ɓǝ̀ a kǝ́ earce ama a pà nǝ dum nǝ ɓangciu a rǝia raka, pak gìr mǝnana mǝɓoarne na ka, sǝ yia ka à nǝ̀ ɓwangsǝo. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Amǝ'yálmúrû ka, aɓwana na mǝnana Ɓakuli nǝ̀ cia ace pakko gir mǝɓoarne ka. Sǝ ɓǝ̀ a kǝ́ pak mǝɓane ka, dumǝna púp ɓangciu nǝ̀ pakko, acemǝnana à pania wia rǝcandǝa mala pàtanni. Yia ka amǝtúró na mǝnana Ɓakuli cia ace pea amǝ pak mǝɓane tanni ka. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Ace mani ka, wu pà ɓamur rǝ wun aɓatea. Ko ɓǝ̀ pà ace ɓanggi kum pàtanni raka, wu pè ace mǝnana ɓabum wun ɓǝ̀ kǝa mak wun raka.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Ɗǝm ngga, nda gìr mǝnana tsǝa sǝ wu kǝ mbwe boalo-cemi ka, acemǝnana yia ayálban ngga Ɓakuli nǝ̀ cia aɓa túró, sǝ boalo ka nda mǝnana nǝ̀ bwalia kam ɓǝà pà rǝcandǝa andǝ bumia arǝ túró mǝnana à pakkiyi kat ka. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Wu pea aɓwana kat, agir mǝnana à kǝ kpani atà wun ngga: wu pea wia boalo-cemi mala ɓamur rǝ wun andǝ boalo-cemi mala agirkuma ma'wun. Wu kǝ lǝmdǝia wia gusǝlǝban andǝ pagulo kat.<note caller="+" style="f"><char style="fr" closed="false">13:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 22:21">Mat 22:21</ref>; <ref loc="MRK 12:17">Mar 12:17</ref>; <ref loc="LUK 20:25">Luk 20:25</ref></char>.</note><verse eid="ROM 13:7" /></para>
  <para style="s">Lǝmdǝì arǝu earcearǝu</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Wu kǝa eare ɓǝ̀ kǝɓwa kpata wun tangna nǝ kǝgìr ɗàng, she earcearǝu mǝnana dumǝna púp wun nǝ̀ lǝmdǝia rǝ wun ngga. Ɓwa mǝnana kǝ earce ɓi mǝ'murkala ka, lùmsǝ̀nà Nggurcau mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">13:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 22:39-40">Mat 22:39-40</ref>; <ref loc="ROM 13:10">Rom 13:10</ref>; <ref loc="GAL 5:14">Gal 5:14</ref>; <ref loc="COL 3:14">Kol 3:14</ref>; <ref loc="JAS 2:8">Jem 2:8</ref></char>.</note> <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Anzongcau mǝnana ama, &lt;&lt;Kǝa nongnǝ ɓwa mana wu al rǝ wun wunǝi raka ɗàng.&gt;&gt; &lt;&lt;Kǝa wal-lú ɗàng.&gt;&gt; &lt;&lt;Kǝa iun'í ɗang.&gt;&gt; &lt;&lt;Kǝa sham gìr mala ɓwa ɗàng,&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:13-15">Pur 20:13-15</ref>,<ref loc="EXO 20:17">17</ref>; <ref loc="DEU 5:17-21">Nggur 5:17-21</ref></char>.</note> andǝ aɓea mǝnana kat à ndakam ngga, à nda à kpapia aɓa nzongcau mwashat ama, &lt;&lt;Earce ɓio mǝ'murkala kǝla mǝnana a earce ɓamúrò ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:18">Pǝris 19:18</ref></char>.</note> <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Earcearǝu pa nǝ̀ pakki kǝɓwa mǝɓane ɗàng. Acemani ka, ɓwa mǝnana ndanǝ earcearǝu arǝ aɓwana ka, nda rǝ lùmsǝ anzongcau mǝnana kat aɓa Nggurcau mala Ɓakuli ka.<note caller="+" style="f"><char style="fr" closed="false">13:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 22:39-40">Mat 22:39-40</ref>; <ref loc="ROM 13:8">Rom 13:8</ref>; <ref loc="GAL 5:14">Gal 5:14</ref>; <ref loc="JAS 2:8">Jem 2:8</ref></char>.</note><verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Dumǝna púp wun nǝ̀ pak anggo, acemǝnana wu sùrǝ́nà rǝ nza mǝnia sǝm nda aɓalǝi ka. Pwari pàngŋǝ̀nà mǝnana wun nǝ̀ loapi ntulo ka, acemǝnana amsǝban ma'sǝm yina ado tù, amur mǝnana sǝm tita pana ɓamur sǝm nǝi ka.<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:14">Afi 5:14</ref>; <ref loc="1TH 5:6">1Tas 5:6</ref></char>.</note> <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Dù málá nǝ̀ malâ; ban málá nǝ̀ kwaro. Ɓǝ̀ sǝm nying pakki agir mala pǝndǝa, ɓǝ̀ sǝm oasǝ agirmunǝo mala tǎlaban.<note caller="+" style="f"><char style="fr" closed="false">13:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1JN 2:8">1Yoh 2:8</ref>; <ref loc="EPH 5:11">Afi 5:11</ref>; <ref loc="1TH 5:8">1Tas 5:8</ref></char>.</note> <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Ɓǝ̀ sǝm dukdo ɓealu ɓoarnsari kǝla aɓwana mǝnana à nda aɓa tǎlaban mala pwari ka. Pà aɓa nukiagir ko wal wale, andǝ kiɗiki mala nonggi nǝ rǝarǝu ko alta banɓoarnado mala pakki agir kǝsǝkya, andǝ munǝki-amunǝo ko mɓali ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">13:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1TH 4:12">1Tas 4:12</ref>; <ref loc="GAL 5:19-21">Gal 5:19-21</ref></char>.</note> <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />A kún mani ka wu oasǝ Mǝtalabangŋo Yesu Kǝrǝsti arǝ wun, sǝ wu kǝa kánǝ ɗenyicau ma'wun arǝ alita nggūrǝu njar mala loasǝ anpel male ɗàng.<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GAL 3:27">Gal 3:27</ref>; <ref loc="GAL 5:16">5:16</ref></char>.</note><verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Kǝa ɓashì mǝ'eambo ɗàng</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Mǝkwaɗi mǝnana pànǝ rǝcandǝa aɓa paɓamuru male aban Ɓakuli raka, wu é, sǝ wu kǝa kutia makgìr andǝi amur agir mǝnana aɓwana kat sǝ à eare amurí raka ɗàng. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Paɓamuru mala ɓeɓwa ka, eari wi ɓǝ̀ li gìr mǝnana kat sǝni girlina na ka, sǝ ɓwa mǝnana gatti aɓa paɓamuru male ka, kǝ mbúgir na likiyi ka. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Ɓwa mǝnana kǝ li koya gìr ka, ɓǝ̀ kǝa ɓǝsǝki ɓwa mǝnana kǝ li raka ɗàng. Sǝ ɓwa mǝnana gbal kǝ li koya gìr raka, ɓǝ̀ kǝa ɓǝsǝki ɓwa mǝnana kǝ li ka ɗàng; acemǝnana Ɓakuli ka, angŋǝnia yia kǝm.<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 2:16">Kol 2:16</ref></char>.</note> <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Sǝ a nda yan, mǝnana a nǝ ɓashì mǝtúró-ɓala mala ɓeɓwa ka? Mǝtúró-ɓala ka mǝtala-ɓala male na nǝ̀ kasǝi ɓashi mǝnana nǝ̀ lǝmdǝ kpa ko came male ka. Sǝ yì ka, nǝ̀ kum kusǝu-came, acemǝnana Mǝtalabangŋo nǝ̀ gandǝ tsǝì ɓǝ̀ came.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Ɗǝm ngga, ɓeɓwa kǝ twal ɓè pwari nǝ gulo amur acilia apwari, sǝ ɓeɓwa ka kǝ twal apwari kat ka à nda mwashat. Koyan ngga ɓǝ̀ sǝlǝ ama ko ɓǝ̀ mǝye na twalo a sǝne male ka, ɓǝ̀ kpate anggo. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Aɓwana mǝnana à gusǝlǝ ɓe pwari ace peri aban Mǝtalabangŋo ka, à pa anggo ace pe Mǝtalabangŋo gulo. Aɓwana mǝnana à nǝ̀ gandǝ li koya ulang girlina nani ka, à pè ace gusǝlǝ Mǝtalabangŋo, acemǝnana à kǝ pakki Ɓakuli yàwá ace girline. Sǝ aɓwana mǝnana à ɓinǝ li aɓea girlina ka, à pa anggo gbal, ace pe Mǝtalabangŋo gulo, andǝ pak yàwá aban Ɓakuli. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Kǝɓwa pà aɓalǝ sǝm mǝnana dupî ɓamúrì, ko a na raka, nǝ̀ wuki ɓamúrì ka ɗàng. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Ɓǝ̀ sǝm ndanǝ yilǝmu ka, nda ace gusǝlǝ Mǝtalabangŋo, sǝ ɓǝ̀ sǝm wu gbal ka, nda ace gusǝlǝ Mǝtalabangŋo. Lǝmdǝ ama, ko sǝm ndanǝ yilǝmu, sǝ ko sǝm wu ka, sǝm nda ka mala Mǝtalabangŋo.<verse eid="ROM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9" />Nda àkǝ̀ ce mǝnia sǝ Kǝrǝsti wú, sǝ lo nǝ yilǝmu, acemǝnana ɓǝ̀ duk Mǝtalabangŋo amur aɓwana mǝnana à wuna ka, andǝ aɓwana mǝnana à ndanǝ yilǝmu ka. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Sǝ we ado ka, palang sǝ a kǝ ɓashì mǝ'eambo? Palang sǝ a kǝ nyesǝ mǝ'eambo ɓà? Sǝm kat ka, sǝm nǝ̀ nggá came a ɓadǝm buno-ɓashi mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 16:27">Mat 16:27</ref>; <ref loc="2CO 5:10">2Kor 5:10</ref></char>.</note> <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Malǝmce bang ama,</para>
  <para style="q1" vid="ROM 14:11">&lt;&lt; &lt;Mǝtalabangŋo kǝ na ama,</para>
  <para style="q2" vid="ROM 14:11">Kǝla mǝnana kàngkàng</para>
  <para style="q1" vid="ROM 14:11">mǝ ndakam nǝ yilǝmu ka,&gt;</para>
  <para style="q2" vid="ROM 14:11">&lt;koya nkūnu ka,</para>
  <para style="q1" vid="ROM 14:11">nǝ̀ ɓun a ɓadǝmbam,</para>
  <para style="q2" vid="ROM 14:11">sǝ koya lasǝu ka</para>
  <para style="q1" vid="ROM 14:11">nǝ̀ bang ama</para>
  <para style="q2" vid="ROM 14:11">Mǝ nda Ɓakuli.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 45:23">Isha 45:23</ref></char>.</note><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />Mǝno ka lǝmdǝ ama ko yana atà sǝm ngga, nǝ̀ bǝl kúni nǝ ɓamúrì aban Ɓakuli.<verse eid="ROM 14:12" /></para>
  <para style="s">Kǝa tsǝk mǝ'eambo <optbreak /> ɓǝ̀ anndǝ ɗang</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Ace mani ka, ɓǝ̀ sǝm nying ɓashì rǝarǝ sǝm. Ɓoaro male ka, ɓǝ̀ sǝm twali a ɓabum sǝm ama pà sǝm nǝ̀ pak ɓè kǝgìr mǝnana nǝ̀ tsǝki amǝ'eamrǝarǝu gìr-annda, ko nǝ̀ tamsǝia aɓa kwaɗi malea ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 7:1">Mat 7:1</ref>; <ref loc="1CO 8:13">1Kor 8:13</ref></char>.</note> <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />A dotārǝú mem sǝnǝ Mǝtalabangŋo Yesu ka, ǝn yi sǝlǝa, sǝ ǝn earna ama, kǝ girlina pa kàm mǝnana mǝɓane na nǝ ɓamúrì ka ɗàng; sǝama ɓǝ̀ ɓwa sǝni sǝ na ama girlina ka ɓoaro ɓǝ̀ li raka, a baní ka dumǝna mǝɓane. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Ɓǝ̀ a tsǝk mǝ'eambo sǝ banɓiki wi nǝ girlina mǝnana a li ka, lǝmdǝ ama a kǝ pak gìr aɓa earcearǝu ɗang. Kǝa eare girlina mǝnana a kǝ li ka, ɓǝ̀ tsǝk mǝ'eambo mǝnana Kǝrǝsti wú ace ka, ɓǝ̀ kiɗiki ɗàng! <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Kǝa nying gìr mǝnana a twali mǝɓoarne na ka, ɓǝ̀ aɓwana na mǝɓane amurí ɗàng.<note caller="+" style="f"><char style="fr" closed="false">14:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 10:30">1Kor 10:30</ref></char>.</note> <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Acemǝnana Domurǝm mala Ɓakuli ka, cau mala liki agirlina andǝ nuki agir na ɗàng. Nda ace do nǝ cauɓoarna, andǝ dorǝpwala, andǝ banɓoarnado aɓa Bangŋo Mǝfele. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Ɓwa mǝnana kat kǝ pakki Kǝrǝsti túró nǝ ulang mǝnia yì ɓealu ka, nǝ̀ kum akban mala Ɓakuli, sǝ aɓwana nǝ̀ earnǝi gbal.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Acemani ka, ɓǝ̀ sǝm ɓariki arǝ pakki agir mǝnana à nǝ̀ yinǝ dorǝpwala andǝ dotarǝu mala ɓak rǝarǝ sǝm ngga.<note caller="+" style="f"><char style="fr" closed="false">14:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="ROM 12:18">Rom 12:18</ref>; <ref loc="1TH 5:11">1Tas 5:11</ref></char>.</note> <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Wu kǝa kiɗiki túró mala Ɓakuli nǝ cau mala girlina ɗang. Agirlina kat ka amǝɓoarne na, sǝ ɓoaro ɓǝ̀ ɓwa li girlina mǝnana nǝ̀ tsǝk ɓeɓwa ɓǝ̀ kpa aɓa cauɓikea ka ɗàng. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Nǝ̀ ɓoaribanì wu nying li nyama ko nu mùr-ɓǝlanggun anap, ko pàk koya gìr nani mǝnana kat nǝ̀ tsǝk mǝ'eambo nǝ̀ kpa aɓa cauɓikea ka.<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />Ace mani ka, ɓǝ̀ ko mana sǝ nda gìr mǝnana a earnǝi amur amǝno yì agir ka, ɓǝ̀ do anre wun wunǝ Ɓakuli. Tsǝkbu mala Ɓakuli na amur ɓwa mǝnana panǝ múr-halǝkya arǝ pak gìr mǝnana sǝlǝna ama nda pepè ka ɗàng. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Sǝ ɓwa mǝnana ɗenyicau male kǝ tuti arǝ li gìr, sǝ kutia li gìrnî ka, pàngŋǝ̀nà cauɓikea, acemǝnana mǝno yì pě male ka, pà nǝ ɓabum mala kpata gìr a njar mala Ɓakuli ɗang, sǝ gìr mǝnana kat ɓwa pè, sǝ ɓabumi eari wi ama gìrnî ka nda pepè a ɓadǝm Ɓakuli raka, cauɓikea na.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">Wu pwasǝbum aɓwana</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Sǝm mǝnana sǝm ndanǝ rǝcandǝa ka, ɓoaro ɓǝ̀ sǝm bwalì aɓwana mǝnana à gatti ka,<note caller="+" style="f"><char style="fr" closed="false">15:1 </char><char style="fq" closed="false">ɓoaro ɓǝ̀ sǝm bwalì aɓwana mǝnana à gatti ka </char><char style="ft" closed="false">ko &lt;&lt;ɓǝ̀ sǝm twalgàndǝá nǝ gatti mala amǝ'ɗwanyi rǝcandǝa.&gt;&gt;</char></note> cè sǝm lǝmdǝ earce ɓamuru ɗang. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Koyan aɓalǝ sǝm ngga ɓǝ̀ kǝ̀ ɗenyinǝ ɓi mǝ'murkala, sǝ ɓǝ̀ kǝ̀ pakki wi mǝɓoarne mǝnana nǝ̀ loasǝi aɓa paɓamuru ka. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Ko nggearǝ Kǝrǝsti ka dukdo pwasǝbum ɓamúrì ɗàng. Kǝla mǝnana Malǝmce bang ngga, &lt;&lt;Asangban mala aɓwana mǝnana à sangŋo ka, We Ɓakuli, à sulǝna amuram.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 69:9">Ang 69:9</ref></char>.</note> <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Agir mǝnana à gilǝia kat aɓa Malǝmce ɗiɗyal ka, à gilǝia ace kwarkir sǝm, ace mǝnana nǝ́ gandǝrǝu andǝ ɓakɓabum mana sǝm nǝ̀ kùmô aɓa cau mala Malǝmce ka, sǝm nǝ̀ dumnǝ tsǝkɓalǝu.<note caller="+" style="f"><char style="fr" closed="false">15:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 4:23-24">Rom 4:23-24</ref>; <ref loc="1CO 9:10">1Kor 9:10</ref>; <ref loc="2TI 3:16">2Tim 3:16</ref></char>.</note><verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />Sǝ Ɓakuli mǝnana pākiyi gandǝrǝu andǝ girikiban ngga, ɓǝ̀ pà wun ɓabum dotarǝu arǝarǝ wun, wu kǝ kpata ulang pe mala Kǝrǝsti Yesu. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Sǝ anggo ka, wun atarǝ wun kat ka, wun nǝ̀ ɓwangsǝ Ɓakuli, yì Tár Mǝtala sǝm Kǝrǝsti Yesu, nǝ giu mwashat.<verse eid="ROM 15:6" /></para>
  <para style="s">Cau Amsǝban ace aɓwana <optbreak /> mala anzali kat</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Acemani ka, wu ak rǝarǝ wun, kǝla mǝnana Kǝrǝsti ak wun ngga, ace mǝnana mǝnia ka, nǝ̀ yinǝì Ɓakuli gulo. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Mǝ nda aban bangga wun ama, túró mala Kǝrǝsti mǝnana yi pak ka, pè ace amǝ Yahudi ace lǝmdǝ ama Ɓakuli ka mǝ'mǝsǝcau na arǝ apacau male mǝnana pa a ban akeâ ka. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Ɗǝm ngga Kǝrǝsti pak túrè ace mǝnana aɓwana mala acili anzali ka, à nǝ̀ ɓwangsǝ Ɓakuli ace ɓwamuru male. Malǝmce ka bangŋǝna ama,</para>
  <para style="q1" vid="ROM 15:9">&lt;&lt;Ace mǝnia ka</para>
  <para style="q2" vid="ROM 15:9">mǝ nǝ ɓwangsǝo</para>
  <para style="q1" vid="ROM 15:9">aɓalǝ aɓwana mala</para>
  <para style="q2" vid="ROM 15:9">acili anzali.</para>
  <para style="q1" vid="ROM 15:9">Mǝ nǝ tùki anggyal</para>
  <para style="q2" vid="ROM 15:9">ɓwangsǝ lùllǝò.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2SA 22:50">2Sam 22:50</ref>; <ref loc="PSA 18:49">Ang 18:49</ref></char>.</note><verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />Malǝmce ɗǝm ngga bang ama,</para>
  <para style="q1" vid="ROM 15:10">&lt;&lt;Wun aɓwana mala</para>
  <para style="q1" vid="ROM 15:10">acili anzali,</para>
  <para style="q2" vid="ROM 15:10">wu pàk-banɓoarnado</para>
  <para style="q1" vid="ROM 15:10">atarǝ wun,</para>
  <para style="q2" vid="ROM 15:10">wunǝ aɓwana mala Ɓakuli.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:43">Nggur 32:43</ref></char>.</note><verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />Nyar ɗǝm ngga bang ama,</para>
  <para style="q1" vid="ROM 15:11">&lt;&lt;Wun aɓwana mala</para>
  <para style="q1" vid="ROM 15:11">acili anzali kat,</para>
  <para style="q2" vid="ROM 15:11">wu ɓwangsǝki Mǝtalabangŋo.</para>
  <para style="q1" vid="ROM 15:11">Wun aɓwapǝndǝa kat,</para>
  <para style="q2" vid="ROM 15:11">wu ɓwangsǝkì!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 117:1">Ang 117:1</ref></char>.</note><verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />Ɗǝm ngga, Ishaya bang ama,</para>
  <para style="q1" vid="ROM 15:12">&lt;&lt;Mǝkà Jeshi nǝ̀ yiu;</para>
  <para style="q1" vid="ROM 15:12">nǝ̀ yia duk murǝm,</para>
  <para style="q2" vid="ROM 15:12">amur aɓwana mala acili anzali.</para>
  <para style="q1" vid="ROM 15:12">Aɓwana mǝnana amǝ Isǝrayila</para>
  <para style="q1" vid="ROM 15:12">na raka,</para>
  <para style="q2" vid="ROM 15:12">à nǝ̀ tsǝk ɓālǝia arǝì.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 11:10">Isha 11:10</ref></char>.</note><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Ɓǝ̀ Ɓakuli mǝpà tsǝkɓalǝu lùmsǝ wun nǝ banɓoarnado, andǝ dorǝpwala aɓa paɓamuru ma'wun a baní, ace mǝnana ɓǝ̀ wu lùmsǝ nǝ tsǝkɓalǝu nǝ bu rǝcandǝa mala Bangŋo Mǝfele.<verse eid="ROM 15:13" /></para>
  <para style="s">Túró Mishan mala Bulǝs <optbreak /> aban aɓwana arǝ anzali</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Wun amǝ'eambǝam, mim nǝ ɓamúràm ngga ǝn sǝlǝna nǝma wu lùmsǝ̀nà nǝ pe mǝɓoarne, wu ndanǝ sǝlǝ kat, wun nǝ̀ gandǝ kania rǝwun gìr. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Mim aɓa cauterǝa mǝnia ka, ǝn bangga wun cau bwāng amur aɓea gir, ɓangciu pa arǝàm ɗàng, ace kasǝɓalǝ wun. Ən gilǝ mǝnia ka ace ɓwamuru mala Ɓakuli mǝnana lǝmdǝàm sǝ twalám <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />mǝ duk mǝtúró mala Kǝrǝsti Yesu aban aɓwana mala acili anzali ka. Ɓakuli twalam ace mǝnana mǝ paktúró kǝla pǝris, aban hamnǝ bǝsa Cau Mǝɓoarne male. Sǝ aɓa mǝno anggo ka aɓwana mala acili anzali ka ɓǝà duk ɓoro mǝnana gir'a na aban Ɓakuli, yia aɓwana mǝnana Bangŋo Mǝfele tàrnia ace Ɓakuli ɓǝà duk amale ka.<verse eid="ROM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 15:17" />Acemani ka, ǝn nggǝ nggori nǝ Kǝrǝsti Yesu aɓa túró mem aban Ɓakuli. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Amurí ka, ǝn nggori nǝ kǝgìr ɗàng, shekǝ gìr mǝnana Kǝrǝsti pè nǝ buam aban yinǝ aɓwana mala acili anzali, aban okî Ɓakuli nǝ cau mǝnana ǝn hamnǝi andǝ túró mǝnana ǝn pe aɓalǝia ka. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />Amur mǝno ka, mǝ nǝ nggori nǝ agir-ndǝlǝki andǝ agir-gyambǝliban mǝnana Kǝrǝsti pea aɓa rǝcandǝa mala Bangŋo mala Ɓakuli ka. Anggo sǝ ǝn hamnǝ Cau Amsǝban mala Kǝrǝsti puppup aɓa gya mem kat, twal a Urǝshalima kya bwal a Ilirikum. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Mǝnia ka nda cau mǝnana ǝn twal a ɓabumam ngga, ɓǝ̀ ǝn hamnǝ Cau Amsǝban mala Kǝrǝsti a ban mǝnana à malaká oe kam raka, ace mǝnana mǝ ngga ɓakɓa amur kusǝɓǎ mala ɓekǝ ɓwa ɗàng. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Sǝ, kǝla mǝnana à gìlǝì aɓa Malǝmce ka:</para>
  <para style="q1" vid="ROM 15:21">&lt;&lt;Aɓwana mǝnana</para>
  <para style="q2" vid="ROM 15:21">à malaká banggia wia</para>
  <para style="q1" vid="ROM 15:21">cau male raka,</para>
  <para style="q2" vid="ROM 15:21">à nǝ̀ sǝn mǝsǝcau male,</para>
  <para style="q2" vid="ROM 15:21">sǝ aɓwana mǝnana</para>
  <para style="q1" vid="ROM 15:21">à malaká ok raka,</para>
  <para style="q2" vid="ROM 15:21">à nǝ̀ bwalte.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ISA 52:15">Isha 52:15</ref></char>.</note><verse eid="ROM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ɓafo ka, ǝn gandǝ kum dǝmbǝu ǝn yiu aban wun ɗàng, acemǝnana mǝ nda aban hamnǝ cau arǝ amǝnia yì abân ngga.<verse eid="ROM 15:22" /></para>
  <para style="s">Bulǝs tsǝa a ɓabumi nǝ̀ ká a Roma</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Adyan ngga, ɓè kǝgìr uekàm mǝnana mǝ nǝ pè a bu ka anzali mǝnia ka ɗàng. Sǝama mǝ ndanǝ ɗenyi a ɓabumam arǝ apǝlǝa pas nǝma mǝ nǝ yiu aban wun. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Ən kanìna mǝ nǝ pǝlǝa aban wun, ɓǝ̀ mǝ nǝ kutio aban ká a Sǝpen ngga. Mǝ nǝ sǝn wun, yàle wun nǝ̀ tsǝktam aban ká a banì, anzǝm mǝnana ǝn dumǝna a ban wun zuku ka. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Sǝ ado ka, mǝ nda amur njar aban ká Urǝshalima nǝ gbasha aban amǝkpata Yesu mǝnana a banì ka. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Acemǝnana amǝkpata Ɓakuli mǝnana a Masǝdoniya andǝ Akaya ka, à pa ɓoro nǝ banɓoarnado, ɓǝà kya peǎ amǝ'tǝ̀r mǝnana à nda aɓalǝ amǝkpata Ɓakuli a Urǝshalima ka. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Banɓoaria wia nǝ pâ mǝnia yì ɓoro ka, acemǝnana à sǝlǝna ama dumǝnia wia kǝla tangna mǝnana à nǝ̀ mbwe ka. Sǝ ɓǝà aɓwana mǝnana amǝ Yahudi na raka, à yì kum kāmbe atà amǝ Yahudi aɓalǝ atsǝkbu aɓa bangŋo ka, dumǝnia wia gbal ama ɓǝà pàkki amǝ Yahudi túró nǝ agirkuma malea. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ɓǝ̀ ǝn pana mǝnia yì boalo, ǝn lumsǝna túró mǝɓoarne malea, sǝ ɓǝ̀ mǝ nǝ ká a Sǝpen ngga, mǝ nǝ kyangye mǝ nǝ sǝn wun peatu. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Ən sǝlǝna nǝma ɓǝ̀ mǝ nǝ yiu aban wun ngga, mǝ nǝ yinǝà wun nǝ tsǝkbu mǝgule mala Kǝrǝsti.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Ən nggǝ zǝmba wun, wun amǝ'eambam, aɓa lullǝ Mǝtalabangŋo Yesu Kǝrǝsti sǝ nǝ earcearǝu mǝnana Bangŋo kǝ pa ka, wu bwalàm nggàm aɓa pakhiwi nǝ ɓabum wun kat aban Ɓakuli acem. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Wu pakhiwi ama, ɓǝ̀ ǝn apî túró mǝɓike mala amǝ mgbikiru aɓa nzali Yahudi. Wu pakhiwi ɗǝm ama amǝkpata Ɓakuli mǝnana a Urǝshalima ka, ɓǝà kum ɓabum ak ɓoro mǝnana ǝn nggǝ kánǝia wia nǝi ka. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Anggo, nǝ eare mala Ɓakuli, mǝ nǝ yiu aban wun nǝ banɓoarnado mǝgule, sǝ sǝm nǝ̀ do atarǝ sǝm kat nǝ bumpwasǝa. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Adyan ngga, yì Ɓakuli, mǝtala dorǝpwala ɓǝ̀ do atà wun. Ɓǝ̀ do anggo.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Makkiakun</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Ən nggǝ lǝmdǝ mǝ'nggaula sǝm Fibi aban wun, acemǝnana yì ka, mǝ bwalturo ɓá ndahiwi na a Sǝnkǝriya. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Wu gingsǝi, wu é aɓa lullǝ Mǝtalabangŋo, kǝla mǝnana ɓoaro ɓǝà pakki mǝkpata Ɓakuli ka. Wu bwalì wi kàm aɓa gìr mǝnana kat nǝ̀ pàktǝle ka. Acemǝnana yì ka, nggea gbasha mǝgule na aban ɓwapǝndǝa a là, sǝ nggearǝ mim ngga pàngŋǝ́nàm mǝɓoarne.<verse eid="ROM 16:2" /></para>
  <para style="li1">
    <verse number="3" style="v" sid="ROM 16:3" />Ən nggǝ tasǝ makkun mem a ban Pǝrisǝla andǝ Akila, aɓeam amǝtúró, a ban túró mala Kǝrǝsti Yesu. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Yia ka à pà yilǝmia, ɓǝ́ à wuna acem. Ən pakkia wia yàwá. Nggearǝ mim nǝmurǝam ɗàng, a'ikǝlisiya kat mala acili anzali, à kǝ pakkia wia yàwá.<verse eid="ROM 16:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="ROM 16:5" />Wu makki Ikǝlisiya mǝnana kǝ kpapi a ɓala malea ka kûn.</para>
  <para style="li1" vid="ROM 16:5">Wu makki Epenetus, gyajam mem mǝnana ǝn earkiyi ace raka kûn. Yì ka, nda ɓwa mǝnana tita ak Kǝrǝsti a bu-nzali Asiya ka.<verse eid="ROM 16:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="ROM 16:6" />Wu makki Maryamu kûn, yi mǝnana pak túró kǝ̀rkǝ́r ace wun ngga.<verse eid="ROM 16:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="ROM 16:7" />Wu makki Andǝronikus andǝ Juniya kûn, aɓǝla mem mǝnana sǝm nda a ndàkurban sǝnǝia ka. Yia ka, amǝ'mishan súrǝ̀ia pepè, sǝ yia ka, à akàm dǝmba ak Kǝrǝsti.<verse eid="ROM 16:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="ROM 16:8" />Wu makki Ampǝliyatus kûn, ɓwa mem aɓa kpata Mǝtalabangŋo.<verse eid="ROM 16:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="ROM 16:9" />Wu makki Urǝbanus kûn, ɓi sǝm mǝtúró mala Kǝrǝsti, andǝ Sǝtakis gyajam mem mǝgule.<verse eid="ROM 16:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="ROM 16:10" />Wu makki Apele kûn, yì ɓwa mǝnana à mwamǝni sǝ à earǝna nǝ paɓamuru male aɓa Kǝrǝsti ka.</para>
  <para style="li1" vid="ROM 16:10">Wu makki amǝ ɓala mala Aristobulus kûn.<verse eid="ROM 16:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="ROM 16:11" />Wu makki ɓǝla mem, Hirǝdiyon kûn.</para>
  <para style="li1" vid="ROM 16:11">Wu makki aɓwana mala Mǝtalabangŋo mǝnana a ɓala mala Narkisus ka, kûn.<verse eid="ROM 16:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="ROM 16:12" />Wu makki Tǝrafena andǝ Tǝrafosa, amamǝna mǝno à pakki Mǝtalabangŋo túró kǝ̀rkǝ́r ka kûn.</para>
  <para style="li1" vid="ROM 16:12">Wu makki Pasis kûn yi ɓiam mǝnana ǝn earkiyi ace raka, sǝ yì ɗǝm ngga ɓwama na mǝnana pakki Mǝtalabangŋo túró nǝ rǝcandǝa male kat ka.<verse eid="ROM 16:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="ROM 16:13" />Wu makki Rufus kûn, yi mǝnana Mǝtalabangŋo tàrì ɓǝ̀ duk male ka. Wu makki nggè kûn, acemǝnana yì ka, bwalǎm kǝla muni gbal.<verse eid="ROM 16:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="ROM 16:14" />Wu makki Asǝnkǝritus, andǝ Filigon, andǝ Hamis, andǝ Patrobas, andǝ Hamas andǝ amǝ'eambia mǝnana abania ka kûn.<verse eid="ROM 16:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="ROM 16:15" />Wu makki Filologus, andǝ Juliya, andǝ Nerius andǝ mǝ'nggaule, andǝ Olimpas andǝ acilia amǝkpata Ɓakuli mǝnana abania ka kûn.<verse eid="ROM 16:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="ROM 16:16" />Wu makkia rǝ wun kûn, nǝ kur rǝarǝu mala amǝkpata Ɓakuli.</para>
  <para style="li1" vid="ROM 16:16">Amǝkwaɗi mǝnana arǝ a'ikǝlisiya mala Kǝrǝsti kat à kǝ makka wun kûn.<verse eid="ROM 16:16" /></para>
  <para style="s">Masǝlǝata amakkiakun <optbreak /> mala Bulǝs</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Ən nggǝ zǝmba wun ɗǝm, wun amǝ'eambǝam, wu tsǝkmǝsǝ wun arǝ aɓwana mǝnana à kǝ yinǝ gakkya aɓalǝ wun, sǝ à nǝ̀ tsǝk wun a ɓwarki tanjar, nǝ akanìgìr mǝnana à nda ɗàng andǝ mǝnana à kania wun ngga. Wu nyia zak, ce wu sung abania ɗàng! <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Acemǝnana à ulang aɓwana mǝno ka, à pà aban pakki Mǝtala sǝm Kǝrǝsti túró ɗang, túró nzal kunia nda à nakiyi ce ka. Nǝ kunɓoarna andǝ nacau mǝɓuɓɓuki sǝ à kǝ ɓosǝki ɗenyicau mala aɓwana mǝnana à súrǝ̀ kǝgìr raka. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Ɓwapǝndǝa kat ongŋǝna ce okiru ma'wun, sǝ ban kǝ ɓoaram ace mani. Ən nggǝ earce nǝma wu duk amǝ sǝlǝe arǝ gir mǝnana mǝɓoarne na, sǝ ɓǝ̀ wu dum nǝ ɗwanyicau-arǝǔ arǝ gir mǝnana mǝɓike na ka.<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />Ɓakuli mǝ pà dorǝpwala ka malanǝ̀ parki Shetan aɓa kusǝ wun.<note caller="+" style="f"><char style="fr" closed="false">16:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 16:23">1Kor 16:23</ref>; <ref loc="2CO 13:14">2Kor 13:14</ref>; <ref loc="GAL 6:18">Gal 6:18</ref>; <ref loc="PHP 4:23">Filp 4:23</ref>; <ref loc="1TH 5:28">1Tas 5:28</ref>; <ref loc="2TH 3:18">2Tas 3:18</ref>; <ref loc="REV 22:21">Sǝn 22:21</ref></char>.</note></para>
  <para style="p" vid="ROM 16:20">Ɓǝ̀ ɓwamuru mala Yesu Mǝtala sǝm do atà wun.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timoti, ɓiam mǝtúró, kǝ makka wun kûn. Anggo gbal sǝ Lukiyus, andǝ Jasǝn, andǝ Sosipata, aɓǝla mem, à kǝ makka wun kûn.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Mim Tatiyus, mǝnana ǝn gilǝì Bulǝs mǝnia yì cauterǝa aban ká aban wun ngga, ǝn nggǝ makka wun kûn, kǝla mwashat atà amǝkpata Mǝtalabangŋo.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayus, ɓwa mǝnana ǝn sulǝo a ɓala male, sǝ a ɓala male sǝ amǝkpata Ɓakuli mana akani kǝ̀ kpapi ka, kǝ̀ makka wun kûn.</para>
  <para style="p" vid="ROM 16:23">Arasǝtus, mǝ'tsǝk boalo mala nggea-là, andǝ mǝ'eam sǝm Kwartus, à kǝ makka wun kûn.<verse eid="ROM 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 16:24" />[Ɓǝ̀ ɓwamuru mala Yesu Kǝrǝsti Mǝtala sǝm, do atà wun. Ɓǝ̀ do anggo.]<note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">Aɓea atà malǝmce mǝnana à gilǝia nǝ bu ka à nda à karǝ mǝnia ka.</char></note><verse eid="ROM 16:24" /></para>
  <para style="s">Masǝlǝata hiwi nǝ <optbreak /> ɓwangsǝkiban</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Ɓǝ̀ sǝm pè Ɓakuli gulo! Acemǝnana nǝ̀ gandǝ tsǝk wun, wu nǝ̀ cam nǝ rǝcandǝa aɓa paɓamuru ma'wun, kǝla mǝnana ǝn nggǝ hamnǝi aɓa Cau Amsǝban ngga. Mǝnia yì cau amur Yesu Kǝrǝsti ka, yi lǝmdǝ kane mala Ɓakuli, yì kane male mǝnana à sǝmbǝrǝ ce ɓara-ɓara. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Sǝ adyan ngga, mǝnia yì kane ka, amalǝmce mala amǝ'ɓangnǝa mala Ɓakuli mǝnana à gilǝia ka, à yì pusǝna ce a banfana. Ado ka, aɓa nê mala Ɓakuli mǝnana tè malkiyi raka, mǝnia yì cau ka à yì bǝlǝna ɓālǝi aban acili akún mala ɓanza kat, à sùrǝ́nì, ace mǝnana yia gbal ka ɓǝà paɓamuria, ɓǝà kpate.<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />Aban kǝ Ɓakuli nǝmurǝì, mǝnana kǝ yì mwashat nda mǝsǝle kat ka, ɓǝ̀ gulo pa, nǝ bu Yesu Kǝrǝsti, málá male pà kàm ɗàng! Ɓǝ̀ do anggo.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>