<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Mbula</book>
  <para style="h">Amǝ Kolosi</para>
  <para style="toc3">Kol</para>
  <para style="toc2">Amǝ Kolosi</para>
  <para style="toc1">Amǝ Kolosi</para>
  <para style="mt2">Cauterǝa mala Bulǝs aban ká a ban</para>
  <para style="mt1">AMƏ KOLOSI</para>
  <para style="imt">Mǝncau</para>
  <para style="im">
    <char style="bk">Cauterǝa mala Bulǝs aban ká a ban Amǝ Kolosi </char> ka, à gilǝì aban ká aban ikǝlisiya mǝnana a Kolosi, ɓe nggea-là a nzali Asiya Mǝkyauwe, mǝnana dǝurǝo mala nzali yi kiɗikì a pǝlǝa 60 AD ka. Ikǝlisiya mǝnia a la man ngga Bulǝs nǝ̀ mǝnni ɗang, Abafǝras na, sǝ acemǝnana nda aɓa nzong-nzali ban mǝnana Bulǝs twalî ɓamúrì nǝ̀ ɗenyi nǝi ka, kǝ tasǝ amǝtúró à kǝ pur Afisu ɓǝà kyan nggam. Yì Abafǝras ka ɓe ɓwamǝgule na amur amǝkwaɗi; à bang cau male kusǝ pas aɓa mǝnia yì cauterǝa ka, sǝ yì ka, à nda atārǝia andǝ Bulǝs a kùrban a bàkú mǝnana à gilǝ mǝnia yì cauterǝa ka.</para>
  <para style="iot">Agir mana aɓalǝi ka</para>
  <para style="io1">Makkun<char style="ior"><ref loc="COL 1:1-8">1:1-8</ref></char></para>
  <para style="io1">Ɓealǝu mala Kǝrǝsti andǝ túró male<char style="ior"><ref loc="COL 1:9-2:19">1:9--2:19</ref></char></para>
  <para style="io1">Bǝsa yilǝmu aɓa Kǝrǝsti<char style="ior"><ref loc="COL 2:20-4:6">2:20--4:6</ref></char></para>
  <para style="io1">Masǝlǝata cau<char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">Makkun mala Bulǝs</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />Mim Bulǝs, mǝnana mǝ nda mǝ'mishan mala Kǝrǝsti Yesu, nǝ kanì mala Ɓakuli ka, mim sǝnǝ mǝ'eam sǝm Timoti, sǝm gilǝ mǝnia yì Cautera ka.<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />Aban ká aban aɓwana mala Ɓakuli mǝnana a nggea-là mala amǝ Kolosi, yia amǝ'eamrǝarǝu aɓa Kǝrǝsti mǝnana à dum nǝ mǝsǝcau aban Ɓakuli ka. Tár sǝm Ɓakuli ɓǝ̀ pà wun ɓwamuru andǝ dorǝpwala.<verse eid="COL 1:2" /></para>
  <para style="s">Yàwá andǝ hiwi mala Bulǝs</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />Aɓa hiwi ma'sǝm ace wun koya pwari ka, sǝm nggǝ pakki Ɓakuli, Tár Mǝtala sǝm Yesu Kǝrǝsti yàwá, <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />acemǝnana sǝm ongŋǝna cè paɓamuru ma'wun aɓa Kǝrǝsti Yesu andǝ earcearǝu ma'wun aban aɓwana mala Ɓakuli kat. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />Mǝno yì paɓamuru andǝ earcearǝu ma'wun ngga, pur aɓa tsǝkɓalǝu ma'wun arǝ agir mǝnana Ɓakuli tsǝka wunì a kùli ka, mǝnana wu okce aɓa mǝsǝcau mala Cau Amsǝban <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />mana à yinanǝi aban wun ngga. Mǝnia yì Cau Amsǝban ngga, nda ban mǝsǝe a ɓanza kat. Nda ban pusǝ ɓealu a koya ban, kǝ nggaɗi do mala aɓwana kǝla mǝnana nggaɗi do ma'wun, a pwari mǝnana wu tita o sǝ wu bwalta mǝsǝcau amur ɓwamuru mala Ɓakuli ka. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />Abafǝras, ɓi'sǝm mǝtúró mǝnana sǝm earkiyi ace raka, nda ɓwa mǝnana nǝ baní sǝ wu kum sǝlǝe amur mǝnia yì ɓwamuru ka. Yì ka, mǝtúró mala Kǝrǝsti na nǝ mǝsǝcau, sǝ nda mǝnana kǝ bwala sǝm túró ace wun ngga.<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 4:12">Kol 4:12</ref>; <ref loc="PHM 1:23">Film 23</ref></char>.</note> <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />Yì ɗǝm ngga, yi bangŋǝna sǝm cè earcearǝu ma'wun mǝnana Bangŋo Mǝfele pà wun ngga.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />Acemani ka, twal a pwari mǝnana sǝm tita okce wun ngga, sǝm usǝlǝkiyi pàk hiwi ace wun ɗàng. Sǝm nggǝ zǝmbi Ɓakuli ɓǝ̀ pà wun sǝlǝe mala súrǝ̀ gir mǝnana earkiyice kat ka, sǝ ɓǝ̀ pà wun sǝlǝe mala Bangŋo andǝ bwalta kusǝ agir male kat. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />Sǝm nggǝ pàk hiwi mǝnia ka ace mǝnana ɓǝ̀ do ma'wun gusǝlǝ Mǝtalabangŋo, ɓǝ̀ pwasǝ bumi a koya njar, nǝ pak koya túró mǝɓoarne. Anggo sǝ wu nǝ̀ nggǝ gulo aɓa súrǝ̀ Ɓakuli pepè. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />Sǝm nggǝ pakhiwi ɗǝm ama kusǝ wun ɓǝ̀ candǝ aɓa rǝcandǝa mala gulo male mǝnana karban kat ka. Anggo sǝ wun nǝ̀ kum gandǝrǝu aɓalǝ agirbunda kat nǝ munyi, sǝ wun nǝ̀ lùmsǝ nǝ banɓoarnado. <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />Ko aya pwari ka wun nǝ̀ nggǝ pakki Tár sǝm Ɓakuli yàwá. Yì na tsǝa sǝ wu duk aɓwana mǝnana wu kārǝ́na wun nǝ̀ kum kāmbe ma'wun aɓa liɓala atà aɓwana male mǝnana à do aɓa tǎlaban ngga. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />Acemǝnana amsǝna sǝm aɓata parban mala Shetan,<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="fq" closed="false">amsǝna sǝm aɓata parban mala Shetan </char><char style="ft" closed="false">Ko: amsǝna sǝm, sǝm purni rǝcandǝa mala pǝndǝa.</char></note> sǝ yina nǝ sǝm aɓa Domurǝm mala Muni mǝnana earkiyi ace raka, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />mǝnana akmúr sǝm sǝ twalban acauɓikea ma'sǝm ngga.<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 1:7">Afi 1:7</ref>,<ref loc="EPH 1:8">8</ref></char>.</note><verse eid="COL 1:14" /></para>
  <para style="s">Kǝrǝsti gulo karban kat</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />Kǝrǝsti ka nda ɓwa mǝnana à kǝ sǝni, mana lǝmdǝ Ɓakuli mǝnana à kǝ sǝni raka. Kaniama Ɓakuli nǝ̀ pusǝ agirbunda kat ka, yì ka, ndakam atà Ɓakuli kǝla Muna-dǝmba male, sǝ ndanǝ gulo kàrmúr agir mǝnana kat Ɓakuli pusǝia ka. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />Nǝ baní sǝ Ɓakuli pusǝ koya gìr mǝnana a kùli andǝa mǝnana a nzali ka. Yì nǝ̀ pusǝ agir mǝnana à kǝ sǝnia andǝa mǝnana à kǝ sǝnia raka; kat andǝ abuno-murǝm, andǝ adomurǝm, andǝ amǝ'talanzali, andǝ amǝ bwal gara-murǝm. Nǝ yi sǝ à pusǝ koya gìr ka, sǝ àkǝ̀ cè gulo male sǝ à pusǝia. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />Kaniama à nǝ̀ pusǝ koya gìr ka ndakam, sǝ yì nǝ̀ bwal agir mǝnana à pusǝia ka a banɓwáná. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />Kǝrǝsti ɗǝm ngga nda múr amǝkpate, yia amǝnana à nda ka nggūrǝì ka. Yì ka, nda tǝr bǝsa yilǝmu mala amǝkpate. Yì nda mǝdǝmba loapi ɓembe, ace mǝnana aɓa ko man kat ka ɓǝ̀ do nda mǝnana a dǝmba amur agir kat ka.<note caller="+" style="f"><char style="fr" closed="false">1:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 1:22">Afi 1:22</ref>,<ref loc="EPH 1:23">23</ref>; <ref loc="EPH 4:15">4:15</ref></char>.</note> <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />Acemani ka, Ɓakuli aɓa pa male kat ka, banɓoari wi ɓǝ̀ lǝmdǝ rǝì aɓa Muni,<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="ft" closed="false">Ko: </char><char style="fqa" closed="false">Ɓakuli ka eare male na ɓǝ̀ nying pa male kat kǝla Ɓakuli ɓǝ̀ do aɓa Muni. </char></note> <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />sǝ nǝ ban Muni ka ɓǝ̀ gilǝki tàrǝu mala agirbunda kat andǝi. Nǝ nkila mala Muni mǝnana sukki amur nggun-gangndǝi ka, yina nǝ dorǝpwala, ace mǝnana agir mana kat a kùli andǝa mǝnana a nzali ka, à nǝ̀ nyesǝia aban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">1:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 2:16">Afi 2:16</ref></char>.</note><verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />Ɗiɗyal ka wu cambi Ɓakuli zak. Wu duk aɓiubura mala Ɓakuli aɓalǝ aɗenyicau ma'wun, mana wu lǝmdǝí nǝ atúró ɓealɓikea ma'wun ngga. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />Sǝ adyan ngga, Ɓakuli nyesǝna wun aɓa dotarǝu andǝi, nǝ lú mala Kǝrǝsti aɓa nggūrǝì mala ɓwapǝndǝa. Nyesǝ wun ace mǝnana ɓǝ̀ pǝlǝ wun, ɓǝ̀ wu duk aɓwana ace Ɓakuli, amǝ ɗwanyicau-arǝǔ a sǝne male,<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="fq" closed="false">ace mǝnana ɓǝ̀ pǝlǝ wun, ɓǝ̀ wu duk aɓwana ace Ɓakuli, amǝ ɗwanyicau-arǝǔ a sǝne male </char><char style="ft" closed="false">Ko: &lt;&lt;sǝ earǝ́nà wun ɓǝ̀ wu came a ɓadǝmbi kǝla aɓwana male, amǝ ɗwanyicau-arǝǔ.&gt;&gt;</char></note> aɓwana mǝnana à pà nǝ̀ tsǝkia wia kún raka. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />Sǝama dumǝna púp wun nǝ̀ lidǝmba nǝ earnǝ mǝno yì mǝsǝcau ka, andǝ tamsǝ kusǝ wun kàngkàng amurí. Wu kǝa tusǝ kusǝ wun arǝ tsǝkɓalǝu mǝnana wu oè aɓa Cau Amsǝban ngga ɗàng. Mǝnia yì Cau Amsǝban ngga à hamǝna nǝi a koya bum-ban a ɓanza, sǝ àkǝ̀ cè sǝ mim Bulǝs ka, ǝn duk guro mala Ɓakuli, ace hamnǝi.<verse eid="COL 1:23" /></para>
  <para style="s">Túró mala Bulǝs ace amǝkpata Yesu</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />Sǝ ado ka ban kǝ ɓoaram arǝ tanni mǝnana ǝn nggǝ nu ace wun ngga. Acemǝnana aɓa tanni mem a nggūrǝu ka, mǝ nda ban ɓariki mǝ lùmsǝkún gir mǝnana ueo aɓa tanni mala Kǝrǝsti ace nggūrǝì, yì amǝkpate. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />Ɓakuli tsǝngŋǝnami a buam ɓǝ̀n pakki ikǝlisiya, yia amǝkpata Yesu túró, mǝ nggǝ hamnǝ cau male kat aban wun. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />Mǝnia yì cau ka à sǝmbǝrǝce arǝ apǝlǝa ɓara-ɓara andǝ anza mǝno à kutikina ka, sǝ adyan ngga à pusǝni aban aɓwana mala Ɓakuli, ɓǝà sǝlǝce. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />Ɓakuli earnace ɓǝ̀ aɓwana male sǝlǝce gulo andǝ kume mana aɓa mǝnia yì cau-ɓa-sǝmbǝrǝa, mǝnana ndanǝi ace aɓwana mana amǝ Yahudi na raka.<note caller="+" style="f"><char style="fr" closed="false">1:27 </char><char style="fq" closed="false">aɓwana mana amǝ Yahudi na raka. </char><char style="ft" closed="false">Ko: aɓwapǝndǝa mala anzali ɓanza ka.</char></note> Sǝ mǝnia yì cau-ɓa-sǝmbǝrǝa ka nda mǝnana ama: Kǝrǝsti mǝnana do aɓalǝ wun ngga, nda tsǝkɓalǝu ma'wun mala kum kāmbe aɓa gulo mala Ɓakuli.<verse eid="COL 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28" />Nda gìrnî sǝ sǝm nggǝ banggi aɓwana cau mala Kǝrǝsti, sǝm nggǝ nunkir koyan ngga. Sǝm nggǝ kani koyan ngga nǝ sǝlǝe mǝnana kat Ɓakuli pa sǝm ngga. Sǝm nggǝ earce ama sǝm nǝ̀ yinǝia a ɓadǝm Ɓakuli kǝla aɓwana mǝnana à lùmsǝ̀nà aɓa do malea andǝ Kǝrǝsti ka. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />Acemani ka ǝn nggǝ paktúró, ǝn nggǝ ɓariki kǝ̀rkǝ́r, nǝ gūlì arǝ rǝcandǝa mǝgule mala Kǝrǝsti mǝnana pàkkiyi túró aɓalǝam ngga.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />Ən nggǝ earce ɓǝ̀ wu súrǝ̀ ulang tanni mǝnana ǝn nggǝ tanni ace wun, andǝ amǝkpata Yesu mǝnana a Lawodisi, andǝ amǝkpata Yesu mǝnana kat à malaká sǝnam à súrǝàm raka. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />Ən nggǝ pak mǝnia ace mǝnana ɓǝà kum ɓakɓabum, sǝ ɓǝà duk mwashat aɓa earcearǝu. Ən nggǝ earce nǝma ɓǝà kum lùmsǝo mala ɓabumcandǝa ama à bwalǝnata kàné mala Ɓakuli mana sǝmbǝrǝce ɗiɗyal ka, yì Kǝrǝsti nǝ ɓamúrì. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />Aɓa Kǝrǝsti sǝ gǝna mala sǝlǝe andǝ súrǝè mala Ɓakuli kat sǝmbǝrǝa. <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />Ən nggǝ na wun mǝnia yì cau ka ace mǝnana kǝɓwa ɓǝ̀ kǝa swarki wun nǝ kunɓoarna ɗang. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />Ko ɓǝ̀ do ama ǝn pa atà wun aɓa nggūrǝu raka, mǝ nda atà wun aɓa bangŋo. Sǝ ban kǝ ɓoaram arǝ gya a tàrǝu ma'wun, andǝ came mala paɓamuru ma'wun nǝ rǝcandǝa aban Kǝrǝsti.<verse eid="COL 2:5" /></para>
  <para style="s">Kum-ɓamuru andǝ bǝsa <optbreak /> yilǝmu aɓa Kǝrǝsti</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />Sǝ adyan ngga, kǝla mǝnana wu angŋǝna Kǝrǝsti Yesu, dumǝna mǝtala wun ngga, wu lidǝmba nǝ kpate. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />Nlerǝ wun ɓǝ̀ ko aɓa Kǝrǝsti, sǝ ɓǝ̀ duk kusǝɓa mala do ma'wun. Ɓǝ̀ paɓamuru ma'wun kum rǝcandǝa kǝla mǝnana à kania wun ngga, sǝ wu lùmsǝ nǝ pak yàwá.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />Wu kǝa eari kǝɓwa ɓǝ̀ swarki wun nǝ amakgìr amur súrǝè male mǝlime mana ɓekǝ mǝɓoarne pà kàm aɓalǝi raka. Ulang mǝno yì amakgìr ka à kǝ pur aɓa kanigir mana à kumi a bu ɓwapǝndǝa, andǝ abangŋo mala ɓanza man, mǝnana mala Kǝrǝsti na raka. <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />Acemǝnana lùmsǝo mala Ɓakuli kat aɓa nggūrǝu ka, aɓa Kǝrǝsti sǝ pa. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />Sǝ wun gbal ka, wu lùmsǝ̀nà ace dotarǝu ma'wun wunǝa Kǝrǝsti, yì ɓwa mǝnana nda amur amǝ'yálmúrû andǝ amǝ-gara kat ka. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />Kǝrǝsti gbal ka twalǝna wun ɓealu mala cauɓikea, kǝla mǝnana kasǝ-ɓatau pusǝ nggū arǝ nggūrǝu ka. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />Wun ngga, à oasǝna wun a ɓembe wunǝa Kǝrǝsti nǝ batisǝma mǝnana à pakka wun ngga, sǝ aɓa batisǝma ɗǝm ngga à loasǝna wun aɓa bǝsa yilǝmu, nǝ gūlì ma'wun arǝ rǝcandǝa mala Ɓakuli mǝnana loasǝ Kǝrǝsti a ɓembe ka.<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 6:4">Rom 6:4</ref></char>.</note><verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />Ɗiɗyal ka, wu wú atàcau mala acauɓikea ma'wun, andǝ aɓealu mala cauɓikea ma'wun mǝnana à gau wun wunǝia raka.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">Ɗiɗyal ka, wu wú atàcau mala acauɓikea ma'wun, andǝ aɓealu mala cauɓikea ma'wun mǝnana à gau wun wunǝia raka. </char><char style="ft" closed="false">Ko: &lt;&lt;Ɗiɗyal ka, wu nda ka lú acemǝnana wu nda aɓalǝ acauɓikea, sǝ wu nda ka ɓwana mala Ɓakuli ɗang.&gt;&gt;</char></note> Sǝ adyan ngga Ɓakuli pana wun yilǝmu aɓa Kǝrǝsti, lang yi twala sǝm ban acauɓikea ma'sǝm kat ka.<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 2:1-5">Afi 2:1-5</ref></char>.</note> <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />Yi panzǝki ɓashi mǝnana à gilǝì amur sǝm ngga; yi kasǝki kat andǝ anzongcau mala nggurcau mǝnana à bwal sǝm nǝi ka; twalia umnǝia kya gbàllia a nggun-gangndǝi.<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 2:15">Afi 2:15</ref></char>.</note> <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />Yi ak agirbura mala amurǝma andǝ arǝcandǝa mala abangŋo. Pea wia kǝsǝkya a banfana bwāng, nǝ limurǝm male amúrià amur nggun-gangndǝi.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />Acemani ka, wu kǝa eari kǝɓwa ɓǝ̀ tsǝka wun nzongcau amur agir mǝnana wun nǝ̀ li ko wun nǝ̀ nu ka, ko amur cau mala pakki alamsan mala aɓea kunacau, ko mala came mala bǝsa zongŋo, ko mala Pwari Sabbat ɗang.<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ROM 14:1-6">Rom 14:1-6</ref></char>.</note> <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />Amǝnia yì agir ka, ayilǝmi agir mǝɓafoe mǝnana à nda rǝ yiu ka nda. Sǝ Kǝrǝsti nǝ nggearǝì ka nda kǝ ɓafoe. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />Wu kǝa eare ɓǝ̀ kǝ ɓwa mǝ'earce pàkkiagir nyesǝmuru mǝ'nyirì<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="fq" closed="false">mǝ'earce pàkkiagir nyesǝmuru mǝ'nyirì: </char><char style="ft" closed="false">Ko &lt;&lt;ɓwa mǝnana cam kingging nǝ kanigir ama ɓwa nǝ̀ kum nyesǝmuru nǝ ɓinǝì ɓamúrì do aɓa ɓǝlkya andǝ banɓoarnado ka.&gt;&gt;</char></note> andǝ mǝperi aban amǝturonjar nyesǝce wun ɓà<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Ko </char><char style="fqa" closed="false">&lt;&lt;Wu būrǝce aɓwana mǝnana à kǝ na wun ama Ɓakuli nǝ̀ ɓasha wun ace mǝnana wu kǝ kpata pàkkiagir malea mala nyesǝmuru mǝ'nyirì andǝ peri aban amǝturonjar raka.&gt;&gt;</char></note> nǝ nacau gula ama sǝna na sǝn amur amǝnia yì agir ka ɗang. Acau mala ɓwa kǝla mǝno ka amǝɓane na, acemǝnana yì ka, lùmsǝ nǝ twàlɓamúrû, sǝ ɗenyicau male ka, mala earce gìr mala ɓamúrì na. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />Mǝnia yì ɓwa ka pa ɗǝm aɓa kpapi andǝ Kǝrǝsti, mǝnana nda mur nggūrǝu kat, yia amǝkpata Yesu ka ɗang. Acemǝnana Kǝrǝsti ka nda kùr múr amǝkpate a banɓwáná, kǝla mǝnana mazo kpakǝri amú ka. Kǝ linǝia, à kǝ gulo aɓa rǝcandǝa mala Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">2:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 4:16">Afi 4:16</ref></char>.</note><verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />Wun ngga, wu wuna wunǝa Kǝrǝsti sǝ à panzǝna wun a bu rǝcandǝa mala abangŋo mala mǝnia yì ɓanza ka. Sǝ ace mana sǝ wu kǝ dukdo kǝla weama wu nda ka mala ɓanza ka? Man tsǝa sǝ wu kǝ kpata anzongcau mala amǝɓanza mǝnana ama: <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />&lt;&lt;Kǝa bwal man ɗang. Kǝa ok mǝno a lasǝo ɗàng. Kǝa je amǝnia ka ɗang?&gt;&gt; <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />A'ulang amǝnia yì anggurcau ka, kǝ akanìgìr mala ɓwapǝndǝa na amur agir mǝnana, aɓa pak túró nǝia ka, à pà nǝ̀ sau ɗang à nǝ̀ kiɗiki ka. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />A'ulang anggurcau man ngga à lǝmdǝa kǝla sǝlǝe na aɓalǝia, acemǝnana à kǝ earce ama ɓwa ɓǝ̀ oasǝ ɓamúrì aɓalǝia ɓǝ̀ peri aban amǝturonjar, ɓǝ̀ ɓinǝì ɓamúrì do aɓa ɓǝlkya andǝ banɓoarnado, sǝ ɓǝ̀ pe nggūrǝì tanni. Sǝa ma amǝno ka à pà nǝ̀ tsǝk ɓwa nǝ̀ limurǝm amur asuno mǝɓane mala nggūrǝì ɗang.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">Do bǝsa yilǝmu</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />Acemǝnana à loasǝna wun nǝ bǝsa yilǝmu aɓa Kǝrǝsti ka, wu tsǝk ɓabum wun arǝ agir mǝnana a kùli, aban mǝnana Kǝrǝsti dukam abuno gulo a bù-mǝlì mala Ɓakuli ka. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />Ɓǝ̀ ɗenyicau ma'wun ɓǝ̀ o amur agir mǝnana a kùli ka, ɓǝ̀ kǝa nyare amur agir mǝnana a nzali ka ɗang. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />Acemǝnana wun ngga, wu wunî doɓanza man, sǝ mǝsǝrǝ yilǝmi wun ngga à sǝmbǝrǝni atà Kǝrǝsti aban Ɓakuli. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />Sǝ ɓǝ̀ Kǝrǝsti mǝnana nda tǝr bǝsa yilǝmu ma'wun, yi pusǝna rǝì aban ɓanza kat ka, wun gbal ka wu nǝ̀ yia pusǝ rǝ wun aɓa gulo male.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />Ace mani ka, wu wal-lú koya ɓeal wun mala pakki agirɓana mala ɓanza. Yì aɓealu kìɗìkì mala nongginǝ rǝarǝu, andǝ do-pǝndǝkya, andǝ nshawari, andǝ suno mǝɓane, andǝ shamgir mala ɓwa (acemǝnana shamgir mala ɓwa ka ɓè njar mala peri atà nkul na). <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />Ace amǝnia yì acauɓikea ka sǝ bumlulla mala Ɓakuli nǝ̀ yia sulǝo amur amǝ'murcandǝa. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />Aɓa do ma'wun mala gyata ɓanza ɗiɗyal ka wu pakkina amǝnia yì agir ka. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />Sǝ adyan ngga dumǝna púp wu nǝ̀ bwaki bu wun arǝ agir kǝla amǝnia ka: bumlulla, sǝ bumkpǝmna, sǝ ɓwashiriɓe, sǝ nacau kiɗiki ɓwa, andǝ naki acauɓana. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />Wu kǝa nea rǝ wun nyir ɗang, acemǝnana wu swárǝna ɓeal wun mǝ'e andǝ atúró ɓealɓikea male<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 4:22">Afi 4:22</ref></char>.</note> <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />sǝ wu twalǝna ɓealu mala bǝsa ɓwa. Mǝnia ka nda bǝsa ɓealu, mana Ɓakuli pusǝì ka. Yì ka nda rǝ pak túró nǝ̀ tsǝk mǝnia yì bǝsa ɓealu ma'wun ngga ɓǝ̀ lidǝmba nǝ pǝlǝ bǝshe a koya pwari, ace ká twal ulang male yì ɓealu, ace mǝnana ɓǝ̀ wu súrǝì pepè ka.<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 1:26">Tite 1:26</ref>; <ref loc="EPH 4:24">Afi 4:24</ref></char>.</note> <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />Aɓa mǝnia yì bǝsa yilǝmu ka, gakitacau pà kàm ɗǝm ɗàng ama mǝnia ka ɓwa Yahudi na, sǝ mǝnia ka ɓwa ɓe nzali na, mǝnia ka kasǝ ɓate, sǝ mǝnia ka kasǝ ɓate ɗàng. Kǝ cau pà kàm ɗǝm ama mǝnia ka súrǝ̀gir ɗàng, ko mǝnia ka ɓwa kúnɗàngna na, ko man ngga guro na, ko mǝno ka ndanǝ do-ɓamuri ka ɗàng. Kǝrǝsti ka nda komana le ka, sǝ nda mǝnana do a ɓabum sǝm kat ka.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />
    <note caller="+" style="f">
      <char style="fr" closed="false">3:12 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EPH 4:2">Afi 4:2</ref>
      </char>.</note>Sǝ acemǝnana Ɓakuli tarnà wun ɓǝ̀ wu duk aɓwana male mǝnana kǝ earcea ka, wu twal ɓealu mala sǝn mǝsǝswatǝr, andǝ pěmǝɓoarne, andǝ nyesǝɓamuru, andǝ doɓuɓɓuka, sǝ munyi. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />Wu kǝ twalban aɓwarkio mala rǝarǝ wun nǝ gandǝrǝu, sǝ wu kǝ twali koyana mǝnana pakka wun mǝɓane ka banì. Wu ɗenyi ama Mǝtalabangŋo twala wun banì, sǝ ace mani ka dumǝna wun púp wun nǝ̀ twalia rǝ wun banì.<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 4:32">Afi 4:32</ref></char>.</note> <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />Sǝ mǝnana kàrmuria kat ka nda, wu lùmsǝ nǝ earcearǝu, acemǝnana earcearǝu na kùr komana kat ka arǝarǝia aɓa lùmsǝo mala dotarǝu mǝɓoarne.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />Sǝ wu nying dorǝpwala mǝnana pur nǝban Kǝrǝsti ka, ɓǝ̀ ak ɓabum wun. Acemǝnana kǝla nggūrǝu mǝ'mwashati ka, à tunǝ wun ace dorǝpwala. Koya pwari ka wu kǝ pak yàwá. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />Ɓǝ̀ cau mala Kǝrǝsti, nǝ ɓoaro male kat ka, lùmsǝ ɗenyicau ma'wun. Wu kǝ kania rǝ wun gir sǝ wu kwarkir rǝarǝ wun, nǝ sǝlǝe mǝnana kat Kǝrǝsti pa sǝm ngga. Wu kǝ tuka anggyal ɓwangsǝ Ɓakuli, andǝ anggyal gusǝlǝ Ɓakuli, andǝ anggyal ɓak aɓwana aɓa bangŋo, nǝ ɓabum pak yàwá aban Ɓakuli.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:19">Afi 5:19</ref>,<ref loc="EPH 5:20">20</ref></char>.</note> <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />Sǝ ɓǝ̀ mana kat wun nǝ̀ pa, ko wun nǝ̀ na ka, wu pè nǝ ɗenyicau ama wu nda ban pe kǝla amǝ'nakún Mǝtalabangŋo Yesu, wu kǝ pakki Tár sǝm Ɓakuli yàwá nǝ bani yì Kǝrǝsti.<verse eid="COL 3:17" /></para>
  <para style="s">Anzongcau ace doɓala <optbreak /> mala amǝkwaɗi</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />Wun amā-ɓala ka, wu nyesǝ mur wun aɓata abura wun, kǝla mǝnana ɓoaro amǝkwaɗi Mǝtalabangŋo ɓǝa pak ka.<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:22">Afi 5:22</ref>; <ref loc="1PE 3:1">1Bit 3:1</ref></char>.</note><verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />Wun aburana, wu earce amālá wun, wu kǝa wu pekia ɗang.<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:25">Afi 5:25</ref>; <ref loc="1PE 3:7">1Bit 3:7</ref></char>.</note><verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />Wun amuna ka, wu okî amǝɓǝl wun, acemǝnana mǝnia ka kǝ pwasǝbum Mǝtalabangŋo.<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 6:1">Afi 6:1</ref></char>.</note><verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />Wun atárrú, wu kǝa wu soaki ɓabum amuna wun ɗang, ɓǝa a na raka wu nǝ̀ ɓungi ɓabumia.<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 6:4">Afi 6:4</ref></char>.</note><verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />
    <note caller="+" style="f">
      <char style="fr" closed="false">3:22 </char>
      <char style="ft" closed="false">Ɓalli gbal aɓa: </char>
      <char style="xt">
        <ref loc="EPH 6:5-8">Afi 6:5-8</ref>
      </char>.</note>Wun aguro ka, wu okî amǝtala-ɓala ma'wun a ɓanza aɓa koya gir wu nǝ̀ pak kat ka. Wu ɓariki wu pak túró mǝnana nǝ̀ pwasǝ bumia koya pwari ka. Wu kǝa pe acemǝnana à nda ban sǝn wun ngga ɗang, wu pakkia wia túró nǝ ɓabum mwashat ace pagulo aban andǝ ɓanggi Mǝtalabangŋo. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />Ɓǝ̀ mana wu pakkiyi ka, wu pak túrè nǝ ɓabum wun kat kǝla Mǝtalabangŋo na wu pakkiyi wi ka, ɓwapǝndǝa na ɗang. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />Wu kǝ ɗenyi ama tangnakusǝu mǝnana Mǝtalabangŋo nǝ̀ pa wun ngga nda liɓala, sǝ mǝtala-ɓala mǝnana wu pakkiyi wi túró ka, Kǝrǝsti na. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />Sǝ ɓǝ̀ wu kǝ pak túró ɓealɓikea ka, à nǝ̀ mbwe wun nǝ tangnakusǝu mǝkwanbanì. Acemǝnana ɓashi mala Ɓakuli aban aɓwana kat ka, mǝ'mwashati na<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="fqa" closed="false">Ko: &lt;&lt;Ɓakuli ka kǝ lǝmdǝ tàrban ɗang.&gt;&gt;</char></note>.<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 10:17">Nggur 10:17</ref>; <ref loc="EPH 6:9">Afi 6:9</ref></char>.</note><verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="s">Akwarkiru</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />Wun amǝtala-ɓala, wu bwal aguro ma'wun nǝ mǝsǝcau, wu kǝ pakkia wia mǝɓoarne. Wu ɗenyi ama wun gbal ka wu ndanǝ mǝtala-ɓala akanó a kùli.<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 6:9">Afi 6:9</ref></char>.</note><verse eid="COL 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />Wu pa ɓamur rǝ wun arǝ pak hiwi, sǝ aɓa pe ka wu dum nǝ kwaro mala dǝmbu andǝ ɓabum mala pak yàwá aban Ɓakuli. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />Wu pakka sǝm hiwi gbal ama ɓǝ̀ Ɓakuli pa sǝm dǝmbǝu mala bang cau male, ɓǝ̀ sǝm hamnǝ cau-ɓa-sǝmbǝrǝa male mǝnana amur Kǝrǝsti ka. Àkǝ̀ ce mǝnia yì cau ka, sǝ mǝ nda a ndàkurban ado. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />Wu pak hiwi ama, mǝ hamnǝ mǝnia yì cau ka puret-puret, kǝla mǝnana ɓoaro mǝ hamnǝi ka.<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />Wu dum nǝ kwaro a do ma'wun aɓalǝ aɓwana mǝnana à ak Cau Amsǝban raka, sǝ koya dǝmbǝu mǝnana wu kum ngga, wu kǝa kiɗiki ce ɓà ɗang.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EPH 5:16">Afi 5:16</ref></char>.</note> <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />Cau mǝnana nǝ̀ puro a kun wun ngga, ɓǝ̀ pa aɓa ɓuɓɓuka mala ɗenyi nǝ ɓwa, sǝ ɓǝ̀ ɓoari ɓwapǝndǝa o, ace mǝnana anggo sǝ wu nǝ̀ súrǝ̀ lang sǝ wu nǝ̀ pǝlǝi koyan ngga cau, mana ɓǝa ɗì wun ngga.<verse eid="COL 4:6" /></para>
  <para style="s">Masǝlǝata akwarkiru andǝ <optbreak /> amakkun mala Bulǝs</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />Gyajam mǝɓoarne ma'sǝm Tikikus nǝ̀ bǝla wun ce gìr mǝnana mǝ nda aɓalǝi ka kat. Yì ka, mǝ'eamrǝarǝu mǝɓafoe na aɓa túró, ɓwa na mǝnana à nǝ̀ gūlì arǝì ka, sǝ ɓi'sǝm guro na aɓa túró mala Mǝtalabangŋo.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 20:4">Atúró 20:4</ref>; <ref loc="EPH 6:21-22">Afi 6:21-22</ref>; <ref loc="2TI 4:12">2Tim 4:12</ref></char>.</note> <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />Ən tasǝi aban wun, ace mǝnana ɓǝ̀ na wun gìr mǝnana sǝm nggǝ pak kani ka, sǝ ɓǝ̀ ɓak ɓabum wun. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />Ndya ɗǝm ǝn nggǝ tasǝ Onisǝmu ka. Yì gbal ka, mǝ'eamrǝarǝu mǝɓafoe na mǝnana à nǝ̀ gūlì arǝì ka, nggearǝ yì ka, kǝ ɓwa ma'wun na. Yì andǝ Tikikus ka à nǝ̀ bangga wun gìr mǝnana kat kǝ kumban kani ka.<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PHM 1:10-12">Film 10-12</ref></char>.</note><verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />Aristakus mǝnana nda kani atàm a ndàkurban ngga, kǝ makka wun kun, anggo gbal sǝ Markus mǝnana kèa mwashat andǝ Barnabas ka, kǝ makka wun kun. Kǝla mǝnana à bangŋǝna wun cau amurí yì Markus ka, ɓǝ̀ yina ka wu gingsǝi caca.<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="ACT 12:12">Atúró 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="PHM 1:24">Film 24</ref></char>.</note> <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />Yesu mǝnana à tunǝki ama Yustus ka, kǝ makka wun kún gbal. Kǝ amǝnia yì aburana ka, à nda ka amǝ Yahudi aɓalǝ aɓeam amǝtúró ace Domurǝm mala Ɓakuli. À ɓak ɓabumam nǝ rǝcandǝa.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />Abafǝras, mǝnana ɓi'wun na aɓa dotarǝu mala amǝ'eamrǝarǝu a akana aban wun, sǝ ɗǝm ngga guro mala Kǝrǝsti Yesu na ka, kǝ makka wun kún. Ko aya pwari ka kǝ pak hiwi ace wun nǝ mǝsǝcau, kǝ zǝmbi Ɓakuli ɓǝ̀ pa wun rǝcandǝa, sǝ ɓǝ̀ wu lùmsǝ nǝ mǝsǝkang-kangŋa, mǝnana wu nǝ̀ nggǝ kpata kani mala Ɓakuli kat ka.<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="COL 1:7">Kol 1:7</ref>; <ref loc="PHM 1:23">Film 23</ref></char>.</note> <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />Mǝ nǝ gandǝ na kúni ama kǝ pak túró kǝ̀rkǝ́r ace wun, sǝ ace amǝkwaɗi mǝnana a Lawodisi andǝ Herapoli ka.<verse eid="COL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="COL 4:14" />Luka, mǝsonzǝo mǝnana sǝm earkiyi ace raka, andǝ Dimas, à kǝ makka wun kún.<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2TI 4:10">2Tim 4:10</ref>,<ref loc="2TI 4:11">11</ref>; <ref loc="PHM 1:24">Film 24</ref></char>.</note><verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />Wu pa makkun mem aban amǝ'eamrǝarǝu mǝnana a Lawodisi ka, nggeamurǝmi ka mǝ'nggaula sǝm Nimfa, andǝ amǝkpata Yesu mǝnana à kǝ dapi a ɓala male ka.<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />Anzǝm mǝnana wu ɓalna mǝnia yì cauterǝa ka, wu tasǝia amǝkpata Yesu mǝnana a Lawodisi ka ɓǝa ɓalli gbal. Sǝ wun gbal ka wu ɓal malea mǝnana ǝn gilǝia wia ka.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />Sǝ wu banggi Arkipus mǝnia yì cau ka: &lt;&lt;Tsǝkiro arǝ túró mǝnana Mǝtalabangŋo po ka, masǝlǝte.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PHM 1:2">Film 2</ref></char>.</note><verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />Mim Bulǝs, mǝ nda ǝn gilǝ mǝnia yì makkun ngga nǝ buam.</para>
  <para style="p" vid="COL 4:18">Wu ɗenyi ama mǝ nda a ndàkurban.</para>
  <para style="p" vid="COL 4:18">Ɓwamuru mala Ɓakuli ɓǝ̀ do atà wun.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>