<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Mbula</book>
  <para style="h">Ace Apǝris</para>
  <para style="toc1">Tàruia Malǝmce mala Musa mǝnana à kǝ tunǝi ama Ace Apǝris ka</para>
  <para style="toc2">Ace Apǝris</para>
  <para style="toc3">Pǝris</para>
  <para style="mt1">Ace Apǝris</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">
    <char style="bk">Ace Apǝris</char> ka ndanǝ angguracau ace peri andǝ anàtà mala kpata Ɓakuli a ɓālǝi, mala do'nza mala amǝ Isǝrayila ɓara-ɓara; ɗǝm ngga ndanǝ angguracau ace apǝris mǝnana túró malea na ɓǝà pàk agir mǝnana angguracau mǝno bang ngga.</para>
  <para style="ip">Múrcau mǝgule mala malǝmcenî nda domǝfele mala Ɓakuli andǝ anjar mǝnana aɓwana male nǝ̀ kpatea ace peri sǝ à nǝ̀ dukdo mǝnana nǝ̀ yinǝ lidǝmba mala dotarǝu malea andǝi ka.</para>
  <para style="ip">Acau mǝnana aɓwana súrǝ̀ia pepè aɓa malǝmce mǝnia ka à nda ka amǝnana Yesu tunǝia ama ɓaria nzongcau mǝgule ka: &lt;&lt;Awu nǝ earce ɓio mǝ'murkala kǝla mana a earce ɓamurò ka.&gt;&gt; (<char style="xt" closed="false"><ref loc="LEV 19:18">19:18</ref>)</char></para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Anggurcau amur pāki aɓoro andǝ agir'nkila <char style="ior"><ref loc="LEV 1:1-7:38">1:1--7:38</ref></char></para>
  <para style="io1">Kùrî Haruna andǝ amuna-burana male túró-pǝris <char style="ior"><ref loc="LEV 8:1-10:20">8:1--10:20</ref></char></para>
  <para style="io1">Anggurcau amur pàkkiagir mala doɓoarnsari andǝ do-ɓeami <char style="ior"><ref loc="LEV 11:1-15:33">11:1--15:33</ref></char></para>
  <para style="io1">Pwari Shawuɗiban <char style="ior"><ref loc="LEV 16:1-34">16:1-34</ref></char></para>
  <para style="io1">Anggurcau amur domǝfele aɓa do andǝ peri <char style="ior"><ref loc="LEV 17:1-27:34">17:1--27:34</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />Yahweh tunǝ Musa, sǝ nacau nǝi nǝ ɓá Tara Ban-peri, ama, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila, sǝ wu banggia wia ama: Pwari mana koyan atà wun nǝ̀ yinǝ girkusǝu ace pagìr abanam Yahweh ka, ɓǝ̀ ɓwe twal atà andá ko anzur ko ambul mala domwan male, sǝ ɓǝ̀ yinǝi kǝla pàgir male.<verse eid="LEV 1:2" /></para>
  <para style="s">Anggurcau mala pàgir ace pisǝe kǝring</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 1:3" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa ka, ndǎ na twal a domwan nǝ̀ pǎ, ace pàgir mala pisǝe kǝring ngga, ɓǝ̀ yinǝ jamnda mǝnana kǝgìr mǝɓane pà kàm arǝì raka. Ɓǝ̀ yinǝi a bankutio aɓa Tara Ban-peri, ace mǝnana ɓǝ̀ duk gir'a a ɓadǝm Yahweh ka. <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />Yì ka nǝ̀ tsǝk bui a ɓamur jamnda mana yinǝi nǝ̀ pa ace pàgir mala pisǝe kǝring ngga, sǝ à nǝ̀ é a kúnì, ace shawuɗǝe. <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />Pǝlǝa yì ka nǝ̀ pwan-myal jamnda mǝno ka a ɓadǝm Yahweh, sǝ amuna-burana mala Haruna, yia apǝris ka, à nǝ̀ yinǝ nkile sǝ à nǝ̀ tàkki arǝ abumban mala gyangŋan mǝnana a bankutio aɓa Tara Ban-peri ka. <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />Pǝlǝa nǝ̀ ɓwā jamnda mǝno, mala pàgir ace pisǝe kǝring ngga, sǝ nǝ̀ sàngi, <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />sǝ amuna-burana mala Haruna, yià apǝris ka, à nǝ̀ ram gimsa amur gyangŋan, à nǝ̀ tsǝk bǝsa ɓǝ̀ tita earke. <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />Pǝlǝa amuna-burana mala Haruna, yià apǝris ka à nǝ̀ nongsǝki nyama mana à kasǝki ka, andǝ ɓamúrí, andǝ mùruí, amur gimsa mǝnana a bǝsa amur gyangŋan ngga; <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />sǝ agir-bumi andǝ akusǝi ka, ɓwê nǝ̀ lea nǝ mùr. Sǝ pǝris nǝ̀ pisǝia puppup a bǝsa amur gyangŋan, ɓǝ̀ duk pàgir mala pisǝe kǝring; pàgir nǝ bǝsa na, mala pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka.<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa ka, nzur ko mbul na twal a domwan nǝ̀ pǎ, kǝla pàgir ace pisǝe kǝring ngga, ɓǝ̀ yinǝ gam ko gbato mǝnana kǝgìr mǝɓane pà kàm arǝì raka. <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />Ɓǝ̀ ɓwê pwan-myali a bù gyangŋan mǝnana sǝn njar-nza ka, a ɓadǝm Yahweh. Sǝ amuna-burana mala Haruna, yià apǝris ka, à nǝ̀ tàkki nkile arǝ abumban mala gyangŋan. <verse eid="LEV 1:11" /><verse number="12-13" style="v" sid="LEV 1:12-13" />Ɓwê nǝ̀ sàngi nyami, sǝ agir-bumi andǝ akusǝi ka, nǝ̀ lea nǝ mùr, sǝ nǝ̀ kpapia andǝ ɓamúrí, andǝ mùruí. Sǝ pǝris nǝ̀ nongsǝki abare nyama man amur gimsa mana kǝ earki nǝ bǝsa amur gyangŋan ngga; nǝ̀ pà gir'nkila nǝia puppup, sǝ nǝ̀ pisǝia amur gyangŋan; pàgir mala pisǝe kǝring na; pàgir nǝ bǝsa na abanam Yahweh ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam ngga.<verse eid="LEV 1:12-13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa abanam Yahweh ka, anyal na ace pàgir mala pisǝia kǝring ngga, ɓǝ̀ yinǝ pàgir aɓalǝ akutumurǝm ko akutugangyi. <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />Sǝ pǝris ka nǝ̀ kánǝi amur gyangŋan, nǝ̀ pūrǝ myali ɓǝ̀ kasǝ kpat, nǝ̀ ɗārǝ́ nkile arǝ bum gyangŋan, sǝ nǝ̀ pisǝ ɓamúrí a bǝsa amur gyangŋan. <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />Nǝ̀ pusǝ bumi sǝ nǝ̀ sukki agir mana aɓalǝi ka a nkanggari gyangŋan, a bù gyangŋan mana sǝn njar-takuli ka, a ban mǝnana à kǝ̀ so tú kàm ngga. <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />Pǝlǝa nǝ̀ sàn nyalnì, nǝ̀ mǝni a ban ankpamtari, sǝama pà nǝ̀ gau rǝì kat ɗàng. Sǝ pǝris nǝ̀ pisǝì amur gyangŋan, amur gimsa mǝnana kǝ earki nǝ bǝsa ka. Pàgir mala pisǝe kǝring na; pàgir nǝ bǝsa na abanam Yahweh ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam ngga.&gt;&gt;<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s">Anggurcau ace pàgir mala mǝsǝsa</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />&lt;&lt;Lang koyan nǝ̀ yinǝ pàgir mala mǝsǝsa ace pàgir abanam Yahweh ka, pàgir male ɓǝ̀ duk muku mǝɓǝlke. Ɓǝ̀ soapi wi mùrú olif, sǝ ɓǝ̀ tsǝk myang-kwarra amurí, <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />sǝ ɓǝ̀ yinǝi aban amuna-burana mala Haruna, yià apǝris. Pǝris nǝ̀ ɗàrǝ́ muku mǝɓǝlke mǝno andǝ mùrú olif mana à soapi wi ka ɓǝ̀ lùmsǝ ɓabui, sǝ ɓǝ̀ twal myang-kwarra mǝno à yinǝi ka kat, pǝlǝa ɓǝ̀ soea a bǝsa ɓǝà pi amur gyangŋan. Mǝnia ka nda kāmbe mala kasǝɓalǝu;<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="fq" closed="false">kāmbe mala kasǝɓalǝu</char><char style="ft" closed="false">ko pàgir mǝno kat à pà ka, eauna aban Ɓakuli ace kasǝɓalǝi arǝ ɓwa mana pà ka; anggo gbal a mǝsǝì 9 andǝ 16 aɓa kùré mǝnia.</char></note> pàgir nǝ bǝsa na, mala pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka.<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 2:9">Pǝris 2:9</ref>,<ref loc="LEV 2:16">16</ref>; <ref loc="LEV 5:12">5:12</ref>; <ref loc="LEV 24:7">24:7</ref>; <ref loc="NUM 5:26">Ɓal 5:26</ref></char>.</note> <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />Cili pàgir mala mǝsǝsa mǝnia ueo à pisǝì raka, nǝ̀ duk mala Haruna andǝ amuna-burana male; mǝno ka nda kāmbe nggea mǝfele mala pàgir mala girlina abanam Yahweh.<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />&lt;&lt;Lang awu nǝ yinǝ pàgir mala mǝsǝsa mǝnana à lurǝi aɓa ovù, ace pàgir ka, she ɓǝ̀ duk agbatali kyak mǝnana à pè nǝ muku mǝsǝsa mǝɓǝlke mana à zurǝì andǝ mùrú olif ka, sǝama à pà nǝ̀ tsǝki wi yis arǝì ɗàng, ko ɓǝ̀ duk biskit mana à pè nǝ yis arǝì raka, sǝ à hasǝki wi mùrú olif arǝì ka.<verse eid="LEV 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5" />&lt;&lt;Ɓǝ̀ pàgir mala mǝsǝsa mò ka gìr na à kàngŋì aɓa nkenye kàng gìr ka, she à nǝ̀ pè nǝ muku mǝsǝsa mǝɓǝlke mana à zurǝì andǝ mùrú olif ka, sǝama à pà nǝ̀ tsǝki wi yis ɗàng. <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />Awu nǝ ɓwangi bǝti-bǝti, sǝ awu nǝ watsǝki wi mùrú olif arǝì. Mǝno ka nda pàgir mò mala mǝsǝsa.<verse eid="LEV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7" />&lt;&lt;Ɓǝ̀ pàgir mò ka pàgir mala mǝsǝsa na à lambi aɓa tasau ka, she à nǝ̀ pè nǝ muku mǝsǝsa mǝɓǝlke mana à zurǝì andǝ mùrú olif ka. <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />Sǝ awu nǝ yinǝ pàgir mala mǝsǝsa mò abanam Yahweh, sǝ ɓǝ̀ mǝye na à pè kǝla amǝno à bǝlɓalǝia ka; awu nǝ pè pǝris, sǝ yì ka nǝ̀ kánǝi amur gyangŋan. <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />Pǝris nǝ̀ twal kāmbe mala kasǝɓalǝu aɓa pàgir nǝ mǝsǝsa man, sǝ nǝ̀ pisǝì amur gyangŋan; pàgir nǝ bǝsa na ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />Cili pàgir mala mǝsǝsa mǝnia ueo à pisǝì raka, dumǝna mala Haruna andǝ amuna-burana male; pàgir nggea mǝfele na acemǝnana à twali aɓalǝ apagir mala girlina mana à pà abanam Yahweh ka.<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />&lt;&lt;Koya pàgir mala mǝsǝsa mǝnana wun nǝ̀ yinǝi abanam Yahweh ka, à pà nǝ̀ pè nǝ yis arǝì ɗàng; acemǝnana pà wun nǝ̀ pisǝ kǝ yis, ko mùr-nyì a bǝsa, kǝla pàgir nǝ bǝsa abanam Yahweh ɗàng. <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />Aɓǝlagir-mǝdǝmbe ma'wun ngga, wun nǝ̀ gandǝ yinǝia abanam Yahweh, sǝama à pà nǝ̀ pà ɓoro nǝia amur gyangŋan ace pà rǝmban mǝɓoarne mala pwasǝbum ɗang. <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />Koya pàgir mala mǝsǝsa ka, awu nǝ̀ kúnǝkì wi tuɓamur amurí. A pà nǝ eare ɓǝ̀ tuɓamur mala kùrcau wunǝ Ɓakuli ma'wun ɓǝ̀ ɗwanyi pa aɓa pàgir mala mǝsǝsa ɗàng; apagir mô kat ka awu nǝ pa nǝ tuɓamur arǝia.<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 2:14" />&lt;&lt;Ɓǝ̀ awu nǝ pàgir mala mǝsǝsa mala aɓǝlagir-mǝdǝmbe, abanam Yahweh ka, awu nǝ pà mana múr mǝsse ka, à loa cane sǝ à nyé ka. Múr mǝsse ka awu nǝ dandǝi amur bǝsa ɓǝ̀ wùlì, sǝ awu nǝ hārǝí. <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />Awu nǝ tsǝki wi mùrú olif arǝì, sǝ awu nǝ soapi wi myang-kwarra amurí. Mǝno ka nda pàgir mala mǝsǝsa. <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />Pǝris nǝ̀ ɗàrǝ́ aɓa mǝsǝsa mǝno mana à hārǝí sǝ à zurǝì andǝ mùrú olif ka, sǝ nǝ̀ kpapi andǝ myang-kwarra mǝno kat, sǝ nǝ̀ pisǝia, ɓǝ̀ duk kāmbe mala kasǝɓalǝu. Mǝno ka pàgir nǝ bǝsa na abanam Yahweh.<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s">Anggurcau mala pàgir ace dotarǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa ka girkusǝu na nǝ̀ twal a domwan male ace pàgir mala dotarǝu ka, ɓǝ̀ ɓwe pà jamne ko mǝ'nggaule, mǝnana ɓè kǝgìr mǝɓane pà kàm arǝì raka, a ɓadǝm Yahweh. <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />Ɓwe nǝ̀ nongsǝ bui a ɓamúr girkusǝu mǝnana nǝ̀ pànà ɓoro nǝi ka, sǝ nǝ̀ pwan-myali a bankutio aɓa Tara Ban-peri; sǝ amuna-burana mala Haruna, yià apǝris ka, à nǝ̀ tàkki nkile arǝ abumban mala gyangŋan. <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />Aɓa pà gìr'nkila mala dotarǝu mǝnana yì ka nǝ̀ pa, ɓǝ̀ duk pàgir nǝ bǝsa abanam Yahweh ka, ɓwe nǝ̀ pà mùrú-nyama mǝnana kat gìr múr agir-bum, andǝ mana lanzǝ arǝ agir-bum ngga, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />andǝ amuna-gbè ɓari andǝ mùrú-nyama mana lanzǝ arǝia, tù a ban ɓunì ka, andǝ ban mǝɓoarne mala nkundingŋi mǝnana à pusǝì atārǝia andǝ amuna-gbè ka. <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />Amuna-burana mala Haruna nǝ̀ pisǝ abare nyama mǝnia ka amur gyangŋan, atārǝia andǝ acili abare girkusǝu mana à nda amur nggun a bǝsa ka. Mǝnia ka pàgir nǝ bǝsa na abanam Yahweh ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam ngga.<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa ka girkusǝu na twal a domwan male, jamne ko mǝ'nggaule, ɓǝ̀ duk pàgir mala dotarǝu abanam Yahweh ka, ɓǝ̀ ɓwe pà mǝnana ɓè kǝgìr mǝɓane pà kàm arǝì raka. <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />Ɓǝ̀ nzur nda pàgir mala ɓwa ka, dumǝna púp nǝ̀ yinǝi aɓadǝmbam Yahweh. <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />Yì ka nǝ̀ tsǝk buì a ɓamúr girkusǝu male, sǝ nǝ̀ pwan-myali a bankutio aɓa Tara Ban-peri, sǝ amuna-burana mala Haruna ka, à nǝ̀ tàkki nkile arǝ abumban mala gyangŋan. <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />Pǝlǝa aɓa gìr'nkila mala pàgir ace dotarǝu ka, nǝ̀ yinǝ pàgir nǝ bǝsa abanam Yahweh nǝ pa mùruí, andǝ mùrú-nyama kat mala nggilate, mana à kasǝì tù a ban mù'nzǝmi ka, andǝ mùrú-nyama mana nong amúr agir-bumi, andǝ mùrú-nyama mana lanzǝ arǝ agir-bumi ka, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />andǝ amuna-gbè ɓari andǝ mùrú-nyama mana lanzǝ arǝia, tù a ban ɓunì ka, andǝ ban mǝɓoarne mala nkundingŋi mǝnana nǝ̀ pusǝì atārǝia andǝ amuna-gbè ka. <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />Sǝ pǝris nǝ̀ pisǝi a bǝsa, amur gyangŋan ɓǝ̀ duk pàgir nǝ bǝsa na abanam Yahweh.<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />&lt;&lt;Ɓǝ̀ pàgir mala ɓwa ka mbul na ka, dumǝna púp nǝ̀ yinǝi aɓadǝm Yahweh, <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />sǝ nǝ̀ tsǝk buì a ɓamúr mbulnî, sǝ nǝ̀ pwan-myali a ɓadǝm Tara Ban-peri, sǝ amuna-burana mala Haruna ka, à nǝ̀ tàkki nkile arǝ abumban mala gyangŋan. <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />Pǝlǝa aɓa paɓoro mǝnia ka nǝ̀ yinǝ pàgir male mala pàgir nǝ bǝsa<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">pàgir male mala pàgir nǝ bǝsa </char><char style="ft" closed="false">ko &lt;&lt;pagìr mala girlina&gt;&gt;</char></note> abanam Yahweh nǝ pa mùrú-nyama mana kat nong amúr agir-bumi, andǝ mana lanzǝ arǝ agir-bumi ka, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />andǝ amuna-gbè ɓari andǝ mùrú-nyama mana lanzǝ arǝia, tù a ban ɓunì ka, andǝ ban mǝɓoarne mala nkundingŋi mǝnana nǝ̀ pusǝì atārǝia andǝ amuna-gbè ka. <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />Sǝ pǝris nǝ̀ pisǝia a bǝsa amur gyangŋan, ɓǝ̀ duk pàgir mala girlina ace pà rǝmban mǝɓoarne mana kǝ pwasǝbumam ngga. Mùrú-nyama kat ka mem Yahweh na.<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 7:23-25">Pǝris 7:23-25</ref>; <ref loc="1SA 2:15">1Sam 2:15</ref>; <ref loc="EZK 44:7">Ezǝk 44:7</ref>,<ref loc="EZK 44:15">15</ref></char>.</note> <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />Acemani ka, wun wunǝ amuna ma'wun, andǝ amǝ'kà wun ngga, pà wun nǝ̀ lì kǝ mùrú-nyama ko nkila ɗàng, arǝ abando ma'wun kat. Mǝnia ka nǝ̀ dupa wun nggurcau mana nggaɗe pà kàm raka arǝ anza ma'wun kat tàtǝ́k.&gt;&gt;<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s">Anggurcau mala apagir ace lak cauɓikea</para>
  <para style="r">(<ref loc="LEV 6:24-30">Ace Apǝris 6:24-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />Yahweh ne Musa ama, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />Nacau nǝ amǝ Isǝrayila, sǝ wu banggia wia ama: Mǝnia ka nda gìr mǝnana à nǝ̀ pàk ka ɓǝ̀ ɓwa pàk cauɓikea aɓa ɓwarkio, mala yàllî mwashat atà anzongcau mala Yahweh mǝnana à pà amur agir mǝnana à pǝrban arǝia, sǝ kya pàk mwashat ateà ka.<verse eid="LEV 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3" />Ɓǝ̀ Pǝris Mǝgule na pàk cauɓikea ka, cauɓikea male nǝ̀ mesǝ amur koyan ngga. Acemani ka, dumǝna púp ama yì ka nǝ̀ pàgir ace cauɓikea<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ arǝ abân kat aɓa kùré mǝnia.</char></note> mǝnana pàk ka; nǝ̀ twal jamnda mǝnana ɓekǝ gìr mǝɓane pà kàm arǝì raka, a domwan, sǝ nǝ̀ pa abanam Yahweh, ɓǝ̀ duk pàgir ace lak cauɓikea. <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />Nǝ̀ yinǝ jamnda mǝnia ka a bankutio aɓa Tara Ban-peri, a ɓadǝm Yahweh, sǝ nǝ̀ nongsǝ bui a ɓamúr jamnda, sǝ nǝ̀ pwan-myali a ɓadǝm Yahweh. <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />Sǝ yì Pǝris Mǝgule ka, nǝ̀ ɗàrǝ́ aɓa nkila mala jamnda, nǝ̀ kùtí nǝi aɓa Tara Ban-peri, <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />nǝ̀ oasǝ munabuì aɓa nkila sǝ nǝ̀ watsǝki kusǝ tongno-nong-ɓari, a ɓadǝm Yahweh, a kusǝ lagìr-kasǝbân mala Ban-mǝfele. <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />Sǝ yì pǝris ka nǝ̀ ɗàrǝ́ aɓa nkila, nǝ̀ hasǝki arǝ anjawe gyangŋan mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne a ɓadǝm Yahweh, mǝnana nda aɓa Tara Ban-peri ka. Cili nkila jamnda mǝnana ue ka, dumǝna púp nǝ̀ solǝi kat a kusǝ gyangŋan mala pagìr mala pisǝe kǝring, mǝnana nda a bankutio aɓa Tara Ban-peri ka. <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />Sǝ mùrú-nyam jamnda mala pàgir ace cauɓikea ka nǝ̀ pusǝki kat; yì mùrú-nyama mana nong amúr agir-bum, andǝ mùrú-nyama mana kat lanzǝ arǝ agir-bum jamnda, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />andǝ amuna-gbè ɓari andǝ mùrú-nyama mana lanzǝ arǝia, tù a ban ɓunì ka, andǝ ban mǝɓoarne mala nkundingŋi mǝnana à nǝ̀ pusǝì atārǝia andǝ amuna-gbè ka, <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />(kǝla mana à pusǝki amǝnia arǝ ndǎ mana à pànà gìr'nkila nǝi kǝla pàgir ace dotarǝu ka.) Sǝ pǝris nǝ̀ pisǝia amur gyangŋan mala pàgir mala pisǝe kǝring a bǝsa. <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />Sǝ nggú jamnda andǝ nyami kat, atārǝia andǝ ɓamúrí, andǝ akusǝi, andǝ alungŋe, andǝ ciute, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />yì acili abare jamnda kat ka, dumǝna púp nǝ̀ kánǝia anzǝm kàttì, a ban mǝɓoarnsari, a gìgí ban so tú, sǝ nǝ̀ pisǝì kǝring aɓa bǝsa mala nggun. Dumǝna púp nǝ̀ pisǝì kǝring amur gìgí ban so tú.<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />Ɓǝ̀ amǝ Isǝrayila na kat a ɓinalea à pàk cauɓikea aɓa ɓwarkio, mala pak komǝyenani na mwashat atà agir mǝnana anzongcau mala Yahweh pǝrban arǝia ama ɓǝà kǝa peǎ ɗàng, sǝ cauɓikê ka sǝmbǝrǝ rǝì a mǝsǝ ɓwabundǝa, sǝ nǝnzǝ́mò ka à yì sǝlǝce ama à pàngŋǝ̀nà cauɓikea; <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />lang cauɓikê mana à pè ka à yi súrǝ́nà rǝì ka, yì aɓwana a ɓinalea ka, à nǝ̀ pà jamnda mwashat a domwan ace pàgir ace lak cauɓikea, sǝ à nǝ̀ yinǝi a ɓadǝm Tara Ban-peri. <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />Sǝ aɓwana-mǝgule amur ɓwabundǝa ka, dumǝna púp à nǝ̀ nongsǝ abuia a ɓamúr jamnda man, a ɓadǝm Yahweh, sǝ à nǝ̀ pwanmyali a ɓadǝm Yahweh. <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />Pǝlǝa Pǝris Mǝgule ka, nǝ̀ ɗàrǝ́ aɓa nkila mala jamnda man, nǝ̀ kùtí nǝi aɓa Tara Ban-peri, <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />sǝ pǝris nǝ̀ oasǝ munabuì aɓa nkile sǝ nǝ̀ watsǝki kusǝ tongno-nong-ɓari, a ɓadǝm Yahweh, a kusǝ lagìr-kasǝbân mala Ban-mǝfele. <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />Sǝ yì pǝris ka, nǝ̀ ɗàrǝ́ bǝti aɓa nkila, nǝ̀ hasǝki arǝ anjawe gyangŋan mǝnana nda aɓa Tara Ban-peri, a ɓadǝm Yahweh ka. Cili nkila mǝnana ue ka, dumǝna púp nǝ̀ solǝi kat a kusǝ gyangŋan mala pàgir mala pisǝe kǝring, mǝnana nda a bankutio aɓa Tara Ban-peri ka. <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />Sǝ nǝ̀ pusǝki mùrú-nyama mala jamnda kat, nǝ pisǝì amur gyangŋan. <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />Amǝno ka à nda ka gir mǝnana nǝ̀ pàngnǝ mǝno yì jamnda ka. Kǝla mǝnana pàngnǝ jamnda mala pàgir ace cauɓikea ka, anggo sǝ nǝ̀ pàngnǝ mǝnia. Sǝ yì pǝris ka nǝ̀ shawuɗia, sǝ à nǝ̀ twaliabanì. <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />Sǝ nǝ̀ twal acili bare jamnda man, nǝ̀ kánǝia anzǝm kàttì, sǝ nǝ̀ pisǝì kǝla mana pisǝ jamnda mǝdǝmbe ka; mǝnia ka pàgir ace cauɓikea mala aɓwana a ɓinalea na.<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />Lang ɓwamǝgule amur tàu mala aɓwana, nda pàk cauɓikea aɓa ɓwarkio, mala pàk komǝyenani atà agir mǝnana anzongcau mala Yahweh, Ɓakuli male, bang ama ɓǝà kǝa pè raka, sǝ yi sǝlǝ ama pàngŋǝ̀nà cauɓikea, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />ko ana raka, à yi lǝmdǝì wi cauɓikea mǝnana yì ka pàk ka, dumǝna púp nǝ̀ yinǝ gbato mǝnana ɓè kǝ̀ gìr mǝɓane pà kàm arǝì raka, ɓǝ̀ duk pàgir male <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />sǝ yì ka, nǝ̀ nongsǝ bui a ɓamur gbato, sǝ nǝ̀ pwan-myali a ban mǝnana à kǝ̀ pwanmyal agir'nkila mala pisǝia kǝring ngga, a ɓadǝm Yahweh; mǝnia ka pàgir ace cauɓikea na. <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />Pǝlǝa pǝris nǝ̀ ɗàrǝ́ aɓa nkila mala pàgir ace lak cauɓikea sǝ nǝ̀ hasǝki nǝ munabui arǝ anjawe gyangŋan mala pàgir ace pisǝe kǝring, sǝ nǝ̀ solǝ cili nkile a kusǝ gyangŋan mala pàgir ace pisǝe kǝring. <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />Sǝ mùrú-nyama male kat ka, dumǝna púp nǝ̀ pisǝì amur gyangŋan, kǝla mana à pàngnǝ mùrú-nyama mala apagir mala gìr'nkila ace dotarǝu ka. Anggo sǝ pǝris nǝ̀ shawuɗi ɓwa mǝno ace cauɓikea male, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />Ɓǝ̀ koyan atà amǝ'tǝ̀r na pàk cauɓikea aɓa ɓwarkio, mala pàk komǝyenani atà agir mǝnana anzongcau mala Yahweh bang ama ɓǝà kǝa pè raka, sǝ yi sǝlǝ ama pàngŋǝ̀nà cauɓikea, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />ko ana raka, à yi lǝmdǝì wi cauɓikea mǝnana yì ka pàk ka, dumǝna púp nǝ̀ yinǝ pàgir male, mbul mǝ'nggaule mǝnana ɓè kǝ̀ gìr mǝɓane pà kàm arǝì raka, ace cauɓikea male mǝnana pàk ka. <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />Sǝ yì ka nǝ̀ nongsǝ bui a ɓamúr pàgir man ace cauɓikea ka, sǝ nǝ̀ pwan-myali a ban mǝnana à kǝ̀ pàgir mala pisǝe kǝring ngga. <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />Sǝ pǝris nǝ̀ ɗàrǝ́ aɓa nkile, nǝ̀ hasǝki nǝ munabui arǝ anjawe gyangŋan mala pàgir mala pisǝe kǝring, sǝ nǝ̀ solǝ cili nkile a kusǝ gyangŋan. <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />Sǝ mùrú-nyama male kat ka, nǝ̀ pusǝki, kǝla mana à pusǝki mùrú-nyama mala apagir ace dotarǝu ka, sǝ pǝris nǝ̀ pisǝì amur gyangŋan ace pa rǝmban mǝɓoarne mana nǝ̀ pwasǝbumam Yahweh ka. Sǝ pǝris nǝ̀ shawuɗì ɓwê, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />Ɓǝ̀ muna-nzur na yì ka nǝ̀ yinǝi kǝla pàgir male ace cauɓikea ka, dumǝna púp nǝ̀ yinǝ mǝ'nggaule mǝnana ɓè kǝ̀ gìr mǝɓane pà kàm arǝì raka; <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />yì ka nǝ̀ nongsǝ bui a ɓamúr mǝnia yì pàgir ace cauɓikea ka, sǝ nǝ̀ pwan-myali ɓǝ̀ duk pàgir ace cauɓikea a ban mǝnana à kǝ̀ pwan-myal girkusǝu mana à pà ace pisǝe kǝring ngga. <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />Pǝlǝa pǝris nǝ̀ ɗàrǝ́ aɓa nkila mala mǝnia yì pàgir ace cauɓikea ka, nǝ̀ hasǝki nǝ munabui arǝ anjawe gyangŋan mala pàgir mala pisǝe kǝring ngga, sǝ nǝ̀ solǝ cili nkile a kusǝ gyangŋan. <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />Sǝ mùrú-nyama male kat ka, nǝ̀ pusǝki, kǝla mana à pusǝki mùrú-nyama arǝ nzur mala gìr'nkila mala apagir ace dotarǝu ka, sǝ pǝris nǝ̀ pisǝì amur gyangŋan, amur apagir mala girlina<note caller="+" style="f"><char style="fr" closed="false">4:35 </char><char style="fq" closed="false">apagir mala girlina </char><char style="ft" closed="false">ko apagir mana à nǝ̀ pisǝia a bǝsa ka.</char></note> abanam Yahweh. Sǝ pǝris nǝ̀ shawuɗì, ace cauɓikea mana pàk ka, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="m">
    <verse number="1" style="v" sid="LEV 5:1" />&lt;&lt;Ɓwa pàngŋǝ̀nà cauɓikea ɓǝ̀ kùtí aɓa komǝyenani atà amǝnia yì acau ka:</para>
  <para style="li" vid="LEV 5:1">Ɓǝ̀ túrban yiu aban ɓwa ama ɓǝ̀ yì nakuni a ndàɓashi amur ɓè gìr mǝnana kumban a ɓadǝmbi, ko sǝni, ko mǝnana súrǝ̀ cau amurí, sǝ yì ka ɓinǝe, pà nǝ̀ bang gìr mǝnana súrǝì ka, raka, bafe mala cauɓikea male nǝ̀ do amurí.<verse eid="LEV 5:1" /></para>
  <para style="li">
    <verse number="2" style="v" sid="LEV 5:2" />Ko ana raka, ɓǝ̀ ɓwa je ɓekǝ gìr mǝnana gìr'ɓeami na, ko lugir nyam-ɓabondo mǝɓeami na, ko lugir nyam-ɓala mǝɓeami na, ko lú gir-yilǝmu mǝɓeami mǝnana kǝ kuɗǝki a nzali ka nda ka, sǝ ko ɓǝ̀ yì ka sǝlǝce raka, nggearǝ yi ka pǝlǝna gìr'ɓeami. Sǝ mǝno ka nunbǝnǝi wi cauɓikea amurí.<verse eid="LEV 5:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="LEV 5:3" />Ko ana raka, ɓǝ̀ ɓwa je ɓekǝ gìr'ɓeami mǝnana kǝ pur arǝ ɓwapǝndǝa, ko ɓǝ̀ ya ulang gìr'ɓeami na mǝnana nǝ̀ tsǝk ɓwa ɓǝ̀ duk gìr'ɓeami, sǝ pà nǝ sǝlǝe male raka, lang ɓǝ̀ yi sǝlǝce ka, nunbǝnǝi wi cauɓikea amurí.<verse eid="LEV 5:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="LEV 5:4" />Ko ana raka, ɓǝ̀ ɓwa kaurǝ a pàcau nǝ kángìr ama nǝ̀ pàk ɓekǝ gìr, ko mǝɓoarne ko mǝɓane, sǝ pàk ɗenyicau amurí ɗàng, ko ɓǝ̀ ya pacau na mǝnana aɓwana kǝ pe a kaurǝa nǝ kángìr, sǝ ko pè aɓa ɗwanyi sǝlǝe, sǝ nǝnzǝ́mò ka yi sǝlǝce ka, nunbǝnǝi ɓamúrì cauɓikea.<verse eid="LEV 5:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="LEV 5:5" />Ɓǝ̀ ɓwa yi sǝlǝce cauɓikea male amur komǝyenani atà acau mǝno, sǝ earnǝ cauɓikea mǝnana pàk ka, <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />dumǝna púp nǝ̀ bwal nzur ko mbul mǝ'nggaule a domwan, sǝ nǝ̀ yinǝi abanam Yahweh, ɓǝ̀ duk mbwegìr ace cauɓikea mǝnana pàk ka. Sǝ pǝris nǝ̀ shawuɗì ace cauɓikea male.<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />&lt;&lt;Sǝama ɓǝ̀ ɓwe ka, kume male bik mǝnana nǝ̀ gandǝ pà nzur ko mbul raka, ɓǝ̀ yinǝ akutugangyi ɓari ko akutumurǝm ɓari abanam Yahweh. Mǝno ka nǝ̀ duk pàgir male mala mbwegìr ace cauɓikea mǝnana pàk ka. Man mwashat ka nda ace pàgir ace cauɓikea, sǝ ɓè man mwashat ka nda ace pàgir mala pisǝe kǝring. <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />Yì ka nǝ̀ yinǝia aban pǝris, sǝ pǝris nǝ̀ pà mǝdǝmbe ɓǝ̀ duk pàgir ace cauɓikea. Nǝ̀ pūrǝ myali sǝama pà nǝ̀ kasǝi kpat ɗang, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />sǝ nǝ̀ watsǝki bǝti aɓa nkila mala mǝnia yì pàgir ace cauɓikea ka arǝ abumban mala gyangŋan, sǝ cili nkile ka nǝ̀ solǝi a kusǝ gyangŋan. Pàgir ace cauɓikea na. <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />Pǝlǝa nǝ̀ pà ɓaria ɓǝ̀ duk pàgir mala pisǝe kǝring, kǝla mana nzongcau kasǝ ka. Sǝ pǝris nǝ̀ shawuɗì, ace cauɓikea mana pàk ka, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />&lt;&lt;Sǝ ɓǝ̀ kume male bik mǝnana nǝ̀ gandǝ pà akutugangyi ɓari ko akutumurǝm ɓari raka,<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LUK 2:24">Luk 2:24</ref></char>.</note> dumǝna púp nǝ̀ yinǝ tasau mwashat<note caller="+" style="f"><char style="fr" closed="false">5:11 </char><char style="fq" closed="false">tasau mwashat </char><char style="ft" closed="false">ko tyang mwashat.</char></note> mala muku mǝɓǝlke, kǝla pàgir male ace cauɓikea mǝnana pàk ka, ɓǝ̀ duk pàgir ace cauɓikea. Pà nǝ̀ so kǝ mùrú olif amurí ɗàng, sǝ pà nǝ̀ tsǝk kǝ myang-kwarra amurí ɗàng, acemǝnana pàgir ace cauɓikea na. <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />Sǝ yì ka nǝ̀ yinǝi aban pǝris, sǝ pǝris nǝ̀ ɗàrǝ́ mukuì ɓǝ̀ lùmsǝ ɓabui, mǝnana do kǝla kāmbe mala kasǝɓalǝu,<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fq" closed="false">kāmbe mala kasǝɓalǝu </char><char style="ft" closed="false">ko &lt;&lt;pàgir mǝno kat à pà ka, eauna aban Ɓakuli ace kasǝɓalǝi arǝ ɓwa mana pà ka.&gt;&gt;</char></note> mana à twal aɓa pàgir mǝno ka, sǝ nǝ̀ soe a bǝsa, ɓǝ̀ pi amur gyangŋan atārǝia andǝ apagir mala girlina<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fq" closed="false">apagir mala girlina </char><char style="ft" closed="false">ko apagir mala pisǝe a bǝsa. </char></note> abanam Yahweh; pàgir ace cauɓikea na. <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />Anggo sǝ pǝris nǝ̀ shawuɗì, ace cauɓikea mǝnana pàk ka, ko ɓǝ̀ mǝyenani atà amǝno yì acau ka, sǝ à nǝ̀ twalîbanì. Sǝ cili muku ka nǝ̀ duk mala pǝris, kǝla mana à pǎ a pàgir mala mǝsǝsa ka.&gt;&gt;<verse eid="LEV 5:13" /></para>
  <para style="s">Anggurcau mala pàgir mala mbwegìr ace kumcau</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />&lt;&lt;Ɓǝ̀ ɓwa yàl-nzong aɓa ɗwanyi-sǝlǝe sǝ pàk cauɓikea mala kyanggî anggurcau mala pagìr abanam Yahweh, atà agir mǝnana à tàrnia ace mǝnana ɓǝà pam ngga, dumǝna púp ɓwe nǝ̀ bwal gam a domwan male, mǝnana ɓekǝ gìr mǝɓane pà kàm arǝì raka, sǝ kúrè ka shekel mala bolo-azǝrfa na, kǝla mana à ear amurí aɓa Tara-mǝfele ka, sǝ nǝ̀ yinǝi abanam Yahweh, ɓǝ̀ duk pàgir mala mbwegìr ace kumcau. <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />Sǝ ɓǝ̀ mana girnì na ɓwe gatti pa aɓalǝ agir mana amala Yahweh na ka, dumǝna púp nǝ̀ nyesǝ gir mǝno ka, sǝ nǝ̀ tsǝk mwashat aɓa gauwe tongno mala gìrnî amurí, sǝ nǝ̀ pè pǝris. Sǝ pǝris nǝ̀ shawuɗì nǝ mǝno yì gam, mala pagìr mala mbwegìr ace kumcau ka, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />&lt;&lt;Ɓǝ̀ koyan sǝ pàk cauɓikea mala yàlî komǝyenani atà anzongcau mala Yahweh, amur agir mǝnana à bang ama ɓǝà kǝa peǎ raka, kat andǝ amani ama ɓwê pè aɓa ɗwanyi-sǝlǝe, sǝ nǝ nzǝ́mò ka yi sǝlǝ ama pàngŋǝ̀nà cauɓikea ka, bafe mala cauɓikea male nǝ̀ do amurí. <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />Dumǝna púp nǝ̀ yinǝì pǝris gam mǝnana ɓekǝ gìr mǝɓane pà kàm arǝì raka, a domwan male, ko nǝ̀ pe wi boalo shekel mala bolo-azǝrfa ace gam, mala pàgir mala mbwegìr ace kumcau, sǝ pǝris nǝ̀ shawuɗì ɓwê, ace ɓwarkio male mǝnana pè aɓa ɗwanyi-sǝlǝe ka, sǝ à nǝ̀ twalîbanì. <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />Pagìr mala mbwegìr ace kumcau na, ace gǝshi cauɓikea mǝnana ɓwê pàkkî Yahweh ka.&gt;&gt;<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="s">Yàl-nzong nǝ swarkiban andǝ kángìr amur nyir</para>
  <para style="r">(<ref loc="NUM 5:5-10">Ɓal 5:5-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />Yahweh nacau nǝ Musa ama: <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />Ɓǝ̀ kǝɓwa atà wun pàk cauɓikea mala yàl nzongcau mala Yahweh, nǝ lǝmdǝ ɗwanyi domǝsǝcau aban ɓi mǝ'murkala amur cau mala gìr mǝnana à tsǝì abani ɓǝ̀ tsǝkiri sǝ lì, ko ak gìr a bù ɓi sǝ ɓinǝ nyesǝi wi, ko mala fwà gìr arǝ ɓi nǝ rǝcandǝa, ko ɓǝ̀ ɓǝmbǝri ɓi mǝ'murkala; <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />ko mala kum ɓekǝ gìr mala ɓi mǝnana ɓwaro sǝ tǝmce; andǝ mala koya ulang cauɓikea na mǝnana ɓwa pè sǝ kángìr aɓa nyir amurí ka; <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />ɓǝ̀ à kum ɓwa nǝ cauɓikea atà agir mǝnia ka, dumǝna púp nǝ̀ nyesǝ gir mana fwè nǝ rǝcandǝa, ko gìr mǝnana kumi aɓa ɓǝmbǝriban, ko gìr mǝnana à tsǝì abani, ko gìr mǝnana ɓwaro sǝ kumi ka. <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />Sǝ gìrnî na nǝmurǝi nǝ̀ nyesǝî mǝtale ka ɗàng, dumǝna púp nǝ̀ tsǝk mwashat aɓa gauwe tongno mala kúrè amurí. Dumǝna púp nǝ̀ mbwe mǝtale anggo ɓǝ̀ yi sǝlǝnace cauɓikea male ka. <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />Sǝ nǝ̀ bwal gam a domwan male, mǝnana ɓekǝ gìr mǝɓane pà kàm arǝì raka, sǝ nǝ̀ yinǝi aban pǝris, ko nǝ̀ pe wi boalo shekel mala bolo-azǝrfa ace gam, ace pàgir abanam Yahweh, mala pagìr mala mbwegìr ace kumcau. <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />Sǝ pǝris nǝ̀ shawuɗì a ɓadǝm Yahweh, sǝ à nǝ̀ twalîban koyagir nani mǝnana kumcau arǝì ka.<verse eid="LEV 6:7" /></para>
  <para style="s1">Akwarkiru aban apǝris amur <optbreak /> pāki agir'nkila andǝ apagir mala koya pwari</para>
  <para style="r">(<ref loc="EXO 29:38-43">Puro 29:38-43</ref>; <ref loc="NUM 28:1-8">Ɓal 28:1-8</ref>)</para>
  <para style="s2">Agir'nkila mana à nǝ̀ pisǝia kǝring ngga</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />Yahweh nacau nǝ Musa, ama, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />&lt;&lt;Banggi Haruna andǝ amuna-burana male ama, &lt;Amǝnia ka à nda ka anggurcau mala pāki agir'nkila mala pisǝe kǝring. Gir'nkila mala pisǝe kǝring ngga nǝ̀ ueo a bǝsa amur gyangŋan aɓa dù kat ba kwaro mala bân, sǝ bǝsa amur gyangŋan ngga dumǝna púp ɓǝ̀ lidǝmba nǝ earke koya pwari. <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />Pǝlǝa pǝris ka nǝ̀ oasǝ shiwan male mala nggubyau linǝn atè, sǝ nǝ̀ túr adaura-pǝris male mana à peǎ nǝ nggubyau linǝn ngga arǝì; sǝ nǝ̀ pwan tú pagìr mala pisǝe kǝring, mǝnana bǝsa lì amur gyangŋan ngga, sǝ nǝ̀ tsǝì a nkanggari gyangŋan. <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />Pǝlǝa nǝ̀ swár adaura-pǝris mana arǝì ka, nǝ̀ nggaɗia nǝ aɓea agir-nggūrǝu, sǝ nǝ̀ twal tú mǝnia ka nǝ̀ nggá soé a ban mǝɓoarnsari anzǝm kàttì. <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />Dumǝna púp bǝsa mǝnana amur gyangŋan ngga à nǝ̀ tsǝì ɓǝ̀ kǝ earke; ɓǝ̀ kǝa limgi ɗang. Koya dǝmbari ka pǝris nǝ̀ tsǝk nggun a bǝsa, nǝ̀ nongsǝ pagìr mala pisǝe kǝring amurí, sǝ nǝ̀ pisǝ mùrú-nyama mala apagir ace dotarǝu amurí. <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />Bǝsa ka nǝ̀ lidǝmba nǝ earke amur gyangŋan bà; à pà nǝ̀ ɗeki ɓǝ̀ limgi ɗang.<verse eid="LEV 6:13" /></para>
  <para style="s2">Apagir mala mǝsǝsa</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />&lt;&lt; &lt;Amǝnia ka à nda ka anggurcau mala apagir mala mǝsǝsa. Amuna-burana mala Haruna nǝ̀ pàgir mala mǝsǝsa mǝnia abanam Yahweh a ɓadǝm gyangŋan. <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />Ɓeɓwa ateà nǝ̀ ɗàrǝ́ muku mǝɓǝlke mala pàgir mala mǝsǝsa mǝnana à zurǝì andǝ mùrú olif ka ɓǝ̀ lùmsǝ ɓabui, sǝ atārǝia andǝ myang-kwarra mana amurí ka kat, nǝ̀ pisǝì amur gyangŋan. Mukuì mǝno a ɓabu ka nda kāmbe mala kasǝɓalǝu<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="fq" closed="false">kāmbe mala kasǝɓalǝu </char><char style="ft" closed="false">ko &lt;&lt;pàgir mǝno kat à pà ka, eauna aban Ɓakuli ace kasǝɓalǝi arǝ ɓwa mana pà ka.&gt;&gt;</char></note> aɓa pàgir mǝno kat à pà abanam Yahweh ka; sǝ rǝmbi mǝɓoarne mana lo aɓa pǐ male a bǝsa ka nǝ̀ pwasǝbumam. <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />Sǝ cili mana ue ka Haruna andǝ amuna-burana male nǝ̀ lì. À nǝ̀ lì sǝ pà nǝ yis arǝì ɗàng a ban mǝfele, aɓa patal mala Tara Ban-peri. <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />À pà nǝ̀ lurǝi nǝ yis arǝì ɗàng. Ən pania wia ɓǝ̀ duk kāmbe malea aɓa pàgir mala girlina<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="fq" closed="false">pàgir mala girlina </char><char style="ft" closed="false">ko pàgir mala pisǝe a bǝsa. </char></note> mem. Pàgir nggea mǝfele na, kǝla pàgir ace cauɓikea<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ arǝ abân kat aɓa kùré mǝnia.</char></note> andǝ pàgir mala mbwegìr ace kumcau. <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />Arǝ anza mǝnana kat à kǝ yiu ka, koya muna-ɓwabura a tàu mala Haruna ka nǝ̀ li aɓa mǝnia yì pàgir mana à pà abanam Yahweh, nǝ pisǝe a bǝsa ka. Mǝnia ka kāmbe malea na tàtǝ́k.&gt; &gt;&gt;<verse eid="LEV 6:18" /></para>
  <para style="s2">Pàgir nǝ mǝsǝsa mana apǝris nǝ̀ pà ka</para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />Yahweh nacau nǝ Musa, ama, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />&lt;&lt;Mǝnia ka nda pàgir mana Haruna andǝ amuna-burana male nǝ̀ pà abanam Yahweh, a pwari mana à nǝ̀ ɗārǝì wi mùrú olif amurí ace tàré ɓǝ̀ duk pǝris ka: tasau mwashat<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="fq" closed="false">tasau mwashat </char><char style="ft" closed="false">ko tyang mwashat.</char></note> mala muku mǝɓǝlke, kǝla mana à kǝ panagir nǝi koya pwari ka, gauwa-tsùrú male nǝ dǝmbari sǝ gauwa-tsùrú male nǝ pwarikpǝra. <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />À nǝ̀ zurǝì andǝ mùrú olif pepè sǝ à nǝ̀ lurǝi aɓa nkenye kàng gìr. Awu nǝ ɓwangi bǝti-bǝti sǝ a nǝ yinǝi, awu nǝ panagir mala mǝsǝsa nǝi a bǝsa, ace pà rǝmban mǝɓoarne abanam Yahweh mana kǝ pwasǝbumam ngga. <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />Anggo sǝ koyan atà amuna ko amǝkau aburana a tàu mala Haruna, mana à tàrì ɓǝ̀ ak bancame male kǝla pǝris mǝgule ka, nǝ̀ pà mǝnia yì pàgir ka. Nzongcau na mǝnana à nǝ̀ kpate ka bà. Dumǝna púp à nǝ̀ pisǝi kǝring. <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />Koya pàgir mala mǝsǝsa na mana pǝris pà ka, à nǝ̀ pisǝì kat; à pà nǝ̀ lì ɗàng.&gt;&gt;<verse eid="LEV 6:23" /></para>
  <para style="s2">Pagìr ace cauɓikea</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />Yahweh nacau nǝ Musa, ama, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />&lt;&lt;Banggi Haruna andǝ amuna-burana male ama, &lt;Mǝnia ka nda nggurcau mala pàgir ace cauɓikea. A ban mǝnana à kǝ pwan-myal girkusǝu mala pàgir ace pisǝe kǝring ngga, kàm sǝ à nǝ̀ pwan-myal girkusǝu mala pàgir ace cauɓikea, a ɓadǝm Yahweh. Pàgir mǝnia ka nggea mǝfele na. <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />Pǝris mǝnana pàkki agir mala pagìr ace cauɓikea ka nda nǝ̀ lì ka, a ban mǝfele, aɓa patal mala Tara Ban-peri. <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />Ɓǝ̀yaɓwa na sǝ koyagir na mǝnana je nyam pagìr mǝnia ka, nǝ̀ duk mǝfele, sǝ ɓǝ̀ nkile tàu arǝ daura ka, dumǝna púp awu nǝ̀ lak mǝno yì daura ka a ban mǝfele. <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />Koya nkwaring dǝɓang na à lam nyama mǝnia aɓalǝi ka, dumǝna púp à nǝ̀ arki, sǝ ɓǝ̀ nkwaring bolo na ka, dumǝna púp à nǝ̀ gosǝki ɓālǝi sǝ à nǝ̀ sheli nǝ mùr. <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />Koya ɓwabura a tàu mala apǝris ka nǝ̀ gandǝ li. Pàgir mǝnia ka nggea mǝfele na. <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />Sǝama nyam girkusǝu mǝnana à pà ace cauɓikea, sǝ nkile ka à yinǝi aɓa Tara Ban-peri, ace shawuɗì, aɓa Ban Mǝfele ka, à pà nǝ̀ lì ɗàng; dumǝna púp à nǝ̀ pisǝi kǝring a bǝsa.<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s2">Agir'nkila mala mbwegìr ace kumcau</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />&lt;&lt; &lt;Mǝnia ka nda nggurcau mala pagìr mala mbwegìr ace kumcau. Pàgir mǝnia ka nggea mǝfele na. <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />Girkusǝu mala pagìr mala mbwegìr ace kumcau ka, à nǝ̀ pwan-myali a ban mǝnana à kǝ pwan-myal agirkusǝu mala pagìr mala pisǝe kǝring ngga, sǝ nkile ka à nǝ̀ watsǝki arǝ abumban mala gyangŋan. <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />Mùrú-nyama male kat ka, à nǝ̀ pusǝki sǝ à nǝ̀ pàgir nǝi amur gyangŋan, yì mùrú-nyama mala nggilate andǝ mùrú-nyama mana nong amur agir-bumi, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />andǝ amuna-gbè ɓari andǝ mùrú-nyama mana lanzǝ arǝia tù a ban ɓunì ka, andǝ ban mǝɓoarne mala nkundingŋi mǝnana à nǝ̀ pusǝì atārǝia andǝ amuna-gbè ka. <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />Pǝris nǝ̀ pisǝia amur gyangŋan ɓǝ̀ duk pàgir nǝ bǝsa na abanam Yahweh; pagìr mala mbwegìr ace kumcau na. <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />Koya muna-ɓwabura a tàu mala Haruna ka nǝ̀ lì aɓa mǝnia yì pàgir à pà ka. À nǝ̀ lì a ban mǝfele. Pàgir nggea mǝfele na. <verse eid="LEV 7:6" /><verse number="7" style="v" sid="LEV 7:7" />Nggurcau mala pàgir mala mbwegìr ace kumcau ka nda mwashat andǝ nggurcau mala pàgir ace cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">7:7 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 37.</char></note> Nyame ka nǝ̀ duk mala pǝris mana shawuɗiban ngga.<verse eid="LEV 7:7" /></para>
  <para style="s2">Kāmbe ace apǝris aɓalǝ apa agir'nkila<optbreak />andǝ apagir mala mǝsǝsa</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 7:8" />&lt;&lt; &lt;Nggū girkusǝu mana koya ɓwa pa ace pagìr mala pisǝe kǝring ngga, nǝ̀ duk mala pǝris mana shawuɗiban nǝ gìr'nkilè ka. <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />Sǝ koya pàgir mala mǝsǝsa mǝnana à lurǝi a ovù, ko à kàngŋì aɓa nkenye kàng gìr ka, mala pǝris na mǝnana wari nǝi aban Ɓakuli ka. <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />Sǝ koya pàgir mala mǝsǝsa, mana à zurǝì andǝ mùrú olif, ko mana nda andǝa ime ka, à nǝ̀ gapì amuna-burana mala Haruna, koyan ngga ɓǝ̀ kumo kǝla mala ɓì.<verse eid="LEV 7:10" /></para>
  <para style="s2">Apagir mala dotarǝu</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />&lt;&lt; &lt;Mǝnia ka nda nggurcau mala pà gìr'nkila ace apagir mala dotarǝu, mana ɓwa nǝ̀ yinǝia abanam Yahweh ka. <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />Ɓǝ̀ ɓwa yinǝ pàgir mǝnia ace pàk-yàwá ka, dumǝna púp ama, atārǝia andǝ gìr'nkila mala pàk-yàwá ka, nǝ̀ pa agbatali bǝredi mana peǎ nǝ muku mana à zurǝì andǝ mùrú olif, sǝ yis pà arǝì raka, andǝ abiskit mana à peǎ nǝ yis raka, sǝ à hasǝkia wia mùrú olif arǝia ka, andǝ agbatali bǝredi mana à peǎ nǝ muku mǝɓǝlke mana à zurǝì pepè andǝ mùrú olif ka. <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />Atārǝia andǝ gìr'nkila mala apagir ace dotarǝu mana ɓwa nǝ̀ pa ace pàk-yàwá ka, dumǝna púp nǝ̀ yinǝi andǝ agbatali bǝredi mana yis pà arǝì raka. <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />Yì ka nǝ̀ twal kāmbe mwashat aɓa koya ulang bǝredi ace pàgir abanam Yahweh; à nǝ̀ pè pǝris mana twal nkila mala girkusǝu mana à pà ace dotarǝu, sǝ watsǝki arǝ gyangŋan ngga, ɓǝ̀ duk male. <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />Sǝ nyam gìr'nkila mala apagir mala ɓwa ace dotarǝu, mana pà ace pàk-yàwá ka, dumǝna púp à nǝ̀ lì a pwari mala pàgir male. À pà nǝ̀ ɗeki ɓekǝ bare ɓǝ̀ bik dǝmbari ɗàng.<verse eid="LEV 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16" />&lt;&lt; &lt;Sǝama ɓǝ̀ pàgir mala ɓwa ka gìr'nkila na pa ace lùmsǝ pacau male mana pè nǝ shambum, ko pàgir mala eare mala ɓabumi na ka, à nǝ̀ lì gìr'nkilè a kǝ pwari mǝno, sǝ ɓǝ̀ cili ueo bà ɓè pwari mana kpata mǝno ka, à nǝ̀ lì. <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />Sǝama gìr mǝnana ueo aɓa nyam gìr'nkila mǝnia sǝ yi bik tàruia pwari ka, à nǝ̀ pisǝì kǝring a bǝsa. <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />Ɓǝ̀ à lì cili nyam gìr'nkila mala pàgir male ace dotarǝu a tàruia pwari ka, Ɓakuli pa nǝ̀ ak pàgir mala ɓwe ɗàng, sǝ ɓwe pà nǝ̀ kum kǝ tsǝkbu aɓalǝi ɗàng. À nǝ̀ nyesǝì gìr'ɓeami na, sǝ ɓwa mǝnana lì ka, bafe mala cauɓikea male nǝ̀ do amurí.<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />&lt;&lt; &lt;Ɓǝ̀ nyame je ɓekǝ gìr'ɓeami ka à pà nǝ̀ lì ɗàng. À nǝ̀ pisǝì a bǝsa kǝring.</para>
  <para style="p" vid="LEV 7:19">&lt;&lt; &lt;Koya ɓwa mǝnana pǝndǝki rǝì raka, nǝ̀ gandǝ li nyame [mala pàgir ace dotarǝu], <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />sǝama ɓwa mǝnana lì nyam gìr'nkila mala apagir ace dotarǝu, mana à pà abanam Yahweh, sǝ nda aɓa do-ɓeami ka, mǝno yì ɓwa ka à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng.<note caller="+" style="f"><char style="fr" closed="false">7:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 17:14">Tite 17:14</ref>; <ref loc="LEV 7:27">Pǝris 7:27</ref>; <ref loc="LEV 19:8">19:8</ref>; <ref loc="NUM 9:13">Ɓal 9:13</ref></char>.</note> <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />Ɓǝ̀ ɓwa je gìr mǝnana gìr'ɓeami na (kǝla gìr'ɓeami mana kǝ pur arǝ ɓwapǝndǝa, ko girkusǝu mǝɓeami, ko ɓè gir-yilǝmu mǝɓeami mana à ɓinǝce), sǝ lì aɓa nyam gìr'nkila mala apagir ace dotarǝu mana mala Yahweh na ka, à pà nǝ̀ ɓal ɓwe aɓalǝ aɓwana male ɗàng.<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">à pà nǝ̀ ɓal ɓwe aɓalǝ aɓwana male ɗàng </char><char style="ft" closed="false">ko &lt;&lt;à nǝ̀ wal-luí,&gt;&gt; ko &lt;&lt;à nǝ̀ pǝri arǝ kútí aɓa tara mǝfele ace peri,&gt;&gt; ko &lt;&lt;pà nǝ̀ kum aɓa gìr mǝɓoarne mana nda ace aɓwana male ka ɗàng,&gt;&gt; ko &lt;&lt;Ɓakuli nǝ̀ twalta ɓǝ̀lá-nggúr-kwár male.&gt;&gt;</char></note>&gt; &gt;&gt;<verse eid="LEV 7:21" /></para>
  <para style="s2">Mùrú-nyama andǝ nkila mǝnana à pǝrban arǝì ka</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />Yahweh nacau nǝ Musa, ama, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />&lt;&lt;Banggi amǝ Isǝrayila ama, &lt;Pà wu nǝ̀ lì kǝ mùrú-nyama mala ndǎ ko nzur ko mbulpǝndǝa ɗang. <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />Mùrú-nyama mala girkusǝu mǝnana à kumi wuna, ko anyamɓikea sàngi ka, à nǝ̀ gandǝ paktúró nǝi ace ɓè gìr, sǝama pà wun nǝ̀ lì ɗàng. <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />Ɓǝ̀ ya ɓwa atà wun sǝ lì mùrú-nyama mala girkusǝu mǝnana à nǝ̀ pàgir nǝ bǝsa nǝi abanam Yahweh ka, ɓwê mǝno lì ka à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />Ɗǝm ngga pà wu nǝ̀ lì nkila ɗàng, ko ɓǝ̀ mǝye nani ka, ko mala nyal ko girkusǝu, arǝ abân mǝnana kat wu duk kam ngga. <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />Ɓwa mǝnana kat lì nkila ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng.&gt; &gt;&gt;<verse eid="LEV 7:27" /></para>
  <para style="s2">Kāmbe ace apǝris aɓa pàgir ace dotarǝu</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />Yahweh nacau nǝ Musa, ama, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />&lt;&lt;Banggi amǝ Isǝrayila ama, &lt;Ɓwa mǝnana kat nǝ̀ pà gìr'nkila mala apagir male ace dotarǝu abanam Yahweh ka, dumǝna púp nǝ̀ twal kāmbe pagìr male aɓa gìr'nkila mala apagir male ace dotarǝu nǝ̀ yinǝi abanam Yahweh. <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />Yi ka nǝ̀ yinǝ apagir mala girlina mana mala Yahweh na ka, nǝ bui. Nǝ̀ yinǝ mùrú-nyama mala girkusǝunì andǝ kikili, sǝ nǝ̀ loasǝ kikili a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />Pǝris nǝ̀ pisǝ mùrú-nyama mǝnia amur gyangŋan, sǝ kikili ka nǝ̀ duk mala Haruna andǝ amuna-burana male. <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />Sǝ byalu mǝlì mala girkusǝu mǝnia ka, à nǝ̀ pè pǝris kǝla kāmbe male aɓa gìr'nkila mala apagir ma'wun ace dotarǝu. <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />Ɓǝ̀ yana atà amuna-burana mala Haruna nda pà nkila mala apagir ace dotarǝu andǝ mùrú-nyama male ka, nda à nǝ̀ pè wi byalu mǝlì ɓǝ̀ duk kāmbe male ka. <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />Kikil girkusǝu mǝnia à loasǝi a kùli, sǝ byalu mǝlì mǝnana à pà kāmbe nǝi abanam, Mim Yahweh ka, ǝn twalǝni a bu amǝ Isǝrayila, aɓalǝ agir'nkila mala apagir malea ace dotarǝu, sǝ ǝn pani pǝris Haruna andǝ amuni andǝ amǝkè amuna-burana. Mǝnia ka dumǝna púp nda gìr mǝnana amǝ Isǝrayila nǝ̀ nggǝ pê apǝris arǝ anza mǝnana kat à kǝ yiu ka.&gt; &gt;&gt;<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />Mǝnia ka nda kāmbe mala Haruna andǝ mala amuna-burana male aɓa pàgir mala girlina abanam Yahweh, twal a pwari mǝnana à tària ace túró kǝla apǝris mala Yahweh ka. <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />Yahweh pà nzongcau mǝnia ka a pwari mǝno à tària ka ama ɓǝ̀ amǝ Isǝrayila ɓǝà kǝ pea wia mǝnia yì kāmbe mala pàgir ka. Nggurcau na, mǝnana dumǝna púp amǝ Isǝrayila nǝ̀ kpatè arǝ anza mǝnana kat à kǝ̀ yiu ka.<verse eid="LEV 7:36" /></para>
  <para style="s">Kàsǝetù mala akwarkiru amur pāki agir'nkila <optbreak /> aɓa Apǝris 6:8--7:36</para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />Amǝno ka à nda ka nggurcau mala pàgir ace pisǝe kǝring, pàgir mala mǝsǝsa, pàgir ace cauɓikea, pàgir mala mbwegìr ace kumcau, pàgir mala tàrban ace túró pǝris, andǝ pàgir mala dotarǝu. <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />Akano amur Nkono Saina, a pǝɗanban, Yahweh pè Musa anzongcau mǝnia a pwari mana banggi amǝ Isǝrayila ɓǝà yinǝ apagir malea aban Yahweh ka.<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s">À tàr Haruna andǝ amuna-burana male ace túró pǝris</para>
  <para style="r">(<ref loc="EXO 29:1-3">Puro 29:1-3</ref>; <ref loc="EXO 40:12-15">40:12-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />&lt;&lt;Yinǝ Haruna andǝ amuna-burana male atè, andǝ adaura-pǝris, andǝ mùrú ɗārǝ́bân, andǝ jamnda mala pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 14.</char></note> andǝ agam ɓari, sǝ zace mana nǝ bǝredi mǝnana yis pà arǝì raka, <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />sǝ wu ram ɓwabundǝa kat a kún Tara Ban-peri.&gt;&gt; <verse eid="LEV 8:3" /><verse number="4" style="v" sid="LEV 8:4" />Musa kpata gìr mǝnana Yahweh tsǝki wi ka; ɓwabundǝa yiu ramba a kún Tara Ban-peri.<verse eid="LEV 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 8:5" />Musa ne ɓwabundǝa ama, &lt;&lt;Mǝnia ka ndà gìr mǝnana Yahweh tsǝa ama ɓǝà pè ka.&gt;&gt; <verse eid="LEV 8:5" /><verse number="6" style="v" sid="LEV 8:6" />Pǝlǝa Musa yinǝ Haruna andǝ amuna-burana male a dǝmba, sǝ lakkia wia rǝia nǝ mur. <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />Yi oasǝi Haruna daura-ɓaɓalǝu mǝlime, kùri wi nggur-ɓunu a taɓuni, túrì wi daura-tsuru mǝsauwe sǝ oasǝi wi efot arǝì. Ɗǝm ngga mārǝi wi bugìr mārǝ́ taɓunu mǝ'nbaké mala efot sǝ kùrì. <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />Gyarì wi lǝpan-damɓalǝu a myali, sǝ aɓa lǝpan-damɓalǝu ka tsǝki wi Urim andǝ Tummim.<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">Urim andǝ Tummim </char><char style="ft" closed="false">ngga agir na mǝnana pǝris kǝ paktúró nǝia ace súrǝ̀ gir mǝnana Yahweh kǝ earce aɓwana male ɓǝà pà ka.</char></note> <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />Pǝlǝa mārǝi wi nggubyau mbuɓi múrû amurí, sǝ tsǝki wi baji bolo-njengǝlan, yì jeko mǝfele, amur nggubyau mbuɓi múrû, nǝ kúndǝmbi, kǝla mana Yahweh banggi Musa ka.<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />Pǝlǝa Musa twal mùrú ɗārǝ́bân sǝ ɗārǝ́ Taragula andǝ agir mana aɓalǝi ka kat, sǝ tària ace Yahweh. <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />Sǝ ɗàrǝ́ aɓa mùrúnì, watsǝki amur gyangŋan kusǝ tongno-nong-ɓari, sǝ ɗārǝ́ gyangŋan andǝ agirtúró male kat, andǝ nkenye andǝ girtàmsǝe; tària ace Yahweh. <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />Pǝlǝa Musa ɗàrǝ́ aɓa mùrú ɗārǝ́bânì, solǝì Haruna amurí, ɗārǝi, ace tàre ɓǝ̀ duk mala Yahweh. <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />Sǝ Musa pusǝ amuna-burana mala Haruna a dǝmba, sǝ oasǝkia wia adaura-pǝris arǝia, sǝ kurkia wia anggur-ɓunu a taɓunia, sǝ mārǝkia wia anggubyau mbuɓi múrû amúrià, kǝla mana Yahweh ne Musa ka.<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />Osso yinǝ jamnda mala pàgir ace cauɓikea, sǝ Haruna andǝ amuna-burana male tsǝk abuia a ɓamur jamnda mala pàgir ace cauɓikea. <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />Osso Musa pwan-myal jamndê, ak nkile, sǝ hasǝki nǝ munabuì arǝ anjawe gyangŋan kat ace mǝnana ɓǝ̀ tsǝì ɓǝ̀ dumnǝ ɓoarnsari ka. Cili nkile ka solǝi a kusǝ gyangŋan. Anggo sǝ tàrì ace Ɓakuli ace mǝnana ɓǝ̀ shawuɗì ka. <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />Musa pǝlǝa twal mùrú-nyama mana kat lanzǝ arǝ agir-bum jamnda ka, andǝ ban mǝɓoarne mala nkundingŋi, andǝ amuna-gbè ɓari andǝ mùruia, sǝ pisǝia amur gyangŋan. <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />Sǝ cili jamnda, andǝ ngguí, andǝ nyami, andǝ ciute ka, à pisǝia a nzǝm kàttì, kǝla mana Yahweh banggi Musa ka.<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />Pǝlǝa Musa warinǝ gam mala pàgir ace pisǝe kǝring, sǝ Haruna andǝ amuna-burana male nongsǝ abuia a ɓamur gamnì. <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />Osso Musa pwan-myal gamnì, sǝ tàkki nkile arǝ abumban mala gyangŋan. <verse eid="LEV 8:19" /><verse number="20-21" style="v" sid="LEV 8:20-21" />Osso sàngi gamnì, sǝ lak agir-bumi andǝ akusǝi. Pǝlǝa nongsǝ ɓamúrí, andǝ mùruí, andǝ acili bare gam kǝring amur gyangŋan. Pàgir mala pisǝe kǝring na mala pà rǝmban mǝɓoarne ace pwasǝbum Yahweh; pàgir nǝ bǝsa na ace Yahweh, kǝla mana Yahweh banggi Musa ka.<verse eid="LEV 8:20-21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />Nyar ɗǝm Musa yinǝ ɓaria gam, yì gam mala kùrî ɓwa túró pǝris, sǝ Haruna andǝ amuna-burana male nongsǝ abuia a ɓamur gamnì. <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />Osso Musa pwan-myal gamnì sǝ ɗàrǝ́ nkile, hasǝì Haruna a mburkiri mǝlì, andǝ munabui mǝbure mǝlì, andǝ muna-kusǝi mǝbure mǝlì.<verse eid="LEV 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 8:24" />Ɗǝm ngga, Musa yinǝ amuna-burana mala Haruna a dǝmba, sǝ hasǝkia wia nkila gbal a mburkiria mǝlì, andǝ amuna-buia mǝbure mǝlì andǝ amuna-kusǝia mǝbure mǝlì. Pǝlǝa tàkki cili nkile arǝ abumban mala gyangŋan.<verse eid="LEV 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 8:25" />Anzǝm mǝno ka, yi twal mùrú-nyama mala gamnì, andǝ mùrú nggilate, andǝ mùrú mana nong amur agir-bumi ka, andǝ ban mǝɓoarne mala nkundingŋi, andǝ amuna-gbè ɓari andǝ mùrú mana lanzǝ arǝia ka, andǝ byali mǝlì. <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />Sǝ aɓa zace mala bǝredi mǝnana yis pà arǝì raka, mana a ɓadǝm Yahweh ka, kya twal gbatali bǝredi mwashat, andǝ gbatali kyak mwashat mana nǝ mùrú olif arǝì ka, andǝ biskit mwashat, sǝ tsǝia amur abare mùruí andǝ byalu mǝlì. <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />Sǝ tsǝk amǝnia yi agir kat ka a ɓabu Haruna andǝ ɓabu amuna-burana male, sǝ à loasǝia a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />Sǝ Musa ea a buia, sǝ pisǝia amur gyangŋan atārǝia andǝ pàgir mala pisǝe kǝring. Mǝnia ndà pàgir mala tàrban ace túró pǝris; pagir nǝ bǝsa na, mala pà rǝmban mǝɓoarne, mana kǝ pwasǝbum, mǝnana à pà aban Yahweh ka. <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />Musa twal damɓalǝi, mǝnana nda kāmbe male aɓa gam mala tàrban ace túró pǝris ka, sǝ loasǝi a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh, kǝla mana Yahweh ne Musa ka.<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />Pǝlǝa Musa ɗàrǝ́ aɓa mùrú ɗārǝ́bân sǝ aɓa nkila mana amur gyangŋan ngga sǝ watsǝki amur Haruna andǝ mur adaura-pǝris male, sǝ amur amuna-burana male andǝ adaura-pǝris malea gbal. Anggo sǝ tàr Haruna ace túró pǝris, yì andǝ adaura-pǝris male, andǝ amuna-burana male, andǝ adaura-pǝris malea.<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />Musa pǝlǝa ne Haruna andǝ amuna-burana male ama, &lt;&lt;Wu lam nyame a bankutio aɓa Tara Ban-peri, sǝ akǝ banì wu she atārǝia andǝ bǝredi mana aɓa zace mala pàgir mala tàrban ace túró pǝris ka, kǝla mana ǝn bang ama, &lt;Haruna andǝ amuna-burana male na à nǝ̀ she ka.&gt; <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />Gìr mana kat ueo mala nyama andǝ bǝredi ka wun nǝ̀ pisǝì a bǝsa. <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />Pà wunǝ purî bankutio aɓa Tara Ban-peri ɗang bà nongŋo tongno-nong-ɓari, she ɓǝ̀ anongŋo mala tàrban ma'wun lumsǝna ka, acemana tàrban ma'wun nǝ̀ twal anongŋo tongno-nong-ɓari. <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />Gìr mǝnana à pè a pwari mǝnia yalung ngga, Yahweh nǝ̀ tsǝa ama ɓǝà pè ace shawuɗi wun. <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />Dumǝna púp wun nǝ̀ ueo a bankutio aɓa Tara Ban-peri du andǝ pwari, bà anongŋo tongno-nong-ɓari, sǝ wun nǝ̀ camarǝ pakki atúró mana Yahweh na ama ɓǝ̀ wu pea ka, ace mǝnana ɓǝ̀ wu kǝa wù raka; mǝno ka nda gìr mǝnana Yahweh banggam ama ɓǝ̀n bangga wun ngga.&gt;&gt; <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />Acemani ka, Haruna andǝ amuna-burana male pàk agir mana kat Yahweh ne nǝban Musa ka.<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s">Yahweh ak pàgir mǝdǝmbe mala Haruna</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />A tongno-nong-tàruià pwari ka, Musa tunǝ Haruna andǝ amuna-burana male andǝ aɓwana-mǝgule mala amǝ Isǝrayila, <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />sǝ ne Haruna ama, &lt;&lt;Twalî ɓamúrò lo-jamnda ace pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">9:2 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ arǝ aban kat aɓa kùré mǝnia.</char></note> andǝ gam ace pàgir mala pisǝe kǝring; yia kǝm ngga ɓǝà kǝa kum ɓekǝ gìr mǝɓane arǝia ɗàng, sǝ wu yinǝia a ɓadǝm Yahweh. <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />Sǝ wu ne amǝ Isǝrayila ama, &lt;Wu twal gbato ace pàgir ace cauɓikea, andǝ lo-jamnda andǝ mǝgam, mǝnana yia kǝm ngga mbulea mwashat, sǝ yia kǝm ngga kǝgìr mǝɓane pà kàm arǝia raka, ace pàgir mala pisǝe kǝring; <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />ɗǝm ngga wu twal ndǎ andǝ gam ace apagir mala dotarǝu, mana wun nǝ̀ pà gìr'nkila nǝia a ɓadǝm Yahweh ka, atārǝia andǝ pàgir mala mǝsǝsa mana à zurǝì nǝ mùrú olif ka, acemana yalung ngga Yahweh nǝ̀ lǝmdǝ rǝì aban wun.&gt; &gt;&gt; <verse eid="LEV 9:4" /><verse number="5" style="v" sid="LEV 9:5" />Pǝlǝa à yinǝ agir mǝnana Musa nea wia ama ɓǝà yinǝia ka, a ɓadǝm Tara Ban-peri, sǝ ɓwabundǝa kat sung tù à yi came a ɓadǝm Yahweh. <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />Musa osso bang ama, &lt;&lt;Mǝnia ka ndà gìr mǝnana Yahweh na wun ama ɓǝ̀ wu pàk ka, ace mana ɓǝ̀ ɓoarɓwa mala Yahweh ɓǝ̀ lǝmdǝ rǝì aban wun ngga.&gt;&gt; <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />Pǝlǝa Musa ne Haruna ama, &lt;&lt;Sung tù aban gyangŋan sǝ wu pàgir mò ace cauɓikea, andǝ pàgir mô mala pisǝe kǝring, ace shawuɗi ɓamuro sǝ ace shawuɗi aɓwana;<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="HEB 5:1-3">Ib 5:1-3</ref>; <ref loc="HEB 7:26-27">7:26-27</ref> </char></note> sǝ wu yinǝ pàgir mala aɓwana, wu shawuɗia, kǝla mǝnana Yahweh bang ngga.&gt;&gt;<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />Ndà sǝ Haruna sung tù aban gyangŋan, yi pwan-myal lo-jamnda mala pàgir ace cauɓikea, mǝnana nda ace ɓamúrì ka. <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />Osso amuna-burana male, yì Haruna ka à pe wi nkile, sǝ oasǝ munabuì aɓalǝi sǝ hasǝki arǝ anjawe gyangŋan; cili nkile ka solǝi a kusǝ gyangŋan. <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />Sǝ mùruí, andǝ amuna-gbè, andǝ ban mǝɓoarne mala nkundingŋi mana à pusǝia arǝ lo-jamnda mala pàgir ace cauɓikea ka, pisǝia amur gyangŋan, kǝla mana Yahweh banggi Musa ka. <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />Nyame andǝ ngguí ka pisǝia anzǝm kàttì.<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />Pǝlǝa Haruna pwan-myal gam mala pàgir ace pisǝe kǝring, sǝ amuna-burana male yinǝi wi nkile, sǝ tàkki arǝ abumban mala gyangŋan. <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />Sǝ à pè wi ɓamúr gam mala pagìr mala pisǝe kǝring, andǝ abare mwashat-mwashat, sǝ pisǝia amur gyangŋan. <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />Sǝ lak agir-bumi andǝ akusǝi sǝ pisǝia amur gyangŋan atārǝia andǝ acili bare gam mala pisǝe kǝring.<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />Pǝlǝa yinǝ agirkusǝu mana aɓwana pà ace pàgir ka, sǝ twal gbato mǝnana nda ace pàgir ace cauɓikea mala aɓwana ka, sǝ pwan-myali, sǝ pàgir ace cauɓikea nǝi, kǝla mana pangnǝ mǝdǝmbe ka. <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />Sǝ yinǝ lo-jamnda andǝ mǝgam mana à nda ace pàgir mala pisǝe kǝring ngga, yi panagir nǝia kǝla mana nggurcau kasǝ ka. <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />Ɗǝm ngga yinǝ pàgir mala mǝsǝsa, ɗàrǝa lùmsǝ ɓabui, sǝ pisǝi amur gyangŋan tsǝa amur pàgir mana à pisǝì kǝring nǝ dǝmbari ka.<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />Pǝlǝa pwan-myal ndǎ andǝ gam, yì agir'nkila ace apagir mala dotarǝu mǝnana à nda ace aɓwana ka. Sǝ amuna-burana male yì Haruna pe wi nkila sǝ tàkki arǝ abumban mala gyangŋan. <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />Sǝama mùrú-nyama mana arǝ abare ndǎ andǝ gam, yì mùrú mana arǝ a anggilatea, andǝ mana lanzǝ arǝ agir-bumia ka, à pusǝkia atārǝia andǝ amuna-gbea, andǝ abân mǝɓoarne mala ankundingyia; <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />à nongsǝki abare mùrú-nyama mǝnia ka amur akikil agirkusǝu mǝno, sǝ Haruna pisǝ abare mùrú-nyama man amur gyangŋan; <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />sǝ akikilu andǝ byalu mǝlì ka Haruna loasǝia a kùli, ɓǝ̀ duk pàgir na, mǝnana à loasǝi a kùli a ɓadǝm Yahweh, kǝla mana Musa tsǝk ka.<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />Lang Haruna malna pākia pàgir ace cauɓikea, andǝ pàgir ace pisǝe kǝring, andǝ apagir ace dotarǝu ka, pǝlǝa loasǝ abui sǝ sārǝia amur aɓwana sǝ tsǝkia wia bù, pǝlǝa sùlǝî múr gyangŋan. <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />Pǝlǝa Musa andǝ Haruna kùtí aɓa Tara Ban-peri. Lang à pur a nza ka, à tsǝki aɓwana bù, sǝ ɓoarɓwa mala Yahweh pusǝrǝi aban aɓwana kat à sǝni. <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />Pǝlǝa bǝsa pur nǝban Yahweh, yi li pàgir mala pisǝe kǝring mǝno ka andǝ abare mùrú mana amur gyangŋan ngga.<note caller="+" style="f"><char style="fr" closed="false">9:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 18:38-39">1Amur 18:38-39</ref>; <ref loc="2CH 7:1">2Acau 7:1</ref></char>.</note> Lang aɓwana kat sǝni ka, à mak'zwalo, sǝ à sárǝ́ nǝ ɓamǝsǝia a nzali.<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s">Lú mala Nadap andǝ Abihu</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />A ɓè fara ka, amuna-burana mala Haruna, yià Nadap andǝ Abihu, koyan ateà ka twal tasau-bǝsa<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fq" closed="false">tasau-bǝsa: </char><char style="ft" closed="false">tasau mana à kǝ pisǝ muku-gìr aɓalǝi ace loasǝ yele mǝ'rǝmɓoarne ka.</char></note> male, ɗàrǝ́ nkalang bǝsa aɓalǝi sǝ so muku-gìr loasǝ yele mǝ'rǝmɓoarne amurí, sǝ pàgir nǝ bǝsa mana mala Ɓakuli na raka a ɓadǝm Yahweh.<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 4:24">Nggur 4:24</ref>; <ref loc="2SA 6:7">2Sam 6:7</ref></char>.</note><note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:9">Pur 30:9</ref>; <ref loc="NUM 3:4">Ɓal 3:4</ref>; <ref loc="NUM 26:61">26:61</ref></char>.</note> <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />Kara bǝsa pur nǝban Yahweh, pisǝia kǝring, sǝ à wǔ a ɓadǝm Yahweh. <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />Musa osso ne Haruna ama, &lt;&lt;Mǝnia ka ndà gìr mana Yahweh banggice lang na ama,</para>
  <para style="q1" vid="LEV 10:3">&lt;&lt; &lt;Mǝ nǝ lǝmdǝ ɓamúràm mǝ nda mǝfele</para>
  <para style="q2" vid="LEV 10:3">aban aɓwana mana à nda tù abanam ngga,</para>
  <para style="q1" vid="LEV 10:3">sǝ mǝ nǝ kum gulo</para>
  <para style="q2" vid="LEV 10:3">a ɓadǝmbǝ aɓwana kat.&gt; &gt;&gt;</para>
  <para style="m" vid="LEV 10:3">Haruna duk kúni ɗǝong.<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />Musa túrban ɓǝà tunǝ Mishayel andǝ Elzafan, amuna-burana mala Uziyel, kina Haruna, sǝ nea wia ama, &lt;&lt;Wu yiu kani wu pwan aɓǝla ma'wun ɓǝà nying ɓadǝm ban mǝfele, wu umnǝia anzǝm kàttì.&gt;&gt; <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />Ndà à wario à kya pwan aluia, mana à nda aɓalǝ adaura-pǝris malea piu ka; à umnǝia anzǝm kàttì, kǝla mana Musa bang ngga. <verse eid="LEV 10:5" /><verse number="6" style="v" sid="LEV 10:6" />Pǝlǝa Musa ne Haruna, sǝ Eleaza andǝ Itamar, amuna-burana male ama, &lt;&lt;Cè wu lǝmdǝ bumkiɗikea ma'wun nǝ nying nyang múr wun zuli, ko wu sàngi adaura ma'wun ɗàng, ace mǝnana wu kǝa wù raka, sǝ bumlulla mala Yahweh ɓǝkǝa sulǝo amur ɓwabundǝa kat raka. Sǝama amǝ'eam wun, amǝ Isǝrayila puppup ka, à earnia wia ɓǝà ɓua mǝnia yì alú atàcau mala bǝsa mana Yahweh tasǝ ka. <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />Sǝ wu kǝa purî bankutio aɓa Tara Ban-peri ɗang, ɓǝ̀ ana raka wun nǝ̀ wukio, acemǝnana mùrú ɗārǝ́bân mala Yahweh ka nda amur wun.&gt;&gt; Nda sǝ à pa kǝla mana Musa na ka.<verse eid="LEV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />Pǝlǝa Yahweh nacau nǝ Haruna ama, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />&lt;&lt;A pà wunǝ nu mùr-anap ko mba ɗàng, we wunǝ amuna-burana mô, ɓǝ̀ wun nǝ̀ kùtí aɓa Tara Ban-peri ka, ace mǝnana wu kǝa wù raka. Mǝnia ka nǝ̀ duk nggurcau arǝ anza ma'wun kat tàtǝ́k. <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />Mǝnia ka nda ace mǝnana ɓǝ̀ wu gau nre gir mǝfele andǝ mana mǝfele na raka, sǝ wu gau nre gìr'ɓeami andǝ mǝnana mǝɓoarnsari na ka. <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />Sǝ dumǝna púp awu nǝ̀ kanî aɓwana mala Isǝrayila kat angguracau mǝnana Mim Yahweh, ǝn banggia wia nǝban Musa ka.&gt;&gt;<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />Pǝlǝa Musa ne Haruna cau andǝ Eleaza andǝ Itamar, amuna-burana male mana à ue nǝ yilǝmu ka ama, &lt;&lt;Wu twal cili pàgir mala mǝsǝsa mǝnana ueo aɓa pàgir mala girlina<note caller="+" style="f"><char style="fr" closed="false">10:12 </char><char style="fq" closed="false">pàgir mala girlina </char><char style="ft" closed="false">ko pàgir mala pisǝe a bǝsa; anggo gbal a mǝsǝì 13, 15.</char></note> mana à pà abanam Yahweh ka, wu lì, sǝama ɓǝkǝa pàngnǝ yis arǝì ɗàng; wu lì a nkanggari gyangŋan, acemǝnana pàgir nggea mǝfele na. <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />Dumǝna púp wun nǝ̀ lì a ban mǝfele, acemǝnana kāmbe mò na sǝ kāmbe mala amuna-burana mô na aɓa pàgir mala girlina mǝnana à pà abanam Yahweh ka; acemǝnana anggo sǝ à nam. <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />Sǝama kikilu mana à loasǝi a kùli andǝ byali mana à pà kǝla kāmbe ka, wun nǝ̀ lì a ban mǝɓoarnsari, we, wunǝ amuna-burana mô, andǝ amuna-mamǝna mô atò, acemana à pana wunǝia kǝla kāmbe mò sǝ kāmbe mala amuna-burana mô aɓalǝ agir'nkila mala apagir ace dotarǝu mala amǝ Isǝrayila. <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />Byalu mana à pà kāmbe nǝi andǝ kikilu mana à loasǝi a kùli ka à nǝ̀ yinǝia atārǝia andǝ abare mùrú-nyama mala pàgir mala girlina, ace loasǝe a kùli ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. Mǝnia ka nǝ̀ duk kāmbe mò andǝ mala amuna-burana mô atò tàtǝ́k, kǝla mana Yahweh bang ngga.&gt;&gt;<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />Musa ɗice gbato mala pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 17 andǝ 19.</char></note> sǝ yi sǝlǝa ama à angŋa dǝmba à pisǝni. Bumi-lullo arǝ Eleaza andǝ Itamar, yì amuna-burana mala Haruna mana à ue ka, sǝ ɗia ama, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />&lt;&lt;Ace mana sǝ nyam pàgir ace cauɓikea ka wu lì aɓa patal mala ban mǝfele ɗàng? Mǝnia yì pàgir ka nggea mǝfele na, sǝ Yahweh pana wuni ace mǝnana ɓǝ̀ wu twal twalo mala cauɓikea mala ɓwabundǝa, ɓǝ̀ wu shawuɗia a ɓadǝm Yahweh ka. <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />Nkile ka, à kùtí nǝi aɓa ban mǝfele aɓalǝi ɗàng. Ɓoaro male ka yale ɓǝ́ wu lina gìr'nkilè aɓa ban mǝfele, kǝla mana ǝn na wun ngga.&gt;&gt;<verse eid="LEV 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19" />Pǝlǝa Haruna pè Musa eare ama, &lt;&lt;Yalung sǝ yia ka à pàgir malea ace cauɓikea sǝ à pàgir malea mala pisǝe kǝring a ɓadǝm Yahweh. Sǝ sǝni, nǝ ulang agir kǝla mǝno à kumam ngga, Yahweh nǝ̀ earam ɓǝn li mǝnia yì pàgir ace cauɓikea ka le?&gt;&gt; <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />Lang Musa ok cau mǝno ka, cê kpaki wi pǝlǝa earnǝi.<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s">Anyama amǝɓoarne andǝ amǝɓeami</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />Sǝ Yahweh nacau nǝ Musa andǝ Haruna ama, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />&lt;&lt;Wu banggi amǝ Isǝrayila acau mǝnia ka ama: Atà agirkusǝu mǝnana à kǝ gya a nzǝm-nzali ka, amǝnia ka à nda ka mana wun nǝ̀ gandǝ lia ka: <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />Koya girkusǝu mǝnana nkaulakusǝi na ɓulkǝt sǝ gauwa, sǝ kǝ ɓǝsǝlǝshe ka, wun nǝ̀ gandǝ nǝ li.<verse eid="LEV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 11:4" />&lt;&lt;Sǝama, atà agirkusǝu mana à kǝ ɓǝsǝlǝshe ko kusǝia na ɓulkǝt sǝ gau ka, pà wun nǝ̀ lì amǝnia ka ɗang:</para>
  <para style="li" vid="LEV 11:4">Kalakadambi, acemǝnana kǝ ɓǝsǝlǝshe sǝama kusǝi gau ɗang; ace mani ka, gìr'ɓeami na aban wun.<verse eid="LEV 11:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="LEV 11:5" />Sǝ mpkalang, acemǝnana kǝ ɓǝsǝlǝshe sǝama kusǝi gau ɗang; ace mani ka, gìr'ɓeami na aban wun.<verse eid="LEV 11:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="LEV 11:6" />Sǝ nsong, acemǝnana kǝ ɓǝsǝlǝshe sǝama kusǝi gau ɗang; ace mani ka, gìr'ɓeami na aban wun.<verse eid="LEV 11:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="LEV 11:7" />Sǝ tǝmbǝrǝm, acemǝnana nkaulakusǝi na ɓulkǝt sǝ gauwa, sǝama kǝ ɓǝsǝlǝshe ɗàng; ace mani ka, gìr'ɓeami na aban wun.<verse eid="LEV 11:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="LEV 11:8" />Dumǝna púp pà wun nǝ̀ lì kǝ nyamia ɗàng, sǝ pà wun nǝ̀ je luia ɗàng; agir'ɓeami na aban wun.<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />&lt;&lt;Atà agir mǝyilǝmui mǝnana à nda mùr ka, wun nǝ̀ gandǝ li amǝnia ka. Koya gìr mǝnana nda a nggeamùr ko nggeasala, sǝ ndanǝ abú-omùr andǝ nggwate ka, wun nǝ̀ gandǝ li. <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />Sǝama agir mǝyilǝmui mana a nggeamùr, andǝ amana a nggeasala, atà agir mǝyilǝmui mana à kǝ ging mbǝl-mbǝl a mùr, mǝnana à pànǝ abú-omùr andǝ nggwatea raka, agir ɓeakǝno na aban wun. <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />Wun nǝ̀ twalia agir ɓeakǝno na; pà wun nǝ̀ lì kǝ nyamia ɗàng, sǝ wun nǝ̀ ɓinǝce aluia. <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />Gìr mǝnana kat nda a mùr, sǝ pànǝ abú-omùr andǝ nggwate raka, gìr ɓeakǝno na aban wun.<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />&lt;&lt;Amǝnia ka, à nda ka anyal mǝnana wun nǝ̀ ɓinǝcea ka; pà wu nǝ̀ lia ɗàng; agir'ɓeami na: nyal-nkeli, andǝ baula, andǝ dǝkǝlaki, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />kùnggúm, andǝ koya ulang gìrfwanji, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />andǝ koya ulang gang'lang, <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />andǝ ndaù, andǝ gihi, andǝ nyal-nggeamùr, andǝ koya nyal mǝnana nda kǝla mǝ'nzǝkarka ka, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />andǝ gihi mǝkyauwe, andǝ npyauwar, andǝ gihi mǝgule, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />andǝ gihi mǝpwasǝe, andǝ kùnggúm pǝɗanban, andǝ kàrkà, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />andǝ nyal-la, andǝ koya ulang mǝ'garakusǝsakya, andǝ nzaɓako, andǝ mǝkyengkyeng.<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />&lt;&lt;Ankūngga mǝnana kat à ndanǝ mburu sǝ à kǝ gya amur akusǝia ine ka agir ɓeakǝno na aban wun. <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />Sǝama, atà ankūngga mǝnana à ndanǝ mburu sǝ à kǝ gya amur akusǝia ine ka, wun nǝ̀ gandǝ li amana à ndanǝ agbata a garakusǝia mǝnana à kǝ zurki nǝia amur ɓakusǝia a nzali ka. <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />Aɓalǝia ka wun nǝ̀ gandǝ li amǝnia: koya ulang doshi, andǝ koya ulang doshi-sú'nzali, andǝ koya ulang nshire. <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />Sǝama acili ankūngga mǝnana à ndanǝ mburu andǝ akusǝia ine ka, agir ɓeakǝno na aban wun.<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />&lt;&lt;Amǝno ka à nda ka agir mǝnana à nǝ̀ tsǝk wun a do-ɓeami ka. Ɓwa mana kat je lú ka amǝno yì agir ka, nǝ̀ duk gìr'ɓeami ba kpa mala pwari. <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />Sǝ ɓwa mana kat twal kǝ bare lú ka agir mǝno ka, dumǝna púp nǝ̀ lakki anggubyau male, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra.<verse eid="LEV 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 11:26" />&lt;&lt;Koya girkusǝu mǝnana nkaulakusǝi na ɓulkǝt sǝ gauwa sǝama gau kat ɗàng, ko kǝ ɓǝsǝlǝshe raka, gìr'ɓeami na aban wun; ɓwa mǝnana kat jea ka nǝ̀ duk mǝɓeami. <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />Agirkusǝu mana kat à kǝ gya amur akusǝia ine, sǝ à ndanǝ amuna-kusǝia nǝ ankaulakusǝia ka, agir'ɓeami na aban wun; ɓwa mana kat je luia ka, nǝ̀ duk mǝɓeami ba pwarikpǝra. <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />Sǝ ɓwa mǝnana kat twal luia ka, dumǝna púp nǝ̀ lak anggubyau male, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. Agir'ɓeami na aban wun.<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />&lt;&lt;Atà agir-yilǝmu mǝnana à kǝ kuɗǝki a nzali ka, amǝnia ka, à nǝ̀ duk gìr'ɓeami aban wun: butǝle, andǝ nkwam, andǝ koya ulang kalakuso mǝgule, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />andǝ shishar, andǝ tsarang, andǝ kasǝnazana, andǝ dàrá, andǝ kalankunding. <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />Amǝno ka agir'ɓeami na aban wun atà agir mǝnana à kǝ kuɗǝki a nzali ka. Ɓwa mana kat je luia ka, nǝ̀ duk gìr'ɓeami ba pwarikpǝra. <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />Yale gìr mana kat luia kpa amurí ka, girni nǝ̀ duk gìr'ɓeami, ko gìr mǝnana à pè nǝ nggun ngga nda, ko gìr'nggūrǝu na, ko nggú na, ko záng na, ko koya girtúró na ka. Dumǝna púp à nǝ̀ oasǝi a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />Sǝ komǝye na ateà mana kpa aɓa ɓekǝ nkwaring-dǝɓang ngga, agir mǝnana aɓalǝi kat ka à nǝ̀ duk agir'ɓeami, sǝ dumǝna púp à nǝ̀ arki. <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />Koya girlina na mana ɓoaro à nǝ̀ lì, sǝ liuwe aɓa mùr mana nda aɓa mǝno yì nkwaring ngga, nǝ̀ duk gìr'ɓeami, sǝ koya girnùná mǝnana nda aɓa mǝno yì nkwaring ngga nǝ̀ duk gìr'ɓeami. <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />Sǝ koya gìr na mǝnana kat koya bare lú mǝno yì girkusǝu ka kpa amurí ka, nǝ̀ duk gìr'ɓeami. Ko ɓǝ̀ ovù ko pira na sǝ ɓekǝ bare lugir mǝno kpa amurí ka dumǝna púp à nǝ̀ arki gucik-gucik. À dumǝna gìr'ɓeami sǝ à nǝ̀ duk gìr'ɓeami aban wun. <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />Kat andǝ amani ka, mùr a mgbeɗe ko mùr a tūli ka nǝ̀ dum nǝ ɓoarnsari ko ɓǝ̀ lú komǝye na atà amǝno yì agirkusǝu sǝ kpa aɓalǝi ka, sǝama ɓwa mǝnana kat je luia ka nǝ̀ duk mǝɓeami. <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />Ɓǝ̀ mwashat aɓalǝ alúgir mǝno kpa amur ɓekǝ mǝsǝɓeale mana à nǝ̀ ká ɓeale ka, mǝnia yì mǝsǝɓeale ka nǝ̀ pàk mǝɓoarnsari. <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />Sǝama ɓǝ̀ mǝsǝɓeale ka à liuni a mùr, sǝ ɓekǝ bare alúgir mǝno kpa amurí ka, dumǝna gìr'ɓeami aban wun.<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />&lt;&lt;Ɓǝ̀ mwashat atà agirkusǝu mana mǝɓoarne na ace girlina sǝ wǔ ka, ɓwa mǝnana kat je luí ka nǝ̀ duk mǝɓeami ba pwarikpǝra. <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />Ɓwa mǝnana kat lì nyam mǝno yì lugir ka, dumǝna púp nǝ̀ lak anggubyau male, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. Sǝ ɓwa mana kat twal lugir mǝno ka, dumǝna púp nǝ̀ lak anggubyau male, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra.<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />&lt;&lt;Giryilǝmu mǝnana kat kǝ kuɗǝki a nzali ka, gìr ɓeakǝno na; à pà nǝ̀ lì ɗàng. <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />Gìr mǝnana kat kǝ ɓangnǝ múrbumi, andǝ gìr mǝnana kat kǝ kuɗǝki a nzali nǝ akusǝi ine ko akusǝi pas ka, pà wun nǝ̀ lia ɗàng, acemǝnana agir ɓeakǝno na. <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />Wu kǝa pǝndǝki ɓamurǝ wun nǝ kǝɓè gir-yilǝmu mǝnana kǝ kuɗǝki ka, sǝ anggo ka wun nǝ̀ duk amǝɓeami nǝbania ka ɗàng. <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />Mǝ nda Yahweh, Ɓakuli ma'wun; wu tàr ɓamurǝ wun acem, wu duk domǝfele, acemǝnana mim ngga, mǝ nda mǝfele ka. Pà wun nǝ̀ pǝndǝki ɓamurǝ wun nǝ kǝɓè gìr mǝnana kǝ kuɗǝki a nzali ka ɗàng. <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />Mǝ nda Yahweh, mana ǝn pusǝ wun, wu purî ɓá Masar ka, ace mǝnana mǝ do, mǝ nda Ɓakuli ma'wun ngga. Acemani ka, wu duk amǝfele, acemana mim ngga mǝ nda mǝfele ka.&gt;&gt;<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />Mǝnia ka nda nggurcau amur agirkusǝu, andǝ anyal, andǝ koya gir-yilǝmu mana kǝ gya a mùr, andǝ koya gir-yilǝmu mana kǝ kuɗǝki a nzali ka, <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />ace mǝnana ɓǝ̀ wu gau nre gìr'ɓeami andǝ gìr mǝɓoarnsari, sǝ ɓǝ̀ wu súrǝ̀ gir-yilǝmu mǝnana à nǝ̀ lì andǝ mana à pà nǝ̀ lì raka.<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s">Lakrǝu mala ɓwama anzǝm gbashi</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />Yahweh bangcau nǝ Musa ama, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />&lt;&lt;Banggi amǝ Isǝrayila, ama, &lt;Ɓwama mana kum muna-bum, sǝ gbáshí muna-ɓwabura ka, mǝno yì ɓwama ka nǝ̀ duk gìr'ɓeami ba anongŋo tongno-nong-ɓari, kǝla mana mǝɓeami na a bumkwana male ka. <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />Sǝ a tongno-nong-tàruià pwari ka, à nǝ̀ kasǝî muna ɓate. <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />Sǝ ɓwame ka, dumǝna púp nǝ̀ lidǝmba nǝ lakrǝu arǝ sukkio mala nkila gbáshí male anongŋo lumi-tàrú nong tàrú (33). Aɓalǝ anongŋo mala lakrǝu mǝno ka, dumǝna púp pà nǝ̀ je kǝgir mǝnana à tàrì mǝfele na ka ɗàng. Sǝ dumǝna púp pà nǝ̀ kùtí aɓa ban mǝfele ɗàng, sheɓǝ̀ anongŋo male, mala lakrǝu yi lumsǝna ka. <verse eid="LEV 12:4" /><verse number="5" style="v" sid="LEV 12:5" />Sǝ ɓǝ̀ ɓwame ka muna-ɓwama na gbáshí ka, do-ɓeami male ka anongŋo mala limo ɓari na, kǝla mana mǝɓeami na a bumkwana male ka. Dumǝna púp nǝ̀ lidǝmba aɓa lakrǝu arǝ sukkio mala nkila gbáshí male anongŋo lumi-tongno-nong-mwashat bwamdǝ tongno-nong-mwashat (66).<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />&lt;&lt; &lt;Sǝ ɓǝ̀ anongŋo mala lakrǝu male arǝ sukkio mala nkila gbáshí muna-ɓwabura, ko muna-ɓwama lùmsǝna ka, nǝ̀ kánǝ muna-nzur mana mbule mwashat ka nǝ̀ pà aban pǝris a bankutio aɓa Tara Ban-peri, ace pàgir mala pisǝe kǝring, andǝ kutugangyi mwashat ko kutumurǝm mwashat ace pàgir ace cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 8.</char></note> <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />Sǝ pǝris ka nǝ̀ yinǝia a ɓadǝm Yahweh, nǝ̀ shawuɗi ɓwame nǝia. Anzǝm mǝno ka, sǝ ɓwame nǝ̀ kum ɓoarnsari arǝ ɓunno mala nkila male. Mǝno ka, nda nggurcau mana ɓwama mǝnana loa gbáshí muna-ɓwabura, ko muna-ɓwama ka, nǝ̀ kpate ka. <verse eid="LEV 12:7" /><verse number="8" style="v" sid="LEV 12:8" />Sǝama, ɓǝ̀ ɓwame pà nǝ̀ gandǝ pâ muna-nzur raka, ɓǝ̀ twal akutugangyi ɓari, ko akutumurǝm ɓari.<note caller="+" style="f"><char style="fr" closed="false">12:8 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="LUK 2:24">Luk 2:24</ref></char>.</note> Mwashat ka, nda ace pàgir mala pisǝe kǝring, sǝ ɓè man ngga nda ace pàgir ace cauɓikea. Sǝ pǝris nǝ̀ shawuɗì nǝia, sǝ ɓwame nǝ̀ kum ɓoarnsari.&gt; &gt;&gt;<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s">Anggurcau amur kwánó nggû</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />Yahweh nacau nǝ Musa andǝ Haruna ama, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />&lt;&lt;Lang ɓè ban a nggū rǝ ɓwa kum gìr-mwara, ko bàndà, ko ngguí terìkì, mǝnana yakǝla nǝ̀ nggá pǝlǝ kwánó nggû<note caller="+" style="f"><char style="fr" closed="false">13:2 </char><char style="fq" closed="false">kwánó nggû </char><char style="ft" closed="false">ko ɓè kwánó mǝɓike mala nggū rǝu mana kǝ akrǝ ɓwa ka.</char></note> a nggū rǝì ka, dumǝna púp à nǝ̀ yinǝ ɓwe aban Haruna, yì pǝris, ko aban mwashat atà amuna-burana male, mana pǝris na ka. <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />Sǝ pǝris ka, nǝ̀ pelǝki ban mǝnana kwánó sak kam a nggū rǝ ɓwe ka. Sǝ ɓǝ̀ nyang mala ban mǝnana kwánó sak kam a nggū rǝ ɓwe ka, pǝlǝna mǝpwasǝe, sǝ kwane ka, lǝmdǝa kǝla limna aɓa ngguí ka, mǝnia ka kwánó nggû na bwali ka. Anzǝm mana pǝris pelǝkina ɓwe ka, pǝlǝa nǝ̀ bang bwāng ama, mǝnia yì ɓwa ka, dumǝna mǝɓeami. <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />Sǝama ɓǝ̀ ban mana terìkì a nggū rǝ ɓwe ka pwasǝo, sǝ lǝmdǝ ama lime kútì ngguí ɗàng, sǝ nyang banì ka pǝlǝ mǝpwasǝe raka, pǝris nǝ̀ kasǝkun ɓwe a kurǝm ba anongŋo tongno-nong-ɓari. <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />Sǝ a tongno-nong-ɓaria pwari ka, pǝris nǝ̀ pelǝki rǝ ɓwe ɗǝm. Sǝ ɓǝ̀ sǝni ama kwane ka ndakam piu sǝ ak nggū rǝ ɓwe raka, pǝris nǝ̀ kasǝkun ɓwe, ɓǝ̀ pàk aɓea nongŋo tongno-nong-ɓari ɗǝm. <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />Sǝ pǝris nǝ̀ pelǝkì ɗǝm a tongno-nong-ɓaria pwari, sǝ ɓǝ̀ ban mǝno mana kum kwánó ka pǝlǝna mbǝrǝm-mbǝrǝm, sǝ kwane ka ak nggū rǝ ɓwe raka, pǝlǝa pǝris nǝ̀ bang bwāng ama, ɓwe ɓoarnansari; kǝ bàndà na kumi ka. Sǝ ɓwe ka nǝ̀ lakki anggubyau male, sǝ nǝ̀ ɓoarnsari. <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />Sǝama, ɓǝ̀ bàndà aki nggū rǝ ɓwe, anzǝm mana ɓwe lǝmdǝna ɓamúrì aban pǝris ace lakban male ka, dumǝna púp, ɓwe nǝ̀ nyare nǝ̀ nggá lǝmdǝ ɓamúrì aban pǝris ɗǝm. <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />Sǝ pǝris nǝ̀ nyare nǝ̀ sǝngi rǝ mǝno yì ɓwa ka, sǝ ɓǝ̀ sǝni ama bàndà ka akina nggū rǝ ɓwe ka, pǝris nǝ̀ bang bwāng ama, ɓwe dumǝna mǝɓeami; kwánó nggû na bwali ka.<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />&lt;&lt;Lang ɓwa bwal kwánó nggû ka, dumǝna púp à nǝ̀ yinǝi aban pǝris. <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />Sǝ pǝris nǝ̀ sǝngi nggūrǝ ɓwe. Ɓǝ̀ gìr-mwara mǝpwasǝe, nakam a nggū rǝì, mana tsǝ̀ngŋǝ̀nà nyang nggū rǝi pǝlǝna mǝpwasǝe, sǝ npenye loa mǝna a ban mǝnana mwar a nggū rǝì ka, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />mǝnia ka, kwánó nggû nggea mǝɓike na a nggū rǝì. Sǝ pǝris nǝ̀ bang bwāng ama, ɓwe ka, dumǝna mǝɓeami. Pà nǝ̀ ɓoaro ɓǝ̀ pǝris kasǝkun ɓwe ɗàng acemǝnana pǝlǝna mǝɓeami. <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />Sǝ ɓǝ̀ mǝnia yì kwánó nggû ka ak nggū rǝ man yì ɓwa kwánó bwali ka kat, twal a ɓamúrí yi puro arǝ akusǝi, andǝ abân mǝnana arǝì kat pǝris nǝ̀ gandǝ sǝni ka, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />pǝlǝa pǝris nǝ̀ pelǝki ɗǝm. Ɓǝ̀ kwánó nggû akina nggūrǝ ɓwe kat ka, pǝris nǝ̀ bang bwāng ama, ɓwe ka ɓoarnansari. Acemǝnana nggū rǝ ɓwe pǝlǝna mǝpwasǝe kat-kat ka, ɓwe ɓoarnansari. <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />Sǝama a pwari mana kat à sǝn bǝsa npenye puro arǝ ɓwe ka, ɓwe nǝ̀ duk mǝɓeami. <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />Sǝ pǝris nǝ̀ pelǝki bǝsa npenye mǝno arǝ ɓwe ka, sǝ nǝ̀ bang bwāng ama, ɓwe ka dumǝna mǝɓeami. Sak mala bǝsa npenye ka gìr'ɓeami na, sǝ lǝmdǝ ama, ɓwe ka ndanǝ kwánó nggû. <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />Sǝ ɓǝ̀ bǝsa npenye sonzǝo sǝ pǝlǝ mǝpwasǝe ɗǝm ngga, dumǝna púp ɓwe nǝ̀ yiu aban pǝris. <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />Pǝris nǝ̀ pelǝki nggūrǝ ɓwe, sǝ ɓǝ̀ kwane pǝlǝna mǝpwasǝe ka, pǝris nǝ̀ bang bwāng ama, ɓwe ka ɓoarnansari. Anggo, sǝ à nǝ̀ sǝlǝ ama, ɓwe ɓoarnansari.<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />&lt;&lt;Lang ceakúmsǝǎm puro a nggū rǝ ɓwa sǝ yi sonzǝo, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />sǝ ɓǝ̀ ban mǝnana ceakúmsǝǎm pak kam ngga, mwaro sǝ pwasǝo ko terìkì, pǝlǝ mǝbangŋe sǝ kǝ tanzama ka, dumǝna púp à nǝ̀ lǝmdǝí aban pǝris. <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />Pǝris nǝ̀ pelǝki, sǝ ɓǝ̀ ban mǝnana terìkì ka lime kútì ngguí, sǝ nyang mǝnana aɓalǝi ka pǝlǝna mǝpwasǝe ka, pǝris nǝ̀ bang bwāng ama, ɓwe ka, dumǝna mǝɓeami. Mǝnia ka kwánó nggû na sak aɓa ceakúmsǝǎm ngga. <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />Sǝama, ɓǝ̀ pǝris pelǝki sǝ sǝni ama nyang mǝpwasǝe pà kàm aɓalǝi ɗàng, sǝ lime kútì cili nggū rǝ ɓwe raka, sǝ nda mbǝrǝm-mbǝrǝm ngga, pǝris nǝ̀ kasǝkun ɓwe ɓǝ̀ pàk anongŋo tongno-nong-ɓari. <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />Sǝ ɓǝ̀ kwane ka nda aban aki rǝ ɓwe ka, pǝris nǝ̀ bangŋi bwāng ama, ɓwe dumǝna mǝɓeami; kwánó na. <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />Sǝama, ɓǝ̀ ban mǝnana terìkì ka ueo a ban mǝmwashati, mesǝ raka, lǝmdǝ ama, npenye malǝna; kǝ yale-npenye na ue ka. Pǝris nǝ̀ gandǝ bangŋi bwāng ama, ɓwe ɓoarnansari.<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />&lt;&lt;Lang bǝsa pisǝ ɓwa a nggū rǝì, sǝ nyam banì terìkì pǝlǝ mǝbangye sǝ pwasǝ ka, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />pǝris nǝ̀ pelǝki, sǝ ɓǝ̀ nyang mana a ban mǝnana terìkì ka pǝlǝna mǝpwasǝe, sǝ lǝmdǝ ama npenye lime kutini ngguí ka, mǝno ka kwánó nggû na pusǝrǝi a ban mǝno bǝsa pisǝi kam ngga. Pǝris ka, nǝ̀ na bwāng ama, ɓwe dumǝna mǝɓeami; kwánó nggû bwalǝni. <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />Sǝama ɓǝ̀ pǝris pelǝki, sǝ sǝn kǝ nyang pwasǝo a ban mǝnana terìkì ka ɗàng, sǝ npenye ka lime kútì ngguí raka, sǝ nda mbǝrǝm-mbǝrǝm ngga, pǝris nǝ̀ kasǝkuni she ɓǝ̀ pàkkina anongŋo tongno-nong-ɓari ka. <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />A tongno-nong-ɓaria pwari ka, pǝris nǝ̀ pelǝkì ɗǝm, sǝ ɓǝ̀ nda ban mesǝe nǝ̀ ak rǝì ka, pǝris nǝ̀ bang bwāng ama, ɓwe dumǝna mǝɓeami; ndanǝ kwánó nggû. <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />Sǝama ɓǝ̀ ban mǝnana terìkì ka ueo a ban mǝmwashati, mǝsǝe a nggūrǝì ɗàng, sǝ nda mbǝrǝm-mbǝrǝm ngga, gìr-mwara na pusǝrǝi a ban mǝno bǝsa pisǝi kam ngga. Pǝris ka, nǝ̀ bang bwāng ama, ɓwe ka ɓoarnansari; yale-npenye mala pisǝban mala bǝsa na.<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />&lt;&lt;Lang ɓwabura, ko ɓwama, kum kwánó a ɓamúrí, ko a mgbatakuni ka, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />pǝris nǝ̀ pelǝki kwane. Sǝ ɓǝ̀ sǝni ama lime kútì ngguí ɗàng, sǝ nyang mǝnana aɓalǝi ka mǝ'gwalani na sǝ nda watsǝkǝrak ka, pǝris nǝ̀ bang bwāng ama, ɓwe dumǝna mǝɓeami. Mǝnia ka, nzwari na; kwánó nggû mana kǝ puro a ɓamur, ko a mgbatakun ɓwa ka nda. <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />Sǝ ɓǝ̀ pǝris pelǝki kwánó nzwarinì sǝ sǝni ama lime kútì ngguí ɗàng, sǝ nyang-pǝndǝa pà kàm a banì raka, pǝlǝa pǝris nǝ̀ kasǝkun ɓwe mana nǝ kwánó nzwari ka, she ɓǝ̀ pakkina anongŋo tongno-nong-ɓari ka. <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />Sǝ a tongno-nong-ɓaria pwari ka, pǝris nǝ̀ pelǝki kwane. Ɓǝ̀ nzwarinì malaká mesǝ ɗang, sǝ ɓǝ̀ nyang mǝ'gwalani pà kàm aɓalǝi ɗàng, sǝ nzwarinì lime kútì nggū rǝ ɓwê raka, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />ɓwê nǝ̀ mwa nyang ɓamúrí, sǝama pà nǝ̀ mwa ban mǝnana nzwari nakam ngga ɗàng; sǝ pǝris nǝ̀ kasǝkun ɓwe mǝno kwánó nzwari bwali ka ba anongŋo tongno-nong-ɓari. <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />Sǝ a tongno-nong-ɓaria pwari ka, pǝris nǝ̀ pelǝki nzwarinì, sǝ ɓǝ̀ sǝni ama nzwarinì mesǝ a nggūrǝ ɓwe ɗàng, sǝ ɓǝ̀ lǝmdǝ ama lime kútì ngguí raka, pǝlǝa pǝris nǝ̀ bang bwāng ama, ɓwê ɓoarnansari. Sǝ yì ka nǝ̀ lakki anggubyau male, sǝ nǝ̀ ɓoarnsari. <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />Sǝama ɓǝ̀ nzwarinì mesǝe aki nggūrǝ ɓwe, anzǝm lakban male ka, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />pǝris nǝ̀ pelǝki ɓwe ɗǝm. Ɓǝ̀ nzwarinì akina nggūrǝ ɓwe ka, pǝris pà nǝ̀ alta kǝ nyang mǝ'gwalani aɓa npenye ɗàng; ɓwê dumǝna mǝɓeami. <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />Sǝama ɓǝ̀ pǝris sǝni ama nzwarinì nggaɗi ɗang, sǝ nyang-pǝndǝa gulna aɓalǝi ka, lǝmdǝ ama nzwarinì sonzǝna, sǝ ɓwe ɓoarnansari, sǝ pǝris nǝ̀ bang bwāng ama ɓwe ɓoarnansari.<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />&lt;&lt;Lang ɓwabura ko ɓwama, ndanǝ abân a nggū rǝì mǝnana à terìkì sǝ à pwasǝ ka, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />pǝris nǝ̀ sǝngi, sǝ ɓǝ̀ abân mǝno terìkì a nggū rǝ ɓwe, à pwasǝ mbǝrǝm-mbǝrǝm ngga, rǝǔ'eakya na pur a nggū rǝì ka; ɓwê ka ndanǝ ɓoarnsari.<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />&lt;&lt;Lang nyang ɓamur ɓwa rak ka, ɓwê pǝlǝna mǝɓamur-swara, sǝama ndanǝ ɓoarnsari. <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />Sǝ ɓǝ̀ nyang kúndǝm ɓwa rak ka, ɓwê nǝ̀ pàngnǝ ɓamur-swara a kúndǝmbi, sǝama ndanǝ ɓoarnsari. <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />Sǝama ɓǝ̀ ɓè ban a ɓamur-swara ko kúndǝm-swara mala ɓwa kum kwánó, sǝ banì pǝlǝ mǝbangye sǝ pwasǝ ka, kwánó nggû na sak a ɓamur-swara male ko kúndǝm-swara male ka. <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />Pǝlǝa pǝris nǝ̀ pelǝki, sǝ ɓǝ̀ sǝni kwánó mwárkya mǝno sak a ɓamur-swara ko kúndǝm-swara mala ɓwê ka, pǝlǝna mǝbangye sǝ pwasǝo, kǝla puro mala kwánó nggû a nggū rǝì ka, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />ɓwê bwalna nǝ kwánó nggû. Ace mani ka dumǝna mǝɓeami. Pǝris nǝ̀ bang bwāng ama, ɓwê dumǝna mǝɓeami; kwánó male ka nda a ɓamúrí.<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />&lt;&lt;Ɓwa mǝnana ndanǝ kwánó nggû ka, dumǝna púp nǝ̀ oasǝ agir-nggūrǝu mǝsange arǝì, sǝ nǝ̀ nying nyang ɓamúrí zuli. Sǝ ɓwê nǝ̀ gìr ban mburkuni sǝ nǝ̀ nggǝ hama ama, &lt;Mǝɓeami! Mǝɓeami!&gt; <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />Ɓwê ka nǝ̀ ueo anggo mǝɓeami na aɓalǝ anongŋo mala do nǝ kwánó mǝno arǝì ka kat. Dumǝna mǝɓeami. Ɓwê nǝ̀ dum nǝmurǝì; <note caller="+" style="f"><char style="fr" closed="false">13:46 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 5:2">Ɓal 5:2</ref>; <ref loc="NUM 12:14">12:14</ref>,<ref loc="NUM 12:15">15</ref>; <ref loc="2KI 7:3">2Amur 7:3</ref>; <ref loc="2KI 15:5">15:5</ref>; <ref loc="2CH 26:21">2Acau 26:21</ref>; <ref loc="LUK 17:12-13">Luk 17:12-13</ref></char>.</note>nǝ̀ duk zak anzǝm la.<verse eid="LEV 13:46" /></para>
  <para style="s">Kwánó nggû aɓa gìr'nggūrǝu</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />&lt;&lt;<note caller="+" style="f"><char style="fr" closed="false">13:47 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="LEV 14:55">Pǝris 14:55</ref></char></note>Lang kwàpì sak arǝ gìr'nggūrǝu, mǝnana à tè nǝ ɗà'ndíng ko linǝn, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />ko nda arǝ nkonggúr ko bugìr mala linǝn ko ɗà'ndíng, ko nda arǝ nggūgir, ko arǝ ɓè kǝgìr mǝnana à pè nǝ nggū ka, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />ɓǝ̀ ban mǝnana kwàpì ka lǝmdǝ mùrì mǝpwale ko mǝbangŋe arǝ gìr'nggūrǝuǐ, ko arǝ nggūgirnì, ko arǝ nkonggúrnì, ko arǝ bugìrnî, ko arǝ ɓè kǝgìr mana à pè nǝ nggū ka, kwàpì mala kwánó nggû na, sǝ dumǝna púp à nǝ̀ lǝmdǝì pǝris. <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />Anzǝm mana pǝris pelǝkini ka, nǝ̀ tsǝa ama ɓǝà tsǝì zak, ba anongŋo tongno-nong-ɓari. <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />Pǝlǝa a tongno-nong-ɓaria pwari ka, pǝris nǝ̀ pelǝki. Ɓǝ̀ sǝni ama kwàpì mǝno akina rǝ gìr'nggūrǝuǐ, ko nkonggúrnì, ko bugìrnî, ko nggūgirnì, komǝye nda túró mana à kǝ pangnǝi ka, kwàpì mala yinǝ kwánó nggû mǝɓinǝ malâ na; gìr'ɓeami na. <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />Sǝ yì ka nǝ̀ pisǝ mǝno yì gìr'nggūrǝu mala nkonggúr ɗà'ndíng ko linǝn, andǝ koya gìr na mǝnana à pè nǝ nggū, mana kwánó aki rǝì ka; kwàpì mǝno ka mala yinǝ kwánó nggû mǝɓinǝ malâ na. Dumǝna púp à nǝ̀ pisǝì a bǝsa.<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />&lt;&lt;Sǝ ɓǝ̀ pǝris pelǝkì sǝ sǝni ama kwane aki rǝ gìr'nggūrǝuǐ, ko nkonggúrnì, ko bugìrnî, ko koya gìr na mǝnana à pè nǝ nggū ka, raka, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />pǝlǝa pǝris nǝ̀ tsǝa ama ɓǝà lé sǝ ɓǝà tsǝì zak nǝ aɓwana ba anongŋo tongno-nong-ɓari. <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />Sǝ pǝris nǝ̀ pelǝki mǝno yì gìr mana kwàpì ka ɗǝm. Sǝ ɓǝ̀ sǝni ama ban mǝnana kwàpì ka nggaɗi mùrì ɗàng, anzǝm mana à langŋǝ́nì ka, sǝ ko ɓǝ̀ kwàpì mesǝ raka, gìrnî dumǝna mǝɓeami. Dumǝna púp à nǝ̀ pisǝì a bǝsa, koɓǝ̀ ban mana kwàpì lì arǝ nggubyaunì ka nda aɓalǝi ko a nza ka.<verse eid="LEV 13:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LEV 13:56" />&lt;&lt;Sǝama ɓǝ̀ pǝris pelǝkì, sǝ sǝni ama ban mǝnana kwàpì ka nda mbǝrǝm-mbǝrǝm, anzǝm mana à langŋǝ́nì ka, nǝ̀ kasǝì arǝ gìr'nggūrǝuǐ, ko nggūgirnì, ko nkonggúrnì, ko bugìrnî. <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />Ɓǝ̀ kwàpì nyare pusǝrǝi ɗǝm arǝ gìr'nggūrǝuǐ, ko arǝ nkonggúrnì, ko arǝ bugìrnî, ko arǝ koya gìr na mǝnana à pè nǝ nggū ka, lǝmndǝ ama kwàpìnî na arǝ akiban; dumǝna púp à nǝ̀ pisǝ koya gìr mǝnana ndanǝ kwàpìnî arǝì ka a bǝsa. <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />Sǝama ɓǝ̀ kwàpìnî ndǝrminì rǝ gìr'nggūrǝuǐ, ko nkonggúrnì, ko bugìrnî, ko koya gìr na mǝnana à pè nǝ nggū ka, anzǝm mana à langŋǝ́nì ka, dumǝna púp à nǝ̀ ɓǝsǝlǝ lê, sǝ nǝ̀ ɓoarnsari.&gt;&gt;<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />Mǝnia ka nda nggurcau mǝnana à nǝ̀ kpate ɓǝ̀ kwàpì pusǝrǝi arǝ gìr'nggūrǝu mana à swàrì nǝ nkonggúr ko bugìr mala linǝn ko ɗà'ndíng ngga, ko arǝ ɓè kǝgìr mǝnana à pè nǝ nggū ka, ace kasǝcau ama ɓoarnansari ko dumǝna mǝɓeami ka.<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s">Anzongcau ace lak mǝkwánó nggû</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />Yahweh banggi Musa cau ama, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />&lt;&lt;Mǝnia ka nda nggurcau ace mǝkwánó nggû, a pwari mala lakban male. À nǝ̀ yinǝi a ɓadǝm pǝris. <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />Sǝ pǝris nǝ̀ pùr anzǝm lá nǝ̀ ngga pelǝki kwane. Ɓǝ̀ pǝris sǝni rǝ ɓwê mana ndanǝ kwánó nggû ka malǝna ka, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />pǝris nǝ̀ tsǝa ama ɓǝà yinǝ amuna-nyal mǝɓoarne ɓari nǝ yilǝmia, andǝ munagara nggun-seda, andǝ bugir mǝbangŋe, andǝ bondo-hisop, ace ɓwa mana à nǝ̀ lé ka. <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />Pǝlǝa pǝris nǝ̀ tsǝa ama ɓǝà pwan-myal mwashat atà amuna-nyal mǝno ka amúr mùr mgbeɗe<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fq" closed="false">mùr mgbeɗe </char><char style="ft" closed="false">ko &lt;&lt;mùr ɓangŋa mana à loa toě ka.&gt;&gt; Anggo gbal a mǝsǝi 6, 50, 51, 52.</char></note> aɓa nkwaring-dǝɓang. <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />Sǝ pǝris ka, nǝ̀ twal nyal mana nǝyilǝmu ka, atārǝia andǝ munagara nggun-seda, andǝ bugir mǝbangŋe, andǝ bondo-hisop, sǝ nǝ̀ oasǝia aɓa nkila mala nyal mana à pwan-myali amúr mùr mgbeɗe ka. <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />Sǝ nǝ̀ watsǝkì kusǝ tongno-nong-ɓari amur ɓwa mǝnana à kǝ lé arǝ kwánó nggû ka. Pǝlǝa nǝ̀ bang bwāng ama ɓwê ɓoarnansari, sǝ nǝ̀ nying muna-nyal mana nǝ yilǝmu ka ɓǝ̀ o a bondo. <verse eid="LEV 14:7" /><verse number="8" style="v" sid="LEV 14:8" />Sǝ ɓwa mana à kǝ lé ka, nǝ̀ lakki agir'nggūrǝì, nǝ̀ swár nyang múrí kat, nǝ̀ sussǝo a mùr, sǝ yì ka nǝ̀ ɓoarnsari. Sǝ anzǝm mǝno ka, ɓwê nǝ̀ gandǝ yiu aɓalǝ aɓwana a bando malea, sǝama pà nǝ̀ kùtí aɓa gumli male ɗàng, ba nongŋo tongno-nong-ɓari. <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />A tongno-nong-ɓaria pwari ka, dumǝna púp ɓwê nǝ̀ swár nyang rǝi ɗǝm, andǝ mbotokuni, andǝ nyang múrmǝsǝì. Nǝ̀ swár nyang rǝi kat, nǝ̀ lakki agir'nggūrǝì kat, nǝ̀ sussǝo a mùr, sǝ yì ka nǝ̀ ɓoarnsari.<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />&lt;&lt;Sǝ a tongno-nong-tàruià nongŋo ka, ɓwê nǝ̀ yinǝ amuna-gam ɓari mǝnana ɓekǝ gìr mǝɓane pà kàm arǝia raka, andǝ nsari nzur mǝnana mbule mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝì raka, andǝ tasau tàrú<note caller="+" style="f"><char style="fr" closed="false">14:10 </char><char style="fq" closed="false">tasau tàrú </char><char style="ft" closed="false">ko tyang tàrú.</char></note> mala muku mǝɓǝlke, mǝnana à kpapi andǝ mùrú olif ace pàgir mala mǝsǝsa ka, andǝ mùrú olif banì mwashat aɓa gauwe tàrú mala du lita. <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />Sǝ pǝris mana kǝ lé ka, nǝ̀ tamsǝ ɓwa mǝnana à kǝ lé ka, andǝ amǝnia yì agir ka a ɓadǝm Yahweh, a bankutio aɓa Tara Ban-peri. <verse eid="LEV 14:11" /><verse number="12" style="v" sid="LEV 14:12" />Pǝlǝa pǝris nǝ̀ twal mwashat aɓalǝ amuna-gam, nǝ̀ pàgir mala mbwegìr ace kumcau nǝi, atārǝia andǝ mùrú olif banì mwashat aɓa gauwe tàrú mala du lita, sǝ nǝ̀ loasǝia a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />Sǝ pǝris nǝ̀ pwan-myal mǝnia yì nzur ka, a ban mǝnana à kǝ pwan-myal agirkusǝu mala pàgir ace cauɓikea<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 19, 22 andǝ 31.</char></note> andǝ pàgir mala pisǝe kǝring ngga, a ban mǝfele. Pàgir mana à pà mala mbwegìr ace kumcau, kǝla pàgir mana à pà ace cauɓikea ka, amala pǝris na; nggea mǝfele na. <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />Pǝris ka, nǝ̀ ɗàrǝa aɓa mǝnia yì nkila mala pàgir ace kumcau ka, nǝ̀ dwakǝɗi a gyare mburkiru mǝlì mala ɓwa mǝnana à kǝ lé ka, sǝ amur munabui mǝbure mǝlì, sǝ amur muna-kusǝi mǝbure mǝlì. <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />Sǝ pǝris ka, nǝ̀ ɗàrǝa aɓa banì mwashat mala gauwe tàrú mala du lita mala mùrú olif, sǝ nǝ̀ solǝi a ɓabui mǝ'nggare, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />sǝ pǝris nǝ̀ oasǝ munabui mǝlì aɓa mùrú mana a ɓabui mǝ'nggare ka, sǝ nǝ̀ watsǝki nǝ munabui kusǝ tongno-nong-ɓari a ɓadǝm Yahweh. <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />Sǝ aɓa mùrú mana ueo a ɓabui ka, pǝris nǝ̀ dwakǝɗi bǝti a gyare mburkiru mǝlì mala ɓwa mǝnana à kǝ lé ka, sǝ arǝ munabui mǝbure mǝlì, sǝ arǝ muna-kusǝi mǝbure mǝlì, amur nkila mala pàgir mala mbwegìr ace kumcau. <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />Sǝ cili mùrú mana a ɓabu pǝris ka, nǝ̀ solǝi a ɓamur ɓwa mǝnana à kǝ lé ka. Pǝlǝa pǝris nǝ̀ shawuɗì a ɓadǝm Yahweh. <verse eid="LEV 14:18" /><verse number="19" style="v" sid="LEV 14:19" />Pǝris nǝ̀ pà pàgir ace cauɓikea ace shawuɗi ɓwa mǝnana à kǝ lé ɓǝ̀ purî ɓá do-ɓeami male ka. Anzǝm mǝno ka, nǝ̀ pwan-myal girkusǝu mala pàgir mala pisǝe kǝring. <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />Sǝ nǝ̀ pà gir'nkila mala pàgir mala pisǝe kǝring, atārǝia andǝ pàgir mala mǝsǝsa, amur gyangŋan. Anggo sǝ pǝris nǝ̀ shawuɗi ɓwê, sǝ ɓwê nǝ̀ ɓoarnsari.<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />&lt;&lt;Sǝama ɓǝ̀ ɓwê ka mǝtǝr na, mana pà nǝ̀ gandǝ pà amǝnia yì apagir raka,<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 5:7-13">Pǝris 5:7-13</ref>; <ref loc="LEV 12:8">12:8</ref></char>.</note> dumǝna púp nǝ̀ yinǝ mǝgam ace pàgir mala mbwegìr ace kumcau, à nǝ̀ loasǝi a kùli ace shawuɗì. Ɗǝm ngga ɓwê nǝ̀ yinǝ tasau mwashat<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="fq" closed="false">tasau mwashat </char><char style="ft" closed="false">ko tyang mwashat.</char></note> mala muku mǝɓǝlke, mǝnana à kpapi andǝ mùrú olif ka ace pàgir mala mǝsǝsa, andǝ mùrú olif banì mwashat aɓa gauwe tàrú mala du lita. <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />Ɗǝm ngga, ɓwe nǝ̀ yinǝ akutumurǝm ɓari, ko akutugangyi ɓari, kǝla mana ndanǝi nǝ̀ pà ka. Mwashat ka, nda ace pàgir ace cauɓikea, sǝ ɓè man ngga nda ace pàgir mala pisǝe kǝring. <verse eid="LEV 14:22" /><verse number="23" style="v" sid="LEV 14:23" />A tongno-nong-tàruià nongŋo ka, dumǝna púp ɓwe nǝ̀ yinǝ agirnì aban pǝris ace lakban male, a bankutio aɓa Tara Ban-peri, a ɓadǝm Yahweh. <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />Sǝ pǝris nǝ̀ twal mǝgam mǝno, mala pàgir mala mbwegìr ace kumcau, atārǝia andǝ mùrú olif mǝno banì mwashat aɓa gauwe tàrú mala du lita ka. Sǝ pǝris nǝ̀ loasǝia a kùli, ɓǝ̀ duk pàgir na mǝnana à loasǝi a kùli a ɓadǝm Yahweh ka. <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />Sǝ pǝris nǝ̀ pwan-myal mǝgam mala pàgir mala mbwegìr ace kumcau. Pǝlǝa pǝris nǝ̀ ɗàrǝa aɓa kǝ nkila mala pàgir mala mbwegìr ace kumcau, sǝ nǝ̀ dwakǝɗi a gyare mburkiru mǝlì mala ɓwa mǝnana à kǝ lé ka, sǝ arǝ munabui mǝbure mǝlì, sǝ arǝ muna-kusǝi mǝbure mǝlì. <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />Pǝlǝa pǝris nǝ̀ ɗàrǝa aɓa mùrúnì, sǝ nǝ̀ solǝi a ɓabui mǝ'nggare, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />sǝ nǝ̀ tàu mùrú mana a ɓabui mǝ'nggare ka nǝ munabui mǝlì, sǝ nǝ̀ watsǝki kusǝ tongno-nong-ɓari a ɓadǝm Yahweh. <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />Sǝ aɓa mùrú mana a ɓabui ka, pǝris nǝ̀ dwakǝɗi bǝti a gyare mburkiru mǝlì mala ɓwa mǝnana à kǝ lé ka, sǝ a munabui mǝbure mǝlì, sǝ a muna-kusǝi mǝbure mǝlì, arǝ abân mǝnana à dwakǝɗi nkila mala pàgir mala mbwegìr ace kumcau kam ngga. <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />Sǝ cili mùrú mana ueo a ɓabu pǝris ka, nǝ̀ solǝi a ɓamur ɓwa mǝnana à kǝ lé ka, ace shawuɗè a ɓadǝm Yahweh. <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />Sǝ pǝris ka nǝ̀ pa gìr'nkila nǝ akutugangyi ko akutumurǝm mǝno, mana atea ɓwê gandǝ pa ka; <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />mwashat ka, nda ace pàgir ace cauɓikea, sǝ ɓè ka, nda ace pàgir mala pisǝe kǝring, atārǝia andǝ pàgir mala mǝsǝsa. Pǝlǝa pǝris nǝ̀ shawuɗi ɓwa mǝnana à kǝ lé ka, a ɓadǝm Yahweh. <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />Mǝnia ka nda nggurcau ace ɓwa mana kat ndanǝ kwánó nggû, sǝ kume male bik mana nǝ̀ gandǝ yinǝ apagir ace lakban male raka.&gt;&gt;<verse eid="LEV 14:32" /></para>
  <para style="s">Anggurcau ace lak aɓala</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />Yahweh banggi Musa andǝ Haruna ama, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />&lt;&lt;Lang wun nǝ̀ kùtí aɓa nzali Kan'ana, mǝnana ǝn nggǝ pà wun ɓǝ̀ duk girkuma ma'wun, sǝ ǝn tsǝk kwàpì mala kwánó nggû a ɓè ɓala aɓa nzali girkuma ma'wun ngga, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />dumǝna púp mǝtala ɓalae nǝ̀ nggá banggi pǝris, ama, &lt;Ən sǝni kǝla kwàpì ka nda kam a ɓala mem.&gt; <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />Sǝ kaniama pǝris nǝ̀ ká ace pelǝki kwanè ka, dumǝna púp nǝ̀ tsǝa ama ɓǝà pusǝki agir mǝnana a ɓale kat ka a nza, ace mǝnana ɓǝà kǝa tunǝî koman kat a ɓalanǐ mǝɓeami ɗàng. Anzǝm mǝno ka pǝris nǝ̀ ká ace sǝn ɓale. <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />Pǝris nǝ̀ kutio nǝ̀ pelǝki kwàpì mana arǝ abumkurǝm ngga. Ɓǝ̀ abân mǝnana à kwàpì arǝ bumkurǝm ngga à lǝmdǝ mùrì mǝpwale ko mǝbangŋe, sǝ ɓǝ̀ pǝris sǝni ama kwàpì ka ndarǝ li aɓa bumkurǝm ngga, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />pǝris nǝ̀ puro a nza a kunɓala, sǝ nǝ̀ gìr kun mǝno yì ɓala ka, ba nongŋo tongno-nong-ɓari. <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />A tongno-nong-ɓaria pwari ka, pǝris nǝ̀ yiu ɗǝm nǝ̀ pelǝki ɓá mǝno yì ɓala ka. Sǝ ɓǝ̀ kwane akinaban arǝ abumkurǝm ngga, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />pǝris nǝ̀ tsǝa ama atali mana à ɓangŋaɓa nǝia, sǝ ado ka à ndanǝ kwánó arǝia ka, ɓǝà pusǝkia; à nǝ̀ sukkia a ban mǝɓeamî anzǝm la. <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />Sǝ pǝris nǝ̀ tsǝa, à nǝ̀ konggi rǝ abumkurǝm kat, sǝ tú mana à konggi ka, à nǝ̀ ngga solǝi a ban mǝɓeamî anzǝm la. <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />Pǝlǝa à nǝ̀ twal aɓea atali à nǝ̀ oasǝkia a kunì amǝno à pusǝkia ka, sǝ à nǝ̀ tasǝ abumkurǝmì nǝ bǝsa biɗǝman.<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />&lt;&lt;Sǝ ɓǝ̀ kwàpì mǝno mana yikinǝ kwánó ka, nyare pusǝrǝi ɗǝm a ɓale, anzǝm mana à pusǝkina atali mana à ndanǝ kwánó arǝia, sǝ à konggina abumkurǝmnì, à tasǝna rǝia ka, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />pǝris nǝ̀ ká, nǝ̀ sǝni ɗǝm pepe; sǝ ɓǝ̀ kwàpì akinaban a ɓale ka, kwàpì mala yinǝ kwánó nggû mǝɓinǝ malâ na; gìr'ɓeami na. <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />Dumǝna púp ɓale ka, à nǝ̀ arki, sǝ atali male andǝ anggun male, andǝ tú male ka, à nǝ̀ pwania kat, à nǝ̀ umnǝia anzǝm la, a ban mǝɓeamî. <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />Sǝ koyana kat, mana kútí a mǝno yì ɓala, anzǝm mǝnana à girǝna kún ɓale ka, ɓwê nǝ̀ duk mǝɓeami ba pwarikpǝra. <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />Ɓwa mana kat nongŋo a ɓale, ko li girlina kam ngga, dumǝna púp nǝ̀ lakki agir'nggūrǝì.<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />&lt;&lt;Sǝama, ɓǝ̀ pǝris yiu, sǝ sǝni ama kwane mesǝe akiban a ɓale ɗang, anzǝm tasǝ abumkurǝmì ka, pǝris nǝ̀ bang bwāng ama ɓale ka ɓoarnansari; kwane umǝna. <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />Sǝ ace lak ɓale ka, pǝris nǝ̀ twal amuna-nyal ɓari, andǝ munagara nggun-seda, andǝ bugir mǝbangŋe andǝ bondo-hisop, <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />sǝ nǝ̀ pwan-myal mwashat atà amuna-nyal mǝno ka amúr mùr mgbeɗe aɓa nkwaring-dǝɓang. <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />Pǝlǝa nǝ̀ twal munagara nggun-seda andǝ bondo-hisop andǝ bugir mǝbangŋe, atārǝia andǝ muna-nyal mana nǝ yilǝmu ka, sǝ nǝ̀ oasǝia aɓa nkila mala muna-nyal mana à pwan-myali ka, sǝ aɓa mùr mgbeɗe mǝno ka, sǝ nǝ̀ watsǝkì ɓale kusǝ tongno-nong-ɓari. <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />Anggo sǝ pǝris nǝ̀ lak ɓale nǝ nkila mala muna-nyal, sǝ nǝ̀ mùr mgbeɗe, sǝ nǝ muna-nyal mana nǝ yilǝmu ka, sǝ nǝ munagara nggun-seda, andǝ bondo-hisop, andǝ bugir mǝbangŋe. <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />Pǝlǝa pǝris nǝ̀ nying muna-nyal ɓǝ̀ o ɓǝ̀ purî ɓá nggea-là aban ká a bondo. Anggo sǝ pǝris nǝ̀ shawuɗi ɓala mǝno, sǝ nǝ̀ ɓoarnsari.&gt;&gt;<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />Mǝnia ka nda nggurcau amur cau mala koya kwánó nggû: ace nzwari, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" /><note caller="+" style="f"><char style="fr" closed="false">14:55 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 13:47">Pǝris 13:47</ref></char>.</note>ace sa mala kwàpì arǝ gìr'nggūrǝu ko arǝ ɓala, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />sǝ ace gìr-mwara, ko bàndà, ko terìkì mala nggū, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />ace kasǝcau ama gìr ko ɓwa ka mǝɓeami na ko ɓoarnansari. Mǝnia ka nda nggurcau amur kwánó nggū andǝ kwàpì.<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s">Nggurcau amur puro mala <optbreak /> mùrgìr mǝɓeami a ɓata ɓwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />Yahweh bangcau nǝ Musa andǝ Haruna, ama, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />&lt;&lt;Ne amǝ Isǝrayila ama, &lt;Lang ɓwa na nǝ kwánó arǝì sǝ ɓate kǝ pur mùrgìr ka, puro mala mùrgìr male ka gìrɓeami na. <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />Sǝ mǝnia ka nda nggurcau amur do-ɓeami atàcau mala puro mala mùrgìr male: ko ɓate kǝ pur mùrgìr, ko puro mala mùrgìr male gìr kún ɓate, mǝno ka do-ɓeami na a baní.<verse eid="LEV 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4" />&lt;&lt; &lt;Koya gìr-nongŋo na mana ɓwa mǝno mùrgìr kǝ puro a ɓate, sǝ nongŋo amurí ka, gìr-nongŋê nǝ̀ duk mǝɓeami. Yale gìr mana kat ɓwê do amurí ka, nǝ̀ duk mǝɓeami. <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />Sǝ ɓwa mana kat je gìr-nongŋo male ka, dumǝna púp ɓwe nǝ̀ lak agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />Sǝ koya ɓwa na kat do amur koyagir na mǝno yì mǝ pùr mùrgìr a ɓate duk kam ngga, dumǝna púp ɓwê nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:6" /><verse number="7" style="v" sid="LEV 15:7" />Ɓwa mana kat je rǝ ɓwa mǝnana ndanǝ puro mala mùrgìr a ɓate ka, dumǝna púp ɓwê nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:7" /><verse number="8" style="v" sid="LEV 15:8" />Sǝ ɓǝ̀ mǝnia yì ɓwa mana ndanǝ puro mala mùrgìr a ɓate, sǝ tau'ntāra arǝ aɓwana mana amǝɓoarnsari na ka, dumǝna púp à nǝ̀ lakki agir'nggūrǝia, sǝ à nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka à nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:8" /><verse number="9" style="v" sid="LEV 15:9" />Sǝ koya gìr-do-anzǝm girkusǝu mana mǝnia yì mǝ pùr mùrgìr a ɓate do amurí ka, yì gìr-do-anzǝm girkusǝu ka nǝ̀ duk mǝɓeami. <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />Sǝ ɓwa mana kat je koyagir mana mǝnia yì ɓwa dumǝna amurí ka, nǝ̀ duk mǝɓeami ba pwarikpǝra. Sǝ ɓwa mana kat twal mǝno yì gir ka, dumǝna púp ɓwê nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:10" /><verse number="11" style="v" sid="LEV 15:11" />Ɓǝ̀ ɓwa mǝnana ndanǝ puro mala mùrgìr a ɓate ka je ɓeɓwa sǝ ak tadǝmba shèlǝ́ abui a mùr raka, mǝnia yì ɓwa à je ka dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nda aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />Sǝ ɓǝ̀ ɓwa mana mùrgìr kǝ puro a ɓate ka je koya nkwaring dǝɓang ngga, dumǝna púp à nǝ̀ arki nkwaringnì, sǝ koya kwar mana à shàrrì nǝ nggun sǝ ɓwê je ka, dumǝna púp à nǝ̀ shèlǝì a mùr.<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />&lt;&lt; &lt;Lang ɓwa mǝnana mùrgìr kǝ puro a ɓate ka kumǝna lakban arǝ puro mala mùrgìr a ɓate ka, nǝ̀ twal anongŋo tongno-nong-ɓari mala lakban male, nǝ̀ kùndǝô, pǝlǝa nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo aɓa mùr mgbeɗe, sǝ yi ka nǝ̀ ɓoarnsari. <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />Sǝ a tongno-nong-tàruià nongŋo ka, dumǝna púp nǝ̀ yinǝ akutugangyi ɓari ko akutumurǝm ɓari a ɓadǝm Yahweh, a bankutio aɓa Tara Ban-peri, sǝ nǝ̀ pè pǝris. <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />Pǝlǝa pǝris nǝ̀ pàɓoro nǝia; mwashat ka mala pàgir ace cauɓikea<note caller="+" style="f"><char style="fr" closed="false">15:15 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ a mǝsǝi 30.</char></note> na, sǝ man mwashat ka, mala pàgir mala pisǝe kǝring na. Sǝ pǝris nǝ̀ shawuɗi ɓwê a ɓadǝm Yahweh, ace puro mala mùrgìr male a ɓate.<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />&lt;&lt; &lt;Ɓǝ̀ ɓwabura sukkimùr arǝì ka, dumǝna púp nǝ̀ lak rǝì kat a mùr sǝ kat andǝ amani ka nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />Sǝ koya daura andǝ koya nggūgir mana mùrtaunî sùr amurí ka dumǝna púp à nǝ̀ lé nǝ mùr, sǝ kat andǝ amani ka, nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />Ɓǝ̀ ɓwabura nongnǝ ɓwama sǝ sukkimùr ka, dumǝna púp yia kǝm ngga à nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka, à nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra.<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />&lt;&lt; &lt;Lang mùrgìr kǝ puro a ɓata ɓwama, sǝ mùrgìrnî ka nkila na ka, dumǝna púp nǝ̀ ueo aɓa pǝndǝkya mala bumkwana male nongŋo tongno-nong-ɓari, sǝ ɓwa mǝnana kat je ɓwame ka, nǝ̀ duk mǝɓeami ba pwarikpǝra. <verse eid="LEV 15:19" /><verse number="20" style="v" sid="LEV 15:20" />Gìr mana kat ɓwame nongŋo amurí aɓa pǝndǝkya mala bumkwana male ka, gìrnî nǝ̀ duk mǝɓeami. Ɗǝm ngga gìr mǝnana kat yì ka do amurí ka nǝ̀ duk gìr'ɓeami.<verse eid="LEV 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 15:21" />&lt;&lt; &lt;Sǝ ɓwa mǝnana kat je gìr-nongŋo mala ɓwame ka, dumǝna púp ɓwê nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka ɓwê nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />Sǝ ɓwa mǝnana kat je koyagir mana mǝnia yì ɓwama do amurí ka, dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />Ko ɓǝ̀ gìr-nongŋo na, andǝ koyagir nani mǝnana ɓwame dumǝna amurí, sǝ ɓwa je ka, ɓwê nǝ̀ duk mǝɓeami ba pwarikpǝra. <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />Sǝ ɓǝ̀ koya ɓwabura nongnǝ man yì ɓwama, sǝ nkila mala bumkwana mala ɓwame sulǝ arǝì ka, ɓwabure nǝ̀ duk mǝɓeami anongŋo tongno-nong-ɓari. Sǝ koya gìr-nongŋo mǝnana ɓwabure nong amurí ka nǝ̀ duk gìr'ɓeami.<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />&lt;&lt; &lt;Ɓǝ̀ nkila kǝ ɓunno arǝ ɓwama sǝ twal anongŋo pas, sǝ pà aɓa pǝndǝkya bumkwana male raka, ko ana raka, ɓǝ̀ ɓunno mala nkila yàlî anongŋo mala pǝndǝkya bumkwana male ka, dumǝna púp nǝ̀ lidǝmba aɓa do-ɓeami aɓalǝ anongŋo mala ɓunno mala nkila mǝno ka kat. Yì ka, nǝ̀ duk mǝɓeami kǝla mana mǝɓeami na aɓa pǝndǝkya bumkwana male ka. <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />Koya gìr-nongŋo mǝnana ɓwame nong amurí, aɓalǝ anongŋo mala ɓunno mala nkila male ka, nǝ̀ dupi wi kǝla gìr-nongŋo mala pǝndǝkya bumkwana male. Sǝ komana kat do amurí ka nǝ̀ duk mǝɓeamî, kǝla mana nda aɓa do-ɓeami mala pǝndǝkya bumkwana male ka. <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />Ɓwa mǝnana kat je amǝnia yì agir ka, nǝ̀ duk mǝɓeamî, sǝ dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo a mùr, sǝ kat andǝ amani ka nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="LEV 15:27" /><verse number="28" style="v" sid="LEV 15:28" />Ɓǝ̀ ɓwame kumǝna lakban arǝ ɓunno mala nkila male ka, nǝ̀ twal anongŋo tongno-nong-ɓari nǝ̀ kùndǝô, sǝ anzǝm mǝno ka nǝ̀ ɓoarnsari. <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />Sǝ a tongno-nong-tàruià nongŋo ka, dumǝna púp nǝ̀ twal akutugangyi ɓari ko akutumurǝm ɓari sǝ nǝ̀ yinǝia aban pǝris a bankutio aɓa Tara Ban-peri. <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />Pǝlǝa pǝris nǝ̀ pàɓoro nǝia; mwashat ka ace pàgir mala gǝshi cauɓikea, sǝ man mwashat ka, ace pàgir mala pisǝe kǝring. Sǝ pǝris nǝ̀ shawuɗi ɓwame a ɓadǝm Yahweh, ace ɓunno mala nkila ɓeami male.<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />&lt;&lt; &lt;Anggo sǝ awu nǝ nunkir amǝ Isǝrayila ɓǝà yál rǝia arǝ do-ɓeami malea, ɓǝ̀ ana raka à nǝ̀ wú aɓa do-ɓeami malea, acemǝnana do-ɓeami malea nǝ̀ pǝndǝki Taragula mem mana nda aɓalǝia ka.&gt; &gt;&gt;<verse eid="LEV 15:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="LEV 15:32" />Mǝnia ka nda nggurcau ace ɓwabura mǝnana mùrgìr kǝ puro a ɓate, sǝ ace ɓwabura mana sukkimùr arǝì, mǝnana tsǝì pǝlǝ mǝɓeami ka; <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />ɗǝm ngga nda ace ɓwama mana kum rǝkwana nǝ bumkwana male ka, sǝ ace koyan, ɓwabura ko ɓwama, mana mùrgìr kǝ puro a ɓate ka, sǝ ace ɓwabura mǝnana nongnǝ ɓwama mana mǝɓeami na ka.<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">Pwari mǝgule mala shawuɗiban</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />Anzǝm lú mala amuna-burana ɓari mala Haruna, mana à wǔ acemǝnana à gbàshì ban Yahweh<note caller="+" style="f"><char style="fr" closed="false">16:1 </char><char style="fq" closed="false">à gbàshì ban Yahweh </char><char style="ft" closed="false">ko &lt;&lt;à pisǝ gìr-mǝ'rǝmɓoarne a ɓadǝm Yahweh, sǝ à kpatè kǝla mana Yahweh tsǝkia wia ka ɗàng.&gt;&gt;</char></note> sǝ Yahweh wal-luia ka, <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />Yahweh nacau nǝ Musa ama, &lt;&lt;Banggi mǝ'eambo Haruna ama ɓǝkǝa na ama nǝ̀ nggǝ yiu ɓàɓà ace kùtí aɓa ban mǝfele mana à gbàrì nǝ lagìr, a ɓadǝm buno sǝntǝ̀r mǝnana amur Akwati ka, ɗàng, ace mǝnana ɓǝkǝa wù raka. Mǝnia ka nda acemǝnana mǝ nǝ lǝmdǝ rǝàm aɓa pǝrɓang amur buno sǝntǝ̀r.<verse eid="LEV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 16:3" />&lt;&lt;Ani sǝ Haruna nǝ̀ kùtí aɓa ban mǝfele:<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="HEB 9:7">Ib 9:7</ref>,<ref loc="HEB 9:24-25">24-25</ref></char>.</note> Nǝ̀ yinǝ jamnda a domwan ace pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">16:3 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea&gt;&gt;; akani sǝ arǝ abân kat aɓa kùré mǝnia.</char></note> andǝ gam ace pàgir mala pisǝe kǝring. <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />Nǝ̀ sussǝ a mùr sǝ nǝ̀ oasǝ amǝnia yì adaura mǝfele ka; nǝ̀ oasǝ shiwan male mala nggubyau linǝn atè, nǝ̀ túr daura-ɓaɓalǝu mǝlime mala linǝn arǝì, nǝ̀ kùr bugìr mārǝ́ taɓunu mala linǝn, sǝ nǝ̀ mārǝ́ nggubyau mbuɓi múrû mala linǝn a múrí. <verse eid="LEV 16:4" /><verse number="5" style="v" sid="LEV 16:5" />Sǝ nǝ̀ ak agbato ɓari a bu ɓinala amǝ Isǝrayila, ace pàgir ace cauɓikea, sǝ gam mwashat ace pàgir mala pisǝe kǝring.<verse eid="LEV 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 16:6" />&lt;&lt;Haruna nǝ̀ pà gìr'nkila nǝ jamnda mǝnia ka ɓǝ̀ duk pàgir ace cauɓikea mala ɓamúrì, nǝ̀ shawuɗi ɓamúrì sǝ nǝ̀ shawuɗi ɓala male. <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />Pǝlǝa nǝ̀ twal agbato mǝnia ɓari ka, nǝ̀ tamsǝia a ɓadǝm Yahweh a bankutio aɓa Tara Ban-peri. <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />Sǝ Haruna nǝ̀ bwal-shishar amur agbato man ɓari ka ace súrǝ̀ mǝye na ateà nda ace Yahweh sǝ mǝye na ace Azazel.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fq" closed="false">Azazel </char><char style="ft" closed="false">ka nda &lt;&lt;mbul mǝ'múrɓikea&gt;&gt;, ko &lt;&lt;mbul mana nǝ̀ o a njenza a ban mǝkwane andǝ mala tanni&gt;&gt;, ko &lt;&lt;kukwar-mbul&gt;&gt;; anggo gbal a mǝsǝì 10, 26. </char></note> <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />Haruna nǝ̀ yinǝ gbato mana bwal-shishar lǝmdǝ ama nda ace Yahweh ka, sǝ nǝ̀ pà gìr'nkila nǝi ɓǝ̀ duk pàgir ace cauɓikea. <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />Sǝ gbato mǝnana bwal-shishar lǝmdǝ ama nda ace Azazel ka, à nǝ̀ yinǝi andǝamǝsǝì a ɓadǝm Yahweh ace shawuɗiban amurí, ace mǝnana à nǝ̀ tasǝte ɓǝ̀ o a njenza a Azazel ka.<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />&lt;&lt;Haruna nǝ̀ pà gìr'nkila nǝ jamnda mǝnia ka ɓǝ̀ duk pàgir ace cauɓikea ace ɓamúrì, nǝ̀ shawuɗi ɓamúrì, sǝ nǝ̀ shawuɗi ɓala male. Nǝ̀ pwan-myal jamnda mǝnia ka ɓǝ̀ duk pàgir ace cauɓikea ace ɓamúrì. <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />Sǝ nǝ̀ twal tasau-bǝsa, nǝ̀ lùmsǝì nǝ nkalang bǝsa mana ɗàrǝ́ atà gyangŋan mana came a ɓadǝm Yahweh ka. Sǝ nǝ̀ ɗàrǝ́ muku-gìr loasǝ yele mǝ'rǝmɓoarne mǝnana à goe lǝkǝt-lǝkǝt ka, ɓǝ̀ lùmsǝ ɓabui ɓari, sǝ nǝ̀ kùtí nǝi aɓa Ban Nggea Mǝfele anzǝm lagir. <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />Yì ka nǝ̀ so mǝnia yì muku-gìr loasǝ yele mǝ'rǝmɓoarne ka a bǝsa a ɓadǝm Yahweh, ace mǝnana ɓǝ̀ pǝrɓang mala yele muku-gìr mǝ'rǝmɓoarne ɓǝ̀ gìr múr buno sǝntǝ̀r mana amur Akwati mala Acau-nakûn ngga. Ɓǝ̀ pè anggo raka nǝ̀ wú àkǝ̀ banì. <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />Sǝ nǝ̀ ɗàrǝa aɓa nkila mala jamnda, nǝ̀ watsǝki nǝ munabuì amúr buno sǝntǝ̀r, a buì mǝnana sǝn njar-takuli ka; sǝ nǝ̀ ɗàrǝ́ nkile ɗǝm nǝ̀ watsǝki nǝ munabuì a ɓadǝm buno sǝntǝ̀r kusǝ tongno-nong-ɓari. <figure style="fig" alt="High priest with incense altar" file="hk00260c.tif" size="col" loc="16:14" copy="Knowles and Brass Images" ref="16:1-14">Pǝris mǝgule andǝ gyangŋan mala loasǝ yele mǝ'rǝmɓoarne</figure><verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />&lt;&lt;Pǝlǝa nǝ̀ pwan-myal gbato mala pàgir ace acauɓikea mana nda ace aɓwana ka, sǝ nǝ̀ kùtí nǝ nkile aɓa Ban Nggea Mǝfele anzǝm lagìr. Akano ka nǝ̀ ɗàrǝa aɓa nkile sǝ nǝ̀ watsǝki amur buno sǝntǝ̀r sǝ a ɓadǝmbi, kǝla mǝnana pàngnǝ nkila mala jamnda ka. <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />Anggo sǝ nǝ̀ shawuɗi Ban Mǝfele, atàcau mala do-ɓeami mala amǝ Isǝrayila, sǝ ace akpakpak andǝ acauɓikea malea kat. Anggo gbal sǝ nǝ̀ pǎ ace Tara Ban-peri, mǝnana ndakam aɓalǝia aɓa do-ɓeami malea ka. <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />Kǝɓwa pà nǝ̀ pàk kàm aɓa Tara Ban-peri twal a bu-pwari mana Haruna kùtí nǝi ace shawuɗiban aɓa Ban Nggea Mǝfele ka ɗàng ba puro male; she ɓǝ̀ malǝna shawuɗiban ace ɓamúrì, sǝ ace ɓala male, sǝ ace ɓwabundǝa mala Isǝrayila kat mana ram ngga. <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />Sǝ nǝ̀ pur aban gyangŋan mana nda a ɓadǝm Yahweh ka, nǝ̀ shawuɗi, sǝ nǝ̀ ɗàrǝ́ aɓa nkila mala jamnda, sǝ aɓa nkila mala gbato mǝno ka, nǝ̀ hasǝki arǝ anjawe mala gyangŋan a koya buban. <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />Sǝ nǝ̀ ɗàrǝ́ aɓa nkila mǝno, nǝ̀ watsǝki amur gyangŋan nǝ munabui kusǝ tongno-nong-ɓari; anggo ka nǝ̀ lé sǝ nǝ̀ tàrì arǝ ado-ɓeami mala amǝ Isǝrayila.<verse eid="LEV 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />&lt;&lt;Anzǝm mǝnana Haruna malǝna shawuɗiban ace Ban Mǝfele, andǝ Tara Ban-peri, andǝ gyangŋan ngga, nǝ̀ yinǝ gbato mǝnana nǝyilǝmu ka. <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />Sǝ yì ka nǝ̀ nongsǝ abui kǝm a ɓamúr gbato man nǝyilǝmu ka, sǝ nǝ̀ bang aɓealɓikea mala amǝ Isǝrayila kat amurí, andǝ akpakpak malea kat, andǝ acauɓikea malea kat. Anggo sǝ nǝ̀ tsǝk acauɓikea mala amǝ Isǝrayila a ɓamúr gbato man, sǝ nǝ̀ tasǝte ɓǝ̀ o, sǝ ɓeɓwa mǝnana à twali ace túrè ka, nǝ̀ pǝrte aban ká a njenza. <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />Gbato man nǝ̀ twal twalo mala aɓealɓikea mala amǝ Isǝrayila kat a múrí, nǝ̀ kánǝia kuko a ban mǝnana là pà kàm tù raka, sǝ ɓwa mǝno ka nǝ̀ ɗeki ɓǝ̀ o atàrǝì a bondo.<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />&lt;&lt;Pǝlǝa Haruna nǝ̀ kùtí aɓa Tara Ban-peri, nǝ̀ swár adaura nggubyau linǝn mǝnana oasǝ arǝì lang kútí a Ban Mǝfele ka, sǝ nǝ̀ ɗekia kano. <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />Sǝ yi ka nǝ̀ sussǝ nǝ mùr a ban mǝfele, sǝ nǝ̀ oasǝ agir-nggūrǝu male; pǝlǝa nǝ̀ puro sǝ nǝ̀ pà pàgir mala pisǝe kǝring ace ɓamúrì, sǝ nǝ̀ pà mana nda ace aɓwana ka; nǝ̀ shawuɗì ɓamúrì sǝ nǝ̀ shawuɗì aɓwana. <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />Sǝ nǝ̀ pisǝ mùrú-nyama mala pàgir mala pisǝe kǝring amur gyangŋan. <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />Sǝ ɓwa mǝno nying gbato mǝno ɓǝ̀ o aban Azazel ka nǝ̀ lákkí agir'nggūrǝì, sǝ nǝ̀ sussǝ nǝ mùr, sǝ anzǝm mǝno ka nǝ̀ gandǝ yiu aɓa kàttì. <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />Sǝ jamnda andǝ gbato mana à pàna gìr'nkila nǝia kǝla pàgir ace cauɓikea, mǝnana nkilea ka, à yinǝi ace shawuɗiban aɓa Ban Mǝfele ka, à nǝ̀ kánǝia anzǝm kàttì. Nyamia, andǝ nggūia, andǝ ciutea ka, à nǝ̀ pisǝia nǝ bǝsa. <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />Sǝ ɓwa mǝnana pisǝia ka, nǝ̀ lak agir'nggūrǝì, sǝ nǝ̀ sussǝ nǝ mùr, sǝ nǝnzǝ́mò ka nǝ̀ gandǝ kútí aɓa kàttì.<verse eid="LEV 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />&lt;&lt;Mǝnia ka nǝ̀ duk nggurcau aban wun tàtǝ́k, ama a lumia pwari mala tongno-nong-ɓaria zongŋo ka, dumǝna púp ama amǝ Isǝrayila andǝ abǝri mana à ndanǝdo aɓalǝia ka, à nǝ̀ gilmùr sǝ à pà nǝ̀ pàk kǝ túró ɗang. <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />A man yì pwari ka, à nǝ̀ shawuɗi wun ace lak wun. À nǝ̀ lak wun arǝ acauɓikea ma'wun kat ace mǝnana ɓǝ̀ wu ɓoarnsari a ɓadǝm Yahweh ka. <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />Mǝnia yì pwari ka, pwari mala usǝlǝo na kat-kat aban wun kǝla pwari Sabbat, sǝ aɓalǝi ka, wun nǝ̀ ginǝì ɓamur rǝ wun agir; nggurcau na tàtǝ́k. <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />Sǝ pǝris mǝnana à ɗārǝi sǝ à tàrì ɓǝ̀ duk pǝris a kunì tárrí ka, nda mǝnana nǝ̀ shawuɗiban ngga. Nǝ̀ oasǝ adaura mǝfele mala nggubyau linǝn arǝì. <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />Nǝ̀ shawuɗi Ban Nggea Mǝfele, andǝ Tara Ban-peri, andǝ gyangŋan, sǝ nǝ̀ shawuɗi apǝris andǝ ɓwabundǝa mana ram ngga kat. <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />Mǝnia ka nǝ̀ duk nggurcau ace wun tàtǝ́k, ama à nǝ̀ shawuɗi amǝ Isǝrayila kusǝ mwashat a pǝlǝa, atàcau mala acauɓikea malea kat.&gt;&gt;</para>
  <para style="m" vid="LEV 16:34">Sǝ Haruna pè kǝla mana Yahweh banggi Musa ka.<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s">Pà gìr'nkila a ban mana à pǝrban arǝì ka</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />&lt;&lt;Banggi Haruna andǝ amuna-burana male, andǝ amǝ Isǝrayila kat, ama, Mǝnia ka nda nzongcau mana Yahweh pà ka. <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />Ɓǝ̀ kǝɓwa a tàu mala Isǝrayila wal ndǎ, ko nzur, ko mbulpǝndǝa aɓa kàttì, ko pwan-myali anzǝm kàttì, <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />sǝ yinǝi a bankutio aɓa Tara Ban-peri nǝ̀ pà ɓoro nǝi abanam Yahweh, a ɓadǝm Taragula mem Yahweh raka, bafe mala sukki'nkila nǝ̀ sulǝo amur ɓwê. Man yi ɓwa ka sukkina nkila, sǝ ɓwê ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />Tǝ́r mǝnia yì nzongcau ka nda mǝnana ama, agir'nkila mala amǝ Isǝrayila mana à kǝ̀ pana gìr'nkila nǝia a patal ka, ɓǝà yinǝia abanam Yahweh, aban pǝris a bankutio aɓa Tara Ban-peri, sǝ ɓǝà pà gìr'nkila nǝia kǝla agir'nkila mala apagir ace dotarǝu abanam Yahweh. <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />Sǝ pǝris nǝ̀ tàkki nkile amur gyangŋan mem Yahweh a bankutio aɓa Tara Ban-peri, sǝ nǝ̀ pisǝ mùruí ace pà rǝmban mǝɓoarne mana nǝ̀ pwasǝbumam Yahweh ka. <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />Anggo ka, à pà nǝ̀ nyare à nǝ̀ pà agir'nkila malea ɗǝm aban akukwar-mbul ɗàng, akukwar-mbul mǝnana à kutina aɓa nongginǝ-rǝarǝu andǝia ka.<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">nongginǝ-rǝarǝu andǝia ka </char><char style="ft" closed="false">ko &lt;&lt;pàk cauɓikea arǝàm nǝ kpata aɓakuli malea.&gt;&gt;</char></note> Mǝnia ka nǝ̀ duk nggurcau tàtǝ́k acea arǝ ado'nza malea kat.<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />&lt;&lt;Sǝ wu nea wia ama, koya ɓwa a tàu mala Isǝrayila, ko atà abǝri mǝnana à ndanǝdo aɓalǝia, mǝnana pàgir mala pisǝe kǝring, ko pà gìr'nkila, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />sǝ yinǝi a bankutio aɓa Tara Ban-peri, ace pagìr nǝi abanam Yahweh raka, man yì ɓwa ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng.<verse eid="LEV 17:9" /></para>
  <para style="s">Nggurcau mala pǝrban arǝ lî nkila</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />&lt;&lt;Ɓǝ̀ kǝɓwa a tàu mala Isǝrayila, ko atà abǝri mǝnana à ndanǝdo aɓalǝia, lì koya nkila ka, Mim Yahweh ka, mǝ nǝ twalî man yì ɓwa ka ɓamǝsǝam, sǝ à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />Mǝnia ka nda acemǝnana yilǝmi koya gìr mana ndanǝ yilǝmu ka, nda aɓa nkila. Sǝ ǝn pana wun nkila mala agirkusǝu ace shawuɗi ayilǝmi wun amur gyangŋan. Nkila ka yilǝmu na, sǝ kǝ lak cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="fq" closed="false">Nkila ka yilǝmu na, sǝ kǝ lak cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;Nkila, kǝla yilǝmu ka, nda mǝnana kǝ shawuɗiban ngga.&gt;&gt;</char></note><note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 26:28">Mat 26:28</ref>; <ref loc="MRK 14:24">Mar 14:24</ref>; <ref loc="ROM 3:25">Rom 3:25</ref>; <ref loc="ROM 5:9">5:9</ref>; <ref loc="EPH 1:7">Afi 1:7</ref>; <ref loc="COL 1:14">Kol 1:14</ref>,<ref loc="COL 1:20">20</ref>; <ref loc="HEB 13:12">Ib 13:12</ref>; <ref loc="1JN 1:7">1Yoh 1:7</ref>; <ref loc="REV 1:5">Sǝn 1:5</ref></char>.</note> <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />Acemani ka, ǝn bángŋǝ́nì amǝ Isǝrayila nǝma, kǝɓwa pà kàm atà wun, ko ɓekǝ bǝri mana ndanǝdo aɓalǝ wun, mana nǝ̀ lì nkila ka ɗàng.<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />&lt;&lt;Sǝ koya ɓwa Isǝrayila, ko bǝri mana ndanǝdo aɓalǝia, mǝnana pur ɓombo, sǝ bwal nyama ko nyal, mǝnana mǝɓoarne na à nǝ̀ lì ka, dumǝna púp nǝ̀ ɗārǝ́ nkile sǝ nǝ̀ gìrì nǝ nzali. <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />Yilǝmi koya gìr mana ndanǝ yilǝmu ka, nda aɓa nkile: nkile nda yilǝmi. Acemani ka, ǝn bángŋǝ́nì amǝ Isǝrayila nǝma, Pà wu nǝ̀ lì nkila mala ɓekǝ gir-yilǝmu ɗang, acemǝnana yilǝmi koya gir-yilǝmu ka, nda nkile. Ɓwa mǝnana kat lì nkila ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 17:14" /><verse number="15" style="v" sid="LEV 17:15" />Sǝ koya ɓwa Isǝrayila ko bǝri, mǝnana lì girkusǝu mǝnana wuna atàrǝì ko anyamɓikea wal-lui ka, dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝ a mùr, sǝ kat andǝ amani ka, nda aɓa do-ɓeami ba kpa mala pwari. <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />Sǝ ɓǝ̀ lakkia ɗàng, ko sussǝ rǝì raka, nǝ̀ twal twalo mala ɓealɓikea male.&gt;&gt;<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s">Nongnǝban mǝnana à pǝrban arǝì ka</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />&lt;&lt;Banggi amǝ Isǝrayila ama, &lt;Mǝ nda Yahweh Ɓakuli ma'wun. <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />Pà wun nǝ̀ pàk kǝla mǝnana à pàkkiyi a nzali Masar, ban mana wu duk kam ɗiɗyal ka ɗàng, sǝ pà wun nǝ̀ pàk kǝla mǝnana à pàkkiyi a nzali Kan'ana, mǝnana ado mǝ nǝ kánǝ wun kàm ngga ɗàng. Pà wun nǝ̀ kpata akúncau malea ɗàng.<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 18:9-12">Nggur 18:9-12</ref></char>.</note> <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />Wun ngga, wun nǝ̀ kpata anzongcau mem sǝ wun nǝ̀ bwal anê mem. Mǝ nda Yahweh Ɓakuli ma'wun. <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />Wu bwal anê andǝ anzongcau mem; ɓǝ̀ ɓwa kǝ peǎ ka, nǝ̀ kum auwa nǝ bania. Mǝ nda Yahweh.<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />&lt;&lt; &lt;Kǝɓwa atà wun ɓǝ̀kǝa gbàshìban ɓekǝ ɓǝla male ama nǝ̀ nongnǝi ɗàng. Mǝ nda Yahweh. <verse eid="LEV 18:6" /><verse number="7" style="v" sid="LEV 18:7" />Kǝa pè tárró kǝsǝkya nǝ nongnǝ nggo ɗàng; yì ka nggo na, acemani ka, a pà wunǝ pe wi kǝsǝkya ɗàng. <verse eid="LEV 18:7" /><verse number="8" style="v" sid="LEV 18:8" />A pà wunǝ nongnǝ mālá tárró ɗàng; anggo ka a panì tárró kǝsǝkya. <verse eid="LEV 18:8" /><verse number="9" style="v" sid="LEV 18:9" />A pà wunǝ nongnǝ mǝ'nggauleo, nsarile tárró ko nsarile nggò ɗàng, ko yì ka gul a ɓala ma'wun ko a ɓè ɓala. <verse eid="LEV 18:9" /><verse number="10" style="v" sid="LEV 18:10" />A pà wunǝ nongnǝ nsari mala muna-ɓwabura mô ko nsari mala muna-ɓwama mô ɗàng, acemǝnana yià ka amǝɓala mò na. <verse eid="LEV 18:10" /><verse number="11" style="v" sid="LEV 18:11" />A pà wunǝ nongnǝ nsari mala mālá tárró, mana gul a ɓala mala tárró ka ɗàng, acemǝnana yì ka mǝ'nggauleo na. <verse eid="LEV 18:11" /><verse number="12" style="v" sid="LEV 18:12" />A pà wunǝ nongnǝ mǝ'nggaula tárró ɗàng; yì ka ɓǝla mala tárró na. <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />A pà wunǝ nongnǝ mǝ'nggaula nggò ɗàng, acemǝnana yì ka ɓǝla mala nggò na. <verse eid="LEV 18:13" /><verse number="14" style="v" sid="LEV 18:14" />A pà wunǝ pe mǝ'eam tárró kǝsǝkya nǝ gbàshìban māmí ama awu nǝ nongnǝi ɗàng; yì ka nggò na. <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />A pà wunǝ nongnǝ nkilo muna-ɓwama ɗàng;<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa</char><char style="xt"><ref loc="GEN 38:16">Tite 38:16</ref>; <ref loc="LEV 20:12">Pǝris 20:12</ref>; <ref loc="EZK 22:11">Ezǝk 22:11</ref></char>.</note> yì ka mālá munio na. <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />A pà wunǝ nongnǝ mālá mǝ'eambo ɗàng, acemǝnana yì ka nda a ɓala mala mǝ'eambo. <verse eid="LEV 18:16" /><verse number="17" style="v" sid="LEV 18:17" />A pà wunǝ nongnǝ ɓwama andǝ muna-ɓwama male ɗàng; sǝ a pà nǝ al mǝkè muna-ɓwama ɗàng, acemǝnana yià ka aɓǝla na; pě mǝno anggo ka ɓealɓana na. <verse eid="LEV 18:17" /><verse number="18" style="v" sid="LEV 18:18" />Sǝ a pà wunǝ twal ɓwama ɓǝ̀ duk ɓimama mala mǝ'eambi, a nǝ nongnǝi sǝ yì mǝ'eambi ka ndakam nǝyilǝmi ɗàng.<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />&lt;&lt; &lt;A pà wunǝ nongnǝ ɓwama mana nda aɓa pǝndǝkya mala bumkwana male ka ɗàng. <verse eid="LEV 18:19" /><verse number="20" style="v" sid="LEV 18:20" />Sǝ a pà wunǝ nongnǝ mālá ɓio mǝ'murkala, wu pǝndǝki ɓamurò nǝi ɗàng.<verse eid="LEV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21" />&lt;&lt; &lt;A pà wunǝ pa komǝye na atà amunio kǝla pagìr aban Molek ɗàng.<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 20:2-5">Pǝris 20:2-5</ref>; <ref loc="DEU 18:10">Nggur 18:10</ref>; <ref loc="1KI 11:7">1Amur 11:7</ref>; <ref loc="2KI 23:10">2Amur 23:10</ref>; <ref loc="JER 32:35">Ir 32:35</ref>; <ref loc="ACT 7:43">Atúró 7:43</ref></char>.</note> Kǝa pǝndǝkice lullǝ Ɓakuli mô ɗàng; Mǝ nda Yahweh. <verse eid="LEV 18:21" /><verse number="22" style="v" sid="LEV 18:22" />Ɓwabura andǝ ɓwabura pa nǝ̀ nongnǝ rǝarǝia kǝla mana ɓwabura nǝ̀ nongnǝ ɓwama ka ɗàng;<note caller="+" style="f"><char style="fr" closed="false">18:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 19:5">Tite 19:5</ref>; <ref loc="LEV 20:13">Pǝris 20:13</ref>; <ref loc="DEU 23:18">Nggur 23:18</ref>; <ref loc="ROM 1:26-27">Rom 1:26-27</ref>; <ref loc="1CO 6:9-11">1Kor 6:9-11</ref>; <ref loc="GAL 5:21">Gal 5:21</ref>; <ref loc="1TI 1:10">1Tim 1:10</ref>; <ref loc="REV 21:8">Sǝn 21:8</ref></char>.</note> mǝnia ka gìr'ɓeami na. <verse eid="LEV 18:22" /><verse number="23" style="v" sid="LEV 18:23" />A pà wunǝ nongnǝ girkusǝu, wu pǝndǝki ɓamúrò nǝi ɗàng, sǝ kǝ ɓwama ɓǝkǝa pà ɓamúrì aban girkusǝu ɓǝ̀ eauwi ɗàng; mǝno ka pǝlǝmúr-gìr na.<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />&lt;&lt; &lt;Wu kǝa pǝndǝki ɓamur rǝ wun nǝ kǝ mǝye atà pakkiagir mǝnia ka ɗàng, acemǝnana aɓwapǝndǝa mala anzali mǝnana ǝn nggǝ pǝria ɓǝà nyingga wun ban ngga, à pǝndǝkina ɓamuria nǝ pakki agir ɓeami mǝnia ka. <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />Sǝ acemǝnana nzali kat pǝndǝkina ka,<note caller="+" style="f"><char style="fr" closed="false">18:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 35:33-34">Ɓal 35:33-34</ref>; <ref loc="DEU 9:4">Nggur 9:4</ref>; <ref loc="EZR 9:11">Ezr 9:11</ref>; <ref loc="ISA 24:5-6">Isha 24:5-6</ref>; <ref loc="JER 2:7">Ir 2:7</ref></char>.</note> mǝ nǝ yinǝ ɓashi amur cauɓikea male, sǝ nzali ka nǝ̀ ukki aɓwana mǝnana aɓalǝi ka. <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />Sǝama wun ngga, wun nǝ̀ kpata anggurcau andǝ anê mem, sǝ pà wun nǝ̀ pàk komǝye atà amǝno yì agir ɓeami ka ɗàng, ko ɓwa mǝnana à ɓǝli ɓwa Isǝrayila na ko ɓwa kúnɗàngna na ka. <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />(Aɓwana mǝnana à akdǝmba do a nzali mǝnana mǝ nǝ kánǝ wun kàm ngga, anggo sǝ à pàkki amǝno yì agir ɓeami kat ka, sǝ nzalinì pǝndǝkya). <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />Acemani ka, wu kǝa pǝndǝki nzalinì mǝnana nǝ̀ tsǝa nǝ̀ ukki wun kǝla mana ukki aɓwana mǝnana à ndanǝdo kàm ado ka ɗàng. <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />Ɓwa mǝnana kat pàk komǝye na atà agir'ɓeami mǝno ka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />Acemani ka, wu bwal kwarkiru mem, wu kǝa kútí a pàk kǝɓè atà agirɓana mala akúncau malea mǝnana à pàkkiyi a ɓadǝm wun ngga ɗàng, sǝ wu kǝa eare wu pǝndǝki ɓamur rǝ wun nǝia ɗàng: Mǝ nda Yahweh Ɓakuli ma'wun.&gt; &gt;&gt;<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s">Anggurcau mala domǝfele andǝ ɓashi-mǝsǝcau</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />&lt;&lt;Banggi amǝ Isǝrayila kat a ɓinalea ama, &lt;Dumǝna púp wun nǝ̀ dukdo mǝfele, acemǝnana Mim Yahweh Ɓakuli ma'wun ngga mǝ nda mǝfele.<verse eid="LEV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3" />&lt;&lt; &lt;Koyan atà wun ngga nǝ̀ pà gulo aban nggé andǝ tárrí, sǝ wun nǝ̀ kpata nzongcau mala Pwari Sabbat, pwari usǝlǝo mem: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4" />&lt;&lt; &lt;Cè wu pǝlǝa aban kpata ankúl, ko wu pàkkî ɓamur rǝ wun ɓekǝ ɓakuli mǝnana à tùllì nǝ bolo-ntùl ka ɗàng: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />&lt;&lt; &lt;Lang wun nǝ̀ pà gìr'nkila mala apagir ace dotarǝu abanam Yahweh ka, wu pè pepè ace mǝnana ɓǝ̀ wu kum â aban Ɓakuli ka. <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />Dumǝna púp ama mǝnia yì gìr'nkila ka, wun nǝ̀ lì a pwari mǝnana à pànàɓoro nǝi ka, ko ɓè pwari mana kpate ka, sǝ ɓǝ̀ ɓekǝ gìr ueo aɓalǝi, bà tàruià pwari ka, dumǝna púp wun nǝ̀ pisǝì kǝring a bǝsa. <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />Ɓǝ̀ wu lì ɓekǝ bare gìr'nkilè a tàruià pwari ka, pǝndǝkina; pà nǝ̀ kum â aban Ɓakuli ɗǝm ɗàng. <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />Ɓwa mǝnana kat lì ka, bafe mala cauɓikea male nǝ̀ do amurí, acemǝnana pǝndǝkinace gìr mǝnana à pànì abanam, Mim Yahweh ka, sǝ mǝno yì ɓwa ka à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng.<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />&lt;&lt; &lt;Lang wun nǝ̀ pwàn agirɓaban mǝnana à ɓǝl aɓa nzali ma'wun ngga, wu kǝa pwàn gìr kat-kat ɓǝ̀ kya bwal masǝlǝata kún aɓaban ma'wun ɗàng, sǝ pà wu nǝ̀ nyar aban ká alta ɓakurikuri anzǝm pwan-gìrɓaban ɗang. <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />Pà wu nǝ̀ tùki aɓǝlanggun anap kat arǝ aɓaban mala anggun-anap ma'wun ɗàng, sǝ pà wu nǝ̀ tàrki amǝnana à sukki a nzali ka ɗàng; wu nyia ace amǝ'tǝ̀r andǝ abǝri: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />&lt;&lt; &lt;Pà wu nǝ̀ iun'i ɗang; pà wu nǝ̀ pàkgìr aɓa ɓosǝkiban ɗang; pà wu nǝ̀ ne arǝwun nyir ɗang. <verse eid="LEV 19:11" /><verse number="12" style="v" sid="LEV 19:12" />Pà wu nǝ̀ kángìr nǝ lullǝàm aɓa nyir ɗang, mǝnana nǝ̀ tsǝa wun nǝ̀ pǝndǝkice lullǝ Ɓakuli ma'wun ngga:<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:7">Pur 20:7</ref>; <ref loc="LEV 18:21">Pǝris 18:21</ref>; <ref loc="LEV 20:3">20:3</ref>; <ref loc="MAL 3:5">Mal 3:5</ref>; <ref loc="JAS 5:12">Jem 5:12</ref></char>.</note> Mǝ nda Yahweh.<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />&lt;&lt; &lt;A pà wu nǝ tǝpǝri ɓio mǝ'murkala, ko awu nǝ ak gìr male arǝì ɗàng. Tangnakusǝu mala amǝ'túró-boalo ka, a pà wu nǝ bwali a buo aɓa dù kat bà kwaro mala ban ɗang.<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAL 3:5">Mal 3:5</ref>; <ref loc="JAS 5:4">Jem 5:4</ref></char>.</note> <verse eid="LEV 19:13" /><verse number="14" style="v" sid="LEV 19:14" />A pà wu nǝ sáng mǝkir'ara, ko awu nǝ tsǝk gìr-annda a ɓadǝm nte ɗang. Ɓanggî Ɓakuli mô: Mǝ nda Yahweh.<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />&lt;&lt; &lt;Dum nǝ ɓafo andǝ kpata mǝsǝcau aɓa pàk ɓashi: a pà wunǝ lǝmdǝ tàrbân arǝ mǝ'tǝ̀r, ko pagulo arǝ mǝkume ɗàng. Dumǝna púp awu nǝ pàk ɓashi mala aɓio aɓwana mala nzali ma'wun nǝ ɓealɓoarna. <verse eid="LEV 19:15" /><verse number="16" style="v" sid="LEV 19:16" />A pà wunǝ duk ɓwa mǝ̀ ká andǝ nyare aɓalǝ aɓwana mô nǝ acau kiɗikiɓwa ɗàng. <note caller="+" style="f"><char style="fr" closed="false">19:16 </char><char style="ft" closed="false">Ko </char><char style="fqa">Kǝa nakun mǝ'nyirì amur ɓio ɓwa Isǝrayila, mǝnana nǝ̀ tsǝa à nǝ̀ kasǝi wi ɓashi-lú a ndàɓashi ka ɗàng </char>.</note>Kǝa cam ɗǝong sǝ yilǝmi ɓio mǝ'murkala na aɓa ká-mǝɓane mala lú ɗàng: Mǝ nda Yahweh.<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />&lt;&lt; &lt;A pà wu nǝ ɓinǝmǝsǝ mǝ'eambo a ɓabumo ɗàng. Awu nǝ gim ɓio mǝ'murkala a ɓamǝsǝi nǝ banggi wi mǝsǝcau, ɓǝ̀ ana raka awu nǝ nunbi ɓamurò bafe mala cauɓikea male. <verse eid="LEV 19:17" /><verse number="18" style="v" sid="LEV 19:18" />Kǝa nyesǝì ɓwa gìr mǝɓane a kúnì mǝɓane ɗàng,<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 32:35">Nggur 32:35</ref>,<ref loc="DEU 32:41">41</ref>; <ref loc="PRO 20:22">Pas 20:22</ref>; <ref loc="ROM 12:17">Rom 12:17</ref>,<ref loc="ROM 12:19">19</ref>; <ref loc="HEB 10:30">Ib 10:30</ref>; <ref loc="REV 19:2">Sǝn 19:2</ref></char>.</note> sǝ a pà wunǝ bwal bumlulla a bumo arǝ kǝɓwa a ɓinado mala aɓwana ma'wun ɗàng; a kún mani ka awu nǝ earce ɓio mǝ'murkala kǝla mana a earce ɓamurò ka:<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PRO 17:17">Pas 17:17</ref>; <ref loc="MAT 5:43-45">Mat 5:43-45</ref>; <ref loc="MAT 22:39">22:39</ref>; <ref loc="MRK 12:31">Mar 12:31</ref>; <ref loc="LUK 10:27">Luk 10:27</ref>; <ref loc="ROM 13:9">Rom 13:9</ref>; <ref loc="GAL 5:14">Gal 5:14</ref>; <ref loc="JAS 2:8">Jem 2:8</ref></char>.</note> Mǝ nda Yahweh. <verse eid="LEV 19:18" /><verse number="19" style="v" sid="LEV 19:19" />Dumǝna púp wun nǝ̀ bwal anê mem. Wu kǝa tsǝk agirkusǝu ma'wun, mǝnana à pà ɓǝle mwashat raka ɓǝà eau rǝia ɗàng; a pà wu nǝ ɓeal a'ulang amǝsǝɓeale ɓari a ɓaban mô ɗàng; a pà wu nǝ oasǝ daura mǝnana à tè nǝ ankonggúr ulangnì ɓari ka ɗàng.<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />&lt;&lt; &lt;Ɓǝ̀ kǝ ɓwabura nongnǝ ɓwama guro mǝnana ɓeɓwa pùrnamurí nǝ̀ ali, sǝ à malaká akmúrí ko à nyi ɓǝ̀ kum ɓamúrì raka, dumǝna púp ama ɓwabura man nǝ̀ mbwegìr. Sǝama à pà nǝ̀ kasǝ ɓashi mala wal-luia ɗàng acemǝnana yì ɓwama guro ka, malaká kum panzǝban male ɗàng. <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />Sǝama dumǝna púp ɓwabure nǝ̀ yinǝ gam ace pagìr male mala mbwegìr ace kumcau, abanam Yahweh, a bankutio aɓa Tara Ban-peri. <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />Sǝ pǝris nǝ̀ shawuɗì nǝ gam mala pagìr male mala mbwegìr ace kumcau, a ɓadǝm Yahweh, ace cauɓikea male mana pàk ka, sǝ à nǝ̀ twalîbanì.<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />&lt;&lt; &lt;Lang wu yina aɓa nzali Kan'ana sǝ wu pandǝna koya ulang nggun ace girlina ka, dumǝna púp ama ɓǝla-nggunì ka wun nǝ̀ nyesǝì kǝla gìr na mǝnana à pǝrban arǝì ka; wun nǝ̀ twal apǝlǝa tàrú, nǝ̀ dupa wun gìr'ɓeami na; pà wu nǝ̀ lì ɗàng. <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />A inea pǝlǝa ka, wun nǝ̀ tàr aɓǝla-nggunì kat ɓǝà duk paɓoro aban Ɓakuli, ace lǝmdǝ yàwá ma'wun abanam,<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="fq" closed="false">ace lǝmdǝ yàwá ma'wun abanam </char><char style="ft" closed="false">ko &lt;&lt;ace ɓwangsǝam.&gt;&gt;</char></note> Mim Yahweh. <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />A tongnoia pǝlǝa ka, wun nǝ̀ gandǝ li ɓǝla-nggunì. Ɓǝ̀ wu kpata nzongcau mǝnia anggo ka, pàɓǝle mala anggunì nǝ̀ hatǝki ace wun: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />&lt;&lt; &lt;Cè wu lì kǝ̀ nyama nǝ nkile arǝì ɗàng.</para>
  <para style="p" vid="LEV 19:26">&lt;&lt; &lt;Pà wun nǝ̀ kùtí a pàkkiagir mala ɓángnǝ́'ɓángna ko mala sǝ̀lǝ̀ɓǝla ɗàng.<note caller="+" style="f"><char style="fr" closed="false">19:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 18:10">Nggur 18:10</ref>,<ref loc="DEU 18:14">14</ref>; <ref loc="2KI 21:6">2Amur 21:6</ref>; <ref loc="2CH 33:6">2Acau 33:6</ref>; <ref loc="ISA 2:6">Isha 2:6</ref>; <ref loc="ISA 57:3">57:3</ref>; <ref loc="JER 27:9">Ir 27:9</ref></char>.</note><verse eid="LEV 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27" />&lt;&lt; &lt;Pà wun nǝ̀ kasǝki nyang a takir wun, ko wun nǝ̀ mwa mbotokun wun ɗàng.<verse eid="LEV 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28" />&lt;&lt; &lt;Wu kǝa cangi rǝ wun ace alú, ko wun nǝ̀ tsǝk nyoulǝa arǝ wun ɗàng: Mǝ nda Yahweh.<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />&lt;&lt; &lt;Wu kǝa pǝndǝkice amuna-mamǝna ma'wun nǝ tasǝia ɓǝà duk amā-gyatarǝu<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">amā-gyatarǝu aɓalǝ anda-peri. </char></note> ɗàng, ɓǝ̀ ana raka nzali ma'wun nǝ̀ kpa aɓa gyatarǝu<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">gyatarǝu </char><char style="ft" closed="false">ko &lt;&lt;ɗwanyi domǝsǝcau aban Ɓakuli.&gt;&gt;</char></note> sǝ nǝ̀ lùmsǝ nǝ kìɗìkì.<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">kìɗìkì </char><char style="ft" closed="false">ko &lt;&lt;ɓealɓikea.&gt;&gt;</char></note><verse eid="LEV 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 19:30" />&lt;&lt; &lt;Wu bwal nzongcau mala Sabbat, yì pwari usǝlǝo mem, sǝ wu lǝmdǝ pagulo arǝ Tara-mǝfele mem.<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />&lt;&lt; &lt;Cè wu pǝlǝa wu kùtí a pàkkiagir mala amǝ'ɗikalú ko mala amǝ'nggár ɗàng; wu kǝa kútí a altea ɗàng. Ɓǝ̀ wu pàk ka, à nǝ̀ dupa wun gìr mǝnana nǝ̀ tsǝa wun nǝ̀ pǝndǝki ka: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />&lt;&lt; &lt;Wu gusǝlǝ akapana, wu pagulo aban aɓwana-mǝgule, sǝ wu ɓanggî Ɓakuli ma'wun: Mǝ nda Yahweh.<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />&lt;&lt; &lt;Lang bǝri yiu sǝ yi do atà wun aɓa nzali ma'wun ngga, wu kǝa pàkce-ɓà ɗàng. <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />Wu pàngnǝ bǝri mǝnana yiu a do aɓalǝ wun ngga kǝla mana wun nǝ̀ pàngnǝ ɓwa mǝnana à ɓǝli a nzali ma'wun ngga, sǝ awu nǝ earce kǝla mana a earce ɓamurò ka. Mǝnia ka nda acemǝnana wun ngga wu nda ka abǝri ɗiɗyal a nzali Masar;<note caller="+" style="f"><char style="fr" closed="false">19:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 23:9">Pur 23:9</ref>; <ref loc="LEV 18:3">Pǝris 18:3</ref>; <ref loc="DEU 10:19">Nggur 10:19</ref>; <ref loc="DEU 23:7">23:7</ref></char>.</note> Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />&lt;&lt; &lt;Kǝa ɓǝmbǝri kǝɓwa aɓa kārǝki gìr ɗàng; ko aɓa sauwa mala gìr na, ko aɓa dǝmbǝrya mala gìr na, ko aɓa mwaro mala gìrnî na. <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />Dumǝna púp ama sǝkel mò, ko tyang mò, ko tasau mô, mala kārǝkigir ka ɓǝ̀ do mǝ'mǝsǝcaunì na. Mǝ nda Yahweh Ɓakuli ma'wun mǝnana pusǝ wun, wu purî ɓá nzali Masar ka. <verse eid="LEV 19:36" /><verse number="37" style="v" sid="LEV 19:37" />Wu kpata anggurcau mem kat andǝ anzongcau mem kat, sǝ wu pea. Mǝ nda Yahweh.&gt; &gt;&gt;<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s">Pàtanni ace pà gìr'nkila nǝ muna</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />&lt;&lt;Awu nǝ banggi amǝ Isǝrayila ama, &lt;Ɓwa mǝnana kat atà amǝ Isǝrayila ko atà abǝri mana à do a nzali Isǝrayila sǝ pà komǝye na atà amuni aban Molek ka, dumǝna púp à nǝ̀ wal-luí; aɓwana mala ɓinalê nǝ̀ ɓukki púp nǝ atali. <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />Mim nǝ nggearǝam ngga mǝ nǝ pǝlǝ arǝì, mǝ nǝ pusǝì ɓǝ̀ purî ɓalǝ aɓwana male, acemǝnana pànà mwashat atà amuni aban Molek, mǝnana tsǝa ban-mǝfele mem duk gir-ɓeami sǝ pǝndǝkice lullǝàm mǝfele ka. <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />Sǝ ɓǝ̀ aɓwana mala mǝno yì nzali, gìr mǝsǝia, à ɗeki mǝno yì ɓwa mǝnana pà muni aban Molek, sǝ à wal-luí raka, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />mǝ nǝ pǝlǝ arǝì andǝ tàu male, mǝ nǝ kasǝia, ɓǝà purî ɓalǝ aɓwana malea. Mǝnia ka nda gìr mana nǝ̀ kum ɓwa mǝno, andǝ koya ɓwa mǝnana kutia <note caller="+" style="f"><char style="fr" closed="false">20:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 34:15-16">Pur 34:15-16</ref></char>.</note>gyatarǝu aban kpata Molek ka.<verse eid="LEV 20:5" /></para>
  <para style="s">Pǝrban arǝ ká ɗika alú</para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />&lt;&lt; &lt;Ɓwa mǝnana pǝlǝa kǝla mǝgyatarǝu nǝ́ ká atà amǝ'ɗikalú andǝ amǝ'nggár ka, mǝ nǝ pǝlǝ arǝì sǝ mǝ nǝ kasǝì ɓǝ̀ purî ɓalǝ aɓwana male. <verse eid="LEV 20:6" /><verse number="7" style="v" sid="LEV 20:7" />Wu tàr ɓamur rǝ wun aɓa domǝfele, acemǝnana Mǝ nda Yahweh Ɓakuli ma'wun. <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />Wu parkir wun wu kpata anê mem acemǝnana Mǝ nda Yahweh mana ǝn tàr wun ɓǝ̀ wu duk aɓwana mem ngga.<verse eid="LEV 20:8" /></para>
  <para style="s">Anzongcau mala do mala aɓwana a ɓala</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />&lt;&lt; &lt;Ɓǝ̀ ɓwa sáng tárrí ko nggè ka dumǝna púp à nǝ̀ wal-luí.<note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:12">Pur 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="DEU 5:16">Nggur 5:16</ref>; <ref loc="MAT 15:4">Mat 15:4</ref></char>.</note> Ɓwa kǝla mǝno ka dumǝna púp ɓǝà wal-luí acemǝnana sángŋǝ́nà tárrí andǝ nggé; <note caller="+" style="f"><char style="fr" closed="false">20:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="2SA 1:16">2Sam 1:16</ref>; <ref loc="1KI 2:32">1Amur 2:32</ref>,<ref loc="1KI 2:33">33</ref>,<ref loc="1KI 2:37">37</ref></char>.</note>nkila male na amurí.<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />&lt;&lt; &lt;Ɓǝ̀ ɓwabura pàk cauɓikea mala nongnǝ mālá ɓi mǝ'murkala ka, dumǝna púp ɓwabure andǝ ɓwame mana à pàk cauɓikea mala nongnǝ rǝarǝia, yià kǝm ngga à nǝ̀ wal-luia. <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />Ɓǝ̀ ɓwa nongnǝ mālá tárrí ka, pànî tárrí kǝsǝkya. Dumǝna púp yì andǝ ɓwame yià kǝm ngga à nǝ̀ wal-luia; nkila malea na amúrià. <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />Ɓǝ̀ ɓwabura nongnǝ nkili mālá muni ka, dumǝna púp ɓwabure andǝ nkili yià kǝm ngga à nǝ̀ wal-luia; à pàngŋǝ̀nà gir-ɓeami; nkila malea na amúrià. <verse eid="LEV 20:12" /><verse number="13" style="v" sid="LEV 20:13" />Ɓǝ̀ ɓwabura nongnǝ ɓi ɓwabura, kǝla mana ɓwabura nǝ̀ nongnǝ ɓwama ka, à pàngŋǝ̀nà gìr'ɓeami. Dumǝna púp yia kǝm ngga à nǝ̀ wal-luia; nkila malea na amúrià. <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />Ɓǝ̀ ɓwabura pak-ɓwama nǝ ɓwama andǝ nggeà ɓwame yià kǝm ngga,<note caller="+" style="f"><char style="fr" closed="false">20:14 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 18:17">Pǝris 18:17</ref>; <ref loc="DEU 27:23">Nggur 27:23</ref></char>.</note> ɓealɓikea na. Dumǝna púp yià kat ka, à nǝ̀ pisǝia a bǝsa, ace mǝnana ɓealɓikea ɓǝ̀ kǝa pàk kàm aɓalǝ wun raka. <verse eid="LEV 20:14" /><verse number="15" style="v" sid="LEV 20:15" />Ɓwabura mǝnana pàk cauɓikea mala eau girkusǝu ka, dumǝna púp à nǝ̀ wal-luí, sǝ girkusǝuî gbal ka ɓǝà wal-luí.<note caller="+" style="f"><char style="fr" closed="false">20:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt" closed="false"><ref loc="EXO 22:19">Pur 22:19</ref>; <ref loc="LEV 18:23">Pǝris 18:23</ref>; <ref loc="DEU 27:21">Nggur 27:21</ref></char></note> <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />Ɓwama mǝnana pà ɓamúrì aban girkusǝu ace mǝnana ɓǝ̀ eauwi ka, dumǝna púp à nǝ̀ wal-luí andǝ girkusǝunì.<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />&lt;&lt; &lt;Ɓǝ̀ ɓwabura twal mǝ'nggaule, muna-ɓwama mala tárrí ko muna-ɓwama mala nggè, sǝ à nongnǝ rǝarǝia ka,<note caller="+" style="f"><char style="fr" closed="false">20:17 </char><char style="fq" closed="false">à nongnǝ rǝarǝia ka </char><char style="ft" closed="false">ko &lt;&lt;yì ka sǝn ɓata mǝ'nggaule, sǝ mǝ'nggaule sǝn ɓate ka.&gt;&gt;</char></note> gìr kǝsǝkya na. À nǝ̀ pǝria a mǝsǝ aɓwana ɓǝà purî ɓalǝ aɓwana malea. Yì ka kìɗìkìna mǝ'nggaule, sǝ bafe mala cauɓikea male nǝ̀ do amurí. <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" /><note caller="+" style="f"><char style="fr" closed="false">20:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 18:19">Pǝris 18:19</ref></char>.</note>Ɓǝ̀ ɓwabura nong andǝ ɓwama mǝnana nda aɓa bumkwana male, sǝ pak-ɓwama nǝi ka, alina ban ɓunno mala nkila male, sǝ yì gbal ka nyingǝna ban ɓunno mala nkila male kwas. Yià kǝm ngga à pà nǝ̀ ɓallia aɓalǝ aɓǝla malea ɗàng.<verse eid="LEV 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19" />&lt;&lt; &lt;A pà wunǝ nongnǝ mǝ'eam nggò ko mǝ'eam tárró ɗàng. Ɓwa mǝnana pè ka, ndarǝ pê aɓǝla male kǝsǝkya; yì andǝ ɓwame ka bafe mala cauɓikea malea nǝ̀ do amúrià. <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />Ɓǝ̀ ɓwabura nongnǝ mālá kine ka, pànî kine kǝsǝkya; bafe mala cauɓikea male andǝ mala ɓwame nǝ̀ do amúrià, sǝ à nǝ̀ wǔ à pà nǝ̀ kum muna ɗang. <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />Ɓǝ̀ ɓwabura nongnǝ mālá mǝ'eambi ka, pàngŋǝ̀nà gìr'ɓeami sǝ pànî mǝ'eambi kǝsǝkya. Yì andǝ ɓwame ka à nǝ̀ wǔ à pà nǝ̀ kum muna ɗang.<verse eid="LEV 20:21" /></para>
  <para style="s">Do mǝfele aɓa nzali</para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />&lt;&lt; &lt;Dumǝna púp wun nǝ̀ bwal anê mem kat andǝ anggurcau mem kat sǝ wun nǝ̀ pea, ace mǝnana nzali mana ǝn nggǝ yinǝ wun ɓǝ̀ wu do aɓalǝi ka, ɓǝ̀kǝa u wun ɗàng. <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />Sǝ pà wu nǝ̀ kpata akúncau mala nzali mala aɓwana mǝnana ǝn nggǝ pǝria a ɓadǝm wun ngga ɗàng; acemǝnana yià ka à pàkki agir mǝno ka, nda tsǝa sǝ ǝn ɓinǝcea ka. <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />Sǝama wun ngga ǝn pana cau mem aban wun ama: Wun nǝ̀ ak nzali malea arǝia. Mǝ nǝ pà wuni ɓǝ̀ duk girkuma ma'wun, nzali mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga. Mǝ nda Yahweh Ɓakuli ma'wun mana tàr wun ɓǝ̀ wu duk ɗàng nǝ aɓwana mala acili anzali ka. <verse eid="LEV 20:24" /><verse number="25" style="v" sid="LEV 20:25" />Acemani ka, wun nǝ̀ gau nre girkusǝu mǝnana mǝɓoarne<note caller="+" style="f"><char style="fr" closed="false">20:25 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="GEN 8:20">Tite 8:20</ref>; <ref loc="LEV 11:1-31">Pǝris 11:1-31</ref>; <ref loc="DEU 14:3-20">Nggur 14:3-20</ref></char>.</note> na ace girlina andǝ mana gìr'ɓeami na ka, sǝ anre nyal mǝnana gìr'ɓeami na andǝ mana mǝɓoarne na ace girlina ka. Wu kǝa pǝndǝki ɓamur rǝ wun nǝ ɓekǝ girkusǝu ko nyal andǝ koman mǝnana kat kǝ pūrǝ nǝ múrbumi a nzali, amǝnana ǝn tárnia ɓǝ̀ wu nyesǝia agir'ɓeami na ka ɗàng. <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />Dumǝna púp wun nǝ̀ duk amǝfele abanam, acemǝnana Mim Yahweh ka mǝ nda mǝfele, sǝ ǝn tarna wun aɓalǝ acili aɓwana ɓǝ̀ wu duk mem.<verse eid="LEV 20:26" /></para>
  <para style="s">Pǝrban arǝ bangŋo mala alú andǝ mala pakkiagir nggár</para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />&lt;&lt; &lt;Ɓwabura ko ɓwama mǝnana mǝɗikalú na ko mǝ'nggár na ka, dumǝna púp à nǝ̀ wal-luí. Ɓǝà ɓukkia nǝ atali; nkila malea nǝ̀ pa amúrià.&gt; &gt;&gt;<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s">Do mǝfele mala apǝris</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />Yahweh ne Musa ama, &lt;&lt;Nacau nǝ apǝris, andǝ amuna-burana mala Haruna, sǝ wu banggia wia ama, ɓǝ̀ kǝɓwa ateà ɓǝkǝa pǝndǝki rǝì nǝ oasǝ ɓamúrì aɓalǝ anàtà mala tsǝkban mala ɓeɓwa atà aɓǝla male mana wù ka ɗàng, <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />she ɓǝ̀ ɓǝlê ka nda tù abani, ko nggè na, ko tárrí na, ko muna-ɓwabura male na, ko ɓoarnsarile, ko mǝ'eambi na, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />ko mǝ'nggaule nsari (mǝnana dupi wi acemǝnana malaká albura raka) nda ka; amǝnia ka nda yakǝla nǝ̀ pǝndǝki rǝì acea ka. <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />Pǝris pà nǝ̀ pǝndǝki rǝì acemǝnana yì ka nda múr aɓwana a tàu male, sǝ anggo ka nǝ̀ duk gìr'ɓeami ka ɗàng. <verse eid="LEV 21:4" /><verse number="5" style="v" sid="LEV 21:5" />Dumǝna púp pǝris pà nǝ̀ mwa kǝ ban a ɓamúrí ɓǝ̀ duk kongǝlang ɗàng, pà nǝ̀ mwaki ankanggari mbotokuni ɗàng, sǝ pà nǝ̀ cangi nyoulǝa arǝì ɗàng. <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />Apǝris nǝ̀ duk amǝfele aban Ɓakuli malea sǝ à pà nǝ̀ pǝndǝkice lullǝ Ɓakuli malea ɗàng. Yia ka à nda ka aɓwana mǝnana à pākiyi Yahweh apagir mala pisǝe a bǝsa, yì girlina mala Ɓakuli malea ka; acemani ka, dumǝna púp à nǝ̀ duk amǝfele. <verse eid="LEV 21:6" /><verse number="7" style="v" sid="LEV 21:7" />Pǝris pà nǝ̀ al mā-gung, ko ɓwama mǝnana à kìɗìkìnì ka ɗàng, sǝ pà nǝ̀ al ɓwama mǝnana purî burí ka ɗàng, acemǝnana pǝris ka mǝfele na aban Ɓakuli male. <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />Pǝris ka dumǝna púp aɓwana nǝ̀ twali mǝfele na acemǝnana yì na kǝ pàgir mala girlina<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="fq" closed="false">pàgir mala girlina </char><char style="ft" closed="false">ko pàgir mala pisǝe a bǝsa. </char></note> abanam, Ɓakuli ma'wun ngga. Yì ka nǝ̀ duk mǝfele aban wun, acemǝnana Mim, Yahweh, mana ǝn tar wun ace ɓamúràm ngga, Mǝ nda mǝfele. <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />Sǝ ɓǝ̀ ɓoarnsarile koya pǝris pǝndǝki rǝì nǝ gyatarǝu ka, ndarǝ pǝndǝkice tárrí; dumǝna púp à nǝ̀ pisǝi a bǝsa.<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />&lt;&lt;Pǝris mǝnana nda muna-dǝmba aɓalǝ amǝ'eambi, mǝnana à ɗārǝ́ni nǝ mùrú ɗārǝ́bân, sǝ à tàrnì ɓǝ̀ oasǝ adaura-pǝris arǝì ka, dumǝna púp pà nǝ̀ nying nyang ɓamúrí zuli ɗang, sǝ pà nǝ̀ san agir'nggūrǝì ɗàng. <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />Pà nǝ̀ kùtí amur koya lú ɗàng; pà nǝ̀ pǝndǝki ɓamúrì ɗàng, ko ɓǝ̀ lú tárrí ko nggè na ka, <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />sǝ pà nǝ̀ purî ban mǝfele mala Ɓakuli male nǝ̀ ká a nza ɗàng,<note caller="+" style="f"><char style="fr" closed="false">21:12 </char><char style="fq" closed="false">sǝ pà nǝ̀ purî ban mǝfele mala Ɓakuli male nǝ̀ ká a nza ɗàng, </char><char style="ft" closed="false">ko pà nǝ̀ nying túró male a ban mǝfele mala Ɓakuli male ace ɓekǝ gìr a nza ɗàng</char></note> ace mǝnana ɓǝkǝa pǝndǝkice ban mǝfele raka; tàrban mala mùrú ɗārǝ́bân mala Ɓakuli ka nda amurí: Mǝ nda Yahweh. <verse eid="LEV 21:12" /><verse number="13" style="v" sid="LEV 21:13" />Sǝ pà nǝ̀ al ɓwama mǝnana súrǝ́nà ɓwabura ka ɗàng. <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />Pà nǝ̀ al mā-lú ko ɓwama mǝnana purî ta burí, ko ɓwama mǝnana à gbárí, ko mā-gung na ka ɗàng. Nsari na nǝ̀ al aɓalǝ aɓwana male ka, <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />acemǝnana ɓǝ̀ pàk ka, amuna mǝnana nǝ̀ yia ɓǝlia nǝnzǝ́mò ka à pǝndǝkina aɓalǝ aɓwana male.<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="fq" closed="false">à pǝndǝkina aɓalǝ aɓwana male </char><char style="ft" closed="false">ko &lt;&lt;à pà nǝ̀ ea ɓǝà duk apǝris aɓalǝ aɓwana male ɗàng.&gt;&gt;</char></note> Mǝ nda Yahweh mana ǝn nggǝ tàr pǝris ɓǝ̀ duk mǝfele ka.&gt;&gt;<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />Sǝ Yahweh ne Musa ama, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />&lt;&lt;Nacau nǝ Haruna, banggi wi ama, kǝ muna ko mǝkau pá kàm a nggurkwar ma'wun, mǝnana ɓekǝ bare shingnǝe, ko ɗwanyi ɓekǝ bare rǝì ka, nǝ̀ sung tù aban gyangŋan ama nǝ̀ pà ɓoro girlina mala Ɓakuli male ka ɗàng. <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />Ɓǝ̀ ya ɓwa na sǝ ndanǝ kǝ mǝɓane a ɓè bare ka, ɓǝkǝa sung tù aban gyangŋan ama nǝ̀ pàgir ɗàng: nte ko gbakǝre, ko ɓwa mǝnana nggun-lullǝi sana, ko ɓè kusǝì ko buì sauwa kúti ɓì, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />ko ɓwa mǝnana ɓè kusǝì ko buì ɓunno, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />ko mǝ'nzongtong, ko nkpandal-candǝa, ko ɓwa mana ndanǝ ɓwá a mǝsǝì, ko ndanǝ kwánó oakiban, ko kwánó kwàmbì, ko ɓwê ka bedǝran na ka. <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />Kǝɓwa pà kàm atà amuna andǝ amǝkau a tàu mala Haruna pǝris, mǝnana ɓè bare rǝì ka ndanǝ kǝ mǝɓane, nǝ̀ sung tù aban gyangŋan ama nǝ̀ pà aɓoro mǝnana à nǝ̀ pisǝia a bǝsa abanam, Mim Ɓakuli male ka ɗàng. <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />Kat andǝ amani ka, nǝ̀ gandǝ li girlina mala Ɓakuli male, yì girlina mala apagir mǝfele andǝ apagir nggea mǝfele. <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />Sǝama pà nǝ̀ kùtí nǝ ɓá lagir, ko nǝ̀ gbàshìban gyangŋan ɗàng, acemǝnana ndanǝ mǝɓane a ɓè bare rǝì, sǝ ace mǝnana abân mǝfele mem ɓǝà kǝa duk mǝɓeami ɗàng. Mǝ nda Yahweh, mǝnana ǝn nggǝ tàr abân mǝnia ɓǝà duk amǝfele ka.&gt;&gt;<verse eid="LEV 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24" />Anggo sǝ Musa nacau nǝ Haruna andǝ amuni, andǝ amǝ Isǝrayila kat.<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s">Apǝris andǝ agirlina malea</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />Sǝ Yahweh banggi Musa cau ama, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />&lt;&lt;Nacau nǝ Haruna andǝ amuni, ama ɓǝà dum nǝ tsǝkiru arǝ apagir mǝfele mala amǝ Isǝrayila, mǝnana à tària acem ngga, ace mǝnana ɓǝà kǝa pǝndǝkice lullǝàm mǝfele raka: Mǝ nda Yahweh. <verse eid="LEV 22:2" /><verse number="3" style="v" sid="LEV 22:3" />Banggia wia ama, &lt;Arǝ anza ma'wun mǝnana kat à kǝ yiu ka, ɓǝ̀ kǝ ɓwa atà amuna andǝ amǝkau ma'wun, gbàshìban ko je agir mǝfele mala amǝ Isǝrayila, mǝnana à tària acem Mim Yahweh, sǝ nda aɓa do-ɓeami ka, mǝno yì ɓwa ka, à nǝ̀ kasǝi, ɓǝ̀ purî ɓadǝmbam: Mǝ nda Yahweh. <verse eid="LEV 22:3" /><verse number="4" style="v" sid="LEV 22:4" />Ɓǝ̀ ɓè kǝɓwa kàm a tàu mala Haruna, ndanǝ kwánó nggû, ko mùrgìr kǝ sur a ɓate ka, pà nǝ̀ lì atà agir mǝfele ɗàng, she ɓǝ̀ langŋa rǝì ɓoarnansari ka. Koya pǝris mǝnana kat je ɓè kǝgir mǝnana je rǝ lú, ko yi ka sukkimùr arǝì ka, nǝ̀ pǝlǝ mǝɓeami, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />sǝ ɓǝ̀ yi ka je ɓekǝ gìr mǝnana kǝ kuɗǝki a nzali, mana nǝ̀ gandǝ tsǝì ɓǝ̀ duk mǝɓeami, ko ɓǝ̀ je ɓekǝ ɓwa mǝnana nǝ̀ gandǝ tsǝì ɓǝ̀ duk mǝɓeami, ko ɓǝ̀ mana nda do-ɓeami mala ɓwê ka. <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />Koya pǝris mǝnana je ulang amǝno yì agir ka, nǝ̀ duk mǝɓeami ba pwarikpǝra, sǝ pà nǝ̀ lì atà apagir mǝfele ɗàng she ɓǝ̀ sussǝna a mùr ka. <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />Lang pwari kpana ka, nǝ̀ ɓoarnsari, sǝ anzǝm mǝno ka, nǝ̀ gandǝ li atà agir mǝfele, acemǝnana girlina male na. <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />Pǝris ka pà nǝ̀ lì nyam girkusǝu mǝnana à kumi wuna atàrǝì ko anyambura wal-luí ka ɗàng,<note caller="+" style="f"><char style="fr" closed="false">22:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 22:31">Pur 22:31</ref>; <ref loc="LEV 7:24">Pǝris 7:24</ref>; <ref loc="LEV 17:15">17:15</ref>; <ref loc="EZK 44:31">Ezǝk 44:31</ref></char>.</note> acemǝnana nǝ̀ tsǝì nǝ̀ duk mǝɓeami: Mǝ nda Yahweh.&gt; <verse eid="LEV 22:8" /><verse number="9" style="v" sid="LEV 22:9" />Acemani ka, dumǝna púp ɓǝà kpata kwarkiru mem, ɓǝ̀ ana raka à nǝ̀ twaltwalo mala cauɓikea amúrià sǝ à nǝ̀ wǔ atàcau male ɓǝ̀ à pǝndǝkice ka: Mǝ nda Yahweh, mǝnana ǝn nggǝ tàr apǝris ɓǝà duk amǝfele ka.<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />&lt;&lt;Ɓwapwasǝa ka pà nǝ̀ lì aɓa gìr mǝfele ɗàng; kǝ ɓè bǝri ɓwa-kúnɗàngna mala pǝris, ko ɓwa mǝnana à twali ace túró-boalo ka, pà nǝ̀ li aɓa gìr mǝfele ɗàng.<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 29:33">Pur 29:33</ref>; <ref loc="NUM 3:10">Ɓal 3:10</ref>; <ref loc="NUM 18:4">18:4</ref>,<ref loc="NUM 18:7">7</ref></char>.</note> <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />Sǝama ɓǝ̀ pǝris kúr guro nǝ boalo, duk girkuma male ka, gurè nǝ̀ gandǝ lì, sǝ koya ɓwa mǝnana à ɓǝli a ɓala male ka, à earǝ́nì wi ɓǝ̀ li aɓa girlina male. <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />Ɓǝ̀ nsarile pǝris al ɓwapwasǝa ka, nsarile mǝno pà nǝ̀ lì aɓalǝ agir mǝfele mǝnana à pāki ka ɗàng. <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />Sǝama ɓǝ̀ nsarile pǝris ka duk mā-lú ko doɓala male gauwa pànǝ muna ɗang, sǝ nyare a ɓala mala tarrí, kǝla mana pá a lo-ɓwa male ka, à nǝ̀ eari wi ɓǝ̀ lì aɓa girlina mala tarrí; ɓǝ̀ mǝno na raka, kǝ ɓwapwasǝa pà nǝ̀ lì girlinê ɗàng. <verse eid="LEV 22:13" /><verse number="14" style="v" sid="LEV 22:14" />Sǝ ɓǝ̀ ɓwa kǝla mǝno lì gir mǝfele aɓa ɗwanyi-sǝlǝe ka, dumǝna púp ɓwê nǝ̀ mbwe girlina mǝno lì ka, sǝ nǝ̀ tsǝk mwashat aɓa gauwe tongno mala kúrè amurí, sǝ nǝ̀ pè pǝris mǝnia yì gir mǝfele ka. <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />Agir mǝfele mala amǝ Isǝrayila mǝnana à kǝ yinǝia ace pè Yahweh ka, apǝris ɓǝà kǝa pǝndǝkicea <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />nǝ nying aɓwana mana apǝris na raka ɓǝà lì ɗàng. Ɓǝ̀ à pàk ka à nǝ̀ twaltwalo mala cauɓikea andǝ bafe amúrià: Mǝ nda Yahweh, mǝnana ǝn nggǝ tàr apǝris ɓǝà duk amǝfele ka.&gt;&gt;<verse eid="LEV 22:16" /></para>
  <para style="s">Apagir mǝnana à nǝ̀ ea ka</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />Sǝ Yahweh banggi Musa ama, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />&lt;&lt;Bangcau nǝ Haruna andǝ amuna-burana male, andǝ amǝ Isǝrayila ama, Lang ɓeɓwa a tàu mala amǝ Isǝrayila, ko atà amǝ'kúnɗàngna mǝnana à ndanǝdo a nzali Isǝrayila, yinǝ ɓoro nǝ̀ pa, ko mala lùmsǝ komǝye na atà apàcau nǝ-shambum male, ko pàgir mala eare mala bumi na, mǝnana à nǝ̀ pàgir mala pisǝe kǝring nǝi abanam Yahweh ka, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />ɓǝ̀ do ama à nǝ̀ é ka, dumǝna púp ɓǝ̀ pa jamnda ko gbato, ko gam a domwan male, mǝnana ɓekǝ gìr mǝɓane pà kàm arǝì raka. <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />Wu kǝa pà ɓekǝ gir mǝnana ndanǝ ɓekǝ mǝɓane arǝì ka ɗàng, acemǝnana Yahweh pà nǝ̀ é a kúnì wun ɗàng. <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />Sǝ ɓǝ̀ ɓwa nǝ̀ pè Yahweh gir'nkila mala pàgir mala dotarǝu ace lùmsǝ pàcau nǝ-shambum male, ko pàgir mala eare mala ɓabumi na, atà andá ko ambul a domwan ngga, ɓǝ̀ à nǝ̀ é ka, dumǝna púp nǝ̀ duk mǝnana lùmsǝ puppup, ɓekǝ gìr mǝɓane pà kàm arǝì raka. <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />Pà wun nǝ̀ pà ɓekǝ girkusǝu mǝnana nte na, ko gbakǝri, ko mǝnana kúm-penye, ko mǝnana ɓekǝ mùrgìr kǝ pur arǝì, ko ndanǝ nzwari ko kwàmbì ka abanam Yahweh ɗàng, ko wun nǝ̀ pam, Mim Yahweh, ɓǝ̀ duk pàgir na nǝ bǝsa amur gyangŋan ngga ɗàng. <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />Awu nǝ gandǝ pa jamnda ko nzur mǝnana ɓè bare sauwa kútì ɓi, ko gattì ɓi ka, ace pàgir mala eare mala ɓabum, sǝama ɓǝ̀ pàgir na ace lùmsǝ pàcau nǝ-shambum ngga, à pà nǝ̀ é ɗàng. <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />Girkusǝu mǝnana kat kúm-penye a nkyari, ko à arki ankyari, ko nkyari sanā, ko kasǝ ka, à pà nǝ̀ panagir nǝi abanam Yahweh ɗàng; pà wu nǝ̀ pàk mǝno ka aɓa nzali ma'wun ɗàng, <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />sǝ pà wu nǝ̀ ak ulang agirkusǝu mǝnia ka a bu ɓwa-kúnɗàngna ama wun nǝ̀ pa gìr'nkila nǝi kǝla pàgir mala girlina<note caller="+" style="f"><char style="fr" closed="false">22:25 </char><char style="fq" closed="false">pàgir mala girlina </char><char style="ft" closed="false">ko pàgir mala pisǝe a bǝsa; anggo gbal a mǝsǝì 27. </char></note> mala Ɓakuli ma'wun ɗàng. Ɓakuli ka pà nǝ̀ ak a'ulang agirkusǝu mǝno ka a kúnì wun ɗàng, acemǝnana mǝɓane nakam arǝia atàcau mala kúm-penye malea.&gt;&gt;<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />Sǝ Yahweh ne Musa ama, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />&lt;&lt;Lang à ɓǝl jamnda, ko nzur ka, à nǝ̀ nyi atà nggè nongŋo tongno-nong-ɓari, sǝ twal a tongno-nong-tàruià pwari aban ká dǝmba ka, à nǝ̀ gandǝ é ɓǝ̀ duk pàgir nǝ bǝsa abanam Yahweh. <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />Sǝama pà wun nǝ̀ wal ndǎ ko nzur, a pwari mǝ'mwashati andǝ muni ɗàng. <verse eid="LEV 22:28" /><verse number="29" style="v" sid="LEV 22:29" />Sǝ ɓǝ̀ wun nǝ̀ pwan-myal girkusǝu ace pa gìr'nkila ace pàk-yàwá abanam Yahweh ka, dumǝna púp wun nǝ̀ pè aɓa kpata njarì ace mǝnana ɓǝ̀ wu kum â ka. <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />Wun nǝ̀ lì a kǝ pwari mǝ'mwashati; pà wun nǝ̀ nying kǝ cili ɓǝ̀ bankwari ɗàng: Mǝ nda Yahweh.<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />&lt;&lt;Anggo sǝ wun nǝ̀ kpata anzongcau mem sǝ wun nǝ̀ peǎ: Mǝ nda Yahweh. <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />Sǝ pà wu nǝ̀ pǝndǝkice lullǝam mǝfele ɗàng, ace mǝnana ɓǝ̀ aɓwana sǝni ama mǝ nda mǝfele aɓalǝ amǝ Isǝrayila ka. Mǝ nda Yahweh mǝnana ǝn nggǝ tàr wun ɓǝ̀ wu duk aɓwana mem, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />Mim mǝnana ǝn pusǝ wun wu purî ɓá nzali Masar ace mǝnana mǝ duk Ɓakuli ma'wun ngga: Mǝ nda Yahweh.&gt;&gt;<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">Alamsan mala Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />Yahweh banggi Musa ama, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />&lt;&lt;Bangcau nǝ amǝ Isǝrayila, nea wia ama, Amǝnia ka, à nda ka alamsan mem mǝnana à kwakia, ama dumǝna púp ɓǝ̀ wu hamnǝia kǝla aramba-banɓwáná mǝfele ka; alamsan mem mǝnana ǝn kwakia ka à nda.<verse eid="LEV 23:2" /></para>
  <para style="s">Pwari Sabbat</para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3" />&lt;&lt;Aɓa nongŋo tongno-nong-mwashat wun nǝ̀ pàktúró, sǝama tongno-nong-ɓaria pwari ka, nǝ̀ duk pwari Sabbat, pwari usǝlǝo kat-kat, mala ramba-banɓwáná mǝfele. Pà wu nǝ̀ pàk kǝ túró aɓalǝi ɗàng. Sabbat na acem Yahweh arǝ abando ma'wun kat.<note caller="+" style="f"><char style="fr" closed="false">23:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 31:15">Pur 31:15</ref>; <ref loc="EXO 35:2">35:2</ref>; <ref loc="LEV 16:31">Pǝris 16:31</ref>; <ref loc="LEV 23:32">23:32</ref>; <ref loc="LEV 25:4">25:4</ref></char>.</note><verse eid="LEV 23:3" /></para>
  <para style="s">Yàlîmurû</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />&lt;&lt;Amǝnia ka à nda ka alamsan mem Yahweh mǝnana ǝn kwakia ka, yì aramba-banɓwáná mǝfele mǝnana wun nǝ̀ hamnǝia ɓǝ̀ apwari malea mǝnana à tsǝkia wia ka à yi kārǝ́ ka. <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />Aɓa lum-nong-inea nongŋo mala zongŋo mǝdǝmbe, nǝ pwari-ká-ndwent ka, wun nǝ̀ pà gìr'nkila mala Yàlîmurû abanam Yahweh. <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />Sǝ a lum-bwamdǝ-tongnoia pwari mala kǝ zongŋe ka, nda tita Lamsan mala Bǝredi mana Yis pà arǝì raka acem Yahweh; wun nǝ̀ twal anongŋo tongno-nong-ɓari mǝnana aɓalǝia ka, wun nǝ̀ li Bǝredi mǝnana yis pà arǝì raka. <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />A pwari mǝdǝmbe ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele; a pwari mǝnia ka, pà wu nǝ̀ pak kǝ túró mala koya pwari ɗàng. <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />Sǝama a koya pwari mala amǝno yì anongŋo tongno-nong-ɓari ka, wun nǝ̀ yinǝ pàgir nǝ bǝsa abanam Yahweh. A tongno-nong-ɓaria pwari ka, nda pwari mala ramba-banɓwáná mǝfele; a pwari mǝnia ka, pà wu nǝ̀ pak kǝ túró mala koya pwari ɗàng.&gt;&gt;<verse eid="LEV 23:8" /></para>
  <para style="s">Lamsan mala aɓǝlagir mǝdǝmbe</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />Pǝlǝa Yahweh bangcau nǝ Musa ama, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />&lt;&lt;Bangcau nǝ amǝ Isǝrayila, nea wia ama, Lang wu yina a nzali mana ǝn nggǝ pà wun, sǝ wu pwàn gìrɓaban male ka, dumǝna púp wun nǝ̀ yinǝ kùnò mala aɓǝlagir mǝdǝmbe mala agirɓaban ma'wun aban pǝris, <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />sǝ wun nǝ̀ loasǝ kùnoê a kuli a ɓadǝmbam Yahweh, ace mǝnana ɓǝ̀ wu kum â ka. A pwari mǝnana anzǝm Sabbat ka sǝ pǝris nǝ̀ loasǝi a kuli. <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />A pwari mǝnana à nǝ̀ loasǝ mǝno yì kùnò ka, dumǝna púp awu nǝ pà muna-gam mǝnana mbule mwashat, sǝ ɓekǝ gìr mǝɓane pà kàm arǝì raka, ɓǝ̀ duk pàgir mala pisǝe kǝring abanam Yahweh. <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />Sǝ atārǝia andǝ mǝno ka awu nǝ pà tyang ɓari mala muku mǝɓǝlke mana à zurǝì andǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male; pàgir nǝ bǝsa na, mala pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. Sǝ atārǝia andǝ mǝno ɗǝm ngga awu nǝ pà lita mwashat mala mùr-anap, ɓǝ̀ duk pàgir mala girnùná. <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />Pà wu nǝ̀ lì kǝɓè bǝsa mǝsǝsa ɗàng, ko pwale, ko ime, ko mǝnana à lurǝi pǝlǝ bǝredi ka, sheɓǝ̀ wu yina nǝ pàgir mǝnia aban Ɓakuli ma'wun ngga. Mǝnia ka nggurcau na tàtǝ́k arǝ anza ma'wun kat, arǝ abân mǝnana kat wu duk kam ngga.<verse eid="LEV 23:14" /></para>
  <para style="s">Lamsan mala alimô</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />&lt;&lt;Twal a pwari mǝnana yiu anzǝm Sabbat, yì pwari mana wu yinǝ kùnò mala aɓǝlagir nǝi, ace pàgir mala loasǝe a kuli a ɓadǝmbam Yahweh ka, wun nǝ̀ ɓal alimo tongno-nong-ɓari.<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 34:22">Pur 34:22</ref>; <ref loc="NUM 28:26">Ɓal 28:26</ref>; <ref loc="DEU 16:10">Nggur 16:10</ref>; <ref loc="ACT 2:1">Atúró 2:1</ref></char>.</note> <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />A lumi-tongnoia pwari, yì masǝlǝata pwari mala tongno-nong-ɓaria limo ka, wun nǝ̀ yinǝ ɓè pàgir mala mǝsǝsa nǝ bǝsa mǝsǝsa abanam Yahweh. <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />Arǝ aɓala ma'wun ngga, dumǝna púp wun nǝ̀ yinǝ agbatali bǝredi ɓari, ace pàgir mala loasǝe a kuli; koya gbatali bǝredi ka, à nǝ̀ pè nǝ tyang ɓari mala muku mǝɓǝlke, à nǝ̀ lurǝi nǝ yis arǝì, sǝ à nǝ̀ yinǝi à nǝ̀ ya pam Yahweh kǝla ɓǝlagir mǝdǝmbe. <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />Atārǝia andǝ agbatali bǝredi mǝno ka, dumǝna púp wun nǝ̀ pa amuna-nzur tongno-nong-ɓari mǝnana mbulea mwashat-mwashat, sǝ kǝ mǝɓane pà kàm arǝia raka, andǝ lo-jamnda mwashat, andǝ agam ɓari. À nǝ̀ duk pàgir mala pisǝe kǝring abanam Yahweh atārǝia andǝ pàgir mala mǝsǝsa malea, andǝ apagir mala girnùná; pàgir nǝ bǝsa na mala pà rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />Sǝ wun nǝ̀ pagìr nǝ gbato mwashat ɓǝ̀ duk pàgir ace cauɓikea,<note caller="+" style="f"><char style="fr" closed="false">23:19 </char><char style="fq" closed="false">pàgir ace cauɓikea </char><char style="ft" closed="false">ko &lt;&lt;pàgir ace lakban arǝ cauɓikea.&gt;&gt;</char></note> sǝ amuna-gam ɓari mǝnana mbulea mwashat-mwashat ka kǝla gìr'nkila mala apagir ace dotarǝu. <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />Sǝ pǝris nǝ̀ loasǝ agam mǝnia ɓari ka a kuli atārǝia andǝ bǝredi mala ɓǝlagir-mǝdǝmbe, kǝla pàgir mǝnana à nǝ̀ loasǝi a kuli a ɓadǝmbam Yahweh ka. À nǝ̀ duk mǝfele abanam Yahweh, ace pǝris.<verse eid="LEV 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 23:21" />&lt;&lt;A pwari mǝno ka wun nǝ̀ hama ama pwari mǝgule na ace ramba mala aɓwana; ramba-banɓwáná mǝfele na ace wun. Pà wu nǝ̀ pàk kǝ túró mala koya pwari ɗàng. Nggurcau na tàtǝ́k arǝ anza ma'wun kat, arǝ abân mǝnana kat wu duk kam ngga.<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />&lt;&lt;Sǝ lang wu yina pwàn aɓǝlagir mala nzali ma'wun ngga, pà wu nǝ̀ pwania aban ká arǝ nzong ɓaban ma'wun ɗàng,<note caller="+" style="f"><char style="fr" closed="false">23:22 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 19:9-10">Pǝris 19:9-10</ref></char>.</note> sǝ pà wu nǝ̀ alta ɓakurikuri ma'wun anzǝm pwan-gìrɓaban ɗang. Wu nyinggi amǝ'tǝ̀r andǝ abǝri mǝnana à do aɓalǝ wun ngga: Mǝ nda Yahweh Ɓakuli ma'wun.&gt;&gt;<verse eid="LEV 23:22" /></para>
  <para style="s">Lamsan mala twang Anjawe</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />Sǝ Yahweh ne Musa ama, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />&lt;&lt;Banggi amǝ Isǝrayila ama, Pwari mǝdǝmbe mala tongno-nong-ɓaria zongŋo ka, wun nǝ̀ twali pwari na à tsǝì ace usǝlǝo kat-kat; pwari mǝfele ace ramba-banɓwáná, mǝnana à nǝ̀ hamnǝ pakkiɗire male mala kasǝɓalǝu nǝ ɓua-njawe mǝcandǝe mala anjawe<note caller="+" style="f"><char style="fr" closed="false">23:24 </char><char style="fq" closed="false">ɓua-njawe mǝcandǝe mala anjawe </char><char style="ft" closed="false">ko ɓuà-gāwàn, ko mak-yalang.</char></note> ka. <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />Pà wu nǝ̀ pàkki atúró ma'wun aɓalǝi ɗàng. A kún mani ka, wun nǝ̀ pàɓoro nǝ bǝsa abanam Yahweh.&gt;&gt;<verse eid="LEV 23:25" /></para>
  <para style="s">Pwari Shawuɗiban</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />Yahweh ne Musa ama, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />&lt;&lt;Lumia pwari mala mǝnia yì tongno-nong-ɓaria zongŋo ka nda Pwari mala Shawuɗiban.<note caller="+" style="f"><char style="fr" closed="false">23:27 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:10">Pur 30:10</ref>; <ref loc="LEV 16:29-30">Pǝris 16:29-30</ref>; <ref loc="LEV 25:9">25:9</ref>; <ref loc="NUM 29:7-11">Ɓal 29:7-11</ref></char>.</note> Nǝ̀ dupa wun pwari ramba-banɓwáná mǝfele. Wun nǝ̀ ɓinǝì ɓamur rǝ wun agir sǝ wun nǝ̀ pàgir nǝ bǝsa abanam Yahweh. <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />Sǝ pà wu nǝ̀ pàk kǝ túró mala koya pwari a mǝno yì pwari ka ɗàng, acemǝnana Pwari mala Shawuɗiban na, ace shawuɗì wun a ɓadǝmbam, Mim Yahweh Ɓakuli ma'wun. <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />Ɓwa mǝnana gilmur a mǝno yì pwari raka, à pà nǝ̀ ɓalli aɓalǝ aɓwana male ɗàng. <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />Sǝ ɓwa mǝnana kat pàk kǝ túró a mǝno yì pwari ka, mǝ nǝ kiɗiki aɓalǝ aɓwana male. <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />Pà wu nǝ̀ pàk kǝ túró ɗang kpékpé. Dumǝna nggurcau tàtǝ́k arǝ anza ma'wun kat, arǝ abando ma'wun kat. <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />Nǝ̀ dupa wun Sabbat mala usǝlǝo kat-kat, sǝ wun nǝ̀ ɓinǝì ɓamur rǝ wun agir. A tongno-nong-inea pwari mala zongŋe, nǝ pwarikpǝra, lo a pwarikpǝra aban ká ɓè pwarikpǝra ka, wun nǝ̀ pagulo arǝ Sabbat ma'wun.&gt;&gt;<verse eid="LEV 23:32" /></para>
  <para style="s">Lamsan mala Do aɓalǝ Agumli</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />Sǝ Yahweh ne Musa ama, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />&lt;&lt;Banggi amǝ Isǝrayila ama: Lamsan mala Do aɓalǝ Agumli<note caller="+" style="f"><char style="fr" closed="false">23:34 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 23:16">Pur 23:16</ref>; <ref loc="JHN 7:37">Yoh 7:37</ref></char>.</note> ka, nǝ̀ tite a lum-bwamdǝ-tongnoia pwari mala mǝnia yì tongno-nong-ɓaria zongŋo ka, sǝ nǝ̀ lidǝmba arǝ anongŋo tongno-nong-ɓari ace pagulo abanam Yahweh. <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />Pwari mǝdǝmbe ka nǝ̀ duk mala ramba-banɓwáná mǝfele; pà wu nǝ̀ pàk kǝ túró mala koya pwari aɓalǝi ɗàng. <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />Wun nǝ̀ twal anongŋo tongno-nong-ɓari, sǝ a koya pwari ka, wun nǝ̀ pàgir nǝ bǝsa abanam Yahweh. A tongno-nong-tàruià pwari ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele, sǝ wun nǝ̀ pàɓoro mala girlina abanam Yahweh. Dápí ace peri na; pà wu nǝ̀ pàk kǝ túró mala koya pwari aɓalǝi ɗàng.<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />&lt;&lt;Amǝnia ka, à nda ka alamsan mem Yahweh mǝnana à kwakia, mǝnana dumǝna púp ɓǝ̀ wu hamnǝia kǝla aramba-banɓwáná mǝfele, ace pà aɓoro mala girlina abanam Yahweh, apagir mala pisǝe kǝring andǝ apagir mala mǝsǝsa, agir'nkila, andǝ apagir mala girnùná, komǝye ka a pwari male mǝnana kārǝ́ nǝi ka. <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />Acilia alamsan mana à kwakia ka à nda ka, Sabbat mala Yahweh, andǝ aɓoro ma'wun, andǝ apagir mala lùmsǝ apacau nǝ-shambum ma'wun, andǝ apagir ma'wun mala eare mala ɓabum wun, mǝnana wun nǝ̀ pam Mim Yahweh ka.<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />&lt;&lt;A lum-bwamdǝ-tongnoia pwari mala tongno-nong-ɓaria zongŋo, lang wu pwanǝna agirɓaban mala nzali ma'wun ngga, wun nǝ̀ pàkkiɗire lamsan mem Yahweh aɓa nongŋo tongno-nong-ɓari. A pwari mǝdǝmbe ka, wun nǝ̀ twal usǝlǝo kat-kat, sǝ a tongno-nong-tàruià nongŋo ka nǝ̀ duk pwari usǝlǝo ɗǝm kat-kat. <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />A mǝno yì pwari mǝdǝmbe ka, wun nǝ̀ tù aɓǝla anggun mǝɓoarsǝne andǝ abú nggun nkangga, andǝ abú nggun mǝnana nǝ ambui kpǝm arǝì ka, andǝ ambú girpwala mana à kǝ gul a kún myalmúr ka, sǝ wu pakkiɗire nǝ banɓoarnado a ɓadǝm Yahweh Ɓakuli ma'wun aɓa nongŋo tongno-nong-ɓari. <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />Wun nǝ̀ pàkkiɗire male kǝla lamsan abanam Yahweh aɓa nongŋo tongno-nong-ɓari aɓa pǝlǝa. Dumǝna nggurcau tàtǝ́k arǝ anza ma'wun kat; wun nǝ̀ pakkiɗire male a tongno-nong-ɓaria zongŋo. <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />Wun nǝ̀ do aɓalǝ agumli aɓa nongŋo tongno-nong-ɓari. Aɓwana mǝnana kat à ɓǝlia amǝ Isǝrayila na ka, dumǝna púp à nǝ̀ do aɓalǝ agumli, <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />ace mǝnana anza ma'wun ɓǝà sǝlǝ ama ǝn tsǝk amǝ Isǝrayila à do aɓalǝ agumli lang ǝn pusǝia à purî ɓá nzali Masar ka: Mǝ nda Yahweh Ɓakuli ma'wun.&gt;&gt;<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />Anggo sǝ Musa hama amǝ Isǝrayila alamsan mana Yahweh kwakia ka.<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s">Ɗenyinǝ apitǝla mala Taragula</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />Yahweh ne Musa ama, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />&lt;&lt;Tsǝk amǝ Isǝrayila ɓǝà yinǝo nǝ mùrú mǝkware mǝnana à kambi arǝ aɓǝla-olif ka ace apitǝla, ace mǝnana abǝsa malea ɓǝà lidǝmba nǝ earke koya pwari. <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />A nza nǝ lagir<note caller="+" style="f"><char style="fr" closed="false">24:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MRK 15:38">Mar 15:38</ref>; <ref loc="HEB 6:19">Ib 6:19</ref></char>.</note> mala Akwati mala Acau-nakûn, aɓa Tara Ban-peri ka, Haruna nǝ̀ tsǝk bǝsa mala apitǝla koya pwarikpǝra ace mǝnana ɓǝà kǝ earke a ɓadǝm Yahweh ba dǝmbari, koya pwari ka. Nǝ̀ duk nggurcau tàtǝ́k arǝ anza ma'wun kat. <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />Dumǝna púp nǝ̀ kǝtǝrǝki apitǝla mǝnia sǝ nǝ̀ tamsǝkia amur gìr-tàmsǝia mǝnana à pè nǝ bolo-njengǝlan ngga, ace mǝnana ɓǝà kǝ earke a ɓadǝm Yahweh koya pwari ka.<verse eid="LEV 24:4" /></para>
  <para style="s">Bǝredi ace Taragula</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />&lt;&lt;Awu nǝ ɗàrǝ́ muku mǝɓǝlke sǝ wu pàk agbatali bǝredi lum-nong-ɓari nǝi, komǝye ka dǝmbǝrya male ɓǝ̀ pàk tyang ɓari. <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />Sǝ awu nǝ yinǝia a ɓadǝm Yahweh, awu nǝ gwalikia amur rǝarǝia arǝ abanì ɓari, tongno-nong-mwashat aɓa koya gwali amur kpamgbang-tsǝk-agir mǝnana à pè nǝ bolo-njengǝlan ngga. <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />Sǝ awu nǝ tsǝk myang-kwarra a nkanggari koya gwali, ace mǝnana atārǝia andǝ bǝredi ka, ɓǝ̀ duk kāmbe mala kasǝɓalǝu;<note caller="+" style="f"><char style="fr" closed="false">24:7 </char><char style="fq" closed="false">kāmbe mala kasǝɓalǝu </char><char style="ft" closed="false">ko &lt;&lt;pàgir mǝno kat à pà ka, eauna aban Ɓakuli ace kasǝɓalǝi arǝ ɓwa mana pà ka.&gt;&gt;</char></note> pàgir nǝ bǝsa na abanam Yahweh. <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />Koya pwari Sabbat ka, Haruna nǝ̀ gilikicia a ɓadǝm Yahweh, pà nǝ̀ ue ɗang; gìr na mǝnana dumǝna púp amǝ Isǝrayila nǝ̀ nggǝ pè kǝla kùrcau tàtǝ́k ka. <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />Sǝ bǝredi mǝno ka mala Haruna na andǝ amuni andǝ amǝkè; à nǝ̀ shè aɓa ban mǝfele, acemǝnana kāmbe nggea mǝfele male na aɓalǝ apagir nǝ bǝsa abanam Yahweh; dumǝna male, à nǝ̀ nggǝ pe wi málá male pà kàm ɗàng.&gt;&gt;<verse eid="LEV 24:9" /></para>
  <para style="s">Girkani amur patanni mǝ'mǝsǝcauni</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />A ɓè pwari ka, ɓè muna-ɓwabura mǝnana nggè ka ɓwama Isǝrayila na sǝ tárrí ka ɓwa Masar na ka, wari aɓalǝ amǝ Isǝrayila. Muna-ɓwabura mala ɓwama Isǝrayila mǝnia munǝ andǝ ɓwa Isǝrayila aɓa kàttì, <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />sǝ muna-ɓwabura mala ɓwama Isǝrayila ka pàkce lullǝ Yahweh ɓà nǝ suban.<note caller="+" style="f"><char style="fr" closed="false">24:11 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 20:7">Pur 20:7</ref>; <ref loc="LEV 24:16">Pǝris 24:16</ref>; <ref loc="NUM 15:30">Ɓal 15:30</ref>; <ref loc="1SA 3:13">1Sam 3:13</ref>; <ref loc="NEH 9:18">Nehe 9:18</ref></char>.</note> Pǝlǝa à wari nǝi aban Musa. Lullǝ ngge ndà Shelomit muna-ɓwama mala Dibǝri, a tàu mala Dan. <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />Sǝ à oasǝi a ndà, à nǝ̀ kundǝ súrǝ̀ kàne mala Yahweh amurí. <verse eid="LEV 24:12" /><verse number="13" style="v" sid="LEV 24:13" />Pǝlǝa Yahweh banggi Musa ama, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />&lt;&lt;Wu pusǝ mǝno yì ɓwa ɓǝ̀ purî ɓá kàttì, sǝ aɓwana mǝnana kat à oè ka, ɓǝà tsǝk buia amurí, sǝ ɓwabundǝa kat ɓǝà ɓukki nǝ atali. <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />Sǝ wu nunkir amǝ Isǝrayila ama ɓwa mǝnana kat tsǝk kúni arǝ Ɓakuli male ka, bafe mala cauɓikea male nǝ̀ do amurí. <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />Ɓwa mǝnana kat na mǝɓane amur lullǝ Yahweh ka, dumǝna púp à nǝ̀ wal-luí. Ɓwabundǝa kat nǝ̀ ɓukki. Ko ɓǝ̀ ɓwa-kúnɗàngna na ko ɓwa Isǝrayila na, sǝ na mǝɓane amur lullǝ Yahweh ka, à nǝ̀ wal-luí.<verse eid="LEV 24:16" /></para>
  <para style="s">Mǝsǝu ace mǝsǝu</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />&lt;&lt;Ɓwa mǝnana wal-lú ɓi ka, à nǝ̀ wal-luí. <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />Ɓwa mǝnana wal-lú girkusǝu ka, nǝ̀ mbwe girkusǝu. <verse eid="LEV 24:18" /><verse number="19" style="v" sid="LEV 24:19" /><note caller="+" style="f"><char style="fr" closed="false">24:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 21:24">Pur 21:24</ref>; <ref loc="DEU 19:19-21">Nggur 19:19-21</ref>; <ref loc="MAT 5:38-39">Mat 5:38-39</ref>; <ref loc="MAT 7:12">7:12</ref></char>.</note>Ɓǝ̀ ɓwa tsǝkî ɓì npenye ka, gìr mǝnana pakkî ɓì ka, nda à nǝ̀ pàkki wi ka. <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />À nǝ̀ ɓun mǔ ace ɓun mǔ, mǝsǝu ace mǝsǝu, minǝu ace minǝu; gìr mǝnana kat ɓwa pakkî ɓì ka, kǝ nda à nǝ̀ pàkki wi ka. <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />Ɓwa mǝnana kat wal girkusǝu ka, nǝ̀ mbwe girkusǝu, sǝ ɓwa mǝnana wal-lú ɓwa ka à nǝ̀ wal-luí.<note caller="+" style="f"><char style="fr" closed="false">24:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 35:30-33">Ɓal 35:30-33</ref></char>.</note> <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />Kǝ nzongcau mǝmwashati na amur ɓwa-kúnɗàngna ko ɓwa Isǝrayila, acemǝnana mǝ nda Yahweh Ɓakuli ma'wun.&gt;&gt; <verse eid="LEV 24:22" /><verse number="23" style="v" sid="LEV 24:23" />Pǝlǝa Musa banggi amǝ Isǝrayila, sǝ à pusǝ ɓwa mǝno namǝɓane ka anzǝm kàttì, sǝ à ɓukki nǝ atali. Anggo sǝ amǝ Isǝrayila pǎ kǝla mǝnana Yahweh ne Musa ka.<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s">Pǝlǝa mana Sabbat na ka</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />Yahweh banggi Musa cau amur Nkono Saina ama, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama, lang wu yina aɓa nzali mǝnana ǝn pà wun ngga, wu nying nzalî ɓǝ̀ kum usǝlǝo mala Sabbat abanam Yahweh. <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />Wun nǝ̀ ɓealɓeale arǝ aɓaban ma'wun aɓa pǝlǝa tongno-nong-mwashat, sǝ wun nǝ̀ kpaliki anggun anap ma'wun sǝ wun nǝ̀ pwan ɓǝlea aɓa pǝlǝa tongno-nong-mwashat, <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />sǝama tongno-nong-ɓaria pǝlǝa ka, nǝ̀ duk Sabbat mala usǝlǝo kat-kat ace nzalî abanam Yahweh.<note caller="+" style="f"><char style="fr" closed="false">25:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 16:31">Pǝris 16:31</ref></char>.</note> Aɓalǝi ka pà wu nǝ̀ ɓealɓeale a ɓaban ko wun nǝ̀ kpaliki anggun anap ma'wun ɗàng. <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />Pà wu nǝ̀ pwàn gìr mǝnana gul a nkwalo anzǝm ram girɓaban ma'wun ngga ɗàng, sǝ pà wu nǝ̀ tùki aɓǝla nggun-anap mǝnana wu kpaliki abui raka ɗàng. Pǝlǝê ka nǝ̀ duk mala usǝlǝo kat-kat ace nzalî. <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />Pǝlǝa mala Sabbat mala nzali ka nǝ̀ pusǝ girlina ace wun, ace aguro ma'wun andǝ amǝ'túró-boalo ma'wun aburana andǝ amamǝna, andǝ abǝri mǝnana à do aɓalǝ wun ngga, <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />sǝ ace anyam-lǝsǝa ma'wun andǝ anyam-ɓabondo mǝnana a nzali ma'wun ngga: gìr mǝnana kat nzali nǝ̀ pusǝ ka girlina na.<verse eid="LEV 25:7" /></para>
  <para style="s">Pǝlǝa mala Pàkkiɗire-banɓoarnado</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />&lt;&lt;Wun nǝ̀ ɓal alimo Sabbat mala apǝlǝa, apǝlǝa tongno-nong-ɓari kusǝ tongno-nong-ɓari, ace mǝnana anonggio mala alimo Sabbat mala apǝlǝa ka, à nǝ̀ pà wun apǝlǝa lumi-ine bwamdǝ tongno-nong-ine (49). <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />Sǝ a lumia pwari mala tongno-nong-ɓaria zongŋo,<note caller="+" style="f"><char style="fr" closed="false">25:9 </char><char style="fq" closed="false">a lumia pwari mala tongno-nong-ɓaria zongŋo </char><char style="ft" closed="false">mala lumi-tongnoia pǝlǝa</char></note> mǝnana nda Pwari mala Shawuɗiban ngga, wun nǝ̀ twang njawe ɓǝ̀ ɓua ɓua-mǝcandǝe. Dumǝna púp amǝnia yì Pwari ka wun nǝ̀ twang njawe aɓa nzali ma'wun kat. <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />Wun nǝ̀ tàr mǝnia yì lumi-tongnoia pǝlǝa ka, sǝ wun nǝ̀ hamnǝ kumɓamuru aɓa nzali kat ace aɓwana andǝ agir mǝnana kat à ndanǝdo aɓalǝi ka. Nǝ̀ duk pǝlǝa mala pàkkiɗire-banɓoarnado ace wun. Aɓa pǝlǝa mǝnia ka, koya nzali mǝnana kat à me ka, à nǝ̀ nyesǝi ɓǝ̀ nyare a bù mǝtale mana atadǝmbe ka ko a bù amǝke, sǝ koyan mǝnana kat à me kǝla guro ka nǝ̀ nyare aban amǝɓala male. <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />Mǝno yì lumi-tongnoia pǝlǝa ka, nǝ̀ duk pǝlǝa mala pàkkiɗire-banɓoarnado ace wun. Aɓalǝi ka pà wu nǝ̀ ɓealɓeale ɗang, pà wu nǝ̀ pwàn kǝ mǝssa mǝnana gul a nkwalo ka ɗàng, sǝ pà wu nǝ̀ tùki aɓǝla nggun-anap mǝnana wu kpaliki abui raka ɗàng. <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />Mǝno yì pǝlǝa ka, mala pàkkiɗire-banɓoarnado na. Nǝ̀ duk pǝlǝa mǝfele aban wun. Kǝ gìr mǝnana ɓǝl atàrǝì a ɓaban ngga nda wun nǝ̀ lì ka.<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />&lt;&lt;A mǝnia yì pǝlǝa mala pàkkiɗire-banɓoarnado ka, koya nzali mǝnana kat à me ka, à nǝ̀ nyesǝi ɓǝ̀ nyare a bù mǝtale mana atadǝmbe ka ko a bù amǝke, sǝ koyan mǝnana kat à me kǝla guro ka, nǝ̀ nyar aban amǝɓala male. <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />Sǝ ɓǝ̀ a makkì ɓio mǝ'murkala kǝgir, ko a kúr kǝgir a bù ɓio mǝ'murkala ka, cè a tǝpǝri ɗàng. <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />Ɓǝ̀ a kúr nzali a bù ɓio mǝ'murkala ka, kúrè ka nǝ̀ kārǝa arǝ lakkì mala apǝlǝa mana à kutikio anzǝm pàkkiɗire-banɓoarnado mǝ'nzǝ́moè ka. Sǝ yì ka nǝ̀ makko wi amur làkkì mala apǝlǝa mǝnana à ueo sǝ ɓè pàkkiɗire-banɓoarnado yiu ka. <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />Ɓǝ̀ apǝlǝe na pas ka, awu nǝ eamsǝ kúrè, sǝ ɓǝ̀ à nda kpokyak ka, awu nǝ sulǝ kúrè, acemǝnana làkkì mala apǝlǝa mala pwan girɓaban na kǝ makkò ka. <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />Pà wu nǝ̀ tǝpǝri rǝarǝ wun ɗàng; wun nǝ̀ ɓanggi Ɓakuli ma'wun, acemǝnana Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />&lt;&lt;Ɓǝ̀ wu earce do jam aɓa nzali ka, dumǝna púp wun nǝ̀ bwal anê mem, sǝ wun nǝ̀ kpata acau mem, sǝ wun nǝ̀ peǎ. <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />Nzali ka nǝ̀ pà ɓǝle, sǝ wun nǝ̀ lì, wun nǝ̀ ɗǝmbo, sǝ wun nǝ̀ duk jam. <verse eid="LEV 25:19" /><verse number="20" style="v" sid="LEV 25:20" />Sǝ ɓǝ̀ wu na ama, &lt;Mana sǝm nǝ̀ lǐ aɓa tongno-nong-ɓaria pǝlǝa, yi mǝnana sǝm ɓealɓeale ko sǝm pwan girɓaban raka?&gt; <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />Mǝ nǝ tsǝkî nzali buam aɓa tongno-nong-mwashatia pǝlǝa, wun nǝ̀ pwan girlina mǝnana nǝ̀ linǝ wun, aɓalǝ apǝlǝa tàrú ka. <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />Sǝ lang wu ɓealɓeale a tongno-nong-tàruià pǝlǝa ka, wun nǝ̀ pwan girlina, mǝnana nǝ̀ yia kum mǝ'e mana wu pwan a tongno-nong-mwashatia pǝlǝa ka, sǝ wun nǝ̀ kum kpǝm mǝnana wun nǝ̀ lǐ nǝ̀ kánǝ wun a tongno-nong-inea pǝlǝa, a bàkú mala pwan gìrɓaban male ka.<verse eid="LEV 25:22" /></para>
  <para style="s">Akmúr girkuma</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />&lt;&lt;Pà wu nǝ̀ mak nzali ɓǝ̀ duk mala ɓwa tàtǝ́k ɗàng, acemǝnana nzali ka mema. Wun ngga, wu nda ka abǝri, sǝ wu yiu a dola atàm.<note caller="+" style="f"><char style="fr" closed="false">25:23 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CH 29:15">1Acau 29:15</ref>; <ref loc="HEB 11:13">Ib 11:13</ref></char>.</note> <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />Sǝ aɓa nzali mǝnana kat nda a bù wun ngga, dumǝna púp wu sǝlǝ ama ɓǝ̀ ɓwa makkò ɓè bare nzali ka ndanǝ njar nǝ̀ nyare nǝ̀ kúrí ɗǝm a buo, ɓǝ̀ earce ka.<verse eid="LEV 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25" />&lt;&lt;Ɓǝ̀ tǝ̀r tsǝk ɓio ɓwa Isǝrayila sǝ mak bare nzali male ka, ɓwa mǝnana ɓǝla li-gìr-lú male na ka ɓǝ̀ akmúr gìr mǝnana mǝ'eambi mangŋǝ́nì ka. <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />Sǝ ɓǝ̀ ɓwe panǝ kǝɓwa mǝnana nǝ̀ akmúr nzalinì raka, sǝ nǝnzǝ́mò ka yi kumbu sǝ kum gìr mǝnana kārǝa nǝ̀ kúrí nǝi ka, ɓǝ̀ nyare ɓǝ̀ akmúrí. <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />Ɓǝ̀ ɓal apǝlǝa, twal a pwari mana mangŋǝna nzalî nǝi ka, sǝ ɓǝ̀ mbwe cili boalo ace apǝlǝa mǝnana ueo aban ká ɓè pàkkiɗire-banɓoarnado ka, aban ɓwa mana kúrí ka, sǝ ɓǝ̀ nyesǝ girkuma male. <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />Sǝ ɓǝ̀ pànǝ boalo mana kārǝa nǝ̀ akmúr nzalî raka, ɓǝ̀ nyi a bu ɓwa mǝnana kúrí ka she ɓǝ̀ pǝlǝa mala pàkkiɗire-banɓoarnado karna ka. Aɓa pǝlǝa mala pàkkiɗire-banɓoarnado ka, à nǝ̀ nyinggi wi girkuma male ɓǝ̀ nyar a buì.<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />&lt;&lt;Ɓǝ̀ ɓwa mak ɓala-do male, aɓa nggea-là mǝnana à kàrì nǝ sheran ngga, nǝ̀ gandǝ nyare nǝ̀ akmúrí aɓa kǝ pǝlǝa mana mé nǝi ka. Aɓa pǝlǝa kat ka, ndanǝ njar mala nyare nǝ̀ akmúr girkuma male. <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />Ɓǝ̀ à gandǝ akmúr ɓalae aɓa lumsǝo mala pǝlǝa mwashat raka, ɓalae aɓa nggea-là mana à kàrì nǝ sheran ngga, nǝ̀ duk mala ɓwa mǝnana kúrí ka andǝ amuni andǝ amǝkè tàtǝ́k; à pà nǝ̀ akmúrí aɓa pǝlǝa mala pàkkiɗire-banɓoarnado ɗang. <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />Sǝ aɓala mǝnana à nda arǝ amuna-là mǝnana à kàriá nǝ sheran raka, à nǝ̀ twalia à nda mwashat andǝ aɓaban mala nzalinì. À nǝ̀ gandǝ akmúria, sǝ à nǝ̀ gandǝ nyesǝia aɓa pǝlǝa mala pàkkiɗire-banɓoarnado. <verse eid="LEV 25:31" /><verse number="32" style="v" sid="LEV 25:32" />Sǝama Amǝ'Lawi ka à ndanǝ njar koya pwari à nǝ̀ akmúr aɓala malea aɓalǝ anggea-là mǝnana à tsǝia kàm ngga. <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />Sǝ ɓǝ̀ ya ɓala aɓa mwashat atà anggea-là mǝnia Ɓwa-lawi me sǝ à akmúrí raka, dumǝna púp à nǝ̀ nyesǝi aɓa pǝlǝa mala pàkkiɗire-banɓoarnado, acemǝnana aɓala mǝnana amala Amǝ'Lawi na aɓalǝ anggea-là ka, agirkuma malea na aɓalǝ amǝ Isǝrayila. <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />Amur mani ka, anzali yál-agir mala anggea-là malea ka, dumǝna púp à pà nǝ̀ mea ɗàng acemǝnana girkuma malea na tàtǝ́k.<verse eid="LEV 25:34" /></para>
  <para style="s">Pěmǝɓoarne aban mǝ'eambu mana mǝ'tǝ̀r na ka</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />&lt;&lt;Ɓǝ̀ ɓekǝ ɓwa atà amǝ'eam wun duk mǝtǝ̀r sǝ gandǝ pàkki ɓamúrì gbasha raka, dumǝna púp wun nǝ̀ pe wi gbasha kǝla mǝnana wun nǝ̀ pàkkî bǝri, sǝ ɓwa kúnɗàngna mana yiu a dola aɓalǝ wun ngga. <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />Wu kǝa ligir arǝì ɗàng, sǝ wu kǝa ak kǝ mùr amúr tangna mǝnana wu pe wi ka ɗàng. A kún mani ka wu ɓanggi Ɓakuli ma'wun, ace mǝnana mǝ'eam wun ngga ɓǝ̀ do a nkanggari wun. <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />Kǝa pe wi tangna boalo nǝ alta mùr amurí ɗàng, sǝ kǝa pe wi girlina ace kum ligir arǝì ɗàng. <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />Mǝ nda Yahweh, Ɓakuli ma'wun, mǝnana pusǝ wun aɓa nzali Masar, ace pà wun nzali Kan'ana, sǝ mǝ duk Ɓakuli ma'wun ngga.<verse eid="LEV 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />&lt;&lt;Ɓǝ̀ mǝ'eambo duk mǝ'tǝ̀r a nkanggario, sǝ makko ɓamúrì ka, kǝa tsǝì ɓǝ̀ pàkkô túró kǝla guro ɗàng. <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />Sǝama ɓǝ̀ do kǝla mǝ'túró-boalo atò, sǝ kǝla bǝri mana yiu ace dola ka. Nǝ̀ pàktúró atò ba pǝlǝa mala Pàkkiɗire-banɓoarnado. <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />Sǝ yì andǝ amuni ka, à nǝ̀ purî ɓala mò, à nǝ̀ nyar aban aɓwana male, a tàu male, sǝ a nzali mala akê. <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />Yia ka aguro mema, mǝnana ǝn pusǝia à purî ɓá nzali Masar ka; à pà nǝ̀ mea ɓǝà o a guro ɗàng. <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />Pà wu nǝ̀ yálmuria nǝ ɗwanyi sǝn mǝsǝswatǝr ɗàng, wu ɓanggi Ɓakuli ma'wun. <verse eid="LEV 25:43" /><verse number="44" style="v" sid="LEV 25:44" />Aguro mò aburana andǝ amamǝna mǝnana awu nǝ pàngŋǝ́nǝia ka, awu nǝ kúria arǝ anzali mǝnana à kàrì wun ngga. <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />Awu nǝ gandǝ kúr gbal atà amǝ'kúnɗàngna mǝnana à yiu a dola atà wun ngga, sǝ amǝɓala malea mǝnana à nda atà wun, mǝnana à ɓǝlia a nzali ma'wun ngga, à nǝ̀ duk agirkuma ma'wun. <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />Wun nǝ̀ gandǝ nyinggi amuna ma'wun kǝla agirkuma malea, mǝnana à nǝ̀ duk aguro a buia tàtǝ́k ka. Sǝama mala amǝ'eam wun, amǝ Isǝrayila ka, kǝɓwa pà nǝ̀ yálmúr ɓì nǝ ɓikido ɗàng.<verse eid="LEV 25:46" /></para>
  <para style="s">Akmúr mǝ'tǝ̀r</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />&lt;&lt;Ɓǝ̀ bǝri ko ɓwa-kúnɗàngna mǝnana nda dola aɓalǝ wun, pǝlǝ mǝkume, sǝ mǝ'eam wun mǝnana a nkanggari ka pǝlǝ mǝ'tǝ̀r sǝ mak ɓamúrì aban bǝri ko ɓwa-kúnɗàngna mǝnia mana ndanǝdo aɓalǝ wun ngga, ko aban ɓeɓwa a tàu mala bǝri mǝnia ka, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />nǝ̀ do ama, anzǝm mana mangŋǝna ɓamúrì ka, ndanǝ njar a bui nǝ̀ akmúr ɓamúrì. Mwashat atà amǝ'eambi nǝ̀ gandǝ akmúrí, <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />ko kine ko muna mala kine ka nǝ̀ gandǝ akmúrí, ko ɓeɓwa atà acili aɓǝla-nggurkwar ko amǝɓala male nǝ̀ gandǝ akmúrí; ko ɓǝ̀ yì ka yi kum gìrbu ka, nǝ̀ gandǝ akmúr ɓamúrì. <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />Yì ka nǝ̀ tàɓala andǝ ɓwa mǝnana kúrí ka amur kúró kum-ɓamúrû male twal a pǝlǝa mǝnana mangŋǝna ɓamúrì nǝi ka aban ká a pǝlǝa mala Pàkkiɗire-banɓoarnado, sǝ kúrè ka nǝ̀ pa kǝla mana làkkì mala apǝlǝe pàk ka. Kúró mala kumɓamuru male ka, à nǝ̀ kārǝí arǝ tangnakusǝu mana à kǝ mbwe mǝ'túró-boalo nǝi ka. <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />Ɓǝ̀ apǝlǝa nakam pas piu mana à ue ka, boalo mana nǝ̀ mbwe ace akmúr ɓamúrì ka nǝ̀ pàk kpǝm. <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />Sǝ ɓǝ̀ apǝlǝe ue kpokyak sǝ pǝlǝa mala Pàkkiɗire-banɓoarnado nǝ̀ yiu ka, boalo mana nǝ̀ mbwe ace akmúr ɓamúrì ka nǝ̀ pàk bǝti. <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />Yì bǝri ka dumǝna púp nǝ̀ pàngnǝi kǝla mǝtúró mana à twali a túró-boalo sǝ à kǝ mbwe a masǝlǝata koya pǝlǝa ka. Pà nǝ̀ yálmúrí nǝ ɗwanyi sǝn mǝsǝswatǝr ɗàng. <verse eid="LEV 25:53" /><verse number="54" style="v" sid="LEV 25:54" />Sǝ ɓǝ̀ à akmúrí nǝ mǝno yì anjar raka, yì andǝ amuni ka, à nǝ̀ panzǝia aɓa pǝlǝa mala Pàkkiɗire-banɓoarnado. <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />Mǝ nda mǝnana amǝ Isǝrayila nda ka aguro abanam ngga. À nda ka aguro mem mǝnana ǝn pusǝia à purî ɓá nzali Masar ka: Mǝ nda Yahweh Ɓakuli ma'wun.<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s">Tangnakusǝu mala okiru</para>
  <para style="sp">Yahweh bang ama:</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />&lt;&lt;Pà wun nǝ̀ pàkkî ɓamur rǝ wun ɓekǝ nkul ɗang,<note caller="+" style="f"><char style="fr" closed="false">26:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:3-4">Pur 20:3-4</ref>; <ref loc="PSA 81:9">Ang 81:9</ref></char>.</note> sǝ pà wun nǝ̀ shàr ɓekǝ ɓǝ̀nzál, ko wun nǝ̀ tamsǝ ɓekǝ nggun ko tali, ko wun nǝ̀ tsǝk kǝ kúnamúrú a nzali ma'wun ace mǝnana wun nǝ̀ peri abania ka ɗàng. Mim Yahweh ka, mǝ nda Ɓakuli ma'wun. <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />Dumǝna púp wun nǝ̀ kpata nzongcau mala Sabbat, yì pwari usǝlǝo, sǝ wun nǝ̀ dum nǝ pagulo arǝ Ban Mǝfele mem: Mǝ nda Yahweh.<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />&lt;&lt;Ɓǝ̀ wu bwal anggurcau mem, sǝ wu kpata anzongcau mem, wu pea ka, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />mǝ nǝ tsǝa mbulo ma'wun nǝ̀ nggǝ nyaka wun a kúnì male, sǝ nzali ma'wun nǝ̀ pusǝa wun ɓǝle, sǝ anggun ɓaban ma'wun nǝ̀ pà ɓǝlea. <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />Kúnì mala nyamessa nǝ̀ sauwa nǝ̀ ká a kúnì mala pwan ɓǝlanggun anap, sǝ kúnì mala pwan ɓǝlanggun anap ka, nǝ̀ sauwa nǝ̀ ká a kúnì mala ɓealɓeale; anggo ka wun nǝ̀ li girlina sheɓǝ̀ wu ɗǝmna ka; wun nǝ̀ do aɓa rǝpwala, kǝ mǝɓane pà nǝ̀ yiu arǝ wun ɗàng. <verse eid="LEV 26:5" /><verse number="6" style="v" sid="LEV 26:6" />Mǝ nǝ pà wun dorǝpwala aɓa nzali ma'wun, wun nǝ̀ nongnǝ-nongŋo sǝ kǝ ɓwa pà nǝ̀ yipa wun nǝ̀ ɓekǝ gìr pà ɓangciu ɗàng; mǝ nǝ pǝr anyamɓikea ɓǝà upi nzali ma'wun, sǝ nggeabyau mala ɓiu-mǝbura pa nǝ̀ kùtí a nzali ma'wun ɗàng.<note caller="+" style="f"><char style="fr" closed="false">26:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 30:10">Ir 30:10</ref>; <ref loc="EZK 34:25">Ezǝk 34:25</ref>,<ref loc="EZK 34:28">28</ref>; <ref loc="MIC 4:4">Mik 4:4</ref></char>.</note> <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />Wun nǝ̀ pǝrta aɓiwun amǝbura, sǝ nggeabyau ma'wun nǝ̀ gandǝia, à nǝ̀ kpaki a ɓadǝm wun. <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />Aɓwana ma'wun tongno nǝ̀ loasǝtà aɓwana gbǝman, sǝ aɓwana ma'wun gbǝman nǝ̀ loasǝtà aɓwana á-lum, sǝ nggeabyau ma'wun nǝ̀ gandǝ aɓiwun amǝbura, à nǝ̀ sukki a nzali a ɓadǝm wun.<note caller="+" style="f"><char style="fr" closed="false">26:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 3:22">Nggur 3:22</ref>; <ref loc="DEU 32:30">32:30</ref>; <ref loc="JOS 10:19">Jes 10:19</ref>; <ref loc="JOS 23:3">23:3</ref>,<ref loc="JOS 23:10">10</ref></char>.</note> <verse eid="LEV 26:8" /><verse number="9" style="v" sid="LEV 26:9" />Earmúrú mem nǝ̀ sulǝ amur wun, sǝ mǝ nǝ tsǝk wun, wun nǝ̀ ɓǝla, wun nǝ̀ hatǝki; mǝ nǝ bwal kùrcau mem mǝnana ǝn pê nǝ wun ngga. <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />Wun nǝ̀ nggǝ li mǝssa mǝnana wu soe a bah aɓa pǝlǝa mǝnana kútí ka, gandǝa wun nǝ̀ pusǝ mǝssa mǝ'e a bah ace mǝnana wun nǝ̀ so bǝshe ka. <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />Mǝ nǝ tsǝk Taragula mem, yì bando mem<note caller="+" style="f"><char style="fr" closed="false">26:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 25:8">Pur 25:8</ref>; <ref loc="EXO 29:45-46">29:45-46</ref>; <ref loc="LEV 26:44">Pǝris 26:44</ref>; <ref loc="1KI 6:13">1Amur 6:13</ref></char>.</note> aɓalǝ wun sǝ pà mǝ nǝ ɓinǝki wun ɗàng. <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />Mǝ nǝ gya aɓalǝ wun sǝ mǝ nǝ duk Ɓakuli ma'wun, sǝ wun ngga, wun nǝ̀ duk aɓwana mem.<note caller="+" style="f"><char style="fr" closed="false">26:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JER 7:23">Ir 7:23</ref>; <ref loc="LUK 1:68">Luk 1:68</ref>; <ref loc="2CO 6:16">2Kor 6:16</ref>; <ref loc="REV 21:3">Sǝn 21:3</ref></char>.</note> <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />Mǝ nda Yahweh Ɓakuli ma'wun, mǝnana pusǝ wun, wu purî ɓá nzali Masar, ace mǝnana wu kǝa duk aguro malea raka. <note caller="+" style="f"><char style="fr" closed="false">26:13 </char><char style="ft" closed="false">Ko </char><char style="fqa">Ən ɓungi rǝcandǝa malea mǝnana par wun ngga, sǝ ǝn panzǝ wun, ǝn tsǝk wun ɓǝ̀ wu gya aɓa makrǝu ɓangciu pà kàm ɗàng</char>.</note>Ən ɓungi agara-bolo mala nggun-rya malea a myal wun, sǝ ǝn tsǝk wun, wu ging pǝrapǝra.<verse eid="LEV 26:13" /></para>
  <para style="s">Kwarkiru ace ɗwanyi okî Yahweh</para>
  <para style="sp">Yahweh bang ama:</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />&lt;&lt;Sǝama ɓǝ̀ wu mgbikamkiru, wu ginǝ bwal anzongcau mem mǝnia kat, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />sǝ ɓǝ̀ wu ginǝ anê mem, sǝ yilǝmi wun nǝ̀ ɓinǝce anggurcau mem, mǝnana à nǝ̀ kánǝ wun a ɗwanyi kpata atsǝkcau mem, sǝ wun nǝ̀ panzǝki kùrcau mem ngga, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />Mim a buì mem ngga mǝ nǝ pàkka wun agir mǝnia ka: Mǝ nǝ tasǝ gìr'mur'mwana<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 78:33">Ang 78:33</ref>; <ref loc="JER 15:8">Ir 15:8</ref></char>.</note> hǝrkit amur wun, mǝ nǝ kwak wun nǝ kwánó mǝnana pà nǝ̀ mal ɗang, andǝ ɓauwa mǝnana nǝ̀ dumsǝ wun a nte<note caller="+" style="f"><char style="fr" closed="false">26:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:21">Nggur 28:21</ref></char>.</note> andǝ do-tikimúrú ka. Wun nǝ̀ ɓeal mǝsǝɓeale ma'wun ɓà acemǝnana aɓiwun-amǝbura nǝ̀ ya lì gìr mǝnana ɓǝl ka. <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />Mǝ nǝ pǝlǝa wun nzǝmam,<note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">Ko</char><char style="fqa">Mǝ nǝ pǝlǝ ɓamǝsǝam arǝ wun</char>.</note> mǝ nǝ ɗeki <note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:25">Nggur 28:25</ref>; <ref loc="JDG 2:14">Akas 2:14</ref>; <ref loc="JER 19:7">Ir 19:7</ref></char>.</note>aɓiwun-amǝbura ɓǝà gandǝ wun. <note caller="+" style="f"><char style="fr" closed="false">26:17 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="PSA 106:41">Ang 106:41</ref></char>.</note>Aɓwana mǝnana à ɓinǝmǝsǝ wun ngga, à nǝ̀ duk amǝ'yálmúr wun. Wun nǝ̀ ɓangŋa ko ɓǝ̀ ndo ama kǝɓwa pà kàm kǝ pǝrta wun raka. <verse eid="LEV 26:17" /><verse number="18" style="v" sid="LEV 26:18" />Sǝ kat andǝ amǝnia yì agir, ɓǝ̀ wu ginǝ okam ngga, mǝ nǝ lidǝmba nǝ pakka wun gìrkwanban ɗǝm mǝnana kàrmúr acauɓikea ma'wun kusǝ tongno-nong-ɓari ka. <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />Nggori andǝ murcandǝa ma'wun ngga mǝ nǝ ɓunni. Mǝ nǝ tsǝk ɓamǝsǝ kùli ma'wun nǝ̀ pàk gbǝrantang kǝla bolo-candǝa, sǝ nzali ma'wun nǝ̀ candǝ kanggǝrang kǝla bolo-bángŋá. <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />Rǝcandǝa ma'wun nǝ̀ malâ sǝ wu pàk kǝ túró ɗang: nzali ma'wun pà nǝ̀ pusǝa wun kǝ gìrɓaban ɗàng, sǝ anggun mǝnana aɓa nzali ma'wun ngga à pà nǝ̀ pà ɓǝlea ɗàng.<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />&lt;&lt;Sǝ ɓǝ̀ wu candǝcau arǝàm, wu ɓinǝ okam ngga, mǝ nǝ hatǝki tanni mǝnana kàrmúr acauɓikea ma'wun kusǝ tongno-nong-ɓari ka. <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />Mǝ nǝ tasǝ anyam-candǝa arǝ wun, à nǝ̀ yia wala wun amuna ma'wun, sǝ à nǝ̀ kiɗikia wun agirkusǝu mana wu kǝ yália ka. Aɓwana bǝti aɓalǝ wun na à nǝ̀ ueo nǝyilǝmu ka. Mǝnia ka nǝ̀ tsǝa aɓwana kpokyak na à nǝ̀ nggǝ gya amur anjargula mala nzali ma'wun ngga.<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />&lt;&lt;Sǝ kat andǝ amǝnia yì agirkwanban, ɓǝ̀ wu ginǝ nyare abanam, wu lidǝmba nǝ mgbicau arǝàm ngga, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />mim gbal ka mǝ nǝ camba wun a nggaro; mim nǝ nggearǝam mǝ nǝ kwak wun nǝ tanni mana kàrmúr acauɓikea ma'wun kusǝ tongno-nong-ɓari ka. <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />Mǝ nǝ yinǝ lwa amur wun mǝnana nǝ̀ mbwe wun a kúnì mǝɓane mana wu pè, mala yàl anzongcau mana ǝn tsǝka wun aɓa kùrcau mana ǝn pangnǝ wun ngga. Ko ɓǝ̀ wu ɓangŋa wu kutiki aɓalǝ anggea-là ma'wun ngga, mǝ nǝ tasǝ rǝkwana mǝ'kiɗikibanì aɓalǝ wun, sǝ wun nǝ̀ kpa a ɓabù aɓiwun-amǝbura. <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />Mǝ nǝ tamsǝ kum girlina ma'wun, sǝ mǝnia ka nǝ̀ tsǝa ovù mwashat na amamǝna lum nǝ̀ lurǝ bǝredi mǝnana kat à ndanǝi ka. Ɓǝ̀ à nǝ̀ gakki bǝredi ka, ɓwangine na koyan nǝ̀ kum ngga. Wun nǝ̀ li, sǝ pà nǝ̀ kārǝ́ wun ɗàng.<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />&lt;&lt;Sǝ kat andǝ mǝnia ka, ɓǝ̀ pà wun nǝ̀ ok cau mem ɗàng, wu lidǝmba nǝ mgbicau arǝàm ngga, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />mǝ nǝ gingga wun a mgbasho aɓa nusǝban mala bumlulla mǝɓike, sǝ mim nǝ nggearǝam mǝ nǝ pakka wun gìrkwanban mǝnana kàrmúr acauɓikea ma'wun kusǝ tongno-nong-ɓari ka. <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />Wun nǝ̀ lì nyam amuna-burana andǝ amuna-mamǝna ma'wun.<note caller="+" style="f"><char style="fr" closed="false">26:29 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:53">Nggur 28:53</ref>; <ref loc="EZK 5:10">Ezǝk 5:10</ref>; <ref loc="2KI 6:29">2Amur 6:29</ref>; <ref loc="LAM 4:10">Keb 4:10</ref></char>.</note> <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />Mǝ nǝ kìɗìki amgbangban ndàka-lú ma'wun, mǝ nǝ kwarki agyangŋan mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ma'wun, mǝ nǝ eamsǝki alú wun amúr alú ka nkúl ma'wun, sǝ yilǝmem ngga nǝ̀ ɓinǝce wun. <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />Mǝ nǝ tsǝk <note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NEH 2:3">Nehe 2:3</ref>; <ref loc="JER 4:7">Ir 4:7</ref>; <ref loc="2KI 25:4-10">2Amur 25:4-10</ref></char>.</note>anggea-là ma'wun ɓǝà pǝlǝ ɓarwan, sǝ andaka-ankúl ma'wun ɓǝà pak kèlàngkélàng, sǝ mǝ nǝ ɓinǝce rǝmba aɓoro mǝrǝmɓoarne ma'wun. <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />Mǝ nǝ pàk nzali ma'wun kèlàngkélàng, gandǝa aɓiwun-amǝbura mǝnana à yi e a do aɓalǝi ka, nǝ̀ <note caller="+" style="f"><char style="fr" closed="false">26:32 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:37">Nggur 28:37</ref>; <ref loc="1KI 9:8">1Amur 9:8</ref>; <ref loc="JER 18:16">Ir 18:16</ref>; <ref loc="JER 19:8">19:8</ref>; <ref loc="EZK 5:15">Ezǝk 5:15</ref></char>.</note>kàrmúrià ɓǝ̀ à sǝni ka. <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />Mǝ nǝ mesǝki wun arǝ anzali, mǝ nǝ kwetǝ nggeabyau mem a ndè mǝ nǝ pǝ̀rta wun, nzali ma'wun nǝ̀ pǝlǝ ɓarwan, sǝ anggea-là ma'wun nǝ̀ pǝlǝ gìgí.<verse eid="LEV 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 26:34" />&lt;&lt;Nda wuni nzali ma'wun nǝ̀ ok banɓoarnado mala apǝlǝa Sabbat<note caller="+" style="f"><char style="fr" closed="false">26:34 </char><char style="fq" closed="false">apǝlǝa Sabbat </char><char style="ft" closed="false">Ko &lt;&lt;apǝlǝa mala usǝlǝo.&gt;&gt;</char></note> male aɓalǝ nonggio mǝnana kat nong ɓarwan, sǝ wun ngga wu nda a nzali mala aɓiwun amǝbura ka; pǝlǝa nzali ma'wun nǝ̀ usǝlǝo, sǝ nǝ̀ ok banɓoarnado mala apǝlǝa mala Sabbat male. <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />Aɓalǝ anonggio mǝnana kat nǝ̀ nong ɓarwan ngga, nzalinì nǝ̀ usǝlǝo, usǝlǝo mǝnana kumi raka aɓalǝ apǝlǝa mala Sabbat mana wu nda aban do aɓalǝi ka. <verse eid="LEV 26:35" /><verse number="36" style="v" sid="LEV 26:36" />Sǝ aɓwana atà wun mǝnana à au ka, mǝ nǝ tasǝia wia ɓabum-ɓungya aɓa ɗenyicau malea arǝ abân mǝnana à umnǝia kàm aɓalǝ anzali mala aɓia-mǝbura ka. Gì dǝurǝo mala mbu-nggun nǝ̀ loasǝtea nǝ mire, sǝ à nǝ̀ ɓangŋa kǝla ɓwa mǝnana à kǝ pǝrte a lwa ka, sǝ à nǝ̀ nggá kpa, ko ɓǝ̀-ndo ama kǝɓwa pà kàm kǝ pǝrtea raka. <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />À nǝ̀ anndǝki arǝarǝia, kǝla aɓwana mana à kǝ ɓangŋa ace apî nggeabyau ka, ko ɓǝ̀-ndo ama kǝɓwa pà kàm kǝ pǝrtea raka. Sǝ pà wun nǝ̀ gandǝ came a ɓadǝmbǝ aɓiwun amǝbura ɗang. <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />Wun nǝ̀ wukio arǝ abǝri-nzali; nzali mala aɓiwun amǝbura nǝ̀ twalta wun. <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />Sǝ cili wun mǝnana à ue nǝyilǝmu arǝ anzali mala aɓiwun amǝbura ka, à nǝ̀ twal eamdǝe atàcau mala ɓealɓikea malea, sǝ atàcau mala aɓealɓikea mala akeâ.<note caller="+" style="f"><char style="fr" closed="false">26:39 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 28:65">Nggur 28:65</ref>; <ref loc="EZK 4:17">Ezǝk 4:17</ref>; <ref loc="EZK 24:23">24:23</ref>; <ref loc="EZK 33:10">33:10</ref></char>.</note><verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />&lt;&lt;Sǝama, ɓǝ̀ à bang ɓealɓikea malea, andǝ ɓealɓikea mala atárrià andǝ mala akeâ, mǝnana à pè nǝ ɗwanyi domǝsǝcau malea abanam, andǝ pǝlǝa mǝnana à pǝlǝ arǝàm, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />sǝ tsǝa ǝn pǝlǝ arǝia, sǝ ǝn tasǝia a bǝri-nzali, aɓa nzali mala aɓia-mǝbura, sǝ ɓǝ̀ ɓabumia nǝ̀ nying candǝcau malea à nǝ̀ nongsǝmúrià, sǝ à nǝ̀ mbwegìr ace ɓealɓikea malea ka,<note caller="+" style="f"><char style="fr" closed="false">26:41 </char><char style="fq" closed="false">sǝ à nǝ̀ mbwegìr ace ɓealɓikea malea ka </char><char style="ft" closed="false">Ko &lt;&lt;à nǝ̀ ear ama à pàngŋǝ̀nà cauɓikea ka.&gt;&gt;</char></note> <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />pǝlǝa mim ngga mǝ nǝ ɗenyinǝ kùrcau mem mǝnana ǝn pê nǝ Yakupu, sǝ mǝ nǝ ɗenyinǝ kùrcau mem mǝnana ǝn pê nǝ Ishaku, andǝ kùrcau mem mǝnana ǝn pê nǝ Ibǝrayim ngga. Mǝ nǝ ɗenyinǝ gir mǝnana ǝn pacau-ace amur nzali man ngga, <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />sǝ mǝ nǝ ɗeki ɓǝ̀ ok banɓoarnado mala apǝlǝa mala Sabbat male arǝ apǝlǝa mǝnana nǝ̀ nong ɓarwan acemǝnana à pà kàm aɓa nzalinì raka, à umna a bǝri-nzali aban mbwegìr ace ɓealɓikea malea acemǝnana à ginǝki acau mem, sǝ yilǝmia ɓinǝce anê mem ngga. <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />Kat andǝ amǝno ka, ɓǝ̀ à nda kano a nzali mala aɓia-mǝbura ka, pà mǝ nǝ ginǝkia ɗàng, sǝ pà mǝ nǝ ɓinǝcea mǝnana nǝ̀ tsǝa mǝ nǝ twaltea ka ɗàng. Pà mǝ nǝ nggaɗikunam arǝ kùrcau mem<note caller="+" style="f"><char style="fr" closed="false">26:44 </char><char style="fq" closed="false">nggaɗikunam arǝ kùrcau mem </char><char style="ft" closed="false">ko &lt;&lt;panzǝki kùrcau mem&gt;&gt;</char></note> sǝnǝia ɗàng, acemǝnana mǝ nda Yahweh Ɓakuli malea. <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />Atàcau malea ka ɓalǝam nǝ̀ kasǝa arǝ kùrcau mǝnana ǝn pangnǝ akeâ, mana ǝn pusǝia à purî ɓá nzali Masar, a mǝsǝ aɓwapǝndǝa mala anzali kat, ace mǝnana ɓǝ̀ ǝn duk Ɓakuli malea ka. Mǝ nda Yahweh.&gt;&gt;<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />Amǝno ka à nda ka anê, andǝ akanìgìr andǝ anggurcau mana Yahweh pa anre andǝ amǝ Isǝrayila nǝ bu Musa amur Nkono Saina ka.<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s">Pàcau aban Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />Yahweh nacau nǝ Musa ama, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama, &lt;Lang à pànà ɓwa ace lùmsǝ pàcau nǝ-shambum mǝnana ɓeɓwa pà abanam, Mim Yahweh ka, ɓwa mǝno à pà ka, à nǝ̀ gandǝ panzǝe nǝ mbwe boalo mǝnana à kasǝ ka. <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />Boalo mǝnana à kasǝa à nǝ̀ mbwe ka ɓǝà kārǝí arǝ shekel, yì mǝsǝbolo-azǝrfa mǝnana à kārǝ́ dǝmbǝrya male sǝ à earna amurí a Tara-mǝfele ka:</para>
  <para style="li" vid="LEV 27:3">shekel lumi-tongno (50) a kúnì ɓwabura mana pǝlǝa ɓǝlban male ka nda lumi-ɓari aban ká lumi-tongno-nong-mwashat ka;<verse eid="LEV 27:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="LEV 27:4" />shekel lumi-tàrú (30) a kúnì ɓwama mana pǝlǝa ɓǝlban male ka nda lumi-ɓari aban ká lumi-tongno-nong-mwashat ka;<verse eid="LEV 27:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="LEV 27:5" />shekel lumi-ɓari (20) a kúnì lagga mana pǝlǝa ɓǝlban male ka nda tongno aban ká lumi-ɓari ka;</para>
  <para style="li" vid="LEV 27:5">shekel lum (10) a kúnì nsari mana pǝlǝa ɓǝlban male ka nda tongno aban ká lumi-ɓari ka;<verse eid="LEV 27:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="LEV 27:6" />shekel tongno (5) a kúnì muna-ɓwabura mana pǝlǝa ɓǝlban male ka nda zongŋo mwashat aban ká tongno ka;</para>
  <para style="li" vid="LEV 27:6">shekel tàrú (3) a kúnì muna-ɓwama mana pǝlǝa ɓǝlban male ka nda zongŋo mwashat aban ká tongno ka;<verse eid="LEV 27:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="LEV 27:7" />shekel lum-nong-tongno (15) a kúnì ɓwabura mǝnana pǝlǝa ɓǝlban male ka kutini lumi-tongno-nong-mwashat (60) ka;</para>
  <para style="li" vid="LEV 27:7">shekel lum (10) a kúnì ɓwama mǝnana pǝlǝa ɓǝlban male ka kutini lumi-tongno-nong-mwashat (60) ka.<verse eid="LEV 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 27:8" />&lt;&lt; &lt;Ɓǝ̀ ɓwa ka tǝ̀r male ɓikipa mǝnana pà nǝ̀ gandǝ mbwe boalo mana à kasǝa ace panzǝ ɓwa ɓǝ̀ purî pàcau mǝnana pà ka raka, yì ka ɓǝ̀ yinǝ ɓamúrì a ɓadǝm pǝris, sǝ pǝris nǝ̀ kasǝ boalo mǝnana sǝni ɓwê mana pàcau ka nǝ̀ gandǝ mbwe ka.<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />&lt;&lt; &lt;Ɓǝ̀ pàcau mala ɓwa ka girkusǝu na mǝnana à nǝ̀ pa kǝla pàgir abanam Yahweh ka, mǝno yì girkusǝu à pà ka pǝlǝna mǝfele. <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />Ɓwê pà nǝ̀ nggaɗi, ko nǝ̀ yinǝ ɓe a kúnì ɗàng, ko mǝɓoarne a kúnì mǝɓane, ko mǝɓane a kúnì mǝɓoarne; sǝ yale ɓǝ̀ ɓwê nggaɗi kǝ girkusǝu a kúnì ɓè ka, girkusǝunì andǝ mǝno à nggaɗi ka, yia kǝm à pǝlǝna mǝfele. <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />Sǝ ɓǝ̀ girkusǝunì ka mǝɓeami<note caller="+" style="f"><char style="fr" closed="false">27:11 </char><char style="fq" closed="false">mǝɓeami </char><char style="ft" closed="false">ka nda gìr mǝnana Ɓakuli pa nǝ̀ é abaní ko ace pà gìr'nkila raka, ko mǝnana Ɓakuli pǝrban arǝ li ka.</char></note> na mǝnana à pà nǝ̀ pànàɓoro nǝi abanam, Mim Yahweh raka, ɓwê nǝ̀ tamsǝ girkusǝunì a ɓadǝm pǝris, <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />sǝ yì pǝris ka nǝ̀ sǝn mana ɓoaro ko ɓike arǝ girkusǝunì sǝ nǝ̀ kasǝ kúrè; gìr mǝnana kat pǝris kasǝa ama nda kúrè ka anggo sǝ nǝ̀ pa. <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />Sǝ ɓǝ̀ ɓwê earce ama nǝ̀ akmúr girkusǝu mana pànà ka, dumǝna púp ama nǝ̀ mbwe boale sǝ nǝ̀ tsǝk banì mwashat aɓa gauwe tongno mala boale amurí.<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />&lt;&lt; &lt;Lang ɓwa tàr ɓala male sǝ pà kǝla pàgir mǝfele abanam Yahweh ka, pǝris nǝ̀ ká nǝ̀ sǝn mana ɓoaro ko ɓike arǝ ɓalanì sǝ nǝ̀ kasǝ kúrè; gìr mǝnana kat pǝris kasǝa ama nda kúrè ka anggo sǝ nǝ̀ pǎ. <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />Sǝ ɓǝ̀ ɓwê earce ama nǝ̀ akmúr ɓala mana pànà ka, dumǝna púp ama nǝ̀ mbwe boale sǝ nǝ̀ tsǝk banì mwashat aɓa gauwe tongno mala boale amurí.<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />&lt;&lt; &lt;Ɓǝ̀ ɓwa tàr ɓe bare nzali mǝnana girkuma male na sǝ pàmì ɓǝ̀ duk mem, Mim Yahweh ka, pǝris nǝ̀ karǝ boale arǝ gulo mala mǝsǝɓeale mǝnana à nǝ̀ ɓeali aɓalǝi ka. Tyang lumi-ɓari (20) mala mǝsǝ mǝssa bálì ka shekel lumi-tongno (50) mala mǝsǝbolo-azǝrfa na. <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />Ɓǝ̀ ɓwê tàr nzali mǝnia aɓa pǝlǝa mala pàkkiɗire-banɓoarnado ka, boalo mǝnana pǝris kasǝa ama nda kúrè ka camna anggo. <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />Sǝ ɓǝ̀ nda anzǝm pǝlǝa mala pàkkiɗire-banɓoarnado sǝ ɓwê tàr nzali male ka, pǝris nǝ̀ kasǝ boale aɓa kpata làkkì mala apǝlǝa mǝnana à ueo sǝ à nǝ̀ bik ɓè pǝlǝa mala pàkkiɗire-banɓoarnado ka, sǝ à nǝ̀ amsǝ ɓegìr aɓa boale. <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />Sǝ ɓǝ̀ ɓwa mǝnana tàr nzalinì earce ama nǝ̀ akmúrí ka, dumǝna púp ama nǝ̀ mbwe boale andǝ banì mwashat aɓa gauwe tongno mala boale, sǝ nzalinì nǝ̀ duk male ɗǝm. <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />Sǝama ɓǝ̀ ɓwê earce ama nǝ̀ akmúr nzalinì raka, ko ɓǝ̀ mangŋǝ́nì ɓeɓwa ka, à pà nǝ̀ eari wi ɓǝ̀ akmúrí ɗǝm ɗàng. <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />Lang pǝlǝa mala pàkkiɗire-banɓoarnado nǝ̀ kàr ka, nzalinì nǝ̀ duk pagìr mǝfele, kǝla nzali mana à tàrnì acem, Mim Yahweh ka. Nǝ̀ duk girkuma mala apǝris.<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22" />&lt;&lt; &lt;Ɓǝ̀ nzali ka ɓwa kúrí nǝ kúró, pà aɓa gìr'liɓala male ɗàng, sǝ tàrì acem, Mim Yahweh ka, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />pǝris nǝ̀ kasǝ boale aɓa kpata làkkì mala apǝlǝa mǝnana à ueo sǝ à nǝ̀ bik ɓè pǝlǝa mala pàkkiɗire-banɓoarnado ka, sǝ ɓwê nǝ̀ mbwe boale, kǝla ɓoro mǝfele abanam, Mim Yahweh, a pwari mǝno. <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />Sǝ ɓǝ̀ pǝlǝa mala pàkkiɗire-banɓoarnado kàrna ka, nzalinì nǝ̀ nyare a bù ɓwa mǝnana à kúrí a buì ka ɓǝ̀ duk girkuma male ɗǝm, yì ɓwa mǝnana nzalinì ka gìr'liɓala male na ɗiɗyal ka. <verse eid="LEV 27:24" /><verse number="25" style="v" sid="LEV 27:25" />Koya boalo na à pà ka ɓǝà kārǝí arǝ shekel, yì mǝsǝbolo-azǝrfa mǝnana à kārǝ́ dǝmbǝrya male sǝ à ear amurí a Tara-mǝfele ka: Shekel mwashat ka mǝtyang lum-nong-ɓari na.<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />&lt;&lt; &lt;Sǝ amuna-dǝmba mala agirkusǝu ka cè kǝɓwa tària ɗàng, acemǝnana ɓǝlban malea kǝla amuna-dǝmba ka à tàrnia amema, Mim Yahweh; ko ɓǝ̀ ndǎ na, ko nzur na, ko mbul na ka, mema, Mim Yahweh.<note caller="+" style="f"><char style="fr" closed="false">27:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 13:2">Pur 13:2</ref>,<ref loc="EXO 13:15">15</ref>; <ref loc="EXO 34:19">34:19</ref>; <ref loc="NUM 18:15">Ɓal 18:15</ref></char>.</note> <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />Sǝama ɓǝ̀ girkusǝunì ka mǝɓeami na ka, ɓwê nǝ̀ kúrí nǝ boalo mǝnana à kasǝa arǝì ka ace mǝnana ɓǝ̀ nyar a bui, sǝ nǝ̀ tsǝk banì mwashat aɓa gauwe tongno mala boale amurí; ɓǝ̀ à akmúr girkusǝunì raka, à nǝ̀ me a kún boalo mǝnana à kasǝa amurí ka.<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />&lt;&lt; &lt;Kat andǝ amani ka koyagir mǝnana ɓwa tàrni kat-kat abanam, Mim Yahweh ka, ko ɓwa na, ko girkusǝu na, ko nzali male mana à pe wi liɓala ka nda ka, à pà nǝ̀ me ko à nǝ̀ akmúrí ɗàng; koya gìr mǝnana à tàrni kat-kat abanam, Mim Yahweh ka, pǝlǝna nggea mǝfele abanam, Mim Yahweh. <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />Ɓwapǝndǝa mǝnana kat à tàrni aɓalǝ aɓwana ace ká kìɗikè ka, ê pà kàm a kún kǝ boalo ɗàng; yì ka dumǝna púp ɓǝà wal-luí.<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />&lt;&lt; &lt;Koya kāmbe mala nzali mǝnana à sannì, ko mala mǝssa mǝnana à pwan a ɓaban, ko mala aɓǝla-nggun ngga, mema Mim Yahweh; dumǝna mǝfele na abanam Mim Yahweh. <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />Ɓǝ̀ ɓwa earce ama nǝ̀ kúr ɓè bare kāmbe mwashat aɓa gauwe lum mala kume male ka, dumǝna púp nǝ̀ mbwe boale mana pǝris nǝ̀ kasǝ ka, sǝ nǝ̀ tsǝk banì mwashat aɓa gauwe tongno mala boale amurí. <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />Akāmbe mwashat aɓa gauwe lum mala adomwan mala andá, andǝ mala anzur, andǝ mala ambul kat, koya mwashat aɓa lum ateà mǝnana kútí nǝ ɓata gara mala yálgír ka, nǝ̀ duk mǝfele abanam, Mim Yahweh. <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />Mǝtala agirkusǝunì pà nǝ̀ pelǝkia ace tàrki amǝɓoarne aɓalǝ amǝɓane ɗàng, sǝ pà nǝ̀ nggaɗi kǝɓè ɗàng. Ɓǝ̀ nggaɗi kǝ girkusǝu a kúnì ɓè ka, girkusǝunì andǝ mana à nggaɗi nǝi, yià kǝm ngga à dumǝna amǝfele; à pà nǝ̀ gandǝ akmúria ɗàng.&gt; &gt;&gt;<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />Amǝno ka à nda ka anzongcau mǝnana Yahweh pè Musa ɓǝ̀ banggi amǝ Isǝrayila a Nkono Saina ka.<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>