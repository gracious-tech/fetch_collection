<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Mbula</book>
  <para style="h">Ɓalban</para>
  <para style="toc1">Inea Malǝmce mala Musa mǝnana à kǝ tunǝi ama Ɓalban ngga</para>
  <para style="toc2">Ɓal</para>
  <para style="toc3">Ɓal</para>
  <para style="mt1">Ɓalban</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">Malǝmce mala <char style="bk">Ɓalban </char> ngga kǝ bang cau mala amǝ Isǝrayila tite a bàkú mǝnana à nying Nkono Saina bà yiu malea a njar-takuli mala nzong-nzali mala nzali mǝnana Ɓakuli akdǝmba pàcau ama nǝ̀ pea wia ka. Lullǝu mǝnia à pè mǝnia yì malǝmce ka, nda amur mugula gir mǝnana a ɓālǝi ka, yì ɓalban mǝnana Musa ɓal làkkì mala amǝ Isǝrayila a Nkono Saina sǝ à lo aban o ka; andǝ ɓalban mǝnana à ɓallia a Mowap, a njar-takuli mala Jodan, anzǝm nza mwashat mana yi kútí ka. Aɓa bákú mǝnana a nre ka amǝnia yì aɓalban ɓari ka, amǝ Isǝrayila wari a Kadesh Baniya, a njar-nzali mala nzong-nzali Kan'ana, sǝama à gandǝ kútí aɓa nzali pacauni ɗàng. Anzǝm mǝnana à malna apǝlǝkia pas a ban mǝno ka, à wari a bu-nzali mǝnana a njar-takuli mala Nggeasala Jodan ngga, a ban mǝnana bare aɓwana malea duk kam, sǝ cilia gilǝrǝia ace yàl-nkaring nggeasala ace kutio aɓa Kan'ana ka.</para>
  <para style="ip">Malǝmce mala <char style="bk">Ɓalban</char> ngga bǝlɓacau na amur aɓwana mǝnana à kum ɓabum-ɓungya kusǝ pas sǝ à lǝmdǝ ɓangciu lang à kùtí aɓa mǝkwane ka, sǝ à mgbicau arǝ Ɓakuli, sǝ arǝ Musa, yì ɓwa mǝnana Ɓakuli twali ɓǝ̀ gingnǝia ka. Kǝɓicau na amur domǝsǝcau mala Ɓakuli andǝ ɗenyinǝban male mǝnana camarǝ lǝmdǝi aɓwana male, kat andǝ rǝɓungya andǝ mgbikiru malea ka. Ɗǝm ngga nda amur paɓamuru mala Musa aban Ɓakuli andǝ aɓwana male, andǝ ɗwanyi dǝurǝo male arǝ acau, kat andǝ amani ama ɓè fara ka ndanǝ ɗwanyi munyi ka.</para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Amǝ'Isǝrayila gilǝrǝia ace nying Nkono Saina <char style="ior"><ref loc="NUM 1:1-9:23">1:1--9:23</ref></char></para>
  <para style="io2">1. Ɓalban mǝdǝmbe <char style="ior"><ref loc="NUM 1:1-4:49">1:1--4:49</ref> </char></para>
  <para style="io2">2. Anggurcau andǝ anzongcau ɗàngɗáng <char style="ior"><ref loc="NUM 5:1-8:26">5:1--8:26</ref></char></para>
  <para style="io2">3. Ɓaria Lamsan Yàlîmurû <char style="ior"><ref loc="NUM 9:1-23">9:1-23</ref></char></para>
  <para style="io1">Lo a Nkono Saina aban ká Mowap <char style="ior"><ref loc="NUM 10:1-21:35">10:1--21:35</ref></char></para>
  <para style="io1">Agir mǝnana à kumban a Mowap ka <char style="ior"><ref loc="NUM 22:1-32:42">22:1--32:42</ref></char></para>
  <para style="io1">Kàrkún acau mala gya, twal a Masar aban ká Mowap <char style="ior"><ref loc="NUM 33:1-49">33:1-49</ref></char></para>
  <para style="io1">Akwarkiru ace yàl-nkaring Nggeasala Jodan <char style="ior"><ref loc="NUM 33:50-36:13">33:50--36:13</ref></char></para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s">À ɓal amǝ'lwa mala amǝ Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />Yahweh nacau nǝ Musa aɓa Tara Ban-peri,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 27:21">Pur 27:21</ref>; <ref loc="EXO 40:2">40:2</ref>,<ref loc="EXO 40:6-7">6-7</ref></char>.</note> a ɓabondo Saina,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 19:1">Pur 19:1</ref>; <ref loc="NUM 33:16">Ɓal 33:16</ref></char>.</note> a pwari mǝdǝmbe mala ɓaria zongŋo, a ɓaria pǝlǝa, anzǝm mana amǝ Isǝrayila purni ɓá nzali Masar ka, ama, <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />&lt;&lt;Ɓal ɓinala amǝ Isǝrayila kat; ɓallia arǝ atau, arǝ aɓala-kàu malea; gilǝ lullǝ koya mwashat aɓalǝ aburana, <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />twal a pǝlǝa lumi-ɓari aban ká dǝmba, mala koya ɓwabura mǝnana nǝ̀ gandǝ ká lwa a Isǝrayila ka; we wunǝ Haruna ka wun nǝ̀ gilǝ làkkì mala amǝ'lwa malea. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Wu twal ɓwa mwashat a koya tàu, mǝnana ɓwamǝgule na a ɓala-kàu male ka, atà wun, ɓǝ̀ dupa wun gbasha. <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />Amǝnia ka à nda ka alullǝ aburana mǝnana à nǝ̀ dupa wun gbasha ka:</para>
  <para style="li" vid="NUM 1:5">Elizur muna-ɓwabura mala Shedeur a tàu mala Ruben;<verse eid="NUM 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="NUM 1:6" />Shelumiyel muna-ɓwabura mala Zurishaddai a tàu mala Shimiyon;<verse eid="NUM 1:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="NUM 1:7" />Nashon muna-ɓwabura mala Aminadap a tàu mala Yahuda;<verse eid="NUM 1:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="NUM 1:8" />Netanel muna-ɓwabura mala Zuar a tàu mala Isaka;<verse eid="NUM 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="NUM 1:9" />Eliyap muna-ɓwabura mala Helon a tàu mala Zebulu;<verse eid="NUM 1:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="NUM 1:10" />atà amǝkà Yisǝfu ka:</para>
  <para style="li2" vid="NUM 1:10">Elishama muna-ɓwabura mala Ammihud a tàu mala Ifǝrem, sǝ</para>
  <para style="li2" vid="NUM 1:10">Gamaliyel muna-ɓwabura mala Pedazur a tàu mala Manasa;<verse eid="NUM 1:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="NUM 1:11" />Abidan muna-ɓwabura mala Gidiyoni a tàu mala Benjami;<verse eid="NUM 1:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="NUM 1:12" />Ahieza muna-ɓwabura mala Amishaddai a tàu mala Dan;<verse eid="NUM 1:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="NUM 1:13" />Pagiyel muna-ɓwabura mala Okran a tàu mala Asha;<verse eid="NUM 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="NUM 1:14" />Eliyasaf muna-ɓwabura mala Dewel a tàu mala Gad;<verse eid="NUM 1:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="NUM 1:15" />sǝ Ahira muna-ɓwabura mala Enan a tàu mala Naftali.<verse eid="NUM 1:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 1:16" />Amǝnia ka à nda ka aburana mǝnana à tària aɓa ɓwabundǝa ace túró ka; à nda ka amúrû amur atau mala akeâ; à nda ka aɓwana-mǝgule amur aɓala mala amǝ Isǝrayila.&gt;&gt;<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />Nda Musa andǝ Haruna twal aburana mǝnia à tunǝ alullǝia ka, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />sǝ à tunǝ ramba mala ɓwabundǝa kat a banɓwáná, a pwari mǝdǝmbe mala ɓaria zongŋo. Pǝlǝa à gilǝ làkkì mala aɓwana kat arǝ atau sǝ arǝ aɓala-kàu malea, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba ka à gilǝ lullǝi, <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />kǝla mana Yahweh banggi Musa ka. Anggo sǝ gilǝ làkkì malea a ɓabondo Saina.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20" />Tite nǝ amǝkà Ruben, muna-dǝmba mala Isǝrayila, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />à kum làkkì mala aburana a tàu mala Ruben ɓwa á-lumi-ine-bwamdǝ-tongno-nong-mwashat nǝ gbǝman-tongno (46,500).<verse eid="NUM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 1:22" />Atà amǝkà Shimiyon ngga, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />à kum làkkì mala aburana a tàu mala Shimiyon, ɓwa á-lumi-tongno-bwamdǝ-tongno-nong-ine nǝ gbǝman-tàrú (59,300).<verse eid="NUM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 1:24" />Atà amǝkà Gad ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />à kum làkkì mala aburana a tàu mala Gad ɓwa á-lumi-ine-bwamdǝ-tongno nǝ gbǝman-tongno-nong-mwashat nǝ lumi-tongno (45,650).<verse eid="NUM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 1:26" />Atà amǝkà Yahuda ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />à kum làkkì mala aburana a tàu mala Yahuda ɓwa á-lumi-tongno-nong-ɓari-bwamdǝ-ine nǝ gbǝman-tongno-nong-mwashat (74,600).<verse eid="NUM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 1:28" />Atà amǝkà Isaka ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />à kum làkkì mala aburana a tàu mala Isaka ɓwa á-lumi-tongno-bwamdǝ-ine nǝ gbǝman-ine (54,400).<verse eid="NUM 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 1:30" />Atà amǝkà Zebulu ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />à kum làkkì mala aburana a tàu mala Zebulu ɓwa á-lumi-tongno-bwamdǝ-tongno-nong-ɓari nǝ gbǝman-ine (57,400).<verse eid="NUM 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32" />Atà amǝkà Yisǝfu, nǝban muna-ɓwabura male Ifǝrem ngga, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />à kum làkkì mala aburana a tàu mala Ifǝrem ɓwa á-lumi-ine nǝ gbǝman-tongno (40,500). <verse eid="NUM 1:33" /><verse number="34" style="v" sid="NUM 1:34" />Sǝ nǝban muna-ɓwabura male Manasa ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />à kum làkkì mala aburana a tàu mala Manasa ɓwa á-lumi-tàrú-nong-ɓari nǝ gbǝman-ɓari (32,200).<verse eid="NUM 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 1:36" />Atà amǝkà Benjami ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />à kum làkkì mala aburana a tàu mala Benjami ɓwa á-lumi-tàrú-bwamdǝ-tongno nǝ gbǝman-ine (35,400).<verse eid="NUM 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 1:38" />Atà amǝkà Dan ngga, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />à kum làkkì mala aburana a tàu mala Dan ɓwa á-lumi-tongno-nong-mwashat-nong-ɓari nǝ gbǝman-tongno-nong-ɓari (62,700).<verse eid="NUM 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 1:40" />Atà amǝkà Asha ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />à kum làkkì mala aburana a tàu mala Asha ɓwa á-lumi-ine-nong-mwashat nǝ gbǝman-tongno (41,500).<verse eid="NUM 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 1:42" />Atà amǝkà Naftali ka, à gilǝ lullǝ koya mwashat atà aburana arǝ atau, arǝ aɓala-kàu malea, kǝla mǝnana làkkì mala alullǝia pàk ka mwashat-mwashat, koya ɓwabura mǝnana pǝlǝa male bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana nǝ̀ gandǝ ká lwa ka; <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />à kum làkkì mala aburana a tàu mala Naftali ɓwa á-lumi-tongno-bwamdǝ-á-tàrú nǝ gbǝman-ine (53,400).<verse eid="NUM 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />Mǝnia ka nda làkkì mala aburana mǝnana Musa andǝ Haruna ɓallia ka, atārǝia andǝ aburana lum-nong-ɓari, aɓwana-mǝgule amur amǝ Isǝrayila mǝnana koyan ngga nda ace ɓala-kàu male ka. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />Amǝ Isǝrayila mǝnana kat pǝlǝa malea bingŋǝna lumi-ɓari aban ká dǝmba, mǝnana à nǝ̀ gandǝ ká lwa a Isǝrayila ka, à ɓallia kǝla mana à pa arǝ aɓala-kàu malea ka. <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />Làkkì malea kat-kat ka nda á-gbǝman-tongno-nong-mwashat-bwamdǝ-tàrú nǝ gbǝman-tongno nǝ lumi-tongno (603,550).<verse eid="NUM 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />Sǝama Amǝ'Lawi<note caller="+" style="f"><char style="fr" closed="false">1:47 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 34:25">Tite 34:25</ref>,<ref loc="GEN 34:30">30</ref>; <ref loc="GEN 49:5-7">49:5-7</ref>; <ref loc="EXO 32:26-29">Pur 32:26-29</ref>; <ref loc="NUM 3:6">Ɓal 3:6</ref>,<ref loc="NUM 3:12-13">12-13</ref>,<ref loc="NUM 3:40-43">40-43</ref>; <ref loc="NUM 8:16-19">8:16-19</ref>; <ref loc="NUM 18:1">18:1</ref>; <ref loc="DEU 10:8-9">Nggur 10:8-9</ref>; <ref loc="DEU 18:1-2">18:1-2</ref>; <ref loc="DEU 21:5">21:5</ref>; <ref loc="JOS 13:14">Jes 13:14</ref>,<ref loc="JOS 13:33">33</ref></char>.</note> a tàu mala akeâ ka, à ɓallia atà aɓwana ɗàng. <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />Nda acemǝnana Yahweh bangŋǝ́nì Musa cau ama, <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />&lt;&lt;She kǝ tàu mala Lawi nda mǝnana a pà nǝ ɓalli raka, sǝ a pà nǝ gilǝ làkkì malea atà amǝ Isǝrayila ɗàng. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />A kún mani ka awu nǝ twal Amǝ'Lawi ɓǝà duk amǝ'tsǝkir Taragula mala Acau-nakûn, andǝ agirtúró male kat, andǝ agir mǝnana kat à nda ace ka. À nda à nǝ̀ nggǝ twal Taragula andǝ agirtúró male kat ka; à nda à nǝ̀ ɗenyinǝi sǝ à nǝ̀ tsǝki agumli malea ɓǝà kàrì a tsùrú mala kàttì ka. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />A pwari mǝnana kat à nǝ̀ panzǝ Taragula ace tùr là-gumli ka, Amǝ'Lawi na à nǝ̀ panzǝki ka, sǝ a ban mǝnana kat à nǝ̀ kwaki Taragula kàm ngga, Amǝ'Lawi na à nǝ̀ pàk túrè ka. Ɓǝ̀ ɓwa-ɗàng<note caller="+" style="f"><char style="fr" closed="false">1:51 </char><char style="fq" closed="false">ɓwa-ɗàng </char><char style="ft" closed="false">ko ɓwa mǝnana ɓwa-Lawi na raka</char></note> gbashi banì ka ɓǝà wal-luí. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Amǝ Isǝrayila nǝ̀ tsǝk agumli malea, koya tàu ka a kàttì male, sǝ koya ɓwa ka a ban tútà mala tàu male, arǝ anggǝsan mala amǝ'lwa malea. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Sǝ Amǝ'Lawi ka, à nǝ̀ tsǝki agumli malea ɓǝà kàrì Taragula mala Acau-nakûn a tsùrú, ace mǝnana bumlulla mem ɓǝkǝa sulǝo amur ɓinado mala amǝ Isǝrayila raka. Amǝ'Lawi ka à nda mǝnana túró yál Taragula mala Acau-nakûn na amúrià ka.&gt;&gt;<verse eid="NUM 1:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 1:54" />Amǝ Isǝrayila pàk koya gìr kǝla mana Yahweh banggi Musa ka.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s">Came mala agumli arǝ akattì mala amǝ Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />Yahweh banggi Musa andǝ Haruna ama: <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />&lt;&lt;Amǝ Isǝrayila ɓǝà tsǝki agumli arǝ akattì malea zak nǝ ban Tara Ban-peri, koya gumli a kàttì ka ɓǝ̀ ɓamǝsǝi pǝlǝ nǝban Tara Ban-peri a koya buì; koyan ngga a ban tútà nǝ baji mala ɓala-kàu malea. <verse eid="NUM 2:2" /><verse number="3" style="v" sid="NUM 2:3" />Amǝ Isǝrayila mǝnana à nǝ̀ tsǝk agumli malea a njar-takuli, a buì mala eauwe mala pwari ka, à nda ka anggǝsan mala amǝ'lwa aɓata tútà mala kàttì mala Yahuda. Ɓwa mǝnana nǝ̀ duk ɓwamǝgule amur amǝkà Yahuda ka nda Nashon, muna-ɓwabura mala Aminadap; <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno-nong-ɓari-bwamdǝ-ine nǝ gbǝman-tongno-nong-mwashat (74,600). <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />Amǝnana à nǝ̀ tsǝk agumli malea a nkanggaria ka nda tàu mala Isaka, sǝ ɓwamǝgule amur amǝkà Isaka ka nda Netanel, muna-ɓwabura mala Zuar; <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno nǝ á-ine nǝ gbǝman-ine (54,400). <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />Pǝlǝa tàu mala Zebulu nǝ̀ kpa; ɓwamǝgule amur amǝ'kà Zebulu ka nda Eliyap, muna-ɓwabura mala Helon, <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />sǝ amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno nǝ á-tongno-nong-ɓari nǝ gbǝman-ine (57,400). <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />Yià mǝno kat à ɓallia arǝ anggǝsan mala amǝ'lwa malea a kàttì mala Yahuda ka, làkkì malea na á-gbǝman-mwashat nǝ á-lumi-tongno-nong-tàrú nǝ á-tongno-nong-mwashat nǝ gbǝman-ine (186,400). Yia na à nǝ̀ tita lo gya ka.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />&lt;&lt;Amǝ Isǝrayila mǝnana a njar-kunmur ka, à nda ka anggǝsan mala amǝ'lwa mala kàttì mala Ruben aɓata tútà malea; ɓwamǝgule amur amǝkà Ruben ngga nda Elizur, muna-ɓwabura mala Shedeur; <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-ine nǝ á-tongno-nong-mwashat nǝ gbǝman-tongno (46,500). <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Sǝ aɓwana mǝnana à nǝ̀ tsǝk agumli malea a nkanggaria ka nda tàu mala Shimiyon; ɓwamǝgule amur amǝkà Shimiyon ngga nda Shelumiyel, muna-ɓwabura mala Zurishaddai; <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno nǝ á-tongno-nong-ine nǝ gbǝman-tàrú (59,300). <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />Pǝlǝa tàu mala Gad nǝ̀ kpa, sǝ ɓwamǝgule amur amǝkà Gad ka nda Eliyasaf, muna-ɓwabura mala Rewel; <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-ine nǝ á-tongno nǝ gbǝman-tongno-nong-mwashat nǝ lumi-tongno (45,650). <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />Yià mǝno kat à ɓallia arǝ anggǝsan mala amǝ'lwa malea a kàttì mala Ruben ngga, làkkì malea na á-gbǝman-mwashat nǝ á-lumi-tongno nǝ á-mwashat nǝ gbǝman-ine nǝ lumi-tongno (151,450). À nda ka ɓaria aɓwana aɓa lo gya.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />&lt;&lt;Anzǝm Ruben ngga Amǝ'Lawi nǝ agir mala Tara Ban-peri a buia ka, à nǝ̀ lo gya a tsùrú mala akattì; à nǝ̀ lo gya kǝla mana à tsǝì ace bwal kàttì ka, koyan ngga a ban male aɓata tútà male.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />&lt;&lt;Amǝ Isǝrayila mǝnana à nǝ̀ pa a njar-nzali ka, à nda ka anggǝsan mala amǝ'lwa mala kàttì mala Ifǝrem aɓata tútà malea; ɓwamǝgule amur amǝkà Ifǝrem ngga nda Elishama, muna-ɓwabura mala Ammihud; <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-ine nǝ gbǝman-tongno (40,500). <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Aɓwana mǝnana a nkanggaria ka nda tàu mala Manasa; ɓwamǝgule amur amǝkà Manasa ka nda Gamaliyel, muna-ɓwabura mala Pedazur; <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tàrú nǝ á-ɓari nǝ gbǝman-ɓari (32,200). <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Pǝlǝa tàu mala Benjami nǝ̀ kpa, sǝ ɓwamǝgule amur amǝkà Benjami ka nda Abidan, muna-ɓwabura mala Gidiyoni; <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tàrú nǝ á-tongno nǝ gbǝman-ine (35,400). <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />Yià mǝno kat à ɓallia arǝ anggǝsan mala amǝ'lwa malea a kàttì mala Ifǝrem ngga, làkkì malea na á-gbǝman-mwashat nǝ á-tongno-nong-tàrú nǝ gbǝman-mwashat (108,100). À nda ka tàruia aɓwana aɓa lo gya.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />&lt;&lt;Amǝ Isǝrayila mǝnana à nǝ̀ pà a njar-nza ka, à nda ka anggǝsan mala amǝ'lwa mala kàttì mala Dan aɓata tútà malea; ɓwamǝgule amur amǝkà Dan ngga nda Ahieza, muna-ɓwabura mala Amishaddai; <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno-nong-mwashat nǝ á-ɓari nǝ gbǝman-tongno-nong-ɓari (62,700). <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Aɓwana mǝnana à nǝ̀ tsǝk agumli malea a nkanggaria ka nda tàu mala Asha; ɓwamǝgule amur amǝkà Asha ka nda Pagiyel, muna-ɓwabura mala Okran; <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-ine nǝ á-mwashat nǝ gbǝman-tongno (41,500). <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />Pǝlǝa tàu mala Naftali nǝ̀ kpa, sǝ ɓwamǝgule amur amǝkà Naftali ka nda Ahira, muna-ɓwabura mala Enan; <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />amǝ'lwa mǝnana à ɓallia a nggǝsan male ka, làkkì malea na á-lumi-tongno nǝ á-tàrú nǝ gbǝman-ine (53,400). <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />Yià mǝno kat à ɓallia a kàttì mala Dan ngga, làkkì malea na á-gbǝman-mwashat nǝ á-lumi-tongno nǝ á-tongno-nong-ɓari nǝ gbǝman-tongno-nong-mwashat (157,600). À nda ka amǝ'tànkwàng aɓa lo gya.&gt;&gt;<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Amǝnia ka à nda ka amǝ Isǝrayila mana à ɓallia arǝ aɓala-kàu malea ka. Yià mǝno kat à ɓallia arǝ akattì malea, arǝ anggǝsan mala amǝ'lwa malea ka, làkkì malea na á-gbǝman-tongno-nong-mwashat nǝ á-tàrú nǝ gbǝman-tongno nǝ lumi-tongno (603,550). <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Sǝama Amǝ'Lawi ka à ɓallia atà amǝ Isǝrayila ɗàng, kǝla mana Yahweh banggi Musa ka.<verse eid="NUM 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 2:34" />Anggo sǝ amǝ Isǝrayila pa. À kpata cau mǝnana kat Yahweh banggi Musa ka, sǝ anggo sǝ à duk kàttì aɓata atútà malea, sǝ anggo gbal sǝ à puro aban ká, koyan ngga a tàu andǝ ɓala-kàu male.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">Amuna-burana mala Haruna</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Amǝnia ka à nda ka amuna andǝ amǝkà Haruna andǝ Musa mǝnana à gilǝia a bàkú mana Yahweh bangcau nǝ Musa a Nkono Saina ka. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Amuna-burana mala Haruna ka à nda ka Nadap muna-dǝmba, andǝ Abihu, andǝ Eleaza sǝ Itamar. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Amǝnia ka à nda ka alullǝ amuna-burana mala Haruna mǝnana à ɗārǝia sǝ à kùria wia túró-pǝris ka. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />Sǝama Nadap andǝ Abihu ka à wǔ a ɓadǝm Yahweh acemǝnana à pàgir nǝ bǝsa mǝnana mala Ɓakuli na raka, a ɓadǝm Yahweh a ɓabondo Saina,<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 10:1-2">Pǝris 10:1-2</ref></char>.</note> sǝ à pànǝ amuna ɗang. Acemani ka, kǝ Eleaza andǝ Itamar na à pàk túró-pǝris atà tárrià Haruna ka.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />Pǝlǝa Yahweh nacau nǝ Musa ama, <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />&lt;&lt;Yinǝ tàu mala Lawi ɓǝà sung tù sǝ ɓǝà yi came a ɓadǝm Haruna pǝris, ace mǝnana ɓǝà pàkki wi gbasha aɓa túró ka. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />À nǝ̀ pàkki atúró mǝnana amale na ka, sǝ à nǝ̀ pàkkî amǝ Isǝrayila atúró mǝnana à nda cea a ɓinalea ka, a ɓadǝm Tara Ban-peri, a ban pàk túró aɓa Taragula. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Yià na à nǝ̀ yál agir mǝnana aɓa Tara Ban-peri ka, sǝ à nǝ̀ pàk atúró mǝnana nda ace amǝ Isǝrayila, a ban túró aɓa Taragula ka. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Twal Amǝ'Lawi, pè Haruna andǝ amuna-burana male; ǝn tarnia aɓalǝ amǝ Isǝrayila kat ace bwali wi túró. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Awu nǝ twal Haruna andǝ amuna-burana male ɓǝà bwal dobuno-pǝris malea. Sǝ ɓǝ̀ ɓekǝ ɓwa-ɗàng gbàshìban ban-mǝfele ka, dumǝna púp à nǝ̀ wal-luí.&gt;&gt;<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />Ɗǝm ngga Yahweh bangcau nǝ Musa ama, <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />&lt;&lt;Sǝni, ǝn twalǝna Amǝ'Lawi aɓalǝ amǝ Isǝrayila a kúnì koya muna-dǝmba mǝnana nda tita puro a bum nggé atà amǝ Isǝrayila ka. Amǝ'Lawi nǝ̀ duk amem, <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />acemǝnana amuna-dǝmba kat ka amem na. A pwari mǝno ǝn wal amuna-dǝmba kat aɓa nzali Masar ka,<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 13:15-16">Pur 13:15-16</ref></char>.</note> ǝn tárì ɓamúràm amuna-dǝmba kat a Isǝrayila, amala aɓwapǝndǝa andǝ amala agirkusǝu kǝm. À nǝ̀ duk amem: Mǝ nda Yahweh.&gt;&gt;<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />Yahweh nacau nǝ Musa a ɓabondo Saina, ama, <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />&lt;&lt;Ɓal amuna-burana mala Lawi arǝ aɓala-kàu malea sǝ arǝ anggurkwar malea; koya muna-ɓwabura mǝnana à ɓǝli pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba ka awu nǝ ɓalli.&gt;&gt; <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Nda Musa ɓallia kǝla mana Yahweh banggi wi ka. <verse eid="NUM 3:16" /><verse number="17" style="v" sid="NUM 3:17" />Sǝ amǝnia ka à nda ka alullǝ amuna-burana mala Lawi: Gashon andǝ Kohat andǝ Merari. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />Sǝ amǝnia ka à nda ka amuna-burana mala Gashon: Libǝni andǝ Shimeyi; koyan ngga a nggurkwar male. <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" />Sǝ amuna-burana mala Kohat ka à nda ka: Amram, andǝ Izǝhar, andǝ Hebǝron, andǝ Uziyel; koyan ngga a nggurkwar male. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />Amuna-burana mala Merari ka, à nda ka: Mali andǝ Mushi; koyan ngga a nggurkwar male. Amǝnia ka, à nda ka anggurkwar mala Amǝ'Lawi, arǝ aɓala-kàu malea.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Aɓwana a nggurkwar mala Amǝ'Libǝni andǝ nggurkwar mala Amǝ'Shimeyi ka à nda ka amǝɓala mala Gashon. À nda ka amǝ'Gashon arǝ anggurkwar malea. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Amuna-burana mǝnana à ɓǝlia, à pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba, mǝnana à ɓallia ka, làkkì malea na á-tongno-nong-ɓari nǝ gbǝman-tongno (7,500). <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Aɓwana mana arǝ anggurkwar mala amǝ'Gashon ngga à nǝ̀ tsǝk kàttì malea anzǝm Taragula a njar-nzali, <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />sǝ Eliyasaf, muna-ɓwabura mala Layel ka nda nǝ̀ duk múrû amur ɓala-kàu mala amǝ'Gashon ngga. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Túró mala amuna-burana mala Gashon ngga nda yál Taragula, andǝ Tara mǝfele andǝ alagìr male mana à gìrì ka, andǝ lagìr gbar bankutio male, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />andǝ alagìr mǝnana à kàrì patal ka, andǝ lagìr mala gbar bankutio aɓa patal mǝnana kàrì Taragula andǝ gyangŋan ngga, andǝ anggur, andǝ agirtúró mǝnana kat à kǝ pangŋǝ̀nà túró nǝia ka.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Amǝkà Kohat ka, à nda ka nggurkwar mala Amǝ'Amram, andǝ nggurkwar mala Amǝ'Izǝhar, andǝ nggurkwar mala Amǝ'Hebǝron, andǝ nggurkwar mala Amǝ'Uziyel; yià mǝnia ka à nda ka anggurkwar mala amǝ'Kohat. <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />Aɓa ɓal koya muna-ɓwabura mǝnana à ɓǝli pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba ka, à kum làkkì malea á-tongno-nong-tàrú nǝ gbǝman-tongno-nong-mwashat (8,600). Túró yál ban-mǝfele ka nda a buia. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />Anggurkwar mala amuna andǝ amǝkà Kohat nǝ̀ tsǝk kàttì malea a buì mala Taragula mǝnana sǝn njar-kunmur ka, <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />sǝ Elizafan, muna-ɓwabura mala Uziyel na nǝ̀ duk ɓwamǝgule amur aɓala-kàu mala anggurkwar mala amǝ'Kohat ka. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Túró malea nda yál Akwati, andǝ kpamgbang-tsǝk-agir, andǝ gìr-tàmsǝ apitǝla, andǝ agyangŋan, andǝ agirtúró mǝnana apǝris kǝ pangŋǝ̀nà túró nǝia a ban-mǝfele ka, andǝ lagìr-kasǝbân;<note caller="+" style="f"><char style="fr" closed="false">3:31 </char><char style="fq" closed="false">lagìr-kasǝbân </char><char style="ft" closed="false">mǝnana gau nre ban nggea-mǝfele andǝ ban-mǝfele ka.</char></note> koya túró mǝnana kat je amǝnia yì agir ka, à nǝ̀ pè. <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />Sǝ Eleaza muna-ɓwabura mala Haruna, yì pǝris ka nda nǝ̀ duk múrû amur aɓwana-mǝgule mala Amǝ'Lawi, sǝ nǝ̀ tsǝk-mǝsǝì arǝ aɓwana mǝnana kat à kǝ̀ pàkki atúró aɓa ban-mǝfele ka.<verse eid="NUM 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />Amǝkà Merari ka, à nda ka nggurkwar mala Amǝ'Mali, andǝ nggurkwar mala Amǝ'Mushi: Amǝnia ka à nda ka anggurkwar mala Merari. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Aɓwana mǝnana à ɓallia, yì amuna-burana mǝnana kat ɓǝlia ka, à pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba ka, à kum làkkì malea á-tongno-nong-mwashat nǝ gbǝman-ɓari (6,200). <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Sǝ ɓwamǝgule amur ɓala-kàu mala anggurkwar mala Merari ka nda Zuriyel, muna-ɓwabura mala Abihel. À nda à nǝ̀ tsǝk kàttì malea a buì mala Taragula mǝnana sǝn njar-nza ka. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Sǝ túró mǝnana à kàsǝî amuna-burana mala Merari ka nda tsǝkir anggun-tara mala Taragula, andǝ anggun-gangndea, andǝ anggun-ɓalǝu, andǝ agumtǝli-tǝrteà, andǝ agirtúró male kat; koya túró mǝnana kat je amǝnia yì agir ka, à nǝ̀ pè; <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />ɗǝm ngga à nǝ̀ tsǝkir anggun-kala mǝnana à kàrì patal ka, andǝ agumtǝli-tǝrteà, andǝ ankpako tara, andǝ anggúr malea.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Aɓwana mǝnana à nǝ̀ tsǝk kàttì malea aɓadǝm Taragula a buì mǝnana sǝn njar-takuli, aɓadǝm Tara Ban-peri a buì mala eauwe mala pwari ka, à nda ka Musa andǝ Haruna andǝ amuna-burana male. Tsǝkir Taragula andǝ yálè ka nda a buia ace lùmsǝ atúró mǝnana à nǝ̀ peǎ ace amǝ Isǝrayila ka. Sǝ ɓǝ̀ ɓekǝ ɓwa-ɗàng gbàshìbanì ka à nǝ̀ wal-luí <verse eid="NUM 3:38" /><verse number="39" style="v" sid="NUM 3:39" />Làkkì mala Amǝ'Lawi mǝnana Yahweh banggi Musa andǝ Haruna ama ɓǝà ɓallia arǝ anggurkwar malea, koya muna-ɓwabura mǝnana à ɓǝli pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba ka, nda á-lumi-ɓari-nong-ɓari (22,000).<verse eid="NUM 3:39" /></para>
  <para style="s">Akmúr muna-dǝmba</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />Sǝ Yahweh banggi Musa ama, &lt;&lt;Ɓal amuna-dǝmba amuna-burana mala amǝ Isǝrayila kat, amǝnana ɓǝlia ka, à pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba ka, sǝ wu gilǝ alullǝia. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Ak Amǝ'Lawi ɓǝà duk amem, a kúnì amuna-dǝmba kat atà amǝ Isǝrayila, sǝ agirkusǝu mala Amǝ'Lawi a kúnì amuna-dǝmba kat mala agirkusǝu mala amǝ Isǝrayila. Mǝ nda Yahweh.&gt;&gt; <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" />Nda Musa ɓal amuna-dǝmba kat mala amǝ Isǝrayila, kǝla mana Yahweh banggi wi ka. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Làkkì mala amuna-dǝmba amuna-burana kat-kat, mǝnana ɓǝlia ka à pàngŋǝ̀nà zongŋo mwashat aban ká dǝmba, kǝla mana à gilǝ alullǝia ka, à nda á-lumi-ɓari-nong-ɓari nǝ gbǝman-ɓari nǝ lumi-tongno-nong-ɓari nǝ mǝsǝi tàrú (22,273).<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />Sǝ Yahweh bangcau nǝ Musa, ama, <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />&lt;&lt;Ak Amǝ'Lawi a kúnì amuna-dǝmba mala amǝ Isǝrayila kat, sǝ agirkusǝu mala Amǝ'Lawi a kúnì amalea. Amǝ'Lawi nǝ̀ duk amem. Mǝ nda Yahweh. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Sǝ ace mbwe boalo akmúr amuna-dǝmba mǝnia gbǝman-ɓari nǝ lumi-tongno-nong-ɓari nǝ mǝsǝi tàrú (273) mana làkkì malea eauwe amur làkkì mala Amǝ'Lawi ka, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />awu nǝ ak shekel<note caller="+" style="f"><char style="fr" closed="false">3:47 </char><char style="fq" closed="false">shekel </char><char style="ft" closed="false">ka nda mǝsǝbolo-azǝrfa mǝnana à kārǝ́ dǝmbǝrya male sǝ à earna amurí a Tara-mǝfele ka. (Shekel mwashat ka mǝtyang lum-nong-ɓari na.)</char></note> tongno a kúnì koyan ateà; ak boale aɓa kpata dǝmbǝrya mala shekel, yì mǝsǝbolo-azǝrfa mǝnana à kārǝ́ dǝmbǝrya male sǝ à earna amurí a Tara-mǝfele ka. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />Pè Haruna andǝ amuna-burana male boalo mala akmúr amǝ Isǝrayila mǝnia mana làkkì malea eau ka.&gt;&gt;<verse eid="NUM 3:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="NUM 3:49" />Nda Musa ak boalo mala akmúrú mǝnia ka a bu aɓwana mana làkkì malea eapi mala aɓwana mana Amǝ'Lawi akmúria ka. <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />A bu amuna-dǝmba mala amǝ Isǝrayila ka, ak boalo shekel á-mwashat nǝ gbǝman-tàrú nǝ lumi-tongno-nong-mwashat nǝ mǝsǝi tongno (1,365); À kpata shekel mala Tara-mǝfele. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Sǝ Musa pè Haruna andǝ amuna-burana male boalo mala akmúrú mǝnia ka, kǝla mana Yahweh banggi wi ka.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s">Atúró mala amǝ'Kohat</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />Yahweh bangcau nǝ Musa andǝ Haruna, ama, <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />&lt;&lt;Ɓal làkkì mala amuna-burana mala Kohat aɓalǝ Amǝ'Lawi, arǝ anggurkwar malea sǝ arǝ aɓala-kàu malea. <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />Ɓal aburana mǝnana kat pǝlǝa malea na lumi-tàrú aban ká lumi-tongno, mǝnana à kārǝ́na à nǝ̀ pàk túró aɓa Tara Ban-peri ka.<verse eid="NUM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 4:4" />&lt;&lt;Túró mala amǝ'Kohat aɓa Tara Ban-peri ka nda tsǝkir agir nggea-mǝfele andǝ yália. <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Lang kàttì nǝ̀ lo ace o ka, Haruna andǝ amuna-burana male nǝ̀ kùtí aɓa Ban Nggea Mǝfele, sǝ à nǝ̀ sulǝ lagìr-kasǝbân sǝ à nǝ̀ gìr Akwati mala Acau-nakûn nǝi. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />Pǝlǝa à nǝ̀ kùmsǝi wi nggu-mbulpǝndǝa<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">nggu-mbulpǝndǝa </char><char style="ft" closed="false">ko nggu mǝɓǝlke.</char></note> amurí, sǝ à nǝ̀ sárǝ́ nggubyau mǝnana mùr-rǝì ka mǝlùre na kat ka amurí, sǝ à nǝ̀ oasǝi wi agare.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />&lt;&lt;À nǝ̀ sárǝ́ nggubyau mǝlùre amúr kpamgbang mala tsǝk Bǝredi Ɓadǝm Yahweh.<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 25:30">Pur 25:30</ref>; <ref loc="LEV 24:5-7">Pǝris 24:5-7</ref></char>.</note> Amur nggubyau man ngga, à nǝ̀ tsǝk aparanti, andǝ atasau (ace muku-gìr loasǝ yele mǝ'rǝmɓoarne), andǝ amuna-nkenye, andǝ amuna-bàng ace pàgir mala girnùná; sǝ bǝredi mana ndakam koya pwari ka,<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 25:30">Pur 25:30</ref>; <ref loc="LEV 24:5-9">Pǝris 24:5-9</ref></char>.</note> nǝ̀ pàk kàm gbal. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />Pǝlǝa à nǝ̀ sárǝ́ nggubyau mǝbangye amúrià, à nǝ̀ kùmsǝ múrià nǝ nggu-mbulpǝndǝa, sǝ à nǝ̀ oasǝi wi agare.<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />&lt;&lt;À nǝ̀ twal nggubyau mǝlùre sǝ à nǝ̀ gìrna gìr-tàmsǝ apitǝla mana nda ace pà tǎlaban ngga, atārǝia andǝ apitǝla male, andǝ amǝmyal<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">amǝmyal </char><char style="ft" closed="false">ace kǝtǝriki tú kún bùgìr-bǝsa.</char></note> male, andǝ atasau-bǝsa, andǝ adú male kat mala mùrú olif mǝnana à kǝ soapi wi ka. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Sǝ à nǝ̀ kàrrì andǝ agirtúró male kat aɓa girkàrre mala nggu-mbulpǝndǝa, sǝ à nǝ̀ tsǝì amur gambǝlam<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fq" closed="false">gambǝlam </char><char style="ft" closed="false">ko &lt;&lt;gabǝlang&gt;&gt;</char></note> twal gìr.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />&lt;&lt;Gyangŋan bolo-njengǝlan ngga à nǝ̀ sárǝ́ nggubyau mǝlùre amurí ɓǝ̀ gìrì, à nǝ̀ kùmsǝi wi nggu-mbulpǝndǝa, sǝ à nǝ̀ oasǝi wi agare. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Sǝ agirtúró kat mala túróperi aɓa ban-mǝfele ka, à nǝ̀ pwania sǝ à nǝ̀ kàrria aɓa nggubyau mǝlùre, à nǝ̀ kùmsǝia wia gìrkùmsǝo mala nggu-mbulpǝndǝa amúrià, sǝ à nǝ̀ tsǝia amur gambǝlam twal gìr.<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />&lt;&lt;À nǝ̀ pwan tú mana aɓa gyangŋan bolo-bángŋá ka sǝ à nǝ̀ sárǝì wi nggubyau mǝwanye amurí. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Pǝlǝa à nǝ̀ tsǝk agirtúró mala gyangŋanì kat amurí: atasau-bǝsa, andǝ ashokali-soagìr, andǝ ashebǝl, andǝ ankenye, yì agirtúró kat mala gyangŋan; à nǝ̀ sárǝ́ gìrkùmsǝo mala nggu-mbulpǝndǝa amurí sǝ à nǝ̀ oasǝi wi agare a ban malea.<verse eid="NUM 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 4:15" />&lt;&lt;Anzǝm mǝnana Haruna andǝ amuna-burana male malna gìrki agir mǝfele andǝ agirtúró kat mala ban-mǝfele ka, sǝ lang kàttì gilǝnarǝì nǝ̀ lo gya ka, amǝ'Kohat nǝ̀ yiu ace twal agirnì. Sǝama à pà nǝ̀ je ka agir mǝfele ɗàng, ɓǝ̀ ana raka à nǝ̀ wǔ. Amǝ'Kohat na à nǝ̀ pwan agir mǝnana aɓa Tara Ban-peri ka.<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />&lt;&lt;Túró mala Eleaza muna-ɓwabura mala Haruna pǝris ka, nda tsǝkir mùrú ace pà tǎlaban, andǝ muku-gìr loasǝ yele mǝrǝmɓoarne, andǝ pàgir mala mǝsǝsa mana à pākiyi pwari-pwari ka, andǝ mùrú-ɗārǝ́bân. Ɗǝm ngga yì na nǝ̀ nggǝ tsǝk-mǝsǝì arǝ Taragula andǝ agir mǝnana kat aɓalǝi ka, kat andǝ ban-mǝfele andǝ agirtúró ɓālǝi.&gt;&gt;<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />Yahweh banggi Musa andǝ Haruna ama, <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />&lt;&lt;Wu kǝa ɗeki amuna andǝ amǝkau mǝnana aɓalǝ amǝ'Lawi a nggurkwar mala Kohat ka tea ɓǝ̀ twal ɗàng. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Ace amsǝia, ɓǝà kǝa wuki raka, lang à nǝ̀ sung tù a ban agir nggea-mǝfele ka, pàk mǝnia ka acea: Haruna andǝ amuna-burana male ɓǝà kùtí aɓa ban-mǝfele, sǝ ɓǝà pè koyan atea ka túró male andǝ gìr mǝnana nǝ̀ twal ka. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />Sǝama amǝ'Kohat pà nǝ̀ kúti ace sǝn agir mǝfele ɗàng ko bǝti, ɓǝ̀ ana raka à nǝ̀ wǔ.&gt;&gt;<verse eid="NUM 4:20" /></para>
  <para style="s">Atúró mala amǝ'Gashon</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />Yahweh nacau nǝ Musa ama, <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />&lt;&lt;Ɓal làkkì mala amuna-burana mala Gashon gbal, arǝ aɓala-kàu sǝ arǝ anggurkwar malea. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Ɓal aburana mǝnana kat pǝlǝa malea na lumi-tàrú aban ká lumi-tongno, mǝnana à kārǝ́na à nǝ̀ pàk túró aɓa Tara Ban-peri ka. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />Mǝnia ka nda túró mana amuna andǝ amǝ'kàu arǝ anggurkwar mala amǝ'Gashon nǝ̀ pak ka, aɓa túró andǝ twaltwalo ka: <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />Yià na à nǝ̀ twal alagìr<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 26:1-13">Pur 26:1-13</ref>; <ref loc="EXO 36:8-17">36:8-17</ref></char>.</note> mala Taragula, sǝ Tara Ban-peri andǝ lagìr-murí, andǝ nggu-mbulpǝndǝa mǝnana gìr múrià ka, andǝ lagìr gbar bankutio aɓa Tara Ban-peri, <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />andǝ alagìr mǝnana à kàrì patal, andǝ lagìr ace gbar kún patal mana kàrì Taragula andǝ gyangŋan ngga, andǝ anggur malea, andǝ agirtúró ace túró malea kat. Amǝ'Gashon na à nǝ̀ pàk gìr mǝnana kat ɓoaro ɓǝà pè nǝ amǝnia yì agir ka. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Atúró mǝnana kat amuna-burana mala amǝ'Gashon nǝ̀ pè, ko mala twaltwalo, ko aɓea atúró ka, à nǝ̀ pè aɓata gingnǝban mala Haruna andǝ amuna-burana male. Sǝ awu nǝ pea wia agir mǝnana kat à nǝ̀ twal ka, ɓǝ̀ duk túró malea. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Mǝnia ka nda túró mǝnana nda ace amuna andǝ amǝkà Gashon, aɓa Tara Ban-peri ka. Sǝ túró mana à nǝ̀ pea wia ka, nda aɓata gingnǝban mala Itamar muna-ɓwabura mala Haruna pǝris.<verse eid="NUM 4:28" /></para>
  <para style="s">Atúró mala amǝ'Merari</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />&lt;&lt;Ɓal làkkì mala amǝkà Merari arǝ anggurkwar malea sǝ arǝ aɓala-kàu malea. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />Ɓal aburana mǝnana kat pǝlǝa malea na lumi-tàrú aban ká lumi-tongno, mǝnana à kārǝ́na à nǝ̀ pàk túró aɓa Tara Ban-peri ka. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Túró malea aɓa Tara Ban-peri, aɓa túró mǝnana kat à nǝ̀ pè ka, nda twal anggun-tara mala Taragula, andǝ anggun-gangndea male, andǝ anggun-ɓalǝu male, andǝ agumtǝli-tǝrteà, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />kat andǝ anggun-kala mana à kàrì patal ka, andǝ agumtǝli-tǝrteà, andǝ ankpako malea, andǝ anggúr malea, andǝ agirtúró malea kat, andǝ acili agir mǝnana kat à nǝ̀ pà gbasha arǝ túró ka. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Mǝnia ka nda túró mǝnana nda ace amuna andǝ amǝkà Merari, aɓa Tara Ban-peri ka. Sǝ túró mana à nǝ̀ pea wia ka, nda aɓata gingnǝban mala Itamar muna-ɓwabura mala Haruna pǝris.&gt;&gt;<verse eid="NUM 4:33" /></para>
  <para style="s">À ɓal lakki mala amǝ'Lawi ɗǝm</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Nda Musa andǝ Haruna andǝ aɓwana-mǝgule mala ɓwabundǝa ɓal amuna andǝ amǝkà Kohat arǝ anggurkwar, sǝ arǝ aɓala-kàu malea ka. <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />À ɓal aburana mǝnana kat pǝlǝa malea na lumi-tàrú aban ká lumi-tongno, mǝnana à kārǝ́na à nǝ̀ pàk túró aɓa Tara Ban-peri ka; <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />sǝ yià mǝnana à ɓallia arǝ anggurkwar mala Kohat ka, à nda á-ɓari nǝ gbǝman-tongno-nong-ɓari nǝ lumi-tongno (2,750). <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Amǝnia ka nda làkkì mala aɓwana mǝnana à ɓallia arǝ anggurkwar mala amǝ'Kohat, yià mǝnana kat à pàktúró aɓa Tara Ban-peri, mana Musa andǝ Haruna ɓallia, kǝla mana Yahweh bangŋi nǝ kún Musa ka.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />À ɓal amuna andǝ amǝkà Gashon, arǝ anggurkwar, sǝ arǝ aɓala-kàu malea, <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />twal a ban ɓwa mǝnana pǝlǝa male na lumi-tàrú aban ká lumi-tongno, mǝnana kārǝ́na nǝ̀ pàk túró aɓa Tara Ban-peri ka; <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />yià mǝnana à ɓallia arǝ anggurkwar malea, sǝ arǝ aɓala-kàu malea ka à nda á-ɓari nǝ gbǝman-tongno-nong-mwashat nǝ lumi-tàrú (2,630). <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Mǝnia ka nda làkkì mala amuna andǝ amǝkau a nggurkwar mala Gashon, mǝnana à kārǝ́na à nǝ̀ pàk túró aɓa Tara Ban-peri, mana Musa andǝ Haruna ɓallia kǝla mana Yahweh bang ngga.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />Aburana mǝnana à ɓallia arǝ anggurkwar mala amuna andǝ amǝkà Merari, sǝ arǝ aɓala-kàu malea, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />twal a ban ɓwa mǝnana pǝlǝa male na lumi-tàrú aban ká lumi-tongno, mǝnana kārǝ́na nǝ̀ pàk túró aɓa Tara Ban-peri ka, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />yià mǝno à ɓallia arǝ anggurkwar malea ka, à nda á-tàrú nǝ gbǝman-ɓari (3,200). <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Mǝnia ka nda làkkì mala amuna andǝ amǝkau a nggurkwar mala Merari, mana Musa andǝ Haruna ɓallia kǝla mana Yahweh bangŋi nǝ kún Musa ka.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Nda Musa andǝ Haruna andǝ aɓwana-mǝgule mala Isǝrayila ɓal Amǝ'Lawi arǝ anggurkwar sǝ arǝ aɓala-kàu malea ka. <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />Aɓwana mǝnana kat pǝlǝa malea na lumi-tàrú aban ká lumi-tongno, mǝnana à kārǝ́na à nǝ̀ pàk túró andǝ twaltwalo mala agir mala Tara Ban-peri ka, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />làkkì malea na á-tongno-nong-tàrú nǝ gbǝman-tongno nǝ lumi-tongno-nong-tàrú (8,580). <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />À ɓallia aɓa kpata nzongcau mala Yahweh nǝ kún Musa, koyan ngga nǝ túró male mǝnana nǝ̀ pàk ka ko gìr mǝnana nǝ̀ twal ka. Anggo sǝ à ɓallia kǝla mana Yahweh banggi Musa ka.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s">À pusǝki amǝɓeami a kàttì</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />Yahweh nacau nǝ Musa, ama, <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />&lt;&lt;Banggi amǝ Isǝrayila ama ɓǝà pusǝ koyan mǝnana ndanǝ kwánó nggû,<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 13">Pǝris 13</ref></char>.</note> andǝ koyan mǝnana mùrgìr kǝ pur arǝì, andǝ koyan mǝnana pǝndǝki rǝì nǝ je lú ka, ɓǝà purî ɓá kàttì; <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />ko ɓwabura ko ɓwama na ka, wun nǝ̀ pusǝia, ɓǝà purî ɓá kàttì, ace mǝnana ɓǝà kǝa pǝndǝki akàttì malea, mǝnana mǝ ndakam nǝdo aɓalǝia ka ɗàng.&gt;&gt;<verse eid="NUM 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 5:4" />Amǝ Isǝrayila pàk mǝno; à pusǝkia à purî ɓá kàttì. Kǝla mana Yahweh banggi Musa ka, anggo sǝ amǝ Isǝrayila pǎ.<verse eid="NUM 5:4" /></para>
  <para style="s">Bang-cauɓikea andǝ mbwegìr-akúnì</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />Sǝ Yahweh nacau nǝ Musa, ama, <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />&lt;&lt;Banggi amǝ Isǝrayila ama: Lang ɓwabura ko ɓwama yàl nzongcau mala Yahweh nǝ pakkì ɓì mǝɓane a koya buì, sǝ ɓwê yì ear cauɓikea male ka, <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />dumǝna púp ɓwê nǝ̀ bang cauɓikea male mǝnana pàk ka. Sǝ dumǝna púp nǝ̀ mbwegìr puppup a kúnì gìr mǝnana kat kiɗiki ka, sǝ nǝ̀ tsǝk banì mwashat aɓa gauwe tongno mala gìrnî amurí, sǝ nǝ̀ pè ɓwa mǝno pàkki wi mǝɓane ka. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Sǝ ɓǝ̀ ɓwê pànǝ kǝ mǝliɓala mǝnana à nǝ̀ kánǝ mǝno yì mbwegìr-akúnì ka abani raka, yì mbwegìr-akúnì ka pǝlǝna mala Yahweh sǝ dumǝna púp à nǝ̀ pè pǝris, atārǝia andǝ gam mala shawuɗiban mǝnana à nǝ̀ shawuɗi ɓwê nǝi ace mǝɓane mǝnana pàk ka. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Sǝ koya ɓoro mala apagir mǝfele mala amǝ Isǝrayila, mǝnana à kǝ yinǝia aban pǝris ka, à nǝ̀ duk mala pǝris. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Agir mǝfele mala koya ɓwa ka amale na, sǝ ɓǝ̀ mana kat ɓwa pè pǝris ka mala pǝris na.&gt;&gt;<verse eid="NUM 5:10" /></para>
  <para style="s">Ɓwama mana burí tsǝki wi cau arǝì ka</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />Yahweh nacau nǝ Musa, ama, <verse eid="NUM 5:11" /><verse number="12-14" style="v" sid="NUM 5:12-14" />&lt;&lt;Banggi amǝ Isǝrayila ama: Ɓǝ̀ ɓwabura tsǝki māmí cau arǝì, mala kyanggî njar, ama māmí lǝmdǝna ɗwanyi-domǝsǝcau a baní, nǝ nongŋo-nda andǝ ɓe ɓwabura, sǝ burí sǝlǝce ɗàng, sǝ kǝ ɓwa sǝlǝce raka (acemǝnana kǝ ɓwa sǝni ko bwali aban pe raka), sǝ ɓǝ̀ burí pàk mɓali, sǝ nusǝ māmí nǝ pǝndǝki rǝì, ko mɓali bwali sǝ nusǝ māmí, kat andǝ amani ama māmí pǝndǝki rǝì raka, <verse eid="NUM 5:12-14" /><verse number="15" style="v" sid="NUM 5:15" />ɓǝ̀ kyan nǝ māmí aban pǝris. Sǝ ɗǝm ngga ɓǝ̀ yinǝ pagìr amur māmí: tyang mwashat mala muku mǝssa-bálì; sǝama pà nǝ̀ so kǝ mùrú amurí ɗàng, sǝ pà nǝ̀ kpapi wi myang-kwarra aɓalǝi ɗàng, acemǝnana pàgir mǝsǝsa na mala nusǝban-mɓali, sǝ pàgir na ace kasǝɓalǝu, mala nyesǝ ɗenyicau arǝ pě-mǝɓane mala ɓwa.<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />&lt;&lt;Sǝ Pǝris nǝ̀ yinǝi ɓwame ɓǝ̀ yi came aɓadǝm Yahweh. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Pǝlǝa pǝris nǝ̀ so mùr mǝfele aɓa nkwaring dǝɓang sǝ nǝ̀ ɗàrǝ́ tú a nzali aɓa Taragula sǝ nǝ̀ soe aɓa mùr mǝnia. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />Sǝ pǝris nǝ̀ tamsǝ ɓwame aɓadǝm Yahweh, nǝ̀ panzǝki nyang múr ɓwame, sǝ nǝ̀ tsǝki wi pàgir mǝsǝsa mala kasǝɓalǝu, mǝnana nda pàgir mǝsǝsa mala nusǝban-mɓali ka, a ɓabui, sǝ yì pǝris ka nǝ̀ twal mùr mǝlulle mǝnana kǝ yinǝ suban ngga a buì. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Pǝlǝa pǝris nǝ̀ tsǝk ɓwame ɓǝ̀ kángìr, nǝ̀ ne ɓwame ama, &lt;Ɓǝ̀ ɓekǝ ɓwabura mǝnana burio na raka nongnǝ we ɗang, sǝ a pǝlǝmì njar a kútímá a ɓeami, kǝla ɓwama aɓata burí raka, ɓǝ̀ suban mǝnana mǝnia yì mùr mǝlulle kǝ yinǝi ka ɓǝ̀ yàllî muro. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Sǝama ɓǝ̀ a kyangŋǝ́nì njar, mǝnana a nda aɓata burio, a pǝndǝkina ɓamurò, sǝ ɓè ɓwabura mǝnana burio na raka nongŋǝna nǝ we ka, <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />suban mǝnia ka nǝ̀ sulǝo amuro.&gt; Pǝlǝa pǝris ka nǝ̀ tsǝk ɓwame ɓǝ̀ kána, kángìr mala suban, sǝ pǝris nǝ̀ banggi ɓwame ama, &lt;Ɓǝ̀ aɓwana mô sǝlǝ ama suban mala Yahweh na amuro, lang Yahweh tsǝngŋǝ̀nà abyalo kwetǝna, sǝ tabumo mwarna ka; <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />ɓǝ̀ mùr mǝnia mǝnana kǝ yinǝ suban ngga, ɓǝ̀ kùtí a bumo, ɓǝ̀ tsǝk tabumo ɓǝ̀ mwaro sǝ abyalo ɓǝà eamdǝe.&gt;</para>
  <para style="p" vid="NUM 5:22">&lt;&lt;Pǝlǝa ɓwame ka nǝ̀ ear ama, &lt;Amin, Ɓǝ̀ do anggo.&gt;<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />&lt;&lt;Pǝlǝa pǝris ka nǝ̀ gilǝ asuban mǝnia ka aɓa mbu-malǝmce, sǝ nǝ̀ lea nǝ mùr, ɓǝà solǝo aɓa mùr mǝlulle mǝno. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />Sǝ nǝ̀ tsǝk ɓwame ɓǝ̀ nu mùr mǝlulle mǝnia mana kǝ yinǝ suban ngga, sǝ yì mùr ka nǝ̀ kùtí a bumi sǝ nǝ̀ yinǝi wi nǝ tanni mǝlulle. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />Sǝ pǝris nǝ̀ ak pàgir mǝsǝsa mala nusǝban-mɓali a bu ɓwame, sǝ nǝ̀ lǝmdǝí a kuli aɓadǝm Yahweh, sǝ nǝ̀ yinǝi aban gyangŋan. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />Sǝ pǝris nǝ̀ ɗàrǝ́ aɓa pàgir mǝsǝsa mǝno ka, ɓǝ̀ lùmsǝ ɓabui, ɓǝ̀ duk kāmbe male mala kasǝɓalǝu, sǝ nǝ̀ pisǝi amur gyangŋan; anzǝm mǝno ka, nǝ̀ tsǝk ɓwame ɓǝ̀ nu mùr mǝno.<verse eid="NUM 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 5:27" />&lt;&lt;Anzǝm mana tsǝ̀ngŋǝ̀nà ɓwame nuna mùrnî, sǝ ɓǝ̀ do ama ɓwame pǝndǝkina ɓamurì, lǝmdǝna ɗwanyi-domǝsǝcau aban burí ka, mùr mala yinǝ suban ngga nǝ̀ kùtí a bumi, sǝ nǝ̀ yinǝi wi nǝ tanni mǝlulle, sǝ tabumi nǝ̀ mwaro, sǝ abyali nǝ̀ kpami, sǝ ɓwame nǝ̀ pǝlǝ gìr suban aɓalǝ aɓwana male. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Sǝama ɓǝ̀ ɓwame ka pǝndǝki ɓamurì ɗàng, nda aɓa ɓoarnsari ka, nǝ̀ pà atàrǝì, kǝgìr mǝɓane pà nǝ̀ kumi ɗàng, sǝ nǝ̀ kum ɓǝlmuna.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />&lt;&lt;Mǝnia ka nda nggurcau mǝnana à nǝ̀ kpate amur mɓali ka, lang ɓwama mǝnana ndanǝ bura amurí ka kyanggî njar, sǝ kya pǝndǝki ɓamurì, <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />ko a pwari mana ɓwabura ka mɓali bwali sǝ pàk mɓali ace māmí ka. Yì ka nǝ̀ yinǝ māmí aɓadǝm Yahweh sǝ pǝris nǝ̀ kpata acau mala nggurcau mǝnia amur ɓwame. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" />Yì bura ɓwama ka, à pà nǝ̀ sǝni nǝ cauɓikea ɗàng,<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="fq" closed="false">à pà nǝ̀ sǝni nǝ cauɓikea ɗàng </char><char style="ft" closed="false">ko &lt;&lt;à pà nǝ̀ tsǝkîcau arǝì ama pàngŋǝ́nì māmí gìr mǝɓane ɗàng&gt;&gt; </char></note> sǝ ɓwama ka, bafe mala cauɓikea male mǝnana pàk ka nǝ̀ do amurí.&gt;&gt;<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s">Pacau mala Ɓwa-nazir</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />Yahweh nacau nǝ Musa, ama, <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama: Lang ɓwabura ko ɓwama nǝ̀ twal kanggǝrang pàcau nǝ-shambum, mala duk ɓwa-nazir, ace tàr ɓamurì aban Yahweh ka, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />dumǝna púp nǝ̀ yál ɓamurì arǝ nu mùr-anap andǝ mba. Dumǝna púp pà nǝ̀ nu ɓekǝ mùr-hangŋa mǝnana à pè nǝ mùr-anap, ko mùr-hangŋa mana à pè nǝ mba ka ɗàng; sǝ pà nǝ̀ nu ɓekǝ girnùná mǝnana à kàmbi arǝ ɓǝla-anap ka ɗàng; sǝ pà nǝ̀ lì ɓǝla-anap, pwàlè ko imè ɗàng. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Aɓalǝ anonggio kat mala tàrɓamuru male ka, pà nǝ̀ lì ɓekǝ gìr mǝnana kat pùro arǝ nggun-anap, ko amǝsǝi na ko nggwate na ka ɗàng.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />&lt;&lt;Aɓalǝ anonggio mala pàcau nǝ-shambum mala tàrɓamuru male kat ka, ɓekǝ nkembu pa nǝ̀ je ɓamúrí ɗàng, she pwari mǝnana anonggio mala do male kǝla ɓwa-nazir aban Yahweh lùmsǝna ka. Yì ka nǝ̀ duk mǝfele sǝ nǝ̀ nying nyang ɓamúrí ɓǝ̀ dāh'rya.<verse eid="NUM 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6" />&lt;&lt;Aɓalǝ anonggio kat mala tàrɓamuru male aban Yahweh ka, dumǝna púp pà nǝ̀ ká amur lú ɗàng. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />Dumǝna púp, pà nǝ̀ pǝndǝki ɓamurì ɗàng ko ɓǝ̀ nda ace lú mala tárrí, ko nggè, ko mǝ'eambi-ɓwabura, ko mǝ'eambi-ɓwama ka ɗàng. Mǝnia ka nda acemǝnana nyang mǝnana a múrí, mana lǝmdǝ tàrɓamuru male aban Ɓakuli ka, nda a ɓamúrí. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Aɓalǝ anonggio mala tàrɓamuru male kat ka, nǝ̀ duk mǝfele aban Yahweh.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />&lt;&lt;Ɓǝ̀ kǝ ɓwa kasǝa wǔ aɓa yasǝlǝban a nkanggari, mǝnana nǝ̀ tsǝa nyang ɓamúrí mala tàrɓamuru male nǝ̀ pǝndǝki ka, dumǝna púp nǝ̀ mwa nyang ɓamúrí a pwari lakban male; nǝ̀ mwe a tongno-nong-ɓaria pwari. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />A tongno-nong-tàruià pwari ka nǝ̀ yinǝ akutugangyi ɓari ko amuna-kutumurǝm ɓari aban pǝris, a bankutio aɓa Tara Ban-peri. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Pǝris nǝ̀ pà mwashat kǝla pàgir ace cauɓikea, sǝ ɓè ka ace pàgir mala pisǝe kǝring, sǝ nǝ̀ shawuɗì, acemǝnana lú mǝno wù a nkanggari tù ka, nunbi wi cauɓikea amurí, sǝ dumǝna púp ama àkǝ̀ pwari mǝno ka nǝ̀ tsǝk ɓamúrí ɓǝ̀ duk mǝfele ɗǝm. <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />Dumǝna púp nǝ̀ tàr ɓamurì ɗǝm ace anonggio male, mala do ɓwa-nazir aban Yahweh, sǝ nǝ̀ yinǝ muna-gam mǝnana mbule mwashat ka ace pàgir mala kumcau. Sǝ anonggio mǝɗiɗyalni ka, à nǝ̀ ueɓà acemǝnana tàrɓamuru male pǝndǝkina.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />&lt;&lt;Mǝnia ka nda nggurcau mǝnana à nǝ̀ kpate ace ɓwa-nazir, lang anonggio mala tàrɓamuru male lùmsǝna ka: à nǝ̀ yinǝi a bankutio aɓa Tara Ban-peri; <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />sǝ yì ka nǝ̀ yinǝ pàgir male aban Yahweh ani: muna-gam mǝnana mbule mwashat, sǝ ɓè kǝgìr mǝɓane pà kàm arǝì raka, ace pàgir mala pisǝe kǝring, andǝ muna-nzur mǝnana mbule mwashat ka, ace pàgir mala gǝshi cauɓikea, andǝ gam mana ɓè kǝgìr mǝɓane pà kàm arǝì raka, ace pàgir mala dotarǝu, <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />atārǝia andǝ apagir mala mǝsǝsa andǝ apagir mala girnùná malea, andǝ zace mala agbatali bǝredi mana yis pà arǝì raka, mana à pea nǝ muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, andǝ abiskit mana à pea nǝ yis raka, sǝ à hasǝkia wia mùrú olif arǝia ka.<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />&lt;&lt;Sǝ pǝris nǝ̀ yinǝ agir mǝnia kat ka tù aɓadǝm Yahweh, sǝ nǝ̀ pà gir'nkila mala pàgir mala gǝshi cauɓikea male, yì ɓwa-nazir, andǝ pàgir male ace pisǝe kǝring. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />Pǝlǝa nǝ̀ pà gir'nkila nǝ gam mala pàgir ace dotarǝu aban Yahweh, atārǝia andǝ bǝredi mana yis pà arǝì raka, mǝnana nda aɓa zace ka; sǝ a masǝlǝate ka nǝ̀ pàgir mala mǝsǝsa atārǝia andǝ pàgir mala girnùná.<verse eid="NUM 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 6:18" />&lt;&lt;Anzǝm mǝno ka, yì ɓwa-nazir ka nǝ̀ mwa ɓamúrí mala tàrɓamuru male, a bankutio aɓa Tara Ban-peri, sǝ nyang ɓamúrí mala tàrɓamuru male ka, nǝ̀ twali sǝ nǝ̀ tsǝì amur bǝsa mǝnana nda aɓata gir'nkila mala apagir mala dotarǝu ka. <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />Anzǝm mana ɓwa-nazir mwana nyang mala tàrɓamuru male ka, pǝlǝa pǝris nǝ̀ twal bù gam, mǝnana à lamni ka, sǝ nǝ̀ twal gbatali bǝredi mwashat mǝnana yis pà arǝì raka, andǝ biskit mwashat mana yis pà arǝì raka, amǝnana aɓa zace ka, sǝ nǝ̀ tsǝia arǝ abú ɓwa-nazir. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Pǝlǝa pǝris nǝ̀ loasǝia a kuli, ɓǝ̀ duk pàgir mǝnana à loasǝi a kuli aɓadǝm Yahweh ka. Akāmbe mǝfele na ace pǝris, atārǝia andǝ kikil gam mana à loasǝi a kuli, andǝ byali mana à pàna ɓoro nǝi ka.<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 29:27-28">Pur 29:27-28</ref>; <ref loc="LEV 7:14">Pǝris 7:14</ref>,<ref loc="LEV 7:32">32</ref>,<ref loc="LEV 7:34">34</ref></char>.</note> Anzǝm mǝno ka, yì ɓwa-nazir ka à earǝ́nì wi ɓǝ̀ nu mùr-anap.<verse eid="NUM 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 6:21" />&lt;&lt;Mǝnia ka nda nggurcau amur ɓwa-nazir mǝnana pàcau nǝ-shambum, sǝ amur pàgir male mǝnana nǝ̀ pà aban Yahweh ace tàrɓamuru male ka. Dumǝna púp nǝ̀ yinǝ pàgir mǝnia ka, sǝ ɓǝ̀ nǝ̀ gandǝi ka, ɓǝ̀ yinǝ aɓea amur mǝno, aɓa kpata nggurcau mala tàrɓamuru male.&gt;&gt;<verse eid="NUM 6:21" /></para>
  <para style="s">Tsǝkbu mala apǝris amur aɓwana</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />Yahweh ne Musa ama, <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />&lt;&lt;Banggi Haruna andǝ amuna-burana male ama: Ani sǝ wun nǝ̀ tsǝki amǝ Isǝrayila bù. Wun nǝ̀ banggia wia ama,<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />&lt;&lt; &lt;Ɓǝ̀ Yahweh tsǝka wun bù,</para>
  <para style="q2" vid="NUM 6:24">ɓǝ̀ yál wun;<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />Ɓǝ̀ Yahweh tsǝa ɓamǝsǝi ɓǝ̀ tǎ amur wun,</para>
  <para style="q2" vid="NUM 6:25">ɓǝ̀ lǝmdǝa wun ɓwamuru;<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />Ɓǝ̀ Yahweh sǝn mǝsǝswatǝr ma'wun,</para>
  <para style="q2" vid="NUM 6:26">ɓǝ̀ pa wun dorǝpwala.&gt;<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />&lt;&lt;Anggo ka à nǝ̀ tsǝk lullǝam amur amǝ Isǝrayila, sǝ mǝ nǝ tsǝkia wia bù.&gt;&gt;<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s">Apagir ace tàr Taragula</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Lang Musa malǝna loasǝ Taragula ka,<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 40:17">Pur 40:17</ref>,<ref loc="EXO 40:18">18</ref></char>.</note> pǝlǝa ɗārǝi sǝ tàrì andǝ agirtúró male kat. Ɗǝm ngga ɗārǝ gyangŋan sǝ tàrì andǝ agirtúró male kat. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Sǝ à yinǝ aɓwana-mǝgule mala Isǝrayila, amúrû amur aɓala-kàu malea, mǝnana à nda ka amǝdǝmba mala atau ka. Yia na mǝnana à tsǝia amur aɓwana mǝnana à ɓallia ka; à yiu sǝ à cam tù, <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />sǝ à yinǝ apagir malea aɓadǝm Yahweh: akeke-ndá tongno-nong-mwashat andǝ ajamnda lum-nong-ɓari; keke-ndá mwashat ace ɓari atà amúrû mala atau, sǝ jamnda mwashat ace koyan ateà. À yinǝia a ɓadǝm Taragula.<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />Pǝlǝa Yahweh ne Musa ama, <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />&lt;&lt;Ak agir mǝnia ka a buia, sǝ wu pe amǝ'Lawi ace túró twal agir mǝfele mala Tara Ban-peri, koyan ateà ka kǝla mana túró male nǝ̀ pàk ka.&gt;&gt;<verse eid="NUM 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 7:6" />Nda Musa ak akeke-ndá andǝ ajamnda mǝno sǝ pè amǝ'Lawi ka. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Pè amǝ'Gashon akeke-ndá ɓari andǝ ajamnda ine, kǝla mana kún túró malea pàk ka. <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />Pè amǝ'Merari akeke-ndá ine andǝ ajamnda tongno-nong-tàrú, kǝla mana kún túró malea pà aɓata gingnǝban mala Itamar muna-ɓwabura mala Haruna pǝris ka. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Sǝ amǝ'Kohat ka Musa pea wia kǝgìr ɗàng acemǝnana túró malea ka nda tsǝkir agir ɓá ban-mǝfele, mǝnana a kwàrú sǝ à nǝ̀ twalia ka.<verse eid="NUM 7:9" /></para>
  <para style="mi">
    <verse number="10" style="v" sid="NUM 7:10" />A pwari mǝnana à nǝ̀ ɗārǝ gyangŋan ngga, amúrû mala atau pāki apagir ace tàre; à yinǝ apagir malea a ɓadǝm gyangŋanì. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />Yahweh banggi Musa ama, &lt;&lt;Aɓa pwari mwashat ka ɓwamǝgule mwashat na nǝ̀ yinǝ pàgir male ace tàr gyangŋan ngga.&gt;&gt;<verse eid="NUM 7:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 7:12" />Ɓwamǝgule mǝnana yinǝ pàgir male a pwari mǝdǝmbe ka nda Nashon muna-ɓwabura mala Aminadap, a tàu mala Yahuda.<verse eid="NUM 7:12" /></para>
  <para style="mi">
    <verse number="13" style="v" sid="NUM 7:13" />Sǝ pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na ka, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne; <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />sǝ ace gir'nkila mala apagir mala dotarǝu<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 3:1">Pǝris 3:1</ref></char>.</note> ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Nashon muna-ɓwabura mala Aminadap.<verse eid="NUM 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="NUM 7:18" />A ɓaria pwari ka Netanel muna-ɓwabura mala Zuar, múr-là mala Isaka, yinǝ pàgir male.<verse eid="NUM 7:18" /></para>
  <para style="mi">
    <verse number="19" style="v" sid="NUM 7:19" />Pàgir male mǝnana pà ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Netanel muna-ɓwabura mala Zuar.<verse eid="NUM 7:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="NUM 7:24" />A tàruià pwari ka Eliyap muna-ɓwabura mala Helon, múr-là mala amǝkà Zebulu yinǝ pàgir male.<verse eid="NUM 7:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="NUM 7:25" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat-mwashat na ka ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Eliyap muna-ɓwabura mala Helon.<verse eid="NUM 7:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="NUM 7:30" />A inea pwari ka Elizur muna-ɓwabura mala Shedeur, múr-là mala amǝkà Ruben yinǝ pàgir male.<verse eid="NUM 7:30" /></para>
  <para style="mi">
    <verse number="31" style="v" sid="NUM 7:31" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ̀ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Elizur muna-ɓwabura mala Shedeur.<verse eid="NUM 7:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="NUM 7:36" />A tongnoia pwari ka Shelumiyel muna-ɓwabura mala Zurishaddai, múr-là mala amǝkà Shimiyon yinǝ pàgir male.<verse eid="NUM 7:36" /></para>
  <para style="mi">
    <verse number="37" style="v" sid="NUM 7:37" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />andǝ lo-jamnda a domwan, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Shelumiyel muna-ɓwabura mala Zurishaddai.<verse eid="NUM 7:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="NUM 7:42" />A tongno-nong-mwashatia pwari ka Eliyasaf muna-ɓwabura mala Dewel, múr-là mala amǝkà Gad yinǝ pàgir male.<verse eid="NUM 7:42" /></para>
  <para style="mi">
    <verse number="43" style="v" sid="NUM 7:43" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Eliyasaf muna-ɓwabura mala Dewel.<verse eid="NUM 7:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="NUM 7:48" />A tongno-nong-ɓaria pwari ka Elishama muna-ɓwabura mala Ammihud, múr-là mala amǝkà Ifǝrem yinǝ pàgir male.<verse eid="NUM 7:48" /></para>
  <para style="mi">
    <verse number="49" style="v" sid="NUM 7:49" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Elishama muna-ɓwabura mala Ammihud.<verse eid="NUM 7:53" /></para>
  <para style="m">
    <verse number="54" style="v" sid="NUM 7:54" />A tongno-nong-tàruià pwari ka Gamaliyel muna-ɓwabura mala Pedazur, múr-là mala amǝkà Manasa, yinǝ pàgir male.<verse eid="NUM 7:54" /></para>
  <para style="mi">
    <verse number="55" style="v" sid="NUM 7:55" />Pàgir male mǝnana pà ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝno ka nda pàgir mala Gamaliyel muna-ɓwabura mala Pedazur.<verse eid="NUM 7:59" /></para>
  <para style="m">
    <verse number="60" style="v" sid="NUM 7:60" />A tongno-nong-inea pwari ka Abidan muna-ɓwabura mala Gidiyoni, múr-là mala amǝkà Benjami yinǝ pàgir male.<verse eid="NUM 7:60" /></para>
  <para style="mi">
    <verse number="61" style="v" sid="NUM 7:61" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Abidan muna-ɓwabura mala Gidiyoni.<verse eid="NUM 7:65" /></para>
  <para style="m">
    <verse number="66" style="v" sid="NUM 7:66" />A lumia pwari ka Ahieza muna-ɓwabura mala Amishaddai, múr-là mala amǝkà Dan yinǝ pàgir male.<verse eid="NUM 7:66" /></para>
  <para style="mi">
    <verse number="67" style="v" sid="NUM 7:67" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Ahieza muna-ɓwabura mala Amishaddai.<verse eid="NUM 7:71" /></para>
  <para style="m">
    <verse number="72" style="v" sid="NUM 7:72" />A lum-nong-mwashatia pwari ka Pagiyel muna-ɓwabura mala Okran, múr-là mala amǝkà Asha yinǝ pàgir male.<verse eid="NUM 7:72" /></para>
  <para style="mi">
    <verse number="73" style="v" sid="NUM 7:73" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Pagiyel muna-ɓwabura mala Okran.<verse eid="NUM 7:77" /></para>
  <para style="m">
    <verse number="78" style="v" sid="NUM 7:78" />A lum-nong-ɓaria pwari ka Ahira muna-ɓwabura mala Enan, múr-là mala amǝkà Naftali yinǝ pàgir male.<verse eid="NUM 7:78" /></para>
  <para style="mi">
    <verse number="79" style="v" sid="NUM 7:79" />Pàgir male ka paranti na mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), andǝ tasau mǝnana à pè nǝ bolo-azǝrfa sǝ dǝmbǝrya male ka shekel lumi-tongno-nong-ɓari na ka (70); à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià kǝm ngga à lùmsǝia nǝ muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ace pàgir mala mǝsǝsa ka. <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />Ɗǝm ngga yinǝ muna-nkenye mǝnana à pè nǝ bolo-njengǝlan sǝ dǝmbǝrya male ka shekel lum na, sǝ à lùmsǝì nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka; <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />andǝ lo-jamnda, andǝ gam, andǝ muna-gam mǝnana mbule mwashat ka, ace pàgir mala pisǝe kǝring; <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />andǝ gbato ace pàgir mala gǝshi cauɓikea; <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />sǝ ace gir'nkila mala apagir mala dotarǝu ka yinǝ andá ɓari, agam tongno, agbato tongno, andǝ amuna-gam tongno mǝnana mbulea mwashat-mwashat ka. Mǝnia ka nda pàgir mala Ahira muna-ɓwabura mala Enan.<verse eid="NUM 7:83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />Amǝnia ka à nda ka apagir mala amúrû mala atau mala Isǝrayila ace tàr gyangŋan lang à ɗārǝi ka: aparanti bolo-azǝrfa lum-nong-ɓari, atasau bolo-azǝrfa lum-nong-ɓari, amuna-nkenye bolo-njengǝlan lum-nong-ɓari, <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />koya paranti bolo-azǝrfa ka dǝmbǝrya male ka shekel gbǝman-mwashat nǝ lumi-tàrú na (130), sǝ koya tasau bolo-azǝrfa ka dǝmbǝrya male na shekel lumi-tongno-nong-ɓari (70). Dǝmbǝrya kat-kat mala atanggǝla bolo-azǝrfa ka shekel á-ɓari nǝ gbǝman-ine na (2,400); à kpata shekel mǝnana à ear amurí a Tara-mǝfele ka. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Komǝye atà amuna-nkenye bolo-njengǝlan lum-nong-ɓari mǝnana à lùmsǝia nǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne ka, dǝmbǝrya male na shekel lum; à kpata shekel mǝnana à ear amurí a ban-mǝfele ka. Yià amuna-nkenye bolo-njengǝlan kat ka dǝmbǝrya malea na shekel gbǝman-mwashat nǝ lumi-ɓari (120). <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />Agirkusǝu mǝnana kat à yinǝia ace pàgir mala pisǝe kǝring ngga à nda ka: ajamnda lum-nong-ɓari, agam lum-nong-ɓari, amuna-gam mǝnana mbulea mwashat-mwashat ka lum-nong-ɓari, atārǝia andǝ pàgir mala mǝsǝsa malea; andǝ agbato lum-nong-ɓari ace pàgir mala gǝshi cauɓikea. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />Làkkì mala agirkusǝu kat-kat ace pà gir'nkila mala pàgir mala dotarǝu ka à nda ka: ajamnda lumi-ɓari-nong-ine, agam lumi-tongno-nong-mwashat, agbato lumi-tongno-nong-mwashat, amuna-gam lumi-tongno-nong-mwashat mǝnana mbulea mwashat-mwashat ka. Amǝnia ka à nda ka apagir ace tàr gyangŋan anzǝm ɗārǝè.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />A koya pwari sǝ Musa kútí aɓa Tara Ban-peri nǝ̀ nacau nǝ Yahweh ka, kǝ ok gì Yahweh aban ne wi cau a nre ka acerup ɓari mǝnana à mǝn abuia a kùli amur buno sǝntǝ̀r, mǝnana nda amur Akwati mala Acau-nakûn ngga; anggo sǝ Yahweh kǝ ne wi cau.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s">Tsǝki apitǝla</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />Yahweh ne Musa cau, ama, <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />&lt;&lt;Nacau nǝ Haruna sǝ wu banggi wi ama, &lt;Lang awu nǝ tamsǝki apitǝla ka, tsǝia a njar mǝnana à nǝ̀ nggǝ pâ tǎlaban a ɓadǝm gìr-tàmsǝia ka.&gt; &gt;&gt;<verse eid="NUM 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3" />Anggo sǝ Haruna pǎ; tsǝki apitǝla à pǝlǝ nǝ ɓadǝm gìr-tàmsǝia, kǝla mǝnana Yahweh banggi Musa ka. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Ani sǝ à pàk gìr-tàmsǝ apitǝla: à pè nǝ bolo-njengǝlan mǝnana à walki ka, twal a kusǝì aban ká arǝ nyoulǝa rǝi mala tǒ mala afufe. Anggo sǝ pè kǝla mǝnana Yahweh lǝmdǝì Musa ka.<verse eid="NUM 8:4" /></para>
  <para style="s">Lak amǝ'Lawi andǝ tària</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />Yahweh banggi Musa ama: <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />&lt;&lt;Pusǝ amǝ'Lawi aɓalǝa amǝ Isǝrayila sǝ wu leǎ. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Ace leǎ ka pàk mǝnia: Watsǝkia wia mùr lakban amúrià; sǝ wu tsǝia ɓǝà mwa nyang mǝnana a rǝia ka kat, sǝ ɓǝà lakki agir'nggūrǝia. Anggo sǝ à nǝ̀ lak ɓamuria. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Anzǝm mǝno ka ɓǝà yinǝ jamnda, atārǝia andǝ pàgir mala mǝsǝsa male, mǝnana muku mǝɓǝlke na à zurì nǝ mùrú olif ka; sǝ awu nǝ twal ɓè jamnda a domwan ace pàgir mala gǝshi cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="fq" closed="false">pàgir mala gǝshi cauɓikea </char><char style="ft" closed="false">ko </char><char style="fqa" closed="false">pàgir mala lakban;</char><char style="ft" closed="false">anggo gbal a mǝsǝì 12</char></note> <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Pǝlǝa awu nǝ yinǝ amǝ'Lawi aɓadǝm Tara Ban-peri, sǝ wu ram ɓinala amǝ Isǝrayila kat. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Lang a yinanǝ amǝ'Lawi aɓadǝm Yahweh ka, pǝlǝa aɓwana-mǝgule mala amǝ Isǝrayila nǝ̀ nongsǝ abuia amur amǝ'Lawi. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Pǝlǝa Haruna nǝ̀ yinǝ amǝ'Lawi aɓadǝm Yahweh, ɓǝà do kǝla pàgir mana à loasǝi a kuli mǝnana amǝ Isǝrayila pa, ace mǝnana ɓǝà do aɓa gilǝrǝu ace pak túró mala Yahweh ka.<verse eid="NUM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 8:12" />&lt;&lt;Pǝlǝa amǝ'Lawi ka ɓǝà nongsǝ abuia a ɓamur ajamnda, mǝnana mwashat ka nda ace pàgir aban Yahweh mala gǝshi cauɓikea, sǝ ɓè ka nda ace pàgir mala pisǝe kǝring, ace shawuɗi amǝ'Lawi. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Awu nǝ tsǝk amǝ'Lawi ɓǝà came aɓadǝm Haruna andǝ amuna-burana male, sǝ awu nǝ tària ɓǝà duk pàgir mǝnana à loasǝi a kuli aban Yahweh ka. <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />Anggo sǝ awu nǝ pusǝ amǝ'Lawi aɓalǝa amǝ Isǝrayila, sǝ amǝ'Lawi ka à nǝ̀ duk amem.<verse eid="NUM 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15" />&lt;&lt;Anzǝm mǝnana a langŋǝna amǝ'Lawi sǝ a tarnia kǝla pàgir mana à nǝ̀ loasǝi a kuli ka, à nǝ̀ ká ace pàktúró a Tara Ban-peri. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />À nda ka amǝ Isǝrayila mǝnana à panamia kǝring ngga. Ən twalnia ɓǝà duk amem a kúnì aɓwana mǝnana kat à tita puro a bum ngga, yì amuna-dǝmba aburana mala amǝ Isǝrayila kat. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />Koya muna-dǝmba muna-ɓwabura a Isǝrayila, ɓwapǝndǝa ko girkusǝu ka, mem na. Lang ǝn wal amuna-dǝmba kat a Masar ka, ǝn taria ace ɓamúràm. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Sǝ ǝn twalna amǝ'Lawi a kúnì amuna-dǝmba amuna-burana kat a Isǝrayila. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Aɓalǝa amǝ Isǝrayila kat ka, ǝn pana amǝ'Lawi kǝla ɓoro aban Haruna andǝ amuna-burana male ace pàktúró a Tara ban-peri a kúnì amǝ Isǝrayila, sǝ ɓǝà shawuɗia, ace mǝnana ɓǝ̀ ɓekǝ gìr'mur'mwana ɓǝkǝa wal amǝ Isǝrayila ɗàng lang à nǝ̀ gbàshìban ban-mǝfele ka.&gt;&gt;<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />Musa, andǝ Haruna, andǝ ɓinala amǝ Isǝrayila kat pàngnǝ amǝ'Lawi kǝla mana Yahweh banggi Musa ka. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Amǝ'Lawi lak ɓamuria sǝ à lakki agir'nggūrǝia. Pǝlǝa Haruna tària kǝla pàgir mǝnana à loasǝi a kuli aɓadǝm Yahweh ka, sǝ shawuɗia ace leǎ. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Anzǝm mǝno ka amǝ'Lawi wari ace pàktúró malea aɓa Tara Ban-peri aɓata gingnǝban mala Haruna andǝ amuna-burana male. À pàngnǝ amǝ'Lawi kǝla cau mana Yahweh banggi Musa ka.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />Yahweh banggi Musa ama, <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />&lt;&lt;Cau mǝnia ka nda arǝ amǝ'Lawi: Ɓwabura mǝnana pǝlǝa male na lumi-ɓari-bwamdǝ-tongno andǝ mana kútì ka nǝ̀ yiu ace pàk túró aɓa Tara Ban-peri. <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />Sǝ lang ɓwabura bingŋǝnà pǝlǝa lumi-tongno ka, nǝ̀ nyingbuì arǝ túró mǝnana pàkiyi pwari-pwari ka, sǝ pà nǝ̀ pàk túró ɗǝm ɗàng. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Yì ka nǝ̀ gandǝ bwali amǝ'eambi arǝ pakki atúró malea aɓa Tara Ban-peri, sǝama pà nǝ̀ pàk túrè nǝ nggearǝì ɗàng. Anggo sǝ awu nǝ pàkkî amǝ'Lawi aɓa kasǝia wia atúró mǝnana nda acea ka.&gt;&gt;<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s">Lamsan Yàlîmurû</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />Yahweh nacau nǝ Musa a pǝɗanban Saina, a zongŋo mǝdǝmbe mala ɓaria pǝlǝa anzǝm mana amǝ Isǝrayila purnì nzali Masar ka, ama, <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />&lt;&lt;Amǝ Isǝrayila ɓǝà kǝ pak lamsan mala Yàlîmurû a kǝ pwari mǝnana à tsǝì ace ka. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Wu pàk lamsan male a kǝ pwari mǝnana à tsǝk ka, nǝ pwarikpǝra a lum-nong-inea pwari mala mǝnia yì zongŋo ka; dumǝna púp wun nǝ̀ pàk lamsan male nǝ kpata angguracau male kat, andǝ anê male kat.&gt;&gt;<verse eid="NUM 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 9:4" />Nda Musa banggi amǝ Isǝrayila ɓǝà pak lamsan mala Yàlîmurû ka. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />Sǝ yià ka à pak lamsan Yàlîmurû a lum-nong-inea pwari mala zongŋo mǝdǝmbe, nǝ pwarikpǝra a pǝɗanban mala Saina. Amǝ Isǝrayila pàk koman kat kǝla mǝnana Yahweh banggi Musa ka.<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />Sǝ càu kumban ama aɓea aburana pǝlǝ gìr'ɓeami atàcau mala je lú ɓeɓwa, sǝ gìrnî tsǝa à gandǝ pak lamsan mala Yàlîmurû amǝno yì pwari ka ɗàng. Aburana mǝnia yiu aɓadǝm Musa andǝ Haruna amǝno yì pwari. <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />À ne Musa ama, &lt;&lt;Mǝsǝcau sǝm pǝlǝna gìr'ɓeami atàcau mala je lú ɓeɓwa. Sǝama palang sǝ mǝno ka tsǝa à tàmsǝ sǝm arǝ yinǝ pagìr mala Yahweh atà amǝ Isǝrayila a pwari mǝnana à tsǝì ace ka?&gt;&gt;<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />Musa earia wia ama, &lt;&lt;Wu kúndǝô, mǝ ok cau mǝnana Yahweh nǝ̀ bang ace wun ngga.&gt;&gt;<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />Pǝlǝa Yahweh bangcau nǝ Musa ama, <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />&lt;&lt;Banggi amǝ Isǝrayila ama: Ɓǝ̀ kǝɓwa aɓalǝ wun, ko atà amǝ'kà wun pǝlǝ gìr'ɓeami atàcau mala je lú, ko twal bǝri mǝsauwe ka, ɓwê nǝ̀ gandǝ pak lamsan mala Yàlîmurû abanam Yahweh. <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />Sǝama à nǝ̀ pè a lum-nong-inea pwari mala ɓaria zongŋo nǝ pwarikpǝra. À nǝ̀ shak nyam muna-gam mala Yàlîmurû nǝ bǝredi mana yis pà arǝì raka nǝ mbúgir mǝ'lùlle<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 12:8">Pur 12:8</ref>,<ref loc="EXO 12:15">15</ref>; <ref loc="DEU 16:3-4">Nggur 16:3-4</ref>,<ref loc="DEU 16:8">8</ref></char>.</note> atè. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />Dumǝna púp à pà nǝ̀ nying kǝ cili ɓǝ̀ ueo ba dǝmbari ɗàng, sǝ à pà nǝ̀ ɓun kǝ mui ɗàng;<note caller="+" style="f"><char style="fr" closed="false">9:12 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="EXO 12:10">Pur 12:10</ref>,<ref loc="EXO 12:46">46</ref>; <ref loc="PSA 34:20">Ang 34:20</ref>; <ref loc="JHN 19:36">Yoh 19:36</ref></char>.</note> sǝ dumǝna púp à nǝ̀ pàk lamsanì nǝ kpata angguracau mala Yàlîmurû kat. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Sǝama ɓǝ̀ ɓwa ka mǝɓoarnsari na, sǝ twal bǝri ɗang, sǝ gatti pàk lamsan mala Yàlîmurû ka, mǝno yì ɓwa ka à nǝ̀ pusǝ lullǝì aɓalǝ aɓwana male, acemǝnana yinǝ pagìr acem Yahweh a pwari mana à tsǝk ka ɗàng; mǝno yì ɓwa ka bafe mala cauɓikea male nǝ̀ ueo amurí.<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />&lt;&lt;Ɓǝ̀ ɓwa-kúnɗàngna do aɓalǝ wun, sǝ earce nǝ̀ pàk lamsan mala Yàlîmurû abanam Yahweh ka, dumǝna púp nǝ̀ kpata angguracau andǝ anê mala Yàlîmurû. Kǝ nggurcau mǝmwashati na ace ɓwa-kúnɗàngna andǝ ɓwa Isǝrayila.&gt;&gt;<verse eid="NUM 9:14" /></para>
  <para style="s">Pǝrɓang amur Taragula</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />A pwari mǝnana à loasǝ Taragula ka, pǝrɓangnî yi gìr múr Taragula, yì Tara mala Acau-nakûn,<note caller="+" style="f"><char style="fr" closed="false">9:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 40:17">Pur 40:17</ref>,<ref loc="EXO 40:34">34</ref>; <ref loc="NUM 7:1">Ɓal 7:1</ref></char>.</note> sǝ à sǝni kǝla bǝsa amur Taragula, twal a pwarikpǝra aban ká dǝmbari. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Anggo sǝ pǎ koya pwari: pǝrɓangnî gìr múr Taragula, sǝ nǝ du ka, à sǝni kǝla bǝsa. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />Sǝ ɓǝ̀ aya pwari sǝ pǝrɓangnî loapì múr tara ka, zuku ka amǝ Isǝrayila nǝ̀ lo gya, sǝ ban mǝnana kat pǝrɓangnî kya cam kam ngga, a banì sǝ amǝ Isǝrayila nǝ̀ duk kàttì.<note caller="+" style="f"><char style="fr" closed="false">9:17 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 40:36-38">Pur 40:36-38</ref>; <ref loc="NUM 10:11">Ɓal 10:11</ref>,<ref loc="NUM 10:33-34">33-34</ref></char>.</note> <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />Amǝ Isǝrayila kǝ lo gya kǝla mana Yahweh na ka, sǝ à kǝ duk kàttì kǝla mana na ka. Ɓǝ̀ lang sǝ pǝrɓangnî ka banì sauwa aban ueo amur Taragula ka, anggo sǝ à nǝ̀ ueo a kàttì. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Ko ɓǝ̀ pǝrɓangnî lidǝmba nǝ came amur Taragula arǝ anongŋo pas ka, amǝ Isǝrayila nǝ̀ okî Yahweh, à pà nǝ̀ lo gya ɗang. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Aɓea bákú ka, pǝrɓangnî nǝ̀ twal anongŋo bǝti aban ueo amur Taragula. Sǝ kǝla mana Yahweh bang ngga, à nǝ̀ ueo aɓa kàttì, sǝ kǝla mana Yahweh bang ngga, à nǝ̀ lo gya. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Sǝ arǝ aɓea apwari ka, pǝrɓangnî ueo, twal a pwarikpǝra aban ká dǝmbari, sǝ lang pǝrɓangnî lo nǝ bari ka, à lo gya. Ko nda nǝ pwari ko nǝ dú, pwari mǝnana kat pǝrɓangnî lo ka, à lo gya. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Ko ɓǝ̀ pǝrɓangnî twal nongŋo ɓari, ko zongŋo, ko banì sauwa nda piu amur Taragula ka, amǝ Isǝrayila ueo aɓa kàttì, à lo gya ɗang; sǝ lang longŋǝna ka, à lo gya. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />Aɓa nê mala Yahweh ka, à tsǝk kàttì, sǝ aɓa nê mala Yahweh ka, à lo gya. À kpata kwarkiru mala Yahweh; sǝ cau mǝnana kat Yahweh banggi Musa ama ɓǝà pàk ka, à pè.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s">Anjawe bolo-azǝrfa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />Yahweh bangcau nǝ Musa ama, <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />&lt;&lt;Wu tùl anjawe bolo-azǝrfa ɓari. Wun nǝ̀ pàngŋǝ̀nà-túró nǝia ace tunǝ ramba mala ɓwabundǝa, sǝ ace loapi kàttì. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Lang à twang anjawe mǝnia kǝm ngga, ɓwabundǝa puppup nǝ̀ ramba a bano a bankutio mala Tara Ban-peri. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Sǝ ɓǝ̀ njawe mǝdǝmbe na à twang ngga, amúrû, yì amǝdǝmba mala atau mala amǝ Isǝrayila na mǝnana à nǝ̀ ram rǝia a bano ka. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Sǝ lang wu ɓua njawe-lwa ka, akàttì mǝnana à tsǝk agumli malea a takuli ka, à nǝ̀ lo gya. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Sǝ lang wu ɓua ɓaria njawe-lwa ka, akàttì mǝnana à tsǝk agumli malea a njar-kunmur ka, à nǝ̀ lo gya. Ɓǝ̀ aya pwari sǝ à nǝ̀ lo gya ka, à nǝ̀ ɓua njawe-lwa. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Sǝ lang wun nǝ̀ ram ɓwabundǝa a banɓwáná ka, wun nǝ̀ twang njawe tè ɓǝ̀ sauwa, sǝama pà wun nǝ̀ ɓua njawe-lwa ɗang. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />Sǝ amuna-burana mala Haruna, yià apǝris ka, à nda à nǝ̀ nggǝ twang anjawe ka. Twang-njawe ka nǝ̀ dupa wun nggurcau mǝnana wun nǝ̀ nggǝ pê arǝ anza ma'wun kat ka. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" />Lang wun nǝ̀ o a lwa aɓa nzali ma'wun arǝ aɓiwun amǝbura mǝnana à kǝ yinǝ munǝo arǝ wun ngga, wu ɓua njawe-lwa, ace mǝnana Yahweh Ɓakuli ma'wun ɓǝ̀ ɗenyinǝ wun, sǝ ɓǝ̀ amsǝ wun a ɓabù aɓiwun amǝbura. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />A pwari bumpwasǝa ma'wun gbal, sǝ a kúnì mala alamsan, andǝ apakkiɗire mala bǝsa azongŋo ma'wun ngga, wun nǝ̀ twang anjawe amur apagir ma'wun mǝnana à nǝ̀ pisǝia kǝring ngga, sǝ amur agir'nkila mala apagir ma'wun ace dotarǝu. À nǝ̀ duk gìr kasǝɓalǝ Ɓakuli arǝ wun; Mǝ nda Yahweh Ɓakuli ma'wun.&gt;&gt;<verse eid="NUM 10:10" /></para>
  <para style="s">Amǝ Isǝrayila nying Nkono Saina</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />A lumi-ɓaria nongŋo mala ɓaria zongŋo mala ɓaria pǝlǝa ka, pǝrɓangnî loapì múr Taragula mala Acau-nakûn, <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />sǝ amǝ Isǝrayila lo gya, à nying pǝɗanban Saina, à kǝ turki bǝti-bǝti arǝ abân. Sǝ pǝrɓangnî yi came a pǝɗanban Paran. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Mǝnia ka nda tadǝmbe mǝnana Yahweh banggi Musa cau ama ɓǝ̀ tsǝk amǝ Isǝrayila ɓǝà lo gya ka.<verse eid="NUM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14" />Anggǝsan mala amǝ'lwa aɓata tútà mala kàttì mala Yahuda ka, à nda à tita lo gya ka, sǝ ɓwamǝgule amur anggǝsan mala amǝ'lwa malea ka, nda Nashon, muna-ɓwabura mala Aminadap.<verse eid="NUM 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 10:15" />Netanel, muna-ɓwabura mala Zuar ka, nda ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Isaka. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Sǝ ɓwa mǝnana nda ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Zebulu ka, nda Eliyap muna-ɓwabura mala Helon.<verse eid="NUM 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 10:17" />Sǝ lang à panzǝkina Taragula à sulǝni ka, amǝkà Gashon, andǝ amǝkà Merari, mǝnana à twal agir mala Taragula ka, à lo gya.<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />Aɓwana mǝnana à kpatea ka à nda ka anggǝsan mala amǝ'lwa mala kàttì mala Ruben, aɓata tútà malea, sǝ ɓwamǝgule amur anggǝsan malea ka, nda Elizur muna-ɓwabura mala Shedeur. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Sǝ Shelumiyel muna-ɓwabura mala Zurishaddai ka, nda ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Shimiyon. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Sǝ ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Gad ka, nda Eliyasaf muna-ɓwabura mala Duwel. <verse eid="NUM 10:20" /><verse number="21" style="v" sid="NUM 10:21" />Pǝlǝa amǝ'Kohat lo gya, nǝ agir mǝfele a buia; sǝ kaniama à nǝ̀ bwal ka, à (amǝkà Gashon andǝ amǝkà Merari) loasǝna Taragula. <verse eid="NUM 10:21" /><verse number="22" style="v" sid="NUM 10:22" />Sǝ anggǝsan mala amǝ'lwa a kàttì mala amǝkà Ifǝrem, aɓata tútà malea kpatea, sǝ ɓwamǝgule amur anggǝsan malea ka, nda Elishama muna-ɓwabura mala Ammihud. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Gamaliyel muna-ɓwabura mala Pedazur ka, nda ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Manasa, <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />sǝ Abidan muna-ɓwabura mala Gidiyoni nda ɓwamǝgule amur nggǝsan mala tàu mala amǝkà Benjami.<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />Sǝ tútà mala kàttì mala amǝkà Dan mǝnana do kǝla mǝ'yal-nzǝm akàttì kat ka, à lo gya arǝ anggǝsan mala amǝ'lwa malea, sǝ ɓwamǝgule amur nggǝsan mala amǝ'lwa malea ka, nda Ahieza muna-ɓwabura mala Amishaddai. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Sǝ ɓwamǝgule amur nggǝsan mala amǝ'lwa mala tàu mala amǝkà Asha ka, nda Pagiyel muna-ɓwabura mala Okran. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Sǝ Ahira muna-ɓwabura mala Enan ngga, nda ɓwamǝgule amur nggǝsan mala amǝ'lwa mala tàu mala amǝkà Naftali. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Mǝnia ka nda tsaɗi mala lo gya mala amǝ Isǝrayila arǝ anggǝsan mala amǝ'lwa malea lang à tùr kàttì ka.<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />Sǝ Musa ne Hobap muna-ɓwabura mala Rewel ɓwa Midiyan, nkil Musa ama, &lt;&lt;Sǝm nda aban lo o a ban mǝnana Yahweh bang ama, &lt;Mǝ nǝ pa wuni ka.&gt; Yiu atà sǝm, sǝ sǝm nǝ̀ pàkkô mǝɓoarne, acemǝnana Yahweh panacau mala agir mǝɓoarne ace Isǝrayila.&gt;&gt;<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />Sǝ yì ka bang ama, &lt;&lt;Pa mǝ nǝ ká ɗàng. Mǝ nǝ nyar a nzali mem, aban aɓwana mem.&gt;&gt;<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />Sǝ Musa ne wi ama, &lt;&lt;Ida, cè a nying sǝm ɗàng, acemǝnana we ka, a súrǝ́nà rǝ ban mǝnana ɓoaro sǝm nǝ̀ duk kàttì kam aɓa pǝɗanban ngga, sǝ awu nǝ do kǝla mǝsǝu aban sǝm. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Sǝ ɓǝ̀ a o atà sǝm ngga, gìr mǝɓoarne mǝnana Yahweh nǝ̀ pàkka sǝm ngga, nda sǝm nǝ̀ pàkkô ka.&gt;&gt;<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />Nda à loapi nkono mala Yahweh, à twal gya mala nongŋo tàrú. Akwati Kùrcau mala Yahweh akia wia dǝmba aban ká aɓalǝ anongŋo tàrú mǝno ace kúmbia wia ban usǝlǝo. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Sǝ pǝrɓang mala Yahweh ueo amúrià nǝ pwari, a koya pwari mǝnana à loapì kàttì ka.<verse eid="NUM 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 10:35" />Sǝ koya pwari mǝnana à tita gya nǝ Akwati ka, Musa nǝ̀ na ama:</para>
  <para style="q1" vid="NUM 10:35">&lt;&lt;Lo, Yahweh, sǝ ɓǝ̀ aɓio-amǝbura ɓǝà tǝlli,</para>
  <para style="q1" vid="NUM 10:35">sǝ aɓwana mǝnana à ɓinǝmǝsǝo ka,</para>
  <para style="q2" vid="NUM 10:35">ɓǝà ɓangŋa a ɓadǝmbo.&gt;&gt;<verse eid="NUM 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 10:36" />Sǝ lang à kya camǝna ka, nǝ̀ na ama:</para>
  <para style="q1" vid="NUM 10:36">&lt;&lt;Nyare, Yahweh, aban á-mǝlàkke mala amǝ Isǝrayila mǝnana à pà nǝ̀ gandǝ ɓallia raka.&gt;&gt;<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s">Amǝ Isǝrayila nggwani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Lang Yahweh ok nggwani mǝnana aɓwe kǝ pè ace tanni malea ka, bumlulla male pì kǝ̀rkǝ́r arǝia,<note caller="+" style="f"><char style="fr" closed="false">11:1 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 22:24">Pur 22:24</ref>; <ref loc="EXO 32:10-11">32:10-11</ref>; <ref loc="DEU 6:15">Nggur 6:15</ref></char>.</note> bǝsa mala Yahweh lo earke aɓalǝia, sǝ pisǝ aɓea ankanggariban mala kàttì. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Pǝlǝa ɓwabundǝa ɓua aban Musa, sǝ Musa ɓua aban Yahweh, sǝ bǝsa limge. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Nda sǝ à pè banì lullǝu ama, Tabera ka, acemǝnana bǝsa mala Yahweh earke aɓalǝia. <verse eid="NUM 11:3" /><verse number="4" style="v" sid="NUM 11:4" />Sǝ amǝ'kúnɗàngna<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 12:38">Pur 12:38</ref> </char>.</note> mǝnana aɓalǝ amǝ Isǝrayila ka, à lo pàk suno<note caller="+" style="f"><char style="fr" closed="false">11:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 78:29-31">Ang 78:29-31</ref>; <ref loc="PSA 106:14-15">106:14-15</ref>; <ref loc="1CO 10:5-6">1Kor 10:5-6</ref></char>.</note> mala aɓea agirlina. Sǝ amǝ Isǝrayila ɓua ɗǝm à kǝ na ama, &lt;&lt;Yana nǝ̀ pà sǝm nyama mǝnana sǝm nǝ̀ lì ka! <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />Ɓalǝ sǝm kasǝa arǝ nji mǝnana sǝm lì a Masar,<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 16:3">Pur 16:3</ref></char>.</note> sǝm nggǝ mbwe kǝgir ace raka, andǝ ambwario, ajiri, aɓui, ahatǝm, andǝ hangale. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Sǝ ado ka, rǝcandǝa malǝnì rǝ sǝm,<note caller="+" style="f"><char style="fr" closed="false">11:6 </char><char style="fq" closed="false">rǝcandǝa malǝnì rǝ sǝm, </char><char style="ft" closed="false">ko &lt;&lt;tàmyal sǝm imǝna&gt;&gt;</char></note> sǝ kǝgir pà kàm sǝm sǝn ɗàng shekǝ mǝnia yì manna ka.&gt;&gt; <verse eid="NUM 11:6" /><verse number="7" style="v" sid="NUM 11:7" />(Manna ka, nda kǝla mǝsǝ mbulara-ɓa-mbyau, sǝ pǎ male na kǝla myang nggun. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Aɓwe kǝ pur pwane sǝ à kǝ goe a taligo ko à kǝ soe a nkinggiring sǝ à nǝ̀ lambi a nkwaring, à nǝ̀ pàngŋǝ̀nà kyak nǝi. Lang à oe ka nda kǝla kyak mǝnana à pè nǝ mùrú ka. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Lang ncimna kpa a kàttì nǝ du ka, manna kǝ sulǝ andǝi.) <verse eid="NUM 11:9" /><verse number="10" style="v" sid="NUM 11:10" />Musa ok aɓwana aban ɓua a koya ban arǝ atau malea, koya ɓwa ka a kún gumli male. Bumlulla mala Yahweh earki nggǝr-nggǝr, sǝ Musa ka banɓiki wi. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Musa ne Yahweh ama, &lt;&lt;Ace mana sǝ a pakkì guro mò mǝɓane anggo? Sǝ man tsǝa sǝ a ginǝ lǝmdǝam murɓoarna, yimana a tsǝkam twalo mala aɓwana man kat amuram ngga? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Mǝ nda ǝn twal aɓwana man kat a bumam ngga le? Mǝ nda ǝn ɓǝlia ka le, sǝ awu nǝ nam ama, &lt;Twalia a kikilo, kǝla mǝnana mǝ'iulo kǝ twal bangna-muna ka,&gt; aban ká a nzali mǝnana a kán ama, awu nǝ pè atárrià ka? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Ake sǝ mǝ nǝ kum nyama mǝnana mǝ nǝ pè aɓwana mǝnia kat ka? Acemǝnana à kǝ ɓuakam ama, &lt;Pà sǝm nyama, ɓǝ̀ sǝm lì.&gt; <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Pà mǝ nǝ gandǝ twal aɓwana mǝnia kat ka nǝmurǝam ɗàng; twalê dǝmbǝriam kǝ̀rkǝ́r. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Ɓǝ̀ nda anggo sǝ awu nǝ pàngnǝ mim ngga, ida, wal-luem ado, ɓǝ̀ mǝ ndanǝ murɓoarna a bano ka, ace mǝnana mǝ nggá sǝn tàpùra mem ɗàng.&gt;&gt;<verse eid="NUM 11:15" /></para>
  <para style="s">À twal aɓwana-mǝgule ɓǝà pàkkî Musa gbasha</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />Pǝlǝa Yahweh ne Musa ama, &lt;&lt;Rambam aɓwana-mǝgule mala Isǝrayila lumi-tongno-nong-ɓari, mǝnana a súrǝ̀ia à nda ka aɓwana-mǝgule amur aɓwana, sǝ à nda ka amǝbuno amúrià ka, sǝ wu yinǝia a bankutio aɓa Tara Ban-peri, ɓǝà cam kano atò. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Sǝ mǝ nǝ sulǝo mǝ nǝ bangcau nǝ we kano. Sǝ mǝ nǝ twal aɓa Bangŋo mǝnana amuro ka, mǝ nǝ tsǝì amúrià; sǝ à nǝ̀ bwalo twal dǝmbǝrya mala aɓwana, ace mǝnana ɓǝkǝa do amuro nǝmurǝo ɗàng.<verse eid="NUM 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18" />&lt;&lt;Ne aɓwe ama, &lt;Wu tàr ɓamur rǝ wun, ace lí, wun nǝ̀ shak nyama, acemǝnana ɓua ma'wun warina a kir Yahweh, ama, &lt;&lt;Yana nǝ̀ pà sǝm nyama mǝnana sǝm nǝ̀ shak ka? Acemǝnana do ma'sǝm a Masar ka ɓoaribanì.&gt;&gt; Acemani ka, Yahweh nǝ̀ pa wun nyama, sǝ wun nǝ̀ shè. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Pà aɓa nongŋo mwashat, ko anongŋo ɓari, ko anongŋo tongno, ko anongŋo lum, ko anongŋo lumi-ɓari na wun nǝ̀ shè ka ɗàng, <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />wun nǝ̀ shè aɓa zongŋo kat, sheɓǝ̀ ce'shirina wun, pǝlǝna wun gìr'ɓeakǝno ka, acemǝnana wu ginǝkina Yahweh mǝnana nda aɓalǝ wun ngga, sǝ wu ɓuanî wi ama, &lt;&lt;Mana tsǝa sǝ sǝm nying Masar?&gt;&gt; &gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11:20 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 17:3">Pur 17:3</ref></char>.</note><verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />Sǝ Musa na ama, &lt;&lt;Aɓwana mǝnana mǝ nda aɓalǝia ka, amǝ'lwa á-gbǝman-tongno-nong-mwashat (600,000) na, nǝ kusǝia, sǝ a bang ama, &lt;Mǝ nǝ pea wia nyama, mǝnana à nǝ̀ shè aɓa zongŋo kat ka!&gt; <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Adomwan mala ambul andǝ mala andá na à nǝ̀ wallia wia sǝ nǝ̀ karǝia ka le, ko ana raka à nǝ̀ rambia wia nji mǝnana a nggeamùr kat ka, sǝ nǝ̀ karǝia le?&gt;&gt; <verse eid="NUM 11:22" /><verse number="23" style="v" sid="NUM 11:23" />Sǝ Yahweh ne Musa ama, &lt;&lt;Bù Yahweh gatti le? Ado ka awu nǝ sǝni ko cau mem nǝ̀ purmǝsǝi a bano ko pà nǝ̀ purmǝsǝi ɗàng.&gt;&gt;<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Pǝlǝa Musa puro kya ne aɓwe acau mǝnana Yahweh bang ngga. Sǝ yi ramba aburana lumi-tongno-nong-ɓari mala aɓwana-mǝgule mala aɓwe, sǝ yi tsǝia à came à kàrì Tara. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />Pǝlǝa Yahweh sulǝ aɓa pǝrɓang yi bangcau nǝi, sǝ twal aɓa Bangŋo mǝnana nda amur Musa ka, sǝ tsǝì amur aɓwana-mǝgule mǝno lumi-tongno-nong-ɓari ka. Sǝ lang Bangŋo sulǝ amúrià ka, à ɓangnǝ-ɓangnǝa. Sǝama à lidǝmba aban pé ɗàng.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />Aɓa mǝno anggo ka, aɓwana nakam ɓari à ueo aɓa kàttì, mwashat ka, à tunǝi ama, Eldat, sǝ ɓè ka, à tunǝ ama, Medat; Bangŋo sulǝo amúrià. À nda aɓalǝ aɓwana mǝnana à gilǝ alullǝia ka, sǝama à puro à wari a Tara ɗang; à ɓangnǝa aɓa kàttì. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Sǝ ɓè lagga ɓangŋa kya ne Musa ama, &lt;&lt;Eldat andǝ Medat ka, à nda aban ɓangnǝ-ɓangnǝa aɓa kàttì.&gt;&gt; <verse eid="NUM 11:27" /><verse number="28" style="v" sid="NUM 11:28" />Sǝ Jesǝwa muna-ɓwabura mala Nun, mǝnana twal a lo-ɓwa male ka, nda kǝ pakkî Musa gbasha ka, na ama, &lt;&lt;Mǝtalem Musa, tamsǝia.&gt;&gt; <verse eid="NUM 11:28" /><verse number="29" style="v" sid="NUM 11:29" />Sǝ Musa banggi wi ama, &lt;&lt;A ndarǝ pak mɓali acem le? Eare mem ngga, ɓǝ́ aɓwana mala Yahweh kat ka à dumǝna amǝ'ɓangnǝa, ɓǝ́ Yahweh nǝ̀ tsǝk Bangŋo male amúrià!&gt;&gt; <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Pǝlǝa Musa andǝ aɓwana-mǝgule mala amǝ Isǝrayila nyare a kàttì.<verse eid="NUM 11:30" /></para>
  <para style="s">Yahweh tasǝ ankwar</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Pǝlǝa gung mǝnana pur nǝban Yahweh ka, lo ɓua; loasǝ ankwar a ban nggeamùr, sǝ yinǝia, à yi sukkio a nzali a gírí kàttì; à gumbǝli a koya buì, o ɗār kǝla gya mala pwari mwashat. Gwali malea amur rǝarǝia a nzali ka dāh'rya bik kǝla ɓakusǝu tàrú. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Sǝ aɓa pwari andǝ du mǝno kat aban ká ɓaria pwari kat ka, aɓwana lo sǝ à camarǝ pwan nkwar. Aɓwana mǝnana à pwan bǝti ka, à nda mana à pwan zace lum ngga; à anzǝia à gumbǝlina kàttì nǝi.<verse eid="NUM 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 11:33" />Nyama na a kunia à nǝ̀ nggǝ shè, à malaká mal raka, bumlulla mala Yahweh lo earke arǝia, sǝ Yahweh kwak aɓwana a nzali, nǝ nggea gìr'mur'mwana mǝgule. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Nda sǝ à tunǝ banì ama, Kibǝrot-hatava, acemǝnana a banì sǝ à tsǝk amǝ'suno a ɓembe.<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />À loapi Kibǝrot-hatava aban ká Hazerot, sǝ à kya ueo a Hazerot.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s">Miriyam andǝ Haruna nacau amur Musa</para>
  <para style="m">
    <verse number="1" style="v" sid="NUM 12:1" />Miriyam andǝ Haruna nacau amur Musa ace ɓwama Kush mǝnana Musa al ka, acemǝnana Musa ka, al ɓwama Kush. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />Sǝ à na ama, &lt;&lt;Nggeari ka Musa na nǝmurǝi Yahweh kǝ nacau nǝi ka le? Kǝ nacau nǝ sǝm gbal re?&gt;&gt; Cau mǝnana à ne ka Yahweh oè. <verse eid="NUM 12:2" /><verse number="3" style="v" sid="NUM 12:3" />(Musa ka nda ɓukɓuk, kútì aɓwana mǝnana a ɓanza kat ka nǝ ɓukɓuka.)<verse eid="NUM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4" />Àkǝ banì Yahweh ne Musa andǝ Haruna andǝ Miriyam ama, &lt;&lt;Wu puro wun tàrú, wu kya bankutio aɓa Tara Ban-peri.&gt;&gt; Sǝ yia tàrú ka à puro. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Pǝlǝa Yahweh sulǝo aɓa pǝrɓang mana pǝrapǝra ka, yi came a bankutio aɓa Tara sǝ tunǝ Haruna andǝ Miriyam yia kǝm, sǝ à puro. <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />Sǝ bang ama, &lt;&lt;Wu ok cau mem:</para>
  <para style="q1" vid="NUM 12:6">&lt;&lt;Ɓǝ̀ ɓekǝ mǝɓangnǝa nakam aɓalǝ wun ngga,</para>
  <para style="q1" vid="NUM 12:6">Mim Yahweh ka, ǝn nggǝ lǝmdǝ ɓamúràm a baní aɓa sǝna;</para>
  <para style="q1" vid="NUM 12:6">ǝn nggǝ ne wi cau aɓa lòrǝo.<verse eid="NUM 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 12:7" />Pa anggo nǝ guro mem Musa ɗàng.</para>
  <para style="q1" vid="NUM 12:7">Yì ka ndanǝ domǝsǝcau aɓa ɓala mem kat.<verse eid="NUM 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 12:8" />Ən nggǝ nacau nǝi bwāng,</para>
  <para style="q1" vid="NUM 12:8">kún andǝ kún, pà aɓa cauɓaɓe ɗàng,</para>
  <para style="q1" vid="NUM 12:8">sǝ yì ka kǝ sǝn pǎ mem Mim Yahweh.</para>
  <para style="m" vid="NUM 12:8">Mana tsǝa sǝ wu ginǝ ɓanggi nacau amur guro mem Musa?&gt;&gt;<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />Nda bumlulla mala Yahweh earke arǝia sǝ nying bania. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />Sǝ lang pǝrɓang longŋǝni múr Tara ka, kara Miriyam bwal nǝ kwánó nggû, pwasǝo kǝla talimbulo. Sǝ Haruna pǝlǝa aban Miriyam, sǝ sǝni ka, kwánó nggû bwalǝni. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />Sǝ Haruna ne Musa ama, &lt;&lt;Ida, mǝtalem, cè a pa sǝm tanni ɗàng, acemǝnana sǝm pàngŋǝ̀nà gìr ɓwaɓana, sǝ sǝm pàngŋǝ̀nà cauɓikea. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Ən nggǝ zǝmbo, cè a eare ɓǝ̀ pǎ kǝla lú bangna-muna, mǝnana lang purî bum ngge ka, ngguí kpattíkínà ka ɗàng.&gt;&gt;<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />Sǝ Musa ɓua aban Yahweh ama, &lt;&lt;We Ɓakuli, ida sonzǝi, ǝn nggǝ zǝmbô.&gt;&gt;<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />Sǝama Yahweh ne Musa ama, &lt;&lt;Ɓǝ̀ tárrí tappi wi ntara a ɓamǝsǝi ka, pà nǝ̀ do aɓa kirsakya anongŋo tongno-nong-ɓari re? Ɓǝà pusǝì anzǝm kàttì<note caller="+" style="f"><char style="fr" closed="false">12:14 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 13:46">Pǝris 13:46</ref>; <ref loc="NUM 5:1-4">Ɓal 5:1-4</ref>; <ref loc="2KI 15:5">2Amur 15:5</ref></char>.</note> ɓǝ̀ ue kano ba anongŋo tongno-nong-ɓari, sǝ anzǝm mǝno ka, wu nyesǝi aɓa kàttì ɗǝm.&gt;&gt; <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />Anggo sǝ à pusǝ Miriyam anzǝm kàttì sǝ ue kano ba anongŋo tongno-nong-ɓari, sǝ aɓwe ka, à lo gya ɗang she lang à nyesǝna Miriyam aɓa kàttì ɗǝm ngga. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />Anzǝm mǝno ka, aɓwe lo à nying Hazerot, sǝ à yi duk kàttì a pǝɗanban Paran.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s">À tasǝ amǝ'shenzǝban a Kan'ana</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />Yahweh bangcau nǝ Musa ama, <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />&lt;&lt;Tasǝ aburana ɓǝà kya shenzǝ nzali Kan'ana, mǝnana ǝn nggǝ pè amǝ Isǝrayila ka. Aɓa koya tàu mala akeâ ka, à nǝ̀ tasǝ ɓwa mwashat mǝnana múrû na aɓalǝia ka.&gt;&gt; <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" />Pǝlǝa Musa tasǝia, à lo a pǝɗanban Paran, kǝla mǝnana Yahweh bang ngga, yia kat ka, amúrû mala amǝ Isǝrayila na. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />Alullǝia nia ka: A tàu mala Ruben ngga, nda Shamuwa muna-ɓwabura mala Zakkur; <verse eid="NUM 13:4" /><verse number="5" style="v" sid="NUM 13:5" />a tàu mala Shimiyon ngga, nda Shafat muna-ɓwabura mala Hori; <verse eid="NUM 13:5" /><verse number="6" style="v" sid="NUM 13:6" />a tàu mala Yahuda ka, nda Kalip muna-ɓwabura mala Jefune; <verse eid="NUM 13:6" /><verse number="7" style="v" sid="NUM 13:7" />a tàu mala Isaka ka, nda Igal muna-ɓwabura mala Yisǝfu; <verse eid="NUM 13:7" /><verse number="8" style="v" sid="NUM 13:8" />a tàu mala Ifǝrem ngga, nda Hoshiya<note caller="+" style="f"><char style="fr" closed="false">13:8 </char><char style="fq" closed="false">Hoshiya </char><char style="ft" closed="false">mǝnia ka nda Musa nggaɗi wi lullǝu ama Jesǝwa ka.</char></note> muna-ɓwabura mala Nun; <verse eid="NUM 13:8" /><verse number="9" style="v" sid="NUM 13:9" />a tàu mala Benjami ka, nda Palti muna-ɓwabura mala Rafu; <verse eid="NUM 13:9" /><verse number="10" style="v" sid="NUM 13:10" />a tàu mala Zebulu ka, nda Gadiyel muna-ɓwabura mala Sodi; <verse eid="NUM 13:10" /><verse number="11" style="v" sid="NUM 13:11" />a tàu mala Manasa (mǝnana a tàu mala Yisǝfu ka), nda Gaddi muna-ɓwabura mala Susi; <verse eid="NUM 13:11" /><verse number="12" style="v" sid="NUM 13:12" />a tàu mala Dan ngga, nda Amiyel muna-ɓwabura mala Gemalli; <verse eid="NUM 13:12" /><verse number="13" style="v" sid="NUM 13:13" />a tàu mala Asha ka, nda Setur muna-ɓwabura mala Makel; <verse eid="NUM 13:13" /><verse number="14" style="v" sid="NUM 13:14" />a tàu mala Naftali ka, nda Nabi muna-ɓwabura mala Vopsi; <verse eid="NUM 13:14" /><verse number="15" style="v" sid="NUM 13:15" />a tàu mala Gad ka, nda Gewel muna-ɓwabura mala Maci. <verse eid="NUM 13:15" /><verse number="16" style="v" sid="NUM 13:16" />Amǝnia ka à nda ka alullǝ aburana mǝnana Musa tasǝia ɓǝà shenzǝ nzalî ka. Sǝ Musa pè Hoshiya muna-ɓwabura mala Nun lullǝu ama Jesǝwa. <verse eid="NUM 13:16" /><verse number="17" style="v" sid="NUM 13:17" />Musa tasǝia ɓǝà shenzǝ nzali Kan'ana sǝ nea wia ama, &lt;&lt;Wu eauwe, wu kàr nǝ Negev, sǝ wu kya eauwe a nzali múr ankono, <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />sǝ wu sǝn ko lang sǝ nzalî pa, sǝ ko aɓwana mǝnana à do aɓalǝi ka à ndanǝ rǝcandǝa ko amǝ'rǝwukea na, ko à nda kpokyak ko à bundǝo, <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />sǝ ko nzali mana à do aɓalǝi ka mǝɓoarne na ko mǝɓane na, sǝ ko anggea-là mǝnana à do aɓalǝia ka, akàttì na ko akanggǝrang ala na, <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />sǝ ko nzali gǝna na ko nzali tǝle na, sǝ ko anggun na aɓalǝi ko à pà kàm ɗàng. Wu dumnǝ mǝsǝkang-kangŋa wu yinǝ aɓea aɓǝla-nggun mala nzalî.&gt;&gt; Ado ka nda kún tita bangŋa mala aɓǝla-anap. <verse eid="NUM 13:20" /><verse number="21" style="v" sid="NUM 13:21" />Pǝlǝa à eauwe à wario à kya shenzǝ nzalî nǝ bu pǝɗanban Zin aban ká Rehop, tù nǝ Lebo Hamat. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />À eauwe à o a Negev sǝ à yiu a Hebǝron. Aɓwana mala atau mala Ahiman, Sheshai, andǝ Talmai, amǝkà Anak ka, à nda kano. (Hebǝron ngga à ɓè, apǝlǝa tongno-nong-ɓari sǝ à yi ɓak Zowan a Masar.) <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Sǝ lang à yiu a Ɓangŋaban Eshkol ka, à kasǝ bu-nggun nǝ dangŋanshi ɓǝla-anap, sǝ aɓwana ɓari twali arǝ gara; ɗǝm ngga à yinǝ aɓǝla mɓǝring andǝ vwari. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Mǝno yì ban ngga à tunǝi ama Ɓangŋaban Eshkol, ace dangŋanshi ɓǝla-anap mǝnana amǝ Isǝrayila kasǝ kano ka.<verse eid="NUM 13:24" /></para>
  <para style="s">Bǝlkun mala amǝ'shenzǝban</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25" />A masǝlǝata anongŋo lumi-ine ka, à nyarî shenzǝ nzalî. <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />Sǝ à yiu aban Musa andǝ Haruna andǝ ɓwabundǝa mala amǝ Isǝrayila a pǝɗanban Paran a Kadesh. À yinǝ cau sǝ à yi bǝlì Musa andǝ Haruna kunia andǝ ɓwabundǝa kat, sǝ à lǝmdǝia wia aɓǝla-nggun mala nzalî. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Sǝ à ne Musa ama, &lt;&lt;Sǝm warina a nzali mana a túr sǝm kam ngga. Mur-nyi andǝ kiura kǝ ɓang kam, sǝ mǝnia ka nda ɓǝlanggun male. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Sǝama aɓwana mǝnana à do a nzalî ka, amǝ'candǝe na, sǝ anggea-là ka, à gulkio sǝ à kària nǝ asheran. Sǝ ɗǝm ngga, sǝm sǝn amǝkà Anak kàm. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Amǝ'Amalek ka, à ndanǝdo a Negev. Amǝ'Hiti andǝ amǝ'Jebus, andǝ amǝ'Amor ka, à do a nzali múr ankono. Sǝ amǝ'Kan'ana ka, à do a kún nggeamùr, sǝ a nkanggari Jodan.&gt;&gt;<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />Pǝlǝa Kalip pwasǝlǝ aɓwana a ɓadǝm Musa, sǝ bang ama, &lt;&lt;Ɓǝ̀ sǝm lo ado ɓǝ̀ sǝm kya ak nzalî, acemǝnana sǝm ndanǝ rǝcandǝa pepè mala limurǝm amurí!&gt;&gt; <verse eid="NUM 13:30" /><verse number="31" style="v" sid="NUM 13:31" />Sǝ aɓwana mǝnana à wari andǝia ka, à na ama, &lt;&lt;Pà sǝm nǝ̀ gandǝ ká a munǝo arǝ amǝno yì aɓwana ka ɗàng, acemǝnana à kútì sǝm nǝ rǝcandǝa!&gt;&gt; <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Anggo sǝ à yinǝì amǝ Isǝrayila cau mǝɓane amur nzali mana à kya shenzǝi ka, ama, &lt;&lt;Nzali mana sǝm wari aɓalǝi a shenzǝe ka, nzali na mǝnana kǝ shak aɓwana mǝnana à do aɓalǝi ka, sǝ aɓwana mana kat sǝm sǝnia aɓalǝi ka, à dāh'riki mwat-mwat. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Akano ka, sǝm sǝn akwatǝman-aɓwana,<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 6:4">Tite 6:4</ref></char>.</note> amǝ'kà Anak, mǝnana pur a tàu mala akwatǝman-aɓwana ka.<note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 2:10-11">Nggur 2:10-11</ref>,<ref loc="DEU 2:20-21">20-21</ref></char>.</note> Sǝm sǝn ɓamúr rǝ sǝm abania kǝla adoshi, sǝ anggo gbal sǝ à sǝn sǝm.&gt;&gt;<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s">Aɓwe mgbicau</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Pǝlǝa ɓwabundǝa loasǝ gia à soɓua, à ɓua aɓa dù mǝno. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Sǝ amǝ Isǝrayila kat nggwanî Musa andǝ Haruna.<note caller="+" style="f"><char style="fr" closed="false">14:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 16:2">Pur 16:2</ref>,<ref loc="EXO 16:7-8">7-8</ref>; <ref loc="EXO 17:3">17:3</ref>; <ref loc="NUM 14:27">Ɓal 14:27</ref>; <ref loc="NUM 16:11">16:11</ref>,<ref loc="NUM 16:41">41</ref>; <ref loc="PSA 59:15">Ang 59:15</ref></char>.</note> Ɓwabundǝa puppup banggia wia ama, &lt;&lt;Eare ma'sǝm ngga, ɓǝ́ sǝm wukina a nzali Masar, ko aɓa mǝnia yì pǝɗanban ngga! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Mana tsǝa sǝ Yahweh kǝ yinǝ sǝm a nzali man ɓǝà wal-lu sǝm nǝ nggeabyau? Amālá sǝm, andǝ amuna ma'sǝm ngga à nǝ̀ pwania kǝla agirkuma. Pà nǝ̀ ɓoaribanì yi mana ɓǝ̀ sǝm nyare a Masar ka re?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 11:5">Ɓal 11:5</ref>; <ref loc="DEU 17:16">Nggur 17:16</ref>; <ref loc="NEH 9:17">Nehe 9:17</ref>; <ref loc="ACT 7:39">Atúró 7:39</ref></char>.</note> <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />Pǝlǝa à ne a rǝia ama, &lt;&lt;Ɓǝ̀ sǝm twal ɓwa ɓǝ̀ dupa sǝm a dǝmba ɓǝ̀ sǝm nyare a Masar.&gt;&gt; <verse eid="NUM 14:4" /><verse number="5" style="v" sid="NUM 14:5" />Pǝlǝa Musa andǝ Haruna kpa nǝ ɓamǝsǝia a nzali a ɓadǝm ɓwabundǝa mala ɓinala amǝ Isǝrayila. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Sǝ Jesǝwa muna-ɓwabura mala Nun, andǝ Kalip muna-ɓwabura mala Jefune, yià mana à nda aɓalǝ amǝ'shenzǝ nzali ka, à sàngi adaura malea, <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />sǝ à banggi ɓwabundǝa mala amǝ Isǝrayila kat ama, &lt;&lt;Nzali mǝnana sǝm kùtí nǝ ɓālǝi ace shenzǝe ka, nggea nzali mǝɓoarne na kǝ̀rkǝ́r. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />Ɓǝ̀ bum Yahweh pwasǝ arǝ sǝm ngga, nǝ̀ yinǝ sǝm a nzali man, sǝ nǝ̀ pasǝmì, yì nzali mǝnana mùr-nyì andǝ kiura à kǝ ɓang kam ngga.<note caller="+" style="f"><char style="fr" closed="false">14:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:8">Pur 3:8</ref>; <ref loc="LEV 20:24">Pǝris 20:24</ref>; <ref loc="NUM 13:17">Ɓal 13:17</ref>; <ref loc="NUM 16:13-14">16:13-14</ref></char>.</note> <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Wu kǝa na ama wun nǝ̀ mgbikî Yahweh cau ɗàng, sǝ ɓangciu ɓǝkǝa pàkka wun arǝ aɓwana mǝnana à do a nzalî ka ɗàng. Agirlina na aban sǝm. Yalban pâ a buia ɗàng, sǝ Yahweh na atà sǝm; ɓangciu ɓǝkǝa pàkka wun arǝia ɗàng.&gt;&gt;<verse eid="NUM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 14:10" />Pǝlǝa ɓwabundǝa lo ama à nǝ̀ ɓukkia nǝ atali. Sǝama ɓoarɓwa mala Yahweh lǝmdǝrǝì aɓa Tara Ban-peri, aban amǝ Isǝrayila kat.<verse eid="NUM 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 14:11" />Sǝ Yahweh banggi Musa ama, &lt;&lt;Nǝ̀ sau lang sǝ aɓwana mǝnia nǝ̀ nyesǝcem-ɓà? Sǝ nǝ̀ sau lang sǝ à nǝ̀ ginǝ earnǝ mim, kat andǝ agir'lǝmndǝa mana kat ǝn pea aɓalǝia ka?<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 4:1-12:31">Pur 4:1--12:31</ref>; <ref loc="EXO 14:11">14:11</ref>,<ref loc="EXO 14:21-22">21-22</ref>; <ref loc="NUM 14:22">Ɓal 14:22</ref></char>.</note> <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Mǝ nǝ koea nǝ kwánó-ɓikea, mǝ nǝ vwakibuam arǝia, sǝ mǝ nǝ pusǝ nzali mǝnana mǝgule na sǝ candǝe kútiǎ ka, nǝ we.&gt;&gt;<verse eid="NUM 14:12" /></para>
  <para style="s">Musa pwanzali ace aɓwe</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Sǝama Musa ne Yahweh ama, &lt;&lt;Pǝlǝa amǝ Masar ka à nǝ̀ okce; acemǝnana a pusǝ aɓwana man aɓalǝia nǝ rǝcandǝa mò, <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />sǝ à nǝ̀ bangce aban aɓwana mǝnana a nzali man ngga. Yia ka à ongŋǝna ama we Yahweh ka, a nda aɓalǝ amǝnia yì aɓwana ka. We Yahweh ka aɓwana man sǝnǝno ɓamǝsǝu andǝ ɓamǝsǝu, sǝ pǝrɓang mò kǝ cam amúrià, sǝ a kǝ gya a ɓadǝmbia nǝ pwari aɓa pǝrɓang mǝnana cam pǝrapǝra ka, sǝ nǝ du ka aɓa ɓǝsa mǝnana cam pǝrapǝra ka.<note caller="+" style="f"><char style="fr" closed="false">14:14 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 13:21-22">Pur 13:21-22</ref>; <ref loc="NUM 9:16-17">Ɓal 9:16-17</ref>; <ref loc="DEU 1:33">Nggur 1:33</ref></char>.</note> <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Ado ka ɓǝ̀ a wal-lú ka aɓwana mǝnia, a twaltea ka, anzali mala aɓwapǝndǝa mǝnana à okce zǝ́kí mala lullǝo ka, à nǝ̀ na ama, <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />&lt;Nda acemǝnana Yahweh gandǝ yinǝ aɓwana mǝnia ka a nzali mana kángìr ama nǝ̀ pea wia ka<note caller="+" style="f"><char style="fr" closed="false">14:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 12:7">Tite 12:7</ref>; <ref loc="GEN 13:14-17">13:14-17</ref>; <ref loc="GEN 15:7">15:7</ref>; <ref loc="ACT 7:5">Atúró 7:5</ref></char>.</note> raka, nda tsǝa sǝ wal-luia aɓa pǝɗanban ngga.&gt; <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />Sǝ ado ka, ida, ɗeki rǝcandǝa mala Mǝtala sǝm ɓǝ̀ dumnǝ gulo kǝla mana a pacau, ama, <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />&lt;Yahweh kǝ kaurǝa pak bumlulla ɗàng, sǝ pěmǝɓoarne aɓa earcearǝu male mana kǝ dǝurǝ raka nda nyangsang, kǝ twalban cauɓikea andǝ mgbikiru; sǝama pà nǝ̀ nying ɓwa mǝnana kumcau ka ɓǝ̀ ukɓà ɗàng; kǝ yinǝ ɓashi ace acauɓikea mala atárrú amur amunia andǝ amǝ'keà, aban ká tàruià andǝ inea nza.&gt;<note caller="+" style="f"><char style="fr" closed="false">14:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:5">Pur 20:5</ref>; <ref loc="EXO 34:6-7">34:6-7</ref>; <ref loc="DEU 5:9">Nggur 5:9</ref>; <ref loc="JER 32:18">Ir 32:18</ref></char>.</note> <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Ida, twalban cauɓikea mala amǝnia yì aɓwana ka, atàcau mala gulo mala pěmǝɓoarne aɓa earcearǝu mô mana kǝ dǝurǝ raka, kǝla mana a twali amǝnia yì aɓwana banì aɓa Masar ba ado ka.&gt;&gt;<verse eid="NUM 14:19" /></para>
  <para style="s">Ɓakuli pacau mala ɓashi</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />Pǝlǝa Yahweh bang ama, &lt;&lt;Ən twalǝnabanì, kǝla mǝnana a bang ngga. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />Sǝama aɓa mǝsǝcau, mbak-kàngkàng mǝ ndanǝ yilǝmu sǝ ɓanza lumsǝ nǝ gulo mem ngga,<note caller="+" style="f"><char style="fr" closed="false">14:21 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 72:19">Ang 72:19</ref>; <ref loc="HAB 2:14">Hab 2:14</ref></char>.</note> <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />kǝɓwa pà kàm atà aɓwana mǝnia mǝnana à sǝn gulo mem andǝ agir-lǝmdǝa, mana ǝn pea a Masar andǝ ɓá pǝɗanban, sǝ kat andǝ amani ka, à karǝkiam kusǝ lum man, sǝ à kwakikiria arǝ giem raka, <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />mǝnana à nǝ̀ sǝn nzali mana ǝn kánbì atárrià ace ka ɗàng. Sǝ kǝɓwa pà kàm atà aɓwana mǝno à nyesǝcem-ɓà ka,<note caller="+" style="f"><char style="fr" closed="false">14:23 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 14:11">Ɓal 14:11</ref>; <ref loc="DEU 31:20">Nggur 31:20</ref></char> .</note> nǝ̀ sǝni ɗàng. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />Sǝama guro mem Kaleb, acemǝnana bangŋo male na ɗàng, sǝ kpatam kat-kat ka, mǝ nǝ yinǝi a nzali mǝnana wari kam ngga, sǝ nǝ̀ duk girkuma mala amuni andǝ amǝkè.<note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 14:6-15">Jes 14:6-15</ref>; <ref loc="JDG 1:10-12">Akas 1:10-12</ref>,<ref loc="JDG 1:20">20</ref></char>.</note> <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Ado ka, acemǝnana amǝ Amalek andǝ amǝ'Kan'ana na kam nǝ do arǝ aɓangŋaban ngga, lí ka wu pǝlǝa wu dǝshi pǝɗanban nǝ njar Nggeamùr Nzuno.&gt;&gt;<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />Sǝ Yahweh bangcau nǝ Musa andǝ Haruna ama, <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />&lt;&lt;Nǝ̀ sau lang sǝ mǝ nǝ twalgàndǝá nǝ mǝnia yì ɓwabundǝa mǝɓealɓike mǝnana à camarǝ nggwaniam ngga? Ən ongŋǝna nggwani mana amǝ Isǝrayila kǝ nggwaniam ngga.<note caller="+" style="f"><char style="fr" closed="false">14:27 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 16:2">Pur 16:2</ref>,<ref loc="EXO 16:7-8">7-8</ref>; <ref loc="EXO 17:3">17:3</ref>; <ref loc="NUM 14:29">Ɓal 14:29</ref>,<ref loc="NUM 14:36">36</ref>; <ref loc="NUM 16:11">16:11</ref>,<ref loc="NUM 16:41">41</ref>; <ref loc="DEU 1:27">Nggur 1:27</ref></char>.</note> <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Banggia wia ama, &lt;Ən kán nǝ yilǝmem, mim Yahweh ama, gìr mǝnana wu ne sǝ ǝn oê ka, nda mǝ nǝ pàkka wun ngga: <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />alú wun nǝ̀ bwamdǝ a mǝnia yì pǝɗanban ngga; sǝ atà aburana mǝnana kat à ɓallia a ɓalban, twal aban ɓwa mǝnana apǝlǝa malea na lumi-ɓari andǝ mana kútì ka, mǝnana à nggwaniam ngga, <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />kǝ mwashat atea pà kàm mǝnana nǝ̀ kùtí aɓa nzali mana ǝn kángìr<note caller="+" style="f"><char style="fr" closed="false">14:30 </char><char style="fq" closed="false">kángìr </char><char style="ft" closed="false">ko &lt;&lt;ǝn loasǝ buam a kuli&gt;&gt;</char></note> ama mǝ nǝ dumsǝ wun kàm ngga ɗàng, she Kaleb muna-ɓwabura mala Jefune andǝ Jesǝwa muna-ɓwabura mala Nun. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Sǝama amuna mǝkeke ma'wun, mǝnana wu na ama à nǝ̀ bwalkia ko à nǝ̀ wal-luia ka, mǝ nǝ yinǝia aɓalǝi, sǝ à nǝ̀ súrǝ̀<note caller="+" style="f"><char style="fr" closed="false">14:31 </char><char style="fq" closed="false">súrǝ̀ </char><char style="ft" closed="false">ko &lt;&lt;ok banɓoarnado mala&gt;&gt;</char></note> nzali mǝnana wu ginǝce ka. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Sǝ wun ngga, alú wun nǝ̀ bwamdǝ aɓa pǝɗanban mǝnia ka. <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />Amuna ma'wun nǝ̀ duk ayalgir a pǝɗanban apǝlǝa lumi-ine, sǝ à nǝ̀ tanni àtàcau mala ɗwanyi-domǝsǝcau ma'wun, sheɓǝ̀ masǝlǝata alú wun bwamdǝna a pǝɗanban ngga. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Kǝla làkkì mala anongŋo mǝnana wu pa aban shenzǝ nzali, anongŋo lumi-ine ka, anggo sǝ wun nǝ̀ nutanni mala acauɓikea ma'wun apǝlǝa lumi-ine, koya pǝlǝa mwashat ka a kúnì nongŋo mwashat,<note caller="+" style="f"><char style="fr" closed="false">14:34 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 13:25">Ɓal 13:25</ref>; <ref loc="NUM 32:13">32:13</ref>; <ref loc="DEU 2:14">Nggur 2:14</ref>; <ref loc="PSA 95:10">Ang 95:10</ref>; <ref loc="EZK 4:6">Ezǝk 4:6</ref></char>.</note> sǝ wun nǝ̀ súrǝ̀ bumkiɗikea mem.&gt; <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Mim Yahweh ka, ǝn bangŋǝni. Mǝnia yì gìr ka, ǝn kána mǝ nǝ pàkkî mǝnia yì ɓwabundǝa puppup mǝɓealɓike, mǝnana à kpapikunia arǝàm ngga:<note caller="+" style="f"><char style="fr" closed="false">14:35 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 16:11">Ɓal 16:11</ref>; <ref loc="NUM 27:3">27:3</ref></char>.</note> àkǝ ɓá pǝɗanban man sǝ masǝlǝatea nǝ yiu kat-kat, sǝ a banì sǝ à nǝ̀ wukio.&gt;&gt;<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />Aburana mana Musa túriá ɓǝà shenzǝ nzali, mǝnana à nyare à yi tsǝk ɓwabundǝa à nggwanî wi nǝ yinǝ cau mǝɓane amur nzalî, <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />yì aburana mǝno à yi mesǝ cau mǝɓane amur nzalî ka, gìr'mur'mwana wal-luia a ɓadǝm Yahweh. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />Aɓalǝ aburana mǝno à wari a shenzǝ nzali ka, kǝ Jesǝwa muna-ɓwabura mala Nun andǝ Kaleb muna-ɓwabura mala Jefune na à ue nǝyilǝmu ka.<verse eid="NUM 14:38" /></para>
  <para style="s">À lì amǝ Isǝrayila a lwa</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />Lang Musa banggi amǝ Isǝrayila kat amǝnia yì acau ka, aɓwe pak bumkiɗikea kǝ̀rkǝ́r. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Sǝ à lo nǝ dǝmbari ɗiɗyal, à eauwe amur ankono mala nzalî, sǝ à na ama, &lt;&lt;Sǝm ndya ka, mǝsǝcau sǝm pàngŋǝ̀nà cauɓikea, sǝama sǝm nǝ̀ eauwe ace ká a ban mǝnana Yahweh pacau ace ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">14:40 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 1:41-44">Nggur 1:41-44</ref> </char>.</note><verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />Sǝ Musa ka bang ama, &lt;&lt;Palang ado sǝ wu kǝ yàl nzongcau mala Yahweh, yima pě mǝno anggo ka pà nǝ̀ yinǝ limurǝm raka? <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Wu kǝa ká ɗàng, acemǝnana Yahweh pà aɓalǝ wun ɗàng; ɓǝ̀ ana raka aɓiwun amǝbura nǝ̀ lì wun. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />Amǝ'Amalek andǝ amǝ'Kan'ana ka à nda kana, à nǝ̀ dǝshi wun, sǝ à nǝ̀ gandǝ wun nǝ nggeabyau. Acemǝnana wu pǝlǝna nzǝm wun arǝ kpata Yahweh ka, Yahweh pà nǝ̀ pa atà wun ɗàng.&gt;&gt;<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />Sǝ yià ka à twalkicau ama à nǝ̀ eauwe amur ankono mala nzalî, kat andǝ amani ama Musa andǝ Akwati Kùrcau nying kàttì raka. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Pǝlǝa amǝ'Amalek andǝ amǝ'Kan'ana mǝnana à do arǝ ala amur ankono ka, à sulǝ ateà, à yi gandǝia, à pǝrtea aban ká Horma.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s">Anggurcau amur pāki agir'nkila</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />Yahweh bangcau nǝ Musa ama, <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />&lt;&lt;Bangcau nǝ amǝ Isǝrayila, nea wia ama, &lt;Lang wu yina aɓa nzali mǝnana ǝn nggǝ pa wun, wun nǝ̀ duk kam, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />sǝ wun nǝ̀ pàgir nǝ bǝsa aban Yahweh ka, wu pà jamnda ko gam ko gbato. Wu panagir nǝi kǝla pàgir mala pisǝe kǝring, ko mala gir'nkila ace lumsǝ pàcau nǝ-shambum,<note caller="+" style="f"><char style="fr" closed="false">15:3 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="LEV 22:21">Pǝris 22:21</ref>; <ref loc="LEV 27:2">27:2</ref>; <ref loc="NUM 15:8">Ɓal 15:8</ref></char>.</note> ko mala eare mala ɓabum, ko mǝnana wu kǝ pa pwari-pwari ace alamsan ma'wun ngga, ace pa rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam Yahweh ka. <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />Ɓwa mǝnana kǝ yinǝ pàgir male aban Yahweh ka, dumǝna púp nǝ̀ yinǝi atārǝia andǝ pàgir mala mǝsǝsa, muku mǝɓǝlke tyang mwashat, mǝnana à zurì nǝ mùrú olif, dù-lita mwashat ka. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Lang wun nǝ̀ pà muna-gam ace pagir mala pisǝe kǝring ko gir'nkila nǝi ka, dumǝna púp awu nǝ yinǝi atārǝia andǝ dù-lita mwashat mala mùr-anap ace pàgir mala girnùná.<verse eid="NUM 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 15:6" />&lt;&lt; &lt;Ɓǝ̀ gam na ka, dumǝna púp awu nǝ yinǝ tyang ɓari mala muku mǝɓǝlke mǝnana à zurì nǝ dù-lita mwashat nǝ gauwa-tsùrú mala mùrú olif ka, ace pàgir mala mǝsǝsa; <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />ɗǝm ngga awu nǝ pàgir mala girnùná, dù-lita mwashat nǝ gauwa-tsùrú mala mùr-anap, ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam Yahweh ka.<verse eid="NUM 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 15:8" />&lt;&lt; &lt;Lang jamnda na awu nǝ pa kǝla pàgir mala pisǝe kǝring ko gir'nkila, ace lumsǝ pàcau nǝ-shambum, ko kǝla pàgir mala dotarǝu aban Yahweh ka, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />dumǝna púp awu nǝ pà mǝno yi jamnda ka andǝ tyang tàrú mala muku mǝɓǝlke mǝnana à zurì nǝ dù-lita ɓari mala mùrú olif ka; <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />ɗǝm ngga dumǝna púp awu nǝ pa dù-lita ɓari mala mùr-anap kǝla pàgir mala girnùná. Pàgir na nǝ bǝsa, mala pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />Anggo sǝ à nǝ̀ gilǝkice koya jamnda ko gam, koya muna-gam ko muna-gbato. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Dumǝna púp ama, awu nǝ pàk mǝnia ka ace komǝye atea, kǝla mana làkkì malea pàk ka.<verse eid="NUM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 15:13" />&lt;&lt; &lt;Koya ɓwa mǝnana kat à ɓǝli ɓwa Isǝrayila na ka, dumǝna púp nǝ̀ pàk agir mǝnia ka anggo lang nǝ̀ yinǝ pàgir nǝ bǝsa, ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Arǝ anza mǝnana kat à kǝ yiu ka, ɓǝ̀ ɓwa-kúnɗàngna yiu a do bǝti atà wun, sǝ ko ɓǝ̀ yana mǝnana ndanǝdo aɓalǝ wun sǝ earce ama nǝ̀ yinǝ pàgir nǝ bǝsa, ace pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka, dumǝna púp nǝ̀ pè a pě ma'wun. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Nggurcau mǝmwashati na ace ɓwabundǝa kat, ace wun andǝ ɓwa-kúnɗàngna mana ndanǝdo aɓalǝ wun ngga; nê na mǝnana pà nǝ̀ nggaɗi raka arǝ anza ma'wun kat. Wun, sǝ yià amǝkúnɗàngna ka, wu nda mwashat a ɓadǝm Yahweh. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Anggurcau andǝ akwarkiru mǝmwashati na ace wun sǝ ace ɓwa-kúnɗàngna mana do aɓalǝ wun ngga.&gt; &gt;&gt;<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />Yahweh nacau nǝ Musa ama, <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />&lt;&lt;Bangcau nǝ amǝ Isǝrayila sǝ wu nea wia ama, &lt;Lang wu kutina aɓa nzali mǝnana ǝn nggǝ yinǝ wun kam ngga, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />nǝ̀ yia do ama, lang wu lina girlina mala nzalî ka, dumǝna púp wun nǝ̀ yinǝ pàgir mala loasǝe a kuli abanam Yahweh.<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="fq" closed="false">yinǝ pàgir mala loasǝe a kuli abanam Yahweh </char><char style="ft" closed="false">ko &lt;&lt;san ɓè bare ace pàgir mǝnana à tàrì acem Yahweh ka.&gt;&gt;</char></note> <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Wun nǝ̀ yinǝ kyak mǝnana à pè nǝ muku mana wu goe a dǝmba ka, sǝ wun nǝ̀ tàrì ɓǝ̀ duk pàgir mǝnana à loasǝi a kuli aban Yahweh ka, kǝla mana wu kǝ pangnǝ mǝsǝsa mǝdǝmbe mana pur a katǝra ka. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Dumǝna púp ama koya pǝlǝa, arǝ anza ma'wun kat ka, wun nǝ̀ nggǝ pê Yahweh pàgir mana à loasǝi a kuli ka aɓa muku mǝdǝmbe mǝnana wu goe ka.<verse eid="NUM 15:21" /></para>
  <para style="s">Anggurcau amur acauɓikea mana à pea aɓa ɓwarkio ka</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />&lt;&lt; &lt;Lang wu ɓwarkio, wu gatti kpata anzongcau man mǝnana kat Yahweh banggi Musa ka, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />nggearǝ agir mana kat Yahweh na wun nǝ kún Musa, twal a pwari mana Yahweh pana nzongcau nǝi aban ká dǝmba, arǝ anza ma'wun kat ka, <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />sǝ ɓǝ̀ mǝnia ka wu pè kpakpak ɗang, sǝ pà a mǝsǝ ɓwabundǝa raka, ɓwabundǝa kat nǝ̀ pà lo-jamnda, kǝla pàgir mala pisǝe kǝring, ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam Yahweh ka, atārǝia andǝ pàgir mala girlina andǝ pàgir mala girnùná male, kǝla mana nggurcau kanì ka, andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Pǝris nǝ shawuɗi ɓwabundǝa mala amǝ Isǝrayila sǝ à nǝ̀ twalia wia banì, acemǝnana ɓwarkio na, sǝ ɗǝm ngga à yinanǝ pàgir malea, yì pàgir nǝ bǝsa aban Yahweh andǝ pàgir mala gǝshi cauɓikea malea aban Yahweh, ace ɓwarkio malea. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Sǝ ɓwabundǝa mala amǝ Isǝrayila kat ka, à nǝ̀ twalia wia banì, yia andǝ amǝkúnɗàngna mǝnana à do aɓalǝia ka, acemǝnana mǝno yì gìr à pè ka kum aɓwana kat aɓa ɗwanyi-sǝlǝe.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />&lt;&lt; &lt;Ɓǝ̀ ɓwa mwashat pàk cauɓikea aɓa ɗwanyi-sǝlǝe ka, dumǝna púp ama nǝ̀ pà gir'nkila nǝ mamǝna mbul mǝnana mbule mwashat ka, kǝla pàgir mala gǝshi cauɓikea. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Sǝ ɓwa mǝno ɓwarkio, lang pàk cauɓikea aɓa ɗwanyi-sǝlǝe ka, pǝris nǝ̀ shawuɗi a ɓadǝm Yahweh. Nǝ̀ shawuɗì sǝ à nǝ̀ twali wi banì. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Nggurcau na mwashat ace ɓwa mǝnana pàk cauɓikea aɓa ɗwanyi-sǝlǝe ka, ko ɓwê ka à ɓǝlì ɓwa Isǝrayila na, ko ɓwa-kúnɗàngna na, mǝnana do aɓalǝ wun ngga.<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />&lt;&lt; &lt;Sǝ ɓwa mǝnana pàk gìr kpakpak ka, ko ɓwa Isǝrayila na ko ɓwa-kúnɗàngna na ka, ndarǝ ɓǝsǝki Yahweh. Mǝno yì ɓwa ka à nǝ̀ pusǝì aɓalǝ aɓwana male. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />Acemǝnana nyesǝna cau mala Yahweh ɓà, sǝ yàlni nzongcau male ka, mǝno yì ɓwa ka, à nǝ̀ kasǝì aɓalǝ aɓwana male kat-kat. Bafe male nǝ̀ ueo amurí.&gt; &gt;&gt;<verse eid="NUM 15:31" /></para>
  <para style="s">À wal-lú ɓeɓwa ace yàl nzongcau mala Sabbat</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Lang amǝ Isǝrayila na aɓa pǝɗanban ngga, à kum ɓeɓwa aban tarki gimsa a pwari Sabbat.<note caller="+" style="f"><char style="fr" closed="false">15:32 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="EXO 35:2-3">Pur 35:2-3</ref></char>.</note> <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Aɓwana mǝnana à kumi aban tarki gimsa ka, à warinǝi aban Musa andǝ Haruna, andǝ ɓwabundǝa kat. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />À gìrì a ndà, acemǝnana à malaká kasǝcau amur gìr mǝnana à nǝ̀ pàngnǝi ka ɗàng.<verse eid="NUM 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 15:35" />Yahweh banggi Musa ama, &lt;&lt;Mǝno yì ɓwa ka, dumǝna púp à nǝ̀ wal-luí; ɓwabundǝa ɓǝà ɓukkí nǝ atali zak nǝ kàttì.&gt;&gt; <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Nda ɓwabundǝa puppup pusǝì zak nǝ kàttì, sǝ à ɓukki nǝ atali wǔ, kǝla mǝnana Yahweh banggi Musa ka.<verse eid="NUM 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />Yahweh bang cau nǝ Musa ama, <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />&lt;&lt;Nacau nǝ amǝ Isǝrayila, sǝ wu banggia wia ama, &lt;Arǝ anza malea kat ka, ɓǝà ɓolǝ ankonggúr ace ɗúrkia arǝ abankara mala kún anggea-daura malea, sǝ arǝ koya ɓolǝo-nkonggúr ka, à nǝ̀ tsǝki wi nkonggúr mǝlùre. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />Nǝ̀ duk ɓolǝo-nkonggúr ace wun, ace mǝnana ɓǝ̀ wu sǝni, sǝ ɓalǝ wun ɓǝ̀ kasǝa arǝ anzongcau mala Yahweh kat, sǝ wu kpatea, sǝ wu kǝa gya atà ɓabum wun andǝ mǝsǝ wun, mǝnana nǝ̀ kánǝ wun a gyatarǝu atà aɓea aɓakuli ka ɗàng. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />Anggo sǝ wun nǝ ɗenyinǝ, sǝ wun nǝ̀ kpata anzongcau mem kat, sǝ wun nǝ̀ duk amǝfele aban Ɓakuli ma'wun. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Mǝ nda Yahweh Ɓakuli ma'wun, mǝnana pusǝ wun aɓa nzali Masar ace duk Ɓakuli ma'wun ngga. Mǝ nda Yahweh Ɓakuli ma'wun.&gt; &gt;&gt;<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s">Mgbicau mala Kora</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />A ɓe pwari ka, Kora muna-ɓwabura mala Iza, muna-ɓwabura mala Kohat, muna-ɓwabura mala Lawi, twal Datan andǝ Abiram, amuna-burana mala Eliyap, andǝ On muna-ɓwabura mala Pele, amǝkà Ruben, atè. <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />Sǝ à lo arǝ Musa, atārǝia andǝ aɓea aburana gbǝman-ɓari nǝ lumi-tongno, mǝnana à súrǝ̀ia pepè, sǝ amǝ Isǝrayila twalia ɓǝà duk aɓwana-mǝgule amur ɓwabundǝa ka. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />À kya ram rǝia a banɓwáná arǝ Musa andǝ Haruna sǝ à banggia wia ama, &lt;&lt;Wu umá ɗār! Koyan aɓa ɓwabundǝa mǝnia kat ka mǝfele na, sǝ Yahweh ka nda aɓalǝia! Sǝ palang sǝ wu kǝ loasǝ ɓamur rǝ wun amur ɓwabundǝa mala Yahweh?&gt;&gt;<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />Lang Musa ok cau man ngga, kara kpa nǝ ɓamǝsǝi a nzali, <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />sǝ ne Kora andǝ aɓwana mǝnana kat atè ka, ama, &lt;&lt;Nǝ dǝmbari ka, Yahweh nǝ̀ lǝmdǝ yana nda male, sǝ yana nda mǝfele andǝ ɓwa mǝnana nǝ̀ yinǝi tù a baní ka. Ɓwa mǝnana Yahweh nǝ̀ twal ka, nǝ̀ yinǝi tù a baní. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />We Kora wunǝ aɓwana mô kat, wu pàk mǝnia ka: wu twal atasau-bǝsa;<note caller="+" style="f"><char style="fr" closed="false">16:6 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 27:3">Pur 27:3</ref>; <ref loc="EXO 38:3">38:3</ref>; <ref loc="NUM 4:9">Ɓal 4:9</ref>,<ref loc="NUM 4:14">14</ref>; <ref loc="NUM 16:17">16:17</ref>,<ref loc="NUM 16:37-39">37-39</ref></char>.</note> <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />lí ka, wu tsǝk bǝsa aɓalǝia, sǝ wu so muku-gìr loasǝ yele mǝ'rǝmɓoarne amúrià aɓadǝm Yahweh.<note caller="+" style="f"><char style="fr" closed="false">16:7 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 10:1-2">Pǝris 10:1-2</ref>; <ref loc="LEV 16:12">16:12</ref></char>.</note> Ɓwa mǝnana Yahweh nǝ̀ twal ka, nǝ̀ duk ɓwa mǝnana mǝfele na ka. Wun amuna-burana mala Lawi ka, wu umá ɗār!&gt;&gt;<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />Pǝlǝa Musa ne Kora ama, &lt;&lt;Wu ǒ, wun amuna-burana mala Lawi: <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Wu kǝ sǝni ama gìr mǝkyauwe na, mǝnana Ɓakuli mala amǝ Isǝrayila tàr wun aɓa ɓwabundǝa mala Isǝrayila, ace yinǝ wun tù a baní, ɓǝ̀ wu pàk túró a Taragula mala Yahweh, sǝ ɓǝ̀ wu came a ɓadǝm ɓwabundǝa ace pakkia wia túró ka, <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />sǝ ɗǝm ngga yinanǝ wun tù a baní, wun kat andǝ amǝ'eam wun amuna-burana mala Lawi ka le? Wu ndarǝ alta dobuno-pǝris gbal le? <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Acemani ka, nda arǝ Yahweh sǝ wun, wunǝ amǝ kpata wun ngga, wu ram rǝwun! Yana nda Haruna mǝnana wu kǝ nggwani wi ka?&gt;&gt;<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />Sǝ Musa túrban ɓǝà tunǝ Datan andǝ Abiram, amuna-burana mala Eliyap ɓǝà yiu; sǝ à bang ama, &lt;&lt;Pà sǝm nǝ̀ ká ɗàng! <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />A kǝ sǝni kǝla gìr mǝkyauwe na mǝnana a pusǝ sǝm, sǝm purî ɓá nzali mǝnana mur-nyi andǝ kiura kǝ ɓang kàm ngga, ace wal-lú sǝm aɓa pǝɗanban ngga, sǝ ado ka a kǝ earce lǝmdǝ do-ɓwamǝgule amur sǝm gbal le? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Sǝ yale a malaká yinǝ sǝm a nzali mǝnana mur'nyi andǝ kiura kǝ ɓang kàm ngga ɗàng, sǝ a pa sǝm aɓaban-mǝssa andǝ aɓaban-anap ɓǝà duk agirkuma ma'sǝm ɗàng. A kǝ sǝnì kǝla sǝm pànǝ ɗenyicau re? Awo, pà sǝm nǝ ká ɗàng!&gt;&gt;<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />Bum Musa lul kǝ̀rkǝ́r, sǝ ne Yahweh ama, &lt;&lt;Cè a ak apagir malea ɗàng. Ən ak kǝ mǝdambǝriso a bu kǝɓwa ateà ɗàng, sǝ ǝn pakkì kǝɓwa ateà kǝgir mǝɓane ɗàng.&gt;&gt;<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />Sǝ Musa ne Kora ama, &lt;&lt;Lí ka, we wunǝ amǝ'tò kat, wu kya ɓadǝm Yahweh; we, yià sǝ Haruna. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Koyan atà wun ngga ɓǝ̀ twal tasau-bǝsa male, sǝ ɓǝ̀ so muku-gìr loasǝ yele mǝ'rǝmɓoarne aɓalǝi, sǝ koyan ngga ɓǝ yinǝ tasau-bǝsa male aɓadǝm Yahweh, atasau-bǝsa gbǝman-ɓari nǝ lumi-tongno; we gbal, sǝ Haruna, koyan nǝ tasau-bǝsa male.&gt;&gt;<verse eid="NUM 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 16:18" />Koyan ateà ka, twal tasau-bǝsa male, tsǝk bǝsa aɓalǝi, sǝ so muku-gìr loasǝ yele mǝ'rǝmɓoarne amurí, sǝ came a bankutio aɓa Tara Ban-peri, atārǝia andǝ Musa andǝ Haruna. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Kora ram ɓwabundǝa arǝia a bankutio aɓa Tara Ban-peri.</para>
  <para style="p" vid="NUM 16:19">Ɓoarɓwa mala Yahweh pusǝrǝi aban ɓwabundǝa kat. <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />Yahweh ne Musa andǝ Haruna ama, <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />&lt;&lt;Wu gǝ́shìban ɓinala aɓwana mǝnia ka, ace mǝnana mǝ twaltea akǝ dyadyan!&gt;&gt;<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />Sǝama Musa andǝ Haruna kpa nǝ ɓamǝsǝia, sǝ à bang ama, &lt;&lt;We Ɓakuli, Ɓakuli mala abangŋo mala aɓwapǝndǝa kat, ɓwa mwashat nǝ̀ pàk cauɓikea sǝ awu nǝ pak-bumlulla nǝ ɓwabundǝa kat le?&gt;&gt;<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />Pǝlǝa Yahweh nacau nǝ Musa, ama, <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />&lt;&lt;Banggi ɓwabundǝa ama, &lt;Wu gǝ́shìban agumli mala Kora, Datan andǝ Abiram!&gt; &gt;&gt;<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />Pǝlǝa Musa lo wari aban Datan andǝ Abiram; sǝ aɓwana-mǝgule mala Isǝrayila o atè. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />Sǝ banggi ɓwabundǝa ama, &lt;&lt;Ida, wu upi ban agumli mala aburana amǝɓealɓike man, sǝ wu kǝa je kǝgir malea ɗàng, ɓǝ̀ ana raka à nǝ̀ twalta wun aɓalǝ acauɓikea malea kat!&gt;&gt; <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" />Nda à gǝ́shìban agumli mala Kora, Datan andǝ Abiram, a koya buì. Datan andǝ Abiram puro à cam a kún agumli malea andǝ amālea, amuna-burana malea andǝ amuna mǝkèke malea. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />Musa bang ama, &lt;&lt;Nǝ mǝnia ka sǝ wun nǝ̀ sǝlǝa ama Yahweh túrǎm ɓǝn pakki atúró mǝnia ka; à pur aɓa ɗenyicau mem ɗàng. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Ɓǝ̀ aɓwana mǝnia wú kǝla mana aɓwana kat kǝ wú ka, ko ana raka, ɓǝ̀ gìr mǝnana kumgiyi aɓwana nda mana nǝ̀ kumia ka, Yahweh nǝ̀ túrǎm ɗang. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />Sǝama ɓǝ̀ Yahweh pàk gìr mǝbǝshe, sǝ nzali mǝn kúni myalia kat andǝ agir mana amalea na, sǝ à kùtí nǝmǝsǝia a Shewol ka, sǝ wun nǝ̀ sǝlǝa ama aburana man ɓǝsǝkina Yahweh.&gt;&gt;<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />Lang malǝna naki acau mǝnia ka, kara nzali mǝnana à cam amurí ka gauwa mǝnna. <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />Nzali mǝn kúni, sǝ myalia andǝ amǝɓala malea, aɓwana mala Kora kat, andǝ agirkuma malea. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Anggo sǝ yia, andǝ agirkuma malea kat ka, à ko nǝmǝsǝia a Shewol; sǝ nzali gir amúrià, tea-twalî ɓá ɓwabundǝa. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Makki'zwalo malea tsǝk amǝ Isǝrayila mǝnana kat à kàrìbania ka à lo nǝ mire; à bang ama, &lt;&lt;Cè nzali myal sǝm ɗàng!&gt;&gt; <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" />Bǝsa sulǝ nǝban Yahweh, pisǝ aɓwana mǝno gbǝman-ɓari nǝ lumi-tongno mǝnana à pàgir mala loasǝ yele mǝ'rǝmɓoarne ka.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />Yahweh bangcau nǝ Musa ama, <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />&lt;&lt;Banggi Eleaza muna-ɓwabura mala Haruna yì pǝris, ama ɓǝ̀ pwangi atasau-bǝsa aɓa pibǝsa, acemǝnana amǝfele na. Sǝ ɓǝ̀ mesǝki ankalang-bǝsanì kuko nǝ kàttì. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />Atasau-bǝsa mala aɓwana mǝnia à pàk cauɓikea sǝ warinǝia à ɗwanyi yilǝmia ka, ɓǝà walkia lapat-lapat, ace gìr-rǝ gyangŋan nǝia, acemǝnana à panagir nǝia aban Yahweh. Acemani ka amǝfele na. À nǝ̀ duk gìr'lǝmdǝa aban amǝ Isǝrayila.&gt;&gt; <verse eid="NUM 16:38" /><verse number="39" style="v" sid="NUM 16:39" />Nda Eleaza yì pǝris twal amǝnia yì atasau-bǝsa mala bolo-bángŋá, mǝnana aɓwana mana à pisǝia ka, à panagir nǝia ka, sǝ walkia lapat-lapat, à pǝlǝ gìr gìr-rǝ gyangŋan, <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />kǝla mana Yahweh banggi wi nǝ kún Musa ka. Mǝno ka nǝ̀ duk gir kasǝɓalǝu aban amǝ Isǝrayila ama kǝ ɓwa-ɗàng pà kàm, mǝnana pur a tàu mala Haruna raka, nǝ̀ sung tù ama nǝ̀ pàgir mala pisǝ muku-gìr loasǝ yele mǝ'rǝmɓoarne aɓadǝm Yahweh ka ɗang, ace mǝnana ɓǝ̀ kǝa pa kǝla Kora andǝ amǝtè ka ɗàng.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Sǝama lang ban yi fana ka, ɓwabundǝa mala amǝ Isǝrayila nggwanî Musa andǝ Haruna ama, &lt;&lt;Wu walna-lú aɓwana mala Yahweh!&gt;&gt; <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />Sǝ lang ɓwabundǝa yi ramba arǝ Musa andǝ Haruna ka, à pǝlǝ mǝsǝia nǝban Tara Ban-peri. Kara à sǝni ka pǝrɓang girna murí, sǝ ɓoarɓwa mala Yahweh pusǝrǝi. <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />Pǝlǝa Musa andǝ Haruna yiu a bankutio aɓa Tara Ban-peri, <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />Yahweh nacau nǝ Musa ama, <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />&lt;&lt;Wu gǝ́shìban ɓwabundǝa mǝnia ka, ace mǝnana ɓǝn twaltea adyan.&gt;&gt; Sǝama à kpa nǝ ɓamǝsǝia a nzali. <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" />Sǝ Musa ne Haruna ama, &lt;&lt;Twal tasau-bǝsa mò, ɗàrǝ́ nkalang-bǝsa mana nda amur gyangŋan ngga aɓalǝi, sǝ wu so muku-gìr loasǝ yele mǝ'rǝmɓoarne amurí. Kyane akaurǝa aban ɓwabundǝa sǝ wu shawuɗia, acemǝnana bumlulla sulǝna nǝban Yahweh! Kwánó-ɓikea tinate.&gt;&gt; <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Nda Haruna pa kǝla mana Musa banggi wi ka; twal tasau-bǝsa male, sǝ ɓangŋa wari a tsùrú mala ɓwabundǝa, sǝ sǝni ka kwánó-ɓikea tinate aɓalǝ aɓwana. Pǝlǝa so muku-gìr loasǝ yele mǝ'rǝmɓoarne, sǝ shawuɗi aɓwe. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Yi came a nre ka alú andǝ amǝyilǝmu, sǝ à tamsǝ kwánó-ɓikea, lidǝmba ɗàng. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />Làkkì mala aɓwana mǝnana à wù atàcau mala kwánó-ɓikea mǝnia ka, à nda á-lum-nong-ine nǝ gbǝman-tongno-nong-ɓari (14,700), amur amǝno à wu a gìr-kumban mala Kora ka. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Anzǝm mǝnana à tàmsǝna kwánó-ɓikea ka, Haruna nyar aban Musa a bankutio aɓa Tara Ban-peri.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s">Gara mala Haruna tò-mbuí</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />Yahweh banggi Musa ama, <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila, sǝ wu ak agara lum-nong-ɓari a buia, mwashat ace koya ɓala-kàu,<note caller="+" style="f"><char style="fr" closed="false">17:2 </char><char style="fq" closed="false">ɓala-kàu </char><char style="ft" closed="false">ko tàu</char></note> a bu amúrû kat arǝ aɓala-kàu malea. Gilǝ lullǝ koya múrû arǝ gara male, <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />sǝ wu gilǝ lullǝ Haruna amur gara mala Lawi. Koya múrû mala koya ɓala-kàu ka nǝ̀ pàngnǝ gara mwashat. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />Tsǝk agara mǝnia ka aɓa Tara Ban Peri, aɓadǝm Akwati mala Acau-nakûn, ban mǝnana ǝn nggǝ je sǝnǝ we kam ngga. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Sǝ gara mala ɓwa mǝnana ǝn twal ka nǝ̀ tò-mbuí. Anggo sǝ mǝ nǝ tamsǝ nggwani mala amǝ Isǝrayila mǝnana à kǝ̀ yinǝi tùtù amuro ka.&gt;&gt;<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />Nda Musa nacau nǝ amǝ Isǝrayila ka; sǝ koyan atà amúrû malea pe wi gara, mwashat ace koya múrû mala koya ɓala-kàu, agara lum-nong-ɓari, sǝ gara mala Haruna ka nda aɓalǝ amalea. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Musa pǝlǝa tsǝk agara mǝnia ka, aɓadǝm Yahweh, aɓa Tara mala Acau-nakûn.<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />Lang ban fana ka, Musa kútí aɓa Tara mala Acau-nakûn, kara sǝni ka, gara mala Haruna, mana nda ace tàu mala Lawi ka, tongŋǝna sǝ pusǝna mbuí arǝì, sàngŋǝ̀nà pwasǝe, sǝ pusǝna aɓǝla-almon mǝnana à bangŋǝ́nà ka. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Musa pǝlǝa pusǝ agara mǝno a ɓadǝm Yahweh, yinǝia aban amǝ Isǝrayila kat. Pǝlǝa à sǝnggi agare kat, sǝ koya múrû ka twal gara male.<verse eid="NUM 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 17:10" />Sǝ Yahweh banggi Musa ama, &lt;&lt;Nyesǝ gara mala Haruna tsǝì aɓadǝm Akwati mala Acau-nakûn,<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 9:4">Ib 9:4</ref></char>.</note> ace mǝnana ɓǝ̀ duk gir'lǝmdǝa aban amǝ'mgbicau. Mǝnia ka nǝ̀ tamsǝ nggwani malea arǝàm, ɓǝ̀ ana raka à nǝ̀ wukio.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:10 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 28:35">Pur 28:35</ref>; <ref loc="EXO 30:20-21">30:20-21</ref>; <ref loc="LEV 8:35">Pǝris 8:35</ref>; <ref loc="LEV 10:6">10:6</ref>,<ref loc="LEV 10:9">9</ref>; <ref loc="LEV 15:31">15:31</ref>; <ref loc="LEV 16:2">16:2</ref>,<ref loc="LEV 16:13">13</ref>; <ref loc="NUM 4:19">Ɓal 4:19</ref>; <ref loc="NUM 18:3">18:3</ref>,<ref loc="NUM 18:32">32</ref> </char>.</note> <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />Anggo sǝ Musa pa, kǝla mǝnana Yahweh pe wi nzongcau ama ɓǝ̀ pàk ka.<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />Sǝ amǝ Isǝrayila banggi Musa ama, &lt;&lt;Sǝni, ma'sǝm malǝna! Sǝm wukina! Sǝm kiɗikina! <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Koyan mǝnana sung tù, mǝnana gbàshì ban Taragula mala Yahweh ka, nǝ̀ wǔ. Sǝm kat ka, sǝm nǝ̀ wuki le?&gt;&gt;<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s">Atúró mala Apǝris andǝ Amǝ'Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />Yahweh banggi Haruna ama, &lt;&lt;We, wunǝ amuna-burana mô andǝ ɓala-kàu mò atò ka wun nda à nǝ̀ tsǝka wun cau arǝ wun mala koya gìr mǝɓane mǝnana kum agir mǝnana à nda aɓa Tara-mǝfele ka. Sǝ we wunǝ amuna-burana mô atò ka, wun nda à nǝ̀ tsǝka wun cau arǝ wun ɓǝ̀ apǝris ɗwanyi kpata nggurcau mala túró pǝris ma'wun ngga. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Ɗǝm ngga, amǝ'eambo a tàu mala Lawi, yì tàu mala akeô ka, awu nǝ yinǝia ace mǝnana ɓǝà pàkkô gbasha; sǝ we wunǝ amuna-burana mô mana atò ka, wun nǝ̀ pa aɓadǝm Tara mala Acau-nakûn.<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 8:5-26">Ɓal 8:5-26</ref></char>.</note> <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Yia ka, à nǝ̀ kpata cau mò andǝ bwal túró mǝnana à nǝ̀ nggǝ pa aɓa Taragula kat ka. Sǝama, dumǝna púp, à pà nǝ̀ yiu tù aban agirtúró mala Ban-mǝfele ko gyangŋan ɗàng, ɓǝ̀ ana raka à nǝ̀ wǔ, sǝ awu nǝ wǔ. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Yia ka, dumǝna púp à nǝ̀ kpapibu nǝ we ace tsǝkir Tara Ban-peri andǝ pakki atúró mala Tara Ban-peri kat. Ɓwa-ɗàng pà nǝ̀ gbàshìban wun ɗàng.<verse eid="NUM 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 18:5" />&lt;&lt;Wun nda wu nǝ̀ nggǝ pakki atúró mala Tara-mǝfele andǝ atúró mala gyangŋan ngga, ace mǝnana bumlulla mala Yahweh ɓǝkǝa sulǝo amur amǝ Isǝrayila ɗǝm raka.<note caller="+" style="f"><char style="fr" closed="false">18:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 1:53">Ɓal 1:53</ref>; <ref loc="NUM 16">16</ref>; <ref loc="NUM 17:12-13">17:12-13</ref></char>.</note> <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Sǝni, Mim nǝ ɓamúràm ngga, ǝn tarna amǝ'eambo Amǝ'Lawi, aɓalǝ amǝ Isǝrayila. À nda ka ɓoro a bano, mana à pànî Yahweh, ace pàk túró mala Tara Ban-peri ka. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />Sǝama, we wunǝ amuna-burana mô ka, wun nǝ̀ pàk túró-dopǝris ma'wun ace koman kat mala gyangŋan andǝ gìr mǝnana à nǝ̀ pe aɓa Ban Nggea Mǝfele ka. Wun nǝ̀ pàk túró-pǝris. Mǝ ndaban pa wun túró-dopǝris kǝla ɓoro ace túrô. Sǝ ɓwa-ɗàng mǝnana yiu tù aban Tara-mǝfele ka, dumǝna púp à nǝ̀ wal-lui.&gt;&gt;<verse eid="NUM 18:7" /></para>
  <para style="s">Pàgir ace Apǝris andǝ Amǝ'Lawi</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />Pǝlǝa Yahweh banggi Haruna ama, &lt;&lt;Sǝni, Mim nǝ ɓamúràm, ǝn tsǝ́ngŋǝ̀nó amur apagir mana à yinǝia abanam ngga, yì aɓoro mǝfele mana kat amǝ Isǝrayila pa abanam ngga. We wunǝ amuna-burana mô andǝ amǝ'keo ka wun nǝ̀ kum kāmbe mana à pusǝì aɓalǝ aɓoro mǝfele mǝnia ka; dumǝna nê mana à nǝ̀ kpate ka tàtǝ́k. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Kāmbe aɓalǝ apagir nggea mǝfele mana à pisǝia kǝring raka, komǝye atà apagir malea mǝnana à pà abanam, koya pàgir mala mǝsǝsa, andǝ koya pàgir mala gǝshi cauɓikea, andǝ koya pàgir mala kumcau, mǝnana à nǝ̀ pà abanam ngga, à nǝ̀ duk nggea mǝfele aceo sǝ ace amunio andǝ amǝ'keò. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Wun nǝ̀ lì a ban nggea mǝfele. Koya muna-ɓwabura ka nǝ̀ gandǝ li. Nǝ̀ duk gìr mǝfele aban wun.<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />&lt;&lt;Mǝnia gbal ka, mona: kāmbe mǝnana à twal aɓa pàgir mala aɓoro malea, yì apagir mǝnana kat amǝ Isǝrayila pà abanam nǝ loasǝe a kuli ka. Ən pano wia, we wunǝ amuna-burana andǝ amuna-mamǝna mô atò. Dumǝna nê mana à nǝ̀ kpate ka tàtǝ́k. Koya ɓwa mǝnana nda aɓa ɓoarnsari a ɓala mò ka, nǝ̀ gandǝ li.<verse eid="NUM 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12" />&lt;&lt;Mùrú olif kat nggea-mǝɓoarne mǝnana à tita kàmbe, andǝ mùr-anap kat nggea-mǝɓoarne mǝnana à tita kàmbe, andǝ mǝsǝsa nggea-mǝɓoarne mǝnana à tita pwane, yì aɓǝlagir mǝdǝmbe malea mǝnana à kǝ yinǝia ace pè abanam Mim Yahweh ka, ǝn pano wia. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Aɓǝlagir mǝdǝmbe mala koman kat, mǝnana nda aɓa nzali malea, mǝnana à kǝ yinǝia aban Yahweh ka, amona. Koya ɓwa mǝnana nda aɓa ɓoarnsari a ɓala mò ka, nǝ̀ gandǝ li.<verse eid="NUM 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14" />&lt;&lt;Koya gìr a Isǝrayila, mana à tàrni acem Yahweh ka, dumǝna mona. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />Koya muna-dǝmba mala agir mǝnana nǝyilǝmu, mana tita puro a bum ngge, ko ɓwapǝndǝa ko girkusǝu na, mana à kǝ panagir nǝi abanam Yahweh ka, mona. Sǝama, dumǝna púp, aɓwana nǝ̀ akmúr muna-dǝmba mala ɓwapǝndǝa,<note caller="+" style="f"><char style="fr" closed="false">18:15 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 13:11-16">Pur 13:11-16</ref></char>.</note> sǝ à nǝ̀ akmúr muna-dǝmba mala girkusǝu mǝɓeami. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Akmúria lang à lùmsǝ̀nà zongŋo mwashat anzǝm ɓǝlia ka. Boalo akmúria ka shekel tongno mala mǝsǝbolo-azǝrfa na. Kpata shekel mǝnana à kārǝ́ dǝmbǝrya male sǝ à earna amurí a Tara-mǝfele (mǝnana shekel mwashat ka mǝtyang lum-nong-ɓari na ka).<verse eid="NUM 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 18:17" />&lt;&lt;Sǝama muna-dǝmba mala ndǎ, ko muna-dǝmba mala nzur, ko muna-dǝmba mala mbulpǝndǝa ka, à pà nǝ̀ akmúria ɗàng; amǝfele na. Awu nǝ watsǝki nkilea amur gyangŋan, sǝ awu nǝ pisǝ mùrú-nyama malea kǝla pàgir nǝ bǝsa mǝnana kǝ pa rǝmban mǝɓoarne mana kǝ pwasǝbumam Yahweh ka. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Nyam agirkusǝu mǝnia ka, dumǝna mona, kǝla mana nyam kikil girkusǝu andǝ byali mǝlì mana à pàgir nǝi nǝ loasǝe a kuli ka, amona ka. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Apagir mǝfele mana amǝ Isǝrayila kǝ yinǝia ace pè Yahweh ka, ǝn pano, we wunǝ amuna-burana andǝ amuna-mamǝna mô atò, kǝla nê mana à nǝ̀ kpate ka tàtǝ́k. Mǝnia ka dumǝna kùrcau mala tuɓamur,<note caller="+" style="f"><char style="fr" closed="false">18:19 </char><char style="fq" closed="false">kùrcau mala tuɓamur </char><char style="ft" closed="false">ko &lt;&lt;pacau mǝnana nggaɗe pà kàm raka&gt;&gt;</char></note> mana pà nǝ̀ mal raka, aɓadǝm Yahweh, aceo andǝ amǝ'keò atò.&gt;&gt;<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />Pǝlǝa Yahweh banggi Haruna ama, &lt;&lt;Wun apǝris ka pà wu nǝ̀ kum kǝ nzali ace liɓala atà amǝ Isǝrayila ɗàng, sǝ pà wu nǝ̀ kum kǝ kāmbe ama ma'wun na ateà ɗàng. Mǝ nda kāmbe mana wun nǝ̀ kum ngga andǝ gìr liɓala ma'wun aɓalǝ amǝ Isǝrayila.<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />&lt;&lt;Sǝni, ǝn panì Amǝ'Lawi banì-mwashat-aɓa-lum mala agirkuma kat a Isǝrayila<note caller="+" style="f"><char style="fr" closed="false">18:21 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 26:12">Nggur 26:12</ref>; <ref loc="2CH 31:12">2Acau 31:12</ref>; <ref loc="NEH 10:37-38">Nehe 10:37-38</ref>; <ref loc="HEB 7:5">Ib 7:5</ref></char>.</note> ɓǝ̀ duk gìr liɓala malea, a kúnì túró mǝnana à kǝ pak ka, yì túró mala Tara Ban-peri. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Amǝ Isǝrayila pà nǝ̀ gbàshìban Tara Ban-peri ɗǝm ɗàng, ɓǝ̀ ana raka à nǝ̀ twal cauɓikea amúrià, sǝ à nǝ̀ wǔ. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Amǝ'Lawi na mǝnana à earia wia ɓǝà pak túró mala Tara Ban-peri ka, sǝ à nǝ̀ twal bafe mala cauɓikea malea amúrià. Mǝnia ka nggurcau na mǝnana nggaɗe pà kàm raka arǝ anza ma'wun kat. Amǝ'Lawi pànǝ kǝ nzali ace liɓala atà amǝ Isǝrayila ɗàng;<note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 10:8-9">Nggur 10:8-9</ref>; <ref loc="DEU 18:1-2">18:1-2</ref>; <ref loc="JOS 13:14">Jes 13:14</ref>,<ref loc="JOS 13:33">33</ref></char>.</note> <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Pàgir mala banì-mwashat-aɓa-lum mǝnana amǝ Isǝrayila kǝ yinǝi ace pàgir aban Yahweh ka, ǝn pania wia ɓǝ̀ duk gìr liɓala malea. Acemani ka, ǝn banggia wia nǝma à pànǝ kǝ nzali ace liɓala atà amǝ Isǝrayila ɗàng.&gt;&gt;<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />Pǝlǝa Yahweh banggi Musa ama, <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />&lt;&lt;Nacau nǝ Amǝ'Lawi sǝ wu banggia wia ama: &lt;Lang wu angŋa banì-mwashat-aɓa-lum mala agirkuma a bu amǝ Isǝrayila, mana ǝn pana wuni ɓǝ̀ duk gir liɓala ma'wun ngga, dumǝna púp wun nǝ̀ pusǝ banì-mwashat-aɓa-lum male, wun nǝ̀ panagir nǝi aban Yahweh; mǝnia ka nda banì-mwashat-aɓa-lum mala banì-mwashat-aɓa-lum. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Mǝnia yì pàgir ma'wun ngga Yahweh nǝ̀ ɗenyinǝi kǝla weama pàgir na mǝnana puro arǝ aɓaban ma'wun, mala bǝsa mǝsǝsa mǝnana à nyé a katǝra, andǝ mala mùr-anap mana à kambi arǝ ɓǝle mǝbangŋe ka, sǝ nǝ̀ ɓwangsǝ wun aceì. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Acemani ka, dumǝna púp wun nǝ̀ yinǝ pàgir gbal aban Yahweh. Aɓa koya banì-mwashat-aɓa-lum mǝnana wu ak a bu amǝ Isǝrayila ka, wun nǝ̀ pusǝ kāmbe mǝnana nda ace pàgir aban Yahweh ka, wun nǝ̀ pè Haruna, yì pǝris. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Aɓa koya ɓoro mǝnana aɓwe pà wun ngga, dumǝna púp wun nǝ̀ pusǝ kāmbe mǝnana nda acem Yahweh ka; kāmbe nggea-mǝɓoarne mala komǝye ka, nda wun nǝ̀ tàrì acem Yahweh ka.&gt;<verse eid="NUM 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 18:30" />&lt;&lt;Banggi Amǝ'Lawi ama, &lt;Lang wu pana kāmbe nggea-mǝɓoarne mala banì-mwashat-aɓa-lum ngga, à nǝ̀ ɓwangsǝ wun, wun Amǝ'Lawi aceì, kǝla weama wu pusǝ aɓǝlagirì a katǝra andǝ ban-kam-anap. <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />Sǝ wun Amǝ'Lawi, andǝ amǝ'ɓala ma'wun ngga, wun nǝ̀ gandǝ li girline a koya ban mǝnana wu earce ka. Mǝnia ka, nda tangnakusǝ wun ace túró mana wu kǝ pa aɓa Tara Ban-peri ka. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />À pà nǝ̀ na ama, wu pàngŋǝ̀nà gìr mǝɓane nǝ twal banì-mwashat-aɓa-lum mala Yahweh ɗàng,<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 19:8">Pǝris 19:8</ref>; <ref loc="LEV 22:16">22:16</ref> </char>.</note> ɓǝ̀ wu pànî apǝris kāmbe nggea-mǝɓoarne malea ka. Sǝama, wu tsǝkir wun, wu kǝa nyesǝ apagir mǝfele mala amǝ Isǝrayila, kǝla gìr mǝkyauwe ɗàng. Ɓǝ̀ wu pàk anggo ka, wun nǝ̀ wǔ.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">18:32 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 22:2">Pǝris 22:2</ref>,<ref loc="LEV 22:15">15</ref></char>.</note><verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s">Anggurcau mala lakban arǝ je lú</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />Yahweh nacau nǝ Musa andǝ Haruna ama, <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />&lt;&lt;Mǝnia ka nda nê mala nggurcau mǝnana Yahweh tsǝk ka: Banggi amǝ Isǝrayila ɓǝà yinǝo nǝ muna-ndá mǝbangŋe, mǝnana pànǝ ɓekǝ doak arǝì ɗàng, pànǝ ɓekǝ gìr mǝɓane arǝì ɗàng, sǝ à malaká tsǝki wi nggun-rya a myali a kǝ fara raka. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Awu nǝ pè Eleaza, pǝris; sǝ yì ka nǝ̀ kánǝi anzǝm kàttì, sǝ à nǝ̀ pwanmeali a ɓadǝmbi. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Pǝlǝa Eleaza pǝris nǝ̀ ɗàrǝ́ aɓa nkile nǝ munabui, sǝ nǝ̀ watsǝki kusǝ tongno-nong-ɓari, nǝ njar ɓadǝm Tara Ban-peri. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Pǝlǝa à nǝ̀ pisǝ muna-ndá man a mǝsǝi; ngguí, andǝ nyami, andǝ nkile andǝ ciute ka, à nǝ̀ pisǝia a bǝsa. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Sǝ pǝris ka, nǝ̀ twal nggun-seda andǝ bondo-hisop andǝ bugir mǝbangŋe, sǝ nǝ̀ túriá aɓa bǝsa mǝnana muna-ndá kǝ pi aɓalǝi ka. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Pǝlǝa pǝris ka, dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo; anzǝm mǝno ka, nǝ̀ gandǝ kutio a kàttì, sǝ kat andǝ amani ka, nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />Sǝ ɓwa mana pisǝ mǝno yì muna-ndá ka, dumǝna púp yì gbal ka nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo; sǝ kat andǝ amani ka nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra.<verse eid="NUM 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9" />&lt;&lt;Ɓwa mǝnana mǝɓoarnsari na ka, nǝ̀ ram tú muna-ndá mǝnia ka, sǝ nǝ̀ soe a ban mǝɓoarnsari anzǝm kàttì. Nǝ̀ duk gir mǝnana ɓwabundǝa mala amǝ Isǝrayila nǝ̀ tsǝkce ka, ace mǝnana à nǝ̀ zurì a mùr ace lak ɓwa mǝnana kpa aɓa ɓeami ka. Pàgir na ace lak cauɓikea.<note caller="+" style="f"><char style="fr" closed="false">19:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 4">Pǝris 4</ref></char>.</note> <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Sǝ ɓwa mǝnana ram tú muna-ndá ka, dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ kat andǝ amani ka nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. Mǝnia ka, nǝ̀ duk nggurcau mǝnana málá male pà kàm raka aban amǝ Isǝrayila, sǝ aban amǝ'kúnɗàngna mana à do aɓalǝia ka.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />&lt;&lt;Ɓwa mǝnana je lú ɓwapǝndǝa ka, nǝ̀ duk mǝɓeami ba nongŋo tongno-nong-ɓari. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Yì ka, dumǝni wi púp nǝ̀ lak ɓamurì arǝ do-ɓeami male nǝ mùr a tàruia pwari andǝ tongno-nong-ɓaria pwari, sǝ nǝ̀ ɓoarnsari; sǝ ɓǝ̀ lak ɓamurì a tàruia pwari andǝ tongno-nong-ɓaria pwari raka, pà nǝ̀ ɓoarnsari ɗang. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Ɓwa mǝnana kat je rǝ ɓwa mǝnana wuna, sǝ lak rǝì raka, nǝ̀ tsǝk Taragula mala Yahweh nǝ̀ pǝndǝkya; sǝ mǝno yì ɓwa ka à nǝ̀ kasǝì a Isǝrayila. Yì ka, nǝ̀ ueo aɓa do-ɓeami acemǝnana à watsǝki wi mùr lakban amurí ɗàng. Do-ɓeami male ka nda arǝì piu.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />&lt;&lt;Mǝnia ka nda nggurcau mana à nǝ̀ kpate ɓǝ̀ ɓwa wǔ aɓa gumli ka: ɓwa mǝnana kat kútí aɓa gumli mǝnia andǝ koyan mǝnana kat nda aɓa gumli mǝnia ka, nǝ̀ pa aɓa do-ɓeami mala anongŋo tongno-nong-ɓari. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Sǝ koya kwár aɓa gumli mǝnia, mǝnana nda atarǝì, à kumsǝi wi gìrkúni raka, dumǝna mǝɓeami.<verse eid="NUM 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 19:16" />&lt;&lt;Sǝ ɓwa mana kat, nda a ɓawanban, sǝ je rǝ ɓwa mana à wal-luí nǝ nggeabyau, ko mǝnana wǔ atarǝì ka, ko je mǔ ɓwapǝndǝa, ko ɓembe ka, nǝ̀ pà aɓa do-ɓeami mala anongŋo tongno-nong-ɓari.<verse eid="NUM 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17" />&lt;&lt;Ace lak ɓwa mǝnana mǝɓeami na ka, à nǝ̀ ɗàrǝ́ aɓa tú mala pàgir ace gǝshi cauɓikea, mǝnana à pisǝì kǝring ngga, à nǝ̀ soé a dù, sǝ à nǝ̀ soapi wi mùr mana kǝ ɓang ngga amurí. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Ɓwa mǝnana mǝɓoarnsari na ka, nǝ̀ twal bondo-hisop, nǝ̀ oasǝi a mùrî, sǝ nǝ̀ watsǝki arǝ gumli mǝnia ɓwa wù kam ngga, sǝ arǝ agir mǝnana aɓalǝi ka, andǝ aɓwana mǝnana à ndakam ngga. Yì ɗǝm ngga, nǝ̀ watsǝki arǝ ɓwa mǝnana kat je mǔ ɓwapǝndǝa, ko ɓembe, ko je rǝ ɓwa mana wǔ atarǝì, ko ɓwa mana à wal-luí ka.<verse eid="NUM 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 19:19" />&lt;&lt;Sǝ ɓwa mǝnana mǝɓoarnsari na ka, nǝ̀ watsǝki ɓwa mana mǝɓeami na ka a tàruia pwari andǝ tongno-nong-ɓaria pwari; sǝ a tongno-nong-ɓaria pwari ka nǝ̀ lé arǝ do-ɓeami male. Sǝ ɓwa mǝnana à kǝ lé ka, dumǝna púp nǝ̀ lakki agir'nggūrǝì, sǝ nǝ̀ sussǝo, sǝ nǝ pwarikpǝra ka, nǝ̀ duk mǝɓoarnsari. <verse eid="NUM 19:19" /><verse number="20" style="v" sid="NUM 19:20" />Sǝama ɓǝ̀ ɓwa ka duk mǝɓeami, sǝ ɓinǝ lak rǝì arǝ do-ɓeami male ka, mǝno yì ɓwa ka à pà nǝ̀ eari wi ɓǝ̀ do aɓa ɓwabundǝa mala Isǝrayila ɗàng, acemǝnana pǝndǝkina Ban-mǝfele mala Yahweh.<note caller="+" style="f"><char style="fr" closed="false">19:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CO 6:19-20">1Kor 6:19-20</ref></char>.</note> Acemǝnana à watsǝki wi mùr lakban arǝ do-ɓeami amurí raka, mǝɓeami na. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Mǝnia ka, nǝ̀ duk nggurcau mǝnana málá male pà kàm raka acea. Sǝ ɓwa mǝnana watsǝkiyi mùr lakban ngga, dumǝna púp, yi gbal ka, nǝ̀ lakki agir'nggūrǝì, sǝ ɓwa mǝnana kat je mǝnia yì mùr lakban arǝ do-ɓeami ka, nǝ̀ ueo aɓa do-ɓeami ba pwarikpǝra. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Gìr mǝnana kat ɓwa mǝɓeami je ka, gìrnî nǝ̀ duk mǝɓeami; sǝ ɓwa mǝnana kat je gìrnî ka, nǝ̀ duk mǝɓeami ba pwarikpǝra.&gt;&gt;<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s">Mùr ɓùn aɓa tali</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Sǝ ɓwabundǝa mala amǝ Isǝrayila puppup yiu aɓa pǝɗanban Zin, a zongŋo mǝdǝmbe. Aɓwe yi tsǝk là-gumli a Kadesh. Miriyam paklú kano, sǝ à tsǝkluí kano.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />A ban mǝno ka mùr pà kàm ace ɓwabundǝa ɗàng; pǝlǝa à ram rǝia sǝ à mgbicau arǝ Musa, sǝ arǝ Haruna. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />Kún aɓwe ɓua arǝ Musa ama, &lt;&lt;Ɓǝ̀ sǝm wukina atà amǝ'eam sǝm a pwari mǝno à wuki a ɓadǝm Yahweh ka, ɓǝ́ nǝ̀ ɓoaribani! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Palang sǝ a yinǝ ɓwabundǝa mala Yahweh a ɓabondo man? A yinǝ sǝm ace mǝnana sǝm, sǝnǝ agirkusǝu ma'sǝm ngga, ɓǝ̀ sǝm yi wuki kani ka le? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Palang sǝ a pusǝ sǝm, sǝm purî nzali Masar? A pusǝ sǝm ace yinǝ sǝm a ban mǝɓike mǝnia ka le? Ban mǝnana kǝ mǝsǝsa, ko nggun-bwari, ko nggun-anap, ko nggun-mɓǝring pà kàm ɗàng, sǝ kǝ mùr pà kàm mana sǝm nǝ̀ nu ka raka!&gt;&gt;<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />Pǝlǝa Musa andǝ Haruna, nying ɓadǝm ɓwabundǝa, à yiu a bankutio aɓa Tara Ban-peri, sǝ à kpa, nǝ ɓamǝsǝia a nzali. Kara ɓoarɓwa mala Yahweh pusǝrǝi abania. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />Yahweh banggi Musa ama, <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />&lt;&lt;Twal garè<note caller="+" style="f"><char style="fr" closed="false">20:8 </char><char style="fq" closed="false">garè </char><char style="ft" closed="false">ko &lt;&lt;gara mala mǝ'eambo Haruna.&gt;&gt;</char></note> a buo, sǝ we wunǝ mǝ'eambo Haruna ka, wu ram ɓwabundǝa, sǝ wu ne tali mǝno cau a mǝsǝia, ɓǝ̀ pusǝ mùr male ɓǝ̀ solǝo. Anggo sǝ awu nǝ pusǝia wia mùr nǝ ɓá talinì, sǝ awu nǝ pè ɓwabundǝa andǝ agirkusǝu malea mùr ɓǝà nǔ.&gt;&gt;<verse eid="NUM 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 20:9" />Anggo, sǝ Musa twal garè a ɓadǝm Yahweh, kǝla mana banggi wi ka. <verse eid="NUM 20:9" /><verse number="10" style="v" sid="NUM 20:10" />Yì andǝ Haruna ka à ram ɓwabundǝa a banɓwáná a ɓadǝm talinì, sǝ Musa banggia wia ama, &lt;&lt;Wu kwaki kir wun ado, wun amǝ'mgbicau! Dumǝna púp ama sǝm nǝ̀ pusǝa wun mùr aɓa tali mǝnia ka le?&gt;&gt; <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />Pǝlǝa Musa loasǝ bui, wal talinì nǝ gara male kusǝ ɓari. Kara mùr pur aɓalǝi kpǝm, sǝ ɓwabundǝa andǝ agirkusǝu malea nǔ.<verse eid="NUM 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12" />Sǝama, Yahweh banggi Musa andǝ Haruna ama, &lt;&lt;Acemǝnana wu earnǝ mim, mǝnana wun nǝ̀ pam gulo kǝla mǝfele aɓadǝm amǝ Isǝrayila raka, pà wu nǝ̀ kánǝ ɓwabundǝa mǝnia a nzali mǝnana ǝn pania wia ka ɗàng.&gt;&gt; <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />Mùr mǝno ka à tunǝi ama mùr mala Meriba,<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="fq" closed="false">Meriba </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;kúnɓuana.&gt;&gt;</char></note> acemǝnana nda ban mǝnana kún amǝ Isǝrayila ɓua arǝ Yahweh kam ngga, sǝ yì ka lǝmdǝ ɓamurì mǝfele na aɓalǝia.<verse eid="NUM 20:13" /></para>
  <para style="s">Edom ginǝ nyinggi Isǝrayila njar ɓǝ̀ kutio</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />Pǝlǝa Musa tasǝ amǝ'na-túrbân, à lo a Kadesh aban ká aban murǝm Edom nǝ cau ama: &lt;&lt;Mǝnia ka, nda cau mǝnana mǝ'eambo Isǝrayila kǝ bang ngga: A súrǝ́nà rǝ gir mana kat kum sǝm, yì tanni mǝnana yiu amur sǝm, <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />lang aká sǝm sulǝo, à wari a nzali Masar, sǝ sǝm duk kano arǝ apǝlǝa pas, sǝ amǝ Masar pakka sǝm mǝɓike, sǝm sǝnǝ atár sǝm andǝ aká sǝm ngga. <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />Sǝama, lang sǝm yinǝ ɓua ma'sǝm aban Yahweh ka, yi ka, ok gì sǝm, pǝlǝa tasǝ mǝturonjar, mana yi pusǝ sǝm aɓa nzali Masar ka. Adyan ngga, sǝm ndya a Kadesh, yì là mǝnana a nzong-nzali mô ka. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Ida, ɗeki sǝm, ɓǝ̀ sǝm kùtí nǝɓa nzali mô. Pà sǝm nǝ̀ kùtí a ɓaban-mǝssa ko ɓaban-anap ɗàng; yale pà sǝm nǝ̀ nu mùr a kǝ tūli-mùr ɗàng. Sǝm nǝ̀ ging cat amur njar-mǝgule mala murǝm, aban o; pà sǝm nǝ̀ kyang a bu-mǝli ko bu-mǝnggare ɗàng, sheɓǝ̀ sǝm kya kutina, sǝm purni bu-nzali mô ka.&gt;&gt;<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />Sǝama, Edom pe wi eare ama, &lt;&lt;Pà wun nǝ̀ kùtí aɓa nzali man ɗang, sǝ ɓǝ̀ wu ɓinǝ ama wun nǝ̀ kùtí kani ka, mǝ nǝ kánǝ amǝ'lwa mem arǝ wun.&gt;&gt;<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />Amǝ Isǝrayila eari wi ama, &lt;&lt;Sǝm ngga, sǝm nǝ̀ o cat amur njargula-mǝgule, sǝ ɓǝ̀ sǝm, ko agirkusǝu ma'sǝm nu mùr ma'wun ngga, sǝm nǝ̀ mbwe boale. Eara sǝm, kutio na nǝmurǝì sǝm nǝ̀ kùtí ka, nǝ kusǝ sǝm; pà sǝm nǝ̀ pak ɓekǝ gir mana nda ɗàng ngga ɗàng, ko bǝti.&gt;&gt;<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />Murǝm Edom nyesǝ cau ama, &lt;&lt;Pà wun nǝ̀ kùtí kani ɗang.&gt;&gt; Pǝlǝa pur nǝ akanggǝrang amǝ'lwa pas nǝ agirbura mǝcandǝe a buia, ace kánǝ munǝo arǝ amǝ Isǝrayila. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />Anggo sǝ Edom ɓinǝ nyinggi Isǝrayila njar ɓǝ̀ kùtí nǝɓa bu-nzali male; nda Isǝrayila wulimúrí, nying kutio nǝɓa nzalinì ka.<verse eid="NUM 20:21" /></para>
  <para style="s">Lú mala Haruna</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Pǝlǝa ɓwabundǝa mala amǝ Isǝrayila puppup loapi Kadesh sǝ à twal gya, à yiu a Nkono Hor. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />Yahweh nacau nǝ Musa andǝ Haruna a Nkono Hor, a nzong-nzali Edom, ama, <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />&lt;&lt;Haruna ka ndo nǝ̀ o atà aɓwana male. Pà nǝ̀ kùtí a nzali mana ǝn nggǝ pè amǝ Isǝrayila ka ɗàng, acemǝnana wun kǝm ngga, wu okam ɗàng, wu kpata zongcau mem a ban mur Meriba ɗàng. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Twal Haruna andǝ muna-ɓwabura male, Eleaza, wu eau wunǝia, amur Nkono Hor. <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />Akano ka swárì Haruna adaura-pǝris male, sǝ wu oasǝia arǝ muna-ɓwabura male, Eleaza. Haruna ka nǝ̀ o atà aɓwana male; nǝ̀ nggá wǔ kano.&gt;&gt;<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />Nda Musa pa, kǝla mǝnana Yahweh banggi wi ka. À eauwe amur Nkono Hor, a mǝsǝ ɓwabundǝa kat. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />Musa pǝlǝa swárì Haruna adaura-pǝris male, sǝ oasǝì Eleaza, muna-ɓwabura male. Sǝ Haruna paklú kano a ɓong nkono. Pǝlǝa Musa andǝ Eleaza sulǝî mur nkono. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Lang ɓwabundǝa sǝni ama Haruna wuna ka, ɓala mala Isǝrayila kat, pak anonggio lumi-tàrú aban ɓua-luí.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s">À gandǝ murǝm Arat a lwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Lang ɓwa Kan'ana, murǝm Arat, mana ndanǝdo a Negev, ok ama, amǝ Isǝrayila na aban yiu nǝ njargula Atarim ngga, kara yinǝ munǝo arǝia, bwalki aɓea ɓwana atà amǝ Isǝrayila. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Pǝlǝa amǝ Isǝrayila pàcau nǝ-shambum aban Yahweh, ama, &lt;&lt;Ɓǝ̀ mbak-kàngkàng awu nǝ tsǝk aɓwana mǝnia ɓǝà kpa aɓa bù sǝm ngga, sǝm nǝ̀ tària aban Yahweh ace twalta alá malea kat-kat.&gt;&gt;<verse eid="NUM 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 21:3" />Yahweh ok zǝmba mala amǝ Isǝrayila, pǝlǝa pà amǝ'Kan'ana aɓata rǝcandǝa malea, sǝ à twaltea kat, à kiɗiki alá malea. À tunǝ lullǝ banì ama, Horma.<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fq" closed="false">Horma </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;mǝnana à kiɗiki ka.&gt;&gt;</char></note><verse eid="NUM 21:3" /></para>
  <para style="s">N'yau mana à pè nǝ bolo-bángŋá ka</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Pǝlǝa à lo gya, twal a Nkono Hor, nǝ njargula mala Nggeamùr Nzuno, à kàrìban arǝ nzong-nzali mala amǝ'Edom. Sǝama, aɓwe gandǝ twalgàndǝá nǝ gyê ɗàng. <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />À na mǝɓane arǝ Ɓakuli andǝ Musa, ama, &lt;&lt;Palang sǝ a pusǝ sǝm a nzali Masar, ace mǝnana ɓǝ̀ sǝm yi wukio a ɓabondo ka? Girlina pa kàm ɗàng! Mùr pà kàm ɗàng! Sǝ sǝm aulǝna nǝ girlina mǝɓike man!&gt;&gt;<verse eid="NUM 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6" />Pǝlǝa Yahweh tasǝ an'yau barya aɓalǝ aɓwe; an'yau kwarkia, gandǝa pas atà amǝ Isǝrayila wukio. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Nda aɓwe yiu aban Musa, sǝ à bang ama, &lt;&lt;Sǝm pangŋa cauɓikea, mǝnana sǝm na mǝɓane amur Yahweh, sǝ sǝm na mǝɓane amuro ka. Pàk hiwi aban Yahweh ama ɓǝ̀ pǝr an'yau mǝnia ka, ɓǝà upiban sǝm.&gt;&gt; Anggo, sǝ Musa pàk hiwi ace aɓwe.<verse eid="NUM 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8" />Yahweh pǝlǝa banggi Musa, ama, &lt;&lt;Pàk ɓǝ̀nzál mala n'yau barya, sǝ wu loasǝi a kuli, amur tondong. Ɓwa mǝnana kat n'yau kwarí, sǝ loasǝ mǝsǝi, sǝni ka, nǝ̀ auwa.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="2KI 18:4">2Amur 18:4</ref>; <ref loc="JHN 3:14-15">Yoh 3:14-15</ref></char>.</note> <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />Anggo sǝ Musa pàk n'yau nǝ bolo-bángŋá, pǝlǝa tsǝì amur tondong, sǝ loasǝi tamsǝi. Ɓǝ̀ n'yau kwarna kǝɓwa, sǝ lang loasǝ mǝsǝi sǝn n'yau mala bolo-bángŋá man ngga, ɓwê nǝ̀ auwa.<verse eid="NUM 21:9" /></para>
  <para style="s">Gya mala amǝ Isǝrayila aban ká a Mowap</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Amǝ Isǝrayila lo gya à yi tsǝk kàttì a Obot. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />À loapi Obot ka, à kya tsǝk kàttì a Iye-abarim, a ɓabondo mana kǝ sǝn ɓamǝsǝarǝia andǝ Mowap, nǝ njar-takuli ka. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />À loapi ban mǝno ka, à yi tsǝk kàttì a Ɓangŋaban Zeret. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />À loapi ban mǝno ka, à lo gya à kya tsǝk kàttì a ɓè nkaring mala Nggeasala Arnon, mana nda a ɓabondo mǝnana pur nǝ nzong-nzali mala amǝ'Amor ka. Nggeasala Arnon ngga nda a nzong-nzali mala Mowap, a nre Mowap andǝ nzali Amor. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Nda gìr mǝnana tsǝa sǝ Malǝmce mala A'lwa mala Yahweh, bang ama,</para>
  <para style="q1" vid="NUM 21:14">&lt;&lt;Wahep aɓa Sufa, andǝ amuna-mùr mala Nggeasala Arnon,<verse eid="NUM 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 21:15" />andǝ bum aɓangŋaban mǝnana sárǝ́ aban ká a là Ar,</para>
  <para style="q1" vid="NUM 21:15">sǝ eangnǝ arǝ nzong-nzali Mowap ka.&gt;&gt;<verse eid="NUM 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />Twal a ban mǝno ka, à lidǝmba, aban ká Biya,<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="fq" closed="false">Biya </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;tūli-mùr.&gt;&gt;</char></note> yì tūli-mùr mǝnana Yahweh banggi Musa cau amurí, ama, &lt;&lt;Ramba aɓwana abanɓwáná, ace mǝnana ɓǝn pea wia mùr ka.&gt;&gt;<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />Pǝlǝa amǝ Isǝrayila tù mǝnia yì nggyal ka, ama:</para>
  <para style="q1" vid="NUM 21:17">&lt;&lt;Tù mùr, we tūli-mùr!</para>
  <para style="q1" vid="NUM 21:17">Tùkî wi nggyal,<verse eid="NUM 21:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="NUM 21:18" />yì tūli-mùr mǝnana amǝgulo tǝmi ka;</para>
  <para style="q2" vid="NUM 21:18">mǝnana aɓwana-mǝgule mala aɓwana busǝlǝi</para>
  <para style="q2" vid="NUM 21:18">nǝ gara-gulo andǝ agara-gya malea ka.&gt;&gt;</para>
  <para style="p" vid="NUM 21:18">Pǝlǝa à nying ɓabondo mǝno à o a Matana. <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />À nying Matana ka, à o a Nahaliyel. À nying Nahaliyel ka, à o a Bamot. <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />À nying Bamot ka, à o a ɓangŋaban mǝnana nda aɓa nzali Mowap, tù a ban amgbangban Pisga, mǝnana à cam ɓong-ɓong amur pǝɗanban ngga.<verse eid="NUM 21:20" /></para>
  <para style="s">Limurǝm amur Sihon andǝ Og</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Isǝrayila tasǝ amǝ'na-túrbân ɓǝà kya ne Sihon, murǝm mala amǝ'Amor,<note caller="+" style="f"><char style="fr" closed="false">21:21 </char><char style="fq" closed="false">Sihon, murǝm mala amǝ'Amor: </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 32:33">Ɓal 32:33</ref>; <ref loc="DEU 1:4">Nggur 1:4</ref>; <ref loc="DEU 2:24-4:46">2:24--4:46</ref> </char>.</note> ama, <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />&lt;&lt;Eara sǝm ɓǝ̀ sǝm kùtí nǝɓa nzali mô. Pà sǝm nǝ̀ kùtí a ɓaban-mǝssa ko ɓaban-anap ɗàng. Pà sǝm nǝ̀ nu mùr a kǝ tūli-mùr ɗàng. Sǝm nǝ̀ ging cat, amur njar-mǝgule mala murǝm, ba purî ɓá nzali mô.&gt;&gt;<verse eid="NUM 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23" />Sǝama, Sihon eare ɓǝ̀ Isǝrayila kùtí aɓa nzali male ɗàng. A kún mani ka, ramba amǝ'lwa male puppup, sǝ à puro à nǝ̀ ká nǝ munǝo arǝ Isǝrayila aɓa pǝɗanban. Lang à yina a Jahaz ka, à soa munǝo arǝ amǝ Isǝrayila. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Amǝ Isǝrayila gandǝia nǝ kún nggeabyau, sǝ à ak nzali malea arǝia, twal a ban Nggeasala Arnon kya bik Nggeasala Jabok, sǝama à kya go a nzong-nzali mala amǝ'Amon; acemǝnana nzong-nzali mala amǝ'Amon ngga mǝcandǝe na. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Isǝrayila ak alá mala amǝ'Amor kat, sǝ duk kam aɓalǝia, kat andǝ nggea-là Heshbon, andǝ amuna-là mǝnana à nda aɓate ka.<verse eid="NUM 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 21:26" />Heshbon ngga, nda nggea-là mala Sihon, murǝm mala amǝ'Amor, mana ɗiɗyal munǝo andǝ murǝm Mowap, sǝ ak nzali male arǝì kat, kya bwal ban Nggeasala Arnon ngga.<verse eid="NUM 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27" />Nda gìr mǝnana tsǝa, sǝ amǝ'nggyal bang ama,</para>
  <para style="q1" vid="NUM 21:27">&lt;&lt;Yiu a Heshbon, ace mǝnana ɓǝà ɓè ka;</para>
  <para style="q1" vid="NUM 21:27">nggea-là mala Sihon ngga ɓǝà ɓè, kusǝì ɓǝ̀ cam kàngkàng.<verse eid="NUM 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />Bǝsa pur aɓa Heshbon,</para>
  <para style="q1" vid="NUM 21:28">lasǝ-bǝsa pur a nggea-là mala Sihon.</para>
  <para style="q1" vid="NUM 21:28">Bǝshe yi li Ar, là mala nzali Mowap,</para>
  <para style="q1" vid="NUM 21:28">yi twalta amǝtala amgbangban ndàka-lú a kún nggeasala Arnon.<verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />Caukwanban nǝ we Mowap!</para>
  <para style="q1" vid="NUM 21:29">Ma'wun malna, wun aɓwana mala Kemosh!</para>
  <para style="q1" vid="NUM 21:29">Kemosh pànà amuna-burana male ɓǝà umnǝia a bǝri-nzali,</para>
  <para style="q1" vid="NUM 21:29">sǝ amuna-mamǝna male ka à umna nǝia a guro</para>
  <para style="q1" vid="NUM 21:29">aban murǝm Sihon ɓwa Amor.<verse eid="NUM 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />Sǝm gandǝna Mowap kat-kat;</para>
  <para style="q1" vid="NUM 21:30">Heshbon ngga, à kiɗikini yi pur a Dibon.</para>
  <para style="q1" vid="NUM 21:30">Sǝm yinǝ kiɗikiban arǝì yi pur a Nofa,</para>
  <para style="q1" vid="NUM 21:30">mǝnana kya go a Medeba ka.&gt;&gt;<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Nda Isǝrayila do a nzali mala amǝ'Amor ka. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Anzǝm mana Musa tasǝna amǝ'shenzǝban a Jaza ka, amǝ Isǝrayila kya aki amuna-là mǝnana à kàrìbanì ka, sǝ à pǝr amǝ'Amor mana à duk kam ngga.<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />Pǝlǝa amǝ Isǝrayila wulio, à um nǝ njargula ká Bashan, sǝ Og, murǝm Bashan, andǝ amǝ'lwa male puppup, wari nǝ munǝo arǝia a Edǝri.<verse eid="NUM 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 21:34" />Yahweh banggi Musa ama, &lt;&lt;Kǝa ɓanggi wi ɗàng, acemana ǝn pano wi, yì andǝ aɓwana male kat, andǝ nzali male. Pàkki wi kǝla mana a pakkì Sihon, murǝm mala amǝ'Amor ka, mana do a Heshbon ngga.&gt;&gt;<verse eid="NUM 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 21:35" />Anggo sǝ à wal-luí, yì andǝ amuna-burana male, andǝ aɓwana male kat, yale kǝɓwa au ateà ɗàng, sǝ amǝ Isǝrayila ak nzali male pǝlǝ malea.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s">Balak túrban atà Bil'am</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Pǝlǝa amǝ Isǝrayila gya, à wario à kya tsǝk kàttì a ɓawanban mala Mowap, a nkanggari Nggeasala Jodan a nkaring mala Jeriko. <verse eid="NUM 22:1" /><verse number="2" style="v" sid="NUM 22:2" />Balak<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="fq" closed="false">Balak: </char><char style="ft" closed="false">Ɓal cau male aɓa: </char><char style="xt"><ref loc="JOS 24:9-10">Jes 24:9-10</ref>; <ref loc="JDG 11:25">Akas 11:25</ref>; <ref loc="MIC 6:5">Mik 6:5</ref>; <ref loc="REV 2:14">Sǝn 2:14</ref></char>.</note> murǝm mala amǝ'Mowap, muna-ɓwabura mala Zippor, sǝn gìr mǝnana kat Isǝrayila pàkkî amǝ'Amor ka.<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 4:46">Nggur 4:46</ref>; <ref loc="JOS 10:12">Jes 10:12</ref></char>. </note> <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Sǝ amǝ'Mowap ka, nggea ǝn'o bwalia arǝ amǝ Isǝrayila acemǝnana à làkkì kǝ̀rkǝ́r. Amǝ'Mowap ka à lùmsǝ nǝ ɓangciu atàcau mala amǝ Isǝrayila. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />Nda amǝ'Mowap banggi aɓwana-mǝgule mala amǝ Midiyan ama, &lt;&lt;Nggea ɓwabundǝa mǝnia ka à nǝ̀ ya mal sǝm kǝla mana jamnda kǝ murǝ bondo ɓá garang ngga.&gt;&gt;</para>
  <para style="p" vid="NUM 22:4">Sǝ Balak, muna-ɓwabura mala Zippor, mǝnana nda murǝm Mowap a nza mǝno ka, <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />tasǝ amǝ'na-túrbân, aban Bil'am,<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="fq" closed="false">Bil'am: </char><char style="ft" closed="false">Ɓal cau male aɓa: </char><char style="xt" closed="false"><ref loc="DEU 23:3-5">Nggur 23:3-5</ref>; <ref loc="JOS 24:9-10">Jes 24:9-10</ref>; <ref loc="MIC 6:5">Mik 6:5</ref>; <ref loc="2PE 2:15-16">2Bit 2:15-16</ref>; <ref loc="JUD 1:11">Yahu 11</ref>; <ref loc="REV 2:14">Sǝn 2:14</ref></char></note> muna-ɓwabura mala Beyo, mǝnana ndanǝdo a Peto, a kún Nggeasala a nzali mala aɓwana male ka, ama ɓǝà tunǝi ɓǝ̀ yiu, nǝ cau ama, &lt;&lt;Sǝni, aɓwana mala ɓè kûn nya à yiu, mana à purî ɓá Masar ka; à aki múr nzali kat, sǝ ndya à do a nkanggariam ngga. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Yiu adyan, ida sukàm amǝnia yì aɓwana ka, acemǝnana rǝcandǝa malea kútì mem kǝ̀rkǝ́r. Yakǝla, mǝ nǝ gandǝ limurǝm amúrià sǝ mǝ nǝ pǝria, ɓǝà upi nzali man. Mǝnia ka nda acemǝnana, ǝn sǝlǝna nǝma, aɓwana mana kat a tsǝkbuo amúrià ka, à kumǝna tsǝkbu, sǝ aɓwana mǝnana kat a suia ka, suban dumǝna amúrià.&gt;&gt;<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />Nda aɓwana-mǝgule mala amǝ'Mowap, andǝ amala amǝ Midiyan lo, sǝ à bwal-njar aban ká, nǝ boalo a buia, mana à nǝ̀ nggá mbwena Bil'am nǝi ace túró ɓangnǝ-ɓangnǝa male ka. Lang à yina aban Bil'am ngga, à banggi wi cau mǝnana Balak bang ngga.<verse eid="NUM 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 22:8" />Sǝ Bil'am bang ama, &lt;&lt;Wu nong kani yalung, mǝ nǝ yia na wun cau mana Yahweh nǝ̀ banggam ngga.&gt;&gt; Anggo sǝ amǝnia yì amǝgulo mala Mowap ka, à ueo atà Bil'am.<verse eid="NUM 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9" />Pǝlǝa Ɓakuli yiu aban Bil'am, sǝ ɗì ama, &lt;&lt;Ayana nda ka aburana mǝnia atò ka?&gt;&gt; <verse eid="NUM 22:9" /><verse number="10" style="v" sid="NUM 22:10" />Bil'am banggi Ɓakuli ama, &lt;&lt;Balak, muna-ɓwabura mala Zippor, murǝm Mowap, nda tasǝia abanam nǝ mǝnia yì cau ka, ama, <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />&lt;Sǝni, aɓwana mala ɓè kûn nya à yiu, mana à purî ɓá Masar ka; à aki múr nzali kat. Yiu adyan, tsǝkam suban amúrià. Yakǝla, mǝ nǝ gandǝia a lwa sǝ mǝ nǝ pǝria ɓǝà puro.&gt; &gt;&gt;<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />Sǝ Ɓakuli banggi Bil'am ama, &lt;&lt;Kǝa na ama, awu nǝ ká ateà ɗàng; sǝ a pà nǝ súka aɓwana mǝnia ɗàng, acemǝnana à ndanǝ tsǝkbu mem amúrià.&gt;&gt;<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />Ban fana ka, Bil'am lo, sǝ banggi amǝgulo mala Balak ama, &lt;&lt;Wu nyare a nzali ma'wun, acemǝnana Yahweh ɓinǝna, ama mǝ nggá ká atà wun ɗàng.&gt;&gt;<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />Nda amǝgulo mala Mowap lo à nyare aban Balak, sǝ à banggi wi ama, &lt;&lt;Bil'am, ɓinǝna yiu atà sǝm.&gt;&gt;<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Balak tasǝ amǝgulo ɗǝm, mǝnana à kútì amana à wari a tadǝmbe ka nǝ lakkì andǝ gulo ka. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />À wari aban Bil'am, sǝ à ne wi ama, &lt;&lt;Mǝnia ka nda cau mǝnana Balak, muna-ɓwabura mala Zippor bang ngga: &lt;Ida, kǝa eare kǝgìr ɓǝ̀ tàmsǝo arǝ yiu abanam ɗàng; <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />nda acemǝnana mǝ nǝ loasǝo wu kum gulo kǝ̀rkǝ́r, sǝ gìr mǝnana kat awu nǝ banggam ngga mǝ nǝ pè. Yiu, sukàm amǝnia yì aɓwana ka.&gt; &gt;&gt;<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />Sǝama Bil'am nyesǝcau sǝ banggi amǝtúró mala Balak ama, &lt;&lt;Ko ɓǝ̀ Balak nǝ̀ pam palta male, lumsǝ nǝ bolo-azǝrfa andǝ bolo-njengǝlan ngga, pà mǝ nǝ pàk ɓè kǝgir mǝgule ko mǝkyauwe, mana nda ɗàng'andǝ nzongcau mala Yahweh, Ɓakuli mem ngga ɗàng. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Acemani ka, ida, wu nong kani, kǝla mana aɓwana mǝnana à yiu a dǝmbe, à pàk ka, ace mǝnana mǝ súrǝ̀ mana ɗǝm Yahweh nǝ̀ banggam.&gt;&gt;<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />Ɓakuli yiu aban Bil'am sǝ banggi wi ama, &lt;&lt;Acemǝnana aburana man yina ace tunǝo ka, lo kyan wunǝia. Sǝama, shekǝ gìr mǝnana ǝn banggo ka nda awu nǝ pàk ka.&gt;&gt;<verse eid="NUM 22:20" /></para>
  <para style="s">Bil'am andǝ mǝdambǝriso male</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Pǝlǝa Bil'am, lo nǝ dǝmbari, tsǝk gìr-do-anzǝm mǝdambǝriso male, sǝ o andǝ amǝgulo mala Mowap. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Sǝ Ɓakuli ka, bumi lul kǝ̀rkǝ́r, acemǝnana Bil'am na rǝ ká ka, nda sǝ mǝturonjar mala Yahweh, yi came a njar ace mǝnana nǝ̀ ɓinǝi wi ka. Bil'am ngga, nda a nzǝm mǝdambǝriso male aban ká, sǝ amǝ'túró-ɓala male ɓari na atè.<verse eid="NUM 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 22:23" />Lang mǝdambǝriso sǝn mǝturonjar mala Yahweh aban came a njar nǝ nggeabyau mana kwetǝnì, a bui ka, kara kyanggî njar kútí a bondo. Bil'am wal mǝdambǝriso, ace mǝnana nǝ̀ tsǝì ɓǝ̀ nyar amur njar ka.<verse eid="NUM 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24" />Pǝlǝa mǝturonjar mala Yahweh wario kya came amur njar mǝɓweari a nre ka aɓaban-anap ɓari, nǝ sheran tali a koya buì. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Lang mǝdambǝriso sǝn mǝturonjar mala Yahweh ka, nggiki rǝì arǝ sheran, gandǝa gosǝ kusǝ Bil'am arǝ sheran. Sǝ Bil'am wal mǝdambǝriso ɗǝm. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" />Pǝlǝa mǝturonjar mala Yahweh o a dǝmba amur njar, sǝ kya came a ban mana nda ɓwear, mǝnana kǝ ban pǝlǝa pà kàm ko a bu-mǝli ko a bu-mǝnggare raka.<verse eid="NUM 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 22:27" />Lang mǝdambǝriso sǝn mǝturonjar mala Yahweh ka, kara nong a nzali aɓata Bil'am. Sǝ yì ka, bumi lúllô, wal mǝdambǝriso nǝ gara male. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Pǝlǝa Yahweh mǝn kún mǝdambǝriso, sǝ mǝdambǝriso banggi Bil'am cau, ama, &lt;&lt;Mana ǝn pakko, mana tsǝa sǝ a walam kusǝ tàrú mǝnia ka?&gt;&gt;<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />Bil'am, pǝlǝa pè mǝdambǝriso eare ama, &lt;&lt;Nda acemǝnana a ɓangginǝ mim ngga! Ɓǝ̀ mǝ ndanǝ nggeabyau a buam ngga, mǝ nǝ wal-luio ado!&gt;&gt;<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />Pǝlǝa mǝdambǝriso banggi Bil'am ama, &lt;&lt;Mǝ nda mǝdambǝriso mǝnana a kwakiyi a do mô kat ba yalung ngga re? Mǝ ndanǝ ɓealu mala pàkkô ani le?&gt;&gt;</para>
  <para style="p" vid="NUM 22:30">Pǝlǝa Bil'am ne wi ama, &lt;&lt;Awo.&gt;&gt;<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />Pǝlǝa Yahweh mǝn amǝsǝ Bil'am, sǝ sǝn mǝturonjar mala Yahweh aban came amur njar, nǝ nggeabyau male, mana kwetǝnì ka, a bui. Bil'am pǝlǝa ti múrí, sǝ ɓunno, nǝ ɓamǝsǝi a nzali.<verse eid="NUM 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 22:32" />Pǝlǝa mǝturonjar mala Yahweh ɗi ama, &lt;&lt;Ace mana sǝ a wal mǝdambǝriso mò kusǝ tàrú mǝnia? Sǝni, ǝn yipo kǝla ɓimǝbura, acemǝnana ká mo mǝnia ka, mǝɓike na abanam. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Mǝdambǝriso sǝnam, sǝ kyanggam kusǝ tàrú mǝnia ka. Ɓǝ̀ mǝdambǝriso kyangmam raka, mǝsǝcau, ɓǝ́ ado ka ǝn walǝna-luio, sǝ ǝn amsǝna yilǝmi.&gt;&gt;<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />Bil'am banggi mǝturonjar mala Yahweh ama, &lt;&lt;Ən pangŋa cauɓikea. Acemǝnana ǝn sǝlǝa nǝma a nda ban came a njar, ace ɓinǝàm ɗàng. Sǝ adyan ngga, ɓǝ̀ mǝnia yì gìr ka pwasǝbumo raka, mǝ nǝ nyare.&gt;&gt;<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />Pǝlǝa mǝturonjar mala Yahweh, banggi Bil'am ama, &lt;&lt;Kyan wunǝ aburane, sǝama, kǝ cau mǝnana ǝn banggo ka, nda awu nǝ na ka.&gt;&gt;</para>
  <para style="p" vid="NUM 22:35">Nda Bil'am kutio wario andǝ amǝgulo mala Balak ka. <figure style="fig" alt="Angel apperard to Balaam" file="CO00868B.TIF" size="col" loc="22:35" copy="Cook OT" ref="22:31-35">Mǝturonjar pusǝrǝi aban Bilʻam</figure><verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />Lang Balak ok ama, Bil'am na aban yiu ka, puro ace mǝnana nǝ̀ nggá kullì a nggea-là mala amǝ'Mowap a kún Nggeasala Arnon mǝnana nda a nzong-nzali male ka.<verse eid="NUM 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 22:37" />Balak, pǝlǝa banggi Bil'am ama, &lt;&lt;Ən túrban atò tsuk-tsuk nǝma ɓǝà tunǝo re? Palang sǝ a ɓinǝ yiu abanam? Mbak-kàngkàng, mim ngga, pa mǝ nǝ gandǝ loasǝo wu kum gulo re?&gt;&gt;<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />Sǝ Bil'am nyesǝi wi ama, &lt;&lt;Ndya ǝn yiu a bano ka! Sǝama, mǝ ndanǝ rǝcandǝa mala na kǝ cau mǝnana mǝ nǝ gandǝ ne ka le? Dumǝna púp, cau mǝnana Ɓakuli nǝ̀ tsǝkam a kunam ngga, nda mǝ nǝ na ka.&gt;&gt;<verse eid="NUM 22:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 22:39" />Pǝlǝa Bil'am wari atà Balak, a Kiriyat Huzot.<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="fq" closed="false">Kiriyat Huzot </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;nggea-là mala anjar-mǝgule.&gt;&gt;</char></note><verse eid="NUM 22:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 22:40" />Sǝ Balak pà gir'nkila nǝ andá, andǝ anzur, sǝ aɓea ka, pè Bil'am andǝ amǝgulo mana à nda atè ka.<verse eid="NUM 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />Ban fana, nǝ dǝmbari ka, Balak twal Bil'am sǝ à eauwe andǝi a Bamot Ba'al.<note caller="+" style="f"><char style="fr" closed="false">22:41 </char><char style="fq" closed="false">Bamot Ba'al </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;Amgbangban ndàka-lú mala Ba'al.&gt;&gt;</char></note> Akano sǝ sǝn bare amǝ Isǝrayila.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s">Bil'am tsǝki Isǝrayila bù</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Bil'am pǝlǝa bang ama, &lt;&lt;Ɓakkam agyangŋan tongno-nong-ɓari kani; yinǝam nǝ ajamnda tongno-nong-ɓari, andǝ agam tongno-nong-ɓari, sǝ wu gilikiamia.&gt;&gt;<verse eid="NUM 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 23:2" />Balak pa kǝla mana Bil'am bang ngga; sǝ amur koya gyangŋan ngga, Balak andǝ Bil'am pàgir nǝ jamnda mwashat andǝ gam mwashat.<verse eid="NUM 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3" />Pǝlǝa Bil'am banggi Balak ama, &lt;&lt;Came a ban pàgir mala pisǝe kǝring mò, sǝ mǝ nǝ o. Yakǝla Yahweh nǝ̀ yiu abanam, sǝ gìr mǝnana kat lǝmdǝàm ngga, mǝ nǝ banggo.&gt;&gt; Pǝlǝa Bil'am o amur ɓè kpakan mgbangban.<verse eid="NUM 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 23:4" />Ɓakuli yiu aban Bil'am, sǝ Bil'am banggi wi ama, &lt;&lt;Ən gilikina agyangŋan tongno-nong-ɓari, sǝ amur koya gyangŋan ngga, ǝn panagir nǝ jamnda andǝ gam.&gt;&gt;<verse eid="NUM 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5" />Pǝlǝa Yahweh tsǝk cau a kun Bil'am, sǝ na ama, &lt;&lt;Nyare kya aban Balak, ne wi mǝnia yì cau ka.&gt;&gt;<verse eid="NUM 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 23:6" />Anggo, sǝ Bil'am nyare, wario kya kum Balak aban came a nkanggari pàgir mala pisǝe kǝring male, andǝ amǝgulo mala Mowap. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Sǝ Bil'am ar cau-pasǝlǝe male, ama:</para>
  <para style="q1" vid="NUM 23:7">&lt;&lt;Balak, murǝm Mowap yinǝ mim, ǝn pur a Aram</para>
  <para style="q2" vid="NUM 23:7">aɓalǝa ankono mǝnana nǝ takuli ka.</para>
  <para style="q1" vid="NUM 23:7">Banggam ama, &lt;Yiu, súam Yakupu,</para>
  <para style="q2" vid="NUM 23:7">yiu, na mǝɓike arǝ Isǝrayila!&gt;<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />Lang sǝ mǝ nǝ gandǝ sú ɓwa mǝnana Ɓakuli suí raka?</para>
  <para style="q2" vid="NUM 23:8">Lang sǝ mǝ nǝ gandǝ na mǝɓike arǝ ɓwa mǝnana Yahweh na mǝɓike arǝì raka?<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />A ɓong atali ǝn nggǝ sǝnia,</para>
  <para style="q2" vid="NUM 23:9">amur amgbangban ǝn nggǝ pelǝkia.</para>
  <para style="q1" vid="NUM 23:9">Ən nggǝ sǝn nggǝsanì aɓwana mana à tàr ɓamúrià,</para>
  <para style="q2" vid="NUM 23:9">sǝ à ɓal ɓamúrià aɓalǝ anzali raka.<verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />Yana nǝ̀ gandǝ ɓal tú-nzali mala Yakupu,</para>
  <para style="q2" vid="NUM 23:10">ko nǝ̀ súrǝ̀ inea bare làkkì mala Isǝrayila?</para>
  <para style="q1" vid="NUM 23:10">Ɗekiam ɓǝn wú, ulang lú mala mǝɓealɓoarna.</para>
  <para style="q2" vid="NUM 23:10">Ɓǝ̀ masǝlǝata do mem pǎ kǝla male!&gt;&gt;<verse eid="NUM 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />Pǝlǝa Balak banggi Bil'am ama, &lt;&lt;Mana mǝnia a pàkkam anggo ka? Ən twalo ace mǝnana wu sú aɓiam-mǝbura, sǝ ndya, yale tsǝkbu na a tsǝkia wia ka!&gt;&gt;<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />Pǝlǝa Bil'am, pa eare ama, &lt;&lt;Gìr mǝnana Yahweh tsǝkam a kunam ngga nda dumǝna púp, mǝ nǝ tsǝkiram arǝì, mǝ nǝ bangŋi ka re?&gt;&gt;<verse eid="NUM 23:12" /></para>
  <para style="s">Ɓaria cau-pasǝlǝe mala Bil'am nǝban Ɓakuli</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Pǝlǝa Balak banggi Bil'am ama, &lt;&lt;Ida, yiu atàm, sǝm nǝ̀ ká a ɓè ban, ban mǝnana awu nǝ sǝnia kam ngga. Akano ka awu nǝ sǝn barebania, a pà nǝ sǝnia kat ɗàng. Sǝ wu súkamia.&gt;&gt;<verse eid="NUM 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 23:14" />Nda Balak twal Bil'am, um nǝi a banfana mala Zofim, a ɓong Nkono Pisga. Ɓak agyangŋan tongno-nong-ɓari kam, sǝ pàgir nǝ jamnda andǝ gam amur koya gyangŋan.<verse eid="NUM 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15" />Pǝlǝa Bil'am banggi Balak ama, &lt;&lt;Cam kani a nkanggari pàgir mala pisǝe kǝring mò, sǝ mim ngga mǝ nǝ ká akano ace gasǝ sǝnǝ Yahweh.&gt;&gt;<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />Pǝlǝa Yahweh yiu aban Bil'am, sǝ tsǝki wi cau a kúni, sǝ banggi wi ama, &lt;&lt;Nyar aban Balak sǝ wu bang mǝnia yì cau ka.&gt;&gt;<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />Pǝlǝa Bil'am nyar aban Balak, sǝ yi kumi ka nda aban came a nkanggari pàgir mala pisǝe kǝring male, sǝ amǝgulo mala Mowap ka à nda baní. Sǝ Balak ɗì Bil'am ama, &lt;&lt;Mana nda gìr mǝnana Yahweh na ka?&gt;&gt;<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />Pǝlǝa Bil'am ar cau-pasǝlǝe male sǝ na ama,</para>
  <para style="q1" vid="NUM 23:18">&lt;&lt;Lo, Balak, sǝ wu ó!</para>
  <para style="q2" vid="NUM 23:18">Kwakikiro arǝàm, we muna-ɓwabura mala Zippor;<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />Ɓakuli ka, ɓwapǝndǝa na ɗang, mǝnana nǝ̀ na nyir ka,</para>
  <para style="q2" vid="NUM 23:19">sǝ yi ka, muna mala ɓwa na ɗang, mǝnana nǝ̀ nggaɗi kúni ka;</para>
  <para style="q1" vid="NUM 23:19">Nanacau, sǝ pà nǝ̀ pè re?</para>
  <para style="q2" vid="NUM 23:19">Ko ana raka, bangŋǝna cau, sǝ pà nǝ̀ lùmsǝì re?<verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />Sǝni, mim ngga à tsǝkam nzongcau ɓǝn tsǝkbu;</para>
  <para style="q1" vid="NUM 23:20">Yì ka tsǝngŋǝnabu, sǝ pà mǝ nǝ gandǝ nggaɗi ɗàng.<verse eid="NUM 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />Kǝ gìr múrɓikea pà kàm à pelǝì aɓa Yakupu ɗàng,</para>
  <para style="q2" vid="NUM 23:21">À sǝnma kǝ gìr bumkiɗikea aɓa Isǝrayila ɗàng.</para>
  <para style="q1" vid="NUM 23:21">Yahweh, Ɓakuli malea na ateà;</para>
  <para style="q2" vid="NUM 23:21">Gāwàn murǝm na aɓalǝia.<verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />Ɓakuli pusǝia aɓa Masar;</para>
  <para style="q1" vid="NUM 23:22">Yì ka nda kǝla anjawe ndwakan abania.<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />Kǝ ɓuri pà kàm nǝ̀ li arǝ Yakupu ɗàng,</para>
  <para style="q2" vid="NUM 23:23">kǝ ɗǐ kàm arǝ Isǝrayila ɗàng.</para>
  <para style="q1" vid="NUM 23:23">Adyan ngga à nǝ̀ banggi Yakupu, sǝ à nǝ̀ banggi Isǝrayila</para>
  <para style="q2" vid="NUM 23:23">gìr mǝnana Ɓakuli pangŋǝ̀nì ka!<verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />Sǝni, à nda ka aɓwana mana à kǝ lo kǝla nggeàɓwaná-im</para>
  <para style="q2" vid="NUM 23:24">aɓa gilǝrǝu nǝ̀ kánǝ munǝo;</para>
  <para style="q2" vid="NUM 23:24">kǝla mana im kǝ loasǝ rǝì ka,</para>
  <para style="q2" vid="NUM 23:24">sǝ pà nǝ̀ nongnǝ-nongŋo ɗang sheɓǝ̀ shanŋǝ̀nà nyama,</para>
  <para style="q2" vid="NUM 23:24">sǝ nuna nkila mala nyama mǝnana wal ka.&gt;&gt;<verse eid="NUM 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Pǝlǝa Balak banggi Bil'am ama, &lt;&lt;Ɓǝ̀ a pà wu nǝ suia raka, ko bǝti, kǝa tsǝkia wia bu ɗàng!&gt;&gt;<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />Pǝlǝa Bil'am pe Balak eare ama, &lt;&lt;Nggearǝì ka, ǝn banggo mbak nǝma, kǝgir mǝnana Yahweh banggam ngga, nda mǝ nǝ pàk ka, re?&gt;&gt;<verse eid="NUM 23:26" /></para>
  <para style="s">Tàruià cau-pasǝlǝe mala Bil'am nǝban Ɓakuli</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Pǝlǝa Balak banggi Bil'am ama, &lt;&lt;Yiu atàm, mǝ nǝ kánǝ we, a ɓè ban mwashat ɗǝm. Ear ka, nǝ̀ pwasǝbum Ɓakuli, ace mǝnana ɓǝ̀ earô wu suia acem, akano ka.&gt;&gt;<verse eid="NUM 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 23:28" />Pǝlǝa Balak twal Bil'am, sǝ à eau andǝi amur Nkono Piyor, mana sǝngiyi pǝɗanban ngga.<verse eid="NUM 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29" />Pǝlǝa Bil'am bang ama, &lt;&lt;Ɓakkam agyangŋan, tongno-nong-ɓari, sǝ wu gilikiam jamnda tongno-nong-ɓari, andǝ agam tongno-nong-ɓari.&gt;&gt;<verse eid="NUM 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 23:30" />Pǝlǝa Balak pa, kǝla mana Bil'am bang ama ɓǝà pè ka. Pǝlǝa pàgir nǝ jamnda andǝ gam, amur koya gyangŋan.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Adyan ngga, lang Bil'am sǝnǝni ama, girî pwasǝbum Yahweh, acemǝnana tsǝki amǝ Isǝrayila bù ka, nyare wario kǝla mana ɗiɗyal ka nǝ̀ nggá ɓangnǝ-ɓangnǝa ɗang. A kún mǝno ka, pǝlǝ ɓamǝsǝi nǝ njar ɓabondo. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Lang Bil'am loasǝ mǝsǝì sǝ sǝn amǝ Isǝrayila, aban do a kàttì, arǝ atau malea ka, Bangŋo mala Ɓakuli sulǝo amurí, <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />sǝ ar cau-pasǝlǝe male, ama:</para>
  <para style="q1" vid="NUM 24:3">&lt;&lt;Cau-pasǝlǝe mala Bil'am, muna-ɓwabura mala Beyo,</para>
  <para style="q2" vid="NUM 24:3">cau mala ɓwa mǝnana mǝsǝi kǝ sǝn agir pepè ka;<verse eid="NUM 24:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="NUM 24:4" />yì cau mala ɓwa mǝnana kǝ ok gi Ɓakuli;</para>
  <para style="q2" vid="NUM 24:4">yì ɓwa mǝnana kǝ sǝn sǝna nǝban Mǝ'kàrmúr-gulo kat;</para>
  <para style="q1" vid="NUM 24:4">yì ɓwa mǝnana kǝ sárǝ́ nǝ múrbumi a nzali, sǝ amǝsǝì na mǝnna ka:<verse eid="NUM 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />Wu sǝn ɓoarsǝna mala agumli ma'wun, We Yakupu,</para>
  <para style="q2" vid="NUM 24:5">nggearǝ abando ma'wun, We Isǝrayila!<verse eid="NUM 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />À sarǝa kǝla aɓangŋaban,</para>
  <para style="q2" vid="NUM 24:6">kǝla aɓaban-girpwala a kún nggeasala,</para>
  <para style="q1" vid="NUM 24:6">kǝla agwalan mǝnana Yahweh nǝ̀ pandǝia ka,</para>
  <para style="q2" vid="NUM 24:6">kǝla anggun-seda a kún amúr.<verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />Wun wunǝ amǝkà wun ngga wun nǝ̀ lidǝmba kǝla ɓaban-girpwala a myalmúr;</para>
  <para style="q1" vid="NUM 24:7">Murǝm malea nǝ̀ dumnǝ gulo mana kúti gulo mala Agag ka;</para>
  <para style="q2" vid="NUM 24:7">sǝ domurǝm malea ka nǝ̀ kum loasǝ́bân a kuli.<verse eid="NUM 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />Ɓakuli pusǝia, à purî nzali Masar;</para>
  <para style="q1" vid="NUM 24:8">yia ka, à ndanǝ rǝcandǝa mala ndwakan;</para>
  <para style="q1" vid="NUM 24:8">à nǝ̀ lika anzali mǝnana aɓia-mǝbura na ka;</para>
  <para style="q1" vid="NUM 24:8">à nǝ̀ arki amuia raka-rakas;</para>
  <para style="q1" vid="NUM 24:8">à nǝ̀ tāki aɓia-mǝbura nǝ amundi malea.<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />Kǝla im, à nǝ̀ ɓun amur ankūnǝia aban nongŋo,</para>
  <para style="q1" vid="NUM 24:9">kǝla nggeàɓwaná-im, yana ɓwe kārǝa nǝ zorǝia?</para>
  <para style="q1" vid="NUM 24:9">Aɓwana mana à tsǝka wun bù ka, ɓǝà kum tsǝkbu,</para>
  <para style="q2" vid="NUM 24:9">sǝ aɓwana mana à sú wun ngga, ɓǝà kum suban!&gt;&gt;<verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Kara bumlulla mala Balak earbǝsa arǝ Bil'am. Balak wal abui aɓalǝarǝia, sǝ banggi Bil'am ama, &lt;&lt;Ən tunǝo nǝma, wu sukàm aɓiam-mǝbura, sǝ ndya ka a tsǝ́ngŋǝ́niabu kusǝ tàrú mǝnia. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Ado ka, nying ban mǝnia ka tsuk-tsuk, o a là! Ən bang nǝma mǝ nǝ mbweo pepè, sǝama Yahweh tsǝ̀ngŋǝ̀nó a ɗwanyini mbweban mana ɓǝ́ awu nǝ kum ngga.&gt;&gt;<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />Pǝlǝa Bil'am pè Balak eare ama, &lt;&lt;Ən bangmì amǝ'na-túrbân mana a túriá abanam ngga re? <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />Ən nana nǝma, ko ɓǝ̀ Balak nǝ̀ pam palta male, lumsǝ nǝ bolo-azǝrfa andǝ bolo-njengǝlan ngga, pà mǝ nǝ pàk ɓè kǝgir mala ɓamúràm, ko mǝɓoarne ko mǝɓane, mǝnana yàlî nzongcau mala Yahweh ka ɗàng; Dumǝnam púp, mǝ nǝ bang kǝ gir mǝnana Yahweh kǝ na ka. <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />Adyan ngga, mǝ ndya mǝ nǝ nyare, mǝ nǝ o aban aɓwana mem. Sǝama, came mǝ nunkiro amur gir mǝnana aɓwana mǝnia, nǝ̀ yia pàkkî aɓwana mô arǝ apwari mana à kǝ yiu ka.&gt;&gt;<verse eid="NUM 24:14" /></para>
  <para style="s">Inea cau-pasǝlǝe mala Bil'am nǝban Ɓakuli</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 24:15" />Pǝlǝa Bil'am ar cau-pasǝlǝe male ama:</para>
  <para style="q1" vid="NUM 24:15">&lt;&lt;Cau-pasǝlǝe mala Bil'am, muna-ɓwabura mala Beyo,</para>
  <para style="q2" vid="NUM 24:15">cau mala ɓwa mǝnana mǝsǝi kǝ sǝn agir pepè ka;<verse eid="NUM 24:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="NUM 24:16" />yì cau mala ɓwa mǝnana kǝ ok gi Ɓakuli,</para>
  <para style="q2" vid="NUM 24:16">yì ɓwa mǝnana ndanǝ súrǝ̀gir nǝban Mǝ'Karban Kat ka,</para>
  <para style="q2" vid="NUM 24:16">yì ɓwa mǝnana kǝ kum sǝna nǝban Mǝ'rǝcandǝa kat ka;</para>
  <para style="q2" vid="NUM 24:16">yì ɓwa mǝnana kǝ sárǝ́ nǝ múrbumi a nzali, sǝ amǝsǝì na mǝnna ka:<verse eid="NUM 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />Ən nggǝ sǝni, sǝama pà ado ɗàng;</para>
  <para style="q1" vid="NUM 24:17">Ən nggǝ pelǝkì, sǝama pà abanam tù ɗàng.</para>
  <para style="q1" vid="NUM 24:17">Nlero nǝ̀ puro aɓa Yakupu;</para>
  <para style="q1" vid="NUM 24:17">gara-murǝm nǝ̀ yia lo aɓa Isǝrayila,</para>
  <para style="q2" vid="NUM 24:17">sǝ nǝ̀ yia arki akundǝmba amǝ'Mowap,</para>
  <para style="q2" vid="NUM 24:17">yì ankpoulo-ɓamur amuna-burana mala Shet.<verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />Edom ngga, à nǝ̀ lì nǝ lwa;</para>
  <para style="q1" vid="NUM 24:18">Seyir, ɓimǝbura malea ka, à nǝ̀ lì nǝ lwa,</para>
  <para style="q2" vid="NUM 24:18">sǝama Isǝrayila ka, nǝ̀ gulo nǝ̀ dumnǝ rǝcandǝa.<verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />Mǝ'yálmúrû nǝ̀ pur aɓa Yakupu,</para>
  <para style="q2" vid="NUM 24:19">sǝ nǝ̀ yia kiɗiki acili aɓwana mala nggea-lê.&gt;&gt;<verse eid="NUM 24:19" /></para>
  <para style="s">Masǝlǝata cau-pasǝlǝe mala Bil'am</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />Pǝlǝa Bil'am sǝn amǝ Amalek, sǝ ar cau-pasǝlǝe male ama:</para>
  <para style="q1" vid="NUM 24:20">&lt;&lt;Amalek ka, nda mǝdǝmba aɓalǝ anzali,</para>
  <para style="q2" vid="NUM 24:20">sǝama, à nǝ̀ kiɗiki kat a masǝlǝate.&gt;&gt;<verse eid="NUM 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />Pǝlǝa sǝn amǝ Ken, sǝ ar cau male ama:</para>
  <para style="q1" vid="NUM 24:21">&lt;&lt;Bando ma'wun ngga, nda aɓata gbasha,</para>
  <para style="q2" vid="NUM 24:21">sǝ mpù ma'wun ngga, à kwakite aɓa tali;<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />kat andǝ amani ka, wun amǝ Ken ngga, à nǝ̀ kiɗiki wun,</para>
  <para style="q2" vid="NUM 24:22">lang Asshur nǝ̀ yia bwal wun aguro ka.&gt;&gt;<verse eid="NUM 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />Pǝlǝa nyare ar cau-pasǝlǝe male ama:</para>
  <para style="q1" vid="NUM 24:23">&lt;&lt;Oi, sǝ yana nǝ̀ auwa, lang Ɓakuli nǝ̀ pàk mǝnia ka?<verse eid="NUM 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24" />Awaru-mur nǝ̀ puro arǝ akunto mala Kitim;</para>
  <para style="q2" vid="NUM 24:24">à nǝ̀ yia gandǝ Asshur andǝ Eba,</para>
  <para style="q2" vid="NUM 24:24">sǝ yià gbal ka, à nǝ̀ kìɗìkya.&gt;&gt;<verse eid="NUM 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />Pǝlǝa Bil'am lo sǝ nyare a là, sǝ Balak ka o a o male.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s">Amǝ Isǝrayila peri aban Ba'al a Piyor</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Mana amǝ Isǝrayila na a bando a Shitim ngga, aburana mala amǝ Isǝrayila kùtí a nongginǝ amamǝna mala amǝ'Mowap. <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />Pǝlǝa amamǝna mǝnia tunǝ aburana man ɓǝà kyane aban apa'girnkila mala aɓakuli malea. Pǝlǝa amǝnia yì aburana ka, à lì girlina ɗārǝâ, sǝ à peri aban aɓakuli mala amǝ'Mowap. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />Anggo, sǝ amǝ Isǝrayila kùtí a peri aban Ba'al Piyor, sǝ bum Yahweh pi arǝia kǝ̀rkǝ́r.<verse eid="NUM 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 25:4" />Sǝ Yahweh ne Musa ama, &lt;&lt;Twal aɓwana-mǝgule mala mǝnia yì aɓwana mǝnana à pàk gìr man ngga, sǝ wu wal-luia nǝ gyarban a pwari, aɓadǝmbam Yahweh, ace mǝnana nggea bumlulla mem Yahweh ka ɓǝ̀ sulǝî múr Isǝrayila.&gt;&gt;<verse eid="NUM 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 25:5" />Pǝlǝa Musa banggi amǝ'ɓashi mala amǝ Isǝrayila ama, &lt;&lt;Koyan atà wun ngga, ɓǝ̀ wal-lú aɓwana male mana à oasǝ múrià aɓa peri aban Ba'al Piyor ka.&gt;&gt;<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Sǝ mwashat atà amǝ Isǝrayila yinǝ ɓè ɓwama Midiyan<note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="fq" closed="false">Midiyan: </char><char style="ft" closed="false">À pàktúró nǝi akani kǝla lullǝu mana kpapi akûn mala aɓwapǝndǝa ɗàngɗáng mǝnana à do a takuli mala Nggeasala Jodan ngga. Aɓea atà aɓwapǝndǝa man ngga yakǝla ɓwa Mowap nda murǝm amúrià; sǝni a </char><char style="xt"><ref loc="GEN 36:35">Tite 36:35</ref>; <ref loc="NUM 31:8">Ɓal 31:8</ref>; <ref loc="JOS 13:21">Jes 13:21</ref></char>.</note> aban aɓwana male, a mǝsǝ Musa ngguont, sǝ a mǝsǝ amǝ Isǝrayila puppup, yi mana à nda ban ɓua a bankutio aɓa Tara Ban-peri ka. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Lang Finehas muna-ɓwabura mala Eleaza, muna-ɓwabura mala Haruna, pǝris, sǝni ka, lo nying ɓwabundǝa, kya twal nzo a bui, <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />pǝlǝa o atà ɓwa Isǝrayila mǝno aɓa gumli male. Kara zuɓia yià kǝm, yì ɓwabure, ɓwa Isǝrayila andǝ ɓwame, kya sa a bum ɓwame. Kara kwánó-ɓikea mana nda amur amǝ Isǝrayila ka came. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />Sǝama aɓwana mana à wǔ aɓa kwánó-ɓikea mǝnia ka à nda á-lumi-ɓari-nong-ine (24,000).<verse eid="NUM 25:9" /></para>
  <para style="s">Ɓabumpina mala Finehas</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />Sǝ Yahweh ne Musa ama, <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />&lt;&lt;Finehas muna-ɓwabura mala Eleaza, muna-ɓwabura mala Haruna, pǝris ka, pwasǝlǝna nggea bumlulla mem arǝ amǝ Isǝrayila, acemǝnana yì ka, ndanǝ ulang bumpina mem aɓalǝi. Acemani ka, Ən twalta amǝ Isǝrayila aɓa bumpina mem ɗàng. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Acemani ka, ne wi ama, &lt;Mǝ ndaban kùrcau nǝi mala dorǝpwala mem. <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />Sǝ yì andǝ amǝ'ke atè ka, ǝn kurnacau mala lidǝmba malea aɓa dobuno-pǝris, acemǝnana pàk bumpina ace Ɓakuli male, sǝ shawuɗi amǝ Isǝrayila.&gt; &gt;&gt;<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />Lullǝ ɓwa Isǝrayila mana à wal-lui andǝ ɓwama Midiyan ngga, nda Zǝmri, muna-ɓwabura mala Salu, ɓwamǝgule a ɓala-kàu a tàu mala Shimiyon.<verse eid="NUM 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 25:15" />Sǝ lullǝ ɓwama Midiyan mana à wal-lui ka nda Kosbi muna-ɓwama mala Zur, ɓwamǝgule amur ɓala-kau mala ɓè tau mala amǝ Midiyan.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />Pǝlǝa Yahweh nacau nǝ Musa ama, <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />&lt;&lt;Kyan nǝ munǝo arǝ amǝ'Midiyan, kǝla aɓiwun-amǝbura, wu walia. <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />Acemǝnana à pàngnǝ wun kǝla aɓia-mǝbura nǝ swarkiban mǝnana à swarki wun a cau mala Piyor, sǝ a cau mala Kosbi, nsarile ɓwamǝgule mala amǝ Midiyan, mǝ'eambia muna-ɓwama mana à wal-lui a pwari mala kwánó-ɓikea atàcau mala Piyor ka.&gt;&gt;<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s">Ɓaria ɓalban</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Anzǝm mana kwánó-ɓikea malǝna ka, Yahweh bangcau nǝ Musa andǝ Eleaza muna-ɓwabura mala Haruna, yì pǝris ama, <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />&lt;&lt;Wu ɓal làkkì mala aɓwana arǝ atau mala amǝ Isǝrayila a ɓinalea kat, koya ɓwabura mǝnana pǝlǝa-ɓǝlban male bingŋǝna lumi-ɓari aban ká dǝmba ka; mǝnana karǝna-ɓwa nǝ̀ gandǝ ká lwa ka.&gt;&gt; <verse eid="NUM 26:2" /><verse number="3" style="v" sid="NUM 26:3" />Pǝlǝa Musa andǝ Eleaza pǝris bangcau nǝ aɓwana mǝnia ka, aɓa ɓawanban mala Mowap, a nkaring Nggeasala Jodan, a Jeriko, ama, <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />&lt;&lt;Wu ɓal làkkì mala aburana mana pǝlǝa-ɓǝlban malea bingŋǝna lumi-ɓari aban ká dǝmba,&gt;&gt; kǝla mana Yahweh banggi Musa ka.</para>
  <para style="p" vid="NUM 26:4">Amǝnia ka à nda ka amǝ Isǝrayila mǝnana à purî ɓá nzali Masar ka.<verse eid="NUM 26:4" /></para>
  <para style="s">Tàu mala Ruben</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5" />Amǝkà Ruben, muna-dǝmba mala Yakupu, arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:5">Amǝ'Hanok a nggurkwar mala muni Hanok;</para>
  <para style="li1" vid="NUM 26:5">Amǝ'Palu a nggurkwar mala muni Palu;<verse eid="NUM 26:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 26:6" />Amǝ'Hezǝron a nggurkwar mala muni Hezǝron, sǝ</para>
  <para style="li1" vid="NUM 26:6">Amǝ'Karmi a nggurkwar mala muni Karmi.<verse eid="NUM 26:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="NUM 26:7" />Amǝnia ka à nda ka aɓala mala amuna andǝ amǝkà Ruben kǝla mana à ɓallia ka, aburana á-lumi-ine-bwamdǝ-á-tàrú nǝ gbǝman-tongno-nong-ɓari nǝ lumi-tàrú (43,730).<verse eid="NUM 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 26:8" />Palu nda tár Eliyap, <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />sǝ amuna-burana mala Eliyap ka à nda ka Nemuyel, andǝ Datan sǝ Abiram. Amǝnia ka à nda ka kǝ Datan andǝ Abiram mǝnana ɓwabundǝa twalia ɓǝà duk amǝgulo amur aɓwana, sǝ à yì mgbicau arǝ Musa andǝ Haruna ka; ɗǝm ngga à nda atà aɓwana mǝnana à kpata Kora à yì mgbicau arǝ Yahweh ka;<note caller="+" style="f"><char style="fr" closed="false">26:9 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 16:1-3">Ɓal 16:1-3</ref></char>.</note> <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />sǝ nzali mǝn kúni myalia kat, atārǝia andǝ Kora, mǝnana amǝtè wǔ, lang bǝsa yi twalta aburana gbǝman-ɓari nǝ lumi-tongno ka (250).<note caller="+" style="f"><char style="fr" closed="false">26:10 </char><char style="ft" closed="false">Ɓalli aɓa </char><char style="xt"><ref loc="NUM 16:31-35">Ɓal 16:31-35</ref></char>.</note> Mǝno ka yi duk gir nunkiru aban acili amǝ Isǝrayila kat. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Sǝama amuna-burana mala Kora ka à wù ɗàng.<verse eid="NUM 26:11" /></para>
  <para style="s">Tàu mala Shimiyon</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />Amǝkà Shimiyon arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:12">Amǝ'Nemuyel a nggurkwar mala muni Nemuyel;</para>
  <para style="li1" vid="NUM 26:12">Amǝ'Jamin a nggurkwar mala muni Jamin;</para>
  <para style="li1" vid="NUM 26:12">Amǝ'Jakin a nggurkwar mala muni Jakin;<verse eid="NUM 26:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 26:13" />Amǝ'Zera a nggurkwar mala muni Zera, sǝ</para>
  <para style="li1" vid="NUM 26:13">Amǝ'Shawul a nggurkwar mala muni Shawul.<verse eid="NUM 26:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="NUM 26:14" />Amǝnia ka à nda ka aɓala mala amuna andǝ amǝkà Shimiyon kǝla mana à ɓallia ka, aburana á-lumi-ɓari-bwamdǝ-á-ɓari nǝ gbǝman-ɓari (22,200).<verse eid="NUM 26:14" /></para>
  <para style="s">Tàu mala Gad</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Amǝkà Gad arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:15">Amǝ'Zefon a nggurkwar mala muni Zefon;</para>
  <para style="li1" vid="NUM 26:15">Amǝ'Hagi a nggurkwar mala muni Hagi</para>
  <para style="li1" vid="NUM 26:15">Amǝ'Shuni a nggurkwar mala muni Shuni;<verse eid="NUM 26:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NUM 26:16" />Amǝ'Ozǝni a nggurkwar mala muni Ozǝni;</para>
  <para style="li1" vid="NUM 26:16">Amǝ'Eri a nggurkwar mala muni Eri;<verse eid="NUM 26:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="NUM 26:17" />Amǝ'Arodi a nggurkwar mala muni Arodi, sǝ</para>
  <para style="li1" vid="NUM 26:17">Amǝ'Areli a nggurkwar mala muni Areli.<verse eid="NUM 26:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="NUM 26:18" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Gad kǝla mana à ɓallia ka, aburana á-lumi-ine nǝ gbǝman-tongno (40,500).<verse eid="NUM 26:18" /></para>
  <para style="s">Tàu mala Yahuda</para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Amuna-burana mala Yahuda ka à nda ka Er andǝ Onan, sǝ yià ka à wǔ aɓa nzali Kan'ana.<note caller="+" style="f"><char style="fr" closed="false">26:19 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 38:3-4">Tite 38:3-4</ref>,<ref loc="GEN 38:6-11">6-11</ref></char>.</note><verse eid="NUM 26:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="NUM 26:20" />Amǝkà Yahuda arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:20">Amǝ'Shela a nggurkwar mala muni Shela;</para>
  <para style="li1" vid="NUM 26:20">Amǝ'Perez a nggurkwar mala muni Perez;</para>
  <para style="li1" vid="NUM 26:20">Amǝ'Zera a nggurkwar mala muni Zera.<verse eid="NUM 26:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 26:21" />Amǝkà Perez ka à nda ka:</para>
  <para style="li2" vid="NUM 26:21">Amǝ'Hezǝron a nggurkwar mala muni Hezǝron, sǝ</para>
  <para style="li2" vid="NUM 26:21">Amǝ'Hamul a nggurkwar mala muni Hamul.<verse eid="NUM 26:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="NUM 26:22" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Yahuda kǝla mana à ɓallia ka, aburana á-lumi-tongno-nong-ɓari-bwamdǝ-tongno-nong-mwashat nǝ gbǝman-tongno (76,500).<verse eid="NUM 26:22" /></para>
  <para style="s">Tàu mala Isaka</para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Amǝkà Isaka arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:23">Amǝ'Tola a nggurkwar mala muni Tola;</para>
  <para style="li1" vid="NUM 26:23">Amǝ'Puwa a nggurkwar mala muni Puwa;<verse eid="NUM 26:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 26:24" />Amǝ'Jashup a nggurkwar mala muni Jashup, sǝ</para>
  <para style="li1" vid="NUM 26:24">Amǝ'Shimiron a nggurkwar mala muni Shimiron.<verse eid="NUM 26:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="NUM 26:25" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Isaka kǝla mana à ɓallia ka, aburana á-lumi-tongno-nong-mwashat-bwamdǝ-á-ine nǝ gbǝman-tàrú (64,300).<verse eid="NUM 26:25" /></para>
  <para style="s">Tàu mala Zebulu</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Amǝkà Zebulu arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:26">Amǝ'Seret a nggurkwar mala muni Seret;</para>
  <para style="li1" vid="NUM 26:26">Amǝ'Elon a nggurkwar mala muni Elon, sǝ</para>
  <para style="li1" vid="NUM 26:26">Amǝ'Jali a nggurkwar mala muni Jali.<verse eid="NUM 26:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="NUM 26:27" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Zebulu kǝla mana à ɓallia ka, aburana á-lumi-tongno-nong-mwashat nǝ gbǝman-tongno (60,500).<verse eid="NUM 26:27" /></para>
  <para style="s">Tàu mala Manasa</para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Amǝkà Yisǝfu arǝ anggurkwar malea nǝban amuna-burana male Manasa andǝ Ifǝrem ngga à nda ka:<verse eid="NUM 26:28" /></para>
  <para style="li1">
    <verse number="29" style="v" sid="NUM 26:29" />Amǝkà Manasa:</para>
  <para style="li2" vid="NUM 26:29">a nggurkwar mala muni Makir ka à nda ka Amǝ'Makir; sǝ Makir ka nda tár Gilǝyat;</para>
  <para style="li3" vid="NUM 26:29">Amǝ'kau a nggurkwar mala Gilǝyat ka à nda ka Amǝ'Gilǝya. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />Sǝ amǝkà Gilǝyat ka à nda ka:</para>
  <para style="li4" vid="NUM 26:30">Amǝ'Iyeza a nggurkwar mala muni Iyeza;</para>
  <para style="li4" vid="NUM 26:30">Amǝ'Helek a nggurkwar mala muni Helek;<verse eid="NUM 26:30" /></para>
  <para style="li4">
    <verse number="31" style="v" sid="NUM 26:31" />Amǝ'Asǝriyel a nggurkwar mala muni Asǝriyel;</para>
  <para style="li4" vid="NUM 26:31">Amǝ'Shekem a nggurkwar mala muni Shekem;<verse eid="NUM 26:31" /></para>
  <para style="li4">
    <verse number="32" style="v" sid="NUM 26:32" />Amǝ'Shemida a nggurkwar mala muni Shemida, andǝ</para>
  <para style="li4" vid="NUM 26:32">Amǝ'Hefa a nggurkwar mala muni Hefa.<verse eid="NUM 26:32" /></para>
  <para style="li4">
    <verse number="33" style="v" sid="NUM 26:33" />Zelofihat, muna-ɓwabura mala Hefa ka, kum kǝ muna-ɓwabura ɗàng; amuni ka amuna-mamǝna na, sǝ alullǝia ka à nda ka Mahla, andǝ Noha, andǝ Hogǝla, andǝ Milka, sǝ Tǝrza.<verse eid="NUM 26:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="NUM 26:34" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Manasa kǝla mana à ɓallia ka, aburana á-lumi-tongno-bwamdǝ-á-ɓari nǝ gbǝman-tongno-nong-ɓari (52,700).<verse eid="NUM 26:34" /></para>
  <para style="s">Tàu mala Ifǝrem</para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />Amǝkà Ifǝrem ngga à nda ka:</para>
  <para style="li1" vid="NUM 26:35">Amǝ'Shutela a nggurkwar mala muni Shutela;</para>
  <para style="li1" vid="NUM 26:35">Amǝ'Beka a nggurkwar mala muni Beka, andǝ</para>
  <para style="li1" vid="NUM 26:35">Amǝ'Tahan a nggurkwar mala muni Tahan.<verse eid="NUM 26:35" /></para>
  <para style="lim">
    <verse number="36" style="v" sid="NUM 26:36" />Amǝkà Shutela ka à nda ka:</para>
  <para style="li3" vid="NUM 26:36">Amǝ'Eran a nggurkwar mala muni Eran;<verse eid="NUM 26:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="NUM 26:37" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Ifǝrem kǝla mana à ɓallia ka, aburana á-lumi-tàrú-bwamdǝ-á-ɓari nǝ gbǝman-tongno (32,500). Yià mǝnia ka, à nda ka amǝkà Yisǝfu arǝ anggurkwar malea.<verse eid="NUM 26:37" /></para>
  <para style="s">Tàu mala Benjami</para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Amǝkà Benjami arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:38">Amǝ'Bela a nggurkwar mala muni Bela;</para>
  <para style="li1" vid="NUM 26:38">Amǝ'Ashbel a nggurkwar mala muni Ashbel;</para>
  <para style="li1" vid="NUM 26:38">Amǝ'Ahiram a nggurkwar mala muni Ahiram;<verse eid="NUM 26:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 26:39" />Amǝ'Shufam a nggurkwar mala muni Shefufam, andǝ</para>
  <para style="li1" vid="NUM 26:39">Amǝ'Hufam a nggurkwar mala muni Hufam.<verse eid="NUM 26:39" /></para>
  <para style="lim">
    <verse number="40" style="v" sid="NUM 26:40" />Amǝkà Bela nǝban amuni Arǝd andǝ Naaman ngga à nda ka:</para>
  <para style="li3" vid="NUM 26:40">Amǝ'Arǝd a nggurkwar mala Arǝd, andǝ</para>
  <para style="li3" vid="NUM 26:40">Amǝ'Naaman a nggurkwar mala Naaman.<verse eid="NUM 26:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="NUM 26:41" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Benjami kǝla mana à ɓallia ka, aburana á-lumi-ine-bwamdǝ-á-tongno nǝ gbǝman-tongno-nong-mwashat (45,600).<verse eid="NUM 26:41" /></para>
  <para style="s">Tàu mala Dan</para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Amǝkà Dan arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:42">Amǝ'Shuham a nggurkwar mala muni Shuham.</para>
  <para style="m" vid="NUM 26:42">Amǝnia ka, à nda ka aɓala mala muna andǝ amǝkà Dan arǝ anggurkwar malea. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Amǝ'Shuham kat arǝ anggurkwar malea, kǝla mana à ɓallia ka, aburana á-lumi-tongno-nong-mwashat-bwamdǝ-á-ine nǝ gbǝman-ine na (64,400).<verse eid="NUM 26:43" /></para>
  <para style="s">Tàu mala Asha</para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Amǝkà Asha arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:44">Amǝ'Imǝna a nggurkwar mala muni Imǝna;</para>
  <para style="li1" vid="NUM 26:44">Amǝ'Ishvi a nggurkwar mala muni Ishvi, andǝ</para>
  <para style="li1" vid="NUM 26:44">Amǝ'Beriya a nggurkwar mala muni Beriya.<verse eid="NUM 26:44" /></para>
  <para style="lim">
    <verse number="45" style="v" sid="NUM 26:45" />Beriya ka amǝkè nda ka:</para>
  <para style="li3" vid="NUM 26:45">Amǝ'Heba a nggurkwar mala muni Heba, andǝ</para>
  <para style="li3" vid="NUM 26:45">Amǝ'Malkiyel a nggurkwar mala muni Malkiyel.<verse eid="NUM 26:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="NUM 26:46" />Asha ka ndanǝ muna-ɓwama, à tunǝki ama Sera.<verse eid="NUM 26:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="NUM 26:47" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Asha kǝla mana à ɓallia ka, aburana á-lumi-tongno-bwamdǝ-á-tàrú nǝ gbǝman-ine (53,400).<verse eid="NUM 26:47" /></para>
  <para style="s">Tàu mala Naftali</para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Amǝkà Naftali arǝ anggurkwar malea ka à nda ka:</para>
  <para style="li1" vid="NUM 26:48">Amǝ'Jazil a nggurkwar mala muni Jazil;</para>
  <para style="li1" vid="NUM 26:48">Amǝ'Guni a nggurkwar mala muni Guni;<verse eid="NUM 26:48" /></para>
  <para style="li1">
    <verse number="49" style="v" sid="NUM 26:49" />Amǝ'Jeza a nggurkwar mala muni Jeza, andǝ</para>
  <para style="li1" vid="NUM 26:49">Amǝ'Shilem a nggurkwar mala muni Shilem.<verse eid="NUM 26:49" /></para>
  <para style="m">
    <verse number="50" style="v" sid="NUM 26:50" />Amǝnia ka, à nda ka aɓala mala amuna andǝ amǝkà Naftali kǝla mana à ɓallia ka, aburana á-lumi-ine nǝ á-tongno nǝ gbǝman-ine (45,400).<verse eid="NUM 26:50" /></para>
  <para style="s">Làkkì malea kat-kat andǝ gau nzali</para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />Làkkì mala aburana mala amǝ Isǝrayila kat-kat ka, á-gbǝman-tongno-nong-mwashat nǝ á-mwashat nǝ gbǝman-tongno-nong-ɓari nǝ lumi-tàrú na (601,730).<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />Yahweh banggi Musa ama, <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />&lt;&lt;Awu nǝ gau nzali amur amǝnia ka, ɓǝ̀ duk girkuma malea, nǝ kpata làkkì mala alullǝ aɓwana mǝnana à ɓallia ka. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />Tàu mǝnana gul ka, kasǝia wia nzali liɓala kpǝm, sǝ tàu mǝnana kyau ka, kasǝia wia nzali liɓala bǝti; koya tàu ka ɓǝ̀ kum nzali kǝla mana làkkì mala aɓwana mana à ɓallia, pàk ka. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Sǝama dumǝna púp ama nzali ka à nǝ̀ gakki nǝ bwal-shishar. Nzali liɓala mǝnana koya tàu nǝ̀ kum ngga awu nǝ kārǝi arǝ làkkì mala alullǝ aɓwana aɓalǝi. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Gau nzali liɓala amur atau mǝgulke andǝ atau mǝkeke ka, awu nǝ kpate nǝ bwal-shishar.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">26:56 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 33:53-54">Ɓal 33:53-54</ref>; <ref loc="NUM 34:13">34:13</ref>; <ref loc="NUM 36:2">36:2</ref>; <ref loc="JOS 14:2">Jes 14:2</ref>; <ref loc="JOS 18:6-11">18:6-11</ref>; <ref loc="JOS 19:51">19:51</ref>; <ref loc="JOS 21:4-8">21:4-8</ref>; <ref loc="1CH 6:61">1Acau 6:61</ref>,<ref loc="1CH 6:63">63</ref>,<ref loc="1CH 6:65">65</ref>; <ref loc="PSA 78:55">Ang 78:55</ref>; <ref loc="EZK 45:1">Ezǝk 45:1</ref></char>.</note><verse eid="NUM 26:56" /></para>
  <para style="s">Tàu mala Lawi</para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />Aɓwana mǝnana à ɓallia arǝ anggurkwar malea a tàu mala Lawi ka, à nda ka:</para>
  <para style="li1" vid="NUM 26:57">Amǝ'Gashon a nggurkwar mala muni Gashon;</para>
  <para style="li1" vid="NUM 26:57">Amǝ'Kohat a nggurkwar mala muni Kohat, sǝ</para>
  <para style="li1" vid="NUM 26:57">Amǝ'Merari a nggurkwar mala muni Merari.<verse eid="NUM 26:57" /></para>
  <para style="m">
    <verse number="58" style="v" sid="NUM 26:58" />Anggurkwar mala Lawi ka, à nda ka:</para>
  <para style="li1" vid="NUM 26:58">Nggurkwar mala Amǝ'Libǝni;</para>
  <para style="li1" vid="NUM 26:58">Nggurkwar mala Amǝ'Hebǝron;</para>
  <para style="li1" vid="NUM 26:58">Nggurkwar mala Amǝ'Mali;</para>
  <para style="li1" vid="NUM 26:58">Nggurkwar mala Amǝ'Mushi, sǝ</para>
  <para style="li1" vid="NUM 26:58">Nggurkwar mala Amǝ'Kora.<note caller="+" style="f"><char style="fr" closed="false">26:58 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:21">Pur 6:21</ref>,<ref loc="EXO 6:24">24</ref>; <ref loc="NUM 3:17-20">Ɓal 3:17-20</ref></char>.</note></para>
  <para style="p" vid="NUM 26:58">Kohat ka, nda kà Amram.<note caller="+" style="f"><char style="fr" closed="false">26:58 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:18-20">Pur 6:18-20</ref></char>.</note> <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Mālá Amram ngga, nda Jochebet, mǝkà Lawi, mǝnana à ɓǝlî Lawi a Masar ka. Jochebet ɓǝlî Amram amuna mǝnia ka: Haruna andǝ Musa sǝ Miriyam mǝ'eambia muna-ɓwama. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />À ɓǝlî Haruna amuna-burana mǝnia ka: Nadap andǝ Abihu, andǝ Eleaza sǝ Itamar.<note caller="+" style="f"><char style="fr" closed="false">26:60 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 6:23">Pur 6:23</ref>; <ref loc="EXO 24:1">24:1</ref>,<ref loc="EXO 24:9">9</ref>; <ref loc="EXO 28:1">28:1</ref>; <ref loc="NUM 3:2">Ɓal 3:2</ref>,<ref loc="NUM 3:4">4</ref>; <ref loc="1CH 6:3">1Acau 6:3</ref></char>.</note> <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Sǝama Nadap andǝ Abihu ka à yi wú lang à pàgir nǝ bǝsa mǝnana à earnǝi raka aɓadǝm Yahweh.<note caller="+" style="f"><char style="fr" closed="false">26:61 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 10:1-7">Pǝris 10:1-7</ref>; <ref loc="1CH 24:1-2">1Acau 24:1-2</ref></char>.</note><verse eid="NUM 26:61" /></para>
  <para style="m">
    <verse number="62" style="v" sid="NUM 26:62" />Aburana mala Amǝ'Lawi mana à ɓallia, yià mǝnana twal a ɓǝlban malea ka à bingŋǝ́nà zongŋo mwashat aban ká dǝmba ka, à nda á-lumi-ɓari-bwamdǝ-tàrú (23,000). Yia ka à ɓallia atà aɓia amǝ Isǝrayila ɗàng acemǝnana à pea wia kǝ nzali liɓala ɗàng.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Amǝnia ka à nda ka aɓwana mana Musa andǝ Eleaza pǝris ɓallia, lang à nda aban ɓal amǝ Isǝrayila a ɓawanban Mowap a kún Nggeasala Jodan a Jeriko ka. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Sǝama aɓalǝ amǝnia yì aɓwana ka, kǝɓwa pà kàm atà aɓwana mala nza mǝnana Musa andǝ Haruna pǝris ɓal amǝ Isǝrayila a pǝɗanban Saina ka ɗàng.<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 1:17-54">Ɓal 1:17-54</ref>; <ref loc="NUM 3:39">3:39</ref></char>.</note> <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />Mǝnia ka nda acemǝnana Yahweh bángŋǝ́nià amǝno yì amǝ Isǝrayila ama à nǝ̀ wukio a ɓabondo, sǝ kǝɓwa pà kàm mana à nyi ka ɗàng, she Kalip muna-ɓwabura mala Jefune andǝ Jesǝwa muna-ɓwabura mala Nun.<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 14:26-35">Ɓal 14:26-35</ref></char>.</note><verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s">À pè amuna-mamǝna mala Zelofihat nzali</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Pǝlǝa aɓoarnsarile Zelofihat sungŋo a dǝmba; Zelofihat ka nda muna-ɓwabura mala Hefa, muna-ɓwabura mala Gilǝyat, muna-ɓwabura mala Makir, muna-ɓwabura mala Manasa, mana nda a ɓala-kàu mala Manasa muna-ɓwabura mala Yisǝfu ka. Alullǝ aɓoarnsarile ka à nda ka: Mahla, andǝ Noha, andǝ Hogǝla, andǝ Milka, sǝ Tǝrza. <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />À came aɓadǝm Musa, andǝ Eleaza pǝris, andǝ aɓwana-mǝgule, andǝ ɓwabundǝa kat, a bankutio aɓa Tara Ban-peri, sǝ à bang ama, <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />&lt;&lt;Tár sǝm wǔ a ɓabondo. Yì ka pà aɓalǝ aɓwana mala Kora, mana à ram rǝia arǝ Yahweh ka ɗàng; wǔ ace cauɓikea male, sǝ pànǝ kǝ muna-ɓwabura ɗang. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />Ace mana sǝ lullǝ tar sǝm nǝ̀ ndǝrmi anggo aɓa tàu male acemǝnana pànǝ muna-ɓwabura raka? Wu pà sǝm gìr liɓala atà amǝ'eam tár sǝm.&gt;&gt;<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />Pǝlǝa Musa yinǝ cau malea aɓadǝm Yahweh, <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />sǝ Yahweh ne wi ama, <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />&lt;&lt;Cau mana aɓoarnsarile Zelofihat na ka nda jik. Dumǝna púp awu nǝ pea wia kāmbe malea mala nzali mana ɓǝ́ tárrià nǝ̀ kumo atà amǝ'eambi ka. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Ne amǝ Isǝrayila ama, &lt;Ɓǝ̀ ɓwa wǔ sǝ pànǝ muna-ɓwabura raka, muna-ɓwama male ɓǝ̀ liɓala male. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Ɓǝ̀ pànǝ muna-ɓwama raka, amǝ'eambi aburana ɓǝà liɓala male. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Sǝ ɓǝ̀ pànǝ amǝ'eambu aburana raka, awu nǝ pè amǝ'eam tárrí aburana kāmbe mala liɓala male. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Ɓǝ̀ tárrí pànǝ mǝ'eambu ɓwabura raka, awu nǝ pè ɓǝla male mana nda tù abani a tàu male ka, ɓǝ̀ li nzali male.&gt; Mǝnia ka nǝ̀ duk nê andǝ nggurcau aban amǝ Isǝrayila, kǝla mana Mim Yahweh ǝn banggo ka.&gt;&gt;<verse eid="NUM 27:11" /></para>
  <para style="s">À twal Jesǝwa ɓǝ̀ duk ɓwamǝgule amur amǝ Isǝrayila</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />Yahweh ne Musa ama, &lt;&lt;Eauwe amur nkono mǝnia ka, Nkono Abarim, sǝ wu sǝn nzali mǝnana ǝn pani amǝ Isǝrayila ka. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Anzǝm mana a sǝnǝni ka, awu nǝ wǔ kǝla mala mǝ'eambo Haruna, <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />acemǝnana wun kǝm ngga, wu ginǝ kpata cau mem aɓa pǝɗanban Zin. Lang ɓwabundǝa mgbicau arǝàm ngga, wu ɓinǝ pam gulo kǝla mǝfele a mǝsǝia a ban mùr.&gt;&gt; (Mùr mǝno ka nda mùr Meriba a Kadesh aɓa pǝɗanban Zin.) <verse eid="NUM 27:14" /><verse number="15" style="v" sid="NUM 27:15" />Musa ne Yahweh ama, <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />&lt;&lt;Ɓǝ̀ Yahweh, Ɓakuli mala abangŋo mala aɓwana kat, twal ɓeɓwa amur ɓwabundǝa man, <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />mǝnana nǝ̀ dupia wia a dǝmba, nǝ̀ gingnǝia aɓalǝ acau kat ka, ace mǝnana aɓwana mala Yahweh ɓǝà kǝa pa kǝla anzur mana à ɗwanyi yalu ka ɗàng.&gt;&gt;<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />Osso Yahweh ne Musa ama, &lt;&lt;Twal Jesǝwa muna-ɓwabura mala Nun, ɓwa mǝnana Bangŋo na aɓalǝi ka, tsǝk buo amurí. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />Kyan nǝi kya tamsǝi aɓadǝm Eleaza pǝris sǝ a ɓadǝm ɓwabundǝa puppup, sǝ wu pe wi <note caller="+" style="f"><char style="fr" closed="false">27:19 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 3:28">Nggur 3:28</ref>; <ref loc="DEU 31:7">31:7</ref>,<ref loc="DEU 31:8">8</ref></char>.</note>gara mala pàktúró a mǝsǝia. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />Awu nǝ pe wi gara mala bancame mô, ace mǝnana ɓwabundǝa mala amǝ Isǝrayila kat ɓǝà oki wi ka. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Ace súrǝ̀ nê mem ngga Jesǝwa nǝ̀ cam aɓadǝm Eleaza pǝris, mǝnana nǝ̀ paktúró nǝ Urim aɓadǝm Yahweh ace ɗìbancau aceì abanam ngga. Nǝ sà'arǝban male sǝ yì andǝ ɓwabundǝa mala amǝ Isǝrayila puppup ka à nǝ̀ puro, sǝ nǝ sà'arǝban male sǝ à nǝ̀ nyare.&gt;&gt; <verse eid="NUM 27:21" /><verse number="22" style="v" sid="NUM 27:22" />Musa pa kǝla mana Yahweh banggi wi ka. Warinǝ Jesǝwa sǝ kya tamsǝi aɓadǝm Eleaza pǝris, sǝ a ɓadǝm ɓwabundǝa puppup. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Pǝlǝa tsǝki wi buì amurí sǝ tsǝì a túrô, kǝla mana Yahweh ne wi ka.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s">Apagir mala koya pwari</para>
  <para style="pi">
    <verse number="1" style="v" sid="NUM 28:1" />Yahweh banggi Musa ama, <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama, &lt;Wu sǝlǝa ma, wun nǝ̀ pà ɓoro mem, yì pàgir mala girlina mem, mǝnana à pè nǝ bǝsa, mala pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga; wun nǝ̀ pè a pwari mǝnana ǝn tsǝk ka.&gt; <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />Awu nǝ banggia wia ama, &lt;Mǝnia ka nda pàgir nǝ bǝsa mǝnana wun nǝ̀ yinǝi abanam Yahweh ka:<note caller="+" style="f"><char style="fr" closed="false">28:3 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 29:38-41">Pur 29:38-41</ref></char>.</note> amuna-gam ɓari mǝnana mbulea mwashat-mwashat sǝ kǝgìr mǝɓane pà kàm arǝia raka, kǝla pàgir mala pisǝe kǝring mana wun nǝ̀ nggǝ pa ba koya pwari ka. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Wun nǝ̀ pà muna-gam mwashat nǝ dǝmbari, sǝ ɓè ka nǝ pwarikpǝra, <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />atārǝia andǝ pàgir mala mǝsǝsa, tyang mwashat mala muku mǝɓǝlke mǝnana à zurì nǝ dù-lita mwashat mala mùrú olif ka. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Mǝnia nda pàgir mala pisǝe kǝring mǝnana à nǝ̀ nggǝ pa pwari-pwari, mǝnana à kwakite a Nkono Saina ka. Pàgir na nǝ bǝsa abanam Yahweh ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />A masǝlǝate ka, komǝye atà apa'girnkila mǝnia yià kǝm ngga, wun nǝ̀ so dù-lita mwashat mala mùr-anap amur gyangŋan, ɓǝ̀ duk pàgir mala girnùná mǝcandǝe abanam Yahweh a ban-mǝfele. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Pàgir nǝ ɓaria muna-gam ngga, ɓǝà pè nǝ pwarikpǝra atārǝia andǝ pàgir mala mǝsǝsa andǝ pàgir mala girnùná mǝmwashati andǝ mǝnana wu pà nǝ dǝmbari ka. Mǝnia ka pàgir na nǝ bǝsa abanam Yahweh ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga.<verse eid="NUM 28:8" /></para>
  <para style="s">Apagir mala Sabbat</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />&lt;&lt; &lt;A pwari Sabbat ka, wun nǝ̀ pà amuna-gam ɓari mǝnana mbulea mwashat-mwashat sǝ ɓè kǝgìr mǝɓane pà kàm arǝia raka, andǝ pàgir mala mǝsǝsa, tyang ɓari mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, andǝ pàgir mala girnùná male: <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Mǝnia ka nda pàgir mala pisǝe kǝring a koya pwari Sabbat, tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, atārǝia andǝ pàgir mala girnùná male.<verse eid="NUM 28:10" /></para>
  <para style="s">Apagir mala koya zongŋo</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />&lt;&lt; &lt;A pwari mǝdǝmbe mala koya zongŋo ka, wun nǝ̀ yinǝ pàgir mala pisǝe kǝring abanam Yahweh: ajamnda ɓari, andǝ gam mwashat, andǝ amuna-gam tongno-nong-ɓari mana mbulea mwashat-mwashat sǝ ɓè kǝgir mǝɓane pà kàm arǝia raka. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Atà koya jamnda ka wun nǝ̀ pà tyang tàrú mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male; atà gam ngga wun nǝ̀ pà tyang ɓari mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male; <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />sǝ atà koya muna-gam ngga, wun nǝ̀ pà tyang mwashat mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male. Mǝnia ka nda ace pàgir mala pisǝe kǝring, pàgir na nǝ bǝsa mala pà rǝmban mǝɓoarne abanam Yahweh mǝnana kǝ pwasǝbumam ngga. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Wun nǝ̀ pà ɓoro mala girnùná, dù-lita ɓari mala mùr-anap atà koya jamnda, dù-lita mwashat nǝ gauwa-tsùrú male atà gam, sǝ dù-lita mwashat atà koya muna-gam. Mǝnia ka nda pàgir mala pisǝe kǝring, mala koya zongŋo aɓalǝ azongŋo mala pǝlǝa. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />Ɗǝm ngga wun nǝ̀ pà gbato mwashat abanam Yahweh ɓǝ̀ duk pàgir mala gǝshi cauɓikea; wun nǝ̀ pà mǝnia yì pàgir ka ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, atārǝia andǝ pàgir mala girnùná male.<verse eid="NUM 28:15" /></para>
  <para style="s">Apagir mala Lamsan mala bǝredi <optbreak /> mana yis pà arǝì raka</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />&lt;&lt; &lt;Lum-nong-inea pwari mala zongŋo mǝdǝmbe ka, nda pwari Yàlîmurû ace gusǝlǝam Yahweh. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />A lum-bwamdǝ-tongnoia pwari mala mǝnia yì zongŋo ka, à nǝ̀ tita lamsan; wun nǝ̀ twal anongŋo tongno-nong-ɓari, bǝredi mana yis pa arǝì raka nda wun nǝ̀ lì ka. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />A pwari mǝdǝmbe ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele; pà wu nǝ̀ pàk kǝ túró mǝnana wu pàkiyi pwari-pwari ka ɗàng. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />A kún mani ka, wu pà ɓoro mala pisǝe kǝring, yì pàgir nǝ bǝsa abanam Yahweh: ajamnda ɓari, gam mwashat, sǝ amuna-gam tongno-nong-ɓari mana mbulea mwashat-mwashat, sǝ ɓè kǝgir mǝɓane pà kàm arǝia raka. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Atà koya jamnda ka wu pà tyang tàrú mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male; atà gam ngga wu pà tyang ɓari; <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />sǝ atà koya mwashat atà amuna-gam tongno-nong-ɓari ka, wu pà tyang mwashat. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />Ɗǝm ngga wun nǝ̀ pà gbato mwashat ɓǝ̀ duk pàgir mala gǝshi cauɓikea, ace shawuɗi wun. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Wun nǝ̀ pà amǝnia ka ɓǝà tsǝa-amur pàgir mala pisǝe kǝring mǝnana wu pākiyi pwari-pwari nǝ dǝmbari ka. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Ani sǝ wun nǝ̀ pà girlina mala pàgir nǝ bǝsa koya pwari arǝ anongŋo tongno-nong-ɓari, ace pà rǝmban mǝɓoarne abanam Yahweh. Wun nǝ̀ pà amǝnia ka ɓǝà tsǝa-amur pàgir mala pisǝe kǝring, mǝnana wu pākiyi pwari-pwari atārǝia andǝ pàgir mala girnùná male ka. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />A tongno-nong-ɓaria pwari ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele, sǝ pà wu nǝ̀ pàk kǝ túró mǝnana wu pàkiyi pwari-pwari ka ɗàng.<verse eid="NUM 28:25" /></para>
  <para style="s">Apagir ace lamsan mala Alimo</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />&lt;&lt; &lt;Lang wun nǝ̀ pàgir mala bǝsa mǝsǝsa a pwari mala aɓǝlagir-mǝdǝmbe abanam Yahweh, a tita lamsan mala alimo ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele, sǝ pà wu nǝ̀ pàk kǝ túró mǝnana wu pàkiyi pwari-pwari ka ɗàng. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />A kún mani ka, wun nǝ̀ pàgir mala pisǝe kǝring, mala pa rǝmban mǝɓoarne abanam Yahweh: ajamnda ɓari, gam mwashat, sǝ amuna-gam tongno-nong-ɓari mana mbulea mwashat-mwashat ka; <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Atà koya jamnda ka wun nǝ̀ pà tyang tàrú mala muku mǝɓǝlke mana à zurì nǝ mùrú olif ka, ɓǝ̀ duk pàgir mala mǝsǝsa male; atà gam ngga wu pà tyang ɓari; <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />sǝ atà koya mwashat atà amuna-gam tongno-nong-ɓari ka, wu pà tyang mwashat. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />Ɗǝm ngga wun nǝ̀ pà gbato mwashat ace shawuɗi wun. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Wu pà amǝnia ka atārǝia andǝ apagir mala girnùná malea, ɓǝà tsǝa-amur pàgir mala pisǝe kǝring mǝnana wu pākiyi pwari-pwari ka atārǝia andǝ pàgir mala mǝsǝsa male. Wu tsǝkir wun ama agirkusǝu mǝnia ka ɓǝà kǝa pàngnǝ ɓè kǝgir mǝɓane arǝia ɗàng.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s">Apagir mala Lamsan mala twanggi Anjawe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />&lt;&lt; &lt;A pwari mǝdǝmbe mala tongno-nong-ɓaria zongŋo ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele. Pà wun nǝ̀ pàk kǝ túró mǝnana wu pàkkiyi pwari-pwari ka ɗàng. Nǝ̀ dupa wun pwari twanggi anjawe. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Wun nǝ̀ yinǝ pàgir mala pisǝe kǝring abanam Yahweh ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga: jamnda mwashat, gam mwashat, sǝ amuna-gam tongno-nong-ɓari mana mbulea mwashat-mwashat, sǝ kǝ mǝɓane pà kàm arǝia raka. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />Sǝ pàgir mala mǝsǝsa malea ka, nǝ̀ duk muku mǝɓǝlke mǝnana à zurì nǝ mùrú olif ka: tyang tàrú ace jamnda, tyang ɓari ace gam, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />sǝ tyang mwashat ace koya mwashat atà muna-gam tongno-nong-ɓari. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Ɗǝm ngga wun nǝ̀ pà gbato mwashat ɓǝ̀ duk pàgir mala gǝshi cauɓikea, ace shawuɗi wun; <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />apagir mǝnia ka à nǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana wu pākiyi a koya zongŋo andǝ pàgir mala mǝsǝsa male ka, andǝ pàgir mala pisǝe kǝring mǝnana à kǝ pà pwari-pwari ka, nǝ malea yì pàgir mala mǝsǝsa andǝ pagir mala girnùná malea kǝla mana nggurcau malea kanì ka; pàgir na nǝ bǝsa abanam Yahweh, mala pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga.<verse eid="NUM 29:6" /></para>
  <para style="s">Agir'nkila a Pwari Mǝgule mala Twalban cauɓikea</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />&lt;&lt; &lt;A lumia pwari mala mǝnia yì tongno-nong-ɓaria zongŋo ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele, sǝ wun nǝ̀ ginǝì ɓamur rǝ wun agir. Pà wun nǝ̀ pàk kǝ túró aɓalǝi ɗàng. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />A kún mani ka, wun nǝ̀ yinǝ pàgir mala pisǝe kǝring abanam Yahweh, ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga: jamnda mwashat, gam mwashat, sǝ amuna-gam tongno-nong-ɓari mana mbulea mwashat-mwashat sǝ kǝ mǝɓane pà kàm arǝia raka. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Sǝ pàgir mala mǝsǝsa malea ka, nǝ̀ duk muku mǝɓǝlke mana à zurì nǝ mùrú olif ka: tyang tàrú ace jamnda, tyang ɓari ace gam, <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />sǝ tyang mwashat ace koya mwashat atà muna-gam tongno-nong-ɓari. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Ɗǝm ngga wun nǝ̀ pà gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala gǝshi cauɓikea ace shawuɗiban, andǝ pàgir mala pisǝe kǝring mǝnana à kǝ pa pwari-pwari ka, andǝ pàgir mala mǝsǝsa male, andǝ apagir mala girnùná malea.<verse eid="NUM 29:11" /></para>
  <para style="s">Pàgir ace Lamsan mala Do aɓalǝ Agumli</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />&lt;&lt; &lt;A lum-bwamdǝ-tongnoia pwari mala tongno-nong-ɓaria zongŋo ka, wun nǝ̀ yiu ace ramba-banɓwáná mǝfele, sǝ pà wun nǝ̀ pàk kǝ túró mǝnana wu pàkkiyi pwari-pwari ka ɗàng. Wun nǝ̀ pàk lamsan mala nongŋo tongno-nong-ɓari abanam Yahweh. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Sǝ wun nǝ̀ yinǝ pàgir mala pisǝe kǝring, pàgir nǝ bǝsa, mala pà rǝmban mǝɓoarne abanam Yahweh, mǝnana kǝ pwasǝbumam ngga: ajamnda lum-nong-tàrú, agam ɓari, amuna-gam lum-nong-ine, mǝnana mbulea mwashat-mwashat, sǝ kǝ mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />sǝ pàgir mala mǝsǝsa malea ka, nǝ̀ duk muku mǝɓǝlke mana à zurì nǝ mùrú olif ka: tyang tàrú ace komǝye atà ajamnda tongno-nong-tàrú, tyang ɓari ace komǝye atà agam ɓari, <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />sǝ tyang mwashat ace koya mwashat atà amuna-gam lum-nong-ine; <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />sǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mana à pākiyi pwari-pwari, andǝ pàgir mala mǝsǝsa male, andǝ pàgir mala girnùná male.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />&lt;&lt; &lt;A ɓaria pwari ka wun nǝ̀ pàgir nǝ ajamnda lum-nong-ɓari, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat, sǝ kǝ mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />sǝ gbato mwashat ace pagir mala cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ apagir mala girnùná malea.<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />&lt;&lt; &lt;A tàruià pwari ka, wun nǝ̀ pà ajamnda lum-nong-mwashat, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat sǝ kǝ mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />&lt;&lt; &lt;A inea pwari ka, wun nǝ̀ pà ajamnda lum, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />&lt;&lt;&lt;A tongnoia pwari ka, wun nǝ̀ pà ajamnda tongno-nong-ine, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />&lt;&lt; &lt;A tongno-nong-mwashatia pwari ka, wun nǝ̀ pà ajamnda tongno-nong-tàrú, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />&lt;&lt;&lt;A tongno-nong-ɓaria pwari ka, wun nǝ̀ pà ajamnda tongno-nong-ɓari, agam ɓari, sǝ amuna-gam lum-nong-ine mǝnana mbulea mwashat-mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace ajamnda, ace agam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />&lt;&lt; &lt;A tongno-nong-tàruià pwari ka, wun nǝ̀ ramba abanɓwáná ace peri. Pà wun nǝ̀ pàk kǝ túró mǝnana wu pàkkiyi pwari-pwari ka ɗàng; <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />a kún mani ka, wun nǝ̀ pàgir mala pisǝe kǝring, pàgir nǝ bǝsa abanam Yahweh, ace pà rǝmban mǝɓoarne mǝnana kǝ pwasǝbumam ngga: jamnda mwashat, gam mwashat, sǝ amuna-gam tongno-nong-ɓari mǝnana mbulea mwashat-mwashat sǝ ɓekǝ gìr mǝɓane pà kàm arǝia raka; <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />atārǝia andǝ pàgir mala mǝsǝsa andǝ apagir mala girnùná ace jamnda, ace gam, sǝ ace amuna-gam mǝnia ka, ɓǝà karǝa arǝ làkkì malea kǝla mana nggurcau kanì ka; <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />andǝ gbato mwashat ace pàgir mala gǝshi cauɓikea, ɓǝ̀ tsǝa-amur pàgir mala pisǝe kǝring mǝnana à pākiyi pwari-pwari ka, andǝ pàgir mala mǝsǝsa male andǝ pàgir mala girnùná male.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />&lt;&lt; &lt;Wun nǝ̀ yinǝ apagir mǝnia ka abanam Yahweh arǝ apwari mala alamsan mǝnana à tsǝk ka, ɓǝà tsǝa-amur apagir mala pàcau nǝ-shambum ma'wun, andǝ apagir mala eare mala ɓabum wun, ace apagir mala pisǝe kǝring ma'wun, sǝ ace apagir mala mǝsǝsa ma'wun, sǝ ace apagir mala girnùná ma'wun, sǝ ace apagir mala dotarǝu ma'wun.&gt; &gt;&gt;<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />Musa bangcau nǝ amǝ Isǝrayila amur agir mǝnana kat Yahweh banggi wi ka.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s">Anggurcau mala pàcau aban Yahweh</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Musa bangcau nǝ amúrû mala atau mala amǝ Isǝrayila ama, &lt;&lt;Mǝnia ka nda cau mǝnana Yahweh na ka. <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />Ɓǝ̀ ɓwa pàcau nǝ-shambum abanam Yahweh, ko kùr ɓamurì nǝ kána ama nǝ̀ pàk gìr ka, ɓwe ɓǝkǝa nggaɗi kúni ɗàng; ɓǝ̀ pàk gìr mǝnana kat pur a kúni ka.<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />&lt;&lt;Ɓǝ̀ ɓwama kǝla lo-ɓwa, mǝnana nda a ɓala mala tárrí, pàcau nǝ-shambum abanam Yahweh sǝ kùr ɓamurì nǝ kána amur ɓè gìr, <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />sǝ tárrí ok pàcau nǝ-shambum male andǝ kána mǝnana kùrna ɓamurì nǝi, sǝ ne ɓwame kǝ cau raka, dumǝna púp ama ɓwame nǝ̀ lùmsǝ apacau male andǝ koya kána mǝnana kùrna ɓamurì nǝi ka. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Sǝama ɓǝ̀ tárrí ɓinǝi wi a pwari mǝnana okce ka, ɓwame purni bwalban mala pàcau nǝ-shambum male, ko kána mǝnana kùrna ɓamurì nǝi ka. Sǝ Mim Yahweh ka, mǝ nǝ twali-wi-bani, acemǝnana tárrí ɓinǝni wi ka.<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />&lt;&lt;Ɓǝ̀ ɓwama mǝnana malaká albura ɗang pàcau nǝ-shambum, ko mburkuni kaurǝa pàcau mǝnana kùr ɓamurì nǝi, sǝ nǝnzǝ́mò ka, yi albura, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />sǝ burí okce ka; sǝ lang burí okce ka ne wi kǝ cau amurí raka, dumǝna púp ɓwame nǝ̀ lùmsǝ pàcau nǝ-shambum male andǝ kána mǝnana kùrna ɓamurì nǝi ka. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Sǝama ɓǝ̀ burí ɓinǝì wi, lang okce ka, burí nǝ̀ panzǝi ɓǝ̀ purî mǝno yì pàcau nǝ-shambum amurí, andǝ cau mǝnana mburkuni bangŋi aɓa kaurǝa sǝ kùrna ɓamurì nǝi ka. Sǝ Mim Yahweh ka, mǝ nǝ twali-wi-bani.<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />&lt;&lt;Sǝama mā-lú ko ɓwama mana à gauwuna doɓala ka, dumǝna púp nǝ̀ bwal koya pàcau nǝ-shambum mǝnana twal andǝ kána mǝnana kùrna ɓamurì nǝi ka.<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />&lt;&lt;Sǝ ɓǝ̀ ɓwama mǝnana nda a ɓala mala burí pàcau nǝ-shambum, ko kùr ɓamurì nǝ kána, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />sǝ burí okce sǝ na kǝ cau ɗang, sǝ ɓinǝi wi raka, dumǝna púp ɓwame nǝ̀ lùmsǝ gìr mǝnana kat pàcau ace nǝ-shambum, ko kána mǝnana kùrna ɓamurì nǝi ka. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Sǝama ɓǝ̀ burí pǝrki arǝ lùmsǝ mǝno yì pàcau nǝ-shambum, a pwari mǝnana okce ka, gìr mǝnana kat pur a kún ɓwame amur pàcau nǝ-shambum male, ko amur kána mǝnana kùrna ɓamurì nǝi ka, pà nǝ̀ cam ɗang. Sǝ Mim Yahweh ka, mǝ nǝ twali-wi-bani, acemǝnana burí ɓinǝni wi ka. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />Bura ɓwama nǝ̀ gandǝ eari wi, sǝ nǝ̀ gandǝ ɓinǝi wi arǝ koya pàcau nǝ-shambum ko kána mǝnana twalo nǝ̀ ginǝi ɓamurì gìr ka. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Sǝama ɓǝ̀ burí na kǝ cau ɗàng, nongŋo anzǝm nongŋo ka, lǝmdǝ ama earna nǝ apacau nǝ-shambum kat andǝ akána mǝnana kat amur māmí ka. Ɗwanyi na kǝ cau male aban māmí lang ok acê ka lǝmdǝ ama earna nǝia. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Sǝama ɓǝ̀ tamsǝ māmí arǝ lùmsǝ amǝno yì apacau ko akána, anzǝm mǝnana okce ka, dumǝna púp bafe mala cauɓikea mala māmí nǝ̀ pà amurí.&gt;&gt;<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />Amǝnia ka à nda ka anggurcau mana Yahweh pe Musa amur cau mala ɓwabura andǝ māmí, sǝ amur cau mala tárrû andǝ nsarile mǝnana lo-ɓwa na piu a ɓala mala tárrí ka.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s">Mbweban-tanni amur amǝ Midiyan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />Sǝ Yahweh nacau nǝ Musa, ama, <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />&lt;&lt;Kyan nǝ mbweban-tanni amur amǝ Midiyan ace gìr mǝnana à pàkkî amǝ Isǝrayila ka.<note caller="+" style="f"><char style="fr" closed="false">31:2 </char><char style="fq" closed="false">amǝ Midiyan ace gìr mǝnana à pàkkî amǝ Isǝrayila ka; </char><char style="ft" closed="false">ɓalli aɓa: </char><char style="xt"><ref loc="NUM 25:1-18">Ɓal 25:1-18</ref></char>.</note> Anzǝm mana a pángŋǝ̀nà mǝno ka, sǝ awu nǝ wǔ a nǝ o atà akeô.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">31:2 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 20:24-26">Ɓal 20:24-26</ref>; <ref loc="NUM 27:13">27:13</ref>; <ref loc="DEU 32:50">Nggur 32:50</ref></char>.</note><verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />Pǝlǝa Musa bangcau nǝ aɓwana ama, &lt;&lt;Wu twal aburana aɓalǝ wun ɓǝà mārǝ́ rǝia ace kánǝ lwa arǝ amǝ Midiyan, ace pa mbweban-tanni mala Yahweh<note caller="+" style="f"><char style="fr" closed="false">31:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="PSA 18:47">Ang 18:47</ref>; <ref loc="PSA 79:10">79:10</ref>; <ref loc="PSA 94:1">94:1</ref>; <ref loc="JER 11:20">Ir 11:20</ref></char>.</note> amur amǝ Midiyan. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Aburana á-mwashat ɓǝà puro a koya tàu mala Isǝrayila sǝ wun nǝ tasǝia aban ká lwa.&gt;&gt; <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />Nda à tàrki aburana á-lum-nong-ɓari (12,000) mǝnana à marǝna rǝia ace lwa ka, aburana á-mwashat a koya tàu mala amǝ Isǝrayila. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Sǝ Musa tasǝia ɓǝà kya lwa-lwa, amǝ'lwa á-mwashat a koya tàu, atārǝia andǝ Finehas muna-ɓwabura mala Eleaza pǝris, mǝnana twal atanggǝla mala ban-mǝfele, andǝ anjawe tunǝban ace lwa ka, a buì. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />À lwa-lwa arǝ amǝ Midiyan, kǝla mana Yahweh banggi Musa ka, sǝ à wal-lú koya ɓwabura. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Atà acili aɓwana mǝnana à walia ka, à wal amurǝma mala amǝ Midiyan: Evi, andǝ Rekem, andǝ Zur, andǝ Hur, andǝ Reba, yìa ka amurǝma na tongno mala amǝ Midiyan.<note caller="+" style="f"><char style="fr" closed="false">31:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 13:21-22">Jes 13:21-22</ref></char>.</note> Sǝ Bil'am muna-ɓwabura mala Beyo<note caller="+" style="f"><char style="fr" closed="false">31:8 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 22:5-24:25">Ɓal 22:5--24:25</ref></char>.</note> gbal ka à wal-luí nǝ nggeabyau. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Amǝ Isǝrayila bwalki amamǝna andǝ amuna mǝkeke mala amǝ Midiyan. À pwan adomwan mala andá andǝ anzur andǝ ambul malea, andǝ agirkuma malea kat kǝla gǝna-lwa. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />À pisǝki alá andǝ abân mǝnana kat amǝ Midiyan duk kam ngga, kat andǝ akàttì malea. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />À pwan gǝna-lwa kat andǝ aguro-lwa kat, mala aɓwapǝndǝa andǝ agirkusǝu, à umnǝia. <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />À yinǝ aɓwana mǝnana à bwalia kǝla aguro-lwa ka, andǝ akume-lwa aban Musa andǝ Eleaza pǝris, andǝ ɓwabundǝa mala amǝ Isǝrayila, a là-gumli a ɓawanban mala nzali Mowap, a nkanggari nggeasala Jodan a nkaring Jeriko.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Musa andǝ Eleaza pǝris, andǝ aɓwana-mǝgule mala ɓwabundǝa puro ace ká kullia anzǝm là-gumli. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Sǝ Musa ka pak-bumlulla nǝ amǝgulo mala amǝ'lwa, andǝ aburana mǝnana à nda ka amǝ'sàrǝ̀ban amur á-á mala amǝ'lwa andǝ amana amur gbǝman-gbǝman mala amǝ'lwa, mǝnana à nyàrî lwa ka.<verse eid="NUM 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 31:15" />Ɗia ama, &lt;&lt;Ace mana sǝ wu nying amamǝna mǝnia ka kat nǝyilǝmu? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Kǝ à nda mǝnana à kpata kanigir mala Bil'am<note caller="+" style="f"><char style="fr" closed="false">31:16 </char><char style="fq" closed="false">kanigir mala Bil'am </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 24:14">Ɓal 24:14</ref>; <ref loc="2PE 2:15">2Bit 2:15</ref>; <ref loc="REV 2:14">Sǝn 2:14</ref></char>.</note><note caller="+" style="f"><char style="fr" closed="false">31:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 25:1-9">Ɓal 25:1-9</ref></char>.</note> sǝ à tsǝk amǝ Isǝrayila à dumnǝ ɗwanyi-mǝsǝcau arǝ Yahweh atàcau mala Piyor ka re? Yià na à tsǝa sǝ kwánó-twàl-là wal ɓwabundǝa mala Yahweh ka.<note caller="+" style="f"><char style="fr" closed="false">31:16 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 25">Ɓal 25</ref>; <ref loc="DEU 20:18">Nggur 20:18</ref>; <ref loc="2PE 2:15">2Bit 2:15</ref>; <ref loc="REV 2:14">Sǝn 2:14</ref></char>.</note> <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Adyan ngga, wu wal-lú amuna aburana. Sǝ wu wal-lú koya ɓwama mǝnana súrǝ́nà ɓwabura ka. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Sǝ amuna mamǝna mǝnana à malaká súrǝ̀ ɓwabura raka, wu ɗekia nǝyilǝmu ace ɓamurǝ wun.<note caller="+" style="f"><char style="fr" closed="false">31:18 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 21:10-14">Nggur 21:10-14</ref></char>.</note> <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Koyan atà wun mǝnana wal-lú kǝɓwa ko je lú ka, dumǝna púp nǝ̀ do anzǝm kàttì ba nongŋo tongno-nong-ɓari. A tàruià nongŋo andǝ tongno-nong-ɓaria nongŋo ka, dumǝna púp wun nǝ̀ lak ɓamur rǝ wun andǝ aguro-ɓwa ma'wun. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Sǝ koya gìr'nggūrǝu ma'wun gbal ka wun nǝ̀ le, kat andǝ koya gìr mǝnana à pè nǝ nggú, andǝ koya gìr mǝnana à pè nǝ nyang mbul, andǝ koya gìr mǝnana à pè nǝ nggun ngga.&gt;&gt;<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Pǝlǝa Eleaza pǝris banggi amǝ'lwa mǝnana à wari a lwa ka, ama, &lt;&lt;Mǝnia ka nda nê mala nggurcau mǝnana Yahweh pè Musa ka: <verse eid="NUM 31:21" /><verse number="22-23" style="v" sid="NUM 31:22-23" />Koya gìr mǝnana nǝ̀ gandǝ cambi bǝsa, kǝla bolo-njengǝlan, andǝ bolo-azǝrfa, andǝ bolo-bángŋá, andǝ bolo-candǝa, andǝ bolo-gwan'gwang, andǝ bolo-dànà ka, wun nǝ̀ oasǝi a bǝsa, sǝ nǝ̀ ɓoarnsari. Sǝama dumǝna púp wun nǝ̀ lé nǝ mùr lakban gbal. Sǝ gìr mǝnana kat pà nǝ̀ gandǝ cambi bǝsa raka, wun nǝ̀ lé nǝ mùr mǝno. <verse eid="NUM 31:22-23" /><verse number="24" style="v" sid="NUM 31:24" />A tongno-nong-ɓaria pwari ka, wun nǝ̀ lakki agir-nggūrǝu ma'wun, sǝ wun nǝ̀ ɓoarnsari. Anzǝm mǝno ka wun nǝ̀ gandǝ kùtí a kàttì.&gt;&gt;<verse eid="NUM 31:24" /></para>
  <para style="s">Gau gǝna-lwa</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />Yahweh banggi Musa ama, <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />&lt;&lt;We wunǝ Eleaza pǝris, wunǝ aɓwana-mǝgule amur aɓala-kàu mala ɓwabundǝa, wu gilǝ koman mǝnana kat à pwani arǝ amǝ Midiyan ngga, kat andǝ aɓwapǝndǝa andǝ agirkusǝu, <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />sǝ wu gau gǝna-lwa arǝ abanì ɓari; banì mwashat ace amǝ'lwa mǝnana à wari a munǝo ka, sǝ ɓè banì ka ace cili ɓwabundǝa. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Aɓa gìr mǝnana mala amǝ'lwa na ka, wu pusǝ mwashat aɓa koya gbǝman-tongno mala aguro-ɓwa, andǝ mwashat aɓa koya gbǝman-tongno mala andá, andǝ mala amǝdambǝriso, andǝ mala anzur, andǝ mala ambul, sǝ wu tsǝia ɗàng ace pà cemi aban Yahweh. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />Twal agir cemi mǝnia mǝnana à pusǝì aɓa kāmbe mala amǝ'lwa ka sǝ wu pe Eleaza pǝris, ɓǝ̀ duk gìr pǎ aban Yahweh. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Aɓa kāmbe mǝnana nda ace amǝ Isǝrayila ka, twal mwashat aɓa koya lumi-tongno mala aguro-ɓwa, andǝ mala andá, andǝ mala amǝdambǝriso, andǝ mala anzur, andǝ mala ambul, yì anyam-lǝsǝa kat, sǝ wu pê Amǝ'Lawi mǝnana à pàkkiyi túró ɓá Taragula mala Yahweh ka.&gt;&gt; <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Nda Musa andǝ Eleaza pǝris pàk kǝla mǝnana Yahweh banggi Musa ka. <verse eid="NUM 31:31" /><verse number="32" style="v" sid="NUM 31:32" />Cili gir mǝnana ueo aɓa gǝna-lwa mǝnana amǝ'lwa pwan ngga nda:</para>
  <para style="li1" vid="NUM 31:32">anzur á-gbǝman-tongno-nong-mwashat nǝ á-lumi-tongno-nong-ɓari nǝ á-tongno (675,000),<verse eid="NUM 31:32" /></para>
  <para style="li1">
    <verse number="33" style="v" sid="NUM 31:33" />andá á-lumi-tongno-nong-ɓari nǝ á-ɓari (72,000),<verse eid="NUM 31:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="NUM 31:34" />amǝdambǝriso á-lumi-tongno-nong-mwashat nǝ á-mwashat (61,000),<verse eid="NUM 31:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="NUM 31:35" />ansarina mǝnana à malaká súrǝ̀ ɓwabura raka á-lumi-tàrú nǝ á-ɓari (32,000).<verse eid="NUM 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 31:36" />Sǝ kāmbe mǝnana kútí a bu amǝ'lwa ka:</para>
  <para style="li1" vid="NUM 31:36">anzur á-gbǝman-tàrú nǝ á-lumi-tàrú-bwamdǝ-tongno-nong-ɓari nǝ gbǝman-tongno (337,500) na,<verse eid="NUM 31:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="NUM 31:37" />sǝ cemi mala anzur ace Yahweh ka gbǝman-tongno-nong-mwashat nǝ lumi-tongno-nong-ɓari nǝ mǝsǝi tongno (675) na.<verse eid="NUM 31:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="NUM 31:38" />Andá ka á-lumi-tàrú-bwamdǝ-tongno-nong-mwashat na (36,000),</para>
  <para style="li1" vid="NUM 31:38">sǝ aɓalǝia ka à pusǝ cemi, andá á-tongno-nong-ɓari nǝ mǝsǝi ɓari (72) ace Yahweh.<verse eid="NUM 31:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="NUM 31:39" />Amǝdambǝriso ka á-lumi-tàrú nǝ gbǝman-tongno na (30,500),</para>
  <para style="li1" vid="NUM 31:39">sǝ aɓalǝia ka à pusǝ cemi, amǝdambǝriso lumi-tongno-nong-mwashat nǝ mǝsǝi mwashat (61) ace Yahweh.<verse eid="NUM 31:39" /></para>
  <para style="li1">
    <verse number="40" style="v" sid="NUM 31:40" />Aguro-ɓwa ka, á-lum-bwamdǝ-tongno-nong-mwashat na (16,000),</para>
  <para style="li1" vid="NUM 31:40">sǝ aɓalǝia ka à pusǝ cemi, aguro-ɓwa lumi-tàrú nǝ mǝsǝi ɓari (32) ace Yahweh.<verse eid="NUM 31:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="NUM 31:41" />Pǝlǝa Musa pè Eleaza pǝris cemi mǝnia ɓǝ̀ duk pàgir aban Yahweh, kǝla mǝnana Yahweh banggi Musa ka.<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 31:42" />Kāmbe mǝnana nda ace amǝ Isǝrayila, mǝnana Musa tàrì tsǝì ɗàng nǝ mala amǝ'lwa mana à wari a munǝo, <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />yì kāmbe mala ɓwabundǝa ka nda ani:</para>
  <para style="li1" vid="NUM 31:43">anzur á-gbǝman-tàrú nǝ á-lumi-tàrú-bwamdǝ-tongno-nong-ɓari nǝ gbǝman-tongno (337,500),<verse eid="NUM 31:43" /></para>
  <para style="li1">
    <verse number="44" style="v" sid="NUM 31:44" />andá á-lumi-tàrú-bwamdǝ-tongno-nong-mwashat (36,000),<verse eid="NUM 31:44" /></para>
  <para style="li1">
    <verse number="45" style="v" sid="NUM 31:45" />amǝdambǝriso á-lumi-tàrú nǝ gbǝman-tongno (30,500),<verse eid="NUM 31:45" /></para>
  <para style="li1">
    <verse number="46" style="v" sid="NUM 31:46" />ansarina á-lum-bwamdǝ-tongno-nong-mwashat (16,000).<verse eid="NUM 31:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="NUM 31:47" />Aɓa kāmbe mala amǝ Isǝrayila ka Musa tàrki mwashat-mwashat aɓa koya lumi-tongno mala ansarina andǝ mala agirkusǝu, sǝ kǝla mǝnana Yahweh banggi wi ka, pè Amǝ'Lawi mǝnana à kǝ tsǝkir Taragula mala Yahweh ka.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Pǝlǝa amǝgulo mala amǝ'lwa andǝ amǝ'sàrǝ̀ban mǝnana amur amǝ'lwa á-á, andǝ amǝ'sàrǝ̀ban amur amǝ'lwa gbǝman-gbǝman ngga à yiu aban Musa. <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />À banggi wi ama, &lt;&lt;Sǝm aguro mò ka sǝm ɓalna amǝ'lwa mǝnana à wari a munǝo aɓata sǝm ngga, sǝ kǝɓwa pà kàm mǝnana ɓwar aɓalǝ sǝm ngga ɗàng. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Sǝ ndya sǝm yinǝi Yahweh ɓoro mala agir njengǝlan mǝnana koyan atà sǝm pwan ngga; ambaga, andǝ agirgarabu, andǝ agirmunabu, andǝ agirkiru, sǝ anlang-ɓamyalu. Mǝnia ka nda ace shawuɗi ayilǝmi sǝm aɓadǝm Yahweh.&gt;&gt;<verse eid="NUM 31:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 31:51" />Sǝ Musa andǝ Eleaza pǝris ak agir mǝno kat à tùllia nǝ bolo-njengǝlan ngga a buia. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Dǝmbǝrya mala bolo-njengǝlan mǝnana amǝ'sàrǝ̀ban amur amǝ'lwa á-á, andǝ amǝ'sàrǝ̀ban amur amǝ'lwa gbǝman-gbǝman yinǝi sǝ à pà ɓoro nǝi aban Yahweh kat-kat ka, shekel á-lum-bwamdǝ-tongno-nong-mwashat nǝ gbǝman-tongno-nong-ɓari nǝ lumi-tongno na (16,750). <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />Koya mǝ'lwa ka pwan gǝna-lwa ace ɓamurì. <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Sǝ Musa andǝ Eleaza pǝris ka à ak bolo-njengǝlan mǝno a bu amǝ'sàrǝ̀ban amur amǝ'lwa á-á, andǝ amǝ'sàrǝ̀ban amur amǝ'lwa gbǝman-gbǝman, sǝ à yinǝi aɓa Tara Ban-peri, ace mǝnana ɓǝ̀ duk gìr kasǝɓalǝu<note caller="+" style="f"><char style="fr" closed="false">31:54 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 30:16">Pur 30:16</ref></char>.</note> aɓadǝm Yahweh ka.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s">Atau a njar-takuli mala Nggeasala Jodan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Aɓwana a tàu mala Ruben andǝ tàu mala Gad ka à ndanǝ agirkusǝu kǝ̀rkǝ́r mǝnana à kǝ yália ka. Lang à sǝni ama nzali Jaza andǝ nzali Gilǝyat ka abân mǝɓoarne na ace yál agirkusǝu ka, <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />à wari aban Musa andǝ Eleaza pǝris, sǝ aban aɓwana-mǝgule mala ɓwabundǝa, sǝ à bang ama, <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />&lt;&lt;Bu-nzali mala alá Atarot, andǝ Dibon, andǝ Jaza, andǝ Nimra, andǝ Heshbon, andǝ Eleyale, andǝ Sebam, andǝ Nebo, sǝ Beyon, <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" />yì nzali mǝnana Yahweh lì nǝ lwa aɓadǝm ɓwabundǝa mala amǝ Isǝrayila ka, nzali mǝɓoarne na ace yál agirkusǝu, sǝ sǝm aguro mò ka, sǝm ndanǝ andá, andǝ ambulpǝndǝa andǝ anzur pas. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Ida, pà sǝm nzali man ɓǝ̀ duk girkuma ma'sǝm. Kǝa kyan nǝ sǝm a nkaring Nggeasala Jodan ɗàng.&gt;&gt;<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Sǝ Musa earî aburana mala tàu mala Gad andǝ aburana mala tàu mala Ruben, ama, &lt;&lt;Wu kǝ earce ama wun nǝ̀ duk kani sǝ cili amǝ'eam wun amǝ Isǝrayila ka ɓǝà o a lwa le? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Ace mana sǝ wun nǝ̀ ɓungi ɓabum amǝ Isǝrayila arǝ eauwe a nkaring aban ká aɓa nzali mǝnana Yahweh pania wia ka? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Mǝnia nda gìr mǝnana aká wun pǎ lang ǝn turia a Kadesh-Baniya ɓǝà kya sǝn nzalî ka. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Lang à warina a ɓangŋaban Eshkol sǝ à sǝna nzalî ka, à ɓungi ɓabuma amǝ Isǝrayila arǝ ká aɓa nzali mǝnana Yahweh angŋa dǝmba pània wia ka. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Nda bumlulla mala Yahweh earke a pwari mǝno, sǝ kángìr ama, <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />&lt;Acemǝnana aburana mǝno à pur a Masar, mǝnana pǝlǝa malea lumi-ɓari aban ká dǝmba, mǝnana à kpatam nǝ ɓabumia kat raka, mǝsǝcau kǝɓwa pà kàm ateà mǝnana nǝ̀ sǝn nzali mana ǝn kángìr ama mǝ nǝ pè Ibǝrayim, sǝ Ishaku, sǝ Yakupu ka ɗàng, <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />she Kalip muna-ɓwabura mala Jefune ɓwa-Keniz, andǝ Jesǝwa muna-ɓwabura mala Nun; kǝ yia nǝmurǝia à nda mǝnana à kpatam nǝ ɓabumia mwashat ka.&gt; <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Nda bumlulla mala Yahweh earki-bǝsa arǝ Isǝrayila, tsǝa à camarǝ gali a ɓabondo apǝlǝa lumi-ine, she lang nza mala aɓwana mǝnana à pàk ɓealɓikea a ɓamǝsǝ Yahweh ka, teà twalna ka. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />Sǝ ado ka, wun yì bǝsa nza mala amǝ'cauɓikea ka, ndya wu longŋǝ́nà a kusǝ aká wun, ace tsǝk bumlulla kàm piu amur bumlulla mǝ'earke mala Yahweh arǝ Isǝrayila ka! <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />Ɓǝ̀ wu pǝlǝ nzǝm wun arǝ kpate ka, nǝ̀ vwakibuì ɗǝm arǝ aɓwana mǝnia ka a ɓabondo, sǝ à nǝ̀ bwal wun nǝ cau mala yinǝ kiɗiki malea.&gt;&gt;<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Pǝlǝa à sungŋo a baní sǝ à na ama, &lt;&lt;Sǝm nǝ̀ ɓakki ankāndan ace agirkusǝu ma'sǝm akani, sǝ sǝm nǝ̀ gumbǝli anggea-là nǝ asheran ace amuna mǝkeke ma'sǝm; <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />sǝ sǝm ngga, sǝm nǝ̀ kùr rǝ sǝm aɓa gilǝrǝu ace ká lwa, sǝ sǝm nǝ̀ akì acili atau mala Isǝrayila dǝmba aban kánǝ munǝo sheɓǝ̀ sǝm yina nǝia à dumǝna a ban mǝnana nǝ̀ duk malea ka. Anggo ka amuna mǝkeke ma'sǝm nǝ̀ do aɓalǝ anggea-là mǝnana sǝm gumbǝlinia nǝ asheran ngga ace yália arǝ aɓwana mala nzali man. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Sǝm ngga, pà sǝm nǝ̀ nyare arǝ aɓala ma'sǝm ɗàng, she pwari mǝnana koya ɓwa Isǝrayila kumǝna nzali liɓala male ka. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Sǝm ngga, pà sǝm nǝ̀ twal kǝ nzali liɓala sǝnǝia a nkaring Nggeasala Jodan andǝ ban mǝnana o a dǝmba ka ɗàng, acemǝnana sǝm angŋa dǝmba sǝm kumǝna nzali liɓala ma'sǝm a mǝnia yì buì mala Nggeasala Jodan a njar-takuli ka.&gt;&gt;<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Pǝlǝa Musa banggia wia ama, &lt;&lt;Ɓǝ̀ mbak wun nǝ̀ pàk mǝnia ka, akani aɓadǝm Yahweh, wu kùr rǝ wun ace ká lwa. <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />Wun aburana mǝnana wu kùrna rǝ wun ngga, wun nǝ̀ yàlî nggeasala Jodan aɓadǝm Yahweh, ace kánǝ munǝo arǝ aɓimǝbura bà pwari mǝnana Yahweh linamurǝm amúrià, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />sǝ nzalî ka à yinanǝi aɓata rǝcandǝa mala Yahweh ka. Anzǝm mǝno ka wun nǝ̀ gandǝ nyare wun nǝ̀ o, acemǝnana anggo ka wu lùmsǝ̀nà túró ma'wun aban Yahweh, sǝ aban Isǝrayila. Sǝ nzali mǝnia ka nǝ̀ duk girkuma ma'wun aɓadǝm Yahweh. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" />Sǝama ɓǝ̀ pà wun nǝ̀ pàk anggo raka, mǝsǝcau wu pàngŋǝ́nì Yahweh cauɓikea, sǝ ɓǝ̀ wu sǝlǝa ama cauɓikea ma'wun nǝ̀ pusǝta wun. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Wu gumbǝlî amuna mǝkeke ma'wun anggea-là nǝ asheran, sǝ wu ɓakkî agirkusǝu ma'wun ankāndan, sǝ wu pàk gìr mǝnana wu pàcau ama wun nǝ̀ pàk ka.&gt;&gt;<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />Pǝlǝa aburana mala tàu mala Gad andǝ aburana mala tàu mala Ruben banggi Musa ama, &lt;&lt;Sǝm aguro mò ka, sǝm nǝ̀ pa kǝla mǝnana we ɓwamǝgule ma'sǝm a bang ngga. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Amuna ma'sǝm, andǝ amālá sǝm, andǝ anzur andǝ ambul ma'sǝm, andǝ andá ma'sǝm kat ka, à nǝ̀ ue kani aɓalǝ anggea-là mala Gilǝyat; <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />sǝ sǝm aguro mò, koya ɓwabura mǝnana kùrna rǝì ace lwa ka, nǝ̀ yàl a nkaring Jodan ace ká munǝo aɓadǝm Yahweh, kǝla mǝnana we ɓwamǝgule ma'sǝm a bang ngga.&gt;&gt;<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />Pǝlǝa Musa bangcau nǝ Eleaza pǝris, andǝ Jesǝwa muna-ɓwabura mala Nun, andǝ aɓwana-mǝgule amur aɓala-kàu mala atau mala amǝ Isǝrayila, amúr cau mala aburana mǝno ka. <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />Musa banggia wia ama, &lt;&lt;Ɓǝ̀ aburana mala tàu mala Gad andǝ aburana mala tàu mala Ruben, koyan mǝnana kùrna rǝì ace ká lwa ka, nǝ̀ yàlî Jodan atarǝ wun wunǝia aɓadǝm Yahweh, sǝ à nǝ̀ bwala wun nggam sheɓǝ̀ nzalî nyarna aɓata wun ngga, wun nǝ̀ pea wia nzali Gilǝyat ɓǝ̀ duk girkuma malea. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Sǝ ɓǝ̀ à yàlî Jodan atà wun aɓa kùrrǝu raka, dumǝna púp à nǝ̀ pea wia kāmbe mala girkuma aɓa nzali Kan'ana, kǝla mana wun nǝ̀ kum ngga.&gt;&gt; <verse eid="NUM 32:30" /><verse number="31" style="v" sid="NUM 32:31" />Pǝlǝa aburana mala tàu mala Gad andǝ aburana mala tàu mala Ruben, ear ama, &lt;&lt;Gìr mǝnana Yahweh bangga sǝm, sǝm aguro mò ka, nda gìr mǝnana sǝm nǝ̀ pàk ka. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Sǝm nǝ̀ yàlî Jodan nǝ agirbura aɓadǝm Yahweh ace ká munǝo aɓa nzali Kan'ana. Sǝama nzali mǝnana nǝ̀ duk girkuma ma'sǝm ace liɓala ka, nǝ̀ pàk kani a nkaring Jodan.&gt;&gt;<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />Nda Musa pè aburana mala tàu mala Gad, andǝ aburana mala tàu mala Ruben, andǝ aburana mala gauwa-tsùrú mala tàu mala Manasa, muna-ɓwabura mala Yisǝfu, bu-nzali andǝ anggea-là andǝ abân mǝnana à kària ka, mǝnana ɗiɗyal ka à nda aɓata domurǝm mala Sihon, murǝm mala amǝ'Amor ka, andǝ bu-nzali andǝ anggea-là andǝ abân mǝnana à kària, mǝnana ɗiɗyal ka à nda aɓata domurǝm mala Og murǝm Bashan ngga. Pea wia nzali mǝno kat, andǝ anggea-là mǝnana aɓalǝi ka andǝ abân mǝnana kat à kària ka.<verse eid="NUM 32:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 32:34" />Pǝlǝa aburana a tàu mala Gad ɓǝsǝlǝ ɓak alá Dibon, andǝ Atarot, andǝ Aruwa, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />andǝ Atǝrot-Shofan, andǝ Jaza, andǝ Jogbeha, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />andǝ Bet-Nimra andǝ Bet-Haran. À ɓakki asheran à gumbǝli anggea-lê, sǝ à ɓakki ankāndan ace tsǝk ambul andǝ anzur malea.<verse eid="NUM 32:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37" />Aburana a tàu mala Ruben ɓǝsǝlǝ ɓak alá Heshbon, andǝ Eleyale, andǝ Kiriyatem, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />andǝ Nebo, andǝ Baal-Meyon, sǝ Sipma. Lang à ɓǝsǝlǝ ɓak Nebo andǝ Baal-Meyon ngga, à nggaɗì anggea-là mǝnia ka alullǝia.<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />Sǝ amǝkà Makir muna-ɓwabura mala Manasa ka, à o a Gilǝyat, à kya ak nzalinì arǝ amǝ'Amor mǝnana à do aɓalǝi ka. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Nda Musa pè amǝkà Makir bu-nzali Gilǝyat, sǝ à do aɓalǝi ka.<verse eid="NUM 32:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 32:41" />Sǝ Jayir a tàu mala Manasa wario kya ak amuna-là a bu-nzali mǝno sǝ pea wia bǝsa lullǝu ama Havot-Jayir.<note caller="+" style="f"><char style="fr" closed="false">32:41 </char><char style="fq" closed="false">Havot-Jayir: </char><char style="ft" closed="false">ko &lt;&lt;amuna-là mala Jayir&gt;&gt; </char></note><verse eid="NUM 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 32:42" />Noba gbal ka wario sǝ kya ak là Kenat andǝ amuna-là mǝnana abanì ka, sǝ pè wi lullǝu ama Noba.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s">Bǝlɓa gya mala amǝ Isǝrayila twal a Masar aban ká Jodan</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Amǝnia ka à nda ka alullǝ abân mǝnana amǝ Isǝrayila wari kam aɓa gya malea, lang à purî ɓá nzali Masar arǝ atau malea aɓata gingnǝban mala Musa andǝ Haruna ka. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Kǝla mǝnana Yahweh tsǝki wi nzongcau ka, Musa gilǝ alullǝ abân mala agya malea lo a ɓè bân aban ká ɓè. Mǝnia ka nda gya malea a kunarǝia:<verse eid="NUM 33:2" /></para>
  <para style="pi">
    <verse number="3" style="v" sid="NUM 33:3" />Amǝ Isǝrayila lo a Rameses a lum-bwamdǝ-tongnoia pwari mala zongŋo mǝdǝmbe, yì pwari mana kpata Yàlîmurû ka. À puro aban o nǝ jali, a mǝsǝ amǝ Masar kat. <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />Lang à ndarǝ o ka, amǝ Masar na aban tsǝk alú amuna-dǝmba malea mǝnana kat Yahweh wal-luia aɓalǝia ka. Ɗǝm ngga Yahweh yinǝ ɓashi amur aɓakuli malea.<verse eid="NUM 33:4" /></para>
  <para style="pi">
    <verse number="5" style="v" sid="NUM 33:5" />Amǝ Isǝrayila lo gya a Rameses, sǝ à yi tsǝk kàttì a Sukkot.<verse eid="NUM 33:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="NUM 33:6" />À loapi Sukkot ka à twal gya sǝ à yi tsǝk kàttì a Etam, mǝnana nda a gírí pǝɗanban ngga.<verse eid="NUM 33:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="NUM 33:7" />À loapi Etam ngga à nyare aban ká Pi-Hahirot mǝnana nda a njar-takuli mala Ba'al-Zefon ngga, sǝ à tsǝk kàttì aɓadǝm Migdol.<verse eid="NUM 33:7" /></para>
  <para style="pi">
    <verse number="8" style="v" sid="NUM 33:8" />Pǝlǝa à loapi Hahirot sǝ à kùtí nǝ tsùrú mala nggeamùr, à kya pur aɓa pǝɗanban; sǝ à twal gya mala nongŋo tàrú aɓa Pǝɗanban Etam, sǝ à yi tsǝk kàttì a Mara.<verse eid="NUM 33:8" /></para>
  <para style="pi">
    <verse number="9" style="v" sid="NUM 33:9" />À loapi Mara ka à twal gya à yiu a Elim; a Elim ngga amáɗí-mùr nakam lum-nong-ɓari andǝ anggun nkangga lumi-tongno-nong-ɓari (70), sǝ à tsǝk kàttì abanì.<verse eid="NUM 33:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="NUM 33:10" />À loapi Elim ngga à twal gya sǝ à yi tsǝk kàttì a kún Nggeamùr Nzuno.<verse eid="NUM 33:10" /></para>
  <para style="pi">
    <verse number="11" style="v" sid="NUM 33:11" />À loapi Nggeamùr Nzuno ka à twal gya sǝ à yi tsǝk kàttì aɓa Pǝɗanban Sin.<verse eid="NUM 33:11" /></para>
  <para style="pi">
    <verse number="12" style="v" sid="NUM 33:12" />À loapi Pǝɗanban Sin ngga à twal gya sǝ à yi tsǝk kàttì a Dofka.<verse eid="NUM 33:12" /></para>
  <para style="pi">
    <verse number="13" style="v" sid="NUM 33:13" />À loapi Dofka ka à twal gya sǝ à yi tsǝk kàttì a Alush.<verse eid="NUM 33:13" /></para>
  <para style="pi">
    <verse number="14" style="v" sid="NUM 33:14" />À loapi Alush ka à twal gya sǝ à yi tsǝk kàttì a Rifidim, ban mǝnana murnuna pa kàm ace aɓwe raka.<verse eid="NUM 33:14" /></para>
  <para style="pi">
    <verse number="15" style="v" sid="NUM 33:15" />À loapi Rifidim ngga à twal gya sǝ à yi tsǝk kàttì a Pǝɗanban Saina.<verse eid="NUM 33:15" /></para>
  <para style="pi">
    <verse number="16" style="v" sid="NUM 33:16" />À loapi Pǝɗanban Saina ka à twal gya sǝ à yi tsǝk kàttì a Kibǝrot-hatava.<verse eid="NUM 33:16" /></para>
  <para style="pi">
    <verse number="17" style="v" sid="NUM 33:17" />À loapi Kibǝrot-hatava ka à twal gya sǝ à yi tsǝk kàttì a Hazerot.<verse eid="NUM 33:17" /></para>
  <para style="pi">
    <verse number="18" style="v" sid="NUM 33:18" />À loapi Hazerot ka à twal gya sǝ à yi tsǝk kàttì a Ritma.<verse eid="NUM 33:18" /></para>
  <para style="pi">
    <verse number="19" style="v" sid="NUM 33:19" />À loapi Ritma ka à twal gya sǝ à yi tsǝk kàttì a Rimon-perez.<verse eid="NUM 33:19" /></para>
  <para style="pi">
    <verse number="20" style="v" sid="NUM 33:20" />À loapi Rimon-perez ka à twal gya sǝ à yi tsǝk kàttì a Libna.<verse eid="NUM 33:20" /></para>
  <para style="pi">
    <verse number="21" style="v" sid="NUM 33:21" />À loapi Libna ka à twal gya sǝ à yi tsǝk kàttì a Rissa.<verse eid="NUM 33:21" /></para>
  <para style="pi">
    <verse number="22" style="v" sid="NUM 33:22" />À loapi Rissa ka à twal gya sǝ à yi tsǝk kàttì a Kehelata.<verse eid="NUM 33:22" /></para>
  <para style="pi">
    <verse number="23" style="v" sid="NUM 33:23" />À loapi Kehelata ka à twal gya sǝ à yi tsǝk kàttì a Nkono Shefer.<verse eid="NUM 33:23" /></para>
  <para style="pi">
    <verse number="24" style="v" sid="NUM 33:24" />À loapi Nkono Shefer ka à twal gya sǝ à yi tsǝk kàttì a Harada.<verse eid="NUM 33:24" /></para>
  <para style="pi">
    <verse number="25" style="v" sid="NUM 33:25" />À loapi Harada ka à twal gya sǝ à yi tsǝk kàttì a Makelot.<verse eid="NUM 33:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="NUM 33:26" />À loapi Makelot ka à twal gya sǝ à yi tsǝk kàttì a Tahat.<verse eid="NUM 33:26" /></para>
  <para style="pi">
    <verse number="27" style="v" sid="NUM 33:27" />À loapi Tahat ka à twal gya sǝ à yi tsǝk kàttì a Tera.<verse eid="NUM 33:27" /></para>
  <para style="pi">
    <verse number="28" style="v" sid="NUM 33:28" />À loapi Tera ka à twal gya sǝ à yi tsǝk kàttì a Mitka.<verse eid="NUM 33:28" /></para>
  <para style="pi">
    <verse number="29" style="v" sid="NUM 33:29" />À loapi Mitka ka à twal gya sǝ à yi tsǝk kàttì a Hashmona.<verse eid="NUM 33:29" /></para>
  <para style="pi">
    <verse number="30" style="v" sid="NUM 33:30" />À loapi Hashmona ka à twal gya sǝ à yi tsǝk kàttì a Mosera.<verse eid="NUM 33:30" /></para>
  <para style="pi">
    <verse number="31" style="v" sid="NUM 33:31" />À loapi Mosera ka à twal gya sǝ à yi tsǝk kàttì a Bene-Jaakan.<verse eid="NUM 33:31" /></para>
  <para style="pi">
    <verse number="32" style="v" sid="NUM 33:32" />À loapi Bene-Jaakan ngga à twal gya sǝ à yi tsǝk kàttì a Hor-haggidgad.<verse eid="NUM 33:32" /></para>
  <para style="pi">
    <verse number="33" style="v" sid="NUM 33:33" />À loapi Hor-haggidgad ka à twal gya sǝ à yi tsǝk kàttì a Jotbata.<verse eid="NUM 33:33" /></para>
  <para style="pi">
    <verse number="34" style="v" sid="NUM 33:34" />À loapi Jotbata ka à twal gya sǝ à yi tsǝk kàttì a Abrona.<verse eid="NUM 33:34" /></para>
  <para style="pi">
    <verse number="35" style="v" sid="NUM 33:35" />À loapi Abrona ka à twal gya sǝ à yi tsǝk kàttì a Eziyon-Geba.<verse eid="NUM 33:35" /></para>
  <para style="pi">
    <verse number="36" style="v" sid="NUM 33:36" />À loapi Eziyon-Geba ka à twal gya sǝ à yi tsǝk kàttì a Kadesh, a ɓabondo Zin.<verse eid="NUM 33:36" /></para>
  <para style="pi">
    <verse number="37" style="v" sid="NUM 33:37" />À loapi Kadesh ka, à twal gya sǝ à yi tsǝk kàttì a Nkono Hor, a nzong-nzali Edom. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" />Pǝlǝa Yahweh bangcau ama ɓǝ̀ Haruna pǝris ɓǝ̀ eau a Nkono Hor; kàm sǝ Haruna kya wú, a pwari mǝdǝmbe mala tongnoia zongŋo mala lumi-inea pǝlǝa, anzǝm puro mala amǝ Isǝrayila a nzali Masar.<note caller="+" style="f"><char style="fr" closed="false">33:38 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 20:23-29">Ɓal 20:23-29</ref></char>.</note> <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Haruna ka ndanǝ apǝlǝa gbǝman-mwashat nǝ lumi-ɓari nǝ mǝsǝi tàrú sǝ wú amur Nkono Hor.<verse eid="NUM 33:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40" />Murǝm Arat, ɓwa Kan'ana mǝnana ndanǝdo a Negev a nzali Kan'ana ka ok cau mala yiu mala amǝ Isǝrayila.<verse eid="NUM 33:40" /></para>
  <para style="pi">
    <verse number="41" style="v" sid="NUM 33:41" />Amǝ Isǝrayila loapi Nkono Hor ka, à twal gya sǝ à yi tsǝk kàttì a Zalmona.<verse eid="NUM 33:41" /></para>
  <para style="pi">
    <verse number="42" style="v" sid="NUM 33:42" />À loapi Zalmona ka, à twal gya sǝ à yi tsǝk kàttì a Punon.<verse eid="NUM 33:42" /></para>
  <para style="pi">
    <verse number="43" style="v" sid="NUM 33:43" />À loapi Punon ngga, à twal gya sǝ à yi tsǝk kàttì a Oboh.<verse eid="NUM 33:43" /></para>
  <para style="pi">
    <verse number="44" style="v" sid="NUM 33:44" />À loapi Oboh ka, à twal gya sǝ à yi tsǝk kàttì a Iye-abarim, a nzong-nzali Mowap.<verse eid="NUM 33:44" /></para>
  <para style="pi">
    <verse number="45" style="v" sid="NUM 33:45" />À loapi Iye-abarim ngga, à twal gya sǝ à yi tsǝk kàttì a Dibon-gad.<verse eid="NUM 33:45" /></para>
  <para style="pi">
    <verse number="46" style="v" sid="NUM 33:46" />À loapi Dibon-gad ka, à twal gya sǝ à yi tsǝk kàttì a Almon-diblatayim.<verse eid="NUM 33:46" /></para>
  <para style="pi">
    <verse number="47" style="v" sid="NUM 33:47" />À loapi Almon-diblatayim ngga, à twal gya sǝ à yi tsǝk kàttì aɓalǝ ankono Abarim tù aban Nebo.<verse eid="NUM 33:47" /></para>
  <para style="pi">
    <verse number="48" style="v" sid="NUM 33:48" />À loapi ɓalǝ ankono Abarim ngga, à twal gya sǝ à yi tsǝk kàttì a ɓawanban mala nzali Mowap, a kún Nggeasala Jodan a Jeriko. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />À tsǝk là-gumli a kún Nggeasala Jodan, twal a Beth-jeshimot kya pur a Abel-shittim, a ɓawanban mala Mowap.<verse eid="NUM 33:49" /></para>
  <para style="s">Nzongcau mala Yahweh ɓǝà ak nzali Kan'ana nǝ lwa</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />Pǝlǝa Yahweh nacau nǝ Musa a ɓawanban mala nzali Mowap a kún Nggeasala Jodan, a Jeriko, ama, <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />&lt;&lt;Bangcau nǝ amǝ Isǝrayila ama, &lt;Lang wu yàlnà a nkaring Nggeasala Jodan, aɓa nzali Kan'ana ka, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />dumǝna púp wun nǝ̀ pǝr aɓwapǝndǝa<note caller="+" style="f"><char style="fr" closed="false">33:52 </char><char style="fq" closed="false">aɓwapǝndǝa </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="EXO 23:23-24">Pur 23:23-24</ref>,<ref loc="EXO 23:31-33">31-33</ref>; <ref loc="EXO 34:12-13">34:12-13</ref>; <ref loc="DEU 7:1-5">Nggur 7:1-5</ref>; <ref loc="DEU 12:2-3">12:2-3</ref></char>.</note> mǝnana à dukiyi kam ngga ɓǝà o. Wu arki aɓǝ̀nzál tali malea kat, wu kiɗiki aɓǝ̀nzál bolo malea, sǝ wu bǝbbǝriki amgbangban ndàka-lú malea. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />Sǝ wun nǝ̀ ak nzalî kat ɓǝ̀ duk girkuma ma'wun, wu duk kam aɓalǝi; ǝn pana wun nzalinì ɓǝ̀ duk ma'wun. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Wun nǝ̀ gau nzalinì amur atau ma'wun nǝ bwal-shishar. Tàu mǝnana mǝgule na ka, wu kasǝia wia nzali kpǝm, sǝ tàu mǝnana mǝkyauwe na ka, wu pea wia nzali bǝti. Nzali liɓala mǝnana ɓwa kumo nǝ bwal-shishar ka, nda nǝ̀ duk male ka. Wun nǝ̀ gau nzalinì amur atau mala aká wun.<verse eid="NUM 33:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="NUM 33:55" />&lt;&lt; &lt;Sǝama ɓǝ̀ wu pǝr aɓwana mǝnana à do a nzalinì, wu ak nzali arǝia raka, yià mǝno wu ɗekia sǝ à ue ka, à nǝ̀ dupa wun kǝla kwa a mǝsǝ wun, sǝ kǝla azwe a nkanggari wun; à nǝ̀ zunggǝli wun aɓa nzali mǝnana wun nǝ̀ duk kam ngga. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Sǝ kǝla mana ǝn kanì mǝ nǝ pangnǝia ka, anggo sǝ mǝ nǝ pàngnǝ wun.&gt; &gt;&gt;<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s">Kasǝki anzong-nzali a nzali Kan'ana</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />Yahweh bangcau nǝ Musa, ama, <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama, &lt;Wun ndo wun nǝ̀ kùtí aɓa nzali Kan'ana, nzali mǝnana nǝ̀ duk ma'wun ace liɓala ka. Amǝnia ka à nda ka anzong ɓá nzalinì, yì nzali Kan'ana:<verse eid="NUM 34:2" /></para>
  <para style="pi">
    <verse number="3" style="v" sid="NUM 34:3" />&lt;&lt; &lt;Nzong-nzali mǝnana a njar-kunmur ka, nǝ̀ nongŋo a bare pǝɗanban Zin mǝnana sárǝ́ arǝ nzong-nzali mala nzali Edom ngga. Nǝ̀ tite nǝ takuli a masǝlǝata Nggeamùr Tuɓamur a buì mǝnana nǝ njar-kunmur ka. <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />Nǝ̀ lo kano ka nǝ̀ sárǝ́ aban ká Eauwe Akǝrabim, nǝ̀ lidǝmba nǝ ká aɓa Pǝɗanban Zin, sǝ nǝ̀ nggá go a Kadesh-Baniya nǝ njar-kunmur. Nǝ̀ lo kano ka, nǝ̀ sarǝa aban ká Hazar-addar, sǝ nǝ̀ bik Azǝmon. <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />Lo a Azǝmon ngga nzong-nzalinì nǝ̀ kàr aban ká ɓangŋaban nzong-nzali Masar, sǝ nǝ̀ masǝlǝa a Nggeamùr Mediterani.<verse eid="NUM 34:5" /></para>
  <para style="pi">
    <verse number="6" style="v" sid="NUM 34:6" />&lt;&lt; &lt;Nzong-nzali mǝnana a njar-nzali ka, nda kún Nggeamùr Mediterani. Mǝno ka nǝ̀ duk nzong mala nzali ma'wun a njar-nzali.<verse eid="NUM 34:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="NUM 34:7" />&lt;&lt; &lt;Nzong-nzali ma'wun a njar-nza ka nǝ̀ lo a kún Nggeamùr Mediterani aban ká Nkono Hor. <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />Twal kano ka nǝ̀ sarǝa aban ká Lebo-Hamat. Nǝ̀ lidǝmba aban ká a Zedat, <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />sǝ aban ká Zifǝron, sǝ nǝ̀ masǝlǝa a Hazar-enan. Mǝnia ka nda nzong-nzali ma'wun a njar-nza.<verse eid="NUM 34:9" /></para>
  <para style="pi">
    <verse number="10" style="v" sid="NUM 34:10" />&lt;&lt; &lt;Nzong-nzali ma'wun a njar-takuli ka, nǝ̀ tite a Hazar-enan aban o a Shefam. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Nǝ̀ twal a Shefam sǝ nǝ̀ sarǝa aban ká Ribǝla a njar-takuli mala Ayin. Pǝlǝa nǝ̀ lidǝmba a kusǝ ankono mǝnana a njar-takuli mala Nggeamùr Galili ka. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />Nzong-nzali man nǝ̀ sulǝo nǝ̀ yia pǝlǝa a kún Nggeasala Jodan sǝ nǝ̀ nggá masǝlǝa a Nggeamùr Tuɓamur.</para>
  <para style="pi" vid="NUM 34:12">&lt;&lt; &lt;Mǝnia ka nda nǝ̀ duk nzali ma'wun, nǝ anzong-nzali male a koya buì ka.&gt; &gt;&gt;<verse eid="NUM 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />Pǝlǝa Musa banggi amǝ Isǝrayila ama, &lt;&lt;Mǝnia nda nzali mǝnana wun nǝ̀ gauwi nǝ bwal-shishar ka, yì nzali mana Yahweh pà nzongcau ama ɓǝà pè atau tongno-nong-ine nǝ gauwa-tsùrú mala tàu ka. <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />Amǝkà Ruben a tàu malea, andǝ amǝkà Gad a tàu malea, andǝ gauwa-tsùrú mala amǝkà Manasa a tàu malea ka, à angŋǝna dǝmba à kumǝna nzali liɓala malea. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />Yì atau ɓari andǝ gauwa-tsùrú mala tàu mǝnia ka, à pania wia nzali liɓala malea a nkaring Nggeasala Jodan a nkāɓe Jeriko.&gt;&gt;<verse eid="NUM 34:15" /></para>
  <para style="s">Aɓwana-mǝgule mǝnana à nǝ̀ gau nzali ka</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />Yahweh bangcau nǝ Musa ama, <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />&lt;&lt;Amǝnia ka, à nda ka alullǝ aburana mǝnana à nǝ̀ gapa wun nzali ace liɓala ka: Eleaza pǝris andǝ Jesǝwa muna-ɓwabura mala Nun. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Sǝ awu nǝ twal múrû mwashat aɓa koya tàu ace bwalia wia arǝ túró gau nzali liɓala. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Amǝnia ka à nda ka alullǝ aburane:</para>
  <para style="li1" vid="NUM 34:19">&lt;&lt;A tàu mala Yahuda ka, Kalip muna-ɓwabura mala Jefune;<verse eid="NUM 34:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20" />&lt;&lt;A tàu mala amǝkà Shimiyon ngga, Shemuyel muna-ɓwabura mala Ammihud;<verse eid="NUM 34:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21" />&lt;&lt;A tàu mala Benjami ka, Elidad muna-ɓwabura mala Chislon;<verse eid="NUM 34:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22" />&lt;&lt;A tàu mala amǝkà Dan ngga, ɓwamǝgule Bukki, muna-ɓwabura mala Jogǝli;<verse eid="NUM 34:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23" />&lt;&lt;Atà amuna-burana mala Yisǝfu:</para>
  <para style="li1" vid="NUM 34:23">&lt;&lt;A tàu mala amǝkà Manasa ka, ɓwamǝgule Haniyel, muna-ɓwabura mala Efot;<verse eid="NUM 34:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24" />&lt;&lt;A tàu mala amǝkà Ifǝrem ngga, ɓwamǝgule Kemuyel, muna-ɓwabura mala Shiftan;<verse eid="NUM 34:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25" />&lt;&lt;A tàu mala amǝkà Zebulu ka, ɓwamǝgule Elizafan, muna-ɓwabura mala Parnach;<verse eid="NUM 34:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26" />&lt;&lt;A tàu mala amǝkà Isaka ka, ɓwamǝgule Paltiyel, muna-ɓwabura mala Azzan;<verse eid="NUM 34:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27" />&lt;&lt;A tàu mala amǝkà Asha ka, ɓwamǝgule Ahihud, muna-ɓwabura mala Shelomi;<verse eid="NUM 34:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28" />&lt;&lt;A tàu mala amǝkà Naftali ka, ɓwamǝgule Pedahel, muna-ɓwabura mala Ammihud.&gt;&gt;<verse eid="NUM 34:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="NUM 34:29" />Amǝnia ka à nda ka aɓwana mǝnana Yahweh tsǝa ama ɓǝà gau nzali liɓala amur amǝ Isǝrayila aɓa nzali Kan'ana ka.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s">Anggea-là ace Amǝ'Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Yahweh bangcau nǝ Musa a ɓawanban mala nzali Mowap a nkanggari Nggeasala Jodan a nkaring Jeriko ama, <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />&lt;&lt;Banggi amǝ Isǝrayila ama: Aɓa liɓala mala nzali mǝnana girkuma malea na ka, ɓǝà pè Amǝ'Lawi aɓea anggea-là mǝnana à nǝ̀ duk kam ngga, andǝ nzali-yálgìr tù aban anggea-lê. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Anggea-lê nǝ̀ duk mala Amǝ'Lawi ace do malea, sǝ aɓawanban malea ace yál agir ka, à nǝ̀ pà ace andá, andǝ anzur, andǝ ambul, andǝ acili agirkusǝu malea.<verse eid="NUM 35:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 35:4" />&lt;&lt;Ban-yálgìr mala nggea-là, mǝnana wun nǝ̀ pè Amǝ'Lawi ka, dumǝna púp tangŋa male, twal arǝ asheran mala nggea-lê ka, ɓǝ̀ pàk mita gbǝman-ine nǝ lumi-tongno (450) a koya buì. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Ɗǝm ngga wun nǝ̀ kasǝ banfana mǝnana tangŋa male ka mita gbǝman-tongno-nong-ine (900) na ka, zak nǝ nggea-là a koya buì, a njar-takuli, a njar-kunmur, a njar-nzali sǝ a njar-nza, ɓǝ̀ tsǝk nggea-là a tsùrú. Banfana mǝnia ka nǝ̀ duk ban-yálgìr ace anggea-là.<note caller="+" style="f"><char style="fr" closed="false">35:5 </char><char style="fq" closed="false">anggea-là </char><char style="ft" closed="false">ko acilia anggea-là</char></note><verse eid="NUM 35:5" /></para>
  <para style="s">Anggea-là mala kum-àwá</para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />&lt;&lt;Tongno-nong-mwashat atà anggea-là mǝnana wun nǝ̀ pè Amǝ'Lawi ka, à nǝ̀ duk anggea-là mala kum-àwá,<note caller="+" style="f"><char style="fr" closed="false">35:6 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 21:12-14">Pur 21:12-14</ref>; <ref loc="DEU 4:41-43">Nggur 4:41-43</ref>; <ref loc="DEU 19:1-13">19:1-13</ref>; <ref loc="JOS 20:2-9">Jes 20:2-9</ref></char>.</note> mǝnana ɓǝ̀ ɓwa wal-lú ka nǝ̀ gandǝ ɓangŋa nǝ̀ ká kàm ngga. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Anggea-là kat-kat mǝnana dumǝna púp wun nǝ̀ pè Amǝ'Lawi, atārǝia andǝ abân-yálgìr malea ka, à nǝ̀ pàk lumi-ine bwamdǝ tongno-nong-tàrú (48). <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Làkkì mala anggea-là mǝnana amǝ Isǝrayila nǝ̀ pè Amǝ'Lawi aɓalǝ girkuma malea ka, à nǝ̀ kārǝi arǝ gulo mala gìr'liɓala mǝnana koya tàu kum ngga: Tàu mǝnana ndanǝ anggea-là pas ka, à nǝ̀ pà pas, sǝ tàu mǝnana ndanǝia bǝti ka, à nǝ̀ pà bǝti.&gt;&gt;<verse eid="NUM 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />Pǝlǝa Yahweh banggi Musa ama: <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />&lt;&lt;Nacau nǝ amǝ Isǝrayila sǝ wu banggia wia ama: Anzǝm mana wu yalnì Nggeasala Jodan sǝ wu dumǝna a nzali Kan'ana ka, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />wu tàr aɓea anggea-là ɓǝà duk anggea-là mala kum-àwá, mǝnana ɓǝ̀ ɓwa wal-lú aɓa turturo ka nǝ̀ ɓangŋa nǝ̀ ká kàm ngga. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Anggea-lê nǝ̀ duk abân-auwa ace mǝ'wal-lú ɓǝ̀ apî ɓalbura mala ɓǝla mala ɓwa mǝnana à wal-lui ka, ace mǝnana mǝ'wal-lú ka ɓǝ̀ kǝa wǔ ɗàng she cê ka aɓwana-mǝgule dumǝna-ɓashi male ka. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Anggea-là mǝno tongno-nong-mwashat wun nǝ̀ pà ka, à nǝ̀ duk anggea-là ma'wun mala kum-àwá. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Wun nǝ̀ pà anggea-là tàrú a nkaring Jodan sǝ anggea-là tàrú aɓa nzali Kan'ana; à nǝ̀ duk anggea-là mala kum-àwá. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Anggea-là mǝno tongno-nong-mwashat ka, à nǝ̀ duk abân-auwa ace amǝ Isǝrayila andǝ amǝ'kúnɗàngna mǝnana à ndanǝdo aɓalǝ wun ngga, ace mǝnana koyan mana wal-lú ɓwa aɓa-turturo ka, nǝ̀ gandǝ ɓangŋa nǝ̀ ká kàm.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />&lt;&lt; &lt;Ɓǝ̀ ɓwa tùl ɓeɓwa nǝ gìr bolo-candǝa sǝ lú pùr-aɓalǝi ka, ɓwê dumǝna mǝ'wal-lú, sǝ yì mǝ'wal-lú ka dumǝna púp à nǝ̀ wal-luí. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />A ɓè njar ka, ɓǝ̀ ɓwa nanǝ tali a buì sǝ ɓù ɓeɓwa nǝi, gandǝa wal-luí ka, ɓwê dumǝna mǝ'wal-lú, sǝ yì mǝ'wal-lú ka dumǝna púp à nǝ̀ wal-luí. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />A ɓè njar ɗǝm ngga, ɓǝ̀ ɓwa nanǝ girtúró mala nggun a buì, mǝnana nǝ̀ gandǝ wal-lú, sǝ walna ɓeɓwa nǝi, gandǝa wal-luí ka, ɓwê ka dumǝna mǝ'wal-lú, sǝ yì mǝ'wal-lú ka dumǝna púp à nǝ̀ wal-luí. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Ɓǝla mala ɓwa mǝno à wal-luí ka nda ɓwa mǝnana nǝ̀ wal-lú mǝ'wal-lú ka. Lang kumǝni ka ɓǝ̀ wal-luí. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" />Anggo gbal, ɓǝ̀ ɓwa nanǝ bumkpǝmna sǝ jambǝrǝ ɓeɓwa, ko kùmsǝi wi sǝ ɓuì nǝ ɓekǝgìr gandǝa wal-luí, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />ko tùllì nǝ bui aɓa ɓinǝmǝsǝu, sǝ wal-luí ka, ɓwê ka dumǝna púp à nǝ̀ wal-luí; yì ka mǝ'wal-lú na. Ɓǝ̀ ɓǝla mala ɓwa mǝno à wal-luí ka ɓǝ̀ wal-lú ɓwê a pwari mana à je ka.<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />&lt;&lt; &lt;Sǝama ɓǝ̀ ɓwa jambǝrǝ ɓeɓwa hǝrkit sǝ bumkpǝmna pà kàm aɓalǝi ɗàng, ko túr ɓekǝgìr arǝ ɓeɓwa, sǝ shambi nǝ kǝ mǝɓane ɗàng, <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />ko ɓwa twal tali mǝdǝmbǝre a buì mǝnana nǝ̀ gandǝ wal-lú, sǝ tsǝk-mǝsǝì ɗàng, pǝlǝa nying buì arǝ tali sǝ yi kpa amur ɓeɓwa sǝ wal-luí, sǝ ɓwê ka à pà aɓa ɓike andǝi ɗàng, sǝ yì ka pà aban alte nǝ̀ tsǝki wi npenye raka, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />aɓwana a nggea-là ɓǝà kùtí aɓa cê ɓǝà pàkɓashi anre mǝ'túrtúro andǝ ɓǝla mala lú mǝnana kǝ ɓalbure ka; ɓashinì ka ɓǝà pè nǝ kpata anzongcau mǝnia ka: <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Dumǝna púp aɓwana a nggea-là nǝ̀ amsǝ mǝ'túrtúro a bù ɓǝla mala lú mǝnana kǝ ɓalbure ka, sǝ à nǝ̀ tsǝkte ɓǝ̀ nyare a nggea-là mala kum-àwá mǝnana ɓangŋa wari kam ngga. Dumǝna púp nǝ̀ ue kano ba lú mala Pǝris Mǝgule. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />Sǝama ɓǝ̀ mǝ'túrtúro, a koya pwari, sǝ purî ɓá nggea-là mala kum-àwá mana ɓangŋa wari kam, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />sǝ ɓǝla mala lú mana kǝ ɓalbure ka kumi a nza nǝ nggea-là mala kum-àwá ka, ɓǝla mala lú mǝnana kǝ ɓalbure ka nǝ̀ gandǝ wal-luí, sǝ à pà nǝ̀ sǝni nǝ cauɓikea mala wal-lú ɗàng. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />Dumǝna púp mǝ'túrtúro ka nǝ̀ ueo aɓa nggea-là mala kum-àwá ba lú mala Pǝris Mǝgule. Anzǝm lú mala Pǝris Mǝgule ka, mǝ'túrtúro nǝ̀ nyare a nzali mala liɓala male.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />&lt;&lt; &lt;Agir mǝnia ka à nǝ̀ duk anê andǝ acáu mǝnana dumǝna púp wun nǝ̀ kpatea arǝ anza mǝnana kat à kǝ yiu ka, a koya ban mana wu duk kam ngga. <verse eid="NUM 35:29" /><verse number="30" style="v" sid="NUM 35:30" />Ɓǝ̀ kǝɓwa wal-lú ɓeɓwa ka, à nǝ̀ wal-luí, ɓǝ̀ à kum amǝ'nakún ɓari ka; sǝama à pà nǝ̀ wal-lú kǝɓwa amur nakun mala ɓwa mwashat ɗang.<verse eid="NUM 35:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 35:31" />&lt;&lt; &lt;Pà wun nǝ̀ ak kǝ mbweban ace akmúr yilǝmi ɓwa mǝnana pàngŋǝ̀nà cauɓikea mala wal-lú ka ɗàng; dumǝna púp ɓwê ka à nǝ̀ wal-luí.<verse eid="NUM 35:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 35:32" />&lt;&lt; &lt;Pà wun nǝ̀ ak kǝ mbweban ace earî ɓwa mǝnana ɓangŋǝna warina a nggea-là male mala kum-àwá ka ama nǝ̀ nyare a là ace do a nzali male sǝ Pǝris Mǝgule malaká wù raka.<verse eid="NUM 35:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 35:33" />&lt;&lt; &lt;Wu kǝa tsǝk nzali ma'wun mǝnana wu do aɓalǝi ka ɓǝ̀ duk gìr'ɓeami ɗàng; súkkí-nkila ka kǝ tsǝk nzali ɓǝ̀ duk gìr'ɓeami, sǝ kǝ shawuɗiban pa kàm à nǝ̀ pè ace nzali mǝnana à sukki nkila amurí ka ɗàng, she nǝ nkila mala ɓwa mǝnana súkkì nkile ka. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />Acemani ka nzali mǝnana wu do aɓalǝi, mǝnana mǝ ndakam nǝdo gbal aɓalǝi ka, pà wun nǝ̀ pǝndǝkì ɗàng. Mim Yahweh ka mǝ ndanǝdo aɓalǝ amǝ Isǝrayila.&gt; &gt;&gt;<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s">Nzali ace amuna-mamǝna mala Zelofihat</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Amúrû amur aɓala-kàu mala anggurkwar mala amǝkà Gilǝyat, muna-ɓwabura mala Makir, muna-ɓwabura mala Manasa, mǝnana à purki arǝ anggurkwar mala amǝkà Yisǝfu ka, à sung tù sǝ à nacau aɓadǝm Musa sǝ ɓadǝm aɓwana-mǝgule, yì amúrû amur aɓala-kàu mala amǝ Isǝrayila. <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />À bang ama, &lt;&lt;Lang Yahweh po cau, we ɓwamǝgule ma'sǝm, ama ɓǝ̀ wu gakì atau mala amǝ Isǝrayila nzali liɓala acea nǝ bwal-shishar ka, banggo ama wu pa nzali liɓala mǝnana nda ace mǝ'eam sǝm Zelofihat ka aban amuna-mamǝna male.<note caller="+" style="f"><char style="fr" closed="false">36:2 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="NUM 26:33">Ɓal 26:33</ref>; <ref loc="NUM 27:1-11">27:1-11</ref>; <ref loc="JOS 17:3">Jes 17:3</ref>; <ref loc="1CH 7:15">1Acau 7:15</ref></char>.</note> <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Sǝ ɓǝ̀ yi do ama amuna-mamǝna male alki aburana aɓalǝ aɓea atau mala amǝ Isǝrayila ka, nzali liɓala acea ka pà nǝ̀ duk mala tàu ma'sǝm ɗǝm ɗàng. Nǝ̀ duk kàɓé amur nzali liɓala mala tàu mǝno à albura kam ngga. Anggo ka nzali mǝnana nda ace tàu ma'sǝm ngga nǝ̀ amsǝa. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Sǝ lang pǝlǝa mala pàkkiɗire-banɓoarnado<note caller="+" style="f"><char style="fr" closed="false">36:4 </char><char style="fq" closed="false">pǝlǝa mala pàkkiɗire-banɓoarnado: </char><char style="ft" closed="false">pǝlǝa mǝnana à nǝ̀ nyesǝ anzali mǝnana à mea ka a bù amǝtale mana a nggea dǝmbe ka, sǝ aguro kat ka à nǝ̀ panzǝa ɓǝà kum kumɓamuru.</char></note><note caller="+" style="f"><char style="fr" closed="false">36:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 25:8-55">Pǝris 25:8-55</ref></char>.</note> mala amǝ Isǝrayila nǝ̀ kàr ka, pà sǝm nǝ̀ kum nzali mala Zelofihat ɓǝ̀ nyare a bù sǝm ɗàng; nǝ̀ duk mala tàu mǝnana amuna-mamǝna male albura kam ngga.&gt;&gt;<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Pǝlǝa Musa pà nzongcau mǝnia mǝnana pur nǝban Yahweh ka aban amǝ Isǝrayila ama, &lt;&lt;Cau mala amǝkau a tàu mala Yisǝfu ka nda a njarì. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Mǝnia ka nda cau mǝnana Yahweh bang amur amuna-mamǝna mala Zelofihat ka ama, &lt;Wu ɗekia ɓǝà al aburana mǝnana bumia twal ka; sǝama à nǝ̀ albura a tàu mala tárrià.&gt; <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />Anggo ka nzali mǝnana mala amǝ Isǝrayila na ka pà nǝ̀ purî bù ɓè tàu aban ká bù ɓè tàu ɗàng. Koya ɓwa Isǝrayila ka nǝ̀ bwal nzali mala akê a tàu male. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Koya muna-ɓwama mǝnana kum liɓala mala nzali a koya tàu mala Isǝrayila ka dumǝna púp nǝ̀ albura a tàu mala tárrí, ace mǝnana koya ɓwa Isǝrayila ka ɓǝ̀ bwal nzali mǝnana mala akê na ka. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Kǝ nzali pa nǝ̀ purî bù kǝɓwa a ɓè tàu aban ká ɓè ɗàng, ace mǝnana koya tàu mala Isǝrayila ka ɓǝ̀ bwal nzali mǝnana kumo a bù akê ka.&gt;&gt;<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10-11" style="v" sid="NUM 36:10-11" />Nda amuna-mamǝna mala Zelofihat, yià Mahla, andǝ Tǝrza, andǝ Hogǝla, andǝ Milka, sǝ Noha ka, à pà kǝla mana Yahweh banggi Musa ka; à alki aburana atà amuna-burana mala akinea. <verse eid="NUM 36:10-11" /><verse number="12" style="v" sid="NUM 36:12" />Aburana mǝnana à alia ka à nda arǝ anggurkwar mala amǝkà Manasa muna-ɓwabura mala Yisǝfu. Nda anzali malea ueo aɓa nggurkwar andǝ tàu mala tárria ka.<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />Amǝnia ka à nda ka anzongcau andǝ acáu mǝnana Yahweh pè amǝ Isǝrayila nǝ kún Musa, a ɓawanban Mowap a nkanggari Nggeasala Jodan a nkaring Jeriko ka.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>