<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Mbula</book>
  <para style="h">Jesǝwa</para>
  <para style="toc1">Jesǝwa</para>
  <para style="toc2">Jesǝ</para>
  <para style="toc3">Jes</para>
  <para style="mt1">Jesǝwa</para>
  <para style="imt">MƏNCAU</para>
  <para style="im">Malǝmce mala <char style="bk">Jesǝwa</char> ka kǝɓicau na amur kutio mala amǝ Isǝrayila a nzali Kan'ana andǝ â mǝnana à ê a bàkú mana Jesǝwa nda ɓwamǝgule malea, mǝnana akì Musa ka. Agirkumban mǝnana à twal hakkilo aɓa mǝnia yì malǝmce ka, à nda ka yàl nkaring Nggeasala Jodan, andǝ kpa mala Jeriko, andǝ munǝo a Ai, andǝ kwakita kùrcau abǝshe anre Ɓakuli andǝ aɓwana male. Cau mǝgule aɓa malǝmce mǝnia mǝnana aɓwana súrǝì pepè ka nda mǝnana ama, &lt;&lt;Wu twal yalung, ɓwa mǝnana wun nǝ̀ kpate ka. Mim sǝnǝ amǝ'ɓala mem ngga, sǝm nǝ̀ kpata Yahweh.&gt;&gt; (<char style="xt" closed="false"><ref loc="JOS 24:15">Jes 24:15</ref>)</char></para>
  <para style="iot">Agir mǝnana a ɓālǝi ka</para>
  <para style="io1">Li nzali Kan'ana <char style="ior"><ref loc="JOS 1:1-12:24">1:1--12:24</ref></char></para>
  <para style="io1">Gakki nzalinì <char style="ior"><ref loc="JOS 13:1-21:45">13:1--21:45</ref></char></para>
  <para style="io2">1. Nzali mǝnana a takuli mala Nggeasala Jodan ngga <char style="ior"><ref loc="JOS 13:1-33">13:1-33</ref></char></para>
  <para style="io2">2. Nzali mǝnana a njar-nzali mala Nggeasala Jodan ngga <char style="ior"><ref loc="JOS 14:1-19:51">14:1--19:51</ref></char></para>
  <para style="io2">3. Anggea-là ban àwá <char style="ior"><ref loc="JOS 20:1-9">20:1-9</ref></char></para>
  <para style="io2">4. Anggea-là mala amǝ'Lawi <char style="ior"><ref loc="JOS 21:1-45">21:1-45</ref></char></para>
  <para style="io1">Atau mala takuli nyar a bu-nzali malea <char style="ior"><ref loc="JOS 22:1-34">22:1-34</ref></char></para>
  <para style="io1">Cau tsǝkban-andà mala Jesǝwa <char style="ior"><ref loc="JOS 23:1-16">23:1-16</ref></char></para>
  <para style="io1">Kwakita kùrcau abǝshe a Shekem <char style="ior"><ref loc="JOS 24:1-33">24:1-33</ref></char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s">Ɓakuli pê Jesǝwa gara mala lì nzali Kan'ana</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />Anzǝm lú mala Musa guro mala Yahweh ka, Yahweh nacau nǝ Jesǝwa muna-ɓwabura mala Nun, yì mǝpe Musa gbasha, ama, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />&lt;&lt;Guro mem Musa, pangŋǝnalú. Acemani ka, lo, we wunǝ aɓwana man kat, wu yàlle a nkaring Nggeasala Jodan man, aban ká a nzali mǝnana mǝ nǝ pea wia, yià amǝ Isǝrayila ka. <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />Kǝla mǝnana ǝn ne Musa ka, ban mǝnana kat a tsǝk ɓakusǝo kàm ngga, ǝn pano wi.<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 11:24-25">Nggur 11:24-25</ref> </char>.</note> <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />Nzong-nzali mǝnana nǝ̀ duk ma'wun ngga,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 15:18">Tite 15:18</ref>; <ref loc="EXO 23:31">Pur 23:31</ref>; <ref loc="NUM 34:3-12">Ɓal 34:3-12</ref></char>.</note> nǝ̀ twal a ɓabondo a njar-kúnmur, sǝ nǝ̀ ká a ban Ankono Lebano mǝnia a njar-nza ka. Sarǝa male nǝ̀ lo a kún nggeasala mǝgule, yì Nggeasala Yiufǝretis a njar-takuli, andǝ nzali mala amǝ'Hitti kat, kya puro a buì mala kpa mala pwari a kún <note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Nggeamùr Mǝgule </char><char style="ft" closed="false">ko Nggeamùr Mediterani.</char></note>Nggeamùr Mǝgule.<verse eid="JOS 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 1:5" />&lt;&lt;Kǝɓwa pà kàm kārǝa nǝ̀ cam a kúnó ɗàng aɓa do mô kat.<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 7:24">Nggur 7:24</ref></char>.</note> Kǝla mǝnana mǝ nda atà Musa ka, anggo sǝ mǝ nǝ pà atò. Pà mǝ nǝ pǝlǝò nzǝmam ɗàng, pà mǝ nǝ nyio ɗang.<verse eid="JOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 1:6" />&lt;&lt;Cam kàngkàng, sǝ ɓǝ̀ mǝsǝo candǝe, acemǝnana a nda awu nǝ dupî amǝnia yì aɓwana ka a dǝmba, ɓǝà lì nzali mana ǝn kánbì akeâ mǝ nǝ pea wia ka. <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />Cam kàngkàng, sǝ ɓǝ̀ mǝsǝo candǝ pepè. Tsǝkiro wu pak gìr mǝnana kat nda kam aɓa nggurcau mana guro mem, yì Musa pò ka. Kǝa kyanggi wi, ko atà buo mǝ'nggare, ko buo mǝlì ɗàng. Anggo sǝ awu nǝ kum lidǝmba a ban mǝnana kat awu nǝ ká kàm ngga. <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />Mǝnia yì Malǝmce mala Nggurcau ka,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 31:10-13">Nggur 31:10-13</ref>; <ref loc="JOS 8:32">Jes 8:32</ref>; <ref loc="JOS 24:26-28">24:26-28</ref></char>.</note> ɓǝ̀ kǝa nying kuno ɗàng. Awu nǝ nggǝ ndalì amurí a ɓabumo, du andǝ pwari,<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="PSA 1:2">Ang 1:2</ref>; <ref loc="PSA 119:15">119:15</ref></char>.</note> ace mǝnana wu tsǝkiro, wu kpata agir mǝnana kat à gilǝia aɓalǝi ka. Anggo sǝ awu nǝ hangǝli aɓa gìr mǝnana kat a pakkiyi ka, sǝ awu nǝ kum lidǝmba pepè. <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />Mǝnia ka nda nzongcau mem, cam kàngkàng, sǝ ɓǝ̀ mǝsǝo candǝe! Cè ɓangciu pakko, ko ɓǝ̀ ɓabumo ɓungi ɗang. Acemǝnana Yahweh Ɓakuli mô ka nda atò, a koya ban na awu nǝ ká kàm ngga.&gt;&gt;<verse eid="JOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />Pǝlǝa Jesǝwa banggi amǝ'sàrǝ̀ban mala aɓwe ama: <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />&lt;&lt;Wu kùtí aɓa kàttì, sǝ wu banggi aɓwana ama, &lt;Wu alita ɓamur rǝ wun kwarbǝri mǝnana wun nǝ̀ bwalô a bu wun ngga. Aɓa nongŋo tàrú, tite a yalung ngga, wun nǝ̀ yàllî Nggeasala Jodan kani, wun nǝ̀ ká ace ak nzali mǝnana Yahweh Ɓakuli ma'wun kǝ pà wun ɓǝ̀ duk girkuma ma'wun ngga.&gt; &gt;&gt;<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />Sǝ amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa ka, Jesǝwa banggia wia ama, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />&lt;&lt;Ɓǝ̀ ɓalǝ wun kasǝa arǝ nzongcau mǝnana Musa, yì guro mala Yahweh pà wun ama: &lt;Yahweh Ɓakuli ma'wun nǝ̀ pà wun usǝlǝo, sǝ nǝ̀ pà wun nzali mǝnia ka.&gt; <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />Amālá wun, andǝ amuna mǝkeke ma'wun, andǝ agirkusǝu ma'wun nǝ̀ ue kani aɓa nzali mǝnana Musa pà wun a nkaring Nggeasala Jodan a njar-takuli ka, sǝama aburana amǝ'lwa ma'wun mǝnana à marǝna rǝia ace lwa ka, dumǝna púp à nǝ̀ aki amǝ'eam wun dǝmba, à nǝ̀ yàllî Nggeasala Jodan, ace bwalia wia kàm, <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />sheɓǝ̀ Yahweh pànî amǝ'eam wun usǝlǝo kǝla mǝnana pà wun ngga, sǝ yià gbal ka à angŋa nzali mǝnana Yahweh Ɓakuli malea kǝ pea wia ɓǝ̀ duk girkuma malea ka. Anzǝm mǝno ka sǝ wun nǝ̀ nyare, wun nǝ̀ yia do a nzali ma'wun mǝnana Musa, guro mala Yahweh pà wun a nkaring mala Nggeasala Jodan a njar-takuli ka.&gt;&gt;<verse eid="JOS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16" />Pǝlǝa à earî Jesǝwa ama, &lt;&lt;Cau mǝnana kat a bangga sǝm ngga, sǝm nǝ̀ pè, sǝ ban mǝnana kat a túr sǝm kàm ngga sǝm nǝ̀ ká. <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />Kǝla mǝnana sǝm okî Musa aɓalǝ agir kat ka, anggo sǝ sǝm nǝ̀ okô. Eare ma'sǝm ngga nda mǝnana ama, ɓǝ̀ Yahweh Ɓakuli mô pà atò kǝla mǝnana pà atà Musa ka! <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />Ɓwa mǝnana kat mgbicau arǝ nzongcau mò sǝ ɓinǝ kpata acau mò ka, à nǝ̀ wal-luí. We ka cam kàngkàng, sǝ ɓǝ̀ mǝsǝo candǝe.&gt;&gt;<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s">Jesǝwa tasǝ amǝ'shenzǝ-nzali a Jeriko</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />Pǝlǝa Jesǝwa muna-ɓwabura mala Nun tasǝ aburana ɓari, amǝ'shenzǝ-nzali, aɓa sǝmbǝrǝa a Shitim. Sǝ pea wia cau ama, &lt;&lt;Wu kyane, wu kya shenzǝ nzalinì, andǝ Jeriko.&gt;&gt; Pǝlǝa à wario sǝ à yi kútí a ɓala mala ɓè ɓwama mǝnana nda atarǝì, lùllǝì ama Rahap ka, sǝ à sulǝ abanì. <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />Cau wari aban murǝm Jeriko, ama, &lt;&lt;Sǝni, aɓea amǝ Isǝrayila yina kani yalung nǝ du man ace shenzǝ nzali mǝnia ka.&gt;&gt; <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />Pǝlǝa murǝm Jeriko tasǝban nǝ mǝnia yì cau ka aban Rahap, ama, &lt;&lt;Pusǝ aburana mǝnana à yiu a bano, sǝ à yi kútí a ɓala mò ka, acemǝnana à yiu ace shenzǝ nzali man kat.&gt;&gt;<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />Sǝama ɓwame ka warinanǝ aburana mǝnia ɓari ka kya sǝmbǝrǝnia. Pǝlǝa na ama, &lt;&lt;Mǝsǝcau, aburane yiu a banam, sǝ mim ngga ǝn súrǝ̀ ban mǝnana à pur kàm ngga ɗàng. <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />Lang malanǝ̀ bik bu-pwari mǝnana à nǝ̀ gìr kún nggea-là nǝi nǝ du ka, aburane puro. Ən súrǝ̀ ya bù-ban na à twalo sǝ à u ka ɗàng. Wu pyangnǝ atea akaurǝa, wun nǝ̀ bwaltea!&gt;&gt; <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />(Sǝ yì ka angŋa dǝmba eamsǝnia a múr-kurǝm sǝ sǝmbǝrǝnia a tǝrta akurri záng mǝnana anzǝia a múr-kurǝm ngga.) <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />Nda aburana man puro aban ká pyangnǝata amǝ'shenzǝ-nzali man a njargula ká a Nggeasala Jodan a ban yálì nkaring mùr. Lang amǝ'pyangnǝatau umǝna ani ka, kún nggea-là ka à gìrì. <verse eid="JOS 2:7" /><verse number="8" style="v" sid="JOS 2:8" />Kaniama aburana man nǝ̀ o a ntulo ka Rahap eau abania a múr-kurǝm, <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />sǝ banggia wia ama, &lt;&lt;Ən sǝlǝna ama Yahweh pana wun mǝnia yì nzali ka, sǝ nggea ɓangciu ma'wun bwalǝna sǝm, sǝ ɗǝm ngga aɓwana mǝnana à ndanǝdo aɓa nzali mǝnia ka yilǝmia o ace ɓangga wun. <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />Sǝm ongŋǝna cè sonzǝo mala Nggeamùr Nzuno mǝnana Yahweh sonzǝì aɓadǝm wun lang wu purî ɓá nzali Masar, andǝ gir mǝnana wu pàkkî amurǝma ɓari mala amǝ'Amor, yià Sihon andǝ Og a nkaring Nggeasala Jodan, mǝnana wu kiɗikia kat-kat ka. <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />Lang sǝm okce ka, bum sǝm tùkimur, sǝ koyan ngga ɓabumi ɓungio atàcau ma'wun. Acemǝnana Yahweh Ɓakuli ma'wun ngga, nda Ɓakuli mana nda a kuli a murû, sǝ nda mana a ɓanza a nzali ka. <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />Ado ka, ida wu kánbàm nǝ lullǝ Yahweh ama, kǝla mǝnana ǝn lǝmdǝa wun pěmǝɓoarne ka, wun gbal ka wun nǝ̀ lǝmdǝ pěmǝɓoarne arǝ ɓala mala tárrám. Wu pam gir'lǝmdǝa mǝɓafoe <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />ama, wun nǝ̀ amsǝ yilǝmi tárrám andǝ nggem andǝ amǝ'eambam, andǝ aɓwana mǝnana amalea na kat ka, sǝ wun nǝ̀ akmúr sǝm a bù lú.&gt;&gt; <verse eid="JOS 2:13" /><verse number="14" style="v" sid="JOS 2:14" />Sǝ aburane banggi wi ama, &lt;&lt;Ɓǝ̀ a arce tǝr yiu ma'sǝm raka, sǝm nǝ̀ lǝmdǝo pěmǝɓoarne andǝ domǝsǝcau lang Yahweh nǝ̀ yia pà nzali mǝnia a ɓabù sǝm ngga. Ɓǝ̀ kǝ ɓwa wal-lueó ko amǝ'ɓala mò ka, sǝm gbal ka ɓǝ̀ sǝm wǔ.&gt;&gt;<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />Nda Rahap sulǝia a nzali nǝ nggur a mǝsǝkurǝm ngga. (Ɓala male mǝnana duk kam ngga à ɓè arǝ sheran mala nggea-là.) <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />Sǝ banggia wia ama, &lt;&lt;Wu dǝshi ban ankono, ace mǝnana amǝ'pyangnǝata wun ɓǝà kǝa kum wun ɗàng. Wu sǝmbǝrǝ kano nongŋo tàrú she ɓǝà nyarna ka. Nǝnzǝ́mò ka wun nǝ̀ gandǝ bwal njar ma'wun wun nǝ̀ o.&gt;&gt; <verse eid="JOS 2:16" /><verse number="17" style="v" sid="JOS 2:17" />Aburane ne wi ama, &lt;&lt;Kána mǝnia a tsǝk sǝm, sǝm kánbo ka, pà nǝ̀ bwal sǝm ɗàng, sheɓǝ̀ a lumsǝna amǝnia yì acautsǝa ka: <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />Lang sǝm yina nǝ rǝcandǝa mala lwa arǝ nzali ma'wun ngga, kùr mǝnia yì nggur mǝbangŋe ka arǝ mǝsǝkurǝm mǝnana a sulǝ sǝm kam a nzali ka, sǝ wu ramba à tárró, andǝ nggo, andǝ amǝ'eambo, andǝ aɓwana mǝnana kat à ndanǝdo a ɓala mala tárró ka, abanɓwáná a ɓala mò. <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />Ɓwa mǝnana nying ɓala mò ka, yì na mǝnana wal ɓamurì ka. À pà nǝ̀ tsǝka sǝm cau arǝ sǝm aɓa mǝno ka ɗàng! Sǝ ɓǝ̀ ɓwa ka nda atò a ɓala sǝ mǝɓane kumi ka, nkile na amúr sǝm. <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />Sǝama ɓǝ̀ a pusǝta sǝm, a ne aɓwana gìr mǝnana sǝm yiu ace ka, kána mô mǝnia a tsǝk sǝm, sǝm kánbo ka, pà nǝ̀ bwal sǝm ɗàng.&gt;&gt; <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />Pǝlǝa Rahap bang ama, &lt;&lt;Kǝla mana cau ma'wun bang ngga, ɓǝ̀ do anggo.&gt;&gt; Nda tasǝia ɓǝà u ka, sǝ à bwal njar à o. Pǝlǝa kùr nggur mǝbangŋe arǝ mǝsǝkurǝm.<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />Lang à longŋa ka, à o amur ankono sǝ à kya ue kam nongŋo tàrú she lang amǝ'pyangnǝatea nyarna ka. Amǝ'pyangnǝatea altea arǝ abân kat a njargula sǝ à kumia ɗàng. <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />Pǝlǝa aburana mǝnia ɓari ka à nyare. À sulǝî múr ankono, à yì yàl a nkaring nggeasala sǝ à yiu aban Jesǝwa muna-ɓwabura mala Nun. À banggi wi gìr mǝnana kat kumia ka. <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />À ne Jesǝwa ama, &lt;&lt;Ɓafo Yahweh pana nzali mǝnia kat ka a ɓabù sǝm! Aɓwana mǝnana à do a nzalinì kat ka yilǝmia na aɓa ǝn'o ace ɓangga sǝm!&gt;&gt;<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s">Yàllî Mùr Jodan</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />Nǝ dǝmbari ɗiɗyal ka, Jesǝwa andǝ amǝ Isǝrayila nying Shitim, sǝ à yiu a Nggeasala Jodan, ban mǝnana à tsǝk kàttì sǝ nǝnzǝ́mò ka à nǝ̀ yàl a nkaring ngga. <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />Anzǝm anongŋo tàrú ka, aɓwana-mǝgule gya aɓa kàttì kat, <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />aban pe aɓwana nzongcau ama: &lt;&lt;Lang wu sǝnǝna Akwati Kùrcau mala Yahweh, Ɓakuli ma'wun, andǝ apǝris, andǝ amǝ'Lawi na aban twale ka, wun nǝ̀ nying ban mǝnana wu ndakam ngga, wun nǝ̀ kpate. <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />Anggo, sǝ wun nǝ̀ súrǝ̀ njar mǝnana wun nǝ̀ ká ka, acemǝnana, wu pǝlǝma a mǝnia yì njar a kǝ fara ɗàng. Sǝama, wu cam zak, ɓǝ̀ nre wun andǝ Akwati ɓǝ̀ pa kǝla, sauwa mala ɓakusǝu á-tàrú; cè wu na ama, wun nǝ̀ gbàshìbani tù ɗàng.&gt;&gt;<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />Pǝlǝa Jesǝwa banggi aɓwana ama, &lt;&lt;Wu tàr ɓamur rǝ wun aɓa domǝfele, acemǝnana lí ka, Yahweh nǝ̀ pàkki agir-ndǝlǝki aɓalǝ wun.&gt;&gt;<verse eid="JOS 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 3:6" />Jesǝwa pǝlǝa banggi apǝris ama, &lt;&lt;Wu twal Akwati mala Kùrcau, wu akì aɓwe dǝmba aban ká nǝi.&gt;&gt; Nda à twal Akwati mala Kùrcau aban ká nǝi aɓadǝm aɓwe ka.<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />Pǝlǝa Yahweh banggi Jesǝwa ama, &lt;&lt;Yalung ngga, mǝ nǝ tita tsǝo, wu dum nǝ gulo a mǝsǝ amǝ Isǝrayila kat, ace mǝnana ɓǝà sǝlǝ ama, kǝla mana ǝn pa atà Musa ka, anggo sǝ mǝ nǝ pa atò. <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />Banggi apǝris mana à twalkiyi Akwati Kùrcau ka, ama: &lt;Lang wu bwalǝna kun-gwanyi mala Nggeasala Jodan ngga, wu kùtí a mùr, sǝ wu cam nggam piu.&gt; &gt;&gt;<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />Pǝlǝa Jesǝwa banggi amǝ Isǝrayila ama, &lt;&lt;Wu yiu kani, wu kwakikir wun arǝ cau mala Yahweh, Ɓakuli ma'wun.<verse eid="JOS 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 3:10" />&lt;&lt;Ani sǝ wun nǝ̀ sǝlǝ ama, Ɓakuli mǝyilǝmui ka, nda aɓalǝ wun, sǝ ɗǝm ngga, nǝ mǝsǝcau, nǝ̀ pǝr amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Hivi, andǝ amǝ'Periz, andǝ amǝ'Girgash, andǝ amǝ'Amor, andǝ amǝ'Jebus, aɓadǝm wun. <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />Wu sǝni, Akwati Kùrcau mala Mǝtala ɓanza kat ka, ndo nǝ̀ aka wun dǝmba, nǝ̀ kùtí aɓa Nggeasala Jodan. <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />Ado ka, wu twal aburana lum-nong-ɓari aɓalǝ atau mala amǝ Isǝrayila, ɓwa mwashat a koya tàu. <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />Sǝ lang apǝris mǝnana à kǝ twal Akwati mala Yahweh, Mǝtala ɓanza kat, nǝ̀ tsǝk kusǝia a mùr mala Jodan ani ka, mùr mala Jodan mana kǝ ɓangŋa aban yiu ka, nǝ̀ kasǝa, pà nǝ̀ nggǝ ɓang ɗàng sǝ nǝ̀ ram gum-gum.&gt;&gt;<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />Lang aɓwe nyìngŋǝ̀nà kàttì, ace ká yàllî mùr Jodan ngga, apǝris mana à twalkiyi Akwati Kùrcau ka, à akì aɓwe dǝmba aban o.<verse eid="JOS 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 3:15" />A kúnì pwangiagir-ɓaban kǝla man adyan ngga, nda bàkú mana mùr-longŋa mala Nggeasala Jodan kǝ lumsǝna ban nǝi ka. Kat andǝ amani anggo ka, lang apǝris mana à twalkiyi Akwati, à yi bwalǝna Nggeasala Jodan, sǝ kusǝia jena kún mùr ani ka, <verse eid="JOS 3:15" /><verse number="16-17" style="v" sid="JOS 3:16-17" />mùr mana kǝ ɓang aban yiu nǝbania ka, kara came, kǝ ɓang ɗang. Ram gum-gum a bansauwa a ɓè nggea-là mana à tunǝki ama, Adam, tù a ban Zaretan ngga. Sǝ mùr mana kǝ ɓangŋa aban o nǝ'nzali, aban ká Nggeamùr mala Araba (mana à tunǝki ama, Nggeamùr Tuɓamur<note caller="+" style="f"><char style="fr" closed="false">3:16-17 </char><char style="fq" closed="false">Nggeamùr Tuɓamur </char><char style="ft" closed="false">ko Luna Nggeamùr.</char></note> ka), kasǝ kat-kat. Sǝ apǝris mana à twal Akwati Kùrcau mala Yahweh ka, à cam kàngkàng amur nzali mǝ'ime, a tsùrú mala Nggeasala Jodan. Amǝ Isǝrayila kat ka, à gya, à kútí amúr nzali mǝ'ime, ba eauwe mala aɓwe puppup a nkaring. Anggo, sǝ aɓwana yàl a nkaring a ban mana à kǝ sǝn ɓamǝsǝarǝia andǝ Jeriko ka.<verse eid="JOS 3:16-17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s">Atali lum-nong-ɓari mala kasǝɓalǝu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />Lang ɓwapǝndǝa puppup malǝna yàlî nkaring Nggeasala Jodan ngga, Yahweh bangcau nǝ Jesǝwa ama, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />&lt;&lt;Tàr aburana lum-nong-ɓari aɓalǝ aɓwe, ɓwa mwashat a koya tàu, <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />sǝ wu banggia wia ama, &lt;Wu imsǝki atali lum-nong-ɓari aɓa tsùrú mala Nggeasala Jodan, a ban mǝnana akusǝ apǝris cam kam kàngkàng ngga; wu eamsǝia atà wun wu kya tamsǝkia a ban mǝnana wun nǝ̀ tsǝk kàttì kam a dù man yalung ngga.&gt; &gt;&gt; <verse eid="JOS 4:3" /><verse number="4" style="v" sid="JOS 4:4" />Pǝlǝa Jesǝwa tunǝ aburana lum-nong-ɓari mǝnana à tària aɓalǝ amǝ Isǝrayila ka, mwashat a koya tàu. <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />Jesǝwa banggia wia ama, &lt;&lt;Wu kutio wu kyane a tsùrú mala Nggeasala Jodan, a ɓadǝm Akwati mala Yahweh Ɓakuli ma'wun, sǝ koyan atà wun ngga ɓǝ̀ loasǝ tali mwashat ɓǝ̀ twali a nkpamtari; atali lum-nong-ɓari kat-kat kǝla mana làkkì mala atau mala amǝ Isǝrayila pàk ka. <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />Atali mǝnia ka, à nǝ̀ duk gir'lǝmdǝa aɓalǝ wun. Lang amuna ma'wun nǝ̀ ɗì wun a dǝmba ama, &lt;Mana nda ɓalǝ amǝnia yì atali aban wun?&gt; <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />Pǝlǝa wun nǝ̀ banggia wia ama, &lt;Nda acemǝnana mùr Nggeasala Jodan kasǝa, lang Akwati Kùrcau mala Yahweh bik kún mur ka. Lang Akwatinî yàllî Nggeasala Jodan ngga, mùr Jodan kasǝa.&gt; Acemani ka, amǝnia yì atali ka, à nǝ̀ duk gir kasǝɓalǝu aban amǝ Isǝrayila tàtǝ́k.&gt;&gt;<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />Amǝ Isǝrayila pǎ kǝla mǝnana Jesǝwa banggia wia ama ɓǝà pàk ka. Kǝla mǝnana Yahweh banggi Jesǝwa ka, à twalki atali lum-nong-ɓari aɓa tsùrú mala Nggeasala Jodan, mwashat ace koya tàu mala amǝ Isǝrayila. À eamsǝia ateà aban ká kàttì sǝ à kya tsǝia kàm. <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />Ɗǝm ngga Jesǝwa tamsǝki atali lum-nong-ɓari a tsùrú mala Nggeasala Jodan, a ban mǝnana akusǝ apǝris mana à twal Akwati Kùrcau cam kam ngga. Sǝ à ndakam a banì ba yalung. <verse eid="JOS 4:9" /><verse number="10" style="v" sid="JOS 4:10" />Apǝris mana à twal Akwati ka, à cam aɓa tsùrú mala Nggeasala Jodan ba masǝlǝata koyagir mǝnana Yahweh tsǝkî Jesǝwa nzongcau ɓǝ̀ banggi amǝ Isǝrayila ka; à kpata gìr mǝnana kat Musa tsǝki Jesǝwa nzongcau arǝia ka. Sǝ aɓwe yàl a nkaring akaurǝa. <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />Sǝ lang ɓwapǝndǝa kat malna eauwe ka, Akwati mala Yahweh andǝ apǝris eauwe a ɓamǝsǝ aɓwe. <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />Aburana mala tàu mala Ruben, andǝ tàu mala Gad, andǝ gauwa-tsùrú mala tàu mala Manasa ka, à eau aɓa kùrrǝu a ɓadǝm amǝ Isǝrayila, kǝla mana Musa banggia wia ka. <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />Aɓwana kǝla á-lumi-ine aɓa kùrrǝu eauwe a ɓadǝm Yahweh ace ká lwa a ɓawanban mala Jeriko. <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />A mǝno yì pwari ka, Yahweh gusǝlǝce Jesǝwa a ɓamǝsǝ amǝ Isǝrayila kat; sǝ à ɓanggi wi kǝla mana à ɓanggi Musa ka, aɓa do-yilǝmu male kat.<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />Yahweh ne Jesǝwa ama, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />&lt;&lt;Banggi apǝris mǝnana à twal Akwati Kùrcau ka, ɓǝà eapi Nggeasala Jodan.&gt;&gt; <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />Sǝ Jesǝwa sà'arǝ apǝris ama, &lt;&lt;Wu eapi Nggeasala Jodan!&gt;&gt; <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />Lang apǝris mǝnana à twal Akwati Kùrcau mala Yahweh eapǝnì tsùrú mala Nggeasala Jodan sǝ ɓakusǝ apǝris eauna a nza ka, mùr Nggeasala Jodan nyar a banì, sǝ ali a kun-gwanyi, kǝla mǝnana ɗiɗyal ka. <verse eid="JOS 4:18" /><verse number="19" style="v" sid="JOS 4:19" />Aɓwe eapi Nggeasala Jodan a lumia nongŋo mala zongŋo mǝdǝmbe, sǝ à kya duk kàttì a Gilgal, a nkanggari Jeriko a buì mala takuli. <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />Jesǝwa tamsǝki amǝno yì atali lum-nong-ɓari mǝnana à pwania aɓa Nggeasala Jodan ngga, a Gilgal. <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />Sǝ banggi amǝ Isǝrayila ama, &lt;&lt;Lang amuna ma'wun nǝ̀ ɗiki atárrià a dǝmba ama, &lt;Mana ndà ɓalǝ amǝnia yì atali ka?&gt; <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />Pǝlǝa wun nǝ̀ banggi amuna ma'wun ama, &lt;Isǝrayila yàl nkaring Nggeasala Jodan mǝnia amúr nzali ima.&gt; <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />Acemǝnana Yahweh Ɓakuli ma'wun imsǝ mùr mala Nggeasala Jodan aɓadǝm wun she lang wu eauna a nkaring ngga. Nda kǝla mana Yahweh Ɓakuli ma'wun pàkkî Nggeamùr Nzuno, mǝnana imsǝi aɓadǝm sǝm she lang sǝm eauna a nkaring ngga. <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />Pàk mǝnia ka ace mǝnana aɓwapǝndǝa mala anzali ɓanza kat ka ɓǝà sǝlǝ ama, bu Yahweh ka ndanǝ rǝcandǝa, sǝ ɓǝ̀ wu ɓanggi Yahweh Ɓakuli ma'wun tàtǝ́k.&gt;&gt;<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="s">Kasǝ-ɓatau a Gilgal</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />Lang amurǝma kat mala nzali Amor mǝnana a njar-nzali mala Nggeasala Jodan, andǝ amurǝma mala nzali Kan'ana mǝnana à do a kún nggeamùr ok cau mala sonzǝo mala múr nggeasala mana Yahweh sonzǝi aɓadǝm amǝ Isǝrayila bà yàlle malea a nkaring ngga, ɓabumia tùmùr sǝ yilǝmia o atàcau mala ɓangciu mana bwalia arǝ amǝ Isǝrayila ka. <verse eid="JOS 5:1" /><verse number="2" style="v" sid="JOS 5:2" />A bàkú mǝno ka Yahweh banggi Jesǝwa ama, &lt;&lt;Pàk abyau mǝ'kún-cauwe nǝ tali-candǝa, sǝ wu kasǝì amuna-burana mala amǝ Isǝrayila ɓatea, ɓaria kasǝ-ɓatau mala amǝ Isǝrayila.&gt;&gt; <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />Nda Jesǝwa pàk abyau mǝ'kún-cauwe nǝ tali-candǝa sǝ kasǝî amuna-burana mala amǝ Isǝrayila ɓatea a Gibiyat-haralot<note caller="+" style="f"><char style="fr" closed="false">5:3 </char><char style="fq" closed="false">Gibiyat-haralot </char><char style="ft" closed="false">ka nda &lt;&lt;Nkono nggú-ɓatau.&gt;&gt;</char></note> ka. <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />Sǝ mǝnia ka nda gìr mǝnana tsǝa sǝ Jesǝwa kasǝia wia ɓatea ka: aɓwana mǝnana kat à purî Masar, mǝnana aburana na ka, yià aburana mǝnana à nda ka amǝ'lwa ka, à wuki kat a ɓabondo a njar, anzǝm mǝnana à purnì Masar ka. <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />Kat andǝ amani ama aɓwana mǝnana kat à purî Masar ka à kasǝia wia ɓatea ka, amuna mǝnana à ɓǝlia a ɓabondo a njar, lang à purî Masar ka, à kasǝi wia ɓatea ɗàng. <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />Amǝ Isǝrayila gāli aɓa pǝɗanban bà apǝlǝa lumi-ine, gandǝa amǝ'lwa malea mǝnana à purî Masar ka à wuki kat, acemǝnana à kwakikiria arǝ gi Yahweh raka. Yahweh kánbia wia ama pà nǝ̀ earia wia ɓǝà sǝn nzali mǝnana akdǝmba kánbi akeâ ama nǝ̀ pà sǝm ngga ɗàng, yì nzali mǝnana kiura andǝ mur'nyi kǝ ɓang kàm ngga. <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />Amunia mǝnana loasǝia à yi ak bancame malea ka, à nda mǝnana Jesǝwa kasǝia wia ɓatea ka. Yià ka à kum kasǝ-ɓatau ɗàng acemǝnana à kasǝia wia ɓatea a njar ɗàng. <verse eid="JOS 5:7" /><verse number="8" style="v" sid="JOS 5:8" />Lang à malǝna kasǝi aburana mala Isǝrayila ɓatea puppup ka, à ueo a ban mǝnana à ndakam a kàttì ka, ba sonzǝo mala anpenye. <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />Yahweh banggi Jesǝwa ama, &lt;&lt;Yalung ngga ǝn ɗenggǝlina kǝsǝkea mala Masar mana amúr wun ngga, umǝna.&gt;&gt; Nda à tunǝ banì ama <note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="fq" closed="false">Gilgal </char><char style="ft" closed="false">nǝ lasǝ Ibǝru ka nda &lt;&lt;gǝshì.&gt;&gt;</char></note>Gilgal ba yalung.<verse eid="JOS 5:9" /></para>
  <para style="s">Lamsan Yàlîmurû mǝdǝmbe a Kan'ana</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />Lang amǝ Isǝrayila na a là-gumli a Gilgal, a ɓawanban mala Jeriko ka, à pàk lamsan mala Yàlîmurû nǝ pwarikpǝra a lum-nong-inea pwari mala zongŋoni. <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />Lang à malna lamsan Yàlîmurû sǝ bankwarna ka, à tita lì girlina mǝnana à rì a nzali Kan'ana ka; a mǝno yì pwari ka, à lì mǝsǝsa mǝnana à ɗandǝi ka, andǝ bǝredi mǝnana à pè burè pà arǝì raka. <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />Kpa mala manna kasǝa anzǝm pwari mǝnana à lina girlina mana à rì a nzalinì ka; amǝ Isǝrayila nyare à kum manna ɗǝm ɗàng. Twal a bàkú mǝno ka à lì girlina mǝnana à rì a nzali Kan'ana ka.<verse eid="JOS 5:12" /></para>
  <para style="s">Mǝ'sàrǝ̀ban mala amǝ'lwa mala Yahweh pusǝrǝi aban Jesǝwa</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />Lang Jesǝwa na tù aban Jeriko ka, loasǝ mǝsǝi kara sǝn ɓeɓwa aban came nǝ nggeabyau mana kwetǝni ka a buì. Jesǝwa wari abani sǝ ɗì ama, &lt;&lt;A nda atà sǝm le, ko a nda atà aɓisǝm amǝbura?&gt;&gt; <verse eid="JOS 5:13" /><verse number="14" style="v" sid="JOS 5:14" />Pǝlǝa ɓwê ear ama, &lt;&lt;Awo; Mǝ nda mǝ'sàrǝ̀ban mala amǝ'lwa mala Yahweh.&gt;&gt;</para>
  <para style="p" vid="JOS 5:14">Kara Jesǝwa ɓunno, sǝ sárǝ́ nǝ ɓamǝsǝi a nzali sǝ bang ama, &lt;&lt;Mǝ nda guro mò, ɓwamǝgule. Mana girni na a earce mǝ pa?&gt;&gt;<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />Mǝ'sàrǝ̀ban mala amǝ'lwa mala Yahweh banggi Jesǝwa ama, &lt;&lt;Swár ankura mǝnana a kusǝo ka, acemana ban mǝnana a cam amurí ka nzali mǝfele na.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 3:5">Pur 3:5</ref>; <ref loc="ACT 7:33">Atúró 7:33</ref></char>.</note> Pǝlǝa Jesǝwa pàk anggo.<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s">Kpa mala Jeriko</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />Amǝ Jeriko ka à gìrki akún nggea-là malea kàngkàng ace ɓangciu mǝnana à ndanǝi arǝ amǝ Isǝrayila ka. À earî kǝɓwa ɓǝ̀ kutio ko ɓǝ̀ purî ɓá nggea-là ɗàng. <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />Sǝ Yahweh banggi Jesǝwa ama, &lt;&lt;Sǝni, ǝn pana Jeriko, andǝ murǝm malea, andǝ akanggǝrang amǝ'lwa malea a ɓabuo. <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />We wunǝ amǝ'lwa mô kat ka, wu gya wu kàrì nggea-là. Wu pàk anggo kusǝ mwashat koya pwari arǝ anongŋo tongno-nong-mwashat. <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />Tsǝk apǝris tongno-nong-ɓari, koyan ateà ka ɓǝ̀ twal njawe gam a buì, ɓǝà kǝ gya a ɓadǝm Akwati Kùrcau. A tongno-nong-ɓaria pwari ka, wu gya wu kàrì nggea-là kusǝ tongno-nong-ɓari, sǝ apǝris ɓǝà kǝ twang njawe. <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />Lang à nǝ̀ ɓua njawe, ɓua mǝcandǝe mala njawe gam, sǝ tù anzǝm mana wu ongŋǝna ɓua mala mǝno yì njawe ka, pǝlǝa aɓwe kat ɓǝà loasǝ già, ɓǝà mak-gāwàn bàng-bàng; anggo ka sheran mala nggea-là nǝ̀ kpa a nzali. Sǝ amǝ'lwa mô adyan ngga, koyan ateà ka, ɓǝ̀ soa aban ká aɓa nggea-là.&gt;&gt;<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />Nda Jesǝwa muna-ɓwabura mala Nun tunǝ apǝris sǝ banggia wia cau ama, &lt;&lt;Wu twal Akwati Kùrcau mala Yahweh, sǝ apǝris tongno-nong-ɓari aɓalǝ wun, ɓǝà kyane a ɓadǝmbi, koyan atea ka ɓǝ̀ bwal njawe gam a buì.&gt;&gt; <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />Pǝlǝa Jesǝwa banggi aɓwana ama, &lt;&lt;Wu kutio wu fa. Wu gya wu kàrì nggea-là. Amǝ'lwa ɓǝà kùtí a ɓadǝm Akwati Kùrcau mala Yahweh.&gt;&gt;<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />Sǝ kǝla mǝnana Jesǝwa pànî aɓwe nzongcau ka, apǝris tongno-nong-ɓari kútí a dǝmba, koyan ateà ka nǝ njawe gam a buì, aɓadǝm Yahweh; à kǝ̀ twang anjawe, sǝ Akwati Kùrcau mala Yahweh ka kpatea. <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />Amǝ'lwa kǝ gya a ɓadǝm apǝris mǝnana à kǝ̀ twang anjawe ka, sǝ amǝ'yal-nzǝm kpa, à kǝ̀ gya anzǝm Akwati Kùrcau, sǝ apǝris camarǝ twang anjawe. <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />Sǝ Jesǝwa ka tsǝki aɓwana nzongcau ama, &lt;&lt;Wu pà wun nǝ̀ mak-gāwàn ko wun nǝ̀ loasǝ gi wun ɓǝà oè ɗàng, sǝ kǝ cau pà nǝ̀ pur a kún wun gbal ɗàng, she pwari mǝnana mǝ nǝ bangga wun ama ɓǝ̀ wu mak-gāwàn ngga. Pǝlǝa wun nǝ̀ mak-gāwàn.&gt;&gt; <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />Nda Jesǝwa tsǝa, à gya à kàrì nggea-là nǝ Akwati Kùrcau mala Yahweh; à gya à kàrì kusǝ mwashat. Pǝlǝa à nyare, à kya nong a kàttì.<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />Pǝlǝa Jesǝwa lo nǝ dǝmbari ɗiɗyal, sǝ apǝris twal Akwati Kùrcau mala Yahweh. <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />Sǝ apǝris tongno-nong-ɓari, mǝnana nǝ́ anjawe gam a buia, a ɓadǝm Akwati Kùrcau mala Yahweh ka, gya aban ká, sǝ à camarǝ twang anjawe. Amǝ'lwa kǝ gya a ɓadǝmbǝia, sǝ amǝ'yal-nzǝm kǝ gya anzǝm Akwati Kùrcau mala Yahweh; sǝ anjawe camarǝ ɓua sǝ à kǝ ká. <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />Sǝ a ɓaria nongŋo ka, à gya à kàrì nggea-là kusǝ mwashat, sǝ à nyar a kàttì. Anggo sǝ à pǎ arǝ anongŋo tongno-nong-mwashat.<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />A tongno-nong-ɓaria pwari ka, à lo nǝ dǝmbari ɗiɗyal nǝ ban'mbul-mbul, sǝ à gya à kàrì nggea-là kǝla mǝnana à pakkiyi ka, kusǝ tongno-nong-ɓari. Nda a pwari mǝno nǝmurǝì sǝ à gya à kàrì nggea-là kusǝ tongno-nong-ɓari. <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />A tongno-nong-ɓaria kàrì nggea-là ka, apǝris ɓua njawe, ɓua mǝcandǝe. Pǝlǝa Jesǝwa banggi aɓwana ama, &lt;&lt;Wu mak-gāwàn, acemǝnana Yahweh pana wun nggea-lê! <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />Sǝ nggea-lê andǝ agir mǝnana kat aɓalǝi ka, dumǝna púp wun nǝ̀ tària aban Yahweh ace kiɗikia.<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="fq" closed="false">wun nǝ̀ tària aban Yahweh ace kiɗikia </char><char style="ft" closed="false">ko wun nǝ̀ tària kǝla pàgir aban Yahweh (ace kiɗikia).</char></note> Kǝ Rahap, yì ɓwama mana do atarǝì andǝ aɓwana mǝnana kat atè a ɓala ka, nda wun nǝ̀ nyia nǝyilǝmu ka, acemǝnana sǝmbǝrǝ amǝ'shenzǝ-nzali mǝnana sǝm túriá ace shenzǝ nggea-là ka. <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />Sǝama wun ngga wu bwal ɓamur wun arǝ agir mǝnana à tària ace kiɗikia ka, acemana ɓǝ̀ wu twal aɓalǝ agir mǝnana à tària ace Yahweh ka, wun nǝ̀ tsǝk kàttì mala Isǝrayila nǝ̀ pǝlǝ gìr mǝnana à nǝ̀ kiɗiki ka, sǝ wun nǝ̀ yinǝ tanni amurí. <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />Bolo-azǝrfa andǝ bolo-njengǝlan kat, sǝ koya gìr mǝnana à pè nǝ́ bolo-bángŋá, andǝ bolo-candǝa ka, amǝfele na aban Yahweh; dumǝna púp à nǝ̀ o aɓa ndaboalo mala Yahweh.&gt;&gt;<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />Lang à ɓua-njawe, ɓua mǝcandǝe mala anjawe, sǝ lang aɓwana ongŋǝna gi mǝno yì ɓua-njawe ka, à loasǝ già à mak-gāwàn bàng-bàng; kara sheran mala nggea-là kpa a nzali.<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="fq" closed="false">sheran mala nggea-là kpa a nzali </char><char style="ft" closed="false">ko Sheran kanggia kpa a nzali, ko bǝbbǝriki nong líp a nzali.</char></note> <note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="HEB 11:30">Ib 11:30</ref></char>.</note> Nda aɓwe kùtí aɓa nggea-là, koya ɓwa ka dǝshi ɓadǝmbi aban ká, sǝ à ak nggea-lê. <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />Pǝlǝa à twalta koya gìr mǝnana kat kǝ lin'ueo ka aɓa nggea-lê nǝ́ kún nggeabyau; aburana andǝ amamǝna, muna andǝ ɓwamǝgule, andá, anzur andǝ ambul, andǝ amǝdambǝriso.<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />Pǝlǝa Jesǝwa banggi aburana ɓari mǝnana à waria shenzǝ nzalinì ka ama, &lt;&lt;Wu kùtí a ɓala mala Rahap, yì ɓwama mǝnana do atarǝì ka, sǝ wu pusǝ ɓwame andǝ aɓwana male kat, kǝla mǝnana wu kánbi wi ka.&gt;&gt; <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />Nda alaggana mǝnana à wari a shenzǝ nzali ka à kutio, sǝ à pusǝ Rahap andǝ tárrí, andǝ nggè, andǝ amǝ'eambi amuna-burana, andǝ aɓwana male kat. À pusǝ amǝ'ɓala male kat sǝ à tsǝia zak nǝ kàttì mala Isǝrayila. <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />Sǝ nggea-là andǝ agir mǝnana kat aɓalǝi ka, à pisǝia nǝ bǝsa. Kǝ bolo-azǝrfa andǝ bolo-njengǝlan, andǝ agir mana à pea nǝ́ bolo-bángŋá, andǝ bolo-candǝa ka, nda à tsǝia aɓa ndaboalo mala ɓala mala Yahweh ka. <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />Nda Jesǝwa amsǝ yilǝmi Rahap, yì ɓwama mǝnana do atarǝì ka, andǝ amǝ'ɓala mala tárrí, andǝ aɓwana male kat. Sǝ Rahap do aɓa Isǝrayila<note caller="+" style="f"><char style="fr" closed="false">6:25 </char><char style="fq" closed="false">Sǝ Rahap do aɓa Isǝrayila </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="MAT 1:5">Mat 1:5</ref></char>.</note> bà yalung, acemǝnana sǝmbǝrǝ amǝ'shenzǝban mana Jesǝwa túriá ace shenzǝ Jeriko ka.<verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />A bàkú mǝno ka Jesǝwa tsǝia à twal kána ama:</para>
  <para style="q1" vid="JOS 6:26">&lt;&lt;Suban mala Yahweh ɓǝ̀ sulǝ amúr ɓwa</para>
  <para style="q2" vid="JOS 6:26">mǝnana nǝ̀ lo ama nǝ̀ ɓak mǝnia yì nggea-là, Jeriko ɗǝm ngga.<note caller="+" style="f"><char style="fr" closed="false">6:26 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1KI 16:34">1Amur 16:34</ref></char>.</note></para>
  <para style="q1" vid="JOS 6:26">A kúnì muna-dǝmba male sǝ nǝ̀ kwakita kusǝɓǎ,</para>
  <para style="q1" vid="JOS 6:26">sǝ a kúnì muna-ɓwabura mǝtankwang male</para>
  <para style="q2" vid="JOS 6:26">sǝ nǝ̀ kwaki akun-nggealê.&gt;&gt;<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />Yahweh na atà Jesǝwa, sǝ lùllǝì ɓuà aɓa nzalinì kat.<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s1">À gandǝ amǝ Isǝrayila nǝ lwa a Ai</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />Sǝama amǝ Isǝrayila ka, à lǝmdǝ ɗwanyi-domǝsǝcau arǝ cau mala agir mǝnana à tària ka, acemǝnana Akan muna-ɓwabura mala Karmi,<note caller="+" style="f"><char style="fr" closed="false">7:1 </char><char style="fq" closed="false">Akan muna-ɓwabura mala Karmi </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CH 2:6-7">1Acau 2:6-7</ref></char>.</note> muna-ɓwabura mala Zabdi, muna-ɓwabura mala Zera, a tàu mala Yahuda, twal aɓalǝ agir mǝnana à tària ka. Sǝ bumlulla mala Yahweh earke amúr amǝ Isǝrayila.<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />Jesǝwa túr aburana, à lo a Jeriko aban ká Ai, mǝnana nda tù aban Bet-aven nǝ njar-takuli mala Betel ka, sǝ nea wia ama, &lt;&lt;Wu kyane wu kya shenzǝ nzalî.&gt;&gt; Sǝ aburane wario à kya shenzǝ Ai. <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />Sǝ à nyar aban Jesǝwa à yi banggi wi ama, &lt;&lt;Kǝa nying aɓwana kat ɓǝà kyan kano ɗàng; tasǝ aburana kǝla á-ɓari ko á-tàrú ɓǝà kyan nǝ lwa a Ai. Kǝa tsǝk aɓwana kat aɓa tanni aban ká ban mǝno ɗàng, acemǝnana à nda kpokyak.&gt;&gt; <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />Acemani ka, aburana kǝla á-tàrú ateà na, à wari a lwa ka, sǝama amǝ Ai kya loasǝtea nǝ mire.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="LEV 26:17">Pǝris 26:17</ref>; <ref loc="DEU 28:25">Nggur 28:25</ref></char>.</note> <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />Aburana mala amǝ Ai wàl lú aburana mala amǝ Isǝrayila kǝla lumi-tàrú bwamdǝ tongno-nong-mwashat (36); à pǝria lo a kún nggea-là aban ká ɗār a Shebarim, sǝ à kya gandǝia a ɓun a ɓangŋaban. Sǝ ɓabum aɓwe tùmùr.<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />Pǝlǝa Jesǝwa sàn agir-nggūrǝu male sǝ sarǝa a nzali nǝ ɓamǝsǝi aɓadǝm Akwati mala Yahweh bà pwarikpǝra, yì andǝ aɓwana-mǝgule mala amǝ Isǝrayila. Sǝ à so tú a ɓamuria. <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />Sǝ Jesǝwa pakhiwi ama, &lt;&lt;Oi Mǝtalabangŋo Ɓakuli, palang sǝ a yinǝ sǝm a nkaring Jodan, ace túr sǝm a ɓabù amǝ'Amor, ɓǝà kiɗikì sǝm le? Kǝpǝna sǝm uena a takuli mala Jodan! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />We Mǝtalabangŋo, mana mǝ nǝ gandǝnǝ na ado, yi mǝnana amǝ Isǝrayila pǝlǝna nzǝmia arǝ aɓia-mǝbura ka! <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />Acemǝnana amǝ'Kan'ana andǝ acili aɓwana mana kat à do a nzalinì ka, à nǝ̀ okce sǝ à nǝ̀ yia gumbǝli sǝm, à nǝ̀ esǝki lullǝ sǝm aɓa ɓanza. Sǝ mana awu nǝ̀ pa ace lùllǝú zǝkya mò?&gt;&gt;<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />Yahweh banggi Jesǝwa ama, &lt;&lt;Lo! Mana tsǝa sǝ a sarǝa a nzali nǝ ɓamǝsǝo anggo? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />Amǝ Isǝrayila pángŋǝ̀nà cauɓikea; à yàlǝ́nì kùrcau mem mana ǝn pea wia ka; à twalna aɓalǝ agir mǝnana à tària ka; à iu aɓalǝ agir mǝnana à tària ka, à tsǝia aɓalǝ agir malea, sǝ à nana'nyir. <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />Acemani ka, amǝ Isǝrayila pà nǝ̀ gandǝ came aɓadǝm aɓia-mǝbura ɗang.<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 14:45">Ɓal 14:45</ref>; <ref loc="JDG 2:14">Akas 2:14</ref></char>.</note> À pǝlǝ nzǝmia aɓadǝm aɓia-mǝbura, acemǝnana à tàrnia ace kiɗikiban.<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="fq" closed="false">à tàrnia ace kiɗikiban </char><char style="ft">ko à tàrnia kǝla pàgir aban Yahweh (ace kiɗikia)</char>.</note> Pà Mǝ nǝ̀ pa atà wun ɗǝm ɗàng, sheɓǝ̀ wu kìɗìkìna agir mǝnana à tària ace kiɗikiban aɓalǝ wun ngga. <verse eid="JOS 7:12" /><verse number="13" style="v" sid="JOS 7:13" />Lo! Tàr aɓwana sǝ wu nea wia ama, &lt;Wu tàr ɓamur wun ace lí; acemǝnana Yahweh Ɓakuli mala amǝ Isǝrayila bang ama, &lt;&lt;Aɓea agir nakam aɓalǝ wun, mǝnana à tàrnia ace kiɗikia ka, wun amǝ Isǝrayila. Pà wu nǝ̀ gandǝnǝ came a kún aɓiwun-amǝbura ɗàng sheɓǝ̀ wu pusǝna agirnì aɓalǝ wun mǝnana à tàrnia ace kiɗikia ka.&gt;&gt;&gt; <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />Acemani ka, li nǝ dǝmbari, atau ma'wun kat nǝ̀ yia ramba ace lǝmdǝ ɓamur rǝ wun aɓadǝm Yahweh, tàu anzǝm tàu. Sǝ tàu mǝnana Yahweh lǝmdǝ ama nda kumcau ka, nǝ̀ yiu tù arǝ anggurkwar malea. Sǝ nggurkwar mǝnana Yahweh lǝmdǝ ama nda kumcau ka, nǝ̀ yiu tù arǝ aɓala malea. Sǝ ɓala mǝnana Yahweh lǝmdǝ ama nda kumcau ka, aburana mana a ɓalae ka à nǝ̀ yiu tù aɓadǝm Yahweh mwashat-mwashat. <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />Sǝ ɓwa mana à kumi nda twal agir mǝnana à tària ace kiɗikia ka, ɓǝà pisǝì nǝ ɓǝsa, yì andǝ agir mǝnana kat ɓwe ndanǝi ka, acemǝnana ɓwe yàlǝ́nì kùrcau mala Yahweh, sǝ acemǝnana yi ka, pàngŋǝ̀nà nggea gir kǝsǝkya a Isǝrayila.&gt;&gt;<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />Nda Jesǝwa lo nǝ dǝmbari ɗiɗyal, sǝ yinǝ koya tàu mala amǝ Isǝrayila tù aɓadǝm Yahweh mwashat-mwashat; sǝ Yahweh lǝmdǝ ama tàu mala Yahuda na kumcau ka. <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />Sǝ Jesǝwa yinǝ anggurkwar mala tàu mala Yahuda tù aɓadǝm Yahweh mwashat-mwashat, sǝ Yahweh lǝmdǝ ama nggurkwar mala Zera na kumcau ka. Sǝ yinǝ aɓwana-mǝgule mala koya ɓala a nggurkwar mala Zera tù aɓadǝm Yahweh mwashat-mwashat, sǝ Yahweh lǝmdǝ ama ɓala mala Zabdi na kumcau ka. <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />A masǝlǝate ka Jesǝwa yinǝ koya ɓwabura mana a ɓala mala Zabdi ka tù aɓadǝm Yahweh mwashat-mwashat, sǝ Yahweh lǝmdǝ ama Akan muna-ɓwabura mala Karmi, muna-ɓwabura mala Zabdi, muna-ɓwabura mala Zera, a tàu mala Yahuda na kumcau ka.<verse eid="JOS 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 7:19" />Pǝlǝa Jesǝwa banggi Akan ama, &lt;&lt;Munem pè Yahweh, Ɓakuli mala amǝ Isǝrayila gulo sǝ wu pusǝta ɓamuro. Sǝ wu banggam adyan gìr mǝnana a pàk ka; kǝa sǝmbǝ́rǝàmì ɗàng.&gt;&gt; <verse eid="JOS 7:19" /><verse number="20" style="v" sid="JOS 7:20" />Sǝ Akan pè Jesǝwa eare ama, &lt;&lt;Mǝsǝcaua, ǝn pángŋǝ́nì Yahweh Ɓakuli mala amǝ Isǝrayila cauɓikea, sǝ mǝnia ka nda gìr mǝnana ǝn pê ka: <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />Lang ǝn sǝn nggea-daura mǝɓoarjami mala amǝ Shinar<note caller="+" style="f"><char style="fr" closed="false">7:21 </char><char style="fq" closed="false">Shinar </char><char style="ft" closed="false">Ɓè lullǝ Shinar ka nda Babila.</char></note> aɓalǝ agǝna-lwa, andǝ bolo-azǝrfa shekel gbǝman-ɓari (200), andǝ gbǝlang bolo-njengǝlan mǝnana dǝmbǝrya male na shekel lumi-tongno (50) ka, pǝlǝa ǝn pàk nzumon malea sǝ ǝn twalia. Ən tǝm tūli a nzali aɓa gumli mem, ǝn sǝmbǝrǝia kam andǝ bolo-azǝrfa a tǝ́rtè a nzali.&gt;&gt;<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />Nda Jesǝwa tasǝ amǝ'na-túrbân, sǝ à ɓangŋa à wari a gumli mala Akan; sǝ lang à wari ka, à kya kum agirnì à sǝmbǝrǝnia aɓa gumli male nǝ bolo-azǝrfa a tǝrtea a nzali. <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />Sǝ à pusǝia aɓa gumli, à yinǝia aban Jesǝwa sǝ aban amǝ Isǝrayila kat. Sǝ à tsǝia a nzali aɓadǝm Yahweh. <verse eid="JOS 7:23" /><verse number="24" style="v" sid="JOS 7:24" />Sǝ Jesǝwa andǝ amǝ Isǝrayila kat twal Akan muna-ɓwabura mala Zera, andǝ bolo-azǝrfa, andǝ nggea-daura, andǝ bolo-njengǝlan, andǝ amuna-burana, andǝ amuna-mamǝna male, andǝ andá male, andǝ amǝdambǝriso andǝ anzur male, andǝ gumli male andǝ agir mǝnana kat ndanǝia ka. Sǝ à yinǝia a Ɓangŋaban mala Ako.<note caller="+" style="f"><char style="fr" closed="false">7:24 </char><char style="fq" closed="false">Ɓangŋaban mala Ako </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 15:7">Jes 15:7</ref>; <ref loc="ISA 65:10">Isha 65:10</ref>; <ref loc="HOS 2:15">Hos 2:15</ref></char>.</note> <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />Sǝ Jesǝwa bang ama, &lt;&lt;Mana tsǝa sǝ a yinǝ mǝnia yì tanni ka amúr sǝm? Yahweh nǝ̀ yinǝ tanni amuro yalung.&gt;&gt; Sǝ amǝ Isǝrayila kat ɓukki nǝ atali à wal-lui; ɗǝm ngga à ɓukki amǝɓala male nǝ atali sǝ à pisǝia a bǝsa andǝ agirkuma male. <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />Sǝ à ram atali amurí gum-gum mǝnana ndakam bà pwari man yalung ngga. Pǝlǝa Yahweh pǝlǝ nzǝmi arǝ bumlulla male. Acemani ka, bà pwari man yalung ngga, à kǝ tunǝ lùllǝ banì ama Ɓangŋaban mala Ako.<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="fq" closed="false">Ako </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;tanni.&gt;&gt;</char></note><verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s">À kiɗiki Ai</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />Pǝlǝa Yahweh banggi Jesǝwa ama, &lt;&lt;Cè ɓangciu pakko ko ɓabumo ɓungi ɗang.<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa </char><char style="xt"><ref loc="DEU 1:21">Nggur 1:21</ref>; <ref loc="DEU 7:18">7:18</ref>; <ref loc="DEU 31:8">31:8</ref>; <ref loc="JOS 1:9">Jes 1:9</ref>; <ref loc="JOS 10:25">10:25</ref></char>.</note> Pwan amǝ'lwa kat atò, sǝ wu lo wu kyan nǝ munǝo arǝ nggea-là Ai. Sǝni, ǝn pana wun murǝm Ai, andǝ aɓwana male, andǝ nggea-là male, andǝ nzali male a ɓabù wun. <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />Wu pangnǝ Ai andǝ murǝm male kǝla mǝnana wu pangnǝ Jeriko andǝ murǝm male ka; kǝ agirkuma malea andǝ agirkusǝu malea na wun nǝ̀ gbǝwia ace ɓamurǝ wun ngga. Wu kùmsǝî nggea-lê anzǝmi.&gt;&gt;<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />Nda Jesǝwa andǝ amǝ'lwa kat puro ace kánǝ munǝo arǝ Ai ka. Jesǝwa tàrki akanggǝrang aburana amǝ'ɓabum-candǝa á-lumi-tàrú, sǝ tasǝia nǝ du ɓǝà kyane. <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />Banggia wia ama, &lt;&lt;Wu sǝni, wun nǝ̀ kùmsǝî nggea-là Ai anzǝmi, a ban mǝnana sappì wi raka, sǝ wun kat ka wu do aɓa gilǝrǝu mala ká arǝì. <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />Mim sǝnǝ aɓwana mǝnana atàm ngga, sǝm nǝ̀ gbàshìban nggea-lê. Sǝ lang aburana mala Ai purna aban yiu arǝ sǝm, kǝla mǝnana à pè atadǝmbe ka, sǝm nǝ̀ wulio, sǝm nǝ̀ ɓangŋa a ɓadǝmbia. <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />Sǝ à nǝ̀ pǝrta sǝm, sheɓǝ̀ sǝm swárǝnia à upini nggea-là ka. Yià ka à nǝ̀ bang ama, &lt;À ndarǝ ɓangga sǝm kǝla mana à pè a tadǝmbe ka.&gt; Sǝ lang sǝm ndarǝ ɓangŋa a ɓadǝmbia ka, <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />wun nǝ̀ loapi ban kùmsǝó, sǝ wun nǝ̀ ak nggea-lê, acemǝnana Yahweh Ɓakuli ma'wun nǝ̀ pà wuni a ɓabu wun. <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />Tù anzǝm mana wu angŋǝna nggea-lê ka, wu soaki wi bǝsa. Wun nǝ̀ pàk gìr mǝnana cau mala Yahweh bang ngga. Wu sǝni, ǝn pana wun nzongcau.&gt;&gt;<verse eid="JOS 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 8:9" />Pǝlǝa Jesǝwa tasǝia, sǝ à puro à wari a ban mǝnana à nǝ̀ kùmsǝ kam ngga, sǝ à kundǝ kam, anre Betel andǝ Ai, a bu njar-nzali mala Ai; sǝ Jesǝwa ka ueo atà aɓwana a kàttì a dù mǝno.<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />Lang banfana ka, Jesǝwa lo nǝ dǝmbari ɗiɗyal sǝ ramba amǝ'lwa male abanɓwáná, pǝlǝa yì andǝ aɓwana-mǝgule mala amǝ Isǝrayila ka à ak dǝmba, nǝ amǝ'lwa ateà aban ká a Ai. <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />Amǝ'lwa mǝnana atè puppup ka, à wario à gbàshìban kún nggea-là Ai, sǝ à kya tsǝk kàttì nǝ njar-nza mala Ai, a ban mǝnana ɓangŋaban nakam anrea andǝ nggea-lê ka. <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />Jesǝwa twal aburana á-tongno sǝ tasǝia ɓǝà kya kùmsǝó anre Betel andǝ Ai, a bu njar-nzali mala nggea-lê. <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />Anggo sǝ à tamsǝ amǝ'lwa ace munǝo; bangulea mǝnana a kàttì ka à tamsǝia nǝ njar-nza mala nggea-lê, sǝ amǝ'yál-nzǝmia ka nǝ njar-nzali. Nǝ du mǝno ka Jesǝwa sulǝo aɓa ɓangŋabanì.<verse eid="JOS 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 8:14" />Lang murǝm Ai sǝn gìr mǝnia ka, yì andǝ aburana male mǝnana a nggea-lê ka, à lo tsuk-tsuk nǝ dǝmbari ɗiɗyal ace ká je-munǝo andǝ amǝ Isǝrayila a ban-je mǝnana a ɓadǝm ɓawanban Araba ka. Sǝ yì ka sǝlǝ ama à kùmsǝni wi anzǝm nggea-là ɗàng. <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />Jesǝwa andǝ amǝ Isǝrayila ɓosǝkirǝia kǝla amǝ Ai gandǝnia, sǝ à ɓangŋa a ɓadǝmbia aban o nǝ njarban ɓabondo. <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />Nda à tunǝ aɓwana mǝnana kat aɓa nggea-là ka ɓǝà puro ace pǝrtea, sǝ aɓa pǝrta Jesǝwa anggo ka à swáriǎ à upì nggea-là. <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />Kǝ ɓwabura ueo aɓa Ai ko Betel mǝnana pur aban ká pǝrta Isǝrayila raka ɗàng. À nying nggea-là atarǝì sǝ à oa pǝrta Isǝrayila.<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />Pǝlǝa Yahweh banggi Jesǝwa ama, &lt;&lt;Loasǝ nkongŋo mǝnana a buo ka sǝ wu lǝmdǝí nǝ njarban Ai, acemǝnana mǝ nǝ pà mǝnia yì nggea-là ka a ɓabuo.&gt;&gt; Nda Jesǝwa loasǝ nkongŋo mǝnana a buì ka sǝ lǝmdǝí nǝ njarban nggea-lê. <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />Tù anzǝm mǝnana Jesǝwa loasǝna buì a kuli ka, kara aburana mǝnana à kùmsǝ a bondo ka à loapi ban kumsǝó malea akaurǝa, à twal-mire à kùtí aɓa nggea-lê à é. Pǝlǝa à fàrǝia à soakì nggea-lê bǝsa. <verse eid="JOS 8:19" /><verse number="20" style="v" sid="JOS 8:20" />Sǝ lang aburana mala Ai pǝlǝ mǝsǝia nǝnzǝmia ka, à sǝn yele mala nggea-lê aban lo a kuli, sǝ kǝ njar pà kàm à nǝ̀ ɓangŋa ace àwá a buì man ko a buì mǝno ka ɗàng. Amǝ Isǝrayila mana à nda aban ɓangŋa aban ká nǝ ɓabondo ka, à wuli nǝnzǝmia aban yiu arǝ amǝ'pǝrtea. <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />Sǝ lang Jesǝwa andǝ amǝ Isǝrayila kat sǝni ama aburana mǝnana à kùmsǝ a bondo ka à angŋa nggea-lê, sǝ yele mala nggea-lê na aban lo a kuli ka, pǝlǝa à wulio sǝ à tita wal aburana mala Ai. <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />Amǝ Isǝrayila mǝno à kùtí aɓa nggea-là ka, à puro ace yiu arǝ aburana mala Ai; nda aburana mala Ai kum ɓamuria à gbālina a tsùrú mala amǝ Isǝrayila; aɓea a buì man sǝ aɓea a buì mǝno. Amǝ Isǝrayila camarǝ wal-luia ba, ko kǝɓwa atea ueo nǝyilǝmu ko apia wia ɗàng. <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />Murǝm Ai nǝmurǝi, nda à bwali andǝamǝsǝi sǝ à yinǝi aban Jesǝwa ka.<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />Lang amǝ Isǝrayila malna wal-lú aburana mala Ai kat a ɓawanban a ɓabondo, a ban mǝnana à pǝrtea kàm, sǝ yià kat bà masǝlǝata ɓwa ka à walna-luí nǝ kún nggeabyau ka, amǝ Isǝrayila kat nyar a Ai sǝ à wal-lú aɓwana mǝnana aɓalǝi ka nǝ kún nggeabyau. <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />Aɓwana mǝnana kat à wal-luia, aburana andǝ amamǝna, a pwari mǝno ka, à nda á-lum-nong-ɓari (12,000), aɓwana mala Ai kat. <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />Sǝ Jesǝwa ka nyesǝ bui mǝnana lǝmdǝna nkongŋo nǝi ka ɗàng she lang à twalnata amǝ Ai kat-kat ka. <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />Kǝ agirkusǝu andǝ akume-lwa mala nggea-lê na mǝnana amǝ Isǝrayila pwano kǝla gǝna-lwa ace ɓamuria ka, kǝla mǝnana Yahweh tsǝki Jesǝwa nzongcau ka.<verse eid="JOS 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 8:28" />Nda Jesǝwa pisǝ Ai sǝ tsǝì pǝlǝ gìgí tàtǝ́k, kǝla mǝnana ɓarwan na bà yalung ngga. <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />Gyar<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="fq" closed="false">Gyar: </char><char style="ft" closed="false">À wal-lui nǝ kún nggeabyau, à zuɓi a bumi nǝ nggun, sǝ à loasǝi à gyari a kuli.</char></note> murǝm Ai a nggun sǝ ɗeki kàm bà pwarikpǝra. Nǝ pwari-ká-ndwent ka, Jesǝwa tsǝa ama ɓǝà sulǝ luí a nggun, ɓǝà túrí a kún nggea-lê. Sǝ à ramggi wi atali amurí gum-gum, mǝnana ndakam bà yalung ngga.<verse eid="JOS 8:29" /></para>
  <para style="s">Jesǝwa nyare kwakita Kùrcau abǝshe a Nkono Ebal</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />A bàkú mǝno ka Jesǝwa ɓakkî Yahweh, Ɓakuli mala amǝ Isǝrayila gyangŋan <note caller="+" style="f"><char style="fr" closed="false">8:30 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="EXO 20:24">Pur 20:24</ref>,<ref loc="EXO 20:25">25</ref>; <ref loc="DEU 27:4-6">Nggur 27:4-6</ref></char>.</note>amúr Nkono Ebal. <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />Ɓè kǝla mǝnana Musa, guro mala Yahweh akdǝmba tsǝki amǝ Isǝrayila nzongcau ka, kǝla mǝnana à gilǝì a Malǝmce Nggurcau mala Musa ama: &lt;&lt;Wu ɓakkâm gyangŋan mala atali mǝnana à ɓunnia nǝ ɓunno ɗàng, sǝ à pàktúró nǝ ɓekǝ girtúró mala bolo-candǝa ace gilǝki rǝia raka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:31 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 27:4-6">Nggur 27:4-6</ref></char>.</note> Sǝ à pagìr mala pisǝe kǝring amurí aban Yahweh, andǝ pàgir mala dotarǝu. <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />Nggurcau mala Musa mǝnana akdǝmba gilǝni ka, Jesǝwa ɓǝsǝlǝ gilǝe ɗǝm amur amǝnia yì atali ka, a ɓadǝmba amǝ Isǝrayila. <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />Isǝrayila kat, abǝri andǝ amǝ'là, koyan kat, atārǝia andǝ aɓwana-mǝgule, andǝ amǝgulo, andǝ amǝ'ɓashi malea, à gau arǝ abanì ɓari sǝ à cam a koya buì mala Akwati Kùrcau mala Yahweh, mǝnana cam aɓalǝu, a ɓadǝmba amǝ twale, yì apǝris amǝkà Lawi<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="DEU 31:9">Nggur 31:9</ref>,<ref loc="DEU 31:25">25</ref></char>.</note> ka. Gauwa-tsùrú mala aɓwana ka à cam aɓadǝm Nkono Gerizim, sǝ ɓè gauwa-tsùrú ka aɓadǝm Nkono Ebal. À pàk mǝnia kat aɓa kpata nzongcau mǝnana Musa guro mala Yahweh akdǝmba pania wia a tadǝmbe, ace tsǝki amǝ Isǝrayila bù ka. <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />Anzǝm mǝno ka, Jesǝwa ɓallì aɓwana acau mǝnana kat aɓa nggurcau ka, kat andǝ atsǝkbu andǝ asuban, kǝla mǝnana à gilǝia aɓa Malǝmce mala Nggurcau ka.<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="DEU 28:2-68">Nggur 28:2-68</ref>; <ref loc="DEU 30:19">30:19</ref></char>.</note> <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />Komǝye atà acau kat mala nzongcau mǝnana Musa pà ka, Jesǝwa ɓallia aɓadǝm ramba mala Isǝrayila puppup, kat andǝ amamǝna, andǝ amuna, andǝ abǝri mǝnana à do aɓalǝia ka.<verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s">Kùrkûn mala amurǝma andǝ swarkiban mala amǝ'Gibiyon</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />Lang cau mala limurǝm mala Jesǝwa bik ban amurǝma mana kat à nda a njar-nzali mala Nggeasala Jodan, yià amurǝma mala amǝ'Hitti, andǝ mala amǝ'Amor, andǝ mala amǝ'Kan'ana, andǝ mala amǝ'Periz, andǝ mala amǝ'Hivi, andǝ mala amǝ'Jebus, mǝnana à do aɓa nzali múr-ankono, andǝ ɓá nzali kusǝ-ankono, andǝ kún Nggeamùr Mǝgule aban ká nǝban ɓadǝmba ankono Lebano ka, <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />à ram rǝia abanɓwáná sǝ à kpapikunia à nǝ̀ kánǝ munǝo arǝ Jesǝwa andǝ Isǝrayila. <verse eid="JOS 9:2" /><verse number="3" style="v" sid="JOS 9:3" />Sǝama lang aɓwana mǝnana à do a Gibiyon okce gìr mǝnana Jesǝwa pangnǝ amǝ Jeriko andǝ amǝ Ai ka, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />à twalî ɓamuria à nǝ̀ feri, sǝ aɓea aɓwana malea ɓosǝkia rǝia kǝla à nda ka amǝ'pwantu mǝnana à pur a ɓè nzali kuko ka. À twal agirlina sǝ à tsǝki a'eakǝna buku a nzǝm amǝdambǝriso malea, sǝ à twal asambǝram mǝ'e mana à arkya sǝ à kpakǝria ka, a buia. <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />À oasǝki a'eakǝna ankura mǝnana à kasǝkya sǝ à swària ka, a kusǝia, sǝ à oasǝ agir-nggūrǝu mǝnana à tsǝurina ka, arǝia. Ɗǝm ngga bǝredi mǝnana kat à twal ace girlina malea ka, a'imǝne andǝ aɓwangine na. <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />Pǝlǝa à wari a kàttì mala amǝ Isǝrayila a Gilgal, sǝ à ne Jesǝwa andǝ aburana mala Isǝrayila ama, &lt;&lt;Sǝm pur a ɓè nzali kuko. Ida, wu kùrcau nǝ sǝm.&gt;&gt;<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />Sǝ aburana mala Isǝrayila ɗika amǝ'Hivi, ama, &lt;&lt;Yakǝla wu ndanǝdo aɓalǝ sǝm ngga, lang sǝ sǝm nǝ̀ kùrcau nǝ wun?&gt;&gt; <verse eid="JOS 9:7" /><verse number="8" style="v" sid="JOS 9:8" />À banggi Jesǝwa ama, &lt;&lt;Sǝm ngga, sǝm nda ka aguro ma'wun.<note caller="+" style="f"><char style="fr" closed="false">9:8 </char><char style="fq" closed="false">sǝm nda ka aguro ma'wun </char><char style="ft" closed="false">ko &lt;&lt;sǝm earna sǝm nǝ̀ duk aguro ma'wun.&gt;&gt;</char></note>&gt;&gt; Sǝ Jesǝwa ɗia ama, &lt;&lt;Wun nda ka ayana? Sǝ wu pur nǝ kǝshe?&gt;&gt; <verse eid="JOS 9:8" /><verse number="9" style="v" sid="JOS 9:9" />À eari wi ama, &lt;&lt;Sǝm aguro mò ka, sǝm pur a ɓè nzali bansauwa kuko sǝ sǝm yiu, ace lullǝ Yahweh Ɓakuli ma'wun. Sǝm ongŋǝna zǝ́kí mala lullǝì, andǝ gir mǝnana kat pè a Masar, <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />andǝ gir mǝnana kat pàkkî amurǝma ɓari mala amǝ'Amor a takuli mala Jodan, yià Sihon murǝm mala Heshbon, andǝ Og murǝm mala Bashan, mana do a Ashtarot ka. <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />Aɓwana-mǝgule ma'sǝm andǝ aɓwana mǝnana kat à ndanǝdo a nzali ma'sǝm ngga, à bangga sǝm ama, &lt;Wu twal agirlina mǝnana nǝ̀ kánǝ wun ace bǝri mǝnia wun nǝ̀ twal ka. Wu kyane wu kumia sǝ wu banggia wia ama, &lt;&lt;Sǝm nda ka aguro ma'wun. Ado ka, wu kùrcau nǝ sǝm.&gt;&gt; &gt; <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />A pwari mǝnana sǝm nying là sǝ sǝm lo ace ká aban wun ngga, sǝm twal bǝredi ma'sǝm mǝnia ka andǝa pi male, ace girlina ma'sǝm mǝnana sǝm nǝ̀ li a njar aban yiu ka. Sǝ ado ka, wu sǝni! Imǝna sǝ ɓwangina. <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />Asambǝram mǝnia ka, abǝshe na lang sǝm lùmsǝkia ka, sǝ adyan ngga wu sǝni! À arkina. Agir-nggūrǝu andǝ ankura ma'sǝm ena atàcau mala gya nggea mǝsauwe mǝnana sǝm twal ka.&gt;&gt;<verse eid="JOS 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 9:14" />Aburana mala amǝ Isǝrayila man eare à lì atà aɓea agirlina mala aɓwana man, sǝ à alta nê a kún Yahweh ɗàng. <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />Anggo sǝ Jesǝwa kùtí aɓa eare mala do aɓa rǝpwala nǝ aɓwana man, sǝ kùrcau nǝia, ace ɗeki aɓwana malea ɓǝà auwa. Aɓwana-mǝgule amur ɓwabundǝa mala amǝ Isǝrayila kángìr ama Isǝrayila nǝ̀ bwal mǝnia yì pàcau ka.<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />Anongŋo tàrú anzǝm mana amǝ Isǝrayila kutina aɓa kùrcau andǝ amǝ'Gibiyon ngga, amǝ Isǝrayila yi ok ama yià ka, aɓia amǝ'múrkala na, mǝnana à ndanǝdo tù abania ka. <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />Nda amǝ Isǝrayila lo aban ká, sǝ a tàruià nongŋo ka, à bik ban anggea-là malea: Gibiyon, andǝ Shifǝra, andǝ Beerot, sǝ Kiriat-Jarim. <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />Sǝama amǝ Isǝrayila soa munǝo arǝia ɗàng, acemǝnana aɓwana-mǝgule amur ɓwabundǝa angŋa dǝmba kánbinia wia nǝ lullǝ Yahweh, Ɓakuli mala amǝ Isǝrayila. Pǝlǝa ɓwabundǝa kat nggwani arǝ aɓwana-mǝgule malea. <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />Sǝ aɓwana-mǝgule kat banggi ɓwabundǝa ama, &lt;&lt;Sǝm angŋa dǝmba sǝm kánbinia wia nǝ lullǝ Yahweh, Ɓakuli mala amǝ Isǝrayila, ama pa sǝm nǝ̀ jea ɗàng. <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />Gìr mǝnana sǝm nǝ̀ pangnǝia ka, ndya ka: sǝm nǝ̀ nyia ɓǝà dum nǝyilǝmu, ace mǝnana bumlulla mala Ɓakuli ɓǝkǝa sulǝo amur sǝm atàcau mala kána mana sǝm kánbia wia ka ɗàng. <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />Ɓǝ̀ sǝm ɗekia ɓǝà auwa, sǝama à nǝ̀ duk amǝ'túró kasǝ nggun andǝ amǝ to mùr ace ɓwabundǝa kat.&gt;&gt; Mǝno ka nda cau mǝnana aɓwana-mǝgule banggia wia ka.<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />Osso Jesǝwa tunǝ amǝ'Gibiyon sǝ ɗia ama, &lt;&lt;Palang sǝ wu swarki sǝm, wu na sǝm ama, wu ndanǝdo kuko, sǝ yale wu ndanǝdo kani aɓalǝ sǝm? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />Acemani ka, wun nda aɓata suban: wun nǝ̀ duk aguro tàtǝ́k andǝ amǝ'túró kasǝ nggun, andǝ ɗarǝki mur ace ɓala mala Ɓakuli mem.&gt;&gt;<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />À earî Jesǝwa ama, &lt;&lt;Cau yiu aban sǝm, aguro mò, ama mbak-kàngkàng Yahweh, Ɓakuli ma'wun bangŋǝ́nì guro male Musa ama ɓǝ̀ pà wun nzali mǝnia ka puppup, sǝ ɓǝà twalta aɓwana mǝnana à ndanǝdo aɓalǝi ka kat aɓa ká ma'wun. Mǝno ka tsǝa ǝn'o bwal sǝm kǝ̀rkǝ́r arǝ wun, ace ayilǝmi sǝm, sǝ sǝm pàk mǝnia yì gìr ka. <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />Sǝm adyan ngga, sǝm nda a ɓabu wun. Wu pàkka sǝm gìr mǝnana wu sǝni nda mǝɓoarne sǝ nda pepè a mǝsǝ wun ngga.&gt;&gt;<verse eid="JOS 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 9:26" />Nda Jesǝwa pàk mǝnia ka acea: amsǝia a ɓabu amǝ Isǝrayila, sǝ à wal-luia ɗàng. <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />Sǝama a pwari mǝno ka, Jesǝwa tsǝk amǝ'Gibiyon à duk amǝtúró kasǝ nggun andǝ to mur ace ɓwabundǝa, sǝ ace gyangŋan mala Yahweh, a ban mǝnana Yahweh nǝ̀ tàri ka. Sǝ mǝno ka nda gìr mǝnana à lidǝmba nǝ pe ka bà yalung.<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s">Pwari cam piu</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />Adyan ngga, Adoni-zedek, murǝm Urǝshalima ok ama, Jesǝwa angŋǝna Ai, kiɗikini kat-kat, sǝ pàngŋǝ̀nà nǝi kǝla mǝnana pangnǝ Jeriko andǝ murǝm male ka. Sǝ lang ok ɗǝm ama, amǝ'Gibiyon ngga, à alǝnata do-rǝpwala andǝ Isǝrayila, sǝ à nda aban do aɓalǝia ka, <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />ɓangciu bwali kǝ̀rkǝ́r, acemǝnana Gibiyon ngga, nggea-là mǝgule na, kǝla mwashat atà anggealà-murǝm; gulo-kuti Ai, sǝ aburana male kat ka akanggǝrang amǝ'lwa na. <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />Nda sǝ Adoni-zedek, murǝm Urǝshalima, túrban atà Hoham, murǝm Hebǝron, andǝ Piram, murǝm Jarmut, andǝ Jafiya, murǝm Lakish, andǝ Debir, murǝm Egǝlon ngga, ama: <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />&lt;&lt;Wu yiu atam, wu pakkam gbasha. Ɓǝ̀ sǝm kyan nǝ munǝo arǝ Gibiyon; acemǝnana yià ka, à alǝnata do-rǝpwala nǝ Jesǝwa andǝ amǝ Isǝrayila.&gt;&gt;<verse eid="JOS 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 10:5" />Nda amurǝma mǝnia tongno mala amǝ'Amor (murǝm mala Urǝshalima, andǝ murǝm mala Hebǝron, andǝ murǝm mala Jarmut, andǝ murǝm mala Lakish, andǝ murǝm mala Egǝlon) ram rǝia abanɓwáná sǝ à eauwe, yià andǝ amǝ'lwa malea, à yi tsǝk kàttì ace ká arǝ Gibiyon, sǝ à warinǝ munǝo arǝì.<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />Pǝlǝa amǝ'Gibiyon túrban atà Jesǝwa aɓa kàttì a Gilgal, ama: &lt;&lt;Kǝa vwakibu arǝ aguro mò ɗàng! Yiu aban sǝm akaurǝa, wu amsǝ sǝm! Wu bwala sǝm nggam, acemǝnana amurǝma mala amǝ'Amor kat, mǝnana à ndanǝdo a nzali múr-ankono ka, à ramǝna rǝia abanɓwáná arǝ sǝm.&gt;&gt;<verse eid="JOS 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7" />Nda Jesǝwa lo a Gilgal andǝ amǝ'lwa male puppup atè, andǝ akanggǝrang aburana kat amǝ'ɓabum-candǝa aban ká. <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />Pǝlǝa Yahweh banggi Jesǝwa, ama, &lt;&lt;Cè ɓangciu pakko arǝia ɗàng, acemǝnana ǝn pano wia a ɓabuo. Ko kǝ ɓwa mwashat atea, pà nǝ̀ gandǝ came a kuno ɗàng.&gt;&gt;<verse eid="JOS 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 10:9" />Anzǝm mana Jesǝwa andǝ amǝ'lwa male longŋǝ́nì Gilgal ka, à gya à mal du sǝ à yi eau-amur amǝ'Amor aɓa yasǝlǝban hǝrkit. <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />Sǝ Yahweh túriá aɓa zurǝki aɓadǝm Isǝrayila, sǝ Jesǝwa andǝ amǝ Isǝrayila limurǝm amúrià nǝ wal-luia, nggea walban a Gibiyon. Amǝ Isǝrayila pǝrtea amur njargula mana eau aban ká Bet-Horon ngga; sǝ à camarǝ wal-luia a njar kat aban ká ɗār a Azeka andǝ Makkeda. <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />Lang amǝ'Amor nǝ̀ nggǝ ɓangŋa aɓadǝm amǝ Isǝrayila, sǝ lang à bingŋǝ́nà ɓunno mala Bet-Horon ngga, Yahweh túrià wia atali mǝgulke amúrià nǝ kuli, amúr njar kat aban ká Azeka, sǝ à wukio. Aɓwana mǝnana à wǔ nǝ ɓukkiban mala talimbulo ka, lakkì malea kútì mala aɓwana mana amǝ Isǝrayila wal-luia nǝ kún nggeabyau ka.<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />A pwari mǝnana Yahweh tasǝna amǝ'Amor nǝi a ɓabu amǝ Isǝrayila ka, Jesǝwa bangcau nǝ Yahweh aɓadǝm amǝ Isǝrayila ama:</para>
  <para style="q1" vid="JOS 10:12">&lt;&lt;Pwari, cam piu amur Gibiyon,</para>
  <para style="q1" vid="JOS 10:12">sǝ we zongŋo ka, came, amur Ɓangŋaban mala Aijalon.&gt;&gt;<verse eid="JOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOS 10:13" />Anggo, sǝ pwari cam piu, sǝ zongŋo gbal ka, came,</para>
  <para style="q2" vid="JOS 10:13">bà Isǝrayila malǝna kánǝ mbweban-akúnì amur aɓia-mǝbura ka.</para>
  <para style="m" vid="JOS 10:13">Mǝnia yì cau ka ndakam a gilǝe aɓa malǝmce mala Jashar. Pwari came, a ɓongŋu a bumkuli, sǝ kpa ɗang ba sauwa mala nongŋo mwashat. <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />Kǝ ɓè pwari pà kàm kǝla mǝno ka ɗàng, ko a dǝmbi ko a nzǝmi, mǝnana Yahweh, kwakikiri oakî ɓwapǝndǝa ka. Yahweh ka, munǝ ace Isǝrayila.<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />Pǝlǝa Jesǝwa nyare andǝ amǝ Isǝrayila kat atè, a kàttì mana a Gilgal ka.<verse eid="JOS 10:15" /></para>
  <para style="s">À wal-lú amurǝma tongno mala amǝ'Amor</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />Amǝno yì amurǝma tongno ka, à ɓangŋa à kya sǝmbǝrǝ aɓa npu, a Makkeda. <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />Lang à banggi Jesǝwa ama, amurǝma mǝnia tongno ka, à kumǝnia aban sǝmbǝrǝa aɓa npu a Makkeda ka, <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />Jesǝwa bang ama, &lt;&lt;Wu jambǝrǝki atali mǝgulke, ɓǝà gìr kún npunì, sǝ wu tasǝ amǝ'yalban, ɓǝà kǝ yal kún mǝno yì npu ka.<verse eid="JOS 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 10:19" />&lt;&lt;Sǝama wun nǝ nggearǝ wun ngga, wu kǝa cam abanì ɗàng, wu pǝrta aɓiwun amǝbura! Wu kyan nǝ munǝo arǝ amǝ'yál nzǝmia. Wu kǝa earia wia ɓǝà kutiki aɓalǝ anggea-là malea ɗàng, acemǝnana Yahweh, Ɓakuli ma'wun ngga, pana wunia a ɓabu wun.&gt;&gt;<verse eid="JOS 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 10:20" />Anggo sǝ yi pa, tù anzǝm mana Jesǝwa andǝ amǝ Isǝrayila gandǝnia nǝ walban mǝkǝ̀rkǝ́rnì, ue bǝti tea-twalna, sǝ acilia mana à ueo aɓalǝia ka, à kutikina aɓalǝ anggea-là mana à kària nǝ akanggǝrang sheran ngga, <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />pǝlǝa amǝ'lwa mala amǝ Isǝrayila puppup nyar aban Jesǝwa a kàttì, a Makkeda aɓa rǝpwala. Kǝɓwa nacau mǝɓane amur amǝ Isǝrayila ɗàng.<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />Pǝlǝa Jesǝwa na ama, &lt;&lt;Wu mǝn kún npunî, wu pusǝ amǝno yì amurǝma tongno ka, wu yinǝia abanam.&gt;&gt;<verse eid="JOS 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 10:23" />Anggo sǝ à pǎ, à pusǝ amǝno yì amurǝma tongno, aɓa npu ka, à yinǝia abani; yià murǝm mala Urǝshalima, andǝ murǝm mala Hebǝron, andǝ murǝm mala Jarmut, andǝ murǝm mala Lakish, andǝ murǝm mala Egǝlon. <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />Lang à yinanǝ amurǝma mǝnia aban Jesǝwa ka, Jesǝwa tunǝ aburana mala amǝ Isǝrayila kat, sǝ banggi amǝ'sàrǝ̀ban mala amǝ'lwa male mǝnana à wari atè ka, ama: &lt;&lt;Wu sung tù. Wu tsǝk akusǝ wun a myal amurǝma mǝnia ka.&gt;&gt;</para>
  <para style="p" vid="JOS 10:24">Pǝlǝa à sung tù sǝ à tsǝk akusǝia a myalia.<verse eid="JOS 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 10:25" />Sǝ Jesǝwa banggia wia ama, &lt;&lt;Cè ɓangciu pàkka wun ɗàng; sǝ ɓabum wun ɓǝkǝa ɓungi ɗang. Wu cam kàngkàng, sǝ mǝsǝ wun ɓǝ̀ candǝe.<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">Sǝni gbal aɓa: </char><char style="xt"><ref loc="DEU 31:7">Nggur 31:7</ref>; <ref loc="JOS 1:6-7">Jes 1:6-7</ref>,<ref loc="JOS 1:9">9</ref>,<ref loc="JOS 1:18">18</ref></char>.</note> Ani sǝ Yahweh nǝ̀ pangnǝ aɓiwun amǝbura, mana wu kǝ kánǝ lwa arǝia ka.&gt;&gt;<verse eid="JOS 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 10:26" />Nǝnzǝ́mò ka Jesǝwa kwarkia, wal-luia, sǝ gyarki aluia amur anggun tongno. Anggo sǝ à nying aluia aban gyare amur anggun, ba kpa mala pwari.<verse eid="JOS 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 10:27" />Lang pwari kǝ ká kpa ka, Jesǝwa bangcau sǝ à sulǝ aluia arǝ anggun, à túriá aɓa npu mǝnana à sǝmbǝrǝ kam ɗiɗyal ka, sǝ à tsǝki atali mǝgulke a kún npu mǝno, mǝnana à ndakam ba yalung ngga.<verse eid="JOS 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />A kǝ pwari mǝno ka, Jesǝwa lì Makkeda. Wal-lú koya ɓwa a nggea-lê ka andǝ murǝm male nǝ kún nggeabyau. Kiɗiki kat-kat andǝ aɓwapǝndǝa mana aɓalǝi ka. Nying kǝɓwa ueo nǝyilǝmu ɗang. Pàkkî murǝm mala Makkeda, kǝla mana pàkkî murǝm mala Jeriko ka.<verse eid="JOS 10:28" /></para>
  <para style="s">Limurǝm amur anggea-là a njar-kunmur mala Kan'ana</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />Pǝlǝa Jesǝwa andǝ amǝ Isǝrayila kat lo a Makkeda sǝ à kùtí aban ká a Libna, sǝ à kya soa munǝo arǝ Libna. <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />Yahweh tasǝ Libna andǝ murǝm male a ɓabù amǝ Isǝrayila. Amǝ Isǝrayila gandǝ nggea-lê andǝ koya ɓwa mǝnana aɓalǝi ka nǝ kún nggeabyau. À nying kǝ ɓwa kàm au ɗàng. Kǝla mǝnana pangnǝ murǝm Jeriko ka, anggo sǝ pangnǝ murǝm Libna.<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />Pǝlǝa Jesǝwa andǝ amǝ Isǝrayila kat, nying Libna aban ká Lakish; à kya gumbǝli, puro pà kàm ɗàng, sǝ kutio pà kàm ɗàng; sǝ à wari nǝ lwa arǝì. <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />Pǝlǝa Yahweh pà Lakish a ɓabu Isǝrayila, sǝ à é a ɓaria nongŋo. À wal-lú aɓwana mana à do aɓalǝi ka kat nǝ kún nggeabyau, kǝla mǝnana à pangnǝ Libna ka.<verse eid="JOS 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 10:33" />Pǝlǝa Horam, murǝm mala Geza, eauwe yiu ama nǝ̀ bwali Lakish kàm. Sǝama Jesǝwa gandǝi andǝ amǝ'lwa male nǝ munǝo, yale nying kǝ ɓwa ateà ueo nǝyilǝmu ɗang.<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />Pǝlǝa Jesǝwa andǝ amǝ Isǝrayila kat, nying Lakish sǝ à kùtí aban ká a Egǝlon. À kya gumbǝli, puro pa kàm ɗàng sǝ kutio pa kàm ɗàng, sǝ à soa munǝo arǝì. <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />Akǝ pwari mǝno ka, à ak nggea-lê, à wal-lú aɓwana kat, mǝnana aɓalǝi ka nǝ kún nggeabyau, sǝ à kiɗiki koya ɓwa kàm kat-kat, kǝla mǝnana pangnǝ Lakish ka.<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />Pǝlǝa Jesǝwa, atārǝia andǝ amǝ Isǝrayila kat, à loapi Egǝlon, sǝ à wari nǝ lwa arǝ Hebǝron. <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />À ak nggea-lê, sǝ à wal-lú murǝm male nǝ kún nggeabyau, andǝ aɓwana mana aɓalǝi ka kat, andǝ amǝnana kat aɓalǝ anggea-là mana à kàrì ka. Nying kǝɓwa ɓǝ̀ au ɗàng, kǝla mǝnana pangnǝ Egǝlon ngga; tàr nggea-lê ace kiɗikiban kat-kat andǝ koya ɓwa mǝnana aɓalǝi ka.<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />Pǝlǝa Jesǝwa andǝ amǝ Isǝrayila kat, pǝlǝ nǝnzǝmia, à wari nǝ munǝo arǝ Debir. <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />À ak nggea-lê andǝ murǝm male andǝ anggea-là mǝnana à kàrì ka. À walia nǝ kún nggeabyau. Koya ɓwa mǝnana aɓalǝi ka à kiɗiki kat-kat; yale nying kǝɓwa ɓǝ̀ au ɗàng. Kǝla mana pangnǝ Hebǝron, sǝ kǝla mǝnana pangnǝ Libna ka, anggo sǝ pangnǝ Debir andǝ murǝm male.<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />Anggo sǝ Jesǝwa limurǝm nǝ lwa amur bu-nzali mǝno ka, kya bwal ban nzali múr-ankono, andǝ buì mala Negev, andǝ dulum, andǝ aɓunnoban, andǝ amurǝma malea kat. Yale Jesǝwa nying kǝɓwa arǝ abanì nǝyilǝmu ɗang. Gìr mǝnana kat kǝ lin'ueo ka twalte kat-kat, kǝla mana Yahweh, Ɓakuli mala amǝ Isǝrayila, tsǝki wi nzongcau ka. <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />Jesǝwa walia, twal a Kadesh-Baniya kya bwal a Gaza, andǝ bu-nzali Goshen kat, sǝ sarǝa aban ká a Gibiyon. <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />Amǝnia yì amurǝma kat andǝ anzali malea ka, Jesǝwa limurǝm amúrià aɓa pur ká lwa kusǝ mwashat, acemǝnana Yahweh, Ɓakuli mala amǝ Isǝrayila munǝ ace Isǝrayila ka.<verse eid="JOS 10:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 10:43" />Pǝlǝa Jesǝwa andǝ amǝ Isǝrayila kat nyar a kàttì, a Gilgal.<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s">Limurǝm amur anzali mala njar-nza mala Kan'ana</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />Lang Jabin murǝm mala Hazo ok cau mala agir mǝnia ka, túrban atà Jobap murǝm mala Madon, andǝ murǝm mala Shimron, andǝ murǝm mala Akshaf, <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />sǝ atà amurǝma mala nzali múr-ankono a njar-nza, andǝ amana a Araba a Chineret nǝ njar-kúnmur, andǝ amana a nzali kusǝ-ankono, andǝ amana arǝ amgbangban mala Dor nǝ njar-nzali, <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />sǝ atà amǝ'Kan'ana a njar-takuli andǝ njar-nzali, andǝ amǝ'Amor, andǝ amǝ'Hitti, andǝ amǝ'Periz, andǝ amǝ'Jebus aɓa nzali múr-ankono, andǝ amǝ'Hivi a kusǝ nkono Hamon a nzali Mizpa. <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />À pur kat andǝ amǝ'lwa malea atea, ɓwabundǝa wurutu kǝla mǝsǝsala a kún nggeamùr, nǝ apǝr andǝ awaru-pǝr nggea mǝ'làkke. <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />Amurǝma mǝnia kat ram rǝia sǝ à yiu, à yi tsǝk kàttì abanɓwáná a kún myalmúr Merom, ace kánǝ lwa arǝ Isǝrayila.<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />Yahweh banggi Jesǝwa ama, &lt;&lt;Cè ɓangciu pàkkô arǝia ɗàng; lí a bu-pwari mǝnia ka, mǝ nǝ tasǝia a ɓabu Isǝrayila ɓǝ̀ wal-luia puppup. Wun nǝ̀ kasǝki amazo kusǝ apǝr malea, sǝ wun nǝ̀ pisǝ awaru-pǝr malea a bǝsa.&gt;&gt;<verse eid="JOS 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 11:7" />Nda Jesǝwa andǝ amǝ'lwa male kat yiu aɓa yasǝlǝban, sǝ à eau amúrià nǝ munǝo, a myalmúr Merom. <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />Sǝ Yahweh turia a ɓabu Isǝrayila. À gandǝia sǝ à pǝrtea kya bwal ban Sidon Mǝgule, andǝ Misrefot-Mayim, andǝ Ɓangŋaban mala Mizpa a njar-takuli. À camarǝ walia gandǝa kǝɓwa ue atea mǝnana au ka ɗàng. <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />Jesǝwa pàkkia wia kǝla mǝnana Yahweh tsǝki wi nzongcau ama ɓǝ̀ pàk ka: kasǝki amazo kusǝ apǝr malea sǝ pisǝ awaru-pǝr malea nǝ bǝsa.<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />Pǝlǝa Jesǝwa wuli nǝnzǝmi a bàkú mǝno, sǝ kya lî Hazo, sǝ wal murǝm malea nǝ kún nggeabyau; Hazo ɗiɗyal ka nda là-murǝm mala amǝno yì anzali-murǝm ngga. <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />À twalta koya ɓwa mǝnana aɓalǝi ka nǝ kún nggeabyau, à kiɗikia kat-kat; kǝɓwa pà kàm nǝyilǝmu mǝnana à nyì ka ɗàng. Sǝ pisǝ Hazo nǝ bǝsa. <verse eid="JOS 11:11" /><verse number="12" style="v" sid="JOS 11:12" />Jesǝwa lì anggea-là kat mala amurǝma mǝno, andǝ amurǝma malea kat, sǝ twaltea nǝ kún nggeabyau, kiɗikia kat-kat, kǝla mǝnana Musa guro<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="DEU 20:16-17">Nggur 20:16-17</ref></char>. </note> mala Yahweh akdǝmba tsǝki wi nzongcau ka. <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />Sǝama Isǝrayila pisǝ ɓekǝ nggea-là mǝnana amúr mgbangban ngga ɗàng, shekǝ Hazo nǝmurǝi nda mǝnana Jesǝwa pisǝi ka. <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />Akume-lwa mala anggea-là mǝnia kat, andǝ agirkusǝu ka, amǝ Isǝrayila gbǝwia kǝla gǝna-lwa. Sǝ aɓwapǝndǝa ka à twaltea puppup nǝ kún nggeabyau, à nying kǝɓwa mǝnana kǝ lin'ueo ka, ɓǝ̀ au ɗàng. <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />Kǝla mǝnana Yahweh banggi Musa guro male ka, nda Musa banggi Jesǝwa anggo ka, sǝ Jesǝwa pǎ kǝla mǝno. Nying ɓekǝ gìr mǝnana Yahweh akdǝmba tsǝki Musa nzongcau ama ɓǝ̀ peǎ ka ɗàng.<verse eid="JOS 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />Anggo sǝ Jesǝwa lì mǝno yì nzali ka puppup, yì nzali múr-ankono andǝ Negev kat, andǝ nzali Goshen kat, andǝ nzali kusǝ-ankono, andǝ Araba, andǝ nzali múr-ankono mala Isǝrayila andǝ dulum male, <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />tite a Nkono Halak sǝ lo aban ká a Seyir, kya pur a Ba'al-Gat aɓa Ɓangŋaban mala ankono Lebano a kusǝ Nkono Hamon. Gandǝ amurǝma malea kat, bwalkia sǝ wal-luia. <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />Jesǝwa lwa-lwa arǝ amurǝma mǝno kat aɓalǝ anonggio pas. <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />Ɓekǝ nggea-là pà kàm mǝnana alta do-rǝpwala nǝ Isǝrayila ka ɗàng, she amǝ'Hivi mǝnana à ndanǝdo a Gibiyon ngga. Acilia kat ka à liǎ a lwa. <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />Yahweh nda mǝnana tsǝia sǝ à tǝr bumia ama she à nǝ̀ yiu arǝ amǝ Isǝrayila nǝ munǝo, ace mǝnana ɓǝà tària ace kiɗikiban, sǝ ɓǝà kǝa kum sǝn-mǝsǝswatǝr raka; a kún mani ka ɓǝà kiɗikia kǝla mǝnana Yahweh tsǝkî Musa nzongcau ka.<verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />A bàkú mǝno ka Jesǝwa warinǝ munǝo arǝ amǝkà Anak mǝnana à ndanǝdo a nzali múr-ankono ka, sǝ twaltea: a Hebǝron, andǝ Debir, andǝ Anap, andǝ abân mǝnana kat à ndakam aɓa nzali múr-ankono mala Yahuda andǝ nzali múr-ankono mala Isǝrayila ka. Jesǝwa kiɗikia kat-kat andǝ anggea-là malea. <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />Ɓekǝ ɓwa Anak ue kàm aɓa nzali mala amǝ Isǝrayila ɗàng. Shekǝ ɓá Gaza, andǝ ɓá Gat, andǝ ɓá Ashdot nda mǝnana aɓea ue kam ngga. <verse eid="JOS 11:22" /><verse number="23" style="v" sid="JOS 11:23" />Anggo sǝ Jesǝwa ak nzalinì puppup, kǝla mǝnana Yahweh akdǝmba banggi Musa ka. Sǝ Jesǝwa pè amǝ Isǝrayila ɓǝ̀ duk nzali liɓala malea, sǝ gakkì, koya tàu ka kum kāmbe male.</para>
  <para style="p" vid="JOS 11:23">Nda amǝ Isǝrayila usǝlǝì lwa ka.<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s">Amurǝma mǝnana amǝ Isǝrayila lia a munǝo ka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />Amǝnia ka à nda ka amurǝma mala nzali a takuli mala Jodan, mǝnana amǝ Isǝrayila lia a lwa sǝ à ak nzali malea arǝia, tite a Ɓangŋaban mala Arnon sǝ sarǝa aban ká a Nkono Hamon, andǝ Araba kat nǝ njar-takuli ka: <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />Sihon murǝm mala amǝ'Amor mǝnana do a Heshbon sǝ domurǝm male twal a Aruwa mǝnana nda a nzong Ɓangŋaban Arnon, sǝ twal a tsùrú mala ɓangŋabanì aban ká Nggeasala Jabok, yì nzong-nzali mala amǝ'Amon; mǝnana nda gauwa-tsùrú mala Gilǝyat ka; <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />andǝ Araba aban ká Nggeamùr Chineret, nǝ takuli, sǝ aban ká Nggeamùr mala Araba, yì Nggeamùr Tuɓamur, nǝ njar-takuli, njar ká a Bet-Jeshimot; sǝ nǝ njar-kunmur aban ká ɓunnoban a kusǝ Nkono Pisga; <verse eid="JOS 12:3" /><verse number="4" style="v" sid="JOS 12:4" />andǝ Og, murǝm Bashan, mǝnana nda mwashat aɓalǝ acili amǝ'Refa mǝnana à do a Ashtarot andǝ Edǝri, <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />sǝ duk-murǝm a bù-nzali mǝnana lo a Nkono Hamon aban ká a Saleka, sǝ a Bashan kat aban ká a nzong-nzali mala amǝ'Geshur andǝ mala amǝ'Ma'aka ka, andǝ gauwa-tsùrú mala Gilǝyat, yì nzong-nzali mala Sihon murǝm mala Heshbon. <verse eid="JOS 12:5" /><verse number="6" style="v" sid="JOS 12:6" />Musa, guro mala Yahweh, andǝ amǝ Isǝrayila gandǝia. Sǝ Musa, guro mala Yahweh pè amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa ɓǝ̀ duk girkuma malea.<verse eid="JOS 12:6" /></para>
  <para style="s">Amurǝma mǝnana Jesǝwa gandǝia ka</para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />Amǝnia ka à nda ka amurǝma mala nzali mǝnana Jesǝwa andǝ amǝ Isǝrayila gandǝia a nkaring Jodan, nǝ njar-nzali, twal a Ba'al-Gad aɓa ɓangŋaban Lebano aban ká Nkono Halak, a njar-kúnmur mǝnana tù aban Seyir ka. Jesǝwa pè atau mala amǝ Isǝrayila nzali mǝnia ka ɓǝ̀ duk girkuma malea arǝ anggǝsan malea, <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />aɓa nzali múr-ankono, aɓa dulum, aɓa Araba, aɓa ɓunnoban, aɓa pǝɗanban, sǝ aɓa Negev. Nzali mǝnia ɗiɗyal ka nda nzali-do mala amǝ'Hitti, andǝ amǝ'Amor, andǝ amǝ'Kan'ana, andǝ amǝ'Periz, andǝ amǝ'Hivi, sǝ amǝ'Jebus:<verse eid="JOS 12:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="JOS 12:9" />murǝm mala Jeriko, mwashat; murǝm mala Ai, mǝnana a nkanggari Betel ka, mwashat;<verse eid="JOS 12:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="JOS 12:10" />murǝm mala Urǝshalima, mwashat; murǝm mala Hebǝron, mwashat;<verse eid="JOS 12:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="JOS 12:11" />murǝm mala Jarmut mwashat; murǝm mala Lakish, mwashat;<verse eid="JOS 12:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="JOS 12:12" />murǝm mala Egǝlon, mwashat; murǝm mala Geza, mwashat;<verse eid="JOS 12:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="JOS 12:13" />murǝm mala Debir, mwashat; murǝm mala Geda mwashat;<verse eid="JOS 12:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="JOS 12:14" />murǝm mala Horma, mwashat; murǝm mala Arat, mwashat;<verse eid="JOS 12:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="JOS 12:15" />murǝm mala Libna, mwashat; murǝm mala Adulam, mwashat;<verse eid="JOS 12:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="JOS 12:16" />murǝm mala Makkeda, mwashat; murǝm mala Betel, mwashat;<verse eid="JOS 12:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="JOS 12:17" />murǝm mala Tapuwa, mwashat; murǝm mala Hefa, mwashat;<verse eid="JOS 12:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="JOS 12:18" />murǝm mala Afek, mwashat; murǝm mala Lasharon, mwashat;<verse eid="JOS 12:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="JOS 12:19" />murǝm mala Madon, mwashat; murǝm mala Hazo, mwashat;<verse eid="JOS 12:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="JOS 12:20" />murǝm mala Shimron-Meron, mwashat; murǝm mala Akshaf, mwashat;<verse eid="JOS 12:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="JOS 12:21" />murǝm mala Ta'anak, mwashat; murǝm mala Megido, mwashat;<verse eid="JOS 12:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="JOS 12:22" />murǝm mala Kadesh, mwashat; murǝm mala Jokneyam a Kamel, mwashat;<verse eid="JOS 12:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="JOS 12:23" />murǝm mala Dor a mgbangban mala Dor, mwashat; murǝm mala Goyim a Gilgal, mwashat;<verse eid="JOS 12:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="JOS 12:24" />sǝ murǝm mala Tǝrza, mwashat;</para>
  <para style="m" vid="JOS 12:24">Amurǝmanì kat ka, à nda lumi-tàrú-nong-mwashat.<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s">Nzali mǝnana ueo à malaká lì raka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />Lang Jesǝwa ena kutsuk sǝ apǝlǝa male lakkina ka,<note caller="+" style="f"><char style="fr" closed="false">13:1 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 14:10">Jes 14:10</ref>; <ref loc="JOS 23:1">23:1</ref></char>.</note> Yahweh banggi wi ama, &lt;&lt;A ena kutsuk sǝ apǝlǝa mò lakkina kǝ̀rkǝ́r sǝ cili nzali nakam kpǝm mǝnana ueo à malaká é raka. <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />Mǝnia ka nda nzali mǝnana ue ka:</para>
  <para style="mi" vid="JOS 13:2">Abu-nzali mala amǝ Filisti kat, andǝ abu-nzali mala amǝ'Geshur kat; <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />(lo a Nggeasala Shihor a njar-takuli mala Masar aban ká nzong-nzali mala Ekǝron a njar-nza ka, à kǝ̀ ɓalli atà anzali mala amǝ'Kan'ana, kat andǝ amani ama amurǝma tongno mala amǝ Filisti a Gaza, andǝ Ashdot, andǝ Ashkelon, andǝ Gat, sǝ Ekǝron na à yálmúrí ka); Bu-nzali mala amǝ'Avit <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />a njar-kunmur; nzali mala amǝ'Kan'ana kat twal a Meara mala amǝ Sidon aban ká Afek, aban ká nzong-nzali mala amǝ'Amor; <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />andǝ nzali mala amǝ Gebal;<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fq" closed="false">Gebal </char><char style="ft" closed="false">ko Bibǝlos</char></note> andǝ Lebano kat nǝ takuli, twal a Ba'al-Gad a kusǝ Nkono Hamon aban ká Lebo-Hamat.<verse eid="JOS 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="JOS 13:6" />Sǝ mala aɓwana mǝnana kat à ndanǝdo a nzali múr-ankono, twal a Lebano aban ká Misrefot-Mayim, yià amǝ Sidon kat ka, Mim nǝ ɓamúràm, Mǝ nǝ pǝria aɓadǝm amǝ Isǝrayila. Dumǝna púp awu nǝ gakki nzalinì amur amǝ Isǝrayila ɓǝ̀ duk nzali liɓala malea, kǝla mana Ən banggo ka. <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />Ado ka gapi atau tongno-nong-ine andǝ gauwa-tsùrú mala tàu mala Manasa nzali man, ɓǝ̀ duk nzali liɓala malea.&gt;&gt;<verse eid="JOS 13:7" /></para>
  <para style="s">Gau nzali liɓala a takuli mala Jodan</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8" />Cili gauwa-tsùrú mala amǝ'tàu mala Manasa, andǝ amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad ka,<note caller="+" style="f"><char style="fr" closed="false">13:8 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 12:6">Jes 12:6</ref>; <ref loc="NUM 32:33">Ɓal 32:33</ref></char>.</note> à kumǝna nzali liɓala malea, mǝnana Musa pea wia a nkaring mala Nggeasala Jodan a takuli, kǝla mǝnana Musa guro mala Yahweh angŋa dǝmba pania wia ka.<verse eid="JOS 13:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="JOS 13:9" />Nzong-nzali malea tite a Aruwa (a kún Ɓangŋaban mala Arnon), andǝ nggea-là mana a tsùrú mala ɓangŋabanì ka, andǝ ɓawan-mgbangban mala Medeba puppup aban ká Dibon, <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />andǝ anggea-là kat mala Sihon murǝm mala amǝ'Amor, mǝnana yálmúr aɓwana a Heshbon, aban ká nzong-nzali mala amǝ'Amon;<verse eid="JOS 13:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="JOS 13:11" />kat andǝ Gilǝyat, yì bu-nzali mala amǝ'Geshur andǝ amǝ'Ma'aka, andǝ Nkono Hamon andǝ Bashan kat, aban ká Saleka, <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />mǝnana nda domurǝm kat mala Og a Bashan, yì mǝnana yálmúr aɓwana ɗiɗyal a Ashtarot andǝ Edǝri ka. (Yì Og ka, nda kǝ ɓwa Refa mǝnana ue ka.) Yià mǝno kat ka, Musa gandǝia a lwa sǝ ak nzali malea. <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />Sǝama amǝ Isǝrayila gandǝ pǝr amǝ'Geshur andǝ amǝ'Ma'aka ɗàng, acemani ka à lidǝmba nǝdo aɓalǝ amǝ Isǝrayila bà yalung.<verse eid="JOS 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14" />Kǝ tàu mala Lawi nǝmurǝì nda mǝnana Musa pea wia nzali liɓala raka;<note caller="+" style="f"><char style="fr" closed="false">13:14 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 14:3-4">Jes 14:3-4</ref>; <ref loc="NUM 18:20-32">Ɓal 18:20-32</ref></char>.</note> gìr'liɓala malea ka, à nda ka aɓoro mǝnana aɓwe yinǝia ace pàgir nǝ bǝsa aban Yahweh, Ɓakuli mala amǝ Isǝrayila ka, kǝla mǝnana Yahweh pàcau abania ka.<verse eid="JOS 13:14" /></para>
  <para style="s">Bu-nzali mana à pè amǝ'tàu mala Ruben ngga</para>
  <para style="m">
    <verse number="15" style="v" sid="JOS 13:15" />Mǝnia ka nda nzali liɓala mǝnana Musa pè amǝ'tàu mala Ruben arǝ anggurkwar malea ka:<verse eid="JOS 13:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="JOS 13:16" />Bù-nzali malea tite a Aruwa, a kún Ɓangŋaban Arnon, andǝ nggea-là mǝnana a tsùrú mala ɓangŋaban mǝno, andǝ ɓawan-mgbangban kat mala Medeba;<verse eid="JOS 13:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="JOS 13:17" />Heshbon, andǝ anggea-là male kat, mǝnana à kàrì aɓa ɓawan-mgbangban ngga;</para>
  <para style="li1" vid="JOS 13:17">Dibon, andǝ Bamot-Ba'al, andǝ Bet-Ba'al-Meyon, <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />andǝ Jahaz, andǝ Kedemot, andǝ Mefaat, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />andǝ Kiriyatem, andǝ Sipma, andǝ Zeret-Shahar amúr mgbangban mala ɓangŋabanì;<verse eid="JOS 13:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="JOS 13:20" />andǝ Bet-Piyor, andǝ bum-nkono Pisga andǝ Bet-Jeshimot;<verse eid="JOS 13:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="JOS 13:21" />alá mǝnana kat amur ɓawan-mgbangban, andǝ nzali-murǝm kat mala Sihon, murǝm mala amǝ'Amor, mǝnana yálmúr aɓwana a Heshbon, mǝnana Musa limurǝm amurí andǝ amúrû mala amǝ Midiyan, yià Evi, andǝ Rekem, andǝ Zur, andǝ Hur, sǝ Reba, amǝ'tamurǝm mana à camata Sihon, sǝ à ndanǝdo a nzali mǝno ka.<verse eid="JOS 13:21" /></para>
  <para style="mi">
    <verse number="22" style="v" sid="JOS 13:22" />Bil'am muna-ɓwabura mala Beyor mǝ'ɓángnǝ́-ɓángna gbal ka, nda aɓalǝ aɓwana mana amǝ Isǝrayila wal-luia a munǝo, nǝ kún nggeabyau ka.<verse eid="JOS 13:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="JOS 13:23" />Nzong-nzali mala amǝ'tàu mala Ruben ngga, nda kún Nggeasala Jodan. Mǝno ka nda nzali liɓala mala amǝ'tàu mala Ruben arǝ anggurkwar malea, nǝ anggea-là andǝ amuna-là malea.<verse eid="JOS 13:23" /></para>
  <para style="s">Bu-nzali mana à pè amǝ'tàu mala Gad ka</para>
  <para style="m">
    <verse number="24" style="v" sid="JOS 13:24" />Mǝnia ka nda nzali liɓala mǝnana Musa pè amǝ'tàu mala Gad arǝ anggurkwar malea ka.<verse eid="JOS 13:24" /></para>
  <para style="mi">
    <verse number="25" style="v" sid="JOS 13:25" />Nzong-nzali malea ka nda Jaza, andǝ anggea-là mala Gilǝyat kat, andǝ gauwa-tsùrú mala nzali Amon, aban ká Aruwa, mǝnana nda a takuli mala Rabba ka; <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />sǝ twal a Heshbon aban ká Ramat-Mizpe andǝ Betonim, sǝ lo a Mahanayim aban ká bu-nzali Debir; <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />sǝ aɓa ɓangŋaban ngga Bet-Haram, andǝ Bet-Nimra, andǝ Sukkot andǝ Zafon, yì cili nzali-murǝm mala Sihon, murǝm mala Heshbon, bù-nzali mǝnana a takuli mala Nggeasala Jodan, aban ká masǝlǝata kún Nggeamùr Chineret.<note caller="+" style="f"><char style="fr" closed="false">13:27 </char><char style="fq" closed="false">Nggeamùr Chineret </char><char style="ft" closed="false">ko Nggeamùr Galili.</char></note> <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />Mǝno ka nda nzali liɓala mala amǝ'tàu mala Gad arǝ anggurkwar malea, nǝ anggea-là andǝ amuna-là malea.<verse eid="JOS 13:28" /></para>
  <para style="s">Bù-nzali mana à pè tàu mala Manasa ka</para>
  <para style="m">
    <verse number="29" style="v" sid="JOS 13:29" />Mǝnia ka nda nzali liɓala mǝnana Musa pè gauwa-tsùrú mala amǝ'tàu mala Manasa arǝ anggurkwar malea ka.<verse eid="JOS 13:29" /></para>
  <para style="mi">
    <verse number="30" style="v" sid="JOS 13:30" />Bù-nzali malea tite a Mahanayim, sǝ kpapi andǝ Bashan, nzali-murǝm puppup mala Og, murǝm mala Bashan, andǝ anggea-là lumi-tongno-nong-mwashat kat mala Jayir mǝnana à nda a Bashan ngga; <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />andǝ gauwa-tsùrú mala nzali Gilǝyat, andǝ Ashtarot, andǝ Edǝri, yì anggea-là mala nzali-murǝm mala Og a Bashan. Abân mǝnia ka à nda mǝnana à kasǝî aɓwana mala Makir, muna-ɓwabura mala Manasa, ace gauwa-tsùrú mala amuna mala Makir arǝ anggurkwar malea ka.<verse eid="JOS 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />Amǝno ka à nda ka nzali liɓala mǝnana Musa gakia a ɓawanban mala nzali Mowap, a nkaring Nggeasala Jodan nǝ njar-takuli ka. <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />Sǝama tàu mala Lawi ka, Musa pea wia kǝ nzali liɓala ɗàng; Yahweh Ɓakuli mala amǝ Isǝrayila ka, nda gìr'liɓala malea, kǝla mǝnana Yahweh banggia wia ka.<verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s">À gau nzali mǝnana a njar-nzali mala Jodan ngga</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />Amǝnia ka à nda ka anzali liɓala mana amǝ Isǝrayila â, a nzali Kan'ana, mǝnana Eleaza pǝris andǝ Jesǝwa muna-ɓwabura mala Nun, andǝ aɓwana-mǝgule amur aɓala-kàu mala atau mala amǝ Isǝrayila gakia wia ɓǝ̀ duk girkuma malea ka. <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />Gau nzalinì amur atau tongno-nong-ine nǝ gauwa-tsùrú ka, à pè nǝ bwal-shishar, kǝla mǝnana Yahweh tsǝkî Musa nzongcau ka. <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />Musa ka angŋa dǝmba panì atau ɓari nǝ gauwa-tsùrú, nzali liɓala malea a takuli mala Jodan, sǝ amǝ'Lawi ka pea wia kǝ nzali liɓala atà amǝ Isǝrayila ɗàng. <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />Amǝkà Yisǝfu ka atau ɓari na, Manasa andǝ Ifǝrem, sǝ à pè amǝ'Lawi kǝ kāmbe mala nzali liɓala aɓa nzalinì ɗàng. A kún mani ka, à pea wia anggea-là mǝnana à nǝ̀ duk kam ngga, andǝ anzali ace yál agirkusǝu malea, sǝ ace agirkuma malea. <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />Amǝ Isǝrayila à gaki nzalinì, à kpata nzongcau mǝnana Yahweh tsǝki Musa ka.<verse eid="JOS 14:5" /></para>
  <para style="s">Nzali mǝnana à pè Kalip ka</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />Pǝlǝa amǝ'tàu mala Yahuda yiu aban Jesǝwa a Gilgal. Sǝ Kalip muna-ɓwabura mala Jefune ɓwa-Keniz ne wi ama, &lt;&lt;A súrǝ́nà rǝ cau mǝnana Yahweh banggi Musa, yì ɓwa mala Ɓakuli, a Kadesh-Baniya, amur sǝm sǝnǝ we ka. <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />Mǝ ndanǝ apǝlǝa lumi-ine lang Musa guro mala Yahweh túrǎm a Kadesh-Baniya ace shenzǝ nzalinì ka. Sǝ ǝn nyare ǝn banggi wi cau kǝla mǝnana nda a ɓabumam ngga. <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />Sǝama amǝ'eambam mǝnana sǝm wari sǝnǝia ka, à ɓungi ɓabum aɓwe; sǝ mim ngga ǝn kpata Yahweh Ɓakuli mem nǝ ɓabumam kat. <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />Acemani ka, Musa kángìr a mǝno yì pwari ka ama, &lt;Mbak-kàngkàng ban mǝnana kat a par kusǝo kam ngga, nǝ̀ duk gìr'liɓala mò wunǝ amunio tàtǝ́k, acemǝnana we ka a kpanata Yahweh Ɓakuli mô nǝ ɓabumo kat.&gt;<note caller="+" style="f"><char style="fr" closed="false">14:9 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 14:24">Ɓal 14:24</ref>; <ref loc="DEU 1:36">Nggur 1:36</ref></char>.</note> <verse eid="JOS 14:9" /><verse number="10" style="v" sid="JOS 14:10" />Sǝni, ado ka, Yahweh nyìngŋǝ̀nam nǝyilǝmu, kǝla mana pàcau ka, aɓalǝ apǝlǝa lumi-ine bwamdǝ-tongno mǝnia à kùtí ka; Yahweh pàcau mǝnia ka aban Musa a bàkú mǝnana Isǝrayila na aban gya a ɓabondo ka. Sǝ ado ka, sǝni, mǝ ndanǝ apǝlǝa lumi-tongno-nong-tàrú nǝ mǝsǝi tongno yalung. <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />Mǝ ndanǝ rǝcandǝa piu yalung kǝla mǝnana mǝ ndanǝi a pwari mǝno Musa túrǎm nǝi ka; rǝcandǝa mem ɗiɗyal ka, nda rǝcandǝa mem ado, ace lwa sǝ ace ká andǝ nyare. <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />Ado ka, pam mǝnia yì nzali múr-nkono mǝnana Yahweh bangcau male a pwari mǝno ka. We nǝ nggearǝo ka, a ongŋǝna a pwari mǝno ka ama, amǝ'Anak nakam, sǝ anggea-là malea ka à gulkio sǝ à kària nǝ akanggǝrang sheran. Earka Yahweh nǝ̀ pà atam, sǝ mǝ nǝ pǝria kǝla mǝnana Yahweh bang ngga.&gt;&gt;<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />Pǝlǝa Jesǝwa tsǝki Kalip muna-ɓwabura mala Jefune bù, sǝ pe wi Hebǝron ɓǝ̀ duk gìr'liɓala male. <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />Acemani ka, Hebǝron duk gìr'liɓala mala Kalip muna-ɓwabura mala Jefune ɓwa-Keniz bà pwari man acemǝnana kpata Yahweh, Ɓakuli mala amǝ Isǝrayila nǝ ɓabumi kat ka. <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />Ɗiɗyal ka lullǝ Hebǝron nda Kiriyat-Arba;<note caller="+" style="f"><char style="fr" closed="false">14:15 </char><char style="fq" closed="false">Kiriyat-Arba </char><char style="ft" closed="false">ka ɓālǝi nda &lt;&lt;nggea-là mala Arba.&gt;&gt;</char></note> (acemana Arba ka, nda ɓwa mǝnana kàr amǝ'Anak kat ka.) Nda sǝ nzalinì usǝlǝi lwa ka.<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s">Nzali liɓala mǝnana à kasǝî tàu mala Yahuda ka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />Nzali mǝnana à kasǝî tàu mala Yahuda arǝ anggurkwar malea ka, kya bik nzong-nzali mala amǝ'Edom, sǝ sarǝa aban ká a pǝɗanban Zin aɓa Negev ɗār nǝ njar-kunmur. <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />Nzong-nzali malea a njar-kunmur ka, tite a masǝlǝata kúnban mala Nggeamùr Tuɓamur a lumgumban mǝnana sǝn njar-kunmur ka, <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />sǝ sarǝa wari a njar-kunmur mala Eauwe Akǝrabim, sǝ sarǝa aban ká Zin. Kya eau nǝ njar-kunmur a Kadesh-Baniya, sǝ lidǝmba aban ká Hezǝron. Sǝ eau aban ká a Addar, sǝ san aban ká nǝ buì mala Karka. <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />Kútí aban ká Azǝmon sǝ sarǝa wari arǝ myalmúr nzong-nzali Masar, sǝ kya masǝlǝa a nggeamùr. Mǝno ka nda nzong-nzali malea nǝ njar-kunmur.<verse eid="JOS 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5" />Nzong-nzali malea nǝ njar-takuli ka, nda Nggeamùr Tuɓamur aban ká a máɗi Nggeasala Jodan.</para>
  <para style="p" vid="JOS 15:5">Nzong-nzali malea nǝ njar-nza ka, tite a lumgumban mala Nggeamùr Tuɓamur a ban máɗi Nggeasala Jodan, <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />eau aban ká a Bet-Hogǝla, sǝ sarǝa aban ká nǝ njar-nza mala Bet-Araba, sǝ kútí aban ká a ban Tali mala Bohan, muna-ɓwabura mala Ruben. <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />Nzong-nzalinì lo a Ɓangŋaban mala Akor, eau a Debir, sǝ pǝlǝ nǝ njar-nza aban ká Gilgal (mǝnana à sǝn ɓamǝsǝarǝia andǝ Eauwe Adumim nǝ bú njar-kunmur mala myalmúr ka). Pǝlǝa yì nzong-nzali ka kútí aban ká a ban amáɗi-mùr mala En-Shemesh, sǝ sarǝa aban ká En-Rogel. <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />Pǝlǝa nzong-nzalinì eau nǝɓa Ɓangŋaban mala Ben Hinom aban ká ɓùnnó mala amǝ'Jebus (mǝnana nda Urǝshalima ka) nǝ njar-kunmur, pǝlǝa eau aban ká ɓong mgbangban mǝnana sǝn ɓamǝsǝarǝia andǝ Ɓangŋaban mala Ben Hinom nǝ njar-nzali, mǝnana nda a masǝlǝata Ɓangŋaban mala amǝ'Refa nǝ njar-nza ka. <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />Pǝlǝa nzong-nzali mǝnia twal a ɓong mgbangbanì, sǝ dǝshi ban amgbeaɗe mùr mala Neftowa, sǝ lo a ban mǝno ka, kya pur a ban anggea-là mala Nkono Efǝron. Pǝlǝa sarǝa sǝ kya pǝlǝa aban ká a Ba'ala (mǝnana gbal à tunǝi ama Kiriat-Jarim ngga). <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />Pǝlǝa nzong-nzalinì kàr nǝ njar-nzali a Ba'ala aban ká a Nkono Seyir. Kya kàrá a buì mala njar-nza aban ká a ɓùnnó mala Nkono Jeyarim (mǝnana à tunǝi ama Chesalon ngga) a njar-nza, sǝ sulǝo aban ká Bet-Shemesh. Pǝlǝa kútí nǝ Timna. <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />Nzong-nzali mǝnia pǝlǝa sarǝa aban ká ɓùnnó mala Ekǝron nǝ njar-nza, sǝ dǝshi Shikǝron. Pǝlǝa san aban ká a Nkono Ba'ala, sǝ sarǝa aban ká a Jabneel. Kya masǝlǝa a Nggeamùr Mediterani.<verse eid="JOS 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 15:12" />Nzong-nzali malea a njar-nzali ka nda Nggeamùr Mediterani. Amǝno ka, à nda ka nzong-nzali mǝnana à kàrì tàu mala Yahuda arǝ anggurkwar malea ka.<verse eid="JOS 15:12" /></para>
  <para style="s">Nzali mǝnana à pè Kalip ka</para>
  <para style="r">(<ref loc="JDG 1:12-15">Akas 1:12-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />Kǝla mǝnana Yahweh tsǝkî Jesǝwa nzongcau ka, Jesǝwa pè Kalip, muna-ɓwabura mala Jefune kāmbe nzali atà aɓwana mala Yahuda. Pè wi Kiriyat-Arba, mǝnana à tunǝì ama Hebǝron ngga. (Arba ka nda tár Anak). <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />Sǝ Kalip pǝr atau tàrú mala amǝ'Anak: Sheshai, andǝ Ahiman, andǝ Talmai, amǝkà Anak.<note caller="+" style="f"><char style="fr" closed="false">15:14 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="NUM 13:22">Ɓal 13:22</ref>,<ref loc="NUM 13:28">28</ref>,<ref loc="NUM 13:33">33</ref>; <ref loc="DEU 9:2">Nggur 9:2</ref>; <ref loc="JOS 21:11">Jes 21:11</ref></char>.</note> <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />Pǝlǝa lo kano sǝ warinǝ munǝo arǝ aɓwana mǝnana nǝdo a Debir ka. Lullǝ Debir ɗiɗyal ka nda Kiriat-Sefer. <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />Pǝlǝa Kalip bang ama, &lt;&lt;Ɓwa mǝnana kat lì Kiriat-Sefer nǝ lwa ka, mǝ nǝ pè wi ɓoarnsarilem Aksa ɓǝ̀ duk māmí.&gt;&gt; <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />Nda Otǝniyel,<note caller="+" style="f"><char style="fr" closed="false">15:17 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt"><ref loc="JDG 3:8-11">Akas 3:8-11</ref></char>.</note> muna-ɓwabura mala Kenaz, mǝ'kyauwa Kalip lì, sǝ Kalip pè wi ɓoarnsarile Aksa duk māmí ka.<verse eid="JOS 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 15:18" />Lang Aksa yina ka, nacau nǝ Otǝniyel ace mǝnana ɓǝ̀ zǝmbi wi tárrí Kalip ɓǝ̀ pè wi nzali a liro. Pǝlǝa Aksa sulǝî nzǝm mǝdambǝriso male, sǝ Kalip ɗì ama, &lt;&lt;Mana a earkice?&gt;&gt; <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />Pǝlǝa eari wi ama, &lt;&lt;Ida, ɓwamuram. Nzali mǝnana a pam ngga nda a Negev,<note caller="+" style="f"><char style="fr" closed="false">15:19 </char><char style="fq" closed="false">Negev </char><char style="ft" closed="false">ka bu-nzali na a njar-kunmur, ban mǝnana mbulo kǝ nya kam bǝti ka.</char></note> ado ka pam ban mǝnana ndanǝ amgbeaɗe mùr ka gbal.&gt;&gt; Nda Kalip pè wi amgbeaɗe mùr mana a mgbang-ban andǝ amgbeaɗe mùr mana a tūliban ngga.<verse eid="JOS 15:19" /></para>
  <para style="s">Anggea-là mala Yahuda</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />Mǝnia ka nda nzali liɓala mǝnana à kasǝî aɓwana mala tàu mala Yahuda arǝ anggurkwar malea ka. <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />Anggea-là mǝnana amala aɓwana mala Yahuda na a masǝlǝata kún ban, a njar-kunmur aban ká a nzong-nzali mala amǝ'Edom ngga à nda ka:</para>
  <para style="li2" vid="JOS 15:21">Kabzeel, andǝ Eda, andǝ Jagur, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />andǝ Kina, andǝ Dimona, andǝ Adada, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />andǝ Kedesh, andǝ Hazo, andǝ Itǝnan, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />andǝ Zif, andǝ Telem, andǝ Beyalot, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />andǝ Hazo-Hadata, andǝ Keriyot-Hezǝron (mǝnana nda Hazo ka), <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />andǝ Amam, andǝ Shema, andǝ Molada, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />andǝ Haza-Gada, andǝ Heshmon, andǝ Bet-Pelet, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />andǝ Haza-Shual, andǝ Biyasheba, andǝ Biziyotiya, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />andǝ Ba'ala, andǝ Iyim, andǝ Ezem, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />andǝ Eltolat, andǝ Chesil, andǝ Horma, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />andǝ Zikǝlag, andǝ Madǝmana, andǝ Sansana, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />andǝ Lebaot, andǝ Shilhim, andǝ Ayin, sǝ Rimon: yià kat ka anggea-là lumi-ɓari-bwamdǝ-tongno-nong-ine na andǝ amuna-là malea.<verse eid="JOS 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33" />Anggea-là mǝnana à nda a kusǝ ankono ka à nda ka:</para>
  <para style="li2" vid="JOS 15:33">Eshtawol, andǝ Zora, andǝ Ashna, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />andǝ Zanoha, andǝ En-Ganim, andǝ Tapuwa, andǝ Enam, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />andǝ Jarmut, andǝ Adulam, andǝ Soko, andǝ Azeka, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />andǝ Sharayim, andǝ Aditayim, andǝ Gedera, andǝ Gederotayim: anggea-là lum-nong-ine andǝ amuna-là malea.<verse eid="JOS 15:36" /></para>
  <para style="li2">
    <verse number="37" style="v" sid="JOS 15:37" />Sǝ Zenan, andǝ Hadasha, andǝ Migǝdal-Gad, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />andǝ Dileyan, andǝ Mizǝpe, andǝ Jokteel, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />andǝ Lakish, andǝ Bozǝkat, andǝ Egǝlon, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />andǝ Kabon, andǝ Lamam, andǝ Chitǝlish, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />andǝ Gederot, andǝ Bet-Dagon, andǝ Naama sǝ Makkeda: anggea-là lum-bwamdǝ-tongno-nong-mwashat andǝ amuna-là malea.<verse eid="JOS 15:41" /></para>
  <para style="li2">
    <verse number="42" style="v" sid="JOS 15:42" />Sǝ Libǝna, andǝ Eta, andǝ Ashan, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />andǝ Ifta, andǝ Ashna, andǝ Nezip, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />andǝ Keyila, andǝ Akzip, sǝ Maresha: anggea-là tongno-nong-ine andǝ amuna-là malea.<verse eid="JOS 15:44" /></para>
  <para style="li2">
    <verse number="45" style="v" sid="JOS 15:45" />Sǝ Ekǝron andǝ alá andǝ amuna-là male; <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />sǝ twal a Ekǝron aban ká nggeamùr, yì alá mǝnana a nkanggari Ashdot ka, andǝ amuna-là malea.<verse eid="JOS 15:46" /></para>
  <para style="li2">
    <verse number="47" style="v" sid="JOS 15:47" />Sǝ Ashdot, andǝ alá andǝ amuna-là male; sǝ Gaza, andǝ alá andǝ amuna-là male kya uk ɗār pur a myalmúr nzong-nzali Masar, andǝ abân arǝ gwanyi mala Nggeamùr Mediterani.<verse eid="JOS 15:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48" />Anggea-là mǝnana à nda amúr ankono ka, à nda ka:</para>
  <para style="li2" vid="JOS 15:48">Shamir, andǝ Jattir, andǝ Soko, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />andǝ Danna, andǝ Kiriat-Sanna (mǝnana nda Debir ka), <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />andǝ Anap, andǝ Eshtemo, andǝ Anim, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />andǝ Goshen, andǝ Holon, sǝ Gilo: anggea-là lum-nong-mwashat andǝ amuna-là malea.<verse eid="JOS 15:51" /></para>
  <para style="li2">
    <verse number="52" style="v" sid="JOS 15:52" />Sǝ Arap, andǝ Duma, andǝ Eshan, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />andǝ Janim, andǝ Bet-Tapuwa, andǝ Afeka, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />andǝ Humta, andǝ Kiriyat-Arba (mǝnana nda Hebǝron ngga), sǝ Ziyor: anggea-là tongno-nong-ine andǝ amuna-là malea.<verse eid="JOS 15:54" /></para>
  <para style="li2">
    <verse number="55" style="v" sid="JOS 15:55" />Sǝ Mawon, andǝ Kamel, andǝ Zif, andǝ Jutta, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />andǝ Jezǝril, andǝ Jokdeyam, andǝ Zanoha, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />andǝ Kayin, andǝ Gibiya, sǝ Timna: anggea-là lum andǝ amuna-là malea.<verse eid="JOS 15:57" /></para>
  <para style="li2">
    <verse number="58" style="v" sid="JOS 15:58" />Sǝ Halhul, andǝ Bet-Zur, andǝ Gedor, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />andǝ Maarat, andǝ Bet-Anot, sǝ Eltekon: anggea-là tongno-nong-mwashat andǝ amuna-là malea.<verse eid="JOS 15:59" /></para>
  <para style="li2">
    <verse number="60" style="v" sid="JOS 15:60" />Sǝ Kiriat-Baal (mǝnana nda Kiriat-Jarim ngga), andǝ Rabba: anggea-là ɓari andǝ amuna-là malea.<verse eid="JOS 15:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61" />Anggea-là mǝnana à nda aɓa pǝɗanban ngga à nda ka:</para>
  <para style="li2" vid="JOS 15:61">Bet-Araba, andǝ Middin, andǝ Sekaka, <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />andǝ Nipshan, andǝ Nggea-là Tuɓamur, sǝ Engedi: anggea-là tongno-nong-mwashat andǝ amuna-là malea.<verse eid="JOS 15:62" /></para>
  <para style="s">Amǝ'Jebus</para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />Sǝama amǝ'Jebus, yì aɓwana mǝnana à ndanǝdo a Urǝshalima ka,<note caller="+" style="f"><char style="fr" closed="false">15:63 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JDG 1:21">Akas 1:21</ref>; <ref loc="2SA 5:5-9">2Sam 5:5-9</ref></char>.</note> aɓwana mala Yahuda gandǝ pǝria ɗàng. Nda gìr mǝnana tsǝa sǝ amǝ'Jebus do atārǝia andǝ aɓwana mala Yahuda ba yalung ngga.<verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s">Nzali mana à kasǝî atau mala Ifǝrem andǝ Manasa ka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />Nzali mǝnana à kasǝî tàu mala Yisǝfu ka, tite a Nggeasala Jodan, nǝ takuli mala amgbeaɗe-mùr mala Jeriko, kya kútí nǝɓa pǝɗanban, sǝ kútí aɓa nzali múr-ankono aban ká Betel. <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />Lo a Betel kya bwal Luz, sǝ kutio bik nzong-nzali mala amǝ'Arkit a Atarot. <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />Pǝlǝa dìlì nǝ njar-nzali aban ká a nzong-nzali mala amǝ Jafǝlet, sǝ kutio wari a nzong ban Bet-Horon mǝnana a ɓangŋaban ngga, kya bwal Geza, sǝ kya masǝlǝa a kún nggeamùr.<verse eid="JOS 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 16:4" />Amǝkà Yisǝfu, yì atau mala Manasa andǝ Ifǝrem kum nzali man yi duk nzali liɓala malea.<verse eid="JOS 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />Mǝnia ka nda bu-nzali mǝnana à gapì tàu mala Ifǝrem arǝ anggurkwar malea ka: Nzong mala nzali liɓala malea nǝ njar-takuli ka, lo a Atarot-Addar aban ká Bet-Horon mǝnana a mgbangban ngga, <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />sǝ sarǝa umnǝ nggeamùr. Lo a Mikmetat a njar-nza, pǝlǝ nǝ takuli aban ká a Ta'anak-Shilo, pǝlǝa kútí a dǝmba nǝi aban ká Januwa, nǝ takuli. <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />Lo a Januwa kya sulǝ aban ká Atarot andǝ Na'ara, kya je Jeriko, sǝ yi masǝlǝa a kún Nggeasala Jodan. <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />Lo a Tapuwa ka, nzong-nzalinì kùtí nǝ njar-nzali aban ká a muna-mùr Kana, sǝ kya masǝlǝa a kún nggeamùr. Mǝnia ka nda nzali liɓala mǝnana à kasǝî tàu mala Ifǝrem arǝ anggurkwar malea ka, <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />kpapi andǝ anggea-là mǝnana à tària ace aɓwana mala Ifǝrem aɓa nzali liɓala mala amǝkà Manasa ka; anggea-là mǝno kat andǝ amuna-là malea. <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" />Sǝama yià ka à pǝr amǝ'Kan'ana mǝnana à ndanǝdo aɓa Geza ka ɗàng; acemani ka, amǝ'Kan'ana do aɓalǝ aɓwana mala Ifǝrem ba yalung, sǝama, à tsǝia púp ɓǝ̀ à kǝ pakkia wia atúró mǝkwane.<verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s">Nzali ace tàu mala Manasa mǝnana a njar-nzali ka</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />Mǝnia ka, nda nzali mǝnana à kasǝî tàu mala Manasa, muna-dǝmba mala Yisǝfu ka. Amǝkà Makir, mǝnana nda muna-dǝmba mala Manasa sǝ ɗǝm ngga nda tár Gilǝyat ka, à pea wia abu-nzali Gilǝyat andǝ Bashan a takuli mala Jodan, acemǝnana yià ka, akanggǝrang amǝ'lwa na. <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />Nzali mǝnana a njar-nzali mala Jodan ngga, à pè acili aɓwana mala Manasa arǝ anggurkwar malea; yì amǝ'kà Abiyeza, andǝ amǝ'kà Helek, andǝ amǝ'kà Asǝriyel, andǝ amǝ'kà Shekem, andǝ amǝ'kà Hefa, sǝ amǝ'kà Shemida. Yià mǝnia ka, à nda ka aburana amǝ'kà Manasa, muna-ɓwabura mala Yisǝfu, arǝ anggurkwar malea.<verse eid="JOS 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 17:3" />Zelofihat, muna-ɓwabura mala Hefa, muna-ɓwabura mala Gilǝyat, muna-ɓwabura mala Makir, muna-ɓwabura mala Manasa ka, kum muna-ɓwabura ɗàng; amuni ka amuna-mamǝna na, sǝ alullǝia ka, à nda ka Mala, andǝ Noha, andǝ Hogǝla, andǝ Milka, sǝ Tǝrza. <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />À wari aban Eleaza pǝris, andǝ Jesǝwa muna-ɓwabura mala Nun, andǝ aɓwana-mǝgule sǝ à bang ama, &lt;&lt;Yahweh banggi Musa ama ɓǝ̀ pà sǝm nzali liɓala atà amǝ'eam sǝm amuna-burana.&gt;&gt; Nda Jesǝwa pea wia nzali atà amǝ'eam tárrià, kǝla mana Yahweh bang ngga. <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />Acemani ka, tàu mala Manasa kum akāmbe lum mala nzali, tsǝa amúr abu-nzali Gilǝyat andǝ Bashan, mǝnana à nda a takuli mala Jodan ngga, <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />acemǝnana amuna-mamǝna mala tàu mala Manasa ka, à kum nzali liɓala atà amuna-burana male. Bù-nzali Gilǝyat ka, nda mǝnana à pè acili amǝ'kà Manasa ka.<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />Nzong-nzali mala tàu mala Manasa ka, twal a nzong-nzali mala Asha, kya bwal a Mikmetat, mǝnana nda a ɓadǝm Shekem ngga. Sǝ nzong-nzalinì ka, twal a njar-kunmur, aban ká aban aɓwana mǝnana à do a En-Tapuwa<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="fq" closed="false">En-Tapuwa </char><char style="ft" closed="false">ko ban mgbeaɗe-mùr mala Tapuwa.</char></note> ka. <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />(Nzali mǝnana kàrì Tapuwa ka, mala amǝkà Manasa na, sǝama là Tapuwa, mana nda a nzong-nzali mala Manasa ka, mala amǝkà Ifǝrem na.) <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />Pǝlǝa nzong-nzalinì sulǝ nǝ njar-kunmur wari a muna-mùr Kana. Anggea-là mǝnana a njar-kunmur mala muna-mùrnî ka, amala Ifǝrem na aɓalǝ anggea-là mala Manasa. Nzong-nzali mala Manasa ka, nong arǝ kún muna-mùrnî nǝ njar-nza, sǝ kya masǝlǝa a nggeamùr. <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />Bù-nzali mǝnana nǝ njar-kúnmur ka, mala tàu mala Ifǝrem na, sǝ mǝnana nǝ njar-nza ka, nda mala tàu mala Manasa. Nggeamùr ka, nda nzong mala bù-nzali Manasa nǝ njar-nzali, sǝ bù-nzali malea ka je mala Asha a njar-nza andǝ mala Isaka a takuli. <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />Aɓa bù-nzali Isaka andǝ mala Asha ɗǝm ngga, à pè tàu mala Manasa alá mǝnia ka: Bet-shan andǝ amuna-là male, Ibǝlem andǝ amuna-là male, andǝ aɓwana mana à do a Dor (mǝnana a mgbangban ngga),<note caller="+" style="f"><char style="fr" closed="false">17:11 </char><char style="fq" closed="false">(mǝnana a mgbangban ngga) </char><char style="ft" closed="false">ɓālǝi nǝ kún Ibǝru ka à bwalte ɗàng.</char></note> andǝ En-dor, andǝ Ta'anak, andǝ Megido, andǝ amuna-là malea mǝnana à kària ka.<verse eid="JOS 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 17:12" />Sǝama amǝkà Manasa gandǝ ak anggea-là mǝnia ka ɗàng, acemǝnana amǝ'Kan'ana shambumia ama à pà nǝ̀ nying do aɓa nzalinì ɗàng.<verse eid="JOS 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 17:13" />Lang amǝ Isǝrayila kumǝna rǝcandǝa kpǝm ngga, à tsǝk amǝ'Kan'ana púp aɓata atúró mǝcandǝe, sǝama à pǝria kat-kat, ama ɓǝà purî ɓá nzalinì ɗàng.<verse eid="JOS 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />Pǝlǝa amǝkà Yisǝfu banggi Jesǝwa ama, &lt;&lt;Palang sǝ a pa sǝm gauwe mwashat mala nzali, andǝ kāmbe mwashat ɓǝ̀ duk gìr'liɓala ace sǝm, kat andǝ amani ama sǝm nda nyangsang, acemǝnana yi pur ado ka, Yahweh tsǝ̀ngŋǝ́nà sǝm bù?&gt;&gt;<verse eid="JOS 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15" />Pǝlǝa Jesǝwa nea wia ama, &lt;&lt;Ɓǝ̀ wun ngga wu làkkì pas, sǝ nzali múr-ankono mala Ifǝrem kyapa wun ngga, wu kyan nǝ nggearǝ wun aɓa ndà-nggun, aɓa nzali mala amǝ'Periz, andǝ mala amǝ'Refa, wu kya wal-nggun ace kumbi ɓamurǝ wun ban.&gt;&gt;<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />Pǝlǝa amǝkà Yisǝfu pa eare ama, &lt;&lt;Nzali múr-ankono karǝ sǝm ɗàng, sǝ amǝ'Kan'ana, mana à ndanǝdo a dulum ngga, à ndanǝ awaru-pǝr mana à pea nǝ bolo-candǝa ka; yià andǝ amǝno à do a Bet-shan andǝ amuna-là male ka, andǝ amǝno à do a ɓangŋaban mala Jezǝril ka.&gt;&gt;<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />Pǝlǝa Jesǝwa banggi ɓala mala Yisǝfu, aɓwana mǝnana a tàu mala Ifǝrem andǝ tàu mala Manasa ka ama, &lt;&lt;Wun ngga, wu bundǝo, wu làkkì pas, sǝ wun ndanǝ rǝcandǝa kǝ̀rkǝ́r. Kāmbe nzali mwashat ɓǝ̀rɓǝ̀r na à nǝ̀ kasǝa wun ngga ɗàng. <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />Nzali múr-ankono puppup nǝ̀ duk ma'wun. Kat andǝ amani ama ndà-nggun na ka, wun nǝ̀ gandǝ wal nggun, sǝ abân mala anzong male mǝnana à tangŋa aban ká kuko ka, wun nǝ̀ ea ɓǝà duk girkuma ma'wun; acemǝnana wun nǝ̀ pǝr amǝ'Kan'ana, kat andǝ awaru-pǝr mala bolo-candǝa malea, kat andǝ amani ama à ndanǝ rǝcandǝa ka.&gt;&gt;<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s">Gau cili nzali a Shilo</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />Pǝlǝa ɓinala amǝ Isǝrayila puppup ramba a Shilo, sǝ à loasǝ Tara Ban Peri a banì. Kat andǝ amani ama à lina nzalinì, sǝ nda aɓata rǝcandǝa malea ka, <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />atau tongno-nong-ɓari mala amǝ Isǝrayila malaká kum nzali liɓala malea ɗàng. <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />Nda Jesǝwa banggi amǝ Isǝrayila ama, &lt;&lt;Nǝ̀ sau lang sǝ wun nǝ̀ dǝndi ká ak nzali mǝnana Yahweh, Ɓakuli mala aká wun pàna wunì ka? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />Wu twal aburana tàrú a koya tàu. Mǝ nǝ tasǝia ɓǝà kyane ɓǝà gya aɓa nzalinì kat. Bù-nzali mǝnana à nǝ̀ earce ɓǝ̀ duk nzali liɓala malea ka, ɓǝà kanikirǝì nǝ pusǝ nyoulǝa-nzong mala nzalinì; sǝ ɓǝà nyare ɓǝà yiu abanam. <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />À nǝ̀ gau nzalinì arǝ abân tongno-nong-ɓari; Tàu mala Yahuda ka, nǝ̀ lidǝmba nǝdo a bù-nzali malea a njar-kunmur, sǝ atau mala Yisǝfu ka, a bu-nzali malea a njar-nza. <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />Wu pusǝ nyoulǝa-nzong mala nzalinì mǝnana wun nǝ̀ gauwi arǝ abu-nzali tongno-nong-ɓari ka, sǝ wu yinǝi abanam. Mǝ nǝ tsǝk wun, wun nǝ̀ bwal-shishar akani aɓadǝm Yahweh Ɓakuli ma'wun. <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />Amǝ'Lawi ka, à pànǝ kǝ kāmbe mala nzali mǝnana à kasǝia wia atà wun ngga ɗàng, acemǝnana dobuno-pǝris mala Yahweh ka, nda liɓala malea. Sǝ atau mala Gad, andǝ Ruben, andǝ gauwa-tsùrú mala tàu mala Manasa ka, à angŋa dǝmba à kumǝna nzali liɓala malea, mǝnana Musa guro mala Yahweh kasǝnia wia a nkaring takuli mala Nggeasala Jodan ngga.&gt;&gt;<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />Nda aburana man lo sǝ à wario, anzǝm mana Jesǝwa pània wia mǝnia yì kwarkiru ka ama, &lt;&lt;Wu gya aɓa nzalinì, wu pelǝpa male, sǝ wu pusǝ nyoulǝa-nzong male. Sǝ wu nyare wu yiu abanam. Sǝ akani a Shilo, mǝ nǝ tsǝk wun, wun nǝ̀ bwal-shishar aɓadǝm Yahweh Ɓakuli ma'wun.&gt;&gt; <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />Nda aburana man wario sǝ à kya gya arǝ abân aɓa nzalinì, sǝ à kanikirǝì nǝ nyoulǝ nzong male aɓa mbu-malǝmce:<note caller="+" style="f"><char style="fr" closed="false">18:9 </char><char style="fq" closed="false">mbu-malǝmce </char><char style="ft" closed="false">ka nda nggú gilǝgir mana à kǝ kàrì ka.</char></note> yì abân mala alá mǝnana aɓalǝi, andǝ gakia mǝnana à gaki arǝ abu-nzali tongno-nong-ɓari ka. Pǝlǝa à nyar aban Jesǝwa aɓa kàttì a Shilo.<verse eid="JOS 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 18:10" />Jesǝwa pǝlǝa tsǝia à bwal-shishar aɓadǝm Yahweh a Shilo, sǝ gau nzalinì amur atau mala amǝ Isǝrayila mǝnana à ue ka, nǝ́ banggi koya tàu ka kāmbe nzali mǝnana nǝ̀ kum ngga.<verse eid="JOS 18:10" /></para>
  <para style="s">Nzali liɓala mala tàu mala Benjami</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />Bwal-shishar mǝdǝmbe ka, kpa amúr tàu mala Benjami andǝ aɓwana mǝnana a nggurkwar male ka. Bù-nzali malea mǝnana à kum ngga, nong a nre ka atau mala Yahuda andǝ Yisǝfu. <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />A njar-nza ka, nzong-nzali malea tite a kún Nggeasala Jodan, sǝ eau aban ká sulǝo mala mgbang-ban mala Jeriko. Pǝlǝa eauwe kútí nǝɓa nzali múr-ankono nǝ njar-nzali, sǝ kya pur a pǝɗanban mala Bet-Aven. <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />Twal a ban mǝno ka, nzong-nzalinì san nǝ njar Luz aban ká mgbang-ban mala Luz (mǝnana nda Betel ka). Pǝlǝa sulǝ aban ká Atarot-Addar, amúr nkono mǝnana nda a Bet-Horon nǝ njar-kunmur ka. <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />Pǝlǝa nzong-nzalinì kàr a bù njar-nzali mala nkono mǝnia mǝnana nda a Bet-Horon ngga, sǝ um nǝ njar-kunmur aban ká Kiriat-Baal (mǝnana nda Kiriat-Jarim ngga). Là mǝnia ka mala aɓwana mala Yahuda na. Mǝno ka nda nzong-nzalinì nǝ bú njar-nzali.<verse eid="JOS 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 18:15" />Nzong-nzali malea a bù njar-kunmur ka, tite a nzǝm lá Kiriat-Jarim, sǝ sarǝa um nǝ njar-nzali aban ká a ban amgbeaɗe mùr mala Neftowa. <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />Pǝlǝa nzong-nzalinì sulǝ aban ká a nkanggari nkono mǝnana sǝn ɓamǝsǝarǝia andǝ Ɓangŋaban mala Ben-Hinom, mǝnana nda a masǝlǝata Ɓangŋaban mala Amǝ'Refa nǝ njar-nza ka. Pǝlǝa lidǝmba sulǝ aban ká a Ɓangŋaban mala Hinom, nǝ njar-kunmur mala ɓunno mala amǝ'Jebus, sǝ dìlì wari a En-Rogel. <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />Pǝlǝa kàr nǝ bù njar-nza aban ká a En-Shemesh, sǝ lo kano ka, wari a Gelilot, mǝnana à sǝn ɓamǝsǝarǝia andǝ Eauwe Adumim ngga. Pǝlǝa dìlì wari aban Tali mala Bohan muna-ɓwabura mala Ruben. <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />Lidǝmba aban ká a ɓunno mala Bet-Araba nǝ njar-nza sǝ dìlì wari a Araba. <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />Pǝlǝa nzong-nzali mǝnia sana o a ɓunno mala Bet-Hogǝla nǝ njar-nza. Sǝ kya masǝlǝa a lumgumban mala Nggeamùr Tuɓamur nǝ njar-kúnmur, a máɗi mala Nggeasala Jodan. Mǝno ka nda nzong-nzalinì nǝ njar-kunmur. <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />Nggeasala Jodan ngga nda nzong male a bù njar-takuli. Amǝno ka à nda ka anzong mala nzali liɓala mǝnana à kasǝî aɓwana a tàu mala Benjami arǝ anggurkwar malea ka.<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />Anggea-là mǝnia ka, amala tàu mala Benjami arǝ anggurkwar male na: Jeriko, andǝ Bet-Hogǝla, andǝ Emek-Keziz, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />andǝ Bet-Araba, andǝ Zemarayim, andǝ Betel, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />andǝ Avim, andǝ Para, andǝ Ofǝra, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />andǝ Kefar-Amoni, andǝ Ofǝni, sǝ Geba; anggea-là lum-nong-ɓari andǝ amuna-là malea.<verse eid="JOS 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 18:25" />Sǝ Gibiyon, andǝ Rama, andǝ Beerot, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />andǝ Mizpa, andǝ Kefira, andǝ Moza, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />andǝ Rekem, andǝ Irpeel, andǝ Tarala, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />andǝ Zela, andǝ Haelef, nggea-là mala amǝ'Jebus (mǝnana nda Urǝshalima ka), andǝ Gibiya, sǝ Kiriyat; anggea-là lum-nong-ine andǝ amuna-là malea. Mǝno ka nda nzali liɓala mǝnana à kasǝî aɓwana mǝnana a tàu mala Benjami arǝ anggurkwar malea ka.<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s">Nzali liɓala mala tàu mala Shimiyon</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />Ɓaria bwal-shishar kpa amur tàu mala Shimiyon, amur amǝkau a tàu mala Shimiyon arǝ anggurkwar malea. Nzali liɓala malea nongŋo aɓa ɓalǝu mala nzali liɓala mala tàu mala Yahuda. <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />Alá malea ka à nda ka: Biyasheba (ko Sheba), andǝ Molada, <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />andǝ Haza-Shual, andǝ Bala, andǝ Ezem, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />andǝ Eltolat, andǝ Bethul, andǝ Horma, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />andǝ Zikǝlag, andǝ Bet-Markabot, andǝ Hazar-Susa, <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />andǝ Bet-Lebawot, sǝ Sharuhen; anggea-là lum-nong-tàrú andǝ amuna-là malea. <verse eid="JOS 19:6" /><verse number="7" style="v" sid="JOS 19:7" />Sǝ Ayin, andǝ Rimon, andǝ Eta, sǝ Ashan; anggea-là ine andǝ amuna-là malea, <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />andǝ alá mǝnana kat à kàrì anggea-là mǝnia ka kya pur a Baalat-Biya (ko Rama) a Negev. Mǝno ka nda nzali liɓala mǝnana à kasǝî aɓwana mǝnana a tàu mala Shimiyon arǝ anggurkwar malea ka. <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />Nzali liɓala mǝnana à kasǝî tàu mala Shimiyon ngga à twali aɓa mǝnana à pè tàu mala Yahuda ka, acemǝnana bù-nzali mala Yahuda ɓiki gulo acea; acemani ka, à kasǝî tàu mala Shimiyon nzali liɓala aɓa mala Yahuda.<verse eid="JOS 19:9" /></para>
  <para style="s">Nzali liɓala mala tàu mala Zebulu</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />Tàruia bwal-shishar ka nda mala tàu mala Zebulu arǝ anggurkwar malea. Bù-nzali malea ka o kya bwal Sarit. <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />Sǝ twal kano ka um nǝ njar-nzali kya bik Marala, sǝ je Dabeshet andǝ ɓangŋaban mǝnana a njar-takuli mala Jokneyam ngga. <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />Sǝ lo a Sarit ka, um nǝ njar-takuli, nǝ ban eauwe mala pwari a nzong-nzali mala Chislot-Tabo. Lo kano ka, o a Daberat, sǝ eau aban ká a Jafiya. <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />Lo kano ka, san nǝ njar-takuli aban ká a Gat-Hefa andǝ Et-Kazin, sǝ lang sarǝa wari a Rimon ngga, kàr aban ká Neya. <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />Pǝlǝ nǝ njar-nza aban ká a Hanaton sǝ kya masǝlǝa a ɓangŋaban mala Ifta-El. <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />Alá aɓa bù-nzali malea ka à nda ka: Kata, andǝ Nahalal, andǝ Shimron, andǝ Idala, sǝ Betalami; anggea-là lum-nong-ɓari andǝ amuna-là malea. <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />Mǝno ka nda nzali liɓala mala tàu mala Zebulu arǝ anggurkwar malea, kpapi andǝ anggea-là mǝno andǝ amuna-là malea.<verse eid="JOS 19:16" /></para>
  <para style="s">Nzali liɓala mala tàu mala Isaka</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />Inea bwal-shishar ka, pur ace tàu mala Isaka arǝ anggurkwar malea. <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />Alá aɓa bù-nzali malea ka, à nda ka: Jezǝril, andǝ Kesulot, andǝ Shunem, <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />andǝ Hafarayim, andǝ Shiyon, andǝ Anaharat, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />andǝ Rabit, andǝ Kishiyon, andǝ Ebez, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />andǝ Remet, andǝ En-Ganim, andǝ En-Hada, sǝ Bet-Pazez. <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />Nzong-nzalinì gbal ka je Tabo, andǝ Shahazuma, andǝ Bet-Shemesh, sǝ masǝlǝa a Nggeasala Jodan; anggea-là lum-bwamdǝ-tongno-nong-mwashat andǝ amuna-là malea. <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />Mǝno ka nda nzali liɓala mala tàu mala Isaka arǝ anggurkwar malea, kpapi andǝ anggea-là mǝno andǝ amuna-là malea.<verse eid="JOS 19:23" /></para>
  <para style="s">Nzali liɓala mala tàu mala Asha</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />Tongnoia bwal-shishar ka, yi pur ace tàu mala Asha arǝ anggurkwar malea. <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />Alá aɓa bù-nzali malea ka, à nda ka: Helkat, andǝ Hali, andǝ Beten, andǝ Akshaf, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />andǝ Alamelek, andǝ Amat, sǝ Mishal. A njar-nzali ka, je Kamel andǝ Shiho-Libǝnat, <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />pǝlǝa wuli nǝ njar-takuli, o a Bet-Dagon sǝ kya je Zebulu andǝ ɓangŋaban mala Iftahel nǝ njar-nza mala Bet-Emek andǝ Neyel. Pǝlǝa lidǝmba nǝ njar-nza aban ká a Kabul, <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />andǝ Ebǝron, andǝ Rehop, andǝ Hammon, andǝ Kana, sǝ u ɗār a Sidon Mǝgule. <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />Pǝlǝa nzong-nzalinì kàr aban ká a Rama, kya bik kanggǝrang nggea-là mala amǝ Taya. Kàr aban ká a Hosa, sǝ kya masǝlǝa a Nggeamùr Mediterani tù a ban Mahalap,<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fq" closed="false">Mahalap </char><char style="ft" closed="false">ko &lt;&lt;Mehebel&gt;&gt;</char></note> andǝ Akzip, <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />andǝ Uma, andǝ Afek, sǝ Rehop. Anggea-là andǝ amuna-là malea kat ka à nda lumi-ɓari-nong-ɓari. <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />Mǝno ka nda nzali liɓala mala tàu mala Asha arǝ anggurkwar malea, kpapi andǝ anggea-là mǝno andǝ amuna-là malea.<verse eid="JOS 19:31" /></para>
  <para style="s">Nzali liɓala mala tàu mala Naftali</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />Tongno-nong-mwashatia bwal-shishar ka yiu pur ace amǝkà Naftali, ace amǝkà Naftali arǝ anggurkwar malea. <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />Nzong-nzali malea ka, tite a Helef andǝ nggun-mǝgule mala Zaananim, sǝ kutio o a Adami-Nekep, andǝ Jabneel sǝ lidǝmba o a Lakum, sǝ kya masǝlǝa a Nggeasala Jodan. <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />Pǝlǝa nzong-nzalinì kàr nǝ njar-nzali aban ká a Azǝnot-Tabo, sǝ lo kano ka, o a Hukok, kya je Zebulu a bù njar-kunmur, Asha a njar-nzali, sǝ Yahuda a njar-takuli a Nggeasala Jodan. <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />Akanggǝrang alá malea ka à nda ka: Zidim, andǝ Zer, andǝ Hamat, andǝ Rakat, andǝ Chineret, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />andǝ Adama, andǝ Rama, andǝ Hazo, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />andǝ Kedesh, andǝ Edǝri, andǝ En-Hazo, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />andǝ Yiron, andǝ Migdal-El, andǝ Horem, andǝ Bet-Anat, sǝ Bet-Shemesh; anggea-là lum-bwamdǝ-tongno-ine andǝ amuna-là malea. <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />Mǝno ka, nda nzali liɓala mala tàu mala Naftali arǝ anggurkwar malea, kpapi andǝ anggea-là mǝno andǝ amuna-là malea.<verse eid="JOS 19:39" /></para>
  <para style="s">Nzali liɓala mala tàu mala Dan</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />Tongno-nong-ɓaria bwal-shishar ka, yiu pur ace amǝkà Dan arǝ anggurkwar malea. <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />Alá aɓa bù-nzali liɓala malea ka, à nda ka: Zora, andǝ Eshtawol, andǝ Ir-Shemesh, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />andǝ Shaalabin, andǝ Aijalon, andǝ Itǝla, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />andǝ Elon, andǝ Timna, andǝ Ekǝron, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />andǝ Elteke, andǝ Gibeton, andǝ Baalat, <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />andǝ Jehut, andǝ Bene-Berak, andǝ Gat-Rimon, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />andǝ Me-Jarkon, andǝ Rakkon, andǝ bù-nzali mǝnana a nkāɓe Jopa ka. <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" />Nǝnzǝ́mò ka, aɓiubura gandǝ amǝ Dan sǝ à pǝria à nying bù-nzali malea. Pǝlǝa à warinǝ munǝo arǝ ɓè là à tunǝi ama Leshem. À lì sǝ à wal-lú aɓwana mǝnana à duk kam ngga nǝ kún nggeabyau; à é pǝlǝ malea, sǝ à duk kam. À nggaɗi lullǝ lê nǝ lullǝ keâ Dan. <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />Mǝno ka nda nzali liɓala mala tàu mala aɓwana mala Dan arǝ anggurkwar malea, kpapi andǝ anggea-là mǝno andǝ amuna-là malea.<verse eid="JOS 19:48" /></para>
  <para style="s">Nzali liɓala ace Jesǝwa</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />Lang à malǝna gaki abú-nzali ace liɓala ka, amǝ Isǝrayila pè Jesǝwa, muna-ɓwabura mala Nun, nzali ace liɓala aɓalǝia. <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />Kǝla mǝnana Yahweh tsǝkia wia nzongcau ka à pè wi nggea-là mǝnana earkice ka, yì nggea-là Timnat-Sera a nzali múr-ankono mala Ifǝrem. Ɓak nggea-lê sǝ duk kam.<verse eid="JOS 19:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JOS 19:51" />Amǝno ka, à nda ka anzali liɓala mǝnana Eleaza pǝris, andǝ Jesǝwa muna-ɓwabura mala Nun, andǝ aɓwana-mǝgule amur aɓala-kàu mala atau mala amǝ Isǝrayila gakia nǝ bwal-shishar a Shilo aɓadǝm Yahweh, a bankutio aɓa Tara Ban-Peri ka. Anggo sǝ à yi mal gau nzalinì.<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s">Anggea-là àwá</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />Yahweh banggi Jesǝwa ama, <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />&lt;&lt;Banggi amǝ Isǝrayila ama, &lt;Wu tàr anggea-là àwá, mǝnana ǝn bangga wun nǝ kún Musa, <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />ama ɓwa mǝnana kat wal-lú ɓwa sǝ pà kpakpak raka, ko pè aɓa ɗwanyi-sǝlǝe ka, ɓwe nǝ̀ gandǝ ɓangŋa nǝ̀ ká kàm ngga. Anggea-lê nǝ̀ dupa wun ban-auwa ace apî mǝ'pě-gbal a kúnì nkila mana à sukki ka. <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />Nǝ̀ ɓangŋa nǝ̀ o aɓa mwashat atà amǝno yì anggea-là ka, sǝ nǝ̀ nggá cam a bankutio aɓa patal mala kún nggea-là, sǝ nǝ̀ bǝlkuni amur gìr mǝnana kumban ngga, aɓadǝm aɓwana-mǝgule mala mǝno yì nggea-là ka. Sǝ à nǝ̀ kùtí nǝi aɓa nggea-là ateà, sǝ à nǝ̀ pe wi bando aɓalǝia. <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />Ɓǝ̀ mǝ'pě-gbal a kúnì nkila mana à sukki ka, ɓangŋa yiu atè ka, ɓǝà kǝa pè wi mǝ'wal-lú mǝno ɗang, acemǝnana pà nǝ sǝlǝe male sǝ wal-lú ɓì ɗàng, sǝ ɓinǝmǝsǝi gbal ɗiɗyal ɗàng. <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />Yi ka nǝ̀ ue aɓa nggea-là mǝno ka, she pwari mǝnana camǝna aɓadǝm ɓwabundǝa ace kasǝ ɓashi ka, ba lú mala pǝris mǝgule mana a buno a bàkú mǝno gìrnî kumban ngga. Sǝ mǝ'wal-lú nǝ̀ gandǝ nyar a ɓala male a là mǝnana pur kàm sǝ ɓangŋa yiu ka.&gt; &gt;&gt;<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />Nda à tàr Kadesh a Galili, aɓa nzali múr-ankono mala Naftali, andǝ Shekem aɓa nzali múr-ankono mala Ifǝrem, andǝ Kiriyat-Arba (mǝnana à kǝ tunǝi gbal ama Hebǝron) ngga, aɓa nzali múr-ankono mala Yahuda. <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />A nkaring Jodan a takuli mala Jeriko ka, à tàr Beza a ɓabondo a ɓawan-mgbangban aɓa bù-nzali mala tàu mala Ruben, andǝ Ramot a Gilǝyat, aɓa bù-nzali mala tàu mala Gad, sǝ Golan a Bashan aɓa bù-nzali mala tàu mala Manasa. <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />Amǝnia ka, à nda ka anggea-là mǝnana à tària ace amǝ Isǝrayila, sǝ ace abǝri mǝnana à ndanǝdo aɓalǝia ka, ama ɓwa mǝnana kat wal-lú kǝɓwa aɓa ɗwanyi-sǝlǝe ka, ɓǝ̀ ɓangŋa ɓǝ̀ u kam ace kum àwá a bù mǝ'pě-gbal a kunì nkila mǝnana à sukki ka, ba pwari mǝnana camǝna aɓadǝm ɓwabundǝa à pàngŋǝ́nì wi ɓashi ka.<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s">Anggea-là mala amǝ'Lawi</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />Pǝlǝa aɓwana-mǝgule amur aɓala-kàu mala amǝ'Lawi sung tù aban Eleaza yì pǝris, andǝ Jesǝwa muna-ɓwabura mala Nun, andǝ aɓwana-mǝgule amur aɓala-kàu mala atau mala amǝ Isǝrayila. <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />À bangcau nǝia a Shilo a nzali Kan'ana ama, &lt;&lt;Yahweh pà nzongcau nǝban Musa ama ɓǝà pà sǝm anggea-là mǝnana sǝm nǝ̀ do aɓalǝia, atārǝia andǝ anzali-yálgìr malea ace agirkusǝu ma'sǝm.&gt;&gt; <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />Nda amǝ Isǝrayila pè amǝ'Lawi amǝnia yì anggea-là nǝ anzali-yálgìr malea mǝnana à kasǝa aɓalǝ anzali liɓala malea ka, kǝla mǝnana nzongcau mala Yahweh bang ngga.<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />Bwal-shishar mǝdǝmbe kpa amur anggurkwar mala amǝ'Kohat. Nda amǝ'Lawi mǝnia mǝnana amǝkà Haruna na ka, à kum anggea-là lum-nong-tàrú a bù atau mala Yahuda, andǝ Shimiyon andǝ Benjami, nǝ bwal-shishar.<verse eid="JOS 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 21:5" />Acili amǝ'Kohat ka, à kum anggea-là lum a bù tàu mala Ifǝrem, andǝ tàu mala Dan, andǝ gauwa-tsùrú mala tàu mala Manasa, nǝ bwal-shishar.<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />Amǝ'Gashon ngga, à kum anggea-là lum-nong-tàrú, nǝ bwal-shishar, a bù anggurkwar aɓa tàu mala Isaka, aɓa tàu mala Asha, aɓa tàu mala Naftali, sǝ aɓa gauwa-tsùrú mala tàu mala Manasa, a Bashan.<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />Amǝ'Merari arǝ anggurkwar malea ka, à kum anggea-là lum-nong-ɓari a bù tàu mala Ruben, tàu mala Gad, andǝ tàu mala Zebulu.<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />Amǝnia yì anggea-là andǝ anzali-yálgìr malea ka, amǝ Isǝrayila pè amǝ'Lawi, nǝ bwal-shishar, kǝla mǝnana Yahweh pà nzongcau nǝban Musa ka.<verse eid="JOS 21:8" /></para>
  <para style="s">Anggea-là ace amǝkà Haruna</para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 21:9" />Anggea-là mǝnia à tunǝ alullǝia aɓalǝ abu-nzali mala tàu mala Yahuda andǝ mala tàu mala Shimiyon ngga, <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />à pè amǝkà Haruna mǝnana à pur aɓa mwashat atà anggurkwar mala amǝ'Kohat, a tàu mala Lawi ka, acemǝnana bwal-shishar mǝdǝmbe ka, kpa amúrià. <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />À pea wia Kiriyat-Arba, mǝnana à tunǝi nǝ lullǝ Arba yì tár Anak, sǝ adyan ngga à tunǝi ama Hebǝron ngga, aɓa nzali múr-ankono mala amǝ Yahuda, atārǝia andǝ anzali-yálgìr male mǝnana à kàrì ka. <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />Sǝama, aɓaban andǝ amuna-là mǝnana à kàrì nggea-lê ka, à angŋa dǝmba à pànî Kalip, muna-ɓwabura mala Jefune kǝla girkuma male. <verse eid="JOS 21:12" /><verse number="13" style="v" sid="JOS 21:13" />Tsǝà amur Hebǝron (mǝnana nda mwashat atà anggea-là àwá ace ɓwa mǝnana wal-lú ka) nǝ anzali-yálgìr male ka, à pè amǝ'kà Haruna Libna nǝ anzali-yálgìr male, <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />andǝ Jatǝr nǝ anzali-yálgìr male, andǝ Eshtemowa nǝ anzali-yálgìr male, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />andǝ Holon nǝ anzali-yálgìr male, andǝ Debir nǝ anzali-yálgìr male, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />andǝ Ayin nǝ anzali-yálgìr male, andǝ Jutta nǝ anzali-yálgìr male, sǝ Bet-Shemesh nǝ anzali-yálgìr male; anggea-là tongno-nong-ine mǝnana à twalia aɓalǝ abú-nzali mala atau man ɓari ka.<verse eid="JOS 21:16" /></para>
  <para style="p">
    <verse number="17-18" style="v" sid="JOS 21:17-18" />Aɓa bù-nzali mala tàu mala Benjami ka, à pea wia amǝnia yì anggea-là ine, nǝ anzali-yálgìr malea ka: Gibiyon, andǝ Geba, andǝ Anatot, sǝ Almon. <verse eid="JOS 21:17-18" /><verse number="19" style="v" sid="JOS 21:19" />Anggea-là kat mala amǝkà Haruna, yì pǝris ka, à nda lum-nong-tàrú nǝ anzali-yálgìr malea.<verse eid="JOS 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 21:20" />Acili amǝ'Kohat arǝ anggurkwar malea, mǝnana amǝ'Lawi na ka, à pea wia anggea-là aɓa bu-nzali mala tàu mala Ifǝrem. <verse eid="JOS 21:20" /><verse number="21" style="v" sid="JOS 21:21" />À pea wia Shekem, nggea-là àwá ace ɓwa mǝnana wal-lú ka, nǝ anzali-yálgìr male, aɓa nzali múr-ankono mala Ifǝrem, andǝ Geza nǝ anzali-yálgìr male, <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />andǝ Kipzeyim nǝ anzali-yálgìr male, sǝ Bet-Horon nǝ anzali-yálgìr male: anggea-là ine.<verse eid="JOS 21:22" /></para>
  <para style="p">
    <verse number="23-24" style="v" sid="JOS 21:23-24" />Aɓa bù-nzali mala tàu mala Dan ngga, à pea wia anggea-là ine: Elteke, andǝ Gibeton, andǝ Aijalon, sǝ Gat-Rimon; komǝye atea ka nǝ anzali-yálgìr male.<verse eid="JOS 21:23-24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 21:25" />Aɓa bù-nzali mala gauwa-tsùrú mala tàu mala Manasa ka, à pea wia Ta'anak nǝ anzali-yálgìr male, sǝ Gat-Rimon nǝ anzali-yálgìr male: anggea-là ɓari. <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />Acili amǝ'Kohat arǝ anggurkwar malea ka à pea wia anggea-là lum, nǝ anzali-yálgìr malea.<verse eid="JOS 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 21:27" />Amǝ'Gashon, ɓè nggurkwar atà anggurkwar mala amǝ'Lawi ka, à pea wia anggea-là ɓari aɓa bù-nzali mala gauwa-tsùrú mala tàu mala Manasa: Golan aɓa nzali Bashan (nggea-là àwá ace ɓwa mǝnana wal-lú ka), sǝ Beeshtera; komǝye atea ka nǝ anzali-yálgìr male.<verse eid="JOS 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 21:28" />Aɓa bù-nzali mala tàu mala Isaka ka, à pea wia anggea-là mǝnia ka: Kishon nǝ anzali-yálgìr male, Daberat nǝ anzali-yálgìr male, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />Jarmut nǝ anzali-yálgìr male, sǝ En-Ganim nǝ anzali-yálgìr male: anggea-là ine.<verse eid="JOS 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 21:30" />Aɓa bù-nzali mala tàu mala Asha ka, à pea wia anggea-là mǝnia ka: Mishal nǝ anzali-yálgìr male, Abdon nǝ anzali-yálgìr male, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />Helkat nǝ anzali-yálgìr male, sǝ Rehop nǝ anzali-yálgìr male: anggea-là ine.<verse eid="JOS 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 21:32" />Aɓa bù-nzali mala tàu mala Naftali ka, à pea wia anggea-là mǝnia ka: Kedesh a Galili (nggea-là àwá ace ɓwa mǝnana wal-lú ka) nǝ anzali-yálgìr male, Hamot-dor nǝ anzali-yálgìr male, sǝ Kartan nǝ anzali-yálgìr male: anggea-là tàrú. <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />Anggea-là mǝnana kat amǝ'Gashon arǝ anggurkwar malea à kum ngga, anggea-là lum-nong-tàrú na, nǝ anzali-yálgìr malea.<verse eid="JOS 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 21:34" />Acili amǝ'Lawi, yì amǝ'Merari arǝ anggurkwar malea ka, à pea wia anggea-là mǝnia ka aɓa bù-nzali mala tàu mala Zebulu: Jokneyam nǝ anzali-yálgìr male, Karta nǝ anzali-yálgìr male, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />Dimna nǝ anzali-yálgìr male, sǝ Nahalal nǝ anzali-yálgìr male: anggea-là ine. <verse eid="JOS 21:35" /><verse number="36" style="v" sid="JOS 21:36" />Aɓa bù-nzali mala tàu mala Ruben ngga, à pea wia anggea-là mǝnia ka: Beza nǝ anzali-yálgìr male, Jahaz nǝ anzali-yálgìr male, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />Kedemot nǝ anzali-yálgìr male, sǝ Mefaat nǝ anzali-yálgìr male: anggea-là ine.<verse eid="JOS 21:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 21:38" />Aɓa bù-nzali mala tàu mala Gad ka, à pea wia anggea-là mǝnia ka: Ramot aɓa Gilǝyat (nggea-là àwá ace ɓwa mǝnana wal-lú ka) nǝ anzali-yálgìr male, Mahanayim nǝ anzali-yálgìr male, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />Heshbon nǝ anzali-yálgìr male, sǝ Jaza nǝ anzali-yálgìr male: anggea-là ine na kat-kat. <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />Anggea-là mǝnana kat à pè amǝ'Merari arǝ anggurkwar malea, mǝnana à ueo aɓalǝ acili anggurkwar mala amǝ'Lawi ka, à nda lum-nong-ɓari.<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />Anggea-là mala amǝ'Lawi kat aɓalǝ agirkuma mala amǝ Isǝrayila ka, anggea-là lumi-ine-bwamdǝ-tongno-nong-tàrú (48) na nǝ anzali-yálgìr malea. <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />Komǝye atà amǝnia yì anggea-là ka, ndanǝ anzali-yálgìr male mǝnana kàrì ka; anggo sǝ amǝnia yì anggea-là kat ka à pa.<verse eid="JOS 21:42" /></para>
  <para style="s">Yahweh lùmsǝ pacau male</para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />Anggo sǝ Yahweh pè amǝ Isǝrayila nzali mǝnana kat kán ama nǝ̀ pè akeâ ka. À é pǝlǝ girkuma malea, sǝ à duk kam.<verse eid="JOS 21:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JOS 21:44" />Sǝ Yahweh peà wia usǝlǝo a koya buì, kǝla mǝnana kánbì akeâ ka. Kǝ ɓè atà aɓia-mǝbura pa kàm mǝnana cam a kunia ka ɗàng. Yahweh ka pà aɓia-mǝbura kat a ɓabuia. <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />Ko mwashat pa kàm, aɓalǝ apacau mǝnana à pur a kún Yahweh aban ɓala mala Isǝrayila, mǝnana kpa a nzali ka ɗàng. Koya cau bang ngga, yi lumsǝo.<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s">Atau a takuli nyare a là malea</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />Pǝlǝa Jesǝwa tunǝ amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa, <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />sǝ banggia wia ama, &lt;&lt;Wu bwalǝna anzongcau mǝnana kat Musa guro mala Yahweh pà wun ngga, sǝ wu kpanatà agir mǝnana kat ǝn bangga wun ngga. <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />Anonggio pas mǝnia ba yalung ngga, wu bwakibu wun arǝ amǝ'eam wun, amǝ Isǝrayila ɗàng. Wu lùmsǝ̀nà túró mǝnana Yahweh Ɓakuli ma'wun tsǝka wun nzongcau arǝì ama ɓǝ̀ wu pè ka. <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />Sǝ adyan ngga Yahweh Ɓakuli ma'wun pànî amǝ'eam wun usǝlǝo, kǝla mǝnana pàcau abania ka. Acemani ka, wu nyare wu o arǝ alá ma'wun aɓa nzali mǝnana Musa, yì guro mala Yahweh pà wun, ɓǝ̀ duk girkuma ma'wun a nkaring Jodan ngga. <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />Sǝama wu tsǝkir wun pepè arǝ kpata anzongcau andǝ anggurcau mana Musa, guro mala Yahweh tsǝka wun ngga; wu earce Yahweh Ɓakuli ma'wun, wu gya arǝ anjar male kat, sǝ wu kpata anzongcau male; wu bwal Yahweh Ɓakuli ma'wun pepè, sǝ wu kpate nǝ ɓabum wun kat andǝ yilǝmi wun kat.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:5 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 23:11">Jes 23:11</ref>; <ref loc="DEU 6:5">Nggur 6:5</ref>; <ref loc="DEU 10:12">10:12</ref>; <ref loc="DEU 11:1">11:1</ref>; <ref loc="DEU 11:13">11:13</ref>; <ref loc="DEU 11:22">11:22</ref> </char>.</note> <verse eid="JOS 22:5" /><verse number="6" style="v" sid="JOS 22:6" />Nda Jesǝwa tsǝkia wia bù, sǝ tasǝia à nyare à o arǝ alá malea ka.<verse eid="JOS 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 22:7" />Musa angŋa dǝmba pànî ɓè gauwa-tsùrú mala amǝ'tàu mala Manasa nzali liɓala a Bashan, sǝ cili gauwa-tsùrú mala amǝ'tàu mala Manasa ka, Jesǝwa pea wia nzali liɓala a nkanggari nzali mala amǝ'eambia a njar-nzali mala Jodan. Sǝ lang Jesǝwa tasǝia ɓǝà o arǝ alá malea ka, tsǝkia wia bù, <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />nea wia ama, &lt;&lt;Wu nyare arǝ alá ma'wun nǝ gǝna kpǝm andǝ adomwan mǝgulke mala agirkusǝu, nǝ bolo-azǝrfa, andǝ bolo-njengǝlan, andǝ bolo-bángŋá, andǝ bolo-candǝa andǝ agir-nggūrǝu pas. Wu gau agǝna-lwa mǝnana wu pwani arǝ aɓiwun-amǝbura ka wunǝ amǝ'eam wun.&gt;&gt; <verse eid="JOS 22:8" /><verse number="9" style="v" sid="JOS 22:9" />Nda amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa nying acili amǝ Isǝrayila a Shilo, mǝnana nda aɓa nzali Kan'ana ka, sǝ à bwal njar aban ká ace nyare arǝ alá malea, a nzali Gilǝyat, yì nzali girkuma malea mǝnana à é duk malea nǝ kpata nzongcau mala Yahweh mǝnana bangŋi nǝ kún Musa ka.<verse eid="JOS 22:9" /></para>
  <para style="s">Atau a takuli ɓak gyangŋan mala nakún</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />Sǝ lang amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa, yi bik Gelilot, mǝnana nda a bù njar-nzali mala Jodan aɓa nzali Kan'ana ka, à ɓak kaɓa gyangŋan a ban mǝno a nkanggari Jodan. <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />Sǝ acili amǝ Isǝrayila ok ama, &lt;&lt;Wu sǝni, amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa ɓangŋǝna gyangŋan a bankutio aɓa nzali Kan'ana, a Gelilot, a nkanggari Jodan, a buì mǝnana mala amǝ Isǝrayila na ka.&gt;&gt; <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />Nda ɓinala amǝ Isǝrayila puppup ramba a Shilo ace kánǝ munǝo arǝia.<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />Pǝlǝa amǝ Isǝrayila túr Finehas muna-ɓwabura mala Eleaza, yì pǝris aban amǝ'tàu mala Ruben andǝ amǝ'tàu mala Gad andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa, a nzali Gilǝyat. <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />Finehas wari atārǝia andǝ amúrû lum mala amǝ Isǝrayila, ɓwa mwashat a koya tàu. Koyan ateà ka ɓwamǝgule na amur mwashat atà aɓala-kàu mala Isǝrayila. <verse eid="JOS 22:14" /><verse number="15" style="v" sid="JOS 22:15" />Sǝ à yiu aban amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa, a nzali Gilǝyat, sǝ à nea wia ama, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />&lt;&lt;Ɓinala puppup mala Yahweh kǝ bang ama, &lt;Palang sǝ wu mgbikî Ɓakuli mala amǝ Isǝrayila kiru, mǝnana yalung ngga wu pǝlǝ nzǝm wun arǝ kpata Yahweh ka? Wu ɓakkî ɓamurǝ wun gyangŋan yalung ace mgbicau arǝ Yahweh.<note caller="+" style="f"><char style="fr" closed="false">22:16 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 22:18-19">Jes 22:18-19</ref></char>.</note> <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" /><note caller="+" style="f"><char style="fr" closed="false">22:17 </char><char style="fq" closed="false">Cauɓikea mǝnana à pè a Piyor </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="NUM 25:3">Ɓal 25:3</ref>; <ref loc="DEU 4:3">Nggur 4:3</ref>; <ref loc="PSA 106:28">Ang 106:28</ref></char>.</note>Cauɓikea mǝnana à pè a Piyor ka, gìr mǝkyauwe na aban sǝm le? Yi pur a yalung sǝm nggǝ tanni piu atàcau mala mǝno yì cauɓikea ka, kat andǝ amani ama kwánó-twàl-là yiu amur ɓwabundǝa mala Yahweh ka! <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />Sǝ ado ka wun ndarǝ pǝlǝì Yahweh nzǝm wun le?</para>
  <para style="p" vid="JOS 22:18">&lt;&lt; &lt;Ɓǝ̀ wu mgbicau arǝ Yahweh yalung ngga, li ka bumi nǝ̀ lúllô arǝ ɓwabundǝa mala Isǝrayila puppup. <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />Ɓǝ̀ nzali girkuma ma'wun ngga pǝndǝkina ka, wu yiu a nzali mala Yahweh, ban mǝnana Taragula male cam kam ngga, wu yi do atà sǝm. Sǝama wu kǝa mgbicau arǝ Yahweh, ko arǝ sǝm, nǝ ɓak ɓè gyangŋan mana nda ɗàng andǝ gyangŋan mala Yahweh Ɓakuli ma'sǝm ngga ɗang. <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />Lang Akan, mǝkà Zera, dumnǝ ɗwanyi-mǝsǝcau arǝ agir mǝnana à tària ka,<note caller="+" style="f"><char style="fr" closed="false">22:20 </char><char style="fq" closed="false">agir mǝnana à tària ka </char><char style="ft">ko agir mǝnana à pǝrban arǝia ka</char>.</note> bumlulla mala Yahweh sulǝ amur ɓwabundǝa mala amǝ Isǝrayila kat re? Sǝ yì na nǝmurǝi wǔ atàcau mala cauɓikea male ka ɗàng.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">22:20 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JOS 7:1-26">Jes 7:1-26</ref></char>.</note><verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />Pǝlǝa amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ gauwa-tsùrú mala amǝ'tàu mala Manasa nyesǝi amúrû mala aɓala-kàu mala Isǝrayila cau ama, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />&lt;&lt;Mǝ'rǝcandǝa, Ɓakuli, nda Yahweh! Mǝ'rǝcandǝa, Ɓakuli, nda Yahweh! Yi ka súrǝ́nà rǝ mǝsǝcau;<note caller="+" style="f"><char style="fr" closed="false">22:22 </char><char style="fq" closed="false">súrǝ́nà rǝ mǝsǝcau </char><char style="ft" closed="false">ko ndanǝ sǝlǝe.</char></note> sǝ Isǝrayila ka ɓǝ̀ sǝlǝa: Ɓǝ̀ mǝnia yì gìr sǝm pè ka, nda ace mgbicau ko mgbikiru aban Ɓakuli ka, wu kǝa nying sǝm ɓǝ̀ sǝm au yalung ɗàng! <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />Ɓǝ̀ sǝm ɓangŋǝna gyangŋan ace ɓamurǝ sǝm ace mǝnana sǝm nǝ̀ pǝlǝ nzǝm sǝm arǝ kpata Yahweh; ko ace apagir mala pisǝe kǝring, ko apagir mala mǝsǝsa, ko apagir mala dotarǝu, amurí ka, ɓǝ̀ Yahweh nǝ ɓamurǝì mbwe sǝm akúnì. <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />Awo, sǝm pè ace ɓangciu ama ear ka a dǝmba ka, amuna ma'wun nǝ̀ banggi amuna ma'sǝm ama, &lt;Mana kpapi wun wunǝa Yahweh, Ɓakuli mala amǝ Isǝrayila? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />Acemǝnana Yahweh tsǝ̀ngŋǝ̀nà Jodan nda nzong-nzali mana gau nre sǝm sǝnǝa wun, wun amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad. Wu pànǝ kāmbe aɓa Yahweh ɗàng.&gt; Anggo ka, amuna ma'wun nǝ̀ tsǝk amuna ma'sǝm nǝ̀ nying peri aban Yahweh. <verse eid="JOS 22:25" /><verse number="26" style="v" sid="JOS 22:26" />Acemani ka sǝm bang ama, &lt;Ɓǝ̀ sǝm ɓak gyangŋan, sǝ pà ace pàgir mala pisǝe kǝring ko pà gìr'nkila ɗàng, <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />sǝama nda ace mǝnana ɓǝ̀ duk girnakun anre sǝm sǝnǝa wun,<note caller="+" style="f"><char style="fr" closed="false">22:27 </char><char style="ft" closed="false">Sǝni gbal a mǝsǝi 28 andǝ 34 mala kùré mǝnia.</char></note> sǝ a nre ka anza mǝnana à kǝ̀ yiu anzǝm sǝm ngga, ace mǝnana sǝm nǝ̀ peri aban Yahweh a ɓadǝmbi nǝ apagir mala pisǝe kǝring, andǝa pà gìr'nkila andǝ apagir mala dotarǝu. Sǝ a dǝmba ka amuna ma'wun pà nǝ̀ gandǝ ne amuna ma'sǝm ama, &lt;&lt;Wu pànǝ kāmbe aɓa Yahweh ɗàng.&gt;&gt; &gt; <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />Sǝ sǝm pàk ɗenyicau ama, &lt;Ɓǝ̀ à bangga sǝm ko à banggi amuna ma'sǝm a ɓè pwari anggo ka, sǝm nǝ̀ bang ama, &lt;&lt;Wu sǝn ulang gyangŋan mala Yahweh mǝnana aká sǝm ɓè, sǝ pà ace apagir mala pisǝe kǝring, ko pà gìr'nkila ɗàng, sǝama nda ace mǝnana ɓǝ̀ duk girnakun anre sǝm sǝnǝa wun ngga.&gt;&gt; &gt; <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />Ɓǝ̀ sappi ban sǝm ama sǝm nǝ̀ mgbicau arǝ Yahweh, sǝ sǝm nǝ̀ nying kpata Yahweh yalung nǝ ɓak gyangŋan ace pàgir mala pisǝe kǝring, ko pàgir mala mǝsǝsa, ko pà gìr'nkila ka. Pà sǝm nǝ̀ ɓak ɓè gyangŋan ɗàng shekǝ gyangŋan mala Yahweh Ɓakuli ma'sǝm mǝnana came aɓadǝm Taragula male ka!&gt;&gt;<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />Lang Finehas pǝris andǝ aɓwana-mǝgule mala ɓwabundǝa, yì amúrû mala aɓala-kàu mala Isǝrayila mǝnana à waria atè, ok acau mana amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad, andǝ amǝ'tàu mala Manasa bang ngga, kara banɓoaria wia arǝ cê. <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />Pǝlǝa Finehas muna-ɓwabura mala Eleaza, yì pǝris, banggi amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad andǝ amǝ'tàu mala Manasa ama, &lt;&lt;Yalung ngga sǝm sǝlǝna ama Yahweh na aɓalǝ sǝm, acemǝnana pà ace mgbikî Yahweh kiru sǝ wu pàk man yì gìr ka ɗàng. Adyan ngga wu amsǝna amǝ Isǝrayila a ɓabù Yahweh.&gt;&gt; <verse eid="JOS 22:31" /><verse number="32" style="v" sid="JOS 22:32" />Pǝlǝa Finehas muna-ɓwabura mala Eleaza, pǝris, andǝ aɓwana-mǝgule nying amǝ'tàu mala Ruben, andǝ amǝ'tàu mala Gad a nzali Gilǝyat, sǝ à nyare a nzali Kan'ana. À yì ne amǝ Isǝrayila cau mǝnana à kya ok ka. <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />Sǝ banɓoaria amǝ Isǝrayila arǝ cau mǝnana à yì banggia wia ka. Pǝlǝa amǝ Isǝrayila ɓwangsǝ Ɓakuli, sǝ à nyare à na cau mala kánǝ lwa ace kiɗiki anzali mǝnana amǝ'tàu mala Ruben andǝ amǝ'tàu mala Gad ndanǝdo kam ngga ɗàng.<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />Amǝ'tàu mala Ruben andǝ amǝ'tàu mala Gad tsǝki gyangŋanì lullǝ ama Nakún, acemǝnana à bang ama, &lt;&lt;Mǝnia ka nakún na anre sǝm, ama Yahweh ka Ɓakuli na.&gt;&gt;<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s">Masǝlǝata cau mala Jesǝwa aban amǝ Isǝrayila</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />Anzǝm mana apǝlǝkia pas kutikina, sǝ Yahweh pàni amǝ Isǝrayila usǝlǝo arǝ aɓia-mǝbura mǝnana kat à kàrìbania, sǝ Jesǝwa ka ena kutsuk ka, <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />Jesǝwa túrban ɓǝà tunǝ amǝ Isǝrayila kat, andǝ akapana andǝ aɓwana-mǝgule malea, amǝ'ɓashi malea, andǝ amǝgulo sǝ banggia wia ama, &lt;&lt;Adyan ngga ǝn enà sǝ ǝn pǝlǝna jamgula. <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />Sǝ wu sǝnǝna agir mǝnana kat Yahweh Ɓakuli ma'wun pàngŋǝ́nì anzali mǝnia kat atàcau ma'wun ngga, acemǝnana Yahweh Ɓakuli ma'wun, nda mǝnana munǝo ace wun ngga. <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />Ɓalǝ wun ɓǝ̀ kasǝa ama ǝn gapini atau ma'wun anzali mǝnana wu malaká lia nǝ lwa raka, atārǝia andǝ anzali mǝnana sǝm angŋa dǝmba sǝm linia ka, ɓǝà duk gìr'liɓala ma'wun, twal a kún Nggeasala Jodan aban ká kún Nggeamùr Mediterani a njar-nzali. <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />Yahweh Ɓakuli ma'wun nǝ̀ ramtea a ɓadǝm wun. Yì ka nǝ̀ pǝria ɓǝà upi ɓamǝsǝ wun, sǝ wun nǝ̀ ak nzali malea ɓǝ̀ duk girkuma ma'wun, kǝla mana Yahweh Ɓakuli ma'wun pàcau aban wun ngga. <verse eid="JOS 23:5" /><verse number="6" style="v" sid="JOS 23:6" />Acemani ka, wu dum nǝ rǝcandǝa kǝ̀rkǝ́r arǝ bwal acau mǝnana kat à gilǝia aɓa Malǝmce Nggurcau mala Musa ka, sǝ wu kpatea. Wu kǝa na ama wun nǝ̀ kyanggi wi ko atà bu-mǝlì ko atà bu-mǝnggare ɗàng, <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />sǝ wu kǝa kpapi ɓamur wun wunǝ aɓwapǝndǝa mala anzali mǝnana à ueo aɓalǝ wun ngga ɗàng. Yale wu kǝa na ama wun nǝ̀ tunǝ lullǝ aɓakuli malea, ko wun nǝ̀ kángìr nǝia, ko wun nǝ̀ kpata acau malea, ko wun nǝ̀ ɓun a nzali abania ɗàng. <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />A kún mani ka, dumǝna púp wun nǝ̀ lanzǝ arǝ Yahweh Ɓakuli ma'wun, kǝla mana wu pè yi pur a yalung ngga.<verse eid="JOS 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 23:9" />&lt;&lt;Yahweh ka pǝrna aɓwapǝndǝa mala anzali mǝgulke andǝ amana à kútì wun nǝ rǝcandǝa ka, a ɓadǝm wun. Sǝ wun ngga, kǝɓwa pà kàm mǝnana gandǝ came a ɓadǝm wun ngga ɗàng yi pur a pwari man yalung ngga. <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />Ɓwa mwashat ma'wun nǝ̀ loasǝtà aɓwana á-mwashat acemǝnana Yahweh Ɓakuli ma'wun nda mǝnana kǝ munǝo ace wun, kǝla mana pàcau ace aban wun ngga. <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />Acemani ka, wu dum nǝ tsǝkiru pepè, wu earce Yahweh Ɓakuli ma'wun. <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />Acemǝnana ɓǝ̀ wu pǝlǝ nzǝm wun, sǝ wu lanzǝ arǝ acili aɓwapǝndǝa mala anzali mǝnia mǝnana à ueo aɓalǝ wun, sǝ wu kùtí a al rǝarǝ wun wunǝia, mǝnana nǝ̀ kánǝ wun a kpapi ɓamur wun wunǝia, sǝ yià andǝ wun ngga, <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />wu sǝlǝ ama nǝ mǝsǝtacau Yahweh Ɓakuli ma'wun pà nǝ̀ nyare nǝ̀ pǝ̀r aɓwapǝndǝa mala anzali mǝnia ɗǝm a ɓadǝm wun ɗàng. A kún mani ka, à nǝ̀ dupa wun gìr'damban andǝ gbǝ́lî. À nǝ̀ do kǝla nkamso mǝnana nǝ̀ kok wun a nzǝm wun, sǝ kǝla azwe mǝnana à nǝ̀ soaki wun a mǝsǝ wun ngga, gandǝa wun nǝ̀ kìɗikì, wun nǝ̀ malì nzali mǝɓoarne mǝnana Yahweh Ɓakuli ma'wun pàna wunì ka.<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />&lt;&lt;Sǝ adyan ngga málá mǝ nǝ o a njar mǝnana ɓanza kat ukiyi kam ngga, sǝ wun kat wu sǝlǝna a ɓabum wun andǝ yilǝmi wun ama, atà apacau mǝɓoarne mǝnana Yahweh Ɓakuli ma'wun pâ aban wun ngga, kǝɓè pà kàm mǝnana kpa ka ɗàng. Yià kat ka à yi lúmsǝ̀nà ace wun; ko mwashat atea kpa ɗang.<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="JOS 21:45">Jes 21:45</ref></char>.</note> <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />Sǝama kǝla mǝnana agir mǝɓoarne mǝnana kat Yahweh Ɓakuli ma'wun pacau acea aban wun ngga, à yì lúmsǝ̀nà ka, anggo gbal sǝ Yahweh nǝ̀ yinǝ agir mǝɓike mǝnana kat bangcau acea ka amúr wun, sheɓǝ̀ kìɗìkìnà wun, wu malǝnì ɓá nzali mǝnana Yahweh Ɓakuli ma'wun pana wuni ka,<note caller="+" style="f"><char style="fr" closed="false">23:15 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="LEV 26:14-33">Pǝris 26:14-33</ref>; <ref loc="DEU 28:15">Nggur 28:15</ref></char>.</note> <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />ɓǝ̀ wu yàlî kùrcau mala Yahweh Ɓakuli ma'wun, mǝnana tsǝka wun nzongcau ace ama ɓǝ̀ wu bwali, sǝ wu kùtí a kpata aɓea aɓakuli sǝ wu ɓun abania ka. Bumlulla mala Yahweh nǝ̀ earbǝsa amur wun, sǝ wun nǝ̀ kìɗìkì akaurǝa, wun nǝ̀ malì ɓá nzali mǝɓoarne mǝnana pana wuni ka.&gt;&gt;<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s1">À kwakita kùrcau abǝshe a Shekem</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />Jesǝwa ram atau mala Isǝrayila kat a Shekem sǝ tunǝ aɓwana-mǝgule, andǝ amúrû, andǝ amǝ'ɓashi, andǝ amǝ'sàrǝ̀ban mala Isǝrayila. Sǝ à yinǝ ɓamuria aɓadǝm Yahweh. <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" />Sǝ Jesǝwa banggi aɓwe kat ama, &lt;&lt;Yahweh, Ɓakuli mala Isǝrayila bang ama, &lt;A pwarian ngga, aká-wun do a nkaring Yiufǝretis, sǝ à kpata aɓea aɓakuli. Mwashat atà amǝno yì aká-wun ngga nda Tera tár a Ibǝrayim andǝ Naho. <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />Pǝlǝa ǝn twal kà wun Ibǝrayim a nkaring Mùr Yiufǝretis sǝ ǝn gingnǝi aɓa nzali Kan'ana puppup, sǝ ǝn tsǝk amǝkè làkkì pas. Ən pe wi Ishaku. <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />Sǝ mala Ishaku ka, ǝn pe wi Yakupu andǝ Isǝwa. Sǝ ǝn pe Isǝwa nzali múr-nkono Seyir ɓǝ̀ duk girkuma male, sǝama Yakupu andǝ amuni ka, à o a Masar.<verse eid="JOS 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 24:5" />&lt;&lt; &lt;Pǝlǝa ǝn túr Musa andǝ Haruna, sǝ ǝn yinǝ gìr'mur'mwana amúr Masar nǝ gir mǝnana ǝn pê aɓalǝi ka, sǝ nǝnzǝ́mò ka ǝn pusǝ wun, wu purî ɓālǝi. <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />Lang ǝn pusǝ aká wun, à purî Masar ka, à yi bik Nggeamùr Nzuno. Sǝ amǝ Masar pǝrta aká-wun nǝ awaru-pǝr andǝ amǝ'pǝ̀r, aban ká a Nggeamùr Nzuno. <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />Sǝ lang à ɓua abanam Mim Yahweh ka, ǝn tsǝk pǝndǝa anrea andǝ amǝ Masar. Ən tsǝk nggeamùr eau amúr amǝ Masar, sǝ gìr múrià; wu sǝni nǝ mǝsǝ wun yì gìr mǝnana ǝn pe a Masar ka. Sǝ wu do a ɓabondo banì sauwa.<verse eid="JOS 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 24:8" />&lt;&lt; &lt;Pǝlǝa ǝn yinǝ wun a nzali mala amǝ'Amor, mǝnana à do a ɓè nkaring mala Jodan ngga. À munǝ arǝ wun, sǝ ǝn tasǝia a ɓabù wun, wu ak nzali malea pǝlǝ girkuma ma'wun. <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />Pǝlǝa Balak muna-ɓwabura mala Zippor, murǝm mala Mowap, loasǝ munǝo arǝ Isǝrayila. Sǝ túrban à tunǝ Bil'am muna-ɓwabura mala Beyo acemǝnana ɓǝ̀ sú wun, <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />sǝama ǝn kwakikiram arǝ Bil'am ɗàng. Yale yì ka tsǝka wun bù. Nda ǝn amsǝ wun a ɓabuì ka.<verse eid="JOS 24:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 24:11" />&lt;&lt; &lt;Sǝ wu yàlî Jodan, wu yiu a Jeriko, sǝ aburana mala Jeriko munǝ arǝ wun, sǝ anggo gbal amǝ'Amor, andǝ amǝ'Periz, andǝ amǝ'Kan'ana, andǝ amǝ'Hitti, andǝ amǝ'Girgash, andǝ amǝ'Hivi, andǝ amǝ'Jebus. Sǝ ǝn tasǝia a ɓabù wun. <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />Aɓa ká ma'wun ngga, ǝn tasǝ amǝ'ta-nta a ɓadǝm wun mǝnana à pǝr amurǝma ɓari mala amǝ'Amor ka; pà nǝ anggeabyau ko amundi ma'wun sǝ wu kum mǝnia yì limurǝm ngga ɗàng.<note caller="+" style="f"><char style="fr" closed="false">24:12 </char><char style="ft" closed="false">Sǝni aɓa: </char><char style="xt" closed="false"><ref loc="EXO 23:28">Pur 23:28</ref>; <ref loc="DEU 7:20">Nggur 7:20</ref> </char></note> <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />Ən pa wun nzali mǝnana wu tanni ace raka, andǝ anggea-là mǝnana wun nǝ̀ ɓeǎ raka, sǝ wu do aɓalǝia. Wu lì aɓǝla-nggun mala aɓaban-anap andǝ amala aɓaban olif mǝnana wun nda wu pandǝ raka.&gt;<verse eid="JOS 24:13" /></para>
  <para style="s1">Wu twal ɓwa mǝnana wun nǝ̀ kpate ka</para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />&lt;&lt;Ado ka, wu ɓanggi Yahweh sǝ wu kpate nǝ ɓabum mwashat, sǝ aɓa mǝsǝcau. Wu sukki aɓakuli mǝnana aká-wun kpatea a nkaring Nggeasala Yiufǝretis, sǝ a Masar ka, sǝ wu kpata Yahweh. <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />Sǝ ɓǝ̀ kpata Yahweh ka, ɓealɓikea na a mǝsǝ wun ngga, wu twal yalung, ɓwa mǝnana wun nǝ̀ kpate ka, ko aɓakuli mǝnana aká-wun peri abania a bù-nzali mǝnana a nkaring Nggeasala Yiufǝretis ka, ko aɓakuli mala amǝ'Amor, nzali mǝnana wu ndanǝdo aɓalǝi ka. Sǝama mim sǝnǝ amǝ'ɓala mem ngga, sǝm nǝ̀ kpata Yahweh.&gt;&gt;<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />Pǝlǝa aɓwe ear ama &lt;&lt;Ɓǝ̀ sappi ban sǝm yi mana sǝm nǝ̀ ɗeki Yahweh, sǝ sǝm nǝ̀ kpata aɓea aɓakuli ka, <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />acemǝnana Yahweh Ɓakuli ma'sǝm nda mǝnana pusǝ sǝm, sǝnǝ aká-sǝm aɓa nzali Masar, aɓa ɓala mala doguro, sǝ yì nda mǝnana pakki amǝno yì agir-lǝmdǝa mǝgulke ka, a mǝsǝ sǝm. Yál sǝm arǝ anjar mǝnana kat sǝm wari kam ngga, sǝ aɓalǝ aɓwapǝndǝa mǝnana sǝm kùtí nǝbania ka. <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />Sǝ Yahweh pǝr aɓwapǝndǝa kat aɓadǝm sǝm, yì amǝ'Amor mǝnana à do a nzalinì ka. Acemani ka, sǝm nǝ̀ kpata Yahweh, acemǝnana yì ka nda Ɓakuli ma'sǝm.&gt;&gt;<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />Sǝ Jesǝwa banggi aɓwe ama, &lt;&lt;Wu pà wu nǝ̀ gandǝ kpata Yahweh ɗàng, acemǝnana yì ka Ɓakuli mǝfele na. Ɓakuli mǝ'mɓali na; pà nǝ̀ twala-wun-ban amgbicau ma'wun ko acauɓikea ma'wun ɗàng.<note caller="+" style="f"><char style="fr" closed="false">24:19 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="DEU 29:20">Nggur 29:20</ref>; <ref loc="DEU 30:17-18">30:17-18</ref></char>.</note> <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" /><note caller="+" style="f"><char style="fr" closed="false">24:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="1CH 28:9">1Acau 28:9</ref>; <ref loc="2CH 15:2">2Acau 15:2</ref>; <ref loc="EZR 8:22">Ezr 8:22</ref>; <ref loc="ISA 1:28">Isha 1:28</ref>; <ref loc="ISA 65:11">65:11</ref>,<ref loc="ISA 65:12">12</ref>; <ref loc="JER 17:13">Ir 17:13</ref> </char>.</note>Ɓǝ̀ wu ɗeki Yahweh sǝ wu kpata abǝri aɓakuli ka, yì ka nǝ̀ pǝlǝa arǝ wun, nǝ̀ pàkka wun mǝɓane, sǝ nǝ̀ kiɗiki wun, kat andǝ amani ama ɗiɗyal ka, pàngŋǝ́nà wun mǝɓoarne ka.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">24:20 </char><char style="ft" closed="false">Ɓalli gbal aɓa: </char><char style="xt"><ref loc="JOS 23:15">Jes 23:15</ref>; <ref loc="ISA 63:10">Isha 63:10</ref>; <ref loc="ACT 7:42">Atúró 7:42</ref></char>.</note><verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />Sǝ aɓwe eari Jesǝwa ama &lt;&lt;Awo, sǝm nǝ̀ kpata Yahweh.&gt;&gt;<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />Pǝlǝa Jesǝwa banggi aɓwe ama &lt;&lt;Wu nda ka amǝ'nakún arǝ ɓamurǝ wun ama wu twalna Yahweh, wun nǝ̀ kpate.&gt;&gt; Sǝ à ear ama, &lt;&lt;E, sǝm nda ka amǝ'nakún!&gt;&gt;<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />Jesǝwa na ama, &lt;&lt;Ado ka, wu vwakibu wun arǝ abǝri aɓakuli mǝnana aɓalǝ wun ngga, sǝ wu pà ɓabum wun aban Yahweh Ɓakuli mala Isǝrayila.&gt;&gt;<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />Sǝ aɓwe ne Jesǝwa ama, &lt;&lt;Yahweh Ɓakuli ma'sǝm na sǝm nǝ̀ kpate, sǝ gì na sǝm nǝ̀ oè ka.&gt;&gt;<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />Anggo sǝ Jesǝwa kùrcau nǝ aɓwe a pwari mǝno, sǝ tsǝkia wia anzongcau andǝ angguracau a Shekem. <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />Sǝ Jesǝwa gilǝ amǝnia yì acau ka aɓa Malǝmce Nggurcau mala Ɓakuli. Sǝ twal tali mǝgule, tamsǝi a tǝrta nggun mǝgule mǝnana nda tù nǝ ban Taragula mala Yahweh ka.<verse eid="JOS 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 24:27" />Sǝ Jesǝwa ne aɓwe kat ama, &lt;&lt;Wu sǝni, mǝnia yì tali ka, nǝ̀ duk girnakun arǝ sǝm, acemǝnana ongŋǝna acau mǝnana kat Yahweh bangga sǝm ngga. Acemani ka, nǝ̀ duk girnakun arǝ wun, ace mgbàllì wun arǝ tǝmce Ɓakuli ma'wun.&gt;&gt; <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />Pǝlǝa Jesǝwa mesǝ aɓwe ɓǝà o, koyan ngga a nzali liɓala male.<verse eid="JOS 24:28" /></para>
  <para style="s1">Jesǝwa andǝ Eleaza wǔ</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />Anzǝm amǝnia yì agir ka, Jesǝwa muna-ɓwabura mala Nun, guro mala Yahweh wǔ, lang bwalǝna pǝlǝa gbǝman-mwashat nǝ lum (110) ngga. <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />Sǝ à tsǝk luí a nzali liɓala male a Timnat-Sera, mǝnana nda a nzali múr-ankono mala Ifǝrem ngga, nǝ njar-nza mala Nkono Gash.<verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />
    <note caller="+" style="f">
      <char style="fr" closed="false">24:31 </char>
      <char style="ft" closed="false">Sǝni gbal aɓa: </char>
      <char style="xt">
        <ref loc="JDG 2:7">Akas 2:7</ref>
      </char>.</note>Amǝ Isǝrayila kpata Yahweh aɓa do-yilǝmu mala Jesǝwa kat, sǝ aɓalǝ anonggio kat mala aɓwana-mǝgule mǝnana à ueo nǝyilǝmu anzǝm lú mala Jesǝwa, sǝ à sǝlǝnace túró mǝnana kat Yahweh pè ace Isǝrayila ka.<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />Sǝ mala amú Yisǝfu mǝnana amǝ Isǝrayila pwania a Masar ka,<note caller="+" style="f"><char style="fr" closed="false">24:32 </char><char style="ft" closed="false">Ɓalli aɓa: </char><char style="xt"><ref loc="GEN 50:25">Tite 50:25</ref>; <ref loc="EXO 13:19">Pur 13:19</ref> </char>.</note> à tsǝia a Shekem, a ɓaban mǝnana Yakupu kúrô a bù amuna-burana mala Hamo, tár Shekem nǝ agbatali bolo-azǝrfa gbǝman-mwashat ka (100). Banì duk nzali liɓala mala amǝkà Yisǝfu.<verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />Sǝ Eleaza muna-ɓwabura mala Haruna wǔ, sǝ à tsǝkbani a Gibiya, là mala muna-ɓwabura male Finehas, mǝnana à pe wi a nzali múr-ankono mala Ifǝrem ngga.<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>