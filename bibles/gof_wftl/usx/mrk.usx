<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MRK" style="id">- Goofa</book>
  <para style="h">Marqqoosa</para>
  <para style="toc3">Mar</para>
  <para style="toc2">Marqqoosa</para>
  <para style="toc1">Marqqoosi Xaafida Yesuusa Kiristtoosa Wonggelaa</para>
  <para style="mt1">Marqqoosi Xaafida</para>
  <para style="mt2">Yesuusa Kiristtoosa Wonggelaa</para>
  <para style="imt">Gaatha Qofaa</para>
  <para style="ip">Marqqoosa Wonggelay, “Hayssi Xoossaa na7aa Yesuus Kiristtoosa Wonggelaa doomethaa” gishe koyro doomes. Ha Wonggelan Yesuusi ooso asinne maata aawa gididi shiiqis. Iya maatay iya timirttiyan, tuna ayyaanaa bolla de7iya wolqqaaninne asaa nagaraappe maareyssan qonccis. Yesuusi, “Taani, asaa nagara aylletethaafe kessanaw ta de7uwa aathada immanaw yida Asa Na7aa” yaagidi ba doonan haasayis.</para>
  <para style="ip">Marqqoosi Yesuusa taarikiya suure ogeninne wolqqi kumida ogen odis. Marqqoosi Yesuusa qaalanne timirttiya gidonnashin I oothida malaalisiya oosota bayrayidi odees. Marqqoosi Xammaqiya Yohaannisa taarikiya, Yesuusa xinqqatiyanne iya paaciya qanthan odi simmidi, Yesuusa timirttiyanne iya pasuwa daalggisidi odees. Aqi aqi bishin Yesuusa tamaareti Yesuusa loythidi eri eri bidosona, shin Yesuusa ixxeyssati aathidi ixxishe ixxishe bidosona. Wurssetha shemppoti Yesuusa de7on wurssetha saaminttan polettida oosotabaa odoosona. Hessatikka iya kaqetethaanne iya dendduwabaa odoosona.</para>
  <para style="iot">Marqqoosa Wonggelaa ayfe qofata</para>
  <para style="io1">Wonggelaa doomethaa 1:1-13</para>
  <para style="io1">Yesuusi Galiilan ba oosuwa oykkidayssa 1:14-9:50</para>
  <para style="io1">Yesuusi Yerusalaamen oothida oosuwa 10:1-52</para>
  <para style="io1">Wurssetha saamintta Yerusalaame heeran 11:1-15:47</para>
  <para style="io1">Yesuusa hayqoppe dendduwa 16:1-8</para>
  <para style="io1">Hayqoppe denddida Godaa qonccethaanne salo kessaa 16:9-20</para>
  <para style="ie"/>
  <chapter number="1" style="c"/>
  <para style="s">Xammaqiya Yohaannisi oge giigisees</para>
  <para style="r">(<ref loc="MAT 3:1-12">Maato 3:1-12</ref>; <ref loc="LUK 3:1-18">Luuqa 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Hayssi Xoossaa Na7aa Yesuus Kiristtoosa Wonggelaa doomethaa. <verse number="2" style="v"/>Nabiya Isayaasi xaafida maxaafan Xoossay,</para>
  <para style="q">“Hekko, taani ta kiitanchchuwa</para>
  <para style="q2">taani neeppe sinthe yeddana.</para>
  <para style="q">I ne ogiya giigisana.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mil 3:1</ref></char></note></para>
  <para style="q1">
    <verse number="3" style="v"/>Issoy bazzo gidon ba qaala dhoqqu oothidi,</para>
  <para style="q2">‘Godaa ogiya giigisite;</para>
  <para style="q">I hamuttana horogaa</para>
  <para style="q2">iyaw suurisite gis’ ”</para>
  <para style="m">yaagees.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref></char></note></para>
  <para style="p">
    <verse number="4" style="v"/>Xammaqiya Yohaannisi asaa xammaqishe, “Hintte nagaraappe simmidi xammaqetite; Xoossay hintte nagaraa atto gaana” yaagidi qaala odishe bazzo biittafe yis. <verse number="5" style="v"/>Yihuda biittan de7iya asay ubbaynne Yerusalaame katamaa asay ubbay Yohaannisakko yoosona. Bantta nagara paaxin, Yohaannisi entta Yorddaanose Shaafan xammaqees.</para>
  <para style="p">
    <verse number="6" style="v"/>Yohaannisi gimale ikiseppe dadettida afila ma77ees. Ba xeessan dafo danccees; qassi boolenne degera eessi mees.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2Kawo 1:8</ref></char></note> <verse number="7" style="v"/>Yohaannisi qaala odishe, “Taappe guyera daro minneyssi yees. Hari attoshin, taani iya caammaa wodoruwa hokkada billanawu bessike. <verse number="8" style="v"/>Taani hinttena haathan xammaqays, shin I hinttena Geeshsha Ayyaanan xammaqana” yaagis.</para>
  <para style="s">Yesuusa paacetethaa</para>
  <para style="r">(<ref loc="MAT 3:13-17">Maato 3:13-17</ref>; <ref loc="MAT 4:1-11">4:1-11</ref>; <ref loc="LUK 3:21-22">Luuqa 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v"/>Yesuusi he wode Galiila biittan de7iya Naazirete katamaappe yin, Yohaannisi Yorddaanose Shaafan iya xammaqis. <verse number="10" style="v"/>Yesuusi haathaafe keyaa wode saloy dooyettin, Geeshsha Ayyaanay ba bolla holeda wodhdhishin be7is. <verse number="11" style="v"/>Qassi saloppe, “Taani dosiya ta na7ay nena; ta nenan ufayttays” yaagiya qaalay yis.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maz 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar 9:7</ref>; <ref loc="LUK 3:22">Luuqa 3:22</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Iira Geeshsha Ayyaanay Yesuusa bazzo biitta efis. <verse number="13" style="v"/>Yesuusi bazzo biittan Xalahen paacettishe oytamu gallas gam77is. Do7atara de7is, shin kiitanchchoti yidi iya maaddidosona.</para>
  <para style="s">Yesuusi molo oykkiya oyddu asata xeegis</para>
  <para style="r">(<ref loc="MAT 4:12-22">Maato 4:12-22</ref>; <ref loc="LUK 4:14-15">Luuqa 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Yohaannisi qashettidaappe guye, Yesuusi Xoossaa kawotethaa Wonggelaa odishe Galiila biittaa bis. <verse number="15" style="v"/>Yan, “Wodey gakkis; Xoossaa kawotethay matattis. Hintte nagaraappe simmidi, Wonggelan ammanite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Maato 3:2</ref></char></note></para>
  <para style="p">
    <verse number="16" style="v"/>Yesuusi Galiila Abbaa matara aadhdhishe, molo oykkeyssata, Simoonanne iya ishaa Inddiriyasa, bantta gitiya abban yeggeyssata be7is. <verse number="17" style="v"/>Enttako, “Tana kaallite; taani hinttena ase oythu tamaarssana” yaagis. <verse number="18" style="v"/>Entti sohuwara bantta gitiya yeggi aggidi Yesuusa kaallidosona.</para>
  <para style="p">
    <verse number="19" style="v"/>Yesuusi guuthi sinthe bidi, nam77u ishata Zabdiyoosa nayta, Yayqoobanne Yohaannisa wogoluwa giddon bantta gitiya giigiseyssata be7is. <verse number="20" style="v"/>I entta be7ida mela xeegis. Entti bantta aawa Zabdiyoosa, iya oosanchchotara wogoluwa giddon yeggi aggidi Yesuusa kaallidi bidosona.</para>
  <para style="s">Tuna ayyaanay oykkida uray paxis</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luuqa 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Entti Qifirnahoome katamaa gelidosona. Sambbaati gelida mela Yesuusi ellesidi Ayhude Woosa Keethi gelidi tamaarsso oykkis. <verse number="22" style="v"/>Maatara de7iya asada tamaarssesippe attin higge asttamaaretatho tamaarssonna gisho, asay iya timirttiyan malaalettidosona.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Maato 7:28</ref></char></note></para>
  <para style="p">
    <verse number="23" style="v"/>He wode tuna ayyaanay oykkida issi uray Ayhude Woosa Keethi gelidi ba qaala dhoqqu oothidi, <verse number="24" style="v"/>“Naazirete Yesuusa, neeni nuuppe ay koyay? Nuna dhayssanaw yadi? Neeni ooneekko ta erays; neeni Xoossaa Geeshshaa gidikkii?” yaagis.</para>
  <para style="p">
    <verse number="25" style="v"/>Yesuusi he tuna ayyaanaa, “Hayza, ha addiyafe keya” gidi kiittis.</para>
  <para style="p">
    <verse number="26" style="v"/>Tuna ayyaanay uraa daferethidi, waassidi iyappe keyis. <verse number="27" style="v"/>Asay ubbay malaalettidi, “Hayssi aybee? Ha uray ba maatan hari attoshin tuna ayyaanatakka kiittees. Entti iyaw kiitettosona; hayssi aybi ooratha timirtte?” gidi, bantta giddon issoy issuwa oychchidosona.</para>
  <para style="p">
    <verse number="28" style="v"/>Yesuusa sunthay ellesidi Galiila biittan de7iya heera ubban keyis.</para>
  <para style="s">Yesuusi daro hargganchchota pathis</para>
  <para style="r">(<ref loc="MAT 8:14-17">Maato 8:14-17</ref>; <ref loc="LUK 4:38-41">Luuqa 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi Ayhude Woosa Keethafe keyidi, Yayqoobaranne Yohaannisara Simoona soonne Inddiriyasa soo bis. <verse number="30" style="v"/>Simoona machche aayiya qoxo misha harggada zin77idaaro Yesuusi yaa gakkiya wode iyaw odidosona. <verse number="31" style="v"/>I iikko shiiqidi, I kushiya oykkidi, iyo denthi essis. Qoxoynne mishay aggin iya entta mokkasu.</para>
  <para style="p">
    <verse number="32" style="v"/>Harggida asa ubbaanne tuna ayyaanati oykkida asa ubbaa omarssi away wullidaappe guye, iyaakko ehidosona. <verse number="33" style="v"/>Kataman de7iya asay ubbay he keetha kare shiiqidosona. <verse number="34" style="v"/>Yesuusi dumma dumma harggen oykettida daro asaa pathidi, daro tuna ayyaanata kessis. I ooneekko tuna ayyaanati erida gisho, entta odisonna diggis.</para>
  <para style="s">Yesuusi Galiilan tamaarssis</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luuqa 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Yesuusi wontta guura denddidi, asi baynna bessi bidi, yan Xoossaa woossis. <verse number="36" style="v"/>Simooninne iyara de7eyssati iya koyishe bidosona. <verse number="37" style="v"/>Entti iya demmidi, “Asay ubbay nena koyees” yaagidosona.</para>
  <para style="p">
    <verse number="38" style="v"/>Yesuusi qassi entta, “He heeran de7iya hara katamata yedhdhite. Taani yiday Wonggelaa odanaw gidiya gisho yankka qaala odanaw bessees” yaagis. <verse number="39" style="v"/>Ayhude Woosa Keethatan qaala odishenne tuna ayyaanata kessishe, Galiila biitta ubban yuuyis.<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Maato 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char></note></para>
  <para style="s">Yesuusi baro hargganchchuwa pathis</para>
  <para style="r">(<ref loc="MAT 8:1-4">Maato 8:1-4</ref>; <ref loc="LUK 5:12-17">Luuqa 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v"/>Baroy oykkida issi uray Yesuusakko yidi, iya sinthan gulbbatidi, “Neeni koykko tana geeshshanaw dandda7aasa” yaagidi woossis.</para>
  <para style="p">
    <verse number="41" style="v"/>Yesuusi iyaw qadhettidi, ba kushiya yeddidi iya bochchidi, “Taani koyays, geeya” yaagis. <verse number="42" style="v"/>Sohuwara baroy uraa yeddin uray paxis. <verse number="43" style="v"/>Yesuusi uraa minthi naagisidi kessi yeddis. <verse number="44" style="v"/>Yesuusi iya, “Nena era, hayssa oodeskka odoppa. Shin bada ne asatethaa kahine bessa. Neeni ha77i geeshshi gididayssa asa erisanaw, Musey kiittida yarshshuwa yarshsha” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">Leewe 14:1</ref></char></note></para>
  <para style="p">
    <verse number="45" style="v"/>Shin uray bidi, guta ubban asa ubbaas odis. Hessa gisho, Yesuusi qoncce keyidi, katama gelanaw dandda7ibeenna. Shin asi baynnason gaxan de7is; qassi asay ubba bessafe iyaakko yoosona.</para>
  <chapter number="2" style="c"/>
  <para style="s">Yesuusi gundda uraa pathis</para>
  <para style="r">(<ref loc="MAT 9:1-8">Maato 9:1-8</ref>; <ref loc="LUK 5:17-26">Luuqa 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Guutha gallasappe guye, Yesuusi Qifirnahoome simmidi, son de7ees giya oday si7ettis. <verse number="2" style="v"/>Asaa keethay ekkonna ixxin, hari attoshin kareykka xuummana gakkanaw daro asay shiiqin, Yesuusi qaala tamaarssis. <verse number="3" style="v"/>Oyddu asati issi gundda uraa tookkidi iyaakko ehidosona. <verse number="4" style="v"/>Asay darida gisho, uraa Yesuusakko shiishanaw enttaw dandda7ettona ixxin, Yesuusi de7iya ginaara keetha qaaridi, kaara qawuxidi uraa I zin77ida alggara duge yeddidi Yesuusa sinthan wodhisidosona. <verse number="5" style="v"/>Yesuusi entta ammanuwa be7idi, he gundda uraa, “Ta na7aw, ne nagaray atto geetettis” yaagis.</para>
  <para style="p">
    <verse number="6" style="v"/>Higge asttamaaretappe he bessan uttida issoti issoti bantta wozanan, <verse number="7" style="v"/>“La ha uray hayssa mela iitabaa Xoossaa bolla ays odetii? Xoossaa xalaalappe attin hari ooni nagara atto gaanaw dandda7ii?” gidi qoppidosona.</para>
  <para style="rem">fig 7 fig*</para>
  <para style="p">
    <verse number="8" style="v"/>Entti bantta wozanan hessada qoppidayssa Yesuusi sohuwara ba ayyaanan eridi, enttako, “Hinttee hintte wozanan ays hessada qoppeetii? <verse number="9" style="v"/>Gundda uraa, ‘Ne nagaray atto geetettis’ geyssi mateyye? Woykko, ‘Dendda eqqada ne alggaa tookkada ba’ geyssi matee? <verse number="10" style="v"/>Shin taw, Asa Na7aas, sa7a bolla nagara atto gaanaw maati de7eyssa hintte erana mela” gidi he gundda uraakko, <verse number="11" style="v"/>“Nena gays, dendda eqqada ne alggaa tookkada ne soo ba” yaagis.</para>
  <para style="p">
    <verse number="12" style="v"/>Uray ellesi denddi eqqidi, ba alggaa tookkidi asay ubbay be7ishin bis. Asay ubbay malaalettidi, “Nuuni hayssa mela malaalisiyabaa be7i erokko” yaagidi Xoossaa galatidosona.</para>
  <para style="s">Yesuusa Leewe xeegis</para>
  <para style="r">(<ref loc="MAT 9:9-13">Maato 9:9-13</ref>; <ref loc="LUK 5:27-32">Luuqa 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Yesuusi qassi Galiila Abbaa doona simmi bidi, baakko yida asa ubbaa tamaarssis. <verse number="14" style="v"/>Yaara aadhdhishe, Ilfiyoosa na7aa Leewe geetetteyssi qaraxa qanxisiya bessan uttidayssa be7idi, “Tana kaalla” yaagis. Leewey denddi eqqidi iya kaallis.</para>
  <para style="p">
    <verse number="15" style="v"/>Yesuusi kathi maanaw Leewe son uttis. Iya kaalliya asay daro gidiya gisho, qaraxa qanxisiya daro asaynne nagaranchchoti iyaranne iya tamaaretara issife uttidosona. <verse number="16" style="v"/>Higge astamaare gidida issi issi Farisaaweti Yesuusi nagaranchchotaranne qaraxa qanxiseyssatara kathi mishin be7idi, “I ays nagaranchchotaranne qaraxa qanxiseyssatara kathi mi?” yaagidi, iya tamaareta oychchidosona.</para>
  <para style="p">
    <verse number="17" style="v"/>Yesuusi entti geyssa si7idi, “Hargganchchotappe attin paxatas aakime koshshenna. Taani nagaranchchota xeeganaw yasippe attin xillota xeeganaw yabiikke” yaagidi enttaw zaaris.</para>
  <para style="s">Xoomabaa eranaw shiiqida oysha</para>
  <para style="r">(<ref loc="MAT 9:14-17">Maato 9:14-17</ref>; <ref loc="LUK 5:33-39">Luuqa 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v"/>Xammaqiya Yohaannisa tamaaretinne Farisaaweti xoomosona. Issi issi asati Yesuusakko yidi, “Yohaannisa tamaaretinne Farisaaweta tamaareti xoomosona, shin ne tamaareti ays xoomokkonaa?” yaagidosona.</para>
  <para style="p">
    <verse number="19" style="v"/>Yesuusi enttako, “Yaaganuwa yida asati machchiw ekkeyssi enttara de7ishin, xoomanaw dandda7onnaa? Machchiw ekkeyssi enttara de7ishin, xoomanaw dandda7okkona. <verse number="20" style="v"/>Shin machchiw ekkeyssi entta matappe ekettana wodey yaana, entti he wode xoomana.</para>
  <para style="p">
    <verse number="21" style="v"/>“Ceega ma7o bolla ooratha wothidi sikkiya asi baawa. Wothidi sikkiko, oorathay ceega ma7uwa daakkees; daakethaykka kaseyssafe darees. <verse number="22" style="v"/>Qassi mal7antto woyne ceega ogoron qoliya asi baawa. Shin qolikko, he woyney ogoruwa daakkees, bawukka gukkees, ogoroykka iitees. Shin mal77antto woyney ooratha ogoron qolettees” yaagis.</para>
  <para style="s">Sambbaatabaa eranaw shiiqida oysha</para>
  <para style="r">(<ref loc="MAT 12:1-8">Maato 12:1-8</ref>; <ref loc="LUK 6:1-5">Luuqa 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v"/>Yesuusi issi Sambbaata gallas bangga gade giddora aadhdhishin, iya tamaareti iyara bishe bangga tiya shirkkidi moosona.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref></char></note> <verse number="24" style="v"/>Farisaaweti Yesuusakko, “Hekko, ne tamaareti Sambbaata gallas woga gidonnabaa ays oothonna?” yaagidosona.</para>
  <para style="p">
    <verse number="25" style="v"/>Yesuusi enttako, “Dawitey koshattidi, miyabaa koyida wode, baara de7eyssatara oothidayssa nabbabibeekketii?<note caller="-" style="x"><char style="xo" closed="false">2:25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Saamu 21:1-6</ref></char></note> <verse number="26" style="v"/>Abiyaatari kahine halaqa gididi de7iya wode Dawitey Xoossa keethi gelidi, kahineta xalaali maanappe attin oonikka maanaw woga gidonnayssa Godaa sinthan wothida daabbuwa mis, baara de7eysstaskka immis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Leewe 24:9</ref></char></note></para>
  <para style="p">
    <verse number="27" style="v"/>Qassika Yesuusi enttako, “Sambbaati asa na7a go77as medhettisippe attin asi Sambbaatas medhettibeenna. <verse number="28" style="v"/>Hessa gisho, Asa Na7ay, hari attoshin Sambbaataskka Goda” yaagis.</para>
  <chapter number="3" style="c"/>
  <para style="s">Yesuusi kushe gundda uraa pathis</para>
  <para style="r">(<ref loc="MAT 12:9-14">Maato 12:9-14</ref>; <ref loc="LUK 6:6-11">Luuqa 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi Ayhude Woosa Keethi simmi gelis. Yan kushey gunddida issi uray de7ees. <verse number="2" style="v"/>Issi issi asay Yesuusa mootanaw koyidi, kushey gunddida uraa Sambbaata gallas I pathikonne aggiko be7anaw koyidi minthidi naagoosona. <verse number="3" style="v"/>Yesuusi kushey gunddida uraa, “Dendda eqqada ha sinthe ya” yaagis. <verse number="4" style="v"/>Hessafe guye, asaakko, “Sambbaata gallas lo77obaa ootheyssi wogeyye iitabaa ootheyssi wogee? Asa shemppo ashoyye woykko wodho?” yaagidi oychchis.</para>
  <para style="p">Shin asay si7i gis. <verse number="5" style="v"/>Yesuusi hanqettidi, entta yuushshi aathi xeellidi, entti odin si7onnayssata gidiya gisho, entta bolla daro azzanis. He addiyako, “Ne kushiya piddi ootha” yaagis. Uray piddi oothin iya kushey paxis. <verse number="6" style="v"/>Ellesidi Farisaaweti Ayhude Woosa Keethafe kare keyidi, Yesuusa waati wodhanekko maqettanaw, Heroodisa baggatara issi soo shiiqidosona.</para>
  <para style="s">Asay Yesuusakko shiiqidosona</para>
  <para style="p">
    <verse number="7" style="v"/>Yesuusi ba tamaaretara Galiila Abbaako bis. Galiilappenne Yihudappe yida daro asay iya kaallidosona. <verse number="8" style="v"/>Qassika Yerusalaameppe, Idumiyasappe, Yorddaanose Shaafa pinthafe, Xiiroosa katamaappenne Sidoona katamaappe Yesuusi oothidabaa si7idi, daro asay iyaakko yidosona. <verse number="9" style="v"/>Asaa darotethaafe denddoyssan iya un77ethonna mela iya tamaareti wogolo iyaw giigisana mela kiittis.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar 4:1</ref>; <ref loc="LUK 5:1-3">Luuqa 5:1-3</ref></char></note> <verse number="10" style="v"/>Daro asaa I pathida gisho, harggiya asay ubbay iya bochchanaw sugettoosona. <verse number="11" style="v"/>Tuna ayyaanay oykkida asati iya be7ida wode iya sinthan kunddidi, bantta qaala dhoqqu oothidi, “Neeni Xoossaa Na7aa gidikkii?” yaagosona.</para>
  <para style="p">
    <verse number="12" style="v"/>Yesuusi he tuna ayyaanati banatethaa oodeskka Qonccisonna mela entta minthidi hanqettis.</para>
  <para style="s">Yesuusi tammanne nam77u hawaareta dooris</para>
  <para style="r">(<ref loc="MAT 10:1-4">Maato 10:1-4</ref>; <ref loc="LUK 6:12-16">Luuqa 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Yesuusi deriya bolla keyidi, ba koyida asata baakko xeegis; enttika iyaakko bidosona. <verse number="14" style="v"/>Entti baara daana melanne qaala tamaarssana mela tammanne nam77ata dooridi, entta, “Hawaareta” <note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">Hawaare: </char><char style="ft" closed="false">Hawaare guussay kiitettidayssa guussu.</char></note> gidi sunthis. <verse number="15" style="v"/>Tuna ayyaanatakka kessana mela enttaw maata immis.</para>
  <para style="p">
    <verse number="16" style="v"/>I doorida tammanne nam77ati hayssata: Phexiroosa yaagidi sunthida Simoona, <verse number="17" style="v"/>Bo7anerggees (Dada daaniya asata) yaagidi sunthidayssata, Zabdiyoosa nayta Yayqoobanne Yayqooba ishaa Yohaannisa, <verse number="18" style="v"/>Inddiriyasa, Filiphphoosa, Bartolomiyoosa, Maatoosa, Toomasa, Ilfiyoosa na7a Yayqooba, Taadiyosa, ba biittaas mishettiya Simoonanne, <verse number="19" style="v"/>Yesuusa aathi immida Asqoroota Yihuda.</para>
  <para style="s">Yesuusanne Bi7elzebuula</para>
  <para style="r">(<ref loc="MAT 12:22-32">Maato 12:22-32</ref>; <ref loc="LUK 11:14-23">Luuqa 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v"/>Hessafe guye, Yesuusi soo bis. Qassi daro asay shiiqin, inne iya tamaareti hari attoshin kathi maanawukka dandda7ibookkona. <verse number="21" style="v"/>Asay iya, “Gooyees” giya gisho, iya dabboti hessa si7idi iya ekkanaw bidosona.</para>
  <para style="p">
    <verse number="22" style="v"/>Higge asttamaaretappe issoti issoti Yerusalaameppe yidi, “Iya bolla Bi7elzebuuli de7ees”, I, “Xalahey wolqqan tuna ayyaanata kessees” yaagidi odettidosona.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char></note></para>
  <para style="p">
    <verse number="23" style="v"/>Yesuusi asaa baakko xeegidi leemiso odis. “Xalahey Xalahe waati kessanaw dandda7ii? <verse number="24" style="v"/>Issi kawotethay ba giddon shaakettiko he kawotethay eqqanaw dandda7enna. <verse number="25" style="v"/>Hessadakka, issi keetha asay bantta giddon shaakettiko dhayanaappe attin daanaw dandda7okkona. <verse number="26" style="v"/>Hiza, Xalahey baara kacettidi shaakettiko dhayoppe attin daanaw dandda7enna.</para>
  <para style="p">
    <verse number="27" style="v"/>“Shin koyrottidi wolqqaama uraa qachchonna de7ishe iya keetha gelidi, iya miishiya bonqanaw dandda7iya asi baawa. Qachchi simmidi iya keetha bonqanaw dandda7ees.</para>
  <para style="p">
    <verse number="28" style="v"/>“Taani hinttew tuma odays; Xoossay asa naytas nagara ubbaanne entti cayaa cashshe ubbaa atto gaana. <verse number="29" style="v"/>Shin Geeshsha Ayyaana bolla iitabaa odettiya oodeskka merinaa nagara gidanaappe attin Xoossay ubbarakka iya maarenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luuqa 12:10</ref></char></note> <verse number="30" style="v"/>Yesuusi hessa giday, issi issi asati, “Iya bolla tuna ayyaanay de7ees” yaagida gishossa.</para>
  <para style="s">Yesuusa aayiwunne iya ishata</para>
  <para style="r">(<ref loc="MAT 12:46-50">Maato 12:46-50</ref>; <ref loc="LUK 8:19-21">Luuqa 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v"/>Iya aayiyanne iya ishati yidi karen eqqidi, iyaakko ase kiittidi iya xeegidosona. <verse number="32" style="v"/>Iya matan uttida daro asati, “Hekko, ne aayeranne ne ishatara karen eqqidi nena koyoosona” yaagidosona.</para>
  <para style="p">
    <verse number="33" style="v"/>Yesuusi zaaridi, “Ta aayiya oonee? Qassi ta ishati oonantee?” yaagis. <verse number="34" style="v"/>Ba matan uttida asa yuushshi aathi xeellidi, “Hekko, ta aayiyaanne ta ishati hayssata. <verse number="35" style="v"/>Xoossay sheniya oothiya ubbay ta isha, ta michchonne ta aayo” yaagis.</para>
  <chapter number="4" style="c"/>
  <para style="s">Zerethi zeriya uraa leemiso</para>
  <para style="r">(<ref loc="MAT 13:1-9">Maato 13:1-9</ref>; <ref loc="LUK 8:4-8">Luuqa 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi zaaridi Galiila Abbaa matan tamaarssees. Daro asay iya matan yuushuwan shiiqin, abban de7iya wogoluwa giddo gelidi uttis, asay ubbay Abbaa matan de7ees.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1">Luuqa 5:1</ref></char></note> <verse number="2" style="v"/>I entta darobaa leemison tamaarssis. Tamaarssishe hayssada yaagis:</para>
  <para style="p">
    <verse number="3" style="v"/>“Si7ite! Issi uray zerethi zeranaw keyis. <verse number="4" style="v"/>I zerishin, issi issi zerethay oge gaxan wodhdhis; kafoti yidi midosona. <verse number="5" style="v"/>Issi issi zerethay garssan shaalloy de7iya biitta bolla wodhdhis. Daro biitti baynna gisho, he zerethay ellesidi dolis. <verse number="6" style="v"/>Shin awi keyida wode shullis. Loythidi xapho yeddiboonna gisho, ellesi melis. <verse number="7" style="v"/>Issi issi zerethay aguntha giddon wodhdhis. Dolidayssa agunthay diccidi cuullida gisho ayfe ayfonna attis. <verse number="8" style="v"/>Issi issi zerethay aradda biittan wodhdhidi dolis. Diccidi issoy hasttama, issoy usuppun tamma issoy xeeta ayfis” yaagis. <verse number="9" style="v"/>“Si7iya haythi de7iya oonikka si7o” yaagis.</para>
  <para style="s">Yesuusi leemison odida gaasuwa</para>
  <para style="r">(<ref loc="MAT 13:10-17">Maato 13:10-17</ref>; <ref loc="LUK 8:9-10">Luuqa 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v"/>Yesuusi odidayssa si7ida issi issi asatinne tammanne nam77u tamaareti Yesuusi barkka de7ishin, iyaakko shiiqidi he leemisuwa birshshethaa oychchidosona. <verse number="11" style="v"/>Yesuusi enttako hayssada yaagis: “Hinttew Xoossaa kawotethaa xuuraa eroy imettis. Shin haratas kawotethaafe karen de7eyssatas ubbabay leemison odettees. <verse number="12" style="v"/>Gaasoykka,</para>
  <para style="q1">‘Entti xeellosona, shin demmokona.</para>
  <para style="q1">Si7oosona, shin akeekokkona.</para>
  <para style="q1">Entti demmiyakkonne akeekiyakko,</para>
  <para style="q2">Xoossaakko simmana</para>
  <para style="q2">ikka entta maaranashin’ ”</para>
  <para style="m">yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref></char></note></para>
  <para style="s">Zerethaa leemisuwa birshshethaa</para>
  <para style="r">(<ref loc="MAT 13:18-23">Maato 13:18-23</ref>; <ref loc="LUK 8:11-15">Luuqa 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Yesuusi enttako, “Ha leemisoy hinttew gelennee? Yaatin, leemiso ubbaa hintte waati akeekanee? <verse number="14" style="v"/>Zereyssi Xoossaa qaala zerees. <verse number="15" style="v"/>Qaalay zerettiya wode oge gaxan wodhdhidayssati qaala si7idayssata. Shin Xalahey sohuwara yidi, entta wozanan zerettida qaala maxi digees. <verse number="16" style="v"/>Hessadakka, garssan shaalloy de7iya biittan zerettidayssi qaala si7idi, ellesidi ufayssan ekkeyssa. <verse number="17" style="v"/>Shin iyaw mino xaphoy baynna gisho ha77issafe attin gam77okona. Guutha wodeppe guye qaala gaason waayey woykko goodi gakkiya wode ellesidi dhubettoosona. <verse number="18" style="v"/>Aguntha giddon zerettidayssi qaala si7eyssata. <verse number="19" style="v"/>Shin ha sa7a de7uwas hirggoy, duretethaa dosoynne harabaa amotteyssi iya wozanan gelidi qaala cuulliya gisho ayfe ayfonna attis. <verse number="20" style="v"/>Shin aradda biittan zerettidayssati qaala si7idi ekkeyssata. Entti issoy hasttama, issoy usuppun tamma issoy qassi xeeta ayfis” yaagis.</para>
  <para style="s">Geeman de7iya xomppe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luuqa 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Yesuusi gujjidi, “Xomppe ekkidi, daachchofe woykko alggafe garssan wothiya asi de7ii? Dhoqqa bessan wotheneyye?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Maato 5:15</ref>; <ref loc="LUK 11:33">Luuqa 11:33</ref></char></note> <verse number="22" style="v"/>Hiza, qosettidabay ubbay qoncce keyana; geemmidabay ubbay erettonna attenna.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Maato 10:26</ref>; <ref loc="LUK 12:2">Luuqa 12:2</ref></char></note> <verse number="23" style="v"/>Si7iya haythi de7iya oonikka si7o” yaagis.</para>
  <para style="p">
    <verse number="24" style="v"/>Qassi enttako, “Hintte si7iyabaa akeekidi si7ite! Xoossaa qaala hintte si7eyssa mela I hinttew akeeka immana. Ubbaka hinttew darssidi immana. <verse number="25" style="v"/>Issibay de7iya uraas gujji imettana, baynnaysafe hari attoshin, iyaw de7iya he guuthiyaka ekettana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Maato 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luuqa 19:26</ref></char></note></para>
  <para style="s">Dicciya zerethaa leemiso</para>
  <para style="p">
    <verse number="26" style="v"/>Yesuusi zaaridi, “Xoossaa kawotethay ba gaden zerethi zeriya asa mela. <verse number="27" style="v"/>He uray qamma dhiskkees; wontta denddees. I ba huu7en waaniyakko eronna de7ishin he zerethay doleesinne diccees. <verse number="28" style="v"/>Biittay kathi barkka immees. Koyro dolidi diccees, kaallidi ayfanaw gambbuxees, wurssethan kumetha ayfe ayfees. <verse number="29" style="v"/>Shin kathay gakkiya wode uray sohuwara baacara geli aggees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false">Iyu 3:13</char></note></para>
  <para style="s">Ayfe guutha mithaa leemiso</para>
  <para style="r">(<ref loc="MAT 13:31-34">Maato 13:31-34</ref>; <ref loc="LUK 13:18-19">Luuqa 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Yesuusi, “Nuuni Xoossaa kawotethaa ay daanees gaanee? Woykko aybira leemisanee? <verse number="31" style="v"/>Xoossaa kawotethay ayfe guutha mithi daanees. He mithaa ayfiyaa zeriya wode sa7an de7iya mitha ayfe ubbaafe guuxees. <verse number="32" style="v"/>Zerin dolidi atakiltte ubbaafe gitatees; daro daashshi daayees. Kafoti iya tashiya bolla keexidi uttana gakkanaw dayees” yaagis.</para>
  <para style="p">
    <verse number="33" style="v"/>Yesuusi hayssa mela daro leemison asay akeekanaw dandda7eyssa mela qaala odis. <verse number="34" style="v"/>Asaas leemisoy baynna odenna. Shin Yesuusi ba tamaareta xalaalara de7iya wode, enttaw ubbabaa birshshidi odis.</para>
  <para style="s">Yesuusi hobbiya si7i oothis</para>
  <para style="r">(<ref loc="MAT 8:23-27">Maato 8:23-27</ref>; <ref loc="LUK 8:22-25">Luuqa 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>He gallas sa7ay omarssin, Yesuusi ba tamaaretakko, “Abbaafe hefinthi pinnoos” yaagis. <verse number="36" style="v"/>Iya tamaareti daro asa yeggi aggidi, Yesuusi kase geli uttida wogoluwan gelidi Yesuusa banttara efidosona. Hara wogolotikka yan de7oosona. <verse number="37" style="v"/>Wolqqaama gotey denddidi, hobbey wogoluwa shocin, kumana gakkanaw wogoluwa giddo haathi gelis. <verse number="38" style="v"/>He wode Yesuusi wogoluwan guye baggara borkkottidi dhiskkis. Iya tamaareti iya denthidi, “Asttamaariyaw, nuuni dhayiya wode ne si7i gada xeellay?” yaagidosona.</para>
  <para style="p">
    <verse number="39" style="v"/>Yaatin, I barkkidi gotiya, “Si7i ga” gidi, abbaaka, “Woppu ga” gis. Goteykka si7i gin ubbabay woppu gis. <verse number="40" style="v"/>Yesuusi ba tamaaretakko, “Ays hayssada babbetii? Hinttew ammanoy waanidi dhayide?” yaagis.</para>
  <para style="p">
    <verse number="41" style="v"/>Entti daro babbidi bantta giddon, “Hayssi hari attoshin, goteynne abbay kiitetteyssi oonee?” yaagidosona.</para>
  <chapter number="5" style="c"/>
  <para style="s">Tuna ayyaani oykkida uray paxis</para>
  <para style="r">(<ref loc="MAT 8:28-34">Maato 8:28-34</ref>; <ref loc="LUK 8:26-39">Luuqa 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusinne iya tamaareti abbaa pinnidi, Gerggesoone giya biittaa gakkidosona. <verse number="2" style="v"/>Yesuusi wogoluwappe wodhdhiya wode tuna ayyaanay oykkida issi uray duufoppe keyidi iyara gahettis. <verse number="3" style="v"/>He uray duufuwan aqi pee7idi de7ees. Iya oonikka santhalaatan qachchanaw dandda7enna. <verse number="4" style="v"/>I daro toho duthaninne santhalaatan qashettidi de7ees. Shin santhalaata duuserethees, duthaa mentherethees. Iya teqqanaw dandda7iya oonikka baawa. <verse number="5" style="v"/>I qammanne gallas he duufuwaninne dere bolla waasses, ba bollaaka shuchchan gaarees.</para>
  <para style="p">
    <verse number="6" style="v"/>Yesuusa haahon be7ida wode woxxi bidi iya sinthan gulbbatis. <verse number="7" style="v"/>He uray ba qaala dhoqqu oothidi, “Ubbaafe Bolla Xoossaa Na7aw Yesuusa, nenanne tana aybe gathey? Tana dhayssona mela taani nena Xoossaa sunthan woossays” yaagis. <verse number="8" style="v"/>I hessa giday Yesuusi iya, “La ha tuna ayyaanaw, ha addiyafe keya” yaagida gishossa.</para>
  <para style="p">
    <verse number="9" style="v"/>Yesuusi iyaakko, “Ne sunthay oonee?” yaagidi oychchis.</para>
  <para style="p">I, “Nuuni daro gidiya gisho, ta sunthay Leegiyona” yaagis. <verse number="10" style="v"/>Tuna ayyaanati bantana he biittaafe kessi yeddonna mela Yesuusa minthidi woossidosona.</para>
  <para style="p">
    <verse number="11" style="v"/>He deriya bolla daro guduntho wudey hamuttees. <verse number="12" style="v"/>Tuna ayyaanati Yesuusakko, “Nuna hini guduntho wudiyakko yeddarkki, enttan bidi geloos” yaagidi woossidosona. <verse number="13" style="v"/>Yesuusi enttako, “Biite” yaagis. Yaatin tuna ayyaanati addiyafe keyidi gudunthotan gelidosona. Nam77u mukulu gidiya guduntho wudey aafo doonara dirggidi bidi abban gelidi mitettidosona.</para>
  <para style="p">
    <verse number="14" style="v"/>Guduntho wudiya heemmeyssati baqati bidi hanidabaa katamaaninne gaxariyan odidosona. Yaatin asay hanidabaa be7anaw keyidosona. <verse number="15" style="v"/>Asay Yesuusakko yaa wode tuna ayyaanan oykettida uraa be7idosona. I ba wozanaakko simmidi, ma7o ma7idi, yan uttidayssa be7ida wode ubbay yayyidosona. <verse number="16" style="v"/>Hessa be7ida asati tuna ayyaanati oykkida uraa bollanne gudunthota bolla hanidabaa ubbaa asaas odidosona. <verse number="17" style="v"/>Hessa gisho, asay bantta biittaafe Yesuusi baana mela woossidosona.</para>
  <para style="p">
    <verse number="18" style="v"/>Yesuusi wogoluwan geliya wode kase tuna ayyaanati oykkidi yeddida uray,, Yesuusa kaallanaw iya woossis. <verse number="19" style="v"/>Shin Yesuusi ixxidi iyaakko, “Ne soo simmada, Goday new ay mela gitabaa oothidakkonne new ay mela keehidakko ne soo asaas oda” yaagis. <verse number="20" style="v"/>Uray bidi Tammu Katamata giyason yuuyidi, Yesuusi baw ay mela gitabaa oothidaakko odis. I odidayssa si7ida asa ubbay malaalettidosona.</para>
  <para style="s">Hayqida na7iwunne Yesuusa ma7uwa bochchida maccasiw</para>
  <para style="r">(<ref loc="MAT 9:18-26">Maato 9:18-26</ref>; <ref loc="LUK 8:40-56">Luuqa 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Yesuusi simmidi, wogoluwan gelidi, abbaa pinnidaappe guye daro asay abbaa gaxan iya yuushuwan shiiqidosona. <verse number="22" style="v"/>Iyaroosa giya Ayhude Woosa Keetha halaqatappe issoy, Yesuusa be7ida wode iyaakko yidi iya tohuwa bolla <verse number="23" style="v"/>kunddidi, “Ta na7iya harggada hayqqana hanawsu. Iya paxada de7ana mela yada ne kushiya I bolla wotharkkii” yaagidi Yesuusa minthidi woossis.</para>
  <para style="p">
    <verse number="24" style="v"/>Yesuusi Iyaroosara bis. I bishin daro asay iya kaallidi un77ethidosona.</para>
  <para style="p">
    <verse number="25" style="v"/>Tammanne nam77u laythi I bollaafe suuthi goggiya issi maccasiya de7awusu. <verse number="26" style="v"/>Daro aakimeti iyo aakimidosona, shin iya paxa kaa7ettasu. Iya ba miishiya ubbaa wurssinkka iw haa iitisppe attin aykkoka maaddibeenna. <verse number="27" style="v"/>He maccasiya Yesuusabaa si7ada, asaa kanthada Yesuusa guyera yada iya ma7uwa bochchasu. <verse number="28" style="v"/>Iya, “Taani hari attoshin iya ma7uwa bochchiyakko paxana” gada qoppasu.</para>
  <para style="p">
    <verse number="29" style="v"/>Iippe goggiya suuthay sohuwara eqi aggis. Iya ba waayappe paxidayssa ba asatethan erasu. <verse number="30" style="v"/>Yesuusi baappe wolqqi keyidayssa ba huu7en eridi, ellesidi daro asa giddon guye simmidi, “Ta ma7uwa bochchiday oonee?” yaagis.</para>
  <para style="p">
    <verse number="31" style="v"/>Iya tamaareti, “Asay nena sugeyssa be7ashe, ‘Woygada tana oone bochchiday yaagay?’ ” yaagidosona.</para>
  <para style="p">
    <verse number="32" style="v"/>Yesuusi hessa ooni oothidaakko be7anaw yuushshi aathi xeellis. <verse number="33" style="v"/>Shin maccasiya baw hanidabaa erada, yashshan kokkorashe yada Yesuusa sinthan gufannasu; qassi hanidabaa ubbaa tumaa iyaw odasu. <verse number="34" style="v"/>Yaanin, Yesuusi iikko, “Ta naatte, nena ne ammanoy pathis, saron ba, ne waayiyappeka paxa” yaagis.</para>
  <para style="p">
    <verse number="35" style="v"/>Yesuusi buroo hessa odishin, Ayhude Woosa Keetha halaqaa sooppe kiitettida asati yidi, “Ne na7iya hayqqasu, asttamaariya ays daaburissay?” yaagidosona.</para>
  <para style="p">
    <verse number="36" style="v"/>Shin Yesuusi entti geyssa si7idi, Ayhude Woosa Keetha halaqaakko, “Ammano xalaala ammanappe attin babbofa” yaagis. <verse number="37" style="v"/>Yesuusi Phexiroosappe, Yayqoobappenne Yayqooba ishaa Yohaannisappe hari oonikka bana kaallonna mela diggis. <verse number="38" style="v"/>Entti Ayhude Woosa Keetha halaqaa soo gakkiya wode Yesuusi asay kaha dhayidi yeekkeyssanne zeeleleyssa be7is. <verse number="39" style="v"/>Gelidi asaakko, “Ays kaha dhayidi yeekketii? Na7iya dhiskkasuppe attin hayqqabuukku” yaagis.</para>
  <para style="p">
    <verse number="40" style="v"/>Asay iya bolla miiccis. Shin asa ubbaa kare kessidi, na7ee aawa, aayyiwunne heedzu tamaareta baara ekkidi na7iya de7iyasuwa gelis. <verse number="41" style="v"/>Yesuusi na7ee kushiya oykkidi, “Xaalita, quumi” (Guutha naatte, nena gays dendda) yaagis.</para>
  <para style="p">
    <verse number="42" style="v"/>Na7iya sohuwara dendda eqqada hamuttasu. Iya tammanne nam77u laytha na7a. Hessan asay daro malaalettidosona. <verse number="43" style="v"/>Yesuusi hessa entti oodeskka odonna mela entta minthi kiittis. Entti iw miyabaa immana mela odis.</para>
  <chapter number="6" style="c"/>
  <para style="s">Yesuusi Naazireten ixettis</para>
  <para style="r">(<ref loc="MAT 13:53-58">Maato 13:53-58</ref>; <ref loc="LUK 4:16-30">Luuqa 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi yaappe keyidi, ba tamaareta kaalethidi, ba katama Naazirete bis. <verse number="2" style="v"/>Sambbaata gallas Ayhude Woosa Keethan tamaarsso oykkis. I tamaarsseyssa si7ida daro asay malaalettidi, “Hayssi ha ubbaa awuppe demmide? Ha cinccatethaa I awuppe ekkidee? Ha malaatata oothiya maata I awuppe demmide? <verse number="3" style="v"/>Hayssi anaaxiya gidennee? Mayraami na7a, Yayqooba, Yoosa, Yihudanne Simoona ishaa gidenneyye? Iya michcheti nuura hayssan de7okkonayye?” yaagidi, I giyabaa ekkonna ixxidosona.</para>
  <para style="p">
    <verse number="4" style="v"/>Yesuusi he asaakko, “Nabey ba biittan, ba dabbotaninne ba soo asan bonchchettennafe attin harata matan bonchchettees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">Yoha 4:43</ref></char></note> <verse number="5" style="v"/>I he bessan ba kushiya guutha asaa bolla wothidi pathidayssafe attin hara malaatata oothanaw dandda7ibeenna. <verse number="6" style="v"/>Asay ammaniboonna gisho daro malaalettis.</para>
  <para style="s">Yesuusi tammanne nam77u hawaareta kiittis</para>
  <para style="r">(<ref loc="MAT 10:5-15">Maato 10:5-15</ref>; <ref loc="LUK 9:1-6">Luuqa 9:1-6</ref>)</para>
  <para style="p">Hessafe guye, Yesuusi he heeran de7iya gutatan asaa tamaarssees. <verse number="7" style="v"/>Yesuusi tammanne nam77u tamaareta baakko xeegidi, nam77aa nam77aa gathidi kiittis. Enttaw tuna ayyaanata kessiya wolqqaa immis. <verse number="8" style="v"/>Entta, “Oge xam77afe attin kathi, karxiita, hintte kiisen miishe aybibaakka oykkofite.<note caller="-" style="x"><char style="xo" closed="false">6:8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luuqa 10:4-11</ref></char></note> <verse number="9" style="v"/>Hintte tohuwan caamma aathite, shin nam77u afila oykkofite” yaagis. <verse number="10" style="v"/>Qassika, “Hinttena asi mokkida soo awunkka gidin he bessaa yeddidi baana gakkanaw he keethan gam77ite. <verse number="11" style="v"/>Hinttena asi mokkonnasuwa woykko hintte odiyabaa si7onnasuwa aw gidikkoka, he biittan de7iya asaas hessi naagiso markka gidana mela he bessaafe keyishe, hintte tohuwappe baana pittite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Ha@O 13:51</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Tammanne nam77u tamaareti bidi, asay bantta nagaraappe simmanaada qaala odidosona. <verse number="13" style="v"/>Entti asappe daro tuna Ayyaanata kessidosona. Daro hargganchchota zayte tiyidi pathidosona.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yay 5:14</ref></char></note></para>
  <para style="s">Xammaqiya Yohaannisa hayquwa</para>
  <para style="r">(<ref loc="MAT 14:1-12">Maato 14:1-12</ref>; <ref loc="LUK 9:7-9">Luuqa 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Yesuusa sunthay ubba bessan keyida gisho, Kawoy Heroodisi iyabaa si7is. Issi issi asay, “Xammaqiya Yohaannisi hayqoppe denddis, hessa gisho ha malaatata oothey iya” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Maato 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luuqa 9:19</ref></char></note></para>
  <para style="p">
    <verse number="15" style="v"/>Baggati, “Hayssi Eliyaasa gidennee?” yaagidosona.</para>
  <para style="p">Harati qassi, “Hayssi beni wode nabetapp issuwa gidonna aggenna” yaagidosona.</para>
  <para style="p">
    <verse number="16" style="v"/>Shin Heroodisi hessa si7ida wode, “Hayssi taani qoodhiya qanxisida Xammaqiya Yohaannisa gidennee? I hayqoppe denddis” yaagis.</para>
  <para style="p">
    <verse number="17" style="v"/>Heroodisi ba ishaa Filiphphoosa machchiw Herodiyada ekkida gisho I gaason Yohaannisa oythidi qashisis. <verse number="18" style="v"/>Yohaannisi Heroodisa, “Neeni ne ishaa machchiw ekkanaw bessenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:17-18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luuqa 3:19-20</ref></char></note></para>
  <para style="p">
    <verse number="19" style="v"/>Herodiyada Yohaannisa ba ulon morkkada iya wodhisanaw koyasu, shin dandda7abukku. <verse number="20" style="v"/>Yohaannisi xillonne geeshsha asi gididayssa Heroodisi erida gisho, iyaw babbidi loythi naagisees. Heroodisi Yohaannisi giyabaa si7anaw dosikkoka I giyabaa si7iya wode daro dagammees.</para>
  <para style="p">
    <verse number="21" style="v"/>Heroodisi ba yelettida gallasa bonchchanaw deriya haareyssatas, shaalaqatasinne Galiilan de7iya gita asaas imato giigisis. Hessi Herodiyadas injje gallas gidis. <verse number="22" style="v"/>Herodiyada na7iya imathay mokettiya bessan gela durada, Herodisanne iya imathata ufayssasu. Kawoy na7iw, “Ne koyabaa aybaa gidikkoka tana oychcha, taani new immana” yaagis. <verse number="23" style="v"/>Qassi iw caaqqidi, “Neeni oychchiyabaa aybaa gidikkoka, taani new immana. Hari attoshin, ta kawotethaa baggaa gidikkoka taani new immana” yaagis.</para>
  <para style="p">
    <verse number="24" style="v"/>Na7iya kare keyada ba aayeekko, “Ay imma go?” gada oychchasu.</para>
  <para style="p">I aayiya, “Xammaqiya Yohaannisa huu7iya imma ga” yaagasu.</para>
  <para style="p">
    <verse number="25" style="v"/>Na7iya ellasada kawuwakko bada, “Xammaqiya Yohaannisa huu7iya keren wothada ha77i taw immana mela koyays” yaagasu.</para>
  <para style="p">
    <verse number="26" style="v"/>Yaanin Kawoy daro qiirottis, shin ba imathata gisho iw caaqqida ba caaquwa menthanaw koyibeenna. <verse number="27" style="v"/>Hessa gisho, ellesidi naageyssa Yohaannisa huu7iya ehana mela kiittis. Naageyssi qasho keethi bidi Yohaannisa qoodhiya qanxis. <verse number="28" style="v"/>He qanxettida huu7iya saanen wothi ehidi na7ees immis. Na7iya qassi ba aayes immasu. <verse number="29" style="v"/>Yohaannisa tamaareti hessa si7ida wode bidi iya ahaa ekki efidi moogidosona.</para>
  <para style="s">Yesuusi ichchashu mukulu asa muzis</para>
  <para style="r">(<ref loc="MAT 14:13-21">Maato 14:13-21</ref>; <ref loc="LUK 9:10-17">Luuqa 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Tammanne nam77u hawaareti simmi yidi entti oothidabaanne tamaarssidabaa ubbaa Yesuusas odidosona. <verse number="31" style="v"/>Enttako yaa asaynne biya asay darida gisho, Yesuusaranne iya tamaaretara, hari attoshin kathi maanawukka entta gathonna ixxis. Yaanin, Yesuusi enttako, “Nurkka guuthi shemppi ekkanaw asi baynna bessi yedhdhite” yaagis. <verse number="32" style="v"/>Hessa gisho, entti banttarkka wogolon gelidi asi baynna bessi bidosona.</para>
  <para style="p">
    <verse number="33" style="v"/>Entti bishin daro asay entta be7idi eridosona. Yaatin, katama ubbaafe asay tohora woxxi bidi entti biyasuwa enttafe sinthe gakkidosona. <verse number="34" style="v"/>Yesuusi wogoluwappe wodhdhidi daro asa be7is. Asay heemmiya asi baynna dorssa mela gididayssa be7idi enttaw qadhettidi entta darobaa tamaarssis.<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Tay 27:17</ref>; <ref loc="1KI 22:17">1Kawo 22:17</ref>; <ref loc="2CH 18:16">2Taari 18:16</ref>; <ref loc="EZK 34:5">Hiz 34:5</ref>; <ref loc="MAT 9:36">Maato 9:36</ref></char></note></para>
  <para style="p">
    <verse number="35" style="v"/>Sa7ay omarssiya wode Yesuusa tamaareti iyaakko yidi, “Hayssi bessay asi baynna bessi; ha77i sa7aykka qammis. <verse number="36" style="v"/>Asay gutatanne katamata bidi bantaw miyabaa shammana mela asa yedda” yaagidosona.</para>
  <para style="p">
    <verse number="37" style="v"/>Shin Yesuusi zaaridi enttako, “Asaas miyabaa hintte immite” yaagis.</para>
  <para style="p">Entti, “Nuuni bidi nam77u xeetu dinaaren uythu shammidi asaa muzana mela koyay?” yaagidi oychchidosona.</para>
  <para style="p">
    <verse number="38" style="v"/>Yesuusi enttako, “Hinttew aappun uythi de7ii? Ane bidi be7ite” yaagis.</para>
  <para style="p">Entti be7idi, “Ichchashu uythunne nam77u molo” yaagidosona.</para>
  <para style="p">
    <verse number="39" style="v"/>Yesuusi ba tamaareta asa ubbaa cugen cugen shaakkidi maatan utisana mela kiittis. <verse number="40" style="v"/>Asay xeetu cugeninne ishatamu cugen shaaketti shaaketti uttidosona. <verse number="41" style="v"/>Yesuusi ichchashu uythaanne nam77u molota ekkidi, pude salo xeellidi Xoossaa galatis. Uythaa menthidi asaas gishana mela ba tamaaretas immis. Qassi nam77u molota entta ubbaas shaakkis. <verse number="42" style="v"/>Asa ubbay midi kallidosona. <verse number="43" style="v"/>Attida uytha tiifiyanne molota tiifiya, iya tamaareti tammanne nam77u gayta kumethi denthidosona. <verse number="44" style="v"/>Uythaa mida adde asaa tayboy ichchashu mukulu.</para>
  <para style="s">Yesuusi abbaa bollara hamuttis</para>
  <para style="r">(<ref loc="MAT 14:22-33">Maato 14:22-33</ref>; <ref loc="JHN 6:15-21">Yoha 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v"/>Ellesidi Yesuusi ba tamaareti wogoluwan gelidi, abbaafe hefinthan de7iya Beetesayda baappe sinthattidi baana mela kiittis. Shin baw asaa moyzanaw guye attis. <verse number="46" style="v"/>Asaa moyzidaappe guye, Xoossaa woossanaw deriya bolla keyis.</para>
  <para style="p">
    <verse number="47" style="v"/>Sa7ay qammiya wode wogoloy abbaa giddon de7ees, shin Yesuusi abbaafe gaxan barkka de7ees. <verse number="48" style="v"/>Carkkoy iya tamaaretakko carkkiya gisho, abbaa pidhoy waayseyssa Yesuusi be7is. Wonttimaathe sa7ay geeyana haniya wode I abbaa bolla hamuttishe enttako yidi, entta yeggidi aadhdhanaw koyis. <verse number="49" style="v"/>Shin I abbaa bolla hamuttishin, entti be7idi, enttaw moytille daanin waassidosona. <verse number="50" style="v"/>Entti ubbay iya be7idi, yashshan kokkoridosona.</para>
  <para style="p">Shin Yesuusi ellesidi enttako, “Tana, aykkoy baawa; yayyofite” yaagis. <verse number="51" style="v"/>Yesuusi wogoluwan gelidi enttara issife uttin carkkoy woppu gis. Entti daro malaalettidosona. <verse number="52" style="v"/>Entta wozanay zel77umida gisho, entti uythabaa akeekibookkona.</para>
  <para style="s">Yesuusi Gensareexen hargganchota pathis</para>
  <para style="r">(<ref loc="MAT 14:34-36">Maato 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v"/>Entti abbaa pinnidi, Gensareexe giya biittaa gakkidi, wogoluwa gaxa shiishidi qachchidosona. <verse number="54" style="v"/>Entti wogoluwappe wodhdhiya wode asay ellesidi Yesuusa eridosona. <verse number="55" style="v"/>Entti heeran de7iya biitta ubban woxerettidi hargganchchota halan tookkidi, “Yesuusi de7ees” gin si7ida bessaa ehidosona. <verse number="56" style="v"/>Asay I bida soo ubban, gaxariyan gidin, kataman, de7iya hargganchchota dabaaba efoosona. Hargganchchoti iya afilaa macaraa gidikkoka bochchana mela asay iya woossidosona. Bochchida ubbay paxis.</para>
  <chapter number="7" style="c"/>
  <para style="s">Beni aawata wogaa</para>
  <para style="r">(<ref loc="MAT 15:1-9">Maato 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yerusalaameppe yida guutha Farisaawetinne higge asttamaareti Yesuusa matan shiiqidosona. <verse number="2" style="v"/>Yesuusa tamaaretappe issoti issoti geeyonna kushiyan, hessika kushe meecettonna kathi meyssata be7idosona.</para>
  <para style="p">
    <verse number="3" style="v"/>Farisaawetinne Ayhude asay ubbay bantta aawata wogaatho bantta kushiya meecettonna mokkonna. <verse number="4" style="v"/>Hessadakka, entti giyappe shamettidabaa meecconna de7ishe mokkonna. Qassi entti bantta aawatappe ekkida hara daro wogi de7ees: Hessika siniya, keriya, biraata miishetanne arssaa meecciya wogaa naageyssa.</para>
  <para style="p">
    <verse number="5" style="v"/>Farisaawetinne higge asttamaareti Yesuusa, “Ne tamaareti ays aawata wogaa menthidi bantta kushiya meecettonna kathi moonna?” yaagidi oychchidosona.</para>
  <para style="p">
    <verse number="6" style="v"/>Yesuusi enttako, “Isayaasi hinttena cubbota,</para>
  <para style="q1">‘Hayssi asay tana ba inxarssa xalaalan bonchchees,</para>
  <para style="q2">shin entta wozanay taappe haahon de7ees.<note caller="-" style="x"><char style="xo" closed="false">7:6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29:13</ref></char></note></para>
  <para style="q1">
    <verse number="7" style="v"/>Asi medhdhida wogaa Xoossaa higge daanisidi tamaarssiya gisho,</para>
  <para style="q2">entti taw mela goynnosona’ ”</para>
  <para style="m">gidi xaafidayssi tuma.</para>
  <para style="p">
    <verse number="8" style="v"/>“Hintte Xoossaa kiitaa aggidi asa wogaa minthidi naageeta” yaagis.</para>
  <para style="p">
    <verse number="9" style="v"/>Qassika Yesuusi, “Hinttee hintte wogaa naagidi Xoossaa kiitaa yeggi agganaw lo77o oge demmideta. <verse number="10" style="v"/>Musey, ‘Ne aawanne ne aayiw bonchcha’, qassi ‘Ba aawanne ba aayiw cayeyssi hayqqanaw bessees’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>; <ref loc="EXO 21:17">Kessa 21:17</ref>; <ref loc="LEV 20:9">Leewe 20:9</ref></char></note> <verse number="11" style="v"/>Shin issi asi ba aawa woykko ba aayiw maaddanayssa aggidi, ‘Hessi Xoossaa yarshsho’ giikko, <verse number="12" style="v"/>I ba aawa woykko ba aayiw maaddonna mela ootheeta. <verse number="13" style="v"/>Hessadakka, hintte harata tamaarssida hintte wogan Xoossaa qaala kadhideta. Hessa mela hara darobaa ootheeta” yaagis.</para>
  <para style="s">Ase tunisiyabata</para>
  <para style="r">(<ref loc="MAT 15:10-20">Maato 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Yesuusi daro asaa qassika baakko xeegidi, “Ubbay taani odeyssa si7itenne akeekite. <verse number="15" style="v"/>Asa wozanappe keyaabay ase tuniseesippe attin kareppe asa ulo gelidi ase tunisiyabay aybikka baawa. <verse number="16" style="v"/>Si7iya haythi de7iya oonikka si7o” yaagis.</para>
  <para style="p">
    <verse number="17" style="v"/>Yesuusi daro asaa yeggi aggidi soo gelin iya tamaareti he leemisuwabaa iya oychchidosona. <verse number="18" style="v"/>I enttako, “Hinttewuka qassi gelibeennee? Kareppe asa wozanan geliyabay aybikka ase tunisanaw dandda7onnayssa akeeketii? <verse number="19" style="v"/>Ays giikko, kathi asa ulo giddo gelidi kanthidi aadhdheesippe attin asa wozana giddo gelenna” yaagis. Hessan Yesuusi kathi ubbay geeshshi gideyssa erisis.</para>
  <para style="p">
    <verse number="20" style="v"/>Kaallidikka, Yesuusi, “Asa tunisiyabay asa wozana giddofe keyaabaa. <verse number="21" style="v"/>Asa wozana giddofe keyaabay iita qofa, laymatethi, kayso, ase wodho, laame, <verse number="22" style="v"/>iita amo, iitatethi, gene, qayxe, cimo, qanaate, cashshe, otoronne boozatethi. <verse number="23" style="v"/>Ha iitabay ubbayka asa wozana giddofe keyidi ase tunisees” yaagis.</para>
  <para style="s">Issi maccase ammanuwa</para>
  <para style="r">(<ref loc="MAT 15:21-28">Maato 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v"/>Yesuusi yaappe keyidi, Xiiroosa katama matan de7iya biittaa bis. I issi keethi gelidi yan de7eyssa oonikka erana mela koyibeenna. Shin qosettidi gam77anaw dandda7ibeenna. <verse number="25" style="v"/>Shin I guutha na7iw tuna ayyaanay oykkida issi maccasiya Yesuusabaa si7ada ellesa iyaakko yada iya tohuwa bolla kunddasu. <verse number="26" style="v"/>Iya Ayhude maccasi gidukku; iya yelettiday Siroofinqe giya biittana. Iya, ba na7eeppe tuna ayyaanaa kessana mela Yesuusa woossasu.</para>
  <para style="p">
    <verse number="27" style="v"/>Shin Yesuusi zaaridi, “Nayti koyrottidi kathaa kallo; nayta kathaa ekkidi kanatas yeggeyssi lo77o gidenna” yaagis.</para>
  <para style="p">
    <verse number="28" style="v"/>Maccasiya zaarada, “Ta Godaw hessi tuma, shin gaytaa matan de7iya kanati naytappe wodhdhiya tiifiya moosona” yaagasu.</para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi qassi iikko, “Ha ne qaala gisho, ne soo ba; tuna ayyaanay ne na7eeppe keys” yaagis.</para>
  <para style="p">
    <verse number="30" style="v"/>Maccasiya ba soo biya wode tuna ayyaanay iippe keyin hiixan zin77idaaro demmasu.</para>
  <para style="s">Yesuusi tullenne muume uraa pathis</para>
  <para style="p">
    <verse number="31" style="v"/>Yesuusi Xiiroosa katamatappe keyidi, Sidoonaranne Tammu Katamata giya biittaara kanthidi Galiila Abbaako bis. <verse number="32" style="v"/>Asay tullenne waayidi odettiya asi Yesuusakko ehidi, ba kushiya iya bolla wothana mela iya woossidosona. <verse number="33" style="v"/>Yesuusi barkka he uraa daro asappe gaxa kessidi, ba biradhdhiya iya haythan yeddis. Qassi cuchchi cuttidi iya inxarssaa bochchis. <verse number="34" style="v"/>Salo pude xeellidi, tooki shemppidi, “Eftah” gis. Birshshethaykka “Dooyetta” guussu. <verse number="35" style="v"/>Uraa haythay ellesidi dooyettis, qashettida inxarssaykka birshshettis, uray geeshshidi odettis.</para>
  <para style="p">
    <verse number="36" style="v"/>Yesuusi asa ubbaas, “Hayssa oodeskka odoppite” yaagis. Shin I daro minthidi odoppite gin, asay odaa yaa darssis. <verse number="37" style="v"/>Hessa si7ida asay ubbay daro malaalettidi, “Ubbabaa I loythi oothees. Hari attoshin, tulliya sissees, muumiya odisees” yaagidosona.</para>
  <chapter number="8" style="c"/>
  <para style="s">Yesuusi oyddu mukulu asa muzis</para>
  <para style="r">(<ref loc="MAT 15:32-39">Maato 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Guutha wodeppe guye, daro asay Yesuusakko shiiqidosona. Asaas miyabay dhayin Yesuusi ba tamaareta baakko xeegidi, <verse number="2" style="v"/>“Ha asay taara heedzu gallas gakkanaw gam77idi, aykkoka miyabaa demmiboonna gisho, tana asay qadhethees. <verse number="3" style="v"/>Taani asaa koshara soo yeddiko asay bishe ogen daaburidi kunddana, bagga asay haahosoppe yidosona” yaagis.</para>
  <para style="p">
    <verse number="4" style="v"/>Yesuusa tamaareti zaaridi, “Ha bazzo biittan ha asa ubbaa muzanaw gidiya kathi demmanaw dandda7ey oonee?” yaagidosona.</para>
  <para style="p">
    <verse number="5" style="v"/>Yesuusi enttako, “Hinttew aappun uythi de7ii?” yaagidi oychchis.</para>
  <para style="p">Entti zaaridi, “Laappun uythi de7ees” yaagidosona.</para>
  <para style="p">
    <verse number="6" style="v"/>Yesuusi asay sa7an uttana mela kiittis. Yaatidi, laappun uythaa ekkidi Xoossaa galati simmidi he uythaa menthidi, asaas gishana mela ba tamaaretas immis. Iya tamaareti asaas gishidosona. <verse number="7" style="v"/>Enttaw qassi guutha laafa moloti de7oosona. Yesuusi he molota gisho Xoossaa galatidi, asaas gishana mela ba tamaareta kiittis. <verse number="8" style="v"/>Asay ubbay midi kallidosona. Iya tamaareti attida tiifiya laappun gayta kumethi denthidosona. <verse number="9" style="v"/>Kathaa mida asaa tayboy oyddu mukulu gidana. Hessafe guye, Yesuusi asa yeddis. <verse number="10" style="v"/>I qassi ba tamaaretara ellesi wogolon gelidi Dalmmanuta giya biittaa bis.</para>
  <para style="s">Malaati oosettana mela oychchidosona</para>
  <para style="r">(<ref loc="MAT 16:1-4">Maato 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v"/>Farisaaweti yidi Yesuusa paaccanaw koyidi, saloppe banttana malaata bessana mela Yesuusara palama oykkidosona.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Maato 12:38</ref>; <ref loc="LUK 11:16">Luuqa 11:16</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Yesuusi tookki shemppidi, “Ha wodiya asay ays malaata koyii? Taani hinttew tuma odays; ha wodiya asaas ay malaatikka imettenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Maato 12:39</ref>; <ref loc="LUK 11:29">Luuqa 11:29</ref></char></note> <verse number="13" style="v"/>I entta yan yeggi aggidi zaari wogolon gelidi abbaafe hefinthi pinnis.</para>
  <para style="s">Farisaawetanne Heroodisa irshshuwaa</para>
  <para style="r">(<ref loc="MAT 16:5-12">Maato 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Iya tamaareti kathi efanayssa dogidosona; enttaw wogoluwa giddon issi uythaafe hari baawa. <verse number="15" style="v"/>Yesuusi enttako, “Hinttena erite. Farisaaweta irshshuwaafenne Heroodisa irshshuwaafe naagettite” yaagidi kiittis.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luuqa 12:1</ref></char></note></para>
  <para style="p">
    <verse number="16" style="v"/>Entti bantta giddon, “I hayssa gey nuus uythi baynna gishossa” yaagidosona.</para>
  <para style="p">
    <verse number="17" style="v"/>Yesuusi entti geyssa eridi enttako, “Hinttew uythi baynna gisho ays odetteetii? Ha77ika erekketii? Woykko akeekekketii? Hintte wozanay doccidee? <verse number="18" style="v"/>Hinttew ayfey de7ishin be7ekketi? Haythi de7ishin si7ekketii? Hintte akeeketii?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Er 5:21</ref>; <ref loc="EZK 12:2">Hiz 12:2</ref>; <ref loc="MRK 4:12">Mar 4:12</ref></char></note> <verse number="19" style="v"/>Taani ichchashu uythaa ichchashu mukulu asaas bathida wode aappun gayta kumethi tiife denthidetii?” yaagis.</para>
  <para style="p">Enttika, “Tammanne nam77u gayta kumethi” yaagidosona.</para>
  <para style="p">
    <verse number="20" style="v"/>“Hessadakka, taani laappun uythaa oyddu mukulu asaas bathida wode aappun gayta kumetha tiife denthidetii?” yaagis.</para>
  <para style="p">Entti, “Laappun gayta kumethi denthida” yaagidosona.</para>
  <para style="p">
    <verse number="21" style="v"/>Yaatin, “Ha77ika akeekibeekketii?” yaagis.</para>
  <para style="s">Yesuusi Beetesaydan issi qooqiya pathis</para>
  <para style="p">
    <verse number="22" style="v"/>Entti Beetesayda giya katama bidosona. Guutha asati qooqe uraa Yesuusakko ehidi he uraa bochchana mela iya woossidosona. <verse number="23" style="v"/>Yesuusi qooqe uraa kushiya oykkidi katamaappe gaxa kessis. Iya ayfiyaan cuttidi ba kushiya iya bolla wothidi, “New aykkoy bentii?” yaagidi oychchis.</para>
  <para style="p">
    <verse number="24" style="v"/>Uray dhoqqu gidi xeellidi, “Taw asay benttees, shin asay hamuttishe mithi daanees” yaagis.</para>
  <para style="p">
    <verse number="25" style="v"/>Hessafe guye, Yesuusi zaaridi, uraa ayfiyaan ba kushiya wothis. Uray loythi xeellis, iya ayfey paxis, ubbabaa geeshshidi be7is. <verse number="26" style="v"/>Yesuusi addiyako, “Ne soo ba, shin gutaa geloppa” yaagidi kiittis.</para>
  <para style="s">Phexiroosa ammanuwanne markkatethaa</para>
  <para style="r">(<ref loc="MAT 16:13-20">Maato 16:13-20</ref>; <ref loc="LUK 9:18-21">Luuqa 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>Yesuusi ba tamaaretara Qisaariya Filphoosa matan de7iya gutaa bis. Entti bishin oge bolla Yesuusi, “Tana asay oona goonaa?” yaagidi ba tamaareta oychchis.</para>
  <para style="p">
    <verse number="28" style="v"/>Iya tamaareti, “Issi issi asay nena, ‘Xammaqiya Yohaannisa’ goosona; harati, ‘Eliyaasa goosona’ qassi harati, ‘Nabetappe issuwa’ goosona” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mar 6:14</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi enttako, “Yaatin hintte tana oona geeti?” yaagidi oychchis.</para>
  <para style="p">Phexiroosi, “Neeni Kiristtoosa” yaagidi zaaris.</para>
  <para style="p">
    <verse number="30" style="v"/>Yesuusi, “Tabaa oodeskka odoppite” yaagidi entta kiittis.</para>
  <para style="s">Yesuusi bana gakkana metuwanne waayiya odis</para>
  <para style="r">(<ref loc="MAT 16:21-28">Maato 16:21-28</ref>; <ref loc="LUK 9:22-27">Luuqa 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v"/>Yesuusi ba tamaaretakko, “Asa Na7ay, daro meto ekkanaw bessees; cimati, kahine halaqatinne higge asttamaareti iya ixxanaw bessees. Entti iya wodhanawunne I, heedzu gallasappe guye, hayqoppe denddanaw bessees” yaagidi entta tamaarssis. <verse number="32" style="v"/>I hessa enttaw geeshshidi odis. Phexiroosi iya issi bagga zaaridi hanqettis.</para>
  <para style="p">
    <verse number="33" style="v"/>Shin Yesuusi guye simmidi, ba tamaareta xeellidi, Phexiroosa hanqettidi, “Ha Xalahiyaw ta matappe haakka. Neeni asi dosiyabaa qoppasappe attin Xoossay dosiyabaa qoppaka” yaagis.</para>
  <para style="s">Yesuusa kaaloy bana kado oychchees</para>
  <para style="r">(<ref loc="MAT 10:38-39">Maato 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luuqa 9:23-27</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v"/>Qassika Yesuusi daro asaanne ba tamaareta baakko xeegidi, “Tana kaallanaw koyaa oonikka bana kaddo; ba masqaliya tookkidi tana kaalo.<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Maato 10:38</ref>; <ref loc="LUK 14:27">Luuqa 14:27</ref></char></note> <verse number="35" style="v"/>Ba shemppuwa ashshanaw koyaa uray dhayssana. Shin ta gishonne Wonggelaa gisho ba shemppuwa dhayssiya uray ashshana.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato 10:39</ref>; <ref loc="LUK 17:33">Luuqa 17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref></char></note> <verse number="36" style="v"/>Issi asi sa7an de7iya ubbabaa baw shiishidi, ba shemppuwa dhayssikko iya ay maaddanee? <verse number="37" style="v"/>Issi asi ba shemppuwa wozanaw ay immanaw dandda7ii? <verse number="38" style="v"/>Xoossaa ammanonna ha iita yeletethan, issi asi tananinne ta qaalan yeellatikko, Asa Na7ay, qassi ba Aawa bonchchon geeshsha kiitanchchotara yaa wode iyan yeellatana” yaagis.</para>
  <chapter number="9" style="c"/>
  <para style="s">Yesuusa malay laamettis</para>
  <para style="r">(<ref loc="MAT 17:1-13">Maato 17:1-13</ref>; <ref loc="LUK 9:28-36">Luuqa 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi enttako, “Taani hinttew tuma odays; Xoossaa kawotethay wolqqara yeyssa be7onna hayqqonna issi issi asati hayssan de7oosona” yaagis.</para>
  <para style="p">
    <verse number="2" style="v"/>Yesuusi usuppun gallasappe guye, baara Phexiroosa, Yayqoobanne Yohaannisa ekkidi, entta xalaala gita deriya bolla kessidi entta sinthan laamettis.<note caller="-" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2Phexi 1:17-18</ref></char></note> <verse number="3" style="v"/>Iya ma7oykka phoolis; sa7an ma7o meecciya oonikka geeshshanaw dandda7onnayssa mela daro booxis. <verse number="4" style="v"/>He heedzu tamaareti, Eliyaasinne Musey Yesuusara odetteyssa be7idosona.</para>
  <para style="p">
    <verse number="5" style="v"/>Phexiroosi Yesuusa, “Asttamaariyaw, nuuni hayssan de7eyssi nuus lo77o; nu heedzu shaqarata issuwa new, issuwa Muses, qassi issuwa Eliyaasas shaqarana” yaagis. <verse number="6" style="v"/>Iyaranne hankkotara daro yayyida gisho I ay giyakkoka eribeenna.</para>
  <para style="p">
    <verse number="7" style="v"/>Hessafe guye, shaaray yidi entta kammin shaarappe, “Hayssi ta dosiya, ta Na7aa, I geyssa si7ite” giya qaalay yis.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luuqa 3:22</ref></char></note> <verse number="8" style="v"/>Ellesidi entti yuushshi aathi xeelliya wode, Yesuusappe attin haraa oonakka bantta matan be7ibookkona.</para>
  <para style="p">
    <verse number="9" style="v"/>Entti deriyappe wodhdhishin, Yesuusi enttako, “Asa Na7ay, hayqoppe denddana gakkanaw, hintte be7idabaa oodeskka odoppite” yaagidi kiittis.</para>
  <para style="p">
    <verse number="10" style="v"/>I kiittidayssa entti, “Ero” gidi, “Ha hayqoppe denddo geyssi woygusee” gidi, bantta giddon odettidosona.</para>
  <para style="p">
    <verse number="11" style="v"/>Entti zaaridi, “Higge asttamaareti, ‘Eliyaasi koyrottidi yaanaw bessees’ ays goonaa?” yaagidi oychchidosona.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false">Mil 4:5; <ref loc="MAT 11:14">Maato 11:14</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Yesuusi zaaridi “Eliyaasi koyrottidi yidi, ubbabaa giigisees; yaatin, ays Geeshsha Maxaafay, ‘Asa Na7ay daro waayettana ixettana’ yaagidi oychchis? <verse number="13" style="v"/>Shin taani hinttew odays; Eliyaasi yis; qassi iyabay Geeshsha Maxaafan xaafettidayssada, asay iya bolla bantta koyidabaa oothidosona” yaagis.</para>
  <para style="s">Yesuusi tuna Ayyaanay oykkida Na7a pathis</para>
  <para style="r">(<ref loc="MAT 17:14-21">Maato 17:14-21</ref>; <ref loc="LUK 9:37-43">Luuqa 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Yesuusi, Phexiroosi, Yayqoobinne Yohaannisi hankko iya tamaaretakko simmidi yaa wode, daro asay entta yuushuwan eqqidaysatanne higge asttamaare gidida guutha asati enttara palameyssa be7idosona. <verse number="15" style="v"/>He daro asay Yesuusa be7ida wode malaalettidi, ellesidi iyaakko woxxi yidi, iya sarothidosona. <verse number="16" style="v"/>Yesuusi ba tamaaretakko, “Enttara ay palameetii?” yaagidi oychchis.</para>
  <para style="p">
    <verse number="17" style="v"/>He daro asa giddofe issi uray zaaridi, “Asttamaariyaw, ta na7aa bolla odetethi diggiya tuna ayyaanay de7iya gisho, iya neekko ekkada yas. <verse number="18" style="v"/>Ha tuna ayyaanay iya oykkiya wode ubban, iya shocci yeggees; iya doonara gopponttoy yees; qassi achche garccisees; asatethaaka minnees. Iyappe ha tuna ayyaanaa kessana mela, ne tamaaretas odas, shin kessanaw dandda7ibookkona” yaagis.</para>
  <para style="p">
    <verse number="19" style="v"/>Yesuusi zaaridi enttako, “Ammanonna ha wodiya asaw! Taani hinttera awude gakkanaw daane? Qassi hinttena awude gakkanaw dandda7anee? Na7aa taakko haa ekki yiite” yaagis. <verse number="20" style="v"/>Entti na7aa iyaakko ehidosona; he tuna ayyaanay Yesuusa be7ida mela na7aa kokkorssi aggis; na7ay sa7an kunddidi, doonara gopponttoy toofu gishin gonddorettis. <verse number="21" style="v"/>Yesuusi he na7aa aawakko, “Hayssi ne na7aa oykkoossappe ay mela wode gidanee?” yaagidi oychchis.</para>
  <para style="p">Na7aa aaway, “I guuthan de7ishin oykkis. <verse number="22" style="v"/>Iya wodhanaw daro wode tamaninne haathan yeggees, shin ne dandda7ikko, nuus qadhettarkii, nuna maaddarkii” yaagis.</para>
  <para style="p">
    <verse number="23" style="v"/>Yesuusi iya, “ ‘Neeni dandda7ikko gay?’ Ammaniya oodeskka ubbabay dandda7ettees” yaagis.</para>
  <para style="p">
    <verse number="24" style="v"/>Ellesidi na7aa aaway ba qaala dhoqqu oothidi, “Taani ammanays, shin gujja ammananaada tana maaddarkii” yaagis.</para>
  <para style="p">
    <verse number="25" style="v"/>Yesuusi asay dari dari beyssa be7idi, tuna ayyaanaa, “Ha tullenne muume ayyaanaw, ha na7aappe keya gada nena ta kiittays; qassi nam77antho iyan geloppa” yaagis.</para>
  <para style="p">
    <verse number="26" style="v"/>He tuna ayyaanay waassidi, na7aa daro kokkorssidi, iyappe keyis. Na7ay hayqqida daanin, daro asay, “Na7ay hayqqis” yaagidosona. <verse number="27" style="v"/>Shin Yesuusi na7aa kushiya oykkidi denthin, na7ay denddi eqqis.</para>
  <para style="p">
    <verse number="28" style="v"/>Yesuusi soo gelidayssafe guye, iya tamaareti, “Nuuni he tuna ayyaanaa kessanaw ays dandda7ibookko?” yaagidi Yesuusa dumma oychchidosona.</para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi zaaridi, “Hessa melay woosappenne xoomappe attin haraban keyanaw dandda7enna” yaagis.</para>
  <para style="s">Yesuusi bana gakkana metuwa zaari odis</para>
  <para style="r">(<ref loc="MAT 17:22-23">Maato 17:22-23</ref>; <ref loc="LUK 9:43-45">Luuqa 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Entti he bessaafe denddidi, Galiilara aadhdhidi bidosona; Yesuusi ba de7iyasuwa oonikka erana mela koyibeenna. <verse number="31" style="v"/>I ba tamaaretakko, “Asa Na7aa, asi asas aathi immananne wodhana; I heedzu gallasappe guye, hayqoppe denddana” yaagidi tamaarssees.</para>
  <para style="p">
    <verse number="32" style="v"/>Shin enttaw I geyssi gelibeenna; qassi iya oychchanawukka yayyidosona.</para>
  <para style="s">Ubbaafe aadhdhey oonee?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Maato 18:1-5</ref>; <ref loc="LUK 9:46-48">Luuqa 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v"/>Entti Qifirnahoome katamaa bidi soo gelidayssafe guye, Yesuusi enttako, “Ogen ay odetteetii?” yaagidi oychchis. <verse number="34" style="v"/>Shin entti, “Nu giddon ubbaafe aadhdhanay oonee?” yaagidi palamida gisho, si7i gidosona.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luuqa 22:24</ref></char></note> <verse number="35" style="v"/>Yesuusi uttidi, tammanne nam77u tamaareta xeegidi, “Oonikka sinthe aadhdhanaw koykko, ubbaafe guye aadhdhidi, ubbaas aylle gidanaw bessees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Maato 20:26</ref></char></note></para>
  <para style="p">
    <verse number="36" style="v"/>Issi guutha na7aa ekkidi, entta giddon essis; he guutha na7aa idimmidi enttako, <verse number="37" style="v"/>“Hayssa mela guutha naytappe issuwa ta sunthan mokkiya oonikka tana mokkees; qassi tana mokkiya oonikka tana kiittidayssaka mokkeesippe attin ta xalaala mokkenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Maato 10:40</ref>; <ref loc="LUK 10:16">Luuqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref></char></note></para>
  <para style="s">Nuna ixxonna uray nu bagga</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luuqa 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v"/>Yohaannisi, “Asttamaariyaw, issi asi ne sunthan tuna Ayyaanata kessishin nuuni be7idi, nu bagga gidonna gisho, iya diggida” yaagis.</para>
  <para style="p">
    <verse number="39" style="v"/>Shin Yesuusi, “Oonikka ta sunthan Xoossay oothiya malaatata oothidi, ellesidi ta bolla iitabaa odettanaw dandda7ey baynna gisho diggofite. <verse number="40" style="v"/>Nubaa ixxonna uray nu bagga.<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Maato 12:30</ref>; <ref loc="LUK 11:23">Luuqa 11:23</ref></char></note> <verse number="41" style="v"/>Taani hinttew tuma odays; hintte tayssata gidiya gisho, oonikka hinttew ta sunthan halo haathi uyanaw immikokka, ba woytuwa ekkana.<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Maato 10:42</ref></char></note></para>
  <para style="s">Nagaran paacetethi</para>
  <para style="r">(<ref loc="MAT 18:6-9">Maato 18:6-9</ref>; <ref loc="LUK 17:1-2">Luuqa 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v"/>“Tana ammaniyaa ha guuthatappe issuwa balethiya oonikka, gaacciya wogga woxa ba qodhen qachchidi, abban wulliyako iyaw lo77o. <verse number="43-44" style="v"/>Ne kushey nena balethikko, qanxa hola. Neeni nam77u kushera to7onna gaanname taman yegetteyssafe, duuxa kushera de7uwa geloy new lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Maato 5:30</ref></char></note> <verse number="45-46" style="v"/>Ne tohoy nena balethikko, qanxa hola. Neeni nam77u tohuwara gaanname taman yegetteyssafe, wobbe gidada de7uwa geleyssi new lo77o. <verse number="47" style="v"/>Ne ayfey nena balethikko, wooca kessa hola. Neeni nam77u ayfiyaara gaanname taman yegetteyssafe, issi ayfiyaara Xoossaa kawotethaa geleyssi new lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Maato 5:29</ref></char></note> <verse number="48" style="v"/>Yan entta miya guxuney hayqqenna, tamaykka to7enna.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66:24</ref></char></note></para>
  <para style="p">
    <verse number="49" style="v"/>“Yarshshoy maxinen geeyeyssa mela asi ubbay taman harqettana. <verse number="50" style="v"/>Maxiney lo77o, shin I mal7onna ixxiko, zaaridi waati mal7ethanee? Hinttenan maxiney de7o. Yaanidi issoy issuwara sarotethaan de7ite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Maato 5:13</ref>; <ref loc="LUK 14:34">Luuqa 14:34</ref></char></note></para>
  <chapter number="10" style="c"/>
  <para style="s">Machcho yeddanaw bessenna</para>
  <para style="r">(<ref loc="MAT 19:1-2">Maato 19:1-2</ref>; <ref loc="LUK 16:18">Luuqa 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi hessafe denddidi, Yihuda biittaa bidi Yorddaanose Shaafaa pinnis. Daro asay zaaridi iyaakko shiiqin, kaseyssadakka he asaa tamaarssis.</para>
  <para style="p">
    <verse number="2" style="v"/>Issi issi Farisaaweti paaccanaw koyidi Yesuusa, “Issi asi ba machchiw yeddana mela Muse higgey kiitii?” yaagidi iya oychchidosona.</para>
  <para style="p">
    <verse number="3" style="v"/>I zaaridi, “Musey hinttena woygidi kiittidee?” yaagis.</para>
  <para style="p">
    <verse number="4" style="v"/>Entti, “Musey, ‘Issi asi ba machchees anjjo worqqate immidi yeddo’ gis” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1">Zaare 24:1</ref></char></note></para>
  <para style="p">
    <verse number="5" style="v"/>Yesuusi zaaridi, entta “Hintte odin si7onnayssata gidiya gisho, Musey ha kiitaa hinttew xaafis. <verse number="6" style="v"/>Shin Xoossay koyro medhdhiya wode, addenne macca oothidi, entta medhdhis.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medhe 1:27</ref>; <ref loc="GEN 5:1">5:1</ref></char></note> <verse number="7" style="v"/>Hessa gisho, issi asi ba aawanne ba aayiw aggidi, ba machcheera issife de7ees.<note caller="-" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref></char></note> <verse number="8" style="v"/>Entti nam77ay issi ase gidoosona; hessa gisho, entti issi ase gidoosonappe attin nam77u asi gidokkona. <verse number="9" style="v"/>Hessa gisho, Xoossay issife qachchidayssa asi shaakkofo” yaagis.</para>
  <para style="p">
    <verse number="10" style="v"/>Entti soo simmida wode, iya tamaareti ha odabaa Yesuusa nam77antho oychchidosona. <verse number="11" style="v"/>Yesuusi enttako, “Ba machchiw yeddidi hara ekkiya uray oonikka laymatees.<note caller="-" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato 5:32</ref>; <ref loc="1CO 7:10-11">1Qoro 7:10-11</ref></char></note> <verse number="12" style="v"/>Qassi maccasiyakka ba azinaappe keyada hara azina gelikko laymatawusu” yaagis.</para>
  <para style="s">Yesuusi guutha nayta anjjis</para>
  <para style="r">(<ref loc="MAT 19:13-15">Maato 19:13-15</ref>; <ref loc="LUK 18:15-17">Luuqa 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Yesuusi guutha nayta bochchana mela, issi issi asay nayta iyaakko ehoosona, shin iya tamaareti he asa hanqettidosona. <verse number="14" style="v"/>Yesuusi hessa be7idi, ba tamaareta hanqettidi; enttako, “Guutha nayti taakko yeyssa diggofite; Xoossaa kawotethay hayssata melatassa. <verse number="15" style="v"/>Taani hinttew tuma odays; Xoossaa kawotethaa guutha na7ada ekkonna uray oonikka he kawotethaa ubbarakka gelenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Maato 18:3</ref></char></note> <verse number="16" style="v"/>Guutha nayta idimmidi, ba kushiya entta issuwa issuwa bolla wothidi anjjis.</para>
  <para style="s">Miishe siiqoy ehiya metuwa</para>
  <para style="r">(<ref loc="MAT 19:16-30">Maato 19:16-30</ref>; <ref loc="LUK 18:18-30">Luuqa 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v"/>Yesuusi baanaw keyida wode, issi uray woxxi yidi, iya sinthan gulbbatidi, “Keeha asttamaariyaw, merinaa de7uwa laattanaw taani ay ootho?” yaagidi oychchis.</para>
  <para style="p">
    <verse number="18" style="v"/>Yesuusi, “Ays tana keehaw gada xeegay? Xoossaa xalaalappe attin hari keehi oonikka baawa. <verse number="19" style="v"/>Xoossaa kiitaa, wodhoppa; laymatoppa; kaysotoppa; worddo markkattofa; inxarssan cimmofa; ne aawanne ne aayiw bonchcha yaageyssa eraasa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kessa 20:12-16</ref>; <ref loc="DEU 5:16-20">Zaare 5:16-20</ref></char></note></para>
  <para style="p">
    <verse number="20" style="v"/>Uray, “Asttamaariyaw, taani hessa ubbaa na7atethafe doomada ha77i gakkanaw naagays” yaagis.</para>
  <para style="p">
    <verse number="21" style="v"/>Yesuusi uraa tishshi oothi xeellidi dosis; “New issibay paccees; bada new de7iyaba ubbaa bayzada, he miishiya manqotas imma; neeni salon duretana. Yaata simmada tana kaalla” yaagis. <verse number="22" style="v"/>Shin uray hessa si7idi, I daro dure gidiya gisho, ba som77uwa kaarethis, ufayttonna aggidi bis.</para>
  <para style="p">
    <verse number="23" style="v"/>Yesuusi ba tamaareta yuushshi aathi xeellidi, “Dure asi Xoossaa kawotethaa gelanayssi waanidi metanddeeshsha!” yaagis.</para>
  <para style="p">
    <verse number="24" style="v"/>Iya tamaareti iya timirttiya si7idi malaalettidosona. Shin Yesuusi qassika enttako, “Nayto, Xoossaa kawotethaa gelanayssi waanidi metanddeeshsha! <verse number="25" style="v"/>Dure asi Xoossaa kawotethaa gelanayssafe, gimaley narppe luhora aadhdheyssi kawuyees” yaagis.</para>
  <para style="p">
    <verse number="26" style="v"/>Iya tamaareti malaalettidi, “Yaatin, ooni attanay?” yaagidi, issoy issuwa oychchidosona.</para>
  <para style="p">
    <verse number="27" style="v"/>Yesuusi entta tishshi oothi xeellidi, “Hayssi Xoossas dandda7eteesppe attin asas dandda7ettenna; Xoossas ubbabay dandda7ettees” yaagis.</para>
  <para style="p">
    <verse number="28" style="v"/>Phexiroosi Yesuusakko, “Hekko; nuuni nubaa ubbaa aggidi, nena kaallida” yaagis.</para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi “Taani hinttew tuma odays; ta gishonne Wonggelaa gisho, keetha woykko ishata woykko michcheta woykko aawa woykko aayiw woykko machchiw woykko nayta woykko gadiya aggiday oonikka, <verse number="30" style="v"/>ha77i ha wodiyan xeetu kushe keetha, ishata, michcheta, aayeta, nayta, gadiya, goodetethara issife ekkana. Sinthafe yaana wodiyankka merinaa de7uwa ekkana. <verse number="31" style="v"/>Shin daroti ha77i dethan sinthe gididayssati guye gidana, qassi daroti ha77i guye gididayssati sinthe gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Maato 20:16</ref>; <ref loc="LUK 13:30">Luuqa 13:30</ref></char></note></para>
  <para style="s">Yesuusi bana gakkana metuwa heedzantho odis</para>
  <para style="r">(<ref loc="MAT 20:17-19">Maato 20:17-19</ref>; <ref loc="LUK 18:31-34">Luuqa 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>Yesuusaranne iya tamaaretara Yerusalaame bishin, Yesuusi ba tamaareta sinthan hamuttees. Entti malaalettidosona. Iya kaalleyssatikka yayyidosona. Nam77antho, tammanne nam77u tamaareta gaxa kessidi, bana gakkanabaa dumma enttaw hayssada yaagidi odis. <verse number="33" style="v"/>“Hekko, nuuni Yerusalaame ha77i keyoos. Yan Asa Na7aa, kahine halaqatasinne higge asttamaaretas aathi imettana. Entti iya bolla hayqo pirddaa pirddana; qassi Ayhude gidonna deriyas iya aathi immana. <verse number="34" style="v"/>He Ayhude gidonna derey iya toochchana, iya bolla cuttana, lisson garaafananne wodhana. I heedzu gallasappe guye, hayqoppe denddana” yaagis.</para>
  <para style="s">Yayqoobinne Yohaannisi woossida woosaa</para>
  <para style="r">(<ref loc="MAT 20:20-28">Maato 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Zabdiyoosa nayti Yayqoobinne Yohaannisi Yesuusakko yidi, “Asttamaariyaw, nuuni nena woossiya issibaa nuus ootharkkii” yaagidosona.</para>
  <para style="p">
    <verse number="36" style="v"/>Yesuusi enttako, “Taani hinttew ay ootho?” yaagis.</para>
  <para style="p">
    <verse number="37" style="v"/>Entti, “Neeni ne bonchcho kawotethan uttiya wode, nuuppe issuwa ushachcha baggara qassi issuwa haddirssa baggara uttisarkkii” yaagidosona.</para>
  <para style="p">
    <verse number="38" style="v"/>Shin Yesuusi enttako, “Hintte ay woossiyako erekketa, ta uyanaw de7iya xuu7aa uyanaw dandda7etii? Qassi taani xammaqettanaw de7iya xinqqatiya xammaqettanaw dandda7etii?” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luuqa 12:50</ref></char></note></para>
  <para style="p">
    <verse number="39" style="v"/>Entti zaaridi, “Ee dandda7os” yaagidosona.</para>
  <para style="p">Yesuusi qassi, “Tumakka ta uyanaw de7iya xuu7aa hintte uyana, taani xammaqettanaw de7iya xinqqatiya hintte xammaqettana. <verse number="40" style="v"/>Shin taappe ushachcha baggaranne haddirssa baggara uttanayssata dooranaw taw maati baawa, shin he bessay Xoossay immanaw giigisi wothidayssatassa” yaagis.</para>
  <para style="p">
    <verse number="41" style="v"/>Hankko tammu tamaareti hessa si7ida wode, Yayqoobanne Yohaannisa hanqettidosona. <verse number="42" style="v"/>Yesuusi entta ubbaa baakko xeegidi, “Ayhude gidonna asaa halaqati deriya haareyssata geetettidi xeegetteyssanne haareyssatas deriya bolla maati de7eyssa hintte ereeta.<note caller="-" style="x"><char style="xo" closed="false">10:42-44 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luuqa 22:25-26</ref>; <ref loc="MAT 23:11">Maato 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luuqa 22:26</ref></char></note> <verse number="43" style="v"/>Shin hintte giddon hessa mela gidenna; hintte giddon gitatanaw koyey oonikka hinttew aylle gidanaw bessees. <verse number="44" style="v"/>Qassi hintte giddon ubbaafe bolla gidanaw koyey oonikka hintte ubbaas aylle gidanaw bessees. <verse number="45" style="v"/>Hari attoshin, Asa Na7aykka, asaas oothanawunne darota wozanaw ba shemppuwa aathi immanaw yasippe attin asi iya oothana mela yabiikke” yaagis.</para>
  <para style="s">Yesuusi qooqiya Barximoosa ayfiyaa pathis</para>
  <para style="r">(<ref loc="MAT 20:29-34">Maato 20:29-34</ref>; <ref loc="LUK 18:35-43">Luuqa 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v"/>Entti Iyaarkko katama bidosona. Yesuusi ba tamaaretaranne daro asaara Iyaarkkofe keyishin, Ximoosa na7ay, qooqey, Barximoosa geetetteyssi, ogiya gaxan woossishe uttis. <verse number="47" style="v"/>Barximoosi, yaara aadhdhey Naazirete Yesuusa gididayssa si7ida wode, ba qaala dhoqqu oothidi, “Dawite na7aa Yesuusa, tana maararkii!” yaagusu oykkis.</para>
  <para style="p">
    <verse number="48" style="v"/>Daro asay iya, “Hayza!” gidi hanqettidosona.</para>
  <para style="p">Shin, I ba qaala kaseyssafe daro dhoqqu oothidi, “Dawite na7aw, tana maararkii!” yaagis.</para>
  <para style="p">
    <verse number="49" style="v"/>Yesuusi eqqidi, “Iya haa xeegite” yaagis.</para>
  <para style="p">Entti qooqiyakko, “Aykkoy baawa, dendda eqqa, nena xeegees” yaagidosona. <verse number="50" style="v"/>Qooqey ba ma7uwa holi yeggidi, guppi denddi eqqidi, Yesuusakko bis.</para>
  <para style="p">
    <verse number="51" style="v"/>Yesuusi, “Taani new ay oothana mela koyay?” yaagis.</para>
  <para style="p">Qooqey, “Asttamaariyaw, ta xeellanaw koyays” yaagis.</para>
  <para style="p">
    <verse number="52" style="v"/>Yesuusi iya, “Ba, ne ammanoy nena pathis” yaagis. Sohuwarakka iya ayfey xeellin, Yesuusa kaallis.</para>
  <chapter number="11" style="c"/>
  <para style="s">Yesuusi gita bonchchon Yerusalaame gelis</para>
  <para style="r">(<ref loc="MAT 21:1-11">Maato 21:1-11</ref>; <ref loc="LUK 19:28-40">Luuqa 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoha 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Entti Yerusalaame matishe, Shamaho Deriya matan de7iya Beetefaagenne Bitaaniya katamata gakkidosona. Yesuusi ba tamaaretappe nam77ata sinthe kiittidi, <verse number="2" style="v"/>“Hinttefe sinthan de7iya gutaa biite; yaa gelida mela oonikka toggiboonna qashon de7iya hare mari hintte demmana, iya billidi, haa ekki yiite. <verse number="3" style="v"/>Oonikka hinttena, ‘Hayssa ays ootheetii?’ yaagidi oychchiko, ‘Goday iya koyees, ellesidi haa yeddana’ yaagite” yaagis.</para>
  <para style="p">
    <verse number="4" style="v"/>Entti bidi, hare mari kare bolla oge matan qashettidi de7eyssa demmidi billidosona. <verse number="5" style="v"/>He besan eqqida issi issi asati enttako, “Hare maraa waatanaw billeeti?” yaagidosona. <verse number="6" style="v"/>Iya tamaareti Yesuusi banttana kiittidayssa odin, asati yeddi aggidosona. <verse number="7" style="v"/>Entti hare maraa Yesuusakko ehidi, bantta ma7uwa iya zokkon hiixin Yesuusi he hare maraa toggis. <verse number="8" style="v"/>Daro asay bantta ma7uwa ogiyan hiixidosona; qassi harati mitha tashe tashidi, ogen hiixidosona. <verse number="9" style="v"/>Yesuusappe sinthara hamuttiya asaynne iya kaalliya asay bantta qaala dhoqqu oothidi,</para>
  <para style="q1">“Hosaana! <note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">Hosaana: </char><char style="ft" closed="false">Maato 21:9 be7ite.</char></note> Xoossay galatetto!</para>
  <para style="q2">Godaa sunthan yeyssi anjjettidayssa.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Maz 118:25</ref></char></note></para>
  <para style="q1">
    <verse number="10" style="v"/>Godaa sunthan yaa nu aawa</para>
  <para style="q2">Dawite kawotethay anjjettidayssa.</para>
  <para style="q">Ubbaafe Bolla Saluwan</para>
  <para style="q2">de7iya Xoossay galatetto”</para>
  <para style="m">yaagidosona.</para>
  <para style="p">
    <verse number="11" style="v"/>Yesuusi Yerusalaame bidi, Xoossaa Keetha gelis. Qassi ubbabaa yuuyi xeellidaappe guye, sa7ay qammiya gisho, tammanne nam77u tamaaretara Bitaaniya giya katama bis.</para>
  <para style="s">Yesuusi qanggida balase mithiw</para>
  <para style="r">(<ref loc="MAT 21:18-19">Maato 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Wonttetha gallas entti Bitaaniyappe keyidi bishin, Yesuusi koshattis. <verse number="13" style="v"/>Haahon issi balase mithiw haytha xalaala ma77a uttidaaro be7idi, I bolla ayfey beettiko gidi, be7anaw iikko bis, shin iikko I biya wode, haytha xalaalappe attin issi ayfekka demmibeenna; ays giikko, balasey ayfiyaa wodey gakkibeenna. <verse number="14" style="v"/>Yesuusi he balasiw, “Hiza, neeppe merinaw asi ayfe mooppo” yaagis. Iya tamaareti I geyssa si7idosona.</para>
  <para style="s">Yesuusi Xoossa Keethan zal77eyssata kessis</para>
  <para style="r">(<ref loc="MAT 21:12-17">Maato 21:12-17</ref>; <ref loc="LUK 19:45-48">Luuqa 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoha 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v"/>Entti Yerusalaame bidosona; Yesuusi Xoossa Keetha gelidi, yan bayzeyssatanne shammeyssata kare goodo oykkis; qassi miishe laammeyssata xarpheezanne holle bayzeyssata oydiya aathi yeggidi, <verse number="16" style="v"/>asi aybibaakka tookkidi, Xoossa Keetha giddora aadhdhonna mela diggis. <verse number="17" style="v"/>Yesuusi asa hayssada yaagidi tamaarssis: “Geeshsha Maxaafan, ‘Ta keethay asi ubbay Xoossaa woossiya keethi gidana’ geetettidi xaafettis. Shin hintte iya panggati qosettiya gonggolo oothideta” yaagis.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Er 7:11</ref></char></note></para>
  <para style="p">
    <verse number="18" style="v"/>Kahine halaqatinne higge asttamaareti hessa si7idi, iya wodhanaw oge koshshi oykkidosona. Shin daro asay iya timirttiyan malaalettiya gisho, iyaw yayyidosona.</para>
  <para style="p">
    <verse number="19" style="v"/>Sa7ay omarssiya wode Yesuusinne iya tamaareti katamaappe gaxa keyidosona.</para>
  <para style="s">Balase mithiya melasu</para>
  <para style="r">(<ref loc="MAT 21:20-22">Maato 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v"/>Entti wonttetha gallas he ogiyara aadhdhishe, he balasiya xaphora melidaaro be7idosona. <verse number="21" style="v"/>Phexiroosi akeekidi, “Asttamaariyaw, hekko, neeni qanggida balasiya melasu” yaagis.</para>
  <para style="p">
    <verse number="22" style="v"/>Yesuusi zaaridi, “Xoossaa ammanite. <verse number="23" style="v"/>Taani hinttew tuma odays; oonikka ba wozanan sidhonna gidabay hananayssa ammanidi, ha deriya, ‘Denddada abban kundda’ yaagikko iyaw hanana.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato 17:20</ref>; <ref loc="1CO 13:2">1Qoro 13:2</ref></char></note> <verse number="24" style="v"/>Hessa gisho, taani hinttew odays; Xoossaa hintte woossiyabaanne oychchiyabaa aybaa gidikkoka ekkidaada ammanite, hintte ekkana. <verse number="25" style="v"/>Xoossaa woossanaw hintte eqqiya wode, salon de7iya hintte Aaway hintte nagara atto gaana mela, oonikka hinttena naaqidabay de7ikko, iyaw atto giite. <verse number="26" style="v"/>Shin asa nagara hintte atto goonna ixxiko, salon de7iya hintte Aawaykka hintte nagaraa hinttew atto geenna” yaagis.</para>
  <para style="s">Yesuusi aybi maatan oothiyako oyshettis</para>
  <para style="r">(<ref loc="MAT 21:23-27">Maato 21:23-27</ref>; <ref loc="LUK 20:1-8">Luuqa 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>Entti zaaridi Yerusalaame bidosona. Yesuusi Xoossa Keethan hamuttishin, kahine halaqati, higge asttamaaretinne cimati iyaakko yidi, <verse number="28" style="v"/>“Neeni hayssa oothanaw new ay maati de7ii? Woykko new ha maata immiday oonee?” yaagidosona.</para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi zaaridi enttako, “Ta hinttena issibaa oychchana, taw odite. Ta qassi hayssa ay maatan oothiyako, hinttew odana. <verse number="30" style="v"/>Yohaannisa xinqqatey Xoossafeyye woykko asappe? Taw odite” yaagis.</para>
  <para style="p">
    <verse number="31" style="v"/>Entti bantta giddon palama doomidi, “Nuuni, ‘Xoossafe’ giikko, I nuukko, ‘Yaatin, Yohaannisi odidayssa ays ammanibeekketii?’ yaagana. <verse number="32" style="v"/>‘Asappe giikko’ asay ubbay Yohaannisi nabe gideyssa eroosona.” Yaaniya gisho asaas yayyidosona. <verse number="33" style="v"/>Hessa gisho, entti Yesuusakko, “Nuuni erokko” yaagidi zaaridosona;</para>
  <para style="p">Yesuusi, “Taanikka hayssa ay maatan oothiyako, hinttew odikke” yaagis.</para>
  <chapter number="12" style="c"/>
  <para style="s">Woyne tokkiya goshshanchchota leemiso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Maato 21:33-46</ref>; <ref loc="LUK 20:9-19">Luuqa 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi enttaw leemison yaagidi odis; “Issi uray woyne atakiltte tokkidi, yuushshi aathidi dirssi diris. Qassi he woyniya gum77iya olaaka bookkis. Iya naaganaw adussa shakko shakkis. Hessafe guye, kothe oothiya asaas immidi, hara biitta bis.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa 5:1</ref></char></note> <verse number="2" style="v"/>Woyne ayfiyaa maxiya wodey gakkin, bana gakkeyssa ekkidi yaana mela, issi ba aylliya kothe aawatakko kiittis. <verse number="3" style="v"/>Kothe aawati iya aylliya oykkidi wadhdhidi, mela kushe yeddidosona. <verse number="4" style="v"/>Nam77antho hara aylle enttako kiittin, entti he aylliyas huu7iya qoo7idi kawushshidi yeddidosona. <verse number="5" style="v"/>Woyne atakilttiya goday qassika hara aylle kiittis. He aylliya wodhidosona, qassi hara darota hessada oothidosona, issota issota wadhdhidi, harata wodhidosona.</para>
  <para style="p">
    <verse number="6" style="v"/>“Woyne atakilttiya godaas kiittanaw ubbaafe wurssethan I daro dosiya ba na7aa xalaali attis. I, “Entti ta na7aa bonchchonna aggokona” gidi, ba na7aa enttako kiittis.</para>
  <para style="p">
    <verse number="7" style="v"/>“Shin kothe aawati bantta giddon, ‘Laattanayssi hayssa; yedhdhite iya wodhoos; iya laatay nubaa gidana!’ yaagidosona. <verse number="8" style="v"/>Na7aa oykkidi wodhidi, iya ahaa woyne atakilttiya giddofe gaxa kessi holidosona.</para>
  <para style="p">
    <verse number="9" style="v"/>“Hiza, woyne atakilttiya goday waatanee? Yidi he kothe aawata wodhi onggidi, woyniya kothe oothiya hara asas immana.</para>
  <para style="q1">
    <verse number="10-11" style="v"/>‘Gimbbeyssati boridi ixxida shuchchay</para>
  <para style="q2">godaa xaphuwa minthiya,</para>
  <para style="q2">ubbaafe aadhdhiya shuchchu gidis.</para>
  <para style="q1">Hayssi Goday oothidabaa;</para>
  <para style="q2">qassi nu ayfiyaaskka malaalisiyabaa’</para>
  <para style="m">yaageyssa Geeshsha Maxaafaappe nabbabibeekketii?” yaagis. <note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Maz 118:22-23</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Kahine halaqati, higge asttamaaretinne cimati Yesuusi he leemisuwa bantta bolla leemisidayssa erida gisho, iya oykkanaw koyidosona, shin asaas yayyidi, aggi bidosona.</para>
  <para style="s">Giira giirobaa</para>
  <para style="r">(<ref loc="MAT 22:15-22">Maato 22:15-22</ref>; <ref loc="LUK 20:20-26">Luuqa 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Qassi iya odaappe bala demmidi, iya oykkana mela, Farisaawetappenne Heroodisa baggatappe guutha asata iyaakko kiittidosona. <verse number="14" style="v"/>Entti iyaakko yidi, “Asttamaariyaw, neeni tuma odetteyssanne asappe ase shaakkonnayssa nuuni eroos. Neeni ase dummayakka; qassi Xoossaa ogiya tumatethan tamaarssaasa. Nuuni Roome biittaa Kawuwa Qeesares giira giireyssi wogeyye woga gidennee? Giira giiranee agganee?” yaagidosona.</para>
  <para style="p">
    <verse number="15" style="v"/>Shin entta cubbotethaa Yesuusi eridi, “Tana ays paacetii? Ane issi santime tana bessite” yaagis. <verse number="16" style="v"/>Entti iyaw ehidosona, “Ha malaynne sunthay oodeysee?” yaagidi entta oychchis.</para>
  <para style="p">Entti, “Roome Kawuwa Qeesareyssa” yaagidosona.</para>
  <para style="p">
    <verse number="17" style="v"/>Yesuusi zaaridi, “Yaatikko, Qeesareyssa Qeesares, Xoossayssa Xoossaas immite” yaagin entti iyabaa malaalettidosona.</para>
  <para style="s">Hayqoppe denddobaa</para>
  <para style="r">(<ref loc="MAT 22:23-33">Maato 22:23-33</ref>; <ref loc="LUK 20:27-40">Luuqa 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v"/>Hayqqida asi denddenna giya Saduqaawetappe issi issi asati Yesuusakko yidi, hayssada yaagidi, iya oychchidosona.<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Ha@O 23:8</ref></char></note> <verse number="19" style="v"/>“Asttamaariyaw, Musey nuus higgiya xaafishe, ‘Machcho ekkida asi na7a yelonna hayqqiko, he hayqqidayssa ishay iya machchiw ekkidi, ba ishaas na7a yelanaw bessees’ yaageyssa xaafis.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref></char></note> <verse number="20" style="v"/>Beni wode laappun ishati de7eyssatappe bayray machcho ekkidi, na7a yelonna hayqqis. <verse number="21" style="v"/>Nam77anthoy iyo ekkis, ikka na7a yelonna hayqqis. Heedzanthoyka hessada hanis. <verse number="22" style="v"/>Laappunatikka hessatho iyo ekkidi, na7a yelonna hayqqidosona. Ubbaafe guye, qassi he maccasiya hayqqasu. <verse number="23" style="v"/>Yaatin, laappunati iyo ekkida gisho hayqqida asay hayqoppe denddiya gallas, iya enttafe awussas machcho gidanee?” yaagidosona.</para>
  <para style="p">
    <verse number="24" style="v"/>Yesuusi zaaridi, “Hintte baley, Geeshsha Maxaafata woykko Xoossaa wolqqaa eronna gishossa! <verse number="25" style="v"/>Hayqqida asay hayqoppe denddiya gallas, salon de7iya kiitanchchota mela gidanaappe attin adde asay ekkokona; macca asay gelekkona. <verse number="26" style="v"/>Shin hayqqidayssata dendduwabaa gidikko, Muse maxaafan xaafettida xuugettiya buuriyabaa odiya bessan, Xoossay Musekko, ‘Taani, Abrahaame Xoossaa, Yisaaqa Xoossaa, Yayqooba Xoossaa’ gidayssa nabbabibeekketii?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref></char></note> <verse number="27" style="v"/>Hessa gisho, I, paxa de7eyssata Xoossaafe attin hayqqidayssata Xoosse gidenna. Hintte daro balideta” yaagis.</para>
  <para style="s">Ubbaafe aadhdhiya kiitaa</para>
  <para style="r">(<ref loc="MAT 22:34-40">Maato 22:34-40</ref>; <ref loc="LUK 10:25-28">Luuqa 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v"/>Higge asttamaaretappe issoy entti palameyssa shiiqidi si7is. Qassi Yesuusi enttaw loythi zaaridayssa si7idi, “Kiita ubbaafe aadhdhiya kiitay awussee?” yaagidi Yesuusa oychchis.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luuqa 10:25-28</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v"/>Yesuusi zaaridi, iya hayssada yaagis; “Kiita ubbaafe aadhdhiya kiitaa si7ite; ‘Isra7eele asaw, Goday nu Xoossay issi Godaa.<note caller="-" style="x"><char style="xo" closed="false">12:29-30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">Zaare 6:4-5</ref></char></note> <verse number="30" style="v"/>Ne Godaa ne Xoossaa ne kumetha wozanappe, ne kumetha shemppuwafe, ne kumetha qofaappe, ne kumetha wolqqaafe dosa’ yaagees. <verse number="31" style="v"/>Qassi kiita ubbaafe aadhdhiya nam77antho kiitay hayssa; ‘Ase ubbaa ne huu7iyada dosa’ yaageyssa; hayssatappe aadhdhiya hara kiiti baawa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref></char></note></para>
  <para style="p">
    <verse number="32" style="v"/>Higge asttamaarey Yesuusakko, “Asttamaariyaw, tuma gadasa; neeni ‘Xoossay issi Xoossaa xalaala. Iyappe attin hari baawa’ gidayssi tuma.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">Zaare 4:35</ref></char></note> <verse number="33" style="v"/>Xoossaa kumetha wozanappe, kumetha qofaappenne kumetha wolqqaafe doseysinne qassi ase ubbaa ba huu7iyada doseyssi, xuuggiya yarshshuwafenne hara yarshsho ubbaafe aadhdhees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hose 6:6</ref></char></note></para>
  <para style="p">
    <verse number="34" style="v"/>Yesuusi higge asttamaariya zaaroy aadhdhida eranchcho asa zaaro gididayssa be7idi, “Neeni Xoossaa kawotethaafe haakkabaakka” yaagis; hessafe guye, Yesuusa harabaa oychchanaw oonikka minnibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luuqa 10:25-28</ref></char></note></para>
  <para style="s">Kiristtoosi oode na7ee</para>
  <para style="r">(<ref loc="MAT 22:41-46">Maato 22:41-46</ref>; <ref loc="LUK 20:41-46">Luuqa 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Yesuusi Xoossa Keethan tamaarssishe, hayssada yaagis: “Higge asttamaareti Kiristtoosa woygidi Dawite na7a goonaa? <verse number="36" style="v"/>Dawitey Geeshsha Ayyaanan kumidi,</para>
  <para style="q">‘Goday, ta Godaa, “Taani ne morkketa</para>
  <para style="q2">ne tohoy yedhdhiyaso oothana gakkanaw,</para>
  <para style="q">hayssan taappe ushachcha baggara utta” gis’</para>
  <para style="m">yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref></char></note> <verse number="37" style="v"/>Dawitey ba huu7en Kiristtoosa, ‘Godaa’ gidi xeegikko, yaatin, Kiristtoosi waanidi, Dawite na7a gidii” yaagis.</para>
  <para style="p">Daro asay Yesuusi geyssa ufayssan si7idosona.</para>
  <para style="s">Yesuusi higge asttamaaretanne Farisaaweta boris</para>
  <para style="r">(<ref loc="MAT 23:1-36">Maato 23:1-36</ref>; <ref loc="LUK 20:45-47">Luuqa 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v"/>Yesuusi tamaarssishe, hayssada yaagis; “Higge asttamaaretappe naagettite; entti adussa ma7o ma7idi yuuyeyssanne giyankka asay entta bonchchidi sarotheyssa dosoosona. <verse number="39" style="v"/>Entti Ayhude Woosa Keethatan daro lo77iya oydiya dosoosona; qassi asi banttana mokkiya bessan bonchcho bessi dosoosona. <verse number="40" style="v"/>Entti am77eta keethaa bonqidi, banttaw lo77o daananaw woosa adussoosona; entti ubbaafe aadhdhiya pirddaa ekkana” yaagis.</para>
  <para style="s">Am77ee muxaata</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luuqa 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v"/>Yesuusi Xoossa Keethan muxaata yeggiya saaxiniya matan uttidi, asay ba miishiya he saaxiniyan yeggeyssa be7is; daro dure asay daro miishiya he saaxiniyan yeggoosona. <verse number="42" style="v"/>Issi manqo am77iya yada, nam77u bakkannata he saaxiniyan yeggasu. <verse number="43" style="v"/>Yesuusi ba tamaareta xeegidi, “Taani hinttew tuma odays; muxaata saaxiniyan yeggida asa ubbaafe ha manqo am77iya darssada yeggasu. <verse number="44" style="v"/>Ays giikko, harati ubbay bantaw palahida miishiyappe yeggidosona. Shin iya ba pacciyaafe, baw de7iya aquwaa kumethi immasu” yaagis.</para>
  <chapter number="13" style="c"/>
  <para style="s">Yesuusi Xoossa Keethay laalettanayssa koyrottidi odis</para>
  <para style="r">(<ref loc="MAT 24:1-2">Maato 24:1-2</ref>; <ref loc="LUK 21:5-6">Luuqa 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Yesuusi Xoossa Keethafe keyishin, iya tamaaretappe issoy, “Asttamaariyaw, ha lo77o shuchchaanne ha lo77o shuchcha keethaa be7ay!” yaagis.</para>
  <para style="p">
    <verse number="2" style="v"/>Yesuusi zaaridi, “Ha gita shuchcha keethaa be7ay? Ha keethay shuchchi shuchcha bolla gimbbettida mela laalettonna attenna; issi shuchchika attonna ubbay laalettana” yaagis.</para>
  <para style="s">Goday yaanappe koyrottidi gakkana goodaanne waayiya</para>
  <para style="r">(<ref loc="MAT 24:3-14">Maato 24:3-14</ref>; <ref loc="LUK 21:7-19">Luuqa 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v"/>Yesuusi Xoossa keethafe hini baggara Shamaho Deriya bolla uttidashin, Phexiroosi, Yayqoobi, Yohaannisinne Inddiriyasi banttarkka iyaakko yidi, <verse number="4" style="v"/>“Hayssi awude hananeekko, nuus oda; ha ubbay polettana wodiya erisiya malaatay aybee?” yaagidi oychchidosona.</para>
  <para style="p">
    <verse number="5" style="v"/>Yesuusi qassi enttako hayssada yaagidi odis. “Hinttena oonikka balethonna mela naagettite. <verse number="6" style="v"/>Daro asati ta sunthan, ‘Taani Kiristtoosa’ yaagidi tamaarssishe yidi, daro asaa balethana. <verse number="7" style="v"/>Matan de7iya olaanne haahon de7iya ola wore hintte si7iya wode hirggofite. Hessa melabay hananaw bessees, shin wurssethay buroona. <verse number="8" style="v"/>Issi biittaa asay hara biitta asaara olettana; qassi issi kawotethay hara kawotethatara olettana; biittaa qaaxoy ubba bessan hanana; koshay daana, shin hessi ubbay yelo iqethas zooke mela.</para>
  <para style="p">
    <verse number="9" style="v"/>“Shin hinttee, hintte huu7en naagettite. Ays giikko, asi hinttena oykkidi, pirdda keethas aathi immana; qassi Ayhude Woosa Keethatankka hinttena lisson garaafana; deriya haareyssata sinthaninne kawota sinthan ta gisho hintte markkattanaw eqqana.<note caller="-" style="x"><char style="xo" closed="false">13:9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Maato 10:17-20</ref>; <ref loc="LUK 12:11-12">Luuqa 12:11-12</ref></char></note> <verse number="10" style="v"/>Wurssethay gakkanaappe sinthe Wonggelay koyro dere ubbaas odettanaw bessees. <verse number="11" style="v"/>Entti hinttena pirdda keethi ehiya wodenne aathi immiya wode, woygidi odaneekko koyro hirggofite; he saatiyan Xoossay hinttew immiyabaa odite. Hinttenan Geeshsha Ayyaanay odetteesippe attin hinttena gidekketa.</para>
  <para style="p">
    <verse number="12" style="v"/>“Ishay ba ishaa, aaway ba na7aa wodhisana. Nayti banttana yelidayssata bolla denddidi, entta wodhisana. <verse number="13" style="v"/>Asay ubbay hinttena ta sunthaa gisho ixxana, shin wurssethi gakkanaw minniday attana.<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Maato 10:22</ref></char></note></para>
  <para style="s">Yerusalaame gakkana iita metuwa</para>
  <para style="r">(<ref loc="MAT 24:15-28">Maato 24:15-28</ref>; <ref loc="LUK 21:20-24">Luuqa 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>“Shin bashshaa tunatethay eqqanaw bessonna bessan eqqidashin hintte be7ana.” (Akeekiso: Hessi woy guusseeko nabbabeyssi akeeko!) “Yihuda biittan he wode de7eyssati deriyakko baqato.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 9:27">Zaare 9:27</ref>; <ref loc="DEU 11:31">11:31</ref>; <ref loc="DEU 12:11">12:11</ref></char></note> <verse number="15" style="v"/>Keetha huu7en de7iya uraykka issibaa ekkanaw duge wodhdhidi, ba soo geloppo.<note caller="-" style="x"><char style="xo" closed="false">13:15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luuqa 17:31</ref></char></note> <verse number="16" style="v"/>Gaden de7eyssi ba ma7uwa ekkanaw guye simmofo. <verse number="17" style="v"/>He wode qanthatida maccasatasinne dhanthiya maccasatas daro un77a gidana. <verse number="18" style="v"/>Shin hayssi ubbay haniya wodey balggo gidonna mela, Xoossaa woossite. <verse number="19" style="v"/>Ays giikko, Xoossay alamiya medhdhida wodiyappe doomidi, ha77i gakkanaw haniboonna metoynne sinthafekka hanonna metoy asa bolla he wode hanana.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 12:1">Zaare 12:1</ref>; <ref loc="REV 7:14">Yo@Qo 7:14</ref></char></note> <verse number="20" style="v"/>Goday he gallasata taybuwa guuthonaako, ase gididay oonikka attenna. Shin I ba doorida asa gisho, he gallasata taybuwa guuthees.</para>
  <para style="p">
    <verse number="21" style="v"/>“He wode oonikka hinttena, ‘Hekko, Kiristtoosi hayssan de7ees woykko Kiristtoosi hinin de7ees’ yaagikko, hessa ammanoppite. <verse number="22" style="v"/>Worddanchcho Kiristtoosatinne worddo nabeti denddidi bantaw dandda7ettiko, hari attoshin Xoossay dooridayssatakka balethanaw malaatatanne malaalisiyabata bessana. <verse number="23" style="v"/>Shin hintte naagettite; taani hinttew ubbabaa kasetada odas.</para>
  <para style="s">Kiristtoosa nam77antho yuussaa</para>
  <para style="r">(<ref loc="MAT 24:29-31">Maato 24:29-31</ref>; <ref loc="LUK 21:25-28">Luuqa 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v"/>“Shin he wode he waayiyappe guye,</para>
  <para style="q">away dhumana;</para>
  <para style="q2">ageenay poo7uwa aggana;<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JER 2:10">Er 2:10</ref></char></note></para>
  <para style="q1">
    <verse number="25" style="v"/>xoolinttoti saloppe kunddana;</para>
  <para style="q2">qassi salon de7iya wolqqatikka qaaxxana.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="REV 6:13">Yo@Qo 6:13</ref>; <ref loc="JER 2:10">Er 2:10</ref></char></note></para>
  <para style="m">
    <verse number="26" style="v"/>He wode Asa Na7ay, gita wolqqaranne bonchchuwara shaara giddora yishin entti be7ana.<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DEU 7:13">Zaare 7:13</ref>; <ref loc="REV 1:7">Yo@Qo 1:7</ref></char></note> <verse number="27" style="v"/>He wode taani kiitanchchota sa7a oyddu bagga kiittana; sa7a gaxappe saluwa gaxa gakkanaw, Xoossay doorida asa shiishana.</para>
  <para style="s">Wodey gakkidayssa erisiya balase mithiw</para>
  <para style="r">(<ref loc="MAT 24:32-35">Maato 24:32-35</ref>; <ref loc="LUK 21:29-33">Luuqa 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v"/>“Leemisuwa balase mithaafe akeekite; balasiya aaciya wodenne I haythay cil77iya wode, torchchey matattidayssa hintte ereeta. <verse number="29" style="v"/>Hessadakka, hintte he ubbabay haneyssa be7iya wode, I matidi pengge gakkidayssa erite. <verse number="30" style="v"/>Taani hinttew tuma odays; ha ubbabay hanana gakkanaw hayssan de7iya asay ubbay hayqqenna. <verse number="31" style="v"/>Saloynne sa7ay aadhdhana, shin ta qaalay ubbarakka aadhdhenna.</para>
  <para style="s">Goday yaana gallasaanne saatiya oonikka erenna</para>
  <para style="r">(<ref loc="MAT 24:36-44">Maato 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>“Shin he gallasaanne he saatiya Aawa xalaalappe attin hari attoshin salon de7iya kiitanchchota gidin woykko Na7aa gidin oonikka erey baawa.<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">Maato 24:36</ref></char></note> <verse number="33" style="v"/>He wodey awude gidaneekko, hintte eronna gisho, naagettitenne minnite. <verse number="34" style="v"/>Ta yuussay ba keetha aggidi, oge biya uraa mela. Uray ba aylleta huu7en huu7en oosuwa immidi entta ba oosuwas aawa oothis; qassi naageysika minthidi naagana mela kiittis.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">Luuqa 12:36</ref></char></note></para>
  <para style="p">
    <verse number="35" style="v"/>“Hessa gisho, minnite. Ays giikko, keethaaway omarssi gidin woykko giddi bilahe gidin woykko kutto waaso gidin woykko wontta guura gidin awude yaanekko, hintte erekketa. <verse number="36" style="v"/>Hintte akeekonna I yidi hinttena dhiskkidi de7ishin demmonna mela minnite. <verse number="37" style="v"/>Taani hinttew odeyssa asa ubbaas odays; minnite” yaagis.</para>
  <chapter number="14" style="c"/>
  <para style="s">Kiristtoosa bolla maqettidosona</para>
  <para style="r">(<ref loc="MAT 26:1-5">Maato 26:1-5</ref>; <ref loc="LUK 22:1-2">Luuqa 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Faasika Baale bonchchiya gallasaynne Uytha Baale bonchchiya gallasay gakkanaw nam77u gallasi attis. Kahine halaqatinne higge asttamaareti asi eronna Yesuusa oykkidi wodhdhiya oge koyoosona.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kessa 12:1</ref></char></note> <verse number="2" style="v"/>“Asay ooshshaa kessonna mela Faasika bonchchiya gallasan hessa oothoko” yaagidosona.</para>
  <para style="s">Yesuusa shittuwa tiyida maccasiw</para>
  <para style="r">(<ref loc="MAT 26:6-13">Maato 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoha 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v"/>Yesuusi Bitaaniya kataman baro hargganchchuwa Simoona son gibira bolla uttidashin, issi maccasiya albasxiroose giya shuchchafe oosettida philqqaaxe kumetha narddoose giya daro al77o shitto ekkada yasu. He philqqaaxiya menthada shittuwa Yesuusa huu7iyan tigasu.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luuqa 7:37</ref></char></note> <verse number="4" style="v"/>He bessan de7iya asappe issoy issoy hanqettidi, “Ha shittoy mela coo iitey aybisse? <verse number="5" style="v"/>Ha shittuwa heedzu xeetu dinaaren <note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fk" closed="false">heedzu xeetu dinaare: </char><char style="ft" closed="false">Issi asas laythan cigettiya lo77o daamozeppe bolla gidiya miishe.</char></note> bayzidi, miishiya manqotas immanaw dandda7ettees” yaagidi bantta giddon odettidosona. Yaatidi, he maccasiw daro boridosona.</para>
  <para style="rem">fig 8 fig*</para>
  <para style="p">
    <verse number="6" style="v"/>Shin Yesuusi “Ha maccasiw aykkoka gooppite; iyo ays waaysetii? Iya taw lo77obaa oothasu. <verse number="7" style="v"/>Manqoti ubba wode hinttera de7oosona. Hintte koyida wode awudekka hintte entta maaddanaw dandda7eeta, shin taani ubba wode hinttera de7ikke.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Zaare 15:11</ref></char></note> <verse number="8" style="v"/>Iya ba dandda7idayssa oothasu; qassi tana moogos giigisanaw kasetada shitto tiyasu. <verse number="9" style="v"/>Taani hinttew tuma odays; sa7a ubban Wonggelaa odiyason awunkka, asay iyo akeekana mela ha iya oothidayssi odettana” yaagis.</para>
  <para style="s">Yihudi Yesuusa aathidi immanaw zorettis</para>
  <para style="r">(<ref loc="MAT 26:14-16">Maato 26:14-16</ref>; <ref loc="LUK 22:3-6">Luuqa 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v"/>Tammanne nam77u tamaaretappe issoy Asqoroota Yihuda geetetteyssi Yesuusa kahine halaqatas aathi immanaw enttako bis. <verse number="11" style="v"/>Entti hessa si7ida wode ufayttidi, “Nuuni new miishe immana” yaagidosona; Yihudi Yesuusa aathi immanaw injje wode koyees.</para>
  <para style="s">Yesuusi ba tamaaretara Faasika mis</para>
  <para style="r">(<ref loc="MAT 26:17-25">Maato 26:17-25</ref>; <ref loc="LUK 22:7-14">Luuqa 22:7-14</ref>, <ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoha 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Uythaa miya gallas bonchchiya koyro gallas, Faasika kathaa maanaw maraze shukkiya wode, Yesuusa tamaareti iyakko, “Faasika bonchchiya gallas neeni maana kathaa nuuni aw bidi giigisino?” gidi oychchidosona.</para>
  <para style="p">
    <verse number="13" style="v"/>Yesuusi ba tamaaretappe nam77ata hayssada yaagidi kiittis: “Katamaa biite; hintte bishin, otora haathe tookkida issi uray hinttera gahettana; iya kaallite. <verse number="14" style="v"/>I bidi geliya keethaawa, ‘Asttamaarey neekko, “Taani ta tamaaretara Faasika maanaw imatha kifiley awunee?” yaagees’ yaagite. <verse number="15" style="v"/>Keethaaway hinttena pooqiya bolla de7iya giigi uttida dalgga kifile bessana; hessan giigisite” yaagis.</para>
  <para style="p">
    <verse number="16" style="v"/>He nam77u tamaareti keyidi, katama bidosona; Yesuusi enttaw odidayssada demmidi, Faasika kathaa giigisidosona.</para>
  <para style="p">
    <verse number="17" style="v"/>Sa7ay omarssiya wode Yesuusi tammanne nam77u tamaaretara yaa bis. <verse number="18" style="v"/>Entti uttidi kathi mishin, Yesuusi enttako, “Taani hinttew tuma odays; hinttefe issoy taara meyssi, tana aathi immana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:17-18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz 41:9</ref></char></note></para>
  <para style="p">
    <verse number="19" style="v"/>Iya tamaareti dagammidi, bantta huu7en huu7en, “Tuma taneshsha?” yaagidi iya oychchidosona.</para>
  <para style="p">
    <verse number="20" style="v"/>Yesuusi zaaridi, “He uray hintte tammanne nam77atappe issuwa; I taara issife tushanaw ba uythaa shaatiyan yeddeyssa. <verse number="21" style="v"/>Asa Na7ay, Geeshsha Maxaafay hayqqana gidayssada hayqqana, shin Asa Na7aa, aathi immiya uraa ayye. He uray yelettonna attidaakko iyaw lo77oshin” yaagis.</para>
  <para style="s">Godaa kahuwa</para>
  <para style="r">(<ref loc="MAT 26:26-30">Maato 26:26-30</ref>; <ref loc="LUK 22:14-20">Luuqa 22:14-20</ref>; <ref loc="1CO 11:23-25">1Qoro 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v"/>Entti miishin, Yesuusi uythaa ekkidi, Xoossaa galatis; he uythaa menthidi, ba tamaaretas immishe, “He7ite, hayssi ta ashuwa” yaagis.</para>
  <para style="p">
    <verse number="23" style="v"/>Xuu7aa ekkidi, Xoossaa galatidi, enttaw immin ubbayka he xuu7appe uyidosona. <verse number="24" style="v"/>Yesuusi, “Hayssi ooratha caaquwan daro asaa gisho gukkiya ta suuthaa. <verse number="25" style="v"/>Taani hinttew tuma odays; taani Xoossaa kawotethan ooratha woyniya uyana gallasay gakkanaw zaarada ha woyniyappe uyikke” yaagis.</para>
  <para style="p">
    <verse number="26" style="v"/>Mazmure yexxidaappe guye, Shamaho Deriya bolla bidosona.</para>
  <para style="s">Phexiroosi kaddanayssa Yesuusi koyrottidi odis</para>
  <para style="r">(<ref loc="MAT 26:31-35">Maato 26:31-35</ref>; <ref loc="LUK 22:31-34">Luuqa 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoha 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>Yesuusi enttako, “Hintte ubbay tana yeggi aggidi baqatana; Geeshsha Maxaafay,</para>
  <para style="q">‘Xoossay dorssa heemmeyssa wodhana,</para>
  <para style="q2">dorssati ubbay laalettana’</para>
  <para style="m">yaagees.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zakka 13:7</ref></char></note> <verse number="28" style="v"/>Shin taani hayqoppe denddidaappe guye, hinttefe kasetada Galiila baana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Maato 28:16</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v"/>Phexiroosi zaaridi, “Entti ubbay nena yeggi aggidi baqatikkoka, ta nena aggike” yaagis.</para>
  <para style="p">
    <verse number="30" style="v"/>Yesuusi Phexiroosakko, “Taani new tuma odays; hachchi qamma kuttoy nam77u toho waassanaappe sinthe neeni tana heedzu toho kaddana” yaagis.</para>
  <para style="p">
    <verse number="31" style="v"/>Shin Phexiroosi kaseyssafe minthidi, “Taani hari attoshin, neera issife hayqqiyakokka, nena kaddike” yaagis. Qassi harati ubbatikka hessada gidosona.</para>
  <para style="s">Yesuusi Geetesemaanen woossis</para>
  <para style="r">(<ref loc="MAT 26:36-46">Maato 26:36-46</ref>; <ref loc="LUK 22:39-46">Luuqa 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>Geetesemaane giya bessaa bidosona; Yesuusi ba tamaaretakko, “Taani Xoossaa woossada simmana gakkanaw hintte hayssan uttishite” yaagis.</para>
  <para style="p">
    <verse number="33" style="v"/>Yesuusi Phexiroosa, Yayqoobanne Yohaannisa baara ekkidi bis; daro waayettisinne un77ettis. <verse number="34" style="v"/>Qassi enttako, “Taani hayqqana gakkanaw azzanas, hayssan gam77ishite; dhiskkofite” yaagis.</para>
  <para style="p">
    <verse number="35" style="v"/>Guuthi sinthe shiiqidi, sa7an gufannidi, dandda7ettiyabaa gidikko, he waayiya saatey baappe aadhdhana mela, Xoossaa woossis. <verse number="36" style="v"/>Qassi, “Abbaa, ta Aawaw, ubbabay new dandda7ettees, ha waaye xuu7aa taappe digga. Shin ne sheney hanoppe attin ta sheney hanoppo” yaagis.</para>
  <para style="p">
    <verse number="37" style="v"/>Yesuusi ba tamaaretakko simmi yidi, entti dhiskkidashin demmidi, Phexiroosakko, “Simoonaa, dhiskkadii? Neeni issi saatekka barkkada naaganaw dandda7abiikkii? <verse number="38" style="v"/>Paacen hintte gelonna mela barkkidi naagitenne Xoossaa woossite. Hinttew lo77o amoy de7ees, shin hintte daaburanchcho asi” yaagis.</para>
  <para style="p">
    <verse number="39" style="v"/>Qassika bidi kaseyssadakka Xoossaa woossis. <verse number="40" style="v"/>Ba tamaaretakko guye simmidi yaa wode, dhiskkidashin demmis. Entta ayfiyaa dhiskkoy goozi wothida gisho, iyaakko ay odettiyakokka erokkona.</para>
  <para style="p">
    <verse number="41" style="v"/>Heedzantho enttako yidi, “Ha77i gakkanawukka dhiskkeetinne shemppetii? Hiza, gidana; saatey gakkis; be7ite! Asa Na7ay, nagaranchcho asatas aadhdhi imettana wodey gakkis. <verse number="42" style="v"/>Denddidi yedhdhite; be7ite, tana aathi immanayssi gakkis” yaagis.</para>
  <para style="s">Yesuusi ba morkketa kushen oykettis</para>
  <para style="r">(<ref loc="MAT 26:47-56">Maato 26:47-56</ref>; <ref loc="LUK 22:47-53">Luuqa 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoha 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v"/>Yesuusi hessa buroo odishin, tammanne nam77u iya tamaaretappe issoy, Yihudi, ellesidi gakki wodhdhis. Qassi kahine halaqati, higge asttamaaretinne cimati kiittin, bisonne xam77a oykkida daro asay iyara issife yidosona. <verse number="44" style="v"/>Yesuusa aathi immanayssi he daro asaas, “Taani yeerey iya; iya oykkidi, loythi naagidi, ekki efite” yaagidi malla odi wothis.</para>
  <para style="p">
    <verse number="45" style="v"/>Yihudi gakki wodhdhida mela Yesuusakko shiiqidi, “Asttamaariyaw” yaagidi Yesuusa yeeri ekkis. <verse number="46" style="v"/>He daro asay Yesuusa oykkidosona. <verse number="47" style="v"/>Shin matan eqqidayssatappe issoy ba bisuwa shoddidi kahine halaqaa aylliya shocidi, iya haytha qanxidi holis.</para>
  <para style="p">
    <verse number="48" style="v"/>Yesuusi zaaridi, he shiiqida daro asaakko, “Tana pangga kessidi, pangga oykkeyssada oykkanaw bisonne xam77a oykkidi yidetii? <verse number="49" style="v"/>Taani Xoossa Keethan tamaarssashe, gallas gallas hinttera de7iya wode tana oykkibeekketa, shin Geeshsha Maxaafay gidayssi polettanaw bessees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luuqa 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note></para>
  <para style="p">
    <verse number="50" style="v"/>Iya tamaareti ubbay iya yeggi aggidi baqatidosona.</para>
  <para style="p">
    <verse number="51" style="v"/>Laxana xalaala ma77ida issi naatetha uray Yesuusa kaalleyssa asay oykkis. <verse number="52" style="v"/>Shin he uray laxana yeggi aggidi, xire kallo baqatis.</para>
  <para style="s">Yesuusa pirdda Shanggo sinthe efidosona</para>
  <para style="r">(<ref loc="MAT 26:57-68">Maato 26:57-68</ref>; <ref loc="LUK 22:54-55">Luuqa 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoha 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v"/>Asay Yesuusa kahine halaqaa soo efidosona. Yan kahine halaqati, cimatinne higge asttamaareti shiiqidi de7oosona. <verse number="54" style="v"/>Phexiroosi kahine halaqaa zabbaa gakkanaw haahon iya kaalli bidi yan naageyssatara uttidi tama kayees.</para>
  <para style="p">
    <verse number="55" style="v"/>Kahine halaqatinne shiiqida asay ubbay Yesuusa wodhanaw iya bolla markka koyidosona, shin aykkoka demmibookkona. <verse number="56" style="v"/>Daro asati iya bolla worddo markkattidosona, shin entta markkatethay issino gidenna.</para>
  <para style="p">
    <verse number="57-58" style="v"/>Issi issi asati denddi eqqidi Yesuusa bolla, “I, ‘Taani asi keexida ha Xoossa Keetha laallada, asa kushen keexettiboonna hara Xoossa Keetha heedzu gallasa giddon keexana’ gishin nuuni si7ida” yaagidi worddo markkattidosona.<note caller="-" style="x"><char style="xo" closed="false">14:57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoha 2:19</ref></char></note> <verse number="59" style="v"/>Gidoshin, entta markkatethay hessankka issino gidenna.</para>
  <para style="p">
    <verse number="60" style="v"/>Kahine halaqay asa ubbaa sinthan denddi eqqidi, “Hayssati nena mootiya mootuwas ne zaariyabay baawe?” yaagidi Yesuusa oychchis. <verse number="61" style="v"/>Shin Yesuusi si7i gis; aykkoka zaaribeenna. Kahine halaqay, “Anjjettida Xoossaa Na7ay, Kiristtoosi neneyye?” yaagidi zaari oychchis.</para>
  <para style="p">
    <verse number="62" style="v"/>Yesuusi zaaridi, “Ee tana, hintte Asa Na7ay, wolqqaama Xoossaafe ushachcha baggara uttidashin qassi saluwa shaarara yishin be7ana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref></char></note></para>
  <para style="p">
    <verse number="63" style="v"/>Kahine halaqay ba ma7uwa peedhidi, “Nuna hara markka ay koshshii? <verse number="64" style="v"/>Hintte iya cashshaa si7ideta; hintte qofay aybee?” yaagis. Entti ubbay, “I hayqqanaw bessees” yaagidi iya bolla pirddidosona.<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">Leewe 24:15</ref></char></note></para>
  <para style="p">
    <verse number="65" style="v"/>Enttafe issoti issoti iya bolla cutethi oykkidosona. Iya ayfiyaa goozidi baqqishe, “Nena dechchiday oonee? Ane nuus oda!” yaagidosona. Naageyssati iya ekki efidi garaafidosona.</para>
  <para style="s">Phexiroosi Yesuusa kaddis</para>
  <para style="r">(<ref loc="MAT 26:69-75">Maato 26:69-75</ref>; <ref loc="LUK 22:56-62">Luuqa 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoha 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v"/>Phexiroosi kahine halaqaa zabban garssa baggara de7ishin, kahine halaqaa macca aylletappe issinniya yaa yasu. <verse number="67" style="v"/>Phexiroosi tama kayeyssa be7ada, tishshi ootha xeellada, “Neenikka Naazirete Yesuusara de7aasa” yaagasu.</para>
  <para style="p">
    <verse number="68" style="v"/>Shin Phexiroosi, “Ne geyssi aybeekko ta erikke, taw akeekettenna” yaagidi kaddis. Yaagi simmidi zago keyaa wode sohuwara kuttoy waassis.</para>
  <para style="p">
    <verse number="69" style="v"/>He aylliya Phexiroosa be7ada, iya matan eqqida asatakko, “Ha uraykka enttara de7ees” gada zaara odasu. <verse number="70" style="v"/>Shin Phexiroosi qassika kaddis.</para>
  <para style="p">Guuthi gam77ishin, matan eqqida asati nam77antho Phexiroosakko, “Neeni Galiila biitta asi gidiya gisho tuma enttara de7aasa” yaagidosona.</para>
  <para style="p">
    <verse number="71" style="v"/>Shin Phexiroosi, “Taani hintte giya uraa erikke!” yaagidi bana qanggethinne caaqo oykkis.</para>
  <para style="p">
    <verse number="72" style="v"/>Sohuwara kuttoy nam77antho waassi aggis. Phexiroosi Yesuusi iyaakko, “Neeni kuttoy nam77u toho waassanaappe sinthe heedzu toho tana kaddana” iyaakko gidayssa akeekidi daro yeekkis.</para>
  <chapter number="15" style="c"/>
  <para style="s">Yesuusa Philaaxoosakko efidosona</para>
  <para style="r">(<ref loc="MAT 27:1-2">Maato 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luuqa 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoha 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Wontta guura ellesidi kahine halaqati, cimati, higge asttamaaretinne Ayhude shanggoti ubbay shiiqidi maqettidosona. Entti Yesuusa qachchi efidi Philaaxoosas aathi immidosona.</para>
  <para style="p">
    <verse number="2" style="v"/>Philaaxoosi iyakko, “Neeni Ayhudeta kawo?” yaagidi oychchis.</para>
  <para style="p">Yesuusi zaaridi, “Ne gadasa” yaagis.</para>
  <para style="p">
    <verse number="3" style="v"/>Kahine halaqati Yesuusa daroban mootidosona. <verse number="4" style="v"/>Shin Philaaxoosi zaaridi Yesuusakko, “New zaariyabay baawe? Entti ne bolla ay mela mootuwa ehiyakko be7ikki?” yaagis.</para>
  <para style="p">
    <verse number="5" style="v"/>Shin Yesuusi harabaa zaaronna ixxin, Philaaxoosi malaalettis.</para>
  <para style="s">Yesuusa hayqo gidi pirddidosona</para>
  <para style="r">(<ref loc="MAT 27:15-26">Maato 27:15-26</ref>; <ref loc="LUK 23:13-25">Luuqa 23:13-25</ref>; <ref loc="JHN 18:39-40">Yoha 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v"/>Philaaxoosas Faasika Baale bonchchiya gallasan asay koyaa issi uraa qashoppe billiya meezey de7ees. <verse number="7" style="v"/>He wode issi Barbbaana giya uray ooshshaa kessidi shemppo wodhida asatara issife qasho keethan de7ees. <verse number="8" style="v"/>Shiiqida daro asay Philaaxoosi kaseyssada oothana mela iya oychchidosona. <verse number="9" style="v"/>Philaaxoosi asa zaaridi, “Taani hinttew Ayhudeta kawuwa billanayssa koyeetii?” yaagidi oychchis. <verse number="10" style="v"/>Hessa I giday, kahine halaqati Yesuusa qanaattidi aathi immidayssa eriya gishossa.</para>
  <para style="p">
    <verse number="11" style="v"/>Shin kahine halaqati Yesuusa gisho Barbbaana billanaada, he shiiqida asay Philaaxoosa woossana mela asa maqqidosona. <verse number="12" style="v"/>Philaaxoosi zaaridi, “Yaatin, ha hintte Ayhude kawo geyssa waato?” yaagis.</para>
  <para style="p">
    <verse number="13" style="v"/>Asay Philaaxoosa bolla waassidi, “Masqaliya bolla iya kaqqa” yaagidosona.</para>
  <para style="p">
    <verse number="14" style="v"/>Philaaxoosi asaakko, “Ays? I ay iitabaa oothidee?” yaagis.</para>
  <para style="p">Shin asay kaseyssafe gujji waassidi, “Masqaliya bolla iya kaqqa” yaagidosona.</para>
  <para style="p">
    <verse number="15" style="v"/>Philaaxoosi asaa ufayssanaw koyidi, Barbbaana asaas billis; yaatidi lisson Yesuusa garaafidi, masqaliya bolla kaqqana mela enttaw aathi immis.</para>
  <para style="s">Wotaaddareti Yesuusa toochchidosona</para>
  <para style="r">(<ref loc="MAT 27:27-31">Maato 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoha 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v"/>Hessafe guye, wotaaddareti Yesuusa deriya haareyssa ooso keetha ekki efidi, hara wotaaddareta ubbaa issife xeegidosona. <verse number="17" style="v"/>Qassi zo7o afilaa iya mayzidosona; aguntha kalachcha giigisidi, iya huu7en wothidosona. <verse number="18" style="v"/>Hessafe guye, iyakko, “Ayhudeta kawuwaw mirinaw kawota” yaagidi, iyaw ziggidosona. <verse number="19" style="v"/>Iya huu7iya xam77an shoccidosona; qassi iya bolla cuttidosona; gulbbatidi iyaw goynnidosona. <verse number="20" style="v"/>Iya toochchidayssafe guye zo7o afilaa iyappe qaari ekkidi, iya afilaa iya mayzidi masqaliya bolla iya kaqqanaw ekki efidosona.</para>
  <para style="s">Yesuusa kaqqidosona</para>
  <para style="r">(<ref loc="MAT 27:32-44">Maato 27:32-44</ref>; <ref loc="LUK 23:26-43">Luuqa 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Entti bishe, Iskkinddirenne Rufosa aawa, Simoona giya Qerena biitta asi, gaxareppe katama yeyssara gahettidi, Yesuusa masqaliya wolqqan toossidosona.<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">Roome 16:13</ref></char></note> <verse number="22" style="v"/>Yaatidi Golggotta giya bessaa Yesuusa efidosona. “Golggotta” guussay “Huu7e guugge” guussu. <verse number="23" style="v"/>Sakoy si7ettonna mela karbbe giya dhaley walakettida woyne uyo gidi iyaw immidosona. Shin I uyonna ixxis. <verse number="24" style="v"/>Entti masqaliya bolla iya kaqqidosona. Oona aybi gakkaneekko gidi iya afilaa shaakkidi saama yeggidosona.</para>
  <para style="p">
    <verse number="25" style="v"/>Entti masqaliya bolla iya kaqqiya wode wonttafe heedzu saate. <verse number="26" style="v"/>Entti, “Ayhudeta kawuwa” yaagidi iya mootiya xuufe xaafidi wothidosona. <verse number="27" style="v"/>Yesuusara nam77u panggata issuwa iyappe ushachcha baggara hankkuwa iyappe haddirssa baggara masqaliya bolla kaqqidosona. <verse number="28" style="v"/>Geeshsha Maxaafay, “Iitabaa oothida asatara I paydettis” geetettidayssi polettis.<note caller="-" style="x"><char style="xo" closed="false">15:27-28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref></char></note></para>
  <para style="p">
    <verse number="29" style="v"/>Ogiyara aadhdhiya asay Yesuusa kadhidi, bantta huu7iya qaathiddi cayidosona; “Hekko! Xoossa Keetha laallada heedzu gallasa giddon keexeysso, ne huu7iya ashsha;<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maz 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="JHN 2:19">Yoha 2:19</ref></char></note> <verse number="30" style="v"/>ane masqaliya bollafe wodhdha” yaagidosona.</para>
  <para style="p">
    <verse number="31" style="v"/>Hessadakka, kahine halaqati higgiya tamaarsseyssatara issife Yesuusa toochchidi, “Harata ashshis, shin bana ashshanaw dandda7enna; <verse number="32" style="v"/>nuuni be7idi ammanana mela Kiristtoosi, Isra7eele Kawoy, ane masqaliya bollafe ha77i wodhdho” yaagidosona. Qassi hari attoshin, iyara masqaliya bolla kaqettidayssatikka iya toochchidosona.</para>
  <para style="s">Yesuusi hayqqis</para>
  <para style="r">(<ref loc="MAT 27:45-56">Maato 27:45-56</ref>; <ref loc="LUK 23:44-49">Luuqa 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v"/>Usuppun saateppe doomidi, uddufun saate gakkanaw biitta ubbay dhumis. <verse number="34" style="v"/>Uddufun saatiyan Yesuusi ba qaala dhoqqu oothidi, “Elohee, Elohee, laama sabaqitani?” yaagis. Hessa guussay, “Ta Xoossaw, ta Xoossaw, tana ays aggadi?” guussu.<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maz 22:1</ref></char></note></para>
  <para style="p">
    <verse number="35" style="v"/>Hessan eqqida asappe issoy issoy hessa si7idi, “Hekko, Eliyaasa xeegees” yaagis. <verse number="36" style="v"/>He asappe issoy woxxidi, ispponjjen caala woyne kunthis; hessa xam77a xeeran wothidi, “Naagite; Eliyaasi masqaliyappe iya wodhisanaw yaanekko ane be7oos” yaagidi Yesuusa doonaakko ushshanaw shiishis.<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz 69:21</ref></char></note></para>
  <para style="p">
    <verse number="37" style="v"/>Yesuusi ba qaala dhoqqu oothi waassidi, hayqqis.</para>
  <para style="p">
    <verse number="38" style="v"/>Xoossa Keethan kaqettida magaraajjoy qommofe duge gakkanaw, nam77u keyidi daaketi wodhdhis.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Kessa 26:31</ref></char></note> <verse number="39" style="v"/>Masqaliyappe sintha baggara yan eqqida issi mato halaqay, Yesuusi waanidi hayqqidaakko be7ida wode, “Ha uray tuma Xoossaa Na7a” yaagis.</para>
  <para style="p">
    <verse number="40" style="v"/>Hessa haahon eqqidi be7iya guutha maccasati de7oosona. Entta giddon Magdela Mayraama, kaaluwa Yayqoobanne Yoosa aayiya Mayraamanne Salooma de7oosona. <verse number="41" style="v"/>He macca asati Yesuusi Galiilan de7iya wode iya kaallidayssatanne iya mokkidayssata qassi Yesuusara issife Yerusalaame bida hara daro macca asati yan de7oosona.<note caller="-" style="x"><char style="xo" closed="false">15:40-41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luuqa 8:2-3</ref></char></note></para>
  <para style="s">Yesuusi moogettis</para>
  <para style="r">(<ref loc="MAT 27:57-61">Maato 27:57-61</ref>; <ref loc="LUK 23:50-56">Luuqa 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v"/>Sa7ay omarssida wode, shiiqida asan bonchchettida Ayhude shanggotappe issoy, Yoosefa giya uray, Xoossaa kawotethay yaanayssa naagishe de7eyssi, Armmatiyasa katama asi de7eyssi yis. Wonttethe Sambbaatas giigettiya gallas gidida gisho, Yoosefi minnidi Philaaxoosakko bidi, Yesuusa ahaa ekkanaw woossis. <verse number="44" style="v"/>Philaaxoosi Yesuusi hayqqidayssa si7ida wode malaalettis; mato halaqaa xeegidi, “I hayqqidi gam77idee?” yaagidi oychchis. <verse number="45" style="v"/>Philaaxoosi Yesuusi hayqqidayssa mato halaqaappe si7idi iya ahaa Yoosefas immis. <verse number="46" style="v"/>Yoosefi moogo afila shammis; Yesuusa ahaa masqaliyappe wothidi, afilan xaaxidi, shuchchafe woocettida duufo giddon iya aha moogis. Qassi he duufuwa doonan gita shuchchu gonddorssidi wothis. <verse number="47" style="v"/>Magdela Mayraamanne Yoosa aayiya Mayraama Yesuusa ahaa entti awun wothiyako be7oosona.</para>
  <chapter number="16" style="c"/>
  <para style="s">Yesuusi hayqoppe denddis</para>
  <para style="r">(<ref loc="MAT 28:1-8">Maato 28:1-8</ref>; <ref loc="LUK 24:1-12">Luuqa 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Sambbaatay aadhdhidaappe guye, Magdela Mayraama, Yayqooba aayiya Mayraamanne Salooma bidi, Yesuusa ahaa tiyanaw shitto shammidosona. <verse number="2" style="v"/>Wogga wode wontta daro guura xalqey caarshin, duufuwa bidosona. <verse number="3" style="v"/>Entti bantta giddon issoy issuwara, “Duufuwa doonappe nuus shuchchaa oonee gonddorssidi digganay?” yaagidi odettidosona.</para>
  <para style="p">
    <verse number="4" style="v"/>Entti xeelliya wode he daro gita shuchchay gonddorettidi kichchidayssa be7idosona. <verse number="5" style="v"/>Yesuusi moogettida duufuwa giddo geliya wode issi pantha addey bootha ma7o ma7idi, ushachcha baggara uttidayssa be7idi dagammidosona.</para>
  <para style="p">
    <verse number="6" style="v"/>Shin I enttako, “Dagammofite; masqaliya bolla kaqettida, Naazirete Yesuusa hintte koyeyssa taani erays. I hayssan deenna, hayqoppe denddis. Entti iya moogida bessaa hayssa be7ite. <verse number="7" style="v"/>Ha77i bidi Yesuusa tamaaretasinne Phexiroosas, ‘Yesuusi hinttefe sinthattidi Galiila bees. I hinttew odidayssada hintte iya yan be7ana’ yaagidi odite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Maato 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref></char></note></para>
  <para style="p">
    <verse number="8" style="v"/>Maccasati yashshan kokkorishe duufuwappe keyidi baqatidosona. Qassi entti yayyida gisho, hessa oodeskka aykkoka odibookkona.<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Issi issi beni maxaafati Marqqoosa Wonggelaa paydo 8 bolla essoosona. Qassi issi issi maxaafati paydo 9-20 gakkanaw de7iya qofaa gujjokona. Gidoshin, paydo 8 kaallidi de7iya gujjoosona. Hessika [Maccasati bidi, kiitanchchoy odidabaa ubbaa Phexiroosasinne iyara de7eyssatas qanthan odidosona. Hessafe guye, Yesuusi ba tamaareta geeshshinne merinaa atotethaa Wonggelaa kiitaa dolohappe wuloha gakkanaw kiittis.]</char></note></para>
  <para style="s">Yesuusi Magdela Mayraamis benttis</para>
  <para style="r">(<ref loc="MAT 28:9-10">Maato 28:9-10</ref>; <ref loc="JHN 20:11-18">Yoha 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v"/>Yesuusi hayqoppe denddidaappe guye, wogga gallas wontta, laappun tuna ayyaanata kessida Magdela Mayraamis koyrottidi benttis. <verse number="10" style="v"/>Iya bada kase iyara de7eyssatas, entti azzanishenne yeekkishe de7ishin odasu. <verse number="11" style="v"/>Shin Yesuusi paxa de7eyssanne iw benttidayssa entti si7ida wode iya geyssa ammanibookkona.</para>
  <para style="s">Yesuusi nam77u ba tamaaretas benttis</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luuqa 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Hessafe guye, enttafe nam77ati katamaappe keyidi bishin, oge bolla Yesuusi kaseyssafe dummattidi enttaw benttis. <verse number="13" style="v"/>Entti guye simmidi, haratas odidosona, shin haratikka entta odaa tuma gibookkona.</para>
  <para style="s">Yesuusi tammanne issi ba tamaaretas benttis</para>
  <para style="r">(<ref loc="MAT 28:16-20">Maato 28:16-20</ref>; <ref loc="LUK 24:36-49">Luuqa 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Ha@O 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Guyeppe tammanne issi iya tamaareti kathi miishin, Yesuusi enttaw benttis. Enttaw ammanoy baynna gishonne hayqoppe I denddidayssa be7ida asay odin entti ammanonna ixxida gisho I entta boris.</para>
  <para style="p">
    <verse number="15" style="v"/>I enttako, “Biitta ubbaa bidi asa ubbaas Wonggelaa odite.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Ha@O 1:8</ref></char></note> <verse number="16" style="v"/>Ammaneynne xammaqetey attana, shin ammanonnay pirddettana. <verse number="17" style="v"/>Ammaneyssatas ha malaatati imettana. Entti ta sunthan tuna ayyaanata kessana, ooratha doonan odettana. <verse number="18" style="v"/>Entti shooshu oykkikokka woykko wodhiyabaa uyikkoka entta qohenna. Qassi entti bantta kushiya hargganchchota bolla wothidi entta pathana” yaagis.</para>
  <para style="s">Yesuusi pude salo keyis</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luuqa 24:50-53</ref>; <ref loc="ACT 1:9-11">Ha@O 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v"/>Goday Yesuusi tamaaretara odettidaappe guye, pude salo keyis; Xoossaafe ushachcha baggara uttis.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">Ha@O 1:9</ref></char></note> <verse number="20" style="v"/>Iya tamaareti bidaso ubban qaala odidosona. Godaykka enttara issife oothees. Entti odiya qaalay tuma gididayssa Xoossay enttaw immiya malaatatan erisis.</para>
  <para style="restore">02-Oct-2008@09:05, Backup Description=23-Sep-2008@16:55, Ed Owen -</para>
</usx>
