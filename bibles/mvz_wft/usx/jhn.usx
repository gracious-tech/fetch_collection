<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">Mesqan New Testament</book>
  <para style="h">የዮሐንስ ወንጌል</para>
  <para style="toc1">ዮሐንስ የጣᎈን የጔታና የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="toc2">የዮሐንስ ወንጌል</para>
  <para style="toc3">ዮሐ.</para>
  <para style="mt">ዮሐንስ የጣᎈን</para>
  <para style="mt2">የጔታም የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የዮሐንስ ወንጌል የኢየሱስ ያቀርᎅ በሠር ለበሰም በሰብ ግብት የትረከበ ሕያው ይነብር የእዝጌር ቃል ወሕነሑ የወግልጡ፤ መጽሐፊ ነብሰሑ ይጐልጭኸም ዚ ወንጌል የጣፈዪ ያነቦ ኢየሱስ ያተርፍ ኸነም ይቸኝ የቧሪዪ የእዝጌር ትኸ ወሕነሑ ያምኖኸምም በሑቲም በወምነሕኖ የዘለዓለም ሕይወት ይነብሮኸም ይትሬዶኸሙ (ዮሐ. 20፥31)።</para>
  <para style="ip">የወንጌሊ መጀመሪያ ክፍል ዘለዓማዊዪ የእዝጌር ቃል ኢየሱስም ቁና ወሕነሕኖ ቢቈርሽᎄ መልክ ባቀረበ አንቌ ኢየሱስ ያተርፍ ኸነም ይቸኝ የቧርዪ የእዝጌር ትኸ ወሕነሑ ያቴዞዪ የትልያዮ ታምር ያቀርብ፤ በዛም ተዚሕኖ ታምር ምን ውጤት የትረከበኸም ያትሬዶዪ ታሪክ ይትዄተሎይ፤ ዚዋኘ ክፍል ይቴርኲ አታት ሰቦች በኢየሱስ አመኖም የሑቲ ተከታይ ስለወሕነሕኖ፥ እንጐድ ኧሗም ምንኸም የቃወሞይኸም በሑቲ አናምንነ የባሮኸሙ ተምራፍ 13—17 ስን ኢየሱስ በጠበጠወ ምሳር ተደቀ መዛሙርተሑጌ ምናሕር ቅጫ የቀረበ ርሕቦት የነᎄረንኸም በስቅለተሑም የመናጊ የወዝጋጅ ይጥናነᎄ ቃል ያሴማኖኸም ይዝነጎ። የመጨረሻዪ ምራፍ ስለኢየሱስ ወጠበጥም የፍርድ ወቅርብ ስለስቅለተሑ ትንሣኤሑም፥ ዛምኸም በትንሣኤሑ አንቌ የደቀ መዛሙርተሑ ስለመገለጠሑ ይዝነጎዪኖ።</para>
  <para style="ip">ዮሐንስ በኢየሱስ ክርስቶስ መሳ ይትረከቢ ዘለዓለማዊዪ ሕይወት ይታዥኸም ሸከተም ያቴዢ ዚ ጸጋ ተሗ ቀረሰም የኢየሱስ ዬማኸም፥ የኢንኸም፥ የሕይወትኸም ሸከቶም ይቌበሮዪው። የዮሐንስ ወንጌል የትላኘ ይሸኩች መንፈሳዊ ሐቅ የዋትረዳ የሮሺዪም በከነ ኑሮ ኧጠቀምነቦዪ፥ ወበርም የኧጋኸም፥ ቂጣ፥ ብራን፥ ወጅመኘ፥ ኧጤ፥ የወይን አታሕልትም የወይን ፍርየ ይመስሮዪ ቃር በምሳሌ ወጠቀመውታኑ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">የበደረዪ <char style="ior"><ref loc="JHN 1:1-18">1፥1-18</ref> </char></para>
  <para style="io1">ዮሐንስ መጥምቂ የኢየሱስም የመጀመሪያዎቺ ደቀ መዛሙርት <char style="ior"><ref loc="JHN 1:19-51">1፥19-51</ref> </char></para>
  <para style="io1">ኢየሱስ አገልግሎተሑ ወቅርሰሑ <char style="ior"><ref loc="JHN 2:1-12:50">2፥1—12፥50</ref> </char></para>
  <para style="io1">በኢየሩሳሌም በጭጭሳዪም የአገልግሎተሑ የመጨረሻዪ ከነ <char style="ior"><ref loc="JHN 13:1-19:42">13፥1—19፥42</ref> </char></para>
  <para style="io1">የጔታ ትንሣኤ መገለጠሑም <char style="ior"><ref loc="JHN 20:1-31">20፥1-31</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ፦ በገሊላ ዠበረም የደቀ መዛሙርተሑ መገለጠሑ <char style="ior"><ref loc="JHN 21:1-25">21፥1-25</ref> </char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s1">የሕይወት ቃል</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />በመጀመሪያ ቃል ባነ፤ ቃልም በእዝጌሬ ባነ፤ ዚም ቃል እዝጌር ባነ። <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />ሑቲ በመጀመሪያም በእዝጌሬ ባነ። <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />እንም ቃር በሑቲ ተኸለቀ፤ ተትሕለቀዪ እንም፥ አት ቃር ያለሑቲ የትኸለቀ ኤነ። <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />በሑቲ ሕይወት ባነ፤ ዚም ሕይወት የሰብ ብራን ባነ። <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />ብራን በጨለማ ያበራ፤ ጨለማም የብራን አንቌᎀን።<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />በእዝጌር የትላኸ ዮሐንስ ይቡሪ አት ሰብ ባነ።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">ማቴ. 3፥1</ref>፤ <ref loc="MRK 1:4">ማር. 1፥4</ref>፤ <ref loc="LUK 3:1-2">ሉቃ. 3፥1-2</ref>። </char></note> <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />በሑቲ ምስክርነት ሰቦች እንም ያምንኸም ስለብራን ምስክር ኸነም ቸኘ። <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />ሑቲ ስለብራን ይምሰክሬ ቸኘ አንኸንም ሑቲ ብራን አንከነ። <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />የሰብ እንም ያበራዪ የኢኒ ብራን ተዓለሜ ይቸኝ ባነ።<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />ሑቲም በዓለም ውስጥ ባነ፤ ዓለም የትኸለቀ በሑቲቱ፤ ዓለም አንኳረን። <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />ተጐሳዄ ቸኘ፥ የፎለሑ ጐሳ አንትቀበሮይ። <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />የሕን አንከንም የትቌበሮዪም በሽመሑ ያመኖዪ እንም የእዝጌር ዴንጋ የወሕን መብት አበኖ። <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />ሕኖም በእዝጌር ተጨኖ አንከንም በሰብ ዝሬት፥ ወበርም በበሠር ፈአድ፥ በሰብ ፈአድ አንትጨኖ።<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />ቃልም ሰብ ኸነ፤ ጸጋ የኢንም፥ ተመላም በግብተና ቶና፤ ያᎄች ቁና ትኸ ባᎄቼ ያነንኸም ያነዪ ክብረሑ አዠነም።<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />ዮሐንስም “‘ዛ ቢያ አንቌ ይቸኚ ቲያ ኢፍቴ የነበረ ቲያ ስርም ይበዛ’ ባሑም ዬወደኩሑዪ ዘ፥ ዚቱ” ቲብር ምሰከረ።<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />በሑቲ የጸጋ ሙላት ኢና እንመና በጸጋ ᎈር ጸጋ ተቌበርነም። <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />ሕጊ በሙሴ ኤማ አᎅም ባነ፤ ጸጋ የኢንም በኢየሱስ ክርስቶስ ኤማ ቸኘ። <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />የእዝጌር ያዠን ስርም ሟንም ኤነ፤ የሕን አንኸንም በእዝጌር አቤ ያነዪ ቁና ትኸኹ ጠለለ ጐለጠን።<verse eid="JHN 1:18" /></para>
  <para style="s1">የመጥምቂ ዮሐንስ ምስክርነት</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቴ. 3፥1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፥1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፥1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />የአይሑድ ባለሥልጣኖች በኢየሩሳሌም ካሕኒም ሌዋዊ ተዮሐንሴ ላሖም፦ “አኸ ሟንከ?” ባሮም በሳሎይ ግዝየ ያᎄን ምስክርነት ቄጠለም ያነዪዉ፤<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />ሑቲ “እያ ክርስቶስ አንከንኩ” ቲብር ምሰከረ አንከንም አንለጋ።<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />ሕኖም “ኧጌ አኸ ሟንከ? ኤልያስንከ?” ቲብሮ ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">1፥21 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ዘዳ. 18፥15</ref>፤ <ref loc="DEU 18">18</ref>፤ <ref loc="MAL 4:5">ሚል. 4፥5</ref>። </char></note></para>
  <para style="p" vid="JHN 1:21">ሑቲም “አንከንኩ” ቲብር ዠበረኖ።</para>
  <para style="p" vid="JHN 1:21">ሕኖም “ይቸኝ የቧሪዪ ነብይ አኸትንከ?” ባሮይ።</para>
  <para style="p" vid="JHN 1:21">ሑቲም “አንከንኩ” ባረ።<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />ሕኖም “ኧጌ አኸ ሟንከ? የላሖነ ሰቦች መልሰሑ ኢውድነኸም ስለነብሳኸ ምን ትብር?” ባሮይ። <verse eid="JHN 1:22" /><verse number="23" style="v" sid="JHN 1:23" />ሑቲም “ነብዪ ኢሳያስ የዝነጔንኸም</para>
  <para style="q1" vid="JHN 1:23">“እያ ‘የጔታ ኤማ አዝጋዶነ’ ቲብር</para>
  <para style="q2" vid="JHN 1:23">በበረሐ ው ይብር ሰብ ጣምባንኩ” ባረ።<note caller="-" style="x"><char style="xo" closed="false">1፥23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፥3</ref>። </char></note><verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />ሰቦች የትላሖ ተፈሪሳውያኔ ባነ፤ <verse eid="JHN 1:24" /><verse number="25" style="v" sid="JHN 1:25" />ስለኸነም “አኸ ክርስቶስ፥ ኤልያስ፥ ይቸኝ የቧሪዪ ነብይ ባንከንኸ ኧጌ የመአር ታጠምቅ?” ቲብሮ ተሳሎይ።<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />ዮሐንስም እኪ ቲብር ዠበረኖ፦ “እያ አጠምቅ በኧጋው፤ ቢኸንም አሑ አቲሒሮይ በግብታሑ ቈመም። <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />ሑቲ ቲያ አንቌ ይቸኚዉ፤ እያ የጫማዉታን ክር የወፍታ የትጌባሑ አንከንኩ።”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />ዚ የኸነ ዮሐንስ ያጠምቅ በነበረወ በዮርዳኖስ ኧድየ ዛዘር ቢትረከቢ በቢታንያ ከተማው።<verse eid="JHN 1:28" /></para>
  <para style="s1">ኢየሱስ የእዝጌር ኧጤ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />የመናጊ ዮሐንስ ኢየሱስ ተሑቲዬ ቲቸኝ አዠም እኪ ባረ፦ “ዘ፥ የዓለም አጢያት ያጠፋ የእዝጌር የጤ ጠᎄት ዚቱ! <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />‘ዛ ቢያ አንቌ ይቸኚ ቲያ ኢፍቴ ያነ ስለኸነ ቲያ ስርም ይበዛ’ የባኩሑዪ ዚቱ። <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />እያም ነብሰኛ አንሒን ባነ፤ ቢኸንም ሑቲ የእስራኤል ሕዝብ ይታዥኸም እያ በኧጋ ትናጠምቅ ቸኘሑ።”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />ቄጠለም ዮሐንስ እኪ ቲብር ምሰከረ፦ “መንፈስ ቅዱስ የቡላልኸም በሰሜ ወረደም በሑቲ ᎈር ቲያᎈይወ አዠሑ፤ <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />እያ ነብሰኛ አንሒን ባነ፤ ቢኸንም በኧጋ አጠምቅኸም የላሔ፥ ‘መንፈስ ቅዱስ ወረደም በሑቲ ᎈር ቲያᎈይወ ታዥኒ በመንፈስ ቅዱስ ያጠምቅ ሑቲቱ’ ቲብር ኤወዴም። <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />እያም ዚ አዠሑም፤ ስለኸነም ሑቲ የእዝጌር ትኸ ወሕነሑ ኧምሰክር።”<verse eid="JHN 1:34" /></para>
  <para style="s1">የመጀሪያዎቺ የኢየሱስ ደቀ መዛሙርት</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />የመናጊ ዮሐንስ ተዄቲ ደቀ መዝሙርተሑጌ ዠበረም በዛዬ ቈመም ባነ። <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />ዮሐንስ የኢየሱስ በዛ ቲቸለፍ አዠም፤ “ዘ! የእዝጌር ኧጤ” ባረ።<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />ዄቲ የዮሐንስ ደቀ መዝሙር ዮሐንስ ዚ ቲብር ሰሞም፥ የኢየሱስ ተዄተሎይ። <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />ኢየሱስ ዞር ባረም ቲትዄተሎይ አዠም “ምን ትሸዎ?” ባረኖ።</para>
  <para style="p" vid="JHN 1:38">ሕኖም “ረቢ! ቤቴው ትነብር?” ባሮይ። (ረቢ ወበር በአረማይስጥ ቋንቋ አስተማሪ ወበሩ።)<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ሑቲም “ኔሑማሑ ኧዞ” ባረኖ። ስለኸነም ወሮም ቤቴ ይነብርኸም አዞ። በዛ ከነ ተሑቲጌ ቁናዬ ዋሎ፤ ግዝየዪ ዐሥር ሰዓት ቅጫ ባነ።<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />ዮሐንስ የዝነጔኒ ቃል ሰሞም የኢየሱስ ተትዄተሎይ ደቀ መዛሙርት አቲ የስምዖን ጴጥሮስ ጐቤ እንድርያስ ባነ። <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />እንድርያስ በደረም ተጐቤች ተስምዖኔ ወረም “የመሲሕ ረከብኔም!” ቧረን። (መሲሕ ወበር ክርስቶስ ወበሩ።) <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />ተኢየሱሴም አቸኘን።</para>
  <para style="p" vid="JHN 1:42">ኢየሱስም ተምሌኰተንም፤ “አኸ የዮና ትኸ ስምዖንንከ፤ በዚ አንቌ ኬፋ ቧሪም ይጠረከ” ቧረን፤ (ኬፋ ወበር ጴጥሮስ ወበሩ።)<verse eid="JHN 1:42" /></para>
  <para style="s1">ኢየሱስ የፊልጶስ የናትናኤልም የጠራኖኸም</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />የመናጊ ኢየሱስ ተገሊላ ገኜ የወወር ሸ፤ የፊልጶስ ረከᎄንም “ተኸተሌ!” ቧረን። <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />ፊልጶስ የእድርያስኸም የጴጥሮስኸም የቤተ ሳይዳ ከተማ ሰብ ባነ። <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />ፊልጶስ የናትናኤል ረከᎄንም፤ “ሙሴ በሕጊ መጽሐፎች፤ ነብዮችም ስለሑቲ በትምቢት መጽሐፍት ስለሑቲ የጣፎነዪ የዮሴፍ ትኸ የናዝሬቲ ኢየሱስ ረከብኔም” ቧረን። <verse eid="JHN 1:45" /><verse number="46" style="v" sid="JHN 1:46" />ናትናኤልም “በናዝሬት ፈያ ቃር ስርም ይትረከቤ ይችል?” ቧረን። ፊልጶስም “ኔኸማኸ ኧዥ!” ቧረን። <verse eid="JHN 1:46" /><verse number="47" style="v" sid="JHN 1:47" />ናትናኤል ተሑቲዬ ቲቸኝ አዠም ኢየሱስ “ዘ! ሸር ዬነወ የኢንም የእስራኤል ሰብ!” ቲብር ስለሑቲ ዝነጔ። <verse eid="JHN 1:47" /><verse number="48" style="v" sid="JHN 1:48" />ናትናኤልም “ቤቴ ቲሒሬ?” ቧረን። ኢየሱስም “ፊልጶስ ቴጠራኸ ኢፍቴ በበለስ ኧጨ ተት ኸንከም አዠከኸም” ቲብር ዠᎄረነ። <verse eid="JHN 1:48" /><verse number="49" style="v" sid="JHN 1:49" />በዚ ግዝየ ናትናኤል፥ “አስተማሪ! አኸ! የእዝጌር ትኸንከ! አኸ የእስራኤል ንጉሥንከ!” ባረ።<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />ኢየሱስም እኪ ባረ፦ አኸ ያመንከ፥ በበለስ ኧጨ ተት ኸንከም አዠከኸም የባከኸዬው? ተዚ ይበዛ ቃር ገና ታዥ። <verse eid="JHN 1:50" /><verse number="51" style="v" sid="JHN 1:51" />የኢን፥ የኢን ኧብርሑ፦ ሰሜ ቲትከፈት የእዝጌር መላይካም በሰብ ትኸ ᎈር ቲወጦም ቲወርዶ ታዞ።<note caller="-" style="x"><char style="xo" closed="false">1፥51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">ዘፍ. 28፥12</ref>። </char></note><verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s1">ኢየሱስ በቃና ገሊላ ሸቤ ወትረኸበሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />በሦስታለኘዪ ከነ፥ በገሊላ ገኝ ቢትረከቢ ቃና ቢይቡሪ ከተማ ሸቤ ባነ፤ የኢየሱስ ዳኮም በዛ ባነች። <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />ኢየሱስም ደቀ መዛሙርተሑ ተሸቤዬ ጠሮዮም ባነ። <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />በሸቤ ግብዣ መደር የወይን ደጔ ባለቀቦ ግዝየ የኢየሱስ ዳኮ የኢየሱስ፦ “የወይን ደጔ እኮ አለቀቦም!” ባረቹ። <verse eid="JHN 2:3" /><verse number="4" style="v" sid="JHN 2:4" />ኢየሱስም “ዳኮኛ! ታሺጌ ምን ነኔ? ግዝየኛ ገና አንሰላ” ባረና።<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />በዛ ግዝየ ዳኰች በዛ የነብሮዪ አገልጋዮች፦ “ሑቲ ይብሩሑዪ ሰክቶ” ባረቶ።<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />አይሑድ የወታጠብ ሴራ ያነኖ ስለኸነ ስድስት ይምን ጋን በዛ ባኖ፤ እያታቲ ጋን ዄት ሦስትም ወሸን ኧጋ ይጠብጦ ባነ። <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />ኢየሱስ የአገልጋዮቺ “ጋኖቺ ኧጋ ሙሎዮ” ባረኖ፤ ሕኖም አፈሕኖ ስን ᎀሎዮ። <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />በዛ አንቌ ኢየሱስ የአገልጋዮቺ፦ “በይ ኧሗ ግዶም የጋባዢ አላፊ አቦይ” ባረኖ፤ ሕኖም ወሰዶም አቦይ። <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />የግብዣዪ አላፊ ተወይን ደጔዬ የሸገረዪ ኧጋ በቀመሰ ግዝየ፥ ቤቴ የቸኘኸም አንካረ፤ ኧጋዪ የገዶ አገልጋዮች ይሒሮ ባነ፤ ስለኸነም የድግሲ አላፊ፥ ሙሽራዪ ጠራም እኪ ቧረን፦ <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />“ሰብ እንም በደረም ያቀርብ ፈያዪ የወይን ደጔው፤ የባዘናዪ ብዠ በሰጦ አንቌ መንጩርር ያቀርብ፤ አኸም ፈያዪ የወይን ደጔ ኧሗ ስን አቴከስከ።”<verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ኢየሱስ ዚ የታምራት ምልክቶቺ መጀመሪያ በገሊላ አውራጃ በቃና ከተማ ሸከተ፤ ክብረሑ ገለጠ፤ ደቀ መዛሙርተሑ በሑቲ አመኖ።<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />በዛ አንቌ ኢየሱስ ተዳኰሑ ተጐባቢተሑም፥ ተደቀ መዛሙርተሑጌ ተቅፍርናሖሜ ወረደ፤ በዛም ቀል ከነ ቾኖ።<note caller="-" style="x"><char style="xo" closed="false">2፥12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">ማቴ. 4፥13</ref>። </char></note><verse eid="JHN 2:12" /></para>
  <para style="s1">ኢየሱስ በቤተ መቅደስ ይግባኖዪ ዋዉጣሑ</para>
  <para style="r">(<ref loc="MAT 21:12-13">ማቴ. 21፥12-13</ref>፤ <ref loc="MRK 11:15-17">ማር. 11፥15-17</ref>፤ <ref loc="LUK 19:45-46">ሉቃ. 19፥45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />አይሑድ የፋሲካ በዓል ቀረበም ስለኸነ ኢየሱስ ተኢየሩሳሌሜ ወረ፤<note caller="-" style="x"><char style="xo" closed="false">2፥13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ዘፀ. 12፥1-27</ref>። </char></note> <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />በቤተ መቅደስም ቦራዎች፥ ኧጤዎች ቡላሎችም ያስሮዪ ዋጋ ይሸግሮዪም ቾኖም ቲግብያዮ ረከበ። <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />በዛ ግዝየ የወደረ ጅራፍ ታታም የሰቦቺ እንም፥ ተጤዎች ተቦራዎችጌ በቤተ መቅደስ አትዌጣኖ፤ ዋጋ ይሸግሮዪም ዋጋ ቤተነቦ፤ ጠረቤዛሕኖም ግልባበጠቦ። <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />ቡላል ያስሮዪም ሰቦች “ዚ እንም ተዛዬ ዉስዶ! የአባኛ ቤት የንግድ ቤት አትሰክቶይ!” ባረኖ። <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />በዚ ግዝየ ደቀ መዛሙርተሑ “ስለቤታኸ ያኔ ቅናት ይሳትኸም አነደዴም” ቧሪም የጣፈኸም ዘገዶ።<note caller="-" style="x"><char style="xo" closed="false">2፥17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">መዝ. 69፥9</ref>። </char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />አይሑድ፤ የኢየሱስም “ዚ እንም የወሰክት ሥልጣን ያነናኸኸም ያርጋግጥ ምን ታምራዊ ምልክት ታቴዥነ?” ባሮይ።<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />ኢየሱስም “ዚ ቤተ መቅደስ አፍርሶይም እያ በሦስት ከነ ዠበርኩም ኧሸኩች” ባረኖ።<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />አይሑድም፤ “ዚ ቤተ መቅደስ የወሰክት አርባ ስድስት ዓመት ፈጀም፤ ኧጌ አኸ በሦስት ከነ ዠበርከም ትሸኩች?” ባሮይ።<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />ኢየሱስም “ቤተ መቅደስ” ባረም የዝነጔ ስለገገሑ ባነ። <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />ስለኸነም ኢየሱስ በሞት በትነሳ ግዝየ ደቀ መዛሙርተሑ ዚ ዝነጔም የነበረኸም ዘገዶ፤ በዚ መሳ በቅዱስ መጽሐፍ የጣፈዪ ኢየሱስ የዝነጔኒ ቃልም አመኖ።<verse eid="JHN 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />ኢየሱስ በፋሲካ በዓል ግዝየ በኢየሩሳሌም ትናነ የሸከተኖ ታምራት በወዠሕኖ ብዠ ሰቦች በሑቲ አመኖ። <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />ኢየሱስም የሰቦች እንም ይሒር ስለኸነ የሕኖ አነመነኖ፤ <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />ሑቲ በሰብ ሒን ያነዪ እንም ይሒር ስለኸነ ስለሰብ ሟንም ይውጅኸም ኤያሸን ባነ።<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s1">ኢየሱስ ኒቆዲሞስም</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />ኒቆዲሞስ ይቡሪዪ አት ሰብ ባነ፤ ሑቲ ተፈሪሳውያን<note caller="+" style="f"><char style="fr" closed="false">3፥1</char><char style="fqa" closed="false">ፈሪሳውያን፦ </char><char style="ft" closed="false">ሕጊ ይሒሮዪ ባርነም ትረጐምኔም። </char></note> ጐሳ የኸነ የአይሑድ አለአ ባነ። <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />ሑቲም በምሳር ተኢየሱሴ ቸኘም፦ “አስተማሪ፥ እዝጌር ተሑቲጌ ባንከነ ነዚ አኸ ትሸክቶዪ ታምር ይሸክቴ ይችል ሟንም ኤነ፤ ስለኸነም አኸ በእዝጌሬ የቸኘኸ አስተማሪ የኸንከኸም ኧሒርነ” ቧረን።<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />ኢየሱስም “የኢን፥ የኢን ኧብርኸ፤ ሰብ ዠበረም ባንትጨኘ አከንም የእዝጌር መንግሥት ያዤ ኤይችል” ቧረን።<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />ኒቆዲሞስም “ኧጌ፥ ሰብ በገረዘ አንቌ ምንኸም ይጨኜ ይችል? ዄታለኘም ተዳኰሑ ደኔ ቡየም ይጨኜ ይችል?” ቲብር ተሳለ።<verse eid="JHN 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5" />ኢየሱስም እኪ ቲብር ዠበረ፦ “የኢን፥ የኢን ኧብርኸ፤ ሰብ በኧጋ በመንፈስ ቅዱስ ባንትጨኘ ተእዝጌር መግሥቴ ይገባዬ ኤይችል። <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />በሰብ የጨኘ ሰቡ፤ በመንፈስ የጨኘ መንፈሱ። <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />ስለኸነም ‘ዄታለኘ ወጠኝ ያሸሑ’ ስለባከኸ አትደነቅ። <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />ኧንፋስ ታሸኔ አዘር ይነፍስ፤ ጣምባሑ ትሰማ፤ ቢኸንም ቤቴ ይቸኝኸም ቴቴም ያርኸም አትሒር፤ በመንፈስ የጨኘ እንም ዛምኸሙ።”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />ኒቆዲሞስም “ዚ ምንኸም ይኸኔ ይችል?” ቲብር ተሳለን።<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />ኢየሱስም እኪ ቲብር ዠᎄረነ፦ “አኸ የእስራኤል አስተማሪ ኸንከም ዚ አትሒር? <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />የኢን፥ የኢን ኧብርኸ፤ ኧሒርነዪ ኧዝነጊነ፤ ያዠነዪም ኧምሰክርነ፤ አሑም ምስክርነተና አትቌበሮይ። <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />ያፈሪ ቃር ትኒዉድሑ አታምኖ በኸነ የሰሜዪ ቃር ትኒውድሑ ምንኸም ታምኖ? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />በሰሜ ተወረደዪ ተሰብ ትኸ አንከንም ተሰሜዬ የወጣ ሟንም ኤነ።<note caller="+" style="f"><char style="fr" closed="false">3፥13 </char><char style="fqa" closed="false">“በሰሜ ቲነብሪ ተሰብ ትኸ አንከንም” </char><char style="ft" closed="false">ይብሮ አታት የጎጋ ጡሑፍ ነኖ። </char></note><verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />“ሙሴ በበረሐ እንድወደረ ከፍ አበኘም የሰቀረኸም ዛምኸም የሰብ ትኸ ከፍ ባረም ይሰቀሬ ይጌቧን።<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="NUM 21:9">ዘሑ. 21፥9</ref>። </char></note> <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />ዚም ይኸኒ በሑቲ ያምን እንም የዘለዓለም ሕይወት ይረክብኸሙ።<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />“በሑቲ ያምን እንም የዘለዓለም ሕይወት ይነቡርኸም አንኸንም ኤይጠፋኸም እዝጌር የዓለም ስርም ስለወደደን ቁና ትኸኹ አበ። <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />እዝጌር ትኸኹ ተዓለሜ የላዀን፥ ዓለም በትኸኹ ይተርፍኸሙ አንኸንም በዓለም ᎈር የወፍርድ አንከነ። <verse eid="JHN 3:17" /><verse number="18" style="v" sid="JHN 3:18" />በሑቲ ያምን ኤᎈርጅᎄ፤ በሑቲ ኤያምን በቁናዪ የእዝጌር ትኸ ስላነመነ ድረመሑ ᎈረጅᎄም።<verse eid="JHN 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 3:19" />“ፍርዲም ዚቱ፦ ብራን ተዓለሜዬ ቸኘ፤ ሰቦቺም ሜናሕኖ ቡሼ ስለኸነ ተብራን የጠቀለ ጨለማ ወደዶ። <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />ቡሼ ቃር ይሸክት እንም ብራን ይጠላ፤ ቡሼ ሜናሑም ኔይትኴርወ ተብራኔ ኤይቸኝ። <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />የኢን የኸነዪ ቃር ይሸክት ተብራኔ ይቸኝ፤ ተብራኔ ይቸኚም የሸኰተን ቃር በእዝጌር ትዛዝ መሠረት ወሕነሑ በግልጥ ይታዥኸሙ።”<note caller="+" style="f"><char style="fr" closed="false">3፥21 </char><char style="ft" closed="false">አታት ተርጓሚዎች ትምርተ ጥቅሲ ተቁጥር 15 አንቌ ይሸክቶ</char></note><verse eid="JHN 3:21" /></para>
  <para style="s1">መጥምቂ ዮሐንስ ስለ ኢየሱስ ወመስክረሑ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />በዛ አንቌ ኢየሱስ ተደቀ መዛሙርተሑጌ ተይሑዳ ገኜ ወረ፤ በዛም ቲያጠምቅ ተሕኖጌ የቀል ግዝየ ኤከሰ። <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />በዛም ግዝየ ዮሐንስም ብዠ ኧጋ ያነወ ስለኸነ በሳሌም ጭጭሳ ሔኖን በቧሪ መደር ያጠምቅ ባነ፤ ሰቦቺም ቸኖም ይጠመቆ ባነ። <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" />በዛ ግዝየ ዮሐንስ ገና ኧጉጀኘ አንከነ ባነ።<note caller="-" style="x"><char style="xo" closed="false">3፥24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቴ. 14፥3</ref>፤ <ref loc="MRK 6:17">ማር. 6፥17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፥19-20</ref>። </char></note> <verse eid="JHN 3:24" /><verse number="25" style="v" sid="JHN 3:25" />በዛ ግዝየ በዮሐንስ ደቀ መዛሙርት በአይሑድ ግብትም ስለወታጠብ ሴራ ኦገት ተነሳ።<note caller="+" style="f"><char style="fr" closed="false">3፥25 </char><char style="fqa" closed="false">በአይሑድ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “በቀል አይሑድ” ይብሮ። </char></note> <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />የዮሐንስ ደቀ መዛሙርት ተዮሐንሴ ቀረቦም “አስተማሪ፥ ዛ በዮርዳኖስ ዛዘር ታኸጌ የነበረዪ፥ አኸ ስለሑቲ የምሰኰርኰነ፥ ዘ፥ ሑቲም ያጠምቅ፤ ሰቦች እንም ተሑቲዬ ያሮ” ባሮይ።<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />ዮሐንስም እኪ ቲብር ዠበረ፦ “ሟንም ሰብ እዝጌር ባናᎄን አንኸንም አት ቃር ይነቡሬ ኤይችል፤ <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" />‘ተሑቲ ኢፍት ተላክሑም አንኸንም እያ ክርስቶስ አንከንኩ’ ባሑም ዬወደኩኹኸም አሑ ነብሳሑ ምስክረኛንኩ።<note caller="-" style="x"><char style="xo" closed="false">3፥28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">ዮሐ. 1፥20</ref>። </char></note> <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />ሙሽሪ ያነን ሰብ ሙሽራው፤ የሙሽራዪ ሙዜ በሙሽራዪ ሜጠቅ ቌመም ይሰሟን፤ የሑቲም ጣምባ በወስማ ይትብላለቅ፤ ስለኸነም ይያም ብልቃት ዚቱ፤ ሑቲም ኧሗ ፍጡም ኸነም። <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />ሑቲ ከፍ ከፍ ወበር ይጌቧን፤ እያም ዝቅ ወበር ይጌቤ።”<verse eid="JHN 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />በነኔ ይቸኚ ትንም ነኑ፤ ባፈር የኸነ ያፈሩ፤ ያፈሪም ቃር ይዝነግ፤ በሰሜ ይቸኚ ትንም ነኑ። <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />ሑቲ ያዠኒም የሰሟኒ ይምሰክር፤ ቢኸንም የሑቲ ምስክርነት ይቌበር ኤነ። <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />የሑቲ ምስክርነት ይቌበር እዝጌር የኢን ወሕነሑ ያርጋግጥ። <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />እዝጌር መንፈሰሑ ይብ ቃጣም ያንከነ ስለኸነ እዝጌር የላዀን የእዝጌር ቃል ይዝነግ። <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" />አብ ትኸኹ ይወድ፤ እንም ቃር በጀሑ አትሬከᎄንም። <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />በወልድ ያምን የዘለዓለም ሕይወት ነነን፤ በወልድ ኤያምኒም የእዝጌር ማት በሑቲ ᎈር ይኸንወ አንኸንም ሕይወት ኤይረሕብ።<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s1">ኢየሱስ ተሳመራዊ ምሽትጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />በዛ ግዝየ ኢየሱስ ተዮሐንስ ይበዞ ብዠ ሰቦች ደቀ መዛሙርት ይሸክትኸም ያጠምቅኸም ፈሪሳውያን ሰሞ፤ <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />ቢኸንም ያጠመቀዪ ኢየሱስ ቴይኸን ደቀ መዛሙርተሑ ባኖ። <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />ጔታም ዚ የሐረኸም ይሑዳ ገፈረም ተገሊላዬ ተዠበረም ወረ። <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />ተዛዬም ቲያር በሰማርያ ኤማ ወልፍ ባነወ።<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />ስለኸነም ያዕቆብ የትኸኹ የዮሴፍ ባᎄኒ መደር ᎀረ ይትረከቢ፥ ሲካር ቧሪም ቲጠሬዪ የሰማርያ ከተማዬ ቸኘ።<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">ዘፍ. 33፥19</ref>፤ <ref loc="JOS 24:32">ኢያ. 24፥32</ref>። </char></note> <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />በዛም የያዕቆብ የኧጋ ጐጀ ባነ፤ ኢየሱስ ኤማ ወረም የቌጠ ስለኸነ በጐጀዪ ᎀረ ቾና፤ ግዝየሑ ስድስት ሰዓት ቅጫ ባነ።<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />በዛ ግዝየ አት የሰማርያ ገኝ ምሽት ኧጋ ትገዳዬ ተጐጀዬ ቸኘች፤ ኢየሱስም “ኧጋ አስጭኝ!” ባረና። <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />በዛ ወክት ደቀ መዛሙርተሑ ስንቅ ይስሮዬ ተከተማዬ ወሮም ባነ። <verse eid="JHN 4:8" /><verse number="9" style="v" sid="JHN 4:9" />ዚዬታን ሳመራዊዪ ምሽት የኢየሱስ፦ “አኸ የአይሑድ ጐሳ ኸንኸም ምንኸም ይያ የሳምራዊቲ ‘ኧጋ አስጭኝ!’ ባኸም ትሰሌ?” ባረቹ፤ ዚ ወበሬታ፥ አይሑድ ተሳምራውያንጌ ስምምነት አነበረኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">ዕዝ. 4፥1-5</ref>፤ <ref loc="NEH 4:12">ነሕ. 4፥12</ref>። </char></note><verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />ኢየሱስም “የእዝጌር ስጦታም ‘ኧጋ አስጭኝ!’ ይብርሽ ሟ የኸነኸም ብትሒይ፥ የሑቲ ወጮቅስ ይጌባሽ አሺ ባነሽ፤ ሑቲም የሕይወት ኧጋ ይብሽ ባነ” ባረና።<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />ሒቲም እኪ ትትብር ዠᎄረትነ፤ “ጔታ! አኸ ባልዲ ኤነናኸ፤ ጐጀዪም የትዀኘዉ፤ ኧጌ፥ የሕይወት ኧጋ ቤቴ ትረኸብ? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />አኸ ዚ ጐጀ ታበነዪ ተአባና ተያዕቆብ ትበዛ? ሑቲም ዴንጋሑ፥ ኧሬየሑ በዚ ጐጀ ሰጦም።”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />ኢየሱስ እኪ ቲብር ዠበረና፤ “በዚ ኧጋ ይሰጭ እንም ዠበረም ይጠሟን፤ <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />እያ ትንᎅ ኧጋ ይሰጭ የዘላለም ስርም ኤይጠሟን፤ እያ ይᎅ ኧጋ፥ ይሰጭ ሰብ የዘላለም ሕይወት ይፈልቅ የኧጋ ምንጭ ይኸን።”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />ምሽቲም “ጔታ! ተሗ ቀረሰም ኧጋ ኔጠሜኸም ተዚዬም የወግዳ አንቸኝኸም ታውሽ ዚኸማቲ ኧጋ ናሜ!” ባረቹ።<verse eid="JHN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16" />ኢየሱስም “ዌርማሽ የምሳሽ ጢየማሽ ተዘቤ” ባረና።<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />ምሽቲም “ምስ ኤኔ” ትትብር ዠᎄረትነ፤</para>
  <para style="p" vid="JHN 4:17">በዛ ግዝየ ኢየሱስ እኪ ባረና፦ “ምስ ኤኔ ወበራሽ ልኩ፤ <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />አምስት ምስ ባኖች፤ ኧሗም ታሺጌ ያነዪ ሰብ ምሳሸ አንኸነ፤ ስለኸነም የኢኒ ዝነጔሽ።”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />ምሽቲም እኪ ባረቹ፤ “ጔታ! አኸ ነብይ የኸንከኸም ኧሗ ሐርኩም፤ <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />አቦቸና በዚ ቈቶ ᎈር ሰገዶ፥ አሑም ‘ሰብ ይሰግዶᎄዬ ይጌባኖ በኢየሩሳሌሙ’ ትብሮ።”<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />ኢየሱስም እኪ ባረና፦ “ምሽቶ! በዚ ቈቶ ᎈርም በኢየሩሳሌም የአብ አትሰግዶᎄ ግዝየ ይቸኝኸም ኧምኚኝ፤ <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />አሑ አቲሒሮይ አምላክ ትሰግዶ፥ ኢናም ወትርፍ ይቸኝ በአይሑድ ስለኸነ ኧሒርነዪ አምላክ ኧሰግድነ። <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />ቢኸንም በኢን ይሰግዶ፥ የአብ በመንፈስ በኢንም ይሰግዶᎄ ግዝየ ይቸኝ፤ ዛምኸም ኧሗ ቸኘም፤ አብም ይሸን በዚ ኤማ ይሰግዶነዪው። <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />እዝጌር መንፈሱ፥ ይሰግዶነዪም በመንፈስም በኢን ይሰግዶነዬ ይጌባኖ።”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />ምሽቲም “ክርስቶስ ይቡሪዪ መሲሕ ይቸኝኸም ኧሒር፤ ሑቲ ቲቸኝ እንም ቃር ይውድነ” ባረቹ።<verse eid="JHN 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26" />ኢየሱስም “ዘ! ኧሗ አዝናግሽ እያ ሑቲትንኩ” ባረና።<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />በዚ ግዝየ ደቀ መዛሙርተሑ በወሮᎄዬ ተዠበሮም ቸኖ፤ ኢየሱስ ተምሽትጌ በወዘንጔሑ ተጌረሞ፤ የሕን አከንም “ምን ትሸ?፥ ተሒቲጌም የመአር ትዝነግ?” ባረም የሳለን ሟንም አነበረ።<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />በዛ አንቌ ምሽቲ ወሸኔታ ገፈረችም ተከተማዬ ወረችም የሰቦቺ እኪ ባረች፥ <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“የሸከትኩኒ እንም ዬወዴዪ ሰብ ኔሑ ኧዞ! የሟንᎀሑ ሑቲ ክርስቶስ ይኸን ሑኒ?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />ሰቦቺም በከተማዪ ወጦም ተኢየሱሴ ወሮ።<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />በዛ ግዝየ ደቀ መዛሙርተሑ የኢየሱስ፦ “አስተማሪ! ዚ ስንቅ ብራ” ቲብሮ ጮቀሶይ።<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />ሑቲም፥ “አሑ አቲሒሮይ እያ ኧᎄራን ስንቅ ነኔ” ባረኖ።<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />ስለኸነም ደቀ መዛሙርተሑ፥ “የኸነ ሰብ ስንቅ አቸኘነም ይኸን?” ተበበሮ።<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />ኢየሱስም እኪ ባረኖ፦ “ይያ ስንቅ የላሔዪ ፈአድ ወሰክትም ሜናሑ ወፈጥሙ። <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />አሑ ገና አርበት መሬት ቈኘንም፤ በዛም አንቌ መኸር ይኸን? ትብሮ አንከነ? እያም ‘ቀና በሮማሑ እርሻዪ የመኸር የሰላኸም ተመልከቶ’ ኧብርሑ። <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />ያድ ደሞዘሑ ይቌበር፤ የዘለዓለም ሕይወት ይኸን ፍርየም ይስበስብ፤ ስለኸነም ይዘራዪም፥ ያዲም ቁናዬ ይትብላለቆ። <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />በዚ መሳ ‘አቲ ይዘራ፥ ኧንጐዲ ያድ’ ይብሪ ቃል የኢኑ። <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />እያም ያንቌጥኩᎄዪ ታዶኸም ላኸኩሑ፤ ኧንጐዲ በሜና ቌጦ፤ አሑም በቅጭናሕኖ ተጠቀምኩ።”<verse eid="JHN 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />ምሽቲም “የሸከትኩኒ ቃር እንም ኤወዴ” ባረችም በምሰከረትወ መሠረት በዛ ከተማ ብዠሕኖ የሰማርያ ሰቦች አመኖ። <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />ስለኸነም የሰማርያ ገኝ ሰቦች ተኢየሱሴ በቸኖ ግዝየ ተሕኖጌ ዬክስኸም ጮቀሶይ፤ ሑቲም ዄት ከነ በዛዬ ኤከሰ።<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />በቃለሑ መሳ ኧንጐድ ብዠ ሰቦች በሑቲ አመኖ።<verse eid="JHN 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42" />የምሽቲም “ተሗ ቀረሰም የሑቲ አምንነ አሺ ቤወድሽነ ቃል ጠለለ ቴይኸን ኢና ራሰና ሰማኔም፤ ዚ ሰብ የኢንም የዓለም ያተርፍ የኸነኸም ኧሒርነ” ባሮያ።<verse eid="JHN 4:42" /></para>
  <para style="s1">ኢየሱስ የሹሚ ትኸ ፈያ የሸኰተንኸም</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />ኢየሱስ በሰማርያ ዄት ከነ ቤከሰ አንቌ ተገሊላ ገኜ ወረ። <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" />ነብይ በፎለሑ ገኝ ኤይከበርኸም ኢየሱስ ነብሰሑ ዝነገም ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">ማቴ. 13፥57</ref>፤ <ref loc="MRK 6:4">ማር. 6፥4</ref>፤ <ref loc="LUK 4:24">ሉቃ. 4፥24</ref>። </char></note> <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" />ቢኸንም ተገሊላዬ በሰላ ግዝየ የገሊላ ሰቦች ፈያኸም ተቌበሮይ፤ ዚም የኸነ የፋሲካ በዓል ተኢየሩሳሌሜ ወሮም በነበሮᎄ ግዝየ ሑቲ በዛ የሸኰተን እንም አዞም ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">ዮሐ. 2፥23</ref>። </char></note><verse eid="JHN 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />በዛ አንቌ ኢየሱስ ኧጋዪ የወይን ደጔ ተሸገረወዬ በገሊላ ገኝ ይትረከቢ ተቃና ከተማዬ ኧሗም ተዠበረ፤ በዛ ግዝየ በቅፍርናሖም ከተማ ትኸኹ የታቌወ አት የቤተ መንግሥት ሹም ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">ዮሐ. 2፥1-11</ref>። </char></note> <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />ዚ ሰብ ኢየሱስ በይሑዳ ተገሊላዬ ወተኘሑ በሰማ ግዝየ፤ ተሑቲዬ ወረም ይᎀቴ የሰላም የነበረዪ ትኸኹ ቸኘም ፈያ ይሸኩትነዬ ጮቈሰን።<verse eid="JHN 4:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48" />ኢየሱስም “አሑ ታምር ያዴንቅ ቃርም ባነዠሑ አንኸንም አትም አታምኖ!” ቧረን።<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />ሹሚም “ጔታ! ትኸኛ ተወሙተሑ ኢፍቴ ታውሽ ከሞ ውረድ” ቧረን.<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />ኢየሱስም ተቤታኸዬ ወር! ትኻኸ በሕይወት ይነብር ቧረን። ምሲም ኢየሱስ የዝነጔኒ ቃል አመነም ተቤተዄ ወረ።<verse eid="JHN 4:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 4:51" />ቲያርም አገልጋዮቸሑ ቤማ ረከቦይም “ትኻኸ ተረፈም” ባሮም ኤወዶይ። <verse eid="JHN 4:51" /><verse number="52" style="v" sid="JHN 4:52" />ሑቲም ትኸኹ ፈያ የኸነወዪ ሰዓት ተሳለኖ። ሕኖም “ትራማ በሰበት ሰዓት ፉላዪ ገᎈረን” ባሮይ። <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />አᎄችም ኢየሱስ “ትኻኸ በሕይወት ይነብር” የቧረን በዛ ሰዓት የኸነኸም ሐረ፤ ስለኸነም በዛ ከነ ቀረሰም ሑቲ አበሮሰሑም እንም በኢየሱስ አመኖ።<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />ዚ ታምር ኢየሱስ በይሑዳ ተገሊላዬ ቸኘም የሸኰተን ዄታለኘዪ ታምሩ።<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s1">ኢየሱስ አት ጅረ ሰብ ፈያ ወሰክተሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />በዛ አንቌ የአይሑድ በዓል የነበረ ስለኸነ ኢየሱስ ተኢየሩሳሌሜ ወረ። <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />በኢየሩሳሌም በጤ በር ᎀረ፥ በዕብራይስጥ ቋንቋ ቤተ ሳይዳ<note caller="+" style="f"><char style="fr" closed="false">5፥2 </char><char style="fqa" closed="false">ቤተ ሳይዳ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቤትዛታ ቲይቡን እንጐዲ ኧሗም ቤተ ሳይዳ ይብሮይ፤ ትርጉመሑም የምረት ቤት ወበሩ። </char></note> ይቡሪ አት የምንጭ ኩሬ ባነ፥ በዙሪያውታም አምስት በᎈር ክዳን ያነኖ ይችላለፉᎄ ቃር ባነ። <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />[ስርም ብዠ የታቆ፥ ወዥ ኤይችሎ ያኔክሶዪ ጅረዪም ቢችላለፉᎄዪ ተገደሮም ባነ። ነዚ የኧጋዪ ወንቅሳቅስ ይቅሮ ባነ፤ <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />አታትጌ የጔታ መላይካ ተኩሬዬ ወረደም የኧጋዪ ያናውጭ ባነ። ተኧጋዪ ወናወጥ አንቌ በደረም ተኩሬዬ ይቡየ ታነወ ተሟንᎀሑ ባሸ ፈያ ይኸን ባነ።]<note caller="+" style="f"><char style="fr" closed="false">5፥4 </char><char style="ft" closed="false">የድረ የጎጋ ጡሑፍ ተቁ. 3 የመጨረሻ ክፍል ነሣም ቊ. 4 መጨረሻ ስን ያነዪ ክፍል ኤይደበሮ። </char></note> <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />በዛም ሰላሳ ስሙት ዓመት ሙላ የታቌ አት ሰብ ባነ። <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />ኢየሱስ ዚ ሰብ በዛ ተገደረም አዠንም ተብዠ ግዝየ ቀረሰም ወታቌሑ ሐረም፥ “ወትርፍ ትሸ?” ቧረን።<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />የታቌዪም “ጔታ! ኧጋዪ ቢንቅሳቀስወ ግዝየ ወሰደም ተኩሬዬ ይኸሬ ሰብ ኤኔ፥ እያ ንወር ትንብር እንጐዲ በደሬም ይወርድ” ቧረን።<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />ኢየሱስም “ተንሳ! አልጋኸ ጮርማኸ ወር!” ቧረን። <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />ምሲም ሒንጌም ተረፈ፤ አልጋሑም ጮረም ወረ።</para>
  <para style="p" vid="JHN 5:9">ዚም የኸነ በሰምበት ከነ ባነ።<verse eid="JHN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 5:10" />ስለኸነም የአይሑድ ባለሥልጣኖች ዛ የተረፈዪ ሰብ “ኧኳ ሰምበት ስለኸነ አልጋኸ ትጮርኸም ሕጊ ኤፈቅድንከ” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">5፥10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">ነሕ. 13፥19</ref>፤ <ref loc="JER 17:21">ኤር. 17፥21</ref>። </char></note><verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />ሑቲም “ያተረፌዪ ምስ አልጋኸ ጮርም ወር” ባሬም ባረኖ።<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />ሕኖም “አልጋኸ ጮርም ወር የባረናኸ ሟኒ?” ቲብሮ ተሳሎይ።<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />ምሲም ሕዝብ የበዛ ስለኸነ ኢየሱስም በዛ ራቅ ባረም ስለወረ ያተረᎈን ሟ የኸነኸም ኤይሒር ባነ።<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />በዛ አንቌ ኢየሱስ የምሲ በቤተ መቅደስ ረከᎄንም “ዘ፥ ኧሗ ተረፍከም፤ ተዚ ይብስ ቃር ኤይሰላብከኸም ተሗ ቀረሰም አጢያት አትሰክት” ቧረን።<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />ምሲም ወረም ያተረᎈን ኢየሱስ ወሕነሑ የአይሑድ ባለሥልጣኖች ኤወደ።<verse eid="JHN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16" />ዚ ዘንጋ በሰምበት የሸከተ ስለኸነ የአይሑድ ባለሥልጣኖች የኢየሱስ ያሳድዶይ ቀረሰ። <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />ኢየሱስም “አባኛ እንጌ ይሸክት፤ እያም ኧሸክት” ቲብር ዠበረኖ። <verse eid="JHN 5:17" /><verse number="18" style="v" sid="JHN 5:18" />ዚም ይቡሪዪ የአይሑድ ባለሥልጣኖች የኢየሱስ ይቀጥሮይኸም ስርም ሸዎይ፤ ዚም የኸነ ሑቲ ሰምበት በወሻረሑ ጠለለ ቴይኸን “እዝጌር አባኛው” በወበር ነብሰሑ ተእዝጌርጌ ቂጦ የሸከተ ስለኸነው።<verse eid="JHN 5:18" /></para>
  <para style="s1">የእዝጌር ትኸ ሥልጣን</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />ኢየሱስ እኪ ቲብር ዠበረኖ፦ የኢን፥ የኢን ኧብርሑ፤ አብ ቲሸክት ያዠን ተወሰክት አንኸንም ወልድ በነብሰሑ ሥልጣን አትም ይሸክቴ ኤይችል። አብ ይሸኩቺ ወልድም ዛምኸም ይሸክት። <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />አብ የወልድ ይወጅጅ ስለኸነ ይሸኩች ቃር እንም ያቴዥን፤ አሑም ትዴነቆኸም ተዚ ይበዛ ሜናም ያቴዥን። <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />አብ የሟቾቺ አትኔሳም ሕይወትም ይቦኸም፥ ወልድም ዛምኸም የሸኒ ሰብ ሕይወት ይቡ። <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />አብ በሟንም ᎈር ኤይፈርድ፤ ቢኸንም ፍርድ እንም የወልድ አᎄንም። <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />ዚም የሸኰተኒ ሰቦች እንም የአብ ያከብሮኸም ዛምኸም የወልድ ያከብሮይኸሙ፤ የወልድ ኤያከብር፥ የወልድ የላዀን የአብ ኤያከቡር።<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />የኢን፥ የኢን ኧብርሑ፤ ቃለኛ ይሰማ በላሔዪ ያምን የዘለዓለም ሕይወት ነነን፤ ሑቲ ተሞት ተሕይወቴ የጔና ስለኸነ ኤᎈርጅᎄ። <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />የኢን፥ የኢን ኧብርሑ፤ የᎀቶ ሰቦች የእዝጌር ትኸ ጣምባ ይሰሞᎄ ግዝየ ይቸኝ፤ ግዝየዪም ኧሗቱ፤ ይሰሞዪ እንም በሕይወት ይነብሮ። <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />አብ ነብሰሑ የሕይወት ምንጭ ይኸንኸም አᎄንም። <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />የሰብ ትኸ በወሕነሑ ፍርድ ይፈርድኸም ስልጣን አᎄንም።<verse eid="JHN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28" />“በዚ ዘንጋ አትደነቆ፤ በቀብር ውስጥ ያኖዪ እንም የሑቲ ጣምባ ይሰሞᎄ ሰዓት ይቸኝ። <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />ፈያ የሸከቶ ተሞት ተነሶም በሕይወት ይነብሮ፤ ቡሼ የሸከቶ ተሞት ተነሶም ይᎈርጅቦ።”<note caller="-" style="x"><char style="xo" closed="false">5፥29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳን. 12፥2</ref>። </char></note><verse eid="JHN 5:29" /></para>
  <para style="s1">የኢየሱስ ያᎅ ምስክርነት</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />እያ በነብሰኛ ስልጣን አትም ወሰክት አንችል፤ ቢኸንም በአብ የሰማሑኒ ኧፈርድ፤ የላኼዪ ፈአድ አንኸንም የነብሰኛ ፈአድ አንሸክት ስለኸነ ፍርደኛ ሱቱ።<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />እያ የነብሰኛ ብንምሰክር ምስክርነተኛ የኢን አንከነ። <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />ቢኸንም ይያ ይምሰክር እንጐድ ነነ፤ ሑቲም ይያ ይምሰኩሪ ምስክርነት የኢን ወሕነሑ ኧሒር። <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" />አሑ ዮሐንስ መልክተኞች ላክሑም ባነ፤ ሑቲም የኢኒ ምሰከረም።<note caller="-" style="x"><char style="xo" closed="false">5፥33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">ዮሐ. 1፥19-27</ref>፤ <ref loc="JHN 3:27-30">3፥27-30</ref>። </char></note> <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />ዚም ወበረኛ ትተርፎኸሙ አንኸንም እያ የሰብ ምስክርነት ያሼ ስለኸነ አንከነ። <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />ዮሐንስ ይነድ ይበራም መብራት ባነ፤ አሑም የቀል ግዝየ በሑቲ ብራን የወትብላለቅ ሸሑ። <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />እያም ተዮሐንስ ምስክርነት የበዛ ምስክር ነኔ፤ ምስክረኛም አባኛ ኧሸኩችኸም ያቤ ሜናው፥ አብ የላኼኸም ስለእያ ይምሰክር። <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" />የላኼዪም አብ፥ ነብሰሑ ስለእያ ምሰከረም፤ አሑም ጣምባሑ ስርም አንሰማሑ፤ መልከሑም ስርም አነዠሑ።<note caller="-" style="x"><char style="xo" closed="false">5፥37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቴ. 3፥17</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>። </char></note> <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />ሑቲ የላዀን ያነመንኩ ስለኸነ የሑቲ ቃል ባሑዬ ኤይነብር። <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />አሑ በቅዱሳን መጽሐፍት የዘለዓለም ሕይወት ትረሕቦ ይመስርሑ ስለኸነ የሕኖ ትምረምሮ፤ ሕኖም ስለእያ ይምሰክሮኖ። <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />የሕን አንኸንም አሑ ሕይወት የወርክብ ቲያዬ ወተኝ አትሸዎ።<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />“እያ ክብር በሰብ አንሸ። <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />አሑ ተሒናሑ የእዝጌር አትወዶይ ወሕናሑ ኧሒር። <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />እያ በአባኛ ሽም ቸኘሑ፤ አሑም አንትቀበርኩኝ፤ ኧንጐዲ በነብሰሑ ሽም ቢቸኝ ትቌበሮይ። <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />አሑ ነብስ በነብሳሑ ክብር ትሸዎ ተቁናዪ ተእዝጌር ይትረከቢ ክብርም አትሸዎ፥ ምንኸም ታምኖዬ ትችሎ? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />እያ በአባኛ ኢፍት ኧከስሑ ኤይምስርኩ፤ ይከስሑ፥ ተስፋ ትሸክቶᎄ ሙሴው። <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />የሙሴ ብታምኖይማ ሑቲ ስለእያ ጣፈም ይያም ባመንኩኝ ባነ። <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />ሑቲ የጣᎈኒ ባነመንኩም ይያ ቃል ምንኸም ታምኖ?”<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s1">ኢየሱስ አምስት ሺ ሰብ ዋብራሑ</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቴ. 14፥13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6፥30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፥10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />በዛ አንቌ ኢየሱስ ጥብርያዶስ ቲቡሪዪ ተገሊላ ባር ዛዘሬ ተጔና። <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ብዠ ሰቦች ኢየሱስ የታቆዪ ፈያ በወሰክት የሸኰተን ታምር ያዞዬ ተዄተሎይ። <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />ኢየሱስ ተቈቶዬ ወጣም በዛ ተደቀ መዛሙርተሑጌ ቾና። <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />የአይሑድ የፋሲካ በዓል ሰላም ባነ።<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />በዛ ግዝየ ኢየሱስ ብዠ ሕዝብ ተሑቲዬ ቲቸኝ ቀና ባረም አዠም የፊልጶስ፦ “የዚ እንም ሰብ ይዀን ስንቅ ቤቴ ወሰየ ኧችልነ?” ቧረን። <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />ኢየሱስ ዚ የዝነጔኒ የፊልጶስ የወፈትን ባነ አንኸንም፥ ይሸኩቺሽ ሑቲ ነብሰሑ ይሒር ባነ።<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />ፊልጶስም “አትባተሕኖ ቀል ቀል ፉራᎀት ይቡዮኸም የዄት መቶ ዲናር<note caller="+" style="f"><char style="fr" closed="false">6፥7 </char><char style="fqa" closed="false">ዲናር፦ </char><char style="ft" closed="false">የቁና ከነ ሜነተኘ የቁና ከነ ደሞዙ። ማቴ. 22፥19፤ ሉቃ. 7፥41፤ 10፥35 </char></note> ቂጣ ኤይኸኖ” ትይብር ዠᎄረነ። <verse eid="JHN 6:7" /><verse number="8" style="v" sid="JHN 6:8" />ተደቀ መዛሙርተሑ አቲ የስምዖን ጴጥሮስ ጐቤ እንድርያስ እኪ ባረ፦ <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />“አምስት ቅስስን የኧሕር ቂጣ ዄት ቅስስን ዓሣም የጠበጠ አት ትኸ በዚ ነነ፤ ቢኸንም የዚ እንም ሕዝብ ምንኸም ይሰላ?”<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />ኢየሱስም “የሰቦቺ ይቾኖኸም ሰክቶዮ” ባረ። በዛ መደር ብዠ ሠር ባነ፤ ሰቦቺም ይቾኖኸም ሰክቶዮ ባረ። ቁጥረሕኖም አምስት ሺ ቅጫ ባነ። <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />ተዛ አንቌ ኢየሱስ ቂጣዪ ነሣም ምስጋና ባቀረበ አንቌ የቾኖዪ ሰቦች አበኖ፤ ዛምኸም ዓሣዎቺ ሳደኖ፤ እንም ይሸዎዪ ቅጫ ረከቦ። <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />እንም በኖም በጦፎ አንቌ ኢየሱስ የደቀ መዛሙርተሑ፦ “አት ቃር ኤባክንኸም የተረፈዪ ፍርፋሪ ሰብስቦ” ባረኖ። <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />ሕኖም ሰቦች በኖም በተረፈኖዪ ተአምስቲ የሕር ቂጣ ፍርፋሪ ስበሰቦም ዐሥረ ዄት ግድድር ሌማት ᎀሎ።<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />ሰቦቺም ኢየሱስ የሸኰተኒ ታምር ባዞ ግዝየ፤ “የኢንም ዚ ተዓለሜ ይቸኚ ነብዩ!” ባሮ። <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />ሰቦቺም በግድ ወሰዶም ያነግሦዬ ዬሰቦኸም በሐረ ግዝየ ኢየሱስ የቢቶሑ ዠበረም ራቅ ባረም ተቈቶዬ ወረ።<verse eid="JHN 6:15" /></para>
  <para style="s1">ኢየሱስ በባር ᎈር ተራመደ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቴ. 14፥22-33</ref>፤ <ref loc="MRK 6:45-52">ማር. 6፥45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />በመሸ ግዝየ ደቀ መዛሙርተሑ ተባሬ ወረዶ። <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />በጀልባ ተሳፈሮም ተቅፍርናሖሜ ወሮ፤ በዛ ሰዓት ግዝየዪ ጨለመም ባነ፤ ኢየሱስም ገና ተሕኖዬ አንተኘ ባነ፤ <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />ኸርደድ ኧንፋስ ይነፍስ ባነ፤ ባሪ ተላወሰ። <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />ደቀ መዛሙርተሑ አምስት ወይ ስድስት ኪሎ ሜትር ቅጫ ቲዋኮ በወሮ አንቌ ኢየሱስ በባሪ ᎈር ቲያር ተጀልባዬ ቲቀርብ አዞም ጔኖ። <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />ሑቲም “እያትንኩ! አትጔኖ!” ባረኖ። <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />ሕኖም በብልቃት ተቌበሮም ተጀልባዬ ይኸሮዬ ሸዎ፤ ሒንጌም ጀልባዪ ቲያሮᎄ መደሬ ሰላ።<verse eid="JHN 6:21" /></para>
  <para style="s1">ኢየሱስ የሕይወት ቂጣ ወሕነሑ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />የመናጊ ተባሪ ዛዘር ቀኖም የነበሮዪ ሰቦች፥ በባሪ ᎈር አት ጀልባ ጠለለ የነበረኸም በዛም ደቀ መዛሙርተሑ የሟነሕኖ የወሮኸም፥ ኢየሱስም ተሕኖጌ ተጀልባዬ ያንገባኸም አዞም ባነ። <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ቢኸንም እንጐዲ ጀልባ ተጥብርያዶስ ተነሦም ኢየሱስ የምስጋና ጠሎት ተሸከተወዬ ሕዝቢ ቂጣ ተበኖᎄ መደሬ ᎀረ ቸኖ። <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />ሰቦቺም ኢየሱስም ደቀ መዛሙርተሑ በዛ ዬኖኸም ባዞ ግዝየ በዛ ጀልባ ተሳፈሮም የኢየሱስ ይሸዎዬ ተቅፍርናሖሜ ወሮ። <verse eid="JHN 6:24" /><verse number="25" style="v" sid="JHN 6:25" />በባሪ ዛዘር በረከቦይም ግዝየ፥ “አስተማሪ፥ ተዚዬ መቸ ቸኘኸ?” ባሮይ።<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />ኢየሱስ እኪ ቲብር ዠበረኖ፦ “የኢን፥ የኢን ኧብርሑ፤ አሑ ትሸዎኝ ቂጣ በናሑም የጦፈሑዬ አንከንም ታምር ያዠሑዬ አንከነ። <verse eid="JHN 6:26" /><verse number="27" style="v" sid="JHN 6:27" />ይጠፋ ስንቅ አትሰክቶ፤ ይጠቅሊሽ እዝጌር አብ ያርጋገጠወ ማተብ ዬተመወዪ የሰብ ትኸ ይብኩዪ፥ የዘለዓለም ሕይወት ይኸኒ ስንቅ ሰክቶ።”<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />ሰቦቺም “ኧጌ፥ የእዝጌር ሜና የወሰክት ምን ወሰክት ይጌባነ?” ባሮይ።<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />ኢየሱስም “የእዝጌር ሜናማ እዝጌር በላዀን ወምኑ” ቲብር ዠበረኖ።<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />ሕኖም እኪ ባሮይ፦ “ኢና አዠነም ባኸ ናምነኸም ምን ታምር ትሸክት? ምንሽ ትሸክት? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />‘ይበሮኸም በሰሜ ቂጣ አበኖ’ ቧሪም የጣፈኸም፥ አቦቸና በበረሐ መና<note caller="+" style="f"><char style="fr" closed="false">6፥31 </char><char style="fqa" closed="false">መና፦ </char><char style="ft" closed="false">በሰሜ የወረደ የመላይካ ስንቅ እስራኤላውያን የበኖይ። </char></note> በኖ።”<note caller="-" style="x"><char style="xo" closed="false">6፥31 </char><char style="xt" closed="false"><ref loc="EXO 16:4">ዘፀ. 16፥4</ref>፤ <ref loc="EXO 15">15</ref>፤ <ref loc="PSA 78:24">መዝ. 78፥24</ref>። </char></note><verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />በዛ ግዝየ ኢየሱስ እኪ ባረኖ፦ “የኢን፥ የኢን ኧብርሑ፤ በሰሜ የወረደዪ ቂጣ ያበናሑ ሙሴ አንከነ፤ የኢኒ ቂጣ በሰሜ ይብኩ አባኛው፤ <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />የእዝጌር ቂጣ በሰሜ ይወርዲም የዓለም ሕይወት ይቢው።” <verse eid="JHN 6:33" /><verse number="34" style="v" sid="JHN 6:34" />ስለኸነም ሰቦቺ “ጔታ! ዚኸማት ቂጣ እንጌ ናመነ” ባሮይ።<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />ኢየሱስም እኪ ባረኖ፦ “የሕይወት ቂጣ እያትንኩ፤ ቲያዬ ይቸኝ ስርም ኤይጐጅ፤ ቢያ ያምን ስርም ኤጠሟን፤ <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />አሑም አዠሑኝም፤ ቢኸንም ቢያ አነመንኩ። <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />አብ ይቤ እንም ቲያዬ ይቸኝ፤ ቲያዬ ይቸኚም ስርም ተውጪዬ አንሰጅጅ። <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />ኧያ በሰሜ የወረድኩ የላሔዪ ፈአድ የወሰክት አንኸንም የነብሰኛ ፈአድ የወሰክት አንከነ። <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />የላኼዪም ፈአድ፥ ታቤዪ እንም አትም ታናጠፋ በመጨረሻዪ በፍርድ ከነ ተሞት አትኔሣኖኸሙ። <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />ኤክ! የአባኛ ፈአድ የወልድ ያዥም በሑቲ ያምን እንም የዘለዓለም ሕይወት ይረሕብኸሙ፤ እያም በመጨረሻዪ በፍርድ ከነ በሞት አትኔሣን።” <verse eid="JHN 6:40" /><verse number="41" style="v" sid="JHN 6:41" />ስለኸነም ኢየሱስ “በሰሜ የወረደ ቂጣ እያትንኩ” በወበረሑ አይሑድ በሑቲ ᎈር ቁምቁሜ ባሮ፤ <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />እኪም ባሮ፦ “ዚ የዮሴፍ ትኸ ኢየሱስ አንከነ? አባውታና ዳኮውታሽ ኧሒርነዮ አንከነ? ኧጌ፥ ኧሗ ሑቲ ምንኸም ‘በሰሜ ወረድኩ’ ይብር?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ነብስ በነብሳሑ ቁምቁሜ አትበሮ፤ <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />የላኼ አብ የሻᎄን ባንከነ አንከንም ቲያዬ ወተኝ ይችል ሟንም ኤነ፤ ቲያዬ ይቸኚም በመጨረሻዪ በፍርድ ከነ ተሞት አትኔሣን። <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />በነብዮች መጽሐፍት ‘ሰቦች እንም በእዝጌር የትማሮ ይኸኖ’ ቧሪም ጣᎉም፤ ስለኸነም በአብ ሰማም የትማረ እንም ቲያዬ ይቸኝ።<note caller="-" style="x"><char style="xo" closed="false">6፥45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">ኢሳ. 54፥13</ref>። </char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />ዚ ወበር የአብ ያዠን ሰብ ነነ ወበር አንከነ፤ የአብ ያዠን በእዝጌሬ የቸኘ ሑቲ ጠለለው። <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />የኢን፥ የኢን ኧብርሑ፤ ቢያ ያምን ሰብ የዘለዓለም ሕይወት ነነን። <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />እያ የሕይወት ቂጣንኩ፤ <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />አቦቻሑ በበረሐ መና በኖ፤ ቢኸንም ᎀቶ፤ <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />በሰሜ የወረደዪ ቂጣ ዚቱ፤ ዚ ቂጣ ይበራ ስርም ኤይᎀት። <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />በሰሜ የወረደዪ የሕይወት ይብ ቂጣ እያትንኩ፤ በዚ ቂጣ ይበራ እንም የዘለዓለም ይነብር፤ የዓለም ሕይወት ይኸንኸም እያ ኢᎅ ቂጣ በሰረኛው።”<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />በዛ ግዝየ አይሑድ “ዚ ሰብ በሰረሑ ኧበራነኸም ምንኸም ይብነዬ ይችል?” በወበር ነብስ በነብሰሕኖ ኦገቶ።<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />ስለኸነም ኢየሱስ እኪ ባረኖ፤ የኢን፥ የኢን ኧብርሑ የሰብ ትኸ በሠር ባንበራሑ፥ ደመሑም ባንሰጨሑ ሕይወት ኤነናሑ። <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />በሰረኛ ይበራ ደመኛ ይሰጭም እንም የዘለዓለም ሕይወት ነነን፤ እያም በመጨረሻዪ በፍርድ ከነ ተሞት አትኔሣን። <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />በሰረኛ የኢንም ስንቁ፥ ደመኛም የኢን ይሰጪ ቃሩ። <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />በሰረኛ ይበራም ደመኛ ይሰጭ እንም ቢያ ይነብር፤ እያም በሑቲ ኧነብር። <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />“ሕያው አብ የላዄኸም እያም በሑቲ ሕያው የኸንኩኸም ዛምኸም በሰረኛ ይበራዪ እንም ቢያ ሕያው ይኸን። <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />ኧጌሽ በሰሜ የወረደ ቂጣ ዚቱ፤ ሑቲም አቦቻሑ የበኖይኸም አንከነ፤ ዛ ቂጣ የበኖዪ ᎀቶም፤ ዚም ቂጣ ይበሮዪ የዘለዓለም ይነብሮ።”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />ኢየሱስ ዚ የዝነጔን በቅፍርናሖም በምኩራብ ቢያትመርወ ግዝየ ባነ።<verse eid="JHN 6:59" /></para>
  <para style="s1">የዘለዓለም የሕይወት ቃል</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />ተደቀ መዛሙርተሑ ብዠሕኖ ዚ በሰሞ ግዝየ፥ “ዚ ዘንጋ ይረዝ፤ ሟ ይቌᎄሬ ይችል?” ባሮ።<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />ኢየሱስም የደቀ መዛሙርተሑ ስለኸነዪ ቃር ቁምቁሜ የባሮኸም በመንፈሰሑ ሐረም እኪ ባረኖ፦ “ዚ ዘንጋ ቈፋ ይኸንብኩ? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />የሰብ ትኸ ተነበረወዬ ተዠበረም ቲወጣ ትታዞ ምን ትብሮዬው? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />ሕይወት ይብ የእዝጌር መንፈሱ፤ የሰብ ቆትም አትም ኤይድገግልል፤ እያ ያሑ የዝነጔሑኒ ቃል መንፈስሙ፤ ሕይወትሙ፤ <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />ቢኸንም ታሑ ግብት አታተሕኖ ኤያምኖ ነኖ፤” ኢየሱስ ዚ የዝነጔ ቲፍቴ ቀረሰም ኤያምኖ ነሟ የኸኖኸም አቼለፈም ይᎅም ሟ የኸነኸም ይሒር ባነ። <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />ቄጠለም ኢየሱስ “ተአብ የፌቈደነ ባንከነ ቲያዬ ወተኝ ይችል ኤነ የባኩሑ የዚቱ” ባረ።<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />በዚም መሳ ተደቀ መዛሙርተሑ ብዠሕኖ ታንቌዬ ተዠበሮ፤ ተዛ ግዝየ ቀረሰም የኢየሱስ ወትኸተል ገፈሮ። <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />ስለኸነም ኢየሱስ የዐሥረ ዄቲ ደቀ መዝሙር፥ “አሑም ወወር ትሸዎ?” ባረኖ። <verse eid="JHN 6:67" /><verse number="68" style="v" sid="JHN 6:68" />በዛ ግዝየ ስምዖን ጴጥሮስ እኪ ቲብር ዠበረ፦ “ጔታ! ተሟዬ ናርነ? አኸ የዘለዓለም የሕይወት ቃል ነነናኸ። <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />ኢናሽ አመነም፤ ቅዱስ የእዝጌር ትኸ አኸ የኸንከኸም ሐርነም።”<note caller="-" style="x"><char style="xo" closed="false">6፥68-69</char><char style="xt" closed="false"><ref loc="MAT 16:16">ማቴ. 16፥16</ref>፤ <ref loc="MRK 8:29">ማር. 8፥29</ref>፤ <ref loc="LUK 9:20">ሉቃ. 9፥20</ref>። </char></note><verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />ኢየሱስም “ያሑ ዐሥረ ዄታሑ ሜጠረኩሑም አንከነ? ቢኸንም ታሑ አቲ ዳቡሎሱ” ባረኖ። <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ዚም የቧረን የስምዖን ትኸ አስቆሮታዊዪ ይሑዳ ባነ፤ ይሑዳ ተዐሥረ ዄቲ አቲ ቢኸንም የኢየሱስ አቼለፈም ይብ ሑቲ ስለኸነው።<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s1">ኢየሱስ የዳስ በዓል ቲከበርወዪ ተኢየሩሳሌሜ ወረ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />በዛ አንቌ ኢየሱስ በገሊላ ገኝ ይዣዦር ባነ፤ አይሑድ ይቀጥሮዬ ይሸዎ ስለኸነም በይሑዳ ይዣዦሬ አንሸ፤ <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />በዛ ግዝየ የአይሑድ የዳስ በዓል ቀረበም ባነ።<note caller="-" style="x"><char style="xo" closed="false">7፥2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">ዘሌ. 23፥34</ref>፤ <ref loc="DEU 16:13">ዘዳ. 16፥13</ref>። </char></note> <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />የኢየሱስ ጐባቢት እኪ ባሮ፤ “ደቀ መዛሙርታኸም ኧሗም ትሸኩቺ ታምራት ያዞኸም፤ ተዚ ተንሣም ተይሑዳ ገኜ ወር። <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />ቢልቢጢጦ ይትኴሬ ይሸ ሰብ ሜናሑ በሽሙቸን ኤይሸክት፤ አኸም ነዚ ዘንጋ እንም ትትሸክት ነብሳኸ የዓለም ታቴዤ ያሸ።” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />ዚም የባሮᎄ መሳ ጐባቢተሑም በሑቲ ያነመኖ ስለኸነው።<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />ኢየሱስም እኪ ባረኖ፦ “ይያ ግዝየ ገና አንሰላ፤ ያሑ ግዝየም እንጌ የትሜቸው። <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />ዓለም ያሑ ይጠላዬ ኤይችል፤ እያም ሜናሑ ቡሼ ወሕነሑ ኧምሰክርወ ስለኸነ ይያ ይጠሌ። <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />አሑ ተበዓሊዬ ወሮ፤ እያም ግዝየኛ ገና ያንሰላ ስለኸነ ተዚ በዓሌ አናር።” <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />ዚም ባረም ሑቲ በገሊላ ቀኘ።<verse eid="JHN 7:9" /></para>
  <para style="s1">ኢየሱስ በዳስ በዓል ᎈር ወትረኸበሑ</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />ቢኸንም ጐባቢተሑ ተበዓሊዬ በወሮ አንቌ ሑቲ ቢልቢጢጦ ቴይኸን ተሼመም ተበዓሌ ወረ። <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />በበዓሊም “ሑቲ ቤቴዉ?” ባሮም አይሑድ ይሸዎይ ባነ።<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />ሕዝቢም ስለ ሑቲ በመቈ ይዝናጎ ባነ፤ አታቲ “ሑቲ ሱት ሰቡ” ቲብሮ፥ ኧንጐዲም “አንከነ፤ ሑቲ የሕዝቢ ያሰሰት” ይብሮ ባነ። <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />የሕን አንኸንም የአይሑድ ባለሥላጣኖች በወገና ሟንም ስለሑቲ ቢልቢጢጦ አንዘጔ።<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />በበዓሊም ግብት ኢየሱስ ተቤተ መቅደሴ ወረም ያትመር ቀረሰ። <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />አይሑድም፥ “ዚ ሰብ ቴይትመር ዚ እንም ምንኸም ይሒሬ ቻለ?” ባሮም ይዴነቆ ባነ።<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />ስለኸነም ኢየሱስ እኪ ቲብር ዠበረ፦ “ይያ ትምርት ተላኼዪ በአብ የትረከበው አንከንም ቢያ አንከነ። <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />የላኼዪ ፈአድ ወሰክት ይሸ ቢነብር ዚ ትምርት በእዝጌር የትረከበ፥ እያ ተነብሰኛ የዝነጔሑን ወሕነሑ ይሒር። <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />ተነብሰሑ ይዝነግ የነብሰሑ ክብር ይሸ፤ የላዀኒ ክብር ይሸ የኢነውታው፤ ባጢልም ኤነወ። <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />ሙሴ ሕጊ አበናሑም አንከነ? ቢኸንም ባሑ ሕጊ ይፌጥም ሟንም ኤነ። አሑ የመአር ትቀጥሮኜ ትሸዎ?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />ሕዝቢም አኸ ጋኔን ነነብከ፤ ሟ ይቀጥርኸዬ ይሸ? ባሮይ።<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እያ አት ሜና ሸከትኩ፤ አሑም እንማሑ በዚ ሜና ትዴነቆ። <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />ሙሴ ጤበን ያወነᎄ ሴራ አበናሑ፤ ዚ ሴራ የትረከበ፤ ተአቦቸናው አንኸንም በሙሴ አንከነ፤ አሑም በሰምበት የትኸ ጤበን ታወኖ።<note caller="-" style="x"><char style="xo" closed="false">7፥22 </char><char style="xt" closed="false"><ref loc="GEN 17:10">ዘፍ. 17፥10</ref>፤ <ref loc="LEV 12:3">ዘሌ. 12፥3</ref>። </char></note> <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" />ኧጌሽ በሙሴ መሳ ያᎅዪ ሕጊ ኤሸሪኸም በሰምበት ከነ ሰብ ጤበን ያወና በኸነ ኧጌ፥ እያ በሰምበት ከነ የሰብ እንም ቃር ፈያ በወሰክተኛ የመአር ትማቶ?<note caller="-" style="x"><char style="xo" closed="false">7፥23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">ዮሐ. 5፥9</ref>። </char></note> <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />ሱት የኸነዪ ፍርድ ፍርዶ አንኸንም የሰብ ኢፍት አዠሑም በዋዳላ አትፍርዶ።”<verse eid="JHN 7:24" /></para>
  <para style="s1">ስለመሲሕ የትነሣ ኦገት</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />የኢየሩሳሌም ሰቦች አታተሕኖ እኪ ባሮ፦ “ይቀጥሮዬ ይሸዎይ ሰብ ዚ አንከነ? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />ዘ፥ ሑቲ ቢልቢጢጦ ይዝነግ፤ ሕኖም አትም አንባሮይ፤ ዚ ሰብ ክርስቶስ ወሕነሑ ባለሥልጣኖች የኢንም ሐሮም ይኸን? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />ቢኸንም ዚ ሰብ ቤቴ የኸነኸም ኢና ኧሒርነ፤ ክርስቶስ ቲቸኝ ቤቴ የኸነኸም ይሒር ሟንም ኤነ።”<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />ስለኸነም ኢየሱስ በቤተ መቅደስ ቲያትመር ትናነ ጣምባሑ ከፍ አበኘም እኪ ባረ፦ “ይያም ቲሒሮኝ፤ ቤቴም የቸኘሑኸም ቲሒሮ፤ ቢኸንም እያ በነብሰኛ ስልጣን አንተኘሑ፤ የላኼ ሑቲ የኢኑ፤ አሑም አቲሒሮይ። <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />እያም በሑቲዬ የቸኘሑ ስለኸነ ሑቲ የላኼኸም ኧሒን።”<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />በዛ ግዝየ ይጠብጦዬ ሸዎም ባነ፤ ቢኸንም ግዝየሑ ገና ያንሰላ ስለኸነ ሟንም አጠᎄጠን። <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />ቢኸንም ተሕዝቢ ብዠሕኖ በሑቲ አመኖ፤ እኪም ባሮ፦ ክርስቶስ ቢቸኝወዪሽ ግዝየ ዚ ሰብ ተሸከተኖ ታምር የጠቀለ ይሸክት?<verse eid="JHN 7:31" /></para>
  <para style="s1">የኢየሱስ ይጠብጦይኸም ወታደር ወላኸሕኖ</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />ሰቦች ስለ ኢየሱስ በመቈ ቲይዝናጎ ፈርሳውያን ሰሞ፤ ስለኸነም የካሕናት አለኦች ፈሪሳውያን ኢየሱስ የዋጠብጥ የቤተ መቅደስ ዘብ ይቅሮዪ ላሖ። <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />በዛ ግዝየ ኢየሱስ እኪ ባረ። “ታሑጌ ቀል ግዝየ ኤክስ፤ በዛ አንቌ ተላኼዬ አር፤ <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />አሑ ትሸዎኝ፤ ቢኸንም አትረሕቦኝ፤ እያ ታነሑወዬ፥ አሑ ወተኝ አትችሎ።”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />ስለኸነም የአይሑድ ባለሥልጣን እኪ ተበበሮ፦ “ኢና አንረሕብኔኸም ዚ ሰብ ቴቴ ያሬዉ? የሟንᎀሑ በግሪኮች ግብት ተትብራጦ አይሑዴ ወረም የአሕዛብ ያትመር ይኸን? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />‘ትሸዎኝ፤ ቢኸንም አትረሕቦኝ፤ እያ ታነሑወዬ አሑ ትቸኖዬ አትችሎ’ ቲብር ምን ወበረሑ?”<verse eid="JHN 7:36" /></para>
  <para style="s1">የሕይወት ኧጋ ምንጭ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />በበዓሊ መጨረሻ በኸነዪ በወደሊ ከነ ኢየሱስ ቈመም ጣምባሑ ከፍ አበኘም እኪ ባረ፦ “ኧጋ የጠሟን ቢነብር ቲያዬ የተኝም የስጤ፤<note caller="-" style="x"><char style="xo" closed="false">7፥37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">ዘሌ. 23፥36</ref>። </char></note> <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />ቢያ ያምን ቅዱስ መጽሐፍት ይቡንኸም፥ የሕይወት ኧጋ ምንጭ በደነሑ ይፈልቅ።”<note caller="-" style="x"><char style="xo" closed="false">7፥38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፥1</ref>፤ <ref loc="ZEC 14:8">ዘካ. 14፥8</ref>። </char></note> <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ዚም የዝነጔ በሑቲ ያመኖዪ ይቌበሮይ ስለመንፈስ ቅዱስ ባነ፤ ኢየሱስ ገና ተክብሬ ያንወጣ ስለኸነ መንፈስ ቅዱስ ገና አወረደ ባነ።<verse eid="JHN 7:39" /></para>
  <para style="s1">በሕዝቢ ግብት ወልያይ ወሕነሑ</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />ስለኸነም በሕዝቢ አታተሕኖ ዚ ቃል በሰሞ ግዝየ፦ “ይቸኝ የቧሪ ነብይ የኢንም ዚቱ” ባሮ። <verse eid="JHN 7:40" /><verse number="41" style="v" sid="JHN 7:41" />ኧንጐዲ “ዚ መሲሑ” ባሮ። እንጐደሕኖም “ክርስቶስ ይቸኝ በገሊላው? <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />መጽሐፍ፤ ክርስቶስ በዳዊት ዝሬት፤ ዳዊትም በነበረወ ከተማ በቤተ ልሔም ይቸኝኸም ይዝነግ ኤነ?”<note caller="-" style="x"><char style="xo" closed="false">7፥42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 ሳሙ. 7፥12</ref>፤ <ref loc="MIC 5:2">ሚክ. 5፥2</ref>። </char></note> <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />ስለኸነም በሑቲ መሳ በሕዝቢ ግብት ወልያይ ኸነ። <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />አታተሕኖ ይጠብጦዬ ሸዎም ባነ፤ ቢኸንም ሟንም አንጠᎄጠን።<verse eid="JHN 7:44" /></para>
  <para style="s1">የአይሑድ መሪዎች አለወምነሕኖ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />በዛ አንቌ ዘብ ይቅሮዪ ተካሕናት አለኦች ተፈሪሳውያኔም ተዠበሮም ወሮ፤ ሕኖም “የመአር አናተኘሑይ?” ባሮዮ።<verse eid="JHN 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />ወታደሮቺም “ዚ ሰብ ይዝነግንኸማት ሟንም ዝነጔም ኤይሒር” ቲብሮ ዠበሮ።<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />ፈሪሳውያንም እኪ ባሮ፦ “አሑም ተዳላሑም? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />ወሕነሑ ተባለ ሥልጣኖችም ተፈሪሳውያን በሑቲ ያመኖ ነኖ? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />ዚ የሙሴ ሕጊ ኤይሒር ሕዝብ የኢንም የሰደበው።”<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />በዚ ኢፍቴ ተኢየሱሴ ወረም የነበረዪም ተፈሪሳውያን አቲ የኸነ ኒቆዲሞስ፥<note caller="-" style="x"><char style="xo" closed="false">7፥50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ዮሐ. 3፥1-2</ref>። </char></note> <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />“በሕገና መሠረት አት ሰብ የክስ መልስ በደረም ቴይሴሟነም መአር የሸከተኸም ቴይትኴር ይᎈርጅᎄ?” ባረኖ።<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />ሕኖም “አኸም ተገሊላከ ወይ? ነብይ ተገሊላ ኤትነሣኸም መርምርማኸ ሐር” ባሮይ። <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />አትባተሕኖ ተቤተሕኖዬ ወሮ።<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s1">ትትሟግጥ የጠᎄጭያ ምሽት</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />በዛ አንቌ ኢየሱስ ተደብረ ዘይቴ ወረ። <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />የመናጊ ቅረር ሱቢ ተቤተ መቅደሴ ተዠበረም ቸኘ፤ ሕዝቢ እንም ተሑቲዬ ቸኖ፤ ሑቲም ቶናም ያትመር ባነ። <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />የሕጊ አስተማሪዪ ፈሪሳውያንም ትትሟግጥ የጠᎄጭያ ምሽት አቸኖም በሕዝቢ ግብት አቆሞያ። <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />የኢየሱስም እኪ ባሮይ፦ “አስተማሪ፥ ዘ፥ ዚ ምሽት ትትሟግጥ ጠᎄጪያም፤ <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />ዚኸሚ ምሽት ብምን ወጐያም ትᎀትኸም ሙሴ በሕገና ኤዘዘነም፤ አኸሽ ስለሒቲ ምን ትብር?”<note caller="-" style="x"><char style="xo" closed="false">8፥5 </char><char style="xt" closed="false"><ref loc="LEV 20:10">ዘሌ. 20፥10</ref>፤ <ref loc="DEU 22:22-24">ዘዳ. 22፥22-24</ref>። </char></note> <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />ዚም የባሮ በሑቲ ᎈር የክስ መሳ ይረሕቦኸም ይፌትኖዬ ሸዎም ባነ፤ ኢየሱስም ሙግ ባረም ባጤበተሑ ባፈር ᎈር ይጠፍ ቀረሰ። <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />ዥባበሮም በሳሎይ ግዝየ ቀና ባረም፥ “ታሑ ግብት አጢያት ዬነወ የብድርም ብምን የውጋና!” ባረኖ። <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />በዛም አንቌ ዠበረም ሙግ ባረም ባፈር ᎈር ጣፈ።<verse eid="JHN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9" />ሕኖም ዚ በሰሞ ግዝየ ተባሊቅ ቀረሰም እንም አት ባተሕኖ በዛ ወሮ፤ ስለኸነም ኢየሱስ በግብተሕኖ ቈመችም ተነበረች ምሽትጌ የቢቶሑ ቀኘ። <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />በዛ አንቌ ኢየሱስ ቀና ባረም፥ “ምሽቶ! ከሳሾቻሽ እንዴምኖ? የፈረደብሽ ሟንም ኤነ?” ባረና።<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />ሒቲም “ጔታ! ሟንም ኤነ” ባረቹ። ኢየሱስም “እያም አንፈርድብሽ፤ ዌር፤ ዠበርሽም አጢያት አትሰክች” ባረና።<note caller="+" style="f"><char style="fr" closed="false">8፥11 </char><char style="ft" closed="false">ብዠ የጎጋ ጡሑፍም የድረ ትርጉምም በምራ. 7፥53—8፥11 የቧረኒ ኤይደብሮ፤ አታቲ በዮሐ. ምዕ. 21፥24 ባንቌ ይኸሮይ፤ እንጐዲ ኧሗም በሉቃ. ምዕ. 21፥38 ባንቌ ይኸሮይ፤ አት የጎጋ ጡሑፍ ኧሗም በዮሐ. ምዕ. 7፥36 ባንቌ ዄናንም። </char></note><verse eid="JHN 8:11" /></para>
  <para style="s1">ኢየሱስ የዓለም ብራን ወሕነሑ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />ዠበረም ኢየሱስ “እያ የዓለም ብራንንኩ፤ ይያም ይትዄተሌ እንም የሕይወት ብራን ይረሕብ፤ በጨለማም ኤይዥባበር” ቲብር ዝነጔኖ።<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቴ. 5፥14</ref>፤ <ref loc="JHN 9:5">ዮሐ. 9፥5</ref>። </char></note><verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />ፈሪሳውያን “አኸ ስለነብሳኸ ትምሰክር፤ ምስክርነታኸ የኢን አንከነ” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">8፥13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">ዮሐ. 5፥31</ref>። </char></note><verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እያ ስለነብሰኛ ብንምሰክር ቤቴ የቸኘሑኸም፥ ቴቴ አርኸም ስለሐርኩ ምስክርነተኛ የኢኑ፤ አሑም ቤቴ የቸኘሑኸም ቴቴ አርኸም አትሒሮ። <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />አሑም በፎላሑ አሳብ ትፈርዶ፤ እያ በሟንም ᎈር አንፈርድ። <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />ብንፈርድም የላሔ አብ ቲያጌ ስለኸነም እያ የቢቶኛ አንፈርድ ስለኸነ ፍርደኛ የኢኑ፤ <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />የዄት ሰብ ምስክርነት የኢን የኸነኸም በሕጋሑ ተጣፈም። <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />ስለኸነም እያ ስለነብሰኛ እምሰክር፤ የላኼ አብም ስለእያ ይምሰክር።” <verse eid="JHN 8:18" /><verse number="19" style="v" sid="JHN 8:19" />በዛ ግዝየ ሕኖ “አባኸ ቤቴ ነነ?” ቲብሮ ተሳሎይ። ኢየሱስም “ይያም ኸነ አባኛ አቲሒሮይ፤ ይያም ብትሒሮኝ አባኛም በሐርኩይ ባነ” ቲብር ዠበረኖ።<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ኢየሱስ ዚ ቃል የዝነጔ በቤተ መቅደስ ዋጋ ይቌᎄርᎄ ሳጥን ሜጠቅ ኸነም ቲያትመሩ። የሕን አንከንም ግዝየሑ ገና ያንሰላ ስለኸነ ሟንም አንጠᎄጠን።<verse eid="JHN 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ዠበረም ኢየሱስ እኪ ባረኖ፦ “እያ አር፤ አሑም ትሸዎኝ፤ ቢኸንም ተአጢያታሑጌ ትᎀቶ አንኸንም እያ ትናርወዬ አሑ ትቸኖዬ አትችሎ።”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />የአይሑድ ባለሥልጣኖችም “‘እያ ትናርወዬ አሑ ትቸኖዬ አትችሎ’ ወበረሑ ነብሰሑ ይቀጥር ይኸን?” ተበበሮ።<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ቄጠለም ኢየሱስ እኪ ባረኖ፦ “አሑ በተቴንኩ፤ እያ በነኔኩ፤ አሑ በዚ ዓለምንኩ፤ እያ ተዚ ዓለም አንከንሑ፤ <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />ይያ ሟንነት ሐርኩም ባታምኖ ተአጢያታሑጌ ትᎀቶ ስለኸነ የባኩሑ የዚቱ።”<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />ሕኖም “አኸ ሟንከ?” ባሮይ።</para>
  <para style="p" vid="JHN 8:25">ኢየሱስም እኪ ባረኖ፦ “መጀመሪያ ቀረስኩም ዬወደኩሑኸምንኩ፤ <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />ስላሑ ኧዝነጊኒም ኧᎈርጂ ብዠ ቃር ነኔ፤ የሕን አንኸንም የላኼ የኢኑ፤ እያም የዓለም ሕዝብ ኧዝነጊን በሑቲ የሰማሑኒዉ።”<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />ሕኖም ስለአብ የዝነጔኖኸም አንገባኖ። <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />ስለኸነም ኢየሱስ እኪ ባረኖ፦ “የሰብ ትኸ ከፍ አበኘሑም ብትሰቅሮይ ግዝየ እያ ሑቲ የኸንኩኸም ቲሒሮ፤ ዛምኸም አብ ያትመሬዪ ኧዝነጊኒኸም አንኸንም በነብሰኛ ስልጣን ጠለለ አትም አንሸክትኸም በዛ ግዝየ ታጥራምቶ። <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />የላኼ ሑቲ ቲያጌዉ፤ እንጌ ኧሸኩች የሑቲ ያትቡላልቁ ቃር ስለኸነ የቢቶኛ አንገፈሬ።”<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />ኢየሱስ ዚ በዝነጔ ግዝየ ብዠ ሰቦች በሑቲ አመኖ።<verse eid="JHN 8:30" /></para>
  <para style="s1">የአጢያት ጉዙ ተወሕን ነጣ ወውጣ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />ኢየሱስ በሑቲ ያመኖ አይሑድ እኪ ባረኖ፤ “አሑ በቃለኛ ብትነብሮ የኢንም ደቀ መዛሙርተኛ ትኸኖ። <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />የኢን ቲሒሮ፤ የኢንም ነጣ ያወጣሑ።”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />ሕኖም “ኢና የአብርሐም ዝሬትንነ፤ ስርም የሟንም ጉዙ ኸነም አንሒርነ፤ ኧጌ፥ አኸ ‘ነጣ ትወጦ’ ትብርነ ምንኸሙ?” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">8፥33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">ማቴ. 3፥9</ref>፤ <ref loc="LUK 3:8">ሉቃ. 3፥8</ref>። </char></note><verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />ኢየሱስም እኪ ቲብር ዠበረኖ፤ “የኢን፥ የኢን ኧብርሑ፤ አጢያት ይሸክት እንም የአጢያት ጉዙ፤ <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />ጉዙ እንጌ በቤት ውስጥ ኤነብር፤ ትኸም እንጌ በቤት ውስጥ ይነብር። <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />ስለኸነም ወልድ ነጣ ባወጣናሑ የኢንም ነጣ ትኸኖ። <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />የአብርሐም ዝሬት ወሕናሑ ኧሒር፤ ቢኸንም ቃለኛ አትቌበሮ ስለኸነ ትቀጥሮኜ ትሸዎ። <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />እያ በአባኛዬ ያዠሑኒ ኧዝነግ፤ አሑም በአባሑ የሰማሑዪ ትሸክቶ።”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />ሕኖም “አባና አብርሐሙ” ቲብሮ ዠበሮነ። ኢየሱስም እኪ ባረኖ፦ “የአብርሐም ዴንጋሽ ብትኸኖ የአብርሐም ሜና በሸከትኩ ባነ፤ <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />እያ በእዝጌር የሰማሑኒ የኢን ኤወደኩሑ አሑም ትቀጥሮኜ ትሸዎ፤ አብርሐም እኪ አንሰከተ። <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />በይሽ አሑ ትሸክቶ የአባሑ ሜናው።” ሕኖም “ኢና በወሟግጥ የጨኘነ ዲቃላ አንከነ፤ ቁና አባ ነነነ፤ ሑቲም እዝጌሩ” ባሮይ።<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />ኢየሱስም እኪ ባረኖ፦ “እዝጌር አባሑ ቢኸን ይያ በወደድኩኝ ባነ፤ እያ ተዚዬ የቸኘሑ በእዝጌሬው፤ የላኼ ሑቲቱ አንኸንም እያ በነብሰኛ ሥልጣን አንተኘሑ። <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />የመአር ንግግረኛ ኤገባሑ? ንግግረኛ የወስማ አትችሎ ስለኸነው። <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />አሑ የአባሑ የዳቡሎስ ዴንጋንኩ፤ ኤላታሑ የአባሑ ኤላት ወፈጥሙ፤ ሑቲ ድረ ቀረሰም ነብስ ይቀጥር ባነ፤ የኢን በሑቲ ዬነ ስለኸነ ተኢንጌ አትም ወትራኸብ ኤነን፤ ሑቲ ባጢለተኘም የባጢል እንም አባ ስለኸነ ባጢል ቢዝነግወ ግዝየ በነብሰሑ አወጣም ይዝነግ። <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />እያም የኢን ኧዝነግ ስለኸነ አታምኖኝ፤ <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />ወሕነሑ ታሑ ‘አጢያጠኛከ’ ባረም ይወቅሴ ሟኒ? የኢንም ኧዝነግ በኸንኩ ኧጌ፥ የመአር አታምኖኝ? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />በእዝጌር የኸነ የእዝጌር ቃል ይሰማ፤ በሒሽ አሑ የእዝጌር ቃል አትሰሞ በእዝጌር ያንከንኩ ስለኸነው።”<verse eid="JHN 8:47" /></para>
  <para style="s1">ኢየሱስ ተአብርሐም በደረም የነበረ ወሕነሑ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />አይሑድ “አኸ ሳምራዊንከ፤ ጋኔንም ነነብከ፤ ወበረና ልክ አንከነ?” ባሮይ።<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እያ ጋኔን ኤነቢ፤ ቢኸንም አባኛ አከቡር፤ አሑም ታዋርዶኝ። <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />የሕን አንኸንም እያ የነብሰኛ ክብር አንሸ፤ ይያ ወክብር ይሸዪም ይፈርዲ ኧንጐድ ነነ። <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />የኢን፥ የኢን ኧብርሑ፤ ቃለኛ ይቂየ ስርም ኤይᎀት።”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />አይሑድ እኪ ባሮይ፦ “ጋኔን ያነብከኸም ኧሗ ሐርነ፤ አብርሐም ᎀተም ነብዮችም ᎀቶም፤ አኸም ‘ቃለኛ ይቂየ ኤይᎀት’ ትብር፤ <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />ወሕነሑ አኸ ተᎀተዪ ተአባና ተአብርሐም ትበዛ? ነብዮች ᎀቶም፤ ኧጌ፥ አኸ ነብሳኸ ሟ ትሸክት?” <verse eid="JHN 8:53" /><verse number="54" style="v" sid="JHN 8:54" />ኢየሱስም እኪ ቲብር ዠበረ፦ “እያ ነብሰኛ ብናከቡር ክብረኛ ዋጋ ኤነቡር ይያ ያከብሬ አባኛው፤ ሑቲም ‘አሑ አምላከና’ ትብሮዪው። <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />ቢኸንም አሑ የሑቲ አንካርኩይ፤ እያ ኧሒን፤ እያ አንሒን ብንብር የአሑኸም ባጢለተኘ በኸንኩ ባነ፤ እያም ኧሒን፤ ቃለሑም ኧቅየ። <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />የአባሑ የአብርሐም ኤላት ይያ ከነ አዠም የወትብላለቅ ባነ፤ አዠም ተብላለቀ።”<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />በዛ ግዝየ አይሑድ፥ “አኸ ገና አምሳ ዓመትም አንከነናኸ፤ ኧጌ ምንኸም የአብርሐም አዠሑ ትብር?” ባሮይ።<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />ኢየሱስም “የኢን፥ የኢን ኧብርሑ፤ አብርሐም ተወጠኘሑ ኢፍቴ እያ ባነሑ፤ ኧሗም፥ ቲፍቴዬም ነንኩ።” ባረኖ።<note caller="+" style="f"><char style="fr" closed="false">8፥58 </char><char style="ft" closed="false">በመጽሐፊዪ መጣሐፍ 3፥14 ተጣፊዪ ቁናዪ</char></note><verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />ስለኸነም አይሑድ ይወጎዬ እምን ነሦ፤ ኢየሱስም ተሼተረቦም በቤተ መቅደስ ወጣም ወረ።<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s1">ኢየሱስ ወዥ ኤችል የጨኘዪ ሰብ ዋትርፈሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />ኢየሱስ ቤማ ቲያልፍ ወዥ ኤችል ኸነም የጨኘ ሰብ አዠ። <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />ደቀ መዛሙርተሑ የኢየሱስ “አስተማሪ፥ ዚ ሰብ ወዥ ኤችል ኸነም የጨኘ በሟ አጢያቱ? በነብሰሑ አጢያቱ ወይሽ በወላጆቸሑ?” ቲብሮ ተሳሎይ።<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />ኢየሱስም እኪ ቲብር ዠበረ፦ “ዚ ሰብ ወዥ ኤችል ኸነም የጨኘ በሑቲም በወላጆቸሑ አጢያት መሳ አንከነ፤ ቢኸንም የእዝጌር ሜና ይትገለጥኸሙ። <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />ከነ ትናነ፤ የላኼዪ ሜና ወሰክት ነነቢ፤ ሟንም ሰብ ይሸክቴ ኤይችልወ ምሳር ይቸኝ። <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" />በዓለም ᎈር ትናነሑ እያ የዓለም ብራንንኩ።”<note caller="-" style="x"><char style="xo" closed="false">9፥5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቴ. 5፥14</ref>፤ <ref loc="JHN 8:12">ዮሐ. 8፥12</ref>። </char></note><verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />ዚ በዝነጔ አንቌ ባፈር ᎈር እትፍ ባረም ብምባቌሑ አፈር ሼሸም፤ በጭቃራዪም ወዥ ኤይችሊ ዔን ቀባም፥ <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />“ወርም በሰሊሖም ይጠምቁᎅዪ ታጠብ” ቧረን። (ሰሊሖም ወበር “የትላኸ” ወበሩ።) ስለኸነም ምሲም ወረም ታጠበም ቲያዥ ተዠበረ።<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ኦላሑ ኢፍቴም ቲጮቅስ ያዞ የነበሮዪ ሰቦች፥ “ዚ ሰብ ዛ ቾናም ይጮቅስ የነበረዪ አንከነ?” ባሮ። <verse eid="JHN 9:8" /><verse number="9" style="v" sid="JHN 9:9" />አታቲ “ኤክ፥ ሑቲቱ!” ባሮ። እንጐዲም “ሑቲ ይመስር አንኸንም ሑቲ አንከነ!” ባሮ። ሑቲም “እያትንኩ!” ባረ። <verse eid="JHN 9:9" /><verse number="10" style="v" sid="JHN 9:10" />ሰቦቺም “ኧጌ፥ ኤናኸ ምንኸም ተከፈተ” ባሮይ። <verse eid="JHN 9:10" /><verse number="11" style="v" sid="JHN 9:11" />ሑቲም “ኢየሱስ የቧሪ ሰብ ጭቃራ ዔኖቸኛ ቀባም ‘ሰሊሖም ወርም ታጠብ’ ባሬ፤ እያም ወርኩም ታጠብኩም የወዥ ቻልኩ” ቲብር ዠበረ። <verse eid="JHN 9:11" /><verse number="12" style="v" sid="JHN 9:12" />ሕኖም “ምሲ ኧሗ ቤቴ ነነ?” ባሮይ። ሑቲም “ቤቴ ያነኸም እያ አንሒር” ባረኖ።<verse eid="JHN 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />በዛ አንቌ ሰቦቺ ወዥ ኤችል የነበረዪ ሰብ ተፈሪሳውያኔ ወሰዶይ። <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />ኢየሱስ ጭቃራ ቀባም የምሲ ዔን ያዥኸም የሸኰተን በሰምበት ከነ ባነ፤ <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />ፈሪሳውያን “ምንኸም ወዥ ቻልከ?” ባሮም የምሲ ዠበሮም ተሳሎይ። ሑቲም “ቤነኛ ᎈር ጭቃራ ቀቤም ታጠብኩ፤ በዛም አንቌ ወዥ ቻልኩ” ባረ።<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />በዛ ግዝየ ተፈሪሳውያን አታተሕኖ፥ “ዚ ሰብ ሰምበት ኤያከብር ስለኸነ ተእዝጌር አንከነ” ባሮ። ኧንጐዲም “ኧጌ፥ አጢያተኛ የኸነ ሰብ ነዚ ታምር ምንኸም ወሰክት ይችል?” ባሮ። በዚ መሳ በግብተሕኖ ወልያይ ኸነ።<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />ስለኸነም ወዥ ኤይችል የነበረዪ ሰብ፥ “አኸሽ ዔኖቸሑ ከፈተኒም ትቡን ስለኸነዪ ስለዛ ሰብ ምን ትብር?” ቲብሮ ዠበሮም ተሳሎይ። ሑቲም “ነብዩ!” ባረ። <verse eid="JHN 9:17" /><verse number="18" style="v" sid="JHN 9:18" />ዚ ሰብ ወዥ ኤችል የኸነኸም ዔኖቸሑም ባንቌ ምንኸም የከፈቶኸም ወላጆቸሑ ጠሮም ይሰሎዮ ስን የአይሑድ ባለሥልጣን አነመኖ ባነ። <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />ስለኸነም ወላጆቸሑ፥ “ወዥ ኤይችል ኸነም ተጨኘ ትብሮይ ትኻኹ ዚቱ? ኧሗሽ ምንኸም ወዥ ቻለ?” ቲብሮ ተሳሎዮ።<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />ወላጆቸሑም እኪ ቲብሮ ዠበሮ፦ “ዚ ሰብ ትኸና ወሕነሑ ወዥ ኤይችል ኸነም ወጠኘሑ ኧሒርነ፤ <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />ቢኸንም ኧሗ ምንኸም ያዥኸም ኤነሑም ሟ የከᎈተነኸም አንሒርነ፤ የሑቲ ተሳሎይ፤ ሑቲ ሙላ ሰብ ስለኸነ ነብሰሑ ወዘንግ ይችል።” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />ወላጆቸሑ ዚ የባሮ የኢየሱስ “መሲሑ” ይብር ሰብ ቢነብር የአይሑድ ባለሥልጣኖች ተምኩራብ ያትዌጦዬ ተስማሞም የነበረ ስለኸነ የሕኖ በወገና ባነ። <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />ስለኸነም ወላጆቸሑ፥ “ሑቲ ሙላ ሰቡ፤ የሑቲ ተሳሎይ” ባሮ።<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />በዚ መሳ ወዥ ኤይችል የነበረዪ ሰብ ዠበሮም ጠሮም አኸ የኢን በወዘንግ የእዝጌር አክብር፤ ዚ ሰብ አጢያተኛ ወሕነሑ ኢና ኧሒርነ ባሮይ።<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />ወዥ ኤችል የነበረዪ ሰብ፥ “ሑቲ አጢያተኛ ወሕነሑ እያ አንሒር፤ አት ቃር ኧሒር፤ ዚም እያ ወዥ አንችል የነበርኩኸም ኧሗ ወዥ የቻልኩኸም ጠለለው” ቲብር ዠበረ። <verse eid="JHN 9:25" /><verse number="26" style="v" sid="JHN 9:26" />ሕኖም “ምን ሸከተንከ? ኤናኸሽ የከᎈተን ምንኸሙ?” ባሮይ። <verse eid="JHN 9:26" /><verse number="27" style="v" sid="JHN 9:27" />ሑቲም “በደርኩም ኤወደኩሑ፤ አሑም ወስማ አንሸሑ፤ ኧጌ፥ የመአር ዠበርኩም ወስማ ትሸዎ? አሑም የሑቲ ደቀ መዛሙርት ወሕን ትሸዎ?” ባረኖ። <verse eid="JHN 9:27" /><verse number="28" style="v" sid="JHN 9:28" />ሕኖም እኪ ባሮም ሰደቦይ፦ “የሑቲሽ ደቀ መዝሙር አሐትንከ፤ ኢና የሙሴ ደቀ መዛሙርትንነ፤ <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />እዝጌር የሙሴ ያዝናጔንኸም ኧሒርነ፤ ዚ ሰብም ቤቴ የኸነኸም አንሒርነ።”<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />ምሲም እኪ ቲብር ዠበረኖ፦ “ዚ ሰብ ቤቴ የኸነኸም አለወሐራሑ ያዴንቅ! ቢኸንም ዔነኛ የከᎈተን ሑቲቱ <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />እዝጌር የአጢያተኞቺ ኤይሰማኸም የትኴረው፤ ቢኸንም የእዝጌር ያመልኪ ፈአደሑም ይፌጥም ሰብ ቲነብር የሑቲ እዝጌር ይሰሟን። <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />ወዥ ኤይችል ኸነም የጨኘዪ ሰብ ዔን የከፈተ ነነ ቲቡሪ ዓለም በትኸለቀ ቀረሰም ተሴማም ኤይትከር። <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />ዚ ሰብ ተእዝጌር ቤይኸን አትም ወሰክት ባንቻለ ባነ።”<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />ሕኖም “እንም ቃራኸ በአጢያት ተመላም የጨኘኸንከ! አኸ ይና ታትመረነዬው?” ባሮም በምኩራብ አትዌጦይ።<verse eid="JHN 9:34" /></para>
  <para style="s1">የሒን ወዥ አለወቻል</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />የምሲ በምኩራብ ያትዌጦይኸም ኢየሱስ ሰማ፤ በረከᎄን ግዝየ “በሰብ ትኸ ታምን?” ቧረን። <verse eid="JHN 9:35" /><verse number="36" style="v" sid="JHN 9:36" />ሑቲም ጔታ! በሑቲ አምንኸም ሑቲ ሟኒ? ባረ። <verse eid="JHN 9:36" /><verse number="37" style="v" sid="JHN 9:37" />ኢየሱስ “በዚ ኢፍቴ አዠዀንም፤ ኧሗም ያዝናጔኸ ሑቲቱ” ቧረን። <verse eid="JHN 9:37" /><verse number="38" style="v" sid="JHN 9:38" />ሑቲም “ጔታ! አምን” ባረም ሰጐደነ። <verse eid="JHN 9:38" /><verse number="39" style="v" sid="JHN 9:39" />ኢየሱስም “ዔያዞዪ ያዞኸም፥ ያዞዪም ወዥ ኤይችሎኸም እያ ተዚ ዓለሜ የወፍርድ ቸኘሑም” ባረ። <verse eid="JHN 9:39" /><verse number="40" style="v" sid="JHN 9:40" />በዛ ግዝየ ተኢየሱስ ሜጠቅ የነበሮዪ ፈሪሳውያን ዚ ሰሞም “ኧጌ፥ ኢናም ወዥ አንችልነ ወሕነናው?” ባሮይ። <verse eid="JHN 9:40" /><verse number="41" style="v" sid="JHN 9:41" />ኢየሱስም “ወዥ አትችሎ ብትሕኖማ አጢያት ባንከነብኩ ባነ፤ ኧሗም ናዥነ ትብሮ ስለኸነ፥ አጢያተኛ ኸንኩም ትቀሮ” ባረኖ።<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s1">የኢየሱስ ፈያ ወጅመኘነት</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />ቄጠለም ኢየሱስ እኪ ባረ፦ “የኢን፥ የኢን ኧብርሑ፤ ተጤ በረቴ በበር ቴይኸን ብንጐድ አዘር ይገባ ሰብ ሌባ ዘራፊው። <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />በበሪ ይገባ ሑቲ የጤዪ ወጅመኘው። <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />የሑቲ በር ይቂየዪ ወዝገቢ ይከፉትነ፤ ኧጤዪም ጣምባሑ ይሰሞይ፤ ሑቲም የነብሰሑ የኸኖዪ ኧጤ በሽመኽኖ ይጠራኖ፤ መራም ተወረጀዬ ያወጣኖ። <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />የነብሰሑ ኧጤ ባወጣ አንቌ ኢፍት ኢፍተሕኖ ያር፤ ኧጤዪም ጣምባሑ ይሒሮ ስለኸነ ይትዄተሎይ። <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />ይንጐዲ ሰብ ጣምባም ኤይሒሮ ስለኸነ ተሑቲ ይሰኮ አንኸንም ኤይትዄተሎይ።”<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />ኢየሱስ ዚ ምሳሌ ኤወደኖ፤ ሕኖም የዝነጔኒ ቃር አናጥራመቶ።<verse eid="JHN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />ስለኸነም ኢየሱስ ዠበረም እኪ ባረኖ፦ የኢን፥ የኢን ኧብርሑ፤ እያ የጤ በርንኩ፤ <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />ቲያ ኢፍቴ የቸኖ እንም ሌባ ዘራፊምኖ፤ ኧጤዪ አንሰሞዮ። <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />በሪ እያትንኩ፤ ቢያ ኤማ ይገባ እንም ይተርፍ፤ ይገባ ይወጣ፤ ይወልወ መደር ይረሕብ። <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />ሌባዪ ይቸኝ የወስርቅ፥ የወርድም የዋጥፋ ጠለለው፤ እያ የቸኘሑ ሕይወት ይረሕቦኸም መላም የተረፈ ሕይወት ይነብሮኸሙ።<verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />ፈያ ወጅመኘ እያትንኩ፤ ፈያ ወጅመኘ ሕይወተሑ የጤዪ ቲብር አቼለፈም ይብ። <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />ኧጤዩ የነብሰሑ ያንከኖ ሜነተኘ አንኸንም የኢን ያንከነ ወጅመኘም ተኩላ ቲቸኝ ቢያዥወ ግዝየ ኧጤዪ ገፈረም ይሰክ፤ ተኩላዪም የጤዪ ነጠቀም ይቤትኖ። <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />ወጅመኘዪ ይሰክ ሜነተኘ የኸነዪም የጤዪም ኤዬስብ ስለኸነዉ። <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" />ፈያ ወጅመኘ እያትንኩ፤ እያ ኧጤኛ ኧሒኖ፤ ኧጤኛም ይያ ይሒሮኝ።<note caller="-" style="x"><char style="xo" closed="false">10፥14 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቴ. 11፥27</ref>፤ <ref loc="LUK 22:33">ሉቃ. 22፥33</ref>፤ <ref loc="LEV 24:16">ዘሌ. 24፥16</ref>። </char></note> <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />እያ የሕኖ ኧሒኖ አብ ይያ ይሒሬኸም ኧያም የአብ ኧሒንኸሙ፤ ኧያ የጤኛ ሕይወተኛ አቸለፍኩም ኢብ። <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />በዚ የኧጤ ወጀ ውስጥ ያንከኖ እንጐድ ኧጤ ነኖኝ፤ የሕኖም ዋተኝ ይጌቤ፤ ሕኖ ጣምባኛ ይሰሞ፤ ቁና ወጀ ይኸኖ፤ ወጅመኘዪም ቁና ይኸን።<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />ኧሗም ዠበርኩም ኧወስጄ ሕይወተኛ ይብ ስለኸንኩ አብ ይያ ይወዴ። <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />ሕይወተኛ በፈአደኛ ኢብ አንከንም ቲያ ይወስጅ ሟንም ኤነ፤ ሕይወተኛ የዋብ ዠበርኩም የወውስድ ስልጣን ነኔ፤ ዚ ትዛዝ የትቄበርኩን በአባኛው።<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />ተዚ ንግግር የትነሣ በአይሑድ ግብት ዠበረም ወልያይ ኸነ። <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />ተሕኖም ብዠ ሕኖ፥ “ሑቲ ጋኔን ነነወ፤ ውስ ኸነም፤ የመአር ትሰሞይ?” ባሮ።<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />ኧንጐዲ ዚ ንግግር ጋኔን ባነወ ሰብ አለመት ይወጣ አንከነ፤ ጋኔን ወዥ ኤይችሊ ዔን ወክፍት ይችል? ባሮ።<verse eid="JHN 10:21" /></para>
  <para style="s1">የአይሑድ አለወምን</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />በኢየሩሳሌም የቤተ መቅደስ ወታደስ በዓል ይከበርወ ግዝየ ሰላ፤ ወክቲም በርግ ባነ፤ <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />ኢየሱስ በቤተ መቅደስ ሰሎሞን ቢችላለፉᎄዪ ይዥባበር ባነ። <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />በዛ ግዝየ አይሑድ በዡራሑ ተስበሰቦም፥ “መቸ ስን በወጥራጠር ታቴክስነ? አኸ ክርስቶስ የኸንከኸም የኢን አውድነ” ባሮይ።<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እያ ኤወደኩሑም፤ አሑም አታምኖ፤ በአባኛ ሽም ኧሸኩች ሜና ይያ ይምሰክር። <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />አሑም ተጤኛ ወጀ ያንከንኩ ስለኸነ አታምኖ። <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />ኧጤኛ ጣምባኛ ይሰሞኝ፤ እያም ኧሒኖ፤ ሕኖም ይትዄተሎኝ። <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />እያ የዘለዓለም ሕይወት ኢቦ፤ ስለኸነም ስርም ኤይጠፎ፤ ቲያ ኧጅ ሟንም ነጠቀም ኤይወስዶ። <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />ሕኖም ያቤ አባኛ ትንም ይበዛ። ተአባኛ ኧጅ የሕኖ ነጠቀም ወውስድ ይችል ሟንም ኤነ። <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />እያ አብም ቁና ንነ።”<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />በዛ ግዝየ አይሑድ የኢየሱስ የወውጋ ዠበሮም እምን ነሦ። <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />ኢየሱስም “በአቤ ብዠ ፈያ ሜና አቴዠኩሑ፤ ኧጌ፥ ትወጎኝ ተዚሕኖ ኤቲዋኘ ስለኸነዪ ሜናው?” ባረኖ።<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />አይሑድም፤ “ኧዝነጔኸ፤ ተራ ሰብ ኸንከም ትናነኸ፤ ነብሳኸ አምላክ በወሰክት፤ የስድብ ቃል ስለዝነገኸው አከንም ተዚሕኖ ስለ ፈያ ሜናኸ አንከነ” ባሮም ዠበሮነ።<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />ኢየሱስም እኪ ባረኖ፤ “በሕጋሑሽ ‘አሑ አማልክንኩ ባሑ’ ይብር ተጣፈም ኤነ?<note caller="-" style="x"><char style="xo" closed="false">10፥34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">መዝ. 82፥6</ref>። </char></note><verse eid="JHN 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 10:35" />“ኧጌሽ ቅዱስ መጽሐፍ ወሻር ኤይቸል፤ የእዝጌር ቃል የቸኘኖዪ ቅዱስ መጽሐፍ አማልክት ባረም በጠራኖ፥ <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ኧጌ፥ አብ የቌደሰኒ ተዓለሜ የላዀኒ ‘የእዝጌር ትኸንኩ’ የባረ ስለኸነ የመአር ‘በእዝጌር ᎈር ተሳደብከም ባሑም የመአር’ ቲውነጅሎይ? <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />እያ የአባኛ ሜና አንሸክት በኸንኩ አትምኖኝ። <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />የአባኛ ሜና ኧሸክት በኸንኩም ቢያ ባታምኖ በሜናኛ ኧምኖ፤ በዚኸማት አብ ቢያ የኸነኸም እያም በአብ የኸንኩኸም በሱት ቲሒሮ።”<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />ሕኖም ዠበሮም ይጠብጦዬ ሸዎ፤ ሑቲም በጀሕኖ አመለጠም ወረ።<verse eid="JHN 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />ዠበረም ኢየሱስ የዮርዳኖስ ኧዲየ ተጔናም ዮሐንስ ቢፍቴ ያጠምቅወ ተነበረወ መደሬ ወረ፤ በዛም ኤከሰ።<note caller="-" style="x"><char style="xo" closed="false">10፥40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">ዮሐ. 1፥28</ref>። </char></note> <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />ብዠ ሰቦች ተሑቲዬ ቸኖም “ዮሐንስ አትም ታምር አንሰከተ፤ ቢኸንም ዮሐንስ ስለዚ ሰብ የዝነጔኒ እንም የኢን ባነ” ባሮ። <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />በዛም ብዠ ሰቦች በኢየሱስ አመኖ።<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s1">የአልዓዛር ወሙት</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />በቢታንያ ይነብር አልዓዛር ይቡሪ አት ሰብ ታቌም ባነ፤ ቢታንያ ማርያም ኧተሜታ ማርታ ይነብረማᎄ መንደር ባነ። <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" />ማርያም የጔታ ኧግር ሽቶ የቀባቹዪ በጉነኔታ የሙሻሸቹያ፤ የታቌዪም አልዓዛር የሒቲ ጐቤ ባነ። <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />ኧተሟᎁተሑም “ጔታ፥ ዛ ትወጅጂ አልዓዛር ታቌም” ባሮም ተኢየሱሴ ላሖᎄ።<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />ኢየሱስም ዚ በሰማ ግዝየ፥ “ዚ ኧቂና የሞት ያሰላ አንከነ፤ ቢኸንም የእዝጌር ክብር ይኸንኸም የእዝጌር ትኸ በዚ መሳ ይከብርኸሙ” ባረ።<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />ኢየሱስ የማርታ ኧተሜታ ማርያም ጐቤሕነማ የአልዓዛር ይወጅጅ ባነ። <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />ቢኸንም የአልዓዛር ወታቅ በሰማ ግዝየ በነበረወ መደር ዄት ከነ ኤከሰ። <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />በዛ አንቌ የደቀ መዛሙርተሑ፥ “ተይሑዳ ገኜ ተዠበርነም ንወርነ” ባረኖ።<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />ደቀ መዛሙርተሑም “አስተማሪ! አይሑድ ተቀል ግዝየ ኢፍቴ ይወጎከዬ ይሸዎ ባነ፤ ኧጌ ተዠበርከም ተዛዬ ታር?” ባሮይ።<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ በከነ ዉስጥ ያነዪ ግዝየ ዐሥረዄት ሰዓት አንከነ? በከነ ይዥባበር የዚ ዓለም ብራን ያዥ ስለኸነ ኤይስናከል። <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />ቢኸንም በምሳር ይዥባበር ብራን ዬነን ስለኸነ ይስናከል። <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ኢየሱስ ዚ በባሮኖ አንቌ፥ “ደቦና አልዓዛር ተገደረም፤ እያም በወኔት አትኔሣኔ አር” ባረ።<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />ደቀ መዛሙርተሑም “ጔታ! ተገደረም በኸነ ይጠቁል ወበሩ” ባሮይ። <verse eid="JHN 11:12" /><verse number="13" style="v" sid="JHN 11:13" />ኢየሱስ ዚ የዝነጔን ስለአልዓዛር ወሙት ባነ፤ ሕኖም ስለወኔት የዝነጔ መሰረኖም ባነ።<verse eid="JHN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14" />ስለኸነም ኢየሱስ ቢልቢጢጦ እኪ ባረኖ፦ “አልዓዛር ᎀተም፤ <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />አሑ ታምኖኸም በዛዬ ባለወንብረኛ ስላሑ ተብላለቅሑም፤ ኧሗም ተሑቲዬ ንወርነ።”<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />በዛ ግዝየ ዲዲሞስ የቧሪዪ ቶማስ ኧንጐዲሚ ደቀ መዛሙርት፥ “ተሑቲጌ ኧᎀትነኸም ኢናም ንወርነ” ባረኖ።<verse eid="JHN 11:16" /></para>
  <para style="s1">ኢየሱስ ትንሣኤ ሕይወትም ወሕነሑ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />ኢየሱስ ዛዬ በሰላ ግዝየ አልዓዛር በቀበረ አርበት ከነ ዀነንም ረከᎄን። <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />ቢታንያ በኢየሩሳሌም ይረቅ ሦስት ኪሎ ሜትር ቅጫው። <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />ተአይሑድም ብዠሕኖ ማርታ ማርያምም ስለጐቤሕነማ ሞት የዋጥናና ተሕነማዬ ቸኖም ባነ።<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />ማርታ የኢየሱስ ወተኝ በሰማች ግዝየ ትቌᎄሬ ወጣች፤ ማርያምም በቤት ቀኘችም ባነ። <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />ማርታ የኢየሱስ፥ “ጔታ! አኸ በዚ ብትኸን፥ ጐቤኛ ቤᎀቱ፤ <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />ቢኸንም ኧሗም ትጮቁሺ እንም እዝጌር ይብከኸም ኧሒር” ባረቹ።<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />ኢየሱስም “ጐቤያሽ ዠበረም ተሞት ይትነሣ” ባረና። <verse eid="JHN 11:23" /><verse number="24" style="v" sid="JHN 11:24" />ማርታም “በመጨረሻዪ ከነ በትንሣኤ ግዝየ ተሞት ይትነሳኸም ኧሒር” ባረቹ።<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />ኢየሱስም “ትንሣኤ ሕይወትም እያትንኩ፤ ቢያ ያምን ቢᎀት በሕይወት ይነብር፤ <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />በሕይወት ይነብሪም ቢያም ያምን እንም ስርም ኤይᎀት፤ ዚ ቴምን?” ባረና።<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />ሒቲም “ኤክ ጔታ! አኸ ተዓለሜ ይቸኚ ክርስቶስ የእዝጌር ትኸ ወሕናኸ አምን” ባረቹ።<verse eid="JHN 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />ማርታ ዚ በዝነጔች አንቌ ወረችም የተሜታን የማርያም “አስተማሪዪ ቸኘም፤ ያሺም ይጠራሹ” ባረችም በሽሙቸ ጠራታ። <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />ማርያም ዚ በሰማች ግዝየ አቴከለችም ተነሳችም ተሑቲዬ ወረች። <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />በዛ ግዝየ ኢየሱስ ማርታ የሑቲ በረከበትወ መደር ባነ አንኸንም ተመንደሬ ገና አንገባ ባነ። <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />የሒቲ የዋጥናና ቸኖም በቤት ውስጥ ተሒቲጌ የነበሮዪ አይሑድ ማርያም አቴከለችም ተነሳችም ትትወጣ አዞም ተዓልዓዛር ቀብሬ ወረችም ትበኴ መሰረኖም ተዄተሎያ።<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />ማርያም ኢየሱስ ተነበረወዬ ቸኘችም ባዠቹ ግዝየ በግረሑ ተት ወጠቀችም “ጔታ፥ አኸ በዚ ብትኸን ጐቤኛ ቤᎀቱ” ባረቹ።<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />ኢየሱስ ሒቲም ትትበሕም ተሒቲጌ የቸኖዪም አይሑድ ቲበሖ ባዠ ግዝየ በመንፈሰሑ ስርም አᎀጠጠንም በወረበሽ፤ <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />“ቤቴው የቀበርኩይ?” ባረ። ሕኖም “ጔታ! ኔኸ ኧዥ” ባሮይ።<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />ኢየሱስም ኢንባሑ አᎈሰሰን። <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />ስለኸነም አይሑድ “ምንኸም ይወጅጅ የነበረኸም አጥራምቶ” ባሮ።<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />ተሕኖም አታተሕኖ፥ “ወዥ ኤይችሊም ዔን የከፈተ፥ ዚ ሰብ ኤይᎀትኸም ይሸክቴ ኤይችል ባነ?” ባሮ።<verse eid="JHN 11:37" /></para>
  <para style="s1">ኢየሱስ የአልዓዛር በሞት ያትኔሳንኸም</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />ኢየሱስ ስርም ቲያᎀጭጭ ተቀብሬ ወረ፤ ቀብሪ ብምን የዘጔ ዋሻ ባነ። <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ኢየሱስ “እምኒ ንሦይ” ባረ። የሟቺ ኧተም ማርታ፥ “ጔታኛ፥ በᎀተ አርበት ከነ ዀነንም፤ ኧሗ ይጭየ” ባረቹ።<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />ኢየሱስም “ብቴምን የእዝጌር ክብር ታዥ ባክሽም አነበረ?” ባረና።<verse eid="JHN 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41" />ሰቦቺም እምኒ ነሦይ፤ በዚ አንቌ ኢየሱስ ተነኔ አዠም፥ “አባኛ! የሰማሑ ስለኸነ ምስጋናኸ ኧብርከ፤ <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />እንጌም ትሰሜኸም ኧሒር፤ ቢኸንም ዚ የባሑ፥ በዚዬ የቈሞ ሰብ አኸ የላሕኬኸም ያምኖ ኸም ባሑሙ” ባረ። <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />ኢየሱስ ዚ በዝነጔ አንቌ “አልዓዛር! ኔኸ ውጣ!” ባረም በወደል ጣምባ ዝነጔ። <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />የᎀተዪ አልዓዛርም ኧጀሑም ኧግረሑ በከፈን የኬᎈኒዮኸም በቀብሪ ወጣ፤ ኢፍተሑም በከፈኒ የኬᎈኒኸም ባነ፤ ኢየሱስም ፍቶም ግፍሮይ የወር! ባረኖ።<verse eid="JHN 11:44" /></para>
  <para style="s1">በኢየሱስ ᎈር የሸከተ ሤራ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቴ. 26፥1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14፥1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፥1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />የማርያም የዋጥናና ቸኖም ተነበሮዪ አይሑድ ብዠ ሕኖ የሸኰተኒ አዞም በኢየሱስ አመኖ። <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />አታተሕኖም ተፈሪሳውያኔ ወሮም ኢየሱስ የሸኰተኒ ኤወዶዮ። <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />ስለኸነም የካሕናት አለኦች ፈሪሳውያንም የጀᎈሪ አባል ስበሰቦም እኪ ባሮ፦ “ዚ ሰብ ብዠ ታምር ይሸክት ስለኸነ ምን ንሰክትኔ? <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />ዛምኸም ብንገፍርኔ ሰብ እንም በሑቲ ያምን፤ ሮማውያን ቸኖም ቤተ መቅደሰናም ሕዝበና እንም ያጠፎብነ።”<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />ቢኸንም ተሕኖ አቲ በዛ ዓመት የካሕናት አለአ የነበረዪ ቀያፋ እኪ ባረ፦ “አሑ አትም አቲሒሮ፤ <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />ሕዝቢ እንም ተወጥፋሑ ቁና ሰብ ስለሕዝቢ ቢᎀት ያሑ ይጠቅል ወሕነሑ ስርም አንትረዳሑይ?” <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />ሑቲም ዚ የዝነጔን፥ በነብሰሑ አምነጨም አነበረ፤ ቢኸንም በዛ ዓመት ሑቲ የካሕናት አለአ የነበረ ስለኸነ፥ ኢየሱስ ስለሕዝቢ ወሙት ይጌቧንኸም ቲያምለክት ዚ ትምቢት ዝነጔ። <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ይᎀቲም ስለሕዝቢ ጠለለ ቴይኸን፥ የትቤተኖዪም የእዝጌር ዴንጋ ቁናዬ የወሰብስቡ።<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />ስለኸነም በዛ ከነ ቀረሰም የኢየሱስ የወቅጥር ተምካከሮ። <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />በዛ አንቌ ኢየሱስ በአይሑድ ግብት ቢልቢጢጦ አንተዥባበረ፤ ቢኸንም በዛ ወጣም በበረሐ ᎀረ ታነዪ ኤፍሬም ቲይቡሪዪ ከተማዬ ወረ፤ በዛ ተደቀ መዛሙርተሑጌ ኤከሰ።<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />የአይሑድ የፉሲካ በዓል ቀረበም ባነ፤ ብዠሕኖም የፋሲካ በዓል ተወስላሑ ኢፍቴ፥ ነብሰሕኖ የዋንጣ ተመድር መደረሑ ተኢየሩሳሌሜ ወሮ፤ <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />ሕኖም በቤተ መቅደስ ቈሞም የኢየሱስ ወተኝ ይቅሮ የነበረ ስለኸነ “ምን ቴስቦ? ተበዓሊዬ ይቸኝ ኤይመስርሑ?” ቲብሮ ነብስ በነብሰሕኖ ይሰሰሎ ባነ። <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />ኧሗም የካሕናት አለኦች ፈሪሳውያንም የኢየሱስ ወጥብጥ ይችሎኸም ያነወዪ መደር ይሒር ሰብ ቢነብር ይጦቅሞኸም የሰቦች እንም ኤዘዞም ባነ።<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s1">የኢየሱስ ሽቶ የቀባች ምሽት</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቴ. 26፥6-13</ref>፤ <ref loc="MRK 14:3-9">ማር. 14፥3-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />የአይሑድ የፋሲካ በዓል ይከበሬ ስድስት ከነ ቲቈይን፥ ኢየሱስ ተቢታንያዬ ወረ፤ ቢታንያ ኢየሱስ ተሞት ያትኔሳን አልዓዛር ይነብርወ መንደሩ። <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />በዛ ኧርባት አዝጋዶም፤ ማርታ ታግለግል ባነ፤ አልዓዛርም ተኢየሱስጌ በማዳ ቀረቦም ተነበሮዪ አቲ ባነ። <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" />በዛ ግዝየ ማርያም ዋጋሑ ስርም የትከበረ ተንጡ ናርዶስ የሸከተ፥ ግብት ሌትር ይኸን ቁና ብልቃጥ ሽቶ ወሰደችም፥ የኢየሱስ ኧግረሑ ቀባቹ፤ በጉነኔታም ሙሻሸቹ፤ ቤቲም በሽቶዪ ወሶታ ተᎀላ።<note caller="-" style="x"><char style="xo" closed="false">12፥3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፥37-38</ref>። </char></note> <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />ተደቀ መዛሙርተሑ ውስጥ አቲ የኢየሱስ አቼለፈም ይᎅ አስቆሮቱ ይሑዳ፥ <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />ዚ ሽቶ በሦስት መቶ ዲናር ተስየም ዋጋዪ የዜጋ የመአር አናቡዮ? ባረ። <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />ሑቲ ዚ የዝነጔኒ፥ የዜጋ አዘነም ቴይኸን፥ ሌባ ስለኸነው፤ የዋጋ ኸረጪት ይጠብጥ ሑቲ በወሕነሑ በኸረጪተሑ ይዀራኒ ዋጋ ወውስድ ሮሸም ባነ።<verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />ኢየሱስም እኪ ባረ፦ “ኧቀበርወ ከነ የሸከተቹ ዝግጅት ስለኸነ ግፍሮያ። <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />ዜጋ እንጌ ታሑጌኖ፤ እያም እንጌ ታሑጌ አንኸን።”<note caller="-" style="x"><char style="xo" closed="false">12፥8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዘዳ. 15፥11</ref>። </char></note><verse eid="JHN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />በዛ ግዝየ ተአይሑድ ብዠሕኖ ኢየሱስ በቢታንያ ወሕነሑ ሐሮም ቸኖ። የቸኖዪም ስለኢየሱስ ጠለለ ቴይኸን ኢየሱስ በሞት ያትኔሳኒ የአልዓዛር የወዥ ባነ። <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />የካሕናት አለኦች የአልዓዛር የወቅጥር ተማከሮ። <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />በሑቲ የትነሳ ተአይሑድ ብዠሕኖ እምነተሕኖ ገፈሮም በኢየሱስ ያመኖ ስለኸነው።<verse eid="JHN 12:11" /></para>
  <para style="s1">የኢየሱስ በወደል ክብር ተኢየአሩሳሌሜ ወግባ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቴ. 21፥1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11፥1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፥28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />የመናጊ በፋሲካ በዓል የቸኖ ብዠ ሰቦች ኢየሱስ ተኢየሩሳሌሜ ይቸኝ ወሕነሑ ሰሞ። <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />ስለኸነም የዘንባባ ጫፍ ጠበጦም ይቌበሮዬ ወጦ፤ “ሖሳዕና! በጔታ ሽም ይቸኚ የእስራኤል ንጉሥ የትባረከው!” ቲብሮ ው ይብሮ ባነ።<note caller="-" style="x"><char style="xo" closed="false">12፥13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">መዝ. 118፥25-26</ref>። </char></note><verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />ኢየሱስ ይማር ደርማ ረከበም በሑቲ ᎈር ቶናም፤ ዚም የኸነዪ፥<verse eid="JHN 12:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="JHN 12:15" />“አኸ የጽዮን ከተማ ኢየሩሳሌም አትገና!</para>
  <para style="q1" vid="JHN 12:15">ዘ! ንጉሳኸ ብማር ደርማ ቾናም ይቸኝ”<note caller="-" style="x"><char style="xo" closed="false">12፥15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዘካ. 9፥9</ref>። </char></note></para>
  <para style="m" vid="JHN 12:15">ቧሪም የጣፈዪ ትምቢት ይትፌጠምኸሙ።<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />ደቀ መዛሙርተሑ ዚ ዘንጋ በደረም አንገባኖ ባነ፤ ኢየሱስም በክብር ተሰሜዬ ባረገ ግዝየ ዚ ዘንጋ ስለ ሑቲ የጣፈኸም የሑቲም የሸኰተነኸም አስታውሶ።<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />ኢየሱስ የአልዓዛር በቀብር ውስጥ ጠራም በሞት ባትኔሳን ግዝየ ተሑቲጌ የነበሮዪ እንም ስለኢየሱስ ይምሰክሮ ባነ። <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />ብዠ ሰቦች ይትራከቦዬ የወጦዪም ዚ ታምር የሸከተኸም ሰሞም የነበረ ስለኸነው። <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />በዛ ግዝየ ፈሪሳውያን፥ “ዘ፥ የዓለም ሕዝብ እንም ተዄተለንም! ኢና አትም ወሰክት አንችልነኸም ታዞ?” ተበበሮ።<verse eid="JHN 12:19" /></para>
  <para style="s1">የግሪክ ሰብ የኢየሱስ የሸዎይኸም</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />በበዓሊ ግዝየ ይሰግዶዬ ተኢየሩሳሌሜ ተወሮዪ ሰቦች ግብት፥ አታት ግሪኮች ይትረከቦ ባነ። <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />ሕኖም በገሊላ የቤተ ሳይዳ ሰብ ተኸነዪ ተፊልጶሴ ቀረቦም፥ “ጔታ! የኢየሱስ ወዥ ኧሸነ” ባሮይ።<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />ፊልጶስም ወረም የእድርያስ ኤወደን፤ እንድርያስም ፊልጶስ ቁናዬ ወሮም የኢየሱስ ኤወዶይ። <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ዘ፥ የሰብ ትኸ ይከብርወ ሰዓት ሰላም፤ <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />የኢን፥ የኢን ኧብርሑ፤ ጢንጦ የስሬ ዝሬት በአፈር ወጠቀም ባᎀተ፥ የቢቶሑ ይቀይ፤ በᎀተም ብዠ ፍረየ ያወርድ።<note caller="-" style="x"><char style="xo" closed="false">12፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:3">ማቴ. 10፥3</ref>፤ <ref loc="MAT 16:25">16፥25</ref>፤ <ref loc="MRK 8:35">ማር. 8፥35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፥24</ref>፤ <ref loc="LUK 17:33">17፥33</ref>። </char></note> <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" />ሕይወተሑ ይወድ ያጠፏን፤ በዚ ዓለም ሕይወተሑ ይጠላን የዘለዓለም ሕይወት ይቁየን። <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />ይያም ያገለግሌ ይሸ የትኸተሌ፤ እያ ባነሑወ አገልጋየኛ በዛ ይኸን፤ ያግለግሌዪም አብ ያከቡር።”<verse eid="JHN 12:26" /></para>
  <para style="s1">ኢየሱስም ይሰላወዪ መከራ ሞትም ወዘንጔሑ</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />ቄጠለም ኢየሱስ እኪ ባረ፦ “ዘ! ነብስያኛ ተጨነቀም፤ ምን ንበር? ‘አባኛ! ተዚ ሰዓት አትርፌ ንበር?’ ዚ አንብርኸም እያ የቸኘሑ የዚ የመከራ ሰዓቱ። <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />አባኛ! ሽማኸ አክቡር።”</para>
  <para style="p" vid="JHN 12:28">በዛ አንቌ “ሽመኛ አከበርኩንም፤ ኧሗም አከቡር!” ይብር ጣምባ በሰሜ ቸኘ።<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />በዛ የቈሞ ሰቦች ዚ በሰሞ ግዝየ፥ “እንግቢግቢቱ!” ባሮ። ኧንጐዲ ኧሗም “መላይካው የዝነጔን!” ባሮ።<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />ኢየሱስም እኪ ቲብር ዠበረ፦ “ዚ ጣምባ የቸኘ ያሑ ቲብሩ አንኸንም ይያ ቲብር አንከነ። <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />ዚ ዓለም ይᎈርጅᎄ ግዝየ ኧሗቱ፤ የዚ ዓለም ገዢ ሼጣን ተውጪዬ ያድጒ ኧሗቱ፤ <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />እያም ባፈር ተነኔ ከፍ በባሑ ግዝየ የሰቦቺ እንም ቲያዬ ኧሸቡ።” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />ኢየሱስ ዚ የዝነጔን በምንኸማት ሞት ይᎀትኸም ቲያምለክት ባነ።<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />ሰቦቺም “በሕጊ ተጣፈም ኧረሕብነዪ ‘ክርስቶስ የዘለዓለም ይነብር’ ይብሪው፤ ኧጌ፥ አኸ፥ ‘የሰብ ትኸ ተነኔ ከፍ ወበር ነነወ’ ምንኸም ትብር? ዚሽ የሰብ ተኸ ሟኒ?” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">12፥34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">መዝ. 110፥4</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9፥7</ref>፤ <ref loc="EZK 37:25">ሕዝ. 37፥25</ref>፤ <ref loc="DAN 7:14">ዳን. 7፥14</ref>። </char></note><verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />ኢየሱስ እኪ ባረኖ፦ “ኧሗ የቀል ግዝየ ታሑጌ ብራን ነነ፤ ጨለማ ኔሰላብኩ ብራን ትናነናሑ ተዥባበሮ፤ በጨለማ ይዥባበር ቴቴ ያርኸም ኤይሒር። <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />የብራን ዴንጋ ትኸኖኸም ብራን ትናነናሑ በብራን ኧምኖ።” ኢየሱስ ዚ በዝነጔ አንቌ ወረም ተሸተረቦ።<verse eid="JHN 12:36" /></para>
  <para style="s1">የአይሑድ አለወምን</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />ቄጠለም ኢየሱስ ብዠ ታምር ቢፍተሕኖ ቢሸክትም አይሑድ በሑቲ አነመኖ። <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />ዚም የኸነ ነብዪ ኢሳያስ፤</para>
  <para style="q1" vid="JHN 12:38">“ጔታ! ምስክርነተና ሟ አመነ?</para>
  <para style="q2" vid="JHN 12:38">የጔታሽ ቆት የሟ ተገለጠ?”<note caller="-" style="x"><char style="xo" closed="false">12፥38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">ኢሳ. 53፥1</ref>። </char></note></para>
  <para style="m" vid="JHN 12:38">ቲብር የዝነጔን ቃል ይትፌጠምኸሙ። <verse eid="JHN 12:38" /><verse number="39" style="v" sid="JHN 12:39" />ዠበረም ኢሳያስ እኪ ቲብር አለወምነሕኖ ገለጠ፦<verse eid="JHN 12:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="JHN 12:40" />“ቤነሕኖ አዞም</para>
  <para style="q2" vid="JHN 12:40">በሒነሕኖ አጥራመቶም</para>
  <para style="q2" vid="JHN 12:40">ኤይዠበሮኸም ፈያ ኤይሸክቶኸም</para>
  <para style="q1" vid="JHN 12:40">እዝጌር ዔነሕኖ አጨለᎀንም፤</para>
  <para style="q2" vid="JHN 12:40">ሒነሕኖ አድነደነንም።”<note caller="-" style="x"><char style="xo" closed="false">12፥40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">ኢሳ. 6፥10</ref>። </char></note><verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />ኢሳያስ ዚ የባረ የመሲሕ ክብር ስላዠው፤ ስለኸነም ዚ ስለ ኢየሱስ ዝነጔ።<verse eid="JHN 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42" />ቢኸንም ተአይሑድ አለኦች ብዠሕኖ በኢየሱስ አመኖም፤ ቢኸንም ፈሪሳውያን በምኩራብ ያወጦዮኸም በወገና፥ ቢልቢጢጦ አመስከሮነ። <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />ዚም የሸከቶ በእዝጌር ቲትረከቢ ክብር የጠቀለ ተሰብ ይትረከቢ ክብር የወደዶ ስለኸነው።<verse eid="JHN 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ኢየሱስም ጣምባሑ ከፍ አበኘም እኪ ባረ፦ ቢያ ያምን ቢያ ጠለለ ቴይኸን፥ በላሔዪም ያምን፤ <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />ይያ ያዠ የላዄዪ ያዥ፤ <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />ቢያ ያምን እንም በጨለማ ኤነብርኸም እያ ብራን ኸንኩም ተዓለሜ ቸኘሑም።<verse eid="JHN 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47" />ቃለኛ ሰማም በሜና ᎈር ኤያወሊ ኧፈርድወ እያ አንኸንኩ፤ እያ የቸኘሑ ዓለም የዋትርፉ አንኸንም በዓለም ᎈር የወፍርድ አንከነ። <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />ይያ ኤይሸም ቃለኛ ኤይቌበሪ ሰብ ይፈርድወ ነነ፤ እያ የዝነጔሑኒ ቃል በመጨረሻ ከነ ይፈረድወ። <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />እያ በነብሰኛ ስልጣን አንዘጔሑ፤ እያ ኧቡኒም ኧዝነጊኒ ትዛዝ ያቤ የላዄ አቡ። <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />የሑቲም ትዛዝ የዘለዓለም ሕይወት የኸነኸም ኧሒር። ስለኸነም እያ ኧዝነግ አብ ዬወዴዪው።<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s1">ኢየሱስ የደቀ መዛሙርተሑ ኧግር ወጥበሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />ዘ፥ ግዝየዪ በአይሑድ ፉሲካ በዓል ቢፍቴ ባነ፤ ኢየሱስ ዚ ዓለም ገፈረም ተአቤ ያርወ ሰዓት ወስላሑ ሐረ። በዚ በዓለም ያኖዪ የነብሰሑ ጐሳ ወደደኖም ባነ፤ መጨረሻም ስን ወደደኖ።<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />ኢየሱስም ደቀ መዛሙርተሑ ኧርባት ይበሮ ባነ፤ የስምዖን ትኸ አስቆሮታዊዪ ይሑዳም የኢየሱስ አቼለፈም ይᎅኸም ዳቡሎስ በሒነሑ ቡሼ አሳብ ኸናወ። <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />አብ ስልጣንም እንም ያᎄንኸም በእዝጌር ወጣም የቸኘኸም፥ ተእዝጌሬም ያርኸም ኢየሱስ ይሒር ባነ። <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />ስለኸነም በማዳ ተነሳም ልባሰሑ አወና፤ ይሙሻሽወ ፎጣ ነሣም በጊንዠሑ ታገደ። <verse eid="JHN 13:4" /><verse number="5" style="v" sid="JHN 13:5" />በዛ አንቌ ቢታጠቡᎄ ግብር ኧጋ ኸናም የደቀ መዛሙርተሑ ኧግር ወጥብ ቀረሰ፤ በታጐደኒም ቢሙሻሽወ ፎጣ ኧግረሕኖ ሙሻሸኖ። <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />ኢየሱስ ተስምዖን ጴጥሮሴ በቸኘ ግዝየ ስምዖን ጴጥሮስ፥ “ጔታ! አኸ ይያ ኧግር ታጥብ?” ቧረን። <verse eid="JHN 13:6" /><verse number="7" style="v" sid="JHN 13:7" />ኢየሱስም “እያ ኧሸኩቺ አኸ ኧሗ አትሒን፤ ያንቌም ታጥራሙች” ቧረን። <verse eid="JHN 13:7" /><verse number="8" style="v" sid="JHN 13:8" />ጴጥሮስም “አኸ ይያ ኧግር ስርም አታጥቤ!” ቧረን። ኢየሱስም “እያ ኧግራኸ ባነጠበከኸ ቲያ ኧጣ ኤነናኸ” ቧረን። <verse eid="JHN 13:8" /><verse number="9" style="v" sid="JHN 13:9" />ስምዖን ጴጥሮስም “ጔታ! እኪሽ በኸነ ኧግረኛ ጠለለ ቴይኸን ኧጀኛም፥ ጉነነኛም ኧጥቤ!” ቧረን። <verse eid="JHN 13:9" /><verse number="10" style="v" sid="JHN 13:10" />ኢየሱስም “ገገሑ የታጠበ እንምዐዘረሑ ንጡ በወሕነሑ ኧግረሑ ተወታጠበሑ አንኸንም ኧንጐድ ኤያሸን፤ አሑም ንጡንኩ፤ ቢኸንም እንማሑ አንኸንኩ” ቧረን። <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />ኢየሱስ “እንማሑም ንጡ አንኸንኩ” የባረ አቸለፈም ይᎅ ሟ የኸነኸም ይሒር የነበረ ስለኸነው።<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />ኧግረሕኖ ባጠበ አንቌ ልባሰሑ ለበሰም ተመደረዄ ተዠበረም ቾና፤ እኪም ባረኖ፦ “ምን የሸከተክንኩኸም አጥራመትኩ?<note caller="-" style="x"><char style="xo" closed="false">13፥12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">ሉቃ. 22፥27</ref>። </char></note> <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />አሑ ‘አስተማሪ ጔታም’ ትብሮኝ፤ እያ አስተማሪ ጔታም የኸንኩ ስለኸነ የባሑይ ሱቱ። <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />ኧጌሽ እያ ጔታሑ አስተማሪያሑም ትንኸን ኧግራሑ ባጠበኩሑ አሑም ነብስ በነብሳሑ ኧግራሑ ወታጠብ ይጌባሑ። <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />እያ ያሑ የሸከትኩንኸም አሑም ትሸክቶዬ ምሳሌ አበኩሑም። <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" />የኢን፥ የኢን ኧብርሑ፤ አገልጋይ ተጔታሑ ኤይበዛ፤ መልክተኛም ተላዀኒ ኤይበዛ።<note caller="-" style="x"><char style="xo" closed="false">13፥16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቴ. 10፥24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፥40</ref>፤ <ref loc="JHN 15:20">ዮሐ. 15፥20</ref>። </char></note> <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />ዚ ዘንጋ ብትሒሮም በሜናም ᎈር ብታወሎይ የትባረክሑንኩ። <verse eid="JHN 13:17" /><verse number="18" style="v" sid="JHN 13:18" />ዚ ኧዝነግ ይንማሑ አንከነ፤ እያ የሜጠረኩሑዪ ኧሒር፤ ቢኸንም ‘ቂጣኛ የበና ቢያ ᎈር በመሦነት ተነሣቢ’ ይብሪ የቅዱስ መጽሐፍ ቃል ወፈጥም ነነወ።<note caller="-" style="x"><char style="xo" closed="false">13፥18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>። </char></note> <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />ዚ ተወሕነሑ ኢፍቴ ኧሗ በደርኩም ኢውድሑ፤ በፌጠመ አንቌ፥ ቢያ ሟንነት ታምኖኸሙ። <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" />የኢን፥ የኢን ኧብርሑ፤ እያ እለኲ ይቌበር ይያ ይቌበር፤ ይያም ይቌበር የላሔዪ ይቌበር።”<note caller="-" style="x"><char style="xo" closed="false">13፥20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቴ. 10፥40</ref>፤ <ref loc="MRK 9:37">ማር. 9፥37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፥48</ref>፤ <ref loc="LUK 10:16">10፥16</ref>። </char></note><verse eid="JHN 13:20" /></para>
  <para style="s1">ኢየሱስ አቼለፈም ይᎅ ሟ የኸነኸም በደረም ወዘንጔሑ</para>
  <para style="r">(<ref loc="MAT 26:20-25">ማቴ. 26፥20-25</ref>፤ <ref loc="MRK 14:17-21">ማር. 14፥17-21</ref>፤ <ref loc="LUK 22:21-23">ሉቃ. 22፥21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />ኢየሱስ ዚ በባረ አንቌ በመንፈሰሑ ተጨነቀም “የኢን፥ የኢን ኧብርሑ፤ ታሑ አቲ ይያ አቼለፈም ይቤ” ቲብር ቢልቢጢጦ ዝነጔ።<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />ደቀ መዛሙርተሑ ዚ ስለሟ የዝነጔኸም ባለወሐረሕኖ ነብስ በነብሰሕኖ ተዘዞ። <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />ኢየሱስ ይወጅጅ የነበረዪ፥ ተደቀ መዛሙርተሑ አቲ በኢየሱስ ሜጠቅ ቶናም ባነ። <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />ስምዖን ጴጥሮስ የሑቲ ጠቈሰንም “ስለሟ የዝነጔኸም እንዴ ተሳል” ቧረን።<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />ስለኸነም ሑቲ አንገተሑ ተኢየሱሴ አቀረበም “ጔታ! አቼለፈም ይብከዪ ሟኒ?” ቲብር ተሳለን።<verse eid="JHN 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26" />ኢየሱስም “ሑቲ ዚ ቂጣ በወጥ አጠቀስኩም አቸፉሪው” ባረ። ዚ ባረም ቂጣ በወጥ አጠቀሰም የአስቆሮታዊዪ ስምዖን ትኸ የኸነዪ የይሑዳ አቸᎈረን። <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />ይሑዳ የቸᎈረኒ በቌበረ አንቌ ሒንጌም ሼጣን ቡየወ፤ ኢየሱስም የይሑዳ፥ “የወሰክት ዬሰብኰኒ ከሞ በርም ሰክት!” ቧረን። <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />ኢየሱስ የመአር ዚ የባረኸም በማዳ በቾኖዪ ሟንም የሐረ ኤነ። <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />ይሑዳ ዋጋ ይጠብጥ የነበረ ስለኸነ ተደቀ መዛሙርተሑ አታተሕኖ ኢየሱስ “የበዓሊ ያሸነዪ ሰየም የዜጋ ምጽዋት አብ” የቧረን መሰረኖም ባነ። <verse eid="JHN 13:29" /><verse number="30" style="v" sid="JHN 13:30" />ይሑዳም ይቸፉሪ በቌበረኸም ሒንጌም ወጣም ወረ፤ ግዝየዪም ምሳር ባነ።<verse eid="JHN 13:30" /></para>
  <para style="s1">ገደሪ ትዛዝ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />ይሑዳ ወጣም በወረ አንቌ ኢየሱስ እኪ ባረ፦ “ኧሗ የሰብ ትኸ ከበረም፤ በሑቲም መሳ እዝጌር ከበረም፤ <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />እዝጌር በሑቲ መሳ በከበረ እዝጌርም የሑቲ ያከቡር፤ ቴዬክስም ያከቡር።<verse eid="JHN 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33" />“ዴንጋኛ፥ ታሑጌ ብዠ ግዝየ አኔክስ፤ አሑ ትሸዎኝ፤ የአይሑድ ባለሥልጣኖች ‘እያ ትናርወዬ አሑ ትቸኖዬ አትችሎ’ የባሑኖኸም፥ ኧሗም ያሑ ዛምኸም ኧብርሑ።<note caller="-" style="x"><char style="xo" closed="false">13፥33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">ዮሐ. 7፥34</ref>። </char></note><verse eid="JHN 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34" />“ነብስ በነብሳሑ ትትዋደዶኸም ገደር ትዛዝ ኢብኩ፤ እያ የወደደኩኸም አሑም ነብስ በነብሳሑ ተዋደዶ።<note caller="-" style="x"><char style="xo" closed="false">13፥34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">ዮሐ. 15፥12</ref>፤ <ref loc="JHN 17">17</ref>፤ <ref loc="1JN 3:23">1 ዮሐ. 3፥23</ref>፤ <ref loc="2JN 1:5">2 ዮሐ. 5</ref>። </char></note> <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />ነብስ በነብሳሑ በትዋደድኩ ይያ ደቀ መዛሙርት የኸንኩኸም ሰብ እንም ይሒር።”<verse eid="JHN 13:35" /></para>
  <para style="s1">ጴጥሮስ ይለጓንኸም ኢየሱስ በደረም ወዘንጔሑ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቴ. 26፥31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14፥27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፥31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />በዛ አንቌ ስምዖን ጴጥሮስ የኢየሱስ፥ “ጔታ! ቴቴው ታር?” ቲብር ተሳለን።</para>
  <para style="p" vid="JHN 13:36">ኢየሱስም “እያ ትናርወዬ ኧሗ ትትዄተሌዬ አትችል፤ ባንቌም ትትዄተሌ” ቲብር ዠᎄረነ።<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />ጴጥሮስም “ጔታ! የመአር ኧሗ ኧትዄተልኸዬ አንችል? እያ ሕይወተኛ ያኸ አቸልፍም ይብ” ቧረን።<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />ኢየሱስም “አኸ ሕይወታኸ ይያ አቼለፍከም ቲብ? የኢን፥ የኢን ኧብርኸ፤ ኧኳ ኩተና ቴይኖቅ ኢፍቴ ሦስትጌ ትለጌ” ቲብር ዠበረ።<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s1">ተአቤ ይወስዲ ኤማ ኢየሱስ ወሕነሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />ኧሗም ኢየሱስ እኪ ባረ፦ “ሒናሑ ኤይጨነቅ፤ በእዝጌር ኧምኖ፤ ቢያም እምኖ፤ <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />በአባኛ ቤት ብዠ ይነቡርᎄ ነነ፤ ባንከነም ‘ትነብሮᎄዪ መደር አዝጋጅንኩዬ አር’ ኧብርሑ ባነ። <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />አርም መደር ባዝጋጀክንኩ አንቌ እያ ባነሑወ ትነብሮኸም ዠበርኩም ኧቸኝም ኧወስድሑ። <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />እያ አርወዪም ኤማ ቲሒሮ።”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />ቶማስ “ጔታ! ቴቴ ታርኸም አንሒርነ፤ ኧጌ፥ ኤማዪ ምንኸም ወሐር ኧችልነ?” ቧረን። <verse eid="JHN 14:5" /><verse number="6" style="v" sid="JHN 14:6" />ኢየሱስም እኪ ቲብር ዠᎄረነ፦ “ኤማ የኢንም ሕይወትም እያትንኩ፤ ቢያ ኤማ ባንከነ ሟንም ተአቤ ይቸኝ ኤነ። <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />ይያ ሐርኩኝም ቢኸን አባኛም በሐርኩይ ባነ፤ ተሗ ቀረሰም ቲሒሮይ፤ አዠሑይም።”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />ፊልጶስም “ጔታ! የአብ አተዥነም ያሰላነ” ቧረን።<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />ኢየሱስም እኪ ቲይብር ዠᎄረነ፦ “ፊልጶስ! ዚ ቅጫ እንም ታሑጌ ትንነብር አቲሒሮኝ? ይያ ያዠ የአብ አዠ፤ ኧጌ፥ አኸ ‘የአብ አተዠነ’ ምንኸም ትብር? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />እያ በአብ ያነሑኸም፥ አብም ቢያ ያነኸም አታምን? ያሑ ኧዝነጊኒ ቃል ኧዝነግ በነብሰኛ ስልጣን አንከነ፤ ቢኸንም ሜናዪ እንም ይሸኩች፥ ቢያ ይነብር አቡ። <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />እያ በአብ ያነሑኸም፥ አብም ቢያ ያነኸም ኧምኖ፤ ባንከነም በሜናኛ መሳ ኧምኖኝ። <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />የኢን፥ የኢን ኧብርሑ፥ ቢያ ያምን እያ ኧሸኩቺ ሜና ይሸክት፤ ተዚም የበዛ ይሸክት፤ እያ ተአቤ አር። <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />አብ በወልድ መሳ ይከብርኸም በሽመኛ ትጮቅሶዪ እንም ኧሸክትንኩ። <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />ሟንመሑ ዘንጋ በሽመኛ ብትጮቅሶ እያ ኧሸኩች።”<verse eid="JHN 14:14" /></para>
  <para style="s1">ኢየሱስ ስለመንፈስ ቅዱስ ያᎄን ተስፋ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />“ትወዶኝ በኸነ ትዛዘኛ ቀሮ፤ <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />እያ የአብ ኧጮቁሽ፤ ሑቲም የዘለዓለም ታሑጌ ይነብር ኧንጐድ አጥናኝ ይብኩ። <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />ዚም የኢን መንፈሱ፤ ዓለም ኤያዥን ስለኸነም ኤይሒን ስለኸነ ይቌᎄሬ ኤይችል፤ አሑም፥ ሑቲ ታሑጌ ስለኸነም በውስጣሑም ስላነ ቲሒሮይ።<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />“አባ ተዳኮ ዬነኖ ዴንጋኸም የቢቶአሑ አንገፍሩሑ፤ ተዠበርኩም ታሑዬ ኧቸኝ። <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />ተቀል ግዝየ አንቌ ዓለም ኤያዤ፤ አሑም ታዞኝ፤ እያ ሕያው ስለኸንኩ አሑም በሕይወት ትነብሮ፤ <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />እያ በአብ ያነሑኸም፥ አሑም ቢያ ያነሑኸም፥ እያም ባሑ ያነሑኸም በዛ ከነ ቲሒሮ።<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />“ይያ ይወዴ ትዛዘኛ ይቌበርም በሜና ᎈር ያወሊው፤ ይያም ይወዴ አባኛ ይወጅጅ፤ እያም ኧወጅጅ፤ ነብሰኛም ኧጐልጥነ።”<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />አስቆሮታዊዪ ቴይኸን ኧንጐዲ ይሑዳ፥ “ጔታ! ነብሳኸ የዓለም ቴይኸን ይና ትገልጥንነ ምንኸሙ?” ቧረን።<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />ኢየሱስም እኪ ቲብር ዠᎄረነ፦ “ይወዴዪ ቃለኛ ይቂየ፤ አባኛም ይወጅጅ፤ ኢና ተሑቲዬ ቸኘነም ተሑቲጌ ቁናዬ ኧነብርነ። <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />ኤይወዴዪ ቃለኛ ኤይቅየ፤ ዚ ትሰሞዪ ቃል የላሔ የአቡ አንከንም ይያ አንከነ።<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />“ኧሗ ታሑጌ ትናነሑ ዚ ዘንጋ ኤወደኩሑም፤ <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />አብ ቢያ ሽም ይለዂ ያብረታዪ መንፈስ ቅዱስም እንም ቃር ያትመርኩ፤ እያ ዬወደኩሑዪ እንም ታስታውሶኸም ይሸክትኩ።<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />“ሰላም ኧገፍርንኩ፤ ሰላመኛም ኢብኩ፤ እያ ኢብኩ ሰላም ዓለም ይብኩኸማት አንከነ፤ ሒናሑ ኤይጨነቅ፤ ኧሗም ኤይጔና። <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />‘እያ አር፤ ተዠበርኩም ታሑዬ ኧቸኝ’ የባሑኸም ሰማሑም፤ አባኛ ቲያ ይበዛ ስለኸነ ብትወዶኝሽ ተአቤ በወወረኛ በትብላለቅኩ ባነ። <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />ዚ ቢኸንወ ግዝየ ታምኖኸም፥ ተወሕነሑ ኢፍቴ በደርኩም ኤወደኩሑም። <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />የዚ ዓለም ገዢ ሼጣን ወተኘሑ ስለኸነ ተሗ ቀረሰም ታሑጌ ብዠ አንዝነግ። ሑቲ ቢያ ᎈር አትም ቆት ኤነን፤ <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />ቢኸንም እያ የአብ ኧወጅጅኸም ዓለም ይሒሬ አብ ዬዘዜዪ እንም ዘንጋ ኧᎊጥሙ፤ ተንሦ በዚ ንወርነ።”<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s1">ኢየሱስ የኢን የወይን ግንዱ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />“የኢን የወይን ግንድ እያትንኩ፤ አታሕልተኛዪም አባኛው፤ <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />ቢያ ᎈር ያነዪ ፍርየ ኤያወርዲ ጫፍ እንም አባኛ አረጠም ያድጉ፤ ፍርየ ያወርዲ ጫፍ ፈያኸም ያወርድኸም አረጠም ያቅሟሙጭ። <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />አሑም ቤወደኩሑ ቃል ኧሗ ንጡንኩ። <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />ቢያ ንበሮ፤ እያም ባሑ ኧነብር፤ ጫፊ በወይን ግንድ ᎈር ቆመረም ባነበረ በነብሰሑ ጠለለ ፍርየ ዋውርድ ኤይችልኸም አሑም ቢያ ባትነብሮ ፍርየ ዋውርድ አትችሎ።<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />“እያ የወይን ግንድንኩ፤ አሑም ጫፍንኩ፤ ብዠ ፍርየ ያወርዲ ቢያ ይነብሪም እያም በሑቲ ኧነብርወው፤ ቢኸንም ፍርየ ያወርዲ ቢያ ይነብሪ እያም በሑቲ ኧነብርወዪው፤ ቢኸንም ያለ እያ አትም ወሰክት አትችሎ። <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />ቢያ ኤይነብር የጫፍኸም ተወረጀዬ አደጒም ይጠርቅ። እኪ ያኖዪ ጫፎች ተስበሰቦም ተሳቴ ያድጒዮም ይነዶ። <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />ቢያ ብትነብሮ ቃለኛም ባሑ ቢነብር የሸሑዪ ብትጮቅሶ ትረሕቦ። <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />ብዠ ፍርየ ትታወርዶ በዚ አባኛ ይከብር፤ አሑም ይያ ደቀ መዛሙርት ወሕናሑ ታቴዞ።<verse eid="JHN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9" />“አብ ይያ የወደዴኸም እያም ያሑ ወደደኩሑ፤ ስለኸነም በፍቅረኛ ንበሮ። <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />እያ የአባኛ ትዛዝ የᎊጠምኩንኸም በፍቅረሑ ኧነብርኸም አሑም ይያ ትዛዝ ብትፌጥሞ በፍቅረኛ ትነብሮ። <verse eid="JHN 15:10" /><verse number="11" style="v" sid="JHN 15:11" />ዚ ዬወደኩሑ ብልቃተኛ ባሑ ይኸንኸም ያሑም ብልቃት ፍጡም ይኸንኸሙ። <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" />ይያ ትዛዝ እያ የወደደኩኸም አሑም ነብስ በነብሳሑ ትዋደዶኸሙ።<note caller="-" style="x"><char style="xo" closed="false">15፥12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሐ. 13፥34</ref>፤ <ref loc="JHN 15:17">15፥17</ref>፤ <ref loc="1JN 3:23">1 ዮሐ. 3፥23</ref>፤ <ref loc="2JN 1:5">2 ዮሐ. 5</ref>። </char></note> <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />ሰብ ሕይወተሑ የደቦቸሑ አቼለፈም ተዋብ የበዛ ፍቅር ኤነን። <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />አሑም እያ ኤዝዝኩዪ ብትፌጥሞ ደቦኛንኩ። <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />አገልጋይ ጌቶቸሑ ይሸኩቺ ኤይሒር ስለኸነ፤ ተሗ ቀረሰም ጉዙዎች አንብርኩ፤ ቢኸንም ተአባኛ የሰማሑኒ እንም የገለጥኩኖ ስለኸነ ደቦኛ ባኩሑም፤ <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />እያ ሜጠረኩሑ አንኸንም አሑ አመጠርኩኝ፤ ወርኩም ብዠ ፍርየ ታወርዶኸም፥ ፍርያሑም ይነብሬ ሾመኩሑም። ስለኸነም በሽመኛ ትጮቅሶዪ እንም አብ ይብኩ። <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />በይሽ እያ ኤዝዝኩዪ ነብስ በነብሳሑ ትትዋደዶኸሙ።<verse eid="JHN 15:17" /></para>
  <para style="s1">ዓለም የደቀ መዛሙርተሑ ወጥላሑ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />“ዓለም ቢጠላሑ ታሑ ኢፍቴ ይያ የጠሌኸም ሐሮ። <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />የዓለም ብትኸኖ ዓለም የነብሰሑ የኸኖዪ በወደደ ባነ፤ ቢኸንም የዓለም ያኸንኩ ስለኸነ እያ ተዓለም ላኘሑም የሜጠረኩሑ ስለኸነ፥ ዓለም ይጠላሑ። <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" />‘አገልጋይ ተጌቶቸሑ ኤይበዛ’ ባሑም ዬወደኩሑዪ አስታውሶ፤ ይያም ባሳደዶኝ ያሑም ያሳድዶኩ፤ ቃለኛ በቅሮ ቃላሑም ይቅሮ።<note caller="-" style="x"><char style="xo" closed="false">15፥20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቴ. 10፥24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፥40</ref>፤ <ref loc="JHN 13:16">ዮሐ. 13፥16</ref>። </char></note> <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />የላሔዪ ኤይሒሮ ስለኸነ ቢያ መሳ ዚ እንም ይሸክቶቡኩ። <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />እያ ቸኘሑም ባኒውዶ አጢያት ባከነቦም ባነ፤ ኧሗም የአጢያተሕኖ መሳ ኤነኖ። <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />ይያ ይጠላ አባኛም ይጠላ፤ <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />ኧንጐድ ሰብ ያንሰኰተን ሜና በግብተሕኖ ባንሸክት አጢያት ባንከነቦ ባነ፤ ኧሗ ዚ እንም ባዞ አንቌ ይያ የአባኛም ጠሎም። <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />ዚም የኸነ፥ ‘ያለ መሳ ጠሎኝ’ ቧሪም በሕገሕኖ የጣፈዪ ቃል ትፌጥምኸሙ።<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />“ቢኸንም በአብ ይወጣዪም እያም በአቤ ኧለሕንኩዪ ያጥናናዪ የኢን መንፈስ ቲቸኝ ሑቲ ስለእያ ይምሰክር። <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />አሑም ተመጀመሪያ ቀረሰም ቲያጌ የነበርኩ ስለኸነ ትምሰክሮ ትኸኖ።<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />“ዚ እንም ዬወደኩሑ እምነታሑ ኔትናወጥ ባሑሙ። <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />በምኩራብ አወጦም ይሰዶኩ፤ ዛምኸም ያሑም ይቀጥሮኩ እንም የእዝጌር ያግለግል ይመስርወ ግዝየ ይቸኝ። <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />ዚም ይሸክቶይ የአብ ወይ ይያ ያንካሮ ስለኸነው። <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />ዚም ያሑ ወዘንጔኛ ግዝየሑ ቲሰላ ምን የባኩሑኸም ታስታውሶኸሙ።</para>
  <para style="s1" vid="JHN 16:4">የመንፈስ ቅዱስ ሜና</para>
  <para style="p" vid="JHN 16:4">“ዚ እንም ተሗ ኢፍቴ ያኔወደኩሑ ታሑጌ የነበርኩ ስለኸነው፤ <verse eid="JHN 16:4" /><verse number="5" style="v" sid="JHN 16:5" />ኧሗም ተላሔዬ ወወረኛው፤ ቢኸንም ታሑ ‘ቴቴ ታር?’ ባረም ይሰሌ ኤነ። <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />ዚ በወዘንጔኛ ሒናሑ ባዘን ተመላም። <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />እያም የኢን፥ የኢን ኧብርሑ፥ ይያ ኤማ ያሑ ይጠቅሙሑ፤ እያ ባንወርኩ ያጥናናዪ ታሑዬ ኤይቸኝ፤ እያ በወርኩም የመንፈስ ቅዱስ ኧለሕንኩ። <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />መንፈስ ቅዱስ በቸኘ ግዝየ ስለአጢያት፥ ስለጽድቅ ስለፍርድም መሳ የዓለም ሰቦች ይወቅሶ። <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />ስለአጢያት ይወቅሲ ቢያ ያነመኖዬው፤ <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />ስለጽድቅ ተአቤ አር ስለኸነም ተሗ ቀረሰም አታዞኝ ስለኸነው፤ <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />ስለፍርድ፥ የዚ ዓለም ገዢ የᎈረጅᎄ ስለኸነው።<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />“ኧሗም ኢውድሑ ብዠ ቃር ነኔ፤ ቢኸንም ኧሗ ይረዝኩ፤ <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />የኢን መንፈስ በቸኘ ግዝየ ተኢኔ እንም ይመራሑ። ሑቲ ይዝነግኒ የሰሟኒ አንኸንም የነብሰሑ ያንከነ ስለኸነ ሑቲ ቲፍቴ ይኸኖዪ ዘንጋ ይውድሑ። <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />ይያ በኸነዪ ወሰደም ይውድሑ ስለኸነ ይያ ያከብሬ። <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />የአብ የኸነዪ እንም ይያቱ፤ ‘ይያ በኸነዪ ወሰደም ይውድሑ’ የባኩሑ የዚቱ።<verse eid="JHN 16:15" /></para>
  <para style="s1">አዘናሑ ተብልቃቴ ወሰገረሑ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />“ተቀል ግዝየ አንቌ አታዞኝ፤ ዠበረም ተቀል ግዝየ አንቌ ታዞኝ።”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />ተደቀ መዛሙርተሑ አታተሕኖ፥ “ዚ፥ ‘ተቀል ግዝየ አንቌ አታዞኝ፤ ኧሗም ተቀል ግዝየ አንቌ ታዞኝ፤ ኧሗም ተአቤ አር’ ይብርነ ቃር መአሩ?” ተበበሮ። <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />“ኧጌሽ ዚ ‘ተቀል ግዝየ አንቌ’ ይቡኒ ቃር መአሩ? ይዝነግኒ ዘንጋ አንሒርነ” በወትበበር ዥባበሮም ተሰሰሎ።<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />ኢየሱስም ይሰሎዬ የሸዎይኸም ሐረም እኪ ባረኖ፦ “ነብስ በነብሳሑ ትሰሰሎ፥ ‘ተቀል ግዝየ አንቌ አታዞኝ፤ ኧሗም ተቀል ግዝየ አንቌ ታዞኝ’ የባኩሑዬው? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />የኢን፥ የኢን ኧብርሑ፤ አሑ ትበሖ፤ ው ትብሮ፤ ዓለምም ይትብላለቅ፤ አሑ ታዝኖ፤ ቢኸንም አዘናሑ ተብልቃቴ ይሸገር። <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />ምሽት ብትጨኝወ ግዝየ የመጤታ ከነ የሰላ ስለኸነ ታዝን፤ በጨኘች አንቌም በዓለም ᎈር ሰብዬ የጨኘ ስለኸነ ተወትብላለቌታ የትነሣ ጭንቀቴታን አታስታውሽ። <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />ዛምኸም አሑ ኧሗ ታዝኖ፤ ቢኸንም እያ ዠበርኩም አዥኩ፤ ሒናሑም ይትብላለቅ፤ ብልቃታሑም ይወስድብኩ ኤነ።<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />“በዛ ከነ ቢያ አትም ቃር አትጮቅሶ፤ የኢን፥ የኢን ኧብርሑ አብ በሽመኛ ብትጮቅሶይ እንም ቃር ይብኩ። <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />ኧሗ ስን በሽመኛ አትም ቃር አንጮቀስኩ፤ ጮቅሶ ይቡኩ፤ ብልቃታሑም ፍጡም ይኸን።<verse eid="JHN 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />“ኧሗ ስን በምሳሌ ኤወደኩሑ፤ ተሗ ቀረሰም በምሳሌ አንዝነግወ ግዝየ ይቸኝ፤ ቢኸንም ስለአብ እንም ዘንጋ ቢልቢጢጦ ኢውድሑ። <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />በዛ ከነ በሽመኛ ትጮቅሶ፤ እያም ‘የአብ ኧጮቅስንኩ’ አንብርኩ። <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />አብ ነብሰሑ ይወድሑ ስለኸነው፤ አብም ይወድሑ ይያ የወደድኩኝ ስለኸነም በእዝጌሬ የቸኘሑኸም ያመንኩዬው። <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />በአቤ ወጣሑም፥ ተዓለሜ ቸኘሑም፤ ዠበርኩም ዚ ዓለም ገፈርኩም፥ ተአቤ አር።”<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />ደቀ መዛሙርተሑም እኪ ባሮ፤ “ዘ! ኧሗ በምሳሌ ቴይኸን ቢልቢጢጦ ዝነጔኸ፤ <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />አኸ እንም ቲሒርኸም ሟንም ጥያኤ ያቀርብንከዬ ኤያትኬሽኸም ኧሗ ሐርነ፤ ስለኸነም በእዝጌሬ የቸኘኸኸም አምንነ።”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />ኢየሱስ እኪ ቲብር ዠበረኖ፦ “ኧሗሽ አመንኩ? <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />የሕን አንኸንም እያታታሑ የቢቶአሑ ትብራጦᎄዪም ይያ የቢቶኛ ትገፍሮᎄ ሰዓት ይቸኝ፤ ሰዓተሑ ኧሗ ሰላም፤ ቢኸንም አብ ቲያጌ ስለኸነ የቢቶኛ አንኸንኩ። <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />ዚ ያሑ ወዘንጔኛ ቢያ ኸንኩም ሰላም ይነብሩሑኸም ባሑሙ፤ በዓለም ትናነሑ መከራ ነነብኩ፤ ቢኸንም አይዞአሑ፥ እያ የዓለም ቌመሑንም።”<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s1">የኢየሱስ ጠሎት</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />ኢየሱስ ዚ በዝነጔ አንቌ ቀና ባረም ተሰሜዬ ቲያዥ እኪ ባረ፦ አባ ዘ፥ ሰዓቲ ሰላም፤ ትኻኸ ያከብርኸኸም የትኻኸ አክቡር፤ <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />ታከቡሪም ያቡኰኒ እንም የዘለዓለም ሕይወት ይብኸም በሰቦች እንም ᎈር ስልጣን ያቡኰን ስለኸነው። <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />የዘለዓለም ሕይወትም አኸ ጠለለ የኢን አምላክ የላዀኒም ኢየሱስ ክርስቶስም ወሐሩ። <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />እያ የአብኬዪ ሜና ፈጀሑም ባፈር ᎈር አከበርከኸም። <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />አባ! ዓለም ተወትኸለቀሑ ኢፍቴ ታኸጌ በነበሬ ክብር ኧሗም ባኸዬ አክብሬ።<verse eid="JHN 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />በዓለም ውስጥ ሜጠርከም የአብኬዪ ሰቦች ያኸም ሟንነት ገለጥኩኖም፤ ሕኖም ያኸ ባኖ፤ አኸ ሕኖ ይያ አብኬም፤ ሕኖም ቃላኸ ቅሮም፤ <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />የአብኬዪ እንም ባኸ የኸነኸም ሕኖም ኧሗ ሐሮ። <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />ያብኬዪ ቃል አብኩኖም፤ ሕኖም ተቄበሮይም፤ ባኸዬ ቸኘሑም ወተኘኛም የኢንም ሐሮም፤ አኸ የላክሔኸም አመኖም።<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />እያ ኧጤልል የሕኖቱ፤ ነዚ የአብኬዪ ያኸ ስለሕኖ የሕኖ ኧጤልይ፤ የዓለም አንጤልይ። <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ይያ የኸነዪ እንም ያኸቱ፤ ያኸ የኸነዪ ይያቱ፤ እያም በሕኖ ኧከብር። <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />እያ ተሗ ቀረስኩም በዓለም ᎈር አንነብር፤ ሕኖም በዓለምኖ። እያ ታኸዬ ወተኘኛው፤ ቅዱስ አባ፥ ነዚ ያብኬዪ ይናኸም ቁና ይኸኖኸም ይያ ባብኬ በሽማኸ ቀየኖ።<note caller="+" style="f"><char style="fr" closed="false">17፥11-12 </char><char style="fqa" closed="false">ይያ ባብኬዪ በሽማኸ ቀየኖ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “ይያ ያብኬዪም እንም በሽማኸ ቀየኖ። ይብሮ” </char></note> <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" />እያ ተሕኖጌ ባነሑወ ግዝየ ባብኬ ሽማኸ ቂየሕኖም፤ እያ ቂየሕኖም፤ ስለኸነም የቅዱስ መጽሐፍ ቃል ይትፌጠምኸም በዛ ተጥፋት ትኸ አንኸንም ስርም ተሕኖ ሟንም አንጠፋ።<note caller="-" style="x"><char style="xo" closed="false">17፥12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>፤ <ref loc="JHN 13:18">ዮሐ. 13፥18</ref>። </char></note><verse eid="JHN 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 17:13" />ኧሗ እያ ታኸዬ ወተኘኛው፤ በዓለም ᎈር ትናነሑ ዚ ኧዝነጊኒ ብልቃተኛ በሕኖዬ ፍጡም ይኸንኸሙ። <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />እያ ቃላኸ አብኩኖም፤ እያ በዓለም ያንከንኩኸም ሕኖም በዓለም አንከኖ፤ ስለኸነ ዓለም ጠላኖ። <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />ተቡሼ ትቂየኖኸም አንኸንም ተዓለም ታወጣኖኸም አንጮቅስ። <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />እያ በዓለም ያንከንኩኸም ሕኖም በዓለም አንከኖ። <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />በኢናኸ ቀድሶ፤ ቃላኸ የኢኑ። <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />አኸ ይያ ተዓለሜ የላዄኸም እያም የሕኖ ተዓለሜ ላክሕኖ። <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />ሕኖ የኢን ቅዱስ ይኸኖኸም እያ ነብሰኛ ስለሕኖ ቄደስኩም።<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />በሕኖ ቃል መሳ ቢያ ያመኖዪም ስለኸነ ኧጮቅስከ አንኸንም የሕኖ ጠለለ አንጮቅስ። <verse eid="JHN 17:20" /><verse number="21" style="v" sid="JHN 17:21" />እያም ኧጮቁሺ እንም ቁና ይኸኖኸሙ፤ ዛምኸም አባ! አኸ ቢያ ያነኸኸም፥ እያም ባኸ ያነኹኸም፥ ሕኖም ቢና ይነብሮኸሙ፤ አኸ የላዄኸም ዓለም ያምንኸሙ። <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />ኢና ቁና የኸነኸም ሕኖም ቁና ይኸኖኸም ይያ ያብኬዪ ክብር አብኩኖም። <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />እያ ኧጮቁሺ እያ በሕኖ አኸም ቢያ የኸንከኸም ሕኖም ስርም ቁና ይኸኖኸሙ፤ ዛምኸም ይያ የላኬኸምም ይያ በወደድኬ ቅጫ የሕኖም የወደድከኖኸም ዓለም ይሒርኸሙ። <verse eid="JHN 17:23" /><verse number="24" style="v" sid="JHN 17:24" />“አባ! ዓለም ቴይትኸለቅ የወደድኬ ስለኸነ ያብኬዪ ክብረኛ ያዞኸም ነዚ አኸ ያብኬዪም እያ ባነሑወ ቲያጌ ይነብሮኸም ኧወድ።<verse eid="JHN 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 17:25" />“ጻድቅ አባ! ዓለም አንካረናኸ፤ እያ ኧሒርከ፤ ነዚ አኸ የላዄኸም ሐሮም። <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />አኸ ይያ የወደድከወ ፍቅር በሕኖ ᎈር ይኸንኸም እያም በሕኖ ኧኸንኸም ሕኖ ያኸ ይሒሮኸም ሸከትኩም፤ ኧሗም ይሒሮኸም ኧሸክቶ።”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s1">የኢየሱስ ቢቃወሞዪ ወጠበጠሑ</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቴ. 26፥47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14፥43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፥47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />ኢየሱስ ዚ በባረ አንቌ ተደቀ መዛሙርተሑጌ ተቄድሮን ሸለቆ ዛዘሬ ወረ፤ በዛ ተነበረወ የአታሕልት መደሬ ተደቀ መዛሙርተሑጌ ገቦ።<verse eid="JHN 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2" />ኢየሱስም ደቀ መዛሙርተሑ በዛ መደር እንጌ ይስበሰቦ የነበረ ስለኸነ አቼለፈም ያᎄን ይሑዳ ዛ መደር ይሒን ባነ። <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />ስለኸነም ይሑዳ አት የወታደሮች ጋዥ፥ ዛምኸም ተካሕናት አለኦች ተፈሪሳውያንም የትላሖዪ የዘብ አላፊዎች አትዄተለም ተዛ መደሬ ቸኘ፤ ሕኖም ፋኖስ ችቦም የአርብ መሣሪያም ጠበጦም ባነ።<verse eid="JHN 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4" />ኢየሱስም ይሰላወዪ እንም ሐረም ተሕኖዬ ወጣ ባረም “የሟ ትሸዎ?” ባረኖ። <verse eid="JHN 18:4" /><verse number="5" style="v" sid="JHN 18:5" />ሕኖም “የናዝሬቲ ኢየሱስ ኧሸነ” ባሮይ። ሑቲም “እያትንኩ” ባረኖ። አቼለፈም ያᎄኒ ይሑዳም ተሕኖጌ ቈመም ባነ። <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />ኢየሱስ “እያትንኩ” በባረኖ ግዝየ ታንቌዬ ሰኮም ባፈር ᎈር ወጠቆ። <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />ኢየሱስም “የሟ ትሸዎ?” ቲብር ዠበረም ተሳለኖ። ሕኖም “የናዝሬቲ ኢየሱስ ኧሸነ” ባሮ። <verse eid="JHN 18:7" /><verse number="8" style="v" sid="JHN 18:8" />ኢየሱስም ዠበረም፤ “ሑቲ እያትንኩ” ባኩሑም ባነ፤ ኢያም ትሸዎኝ በኸነ፤ ነዚሕኖ፤ የወሮ ግፍሮዮ ባረ፤ <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />ዚም የኸነዪ፥ “አባ፥ ታብኬዪ ሰቦች ቁናሚ አናጥፋሑ” የቧረኒ ቃል ይትፌጠምኸሙ።<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />ስምዖን ጴጥሮስ ሰይፍ ጠበጠም የነበረ ስለኸነ ሻበም የካሕናት አለአዪ አገልጋይ ወካም ከነ እዝነሑ ቅᎀጠለን፤ የአገልጋዪም ሽም “ማልኮስ” ይቡሪ ባነ። <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" />ኢየሱስም የጴጥሮስ፥ “ሰይፋኸ ተሰገባዬ ሑራን፤ አብ ያቤዪ የመከራ ጥወ አንሰጭን ይመስረኸ?” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">18፥11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">ማቴ. 26፥39</ref>፤ <ref loc="MRK 14:36">ማር. 14፥36</ref>፤ <ref loc="LUK 22:42">ሉቃ. 22፥42</ref>። </char></note><verse eid="JHN 18:11" /></para>
  <para style="s1">የኢየሱስ ተካሕናት አለአዬ ወወሰደሑ</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />በዛ አንቌ ወታደሮቸሑም ዬዝዞዪ፥ የአይሑድ የዘብ አላፊዎቺም የኢየሱስ ጠበጦም አገዶይ። <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />በደሮም ተሐናዬ ወሰዶይ፤ ሐናም በዛ ዓመት የካሕናት አለአ የነበረዪ የቀያፋ አማኴሑ ባነ። <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" />ቀያፋ “አት ሰብ የሕዝቢ ቢᎀት የጠቀለው” ቲብር የአይሑድ ባለሥልጣኖች የመከረው።<note caller="-" style="x"><char style="xo" closed="false">18፥14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">ዮሐ. 11፥49-50</ref>። </char></note><verse eid="JHN 18:14" /></para>
  <para style="s1">ጴጥሮስ የኢየሱስ ወልጋሑ</para>
  <para style="r">(<ref loc="MAT 26:69-70">ማቴ. 26፥69-70</ref>፤ <ref loc="MRK 14:66-68">ማር. 14፥66-68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ. 22፥55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />ስምዖን ጴጥሮስም ኧንጐዲ ደቀ መዝሙር የኢየሱስ ተዄተሎይ፤ ዛ ኧንጐዲ ደቀ መዝሙር በካሕናት አለአዬ የትኴረ ባነ፤ ስለኸነም ተኢየሱስጌ ተካሕናት አለአዪ ግቢዬ ገባ። <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />ጴጥሮስም በወረጀ በበሪ ᎀረ ቈመም ባነ፤ በካሕናት አለአዪ የትኴረ ደቀ መዝሙር ቸኘም ወዝገብ ትቅየዪ አፍቶ ዝነጔም የጴጥሮስ ጠᎄጠንም ገባ። <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />ወዝገብ ትቅየዪም አፍቶ የጴጥሮስ “አኸም ተዚ ሰብ ደቀ መዛሙርት አቲ አንኸንከ?” ባረቹ።</para>
  <para style="p" vid="JHN 18:17">“ሑቲም አንኸንኩ” ባረ።<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />ግዝየዪ ገሊ ስለኸነ አገልጋዮቸሑ የዘብ አላፊዪ የከሰል ኧሳት አነደዶም ቈሞም ይᎀቆ ባነ፤ ጴጥሮስም ተሕኖጌ ቈመም ይᎀቅ ባነ።<verse eid="JHN 18:18" /></para>
  <para style="s1">ተካሕናት አለአዪ የኢየሱስ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቴ. 26፥59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14፥55-64</ref>፤ <ref loc="LUK 22:66-71">ሉቃ. 22፥66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />በዛ ግዝየ የካሕናት አለአዪ የኢየሱስ ስለደቀ መዛሙርተሑ ስለትምርተሑም ተሳለን። <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />ኢየሱስም እኪ ቲብር ዠᎄረነ፤ “እያ የሰብ እንም ቢልቢጢጦ ዝነጔሑ፤ አይሑድ እንም ቢስበሰቦᎄ በምኩራብም ኸነ በቤተ መቅደስ እንጌ አትመርኩ፤ በሽሙቸ የዝነጔሑን አትም ዘንጋ ኤነ፤ <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />ኧጌ፥ የመአር ይያ ትሰሌ? ትንዝነግኖ የሰሞኚ ተሳሎ፤ የዝነጔሑኒ ሕኖ ይሒሮ።”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />ኢየሱስ ዚ በዝነጔ ግዝየ በዛ ቈሞም ተነበሮዪ ተዘብ አላፊዪ አቲ፥ “የካሕናት አለአዪ ትዠቡሪ እኪቱ?” ባረም የኢየሱስ በትፊ ተፏን።<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />ኢየሱስም “ቡሼ ቃል ዝነጔሑም በኸነ ቡሼ ወዘንጔኛ መስክር፤ የዝነጔሑን ሱት በኸነ የመአር ትወኬ?” ቧረን።<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />በዛ አንቌ ሐናም፥ ኢየሱስ ያጐጂኸም ተካሕናት አለአዪ ተቀያፋዬ ላዀን።<verse eid="JHN 18:24" /></para>
  <para style="s1">ጴጥሮስ ዠበረም የኢየሱስ ወልጋሑ</para>
  <para style="r">(<ref loc="MAT 26:71-75">ማቴ. 26፥71-75</ref>፤ <ref loc="MRK 14:69-72">ማር. 14፥69-72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ. 22፥58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />በዛ ግዝየ ስምዖን ጴጥሮስ ቈመም ኧሳት ይᎀቅ ባነ፤ ኧንጐዲ ሰቦችም “አኸሽ ተኢየሱስ ደቀ መዛሙርት አቲ አንኸንከ?” ባሮይ። ሑቲም “አንኸንኩ” ባረም ለጋ።<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />ጴጥሮስ ኧንዝነሑ ያረጠኒ ሰብ ዘመደሑ የኸነ የካሕናት አለአዪ ተጉዙዎቺ አቲ “ባታሕልቲ መደር ተሕኖጌ አዠከኸም አነበረ?” ቧረን።<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />ጴጥሮስም ዠበረም ለጋ፤ ሒንጌም ኩተና ኖቀ።<verse eid="JHN 18:27" /></para>
  <para style="s1">የኢየሱስ ተጲላጦሴ ወወሰደሑ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቴ. 27፥1-2</ref>፣<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15፥1-5</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፥1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />በዛ አንቌ የኢየሱስ በቀያፋ ቤት ገኝ ገዢዪ ግቢዬ ወሰዶይ፤ ግዝየዪም ቅረር ሱቢ ባነ፤ የአይሑድ የፋሲካ በዓል ያርጂዪ ኧጤ ወብራ የነበረቦ ስለኸነ ኤረክሶኸም ተገኝ ገዢዪ ግቢዬ ውስጥ አንገቦ። <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />ስለኸነም ጲላጦስ ተሕኖዬ ወጣም “በዚ ሰብ ᎈር ያቀረብኩይ ክስ መአሩ?” ቲብር ተሳለኖ።<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />ሕኖም “ዚ ሰብ ቡሼ ይሸክት ቤይኸን ያኸ አቼለፍነም ባናብኔይ ባነ” ቲብሮ ዠበሮነ።<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />ጲላጦስም “አሑ ነብሳሑ ውስዶም የሕጋሑኸም ፍርዶᎄ” ባረኖ።</para>
  <para style="p" vid="JHN 18:31">አይሑድም “ኢና ሰብ የወቅጥር አንተፈቀደንነ” ባሮይ። <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" />ዚም የኸነ ኢየሱስ በምንኸማት ሞት ይᎀትኸም የዝነጔኒ ቃል ይትፌጠምኸሙ።<note caller="-" style="x"><char style="xo" closed="false">18፥32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">ዮሐ. 3፥14</ref>፤ <ref loc="JHN 12:32">12፥32</ref>። </char></note><verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />ጲላጦስ ተግቢየውታኔ ተዠበረም ገባ፤ የኢየሱስም ጠራም “አኸ የአይሑድ ንጉሥንከ?” ቲብር ተሳለን።<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />ኢየሱስ “አኸ ዚ ትቡኒ ተራሳኸው? ወይሽ ኧንጐደሕኖ ዚ ስለእያ ኤወዶከም?” ቧረን።<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />ጲላጦስም “እያ አይሑዳዊንኩ? አኸ ይያ አቸለፎም ያቦከ ጐሳሐም የካሕናት አለኦችኖ፤ መአሩ የሸኰትኰን?” ቧረን። <verse eid="JHN 18:35" /><verse number="36" style="v" sid="JHN 18:36" />ኢየሱስ “ይያ መንግሥት በዚ ዓለም አንከነ፤ መንግሥተኛ በዚ ዓለም ቢኸን በአይሑድ ባለሥልጣን ኧጅ አንወጥቅኸም ጉዙዎቸኛ በትዋጎኒ ባነ፤ መንግሥተኛም በዚ ዓለም አንከነ” ቲብር ዠበረ። <verse eid="JHN 18:36" /><verse number="37" style="v" sid="JHN 18:37" />ጲላጦስም “ኧጌ፥ አኸ ንጉሥንከ ወበሩያ?” ቧረን። ኢየሱስም “እያ ንጉሥ የኸንኩኸም አኸ ትብር፤ እያ የጨኘሑም ተዓለሜ የቸኘሑ የኢን ኧምሰክሬው፤ በኢን የኸነ እንም ቃለኛ ይሰማ” ቲብር ዠበረ።<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />ጲላጦስም “የኢን መአሩ?” ባረም ተሳለ። በዛ አንቌ ጲላጦስ ዠበረም ተአይሑዴ ወጣም እኪ ባረኖ፦ “እያ አትም ጥፋት አረኸብኩወ፤ <verse eid="JHN 18:38" /><verse number="39" style="v" sid="JHN 18:39" />ቢኸንም የሮሸሑይኸም በፉሲካ በዓል ከነ እንጌ አት ኧጉጀኘ ኧፈታንኩ፤ ስለኸነም የአይሑድም ንጉሥ ኧፈታንኩኸም ትሸዎ?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />ሕኖም “በርባንም ፍታንነ አንኸንም ሑቲ አንከነ!” ቲብሮ ው ባሮ። በርባንም ሽፍታ ባነ።<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s1">ኢየሱስ ይሰቀርኸም ተፈረደወ</para>
  <para style="r">(<ref loc="MAT 27:27-32">ማቴ. 27፥27-32</ref>፤ <ref loc="MRK 15:15-21">ማር. 15፥15-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />በዛ አንቌ ጲላጦስ የኢየሱስ ወሰደም አትጌረᎈን። <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />ወታደሮቺም የሶክ አክሊል አረሶም በኢየሱስ ጉነን ᎈር አወኖ፤ ብሻ ልባስ አለበሶይ። <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />ተሑቲዬ ቸኖም በዋፊዝ “የአይሑድ ንጉሥ! ሰላም ያኸ የሕን!” ይብሮይ ባነ፤ በትፊ ይተፎይ ባነ።<verse eid="JHN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />ጲላጦስ ዠበረም ተወረጀዬ ወጣም “ዘ አትም በደል አረኸብኩወኸም ቲሒሮዬ የሑቲ ተወረጀዬ አወጣንኩ” ባረኖ፤ <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />ስለኸነም ኢየሱስ የሶክ አክሊል አወናም ብሻ ልባስ ለበሰም ተወረጀዬ ወጣ፤ ጲላጦስም “ዘ፥ ምሲ!” ባረኖ።<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />የካሕናት አለኦች የዘብ አላፊዎችም የኢየሱስ ባዞይ ግዝየ “ስቁር! ስቁር!” ቲብሮ ው ባሮ።</para>
  <para style="p" vid="JHN 19:6">ጲላጦስም “እያ በፎለኛ አትም በደል አረኸብኩወ፤ ብትሸዎ አሑ ውስዶም ስቅሮይ” ባረኖ።<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />አይሑድም “ኢና ሕጊ ነነነ፤ ዚ ሰብ ነብሰሑ የእዝጌር ትኸ የሸከተ ስለኸነ በሕገና መሠረት ወሙት ይጌቧን” ባሮ።<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />ዚ እንም ዘንጋ በሰማ ግዝየ ጲላጦስ ስርም ጔና፤ <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />ተግቢዬ ገባም የኢየሱስ “አኸ ቤቴንከ?” ቲብር ተሳለን። ኢየሱስ አትም አንዘᎄረነ። <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />ስለኸነም ጲላጦስ “አቲውዴ? እያ ኧፈታኸዬም ኧሰቅረኸዬ ስልጣን ያኔኸም አትሒር?” ቧረን፤<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />ኢየሱስም “በእዝጌር ስልጣን ቤይቡከ ቢያ ᎈር አትም ሥልጣን ባነበረናኸ ባነ፤ ቢኸንም ያኸ አቼለፈም ያቤ የባሰ አጢያት ነነወ” ቧረን።<verse eid="JHN 19:11" /></para>
  <para style="s1">በኢየሱስ ᎈር የሞት ፍርድ ወፈረደሑ</para>
  <para style="r">(<ref loc="MAT 27:15-31">ማቴ. 27፥15-31</ref>፤ <ref loc="MRK 15:6-20">ማር. 15፥6-20</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፥13-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />በዛ አንቌ ጲላጦስ የኢየሱስ ይᎈታኔ ሸ፤ አይሑድም “ዚ ሰብ ብትᎈታን የቄሣር ደቦ አንኸንከ፤ የነብሰሑ ንጉሥ ይሸክት የቄሣር ተቃዋሚው” በወበር ውታሕኖ ቄጠሎ።<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />ጲላጦስ ዚ በሰማ ግዝየ የኢየሱስ ተወረጀዬ አወጣም “ጠፍጣፋ እምን” በቧሪዪ መደር በፍርድ ወንበር ᎈር ቾና፤ ዚ መደር በዕብራይስጥ ቋንቋ “ገበታ” ይቡሪ። <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />የፉሲካ በዓል የዝግጅት ከነ ባነ፤ ግዝየዪ ስድስት ሰዓት ቅጫ ባነ፤ በዛ ግዝየ ጲላጦስ የአይሑድ “ዘ ንጉሣሑ!” ባረኖ። <verse eid="JHN 19:14" /><verse number="15" style="v" sid="JHN 19:15" />ሕኖም “ቁጥር! ቁጥር! ስቁር!” ቲብሮ ው ባሮ። ጲላጦስም “ንጉሣሑ ንስቁር?” ባረኖ።</para>
  <para style="p" vid="JHN 19:15">የካሕናቲ አለአዎችም፤ “ተቄሣር ኧንጐድ ንጉሥ ኤነነ!” ባሮም ዠበሮነ።<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />በዛ ግዝየ ኢየሱስ ይሰቀርኸም ጲላጦስ አቼለፈም አበኖ፤ ሕኖም የኢየሱስ ጠበጦም ወሰዶይ።<verse eid="JHN 19:16" /></para>
  <para style="s1">የኢየሱስ ወሰቀር</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቴ. 27፥32-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15፥21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፥26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />በዛ አንቌ ኢየሱስ መስቀለሑ ጮረም፥ “የራስ ቅል” ቲቡሪ መደሬ ወጣ፤ ዚ መደር በዕብራይስጥ ቋንቋ ጎልጎታ ይቡሪ። <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />በዛ ሰቀሮይ፤ የኢየሱስ በግብት ኸኖም፥ ተሑቲጌ ኧንጐድ ዄት ሰቦች በጉራም በከነ ሰቀሮዮ።<verse eid="JHN 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19" />ጲላጦስ “የናዝሬቲ ኢየሱስ፥ የአይሑድ ንጉሥ” ይብር ጡሑፍ ጣፈም በመስቀሊ በጉነነሑ ᎈር አወናን። <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />ኢየሱስ የሰቀረወ መደር የከተማ ቁርቤ የነበረ ስለኸነ፥ በአይሑድ ብዠሕኖ ጡሑፊ አነበቦይ፤ ጡሑፊም የጣፈ በዕብራይስጥ፥ በላቲን በግሪክም ቋንቋ ባነ። <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />የአይሑድ የካሕናት አለኦች የጲላጦስ፥ “አኸ ‘የአይሑድ ንጉሥ’ ባኸም አትጣፍ፤ ቢኸንም ‘ዚ ሰብ እያ የአይሑድ ንጉሥንኩ’ ባረም በርም ጣፍ” ባሮይ።<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />ጲላጦስም “የጣፍኩኒ ጣፍኩም” ቲብር ዠበረ።<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />ወታደሮቺ የኢየሱስ በሰቀሮይ አንቌ፥ ልባሰሑ ወሰዶም፥ አትባተሕኖ ወታደር አት ክፍል ይሰላኸም አርበቴ ሳዶዮ፤ ኧጀ ጠባቢም ዛምኸም ሸከቶ፤ ቢኸንም ኧጀ ጠባቢም ቴይሴᎉ በነኔ ተቴ ስን ቁናኸማት ኸነም የሸከተ ባነ። <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />ስለኸነም ወታደሮቺ “የሟ ይሰላንኸም የወሐር ኧጣ ንድግነᎄ አንኸንም አንግድድኔ” ተበበሮ። ዚም የኸነዪ፥</para>
  <para style="q1" vid="JHN 19:24">“ልባሰኛ ተሰሰዶይ፤</para>
  <para style="q2" vid="JHN 19:24">በጀ ጠባበኛም ኧጣ አደጎ”</para>
  <para style="m" vid="JHN 19:24">ይብሪ የቅዱስ መጽሐፍ ቃል ይትፌጠምኸሙ፤ ወታደሮቺም ዛምኸም ሸከቶ።<note caller="-" style="x"><char style="xo" closed="false">19፥24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>። </char></note><verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />በኢየሱስ መስቀል ሜጠቅ ዳኰችም የዳኰች ኧተም፤ ዛምኸም የቀልዮጳም ምሽት ማርያም መግደላዊት ማርያምም ቈመማም ባነ። <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />ኢየሱስ ዳኰችም ይወጅጂ ደቀ መዝሙር በሜጠቀሑ ቈሞም ባዠኖ ግዝየ፥ የዳኰች “ዳኮኛ! ዘ፥ ትኻሽ!” ባረና።<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />በዛ አንቌ ደቀ መዝሙሪ “ዝሚያ ዳኳኸ!” ቧረን፤ በዛ ሰዓት ቀረሰም ደቀ መዝሙሪ ተቤተዄ ወሰደና።<verse eid="JHN 19:27" /></para>
  <para style="s1">የኢየሱስ ሞት</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቴ. 27፥45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15፥33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፥44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />በዛ አንቌ ኢየሱስ ኧሗ እንም ዘንጋ የፌጠመኸም ሐረም በቅዱስ መጽሐፍ የጣፈዪ ቃል ይትፌጠምኸም “ጠሜም!” ባረ።<note caller="-" style="x"><char style="xo" closed="false">19፥28 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>፤ <ref loc="PSA 22:15">22፥15</ref>። </char></note> <verse eid="JHN 19:28" /><verse number="29" style="v" sid="JHN 19:29" />በዛዬ ሖምጣጤ የᎀላወ ግብር ቾናም ባነ፤ ስለኸነም በዛ የነበሮዪ ሰቦች፥ ሖምጣጤዪ ሰፍነግ ᎀሎም በሒሶጵ ኧጨ አንጥለጠሎም ታፈውታዬ አቀረቦነ፤<note caller="+" style="f"><char style="fr" closed="false">19፥29 </char><char style="fqa" closed="false">ሰፍነግ፦ </char><char style="ft" closed="false">የኳስ ኸም ክብ ኸነም በባር ውስጥ ይበቅል ቡቃያ፥ እንምዐዘረሑ፥ ኧጋ ይመጥ የባር እንሰሳ፥ መልካማ ይመስር። </char><char style="fqa" closed="false">ሒሶጵ፦ </char><char style="ft" closed="false">ቊጥቋጦ ይመስር አታሕልት ብምን ᎈር ይበቅል። </char></note> <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />ኢየሱስም ሖምጣጤዪ በቀመሰ አንቌ “ተፌጠመ!” ባረ።</para>
  <para style="p" vid="JHN 19:30">ጉነነውታንም ሙግ አበኘም ነብሰሑ አበ።<verse eid="JHN 19:30" /></para>
  <para style="s1">የኢየሱስ ሜጠቅ በቀለጥ ወትወጋሑ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />ተዛ አንቌ የአይሑድ ባለሥልጣን የሰቀሮዪ ሰቦች ሰረባ ሰበሮም፥ ሬሳሕኖ በመስቀል ያወርዶዮኸም የጲላጦስ ጮቀሶይ፤ ዚም የሸከቶᎄ መሳ የሰምበት ይዝጋጅወ ከነ የነበረ ስለኸነም ዛ ሰምበትም ወደል በዓል ስለኸነ፥ በሰምበት ከነ በሰረሕኖ በመስቀል ᎈር ኤኸንኸም ባነ። <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />ስለኸነም ወታዶሮቸሑ ወሮም፥ ተኢየሱስጌ የሰቀሮዪ ሰቦች ሰረባ ሰበሮ፤ <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />ኢየሱስ በወሮ ግዝየም፥ ሑቲ በደረም የᎀተኸም አዞም፥ ሰረባሑ አንሰበሮይ። <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />ቢኸንም ተወታደሮቸሑ አቲ፥ ሜጠቀሑ በቀለጥ ወጓን፤ ሒንጌም ተሜጠቀሑ ደም ኧጋም ወጣ። <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />ዚ ያዠ፥ አሑ ታምኖኸም ምሰከረ፤ ምስክርነተሑ የኢንሙ፤ ይዝነጊኒም የኢን የኸነኸም፥ ሑቲ ይሒር። <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />ዚም የኸነዪ “ተሑቲ አትም አጥም ኤይሰበር” ይብሪ የቅዱስ መጽሐፍ ቃል ይትፌጠምኸሙ።<note caller="+" style="f"><char style="fr" closed="false">19፥36 </char><char style="xt" closed="false"><ref loc="NUM 9:12">ዘሑ. 9፥12</ref>፤ <ref loc="PSA 34:20">መዝ. 34፥20</ref>፤ <ref loc="ZEC 12:10">ዘካ. 12፥10</ref>፤ <ref loc="REV 1:7">መና 1፥7</ref>። </char></note> <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" />ኧሗም በእንጐዲ የቅዱስ መጽሐፍ ክፍል “ዛ የወጎዪ ያዞይ” ይብር።<verse eid="JHN 19:37" /></para>
  <para style="s1">የኢየሱስ ወቀበር</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቴ. 27፥57-61</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />የአይሑድ ባለሥልጣን በወገና በሽሙቸ የኢየሱስ ደቀ መዝሙር የነበረዪ የአርማትያስ ዮሴፍ የኢየሱስ ሬሳ የወውስድ የጲላጦስ ጮቀሰ። ጲላጦስም ፈቈደነ። ስለኸነም ዮሴፍ ወረም ሬሳዪ ወሰደ። <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" />በዚ ኢፍቴ በምሳር ተኢየሱሴ ወረም የነበረዪ ኒቆዲሞስም አት መቶ ነጥር<note caller="+" style="f"><char style="fr" closed="false">19፥39 </char><char style="fqa" closed="false">ነጥር፦ </char><char style="ft" closed="false">450 ግራም ይኸን ክብደት ነነን። </char></note><note caller="-" style="x"><char style="xo" closed="false">19፥39 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ዮሐ. 3፥1-2</ref>። </char></note> ቅጫ የከርቤ የሬትም የድባለቀ ጠበጠም ቸኘ። <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />ዄቲም ሰብ የኢየሱስ ሬሳ ወሰዶም የአይሑድ የኬᎈኒ ሴራኸም ተሽቶጌ በተልባ ኧግር በሸኰቺ ልባስ ኬፈኖይ። <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />ኢየሱስ ተሰቀረም በነበረወ መደር አት የአታሕልት መደር ባነ፤ በዛም የአታሕልት መደር ውስጥ ሟንም ያንትቀበረወ ገደር ቀብር ባነ። <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />ከነዪ የአይሑድ የሰምበት ዝግጅት ከነ የነበረ ስለኸነ የኢየሱስ ሬሳ በዛ ቀበሮይ።<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s1">የኢየሱስ ተሞት ወተንሳ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቴ. 28፥1-8</ref>፤ <ref loc="MRK 16:1-8">ማር. 16፥1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፥1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />ውርሰምበት ቅረር በገት፥ ገና ጬት ቴይወጣ መግደላዊት ማርያም ተኢየሱስ ቀብሬ ወረች፤ ዛሜ በሰላችኸም ቀብሪ ታጨወም የነበረዪ እምን በቀብሪ በር ᎈር ተነሳም አዠች። <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />ስለኸነም ሒቲ ተስምዖን ጴጥሮስም ኢየሱስ ቲወጅጂዬ ትንጐዲ ደቀ መዝሙር ትትሮጥ ወረችም “ጔታ በቀብሪ አወጦም ወሰዶይም፤ ቤቴ ያወኖይኸም አንሒርነ” ባረቶ።<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />በዛ ግዝየ ጴጥሮስ ኧንጐዲ ደቀ መዝሙርም ወጦም ተቀብሪዬ ወሮ። <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />ዄቲም ቁናዬ ይሮጦ ባነ፤ ቢኸንም ኧንጐዲ ደቀ መዝሙር ተጴጥሮስ ይበዛ አቴከለም ሮጠም በደረም ተቀብሪዬ ሰላ። <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />ሙግ ባረም ተቀብሪዬ ቲትምሌከት የከፈኒ ጨርቅ በዛ ቶናም አዠ፤ ቢኸንም ተውስጤ አንቡየ። <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ስምዖን ጴጥሮስም ተዄተለንም ቸኘም ተቀብሪዬ ውስጥ ቡየ፤ ሑቲም የከፈኒ ጨርቅ በዛ ቶናም አዠ። <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />የኢየሱስ ጉነን ተጥመጠመም የነበረወ ጨርቅ ተከፈኒ ጨርቅጌ ቴይኸን የቢቶሑ ብንጐድ መደር ተጥበለለም የቾናኸም አዠ። <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ቄጠለም ዛ በደረም የሰላዪ ደቀ መዝሙር ተቀብሪ ውስጤ ቡየም አዠም አመነ። <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />“በሞት ወተንሳ ይጌቧን” ይቡኒ የቅዱስ መጽሐፊ ቃል ገና አንትረዶ ባነ። <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />በዛ አንቌ ዄቲም ደቀ መዝሙር ተዠበሮም ተቤተ ሕኖዬ ወሮ።<verse eid="JHN 20:10" /></para>
  <para style="s1">ኢየሱስ የመግደላዊቲ ማርያም መገለጥ</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቴ. 28፥9-10</ref>፤ <ref loc="MRK 16:9-11">ማር. 16፥9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />መግደላዊቲ ማርያም ትትበሕ፥ በቀብሪ ተውጪዬ ቈመችም ባነ፤ ትትበሕም ሙግ ባረችም ተቀብሪ ውስጤ ተምሌከተች። <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />የኢየሱስ ሬሳም በነበረወ መደር ነጨ ልባስ የለበሶ ዄት መላይካ አቲ በጉነኔ አቲ በተቴ ቾኖም አዠች። <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />ሕኖም የማርያም፥ “ምሽቶ! የመአር ትቤሕ?” ባሮያ።</para>
  <para style="p" vid="JHN 20:13">ሒቲም “ጔታኛ ወሰዶይም፤ ቤቴ ያወኖይኸም አንሒር” ባረች።<verse eid="JHN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14" />ዚም ባረችም ታንቌዬታዬ ዞር ትትብር የኢየሱስ ቈመም አዠቹ፤ ኢየሱስ ወሕነሑም አንካረች። <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />ኢየሱስ፥ “ምሽቶ! የመአር ትበሕ፤ ሟሽ ትሸ?” ባረና።</para>
  <para style="p" vid="JHN 20:15">ሒቲም አታሕልተኛዪ መሰረናም “ጔታ! አኸ ወሰድኰንም በኸነ ቤቴ ያወናዀንኸም ታውሽ አውዴ፤ እያ ኧወስጅ” ባረቹ።<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />ኢየሱስም “ማርያም!” ባረና። ሒቲም ተሑቲዬ ዞር ባረችም በዕብራይስጥ ቋንቋ “ረቡኒ!” ባረቹ፤ ትርጉመሑም “አስተማሪ!” ወበሩ።<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />ኢየሱስም፤ “ገና ተአባኛዬ ዐናረግሑ ስለኸነ፤ አትልግጅኝ፤ ይልቀሑሽ ተጐባቢተኛዬ ዌርም፤ ‘እያ ተአባኛዬ ተአባሑዬም፥ ተአምላከኛዬ ተአምላካሑዬም ዐርግ’ ባረም ቤም አውጅዮ” ባረና።<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />ስለኸነም መግደላዊት ማርያም ተደቀ መዛሙርተዄ ወረችም የጔታም ያዠችኸም ሑቲም ምን የባረናኸም ኤወደቶ።<verse eid="JHN 20:18" /></para>
  <para style="s1">ኢየሱስ የደቀ መዛሙርተሑ መገለጥ</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቴ. 28፥16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16፥14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፥36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />በዛም በሳምቲ በመጀመሪያዪ ከነ ውርሰምበት ምሸት ደቀ መዛሙርተሑ የአይሑድ ባለሥልጣን በወገና፥ ወዝገብ አጮም በቤት ውስጥ ተስበሰቦም ባነ። ወዝገቢ ታጨም ትናነ ኢየሱስ ደቀ መዛሙርተሑ ተስበሰቦᎄ ቤቴ ገባ፤ በግብተሕኖም ቈመም፥ “ሰላም ያሑ የሕን!” ባረኖ። <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />ዚም ባረም ኧጀሑ ሜጠቀሑም አቴዠኖ፤ ደቀ መዛሙርተሑም የጔታ ባዞይ ግዝየ ተብላለቆ።<verse eid="JHN 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21" />በዛ አንቌ ኢየሱስ ዠበረም “ሰላም ያሑ የሕን! አብ ይያ የላዄኸም እያም ያኹ ኧለሑ” ባረኖ። <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />ዚ ባረም እፍ ባረቦም “መንፈስ ቅዱስ ተቌበሮ፤ <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" />አኹ የሰብ አጢያት አፉ ብትብሮ አፉ ይቡርንኩ፤ አኹ የሰብ አጢያት አፉ ባትብሮ፥ አፉ ኤይቡርንኩ” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">20፥23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቴ. 16፥19</ref>፤ <ref loc="MAT 18:18">18፥18</ref>። </char></note><verse eid="JHN 20:23" /></para>
  <para style="s1">ኢየሱስም ቶማስ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />ኢየሱስ ተደቀ መዛርተዄ በቸኘ ግዝየ ተዐሥረ ዄቲ አቲ፥ ዲዲሞስ የቧሪዪ ቶማስ ተሕኖጌ አነበረ። <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />ስለኸነም ኧንጐዲ ደቀ መዛሙርት የቶማስ “ጔታ አዠኔም” ባሮይ። ሑቲም “በውስማር የትወጎዪ ኧጀሑ ባነዠሑ አጤበተኛ በውስማር በትወጋዪ ውስጥ ባንኸራሑ ኧጀኛም በሜጠቀሑ መዛ ባንኸራሑ አናምን” ባረኖ።<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />ተስሙት ከነ አንቌ ደቀ መዛሙርተሑ ዠበሮም በቤት ውስጥ ባኖ፤ ቶማስም ተሕኖጌ ባነ፤ ወዝገቢ ታጨም ትናነ ኢየሱስ ቸኘም በግብተሕኖ ቈመም “ሰላም ያሑ የሕን!” ባረኖ። <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />በዛ አንቌ የቶማስ፤ “አጤበታኸ ተዚዬ አተኝም ኧጀኛ ኧዥ፤ ኧጃኸም አተኝም በሜጠቀኛ ውስጥ ሑራን፤ ኧምን አንኸንም እምነት ዬነንኸም አትሕን” ቧረን።<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />ቶማስም “ጔታኛ! አምላከኛም!” ቲብር ዠᎄረነ።<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />ኢየሱስም የቶማስ፥ “አኸሽ ያዠዄዬ አመንኸም፤ ቴያዞኝ ያምኖዪ የትምሰገኖኖ” ቧረን።<verse eid="JHN 20:29" /></para>
  <para style="s1">የዚ መጽሐፍት ዓላማሑ</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />ኢየሱስ በዚ መጽሐፍት ያንትጣፈ ብዠ ታምር በደቀ መዛሙርተሑ ኢፍት ሸከተም፤ <verse eid="JHN 20:30" /><verse number="31" style="v" sid="JHN 20:31" />ቢኸንም ኢየሱስ ክርስቶስ የእዝጌር ትኸ ወሕነሑ ታምኖኸም፥ አመንኩም በሑቲ ሽም የዘለዓለም ሕይወት ትረሕቦኸም ዚ ተጣፈም።<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s1">ኢየሱስ የሰበቲ ደቀ መዝሙር መገለጠሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />በዛ አንቌ ኢየሱስ በጥብርያዶስ ባር ᎀረ፥ የደቀ መዛሙርተሑ ዠበረም ተገለጠ፤ የትገለጠዪም ቄጠለም ያነዪው፤ <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />ስምዖን ጴጥሮስ፥ ዲዲሞስ የቧሪዪ ቶማስ፤ የቃና ዘገሊላዪ ናትናኤል የዘብዴዎስ ዴንጋም ኧንጐዲ ዄት ደቀ መዝሙር ቁናዬ ባኖ። <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" />ስምዖን ጴጥሮስ “ዓሣ የዋስግር ወወረኛው” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">ሉቃ. 5፥5</ref>። </char></note></para>
  <para style="p" vid="JHN 21:3">ሕኖም “ታኸጌ አርነ” ባሮይ፤ ወጦም ተጀልባዬ ቡሮ፤ ቢኸንም በዛ ምሳር አትም ዓሣ አንጠበጦ። <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />ቲዛኝ ኢየሱስ በባሪ ᎀረ ቈመ፤ ደቀ መዛሙርተሑም ኢየሱስ ወሕነሑ አንካሮ። <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />ኢየሱስም “ዴንጋ! ምናሕር ዓሣ ነነናሑ?” ባረኖ።</para>
  <para style="p" vid="JHN 21:5">ሕኖም “አትም ኤነነ” ባሮይ።<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />ሑቲም “መረቢ በጀልባዪ በከነ አዘሬ ኧድጎም ትረሕቦ” ባረኖ። ስለኸነም መረቢ በባሪ ውስጥ አደጎይ፤ ብዠ ዓሣም ተወጥብጠሕኖ የትነሳ መረቢ ወሻብ ቌመኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">ሉቃ. 5፥6</ref>። </char></note><verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />በዛ ግዝየ ኢየሱስ ይወጅጂ ደቀ መዝሙር የጴጥሮስ “ጔታው እኮ!” ቧረን። ስምዖን ጴጥሮስ “ጔታው” ወበረሑ በሰማ ግዝየ የሜና ባረም ልባሰሑ አወለቀም የነበረ ስለኸነ ሒንጌም ልባሰሑ ለበሰም ተባሬ ዘለለም ቡየ። <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />ኧንጐድ ደቀ መዛሙርትም ተአፈር የራቆ መቶ ሜትር ቅጫ ጠለለ የነበረ ስለኸነ ዓሣ የᎀላወዪ መረብ ሻቦም በጀልባ ቸኖ። <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />በጀልባዪ በወረዶ ግዝየ ዓሣ በᎈረሑ የነበረወዪ የከሰል ፌምም ቂጣ አዞ። <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />ኢየሱስም “ኧሗ ባሰገርኩዪ ዓሣ ናሞ” ባረኖ።<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />ስለኸነም ስምዖን ጴጥሮስ ተጀልባዬ ቡየም መቶ አምሣ ሦስት ግድድር ዓሣ የᎀሎᎄዪ መረብ ታፈሬ ሻበ፤ ዚ ቅጫ ብዠ ዓሣ ቢጠብጥም መረቢ አንትገደደ። <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />በዛ አንቌ ኢየሱስ፦ “ኔሑ ብሮ” ባረኖ። ጔታ ኢየሱስ ወሕነሑ እንም ሐሮም የነበረ ስለኸነ፥ ተደቀ መዛሙርተሑ አትም፥ “አኸ ሟንከ?” ባረም ይሰሌ የደፈረ አነበረ። <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />በዛም ኢየሱስ ቸኘም፤ ቂጣዪ ዓሣዪም ነሣም አበኖ።<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />ኢየሱስ በሞት በትነሳ አንቌ ደቀ መዛሙርተሑ ቲያዞይ ዚ ሦስታለኘ ግዝየ ባነ።<verse eid="JHN 21:14" /></para>
  <para style="s1">ኢየሱስ የጴጥሮስ ያቀረᎄነ ጥያኤ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />አደረ በበኖ አንቌ ኢየሱስ የስምዖን ጴጥሮስ፥ “የዮና ትኸ ስምዖን! ነዚ ቲወዶኚ የጠቀለ ትወዴ?” ቧረን። ሑቲም “ኤክ፥ ጔታኛ! እያ ኧወድኸኸም አኸ ቲሒር” ቲብር ዠᎄረነ። <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />ኢየሱስም “ግላግለኛ አብራ” ቧረን። ዄታለኘ ግዝየም “የዮና ትኸ ስምዖን! ትወዴ?” ቧረን። ሑቲም “ኤክ፥ ጔታኛ! ኧወድኸኸም አኸ ቲሒር” ቧረን። ኢየሱስም “ጠᎄተኛ ቀየ” ቧረን። <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />የሦስታለኘ ግዝየ “የዮና ትኸ ስምዖን! ትወዴ?” ቧረን። የሦሥታለኘ ግዝየ “ትወዴ?” የቧረን ስለኸነ ጴጥሮስ አዘነም “ጔታ! አኸ እንመሑ ቲሒር፥ እያ ኧወድኸኸም ቲሒር” ቧረን። ኢየሱስም እኪ ቧረን፦ “ኧጤኛ ዋሎ፤ <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />የኢን፥ የኢን ኧብርኸ፤ አኸ አርዴ ትናነኸ ጥብጣባኸ በፎላኸ ኧጅ ታገድኸም ተሸዀን መደሬ ታር ባነ፤ በገረዝከ ግዝየም አኸ ኧጃኸ ትዝረጓንም ኧንጐድ ሰብ ያታግድከ፤ ታትሸን መደሬ ይወስድኸ።” <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />ዚም የቧረን ጴጥሮስ በምንኸማት ሞት እዝጌር ዋክብር ያነወኸም ቲያምለክቱ፤ በዛ አንቌ የጴጥሮስ “ተዄተሌ” ቧረን።<verse eid="JHN 21:19" /></para>
  <para style="s1">ኢየሱስ እንጐዲ ደቀ መዝሙርም</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />ጴጥሮስ ዞር ባረም ኢየሱስ ይወጅጂ ደቀ መዝሙር ቲትዄተል አዠ፤ ዚ ደቀ መዝሙር በርባት ግዝየ ተኢየሱሴ ተጤጋም፥ “ጔታ፥ አቸለፈም ይብከ ሟኒ?” ባረም የሳለኒው። <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />ጴጥሮስም የሑቲ አዠንም “ጔታ! ዚሽ ሰብ ምን ይኸን?” ቲብር የኢየሱስ ተሳለን።<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />ኢየሱስም “እያ ኧቸኝ ስን ይነብርኸም ብንፈቅድ አኸ ምን አገባናኸ? አኸ ተኸተሌ!” ቧረን።<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />በዚ መሳ በጐባቢት ግብት፥ “ዚ ደቀ መዝሙር ኤይᎀት” ይብር ኦጀ ተሴማ፤ ቢኸንም ኢየሱስ፥ “እያ ኧቸኝ ስን ይነብርኸም አንፈቅድ አኸ ምን አገባናኸ” ባረ አንከንም፥ “ኤይᎀት” አንባረ። <verse eid="JHN 21:23" /><verse number="24" style="v" sid="JHN 21:24" />ስለዚ ዘንጋ እንም የምሰከረ ነዚ ዘንጋ የጣፈ ዚ ደቀ መዝሙሩ፤ የሑቲም ምስክርነት የኢን የኸነኸም ኧሒርነ።<verse eid="JHN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />ኢየሱስ የሸከተኖ ኧንጐድ ብዠ ዘንጋ ነኖ። እያ ይመስሬኸም ሑቲ የሸከተኖ ቃር እንም አትባት ቢጠᎉ፥ ይጠፎዪ መጽሐፍት ዓለም ነብሰሑ ወጦር ባንቻለ ባነ።<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>