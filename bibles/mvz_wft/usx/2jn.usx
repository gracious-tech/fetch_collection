<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">Mesqan New Testament BIBLE 2 JOHN</book>
  <para style="h">2 የዮሐንስ</para>
  <para style="toc1">ዄታለኘዪ የሐዋርያዪ የዮሐንስ መልክት</para>
  <para style="toc2">2 የዮሐንስ</para>
  <para style="toc3">2 ዮሐ.</para>
  <para style="mt">ዄታለኘዪ የሐዋርያዪ የዮሐንስ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ዄታለኘዪ የዮሐንስ መልክት የጣፈ በባሊቂ በሐዋርያዪ በዮሐንስ ቲኸን የጣፈዪ የትሜጠረቺ እመቤት የዴንጋዬታንሙ። ምናልባትም ያት አጥቢያ ቤተ ክርስቲያን የአባሎቼታንም ቴይኸን ኤይቀይ፤ ዚ አጭር መልክት የጣፈዪ ነፍስ በነብሰሕኖ ይትዋደዶኸም የዋተስብ ተባጢለተኞችም አስተማሪዎች ተትምርተሕኖም የዋትቀየው።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">በደረም <char style="ior"><ref loc="2JN 1:1-3">1-3</ref> </char></para>
  <para style="io1">ፍቅር ትንም ነኑ <char style="ior"><ref loc="2JN 1:4-6">4-6</ref> </char></para>
  <para style="io1">ስለባጢለተኘ ትምርት ያጥኔቁቁᎄ<char style="ior"><ref loc="2JN 1:7-11">7-11</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="2JN 1:12-13">12-13</ref> </char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />የትሜጠረቺ እመቤት የዴንጋዬታንም፤<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="fqa" closed="false">እመቤት ዴንጋዬታም፦ </char><char style="ft" closed="false">ቤተ ክርስቲያን አባሎቼታን ያምለክት። (በቁ. 4ም 5 ᎈር ይትረከብ)። </char></note></para>
  <para style="p" vid="2JN 1:1">ቲያ ተባሊኢ የትላከ መልክት፤ እያ ተኢን ኧወድሑ፤ እያ ጠለለ ታንኸን የኢኒ ይሒሮዪ እንም ይወዶኩ፤ <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />ዚም ሐቅ በግብተና ያነ ቲፍቴዬ የዘላለም ቲናጌ ይነብሪው፤<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />ተእዝጌር አብም የአብ ትኸ ተኸነዪ ተኢየሱስ ክርስቶስ ጸጋ ምረትም ሰላም በኢን በፍቅርም ቲናጌ የኽን።<verse eid="2JN 1:3" /></para>
  <para style="s1">ስለኢን ስለፍቅርም</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />ተዴንጋሽ አታቶቺ ተአብ ባቡነ ትዛዝ መሠረት በኢን ጠኖም ቲያሮ በወርክበኛ ስርም ተብላለቅኩም። <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />ኧሗም እመቤተኛ፤ ተመጀመሪያ የነበረቺ አንከንም ገደር ትዛዝ አንጠፍሽ፤ ዛምኸም ነብስ በነብሰና ንትዋደድነኸሙ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሐ. 13፥34</ref>፤ <ref loc="JHN 15:12">15፥12</ref>፤ <ref loc="JHN 17">17</ref>። </char></note> <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />ዚም ፍቅር፤ በትዛዘሑ መሠረት ኧዥባበርነዬው። ትዛዚም ተመጀመሪያ የሰማሑይኸም በፍቅር ትነብሮኸሙ።<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />ኢየሱስ ክርስቶስ በሰብ ኸነም በበሠር የቸኘኸም ኤያምኖ ብዠ ያሰሰቶ በዓለም ተነሦም። እኪ ያነዪ ሟንም ሰብ ያብላልጥ የክርስቶስም ተቃዋሚው። <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />አሑም ሙላ የቌጥኩᎄ ጄዛ አትቀብጦኸም፤ ቢኸንም ሙላ ሽልማት ትቌበሮኸም የነብሳሑ ተቀሮ።<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />በክርስቶስ ትምርት ኤነብር ተትምርተሑም ይወጣ እንም አምላክ ኤነን፤ በክርስቶስ ትምርት ይነብር አብም ወልድም ነነን። <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />ሟንም ታሑዬ ቢቸኝ፤ ዚም ትምርት ቤያቸኝ በቤታሑ አትቀበሮይ፤ ሰላም አትበሮይ፤ <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />ሰላምታም ይᎅ ሰብ የቡሼ ሜናሑ ተባባሪ ይኸን።<verse eid="2JN 1:11" /></para>
  <para style="s1">የመጨረሻዪ ሰላምታ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />ኧጠፍንኩዬ ኧሸ ብዠ ቃር ባኔ፤ የሕን አንኸንም በወረቀት በቀለምም ይኸንከም አንሸ፤ ቢኸንም ብልቃተና ፍጡም ይኸኔ ታሑዬ ቸኘሑም ቃል በቃል አዝናጊሑዬ ተስፋ ኧሸክት።<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />የትሜጠረቺ የተማሽ ዴጋ ሰላምታ ያቀርቦንች።<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>