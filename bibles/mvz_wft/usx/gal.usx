<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">Mesqan New Testament</book>
  <para style="h">ተገላትያ ሰቦቼ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተገላትያ ሰቦቼ</para>
  <para style="toc2">ተ ተገላትያ ሰቦቼ</para>
  <para style="toc3">ገላ.</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተገላትያ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ስለኢየሱስ አትርፎት ይዝነጊ የወንጌል ቃል መደር ተመደሪም ይሰብክኸም አይሑድ ያንከኖ ሰቦች ቲቄበሮይም በወሮ ቅጫ “ክርስቲያን የወሕን የኦሪት ሕጊ ወፈጥም ያሸ ወይሽ ኤያሸ?” ይብሪም ጥያኤ ቁናዬ ተነሣ፤ ብንሲ እስያ የሮም ግዛት በኸነዪ በገላትያ ባኖ አብያተ ክርስቲያን ግብት “ሰብ በእዝጌር ኢፍት ይጸድቅኸም በኢየሱስ ወምን ጠለለ ቴይኸን በሙሴም መሳ ያᎅ ሕጊ ወፈጠም ነነወ” በወበር የጳውሎስ ይቃወሞ ሰቦች ባኖ።</para>
  <para style="ip">ጳውሎስ ዚ የገላትያ መልክት የጣፈዪ በዚ ትምርት ዱቁቅ የባረቦዪ ሰቦች ተሱቲዬ እምነት የክርስትና ሕይወትም የወምራው፤ ጳውሎስ የኢየሱስ ክርስቶስ ሐዋርያ ወሕነሑ በዋርጋግጥ ይቀርስ፤ የሐዋርያነት የጠራን እዝጌር አንኸንም ሰብ ያንከነኸም የሑቲም ተልእኮ አይሑድ ታንከኖዪ ሰቦቼ የኸነኸም በዋፍታታ ያትሬዳ፤ በመጨረሻዪ ምራፎች ውስጥ የክርስቲያናዊዪ ሕይወት በኢየሱስ ተወምን ቲትረከቢ ፍቅር ይምነጭ ወሕነሑ ያትሬዳ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ<char style="ior"><ref loc="GAL 1:1-10">1፥1-10</ref></char></para>
  <para style="io1">የጳውሎስ የሐዋርያዊዪ ሥልጣን <char style="ior"><ref loc="GAL 1:11-2:21">1፥11—2፥21</ref> </char></para>
  <para style="io1">የእዝጌር ጸጋ ወንጌል <char style="ior"><ref loc="GAL 3:1-4:31">3፥1—4፥31</ref> </char></para>
  <para style="io1">የክርስቲያናዊዪ ነጣነት እምነትም <char style="ior"><ref loc="GAL 5:1-6:10">5፥1—6፥10</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="GAL 6:11-18">6፥11-18</ref> </char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s1">የሐዋርያ ጳውሎስ መልክት ተገላትያ ሰቦቼ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />በሰቦች ወይ በሰብ ተትላኸዪ ቴይኸን፣ በኢየሱስ ክርስቶስም ተሟቾቺ ባትኔሳን በእዝጌር አብ ሐዋርያ ተኸነዪ ተጳውሎስ መልክት፤ <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />ቲያጌ ተነበሮዪ ጐባቢት እንም፤ በገላትያ ታኖዪ፤ <verse eid="GAL 1:2" /><verse number="3" style="v" sid="GAL 1:3" />ተአባና ተእዝጌር፣ ተጔታ ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን። <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />የአምላከና የአባናም ፈአድኸም፣ ተዚ ቡሼ ዘበን ያተርፍነዬ ክርስቶስ ስለአጢያተና ነብሰው አበ፤ <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />ተዘለዓለም ዘለዓለም ስን የሑቲ ክብር የሕን፤ አሜን።<verse eid="GAL 1:5" /></para>
  <para style="s1">ወንጌል ቁናው</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />በክርስቶስ ጸጋ የጠራናሑዪ የሑቲ ገፈርኩም፣ ተትለኘ ወንጌሌ እኪ አቴከልኩም ወዙራሑ ኧዴነቅ፤ <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />የኢንኸም በኸነ እንጐድ ወንጌል ኤነ። ያድንጋግሮኩዪ የክርስቶስ ወንጌል የዋጣም ግጅላ ይሸክቶ አታት ሰቦች ነኖ። <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />ቢኸንም ኢናም ብንኸነ ወይ የሰሜ መላይካ፣ ተሰበክነንኩ ወንጌል የትለኘ ወንጌል ቢሰብክንኩ ሑቲ የሰደበ የሕን። <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />በደርነም የባርነኸም፣ ኧሗም ኧዠብርም ኧብር፤ ሟንም ተትቌበርኩይ እንጐድ የትለኘ ወንጌል ቢሰብክንኩ፣ ሑቲ የሰደበ የሕን። <verse eid="GAL 1:9" /><verse number="10" style="v" sid="GAL 1:10" />ኧጌሽ እያ ኧሸ ሰብ ያምሰግኔኸሙ ወይሽ እዝጌር ያምሰግኔኸም? ወይሽ የሰብ የዋትብላልቅ ኧሸ መሰረናሑም ይኸን? የሰቦች የዋትብላልቅ ኧሸ ብንኸን፤ የክርስቶስ አገልጋይ ባንከንኩ ባነ። <verse eid="GAL 1:10" /><verse number="11" style="v" sid="GAL 1:11" />ጐባቢተና፤ የሰበከክንኩ ወንጌል ሰብ የሸኰተን አለወሕነሑ ቲሒሮኸም ኧሸ፤ <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />በሟንም ሰብ አንትቀበርኩን፤ ተሟንም አንትማርኩን፤ ይጠቅልሽ በመገለጥ በኢየሱስ ክርስቶስ ተቌበርኩን።<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />በደረም በአይሑድ እምነት ተከታይ በነበርኩወ ግዝየ ምንኸም የነበርኩኸም ሰማሑም፣ የእዝጌር ቤተ ክርስቲያን ተልክ ነን ትናሳድድ የዋጥፋ ኧጋደል ባነ። <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />ቢያ ዘበን ተነበሮዪ ተብዠሕኖ አይሑድ የበዛ በአይሑድ አይማኖተኛ ኧበዛ ባነ፤ የአቦቸና ሴራ ስርም ኧቀና ባነ። <verse eid="GAL 1:14" /><verse number="15" style="v" sid="GAL 1:15" />ቢኸንም፣ ተዳኮኛ ማጠን<note caller="+" style="f"><char style="fr" closed="false">1፥15 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ተወጠኘኛ</char></note> ቀረሰም የላኜ በጸጋመሑ የጠሬ እዝጌር፣ <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />ተአሕዛብ ግብት ስለሑቲ ኧሰብክኸም ትኸሑ ቢያ ይገልጤ በወደደ ግዝየ፣ ተሟንም ሰብጌ አንትማኸርኩ፤ <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />ቲያ ኢፍቴ ሐዋርያት ተኸኖዪ ተኢየሩሳሌሜ አንወጣሑ፤ ቢኸንም ሒንጌም ተዐረብ ገኜ ወርኩ፤ ባንቌም ተደማስቆዬ ተዠበርኩ።<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />ተሦስት ዓመት አንቌ፣ ኬፋ የጴጥሮስ<note caller="+" style="f"><char style="fr" closed="false">1፥18 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ኬፋ </char><char style="ft" closed="false">ይቡን። </char></note> ኧረሕᎆ ተኢየሩሳሌሜ ወርኹ፤ ተሑቲጌ ዐሥራ አምስት ከነ ቾናሑ። <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />ቢኸንም የጔታ ጐቤ ተያዕቆብ ኧንጐድ፣ ተሐዋርያት የሟንም አነዠሑ። <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />ብንጠፍንኩ ቃር በእዝጌር ኢፍት ባጢል አንዝነግኸም አትሬግጥም ኢውድሑ። <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />ተዛም አንቌ፤ ተሶርያ ተኪልቅያ ገኜ ወርኩ። <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />በክርስቶስ ያመኖዪ የይሑዳ አብያተ ክርስቲያናት ኢፍተኛ አዞም ኤይሒሮ ባነ፤ <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" /><note caller="-" style="x"><char style="xo" closed="false">1፥23 </char><char style="xt" closed="false"><ref loc="ACT 22:3">ሐዋ. 22፥3</ref>። </char></note> ሕኖም፤ “ድረ ይና ያሳድድነ የነበረዪ ሰብ፤ ተዚ ኢፍቴ ያጠፏኔ ይሸ የነበረዪ እምነት ኧሗ ይሰብክ” ይብር ዜና ሰሞም ባነ። <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />ቢያም መሳ የእዝጌር አምሰገኖ።<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">ጳውሎስ ሐዋርያ ወሕነሑ አመኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />ተዐሥራ አርበት ዓመት አንቌ፣ ተዠበርኩም ተኢየሩሳሌሜ ወርኩ፤ በዛ ግዝየ ተበርናባስጌ ባነሑ፤ የቲቶ ጠበጥኩንም ወርኩም ባነ። <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />ባዠሑንም መገለጥ የትነሣ ተዛዬ ወርሑ፤ በአሕዛብ ግብት ኧሰብኲ ወንጌል የሕኖ ገለጥኩኖ። የሕን አኸንም፣ የሟንᎀሑ ቤድገልል ቃር ትንሮጥ ወይ ሮጥኩም ኤይኸንኸም በወስጋ፤ ዋና ይመስሮዪ ጠለለ በግል ዚም አትኴርሕኖ። <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />ቲያጌ የነበረዪ ቲቶ የግሪክ ሰብ ቢኸንም፣ ጤበን ያወኔኸም የግድ አንቧሪ። <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />ተዚ ወባጀ የትነሣ አታት ባጢለተኞች ጐባቢት በክርስቶስ ኢየሱስ የረከብኔ ነጣነት ይሴልሎዬ ጉዙ ይሸክቶነዬ ቲናዬ ሹልክ ባሮም በወግባሕኖው።<verse eid="GAL 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 2:5" />የዚ ሰቦች የቁናምጌ አንትገዛነኖ፤ ዚም፣ የወንጌል ሐቅ ታሑጌ ጠናም ይነብርኸሙ።<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />ዋና መሰሮም ይታዞዪ ሰቦች ሟንነት እያ ግድ ኤይብሬ፤ እዝጌር የሰብ ኢፍት አዠም ኤያዳላ፤ ነዚ ሰቦች የመልክተኛ የደበሮኒ ቃር ኤነ። <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />ቢኸንም ጴጥሮስ ጤበን ያወነዮዪ<note caller="+" style="f"><char style="fr" closed="false">2፥7 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የአይሑድ</char></note> ወንጌል ይሰብክኸም ዐደራ ያᎅኸም፣ ይያም ጤበን ያናውነዮዪ<note caller="+" style="f"><char style="fr" closed="false">2፥7 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የአረማዊያን </char><char style="ft" closed="false">ዛምኸም ቁ 8 ወይ 9 ተመ</char></note> ወንጌል ኧሰብክኸም አደራ ያቡኝኸም ተሬዶ፤<verse eid="GAL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 2:8" />የጴጥሮስ የአይሑድ ሐዋርያ ይኸንኸም የሸከተ እዝጌር፣ ይያም የአሕዛብ ሐዋርያ ኸንኩም አግለግልኸም ሸከቴም። <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />የችባንኸም ይቆጥርዮዪ ያዕቆብ፣ ኬፋ ጴጥሮስ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="ft" closed="false">ግሪኩ </char><char style="fqa" closed="false">ኬፋ </char><char style="ft" closed="false">ይብር፤ ዛምኸም ቁ 11 ወይ 14 ተመ</char></note> ዮሐንስም ያቡኚ ጸጋ ባጥራመቶ ግዝየ፣ ይያም የበርናባስ የወትገገዝ ከነ ኧጀሕኖ አቦነ፤ በዛም ኢና ተአሕዛቤ፣ ሕኖም ተአይሑዴ አርኸም ተስማሞ።<verse eid="GAL 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 2:10" />አጠበቆም ዐደራ የባሮነ የዜጋ ዋስበና አናትቋርጥነኸሙ፤ እያም ዚ የወሰክት ኤላተኛ ባነ።<verse eid="GAL 2:10" /></para>
  <para style="s1">ጳውሎስ የጴጥሮስ ተቃወመን</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />ጴጥሮስ ተአንጾኪያዬ በቸኘ ግዝየ፣ በወዳላሑ ቢልቢጢጦ ኢፍት ሊፍት ተቃወምኩን። <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />አታት ሰቦች በያዕቆቤ ተወተኘሕኖ ኢፍቴ፣ ተአሕዛብጌ ይበራ ባነ፤ ሕኖ በቸኖ ግዝየም ጤበን ባወኔዮ ጐሳ ኢፍት ሟለለንም ተአሕዛብ ነብሰሑ ተላኘም ሰኴ፤ <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />በርናባስም በሕኖ ግብዝነት ይትወሰድ ስን፣ እንጐድም አይሑድ በግብዝነተሑ አገዞይ። <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />የሕኖ ሜና ተወንጌል የኢንጌ አለወስማማሑ ባዠሑ ግዝየ የጴጥሮስ እኪ አኸ አይሑዳዊ ኸንከም ትናነ በአይሑድ ሥራት ቴይኸን በአሕዛብ ሥራት ትነብር ባነ። ኧጌ፥ አሕዛብ በአይሑድ ሥራት ይነብሮኸም የመአር ግድ ትብኖ ትንብር ብንም ኢፍቴ ተቃወምኩን።<verse eid="GAL 2:14" /></para>
  <para style="s1">አይሑድም ኸኖ አሕዛብ ይተርፎ በእምነቱ</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />ኢና በጨኘተና አይሑድንነ አንኸንም፤ አጢአተኞች አሕዛብ ያንከነ፤ <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />ሰብ በኢየሱስ ክርስቶስ በወምን አንኸንም፤ ሕግም በወቀየ ኤጸድቅኸም ኧሒርነ። ሕግም በወቀየ ቴይኸን፤ በክርስቶስ በወምን ኧጠድቅነዬ ኢናም ኧሗም በክርስቶስ ኢየሱስ አመነም፤ መሳሑም ሕጊ በወቀየ ሟንም ኤጸድቅ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">መዝ. 143፥2</ref>፤ <ref loc="ROM 3:20">ሮም 3፥20</ref>፣<ref loc="ROM 3:22">22</ref>። </char></note> <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />“በክርስቶስ የወጽድቅ ትንሸነ፤ ኢና ነብሰና አጢያተኞች ወሕነና ግልጡ፤ ኧጌሽ ክርስቶስ አጢያት ይቤትትኸም ይሸክት? ስርም አንከነ! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />ያፈረስኩኒ ዠበርኩም ኧግነባ በኸነ ሕጊ ኧችላለፍ ወሕነኛ አርጋግጥ። <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />መሳሑም የእዝጌር ኧነብሬ፤ በሕግ ኤማ የሕጊ ᎀትኩም። <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />ተክርስቶስጌ ተሰቀርኩም፤ በዚ አንቌ እያ አንነብር፤ ቢኸንም ክርስቶስ በውስጠኛ ይነብር። ኧሗም በጅስም ኧነቡሪ ኑሮ በወደዴም ስለእያ ነብሰሑ አቸለፈም ባበዪ በእዝጌር ትኸ ባኔ እምነቱ። <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />የእዝጌር ጸጋ አናቀል፤ ጽድቅ በሕግ ኤማ ይትረከብ በኸነ፤ ክርስቶስ እክም ᎀተ ወበሩ!”<note caller="+" style="f"><char style="fr" closed="false">2፥21 </char><char style="ft" closed="false">አታት ተርጓሚዎች ትምርተ ጥቅሲ ተቁ 14 አንቌ ይሸክቶ። </char></note><verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s1">ጽድቅ ይትረከብ በክርስቶስ በወምኑ</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />አሑ አታጥራምቶ የገላትያ ሰቦች! ወሕነሑ ሟ መተት ሸከተብኩ? ኢየሱስ ክርስቶስ የሰቀረኸም ኸነም ቢፍት ሊፍታሑ ቢልቢጢጥጦ ተሳለም ባነ። <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />ባሑዬ ቁና ቃር ወሐር ኧሸ፤ መንፈስ የቌበርኩይ ሕጊ በወቀየው ወይሽ? የሰበከንኩዪ በወምን? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />ዚ ቅጫ አታጥራምቶንኩ? በመንፈስ ሕጊ ቀረስኩም በበሠር ኤላት ሕጊ ሜና ፍጡም የወሕን ትጋደሎ? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />ዮንም ኤድገልል በኸነ፤ ዚ ያሕር መከራ የቌበርኩ እክሙ?። <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />እዝጌር መንፈሰሑ ይብሑ ባሑሜ ታምራት ይሸክት ሕጊ የቂየሑዬው ወይሽ የሰማሑዪ ያመንኩ ስለኸነው? <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />እንዴ የአብርሐም አስቦ፤ “ሑቲ የእዝጌር አመነ፤ ጽድቅ ኸነም ተቆጠረነ።”<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ዘፍ. 15፥6</ref>፤ <ref loc="GEN 4:3">4፥3</ref>። </char></note> <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />ኧጌሽ ነዛ ያመኖዪ የአብርሐም ዴንጋ የኸኖኸም አጥራምቶ።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="GAL 4:16">4፥16</ref>። </char></note> <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />እዝጌር የአሕዛብ በእምነት ያጸድቅኸም ቅዱስ መጽሐፍ በደረም አዠም “ሕዝቢ እንም ባኸ ይትባረኮ” በወበር በደረም የአብርሐም የምሥራቺ ቃል አበሠረም።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">ዘፍ. 12፥3</ref>። </char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />ስለኸነም ያመኖዪ እንም ታመነዪ ተአብርሐምጌ የትባረኮኖ።<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />ሕጊ በወቀየ ይትማመኖ እንም ተስድᎄኘ ተትኖ፤ “በሕጊ መጻሕፍት የጣፈዪ እንም ኤይሸክት ስድᎄኘው” ቧሪም ተጣፈም።<verse eid="GAL 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 3:11" />“ጻድቅ በእምነት ይነብር” የቧሪ ስለኸነ፣ ሟንም በእዝጌር ኢፍት በሕጊ ኤጸድቅኸም ቢልቢጢጦው። <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />ሕጊ በእምነት ᎈር የትምሠረተ አንከነ፤ ቢኸንም “ሕግጋቲ ይፌጥም ሰብ በሕኖ በሕይወት ይነብር” ቧሪም።<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />“በጨ ᎈር ተሰቀረም ይᎀት እንም ስድᎄኘው” ቧሪም የጣፈ ስለኸነ፣ ክርስቶስ ይና የስድᎄኘ ሰብኸም ኸነም ሕጊ ቲያቸኝኒ ስድብ ዋጀነም፤ <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />ዚም የኸነዪ እዝጌር የአብርሐም ያᎄኒ በረከት በኢየሱስ ክርስቶስ መሳ የአሕዛብ ይሰላኸም ኢናም እዝጌር ኢብኩ የቧረኒ መንፈስ ቅዱስ በእምነት ኧቌበርነኸሙ።<verse eid="GAL 3:14" /></para>
  <para style="s1">የኦሪት ሕጊ የተስፋም ቃል</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />ጐባቢተኛ፤ እንዴ ዚ ዘንጋ በሰቤ የትሮሸዪ ምሳሌ ሸከትኩም ናቅርብ፤ አት ሰብ የገቧን የቃል ጉዳ በጸደቀ አንቌ ሟንም ሰብ ይሸሬ ወይ ይደብርወዬ ኤይችል፤ በዚም ወባጀ ቢኸን ዛምኸሙ። <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />የተስፋዪም ቃል የቴወደ የአብርሐም የዘርመሑም ባነ፤ መጽሐፍ፣ የብዠ ሰቦች ይውድኸም፣ “የዘሮቸሑ” ኤይብር፤ ቢኸንም ያት ሰብ ይዝነጒኸም፣ “የዘራኸ” ይብር፤ ሑቲም ክርስቶሱ። <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />ኧቡኒ እኪቱ፤ ተአርበት መቶ ሠላሳ ዓመት አንቌ ያᎅዪ ሕጊ፣ በደረም በእዝጌር የጠናዪ ጉዳ አፈረሰም የተስፋዪ ቃል ኤይሸር። <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />ርስት ወውርስ በሕጊ ቢኸንማ፣ በተስፋ ቃል ቤትረከቡ፤ እዝጌርም በጸጋሑ በተስፋ ቃል መሳ የአብርሐም አᎄንም።<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />ኧጌ ሕጊ ያቡᎄ መሳ መአሩ? ሕጊ የደᎄሪ ተወችላለፍ የትነሳ ተስፋሑ ያምለከተዪ ዘር ይቸኝ ስኑ፤ ሕጊም የቸኘ በመላይካ ኤማ፤ ባት ቢያታርቅ ሰብ ኤማው። <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />የሕን አኸንም በግብት ኸነም ያታርቅ ሰብ የዄት ጐሣው አንኸንም ያት ጐሳ ጠለለ ኤሸክት፤ እዝጌርም ቁናው።<verse eid="GAL 3:20" /></para>
  <para style="s1">ሕጊ የመአር ያᎅኸም</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ኧጌሽ ሕጊ የእዝጌር የተስፋ ቃል ይቃወሙ? ስርም ኤይቃወም! ሕጊ ያᎅ ሕይወት የዋትረክብ ቢኸን፤ የኢንም ጽድቅ በሕጊ ኤማ ይረሕᎅ ባነ። <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />መጽሐፍም ዓለም እንም በአጢያት የታገደ ወሕነሑ ዬውጅ፤ ዚም በኢየሱስ ክርስቶስ በወምን ይትረከቢ ተስፋ ያምኖዪ እንም ይᎅኸሙ።<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />ዚ እምነት ተወተኘሑ ኢፍቴ በሕጊ መሳ ኧጉጀኘ ኸነም፤ እምነት ይትገለጥ ስን ታጨብነም ባነ። <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />ስለኸነ በእምነት ኧጸድቅነኸም ሕጊ ተክርስቶሴ ያሰላነ ሞግዚተና ኸነ። <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />ኧሗም ዛ እምነት የቸኘ ስለኸነ ተዚ አንቌ በሕጊ ሞግዚትነት ተት አንከነ፤<verse eid="GAL 3:25" /></para>
  <para style="s1">የእዝጌር ዴጋ</para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />እንማሑ በክርስቶስ ኢየሱስ በወምን የእዝጌር ዴንጋ ንኩ፤ <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />ተክርስቶስጌ ቁና ትኸኖዬ የጠመቅኩ እንማሑ ክርስቶስ ለበስኩይም። <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />በአይሑድም በግሪክ፤ በጉዙም በነጣ ሰብ፤ በርጅም በገረድም ግብት ልዩነት ኤነ፤ እንማሑም በክርስቶስ ኢየሱስ ቁናኩ። <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />የክርስቶስ በኸንኩ፤ አሑ የአብርሐም ዝሬትንኩ፤ በተስፋዪም ቃል መሠረት ወራሾችንኩ።<note caller="-" style="x"><char style="xo" closed="false">3፥29 </char><char style="xt" closed="false"><ref loc="GAL 4:13">4፥13</ref>። </char></note><verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />እያ ኧቡኒ ዚቱ፤ ወራሺ ሰብዬ የኸነ ስን፣ ዱንያ እንም የሑቲ ቢኸንም፣ ተጉዙ የትላኘ አንከነ። <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />አባሑ የዌሰነነ ግዝየ ስን ቢቅሮዪም በሞግዚቶቺ ተቱ። <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />ኢናም ዛምኸም ገና ዴጋ በነበርነᎄ ግዝየ ተዓለም መሠረታዊ ትምርት ተት በወሕን በጉዙነት ተገዛነም ባነ። <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />ቢኸንም የትዌሰነዪ ዘበን በሰላ ግዝየ፣ እዝጌር በምሽት የጨኘዪ፣ ተሕጊ ተት የጨኘዪ ትኸኹ ላኸ፤ <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />ዚም የኸነ የትኽነት መብት ኧረሕብነዬ ተሕጊ ተት ያኖዪም የወዋጁ። <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />ዴንጋም ስለኸንኩ እዝጌር፣ “አባ<note caller="+" style="f"><char style="fr" closed="false">4፥6 </char><char style="ft" closed="false">በአረማይኪ </char><char style="fqa" closed="false">አባ </char><char style="ft" closed="false">ወበሩ። </char></note> አባ” ባረም ው ይብር የትኸሑ መንፈስ ተሒነናዬ ላኸ።<verse eid="GAL 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 4:7" />ስለኸነም ተሗ ቀረሰም ትኸንከ አንከንም ጉዙ አንከንከ፤ ትኸም ስለኸንከ፣ እዝጌር ወራሽ ሸከተናኸም።<verse eid="GAL 4:7" /></para>
  <para style="s1">ጳውሎስ የገላትያ ሰቦች ዋስበው</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />እዝጌር ተወሐራሑ ኢፍቴ፣ ባመለሕኖ አማልክት ያንከኖዪ ጉዙዎች ባነሑ፤ <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />ኧሗሽ የእዝጌር ሐርኩይም፤ ይጠቅሊሽ ኧሗም በእዝጌር ተዄርኩም። ኧጌ ዠበረም ተቌጠ ቴይጠቅም ትምርቴ ምንኸም ትዠበሮ? ኧሗም በሑቲ ጉዙዎች የወሕን ትሸዎ? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />የትለየ የኸኖ ከነ፣ መሬት፣ ወክቶቺ ዓመትም ታከብሮ። <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />ስላአሑ እክም የቌጥኩ ቲመስሬ ኧጔናንኩ።<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />ጐባቢት! እያ ያሑኸም ስለኸንኩ አሑ ይያኸም ሕኖ ባሑም ኧጮቅስኩ። አሑ አትም አንበደልኩኝ።<verse eid="GAL 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 4:13" />ቲሒሮይኸም በመጀመሪያ ያሑ ወንጌል የሰበኩን፣ በቂናም መሳ ባነ።<verse eid="GAL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 4:14" />ኧቂናኛ የአሑ ፈተና ኸነብኩም ትናነ፣ አንትስላቸሑኝ፤ ወይ አንትጠየፍኩኝ፤ ቢኸንም የእዝጌር መላይካኸም፣ ዛምኸም የነብሰሑ የኢየሱስ ክርስቶስኸም ሸከትኩም ተቌበርኩኝ። <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ወሕነሑ ዛ እንም ብልቃታሑ ኤቴ ሰላ? ቢቸልኩ ዔናሑም ቢኸን አወጣሑም ቲቦኝ የነበርኩኸም ኧምሰክር። <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ኧጌ፥ ኧሗ የኢኒ የዝነጔሑ ስለኸነ መሶአሑ ኸንኩም ተረከብኩ?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />ነዛ ሰቦች ተነብሰሕኖ ይወስዶኩዬ ይትጋደሎው፤ የፈያ አንከነ፤ ይሸዎ ያሑ ቲና ኔጠሎም የነብሰሕኖ ይሸክቶኩዬው። <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />የፈያ የኸነ ስን ተቈርቋሪ ወሕን ፈያው፤ ዚ ወሕን ይትጌባ እንጌ አንኸንም እያ ታሑጌ ትናነሑ ጠለለ አንከነ። <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />ኧወድሑ ዴጋኛ፤ ክርስቶስ በውስጣሑ ይትቀረጥ ስን ስላአሑ ዠበረም መጥ ጠበጤም፤ <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />ስላአሑ ዱዱቅ ባረቢም ተጨነቅኩም፤ ኧሗም በግብታሑ ተረከብኩም በትለኘ ቋንቋ ኢውድሑዬ ምን ቅጫ ኧወድ ባነ!<verse eid="GAL 4:20" /></para>
  <para style="s1">አጋር ሣራም ምሳሌ ወሕነሕነማ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />አሑ ተኦሪት ሕጊ ተት የወንብር ትሸዎ እንዴ አውዶኝ፤ ሕጊ መአር ይብርኸም አንሰማሑ? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />አብርሐም፣ አቲ ተጉዙዪ፣ እንጐዲ ተነጣዪ ምሽት የኸኖ ዄት ዴጋ የነበሮይኸም ተጣፈም። <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />ጉዙ በነበረቺ ምሽት የትረከበዪ ትኸ፣ በበሠር ሕጊ ወሮሽ ባነ፤ ተነጣዪ ምሽት የጨኘዪም በተስፋዪ ቃል መሠረቱ።<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />ነዚ እንሽታ ዄቲም ጉዳ ያምለክተማ ስለኸነ፣ ዚ ሐለት ምሳሌ ኸነም ይታዥ። አቲዋኘ ጉዳ ተሲና ቈቶ ቲኸን፣ የጉዙነት ይኸኖ ዴንጋም ትጨኚያ፤ ሒቲም አጋርያ። <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />ኧጌሽ አጋር በዐረብ ገኝ ያነቺ የሲናም ቈቶ ምሳሌ ባነች፣ ኧሗ ያነዪ ኢየሩሳሌም ትመስር፤ ሒቲ ተዴንጋዬታን በጉዙነት ትትረከቢያ። <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />በነኔ በሰሜ የኸነቺ ኢየሩሳሌም በነጣነት ትነብር፤ ሒቲም ዳኮናያ። <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />እኪ ቧሪም ተጣፈም፤</para>
  <para style="q1" vid="GAL 4:27">“አሺ አትጨኝ ኤጬኞ ዘ፤</para>
  <para style="q2" vid="GAL 4:27">ተብላሌቅ፤</para>
  <para style="q1" vid="GAL 4:27">አሺ አመጥሽም አትሒ፣</para>
  <para style="q2" vid="GAL 4:27">ብልልታ እልል ቤ፤</para>
  <para style="q1" vid="GAL 4:27">ምስ ታነና የጠቀለ፣</para>
  <para style="q2" vid="GAL 4:27">የመተዮዪ ብዠ ዴንጋ በዞም።”<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />በይሽ ጐባቢት፤ አሑም የይስሐቅኸም የተስፋዪ ቃል ዴንጋንኩ። <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />በዛም ግዝየ የበሰር ሕግኸም ወሮሽ የጨኘዪ፣ ትኸሑ በመንፈስ ቆት የጨኘዪም አሳደደን፤ ኧሗም የዛኸሙ። <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />ቢኸንም መጽሐፍ መአር ይብር? “የጉዙዬታን ተትዄታንጌ ስድዳ፤ የጉዚ ትኸ ተነጣዪ ትኸጌ ኤይወርስ” ይብር። <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />ስለኸነም ጐባቢት፤ ኢና የነጣዪ አንኸንም የጉዙዪ ዴንጋ አንከንነ።<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s1">በክርስቶስ ይትረከብ ነጣነት</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />ክርስቶስ ነጣ ያወጣነ በነጣነት ኧነብርነኸሙ። ስለኸነ ጥኖም ቁሞ፤ አትዘብሮም በጉዙነት አንገችል ኤድሙጅኩ። <verse eid="GAL 5:1" /><verse number="2" style="v" sid="GAL 5:2" />ኧቡኒ አጥራምቶ፤ ጤበነኘ ወሕን ብትሸዎ፣ ክርስቶስ ስርም ያሑ ኤይጠቅምሑኸም እያ ጳውሎስ ኢውድሑ። <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />ጤበን ያወኔዬ ይሸ እንም ሕጊ እንም የወፈጥም ግዴታ ያነወኸም ኧዠብርም አትባተሑ ቢልቢጢጦ ኧዝነግ። <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />በሕግ የወጽድቅ ትጋደሎ፣ ተክርስቶስ ተላኘሑም፤ ተጸጋ ራቅኩም። <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />ኢና ተስፋ ኧሸክትነዪ ጽድቅ፣ በመንፈስ መሳ በእምነት ኸንነም በቡርሻት ኧቂየነ። <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />በክርስቶስ ኢየሱስ በኸኖ፤ ጤበን ዋውና ወይ አለዋውና ኤይጠቅም፤ ይጠቅሚሽ በፍቅር ይትገለጥ እምነት ጠለለው።<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />ሜናሑ ፈያ ባነ፤ ኧጌሽ ያክናተፈናሑ፣ የሐቅሽ አትታዘዞኸም የኸተረናሑ ሟኒ? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />የዚኸማቲ ምክር ተሜጠረናሑዪ ተእዝጌር የቸኘ አንከነ፤ <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />“ቀል እርሾ ቡኮዪ እንም ያቦኳን።” <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />የትለኘ አሳብ ኤነብርሑኸም በጔታ ኧታመን። ዱዱቅ ያትበኝሑዪ ሟንም የሕን ሟ፣ ፍርደሑም ይቌበር።<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />ጐባቢት፤ ኧኳ ስን ስለጤበን ኧሰብክ በኸነ፣ ኧጌሽ ኧሗ ስን የመአር ያሳድዶኝ? የዛኸም ቢኸን፣ መስቀል ቌፋ ወሕነሑ ይቀይ ባነ። <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />ዱዱቅ ያትበኖኩዪ ሰቦች የነብሰሕኖ ጤበን ጠለል ቴይኸን የቀምጥሎይ! <verse eid="GAL 5:12" /><verse number="13" style="v" sid="GAL 5:13" />ጐባቢተኛ፤ ነጣ ትኸኖኸም ተጠራሑም፤ ነጣነታሑም የበሰር ሕጊ ኤላታሑ<note caller="+" style="f"><char style="fr" closed="false">5፥13 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">አጢያተኘ ኸልቀታሑ፤ </char><char style="ft" closed="false">ዛምኸም ቁ 16፥17፥19 ወይ 24 የመ። </char></note> ይፌጥሙᎄ አትሰክቶ፤ ይልቅሽ አቲ ይንጐዲ በፍቅር ያገልግል። <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />ሕጊ እንም በቁና ቃል ተጥቃለለም፤ ዚም፣ “ደቦአኸ የነብሳኸኸም ውጅጅ” ይብሪው። <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />ቢኸንም ነብስ በነብሳሑ ትናከሶ ትትባኖም በኸነ፣ ነብስ በነብሳሑ አትጥፋፎኸም ተቀሮ።<verse eid="GAL 5:15" /></para>
  <para style="s1">በመንፈስ ወዥባበር</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />በይሽ በመንፈስ ተመሮም ንበሮ፤ የበሠር ኤላት አትፈጥሞ ኧብር። <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />በሠር መንፈስ ኤይሸኒ፣ መንፈስም በሠር ኤይሸኒ ይትሜና፤ ነዚሕኖ ነብስ በነብሰሕኖ ኤይስማሞ ስለኸነ፣ ትሸዎዪ አትሸክቶ። <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />በመንፈስ ብትመሮ፣ ተሕጊ ተት አንከንኩ። <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />የበሠር ሜና ግልጡ፦ ዚም ዝሙት፣ ሩኩሰት፣ ወሟግጥ፣ <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />ጣዖት ዋምልክ፣ ሟርት፣ ወጥላ፣ መናክስ፣ ወቅና፣ ወማች፣ ነብስ ወውድድ፣ ወልያይ፣ ዋድም፤ <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />ምቀኝነት፣ ስካር፣ የዓለማዊ ደርስ፣ የዚምኸም ነዚሕኖ ይመስሪው። በደርኩም የባሑኸም፣ ኧሗም አጥኔቅቅኩ፤ በዚ ሐለት ይነብሮ እንም የእዝጌርም መንግሥት ኤይወርሶ።<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />የመንፈስ ፍርየም ፍቅር፣ ብልቃት፣ ሰላም፣ ትዕግሥት፣ ሜናነነት፣ ፈይነት፣ ታማኝነት፣ <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ገርነት፣ ራስ ወግዛው። ዚኸም ያኖዪ ይኸትር ሕጊ ኤነ። <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />የክርስቶስ ኢየሱስ የኸኖ በሠር ተቡሼ ኤላተሑምጌ ሰቀሮም ቀጠሮይም። <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />በመንፈስ ኧነብርነ በኸነ፣ በመንፈስ ንዥባበርነ። <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />አቲ የንጐዲ የቡሼ በዋንሣሣ ነብስ በነብሰና ትንቅናናነ ቤድገልል ቃር አንትነነድነ።<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s1">የሰብ እንም ፈያ ወሰክት</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />ጐባቢት፤ አት ሰብ በአጢያት ውስጥ ቡየም ቢትረከብ፤ መንፈሳውያን የኸንኩ አሑ በሜናነት ትዠብሮዬ ይትጌባ። ቢኸንም አኸም አትፌተንኸም ራሳኸ ቀየ። <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />አቲ ያቲ ብሶት የጮር፤ በዚም ሐለት የክርስቶስ ሕጊ ትፌጥሞ። <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />አት ሰብ አትም ቴይኸን ወደል የኸነ ቢᎀስር ነብሰሑ ያብላልጥ። <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />እያታቲ የነብሰሑ ሜና የመርምር፤ በዛም አንቌ፤ ትንጐድ ሰብጌ ነብሰሑ ቴያውዳድር፤ ስለነብሰሑ ይትነነድወ ይረሕብ፤ <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />እያታቲ የነብሰሑ ብሶት ይጮሬ ይጌቧን።<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />ሟንም ቃለሑ ይትመር፤ ፈያ የኸነዪ ቃር እንም ታስተማሪየሑጌ የሳድ።<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />ኤያብላልጭኩ፤ እዝጌር ኤቌልጅᎄ። ሰብ የዘራኒ ያድ። <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />የበሠር ኤላተሑ የዋትብላልቅ ይዘራ፤ በበሠረሑ<note caller="+" style="f"><char style="fr" closed="false">6፥8 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">አጢአተኘ ኸልቀት የወርካ ይዘራ፣ ተዚ ኸልቀት</char></note> ጥፋት ያድ፤ መንፈስ የዋትብላልቅ ይዘራ በመንፈስ የዘለዓለም ሕይወት ያድ። <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />ፈያ ቃር የወሰክት ሰነፍ አንከነ፤ ተስፋ ባነረጥነ ወክቲ ቲሰላ መከሪ አድነ። <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />ስለኸነም ዕድል ባነነ የሰብ እንም፤ በተለይም ያመኖዪ አበሮስ ፈያ ንሰክትነ።<verse eid="GAL 6:10" /></para>
  <para style="s1">ገደር ኸልቀት ወሕን</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />ምንኸም ባኖ ወደል ፊደል ዚ በጀኛ የጣፈክንኩኸም ተመልከቶ። <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />ጤበን ያወነኩኸም ግድ ይብሮኩዪ በውጪ ፈያ መሰሮም የወታዥ ይሸዎ ሰቦችኖ። ዚም ይሸክቶ በክርስቶስ መስቀል መሳ ስደት ኤሰላቦኸሙ። <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />ሕኖ ባሑ በበሠራሑ የወትነነድ ባሮም ጤበን ያወኔዎኸም ይሸዎ አንከንም ጤበን ያወኖዪማ ነብሰሕኖ ሕጊ ኤይፌጥሞ። <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />ቢኸንም ዓለም ይያ ተሰቀረም የᎀተወ፤ እያም የዓለም ተሰቀርኩም የᎀትኩወ ተጔታና ተኢየሱስ ክርስቶስ መስቀል እንጐድ ወትነነድ ቲያ የራቀ የሕን። <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />ስለኸነም ጤበን ዋውናም ኸነ አለዋውና አትም ኤይጠቅም፤ ይጠቅሚሽ ገደር ኸልቀት ወሕኑ። <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />ዚ መመሪያ ይትዄተሎ እንም የእዝጌር ጐሳ የኸኖ እስራኤላውያን ሰላም ምረተሑ የሕን።<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />በገገኛ ያነዪ የግርፋት ጠባሳ የኢየሱስ አገልጋይ ወሕነኛ ያምለክት ስለኸነ ተሗ ቀረሰም ሟንም ኤያትመኬ።<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />ጐባቢት! የጔታና የኢየሱስ ክርስቶስ ጸጋ ታሑጌ የሕን! አሜን።<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>