<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">Mesqan New Testament BIBLE REVELATION</book>
  <para style="h">የዮሐንስ መና</para>
  <para style="toc1">የዮሐንስ መና</para>
  <para style="toc2">የዮሐንስ መና</para>
  <para style="toc3">መና</para>
  <para style="mt">የዮሐንስ መና</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የዮሐንስ መና የጣፈዪ ክርስቲያኖች ኢየሱስ ክርስቶስ ጔታሕኖ ወሕነሑ በወምነሕኖ መሳ ስደት መከራም ሰላቦ በነበረ ግዝየው። የጠሐፊዪ ዋና ትኩረት ያነቦዪ ተስፋሕኖ ሙላ ይኸንኸም የዋብርታታ በሰላቦም ስደት መከራም ውስጥ በእምነተሕኖ ይጠኖኸም የዋድፋፍሩ።</para>
  <para style="ip">የመጽሐፊ አብዛኛዪ ክፍል ብዛት ያነኖም ተከታታይ የኸኖ መና የጠበጠው፤ መናዪም በዛ ዘበን የነበሮ ምእመናን ያግዞዮዬ ይችሎ፥ የንጐዲም ወባጀ ኸኖም ዬክሶ በሥዕል ቢመስር ወዘንግ የቀረቦኖ። የመዝሙር አዝማች ይድጋገሞኸማት የዚም መጽሐፍ ርዕሶች በትልያዮ መና መሳ በትልያየ መልክ ተድጋገሞም ቀረቦም። የመጽሐፊ አተረጓጐም የትልያየ አሳብ ያነ ቢኸንም ዋናዪ አሳብ የትገለጠው፤ ዚም እዝጌር፥ በጔታ በክርስቶስ ኤማ ቤደገም ሐለት የቁናጌ የመጨረሻም ግዝየ ሼጣን ደበረም የመሶሑም እንም ውራግ ይሠላን፤ ውራጊም በጥናቀቀ ግዝየ ታማኞች የኸኖዪ ጐሣሑ የገደር ሰሜ የገደር አፈርም በረካ ያወርሶ ይቡኒው።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="REV 1:1-8">1፥1-8</ref></char></para>
  <para style="io1">የመናዪ መክፈቻ ተሰበቲ አብያተ ክርስቲያኔ የትላከ መልክት <char style="ior"><ref loc="REV 1:9-3:22">1፥9—3፥22</ref> </char></para>
  <para style="io1">መጽሐፊ ሰበቲም ማተብ <char style="ior"><ref loc="REV 4:1-8:1">4፥1—8፥1</ref> </char></para>
  <para style="io1">ሰበቲ መለከት <char style="ior"><ref loc="REV 8:2-11:19">8፥2—11፥19</ref> </char></para>
  <para style="io1">ዘንዶዪ ዄቲም እንሰሳ <char style="ior"><ref loc="REV 12:1-13:18">12፥1—13፥18</ref> </char></para>
  <para style="io1">የትልያዮ መና <char style="ior"><ref loc="REV 14:1-15:8">14፥1—15፥8</ref> </char></para>
  <para style="io1">ሰበቲ የእዝጌር የማት ጥወ <char style="ior"><ref loc="REV 16:1-21">16፥1-21</ref> </char></para>
  <para style="io1">የባቢሎን ጥፋት፥ የአውሬዪ፥ የባጢለተኘዪ ነብይ የዳቡሎስም ወትቂም <char style="ior"><ref loc="REV 17:1-20:10">17፥1—20፥10</ref> </char></para>
  <para style="io1">የመጨረሻ ፍርድ <char style="ior"><ref loc="REV 20:11-15">20፥11-15</ref> </char></para>
  <para style="io1">ገደር ሰሜ፥ ገደር አፈር፥ ገደሪ ኢየሩሳሌም <char style="ior"><ref loc="REV 21:1-22:5">21፥1—22፥5</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="REV 22:6-21">22፥6-21</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />ዚ መና በቁርብ ግዝየ ውስጥ ይኸኖ ዘንጋ የአገልጋዮቸሑ ያቴዥኖኸም እዝጌር የኢየሱስ ክርስቶስ ያᎄኒው፤ ኢየሱስ ክርስቶስ የመላካዪ ላኸም የአገልጋዪ የዮሐንስ ዚ መና ጐለጠነ። <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />ዮሐንስም ስለእዝጌር ቃል ኢየሱስ ክርስቶስም ምስክርነት ዛምኸም ያዠኒ ዘንጋ እንም ምሰከረ። <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />ዚ እንም ይትፌጠምወ ግዝየ ቁርብ ስለኸነ ዚ የትምቢት ቃል ያነብ የትባረከው! ዛምኸም የትምቢቲ ቃል ይሰሞዪም በትምቢቲም ውስጥ የጣፈዪ ይፌጥሞ የትባረኮኖ።<verse eid="REV 1:3" /></para>
  <para style="s1">ሰላምታ ተውዳሴም</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5" />ተዮሐንስ የትላኸ መልክት የሰበቲ የእስያ አብያተ ክርስቲያን ታነዪ፥ ተነበረዪ፥ ቲቸኚም፥ በዙፋኒ ኢፍት ታኖዪ ተሰበቲ መናፍስት<note caller="+" style="f"><char style="fr" closed="false">1፥5 </char><char style="fqa" closed="false">ሰበት ዕጥፍ መንፈስ</char></note>፥ ዛምኸም ተሞት በወተንሣ በሕር ተኸነዪ ያፈር ነገሥታት ገዢ፥ ታማኝ ምስክር ተኸነዪ፥ ቲወጅጂ በደመሑም ተአጢያተና ነጣ ባወጣነ ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<note caller="-" style="x"><char style="xo" closed="false">1፥4-5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ዘፀ. 3፥14</ref>፤ <ref loc="REV 4:5">መና 4፥5</ref>፤ <ref loc="ISA 55:4">ኢሳ. 55፥4</ref>፤ <ref loc="PSA 89:27">መዝ. 89፥27</ref>። </char></note> <verse eid="REV 1:4-5" /><verse number="6" style="v" sid="REV 1:6" />የኢየሱስ ክርስቶስ አባ እዝጌር አግለግልነኸም ንጉሦች ካሕናትም የሸከተነ፥ የኢየሱስ ክርስቶስ ክብር ቆትም ተዘላለም ዘላለም ስን የሕን! አሜን።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ዘፀ. 19፥6</ref>፤ <ref loc="REV 5:10">መና 5፥10</ref>። </char></note><verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />ዘ በዳበና ይቸኝ፤ የወጎይ ሰቦች ቴይቀሮ ሰብ እንም ያዥን፤ ያፈር ሕዝብ እንም በሑቲ መሳ<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="ft" closed="false">በአጢያተሕኖ በበደለሕኖ የትነሳ ሑቲ ያሰላቦዬ ስላነዪ ማቱ። </char></note> ይበሖ ዚ ዘንጋ የኢኑ፤ አሜን።<note caller="-" style="x"><char style="xo" closed="false">1፥7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="MAT 24:30">ማቴ. 24፥30</ref>፤ <ref loc="MRK 13:26">ማር. 13፥26</ref>፤ <ref loc="LUK 21:27">ሉቃ. 21፥27</ref>፤ <ref loc="1TH 4:17">1 ተሰ. 4፥17</ref>፤ <ref loc="ZEC 12:10">ዘካ. 12፥10</ref>፤ <ref loc="JHN 19:34">ዮሐ. 19፥34</ref>፣<ref loc="JHN 19:37">37</ref>። </char></note><verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />ያነዪ፥ የነበረዪ፥ ይቸኚም ይንም ይችል ጔታ እዝጌር “አልፋ ዖሜጋም፥<note caller="+" style="f"><char style="fr" closed="false">1፥8 </char><char style="ft" closed="false">አልፋ ዖሜጋም ወበር የመጀመሪያዪ የመጨረሻዪም እያት ንኩ! ወበሩ። </char></note> እያትንኩ!” ይብር።<note caller="-" style="x"><char style="xo" closed="false">1፥8 </char><char style="xt" closed="false"><ref loc="REV 22:13">መና 22፥13</ref>፤ <ref loc="EXO 3:14">ዘፀ. 3፥14</ref>። </char></note><verse eid="REV 1:8" /></para>
  <para style="s1">የክርስቶስ በመና መገለጥ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />በኢየሱስ ክርስቶስ የመከራሑ የመንግሥተሑም ዛምኸም የትዕግሥተሑ ታሑጌ ኧሰድ የኸንኩ እያ ጐቤያሑ ዮሐንስ በእዝጌር ቃል በኢየሱስ ምስክርነት መሳ ኧጉጀኘ ኸንኩ ፍጥሞ ቢቡሪዪ ደሴት ባነሑ፤ <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />በጔታ ከነ በመንፈስ ባነሑ፤ የመለከት ጣምባ ይመስር ወደል ጣምባ ባንቌኛዬ ሰማሑ፤ <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />ጣምባዪም፤ “ታዥኒ በጥበለለዪ መጽሐፍ ጣፈም በኤፌሶን፥ በሰምርኔስ፥ በጴርጋሞን፥ በትያጥሮን፥ በሰርዴስ፥ በፊልደልፍያ በሎዶቅያም ተሰበቲ አብያተ ክርስቲያናቴ ላሕ።” ባረ።<verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />ሟ የዝነጌኸም የወሐር ታንቌዬ ዞር ባሑ፤ ዞር በባሑ ግዝየም ሰበት የወርቅ መቅረዝ አዠሑ፤ <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />በመቅረዞቺ ግብት የሰብ ትኸ ይመስሪ አዠሑ፤ ሑቲ ኧግረሑ ስን ይሰላ ገሊፍ ልባስ የለበሰ፥ ደረተሑ በወርቅ ቢታጐጅᎄ የታገደ ባነ።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>፤ <ref loc="DAN 10:5">10፥5</ref>። </char></note> <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />ጉነነሑ የጉነነሑ ጉነንም በረድ ይመስር የነጨ ኧጤ ድገር ይመስር ባነ፤ ዔነውታንም የሳት ነበልባል ባኖ፤<note caller="-" style="x"><char style="xo" closed="false">1፥14-15 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳን. 7፥9</ref>፤ <ref loc="DAN 10:6">10፥6</ref>። </char></note> <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />ኧግሮቸሑም በሳት ፌም ውስጥ ዀኔም የጋለ ብረትኸም ይመስሮ ባነ፤ ጣምባሑም የወደል የፏፏቴ ኧጋ ጣምባኸም ባነ፤<note caller="-" style="x"><char style="xo" closed="false">1፥15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፥24</ref>፤ <ref loc="EZK 43:2">43፥2</ref>። </char></note> <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />በከነ ኧጀሑ ሰበት ኰኰብ ጠበጠም ባነ፤ በዄት አዘር ስለት ያነን ሰይፍ ባፈሑ ይወጣ ባነ፤ ኢፍተሑም በሙላ ወድምቀሑ ያበራ ጬትኸም ባነ። <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" />ባዠሑን ግዝየ የᎀተ ሰብኸም ኸንኩም በግረሑ ተት ወጠቅኩ፤ ሑቲም ከነ ኧጀሑ በᎈረኛ ጫነም እኪ ባሬ፤ “አትገና፤ አልፋ ዖሜጋም እያትንኩ፤<note caller="-" style="x"><char style="xo" closed="false">1፥17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፥6</ref>፤ <ref loc="ISA 48:12">48፥12</ref>፤ <ref loc="REV 2:8">መና 2፥8</ref>፤ <ref loc="REV 22:13">22፥13</ref>። </char></note> <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />እያም ሕያውንኩ፤ ᎀትኩም ባነ፤ ቢኸንም ዘ፥ የዘላለም ሕያውንኩ፤ የሞት የሲኦልም ቁልፍ በጀኛው። <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />ኧጌሽ ያዠዀኒ፥ ኧሗ ያነዪ ባንቌ ይቸኚም ጣፍ። <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />በከነ ኧጀኛ ያዠኸኖ የሰበቲ ኰኰብ የሰበቲም የወርቅ መቅረዝ ምሥጢር ዚቱ፤ ሰበቲ ኰኰብ የሰበቲ አብያተ ክርስቲያን መላይካኖ፤ ሰበቲ መቅረዝም ሰበት አብያተ ክርስቲያናትኖ።”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s1">(1) በኤፌሶን ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />የኤፌሶን ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፦</para>
  <para style="p" vid="REV 2:1">“ዚ ሰበቲ ኰኰብ በከነ ኧጀሑ በጠᎄጠኒ በሰበቲ የወርቅ መቅረዝም ግብት ይዥባበሪ እኪ ይብር፤ <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />ሜናኸ፥ ቂጭናኸ ትዕግሥታኸ ኧሒር፤ ቡሼዎቺም ትፈርኮዬ ያንቻልከኸም፥ ሐዋርያት ቴይኸኖ ሐዋርያትንነ ይብሮዪ ምረመርከም ባጢለተኞች ኸኖም የረከብከኖኸም ኧሒር። <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />በትዕግሥት ወጥናሐም የሽመኛም ታትስላች መከራ ወቀበራኸም ኧሒር፤ <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />ቢኸንም ቁና ኧነቅፍብከ ዘንጋ ነኔ፤ ዚም የድረ ፍቅራኸ ገፈርከም፤ <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />ኧጌሽ ቤቴ የወጠቅከኸም አስብ፤ ንስሐም ግባም ድረ ትሸኩቺ የነበረዪ ቃር ሰክት፤ ንስሐም ባንገባኸ፤ ቸኘሑም መቅረዛኸ በመደሪ ኧወስድብከ። <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />ቢኸንም ፈያ ቃር ነነናኸ፤ እያ ኧጠላኒ የኒቆላውያንም ሜና አኸም ጠላኸም።<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />“መንፈስ የአብያተ ክርስቲያን ይዝነጊኒ፤ እንዝን ያነን የስማ! ‘ውራግ ይነሣ በእዝጌር ገነት ውስጥ ባነዪ ተሕይወት ኧጨ ፍርየ ይበራኸም ኧሸኩች።’<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ዘፍ. 2፥9</ref>፤ <ref loc="REV 22:2">መና 22፥2</ref>፤ <ref loc="EZK 28:13">ሕዝ. 28፥13</ref>፤ <ref loc="EZK 31:8">31፥8</ref>። </char></note><verse eid="REV 2:7" /></para>
  <para style="s1">(2) በሰምርኔስ ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />“የሰምርኔስ ያነዪ ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፤<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፥6</ref>፤ <ref loc="ISA 48:12">48፥12</ref>፤ <ref loc="REV 1:17">መና 1፥17</ref>፤ <ref loc="REV 22:13">22፥13</ref>። </char></note></para>
  <para style="p" vid="REV 2:8">“አልፋ ዖሜጋም፤ ᎀተም የነበረዪ ሕያው የኸነዪም እኪ ይብር፤ <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />መከራኸ ዜግነታኸም ኧሒር፤ የሕን አንኸንም ዱሬሻንከ፤ አይሑድ ቴኸኖ አይሑድንነ ቲብሮ ሽማኸ ያጠፎዪ ኧሒር፤ ሕኖም የሼጣን ማመርተኘኖ። <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />ይሰላብከዬ ያነዪ መከራ አትገና። ዘ፤ ዳቡሎስ ይፌትንኩዬ አትባታሑ ተወሕኔ ቤቴ ይኸራሑ፤ ዐሥር ከነም መከራ ትቌበሮ፤ ትᎀት ስን ታማኝ ሕን፤ እያም የሕይወታኸ አክሊል ኢብከ።<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />“መንፈስ የአብያተ ክርስቲያን ይቡኒ እንዝን ያነን የስማ!</para>
  <para style="p" vid="REV 2:11">“ውራግ ይነሣ በዄታለኘዪ ሞት ስርም ኤይትጎዳ።”<note caller="-" style="x"><char style="xo" closed="false">2፥11 </char><char style="xt" closed="false"><ref loc="REV 20:14">መና 20፥14</ref>፤ <ref loc="REV 21:8">21፥8</ref>። </char></note><verse eid="REV 2:11" /></para>
  <para style="s1">(3) በጴርጋሞን ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />የጴርጋሞን ያነዪ ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፤</para>
  <para style="p" vid="REV 2:12">ዚ፥ በዄት አዘር ያᎄሌ ስለታም ሰይፍ ያነኒ እኪ ይብር፤ <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />የሼጣን ዙፋን ባነወ ትነብርኸም ኧሒር፤ የሕን አንኸንም ሽመኛ አጠበቅከም ጠበጥከም። ሼጣን ቢነብርወ ባሑ ከተማ የቈጠሪዪ ታማኚ ምስክረኛ አንቲጳስ በነበረወ ዘበን፤ ቢያ ያነናኸ እምነት አለጋኸ። <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />ቢኸንም ኧነቅፍብከ ቀል ዘንጋ ነኔ፤ የእስራኤል ዴንጋ የጣዖት ያረጂ ስንቅ ይበሮኸም ይሟግጦኸም ቢፍተሕኖ ቈፋ ያወናዬ የባላቅ ያትᎀረኒ የበለዓም ትምርት ይትዄተሎ አታት ሰቦች በግብተሕኖ ነኖ፤<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">ዘሑ. 22፥5</ref>፤ <ref loc="NUM 7">7</ref>፤ <ref loc="NUM 31:16">31፥16</ref>፤ <ref loc="DEU 23:4">ዘዳ. 23፥4</ref>፤ <ref loc="NUM 25:1-3">ዘሑ. 25፥1-3</ref>። </char></note> <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />የኒቆላውያንም ትምርት ይትዄተሎ ሰቦችም ባኸዬ ነኖ፤ <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />ስለኸነም ንስሐ ግባ፤ ባንከነ ከሞ ኧቸኝብከ፤ ባፈኛም ሰይፍ ኧትዋጋኖ።<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />መንፈስ የአብያተ ክርስቲያናት ይዝነጊኒ እንዝን ያነን የስማ! ውራግ ይሰላዪ በሼተረዪ መና<note caller="+" style="f"><char style="fr" closed="false">2፥17 </char><char style="ft" closed="false">መና ወበር በሰሜ የወረደ የመላይካ ስንቅ ወበሩ። </char></note> ኢቡ፤ ኧሗም ቢቄᎄሪ ሰብ አንኸንም ሟንም ኤይሒኒ ገደር ሽም የጣፈወዪ ነጨ እምን ኢቡ።<note caller="-" style="x"><char style="xo" closed="false">2፥17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ዘፀ. 16፥14-15</ref>፤ <ref loc="EXO 16:33-34">16፥33-34</ref>፤ <ref loc="JHN 6:48-50">ዮሐ. 6፥48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፥2</ref>፤ <ref loc="ISA 65:15">ኢሳ. 65፥15</ref>። </char></note><verse eid="REV 2:17" /></para>
  <para style="s1">(4) በትያጥሮን ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />የትያጥሮን ያነዪ ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፦</para>
  <para style="p" vid="REV 2:18">የሳት ወላፈንኸም የኸኖ ዔን በሳት ቀለጠም የነጠረ የናስ ብረት ይመስሮ ኧግር ያኖይ የእዝጌር ትኸ እኪ ይብር፤ <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />ሜናኸ፥ ፍቅራኸ፥ እምነታኸ፥ አገልግሎታኸም ትዕግሥታኸም ኧሒር፤ ኧሗም ተመጀመሪያዪ ሜናኸ የጠቀለ የሗዪ ይበዛኸም ኧሒር። <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />የሕን አንኸንም ኧነቅፍብከ ዘንጋ ነኔ፤ ነብይንኩ ትብሪ ምሽት የኤልዛቤል በጭ አበኘኸናም፤ ሒቲ አገልጋዮቸኛ ይሟግጦኸም የጣዖት ያረጂ ስንቅ ይበሮኸም በትምርቴታን ታሰሰቶ።<note caller="-" style="x"><char style="xo" closed="false">2፥20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 ነገ. 16፥31</ref>፤ <ref loc="2KI 9:22">2 ነገ. 9፥22</ref>፣<ref loc="2KI 9:30">30</ref>። </char></note> <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />ተዝሙቴታን ንስሐ ትገባኸም ግዝየ አብኩናም ባነ፤ ሒቲም ፈአደኘ አንከነች። <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />ስለኸነም በመከራ አልጋ ᎈር አድጋ፤ ተሒቲጌ ያምነዝሮዪ፤ ቴማዬታን ንስሐ ባንገቦ፤ የብረታ ስቃይ አቸኝቦ፤ <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />ዴንጋዬታንም በሞት ኧቀጣኖ፤ በዛም አብያተ ክርስቲያንም እንም እያ ሒን አሳብም ኧምረምር ወሕነኛ ይትሬዶ፤ አትባተሑም የሜናሑኸም እከፍልሑ።<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />ትምርቴታን ያንትኸተልኩም የሼጣንም ጥልቅ ምስጢሩ ይቡሪ ያንትቀበርኩ፣ በትያጥሮን የቀኘሑዪ ያሑም ዚ ኧብር፤ ባሑ ᎈር ጡዋራ አንጨንብኩ፤ <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />እያ ኧቸኝ ስን ያነናሑዪ አጥብቆም ጥብጦ። <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />ውራግ ይነሣ ሜናኛም መጨረሻ ስን ይፌጥም በአሕዛብ ᎈር ሥልጣን ኢቡ፤ ሑቲም፦ <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />በብረት እንጣር ይገዛኖ፤ የሸክላ ግብርኸም ይፈጭኖ፤ ዚም ልክ እያ በአባኛዬ ሥልጣን የቌበርኩኸሙ፤ <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />እያም የዛኘት ኰኰብ ኢቡ።<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />መንፈስ የአብያተ ክርስቲያናት ይዝነጊኒ እንዝን ያነን የስማ።<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s1">(5) በሰርዴስ ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />በሰርዴስ ያነዪ ቤተ ክርስቲያን መላይካ<note caller="+" style="f"><char style="fr" closed="false">3፥1 </char><char style="fqa" closed="false">መልክተኘ</char></note> እኪ በርም ጣፍ፤</para>
  <para style="p" vid="REV 3:1">ሰበቲ የእዝጌር መናፍስት<note caller="+" style="f"><char style="fr" closed="false">3፥1 </char><char style="fqa" closed="false">ሰበት ዕጥፍ መንፈስ</char></note> ሰበቲ ኰኰቦች በጀሑ የጠበጠዪ እኪ ይብር፤ ሜናኸ ኧሒር፤ በሽም ሕያውንከ፤ ቢኸንም ᎀትከም። <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />ስለኸነም ንቃ፤ ይᎀቴ የትቃረበዪ የቀኘዪ ቃር አጥና፤ ሜናኸ በአምላከኛ ኢፍት ፍጡም ኸነም አረኸብኩን። <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" />ኧጌሽ የቌᎄርዀኒ የሰሟሗኒም አስታውስ፤ ታዘዥም፤ ንስሐም ግባ። ባትነቃም የሌባኸም ኧቸኝብከ፤ ቤቲዋኘ ሰዓት ኧቸኝብከኸም አትሒር።<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቴ. 24፥43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ. 12፥39-40</ref>፤ <ref loc="REV 16:15">መና 16፥15</ref>። </char></note> <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />ቢኸንም ልባሰሕኖ ያናርከሶ ቀል ሰቦች በሰርዴስ ታኸጌ ነኖ፤ ሕኖም ነጨ ልባስ ለበሶም ቲያጌ ያሮ፤ መሳሑም ዚ የሕኖ ይጌባኖኖ። <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" />ውራግ ይነሣም የሕኖኸም ነጨ ልባስ ይለብስ፤ እያም በአባኛ በመላይካዪም ኢፍት ኧምሰኩርነ፤ ሽመሑም ተሕይወት መጽሐፍ አንድመስስ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="EXO 32:32-33">ዘፀ. 32፥32-33</ref>፤ <ref loc="PSA 69:28">መዝ. 69፥28</ref>፤ <ref loc="REV 20:12">መና 20፥12</ref>፤ <ref loc="MAT 10:32">ማቴ. 10፥32</ref>። </char></note><verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />መንፈስ የአብያተ ክርስቲያናት ይዝነጊኒ እንዝን ያነን የስማ።<verse eid="REV 3:6" /></para>
  <para style="s1">(6) በፊላድልፍያ ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />የፊልደልፍያ ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፤</para>
  <para style="p" vid="REV 3:7">ቅዱሲ የኢነተኘ የኸነዪ፤ የዳዊትም ይከፉችᎄ በጀሑ የጠበጠዪ እኪ ይብር፤ ሑቲ የከᎈተኒ ሟንም ይዘጓኔ ኤይችል፤ የዘጓኒም ሟንም ይከፉቼ ኤይችል።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ. 22፥22</ref>፤ <ref loc="JOB 12:14">ኢዮብ 12፥14</ref>። </char></note> <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />ሜናኸ ኧሒር፤ ዘ፥ ሟንም ይዘጓኔ ኤይችሊ የትከፈተ በር ቢፍታኸ ሸከትኩም፤ ቆታሐ ቀል ወሕነሑ ኧሒር፤ ቢኸንም ቃለኛ ቂየኸም፤ ሽመኛም አለጋኸ።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="ISA 49:23">ኢሳ. 49፥23</ref>፤ <ref loc="ISA 60:14">60፥14</ref>፤ <ref loc="ISA 43:4">43፥4</ref>። </char></note> <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />ዘ፥ አታቶች አይሑድ ቴይኸኖ አይሑድንነ ይብሮዪ፣ ይዋሾዪ፣ ተሼጣን ማመር የኸኖዪ ታኸዬ ይቸኖኸም በግራኸ ተት ይሰግዶኸም፣ እያ የወደደከኸኸም ይሒሮኸም ኧሸክት። <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />በትግሥት ትጠናኸም ያበከኸዪም ትዛዘኛ የቅየኸ ስለኸነ፣ እያም ኧሗ ባፈር ᎈር ይነብሮዪ ይፌትኖዬ በዓለም እንም ᎈር ቲቸኚ የፈተና ሰዓት ኧቅየኸ። <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />ከሞ ኧቸኝ፤ ሟንም አክሊላኸ ኤወስድብከኸም ያነናኸ አጥብቅም ጥብጥ። <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" />ውራግ ይነሣዪ በአምላከኛ ቤተ መቅደስ ውስጥ ችባን ኧሸኩች፤ በዛም ስርም ኤይወጣ። የአምላከኛ ሽም የአምላከኛ ከተማ ሽም ዚም በአምላከኛዬ ይወርዲ የገደሪ ኢየሩሳሌም ሽም በሑቲ ᎈር ኧጠፉ፤ ገደሪ ሽመኛ በሑቲ ᎈር ኧጠፉ።<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="REV 21:2">መና 21፥2</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፥2</ref>፤ <ref loc="ISA 65:15">65፥15</ref>። </char></note><verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />መንፈስ የአብያተ ክርስቲያናት ይዝነጊኒ እንዝን ያነን የስማ።<verse eid="REV 3:13" /></para>
  <para style="s1">(7) በሎዶቅያ ያነዪ ቤተ ክርስቲያን የትላኸ መልክት</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />የሎዶቅያ ያነዪ ቤተ ክርስቲያን መላይካ እኪ በርም ጣፍ፦</para>
  <para style="p" vid="REV 3:14">አሜን የኸነዪ፣ ኧሗም ታማኝ የኢነተኘ ምስክር የኸነዪ፣ የእዝጌርም ኸልቀት ገዢ የኸነዪ እኪ ይብር፤<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="JDG 8:22">መሳ. 8፥22</ref>። </char></note> <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />ቀዝቃዛ ፉላም ያንከንከኸም ሜናኸ ኧሒር፤ ቀዝቃዛ ፉላም ብትኸን ኧወድ ባነ። <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />ኧጌሽ ለብ የባኸ ጠለለ ቴይኸን ፉላ ቀዝቃዛም ያንከንከዬ ታፈኛ አወጣሑም ኧተፋኸዬው። <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />እያ ዱሬሻንኩ፤ ደንገኘንኩ አትም ኤያሼ ትብር፤ ቢኸንም ጐስቋላ፣ ምስኪን፣ ዜጋ፣ ወዥ ኤይችል፤ እንጫኸ ወሕናኸ አትሒር <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />ስለኸነም ዱሬሻ ትኸንኸም፣ በሳት የነጠረ ወርቅ ትስየኸም፣ ይንጭነታኸ ማል ኤታዥኸም፣ ነጨ ልባስ ትለብስኸም ወዥ ትችልኸም የዔናኸ ጭዛ ስየኸም ትቀባኸም ኧመክርኸ። <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" />እያ ኧወድዶዪ ኧጔስጭ፤ ኧቀጣ። ስለኸነም ተጋደል፤ ንስሐም ግባ፤<note caller="-" style="x"><char style="xo" closed="false">3፥19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">ምሳ. 3፥12</ref>፤ <ref loc="HEB 12:6">ዕብ. 12፥6</ref>። </char></note> <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />ዘ፤ በወረጀ ቈምኩም ኧቅበቅብ፤ ሟንም ጣምባኛ ሰማም ወዝገበሑ ቢከፍትኒ ተሑቲዬ ኧገባም ተሑቲጌ ኧበራ፤ ሑቲም ቲያጌ ይበራ፤ <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />እያ ውራግ ነሣሑም ተአባኛጌ በሑቲ ዙፋን ᎈር የቾናሑኸም ውራግ ይነሣዪም ቲያጌ በዙፋነኛ ᎈር ይቾናኸም ኧሸኩች።<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />መንፈስ የአብያተ ክርስቲያናት ይዝነጊኒ እንዝን ያነን የስማ።<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s1">በሰሜ ያነዪ ዙፋን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />ተዚ አንቌ ዘ በሰሜ የትከፈተ በር አዠሑ፤ በደረም የመለከትኸም ቲዝነጌ የሰማሑን ጣምባ፣ “ተዚዬ ኔኸ፤ ተዛም አንቌ ይኸኔ ይጌቧኒ ቃር አቴዠኸ” ባረ <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />እያም በመንፈስ ባነሑ፤ ዘ፤ በሰሜ የቾና ዙፋን አዠሑ፤ በዙፋኒም ᎈር የቾና ሰብ ባነ። <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />ቾናም የነበረዪ የኢያስጲድ የሰርዲኖንም የከበሮ እምን ይመስሮ ባነ። የመረግድ የከበረ እምን ይመስር ቀስተ ዳበናም ዙፋኒ ኸᎄᎄንም ባነ። <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />በዙፋኒ ዙሪያ እንጐድ ሑያ አርበት ዙፋን ባኖ፤ በሕኖም ᎈር ነጨ ልባስ የለበሶ በጉነነሕኖም ᎈር የወርቅ አክሊል የደፎ ሑያ አርበት ባሊቅ ቾኖም ባነ። <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" />ተዙፋኒም ብራቅ ጣምባም፣ ኢንጊብጊቢትም ወጣ፤ በዙፋኒ ኢፍት ሰበት መብራት ይበሮ ባነ፤ ነዚም ሰበቲ የእዝጌር መናፍስትኖ<note caller="+" style="f"><char style="fr" closed="false">4፥5 </char><char style="fqa" closed="false">ሰበት ዕጥፍ መንፈስ</char></note>።<verse eid="REV 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 4:6" />ኧሗም በዙፋኒ ኢፍት የመስታወትኸም የጣራ ያምንብራጣ ባርኸም ባነ፤ በዙፋኒ ግብት፤ በዙሪያሑም ቢፍቴዬ ታንቌዬም አዘር ቤን የትᎀሎ አርበት ሕያው ሕዝብ ባኖ። <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />የመጀመሪያዪ ሕያው ሕዝብ አንበሳ፣ ዄታለኘዪ ቦራ ይመስሮ ባነ፤ ሦስታለኘዪ የሰብ ኢፍት ይመስር ኢፍት ቧነን፤ አርበታለኘዪ ኧሗም ይበር ንስር ይመስር ባነ። <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />አርበቲም ሕያዋን ሕዝብ እያታተሕኖ ስድስት ስድስት ካንፋ ባነኖ፤ በዙሪያሕኖ በውስጠሕኖም ቤን የትᎀሎ ባኖ፤ ክናን ተምሳር፦</para>
  <para style="q1" vid="REV 4:8">“ቅዱስ፣ ቅዱስ፣ ቅዱስ፣</para>
  <para style="q2" vid="REV 4:8">የነበረዪ፣ ያነዪም ይቸኚ፤</para>
  <para style="q2" vid="REV 4:8">እንም ይቸል ጔታ አምላክ”</para>
  <para style="m" vid="REV 4:8">ወበር ኤያቋርጦ።<verse eid="REV 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="REV 4:9" />ሕያዋን ኸልቀት በዙፋኒ ᎈር የቾናዪም ተዘላለም ዘላለም ስን ሕያው ኸነም ይነብሪ ክብር፣ ሞገስ ምስጋና ቢይቦᎄም ግዝየ፣ <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />ሑያ አርበቲ ባሊቅ በዙፋኒ ᎈር በቾናዪ ኢፍት ወጠቆም፣ ተዘላለም ዘላለም ስን ሕያው ኸነም ይነብሪ ይሰግዶ ባነ፤ አክሊለሕኖም በዙፋኒ ኢፍት አወኖም እኪ ይብሮ፤<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“ጔታና አምላከና፤</para>
  <para style="q2" vid="REV 4:11">ክብር ሞገስም፣ ቆትም ትቌበሬ ይጌባኸ፤ መሳሑም</para>
  <para style="q1" vid="REV 4:11">አኸ ይንም ኸለቅከም፤</para>
  <para style="q2" vid="REV 4:11">በፈአዳኸም የትኸለቆም፤</para>
  <para style="q2" vid="REV 4:11">ኸኖምም።”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s1">ጥቅልል መጽሐፊ ኧጤዪም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />በዙፋኒ ᎈር በቾናዪ በውስጥ በውጪም አዘር የጣፈወ፣ በሰበት ማተብ የቴሸገ ጥቅልል መጽሐፍ በከነ ኧጀሑ ጠበጠም አዠሑ፤<note caller="-" style="x"><char style="xo" closed="false">5፥1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">ሕዝ. 2፥9-10</ref>፤ <ref loc="ISA 29:11">ኢሳ. 29፥11</ref>። </char></note><verse eid="REV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 5:2" />አት የብረታ መላይካ በወደል ጣምባ፣ “ማተቦቺ የወፍታ መጽሐፊም የወክፍት የትጌቧን ሟኒ?” ባረም ቲዬውጅ አዠሑ። <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />ቢኸንም በሰሜም ኸነ ባፈር፣ ተአፈርም ተት መጽሐፊ የወክፍት ወይ ገለጠም የወትመልከት ይችል ሟንም አነበረ። <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />የጎጋዪ ጥቅል መጽሐፍ ወክፍትም ውስጠሑ ወመልከት ይጌቧን ያንትረኸበ ስለኸነ ስርም በኴሑ፤ <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />በዛ ግዝየ ተባሊቆቺ አቲ፣ “አትብክ፤ ዘ፤ ተይሑዳ ነገድ የኸነዪ ተዳዊት የጨኘት ዝሬት የትነሣ አንበሳ ውራግ ነሣም፤ ሑቲ የጎጋዪ መጽሐፍ ሰበቲም ማተብ ወክፍት ይችል” ባሬ።<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />በዛም በዙፋኒም ባርበቲ ሒያው ሕዝብ፣ በሽማሌዎችም ግብት ያረጂ ይመስር ኧጤ ቈመም አዠሑ፤ ኧጤዪም ሰበት ቀር ሰበት ዔን ባኖይ፤ ሕኖም ታፈሬ እንም የትላሖዪ ሰበቲ የእዝጌር መናፍስት<note caller="+" style="f"><char style="fr" closed="false">5፥6 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ሰበት ዕጥፍ መንፈስ</char></note> ኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፥7</ref>፤ <ref loc="ZEC 4:10">ዘካ. 4፥10</ref>። </char></note> <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />ሑቲም ቸኘም በዙፋኒ ᎈር በቾናዪ ከነ ኧጅ መጽሐፊ ወሰደን፤ <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />መጽሐፊ በወሰደን ግዝየ አርበቲ ሕያው ሕዝብ ሑያ አርበቲ ባሊቅ በጤዪ ኢፍት በግንባረሕኖ ተደፎ፤ እያታተሕኖ የቅዱሳን ጠሎት የኸኖዪ በገና እጣንም የᎀላወ የወርቅ ግብር ጠበጦም ባነ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">መዝ. 141፥2</ref>። </char></note> <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />እኪም ቲብሮ ገደር መዝሙር ዜመሮ፤</para>
  <para style="q1" vid="REV 5:9">“መጽሐፊ ትወስዴ፣</para>
  <para style="q2" vid="REV 5:9">ማተቦቺም ትፈታዬ የትጌባናኸ ኸንከም፤</para>
  <para style="q1" vid="REV 5:9">መሳመሑ አረጅከም፤</para>
  <para style="q2" vid="REV 5:9">በደማኸም በነገድ እንም፣ በቋንቋ እንም፣</para>
  <para style="q2" vid="REV 5:9">በጐሳ እንም፣ በሕዝብ እንም ሰቦች የእዝጌር ዋጀኸም።<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />የአምላከና መንግሥት</para>
  <para style="q2" vid="REV 5:10">ካሕናት ሸከትከኖም፤</para>
  <para style="q2" vid="REV 5:10">ሕኖም ባፈር ᎈር ይነግሦ።”<note caller="-" style="x"><char style="xo" closed="false">5፥10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ዘፀ. 19፥6</ref>፤ <ref loc="REV 1:6">መና 1፥6</ref>። </char></note><verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />ተዛም ተምሌከትኩ፤ የብዠ መላይካ ጣምባ ሰማሑ፤ ቁጥረሕኖም ሺ ግዝየ ሺም ተቸለፈም ግዝየዪም የቸለፈ ባነ፤ ሕኖም በዙፋነሑ በሕያዋን ኸልቀቲም፣ በባሊቆቺም ዙሪያ ኸበቦም ባነ፤ <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />በወደል ጣምባ እኪ ባሮም ዜመሮ፤</para>
  <para style="q1" vid="REV 5:12">“ያረጂዪ ኧጤ</para>
  <para style="q1" vid="REV 5:12">ቆት ደንገኝነትም፣ ብላት ብርታትም፣</para>
  <para style="q2" vid="REV 5:12">ክብር ሞገስም፣ ምስጋና፣</para>
  <para style="q2" vid="REV 5:12">ይቌበሬ ይትጌቧኒው” ባሮ።<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />ተዛም በሰሜ በአፈርም፣ ታፈር ተት በባርም፣ በሕኖ ውስጥ ያኖ ኸልቀት እንም እኪ ባሮም ቲዜምሮ ሰማሑ፤</para>
  <para style="q1" vid="REV 5:13">“በዙፋኒ ᎈር የቾናዪ የጤዪም፣</para>
  <para style="q2" vid="REV 5:13">ምስጋና ሞገስም፣ ክብር ቆትም፣</para>
  <para style="qc" vid="REV 5:13">ተዘላለም ዘላለም ስን የሕን።”<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />አርበቲ ሕያው ኸልቅም፣ “አሜን” ባሮ፤ ባሊቆቺም በግምባረሕኖ ተደፎም ሰገዶ።<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s1">ማተቦቺ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />ኧጤዪ ተሰበቲ ማተብ የመጀመሪያዪ ቲፈታ አዠሑ፤ በዛም ባርበቲ ሕያው ሕዝብ አቲ፣ እንግብጊቢት ቢመስር ጣምባ “ኔኸ!” ቲብር ሰማሑ። <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />እያም ተምሌከትኩ፤ ዘ፤ ነጨ ፈረዝ ቈመም ባነ፤ ቾናወም የነበረዪ ቀስት ጠበጠም ባነ፤ አክሊልም አᎅ፤ ሑቲም ውራግ ይነሣኸም ውራግ የወንሣ ወጣ።<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />ኧጤዪ ዄታለኘዪ ማተብ በፈታ ግዝየ፣ ዄታለኘዪ ሕያው ሕዝብ፣ “ኔኸ!” ቲብር ሰማሑ። <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />እንጐድ ፌም ይመስር ብሻ ፈረዝም ወጣ፤ ቾናወም የነበረዪ ሰላም ባፈር ᎈር ይወስድኸም ሰቦችም ነብስ በነብሰሕኖ ይትቃጠሮኸም የወሰክት ሥልጣን አᎅ፤ ወደልም ሰይፍ አᎅ።<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />ኧጤዪ ሦስታለኘዪ ማተብ በፈታ ግዝየ፣ ሦስታለኘዪ ሕያው ሕዝብ፣ “ኔኸ!” ቲብር ሰማሑ። እያም ተምሌከትሑ፤ ዘ፤ ጥቁር ፈረዝ ቈመም አዠሑ፤ ቾናወም የነበረዪም በጀሑ ሚዛን ጠበጠም ባነ። <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />ተዛም ባርበቲ ሕያው ሕዝብ ግብት፣ “ግብት ጣሳ ስሬ የአት ከነ ደሞዝ፤ ያት ጣሳ ተግብት ኧሕር ያት ከነ ደሞዝ<note caller="+" style="f"><char style="fr" closed="false">6፥6 </char><char style="ft" closed="false">ግሪኩ </char><char style="fqa" closed="false">አት ዲናር </char><char style="ft" closed="false">ይቡን። </char></note> ዘይት የወይን መጠጥ አትጉዳ” ይብር ጣምባ ሰማሑ።<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />ኧጤዪ አርበታለኘዪ ማተብ በፈታ ግዝየ፣ አርበታለኘዪ ሕያው ሕዝብ፣ “ኔኸ!” ቲብር ሰማሑ። <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />እያም ተምሌከትሑ፤ ዘ፤ ግራጫ ፈረዝ ቈመም አዠሑም፤ ቾናወም የነበረዪ ሽመሑ ሞት ባነ፤ ሲኦልም ባንቌ ይትዄተል ባነ። ሕኖም በሰይፍ፣ በጋጀ፣ በመቅሠፍት ባፈር የድብር አውሬም ይቀጥሮኸም ባፈር አት አርበታለኘ ᎈር ሥልጣን አቡዮ።<verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />አምስታለኘዪ ማተብም በፈታ ግዝየ፣ ስለእዝጌር ቃል ስለቅሮዪም ምስክርነት ያረጅዮዪ ሰቦች ነብስ ቢያርጅᎄዪ ተት አዠሑ። <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />ሕኖም በወደል ጣምባ፣ “ይንም ትገዛ ቅዱስ የኢነተኘ ጔታም፤ መቸ ስኑ አትፈርድ? መቸ ስን ስለፈሰሰዪ ደመና ባፈር ቢነብሮዪ ᎈር አትቤቀል?” ባሮ። <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />ተዛም አትባተሕኖ ነጨ ልባስ አቡዮ፤ ቲፍቴዬ የሕኖኸም ይቈጥርዮ የአገልጋይ ደቦሕኖ ጐባቢተሕኖም ቁጥር ይᎀላ ስን ቀል ግዝየ ይፈርኮኸም ኤወጅዮ።<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />ስድስታለኘዪም ማተብ ቲፈታ ተምሌከትሑ፤ ወደል የአፈር ወትናወጥ ኸነ፤ ጬትም የማቅኸም ጠቈረ። ጠናቃም በሙላ የደምኸም ቀላ፤ <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />የበለስ ኧጨ በብረታ ኧንፋስ ቲውዛወዝ ያንበሰለዪ ፍርየ በሑቲ ይረግፍኸም፣ የሰሜ ኰኰብ ታፈሬ ረገፎ። <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" />ሰሜ የጥብልል መጽሐፍኸም ተጥበለለም ዐለፈ፤ ቈቶ ደሴቶችም እንም ተመደረሕኖ ጠፎ።<verse eid="REV 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15" />ተዛ አንቌ ያፈር ነገሥታት ገዢዎች፣ ያርብ መኰንኖች፣ ዱሬሾች፣ የብረቶዪ፣ ጉዙዎች ጌቶችም እንም በዋሻዎችም በቈቶዎች ዐለት ውስጥ ተሼሞ፤ <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" />ቈቶዎቺም ዐለቶቺም፣ “በᎈረና ውጠቆ፤ በዙፋኒ ᎈር በቾናዪ ኢፍት በጤዪ ማት ሺሞነ፤ <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />ወደሊ የማተሕኖ ከነ በሕኖ ᎈር ቸኘም፤ ሟሽ ይቈሜ ይችል?” ባሮዮ።<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s1">መቶ አርባ አርበት ሺዪ ወታተመሕኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />ተዛ አንቌ አርበት መላይካ ባርበቲ ያፈር ማእዘን ቈሞም አዠሑ፤ ሕኖም ኧንፋስ ባፈር ወይ በባር፣ ወይ በሟንመሑ ኧጨ ᎈር ኤይነፍስኸም አርበቲ ያፈር ኧንፋስ ጠበጦ። <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />ተዛም የሕያው አምላክ ማተብ የጠበጠ እንጐድ መላይካ በምሥራቅ ቲቸኝ አዠሑ፤ ሑቲም አፈር ባርም የወጉዳ ሥልጣን ያቡዮዪ አርበቲ መላይካ በወደል ጣምባ እኪ ባረኖ፤ <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“በአምላከና አገልጋዮች ግንባር ᎈር ማተብ ኧሸክትነቦ ስን አፈር ባርም፣ ኧጨዎቺ አትጉዶ።” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />የታተሞዪ ቁጥር ሰማሑ፤ ሕኖም በእስራኤል ነገዶች እንም መቶ አርባ አርበት ሺ ባኖ፤ <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />በይሑዳ ነገድ ዐሥረ ዄት ሺ፣ በሮቤል ነገድ ዐሥረ ዄት ሺ፣ በጋድ ነገድ ዐሥረ ዄት ሺ፣ <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />ተአሴር ነገድ ዐሥረ ዄት ሺ፣ በንፍታሌም ነገድ ዐሥረ ዄት ሺ፣ በምናሴ ነገድ ዐሥረ ዄት ሺ፣ <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />ተስምዖን ነገድ ዐሥረ ዄት ሺ፣ ተሌዊ ነገድ ዐሥረ ዄት ሺ፣ ተይሳኮር ነገድ ዐሥረ ዄት ሺ፣ <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />በዛብሎን ነገድ ዐሥረ ዄት ሺ፥ በዮሴፍ ነገድ ዐሥረ ዄት ሺ፥ በብንያም ነገድ ዐሥረ ዄት ሺ ታተሞ።<verse eid="REV 7:8" /></para>
  <para style="s1">ነጨ ልባስ የለበሶ ስርም ብዠ ሕዝብ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />ተዛም አንቌ አዠሑ፤ ዘ፤ በዙፋኒ በጤዪም ኢፍት ሟንም ይቆጥሮዬ ኤይችል የትልያዮ ሕዝብ፣ ተነገድ፤ ተቋንቋም እንም ስርም ብዠ ሕዝብ ቈሞም ባነ፤ ሕኖም ነጨ ልባስ ለበሶም፣ የዘንባባ ቅጠል በጀሕኖ ጠበጦም ባነ። <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />በወደል ጣምባም እኪ ባሮም ዉ ባሮ፤</para>
  <para style="q1" vid="REV 7:10">“የዋትርፍ ሥልጣን በዙፋኒ ᎈር የቾናዪ፣</para>
  <para style="q2" vid="REV 7:10">የአምላከናም የጤዪው።”<verse eid="REV 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="REV 7:11" />መላይካ እንም በዙፋኒ በባሊቆቺም፣ በአርበቲም ሕያው ሕዝብ ዙሪያ ቆሞም ባነ፤ በዙፋኒ ኢፍት በግንባረሕኖ ተደፎም የእዝጌር ሰገዶ፤ <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />እኪም ይብሮ ባነ፤</para>
  <para style="q1" vid="REV 7:12">“አሜን፤</para>
  <para style="q1" vid="REV 7:12">ውዳሴ ክብርም፣</para>
  <para style="q1" vid="REV 7:12">ብላት፣ ምስጋና፣ ሞገስም፣</para>
  <para style="q1" vid="REV 7:12">ቆት ብርታትም፣</para>
  <para style="q1" vid="REV 7:12">ተዘላለም ዘላለም ስን የአምላከና የሕን፤</para>
  <para style="q1" vid="REV 7:12">አሜን።”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ተዛም ተባሊቆቺ አቲ፣ “ነዚ ነጨ ልባስ የለበሶዪ ነሟንኖ? ቤቴሽ ቸኖ?” ባሬ።<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />እያም፣ “ጔታ፤ አኸ ትሒር” ባሑን።</para>
  <para style="p" vid="REV 7:14">ሑቲም እኪ ባሬ፤ ነዚ ተወደሊ መከራ የቸኖኖ፤ ልባሰሕኖም በጤዪ ደም አጠቦም አነጦም።<verse eid="REV 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 7:15" />ስለኸነም፣</para>
  <para style="q1" vid="REV 7:15">“በእዝጌር ዙፋን ኢፍት ኸኖም፣</para>
  <para style="q2" vid="REV 7:15">ክናን ተምሳር በመቅደሲ ያግለግሎይ<note caller="+" style="f"><char style="fr" closed="false">7፥15 </char><char style="ft" closed="false">ያግለግሎይ ወበር ያመልኮይ ወበሩ። </char></note>፤</para>
  <para style="q1" vid="REV 7:15">በዙፋነሑም ᎈር የቾናዪ ድንኳነሑ</para>
  <para style="q2" vid="REV 7:15">በᎈረሕኖ ይዝረጋ፤<verse eid="REV 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16" />ተዛም አንቌ ኤይትገዶ፤</para>
  <para style="q2" vid="REV 7:16">ተዛም አንቌ ኤይጠሞ፤</para>
  <para style="q1" vid="REV 7:16">ጬት ኤወካኖ፤</para>
  <para style="q2" vid="REV 7:16">ሐሩሪም እንም ኤያነድዶ፤<verse eid="REV 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17" />መሳሑም በዙፋኒ ግብት ያነዪ</para>
  <para style="q2" vid="REV 7:17">ኧጤ ወጅመኘሕኖ ይኸን፤</para>
  <para style="q1" vid="REV 7:17">ተሕይወት ኧጋ ምንጬ ይመራኖ፤</para>
  <para style="q2" vid="REV 7:17">እዝጌር ኢንባ እንም ቴነሕኖ ይጠርግኖ።”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s1">የሰበታለኘዪ ማተብ የወርቂም ጋብቻ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />ኧጤዪ ሰበታለኘዪ ማተብ በፈታ ግዝየ፣ ግብት ሰዓት ቅጫ በሰሜ ጭጭታ ኸነ፤ <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />ተዛም በእዝጌር ኢፍት ይቈሞዪ ሰበቲ መላይካ አዠሑ፤ ሰበት መለከትም አቡዮ።<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />እንጐዲ መላዪካ የወርቅ ጋብቻ ጠበጠ ቸኘም ቢያርጅᎄዪ ሜጠቅ ቈመ፤ በዙፋኒ ኢፍት ባነዪ የወርቅ ቢያርጅᎄ ᎈር ተቅዱሳን ጠሎትጌ ያቀርቡኸም ብዠ ዕጣን አᎅ።<note caller="-" style="x"><char style="xo" closed="false">8፥3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">አሞ. 9፥1</ref>፤ <ref loc="EXO 30:1-3">ዘፀ. 30፥1-3</ref>። </char></note> <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />የዕጣኒም ተን ተቅዱሳኒ ጠሎትጌ በመላይካዪ ኧጅ ተእዝጌር ኢፍቴ ወጣ። <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" />መላይካዪም ጋቻዪ ጠበጠም ያርጅᎄዪ ኧሳት ᎀላወም ታፈሬ ኧረጔን፤ እንግብጊቢት፣ ጣምባ፣ ብራቅ የአፈርም ወትናወጥ ኸነ።<note caller="-" style="x"><char style="xo" closed="false">8፥5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">ዘሌ. 16፥12</ref>፤ <ref loc="EZK 10:2">ሕዝ. 10፥2</ref>፤ <ref loc="EXO 19:16">ዘፀ. 19፥16</ref>፤ <ref loc="EXO 16:18">16፥18</ref>። </char></note><verse eid="REV 8:5" /></para>
  <para style="s1">ሰበቲ መለከት</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />ተዛም ሰበቲ መለከት የጠበጦዪ ሰበቲ መላይካ የወንፋ ተዝጋዶ።<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />የመጀመሪያዪ መላይካ መለከቲ ነፋ፤ ደም የቅላቀለወ በረድ ኧሳትም ታፈሬ አደጒ፤ ያፈር አት ሦስታለኘ ነደደ፤ የጨዎችም አት ሦስታለኘ ነደደ፤ የልመለመዪም ሠር እንም ነደደ።<note caller="-" style="x"><char style="xo" closed="false">8፥7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">ዘፀ. 9፥23-25</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፥22</ref>። </char></note><verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />ዄታለኘዪም መላይካ መለከተሑ ነፋ፤ ወደል ቈቶ ይመስር ቃር በሳት ቲነድ ተባሬ አደጒ፤ የባሪ አት ሦስተኛዪ ተደሜ ተሸገረ፤ <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />በባሪም ውስጥ ቲነብሮዪ ሕያዋን ኸልቀት አት ሦስታለኘዪ ᎀተ፤ የመርከቦችም አት ሦስታለኘዪ ጠፋ።<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />ሦስታለኘዪም መላይካ መለከተሑ ነፋ፤ የችቦኸም ይነድ ወደል ኰኰብ በዲየ አት ሦስታለኘዪ በጋ ምንጮችም ᎈር በሰሜ ወጠቀ፤<note caller="-" style="x"><char style="xo" closed="false">8፥10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ. 14፥12</ref>። </char></note> <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />የኰኰቢም ሽም “እሬቶ”<note caller="+" style="f"><char style="fr" closed="false">8፥11 </char><char style="fqa" closed="false">ምሬትም፦ </char><char style="ft" closed="false">ወበሩ። </char></note> ይቡሪ ባነ። የጋዪም አት ሦስታለኘዪ መራራ ኸነ፤ ኧጋዪ መራራ ተወሕነሑ የትነሣም ብዠ ሰቦች ᎀቶ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር. 9፥15</ref>። </char></note><verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />አርበታለኘዪ መላይካ መለከተሑ ነፋ፤ የብራነሕኖ አት ሦስታለኘ ዔን ይወጋዬ የጬት አት ሦስታለኘ፣ የጠናቃም አት ሦስታለኘ፣ የኰኰብም አት ሦስታለኘ ወኴ፤ የክናኒም አት ሦስታለኘ፣ የምሳሪም አት ሦስታለኘ ብራን ኤይብከም ዀተሪ።<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፥7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፥10</ref>፣<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፥15</ref>። </char></note><verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />ተዛም ተምሌከትኩ፤ አት ንስር በሰሜ ግብት ይበር ባነ፤ በወደል ጣምባ፣ “የቀኖዪ ሦስቲ መላይካ መለከት ይነፎ ስለኸነ፣ ጣምባ ቢያሴሞᎄ ግዝየ ባፈር ᎈር ይነብሮዪ ወዮሕኖ! ወዮሕኖ! ወዮሕኖ!” ቲብር ሰማሑ።<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />አምስታለኘዪ መላይካ መለከተሑ ነፋ፤ በሰሜ ታፈሬ የወጠቀዪ ኰኰብ አዠሑ፤ ኰኰቢም የጥልቂ ጐጀ መፍቻ አᎅ። <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />መላይካ የጥልቂ ጐጀ በከᎈተን ግዝየ፣ በውስጠሑ ሓይለኘ ኧሳት ይወጣ ያነ ተን ኸነም ወጣ። በጐጀዪ በወጣዪ ተን ጬት ሰሜም ጬለሞ፤<note caller="-" style="x"><char style="xo" closed="false">9፥2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">ዘፍ. 19፥28</ref>። </char></note> <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />በተኒም ውስጥ አንበጣዎች ባፈር ᎈር ወጦ፤ የአፈር ጊንጦች ቆት የመሰረ ቆት አቡዮ።<note caller="-" style="x"><char style="xo" closed="false">9፥3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ዘፀ. 10፥12-15</ref>። </char></note> <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />አንበጦቺም የአፈሪ ሠር ወይ ሟንመሕኖም የልመለመ አታሕልት ወይ ኧጨ ኤይጎዶኸም፣ ቢኸንም የእዝጌር ማተብ በግንባረሕኖ ᎈር ዬነቦዪ ሰቦች ጠለለ ይጎዶኸም ኤወደኖ፤<note caller="-" style="x"><char style="xo" closed="false">9፥4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፥4</ref>። </char></note> <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />ሕኖም አምስት መሬት ጠለለ ያሥቃዮዮኸም አንኸንም ይቀጥሮዮዬ ሥልጣን አናቡዮ፤ አንበጣዎቺ የሰላቦ ሥቃይ ጊንጥ የሰብ ቲነድፍ ይሴሟንኸማት ያነው። <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />በዛሕኖ ከነዎች ሰቦች ሞት ይሸዎ፤ ቢኸንም ኤይረሕቦይ፤ የወሙትም ዬሎ፤ ቢኸንም ሞት ተሕኖ ይሰክ።<note caller="-" style="x"><char style="xo" closed="false">9፥6 </char><char style="xt" closed="false"><ref loc="REV 3:21">3፥21</ref>፤ <ref loc="JER 8:3">ኤር. 8፥3</ref>። </char></note><verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />አንበጣዎቺ የአርብ የዝጋዶ ፈረዞች ይመስሮ ባነ፤ በጉነነሕኖ ᎈር የወርቅ አክሊል ይመስር ቃር ባነ፤ ኢፍተሕኖም የሰብ ኢፍት ይመስር ባነ፤<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">ኢዩ. 2፥4</ref>። </char></note> <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />ጉነነሕኖ የምሽት ጉነን፤ ስነሕኖ የአንበሳ ስን ይመስር ባነ፤<note caller="-" style="x"><char style="xo" closed="false">9፥8 </char><char style="xt" closed="false"><ref loc="JOL 1:16">ኢዩ. 1፥16</ref>። </char></note> <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />የብረት የደረት ይኩላኰልᎄ ይመስር የደረት ይኩላኰልᎄ ብረት ባነኖ፤ የካንፋሕኖ ጣምባ ታርቤ ይጋልቦ የብዠ ፈረዝ የፈረዝ ጋሪም ጣምባ ይመስር ባነ።<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">ኢዩ. 2፥5</ref>። </char></note> <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />የጊንጥ ፋንቹኸም ይነድፎᎄ ባነኖ፤ ኧሗም የሰቦች አምስት መሬት ያስቃዮᎄ ቆት በፋንቾሕኖ ᎈር ባነ። <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />በᎈረሕኖ ንጉሥ ባነኖ፤ ሑቲ የጥልቂ ጐጀ መላይካው፤ ሽመሑም በዕብራይስጥ አብዶን፣ በግሪክም አጶልዮን<note caller="+" style="f"><char style="fr" closed="false">9፥11 </char><char style="fqa" closed="false">አባዶን፦ </char><char style="ft" closed="false">ደምሳሽ ወበሩ። </char></note> ይቡሪ፤<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />የመጀመሪያዪ ወዮ ተቸለፈም፤ ዘ፤ በዚ አንቌ ገና እንጐድ ዄት ወዮ ይቸኝ።<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />ስድስታለኘዪ መላይካ መለከተሑ ነፋ፤ በእዝጌር ኢፍት ባነዪ በወርቅ በሸከተዪ ቢያርጅᎄዪ ቀኖች ጣምባ ቲቸኝ<note caller="+" style="f"><char style="fr" closed="false">9፥13 </char><char style="ft" closed="false">ቲወጣ ወበሩ። </char></note> ሰማሑ።<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ዘፀ. 30፥1-3</ref>። </char></note> <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />ጣምባሑም መለከት የጠበጠዪ ስድስታለኘዪ መላይካ፣ “በወደሊ ኧድየ በኤፍራጥስ ኧጉጀኞቺ አርበቲ መላይካ ፍታኖ” ቧረን። <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />ተሰብ ዘር አት ሦስታለኘዪ ይቀጥሮኸም፣ የዚ ሰዓትም ከነ ዛምኸም የዚ መሬትም ዓመት ተዝጋዶም የነበሮዪ አርበቲ መላይካ ተፈቶ። <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />የፈረዘኘዪ ጋዝ ብዛት ዄት መቶ ሚሊዮን ወሕነሕኖም ሰማሑ። <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />በመናኛ ያዠሑኖ ፈረዞች በᎈረሕኖም የቾኖዪ ዚ ይመስሮ ባነ፤ የደረት ይኩላኰልᎄ ብረት የኧሳትኸም ብሻ፣ የያክንትኸም ሰማያዊ የዲንኸም ቢጫ ባነ፤ የፈረዞቺ ጉነን የአንበሳዎች ጉነን ይመስር ባነ። በአፈሕኖ ኧሳት ተንም፣ ዲንም ይወጣ ባነ። <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />በአፈሕኖ በወጦዪ፣ በሦስቲ መቅሠፍቶች፣ ወበር ብሳቲ፣ በተኒ በዲኒም አት ሦስታለኘዪ የሰብ ዘር ተቀጠረ። <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />መሳመሑ የፈረዞቺ ቆት ባፈሕኖ በፋንቾሕኖ ᎈር ባነ፤ ፋንቾሕኖ እንድወደረ ይመስር ባነ፤ ጉነን ያነኖ ስለኸነ ጉዳት ያሰሎ በሑቲ ባነ።<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />በዚሕኖ መቅሠፍቶች ቴቈጥርዮ የቀኖዪ ሰቦች ኧሗም ተጀሕኖ ሜና ንስሐ አንገቦ፤ አጋንት ዛምኸም ወዥ ወስማም ወወር ኤይችሎዪ፣ በወርቅ፣ የጠገራ ብር፣ በናስ፣ ብምንም በጨ የሸከቶዪ ጣዖቶች ዋምልክ አንገፈሮ፤<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">መዝ. 115፥4-7</ref>፤ <ref loc="PSA 135:15-17">135፥15-17</ref>፤ <ref loc="DAN 5:23">ዳን. 5፥23</ref>። </char></note> <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />ኧሗም ነብስ ተወቅጥረሕኖ፣ ተሸጐረ ሜናሕኖ፣ ተዝሙት ሩክሰተሕኖም ተስርቆት ሜናሕኖ ንስሐ አንገቦ።<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s1">መላይካ ቀሊ የጥᎄለሊ መጽሐፍም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />ተዛ አንቌ እንጐድ የብረታ መላይካ ዳበና ለበሰም በሰሜ ቲወርድ አዠሑ፤ ሑቲም በነብሰሑ ዙሪያ ቀስተ ዳበና ባነ። ኢፍተሑ የጬትኸም፣ ኧግረሑ የሳት ኧችባንኸም ባኖ። <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />በጀሑም የትከፈተ ቀል የጥᎄለሊ መጽሐፍ ጠበጠም ባነ፤ ከነ ኧግረሑ በባር ᎈር፣ ጉራ ኧግረሑ ባፈር ᎈር አወናን፤ <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />ያገሣ የአንበሳኸም ጣምባሑ ከፍ አበኘም ው ባረ፤ ው በባረ ግዝየ የሰበቲ እንግብግቢት ጣምባ ዝነጎ። <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />ሰበቲ እንግብግቢት በዝነጎ፣ ግዝየ የወጣፍ ተዝጋጀሑ፤ ቢኸንም “ሰበቲ እንግብግቢት የዝነጎዪ በማተብ ዝጓን አንኸንም አትጣፍ” ይብር ጣምባ በሰሜ ሰማሑ።<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />ተዛ አንቌ በባር በአፈርም ᎈር ቈመም ያዠሑን መላይካ ከነ ኧጀሑ ተሰሜዬ ነሣ፤ <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />ሑቲም ተዘላለም ዘላለም ስን ቢነብሪ፣ ሰሜ በውስጠሑ ያኖዪም፣ አፈር በውስጠሑ ያኖዪም፣ ባር በውስጠሑ ያኖዪም በኸለቀዪ በሑቲ ማለ፤ እኪ ባረ፤ “ተሗ ቀረሰም ዋቶር ኤነብር፤ <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />ቢኸንም ሰበታለኘዪ መላይካ መለከተሑ ቢነፋቦ ከነ፣ የአገልጋዮቸሑ የነብዮች በገለጠኖ መሠረት የእዝጌር ምስጢር ይፌጠም።”<note caller="-" style="x"><char style="xo" closed="false">10፥5-7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ዘፀ. 20፥11</ref>፤ <ref loc="DEU 32:40">ዘዳ. 32፥40</ref>፤ <ref loc="DAN 12:7">ዳን. 12፥7</ref>፤ <ref loc="AMO 3:7">አሞ. 3፥7</ref>። </char></note> <verse eid="REV 10:7" /><verse number="8" style="v" sid="REV 10:8" />ተዛም በሰሜ የሰማሑን ጣምባ ዠበረም እኪ ቲብር ዝነጔ፤ “ወር፤ በባር በአፈርም ᎈር ተቈመዪ መላይካ ኧጅ የከፈተዪ የጥᎄለሊ መጽሐፍ ውስድ።”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />እያም ተመላይካዬ ወርኩም እንሲ የጎጋ ጥብልሊ መጽሐፍ ይቡኝኸም ተሳልኩን፤ ሑቲም “ውስድም ቡራን፤ ደናኸ የመረረ ይሸኩች፤ በአፋኸም የውየኸም ይተም” ባሬ።<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />ቀሊም መጽሐፍ ተመላይካዪ ኧጅ ተቌበርኩም በናሑን፤ ባፈኛም የውየኸም ታመ፤ በበናሑን አንቌም ደነኛ የመረረ ኸነ።<note caller="-" style="x"><char style="xo" closed="false">10፥8-10 </char><char style="xt" closed="false"><ref loc="EZR 2:8-33">ዕዝ. 2፥8-33</ref>። </char></note> <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />በዛ አንቌ “ስለብዠ ሕዝቦች፤ ጐሣዎች፣ ቋንቋዎች ነገሥታትም ዠበረም ትምቢት ትዝነጌ ይጌባኸ” ቧርኝ።<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s1">ዄቲ ምስክር</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />ተዛም ሸምበቆ የመሰረ ይቋጨᎄ እንጣር አቡኝ፤ እኪም ቧርኝ፤ “ወርም የእዝጌር ቤተ መቅደስ ያርጅᎄዪም ቃጣ፤ በዛም ያመልኮዪ ቆጥር።<note caller="-" style="x"><char style="xo" closed="false">11፥1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሕዝ. 40፥3</ref>፤ <ref loc="ZEC 2:1-2">ዘካ. 2፥1-2</ref>። </char></note> <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" />ተቤተ መቅደሲ ውጪ ያነዪ ክፍት መደርም ግፉን፤ ሑቲ የአሕዛብ ያᎅ ስለኸነ አትቋጣን፤ አሕዛብ የትቄደሰዪ ከተማ የአርባ ዄት መሬት ይረቅጦይ፤<note caller="-" style="x"><char style="xo" closed="false">11፥2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃ. 21፥24</ref>። </char></note> <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />የዄቲ ምስክረኛ ቆት ኢቦ፤ ሕኖም ያዘን ልባስ ለበሶም አት ሺ ዄት መቶ ሥልሳ ከነ ትምቢት ይዝነጎ።”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />ነዚሕኖ ባፈር ጔታ ኢፍቴ ይቈሞዪ ዄቲ የወይራ ኧጨ ዄቲ መቅረዙ፤<note caller="-" style="x"><char style="xo" closed="false">11፥4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዘካ. 4፥3</ref>፣<ref loc="ZEC 4:11-14">11-14</ref>። </char></note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />ሟንም የሕኖ ይጎዳዬ ቢሸ፣ ኧሳት ባፈሕኖ ወጣም መሶሕኖ ያጠፋ፤ ይጎዳኖዬ ይሸ እንም ወሙት ያነወ በዚኸማቱ። <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />ነዚ ሰቦች ትምቢት ቢዝነጎᎄ መሬት ዝናብ ኤይዘንብኸም ሰሜ የወዝጋ ሥልጣን ነነኖ፤ ኧሗም ኧጋዎቺ ተደሜ የወሰግር ቢሸዎᎄ ግዝየ እንም አፈር በሟንመሑ መቅሠፍት የወውካ ሥልጣን ነነኖ።<note caller="-" style="x"><char style="xo" closed="false">11፥6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ነገ. 17፥1</ref>፤ <ref loc="EXO 7:17-19">ዘፀ. 7፥17-19</ref>፤ <ref loc="1SA 4:8">1 ሳሙ. 4፥8</ref>። </char></note><verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />ምስክርነተሕኖ በፈዶ አንቌ በጥልቂ ጐጀ ይወጣዪ አውሬ ይትዋጋኖ ውራግ ይነሣኖ፤ ይቀጥሮ።<note caller="-" style="x"><char style="xo" closed="false">11፥7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>፣<ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">መና 13፥5-7</ref>፤ <ref loc="REV 17:8">17፥8</ref>። </char></note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />ሬሳሕኖም በወደሊ ከተማ ጠባ ያድጒ፤ ዚ ከተማ ሰዶም ግብጽም ቲቡሪ በምሳሌ ይጠሬዪም የሕኖም ጔታ የሰቀረወው።<note caller="-" style="x"><char style="xo" closed="false">11፥8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ. 1፥9-10</ref>። </char></note> <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />በጐሳ፣ በነገድ፣ በቋንቋም በሕዝብ የቸኖ ሰቦች ሬሳሕኖ ሦስት ከነ ተግብት ይትምሌከቶ፤ ሬሳሕኖ ኤይቀቡሪኸም ይኸትሮ። <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />ነዚ ዄቲ ነብይ ባፈር ይነብሮዪ ያሥቃዮ የነበረ ስለኸነ፣ ባፈር ይነብሮ ሰቦች በሕኖ ᎈር በሰላዪ ቃር ይትብላለቆ፤ ነብስ በነብሰሕኖ ስጦታ ይትበቦ። <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />ተሦስት ከነ ተግብት አንቌም፣ የሕይወት ትንፋሽ በእዝጌሬ ቸኘም ቡየቦ፤ ሕኖም ተነሦም በግረሕኖ ቈሞ፤ ይትምሌከቶዮ በነበሮዪ ᎈር ወደል ጊናት ወረደቦ።<note caller="-" style="x"><char style="xo" closed="false">11፥11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ሕዝ. 37፥10</ref>። </char></note> <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />ተዛም፣ “ተዚዬ ውጦ” ይብኖዪ ወደል ጣምባ በሰሜ ሰሞ፤ መሶሕኖ ቲምሌከቶዮ በዳበና ተሰሜዬ ወጦ።<note caller="-" style="x"><char style="xo" closed="false">11፥12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 ነገ. 2፥11</ref>። </char></note> <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" />በዛም ሰዓት ወደል ያፈር ወትናወጥ ኸነ፤ የከተማዪም አት ዐሥረኘ ጠፋ፤ በነውጢም ሰበት ሺ ሰብ ᎀተ፤ የተረፎዪም ጊናት ጠበጠኖ፤ የሰሜም አምላክ ክብር አቦ።<note caller="-" style="x"><char style="xo" closed="false">11፥13 </char><char style="xt" closed="false"><ref loc="REV 6:12">መና 6፥12</ref>፤ <ref loc="REV 16:18">16፥18</ref>። </char></note><verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />ዄታለኘዪ ወዮ አለፈም፤ ዘ፤ ሦስታለኘዪ ወዮ ከሞ ይቸኝ።<verse eid="REV 11:14" /></para>
  <para style="s1">ሰበታለኘዪ መለከት</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />ሰበታለኘዪም መላይካ መለከተሑ ነፋ፤ በሰሜም እኪ ይብሮ ወደል ጣምባ ተሴሞ፤</para>
  <para style="p" vid="REV 11:15">የዓለም መንግሥት፣</para>
  <para style="p" vid="REV 11:15">የጔታ የአምላከና የኢየሱስ ክርስቶስ መንግሥት ኸነ፤ ሑቲም ተዘላለም ዘላለም ስን ይነግሥ።<note caller="-" style="x"><char style="xo" closed="false">11፥15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">ዘፀ. 15፥18</ref>፤ <ref loc="DAN 2:44">ዳን. 2፥44</ref>፤ <ref loc="DAN 7:14">7፥14</ref>፣<ref loc="DAN 7:27">27</ref>። </char></note> <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />በእዝጌር ኢፍት በዙፋነሕኖ ᎈር የቾኖዪ ሑያ አርበቲ ባሊቅ በግንባረሕኖ ተደፎም የእዝጌር ሰገዶ፤ <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />እኪም ባሮ፤</para>
  <para style="q1" vid="REV 11:17">“ያነኸ የነበረኸም፤</para>
  <para style="q2" vid="REV 11:17">እንም ይቸልኸ፤</para>
  <para style="q2" vid="REV 11:17">ጔታ እዝጌር፤</para>
  <para style="q2" vid="REV 11:17">ናምሰግነከ፤</para>
  <para style="q2" vid="REV 11:17">መሳመሑ አኸ ወደሊ ቆታሐ ጠበጥከም ነገሥከም።<verse eid="REV 11:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="REV 11:18" />አሕዛብ ማቶም ባነ፤</para>
  <para style="q2" vid="REV 11:18">ያኸም ማት ቸኘ፤</para>
  <para style="q2" vid="REV 11:18">በሟቾቺ ᎈር ትፈርድወ፣</para>
  <para style="q1" vid="REV 11:18">የአገልጋዮቻኸ የነብዮች፣</para>
  <para style="q2" vid="REV 11:18">የቅዱሳንም ሽማኸ ይጔኖዪ፣</para>
  <para style="q2" vid="REV 11:18">የቅስስኖቺ የወደሎቺም፣</para>
  <para style="q1" vid="REV 11:18">ጄዛሕኖ ቲብወ፤</para>
  <para style="q2" vid="REV 11:18">አፈርም ያጠፎዪ ታጠፋወ ዘበን ቸኘም።”<note caller="-" style="x"><char style="xo" closed="false">11፥18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">መዝ. 2፥5</ref>፤ <ref loc="PSA 110:5">110፥5</ref>፤ <ref loc="PSA 115:13">115፥13</ref>። </char></note><verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />ተዛም በሰሜ ያነዪ የእዝጌር ቤተ መቅደስ ተከፈተ፤ የሑቲም የጉዳ ታᎄት በቤተ በመቅደሲ ውስጥ ታዠ፤ ብራቅ፣ ጣምባ፣ እንግብግቢት፣ ያፈር ወትናወጥ ወደልም በረድ ኸነ።<note caller="-" style="x"><char style="xo" closed="false">11፥19 </char><char style="xt" closed="false"><ref loc="REV 8:5">መና 8፥5</ref>፤ <ref loc="REV 16:18">16፥18</ref>፤ <ref loc="REV 21">21</ref>። </char></note><verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s1">ምሽቲ ዘንዶዪም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />ወደል ያዴንቅ ምልክትም በሰሜ ታዠ፤ ጬት የለበሰች፣ ጠናቃ በግሬታ ተት የረገጠች በጉነኔታ ᎈር ዐሥረ ዄት ኰኰብ ያኖይ አክሊል ያወናች አት ምሽት ታዠች። <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />ሒቲም ዄት ነብስ ባነች፤ ትጨኜ ቲኸን መጥ ጠበጠናም ተጨነቀችም ው ባረች፤<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />ዛምኸም ኧንጐድ ምልክት በሰሜ ታዠ፤ ሰበት ጉነን ዐሥር ቀን ያኖይ ወደል ብሻ ዘንዶ ታዠ፤ በጉነነሑም ᎈር ሰበት ዘውድ አወናም ባነ።<note caller="-" style="x"><char style="xo" closed="false">12፥3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>። </char></note> <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />በፋንቾሑ የኰኰቢ አት ሦስታለኘ በሰሜ ሻበም ታፈሬ አደገኖ፤ ሒቲም በጨኘች ግዝየ የትኸዬታን የወዋጥ ሸም ዘንዶዪ ትጨኜ በሰላች ምሽት ኢፍቴ ቈመ፤<note caller="-" style="x"><char style="xo" closed="false">12፥4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳን. 8፥10</ref>። </char></note> <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />ሕዝቢ እንም በብረት እንጣር የገዢዪ ኧርጅ ጨኘች፤ ትኸዬታንም ተእዝጌሬ ተዙፋነዄም ተነጠቀ።<note caller="-" style="x"><char style="xo" closed="false">12፥5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ. 66፥7</ref>፤ <ref loc="PSA 2:9">መዝ. 2፥9</ref>። </char></note> <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ምሽቲም ቁና ሺ ዄት መቶ ሥልሳ ከነ ይንክባከቡያኸም እዝጌር ታዝጋጀና መደሬ ተበረሐዬ ሰኴች፤።<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />በሰሜ አርብ ኸነ፤ ሚካኤል በሑቲ ተት ያኖዪ መላይካም ተዘንዶዪጌም ተዋጎ፤ ዘንዶዪ መላይካዪም ዠበሮም ተዋጎዮ፤<note caller="-" style="x"><char style="xo" closed="false">12፥7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፥13</ref>፣<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፥1</ref>። </char></note> <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />ቢኸንም ዘንዶዪ የሑቲ መላይካም ተቌሞ ተዛም አንቌ በሰሜ የነበረኖዪ መደር ቀበጦ። <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" />ወደሊም ዘንዶ፣ የድረዪ እንድወደረ አደጒ፤ ሑቲም ዳቡሎስ ሼጣን ቧሪም ይጠሬዪ፣ ዓለሚ እንም ያሰቲው፤ ሑቲ ታፈሬ አደጒ፤ መላይካመሑ ተሑቲጌ አደጉዮ።<note caller="-" style="x"><char style="xo" closed="false">12፥9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ዘፍ. 3፥1</ref>፤ <ref loc="LUK 10:18">ሉቃ. 10፥18</ref>። </char></note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />ተዛ አንቌ ወደል ጣምባ በሰሜ እኪ ቲብር ሰማሑ፤</para>
  <para style="q1" vid="REV 12:10">ኧሗም የአምላከና ዋትርፍ፣ ቆት</para>
  <para style="q2" vid="REV 12:10">መንግሥትም፣</para>
  <para style="q2" vid="REV 12:10">የክርስቶስ ሥልጣንም ቸኘም።</para>
  <para style="q1" vid="REV 12:10">ክናን ተምሳር በአምላከና ኢፍት ቲከስሶ</para>
  <para style="q2" vid="REV 12:10">የነበረዪ፣</para>
  <para style="q2" vid="REV 12:10">የጐባቢተና ከሳሽ አደጒም።<verse eid="REV 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11" />ሕኖም በጤዪ ደም፣</para>
  <para style="q2" vid="REV 12:11">በምስክርነተሕኖም ቃል፣</para>
  <para style="q2" vid="REV 12:11">ውራግ ነሦይ፤</para>
  <para style="q1" vid="REV 12:11">የወሙት ስን፣</para>
  <para style="q2" vid="REV 12:11">ሕይወተሕኖም ቴያመጥጦ</para>
  <para style="q2" vid="REV 12:11">ነብሰሕኖ የሞት አቸለፎም አቦ።<verse eid="REV 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12" />ስለኸነም ሰሜ፣</para>
  <para style="q2" vid="REV 12:12">በውስጠሕኖም ትነብሮዪ፣</para>
  <para style="q1" vid="REV 12:12">ተብላለቆ፤</para>
  <para style="q2" vid="REV 12:12">አፈር ባርም ወዮአሑ መሳመሑ ዳቡሎስ ቀል ዘበን ጠለለ</para>
  <para style="q1" vid="REV 12:12">የቈኘንኸም የሐረ ስለኸነ፣</para>
  <para style="q2" vid="REV 12:12">በወደል ማት ተመላም ታሑዬ ወረደም።<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />ዘንዶዪ ታፈሬ ባደጒኸም ባዠ ግዝየ ኧርጅ የጨኘቺ ምሽት አሳደደና፤ <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />ምሽቲም በበረሐ ተዝጋጀና መደሬ በረረችም ወወር ትችልኸም ዄት የወደሊ ንስር ካንፋ አቡያ፤ ዚም የኸነ በዛ በእንድወደረዪ ኢፍት ራቀችም ያት ዘበን፣ ተዘበናት ዘበንም ግብት ተንክባከቡያም ትነብርኸሙ።<note caller="-" style="x"><char style="xo" closed="false">12፥14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳን. 7፥25</ref>፤ <ref loc="DAN 12:7">12፥7</ref>። </char></note> <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />እንድወደረዪም የምሽቲ በጐርፍ ትትወሰድኸም የድየ ኧጋኸም ባፈሑ አፈሰሰ። <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />አፈርም የምሽቲ አገዘና፤ አፈሑ ከፈተም ዘንዶዪ ባፈሑ ያᎈሰሰኒ ኧድየ ዋጠ። <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />ዘንዶዪ በምሽቲ ᎈር ማቸ፤ ተቀኖዪ ዴንጋዬታንጌ ይትዋጋዬ ወረ፤ ሕኖም የእዝጌር ትዛዝ ይቅሮ የኢየሱስ ምስክር አጠበቆም የጠበጦኖ። <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />ዘንዶዪም<note caller="+" style="f"><char style="fr" closed="false">12፥18 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">እያም በባሪ ᎀረ ቈምኩም ባነ </char><char style="ft" closed="false">ይብሮ። </char></note> በባሪ ᎀረ ባሸዋ ᎈር ቈመ።<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s1">በባር የወጣዪ አውሬ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />በዛም ቁና አውሬ በባር ቲወጣ አዠሑ፤ ሑቲም ዐሥር ቀን ሰበት ጉነንም ባኖይ፤ በቀነሑ ᎈር ዐሥር ዘውድ፣ በጉነነሑም ᎈር የስድብ ሽሞች ባኖይ። <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />ያዠሑን አውሬ ዞጋራ ይመስር ባነ፤ ቢኸንም ኧግሮቸሑ የድብ፣ አፈሑ የአንበሳ አፍ ይመስር ባነ፤ ዘንዶዪ የነብሰሑ ቆት የነብሰሑ ዙፋንም ዛምኸም ወደል ሥልጣን የአውሬዪ አᎄን። <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />በአውሬዪ ጉነን አቲ የሞት ያሰላ መዛ ያነወ ይመስር ባነ። ቢኸንም የሞት ያሰላኒ መዛሑ ተረፈ፤ ዓለም እንም በወደነቅ አውሬዪ ተዄተለን። <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />ሰቦችም የዘንዶዪ ሰገዶነ፤ መሳመሑ ሥልጣነሑ የአውሬዪ አᎄንም። ኧሗም፣ “አውሬዪ ይመስር ሟኒ? ተሑቲጌ ሟ ይዋጋዬ ይችል?” በወበር የአውሬዪ ሰገዶነ።<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />አውሬዪ የትዕቢት ቃል ይዝነጊወ ይሳደብወም አፍ አᎅ፤ አርባ ዄት መሬት በሥልጣን ይሸክትኸም ተፌቈደነ።<verse eid="REV 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 13:6" />ሑቲም የእዝጌር የወሳደብ ዛምኸም ሽመሑ ያድርወዪም፣ በሰሜም ይነብሮዪ ወሳደብ ቀረሰ። <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />የቅዱሳን ይዋጋኸም ውራግ ይነሣኸም ቆት አᎅ። በነገድ፣ በጐሳ፣ በቋንቋ በሕዝብ እንም ᎈር ሥልጣን አᎅ። <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />ዓለም በትኸለቀ ቀረሰም<note caller="+" style="f"><char style="fr" closed="false">13፥8 </char><char style="fqa" closed="false">ዓለም በትኸለቀ ቀረሰም ሽመሕኖ በታረደዪ ኧጤ የሕይወት መጽሐፍ ውስጥ የጣፈው</char></note> ባረጂዪ ኧጤ የሕይወት መጽሐፍ ᎈር ሽመሕኖ ያንትጣፈ ያፈር ሰቦች እንም ያውሬዪ ይሰግዶ።<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />እንዝን ያነን ቢነብር የስማ።<verse eid="REV 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10" />ሟንም ይትማረክ ቢነብር፣</para>
  <para style="q2" vid="REV 13:10">ሑቲ ይትማረክ፤</para>
  <para style="q1" vid="REV 13:10">ሟንም በሰይፍ ይቀጥር<note caller="+" style="f"><char style="fr" closed="false">13፥10 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ይቀጥር</char><char style="ft" closed="false">ይብሮ። </char></note> ቢነብር፣</para>
  <para style="q2" vid="REV 13:10">ሑቲ በሰይፍ ይቈጥሪ።</para>
  <para style="m" vid="REV 13:10">ዚም የቅዱሳን ትዕግሥት እምነትም ይታዢ በዚ የኸነኸም ያትኴር።<note caller="-" style="x"><char style="xo" closed="false">13፥10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር. 15፥2</ref>፤ <ref loc="JER 43:11">43፥11</ref>። </char></note><verse eid="REV 13:10" /></para>
  <para style="s1">ባፈር የወጣዪ አውሬ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />ተዛም እንጐድ አውሬ ባፈር ቲወጣ አዠሑ፤ ሑቲም የጤኸም ዄት ቀን ባኖይ፤ ቢኸንም የዘንዶኸም ይዝነግ ባነ።<verse eid="REV 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 13:12" />በመጀመሪያዪ አውሬ ሽም በሙላ ሥልጣን ይሸክት ባነ፤ አፈር በሑቲም ይነብሮዪ እንም፣ የሞት ቲያሰላኒ መዛ የተረፈዪ የመጀመሪያዪ አውሬ ያመልኮኸም ሸከተ። <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />ዚ ዄታለኘዪ አውሬ በሰቦቺ ኢፍቴ ኧሳት በሰሜ ታፈሬ ያወርድ ስን ግድድር ምልክቶች ሸከተ። <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />በመጀመሪያዪ አውሬ ሽም ምልክቶች ይሸክትኸም ሥልጣን ያᎅ ስለኸነ፣ በአፈር ይነብሮዪ የሰቦች አሰሰተ፤ በሰይፍ ምዘየም የነበረዪ፣ ቢኸንም በሕይወት ይነብሪ አውሬ ምስያ ያቆሞኸም ኤዘዘኖ። <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />ኧሗም የመጀመሪያዪ አውሬ ምስያ ወዘንግ ይችልኸም የምስያዪ ትንፋሽ የዋብ የዚም ምስያ ኤይሰግዶ እንም ይቈጥርዮኸም የወሰክት ሥልጣን አᎅ። <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />ዛምኸም ቅስስን ግድድርም፣ ዱሬሻ ዜጋም፣ ጌቶች ጉዙዎችም እንም በከነ ኧጀሕኖ በግምባረሕኖም ᎈር ምልክት ይቄበሮኸም አትጌደደኖ፤ <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />ዚም የኸነዪ የአውሬዪ ምልክት፣ ዚም ሽመሑ የሽመሑም ቁጥር ዬነን ሟንም ሰብ የወሰየ የዋሰየም ኤይችልኸሙ።<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />ዚ ብላት ይሰል፤ ቀልብ ያነን ሟንም ሰብ የአውሬዪ ቁጥር የሗር፤ መሳመሑ ቁጥሪ የሰብ ቁጥሩ። ቁጥሪ ስድስት መቶ ሥልሳ ስድስቱ።<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s1">ኧጤዪ መቶ አርባ አርበቲ ሺ ሰብም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />ተዛ አንቌ አዠሑ፤ ዘ፤ ኧጤዪ በጽዮን ቈቶ ᎈር ቈመም ባነ፤ ተሑቲጌ የሑቲ ሽምም ያᎄችም ሽም በግንባረሕኖ ᎈር የጣፈቦዪ መቶ አርባ አርበቲ ሺ ሰብ ባኖ።<note caller="-" style="x"><char style="xo" closed="false">14፥1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፥4</ref>፤ <ref loc="REV 7:3">መና 7፥3</ref>። </char></note> <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />በሰሜ የብዠ ኧጋ ጣምባኸም የወደል እንግብግቢት ጣምባ የመሰረ ጣምባ ሰማሑ፤ የሰማሑን ጣምባ በገና ደርዳሪ ይድረድሮይኸማት ባነ። <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />ሕኖም በዙፋኒ ኢፍቴ፣ ባርበቲ ሕያው ሕዝብ በባሊቂም ኢፍት ገደር መዝሙር ዜመሮ። ባፈር ተትዋጆዪ ተመቶ አርባ አርበቲ ሺ ሰብ አንኸንም ሟንም መዝሙሪ ይሮሽኔ አንቻለ። <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />ነዚ ነብሰሕኖ ብንሽታ ያናርከሶኖ፤ ነብሰሕኖ በንጥሕና ቅሮም። ኧጤዪ ቲያርወዬ እንም ይትዄተሎይ፤ የእዝጌር የጤዪም በሕር ይኸኖኸም በሰቦች ግብት የትዋጆኖ። <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />ባፈሕኖ አትምኸማት ውሸት አንትረኸበ፤ ነቀፋም ኤነቦ።<verse eid="REV 14:5" /></para>
  <para style="s1">ሦስቲ መላይካ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />ተዛም እንጐድ መላይካ በሰሜ ግብት ቲበር አዠሑ፤ ሑቲም ባፈር ᎈር ይነብሮዪ የሕዝብ፣ የነገድ፣ የቋንቋ የጐሳም እንም ይሰብኪ የዘላለም ወንጌል ጠበጠም ባነ፤ <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />በወደል ጣምባም፣ “የእዝጌር ጔኖ፤ ክብርም አቦይ፤ መሳመሑ የፍርዲ ሰዓት ሰላም፤ ሰሜ ታፈርም፣ ባር ተኧጋ ምንጮችም የኸለቀዪ ስግዶ” ባረ።<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />ኧንጐዲ ዄታለኘዪ መላይካ፣ “ሕዝብ እንም የዝሙቴታን ማት የወይን ደጔ ይሰጦኸም የሸከተች ወደሊ ባቢሎን ወጠቀ ወጠቀ!” ቲብር ተዄተለን።<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />ሦስታለኘዪም መላይካ በወደል ጣምባ እኪ ቲብር ተዄተለኖ፤ “ሟንም የአውሬዪ የምስሊም ይሰግድ፣ ምልክቲም በግምባረሑ ወይ በጀሑ ᎈር ይቄበር ቢነብር፣ <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ሑቲ ኧሗም አትም ቃር ቴይቅላቅልወ በማተሑ ጥወ ውስጥ የትᎀላዪ የእዝጌር ማት የወይን ደጔ ይሰጭ። በቅዱሳን መላይካ በጤዪ ኢፍቴም በሳት በዲንም ይሥቃይ። <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />የሥቃየሕኖ ተን ተዘላለም ዘላለም ስን ተነኔ ይወጣ። የአውሬዪ የምስሊም ይሰግዶ የሽመሑም ምልክት ይቌበሮ እንም ክናን ተምሳር ፎያት ኤነኖ።” <verse eid="REV 14:11" /><verse number="12" style="v" sid="REV 14:12" />የእዝጌር ትዛዝ ይቅሮዪ የኢየሱስም ታማኝ ኸኖም በትዕግሥት ይጠኖ ቅዱሳን ይትኴሮ በዚቱ።<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />በዛ፣ “ተሗ ቀረሰም በጔታ ኸኖም ይᎀቶ የትምሰገኖኖ በርም ጣፍ” ይብር ጣምባ በሰሜ ሰማሑ። መንፈስም፣ “ኤክ፣ ሜናሕኖ ይትዄተሎ ስለኸነ ተቂጭናሕኖ ያᎈሮ” ይብር።<verse eid="REV 14:13" /></para>
  <para style="s1">ያባር ግዝየ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />አዠሑ፤ ዘ፤ ቢፍተኛ ነጨ ዳበና ባነ፤ በዳበናዪም ᎈር፣ “የሰብ ትኸ ይመስር” ቾናም ባነ፤ ሑቲም በጉነነሑ ᎈር የወርቅ አክሊል አገደም፣ በጀሑም ቡሊ መደድ ጠበጠም ባነ። <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />እንጐዲ መላይካም በመቅደስ ወጣም በዳበና ᎈር የቾናዪ፣ “ያጅᎄ ሰዓት የሰላ ስለኸነ፣ መደዳኸ ጥብጥም ኧድድ፤ አባር ሰላም” ቲብር በወደል ጣምባ ው ባረ። <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />ስለኸነም በዳበና ᎈር የቾናዪ መደደሑ ታፈሬ አደጐን፤ አፈርም ታደደ።<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />እንጐድ መላይካም በሰሜ ባነዪ መቅደስ ወጣ፤ ሑቲም የበላ መደድ ጠበጠም ባነ። <verse eid="REV 14:17" /><verse number="18" style="v" sid="REV 14:18" />በሳት ᎈር ሥልጣን ያነን እንጐድ መላይካ ቢያርጅᎄዪ ወጣም የበላ መደድ የጠበጠዪ፣ “ዘለላዪ የሰላ ስለኸነ፣ የበላ መደዳኸ ጥብጥም ባፈር ᎈር ያኖዪ የወይን ዘለላ ሰብስብ” ቲብር በወደል ጣምባ ው ባረ። <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />መላዪካዪ መደዲ ታፈሬ አደጐን፤ ያፈሪ የወይን ዘለላ ስበሰበም ተወደሊ ተእዝጌር የማት ወይን ቲቆቁርᎄዬ አደገኖ። <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" />ወይኒም ተከተማዬ ውጪ በወይን ቢቆቁርᎄዪ ውስጥ ረጐጪ፤ ከፍታውታ የፈረዝ ልኮ ይሰላ ስን፣ ርዝመተሑ ሦስት መቶ ኪሎ ሜትር ቅጫ ደም ቢቆቁርᎄዪ ወጣ።<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s1">ሰበቲ መላይካ ሰበቲ መቅሠፍትም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />እንጐድም ወደል ያዴንቅ ምልክት በሰሜ አዠሑ፤ የመጨረሻዪ ሰበት መቅሠፍት የጠበጦ ሰበት መላይካ አዠሑ፤ የመጨረሻ የቧርዮዪ የእዝጌር ማት ይፌጠሚ በሑቲ በወሕነሑ።<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />ተሳትጌ የድባለቀ የብርጭቆ ባር ይመስር አዠሑ፤ በባሪም ᎀረ አውሬዪ፣ ምስለሑ የሽመሑ ቁጥር ውራግ የነሶዪ ቈሞም አዠሑ፤ ሕኖም በእዝጌር ያቡዮዪ በገና ጠበጦም፣<verse eid="REV 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 15:3" />የእዝጌር ጉዙ የኸነዪ የሙሴ መዝሙር የጤዪ መዝሙርም እኪ ቲብሮ ይዜምሮ ባነ፤</para>
  <para style="q1" vid="REV 15:3">እንም ይችል ጔታ አምላክ፤</para>
  <para style="q2" vid="REV 15:3">ሜናኸ ወደል ያዴኒቅሙ።</para>
  <para style="q1" vid="REV 15:3">የዘበናት<note caller="+" style="f"><char style="fr" closed="false">15፥3 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ሕዝቢ </char><char style="ft" closed="false">ይብሮ። </char></note> ንጉሥ፤</para>
  <para style="q2" vid="REV 15:3">ኤማኸ ጽድቅ የኢኑ።<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />ጔታ፤ ያኸ ኤይጌና፣</para>
  <para style="q2" vid="REV 15:4">ሽማኸ ኤያከብርሽ ሟኒ?</para>
  <para style="p" vid="REV 15:4">አኸ ጠለል ቅዱስንከ።</para>
  <para style="q1" vid="REV 15:4">የጽድቅ ሜናኸ የትገለጠ ስለኸነ፣</para>
  <para style="q2" vid="REV 15:4">ሕዝብ እንም ይቸኖ፤</para>
  <para style="q1" vid="REV 15:4">ቢፍታኸም ይሰግዶ።<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />በዛ አንቌ አዠሑ፤ በሰሜ ያነዪ ቤተ መቅደስ፣ ዚም የምስክሪ ድንኳን ተከፈተም ባነ፤<note caller="-" style="x"><char style="xo" closed="false">15፥5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ዘፀ. 38፥21</ref>። </char></note> <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />ሰበቲ መቅሠፍት የጠበጦዪ ሰበቲ መላይካ ተቤተ መቅደሲ ወጦ፤ ሕኖም በስስ ክር የሸከተ ንጡ ያንብራጣ ልባስ ለበሶም፣ ደረተሕኖም በወርቅ ቢታጐጅᎄ ታገዶም ባነ። <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />ተዛም ተአርበቲ ሕያው ሕዝብ አቲ ተዘላለም ዘላለም ስን ቢነብሪ አምላክ ማት የመላቦዪ ሰበት የወርቅ ጥወ የሰበቲ መላይካ አበኖ። <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />ቤተ መቅደሲ ተእዝጌር ክብር፣ ተቆተሑም በወጣዪ ተን ተመላ፤ የሰበቲ መላይካ ሰበት መቅሠፍት ይፌጠም ስን ሟንም ተቤተ መቅደሴ ወግባ አንቻለ።<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ዘፀ. 40፥34</ref>፤ <ref loc="1KI 8:10-11">1 ነገ. 8፥10-11</ref>፤ <ref loc="2CH 5:13-14">2 ዜና 5፥13-14</ref>።</char></note><note caller="+" style="f"><char style="fr" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="REV 6:4">መና 6፥4</ref> </char></note>።<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s1">ሰበቲ የእዝጌር ማት ጥወ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />ተዛ አንቌ ሰበቲ መላይካ፣ “ወሮ፤ ሰበቲ የእዝጌር ማት ጥወ ባፈር ᎈር አፍስሶ” ይብር ወደል ጣምባ ተቤተ መቅደስ ሰማሑ።<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />የመጀመሪያዪ መላይካ ወረም ጥወዪ ባፈር ᎈር አᎈሰሰን፤ የአውሬዪ ምልክት በቌበሮዪም የምስሊ በሰገዶዪ ሰቦች ᎈር ቡሼ ያሥቃይ መዛ ወጣቦ።<note caller="-" style="x"><char style="xo" closed="false">16፥2። </char><char style="xt" closed="false"><ref loc="EXO 9:10">ዘፀ. 9፥10</ref>። </char></note><verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />ዄታለኘዪ መላይካ ጥወዪ በባር ᎈር አᎈሰሰን፤ ባሪም የᎀተ ሰብ ደምኸም ኸነ፤ በባሪ ውስጥ ይነብሮ ሕይወት ያነኖ ቃር እንም ᎀቶ።<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />ሦስታለኘዪ መላይካ ጥወዪ በድየ በኧጋ በምንጮቺ ᎈር አᎈሰሰን፤ ሕኖም ደም ኸኖ።<verse eid="REV 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 16:5" />ተዛም በኧጋ ᎈር ሥልጣን ያነን መላይካ እኪ ቲብር ሰማሑ፤</para>
  <para style="q1" vid="REV 16:5">“ያነኸም የነበርከ ቅዱሲ፤</para>
  <para style="q2" vid="REV 16:5">እኪ የፈረድከ ስለኸነ፣</para>
  <para style="q1" vid="REV 16:5">አኸ ጻድቅንከ፤<verse eid="REV 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6" />የቅዱሳን የነብዮቺም ደም ያፈሰሶ ስለኸነ፣</para>
  <para style="q2" vid="REV 16:6">አኸም ኧሗም ደም ይሰጦኸም ሸከትከኖ፤ ዚ ይጌባኖው።”<verse eid="REV 16:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="REV 16:7" />ዛምኸም ቢያርጅᎄዪ እኪ ይብር ጣምባ ሰማሑ፤</para>
  <para style="q1" vid="REV 16:7">“ኤክ፤ እንም ይችል ጔታ አምላክ፤</para>
  <para style="q2" vid="REV 16:7">ፍርዳኸ የኢን ጽድቁ።”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />አርበታለኘዪም መላይካ ጥወዪ በጬት ᎈር አᎈሰሰን፤ ጬትም የሰቦቺ በሳት ያነድኸም ቆት አᎅ። <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />ሕኖም በወደል ሐሩር ነደዶ፤ በዚሕኖም መቅሠፍቶች ᎈር ሥልጣን ያነኒ የእዝጌር ሽም ሰደቦ አንከንም ንስሐ አንገቦ፤ ክብርም አናቦይ።<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />አምስታለኘዪ መላይካ ጥወዪ በአውሬዪ ዙፋን ᎈር አᎈሰሰን፤ የአውሬዪም መንግሥት በጨለማ ተዋጠ፤ ሰቦችም ተሥቃየሕኖ የትነሣ አለመተሕኖ ዬኝኮ ባነ፤ <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />ኧሗም ተስቃየሕኖም ተመዛሕኖ የትነሣ የሰሜዪ አምላክ ሰደቦ አንከንም ተሜናሕኖ ንስሐ አንገቦ።<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />ስድስታለኘዪ መላይካ ጥወዪ በወደሊ ኧድየ በኤፍራጥስ ᎈር አᎈሰሰን፤ በምሥራቅ ይቸኖዪ ነገሥታት ኤማ ይዝጋጅኖኸም የድየዪ ኧጋ ጠረቀ። <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />በዛም በዘንዶዪ አፍ፣ በአውሬዪ አፍም በባጢለተኘዪ ነብይ አፍ ቈጨ ይመስሮ ሦስት ሩክስ መናፍስት ቲወጦ አዠሑ። <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />ሕኖም ታምራዊ ምልክት ይሸክቶ የአጋንንት መናፍስትኖ፤ እንም ቢችል አምላክ ወደል ከነ ይኸኒ አርብ ይስበስቦዮኸም ተዓለም ነገሥታቴ እንም ያሮ።<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />“ዘ! እያ የሌባኸም ሒንጌም በድንገት ኧቸኝ፤ እንጨሑ ኤይኸንኸም ማለሑ ኤታዥኸም ነቃም ልባሰሑ ይቅየ ሰብ የትምሰገነው።”<note caller="-" style="x"><char style="xo" closed="false">16፥15 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቴ. 24፥43-44</ref>፤ <ref loc="LUK 12:30-40">ሉቃ. 12፥30-40</ref>፤ <ref loc="REV 3:3">መና 3፥3</ref>። </char></note><verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />መናፍስቲም የነገሥታቲ በዕብራይስጥ አርማጌዶን ቢቡሪ መደር ስበሰቦዮ።<note caller="-" style="x"><char style="xo" closed="false">16፥16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 ነገ. 23፥29</ref>፤ <ref loc="ZEC 12:11">ዘካ. 12፥11</ref>። </char></note><verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ሰበታለኘዪ መላይካ ጥወዪ በአየር ᎈር አᎈሰሰን፤ በቤተ መቅደሲ ውስጥ ባነዪ ዙፋን “ተፌጠመ” ይብር ወደል ጣምባ ወጣ። <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" />ተዛም ብራቅ፣ ጣምባ፣ እንግብግቢት ወደል ያፈር ወትናጥ ኸነ፤ ሰብ ባፈር ᎈር በትኸለቀ ቀረሰም እኪ ያነ ወደል ያፈር ወትናጥ ታዠም ኤይትኴር፤ ነውጢም ስርም ወደል ባነ።<note caller="-" style="x"><char style="xo" closed="false">16፥18 </char><char style="xt" closed="false"><ref loc="REV 8:5">መና 8፥5</ref>፤ <ref loc="REV 11:13">11፥13</ref>፤ <ref loc="REV 19">19</ref>። </char></note> <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />ወደሊ ከተማ ሦስቴ ተሳደ፤ የአሕዛብ ከተሞችም ፍራረሶ፤ እዝጌርም ወደሊ ባቢሎን አስታወሰ፤ በወደል ማተሑ የወይን ደጔ የᎀላወዪ ጥወ አᎄን።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፥17</ref>። </char></note> <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" />ደሴቶች እንም ሰኮ፤ ቈቶዎቺም ይትረከቦዬ አንቻሎ።<note caller="-" style="x"><char style="xo" closed="false">16፥20 </char><char style="xt" closed="false"><ref loc="REV 6:14">መና 6፥14</ref>። </char></note> <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" />በሚዛን ቲትሜዘን እያታቲ አርባ አምስት ኪሎ ግራም ይኸን ወደል በረድ በሰቦች ᎈር በሰሜ ወረደቦ፤ መቅሠፍቲ ስርም አሠቃቂ የነበረ ስለኸነ፣ ሰቦቺ በበረዲ መቅሠፍት የትነሣ የእዝጌር ሰደቦ።<note caller="-" style="x"><char style="xo" closed="false">16፥21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">ዘፀ. 9፥23</ref>፤ <ref loc="REV 11:19">መና 11፥19</ref>። </char></note><verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s1">በአውሬዪ ᎈር የቾናቺ ምሽት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />ሰበቲ ጥወ ተጠበጦዪ ተሰበቲ መላይካ አቲ ቸኘም እኪ ባሬ፤ “ኔኸ፤ በብዠ ኧጋ ᎈር የቾናቺ የወደሊ አመንዝራ ምሽት ፍርድ አቴዥኸ፤<note caller="-" style="x"><char style="xo" closed="false">17፥1 </char><char style="xt" closed="false"><ref loc="JER 51:13">ኤር. 51፥13</ref>። </char></note> <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />ያፈር ነገሥታት ተሒቲጌ አምነዘሮ፤ የገኝ ነዋሪዎችም በዝሙቴታ በወይን ደጔ ሰከሮ።”<note caller="-" style="x"><char style="xo" closed="false">17፥2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፥17</ref>፤ <ref loc="JER 51:7">ኤር. 51፥7</ref>። </char></note><verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />ቄጠለም መላይካ በመንፈስ ተበረሐዬ ወሰዴ፤ በዛም አት ምሽት በስድብ ሽም በትᎀላ፣ ሰበት ጉነን ዐሥር ቀንም ያኖይ በብሻ አውሬ ᎈር ቾናችም አዠሑ።<note caller="-" style="x"><char style="xo" closed="false">17፥3 </char><char style="xt" closed="false"><ref loc="REV 13:1">መና 13፥1</ref>። </char></note> <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ምሽቲ የወይን ደጔ ብሻ ልባስም ለበሰችም ባነ፤ በወርቅ፣ በከበሮ እምን በዕንቁ ደመቀችም ባነ፤ በጄታም ያጤይፍ ቃር የዝሙቴታን ሩክስ የᎀላወዪ የወርቅ ጥወ ጠበጠችም ባነ።<note caller="-" style="x"><char style="xo" closed="false">17፥4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር. 51፥7</ref>። </char></note> <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />በግንባሬታን ᎈር እኪ ይብር የምሥጢር ሽም ተጣፈም ባነ፤</para>
  <para style="pc" vid="REV 17:5">ወደሊ ባቢሎን፣</para>
  <para style="pc" vid="REV 17:5">የአመንዝሮችም</para>
  <para style="pc" vid="REV 17:5">ያፈር ሩክሶች ዳኮ።<verse eid="REV 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6" />ምሽቲም በቅዱሳን ደም በኢየሱስ ምስክሮች ደም ሰከረችም አዠሑና፤ ባዠሑናም ግዝየ ስርም ተዴነቅሑ። <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />ተዛም መላይካ እኪ ባሬ፤ ትዴነቅ የመአሩ? የምሽቲ፣ ሒቲ የቾናትወዪም፣ ዛምኸም ሰበት ጉነን ዐሥር ቀንም ያነኖዪ የአውሬዪ ምሥጢር ኢውደኸ። <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" />ያዠዀኒ አውሬ በደረም ያነ፤ ኧሗም ኤነ፤ ባንቌ በጥልቂ ጐጀ ይወጣ፤ ተጥፋተዄም ያር። ዓለም በትኸለቅ ቀረሰም ሽመሕኖ በሕይወት መጽሐፍ ተጣፈም ያንትረኸበ ባፈር ይነብሮዪ ሰቦች አውሬዪ በደረም የነበረ፣ ኧሗም ዬነ፣ ባንቌም ይቸኝ ወሕነሑ ቲያዞ ይዴነቆ።<note caller="-" style="x"><char style="xo" closed="false">17፥8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፥7</ref>፤ <ref loc="REV 11:7">መና 11፥7</ref>፤ <ref loc="PSA 69:28">መዝ. 69፥28</ref>። </char></note> <verse eid="REV 17:8" /><verse number="9" style="v" sid="REV 17:9" />“ዚም፣ ብላት ያነን አእምሮ ይሰል። ሰበቲ ጉነን ምሽቲ ትቶናወዪ ሰበት ቈቶዎችኖ፤ <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />ሕኖም ኧሗም ሰበት ነገሥታትኖ። አምስቲ ወጠቆም፤ አቲ ነነ፤ እንጐዲ ገና አንተኘ፤ ቲቸኝ ዬክሴ ይጌቧን የቀል ግዝየው። <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />በደረም የነበረዪ ኧሗ ዬነዪ አውሬ ስሙታለኘዪ ንጉሡ፤ ሑቲም ተሰበቲ አቲ ቲኸን ተጥፋተዄ ያር።<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“ያዠኸኖ ዐሥሪ ቀን ገና መንግሥት ያንትቀበሮ፣ ዐሥር ነገሥታትኖ፤ ቢኸንም ታውሬዪጌ የቁና ሰዓት ይነግሦኸም ሥልጣን ይቌበሮ።<note caller="-" style="x"><char style="xo" closed="false">17፥12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">ዳን. 7፥24</ref>። </char></note> <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />ቁና አሳብም ነነኖ፤ ቆተሕኖ ሥልጣነሕኖም የአውሬዪ ይቦ፤ <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />ነዚሕኖ ኧጤዪ ይወጎ፤ ኧጤዪም ውራግ ይነሳኖ፤ መሳመሑ ሑቲ የጌቶች ጔታም የነገሥታት ንጉሡ፤ ተሑቲጌ ያኖ የጠሬዮዪ፣ የትሜጠሮዪ የታመኖዪም ቁናዬ ውራግ ይነሶ።”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />መላዪካዪ እኪ ባሬ፤ “ትሟግጢ ቾናትቦም ያዠኸኖ ኧጋዎቺ ያቴዞ፦ ጐሳ፣ ብዠ ሰቦች፣ ሕዝቦች ቋንቋዎችምኖ፤ <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />አውሬዪ ያዠኸኖ ዐሥር ቀንም ትሟግጢ ይጠሎያ፤ ባዶዬታን እንጨዬታን ያቀሮያ። በሠሬታን ይበሮ፤ በኧሳትም ያነዶያ። <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />የእዝጌር ቃል ይትፌጠም ስን ዕቅደሑ ይፌጥሞኸም፣ ኧሗም በቁና አሳብ ይስማሞኸም ሥልጣነሕኖም የአውሬዪ ይቦኸም ዚ አሳብ በሒነሕኖ ያነበረ እዝጌሩ።<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“ያዠኸናዪም ምሽት ባፈር ነገሥታት ᎈር ትነግሢ ወደሊ ከተማው።”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s1">የባቢሎን ወውጠቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />ተዛ አንቌ ወደል ሥልጣን ያነን እንጐድ መላይካ በሰሜ ቲወርድ አዠሑ፤ ተክብረሑ ዋምብራጣ የትነሣ አፈር በራ፤ <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" />ሑቲም በወደል ጣምባ እኪ ባረም አኸላ፤</para>
  <para style="q2" vid="REV 18:2">“ወደሊ ባቢሎን ወጠቀ! ወጠቀ!</para>
  <para style="q1" vid="REV 18:2">አጋንት ይነብርወ፣</para>
  <para style="q2" vid="REV 18:2">ሩክስ መናፍስት እንም ያድርወ<note caller="+" style="f"><char style="fr" closed="false">18፥2 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ወሕኔ ቤት </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ወሕኒ </char><char style="ft" closed="false">ይብር። </char></note>፣</para>
  <para style="q2" vid="REV 18:2">የሩክስም ያጤይፍ አንፉ እንም ያድርወ<note caller="+" style="f"><char style="fr" closed="false">18፥2 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ወሕኔ ቤት </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ወሕኒ </char><char style="ft" closed="false">ይብር። </char></note> ኸነ።<verse eid="REV 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3" />ሕዝብ እንም የዝሙቴታን ማት ወይን ደጔ ሰጦም፤</para>
  <para style="q2" vid="REV 18:3">ያፈር ነገሥታት ተሒቲጌ አምነዘሮም፤</para>
  <para style="q1" vid="REV 18:3">ያፈር ነጋዴ ተብዠ ምቾቴታን ቆት</para>
  <para style="q2" vid="REV 18:3">የትነሣ ደንገኘ ኸኖም።”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />በዛም በሰሜ እንጐድ ጣምባ እኪ ቲብር ሰማሑ፤</para>
  <para style="q1" vid="REV 18:4">ሕዝበኛ፤ በአጢያቴታ አትትገገዞኸም፣</para>
  <para style="q2" vid="REV 18:4">ተመቅሠፍቴታንም አትሰዶኸም፣</para>
  <para style="q2" vid="REV 18:4">ተሒቲ ውጦ፤<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />አጢያቴታ ሰሜ ስን ሰላም፤</para>
  <para style="q2" vid="REV 18:5">እዝጌርም ዐመጤታን አስታወሰም።<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />ባበቹ ቅጫ የሜናዬታን ዄት ኧጅ ዘብሮና፤</para>
  <para style="q2" vid="REV 18:6">የሸከተቹዪ እንም ዄት ኧጅ ክፍሎያ፤</para>
  <para style="q2" vid="REV 18:6">በቅላቀለቹም ጥወ ዄት ኧጅ ሰክቶም ቅላቅሎባ።<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />የሒቲ ክብር ድሎትም ያበቹዪ ቅጫ፣</para>
  <para style="q2" vid="REV 18:7">ሥቃይ አዘንም አቦያ፤</para>
  <para style="q1" vid="REV 18:7">በሒኔታንም እኪ ትትብር ትትነነድ፤</para>
  <para style="q2" vid="REV 18:7">“የንግሥትኸም ቾናሑም፤</para>
  <para style="q1" vid="REV 18:7">መበለትም አንከንኩ፤ ስርም</para>
  <para style="q2" vid="REV 18:7">አናዝን፤”<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />ስለኸነም ቅሥፈቴታን በቁና ከነ ይቸኖባ፤</para>
  <para style="q2" vid="REV 18:8">ሞት፣ አዘን ጋጀም ይኸንባ፤</para>
  <para style="q1" vid="REV 18:8">ይፈርድባ ጔታ እዝጌር ብርቱ ስለኸነ፣</para>
  <para style="q2" vid="REV 18:8">በሳት ትነድ።<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />“ተሽቲጌ ያምነዘሮዪ በድሎት የነብሮዪ የአፈር ነገሥታት፣ ሒቲ ትትነድ ይወጣዪ ተን ቲያዞ ስለሒቲ ይበሖ፤ ያዝኖም። <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />ሥቃዬታንም በወገና በሩቄ ቈሞም እኪ ይብሮ፤</para>
  <para style="q1" vid="REV 18:10">“አኸ ወደሊ ከተማ ወዮአኸ! ወዮአኸ!”</para>
  <para style="q2" vid="REV 18:10">አኸ ባቢሎን ብርቱዪ ከተማ፣</para>
  <para style="q1" vid="REV 18:10">ፍርዳኸ በቁና ሰዓት ውስጥ ቸኘም።<verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />ጭነተሕኖ ተዚ አንቌ ይገዛ ዬነ ስለኸነ፣ ያፈር ነጋዴ ስለሒቲ ይበሖ፤ ያዝኖ፤ <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />በመርከበሕኖ የጫነዪም ወርቅ፥ የጠገራ ብር፥ የከበረ እምን፥ ዕንቁ፥ ቀጭን ልባስ፥ ወይን ደጔ ልባስ፥ ብሻ ልባስ፥ ፈያ ሱትነት ቃር ያነን ኧጨ እንም፣ ተዝሖን ስን፣ በውድ ኧጨ፣ ተናስ፣ ተብረት ተእብነ በረድም የሸከተ ግብር እንም፣ <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />ቀረፋ፣ ቅመም፣ ከርቤ፣ ቅባት፣ ዕጣን፣ የወይን ደጔ፣ የወይራ ዘይት፣ የሸለቊ ቀማ፣ ስሬ፣ ኧሬ፣ ኧጤ፣ ፈረዝ፣ ሠረገላ፣ ዛምኸም ጉዙዎች<note caller="+" style="f"><char style="fr" closed="false">18፥13 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ዛምኸም ገግችም የሰቦች ነብሶች </char><char style="ft" closed="false">ይብር። </char></note> እንጐድም ሰቦችኖ።<verse eid="REV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14" />ነጋዴዎቺም፣ የትሜናሺ ፍርየ ታሺ ራቀም፤ ዱሬሽነታሽ ክብራሽ እንም ጠፋም፤ ተዚ አንቌ ተዠበረም ኤይቸኝ ይብሮ። <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />ነዚ ቃር በዋሰየ በሒቲ ዱሬሻ የኸኖዪ ነጋዴ ሥቃዬታን ጔኖም በሩቄ ይቈሞ፤ ሕኖም ይበሖ፤ ያዝኖም፤ <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />ጣምባሕኖ ከፍ አበኖም እኪ ይብሮ፤</para>
  <para style="q1" vid="REV 18:16">“ቀጭን ስስ ክር፣ ወይን ደጔ ብሻም ልባስ የለበሰች፣</para>
  <para style="q2" vid="REV 18:16">በወርቅ፣ በከበረ እምን በዕንቁም የደመቀች፣</para>
  <para style="q2" vid="REV 18:16">ወደሊ ከተማ ወዮውታ! ወዮውታ!<verse eid="REV 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17" />ዛ እንም ዱኒያ በቁና ሰዓት ውስጥ ጠፋ።”</para>
  <para style="p" vid="REV 18:17">መርከብ አዛዦች እንም፣ በመርከብ ያሮዪ እንም፣ የመርከብ ሜነተኞች ኑሮሕኖም በባር ᎈር ይኔግዶዪ እንም በሩቌ ይቈሞ።<verse eid="REV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 18:18" />ሒቲ ትትነድ ይወጣዪ ተን ቲያዞ፣ የዚኸም ያነ ወደል ከተማ ስርም ቤቴ ነነ? ቲብሮ ው ይብሮ። <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />በጉነነሕኖም ᎈር አዋራ ንሰነሶም ቲበሖ ቲያዝኖም እኪ ባሮም ው ባሮ፤</para>
  <para style="q1" vid="REV 18:19">በባር ᎈር መርከብ ያነኖ እንም፣</para>
  <para style="q2" vid="REV 18:19">በሒቲም ዱኒያ ዱሬሻ የኸኖ፣</para>
  <para style="q2" vid="REV 18:19">የወደሊ ከተማ ወዮውታ! ወዮውታ!</para>
  <para style="q1" vid="REV 18:19">በቁና ሰዓት ውስጥ ጠፋም።<verse eid="REV 18:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20" />ሰሜ፤ በሒቲ ᎈር ስርም ተብላለቆ</para>
  <para style="q2" vid="REV 18:20">ቅዱሳን፣ ሐዋርያት ነብዮችም ስርም ተብላለቆ</para>
  <para style="q1" vid="REV 18:20">ባሑ ᎈር ባሰላቹ ቃር</para>
  <para style="q2" vid="REV 18:20">እዝጌር ፈረደባም።<verse eid="REV 18:20" /></para>
  <para style="b" />
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />ተዛም አት ብርቱ መላይካ፣ ወደል የወፍጨ እምን ይመስር እምን ነሣም ተባሬ ኧረጔን፤ እኪም ባረ፤</para>
  <para style="q1" vid="REV 18:21">“ወደሊ ከተማ ባቢሎን፣</para>
  <para style="q2" vid="REV 18:21">እኪ ባነ ቆት ይወጥቅ፤</para>
  <para style="q2" vid="REV 18:21">ተዠበረችም አትትረከብ።<verse eid="REV 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22" />የበገና ደርዳሪ የሙዚቀኞችም ጣምባ፣</para>
  <para style="q2" vid="REV 18:22">የአንዱር የጡሩምባ ነፊዎች ጣምባም፣</para>
  <para style="q1" vid="REV 18:22">ኧሗም ባሺ ውስጥ ኤይሴማ፤</para>
  <para style="q2" vid="REV 18:22">የጅ ብላተኘ፣</para>
  <para style="q1" vid="REV 18:22">ኧሗም ባሺ ውስጥ ኤይትረከብ፤</para>
  <para style="q2" vid="REV 18:22">የወፍጨ ጣምባ፣</para>
  <para style="q2" vid="REV 18:22">ተዚ አንቌ ባሺ ውስጥ ኤይሴማ።<verse eid="REV 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23" />የመብራት ብራን፣</para>
  <para style="q2" vid="REV 18:23">ኧሗም ባሺ ውስጥ ኤይበራ፤</para>
  <para style="q1" vid="REV 18:23">የሙሽራ የሙሽሪቲ ጣምባም፣</para>
  <para style="q2" vid="REV 18:23">በዚ አንቌ ባሺ ውስጥ ኤይሴማ፤</para>
  <para style="q1" vid="REV 18:23">ነጋዴያሽ የዓለም ግድድር ሰቦች ባኖ፤</para>
  <para style="q2" vid="REV 18:23">ባስማታሽ ሕዝብ እንም ሳቶም።<verse eid="REV 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24" />በሒቲም ውስጥ የነብዮች የቅዱሳንም፣</para>
  <para style="q2" vid="REV 18:24">ባፈር እንም የቈጠርዮዪ ደም ተረከበ።”<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="s1">ሐሌ ሉያ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />ተዛ አንቌ እኪ ይብር የብዠ ሰቦች ጣምባ ይመስር ወደል ጣምባ በሰሜ እኪ ቲብር ሰማሑ፤</para>
  <para style="q1" vid="REV 19:1">ሐሌ ሉያ!</para>
  <para style="q1" vid="REV 19:1">ዋትርፍ፣ ክብር ቆትም የአምላከናው፤<verse eid="REV 19:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="REV 19:2" />ፍርደሑ የኢን ጽድቅሙ፤</para>
  <para style="q1" vid="REV 19:2">በዝሙቴታን አፈሪ ያረከሰቺ፣</para>
  <para style="q2" vid="REV 19:2">ወደሊ አመንዝራ ፈረደባም፤</para>
  <para style="q1" vid="REV 19:2">የአገልጋዮቸሑም ደም ተቤቀለናም።<verse eid="REV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3" />ኧሗም እኪ ባሮ፤</para>
  <para style="q1" vid="REV 19:3">“ሐሌ ሉያ!</para>
  <para style="q1" vid="REV 19:3">ተን ተሒቲ ተዘላለም ዘላለም ስን ይወጣ።”<verse eid="REV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4" />ሑያ አርበቲ የገኝ ባሊቅ አርበቲ ሕያው ኸልቅም በዙፋነሑ ᎈር የቾናዪ አምላክ ወጠቆም ሰገዶ፤ እኪም ባሮ፤</para>
  <para style="q1" vid="REV 19:4">“አሜን፣ ሐሌ ሉያ!”<verse eid="REV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />ተዛ አንቌ እኪ ይብር ጣምባ በዙፋነሑ ወጣ፤</para>
  <para style="q1" vid="REV 19:5">“አሑ አገልጋዮቸሑ እንም፣</para>
  <para style="q2" vid="REV 19:5">የሑቲ ትጔኖ፣</para>
  <para style="q1" vid="REV 19:5">ቅስስን ንቅም፣</para>
  <para style="q2" vid="REV 19:5">የአምላከና አመስግኖ!”<verse eid="REV 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6" />ኧሗም የብዠ ሕዝብ ጣምባ፣ በሓይለኘ ይወርድ ኧጋ ጣምባኸም፣ የብረታ እንግብግቢት ጣምባ ይመስር እኪ ቲብር ሰማሑ፤</para>
  <para style="q1" vid="REV 19:6">ሐሌ ሉያ!</para>
  <para style="q2" vid="REV 19:6">እንም ይችል ጔታ አምላከና ነገሠም።<verse eid="REV 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7" />የጤዪ ሸቤ የሰላ ስለኸነ፣</para>
  <para style="q2" vid="REV 19:7">የሑቲም ሙሽራ ነብሴታን ያዝጋጀች ስለኸነ፣</para>
  <para style="q1" vid="REV 19:7">ንትብላለቅነ፤ ስርም ንትብላለቅነ</para>
  <para style="q2" vid="REV 19:7">ክብርም ናብኔ።<verse eid="REV 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8" />ያንብራጣዪ ንጡ፣</para>
  <para style="p" vid="REV 19:8">በስስ ክር የሸከተ ቀጭን ልባስ ትለብስኸም አቡያ።</para>
  <para style="m" vid="REV 19:8">በስስ ክር የሸከተዪ ቀጭን ልባስ የቅዱሳን የጽድቅ ሜናው።<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />መላይካዪም፣ “ ‘ተጤዪ ሸቤዬ ኧርባት የጠሬዮ የትባሮኮኖ’ በርም ጣፍ” ባሬ፤ ቄጠለም፣ “ነዚሕኖ የእዝጌር የኢነተኘ ቃሉ” ባሬ።<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />እያም የመላይካዪ ኧሰጉድነዬ በግረሑ ተት ወጠቅኩ፤ ሑቲም፣ “ታው! ዚ አትሠክት! እያ ታኸም የኢየሱስ ምስክር ተጠበጦዪ ጐባቢታኸጌ አገልጋይንኩ፤ የእዝጌር ስግድ፤ የኢየሱስ ምስክር የትምቢት መንፈሱ” ባሬ።<verse eid="REV 19:10" /></para>
  <para style="s1">በነጨ ፈረዝ ᎈር የቾናዪ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />ተዛም ሰሜ ተከፈተም አዠሑ፤ ዘ አት ነጨ ፈረዝ ባነ፤ በፈረዚም ᎈር፣ “ታማኝ የኢነተኘም” ይቡሪ ቾናም ባነ፤ ሑቲም በጽድቅ ይፈርድ፤ ይትዋጋም። <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />ዔነሑ የኧሳት ነበልባልኸምኖ፤ በጉነነሑ ᎈር ብዠ ዘውዶች ነኖ። ሑቲ አንኸንም ሟንም ኤይሒን ሽም በሑቲ ᎈር ተጣፈም። <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />ሑቲ በደም የጬᎉ ልባስ ለበሰም፤ ሽመሑም የእዝጌር ቃሉ። <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />የሰሜም ሠራዊት ነጨ፣ ንጡ በስስ ክር የሸከተ ቀጭን ልባስ ለበሶም፣ በነጨ ነጨ ፈረዝ ᎈር ቾኖም ይትዄተሎይ ባነ። <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" />ሕዝብ ይወካወ ቡሊ ሰይፍ ባፈሑ ወጣ፤ “በብረት እንጣርም ይገዛኖ።” ሑቲም እንም ይችል የኸነዪ የእዝጌር የብረታ ማት ወይን ይሰጭᎄ ይቆቅርᎄ ይረግጥ።<verse eid="REV 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 19:16" />በልባሰሑ በሰረባሑም ᎈር እኪ ይብር ሽም ተጣፈም፤</para>
  <para style="pc" vid="REV 19:16">“የነገሥታት ንጉሥ የጌቶችም ጔታ።”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />ቄጠለም አት መላይካ በጬት ውስጥ ቈመም አዠሑ፤ ሑቲም በሰሜ ግብት ይበሮ አንፉ እንም እኪ ቲብር በወደል ጣምባ አኸላ፤ “ኔሑ፤ ተወደሊ የእዝጌር ኧርባቴ ተሰብሰቦ፤ <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />ትስበሰቦዪም የነገሥታት በሰር፣ ያርብ አዛዦቺ በሰር፣ የብረቶ ሰቦች በሰር፣ የፈረዝ የፈረዘኞችም በሰር ዛምኸም የሰቦች እንም፣ ዚም የጌቶች የጉዙዎችም፣ ይንስ የንቅ በሰር ትበሮኸሙ።”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />ተዛ አንቌ አውሬዪ፣ የአፈር ነገሥታትም፥ ወታደሮቸሕኖም በነጨዪ ፈረዝ ᎈር ተቶናዪ ተአርበሕኖ የወትዋጋም ተስበሰቦም አዠሑ፤ <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" />ቢኸንም አውሬዪ ተጠበጠ፤ ተሑቲጌ፤ ቢፍተሑ ታምራዊ ምልክት ይሸክት የነበረዪ ባጢለተኘዪ ነብይ ጠᎄጪ። በዚሕኖ ምልክት ያውሬዪ ምልክት የትቌበሮ የምስሊ የሰገዶዪ አሰተ። ዄቲም በሕይወት ትናኖ በዲን ቲነዲ የሳት ባሬ አደጉዮ። <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />የቀኖዪ ኧሗም በፈረዚ ᎈር ተቾናዪ አፍ ቢወጣዪ ሰይፍ ቈጠርዮ፤ አንፉዎች እንም በሠረሕኖ በኖም ጦፎ።<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s1">የሺ ዓመቲ መንግሥት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />የጥልቂ ይከፉችᎄዪ ወደል ሰንሰለት በጀሑ የጠበጠ መላይካ በሰሜ ቲወርድ አዠሑ፤ <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />ሑቲም የድረዪ እንድወደረ፣ ዘንዶዪ፣ ወበርም ዳያቢሎስ የሼጣንም ጠበጠም ሺ ዓመት አጐደን።<note caller="-" style="x"><char style="xo" closed="false">20፥2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ዘፍ. 3፥1</ref>። </char></note> <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ሺዪ ዓመት ይትፌጠም ስን ተሗ ቀረሰም የሕዝቢ ኤያሰትኸም ተጥልቂዬ አደጐን፤ አጨን፤ በሑቲም ᎈር ማተብ ሸከተወ። ተዛም አንቌ የቀል ግዝየ ይፈታዬ ይጌቧን።<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />ቄጠለም ዙፋኖቺ አዠሑ፤ በዙፋኖቺም ᎈር የወፍርድ ሥልጣን ያቡዮ ሰቦች ቾኖም ባነ፤ ኧሗም ስለኢየሱስ ምስክር ስለእዝጌር ቃል በሴየፎዪ የᎀቶዪ ሰቦች ነብስያሕኖ አዠሑ። ሕኖ የአውሬዪ የሑቲም ምስያ አንሰገዶ፤ በግንባረሕኖ በጀሕኖም ᎈር የአውሬዪ ምልክት አንትቀበሮ፤ ሕኖም ተሞት ተነሦም ተክርስቶስጌ ሺ ዓመት ነገሦ።<note caller="-" style="x"><char style="xo" closed="false">20፥4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">ዳን. 7፥9</ref>፣<ref loc="DAN 7:22">22</ref>። </char></note> <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />የቀኖዪ ሟቾቺም ሺዪ ዓመት ይትፌጠም ስን ተሞት አንተንሦ። ዚ የመጀመሪያዪ ትንሣኤው። <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />በመጀመሪያዪ ትንሣኤ ይሰዶ ይኸኖ የትምሰገኖ ቅዱሳንኖ። ዄታለኘዪ ሞት በሕኖ ᎈር ሥልጣን ኤነን፤ ቢኸንም የእዝጌር የክርስቶስ ካሕናት ይኸኖ፤ ተክርስቶስጌ ሺ ዓመት ይነግሦ።<verse eid="REV 20:6" /></para>
  <para style="s1">የሼይጣን ወትቌም</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />ሺ ዓመት ቲፌጠመ ሼጣን ተጉጀኘተሑ ይትፈታ፤ <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />ባርበቲ ያፈር ማዘን ያኖዪ ሕዝቢ፦ ጎግ ማጎግም ቲያሰት የአርብ ያሴልፎዬ ይወጣ፤ ቁጥረሕኖ በባር ጥግ ያነ አሸዋኸሙ። <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />ሕኖም ታፈሬ እንም ወጦም የቅዱሳን ሰፈርም የትወደደዪ ከተማ ኸበቦ፤ ቢኸንም ኧሳት በሰሜ ወረደም በናኖ። <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />ያሰተኖ ዳቡሎስ፣ አውሬዪ ባጢለተኘ ነብይም ታኖᎄ ተኧሳቲ ተዲን ባሬም አደጒ፤ ሕኖም ክናን ተምሳር ተዘላለም ዘላለም ስን ይሥቃዮ።<verse eid="REV 20:10" /></para>
  <para style="s1">የሟቾቺ ተፈረደቦ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />ተዛ አንቌ ወደል ነጨ ዙፋን በሑቲም ᎈር የቾናዪ አዠሑ። አፈር ተሰሜም ቲፍተሑ ሰኮ፤ መደርም አንትረኸበኖ። <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />የሟቾቺ፣ ንቅ ተንስ በዙፋኒ ኢፍቴ ቈሞም አዠሑ፤ መጣፍም ተከፈቶ። ኧንጐድ መጽሐፍ፣ ሑቲም የሕይወት መጽሐፍ ተከፈተ፤ የሟቾቺም በመጽሐፊ ተጣፈም በትረከበዪ መሠረት የሜናሕኖ ቅጫኸም ተፈረደቦ። <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />ባርም በውስጠሑ የነበሮዪ የሟቾቺ አበ፤ ሞት ሲኦልም በሕኖ ውስጥ የነበሮዪ ሟቾቺ አቦ፤ እያታቲም የሜናሑ ቅጫኸም ተፈረደወ። <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />ተዛም አንቌ ሞት ሲኦልም ተእሳት ባሬ አደጉዮ፤ የሳቲ ባር ዄታለኘዪ ሞቱ። <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />ሽመሑ በሕይወት መጽሐፍ ተጣፈም ያንትረኸበ እንም ተሳት ባሬ አደጒ።<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s1">ገደሪ ኢየሩሳሌም</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />ተዛ አንቌ ገደር ሰሜ ገደር አፈርም አዠሑ፤ የመጀመሪያዪ ሰሜ የመጀመሪያዪ አፈርም አለፎም፤ ባርም ተሗ ቀረሰም ኤነብር።<note caller="-" style="x"><char style="xo" closed="false">21፥1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፥17</ref>፤ <ref loc="ISA 66:22">66፥22</ref>፤ <ref loc="ISA 3:13">3፥13</ref>። </char></note> <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" />ቅድስቲ ከተማ፣ ገደሪ ኢየሩሳሌም የምሴታን ያደመቁያ ሙሽሪኸም ተዝጋጀችም በሰሜ በእዝጌሬ ትትወርድ አዠሑ።<note caller="-" style="x"><char style="xo" closed="false">21፥2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፥1</ref>፤ <ref loc="ISA 61:10">61፥10</ref>፤ <ref loc="REV 3:12">መና 3፥12</ref>። </char></note> <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />ኧሗም እኪ ይብር ወደል ጣምባ በዙፋኒ ቲወጣ ሰማሑ፤ “ዘ፤ እዝጌር ያድር በሰቦች ግብቱ፤ ተሕኖምጌ ይነብር፤ ሕኖም ሕዝበሑ ይኸኖ፤ እዝጌር ነብሰሑ ተሕኖጌ ይነብር፤ አምላከሕኖም ይኸን።<note caller="-" style="x"><char style="xo" closed="false">21፥3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ሕዝ. 37፥27</ref>፤ <ref loc="LEV 26:11-12">ዘሌ. 26፥11-12</ref>። </char></note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />ኢንባ እንም ቴነሕኖ ይጠርግ፤ ተሗ ቀረሰም ሞት አዘን አልፋታ ሥቃይም ኤይነብር፤ ይፍቴዪ ሥራት አለፈም።”<note caller="-" style="x"><char style="xo" closed="false">21፥4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25፥8</ref>፤ <ref loc="ISA 35:10">35፥10</ref>፤ <ref loc="ISA 65:19">65፥19</ref>። </char></note><verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />በዙፋኒ ᎈር የቾናዪም፣ “ዘ፤ እያ እንም ቃር ገደር ኧሸክት” ባረ፤ ኧሗም፣ “ዚ ቃል የታመነ የኢንም ስለኸነ ጣፍ” ባረ። <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />እኪም ባሬ፤ “ተፌጠመ አልፋ ዖሜጋም፣ የመጀመሪያዪ የመጨረሻዪም እያትንኩ፤ የጠማ ተሕይወት ኧጋ ምንጭ ፍርየ ኤባን ዋጋ ኢብ።<note caller="-" style="x"><char style="xo" closed="false">21፥6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፥1</ref>። </char></note> <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />ውራግ ይነሣ ዚ እንም ይወርስ፤ እያም አምላክ ኧዀን፤ ሑቲም ትኸኛ ይኸን።<note caller="-" style="x"><char style="xo" closed="false">21፥7 </char><char style="xt" closed="false"><ref loc="REV 7:14">7፥14</ref>፤ <ref loc="PSA 89:26-27">መዝ. 89፥26-27</ref>። </char></note> <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />ቢኸንም ጊናታሞች፣ ኤያምኖ፣ ሩክሶች፣ ሰብ ይቀጥሮ፣ አመንዝሮች፣ አስማተኞች፣ ጣዖት ያመልኮዪ፣ ባጢለተኞች እንም ዕጣሕኖ በዲን<note caller="+" style="f"><char style="fr" closed="false">21፥8 </char><char style="ft" closed="false">ዲን ወበር ስርም ብሳት የጋለ እምን ኸማት ሙ ወበሩ። </char></note> ብሳት ባርም ውስጥ ወውጠቅ ይኸን። ዚም ዄታለኘዪ ሞቱ።”<verse eid="REV 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />ሰበቲ የመጨረሻ መቅሠፍት የᎀላቦ ሰበቲ ጥወ ተጠበጦዪ ተሰበቲ መላይካ አቲ ቸኘም “ኔኸ! የጤዪ ምሽት የኸነቺ ሙሽራ አቴዥኸ” ባሬ። <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />በመንፈስም ታት ወደል ገሊፍ ቈቶዬ ወሰዴም፣ ቅድስቲ ከተማ ኢየሩሳሌም በሰሜ በእዝጌሬ ቲወርድ አቴዤ።<note caller="-" style="x"><char style="xo" closed="false">21፥10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">ሕዝ. 40፥2</ref>። </char></note> <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />ሑቲም በእዝጌር ክብር ያበራ ባነ፤ የብራነውታም ወድምቅ ስርም የከበረ እምን የኢያሰጲድ፣ የመስታወትኸም የጠራ ባነ። <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />ዐሥረ ዄት በር ያኖይ ወደል ገሊፍም የግንብ ኧጭር ቧነን፤ በበሪም ᎈር ዐሥረ ዄት መላይካ ቈሞም የዐሥረ ዄቲ የእስራኤል ነገዶች ሽም ጣፉቦም ባነ። <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />በምሥራቅ ሦስት በር፣ በሰሜን ሦስት በር፣ በደቡብ ሦስት በር፣ በምዕራብ ሦስት በር ባኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥12-13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">ሕዝ. 48፥30-35</ref>። </char></note> <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />የከተማዪ የግንብ ኧጭር ዐሥረ ዄት መሠረት ባኖይ፤ በሕኖም ᎈር የዐሥረ ዄቲ የጤዪ ሐዋርያት ሽም ጣᎉም ባነ።<verse eid="REV 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15" />ቲያጌ ይዝነግ የነበረዪ መላይካ የከተማዪ በር የግንብ ኧጭር ይሌካወ የወርቅ ዘንግ ቧነን። <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />ከተማዪም ገሊፍነተሑ ስፋተሑም ቂጦ ኸነም አርበት ማእዘን ባነ። መላይካዪም ተከተማዪ በዘንገሑ ቃጣ፤ ገሊፍነተሑ ዐሥራ ዄት ሺ አርበት መቶ ኪሎ ሜትር ቅጫ ኸነ፤ ስፋተሑ ከፍታውታሑም ዛም ቅጫ ኸነ። <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />ኧሗም የከተማዪ የግንብ ኧጭር ቃጣ፤ ገሊፍነተሑም መላይካ ቢቃጣወዪ በሰብ መለኪያ መቶ አርባ አርበት ሕረ<note caller="+" style="f"><char style="fr" closed="false">21፥17 </char><char style="ft" closed="false">ሥልሳ አምስት ሜትር ቅጫ ይኸን። </char></note> ባነ። <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />የግንቢ ኧጭር ዬጠሪ በኢያሰጲድ ባነ፤ ከተማዪም የመስታወትኸም ንጡ በኸነ ወርቅ የሸከተ ባነ። <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />የከተማዪ የግንብ ኧጭር መሠረቶች ብንምኸማት የከበረ እምን ይደንቅ ባነ፤ የመጀመሪያዪ መሠረት ኢያሰጲድ፣ ዄታለኘዪ ሰንፔር፣ ሦስታለኘዪ ኬልቄዶን፣ አርበታለኘዪ መረግድ፣ <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />አምስታለኘዪ ሰርዶንክስ፣ ስድስታለኘዪ ሰርድዮን፣ ሰበታለኘዪ ክርስቲሎቤ፣ ስሙታለኘዪ ቢረሌ፣ ዠጠነኘዪ ወራውሬ፣ ዐሥረኘዪ ክርስጵራስስ፣ ዐሥራ አተኘዪ ያክንት፣ ዐሥራ ዄታለኘዪ አሜቴስጢኖስ<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="ft" closed="false">በዚሕኖ የከበሮ እምኖች ግብት ያታቶቺ ሟንነት በውል ኤይትኴር። </char></note> ባነ። <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />ዐሥራ ዄቲ በር ዐሥራ ዄት ዕንቁ ባኖ፤ እያታቲም በር በቁና ዕንቁ የሸከተ ባነ። የከተማዪም ውር ኤማ የመስተዋት ብራን ያችላልፍ ንጡ ወርቅ ባነ።<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />እንም ይችል ጔታ አምላክ ኧጤዪም መቅደሰሑ ስለኸኖ፣ በከተማዪ ውስጥ ቤተ መቅደስ አነዠሑ። <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />የእዝጌር ክብር ብራን ይቡ ስለኸነ ኧጤዪም መብራተሑ ስለኸነ፣ ከተማዪ ጬት ጠናቃም ያበሮነኸም ኤያሸን።<note caller="-" style="x"><char style="xo" closed="false">21፥23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ. 60፥19-20</ref>። </char></note> <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />ሕዝቢ በብራነሑ ይዥባበሮ፤ ያፈር ነገሥታትም ክብረሕኖ ተሑቲዬ ያቸኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">ኢሳ. 60፥3</ref>። </char></note> <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />በዛ ምሳር ኤነ ስለኸነ፣ በረሑ በሟንም ከነ ኤያጪ። <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />የሕዝቢ ግርማ ክብርም ተሑቲዬ ይገቦ፤<note caller="-" style="x"><char style="xo" closed="false">21፥25-26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">ኢሳ. 60፥11</ref>። </char></note> <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />በጤዪ የሕይወት መጽሐፍ የጣፎዪ አንኸንም፣ ሩኩሰት ይሸክት ባጢል ይዝነግ እንም ኤይቡየወ።<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="s1">የሕይወት ኧድየ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />ተዛ አንቌ መላዪካዪ ተእዝጌር ተጤዪም ዙፋን ይወጣዪ የመስታወትኸም የጠለለ የሕይወት ኧጋ ኧዲየ አቴዤም፤<note caller="-" style="x"><char style="xo" closed="false">22፥1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፥1</ref>፤ <ref loc="ZEC 14:8">ዘካ. 14፥8</ref>። </char></note> <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />ኧዲየዪም በከተማዪ ውር ኤማ ግብት ይፈስ ባነ። በድየዪ ጉራ ተከነ በመሬት መሬተሑ ቲያወርድ ዐሥረ ዄትጌ ፍርየ ያወርድ የሕይወት ኧጨ ባነ፤ የጨዪም ቅጠል ሕዝቢ ፈያ ይኸኖᎄ ባነ።<note caller="-" style="x"><char style="xo" closed="false">22፥2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ዘፍ. 2፥9</ref>፤ <ref loc="EZK 47:12">ሕዝ. 47፥12</ref>። </char></note> <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />ተሗ ቀረሰም ስድብ ስርም ኤነብር፤ የእዝጌር የጤዪም ዙፋን በከተማዪ ውስጥ ይኸን፤ አገልጋዮቸሑም ያመልኮይ፤<note caller="-" style="x"><char style="xo" closed="false">22፥3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">ዘካ. 14፥11</ref>። </char></note> <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />ኢፍተሑ ያዞ፤ ሽመሑም በግምባረሕኖ ᎈር ይኸን። <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />ተሗ ቀረሰም ምሳር ኤነብር፤ ጔታ አምላክ ያበራኖ ስለኸነ የመብራት የጬትም ብራን ኤያሸኖ፤ ተዘለዓለም ዘለዓለም ስን ይነግሦ።<note caller="-" style="x"><char style="xo" closed="false">22፥5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">ኢሳ. 60፥19</ref>፤ <ref loc="DAN 7:18">ዳን. 7፥18</ref>። </char></note><verse eid="REV 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />መላዪካዪ፣ “ነዚሕኖ ቃል የታመኖ የኢነተኘምኖ፤ የነብዮች መናፍስት ጔታ አምላክ በቁርብ ይኸኒ ዘንጋ የአገልጋዮቸሑ ያቴዥኸም መላይካ ላኸም” ባሬ።<verse eid="REV 22:6" /></para>
  <para style="s1">ኢየሱስ ይቸኝ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“ዘ፤ ከሞ ኧቸኝ፤ የዚ መጽሐፍ የትንቢት ቃል ይቅየ የትባረከው።”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />ነዚሕኖ ዘንጋ የሰማሑ ያዠሑም እያ ዮሐንስንኩ። ነዚሕኖ ዘንጋ በሰማሑ ባዠሑም ግዝየ፣ ነዚሕኖ ዘንጋ ያቴዤ መላይካ ኧሰጉድነዬ በግረሑ ተት ተደፋሑ፤ <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />መላይካዪም፤ “ታው፤ ዚ አትሰክት እያ ታኸ ተጐባቢታኸም ተነብዮችጌ የዚ መጽሐፍ ቃል ቲቅሮዪ እንጌ አገልጋይንኩ፤ የእዝጌር ስግድ!” ባሬ። <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />እኪ ባሬ፤ “ግዝየሑ የሰላ ስለኸነ፤ የዚ መጽሐፍ የትንቢት ቃል በማተብ አትጭን፤ <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />ዐመጠኘዪ በዐመጠሑ የቀጥል፤ ሩኩሲም የርከስ፤ ጻድቂም የጽደቅ፤ ቅዱሲም የትቀደስ።”<note caller="-" style="x"><char style="xo" closed="false">22፥11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">ዳን. 12፥10</ref>። </char></note><verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“ዘ፤ ሒንጌም ከሞ ኧቸኝ፤ ዋጋኛ ቢያዬ ነነ፤ አትባቲም የሜናሑኸም ኧከፉል። <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" />አልፋ ዖሜጋም፣ ይፍቴዪ ያንቌዪም፣ መጀመሪያዪ መጨረሻዪም እያትንኩ።<verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />“ተሕይወት ኧጨዬ የወስላ በበረሑ ኤማ ተከተማዪዬ የወግባ መብት ይነብሮኸም ልባሰሕኖ ያጥቦ የትባሮኮኖ። <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />ጊየዎች፣ አስማተኞች፣ ይሟግጦ፣ ሰብ ይቀጥሮ፣ ጣዖት ያመልኮ፣ ውሸት ይወዶ በባጢል ኤማ ያሮ እንም ተከተማዪ ውጪ ነኖ።<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“እያ ኢየሱስ ነዚ ዘንጋ ይምሰክርኸም መላይካኛ የአብያተ ክርስቲያናት ላክሑንም። እያ የዳዊት ጨኘት ዘር ዝሬትምንኩ፣ ያበራ የዛኘት ኰኰብንኩ።”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />መንፈስ ሙሽራዪም፣ “ኔኸ” ይብሮ፤ ይሰማም፣ “ኔኸ” የበር፤ የጠሟን እንም የተኝ፤ ይሸ እንም የሕይወት ኧጋ በነጣ የውስድ።<verse eid="REV 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />የዚ መጽሐፍ የትምቢት ቃል ይሰማ እንም አጥኔቅቅ፤ ሟንም በዚ ቃል ᎈር አት ቃር ቢደብር፣ እዝጌር በዚ መጽሐፍ የጣፎዪ ቅስፈቶች ይደብርወ፤ <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />ሟንም በዚ የትምቢት መጽሐፍ ተጣፎዪ ቃል አት ቃር ቢያቀብል፣ እዝጌር በዚ መጽሐፍ ተጣፎዪ ተሕይወት ኧጨ ተቅድስቲ ከተማም ዕድለሑ ያቀብልወ።<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ነዚ ዘንጋ ይምሰክሪ፣ “ኤክ፣ ሒንጌም ከሞ ኧቸኝ” ይብር።</para>
  <para style="p" vid="REV 22:20">አሜን፤ ጔታ ኢየሱስ፤ ኔኸ።<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />የጔታ የኢየሱስ ጸጋ ተእዝጌር ሕዝብጌ<note caller="+" style="f"><char style="fr" closed="false">22፥21 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ተቅዱሳን ጌ የሕን </char><char style="ft" closed="false">ይብሮ። </char></note> የሕን፤ አሜን።<note caller="+" style="f"><char style="fr" closed="false">22፥21 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">አሜን </char><char style="ft" closed="false">ይብሪ ኤይደብሮ። </char></note><note caller="+" style="f"><char style="fr" closed="false">22፥21 </char><char style="fqa" closed="false">ትንማሑ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “ትንም” ቲብሮ እንጐድ “በእዝጌር ሕዝብ” ይብሮ፤ “በእዝጌር ሕዝብ እንም” ይብሮዪም ነኖ። </char></note><verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>