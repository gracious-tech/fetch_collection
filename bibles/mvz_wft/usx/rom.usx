<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">Mesqan New Testament</book>
  <para style="h">ተሮም ሰቦቼ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ሮም ሰቦቼ</para>
  <para style="toc2">ተሮም ሰቦቼ</para>
  <para style="toc3">ሮም</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተሮም ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የሐዋርያዪ የጳውሎስ መልክት ተሮም ሰቦቼ የጣፈዪ ጳውሎስ በሮም ይትረከቢ ቤተ ክርስቲያን ይርኸቦዬ ዕቅድ የነᎄረን ስለኸነ ተዝጋዶም ይቅሮይኸም የወሰክቱ። የጳውሎስ ዕቅድ በሮም ታኖ ምእመናንጌ የቀል ግዝየ በሸከተ አንቌ በሕኖ ኧጉዣ ተስፔኔ የወወር ባነ፤ ስለክርስትና እምነት የትሬዳኒ ክርስቲያኖች በሕይወተሕኖ ሜና ይሸክቶᎄ ስለኸነ የክርስትና ትምርት ሐለት በዋፍታታ ጣፈም፤ የጳውሎስ መልክት በትሟላ ሐለት ይትረከብ በዚ መልክቱ።</para>
  <para style="ip">ጳውሎስ በሮም ታኖዪ ምእመናኔ ሰላምታውታን ባሰላ አንቌ ይጤልይኖኸም ተስፋ ባበኖጌ የመልክተሑ እንም ዘንጋ (1፥17) “በእዝጌር ይትረከብ ጽድቅ በእምነት የኸነኸም በወንጌል ተገለጠም” ይብሪ ቃል ወሕነሑ ያትምሌክት።</para>
  <para style="ip">ተዛ አንቌ ጳውሎስ ዚ አሳብ አፍታታም ይጠፍ፤ አይሑድም ኸኖ አሕዛብ እንም የአጢያት ተገዢ ስለኸኖ ተእዝጌርጌ ወታረቅ ይነብርቦ፤ ሰቦች ተእዝጌርጌ ይታረቆዬ ይችሎ በኢየሱስ ክርስቶስ በወምኑ፤ የዚም ተእዝጌርጌ ይምሠርቶዪ ገደር ሩሕቦት ገደር ኑሮ ስለወሕነሑ ጳውሎስ በዋፍታታ ያትሬዳ። አማኝ ተእዝጌርጌ ሰላም ይነቡር፤ በእዝጌርም መንፈስ መሳ ተአጢያትም ተሞት ቆት ነጣ ያወጣ፤ ተም. 5—8 ስን ጳውሎስ የእዝጌር ሕጊ በአማኞች ሕይወት ይሸኩቺ የእዝጌር መንፈስ ቆት ዓላማሑ ምን የኸነኸም ይገልጥ፤ ተዛም በወቀጥል ጳውሎስ “እዝጌር የሰብ ዝሬት ቧነን ዕቅድ ውስጥ አይሑድም አሕዛብ ምንኸም ይትለፈቆዬ ይችሎ?” ይብሪ ጥያኤ መልስ የዋብ ይትጋደል።</para>
  <para style="ip">ዠበረም ጳውሎስ የጐለጠንኸም አይሑድ የኢየሱስ ቴይቌበሮይ ወቂየሕኖ የእዝጌር ዕቅዱ፤ ዚም የኸነ በኢየሱስ ክርስቶስ መሳ እዝጌር በጐለጠን የዋትርፍ ጸጋ እንም የሰብ ዝሬት የዋስትፉ። የሕን አንኸንም አይሑድ የኢየሱስ ይቌበሮᎄ ግዝየ ይቸኝኸም ጳውሎስ ያምን ባነ፤ በመጨረሻም ጳውሎስ በክርስትና ሕይወት ምንኸም ወንብር ይጌባኸም፥ በተለይም ምእመናን ነብስ በነብሰሕኖ ባነኖ ሩሕቦት ይትዋደዶᎄ ኤማ ወትኸተል ይጌባኖኸም ያትሬዳ፤ የእዝጌር ስለዋገልግል፥ ክርስቲያኖች የገኘሕኖም ነብስ በነብሰሕኖም ስላነኖ አላፊነትም፥ በሕሊና መሳ ይትነሦ ጥያኤ በዋፍታታ ያትሬዳ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">የመጽሐፊ ፍርየ አሳብ ይቈርሽᎄ <char style="ior"><ref loc="ROM 1:1-17">1፥1-17</ref></char></para>
  <para style="io1">ወትርፍ የሰብ ትኸ ያሸኸም <char style="ior"><ref loc="ROM 1:18-3:20">1፥18—3፥20</ref> </char></para>
  <para style="io1">እዝጌር ያተርፍወ ኤማ <char style="ior"><ref loc="ROM 3:21-4:25">3፥21—4፥25</ref></char></para>
  <para style="io1">በክርስቶስ ይትረከብ ገደር ሕይወት <char style="ior"><ref loc="ROM 5:1-8:39">5፥1—8፥39</ref> </char></para>
  <para style="io1">እስራኤል በእዝጌር ዕቅድ <char style="ior"><ref loc="ROM 9:1-11:36">9፥1—11፥36</ref></char></para>
  <para style="io1">የክርስትና አመል <char style="ior"><ref loc="ROM 12:1-15:13">12፥1—15፥13</ref> </char></para>
  <para style="io1">ያጥቋልልᎄዪ ሰላምም <char style="ior"><ref loc="ROM 15:14-16:27">15፥14—16፥27</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />የኢየሱስ ክርስቶስ አገልጋይ ተኸነዪ፥ የሐዋርያነት ተጠራዪ፥ የእዝጌርም ወንጌል የዋትመር ተትሜጠረዪ ተጳውሎስ የትላኸ፤ <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />ዚም ወንጌል እዝጌር በነብዮቺ መሳነት በቅዱሳት መጽሐፍቶች በደረም ያᎄን የተስፋ ቃሉ። <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />ወንጌሊ ስለትኸሑ፣ በገገሑ ተዳዊት ዘር ወጠኘሑ ያቴዥ፣ <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />ዛምኸም ጔታና ኢየሱስ ክርስቶስ በቅድስናውታ መንፈስ<note caller="+" style="f"><char style="fr" closed="false">1፥4 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በቅድስናሑ መንፈስ</char></note> ተሞት ተወተንሣሑ የእዝጌር ትኸ ወሕነሑ በወደል ቆተሑ ተዄረ። <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />ስለክርስቶስ ሽም አሕዛብ እንም ያምኖኸም ይታዘዞኸም የወሰክት በሑቲ መሳ የሐዋርያነት ያበቃነዪም ጸጋ ተቌበርነም። <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />አሑ ራሳሑም የኢየሱስ ክርስቶስ ትኸኖኸም በጠሮዪ ውስጥንኩ። <verse eid="ROM 1:6" /><verse number="7" style="v" sid="ROM 1:7" />በእዝጌር የትወደድኩም ቅዱሳን የወሕን የጠራሑ በሮም ያነሑ እንም፤ በአባናም በእዝጌር፣ በጔታም በኢየሱስ ክርስቶስ ጸጋም ሰላምም ያሑ የሕን።<verse eid="ROM 1:7" /></para>
  <para style="s1">ሮም የወዥ የጳውሎስ ቡረሾ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />ትንም በደርኩም፣ እምነታሑ በዓለም እንም በወሰማሑ፣ ይንመና አምላከኛ በኢየሱስ ክርስቶስ መሳ አምሰጉን። <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />እንጌ ምናሕር ኤስብኩኸም፣ የትኸሑ ወንጌል በወስብክ በሙላ ልበኛ አጉለጉሊ እዝጌር ምስክረኛው፤ <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />በጠሎተኛ እንጌ ኤስብኩ፤ ኧሗም በመጨረሻ በእዝጌር ፈአድ ታሑዬ ኧቸኝኸም ኤማ የከፍትኒዬ ኧጤልይ። <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />በእምነት ትጠኖኸም ይሸክትኩዪ መንፈሳዊ ስጦታ አሰሰድኩዬ፣ አዥኩዬ ኧቦርስ። <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />ዚምም አሑም እያ በያታተና እምነት ነብስ በነብሰና ኧትብረታታነኸሙ። <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />አማኞች፤ ተእንጐዲ አሕዛቤ የኸነኒኸም፣ ባሑዬ ፍርየ የወርክብ ብዠ ግዝየ ታሑዬ ኧቸኜ ኤቀድኩም ትናነሑ፣ ኧሗ ስንም የዀተርኝኸም ቲሒሮኸም ኧወድ።<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />ግሪኮች የኸኖዪ ያንከኖዪም፣ የብላተኞቺ ኤያጥራምቶዪም፣ ግዴታ ነነቢ፤ <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />በሮም ትነብሮዪ፣ የአሑም ወንጌል የወስብክ ኤላ የዚቱ።<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />በወንጌል ኤማልሌ፤ መሳሑም ያምን እንም ይተርፉᎄ ይኸን የእዝጌር ቆቱ፤ ዚም በመጀመሪያ ተአይሑድ፣ ቄጠለም የአሕዛቡ። <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />በወንጌል የእዝጌር ጽድቅ ተገለጠም፤ ጽድቀሑም በመጀመሪያ መጨረሻ ስን በእምነት<note caller="+" style="f"><char style="fr" closed="false">1፥17 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ተእምነት ተምነቴ</char></note> የኸነው፣ “ጻድቅ በእምነት ይነብር” ቧሪም የጣፈኸም።<verse eid="ROM 1:17" /></para>
  <para style="s1">የእዝጌር ማት በሰቦች ᎈር</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />በቡሼነተሕኖ የኢን ኤፈኖም ይጠብጦ፣ በዐመጠሕኖ በቡሼነተሕኖም እንም ᎈር የእዝጌር ማት በሰሜ ይትገለጥ፤ <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />ስለእዝጌር ወሐር ይቸል የሕኖ ግልጡ፤ መሳሑም እዝጌር የሕኖ ግልጥ ሸኰተንም። <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />ዓለም በትኸለቀ ቀረሰም የሰቦች ኤይታዢ የእዝጌር ዓመል ዚም ዘለዓለማዊ ቆተሑ መለኮትነተሑ፣ በኸልቀተሑ ቢልቢጢጦ ይታዥ፤ ስለኸነም ሰቦች መሳ ይሸክቶᎄ ኤነኖ።<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />የእዝጌር ቢሒሮም፣ የአምላክነተሑኸም አናክበሮይ፤ ምስጋናም አናቅረቦነ፤ ቢኸንም አሳበሕኖ ኤድገልል ኸነ፤ ኤያጥራምት ልበሕኖ ጬለመ። <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />ብላተኞችንነ ቢብሮም፣ ገዋዎች ኸኖ፤ <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />የዘላለም አምላክ ክብር ሙት በኸነዪ ሰብ፣ በአንፉዎች፣ በእንሰሳ በአፈርም ᎈር ቢሸቦዪ ኸልቀት መልክ መሰሮም ሸገሮ።<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />ስለኸነም ነብስ በነብሰሕኖ በፎለሕኖ ጅስም ᎈር ያትማልል ሜና ይፌጥሞኸም እዝጌር ሩክሰት የመላወ የቡሼ ኤላተሕኖ ተገዢዎች ይኸኖኸም ገፈረኖ። <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />የእዝጌር የኢን በባጢል ሸገሮ፤ በፈጣሪ ሟኔ ኸልቀት አመለኮ፤ አግለገሎ፤ ቢኸንም ፈጣሪም የዘላለም የትምሰገነው፤ አሜን።<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />በዚም መሳ እዝጌር ያትማልል የኸነ ኤላት አቸለፈም አበኖ፤ እንሽታሕኖም የባሕሪሕኖ ይጌባዪ ወትራኸብ አመለሕኖ ያንከነዪ ወትራኸብ ሸገሮ። <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />ዛምኸም ገሜዪ የአመለሕኖ ይጌባኖዪ ይንሽታ ወትራኸብ ገፈሮም ነብስ በነብሰሕኖ በወማግጥ ነደዶ፤ ገሜ ተገሜጌ ያትማልል ቃር ፌጠሞ፤ የቡሼ ሜናሕኖም ይጌባኖዪ ቅጣት በነብሰሕኖ ᎈር አቸኖ።<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />ሰቦች የእዝጌር ወሐር ያንሸዎ ስለኸነ ያትማልል ቃር ይሸክቶኸም እዝጌር ኤይድገልል አእምሮ አቸለፈም አበኖ። <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />ዐመጣ እንም፥ ግፍ፥ ኤላት፥ ቡሼነት ᎀላቦ፤ ቅናትም፥ ሰብ ወቅጥር፥ ኦገትም፥ ተንኰል ቡሼ አመል ተᎀሎ፤ ኧሟተኘኖ <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />የሰብ ሽም ያጠፎ፥ የእዝጌር ይጠሎ፥ የሰብ ያትዋርዶ፥ ተሳዳቢዎች፥ ትዕቢተኞች ይትነነዶኖ፤ ቡሼነት ይሸክቶᎄዪ ኤማ ያወጦ ያወርዶ፤ የወላጀሕኖ ኤይታዘዞ። <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />ኤያጥራምቶ፥ ውል ያፈርሶ፥ ፍቅር ዬነኖ፥ ጨካኞችኖ። <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />ዚ ይሸክቶ እንም ሞት ይጌባኖ ይብሪ ሱት የኸነዪ የእዝጌር ሕጊ ቢሒሮም፣ ነዚሕኖ ቃር ወሰክት ጠለለ ቴይኸን፣ እኪም ይሸክቶዪም ያብርታቶ።<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s1">የእዝጌር ጻድቅ ፍርድ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />አኸ ብንጐድ ሰብ ᎈር ትፈርድ፣ መሳ ትሸክትወ ኤነናኸ፤ ብንጐዲ ᎈር ብትፈርድወ ቃር እንም፣ በነብሳኸ ትኮንን፤ ፈራጅ የኸንከዪ አኸ ዛም ትሸክት። <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />ዚኸም ቢሸክቶ ሰቦች ᎈር የእዝጌር ፍርድ ሱት ወሕነሑ ኧሒርነ። <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />በሒሽ አኸ ሰብ ብንጐዲ ᎈር ትትፈርድ፣ ዛም ትሸክት በኸነ በእዝጌር ፍርድ ታመልጥ ይመስርኸ? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />ወይሽ የእዝጌር የፈይነተሑ የቻይነተሑም፥ የፈራሒነተሑም ብዛት ትነቅ? እዝጌር ፈይነተሑ ያበዛንከ ያኸ ተንስሐዬ የወምራ የኸነኸም አትሒር?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />ቢኸንም ባለወዘበራኸ ንስሐ ቤይገባ ሒናኸ መሳ ሱት ፍርድ ቲገለጥ በእዝጌር የማት ከነ በነብሳኸ ᎈር ማት ቅጣቲ ይደብርኸም ትሸክት። <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />እዝጌር “የያታቲ የሜናሑኸም ይቡ”፤ <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />ፈያ የኸነዪ ጠናም በወሰክት ክብር፣ ሞገስ ዘላለማዊነትም ይሸዎዪ የዘለዓለም ሕይወት ይቦ። <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />ቢኸንም ነብሰሕኖ ቢወዶዪ፣ የኢኒ ገፈሮም ቡሼነት ቢትዄተሎዪ ፍርድ ማትም ይሰላቦ። <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />ቡሼ ቢሸክት በሟንመሑ ሰብ፣ በደረም በአይሑድ በዛም አንቌ በአሕዛብ ᎈር መከራ ጭንቀትም ይኸን፤ <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />ቢኸንም ፈያ ቃር ይሸክቶ ሰቦች እንም የአይሑድም ኸነ የአሕዛብ ምስጋና ክብር ሰላምም ይቦ።<verse eid="ROM 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 2:11" />እዝጌር የሟንም ኤያዳላ።<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />የእዝጌር ሕጊ ቴይነብሮ አጢያት ይሸከቶ እንም ሕጊ ቤነብሮም ይጠፎ፤ ሕጊ ትናነኖ አጢያት ይሸክቶ እንም በሕጊ ይትፈረድቦ።<verse eid="ROM 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 2:13" />መሳመሑ በእዝጌር ኢፍት ጻድቃን ይቡሪዮዪ የሕጊ ይታዘዞ አንኸንም፣ ሕጊ ይሰሞ አንከኖ። <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />የእዝጌር ሕጊ ዬነኖ አሕዛብ ሕጊ ዬዝዢ ቃር ቲትኸለቆ፣ ሕጊ ቤይነብሮም ሕኖ የነብሰሕኖ ሕግኖ። <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />ሕሊናሕኖ ይምሰክርቦ ስለኸነ፣ አሳበሕኖ ይከስሶ ስለኸነ፣ ኧሗም ይኸትሮ ስለኸነ የሕጊ ትዛዝ በሒነሕኖ የጣፈ ወሕነሑ ያቴዞ። <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ዚም ይኸን እያ ብናᎄሥር የወንጌል ቃል መሠረት እዝጌር በኢየሱስ ክርስቶስ መሳም ሰቦች በሸከቶይ የሼመ ቃር ᎈር ቢፈረድወ ከነው።<verse eid="ROM 2:16" /></para>
  <para style="s1">አይሑድ ሕገሕኖም</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />ዘ፥አኸ “አይሑዳዊንኩ” ትብር፣ በሕጊ ትዴገፍ፤ የእዝጌር ወሕናኸም ትትነነድ፣ <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />በእዝጌር ሕጊ በወትመራኸ ፈአደሑ ሐርከም ፍጡም የኸነዪ ላኘኸም በጠበጥከ፣ <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />ወዥ ኤይችሊ መሪ፣ በጨለማ ያኖዪም ብራን ወሕናኸ የኢነተኘ በኸንከ፣ <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />በሕጊም በረከብኰን ውቀት የኢንም የትነሣ ያንካሮዪ መካሪ፣ የሰብዬ አስተማሪ በኸንከ፣ <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />ኧጌሽ አኸ እንጐዲ ታትመር፣ ነብሳኸ አታትመር? አትስርቅ ባኸም ትሰብክ፣ ትሰርቅ? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />አኸ ሰቦች ወሟግጥ ኤነቦ ትብር፣ ትሟግጥ? አኸ የጣዖት ትጠላ፣ ቤተ መቅደስ ትዘርፍ?<verse eid="ROM 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 2:23" />አኸ በሕጊ ትትነነድ፣ የሕጊ በወችላለፍ የእዝጌር ታትዋርድ? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />ዚም “ባሑ መሳ የእዝጌር ሽም በአሕዛቤ ይሰደብ” ቧሪም የጣፈኸሙ።<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />የእዝጌር ሕጊ ትፌጥም በኸነ ጤበን ዋውና ዋጋ ነነን፤ ሕጊ ትችላለፍ በኸነ ጤበን ያናውኔኸም ትኸን። <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />ጤበን ያናውኔዮ ሕጊ ዬዝዢ ይፌጥሞ በኸነ፣ ጤበን ያወኔዮኸም ኤይትቆጠሮ? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />አኸ የጣᎈ ሕጊ፣ ጤበን ቢነብርኸ፣ ሕጊ ትችላለፍ በወሕናኸ፣ በገግ ጤበን ያናውኔዪ የሕጊ በወታዘዘሑ ይፈርድብከ።<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />ኧጌሽ በሽም ጠለለ አይሑድ የኸነ የኢነተኘ አይሑዳዊ አንከነ፤ የኢኒ ጤበን የᎈር የገግም ሥራት አንከነ። <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />የኢነተኘ አይሑዳዊ በውስጥ አይሑድ የኸነው፤ የኢነተኘ ጤበን ያወኔ በእዝጌር መንፈስ ይኸን የሒን ጤበን ዋውናው አንኸንም በሕጊ በጣፈዪ መሠረት የበሠር ጤበን ዋውና አንከነ። እኪ ኸማቲም ሰብ ምስጋና ይቌበር በእዝጌሩ አንኸንም በሰብ አንከነ።<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s1">የአይሑድ አለወምን</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />ኧጌሽ አይሑድ ወሕን ተአሕዛብ ይበዛ በመአሩ? ጤበን የዋውና ጥቅመሑ መአሩ? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />የኢንም አይሑዳዊ ወሕን በብዠ ኤማ ብዠ ጥቅም ነነን፤ ዋናዪ ቃር እዝጌር ቃለሑ የአይሑድ ዐደራ ዋበሑ። <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />ኧጌ፥ ተአይሑድ አታቶቺ ይታመኖ ኸኖም ቤትረከቦ፥ የሕኖ ታማኝ አለወሕን የእዝጌር ታማኝነት ያቈይን? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />ስርም ኤያቈይን!</para>
  <para style="q1" vid="ROM 3:4">“ተቃላኸ የትነሣ የኢነተኘ ትኸን፤</para>
  <para style="q2" vid="ROM 3:4">መሶአኸም በፍርድ ትቌም”</para>
  <para style="m" vid="ROM 3:4">ቧሪም የጣፈኸም ሰብ እንም ባጢለተኘ ቢኸንም እዝጌር የኢነተኘው።<note caller="-" style="x"><char style="xo" closed="false">3፥4 </char><char style="xt" closed="false"><ref loc="PSA 51:4">መዝ. 51፥4</ref>። </char></note><verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />ቢኸንም ይና አጢያት የእዝጌር ጽድቅ ገለጠም ያቴዥ በኸነ ኧጌ መአር ኧብርነ? እዝጌር ስለአጢያተና ቢቀጣነ ሱት ፈራጅ አንከነ ወበሩ? በዚ ᎈር ኧዝነጊኒ የሰብ አስተሳሰብኸሙ። <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />ስርም አንከነ! እኪ በኸነማ እዝጌር በዓለም ᎈር ምንኸም ይፈርድ?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />ቢኸንም ይያ ባጢለተኝነት የእዝጌር የኢን በወግልጥ፥ የክብረሑ ብዛት ያቴዥ በኸነ ኧጌ፥ እያ የአጢያተኛኸም ይትፈረድቢ የመአሩ? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />አታት ሰቦች “ፈያ ቃር ኧረኸብነኸም ቡሼ ቃር ንሰክትነ” ትንብር አትመር አትሜሰሮም ይከሶኝ፤ ቢኸንም እኪ በባሮዪ ᎈር ይትፈረድቦዪ ፍርድ ሱቱ።<verse eid="ROM 3:8" /></para>
  <para style="s1">ሰብ እንም አጢያተኛ ወሕነሑ</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />ኧጌሽ፥ ኢና አይሑድ ተአሕዛብ ኧበዛነ ወበሩ? ስርም አንከነ! ሰቦች እንም አይሑድም ኸኖ አሕዛብ አጢያተኛ ወሕነሕኖ በደርኩም አትሬዳሑም። <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />እኪ ቧሪም የጣፈኸም፦</para>
  <para style="q2" vid="ROM 3:10">“አትም ጻድቅ ሰብ ኤነ፤<verse eid="ROM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ROM 3:11" />ያጥራምት ኤነ፤</para>
  <para style="q2" vid="ROM 3:11">የእዝጌርም ይሸ ቁናም ኤነ።<verse eid="ROM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ROM 3:12" />እንም ቤማ ወጦም፤</para>
  <para style="q2" vid="ROM 3:12">ቁናዬ ኸኖም ተዳሎም።</para>
  <para style="q2" vid="ROM 3:12">ፈያ ሜና ይሸክት ቁናም ሰብ ኤነ።<note caller="-" style="x"><char style="xo" closed="false">3፥10-12 </char><char style="xt" closed="false"><ref loc="PSA 14:1-3">መዝ. 14፥1-3</ref>፤ <ref loc="PSA 53:1-3">53፥1-3</ref>። </char></note><verse eid="ROM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ROM 3:13" />የሰብ ይጎዳ ቡሼ ቃል የወዘንግ አፈሕኖ የከፈተ ቀብርኸሙ፤</para>
  <para style="q2" vid="ROM 3:13">ባለመተሕኖ ያብላልጦ፤</para>
  <para style="q1" vid="ROM 3:13">የከንፈረሕኖም ንግግር የእንድወደረ መርዝኸም ይጎዳ፤<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="PSA 5:9">መዝ. 5፥9</ref>፤ <ref loc="PSA 140:3">140፥3</ref>። </char></note><verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />አፈሕኖም ስድብ ምሬትም መላወም።<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="PSA 10:7">መዝ. 10፥7</ref>። </char></note><verse eid="ROM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ROM 3:15" />ኧግረሕኖ የሰብ የወቅጥር የቴከለው፤<verse eid="ROM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ROM 3:16" />ቤማሕኖ ይትረከብ ጥፋት ጉስቁልናው።<verse eid="ROM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ROM 3:17" />የሰላም ኤማ ኤይሒሮ፤<note caller="-" style="x"><char style="xo" closed="false">3፥15-17 </char><char style="xt" closed="false"><ref loc="ISA 59:7-8">ኢሳ. 59፥7-8</ref>። </char></note><verse eid="ROM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ROM 3:18" />የእዝጌር ስርም ኤይጔኖ።”<note caller="-" style="x"><char style="xo" closed="false">3፥18 </char><char style="xt" closed="false"><ref loc="PSA 36:1">መዝ. 36፥1</ref>። </char></note><verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />የእዝጌር የሕጊ ትዛዝ ይትምሌኰች ተሕጊ ተት ያኖዪ የኸነኸም ኧሒርነ፤ በዚም መሳ ሰቦች ያትምካኖይ ቀበጦም እንቁስ ይብሮ፤ ዓለም እንም በእዝጌር ፍርድ ተት ይኸን። <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />ስለኸነም ሟንም ሰብ በእዝጌር ኢፍት፥ ሕጊ በወፈጥም ኤይጸድቅ፤ ሕጊ ያቴዢ ሰብ እንም አጢያተኛ ወሕነሑ።<note caller="-" style="x"><char style="xo" closed="false">3፥20 </char><char style="xt" closed="false"><ref loc="PSA 36:1">መዝ. 36፥1</ref>። </char></note><verse eid="ROM 3:20" /></para>
  <para style="s1">በእምነት ይትረከብ ጽድቅ</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />ኧሗም እዝጌር የሰብ ያጸድቅወ ኤማ ያለ ሕጊ ወሕነሑ ታዠም፤ ዚም በሙሴ ሕጊ በነብዮችም ተምሰከረም። <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />ስለኸነም እዝጌር አትም ልዩነት ቴይሸክት በኢየሱስ ክርስቶስ ያምኖ እንም ጽድቅ ይብ።<note caller="-" style="x"><char style="xo" closed="false">3፥22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">ገላ. 2፥16</ref>። </char></note> <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />ሰቦች እንም አጢያት ሸከቶም፤ እዝጌር ያበኖዪም ክብር ቀበጦም። <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />ስለኸነም ሰቦች ኢየሱስ ክርስቶስ በፌጠᎀኒ በአትርፎት ሜና በእዝጌር ጸጋ ጠለለ ይጸድቆ። <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />እዝጌር የኢየሱስ ክርስቶስ መሥዋት ሸከተም ያቀረᎄን በሑቲ ያመኖዪ እንም በደመሑ የአጢያተሕኖ ወሰረዝ ይረሕቦኸሙ፤ እዝጌር ዚ ወሰክተሑ በትዕግሥተሑ የድረዪ አጢያት ያነበረኸም በወሰክት የነብሰሑ ሱት ፍርድ የወግልጡ። <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />በሗዪም ዘበን እዝጌር ነብሰሑ ጻድቅ ወሕነሑ ያቴዥ በኢየሱስ ያምኖዪ እንም በዋጽድቁ።<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />ኧጌሽ ኧትነነድነᎄ ቃር መአር ነነ? ባትም ቃር አንትነነድነ! አንትነነድነᎄዪሽ መሳ መአሩ? ሕጊ ኧፌጥምነ ስለኸነው? አንከነ፤ ቢኸንም በእምነቱ። <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />ስለኸነም እዝጌር የሰብ ያጸድቅ፥ ሰብ የሕጊ ሜና በወፈጥመሑ ቴይኸን በእምነት ወሕነሑ ኧሒርነ። <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />እዝጌር የአይሑድ ጠለለ አምላኩ? የአሕዛብሽ አምላክ አንከነ? ዮንም የአሕዛብም አምላኩ። <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />ጤበን ያወኔዪ በእምነት፤ ጤበን ያናውኔዪም በዛም እምነት ያጸድቅ ቁና እዝጌር ጠለለው። <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />ኧጌ፥ በእምነት መሳ ሕጊ ኧሸርኔ ወበሩ? አንከነ፤ ይጠቅለሑሽ ሕጊ አጠበቅነም ኧጠብጥኔ።<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s1">አብርሐም በእምነት ወጽድቀሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />በይሽ በዝሬት አባና የኸነ አብርሐም ረከበም ኧብርነ መአሩ? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />አብርሐም የጸደቀ በሜናውታ ቢኸንማ፥ ይትነነድወ ቃር ይረሕብ ባነ፤ የሕን አንኸንም በእዝጌር ኢፍት ወትነነድ ኤይችል። <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />መጽሐፍ ቅዱስ “አብርሐም በእዝጌር አመነ፤ እምነትመሑ ጽድቅ ኸነም ተቆጠረነ” ይብር።<note caller="-" style="x"><char style="xo" closed="false">4፥3 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ዘፍ. 15፥6</ref>፤ <ref loc="GAL 3:6">ገላ. 3፥6</ref>። </char></note> <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />ይሸክት ሰብ ይረሕቡ ደሞዝ ይጌባ የመሌውታ ዋጋሑ አንኸንም ጸጋ አንከነ። <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />ሰብ ፈያ ሜና ቤይነቡርም ያጢያተኛ ያጸድቂ አምላክ ባመነ እምነተሑ ጽድቅ ኸነም ይትቆጠርነ። <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />ዳዊትም በነብሰሑ እዝጌር ያለ ፈያ ሜና ያጸድቊ ሰብ ምን ቅጫ የትባረከ ወሕነሑ ቲገለጥ እኪ ባረም፦<verse eid="ROM 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ROM 4:7" />“በደለሕኖም አፉ የቧርኖዪ</para>
  <para style="q2" vid="ROM 4:7">አጢያተሕኖ የድᎀሸሽኖ ሰቦች</para>
  <para style="q2" vid="ROM 4:7">የትባረኮኖ!<verse eid="ROM 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ROM 4:8" />ጔታ አጢያተሑ ኤይቆጥርወ ሰብ</para>
  <para style="q2" vid="ROM 4:8">የትባረከው!”<note caller="-" style="x"><char style="xo" closed="false">4፥7-8 </char><char style="xt" closed="false"><ref loc="PSA 32:1-2">መዝ. 32፥1-2</ref>። </char></note><verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />ኧጌ፥ ዳዊት የዝነጔን ዚ በረከት ጤበን ያወኖዮዪ ጠለለው? ወይሽ ጤበን ያናውኔዮሚው? ጤበን ያናውኔዮሚው፤ “አብርሐም በእዝጌር ያመነ ስለኸነ እምነተሑ ጽድቅ ኸነም ተቆጠረነ” ባርነም።<verse eid="ROM 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 4:10" />በይሽ አብርሐም እምነተሑ ጽድቅ ኸነም የቆጠረነ መቸው? ጤበን ቴያወኔ ኢፍቴው ወይሽ ጤበን ባወኔ አንቌው? ጤበን ተወቶናሑ ኢፍቴ አንከንም ጤበን ባወኔ አንቌ አንከነ። <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />አብርሐም ጤበን ተወቶናሑ ኢፍቴው እምነተሑ ጽድቅ ኸነም ይቆጠርነኸም ያርጓጉጭᎄ ምልክት ይዀንኸም ጤበን አወኔ፤ ስለኸነም አብርሐም ጤበን ቴያወኔዮ ያምኖዪ እምነተሕኖም ጽድቅ ኸነም ይቆጠርኖዪ እንም አባው።<note caller="-" style="x"><char style="xo" closed="false">4፥11 </char><char style="xt" closed="false"><ref loc="GEN 17:10">ዘፍ. 17፥10</ref>። </char></note> <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />ዛምኸም አብርሐም ጤበን ያወኖዮዪም አባው፤ ጤበን ያወኖዮዪ አባ የኸነወ መሳ ጤበነተኘ በወሕነሕኖ ጠለለ ቴይኸን ሑቲ ጤበን ተወቶናሑ ኢፍቴ የነᎄረን እምነት በወትኸተለሕኖው።<verse eid="ROM 4:12" /></para>
  <para style="s1">ስለእምነት የቴበ ተስፋ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />የአብርሐም የዝሬተሑም የዓለም ይወርስኸም እዝጌር ተስፋ ያᎄን በእምነት የረከᎄን ስለኸነ ጽድቁ አንከንም ሕጊ በወፈጥመሑ አንከነ።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="GEN 17:4-6">ዘፍ. 17፥4-6</ref>፤ <ref loc="GEN 22:17-18">22፥17-18</ref>፤ <ref loc="GAL 3:29">ገላ. 3፥29</ref>። </char></note> <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />የተስፋዪ ወራሾች ሕጊ ይፌጥሞ ሰቦች በኸኖማ እምነት ዋጋ ኤይነቡር፤ ተስፋም ኤድገልል ወሕነሑ።<note caller="-" style="x"><char style="xo" closed="false">4፥14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">ገላ. 3፥18</ref>። </char></note> <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />ሕጊ ያቸኝኒ የእዝጌር ማቱ፤ ሕጊ ቤነ ሕጊ ይችላለፉᎄ በደል ኤይነብር።<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />ስለኸነም ተስፋዪ የትምሠረተ በእምነት ᎈር ባነ፤ ዚም ተስፋ የአብርሐም ዝሬት እንም በእዝጌር በጸጋ የቴበ ወሕነሑ በዚ ተርጋገጠም። ዚም ሕጊ ይትዄተሎ ሰቦች ጠለለ ቴይኸን የአብርሐምኸም ያመኖዪ እንሙ፤ በዚም መሠረት አብርሐም ይንመና አባው።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="GAL 3:7">ገላ. 3፥7</ref>። </char></note> <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />ስለ አብርሐም፦ “የብዠ ሕዝብ አብ ሸከተክኸም” ቧሪም ጣᎉም፤ ዚም ተስፋ የአብርሐም ያᎅ ሑቲ የሟቾቺ ቢያትኔሳዪ ዬነዪ ቃር ይነብርኸም ቢሸክቲ አምላክ በወምነሑ ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥17 </char><char style="xt" closed="false"><ref loc="GEN 17:5">ዘፍ. 17፥5</ref>። </char></note> <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />የአብርሐም ዝሬታኸ ስርም ይበዛ ቧሪም ቤወጂ መሠረት የብዠ ሕዝብ አብ ይኸንኸም አመነም ተስፋ የሸከተ አትም ተስፋ ቤያድጉᎄ ቃሩ።<note caller="-" style="x"><char style="xo" closed="false">4፥18 </char><char style="xt" closed="false"><ref loc="GEN 15:5">ዘፍ. 15፥5</ref>። </char></note> <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />እድሜሑ መቶ ዓመት ቅጫ የኸነ ስለኸነ መሌሑ በወቂጠሑ የᎀተኸም በወሕን መሳ ወጠኝ ኤይችልኸም ሣራም ኤጬኞ የገረዘች በወሕኔታንም ወጠኝ አትችልኸም ቢሒርም በእምነተሑ አንቌጠ።<note caller="-" style="x"><char style="xo" closed="false">4፥19 </char><char style="xt" closed="false"><ref loc="GEN 17:17">ዘፍ. 17፥17</ref>። </char></note> <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />በእምነተሑ የብረታ ኸነም የእዝጌር አምሰገነ አንከንም እዝጌር ባᎄን ተስፋ ባለወምን ስርም አንትጥራጠረ። <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />እዝጌር ያᎄን ተስፋ ይፌጠም ወሕነሑ በሙላ ቀልብ ያምን ባነ። <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />የዚቱ የአብርሐም እምነተሑ ጽድቅ ኸነም የቆጠረነ። <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />ቢኸንም “ጽድቅ ኸነም ተቆጠረነ” ይብሪ ቃል የጣፈ የአብርሐም ጠለለ ቴይኸን <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />ይናም ደበረሙ፤ የጔታና የኢየሱስ በሞት ባትኔሣን አምላክ አምንነዪ ይናም እምነተና ጽድቅ ኸነም ይቆጠርንነ። <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />ዚ ጔታና ኢየሱስም የአጢያተና የሞት ተችላለፈም ያᎅዪ ይናም የዋጽደቅም ተሞት የትነሣዪው።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="ISA 53:4-5">ኢሳ. 53፥4-5</ref>። </char></note><verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s1">በእምነት ይትረከብ የሰላም ዕርቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />ኧጌ ኢና ጽድቅ የረከብነ በእምነት ስለኸነ በጔታና በኢየሱስ ክርስቶስ ተእዝጌርጌ ሰላም ነነ። <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />ተዚዬ ኧሗ በእምነት ጠናነም ትንትረከብነᎄዬ ጸጋ የገባነ በኢየሱስ ስለኸነ በተስፋ የእዝጌር ክብር ኧሰድነ በወሕነና ኧትነነድነ። <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />በዚ ጠለለ ቴይኸን መከራ ትዕግሥት ያትሬክብንነኸም ኧሒርነ ስለኸነ በመከራና ኧትነነድነ። <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />በትዕግሥትም በፈተና ወጥና፥ በወጥናም ተስፋ ይትረከብ። <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />ባቡነ በመንፈስ ቅዱስ መሳ የእዝጌር ፍቅር በሒነና የᎀላ ስለኸነ ተስፋዪ ኤያትማልል።<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />ድረ የቌጥነ በወሕነና እዝጌር በዌሰነን ግዝየ ክርስቶስ ያጢያተና ᎀተ። <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />በጻድቅ ሟኔ ኸነም ይᎀት ሰብ ወርክብ ስርም ያትሜካ፤ ቢኸንም በፈያ ሰብ ሟኔ የወᎀት ይደፍር የሟንመሑ ይትረከብ ይኸን። <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />ቢኸንም ኢና አጢያተኛ ኸነም ትናነነ ክርስቶስ ቢና ሟኔ ᎀተም፤ ዚም እዝጌር ይና ያነን ፍቅር ምናሕር ወደል ወሕነሑ ያቴዥ። <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />ኧጌ የጸደቅነ በኢየሱስ ክርስቶስ ደም በኸነ ስርም ተእዝጌር ማት ኧተርፍነ በሑቲ መሳው። <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />ኢና የእዝጌር መሶ ኸነም ትናነ በትኸሑ ሞት ተእዝጌርጌ ታረቅነም፤ ኧሗ ተእዝጌርጌ በታረቅነ አንቌ በትኸሑ ሕይወት መሳ የጠቀለ ኧተርፍነ። <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />ዚም ጠለለ ቴይኸን ተእዝጌርጌ ዕርቅ በረከብነᎄ በጔታና በኢየሱስ ክርስቶስ መሳም በእዝጌር ኧትነነድነ።<verse eid="ROM 5:11" /></para>
  <para style="s1">ሞት በአዳም ሕይወት በክርስቶስ</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />በቁና ሰብ መሳ አጢአት ተዓለሜ ገባ፤ በአጢያትም መሳ ሞት ቸኘ፤ ዛምኸም ሰብ እንም ባጢል የሸከተ ስለኸነ ሞት በሰብ እንም ᎈር ቸኘ፤<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false"><ref loc="GEN 3:6">ዘፍ. 3፥6</ref>። </char></note> <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />የእዝጌር ሕጊ የሙሴ ተወቴበሑ ኢፍቴ አጢያት በዓለም ባነ፤ የሕን አንከንም ሕጊ ቤነወ አጢያት ነብሰሑ ያጢያትኸም ኤይትቆጠር ባነ።<verse eid="ROM 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 5:14" />የሕን አንከንም ተአዳም ቀረሰም ሙሴ ስን ባኖዪ፤ የአዳምኸም ሕጊ በወጣስ አጢያት ባንሰከቶዪ ᎈር ቴይቀይ ሞት ነገሠ፤ አዳም ይቸኜ ያነዪ አምሳያ ባነ።</para>
  <para style="p" vid="ROM 5:14">ዚ አዳም ቲፍቴዬ ይቸኚ ክርስቶስ ምሳሌ ባነ። <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />ቢኸንም የእዝጌር የጸጋ ስጦታ የሰብ አጢያታኸም አንከነ፤ በቁና ሰብ አጢያት መሳ ብዠሕኖ የᎀቶኸም ዛምኸም በእዝጌር ጸጋ በቁናዪም ሰብ በኢየሱስ ክርስቶስ መሳ የትረከበዪ የጸጋ ስጦታ የብዠሕኖ ተትርፈረፈም ቴበም። <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />ዛምኸም የእዝጌር ነጣ ስጦታ ያቸኘን የጸጋ ውጤት የቁና ሰብ አጢያት ያቸኘንኸም ውጤት አንከነ። በቁናዪ ሰብ በአዳም አጢያት መሳ የቴበ ፍርድ ቅጣት አቸኘ፤ በብዠ አጢያት መሳ የቴበ ነጣ ስጦታ ጽድቅ አቸኘ። <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />በቁናዪ በአዳም አጢያት መሳ ሞት በሰብ እንም ᎈር ሥልጣን በረከበ የእዝጌር የትርፈረፈ ጸጋ፥ ነጣ ስጦታ ተቌበሮም የጸደቆ እንም በአቲ ሰብ በኢየሱስ ክርስቶስ መሳ ውራግ በወሠክት በሕይወት ይነብሮ።<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />ኧጌሽ የቁናዪ የአዳም አጢያት የቅጣት ፍርድ በሰብ እንም ᎈር ያቸኘኸም ዛምኸም የቁናዪ የክርስቶስ የጽድቅ ሜና ብዠሕኖ ተቅጣት ነጣ ሸከተም ሕይወት ይብ። <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />በአዳም አለወታዘዝ መሳ ብዠሕኖ አጢያተኛ የኸኖኸም ዛምኸም በክርስቶስ ወታዘዝ መሳ ብዠሕኖ ይጸድቆ። <verse eid="ROM 5:19" /><verse number="20" style="v" sid="ROM 5:20" />ሕጊ በወተኘሑ ወችላለፍ በዛ፤ ቢኸንም አጢአት በበዛወ ጸጋ አበዛም የትርፈረፈ ኸነ፤ <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />ዚም የኸነ በሞት መሳ አጢያት በሞት የነገሰኸም እንም ዛምኸም በጔታና በኢየሱስ ክርስቶስ መሳ የዘለዓለም ሕይወት ይትረከብኸም የእዝጌር ጸጋ ጽድቅ በዋብ ይነግስ።<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s1">ተአጢያት ተላኚም በክርስቶስ ወንብር</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />ኧጌ መአር ኧብርነ? የእዝጌር ጸጋ ይበዛኸም በአጢአት ጠናነም ንምብርነ? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />አንከነ! ኢና በሞት የወትላኝ ቅጫ ተአጢያት የትለኘነ ኸነም ትናነ ምንኸም በአጢያት ጠናነም ኧነብርነ? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />ተኢየሱስ ክርስቶስጌ ቁና የወሕን የጠመቅነ እንም ሞተሑ ኧሰድነ የወሕን፤ ወጠመቀና አትሒሮ? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />በጥምቀት ተሑቲጌ በቀበርነ ግዝየ የሑቲም ሞት ኧሰድነ ኸነም፤ ስለኸነም ክርስቶስ በአብ ክብር በሞት የትነሳኸም ኢናም በገደር ሕይወት ኧነብርነ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="COL 2:12">ቆላ. 2፥12</ref>። </char></note><verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />በሞተሑ ተሑቲጌ እኪ ቁና በኸነ ዛምኸም በትንሣኤሑ ተሑቲጌ ቁና ኧኸነ። <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />አጢያተኛዪ ገገና ይጠፋኸም የአጢያት ጉዙ ወሕነናም ይቀይኸም የገረዘ ሟንነተና ተክርስቶስጌ ወሰቀረሑ ኧሒርነ። <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />የᎀተ ሰብ የአጢያት ተወትገዛ ነጣው። <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />ኧጌሽ ተክርስቶስጌ በᎀትነ ተሑቲጌ በሕይወት ኧነብርነኸም ናምንነ፤ <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />ክርስቶስ በሞት በወተንሳሑ መሳ ዠበረም ኤይᎀትኸም ሞትም በሑቲ ᎈር ሥልጣን ዬነንኸም ኧሒርነ። <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />ሑቲ በᎀተ ግዝየ አጢያት በሑቲ ᎈር ሥልጣን ኤይነቡርኸም ቤደገም ሐለት ቁናጌ ᎀተም፤ ኧሗም በሕይወት ቲነብር የእዝጌር ይነብር። <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />በሒሽ አሑ የወሙት ቅጫን ተአጢያት የትላኘሑኸም በኢየሱስ ክርስቶስ መሳም የእዝጌር በሕይወት ትነብሮኸም አስቦ።<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />ስለኸነም አጢያት ቢᎀቲ ገጋሑ ᎈር ሥልጣን ይነቡርኸም የበሠር ኤላት የገዛሑ ይሸክትኩኸም አትፍቅዶነ። <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />ዛምኸም የገጋሑ ክፍል የዐመጥ መሣሪያ ሸከትኩም የአጢያት አታቅርቦ፤ ቢኸንም ተሞት ተነሣሑም ሕያዋን የኸንኩኸም በወሰክት ነብሳሑ የእዝጌር አቅርቦ፤ የገጋሑም ክፍል እንም የጽድቅ መሣሪያ ሰክቶም የእዝጌር አቅርቦ። <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />ኧሗ አሑ ትነብሮ ተጸጋ ተት አንከንም ተሕጊ ተት ያንከንኩ ስለኸነ አጢያት ይገዛሑዬ ኤይጌባ።<verse eid="ROM 6:14" /></para>
  <para style="s1">የጽድቅ ጉዙ ወሕን</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />ኧጌሽ መአር ኧብርነ? ተሕጊ ተት ወሕነና ቀኘም ተጸጋ ተት ስለኸነ አጢያት ንሰክትነ ወበሩ? ስርም አንከነ! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />የቁና ሰብ ጉዙ ኸንኩም የወታዘዝ ነብሳሑ ትታቀርቦ የዛ ትታዘዞነዪ ሰብ ጉዙ ወሕናሑ ቲሒሮ፤ ዛምኸም ያጢያት ብትታዘዞ ሞት ያቸኝብኩዪ አጢያት ጉዙ ትኸኖ? የእዝጌር ብትታዘዞ ጽድቅ ትረሕቦ። <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />አሑ ድረ ያጢያት ጉዙ ባነሑ፤ ኧሗም የቌበርኩይ ትምርት ተሒን በወታዘዛሑ የእዝጌር ክብር የሕን። <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />ያጢያት ጉዙ ተወሕን ነጣ ወጣሑም የጽድቅ ጉዙ ኸንኩም። <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />እያ እኪ የሰብ ቢገባ ቋንቋ ኧዝነግ ተአስተሳሰባሑ ቅጭናነት የትነሣው። በደረም የገግ ክፍላሑ የሩክሰት ያመጥ አገልጋዮች ሸከተኩም ያቀረብኩኸም እንም ዛምኸም ኧሗ የገግ ክፍላሑ ይትቄደሶኸም የጽድቅ አገልጋዮች ሰክቶም አቅርቦ።<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />ያጢያት ጉዙ ትናነሑ ተጽድቅ ነጣ ባነሑ። <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />ኧጌ፥ በዛ ግዝየ ምን ጥቅም ረከብኩ? ኧሗ ቲያትማልልኩ ቃር እንጐድ አትም ጥቅም አረሕብኩ፤ የዚም ቃር መጨረሻሑ ሞቱ። <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />ኧሗ የአጢት ጉዙ ተወሕን ነጣ ወጣሑም የእዝጌር ጉዙ በወሕናሑ ቅድስናም ትረሕቦ፤ የቅድስናም መጨረሻ የዘላለም ሕይወቱ። <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />መሳሑም በአጢያት ይትረከብ ዋጋ ሞቱ፤ በእዝጌር ይᎅ ስጦታ በጔታና በኢየሱስ ክርስቶስ መሳ ይትረከቢ የዘላለም ሕይወቱ።<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s1">ተሕጊ ነጣ ወሕን</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />ጐባቢተኛ! ዚ አትሒሮ? ኧዝነግ ሕጊ ይሒሮዪ ሰቦቹ፤ ሕጊ በሰብ ᎈር ሥልጣን ይነቡር ሰብ በሕይወት ያነ ስን ጠለለው። <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />ምሳሌ፥ ያገባች ምሽት ምሴታ በነብስ ያነ ስን ተሑቲጌ በሕጊ ኧጉጀኘያ፤ ምሴታ በᎀተባ ኧጉጀኘ በኸነትወዪ ሕጊ ነጣያ። <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />ስለኸነም ምሴታ በሕይወት ትናነ እንጐድ ምስ ብታገባ የሟገጠች ይቡርያ። ምሴታ በᎀተባ ተሑቲጔ ኧጉጀኘ በኸነትወ ሕጊ ነጣ ትወጣ፤ እንጐድ ምስ ብታገባም አሟገጠች። <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />ጐባቢተኛ፥ ያሑም ሐለት ዛምኸሙ፤ አሑ የክርስቶስ ጅስም ክፍል የኸንኩ ስለኸነ በሞት የወትላኝ ቅጫ ተሕጊ ተላኘሑም፤ ስለኸነም የእዝጌር የጉዙ ፍርየ አወርድነኸም በሞት የትነሣዪ የክርስቶስ የነብሰሑ ጐሣዎች ኸንኩም። <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />በነብሰና ፈአድኸም ኧዥባበርነᎄ በነበረወ ግዝየ በሕግ ይንሣሣዪ ቡሼ ኤላት የሞት ፍርየ ናወርድነኸም በገገና ክፍል ውስጥ ይሸክት ባነ። <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />ኧሗም አገደነም ተነበረዪ ሕጊ በሞት የወትላኝ ቅጫ የትላኘ ስለኸነ በሕጊ ኧጉጀተኘ ነጣ ወጣነም፤ ስለኸነም በዚ አንቌ አግለግልነ በገደሪ መንፈሳዊ መመሪያ አንከንም ድረ በጣፈዪ በጉርዚ የሕጊ መመሪያ አንከነ።<verse eid="ROM 7:6" /></para>
  <para style="s1">ሕጊ አጢያትም</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />በይሽ ምን ኧብርነ? ሕጊ ነብሰሑ አጢያተኛው? አንከነ! ቢኸንም አጢያት ምን ወሕነሑ ኧሒርኸም የሸከቴ ሕጊው። ሕጊ “አታላ” ቤይብርማ ኤላት ምን ወሕነሑ አንሒር ባነ።<note caller="-" style="x"><char style="xo" closed="false">7፥7 </char><char style="xt" closed="false"><ref loc="EXO 20:17">ዘፀ. 20፥17</ref>፤ <ref loc="DEU 5:21">ዘዳ. 5፥21</ref>። </char></note> <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />አጢያት በሕግ ኤማ ትዛዝ ዕድል ረከበም ኤላተሑ እንም ቢያ ውስጥ ይንክላውስኸም ሸከተ። ሕጊ ቤነ አጢያት የᎀተው። <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />በደረም ሕጊ ባነበረወ ግዝየ እያ በሕይወት ኧነብር ባነ፤ የሕጊ ትዛዝ በቸኘ ግዝየ እያ ᎀትኩም አጢያት ሕይወት ረከበ። <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />የሕይወትም ያᎅ የሕጊ ትዛዝ ቢያ ᎈር ሞት አቸኘቢ። <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />አጢያት የሕጊ ትዛዝ መሳ ሸከተም አብላለጤ፤ በትዛዝ መሳ ቀጠሬ።<note caller="-" style="x"><char style="xo" closed="false">7፥11 </char><char style="xt" closed="false"><ref loc="GEN 3:13">ዘፍ. 3፥13</ref>። </char></note><verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />ስለኸነም ሕጊ ቅዱሱ፤ ትዛዚ ቅዱስ የኢንም ፈያው። <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />ኧጌሽ፥ ዚ ፈያ የኸነዪ ቃር ቢያ ᎈር ሞት አቸኘቢ ወበሩ? አንከነ! ቢኸንም አጢያት፥ አጢያት ኸነም ይታዤ በፈያዪ ቃር መሳ ሞት አቸኘቢ፤ ስለኸነም አጢያት በትዛዝ መሳ ስርም የበዛ አጢያተኛ ኸነ።<verse eid="ROM 7:13" /></para>
  <para style="s1">በሰብ ሕይወት ውስጥ ያነ ግጅላ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />ሕጊ መንፈሳዊ ወሕነሑ ኧሒርነ። እያም ያጢያት ጉዙ የወሕን የስየሑ ሰብንኩ። <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />እያ ኧሸኩቺ አንሒር፤ ኧወጅጂ ቃር ወሰክት ገፈርኩም ኧጠላኒ ቃር ኧሸክት።<note caller="-" style="x"><char style="xo" closed="false">7፥15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">ገላ. 5፥17</ref>። </char></note> <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />በሒሽ እያ ኧሸክቴ አንሸን ቃር በኸነ ሕጊ ፈያ ወሕነሑ ኧምሰክር። <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />ወሰክት አንሸኒ ቃር ይሸክቲ ቢያ ውስጥ ያነዪ አጢያቱ አንከንም እያ አንከንኩ። <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />ቢያ ወይ ቢያ በሰብ አመል አትም ፈያ ቃር ዬነኸም ኧሒር፤ ፈያ ቃር የወሰክት ወሴ ቢነብሬም ዛ ፈያ ቃር የወሰክት ቆት ኤኔ። <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />ወሰክት ኧሸኒ ፈያ ቃር አንሸክት፤ ቢኸንም አንሸኒ ቡሼ ቃር ኧሸክት። <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />ወሰክት አንሸኒ ቡሼ ቃር ኧሸክት በኸንኩ ዚ ይሸክት ቢያ ውስጥ ያነዪ አጢያቱ አንከንም እያ አንከንኩ ወበሩ።<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />ስለኸነም ሕጊ በሜና ᎈር ዋለም አዥን፤ ፈያ ቃር ወሰክት ትንሸ ቡሼ ቃር የወሰክት ግድ ይኸንቢ። <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />የውስጢ ገገኛ በእዝጌር ሕጊ ይትብላለቅ። <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />ቢኸንም በገገኛ ውስጥ ይሸክቲ ያጢያት ሕጊ ይያ ኧጉጀኘ በወሰክት ተቀልበኛ ሕግጌ ይትዋጋ እንጐድ ሕጊ በገገኛ ውስጥ ቲሸክት አዥ። <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />እያ ምንኸም ጐስቋላንኩ! ተዚ ሟች ገግሽ ሟ ያተርፌ? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />በጔታና በኢየሱስ ክርስቶስ ኤማ ያተርፌ የእዝጌር ምስጋና የሕን!</para>
  <para style="p" vid="ROM 7:25">በሒሽ እያ ነብሰኛ በቀልበኛ፥ የእዝጌር ሕጊ ጉዙ ትንኸን በገገኛ ያጢያት ሕጊ ተገዢ ኸንኩም።<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s1">በመንፈስ ቅዱስ የኸነ ሕይወት</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />ስለኸነም በኢየሱስ ክርስቶስ ይነብሮ ኧሗ ኩነኔ ኤነቦ። <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />በኢየሱስ ክርስቶስ ይትረከቢ ሕይወት ይብ የመንፈስ ቅዱስ ሕጊ ተአጢያትም ተሞት ሕጊ ነጣ አወጤም። <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />ሕግ በሰብ ዓመል<note caller="+" style="f"><char style="fr" closed="false">8፥3 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">አጢአተኘ ኸልቀት፤ </char><char style="ft" closed="false">ዛምኸም ቁ. 4፡5፡8፡9፡12፡13 ኧዞ</char></note> የትነሣ ቌጠም ይᎊጥᎂ ያንቻለኒ፣ እዝጌር የፎለሑ ትኸኹ በአጢያተኛ ሰብ አምሳያ፣ የአጢአት መሥዋዕት<note caller="+" style="f"><char style="fr" closed="false">8፥3 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ስለ አጢአት መሥዋዕት</char></note> ይኸንኸም በወላሕ ᎊጠᎀን፤ በዚም የአጢአት በገገሑ<note caller="+" style="f"><char style="fr" closed="false">8፥3 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በአጢአተኘ ሰብ</char></note> ኰነነ፤ <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />ዚ የሸኰተን በሰብ ፈአድ ቴይኸን በመንፈስ ፈአድ ብንዥባበርነ ቢና ሱቲ የሕጊ ትዛዝ ይትፌጠምኸሙ። <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />በሰብ ፈአድ ይነብሮ የበሠር ቃር ዬስቦ፥ በመንፈስ ፈአድ ይነብሮዪም መንፈሳዊ ቃር ዬስቦ። <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />የበሰር ቃር ዋስብ ሞት ያቸኝ፤ መንፈሳዊ ቃር ዋስብ ሕይወት ሰላምም ይብ። <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />የበሰር ቃር ዬስብ ሰብ የእዝጌር ሕጊ ባለወታዘዘሑ የእዝጌር መሶው። <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />የበሠር ቃር ይትገዞ እዝጌር ዋትብላልቅ ኤይችሎ።<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />አሑም የእዝጌር መንፈስ በውስጣሑ ይነብር በኸነ በመንፈስ ፈአድ አንከንም በሕይወት ፈአድ አትነብሮ፤ የክርስቶስ መንፈስ ዬነን ሰብ የክርስቶስ ጐሳ አንከነ። <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />ክርስቶስ በአሑ ውስጥ በኸነ አትም ገጋሑ ተአጢያት መሳ ይᎀት ቢኸን እዝጌር ያጸደቀናሑ ስለኸነ መንፈሳሑ ሕያው። <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />የኢየሱስ ተሞት ያትኔሣን የእዝጌር መንፈስ በውስጣሑ ቢነብር የኢየሱስ ክርስቶስ ተሞት ያትኔሣኒ አምላክ በውስጣሑ ቢነብሪ መንፈሰሑ መሳ የሟች ገጋሑ ሕይወት ይቡ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 ቆሮ. 3፥16</ref>። </char></note><verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />ስለኸነም ጐባቢተኛ! በሕይወተና ግድ ነነብነ፤ ቢኸንም ዚ ግዴታ በሕይወት ፈአድ የወንብር አንከነ። <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />በሰብ ፈአድ ብትነብሮ ትᎀቶ፤ ቢኸንም በመንፈስ ቅዱስ ቆት የጅስምያ ሜናሑ ብትቀጥሮ በሕይወት ትነብሮ። <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />በእዝጌር መንፈስ ይትመሮ እንም የእዝጌር ዴንጋኖ። <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />ስለኸነም “አባ! አባና!” ባሑም ትጠሮᎄ የትኽነት መንፈስ ተቌበርኩም አንከንም በጊናት የወንብር ዠበርኩም የጉዙነት መንፈስ አንትቀበርኩ።<note caller="-" style="x"><char style="xo" closed="false">8፥15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">ማር. 14፥36</ref>፤ <ref loc="GAL 4:6">ገላ. 4፥6</ref>። </char></note> <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />የእዝጌር መንፈስ ቲና መንፈስጌ ኸነም የእዝጌር ዴንጋ ወሕነና ይና ይምሰክርንነ። <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />ኧጌ የእዝጌር ዴንጋ በኸነ የሑቲ ወራሾችንነ<note caller="+" style="f"><char style="fr" closed="false">8፥17 </char><char style="ft" closed="false">ወራሾችንነ፥ ወበር የእዝጌር የኸነዪ እንም ይና ይኸን ወበሩ። </char></note>፤ ተክርስቶስጌ ኧወርስነ፤ ኧሗ የክርስቶስ መከራ ኧሰድነ በኸነ ባንቌም የክብረሑ ኧሰድነ ኧኸነ።<note caller="-" style="x"><char style="xo" closed="false">8፥15-17 </char><char style="xt" closed="false"><ref loc="GAL 4:5-7">ገላ. 4፥5-7</ref>። </char></note><verse eid="ROM 8:17" /></para>
  <para style="s1">ይቸኚ ክብር</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />የሗዪ ዘበን መከራ ቲፍቴዬ ይና ቲትገለጥንነ ክብርጌ ቲᎂዝኒ ባትም ቃር ቂጦ ይኸኔ ኤቸልኸም ኧቆጥር። <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />ኸልቀት እንም የእዝጌር ዴንጋ መገለጥ በወደል ቡርሻት ይቂየ። <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />ኸልቀት እንም ኤድገልል ይኸንኸም ተፈረደወም፤ ዚም በፎለሑ ወሴ ቴይኸን በተስፋ ይቅየኸም እዝጌር በሸኰተን ፈአዱ።<note caller="-" style="x"><char style="xo" closed="false">8፥20 </char><char style="xt" closed="false"><ref loc="GEN 3:17-19">ዘፍ. 3፥17-19</ref>። </char></note> <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />ተስፋውታም ኸልቀት ነብሰሑ ተጥፋት ጉዙነት ነጣ ወጣም ተእዝጌር ዴንጋጌ ነጣነት ክብርም ይሰድ ይኸንኸሙ። <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />ኸልቀት እንም ቁናዬ ኧኳ ስን በመጥ ጭንቀት ተጠበጠም በወቃት ᎈር ወንብረሑ ኧሒርነ። <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />ቢኸንም በወቃት ᎈር ያነዪ ኸልቀት ጠለለ አንከነ፤ የመጀመሪያዪ የመንፈስ ቅዱስ ስጦታ የቌበርነ ኢናም የገገና ቤዛ የኸነዪ የእዝጌር ዴንጋ ወሕን በተስፋ ትንቂየነ በውስጢ ገገና በወቃት ᎈር ኧትረከብነ፤<note caller="-" style="x"><char style="xo" closed="false">8፥23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 ቆሮ. 5፥2-4</ref>። </char></note> <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />ኢና የተረፍነ በዚ ተስፋው። ቢኸንም ተስፋ ኧሸክትነይ ቃር ይታዥ በኸነ ተስፋ ወሕነሑ ይቀይ፤ ይታዢማ ሟ ተስፋ ይሸኩች? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />አናዥኔዪ ቃር ተስፋ በሸከትነም በትዕግሥት ኧቂየነ።<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />ዚም ምንኸም ኧጤልልነዬ አንሒርነ ስለኸነ መንፈስ ቅዱስ በቅጭናና ያግዝነ፤ በቃል ይትገለጤ ቤይቸል ወቃት ያማልደነ። <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />የሰብ ሒን ይምረምር አምላክ የመንፈስ ቅዱስ አሳብ ምን የኸነኸም ይሒር፤ መንፈስ ቅዱስ ስለምእመናን ያማልዲ የእዝጌር ፈአድኸሙ።<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />እዝጌር ይወዶዪም፥ የአሳበሑኸም የጠሮዪ ሰቦች እዝጌር እንም ቃር የፈያ ይሸክትኖኸም ኧሒርነ። <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />ዚም የኸነወ መሳ በደረም የሐረኖዪ ትኸሑ ይመስሮኸም፥ ትኸሑ በብዠ ጐባቢት ግብት በሕር ይኸንኸም እዝጌር በደረም የዌሰነ ስለኸነው። <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />በደረም የዌሰነኖዪ ጠራኖ፤ የጠራኖዪም አጸደቀኖ፤ ያጸደቀኖዪም አከበረኖ።<verse eid="ROM 8:30" /></para>
  <para style="s1">የእዝጌር ፍቅር</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />ኧጌሽ ስለዚ ምን ኧብርነ? እዝጌር ቲናጌ በኸነ ሟ ይቃወምነዬ ይችል? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />እዝጌር የቁና ትኸሑ ቴራራ ይና ይንመና በነጣ አቸለፈም ባᎄን ምንኸም ተትኸውጌ እንም ቃር በነጣ ኤይብነ? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />እዝጌር የሜጠረኖዪ ሟ ይከስሶ? ያጸድቅ ሑቲቱ። <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />ሟኒ ይፈርድ? ኢየሱስ ክርስቶስ ይፈርድቦ? ሑቲ ስለ ኢና የᎀተ፥ በሞት ተነሣም በእዝጌር አብ ከነ የቾና፥ ስለይና ይማልዲው። <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />ተክርስቶስ ፍቅር ይላኝነዬ ይችል ሟኒ? ምካት ወይሽ መከራ? ስደት፥ ወይሽ ጋጀ? ወይሽ እንጭትነት፥ ወይሽ አደጋ? ወይሽ ሰይፍ? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />ዚም፥</para>
  <para style="q1" vid="ROM 8:36">“ስላኸ ከነ በከነሑ ተሞትጌ እጋደልነ፤</para>
  <para style="q2" vid="ROM 8:36">ያርጅዮ ኧጤኸም ቆጠርነም”</para>
  <para style="m" vid="ROM 8:36">ቧሪም የጣፈኸሙ።<note caller="-" style="x"><char style="xo" closed="false">8፥36 </char><char style="xt" closed="false"><ref loc="PSA 44:22">መዝ. 44፥22</ref>። </char></note> <verse eid="ROM 8:36" /><verse number="37" style="v" sid="ROM 8:37" />በሒሽ በወደደነ በክርስቶስ ተዚሕኖ ቃር እንም ውራግ በወንሣ ታሸናፊዎቺ ኧበዛነ። <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />ስለኸነም ሞትም ቢኸን፥ ሕይወትም ቢኸን፥ መላይካም ቢኸኖ፥ ባለሥልጣኖችም ቢኸኖ፥ ኧሗም ያነዪም ቢኸን፥ ባንቌ ይቸኚም ቢኸን፥ አይለኞቺም ቢኸኖ፥ <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />ከፍታም ቢኸን፥ ዝቅታም ቢኸን፥ ሟንመሑ ኸልቀት ቢኸን በጔታና በኢየሱስ ክርስቶስ በረከብኔ ተእዝጌር ፍቅር ይላኝነዬ ኤይችል።<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s1">እዝጌር የእስራኤል ሕዝብ የሜጠረኸም</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />በክርስቶስ የኢኒ ኧዝነግ፤ አንዋሽ፤ በመንፈስ ቅዱስ ይትመራዪ ቀልበኛም አንዋሽኸም ይመሰክርኒ። <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />ብዠ አዘንም ኤቋረጥ ጭንቀት በሒነኛ ነነ፤ <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />የጐሳኛ ትንብር ስለጐባቢተኛ እያ ነብሰኛ የሰደብኩ ተክርስቶስም ተላኘሑም ያደጉኝ ኧኸንኸም ኧወድ ባነ። <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />ሕኖ የእስራኤል ሕዝብኖ፤ እዝጌርም የሕኖ ዴንጋሑ ሸከተኖ፤ ክብረሑ ገለጠኖ፤ የጉዳ ቃል ገባኖ፤ ሕጊ አበኖ፤ የኢኒ የአምልኮ ሤራ አቴዠኖ፤ የተስፋሑም ቃል አበኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥4 </char><char style="xt" closed="false"><ref loc="EXO 9:4">ዘፀ. 9፥4</ref>። </char></note> <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />ሕኖ በጨኘተሕኖ ተነገድ አቦች የቸኖኖ፤ ክርስቶስም በሰብ የቸኘ ተሕኖ ዘሩ፤ ሑቲ ትንም ነኑ፤ የዘለዓለምም የትባረከ አምላኩ፤ አሜን!<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />ቢኸንም የእዝጌር ቃል ተሻረም ወበር አንከነ፤ የእስራኤል ዝሬት በሙላ የኢኒ እስራኤላውያን አንከኖ። <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />ዛምኸም የአብርሐም ዝሬት እንም የአብርሐም ዴንጋኖ ወበር አንከነ። እዝጌር የአብርሐም “ዘር ይወጣንከ ይስሐቅ” የቧረን ስለኸነው<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="GEN 21:12">ዘፍ. 21፥12</ref>። </char></note> <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />ስለኸነም በዝሬት የአብርሐም ዴንጋ የኸኖ እንም የእዝጌር ዴንጋ አንከኖ፤ ቢኸንም ዝሬት ኸኖም ይቆጠሮ የተስፋዪ ቃል ዴንጋኖ። <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />ዚም እዝጌር ያᎄን የተስፋ ቃል “የኳ ዓመት በዚ ግዝየ ኧቸኝ፤ ሣራም ኧርጅ ትጨኝ” ይብር ባነ።<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="GEN 18:10">ዘፍ. 18፥10</ref>። </char></note><verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />ዚም ጠለለ ቴይኸን ርብቃ የነገድ አባና ተኸነዪ ተይስሐቅ ለምቻ ትኸ ዄት ነብስ በኸነች ግዝየ፥ <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />የእዝጌር ምርጫ በሜና ቴይኸን በጥሪ ወሕነሑ የዋተዥ ዄቲ ዴንጋ ተወጠኘሕኖ ቡሼም ኸነ ፈያ ተወሰክተሕኖ ኢፍት <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />እዝጌር የርብቃ “ንኢዪ የንሲ ተገዢ ይኸን” ባረና።<note caller="-" style="x"><char style="xo" closed="false">9፥12 </char><char style="xt" closed="false"><ref loc="GEN 25:23">ዘፍ. 25፥23</ref>። </char></note> <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />ዚም “ያዕቆብ ወደድኩን ዔሳው ጠላሑን”<note caller="+" style="f"><char style="fr" closed="false">9፥13 </char><char style="ft" closed="false">ጠላሑ፥ ወበር የእዝጌር ምርጫው አንከንም ወጥላ አንከነ ወበሩ። </char></note> ቧሪም የጣፈኸሙ።<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="MAL 1:2-3">ሚል. 1፥2-3</ref>። </char></note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />ኧጌሽ መአር ኧብርነ? እዝጌር ያዳላ ወበር ኧችልነ? እዝጌር ያዳላ ወበርሽ ስርም አንችልነ! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />እዝጌር የሙሴ “ኧᎀሬ ኧሸኒ ኧᎀር፥ ኧራራነዬ ኧሸኒ ኧራራነ” ቧረንም።<note caller="-" style="x"><char style="xo" closed="false">9፥15 </char><char style="xt" closed="false"><ref loc="EXO 33:19">ዘፀ. 33፥19</ref>። </char></note> <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />ስለኸነም የእዝጌር ምርጫ ይትረከብ በሰብ ፈአድ በሰብ ሜናም ቴይኸን በእዝጌር ምረቱ። <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />መጽሐፍ የፈርዖን፤ “ቆተኛ በአኸ ይታዥኸም፤ ሽመኛም በገኝ እንም ይቴወድከም የዚ አትኔሣከኸ” ይብር።<note caller="-" style="x"><char style="xo" closed="false">9፥17 </char><char style="xt" closed="false"><ref loc="EXO 9:16">ዘፀ. 9፥16</ref>። </char></note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />ስለኸነም እዝጌር ይሸኒ ይᎀር፤ ይሸኒም እልኸኘ ይሸኩች።<verse eid="ROM 9:18" /></para>
  <para style="s1">የእዝጌር ማተሑ ምረተሑ</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />ስለኸነም “የእዝጌር ፈአድ የወቃወም ሟንም ኤይችል፤ ኧጌ፥ ሑቲ የሰቦች በቡሼ ሜናሕኖ የመአር ይወቅሶ” ባኸም ትሰሌ ይኸን። <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />አኸ! ተእዝጌርጌ ትትሟገቴ ምን መብት ነነናኸ? የሸክላ ግብር ይሸክቲ “የመአር የዚኸም ሸከትኬ?” ይቡን?<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="ISA 29:16">ኢሳ. 29፥16</ref>፤ <ref loc="ISA 45:9">45፥9</ref>። </char></note> <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />ሸክላ ይሸክቲ፤ ቢሸኩቺ ጭቃራ አቲ የክብር፥ እንጐዲ የተራ አገልግሎት ይብኸም የወሰክት ሥልጣን ኤነን?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />እዝጌር ማተውታ የዋተዥ ቆተሑ የወግልጥ ሸም የወጥፋ የዝጋዶዪ የማት ግብር ብዠ ፈረኸኖም በኸነ ምን ትሒር? <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />ዚም የሸኰተን በደረም የክብር ያዝጋጀኖዪ የምረት ግብሮች የክብረሑ ብዛት የዋተዡ። <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />ይና የምረት ግብረሑ ተአይሑድ ጠለለ ቴይኸን ተአሕዛብም ጠራነም። <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />ዚም በነቢዪ በሖሴዕ እኪ የቧሪኸሙ፦</para>
  <para style="q1" vid="ROM 9:25">“ይያ ሕዝብ ያንከነዪ ‘ሕዝበኛ!’ ባሑም ኧጠራኖ፤</para>
  <para style="q2" vid="ROM 9:25">ያንትወደደሚ ሕዝብ ‘የትወደደ!’ ባሑም ኧጠራን፤<note caller="-" style="x"><char style="xo" closed="false">9፥25 </char><char style="xt" closed="false"><ref loc="ROM 2:23">2፥23</ref>። </char></note><verse eid="ROM 9:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ROM 9:26" />ሕኖ ‘ሕዝበኛ አንከንኩ’ በቧሪዮዪ መደር</para>
  <para style="q2" vid="ROM 9:26">‘የሕያው እዝጌር ዴንጋ’ ቧርዮም ይጠሬዮ።”<note caller="-" style="x"><char style="xo" closed="false">9፥26 </char><char style="xt" closed="false"><ref loc="ROM 1:10">1፥10</ref>። </char></note><verse eid="ROM 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 9:27" />ነብዪ ኢሳያስም የእስራኤል እኪ ቲብር ጣምባሑ ከፍ አበኘም ይዝነግ፤ “የእስራኤል ዴንጋ ቁጥር የባር አሸዋ ቅጫ ቢበዛ ተሕኖ ይተርፊ ቀሉ። <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />ጔታ ቴያቶርር አቴከለም ፍርደሑ በዓለም ᎈር ይብ።”<note caller="-" style="x"><char style="xo" closed="false">9፥27-28 </char><char style="xt" closed="false"><ref loc="ISA 10:22-23">ኢሳ. 10፥22-23</ref>። </char></note> <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />የዛምኸም ኢሳያስ “የሠራዊት ጔታ ዝሬት ቤያቀይንነ የሰዶም የገሞራም ከተማ የጠፎኸም ኢናም በጠፋነ ባነ” ቲብር በደረም ዝነገም።<note caller="-" style="x"><char style="xo" closed="false">9፥29 </char><char style="xt" closed="false"><ref loc="ISA 1:9">ኢሳ. 1፥9</ref>። </char></note><verse eid="ROM 9:29" /></para>
  <para style="s1">የእስራኤል አለወምን</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />ኧጌሽ መአር ኧብርነ? ጽድቅ ያንትኸተሎዪ አሕዛብ ጽድቅ ረከቦ፤ ዚም ጽድቅ በእምነት የትረከበው። <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />ቢኸንም ጽድቅ ይረሕቡᎄዪ ሕጊ ይትዄተሎ የነበሮዪ እስራኤል ሕጊ የወፈጥም ባለወቻልሕኖ ተጽድቄ አንሰሎ። <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />“የመአር ተጽድቄ አንሰሎ?” ቢቡሪ ሕኖ ጽድቅ የወርክብ የሸዎ በእምነት ቴይኸን በሜና ስለኸነው፤ ስለኸነም ቈፋ ቢኸኒ ኧምን ተስናከሎ፤ <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />ዚም፦</para>
  <para style="q1" vid="ROM 9:33">“ዘ፥ የሰቦች ቈፋ ይኸን እምን በጽዮን አወና፤</para>
  <para style="q2" vid="ROM 9:33">ዚም እምን የሰቦች ቈፋ በወሕን ያድግ ዓለቱ፤</para>
  <para style="q1" vid="ROM 9:33">በሑቲ ያምን ኤሟልል”</para>
  <para style="m" vid="ROM 9:33">ቧሪም የጣፈኸሙ።<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="s1">እስራኤላውያን የእዝጌር ኤማ አልወትኸተለሕኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />ጐባቢተኛ!<note caller="+" style="f"><char style="fr" closed="false">10፥1 </char><char style="ft" closed="false">ጐባቢተኛ </char><char style="fp" closed="false">ወበር በኢየሱስ ክርስቶስ ያመኖ አማኞች ወበሩ። </char></note> በሒነኛ ያነዪ ንቅ ኤላት፥ ተእዝጌሬ አቀርቡ ጠሎት እስራኤላውያን ይተርፎኸሙ። <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />የኢኒ ውቀት አለወሕነሑ አንከንም ሕኖ የእዝጌር መንፈሳዊ ቅናት ያነኖኸም እያ ራሰኛ ኧምሰክርኖ። <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />እዝጌር የሰቦች ያጸድቅወ ኤማ ባለወሐረሕኖ የፎለሕኖ የጽድቅ ኤማ ተዄተሎ አንኸንም የእዝጌር ጽድቅ አንተኸተሎ። <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />ሰብ እንም በእምነት ይጸድቅኸም ሕጊ በክርስቶስ ተፌጠመም።<verse eid="ROM 10:4" /></para>
  <para style="s1">ወትርፍ ይንም ወሕነሑ</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />በሕግ ኤማ ይትረከቢ ጽድቅ ሙሴ የጣᎈን “የእዝጌር ሕጊ ይፌጥም እንም በሕይወት ይነብር” ይብር።<note caller="-" style="x"><char style="xo" closed="false">10፥5 </char><char style="xt" closed="false"><ref loc="LEV 18:5">ዘሌ. 18፥5</ref>። </char></note> <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />እዝጌር የሰቦች በእምነት ያጸድቅኸም እኪ ቧሪም ጣᎉም፤ “በሒናኸ ተሰሜዬ ሟ ይወጣ?” አትበር፤ ዚም ክርስቶስ የዋውርዱ፤ <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />በሒናኸ “ተሲኦሌ ሟ ይወርድ?” አትበር፤ ዚም የክርስቶስ በሞት የዋትነሣው።<verse eid="ROM 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 10:8" />ኧሗም እኪ ቧሪም ተጣፈም፦ “የእዝጌር ቃል በሜጠቃኸው፤ ዛምኸም በአፋኸ በሒናኸሙ፤” ዚም ቃል ኢና ኧሰብክነይ የእምነት ቃሉ።<note caller="-" style="x"><char style="xo" closed="false">10፥6-8 </char><char style="xt" closed="false"><ref loc="DEU 30:12-14">ዘዳ. 30፥12-14</ref>። </char></note><verse eid="ROM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 10:9" />ኢየሱስ ጔታ ወሕነሑ በአፋኸ ብትምሰክር እዝጌር ተሞት ያትኔሣንኸም በሒናኸ ብታምን ትተርፍ። <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />ሰብ በሒነሑ ቲያምን ይጸድቅ፤ ባፈሑ ቲምሰክር ይተርፍ፤ <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />በቅዱስ መጽሐፍ የጣፈኸም፦ “በሑቲ ያምን እንም ኤሟልል።”<note caller="-" style="x"><char style="xo" closed="false">10፥11 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28፥16</ref>። </char></note> <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />ኧጌሽ ቁናዪ ጔታ ይንም ጔታ ስለኸነ በአይሑድ በአሕዛብም አትም ልዩነት ኤነ፤ ሑቲም ይጮቅሶዪ እንም በረከተሑ አበዛም ይብ፤ <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />“የጔታ ሽም አመነም ይጠራ እንም ይተርፍ” ቧሪም።<note caller="-" style="x"><char style="xo" closed="false">10፥13 </char><char style="xt" closed="false"><ref loc="JOL 2:32">ኢዩ. 2፥32</ref>። </char></note><verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />ቢኸንም ቴያምኖᎄ ምንኸም ይጠሮዬ ይችሎ? ስለሑቲ ቴይሰሞሽ ምንኸም ያምኖ? ይሰብክ ቴነብር ምንኸም ይሰሞዬ ይችሎ? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />ሰባኪዎችሽ ባንትላሖ ምንኸም ይሰብኮ? ዚም “የፈያ ዜና አብሣሪዎች ወተኘሕኖ ምንኸም ያትብላልቅ!” ቧሪም የጣᎉኸሙ።<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52፥7</ref>። </char></note> <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />ቢኸንም ኢሳያስ፥ “ጔታ! የዝነጔኔዪ ቃል ሟ ተቌበረ” ባረም የዝነጔኸም፥ እንም የምሥራቺ ቃል አንትቀበሮ።<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">ኢሳ. 53፥1</ref>። </char></note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />ኧጌሽ እምነት ተወስማው ወስማም በክርስቶስ ቃሉ። <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />እንዴ ንሳል፤ ኧጌ፥ ቃለሑ አንሰሞ ወበሩ? በቅዱስ መጽሐፍ፥</para>
  <para style="q1" vid="ROM 10:18">“ጣምባሕኖ በዓለም እንም ተሴማ፤</para>
  <para style="q2" vid="ROM 10:18">ቃለሕኖም አፈር ጥግ ስን ሰላ”</para>
  <para style="m" vid="ROM 10:18">ቧሪም የጣፈኸም፥ የኢንም ሰሞም።<note caller="-" style="x"><char style="xo" closed="false">10፥18 </char><char style="xt" closed="false"><ref loc="PSA 19:4">መዝ. 19፥4</ref>። </char></note> <verse eid="ROM 10:18" /><verse number="19" style="v" sid="ROM 10:19" />ኧሗም፥ እስራኤል ቃሊ አንካሮ ወበሩ? ዚ ኤይቡሪኸም ሙሴ በደረም</para>
  <para style="q1" vid="ROM 10:19">በትናቀ ሕዝብ አትቄናም አትቆጭሑ፤ ቤያጥራምት ሕዝብም አትናድድኩ ባረም።<note caller="-" style="x"><char style="xo" closed="false">10፥19 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዘዳ. 32፥21</ref>። </char></note><verse eid="ROM 10:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ROM 10:20" />ኢሳያስም፦</para>
  <para style="q1" vid="ROM 10:20">“ያንሸዎኝ ተረከብኩ፤</para>
  <para style="q2" vid="ROM 10:20">ያንትሳሎኝም ኧራሰኛ ገለጥኩኖ፤”</para>
  <para style="m" vid="ROM 10:20">ይብር።<note caller="-" style="x"><char style="xo" closed="false">10፥20 </char><char style="xt" closed="false"><ref loc="ISA 65:1">ኢሳ. 65፥1</ref>። </char></note> <verse eid="ROM 10:20" /><verse number="21" style="v" sid="ROM 10:21" />ስለእስራኤላውያንም “ኤይታዘዝ ዐመጠኘ ሕዝብ ቲያዬ ይቸኝኸም ከነዪ ሙላ ኧጆቸኛ ዝረጋሑነ” ይብር።<note caller="-" style="x"><char style="xo" closed="false">10፥21 </char><char style="xt" closed="false"><ref loc="ISA 65:2">ኢሳ. 65፥2</ref>። </char></note><verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s1">እዝጌር የእስራኤላውያን ፈጀም ያነደገ ወሕነሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />እንዴ ኧሗም ንሳል፦ እዝጌር የራሰሑ ሕዝብ አደገም? ስርም አነደጐን! እያም ኧራሰኛ እስራኤላዊንኩ፤ ተአብርሐም ዝሬት የኸንኩ የብንያም ነገድንኩ።<note caller="-" style="x"><char style="xo" closed="false">11፥1 </char><char style="xt" closed="false"><ref loc="PHP 3:5">ፊልጵ. 3፥5</ref>። </char></note> <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />እዝጌር በደረም የᎂጠረን ሕዝብ አነደጐን፤ ቅዱስ መጽሐፍ ስለኤልያስ ምን የባረኸም አታስታውሶ? ኧሗም ኤልያስ የእስራኤል ሕዝብ በእዝጌር ኢፍት ምን ባረም የከሰሰኸም አትሒሮ? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />በዛ ግዝየ ኤልያስ “ጔታ! የነብዮቻኸ ቀጠሮ፤ መሠዊያዎቻኸ አፈረሶ፤ እያ ጠለለ ቀኘሑ፤ ይያም ይቀጥሮኜ ይሸዎ” ባረም ባነ።<note caller="-" style="x"><char style="xo" closed="false">11፥3 </char><char style="xt" closed="false"><ref loc="1KI 19:10">1 ነገ. 19፥10</ref>፤ <ref loc="1KI 14">14</ref>። </char></note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />ቢኸንም እዝጌር መአር ባረም ዠᎄረነ? “በዓል የቧሪዪ ጣዖት ያንሰገዶዪ ሰበት ሺ ሰቦች የፎለኛ አቀኘሑም” ቧረንም።<note caller="-" style="x"><char style="xo" closed="false">11፥4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">1 ነገ. 19፥18</ref>። </char></note> <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />በሗዪም ዘበን ቢኸን፥ በጸጋ ተሜጠሮም የቀኖ ቀል እስራኤላውያን ነኖ። <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />ምርጫዪ በጸጋ በኸነ በሜና አንከነ ወበሩ፤ በሜና ቢኸነማ፥ ጸጋ ቤድገልሉ።<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />ኧጌ፥ ውጤተሑ መአር ኸነ? እስራኤል የሸዎዪ አረኸቦ፤ የትሜጠሮዪም የሸዎዪ ረከቦ፤ የቀኖዪ ሒነሕኖ አድነደኖ። <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />ዚም “እዝጌር ቀልበሕኖ አድነዘዘ፤ ስለኸነም ኧኳ ስን ቤነሕኖ ኤያዞ፤ ብዝነሕኖም ኤሰሞ” ቧሪም የጣፈኸሙ።<note caller="-" style="x"><char style="xo" closed="false">11፥8 </char><char style="xt" closed="false"><ref loc="DEU 29:4">ዘዳ. 29፥4</ref>፤ <ref loc="ISA 29:10">ኢሳ. 29፥10</ref>። </char></note> <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />ዳዊትም፦</para>
  <para style="q1" vid="ROM 11:9">“ማዳሕኖ ይጠብጥ ወሳኸ፥</para>
  <para style="q2" vid="ROM 11:9">ያድግ ጐጀ ኸነም ያሥቃይኖ!</para>
  <para style="q2" vid="ROM 11:9">የሸከቶይ ቡሼነት በፎለሕኖ የስላ!<verse eid="ROM 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ROM 11:10" />ዔነሕኖ ኤያዥከም የጨልም፤</para>
  <para style="q2" vid="ROM 11:10">ጊንዠሕኖም በምካት እንጌ የትከባ” ባረም።<note caller="-" style="x"><char style="xo" closed="false">11፥9-10 </char><char style="xt" closed="false"><ref loc="PSA 69:22-23">መዝ. 69፥22-23</ref>። </char></note><verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />ተዠበሮም ኤይተርፎ ስን ተስናከሎ? ዠበርኩም ኧሰል፤ ስርም አንከነ፤ ይጠቅሊም የእስራኤል የዋትቀና ቲቡሪ በሕኖ ወችላለፍ መሳ ወትርፍ የአሕዛብ ቸኘም። <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />የአይሑድ በደል የዓለም ብዠ በረከት አትሬከበም፤ የሕኖም ወውጥቅ የአሕዛብ በረከት ኸነም፤ አይሑድ እንም ቢተርፎማ በረከቲ ምናሕር ብዠ ባነ!<verse eid="ROM 11:12" /></para>
  <para style="s1">የአሕዛብ ወትርፍ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />ኧሗ ኧጌ ኧዝነግ ያሑ የአሕዛቡ፤ የአሕዛብም ሐዋርያ የኸንኩ ቅጫን በአገልግሎተኛ ክብር ይሴሜ፤ <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />ዚም ወሠክተኛ ዝሬተኛ የኸኖዪ አይሑድ ይቀኖኸም የወሰክቱ፤ በዚም ሐለት የሟንመሑ ተሕኖ አታተሕኖ የዋትርፍ ኧችል ይኸን በወበሩ። <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />እዝጌር የሕኖ ባደገኖ ግዝየ እንጐዲ የዓለም ሕዝብ ተእዝጌርጌ በታረቀ እዝጌር የሕኖ ቢቌበሮ ግዝየ መአር ይኸን ይመስርሑ? ዚማ ተሞት የወትነሣ ቅጫው!<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />በቁና ቡኮ የመጀመሪያዪ የትቄደሰ በኸነ ቡኮዪ እንመሑ የቌደሰ ይኸን፤ የዚምኸም የቁና ኧጨ ሥረሑ የትቄደሰ በኸነ ጫፈሑም የትቄደሶ ይኸኖ። <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />የጓራ የወይራ ኧጨ ጫፍኸም የኸኖ አይሑድ አረጪዮም ቢወጥቆ አሑ የድብር የወይራ ኧጨ ጫፍኸም የኸንኩ አሕዛብ በመደረሕኖ ተሸገርሑም የሕኖ ዱኒያ በረከትም ትሰዶ ብትኸኖ፥ <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />አሑ አሕዛብ የጨ ጫፍኸም አረጪዮም በወጠቆዪ አይሑድ ᎈር አትኩራሮ፤ ብትኩራሮ አሑ ጫፍ ጠለለ በወሕናሑ ሥሪ ያሑ ይጮርኩ አንኸንም አሑ ሥሪ አትጮሮ ወሕናሑ አስታውሶ።<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />ቢኸንም “ጫፊ ተሰበሮም የወጠቆ እያ በመደረሕኖ ኧሸገርኸሙ” ትብሮ ይኸን። <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />ወበራሑሽ ልኩ፤ ቢኸንም ሕኖ ታረጦም የወጠቆ ባለወምነሕኖ ቲኸን አሑ ብረታሑም የቈምኩ በወምናሑው፤ ኧጌ፥ ወገናው አንከንም ወትነነድ ኤይጌባሑ። <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />እዝጌር በኸልቀት ጫፍ የኸኖዪ አይሑድ ባናምጠጦይ የአሑም ኤያመጦኩ። <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />ኧጌሽ የእዝጌር ሜናነት ዋገናውታም ተመልከቶ፤ ዋጔናሑ ያቴዥ በወጠቆዪ ᎈር ቲኸን ሜናነተሑ ያቴዢ ያሑቱ፤ ዚም ይሸክት የሑቲ በወምን ብረታሑም ብትነብሮው፤ ባትጠኖም አሑም ታረጥኩም ትወጥቆ። <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />አይሑድ አለወምነሕኖ ቢገፍሮ ተድረ መደረሕኖዬ ይዠበሮ፤ እዝጌር ቲፍቴ መደረሕኖዬ ይዠበሮዬ ይችል። <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />አሑ አሕዛብም በኸልቀት የድብር የወይራ ኧጨ ጫፍ ኸንኩም ትናነ ያለ መደራሑ በጓራ የወይራ ኧጨ ᎈር ወትቀበር በቻልኩ ነዚ በኸልቀተሕኖ የጓራ የወይራ ኧጨ ጫፍ የኸኖዪ አይሑድማ ቲፍቴ መደረሕኖዬ ተዠበሮም ወቀበር ምንኸም ኤይቸሎ!<verse eid="ROM 11:24" /></para>
  <para style="s1">የእዝጌር ምረተሑ ይንም ወሕነሑ</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />ጐባቢተኛ! “ኢና ኧሒርነ” ባሑም አትትነነዶ፤ ኢውድሑ አት ምስጢር ነነ፤ ዚም እስራኤል ኤበሑ ወበር ኸቼም ስን ቴይኸን አሕዛብ እንም በሙላት ተእዝጌሬ ይቸኖ ስኑ። <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />በሒሽ በዚኸማት እስራኤል እንም ይተርፎ። ስለኸነም እኪ ቧሪም ተጣፈም፦</para>
  <para style="q1" vid="ROM 11:26">“ያተርፍ በጽዮን ይቸኝ፤</para>
  <para style="q2" vid="ROM 11:26">ተያዕቆብ ዝሬት እንም ቡሼነት ያትዌግድ፤<note caller="-" style="x"><char style="xo" closed="false">11፥26 </char><char style="xt" closed="false"><ref loc="ISA 59:20">ኢሳ. 59፥20</ref>። </char></note><verse eid="ROM 11:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ROM 11:27" />አጢያተሕኖም በድመሰስክኖ ግዝየ</para>
  <para style="q2" vid="ROM 11:27">ተሕኖጌ ኧገቧን የጉዳ ቃል ዚቱ።”<note caller="-" style="x"><char style="xo" closed="false">11፥27 </char><char style="xt" closed="false"><ref loc="JER 31:33-34">ኤር. 31፥33-34</ref>። </char></note><verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />እስራኤላውያን የወንጌል ቃል ባለወቀበረሕኖ ያሑ የአሕዛብ ጥቅም የእዝጌር መሶ ኸኖም፤ ቢኸንም በትሜጠረ ኤማ በዝሬት አቦቸና መሳ የእዝጌር ደቦኖ። <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />እዝጌር ሜጠረም ጸጋሑ ባበ አንቌ በሸኰተን ቃር አሳበሑ ኤሸግር። <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />አሑ አሕዛብ ድረ የእዝጌር አትታዘዞ ባነሑ፤ ኧሗም አይሑድ ባለወታዘዘሕኖ መሳ አሑ የእዝጌር ምረተሑ ረከብኩ። <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />አሑ ምረተሑ በረከብኩᎄ አለት ሕኖም ምረተሑ ይረኸቦኸም ሕኖ ኧሗ የእዝጌር ኤይታዘዞ ኸኖም። <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />እዝጌር ምረተሑ የሰብ እንም የዋተዥ ቲብር ሰቦች እንም በምቢተኝነተሕኖ ኧጉጀኘ ሸከተኖ።<verse eid="ROM 11:32" /></para>
  <para style="s1">የእዝጌር የቀረበ ምስጋና</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />የእዝጌር ደገኝነት ብላትም ውቀትም ምንኸም የጠለቀው! ፍርደሑ ኤሙረሙሪ፥ ኤማመሑ ኤይሑሪ።<note caller="-" style="x"><char style="xo" closed="false">11፥33 </char><char style="xt" closed="false"><ref loc="ISA 55:8">ኢሳ. 55፥8</ref>። </char></note><verse eid="ROM 11:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="ROM 11:34" />“የጔታ አሳብ ይሒር ሟኒ?</para>
  <para style="q2" vid="ROM 11:34">የሑቲ አማካሪ ይኸንሽ ሟኒ?<note caller="-" style="x"><char style="xo" closed="false">11፥34 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40፥13</ref>። </char></note><verse eid="ROM 11:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ROM 11:35" />የእዝጌር ያታድግ</para>
  <para style="q2" vid="ROM 11:35">ያታደጐኒሚ ይወስድ ሟኒ?”<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />እንም የትረከበ ተሑቲ፥ በሑቲም የሑቲቱ፤ የዘለዓለም ክብር የሑቲ የሕን! አሜን!<note caller="-" style="x"><char style="xo" closed="false">11፥36 </char><char style="xt" closed="false"><ref loc="1CO 8:6">1 ቆሮ. 8፥6</ref>። </char></note><verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s1">እዝጌር ይቈᎄር መሥዋት</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />ኧጌሽ ጐባቢተኛ! የእዝጌር ያትብላልቅ፥ ሕያው የትቄደሰም መሥዋት፣ ሸከትኩም እንቃራሑ ታቀርቦኸም በእዝጌር ሜናነት ኧጮቅስኩ፤ መሳመሑ ዚም ዋቅርብ ይጌባሑ ቅንነት ያነን የኢኒ የእዝጌር አገልግሎቱ። <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />ፈያዪ ያትብላልቂም ፍጡም የኸነዪ የእዝጌር ፈአድ ወሐር ትችሎኸም አእምሮአሑ በዋድስ ሕይወታሑ የሰገር አንኸንም ዚ ዓለም አትምስሮ።<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />ኧሗም አትባታሑ እዝጌር ባበናሑ እምነት ቅጫ በቁና ቀልብ አስቦ አንከንም ቲትጌባሑ ነን የፎላሑ በትዕቢት አታስቦ ባሑም ባቡኝ ጸጋ ኢውድሑ። <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />በቁናዪ ጅስመና ብዠ ክፍሎች ነኖ፤ አትባተሑ የጅስመና ክፍል የትልያየ ሜና ነነን። <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />ዛምኸም ኢና ብዠ ኸነም ትናነነ በክርስቶስ ቁና ጅስምንነ፤ የቁና ጅስም ወሕነና አት ባተና ተጥባበጥነም።<note caller="-" style="x"><char style="xo" closed="false">12፥4-5 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 ቆሮ. 12፥12</ref>። </char></note> <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />ስለኸነም እዝጌር በጸጋሑ ያበነዪ የትልያየ ስጦታ በሜና ᎈር ናወልነ፤ ስጦታና የእዝጌር ቃል ዋውጅ በኸነ፤ በእምነተና ቅጫ የእዝጌር ቃል ናውጅነ። <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />ስጦታና ይንጐዲ ዋገልግል በኸነ በወጋደል ናገልግልነ፤ ስጦታና ዋትመር በኸነ ባግባበሑ ናትመርነ፤ <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />ስጦታና ወምክር በኸነ ንምክርነ፤ ስጦታና ዋብ በኸነ ተሒን ናብነ፤ ስጦታና ዋትዳድር በኸነ በወጋደል ናትዳድርነ፤ ስጦታና ምረተሑ ወሰክት በኸነ ዛም በብልቃት የማር።<note caller="-" style="x"><char style="xo" closed="false">12፥6-8። </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">1 ቆሮ. 12፥4-11</ref>። </char></note><verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />ግብዝነት ዬነወ የኢነተኘ ፍቅር የንብርኩ፤ ቡሼዪ ቃር ጥሎ፤ ፈያዪ ቃር ተኸተሎ። <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />ነብስ በነብሳሑ በጐባቢትነት ወትዋደድ አጥብቆም ተዋደዶ፤ ነብስ በነብስማሑ የወክባበርም ተውዳደሮ፤ <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />ታትስለትቶ በጋለ መንፈስ ተዄተልኩም የጔታ አገልግሎ። <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />በተስፋ ተብላለቆ፤ በመከራ ግዝየ ፍረኮ፤ ተጋደሎም ጠልዮ። <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />ምካተኘ የኸኖ ቅዱሳን ባነናሑ ቃር ርዶ፤ በባዘናነት ይቸኖዪ ተቀበሮ።<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />ያሳድዶኩዪም መርቆ፤ መርቆዮ አንከንም አትስድቦዮ።<note caller="-" style="x"><char style="xo" closed="false">12፥14 </char><char style="xt" closed="false"><ref loc="MAT 5:44">ማቴ. 5፥44</ref>፤ <ref loc="LUK 6:28">ሉቃ. 6፥28</ref>። </char></note> <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />ቲትብላለቆዪጌ ተብላለቆ፤ ቲበኮዪጌ ብኮ። <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />ነብስ በነብሳሑ በቁና አሳብ ተስማሞም ንበሮ፤ ነብሳሑ ከፍ ተዋቢ የጠቀለ ትዕቢት አጥፎም ተዜጋጌ ቁናዬ ንበሮ፤ በራሳሑ ኧሒርነ አትበሮ።<note caller="-" style="x"><char style="xo" closed="false">12፥16 </char><char style="xt" closed="false"><ref loc="PRO 3:7">ምሳ. 3፥7</ref>። </char></note><verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />በሰብ እንም ኢፍት ፈያ የኸነዪ ቃር ሰክቶ አንከንም፥ ሰቦች ቡሼ ቃር ቲሸክቶቡኩ፥ አሑም ዠበርኩም ቡሼ ቃር አትሰክቶቦ። <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />ቢቸልኩሽ ባሑ ኤማ ተሰብ እንም በሰላም ንብሮ። <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />ደቦቸኛ! ማት የእዝጌር ግፍሮ አንኸንም ራሳሑ አትበቀሎ፤ “ኧቤቀል የወበቀልም ኧዳ ኧከፍል እያትንኩ ይብር ጔታ እዝጌር” ቧሪም ጣᎉም።<note caller="-" style="x"><char style="xo" closed="false">12፥19 </char><char style="xt" closed="false"><ref loc="DEU 32:35">ዘዳ. 32፥35</ref>። </char></note> <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />ስለኸነም ተወበቀል የጠቀለ መሶአኸ ቢትገድ አቡራን፤ ቢጠሟን አስጤን፤ ዚ ብትሸክት የሳት ፌም ትጨንወ።<note caller="-" style="x"><char style="xo" closed="false">12፥20</char><char style="xt" closed="false"><ref loc="PRO 25:21-22">ምሳ. 25፥21-22</ref>። </char></note> <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />ስለኸነም ቡሼ ቃር በፈያ ቃር ቂም አንከንም በቡሼ ቃር አትቂም።<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s1">የመንግሥት ባለሥልጣን ወታዘዝ ይጌባኸም</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />ሟንመሑ ሥልጣን ይትረከብ በእዝጌር ፈአዱ፤ ኧሗ ያኖዪም ባለሥልጣኖች የሾሞ በእዝጌር ስለኸነ፥ ሰብ እንም የባለሥልጣን ወታዘዝ ነነወ። <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />ስለኸነም የባለሥልጣን ይቃወም እንም የእዝጌር ትዛዝ ይትቃወም፤ ኤታዘዝ እንም በነብሰሑ የቅጣት ፍርድ ያቸኝ። <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />ገዢዎች ያጔኖ የቡሼ ይሸክቶዪው አንኸንም ፈያ ይሸክቶዪ አንከነ፤ የባለሥልጣን አትጔናኸም ትሸ? ኧጌሽ ፈያ ሰክት፤ በሑቲም ምስጋና ትረሕብ። <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />ባለሥልጣን ያኸ ፈያ ይሸክቴ የሾመ የእዝጌር አገልጋዪ፤ ባለሥልጣን ሰይፍ የታገደ እክም አንከነ፤ ቡሼ ትሸክት በኸንከ የባለሥልጣን ገና፤ ሑቲ ቡሼ ይሸክቶዪ በወቅጣ የእዝጌር በቀል በዋተዥ የእዝጌር ያግለግል። <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />ስለኸነም የመንግሥት ባለሥልጣኖች ወታዘዝ ይጔባሑ፤ ትታዘዞም የእዝጌር ማት ጔናሑ ጠለለ ቴይኸን ቀልባሑ ይወቅስሑ ስለኸነው።<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />ግብር ትከፍሎ የዚቱ፤ ባለሥልጣኖች በዚ ሜና ᎈር የዋሎ የእዝጌር የዋገልግሉ። <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />ኧጌሽ የባለሥልጣን ይጌባዪ እንም ሰክቶ፤ ግብር ይጌቧኒ ግብር፥ ቀረጥ ይጌቧኒ ቀረጥ ክፍሎ፤ ጊናት ይጌቧኒ ገኖ፥ ክብር ይጌቧኒ አክብሮ።<note caller="-" style="x"><char style="xo" closed="false">13፥6-7 </char><char style="xt" closed="false"><ref loc="MAT 22:21">ማቴ. 22፥21</ref>፤ <ref loc="MRK 12:17">ማር. 12፥17</ref>፤ <ref loc="LUK 20:25">ሉቃ. 20፥25</ref>። </char></note><verse eid="ROM 13:7" /></para>
  <para style="s1">ነብስ በነብስ ወትዋደድ</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />የሟንም ኧዳ ኤንበርብኩ፤ ይነብርብኩዬ ይጌባ ኧዳ ነብስ በነብሳሑ ወትዋደድ ጠለለው፤ መሳሑታም ሰብ ይወድ እንም ሕጊ ይፌጥም። <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />“አትሟግጥ፤ የሰብ አትቅጥር፤ አትስርቅ፤ ይንጐድ ሰብ የኸነዪ ሟንም ቃር አታላ” ይብሪ ትዛዝ የንጐዲም ትዛዝ እንም “ሰብ እንም የነብሳኸኸም ሰክትም ውደድ” ቢብሪ በቁናዪ ትዛዝ ተጥቃለለም ይትረከብ።<note caller="-" style="x"><char style="xo" closed="false">13፥9 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ዘፀ. 20፥13</ref>፣<ref loc="EXO 20:15">15</ref>፤ <ref loc="EXO 17">17</ref>፤ <ref loc="DEU 5:17-19">ዘዳ. 5፥17-19</ref>፤ <ref loc="DEU 21">21</ref>፤ <ref loc="LEV 19:18">ዘሌ. 19፥18</ref>። </char></note> <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />ሰብ ይወድ እንም ቢወጅጂ ሰብ ᎈር ቡሼ ኤሸክትወ፤ ስለኸነም ሰብ ይወድ እንም ሕጊ ፌጠመ ወበሩ።<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />ኧጌሽ በወኔት ትነሶᎄ ሰዓት ኧሗ ወስላሑ ሐሮ፤ ቢፍቴ ታመነᎄ ግዝየ የጠቀለ ኧሗ ኧተርፍነᎄ ከነ ቲናዬ ቀረበም። <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />ምሳሪ ይቸለፉ፤ ከነሚ ቀረበም፤ ስለኸነም በጨለማ ይሸከቲ ሜና ንግፍርነ፤ የብራን የአርብ መሣሪያ ንልበስነ። <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />በክናን ንዥባበርነኸም ባግባበሑ ንዥባበርነ። በደርስ በወስክርም ኤይሕን፤ በዝሙት በወማግጥም ኤይሕን፤ በኦገት በቅናትም ኤይሕን። <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />ስለኸነም ጔታ ኢየሱስ ክርስቶስ ልበሶይ<note caller="+" style="f"><char style="fr" closed="false">13፥14 </char><char style="ft" closed="false">ልበሶይ ወበር ያርብ መሳሪያኸም ገለዶይ ወበሩ። </char></note> አንኸንም የፎላሑ ኤላት የዋርካ አታስቦ።<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s1">በሰብ ᎈር አለወፍርድ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />በግብታሑ በእምነተሑ የቌጠዪ ተቀበሮይ አንከንም ባሳበሑ ኦገት አትንሶ። <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />ምሳሌ አት ሰብ ሟንም ቃር የወብራ እምነት ይነቡር፤ በእምነተሑ ያንጠናዪ ሰብም አታሕልት ጠለለ ይበራ፤ <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />ስለኸነም ሟንም ቃር ይበራ ሰብ ኤበራዪ ኤጉርጭ፤ ኤይበራሚ ቢበራዪ ሰብ ኤፍረድ፤ የሑቲም እዝጌር ተቌᎄረንም። <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />ኧጌሽ፥ ብንጐድ አገልጋይ ትፈርድ አኸ ሟንከ? ሑቲ ቢቈም ወይ ቢወጥቅ የጔታውታው። ስለኸነም እዝጌር ያቈᎂ ይችል ስለኸነም ጠናም ይቈም።<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />ዛምኸም አቲ ከነ ትንጐዲ ከነ ይበዛ ባረም ዬስብ ይነብር ይኸን፤ ኧንጐዲም ከነ እንም ቂጦ ክብር ነነኖ አንከንም በከነ ግብት የትላኘ ኤነ ባረም ዬስብ። ኧጌሽ ዚ ቢመስሪ ቃር እያታቲ ተሒነሑ ያመነወዪ የሰክት። <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />አቲ ከነ ትንጐዲ ከነ አበዛም ያከብር ቢነብር ዚ ወሰክተሑ የጔታ ክብር ባረሙ፤ ሟንመሑ ስንቅ ይበራ የጔታ ክብር ባረም ይበራ፤ ቢᎄራኒም ስንቅ የእዝጌር ያምሰግን፤ ሟንመሑ ስንቅ ኤይበራ የጔታ ክብር ባረም ኤበራ፤ ባለወብራሑ የእዝጌር ያምሰግን።<note caller="-" style="x"><char style="xo" closed="false">14፥6 </char><char style="xt" closed="false"><ref loc="COL 2:16">ቆላ. 2፥16</ref>። </char></note> <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />ቲና እያታተሑ ወንብረውታም ኸነ ሞተሑ የነብሰሑ አንከነ። <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />ብንነብርነም የጔታ ኧነብርነ፤ ብንᎀትነም የጔታ ኧᎀትነ፤ ስለኸነም ብንነብርነም ብንᎀትነም የጔታንነ። <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />ስለኸነም ክርስቶስ ᎀተም ተሞት የትነሣዪ የሕያዋን የሟቾቺም ጔታ የወሕኑ። <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />ኧጌሽ፥ አኸ በጐቤያኸ ᎈር የመአር ትፈርድ? የጐቤያኸሽ የመአር ትጐርጭ? እንመና በእዝጌር የፍርድ ወንበር ኢፍት ኧቈምነ።<note caller="-" style="x"><char style="xo" closed="false">14፥10 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2 ቆሮ. 5፥10</ref>። </char></note> <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />መሳሑም፦</para>
  <para style="q1" vid="ROM 14:11">“እያ ሕያውንኩ ይብር እዝጌር፤</para>
  <para style="q2" vid="ROM 14:11">ሰብ እንም በመሌየሑ ቢያ ኢፍት ይንብረከክ፤</para>
  <para style="q2" vid="ROM 14:11">ባለመተሑም እያ እዝጌር ወሕነኛ ይምሰክር” ቧሪም ጣᎉም።<note caller="-" style="x"><char style="xo" closed="false">14፥11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">ኢሳ. 45፥23</ref>። </char></note><verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />ስለኸነም አትባተና የፎለና ሜና በእዝጌር ኢፍት ቀረብነም መልስ ኢብነ።<verse eid="ROM 14:12" /></para>
  <para style="s1">የሰብ ቈፋ ተወሕን ወትቀየ</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />ስለኸነም አተና ባተና ᎈር አንፍርድነ፤ ቢኸንም ሟንም ሰብ በጐቤች ኤማ ቈፋ ያለዋውና የትቀየ። <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />አት ቃር ሩክሱ ባረም ዬስብ ሰብ ዛ ዘንጋ የሑቲ ሩክስ ይኸንወ አንኸንም ሟንም ቃር በነብሰሑ ሩክስ ያንከነኸም እያ በጔታ ኢየሱስ ሐርኩም አርጋግጥ። <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />አኸ ብትᎄራን ስንቅ መሳ የጐቤያኸ ቈፋ በኸንከ በፍቅር ትነብር አንከንከ፤ ስለኸነም ክርስቶስ የᎀተነዪ ሰብ ብትᎄራኒ ስንቅ መሳ ይጠፋኸም አትሰክት። <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />ኧጌሽ ባሑዬ ፈያ የኸነዪ ቃር ይገርጦይኸም አትሰክቶ። <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />የእዝጌር መግስት በመንፈስ ቅዱስ ይትረከብ ጽድቅ፥ ሰላምም ብልቃቱ አንከንም የወብራ የወስጤም ቃር አንከነ። <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />በዚ ሐለት የክርስቶስ ያግለግል የኸነ ሰብ የእዝጌር ያትብላልቅ፤ በሰቤም የትምሰገነው።<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />ስለኸነም ሰላም ይትረከብወዪ ነብስ በነብሰና ኧታነጥነᎄዪ ቃር ንትኸተልነ። <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />በስንቅ መሳ የእዝጌር ሜና አናፍርስነ። ስንቅ እንም ንጡው፤ ቢኸንም ይንጐዲ ሰብ ናጫ ይኸን ስንቅ ወብራ ወዳላው። <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />ስለኸነም የጐቤያኸ ቈፋ ያለወሕን በሠር አለወብራ፥ ደጔ አለወስጤ፥ ሟንመሑ ቈፋ ይኸን ቃር አለወሰክት ፈያው። <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />ኧጌሽ ዚ እምነታኸ ባኸም በእዝጌር ግብት የሕን፤ ሱቱ ባረም ያመነወዪ ቃር ቲሸክት ሕሊናሑ ኤወቁሽ ሰብ የምሰገነው። <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />ቲጥራጠር ይበራ ሰብም ይሸኩቺ በእምነት ᎈር ያንከነ ስለኸነ ይᎈርጅᎄ፤ በእምነት ያንሰኰቺ ቃር እንም አጢያቱ።<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s1">የሰቦች ዋትብላልቅ ይጌባኸም</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />ኢና በእምነት የብረታነ ኸነም፥ የቌጦዪ ቅጭና ወጦር ይጌባነ አንከንም የራሰና ጠለለ አንትብላለቅነ፤ <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />እያታተና እንጐዲ ሰብ በእምነተሑ ይጥነክርኸም የሑቲ ይጠቅᎁ ያትብላልቊ ቃር ንሰክትነ። <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />ክርስቶስ የፎለሑ አናትብላለቀ፤ የባሰም “ሰቦች ያኸ የሰደቦᎄ ስድብ ቢያ ᎈር ወረደ” ይብሪ የቅዱሳት መጽሐፍት ቃል ሰላወ።<note caller="-" style="x"><char style="xo" closed="false">15፥3 </char><char style="xt" closed="false"><ref loc="PSA 69:9">መዝ. 69፥9</ref>። </char></note> <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />በቅዱሳት መጻሕፍት ብንረሕብነዪ ትዕግሥት ወጥናናም ተስፋ ይነብርነዬ በደሮም የጣፎዪ እንም ትምርት ይኸኖኸም ተጣፎም። <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />የትዕግሥት የወጥናናም አምላክ ነብስ በነብሳሑ የኢየሱስ ክርስቶስ ምሳሌ በወትኸተል ቁናዬ የወንብር አትነት ያብኩ። <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />ዛምኸም የጔታና የኢየሱስ ክርስቶስ አባ እዝጌር በቁና ሒን በቁና ቃልም ታከብሮይኸም የሰክትንኩ።<verse eid="ROM 15:6" /></para>
  <para style="s1">የወንጌል ቃል የአሕዛብ የሰበከኸም</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />ክርስቶስ የእዝጌር ክብር ያሑ የቌበረናሑኸም አሑ እንማሑ አቲ ይንጐዲ በብልቃት የቀᎄር። <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />ዚም ትንዝነግ እዝጌር የድረ ያቦቸና ያᎄን ተስፋ ይፌጠምኸም የእዝጌርም ያቀተኝነት ይሑሪኸም ክርስቶስ የአይሑድ አገልጋይ ኸነ ወበረኛው። <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />ዛምኸም አሕዛብ የእዝጌር በምረተሑ ያምሰገኖኸሙ፤ እኪ ቧሪም ተጣፈ፤</para>
  <para style="q1" vid="ROM 15:9">“ስለኸነም በአሕዛብ ግብት አምሰግንከ፤</para>
  <para style="q2" vid="ROM 15:9">የሽማኸም ኧዜምር።”</para>
  <para style="m" vid="ROM 15:9">ቧሪም የጣፈኸሙ።<note caller="-" style="x"><char style="xo" closed="false">15፥9 </char><char style="xt" closed="false"><ref loc="2SA 22:50">2 ሳሙ. 22፥50</ref>፤ <ref loc="PSA 18:49">መዝ. 18፥49</ref>። </char></note> <verse eid="ROM 15:9" /><verse number="10" style="v" sid="ROM 15:10" />ኧሗም፥</para>
  <para style="q1" vid="ROM 15:10">“አሑ አሕዛብ፥</para>
  <para style="q2" vid="ROM 15:10">ተእዝጌር ሕዝብጌ ተብላለቆ!” ቧሪም ተጣፈም።<note caller="-" style="x"><char style="xo" closed="false">15፥10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ዘዳ. 32፥43</ref>። </char></note><verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />ዠበረም፦</para>
  <para style="q1" vid="ROM 15:11">“አሕዛብ እንም! የጔታ አመስግኖይ፤</para>
  <para style="q2" vid="ROM 15:11">ሕዝብ እንም የሑቲ አመስግኖይ!” ቧሪም ተጣፈም።<note caller="-" style="x"><char style="xo" closed="false">15፥11 </char><char style="xt" closed="false"><ref loc="PSA 117:1">መዝ. 117፥1</ref>። </char></note><verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />ዛምኸም ኢሳያስ፦</para>
  <para style="q1" vid="ROM 15:12">“ተእሴይ ዝሬት ይጨኝ ይቸኝ፤</para>
  <para style="q2" vid="ROM 15:12">የአሕዛብም መሪ የወሕን ይትነሣ፤</para>
  <para style="q2" vid="ROM 15:12">ሕኖም ተስፋሕኖ በሑቲ ᎈር ተስፋ ይሸክቶ” ይብር።<note caller="-" style="x"><char style="xo" closed="false">15፥12 </char><char style="xt" closed="false"><ref loc="ISA 11:10">ኢሳ. 11፥10</ref>። </char></note><verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />ተስፋሑ በመንፈስ ቅዱስ ቆት ቲለቅ ያርኸም የተስፋ አምላክ በሑቲ በወታመናሑ ብልቃት ሰላምም በሙላ ያብኩ።<verse eid="ROM 15:13" /></para>
  <para style="s1">ጳውሎስ የአሕዛብ አገልጋይ ወሕነሑ</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />ጐባቢተኛ! በፈይነት የትመላሑ፥ በውቀት ደንገኘ የኸንኩ አትባታሑም ይንጐዲ የወምክር ትችሎ ወሕናሑ ተሬዳሑም። <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />አታት ቃር አስታውስኩዬ ሸሑም ዚ መልክት እዝጌር ባቤ ጸጋ መሠረት በድፍረት ጣፈክንኩ። <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />ዚም ጸጋ ያቡኝ የእዝጌር የምሥራች ቃል የአሕዛብ በዋውድ የካሕንኸም ኸንኩም የኢየሱስ ክርስቶስ የዋግልግሉ፤ ስለኸነም አሕዛብ በመንፈስ ቅዱስ የቄደሰ የእዝጌር ያትብላልቅ መሥዋዕትም ኸኖም ይቀርቦኸም አግለግል። <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />ስለኸነም የእዝጌር በዋገልግለኛ በኢየሱስ ክርስቶስ ኧትነድ። <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />አሕዛብ የእዝጌር ይታዘዞኸም፤ ክርስቶስ ቢያ ኸነም በፌጠᎀን አንከንም እንጐድ ቃር የወዘንግ አንደፍር። <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />ዛምኸም በግድድር ታምራት በድንቅ ሜናዎችም፥ በመንፈስ ቅዱስም ቆት ተኢየሩሳሌም ተጭጭሳዪም ቀረሰም እልዋሪቆን ስን የክርስቶስ ወንጌል ሰበኩም።<verse eid="ROM 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 15:20" />ይንጌ ኤላተኛም እንጐዲ ሰብ ባደጐን መሠረት ᎈር ወገንባ ቴይኸን የክርስቶስ ሽም ባንትሰማወ መደር እንም ፈያዪ ዜና ዋብሥሩ። <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />ዚም፦</para>
  <para style="q1" vid="ROM 15:21">“ተዚ ኢፍቴ ስለሑቲ አትም ያኔወጅዮ ሰቦች ያዞ፤</para>
  <para style="q2" vid="ROM 15:21">ስለሑቲ ያንሰሞዪም ያጥራምቶ”</para>
  <para style="m" vid="ROM 15:21">ቧሪም የጣᎉኸሙ።<note caller="-" style="x"><char style="xo" closed="false">15፥21 </char><char style="xt" closed="false"><ref loc="ISA 52:15">ኢሳ. 52፥15</ref>። </char></note><verse eid="ROM 15:21" /></para>
  <para style="s1">ጳውሎስ ተሮሜ የወወር ዬቀደኸም</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />ኧሗ ስን ታሑዬ የወተኝ ያንትመቼ ስለኸነ በደርኩም በዝነጔሑኒ መሳው።<note caller="-" style="x"><char style="xo" closed="false">15፥22 </char><char style="xt" closed="false"><ref loc="ROM 1:13">ሮም 1፥13</ref>። </char></note> <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />ኧሗም በዚ ጭጭሳ ባኖዪ ገኝ የወንጌል ሜና ኧሸክትቦ መደር ዬኖ ስለኸነ፥ ዛምኸም ተብዠ ዓመቶች ቀረስኩም ያሑ የወጎብኝ ከፍ የባረ ኤላት ስላኔ <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />ተእስፔኔ ብናርወ ግዝየ ትንቸለፍ ኧትራከብሑዬ ዔቀድኩም። የቀል ግዝየ ታሑጌ ተብላለቅኩም ቤከስኩ አንቌ ጋዠኛ የወቀጥል ያቸሌዪ እርዳታ ትሸክቶኒኸም ተስፋ ኧሸክት። <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />ኧሗም የእዝጌር ጐሣዎች ይᎅ የዋጋ እርዳታ ጠበጥኩም ተኢየሩሳሌሜ አር። <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />ዚምም የመቄዶንያ በአካይያም ይትረከቦ የእዝጌር ጐሣዎች በኢየሩሳሌም ያኖዪ ዜጋ የዋጋ እርዳታ የወላሕ በፈአደሕኖ የዌሰኖ ስለኸነው።<note caller="-" style="x"><char style="xo" closed="false">15፥25-26 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1 ቆሮ. 16፥1-4</ref>። </char></note> <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />ዚም እርዳታ በፈአደኝነት ያቦ ግዴታሕኖ ስለኸነው፤ አሕዛብ ተአይሑድጌ የመንፈስ በረከት ይሰዶ በኸኖ ሕኖም በነብሰሕኖ በረከት የአይሑድ የወርዳ ግድ ነነቦ።<note caller="-" style="x"><char style="xo" closed="false">15፥27 </char><char style="xt" closed="false"><ref loc="1CO 9:11">1 ቆሮ. 9፥11</ref>። </char></note> <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />ስለኸነም ዚም የስᎄሰᎅዪ የዋጋ እርዳታ ተኢየሩሳሌሜ ወሰድኩም የዋብ ሜናኛ በፈጀሑ አንቌ ባሑ ኤማ ሸከትኩም ተእስፔኔ አር። <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />ታሑዬ ብንቸኝወ ግዝየም የክርስቶስ በረከት ኧጠብጥንኩም ኧቸኝኸም ኧሒር።<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />ጐባቢተኛ! ስለእያ ተእዝጌሬ በወጠልይ በግጅላኛ ታግዞኝኸም በጔታና በኢየሱስ ክርስቶስ በመንፈስ ቅዱስ ፍቅር ኧጮቅስኩ። <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />ትጤልዮኒም በይሑዳ ገኝ ባኖዪ ቴያምኖ ሰቦች ኧጅ ኧተርፍኸም በኢየሩሳሌም ያኔ አገልግሎትም በእዝጌር ባመኖዪ አማኞች ተቀባይነት ይነቡርኸሙ። <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />ዚም በኸነ አንቌ የእዝጌር ፈአድ ቢኸን በብልቃት ታሑዬ ቸኘሑም ታሑጌ ዋᎉ ኧወድ። <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />የሰላም አምላክ ትንማሑጌ የሕን! አሜን።<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s1">ሰላምታ</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />ፌቤ በክንክራኦስ ከተማ የቤተ ክርስቲያን ታግለግል<note caller="+" style="f"><char style="fr" closed="false">16፥1 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ዳቆን</char></note> ታማኝ ኧተመና ወሕኔታን ቲሒሮኸም ኧወድ። <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />ሒቲ እያም እንጐድመሕኖ ብዠ ሰቦች ያድገለለች ስለኸነች የምእመናንም ባዘና ወቀበር ይጌባኖኸማት በጔታ ሽም ተቌበርኩም ያሸና ቃር እንም ታድገልሎያኸም ዐደራ ኧብርሑ።<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />በኢየሱስ ክርስቶስ ሜና ያግዞኜ የኸኖዪ የጵርስቅላ<note caller="+" style="f"><char style="fr" closed="false">16፥3 </char><char style="ft" closed="false">በግሪኪ </char><char style="fqa" closed="false">ጰርስቃ የጵርስቅላ </char><char style="ft" closed="false">የሸጐሪ ሽሙ። </char></note> የአቂላም ሰላምታ አቅርቦኒ፤<note caller="-" style="x"><char style="xo" closed="false">16፥3 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሐዋ. 18፥2</ref>። </char></note> <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />ሕኖ ብያ ሟኔ የወሙት የዝጋዶ ባኖ፤ በዚም እንጌ አምሰግኖ፤ እያ ጠለለ ታንኸን ተአሕዛብነት ተክርስትናዬ የዠበሮ ምእመናን አብያተ ክርስቲያን እንም ያምሰግኖዮ። <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />በሕኖ ቤት የጠሎት ይስበሰቦዪ ምእመናንም ሰላምታ አቅርቦኒ።</para>
  <para style="p" vid="ROM 16:5">በእስያ ክፍለ ገኝ በደረም በክርስቶስ ያመነዪም ኧወጅጂ የኤጴኔጦስ ሰላምታ አቅርቦኒ። <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />ያሑ ብዠ የቌጠች የማርያም ሰላምታ አቅርቦኒ። <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />ቲያጌ አጐጅዮም የነበሮዪ በሐዋርያትም ግብት ይትኴሮ የነበሮዪ የአይሑድ ዘመዶቸኛ፥ የአንድሮኒቆስም የዩኒያስ<note caller="+" style="f"><char style="fr" closed="false">16፥7 </char><char style="fqa" closed="false">ዩኒያስ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “ዩሊያ” ይብሮ። </char></note> ሰላምታ አቅርቦኒ፤ ሕኖ የክርስቶስ በወምን ይያ ይበድሮኝ።<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />በጔታ ኧወጅጂ የአጵልያቶስ ሰላምታ አቅርቦኒ፤ <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />በክርስቶስ ሜና ያግዝነ የኸነዪ የዑርባኖስ ኧወጅጂም የእስጣኩስም ሰላምታ አቅርቦኒ። <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />በክርስቶስ ወሕነሑ ተፌተነም የትምሰኰረነ የአጴሊስ ሰላምታ አቅርቦኒ፤ አርስጦቡሎስ አበሮስ የኸኖዪም ሰላምታ አቅርቦኒ፤ <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />የአይሑዳዊዪ ዘመደኛ የሔሮድዮን ሰላምታ አቅርቦኒ፤ የናርሲሰስ አበሮስ በጔታ ያመኖዪ ሰላምታ አቅርቦኒ።<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />በጔታ አገልግሎት ይቌጦዪ የትሩፋይና የትሩፎሳም ሰላምታ አቅርቦኒ። በጔታ አገልግሎት ስርም የቌጠቺ በክርስቶስ ኧወድዳዪ ፔርሲስ ሰላምታ አቅርቦኒ። <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />ጔታ በዋገልግል በወሕን ስርም የትኴረዪ የሩፎስ ሰላምታ አቅርቦኒ፤ ይያ የተኸዬታኸም ትወዴ የነበረቺ የዳኴችም ሰላምታ አቅርቦኒ።<note caller="-" style="x"><char style="xo" closed="false">16፥13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">ማር. 15፥21</ref>። </char></note> <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />የአስንክሪቶስ የፍሌጎንም፥ የሔርሜስም፥ የፓትሮባስም፥ የሔርማስም፥ ተሕኖምጌ ያኖዪ ጐባቢት ሰላምታ አቅርቦኒ። <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />የፊሎሎጎስ፥ የዩልያ፥ የኔርያ የተᎀችም ሰላምታ አቅርቦኒ፤ ዛምኸም የኦሉምፓስ ተሕኖምጌ ታኖ ምእመናን እንም ሰላምታ አቅርቦኒ። <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />የተም ተጐቤኸም በቄደሰ ወሰሰም ሰላም ተበበሮ። የክርስቶስ አብያተ ክርስቲያናት እንም ሰላምታ ያቀርቦንኩ።<verse eid="ROM 16:16" /></para>
  <para style="s1">የመጨረሻ ምክር</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />ጐባቢት! የቌበርኩዪ ትምርት ተቃዋሚ በወሕን በግብታሑ ወልያይ ምካት ቲያቸኖ ሰቦች ተቀሮ፤ ተሕኖም ራቆ! <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />ነዚኸማቲ ሰቦች የፎለሕኖ አንከንም የጔታና የክርስቶስ ኤያግለግሎ በልሰለሰ በቁልምጫም ቃላት የሜና ሰቦች ሒን ያብላልጦ።<verse eid="ROM 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 16:19" />የወንጌል ቃል ታዛዥ ወሕናሑ በሰብ እንም የትኴረ ስለኸነ ተብላለቆ የባሬ ቢኸንም፥ የፈያ ቃር ብላተኘ የቡሼ ቃርም ሜና ትኸኖኸም ኧሸ። <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />ዚ ብትሸክቶ የሰላም አምላክ አቴከለም የሼይጣን በእግራሑ ተት ይቅጠቅጥንኩ።</para>
  <para style="p" vid="ROM 16:20">የጔታና የኢየሱስ ክርስቶስ ጸጋ ታሑጌ የሕን።<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />በሜና ያግዜዬ ጢሞቴዎስ ሰላምታ ያቀርብንኩ፤ ዛምኸም አይሑድ ዘመዶቸኛ የኸኖዪ ሉቂዮስ ኢያሶንም ሶሲጳጥሮስም ሰላምታ ያቀርቦንኩ።<note caller="-" style="x"><char style="xo" closed="false">16፥21 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16፥1</ref>። </char></note><verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />ዚም መልክት የጣፍኩ እያም ጠርጥዮስ በጔታ ሰላምታ አቀርብንኩ።<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />እያም በዚ ያነዪ እንም ቤተ ክርስቲያን ያስትናግዲ ጋይዮስ ሰላምታ ያቀርብንኩ፤ የከተማዪ ግምጃ ቤት የኸነዪ ኤራስጦስ፥ ጐቤናም ቋርጦስ ሰላምታ ያቀርቦኑኩ።<note caller="-" style="x"><char style="xo" closed="false">16፥23 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሐዋ. 19፥29</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1፥14</ref>፤ <ref loc="2TI 4:20">2 ጢሞ. 4፥20</ref>። </char></note> [<verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />የጔታና የኢየሱስ ክርስቶስ ጸጋ ትንማሑጌ የሕን! አሜን።]<note caller="+" style="f"><char style="fr" closed="false">16፥24 </char><char style="ft" closed="false">አታት የድረ መጽሐፍቶች ዚ ቁጥር ይደብሮ። </char></note><verse eid="ROM 16:24" /></para>
  <para style="s1">የምስጋና ጠሎት</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />እያ ብናᎄሥሪ የምሥራች ቃል ስለኢየሱስ ክርስቶስ ቢችላለፊ መልክትም ተድረ ዘበን ቀረሰም ተሼመም ቤከሰዪ፥ ኧሗም በትገለጠዪ የኢኒ ምሥጢር መሳ ሑቲ በእምነታሑ ትቈሞኸም ይሸክትንኩዬ ይችል። <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />ኧሗ ዚ ሐቅ ተገለጠም፤ በዘላለማዊዩ አምላክ ትዛዝ እንም አመኖም ይታዘዞኸም በነብዮች መጽሐፍ መሳ ሕዝብ እንም ይሒሮይኸም ሸኰቺም።<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />ሑቲ ጠለለ ብላት ያነን የቁና አምላክ፥ በኢየሱስ ክርስቶስ የዘለዓለም ምስጋና የሕን! አሜን።<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>