<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">Mesqan New Testament JAMES</book>
  <para style="h">የያዕቆብ መልክት</para>
  <para style="toc1">የያዕቆብ መልክት</para>
  <para style="toc2">የያዕቆብ መልክት</para>
  <para style="toc3">ያዕ.</para>
  <para style="mt">የያዕቆብ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ዚ የያቆብ መልክት የከነዪ ኑሮ መመሪያ ይኸኖ አሳቦች የጠበጠ ቲኸን የጣፈዪም በዓለም እንም የትቤተኖ ዐሥረ ዄት ነገዱ፤ ጠሐፊዪ ብላት በሜና አወልነᎄ ስለኸነ ብላት፥ የክርስቲያናዊዪ ይቌᎄሪዪም አመል መመሪያ ይኸኖ ዘንጋ ቢልቢጢጦ በኸኖ ሥዕላዊዪ ንግግሮች ያቀርብ፤ ስለዜግነት ስለዱሬሽነትም፥ ስለፈተና፥ ስለፈያ አመል ስለቅናት፥ ስለእምነትም ፈያ አመል ስለአለመት ይጠቅሚ ጎጂነትም፥ ስለብላት፥ ነብስ በነብስ ስለወትናከስ፥ ስለትዕቢት ስለቁናቀልብነትም፥ ብንጐዲ ᎈር ስለወፍርድ፥ ስለወትነነድ ስለትዕግሥት ስለጠሎት፥ ክርስቲያን ይሸክቶዬ ይጌባኖ ስለኸነ ግዴታ በዋፍታታ ጣፈም።</para>
  <para style="ip">መልክተሑ በክርስትና ሕይወት እምነት በሜና ይትረጐምወ ስለኸነ ሐለት ቢልቢጢጦ ያቴዥ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="JAS 1:1">1፥1</ref> </char></para>
  <para style="io1">እምነት ብላትም <char style="ior"><ref loc="JAS 1:2-8">1፥2-8</ref> </char></para>
  <para style="io1">ዜግነት ዱሬሽነትም <char style="ior"><ref loc="JAS 1:9-11">1፥9-11</ref> </char></para>
  <para style="io1">ፈተና <char style="ior"><ref loc="JAS 1:12-18">1፥12-18</ref> </char></para>
  <para style="io1">የእዝጌር ቃል ወስማ ወሰክትም <char style="ior"><ref loc="JAS 1:19-27">1፥19-27</ref> </char></para>
  <para style="io1">ዋዳላ ኤይሸከትኸም የቴበ ወትቀየ<char style="ior"><ref loc="JAS 2:1-13">2፥1-13</ref> </char></para>
  <para style="io1">እምነት ሜናም <char style="ior"><ref loc="JAS 2:14-26">2፥14-26</ref> </char></para>
  <para style="io1">ክርስቲያን አለመተሑም <char style="ior"><ref loc="JAS 3:1-18">3፥1-18</ref> </char></para>
  <para style="io1">ክርስቲያን ዚም ዓለም <char style="ior"><ref loc="JAS 4:1-5:6">4፥1—5፥6</ref> </char></para>
  <para style="io1">ስለትልያዮ ዘንጋዎች የቴበ ምክር <char style="ior"><ref loc="JAS 5:7-20">5፥7-20</ref> </char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />በዓለም እንም የትቤተኖ የዐሥረ ዄቲ ነገድ የእዝጌር የጔታ የኢየሱስ ክርስቶስም አገልጋይ በኸነዪ በያዕቆብ የትላኸ መልክት፦<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቴ. 13፥55</ref>፤ <ref loc="MRK 6:3">ማር. 6፥3</ref>፤ <ref loc="ACT 15:13">ሐዋ. 15፥13</ref>፤ <ref loc="GAL 1:19">ገላ. 1፥19</ref>። </char></note></para>
  <para style="p" vid="JAS 1:1">ሰላም ያሑ የሕን።<verse eid="JAS 1:1" /></para>
  <para style="s1">መከራ ፈተናም</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />ጐባቢተኛ! የትልያየ ፈተና ቲሰላብኩ ያትብላልቅ ቃር የረከብኩኸም ሰክቶም ቆጥሮ። <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />የእምነታሑ ወትፈተን ትዕግሥት ያትሬክብንኩ ወሕነሑ ቲሒሮ። <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />በትዕግሥት ወጥናሑ አትም ቴይቀብልብኩ ፍጡም ሙላም ትኸኖኸም ያበቃሑ የሕን። <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />ባሑ ግብት ብላት የቀᎄለን ሰብ ቢነብር የእዝጌር የጮቅስ፤ እዝጌርም ይቡ፤ ሑቲ አትም ቴያᎀጭጭ ይንም በወለግስ ይብ ሜና አምላኩ። <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />ቢኸንም ሰብ አትም ቴይጥራጠር በእምነት የጮቅስ፤ ይጥራጠር ሰብ ብንፋስ የትገፋ የትናወጠም የባር ማዕበል ይመስር። <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />የዚኸማቲ ሰብ ተጔታ አትም ቃር ይረሕብ ኤሙስር። <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />ዚም ይኸን ዄት አሳብ ስላነን ቤማሑም ይውላውል ስለኸነው።<verse eid="JAS 1:8" /></para>
  <para style="s1">የዜጋ የዱሬሻ ሰብም ብልቃት</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />በኑሮሑ ያንስ ጐቤ እዝጌር ከፍ ያᎄኘን ስለኸነ የትብላለቅ። <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />የሰብ ዱኒያ የሠር አበባኸም ይረግፍ ስለኸነ በኑሮሑ ከፍ የባረ ጐቤ እዝጌር በኑሮሑ ያነሰ ቢሸኩችም የትብላለቅ፤ <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />ጬት ተሙቀተሑጌ ቲወጣ የሠሪ ያጠሩቁ አበባዪም ይረግፍ፤ መልከሑ ይጠፋ፤ ዛምኸም ዱሬሻ ሰብ በሜናሑ መተዮ ኸነም ይጠፋ።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40፥6-7</ref>። </char></note><verse eid="JAS 1:11" /></para>
  <para style="s1">በሰብ ᎈር ይሰላ ፈተና</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />ጔታ በቃል ጉዳሑ መሠረት በተስፋ የደቦቸሑ ያᎄኒ የሕይወት አክሊል ይቌበር ስለኸነ ፈተናዪ ፈረከም ይጠና ሰብ የትባረከው። <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />እዝጌር በቡሼ ቃር ኤይፌትን ስለኸነ ዛምኸም ሑቲ የሟንም ኤይፌትን ስለኸነ ሰብ ቢትፌተንወ ግዝየ “እዝጌር ፌተኔ” ኤይበር።<verse eid="JAS 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 1:14" />ቢኸንም እያታቲ ሰብ ይትፌተን በፎለሑ ዋላ ቲሸብም ቲትብላለጡ። <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />ዋላ በትኸለቀ አንቌ አጢያት ይጨኝ፤ አጢያትም በላቀ አንቌ ሞት ይጨኝ።<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />የትወደድኩ ጐባቢተኛ! አትብላለጦ! <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />ፈያ ስጦታ ፍጡም በረካ እንም በእዝጌሩ፤ ዚም ይቸኝ የጥሌልኸም ወዛዞር ወይ ወሽጋገር ቤነወ ተብራን አባ ተእዝጌሩ። <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />እዝጌር በደረም ተሕዝቢ እንም መጀመሪያ ኧኸነኸም በፎለሑ ፈአድ በሐቅ ቃል ጨኘነ።<verse eid="JAS 1:18" /></para>
  <para style="s1">የሰማነዪ በሜና ᎈር ዋወል</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />የትወደድኩ ጐባቢተኛ! ዚ አጥራምቶ፤ ሰብ እንም የወስማ የድገደገ፥ የወዘንግም ታንቌዬ የባረ የማት የዝገየ የሕን። <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />የሰብ ማት የእዝጌር ጽድቅ ኤያቸኝ። <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />ስለኸነም ሩክስነት ተቡሼነትም ብዛት እንም አፍኮም እዝጌር በሒናሑ ያወናኒም ነብስያሑ ዋትርፍ ይችሊ ቃል በቁናቀልብነት ተቀበሮ።<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />ቃለሑ በሜና ᎈር ታወሎ ሕኖ አንኸንም ነብሳሑ ትታብላልጦ ሰሚ ጠለል አትሕኖ። <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />ቃለሑ ሰማም በሜና ᎈር ኤያወል ሰብ ኢፍተሑ በመስተዋት ያዥ ሰብኸሙ፤ <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />ዚ ሰብ ኢፍተሑ በመስተዋት ባዠ አንቌ ያር፤ ምንኸም የኸነኸም ሒንጌም ይረሳ። <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />ቢኸንም ነጣ ያወጣዪ ፍጡም ሕጊ ምረመረም በሑቲ ይጠና፥ ሑቲም ሰማም ወርሳ ቴይኸን፥ በሜና ᎈር ያወሊ ሰብ የትባረከው።<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />አለመተሑ ቴይቁጣጠር እዝጌር አመልክ ይብር ሰብ ነብሰሑ ያብላልጥ፤ የሑቲም እምነት ኤድገልል።<verse eid="JAS 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JAS 1:27" />በእዝጌር አብ ኢፊቴ ንጡም ያረከሰ አይማኖተኛ “አብ ተዳኮም የᎀተቦ ዴንጋ፥ ዛምኸም ምሰሕነማ የᎀተበማዪ እንሽታ በምካተሕነማ ወግዝ፥ ነብስም ተዓለም ሩኩሰት ወቀየው።”<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s1">ዋዳላ ኤጌባ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />ጐባቢተኛ! በክብር ጔታ በኢየሱስ ክርስቶስ ታምኖ በኸንኩ አቲ ትንጐዲ ይበዛ በወበር በሰብ ግብት ዋዳላ ኤጌባ። <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />የወርቅ ቀለበት ያገደም ይደንቅ ልባስ የለበሰ ሰብ ብትስበሰቦᎄ መደር ቢቸኝ ዛምኸም የገረዘ ልባስ የለበሰ ዜጋ ሰብ ቢገባ፤ <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />ይደንቅ ልባስ የለበሰዪ ሰብ በዋክብር “በዚ በፈያዪ መደር ቶና” ብትብሮይ። የዜጋዪ “አኸሽ በዛዬ ቁም፤ በግረኛ ተት ቶና” ብትብሮይ፤ <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />ኧጌ፥ በዚኸማት በግብታሑ ልዩነት ትሸክቶኸም የአድሎ ፍርድም ትፈርዶኸም ኤይታዥሑ?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />የትወደድኩ ጐባቢተኛ! ስሞ፤ እዝጌር በእምነት ዱሬሻ ይኸኖኸም የሑቲ ይወዶይ ተስፋ ያበኖዪ መንግሥት ይወርሶኸም የዚ ዓለም ዜጋ አመጠረ? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />ዜጋ ትገርጦ አሑ፤ ይቤድሎኩዪም ተፍርድ ቤቴ ይሸቦኩ ዱሬሻዪ አንከኖ? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />አሑ ትጠሮᎄ ሽም ይሰድቦሽ ሕኖ አንከኖ?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />“ሰብ የፎላኸኸም ውጅጅ” ቧሪም በቅዱስ መጽሐፍ የጣፈ የእዝጌር መንግሥት ሕጊ ብትፌጥሞ ፈያ ትሸክቶ።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዘሌ. 19፥18</ref>። </char></note> <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />በሰብ ግብት ልዩነት ብትሸክቶ አጢያት ትሸክቶ፤ ሕጊ በወችላለፋሑ ትትወቀሶ።<verse eid="JAS 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 2:10" />ሰብ በትዛዞቺ አቲ አፈረሰም የቀኖዪ እንም ቢፌጥም እንም ያፈረሰኸም ይትቆጠር። <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />“አትሟግጥ” የባረዪ ጔታ ዛምኸም “አትቅጥር” ባረም፤ ስለኸነም ባትሟግጥም በቀጠርከ ሕጊ አፈረስከም።<note caller="-" style="x"><char style="xo" closed="false">2፥11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ዘፀ. 20፥13-14</ref>፤ <ref loc="DEU 5:17-18">ዘዳ. 5፥17-18</ref>። </char></note> <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />ነጣነት ቢይቢ ሕጊ ኢፍቴ ቀረቦም ይፈርዶ ሰቦችኸም ዘንጎ፤ ዛምኸም ሰክቶ። <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />የእዝጌር ፍርድ ምረት ኤሸክት ሰብ ምረተሑ ኤይብ፤ ቢኸንም ምረተሑ ተፍርድ ነኑ።<verse eid="JAS 2:13" /></para>
  <para style="s1">እምነት ተሜና</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />ጐባቢተኛ! አት ሰብ እምነት ነኔ ቢብር፥ ቢኸንም እምነተሑ በፈያ ሜና ቤይገልጥ መአር ይጠቅሙ? እምነተሑሽ ያተርᎊ ይችል? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />ይለብሶይ ይበሮይም ዬነኖ ጐባቢት ኧተሟᎁትም ቢነብሮ፥ <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ታሑ አቲ የኑሮሕኖ ያሸኖ ቃር ቴይቦ “በሰላም ወሮ! የሟቁ! ጡፎ!” ቢብኖ ምን ይጠቅሞ? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />ተፈያ ሜና የትለኘ እምነት የᎀተው።<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />ቢኸንም “አኸ እምነት ነነናኸ፤ እያም ፈያ ሜና ነኔ” ይብር አት ሰብ ቢነብር፥ “እምነታኸ ተሜናኸ ላኝም አተዤ፤ እያም በሜናኛ እምነተኛ አቴዥኸ” ይቡን። <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />አኸ “ቁና እዝጌር ነነ” ባኸም ታምን፤ ዚም ፈያው፤ ወምንማ አጋንትም ያምኖ፤ በጊናት ያትረዶ።<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />አኸ ገዋ! እምነት ፍርየ ኤባን ሜና ኤይድገልል ወሕነሑ ምስክር ትሸ?<note caller="+" style="f"><char style="fr" closed="false">2፥20 </char><char style="fqa" closed="false">ፍሬቢስ፦ </char><char style="ft" closed="false">አታት የብራና ጡሑፎች “የᎀተ” ይብሮ። </char></note> <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />አባና አብርሐም ትኸሑ ይስሐቅ ቢያርጅᎄዪ ᎈር የእዝጌር መሥዋት ሸከተም ባቀረᎄን ግዝየ የጸደቀ በሜና አንከነ?<note caller="-" style="x"><char style="xo" closed="false">2፥21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ዘፍ. 22፥1-14</ref>። </char></note> <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />ስለኸነም እምነት ተሜናጌ ቁናዬ የነበረኸም እምነትም በሜና ፍጡም የኸነኸም አታዥ? <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />በቅዱስ መጽሐፍ “አብርሐም እዝጌር አመነ፤ እምነተሑም ጽድቅ ኸነም ተቆጠረነ” የቧሪዪ ቃል ተፌጠመም፤ በዚኸማት አብርሐም የእዝጌር ደቦ ቧሪ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ዘፍ. 15፥6</ref>፤ <ref loc="2CH 20:7">2 ዜና 20፥7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41፥8</ref>። </char></note> <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />በሒሽ ሰብ ይጸድቅ በእምነት ጠለለ ቴይኸን በሜናም ወሕነሑ ታዞ።<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />ትሟግጢ ረዓብ የእስራኤል መላክተኞች በቤቴታ በቌበረትወ ግዝየ ብንጐዲም ኤማ ያሮኸም በሸከተቶ ግዝየ ሒቲሽ በሜናዬታ አንጸደቀች?<note caller="-" style="x"><char style="xo" closed="false">2፥25 </char><char style="xt" closed="false"><ref loc="JAS 2:1-21">2፥1-21</ref>። </char></note><verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />ጅስም ፍርየ ኤባን ነብስያ የᎀተው፤ ዛምኸም ተሜና የትላኘ እምነት የᎀተው።<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s1">አለመት ወቁጣጠር</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />ጐባቢተኛ! ኢና አስተማሪ የኸነ የባሰ ፍርድ ኧቌበርነኸም ቲሒሮ ታሑ ብዠሕኖ አስተማሪ ኤይሕኖ። <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />ኢና እንመና ብዠ ግዝየ ኧሰሰትነ፤ በንግግረሑ ኤይዳላ ሑቲ ነብሰሑ ወቁጣጠር ይችል ፍጡም ሰቡ። <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />ፈረዝ ይታዘዝንነኸም ባፈሑ ውስጥ ሎኮ ንኸራነ፤ በዛም ተሸነᎄ መደሬ ኧመራነይ። <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />መርከብ ስርም ወደል ቢኸንም ቆት ባነን ኧንፋስ ይገፋ፥ የመርከቢ ነጂ በቀል መቅዘፊያ ተሸን መደሬ ይሰጅጅ። <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />ዛምኸም አለመት ቀል የጅስም ክፍል ቲኸን በግድድር ቃር ይትነነድ፤ ወደል ድብር ይነድ በቀል ኧሳቱ። <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />አለመትም ይሳትኸሙ፤ አለመት በጅስም ክፍሎቸና ግብት ይትረከብ ቡሼ ዓለሙ፤ ጅስመና እንም ሩክስ ይሸክት፤ ተፍርድ ይወጣ ኧሳትኸም የኑሮና ቀስ በቀስ እንም ያነድ፤ ነብሰውታም በፍርድ ኧሳት ይነድ። <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />የድብር አውሬውዎች አንፉዎችም፥ ባፈር ይሸቦዪ በባርም ይንቅሳቀሶዪ ኸልቀቶች እንም በሰብ ያሮሺዮዬ ይችሎ፤ ኧሗም ሮሶም። <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />ቢኸንም አለመት ዋሮሽ ይችል ሟንም ኤነ፤ ይቀጥር መርዝ የᎀላወም ፎያት ዬነን ቡሼ ቃሩ። <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />በሑቲ የአባና የእዝጌር አምሰግነ፤ ዛምኸም በሑቲ በእዝጌር አምሳያ የትኸለቆዪ ሰቦች ኧሰድብነ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ዘፍ. 1፥26</ref>። </char></note> <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />በቁና አፍ ምስጋና ስድብም ይወጦ፤ ጐባቢተኛ! ዚ ይኸኔ ኤያሸ። <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />በቁና ምንጭ ይተም ይመርም<note caller="+" style="f"><char style="fr" closed="false">3፥11 </char><char style="ft" closed="false">በግሪኪ፣ </char><char style="fqa" closed="false">አሶ</char></note> ኧጋ ይፌልቅ? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />ጐባቢተኛ የበለስ ኧጨ የዌራ ፍርየ ወይን በለስ ያወርዴ ይችል? ዛምኸም ቲመር ኧጋ ይተም ኧጋ ይወጣ።<verse eid="JAS 3:12" /></para>
  <para style="s1">ዄት ብላት</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />ባሑ ግብት ብላተኘ አጥራማች ሰብ ሟኒ? በብላት በቁናቀልብነትም የፌጠᎀኒ ሜና በፈያ ኑሮሑ ያተዥ። <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />ቢኸንም ቡሼ ቅናት ነብስ ወውድድም በሒናሑ ቢነብር አትትነነዶ፤ በሐቅም ᎈር ባጢል አትዘንጎ። <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />የዚኸማቲ ብላት ይትረከብ ተዓለም፥ ተበሠር ተሼጣኑ አንኸም ተእዝጌር አንከነ። <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />ቅናት ነብስ ወውድድም ባኖᎄ መደር ሕላት ቡሼ ሜናም እንም ይነብሮ። <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />ቢኸንም በእዝጌር ይትረከቢ ብላት በደረም ንጡው፤ ቄጠለም ሰላም ይወድ፥ ፈያ፥ ይታዘዝ፥ ምረተሑ ይሸክት፥ ፈያ ፍርየ የመላወ፥ ዋዳላ ግብዝነትም ዬነወው። <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />ሰላም ይወዶ ሰቦች ሰላም ዘሮም የጽድቅ ፍርየ ያዶ።<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s1">ነብሳሑ የእዝጌር አትገዞ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />ባሑ ግብት ያነዪ አርብ መናክስም ቤቴ የቸኘው? በገጋሑ ውስጥ ቲዋጋዪ ተነብሳሑ ኤላት አንከነ? <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />ትትሜኖ፤ ቢኸንም አትረሕቦ። ትቀጥሮ፤ በዋቆመር ትትሜኖ፤ ትረሕቦዬ አትችሎ። ትትናከሶ፤ ትትዋጎ፤ አትጮቅሶ ያሑ ኤይኸን። <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />ብትጤልዮም የጠሎታሑ መልስ አትረሕቦ የጮቀስኩዪ ቃር በነብስ ብልቃት ᎈር የዋወል በቡሼ አሳብ ትጤልዮ ስለኸነው። <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />አሑ ትለጎ! ዓለም ይወድ እንም የእዝጌር መሶ ወሕነሑ አትሒሮ? ኧጌሽ ዓለም ይወድ እንም የእዝጌር መሶ ኸነም። <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />ኧሗም መጽሐፍ ቅዱስ “እዝጌር በውስጣሑ ያቴደረኒ መንፈስ የሑቲ ጠለለ ኧኸነኸም ብረታም ይትሜና” የባረ ቤድገልል ቃሩ? <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />ቢኸንም መጽሐፍ “እዝጌር የትዕቢተኞች ይቃወም፤ የቁና ቀልቢም ጸጋ ይብ” ይብር ስለኸነ እዝጌር ይᎅ ጸጋ ትንም ይበዛ።<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />ስለኸነም የእዝጌር ተገዞ፤ የዳቡሎስ ተቃወሞይ፤ ሑቲም ታሑ ይሰክ። <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />ተእዝጌሬ ቅረቦ፤ ሑቲም ታሑዬ ይቀርብ፤ አሑ አጢያተኞች! ኧጃሑ አንጦ፤ አሑ ትውላውሎ! ሒናሑ ንጡ ሰክቶ። <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />ተጨነቆ፤ ኧዝኖ፤ ብሖ፤ ደቃሑ ታልፋታዬ፥ ብልቃታሑ ታዘኔ የሰገር። <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />በጔታ ኢፍት ነብሳሑ አትዋርዶ፤ ሑቲም ከፍ ያበይሑ።<verse eid="JAS 4:10" /></para>
  <para style="s1">በሰብ ᎈር አለወፍርድ</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />ጐባቢት፥ ነብስ በነብሳሑ ኧሟተኘ አትሕኖ፤ የሰብ ዬማ በሰብ ᎈር ይፈርድ የሕጊ ዬማ፤ በሕጊም ᎈር ይፈርድ፤ በሕጊ ᎈር ብትፈርድ ሱት ፈራጅ ኸነከ አንኸንም ሕጊ ፈጣሚ አንከነ።<verse eid="JAS 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 4:12" />ሕጊ ይቢ ይፈርድም ቁና እዝጌር ጠለለው፤ ያተርፌ ያጠፋዬም ይችል ሑቲ ጠለለው፤ ኧጌ፥ በሰብ ᎈር ትፈርድ አኸ ሟንከ?<verse eid="JAS 4:12" /></para>
  <para style="s1">ስለወትነነድ ያᎅ ዋትቌየ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />አሑ “ኧኳም ነገ ተዚ ያነ ከተማዬ ወርነም በዛዬ ቁና ዓመት ኧቾናነ፤ ኔገድነም ናተርፍነ” ትብሮ ኧጌሽ ስሞ። <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />ነገ ይኸኒ አቲሒሮ፤ ሕይወታሑ መአሩ? የቁናጌ ታዠም ባንቌ ይጠፋ ጉቢላኸምንኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ምሳ. 27፥1</ref>። </char></note> <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />ይጠቅልሽ አሑ ወበር ይትጌባሑ “ጔታ ቢፈቅድ ብንነብርነም ዚ ወይ ዛ ኧሸክትነ” ው። <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />አሑም ዚ በወበር ሟኔ በትዕቢታሑ ትትነነዶ፤ ዚኸም ያነዪ ወትነነድ ቡሼው።<verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />ኧጌሽ ፈያ ቃር ወሰክት ቲሒር ኤሸክት ሰብ አለወሰክተሑ አጢያት ይኸንወ።<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s1">የቡሼ ዱሬሻ ያᎅዮ ዋትቀየ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />ኧሗም አሑ ዱሬሻ! ኔሑ ስሞ፤ መከራ ይቸኝብኩ ስለኸነው ትትብሮ ብሖ። <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />ዱኒያሑ እንም ተብላሸም። ልባሳሑም ወት ᎄናንም። <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />ወርቃሑ ብራሑም ዛገም፤ ዝገተሑም ምስክር ይኸንብኩ፤ በሰራሑም ይሳትኸም ይᎄራን፤ የመጨረሻ ዘበን ብዠ ዱኒያ ስበሰብኩም።<note caller="-" style="x"><char style="xo" closed="false">5፥3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቴ. 6፥19</ref>። </char></note> <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />አጥራምቶ አንኸንም በርሻሑ ቲያዶ ይወሎዪ ሜነተኞች ዋጋሕኖ ያንከፈልኩ ስለኸነ ዘ፥ የወቃወም ውታሕኖ ይሴማ፤ ያዶሚ ጣምባ የሰሜ ኸልቀት ጔታዬ ሰማም።<note caller="-" style="x"><char style="xo" closed="false">5፥4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">ዘዳ. 24፥14-15</ref>። </char></note> <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />በወትመች በብልቃትም በወንብር ሒናሑም ያርጂ<note caller="+" style="f"><char style="fr" closed="false">5፥5 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የድግስ</char></note> ከነ ሒናሑ አፈቀርኩም። <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />ያሑ ያንትቃወሞዪ ኮነንኩዮም፤ ቀጠርኩዮም።<verse eid="JAS 5:6" /></para>
  <para style="s1">በመከራ ውስጥ ወታገሥ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />ጐባቢት! ኧጌሽ ጔታ ይቸኝ ስን በትዕግሥት ቀሮ፤ ገበሬ አፈረሑ የመጀመሪያዪ ያንቌዪም ዝናብ ይረሕብ ስን ቲታገሥ የከበረ ዋጋ ያነኒ ያፈረሑ ፍርየ ይቂየ። <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />አሑም የዚምኸም ታገሦ፤ ጔታ ይቸኝወ ግዝየ የቀረበ ስለኸነ ሒናሑ በተስፋ አጥኖ።<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />ጐባቢት! ባሑም ᎈር ኔᎈርጅብኩ ነብስ በነብሳሑ አትጭቃጨቆ፤ ዘ ፈራጂ ይቸኝወ ግዝየ ሰላም። <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />ጐባቢት፥ በጔታ ሽም የዝነጎዪ ነብዮች መከራ በወታገሥ በወቀበር ምሳሌ ወሕነሕኖ ሐሮ። <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />ኧሗም ነዛሕኖ በትዕግሥት የጠኖዪ “የትባረኮኖ” ኧብርነዮ፤ ኢዮብ ምንኸም የታገሠኸም ሰማሑም። ጔታም በመጨረሻ የሸኰተነ ፈያ ቃር አዠሑም፤ በዚም ጔታ ይመር ሜናም ወሕነሑ ተምሌከትኩም።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮብ 1፥21-22</ref>፤ <ref loc="JOB 2:10">2፥10</ref>፤ <ref loc="PSA 103:8">መዝ. 103፥8</ref>። </char></note><verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />ጐባቢተኛ! ትንም ይበዛ በሰሜ በአፈርም ብንጐድ በሟንም ቃር አትማሎ፤ ንግግራሑ ኤክ በኸነ በሐቅ ኤክ የሕን፤ አንከነ በኸነ በሐቅ አንከነ የሕን፤ እኪ ባንከነ ይᎈርጅብኩ።<verse eid="JAS 5:12" /></para>
  <para style="s1">በእምነት የኸነ ጠሎት</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />ባሑ ግብት ምካት የሰላወ ሰብ ቢነብር የጠልይ፤ የትብላለቀም ሰብ ቢነብር የእዝጌር በዋመስግን የዘምር። <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />ባሑ ግብት የታቌ ሰብ ቢነብር የቤተ ክርስቲያን ሽማግሌዎች ተሑቲዬ የጥራ፤ ሕኖም የታቌዪ በጔታ በኢየሱስ ክርስቶስ ሽም ዘይት የቅቦም የጠልዮነ።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር. 6፥13</ref>። </char></note> <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />በእምነት የቀረበ ጠሎት የታቌዪ ያተርፉ፤ ጔታም ተባሸሑ ፈያ ይሸኩች፤ የሸኰተን አጢያት ቢነብር አፉ ይትᎄኝነ። <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />ስለኸነም ፈያ ትኸኖኸም አጢያታሑም ነብስ በነብሳሑ ተናዘዞ፤ እያታቲም ይንጐዲ የጠልይ፤ የጻድቅ ሰብ ጠሎት ብዠ ውጤት ያትሬክብ ንኢ ቆት ነነን፤ <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />ኤልያስ ይናኸም ሰብ ባነ፤ ቢኸንም ዝናብ ኤይዘንብኸም አቆመረም በጤለየ ግዝየ የሦስት ዓመት ተግብት በአፈር ᎈር አትም ዝናብ አዘነበ።<note caller="-" style="x"><char style="xo" closed="false">5፥17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ነገ. 17፥1</ref>፤ <ref loc="1KI 18:1">18፥1</ref>። </char></note> <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />ዠበረም በጤለየ ግዝየ ሰሜ ዝናብ አበ፤ አፈሪም ዠበረም ፍርየ አበ።<note caller="-" style="x"><char style="xo" closed="false">5፥18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 ነገ. 18፥42-45</ref>። </char></note><verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />ጐባቢተኛ! ታሑ አቲ የኢኒ ኤማ ቢገፍር እንጐዲ ተኢን ኤማዬ ቢዠቡር ይጠቅል። <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" />አጢያተኛዪ ተሳተወ ኤማ ይዠብር፥ ያጢያተኛዪ ነብስያ ተሞት ያተርፍኸም የብዠ አጢያተሑም አፉታ ያትሬክቡነኸም የሐር።<note caller="-" style="x"><char style="xo" closed="false">5፥20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ምሳ. 10፥12</ref>፤ <ref loc="1PE 4:8">1 ጴጥ. 4፥8</ref>። </char></note><verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>