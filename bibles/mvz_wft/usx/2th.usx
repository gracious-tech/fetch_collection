<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">Mesqan New Testament THESSALONIANS</book>
  <para style="h">2 ተተሰሎንቄ ሰቦቼ</para>
  <para style="toc1">ዄታለኘዪ የሐዋርያዪ የጳውሎስ መልክት ተተሰሎንቄ ሰቦቼ</para>
  <para style="toc2">2 ተተሰሎንቄ ሰቦቼ</para>
  <para style="toc3">2 ተሰ.</para>
  <para style="mt2">ዄታለኘዪ የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተተሰሎንቄ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ስለክርስቶስ ዠበረም ወተኝ የትነሣዪ ጥያኤ ሕላት ቲትኸለቅ በወወረሑ በተሰሎንቄ ቤተ ክርስቲያን የነበረዪ ምካት ቲይብስ ቸኘ፤ ጳውሎስ የተሰሎንቄ ሰቦች የጣᎈኒ ዄታለኘዪ መልክት “የጔታ ይቸኝወ ከነ ሰላም” ቢብሪ እምነት ᎈር ያቴዠ ባነ፤ ጳውሎስም ተክርስቶስ ወተኝ ኢፍቴ “የዐመጥ ሰብ” በቧሪዪ በክርስቶስ ተቃዋሚ መሪነት በዓለም ᎈር ቡሼነት ዐመጥ ቲደብር ያር በወበር የሕኖ እምነት የዋርም ይሞክር።</para>
  <para style="ip">ሐዋርያዪ ያነቦዪ መከራ ሥቃይም ቢበዛቦ በእምነተሕኖ ይጠኖኸም ሑቲም ኧንጐዲ የሜና ይትገገዞዪ ይሸክቶይኸም የኑሮሕኖ ያሸኖዪ የወርክብ ተጋደሎም ይሸክቶኸም ዛምኸም ፈያ ሜና ተወሰክት ኤይትኸተሮኸም አጠበቀም ይመክሮ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="2TH 1:1-2">1፥1-2</ref> </char></para>
  <para style="io1">የምስጋና ዐደራም <char style="ior"><ref loc="2TH 1:3-12">1፥3-12</ref> </char></para>
  <para style="io1">ስለክርስቶስ ዠበረም ወተኝ የቴበ ትምርት <char style="ior"><ref loc="2TH 2:1-17">2፥1-17</ref> </char></para>
  <para style="io1">ስለክርስቲያናዊ ኑሮ ምክር <char style="ior"><ref loc="2TH 3:1-15">3፥1-15</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="2TH 3:16-18">3፥16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />የእዝጌር የአባና የጔታና የኢየሱስ ክርስቶስ የኸነዪ የተሰሎንቄ ቤተ ክርስቲያን ምእመናን ተጳውሎስ፥ ተሲላስም ተጢሞቴዎስ የትላኸ መልክት፦<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሐዋ. 17፥1</ref>። </char></note><verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />ተእዝጌር አብም ተጔታ ኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<verse eid="2TH 1:2" /></para>
  <para style="s1">በክርስቶስ ዠበረም ወተኝ ይብ ፍርድ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />በጔታ ጐባቢት! ባሑ መሳ የእዝጌር እንጌ ናምሰግነ፤ ዋመስግንም ይጌባነዪው፤ አምሰግነዪም እምነታሑ የበዛ ቲለቅም አትባተሑ የነብስ በነብስ ፍቅር ቲደብር በወወረሑ። <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />ስለኸነም አትም ብዠ ምካት ሥቃይም ቢሰላብኩ አሑ ምንኸም ፈራኪዎች በእምነታሑም የጠናሑ ወሕናሑ በወዘንግ ኢና ብንጐዶቺ አብያተ ክርስቲያን ግብት ኸነም ባሑ ኧትነነድነ።<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />ዚ እንም ዘንጋ ያቴዢ የእዝጌር ፍርድ ሱት ወሕነሑም ያሑም መከራ የቌበርኩነዪ መንግሥተሑ የበቃ ይሸክት ወሕነሑ። <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />እዝጌር ቅን ፈራጅ በወሕነሑ መከራ ቢያቸኖᎄዪ ᎈር መከራ በዋተኝ ጄዛሕኖ ይከፍሎ። <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />ኧሗ መከራ ትቌበሮዪም ቲናጌ ፎያት ይብኩ። ዚም ይኸኒ ጔታ ኢየሱስ ቆት ታነኖዪ መልክተሑጌ በሰሜ ቢወርድወ ግዝየው፤ <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />በሰሜ ይገለጢ ቢንብለበሊም ኧሳቱ፤ በዛ ግዝየ የእዝጌር ኤይሒሮዪ የጔታና የኢየሱስ ወንጌል ኤይታዘዞዪም ይቀጣኖ። <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />ሕኖ በጔታ ኢፍት በቆት ክብረሑም ተላኖም በዘለዓለም ጥፋት ይቀጦ።<note caller="-" style="x"><char style="xo" closed="false">1፥9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">ኢሳ. 2፥10</ref>። </char></note> <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />ይቀጦዪም በዛ ከነ በቅዱሳኔ ይከበሬ ቢያምኖዪም እንምሜ ይዴነቄ ቢቸኝወ ግዝየው። አሑም ይና ምስክርነት ተቌበርኩም በወምናሑ ተሑቲጌ ትቆጠሮ።<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />ዚ በዋስብ ስላሑ ታናቋርጥ ኧጤልይነ አምላከና የጥሪየሑ የበቆ ይሸክትኩኸም ፈያ የወሰክት ያነናሑ ፈአድ የእምነት ሜናሑም እንም በቆተሑ ይፌጥምኩኸሙ። <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />ዛምኸም የጔታና የኢየሱስ ሽም ባሑ ይከበርኸም አሑም በአምላከና በጔታም በኢየሱስ ክርስቶስ ጸጋ መሠረት በሑቲ ትከበሮኸም ኧጤልልነ።<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s1">የዐመጥ ሰብ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />በጔታ ጐባቢት! ስለጔታ ኢየሱስ ክርስቶስ ወተኝም ኢናም ተሑቲጌ የወሕን ስለወሰብሰበና ወባጀ ኧጮቅስነኩ ዚቱ፤<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ. 4፥15-17</ref>። </char></note> <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />በትምቢት ወይ በቃል የቴወደኸም ወይ ቲና በመልክት የጣፈኸም ሰክቶም “የጔታ ከነ ሰላም” በወበር ሒንጌም አእምሮአሑ ኤይትናወጥ፤ አትትሬበሾ፤ <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />ሟንም ሰብ ባትምኸማት ኤያብላልጥሑ፤ በደረም ወልጋ ቴይቸኝ፥ የጥፋት የዝጋጀዪም የዐመጥ ሰብ የኸነዪም ቴይትገለጥ፥ ዛ ከነ ኤይቸኝ። <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />ዚ የዐመጥ ሰብ አማልክት ቧርዮም ቲትመለኮ እንም በነን የነብሰሑ ከፍ ያበይ፤ “እዝጌርንኩ” ቲብርም በእዝጌር ቤተ መቅደስ የወቶና ይደፍር።<note caller="-" style="x"><char style="xo" closed="false">2፥4 </char><char style="xt" closed="false"><ref loc="DAN 11:36">ዳን. 11፥36</ref>፤ <ref loc="EZK 28:2">ሕዝ. 28፥2</ref>። </char></note><verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />ታሑጌ ባነሑ ግዝየ ዚ ዘንጋ ኤወደኩሑም የነበረኸም አታስታውሶ? <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />በትዌሰነነ ግዝየ ይትገለጥ ስን ኧሗ ኤትገለጥኸም ይዀትር ምን የኸነኸም ቲሒሮ። <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />ምሥጢራዊዪ የዐመጥ ቆት ኧሗም በወሠክት ᎈሩ፤ ቢኸንም ኧሗ ይዀትር ነነ፤ ዚም ይኸኒ ዛ ይዀትር ዞር ይብር ስኑ። <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ተዚ አንቌ ጔታ ኢየሱስ በአፈሑ አንፏት ያጠፏኒ በግርማም ወተኘሑ ያጠፏኒ የዐመጥ ሰብ ይትገለጥ።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 11:4">ኢሳ. 11፥4</ref>። </char></note> <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />የዐመጥ ሰብ ይቸኝ ተሼይጣን ቆት አሳሳች ታምራት ምልክቶችም ያዴንቅ ቃርም በወሰክቱ፤<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">ማቴ. 24፥24</ref>። </char></note> <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />ዛምኸም ያጠፎዪ ሰቦች ያብላልጦዪ ሟንመሕኖ ቡሼ ዘንጋ በወሰክቱ። ነዚሕኖ ሰቦች ይጠፎዪም የወትርፍ ያበቃኖ የኢን ወደዶም ያንትቀበሮ ስለኸነው። <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />በዚ መሳ በባጢል ያምኖኸም እዝጌር ያሰት ቆት ይለሕቦ። <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />ዚም ይኸኒ የኢን አናምነ ባሮም በአጢአት ይትብላለቆ እንም ይትፈረድቦኸሙ።<verse eid="2TH 2:12" /></para>
  <para style="s1">የወትርፍ የትሜጠሮ ሰብ</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />በጔታ የትወደድኩ ጐባቢት! ኢናም ባሑ መሳ የእዝጌር እንጌ ምስጋናኸ ወበር ይጌባነ፤ ምስጋናኸ ኧብርነ አሑ በመንፈስ ቅዱስ በወቀደሳሑም የኢን በወምናሑ ትተርፎኸም እዝጌር በሕር ሸከተም ሜጠረናሑም። <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />እዝጌር ኢና ቤወድነኩ ወንጌል መሳ የዚ የጠራናሑ የጔታና የኢየሱስ ክርስቶስም ክብር ትሰዶኸሙ። <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />ስለኸነም በጔታ ጐባቢት፥ ጥኖም ቁሞ፤ በቃለናም ኸነ የጣፈ ደብዳቤና ቲና የችላለፈንኩዪ ትምርት<note caller="+" style="f"><char style="fr" closed="false">2፥15 </char><char style="ft" closed="false">ትምርት ወበር ወግም ሥራት ወበሩ። </char></note> ፈያኸም ጥብጦ።<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />ነብሰሑ ጔታና ኢየሱስ ክርስቶስ የወደደነም፥ በጸጋሑም የዘላለም ወጥናና፥ ፈያ ተስፋም ያበነ እዝጌር አባና <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />ፈያ የኸነዪ እንም ትሸክቶኸም ትዝነጎኸም የሒናሑ ያጥናናሑ፤ ፈያዪ ቃር እንም ትሸክቶኸም ትዝነጎኸም ያጥናናሑ።<verse eid="2TH 2:17" /></para>
  <para style="b" />
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s1">የጠሎት የቀረበ ጥያኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />በመጨረሻም በጔታ ጐባቢት! ባሑዬ የኸነኸም እንም የጔታ ቃል አቴከለም ይቤትትኸም ይከበርኸም ይና ጠልዮንነ፤ <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />ዛምኸም ቃለሑ የሰሞዪ እንም ያምኖዪ አንከኖ፤ ስለኸነም ተጠማሞችም ተቡሼ ሰብ ኧተርፍነኸም ጠልዮንነ።<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />ጔታም ታማኙ፤ ሑቲ ያብረታሑ፤ ተቡሼዪም ይቂየሑ፤፤ <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />ኤዝዝነኩዪ ኧሗም ኸነ ቲፍቴዬ ትኬምሎይኸም በጔታ ኧትማመነብኩ።<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />ጔታ ሒናሑ ተእዝጌር ፍቅሬ ተክርስቶስ ትዕግሥቴ የሙራን።<verse eid="2TH 3:5" /></para>
  <para style="s1">ሜና ያሸኸም</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />በጔታ ጐባቢት! ሜና ፈት ተኸነዪ ቲና በችላለፈንኩም ትምርት<note caller="+" style="f"><char style="fr" closed="false">3፥6 </char><char style="ft" closed="false">ትምርት ይብሪ ትርጉመሑ በ 2 ተሰ. 2፥15 ያነዪ ተመልከቶ። </char></note> መሠረት ቴነብር ክርስቲያን እንም ትለኖኸም በጔታ በኢየሱስ ክርስቶስ ሽም ኔዝዝነኩ። <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />ዪና ምሳሌነት ወትኸተል ይጌባሑኸም አሑ ነብሳሑ ቲሒሮ፤ ኢና ታሑጌ በነበርነᎄ ግዝየ ሜና ፈት አነበርነ፤ <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />የሟንም ስንቅ እክም አንበራነ፤ የጠቀለዪሽ ታሑ በሟንም ᎈር ጡዋራ አንኸነᎄኸም በወበር ምሳር ተክናንም በወቂጥ በወልፋ ኧሸክትነ ባነ። <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />ዛምኸም የሸከትኔ አሑ ይና ምሳሌነት ትትዄተሎኸም ባርነሙ አንኸንም ታሑ እርዳታ የወርክብ መብት ቴነብርነ ቀኘም አንከነ። <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />ታሑጌ ባነነ ግዝየ “ይሸክቴ ኤይሸ ኤይብራ” ይብር ደንብ አብነኩም ባነ።<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />ዚ የባርነᎄ መሳ በግብታሑ አታት ሜና የቀበጦ ያኖኸም በወስማናው፤ ነዚሕኖ ሰብ ቤያገባኖ ቃር ቲገቦ ይንጐዲ ተወረብሽ አንከንም አትም ኤሸክቶ። <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />የዚሕኖኸም ያኖ ሰብ ተርጋጎም ይሸክቶኸም ይትዳደሮᎄዪ ይረሕቦኸም በጔታ በኢየሱስ ክርስቶስ ሽም ኤዝዝነዮ፤ ኧመክርነዮ።<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />አሑም በጔታ ጐባቢተና! ቌጥነም ባሑም ፈያ ተወሰክት አትቦርሶ። <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />በዚ መልክት ያችላለፍነንኩ ምክር ኤይቌበር ሰብ ቢነብር እኪ ያነዪ ሰብ ልብ በሮይ፤ ይሟልልኸም ተሑቲጌ ሩሑቦት አትሰክቶ። <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />ቢኸንም የጐቤኸም ምክሮይ አንከንም የመሶኸም አትቁጠሮይ።<verse eid="2TH 3:15" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />የሰላም ጔታ ነብሰሑ እንጌ ብንም ቃር ሰላም ያብኩ፤ ጔታ ትንማሑጌ የሕን።<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />ዚ ሰላምታ በፎለኛ ኧጀ የጣፍኩን እያ ጳውሎስንኩ፤ ቢያ መልክት እንም ይትረከቢ ምልክት ዚቱ። ኧጠᎉም እኪቱ።<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />የጔታና የኢየሱስ ክርስቶስ ጸጋ ትንማሑጌ የሕን።<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>