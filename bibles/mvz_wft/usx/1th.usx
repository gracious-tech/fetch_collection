<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">Mesqan New Testament</book>
  <para style="h">1 ተተሰሎንቄ ሰቦቼ</para>
  <para style="toc1">የመጀመሪያዪ የሐዋርያዪ የጳውሎስ መልክት ተ ተሰሎንቄ ሰቦቼ</para>
  <para style="toc2">1 ተተሰሎንቄ ሰቦቼ</para>
  <para style="toc3">1 ተሰ.</para>
  <para style="mt2">የመጀመሪያዪ የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተተሰሎንቄ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ተሰሎንቄ የቧሪዪ ከተማ መቄዶንያ የሮም ግዛት ዋና ከተማ ባነ፤ ጳውሎስ በተሰሎንቄ ቤተ ክርስቲያን ያቈቈᎀን የፊልጵስዩስ ከተማ ገፈረም በወረ አንቌው፤ የሕን አንኸንም የአይሑድ አይማኖተኛ ይቌበሮዬ ቢቀርᎅ የነበሮዪ አሕዛብ ጳውሎስ ቢያቀርᎅ የክርስትና መልክት የወቀበር ሸዎም የነበረ ስለኸነ አይሑድ ቀኖም በጳውሎስ ᎈር ተቃውሞ ነሦም ባነ፤ ስለኸነም ጳውሎስ ተሰሎንቄ ገፈረም ተቤርያዬ የወወር ግድ ኸነወ፤ ድግ ባረም ተቆሮንቶሴ የሰላኸም የቁርብ ኧጉዠኘ የነበረዪ ጢሞቴዎስ ተተሰሎንቄዬ ወረም የዠበረኸም በቤተ ክርስቲያን ስላነዪ ሐለት በዋፍታታ አትሬዳን።</para>
  <para style="ip">ጳውሎስ የመጀመሪያዪ መልክት የተሰሎንቄ ሰቦች የጣᎈን የክርስቲያን የዋብርታታ የዋጥናናም ባነ፤ ስለእምነተሕኖ ስለፍቅረሕኖም ፈያ ኦጀ በወስማሑ የእዝጌር ያምሰግን፤ ጳውሎስም በግብተሕኖ በትረከበወ ግዝየ ምንኸም ይነብሮኸም ያስታውሶ፤ ተዛም የክርስቶስ ዳግም ምጥአት አትምሌከተም ስለነሦዪ ጥያኤ መልስ ይብ፤ ተዚሕኖም ጥያኤ ቀሎቺ፦</para>
  <para style="ip">“ክርስቶስ ተወዘበረሑ ኢፍት የᎀተ አማኝ የክርስቶስ ወዘበር ቢያትሬክᎅ የዘለዓለም ሕይወት ይሰድ ይኸን? ክርስቶስ ተዠበረም ይቸኝ መቸው?” ይብሮዪኖ፤ ጳውሎስም ዚ አጋጣሚ በወጠቀም “የክርስቶስ ዳግም ምጽአት ትምርት በተስፋ ትቅሮኸም ዛ ስን ጭጭ ባሑም ሜናሑ ሰክቶ” በወበር ይመክሮ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="1TH 1:1">1፥1</ref></char></para>
  <para style="io1">የጳውሎስ ብልቃት ምስጋናሑም <char style="ior"><ref loc="1TH 1:2-3:13">1፥2—3፥13</ref> </char></para>
  <para style="io1">የክርስቲያን ሕይወት መመሪያ <char style="ior"><ref loc="1TH 4:1-12">4፥1-12</ref> </char></para>
  <para style="io1">ስለክርስቶስ ዠበረም ወተኝ ትምርት <char style="ior"><ref loc="1TH 4:13-5:11">4፥13—5፥11</ref> </char></para>
  <para style="io1">የመጨረሻ ምክር <char style="ior"><ref loc="1TH 5:12-22">5፥12-22</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="1TH 5:23-28">5፥23-28</ref> </char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />የእዝጌር አብ የጔታ ኢየሱስ ክርስቶስም የኸኖ ሰቦች የተሰሎንቄ ቤተ ክርስቲያን ምእመናን፥ ተጳውሎስ፥ ተሲላስ ተጢሞቴዎስም የትላከ መልክቱ፤ ጸጋ ሰላምም ያሑ የሕን።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሐዋ. 17፥1</ref>። </char></note><verse eid="1TH 1:1" /></para>
  <para style="s1">የተሰሎንቄ ሰቦች ሕይወት እምነትም</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />ኢና እንጌ አሑ በጠሎተና ትኔስብነ የእዝጌር አምሰግነ። <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />በአባና በአምላከናም ኢፍቴ ይሸክቲ እምነታሑ፥ በፍቅር ትሸክቶይሚ በጔታና በኢየሱስ ክርስቶስ ያነናሑ ተስፋ ፈረኩም በወቀያሑ ታናቋርጥነ አስታውስነ። <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />በእዝጌር የትወደድኩ ጐባቢት፥ እዝጌር የሜጠረናሑኸም ኧሒርነ። <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />ወንጌለና ያቤሠርነንኩ በቃል ጠለለ ቴይኸን በሓይል በመንፈስ ቅዱስ፥ ስለወንጌል ሐቅ የኢነተኘ በወሕኑ፤ ታሑጌ ባነነ ግዝየ ያሑ ትንብርነ ምንኸም የነበርነኸም ቲሒሮ። <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />ብዠ መከራ ቢሰላብኩም በመንፈስ ቅዱስ በትረከበ ብልቃት መሳ ቃለሑ ተቌበርኩም ይናም የጔታ የኢየሱስ ምሳሌ ትትዄተሎ ኸንኩም።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">ሐዋ. 17፥5-9</ref>። </char></note> <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />ስለኸነም በመቄዶንያ በአካይያ ይትረከቦዪ ምእመናን እንም ፈያ ምሳሌ ኸንኩም። <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />የጔታ ቃል ታሑ ወጣም የሴማ በመቄዶንያ በአካይያ ጠለለ ቴይኸን በእዝጌር ያነናሑ እምነት ብንም መደር ተዄረም ባነ፤ በዚ መሳ ኢና ስለዚ ወባጀ አትም ኤያሸነ። <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />ታሑዬ በቸኘነጌ ምንኸም የቌበርኩነኸም ሕያው የኢነተኘም አምላክ የዋገልግል ተጣዖት ተላኘሑም ተእዝጌሬ ምንኸም የዠበርኩኸም ዛ ሰቦች እንም ነብሰሕኖ ይምሰክሮ። <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />ዛምኸም እዝጌር ተሞት ያትኔሣኒ፥ ቲቸኚ ማት ያተርፍነዪም፥ የትኸኹታን የኢየሱስ ተሰሜ ወተኝ ምንኸም ትቅሮኸም ይምሰክሮ።<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">የጳውሎስ አገልግሎት በተሰሎንቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />ጐባቢት! ኢና ታሑዬ ወተኘና ኤድገልል አለወሕነሑ ነብሳሑ ቲሒሮ። <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />ቲሒሮይኸማት ተዚ ኢፍቴ በፊልጵስዩስ በነበርነᎄ ግዝየ መከራ ስድብም ሰላብነም፤ ቢኸንም ወደል ተቃውሞ ቢሰላብነም ወንጌሊ ያሑ ናትመርነኸም አምላከና ድፍረት አበነም።<note caller="-" style="x"><char style="xo" closed="false">2፥2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">ሐዋ. 16፥19-24</ref>፤ <ref loc="ACT 17:1-9">17፥1-9</ref>። </char></note> <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />ኢና የመከርነኩ ተስተት ወይ በሩክስ ዓላማ ተመራነም አንከነ፤ ያሑ የዋብላልጥ የሸከትኔ አትም ቃር ኤነ። <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />ይልቅሽ እዝጌር ወንጌሊ ይና አደራ ያበነ ቢና ተማመነም ስለኸነ ኧዝነግነ፤ ዚም ኧሸክትነ ሒነናም ይምረምሪ የእዝጌር የዋትብላልቅ ባርነሙ አንከንም የሰብ የዋትብላልቅ ባርነም አንከነ። <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />አትም ግዝየ በቃላት በዋብላልጥ የዋጋ ወሴ አትሜሰርነም ስርም ያንዘጔነኸም አሑ ነብሳሑ ቲሒሮ፤ እዝጌርም ምስክረናው። <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />ታሑም ኸነ ትንጐዲ ተሟንም ሰብ ክብር አንሸነ። <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />የክርስቶስ ሐዋርያት የኸነኸም ባሑ ያሸነዪ የወሳል ኧችልነ ባነ፤ ቢኸንም የዴንጋዬታ ትቅየ ዳኮኸም በፈይነት በግብታሑ ተዥባበርነ። <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />ዛምኸም ስርም ኧወድሑ ስለኸነ የእዝጌር ወንጌል ያሑ ዋብሥር ጠለለ ቴይኸን ሕይወተናም ኢብነኩዬ የዝጋጀነ ባነነ። <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />በጔታ ጐባቢት! ምንኸም የሸከትነ የቌጥነኸማ ቲሒሮ፤ የእዝጌር ወንጌል ያሑ ብናበሥርነᎄ ግዝየ በሟንማሑ ᎈር ጡዋራ አንኸነኸም ምሳር ተክናን በወሠክት ኧቌጥነ ባነ።<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />ባሑ በአማኞች ግብት በነበርነᎄ ግዝየ ምንኸም ባነ ቅድስና ጽድቅም ናጫም ቴነወ ሕይወት የነበርነኸም አሑ ምስክሮችንኩ፤ እዝጌርም ምስክሩ፤ <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />አብ የዴንጋሑ ይሸኩቺ ኸማት ኢናም ያሑ አትባተሑ የሸከትንነኩኸም ቲሒሮ፤ <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />እንጌ ትንመክርነኩ ትናብርታታነኩ፤ ትናጥናናነኩ መንግሥተሑ ክብረሑም ትሰዶኸም የጠራናሑ አምላክ ቢትብላለቅወ ሐለት ትነብሮኸም ዐደራ የባርነኩኸም ቲሒሮ።<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />ኧሗም ስላሑ ታናቋርጥነ የእዝጌር አምሰግነᎄ መሳ ነነነ፤ ዚም ቲና የሰማሑዪም የእዝጌር ቃል በቌበርኩ ግዝየ ባሑ በአማኞች ይሸክቲ ዚም ቃል የቌበርኩይ የሰብ ቃልኸም ቴይኸን ልክ የእዝጌር ቃልኸም ሸከትኩሙ፤ የኢንም የእዝጌር ቃሉ። <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />በጔታ ጐባቢት፥ አሑም በይሑዳ ይትረከቦዪ በኢየሱስ ክርስቶስ የእዝጌር አብያተ ክርስቲያን የኸኖዪ ምሳሌ ተዄተልኩም፤ ሕኖ በአይሑድ መከራ የሰላቦኸም እንም አሑም በፎላሑ ወገናሑ መከራ ሰላብኩም።<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">ሐዋ. 17፥5</ref>። </char></note> <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />አይሑድ ጔታ ኢየሱስ ነብዮችም የቀጠሮ ይናም አሳደዶም ተገኝ ያትዌጦኖ፤ ሕኖ እዝጌርም ያቴዝኖ ሰቦች እንም ይጠሌዎኖ፤<note caller="-" style="x"><char style="xo" closed="false">2፥15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">ሐዋ. 9፥23</ref>፣<ref loc="ACT 9:29">29</ref>፤ <ref loc="ACT 13:45">13፥45</ref>፤ <ref loc="ACT 14:2">14፥2</ref>፤ <ref loc="ACT 5">5</ref>፤ <ref loc="ACT 19">19</ref>፤ <ref loc="ACT 17:5">17፥5</ref>፤ <ref loc="ACT 13">13</ref>፤ <ref loc="ACT 18:12">18፥12</ref>። </char></note> <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />አሕዛብ ይተርፎᎄዪ ቃል አንዝነግነኸም ይኸትሮነ፤ በዛምኸማት አጢአት በአጢአት ᎈር ቲደብሮ ያሮ፤ ስለኸነም በመጨረሻ የእዝጌር ማት ቸኘቦም<note caller="+" style="f"><char style="fr" closed="false">2፥16 </char><char style="ft" closed="false">ወይ</char><char style="fqa" closed="false">በወሙላ ቸኘም</char></note>።<verse eid="1TH 2:16" /></para>
  <para style="s1">ጳውሎስ ተሰሎንቄ የወጎብኝ የነᎄረን ቡርሻት</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />ቢኸንም በጔታ ጐባቢት! በመንፈስ ቴይኸን በጅስም የቀል ግዝየ ታሑ በወትላኘና ስላሑ ያነነ ቡርሻት ብዠ ስለኸነ ቤነና ናዥነኩዬ ብዠ ጥረት ሸከትነም። <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />ታሑዬ ወተኝ ሸነም ባነ፤ በተለይም እያ ጳውሎስ ታሑዬ የወተኝ ዥባበርኩም ሞከርኩም ባነ፤ ቢኸንም ሼጣን ኸተረነ። <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />ኧጌ፥ ተስፋና ወይ ብልቃተና ወይ ጔታና ኢየሱስ ቢቸኝወ ግዝየ ቢፍተሑ ኧትነነድነᎄ የውራግ አክሊለና አሑ አንከንኩ? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />ዮንም ክብረና ብልቃተናም አሑትንኩ።<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />ስለኸነም ትዕግሥት ባለወቻለና በአቴና የሟነና ወኢ ፈያ ኸነም ታዠነ።<note caller="-" style="x"><char style="xo" closed="false">3፥1 </char><char style="xt" closed="false"><ref loc="ACT 17:15">ሐዋ. 17፥15</ref>። </char></note> <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />ጐቤና የእዝጌር አገልጋይም የኸነዪ፥ የክርስቶስ ፈያ ዜና በዋብሥር የሜና መራርቻና ጢሞቴዎስ ላሕነንኩም፤ የላሕነንኩም ያጠናሑዬ በእምነትም ትብረቶኸም ይመክርሑኸሙ፤ <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />ዚም በሰላብኩ መከራ አትናወጦኸም ይሸክትኩ፤ ዚ መከራ ይና የትዌሰነንነ ዕጣ ወሕነሑ አሑ ራሳሑ ቲሒሮ። <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />ዛምኸም ታሑጌ ባነነᎄ ግዝየ መከራ ይሰላብነኸም በደርነም ኢውድነኩ ባነ፤ ቲሒሮይኸም መከራዪ ሰላብነም፤ <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />በዚ መሳ ተሗ አንቌ ፈረኩም ወቀየ ባለወቻለኛ ስለእምነታሑ ወሐር ሸሑም ጢሞቴዎስ ታሑዬ ላክሑንም፤ ሑቲ የላክሑን ምናልባት ፈታኚ በቁና ኤማ ፌተነናሑም ይኸን፤ ሜናናም ኤድገልል ኸነም ቀኘም በወበር ጔናሑሙ።<verse eid="1TH 3:5" /></para>
  <para style="s1">ጢሞቴዎስ ጠᎄጠንም የቸኘዪ የምሥራች</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />ኧሗም ጢሞቴዎስ ባሑዬም ቲናዬ ቸኘም ስለእምነታሑ ስለፍቅራሑም ያትብላልቅ ዜና ኤወደነ፤ ዛምኸም አሑ እንጌ በፈያ ታስታውሶነኸም ኢና ያሑ የወዥ ኧቦርስነኩ ቅጫ አሑም ይና የወዥ ትቦርሶኸም ኤወደነ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="ACT 18:5">ሐዋ. 18፥5</ref>። </char></note> <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />ስለኸነም ጐባቢት፥ ኢና ኧትረከብነ በምካት በመከራም ውስጥ ቢኸንም በእምነታሑ መሳ ባሑ ተጥናነም። <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />የአሑ በጔታ ኢየሱስ ጠናሑም ብትቈሞ ይና ሕይወተናው። <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />ዘ፥ ኧሗ ስላሑ ምስጋና ናቀርብነ፤ በአሑም መሳ በሑቲ ኢፍቴ ያነነ ብልቃት የእዝጌር ናምሰግነ። <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />ምሳር ተክናን ብረታነም ኧጤልልነዬ ቤነና ናዥነኩኸም በእምነታሑ የቀበለዪ የወሙላ ኧችልነኸሙ።<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />ኧሗም አምላከና አባናም ነብሰሑ ጔታና ኢየሱስም ታሑዬ ኧቸኝነኸም ኤማና ያቅናንነ። <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />ኢና ናፈቅርነኩኸም ጔታ ነብስ በነብሰና የንጐዲም እንም ያነናሑ ፍቅር ይበዛኸም የሰክትንኩ፤ <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />በዚምኸማት ጔታና ኢየሱስ ተቅዱሳኒጌ እንም ቢቸኝወ ግዝየ በአምላከና በአባናም ኢፍት ሒናሑ ናጫ ዬነወዪ ቅዱስ ይኸንኸም ያብረታሑ።<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">የእዝጌር ያትብላለቅ ሕይወት</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />በመጨረሻም በጔታ ጐባቢት! የእዝጌር የዋትብላልቅ ምንኸም ወንብር ይጌባሑኸም ቢና ተማርኩም፤ ኧሗም ትነብሮ ዛምኸሙ፤ በጔታ በኢየሱስ ሽም ኧጮቅስነኩዪ ኧመክርነኩዪም ተዚ ኢፍቴ ተሸከትኩይ የበዛ የዋንጡ። <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />በጔታ ኢየሱስ ሽም ምንኸማት መመሪያ ያብነኩኸም ቲሒሮ። <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />የእዝጌር ፈአድ አሑ ትትቄደሶኸም ተዝሙት ትረቆኸሙ። <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />ኧሗም እያታተሑ የፎለሑ ገገሑ<note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ተፎለሑ ምሽተሑጌ ወንብር ወትማር </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ምሽት የወርክብ ወትማር</char></note> በቅድስና በክብር ወጥብጥ<note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ተፎለሑ ምሽተሑጌ ወንብር ወትማር </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ምሽት የወርክብ ወትማር</char></note> ያነወኸም ይሒርኸሙ፤ <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />የእዝጌር ኤይሒሮ አሕዛብኸም የወትራኸብ ኤላት ኤይንብርብኩ። <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />በዚ ዘንጋ ሟንም ሰብ ኤችላለፍ፤ የጔታ ጐቤች ኤያብላልጥ፤ ተዚ ኢፍቴ ዬወድነኩኸም ያጥኔቀቅነኩኸም ዚኸም ይሸክቶዪ ጔታ ይቀጣኖ። <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />እዝጌር የጠራነ በቅድስና ኧነብርነኸሙ አንኸንም በሩክሰት ኧነብርነኸም አንከነ። <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />ስለኸነም ዚ ምክር ይቃወም፥ ይቃወሚ ቅዱስ መንፈሰሑ ያበናሑዪ የእዝጌር አንኸንም የሰብ አንከነ።<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />ስለጐባቢት ወትዋደድ ሟንም ይጠፍንኩዬ ኤያሸ፤ መሳሑም ነብስ በነብሳሑ ትትዋደዶኸም አሑ ነብሳሑ በእዝጌር ተማርኩም። <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />በመቄዶንያ እንም ያኖዪ በጔታ ጐባቢት እንም ትወዶ፤ ቢኸንም በጔታ ጐባቢት፥ ኧሗ ኧመክርነኩ የበዛ ትወዶኸሙ፤ <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />ጭጭ በወበር የወንብር ትትጋደሎኸም የነብሳሑ ዘንጋ ቴስቦኸም ተዚ ኢፍቴ ዬዘዝነኩኸም በፎላሑ ኧጅ የዋንጡ። <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />በዚኸማት ቤያምኖ ሰቦቼ የትከበርኩ ትኸኖ፤ የሟንም ጡዋራ አትኸኖ።<verse eid="1TH 4:12" /></para>
  <para style="s1">የጔታ ወዘበርም ወተኝ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />በጔታ ጐባቢት! ተስፋ ዬነኖ ሰቦችኸም አትዝኖ፤ ስለᎀቶዪ ሰቦች የኢኒ ቲሕሮኸም ኧወድነ። <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />ኢየሱስ የᎀተኸም ተሞትም የትነሣኸም ናምንነ፤ ስለኸነም በኢየሱስ አመኖም የᎀቶዪ እዝጌር ተሑቲጌ ያቸኝኖ።<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />ተጔታ በቌበርነዪ ቃል መሠረት ኢውድነኩዪ ዚቱ፤ ጔታ ይቸኝወ ግዝየ ስን ሕያዋን ኸነም ኤክስነ የᎀቶዪ አንበድርነ። <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />በጔታ ትዛዝ ጣምባ፥ የመላይካ አለአ ጣምባ፥ የእዝጌር አንዱር ይሴማ፤ ጔታ ነብሰሑ በዚሕኖ ቴጀበም በሰሜ ይወርድ፤ በክርስቶስ አመኖም የᎀቶዪም በደሮም ይትነሦ። <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />ተዚ አንቌ ኢና በሕይወት ኧትረከብነዪ የጔታ በአየር ᎈር የወትራኸብ ተሑቲጌ በዳበና ኧነጠቅነ፤ የዘላለም ተጔታጌ ኧኸነ።<note caller="-" style="x"><char style="xo" closed="false">4፥15-17 </char><char style="xt" closed="false"><ref loc="1CO 15:51-52">1 ቆሮ. 15፥51-52</ref>። </char></note> <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />ስለኸነም በዚ ቃል ነብስ በነብሳሑ ተጥናኖ።<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s1">የጔታ ወተኝ ተዝጋዶም ቀሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />በጔታ ጐባቢት! ዚ ዘንጋ ይኸንወ ዘበን ስለግዝየዪ አትም ይጠፉኑኩኸም ኤያሸ። <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />የጔታ ከነ ይቸኝ፥ ሌባ በምሳር ይቸኝኸማት ወሕነሑ አሑ ራሳሑ ፈያ ሸከትኩም ቲሒሮ።<note caller="-" style="x"><char style="xo" closed="false">5፥2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">ማቴ. 24፥43</ref>፤ <ref loc="LUK 12:39">ሉቃ. 12፥39</ref>፤ <ref loc="1PE 3:10">1 ጴጥ. 3፥10</ref>። </char></note> <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />ሰቦች “እንም ቃር ሰላም የትርጋጋው” ቲብሮ ዄት ነብስ ምሽት መጥ ይጠብጣኸማት ጥፋት በድንገት ይቸኝቦ፤ ባትምኸማት ኤያመልጠማ። <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />አሑም በጔታ ጐባቢት፥ በጨለማ ውስጥ አንከንኩ፤ ስለኸነም ከነዪ የሌባኸም ኤቸኝብኩ። <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />አሑም እንማሑ የብራን ሰቦች፥ የክናን ሰቦችንኩ፤ ኢና የምሳር የጨለማም ሰቦች አንከነ። <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />ስለኸነም ኢና ንቃነ፤ ነብስ በወግዛ በመጠን ንምብርነ አንከንም ይንጐዲ ያነመኖዪኸም አናጓድልነ። <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />ያንጓድሎ ሰቦች ምሳር ያንጓድሎ፤ ይሰክሮዪም በምሳር ይሰክሮ። <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />ኢናም የብራን ሰቦች ስለኸነ ነብስ በወግዛ በልክ ንምብርነ፤ እምነት ፍቅርም ደረት ይኩላኰልᎄ ብረት ንግድነ፤ የወትርፍ ተስፋ የጉነን ብረት ቆብኸም ናውናነ፤<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="ISA 59:17">ኢሳ. 59፥17</ref>፤ <ref loc="EPH 6:13-17">ኤፌ. 6፥13-17</ref>። </char></note> <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />እዝጌር የጠራነ የማት ቴይኸን በጔታና በኢየሱስ ክርስቶስ መሳ ኧተርፍነኸሙ። <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />ክርስቶስ ይና የᎀተ በሕይወት ብንኸነም ብንᎀትነ ተሑቲጌ ኧነብርነኸሙ። <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />ስለኸነም ኧሗ ብትሸክቶይኸማት አቲ ይንጐዲ በዋንጥ ያቡርታታን።<verse eid="1TH 5:11" /></para>
  <para style="s1">የመጨረሻ ምክር ሰላምታም</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />በጔታ ጐባቢት! ባሑ ግብት በሜና ይቌጦዪ፥ በጔታ ኢየሱስ አለኦቻሑ መካሪዎቻሑም የኸኖዪ ታከብሮዮኸም ኧጮቅስነኩ፤ <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />በሜናሕኖ መሳም የሕኖ ወደል አክብሮት ፍቅርም የንብርኩ፤ አሑም ነብስ በነብሳሑ በሰላም ንበሮ።<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />በጔታ ጐባቢት! “የሰነፎቺ ገሥጦ፤ ይጔኖዪ አድፋፍሮዮ፤ የቌጦዪ አብርታቶዮ፤ የሰብ እንም ፍረኮ” ባርነም ኧመክርነኩ። <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />ሟንም ሰብ በቡሼ ሟኔ ቡሼ ኤዠብርኸም ተቀሮ፤ ይልቅሽ እንጌ አሑ ነብስ በነብሳሑም ኸነ ዛምኸም ይንጐዲ ሰቦች እንም ፈያ የወሰክት ተጋደሎ።<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />እንጌ ተብላለቆ፤ <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />ባለዋቋርጥ ጠልዮ፤ <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />ብንም ቃር የእዝጌር አመስግኖ፤ በኢየሱስ ክርስቶስ ባነናሑ ሕይወት እዝጌር ባሑ ይሸን ዚቱ።<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />የመንፈስ ቅዱስ ሜና አታዳፍኖ፤ <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />የትምቢት ስጦታ አትናቆ፤ <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />እንም ዘንጋ ፈትኖ፤ ፈያ የኸነዪ ጥብጦ። <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />ተሟንምኸማት ቡሼ ቃር ራቆ።<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />የሰላም አምላክ ነብሰሑ ብንም ቃር የቀድስኩ፤ መንፈሳሑ፥ ነብስያሑ፥ ጅስማሑ በሙላ ጔታና ኢየሱስ ክርስቶስ ይቸኝወ ከነ ያለ ናጫ ተቅየም የንብር። <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />ዛ ይጠራሑ ታማኝ ስለኸነ ዚ ይሸኩች።<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />በጔታ ጐባቢት! ይናም ጠልዮንነ።<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />በጔታ ጐባቢትኸም የተም ተጐቤኸም በቄደሰ ወሰሰም ሰላም በሮዮ። <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />ዚ መልክት በአማኞች እንም ይነበብኸም በጔታ ሽም ዐደራ ኧብርኩ።<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />የጔታና የኢየሱስ ክርስቶስ ጸጋ ታሑጌ የሕን፤ አሜን።<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>