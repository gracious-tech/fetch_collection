<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">Mesqan New Testament</book>
  <para style="h">የሐዋርያት ሜና</para>
  <para style="toc1">የሐዋርያት ሜና</para>
  <para style="toc2">የሐዋርያት ሜና</para>
  <para style="toc3">ሐዋ.</para>
  <para style="mt">የሐዋርያት ሜና</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የሐዋርያት ሜና ተሉቃስ ወንጌል የቄጠለው፤ የመጽሐፊ ዋና ዓላማ የመጀመሪያዎቺ የኢየሱስ ይትዄተሎዪ በመንፈስ ቅዱስ ተመሮም ስለ ሑቲ ይዝነጊኒ የምስራች ቃል “በኢየሩሳሌም፥ በይሑዳ ገኝ እንም፥ በሰማርያ የአፈር ጥገሑ ስን” (1፥8) ወንጌል ምንኸም ያሳሎኸም የዋውዱ፤ መጽሐፊ የክርስትና እምነት በአይሑድ ግብት ቈረሺም ይንም ዓለም ሕዝብ እምነት ይኸን ስን ምንኸም የቤተተኸም ይዝነግ ታሪኩ። ጠሐፊዪ፥ ክርስቲያኖች የሮም ንጉሠ ነገሥት መንግሥት የወቅናቀን ውስጥ በውስጥ ሤራ ያዝጋዶ ሰቦች ያንከኖኸም የክርስትና አይማኖትም የአይሑድ አይማኖተኛ ፍጡም ይሸክት የኸነኸም የዋትረዳ ተጋደለም።</para>
  <para style="ip">የሐዋርያት ሜና፥ ስለ ኢየሱስ ይዝነግ የምስራች ቃል ይሰላወ መደር ተግዝየ ግዝየሑ ቲቤትት ወወረሑም የቤተ ክርስቲያንም ወሠከት ቢያቴዞ ሦስት ዋና ዋና ክፍል ይትሜደቤ ይችል፦</para>
  <para style="ip">1. የክርስትና አይማኖት ተኢየሱስ ዋርግ አንቌ በኢየሩሳሌም ወቅርሰሑ።</para>
  <para style="ip">2. በእስራኤል ገኝ እንም ወስላሑ።</para>
  <para style="ip">3. የሮም ገኝ ደበረም በሜዲቴራኒያ ባር ዡሪያ ባኖዪ ገኝ ወበትተሑ።</para>
  <para style="ip">በሐዋርያት ሜና ውስጥ ተላኘም ባረም ይታዢ የመንፈስ ቅዱስ ሜና ቲኸን በጰንጠቆስጤ ከነ በኢየሩሳሌም በነበሮዪ አማኞች ᎈር በሐይል ወውርደሑ፥ ዛምኸም በመጽሐፊ ውስጥ ባፍታቶዮዪ በሸከቶዪ እንም የታዠኸም መንፈስ ቅዱስ ቤተ ክርስቲያን መሪሕኖም ወምራውታም ዋብርታታሑ ይደብር። በድረ ግዝየ ይቀርብ የነበረዪ የክርስትና መልክት በትልያዮ ስብከቶች ውስጥ፥ በዋፍታታ አሳብ መልክ ቀረበም፤ በሐዋርያት ሜና ውስጥ የትፌጠሞዪ ሜና መልክተሑ በአማኞች ሕይወት በቤተ ክርስቲያን ቁናዬ ወሕን የነᎄረን ቆት ምናሕር ወደል ወሕነሑ ያትሬዶ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">የምስክርነት ወዝጋጅ <char style="ior"><ref loc="ACT 1:1-26">1፥1-26</ref> </char></para>
  <para style="io1">ኢየሱስ በመጨረሻ ያᎄን ትዛዝ ተስፋም <char style="ior"><ref loc="ACT 1:1-14">1፥1-14</ref> </char></para>
  <para style="io1">በይሑዳ መደር እንጐድ ወሰገረሑ <char style="ior"><ref loc="ACT 1:15-26">1፥15-26</ref> </char></para>
  <para style="io1">ምስክርነት በኢየሩሳሌም <char style="ior"><ref loc="ACT 2:1-8:3">2፥1—8፥3</ref> </char></para>
  <para style="io1">ምስክርነት በይሑዳ በሰማርያም <char style="ior"><ref loc="ACT 8:4-12:25">8፥4—12፥25</ref> </char></para>
  <para style="io1">የጳውሎስ ሐዋርያዊዪ አገልግሎት <char style="ior"><ref loc="ACT 13:1-28:31">13፥1—28፥31</ref> </char></para>
  <para style="io2">የመጀመሪያዪ የጳውሎስ ወወር <char style="ior"><ref loc="ACT 13:1-14:28">13፥1—14፥28</ref> </char></para>
  <para style="io2">የኢየሩሳሌም ጀᎈር <char style="ior"><ref loc="ACT 15:1-35">15፥1-35</ref> </char></para>
  <para style="io2">ዄታለኘዪ የጳውሎስ ሐዋርያዊዪ ወወር <char style="ior"><ref loc="ACT 15:36-18:22">15፥36—18፥22</ref> </char></para>
  <para style="io2">ሦስታለኘዪ የጳውሎስ ሐዋርያዊዪ ወወር <char style="ior"><ref loc="ACT 18:23-21:16">18፥23—21፥16</ref> </char></para>
  <para style="io2">የጳውሎስ በኢየሩሳሌም፥ በቂሳርያ በሮምም ወታገድ <char style="ior"><ref loc="ACT 21:17-28:31">21፥17—28፥31</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">የመንፈስ ቅዱስ ተስፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />ቴዎፍሎስ፤<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">ሉቃ. 1፥1-4</ref>። </char></note></para>
  <para style="p" vid="ACT 1:1">ኢየሱስ የወሰክትም የዋትመር የቈረሰኒ እንም በመጀመሪያዪ መጥሐፈኛ ጣፍኩም። <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />ተሰሜዬ ያረገወ ከነ ስን የሸኰተኒው፤ ተሰሜዬ ዬረገዪም የሜጠረኖ ሐዋርያት ትዛዚ በመንፈስ ቅዱስ መሳ ባበኖ አንቌው። <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />ብዠ መከራ ተቌበረም በᎀተ አንቌ ነብሰሑ ቀረበም ሕያው ወሕነሑ፤ የዚሕኖ በብዠ ቢልቢጢጦ ማስረጃ ቲያርጋግጥኖ አርባ ከነም ዐልፎ ዐልፎ ቲታዥኖ ስለእዝጌር መንግሥት ኤወደኖ። <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />ተሕኖጌ በነበረወ ግዝየ እኪ ቲብር ኤዘዘኖ፦ “እያ ዬወደኩሑዪ በአብ የቴበ ተስፋ ቀሮ አንኸንም በኢየሩሳሌም አትውጦ፤<note caller="-" style="x"><char style="xo" closed="false">1፥4 </char><char style="xt" closed="false"><ref loc="LUK 24:29">ሉቃ. 24፥29</ref>። </char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />ዮሐንስ በኧጋ አጠመቀም ባነ፤ አሑም ተቀል ከነ አንቌ በመንፈስ ቅዱስ ትጠመቆ።”<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቴ. 3፥11</ref>፤ <ref loc="MRK 1:8">ማር. 1፥8</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3፥16</ref>፤ <ref loc="JHN 1:33">ዮሐ. 1፥33</ref>። </char></note><verse eid="ACT 1:5" /></para>
  <para style="s1">ኢየሱስ ተሰሜዬ ዋርገሑ</para>
  <para style="r">(<ref loc="MRK 16:19-20">ማር. 16፥19-20</ref>፤ <ref loc="LUK 24:50-53">ሉቃ. 24፥50-53</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />ሕኖ ቁናዬ ተስበሰቦም ትናኖ፥ “ጔታ! መንግሥታኸ የእስራኤል ዠበርከም ቲብወ ግዝየ ኧሗቱ?” ቲብሮ ተሳሎይ።<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />ኢየሱስም እኪ ባረኖ፤ “አብ በፎለሑ ሥልጣነሑ የዌሰነኒ ግዝየ ወይ ዘበን ወሐረሑ የአሑ አናቡኩ፤ <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />ቢኸንም መንፈስ ቅዱስ ባሑ ᎈር በወረደ ግዝየ ቆት ትቄበሮ፤ በኢየሩሳሌም፣ በይሑዳ በሰማርያም እንም፣ አፈር ጥግ ስን ምስክሮቸኛ ትኸኖ።” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />ዚም በባረ አንቌ ቲያዞይ ተሰሜዬ ዐረገ፤ ዳበናም ቴነሕኖ ሼፈነም ተቌᎄረንም።<note caller="-" style="x"><char style="xo" closed="false">1፥9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">ማር. 16፥19</ref>፤ <ref loc="LUK 24:50-51">ሉቃ. 24፥50-51</ref>። </char></note><verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />ሑቲም ቢያርወ ግዝየ ጡጥ ባሮም ተሰሜዬ ቲምሌከቶ፤ ዘ፤ ነጨ ነጨ ልባስ የለበሶ ዄት ሰብ በሜጠቀሕኖ ቈሞ፤ <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />እኪም ባሮዮ፤ “አሑ የገሊላ ሰቦች፤ ተሰሜዬ ትትትምሌከቶ በዚ የቈምኩ የመአሩ? ዚ ባሑዬ ተሰሜዬ ቲያዐርግ ያዠሑይ ኢየሱስ፤ በዚም ሐለት ይዠበር።”<verse eid="ACT 1:11" /></para>
  <para style="s1">ማትያስ በይሑዳ ሟኔ ተሜጠረ</para>
  <para style="r">(<ref loc="PSA 109:8">መዝ. 109፥8</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />በዛም ደብረዘይት በቧሪዪ ቈቶ ተኢየሩሳሌሜም ተዠበሮ፤ ዚም ቈቶ በኢየሩሳሌም የሰምበት ኤማ ቅጫ<note caller="+" style="f"><char style="fr" closed="false">1፥12 </char><char style="ft" closed="false">ቁና ሺ ቁና መቶ ሜትር ቅጫው። </char></note> ይረቅ ባነ። <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />ተኢየሩሳሌሜም ቸኖም ቲነብሮᎄ ሰገነት ᎈሬ ወጦ፤ ሕኖም ጴጥሮስ፤ ዮሐንስ፤ ያዕቆብ፤ እንድርያስ፤ ፊልጶስ፤ ቶማስ፤ በርቶሎሜዎስ፤ ማቴዎስ፤ የእልፍዮስ ትኸ ያዕቆብ፤ ይቀና የቧሪዪ ስምዖንም የያዕቆብ ትኸ ይሑዳ<note caller="+" style="f"><char style="fr" closed="false">1፥13 </char><char style="fqa" closed="false">ቅናትመኘ፦ </char><char style="ft" closed="false">የማር. ም. 3 ቊ. 18 ይጐልጪ ተመልከቶ። </char></note> ባኖ።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">ማቴ. 10፥2-4</ref>፤ <ref loc="MRK 3:16-19">ማር. 3፥16-19</ref>፤ <ref loc="LUK 6:14-16">ሉቃ. 6፥14-16</ref>። </char></note> <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />ነዚሕኖ እንም እንጌ የጠሎት በአትነት ይስበሰቦ ባነ፤ ተሕኖምጌ አታት እንሽታዎች የኢየሱስ ዳኮም ማርያም፥ ዛምኸም የኢየሱስ ጐባቢት ባኖ።<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />በዛ ግዝየ ጴጥሮስ መቶ ሑያ ቢኸኖ አማኞች<note caller="+" style="f"><char style="fr" closed="false">1፥15 </char><char style="ft" closed="false">ጐባቢት ወይ </char><char style="fqa" closed="false">አማኞች </char></note> ግብት ቈመም እኪ ባረ፦ <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />እኪ ባረ፤ “በጔታ ጐባቢት፤ የኢየሱስ የጠበጦይ ሰቦች መሪ የኸነኖ ስለኸነ ስለይሑዳ፤ መንፈስ ቅዱስ በደረም በዳዊት አፍ የዝነጔኒ የመጽሐፊ ቃል ወፈጠም ያነወ ስለኸነ፤ <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />ይሑዳ ቲና አቲ ኸነም የዚ አገልግሎተና ይሰድ ባነ።” <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />ዚ ሰብ በቡሼ ሜናሑ በከᎈለን ዋጋ አፈር ስየ፤ በዛም በግንባረሑ ተደፋም በግብተሑ ተስነጠቀም፤ አንዘተሑም ተዝረገፈ። <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />ዚም በኢየሩሳሌም ቢነብሮዪ እንምሜ ተሴማ፤ አፈሪም በቋንቋሕኖ አኬልዳማ ቧሪም ጠሬ፤ ትርጉመሑም የደም አፈር ወበሩ።<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />ጴጥሮስም በወቀጥል እኪ ባረ፤ በመዝሙር መጽሐፍ፤</para>
  <para style="q1" vid="ACT 1:20">ይነብርወዪ ባዶ የሕን፤</para>
  <para style="q1" vid="ACT 1:20">ይነብርወዪም ሰብ ኤይትረከብ ኧሗም፤</para>
  <para style="q1" vid="ACT 1:20">ሹመተሑ እንጐድ ሰብ የውስጅ<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">መዝ. 69፥25</ref>፤ <ref loc="PSA 109:8">109፥8</ref>። </char></note></para>
  <para style="m" vid="ACT 1:20">ቧሪም ተጣፈም።<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“ስለኸነም ጔታ ኢየሱስ በግብተና በገባወ በወጣወም ግዝየ እንም፤ ቲናጌ ተነበሮዪ ግብት አት ሰብ ወመጥር ያሸ፤ <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />ዛምኸም፤ ተዮሐንስ ጥምቀት ቀረሰም ኢየሱስ ቲና ተላኘም ታረገወ ከነ ስን የነበረ ወሕን ነነወ፤ መሳሑም ተዚሕኖ ሰቦች አቲ ቲናጌ የትነሣኤዪ ምስክር ይኸንኸም ያሸ።”<note caller="-" style="x"><char style="xo" closed="false">1፥22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">ማቴ. 3፥16</ref>፤ <ref loc="MRK 1:9">ማር. 1፥9</ref>፤ <ref loc="MRK 16:19">16፥19</ref>፤ <ref loc="LUK 3:21">ሉቃ. 3፥21</ref>፤ <ref loc="LUK 24:51">24፥51</ref>። </char></note><verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />ስለኸነም ኢስጦስ ይቡሪዪ፤ በርሳባስ ይቡሪዪ ዮሴፍም ማትያስ ዄቲ አቀረቦ፤ <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />እኪም ባሮም ጤለዮ፤ “ጔታ፤ አኸ የሰብ እንም ሒን ቲሒር፤ ተዚሕኖ ተዄቲ ግብት የሜጠርኰኒ ሰብ አተዥነ፤ <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />ኧጤልይነዪም ይሑዳ ተነብሰሑ መደሬ ቲያር የገᎈረኒ አገልግሎት ሐዋርያነትም በወቀበር ይቴኳኒ ትገልጥንነኸሙ።” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />በዛም ኧጣ ባደጎ ግዝየ ዕጣዪም የማትያስ ወጣ፤ ስለኸነም ሑቲ ተዐሥራ አቲ ሐዋርያትጌ ቆጠሪ።<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">በበዓለ አምሳ ከነ መንፈስ ቅዱስ ወረደ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />የበዓለ አምሳ<note caller="+" style="f"><char style="fr" closed="false">2፥1 </char><char style="ft" closed="false">በዓለ አምሳ ወበር ጰንጠቆስጤ ወበር ቲኸን ትርጉመሑም በፋሲካ በዓል በወጣ በአምሳ ከነሑ ይከበር በዓሉ ወበሩ። </char></note> ከነ በሰላ ግዝየ እንም በአትነት፤ ባት መደር ተስበሰቦም ባነ፤<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ዘሌ. 23፥15-21</ref>፤ <ref loc="DEU 16:9-11">ዘዳ. 16፥9-11</ref>። </char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />ሒንጌም በድንገት የብረታ ዐውሎ ኧንፋስኸም ያነ ጣምባ በሰሜ ቸኘም ቾኖᎄም የነበሮᎄዪ ቤት እናነ ᎀላን። <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />የሳት ነበልባሎችም ይመስሮዪም አለመቶች ታዞዮ፤ ተሰሰዶም አትባተሕኖ ᎈር አᎈኖቦ። <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />እንም በመንፈስ ቅዱስ ተመሎ፤ መንፈስም ይዝነጎኸም ባበኖ ቅጫ ብንጐዶቺ ቋንቋዎች<note caller="+" style="f"><char style="fr" closed="false">2፥4 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ልሳኖች </char><char style="ft" closed="false">ዛምኸም በቁ 11</char></note> ይዝነጎ ቀረሰ።<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />በዛ ግዝየ በገኚ እንም ያነ ሕዝብ ቸኖም እዝጌር ይጔኖ አይሑድ በኢየሩሳሌም ባኖ። <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />ዚ ጣምባ ቲሰሞ፤ ብዠ ሕዝብ በአትነት ተስበሰቦ፤ እያታተሕኖም ሰብ፤ ሰቦቺ በፎለሕኖ ቋንቋ ቲዝነጎ በወስማሑ ዱቁቅ ቧረን፤ <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />በወገረምም በወደነቅም እኪ ባሮ፤ “ነዚሕኖ ይዝነጎዪ እንም የገሊላ ሰቦች አንከኖ? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />ኧጌ፤ አትባተና በጨኘነᎄ፤ በፎለና ቋንቋ ቲዝነጎ ኧሰማነዮ ምንኸም ቢኸኑ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />ኢና የጳርቴና፤ የሜድ፤ በኢላሜጤም ሰቦች፤ በመስጴጦምያ፤ በይሑዳ፤ በቀጰዶቅያ፤ በጳንጦስ፤ በእስያ፤ <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />በፍርግያ፤ በጵንፍልያ፤ በግብጽ፤ በቀሬና ᎀረ ባኖዪ በሊቢያ አውራጃዎች ኧነብርነ፤ በሮም የቸኘነ <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />አይሑድም ተይሑዲነቴ የገባነ፤ የቀርጤስ የዐረብም ሰቦች ትንኸነ፤ ሰቦቺ የእዝጌር ወደል ሜና በቋንቋ ቋንቋና ቲዝነጎ ኧሰማነዮ!” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />እንም በወደነቅም ዱቁቅ በወበር፤ “ዚ ዘንጋ ምን ይኸን?” ተበበሮ።<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />አታተሕኖም ኧሗም “ጉሽ የወይን ደጔ<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ይተም ወይን</char></note> ሰጦም ሰከሮም” በወበር ቄለዶቦ።<verse eid="ACT 2:13" /></para>
  <para style="s1">ጴጥሮስ የሕዝቢ ንግግር ሸከተ</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />በዛ ግዝየ ጴጥሮስ ተዐሥራ አቲጌ ቈመ፤ ጣምባሑም ከፍ አበኘም እኪ ቲብር የሕዝቢ ዝነጔ፤ አሑ የይሑዳ ሰቦች፤ በኢየሩሳሌምም ትነብሮ እንም፤ ዚ አት ቃር ሐሮ፤ በጥሞናም ስሞ፤ <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />ግዝየሑ ገና በቅረረሑ ሦስት ሰዓት የኸነ ስለኸነ፤ አሑ ቴስቦይኸም ነዚሕኖ ሰቦች አንሰከሮ። <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />ቢኸንም ዚ በነብዪ ኢዩኤል እኪ ቧሪም የቴወደው፤<verse eid="ACT 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17" />እዝጌር በመጨረሻዪ ከነ እኪ ይኸን፤</para>
  <para style="q2" vid="ACT 2:17">መንፈሰኛ በሰብ እንም ᎈር አᎈሽሽ፤</para>
  <para style="q1" vid="ACT 2:17">ገሜ እንሽታሑም ትምቢት ይዝነጎ፤</para>
  <para style="q2" vid="ACT 2:17">ጐልማሳሑም መና ያዞ፤</para>
  <para style="q2" vid="ACT 2:17">ባሊኦቻሑም ብርዛዝ ያዞ።<note caller="-" style="x"><char style="xo" closed="false">2፥17-21 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">ኢዩ. 2፥28-32</ref>። </char></note><verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />በዛም ግዝየ</para>
  <para style="q2" vid="ACT 2:18">በገሜም ብንሽታ አገልጋዮቸኛ ᎈር</para>
  <para style="q2" vid="ACT 2:18">መንፈሰኛ አᎈሽሽ፤</para>
  <para style="q2" vid="ACT 2:18">ሕኖም ትምቢት ይዝነጎ።<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />በነን በሰሜ ያዴንቅ ዘንጋዎች፤ አቴዥ፤</para>
  <para style="q2" vid="ACT 2:19">በተት በአፈርም ምልክቶችም ኢብ፤</para>
  <para style="q2" vid="ACT 2:19">ደም ኧሳትም የተን ጭጋግም ይኸን።<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />ወደል ያትጌርሚም</para>
  <para style="q2" vid="ACT 2:20">የጔታ ከነ ተወተኘሑ ኢፍቴ፥</para>
  <para style="q2" vid="ACT 2:20">ጬት ይጬልም፤</para>
  <para style="q2" vid="ACT 2:20">ጠናቃም ደም ይመስር።<verse eid="ACT 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21" />የጔታ ሽም አመነም ይጠራ እንም ይተርፍ።<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />የእስራኤል ሰቦች! ዚ ቃል ስሞ፤ አሑ ራሳሑ ቲሒሮይኸም፤ እዝጌር በግብታሑ ታምራት፤ ድንቅ ቃሮች ምልክቶችም በሑቲ ኤማ በወሰክት የናዝሬቲ ኢየሱስ ምሰኰረነም። <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />ሑቲም ራሰሑ እዝጌር በደረም ቤቈደንኸም በሗረን ወሠክት መሠረት ያሑ ተቸለፈም ቴበ፤ አሑም በዐመጠኞች ኧጅ ሰቀርኩም ቀጠርኩይ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">ማቴ. 27፥35</ref>፤ <ref loc="MRK 15:24">ማር. 15፥24</ref>፤ <ref loc="LUK 23:33">ሉቃ. 23፥33</ref>፤ <ref loc="JHN 19:18">ዮሐ. 19፥18</ref>። </char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />እዝጌርም የሞት ቆት አጠፋም ተሞት አትኔሣንም፤ ስለኸነም ሞት ጠበጠም ያቈይኔ አንቻለ።<note caller="-" style="x"><char style="xo" closed="false">2፥24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">ማቴ. 28፥5-6</ref>፤ <ref loc="MRK 16:6">ማር. 16፥6</ref>፤ <ref loc="LUK 24:5">ሉቃ. 24፥5</ref>። </char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />ዳዊትም ስለሑቲ እኪ ይብር፦</para>
  <para style="q1" vid="ACT 2:25">ጔታ እንጌ ቢፍተኛ አዥን፤</para>
  <para style="q2" vid="ACT 2:25">አንትናወጥኸም ሑቲ በከነኛው<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />ስለኸነም ሒነኛ ተብላለቀም፤</para>
  <para style="q2" vid="ACT 2:26">ንግግረኛም በብልቃት ተመላም፤</para>
  <para style="q2" vid="ACT 2:26">የዛምኸም ይᎀቲ በሰረኛ በተስፋ ይነብር፤<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />ነብሰኛ በሲኦል<note caller="+" style="f"><char style="fr" closed="false">2፥27 </char><char style="fqa" closed="false">ሲኦል፦ </char><char style="ft" closed="false">የᎀቶ ሰቦች ይስበሰቦᎄ መደሩ። </char></note> አትገፉን፤</para>
  <para style="q2" vid="ACT 2:27">ቅዱሳኸም በቀብር ብሰበሰም ይቀይኸም አትሸኩች።<verse eid="ACT 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28" />የሕይወት ኤማ አትኴርኼም፤</para>
  <para style="q2" vid="ACT 2:28">ቲያጌ በወሕናኸ ብልቃተኛ ፍጡም ይኸን።<note caller="-" style="x"><char style="xo" closed="false">2፥25-28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">መዝ. 16፥8-11</ref>። </char></note><verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />በጔታ ጐባቢተና! ተበደረዪ አቦቸና አቲ የኸነዪ ዳዊት የᎀተኸም የቀበረኸም፥ ቀብረሑም ኧኳ ስን ቢናዬ ያነኸም ቢልቢጢጦ ናውድሑ። <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />ቢኸንም ዳዊት ዚ የዝነጔኒ ነብይ የነበረ ስለኸነ፤ እዝጌር በዘሮቻኸ አቲ በዙፋናኸ ᎈር አወናከ ቲብር በማላ ያᎄኒ የተስፋ ቃል ይሒር የነበረ ስለኸነው፤<note caller="-" style="x"><char style="xo" closed="false">2፥30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">መዝ. 132፥11</ref>፤ <ref loc="2SA 7:12-13">2 ሳሙ. 7፥12-13</ref>። </char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />ዚም በደረም በወዠሑ በሲኦል ኤይቀይኸም በሠረሑም ኤይብሰብስኸም ስለክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">2፥31 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ፤ </char><char style="ft" closed="false">በግሪክ </char><char style="fqa" closed="false">ክርስቶስ፣ </char><char style="ft" closed="false">በዕብራይስጥ </char><char style="fqa" closed="false">መሲሕ </char><char style="ft" closed="false">ወበሩ </char><char style="fqa" closed="false">የትቀባው </char><char style="ft" closed="false">ወበሩ፤ ዛምኸም በቁ 36</char></note> ትንሣኤ ዝነጔ። <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />ዚ ኢየሱስ እዝጌር በሞት አትኔሣንም፤ ኢናም እንመና የዚ ዘንጋ ምስክሮችንነ። <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />ስለኸነም በእዝጌር ከነ በክብር ቾና፤ የመንፈስ ቅዱስ ተስፋ በአብ ተቌበረም ኧሗ ታዞዪ ትሰሞዪም አᎈሰሰን።<verse eid="ACT 2:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 2:34" />ዳዊት ተሰሜዬ አንወጣ፤</para>
  <para style="q1" vid="ACT 2:34">ዳዊት ነብሰሑም እኪ ቲብር ዝነጔም፤</para>
  <para style="q2" vid="ACT 2:34">“ ‘ጔታ የጔታኛ የመሲሑ፤<verse eid="ACT 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="ACT 2:35" />መሶአኸ በሥልጣናኸ ተት ኧሸክትንከ ስን፣</para>
  <para style="q2" vid="ACT 2:35">በከነኛ ቶና’ ቧረን።<note caller="-" style="x"><char style="xo" closed="false">2፥34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>። </char></note><verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“ኧጌሽ፤ እዝጌር ዚ አሑ የሰቀርኩዪ ኢየሱስ፤ ጔታ ክርስቶስም የሸኰተንኸም የእስራኤል ሕዝብ እንም ዮንም የሐር!”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />ሕዝቢም ዚ በሰሞ ግዝየ ሒነሕኖ በአዘን ተለገደም የጴጥሮስ እንጐዶቺ ሐዋርያትም፥ “ጐባቢት! ኧጌሽ መአር ንሰክትነ?” ባሮዮ።<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />ጴጥሮስም እኪ ባረኖ፤ “ንስሐ ግቦ፤ አጢያታሑም ይሴረዝንኩኸም፤ አትባታሑ በኢየሱስ ክርስቶስ ሽም ተጠመቆ፤ የመንፈስ ቅዱስም ስጦታ ትቌበሮ። <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />የተስፋዪ ቃል ያሑም የዴንጋሑ ዛምኸም ጔታ አምላከና ተሑቲዬ ይጠራኖ፤ በሩቄ ያኖዪ እንሙ።”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />ብንጐድ ብዠ ቃል ቲምሰክርኖም፤ “ተዚ ጠማማ ጨኘት ተቡሼ ሜናሕኖ ነብሳሑ አትርፎ” በወበር አትቂየኖ። <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />ቃለሑ የቌበሮዪም ተጠመቆ፤ በዛ ከነ ሦስት ሺ ቅጫ ሰብ በቁጥረሕኖ ᎈር ተደበሮ።<verse eid="ACT 2:41" /></para>
  <para style="s1">የአማኞች አትነት ኑሮ</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />ሕኖም በሐዋርያት ትምርትም በአትነት በወንብር፤ ስንቅም ቁናዬ በወብራ በጠሎትም ይትጋደሎ ባነ።<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />በሐዋርያት ኧጅ ብዠ ድንቅም ታምራት ይሸከት የነበረ ስለኸነ፤ ሰብ እንም ጊናት ጠᎄጠን። <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />አማኞች እንም በአትነት ባኖ፤ ያነኖዪ እንም የደነብ ሸከቶ።<note caller="-" style="x"><char style="xo" closed="false">2፥44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">ሐዋ. 4፥32-35</ref>። </char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />ዱኒያሕኖም አፈረሕኖ አስሮም ዋጋሕኖ የያታቲ ሰብ ያሸን ቅጫኸም ይቦይ ባነ። <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />ከነ በከነሑ በቤተ መቅደስ ቁናዬ ቲትራከቦ፤ በቤተሕኖም ስንቅ በወብራ በብልቃት በቀናም ሒን ይበሮ ባነ፤ <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />እዝጌርም ቲያምሰግኖ፤ በሕዝቢ እንም ኢፍት ሞገስ ባነኖ፤ ጔታ አመኖም ይተርፎ ሰቦች በቁጥረሕኖ ᎈር ከነ በከነ ይደብር ባነ።<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">ጴጥሮስ ጅረዪ ጮቃሽ ፈያ ሸኰተን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />አት ከነ ጴጥሮስም ዮሐንስ በጠሎት ግዝየ ዚም በከነዪ ዠጠ ሰዓት፤ ተቤተ መቅደሴ ይወጦ ባነ። <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />ተቤተ መቅደሴ ቢገቦዪ ሰቦች ምጽዋት ይጮቅስኸም፤ ሰቦች ከነ በከነሑ ጮሮም መልካማ ባቧሪዪ የቤተ መቅደስ ይገᎄᎄዪ በር ᎈር ያወኖዪ አት በጨኘ ቀረሰም ጅረ የኸነዪ ሰብ ባነ፤ <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />ሑቲም ጴጥሮስ ዮሐንስም ተቤተ መቅደሴ ቲገቦ አዠም ምጽዋት ጮቀሰኖ። <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />ጴጥሮስም ተዮሐንስጌ ተሑቲዬ ትክ ባረም አዠንም፤ “እንዴ ቲናዬ ተመልከት” ቧረን። <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />ምሲም፤ ተሕኖ አት ቃር የወርክብ ኤሰበም ትክ በወበር ተምሌከተኖ። <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />ጴጥሮስም፤ “እያ ብርም ወርቅ ኤኔ፤ ቢኸንም ኢብከ፤ በናዝሬቲ በኢየሱስ ክርስቶስ ሽም ተንሣም በኧግራኸ ተዥባበር” ቧረን፤ <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />ከነ ኧጀሑም ጠበጠም አትኔሣን፤ ሒንጌም ኧግረሑ ቁርጭምጪምተሑም ብረታ፤ <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />ዘለለም ቀጥ ባረም ቈመ፤ ወትራመድም ቀረሰ፤ ተዚዬ ተዛዬ ቲያርም ቲዘልም የእዝጌርም ቲያምሰግን ተሑቲጌ ተቤተ መቅደሲ ጠባዬ ገባ። <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />ሕዝቢም እንም የእዝጌር ቲያምሰግን አዞይ። <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />“ውብ” በቧሪዪ የቤተ መቅደስ ይገᎄᎄዪ በር ᎈር ቾናም ምጽዋት ይጮቅስ የነበረዪ ሑቲ ወሕነሑ ሐሮ፤ በሑቲ ᎈር በትፌጠመዪም ቃር የትነሣ በወደነቅ በወገረምም ተᎀሎ።<verse eid="ACT 3:10" /></para>
  <para style="s1">ጴጥሮስ የሸኰተኒ ንግግር</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />ፈያ የኸነዪም ጮቃሽ ተጴጥሮስም ተዮሐንስጌ አንትላኝ ባረም ተሕኖጌ ትናነ፤ ሕዝቢ እንም በወገረም ሕኖ ተነበሮᎄዬ የሰሎሞን ይዥባᎄርᎄ ቲቡሪ መደሬ ተሑቲዬ ቲሮጦ ቸኖ። <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />ጴጥሮስም ዚ ባዠ ግዝየ እኪ ባረኖ፤ “የእስራኤል ሕዝብ፤ በዚ የመአር ትዴነቆ? ኧሗም ቢና ቆት ወይሽ ቢና ጽድቅ ዚ ሰብ ተረፈም ይዥባበርኸም የሸከትኔኸም በወቁጥር፤ የመአር ቲናዬ ትክ ባሑም ትምሌከቶ? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />የአቦቸና አምላክ፤ አብርሐም፤ የይስሐቅ የያዕቆብም አምላክ የትኸዪ የኢየሱስ አከᎄረን፤ አሑም ይᎀቴ አቸለፍኩም አብኩይ፤ ጲላጦስ ይᎈታኔ ቢሸ አሑ በሑቲ ኢፍት ለጋሑይ፤<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">ዘፀ. 3፥15</ref>። </char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />ቅዱስ የጻድቂ ለጋሑም ሰብ የቀጠረዪ ይፈታንኩኸም ጮቀስኩ፤<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">ማቴ. 27፥15-23</ref>፤ <ref loc="MRK 15:6-14">ማር. 15፥6-14</ref>፤ <ref loc="LUK 23:13-23">ሉቃ. 23፥13-23</ref>። </char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />የሕይወት ወትረኸብ የኸነዪ ቀጠርኩይ፤ እዝጌርም በሞት አትኔሣን፤ ኢናም የዚ ምስክሮችንነ። <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />ዚ ታዞዪም ቲሕሮይ ሰብ የብረታዪ በኢየሱስ ሽም በወምን ሙ፤ እንማሑም ታዞይኸም ፍጡም ፈያ ጤንነት ይረክብኸም የሸኰተን የኢየሱስ ሽም በሑቲ መሳም ይትረከቢ እምነቱ።<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“ኧሗም ሰቦች፤ አሑ ዚ የሸከትኩዪ የአለኦቻሑኸም እንም ባለወሐር የኸነኸም ኧሒር። <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />እዝጌርም የሑቲ የኸነዪ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">3፥18 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ ዛምኸም በቁ 20</char></note> መከራ ይቌበርኸም በደረም በነብዮቺ እንም አፍ የዝነጔኒ ፌጠመም። <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />በይሽ አጢያተሑ ይድመሰስኸም ንስሐ ግቦ፤ ቤማሑም ተዘበሮ፤ በጔታዬም ዬድሽᎄ ዘበን ይቸኝንኩ፤ <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ኧሗም በደረም ያሑ የትሜደበዪ የክርስቶስ ሑቲም የኢየሱስ ይለሕንኩ። <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />እዝጌር በደረም በቅዱሳን ነብዮቺ አፍ የዝነጔኸም፤ እንም ቃር ዬድስወ ዘበን ስን ሑቲ በሰሜ ዬክሴ ይጌቧን። <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />ሙሴም እኪ ባረም፤ ‘ጔታ አምላካሑ ባሑም ግብት ይያኸም ያነ ነብይ ያትኔሳንኩ፤ ሑቲ ይውዱሒዪ እንም ስሞይ፤<note caller="-" style="x"><char style="xo" closed="false">3፥22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">ዘዳ. 18፥15</ref>፤ <ref loc="DEU 18">18</ref>። </char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />ዚ ነብይ ኤይሰማ ሰብ እንም በሕዝቢ ግብት ተላኘም የጥፋ።’<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">ዘዳ. 18፥19</ref>። </char></note> <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />የኢንም ተሳሙኤል ቀረሰም የትነሶዪ ነብዮች እንም ስለዚሕኖ ዘበን ዝነጎም። <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />አሑም የነብዮች ዴንጋንኩ፤ ኧሗም እዝጌር የአብርሐም፤ በዘራኸ የገኝ ጐሣዎች እንም ይትባረኮ” ባረም የገቧኒ ጉዳ ወራሾችንኩ።<note caller="-" style="x"><char style="xo" closed="false">3፥25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">ዘፍ. 22፥18</ref>። </char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />እዝጌር የትኸኹ ባትኔሳን ግዝየ፤ አትባታሑ ተቡሼነታሑ ዠበረም ይባርኩዬ በደረም ታሑዬ ላዀን።<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">ጴጥሮስ ዮሐንስም በአይሑድ ፍርድ ኢፍት ወቅርበሕኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />ጴጥሮስ ዮሐንስም የሕዝቢ ቲዝነጎ ትናኖ፤ ካሕናት<note caller="+" style="f"><char style="fr" closed="false">4፥1 </char><char style="fqa" closed="false">ካሕናት፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “የካሕናት አለኦች አለአ” ይብሮ። </char></note> የቤተ መቅደሲ የዘበኞቺ አላፊ ዛምኸም ሰዱቃውያን ሒንጌም ተሕኖዬ ቸኖ። <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />ሕኖም ሐዋርያት የሕዝቢ በዋትመረሕኖ በኢየሱስ የትረከበ ስለኸነዪ የሟቾቺ ትንሣኤም ወንብረሑ በወስበከሕኖ ስርም ማቶ። <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />ጴጥሮስ የዮሐንስም ጠበጦዮ፤ ግዝየሑም መሸም የነበረ ስለኸነ ይዛኝ ስን በወሕኔ ቤት አቴደሮዮ። <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />የሕን አንኸንም ቃሊ በሰሞዪ ግብት ብዠሕኖ አመኖ፤ የገሜዎቺም ቊጥር ተአምስት ሺዬ ከፍ ባረ።<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />የመናጊ የአይሑድ አለኦች፤ ሽማግሌዎችም፥ የሕጊ አስተማሪዎችም ዛምኸም<note caller="+" style="f"><char style="fr" closed="false">4፥5 </char><char style="ft" closed="false">ጸሐፍት ወበር የሙሴ የሕጊ አስተማሪዎችም ወበሩ። </char></note> በኢየሩሳሌም ተስበሰቦ። <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />ተስበሰቦዪ ሰቦች ግብት የካሕናት አለአዪ ሐና ቀያፋም፥ ዮሐንስ እስክንድሮስም፥ የካሕናት አለአዪ አበሮሶች እንም ይትረከቦ።<verse eid="ACT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 4:7" />ሕኖም ጴጥሮስ ዮሐንስም በግብተሕኖ አቈሞም፤ “ዚ የሸከትኩይ በምን ቆቱ ወይሽ በሟ ሽሙ?” ባሮም ተሳሎዮ።<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />በዛ ግዝየ፤ ጴጥሮስ በመንፈስ ቅዱስ ተመላም እኪ ባረኖ፤ “አሑ የሕዝብ አለኦች ሽማግሌዎችም፤ <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />ኧኳ የዚ ጅረ ሰብ የሸከተ ስለኸነዪ ፈያ ሜና፤ በምንኸም የተረፈኸም ትሰሎነ በኸነ፤ <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ዚ ሰብ ተረፈም ቢፍታሑ የቈመዪ አሑ በሰቀርኩዪ እዝጌርም ተሞት ባትኔሳኒ በናዝሬቲ በኢየሱስ ክርስቶስ ሽም የኸነኸም ያሑ ይንማሑም የእስራኤል ሕዝብ እንም የትኴረ የሕን። <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />አሑ ግንበኞች የገረጥኩይ ያደኩዪም እምን ሑቲቱ፤ ቢኸንም ሑቲ በማዘን ያወኔ እምን ኸነ።<note caller="+" style="f"><char style="fr" closed="false">4፥11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>። </char></note> <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />ድነት ብንጐድ በሟንም ኤይትረከብ፤ ኧተርፍነᎄዬ የሰቦች ያᎅ በዚ ሽም አንኸንም ብንጐድ ሽም ባፈር ᎈር ኤነ።”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />ሰቦቺም፤ ጴጥሮስ ዮሐንስም እኪ በድፍረት ቲዝነጎ ባዞዮ ግዝየ፤ ያንትማሮ ኤድገልሎ ሰቦች ወሕነሕኖ ሐሮም ተዴነቆ፤ ተኢየሱስጌ የነበሮኸም ሐሮ። <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />የተረፈዪም ሰብ በዛዬ ተሕኖጌ ቈመም ያዞይ ስለኸነ ይዝነጎᎄዪ መሳ ቀበጦ። <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />ስለኸነም በአይሑድ ፍርድ ኢፍት ያወጦዮኸም ኤዘዞ፤ በዛም በአትነት ተስበሰቦም እኪ ቲብሮ ተምካከሮ፤ <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />እኪም ተበበሮ፤ “ኧጌሽ ነዚሕኖ ሰቦች መአር ንሰክትነዮ? በኢየሩሳሌም ይነብር እንም በሕኖ ኧጅ የሸከተዪ ድንቅ ታምር ሐረም፤ ስለኸነም ዚም ኧሼምነዬ አንችልነ፤ <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />የሕን አንኸንም፤ ዚ ዘንጋ ተሗ አንቌ በሕዝቢ ግብት የጠቀለ ኤይቤትትኸም፤ ነዚሕኖም ሰቦች ዄታለኘ በዚ ሽም የሟንም ኤይዝነጎኸም ናጠንቅቅነዮ።”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />በዛ አንቌ ጠሮዮም የኢየሱስ ሽም በወጥራ ስርም ኔዝነጎ ወይ ኔያትመሮ አቆመሮም ኤዘዞዮ። <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />ጴጥሮስ ዮሐንስም እኪ ቲብሮ ዠበሮኖ፦ “የእዝጌር ተወታዘዝ የጠቀለ ያሑ ወታዘዝ በእዝጌር ኢፍት ይትጌባ ቃሩ? እንዴ አሑ ነብሳሑ ፍርዶ። <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />ኢናሽ ያዠነዪ የሰማኔዪም ተወዘንግ እንቁስ አንብርነ።” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />ሕኖም ዠበሮም በዛቶቦም አንቌም ገፈሮዮ፤ መሳሑም ሕዝቢ እንም ስለኸነዪ ቃር የእዝጌር ያምሰግኖ የነበረ ስለኸነ ይቀጦዮዬ አንቻሎ። <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />በዚ ታምር ፈያ የኸነዪ ሰብ ዕድሜሑ ተአርባ ዓመት ነን ባነ።<verse eid="ACT 4:22" /></para>
  <para style="s1">የአማኞች ጠሎት</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />ጴጥሮስ ዮሐንስም በትፈቶ አንቌ ተጔታ ጐባቢተሕኖዬ ተዠበሮም የካሕናት አለኦች ሽማግሌዎችም የባሮዮዪ እንም ኤወዶዮ። <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />ሕኖም ዚ በሰሞ ግዝየ ጣምባሕኖ ቁናዬ ተእዝጌሬ ከፍ አበኖም እኪ ባሮ፤ “ንቅ ጔታ፤ አኸ ሰሜ አፈርም፤ ባሪም፤ በውስጠሕኖም ይነብሮዪ እንም ኸለቅከም፤ <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />በመንፈስ ቅዱስም መሳ በአገልጋያኸ በአባና በዳዊት አፍ እኪ ባኸም ዝነጔኸም፤</para>
  <para style="q1" vid="ACT 4:25">“ ‘አሕዛብ የመአር በወማች ተንሠሦ?</para>
  <para style="q2" vid="ACT 4:25">ሕዝቢሽ የመአር ቤድገልል ቃር ኤደሞ?<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />የዓለም ነገሥታት ተሴለፎም፤</para>
  <para style="q2" vid="ACT 4:26">ገዢዎችም ቁናዬ ተስበሰቦም፤</para>
  <para style="q2" vid="ACT 4:26">በጔታ ᎈር፤ በቀባዪም<note caller="+" style="f"><char style="fr" closed="false">4፥26 </char><char style="ft" closed="false">ወይም</char><char style="fqa" closed="false">ክርስቶስ </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">መሲሕ </char><char style="ft" closed="false">ወበሩ። </char></note> ᎈር ተነሦም።’<note caller="-" style="x"><char style="xo" closed="false">4፥25-26 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">መዝ. 2፥1-2</ref>። </char></note><verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />“ዮንም ሔሮድስ ጴጤናዊ ጲላጦስ ተአሕዛብ ተእስራኤል ሕዝብጌ በዚ ከተማ አኸ በቀባዀኒ በቅዱሲ ትኻኸ በኢየሱስ ᎈር የዋሤር ተስበሰቦ፤ <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />እኪም የኸነዪ አኸ በደርከም በፎላኸ ቆት በፎላኸ ፈአድ ዬቈድኰኒ የወፈጥሙ፤ <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />ኧሗም ጔታ፤ ዛቻሕኖ ተመልከት፤ አገልጋዮቻኸም ቃላኸ በፍጡም ድፍረት ወዘንግ ይችሎኸም ሰክቶ። <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />ፈያ የወሰክት ኧጃኸ ዘርጋ፤ በቅዱሲ ትኻኸም በኢየሱስ ሽም ድንቅ ታምራትም ሰክት።”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />በጤለዮም አንቌ የነበሮᎄዪ መደር ተናወጠ፤ እንም በመንፈስ ቅዱስ ተᎀሎ፤ የእዝጌርም ቃል በድፍረት ዝነጎ።<verse eid="ACT 4:31" /></para>
  <para style="s1">የአማኞች የአትነት ኑሮ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />ያመኖዪ እንም በቁና ሒን በቁና አሳብም ተስማሞ ባነ፤ ያነኖዪም እንም የደነብ ባነ አንኸንም የነብሰሑ የኸነዪ ዱኒያ የፎለሑኸም ይቆጥር ሟንም አነበረ። <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />ሐዋርያትም ስለጔታ ኢየሱስ ትንሣኤ በወደል ቆት ይምሰክሮ ባነ፤ ብንም ᎈር ወደል የእዝጌር ጸጋ ባነ። <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />መሳሑም አፈር ወይ ቤት ያነኖዪ እንም አስሮም ዋጋዪ ያቸኖ የነበረ ስለኸነ በግብተሕኖ አትም ምካተኘ አነበረ። <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />ሐዋርያት በሥልጣን ያትዳድሮኸም በዋውና የያታቲ ቢያሸን ቅጫ ይሰዶይ ባነ።<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />በቆጵሮስ ይነብር ዮሴፍ ይቡሪ አት ሌዋዊ ባነ፤ ሐዋርያትም ‘በርናባስ’ ባሮም ጠሮይ፤ ትርጉመሑም የወጥናና ትኸ ወበሩ፤ <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ሑቲም አፈረሑ አስየም፤ ዋጋዪ አቸኘም የሐዋርያት በአላፊነት አበ።<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">ሐናንያ ሰጲራም</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />ሐናንያ የቧሪ ሰብ፤ ተምሽተሑ ተሰጲራጌ አፈር አስየ፤ <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />ምሽተሑ ቢጌባ ትቲሒር በሲየዪ የትዌሰነ ዋጋ በዋቂ የተረፈዪ አቸኘም ሐዋርያት ያትዳድሮኸም በአላፊነት አበ። <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />ጴጥሮስም እኪ ባረ፤ “ሐናንያ፤ የመንፈስ ቅዱስ ትዋሽ ተአፈሪም ያስሬ ታቀዬ ሼጣን ሒናኸ የመአር ᎀላን? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />ታታስየን ኢፍቴ ያኸ አነበረ? ባስየኸንሽ አንቌ ቢኸን ዋጋዪ በጃኸ አነበረ? ወሕነሑ ዚ ዘንጋ ምንኸም በሒናኸ ኤሰብከ? የዋሸዀን እኮ የእዝጌር አንኸንም የሰብ አንከነ።” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />ሐናንያም ዚ በሰማኸም ወጠቀም ᎀተ፤ ዚ የሰሞዪም እንም ወደል ጊናት ጠበጠኖ። <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />ጎልማሳዎቺም ተነሶም ሬሳዪ ኬፈኖይ፤ ወሰዶም ቀበሮይ።<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />ሦስት ሰዓት ቅጫም በቸለፈ አንቌ፤ ምሽተሑ የኸነዪ ቃር ታቲሒር ቸኘችም ገባች። <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />ጴጥሮስም፤ “እንዴ አውጅኝ፤ አፈራሑ ያስየሑይ በዚ ዋጋው?” ባረና። ሒቲም፤ “ኤክ፤ በዚም ዋጋው” ባረች።<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />ጴጥሮስም፤ “የጔታ መንፈስ ትፍታተኖዬ ምንኸም እኪ ተስማማሑ? ዘ፤ ምሳሽ የቀበሮይ ሰቦች ተዠበሮም ኧግረሕኖ በወረጀው፤ ያሺም ጠበጦም ይወጦ” ባረና። <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />ሒቲም ሒንጌም በግረሑ ተት ወጠቀችም ᎀተች፤ ጎልማሳዎቺም ቲገቦ ᎀተችም ረከቦያ፤ አወጦም በምሴታን ᎀረ ቀበሮያ። <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />በቤተ ክርስቲያን እንም ዚ ዘንጋ በሰሞ ሰቦች እንም ᎈር ወደል ጊናት ኸነ።<verse eid="ACT 5:11" /></para>
  <para style="s1">በሐዋርያት ኧጅ ብዠ ሰብ ፈያ ኸነ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />ሐዋርያትም በሕዝቢ ግብት ብዠ ታምራዊ ምልክቶች ድንቅ ሜናዎችም ሸከቶ፤ አማኞቺም እንም የሰሎሞን ወረጀ በቧሪ ይዥባᎄርᎄ ይስበሰቦ ባነ። <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />ተሕኖጌ ይቅላቀል የደፈረ አነበረ፤ ቢኸንም ሕዝቢ ስርም ያከብሮዮ ባነ። <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />ብዠ ገሜዎች እንሽታዎችም በግዝየ ተግዝየዬ በጔታ ያምኖዪ ተሕኖዬ ይደበሮ ባነ። <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />በዚም የትነሣ፤ ጴጥሮስ በዛ ቲቸለፍ፤ ቢያንስ ጥሌለሑ በቀሎቺ ᎈር ያᎈይቦኸም በወበር የታቆዪ ተወረጀዬ ቲያወጦ በአልጋ በቀሬዛም ቤማ ᎈር ይገድሮ ባነ። <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />በኢየሩሳሌም ጭጭሳ ቢትረከቦዪ ከተሞች፤ የታቆቦዪ በሩክስ<note caller="+" style="f"><char style="fr" closed="false">5፥16 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በቡሼ</char></note> መናፍስትም ይስቃዮዪ ጠበጦም የቸኖዪ ሰቦች ጭጭሳዪ ያጭናንቆይ ባነ፤ የቸኖዪም እንም ፈያ ይኸኖ ባነ።<verse eid="ACT 5:16" /></para>
  <para style="s1">በሐዋርያት መከራ ስደትም ሰላቦ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />በዛም የትነሣ የካሕናት አለአዪ ተሑቲጌ የነበሮዪም የሰዱቃውያን<note caller="+" style="f"><char style="fr" closed="false">5፥17 </char><char style="ft" closed="false">ሰዱቃውያን ወበር የአይማኖት ቡድኖች ኖ። ትንሣኤ ሙታን ኤነ ይብሮዪ ኖ። </char></note> ጐሳ እንም በቅናት ተᎀሎም በሑቲ ᎈር ተነሦ፤ <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />የሐዋርያቲ ጠበጦም ወሕኔ ቤት ኸኖዮ። <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />የሕን አንኸንም የጔታ መላይካ በምሳር የወሕኔ ቤቲ ወዝገቦች ከፈተም አወጣኖም፤ <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“ወሮ፤ በቤተ መቅደሲም ጠባ ቁሞ፤ የዚም የሕይወት ቃል እንም የሕዝቢ አውዶ” ባረኖ። <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />የዛኘኸም፤ ቤወጅዮ መሠረት፤ ተቤተ መቅደሴ ገቦም የሕዝቢ ዋትመር ቀረሶ። የካሕናት አለአዪ ተሑቲጌ የነብሮዪ ቸኖም የአይሑድ ጀᎈር የእስራኤልም ባሊኦች ጀᎈር እንም ቁናዬ ስበሰቦ፤ የሐዋርያትም ያቸኖዮኸም የሰቦቺ ተወሕኔ ቤቴ ላሖ። <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />የዘብ አላፊዎቺም ተወሕኔ ቤቴ ወሮም የሐዋርያት በዛ አረኸቦዮ፤ ተዠበሮም ቸኖም፤ <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“ወሕኔ ቤቲ ፈያኸም ታጨም ይቅሮዪም በበሪ ኢፍት ቈሞም ረከብነ፤ ከፈትነም ትንገባነም በውስጠሑ ሟንም አነበረ።” ባሮም ዝነጎ። <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />የቤተ መቅደሲ የዘብ ሹሚም የካሕናት አለኦችም ዚ በሰሞ ግዝየ በዘንጋዪ ተስማሞ፤ ዱቁቅ ባረቦ። <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />በዛ ግዝየ አት ሰብ ቸኘም፤ “ዘ፤ ወሕኔ ቤት የኸናሑዮ ሰቦች በቤተ መቅድሲ ጠባ ቈሞም የሕዝቢ ያትመሮዮው” ባረኖ። <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />የዘበኞቺ ሹሚም ተወታደሮቺጌ ወረም፤ ጠበጠም አቸኘኖ፤ ያቸኖዮም ሕዝቢ የፎሊሶቺ ብምን ኤይወጎሮዮኸም የጔኖ ስለኸነ በሓይል የግድ ቴይብሮዮ ባነ።<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />ሐዋርያትም አቸኖም በጀᎈሪ ኢፍት አቈሞዮ፤ የካሕናት አለአዪም እኪ ቲብር ተሣለኖ፤ <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“በዚ ሽም በወጥራ ኤያትመሮኸም በጥብቅ አጥኔቀቅነኩም ባነ፤ አሑም ኢየሩሳሌም በትምርታሑ መላሑይ፤ ኧሗም ይና የዚ ሰብ ደም ተጠያቂዎች ትሸክቶነዬ አረጥኩም ተነሣሑ።”<note caller="-" style="x"><char style="xo" closed="false">5፥28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">ማቴ. 27፥25</ref>። </char></note><verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />ጴጥሮስ እንጐድ ሐዋርያትም ዠበሮ እኪ ባሮ፤ “ተሰብ የጠቀለ የእዝጌር ኧታዘዝነዬ ይጌባ! <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />አሑ በጨ ᎈር ሰቀርኩም የቀጠርኩዪ የኢየሱስ፤ የአቦቸና አምላክ በሞት አትኔሣን፤ <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />ሑቲም የእስራኤል ንስሐም የአጢያት ወሰረዝ ይቤ፤ እዝጌር ይንም ጉነንም ያተርፍ ሸከተም በከነሑ በክብር አወናን፤ <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />ኢናም የዚሕኖ ዘንጋ ምስክርንነ፤ ኧሗም እዝጌር ይታዘዞዪ ያᎄን መንፈስ ቅዱስ ምስክሩ።”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />ሰቦቺም ዚ በሰሞ ግዝየ ቡሼኸም ማቶ፤ ይቀጥሮዮዬም ሸዎ። <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />ቢኸንም በሕዝቢ እንምሜ የከበረ አት የሕጊ አስተማሪ፤ ሑቲም ገማልያል የቧሪ ፈሪሳዊ ተነሣም በጀᎈሪ ግብት ቈመም የሐዋርያቲ ተውጪዬ አወጣም የቀል ግዝየ ዞር ያብሮዮኸም ኤዘዘ፤ <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />የጀᎈሪም እኪ ባረ፤ “የእስራኤል ሰቦች፤ በዚሕኖ ሰቦች ᎈር ትሸክቶዪ ዬሰብኩይ ስለኸነዪ ቃር በወጠንቀቅ ታጣሮዬ ይጌባሑ። <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />ተዚ ኢፍቴ፤ ቴዎዳስ ነብሰሑ ወደል ሸከተም በወቁጥር ተነሣም፤ አርበት መቶ ቅጫን ሰብ ተሑቲጌ ኸኖ፤ ቢኸንም ሑቲ ቈጠሪ፤ የትዄተሎዪም ተብራጦ፤ ዘንጋዪም እክምትክም ኸነ። <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />ተሑቲም አንቌ፤ በሕዝቢ ቆጠራ ወክት ገሊላዊዪ ይሑዳ ተነሣም ብዠ ሕዝብ አሼፈተ፤ ይትዄተል ረከበም ባነ፤ ሑቲም ጠፋ፤ ተከታዮቸሑም ተብራጦ። <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />ስለኸነም ኧሗም ኧብሩሑዪ፦ ነዚሕኖ ሰቦች ግፍሮዮ፤ አትልግዶዮ፤ አሳበሕኖ ሜናሕኖም በሰብ በኸነ ይጠፋ፤ <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />በእዝጌር በኸነም ታጠፎዮዬ አትችሎ፤ ዛምኸም ተእዝጌርጌ ትትናከሶ ትትረከቦ ይኸን።”<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />ሕኖም ምክረሑ ተቌበሮም፤ የሐዋርያቲ አጤሮም አትጌረፎዮ፤ ዄታለኘም በኢየሱስ ሽም ኤዝነጎኸም ኤዘዞም ገፈሮዮ። <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />ሐዋርያትም፤ ስለሽመሑ ውርደት የወቀበር በወብቃሕኖ ተብላለቆም በጀᎈሪ ወጦም ወሮ፤ <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />ከነ በከነም፤ በቤተ መቅደስም ኸነ በቤት ተቤቲ፤ ኢየሱስ ሑቲ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">5፥42 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ</char></note> ወሕነሑ ተዋትመር ተወስብክም ስርም ታንቌዬ አምባሮ ባነ።<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s1">የሰበቲ ዳቆን ወትመጠር</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />የደቀ መዛሙርት ቁጥር ቲደብር በወረወ በዛ ወክት፤ በግሪክ ገኝ የቸኖ አይሑድ በይሑዳ ይነብሮ በነበሮዪ አይሑድ ᎈር ቁምቁሜ ባሮ፤ መሳሑም ከነ በከነሑ ቢሸከቲ ስንቅ የወሳድ ይሸክት ᎈር በሕኖ ጐሳ የኸኖ መበለቶች በጭ ቧርየማም ባነ። <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />ስለኸነም ዐሥረዄቲ ሐዋርያት እንጐዶቺ ደቀ መዛሙርት ቁናዬ ስበሰቦም እኪ ባሮ፤ “ኢና የማዳዪ አገልግሎት የዋስትናግድ ትንብርነ የእዝጌር ቃል አገልግሎት ወግፍር ኤይጌባነ። <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />ስለኸነም በጔታ ጐባቢት፤ ታሑ ግብት በመንፈስ ቅዱስ በብላትም የትᎀሎ ወሕነሕኖ የትምሰከረኖ ሰበት ሰብ መጥሮ፤ ዚ አላፊነት የሕኖ ኢብነዮ፤ <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />ኢናም በጠሎት በቃሊ አገልግሎት ኧጋደልነ።”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />ዚ ወበረሕኖ ይንመሕኖ አትብላለቀ፤ በእምነት በመንፈስ ቅዱስም የትመላዪ እስጢፋኖስ፤ ዛምኸም ፊልጶስ፤ ጵሮኮሮስ፤ ኒቃሮና፤ ጢሞና፤ ጰርሜናንም ተይሑዲነቴ ገባም የነበረዪ የአንጾኪያዪ ሰብ ኒቆላዎስ ሜጠሮ። <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />ነዚሕኖም አቸኖም በሐዋርያት ኢፍት አቀረቦዮ፤ ሕኖም በጤለዮ አንቌ ኧጀሕኖ ጫኖም ወሾመሕኖ አርጋገጦኖ።<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />የእዝጌርም ቃል ቲቤትት ወረ፤ የደቀ መዛሙርቲም ቁጥር በኢየሩሳሌም ስርም ቲደብር ወረ፤ በካሕናትም ብዠሕኖ የእምነት የታዘዞ ኸኖ።<verse eid="ACT 6:7" /></para>
  <para style="s1">የእስጢፋኖስ ወጠበጥ</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />በዛ ግዝየ እስጢፋኖስ ጸጋ ቆትም ተᎀላም በሕዝቢ ግብት ድንቅ ዘንጋዎች ታምራዊ ምልክቶችም ይሸክት ባነ። <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />“የነጣ ወጪዎች ምኩራብ”<note caller="+" style="f"><char style="fr" closed="false">6፥9 </char><char style="ft" closed="false">ምኩራብ ወበር የአይሑድ ጠሎት ቤት ወበሩ። ወይም ይስᎄሰቡᎄ አዳራሽ ወበሩ። </char></note> ቧሪም ይጠሬዪ ምኩራብ አባላት የኸኖ ተቀሬና ተእስክንድርያም ሰቦች፥ ተኪልቅያ ተእስያም አውራጃዎች የቸኖ ሰቦችም ተቃውሞ አትኔሦም የእስጢፋኖስ ይኦግቶይ ባነ። <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />የሕን አንኸንም ይዝነጊወ የነበረዪ ብላት መንፈስም ወቈቈም አንቻሎ። <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />ስለኸነም፤ “እስጢፋኖስ በሙሴ በእዝጌርም ᎈር የስድብ ቃል ቲዝነግ ሰማኔም” ይብሮ ሰቦች በሽሙቸ አዝጋዶᎄ። <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />በዚ ሐለት የሕዝቢ፤ የገኝ ባሊቆቺም የሕጊ አስተማሪዎቺ በዋንሠሣ፤ የእስጢፋኖስ አጤበጦም በአይሑድ ጀᎈር ኢፍት አቀረቦይ፤ <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />እኪ ባሮም ይምሰክሮ በባጢል ምስክሮችም አቈሞቦ፤ “ዚ ሰብ በዚ በትቄደሰዪ መደርም በሕጊ ᎈር የስድብ ቃል ወዘንጔሑ በፍጡም አንገፈረ፤ <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />መሳሑም ዚ የናዝሬቲ ኢየሱስ ዚ መደር ያጠፋኸም በሙሴ የቌበርነዪ ሤራ ይሸግርኸም ቲዝነግ ሰማኔም።” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />በጀᎈሪ ቾኖም የነበሮዪም እንም የእስጢፋኖስ ትክ ባሮም ቲምሌከቶይ ኢፍተሑ የመላይካ ኢፍት መሰረም ታዠኖ።<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s1">እስጢፋኖስ በጀᎈሪ ኢፍት የዝነጔን ንግግር</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />የካሕናት አለኦዪም የእስጢፋኖስ፤ “ዚ የቀረበብከ ክስ የኢኑ?” ቧረን።<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />እስጢፋኖስም እኪ ቲብር ዠበረ፦ በጔታ ጐባቢተና አቦቸናም! እንዴ ስሞኝ! አባና አብርሐም በካራን የወንብር ተወወረሑ ኢፍቴ ገና በመስጴጦምያ ትናነ የክብር አምላክ ተጐለጠነም፤ <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />ተገኛኸ ተጐሳኸም ተላይም እያ ትናቴዠኸ ገኜ ወር ቧረን።<note caller="-" style="x"><char style="xo" closed="false">7፥2-3 </char><char style="xt" closed="false"><ref loc="GEN 12:1">ዘፍ. 12፥1</ref>። </char></note> <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />ሑቲም በከለዳውያን ገኝ ወጣም በካራን ቾና። ተአᎄችም ወሙት አንቌ፤ ኧሗ አሑ ትነብሮᎄ ተዚዋኘ ገኜ አቸኘን።<note caller="-" style="x"><char style="xo" closed="false">7፥4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">ዘፍ. 11፥31</ref>፤ <ref loc="GEN 12:4">12፥4</ref>። </char></note> <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />የሕን አኸንም የግር ያቴርፉᎄ ቅጫ ርስት አናᎄን፤ ቢኸንም ዚ ገኝ የሑቲ ተሑቲም አንቌ የዘረሑ ርስት ሸከትም ይቡኸም ቃል ገቧነም ባነ፤ ዚ ቃል የገቧነዪም አብርሐም ገና ትኸ ቴይነቡር ባነ።<note caller="-" style="x"><char style="xo" closed="false">7፥5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">ዘፍ. 12፥7</ref>፤ <ref loc="GEN 13:15">13፥15</ref>፤ <ref loc="GEN 15:18">15፥18</ref>፤ <ref loc="GEN 17:8">17፥8</ref>። </char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />ኧሗም እዝጌር እኪ ባረም ዝነጔን፤ ዝሬታኸ ባለጋ ገኝ መጻተኘ ይኸን፤ አርበት መቶ ዓመትም በጉዙነት ሸከቶም በጭቆና ይገዞዮኸም ኤወደንም ባነ። <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />ቢኸንም በጉዙነት ይገዛኖዪ ሕዝብ እያ ኧሗም ኧቈጣን። በዛም ገኝ ወጦም በዚ መደር ያመልኮኝ።<note caller="-" style="x"><char style="xo" closed="false">7፥7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">ዘፀ. 3፥12</ref>። </char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />በዛም ጤበን ያወነᎄ ጉዳ አᎄን፤ አብርሐምም የይስሐቅ ጨኘ፤ በስሙታለኘዪም ከነ ጤበን አወናን። ይስሐቅም የያዕቆብ ጨኘ፤ ያዕቆብም የዐሥረ ዄቲ የነገድ አባ ጨኘ።<note caller="-" style="x"><char style="xo" closed="false">7፥8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">ዘፍ. 17፥10-14</ref>፤ <ref loc="GEN 21:2-4">21፥2-4</ref>፤ <ref loc="GEN 25:26">25፥26</ref>። </char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />የነገድ አባዎችም በዮሴፍ ቀኖም በጉዙነት ተግብጽ ገኜ አስሮይ፤ እዝጌርም ተሑቲጌ የነበረ ስለኸነ፤<note caller="-" style="x"><char style="xo" closed="false">7፥9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">ዘፍ. 37፥11</ref>፤ <ref loc="GEN 28">28</ref>፤ <ref loc="GEN 39:2">39፥2</ref>፤ <ref loc="GEN 21">21</ref>። </char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />ተመከራሑ እንም አወጣን፤ በግብጽ ንጉሥ በፈርዖን ኢፍት ሞገስ ብላትም አᎄን፤ ፈርዖንም በግብጽ በቤተ መንግሥተሑም እንም ᎈር አላፊ ሸከተም ሾመን።<note caller="-" style="x"><char style="xo" closed="false">7፥10 </char><char style="xt" closed="false"><ref loc="GEN 42:1-2">ዘፍ. 42፥1-2</ref>። </char></note> <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />በዛ ግዝየም በግብጽም በከነዓን ገኝ እንም፤ ወደል መከራ ያትዄተለ ጋጀ ቸኘ፤ አቦቸናም ይበሮይ ቃር ቀበጦ።<note caller="-" style="x"><char style="xo" closed="false">7፥11 </char><char style="xt" closed="false"><ref loc="GEN 42:1-2">ዘፍ. 42፥1-2</ref>። </char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />ያዕቆብም ኧሕር በግብጽ ወንብረሑ በሰማ ግዝየ፤ አቦቸናም የመጀመሪያ ግዝየ ተግብጽ ገኜ ላኸኖ፤ <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />የዄታለኘ ግዝየ ቲያሮ ኧሗም ዮሴፍ ሟንነተሑ የጐባቢተሑ ገለጠ፤ ፈርዖንም ስለዮሴፍ ዘመዶቸሑ ተሬዳ።<note caller="-" style="x"><char style="xo" closed="false">7፥13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">ዘፍ. 45፥1</ref>፤ <ref loc="GEN 16">16</ref>። </char></note> <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />በዛ አንቌ፤ ዮሴፍ ላኸም ያᎄች የያዕቆብም ሰባ አምስት ሰብ ይኸኖ ቤተ ዘመዶቸሑ እንም ይቸኖኸም ሸከተ።<note caller="-" style="x"><char style="xo" closed="false">7፥14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">ዘፍ. 45፥9-10</ref>፣<ref loc="GEN 45:17-18">17-18</ref>፤ <ref loc="GEN 46:27">46፥27</ref>። </char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />ያዕቆብ ተግብጽ ገኜ ወረደ፤ ሑቲም አቦቸናም በዛ ᎀቶ።<note caller="-" style="x"><char style="xo" closed="false">7፥15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">ዘፍ. 46፥1-7</ref>፤ <ref loc="GEN 49:33">49፥33</ref>። </char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />ሬሳሕኖም ተሴኬሜ ወሰጂም፤ አብርሐም በዔሞር ዴንጋ ᎈር በጠገራ ብር<note caller="+" style="f"><char style="fr" closed="false">7፥16 </char><char style="ft" closed="false">የጠገራ ብር ወበር በአይሑድ ባሕል በግሪኪ ቋንቋ ሲሊ</char></note> በስየን ቀብር ተቀበረ።<note caller="-" style="x"><char style="xo" closed="false">7፥16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">ዘፍ. 23፥3-16</ref>፤ <ref loc="GEN 33:19">33፥19</ref>፤ <ref loc="GEN 50:7-13">50፥7-13</ref>፤ <ref loc="JOS 24:32">ኢያ. 24፥32</ref>። </char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />እዝጌር የአብርሐም የገቧን ቃል ይትፌጠምወ ግዝየ ቲቀርብም፤ በግብጽ የነበረዪ የሕዝበና ቁጥር ቲደብር ወረ። <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />በዛ አንቌ የዮሴፍ ኤይሒር እንጐድ ንጉሥ በግብጽ ነገሠ።<note caller="-" style="x"><char style="xo" closed="false">7፥17-18 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">ዘፀ. 1፥7-8</ref>። </char></note> <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />ሑቲም የሕዝበና በተንኰለሑ አጬነቀ፤ ገና የጨኖ ሰብዬሕኖም ይᎀቶዬ ተወረጀዬ አወጦም ያድጎዮኸም ግድ ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">7፥19 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">ዘፀ. 1፥10-11</ref>፤ <ref loc="EXO 22">22</ref>። </char></note> <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />በዛ ግዝየ ሙሴ ተጨኘ፤ ሑቲም በእዝጌር ኢፍት ሞገስ የረከበ ይደንቅ ሰብዬ<note caller="+" style="f"><char style="fr" closed="false">7፥20 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ተራ ትኸ አነበረ</char></note> ባነ። ባᎄችም ቤት ሦስት መሬት በወንክባከብ ላቀ።<note caller="-" style="x"><char style="xo" closed="false">7፥20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">ዘፀ. 2፥2</ref>። </char></note> <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />ተውጪዬም ባደጒ ግዝየ የፈርዖን ገረድ ረከበችም ወሰደቹ፤ የነብሴታን ትኸኸም ሸከተችም አለቀቹ።<note caller="-" style="x"><char style="xo" closed="false">7፥21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">ዘፀ. 2፥3-10</ref>። </char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />ሙሴም የግብጻውያን ብላት እንም ተማረ፤ በንግግረሑም በሜናሑም የብረታ ኸነ።<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />ሙሴ አርባ ዓመት በዀነን ግዝየ፤ የጐባቢተሑ የእስራኤል ዴንጋ ይጉበኜ በሒነሑ ኤሰበ።<note caller="-" style="x"><char style="xo" closed="false">7፥23-29 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">ዘፀ. 2፥11-15</ref>። </char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />ተጐባቢተሑም አቲ በአት ግብጻውያን ሰብ ቲትቤደል ቲገፋም አዠም ረዳን፤ የገፋሚ በወበቀል ግብጻዊዪ ወካም ቈጠረን። <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />ጐሣውታም እዝጌር በሑቲ ኧጅ ነጣ ያወጣኖኸም ያጥራምቶ ᎀሰረንም ባነ፤ ሕኖም አናጥራመቶ። <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />የመናጊም ኧሗም ዄት እስራኤላውያን ቲጣሎ ሰላ፤ ያታርቆዬም ሸም፤ ሰቦች፤ አሑ እኮ ጐባቢትንኩ፤ ምንኸም ነብስ በነብሳሑ ትትጉዳዶ? ባረኖ። <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />በመርየሑ ᎈር በደል ቲሰላ ያነዪ ሰብም፤ የሙሴ ግᎈተረንም እኪ ባረ፤ አኸ ፈራጅ ሸከተም ቢና ᎈር የሾመናኸ ሟኒ? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />ኧጌሽ ትራማ ግብጻውያን የቈጠርኰንኸም ይያም ትቀጥሬዬ ትሸ? <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />ሙሴም ዚ በሰማኸም ሰኴም በምድያም ገኝ መጻተኘ ኸነም ቾና፤ በዛዬም ዄት ዴንጋ ጨኘ።<note caller="-" style="x"><char style="xo" closed="false">7፥29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">ዘፀ. 18፥3-4</ref>። </char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />ታርባ ዓመት አንቌ፤ በሲና ቈቶ ጭጭሳ ባነዪ በረሐ፤ ቢነድ ቁጥቋጦ በኧሳት ለበን ውስጥ መላዪካ ተጐለጠነ። <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />ሙሴ ባዠን ቃር ተዴነቀ፤ ዘንጋዪ የዋጣራ ተዛዬ ቲቀርብ የጔታ ጣምባ ሰማ፤ <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />እያ ያቦቻኸ አምላክ፤ የአብርሐም፤ የይስሐቅ፤ የያዕቆብ አምላክንኩ ቲብር ሰማ። ሙሴም በጊናት ተመላ፤ የወትመልከትም አንደፈረ። <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />ጔታም እኪ ቧረን፤ የግራኸ ጫማ አውጣ፤ የቆምከወ መደር የትቄደሰ አፈሩ። <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />በግብጽ ያነዪ የሕዝበኛ መከራ የኢንም አዠሑም፤ የጭንቅ ውታሕኖ ሰማሑም፤ አተርፎዬ ወረድኩም። ኧሗም ኔኸ፤ ተግብጽ ገኜ ዠበርኩም ኧለክኸ።<note caller="-" style="x"><char style="xo" closed="false">7፥30-34 </char><char style="xt" closed="false"><ref loc="EXO 2:14">ዘፀ. 2፥14</ref>። </char></note><verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />ኧጌሽ ነዛሕኖ፤ ገዢ ፈራጅም ሸከተም የሾመናኸ ሟኒ? ባሮም የገረጦዪ የዚ ሙሴ እዝጌር በቁጥቋጦዪ ውስጥ በታዠን መላዪካ መሳ ገዢ ነጣ አውጪም ሸከተም ተሕኖዬ ላዀን። <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />ሑቲም መራም በግብጽ አወጣኖ፤ በግብጽ፤ በብሻ ባርም በበረሐ አርባ ዓመት ድንቅ ቃሮችም ታምራዊ ምልክቶች ሸከተ።<note caller="-" style="x"><char style="xo" closed="false">7፥36 </char><char style="xt" closed="false"><ref loc="EXO 7:5">ዘፀ. 7፥5</ref>፤ <ref loc="EXO 14:21">14፥21</ref>፤ <ref loc="NUM 14:33">ዘሑ. 14፥33</ref>። </char></note> <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />“የእስራኤልም ሕዝብ፣ ‘እዝጌር ይያኸም ያነ ነብይ በግብታሑ ያትኔሳንኩ’ የባረኖ ሙሴ ባነ።<note caller="-" style="x"><char style="xo" closed="false">7፥37 </char><char style="xt" closed="false"><ref loc="DEU 8:15">ዘዳ. 8፥15</ref>፤ <ref loc="DEU 18">18</ref>። </char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ሑቲም በሲና ቈቶ በዝነጔን መላይካም ተአቦቸናጌ በበረሐ በሕዝቢ ጀᎈር ግብት ባነ፤ የሕይወትም ቃል ቲናዬ የዋችላልፍ ተቌበረ።<note caller="-" style="x"><char style="xo" closed="false">7፥38 </char><char style="xt" closed="false"><ref loc="DEU 5:1-33">ዘዳ. 5፥1-33</ref>። </char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“አቦቸናም ተቃወሞይ አንከንም ይታዘዞዬ ያንሸዎ ስለኸነ በሒነሕኖ ተግብጽ ገኜ ተዠበሮ። <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />አሮንም፤ ‘ኢፍት ኢፍተና ያሮ አማልክት ሰክትንነ፤ በግብጽ ገኝ መራም ያወጣነ ዛ ሙሴ ምን የሰላወኸም አንሒርነ’ ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">7፥40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">ዘፀ. 32፥1</ref>። </char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />በዛ ግዝየ የደግ ምስያ ሸከቶም፤ የጣዖት መሥዋዕት አቀረቦ፤ በጀሕኖም ሜና ተብላለቆ፤ ፍነጠዞ።<note caller="-" style="x"><char style="xo" closed="false">7፥41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">ዘፀ. 32፥2-6</ref>። </char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />እዝጌርም ተሕኖ ዞር ባረ፤ ያመልኮዮዬ የሰሜ ኰኰቦች አቸለፈም አበኖ፤ ዚም በነብዮች መጽሐፍ እኪ ቧሪም በጣፈዪ መሠረት ተፌጠመ፤</para>
  <para style="q1" vid="ACT 7:42">“‘አሑ የእስራኤል ቤት፤</para>
  <para style="q2" vid="ACT 7:42">ያረጂ እንሰሳ መስዋዕትም አርባ ዓመት በበረሐ ባነሑ ግዝየ፤</para>
  <para style="q2" vid="ACT 7:42">መስዋዕትም መባ ይያ አቀረብኩኒ?<verse eid="ACT 7:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="ACT 7:43" />ጠበጥኩም የወርኩዪ የሞሎክ ድንኳን</para>
  <para style="q2" vid="ACT 7:43">ሬፋንም ይቡሪዪ የአምላካሑ ኰኰብ ምስያ ባነ፤</para>
  <para style="q2" vid="ACT 7:43">ሕኖም በጃሑ ሸከትኩም</para>
  <para style="q2" vid="ACT 7:43">ትሰግዶኖ የነበሮዪ አማልክትኖ።</para>
  <para style="q1" vid="ACT 7:43">እያም ተባቢሎን ዛዘር ትሰደዶኸም ኧሸክት።’<note caller="-" style="x"><char style="xo" closed="false">7፥43 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">አሞ. 5፥25-27</ref>። </char></note><verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“እዝጌር የሙሴ ባቴዠን ንድፍም ቤዘዘን መሠረት የሸኰቺዪ የምስክር ድንኳን፤ ተአቦቸናጌ በበረሐ ባነ። <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />አቦቸናም የድንኳኒ በቌበሮ አንቌ፤ እዝጌር በኢያሱ መሪነት ያሳደደኖዪ የአሕዛብ ገኝ በወረሶ ግዝየ ጠበጦይም ገቦ፤ የዳዊትም ዘበን ስን በአፈረሑም ቾና፤<note caller="-" style="x"><char style="xo" closed="false">7፥45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">ኢያ. 3፥14-17</ref>። </char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />ዳዊትም በእዝጌር ኢፍት ሞገስ ረከበም የያዕቆብ አምላክ የእዝጌር ያድርወ ይኸን ቤት የወሰክት በጠሎት ጮቀሰ።<note caller="+" style="f"><char style="fr" closed="false">7፥46 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">የያዕቆብ ቤት </char><char style="ft" closed="false">ይብር። </char></note><note caller="-" style="x"><char style="xo" closed="false">7፥46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2 ሳሙ. 7፥1-16</ref>፤ <ref loc="1CH 17:1-14">1 ዜና 17፥1-14</ref>። </char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />ቢኸንም ያድርወዪ ቤት የሸኰተነ ሰሎሞን ባነ።<note caller="-" style="x"><char style="xo" closed="false">7፥47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 ነገ. 6፥1-38</ref>፤ <ref loc="2CH 3:1-17">2 ዜና 3፥1-17</ref>። </char></note><verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“የሕን አንኸንም፤ ንቅ እዝጌር የሰብ ኧጅ በሸኰተን ቤት ውስጥ ኤነብር፤ ዚም ነብዪ እኪ በቧረን መሠረቱ፤<verse eid="ACT 7:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="ACT 7:49" />‘ሰሜ ዙፋነኛው፤</para>
  <para style="q2" vid="ACT 7:49">አፈርም የግረኛ ያᎈይወው፤</para>
  <para style="q1" vid="ACT 7:49">ኧጌ ምንኸማት ቤት ትሸክቶኒ? ይብር ጔታ፤</para>
  <para style="q2" vid="ACT 7:49">ወይሽ አᎈይወ ይኸኔ ኤቲዋኘ መደሩ?<note caller="-" style="x"><char style="xo" closed="false">7፥49-50 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">ኢሳ. 66፥1-2</ref>። </char></note><verse eid="ACT 7:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="ACT 7:50" />ዚ እንም የሸኰተን ኧጀኛ አንከነ?’<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“አሑ ሒናሑ እንዝናሑም ጤበን ያናውኔ፤ አንገተ ደንዳናዎች ልክ ያቦቻሑኸም የመንፈስ ቅዱስ እንጌ ትቃወሞ።<note caller="-" style="x"><char style="xo" closed="false">7፥51 </char><char style="xt" closed="false"><ref loc="ISA 63:10">ኢሳ. 63፥10</ref>። </char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />በነብዮችም ግብት አቦቻሑ ያናሳደዶይ ሟ ነነ? የጻድቂ ወተኝ በደሮም የዝነጎዪ ቀጠሮም፤ አሑም ኧሗ አቸለፍኩም አብኩይ፤ ቀጠርኩይም፤ <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />በመላይካ መሳ ያቡኩዪም ሕጊ ተቌበርኩም አንከነም አንቂየሑይ።”<verse eid="ACT 7:53" /></para>
  <para style="s1">እስጢፋኖስ ብምን ተወጋም ᎀተ</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />በጀᎈሪ ስብሰባ ᎈር ያኖዪም ዚ በሰሞ ግዝየ ስርም ማቶ የወቅጥር፤ ከንፈረሕኖ ነከሶᎄ። <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />እስጢፋኖስም በመንፈስ ቅዱስ ተᎀላም ተሰሜዬ ትክ ባረም ቲምሌከት፤ የእዝጌር ክብር፤ ዛምኸም ኢየሱስ በእዝጌር ከነ ቈመም አዠም፤ <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />“ዘ፤ ሰሜዎች ተከፈቶም፤ የሰብ ትኸም በእዝጌር ከነ ቈመም አዥ” ባረ።<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />በዛ ግዝየ በወደል ጣምባ ው ቲብሮ፤ እንዝነሕኖ ኤፎም ሑቲ ታነወዬ ቁናዬ ሮጦ፤ <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />ጠበጦም በከተማዪ ውጪ አደጎይ፤ ብምንም ወጎይ። ምስክሮችም ልባሰኽኖ ሳውል በቧሪ ጎልማሳ ኧግር ᎀረ አወኖ። <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />እስጢፋኖስም ቲወጎይ ትናነ፤ “ጔታ ኢየሱስ፤ ነብስያኛ ተቀበር” ባረም ጤለየ፤ <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />ተንብረከከም፤ በወደል ጣምባ “ጔታ! ዚ አጢያት አትቁጥርቦ” ባረም ው ባረ፤ ዚም ባረም ᎀተ።<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s1">የአማኞች ስደት ወትበተንም</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />ሳውልም በእስጢፋኖስ ወቀጠር ተስማማም ባነ፤ በዛ ከነ በኢየሩሳሌም ባነዪ ቤተ ክርስቲያን ᎈር ወደል ስደት ተነሣ፤ ተሐዋርያት አንኸንም አማኞች እንም ተይሑዳ ተሰማርያም አውራጃዎቼ እንም ተቤተኖ፤<verse eid="ACT 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 8:2" />በመንፈሳዊ ቃር የትጋደሎ ሰቦችም የእስጢፋኖስ ቀበሮይ፤ ኧሗምም ስርም በኮነ።<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />ሳውልም ቤተ ክርስቲያን የዋጥፋ ታገደም ተነሣ፤ በቤት ተቤቴ በወግባም ገሜዎች እንሽታዎችም ሻበም አወጣም ተወሕኔ ቤቴ ይኸራኖ ባነ።<verse eid="ACT 8:3" /></para>
  <para style="s1">ፊልጶስ በሰማርያ ወንጌል ወስብከሑ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />የትቤተኖዪም በወሮᎄ እንም ቃሊ ሰበኮ፤ <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />ፊልጶስም ታት የሰማርያ ከተማዬ ወረደም ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">8፥5 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ</char></note>ሰበከኖ። <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />ብዠ ሕዝብም ፊልጶስ የዝነጔኒ ቲሰሞም የሸኰተኒም ታምራዊ ምልክቶች ቲያዞ፤ ቁና ሒን ኸኖም ይሰሞይ ባነ። <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />ሩክሲ<note caller="+" style="f"><char style="fr" closed="false">8፥7 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቡሼ</char></note> መናፍስትም ው ቲብሮ በብዠ ሰቦች ወጦ፤ ብዠ ጅረዎች የሽናወሎዪም ፈያ ኸኖ፤ <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />በዛ የትነሣም በከተማዪ ወደል ብልቃት ኸነ።<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />ቢኸንም ተዚ ኢፍቴ በከተማዪ ውስጥ ሸጐረነት ቲሸክት የሰማርያ ሰቦች እንም ያትጌረመ፤ ሲሞን ይቡሪ አት ሰብ ባነ፤ ሑቲም ነብሰሑ የወደል ሰብኸም ይቆጥር ባነ። <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />ትንስ ንቅ ስን ያነዪ ሰብ እንም፤ “ዚ ሰብ ‘ወደሊ ቆት’ በወበር ይትኴሪ መለኮታዊ ቆቱ” በወበር ያዳምጦይ ባነ፤ <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />ተብዠ ግዝየ ቀረሰም በሸጐረነት ሜናዪ ያትጌረመኖ ስለኸነም በዋጥራምት ይትዄተሎይ ባነ። <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />ቢኸንም ፊልጶስ ስለእዝጌር መንግሥት ስለኢየሱስ ክርስቶስም ሽም የሰበከኖዪ አመኖም በወቀበረሕኖ ገሜዎች እንሽታም አመኖም ተጠመቆ፤ <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />ነብሰሑ ሲሞን ቴይቀይ አመነም ተጠመቀ፤ የፊልጶስም ተዄተለም ወረ፤ ይሸኩቺ ምልክትም ወደል ታምራት አዠም ተጌረመ።<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />በኢየሩሳሌም የነበሮዪ ሐዋርያት የሰማርያ ሰቦች የእዝጌር ቃል ወቀበረሕኖ በሰሞ ግዝየ፤ ጴጥሮስ ዮሐንስም ተሕኖዬ ላሖዮ። <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />ሕኖም ሰማርያ በሰሎ ግዝየ መንፈስ ቅዱስ ይቌበሮኸም የሰማርያ ሰቦች ጤለዮኖ፤ <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />መሳሑም በዛ ግዝየ በጔታ ኢየሱስ ሽም ተጠመቆም ባነ አንኸንም ገና መንፈስ ቅዱስ ባትመሕኖም ᎈር አወረደ ባነ። <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />ስለኸነም ጴጥሮስ ዮሐንስም ኧጀሕኖ ጫኖቦ፤ ሕኖም መንፈስ ቅዱስ ተቌበሮ።<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />ሲሞንም ሐዋርያት ኧጀሕኖ ቢጨኖቦ ግዝየ መንፈስ ቅዱስ ይᎅኸም አዠም፤ ዋጋ አቸኘኖም እኪ ባረኖ፤ <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“ኧጀኛ ኧጨንወ ሰብ እንም መንፈስ ቅዱስ ይቌበርኸም ዚ ስልጣን ይያም ናሞኝ።”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />ጴጥሮስም እኪ ቧረን፤ “የእዝጌር ስጦታ በዋጋ የወሰየ ኤሰብከም፤ አኸም ዋጋኻም ቁናዬ ጥፎ! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />ሒናኸ በእዝጌር ኢፍት ቅን ያንከነ ስለኸነ፤ አኸ በዚ አገልግሎት ሟናኸም ዕድል ፋንታ ኤነናኸ። <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />ኧሗም ስለኸነዪም በቡሼነታኸ ንስሐ ግባ፤ ተጔታዬም ጠልይ፤ የሟንᎀሑ ዚ የሒናኸ አሳብ አፉ ይብርከ ይኸን፤ <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />መሳሑም አኸ በምሬት ቅናት ተᎀላኸም፤ በዐመጥ ሰንሰለት ተጠበጥከም አዥከ።”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />ሲሞንም ዠበረም፤ “በዝነጔሑዪ አትም ቃር ኤሰላቢኸም የጔታ ጮቅሶኒ” ባረኖ።<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />ጴጥሮስ ዮሐንስም የጔታ ቃል በምሰከሮ ገለጦም በዝነጎ አንቌ፤ በብዠ የሰማርያ መንደሮች ወንጌል ቲሰብኮ፤ ተኢየሩሳሌሜ ተዠበሮ።<verse eid="ACT 8:25" /></para>
  <para style="s1">ፊልጶስ ኢትዮጵያዊዪም ጃንደረባ</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />የጔታም መላዪካ የፊልጶስ፤ “ተንሳም በደቡብ አዘር በኢየሩሳሌም ተጋዛዬ ቢያወርዲ በበረሐዪ ኤማ ወር” ቧረን፤ <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />ሑቲም ተነሣም ወረ። ዘ የኢትዮጵያ መንግሥት የሕንደኬ ባለሟልም የዱሬሽነት ዱኒያ እንም አዛዥ የኸነ አት ኢትዮጵያዊዪ ጃንደረባ ረከበ። ዚም ሰብ ይሰግዴ ተኢየሩሳሌሜ ቸኘም ባነ። <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />ሑቲ ተገኘዄ ቲዠበር በሠረገላ ቾናም የነብዪ የኢሳያስ መጽሐፍ ያነብ ባነ። <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />መንፈስም የፊልጶስ፤ “ወር፤ ተዛ ሠረገላዬ ቅረብ” ቧረን። <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />ፊልጶስም አቴከለም ተሠረገላዬ ወረ፤ ጃንደረባዪም የነብዪ የኢሳያስ መጽሐፍ ቲያነብ ሰማም፤ “ወሕነሑ፤ ታነቡᎅዪ ታጥራሙች?” ቧረን። <verse eid="ACT 8:30" /><verse number="31" style="v" sid="ACT 8:31" />ጃንደረባዪም፤ “ያትሬዴ ሰብ ቴይነብር ምንኸም ሸከትኩም አጥራምት?” ቧረን፤ ሑቲም ተሠረገላዪዬ ወጣም ተሑቲጌ ይቾናኸም የፊልጶስ ጮቈሰን። <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />ጃንደረባዪ ያነብ የነበረዪ የመጽሐፍ ክፍል ዚ ባነ፤</para>
  <para style="q1" vid="ACT 8:32">“የጤኸም ቲያርጂዬ ሰጀጂ፤</para>
  <para style="q2" vid="ACT 8:32">የጤ ጠᎄት ድገረሑ ቲያርጭ እንቁስ ይብርኸም፤</para>
  <para style="q2" vid="ACT 8:32">ዛምኸም አትም አንዘጔ።<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />ነብሰሑ በዋትዋርደሑ፤ ፍርድም አናᎅ፤</para>
  <para style="q2" vid="ACT 8:33">ሕይወተሑ በዚ አፈር ወሰጂ፤</para>
  <para style="q2" vid="ACT 8:33">ስለጨኘተሑ ሟ ይዝነጌ ይችል?”<note caller="-" style="x"><char style="xo" closed="false">8፥32-33 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">ኢሳ. 53፥7-8</ref>። </char></note><verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ጃንደረባዪም ዠበረም የፊልጶስ፤ “ነብዪ ዚ ይዝነግ ስለሟው? ስለነብሰሑ፤ ወይሽ ስለእንጐድ ሰቡ? ታውሽ አውዴ” ቧረን። <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />ፊልጶስም ወዘንግ ቀረሰ፤ ተዚ ተኢሳያስ መጽሐፍ ቀረሰም ስለኢየሱስ ወንጌል ሰበኰነ። <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />በወወር ᎈር ትናኖም ኧጋ ባነወ መደር ሰሎ፤ ጃንደረባዪም፤ “ዘ፤ ኧጋ በዚ ነነ፤ ኧጌሽ አንጠመቅኸም ይኸትሬ ምን ቃር ነነ?” ቧረን።<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />ፊልጶስም፤ “በፍጡም ሒናኸ ባመንከ ወጠመቅ ትችል” ቧረን። ጃንደረባዪም፤ “ኢየሱስ ክርስቶስ የእዝጌር ትኸ የኸነኸም አምን” ቲብር ዠᎄረነ፤<note caller="+" style="f"><char style="fr" closed="false">8፥37 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ 37 ይደብሮ፤ የድረ የጎጋ ጡሑፍም ኤይደብሮ። </char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />ሰረገላዪም አትቈመም፤ በዛም ዄቲ ተሑቲጌ ተጋዬ ወረዶ፤ ፊልጶስም የጃንደረባዪ አጠᎀቈን።<note caller="+" style="f"><char style="fr" closed="false">8፥38 </char><char style="ft" closed="false">አታት ቅጂዎች ዚ ቁጥር ኤይደብሮ። ባታት የቁርብ ግዝየ ቅጂዎች የትወሰደው። </char></note> <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />በኧጋዪ በወጦ ግዝየ፤ የጔታ መንፈስ የፊልጶስ ነጠቀም ወሰደን፤ ጃንደረባዪም በዛ አንቌ አነዠን፤ ቢኸንም ተብላለቀም ኤማውታን ወረ። <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />በዛም አንቌም ፊልጶስ በአዞጦን ታዠ፤ ቂሣርያ ይሰላ ስን፤ ቢቸለፍወዪ ከተሞች እንም ወንጌል ይሰብክ ባነ።<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s1">የሳውል ወምን</para>
  <para style="r">(<ref loc="ACT 22:6-16">ሐዋ. 22፥6-16</ref>፤ <ref loc="ACT 26:12-18">26፥12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />ሳውልም የጔታ ደቀ መዛሙርት የወቅጥር ኧሗም ቲዘት ተካሕናት አለአዬ ወረ፤ <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />የጔታም ኤማ ይትዄተሎዪ ገሜዎቺም ኸኖ እንሽታዎቺ በዛ ቲረሕብ አገደም ተኢየሩሳሌሜ የወውስድ ይችልኸም፤ በደማስቆ የነበሮዪ ምኲራቦች ደብዳቤ ይᎅኸም የካሕናት አለኦች ጮቈሰን።<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />ደማስቆ የወስላ ቀል ቲቈይን ብራን በሰሜ ሒንጌም በዙራሑ አንብራጣ፤<verse eid="ACT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 9:4" />ሑቲም ባፈር ᎈር ወጠቀ፤<note caller="+" style="f"><char style="fr" closed="false">9፥4 </char><char style="ft" closed="false">ባፈር ᎈር ወጠቀ ወበር በፈረዝ ወይም በንጐድ ቃር ተሌገመም ወውጥቀሑ ያቴዥ ወበሩ። </char></note> በዛ ግዝየም “ሳውል፤ ሳውል፤ የመአር ታሳድዴ?” ይብር ጣምባ ሰማ።<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />ሳውልም፤ “ጔታ፤ አኸ ሟንከ?” ቧረን።</para>
  <para style="p" vid="ACT 9:5">ሑቲም እኪ ቧረን፤ “እያማ አኸ ታሳድዴ ኢየሱስንኩ።<note caller="+" style="f"><char style="fr" closed="false">9፥5 </char><char style="ft" closed="false">አታት በግሪክ ቋንቋ የድረ መጽሐፎች “ይወጐᎄዪ ብረት ታንቌዬ ብትገፋ አኸ ነብሳኸ ትጎዳን” ይብሮ፤ በምራ. 9፥6 ᎈር ዠበረም ሳውል በወገና አንጉደጐደንም በወደነቅ “ጔታኛ! ምን ኧሸክትኸም ትወድ?” ቧረን ይብር ይደብሮ ዚም በምራ. 22፥10፤ 26-14 ᎈር ተጣፈም ይትረከብ። </char></note> <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />ኧሗም ተንሳማኸ ተከተማዬ ግባ፤ ትሸኩቼ ይጌባሐዪም ይውጅከ።”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />ተሳውልጌ ያሮ የነበሮዪም ሰቦች ጣምባሑ ቲሰሞ የሟንም ባነዞ ግዝየ፤ ድነበጦም እንቁስ ባሮም ቈሞ። <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />ሳውልም በወጠቀወ ተነሣም ዔነሑ ቲከፍት አትም ወዥ አንቻለ፤ ስለኸነም ሰቦቺ ኧጀሑ ጠበጦም መሮም ተደማስቆ ከተማዬ ወሰዶይ። <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />ሦስት ከነም ወዥ አንቻለ፤ ኧሕር ኧጋም አንቀመሰ።<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />በደማስቆ ሐናንያ ይቡሪ አት ደቀ መዝሙር ባነ፤ ጔታም በመና፤ “ሐናንያ” ባረም ጠራን። ሑቲም፤ “ጔታ፤ ዝምንኩ” ባረ።<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />ጔታም እኪ ቧረን፤</para>
  <para style="p" vid="ACT 9:11">“ተነሣም ‘ቀጥ የባረ ጐዳና’ በቧሪዪ ኤማ ይሑዳ ተቧሪ ሰብ ቤቴ ወር፤ በዛዬም ሳውል ይቡሪ አት የጠርሴስ ሰብ ይጤልዩ ሴን፤ <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />መሳሑም ሐናንያ ይቡሪ ሰብ ሑቲ ታነወዬ ቸኘም ኧጀሑ ይጨንወኸም ዔነሑ ይከᎈትነኸም በመና ሳውል አዠ።”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />ሐናንያም ዠበረም እኪ ቧረን፤ “ጔታ፤ ዚ ሰብ በኢየሩሳሌም ባኖዪ ቅዱሳኖቻኸ ᎈር ምን ቅጫ ጉዳት ያሰላኸም በብዠ ሰብ ሰማሑም፤ <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />ተዚዬም የቸኘዪ ሽማኸ ይጠሮዪ እንም የወግድ የካሕናት አለኦች ሥልጣን ተቌበረም።”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />ጔታም እኪ ቧረን፤</para>
  <para style="p" vid="ACT 9:15">“ወር፤ ዚ ሰብ በአሕዛብ በነገሥታትም ኢፍት ዛምኸም በእስራኤል ሕዝብ ኢፍት ሽመኛ ይጮርኸም የትሜጠረ ግብረኛው፤ <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />እያም ስለሽመኛ ምን ቅጫ መከራ ወበር ያነወኸም አቴዥን።”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />ሐናንያ ወረም፤ ተቧሪዪ ቤቴም ገባ፤ በሳውልም ᎈር ኧጀሑ ጫነም፤ “ጐቤኛ ሳውል፤ ተዚዬ ትትቸኝ ቤማ ᎈር የትገለጠንከ ጔታ ኢየሱስ፤ ዔናኸ ያዥከም፤ በመንፈስ ቅዱስም ትትᎀላኸም ይያም ላሔም” ቧረን። <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />ሒንጌም በሳውል ዔን ᎈር ሐና ይመስር ቃር ወጠቀ፤ ዠበረም ወዥ ቻለ፤ ተነሣም ተጠመቀ፤<verse eid="ACT 9:18" /></para>
  <para style="s1">ሳውል በደማስቆ በኢየሩሳሌም</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 9:19" />ስንቅም በናም ብረታ፤ ሳውል በደማስቆ ተነበሮዪ ደቀ መዛሙርትጌ የቀል ከነ ቾና።<verse eid="ACT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />ሒንጌም፤ ኢየሱስ የእዝጌር ትኸ ወሕነሑ በምኩራብ ምኩራበሕኖ ወስብክ ቀረሰ።<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />የሰሞዪም እንም በወገረም፤ ዚ ሰብ “በኢየሩሳሌም ዚ የኢየሱስ ሽም ይጠሮዪ ቲያጠፋ የነበረ አንከነ? ኧሗም ተዚዬ የቸኘ የሕኖ አገደም ተካሕናት አለኦቼ ይወስዶዬ አነበረ?” ባሮ።<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />ሳውልም ቲብረታ ወረ፤ በደማስቆ ይነብሮዪ አይሑድ ኢየሱስ ሑቲ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">9፥22 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ</char></note>ወሕነሑ ማስረጃ ቲያቀርብ ይብሮይ ቃር ያቄብጦ ባነ።<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />ተብዠ ከነ አንቌ፤ አይሑድ የሳውል የወቅጥር ተማከሮ፤<note caller="-" style="x"><char style="xo" closed="false">9፥23-25 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2 ቆሮ. 11፥32-33</ref>። </char></note> <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />ሑቲም እቅደሕኖ ሐረም ባነ፤ ሕኖም ይቀጥሮዬ የከተማዪ ወዝገቦች ክናን ተምሳር ይቅሮ ባነ፤ <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />የሑቲ ተከታዮችም በምሳር የነብሰሑ ደቀ መዛሙርት የሳውል በከተማዪ ግንብ ኧጭር ጉድ አሾለኮም በቀርጫት አወረዶይ።<verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />ሳውል ተኢየሩሳሌሜ በቸኘ ግዝየ፤ ተደቀ መዛሙርትጌ የወቅላቀል ሞከረ፤ ሕኖም የኢንም ደቀ መዝሙር ወሕነሑ ያነመኖ ስለኸነ እንም ጔኖይ። <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />የሕን አንኸንም በርናባስ ወሰደም ተሐዋርያቴ አቸኘን፤ ሳውልም በጋዠሑ ᎈር ትናነ የጔታ ምንኸም ያዠንኸም፤ ጔታም ምንኸም የዝነጔንኸም ዛምኸም በደማስቆም የኢየሱስ ሽም ምንኸም በድፍረት የሰበከኸም ኤወደኖ። <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />ስለኸነም ሳውል ተሕኖጌ ቾና፤ በኢየሩሳሌምም ይዥዋወር በጔታም ሽም በድፍረት ይዝነግ ባነ። <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />በግሪክ ገኝ ተቸኖዪ አይሑድጌ ቲዝነግ፤ ይኦግት ባነ፤ ሕኖም ይቀጥሮዬ ግጅላ ይሸክቶ ባነ። <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />አማኞች ዚ በሐሮ ግዝየ፤ ተቂሣርያ ከተማዬ አወረዶም ተጠርሴሴ ያርኸም ሸከቶ።<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />በዛ ግዝየ በይሑዳ፤ በገሊላ በሰማርያም ያነዪ ቤተ ክርስቲያን በሰላም ወንብር ቀረሰ፤ ተጥናከረም። ኧሗም የእዝጌር በወገና ቲዥባበርም በመንፈስ ቅዱስ ቲይጥናና በቁጥር ቲበዛ ወረ።<verse eid="ACT 9:31" /></para>
  <para style="s1">ጴጥሮስ በልዳ በኢዮጴ የሸኰተን ሜና</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />ጴጥሮስም ተገኝ ገኜ ቢዥዋወርወ ግዝየ፤ በልዳ ይነብሮዪ ቅዱሳን ይጉበኜ ወረደ። <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />በዛዬም ስሙት ዓመት ሙላ በአልጋ ᎈር የገደረ ኤንያ ይቡሪዪ ጅረ ረከበ። <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />ጴጥሮስም፤ “ኤንያ፤ ኢየሱስ ክርስቶስ ፈያ ይሸክትከ፤ ተንሣም የገደርከወዪ ንሣ” ቧረን። ኤንያም ሒንጌም ብድግ ባረ። <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />በልዳ በሳሮናም ይነብሮዪ እንም የሑቲ አዞም የጔታ አመኖ።<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />በኢዮጴ ጣቢታ የቧርያ አት ደቀ መዝሙር ባነች፤ የሽሜታም ትርጉም በግሪክኛ ዶርቃ<note caller="+" style="f"><char style="fr" closed="false">9፥36 </char><char style="fq" closed="false">ጣቢታ </char><char style="ft" closed="false">በአረማይክ ቲኸን </char><char style="fq" closed="false">ዶርቃ </char><char style="ft" closed="false">ኧሗም በግሪኪ፤ ትርጉመሑም </char><char style="fqa" closed="false">ፌቆ </char><char style="ft" closed="false">ወበሩ። </char></note> ትርጉሚም ጊምቤ ወበሩ፤ ሒቲም ፈያ ቃር ወሰክት እንጌ የዜጋ ዋቢ ምሽት ባነች፤ <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />በዛ ግዝየም ታቌችም ᎀተች፤ ሰቦች ሬሳዬታን አጠቦም በሰገነት ᎈር ባነዪ ክፍል አወኖያ። <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />ልዳ ከተማ የኢዮጴ ከተማ ቁርቤ የነበረ ስለኸነ፤ ደቀ መዛሙርቲም ጴጥሮስ በልዳ ወሕነሑ በሰሞ ግዝየ፤ ዄት ሰብ ላሖም፤ “ታውሽ አተክልም ቲናዬ ኔኸ” ቲብሮይ ጮቀሶይ። <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />ጴጥሮስ ተነሣም ተሕኖጌ ወረ፤ ዛዬ በሰላ ግዝየም ሰገነት ᎈር ታነዪ ክፍሌ አወጦይ። መበለቶቺም እንም ዶርቃ ተሕኖጌ በነበረትወ ግዝየ የሸከተቶዪ ቀሚሶች ልባሶችም ቲያቴዘማይ ዙራውታን ኸበበማም ይበኸማ ባነ። <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />ጴጥሮስም ይንም ተክፍሊ አትዌጣም ተንብረከከም ጤለየ፤ ተሬሳሚዬ ዦር ባረ፤ “ጣቢታ፤ ተንሸ” ባረ። ሒቲም ዔኔታን ከፈተች፤ የጴጥሮስም ባዠች ግዝየ ቀና ባረችም ቾናች። <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />ሑቲም ኧጄታን ጠበጠም ነሣና፤ አማኞች መበለቶችም ጠራም ተሕይወቴታንጌ አትሬከበኖ። <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ዚም ዘንጋ ብንም ኢዮጴ ተዄረ፤ ብዠ ሰቦችም በጔታ አመኖ። <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />ጴጥሮስም ስምዖን ቲቡሪዪ ባት መንተ ፋቂጌ በኢዮጴ ብዠ ከነ ቾና።<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s1">ቆርኔሌዎስ የጴጥሮስ አጤራን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />ቂሣርያ፤ የኢጣልያ ክፍለ አርብ ቢቡሪዪ ቡድን ሰራዊት ውስጥ የመቶ አለአ የኸነ ቆርኔሌዎስ የቧሪ አት ሰብ ባነ። <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />ሑቲም ትንም አበሮሰሑጌ በመንፈሳዊ ዘንጋ የትጋደለ የእዝጌር ይጔና፤ የሰቦች ስርም ምጽዋት ይብ፤ እንጌ ተእዝጌሬ ይጤልይ ባነ። <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />አት ከነ፤ በክናኒ ዠጠ ሰዓት ቅጫ የእዝጌር መላዪካ በመና ተሑቲዬ ቸኘም፤ “ቆርኔሌዎስ!” ቲቡን ቢልቢጢጦ አዠ።<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />ቆርኔሌዎስ በወደንብጥ ትክ ባረም ቲያዥን፤ “ጔታ፤ መአሩ?” ቧረን።</para>
  <para style="p" vid="ACT 10:4">መላዪካዪ እኪ ቧረን፤ “ጠሎታኸ ምጽዋታኸም ይዜገድወዬ ተእዝጌር ኢፍቴ ዐረገም። <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />ኧሗም ሰቦች ተኢዮጴ ከተማዬ ላሕማኸ ጴጥሮስም የቧሪዪ የስምዖን ይቸኝኸም ሰክት፤ <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />ሑቲም በባሪ ᎀረ ባነዪ መንተ ቢፈቂ በስምዖን ቤት በባዘናነት አᎈኘም።” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />ቆርኔሌዎስም፤ ያዝናጔኒ መላዪካ ተላኘንም በወረ አንቌ፤ ተአገልጋዮቸሑ ዄቲ፤ ዛምኸም በመንፈሳዊ ዘንጋ የትጋደለ የሑቲ ታማኝ የኸነዪም አቲ ወታደር አጤራን፤ <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />የኸነዪም ዘንጋ እንም ቤወደኖ አንቌ ተኢዮጴዬ ላኸኖ።<verse eid="ACT 10:8" /></para>
  <para style="s1">ጴጥሮስ ያዠን መና</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />የላሑዮዪም ሰቦች የመናጊ ተከተማዬ በቀረቦኸም፤ ጴጥሮስ ስድስት ሰዓት ቅጫ ቲኸን፤ የወጠልይ ተፎቄ ወጣ። <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />በዛ ግዝየም የጓደን ስለኸነ ይᎄሬ ቃር ሸ፤ ስንቅ ቲዝጋጅም ትናነም ሸለብ አᎄኘንም በወትመሰጥ ውስጥ ኸነ፤ <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />ሰሜዪም ተከፈተም አት ወደል ጨርቅ ይመስር ቃር ባርበቲ ማዘን ተጠበጠም ታፈሬ ቲወርድ አዠ። <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />በጨርቂም ᎈር አርበት ኧግር ያነኖ የትልያዮ እንሰሳ፤ በአፈር ይሸቦ ቅስስን ነብሳት በአየር ይበሮ አንፉም ባኖᎄ። <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />በዛ ግዝየ፤ “ጴጥሮስ፤ ተንሣም፤ ነዚሕኖ ኧርድም ብራ” ይብር ጣምባ ተሑቲዬ ቸኘ።<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />ጴጥሮስም “ጔታ፤ ዚማ ኤይኸን፤ እያ ያነጣ ወይ ሩክስ ቃር ስርም በናሑም አንሒር” ባረ።<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />ዛም ጣምባ ዠበረም የዄታለኘ ግዝየ ተሑቲዬ ቸኘም፤ “እዝጌር ንጡ የሸኰተኒ አኸ የሩክስኸም አትቆጥር” ቧረን። <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />ዚም ሦስት ግዝየ ተድጋገመ፤ ጨርቂም ሒንጌም ተሰሜዬ ወሰጂ።<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />ጴጥሮስም ስላዠን መና ትርጉም ስርም ተጨነቀም በዋውጣ በዋውርድ ᎈር ትናነ፤ ቆርኔሌዎስ የላኸኖ ሰቦች የስምዖን ቤት ሸዎም በረከቦይ አንቌ በወረጀ ቈሞም ባነ፤ <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />ጣምባሕኖ ከፍ አበኖም ጴጥሮስ የቧሪዪ ስምዖን በዛዬ ያነኸም ተሳሎ።<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />ጴጥሮስ የመናዪ ዘንጋ በዋውጣ ብዋውርድ ᎈር ትናነ መንፈስ ቅዱስ እኪ ቧረን፤ “ዘ፤ ሦስት<note caller="+" style="f"><char style="fr" closed="false">10፥19 </char><char style="ft" closed="false">አት የድረ ቅጂ </char><char style="fqa" closed="false">ዄት </char><char style="ft" closed="false">ይብር፤ እንጐዶቺ የድረ ቅጂዎች ዚ ቁጥር ኤነኖ። </char></note> ሰብ ይሸዎከ፤ <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />ስለኸነም ተንሳም ውረድ፤ የላክሕኖዪም እያ የኸንኩ ስለኸነ ታትጥራጠር ተሕኖጌ ወር።” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />ጴጥሮስም ወረደም፤ “ዘ፤ ትሸዎይ ሰብ እያትንኩ፤ የቸኘሑᎄ ወባጀ መአሩ?” ባረኖ። <verse eid="ACT 10:21" /><verse number="22" style="v" sid="ACT 10:22" />ሰቦቺም፤ “የቸኘነ ቆርኔሌዎስ በቧሪ መቶ አለአዬው፤ ሑቲም ጻድቅ የእዝጌርም ይጔና፤ በአይሑድም ሕዝብ እንሜ የትከበረ ሰቡ። ያኸ ተቤተዄ ያቼኘኸኸም ትቡኒ ይሰማኸም ቅዱስ መላዪካ ኤወደንም” ባሮይ። <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />ጴጥሮስም የሰቦቺ ያስትናግዶዬ ተቤተዄ አገባኖም። ጴጥሮስም የመናጊም ተነሳም ተሕኖጌ ወረ፤ በኢዮጴ የቸኖ አታት ጐባቢትም ተሑቲጌ ወሮ፤<verse eid="ACT 10:23" /></para>
  <para style="s1">ጴጥሮስ በቆርኔሌዎስ ቤት</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 10:24" />ቢቄጥሊ ከነ ቂሣርያ ገባ። ቆርኔሌዎስም ዘመዶቸሑም የቁርብ ደቦዎቸሑ ስበሰበም ይቂየኖ ባነ። <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />ጴጥሮስም ተቤተዄ ወረጀ በሰላ ግዝየ ቆርኔሌዎስ ተቌᎄረን፤ በግረሑም ᎈር ወጠቀም ሰጐደነ። <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />ጴጥሮስም፤ “እያ ያኻኸም ሰብንኩ ተንሣ!” ባረም ነሣን።<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />ጴጥሮስም ቲያዝናግንም ተሑቲጌ ቲገባ ብዠ ሰብአተስበሰቦም ረከበ፤ <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />እኪም ባረኖ፦ “አይሑዳዊ የኸነ ሰብ ትንጐድ ሕዝብጌ ይትገገዝከም ተቤተዄም የወግባ ተአይማኖተና ሕጊ ኤይፈቀድኸም አሑ ነብሳሑ ቲሒሮ፤ ቢኸንም እያ ሟንም ንጡ ወይ ሩክስ ያንከነኸም እዝጌር ገለጠኒም፤ <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />ስለኸነም በጠራሑ ግዝየ፤ ዘ ታናምነታ ቸኘሑ፤ ኧጌሽ የመአር የጠራሑኝኸም ወሐር ኧሸ።”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />ቆርኔሌዎስም እኪ ቧረን፤ “ተአርበት ከነ ኢፍቴ በዚ ግዝየ በከነዪ ዠጠ ሰዓት በቤተኛ ኸንኩም ኧጤልይ ባነ፤ ድንገትም ያምብራጣ ልባስ የለበሰ ሰብ ቸኘም ቢፍተኛ ቈመም <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />እኪም ባሬ፤ ‘ቆርኔሌዎስ፤ ጠሎታኸ ተሴማንከም፤ ምጽዋታኸም ይቴሰቡᎄዬ በእዝጌር ኢፍት ሰላም። <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />ሰቦቺ ተኢዮጴዬ ላሕም ጴጥሮስ የቧሪዪ የስምዖን አቸኘን፤ ሑቲም በባር ᎀረ ባነዪ በመንተ ቢፈቂ በስምዖን ቤት በባዘናነት አᎈኘም።’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />እያም ሒንጌም መልክተኞቺ ታኸዬ ላኸክብከ፤ አኸም በወተኛኸ ፈያ ሸከትኸም፤ ኧጌሽ ኢና እንመና ጔታ ዬዘዘናኸዪ ትቲውድነ የወስማ በእዝጌር ኢፍት ነነ።”<verse eid="ACT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />ጴጥሮስም እኪ ቲብር ወዘንግ ቀረሰ፤ እዝጌር የሟንም ኤያዳላኸም የኢንም ተሬዳሑም፤<note caller="-" style="x"><char style="xo" closed="false">10፥34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዘዳ. 10፥17</ref>። </char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />ቢኸንም የሑቲ ይጔኖዪ ጽድቅም ይሸክቶዪ እንም ቤቲዋኘም ጐሳ ቢኸኖ ይቌበሮ። <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />እዝጌር የእስራኤል ሕዝብ ቃለሑ ወላከሑ የትኴረው፤ ብንም ጔታ በኢየሱስ ክርስቶስ መሳም ሰላም ቲሰብክ የቸኘዪም የሑቲቱ። <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />ዮሐንስ በሰበኰኒ ጥምቀት አንቌ ተገሊላ ቀረሰም ብንም ይሑዳ የኸነዪ ቲሒሮ፤<verse eid="ACT 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 10:38" />እዝጌር የናዝሬቲ ኢየሱስ በመንፈስ ቅዱስ በሓይልም ቀቧን፤ ሑቲም እዝጌር ተሑቲጌ የነበረ ስለኸነ በሰላወ መደር እንም ፈያ ቲሸክት በዳቡሎስ ሥልጣን ተት የነበሮዪ እንም ፈያ ሸከተ።<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />“ሑቲ በአይሑድ ገኝም በኢየሩሳሌም የሸኰተን እንም ኢና ምስክሮችንነ፤ ኧሗም ሰቦች የሑቲ በጨ ᎈር ሰቀሮም ቀጠሮይ። <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />እዝጌርም በሦስታለኘዪ ከነ በሞት አትኔሣንም፤ ይታዥኸም ሸኰተን፤ <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />የታዠዪም ይንም ሰብ ቴይኸን፤ በሞት በትነሳ አንቌ ኢና ተሑቲጌ የበናነ የሰጨነም፤ እዝጌርም በደረም የሜጠረነ ይና የምስክሮቺው። <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />የሕዝቢ ኧሰብክነኸም በሕያዋንም በሟቾቺም ᎈር ወፍርድ እዝጌር የሾᎀን ሑቲ ወሕነሑ ኧምሰክርነኸም ሑቲ ነብሰሑ ኤዘዘነ፤ <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />በሑቲ ያምን እንም በሽመሑ ያጢያት ስርየት ይቌበርኸም ነብዮች እንም ይምሰክሮነ።”<verse eid="ACT 10:43" /></para>
  <para style="s1">አሕዛብ መንፈስ ቅዱስ ወቀበረሕኖ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />ጴጥሮስ ዚ ቲዝነግ ትናነ፤ ቃሊ በሰሞዪ እንም ᎈር መንፈስ ቅዱስ ወረደቦ። <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />ተጴጥሮስጌ የቸኖዪ፤ ጤበን ታወነዮዪ ደቦ የኸኖዪ አማኞች፤ የመንፈስ ቅዱስ ስጦታ በአሕዛብም ᎈር ኧሗም ወፍስሰሑ ቲያዞ ተጔረሞ፤ <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />መሳሑም በልሳን<note caller="+" style="f"><char style="fr" closed="false">10፥46 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ብንጐድ ቋንቋዎች</char></note> ቲዝነጎም የእዝጌር ቲያምሰግኖ የሰሞዮ ስለኸነው። በዛ ግዝየ ጴጥሮስ እኪ ባረ፤ <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“ነዚሕኖ ሰቦች ይናኸም መንፈስ ቅዱስ የቌበሮ ስለኸነ፤ ኧጌሽ በኧጋ ኤይጠመቆኸም ይኸትሮ ሟኒ?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />ስለኸነም በኢየሱስ ክርስቶስ ሽም ይጠመቆኸም ኤዘዘኖ። በዛ አንቌ፤ ጴጥሮስ ቀል ከነ ተሕኖጌ ይቾናኸም ጮቀሶይ።<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">ጴጥሮስ አሕዛብ ቤት የመአር ገባ?</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />ሐዋርያት በይሑዳ የነበሮዪም በጔታ ጐባቢት አሕዛብ ኧሗም የእዝጌር ቃል የቌበሮኸም ሰሞ። <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />ስለኸነም ጴጥሮስ ኢየሩሳሌም በወጣ ግዝየ፤ ጤበን ታወነዮዪ ጐሣ የነበሮዪ አማኞች ገረጦይ፤ <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />እኪም ባሮይ፤ “የመአር ጤበን ታናውነዮ ሰቦቼ ገባኸም ተሕኖጌ በናኸ።” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />ጴጥሮስም እኪ ቲብር ዘንጋዪ በዋፍታታ ያትሬዳኖ ቀረሰ፤<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />በኢዮጴ ከተማ ትንጤልይ በወትመሰጥ ውስጥ ትናነሑ መና አዠሑ፤ ወደል ጨርቅ ይመስር ቃር፤ ባርበቲ ማዘን ተጠበጠም በሰሜ እያ ታነሑወ መደሬ ቲወርድ አዠሑ። <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />ጡጥ ባሑም ዚ ዘንጋ ትንምሌከት አርበት ኧግር ያነኖ እንሰሳ፤ የድብር አውሬ፤ በአፈር ይሸቦ ቅስስን ነብሳት አንፉዎችም አዠሑ። <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />በዛ ግዝየ፤ ጴጥሮስ፤ ተንሣም ኧርድም ብራ ይብሬዪ ጣምባ ሰማሑ። <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />እያም፤ ጔታ፤ ዚማ ኤይኸን፤ እያ ሩክስ ወይ ያንትቀደሰ ቃር ስርም ታፈኛዬ ቡየም አንሒር ባሑ። <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />ዛም ጣምባ ዄታለኘ፣ እዝጌር ንጡ የሸኰተኒ አኸ የሩክስኸም አትቆጥር ቲብር በሰሜ ዝነጔ። <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />ዚም ሦስት ግዝየ ተድጋገመ፤ በዛም እንም ዠበረም ተሰሜዬ ተወሰደ። <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />ልክ በዛም ሰዓት፣ ሦስት ሰብ ቂሣርያ ቲያዬ ተላሖም ቸኖም እያ ባነሑወ ቤት ወረጀ ᎈር ቈሞ፤ <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />መንፈስ ቅዱስም አትም ታናውላውል ተሕኖጌ አርኸም ኤወዴ። ነዚሕኖም ስድስት በጔታ ጐባቢት የኸኖ ቲያጌ ወሮ፤ ተምሲ ቤቴ ገባነ። <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />ሑቲም መላዪካዪ በቤተሑ ውስጥ ቈመም የታዠንኸም እኪ የቧረንኸም ኤወደነ፤ ተኢዮጴ ከተማዬ ሰብ ላክም ጴጥሮስ የቧሪዪ ስምዖንም ይቸኝኸም ሸኰተን፤ <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />ሑቲም አኸም የቤታኸ ሰቦች እንም ትተርፎᎄዪ ቃል ይውደኸ። <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />“እያም ገና ወዘንግ ትንቀርስ፤ መንፈስ ቅዱስ፤ በመጀመሪያ ቢና ᎈር የወረደኸም እንም በሕኖም ᎈር ወረደ። <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />በዛ ግዝየ፤ ‘ዮሐንስ በኧጋ አጠመቀ፤ አሑም በመንፈስ ቅዱስ ትጠመቆ’ ቲብር ጔታ የዝነጔኒ ቃል ተዜገዴ። <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />ኧጌሽ እዝጌር በጔታ በኢየሱስ ክርስቶስ ትናምነ ይና ያበነዪም ስጦታ የሕኖም ባበኖ፤ ኧጌ፤ የእዝጌር ወቈቈም ኧችል እያ ሟኒኩ?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />ዚ በሰሞ ግዝየም ይብሮዪ ቀበጦም እኪ ቲብሮ የእዝጌር አምሰገኖ፤ “ዚማ በኸነ፤ አሕዛብም ተሕይወቴ ይቸኖዬ፤ እዝጌር ንስሐ አበኖም ወበሩዋ።”<verse eid="ACT 11:18" /></para>
  <para style="s1">በአንጾኪያ የነበረዪ ቤተ ክርስቲያን</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />እስጢፋኖስ ወጔም በᎀተ ግዝየ በትነሣዪ ስደት መሳ የትቤተኖዪ አማኞች ቃሊ የአይሑድ ጠለለ ቲዝነጎ ፊንቄ ቆጵሮስም አንጾኪያ ስን ወሮ፤<note caller="-" style="x"><char style="xo" closed="false">11፥19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">ሐዋ. 8፥1-4</ref>። </char></note> <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />በቆጵሮስ በቀሬናም የቸኖ አታት ሰቦችም ተአንጾኪያዬ ወሮም የግሪክ ደበሮም በዋውድ የጔታ የኢየሱስ ወንጌል ሰበኮኖ <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />የጔታም ኧጅ ተሑቲጌ ባነ፤ ቁጥረሕኖም ስርም ብዠ የኸኖ ሰቦች አመኖም ተጔታዬ ተዠበሮ።<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />ኦጀዪም በኢየሩሳሌም በነበረዪ ቤተ ክርስቲያን እንዝን ሰላ፤ ቤተ ክርስቲያኒም የበርናባስ ተአንጾኪያዬ ላዀን። <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />ሑቲም ዛዬ ሰላም እዝጌር በጸጋውታን የሸኰተኒ ባዠ ግዝየ ተብላለቀ፤ እንም በፍጡም ሒን በጔታ በወታመን ይጠኖኸም መከረኖ። <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />ሑቲም መንፈስ ቅዱስ እምነትም የትᎀላ ሱት ሰብ ባነ፤ ቁጥረሑ ብዠ የኸነ ሕዝብም ተጔታዬ ተደበረ።<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />በዛ አንቌ በርናባስ፤ የሳውል የወሴ ተጠርሴሴ ወረ፤ <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />በረከᎄንም ግዝየ ተአንጾኪያዬ አቸኘን። ዄቲም በዛዬ ታነዪ ቤተ ክርስቲያንጌ በወሰብስብ ቁና ዓመት ሙላ ስርም ብዠ ሕዝብ አትመሮ፤ ደቀ መዛሙርትም የመጀመሪያ ግዝየ በአንጾኪያ ክርስቲያን ቧርዮም ጠረዮ።<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />በዛ ግዝየ አታት ነብዮች ተኢየሩሳሌም ተአንጾኪያዬ ወረዶ፤ <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />ተሕኖም አቲ አጋቦስ የቧሪዪ ተነሳም በዓለም እንም ቡሼ ጋጀ ይኸንኸም መንፈስ ቅዱስ አትምሌኰተንም ዝነጔ፤ ዚም በቀላውዴዎስ ቄሣር ዘበን ተፌጠመ።<note caller="-" style="x"><char style="xo" closed="false">11፥28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">ሐዋ. 21፥10</ref>። </char></note> <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />ደቀ መዛሙርትም እያታተሕኖ ዐቅመሕኖ በፈቀደ ቅጫ አዋጦም በይሑዳ ይነብሮዪ በጔታ ጐባቢት የወርዳ ዌሰኖ፤ <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />እርዳታዪም በበርናባስ በሳውልም ኧጅ የቤተ ክርስቲያን መሪዎች ላሖ።<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">ጴጥሮስ በወሕኔ ቤት በታምር ወጣ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />በዛ ዘበን ንጉሢ ሔሮድስ አታት የቤተ ክርስቲያን አባሎች ጠበጠም ቲያግድ ቲያሳድድም ያጬንቅ ባነ፤ <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />የዮሐንስም ጐቤ ያዕቆብ በሰይፍ አትቌጠረን። <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />ዚ ዘንጋሑ የአይሑድ ያትብላለቀኖኸም ባዠ ግዝየ፤ የጴጥሮስ ኧሗም አጤᎄጠን፤ ዚም የኸነዪ በቂጣ በዓል<note caller="+" style="f"><char style="fr" closed="false">12፥3 </char><char style="ft" closed="false">የቂጣ በዓል ወበር አይሑዳውያን በግብጽ በዋተክል የወጦᎄ ቂጣ የበኖᎄ በዓል በዋስብ ሙ ወበሩ። </char></note> ከነ ባነ። <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />የጴጥሮስ ወሕኔ ቤት በዀናን አንቌ፤ አርበት አርበት ወታደር ቲኸኖ ይቅሮይኸም፤ በአርበት ፈረቃ የትሜደቦ ወታደሮች አትሬከᎄን፤ ዚ የሸኰተኒም የፋሲካ በዓል በቸለፈ አንቌ ሕዝብ ኢፍት አወጣም ያትፌርድወዬ ኤሰበሙ። <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />ጴጥሮስም በዚ መሠረት በወሕኔ ቤት አደጒ፤ ቤተ ክርስቲያኒም ስለ ሑቲ አቆመረም ተእዝጌሬ ይጤልይ ባነ።<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />ሔሮድስም የጴጥሮስ በሕዝቢ ኢፍት ያቀርᎆ ኤሰበም ትናነ፤ ጴጥሮስ በዛም ምሳር በዄት ሰንሰለት ታገደም፤ በዄት ወታደር ግብት ተገደረም ባነ፤ የወሕኔ ቤት ይቅሮዪም በወሕኔ ቤቲ በር ᎈር ቈሞም ባነ። <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />የጔታ መላዪካ ሒንጌም ታዠ፤ በክፍሊም ውስጥ ብራን በራ፤ መላዪካዪ የጴጥሮስ ሜጠቅ ወካም ቁሰቈሰንም፤ “አተክልም ተንሳ!” ቧረን፤ በዛ ግዝየ ሰንሰለቶቸሑ በጆቸሑ ወጠቆ። <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />መላዪካዪ፤ “ልባሳኸም ልበስ፤ ጫማኸም ኧግድ” ቧረን። ጴጥሮስም ዬዘዘንኸም ሸከተ፤ መላዪካዪ ቄጠለም፤ “ነጠላኸ ልበስም ተኸተሌ” ቧረን። <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />ጴጥሮስም ተዄተለንም በወሕኔ ቤት ወጣ፤ ቢኸንም መና ያዥ ᎀሰረንም አንኸንም መላዪካዪ ይሸኩች ቃር የኢን ወሕነሑ አንካረ ባነ። <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />የመጀመሪያዪ ዄታለኘዪም ዘብ ተቸለፎም ተከተማዪዬ ቢወስዲ ኤማ ᎈር ታነዪ የብረት ወዝገቤ ሰሎ። የጭር ወዝገቢም ነብሰሑ ሐረም ተከፈተኖም፤ ሕኖም ወጦም ወሮ፤ አት አቋጭ ኤማ የቼለፎኸም ሒንጌም በድንገት መላዪካዪ ተላኘን።<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />ጴጥሮስም ተቀልበዄ ተዠበረም፥ “ጔታ የመላይካዪ ላኸም ተሔሮድስ ኧጅ አይሑድም ቤሰቦቢ እንም ያወጤኸም ኧሗ ያለ ወጥራጠር ሐርኩ!” ባረ።<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />ዚ ባርጋገጠ አንቌ ብዠ አማኞች ቁናዬ ተስበሰቦም ቲጤልዮᎄዪ ተማርያም ቤቴ ወረ፤ ዚዬታም ማርያምም ማርቆስ የቧሪዪ የዮሐንስ ዳኮ ባነች። <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />ጴጥሮስ ዛዬ ሰላም የወረጀዪ ወዝገብ በቅበቀበ ግዝየ ሮዳ የቧርያዪ አት የቤት ሜነተኘ ሟ የኸነኸም የዋጣራ ተወዝገቢዬ ወረች። <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />የጴጥሮስ ጣምባ ወሕነሑ በሐረች ግዝየ ተብልቃቴታ ብዛት የትነሳ ወዝገቢም ታትከፍት ሮጠችም ተውስጤ ቡየችም “ጴጥሮስ በወታᎈ ቈመም!” ትትብር ዝነጔች። <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />ሕኖም “ቴሰስሽም!” ባሮያ። ሒቲም “የኢንም ሑቲቱ!” ትትብር አርጋገጠች፤ ሕኖም ኧጌሽ “የሑቲ ይቅየ መላዪካ ይኸን” ባሮ።<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />ጴጥሮስም ወዝገቢ ወቀብቅበውታ ደበረ፤ ሕኖም ወዝገቢ ከፈቶም ባዞይ ግዝየ ተጌረሞ። <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />ሑቲም እንቁስ ይብሮኸም በጀሑ ጠቀሰም፤ ኢየሱስ በወሕኔ ቤት ምንኸም ያትዌጣንኸም ኤወደኖም “ዚ ዘንጋ የያዕቆብ የቀኖዪ ምዕመናንም አውዶ” ባረኖ። ተላኘኖም ትንጐድ መደሬ ወረ።<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />የመናጊም ቅረር ወታደሮቺ፤ “ጴጥሮስ ኤቴ ገባ?” ቲብሮ በግብተሕኖ ወደል ትርምስ ተኸለቀ። <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />ሔሮድስም የጴጥሮስ አሸሸም በቀᎄጠን ግዝየ፤ ዘብ ይቅሮዪ በዋቆምር በምረመረ አንቌ ይቀጥርዮኸም ኤዘዘ። በዛም ሔሮድስ ተይሑዳ ቂሣርያ ወረደም በዛዬ ቾና።<verse eid="ACT 12:19" /></para>
  <para style="s1">የሔሮድስ አሟሟት</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />ሔሮድስ ተጢሮስ ተሲዶናም ሰቦችጌ መናክሰኘ ባነ፤ በገኘሕኖ ስንቅ ይትረከቢ በንጉሢ ግዛት የነበረ ስለኸነ፤ የንጉሢ ባለሟል የብላስጦስ ድጋፍ በረከቦ አንቌ፤ ቁናዬ ኸኖም ተንጉሢጌ የወታረቅ ተሣሎ።<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />በቀጠሮዪ ከነ ሔሮድስ ልባስ መግሥተሑ ለበሰም በዙፋነሑ ᎈር ቾና፤ የሕዝቢ ንግግር ሸከተ። <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />ሕዝቢም፤ “ዚሽ የአምላክ ጣምባው አንኸንም የሰብ ጣምባ አንከነ” ባሮም ው ባሮ። <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />ሔሮድስም የእዝጌር ክብር ያናበ ስለኸነ የጔታ መላዪካዪ ባሸ አደገወም ሒንጌም በችረ ተበናም ᎀተ።<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />የእዝጌር ቃልም ቲለቅ ቲቤትትም ወረ። <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />በርናባስ ሳውልም አገልግሎተሕኖ ፌጠሞም በኢየሩሳሌም ተአንጾኪያዬ<note caller="+" style="f"><char style="fr" closed="false">12፥25 </char><char style="ft" closed="false">አታት ቅጂዎች ተኢየሩሳሌሜ ይብሮ። </char></note> ተዠበሮ፤ ማርቆስ የቧሪዪ ዮሐንስም ተሕኖጌ ጠበጦይም ቸኖ።<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s1">በርናባስ ሳውልም በመንፈስ ቅዱስ ወትመጠረሕኖ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />በአንጾኪያ ባነዪ ቤተ ክርስቲያን ነብዮች አስተማሪዎችም ባኖ፤ ሕኖም፦ በርናባስ፤ ኔጌር የቧሪዪ ስምዖን፤ የቀሬናዪ ሉክዮስ፤ የአርበታለኘዪ ክፍል ገዢ የሔሮድስ ቁናዬ ይለቅ የነበረዪ ምናሔ ሳውልም ባኖ። <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />ሕኖም የጔታ ቲያግለግሎ ቲጦሞም ትናኖ፤ መንፈስ ቅዱስ፤ “በርናባስ ሳውልም እያ የሜጠርኩኖዪ ሜና ላኖኒ” ባረ።<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />ሕኖም በጦሞም በጤለዮም አንቌ ኧጀሕኖ ጫኖቦም በሾሞዮ አንቌ ጌገቶዮ።<verse eid="ACT 13:3" /></para>
  <para style="s1">በርናባስ ሳውልም በቆጵሮስ</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />በርናባስ ሳውልም በመንፈስ ቅዱስ ተላሖም ተሴሌውቅያዬ ወረዶ፤ በዛም አንቌ በመርከብ ተቆጵሮሴ ወሮ። <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />ሰላሚስ ከተማ በሰሎም ግዝየ በአይሑድ ምኩራቦች የእዝጌር ቃል ሰበኮ፤ ዮሐንስም ተሕኖጌ ኸነም ያግዞ ባነ።<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />በቆጵሮስ ከተማ በጋ የትከበበ ደሴት ተጥግ ጥግ አቋረጦም ጳፉ ደሴት ስን በሰሎ ግዝየ፤ በርያሱስ የቧሪ አት አይሑዳዊ ሸጐረ ባጢለተኘ ነብይ ረከቦ፤ <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />ሑቲም ሰርግዮስ ጳውሎስ ቲቡሪዪ አጥራማች ገኝ ገዢጌ ባነ። ዚ ገኝ ገዢዪ፤ የእዝጌር ቃል የወስማ ሸም በርናባስ፤ የሳውልም አጤራኖም። <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />ሸጐረዪ ኤሊማስ የሽመሑ ትርጉም እኪ ባነ፤ ገኝ ገዢዪ ኤያምንኸም ቈፋ የወሕን የሸ ስለኸነ ተቃወመኖ። <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />ጳውሎስ የቧሪዪ ሳውል በመንፈስ ቅዱስ ተᎀላም፤ ትክ ባረም ተምሌኰተንም እኪ ቧረን፤ <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“አኸ የጽድቅ እንም መሶ፤ ተንኰል ቡሼነትም እንም የትᎀላኸ የዳቡሎስ ትኸ የጔታ የቃና ኤማ ተዋጣም አታᎈይ? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />ኧሗም የጔታ ኧጅ ያኸ ይቀጣኸዬው፤ ወዥ ኤይችል ትኸን፤ ተሗ አንቌ የጬት ብራን የቀል ግዝየም አታዥ።” ሒንጌም ጭጋግ ጨለማም በᎈረሑ ወረደ፤ ኧጀሑ ጠበጠም ይᎀራንም ሰብ የወሴ ተዛዬ ተዚዬ ይብር ቀረሰ። <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />ገኝ ገዢዪም የኸነዪ ዘንጋ ባዠ ግዝየ፤ በጔታ ትምርት በወደነቅ አመነ።<verse eid="ACT 13:12" /></para>
  <para style="s1">በርናባስ ጳውሎስም በጲስድያ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />ጳውሎስ መራርቾቸሑም ተጳፉ ተነሶም ተጵንፍልያ ቲትረከቢዬ ተጴርጌዬ ወሮ፤ ዮሐንስም ተሕኖ ተላኘም ኢየሩሳሌም ተዠበረ። <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />ሕኖም በጴርጌ ተነሦም በጲስድያ ውስጥ ታነዬ ተአንጾኪያዬ ወሮ፤ በሰምበት ከነም ተምኩራቤ ገቦም ቾኖ። <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />በእዝጌር ኤማ የሙሴ ያᎅ ሕጊ የነብዮችም መጽሐፍ በትነበቦ አንቌ፤ የምኩራቢ አለኦች፤ “ጐባቢቶች፤ የሕዝቢ ይመክር ቃል ባነናሑ ዘንጎ” ቲብሮ ላሖቦ። <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />ጳውሎስም ተነሣም በጀሑ በወጥቅስ እኪ ባረ፤ የእስራኤል ሰቦች፤ ኧሗም አሑ የእዝጌር ትጔኖ እንም፤ ስሞ። <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />የዚ የእስራኤል ሕዝብ አምላክ፤ አቦቸናም ሜጠረኖ፤ በግብጽ ገኝ ቲነብሮም ከፍ ከፍ አበኘኖ፤ በወደል ቆተሑም አወጣኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">ዘፀ. 1፥7</ref>፤ <ref loc="EXO 12:51">12፥51</ref>። </char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />አርባ ዓመት ቅጫም በበረሐ ፈረኸኖ<note caller="+" style="f"><char style="fr" closed="false">13፥18 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ተንክባከበኖም </char><char style="ft" closed="false">ይብሮ። </char></note><note caller="+" style="f"><char style="fr" closed="false">13፥18 </char><char style="fqa" closed="false">ፈረኸኖ፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “ተንክባከበኖ” ይብሮ። </char></note>፤<note caller="-" style="x"><char style="xo" closed="false">13፥18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">ዘሑ. 14፥34</ref>፤ <ref loc="DEU 1:31">ዘዳ. 1፥31</ref>። </char></note> <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />በዛም አንቌ በከነዓን ገኝ ሰበት መንግሥት አጠፋም የሕኖ አፈር አወረሰኖ፤<note caller="-" style="x"><char style="xo" closed="false">13፥19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">ዘዳ. 7፥1</ref>፤ <ref loc="JOS 14:1">ኢያ. 14፥1</ref>። </char></note> <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />ዚም እንም የትፌጠመዪ በአርበት መቶ አምሳ ዓመት ቅጫ ግዝየ ውስጥ ባነ።<note caller="-" style="x"><char style="xo" closed="false">13፥20 </char><char style="xt" closed="false"><ref loc="JDG 2:16">መሳ. 2፥16</ref>።</char></note> በዛ አንቌ፣ ተነቢዪ ሳሙኤል ዘበን ስን መሳፍንት አበኖ።<verse eid="ACT 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 13:21" />በዛም ሕዝቢ ንጉሥ ያነግስኖኸም ጮቀሶይ፤ እዝጌርም ተብንያም ጐሳ፤ የቂስ ትኸ ሳኦል አበኖ፤ ሑቲም አርባ ዓመት ገዛኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 ሳሙ. 8፥5</ref>፤ <ref loc="1SA 10:21">10፥21</ref>። </char></note> <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ሳኦልም በሻረን አንቌ፤ የዳዊት አነገሠኖ፤ ስለሑቲም፤ ቲምሰክር፦ የሒነኛ የኸነኸም እያ ኧሸኒ እንም ይሸክት የእሴይ ትኸ የዳዊት ረከብኩን ቲብር ዠᎄረነ።<note caller="-" style="x"><char style="xo" closed="false">13፥22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 ሳሙ. 13፥14</ref>፤ <ref loc="1SA 16:12">16፥12</ref>፤ <ref loc="PSA 89:20">መዝ. 89፥20</ref>። </char></note> <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />በዚ ሰብ ዝሬት እዝጌርም በገቧን ቃል መሠረት ተዚ ሰብ ዘር ያተርፍ የእስራኤል ያተርፍ የኢየሱስ አትኔሳኖ። <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />ኢየሱስ ተወተኘሑ ኢፍቴ፤ ዮሐንስ የእስራኤል ሕዝብ እንም ንስሐ ገቦም ይጠመቆኸም ሰበከኖም ባነ።<note caller="-" style="x"><char style="xo" closed="false">13፥24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">ማር. 1፥4</ref>፤ <ref loc="LUK 3:3">ሉቃ. 3፥3</ref>። </char></note> <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />ዮሐንስ የትላኸወዪ በዋጥናቅ ᎈር ትናነ፤ እያ ሟ መሰረኩሑም? እያ ሑቲ አንኸንኩ፤ ቢኸንም የግረሑ ጫማ ወፍታ ኤይጌቤ ቢያ አንቌ ይቸኝ ይብር ባነ።<note caller="-" style="x"><char style="xo" closed="false">13፥25 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቴ. 3፥11</ref>፤ <ref loc="MRK 1:7">ማር. 1፥7</ref>፤ <ref loc="LUK 3:16">ሉቃ. 3፥16</ref>፤ <ref loc="JHN 1:20">ዮሐ. 1፥20</ref>፣<ref loc="JHN 1:27">27</ref>። </char></note><verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />አሑ በአብርሐም ዝሬት የጨኘሑ ጐባቢት፤ ኧሗም በግብታሑ የእዝጌር ይጔኖዪ እንም፤ ዚ ይተርፉᎄ መልክት የትላኸዪ ይንመናው። <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />የኢየሩሳሌም ሰቦችም አለኦቸሕኖ የኢየሱስ አንካሮይ፤ የሕን አንኸንም በሰምበት ሰምበተሑ ይትነበቢ የነብዮች መጽሐፍ ይትፌጠም በሑቲ ፈረዶᎄ። <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />የሞት ያሰላን አትም መሳ ቤይረሕቦᎄም ጲላጦስ የሞት ፍርድ ይትፈረድወኸም ጮቀሶይ።<note caller="-" style="x"><char style="xo" closed="false">13፥28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">ማቴ. 27፥22-23</ref>፤ <ref loc="MRK 15:13-14">ማር. 15፥13-14</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">13፥28 </char><char style="xt" closed="false"><ref loc="ACT 19:15">ሐዋ. 19፥15</ref>። </char></note> <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />ስለ ሑቲ የጣፈዪ እንም በፌጠሞᎄ አንቌ በመስቀል አወረዶም ቀበሮይ።<note caller="-" style="x"><char style="xo" closed="false">13፥29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">ማቴ. 27፥57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፥42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>። </char></note> <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />እዝጌርም በሞት አትኔሣን። <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />ተገሊላ ቀረሰም ኢየሩሳሌም ስን ተሑቲጌ የነበሮዪም ብዠ ከነ ታዠኖ፤ ሕኖም ኧሗ የሕዝቢ ምስክሮቸሑኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">ሐዋ. 1፥3</ref>። </char></note> <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />ኢናም የአቦቸና ቃል የገቧኒ የምሥራች ቃል ያሑ ኧሰብክነ፤ <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />የኢየሱስም ተሞት በዋትነሣሑ የሕኖ የገቧኒ ቃል ይና የዴንጋሕኖ ፌጠመም፤ ዚም በዄታለኘዪ መዝሙር እኪ ቧሪም ተጣፈም፤</para>
  <para style="q1" vid="ACT 13:33">አኸ ትኸኛንከ፤ እያ ኧኳ ጨኘከኸም።<note caller="+" style="f"><char style="fr" closed="false">13፥33 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">አባኸ ኸንኩ</char></note><note caller="-" style="x"><char style="xo" closed="false">13፥33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">መዝ. 2፥7</ref>። </char></note><verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />ኧሗም፣ ሑቲ ያንበስበሰኸም እዝጌርም በሞት ያትኔሳንኸም የዋርጋግጥ እኪ ባረም፤</para>
  <para style="q1" vid="ACT 13:34">የትቄደሰዪም</para>
  <para style="q1" vid="ACT 13:34">የታመነዪ፣ የዳዊት በረከት ኢብኩ።<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />ስለኸነም ብንጐድ ምራፍ፤</para>
  <para style="q1" vid="ACT 13:35">ቅዱሳኸ ወበስብስ ያዥኸም አንፈቅድ ይብር።<note caller="-" style="x"><char style="xo" closed="false">13፥35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">መዝ. 16፥10</ref>። </char></note><verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />ዳዊት በራሰሑ ዘበን የእዝጌር ፈአድ ባግለገለ አንቌ ᎀተም፤<note caller="+" style="f"><char style="fr" closed="false">13፥36 </char><char style="ft" closed="false">ᎀተ ወበር በግሪክ ቋንቋ አንጓደለ ይብር። </char></note> ተአቦቸሑጌ ተቀበረም በሰረሑ ብሰበሰም። <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />እዝጌር ተሞት ያትኔሣን ኢየሱስም አንበስበሰ።<note caller="-" style="x"><char style="xo" closed="false">13፥37 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42፥6</ref>፤ <ref loc="ISA 49:6">49፥6</ref>። </char></note> <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />ኧጌሽ ጐባቢት፤ የአጢያት አፉታ ይትረከብ በኢየሱስ ኤማ ወሕነሑ የሰበኩንኩኸም ሐሮ፤ <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />በሑቲ ያምን እንም በእዝጌር ኤማ የሙሴ ያᎅ ሕጊ ወርክብ ያንቻሊዪ ጽድቅ ይረክብ። <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />ስለኸነም ነብዮች እኪ ባሮም የዝነጎዪ ኤይሰላብኩኸም ተቀሮ፤<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“‘አሑ ፌዘኞች፤ ተመልከቶ፤</para>
  <para style="q2" vid="ACT 13:41">ተደነቆ፤ ጥፎ፤</para>
  <para style="q1" vid="ACT 13:41">ሟንም ቢይውድሑ፣</para>
  <para style="q2" vid="ACT 13:41">አታምኖዪ ሜና፣</para>
  <para style="q2" vid="ACT 13:41">እያ በዘበናሑ ኧሸክት።’ ”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />ጳውሎስ በርናባስም በምኩራብ ቲወጦ፤ ሰቦቺ ስለዚ ዘንጋ ቢቄጥሊ ሰምበት ይውዶዮኸም ጮቀሶዮ። <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />የምኩራቢ ጀᎈሪ በትቤተነ ግዝየ ብዠ አይሑድ ጐሣዎች ተአይሑድ እምነቴ ቡሮም የእዝጌር ያመልኮዪ ሰቦች፤ ጳውሎስ በርናባስም ተዄተሎዮ፤ ጳውሎስ በርናባስም የሰቦቺ በዋትመር በእዝጌር ጸጋ ጠኖም ይነብሮኸም አቴሰቦዮ።<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />ቢቄጥሊም ሰምበት የከተማዪ ሕዝብ፤ ቀሊ ሰብ ጠለለ ቲቀይ፤ ይነብሮ እንም የእዝጌር ቃል የወስማ ተስበሰቦ። <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />አይሑድም ብዠ ሕዝብ ባዞ ግዝየ፤ በቅናት ተᎀሎ፤ የጳውሎስም ንግግር ቲቃወሞ ይሰድቦይ ባነ። <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />ጳውሎስ በርናባስም በድፍረት እኪ ባሮዮ፤ የእዝጌር ቃል በመጀመሪያ ወታወድ ባነወ፤ አሑም ገረጥኩይ፤ በዚም የዘለዓለም ሕይወት ኤይጌባሑኸም በነብሳሑ ᎈር የፈረድኩ ስለኸነ፤ ኢናም ተአሕዛቤ ዞር የወበር ግድ ይብርነ። <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />ኧሗም ጔታ እኪ ባረም ኤዘዘነም፤ “‘ወትርፍ ያፈር ጥግ ስን ታሰላኸም፤<note caller="+" style="f"><char style="fr" closed="false">13፥47 </char><char style="fqa" closed="false">ታሰላዬ </char><char style="ft" closed="false">ይብሪ በግሪኪ ነጠላ ቁጥሩ። </char></note> የአሕዛብ ብራን ሸከትከኸም።’ ”<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />አሕዛብ ዚ በሰሞ ግዝየ ተብላለቆ፤ የእዝጌርም ቃል ክብር አቦ፤ የዘለዓለም ሕይወት የዝጋዶዪም እንም አመኖ።<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />የጔታም ቃል በጭጭሳዪ ባነዪ ገኝ እንም ቤተተ። <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />አይሑድም በመንፈሳዊ ዘንጋ የትጋደሎዪም በኑሮ የከበረማዪ እንሽታ ዛምኸም የከተማዪ ግድድር ገሜ ቅሰቀሶም በጳውሎስ በበርናባስም ᎈር ስደት አትኔሦ፤ በገኘሕኖም አትዌጦዮ። <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />ጳውሎስ በርናባስም ተቃውሞሕኖ የወግልጥ የግረሕኖ ቲባ አራገፎም ተኢቆንዮዬ ወሮ።<note caller="-" style="x"><char style="xo" closed="false">13፥51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">ማቴ. 10፥14</ref>፤ <ref loc="MRK 6:11">ማር. 6፥11</ref>፤ <ref loc="LUK 9:5">ሉቃ. 9፥5</ref>፤ <ref loc="LUK 10:11">10፥11</ref>። </char></note> <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />ደቀ መዛሙርቲም በብልቃት በመንፈስ ቅዱስም ተᎀሎ።<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">ጳውሎስ በርናባስም በኢቆንዮም</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />በኢቆንዮንም ጳውሎስ በርናባስም ቁናዬ ተአይሑድ ምኲራቤ ገቦ፤ በዛዬም ፈያኸም ያትመሮ ስለኸነ፤ በአይሑድ በግሪክም ስርም ብዠ ሰቦች አመኖ። <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />ያነመኖዪ አይሑድም፤ የአሕዛብ ንሠሦም በጔታ ጐባቢተሕኖ ይጠሎዮኸም ሸከቶ። <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />ጳውሎስ በርናባስም ስለጔታ በድፍረት ቲዝነጎ ብዠ ግዝየ በዛዬ ኤከሶ፤ ጔታም ይዝነጎዪ የጸጋዪ ቃል በታምራታዊ ምልክትም በድንቅ ሜና ቲዴግፍ ያርጋግጥኖ ባነ። <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />የከተማዪም ሕዝብ ተሰሰደ፤ ግብቲም ተአይሑድጌ፤ ግብቲም ተሐዋርያተሑጌ ኸነ።<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />በዛ ግዝየ አሕዛብ አይሑድም ተመሪዎቸሕኖጌ ተገገዞም ያንግላቶዮዬም ብምን ወጎም ይቀጥሮዮዬ ሸዎ። <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />ሕኖም ዚ በሐሮኸም ተልስጥራን ተደርቤም ተቧርዮ ተሊቃኦንያ ከተሞቼ በዙሪያሕኖ ታኖ ገኜም ሰኮ፤ <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />በዛዬም ወንጌል ወስብክ ቄጠሎ።<verse eid="ACT 14:7" /></para>
  <para style="s1">ጳውሎስ ተበርናባስ በልስጥራን በደርቤም</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />በልስጥራንም፤ ኧግረሑ ጅረ የኸነዪ በጨኘ ቀረሰም ስርም በግረሑ ወረም ኤይሒር ጅረ ሰብ ቾናም ባነ። <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />ዚም ሰብ ጳውሎስ ቲዝነግ ይሰማ ባነ። ጳውሎስም ተሑቲዬ ትክ ባረም ተምሌከተም የወትርፍ እምነት ያነንኸም ባዠ ግዝየ <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />በወደል ጣምባ፤ “ቀጥ በርም በግራኸ ቁም!” ቧረን፤ በዛ ግዝየ ዘለለም ተነሣም ምሲም ብድግ ባረም ወወር ቀረሰ። <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />ሕዝቢም ጳውሎስ የሸኰተኒ ባዞ ግዝየ፤ በሊቃኦንያ ቋንቋ፤ “ኢና አመልክነዮ አማልክት በሰብ ተሜሰሎም ቲናዬ ወረዶም!” ባሮም ው ው ባሮ፤ <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />የበርናባስ ዚዎስ ባሮይ፤ ጳውሎስም ዋና ይዝነግ የነበረ ስለኸነ ሔርሜን ባሮይ።<note caller="+" style="f"><char style="fr" closed="false">14፥12 </char><char style="ft" closed="false">“ዚዎስም” “ሔርሜስ” ይቡርዮዪ በሊቃኦንኛ ቋንቋ ተአማልክተሕኖ ጌ ተጥባበጦም የቸኖ ሽምኖ። </char></note> <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />ተከተማዪ ውጪ ያነዪ የድያ ቤተ መቅደስ ካሕንም ኮርማዎች የአበባ ጉንጉኖችም ተከተማዪ ቲገᎄᎄ በሬ አቸኘም፤ ተሕዝቢጌ በወትገገዝ የጳውሎስ የበርናባስም መሥዋዕት ያቀርብኖዬ ሸ።<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />ሐዋርያት በርናባስ ጳውሎስም ዚ በሰሞ ግዝየ ልባሰሕኖ ገደዶም ተሕዝቢዬ ሮጦ፤ ጣምባሕኖም ከፍ አበኖም እኪ ባሮ፤ <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“ሰቦች!፤ የመአር ዚ ትሸክቶ? ኢናም የአሑኸም ሰቦችንነ፤ አሑም ኧሗም ተዚ ቤድገልል ቃር ራቅኩም ሰሜ አፈርም፤ ባር በውስጠሕኖም ይትረከቦዪም እንም ተኸለቀዪዬ ተሕያው እዝጌሬ ትዠበሮኸም ወንጌል ኧሰብክነንኩ፤<note caller="-" style="x"><char style="xo" closed="false">14፥15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ዘፀ. 20፥11</ref>፤ <ref loc="PSA 146:6">መዝ. 146፥6</ref>። </char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />ሑቲ ባለፎዪ ጨኘቶች፤ ሕዝቢ እንም በፎለሕኖ ኤማ ያሮኸም ገፈረኖ፤ <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />የሕን አንኸንም ዝናብ በሰሜ ዛምኸም የፍርየ ወክቶች በዋበሑ፤ ኧሗም ሒናሑ በስንቅ በብልቃትም በዋርካሑ ፈያ በወሰክት ነብሰሑ ያለ ምስክር አንገፈረ።” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />ሐዋርያት ዚ እንም ዝነጎም፤ ሕዝቢ ኤያርድኖኸም ያትጌፈሮይ በብዠ ምካት ባነ።<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />አይሑድም በአንጾኪያ በኢቆንዮንም ቸኖም፤ የሕዝቢ አግባቦ፤ የጳውሎስም ብምን በወጎይ አንቌ፤ የᎀተ መሰረኖም ሻቦም በከተማዪ ተውጪዬ አወጦይ። <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />ቢኸንም ደቀ መዛሙርት ኸበቦይም ያኖኸም ተነሣ፤ ተከተማዬም ገባ። የመናጊም ተበርናባስጌ ተደርቤኔ ወሮ።<verse eid="ACT 14:20" /></para>
  <para style="s1">ጳውሎስ በርናባስም ተአንጾኪያዬ ተዠበሮ</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />ጳውሎስ በርናባስም በደርቤን የምሥራቺ ቃል ሰበኮም፤ ብዠ ደቀ መዛሙርትም በሸከቶ አንቌ፤ ተልስጥራኔ፤ ተኢቆንዮኔ ተአንጾኪያዬም ተዠበሮ። <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />የደቀ መዛሙርቲም ሒን በዋብረታታም በእምነተሕኖ ቆመሮም ይነብሮኸም በወምክር፤ “ተእዝጌር መንግሥቴ የወግባ በብዠ መከራ ወተለፍ ነነብነ” ባሮዮ። <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />በዛም በአብያተ ክርስቲያናት ሽማግሌዎች በሾሞኖ አንቌ፤ በጦም በጠሎትም ያመኖᎄ ጔታ አደራ አቦዮ።<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />በጲስድያም ተቸለፎም ተጵንፍልያዬ ቸኖ፤ <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />በጴርጌንም የእዝጌር ቃል በሰበኮ አንቌ፤ ተአጣልያዬ ወረዶ። <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />ተአጣልያም፤ ኧሗ ስን የሸከቶይ ሜና፤ የእዝጌር ጸጋ በአደራ ተቴቦᎄ ከተማዬ ተአንጾኪያዬ በመርከብ ተዠበሮ።<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />ዛዬም በሰሎ ግዝየ፤ ቤተ ክርስቲያን ቁናዬ ስበሰቦም፤ እዝጌር በሕኖ መሳ የሸኰተኒ እንም፤ ኧሗም የአሕዛብ ምንኸም የእምነቲ በር የከፈተኖኸም ዝነጎ። <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />በዛም ተደቀ መዛሙርትጌ ብዠ ግዝየ ቾኖ።<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s1">በኢየሩሳሌም የሸከተ ጀᎈር</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />አታት ሰቦችም ተይሑዳ ተአንጾኪያዬ ወሮም፥ “እዝጌር በሙሴ ኤማ ያᎄን ሥርዐት መሠረት ጤበን ባናውነኩ ትተርፎዬ አትችሎ” በወበር በጔታ ጐባቢት የኸኖዪ ዋትመር ቀረሶ።<note caller="-" style="x"><char style="xo" closed="false">15፥1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">ዘሌ. 12፥3</ref>፤ <ref loc="ACT 10:1-43">ሐዋ. 10፥1-43</ref>። </char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />ዚም የጳውሎስ የበርናባስም ተሕኖጌ ተቡሼ መናክሴም ኦገት ውስጥ ኸናኖ። ስለኸነም ጳውሎስ በርናባስም ትንጐድ ታታት ምእመናንጌ ተኢየሩሳሌሜ ወጦም ስለዚ ዘንጋ የሐዋርያት የሽማግሌዎቺም ይሰሎኸም ተዌሰነ።<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />ቤተ ክርስቲያኒም በሸኖᎄ ኤማ በፊንቄ በሰማርያም ኤማ ይቸለፎኸም ላኸኖ፤ ሕኖም የዚሕኖ መደሮች የነበሮዪ የአሕዛብ ወዘበርም ወምን ኤወዶዮ፤ በጔታ ጐባቢት የኸኖዪ እንም በዚ ስርም ተብላለቆ። <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />ኢየሩሳሌም በሰሎ ግዝየም፤ ቤተ ክርስቲያን ሐዋርያትም ዛምኸም ሽማግሌዎች ተቌበሮዮ፤ የላሑዮዪም እዝጌር ተሕኖጌ ኸነም የሸኰተኒ እንም ኤወዶዮ። <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />ተፈሪሳውያን ቡድን ያመኖዪ አታቶቺ ተነሦም በወቁም፤ “አሕዛብ ጤበን ያወኖዮኸም እዝጌር በሙሴ ኤማ ያᎄን ሕጊ ይቅሮኸም ወሰክት ያሸ” ባሮ።<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />ሐዋርያት ባሊቆችም ዚ ዘንጋ የወመርምር ተስበሰቦ። <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />ብዠ ኦገት በሸከተ አንቌ ጴጥሮስ ተነሣም እኪ ባረኖ፤ “ጐባቢት፤ እዝጌር ተቀል ግዝየ ኢፍት ባሑ ግብት ይያ ሜጠረም፤ አሕዛብ የወንጌል ቃል ቢያ ከንፈር ሰሞም ያምኖኸም ወሰክተሑ ቲሕሮ። <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />የሰብ ሒን ይሒር አምላክ ይና ያበነኸም እንም፤ የሕኖም መንፈስ ቅዱስ በዋብ የቌበረኖ ወሕነሑ ምሰከረኖ፤<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="ACT 2:5">2፥5</ref>፤ <ref loc="ACT 10:44">10፥44</ref>። </char></note> <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />ሒነሕኖም በእምነት በዋንጣ ቢናም በሕኖ ግብት አትም ልዩነት አንሰከተ። <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ኧጌ፥ አቦቸናም ኸኖ ኢና ኧጮርነዬ ያንቻልኔዪ አንገችል በአማኞች መመር ᎈር በወጫን የመአር ኧሗ የእዝጌር ትፍታተኖይ? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />ኢናም ኧተረፍነ ልክ የሕኖኸም በጔታ በኢየሱስ ጸጋ ወሕነሑ ናምንነ።”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />ጀᎈሪም እንም ጭጭ ባረም፤ በርናባስ ጳውሎስም እዝጌር በሕኖ መሳ በአሕዛብ ግብት የሸኰተኒ ታምራዊ ምልክቶችም ድንቅ ቃሮች ቲዝነጎ ይሰማኖ ባነ። <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />ሕኖም ዝነጎም በፈዶ አንቌ ያዕቆብ ተነሳም እኪ ባረ፤ ጐባቢት፤ ስሞኝ፤ <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />እዝጌር በአሕዛብ ጐሳ የሑቲ ይኸኒ ሕዝብ በደረም ምንኸም የጉበኘኸም ስምዖን<note caller="+" style="f"><char style="fr" closed="false">15፥14 </char><char style="ft" closed="false">ሑቲም ጴጥሮሱ። </char></note> የቧሪዪ ጴጥሮስ አትሬዳም። <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />ዚም እኪ ቧሪም የጣፈዪ የነብዮቺም ቃል ተዚጌ ይስማማ፤<verse eid="ACT 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16" />በዛ አንቌ ኧዠበር፤</para>
  <para style="q2" vid="ACT 15:16">የፈረሰዪም የዳዊት ቤት ኧሸክት፤</para>
  <para style="q2" vid="ACT 15:16">የፍራረሰዪ ኧዠብርም አቈም፤ ዠበርኩም ኧሸኩች፤<verse eid="ACT 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17" />ዚም የቀኖዪ ሰቦች የጔታ ይሸዎኸም፤</para>
  <para style="q2" vid="ACT 15:17">ሽመኛ የጮሮ አሕዛብም እንም ይያ የእዝጌር ይሸዎይኸሙ፤ ነዚሕኖ የሸከተ ጔታ እኪ ይብር፤<verse eid="ACT 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18" />ሕኖም ተድረ ቀረሰም የትኴሮኖ።<note caller="+" style="f"><char style="fr" closed="false">15፥17-18 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">የጔታ ተድረ ቀረሰም የትኴረዪ የነብሰሑ ሜናው </char><char style="ft" closed="false">ይብሮ። </char></note><note caller="-" style="x"><char style="xo" closed="false">15፥16-18 </char><char style="xt" closed="false"><ref loc="AMO 9:11-12">አሞ. 9፥11-12</ref>። </char></note><verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“ስለኸነም ተእዝጌሬ የዠበሮዪ አሕዛብ አናጬንቅነዮኸም ዚ ይያ ውሳኔው። <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />ይጠቅልሽ ‘የጣዖት በወርደሑ መሳ የረከሰ ስንቅ አትብሮ፤ ተዝሙት ሽቅ በሮ፤ ቴያርጂ ደመሑ ቴይፈስ ታነቀም የᎀተ እንሰሳ በሠር አትብሮ፤ ደምም አትብሮ’ ባርነም ንጣፍነኖ።<note caller="-" style="x"><char style="xo" closed="false">15፥20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">ዘፀ. 34፥15-17</ref>፤ <ref loc="LEV 17:10-16">ዘሌ. 17፥10-16</ref>፤ <ref loc="LEV 18:6-23">18፥6-23</ref>። </char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />መሳሑም እዝጌር በሙሴ ኤማ ያᎄን ሕጊ ድረ ቀረሰም በሰምበት ሰምበተሑ በምኩራብ ቲትነበብ በከተማ ተከተማዪ ቲሰበክ ነበረም።”<verse eid="ACT 15:21" /></para>
  <para style="s1">ያመኖዪ አሕዛብ በጀᎈሪ የትላኸ ደብዳቤ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />በዛ ግዝየ ሐዋርያት ሽማግሌዎችም ትንም ቤተ ክርስቲያንጌ ኸኖም በግብተሕኖ አታት ሰቦች ሜጠሮም፤ ተጳውሎስ ተበርናባስምጌ ተአንጾኪያዬ የወላክ ዌሰኖ፤ ስለኸነም በጔታ ጐባቢት ግብት በመሪነት ፈያ ዝና የነበረኖዪ በርሳባስ የቧሪዪ ይሑዳ ሲላስም ሜጠሮ። <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />በሕኖም ኧጅ ቄጠለም ያነዪ ደብዳቤ ላሖ፤ በጔታ ጐባቢታሑ በኸኖዪ በሐዋርያት በሽማግሌዎችም፤ በአሕዛብ ጐሳ አመኖም በአንጾኪያ፤ በሶርያም በኪልቅያ ይትረከቦዪ በጔታ ጐባቢት፤ ሰላምታና የስላሑ። <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />ቢና ግብት አታት ሰቦች ያለ ኢና ፈአድ ቢናዬ ወጦም በንግግረሕኖ ሒነሑ የሬበሾነኸም ያናወጦኩኸም ሰማነም። <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />ስለኸነም ቁናዬ በስበሰብነ አንቌ መልክተኞች ሜጠርነም ተወጀጅዮዪ በጔታ ጐባቢተና ተበርናባስ ተጳውሎስጌም ታሑዬ ኧለክነዮዬ ተስማማነ። <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />በርናባስ ጳውሎስም የጔታና ኢየሱስ ክርስቶስ ሕይወተሕኖ አቸለፎም ያቦኖ። <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />የጣፍነንኩዪ በቃልም እንም ደበሮም ይውዶኩኸም ይሑዳ ሲላስም ላሕነም። <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />ተዚሕኖ ይቄጥሊ ያሸዪ ቃር አኸንም ኧንጐድ ይረዝ ጡዋራም አንጨነብኩኸም መንፈስ ቅዱስ ኢናም ፈያ ኸነም ረከብኔም፤ <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />የጣዖት ያረጂ መሳ የሩክስ ስንቅ አትብሮ፤ ታነቀም የᎀተ እንሰሳ በሠር አትብሮ፤ ደምም አትብሮ፤ ተዝሙት ስኮ፤ ተዚሕኖ ቃር እንም ብትቅሮ ፈያ ትሸክቶ፤ ፈያ ሕኖ።<verse eid="ACT 15:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="ACT 15:30" />የትላሖዪም ሰቦች በስናበቶ አንቌ ተአንጾኪያዬ ወረዶ፤ በዛም የምእመናኒ ጀᎈር ቁናዬ ስበሰቦም ደብዳቤዪ አቦዮ። <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />አማኞቺም ደብዳቤዪ ባነበቦ ግዝየ ቢያብርታታዪ መልክት ስርም ተብላለቆ። <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />ይሑዳ ሲላስም ነብሰሕኖም ነብዮች የነበሮ ስለኸነ፤ በጔታ ጐባቢት ብዠ ንግግር በወሰክት መከሮዮ፤ አብረቶዮ። <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />በዛም ቀል ግዝየ ቤከሶ አንቌ፤ በጔታ ጐባቢት በሰላም ተስናበቶም ተላሑዮ ሰቦቼ ተዠበሮ።<note caller="+" style="f"><char style="fr" closed="false">15፥33 </char><char style="ft" closed="false">አታት የጎጋ መጽሐፍት በ 34 ቊጥር ይትረከቢም ኤደብሮ። </char></note> <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />[ሲላስም በዛሜ ወኢ ዌሰነ<note caller="+" style="f"><char style="fr" closed="false">15፥34 </char><char style="ft" closed="false">አታት ቅጂዎች ዚ ቁጥር ኤነኖ። </char></note>።] <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />ጳውሎስ በርናባስም ትንጐዶቺ ብዠ ሰቦችጌ ኸኖም የጔታ ቃል ቲያትመሮ ቲሰብኮም በአንጾኪያ ቾኖ።<verse eid="ACT 15:35" /></para>
  <para style="s1">ጳውሎስ በርናባስም በአሳብ ተላኖ</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />ጳውሎስ ተቀል ከነ አንቌ የበርናባስ፤ “ተንሣም የጔታ ቃል ተሰበክነቦ ከተማዬ እንም ንወርነ፤ በዛ ያኖ በጔታ ጐባቢትም በምን ሐለት ያኖኸም የወሐር ንጎብኝነዮ” ቧረን። <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />በርናባስ ማርቆስ የቧሪዪ ዮሐንስም ተሕኖጌ ቁናዬ ያርኸም ሸ፤ <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />ጳውሎስም የሑቲ ጠበጠም የወወር አንሸ፤ መሳሑም፤ በደረም ማርቆስ ተሕኖ ተላኘም በጵንፍልያ የቀኘ ስለኸነ ተሕኖጌ ተሜናዬ አወረ።<note caller="-" style="x"><char style="xo" closed="false">15፥38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">ሐዋ. 13፥13</ref>። </char></note> <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />ዚኸም የከረረ አለወግባባ በግብተሕኖ የትኸለቀ ስለኸነ ሕኖ በሕኖ ተልያዮ፤ ስለኸነም በርናባስ የማርቆስ ጠበጠም በመርከብ ተቆጵሮሴ ወረ። <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />ጳውሎስም የሲላስ ሜጠረ፤ በጔታ ጐባቢትም የጔታ ጸጋ ዐደራ ባቦይ አንቌ ተላኘኖም ወረ፤ <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />የአብያተ ክርስቲያናትም ቲያብርታታ በሶርያ በኪልቅያም ኤማ ተቸለፈ።<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s1">ጢሞቴዎስ ጳውሎስ ተሲላስምጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />ጳውሎስ ተደርቤዬ ተልስጥራ ከተማዬ ወረ፤ በልስጥራ ጢሞቴዎስ ይቡሪ አማኝ ይነብር ባነ፤ ዳኰችም አይሑዳዊ ክርስቲያን ባነች፤ አᎄች ግሪካዊ ባነ። <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />ጢሞቴዎስ በልስጥራን በኢቆንዮንም ባኖዪ በጔታ ጐባቢቴ ፈያ ምስክርነት ቧነን። <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />ጳውሎስም የጢሞቴዎስ ተሑቲጌ ያርኸም ሸ፤ ስለኸነም በዛ ጭጭሳ በነበሮዪ አይሑድ መሳ ጠበጠም ጤበን አወናን፤ ነዚሕኖ አይሑድ እንም የጢሞቴዎስ አባ የግሪክ ሰብ የኸነኸም ይሒሮ ባነ። <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />ጳውሎስ ሲላስም በከተማ እንም ቲቸለፎ በኢየሩሳሌም ባኖዪ ሐዋርያት ሽማግሌዎችም የዌሰኖዪ ሴራ የአማኞች ያትኴሮ ባነ፤ በሜና ᎈርም ያወሎይኸም ያቴስቦዮ ባነ። <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />ስለኸነም አብያተ ክርስቲያን በእምነት ቆመሮ፤ ቁጥረሕኖም ከነ በከነ ቲደብር ያር ባነ።<verse eid="ACT 16:5" /></para>
  <para style="s1">ጳውሎስ ያዠን መና</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />ጳውሎስ ሲላስም በእስያ ቃለሑ ኔዝነጎ መንፈስ ቅዱስ የኸተረኖ ስለኸነ በፍርግያ በገላትያም ገኝ ሸከቶም ተቸለፎ፤ <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />ተሚስያ ድንበሬ በሰሎ ግዝየ ተቢታንያዬ የወወር ኤሰቦም ባነ፤ ቢኸንም የኢየሱስ መንፈስ ተዛዬ ያሮዬ አፈቀደኖ። <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />ስለኸነም በሚስያ አዘር ተቸለፎም ተጢሮአዳዬ ወረዶ። <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />በዛዬ በምሳር አት የመቄዶንያ ሰብ ቈመም “ተመቄዶንያዬ ተገናም ኧግዘነ!” ቲብር ቲጮቁሽ ጳውሎስ መና አዠ። <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />ጳውሎስ ዚ መና ባዠ አንቌ ሒንጌም ተመቄዶንያዬ የወወር ሸነ፤ ዚም የኸነ የመቄዶንያ ሰቦችም ወንጌል አትመርነኸም ጔታ የጠራነኸም የትሬዳነ ስለኸነው።<verse eid="ACT 16:10" /></para>
  <para style="s1">ልድያ በክርስቶስ ወምኔታ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />በጢሮአዳ በመርከብ ተሳፈርነም በቀጥታ ተሳሞትራቄዬ ወርነ፤ የመናጊም ተናጱሌዬ ወርነ። <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />በዛዬም ተነሣነም ተፊልጵስዩሴ ሰላነ፤ ፊልጵስዩስ በመቄዶንያ ይትረከብ ወደል ከተማ የሮማውያንም ቁጥጥር ተት የትገዛ ገኝ ባነ፤ በዛም ከተማ ቀል ከነዎች አቸለፍነም። <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />በሰምበትም ከነ የጠሎት ይስበሰቦᎄ ተነበረዪ ተከተማዪ ውጪዬ ይትረከቢ ተዲየ ᎀረዬ ወርነ፤ በዛዬም ቾናነም የስበሰበማዪ ኧንሽታ የእዝጌር ቃል አትመርነ። <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />ቲሰመማዪ እንሽታ ግብት ልድያ ይቡሪያ አት ምሽት ባነች፤ ሒቲም የእዝጌር ታመልክ በትያጥሮን ከተማ የቸኘች ብሻ የሐር ክር ልባስ ነጋዴ ባነች። ጔታም፤ የጳውሎስ ይዝነጊኒ በዋጥራምት ትሰማዬ፤ ሒኔታን ከፈተና። <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />ሒቲም በቤቴታ ያኖ ሰቦች እንም በጠመቆ አንቌ፥ “በጔታ አምን ወሕነኛ ባርጋገጥኩኒ ተቤተኛዬ ኔሑማሑ ቶኖ” ትትብር አጠበቀችም ጮቀሰትነ።<verse eid="ACT 16:15" /></para>
  <para style="s1">ጳውሎስ ሲላስም ኧጉጀኘ ወሕነሕኖ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />አት ከነ ተጠሎት መደሬ ትናርነ ቲፍቴዬ ዪኸኒም ቃር የሟርት መንፈስ ያነባ አት አገልጋይ አፍቶ ቤማ ረከበትነ፤ ዚ አፍቶ በሸጐረነቴታን የጌቶቼታ ብዠ ትርፍ ታትሬክብኖ ባነ። <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />ሒቲ ጳውሎስ ይና ትትዄተልነ “ነዚ ሰቦች የንቅ ኧዝጌር አገልጋዮችኖ! ሕኖ የዋትርፍም ኤማ የምስራች ያበሥሮኩ!” በወበር ው ትብር ባነ። <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />ዚ ብዠ ከነ ድጋገመችም ትሸክት ባነ፤ ጳውሎስ ተብሳጨም ዞር ባረም የሩክሲ መንፈስ “በኢየሱስ ክርስቶስ ሽም ተሒቲ ትወጣኸም ኤዝዝከ!” ቧረን። ሩክሲም መንፈስ ሒንጌም ወጣ።<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />ጌቶቼታም ጥቅም ይረሕቦᎄዪ ተስፋ የቋረጠቦኸም ባዞ ግዝየ የጳውሎስ የሲላስም ጠበጦዮ፤ ቲሸቦም ተጠባዬ ወሰዶዮም በሹሞቺም ኢፍት አቀረቦዮ። <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />ተሮማውያን ባለሥልጣኖቼም አቸኖዮም እኪ ባሮ፤ “ነዚ ሰቦች የአይሑድ ጐሣኖ፤ በከተማናም ሕላት ያትኔሦ፤ <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />ኢና የሮም ሰቦች ኧቌበርነዪ ወይ ኧሸክትነዪ ያንትፈቀደንነዪ ሥራት ያትመሮ።” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />ሕዝቢ እንም ተገገዘም በሕኖ ᎈር ተነሣ። ባለሥልጣኖቺም የጳውሎስ የሲላስም ልባስ መለጦም ባለንጋ ይገርፎዮኸም ኤዘዞ። <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ቡሼኸም በገረፎዮም አንቌ ተወሕኔ ቤቴ ኸኖዮ፤ የወሕኔ ቤቲም ይቂየዪ አጠበቀም ይቅየኖኸም ቴዘዘ። <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />ዘበኛዪ ዚ ትዛዝ በቌበረ አንቌ፥ ተወሕኔ ቤት ተውስጤ ክፍል ኸናኖ፤ ኧግረሕኖም በዄት ጊንድላ ግብት አጣበቀም አገደኖ።<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />ግብት ምሳር ቅጫ ቲኸን ጳውሎስ ሲላስም በጠሎት በመዝሙርም የእዝጌር ያምሰግኖ ባነ፤ ኧንጐዲም ኧጉጀኘ የኸኖዪ ይሰሞዮ ባነ። <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />ሒንጌም በድንገት የወሕኔ ቤቲ መሠረት ይናጋ ስን ወደል የአፈር ወትናወጥ ኸነ፤ ወዝገቢም እንም በቁናጌ ተከፈቶ፤ አትባቲም ኧጉጀኘ ሰንሰለት ተፈታ። <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />ጠባቂዪ ተወኔተሑ ነቃም የወሕኔ ቤቲ ወዝገብ ተከፈቶም ባዠ ግዝየ ኧጉጀኘ የኸኖዪም ያመለጦ ᎀሰረንም ነብሰሑ ይቀጥሬ ሰይፈሑ ሻበ። <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />ቢኸንም ጳውሎስ፥ “እንመና በዚዬ ንነ! ስለኸነም በነብሳኸ ᎈር ቡሼ ቃር አታስላ!” ቲብር በወደል ጣምባ ው ባረ።<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />በዛ ግዝየ ይቂየዪ መብራት አቸኘም ቲሮጥ ተውስጤ ቡየ፤ ቲያንጉጀጉጅም በጳውሎስ በሲላስም ኧግር ተት በግንባረሑ ተደፋ። <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />ተወረጀዬም አወጣኖም “ጌቶቸኛ! የወትርፍ ምን ወሰክት ይትጌቤ?” ባረኖ።<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />ሕኖም “በጔታ በኢየሱስ ኧምን፤ ትተርፍ፤ አበሮሳኸም ይተርፎ” ባሮይ። <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />የጔታም ቃል የሑቲም በሑቲ ቤት ያኖዪ እንም ዝነጎ። <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />በዛም ሰዓት በምሳር ወሕኔ ቤቲ ይቂየዪ ወሰደኖም መዛሕኖ አጠበኖ፤ ሒንጌም ሑቲም አበሮሰሑ እንም ተጠመቆ። <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />በዛ አንቌ የጳውሎስ የሲላስም ተቤተዄ ወሰደም ስንቅ አቀረበኖ፤ በእዝጌር ያመነ ስለኸነ ተአበሮሰሑጌ ተብላለቀ።<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />በዛኘ ግዝየ ባለሥልጣኖቺ “ነዛ ሰቦች የግፉርዮ” ባሮም የፎሊሶች ላሖ።<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />ወሕኒ ቤት ይቂየዪ “አሑ ይᎈቸኩኸም ባለሥልጣኖቺ ሰብ ላሖም ኧጌሽ ውጦማሑ በሰላም ወሮ” ቲብር የጳውሎስ ኤወደን።<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />ጳውሎስ “ኢና የሮም ገኝ ሰቦች ትንኸነ ያለ ፍርድ በጠባዪ ገረፎም ተወሕኒዬ ኸኖነም። ኧሗ ዠበረም በወሕኒ ቤት በሽሙቸ ኧወጣነኸም ይሸክቶ? ኤይኸን! ሕኖ ነብሰሕኖ የተኖም ያትወጦነ!” ቲብር ዠበረ።<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />ፎሊሶቺ ዚ ዘንጋ የባለሥልጣኖቺ ኤወዶ፤ ባለሥልጣኖቺም ጳውሎስ ሲላስም የሮም ገኝ ሰቦች ወሕነሕኖ በሐሮ ግዝየ ጔኖ። <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />ስለኸነም ቸኖም አፉታ ተሳሎዮም በወሕኒ ቤት አትዌጦዮ፤ ከተማዪ ገፈሮም ያሮኸም ጮቀሶዮ።<verse eid="ACT 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 16:40" />ጳውሎስ ሲላስም በወሕኒ ቤት ወጦም ተልድያ ቤቴ ገቦ፤ በዛዬም በጔታ ጐባቢት ረከቦም፥ አጥናኖዮ ከተማዪም ገፈሮም ወሮ።<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">በተሰሎንቄ የትነሣ ሕላት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />ጳውሎስ ሲላስም በአንፊጶልና በአጶሎንያ ተቸለፎም ተተሰሎንቄዬ ወሮ፤ በዛም የአይሑድ ምኩራብ ባነ። <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />ጳውሎስ የሮሸንኸም ተምኩራቤ ቡየ፤ የሦስት ሰምበትም አክታተለም በቅዱሳን መጽሐፍ ጠቀሰም የሕዝብ ያትሬዳ ባነ። <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />ክርስቶስ መከራ ወቀበር ተሞትም ወተንሣ ይጌቧንኸም ገለጠም ቲያትሬዳ “ዚ እያ ኢውድሑዪ ኢየሱስ መሲሑ” ይብር ባነ። <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />ስለኸነም ተአይሑድም አታቶቺ የሰሞዪ በወቀበር ተጳውሎስ ተሲላስምጌ ተገገዞ፤ ኧሗም ቁጥረሕኖ ብዠ የኸነ የእዝጌር ያመልኮዪ ስርም ብዠ አሕዛብ በከተማዪ የትኴረማ ብዠ እንሽታ ቃሊ ተሬደማም ተገገዘማ።<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />አይሑድም ቅናትመኘ ስለኸኖ ወስላታዎቺ በገቤ መደር አስባሰቦ፤ አቴደሞ። በከተማዪ ውስጥ ሕላት ይትነሣኸም ሸከቶ፤ የጳውሎስ የሲላስም አወጦም የሕዝቢ የዋብም የኢያሶን ቤት ኸበቦም ቡሼ ቃር አሰሎቦ። <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />ቢኸንም የሕኖ ባትዌጦዮ ግዝየ ኢያሶን አታት አማኞች የከተማዪ ባለሥልጣኖች የዋቅርብ ቲሸቦ ወሰዶዮ፤ እኪም ቲብሮ ው ይብሮ ባነ፤ “ነዚሕኖ በዓለም እንም ᎈር ሕላት ያትኔሦ ሰቦች ኧሗም ተዚዬ ቸኖም! <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />ኢያሶንም በቤተሑ ተቌበረኖም፤ ነዚሕኖ እንም፤ ‘ኢየሱስ ይቡሪ እንጐድ ንጉሥ ነነ’ በወበር የቄሣር ሕጊ ይቃወሞኖ።” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />ሕዝቢም የከተማዪ ባለሥልጣኖች ዚ በሰሞ ግዝየ ተሬበሾ። <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />ኢያሶን እንጐዶቺም ዋስ አጤሮም ገፈሮዮ።<verse eid="ACT 17:9" /></para>
  <para style="s1">ጳውሎስ ሲላስም በቤርያ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />በጔታ ጐባቢት ሒንጌም ጳውሎስ ተሲላስ በምሳር ተቤርያዬ ያሮኸም ሸከቶዮ፤ ዛዬም በሰሎ ግዝየ ተአይሑድ ምኩራቤ ገቦ። <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />በቤርያ ያኖዪ አይሑድ በተሰሎንቄ ታኖዪ የጠቀለ ቅን አመለካከት ያነኖ የነበሮ ስለኸነ ቃለሑ በወደል ብልቃት ተቌበሮ፤ የቃሊም የኢነተኝነት የዋርጋግጥ ከነ በከነሑ የቅዱሳት መጻሕፍት ይምረምሮ ባነ። <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />ስለኸነም ተሕኖ ብዠሕኖ አመኖ፤ ኧሗም ተሕኖጌ ቁጥረሕኖ ከፍተኘ የኸነ የትኴረማ የግሪክ እንሽታ ገሜም አመኖ። <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />በተሰሎንቄ ያኖዪ አይሑድም፤ ጳውሎስ የእዝጌር ቃል በቤርያ ደበረም ወስብከሑ በሐሮ ግዝየ፤ ሕዝቢ የወቀስቅስም የዋንሣሣ ተዛዬ ኧሗም ወሮ። <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />በዛ ግዝየ በጔታ ጐባቢት ሒንጌም ጳውሎስ ተባሪ ᎀረዬ ያርኸም ሸከቶይ፤ ሲላስ ጢሞቴዎስም በዛዬ በቤርያ ቀኖ። <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />የጳውሎስ የጌገቶይ ሰቦች አቴና ስን አሰሎይ “ሲላስ ጢሞቴዎስም ቴዬክሶ ሒንጌም ቲያዬ የተኖኒ” ይብሪም የጳውሎስ ትዛዝ ጠበጦም ተቤርያዬ ተዠበሮ።<verse eid="ACT 17:15" /></para>
  <para style="s1">ጳውሎስ በአቴና</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />ጳውሎስ በአቴና ኸነም የሲላስ የጢሞቴዎስም ቲይቅየ ትናነ በከተማዪ ብዠ ጣዖት ወሙላሑ ባዠ ግዝየ በመንፈሰሑ ተብሳጨ። <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />ስለኸነም በምኩራብ ኸነም ተአይሑድ የእዝጌርም ቲጔኖ ግሪኮችጌ፤ ኧሗም በገበያ መደር ከነ በከነሑ ቲረሕቦ ሰቦችጌ ይዝናጎ ባነ። <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />የኢፒኩሪሶች ጐሳ እስቶይኮች የቧሪዮ ብላተኞችም ተሑቲዬ ቸኖም ይኦግቶይ ባነ። አታቶቺ “ዚ ለፍላፊ መአር ወበር ሸሙ?” ቲብሮ፥ እንጐዲ ኧሗም “የገደር አማልክት ይዝነግ ይመስር” ይብሮ ባነ፤ ዚም የባሮᎄ መሳ ጳውሎስ የኢየሱስ የትንሣኤዪም ፈያ ዜና ያበሠረ ስለኸነው። <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />ጠበጦም አርዮስፋጎስ በቧሪዪ መደሬ በወውስድ እኪ ባሮይ፤ “አኸ ታትᎀሪ ዚ ገደር ትምርት መአር የኸነኸም ኧሒርነኸም ትፈቅድ? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />አታት ባዘና ቃሮች አሴማኸነም፤ ስለኸነም ነዚሕኖ ቃሮች መአር የኸኖኸም ወሐር ኧሸነ።” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />የአቴና ሰቦች እንም ዛምኸም በዛ ይነብሮዪ ይንጐድ ገኝ ሰቦች ግዝየሕኖ ያቸልፎ ስለገደር ቃሮች በወዘንግ በወስማም አንኸንም ብንጐድ ዘንጋ አነበረ።<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />ስለኸነም ጳውሎስ በአርዮስፋጎስ በስበሰበዪ ሕዝብ ግብት ቈመም እኪ ባረ፤ “የአቴና ሰቦች፤ በሟንመሕኖዬ፤ ስርም አይማኖተኞች ወሕናሑ አዥ፤ <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />በከተማሑ ትንዥዋወር የአምልኮ መደራሑ ትንምሌከት፤ ‘ኤይትኴር አምላክ’ ቧሪም የጣፉᎄዪ ያርጅᎄ መደር ረከብኩ፤ ኧጌሽ እያ ኧሗ ኢውድሑዪ ዛም ታቲሒሮ ታመልኮዪ የኸነዪ አምላኩ። <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />ሑቲ ዓለም በዓለምም ያነዪም እንም የኸለቀው፤ የሰሜ የአፈም ጔታው፤ ሑቲ በሰብ ኧጅ በሸከተ በቤተ መቅደስ ኤነብር፤ <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />ሕይወት አንፏትም፥ እንጐዲም ቃር የሰብ እንም ይብ ሑቲ ስለኸነ አትም ቃር ኤቀቡል፤ የሰብም እርዳታ ኤያሸን።<note caller="-" style="x"><char style="xo" closed="false">17፥24-25 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 ነገ. 8፥27</ref>፤ <ref loc="ISA 42:5">ኢሳ. 42፥5</ref>። </char></note> <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />ሑቲ የሰብ ዝሬት እንም በቁና ሰብ ኸለቀ፤ ባፈር እንም ᎈር ይነብሮኸም ሸከተ፤ የትዌሰኖ ዘበንም ይነብሮᎄዪ መደር ሜደበኖ። <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />ዚም የሸከተ ሰቦች የጔታ ይሸዎኸም በወምራመርም ሸዎም የሑቲ ሩሕቦት ይችሎኸሙ፤ ቢኸንም ሑቲ ቲና ተያታተና ኧሩቄው ወበር አንከነ።<verse eid="ACT 17:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 17:28" />‘ሕይወት ኧረሕብነዪም ኧዥዋወርነ፥</para>
  <para style="q2" vid="ACT 17:28">ኧነብርነም በሑቲቱ፤’</para>
  <para style="m" vid="ACT 17:28">ዚም ያሑ ባለ ቅኔዎች</para>
  <para style="q1" vid="ACT 17:28">‘ኢና እንመና የሑቲ ዴንጋንነ’ የባሮይኸሙ።<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />ኧጌሽ ኢና የሑቲ ዴንጋ በኸነ ‘እዝጌር በሰብ ብላት አሳብም በወርቅም በብርም ብምንም የሸከተዪ ቅርጽ ይመስር’ ባርነም ዋስብ ኤይጌባነ። <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />ኧጌሽ ሰቦች በድረ ዘበን ባለወሐር የሸከቶዪ እዝጌር በጭ ባረም ተቸለᎈንም፤ ኧሗም በገኝ ተገኚ ያኖ ሰቦች እንም ንስሐ ይገቦኸም ኤዘዘም፤ <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />እዝጌር በᎂጠረን ሰብ መሳ በዓለም እንም ᎈር በኢን ይፈርድወ ከነ ዌሰነም፤ ዚም ይንም ያርጓጐጠን ዛ የᎂጠረን ሑቲም የኢየሱስ ተሞት በዋትነሣውታው።”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />“በሞት ወተንሣ” ይብሪ ቃል በሰሞ ግዝየ አታተሕኖ አፌዞᎄ፤ እንጐዲም “ዚ ዘንጋ ትትዝነግ እንጐድ ግዝየ ኧሰማነ” ባሮይ። <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />በዛ አንቌ ጳውሎስ ተጀᎈሪ ወጣም ወረ፤ <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />አታት ሰቦችም ተሑቲጌ በወስማማ አመኖ፤ ታመኖዪም ሰቦች ግብት የአርዮስፋጎስ የጀᎈር አባል የኸኖዪ ዲዮናስዮስ የቧሪ ሰብም ደማሪስ የቧሪያ አት ምሽት እንጐዲም ሰቦች ባኖ።<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">ጳውሎስ በቆሮንቶስ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />በዛ አንቌ ጳውሎስ በአቴና ተነሣም ተቆሮንቶስ ከተማዬ ወረ፤ <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />በዛም የጳንጦስ ተወላጅ የኸነዪ አቂላ ይቡሪዪ አት አይሑዳዊ ሰብ ረከበ፤ የሮም ንጉሠ ነገሥት ቀላውዴዎስ አይሑድ እንም በሮም ይወጦኸም ዬዘዘ የነበረ ስለኸነ አቂላ ተምሽተሑ ተጵርስቅላጌ በኢጣልያ ገና ወተኘሑ ባነ፤ ስለኸነም ጳውሎስ ተሕኖዬ ወረም ተዄዄረኖ፤ <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />የሑቲ ሜና ልክ የሕኖኸም ድንኳን ይሴፍ የነበረ ስለኸነ ተሕኖጌ ቾናም ቁናዬ ይሸክት ባነ። <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />በሰምበት ሰምበተሑም ተአይሑድ ተግሪክም ሰቦችጌ በምኩራብ ውስጥ ቲዝነግ ያቴምኖዬ ይትጋደል ባነ።<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />ሲላስ ጢሞቴዎስም በመቄዶንያ በቸኖ ግዝየ ጳውሎስ “ኢየሱስ መሲሑ” በወበር የአይሑድ በወጋደል በወመስክር በዋትመርም ግዝየሑ እንም ያቼልፍ ባነ። <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />ቢኸንም አይሑድ በቃወሞይ በሰደቦይም ግዝየ የልባሰሑ ቲባ አራገፈም “ኧጌሽ ቢᎈርጅብኩ በነብሳሑ ጥፋቱ! እያ አላፊነት ኤነቢ፤ ተሗ ኧቀርስም ተአሕዛቤ አር!” ባረኖ። <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />ስለኸነም ተሕኖ ተላኘም ቲቶስ ኢዮስጦስ ተቧሪዪ ሰብ ቤቴ ወረ፤ ዚ ሰብ የእዝጌር ያመልክ ባነ፤ ቤተሑም በምኩራብ ᎀረ ባነ። <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />ቀርስጶስ ይቡሪዪ የምኩራብ አለአ ተአበሮሰሑጌ በጔታ አመነ፤ ብዠ የቆሮንቶስ ሰቦችም ጳውሎስ ቲዝነግ ሰሞም አመኖም ተጠመቆ።<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />ጔታም የጳውሎስ ምሳር በመና እኪ ቧረን፦ “አትጔና፤ ዘንግ፤ እንቁስ አትበር፤ <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />እያ ታኸጌንኩ፤ በዚ ከተማ ብዠ ሰቦች ነኖኝ ዉዶ ቃር ያሰላብከዬ ይችል ሟንም ኤነ።” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />ስለኸነም ጳውሎስ የእዝጌር ቃል የሕዝቢ ቲያትመር ቁና ዓመት ተስድስት መሬት በዛዬ ኤከሰ።<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />ጋልዮስ የአካይያ ገዢ በነበረወ ግዝየ አይሑድ ተገገዞም በጳውሎስ ᎈር ተነሦ፤ ተፍርድ ወንበር ኢፍት አቀረቦይም፤ <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />“ዚ ሰብ የሙሴ ሕጊ ቢቃወም ኤማ ሰቦች የእዝጌር ያመልኮኸም ይሸክት!” ባሮ።<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />ጳውሎስ መልስ የዋብ ተዝጋጀም አፈሑ ቲከፍት፤ ጋልዮስ የአይሑድ እኪ ባረኖ፦ “አሑ የአይሑድ ጐሳ! በደልም ይረዝ ወንጀል ተፌጸመብኩም ቢኸን ክሳሑ በትግሥት በሰማሑ ባነ፤ <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />ቢኸንም የቃላት፥ የሽምም፥ የሕጋሑም ትኦግቶ በኸነ የነብሳሑ ወባጀው፤ እያ በዚሕኖ ዘንጋ ወፍርድ አንሸ።” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />እኪም ባረም ተፍርድ መደሬ አትዌጣኖ። <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />በዛ ግዝየ በዛ ያኖ ሰቦች እንም የምኩራብ አለአዪ የሶስቴንስ ጠበጦም በጀᎈሪ ኢፍት ወኮይ፤ ዚ እንም ቲኸን ጋልዮስ ግድ አነᎄረን።<verse eid="ACT 18:17" /></para>
  <para style="s1">ጳውሎስ ተአንጾኪያዬ ወዘበረሑ</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />በዛ አንቌ ጳውሎስ ብዠ ከነ በቆሮንቶስ ቾና፤ በዛም በጔታ ጐባቢት ተስናበተም ጵርስቅላ አቂላም በመርከብ ተሶርያዬ ወረ። ስለትም ያነወ ስለኸነ ክንክራኦስ ቢቡሪዪ መደር ጉነነሑ ተላጨ።<note caller="-" style="x"><char style="xo" closed="false">18፥18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">ዘሑ. 6፥18</ref>። </char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ተኤፌሶኔ በሰሎ ግዝየ ጵርስቅላ አቂላም በዛዬ ገፈረኖ፤ ሑቲም ተምኩራቤ ገባም የአይሑድ ንግግር ይሸክት ባነ። <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />ብዠ ግዝየ ተሕኖጌ ዬክስኸም ቢጮቅሶይም የሕን አንባረኖ። <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />ቢኸንም ቲትላኝኖ፤ “የእዝጌር ፈአድ በኸነ ተዠበርኩም ኧቸኝ” ባረኖ፤ በኤፌሶን ተንሣም በመርከብ ወረ።<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />ተቂሣርያዬ በሰላ ግዝየ፤ ወጣም የቤተ ክርስቲያን ሰላምታ አቀረበ፤ በዛም ተአንጾኪያዬ ወረደ። <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />በዛዬም የቀል ግዝየ ኤከሰ፤ በዛ አንቌ በገላትያ በፍርግያም ገኝ ተመደር መደሬ ቲዥዋወር የደቀ መዛሙርቲ አብርታታ።<verse eid="ACT 18:23" /></para>
  <para style="s1">አጵሎስ በኤፌሶን በቆሮንቶስም</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />በዛ ግዝየ የአሌክሳንድርያ ተወላጅ የኸነ አጵሎስ ይቡሪ አት አይሑዳዊ ተኤፌሶኔ ቸኘ፤ ሑቲም የትማረም የቅዱሳት መጽሐፎች ተቂየም ይሒር ሰብ ባነ። <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />የጔታ ኤማ የትማረም በመንፈስ ቅዱስም ቆት የትመላ ኸነም የኢየሱስ በሱት ይሰብክ ያትመርም ባነ፤ የሕን አንኸንም ሑቲ ይሒኒ የዮሐንስ ያትᎀረን ጥምቀት ጠለለ ባነ። <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />ሑቲም በምኩራብ በድፍረት ይዝነግ ቀረሰ፤ ጵርስቅላ አቂላም በሰሞይ ግዝየ፤ ተቤተ ሕኖዬ ወሰዶም የእዝጌር ኤማ የጠቀለ አስትካከሎም አፍታቶነ። <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />አጵሎስ ተአካይያዬ የወወር ቤሰበ ግዝየ፤ በጔታ ጐባቢት አብርታቶይ፤ በዛዬ የነበሮዪ ደቀ መዛሙርትም ይቄበሮይኸም ደብዳቤ ጣፎነ። ዛዬ በሰላ ግዝየ በጸጋዪ የትነሣ አመኖም የነበሮዪ ወደል ረዳት ኸነኖ፤ <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />ኢየሱስ ክርስቶስ ወሕነሑ በቅዱሳን መጽሐፍ ቃል ቲያፍታታ በብረታ ኦገት በሕዝቢ ኢፍት የአይሑድ ይቌምኖ ባነ።<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">ጳውሎስ በኤፌሶን</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />አጵሎስ በቆሮንቶስ በነበረወ ግዝየ ጳውሎስ በነኒ ገኝ ተቸለፈም ተኤፌሶኔ ቸኘ፤ አታት ደቀ መዛሙርት ረከበም፤ <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />“ባመንኩ<note caller="+" style="f"><char style="fr" closed="false">19፥2</char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ባመንኩ አንቌ</char></note> ግዝየ መንፈስ ቅዱስ ተቀበርኩም ባነ?” ቲብር ተሳለኖ። ሕኖም “አንትቀበርነ፤ መንፈስ ቅዱስ ወንብራሑም ሰማነም አንሒርነ” ቲብሮ ዠበሮነ።<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />ጳውሎስም “ኧጌ፥ በምንኸማት ጥምቀቱ የጠመቅኩ?” ባረኖ። ሕኖም “የዮሐንስ ያትᎀረን ጥምቀቱ” ባሮይ።<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />ጳውሎስም “የዮሐንስ ጥምቀትማ በንስሐ ጥምቀት ባነ፤ የሕዝቢም የዝነጔኒ ‘ቢያ አንቌ ቢቸኚ ኧምኖ’ ቲብር ባነ፤ ሑቲም ኢየሱስ” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">19፥4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">ማቴ. 3፥11</ref>፤ <ref loc="MRK 1:4">ማር. 1፥4</ref>፣<ref loc="MRK 1:7-8">7-8</ref>፤ <ref loc="LUK 3:4">ሉቃ. 3፥4</ref>፤ <ref loc="LUK 16">16</ref>፤ <ref loc="JHN 1:26-27">ዮሐ. 1፥26-27</ref>። </char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />ዚ በሰሞ ግዝየ በጔታ በኢየሱስ ሽም ተጠመቆ። <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />ጳውሎስ ኧጀሑ በጫነቦ ግዝየ መንፈስ ቅዱስ በሕኖ ᎈር ወረደም ብንጐድ ቋንቋ ዝነጎ፤ ትምቢትም ወዘንግ ቀረሶ። <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />ሰቢ እንም ዐሥረዄት ቅጫ ባኖ።<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />ጳውሎስ ተምኩራቤ ወረም የሦስት መሬት ቅጫ የእዝጌር መንግሥት ቲኦግትም የሕዝቢ አፍታታም በድፍረት ያትመር ባነ። <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />አታተሕኖም ግትረኞች በወሕን፣ የወምን ፈአደኞች አነበሮ፣ የጔታም ኤማ ቢልቢጢጦ ያጥላሎ ባነ። ስለኸነም ጳውሎስ ገፈረኖም ወረ፣ ደቀ መዛሙርቲም የሟነሕኖ ወሰደም በጢራኖስ የትምርት አዳራሽ ውስጥ ከነ በከነሑ ያትመሮ ባነ። <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />ጳውሎስ ዚ የሸኰተኒ የዄት ዓመት ቅጫው፤ በዛም ግዝየ በእስያ ይነብሮ አይሑድ የግሪክም ሰቦች እንም የጔታ ቃል የወስማ ቻሎ።<verse eid="ACT 19:10" /></para>
  <para style="s1">ጔታ በጳውሎስ ኧጅ የሸኰተን ታምር</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />እዝጌር ስርም ያዴንቅ የኸኖዪ ታምር በጳውሎስ ኤማ ይሸክት ባነ። <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />በዚም መሳ የጳውሎስ ጅስም የለጐደኒ ልባስ መሐረብ ቲወስዶ የታቆዪም ቲያትሌግዶዮ ተባሸሕኖ ፈያ ይኸኖ ባነ፤ ሩክሲ መናፍስትም ይወጦ ባነ። <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />አጋንት በሰቦች ቲያትዌጦ ተመድር መደረሑ ይዞሮ አታት አይሑድ “ጳውሎስ ቢሰቡኲ በጔታ ኢየሱስ ሽም ትወጦኸም ኔዝዝነኩ” በወበር አጋንት በሰቦች የዋውጣ ይሞክሮ ባነ። <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />የአይሑድ የካሕናት አለአ የኸነ የአስቄዋ ሰበት ዴንጋ ዛምኸም ይሸክቶ ባነ።<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />ቢኸንም ሩክሲ መንፈስ “ኢየሱስም ኧሒን! ጳውሎስም ኧሒን! ኧረ አሑ ሟንኩ?” ባረኖ።<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />አት ሩክስ መንፈስ ያነወ ሰብ ዘለለም በወንቅ ብረታቦ፤ ስርም የቌመኖ ስለኸነ፤ ምዘዮም ኧንጨሕኖ ኸኖም በቤቲ ሰኮም ወጦ። <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />ዚም በኤፌሶን ቢነብሮዪ፤ በአይሑድም በግሪክም ሰቦቼ በትኴረ ግዝየ፤ እንም ጊናት ጠበጠኖ፤ በዚም የጔታ የኢየሱስ ሽም ተከበረ። <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />ታመኖዪም ሰቦች ብዠሕኖ ቡሼ ሜናሕኖ በወግልጥ ተናዘዞም ይቸኖ ባነ። <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />ብዠ አስማተኞችም የአስማት መጽሐፈሕኖ ስበሰቦም በሕዝቢ እንም ኢፍት አነደዶዮ፤ የመጽሐፎቺ ዋጋ ቲጌሙቺ አምሳ ሺ የጠገራ ብር ኸነም ተረከበ። <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />በዚኸማት የጔታ ቃል ስርም ቲቤትትም ውራግ ቲሸክት ያር ባነ።<verse eid="ACT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />ዚ እንም በኸነ አንቌ ጳውሎስ በመቄዶንያ በአካይያ ሸከተም ኢየሩሳሌም የወወር በመንፈሰሑ ኤሰበም “ዛዬ በሰላሑ አንቌ ተሮሜ ወወር ነነቢ” ባረ።<verse eid="ACT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 19:22" />ስለኸነም ቲያግለግሎዪ ሰቦች ዄቲ፥ ጢሞቴዎስ ኤራስጦስም፤ ተመቄዶንያዬ ላኸም ሑቲ ነብሰሑም በእስያ አውራጃ ቀል ከነ ኤከሰ።<verse eid="ACT 19:22" /></para>
  <para style="s">በኤፌሶን ሕላት ወተንሣሑ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />በዛ ግዝየ በጔታ ኤማ መሳ በኤፌሶን ወደል ሕላት ተነሣ። <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />ድሜጥሮስ ይቡሪ የጠገራ ብር ያነጥሪ አርጤሚስ የጣዖት ቤተ መቅደስ ምስያ በብር በወሰክት የአንጥረኞች ብዠ ትርፍ ይረሕቦ ባነ። <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />ስለኸነም ዚ ሰብ አንጥረኞቺም የሕኖኸም ሜና ያነኖዪ እንጐዲም ሰቦች ስበሰበም እኪ ባረኖ፦ “ሰቦች! ኢና ዱኒያ ኧረሕብነ በዚ ሜና የኸነኸም ቲሕሮ፤ <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />ዚ ጳውሎስ ‘በሰብ ኧጅ የሸከቶ ምስያ አማልክት አንከኖ’ ቲብር በኤፌሶን ጠለለ ቴይኸን ተቀል ገኝ አንከንም ብንም እስያ ምን ቅጫ ብዠ ሕዝብ ያግባባኸም ያቴመነኸም አሑ ነብሳሑ ያዠሑዪም የሰማሑዪው። <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />በዚኸማት ዚ ይና ሜና ወናቀሑ፤ ዚም ጠለለ ቴይኸን በእስያም ብንም ዓለም ሰብ እንም ያመልኲ የወደሊ አምላክ አርጤሚስ ቤተ መቅደስ ኤድገልል ኸነም ወቂየሑ፤ የሒቲም ወደልነት ወሻረሑ።”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />ሰቦቺም ዚ በሰሞ ግዝየ ቡሼኸም ማቶም፤ “የኤፌሶን አርጤሚስ ወደልያ!” ቲብሮ ው ይብሮ ቀረሰ። <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />ሒንጌም በከተማዪ እንም ሕላት ተነሣ፤ ሕዝቢም ቁናዬ በማመር የመቄዶንያ ተወላጅ የኸኖዪ ተጳውሎስጌም ያሮ የነበሮዪ መራርቻሑ፤ ጋይዮስ አርስጥሮኮስም ጠበጦም ጫወታ ቲያቴዥᎄ መደሬ ቲሮጦ ገቦ። <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />ጳውሎስ ተሕዝቢዬ የወወር ሸም ባነ፤ ደቀ መዛሙርት ኤያርኸም ኸተሮይ። <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />ተእስያ ገኝ ባለሥልጣኖችም ደቦዎቸሑ የኸኖ አታቶቺ ተጳውሎሴ ሰብ ላሖም “ሕዝብ ቲስበሰቡᎄ መደሬ ደፈረም ኔገባ” ሰብ ላሖም ጮቀሶይ። <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />በሕዝቢ ግብት ወደል ሕላት የነበረ ስለኸነ ይበዛዪ የመአር የስበሰቦኸም ኤይሒሮ ባነ፤ በዚ መሳ አቲ አት ዘንጋ ቲብር ው ቲብር እንጐዲ ኧሗም ኧንጐድ ቃር ቲብር ው ይብር ባነ። <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />የአይሑድም አሌክሳንደር በሕዝቢ ግብት ግፈፎም ቲፍቴዬ ባቸኖይ ግዝየ፤ አታቶቺ ይዝነግኖኸም ው ባሮ፤ ሑቲም ይኦግትኖዬ ሸም እንቁስ ይብሮኸም በምልክት ጠቀሰኖ። <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />ቢኸንም ሑቲ አይሑዳዊ ወሕነሑ በሐሮ ግዝየ እንም በቁና ጣምባ፤ “የኤፌሶን አርጤሚስ ወደልያ” ቲብሮ ዄት ሰዓት ቅጫ ው ባሮ።<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />በመጨረሻ የከተማዪ ዋና ጠሐፊ፥ የሕዝቢ እንቁስ አትበኘም እኪ ባረ፤ “የኤፌሶን ሰቦች፤ የወደሊ አርጤሚስ ቤተ መቅደስ በሰሜ የወረደዪ ምስሌታንም ይቅሮ የኤፌሶን ከተማ ሕዝብ ወሕነሑ ኤይሒር ሟኒ ባረ? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />ዚም ይለጋ ሰብ ሟንም ዬነ ስለኸነ ጭጭ ትብሮኸም በዋተክል ቡሼ ቃር ተወሰክት ትቀቀሮኸም ይጌባ። <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />የአርጤምስ የጣዖት ቤተ መቅደስ ያንዘረፎዪ በአምላከናም ᎈር የስድብ ቃል ያንዘንጎዪ ሰቦች ተዚዬ ጠበጥኩም ቸኘሑም። <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />ኧጌሽ፤ ድሜጥሮስ ተሑቲጌም ያኖዪ አንጥረኞች በሟንም ᎈር አቤቱታ ባነኖ፤ ፍርድ ቤቲ ኩፍታው፤ ዳኞችም ነኖ፤ ክስ ዋቅርብ ይችሎ። <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />እንጐድ ትሸዎይ ቃር ባነ በሕጋዊ ፍርድ ጀᎈር ይታዥ። <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />ዚ ባንከነ ኧኳ በሸከተዪ ቃር ‘ሕላት አትኔሦም’ ቧርነም ኤይኰሺኸም ያጔና፤ ‘ዚ ሕላት በመአር መሳ ተነሣ’ ቧሪም ቢሰልነ ይብኔዪ መልስ ኤነነ” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />ዚም ባረም የስበሰቦዪ ሰቦች ይትቤተኖኸም ሸከተ።<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">የጳውሎስ ተመቄዶንያዬ ተግሪክም ገኜ ወወር</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />ሕላቲም ጭጭ በባረ አንቌ ጳውሎስ የደቀ መዛሙርቲ ቁናዬ አጤራም በምክር ቃል አብርታታኖ፤ ተስናበተኖም ተመቄዶንያዬ ወረ። <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />በዛ ቢቸለፍቦዪ መደር የምዕመናን በብዠ ምክር ቲያብርታታ ተግሪክ ገኜ ወረ። <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />በዛም ሦስት መሬት ኤከሰ፤ በዛ አንቌ በመርከብ ተሶርያዬ የወወር ኤሰበ፤ አይሑድ በሑቲ ᎈር ሤራ ወሰክተሕኖ በሐረ ግዝየ በመቄዶንያ አዘር የወዘበር ዌሰነ።<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />የጲርሑስ ትኸ ሶጳጥሮስ ተቤርያዪ፥ አርስጥሮኮስ ሲኮንዱስ ተተሰሎንቄ፥ ጋይዮስ ተደርቤ፥ ጢሞቴዎስ፥ ቲኪቆስ ጥሮፊሞስም ተእስያ ቁናዬ ወሮ። <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />ሕኖ በደሮነም ወሮም በጢሮአዳ ኤከሶነ። <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />ኢና በቂጣ በዓል አንቌ በፊልጵስዩስ በመርከብ ተሳፈርነም ባምስት ከነ ሕኖ ታኖᎄዬ ተጢሮአዳዬ ሰላነም በዛ ሰበት ከነ ቾናነም።<verse eid="ACT 20:6" /></para>
  <para style="s1">የጳውሎስ መጨረሻ ጉብኝት በጢሮአዳ</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />በሳምቲ በመጀመሪያዪ ከነ<note caller="+" style="f"><char style="fr" closed="false">20፥7 </char><char style="fqa" closed="false">በሳምተሑ የመጀመሪያዪ ከነ ምሳር፦ ውርሰምበት ወበሩ </char></note> ቂጣ ፍረረመም ቁናዬ የወብራ ተስበሰብነ፤ ጳውሎስ የመናገሑ ወወር የነበረወ ስለኸነ የስበሰቦዪ ሰቦች ይዝነግ ባነ፤ ንግግረሑም ግብት ምሳር ስን አገለፈ። <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />ኢና በስበሰብነᎄዪ ፎቅ ብዠ መብራት ባነ። <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />አውጤኪስ የቧሪ አት አልቡላ በመስኮት ᎈር ቾናም ባነ፤ ጳውሎስ ንግግረሑ በዋግልፈሑ አልቡላዪ ይረዝ ወኔት ጠᎄጠን፤ ወኔት የቌᎀን ስለኸነ በሦስታለኘዪ ፎቅ ተተቴ ወጠቀ፤ ሰቦች በነሦይ ግዝየ ᎀተም ረከቦይ። <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />ቢኸንም ጳውሎስ ወረደም በርጂ ᎈር ሙግ ባረም ኤንቀᎈንም “ገና በሕይወት ነነ፤ አትደንብጦ!” ባረ። <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />ጳውሎስ ተፎቂዬ ተዠበረም ወጣም ቂጣ ፈረመም ተአማኞቺጌ በና፤ ይዛኝም ስን ተሰቦቺጌ ቲዝነግ ቤከሰ አንቌ ወረ። <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />ሰቦቺም የተረፈዪ አልቡላ ተቤቴ ወሰዶይ፤ በዚም ስርም ተጥናኖ።<verse eid="ACT 20:12" /></para>
  <para style="s1">ጳውሎስ በጢሮአዳ ተሚጢሊዬ ወወረሑ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />ኢናም የጳውሎስ የወቀበር ዬሰብነ ስለኸነ ኢና በደርነም ተመርከቢዬ ወርነ፤ በዛም በመርከብ አሶስ ስን ወርነ፤ ዚ የሸከትኔዪም ጳውሎስ በየብስ በግረሑ ያሬ ዬሰበ የነበረ ስለኸነው። <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />በአሶስ በትራከብነ አንቌ፤ ተቌበርኔም ቁናዬ በመርከብ ተሚጢሊኒዬ ወርነ። <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />የመናጊም በዛዬ ተነሣነም በኪዮስ ኢፍት ሊፍት ታነዪ መደሬ በመርከብ ሰላነም፤ ቢቄጥሊም ከነ ተሳሞሴ ተጔናነም የመናጊ ሚሊጢን ሰላነ። <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />ጳውሎስ በእስያ አውራጃ ብዠ ዋክስ ያንሸ ስለኸነ፤ ተኤፌሶኔ ቴይገባ ተቸለፈም የወወር ዌሰነ፤ ቢቸል በዓለ አምሳ በኢየሩሳሌም የወዋል ድገደገም ባነ።<verse eid="ACT 20:16" /></para>
  <para style="s1">ጳውሎስ የኤፌሶን ሽማግሌዎች ወስናበተሑ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />ጳውሎስ ሚሊጢን ተኤፌሶኔ ሰብ ላኸም የቤተ ክርስቲያን ሽማግሌዎች አጤራ፤ <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />ተሑቲዬ በቸኖ ግዝየ እኪ ባረኖ፦ ተእስያዬ በገባሑወ ከነ ቀረሰም እንጌ ታሑጌ ምንኸም የነበርኩኸም አሑ ቲሒሮ፤ <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />በአይሑድ ሤራ መሳ መከራ ቢሰላቢም በፍጡም በቁና ቀልብነት ቢንባም የጔታ አግለግል ባነ። <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />በአደባባይም ኸነ በቤት ተቤታሑ ትናትመርኩ ይጠቅሙሑዪም እንም ኤወደኩሑም አንኸንም፥ አትም ቃር አናቂየሑቡኩ። <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />አይሑድም ኸኖ የግሪክ ሰብ ንሰሐ ገቦም ተእዝጌሬ ይዠበሮኸም በጔታና በኢየሱስ ክርስቶስ ያምኖኸም ምሰከርኩኖ። <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />ኧሗም ዛዬ ትንሰላ ምን ይሰላቢኸም ታንሒር በመንፈስ ቅዱስ በግድ ባሮኝም ተኢየሩሳሌምሜ ወወረኛው። <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />የሕን አንኸንም በከተማ ተከተማዪ ኧጉጀኘ ምካት ይገጥሜኸም መንፈስ ቅዱስ ኤወዴም። <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />የእዝጌር የጸጋ ወንጌል የዋትመር በጔታ በኢየሱስ የቌበርኩን የዋገልግል ግዴታ በፌጠምኩ የሕይወተኛ ዋጋ አኒቡ፤ የሕይወተኛም አንሳሳነ።<note caller="-" style="x"><char style="xo" closed="false">20፥24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 ጢሞ. 4፥7</ref>። </char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />ኧሗ ስን ባሑ እንም ግብት ተዥዋወርኩም የእዝጌር መንግሥት ኧሰብክ ባነ፤ ተሗ ቀረሰም ታሑ ሟንም ኢፍተኛ ኤያዥኸም ኧሒር። <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />ስለኸነም ታሑ ቁና ቢጠፋ አላፊነት ዬነቢኸም በኳዪ ከነ ኧምሰክርንኩ። <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />የእዝጌር አሳብ እንም ኤወደኩሑ አንኸንም አትም ያቀኘክብኩ ቃር ኤነ።<verse eid="ACT 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28" />መንፈስ ቅዱስ አሑ ሥልጣን ያነኖ መሪዎች<note caller="+" style="f"><char style="fr" closed="false">20፥28 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ተይትምሌከት ይቅሮዪ</char></note> ሸከተም ሾመናሑም፤ ኧጌሽ የነብሳሑ የወጀዪም ተቀሮ፤ እዝጌር በፎለሑ ትኸ ደም የዋጀኒ ቤተ ክርስቲያን ቀሮ። <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />እያ በወርኩ አንቌ የወጀዪ ኤያዝኖ የተኩላዪኸም ጨካኞች የኸኖ ሰቦች ይቡሮቡኩኸም ኧሒር። <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />ዛምኸም አታት ሰቦች በግብታሑ ተነሦም ጠማማ ትምርት በዋትመር ብዠ አማኞች የፎለሕኖ ተከታይ ይሸክቶዮ። <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />ስለኸነም እያታታሑ ሦስት ዓመት ምሳር ተክናን ኢንባኛ ትናፈስ የመከረኩኸም ትታስታውሶ ተቀሮ።<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“ኧሗም እዝጌር ዛምኸም ዬንጥኩዬም በቅዱሳኒ እንም ግብት ርስት ይብኩዬ ይችሊ የጸጋዪ ቃል ዐደራ ኢብኩ። <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />እያ የሟንም ብር ወይ ወርቅ ወይ ልባስ አናላሑ። <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />በፎለኛ ኧጅ ሸከትኩም ነብስያኛም ኸነ መራርቾቸኛ ኧረዳኖ የነበረኸም አሑ ነብሳሑ ቲሒሮ። <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />‘ቲቌበር የጠቀለ ይብ የትባረከው’ ይብሪ የጔታ የኢየሱስ ቃል በዋስታውስ፥ በኧጀና ሸከትነም የቌጦዪ ወግዝ ይጌባነኸም በብዠ ኤማ አቴዠኩሑም።”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />በዛ አንቌ ጳውሎስ ትንመሕኖጌ ተንብረከከም ጤለየ። <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />እንም በኮም የጳውሎስ ኤንቀፎም ሳሞይ። <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />ይልቅሸሑ ስርም ያመጠጠኖ፥ “ተሗ ቀረሰም ኢፍተኛ አታዞ” ባረኖም የነበረ ስለኸነው፤ የመርከቤ ስንም ጌገቶይ።<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">ጳውሎስ ተኢየሩሳሌሜ ወወረሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />ተሕኖ በትላኘነ አንቌ በመርከብ ተሳፈርነም በቀጥታ ቆስ ቲቡሪዪ ደሴቴ ወርነ፤ የመናጊም ተሩድ ደሴቴ ሰላነ፤ በዛም ተጳጥራ ከተማዬ ወርነ። <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />በዛዬም ተፊንቄ ገኜ ያሪ መርከብ ረከብነም በሑቲ ተሳፈርነም፤ ወወር ቄጠልነ። <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />የቆጵሮስም ደሴት ተጉራዬ ገፈርነም ተሶርያ ገኜ ወርነም ተጢሮስ ወደቤ ወርነ፤ መርከቢ ጭነተሑ በዛዬ ዋራግፍ ባነወ። <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />በዛዬ የጔታ ደቀ መዝሙር ሸነም ረከብነ ተሕኖጌ ሰበት ከነ ኤከስነ። ሕኖም በመንፈስ ቅዱስ ኤወደኖም የጳውሎስም “ተኢየሩሳሌሜ አትወር” ባሮም ኤወዶይ። <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />በዛዬ ኤክስነᎄ ግዝየ ቲያልቅ ተላኘነዮም ኤማና ወርነ፤ እንም ትንሽታሕኖም ተዴንጋሕኖጌ ኸኖም ተከተማዪ ውጪ ስን ጌገቶነ፤ በባሪም ᎀረ ተንምብረከክነም በጤለይነ አንቌ ተስናበትነ። <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />በዛ አንቌ ኢና በመርከብ ትንሳፈርነ ሕኖ ተቤተ ሕኖዬ ተዠበሮ።<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />በጢሮስ ተነሣነም ተጴጤሌማይሴ ሰላነ፤ በዛዬ በጔታ ጐባቢት ረከብነም ሰላምታ በቴበብነ አንቌ ተሕኖጌ ቁና ከነ አቸለፍነ። <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />የመናጊ በዛዬ ወጣነም ቂሣርያ ወርነ፤ በዛዬ ተሰበቲ ዳቆን አቲ ተኸነዪ ተወንጌላዊ ፊልጶስ ቤቴ ገባነም ተሑቲጌ ቾናነ።<note caller="-" style="x"><char style="xo" closed="false">21፥8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">ሐዋ. 6፥5</ref>፤ <ref loc="ACT 8:5">8፥5</ref>። </char></note> <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />ሑቲ ትምቢት የወዘንግ ስጦታ ያነነማ አርበት ያናግበማ ግሬድ ባነሜ። <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />የብዠ ከነ በዛዬ በቾናነᎄ ግዝየ አጋቦስ ይቡሪዪ ነብይ በይሑዳ ገኝ ቸኘ። <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />ዚ ነብይ ቲናዬ ቀረበ፤ የጳውሎስ ጥብጣብ ወሰደም የነብሰሑ ኧጅም ኧግረሑ አገደም፥ “መንፈስ ቅዱስ የዚ ጥብጣብ ባለቤት በኢየሩሳሌም ያኖዪ አይሑድ የዚምኸም አገዶም የአሕዛብ አቸለፎም ይቦይ ይብር” ባረ።<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />ዚም በሰማነ ግዝየ ኢናም በዛዬ የነበሮዪ ሰቦችም ጳውሎስ ኢየሩሳሌም ኤያርኸም ጮቀስኔ። <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />ጳውሎስም “ዚኸም በኴሑም የመአር ሒነኛ ባዘን ትሰብሮይ? እያ የጔታ ኢየሱስ ሽም በኢየሩሳሌም ኧጉጀኘ የወሕን ጠለለ ቴይኸን የወሙትም የዝጋጀሑንክ” ቲብር ዠበረ።<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />ምክረናም አንቌበር በባረነ ግዝየ “ኧጌሽ የጔታ ፈአድ የሕን” ባርነም ገፈርኔ።<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />በዛዬ ቀል ከነ ቤከስነ አንቌ ግብረናም አዝጋጀነም ተኢየሩሳሌሜ ወርነ። <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />በቂሣርያ የነበሮ አታት ደቀ መዛሙርት ቁናዬ ቸኖ፤ ሕኖም በምናሶን ቤት ናᎈይነኸም ተሑቲ ቤቴ መሮነ፤ ዚ ሰብ በደረም የጔታ ደቀ መዝሙር ባነ፥ የቆጵሮስ ገኝ ሰብ ባነ።<verse eid="ACT 21:16" /></para>
  <para style="s1">ጳውሎስ በኢየሩሳሌም የያዕቆብ ወጐብኘሑ</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />ኢየሩሳሌም በሰላነ ግዝየ በጔታ ጐባቢት በብልቃት ተቌበሮነ። <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />የመናጊም ጳውሎስም እንጐደናም ያዕቆብ የወዥ ወርነ፤ የቤተ ክርስቲያን ሽማግሌዎች እንም በዛዬ ባኖ። <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ጳውሎስ ይንም ሰላምታ ባበ አንቌ በሑቲ መሳ እዝጌር አሕዛብ ግብት የሸኰተኒ እንም አትባት ቴረከኖ። <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />ዚም በሰሞ ግዝየ እንም የእዝጌር አምሰገኖ፤ የጳውሎስም እኪ ባሮይ፦ “ጐቤና! በብዠ ሺ ይትቆጠሮ በጔታ ጐቤና በአይሑድ ግብት ያኖኸም እንም የሙሴ ሕጊ ቅናትመኞች የኸኖኸም ቲሒር፤ <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />አኸ በአሕዛብ ግብት ይነብሮዪ አይሑድ እንም ዴንጋሑ ጤበን አታውኖ፤ ሤራ አትፈጥሞ ትትብር በዋትመር የሙሴም ሕጊ ይሸሮኸም ትሸክት ቲቡሪ ኦጀ ሰሞም።<note caller="-" style="x"><char style="xo" closed="false">21፥21 </char><char style="xt" closed="false"><ref loc="ACT 11:28">11፥28</ref>። </char></note> <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />ኧጌሽ ምን ወሰክት ይጠቅል? ወተኛኸ የኢንም ይሰሞ፤ <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />ስለኸነም ኢና ኧብርነከዪ ሰክት፤ ቢና ግብት ስለት ያነቦ አርበት ሰብ ነኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥23-24 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">ዘሑ. 6፥13-21</ref>። </char></note> <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />የሕኖም ውስድማኸ ተሕኖጌ ሕንም ነብሳኸ አንጣ፤ ጉነነሕኖም ይላጮኸም የቤተ መቅደስ ይᎅዪ የመባ ዋጋ ክፍሎ፤ ዚም ብትሸክት ባኸ ᎈር ዬወጂዪ እንም ኤድገልል ወሕነሑም አኸም ነብሳኸ ሕጊ ትቂየ ወሕናኸ እንም ይሒሮ። <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />ተአሕዛብ ጐሳ ያመኖዪ ‘የጣዖት በወርደሑ መሳ ሩክስ ስንቅ አትብሮ፤ ደምም የስንቅኸም አትብሮ፤ ታነቀም የᎀተ እንሰሳ በሠር አትብሮ፤ ተዝሙት ስሖ’ ይብሪ ውሳኔ የጠበጠ ደብዳቤ ጣፍነም ላክነኖም።”<note caller="-" style="x"><char style="xo" closed="false">21፥25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">ሐዋ. 15፥29</ref>። </char></note><verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />ተዛ አንቌ ጳውሎስ የሰቦቺ ወሰደም የመናጊ ተሕኖጌ ነብሰሑ አነጣ፤ ይነጦᎄዪ ከነዎች መቸ ይኸንኸም ስለእያታቲም ይᎅ የመባ ዋጋ ይከፈልወ ግዝየ መቸ ይኸንኸም የዋትኴር ተቤተ መቅድሴ ገባ።<verse eid="ACT 21:26" /></para>
  <para style="s1">ጳውሎስ በቤተ መቅደስ ጠᎄጪ</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />ሰበቲ ከነ ይፌጠሜ ቲቃረብ በእስያ የቸኖ አይሑድ የጳውሎስ በቤተ መቅደስ በወዠሕኖ የሕዝቢ እንም አቴደሞም ጠበጦይ፤ <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“የእስራኤል ሰቦች! ርዶነ! ሕዝበና ሕገናሙ ዚም መደር ቲሰደብ በገኚ እንም ያነዪ ሕዝብ ያትመር ዚ ሰቡ፤ ዚም አንኸን ቧረንም አሕዛብ የኸኖ የግሪክ ሰቦች ተቤተ መቅደሴ በዋግባ ዚ ጠለለ ቴይኸን የትቄደሰ መደር ሩክስ ሸከተም!” ቲብሮ ው ባሮ። <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />ዚም የባሮᎄ መሳ ተዚ ኢፍቴ ኤፌሶን ጨኘት ጥሮፊሞስም ተጳውሎስጌ በከተማ አዞይም የነበረ ስለኸነ የሑቲ ተቤተ መቅደሴ ጠᎄጠንም የገባ መሰረኖም ባነ።<note caller="-" style="x"><char style="xo" closed="false">21፥29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20፥4</ref>። </char></note><verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />ከተማዪ እንም ተሬበሸ፤ ሕዝቢ እንም ቲሮጦ ቁናዬ ቸኖም፥ የጳውሎስ ጠበጦም ቲሸቦ በቤተ መቅደሴ አወጦይ፤ የቤተ መቅደሲ ወዝገብም ሒንጌም ተዘጎ። <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />ሰቦች የጳውሎስ ይቀጥሮዬ በሸዎ ግዝየ “የኢየሩሳሌም ከተማ እንም ተሬበሸም” ይብር መልክት የሮማውያን ያርብ አዛዤ ሰላ። <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />ስለኸነም ሑቲ ወታደሮቺም የመቶ አለኦቺም አትዄተለም በዋተክል ቲሮጥ ተሰቦቺዬ ወረ። ሰቦቺም አዛዢም የወታደሪ ባዞ ግዝየ የጳውሎስ ወውካ ገፈሮ። <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />አዛዢም ቀረበም የጳውሎስ ጠᎄጠንም በዄት ሰንሰለት ኧጉጀኘ ይኸንኸም ኤዘዘ፤ በዛ አንቌም ሟ ወሕነውም ምን የሸከተኸም የወሐር ሸም ምረᎀረን። <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />ሕዝቢም አታተሕኖ አት ቃር ቲብሮ፥ እንጐዲ ኧንጐድ ቃር ይብሮ ባነ፤ አዛዢ በሕዝቢ ውታ የትነሣ የርጋገጠዪ ዘንጋ የወሐር ያንቻለ ስለኸነ ጳውሎስም ተወታደሮቺ ሰፈሬ ይወስዶይኸም ኤዘዘ። <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />ጳውሎስ ተደረጃዪዬ በሰላ ግዝየ ሕዝቢ እንም በብረታ ማት ተንሠሣም አደጋ ያሰላወዬ በወሴሑ ወታደሮቺ ጮሮይም ወሮ። <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />ሕዝቢም “የቁጥሪ!” ቲብሮ ው በወበር ይትዄተሎይ ባነ።<verse eid="ACT 21:36" /></para>
  <para style="s1">ጳውሎስ ይክላከልወ ንግግር ወሰክተሑ</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />ወታደሮቺ ተአርብ ሰፈሬ ጠበጦይም ያሮዬ ቲይኸን፤ ጳውሎስ የአርብ አዛዢ፤ “አት ዘንጋ ኢውደኸኸም ፍቅድኒ?” ቧረን። አዛዢም እኪ ቧረን፤ “የግሪክ ቋንቋ ቲሒር? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />አኸ ተዚ ኢፍቴ ዐመጥ አትኔሣኸም፤ አርበት ሺ ነብስ ይቀጥሮዪ ተበረሐዬ ያሼፈትከ ግብጻውያን አንከንከ?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />ጳውሎስም “እያ በኪልቅያ ቢትረከቢም ፈያ ሽም ቧነኒ በጠርሴስ ከተማ የጨኘሑ አይሑዳዊንኩ፤ ታውሽ የሕዝቢ ኧዝነግኸም ፍቅድኒ” ቧረን።<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />ይዝነግኸም በፈቈደነ ግዝየ ጳውሎስ በደረጃ ᎈር ቈመም ሕዝቢ እንቁስ ይብርኸም በጀሑ ጠቀሰ፤ ሕዝቢ ጭጭ በባረ ግዝየ በዕብራይስጥ ቋንቋ እኪ ቲብር ወዘንግ ቀረሰ፤<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“ጐባቢቶቸኛ አቦቸኛም! ዘ፥ ኧሗ አቀርብንኩዪ መከላከያ ስሞኝ!” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />በዕብራይስጥ ቋንቋ ቲዝነግ በሰሞ ግዝየ የጠቀለ ጭጭ ባሮ፤ ጳውሎስም ንግግረሑ በወቀጥል እኪ ባረ፦<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />እያ በኪልቅያ ቢትረከቢ በጠርሴስ ከተማ የጨኘሑ አይሑዳዊንኩ፤ የላቅኩ በዚ በኢየሩሳሌም ከተማው። አስተማሪኛም ገማልያል ባነ፤ የአቦቸና ሕጊ ተቂየሑም የትማርኩ ልክ ኧኳ አሑ ትሸክቶይኸም የእዝጌር በመንፈሳዊ ቅናት አግለግል ባነሑ።<note caller="-" style="x"><char style="xo" closed="false">22፥3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">ሐዋ. 5፥34-39</ref>። </char></note> <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />የክርስትና እምነት ይትዄተሎ እንም ኧቀጥሮ ስን አሳድድ ሰብ ባነሑ፤ ገሜም ኧንሽታ አግድም ተወሕኔ ቤቴ ይገቦኸም ኧሸክት ባነሑ። <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />ዚም የኢን ወሕነሑ የካሕናት አለአዪ የባሊኦች ጀᎈር እንም ይምሰክሮኒ። ዛምኸም በደማስቆ ያኖዪ ነዚ ሰቦች አገድኩም ተኢየሩሳሌሜ የዋተኝ የዋትቀጣም ያቸሌኸም በደማስቆ ቲትረከቦዪ ጐሳሕኖ የጣፎዪ ደብዳቤ የቄበርኩን በሕኖቱ።<note caller="-" style="x"><char style="xo" closed="false">22፥4-5 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8፥3</ref>፤ <ref loc="ACT 26:9-11">26፥9-11</ref>። </char></note><verse eid="ACT 22:5" /></para>
  <para style="s1">ጳውሎስ ተጔታዬ ምንኸም የዠበረኸም</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />እያ ተደማስቆዬ ትናር ተከተማዬ ትንቀርብ ግብት ክናን ቲኸን ሒንጌም ወደል ብራን በሰሜ በዙሪያኛ አንብራጣ። <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />በዛ ግዝየ ባፈር ᎈር ወጠቅኩ፤ ሳውል! ሳውል! የመአር ታሳድዴ? ይብር ጣምባ ሰማሑ። <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />እያም ጔታ፤ አኸ ሟንከ? ባሑን፤ “ሑቲም፤ ‘አኸ ታሳድዴ የናዝሬቲ ኢየሱስንኩ’ ባሬ። <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />ቲያጌ የነበሮዪ ሰቦች ብራኒ አዞ አንኸንም ሑቲ ቲያዝናጌ ጣምባሑ አንሰሞ። <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />እያም ‘ጔታ! መአር ንሰክት?’ ባሑ። ጔታም ‘ተንሣማኸ ተደማስቆዬ ወር፤ ትሸኩቺ ይትጌባኸ ቃር እንም በዛዬ ይውጅከ’ ባሬ። <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />ተብራኒ ዋንብራጣ የትነሣ ወዥ ያንቻልኩ ስለኸነ ቲያጌ የነበሮዪ ሰቦች ኧጀኛ ጠበጦም ቲመሮኝ ተደማስቆዬ አሰሎኝ።<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“በዛ ሐናንያ ይቡሪ አት ሰብ ባነ፤ ዚ ሰብ በደማስቆ ቢነብሮዪ አይሑድ እንም የምሰገነ፥ እዝጌር በሙሴ ኤማ ያᎄን ሕጊ ያከብር መንፈሳዊ ሰብ ባነ። <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />ሑቲ ቲያዬ ቸኘም በሜጠቀኛ ቈመም ‘ጐቤኛ ሳውል! ኤናኸ ዠበረም የዥንከ!’ ባሬ፤ ሒንጌም ዔነኛ አዠ፤ የሑቲም ተምሌከትኩን። <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />ሑቲም እኪ ባሬ፤ ‘የአቦቸና አምላክ ፈአደሑ ቲሒርኸም ጻድቂ ታዥኸም ጣምባሑም ትሰማኸም በደረም ሜጠረናኸም። <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />መሳሑ ዚም የሸከተ ያዠዀኒም የሰሟዀኒ በሰብ እንም ኢፍት የሑቲ ምስክር ትኸንኸሙ። <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ኧጌ ኧሗ መአር ትቂየ? ተንሣማኸ የጔታ ሽም አመንከም በወጥራ ተጠመቅ፤ ተአጢያታኸም ታጠብ።’<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“በዛ አንቌ ተኢየሩሳሌሜ ተዠበርኩም በቤተ መቅደስ ብንጤልይወ ግዝየ መና አዠሑ። <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />ጔታም ተገለጠኒም ‘አኸ ስለእያ ቲᎅ ምስክርነት ኤቌበሮ ስለኸነ ታቴክስ አተክልም ተኢየሩሳሌሜ ውጣ’ ባሬ፤ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />እያም እኪ ባሑ፤ ‘ጔታ! በምኩራቢ ትናር ባኸ ያመኖዪ እንም ያገድኩኸም የወካሑኸም ሕኖ ነብሰሕኖ ይሒሮ። <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />ያኸ ምስክር የነበረዪ እስጢፋኖስ በቈጠሪ ግዝየ እያም ነብሰኛ ቢቀጥሮዪ ሜጠቅ ቈምኩም ተሕኖጌ በዘንጋዪ ተስማማሑም ባነ፤ ልባሰሕኖ ኧቂየ ባነ፤’<note caller="-" style="x"><char style="xo" closed="false">22፥20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">ሐዋ. 7፥58</ref>። </char></note> <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />ጔታም ‘በሩቄ ታኖዬ ተአሕዛቤ ኧለክኸ ስለኸነ ተንሣማኸ ወር!’ ባሬ።”<verse eid="ACT 22:21" /></para>
  <para style="s1">ጳውሎስ የሮም ገኝ ዜጋ ወሕነሑ መገለጠሑ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />ዚጌ ስን ሕዝቢ እንም የጳውሎስ ንግግር ይሰሞይ ባነ፤ በዛ አንቌ ጣምባሕኖ ከፍ አበኖም፦ “ዚኸማቲም ሰብ ባፈር ᎈር የሙት! ዚኸማቲ ሰብ በሕይወት ወንብር ኤይጌቧን!” ቲብሮ ው ባሮ። <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />ሕኖም ው ቲብሮ በወናደድ ልባሰሕኖ ያውዛውዞ አፈር ተሰሜዬ ይቤትኖ ባነ። <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />አዛዢም ዚ ባዠ ግዝየ የጳውሎስ ተወታደሮች ተፎሊስ ጣባዬ ያገቦይኸም ኤዘዘ፤ ሕዝቢ በሑቲ ᎈር የመአር ዚ ያሕር ው ይብሮኸም የወሐር ቲገርᎉ ይሙረሙሪኸም ኤዘዘ። <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />ቢኸንም በጠፍር ዌጠሮም ይገርፎዬ ቲዝጋዶ ጳውሎስ በሜጠቀሑ የቌመዪ የመቶ አለአ “የሮም ገኝ ዜግነት ያነን ሰብ ቴᎈርጅᎄ ትገርፎዬ በሕጊ ᎈቈጅንኩም?” ቧረን።<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />የመቶ አለአዪ ዚ በሰማ ግዝየ ተዋና አዛዢዬ ወረም፥ “መአር ትሸክቴው? ዚ ሰብ የሮም ገኝ ዜጋው!” ቧረን።<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />ስለኸነም ዋና አዛዢም ተጳውሎሴ ቀረበም፥ “እንዴ አውዴ፤ አኸ የሮም ዜጋንከ?” ቧረን፤ ሑቲም “ኤክ፥” ባረ።<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />ዋና አዛዢም “እያ ዚ ዜግነት የስየሑን በብዠ ዋጋው” ባረ፤ ጳውሎስም “እያም በሮም ገኝ ዜግነት ተጨኘሑም” ባረ።<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />ስለኸነም ነዛ ይምረምሮዬ ተዝጋዶም የነበሮዪ ሰቦች ሒንጌም ተሑቲ ራቆ፤ ዋና አዛዢም የሮም ዜጋ የኸነዪ ሰብ በሰንሰለት ወግደሑ በትሬዳ ግዝየ ጔና።<verse eid="ACT 22:29" /></para>
  <para style="s1">ጳውሎስ በአይሑድ ጀᎈር ኢፍት ወቅርበሑ</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />የመናጊ ዋና አዛዢ፥ አይሑድ የጳውሎስ የከሰሶይ በመአር መሳ የኸነኸም የወሐር ሸ፤ ስለኸነም የካሕናት አለኦች የጀᎈሪ አባል እንም ይስበሰቦኸም ኤዘዘ፤ የጳውሎስም በታገደወ ፈታም ወሰደን በደረጃዪ አወረደንም ቢፍተሕኖ አቀረᎄን።<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />ጳውሎስም የጀᎈሪ ትክ ባረም ተምሌከተም “ጐባቢት! ኧኳ ስን እንጌ በእዝጌር ኢፍት የነበርኩወ በንጡ ሕሊና ተዥባበርኩም” ባረ። <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />በዛ ግዝየ የካሕናት አለአዪ ሐናንያ የጳውሎስ አፈሑ ይወኮይኸም በጳውሎስ ሜጠቅ የቆሞዪ ሰቦች ኤዘዘ። <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />በዛ ግዝየ ጳውሎስ የሐናንያ፥ “አኸ በኖራ የሌሰኒ ዘንግን ትመስር!<note caller="+" style="f"><char style="fr" closed="false">23፥3 </char><char style="fqa" closed="false">አኸ በኖራ የሌሰኒ ዘንግን ትመስር! </char><char style="ft" closed="false">ᎈራኸ ይደንቅ፤ ውስጣኸም ቡሼው። </char></note> አኸም እዝጌር ይወካኸ! በሕጊ መሠረት ይያ ዘንጋ ትፈርዴ ቾናኸም ትናነ ያለ ሕጊ ይወኮኝኸም ቴዝዝ?”<note caller="-" style="x"><char style="xo" closed="false">23፥3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">ማቴ. 23፥27-28</ref>። </char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />በዛ የነበሮዪ ሰቦች የጳውሎስ “የእዝጌር የካሕናት አለአ ትሳደብ?” ባሮይ።<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />ጳውሎስም “ጐባቢት! የካሕናት አለአ ወሕነሑ አንካርኩ ባነ፤ መሳሑም ‘በሕዝባኸ አለአ ᎈር ቡሼ ቃል አትዘንግ’ ይብር ተጣፈም” ባረ።<note caller="-" style="x"><char style="xo" closed="false">23፥5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">ዘፀ. 22፥28</ref>። </char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />ጳውሎስ በዛ በነበሮዪ ሰቦች ግብተሕኖ ሰዱቃውያን ግብተሕኖ ኧሗም ፈሪሳውያን ወሕነሕኖ ሐረም “ጐባቢተኛ! እያ ተፈሪሳዊ የጨኘሑ ፈሪሳዊንኩ፤ ዘ! ኧሗ በፍርድ ኢፍት የቀረብኩ ባᎅም ተስፋ በሟቾቺ ትንሣኤ መሳው” ቲብር ጣምባሑ ከፍ አበኘም በጀᎈሪ ግብት ዝነጔ።<note caller="-" style="x"><char style="xo" closed="false">23፥6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">26፥5</ref>፤ <ref loc="PHP 3:5">ፊልጵ. 3፥5</ref>። </char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />ጳውሎስ ዚ በዝነጔ ግዝየ በፈሪሳውያን በሰዱቃውያንም ግብት መናክስ ተነሣም ጀᎈሪ ዄቴ ኸነ። <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />ሰዱቃውያን “ትንሣኤ ኤነ፤ መላይካም ኤኖ፤ መንፈስም ኤነ” ቲብሮ ፈሪሳውያን “ነዚ እንም ነኖ” ባሮም ያምኖ።<note caller="-" style="x"><char style="xo" closed="false">23፥8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">ማቴ. 22፥23</ref>፤ <ref loc="MRK 12:18">ማር. 12፥18</ref>፤ <ref loc="LUK 20:27">ሉቃ. 20፥27</ref>። </char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />በዛ ግዝየ ወደል ሕላት ኸነ፤ ተፈሪሳውያን ጐሳ የኸኖ አታት የሕጊ አስተማሪም ተነሦም “ኢና በዚ ሰብ ᎈር አትም ቡሼ ቃር አረኸብነᎄ፤ መንፈስ ወይ መላዪካ ዝነጔንም ይኸን፤ ኢና መአር ኧሒርነ?” በወበር ኦገቶ።<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />መናክሲም ቲከር ስለወረ ሰቦቺ የጳውሎስ ኔቡጨጭቆይ ጔናም ዋና አዛዢም “ውረዶማሑ የጳውሎስ በሰቦች ግብት ንጥቆማሑ ናሞይ! ተአርቢ ሰፈርም ውስዶይ!” በወበር የወታደሮቺ ኤዘዘ።<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />የመናጊ ምሳር ጔታ በጳውሎስ ሜጠቅ ቈመም “አይዞአኸ በኢየሩሳሌም የምሰከርከኒኸም ዛምኸም በሮም ትምሰክርኒዬ ይጌባኸ” ቧረን።<verse eid="ACT 23:11" /></para>
  <para style="s1">የጳውሎስ የወቅጥር የሸከተ ሤራ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />በዛኘ ግዝየ አይሑድ ተስበሰቦም “የጳውሎስ ታንቀጥርነ ስንቅ አንበራነ፤ አንሰጭነ” ባሮም ማሎ። <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />በዚ ሤራ የስማሞ ሰቦች ቁጥረሕኖ ተአርባ ይበዛ ባነ። <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />ሕኖ ተካሕናት አለኦቼ ተሽማግሌዎቼ ወሮም እኪ ቲብሮ ኤወዶዮ፤ “የጳውሎስ ታንቀጥርነ ስንቅ አንቀምስነኸም በጥብቅ ተመመልነም፤ <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />ስለኸነም አሑ ተጀᎈሪጌ ተስማማሑም በዋጥብቅ ትምረምሮይ ቃር ያነኸም በዋትመስር የጳውሎስ ያቸኖኑኩኸም የዋና አዛዢ ተሳሎይ፤ ኢናም ተዚዬ ተወስላሑ ኢፍት ኧቀጥርነዬ ተዝጋጀነም።”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />ቢኸንም የጳውሎስ የተም ትኸ ዚ ሤራ የሰማ ስለኸነ ተወታደሮቺ ፎሊስ ጣቢያዬ ገባም የጳውሎስ ኤወደን። <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />ጳውሎስም ተመቶ አለኦች አቲ ጠራም “ዚ ትኸ ያርብ አዛዢ ይዝነግን ቃር ያነን ስለኸነ ተሑቲዬ አቅርቡ” ቧረን። <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />የመቶ አለአዪም ትኸዪ ተአዛዢዬ ጠበጠም ገባም “ኧጉጀኘዪ ጳውሎስ ጠሬም ዚ ትኸ የአኸ ይውድኸ ቃር ያነን ስለኸነ ታኸዬ አቀርቡኸም ጮቀሴ” ባረ።<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />ዋና አዛዢም የትኸዪ ኧጅ ጠበጠም ሽቅ አበኘም “ቲውዴ ቃር መአሩ?” ቲብር የሟነሑ ተሳለን።<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />ትኸዪም እኪ ባረ፤ “አይሑድ የጳውሎስ ዘንጋ በዋጥብቅ ይምረምሮ መሰሮም ነገ ተጀᎈሪዬ ታቀርብኖኸም ይሰሎከዬ ተስማሞም። <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />ቢኸንም የሕን አትበኖ፤ የሑቲ ታንቀጥርነ ስንቅ አንበራነ፤ አንሰጭነ በወበር የትመመሎ ተአርባ ይበዞ ሰቦች የሑቲ የወቅጥር አደፈጦም፤ ኧሗ ሕኖ ይቅሮ ያኸ መልስ ጠለለው።” <verse eid="ACT 23:21" /><verse number="22" style="v" sid="ACT 23:22" />ዋና አዛዢም “ዚ ዘንጋ ይያ ዋውድሐ የሟንም አታውድ” ባረም የትኸዪ አስናᎄተን።<verse eid="ACT 23:22" /></para>
  <para style="s1">ጳውሎስ ተቂሳርያዬ ወትላኸሑ</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />በዛ አንቌ የአርብ ዋና አዛዢ ተመቶ አለኦቺ ዄቲ ጠራም “ምሳር ሦስት ሰዓት ቲኸን ተቂሣርያዬ ያሮ ዄት መቶ ወታደሮችም ሰባ ፈረዘኞች፤ ዄት መቶ ቀለጥ ይረጎዪም አዝጋዶ፤ <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />የጳውሎስም ፈረዝ አዝጋዶነም ተገኝ ገዢዬ ተፊልክሴ በፈያ ይሰላኸም ሰክቶይ” ባረኖ። <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />እኪ ይብር ደብዳቤም ጣፈ፤ <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />“በቀላውዴዎስ ሉስዮስ፤ የክቡር ገኝ ገዢዪ ፊልክስ! ሰላም ያኸ የሕን! <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />ዚ ሰብ አይሑድ ጠበጦም ይቀጥሮዬ ባነ፤ እያ የሮም ዜጋ ወሕነሑ የሐርኩ ስለኸነ ተወታደሮቺጌ ሰላሑም አተረፍኩን። <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />በመአር መሳ የከሰሶይኸም የወሐር ሸሑም ተጀᎈረሕኖዬ አቀረብኩንም ባነ። <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />የከሰሶይም ሕገሕኖ ቢምሌከት ቃር ወሕነሑ ተሬዳሑ፤ ቢኸንም የሞት ወይ የወግድ ያሰላን ቃር ኤነ። <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />ዚ ሰብ የወቅጥር ሤራ የሸከተኸም በሰማሑ ግዝየ ሒንጌም ታኸዬ ላክሑን፤ ከሳሾቸሑም በሑቲ ᎈር ያነኖ ክስ ባኸ ኢፍት ያቀርቦይኸም ኤወድኩኖም።”<verse eid="ACT 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="ACT 23:31" />ስለኸነም ወታደሮቺ በቴዘዞይ መሠረት፤ የጳውሎስ ጠበጦም በምሳር አንቲጳጥሪስ ስን ወሰዶይ። <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />የመናጊ ፈረዘኞቺ ተጳውሎስጌ ጋዠሕኖ ያሮኸም ሸከቶም ሕኖ ተአርብ መደሬ ተዠበሮ። <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />ፈረዘኞቺ ተቂሣርያ በሰሎ ግዝየ ደብዳቤዪ የገኝ ገዢዪ አቦይም የጳውሎስ ቢፍተሑ አቀረቦይ። <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />ገኝ ገዢዪ ደብዳቤዪ ባነበበ አንቌ የጳውሎስ “ቴቲዋኘ አውራጃንከ?” ቲብር ተሳለን፤ የኪልቅያ ሰብ ወሕነሑ በሐረ ግዝየ፤ <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“ከሳሾቻኸ ቴይቸኖ ዘንጋሐ ኧሰማ” ቧረን። በሔሮድስ ቤተ መንግሥት ውስጥ ይቁሬኸም ኤዘዘ።<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">ጳውሎስ በአይሑድ ወከሰሰሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />ተአምስት ከነ አንቌ የካሕናት አለአዪ ሐናንያ ታታት ባሊቆች ጠርጠሉስም ቲቡሪዪ ጠበቃጌ ተቂሳርያ ገኜ ወረ፤ ሕኖም ተገኝ ገዢዪ ተፊልክሴ ቀረቦም የጳውሎስ ከሰሶይ፤ <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />ጳውሎስ ጠሬም በቸኘ ግዝየ፥ ጠርጠሉስ እኪ ቲብር ክሰሑ ቀረሰ፤</para>
  <para style="p" vid="ACT 24:2">“የትከበርከ ፊልክስ! ባኸ መሳ ብዠ ሰላም ረከብነም፤ በፈያ አትዳደራኸ የሕዝበና ወሸሸል ተረከበም፤ <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ስርም የትከበርከ ፊልክስ ዚ ፈያ ወሰክታኸ ተመድር መደረሑ ተግዝየ ግዝየሑም ኧቌበርነዪ ከፍ በባረ ምስጋናው። <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />ኧሗም ግዝያኸ ታናባክን ባጭረሑ ኢውደኸዪ በሜናነታኸ ትሰማነኸም ኧጮቅስከ፤ <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />ዚ ሰብ ቡሼ ባሸ ኸነብነም፤ በዓለም ባኖዪ አይሑድ እንም ᎈር ሕላት ያትኔሣ፤ የናዝራውያን<note caller="+" style="f"><char style="fr" closed="false">24፥5 </char><char style="ft" closed="false">ናዝራውያን ወበር ነጣ አወጣነ ባሮም ነብሰሕኖ የላኖኖ። </char></note> ይቡሪዮዪ መሪ ኸነም ረከብኔም። <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />የቤተ መቅደስም ያረክሴ ቲሞክር ጠበጥኔም፤ [በሕገናም መሠረት ኧፈርድነᎄዬ ኤሰብነም ባነ፤ <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />ቢኸንም የአርብ አዛዢ ሉስዮስ ቸኘም በወደል ቆት ተጀናም ነጠቀም ወሰደን። <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />ከሳሾቺም ታኸዬ ይቸኖኸም ኤዘዘ፤] ዚ በሑቲ ᎈር ያቀረብኔዪ ክስ እንም የኢን ወሕነሑ አኸ ነብሳኸ የሑቲ ምረመርከም ታርጋግጤ ትችል።” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />አይሑድ “ዚ እንም ዘንጋ የኢኑ” ቲብሮ በክሰሑ ተስማሞ።<verse eid="ACT 24:9" /></para>
  <para style="s1">ጳውሎስ በፊልክስ ኢፍት የመከላከያ ንግግር ወሰክተሑ</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />ገኝ ገዢዪ ፊልክስ በጀሑ ጠቀሰም ጳውሎስ ይዝነግኸም ፈቈደነ፤ ጳውሎስም እኪ ቲብር ዠበረ፤</para>
  <para style="p" vid="ACT 24:10">“የብዠ ዓመት የዚ ገኝ ገዢ ወሕናኸ ኧሒር ስለኸነ የቀረበቢ ክስ መከላከያኛ ባኸ ኢፍት ትናቀርብ ስርም በብልቃቱ፤ <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />የወስግድ ተኢየሩሳሌሜ በወርኩ ተዐሥረ ዄት ከነ ኤበዛኸም አኸ ነብሳኸ ዋርጋግጥ ትችል፤ <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />በቤተ መቅደስም ኸነ በምኩራብም በከተማ ውስጥ ተሟንምጌ ቲኦግትም የሕዝቢም የሕላት ትናትንሴሳ አረኸቦኝ፤ <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />ኧሗ ያቀረቦቢ ክስ እንም አትም ማስረጃ ያቀርቦንከዬ ኤይችሎ። <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />ቢኸንም ዚ ኧገልጥንከዬ ኧወድ፤ ሕኖ ገደር ኤማ ቢብሮዪ የአይማኖት ቡድን እምነት የአቦቸናም አምላክ አመልክ፤ እዝጌር በሙሴ ኤማ ባᎄን ሕግ በነብዮችም መጽሐፍ የጣፈዪ እንም አምን። <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />ሕኖም ተስፋ ይሸክቶይኸም እያም ጻድቃን አጢያተኞችም ተሞት ይትነሦኸም በእዝጌር ተስፋ ኧሸክት። <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />ስለኸነም በእዝጌር በሰብም ኢፍት ንጡ ሕሊና ይነብሬኸም እንጌ እጋደል።<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“በኢየሩሳሌም በወጣሑ ብዠ ዓመት በቸለፈ አንቌ የጐሳኛ ይኸን ኧጉዣ ዋጋ የእዝጌር ይᎅ መባ ጠበጥኩም ቸኘሑ። <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />በቤተ መቅደስም የረከቦኝ ዚም ትንሸክቱ፤ በዛ ግዝየ የወንጣ ሥራት ፌጠምኩም ባነ፤ ቲያጌ ብዠ ሕዝብ አነበረ፤ ሕላትም አንተሣ።<note caller="-" style="x"><char style="xo" closed="false">24፥17-18 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">ሐዋ. 21፥17-28</ref>። </char></note> <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />ቢኸንም በእስያ የቸኖዪ አይሑድ በዛዬ ባኖ፤ ሕኖ ቢያ ᎈር የክስ መሳ ባነኖ ባኸ ኢፍት የቅርቦም የዘንጎ። <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />በዛ አንቌ በጀᎈሪ ኢፍት በቀረብኩ ግዝየ የሸከትኩን በደል ያነኸም ነዚ የቀረቦ ሰቦች የዘንጎ። <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />ኢንም በግብተሕኖ ቈምኩም ‘የሟቾቺ ትንሣኤ ነነ በወበረኛ ኧኳ የወፍርድ ቢፍታሑ ቀረብኩም’ ባሑም ከፍ በባረ ጣምባ ዝነጔሑም፤ በዚ አኸንም እንጐድ የሸከትኩን ዘንጋ ኤነ።”<note caller="-" style="x"><char style="xo" closed="false">24፥21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሐዋ. 23፥6</ref>። </char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />ፊልክስም የጔታ ኤማ በደንምብ ይሒር የነበረ ስለኸነ “የአርብ አዛዢ ሉስዮስ በቸኘ ግዝየ፥ የዘንጋሑ ውሳኔ ኢብ” ባረም አስናበተኖ። <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />የጳውሎስ ይቅየ የነበረዪም መቶ አለአ “ብዠም ነጣነት ታትዀትር በወጠንቀቅ ቈየን፤ ደቦቸሑም ያሸን እንም ጠበጦነም ቲቸኖ አትሕትርወ” ቧረን።<verse eid="ACT 24:23" /></para>
  <para style="s1">ጳውሎስ በፊልክስ በድሩሲላም ኢፍት ወቅርበሑ</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />ተቀል ከነ አንቌ ፊልክስ ዱሩሲላ ተቧሪያ ተአይሑዳዊ ምሽተሑጌ ቸኘ፤ የጳውሎስም አጤራም በኢየሱስ ክርስቶስ ስለወምን ቲዝነግ ሰሟን። <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />ጳውሎስ ስለ ጽድቅ ራሳኸ የወግዛ ይቸኚም ፍርድ በዝነጔ ግዝየ ፊልክስ ጔናም “ኧሗ ወር፤ ቲትሜቼ ኧንጐድ ግዝየ አጤራኸ” ቧረን። <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />ፊልክስ በጳውሎስ ግቦ የወቀበር ተስፋ ይሸክት ባነ፤ ስለኸነም ብዠ ግዝየ የጳውሎስም አጤራም ያዝናግን ባነ።<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />በዄት ዓመት አንቌ ጶርቅዮስ ፊስጦስ በፊልክስ መደር ተሸገረ፤ ፊልክስ የአይሑድም የዋትብላልቅ ሸም የጳውሎስ ባጐጂኸም ገᎈረን።<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s1">ጳውሎስ በፊስጦስ ኢፍት ቀረበ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />ፊስጦስም ተአውራጃዄ ሥልጣን በጠበጠ አንቌ በሦስት ከነ አንቌ፤ ተቂሣርያ ተኢየሩሳሌሜ ወጣ። <verse eid="ACT 25:1" /><verse number="2-3" style="v" sid="ACT 25:2-3" />በዛዬም የካሕናት አለኦች አታት ግድድር የአይሑድ ጐሣዎች በጳውሎስ ᎈር ክሰሕኖ አቀረቦ፤ “የጳውሎስ ተኢየሩሳሌሜ በዋተኝ ይና ፈያ ቃር ሰክትንነ” ቲብሮ አቆመሮም ጮቀሶይ፤ ዚም የባሮᎄ መሳ የጳውሎስ ቤማ ቅሮም ይቀጥሮዬ የሸዎ ስለኸነው። <verse eid="ACT 25:2-3" /><verse number="4" style="v" sid="ACT 25:4" />ፊስጦስም “ጳውሎስ በቂሣርያ ወሕኔ ቤት ይቁሬው፤ እያም ኧሗ ከሞ ተዠበርኩም ተዛዬ አር፤ <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />ባለሥልጣኖቻሑ ቲያጌ ተቂሣርያዬ የወሮ፤ ጳውሎስ የሸኰተን በደል ባነ በዛዬ የክስሶይ” ባረኖ።<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />ፊስጦስ ተስሙት ወይ ተዐሥር ከነ ያንበዛ ግዝየ ተሕኖጌ ባቸለፈ አንቌ ተቂሣርያዬ ወረ፤ ዛዬ በሰላ ግዝየ የመናጊ ቢᎈርጅᎄ ወንበር ᎈር ቾናም የጳውሎስ ያቀርቦይኸም ኤዘዘ። <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />ጳውሎስ በቀረበ ግዝየ በኢየሩሳሌም የቸኖዪ አይሑድ ኸበቦይም ቈሞም፥ ማስረጃ ይረሕቦነዬ ኤይችሎዪ ብዠ ከባድ ክስ አቀረቦᎄ፤ <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />ጳውሎስም “እያ ተአይሑድ ሕጊ ᎈርም ኸነ በቤተ መቅደሲም ወይ በቄሣር ᎈር የሸከትኩን በደል ኤነ” ቲብር የመከላከያ መልሰሑ አበ።<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />ፊስጦስም የአይሑድ የዋትብላልቅ ሸም የጳውሎስ “ተኢየሩሳሌሜ ወርም ስለኸነዪም ዘንጋ በዛዬ ቢያ ኢፍት ትፋረዴ ትሸ?” ቧረን። <verse eid="ACT 25:9" /><verse number="10" style="v" sid="ACT 25:10" />ጳውሎስም እኪ ባረ፤ “ኧሗም ቢኸን ፍርድ ወርክብ ብንችልወ፤ በቄሣር ፍርድ ወንበር ኢፍት ቈምኩም፤ አኸ ነብሳኸም ቢጌባ ቲሒንኸም በአይሑድ ᎈር አትም በደል አንሰከትኩ፤ <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />በደለኛ በኸንኩም በሞት ያትቄጣ በደል በሸከትኩ ተሞት ንትርፍ አንብር፤ ቢኸንም የሕኖ ክስ ኤድገልል በኸነ ሟንም የሑቲ አቸለፈም ይቤዬ ኤይችል፤ እያ ተቄሣሬ ጌፈቸ ባሑም።”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />በዛ ግዝየ ፊስጦስ ተአማካሪዎቸሑጌ፤ ተዝናጔም “ተቄሣሬ ጌፌቸ የባኸ ስለኸነ፤ ተቄሣሬ ታር” ቧረን።<verse eid="ACT 25:12" /></para>
  <para style="s1">ጳውሎስ በአግሪጳ በበርኒቄም ኢፍት ወቅርበሑ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />ተቀል ከነ አንቌ፤ ንጉሥ አግሪጳ በርኒቄም የፊስጦስ ይሰግዶነዬ ቂሣርያ ወረዶ። <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />በዛዬም ብዠ ከነ በወቶናሕኖ ፊስጦስ የጳውሎስ ዘንጋ እኪ ቲብር የንጉሥ አግሪጳ ጐለጠነ፤ “ፊልክስ አገደም የገᎈረን በዚ አት ሰብ ነነ፤ <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />እያ በኢየሩሳሌም በነበርኩወ ግዝየ የካሕናት አለኦች የአይሑድ ሽማግሌዎችም የዚ ሰብ ዘንጋ ባምለከቶኝ አንቌ ኧፈርድወኸም ተሳሎኝ። <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />እያ ‘ተከሳሽ በከሳሾች ኢፍት ቈመም የከሰሰወ ዘንጋ የመከላከያ መልስ ቴይብ የኰሰሺዪም አቸለፈም ዋብ የሮማውያን ሥራት አንከነ’ ባሑም ዠበርኩኖ። <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />ስለኸነም የከሰሶዪ ተስበሰቦም ተዚዬ በቸኖ ግዝየ ታኔክስ የመናጊ ቢᎈርጅᎄ ወንበር ቾናሑም የጳውሎስ ቲፍተኛዬ ያቀርቦይኸም ኤዘዝኩ፤ <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />ከሳሶቺም የወዘንግ በᎀረሑ በቈሞ ግዝየ እያ ቡሼ ዘንጋ ሸከተም ባሑም የጌመትኩኒም ቅጫ የክስ ያሰላ አትም ዘንጋ አናቅረቦᎄ። <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />ይጠቅልሽ ስለአይማኖተሕኖም ይሸክቶᎄ ᎀተም የነበረ ስለኸነዪ፤ ጳውሎስም ሕያውኩ ይቡኒ ስለኸነዪ ሰብ፤ ስለ ኢየሱስ ይኦግቶይ ባነ። <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />እያም እኪኸማቲ ዘንጋ ወመርምር ያትሜኬ ስለኸነ የጳውሎስ ‘ተኢየሩሳሌሜ ወርም በዛዬ በዚ ዘንጋ ቲኦግቴዬ ትወድ?’ ባሑን። <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />ቢኸንም ጳውሎስ ዘንጋሑ በሮም ንጉሠ ነገሥቲ ይታዥነኸም ጌፌቸ በባረ ግዝየ እያም ተቄሣሬ ኧለኩ ስን በወሕኔ ቤት ዬክስከም ኤዘዝኩ።”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />አግሪጳም የፊስጦስ “እያም ዚ ሰብ ቲዝነግ ወስማ ኧሸ” ቧረን። ፊስጦስም “ነገ ትሰሟን” ቧረን።<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />ስለኸነም የመናጊም አግሪጳ በርኒቄም ልባስ መንግሥተሕኖ ለበሶም በወደል ግርማ ኸኖም በአርብ አለኦች በከተማዪ ግድድር ሰቦችም ቴጀቦም ቸኖም ቲስበሰቦᎄ አዳራሼ ገቦ፤ በዛም አንቌ ፊስጦስ የጳውሎስ አጤራን። <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />በዛ ግዝየ፤ ፊስጦስ እኪ ባረ፤ “ንጉሥ አግሪጳ፤ ዛምኸም በዚ ቁናዬ ያነሑ እንም፤ ዚ ሰብ ታዞይ? በኢየሩሳሌምም በዚ በቂሳርያም ይነብሮ አይሑድ እንም፤ ዚ ሰብ ተሗ ቀረሰም በሕይወት ወንብር ኤይጌቧን በወበር ው ቲብሮ ጮቀሶ። <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />እያም በሞት ያትቌጣን አትም በደል አረከብኩወ፤ ሑቲ ተሮም ንጉሠ ነገሥቴ ጌፌቸ በወበረሑ ተዛዬ ኧለኴ ዌሰንኩ። <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />የሕን አንኸንም ስለሑቲ የጌቶቸኛዬ ኧጠᎉ የርጋገጠ ዘንጋ ኤኔ፤ ስለኸነም በሙረᎀሪ አንቌ ኧጠᎉ ዘንጋ ኧረሕብኸም ባሑም ቢፍታሑ ይልቅሽ ንጉሥ አግሪጳ! ቢፍታኸ አቀረብኩንም። <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />ኧጉጀኘ ተነኔ ቲትለክ፥ የትከሰሰወዪ መሳ አለወዘንግ ገውነት መሰሬም ታዤም።”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s1">ጳውሎስ በአግሪጳ ኢፍት የሸኴተን ንግግር</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />አግሪጳም የጳውሎስ፤ “ስለራሳኸ ትዝነግኸም ተፌቀደንከም” ቧረን፤ በዛ ግዝየ ጳውሎስ ኧጀሑ ዝረጋም እኪ ቲብር ይክላከልወዪ መልስ አበ።<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“ንጉሥ አግሪጳ! አይሑድ በከሰሶኝ ዘንጋ እንም ኧኳ ባኸ ኢፍት የመከላከያ መልስ ትኒብ ስርም ኧትብላለቅ። <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />በተለይም አኸ የአይሑድም ሴራ፥ ኦገት እንም ተቂየኸም ትሒር፤ ስለኸነም በትዕግሥት ትሰሜኸም ኧጮቅስከ።<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“ተትኽነተኛ ቀረሰም ምንኸም የነበርኩኸም አይሑድ ይሒሮ፤ ቢፍቴ ቀረሰም በሕዝበኛ ግብትም፥ በኢየሩሳሌም የነበርኩኒ ሕይወተኛ ይሒሮይ። <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />ኧሗም ይምሰክሮዬ ቢፈቅዶ በአይማኖተናም ስርም ወግ አጥባቂ ተኸነዪ ቡድን ፈሪሳዊ ኸንኩም የነበርኩኸም ኢፍቴ ቀረሰም ይሒሮ።<note caller="-" style="x"><char style="xo" closed="false">26፥5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሐዋ. 23፥6</ref>፤ <ref loc="PHP 3:5">ፊልጵ. 3፥5</ref>። </char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />ኧሗም የፍርድ በዚዬ የቆምኩ እዝጌር የአቦቸናም ያᎄን የቃል ጉዳ ተስፋ በወሰክተኛው። <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />ተዚዬ ተስፋዬ የወስላ ዐሥረ ዄቲ ጐሣ የእዝጌር ምሳር ተክናን ቲያመለኮ ይቅሮ ባነ፤ ንጉሥ! እያም በአይሑድ የከሰስኩወ በዚ ተስፋ መሳው። <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />እዝጌር የሟቾቺ ያትኔሣ ወሕነሑ የመአር ባሑዬ ይታመኔ አንቻለ?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“እያ ነብሰኛ የናዝሬቲ የኢየሱስ ሽም የቻልኩን ቅጫን ወቃወም ነነቢ ባሑም ኤስብ ባነ።<note caller="-" style="x"><char style="xo" closed="false">26፥9-11 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8፥3</ref>፤ <ref loc="ACT 22:4-5">22፥4-5</ref>። </char></note> <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />በኢየሩሳሌም የሸከትኩኒም ዚ ባነ፤ ተካሕናት አለኦች በቌበርኩን ሥልጣን ብዠሕኖ ቅዱሳንም ተወሕኔ ቤቴ ይገቦኸም ሸከትኩም፤ ቲቀጥሮዮም ቲቀጥሮዮዪ ሰቦችጌ ተስማማሑም። <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />ብዠ ግዝየ በምኩራበሕኖ ይትቀጦኸምም በጔታ ᎈር የስድብ ቃል ይዝነጎኸም አትጌድዶ ባነ፤ በሕኖ ᎈር ስርም ማቸሑም ትንጐዲ የውጪ ገኝ ከተሞቼ ቴይቀይ ወርኩም አሳድዶ ባነ።<verse eid="ACT 26:11" /></para>
  <para style="s1">ጳውሎስ ተክርስቶሴ ወዘበረሑ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“የዚም ዘንጋ ተካሕናት አለኦች ሙላ ሥልጣን ትዛዝም ተቀበርኩም ተደማስቆ ከተማዬ አር ባነ፤ <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ንጉሥ! ቤማ ትናነሑ ልክ ግብት ክናን ቲኸን ተጬት ብራን ይበዛ ብራን አዠሑ፤ ዚም ብራን ቲያ ቲያምጌ በወሮዪ ሰቦች ዙራ በሰሜ አበራ። <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />እንመናም ባፈር ᎈር ወጠቅነ፤ እያም በዕብራይስጥ ቋንቋ፤ ‘ሳውል፤ ሳውል፤ የመአር ታሳድዴ? ይወጐᎄዪ ብረት ብትቃወም ያኸ ይጎዳኸ’ ይብር ጣምባ ሰማሑ። <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />እያም ‘ጔታ! አኸ ሟንከ?’ ባሑ፤ ጔታም እኪ ባሬ፦ ‘እያ አኸ ታሳድዴ ኢየሱስንኩ። <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />ኧሗም ተንሣም፥ በግራኸ ቁም፤ እያ የትገለጥኩንከ ኧሗ ይያ ባዠኸወ ቲፍቴዬም እያ ያኸ ብንትገለጥወ ቃር አገልጋይ ምስክርም ትኸኔኸም ኧሾምከዬ ሸሑሙ። <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />በእስራኤል ሕዝብ ተሕኖዬም ትንለክኸ ተአሕዛብ ኧጅ አተርፍኸ። <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />ዔነሕኖ ትከፍትኖኸም ተጨለማ ተብራኔም ታወጣኖኸም ተሼይጣንም ሥልጣን ተእዝጌሬ ትዠብሮኸም ኧሸክትንከ፤ ሕኖም ቢያ በወምነሕኖ መሳ የአጢያተሕኖ አፉታ ይረሕቦ፤ በትሜጠሮዪ ግብትም ርስተሕኖም ይሰዶ።’<verse eid="ACT 26:18" /></para>
  <para style="s1">ጳውሎስ ስለ ሜናሑ ዋትረዳሑ</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“ስለኸነም ንጉሥ አግሪጳ! በሰሜ የታዤዪ መና ኤበሑ አንባሑ። <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />ቢኸንም በመጀመሪያ በደማስቆ ይነብሮ፤ ቄጠለም በኢየሩሳሌምም በይሑዳ ያኖዪ አሕዛብ እንም፤ ንስሐ ይገቦኸም ተእዝጌሬ ይዠበሮኸም፤ የንስሐም ፍርየ ያቴዞኸም ገለጥኩም ዝነጔሑ።<note caller="-" style="x"><char style="xo" closed="false">26፥20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">ሐዋ. 9፥20</ref>፣<ref loc="ACT 9:28-29">28-29</ref>። </char></note> <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />በዚ መሳ አይሑድ በቤተ መቅደስ ትናነሑ ጠበጦኝም፥ ይቀጥሮኜ ሞከሮ። <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />ኧኳ ስን የእዝጌር እርዳታ አንትላኜ፤ ስለኸነም ይንሲም የኒኢዪም ትንምሰክር በዚ ቈምኩም፤ ነብዮች ሙሴም በደሮም እኪ ይኸን የባሮዪም ተወዘንግ አንኸንም እንጐድ አትም አንዘንጔሑ። <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />ሕኖም የዝነጎ ‘ክርስቶስ መከራ ይቌበር፤ ተሞት በወተንሣም ይፍቴ ኸነም ይተርፉᎄ ብራን የእስራኤል ሕዝብም የአሕዛብ ይገልጥ’ ባሮሙ።”<note caller="-" style="x"><char style="xo" closed="false">26፥23 </char><char style="xt" closed="false"><ref loc="ISA 42:6">ኢሳ. 42፥6</ref>፤ <ref loc="ISA 49:6">49፥6</ref>፤ <ref loc="1CO 15:20">1 ቆሮ. 15፥20</ref>። </char></note><verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />ጳውሎስ ዚ ቲዝነግ ትናነ ፊስጦስ “ጳውሎስ! ኧሗሽ ቴሰስከም፤ ብዠ ወትማራኸ ተውስነቴ ይወስድኸው!” ቲብር ው ባረም ዝነጔ።<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />ጳውሎስም እኪ ቲብር ዠበረ፦ “ስርም የትከበርከ ፊስጦስ! የኢኒም ሱት ዘንጋ ኧዝነግ አንኸንም ውስ አንከንኩ። <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />ቢፍተሑ ቢልቢጢጦ የዝነጔሑኒ ንጉሥ ዚ ዘንጋ ይሒር። ዚም በሽሙቸ ያንትሰከተ ስለኸነ ንጉሢ ይትሬዳንኸም የኢነተኘንኩ። <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />ንጉሥ አግሪጳ! የነብዮቺ ታምን አንከን? ታምንኸም ኧሒር።”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />አግሪጳም የጳውሎስ “አኸ በዚ በቀል ግዝየ ውስጥ ክርስቲያን ትሸክቴዬው እኮ” ቧረን። <verse eid="ACT 26:28" /><verse number="29" style="v" sid="ACT 26:29" />ጳውሎስ “ባጭርም የሕን በብዠ ግዝየ አኸ ጠለለ ታትኸን ኧኳ ንግግረኛ የሰሞዪ እንም ተዚ ኧጉጀኘ ወሕነኛ ቲቀይ ይያኸም ይኸኖዬ የእዝጌር ኧጮቁሽ!” ባረ።<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />በዛ አንቌ ንጉሢም፤ ገኝ ገዢዪም፤ በርኒቄም ተሕኖጌ የቾኖዪም ተነሦ፤ <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />በዛም ወጦም ቲያሮ፥ “ዚ ሰብ የሞትም ኸነ የጉጀኘ ያበቋን አትም ቃር አንሰከተ” ተበበሮ። <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />አግሪጳም የፊስጦስ፤ “ዚ ሰብ ቄሣር ጌፌቸ ቤይብር ቢነብር ወግፍር ይቸል ባነ” ቧረን።<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s1">የጳውሎስ ተሮሜዬ የወሰጂኸም</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />ኢጣልያ በመርከብ ናርነኸም በትዌሰነ ግዝየ ጳውሎስም እንጐደሕኖ ኧጉጀኘ የኸኖዪ በአውግስጦስ ገዢ ክፍለ አርብ ውስጥ የነበረዪ ዩልዮስ ይቡሪዪ መቶ አለአ አትሬከቦዮ። <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />በአድራሚጥዮን ተነሣም በእስያ አውራጃ ባር ᎀረ ᎈር ታኖዪ ወደቦቼ ቢያሪ መርከብ ተሳፈርነም በባር ወወር ቀረስነ፤ በተሰሎንቄ ይነብር የነበረዪ የመቄዶንያ ሰብ፤ አርስጥሮኮስም ቲናጌ ባነ። <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />የመናጊም ተሲዶናዬ ሰላነ፤ ዩልዮስ የጳውሎስ ፈያ የነበረ ስለኸነ ተደቦዎቸዄ ወረም ያሸን እርዳታ ይሸክቶነኸም ፈቈደነ። <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />በዛም ተነሣነም ኧንፋሲ ኢፍት ሊፍት ይነፍስብነ የነበረ ስለኸነ የቆጵሮስ ደሴት መከታ ሸከትነም በመርከብ ወወር ቀርስነ። <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />በኪልቅያ በጵንፍልያም ᎀረ ያነዪ ባር በጔናነ አንቌ በሊቅያ ገኝ ታነዪ ተሙራ ከተማዬ ሰላነ። <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />በዛም የመቶ አለአዪ ኢጣልያ ያር የእስክንድርያ መርከብ ረከበም አሳፈርነ።<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />ብዠ ከነ ድግ ባርነም ወርነም በብዠ ምካት ተቀኒዶስ ከተማዬ ᎀረ ሰላነ፤ ኧንፋሲም ቲፍቴዬ አናርነኸም የኸተረነ ስለኸነ በሰልሞና ሜጠቅ ተቸለፍነም የቀርጤስ ደሴት መከታ ሸከትነም ወርነ። <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />በብዠ ምካት ጥግ ጥገሑም በቸለፍነ አንቌ በላስያ ከተማ ሜጠቅ ይትረከቢ “ፈያ የባር ᎀረ” ቲቡሪዪ መደሬ ሰላነ።<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />ቤማና ᎈር ብዠ ግዝየ በወባክነሑ የጦም ግዝየ በወቸለፈሑ መሳ በዚ ግዝየ በባር ᎈር ወወር ያጔና የነበረ ስለኸነ ጳውሎስ የሰቦቺ እኪ ቲብር አጥኔቀቀኖ፤ <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“ሰቦች! ተሗ ቀረሰም ያነዪ ኤማና ብዠ አደጋ ያነወኸም ይታዤ፤ በጭነቲም በመርከቢ ᎈር ጠለለ ቴይኸን በሰብ ነብስም ᎈር ወደል ጉዳት ጥፋትም ይሰላ።” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />የመቶ አለአዪም ተጳውሎስ ምክር የጠቀለ የመርከቢ አዛዢም የመርከቢ ባለቤት ይብሮዪ ይሰማ ባነ። <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ዛ ወደብ በርግ ያቸልፉᎄ አመቺ ያነበረ ስለኸነ አብዛኛዪ ሰቦች “ኤማሕኖ ቀሮሶም ይቸል ቢኸን በሰሜን ምዕራብ በደቡብ ምዕራብም ኢፍት ሊፍት ታነዪ ፊንቄዬ ቲቡሪዪ የቀርጤስ የባር ᎀረ ሰላነ በርጊም በዛዬ ናተልፍነ” ባሮም አሳብ አቀረቦ።<verse eid="ACT 27:12" /></para>
  <para style="s1">በባሪ ᎈር ማዕበል ወተንሣሑ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />እንሲ የደቡብ ኧንፋስ ቲነፍስ ባዞ ግዝየ ዬሰቦይኸም የኸነኖ መሰረኖም መርከብ ያቆሞᎄዪ ብረት ነሶም ኤማሕኖ የወቀጥል ተነሦ፤ በወደቢም ተነሦም በቀርጤስ ደሴት ሜጠቅ ሸከቶም ᎀረ ᎀረሑ ተቸለፎ። <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />ቢኸንም ተቀል ግዝየ አንቌ “የሰሜኒ ምሥራቅ አውሎ ኧንፋስ” ይቡሪዪ ቡሼ ኧንፋስ በደሴቲም ተነሣም ተባሪዬ ቸኘቦ። <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />መርከቢም የገፏን ስለኸነ ኧንፋሲም ወቈቈም ያንቻለ ስለኸነ እቁስ ባርነም ብፋሲም ተገፋነም ወርነ። <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />ቄዳ የቧሪዪ ደሴት ጥግ ጥግ ሸከትነም ትናርነ በወደል ምካት የመርከቢ ጀልባ ጠበጥነም በቁጥጥረና ተት የወሰክት ቻልነም። <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />መርከበኞቺም ጀልባዪ ተመርከቢዬ ሻቦም ባወጦይ አንቌ በመርከቢ ዙራ ወደረ ጥበለሎ፤ መርከቢ ሱርቲስ ቲቡሪዪ አሸዋማ መደር ኤይወጥቅኸም ጔኖም ሸራዪም አወረዶም ብንፋስ ቲገፎ ወሮ። <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />አውሎ ኧንፋሲ ቲብረታብነ የወረ ስለኸነ የመናጊ በመርከቢ ᎈር የጫንዮዪ ግብር እያታቲ ተባሪዬ ወድግ ቀረሶ። <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />በሦስታለኘዪም ከነ የመርከቢ ያግለግሎዪ ግብር በፎለሕኖ ኧጀ ኧረጎም አደጎይ፤ <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />የብዠ ከነ ጬትም ኸነ፤ ኰኰብ ያንታዞ ስለኸነም ኧንፋሲም ቲብረታብነ የወረ ስለኸነ ተሗ ቀረሰም ወትርፍ አንችልነ ባርነም ተስፋ አረጥነም።<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />ሰቦቺም አትም ስንቅ ቴይበሮ ብዠ ከነ ኤከሶ፤ ስለኸነም ጳውሎስ በግብተሕኖ ቈመም እኪ ባረ፦ አሑ “ሰቦች! እያ የባኩሑዪ ሰማሑም ቢኸን በቀርጤስ ባትትነሦ ዚ እንም ጉዳት ጥፋትም ባንሰላብኩ ባነ። <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />ኧሗም መርከቢ ጠለለ ይትጎዳ አንኸንም ታኹ በሟንም ᎈር ጥፋት ኤሰላ፤ ስለኸነም አይዞአሑ፤ አትጔኖ! ባሑም ኧመክርሑ። <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />የሑቲ የኸንኩ አመልኲም እዝጌር የላዀን መላይካ ባለፈዪ ምሳር፤ በሜጠቀኛ ቈመም <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‘ጳውሎስ! አትጔና! በቄሣር ኢፍት ወቆም ይጌባኸ፤ ዘ፥ ታኸጌ ያሮዪም ሰቦች ሕይወት እዝጌር አተረፈናኸም’ ባሬ። <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />ስለኸነም አሑ ሰቦች አይዞአሑ! እዝጌር ዚ ዬወዴዪ እንመሑ ይኸንኸም አሙን። <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />ቢኸንም ኧንፋሲ ታት ደሴቴ ᎀረ ወሰደም ያድግነ።”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />ዚ ዘንጋ በባር በኸነ አንቌ በዐሥራ አርበታለኘዪ ምሳር በአድርያ ባር<note caller="+" style="f"><char style="fr" closed="false">27፥27 </char><char style="fqa" closed="false">በአድርያ ባር፦ </char><char style="ft" closed="false">የሜዲቴራኒያን ባር አት ወጣሑ። ግብት ᎈር ብፋስ ተዚዬም ተዛዬ ትናርነ ግብት ምሳር ᎈር መርከበኞቺ ታፈሬ የቀረቦ መሰረኖ። </char></note> ዙሪያ ብንፋስ ቲያንግላታነ ትናርነ ግብት ምሳር ቲኸን መርከበኞቺ ታፈሬ የቀረቦ መሰረኖ። <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />ስለኸነም የባሪ ጥልቀት ይቋጨᎄ ወደረ ቲያድጎ የባሪ ጥልቀት አርባ ሜትር ቅጫ ኸነም ተረከበ፤ ቀል ኤከሶም ይቋጨᎄዪም ዠበሮም ባደጎ ግዝየ ሰላሳ ሜትር ቅጫ ጥልቀት ረከቦ። <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />መርከበና በባሪ ᎀረ ታኖዪ እምን ኔትጋጭ ጔኖም ተመርከቢ አንቌ አዘር አርበት መልሕቂ ተባሪዬ አወረዶይ፤ ተዛ አንቌ ምሳሪ ተቸለፈም ከነዪ ይቸኝኖኸም ይጤልዮ ቀረሰ። <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />መርከበኞቺ በመርከቢ ወጦም የወስክ ሸዎም የነበረ ስለኸነ በመርከቢ ኢፍት መልሕቅ<note caller="+" style="f"><char style="fr" closed="false">27፥30 </char><char style="ft" closed="false">መልሕቅ ወበር መርከብ ያቈሙᎄ ብረት ወበሩ። </char></note> ያድጎ መሰሮም በመርከቢ ᎈር የነበረዪ ጀልባ ተባሬ አደጎ። <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />በዛ ግዝየ ጳውሎስ የመቶ አለአዪ ወታደሮቸሑም “ነዚ መርከበኞች በመርከቢ ᎈር ዐᎈኖም ባንቶኖ አኹ የወትርፍ አትችሎ” ባረኖ። <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />ስለኸነም ወታደሮቺ ጀልባዪ የጠበጠዪ ወደረ አረጦም ይንሳፈፍኸም ገፈሮይ። <verse eid="ACT 27:32" /><verse number="33" style="v" sid="ACT 27:33" />ከነዪ ይዛኜ ቲብር እንም ስንቅ ይበሮኸም ጳውሎስ ጮቀሰኖ፤ እኪም ባረኖ፦ “አትም ስንቅ ታትቀምሶ በወትቅየየ በስነበትኩ ኧኳ ዐሥራ አርበታለኘዪ ከናሑው። <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />ስለኸነም ስንቅ ትቀምሶኸም ኧጮቅስኩ። ዚም ብርታት ይብኩ፤ ስርም አትም ጉዳት ኤሰላብኩ።” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />ዚም በባረ አንቌ ቂጣ ነሣም ብንም ኢፍት የእዝጌር አምሰገነ፤ ፍረረመም ወብራ ቀረሰ። <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />በዛ ግዝየ እንም ተጥናኖም ስንቅ በኖ። <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />በመርከቢ ውስጥ ያነነዪ እንመናም ዄት መቶ ሰባ ስድስት ሰብ ባነነ። <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />እንም በኖም በጦፎ አንቌ የጫኒዪም ስሬ ተባሬ በወድግ የመርከቢ ጭነት አቀለሎይ።<verse eid="ACT 27:38" /></para>
  <para style="s1">የመርከቢ ወሰበር</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />በዛኘም ግዝየ የሰሎᎄዪ መደር አንካሮይ፤ ቢኸንም በአሸዋ ᎀረ ያነዪ በባር ውስጥ የቡየ አፈር አዞ፤ ይቸል ቢኸን መርከቢ ተዛዬ በወግፋ ተᎀረዬ የዋውጣ ኤሰቦ። <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />የመርከቢ ሸራ ፈቶም በባሪ ውስጥ ገፈሮዮ፤ በዛም ግዝየ ይቀዝፉᎄዪ ወደረ ፈቶ፤ በዛ አዘር ያነዪም ሸራ ትንፋሲዬ ከፍ አበኖም ተባሪ ᎀረዬ ወሮ። <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />ቢኸንም መርከቢ ተአሸዋ ክምርጌ በወትጋጨሑ ተተᎈን ተግለበጠ፤ ቢፍተዄም ተተቴ ተቀበረም ኤይንቃነቅ ኸነ፤ ባንቌዄም ተማዕበሊ ወግፋ የትነሣ ይስበበር ቀረሰ።<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />ተጉጀኞቺ አት ቴይቀይ ዋኴም ኔያመልጥ ወታደሮቺ ይቀጥሮዮዬ ኤሰቦ። <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />የመቶ አለአዪም የጳውሎስ የዋትርፍ የሸ ስለኸነ አሳበሕኖም አንትቀበረ፤ ይጠቅልሺ ወዋክ ይችሎ በደሮም በመርከቢ ተባሬ ዘለሎም ተአፈሬ ይወጦኸም ኤዘዘ።<verse eid="ACT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 27:44" />የቀኖዪማ በሳንቃዎች ወይ በመርከቢ ስብርባሪዎች ᎈር ኸኖም ይወጦኸም ኤዘዘ፤ በዚ ሐለት እንም በፈያ ታፈሬ ሰሎ።<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s1">ጳውሎስ በማልታ ደሴት</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />ታፈሬ በፈያ በሰላነ አንቌ የሰላነᎄ ደሴት ማልታ ይቡሪ ወሕነሑ ሐርነ። <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />በዛ ደሴት ይነብሮዪ ያዴንቅ ፈይነት ሸከቶንነም፤ በዛ ግዝየ ዝናብ የዘነበ ስለኸነ ገሊም ስለኸነ ኧሳት አነደዶም ተቌበሮነ፤ <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />ጳውሎስ ጭራሮ ስበሰበም ትሳቴ ቲያድግ፥ ተሙቀቲ የትነሣ አት እንድወደረ ወጣም ኧጀሑ ነደᎈንም ተንጥለጠለወ፤ <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />የማልታ ሰቦች እንድወደረ በጳውሎስ ኧጅ ᎈር ተንጥለጠለም ባዞ ግዝየ “ዚ ሰብ የኢንም ሰብ የቀጠረው! በባሪ ማዕበል በፈያ ቢወጣም በአምላክ ፍርድ አመለጠም በሕይወት የወንምብር አንቻለ” ተበበሮ። <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />ጳውሎስ እንድወደረዪ ትሳቲዬ አራገፈም አደጐንም አትም ጉዳት ቴይረሕቡ ቀኘ። <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />ሰቦቺም “ኧሗ ተሗ ገገሑ ይነፏን፤ ሒንጌም ᎀተም ይወጥቅ” በወበር ይቅረሮ ባነ። ቢኸንም ብዠ ግዝየ ተቅረሮም አትም ጉዳት ያንሰላወኸም ባዞ ግዝየ አሳበሕኖም ሸገሮም “ዚሽ አምላኩ!” ባሮ።<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />በዛም ባነነᎄ መደር ሜጠቅ የደሴቲ ገዢ የፑፕልዮስ አፈር ባነ፤ ዚ ሰብ በቤተሑ ተቌበረነም ሦስት ከነ ፈያኸም አስትናገደነ። <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />በዛ ግዝየ የፑፕልዮስ አባ ፉላ ደንም ጠᎄጠንም ታቌም ተገደረም ባነ፤ ጳውሎስ ተሑቲዬ ገባም ጤለየነ፤ ኧጀሑም ጫነወም ፈያ ሸኰተን። <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />ዚም በኸነ አንቌ በደሴቲ ይነብሮዪ ኧንጐዲ የታቆ ቸኖም ፈያ ኸኖ። <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />ሰቦቺ ብዠ ስጦታ አቸኖንነ፤ አክብሮተሕኖም አቴዞነ፤ በመርከብ የወወር በትነሣነም ግዝየ ያሸነዪ እንም በመርከብ ᎈር ጫኖንነ።<verse eid="ACT 28:10" /></para>
  <para style="s1">የጳውሎስ ወወር በማልታ ተሮሜዬ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />በሦስት መሬት አንቌም፤ በደሴቲ በርጊ ቈመም በስነበተ ባት መርከብ ተነሣነም ጋዠ ቀረስነ። ዚም መርከብ የእስክንድርያ ቲኸን፤ በነነሑ የለምቻ አማልክቲ የዲዮስቆሮስ አርማ ባነወ። <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />ተስራኩስ ከተማዬ በሰላነ ግዝየ በዛዬ ሦስት ከነ ቾናነ። <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />ተዛም በባሪ ዦርነም ተሬጊዩም ከተማዬ ሰላነ፤ በዛዬ ቁና ከነ ባቸለፍነ አንቌ የደቡብ ኧንፋስ የነፈሰ ስለኸነ በዄታለኘዪ ከነ ተፑቲዮሉሴ ወርነ። <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />በዛዬ በጔታ ጐባቢት ረከብነም ተሕኖጌ ሰበት ከነ ኧቾናነኸም ጮቀሶነ፤ በዛ አንቌ ተሮሜዬ ወርነ። <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />በዛ የነበሮዪ በጔታ ጐባቢትም ወተኘና የሰሞ ስለኸነ፤ አፍዩስ ፋሩስ ስን፤ ዛምኸም ሦስት ያድርᎄ ይቡሪ መደር ስን ይቌበሮነዬ ወጦ፤ ጳውሎስም ባዠኖ ግዝየ የእዝጌር አምሰገነ፤ ተጥናናም።<verse eid="ACT 28:15" /></para>
  <para style="s1">ጳውሎስ አጐጂም ትናነ ወንጌል ወስብከሑ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />ሮም በገባነ ግዝየ ጳውሎስ አት ይቁየን ወታደር አᎅም የቢቶሑ ይነብርኸም ተፌቈደነ።<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />ተሦስት ከነ አንቌ ጳውሎስ በሮም ይነብሮዪ የአይሑድ መሪዎች አጤራ፤ በስበሰቦም ግዝየ እኪ ባረኖ፦ “በጔታ ጐባቢተኛ፥ በእስራኤል ሕዝብ በአቦቸናም ሥራት ᎈር የሸከትኩን አትም በደል ኤነቢ፤ የሕን አንኸንም ይና ሰቦች በኢየሩሳሌም አገዶም የሮማውያን አቸለፎም አቡኝም። <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />ሮማውያን በምረመሮኝ አንቌ በሞት ያትቄጣ ቃር ያረኸቦቢ ስለኸነ በነጣ ይገፍሮኜ ኤሰቦም ባነ። <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />አይሑድ በቃወᎀን ግዝየም፤ የቄሣር ጌፌቸ በወበር ግድ ኸነቢም አንኸንም ሕዝበኛ ኧከስወ መሳ ነበሬም አንከነ።<note caller="-" style="x"><char style="xo" closed="false">28፥19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">ሐዋ. 25፥11</ref>። </char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />ኧሗም ያጤራኩሑ አዥሑዬም ዚም ኢውድሑኸሙ፤ እያ በዚ በሰንሰለት ኧጉጀኘ የእስራኤል ባᎅዪ ተስፋ መሳው።”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />ሕኖም እኪ ቲብሮ ዠበሮነ፦ “በይሑዳ ገኝ ስላኸ አትም የጣፈ ደብዳቤ አንሰላነ፤ ተዚዬ በቸኖዪ ጐባቢት ሟንም ስላኸ ቡሼ ዬወደ የዝነጔም ኤነ። <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />ዚ አኸ ትትዄተሊ የአይማኖት ክፍል መደር ተመደረሑ ሰቦች ይቃወሞይኸም ኧሒርነ፤ ስለኸነም ያኸ አሳብ መአር የኸነኸም ወስማ ኧሸነ።”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />ከነ በቀጠሮነ አንቌ ብዠ ኸኖም ቲነብርወዪ ቤቴ ቸኖ፤ ሑቲም ተቅረር ምሳር ስን የእዝጌር መንግሥት በወመስክር አሳበሑ ገለጠኖ፤ ሕኖም የዋተምን በእዝጌር ኤማ የሙሴ ያᎅ ሕጊ በነብዮችሚ መጽሐፍ ጠቀሰም ስለኢየሱስ አፍታታኖ። <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />አታተሕኖ የዝነጔኒ ቃል አመኖ፤ ኧንጐዲሚ አነመኖ። <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />ሕኖም ነብስ በነብሰሕኖ ቴይስማሞ ተላኖ። ቢኸንም ተወትላኘሕኖ ኢፍቴ ጳውሎስ የመጨረሻ ግዝየ ቲዝነግ እኪ ባረ፦ መንፈስ ቅዱስ በነብዪ በኢሳያስ መሳ ያቦቻሑም የዝነጔኒ ልክ ባነ! <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />የዝነጔኒም ቃል ዚቱ፦</para>
  <para style="q1" vid="ACT 28:26">ተዚ ሕዝቤ ወርም፥</para>
  <para style="q1" vid="ACT 28:26">ወስማሽ ትሰሞ፤ ቢኸንም አታጥራምቶ፤</para>
  <para style="q2" vid="ACT 28:26">ወዥሽ ታዞ፤ ቢኸንም ልብ አትብሮ በኖ፤<verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />የዚ ሰቦች ሒን ድነደነም፤</para>
  <para style="q2" vid="ACT 28:27">ኧዝነሕኖም ተደፈነም፤ ዔነሕኖም ተጬፈነም፤</para>
  <para style="q1" vid="ACT 28:27">እኪሽ ቤይኸን</para>
  <para style="q2" vid="ACT 28:27">ቤነሕኖ አዞም፥</para>
  <para style="q2" vid="ACT 28:27">ብዝነሕኖም ሰሞም፥</para>
  <para style="q2" vid="ACT 28:27">በቀልበሕኖም አጥራመቶም፥</para>
  <para style="q1" vid="ACT 28:27">ቲያዬ በዠበሮ፥</para>
  <para style="q2" vid="ACT 28:27">እያም ፈያ በሸከትክኖ ባነ።<note caller="-" style="x"><char style="xo" closed="false">28፥26-27 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፥9-10</ref>። </char></note><verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“ኧጌሽ የእዝጌር አትርፎት መልክት የአሕዛብ የትላኸኸም ሐሮ፤ ሕኖም የሕን ባሮም ይቌበሮይ።”<note caller="+" style="f"><char style="fr" closed="false">28፥28 </char><char style="ft" closed="false">አታት የድረ የጎጋ ጡሑፍ ቊ. 29 ኤደብሮ </char></note> <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />[ “ጳውሎስ ዚ በዝነጔ አንቌ አይሑድ ብረቶም ቲኦግቶ በዛ ወጦም ወሮ።”]<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />ጳውሎስ በኩራኘን ቤት ዄት ዓመት ሙላ ቾና፤ ተሑቲዬ ይቸኖኸም ሰቦቺ እንም ይቌበር ባነ፤ <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />የእዝጌርም መንግሥት በወስብክ ስለጔታ ኢየሱስ ክርስቶስ ሟንም ቴይዀትር በድፍረት ያትመር ባነ።<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>