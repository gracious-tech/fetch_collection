<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">Mesqan New Testament</book>
  <para style="h">1 ተቆሮንቶስ ሰቦቼ</para>
  <para style="toc1">ይፍቴዪ የሐዋርያዪ የጳውሎስ መልክት ተ ቆሮንቶስ ሰቦቼ</para>
  <para style="toc2">1ተቆሮንቶስ ሰቦቼ</para>
  <para style="toc3">1ቆሮ.</para>
  <para style="mt2">የመጀመሪያዪ የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተቆሮንቶስ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ጳውሎስ የቆሮንቶስ ሰቦች የጣፈኖዪ የመጀመሪያዪ መልክት የጣፈኖ በቆሮንቶስ ባቈቈᎀን ቤተ ክርስቲያን ውስጥ የክርስትና የሕይወት እምነትም ተነሣም የነበረዪ ምካት መፍትሔ የዋትረክብ በዋስቡ። በዛ ግዝየ ቆሮንቶስ ዓለም ዐቀፋዊ የኸነ የግሪክ ከተማ በኸነዪ ነን አካይያ የቧሪ የሮም ግዛት ዋና ከተማ ባነ። ዚ ከተማ ወደል በኸነ የንግድ እንቅስቃሴ፥ በድረጀ ባሕል፥ ስርም በወበትት ᎈር ባነዪ ዓመል ወትብላሽ በአይማኖተናም ብዛት የትኴረ ባነ።</para>
  <para style="ip">ሐዋርያዪ በትለየ ያተኰረ በቤተ ክርስቲያን ውስጥ የነበረ ስለኸነ ወሰሰድ፥ ዓመል ወትብላሽ ሕይወት፥ ስለዝሙት ስለጋብቻም፥ ስለቤተ ክርስቲያን ሥራት፥ ስለመንፈስ ቅዱስ ስጦታ ስለትንሣኤም ባነ፤ ዛምኸም ሐዋርያዪ የምሥራቺ ቃል በዚሕኖ ጥያኤ ᎈር በዋመልክት በወጠንቀቅ ያቀርብ።</para>
  <para style="ip">“ፍቅር” እዝጌር የሕዝቢ ባበኖ ስጦታዎች የጠቀለ ወሕነሑ ይጐልጪ ዐሥረ ሦስታለኘዪ ምዕራፍ በዚ መጽሐፍ ስርም የትኴረ የኸነዪ ክፍል የኸነኸም ይጌመት።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="1CO 1:1-9">1፥1-9</ref> </char></para>
  <para style="io1">በክርስቲያኖች ግብት የትነሣ ወሰሰድ <char style="ior"><ref loc="1CO 1:10-4:21">1፥10—4፥21</ref> </char></para>
  <para style="io1">ዓመለሑ የትብላሸ ያበሮስ ሕይወትም<char style="ior"><ref loc="1CO 5:1-7:40">5፥1—7፥40</ref> </char></para>
  <para style="io1">ክርስቲያኖች የክርስትናም እምነት ያንትቀበሮ። <char style="ior"><ref loc="1CO 8:1-11:1">8፥1—11፥1</ref> </char></para>
  <para style="io1">የቤተ ክርስቲያን ሕይወት የአምልኮ ሥራትም <char style="ior"><ref loc="1CO 11:2-14:40">11፥2—14፥40</ref> </char></para>
  <para style="io1">የክርስቶስ የአማኞች ትንሣኤም <char style="ior"><ref loc="1CO 15:1-58">15፥1-58</ref> </char></para>
  <para style="io1">በይሑዳ ያኖ የትመኮ ክርስቲያኖች እርዳታ <char style="ior"><ref loc="1CO 16:1-4">16፥1-4</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="1CO 16:5-24">16፥5-24</ref> </char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />በእዝጌር ፈአድ የክርስቶስ ኢየሱስ ሐዋርያ ይኸንኸም ተጠራዪ ተጳውሎስ ተጐቤናም ተሶስቴንስም፦ <verse eid="1CO 1:1" /><verse number="2" style="v" sid="1CO 1:2" />በቆሮንቶስ ያነ የእዝጌር ቤተ ክርስቲያን፤ በክርስቶስ ኢየሱስ ተቄደሶም፤ የሕኖም ይና ጔታ የኸነዪ የጔታና የኢየሱስ ክርስቶስ ሽም ተመደር መደረሑ ኸኖም ቲጠሮዪ እንም ቅድሳንጌ የወሕን የጠሬዮ፤ <verse eid="1CO 1:2" /><verse number="3" style="v" sid="1CO 1:3" />ተእዝጌር ተአባናም ተጔታ ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<verse eid="1CO 1:3" /></para>
  <para style="s1">ምስጋና</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />በክርስቶስ ኢየሱስ ስላቡኩዪ ጸጋ እንጌ ስላሑ የእዝጌር አምሰጉን። <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />መሳሑም በሟንመሕኖም ቃር ዛም በወዝናግ እንም፤ በውቀት እንም በሑቲ እንም ቃር ረከብኩም፤ <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />ስለክርስቶስ ዬወድነኩዪ ምስክርነት ባሑዬ ጠናም። <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />ስለኸነም የጔታና የኢየሱስ ክርስቶስ መገለጥም በወቀየ ትትነብሮ አትምኸማት መንፈሳዊ ስጦታ ኤይቀብልብኩ፤ <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />በጔታና በኢየሱስ ክርስቶስ የመጨረሻዪ ፍርድ ያለ ናጫ ኸንኩም ትትረከቦዬ ሑቲ መጨረሻ ስን ጠናሑም ትነብሮኸም ይሸክትኩ። <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />ተትኸዄ፤ ተጔታና ተኢየሱስ ክርስቶስ አትነቴ የጠራናሑ እዝጌር ታማኙ።<verse eid="1CO 1:9" /></para>
  <para style="s1">በቆሮንቶስ ቤተ ክርስቲያን ውስጥ የከሰተ ወልያይ</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />አማኞች! በግብታሑ ወልያይ ኤነብርኸም፤ ቁና ሒን፤ ቁና አሳብ ይነብሩሑኸም፤ ነብስ በነብሳሑ ትስማሞኸም በጔታና በኢየሱስ ክርስቶስ ሽም ኧጮቅስኩ። <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />አማኞች፤ በግብታሑ ኦገት ያነኸም በቀሎኤ አበሮስ ሰማሑም። <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />ዘንጋዪም እኪቱ፤ ታሑ አቲ፤ “እያ የጳውሎስንኩ” ቲብር፤ እንጐዲ፤ “እያ የአጵሎስንኩ” ይብር፤ ኧሗም አቲ፤ “እያ የኬፋ<note caller="+" style="f"><char style="fr" closed="false">1፥12 </char><char style="ft" closed="false">ኬፋ ወበር ጴጥሮስ ወበሩ</char></note> ንኩ” ቲብር፤ እንጐዲ ኧሗም፤ “እያሽ የክርስቶስንኩ” ይብር። <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />ኧጌ ክርስቶስ ተሰሰደም? ጳውሎስም ስላሑ ተሰቀረም? ወይሽ በጳውሎስሽ ተጠመኩም? <verse eid="1CO 1:13" /><verse number="14" style="v" sid="1CO 1:14" />ተቀርስጶስም ተጋይዮስ አኸንም ታሑ አትም ያናጥመቅኩ ስለኸነ የእዝጌር አምሰጉን።<note caller="-" style="x"><char style="xo" closed="false">1፥14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">ሐዋ. 18፥8</ref>፤ <ref loc="ACT 19:29">19፥29</ref>፤ <ref loc="ROM 16:23">ሮም 16፥23</ref>። </char></note> <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />ስለኸነም በሽመኛ ወጠመቀው ይዝነግ ሟንም ኤነ። <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />ዮንም፤ የእስጢፋኖስም አበሮስ አጠመኩም፤ ተዚሕኖ እንጐድ ዋጥምቀኛ ትዝ ኤይብሬ፤<note caller="-" style="x"><char style="xo" closed="false">1፥16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 ቆሮ. 16፥15</ref>። </char></note> <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />ክርስቶስ የላሔ የወንጌል ኧሰብክኸም አንኸንም አጠምቅኸም አንከነ፤ የክርስቶስ መስቀል ኤድገልልኸማ፤ በሰቦች የንግግር ብላት አንሰብክ።<verse eid="1CO 1:17" /></para>
  <para style="s1">ክርስቶስ የእዝጌር ቆት ብላትሙ</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />የመስቀሊ ቃል ይጠፎዪ ገውነቱ፤ ይና ኧተርፍነዪም የእዝጌር ቆቱ።<verse eid="1CO 1:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="1CO 1:19" />እኪ ቧሪም ተጣፈም፤ የብላተኞቺ ብላት አጠፋ፤ የሐሮዪም ውቀት ኤይድገልል ኧሸኩች።<note caller="-" style="x"><char style="xo" closed="false">1፥19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">ኢሳ. 29፥14</ref>። </char></note><verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />ብላተኘ ቤቴ ነነ? የሕጊ አስተማሪሽ ቤቴ ነነ? ይምራመርሽ ቤቴ ነነ? እዝጌር የዚ ዓለም ብላት ገውነት አንሰኰተን?<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="1CO 12:17">12፥17</ref>፤ <ref loc="ISA 19:12">ኢሳ. 19፥12</ref>፤ <ref loc="ISA 33:18">33፥18</ref>፤ <ref loc="ISA 44:25">44፥25</ref>። </char></note><verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />የዚ ዓለም ሰቦች በፎለሕኖ ብላተሕኖ የእዝጌር ወሐር ኤይችሎኸም እዝጌር በብላተሑ ዘጋቦ፤ ቢኸንም የገውነትኸም ቢቆጥሪ ኢና ብናትመርነዪ ወንጌል ያምኖዪ የዋትርፍ የእዝጌር ፈአድ ኸነም። ተእዝጌር ብላት የትነሳ ዓለም በፎል ብላተሕኖ እዝጌር ወሐር ያንቻለ ስለኸነ፤ በስብከት ገውነት ያምኖዪ ያተርፍኸም የእዝጌር ፈያ ፈአድ ኸነም። <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />መቸም አይሑድ ታምርም ምልክትም ይሸዎ፤ የግሪክ ሰቦችም ብላት ይሸዎ። <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />ኢናም የሰቀረዪ ክርስቶስ ኧሰብክነ፤ ዛም የአይሑድ ቈፋ፤ የአሕዛብ ኧሗም ገውነቱ። <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />እዝጌር የጠራኖም፤ አይሑድም ኸኖ ግሪኮች፤ ክርስቶስ የእዝጌር ቆት ብላቱ፤ <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />መሳሑም ተሰብ ብላት ይጠቅል የእዝጌር ገውነት ውቀቱ፤ ተሰብ ወበርታ ይጠቅል የእዝጌር ወቂጥ ስርም ይብረታ። <verse eid="1CO 1:25" /><verse number="26" style="v" sid="1CO 1:26" />አማኞች፤ በጠረኩ ግዝየ ምን የነበርኩኸም እንዴ አስቦ። በሰብ መስፈርት ባሑ ብዣሑ ዐዋቂዎች አነበርኩ፤ ብዣሑም አያላን አነበርኩ፤ ብዣሑም በወደል ቤተ ሰብ አንትጠኘሑ። <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />ቢኸንም እዝጌር ብላተኞቺ ያትማልሌ የዓለም ገዋ ቃር ሜጠረ፤ እዝጌር የብረቶዪ ያትማልሌ የዓለም የቌጠ ቃር ሜጠረ። <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />እዝጌር የትከበረዪ ዬነኸም የወሰክት፣ በዚ ዓለም ዝቅ የባረዪም የትናቀዪ ቃር፣ መደር ያናᎅዪ ቃር ሜጠረ፤ <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />ዚምም ሟንም ሰብ በሑቲ ኢፍት ኤይትነነድኸሙ። <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />በክርስቶስ ኢየሱስ የወሕን የበቃሑ ተሑቲ የትነሣው፤ ሑቲ በእዝጌሬ ብላተና፣ ጽድቀና፥ ቅድስናና፣ ምትከናም ይኸንኸም ሸኰተን። <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />በሒሽ፣ እኪ ቧሪም ጣᎉም፤ “ይትነነድ በጔታ የትነነድ።”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />አማኞች! እያ ተአሑዬ በቸኘሑ ግዝየ ስለእዝጌር የምሰከርኩን የንግግር ችሎታ የፍልስፍና ብላት በዋተዥ አንከነ።<note caller="+" style="f"><char style="fr" closed="false">2፥1 </char><char style="fqa" closed="false">ስለ እዝጌር ወመስክር፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፎች “ስለ እዝጌር ምሥጢር ዋትመር” ይብሮ። </char></note><note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>።</char></note> <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />መሳሑም በግብታሑ ትናነሑ ኢየሱስ ክርስቶስ አንከንም ኧንጐድ አንሒርኸም ዌሰንኩም ባነ። <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />ተአሑዬ የቸኘሑ በወቂጥ በጊናት፤ ዛምኸም በብዠ በወንቀጥቅጥ ባነ። <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />ቃለኛም ስብከተኛም የመንፈስ ቆት በወግልጥ አንኸንም፤ ቢያብላልጥ የብላት ቃል አነበረ። <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />ዛም እምነታሑ በእዝጌር ቆት አንከንም በሰብ ብላት ᎈር ኤይምሰረትኸሙ።<verse eid="1CO 2:5" /></para>
  <para style="s1">በመንፈስ የትረከበ ብላት</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />በበሰሎ ሰቦች ግብትም ብላት ኧዝነጊነ፤ የሕን አኸንም የዚ ዓለም ብላት ወይ ይጠፎዪ የዚ ዓለም ገዢዎች አንከነ። <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />ቢኸንም ተሼመም የነበረዪ የእዝጌር ምስጢር ብላቱ፤ ዚ ብላት እዝጌር ተዘበናት ኢፍቴ የክብረና በደረም የዌሰነኑ። <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />ተዚ ዓለም ገዢዎች አተሕኖም ዚ ብላት አንትረዶይ፤ ቢትረዶይማ የከበረዪ ጔታ ባንሰቀሮይ ባነ። <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />የሕን አንኸንም መጽሐፍ፥</para>
  <para style="q1" vid="1CO 2:9">“የሰብ ዔን ያነዠኒ፥</para>
  <para style="q2" vid="1CO 2:9">የሰብ እንዝን ያንሰሟኒ፥</para>
  <para style="q2" vid="1CO 2:9">የሰብ ሒን ያናሰᎄኒ፥</para>
  <para style="q2" vid="1CO 2:9">እዝጌር ይወዶዪ አዝጋጀም” ይብር።<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">ኢሳ. 64፥4</ref>። </char></note><verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />እዝጌርም ዚም በመንፈሰሑ መሳ ይና ገለጠንነም። መንፈስ የእዝጌር ጥልቅ ቃር ቴይቀይ እንመሑ ይምረምር። <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />በውስጠሑ ታነዪ ተነብሰሑ መንፈስ አንከንም ተሰብ ግብት የአት ሰብ አሳብ ይሒር ሟንም ኤነ? ዛምኸም ተእዝጌር መንፈስ አንከንም፤ የእዝጌርም አሳብ ይሒር ሟንም ኤነ። <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />ተእዝጌር የኸነዪ መንፈስ አንከንም፤ የዓለም መንፈስ አንትቀበርነ፤ ዚም እዝጌር በነጣ ያበነ ኧሒርነዬው። <verse eid="1CO 2:12" /><verse number="13" style="v" sid="1CO 2:13" />ኢና ኧዝነግነዪ ዚቱ፤ ተሰብ ብላት በትማርነዪ ቃል ቴይኸን፤ በመንፈስ በትማርነዪ ቃል ኧዝነጊነ፤ መንፈሳዊ የኢንም ኧገልጥነዪ በመንፈሳዊ ቃሉ።<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="fqa" closed="false">መንፈሳዊ የኢንም የመንፈሳዊ ሰብ ኧጐልጥነ </char></note> <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />የእዝጌር መንፈስ ዬነን ሰብም ተእዝጌር መንፈስ ይᎅ ስጦታ ወቀበር ኤይችል፤ የስጦታዪ ወደልነት ይምረመሪ በእዝጌር መንፈስ መሳነት ስለኸነ ያጥራምቴ ኤይችል፤ ዛምኸም ዚ የሕኖ ገውነት መሰረም ይታዥን። <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />መንፈሳዊ ሰብም እንም ቃር ይምረምር፤ ነብሰሑ በሟንም ኤይምረመር። <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />“ያትᎀሬ፤ የጔታ ልብ ሟ ሗረን” ኢናም የክርስቶስ ልብ ነነነ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">ኢሳ. 40፥13</ref>። </char></note><verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s1">በቤተ ክርስቲያን ውስጥ የትኸለቀ ወልያይ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />አማኞች፤ በክርስቶስ ገና ሰብዬ የኸንኩኸም፤ የሰብ አሳብ አንኸንም የመንፈሳዊኸም ኧዝነጊሑዬ አንቻልኩ። <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />መሳሑም ገና ያቆመርኩ ስለኸነ ብጭወ አንከንም የቆመረ ስንቅ አናበራሑ፤ ኧሗም ቢኸን ገናኩ።<note caller="-" style="x"><char style="xo" closed="false">3፥2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">ዕብ. 5፥12-13</ref>። </char></note> <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />ኧሗም የሰብኸም ቴስቦንኩ፤ በግብታሑ ወቅና ኦገትም ነነ፤ ኧጌሽ፤ የሰብ አሳብኸም ወሕናሑ አንከነ? ሜናሑሽ የሟንም ሰብኸም ሜና ወሕነሑ አንከነ? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />መሳሑም አቲ፤ እያ የጳውሎስ ተከታይንኩ ኧንጐዲ ኧሗም “እያ የአጵሎስ ተከታይንኩ፤” ቲብር የሰብኸም ዋስባሑ አንከነ?<note caller="-" style="x"><char style="xo" closed="false">3፥4። </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 ቆሮ. 1፥12</ref>። </char></note> <verse eid="1CO 3:4" /><verse number="5" style="v" sid="1CO 3:5" />ወሕነሑ አጵሎስ መአሩ? ጳውሎስሽ መአሩ? ጔታ አትባተሕኖ ባበኖ ቅጫ ይሸክቶ አገልጋዮችኖ፤ አሑ ተእምነቴ የቸኘሑ በሑቲ መሳው። <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />እያ ቀበርኩ፤ አጵሎስ ኧጋ አሰጨ፤ ያለቈንም እዝጌሩ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">ሐዋ. 18፥4-11</ref>፣<ref loc="ACT 18:24-28">24-28</ref>። </char></note> <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />ስለኸነም ያለቅ እዝጌር አንከንም፤ ይቀብር ኸነ ኧጋ ያሰጭ አትም አንከነ። <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />ይቀብርም ኸነ ያሰጭ ቁናኖ፤ እያታተሑ የሜናሑ ቅጫኸም የነብሰሑ ሽልማት ይቌበር። <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />መሳሑም ኢና ተእዝጌርጌ ቁናዬ ኧሸክትነንነ፤ አሑም የእዝጌር እርሻንኩ፤ የእዝጌር ሕንጣንኩ። <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />በእዝጌር ባቤ ጸጋ ቅጫ፤ ያት ጎበዝ ግንበኛ መሠረትም አደኩ፤ እንጐዲም በᎈረሑ ᎈር ይግነባ፤ ቢኸንም እያታቲ ምንኸም ይግነባኸም ወቀየ ነነወ። <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />መሳሑም አትጌ ተትምሠረተዪ መሠረት ኧንጐድ መሠረት ወድግ ይችል ሟንም ኤነ፤ ዚም መሠረት ኢየሱስ ክርስቶሱ። <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />ሟንም በዚ መሠረት ᎈር በወርቅም፥ በብር በከበረ እምንም፥ በጨ፥ በሠርም በአገዳ ቢግነባ <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />ሜናሑ ምንኸም የኸነኸም ይታዥ፤ መሳሑም የያታቲ ሰብ ዛ የፍርድ ከነ ተብራኔ ያቸኝን፤ በሳት ይትገለጥ ስለኸነ ኧሳቲ የያታቲ ሰብ ሜና ምን ወሕነሑ ይትፌተን። <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />ሟንም የሸኰተን ቤት ብሳት ተቼለፈም ቢጠና ሽልማተሑ ይቌበር። <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />ሜናዪ ብሳት ነደደም የጠፋወዪ ግንበኛ ዋጋሑ ይቀይወ፤ የሕን አንከንም ሑቲ ነብሰሑ፥ ብሳት ውስጥ ተቼለፈም ቴነድ ይቀይ ግንድኸም ይተርፍ።<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />የእዝጌር ቤተ መቅደስ ወሕናሑ የእዝጌር መንፈስ በውስጣሑ ወንብረሑ አትሒሮ?<note caller="-" style="x"><char style="xo" closed="false">3፥16 </char><char style="xt" closed="false"><ref loc="1CO 6:19">1 ቆሮ. 6፥19</ref>፤ <ref loc="2CO 6:16">2 ቆሮ. 6፥16</ref>። </char></note> <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />በሒሽ ሰብ የእዝጌር ቤተ መቅደስ ቢያፈርስ እዝጌር የሑቲ ያᎈርሽ፤ መሳሑም የእዝጌር ቤተ መቅደስ ቅዱሱ፤ ዚም ቤተ መቅደስ አሑትንኩ።<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />ሟንም ነብሰሑ ኤያብላልጥ፤ በዚ ዓለም የብላት ደረጃ ብላተኘ መሰረም ይታዥ ቢነብር የእዝጌር የኢነተኘ ብላት ይረሕብኸም ነብሰሑ የገዋኸም የቆጥር። <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />መሳሑም የዚ ዓለም ብላት በእዝጌር ኢፍት ገውነቱ፤ ዚም፦ “እዝጌር የብላተኞቺ በተንኰለሕኖ ይጠብጦ” ቧሪም የጣፈኸሙ።<note caller="-" style="x"><char style="xo" closed="false">3፥19 </char><char style="xt" closed="false"><ref loc="1CO 5:13">5፥13</ref>። </char></note> <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />ብንጐድ መጽሐፍ ኧሗም፥ “ጔታ የብላተኞቺ አሳብ ኤድገልል ወሕነሑ ይሒር” ይብር ተጣፈም።<verse eid="1CO 3:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1CO 3:21" />በይሽ ሟንም በሰብ ኤይትነነድ። እንም ቃር ያሑቱ፤ <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />ጳውሎስም ቢኸን አጵሎስም ቢኸን፥ ኬፋ<note caller="+" style="f"><char style="fr" closed="false">3፥22 </char><char style="ft" closed="false">ጴጥሮስ ወበሩ</char></note> ቢኸን፥ ዓለምም ቢኸን፥ ሕይወትም ቢኸን፥ ሞትም ቢኸን፥ ኧሗ ያነዪም ቢኸን፥ ባንቌ ይቸኚ ቢኸን፥ እንም የአሑቱ። <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />አሑም የክርስቶስንኩ፤ ክርስቶስም የእዝጌሩ።<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s1">የክርስቶስ ሐዋርያት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />ኧጌሽ ሰብ እንም ይና የክርስቶስ አገልጋዮች የእዝጌር ምሥጢርኸም ባለ ዐደራዎች ይቆጥርነዬ ይጌባ። <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />ባለ ዐደራዎቺም ታማኝ ኸኖም ወትረኸብ ነነቦ። <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />ባሑም ኸነ በሰቦች የፍርድ ጀᎈር ቢፈርድቢ እያም ብንኸን በፎለኛ ግድ ኤኔ፤ እያም ብንኸን በነብሰኛ ᎈር አንፈርድ። <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />ሕሊናኛ ንጡው፤ ዚም ጥፋት ኤነወ ወሕነሑ ኤያርጋግጥ፤ ቢያ ᎈር ይፈርድ ጔታው። <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />ስለኸነም ግዝየሑ ቴይሰላ በሟንም ቃር አትፍርዶ፤ ጔታ ይቸኝ ስን ቀሮ። ሑቲ በጨለማ ውስጥ የሼመዪ ተብራኔ ያወጣን፤ በሰቦቺ ልብ ውስጥ ያነዪ አሳብ ይገልጥ፤ በዛም ግዝየ እያታቲ ሰብ ይጌቧኒ ምስጋና በእዝጌሬ ይቄበር።<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />በይሽ አማኞች፤ ያሑ ጥቅም ባሑም በዚ ወባጀ እያም ነብሰኛም የአጵሎስ ምሳሌ ሸከትኩም አቀረብክንኩም፤ ዛም የሸከትኩን፤ “በጣᎉዪ አትልፎ” ይቡኒ ቢና ትትመሮኸሙ። ስለኸነም አቲ ሰብ ትንጐዲ አበዛሑም አትትነነዶᎄ። <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />ወሕነሑ፤ አኸም ትንጐዲ ትበዛኸም የሸከተናኸ ሟኒ? ያንትቀᎄርኰን የነብሳኸ የኸነ ቃር መአር ነነ? በቌበርከ ኧጌ፤ ያንትቀᎄርኰንኸም የመአር ትትነነድ? <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />ኧሗሽ ያሸናሑዪ እንም ረከብኩም! ዱሬሻ ኸንኩም! ቲናም ተላኘሑም ነገሥኩም! የኢንም ብትነግሦማ ኢናም ታሑጌ በነገሥነ ባነ፤ <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />መሳዪም እዝጌር ኢናም የሐዋርያነቲ ሞት የትፈረደቦኸም ሰቦች ተሰብ እንም መጨረሻ ያቸለፈነ ይመስርነ፤ የዓለም እንም፤ የመላይካም የሰቦችም ድራማ ኸነም። <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />ኢና ስለክርስቶስ ባርነም ገዋ ኸነም፤ አሑም በክርስቶስ ብላተኘ ኸንኩም፤ ኢና የቌጥነ ኸነም፤ አሑም ብረታሑም፤ አሑ የትከበርኩ ኸንኩም፤ ኢናም የትዋረድነ ኸነም። <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />ዚ ሰዓት ስን ኧትገድነ፤ ኧጠማነ፤ እንጨና ኸነ፤ ኧትነነድነ፤ ይነቡርᎄ ቤት በወቅብጥ ኧታወርነ። <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />በፎለና ኧጀና ትንሸክትነ ኧቌጥነ፤ ቲሰድቡነ ኧሜርቅነ፤ ቲያሳድዶነ ኧፈርክነ፤<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">ሐዋ. 18፥3</ref>። </char></note> <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />ቲሰድቦነ ሽመናም ቲያጠፎ በፈይነት ኧዠብርነኖ፤ ኧሗ ስን የዚ ዓለም ያደጒ ያፈርም የሟጂ ቈሻሻ ኸነም።<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />ዚ ኧጠፍንኩ የትወደድኩ ዴንጋኛኸም ሸከትኩም ኧመክሩሑዬ አንከንም አትማልልኩዬ ባሑም አንከነ። <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />እኪ ቢኸንም ዐሥር ሺ ይቆጠሮ ሞግዚት በክርስቶስ ቢነብርሑ፤ ብዠ አብ ኤነናሑ፤ መሳሑም በወንጌል አዘር በክርስቶስ ኢየሱስ ጨኘኩሑም። <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />ስለኸነም ይያ ትመስሮኸም ኧጮቁስኩ። <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />ኧጌሽ በጔታ የትወደደዪም የታመነዪ ትኸኛ ጢሞቴዎስም የላኩኑኩም በዚ መሳው፤ ሑቲም ተመደር መደረሑ ቢትረከቦ የአብያተ ክርስቲያን እንም አትᎀሪ ትምርትጌ ይስማማ፤ በክርስቶስ ኢየሱስ ያነዪ የሕይወት አርወዪ ያትኴርሑ።<note caller="-" style="x"><char style="xo" closed="false">4፥17 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 ቆሮ. 11፥1</ref>። </char></note><verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />ተአሑ አታቶቺ ተአሑዬ አንቸኝ መሰረኖም ታበዮም፤ <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />የሕን አንኸንም የጔታ ፈአድ ቢኸን ታሑዬ አቴክልም ኧቸኝ፤ በዛም ነዚ ትዕቢተኞቺ ይዝነጎዪ ጠለለ ቴይኸን፤ ምን ቅጫ ቆት ያነኖኸም ወዥ ኧሸ። <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />መሳሑም የእዝጌር መንግሥት ኦጀ ወባጀ ቴይኸን የቆት ወባጀው። <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />ወሕነሑ ትሸዎይ ኤቲው? እንጣር ጠበጥኩም ንተኝ? ወይሽ በፍቅር በቁና ቀልብም ሒን?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s1">ያትማልል አጢያት በቤተ ክርስቲያን</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />በግብታሑ ያትማልል የዝሙት ሜና ወንብረሑ ይዝነጒ፤ እኪኸማቲ የዝሙት ሜና በአሕዛቤ ቢኸንም ታዠም ኤይትኴር፤ የአባሑ ምሽት ያገባ ሰብ ነነ።<note caller="-" style="x"><char style="xo" closed="false">5፥1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">ዘዳ. 22፥30</ref>። </char></note> <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />ኧሗም ታበይኩም! ይጠቅልሽ አዘን ተሴማናሑም፤ ዚ ሜና የፌጠመዪ ሰብ ታትዌግዶዬ ኤጌባሑ? <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />አትም እያ በጅስም ታሑጌ ባንኸን በመንፈስ ታሑጌንኩ፤ ዮንም ታሑጌ ያነሑኸም ኸንኩም እኪኸማቲ ሜና በፌጠመዪ ሰብ ᎈር በጔታ በኢየሱስ ሽም ፈረድኩወም፤ <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />ብትስበሰቦᎄ ግዝየ እያም በመንፈስ ታሑጌ የኸንኩ ኧኸን ስለኸነ፤ በጔታና በኢየሱስ ሽም በግብታሑ ቢትረከቢ በጔታና በኢየሱስ ቆት፤ <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />በአጢያት የትመላዪ የዚ ሰብ በሠር ይፈርሴ የሼጣን አቸለፍኩም ቲቦዬ ይጌባ። ዚም ትሸክቶ ጔታ ኢየሱስ የፍርድ ቢቸኝወ ከነ የዚ ሰብ ነፍስ ይተርፍኸሙ።<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />ኧጌሽ ወትነነዳሑ ፈያ አንከነ፤ ቀል እርሾ ቡኮዪ እንም ያቦኳንኸም አቲሒሮ?<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">ገላ. 5፥9</ref>። </char></note> <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />ኧሗ የኸንኩይኸም እንም እርሾ ዬነወኸም የገደር ቡኮኸም ትኸኖኸም የጉርዚ እርሾ አውጦ፤ መሳሑም የፋሲካና ኧጤ የኸነዪ ክርስቶስ ታረደም፤<note caller="-" style="x"><char style="xo" closed="false">5፥7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">ዘፀ. 12፥5</ref>። </char></note> <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />ስለኸነም ተንኰል ቡሼነትም በመላወ በጉርዝ እርሾ ቴይኸን እርሾ ቤነወ የቅንነት የኢንነትም ቂጣ በዓለና ናክብርነ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="EXO 13:3">ዘፀ. 13፥3</ref>፤ <ref loc="DEU 16:3">ዘዳ. 16፥3</ref>። </char></note><verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />በዚ ኢፍቴ በጣፈክንኩ መልክት ቲሟግጦዪጌ አትትገገዞ ባሑኩም ባነ። <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />ዚም ትንብር ትንመሑ ተዚ ዓለም ይሟግጦዪ ወይ ተስግብግብ ሰቦች ወይ ተሌቦች ወይ ተጣዖት አምላኪዎችጌ አትትገገዞ ወበረኛ አንከነ፤ እኪማ በኸነ ተዓለም ወውጣ ያሸሑ ባነ ወበሩ። <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />እያም የጣፈክንኩ ክርስቲያን ቧርዮም ቲሟግጦዪም፥ ቲስግበገቦዪም፥ ጣዖት ቲያመልኮዪም፥ የሰብ ሽም ቲያጠፎዪ፥ ቲሰክሮዪ፥ ተዘራፊጌ አትትገገዞ ባሑሙ። የዚኸም ታኖዪ ሰቦችጌ፥ ስንቅ ቁናዬ አትብሮ።<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />ተቤተ ክርስቲያን ውጪ ባኖዪ ሰቦች ᎈር የወፍርድ እያ ምናአገቤ? በቤተ ክርስቲያን ውስጥ ባኖ ሰቦች አሑ አትፈርዶ? <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />በቤተ ክርስቲያን ውጪ ባኖዪ ᎈር ይፈርድ እዝጌሩ፤ በይሽ፤ ቅዱስ መጽሐፍ ይብርከም “ቡሼዪ ሰብ በግብታሑ አውጦይ።”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s1">ወካሰስ በክርስቲያኖች ግብት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />በግብታሑ አት ሰብ ትንጐዲጌ ኦገት ቢነቡር፤ ወባጀዪ በቅዱሳን ኢፍት በዋቅርብ ሟኔ ምንኸም ደፈረም ቤያምኖዪ ሰቦች ኢፍት የወፋረድ ያቀርብ? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />ቅዱሳን በዓለም ᎈር ይፈርዶኸም አትሒሮ? ባፈር ᎈር ትፈርዶ በኸነ፥ በይሽ፤ በቀል ቃርም ᎈር የወፍርድ አቲሒሮ? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />ተአፈሪ ሕይወት ወባጀ ቀኘም፤ በመላይካ ᎈር ቢኸንም ኧፈርድኸም አትሒሮ? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />በይሽ እኪ ያነ ወባጀ ቲያጋጥምኩ፤ በቤተ ክርስቲያን የትገረጦዪ ሰቦች ፈራጁ ሰክቶም ሹሞያ<note caller="+" style="f"><char style="fr" closed="false">6፥4 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በቤተ ክርስቲያን የትገረጦ ሰቦች ፈራጅ ሸከትኩም ትሾሞዮ? </char></note>! <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />ዚም ኧቡኒ አትማልልኩዬ ባሑሙ። ወሕነሑ በግብታሑ አማኞች የዋታርቅ ይበቃ ያጥራምት ሰብ ኤነ? <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />ይገርምሑ አማኝ የአማኝ የወክስስ ፍርድ ቤት ያር፤ ቤያምኖ ሰቦች ኢፍት ያትፌርዴ ያር። <verse eid="1CO 6:6" /><verse number="7" style="v" sid="1CO 6:7" />ኧጌሽ በግብታሑ ወካሰስ ወንብረሑ ራሰሑ ወውጥቃሑ ያቴዥ። ብትቤደሎ ኤይጠቅል? ቢያብላልጦኩሽ ኤይጠቅል? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />አሑም ነብሳሑ ትቤድሎ፤ ዛም አማኞች በኸኖዪ ክርስቲያኖች ᎈር በደል ዋብላልጥም ትፌጥሞ!። <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />ዐመጠኞች የእዝጌር መንግሥት ኤወርሶኸም አቲሒሮ? በዚ ዘንጋ አትትብላለጦ፤ ሴሰኞችም፥ ጣዖት ያመልኮዪም፥ አመዝሮቺም፤ የትዳር ታማኝነት ያፈርሶዪ፤ ይምሳሰር ገሜ ተገሜ ጋብቻ ይፌጥሞዪ <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />ሌቦችም፥ ስግብግቦቺ፥ ሰካራሞች፥ ይሳደቦዪም፥ ዘራፊዎችም የእዝጌር መንግሥት ኤይወርሶ። <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />ተአሑ አታታሑ ዛምኸም ባነሑ፤ ኧሗም በጔታ በኢየሱስ ክርስቶስ ሽም በአምላከና መንፈስም ታጠብኩም፤ ተቄደስኩም፤ ጸደቅኩም።<verse eid="1CO 6:11" /></para>
  <para style="s1">የዝሙት አጢያት</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />“እንም ቃር ተፌቀደኒም፤” ቢኸንም እንም ቃር ኤይጠቅም፤ “እንም ቃር ተፌቀደኒም፤” የሕን አንኸንም አትም ቃር ቢያ ᎈር ኤይስለጥንቢ፤<note caller="-" style="x"><char style="xo" closed="false">6፥12 </char><char style="xt" closed="false"><ref loc="1CO 10:23">1 ቆሮ. 10፥23</ref>። </char></note> <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />ኧሗም፤ “ስንቅ የደኑ፥ ደንም የስንቁ፤” እዝጌርም የዄቲም ያጠፋኖ። ገግ የጔታው አንከንም የዝሙት አንከነ፤ ጔታም የገገና ያታርፍ። <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />እዝጌር የጔታ ኢየሱስ ተሞት ያትኔሳንኸም፤ ይናም በቆተሑ ተሞት ያትኔሣነ።<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />ገጋሑ የክርስቶስ የጅስም ክፍሎች የኸነኸም አቲሒሮ? ኧጌ፥ የክርስቶስ የጅስም ክፍሎች ወሰድኩም በዝሙት ታድር ምሽት ክፍሎችጌ ቁና ንሰኩች? ስርም ኤይጌባ! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />ወይሽ ተዝሙት ታድር ምሽትጌ ይትገገዝ ሰብ ተሒቲጌ ቁና በሠር የኸነኸም አትሒሮ? መሳሑም በቅዱስ መጽሐፍ “ዄቲም ቁና በሠር ይኸኖ” ቧሪም።<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዘፍ. 2፥24</ref>። </char></note> <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />ቢኸንም ተጔታጌ ይትገገዝ ተሑቲጌ በመንፈስ ቁና ይኸኖ። <verse eid="1CO 6:17" /><verse number="18" style="v" sid="1CO 6:18" />ስለኸነም ተዝሙት ስኮ። ሰብ ይሸኩች አጢያት እንም ተጅስመሑ ውጪው፤ ዝሙት ይፌጥም በፎለሑ ጅስመሑ ᎈር አጢያት ይሸክት፤ <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />ወሕነሑ፤ ገጋሑ በውስጣሑ ይነብሪ የመንፈስ ቅዱስ ቤተ መቅደስ የኸነኸም አትሒሮ? ዛም መንፈስ ተእዝጌር የቀበርኩዪው። አሑም የነብሳሑ አንከንኩ።<note caller="-" style="x"><char style="xo" closed="false">6፥19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 ቆሮ. 3፥16</ref>፤ <ref loc="1CO 6:16">6፥16</ref>። </char></note> <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />ክርስቶስ በዋጋ ስየናሑም፤ ስለኸነም በገጋሑ የእዝጌር አክብሮ።<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s1">ጋብቻ በትምለከተ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />የጣፍኩኒ ስለኸነ ወባጀ፤ ሰብ ምሽት ቴያገባ ቢነብር ፈያው<note caller="+" style="f"><char style="fr" closed="false">7፥1 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ሰብ ተምሽት ጌ ወትራከብ ቤሸክት ፈያው </char></note>፤። <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />ቢኸንም ተዝሙት ተወቀየ፤ እያታቲ ሰብ የነብሰሑ ምሽት የንቡር፤ እያታቲም ምሽት የነብሴታ ምስ የንብራ። <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />ምስ የምሽተሑ በትዳር ወትራኸብ ይጌባና እንም የሰክትና፤ ምሽት ዛምኸም የምሴታ ይጌቧኒ እንም ትሰኩትነ። <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />ምሽት ጅስሜታ የነብሴታ ጠለለ አንከነ፤ የምሴታው፤ ዛምኸም ምስ ጅስመሑ የነብሰሑ ጠለለ አንከነ፤ የምሽተውታው <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />በጠሎት የወትጋደል ተስማማሑም የትዌሰነ ግዝየ ባንከነ፤ ነብስ በነብሳሑ አትክላከሎ፤ የነብሳሑ ባለወግዛ ሼጣን ኤፌትንኩኸም ዘብሮም ቁናዬ ሕኖ። <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />ዚ ኧብርሑም የትዛዝኸም ቴይኸን የምክርኸሙ። <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />ሰብ እንም ይያኸም ምሽት ቴያገባ ቢነብር ኧወድ ባነ፤ ቢኸንም እያታተሑ እዝጌር የትለኘ ስጦታ ነነን። <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />ቢኸንም ያናግበማ ምሰሕነማ የᎀተበማ እንሽታ እኪ ኧብር፤ ቴያገበማ ይያኸም ቢነብረማ የሕነማ ፈያው፤ <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />ቢኸንም ነብሰሕኖ ወግዛ ባንቻሎ ያግቦ፤ ቤላት ተወንድድ ዋግባ ይጠቅል። <verse eid="1CO 7:9" /><verse number="10" style="v" sid="1CO 7:10" />ያገቦዪ ዚ ትዛዝ ኢብ፤ ዚም ትዛዝ የጔታ አንከንም ይያ አንከነ። ምሽት ተምሴታ አትላኝ፤ <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />ቢኸንም ብትትላኝም ታታገባ ትንብር፤ ባንከነ ተምሴታንጌ ትታረቅ፤ ምስም የምሽተሑ ኤይፍታና።<note caller="-" style="x"><char style="xo" closed="false">7፥10-11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቴ. 5፥32</ref>፤ <ref loc="MAT 19:9">19፥9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>። </char></note> <verse eid="1CO 7:11" /><verse number="12" style="v" sid="1CO 7:12" />የንጐዲ ኧሗም እኪ ኧብር፤ ዚም ኧቡኒ እያ አንከንም ጔታ አንከነ። ያነመነች ምሽት ያነን ጎቤ ቢነብር ምሽተሑ ቁናዬ የወንብር የፈቀደች በኸነ፤ ይፈታናዬ ኤይጌባ። <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />ያነመነ ምስ ያነና ምሽት ብትነብር ሑቲም ቁናዬ የወንብር ይፈቅድ በኸነ፤ ትᎈታኔ ኤይጌባና <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />ያነመነ ምስ በምሽተሑ ተቄደሰም፤ ያነመነች ምሽት ቢያምን ምሴታ ተቄደሰችም፤ ባንከነማ ዴንጋሑ ሩክስ በኸኖ ባነ፤ ኧሗም የትቄደሶኖ። <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />ቢኸንም ኤያምኒ ደቦ ወትላይ ቢሸ የትላይ፤ አት ጐቤ ወይ ኧተም በዚ ሐለት ኧጉጀኘ አንከኖ እዝጌር የጠራነ በሰላም ኧነብርነኸሙ። <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />አሺ ምሽት፤ ምሳሽ ታተርፊ በኸነ ምን ትሒር? ወይሽ አኸ ሰብ፤ ምሽታኸ ታተርፋ በኸነ ምን ቲሒር? <verse eid="1CO 7:16" /><verse number="17" style="v" sid="1CO 7:17" />እያታቲ ሰብ ጔታ የዌሰነነኸሙ፤ እያታቲም እዝጌር የጠራንኸም በዛም የዥባበር። በአብያተ ክርስቲያን እንም ኧድነግግነዪ ዚቱ። <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />አት ሰብ ጤበን አወኔም ትናነ ቢጠሬ፤ ጤበን ያናውኔኸማ ኤይሕን፤ ጤበን ቴያወኖይ ተጠራም በኸነ ጤበን ኤያውኔ። <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />ጤበን ዋውና ኸነ ጤበን አለዋውና ኤይጠቅም፤ ዋናዪ ቃር የእዝጌር ትዛዝ ወፈጥሙ። <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />እያታቲ ሰብ እዝጌር በጠራወ ሐለት ጠናም የንብር። <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />በጠረከ ግዝየ ጉዙ ባነኸ? በዚ አትጨነቅ፤ ነጣነታኸም ወርክብ በቻልከ ነጣነታኸ ተቀበር። <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />መሳሑም ጉዝ ኸነም ትናነ በጔታ የጠራ፤ የጔታ ነጣ ሰቡ፤ ዛኸም ቲጠሬ ነጣ የኸነ ሰብ የክርስቶስ ጉዙ። <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />በክርስቶስ ደም ተገዛሑም፤ ስለኸነም የሰብ ጉዙዎች አትሕኖ። <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />አማኞች፤ እያታቲ ሰብ በጠራወ ሐለት ተእዝጌርጌ ጠናም የንብር። <verse eid="1CO 7:24" /><verse number="25" style="v" sid="1CO 7:25" />ያናግቦ አልቡላ አፍቶም፤ በጔታ የቌበርኩን ትዛዝ ኤኔ፤ የሕን አንከንም፤ በጔታ ምረት የትነሣ የታማኝ ሰብኸም፤ ምክረኛ ይብከ። <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />ኧሗ ታነዪ ምካት የትነሳ ባነሑᎄ ሐለት ብትነብሮ ፈያ ይመስሬ። <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />አገባኸም በኸነ ወፋታ አትሴ፤ ባናግባኸ ምሽት የዋግባ አትሴ።። <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />ብታገባ አጢያት አንሰከትከ፤ አፍቶ ብታገባ አጢያት አንሰከተች። ቢኸንም ያገቦዪ ሰቦች በዚ ዓለም ብዠ ምካት ይገጥሞ፤ እያም ዚ ኤሰላብኩኸም ኧወድ። <verse eid="1CO 7:28" /><verse number="29" style="v" sid="1CO 7:29" />አማኞች! አሳበኛ እኪቱ፤ ዘበኒ አጭሩ፤ በሒሽ ምሽት ያነኖ ዬነኖኸም ኸኖም የንብሮ። <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ይበሖ ኤበሖኸማ፤ ይትብላለቆ ኤይትብላለቆኸማ የሕኖ፤ ግብር ይስሮ የስሮይ ቃር የሕኖ ያንከነኸማ የቆጥሮ፤ <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />በዚ ዓለም ቃር ይጠቀሞዪ ኤይጠቀሞᎄኸም የሕኖ፤ የዚ ዓለም መልክ ዐላፊሙ። <verse eid="1CO 7:31" /><verse number="32" style="v" sid="1CO 7:32" />እያሽ ያለወጨነቅ ትነብሮኸም ኧወድ። ያናግባ ሰብ የጔታ የዋትብላልቅ ስለጔታ ቃር ዬስብ። <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />ያገባ ሰብም ምሽተሑ የዋትብላልቅ የዚ ዓለም ቃርም ዬስብ። <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />በዚኸም ልበሑ ተሳደም። ያናግባች ገረድ ወይ ድንግል ስለጔታ ቃር ቴስብ፤ ዐላማዬታ በበሠር በመንፈስም የጔታ ወቀደሱ። ያገባች ገረድም ምሴታን የዋትብላልቅ የዚ ዓለም ቃር ቴስብ <verse eid="1CO 7:34" /><verse number="35" style="v" sid="1CO 7:35" />ዚም ኧቡኒ ያሑ ይጠቅምሑዪ ቃር በዋስብ አንኸንም አጬንቅኩዬ አንከነ፤ ዐላማኛ ሒናሑ ቴይሰድ በጔታ ጠናሑም በአግባበሑ ትነብሮኸሙ <verse eid="1CO 7:35" /><verse number="36" style="v" sid="1CO 7:36" />አት ሰብ እጮኛሑ የሸከተናዪ ድንግል ባግባበሑ ባንጠበጠ፤ ሒቲም በድሜታ ትትደብር በወረች፤ ያገባናዬ ቤሰበ የወደደኒ የሰክት፤ አጢአት ኤነወ የትጋቦ። <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />ቢኸንም አት ሰብ በሒነሑ በጠና፥ ያትጌድድ ቃር ቤነወ፥ ኤላተሑ የወቁጣጠር በቻለ እጮኛውታን ያለዋግባ በዌሰነ ፈያ ሸከተ። <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />ስለኸነም ድንግሊም ያገባ ፈያ ሸከተ፤ ያናግባም የጠቀለ ሸከተ<note caller="+" style="f"><char style="fr" closed="false">7፥36-38 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">አት ሰብ ድንግል የኸነቺ ገረድ ቢያገባ ያንጠበጠናኸም ቤሰበ ሒቲም በዕድሜታ ትትደብር በወረች፣ ዋግባ ያነባኸም ቤሰበ የወደደኒ የሰክት፤ አጢአት ኤነብርወ ታገባኸም ይፌኧድናዬ ይጌባ። </char><char style="fv" closed="false">38</char><char style="fqa" closed="false">ስለኸነም ድንግል የኸነቺ ገረደሑ የጋብቻ ያበ ፈያ ሸከተ፤ የጋብቻ ያናበናዪም የጠቀለ ሸከተ። </char></note>። <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />አት ምሽት ምሴታን በሕይወተሑ ትናነ ስን ተሑቲጌ ኧጉጀኘ የኸነቺያ፤ ምሴታ ቢᎀትም፤ የሸቺ ሰብ የዋግባ ነጣነት ነነና፤ ምሲም በጔታ ወሕን ነነወ። <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />ይያኸማ በኸነም ታታገባ እክም ብትነብር የጠቀለ የትብላለቀች ትኸን፤ እያም ኧሗም የእዝጌር መንፈስ ቢያ ᎈር ያነ ይመስሬ።<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s1">የጣዖት ያረጂ በሠር</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />የጣዖት ያረጂ በሠር ኧሗም ዚ ኧብር፤ እንመናም ውቀት ያነነኸም ኧሒርነ<note caller="+" style="f"><char style="fr" closed="false">8፥1 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">አሑ ትብሮይኸም </char><char style="ft" closed="false">“እንመና ውቀት ነነ”። </char></note>። ውቀት ያስታብይ፤ ፍቅርም ዬንጥ። <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />ኧሒር ይብር ሰብ፤ ወሐር ይጌቧኒ ቅጫ ገና አንካረ። <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />የእዝጌር ይወድ ሰብም በእዝጌሬ የትኴረው። <verse eid="1CO 8:3" /><verse number="4" style="v" sid="1CO 8:4" />በይሽ የጣዖት ያረጂ በሠር ስለወብራ እኪ ይብር፤ በዚ ዓለም ጣዖት ኤድገልል የኸነኸም ታቲ ተእዝጌር አንከንም ኧንጐድ አምላክ ዬነኸም ኧሒርነ። <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />መቸም ብዠ አማልክት ብዠ ጌቶችም ነኖ፤ በሰሜም ኸነ ባፈር አምላክ ቧርዮም ይጠሮ አማልክት ቢነብሮም፤ <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />ይናም እንም ቃር በሑቲ የኸነ፤ ኢናም የሑቲ የኸነ ቁና አምላክ አብ ነነነ፤ ኧሗም እንም ቃር በሑቲ መሳ የኸነ፤ ኢናም በሑቲ መሳ የኸነ ቁና ጔታ ኢየሱስ ክርስቶስ ነነነ። <verse eid="1CO 8:6" /><verse number="7" style="v" sid="1CO 8:7" />ቢኸንም ዚ ይሒሮ፥ እንም አንከነ፤ አታቶቺ ኧሗ ስን ጣዖት ዋምልክ የሮሶ ስለኸነ በሠር ይበሮዪ የጣዖት ያረጂኸም ሸከቶሙ፤ ስለኸነም ሕሊናሕኖም የቌጠ በወሕነሑ ይረክሶ። <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />ቢኸንም ስንቅ ተእዝጌሬ ኤያቀርብነ፤ ባንበራነ ይቀብልብነ ቃር ዬነ፤ ብንበራነ አተርፍነዪ ቃር ኤነብር። <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />ቢኸንም በነጣነታሑ የትነሳ ትሸክቶይ የቌጦዪ ቈፋ ኤኸንኸም ተቀሮ። <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />“ውቀት ነኔ” ባኸም የጣዖት ያረጂዪ በቤተ ጣዖት ትትበራ በእምነተሑ ያንቆመረ ሰብ ቢያዥከ ዚ ሜና ምሲ የጣዖት ያረጂዪ ይበራኸም ኤያድፋፉር? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />ስለኸነም ክርስቶስ የᎀተነ ዚ የቌጠ ጐቤ በአኸ ውቀት መሳ ጠፋ ወበሩ። <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />በዚ ኤማ ጐባቢቶቻሑ በወበደልም የቌጠ ሕሊናሑም በዋምዘይ፤ ክርስቶስም ትቤድሎ። <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />ስለኸነ እያ ኧᎄራኒ ቃር የጐቤኛ ቈፋ ይኸን በኸነ፤ ጐቤኛ ቈፋ ተወሕን ትንብር ስርም በሠር አንበራ።<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s1">የሐዋርያነት መብት</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />እያ ነጣ ሰብ አንከንኩ? ሐዋርያ አንከንኩ? የጔታናም የኢየሱስ አነዠሑን? አሑሽ በጔታ የሜናኛ ፍርየ አንከንኩ? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />የንጐዲ ሐዋርያ ባንኸን ያሑም የኢንም ሐዋርያንኩ፤ መሳሑም በጔታ የሐዋርያነተኛ ማተብ አሑትንኩ። <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />ይምረምሮኝ ኧቡኒ መልስ ዚቱ። <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />የወሕነሑ፤ የወብራ የወስጤም መብት ኤነነ? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />ይንጐዲኸም ሐዋርያት፤ የጔታ ጐባቢት የኬፋ<note caller="+" style="f"><char style="fr" closed="false">9፥5 </char><char style="ft" closed="false">ጴጥሮስ ወበሩ</char></note> ኸም እንም፤ ኢናሽ አማኝ ምሽት ጠበጥነም የወዞር መብት ኤነነው? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />ወይሽ በሜና ትንጠርነ ወንብር ያነብነ እያ በርናባስም ጠለለንነ? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />የወሕነሑ በፎለሑ ዋጋሑ በወታደርነት ያግለግል ሟኒ? ወይን ቀበረም ኤበራሽ ሟኒ? ኧሬ ቲቅየ የሬዪ ብጭወ ኤሰጭ ሟኒ? <verse eid="1CO 9:7" /><verse number="8" style="v" sid="1CO 9:8" />ዚ ኧዝነጊኒ የሰብኸም አስተሳሰቡ? የእዝጌር ሕጊ ዚም ኤይብር? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />መሳሑም ሙሴ ሕጊ፤ “ይቄሊሲ ቦራ አፈሑ አትጉጅ” ቧሪም ተጣፈም፤ ኧጌ፤ እዝጌር ያናሰᎄን የቦራ ቃር አንከነ?<note caller="-" style="x"><char style="xo" closed="false">9፥9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዘዳ. 25፥4</ref>፤ <ref loc="DEU 5:18">5፥18</ref>። </char></note> <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />እዝጌር ዚ የቧረን ስለይና አንከነ? ያርስ ገበሬ በተስፋ ያርስኸም፥ ይቄሊሲ በተስፋ ይቄልስኸም፥ ተምርቲ ሟኔሑ ይረሕብኸም ዚ የጣፈዪ የኢንም ስለይናው። <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />ኢና ባሑ ግብት መንፈሳዊ ዘር ዘራነም በኸነ የበሰር ይኸን ቃር ብናድነ ወደል ቃር ወሕነሑታው?<note caller="-" style="x"><char style="xo" closed="false">9፥11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">ሮም 15፥27</ref>። </char></note> <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />ኧንጐድ ዚ መብት ታሑ ወርክብ በቻሎ፤ ኢና ይጠቅል ወርክብ ኤይገባነ? ኢናም በዚ መብት አንትጠቀምነ፤ ይጠቅልሽ የክርስቶስ ወንጌል ቈፋ አንኸነኸም ይንም ቃር ኧፈርክነ። <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />በቤተ መቅደስ ያግለግሎ ስንቀሕኖ ተቤተ መቅደስ ይረክቦኸም፤ በመሠዊያዪ ያግለግሎዪ በመሥዋዕተሑ ይሰዶኸም አትሒሮ?<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="DEU 18:1">ዘዳ. 18፥1</ref>። </char></note> <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />ዛምኸም ኧሗም ወንጌል ይሰብኮዪ የኑሮ ያሸኖዪ የወንጌል ሜና ይሸክቶዪ ይቌበሮኸም ጔታ ኤዘዘም።<note caller="-" style="x"><char style="xo" closed="false">9፥14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">ማቴ. 10፥10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10፥7</ref>። </char></note> <verse eid="1CO 9:14" /><verse number="15" style="v" sid="1CO 9:15" />እያም ተዚሕኖ መብቶች በአቲ ቢኸንም አንትጠቀምኩ፤ ኧሗም ዚ ኧጠፍንኩዪ ነዚሕኖ ያኖዪ ቃሮች ትሸክቶኒ ቢብር ተስፋ አንከነ፤ ሟንም ወትነነደኛ ኤድገልል ቃር ቢሸክትቢ ሞት ይጠቅሌ። <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />ወንጌል ወስብከኛ ኤያትነነዴ፤ ኧሰቡኲ ግዴታኛ ስለኸነው፤ ወንጌል ባንሰብክ ወዮ ይያ! <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />መሳሑም በፈአደኛ ብንሰብክ ሽልማት ነኔ፤ በፈአደኛ ባንከነም፤ ኧፌጥᎁ ሜና ያደጉቢዪ ዐደራ ወትወጣ ጠለለ ይኸን። <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />ኧጌሽ ሽልማተኛ መአሩ? ሽልማተኛም ወንጌል ትንሰብክ በመብተኛ ታንጠቀም ወንጌል ያለ ክፍያ ወስብኩ። <verse eid="1CO 9:18" /><verse number="19" style="v" sid="1CO 9:19" />እያ ነጣ ሰብንኩ፤ የሟንም አገልጋዪ አንከንኩ፤ ቢኸንም ብዠሕኖ ኧዠብሬ ነብሰኛም የሰብ እንም አገልጋዪ ኧሸኩች። <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />የአይሑድ ኧዠብሬ ተአይሑድጌ የአይሑዳዊኸም ኸንኩ፤ እያ ነብሰኛ ተሕጊ ተት ታንኸን፤ ተሕጊ ተት ያኖዪ የዋትርፍ ተሕጊ ተት ያኖኸም ኸንኩ። <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />እያ የእዝጌር ሕጊ ያኔ ተክርስቶስ ሕጊ ተት ብንኸንም ሕጊ ዬነኖዪ አሕዛብ የዋትርፍ ትንብር ሕጊ ዬነን ሰብኸም ኸንኩ። <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />የቌጦዪ አትርፌ፤ ተቌጦዪጌ የቌጠኸም ኸንኩ፤ በቻሌ ቅጫ እንም አታቶቺ አተርፎኸም፤ ትንመሕኖጌ እንም ቃር ኸንኩ። <verse eid="1CO 9:22" /><verse number="23" style="v" sid="1CO 9:23" />ዚ እንም ኧሸክት፤ በወንጌል በረከት ኧሰዴ፤ የወንጌል ባሑሙ። <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />በሩጫ ውድርድር ይሮጦ ብዠኖ፤ ሽልማት ይቌበሪም አቲ ጠለለ አንከነ? ስለኸነ ሽልማት ይቌበር ሰብኸም ሩጦ። <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />በሩጫ ይውዳደሮ እንም ያቌጥ ልምምድ ይሸክቶ፤ ሕኖ እኪ ይቌጦ ይጠፋዪ የግዝየሑ የኸነዪ አክሊል የወርክቡ፤ ኢናም ኧቌጥነዪ ኤይጠፋዪ ዘለዓለማዊዪ የኸነዪ አክሊል የወርክቡ። <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />ስለኸነም እያ ግብ ዬነን ሰብኸም ቤድገልል ቃር አንሮጥ፤ ኧሗም ኧንፋስ ይጐስም ሰብኸም ዛምኸም አንትጋደል፤ <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />ቢኸንም ይንጐዲ በሰበኩ አንቌ እያ ነብሰኛ ወጠቅኩም አንቀይኸም፤ ገገኛ ትንቁጣጠርም ይገዛኒኸም ኧሸኩች።<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s1">ተጣዖትጌ አለወትገገዝ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />ጐባቢተና! አቦቸና ዳበና በነንሕኖ ኸነም ይመራኖ የነበረኸም እንም ብሻ ባሪ የጔኖኸም አስታውስኩዬ ኧወድ።<note caller="-" style="x"><char style="xo" closed="false">10፥1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">ዘፀ. 13፥21-22</ref>፤ <ref loc="EXO 14:22-29">14፥22-29</ref>። </char></note> <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />የሙሴ ተባባሪዎች በዚ ዳበና በዚ ባርም ተጠመቆ። <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />እንም ታት መንፈሳዊ ስንቅ በኖ፤ <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />እንም ታት መንፈሳዊ መጠጥ ሰጦ፤ ይትዄተሎ ተነበረዪ መንፈሳዊ ዐለት ሰጦም፤ ዛ ዐለት ክርስቶስ ባነ። <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />የሕን አንከንም እዝጌር በብዠሕኖ ያንተብላለቀ ስለኸነ በበረሐ ወጠቆም ቀኖ።<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />ሕኖም ቡሼ ኤላተሕኖኸም፣ ኢናም ኧሗም አኔላነኸም ነዚሕኖ ቃሮች ምሳሌ ኸኖንነም። <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />“ሕዝቢ ይበሮዬ ይሰጦዬም ቾኖ፤ ይደርሶዬ ተነሦ”<note caller="-" style="x"><char style="xo" closed="false">10፥7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">ዘፀ. 32፥6</ref>። </char></note> ቧሪም የጣፈኸም፣ ተሕኖ አታቶቺ የሸከቶይኸም ጣዖት አምላኪዎች አትሕኖ። <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />በሕኖ አታቶቺ ዝሙት ፌጠሞም በቁና ከነ ሑያ ሦስት ሺ ሰብ የᎀቶኸም፣ ኢናም ዝሙት አንሸክትነ። <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />ተሕኖ አታቶቺ ጔታ የፍታተኖይኸም ብንድወደረ ተነደፎም የᎀቶኸም፣ ኢናም የጔታ አንፍታተነ።<verse eid="1CO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 10:10" />ተሕኖም አታቶቺ ቁምቁሜ የባሮኸም ባጥፊዪ መላይካ የጠፎኸም አሑም ቁምቁሜ አትበሮ።<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />ዚ እንም ምሳሌ ይኸኔ በሕኖ ᎈር ሰላ፤ የዘበናት ፍጣሜ የሰላብነዪ ይና የዋትቀየ ተጣፈ። <verse eid="1CO 10:11" /><verse number="12" style="v" sid="1CO 10:12" />ስለኸነም የቈመ ይᎀስር ሰብ ቈምኩም ኤወጥቅኸም የትቀየ። <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />በሰቦች እንም ᎈር በሰላዪ የትለየ ፈተና አንሰላቦ፤ እዝጌር ታማኙ፤ ስለኸነም ትትችሎዪ ነን ትፌተኖኸም ኤገፍርሑ፤ ቢኸንም ብትትፌተኖᎄ ግዝየ ፈተናዪ ወታገሥ ትችሎኸም፣ ይወጨᎄ ኤማዪ ያዝጋጅንኩ።<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />ስለኸነም ደቦቸኛ፤ ተጣዖት አምልኮ ስኮ። <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />ዚም ኧዝነጊሑ አስተዋይ የኸኖ ሰቦቹ፤ ኧዝነጊኒ ስለኸነዪ ቃር አሑ ፍርዶ። <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />አምሰጉኒ ኧሰጭነዪ የበረከት መጠጥ ተክርስቶስ ደምጌ አትነት ያነን አንከነ? ኧፍረርምነዪ ቂጣ ተክርስቶስ በሠርጌ አትነት ያነን አንከነ?<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">ማቴ. 26፥26-28</ref>፤ <ref loc="MRK 14:22-24">ማር. 14፥22-24</ref>፤ <ref loc="LUK 22:19-20">ሉቃ. 22፥19-20</ref>። </char></note> <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />ቂጣዪ ቁና የኸነኸም፤ ኢናም ብዠ ኸነም ትናነ ቁና ጅስምንነ፤ እንመና አቲም ቂጣ ኧሰሰድነ። <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />እንዴ የእስራኤል ሕዝብ አስቦ፤ መስዋዕቲም ይበሮዪ ቲያርጅᎄዪጌ አትነት አነበረኖ?<note caller="-" style="x"><char style="xo" closed="false">10፥18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">ዘሌ. 7፥6</ref>። </char></note> <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />ኧጌ፤ የጣዖት ያረጂ ቃርም ኸነ ጣዖቲ ነብሰሑ ዋጋ ያነን ቃሩ ወበረኛው? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />አንከነ፤ አሕዛብ ያርዶዪ የእዝጌር ቴይኸን የአጋንቱ፤ ተአጋንትጌ አትነት ትትገገዞዬ አንሸ።<note caller="-" style="x"><char style="xo" closed="false">10፥20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">ዘዳ. 32፥17</ref>። </char></note> <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />የጔታ መጠጥም፤ የአጋንት መጠጥ ቁናዬ በወሕን ወስጤ አትችሎ፤ በጔታ ማዳ ተአጋንት ማዳም ወሰሰድ አትችሎ። <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />የጔታ ናትቄናነይ? በወበርታሽ ተሑቲ ኧበዛነ?<note caller="-" style="x"><char style="xo" closed="false">10፥22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">ዘዳ. 32፥21</ref>። </char></note><verse eid="1CO 10:22" /></para>
  <para style="s1">የአማኞች ነጣነት</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />“እንም ቃር ተፌቀደም”፤ ቢኸንም እንም ቃርም ኤይጠቅም፤ “እንም ቃርም ተፌቀደም”፤ ቢኸንም እንም ቃርም መንፈሳዊ ወሰከት ኤዬንጥ።<note caller="-" style="x"><char style="xo" closed="false">10፥23 </char><char style="xt" closed="false"><ref loc="1CO 6:12">1 ቆሮ. 6፥12</ref>። </char></note> <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />እያታቲ ሰብ የመራርቻሑ ጥቅም አንከንም የነብሰሑ ጠለለ ኤይሴ። <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />ተሕሊናሑ ምርምር ውስጥ ታትገቦ፤ በበሠር ገበያ ይስሬዪ እንም ብሮ። <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />በአፈርም በውስጠሑ ያነዪም እንም የጔታው።<note caller="-" style="x"><char style="xo" closed="false">10፥26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">መዝ. 24፥1</ref>። </char></note> <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />ኤያምን ሰብ ጋበዘናሑም የወወር ብትሸዎ በሕሊና ምርምር ውስጥ ታትገቦ የቀረበኩዪ እንም ብሮ። <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />ቢኸንም አቲ፤ “ዚ የጣዖት ያረጂው” ቢብርሑ፤ ዚ ስለዝነጔናሑ የሰብ የሕሊናሑም ትትብሮ አትብሮ<note caller="+" style="f"><char style="fr" closed="false">10፥28 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">አትብሮ፤ “በአፈርም በውስጠሑ ያነዪ እንም የጔታው።” </char></note>። <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />ዚ ኧቡኒ ስለዚ ሰብ ሕሊና አንከንም ስለአኸ አንከነ፤ ነጣነተኛሽ በንጐድ ሰብ ሕሊና የመአር የᎀዝኒ? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />ስንቀሑ በምስጋና ይበራ በኸነ፤ የእዝጌር ባምሰገንኩወ ዘንጋ የመአር ኧትወቀስ? <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />ኧጌሽ ትትበሮ ኸነ ትትሰጦ፤ ሟንመሑ ቃር ትትሸክቶ፤ እንም ቃርም የእዝጌር ክብር ሰክቶ። <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />የአይሑድም ኸነ የግሪክም የእዝጌር ሕዝብ አማኞች ቈፋ አትሕኖ፤ <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />እያ የሰብ እንም በሟንመሑ ቃር የዋትብላልቅ ኧጋደልኸም አሑም ዛምኸም ሰክቶ፤ ብዠሕኖ ይተርፎዬ፤ የነብሰኛ ይጠቅሜዪ ቴይኸን፤ የሕኖ ይጠቅሚ ኧሸ።<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="s1">ሥርዐት ያነን አምልኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />እያ የክርስቶስ ምሳሌ ኧትዄተልኸም አሑም ይያም ተከተሎኝ።<note caller="-" style="x"><char style="xo" closed="false">11፥1 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4፥16</ref>። </char></note><verse eid="1CO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />ብንም ቃር ቴስቦኒኸም ቢያ የቌበርኩዪ ትምርት ፈያኸም የጠበጥኩ ስለኸነ አምሰግንኩ። <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />ቢኸንም ዚም ቲሒሮኸም ኧወድ፤ የምስ እንም ጉነን ክርስቶሱ፤ የምሽት ጉነን ምሱ፥ የክርስቶስም ጉነን እዝጌሩ። <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />ጉነነሑ ተክናነበም ይጤልይ ወይ የትምቢት ቃል ይዝነግ ገሜ ነብሰሑ ያትዋርድ፤ <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />ዛምኸም ጉነኔታ ታትክናነብ ትጤልይም የትምቢት ቃል ትዝነግ ምሽት በምሽት ᎈር ሥልጣን ያነኒ ገሜ ታትዋርድ፤ መሳሑም ጉነኔታ አትክናነብ ምሽት የላጪያኸም ትትቆጠር። <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />ምሽት ጉነኔታን አትክናነብ በኸነ፤ ጉነኔታን ትታረጥ፤ ጉነኔታን ወታረጥ ወትላጭም ያትማልላ መሰረም በታዠናም ጉነኔታን ትሸፉን። <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />ምስ ጉነነሑ ወሸፍነ ኤነወ፤ መሳሑም ምስ የእዝጌር ምሳሌ ክብሩ፤ ምሽትም የገሜ ክብርያ፤ <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />መሳሑም ምሽት ተምስ ተረከበችም አኸንም ምስ ተምሽት አንትረከበ። <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />ኧሗም ምሽት የምስ ተኸለቀች አንከንም ምስ የምሽት አንተኸለቀ። <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />በዚ መሳ በመላይካም መሳ ምሽት የሥልጣን ምልክት የኸነዪ ትክናነብወ በጉነኔታ ሻሺ ትግድ። <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />በጔታዬም ምሽት ፍርየ ኤባን ምስ፤ ምስም ፍርየ ኤባን ምሽት ኤይኸን። <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />መሳሑም ምሽት ተምስ የትረከበችኸም እንም፤ ምስም ተምሽት ይጨኝኸም፤ ቢኸንም ይንም ርሕቦት እዝጌሩ። <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />እንዴ ነብሳሑ ፍርዶ፤ ምሽት ጉነኔታን ታትሽፋፈን ተእዝጌሬ ወጠልዬታ ይጌባና? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />ምስ ጉነነሑ ቢያጎፍር ነውር ይኸንወኸም ኸልቀቲ አናትመረናሑ? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />ምሽትም ጉነን ያቡያ ጉነኔታን ትሼፍንወዬ ስለኸነ ጉነኔታን ብታገልፍ ክብሬታ አንከነ? ገሊፍ ጉነን ያቡያ የሽቲ ክብሬታኑ። <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />በይሽ ሟንም በዚ ወባጀ ᎈር ኦገት ቢሸ፤ ኢናም ኸነ የእዝጌር ሕዝብ የኸኖ አማኞች በዚ የትለየ ወሮሽ ኤነነ።<verse eid="1CO 11:16" /></para>
  <para style="s1">የጔታ ኧርባት</para>
  <para style="r">(<ref loc="MAT 26:26-29">ማቴ. 26፥26-29</ref>፤ <ref loc="MRK 14:22-25">ማር. 14፥22-25</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፥14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />ቢኸንም ብትስበሰቦᎄ ግዝየ ይጎዳ አንኸንም ይጠቅም ያንከነ ስለኸነ፣ ዚ ትዛዝ ትኒብ ትናምሰግንኩ አንከነ። <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />ትንም በደረም በቤተ ክርስቲያን ብትስበሰቦᎄ ግዝየ በግብታሑ ወልያይ ያነኸም ሰማሑም፤ ዚም ይኸኔ ይችልኸም ግብተሑ አምን። <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />ታሑ ግብት የኢነተኞቺ ተላኖም ይትኴሮዬ፣ ዚ ወልያይ በግብታሑ ወንብረሑ ግዱ። <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />ብትስበሰቦᎄ ግዝየ ትበሮይ የጔታ ኧርባት አንከነ፤ <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />ብትበሮᎄ ግዝየ አቲ የንጐዲ ቴይቅየ ስንቀሑ ይበራ፤ አቲ ቲጐጅም እንጐዲ ይሰክር። <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />ኧረ ወሕነሑ ትበሮᎄዪ ትሰጦᎄዪም ቤት ኤነናሑ? ወይሽ የእዝጌር ቤተ ክርስቲያን በወናቅ፣ አትም ዬነኖዪ ታትማልሎዮ? ኧጌሽ መአር ንበርሑ? በዚ ዘንጋ ናመስግንኩ? ስርም አናምሰግንኩ! <verse eid="1CO 11:22" /><verse number="23" style="v" sid="1CO 11:23" />እያ በጔታ የቌበርኩኒ ዚም ሥራት የአሑ አችላለፍኩም፤ ጔታ ኢየሱስ አቸለፎም ባቡᎄ ምሳር ቂጣዪ ነሣም <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />ባምሰገነ አንቌ ቂጣዪ ፈረመም፣ “ዚ ይያ ጅስሙ ስላአሑ ይኸን በሠረኛው፤ ኧዘገድወዬ ሰክቶ” ባረ። <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />ዛምኸም በርባት አንቌ መጠጢ ነሣም፤ “ዚም መጠጥ በደመኛ ይኸን ገደር ጉዳው፤ ስለኸነም በመጠጢ ብትሰጦᎄ ግዝየ ዚ ኧዘገድወዬ ሰክቶይ” ባረ።<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />ዚ ቂጣ ብትበሮᎄ ግዝየ፣ ዚም መጠጥ ብትሰጦᎄ ግዝየ እንም ጔታ ይቸኝ ስን ሞተሑ ትዝነጎ።<verse eid="1CO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27" />በይሽ ሟንም ቴይጔቧን፤ ዚ ቂጣ ቢይበራ የጔታ መጠጥ ቢሰጭ፤ የጔታ የጅስመሑ የደመሑም ባለዕዳ ይኸን። <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />ሟንም ሰብ በዚ ቂጣ ተወብራሑ በዚ መጠጥ ተወስጤሑ ኢፍት፤ ነብሰሑ የመርምር፤ <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />መሳሑም ሟንም የጔታም ጅስም ቴይጔቧን<note caller="+" style="f"><char style="fr" closed="false">11፥29 </char><char style="fqa" closed="false">ቴይላኝ </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቴይትሬዳ</char><char style="ft" closed="false">ወበሩ</char></note> ቢበራ ቢሰጭም ፍርድ ያቸኝወዪ ይበራ፤ ይሰጭ። <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />ታሑ ግብት ብዠሕኖ የቌጦዪም የታቆዪ፤ አትባተሕኖም የᎀቶዪ በዚ መሳው። <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />ነብሰናም ብንምረምርነ ባንትፈረደብነ ባነ። <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />ቢኸንም ጔታ ቢፈርድብነ ግዝየ ኧጔሰጥነ፤ ዛምኸም ተዓለምጌ ቁናዬ አንኮነነኸሙ። <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />ስለኸነም አማኞች፤ የወብራ ብትስበሰቦᎄ ግዝየ ነብስ በነብሳሑ ተቀሮ። <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />ብትስበሰቦᎄ ግዝየ የፍርድ ኤኸንብኩኸም፤ ሟንም የጓደን ሰብ ቢነብር በቤተሑ የብራ። የቀኘዪ ቃር ኧሗም ብንቸኝወ ግዝየ ኧዌስን።<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s1">መንፈሳዊ ስጦታዎች</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />አማኞች! ኧሗም ስለመንፈሳዊ ስጦታዎች ዚም ቲሒሮኸም ኧሸ። <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />አሕዛብ በነበርኩᎄ ግዝየ ተዛዬና ተዚዬ ᎀረኩም ዱዳ ተኸኖዪ ጣዖታት የትወሰድኩኸም ቲሕሮ። <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />ስለኸነ ሟንም በእዝጌር መንፈስ ይዝነግ፤ “ኢየሱስ የሰደበው” ይብር ኤነ፤ ዛምኸም በመንፈስ ቅዱስ ባንከነ፤ ሟንም “ኢየሱስ ጔታው” ይብር ኤነኸም ኢውድሑ። <verse eid="1CO 12:3" /><verse number="4" style="v" sid="1CO 12:4" />የመንፈሳዊ ስጦታዎች የትልያዮ ቢኸኖ፤ መንፈስ ቅዱስ ቁናው፤ <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />አገልግሎትም የትልያየ ቲኸን፤ ጔታ ቁናው፤ <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />ሜናም የትልያየ ቲኸን፤ እንም ብንም ይሸክቲም ዛም ቁናዪ እዝጌሩ። <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />ቢኸንም የመንፈስ ቅዱስ ወግልጥ የያታቲ ሰብ ይᎅ የደነብ ጥቅሙ። <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />ያቲ በመንፈስ የብላት ቃል ወዘንግ ይቡ፤ <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />ያቲ በዛም መንፈስ እምነት ይቡ፤ ይንጐዲ ኧሗም በዛም በአቲ መንፈስ ስጦታዎች ይቡ፤ <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />ያቲ ታምራት የወሰክት፤ ይንጐዲ ትምቢት ወዘንግ፤<note caller="+" style="f"><char style="fr" closed="false">12፥10 </char><char style="fqa" closed="false">የትምቢት ቃል፦ </char><char style="ft" closed="false">የእዝጌር ቃል ወተርጉም፥ ዋብራራው። (ሮም 12፥6 ተመልከት)</char></note> ይንጐዲ ኧሗም መናፍስት የወላይ፤ ያቲ በትልያየ ልሳን የወዘንግ፤ ይንጐዲ ኧሗም በትልያየ ልሳን የዝነጒዪ የወተርጉም ስጦታ ይቡ፤ <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />ነዚ እንም የዛም ያቲ መንፈስ ሥጦታዎች ቲኸኖ፤ የአቲ የያታቲ ሰብ ሑቲ ነብሰሑ የፌቀደኸም ይቡ።<note caller="-" style="x"><char style="xo" closed="false">12፥11 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">ሮም 12፥6-8</ref>። </char></note><verse eid="1CO 12:11" /></para>
  <para style="s1">በቁና ጅስም ብዠ ክፍሎች</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />ጅስም ብዠ ክፍሎች ቢነብሮይ አቲ ጅስሙ፤ ቢኸንም ክፍሎች ብዠ ቢኸኖም ጅስም ቁናው። ክርስቶስም ዛምኸሙ።<note caller="-" style="x"><char style="xo" closed="false">12፥12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">ሮም 12፥4-5</ref>። </char></note> <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />አይሑድም የግሪክ ሰቦች ብንኸነ፤ ጉዙም ነጣ ሰቦች ብንኸነ፤ ኢና እንመና ቁና ጅስም ኧኸነኸም ባት መንፈስ ተጠመቅነም፤ እንመናም አቲም መንፈስ ሰጨነም። <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />ጅስም የሸኰቺ በብዠ ክፍሎች አንከንም ተቁና ብልት አንከነ። <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />ኧግር “እያ ኧጅ ስላንከንኩ የጅስም ክፍል አንከንኩ!” ቢብር ዚ በወበረሑ የጅስም ክፍል ወሕነሑ ይቀይ? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />እንዝንም፤ “እያ ዔን ስላንከንኩ የጅስም ክፍል አንከንኩ” ቢብር ዚ በወበረሑ የጅስም ክፍል ወሕነሑ ይቀይ? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />ጅስም እንም ዔነሑ ቢኸንማ፤ ወስማ ቤቴ ይትረከብ ባነ? ጅስም እንም እዝን ቢኸን፤ ወሶታ ቤቴ ይትረከብ ባነ? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />ቢኸንም እዝጌር የወደደኸም እያታቲም የጅስም ክፍል በመደር መደረሑ አወና። <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />እንም ቁና ብልት ቢኸንም ጅስም ቤቴ ይትረከብ ባነ? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />በይሽ ክፍሎች ብዠኖ፤ ጅስምም ቁናው። <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />ዔን የጀሑ፤ “አታሼ” ይቡኔ ኤይችል፤ ጉነንም የግረሑ “አታሼ” ቢቡን ኤይችል። <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />ዛምኸም የቌጠ ይመስሮዪ የጅስም ክፍሎች ስርም ያሸኖኖ። <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />የትናቆ የመሰሮ ክፍሎች ስርም ክብር ኒብነዮ፤ ኧሗም ኧማልልኖቦዪ ክፍሎች ስርም ኧንክባከብነዮ፤ <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />አንማልልነᎄ ብልቶቸናም ዚ ኤያሸኖ። እዝጌርም የጅስም ብልቶች ቁናዬ አግጣጠመም ክብር ይቀብሎዪ የበዛ ክብር አበኖም፤ <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />ዚም የሸከተ በጅስም ብልቶች ግብት ወትልያይ ቴነብር፤ ነብስ በነብሰሕኖ ይትሳሰቦኸሙ። <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />አቲ የጅስም ብልት ቲሥቃይ እንጐዶቺም የጅስም ብልቶች በሙላ ቁናዬ ይሥቃዮ፤ አቲ የገግ ብልት ቲከበር እንጐዶቺም የገግ ብልቶች ቁናዬ ተሑቲጌ ይትብላለቆ። <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />በይሽ አሑም የክርስቶስ ጅስምንኩ፤ እያታታሑ ብልቶችንኩ። <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />እዝጌር በአማኞች ውስጥ አተኘ ሐዋርያት፤ ዄታለኘ ነብዮች፤ ሦስታለኘ አስተማሪዎች፤ ቄጠለም ታምራት ይሸክቶዪ፤ ፈያ የወሰክት ስጦታዎች ያነኖዪ፤ እንጐዲ የወርዳ ስጦታ ያነኖዪ፤ የዋትዳድር ችሎታ ያነኖዪ በትልያየ ልሳን ወዘንግ ስጦታ ያነኖዪም ሰቦች አወናም።<note caller="-" style="x"><char style="xo" closed="false">12፥28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ኤፌ. 4፥11</ref>። </char></note> <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />እንም ሐዋርያትኖ? እንም ነብዮችኖ? እንም አስተማሪዎችኖ? እንም ታምራት ይሸክቶኖ? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />እንም ፈያ የወሰክት ስጦታ ነነኖ? እንም በልሳኖች ይዝነጎ? እንም ይትረጉሞ? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />ቢኸንም ትንም ይበዛዪ ስርም ይበዞዪ ስጦታዎች የወርክብ ሳዎ።</para>
  <para style="p" vid="1CO 12:31">ኧሗም ትንም ይበዛዪ ኤማ አቴዥሑ።<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s1">ፍቅር</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />በሰቦች በመላይካም ልሳን<note caller="+" style="f"><char style="fr" closed="false">13፥1 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቋንቋዎች</char></note> ብንዝነግ፤ ፍቅርም ቤኔ ው ይብር ናስኸም ቺሊ ቺሊ ይብር ጸናጽልኸምንኩ። <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />የትምቢት ስጦታ ቢነብሬ፤ ምሥጢርም እንም ውቀት እንም ብንሒር፤ ቈቶ ታት መደር ትንጐድ መደሬ ይነቀል እምነት ቢነብሬ፤ ፍቅር ቤኔ አንድገልል። <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />ያኔዪ እንም የዜጋ ብኒብ፤፥ በሠረኛም ቴይቀይ በሳት ይነድኸም አቸለፍኩም ቢኒብ፣ ፍቅር ቤኔ አትም ኤድገልሌ። <verse eid="1CO 13:3" /><verse number="4" style="v" sid="1CO 13:4" />ፍቅር ፈራኪው፤ ፍቅር ፈያ ይሸክት፤ ፍቅር ቅናትመኘ ኤሸክት፤ ፍቅር ያነን ሰብ ኤትነነድ፤ ፍቅር ያነን ሰብ ኤይታበይ፤ <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />ተገቢ ያንከነ ቃር ኤይሸክት፤ ነብሰሑ ይወድ አንከነ፤ ኤይብሳጭ፤ በደልም ኤይቆጥር። <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />ፍቅር ተኢንጌ አንከንም ባመጥ ኤይትብላለቅ። <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />ፍቅር እንጌ ይፈርክ፤ እንጌ ያምን፤ እንጌ ተስፋ ይሸክት፤ እንጌ ጠናም ይቈም።<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />ፍቅር ስርም ኤይወጥቅ፤ ቢኸንም ትምቢት ቢኸን ይሸር፤ ልሳንም ቢኸን ይቀይ፤ ውቀትም ቢኸን ይሸር። <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />መሳሑም ኧሒርነዪ ግብተሑ፤ ትምቢት ኧዝነግነዪ ግብተሑ። <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />ቢኸንም ፍጡም የኸነዪ ቲቸኝ ግብተሑ የነበረዪ ቃር ይሸር። <verse eid="1CO 13:10" /><verse number="11" style="v" sid="1CO 13:11" />ትኸ ትናነሑ የትኸኸም ኧዝነግ ባነ፤ የትኸኸም ኤስብ ባነ፤ የትኸኸም ኧምራመር ባነ። አርዴ በኸንኩ አንቌም የትኽነቲ ቃር እርግፍ አበኘሑ ገፈርኩ። <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />ኧሗ አዥነ በመስታወት ውስጥ በጉቢላ ውስጥ ያዢኸ ሙ፤ በዛ ግዝየም ኢፍት ሊፍት አዥነ። ኧሗ ኧሒር ግብተሑ፤ በዛ ግዝየ እያ ነብሰኛ ሙላ በሙላ የሗርኝ ቅጫ ኧሒር።<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />ኧጌሽ እምነት፤ ተስፋ፤ ፍቅር ነዚ ሦስቲ ጠኖም ይነብሮ፤ ተዚሕኖም ይበዛዪ ፍቅሩ።<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s1">የትምቢት የልሳንም ስጦታዎች</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />ፍቅርም ተክታተሎ፤ መንፈሳዊ ስጦታዎቺ፤ በትለየም ትምቢት የወዘንግ ስጦታም በርቶም ሳዎ። <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />መሳሑ በልሳን<note caller="+" style="f"><char style="fr" closed="false">14፥2 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ብንጐድ ቋንቋ፤ </char><char style="ft" closed="false">ዛምኸም ቁ 4፥13፣14፣19፣26 ወይ 27 ተመ።</char></note> ይዝነግ የእዝጌር አንኸንም የሰብ ኤይዝነግ፤ ምሥጢር የኸነዪ በመንፈስ<note caller="+" style="f"><char style="fr" closed="false">14፥2 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በመንፈሰሑ</char></note> ይዝነግ ስለኸነ ይትሬዳን ኤነ። <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />ትምቢትም ይዝነጊም የወገንባ፤ የዋብርታታ የዋጥናናም የሰብ ይዝነግ። <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />በልሳን ይዝነግ የነብሰሑ ይግነባ፤ ትምቢትም ይዝነጊም የአማኞቺም ይግነባ። <verse eid="1CO 14:4" /><verse number="5" style="v" sid="1CO 14:5" />እንማሑም በልሳን<note caller="+" style="f"><char style="fr" closed="false">14፥5 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ብንጐዶቺ ቋንቋዎች፤ </char><char style="ft" closed="false">ዛምኸም ቁ 6፥18፣22፣23 ወይ 39 ተመ</char></note> ብትዝነጎ ኧወድ፤ ተዚ ይጠቅልም ትምቢት ብትዝነጎ ኧወድ። አማኞች ይግነቦኸም በልሳን ይዝነግ ሰብ የዝነጔኒ ባንተርጐመ፤ በልሳን ቲዝነጊ የጠቀለ ትምቢት ይዝነጊ ይበዛ። <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />ኧጌሽ አማኞች! ታሑዬ ብንቸኝወ ግዝየ በመገለጥ ወይ በውቀትም በትምቢት ወይ በትምርት ባኔወደኩሑ በልሳን ብንዝነግ ምን ኧጠቅምሑ?<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />የአንዱርኸም የክራርኸም ያኖዪ ሕይወት ዬነኖ የሙዚቃ መሳሪያዎች የትለየ የጣምባ ቅኝት ቤነኖ ይቦዪ የሙዚቃ ጣምባ መአር ወሕነሑ ምንኸም ይትኴር? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />ኧሗም ጥሩምባ ሱት ያንከነ የጥሪ ጣምባ ባናሰማ፤ ያርብ ሟ ይዝጋጅ? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />አሑም ዚኸምንኩ፤ ባለመታሑ ትርጉም ያነን ቃል ባንወጣ፤ ትዝነጎዪ ሟ ያጥራሙቼ ይችል? መሳሑም የኧንፋስ ትዝነጎ ትኸኖ። <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />በዓለም ᎈር ብዠኸማት ቋንቋ ነኖ፤ ትርጉም ዬነን ቋንቋ ኤነ። <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />በይሽ አት ሰብ ይዝነጊኒ ቋንቋ ትርጉመሑ ባንካረ፤ ይዝነጒኒ ባዘና ኧኸንወ፤ ሑቲም ይያ ባዘና ይኸንቢ። <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />አሑም ዛምኸምንኩ፤ መንፈሳዊ ስጦታዎቺ የወርክብ ትሸዎ በወሕናሑ፤ ቤተ ክርስቲያን ትታነጥወዪ ስጦታዎች የወርክብ ይበዛንኩኸም ሳቦ። <verse eid="1CO 14:12" /><verse number="13" style="v" sid="1CO 14:13" />ስለኸነም በልሳን ይዝነግ ሰብ ይዝነጊኒ ወተርጉም ይቸልኸም የጠልይ። <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />በልሳን ብንጤልይወ ግዝየ መንፈሰኛ ይጤልይ፤ አእምሮኛም ይትሬዳን ቃር ኤነ። <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />ኧጌ፤ ምን ወሰክት ነነቢ? በመንፈሰኛ ኧጤልይ፤ በአእምሮኛ ኧሗም ኧጤልይ፤ በመንፈሰኛ ኧዜምር፤ በአእምሮኛ ኧሗም ኧዜምር። <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />እኪማ ባንከነ የእዝጌር በመንፈስ ብታምሰግንወ ግዝየ፤ የዘንጋዪ ባዘና የኸነ ሰብ<note caller="+" style="f"><char style="fr" closed="false">14፥16 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቲቅሮዪ ግብት።</char></note>፥ አኸ ትዝነጊኒ ባንትረዳ፤ ምንኸም ሸከተም የምስጋናኸ “አሚን” ይብሬ ይችል? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />የኢን አኸ ያቀረብኰን የምስጋና ጠሎት በፈያ ሐለቱ፤ ቢኸንም እንጐዲ ሰብ ኤይታነጥወ።<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />ትንማሑ የጠቀለ በልሳን ኧዝነግ ስለኸነ የእዝጌር አምሰግን። <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />ቢኸንም በአማኞቺ ውስጥ እንጐዶቺ የዋትመር፤ ዐሥር ሺ ቃላት በልሳን ተወዘንግ የጠቀለ፤ አምስት ቃላት በአምሮኛ ብንዝነግ ይጠቅል። <verse eid="1CO 14:19" /><verse number="20" style="v" sid="1CO 14:20" />አማኞች! በአስተሳሰባሑ ሰብዬ አትሕኖ፤ የቡሼ ዘንጋ ሰብዬ ሕኖ፤ በአስተሳሰባሑም ጐልማሶች ሕኖ። <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />ዚም፦</para>
  <para style="q1" vid="1CO 14:21">“‘በትልያዮ ቋንቋዎች ቢዝነጎ ሰቦችም</para>
  <para style="q2" vid="1CO 14:21">ባለጋ ሰቦች አፍ የዚ ሕዝብ ኧዝነግ፤</para>
  <para style="q2" vid="1CO 14:21">ዚም ቢኸን ኤይሰሞኝ’ ይብር ጔታ እዝጌር”</para>
  <para style="m" vid="1CO 14:21">ቧሪም በሕግ ተጣፈም።<note caller="-" style="x"><char style="xo" closed="false">14፥21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">ኢሳ. 28፥11-12</ref>። </char></note><verse eid="1CO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22" />ስለኸነም በልሳን ወዘንግ ኤያምኖ ይኸን ምልክት አንከንም ያምኖዪ አንከነ፤ ትምቢትም ያምኖዪ አንከንም ኤያምኖዪ አንከነ። <verse eid="1CO 14:22" /><verse number="23" style="v" sid="1CO 14:23" />በይሽ የቤተ ክርስቲያን ምእመናን ቁናዬ በስበሰቦᎄ፤ እንም በልሳን በወዘንግ ᎈር ትናኖ፤ ግዝየ እያታቲ ክርስቲያን በትልያዮ ቋንቋ ቢዝነግ ኤይሒሮዪ ኤያምኖዪም ሰቦች ቢቸኖ ይዝነጎዪ “ነዚሕኖ ሰቦች ውስ ኸኖም” ኤይብሮ? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />ቢኸንም እንም ትምቢት በወዘንግ ᎈር ትናኖ፤ ባዘናም<note caller="+" style="f"><char style="fr" closed="false">14፥24 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ይሰል</char></note> ኤያምን ሰብ ቢገባ፤ ብንም ይትወቀስ፤ ብንም ይምረመር፤ <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />በልበሑ የሼተረዪ ቃር ይትገለጥ፤ ዛምኸም፤ “እዝጌር የኢንም በግብታሑ” ባረም የእዝጌር ይሰግድ።<verse eid="1CO 14:25" /></para>
  <para style="s1">ሥርዐት ያነን አምልኮ</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />አማኞች፤ በይሽ ምን ንበርነ? ብትስበሰቦᎄ ግዝየ እያታቲ መዝሙር ነነን፤ ትምርት ነነን፤ መገለጥ ነነን፤ በልሳን ወዘንግ ነነን፤ ወተርጉም ነነን። ዚ እንም የወገንባ የሕን። <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />በልሳን ይዝነግ ቢነብር፤ ዄት ወይ ሦስት ተራ በተራ የዘንጎ፤ እንጐዲ ኧሗም የተርጉም፤ <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />ይትረጉም ሰብ ቤነም በጀᎈሪ ግብት እንቁስ የበርም፤ የነብሰሑ የእዝጌርም የዘንግ። <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />ዄት ወይ ሦስት ነብይ የዘንጎ፤ ኧንጐዲ ኧሗም የዝነጉዪ በወትቀየ የመዝኖ። <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />በቾኖዪ ግብት አቲ ሰብ ቁና ቃር ቢጐለጥነ፤ በደረም የዝነጔዪ እንቁስ የበር። <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />እያታታሑ ትትመሮኸም እያታታሑ ትብርታቶኸም፤ እንማሑ ተራ በተራ ትምቢት ወዘንግ ትችሎ። <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />ነብዮች በመንፈስ ያቡዮዪ መልክት ተቁጣጠሮም ይዝነጎ፤ <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />እዝጌር የሰላም አምላክ አንኸንም የረብሻ አምላክ አንከነ። በቅዱሳን አብያተ ክርስቲያናት እንም ዛምኸሙ፤ <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />እንሽታ በጀᎈሪ እቁስ የበረማ፤ የእዝጌር ሕጊ ይቡንኸም ይታዘዞኸም አንከንም ይዝነጎኸም አንትፈቅደኖ፤ <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />እንሽታ የወሐር ይሸወማይ አታት ቃር ባነ፤ የምሰሕነማ በቤት የሳለማ፤ መሳሑም ምሽት በጀᎈሪ ግብት ብትዝነግ ያትማልል። <verse eid="1CO 14:35" /><verse number="36" style="v" sid="1CO 14:36" />የእዝጌር ቃል የወጣ ታሑቱ? የሰላሽ ታሑዬ ጠለለው? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />ሟንም ነብይንኩ ይብር መንፈሳዊ ስጦታ ነኔ ይብር ቢነብር፤ ዚ የጣፈክንኩ የጔታ ትዛዝ ወሕነሑ የሐር።<note caller="+" style="f"><char style="fr" closed="false">14፥37 </char><char style="ft" closed="false">አታት ቅጂዎች፣ </char><char style="fqa" closed="false">ዚ የወሐር ኤይሸ ቢኸን ሑቲም ኤይሗሪ</char><char style="ft" closed="false">ይብሮ። </char></note> <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />ዚ ኤይሒር ቢኸን ሑቲም ኤይሗሪ።<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />ስለኸነም አማኞች፤ ትምቢት የወዘንግ በርቶም ሳዎ፤ በልሳን ወዘንግም አትሕትሮ፤ <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />ቢኸንም እንም ዘንጋ በአግባበሑ በሥራትም የሕን።<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s1">የክርስቶስ ትንሣኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />ኧሗም፤ አማኞች! የሰበኩኑኩዪም የቌበርኩይ ኧሗም ጠናሑም የቆምኩᎄዪ ወንጌል አቴስብኩዬ ኧወድ፤ <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />የሰበኩዪ ቃል አጠበኩም ብትጠብጦይ፤ በዚ ወንጌል ትተርፎ፤ ባንከነም ያመንኩዪ ቤድገልል ቃሩ። <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />እያ የቌበርኩኒ ትንም ነን የኸነዪ<note caller="+" style="f"><char style="fr" closed="false">15፥3 </char><char style="ft" closed="false">ወይም፤ </char><char style="fqa" closed="false">ትንም ኢፍት</char></note> ያሑ አችላለፍኩም፤ ቅዱሳት መጻሕፍት ይብሮይኸም ክርስቶስ ስለአጥያተና ᎀተ፤ <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />ተቀበረ፤ በቅዱሳን መጽሐፍ የጣፈኸም በሦስታለኘዪ ከነ ተነሣ፤ <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />በዛም የኬፋ<note caller="+" style="f"><char style="fr" closed="false">15፥5 </char><char style="fqa" closed="false">ጴጥሮስ </char><char style="ft" closed="false">ወበሩ</char></note> ታዠ፤ ቄጠለም የዐሥረ ዄቲ ሐዋርያት ታዠ፤ <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />በዛም አንቌ ባምስት መቶ ነን ይኸኖ አማኞች ቁናጌ ታዠ፤ ተዚሕኖም ብዠሕኖ በሕይወት ነኖ አታቶቺ ᎀቶም። <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />በዛም የያዕቆብ ታዠ፤ ባንቌም የሐዋርያት እንም ታዠ። <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" />ትንም አንቌ ያለግዝየ የጨኘ ሰብዬኸም የኸንኲ ይያ ኧሗም ታዠ።<note caller="-" style="x"><char style="xo" closed="false">15፥8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">ሐዋ. 9፥3-6</ref>። </char></note> <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />እያ ተሐዋርያት እንም አንስ፤ ሐዋርያ ቧሪም ኧጠራ ቢኸን ኤይትጌቤኩ፤ መሳዪም የእዝጌር ሕዝብ የኸኖዪ አማኞች አሳደድኩም፤<note caller="-" style="x"><char style="xo" closed="false">15፥9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8፥3</ref>። </char></note> <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />ቢኸንም በእዝጌር ጸጋ ኧሗም የኸንኩኒ ኸንኩም፤ ይያም ያቡኝ ጸጋ ኤድገልል አንከነ፤ ዛምኸም ትንም ነን በወትጋደል ሸከትኩም፤ ቢኸንም እያ ታንኸን ቲያ ጌ ያነዪ የእዝጌር ጸጋው። <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />በይሽ እያም ኸንኩ ሕኖ ኧሰብክነዪ ዚኸሚው፤ አሑም ያመንኩይ ዚኸሚው።<verse eid="1CO 15:11" /></para>
  <para style="s1">የሟቾቺ ትንሣኤ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />ክርስቶስ በሞት የትነሳኸም ይሰብክ በኸነ፤ ታሑ አታቶቺ ምንኸም የሟቾቺ ትንሣኤ ኤነ ይብሮ? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />የሟቾቺ ትንሣኤ ቤነማ ክርስቶስም አንተሣ ወበሩ! <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />ክርስቶስ በሞት ባንተሳ ስብከተና ኤድገልልኸሙ፤ እምነታሑም ኤድገልል ይኸን። <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />በዚም ነን፤ እዝጌር የክርስቶስ በሞት አትኔሣንም ባርነም በወመስክረና፤ ባጢለተኞች የእዝጌር ምስክሮች ኸነም ተረከብነም፤ ሟቾቺም ኤትነሶ በኸነ፤ እዝጌር የክርስቶስ አናትነሳን ወበሩ። <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />መሳሑም ሙታን ባንተሶ፤ ክርስቶስም አንተሣ። <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />ክርስቶስ ባንተሳ እምነታሑ ኤድገልል ይኸን፤ አሑም ኧሗ ስን በአጢያታሑ ነንኩ ወበሩ። <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />እኪም በኸነ በክርስቶስ አመኖም የᎀቶዪ ጠፎም ወበሩ፤ <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />በክርስቶስ ተስፋ ኧሸክትነዪ የዚ ያፈር ኑሮ ጠለለ በኸነ በሰብ እንም የጠቀለ ገዋንነ፤<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />ቢኸንም ክርስቶስ የሟቾቺ እንም ስርም ተሟቾቺ ተነሳም። <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />መሳሑም ሞት በቁና ሰብ ኤማ የቸኘኸም፤ የᎀቶዪ ወተንሳ በቁና ሰብ ኤማ ኸነም። <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />ሰቦች እንም በአዳም ይᎀቶኸም፤ ዛምኸም ሰቦች እንም በክርስቶስ ሕያዋን ይኸኖ። <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />ቢኸንም እያታቲ በነብሰሑ ተራ ይኸን፤ መጀመሪያ በሕር የኸነዪ ክርስቶስ ተነሣም፤ በዛም አንቌ ሑቲ ቲቸኝ የክርስቶስ የኸኖዪ ይትነሦ፤ <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />በዛም ግዛት፤ እንም በድመሰሰ አንቌ መንግሥት የእዝጌር አብ ቲያትሬክብ፤ ዛ ግዝየ የዓለም ፍጣሜ ይኸን። <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />መሳሑም መሶውታን እንም በግረሑ ተት ሸኰተነም ንጉሥ ይኸኔ ይጌቧን።<note caller="-" style="x"><char style="xo" closed="false">15፥25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>። </char></note> <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />መጨረሻ ይድᎀስሺ መሶ ሞቱ፤ <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />“እንም ቃር በግረሑ ተት አትጔዛነም” ቧሪም፤ ቢኸንም፤ እንም ቃር አትጔዛነ ቲብር፤ እንም ቃር በክርስቶስ ተት ይገዛኸም የሸኰተኒ እዝጌር ኤደብርኸም ይትኴር።<note caller="-" style="x"><char style="xo" closed="false">15፥27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">መዝ. 8፥6</ref>። </char></note> <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />እንም በትጐዛነ አንቌ እዝጌር እንም ብንም ይኸንኸም ወልድ ነብሰሑ ኧሗም እንም ያትጔዛነ የሑቲ ይትገዛ።<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />ትንሣኤ ቤነማ የᎀቶ ሰቦች ባሮም ይጠመቆዪ ምን ይሸክቶው? ሟቾች ስርም ኤትነሶ በኸነ፤ ሰቦች የሕኖ ባሮም የመአር ይጠመቆ? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />ኢናሽ ብንኸነ እንጌ የአደጋ ኧትጋለጥነዪ የመአሩ? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />አማኞች! እያ ከነ በከነሑ የሞት አደጋ ይሰላቢው፤ ዚምም በጐታና በክርስቶስ ኢየሱስ ባሑ ᎈር ባኔ ወትነነድ አርጋግጥ። <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />በኤፌሶን ተድብር አውሬጌ የጋደልኩ የሰብ አስተያየት ጠለለ በኸነ ትርፈኛ መአሩ? ሟቾቺ ኤትነሶ በኸነ፤ “ነገ ኧᎀትነ ስለኸነ፤ ንብራነ፤ ንስጤነ፤” ይብሮኸም ወሕነናው።<note caller="-" style="x"><char style="xo" closed="false">15፥32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">ኢሳ. 22፥13</ref>። </char></note><verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />አትሳቶ፤ “ውዶ መራርቻ ፈያዪ አመል ያትብላሽ።” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />ሰከን ተባረዪ ልባሑ ተዘበሮ፤ አጢያት አትሰክቶ፤ ባሑ ግብት አታቶቺ የእዝጌር ኤይሒሮ ነኖ። ዚም ኧቡኒ ይማልልኩኸም ባሑሙ።<verse eid="1CO 15:34" /></para>
  <para style="s1">የትሣኤ ጅስም</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />ቢኸንም፤ “ሟቾቺ ምንኸም ይትነሦ? ይቸኖዪሽ በመአርኸማት ጅስሙ?” ይብር ሰብ ይነብሬ ይችል። <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />አኸ ገዋ! ትዘራኒ ኧሕር ባንᎀተ ሕይወት ኤነቡር። <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />ትዘራኒም የስሬም የንጐድኸማት ዘር ጢንጦ ጠለለ አንከንም ቲፍቴዬ ትረሕᎅ ጅስም አንከነ። <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />እዝጌርም የፈቀደ ጅስምኸም ይቡ፤ የያታቲ የዘር የትልያየ ጅስም ይቡ።<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />በሠር እንም ቁና አንከነ፤ የሰብ በሠርም ቁናው፤ የእንሰሳ በሠር እንጐዱ፤ ያንፉ በሠር፤ የዓሣ በሠር እንጐድኸማቱ።<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />ዛምኸም የሰሜ ጅስም ነነ፤ አፈራዊ ጅስም ነነ፤ ቢኸንም የሰሜያዊ ጅስም ክብር ቁናኸማቱ፤ የአፈሪም ጅስም ክብር እንጐድ ኸማቱ። <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />የጬት ክብር ቁና ኸማቱ፤ የጠናቃ ክብር እንጐድ ኸማቱ፤ የኰኰብም ክብር ኧሗም እንጐድ ኸማቱ፤ የአቲ ኰኰብ ክብር ትንጐዲ ኰኰብ ክብር የትለኘው።<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />የሟቾቺ ትንሣኤ እኪቱ፤ ይብሰብስ ጅስም ይዘራ፤ ኤይብሰብስ ጅስም ኸነም ይትነሣ፤ <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />በወትዋረድ ይዘሬ፤ በክብር ይትነሣ፤ በወቂጥ ይዘሬ በቆት ይትነሣ፤ <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />ይትኸለቅ ጅስም ይዘሬ መንፈሳዊ ጅስም ይትነሣ። ይትኸለቅ ጅስም ባነ መንፈሳዊ ጅስም ኧሗም ነነ። <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />ስለኸነ፤ “የመጀመሪያዪ ሰብ አዳም ሕያው የትኸለቀ ኸነ” ቧሪም ጣፊም፤ ያንቌዪ አዳም ክርስቶስም ሕይወት ይብ መንፈስ ኸነ<note caller="-" style="x"><char style="xo" closed="false">15፥45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ዘፍ. 2፥7</ref>። </char></note> <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />ቢኸንም መጀመሪያ የቸኘዪ መንፈሳዊ ቴይኸን ኸልቀተኛዪው፤ በዛም አንቌ መንፈሳዊ ቸኘ። <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />የመጀመሪያዪ ሰብ አዳም የትኸለቀ ተአፈር ስለኸነ የትረከበ አፈራዊሙ፤ ዄታለኘዪ ሰብ የቸኘ በሰሜው። <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />ተአፈር የኸኖዪ ያፈርኸምኖ፤ ተሰሜ የኸኖዪ ሰማያዊኖ። <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />የአፈራዊዪ ሰብ መልክ ኧመስርነኸም የሰሜያዊያንም ሰብ መልክ ኧመስርነ።<note caller="+" style="f"><char style="fr" closed="false">15፥49 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ንልበስነ </char><char style="ft" closed="false">ይብሮ። </char></note><verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />አማኞቺ! ዚ ይውድሑ፤ በሠር ደምም የእዝጌር መንግሥት ኤወርሶ፤ ይጠፋዪም ኤይጠፋዪ ኤይወርስ።<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />ዘ፥ አት ምሥጢር ኢውድሑ፤ እንመናም አንᎀትነ፤ ቢኸንም እንመናም ኧሸገርነ። <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />ዚ ይኸኒ የመጨረሻዪ ጥሩምባ ቲነᎊ ድንገት ሒንጌ ዔኑ። ጥሩምባ ይነፌ፤ ሟቾቺ ኤይብሰብሶ ኸኖም ይትነሦ፤ ኢናም ኧሸገርነ።<note caller="-" style="x"><char style="xo" closed="false">15፥51-52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 ተሰ. 4፥15-17</ref>። </char></note> <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />ይጠፋዪ ኤይጠፋዪ፤ ይᎀቲ ኤይᎀቲ ይለብሴ ይትጌቧን። <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />ይጠፋዪ ኤይጠፋዪ፤ ይᎀቲ ኤይᎀቲ ቢለብስወ ግዝየ “ሞት በውራግ ተዋጠም!” ቧሪም የጣፈዪ ቃል ይትፌጠም<note caller="-" style="x"><char style="xo" closed="false">15፥54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">ኢሳ. 25፥8</ref>። </char></note> <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />ዛምኸም፥</para>
  <para style="q1" vid="1CO 15:55">“ሞት! ውራግ ወስላኸ ቤቴው?</para>
  <para style="q2" vid="1CO 15:55">ሞት! የሰብ ትጎዳወ ቆታኸ ቤቴው?” ቧሪም።<verse eid="1CO 15:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="1CO 15:56" />የሞት ይነድፍወ አጢያቱ፤ የአጢያት ቆት ሕጊ። <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />ቢኸንም በጔታና በኢየሱስ ክርስቶስ አዘር ውራግ ይብነዪ የእዝጌር ምስጋና የሕን።<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />ስለኸነ የትወደድኩ አማኞቸኛ! ጥኖም ቁሞ፤ ባትም ቃር አትትናወጦ።፤ የጔታ ሜና የወሠክት እንጌ ትትጋደሎ ሕኖ፤ መሳሑም የጔታ ትቄጦዪ እክም ያንከነኸም ቲሒሮ።<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s1">የቅዱሳን የሸከተ የዋጋ መዋጮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />ኧሗ በድጋሚ የቅዱሳን ይሸክት ስለኸነ ዋጋ ዋስባስብ፤ የገላትያ ብንም የነበሮ አማኞች አብያተ ክርስቲያናት ባቦይ ትዛዝ መሠረት ሰክቶ።<note caller="-" style="x"><char style="xo" closed="false">16፥1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">ሮም 15፥25-26</ref>። </char></note> <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />እያ ብንቸኝወ ግዝየ የዋጋ ዋትዋጣ ኤሸኩቺኸም በሳምት ሳምቲ ውርሰምበት ታሑ እያታቲ ቢረሕᎅ ገቢ ቅጫ ቲያዋጣ ላኘም ያውና። <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />ብንቸኝወ ግዝየ አሑ የሜጠረኩዮ ሰቦች የመሸኛ ደብዳቤ አብኩም ስጦታሑ ኢየሩሳሌም ያሰሎኸም ኧለኮ። <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />ይያም ወወር ያሸ ኸነም በትረከበ፤ ቲያጌ ያሮ።<verse eid="1CO 16:4" /></para>
  <para style="s1">የጳውሎስ ዕቅድ</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />በመቄዶንያ አዘር ወልፈኛ ኤይቀይ ስለኸነ፤ መቄዶንያ በሰላሑ አንቌ ታሑዬ ኧቸኝ።<note caller="-" style="x"><char style="xo" closed="false">16፥5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">ሐዋ. 19፥21</ref>። </char></note> <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />ትናርወዬ ተሟንመሑም መደሬ በጋዠኛ ትረዶኝኸም፤ ባሑዬ ኤክስ ይኸን፤ ምናልባትም በርጊም ታሑጌ ኧስነብት ይኸን። <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />ኧሗ በዛ ኤማ ትንቸለፍ ኧጉበኙሑዬ አንሸ፤ ጔታ ቢፈኧድ ገለፍ በባረ ግዝየ ታሑጌ የዋክስ ተስፋ ኧሸክት።<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />ቢኸንም በዓለ አምሳ ከነ ስን በዓል በኤፌሶን ኤክስ።<note caller="-" style="x"><char style="xo" closed="false">16፥8 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">ዘሌ. 23፥15-21</ref>፤ <ref loc="DEU 16:9-11">ዘዳ. 16፥9-11</ref>። </char></note> <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />መሳሑም ወደል የሜና በር ተከፈተኒም፤ ብዠ ኧሸኩች ሜና ነነቢ። ይያ ይቃወሞኚም ብዠ ነነቢ።<note caller="-" style="x"><char style="xo" closed="false">16፥8-9 </char><char style="xt" closed="false"><ref loc="ACT 19:8-10">ሐዋ. 19፥8-10</ref>። </char></note><verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />ጢሞቴዎስ ታሑዬ በቸኘ፤ ታሑጌ ያለጊናት ይቾናኸም ሰክቶ፤ መሳሑም ሑቲ ይያኸም የጔታ ሜና ይሸከቱ።<note caller="-" style="x"><char style="xo" closed="false">16፥10 </char><char style="xt" closed="false"><ref loc="1CO 4:17">1 ቆሮ. 4፥17</ref>። </char></note> <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />ስለኸነ ሟንም ኤጐርጭኸም፤ በሰላም ቲያዬ ይዠበርኸም ርዶይ፤ ወዘበረሑ ተአማኞችጌ ኧቂየነው።<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />አማኝ የኸነዪ አጵሎስ ኧሗም፤ ተአማኞችጌ ተአሑዬ ይቸኝኸም አጠበኩም ጮቀስኩንም ባነ፤ ሑቲም ኧሗ የወተኝ አንሸ፤ ቲትᎂችንም ይቸኝ።<verse eid="1CO 16:12" /></para>
  <para style="s1">ይስናᎄችᎄ ንግግር ሰላምታም</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />ተጋደሎ፤ በእምነት ጥኖ፤ በርቶ፤ ቆምሮ፤ <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />ትሸክቶዪ እንም በፍቅር ሰክቶ።<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />የእስጢፋኖስ አበሮስ በአካይያ የመጀመሪያዎቺ አማኞች የኸኖኸም ቅዱሳንም የዋገልግል ነብሰሕኖ ያቦኸም ቲሒሮ። አማኞች፤ ዚ ኧጮቅስኩ፤ <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />የሕኖኸም ያኖዪ ተሕኖምጌ በአገልግሎት ይቌጦ እንም ታዘዞ።<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />በእስጢፋኖስ በፈርዶናጥስም በአካይቆስም ቲያዬ በወተኘሕኖ ተብላለቅኩም፤ መሳሑም አሑ በዚዬ ባለወንብራሑ የቀበሌዪ አሟሎኒም። <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />መሳሑም ይያም ያሑም መንፈስ አቴረፎም። ስለኸነም የዚሕኖኸም ያኖዪ ሰቦች ያከቡርዮዬ ይትጌባኖ።<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />በእስያ ያኖዪ አማኞች በአብያተ ክርስቲያን ሰላምታ ያቀርቦንኩ፤ አቂላ፥ ጵርስቅላም<note caller="+" style="f"><char style="fr" closed="false">16፥19 </char><char style="ft" closed="false">በግሪኪ </char><char style="fqa" closed="false">ጵርስቃ</char><char style="ft" closed="false">፣ </char><char style="fqa" closed="false">የጵርስቅላ </char><char style="ft" closed="false">እንጐዲ አጠራሩ። </char></note>፣ በቤተሕኖ ያነዪ ቤተ ክርስቲያን የከበረ ሰላምታ በጔታ ያቀርቦንኩ።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሐዋ. 18፥2</ref>። </char></note> <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />አማኞች እንም ሰላምታ ያቀርቦንኩ ነብስ በነብሳሑ የጎቤ የተምኸም በወሰሰም ሰላም ተበበሮ።<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />ዚ ሰላምታ በፎለኛ ኧጀ የጣፈክንኩ እያ ጳውሎስንኩ።<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />የጔታ ኤይወድ ቢነብር የሰደበ የሕን! ጔታና፥ ኔኸ!<note caller="+" style="f"><char style="fr" closed="false">16፥22 </char><char style="fqa" closed="false">ጔታና ኔኸ፦ </char><char style="ft" closed="false">በግሪኪ “ማራ ናታ” ይብር። </char></note> <verse eid="1CO 16:22" /><verse number="23" style="v" sid="1CO 16:23" />የጔታ ኢየሱስ ጸጋ ታሑጌ የሕን።<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />እንጌ ቤትቋረጥ በኢየሱስ ክርስቶስ ፍቅር ኧወድሑ፤ የኢየሱስ ፍቅር ታሑጌ የሕን፤ አሜን።<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>