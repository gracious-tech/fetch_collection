<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">Mesqan New Testament</book>
  <para style="h">ተቆላስይስ ሰቦቼ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተቆላስይስ ሰቦቼ</para>
  <para style="toc2">ተቆላስይስ ሰቦቼ</para>
  <para style="toc3">ቆላ.</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተቆላስይስ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ዚ መልክት የጣፈዪ ብንሲዋኘዪ እስያ በኤፌሶን በምሥራቅ አዘር ቢትረከቢ በቆላስይስ ከተማ ታነዪ ቤተ ክርስቲያኑ፤ ዚ ቤተ ክርስቲያን የቈቈመዪ በጳውሎስ ቤኸንም የሮም ግዛት የኸነዪ የእስያ ዋና ከተማ በኸነዪ በኤፌሶን የወንጌል መልክተኞች ይለሕ ስለኸነ የቆላስይስም አላፊነት ቧነን፤ በቆላስይስ ቤተ ክርስቲያን “የእዝጌር የወሐርም የትሟላ ወትርፍ የወርክብ እያታቲ ሰብ የመንፈሳዊ ቆት ሥልጣንም ወስግድ ነነወ” ይብሮ ባጢለተኘ አስተማሪዎች ወንብረሕኖ ጳውሎስ ሰማም ባነ፤ ነዚ አስተማሪዎች ይብሮዪ እንጐዲ ቃር “እያታቲ ሰብ ጤበን ያወኔኸም ያኖዪ ሥራቶች ወገዛም የስንቅም የንጐዲም ሥራቶች ወቀየ ነነወ” ይብር ባነ።</para>
  <para style="ip">ጳውሎስ ዚ መልክት የጣᎈን የኢኒ የክርስትና መልክት በዋቅርብ የሕኖ ባጢለተኘ ትምርት የወቃወም ባነ፤ ታቀረበኖዪም መልስ ዋናዪ “ኢየሱስ ክርስቶስ የትሟላ ወትርፍ ይብ፤ ነዚ እንጐዲ እምነት ሜናዎችም ተሑቲ ያሰኮ” ይብሪው፤ እዝጌር በክርስቶስ ዓለም ኸለቀ፤ በሑቲም ኤማ ተሑቲዬ ዠበረም ያቸኝን፤ ዓለም የወትርፍ ተስፋ ይነቡር ክርስቶስ ተሒን በወምን ጠለለው፤ በዚምኸማት ጳውሎስ ዚ ወደል ትምርት በአማኞች ሕይወት ምንኸም ይትረጉሜ ይችልኸም ያትሬዳ።</para>
  <para style="ip">ዚ መልክት ተጳውሎስ ተቌበረም ተቆላስይስ ያሰላዬ ተትላኸዪ ተቲኪቆስጌ ቁናዬ የነበረዪ አናሲሞስ የኸነኸም ወትመልከት ጠቃሚው፤ ጳውሎስ ስለኸነም ኦኔሲሞስ የቧሪዪ ጉዝ ነሣም የፊልሞና ኧንጐድ መልክት ጣፈም።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="COL 1:1-8">1፥1-8</ref> </char></para>
  <para style="io1">የክርስቶስ ዓመል ሜናም <char style="ior"><ref loc="COL 1:9-2:19">1፥9—2፥19</ref> </char></para>
  <para style="io1">በክርስቶስ ገደር ሕይወት <char style="ior"><ref loc="COL 2:20-4:6">2፥20—4፥6</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="COL 4:7-18">4፥7-18</ref> </char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />በእዝጌር ፈአድ የኢየሱስ ክርስቶስ ሐዋርያ ተኸነዪ ተጳውሎስ ተጐቤና ተጢሞቴዎስ፥<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />በቆላስይስ ይነብሮዪ፤ በክርስቶስ የኸኖ ቅዱሳንም ታማኝ<note caller="+" style="f"><char style="fr" closed="false">1፥2 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ያምኖዪ</char></note> ጐባቢት ትእዝጌር ተአባና<note caller="+" style="f"><char style="fr" closed="false">1፥2 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">በአባና በጔታ በኢየሱስ ክርስቶስም</char></note> ጸጋ ሰላምም ያሑ የሕን።<verse eid="COL 1:2" /></para>
  <para style="s1">የጳውሎስ ምስጋና የቆላስይስ ሰቦች</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />ያሑ ብንጤልይነᎄ ግዝየ የጔታና የኢየሱስ ክርስቶስ አባ የእዝጌር እንጌ ናምሰግነ። <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />በኢየሱስ ክርስቶስ ያነናሑ እምነት ስለምእመናንም እንም ያነናሑ ፍቅር ሰማነም። <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />ዚም የኸነ በሰሜ ተዝጋጀም ባወነንኩ ተስፋ የትነሣው፤ ስለኸነም ተስፋ በወንጌል የኢን ቃል በደርኩም ሰማሑም፤ <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />ዚ ወንጌል ታሑዬ ሰላም። ዚም ወንጌል በሰማሑᎄ የእዝጌርም ጸጋ የኢንም በትሬዳሑᎄ ከነ ቀረሰም በዓለም ዙሪያ ቲሸክት ያነ እንም ባሑዬ ፍርየ ቲያወርድ ይለቅምኸሙ። <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" />ዚም ቢና<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="fqa" closed="false">ቢና፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ “ባሑ” ይብሮ። </char></note> ሟኔ የክርስቶስ ታማኝ አገልጋይ የኸነዪም ቲናጌ ቁናዬ ይሸክቲ የትወደደዪ ኤጳፍራ ኤወደናሑም።<note caller="-" style="x"><char style="xo" closed="false">1፥7 </char><char style="xt" closed="false"><ref loc="COL 4:12">ቆላ. 4፥12</ref>፤ <ref loc="PHM 1:23">ፊል. 23</ref>። </char></note> <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ዛምኸም ሑቲ በእዝጌር መንፈስ አት ባታሑ ወትዋደዳሑ ኤወደነም።<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />ስለኸነም ዚ በሰማነᎄ ከነ ቀረሰም አሑ በመንፈሳዊ ብላት ዋጥራምትም እንም የእዝጌር ፈአድ ትትሬዶᎄ የᎀላ ውቀት ይነብሩሑኸም ያሑ ተወጠልይም የእዝጌር ተወጮቅስ አንገፈርነ። <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ዛምኸም የጔታ ተገቢ በኸነ ኤማ በወንብር የሑቲ በፍጡም ታትብላልቆይኸም ዚም በፈያ ሜና እንም ፍርየ ታወርዶኸም የእዝጌር በወሐር ትትለቆ ታሮኸም ኧጤልይነ። <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />ጔታ በንቅ ቆተሑ ብርታተሑ እንም ይብኩ፤ በትዕግሥትም እንም ቃር የወቻል በብልቃት የዝጋጀሑ የወሕን ያብቃሑ፤ <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />ኧሗም በብራን መንግሥት ውስጥ ተቅዱሳንጌ ርስት ትሰዶዬ ያሰላናሑ እዝጌር የአብ በብልቃት አመስግኖይ። <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />ሑቲ ተጨለማ ቆት አተረፈም ተትወደደዪ ትኸኹ መንግሥት ኧገባነኸም ሸከተነም። <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />በሑቲም በደመሑ<note caller="+" style="f"><char style="fr" closed="false">1፥14 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">በደመሑ</char><char style="ft" closed="false">ይቡኒ ቃል ኤነኖ</char></note> ተዋጀነም፤ ዚም የአጢአተና አፉታ ረከብነም።<note caller="-" style="x"><char style="xo" closed="false">1፥14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">ኤፌ. 1፥7</ref>። </char></note><verse eid="COL 1:14" /></para>
  <para style="s1">ክርስቶስ ትንም ነኑ</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />ክርስቶስ ኤታዢ እዝጌር የሐቅ ምሳሌው። ሑቲ ተኸልቀት እንም ነን ንቅ በሕሩ። <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />በሰሜ ባፈርም ያኖዪ፥ ይታዞዪ ኤታዞዪም፥ የሰሜ ሓይሎች ገዢዎች አለኦችም ባለሥልጣኖች እንም የትኸለቆ በሑቲቱ። እዝጌር እንም ቃር የኸለቀ በሑቲም የሑቲቱ። <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ሑቲ ትንም ኢፍቴ ባነ፤ እንም ቃር ተጥባበጠም የቈመ በሑቲቱ። <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />ሑቲ ጅስመሑ የኸነዪ የቤተ ክርስቲያን ጉነኑ፤ ብንምቃር የበደረ ይኸንኸም፤ ተሞት በወተንሣም ይፍቴዪ መጀመሪያው።<note caller="-" style="x"><char style="xo" closed="false">1፥18 </char><char style="xt" closed="false"><ref loc="EPH 1:22-23">ኤፌ. 1፥22-23</ref>። </char></note> <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />ዚም የኸነ የመለኮት ወሙላ በትኸኹ ይነብርኸም የእዝጌር አብ ፈአድ ስለኸነው። <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />በመስቀሊ ᎈር በፈሰሰዪ በትኸኹ ደምም ሰላም በወሰክት በአፈርም ኸነ በሰሜም ያነዪ ቃር እንም በሑቲ ኤማ ተነብሰሑጌ አታረቀ፤<note caller="-" style="x"><char style="xo" closed="false">1፥20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">ኤፌ. 2፥16</ref>። </char></note><verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />ድረ ተእዝጌር ራቅኩም ትነብሮ ባነ፤ በአሳባሑም ተቡሼ ሜናሑም መሳ መሶውታን ባነሑ። <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />ኧሗም ቅዱሳንም ንጡሐን፤ ናጫ ዬነብኩ ሸከተም ቢፍተሑ ያቀርብሑዬ፤ ትኸኹ በገገሑ በወሙተሑ መሳ እዝጌር ተነብሰሑጌ አታረቀናሑ። <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />ዚም ይኸን ተምሠረትኩም ተድላደልኩም በወንጌሊ በትረከበዪ ተስፋ ታትትሬበሾ በእምነት ቆመርኩም ትትነብሮ ጠለለው፤ ዚም ወንጌል አሑ የሰማሑዪም በዓለም ᎈር ያኖዪ ሰብ እንም የሰበከው፤ እያ ጳውሎስም አገልጋይ የኸንኩ የዚ ወንጌሉ።<verse eid="COL 1:23" /></para>
  <para style="s1">የሐዋርያዪ የጳውሎስ አገልግሎት</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />ኧሗ ስላሑ ብንቌᎄር መከራ ኧትብላለቅ፤ ጅስመሑ ስለኸነዪ ስለቤተ ክርስቲያንም ተክርስቶስ መከራ ተወሳድ የቀበለቢ በገገኛ አትሟላን። <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />የእዝጌር ቃል ያሑ በሙላ ኧጐልጬ ተእዝጌር ባቡኝ አላፊነት መሠረት የቤተ ክርስቲያን አገልጋይ ኸንኩም። <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />ዚም የእዝጌር ቃል በመጀመሪያዪ ዘበን ተሰብ ዴንጋ ተሼተረም ዬከሰዪም ኧሗም እዝጌር ያመኖዪ እንም የጐለጠን ምስጢሩ። <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />እዝጌርም የቅዱሳነሑ ይገልጥኖዬ የᎈቈደን ያነዪ የዚ ምሥጢር የክብር ደንገኝነት ባሑ በአሕዛብ ግብት ምን ቅጫ ወደል ወሕነውታው። ዚም ምሥጢር በተስፋ ኧቂየኔይ ክብር ይትረከብወ ክርስቶስ ባሑ ግብት ወሕነውታኑ። <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />እያታቲ ሰብ በክርስቶስ የበቃ ሰብ ይኸንኸም ሸከትነም የዋቅርብ የሰብ እንም ብላት በዋትመርም በወምክር ስለክርስቶስ ኧሰብክነ። <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />እዝጌር በወደል ቆተሑ ቢያ ውስጥ ይሸክት ስለኸነ በዚ ቆት መሳ ዚ ዓላማ ይትፌጠምኸም ኧቆምርም ኧትጋደልም ኧቌጥ።<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />ስላሑም በሎዶቅያ ስላኖዪ ሰብ ዛምኸም ኢፍተኛ አዞም ኤይሒሮ ሰቦች እንም ምን ቅጫ የብረታ ግጅላ ኧሸክትኸም ቲሒሮዬ ኧወድ። <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />ታጉለጉልሚ ሒነሕኖ ተጥናናም በፍቅር ታገዶም፤ ስርም ዋጥራምት እንም በዋትርፍ የእዝጌር ምሥጢር የኸነዪ ክርስቶስ ይሒሮኸሙ። <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />የብላት የውቀትም ዱኒያ ተሼተረም ይትረከቢ በክርስቶሴው።<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />ዚም ኧብርሑ ሟንም በዋብላልጥ ቃል ኔያብላልጥኩ ባሑሙ፤ <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />በገገኛ ታሑ ብንረቅም በመንፈስ ታሑጔንኩ፤ በፈያ ሥራት ወንብራሑም በክርስቶስ ᎈር ያነናሑ የቆመረ እምነት በወዥም ኧትብላለቅ።<verse eid="COL 2:5" /></para>
  <para style="s1">በክርስቶስ ይትረከብ የትሟላ ሕይወት</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />ጔታ ኢየሱስ ክርስቶስ የቌበርኩይኸም በሑቲ ንበሮ፤ <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />በሑቲ ተምሠረትኩም ታነጥኩም በትማርኩይ ኸማት፤ በእምነታሑ ቆምሮም ንበሮ፤ ᎀላም ይተርፍ ምስጋና አቅርቦ።<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />በክርስቶስ ᎈር የትምሠረተ ቴይኸን በሰብ በሸከተ ሥራት በዓለማዊዪ ተራ ሥራት ᎈር በምሠረተ በፍልስፍና ቤድገልልም ዋብላልጥ ሟንም አብላለጠም ኔወስድሑ ተቀሮ። <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />የአምላክነት ፍጡም ወሙላ በጅስም ተገለጠም ይነብሪ በክርስቶሱ። <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />አሑም ሙላ ሕይወት የረከብኩይ በኸልቀተሑ እንም ᎈር የግዛት የሥልጣንም እንም ጉነን በኸነዪ በክርስቶሱ።<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />በሑቲም በወምናሑ ጤበን አወነኩም፤ ዚም ጤበን ያወነኩ አጢአተኛዪ የገግ ዓመል የዋጥፋ በክርስቶስ የሸከተው አንከንም በሰብ ኧጅ የሸከተ አንከነ። <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />በጠመቅኩ ግዝየ ተክርስቶስጌ ተቀበርኩም፤ ተሑቲምጌ ተሞት ተነሣሑም፤ በሞት የትነሣሑ የክርስቶስ ተሞት ባትኔሣን በእዝጌር ቆት በወምናሑው።<note caller="-" style="x"><char style="xo" closed="false">2፥12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">ሮም 6፥4</ref>። </char></note> <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" />አጢአት በወሠክታሑም የአጢአተኛዪ ገጋሑ በክርስቶስ በወምን ጤበን ባለወቶናሑ መሳ የᎀትኩ ባነሑ፤ ኧሗም እዝጌር ተክርስቶስጌ ሕያዋን ሸከተናሑም፤ አጢአታሑ እንም አፉ ባረናሑም።<note caller="-" style="x"><char style="xo" closed="false">2፥13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">ኤፌ. 2፥1-5</ref>። </char></note> <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />ሑቲ ዛ ይከስነዪ ይቃወመነም የነበረዪ በሙሴ ሕጊ ያነዪ የዕዳ ጡሑፍ ድᎀሰሰን፤ በመስቀል ᎈር ችነከረም ቲና አጠፏን። <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />ቆት ያነኖዪም ባለሥልጣኖቺ በመስቀሊ<note caller="+" style="f"><char style="fr" closed="false">2፥15 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በሑቲ</char></note> ውራግ ሰላም ትጥቀሕኖ ባትፌታ አንቌ ምርኮኛ ኸኖም ቢልቢጢጦ ይታዞኸም ሸከተኖ።<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />ኧጌሽ ብትበሮዪም ኸነ ብትሰጦዪ፥ በዓልም፤ የመሬት መባቻ፥ የሰምበት ወይ በዋክብር መሳ ሟንም ኤፍርድብኩ።<note caller="-" style="x"><char style="xo" closed="false">2፥16 </char><char style="xt" closed="false"><ref loc="ROM 14:1-6">ሮም 14፥1-6</ref>። </char></note> <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />ነዚ እንም ቲፍቴዬ ይቸኖ የነበሮዪ ቃር የጥሌልኸምኖ፤ ሐቅ ይትረከብ በክርስቶሱ። <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />ቤድገልል ቁና ቀልብነት የመላይካም በዋምልክ ይትነነድ ሟንም ሰብ ፍርየ ኤባን ዋጋ ኤያቀይንኩኸም ተቀሮ፤ ዚኸማቲ ሰብ ያዥን ስለኸነዪ መና ቲትነነድም ቤድገልልም ገግ በኸነ አስተሳሰብ ይታበይ። <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />እኪ ያነ ሰብ ጉነን ተኸነዪ ተክርስቶስጌ አትም ሩሑቦት ኤነን፤ የጅስም በሙላ ቢግጣጠምወዪም በጅማት አጥባበጠም ይᎂግᎅ ጉነኑ። እዝጌር የጅስም ሙላ ወላቅ ይᎅም በዚምኸማቱ።<note caller="-" style="x"><char style="xo" closed="false">2፥19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">ኤፌ. 4፥16</ref>። </char></note><verse eid="COL 2:19" /></para>
  <para style="s1">ተሰሰተ ትምርት ተቀሮ</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />ተክርስቶስጌ ᎀትኩም ተዚ ዓለም መሠረታዊ ሥራቶች ፌጠምኩም የትላኘሑ በኸንኩ ኧጌ፥ ኧሗ ተዓለም ያንትላየኹኸማት ኸንኩም የመአር ስለኸነ ነዚኸም ያኖዪ ትዛዞች ትገዞ፤ <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />ትዛዞቺም “አትጥብጥ፥ አትቅምስ፥ አትልግድ” ይብሮዪኖ። <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />ነዚ እንም በሰብ በሸኰተን ትዛዝ ትምርትም ᎈር የትምሠረቶ ስለኸኖ ሜና ᎈር በዋሎ አንቌ የወጥፋ የትዌሰኖኖ። <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />ነዚ ትዛዞች በፎል ፈአድ በፌለቀ አምልኮም ቤድገልል ቁና ቀልብነት ገግም በዋማስን ᎈር ያተኩሮ ስለኸነ ብላት ያነኖ ይመስሮ ይኸን፤ ቢኸንም የገግ ስሜት በወቁጣጠር ኤማ ኤድገልሎ ቃርኖ።<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s1">በክርስቶስ ገደር ሕይወት</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />ኧጌሽ ተክርስቶስጌ ተሞት በትነሣሑ ክርስቶስ በእዝጌር ከነ ቾናም ባነወ በነኔ በሰሜ ያኖዪ ቃር ሳዎ።<note caller="-" style="x"><char style="xo" closed="false">3፥1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>። </char></note> <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />እንጌ በነኔ በሰሜ ስላኖዪ ቃር አስቦ አንከንም ባፈር ᎈር ስላኖዪ ቃር አታስቦ። <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />ᎀትኩም ስለኸነ፤ ሕይወታሑ ተክርስቶስጌ በእዝጌሬ ተሼተረም። <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ሕይወታሑ የኸነ<note caller="+" style="f"><char style="fr" closed="false">3፥4 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ይና ሕይወት</char></note> ክርስቶስ ቢትገለጥወ ግዝየ አሑም ተሑቲጌ በክብር ትትገለጦ።<verse eid="COL 3:4" /></para>
  <para style="s1">ጉርዚ ገደሪም ሕይወት</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />ስለኸነም ባሑ ይትረከቦዪ ያፈሪ ዱኒያ ሕይወት ኤላት እንም ቅጠሮ፤ ሕኖም “ዝሙት፥ ሩኩሰት ወሟግጥ ፍትወት፥ ቡሼ ኤላት፥ ጣዖት ዋምልክ የኸነ ወጎምዥ ኖ”። <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />በዚሕኖ ቃር መሳ ቤቴዘዞ<note caller="+" style="f"><char style="fr" closed="false">3፥6 </char><char style="fqa" closed="false">ቤቴዘዞዪ ᎈር</char><char style="ft" closed="false">ይቡኒ ሐረግ ባታት የድረ ቅጂዎች ᎈር ጠለለ ይትረከቢው</char></note> ሰቦች ᎈር የእዝጌር ማት ይቸኝ። <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />አሑም ነብሳሑ ተዚ ኢፍቴ ቤቴዘዞ ሰቦች ግብት ትናነሑ ነዚሕኖ ዘንጋ በወሰክት ትነብሮ ባነ።<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />ኧሗም ማት፤ ንዴት፤ ተንኰል፤ ሽም ዋጥፋ ታሑ አጥፎ፤ ያትማልል ንግግርም ታፋሑ ኤይውጣ። <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />ጉርዚ ዓመል ተሜናሑ አውልቆም ስላደኩይ ነብስ በነብሳሑ ባጢል አትዘንጎ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">ኤፌ. 4፥22</ref>። </char></note> <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />በፈጣሪዪ ይመስር በውቀት ቲታደሰ ያሪ ገደሪ ዓመል ልበሶ።<note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ዘፍ. 1፥26</ref>፤ <ref loc="EPH 4:24">ኤፌ. 4፥24</ref>። </char></note> <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />በዚ ዓለት በግሪካዊ አይሑድ፤ ጤበን ባወኔዪ ባናውኔዪም፤ በሥለጠነ አረመኔ ባንሠልጠነ አረመኔ፤ ነጣነት ቤነኒም ነጣነት ባነኒ ሰብ ግብት ልዩነት ኤነ፤ ክርስቶስ እንሙ፤ ብንሙ።<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />ኧጌሽ የእዝጌር የትሜጠሮ ቅዱሳንም፤ የትወደድኩ የኸንኩኸም ቅጫ ሩሕሩሕ፤ ሜናነት፤ ቁና ቀልብነት፤ ገርነት፤ ትዕግሥት ልበሶ።<note caller="-" style="x"><char style="xo" closed="false">3፥12-13 </char><char style="xt" closed="false"><ref loc="EPH 4:2">ኤፌ. 4፥2</ref>። </char></note> <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />ነብስ በነብሳሑ ተቸቸሎ፤ ተአሑ አቲ ብንጐዲ ᎈር ቅር የትበኘወዪ ቃር ቢነብር አፉ ተበበሮ፤ ክርስቶስ አፉ የባረናሑኸም አሑም አፉ በሮ።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">ኤፌ. 4፥32</ref>። </char></note> <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />ተዚ እንም ᎈር ይንም ቃር ስበሰበም በወግድ ስርም አትነት ይቢ ፍቅር ልበሶ። <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />የቁና ጅስም ክፍል ኸንኩም የኢንም የጠራሑ የዚ ሰላም ስለኸነ የክርስቶስ ሰላም በሒናሑ የንግሥ፤ ታምሰግኖም ሕኖ። <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />የክርስቶስ ቃል በሙላት በሒናሑ የንብር፤ በብላት እንም ነብስ በነብሳሑ ተማሮ፤ ተምካከሮ፤ በመዝሙር በውዳሴም፤ በመንፈሳዊ ዜማም የእዝጌር ተሒን ትታምሰግኖ ዘምሮ። <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />በኢየሱስ ኤማ የእዝጌር አብ ትታምሰግኖ በቃል ኸነ በሜናም ትሸክቶዪ እንም በጔታ በኢየሱስ ሽም ሰክቶይ፤ በሑቲም የእዝጌር አብ አመስግኖ።<note caller="-" style="x"><char style="xo" closed="false">3፥16-17 </char><char style="xt" closed="false"><ref loc="EPH 5:19-20">ኤፌ. 5፥19-20</ref>። </char></note><verse eid="COL 3:17" /></para>
  <para style="s1">የክርስቲያን አበሮስ ሥራት</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />ኧንሽታ! በጔታ ኤማ ይጌባ ስለኸነ የምሳሕማ ታዘዘማ።<note caller="-" style="x"><char style="xo" closed="false">3፥18 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፌ. 5፥22</ref>፤ <ref loc="1PE 3:1">1 ጴጥ. 3፥1</ref>። </char></note><verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />ገሜ! ምሽታሑ ውደዶ፤ ጨካኝ አትሕኖበማ።<note caller="-" style="x"><char style="xo" closed="false">3፥19 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፌ. 5፥25</ref>፤ <ref loc="1PE 3:7">1 ጴጥ. 3፥7</ref>። </char></note><verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />ዴንጋ! ዚ የጔታ የዋትብላልቅ ስለኸነ ብንምቃር የወላጆቻሑ ታዘዞ።<note caller="-" style="x"><char style="xo" closed="false">3፥20 </char><char style="xt" closed="false"><ref loc="EPH 6:1">ኤፌ. 6፥1</ref>። </char></note><verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />ወላጆች! ተስፋ ኤያርጦኸም የዴንጋሑ በማት አታብሳጦዮ።<note caller="-" style="x"><char style="xo" closed="false">3፥21 </char><char style="xt" closed="false"><ref loc="EPH 6:4">ኤፌ. 6፥4</ref>። </char></note><verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />በጉዙነት ሥራት ያነሑ! የጌቶቻሑ ብንምቃር ታዘዞ፤ ትትታዘዞም ሕኖ ያዞኩ ስለኸነ ቴይኸን ጔታ በወገናም በሒን ቅንነት የሕን።<note caller="-" style="x"><char style="xo" closed="false">3፥22-25 </char><char style="xt" closed="false"><ref loc="EPH 6:5-8">ኤፌ. 6፥5-8</ref>። </char></note> <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />ትሸክቶዪ እንም የሰብ ቴይኸን የጔታ ኢየሱስ ትሸክቶይኸማት ተሒናሑ ሰክቶይ። <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />የዚም ጔታ የሰሜ ርስት ዋጋ ሸከተም ይብኩኸም ቲሒሮ፤ ታግለግሎዪም ጔታ ክርስቶሱ፤ <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />በእዝጌሬ ዋዳላ ዬነ ስለኸነ ቡሼ ይሸክቲም የቡሼ ሜናሑ ቅጣተሑ ይቌበር።<note caller="-" style="x"><char style="xo" closed="false">3፥25 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዘዳ. 10፥17</ref>፤ <ref loc="EPH 6:9">ኤፌ. 6፥9</ref>። </char></note><verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />ጌቶች! አሑም በሰሜ ጔታ ያነናሑኸም ሐርኩም አገልጋያሑም በቂጦነት በቅንነትም አትዳድሮዮ።<note caller="-" style="x"><char style="xo" closed="false">4፥1 </char><char style="xt" closed="false"><ref loc="EPH 6:9">ኤፌ. 6፥9</ref>። </char></note><verse eid="COL 4:1" /></para>
  <para style="s1">የደበረ ምክር</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />የእዝጌር ብረታሑም በዋመስግን ታታቋርጦ ጠልዮ፤ <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />ተዚምጌ እዝጌር የቃለሑ በር ይከፍትንነኸም እያ በሑቲ መሳ አጐጅኝም ኧትረከብወ የክርስቶስ ምሥጢር ዋውድ ኧችልኸም ይናም ጠልዮ። <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />እያም ቃለሑ በግልጥ ኧዝነግኸም ጠልዮኒ።<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />በሟንመሑ አጋጣሚ ትትጠቀሞ ቤያምኖዪ ሰቦቼ በብላት ንበሮ።<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="EPH 5:16">ኤፌ. 5፥16</ref>። </char></note> <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />የያታቲ ሰብ ይጌቧኒ መልስ ዋብ ቲሒሮኸም እንጌ ንግግራሑ ይተም ኤያጠርስም የሕን።<verse eid="COL 4:6" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />ቲኪቆስ ስለእያ እንም ቃር ይውድሑ፤ ሑቲ የትወደደ ጐቤ ታማኝ አገልጋይም፤ በጔታ ሜናም የአገልግሎት ደቦኛው።<note caller="-" style="x"><char style="xo" closed="false">4፥7 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20፥4</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4፥12</ref>። </char></note> <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ሑቲ ታሑዬ የላክሑወ መሳ ስለኢና ሐለት ይውድሑዬም ሒናሑም ይጥናናዬው።<note caller="-" style="x"><char style="xo" closed="false">4፥7-8 </char><char style="xt" closed="false"><ref loc="EPH 6:21-22">ኤፌ. 6፥21-22</ref>። </char></note> <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />ተሑቲምጌ ያሑ ጐሳ የኸነዪ የታመነዪም የትወደደዪ ጐቤና ኦኔሲሞስ ታሑዬ ይቸኝ፤ ሕኖ በዚ መደር ስላነዪ ቃር እንም ይውዶኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">ፊል. 10-12</ref>። </char></note><verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />ቲያጌ ኧጉጀኘዪ አርስጥሮኮስም ሰላምታ ያቀርብንኩ፤ ቁናጌ፥ “ታሑዬ ቢቸኝወ ግዝየ ትቌበሮይኸም” ባሑም አቴሰበኩሑም የነበረዪ የበርናባስ ያንሳበሑ ትኸ ማርቆስም ሰላምታ ያቀርብንኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሐዋ. 19፥29</ref>፤ <ref loc="ACT 27:2">27፥2</ref>፤ <ref loc="PHM 1:24">ፊል. 24</ref>፤ <ref loc="ACT 12:12">ሐዋ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="ACT 15:37-39">ሐዋ. 15፥37-39</ref>። </char></note> <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ኢዮስጦስ ቧሪም ይጠሬዪ ኢያሱ ሰላምታ ያቀርብንኩ። ስለእዝጌር መንግሥት ቲያጌ ቁናዬ ቲሸክቶዪ ሰቦች ግብት የአይሑድ ጐሳ የኸኖዪ ነዚሕኖ ጠለለኖ፤ ይያም አብርታቶኝም።<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />የአሑ ጐሳ የኸነዪ የኢየሱስ ክርስቶስ አገልጋይ ኤጳፍራም ሰላምታ ያቀርብንኩ፤ በመንፈሳዊ ሕይወት ትለቆኸም ብረታሑም ትቌሞም የእዝጌርም ፈአድ እንም ትሸክቶኸም ሑቲ ስላሑ እንጌ ይጤልይ።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ. 1፥7</ref>፤ <ref loc="PHM 1:23">ፊል. 23</ref>። </char></note> <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />ስላሑ በሎዶቅያ በሒራፖሊስም ከተማ ስላኖዪም ሰቦች ስርም ይቌጥኸም እያ ነብሰኛ ኧምሰኩርነ። <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" />የትወደደዪ አኪም ሉቃስ ዴማስም ሰላምታ ያቀርቡኖኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥14 </char><char style="xt" closed="false"><ref loc="2TI 4:10-11">2 ጢሞ. 4፥10-11</ref>፤ <ref loc="PHM 1:24">ፊል. 24</ref>። </char></note> <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />በሎዶቅያ ያኖዪ ጐባቢት የንምፉና በቤቴታ ያነ<note caller="+" style="f"><char style="fr" closed="false">4፥15 </char><char style="fk" closed="false">የንምፉና በቤቴታ ያነ፦ </char><char style="ft" closed="false">አታት ቅጂዎች “የኒምፉስ በቤተሑም ያነ” ይብሮ። </char></note> ቤተ ክርስቲያንም ሰላምታ አቅርቦኒ። <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />ዚ መልክት ያሑ ባነበብኩይ አንቌ በሎዶቅያ ሰቦቼ ባነዪ ቤተ ክርስቲያን ይትነበብኸም ሰክቶ፤ አሑም በሎዶቅያ ይለኩንኩ መልክት አንብቦ። <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" />የአርኪጳስም “በጔታ አገልግሎት ያቡከዪ ሜና በወጠንቀቅ ትፌጥምኸም” በሮም አውዶኒ።<note caller="-" style="x"><char style="xo" closed="false">4፥17 </char><char style="xt" closed="false"><ref loc="COL 2">2</ref>። </char></note><verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />ዚ ሰላምታ በነብሰኛ ኧጅ የጣፍኩን እያ ጳውሎስንኩ፤ በሰንሰለት አጐጅኝም ያነሑኸም አስታውሶ።</para>
  <para style="p" vid="COL 4:18">የእዝጌር ጸጋ ታሑጌ የሕን።<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>