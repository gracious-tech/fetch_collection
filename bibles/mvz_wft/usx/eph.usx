<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">Mesqan New Testament</book>
  <para style="h">ተኤፌሶን ሰቦቼ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተ ኤፌሶን ሰቦቼ</para>
  <para style="toc2">ተ ኤፌሶን ሰቦቼ</para>
  <para style="toc3">ኤፌ.</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተኤፌሶን ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ጳውሎስ የኤፌሶን ሰቦቼ የጣᎈን መልክት ትንም ኢፍት ያጥራምቲ “የእዝጌር ዕቅድ ይኸን ኸም በሰሜ በአፈርም ያኖዪ ኸልቀቶች እንም ተጥቃለሎም በአቲ በክርስቶስ ሥልጣን ተት ይኸኖᎄ ግዝየ ቲሰላው” (1፥10) ቢብሪ አሳብ ᎈሩ። ቲደብሪም ተኢየሱስ ክርስቶስ ጌ በወትገገዝ የሰብ ዘር እንም ቁና ይኸኔ ዚ ወደል ዕቅድ በሜና ᎈር ያወሎይኸም የእዝጌርም ሕዝብ ያቴስቢው።</para>
  <para style="ip">የኤፌሶን መልክት በመጀመሪያዪ ክፍል ጠሐፊዪ ስለአትነት የቈረሰኒ ርዕስ በዋበትት፥ እዝጌር አብ የሕዝቢ ምንኸም የሜጠረንኸም፥ በትኸኹ በኢየሱስ ክርስቶስ የአጢአተሕኖ አፉታ ረከቦም ምንኸም ነጣ የኸኖኸም፥ የእዝጌርም ንኢ የተስፋ ቃል በመንፈስ ቅዱስ መሳ ምንኸም የርጋገጠኸም ያትሬዳ፤ በዄታለኘዪ ክፍል ኧሗም ጠሐፊዪ ያነቦዪ በደነብ ሕይወተሕኖ በክርስቶስ ያነኖ አትነት የኢነተኘ ይኸኔ ምንኸም ወንብር ይጌባኖኸም ያቴስቦ።</para>
  <para style="ip">ሰቦች በክርስቶስ ባነኖ አትነት ምንኸም አትነት ያነኖኸም በትልያዮ ፈሊጣዊ አዘነጔግ ተገለጠም፤ ቤተ ክርስቲያን የጅስም ኸም ቲኸን ክርስቶስ የጅስምያሑ ኸም ጉነኑ፤ ቤተ ክርስቲያን የሕንጣ ኸም ቲኸን ክርስቶስ የማእዘኒ እምኑ፤ ቤተ ክርስቲያን የምሽት ኸም ቲኸን ክርስቶስ የምስ ኸሙ፤ ጠሐፊዪ በክርስቶስ አዘር የትገለጠዪ የእዝጌር ጸጋ ስርም በዋድንቅ ቢዝነግወ ግዝየ ጥልቀት ያነን አገላለጥ ያቀርብ፤ ይንም ቃር ይትምሌከቲ በክርስቶስ ፍቅር፥ መሥዋዕትነት፥ አፉታ፥ ጸጋ ሰላምም መሳው።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="EPH 1:1-2">1፥1-2</ref></char></para>
  <para style="io1">ክርስቶስ ቤተ ክርስቲያንም <char style="ior"><ref loc="EPH 1:3-3:21">1፥3—3፥21</ref> </char></para>
  <para style="io1">በክርስቶስ ገደር ሕይወት <char style="ior"><ref loc="EPH 4:1-6:20">4፥1—6፥20</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="EPH 6:21-24">6፥21-24</ref> </char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />በእዝጌር ፈአድ የክርስቶስ ኢየሱስ ሐዋርያ ተኸነዪ ተጳውሎስ፤ የትላኸ መልክት በክርስቶስ ኢየሱስ፣ ያመኖ፣<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="fqa" closed="false">ያምኖዪ</char></note> በኤፌሶን<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">በኤፌሶን ይትረከቦ </char><char style="ft" closed="false">ይቡሪ ሐረግ ኤነኖ። </char></note> ይትረከቦዪ ቅዱሳን፤<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />ተእዝጌር ተአባና፣ ተጔታም ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<verse eid="EPH 1:2" /></para>
  <para style="s1">በክርስቶስ ይትረከብ መንፈሳዊ በረከት</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />በሰሜዪ ባነዪ መደር በመንፈሳዊ በረከት እንም በክርስቶስ የባረከነ የጔታናም የኢየሱስ ክርስቶስ አምላክ አባም የትባረከ፤ <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />ቅዱሳን ናጫ ዬነብነም ኸነም ቢፍተሑ ኧትረከብነኸም ዓለም ቴይትኸለቅ በክርስቶስ ሜጠረነ። <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />በኢየሱስ ክርስቶስ ዴንጋሑ ኧኸነኸም፣ የፈያ ፈአደሑኸም በደረም ዌሰነነ፤ <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />ዚም፣ ቢወጅጂ በሑቲ አዘር በነጣ ያቡነ ክቡር የኸነዪ ጸጋሑ ይትምሰገንኸም ሙ። <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />በሑቲም የእዝጌር ጸጋኸም ደንገኝነት ቅጫ፣ በክርስቶስ ደም ሟኔ፣ የአጢያት አፉታ ረከብነ፤ <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />ጸጋውታም በብላት በዋጥራምትም እንም አበዛንነ። <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />እዝጌር በክርስቶስ ይሸኩቼ ዬቈደኒም የፈአደሑ ምስጢር የፈያ አሳበሑ ኸም ኧሒርነኸም<note caller="+" style="f"><char style="fr" closed="false">1፥8-9 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ጸጋሑ አበዛንነ በብላት በአእምሮሕኖም፣ </char><char style="fv" closed="false">9</char><char style="fqa" closed="false">አትኴረነ</char></note> ሸከተነ። <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />በዘበን መጨረሻ ይኸኔ ያነዪ አሳበሑ በሰሜ በአፈርም ያኖዪ ቃር እንም ነብሰሑ ወውድድ በኸነዪ በክርስቶስ ተት የወጠቅልሉ።<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />እንም በፈአደሑ ምክር መሠረት ይሸኩችኸም የሑቲ ዕቅድኸም በደረም የትዌሰነ ኢና ኧሗም በሑቲ ተሜጠርነም፤<note caller="+" style="f"><char style="fr" closed="false">1፥11 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ወራሾች ኸነም</char></note> <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />ዚም በክርስቶስ ተስፋ በወሰክት የመጀመሪያ የኸነዪ ኢና የክብረሑ ምስጋና ኧኸነዬው። <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />አሑም ኧሗ የኢኒ ቃል ዚም ትተርፎᎄዪ ወንጌል በሰማሑ ግዝየ ተክርስቶሴ ተደበርኩም፤ በክርስቶስ አመንኩም፣ በሑቲ በወሕን ተስፋ ኸነም በቴበዪ በመንፈስ ቅዱስ ማተብ ታተምኩም። <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />የክብረሑ ምስጋና የወሕን የእዝጌር የኸኖዪ ሟኔ ከᎈሊም ነጣ ይኸኖ ስን፣ መንፈስ ቅዱስ የርስተና ዋስ ይኸን መያዣው።<verse eid="EPH 1:14" /></para>
  <para style="s1">የምስጋና የጩቀሸ ጠሎትም</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />ስለኸነም በጔታ ኢየሱስ ስላነናሑ እምነት፣ የቅዱሳን እንም ስላነናሑ ፍቅር በሰማሑ ግዝየ ቀረሰም፣ <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />በጠሎተኛ ትኔስብኩ ስላአሑ ምስጋና ዋቅርብ አናቋረጥኩ። <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />የክብር አባ የኸነዪ የጔታናም የኢየሱስ ክርስቶስ አምላክ የበዛ ቲሒሮይኸም፣ የብላት የመገለጥም መንፈስ ይብኩኸም ያለዋቋርጥ ኧጮቅስ። <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />ዛምኸም በሑቲ የጠራሑነ ተስፋ፣ ዚም በቅዱሳኔ ያነኒ ክቡር የኸነዪ የርስተሑ ደገኝነት ምን የኸነኸም ቲሒሮኸም የሒናሑ ዔን ይበሮኸም <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />ይና አምንነዪም ትንም ይበዛ ወደል የኸነዪ ቆተሑ ቲሒሮኸም ኧጤልይ። ዚም ቆት የሑቲኸም ወደል ብርታት ቲሒሮኸሙ፣ <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />የክርስቶስ ተሞት ቲያትኔሳን በሰሜዪ ባነዪ መደር በከነሑ ቲያወናን የታዠዪው። <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />የቾናዪም ተግዛት ተሥልጣንም፣ ተቆት ተጌትነትም ዛምኸም በሗዪ ዘበን ጠለለ ቴይኸን ቢቸኚም ዘበን ቢኸን ይሴየሜ ቲቸሊ ሽም እንም በነኑ። <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />እዝጌር እንም በእግረሑ ተት አትጔዛነ፤ በቤተ ክርስቲያንም፣ በሟንመሑ ቃር ᎈር ነብሰሑ ወውድድ ሸከተም ሾᎀን። <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />ቤተ ክርስቲያን ብንም ቃር ብንም ኤማ ይᎀላኒ፣ የክርስቶስ ሙላት የኸነ ጅስመሑ።<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">በክርስቶስ ሕያው ወኽን</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />አሑ በበደላሑ በአጢያታሑም መሳ የᎀትኩ ባነሑ፤ <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />በዚም፣ የዓለም ቡሼ ኤማ ተዄተልኩም፣ ባየር ᎈር ያኖዪ መንፈሳውያን ሓይላት ገዢ የኸነዪ ኧሗም የእዝጌር ቤይታዘዞዪ ሰቦች ᎈር ይሸክቲ መንፈስ በወታዘዝ ትነብሮ ባነ። <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />ኢና እንመና ተዚ ኢፍቴ በሕኖ ግብት የበሠረና ፈአድ የአእምሮና አሳብም ትንትዄተልነ በበሠረና ኤላት<note caller="+" style="f"><char style="fr" closed="false">2፥3 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የጉርዚም ዓመል ፈአድ</char></note> ኧነብርነ ባነ፤ ይንጐዲኸም በወትኸለቀና በእዝጌር ማት ተት ባነነ። <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />ቢኸንም በምረተሑ ደንገኘ የኸነ እዝጌር ይና ታነን ተወደል ፍቅረሑ የትነሳ፣ <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />በበደለና የᎀትነ ኸነም ትናነነ፣ በክርስቶስ ሕያዋን ሸከተነ፤ የተረፍኩ በጸጋው። <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />እዝጌር ተክርስቶስጌ ተሞት አትኔሣነ፤ በክርስቶስ ኢየሱስ በሰሜዪ ባነዪ መደር ተሑቲጌ አወናነ፤ <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />ዚም ቢችኚ ዘበን በክርስቶስ ኢየሱስ በደነ-ሜናነተሑ የገለጠንነ ይውዳደር ዬነኒ የጸጋውታን ደንገኝነት ያቴዤው፤<verse eid="EPH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 2:8" />በእምነት፣ በጸጋ ተረፍኩም፤ ዚም የእዝጌር ስጦታው አንኸንም ታሑ አንከነ፤ <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />ሟንም ኤይትነነድ ዚ ጸጋ በሜና የትረከበ አንከነ፤ <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />መሳሑም፣ እዝጌር በደረም ያዝጋጀንነዪ ፈያ ሜና ኧሸክትነኸም በክርስቶስ ኢየሱስ የትኸለቅነ የእዝጌር ኧጅ ሜናዎችንነ።<verse eid="EPH 2:10" /></para>
  <para style="s1">በክርስቶስ ቁና ወሕን</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />ስለኸነም አሑ በደረም በጨኘት አሕዛብ የኸንኩ፣ በጅስም ᎈር በሰብ ኧጅ ተሸከተዪ የትነሣ፣ ነብሰሕኖም “ጤበን አወነነም” ቢብሮዪ፣ “ጤበን ያናውነኩ” የቧርኩ ዛ አስታውሶ፤ <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />አሑ ተእስራኤል ማሕበረሰብ ርሕቦት ዬነናሑ፥ የተስፋዪ ቃል ጉዳ አለጋ የኸንኩ፥ በዚ ዓለምም አትም ተስፋ ዬነናሑ፥ ያለ እዝጌር ትነብሮ፥ ተክርስቶስ ተላኘሑም የነበርኩኸም አስታውሶ። <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />ኧሗም አሑ በደረም ራቁም የነበርኩ፣ በክርስቶስ ኢየሱስ ኸንኩም በክርስቶስ ደም መሳ ቀረብኩም።<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />መሳሑም ዄቲ ጐሳ ቁና የሸከተ፣ ያትልያየዪም የመናክስ ግድግዳ ያፈረሰ ሰላመና ክርስቶሱ፤<verse eid="EPH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 2:15" />ሕጊም፣ ተትዛዘውታ ተሥራተሑጌ በበሠረሑ ሻረ። አላማውታም ተዄቲ ጐሳ ቁና ገደር ሰብ በነብሰሑ ኸለቀም ሰላም የወሰክቱ። <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />በመስቀል ᎈር በወሙትም መሶነት አጠፋ፤ ዄቲም ቁና ጅስም ሸከተም ተእዝጌርጌ አታረቀኖ። <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />ቸኘም ተእዝጌር ራቅኩም የነበርኩ ያሑም ቀረቦም የነበሮዪም የሕኖ ሰላም ሰበከ፤ <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />እንመናም በክርስቶስ መሳ በቁናዪ መንፈስ ተአቤ ወቅረብ ኧችልነ።<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />በዛ የትነሣ አሑ ተቅዱሳንጌ የቁና ገኝ ዜጋ፣ የእዝጌርም አበሮስ አባልንኩ አንኸንም፣ በዚ አንቌ ብንጐድ ገኝ የቸኘ ባዘናም አንከንኩ። <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />በሐዋርያት በነብዮችም መሠረት ᎈር ግነᎄኩም፤ የማዘኒ ራስ እምን ኢየሱስ ክርስቶሱ። <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />በሑቲ ሕንጻ እንም ቁናዬ ተግጣጠመም በጔታ ቅዱስ ቤተ መቅደስ የወሕን ይለቅ። <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />አሑም እዝጌር በመንፈሰሑ ይነብረወ ቤት ትኸኖዬ ነብስ በነብሳሑ ትግነቦ።<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">ጳውሎስ የአሕዛብ ሐዋርያ ወሕነሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />እያ ጳውሎስ ያሑ የአሕዛብ ኢየሱስ ክርስቶስ በወስብከኛ ኧጉጀኘ ኸንኩ። <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />ያሑ ጥቅም ያነንኸም የእዝጌር ጸጋ በአደራ ያቡኝኸም የኢንም ሰማሑም። <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />በደርኩም ባጭረሑ የጣፈክንኩኸም እዝጌር ምሥጢረሑ ገለጠም በመና አቴዤም። <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />ዚ የጣፈክንኩ ትታነቦ ስለክርስቶስ ምሥጢር እያ ያጥራመትኩኒ የወርዳ ትችሎ። <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ዚ ምስጢር በእዝጌር መንፈስ የቅዱሳን ሐዋርያቲ ነብዮቺም ኧሗ የትገለጠኸማት ባለፎዪ ዘበናት የነበሮዪ ሰቦች አንትገለጠ። <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ዚም ያምለክት አሕዛብ ተአይሑድጌ የርስተሑ ወራሾች የቁና ጅስም ክፍል ኸኖም እዝጌር ያᎄን ተስፋ በወንጌል መሳ በኢየሱስ ክርስቶስ ይሰዶ ወሕነሕኖው።<note caller="-" style="x"><char style="xo" closed="false">3፥4-6 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">ቆላ. 1፥26-27</ref>። </char></note><verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />እዝጌር በቆተሑ ባቤ የጸጋ ስጦታ እያም የዚ ወንጌል አገልጋይ ኸንኩም። <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />እያ ተቅዱሳን እንም አንስ ብንኸንም ድንበር ዬነን የክርስቶስ ዱሬሽነት የአሕዛብ ኢውድኸም በእዝጌር ጸጋ ዚ ዕድል አቡኝ። <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ዛምኸም ባለፎዪ ዘበናት እንም በኸለቀ በእዝጌር ተሼተረም የነበረ ስለኸነ ምሥጢር የእዝጌር ዕቅድ መአር የኸነኸም ይንም ኧትገልጥኸም ጸጋ አቡኝ። <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />ዚም የኸነ በሗዪ ዘበን በቤተ ክርስቲያን መሳ በሰሜ ያኖዪ አለኦች ባለሥልጣኖችም የእዝጌር ብላት በመልክ መልከሑ ይሒሮኸሙ። <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />ዚም የእዝጌር ዕቅድ በጔታና በኢየሱስ ክርስቶስ ዚ የፌጠመ በዘላለማዊ መሠረቱ። <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />የክርስቶስ በወሕነናም በሑቲ በወምነና በእዝጌር ኢፍት በድፍረትም በወትመመን ወቅርብ ኧችልነ። <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />እያ ስላአሑ ኧቌᎄር መከራ ክብራሑው፤ ስለኸነም በመከራኛ መሳ ተስፋ አትርጦ ባሑም ኧጮቅስኩ።<verse eid="EPH 3:13" /></para>
  <para style="s1">የክርስቶስ ፍቅር</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />ኧጌሽ በእዝጌር አብ ኢፍት በመሌኛ ተንብረከኩም ኧጤልይ በዚ መሳው። <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />በሰሜ በአፈርም ያነ እያታቲ አበሮስ የኢኒ ሽመሑ ይረሕብ በእዝጌሩ። <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />እዝጌር የውስጢ ገጋሑ ያጥነክር ቆት በመንፈሰሑ መሳ በክብረሑ ዱሬሽነት ይቡኩኸም ኧጤልይ። <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />ዛምኸም ክርስቶስ በእምነት በሒናሑ ይነብርኸም አሑም ሥር ሰደድኩም በፍቅር የጠናሑ ትኸኖኸም ኧጤልይ። <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ኧሗም የክርስቶስ ፍቅር በተትነተሑ ገሊፍነተሑም፥ ከፍታውታ ጥልቀተሑም፥ ምን ቅጫ የኸነም ተቅዱሳንጌ ዋጥራምት ትችሎኸም <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />ዚ ተሰብ ውቀት ነን የኸነዪ የክርስቶስ ፍቅር ቲሒሮኸም በእዝጌር ፍጡም ሙላት ሰላሑም ትትᎀሎኸም ኧጤልይ።<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />ስለኸነም ቢና ውስጥ ቢሸክቲ ቆተሑ መሳ ትንጮቅስነዪ ትኔስብነዪ ነን ስርም አትርፈረፈም ይሸክቴ ይቸሊ አምላክ፥ <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />የሑቲ በቤተ ክርስቲያን በኢየሱስ ክርስቶስም በዘበናት እንም ተዘላለም ዘላለም ስን ክብር የሕን፤ አሜን።<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">በክርስቶስ ቁና ወሕን</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />ኧጌሽ የጔታ በዋገልግለኛ ኧጉጀኘ የኸንኩ እያ፥ የጠራሑᎄ ጥሪ ተገቢ የኸነ ሕይወት ትነብሮዬ ኧመክርሑ። <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />በፍጡም ቁና ቀልብነት ሜናም ሕኖ፤ ነብስ በነብሳሑ በፍቅር ትትቸቸሎ ትዕግሥተኘ ሕኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">ቆላ. 3፥12-13</ref>። </char></note> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />በሰላም ተጥባበጥኩም በእዝጌር መንፈስ ይትረከቢ አትነት የወቀየ ተጋደሎ። <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />በጠራሑ ግዝየ የቁና ተስፋ የጠራሑኸም ቁና ጅስም ቁና መንፈስም ነነ። <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />ዛምኸም ቁና ጔታ፤ ቁና እምነት ቁና ጥምቀትም ነነ፤ <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />ኧሗም ትንም ነን የኸነ፤ ብንም ይሸክት፤ ብንም ይነብር ይንም አባ የኸነ ቁና አምላክ ነነ።<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />ቢኸንም ክርስቶስ የዋብ በዌሰነኒ ቅጫ አትባተና የጸጋዪ ስጦታ አቡነም። <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />ዚም፦</para>
  <para style="q1" vid="EPH 4:8">“ተነኔ በወጣ ግዝየ ብዠ የሟረኩዮዪ ጠበጠም ወረ፤</para>
  <para style="q2" vid="EPH 4:8">የሰቦችም ስጦታ አበ” የቧሪኸሙ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">መዝ. 68፥18</ref>። </char></note><verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />ኧጌ፤ ዚ “ተነኔ ወጣ” ይብሪ ቃል በደረም ተዚ አፈሬ፥ ተአፈሪም ዝቅ ተባረ መደሬ ወውርደሑ ባንከነ እንጐድ መአር ያምለክት? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />ዚ ተተቴ የወረደዪ ኧሗም ዛ ይንም የወሙላ ተሰሜ እንም ነን የወጣዪው። <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ሑቲም አታቲ ሐዋርያት፥ አታቲ ነብዮች፥ አታቲ የወንጌል ሰባኪ፥ አታቲ መጋቢ አታቲ አስተማሪ ይኸኖኸም ስጦታ አበኖ። <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />ዚም የክርስቶስ ጅስም ይግነባኸም ቅዱሳን የአገልግሎት ሜና የዋዝጋጅ ቲኸን፣ <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />ዛምኸም የእዝጌር ትኸ በወሐር በእምነት ቲትረከቢ አትነት ሰላነ፥ ክርስቶስ ፍጡም ሙላ የኸነኸማትም ኢናም ሙላ ሰብ ኧኸነኸሙ። <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />ተሗ ቀረሰም በሰቦች የተንኰል በወሸንግል በዋብላልጥም በዝጋጀ ቢያሰሰት የትምርት ኧንፋስም ተዛዬና ተዚዬ ትንውላውልነ ሰብዬ ወሕን ኤጌባነ አንኸነ። <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />ይጠቅሊሽ የኢኒ በፍቅር ትንዝነግነ ብንም ቃር ነብሰሑ ወውድድ ጉነን ተኸነዪ ክርስቶስ ኧለቅነ። <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />የትልያዮዪ የገግ ክፍል ይግጣጠሞ በክርስቶሱ፤ ጅስም እንም የጥባበጠ ቢግጣጠሞᎄዪው፤ ስለኸነም እያታቲ የጅስም ክፍል የትሜደᎄነዪ ሜና ቢጌባ ቲሸክት ጅስም እንም ይለቅ፤ በፍቅርም ይግነባ።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="COL 2:19">ቆላ. 2፥19</ref>። </char></note><verse eid="EPH 4:16" /></para>
  <para style="s1">በክርስቶስ ይትረከብ ገደር ሕይወት</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />ተሗ ቀረሰም አሳበሕኖ ኤድገልል የኸነዪ የአሕዛብኸም አትንበሮ ባሑም በጔታ ሽም ኧመክርሑ፤ <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />የሕኖ አእምሮ ጨለመም፤ ባለወሐረሕኖ በእልኸኘነተሕኖም መሳ እዝጌር ቲይᎅ ሕይወት ተላኖም። <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />ሕሊናሕኖ የድነዘዘ ስለኸነ ስሜተሕኖ የጠፋ ስለኸነ፤ ሩክሰት እንም የወፈጥም ነብሰሕኖ የገግ ኤላተሕኖ አቸለፎም አቦም።<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />አሑም ስለክርስቶስ የትማርኩ እኪ አንከነ። <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />የኢንም ስለሑቲ ሰማሑም፤ በኢየሱስ ባነዪ የኢን መሠረትም በሑቲ ተማርኩም። <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />ስለኸነም አብላለጠም ተአጢአቴ ቢመራ ኤላት የትብላሸዪ ድረ ትነብሮᎄ የነበረዪ፥ የሰብ አጢያተኘ አመል አጥፎ።<note caller="-" style="x"><char style="xo" closed="false">4፥22 </char><char style="xt" closed="false"><ref loc="COL 3:9">ቆላ. 3፥9</ref>። </char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />አይምሮአሑ በመንፈስ የታደስ። <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />በኢኒ ጽድቅ ቅድስናም በእዝጌር ምሳሌ የትኸለቀዪ የገደሪ ሰብ አመል ባሑ የንብርኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">ዘፍ. 1፥26</ref>፤ <ref loc="COL 3:10">ቆላ. 3፥10</ref>። </char></note><verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />ስለኸነም ባጢል አትዘንጎ፤ እንመናም የቁና ጅስም ክፍል ስለኸነ ነብስ በነብሰና የኢን ንዘጊነ።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">ዘካ. 8፥16</ref>። </char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />ማቶ! በማታሑ አጢአት አትሠክቶ፤ ማታሑም ቴይበርድ ጬት ኤይᎄየብኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">መዝ. 4፥4</ref>። </char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />ዳቡሎስም ይገባወ ጉድ አታቦይ። <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />ይሰርቅ የነበረ ተሗ ቀረሰም ኤይስርቅ፤ ይጠቅሊሽ የምካተኘ ይቤ ዋጋ ይነቡርኸም በነብሰሑ ኧጅ ፈያ ቃር የሰክት። <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />ስርም ባፋሑ ቡሼ ቃል ኤይውጣ፤ ቢኸንም ይሰሞዪ የሰቦች ሕይወት ያስትካክል ይጠቅም ያሸዪ ቃል ዘንጎ። <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />የትዋጀሑᎄ ከነ የቴተምሑᎄ ቅዱሲ የእዝጌር መንፈስ አታትማቶ። <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />መራራነት፥ ንዴት፥ ማት፥ ረብሻ፥ ስድብም ሟንመሑ ይመስር ቡሼ ቃር እንም ታሑ ዛዘር የራቅ። <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />ይጠቅሊሽ ነብስ በነብሳሑ ዋቢም አዛኝ ዋቢ ሩሕሩሕም ሕኖ፤ እዝጌር በክርስቶስ አፉ የባረናሑኸም አሑም ነብስ በነብሳሑ አፉ ተበበሮ።<note caller="-" style="x"><char style="xo" closed="false">4፥32 </char><char style="xt" closed="false"><ref loc="COL 3:13">ቆላ. 3፥13</ref>። </char></note><verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s1">በብራን ወንብር</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />ኧጌሽ የትወደዶ ዴንጋኸም እዝጌር ምሰሮ። <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />ክርስቶስ የወደደነኸም የእዝጌር ያትብላልቅ ፈያ ሱትነት ያነን መባ መሥዋዕትም ሸከተም ሕይወተሑ ስለኢና አቸለፈም ያበኸም አሑም በፍቅር ንበሮ።<note caller="-" style="x"><char style="xo" closed="false">5፥2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ዘፀ. 29፥18</ref>፤ <ref loc="PSA 40:6">መዝ. 40፥6</ref>። </char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />ዚ ይመስሪ ቃር የክርስቲያኖች ኤይስማማ ስለኸነ ዝሙት ወይ ሟንመሕኖኸማት ሩክሰት ወይ ንፉግነት ወሰክትም የቂ ወሬዪም ይሴማብኩዬ ኤይጌባ። <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />ይጠቅልሽ የእዝጌር ምስጋና አቅርቦ አንከንም ያትማች የገውነት ንግግር፥ የፌዝ ቃር ወዘንግ ኤይጌባሑ፤ እኪ ያነ ቃር ያሑ ኤይስማማ። <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />ይሟግጥም ቢኸን፥ ሟንመሕኖም የሩክሰት ሜና ይሸክት ቢኸን፥ ጣዖት ዋምልክ የኸነ ገብጋብነት ቢኸን፥ በክርስቶስ በእዝጌር መንግሥትም<note caller="+" style="f"><char style="fr" closed="false">5፥5 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የክርስቶስ የእዝጌር መንግሥትም በኸነዪ</char></note> ርስት ኤረሕብኸም ሐሮ።<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />በዚሕኖ ዘንጋ መሳ ቤይታዘዞ ሰቦች ᎈር የእዝጌር ማት ይቸኝ ስለኸነ ሟንም ቤድገልል ንግግር ኤያብላልጥሑ። <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />ስለኸነም ተዚሕኖ ቴይታዘዞ ሰቦችጌ አትትገገዞ፤ <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />ድረ በጨለማ ባነሑ፤ ኧሗም በጔታ ብራንንኩ። የብራን ዴንጋኸም ንበሮ፤ <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />የዋቢነት እንም፥ የጽድቅ የኢንም ፍርየ ይትረከቢ ተብራኑ። <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />ስለኸነም የጔታ ያትቡላልቊ ቃር ምን የኸነኸም መርምሮ። <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />ተብራኔ አውጦም አጋልጦይ አንከንም ቤድገልል ቃር ተጨለማ ሜናጌ አትትገገዞ። ይጠቅለሑ ግለጦይ። <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />በጨለማ ይነብሮ ሰቦች በሽሙቸ ይሸክቶይ ቃር ወዘንግም ያትማልል። <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />እንም ቃር ተብራኔ ቲወጣ የኢን መልከሑ ቢልቢጢጦ ይታዥ። <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />ቢልቢጢጦ ይታዥ እንም ብራኑ፤ ስለኸነም፦</para>
  <para style="q1" vid="EPH 5:14">“አኸ የገደርከ ንቃ! ተሟቾቺ ተንሣ!</para>
  <para style="q2" vid="EPH 5:14">ክርስቶስም ያበራንከ” ቧሪም።<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />ኧጌሽ ምንኸም ትነብሮኸም በወትቀየ አጥራምቶ፤ የብላተኛኸም አንከንም የገዋኸም አትንብሮ። <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />ከነዪ ቡሼኖ ዘበኒ ቢጌባ ዋጆይ።<note caller="-" style="x"><char style="xo" closed="false">5፥16 </char><char style="xt" closed="false"><ref loc="COL 4:5">ቆላ. 4፥5</ref>። </char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />ስለኸነም የጔታ ፈአድ ምን የኸነኸም አጥራምቶ አንከንም ገዋ አትሕኖ።<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />ተጥፋቴ ይመራሑ ስለኸነ በደጔ አትስክሮ፤ የጠቀለዪሽ በመንፈስ ቅዱስ ተᎀሎ<note caller="+" style="f"><char style="fr" closed="false">5፥18 </char><char style="fp" closed="false">በመንፈስ ቅዱስ ተመሎ ወበር የእዝጌር መንፈስ ሕይወታሑ የቁጣጠርኩ ወበሩ። </char></note>። <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />በመዝሙር በውዳሴም፥ በመንፈሳዊም ዜማ ነብስ በነብሳሑ ተዝናጎ፤ በውዳሴ በመዝሙርም በሙላ ሒናሑ የጔታ አመስግኖይ፤ <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />በጔታና በኢየሱስ ክርስቶስ ሽም ብንም ቃር የእዝጌር አብ እንጌ አመስግኖይ።<note caller="-" style="x"><char style="xo" closed="false">5፥19-20 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">ቆላ. 3፥16-17</ref>። </char></note><verse eid="EPH 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />የክርስቶስ ክብር በሮም እያታቲ ይንጐዲ የታዘዝ።<verse eid="EPH 5:21" /></para>
  <para style="s1">ምስ ተምሽት</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />እንሽታ! የጔታ ኢየሱስ ትታዘዘማኸም የምሳሕማ ታዘዘማ፤<note caller="-" style="x"><char style="xo" closed="false">5፥22 </char><char style="xt" closed="false"><ref loc="COL 3:18">ቆላ. 3፥18</ref>፤ <ref loc="1PE 3:1">1 ጴጥ. 3፥1</ref>። </char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />ክርስቶስ የቤተ ክርስቲያን ነብሰሑ ወውድድ የኸነኸም ምስም የምሽተሑ ራሱ፤ ኧሗም ክርስቶስ ጅስመሑ የኸነዪ ቤተ ክርስቲያን ያተርፉ። <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />ቤተ ክርስቲያን የክርስቶስ ይታዘዝኸም ዛምኸም እንሽታ ብንም ቃር የምሰሕነማ የታዘዘማ።<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />ምስ! ክርስቶስ ቤተ ክርስቲያን የወደደኸም ነብሰሑ ስለሑቲ አቸለፈም ያበኸም አሑም የምሽታሑ ውደዶ፤<note caller="-" style="x"><char style="xo" closed="false">5፥25 </char><char style="xt" closed="false"><ref loc="COL 3:19">ቆላ. 3፥19</ref>፤ <ref loc="1PE 3:7">1 ጴጥ. 3፥7</ref>። </char></note> <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />ክርስቶስ ዚ የሸከተ ቤተ ክርስቲያን ይቌድሼ ሸሙ፤ የቌደሰንም በቃለሑ መሳ በኧጋ አጠበሙ። <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />በዚኸማት ጭቅቅት ይፍት ወጭማደድ ዚ የመሰረ እንጐድ ውዶ ቃር ቴትረከብወ ቅድስት፥ ሰሕ ዬነወ መልካማ ሸከተም ተነብሰዄ ያቀርᎆው። <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />ዛምኸም ምስ የፎለሕኖ ጅስም ይወዶኸም ምሽተሕኖ የውድዶ፤ ምሽተሑ ይወድ ነብሰሑ ይወድ። <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />የፎለሑ ጅስም ይጠላ ሟንም ኤነ፤ ይጠቅሊሽ ክርስቶስ የቤተ ክርስቲያን ይሸክትኸማት የፎለሑ ይሜግብ፤ ይንክባከብ። <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />መሳሑም ኢና የክርስቶስ ጅስምንነ፤ <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />በዛ መሳ ሰብ አᎄች ተዳኰች ገፈረም ተምሽተሑጌ ቁና ይኸኖ፤ ዄትም ቁና ጅስም ይኸኖ ቧሪም።<note caller="-" style="x"><char style="xo" closed="false">5፥31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዘፍ. 2፥24</ref>። </char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ዚ ምስጢር ወደሉ፤ ዚም ኧቡኒ ክርስቶስ የቤተ ክርስቲያን ምሳሌ ሸከትኩሙ። <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />ቢኸንም ታሑ እያታቲ ምሽተሑ የፎለሑኸም ሸከተም የውድድ፤ ምሽትም የምሴታን ታክብር።<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">ወላጅ ተዴንጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />ዴንጋ! ተገቢ ስለኸነ የጔታ ስለኸንኩ የወላጆቻሑ ታዘዞ።<note caller="-" style="x"><char style="xo" closed="false">6፥1 </char><char style="xt" closed="false"><ref loc="COL 3:20">ቆላ. 3፥20</ref>። </char></note> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“አባኸ ተዳኳኸም አክብር” ይብሪ ትዛዝ የተስፋ ቃል ያነን የመጀመሪያዪ ትዛዙ፤ <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />ዚም ብትሸክት “እንም ቃር ይሳካንከ፤ በዚም አፈር ᎈር ዕድሜያኸ ይገልፍ።”<note caller="-" style="x"><char style="xo" closed="false">6፥2-3 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዘፀ. 20፥12</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>። </char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />አሑም ወላጆች! በጔታ በኢየሱስ ሤራ በዋትመር፥ በወምክር በወገስጥ አለቆዮ አንኸንም ዴንጋሑ አታትማቶዮ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">ቆላ. 3፥22-25</ref>። </char></note><verse eid="EPH 6:4" /></para>
  <para style="s1">ጌቶች ተጉዙዎች</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />አሑ ጉዙዎች! በገግ ጌቶቻሑ የኸኖ በጊናት በወንቀጥቅጥም ታዘዞ፤ የክርስቶስ ታግለግሎኸም በሒን ቅንነት ታዘዞዮ። <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />ትታዘዞም የእዝጌር ፈአድ ተሒን ይፌጥሞኸም የክርስቶስ አገልጋዮችኸም ኸንኩሙ አንኸንም የሰብ የዋትብላልቅ ባሑም የዋትመስር ኤይሕን። <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />የሰብ ቴይኸን የጔታ ታግለግሎኸም በሙላ ፈአድ አገልግሎ። <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />ጉዙም ኸነ ነጣ የኸነ ሰብ እያታቲ በሸኰተን ፈያ ሜና በጔታ ዋጋውታን ይቌበር ወሕነሑ ቲሒሮ።<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />አሑም ጌቶች የጉዙዎቻሑ፤ ዛምኸም ሰክቶኖ፤ የሕኖም፤ ያሑ ጔታ የኸነዪ በሰሜ ያነኸም፤ የሰብ ኢፍት አዠም ኤያዳላኸም ቲሒሮ ስለኸነ አታጊናኖዮ።<note caller="-" style="x"><char style="xo" closed="false">6፥9 </char><char style="xt" closed="false"><ref loc="DEU 10:17">ዘዳ. 10፥17</ref>፤ <ref loc="COL 3:25">ቆላ. 3፥25</ref>፤ <ref loc="COL 4:1">4፥1</ref>። </char></note><verse eid="EPH 6:9" /></para>
  <para style="s1">የመንፈሳዊ አርብ መሣሪያ</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />በመጨረሻ ኧብርሑዪ በጔታ በሑቲም ወደል ቆት በርቶ፤ <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />የዳቡሎስ የተንኰል ሜና ወቃወም ትችሎኸም እዝጌር ይብኩዪ የአርብ መሣሪያ እንም ጥብጦ። <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />መሳመሑም ግጅላና ተሰቦችጌ ቴይኸን ተዚ ተጨለማ ዓለም ገዢዎች፣ ተሥልጣናት ተሓይላት ዛምኸም በሰሜ ታኖ ተሩኩሳን መናፍስት ሰራዊትጌው።። <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />ስለኸነም በቡሼ ከነ የመሶ ቆት የወቈቈም ትችሎኸም ፌጠምኩም ጠናሑም የወቆም ትችሎኸም የእዝጌር ሙላ የአርብ መሣሪያ ንሦ!<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />ኧጌሽ የኢን የጥይት ቀበቶ በጊንዣሑ ታገዶም፥ ጽድቅ የደረት ይኩላኰልᎄ ብረት ታገዶም፥<note caller="-" style="x"><char style="xo" closed="false">6፥14 </char><char style="xt" closed="false"><ref loc="ISA 11:5">ኢሳ. 11፥5</ref>፤ <ref loc="ISA 59:17">59፥17</ref>። </char></note> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />የሰላም ወንጌል የጫማኸም በግረሑ ኧግዶም ተዝጋዶም ቁሞ።<note caller="-" style="x"><char style="xo" closed="false">6፥15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">ኢሳ. 52፥7</ref>። </char></note> <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />ተዚም እንም ነን የኧሳትኸም ይንቡለቡሎዪ የዳቡሎስ ቀስት እንም ዋጥፋ ትችሎᎄዪ እምነት የጋሻኸም ጥብጦ። <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />ወትርፋሑ የብረት ቆብ በጉነናሑ ᎈር ኧግዶ፤ ዛምኸም የመንፈስ ቅዱስ ሰይፍ የኸነዪ የእዝጌር ቃል ጥብጦ።<note caller="-" style="x"><char style="xo" closed="false">6፥17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">ኢሳ. 59፥17</ref>። </char></note> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />እንጌ በመንፈስ ቅዱስ ትትትመሮ ጠሎት ጩቀሸም አቅርቦ። በዚም መሠረት እዝጌር የቄደሰኖ ሰቦች ንቆም ተጋደሎም ጠልዮ። <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />የወንጌል ምስጢር ያለ ጊናት ኧገልጥኸም ብንዝነግወ ግዝየ ያሸዪ ቃል ይቤኸም ይያም ጠልዮኒ። <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />ኧሗም እያ በሰንሰለት ኧጉጀኘ የኸንኩ የዚ ወንጌል መልክተኘ በወሕነኛው፤ ስለኸነም ይጔቤኸም ያለ ጊናት ኧዝነግኸም ጠልዮኒ።<verse eid="EPH 6:20" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />የትወደደ ጐቤናም በጔታ ኢየሱስ ሜና ታማኝ አገልጋይ የኸነዪ ቲኪቆስ ይያ ሐለት ምን የኸነኸም ምን ኧሸክትኸም እንመሑ ቃር ይውድሑ።<note caller="-" style="x"><char style="xo" closed="false">6፥21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20፥4</ref>፤ <ref loc="2TI 4:12">2 ጢሞ. 4፥12</ref>። </char></note> <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ስለኸነም ኢና ምን የኸነኸም ቲሒሮዬ ያሑም ያብርታታሑ በወበር የሑቲ ታሑዬ ላክሑንም።<note caller="-" style="x"><char style="xo" closed="false">6፥21-22 </char><char style="xt" closed="false"><ref loc="COL 4:7-8">ቆላ. 4፥7-8</ref>። </char></note><verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />ተእዝጌር አብ ተጔታም ተኢየሱስ ክርስቶስ ሰላም ፍቅር ተእምነትጌ የተም ተጐቤኸም የሕን። <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />ቤትቋርጥ ፍቅር የጔታ የኢየሱስ ክርስቶስ ይወዶ እንም ጸጋ የሕንኖ።<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>