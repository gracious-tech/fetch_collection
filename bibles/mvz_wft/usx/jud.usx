<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">Mesqan New Testament BIBLE JUDE</book>
  <para style="h">የይሑዳ መልክት</para>
  <para style="toc1">የይሑዳ መልክት</para>
  <para style="toc2">የይሑዳ መልክት</para>
  <para style="toc3">ይሑ.</para>
  <para style="mt">የይሑዳ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የይሑዳ መልክት የጣፈዪ አማኞች ቴይኸኖ አማኞች መሰሮም የባጢል ትምርት ቲያስራጮ ሰቦች የክርስቲያኖች የዋትቀየው። በአሳበሑ ዄታለኘ የጴጥሮስ ቢᎀስሪ በዚ አጭር መልክት ጠሐፊዪ “ቤደገም ሐለት እዝጌር የሕዝቢ ቁናጌ ስላᎄኒ እምነት ብረቶም ይትጋደሎኸም” ያነቦዪ በጥብቅ ያቴስብ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="JUD 1:1-2">1-2</ref> </char></para>
  <para style="io1">የባጢለተኞች አስተማሪዎች ትምርት፥ አመል ውጥቀትም <char style="ior"><ref loc="JUD 1:3-16">3-16</ref> </char></para>
  <para style="io1">እምነት ይቅሮኸም የቴበ ምክር <char style="ior"><ref loc="JUD 1:17-23">17-23</ref> </char></para>
  <para style="io1">ወባርክ <char style="ior"><ref loc="JUD 1:24-25">24-25</ref> </char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="s1">ሰላም</para>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />የኢየሱስ ክርስቶስ አገልጋይ የያዕቆብም ጐቤ ተኸነዪ ተይሑዳ፤</para>
  <para style="p" vid="JUD 1:1">የጠራሑዪ፤ በእዝጌር አብ የትወደድኩዪ በኢየሱስ ክርስቶስ የትቂየሑ<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="fqa" closed="false">የቅሮዪ </char><char style="ft" closed="false">ይኸኔ ይችል</char></note> እንም፤<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቴ. 13፥55</ref>፤ <ref loc="MRK 6:3">ማር. 6፥3</ref>። </char></note><verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />ምረተሑ፤ ሰላም ፍቅርም የብዛንኩ።<verse eid="JUD 1:2" /></para>
  <para style="s1">ባጢለተኘ አስተማሪዎች</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />ደቦዎች! በደነብ ወትርፈና ኧጠፍንኩዬ አጠበቅሑም ሸሑም ባነ፤ ቢኸንም የቅዱሳን ቁናጌም የመጨረሻ ያᎅዪ እምነት ትትጋደሎኸም የወምክር ኧጠፍንኩዬ ግድ ኸነቢ። <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />ተብዠ ግዝየ ኢፍቴ የዚ ፍርድ<note caller="+" style="f"><char style="fr" closed="false">1፥4 </char><char style="fqa" closed="false">ፍርድ የትዌሰነቦዪ ሰቦች</char></note> የጣፎ አታት ሰቦች ሾለኮም ታሑዬ ገቦም፤ ሕኖ እዝጌር ወገና ኤነኖ፤ የአምላከናም ጸጋ በሩክሰት ይቄይሮ ሑቲ ጠለለ ንቅ ጔታ ገዢና ጔታናም የኸነዪ ኢየሱስ ክርስቶስ ይለጎኖ።<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />አትም ቢኸን በደርኩም ዚ እንም ቲሕሮ ቢኸንም ጔታ<note caller="+" style="f"><char style="fr" closed="false">1፥5 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ኢየሱስ </char><char style="ft" closed="false">ይብሮ</char></note> የሕዝቢ በግብጽ ገኝ ምንኸም ያወጣኸም፤ ባንቌም ያነመኖዪ ያጠፋኖኸም አስታውስኩዬ ኧወድ።<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ዘፀ. 12፥51</ref>፤ <ref loc="NUM 14:29-30">ዘሑ. 14፥29-30</ref>። </char></note> <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />የሥልጣን መደረሕኖ ያንቅሮዪ ቢኸንም ይነብሮᎄዪ የገፈሮዪ መላይካ በዘለዓለም ወታገድ የወደሊ ፍርድ ከነ ስን በጨለማ ቂየኖም። <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />ዛምኸም ሰዶም ገሞራም፤ በዙሪያሕኖም ያኖ ከተሞች የሴሰኝነት ተትኸለቀዪ ሥራት ውጪ የኸነ የዝሙት ነብሰሕኖ አቸለፎም አቦ፤ ሕኖም በዘለዓለም ኧሳት በወትቀጣ ይስቃዮዪ ምሳሌ ኸኖም።<note caller="-" style="x"><char style="xo" closed="false">7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">ዘፍ. 19፥1-24</ref>። </char></note><verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />በዚ ሐለት ነዚ ብርዛዝ ያዞዪ የፎለሕኖ በሠር ያረክሶ፤ ሥልጣንም ይቃወሞ፤ በሰሜ ክብር ያነኖዪም ኸልቀት ይሳደቦ። <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" />የመላይካ አለአ የኸነዪ ሚካኤል ስለሙሴ ሬሳ ተዳቡሎስጌ በትሟገተ ግዝየ፤ “ጔታ የገስጥከ” ቧረን አንኸንም የስድብ ቃል በወዘንግ ይኰሽሼ አንደፈረ።<note caller="-" style="x"><char style="xo" closed="false">9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፥13</ref>፣<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፥1</ref>፤ <ref loc="REV 12:7">መና 12፥7</ref>፤ <ref loc="DEU 34:6">ዘዳ. 34፥6</ref>፤ <ref loc="ZEC 3:2">ዘካ. 3፥2</ref>። </char></note> <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />ነዚ ሰቦች ኤይሒሮዪ ቃር እንም ይሳደቦ፤ አእምሮ ዬነኖ እንሰሶችኸም በደመ ነብስ ቢይሒሮዪ ቃር ይጠፎ። <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />ወዮሕኖ በቃየል ኤማ ወሮም፤ የዋጋ ቲስግበግቦ በበለዓም ስተት ውስጥ ወጠቆም፤ በቆሬም ዐመጥ ጠፎም።<note caller="-" style="x"><char style="xo" closed="false">11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ዘፍ. 4፥3-8</ref>፤ <ref loc="NUM 22:1-35">ዘሑ. 22፥1-35</ref>፤ <ref loc="NUM 16:1-35">16፥1-35</ref>። </char></note> <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />ነዚ ሰቦች ፍርየ ኤባን ቴማልሎ ተሩክሰት በአትነት ግብዣሕኖ ᎈር ቲትረከቦ ቈፋ ይኸንብኩ፤ ሕኖ ዬስቦይ የነብሰሕኖ ጠለለው፤ ብንፋስ ይትገፎኸም፥ ዝናብ ዬነን ዳበናኸምኖ፤ በፍርየ መሬት ፍርየ ኤትረከብወኸም፥ ተስረሑ የትነቀለኸም ዄትጌ የᎀተ ኧጨኸምኖ። <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />የነውረሕኖ ኢንባ ይደፍቆ የማት ባር ማዕበልኸምኖ፤ ዔን ይጠብጥ ጨለማ የዘለዓለም ይቂየኖ ይንክራተቶ ኰኰብኖ።<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />ተአዳም ቀረሰም ሰበታለኘዪ ጨኘት የኸነዪ ሔኖክ ስለዚሕኖ ሰቦች እኪ ቲብር ትነበየም፤ ዘ ጔታ ተብዠ ሺ ቅዱሳነሑጌ ይቸኝ፤<note caller="-" style="x"><char style="xo" closed="false">14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ዘፍ. 5፥18</ref>፣<ref loc="GEN 5:21-24">21-24</ref>። </char></note><verse eid="JUD 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JUD 1:15" />ነዛሕኖ እዝጌር ኤያመልኮዪ ሰቦች በሸከቶዪ ቡሼ ቃር መሳ ይቀጣኖ፤ እዝጌርም በኢኒ በዚሕኖ የሑቲ ቤያመልኮ አጢአተኞች ᎈር በሑቲ ᎈር የዝነጎይ ቡሼ ቃር እንም ይፈርድቦ።<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />ነዚ ሰቦች ቁምቁሜ ይብሮ ይንጐድ ሰቦችም ይከሶዪኖ፤ ሩክስ ኤላተሕኖ ይትዄተሎ፤ በነብሰኖ ይትነነዶ፤ ጥቅም የወርክብ ቲብሮ የንጐደሕኖ ያንጋግሶ።<verse eid="JUD 1:16" /></para>
  <para style="s1">ጠነም ስለወቆም የቀረበ ጥሪ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />አሑ ደቦዎች! የጔታና የኢየሱስ ክርስቶስ ሐዋርያት በደሮም የዝነጎዪ አስታውሶ። <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" />ሕኖም፤ “በመጨረሻዪ ዘበን ሩክስ ኤላተሕኖ ይትዄተሎ ዘባቾች ይቸኖ” ባሮኩም።<note caller="-" style="x"><char style="xo" closed="false">18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጴጥ. 3፥3</ref>። </char></note> <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />ነዚሕኖ ሰቦች በግብተሕኖ ወልያይ ይኸልቆ፥ የበሠር ኤላት ይትዄተሎ፥ መንፈስ ቅዱስ ዬነኖ ሰቦችኖ። <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />አሑም ደቦዎች፤ ስርም ቅዱስ በኸነዪ እምነታሑ ነብሳሑ የዋንጥ ተጋደሎ፤ በመንፈስ ቅዱስም ቆት ጠልዮ። <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />ተዘላለም ሕይወቴ ያሰላሑዪ የጔታና የኢየሱስ ክርስቶስ ምረተሑ ትትቅሮ ትናነ፤ በእዝጌር ፍቅር ነብሳሑ ቀሮ።<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />ይጥራጠሮዪ ራሮኖ፤ <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />አታቲ ትሳት አውጦም አትርፎዮ፤ እንጐዲ በወጔና ራሮኖ፤ ቢኸንም በአጢያት የረከሰዪ ገገሕኖ የለጐደኒ ልባስ ቴይቀይ ጥሎ።<verse eid="JUD 1:23" /></para>
  <para style="s1">የምስጋና ጠሎት</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />አትወጥቆኸም ይቅየሑዪ ፍርየ ኤባን ነቀፋ በብልቃት በክብረሑ ኢፍት ያቀርብሑዬ ይችል፤ <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />ሑቲ ጠለል ያተርፍነ የኸነዪ አምላክ በጔታና በኢየሱስ ክርስቶስ ኤማ ተዘበናት እንም ኢፍቴ፤ ኧሗም ዘላለምም ስን ክብር፤ ግርማ፤ ቆት ሥልጣንም የሕን፤ አሜን።<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>