<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">Mesqan New Testament</book>
  <para style="h">ተፊልጵስዩስ ሰቦቼ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተፊልጵስዩስ ሰቦቼ</para>
  <para style="toc2">ተፊልጵስዩስ ሰቦቼ</para>
  <para style="toc3">ፊልጵ.</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተፊልጵስዩስ ሰቦቼ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ጳውሎስ ዚ መልክት የጣᎈን፤ መቄዶንያ ቢቡሪዪ የሮም ግዛት ቢትረከቢ በፊልጵስዩስ ያነዪ ቤተ ክርስቲያኑ፤ ዚ ቤተ ክርስቲያን፤ ጳውሎስ በአውሮፓ ገኝ መጀመሪያ ያቈቈᎀኑ፤ መልክቲ የጣፈዪ ጳውሎስ ወሕኔ ቤት ባነወ፥ ትንጐድ ክርስቲያን ጉዙዎች ተቃውሞ በሰላወ ግዝየም በፊልጵስዩስ ቤተ ክርስቲያን በትነሣዪ የባጢል ትምርት መሳ ሒነሑ በአዘን በሰበረወ ወክቱ። የሕን አንኸንም ጳውሎስ በኢየሱስ ክርስቶስ ᎈር ያነዪ እምነት ስርም ጥልቅ በወሕነሑ በዚ መልክት ከፍ ባረም ይታዢ ብልቃት ተᎀላም በወትማመኑ።</para>
  <para style="ip">ጳውሎስ ዚ መልክት የጣፈወ ይፍቴዪ መሳ በምካተሑ ግዝየ የሑቲ የወርዳ ስጦታ ላሖነም ስለኸነ የፊልጵስዩስ ምእመናን የዋመስግኑ፤ በሑቲም ኸነ በሕኖ ᎈር የትልያዮ ምካት የሰሎ ቢኸኖም ድፍረት ሙላም ወትመመን ይነብሮኸም በዚ አጋጣሚ ያብረታታኖ። ትዕቢት ወትነነድም አጠፎም በኢየሱስ ክርስቶስ ቁና-ቀልብነት ይመሎኸም በጥብቅ ያቴስቦ፤ ተኢየሱስ ክርስቶስጌ በመንፈስ ቁና በወሕን የረከቦይ ሕይወት በእዝጌር የጸጋ ስጦታ የምነጨ በእምነትም የቌበሮዩው አንኸንም ሕጊ በወፈጥም የትረከበ አንከነ በወበር ያስታውሶ፤ ተኢየሱስ ክርስቶስጌ በወትገገዝ ይነብሮ እንም እዝጌር ይቦ ስለኸነ ሰላም ብልቃትም ይጠፍኖ።</para>
  <para style="ip">ዚ መልክት ይትኴርወ ብልቃት፥ ወትመመንም፥ አትነትም በክርስትና እምነት ሕይወትም ወጥና ከፍ አበኘም በዋተዠሑ፤ ኧሗም ሐዋርያዪ ጳውሎስ የፊልጵስዩስ ቤተ ክርስቲያን ያነን ወደል ፍቅር ይገልጥ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="PHP 1:1-11">1፥1-11</ref> </char></para>
  <para style="io1">ጳውሎስ ያነወ የሟነሑ ሐለት <char style="ior"><ref loc="PHP 1:12-26">1፥12-26</ref> </char></para>
  <para style="io1">የክርስትና ሕይወት ምሳሌ <char style="ior"><ref loc="PHP 1:27-2:18">1፥27—2፥18</ref> </char></para>
  <para style="io1">የጢሞቴዎስ የኤጳፍሮዲቱስም ዕቅድ <char style="ior"><ref loc="PHP 2:19-30">2፥19-30</ref> </char></para>
  <para style="io1">በእምነት ተቃዋሚዎች ዋትቀየ <char style="ior"><ref loc="PHP 3:1-4:9">3፥1—4፥9</ref> </char></para>
  <para style="io1">ጳውሎስ የፊልጵስዩስ ክርስቲያኖች ያቀረᎄን የምስጋና ምክርም <char style="ior"><ref loc="PHP 4:10-20">4፥10-20</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="PHP 4:21-23">4፥21-23</ref> </char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />የኢየሱስ ክርስቶስ አገልጋዮች የኸኖ ጳውሎስ ተጢሞቴዎስም፤<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="ACT 16:12">ሐዋ. 16፥12</ref>። </char></note></para>
  <para style="p" vid="PHP 1:1">በቤተ ክርስቲያን መሪዎች<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ይትምሌከት ይቅሮዪ</char></note> ተዳቆኖችጌ በፊልጵስዩስ ያኖ በክርስቶስ ኢየሱስ ቅዱሳን የኸኖ እንም፤ <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />ተአባና ተእዝጌር ተጔታም ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<verse eid="PHP 1:2" /></para>
  <para style="s1">የጳውሎስ የምስጋና ጠሎት</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />ያሑ ትናስታውስ እንም አምላከኛ አምሰግን፤ <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />እንጌ ይንማሑ ትንጤልይ፤ በብልቃት ኧጤልይ፤ <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />ተመጀመሪያ ከነ ቀረሰም ኧሗ ስን በወንጌል አገልግሎት ትትገገዞ ስለኸነ የእዝጌር አምሰግን። <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />ዚ ፈያ ሜና ባሑ ሕይወት ውስጥ የቀረሰ አምላክ ኢየሱስ ክርስቶስ ዠበረም ቲቸኝወ ከነ ስን ተፍጣሜዬ ያሰላን ስን የኢነተኘንኩ። <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />ኧሗ በጉጀኘ ቤት ባነሑወ ግዝየ ተወታገደኛ ኢፍቴም የወንጌል ሐቅ የወክላከል የሑቲም የዋጥና እዝጌር በጸጋሑ ባቤ ዕድል እንማሑ ትሰዶ ስለኸንኩ አሑ እንጌ በሒነኛንኩ። ስለኸነም ስላሑ ይሴሜ ስሜት ሱቱ። <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />በኢየሱስ ክርስቶስ ፍቅር እንማሑ ምናሕር ኧቦርስኩኸም እዝጌር ምስክረኛው።<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />የፍቅራሑ ውቀት ዋጥራምትም የᎀላወ ኸነም ቲለቅ ያርኸም ኧጤልይ። <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />ዚም የጠቀለዪ ቃር ምረመርኩም ቲሒሮኸም ክርስቶስ ተዠበረም ቢቸኝወ ከነ ንጡም ያትማልል ቃር ዬነብኩ ኸንኩም ትትረከቦኸሙ። <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />በዚምኸማት ሕይወታሑ በኢየሱስ ክርስቶስ ይትረከብ የጽድቅ ፍርየ የትመላ ኸነም የእዝጌር ክብር ምስጋናም ይትረከብወ ትኸኖ።<verse eid="PHP 1:11" /></para>
  <para style="s1">በጳውሎስ ወታገድ ወንጌል ወስፋፋሑ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />ጐባቢተኛ! ቢያ ᎈር የሰላዪ እንም ወንጌል በብዛት ይስፋፋኸም ወሰክተሑ ቲሒሮኸም ኧወድ። <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" />እያም ኧጉጀኘ የኸንኩ በክርስቶስ መሳ ወሕነሑ የቤተ መንግሥት ዘበኞች<note caller="+" style="f"><char style="fr" closed="false">1፥13 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">በቤተ መንግሥት እንም</char></note> ኧንጐድም በዛዬ ያኖዪ ሰቦች እንም ይሒሮ።<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">ሐዋ. 28፥30</ref>። </char></note> <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />ቢያ ወታገድ መሳ ተአማኞች ብዠ ሕኖ በጔታ ይትማመኖ ኸኖም፤ ስለኸነም የእዝጌር ቃል ፍርየ ኤባን ጊናት የዋውድ ቲፍቴ የበዛ ድፍረት ረከቦም።<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />የሕን አንኸንም አታተሕኖ የክርስቶስ የምሥራች ቃል ያበሥሮዪ በቅናት፤ ኧንጐዲ በኦገት መንፈሱ፤ ኧንጐዲም የክርስቶስ ይሰብኮዪ በቅን ሒኑ። <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />ነዚሕኖ የእዝጌር ቃል በቅን ሒነሕኖ ያበሥሮዪ ተፍቅር የትነሣው፤ ሕኖም ይያ የወንጌል የወክላከል በዚ ያጐጅኝ ወሕነኛ ይሒሮ ስለኸነው። <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />ዛሕኖም ስለክርስቶስ አጣመሞም ይሰብኮይ<note caller="+" style="f"><char style="fr" closed="false">1፥16-17 </char><char style="ft" closed="false">አታት የድረ ያንከኖ ቅጂዎች የቁ 16 ወይ 17 ተራ በተራ ሸገሮይም</char></note> በቅንነት ቴይኸን በነብስ ወዳድነት በወታገደኛም ᎈር የበዛ ምካት ያቸኖቢዬ ኤሰቦሙ።<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />ዛም ኸነ ዚ በዚ ኧትብላለቅ፤ በዋትመስርም ኸነ በሐቅ ብንም ኤማ ክርስቶስ ይሰበክ። <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />ኧንጐዲ ኧትብላለቅወ መሳ ጠሎት በኢየሱስ ክርስቶስ መንፈስም ኧጉዠ ነጣ ኧወጣኸም ኧሒር ስለኸነው። <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />ስርም ኤማልሌኸም በተስፋ ኧቂየ፤ ቢኸንም እንጌ ኧሸኩችኸም ኧኳ በሕይወት ብንነብርም ብንᎀት ክርስቶስ በገገኛ ይከብር ባሑም በድፍረት ኧዝነግ። <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />ስለኸነም ይያ ሕይወት ወበር በክርስቶስ ወንብሩ፤ ሞት ወበር ጥቅም ይትረከብወ ቃሩ። <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />የሕን አንኸንም በዚ ጅስመኛ ቄጠልኩም ኧነብር ቢኸን ፍርየ ያነን ሜና ወሰክት ወበሩ፤ ቢኸንም ቄጠልኩም ተወንብር ተወሙትም ኤተሑ ኧሜጥርኸም አንሒር። <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />በዚ በዄቲ አሳብ ግብት ተጠበጥኩም፤ በአቲ ኤማ ተክርስቶስጌ ወሕን ትንም ይበዛ ቃር የኸነ ስለኸነ ተዚ ሕይወት ተላኘሑም ተክርስቶስጌ ወሕን ኧሸ ዚም ተክርስቶስጌ ወንብር ስርም የጠቀለ ስለኸነው። <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />ብንጐድ አዘር በሕይወት ወንብረኛ ያሑ የጠቀለ ያሸሑ። <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />በዚ በወትማመን እያ ተሞት ተረፍኩም እምነታሑ ይለቅኸም ብልቃት ትረሕቦኸም ትንማሑጌ ኤክስኸም ኧሒር። <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />እያ ዠበርኩም ታሑዬ ትንቸኝ ቢያ መሳ ያነናሑ ወትነነድ በኢየሱስ ክርስቶስ ይበዛ።<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />ኧጌሽ ትንም ነን ሕይወታሑ የክርስቶስ ወንጌል ያትምሴግን የሕን፤ ዚም እያ ቸኘሑም ብናዥኩም ታሑ ብንረቅ በቁና ዓላማ ጠናሑም ወቁማሑ ወንጌል በአትነት የዋስላ ወትጋደላሑ ኧሰማ። <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />ተቃዋሚዎቻሑ ስርም አትገኖዮ፤ ዚም ድፍረታሑ የሕኖ የጥፋተሕኖ ምልክት ቲኸን ያሑም ተእዝጌሬ የኸነ የወትርፋሑ ምልክቱ። <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />ክርስቶስ የዋገልግል ዕድል ያቡኩ በሑቲ ታምኖኸም ጠለለ ቴይኸን በሑቲ መሳ መከራ ትቌበሮኸሙ። <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" />ስለኸነም ኧሗ ቲያጌ መከራ ተሳድኩም፤ ዚም መከራ ተዚ ኢፍቴ ሰላቢም ያዠሑዪ ኧሗም ይሰላቢ ወሕነሑ ትሰሞዪው።<note caller="-" style="x"><char style="xo" closed="false">1፥30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">ሐዋ. 16፥19-40</ref>። </char></note><verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s1">ቁና ቀልብነት ተክርስቶስ ወትማር</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />በክርስቶስ ወብርታታ ባነናሑ፤ በፍቅርመሑ የጥናናሑ በኸነ፤ ተመንፈስ ቅዱስጌ አትነት ባነናሑ፤ ነብስ በነብሳሑም ፈይነት ሜናነትም ባቴዠሑ፤ <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ስለኸነም በአሳብ፤ በፍቅር፤ በመንፈስ፤ በዓላማ ትትስማሞ ብልቃተኛ የትሟላ ይኸንኸም ሰክቶ። <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />በቁና-ቀልብነት ተመላሑም ኧንጐዲ ሰቦች ተአሑ ይጠቅሎኸም ሰክቶም ቆጥሮ አንከንም በነብስ ወውድድ ወይ“ያለ እያ ሟ ነነ” በወበር ወትነነድ አትም ቃር አትሰክቶ። <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />ዛምኸም አትባተሑ የነብሰሑ ጥቅም ጠለል ቴይኸን የንጐዲም ሰብ ጥቅም ያስብ። <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />በዚ ኸማት ኢየሱስ ክርስቶስ ያቴዠን የቁና-ቀልብነት ሜና በአሑም ሕይወት ይነብሬ ይጌባ።<verse eid="PHP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PHP 2:6" />ሑቲ እንጌ የመለኮት አመል ነነን።</para>
  <para style="q2" vid="PHP 2:6">የሕን አንከንም ተእዝጌርጌ ቂጦ ይሸኩቺ</para>
  <para style="q2" vid="PHP 2:6">የመለኮት አመል በግድ የጠበጠኸም አንቆጠረን።<verse eid="PHP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PHP 2:7" />ይልቀሑሽ ያነኒ ክብር እንም ገፈረም</para>
  <para style="q2" vid="PHP 2:7">የጉዙኸም ኸነም ታዠ</para>
  <para style="q2" vid="PHP 2:7">የሰብኸም ተጨኘ፤</para>
  <para style="q2" vid="PHP 2:7">በሰብ አምሳያም ተገለጠ፤<verse eid="PHP 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PHP 2:8" />በቁና ቀልብነት ነብሰሑ አዋረደ፤</para>
  <para style="q2" vid="PHP 2:8">የወሙት ስን፤</para>
  <para style="q2" vid="PHP 2:8">ዛም በመስቀል ᎈር ተሰቀረም ይᎀት ስን</para>
  <para style="q2" vid="PHP 2:8">የታዘዘ ኸነ።<verse eid="PHP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PHP 2:9" />በዚ መሳ እዝጌር ትንም ነን ታነዪ</para>
  <para style="q2" vid="PHP 2:9">የክብር መደር ከፍ አᎄኘን፤</para>
  <para style="q2" vid="PHP 2:9">ተሽም እንም ይበዛዪም ሽም አᎄን።<verse eid="PHP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PHP 2:10" />ስለኸነም የኢየሱስ ሽም ክብር፤</para>
  <para style="q2" vid="PHP 2:10">በሰሜ በአፈርም፤ ተአፈርም ተት ያኖዪ እንም ኸልቀት፤</para>
  <para style="q2" vid="PHP 2:10">በመሌሕኖ ይንብረከኮ።<verse eid="PHP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PHP 2:11" />ባፈሕኖ</para>
  <para style="q2" vid="PHP 2:11">“ኢየሱስ ክርስቶስ ጔታው” ባሮም በወመስክር</para>
  <para style="q2" vid="PHP 2:11">የእዝጌር አብ ክብር ይቦ።<note caller="-" style="x"><char style="xo" closed="false">2፥10-11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">ኢሳ. 45፥23</ref>። </char></note><verse eid="PHP 2:11" /></para>
  <para style="s1">የኰኰብኸም ዋብራ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />ደቦቸኛ! እያ ታሑጌ በነበርኩወ ግዝየ ትታዘዞ የነበርኩኸም፤ ኧሗም ታሑ በራቅኩወ ግዝየ የበዛ ታዛዦች ትኸኖኸም አቴስብኩ፤ ስለኸነም አትባታሑ ወትርፋሑ ፍጡም የወሰክት በጊናት በዋክብርም በርቶም ሠክቶ። <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />እዝጌር ወታዘዝ ያሑ ቲይብ ዓላማውታን ተፍጣሜዬ የዋስላ ባሑ ውስጥ ይሸክት።<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />ሟንም ሜና ብትሸክቶᎄ ግዝየ አታስርጓጉሞ ወይ አትኦግቶ። <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />ዚም በኸነ በዚ በጠማማ በቡሼም ጨኘት ግብት ነውር ነቀፋም ዬነብኩ ንጡ የኸንኩ የእዝጌር ዴንጋ በወሕን በዚ ዓለም የኰኰብኸም ታበሮ።<note caller="-" style="x"><char style="xo" closed="false">2፥15 </char><char style="xt" closed="false"><ref loc="DEU 32:5">ዘዳ. 32፥5</ref>። </char></note> <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />ዚም የኸነዪ ሕይወት ይትረከብወ ቃል ታታቋርጦ አጥብቆም በወጥብጡ፤ በዚ ኸማት ሩጫኛም ኸነ ሜናኛ ኤድገልል ኸነም ኤቌይ ስለኸነ ክርስቶስ ተዠበረም ቢቸኝወ ግዝየ ኧትነነድወ መሳ ይነብሬ ወበሩ።<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />ቢኸንም በእምነታሑ መሥዋዕት አገልግሎትም ይያም ሕይወት መሥዋዕት ኸነም ቢቀርብ ኧትብላለቅ፤ ስርም ኧትብላለቅ። <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />ዛምኸም አሑ ተብላለቅኩም ይያም ብልቃታሑ ኧሰድኸም ትሸክቶኝ።<verse eid="PHP 2:18" /></para>
  <para style="s1">የጢሞቴዎስ የኤጳፍሮዲቱስም አገልግሎት</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />እያ ስላሑ ሐለት በወስማ ኧጥናናነኸም የጢሞቴዎስ አቴክልም ታሑዬ የወላክ ያቸሌኸም በጔታ ኢየሱስ ተስፋ ኧሸክት። <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />ስላሑ ሐለት ተሒን ዬስብ ጢሞቴዎስ አንኸንም ኧንጐድ ሰብ ኤኔ። <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />ኧንጐዲ የፎለሕኖ ጥቅም ጠለል ያሳድዶ አንኸንም ስለ ኢየሱስ ክርስቶስ ሜና ግድ ኤነኖ። <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />ጢሞቴዎስ ታማኝነተሑ ተፌተነም የትምሰኰረነ ወሕነሑ፤ ቲያም ጌ የአብ ተትኸኸም ተገገዝነም ወንጌል በዋትመር ቁናዬ ትንሸክትነ ዋክሰና አሑ ነብሳሑ ቲሒሮ። <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />ስለኸነም ይያ ሐለት ቴቴ ይሰላኸም በትሬዳሑ አንቌ የጢሞቴዎስ ከሞ ታሑዬ ኧለሕንኩኸም ተስፋ ኧሸክት። <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />ስርመሑ እያ ነብሰኛ ከሞ ታሑዬ ወተኝ ኧችልኸም ጔታ ይረዴ ባሑም ኧትመመን።<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />ዛምኸም ይያ ቢያሼ እንም ያግዜኸም ላክሑይም የነበረዪ ጐቤኛ ኤጳፍሮዲቱስ ታሑዬ ወላክ ያሸ ኸነም ረከብኩንም፤ ሑቲ ቲያጌ የሴለፈ ወታደርም የሜና ደቦኛ ኸነም ቲሸክት ዬከሰው። <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />የሑቲ ታሑዬ ኧለኩ እንማሑም የወዥ በወቦርሰሑ አሑም ወታቌሑ በወስማሑ የጨነቀ ስለኸነው። <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />ዮንም ስርም ታቌም ይᎀቴ ተቃረበም ባነ፤ ቢኸንም እዝጌር ምረት ሸኰተነ፤ የሑቲ ጠለለ ቴይኸን አዘን በአዘን ᎈር ኤይድራረብቢኸም ይያም ስን ምረት ሸከተ። <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />ስለኸነም አሑ የሑቲ በወዥ ትትብላለቆኸም ይያም አዘን ይቃለልኒኸም የሑቲ ታሑዬ ኧለኴ ሸሑ። <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />ኧጌሽ በጔታ አማኝ የኸነኸም በብልቃት ተቀበሮይ፤ የሑቲኸም ያኖዪም ሰብ እንም አክብሮዮ። <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />አሑ በቁርቤ ተረከብኩም ትሸክቶኒዬ ያንቻልኩዪ ኧጉዠ ሑቲ የዋሟላ ባረም ስለ ክርስቶስ ሜና የሕይወተሑ ቴሴስት የሞት ቀረበም ባነ።<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s1">የኢኒ ጽድቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />በመጨረሻም ጐባቢተኛ በጔታ ተብላለቆ፤ ዛ ተዚ ኢፍቴ የጣፈክንኩዪ ቃር ዠበርኩም ብንጠፍንኩ እያ አንስለትት፤ ያሑም ተስተት ይቂየሑዬ ይችል። <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />የጊየኸም ቲልክሰክሶ ቡሼም ቲሸክቶ ተቀሮ፤ በባጢል ጤበን ቲያወኖዪ ተቀሮ። <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />ኢና እዝጌር በመንፈስ ናመልክነዪ በውጪ ቢታዥ ሥራት ቴይኸን በኢየሱስ ክርስቶስ ጠለለ ኧትነነድነ ስለኸነ የኢንም ጤበን አወነነም። <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />ወትነነድ ያሸ ቢኸን እያ በብዠ ቃር ኧትነዴ ኧችል፤ በውጪ ቢታዢ ሥራት ይትነነድ ሰብ ቢነብር እያ ተሑቲ የበዛ ኧትነነድወ ብዠ መሳ ነኔ። <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" />እያ በጨኘሑ በስሙት ከነ ጤበን አወነኝም፤ ጨኘተኛም ተብንያም ነገድ የኸነ እስራኤላዊንኩ፤ ተዚም የትነሣ ጥርት የባሑ ዕብራዊ ንኩ። የአይሑድ ሕጊ በወቀየም ቢኸን ፈሪሳዊ ባነሑ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">ሐዋ. 23፥6</ref>፤ <ref loc="ACT 26:5">26፥5</ref>፤ <ref loc="ROM 11:1">ሮም 11፥1</ref>። </char></note> <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" />ስለኦሪት ሕጊ በወቅና ቢኸን የቤተ ክርስቲያን አማኞች አሳድድ ባነ። ሕጊ በወቀየ ወጽድቅም ቢኸን ፍርየ ኤባን ነቀፋ ኧነብር ባነሑ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8፥3</ref>፤ <ref loc="ACT 22:4">22፥4</ref>፤ <ref loc="ACT 26:9-11">26፥9-11</ref>። </char></note> <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />ኧጌሽ ተዚ ኢፍቴ ይጠቅሞኖ ባሑም አምንቦ የነበሮዪ ቃሮች እንም የክርስቶስ ባሑም ዋጋ ዬነኖኸም ኤድገልሎ ሸከትኩም ኧቆጥሮ። <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />ተዚ አንከንም ጔታኛ ኢየሱስ ክርስቶስ ተወሐር የበዛ እንጐድ አትም ቃር ዬነኸም አምን ስለኸነ እንም ቃር የኪሳራኸም ኧቆጥር፤ ስለሑቲም እንም ቃር ቀበጥሑም። ክርስቶስም የወርክብ ትንብር እንም ቃር የቤት ጥራጊኸም ኧቆጥር። <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />ዚም ኧሸክትወ መሳ በሕግ ᎈር የትምሠረተ የነብሰኛ ጽድቅ ገፈርኩም በእምነት ᎈር የትምሠረተ የእዝጌር ጽድቅ በክርስቶስ በወምን ኧርክቤ ተሑቲምጌ የወሕኑ። <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />ኧንጐዲ መሳ ክርስቶስ የክርስቶስም የትንሣኤ ቆት የወሐር፤ መከራውታ ኧሰዴ በሞተሑም ሑቲ የወምስሩ። <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />ዛምኸም በᎀትኩ አንቌ ተነሣሑም የዘለዓለም በሕይወት የወንብር ተስፋ በወሰክቱ።<verse eid="PHP 3:11" /></para>
  <para style="s1">ተዓላማዬ የወስላ ወሮጥ</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />ዚ እንም ገና አረኸብኩ፤ ወይ በዛ እንም ፍጡም ኸንኩም የወበር አንችል፤ የሕን አንከንም ኢየሱስ ክርስቶስ ይያ የሑቲ ሸከተም ያዝጓጀኒዪ ሽልማት የወርክብ ቲፍቴዬ በወሩጥ ኧትጋደል። <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />ጐባቢተኛ! ገና ተዛዬ የሰላሑኸም አንቆጥር፤ ቢኸንም ቁና ቃር ኧሸክት፤ ዚም ታንቌኛዬ ያነዪ ረሳሑም ቲፍተኛ ያነዪ የወጥብጥ ኧትጋደል። <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />ሽልማተኛም የወርክብ ቢፍተኛ ታነዪ አላማኛዬ ኧሮጥ፤ ዚም ሽልማት እዝጌር በኢየሱስ ክርስቶስ መሳ ተነኔ ጠራም ይቤ ሕይወቱ።<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />ኧጌሽ በመንፈሳዊ ሕይወት የቆመርነ እንም ዚ የመሰረ አስተሳሰብ ይነብርነዬ ይጌባ፤ ባታት ቃር የትልያየ አስተሳሰብ ቢነብርሑ፣ ዚም አሳብ እዝጌር ግልጥ ይሸክትንኩ። <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />ዛም ኸነ ዚ ኧሗ ስን በሰላነᎄ መንፈሳዊ ሕይወት ንዥባበርነ።<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />ጐባቢት! ይያ ምሳሌ የወትኸተል ተገገዞ፤ ይናም ምሳሌ ይትዄተሎዪ እንም ልብ በሮም ተመልከቶ።<note caller="-" style="x"><char style="xo" closed="false">3፥17 </char><char style="xt" closed="false"><ref loc="1CO 4:16">1 ቆሮ. 4፥16</ref>፤ <ref loc="1CO 11:1">11፥1</ref>። </char></note> <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />ተሗ ኢፍቴ ብዠጌ ዬወደኩሑኸም ኧሗም ኢንባኛ ትናፈስ ኢውዱሑኸም እንም ብዠ ሕኖ በኑሮሕኖ የክርስቶስ መስቀል መሶ ኸኖም። <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />የሕኖ አምላክ ደነሕኖው፤ ያትማልል የኸነ ቃር የሕኖ ክብረሕኖው፤ አሳበሕኖም አፈራዊው፤ ስለኸነም የሕኖ መጨረሻ ጥፋቱ። <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />ኢናም የሰሜ መንግሥት ዜጋ ንነ፤ በዛም ይቸኚ ያተርፍ ጔታና ኢየሱስ ክርስቶስ በቡርሻት ኧቂየነ። <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />ሑቲ ዚ የትዋረደዪ ገገና በወሰግር የሑቲ የከበረ ገግ ይመስርኸም ይሸኩች፤ ዚም ይሸክት ይንም በሥልጣነሑ ተት የወሰክት ቢያቸል ቆቱ።<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s1">የጳውሎስ ምክር</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />ኧወዱሑዪ ኧቦርስኩዪም፥ የብልቃተኛ የሜናኛም አክሊል የኸንኩ ጐባቢተኛ! በጔታ ጥኖም ቁሞ።<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />ኤዎድያ ሲንጤኪም ነብስ በነብሰሕነማ በጔታ ተስማመማም ይነብረማኸም ኧጮቅሰማ። <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />አኸም በዛዬ ያነኸዪ ታማኝ የሜና መራርቻኛ ነዚ እንሽታ ታግዘማኸም ኧጮቅስከ፤ ነዚ እንሽታ ቲያጌ ተቀሌምንጦስ ሽመሕኖ በሕይወት መጽሐፍ ተጣፎዪ ትንጐዲ የሜና መራርቻኛጌ በወሕን ወንጌል በዋስላ ተጋደለማም።<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />እንጌ በጔታ ተብላለቆ፤ ኧሗም “ተብላለቆ!” ኧብር።<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />ፈይነታሑ በሰብ እንምሜ የትኴረ የሕን፤ ጔታ ተዠበረም ይቸኜ ቀረበም፤ <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />ስለኸነም ይንም ቃር በጠሎት በጩቈሸ በምስጋናም የእዝጌር አቅርቦ አንኸንም ያትም ቃር አትጨነቆ። <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />ተሰብ ዋጥራምት እንም ነን የኸነዪ የእዝጌር ሰላም ሒናሑ አእምሮአሑም በኢየሱስ ክርስቶስ ይቅየ።<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />አእምሮአሑ ተዚሕኖ እንም ቢበዞዪ ቢያትምሴግኖዪም ፈያ ዘንጋ የትᎀላ የሕን፤ በመጨረሻም ጐባቢት! የኢነተኘ፥ ክብር፥ ሱት፥ ንጡ፥ ያትብላልቂ ምስጉንም የኸኖ ቃሮች እንም አስቦ።<verse eid="PHP 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 4:9" />ቢያ የትማርኩዪ የቌበርኩዪም፤ የሰማሑዪም ያዠሑዪ እንም ሰክቶ፤ የሰላም አምላክ ታሑጌ ይኸን።<verse eid="PHP 4:9" /></para>
  <para style="s1">ጳውሎስ በላሑነ ስጦታ ዋመስግነሑ</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />ተብዠ ግዝየ አንቌ ዠበርሑም ይያ ምካት ዋስብ በወቅርሳሑ በጔታ ወደል ብልቃት ይሴሜ፤ ዚም ትንብር ዬሰብኩዪ በሜና የዋተዥ ፈያ አጋጣሚ አረኸብኩ ባነ ወበረኛው አንኸንም ይያ ምካት ዋስባሑ አቋረጥኩም ወበረኛ አንከነ። <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />ኧሗም ዚ ኧብር የኑሮኛ ያሼዪ በወቅብጠኛ አንከነ፤ እያማ “ያኔ ቃር ያሰሌ” ወበር ተማርኩም። <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />ስለኸነም ወርክብ ኸነ ወቅብጥም ኧሒር፤ በሟንም መደር ኸነ ቤቲዋኘም ግዝየ የወጡፍ የወትጋድም፤ የወርክብ የወቅብጥም ምሥጥር ተማርኩም። <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />ቆት ቢይቤ በክርስቶስ እንም ቃር ወሰክት ኧችል።<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />የሕን አንኸንም አሑ ምካተኛ ትሰዶ ኸንኩም በወትረኸባሑ ፈያ ሸከትኩ። <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />ተዚ እንጐድ ወንጌል የዋብሥር በቀረስኩወ ግዝየ ተመቄዶንያ ትንወጣ ተአሑ በፊልጵስዩስ ቲትረከቦዪ ቤተ ክርስቲያን አንኸንም በዋብም ኸነ በወቀበር ቲያጌ የትገገዘ እንጐድ ማመረ ምእመናን ያነበረኸም አሑ ነብሳሑ ቲሒሮ።<note caller="-" style="x"><char style="xo" closed="false">4፥15-16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 ቆሮ. 11፥9</ref>። </char></note> <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" />በተሰሎንቄም ምካት የሰላቢኸም ሐርኩም ዥባበርኩም እርዳታ ላክሑኒም።<note caller="-" style="x"><char style="xo" closed="false">4፥16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">ሐዋ. 17፥1</ref>። </char></note> <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />ዚም ትንብር ያሑ ስጦታ የወርክብ በወሴ ቴይኸን የልግሥናሑ ፍርየ ይበዛንኩኸም በዋላው። <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />ያሼዪ ቲያትኬሼዪም ነን የላክሑኒዪ ስጦታ ተኤጳፍሮዲቱስ ኧጅ ተቌበርኩም፤ ዚም የአሑ ስጦታ በፈያ መዓዛ የትᎀላ መሥዋዕት እዝጌር ይቌᎄሪ ይትብላለቅወው።<note caller="-" style="x"><char style="xo" closed="false">4፥18 </char><char style="xt" closed="false"><ref loc="EXO 29:18">ዘፀ. 29፥18</ref>። </char></note> <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />ስለኸነም አምላከኛ ተክብረሑ ዱሬሽነት በኢየሱስ ክርስቶስ መሳ ያሸሑዪ እንም ይብኩ። <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />የአባና የአምላከና ተዘልዓለም ተዘለዓለም ስን ክብር የሕን፤ አሜን።<verse eid="PHP 4:20" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />የምእመናን እንም በኢየሱስ ክርስቶስ ሰላምታ አቅርቦኒ፤ ቲያምጌ ያኖዪ ጐባቢት ሰላምታ ያቀርቦንኩ። <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />ቅዱሳንም እንም በተለይም ቄሣር አበሮስ የኸኖዪ ጐሣዎች ሰላምታ ያቀርቦንኩ።<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />የጔታ የኢየሱስ ክርስቶስ ጸጋ ታሑጌ የሕን፤ አሜን።<note caller="+" style="f"><char style="fr" closed="false">4፥23 </char><char style="ft" closed="false">ዚም አታት ቅጂዎች አሜን ይብሪ ኤደብር። </char></note><verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>