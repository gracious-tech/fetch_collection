<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">Mesqan New Testament PHILEMON</book>
  <para style="h">ተፊልሞናዬ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተፊልሞናዬ</para>
  <para style="toc2">ተፊልሞናዬ</para>
  <para style="toc3">ፊል.</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተፊልሞናዬ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ፊልሞና የትኴረ ክርስቲያን ባነ፤ የቆላስይስ ቤተ ክርስቲያን አባል የነበረኸም ይጌሙቺ። ፊልሞና ኦኔሲሞስ ይቡሪ ጉዙ ቧነን፤ ዚም አገልጋይ ተጌቶቸሑ ሰኴም በወረወ ግዝየ በወሕኔ ቤት ተነበረዪ ተጳውሎስጌ ሩሕቦ ሸከተ፤ በጳውሎስም መሳ ኦኔሲሞስ የክርስትና እምነት ተቌበረ፤ ጳውሎስ ተፊልሞናዬ የጣᎈን መልክት ፊልሞና ተዠበረም ተሑቲዬ በወተኝ ᎈር ታነዪ ተአገልጋየሑጌ ይታረቅኸም ያቴስብ ባነ፤ ዠበረም ኦኔሲሞስ ክርስቲያን ስለኸነ ተሗ ቀረሰም የክርስቲያን ጐቤኸም ይቌᎄርኸም አንኸንም የጉዙኸም ኤይቆጥርኸም ይውጅ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="PHM 1:1-3">1-3</ref> </char></para>
  <para style="io1">የጳውሎስ ምስጋናኸ የፊልሞና <char style="ior"><ref loc="PHM 1:4-7">4-7</ref> </char></para>
  <para style="io1">ጳውሎስ የኦኔሲሞስ ያቀረᎄኒ አጠበቀም በወጮቅስ <char style="ior"><ref loc="PHM 1:8-22">8-22</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="PHM 1:23-25">23-25</ref> </char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />የኢየሱስ ክርስቶስ ኧጉጀኘ ተኸንኩ ቲያ ተጳውሎስ ተጐቤና ተጢሞቴዎስም፥</para>
  <para style="p" vid="PHM 1:1">የወጀጂዪ ጐቤና የሜና መራርቻና የኸነዪ የፊልሞና፥ <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />የተመና የአፍብያ፥ ቲናጌ የክርስቶስ ወታደር የኸነዪ የአርኪጳስ፥ ዛምኸም በቤታኸ ይስበሰቦዪ ምእመናን።<note caller="+" style="f"><char style="fr" closed="false">1፥2 </char><char style="fqa" closed="false">“በቤታኸ ይስበሰቦዪ ምእመናን”፦ </char><char style="ft" closed="false">በግሪኪ “በቤታኸ ይትረከቢ ቤተ ክርስቲያን” ይብር። </char></note><note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆላ. 4፥17</ref>። </char></note><verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />ተአባና ተእዝጌር፥ ተጔታናም ተኢየሱስ ክርስቶስ ጸጋ ሰላምም ያሑ የሕን።<verse eid="PHM 1:3" /></para>
  <para style="s1">የፊልሞና ፍቅር እምነትም</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />በጠሎተኛ ያኸ ትኔስብከ እንጌ አምላከኛ አምሰጉን፤ <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />በጔታ በኢየሱስ ያነናኸ እምነት የምእመናንም ያነናኸ ፍቅር ሰማሑም፤ <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />የክርስቶስ በወሕነና ያነነ ፈያ ቃር እንም ቢልቢጢጦ ይትኴርኸም እምነታኸ ይንጐዲ የወሳድ ትጋደልኸም ኧጤልይ። <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />ጐቤ! በአኸ መሳ የምእመናን ሒን የቴደሰ ስለኸነ ፍቅራኸ ወደል ብልቃት ወጥናና አቤም።<verse eid="PHM 1:7" /></para>
  <para style="s1">ጳውሎስ የኦኔሲሞስ ያቀረᎄኒ ዋማልድ<note caller="+" style="f"><char style="fr" closed="false">1፥8 </char><char style="ft" closed="false">ምልጃ፦ ወበር ዋማልድ ቲኸን ትርጉመሑም አቆᎀሪም ወጮቅስ ወበሩ</char></note></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />ስለኸነ ወሰክት ይጌባኸ ትሸክትኸም ኤዝዝከዬ በክርስቶስ ድፍረት ቢነብሬም፤ <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />ቢኸንም ዛምኸም ተወሰክት ይጠቅል የኢየሱስ ክርስቶስ ኧጉጀኘ የኸንኩ እያ ባሊቂ ጳውሎስ በፍቅር ወጮቅስ ኧሜጥር። <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />እያ በወሕኔ ቤት ትናነሑ ትኸኛ ስለኸነዪ የኦኔሲሞስ ያኸ ኧጮቅስከ።<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆላ. 4፥9</ref>። </char></note> <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />አናሲሞስ ተዚ ኢፍቴ ኤይጠቅምከ ባነ፤ ኧሗም ያኸም ኸነ ይያ ጠቃሚው።<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />ዘ የሑቲ ታኸዬ ዠበርኩም ላክሑንም፤ የሑቲ ታኸዬ ትንለኩም የነብሰኛ ሒን የላክሑኸም ሸከትኩም ኧቆጥር። <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />በወንጌል መሳ በዚዬ ኧጉጀኘ ትናነሑ ባኸ ሟኔ ኸነም ያግለግሌኸም ሑቲ ቲያጌ ቢኸን በትብላለቅኩ ባነ፤ <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />ቢኸንም ያኸ ፈያ ሜና በግዴታ ቴይኸን በውዴታ ይኸንኸም ባሑም ያኸ ታናትፌቅድ አትም ወሰክት አንሸሑ።<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />ኦኔሲሞስ ኧሗ ስን የቀል ግዝየ የትላኘናኸ ምናልባት ተሗ ቀረሰም ይንጌ ታኸጌ ይነብሬ ይኸን። <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />ተሗ ቀረሰም ታኸጌ ይነብሪም የጉዙኸም ቴይኸን ተጉዙ የበዛ ኸነም የውድ ጐቤኸሙ፤ ሑቲ ይያ ውድ ጐቤው፤ የሕን አንከንም የሰብኸም ሑቲ በአገልግሎተሑ ይጠቅመኸ ስለኸነ በመንፈሰሑ ኧሗም በክርስቶስ ጐቤያኸ ስለኸነ ያኸ የጠቀለ ተወዳጁ።<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />ኧጌሽ ይያ የጐቤኸም ሸከትከም በቆጠርኬ ልክ ይያኸም ሰክትም ተቀᎄር። <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />ያሰላብከ በደል ቢነብርም ኧድጉት ቢነብርወ ኧድጉተሑ ቢያ ᎈር ሰኩች። <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />ዘ እያ ጳውሎስ “እድጉተሑ ኧከፍልከ” ባሑም በነብሰኛ ኧጅ ጣፍኩም አርጋግጥንከ፤ ቢኸንም የሕይወታኸ አኸ ነብሳኸ ይያ ባለእድጉት ወሕናኸ እያ አስታውስከዬ ኤያሸ። <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />በይሽ ጐቤኛ ዚ ፈያ ቃር ትሸክትኒኸም በጔታ ኧጮቅስከ፤ ታውሽ ሒነኛ በክርስቶስ አድስኒ።<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />ዚ የጣፍኩንከ ትታዘዜኸም በወትማመኑ፤ ዛምኸም እያ ትንሰልከ ነን ትሸክትኸም ኧሒር። <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />በዛም እዝጌር ጠሎታሑ ሰማም ታሑዬ ኧቸኝኸም ይሸክቴኸም ተስፋ ስላኔ አᎈይወ ቤት አዝጋጅኒ።<verse eid="PHM 1:22" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />በኢየሱስ ክርስቶስ መሳ ቲያጌ ኧጉጀኘዪ ኤጳፍራ ሰላምታ ያቀርብንከ፤<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆላ. 1፥7</ref>፤ <ref loc="COL 4:12">4፥12</ref>። </char></note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />ዛምኸም የሜና መራርቻኛ የኸኖዪ ማርቆስ፥ አርስጥሮኮስ፥ ዴማስ ሉቃስ ሰላምታ ያቀርቦንከ።<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሐዋ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>፤ <ref loc="ACT 15:37-39">15፥37-39</ref>፤ <ref loc="ACT 19:29">19፥29</ref>፤ <ref loc="ACT 27:2">27፥2</ref>።</char></note><verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />የጔታ የኢየሱስ ክርስቶስ ጸጋ ታሑጌ የሕን፤ አሜን።<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>