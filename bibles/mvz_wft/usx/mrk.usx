<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">Mesqan New Testament</book>
  <para style="h">የማርቆስ ወንጌል</para>
  <para style="toc1">ማርቆስ የጣᎈን የጔታና የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="toc2">የማርቆስ ወንጌል</para>
  <para style="toc3">ማር.</para>
  <para style="mt">ማርቆስ የጣᎈን</para>
  <para style="mt2">የጔታና የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የማርቆስ ወንጌል “ዚ የእዝጌር ትኸ የኢየሱስ ክርስቶስ የምሥራች ቃል መጀመሪያው” በወበር ይትነሣ፤ በዚ ወንጌል ውስጥ ኢየሱስ የሜና የሥልጣንም ሰብ በወሕን ቀረበም፤ ሥልጣነሑም በትምርተሑ፥ በአጋንት ᎈር ቧነን ቆትም፥ የሰብ አጢአት አፉታ በወበረሑ ታዠም። ኢየሱስ “የሰቦቺ በአጢአት ጉዙነት ነጣ በዋውጣ የሕይወተኛ ሟኔ ሸከትኩም የዋብ የቸኘሑ የሰብ ትንኩ” በወበር ነብሰሑ ዝነጔም።</para>
  <para style="ip">ማርቆስ የኢየሱስ ታሪክ ያቀረᎄን፥ በሱት ቆት በትᎀላ ኤማ ቲይኸን የታዠ በኢየሱስ ቃልም ትምርት ᎈር ቴይኸን በሸከተኖ ድንቅ ሜናዎች ᎈር ባነ። የመጥምቂ ዮሐንስ ታሪክ፥ የኢየሱስ ጥምቀትም ፈተና ኧጠር የባረ ይቈርሽᎄ ባበ አንቌ ጠሐፊዪ ስለ ኢየሱስ የዋትመርም ፈያ የወሰክት አገልግሎት ያፉታታን። በግዝየሑ አንቌ የኢየሱስ ይትዄተሎ የኢየሱስ በጠቀለ ሐለት ቲይሒሮ በወሮ ቅጫ የኢየሱስ ይቃወሞዪም የበዛ ቲጠሎይ ወሮ። የመጨረሻዎቺ ምራፎች በኢየሱስ ሕይወት በመጨረሻዪ ሳምት ውስጥ ስለትፌጠሞዪ ሜናዎች በተለይም የስቅለተሑም ስለትንሣኤየሑ ይቴርኮኖ።</para>
  <para style="ip">በወንጌሊ መጨረሻ ᎈር በቅንፍ የትምሌከቶዪ ዄት ክፍል ባታት ቅጂዎች ጠለለ ይትረከቦኖ።</para>
  <para style="iot">እንመሑ የመጠሐፊ አሳብ</para>
  <para style="io1">የወንጌሊ መጀመሪያ <char style="ior"><ref loc="MRK 1:1-13">1፥1-13</ref> </char></para>
  <para style="io1">ኢየሱስ አገልግሎተሑ በገሊላ ወቅርሰሑ <char style="ior"><ref loc="MRK 1:14-9:50">1፥14—9፥50</ref></char></para>
  <para style="io1">በኢየሩሳሌም ዋገልግለሑ <char style="ior"><ref loc="MRK 10:1-52">10፥1-52</ref> </char></para>
  <para style="io1">በኢየሩሳሌም በጭጭሳዪም የመጨረሻ ሳምት <char style="ior"><ref loc="MRK 11:1-15:47">11፥1—15፥47</ref></char></para>
  <para style="io1">የጔታ ትንሣኤ <char style="ior"><ref loc="MRK 16:1-8">16፥1-8</ref> </char></para>
  <para style="io1">ተሞት የትነሣዪ ጔታ መገለጥም ዋርገሑ <char style="ior"><ref loc="MRK 16:9-20">16፥9-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s1">የመጥምቂ ዮሐንስ ስብከት</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቴ. 3፥1-12</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፥1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሐ. 1፥19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />የእዝጌር ትኸ<note caller="+" style="f"><char style="fr" closed="false">1፥1 </char><char style="ft" closed="false">አታት ቅጂዎች “የእዝጌር ትኸ” ይብሪ ቃል ኤይደብሮ። </char></note> የኢየሱስ ክርስቶስ ወንጌል መጀመሪያ፤ <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />በነብዪ ኢሳያስ እኪ ቧሪም ተጣፈም፤</para>
  <para style="q1" vid="MRK 1:2">“ዘ፥ ኤማኸ ያዝጋጅ</para>
  <para style="q2" vid="MRK 1:2">ሉኸተኘኛ ቢፍታኸ ኧለክ፤<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፥1</ref>። </char></note><verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />‘የጔታ ኤማ አዝጋዶ፤</para>
  <para style="q2" vid="MRK 1:3">የጠረጒዪም አስትካክሎ ቲብር</para>
  <para style="q2" vid="MRK 1:3">በበረሓ ከፍ አበኘም ይዝነግ ሰብ ጣምባ’።”<note caller="-" style="x"><char style="xo" closed="false">1፥3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፥3</ref>። </char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />ስለኸነም መጥምቂ ዮሐንስ በበረሓ ቲያጠምቅም “ያጢያት አፉታ የንስሐ ጥምቀት” ቲሰብክ ቸኘ። <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />የይሑዳ ገኝ እንም፤ የኢየሩሳሌም ሰቦች እንመሕኖ ተሑቲዬ በወወር አጢያተሕኖ በወትናዘዝ በዮርዳኖስ ኧዲየ በዮሐንስ ኧጅ ተጠመቆ። <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />ዮሐንስ የጋሜላ ድገር ይለብስ፤ በጊንዠሑም ጠፍር ኧጉጀኘ ይኸን ባነ፤ አንበጣ የጣዝማ ውየም ይበራ ባነ።<note caller="-" style="x"><char style="xo" closed="false">1፥6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ነገ. 1፥8</ref>። </char></note> <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />እኪም ይብር ባነ፦ “የጫማውታን ክር ሙግ ባሑም የወፍታ ኤይጌቤ ቲያ ስርም ይበዛ ቲያ አንቌ ይቸኝ፤ <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />እያ በኧጋ አጠምቁሑ፤ ሑቲም በመንፈስ ቅዱስ ያጠምቁሑ።” ይብር ባነ።<verse eid="MRK 1:8" /></para>
  <para style="s1">የኢየሱስ ወጠመቅ ወትፈተንም</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቴ. 3፥13-17</ref>፤ <ref loc="MAT 4:1-11">4፥1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፥21-22</ref>፤ <ref loc="LUK 4:1-13">4፥1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />በዛ ግዝየ ኢየሱስ የገሊላ ከተማ በኸነዪ በናዝሬት ቸኘም በዮርዳኖስ ኧድየ በዮሐንስ ኧጅ ተጠመቀ። <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />በኧጋዪ ቢወጣወ ግዝየ፤ ሰሜ ተከፈቶም፤ መንፈስ ቅዱስ የቡላልኸም በሑቲ ᎈር ቲወርድ አዠ። <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />“ኧወድኸ ትኸኛ አኸትንከ፤ ባኸ ኧትብላለቅ” ይብር ጣምባ በሰሜ ቸኘ።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዘፍ. 22፥2</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 3:17">ማቴ. 3፥17</ref>። </char></note><verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />ሒንጌም መንፈስ ቅዱስ ተበረሐዬ ᎀራን። <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />በሼጣንም ቲትፌተን አርባ ከነ በበረሐ ኤከሰ። ተድብር አውሬጌ ባነ፤ መላይካም አግለገሎይ።<verse eid="MRK 1:13" /></para>
  <para style="s1">የመጀመሪያዎቺ ደቀ መዛሙርት ወትመጠር</para>
  <para style="r">(<ref loc="MAT 4:14-17">ማቴ. 4፥14-17</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4፥14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />ዮሐንስ በወሕኔ ቤት በገባ አንቌ፤ ኢየሱስ የእዝጌር ወንጌል ቲሰብክ ተገሊላዬ ወረም፤ <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />“ግዝየዪ ሰላም፤ የእዝጌር መንግሥት ቀረበም፤ ንስሐ ግቦ! በወንጌልም እምኖ” ቲብር ይሰብክ ባነ።<note caller="-" style="x"><char style="xo" closed="false">1፥15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቴ. 3፥2</ref>። </char></note><verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />ኢየሱስ በገሊላ ባር ᎀረ ቲቸለፍ፤ ስምዖንም ጐቤች እንድርያስ ዓሣ ያጠምዶ የነበሮ ስለኸነ፤ መረብ ተባሬ ቲያድጎ አዠኖ። <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ኢየሱስም፤ “ኔሑ ተኸተሎኝ፤ ሰቦቺም ትስበስቦኒኸም ኧሸክትኩ” ባረኖ። <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />ሕኖም ሒንጌም መረበሕኖ ገፈሮም ተዄተሎይ።<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />ቀል በቸለፈኸም፤ የዘብዴዎስ ትኸ ያዕቆብ ጐቤች ዮሐንስም በጀልባ ኸኖም መረበሕኖ ቲያዝጋዶ አዠኖም፤ <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />ኢየሱስ ሒንጌም ጠራኖ። ሕኖም አባሕኖ ዘብዴዎስ ተቈጠርዮ ሜነተኞቸሑጌ በጀልባዪ ᎈር ገፈሮይም ተዄተሎይም ወሮ።<verse eid="MRK 1:20" /></para>
  <para style="s1">ኢየሱስ ሩክስ መንፈስ አትዌጣ</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4፥31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />በዛም አንቌ ተቅፍርናሖም ከተማዬ ወሮ፤ ኢየሱስም ሒንጌም በሰምበት ከነ የአይሑድ ጠሎት ቤት ገባም ዋትመር ቀረሰ። <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />የሕጊ አስተማሪኸም ቴይኸን፤ የባለስልጣንኸም በዋትመረሑ ሕዝቢ በትምርተሑ ተጌረሞ።<note caller="-" style="x"><char style="xo" closed="false">1፥22 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">ማቴ. 7፥28-29</ref>። </char></note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />በዛ ግዝየ በአሑድ ጠሎት ቤተሕኖ ውስጥ የነበረ ሩክስ መንፈስ ያነወ አት ሰብ እኪ በወበር ው ባረ፤ <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“የናዝሬቲ ኢየሱስ፤ ቢና መአር ትሸ? ታጠፋነዬ ቸኘኸ? እያ ሟ የኸንከኸም ኧሒር፤ አኸ የእዝጌር ቅዱስንከ።”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ኢየሱስም፤ “እንቁስ በር፤ ተሑቲም ውጣ!” ባረም ጔሠጠን። <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />ሩክሲም መንፈስ የምሲ በወኸርድድ ባደጐን አንቌ ው ቲብር ወጣ። <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />ሕዝቢ እንም በወገረም፤ “ዚ ዘንጋ መአሩ? ሥልጣን ያነን ገደር ትምርት ወሕነሑ! የሩኩሲ መናፍስቲ ቴይቀይ ዬዝዝ፤ ሕኖም ይታዘዞነ!፤” ቲብሮ ነብስ በነብሰሕኖ ተሰሰሎ። <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />ሒንጌም ዝናሑ በገሊላ ዙራ ባኖዪ መደሮች እንም ተሳላ።<verse eid="MRK 1:28" /></para>
  <para style="s1">ኢየሱስ ብዠሕኖ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቴ. 8፥14-17</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፥38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ሒንጌም በአይሑድ ጠሎት ቤት ወጣም፤ ተያዕቆብ ተዮሐንስጌ ተስምዖን ተእንድርያስም ቤቴ ገባ። <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />የስምዖን ዐማት በፉላ ባሸ ታቌችም ተገደረችም ባነ፤ ስለ ሒቲ የኢየሱስ ኤወዶይ። <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />ስለኸነም ኢየሱስ ተገደረትወዬ በወወር እጄታን ጠበጠም ነሳና፤ ፉላዪም ገፈረና፤ ተነሳችም ታግለግሎ ቀረሰ።<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />ጬት በቡየ አንቌ፤ በምሳር ግዝየ የጭጭሳዪ ሰቦች የታቆዪ በአጋንት የጠበጦዪም እንም ተኢየሱሴ አቸኖ። <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />የከተማዪ ሕዝብ እንም በቤቲ ወረጀ ተስበሰቦም ባነ። <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ኢየሱስ በትልያየ ባሸ የታቆዪ ብዠሕኖ ፈያ ሸከተ፤ ብዠ አጋንትም አወጣ፤ ቢኸንም አጋንቲ የኢየሱስ ሟ የኸነኸም ይሒሮ የነበረ ስለኸነ ይዝነጎኸም አፈቀደኖ።<verse eid="MRK 1:34" /></para>
  <para style="s1">ኢየሱስ ሰብ ቤነወ መደር ጤለየ</para>
  <para style="r">(<ref loc="LUK 4:42-44">ሉቃ. 4፥42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ሱቢም ገና ጬት ቴይወጣ፤ ኢየሱስ ተነሣም በቤት ወጣ፤ ታት ሰብ ቤነወ መደሬ ወረም ይጤልይ ቀረሰ። <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />ስምዖንም ተሑቲጌ የነበሮዪም ተዄተሎም ይሸዎይ ቀረሰ። <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />በረከቦይም ግዝየ፤ “ሰብ እንም ይሽዎከው” ባሮይ።<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ኢየሱስም፦ “በዚ ተነሳነም በቁርቤ ታኖዪ መንደሮቼ ንወርነ፤ በዛዬም ንስበክ፤ የቸኘሑ የዚቱ” ባረኖ።<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />ስለኸነም በአይሑድ ጠሎት ቤተሕኖ ገባም በወስብክ አጋንት በዋውጣም ብንም ገሊላ ይዥዋወር ቀረሰ።<note caller="-" style="x"><char style="xo" closed="false">1፥39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቴ. 4፥23</ref>፤ <ref loc="MAT 9:35">9፥35</ref>። </char></note><verse eid="MRK 1:39" /></para>
  <para style="s1">ኢየሱስ የለምጣሚ ሰብ አነጣ</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቴ. 8፥1-4</ref>፤ <ref loc="LUK 5:12-17">ሉቃ. 5፥12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />አት ለምጣም<note caller="+" style="f"><char style="fr" closed="false">1፥40 </char><char style="fk" closed="false">ለምጣም፦ </char><char style="ft" closed="false">የመጽሐፍ ቅዱስ አገላለጥኸም፥ በጅስም ᎈር ይታዥ የትልያየ ኸማት ይችላለፍ የጎጋ ባሸ እንም ያምለክት። </char></note> ተኢየሱሴ ቀረበም ቢፍተሑ ተምብረከከም፤ “ብትፈቅድሽ ታነጤዬ ትችል፤” በወበር ጮቈሰን።<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />ኢየሱስም የምሲ በወራራ ኧጀሑ ዝረጋም ሙሻሸንም “ፈቀድኩም፤ ንጣ!” ቧረን። <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />ሑቲም ሒንጌም ተለምጠሑ ነጣ፤ ተባሸሑም ፈያ ኸነ። <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />ኢየሱስ የምሲ በዋቆምር አጥኔቀቀም እኪ ቲብር ጔጐተን፤ <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“የሟንም አት ቃር አትዝነግኸም ተቀየ፤ ቢኸንም ምስክር ይኸንቦኸም ወርም ራሳኸ የካሕን አተዥ፤ የነጣኸ ስለኸነ ሙሴ ዬዘዘኒ መስዋዕት አቅርብ፤” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">1፥44 </char><char style="xt" closed="false"><ref loc="LEV 4:1-32">ዘሌ. 4፥1-32</ref>። </char></note><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />ምሲም በዛ በወረወ መደር እንም ዘንጋዪ በሰፊ ዝነጔ፤ ኦጀዪም ወዘንግ ቀረሰ። በዛ መሳ ኢየሱስ ተሟንመሕኖ ከተማዬ በግልጽ ወግባ አንቻለን፤ በዛም የትነሣ ተከተማ ውጪ ቢትረከቦዪ ሰብ ቤነወ መደር ይነብር ባነ፤ ቢኸንም ሰቦች አቅጣጫ በአቅጣጫሑ ሑቲ ታነወዬ ወተኝ አናቋረጦ።<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s1">ኢየሱስ ጅረዪ ሰብ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MAT 9:1-8">ማቴ. 9፥1-8</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5፥17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />ኢየሱስ ተቀል ከነ አንቌ ተቅፍርናሖሜ ተዠበረም ቸኘ፤ በዛዬ በቤቴት ውስጥ ወሕነሑ ተሴማ። <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />ስለኸነም በወረጀዪ ውጪ ቴይቀይ መደር ይቀቡጪ ስን ብዠ ሕዝብ ተስበሰበ፤ ሑቲም የእዝጌር ቃል ሰበከኖ። <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />በዛ ግዝየ አርበት ሰብ ቁና ጅረ ሰብ ጮሮም ተሑቲዬ ቸኖ። <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />ተሕዝቢ ብዛት የትነሣ ኢየሱስ ታነወዬ ወቅርብ ያንቻሎ ስለኸነ፤ የቤቲ ቁሬት ሑቲ ባነወ አዘር ከፈቶም ጉድ በዋዝጋጅ ጅረዪ የገደረወዪ አልጋ በዛ አወረዶ። <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />ኢየሱስም እምነተሕኖ አዠም የጅረዪ፤ “አኸ ትኸ፤ አጢአታኸ ተሴረዘንከም!” ቧረን።<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />በዛዬ ቾኖም የነበሮዪ አታት የሕጊ አስተማሪዎች ስለኸነዪ ዘንጋ በሒነሕኖ ቲያስላስሎ፤ <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“ዚ ሰብ ምንኸም እኪ ይብር? በአምላክ ᎈር የስድብ ቃል ይዝነጉ እኮ! ታቲ እዝጌር አንከንም ሟ አጢያት ይሴርዜ ይችል?” ባሮም ኤሰቦ።<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ኢየሱስም ሒንጌም በሒነሕኖ ዬስቦዪ በመንፈሰሑ ተሬዳም፤ “ምንኸም እኪ ቴስቦ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />የጅረዪ፤ ‘አጢአታኸ ተሴረዘንከም’ ተወበርም፤ ‘ተንሣም አልጋኻ ጮርማኸ ወር!’ ተወበር ኤተሑ ይጠቅል? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />ቢኸንም የሰብ ትኸ ባፈር ᎈር አጢያት የወሰርዝ ስልጣን ያነንኸም ቲሒሮኸም” በወበር የጅረዪ፤ <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />ኧብርኸ “ተንሣም አልጋኻ ጮርም ተቤታኸዬ ወር” ቧረን።<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />ሑቲም ተነሣም እንም ቲያዞይ አልጋሑ ጮረም ወረ፤ በመደሪም የነበሮዪም እንም በሐለተሑ በወደነቅ፤ “የዚኸማት ዘንጋ ስርም አዠነም አንሒርነ!” በወበር የእዝጌር አምሰገኖ።<verse eid="MRK 2:12" /></para>
  <para style="s1">ሌዊ ቧሪም ይጠሬዪ ማቴዎስ</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቴ. 9፥9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፥27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ኢየሱስም ዠበረም ተገሊላ ባር ጥጌ ወጣ፤ ሕዝቢም በብዛት ተሑቲዬ ቸኖ፤ ሑቲም አትመረኖ። <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />በዛም ቲቸለፍ የእልፍዮስ ትኸ የሌዊ በቀርጥ ይቌᎄርᎄዪ መደር ቾናም አዠንም፤ “ተኸተሌ” ቧረን፤ ሑቲም ተነሣም ተዄተለን።<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />በሌዊ ቤት በማዳ ቾናም ትናነ፤ ብዠ ቀረጥ ይስበስቦዪ አጢያተኞችም ተዄተሎይም የነበረ ስለኸነ፤ ተኢየሱስ ተደቀ መዛሙርተሑምጌ ይበሮ ባነ። <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />ተፈሪሳውያን ጐሳ የኸኖ የሕጊ አስተማሪዎች ኢየሱስ ተቀራጮች ተአጢያተኞችምጌ ይበራዪ ይሰጪም የመአሩ? በወበር የደቀ መዛሙርተሑ ተሳሎዮ።<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ኢየሱስም ይዝነጎዪ ሰማም፤ “አኪም ያሸኖ የታቆዪ አንኸንም ጤነኞች አንከኖ፤ እያ የአጢያተኞች አንኸንም የጻድቃንም ተንስሐዬ ኧጠራዬ አንተኘሑ” ባረኖ።<verse eid="MRK 2:17" /></para>
  <para style="s1">ስለጦም የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቴ. 9፥14-17</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፥33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />የዮሐንስ ደቀ መዛሙርት ፈሪሳውያንም ይጦሞ ባነ። አታት ሰቦችም ቸኖም የኢየሱስ፤ “የዮሐንስ የፈሪሳውያንም ደቀ መዛሙርት ቲጦሞ፤ ያኸ ደቀ መዛሙርትም ኤይጦሞ የመአሩ?” ባሮይ።<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ኢየሱስም፤ እኪ ባረኖ፤ “ሙሽራዪ ተሕኖጌ ትናነ ሙዜዎቺ ይጦሞዬ ይችሎ? ሙሽራዪ ተሕኖጌ ትናነ ይጦሞዬ ኤይችሎ፤ <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />ሙሽራዪ ተሕኖ ይትወሰድወ ወክት ይቸኝ፤ በዛ ግዝየ ይጦሞ።<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“በጉርዝ ልባስ ᎈር ገደር ጨርቅ ይጠፍ ሟንም ኤነ፤ ዚ ቢሸከትም፤ ገደሪ ጨርቅ የጉርዚ ይነጭን፤ ጉዲም የባሰ ይቤትት። <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />ዛምኸም ገደር ይሰጪ ወይን በጉርዚ ቀልቀላ ያወና ኤነ፤ ዚ ቢሸከትም ይሰጪ ወይን ቀልቀላዪም ያፉነዳን፤ ይሰጪዪ ወይን ቀልቀላዪም ይብላሶ። ስለኸነም ገደሪ ወይን ወቶና ያነወ በገደሪ ቀልቀላው።”<verse eid="MRK 2:22" /></para>
  <para style="s1">ኢየሱስ የሰምበት ጔታው</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቴ. 12፥1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፥1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />በሰምበት ከነ ኢየሱስ በእርሻ ግብት ቲቸለፍ፤ ተሑቲጌ በወወር ᎈር የነብሮዪ ደቀ መዛሙርተሑ እሴት ይᎂጥሶ ቀረሶ።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዘዳ. 23፥25</ref>። </char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ፈሪሳውያንም፤ “ዘ፤ ደቀ መዛሙርታኸ በሰምበት የዀተሪዪ ቃር የመአር ይሸክቶ?” ቲብሮ ተሳሎይ።<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ሑቲም እኪ ባረኖ፤ “ዳዊት በጓደን የስንቅ ወሴም በጠናወ ግዝየ ተሑቲጌ ተነበሮዪ ሰቦችጌ የሸኰተኒ አናምበብኩ?<note caller="-" style="x"><char style="xo" closed="false">2፥25-26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሙ. 21፥1-6</ref>። </char></note> <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />ተካሕናት አለአዪ በአብያታር ዘበን ተእዝጌር ቤቴ ገባም፤ ካሕናት ጠለለ ይበሮይኸም የትፌቀደዪ የትቌደሰ ቂጣ ነብሰሑ በናም ተሑቲጌ የነበሮዪ ሰቦች አበኖ።”<note caller="-" style="x"><char style="xo" closed="false">2፥26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዘሌ. 24፥9</ref>። </char></note><verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />ኧሗም እኪ ባረኖ፤ “ሰምበት የሰብ ተኸለቀ አከንም፤ ሰብ የሰምበት አንተኸለቀ፤ <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />ስለኸነም የሰብ ትኸ የሰምበት ጔታው።”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s1">ኢየሱስ ኧጀ ለምሽ ሰብ ዋትርፈሑ</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቴ. 12፥9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፥6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />ኢየሱስ ዠበረም ተምኩራቤ ገባ፤ በዛዬም አት ኧጀ የልመሸወ ሰብ ባነ <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />በመሳ ይከሶዬ ይሸዎ ሰቦችም በሰምበት ከነ ፈያ ይሸኩች የኸነኸም የወዥ ይቅሮ ባነ። <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ኢየሱስም ኧጀሑ የልመሸዪ ሰብ፤ “በስበሰበዪ ሕዝብ ኢፍት ተንሳም ቁም” ቧረን። <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />ኢየሱስም፤ “በሰምበት ከነ የፌቀጂዪ ፈያ ወሰክቱ ወይሽ ቡሼ? ሕይወት ዋትርፍ ወይሽ ዋጥፋ?” ባረኖ። ሕኖም እንቁስ ባሮ። <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />ኢየሱስም በሒነሕኖ ወደንድን አዘነም በዙሪያሑ የቆሞዪ በወማች ተምሌከተኖም የምሲ፤ “ኧጃኸ ዘርጓን!” ቧረን፤ ምሲም ኧጀሑ ዝረጋ፤ ኧጀሑም ስርም ተረᎈነ። <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />ፈሪሳውያንም ምንኸም ያጠፎዬ ይችሎኸም በሔሮድስ ጐሳ ተኸኖዪጌ ወምካከር ቀረሶ።<verse eid="MRK 3:6" /></para>
  <para style="s1">ብዠ ሰቦች የኢየሱስ ተዄተሎ</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ኢየሱስ ተደቀ መዛሙርተሑጌ ተገሊላ ባሬ ወረ፤ ተገሊላ ይሑዳ ብዠ ሕዝብም ተዄተለን፤ <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />ይሸኩቺ ቃር የሰሞ ሰቦችም በይሑዳ፤ በኢየሩሳሌም፤ በኤዶሚያስ፤ በዮርዳኖስ ዛዘር ባነዪ ገኝ ዛምኸም በጢሮስ በሲዶናም ከተማ ጭጭሳ ተሑቲዬ ቸኖ። <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />የስበሰበዪም ሕዝብ ኤያጭናንቁኸም ቀል የኸነ ጀልባ ያዝጋዶነኸም ደቀ መዛሙርተሑ ኤዘዘኖ።<note caller="-" style="x"><char style="xo" closed="false">3፥9-10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር. 4፥1</ref>፤ <ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>። </char></note> <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />ብዠሕኖ ፈያ የሸከተኖ ስለኸነ፤ በባሸ ይስቃዮዪ እንም ይሙሻሾዬ ይውዳደሮ ባነ። <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />ሩክሲ መናፍስትም ባዞይ ግዝየ ቢፍተሑ ቲወጥቆም፤ “አኸ የእዝጌር ትኸንከ!” በወበር ው ይብሮ ባነ።<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />ሑቲም ሟንነተሑ ኤይገልጦይኸም አቆመረም ይጌስጦ ባነ።<verse eid="MRK 3:12" /></para>
  <para style="s1">የዐሥራዄቲ ሐዋርያት ወሾም</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቴ. 10፥1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፥12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />ኢየሱስ ተቈቶዬ ወጣም ይሸኖዪ ተሑቲዬ ይቸኖኸም ጠራኖ፤ ሕኖም ተሑቲዬ ቸኖ። <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ተሑቲጌ ይኸኖኸም፤ የስብከትም ይለኮዬ ዐሥራ ዄቲ ሾመኖ፤ “ሐዋርያትም” ባረም ጠራኖ<note caller="+" style="f"><char style="fr" closed="false">3፥14 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ሐዋርያትም ባረም ጠራኖ </char><char style="ft" closed="false">ይቡኒ ሐረግ ኤነኖ</char></note>፤ <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />አጋንት ያትዌጦኸም ሥልጣን አበኖ።<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />የሾመኖዪም ዐሥረዄቲ ነዚሕኖኖ፤ ጴጥሮስ ባረም የጠራን ስምዖን፤ <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />ቦአኔርጌስ ወይ “የነጐድጓድ ዴንጋ” ባረም የጠራኖ፥ የዘብዴዎስ ዴንጋ ያዕቆብ ጐቤች ዮሐንስም፥ <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />እንድርያስ፥ ፊልጶስ፥ በርቶሎሜዎስ፥ ማቴዎስ፥ ቶማስ፥ የእልፍዮስ ትኸ ያዕቆብ፥ ታዴዎስ፥ ገኘሑ ይወዲ ስምዖን፥<note caller="+" style="f"><char style="fr" closed="false">3፥18 </char><char style="fqa" closed="false">ይቅናቀኒ፦ </char><char style="ft" closed="false">የቀና ወበሩ፤ ያት የፖለቲካ ድርጅት አባሉ ይብሮም ነኖ። </char></note> <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ዛምኸም የኢየሱስ አቸለፈም ያᎄኒ የአስቆሮታዊዪ ይሑዳ።<verse eid="MRK 3:19" /></para>
  <para style="s1">ኢየሱስ ብዔልዜቡልም</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቴ. 12፥22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፥14-23</ref>፤ <ref loc="LUK 12:10">12፥10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />በዛም ኢየሱስ ታት ቤቴ ገባ። ሑቲ ደቀ መዛሙርተሑም ስንቅ ወብራ ይቌምኖ ስን ዠበረም ብዠ ሕዝብ ተስበሰቦ። <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />ሐለተሑ የሰሞ ዘመዶቸሑ “አእምሮውታን ሳተም” በወበር ጠበጦይም የወወር ታነወዬ ቸኖ።<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />በኢየሩሳሌም የቸኖ የሕጊ አስተማሪዎችም፤ “ብዔልዜቡል<note caller="+" style="f"><char style="fr" closed="false">3፥22 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ብዔልዜቡል </char><char style="fqa" closed="false">ብዔልዜቡል </char><char style="ft" closed="false">ይብር</char></note> ነነወ፤ አጋንት ያወጣ በአጋንት አለአው” ባሮ።<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ኢየሱስም ጠራኖም በምሳሌ እኪ ባረኖ፤ “ሼጣን የሼጣንም ምንኸም ያትዌጣዬ ይችል?<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቴ. 9፥34</ref>፤ <ref loc="MAT 10:25">10፥25</ref>። </char></note> <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />ነብስ በነብሰሑ ይሰሰድ መንግሥት ይጠናዬ ኤይችል፤ <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />ቤትም ነብስ በነብሰሑ በትልያየ ይቈሜ ኤይችል። <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />ዛምኸም ሼጣን ነብስ በነብሰሑ ተግፋፋም ይሰሰድ በኸነ ጠናም ይነብሬ ኤይችል፤ ይጠፋ።<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“ተዛም የትነሣ ቁና ሰብ በደረም ኸርደዲ ሰብ ቴያግድ ተኸርደዲ ሰብ ቤቴ ይገባም ዱኒያሑ ይዘርፌ ኤይችል፤ ቤተሑ ወዝርፍ ይቸል ኸርደዲ ሰብ ቲያጉጅ ጠለለው።<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“የኢን ኧብርሑ፤ ሰቦች ይሸክቶይ አጢአት ይዝነጎዪም ስድብ እንም አፉ ይቡርኖ፤ <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />ቢኸንም በመንፈስ ቅዱስ ᎈር የስድብ ቃል ይዝነግ እንም የዘላለም አጢያት ኧድጉት ይኸንወ አንኸንም የዘላለም አፉ ኤይቡርነ።”<note caller="-" style="x"><char style="xo" closed="false">3፥29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፥10</ref>። </char></note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />ዚም የባረ፤ “ሩክስ መንፈስ ነነወ” የባሮይ ስለኸነ ባነ።<verse eid="MRK 3:30" /></para>
  <para style="s1">የኢየሱስ ዳኮ ጐባቢተሑም</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቴ. 12፥46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፥19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />በዛ አንቌ ዳኰች ጐባቢተሑም ቸኖ፤ በወረጀ ቈሞም ሰብ ላሖᎄም አጤሮይ። <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />በዙሪያሑ የቾኖ ብዠ ሰቦችም፤ “ዘ፤ ዳኳኸም ጐባቢታኸ በወረጀ ይሸዎከ” ባሮይ።<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ሑቲም ዠበረም፤ “ዳኮኛ ሟኒያ? ጐባቢተኛሽ ነሟንኖ?” ባረኖ። <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />በዙሪያሑ ተቾኖዪም በወትመልከት፤ እኪ ባረ፤ “ዳኮኛም ጐባቢተኛ ነዚሕኖኖ! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />የእዝጌር ፈአድ ይሸክት እንም ሑቲ ጐቤኛ፤ ኧተመኛ፤ ዳኮኛሙ።” ባረ።<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s1">ዘር ይዘራዪ ሰብ ምሳሌ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቴ. 13፥10-17</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፥4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />ብንጐድ ግዝየም ኧሗም በባሪ ᎀረ ያትመር ቀረሰ። ሑቲ ባነወ ጭጭሳ ስርም ብዠ ሕዝብ የስበሰበ ስለኸነ፤ በባሪ ᎈር ታነዪ ጀልባዬ ገባም ቾና፤ ሕዝቢም እንም በባሪ ጥግ ባነዪ መደር ᎈር ተስበሰቦም ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>። </char></note> <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />ሑቲም ብዠ ቃሮች በምሳሌ አትመረኖ፤ እኪም ባረኖ፤ <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“ስሞ፤ ገበሬዪ ዘሪ የወዝራ ወጣ። <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />ዘሪ ቢዘራወም ግዝየ አቲ ቤማ ᎈር ወጠቀ፤ አንፉዎችም ቸኖም ለቀሞም በኖይ። <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />ኧንጐዲ ይዀን አፈር ቤነወ በጐጭመን መደር ᎈር ወጠቀ፤ አፈሪም ጥልቀት ያነᎄረን ስለኸነ ሒንጌም በቀለ፤ <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ጬት በወጣ ግዝየም ዶገለ፤ ሥር ያነᎄረን ስለኸነ ጠረቀ። <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />ኧንጐዲ ዘር ኧሗም ብሶክ ግብት ወጠቀ፤ እሶኪም ላቀም የዘሪ አታሕልት ያነቈን ስለኸነ ፍርየ አናውረደ። <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />ኧንጐዲ ዘር ኧሗም በፈያ አፈር ᎈር የወጠቀም ስለኸነ በቀለም ላቀ፤ ፍርየም አበ፤ አቲ ሠላሣ፤ አቲ ሥልሳ፤ አቲም መቶ ፍርየ አወረደ።”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />ቄጠለም ኢየሱስ፤ “ይሰማ እዝን ያነን የስማ” ባረ።<verse eid="MRK 4:9" /></para>
  <para style="s1">ኢየሱስ የመአር በምሳሌ ይዝነግ የነበረኸም</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቴ. 13፥10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፥9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />ኢየሱስም የቢቶሑ በኸነ ግዝየ፤ ዐሥረዄቲም ደቀ መዝሙር ተሑቲጌ የነበሮዪ እንጐዶቺ ስለምሳሌዎቺ ተሳሎይ። <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ሑቲም፤ “ያሑ የእዝጌር መንግሥት ምሥጢር ወሐር አቡኩም፤ በወረጀ ያኖዪ እንም ቃር በምሳሌ ይውጅዮ፤ <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ዚም፣ ‘ወዠሑ ያዞኸም ኤያጥራምቶይኸም ወስማሑ ይሰሞኸም ልብ ኤይብሮይኸም፣ ኤይዠበሮኸም አጢያተሕኖ ኤሴርዥኖኸሙ’ ባረኖ።”<verse eid="MRK 4:12" /></para>
  <para style="s1">የዘሪ ምሳሌ ትርጉም</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቴ. 13፥18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፥11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />በዛም ኢየሱስ እኪ ባረኖ፤ “ዚ ምሳሌ አንተረዳሑይ? ኧጌ እንጐዶቺ ምሳሌዎች እንም ምንኸም ትትሬዶዬ ትችሎ? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />ይዘራዪ የእዝጌር ቃል ይዘራ። <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />አታት ሰቦች ቤማ ᎈር የወጠቀዪ ዘር ይመስሮ፤ ቃሊ ቢሰሞᎄ ግዝየ ሼጣን ሒንጌም ቸኘም በውስጠሕኖ የዘሬዪ ቃል ይወስጅ። <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />ዛምኸም እንጐዶቺ በጐጭመን መደር ᎈር የዘሬዪ ዘር ይመስሮ፤ ቃሊ ቢሰሞᎄ ግዝየ ሒንጌም በብልቃት ይቌበሮይ፤ <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />ቢኸንም ሥር ዬነኖ ስለኸኖ ዬክሶ የቀል ግዝየ ጠለለው፤ በቃሊ መሳ መከራ ስደትም በቸኘ ግዝየ ሒንጌም ይለጎ። <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />እንጐዶቺ ኧሗም ብሶክ ግብት የዘሬዪ ዘር ይመስሮ፤ ቃሊ ወስማ ይሰሞ፤ <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ቢኸንም የዚ ዓለም ውጣ ውረድ፤ የዱኒያ ወሴ ዛምኸም የንጐዶቺ ቃሮች ዋላ ቃሊ አነቀም በወጥብጥ ፍርየ ኤያወርድኸም ይሸክቶይ። <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />እንጐዶቺ በፈያ አፈር ᎈር የዘሬዪ ዘር ይመስሮ፤ ነዚሕኖም ቃሊ ሰሞም ይበቅሎዪም ሠላሳ፤ ሥልሳ፤ መቶም ፍርየ ያወርዶኖ።”<verse eid="MRK 4:20" /></para>
  <para style="s1">የዘለንጋዪ መብራት ምሳሌ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8፥16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />እኪም ባረኖ፤ “መብራት አቸኘሑም በአልጋ ተት ታወኖይ? ታወኖይ በዘለንጋ ᎈር አንከነ?<note caller="-" style="x"><char style="xo" closed="false">4፥21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቴ. 5፥15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11፥33</ref>። </char></note> <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />ስለኸነም ተሼመም ኤይትገለጥ፤ ተሼተረም ተብራኔ ኤይወጣ ኤነ፤<note caller="-" style="x"><char style="xo" closed="false">4፥22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቴ. 10፥26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12፥2</ref>። </char></note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />ይሰማ ኧዝን ያነን የስማ።”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />በወቀጥልም፤ “ብትሰሞይ ቃር ጥንቃቄ ሰክቶ፤ ብትቃጦᎄ ይቋጨᎄ ይቋጨንኩ፤ ዛምኸም በዛ የበዛ ይደቡርንኩ።<note caller="-" style="x"><char style="xo" closed="false">4፥24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">ማቴ. 7፥2</ref>፤ <ref loc="LUK 6:38">ሉቃ. 6፥38</ref>። </char></note> <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />ያነን ይደቡርነ፤ ቤነን ነንም፤ ዛም ያነኒም ይወስጅᎄ” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">4፥25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቴ. 13፥12</ref>፤ <ref loc="MAT 25:29">25፥29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19፥26</ref>። </char></note><verse eid="MRK 4:25" /></para>
  <para style="s1">ይለቂ ዘር ምሳሌ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ቄጠለም ኢየሱስ፤ እኪ ባረ፤ “የእዝጌር መንግሥት ዚ ይመስር፤ አት ሰብ ባፈር ᎈር ዘር ይዘራ። <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />ምሲም ምሳር ይገደር፤ በክናን ይትነሣ፤ ቢኸንም ሑቲ ቴይሒር ዛ ዘር በቀለም ይለቅ፤ <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />አፈሪም በነብሰሑ በመጀመሪያ ቡቃያዪ፤ ቄጠለም ዛላውታ፤ በዛም በዛላዪ ᎈር የሶበለ ፍርየ ይትረከብ። <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />ፍርየሚ የሶበለኸም አባር በወስላሑ፤ ምሲም ሒንጌ መደድ ነሣም ወድድ ይቀርስ።”<note caller="-" style="x"><char style="xo" closed="false">4፥29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፥13</ref>። </char></note><verse eid="MRK 4:29" /></para>
  <para style="s1">የሰናፍጭ ዘር ምሳሌ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቴ. 13፥31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፥18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />ኧሗም እኪ ባረ፤ “የእዝጌር መንግሥት ተመአርጌ ናምሳስርኔ? በመአርሽ ምሳሌ ኧገልጥኔ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />ባፈር ᎈር ቲዘሬዪ ዘር እንም ስርም ያነሰዪ የሰናፍጭ ጢንጦ ይመስር፤ <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />ዘሬም በላቀ አንቌም፤ ባታሕልቲ መደር ቢትረከቦዪ እፅዋት እንም ይበዛ፤ የሰሜ አንፉዎችም በግድድር ጫፈሑ ጥሌል ተት ያᎈሮ።”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ኢየሱስም ሰቦች ወሐር ቢችሎᎄ ቅጫ፤ ነዚሕኖ ቢምሳሰሎ ብዠ ምሳሌዎች ኤወደኖ። <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />አትም ቃር ፍርየ ኤባን ምሳሌ ኤይውዶ ባነ። ኢየሱስም ደቀ መዛሙርተሑ የሟነሕኖ ቢኸኖᎄ ግዝየም እንም ቃር በዋፍታታ ያትሬዳኖ ባነ።<verse eid="MRK 4:34" /></para>
  <para style="s1">ኢየሱስ ማዕበሊ ጭጭ አᎄኘን</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቴ. 8፥23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፥22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />ዛ ከነ በመሸ ግዝየ፤ ኢየሱስ የደቀ መዛሙርተሑ “ተኧጋ ዛዘሬ ንገናነ” ባረኖ። <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />ሕኖም የሕዝቢ ገፈሮም ሑቲ በሳፈረወ ጀልባ ውስጥ ትናነ በዛም ጠበጦይም ወሮ፤ እንጐድም ጀልባዎችም ተሑቲጌ ባኖ። <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />በዛ ግዝየ ኸርደድ ዐውሎ ኧንፋስ ተነሳ፤ ያውሎ ኧንፋሲ ግፊት ኧጋ ይᎀላ ስን የጀልባዪ ያናውጭ ባነ። <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ኢየሱስም ትራስ ተራሰም በጀልባዪ ባንቌ ክፍል ተገደረም ባነ፤ ደቀ መዛሙርተሑ ቅሰቀሶይም፤ “አስተማሪ!፤ ትንጠፋነ ግድ ኤይብርከ?” ባሮይ። <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />ሑቲም በወኔተሑ ተነሣም ኧንፋሲ ጔሰጠን፤ ባሪም፤ “እንቁስ፤ ጭጭ በር!” ቧረን። ኧንፋሲም እንቁስ፤ ጭጭ ባረ፤ ፍጡምም ጭጭታ ኸነ። <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />ኢየሱስ የደቀ መዛሙርተሑም፤ “የመአር ዚኸም ቲጔኖ? ኧሗ ስን እምነት ኤነናሑ?” ባረኖ።<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />ሕኖም በጊናት ተዋጦም ነብስ በነብሰሕኖ “ኧንፋሲ የባሪ ግፊትም ይታዘዞነ ዚ ሟኒ?” ተበበሮ።<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s1">ኢየሱስ አጋንት ያነወዪ ሰብ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቴ. 8፥28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፥26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ኢየሱስም ደቀ መዛሙርተሑ ባሪ ተጔኖም ጌርጌሴኖ<note caller="+" style="f"><char style="fr" closed="false">5፥1 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ጌራሴኖን</char><char style="ft" closed="false">፣ እንጐዶቺ ኧሗም</char><char style="fqa" closed="false">ጌርጌሴኖን </char><char style="ft" closed="false">ይብሮ። </char></note> ተቧሪ ገኜ ቸኖ። <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ኢየሱስ በጀልባዪ ተወረደኸም አት በሩክስ<note caller="+" style="f"><char style="fr" closed="false">5፥2 </char><char style="fqa" closed="false">ቡሼ፦ </char><char style="ft" closed="false">ዛምኸም ቁ 8ም 13 ኧዞ። </char></note> መንፈስ የጠᎄጠን ሰብ በቀብር መደር ወጣም ይትራከᎆ ተሑቲዬ ቸኘ። <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />ዚ ሰብ በቀብር መደር ውስጥ ይነብር ሟንም በሰንሰለት ያጉጄም ኤይችል ባነ። <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />ብዠ ግዝየ በግር ብረት በሰንሰለት ኧጉጀኘ ባነ፤ ቢኸንም የጅ ሰንሰለተሑ ይᎂጥስ፤ የኧግር ብረተሑም ይሰብር ባነ። ሟንም ጠበጠም ያቴኩሼ ይችል አነበረ። <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />በቀብሮቺ በቈቶዎቺም ግብት ክናን ምሳርም ቲዥዋወር ው በወበር ገገሑ ብምን ይረርጥ ባነ።<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />ዚም ሰብ የኢየሱስ በሩቄ ባዠን ግዝየ ተሑቲዬ ሮጠም ቢፍተሑ ተንብረከከም ሰጐደነ። <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />በወደል ጣምባም ው ባረም፤ “አኸ ትንም ትበዛዪ የእዝጌር ትኸ ኢየሱስ፤ ቲያ ምን ነነናኸ? አታሥቃዬኸም በእዝጌር ጠበጥከኸም” ቧረን። <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />ዚም የባረ ኢየሱስ፤ “አኸ ሩክስ መንፈስ ተዚ ሰብ ውጣ!” ባረም ኤዘዘን ስለኸነው። <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />በዛም ኢየሱስ፤ “ሽማኸ ሟኒ?” ባረም ተሳለን። “ብዠንነ ሽመኛ ሌጌዎኑ” ቧረን። <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />በዛም ገኝ ኤያወጣኖኸም አቆመረም ጮቈሰን። <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />በቁርብ ቢትረከቢ ንሻ ᎈር ወደል የዐሣማ ወጀ ዋልዮም ባነ። <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />ሩክሲ መናፍስትም የኢየሱስ፤ “ተ ዐሣማዎቺዬ ስድነ፤ ኧቡየነቦኸም ፍቅድንነ” ባሮም ጮቀሶይ። <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ሑቲም ፈቀደኖ። ሩክሲ መናፍስቶቺም ወጦም በዐሣማዎቺ ቡሮቦ፤ ዄት ሺ ቅጫ ዐሣማ በገደሊ አፋፍ ተልተል በወበር ተተᎈን ወረዶም በባሪ ውስጥ ሰመጦ።<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />ወጅመኞቺ ሰኮም ወሮ፤ ኦጀዪ በከተማ በገጠርም አሳሎይ፤ ሕዝቢም የኸነዪ የወዥ ባነወ መደር ወጣ። <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />ተኢየሱሴ በቸኖ ግዝየ፤ ብዠ አጋንት ቡሮᎄም የነበረዪ ሰብ፤ ልባስ ለበሰም አእምሮውታን ተዠᎄረነም በዛም ቾናም አዞይ፤ ጔኖም። <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />ዚ ያዞ ሰቦችም አጋንት የቡየወዪ ሰብ የሸከተዪም ስለዐሣማዎቺም የሕዝቢ ዝነጎ።<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />በዛም ሕዝቢ ገኘሕኖ ገፈረም ያርኖኸም የኢየሱስ ይጮቅሶይ ቀረሰ።<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ኢየሱስ ተጀልባዬ ቢይቡየወ ግዝየ፤ አጋንት ቡየወም የነበረዪ ሰብ ተሑቲጌ የወወር ጮቈሰን።<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />ኢየሱስ አንፈቈደነ፤ ቢኸንም፤ “ተቤታኸዬ ወር፤ የዘመዶቻኸም ጔታ ምን ቅጫ ወደል ቃር የሸከተንከኸም ያቴዠናኸዪ ምረተሑ አዉዶ” ቧረን።<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />ምሲም ወረ፤ ኢየሱስ የሸኰተነዪ ቃር እንም ዐሥር ከተማ<note caller="+" style="f"><char style="fr" closed="false">5፥20 </char><char style="fq" closed="false">ዐሥር ከተማ </char><char style="ft" closed="false">ይቡሪዪ ጭጭሳ ግሪኪ </char><char style="fqa" closed="false">ዴካፖሊስ </char><char style="ft" closed="false">ይቡን። </char></note> ቢቡሪ ገኝ ይዝነግ ቀረሰ፤ የሰሞዪም እንም ተዴነቆ።<verse eid="MRK 5:20" /></para>
  <para style="s1">የᎀተቺ ትኸ የታቌቺ ምሽትም</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቴ. 9፥18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፥40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />ኢየሱስ ዠበረም በጀልባ ተኧጋዪ ዛዘሬ በጔና ግዝየ፤ ብዠ ሕዝብ በዙርያሑ ተሑቲዬ ተስባሰበ፤ በባሪ ጥግ ያነኸም፤ <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />ተምኩራብ አለኦች አቲ የነበረ፥ ኢያኢሮስ የቧሪ ሰብ የኢየሱስ ባዠን ግዝየ በግረሑ ተት ወጠቀም፤ <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />“እንሲ ትኸኛ በሞት አፋፍ ᎈርያ ተረፈችም በሕይወት ትነብርኸም ተኝም ኧጃኸ ጫንባ” በወበር አጠበቀም ጮቈሰን።<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />ስለኸነም ኢየሱስ ተሑቲጌ ወረ። ብዠ ሕዝብም ዙሪያውታን ቲያጬንቁም ተዄተለን።<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />ዐሥረዄት ዓመት ደም ቲፈስሳ የነበረችም ምሽት በዛ ባነች፤ <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />አኪም ተሐኪሜ በወወር ብዠ ተሥቃየችም ዋጋዬታንም እንም ፈጀችም ባነ። ቢኸንም ቲብስባ ወረች አንኸንም አትም አንጠቀለና። <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />ሒቲም የኢየሱስ ፈያ ሽም ሰማችም የነበረ ስለኸነ ቢያጋፋዪ ተሕዝቢ ግብት ባንቌውታን ቸኘችም ልባሰሑ ለገደች። <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />መሳሑም፤ “ተጋፋሑም ልባሰሑ ጠለለ ብንለጉጅ ኧተርፍ፤” ይብር እምነት ባነና።<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />ይፈሲ ደሜታን ሒንጌም ቈመ፤ ተባሸዬታንም የተረፈችኸም በገጌታ ሐረች። <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />ኢየሱስም ሒንጌም ቆት በሑቲ የወጣኸም ሐረ፤ ተሕዝቢዬ ዞር ባረም፦ “ልባሰኛ የለገደ ሟኒ?” ቲብር ተሳለ።<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />ደቀ መዛሙርቲም፦ “ሕዝቢ ቲጋፋ ቲኬተልከ ትታዥ፥ ‘ሟኒ የለገዴ?’ ትብር?” ባሮይ።<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />ኢየሱስም ዚ የሸከተ ሟ የኸነኸም የወዥ ዙሪያውታን ተምሌከተ። <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />ምሽቲም በሒቲ የኸነዪ በወሐሬታ በወገና ቲያትረዳ ቢፍተሑ ወጠቀችም የኢኒ እንም ኤወደቹ። <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ሑቲም፤ “ትኸኛ ዘ፤ እምነታሽ አተረፈናሽም፤ በሰላም ዌር፤ ተሥቃያሽም አᎉ” ባረና።<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ኢየሱስ ገና ዚ በወዘንግ ᎈር ትናነ፤ ሰቦች በአይሑድ ጠሎት ቤት አለአ በኢያኢሮስ ቤት ቸኖም፤ “ትኸኻ ᎀተችም፤ ኧጌሽ የመአር አስተማሪዪ ታቌጭ?” ባሮይ።<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ኢየሱስም ሰቦቺ የዝነጎዪ በጭ በወበር የአይሑድ ጠሎት ቤት አለአ፤ “ኧምን ጠለለ አንኸንም አትጔና” ቧረን። <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />ተጴጥሮስ ተያዕቆብም ዛምኸም ተያዕቆብ ጐቤ ተዮሐንስ አንኸንም ሟንም ይትዄተልኸም አንፈቀደ። <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />ተአይሑድ ጠሎት ቤት አለአ ቤቴ የሰሎኸም፤ ኢየሱስ ሕላቲም ሰቦቺም ው ው ቲብሮ አመረሮም ቲበሖ ተምሌከተ። <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ተቤቴም ገባም፤ “ዚ እንም ሕላት አልፋታም የመአሩ? ገረዲ ተገደረችም አንኸንም አᎀተች፤” ባረኖ።<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />ሰቦቺም በዋፊዝ ዳቆᎄ። ሰቦቺ እንም በቤት ባትዌጣ አንቌ፤ ኢየሱስም ይንም በቤት አትዌጣኖ፤ የገረዲ አባዬታ ዳኴታንም ዛምኸም ተሑቲጌ የቸኖዪ ደቀ መዛሙርት አትዄተለም ገረዲ ታነትወዬ ገባ። <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />በዛም የገረዲም ኧጅ ጠበጠም፤ “ጣሊታ ቊም!” ባረና፤ ትርጉሚም “አሺ ትኸ ተንሸ ኧብርሽ፤” ወበሩ።<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />ገረዲም ሒንጌም የዐሥረዄት ዓመት ትኸ የነበረች ስለኸነ ሒንጌም ተነሳችም ተዛዬም፤ ተዚዬ ወበር ቀረሰች፤ ዚም በኸነ ግዝየ ሰቦቺ ስርም ተዴነቆ። <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ኢየሱስም ዚ ዘንጋ ሟንም ኤይሒርኸም ኤዘዘኖም “ትᎄራን ቃር አቦያ!” ባረኖ።<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s1">ኢየሱስ በናዝሬት የጠሌኸም</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቴ. 13፥53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፥16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />ኢየሱስ በዛ ወጣም ተገኘዄ ወረ፤ ደቀ መዛሙርተሑም ተዄተሎይ። <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />ሰምበትም በሰላ ግዝየ፤ በአይሑድ ጠሎት ቤት ያትመር ቀረሰ፤ የሰሞዪም ብዠ ሰቦች፤ ተዴነቆ። ሕኖም እኪ ባሮ፤ “ዚ ሰብ ነዚሕኖ ዘንጋዎችም ቤቴ ረከበኖ? ዚ ያᎅ ብላት መአሩ? ኧሗም ነዚሕኖ ታምራት ይሸክት ምንኸም በጀሑ ይሸከቶ! <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />ዚ ዐናጢዪ አንከነ? የማርያም ትኸ፤ የያዕቆብ ጐቤ ዮሴፍ፤ የይሑዳ የስምዖንም ጐቤ አንከነ? ኧተሟᎁተሑ በዚዬ ቢናዬ አንከነማ?” በዚም የትነሣ ተሥናከሎᎄ።<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />ኢየሱስም፤ “ነብይ ብንጐዴ ይከበር፤ በፎለሑ ገኝ በዘመዶቸሑ በአበሮሰሑም ግብትም ይጐርጪ ቲብር” ዠበረኖ።<note caller="-" style="x"><char style="xo" closed="false">6፥4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሐ. 4፥44</ref>። </char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />በዛም ቀል በታቆዪ ᎈር ኧጀሑ ጫነም ፈያ ተወሰክት አንኸንም እንጐድ ታምር ወሰክት አንቻለ። <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />ኢየሱስም ባለወምነሕኖ ተዴነቀ።</para>
  <para style="p" vid="MRK 6:6">በዛም ኢየሱስ ተመደር መንደሪ ተዝዋወረም ያትመር ባነ።<verse eid="MRK 6:6" /></para>
  <para style="s1">ኢየሱስ ዐሥረዄቲ ደቀ መዝሙር ላኸ</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቴ. 10፥5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፥1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ዐሥረ ዄቲ ደቀ መዝሙር ተሑቲዬ ጠራም፤ ዄት ዄት ሸከተም ላኸኖ፤ በሩክሲ<note caller="+" style="f"><char style="fr" closed="false">6፥7 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ቡሼ</char></note> መናፍስትም ᎈር ሥልጣን አበኖ። <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />ዚም ትዛዝ አበኖ፤ “ዬማሑ ትንጣር አንከንም፤ እንጄራም ኸነ ኸረጪትም ዋጋም በኪሳሑ አትጥብጦ።<note caller="-" style="x"><char style="xo" closed="false">6፥8-11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10፥4-11</ref>። </char></note> <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ጫማ ኧግዶ፤ ቢኸንም ዄት ልባስ አትልበሶ፤ <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />ታት ቤቴ ብትገቦᎄ ግዝየ በዛ ከተማ ትወጦ ስን በዛም አክሶ፤ <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />በሟንመሑ መደር ቤይቌበሮኩም ኤይሰማሑ በኸነ፤ በዛ መደር ትትወጦ ምስክር ይኸንቦኸም በግረሑ ተት ያነዪ ቲባ በዛ አራግፎ።”<note caller="-" style="x"><char style="xo" closed="false">6፥11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሐዋ. 13፥51</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">6፥11 </char><char style="ft" closed="false">የግዕዝ ገደር ጉዳም፥ በ 1947 ዓ. ም. ዬተᎁዪ የአማርኛ መጽሐፍ ቅዱስ ይቄጥሊ ይደብሮ፦ “የኢን ኧብርሑ፤ ተዛ ከተማ የጠቀለ የሰዶም የገሞራም በፍርድ ከነ ይቀልኖ።” ዚ ዐረፍተ ዘንጋም በሟመሕኖም የግሪኪ ንባብ ውስጥ ኤይትረከብ። </char></note><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />ሕኖም በዛ ወጦም፤ ሰቦች ንስሐ ይገቦኸም ሰበኮ። <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />ብዠ አጋንት አትዌጦ፤ ብዠ የታቆ ሰቦች ዘይት ቀቦም ፈያ ሸከቶዮ።<note caller="-" style="x"><char style="xo" closed="false">6፥13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">ያዕ. 5፥14</ref>። </char></note><verse eid="MRK 6:13" /></para>
  <para style="s1">የመጥምቂ ዮሐንስ ወቀጠር</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቴ. 14፥1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፥7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />የኢየሱስ ሽም ቲትኴር በወተኘሑ፤ ንጉሥ ሔሮድስ ዛምኸም ሰማ። አትባተሕኖም፤ “የዚኸማቲ ታምር በሑቲ ይሸክቲ መጥምቂ ዮሐንስ በሞት ቢትነሣው” ይብሮ ባነ።<note caller="+" style="f"><char style="fr" closed="false">6፥14 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ይብር ባነ </char><char style="ft" closed="false">ይብሮ።</char></note><verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />እንጐዶቺም፤ “ኤልያሱ” ባሮ።</para>
  <para style="p" vid="MRK 6:15">የቀኖዪም ኧሗም፤ “ተበደሮዪ ነብዮች ያቲ ነብይኸሙ” ይብሮ ባነ።<note caller="-" style="x"><char style="xo" closed="false">6፥14-15። </char><char style="xt" closed="false"><ref loc="MAT 16:14">ማቴ. 16፥14</ref>፤ <ref loc="MRK 8:28">ማር. 8፥28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9፥19</ref>። </char></note><verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />ሔሮድስ ዘንጋዪ ቲሰማም፤ “እያ ጉነነሑ ያቅሜጠልኩን ዮሐንስ በሞት ተነሣም!” ባረ። <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />ሔሮድስ ነብሰሑ የጐቤች የፊልጶስ ምሽት የሔሮድያዳ በዋግባሑ መሳውታም፤ ተጠበጠም ኧጉጀኘ ይኸንኸም ትዛዝ በዋብ የዮሐንስ ወሕኔ ቤት አገቧንም ባነ <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />ዮሐንስ የሔሮድስ፤ “የጐቤያኸ ምሽት ታገባናዬ ሕጊ ይኸትረኸ” ይቡን ባነ።<note caller="-" style="x"><char style="xo" closed="false">6፥17-18። </char><char style="xt" closed="false"><ref loc="LUK 3:9-20">ሉቃ. 3፥9-20</ref>። </char></note><verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />ሔሮዲያዳም በዚ ቂም ጠበጠትወም ታትቌጥሬ ሸች፤ ቢኸንም አንከነና። <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />መሳሑም ዮሐንስ ጻድቅም ቅዱስ ሰብ ወሕነሑ ሔሮድስ በወሐረሑ ይጔናንም ይቊየን ባነ። ዮሐንስ ይዝነጊኒ ቲሰማ ሔሮድስ ቢትሬበሽም<note caller="+" style="f"><char style="fr" closed="false">6፥20 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ብዠ ቃር ይሸክት ባነ </char><char style="ft" closed="false">ይብሮ</char></note> በብልቃት ይሰሟን ባነ።<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />ሔሮድስ የጨኘወ ከነ የዋክብር የመንግሥት ባለሥልጣኖች፤ ያርብ ሹማምንቶቺም አታት የትኴሮ የገሊላ ነዋሪዎች ወደል ግብዣ ሸከተ፤ ዚም የሔሮድያዳ ፈያ አጋጣሚ ኸነና፤ <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />የሔሮዲያዳም ትኸ ተግብዣዬ ገባችም ትትደርስ የሔሮድስ የጋᎄዥዮዪ አትብላለቀቶ። ንጉሢም የገረዲ፤ “ትሼዪ እንም ተሴልኝ ኢብሽ” ባረና። <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />ኧሗም “የመንግሥተኛ ግብት ስን ቢኸን፤ ትሴልኚ እንም ኢብሽ” ቲብር በማላ ቃል ገባና።<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />ሒቲም ወጣችም የዳኴታን፤ “መአር ንጮቁሽ?” ባረታ። ዳኴታንም፣ “የመጥምቂ የዮሐንስ ጉነን” ባረታ።<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />ገረዲም ሒንጌም በዋተክል ተንጉሢዬ ተዠበረችም፤ “የመጥምቂ ዮሐንስ ጉነን በወጨት ኸነም ኧሗ ይቡኝኸም ኧሸ፤” ባረችም ተሳለች።<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />ንጉሢ በዘንጋዪ ስርም አዘነ፤ በትጋበዞዪ ባዘኖቺ ኢፍት የማላ ቃለሑ የወሕትር አንሸ። <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />ስለኸነም አቲ ወታደር በዋተክል ላኸም፤ የዮሐንስ ጉነን ቅመጠለም ያቸኝኸም ኤዘዘን፤ ሑቲም ወረም በወሕኔ ቤተሑ ውስጥ ጉነነሑ ቅመጠለም፤ <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />የቅᎀጠሊዪ ጉነን በወጨት አቸኘም የገረዲ አበና፤ ገረዲም የዳኴታን አበታ። <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />የዮሐንስ ደቀ መዛሙርትም ዚ በሰሞኸም ቸኖ፤ ሬሳዪም ወሰዶም ቀበሮይ።<verse eid="MRK 6:29" /></para>
  <para style="s1">ኢየሱስ አምስት ሺ ሰብ አበና</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቴ. 14፥13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፥10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሐ. 6፥1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />ሐዋርያት በኢየሱስ ዙሪያ ተስበሰቦም የሸከቶዪም ያትመሮዪ እንም ኤወዶይ። <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />ብዠ ሰቦች ይቸኖም ያር የኸነ ስለኸነ ስንቅ የወብራ ግዝየ ያነበረኖ ስለኸነ፤ “እንዴ የሟናሑ ቲያጌ ታት ሰብ ቴነወ መደሬ ንወርነም ቀል አፉሮ” ባረኖ። <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />ስለኸነም የሟነሕኖ ታት ሰብ ቴነወ መደሬ በጀልባ ወሮ።<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />ሕኖም ቲያሮ ብዠ ሰቦች አዞም ሐሮዮ፤ በከተማዎችም እንም ወጦም በግር ቲሮጦም በደሮዮም ሰሎ። <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />ኢየሱስ በጀልባዪ ቢወርድወ ግዝየ ብዠ ሕዝብ ተስበሰቦም አዠ፤ ወጅመኘ ዬነኖ ኧጤዎችኸም የነበሮ ስለኸነም አዘነኖ፤ ብዠ ቃርም ያትመሮ ቀረሰ።<note caller="-" style="x"><char style="xo" closed="false">6፥34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ዘሑ. 27፥17</ref>፤ <ref loc="1KI 22:17">1 ነገ. 22፥17</ref>፤ <ref loc="2CH 18:16">2 ዜና 18፥16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፥5</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">6፥34 </char><char style="xt" closed="false"><ref loc="MAT 9:36">ማቴ. 9፥36</ref>። </char></note> <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />በዛ ግዝየ ከነዪ ቲመሽ በወወረሑ ደቀ መዛሙርተሑ ተሑቲዬ ቀረቦም እኪ ባሮይ፤ “ዚ መደር ሰብ ዬነወ መደሩ፤ ከነዪም መሸም፤ <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />በጭጭሳዪ ሰብ ታነወ መንደሬ ወሮም ይᎄሬ ቃር ስሮም ይበርኸም የሕዝቢ ገግቶ።”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />ሑቲም ዠበረም፤ “ይበሮዪ አሑ አቦዮ” ባረኖ። ሕኖም፤ “ወርነም በዄት መቶ ዲናር <note caller="+" style="f"><char style="fr" closed="false">6፥37 </char><char style="ft" closed="false">ዲናር፥ ወበር ያት ከነ ሜነተኘ የከነ አበል ወበሩ። </char></note> እንጄራ ስየነም ይበሮዪ ናብነዮ?” ባሮይ።<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ሑቲም “ምናሕር ቂጣ ነነናሑ? እንዴ ወሮም ኧዞ፤” ባረኖ፤ አዞም፤ “አምስት ቂጣ ዄት ዓሣም፤” ነነ፤ ባሮይ።<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />በዛም፤ የሕዝቢ በልመለመ ሠር ᎈር በቡድን በቡድን ያወኖዮኸም ኤዘዘኖ። <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />ሕዝቢም መቶ መቶም አምሳ አምሳ ኸኖም በቡድን በቡድን ቾኖ። <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />ሑቲም አምስቲ ቂጣ ዄቲ ዓሣ ጠበጠም ተሰሜዬ በወዥ ባረከም፤ ቂጣዪም ፈረመም ያቀርቦኖኸም የደቀ መዛሙርተሑ አበ፤ ዄቲም ዓሣ ይንም ሳደ። <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />እንም በኖም ጦፎ። <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />ደቀ መዛሙርተሑም በᎄኔዪ ቂጣ ዓሣ፤ ዐሥረዄት ሌማት ሙላ ስበሰቦ። <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />ስንቂም የበኖዪ አምስት ሺ ገሜ ባኖ።<verse eid="MRK 6:44" /></para>
  <para style="s1">ኢየሱስ በባር ᎈር በግረሑ ወረ</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቴ. 14፥22-33</ref>፤ <ref loc="JHN 6:15-21">ዮሐ. 6፥15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />ሒንጌም ሑቲ የሕዝቢ ቲጌግት ትናነ፤ ደቀ መዛሙርተሑ በጀልባ ተቤተ ሳይዳዬ በደሮይም ይጔኖኸም ኤዘዘኖ፤ <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />በዛም ገፈረኖም ይጤልዬ ተቈቶዬ ወጣ። <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />በመሸም ግዝየ ጀልባዪ በባሪ ግብት ባነ፤ ሑቲም የሟነሑ ባፈር ᎈር ባነ። <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />ኧንፋስ ብረታቦም የነበረ ስለኸነ፤ ደቀ መዛሙርተሑ ተመቅዘፊያዪጌ ቲታገሎ አዠኖ፤ ተዠጠ ሰዓት ዐሥረዄት ሰዓት ስን፤ በባር ᎈር ቲያር ተሕኖዬ ቸኘ፤ በሜጠቀሕኖም ተቸለፈም ያሬ ባነ። <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />ቢኸንም ሑቲ በባሪ ᎈር ቲያር ባዞይ ግዝየ የሟቾቺ ሰቦች መንፈስ መሰረኖም ው ባሮ። <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />እንም የሑቲ ባዞይ ግዝየ ድነበጦ ባነ። ሑቲም ሒንጌም አዝናጔኖም፤ “አይዞአሑ እያትንኩ፤ አትጔኖ!” ባረኖ። <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />ሑቲም በጀልባዪ ᎈር ወጣም ተሕኖጌ ኸነ፤ ኧንፋሲም ገፈረ፤ ደቀ መዛሙርቲም ስርም ተዴነቆ፤ <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />የስንቂዪም ታምር አናጥራመቶ ባነም፤ ሒነሕኖም ድነደነም ባነ።<verse eid="MRK 6:52" /></para>
  <para style="s1">ኢየሱስ በጌንሳሬጥ የታቆዪ ያተረፈኸም</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቴ. 14፥34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ባሪ ተጔኖም፤ ጌንሳሬጥ ሰሎ፤ ጀልባዪ ተአፈሬ አጤጎም አገዶይ፤ <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />ሒንጌም በወረዶኸም፤ ሕዝቢ የኢየሱስ ሐሮይ፤ <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />ተጭጭሳዬም እንም በወሩጥ የታቆዪ ባልጋ ᎈር ጮሮም ሑቲ ቲትረከብወ መደሬ እንም ያቸኖ ባነ። <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />በወረወ መደር እንም በመንደር፥ከተማ፥ ገጠርም የታቆዪ ተጠባዬ ቲያወጦ በሑቲ ኢፍት ያቀርቦዮ ባነ፤ የልባሰሑ ጫፍ ይለግዶኸም ይጮቅሶይ ባነ፤ የለገዶይ እንም ይተርፎ ባነ።<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s1">ስለአቦቸና ሴራ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቴ. 15፥1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ፈሪሳውያን በኢየሩሳሌም የቸኖ አታት የሕጊ አስተማሪዎችም ተኢየሱሴ ቸኖም በዙሪያሑ ተስበሰቦ። <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />የኢየሱስ ደቀ መዛሙርቲም አታቶቺ ባነጣ ወበር ባንታጠበ ኧጅ ስንቅ ቲበሮ አዞ፤<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />ፈሪሳውያን አይሑድም እንም የአቦቸና ሴራ የወቀየ ቲብሮ፤ በሥራተሑ መሠረት ኧጀሕኖ በወጠንቀቅ ቴይታጠቦ ኤይበሮ ባነ። <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ዛምኸም በገቤ ቲዠበሮ ባንታጠቦ ኤበሮ ባነ፤ ዋንጫ፥ የወሸን፥ የናስ ግብሮች የአልጋም<note caller="+" style="f"><char style="fr" closed="false">7፥4 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">የማዳ ዐልጋ </char><char style="ft" closed="false">ይብሮ</char></note>፥ ያጥᎅኸም ያነ፥ እንጐድ ብዠ ሴራ ይቅሮ ባነ።<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />ስለኸነም ፈሪሳውያን የሕጊ አስተማሪዎችም፥ “ደቀ መዛሙርታኸ የአቦቸና ሴራኸም በወንብር ሟኔ ባንታጠበ ኧጀሕኖ የመአር ኧንጄራ ይበሮ?” ባሮም የኢየሱስ ተሳሎይ።<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ሑቲም እኪ ቲብር ዠበረኖ፦ “አሑ ግብዝ! ኢሳያስ ስላሑ፥ ‘ዚ ሕዝብ ባፈሑ ጠለለ ያከብሬ አንከንም ሒነሑም ቲያ የራቀው! <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />ቤድገልል ቃር ያመልኬ፤ ትምርተሕኖም ሰብ የሸኰተን ሥራት ጠለለው።’<note caller="-" style="x"><char style="xo" closed="false">7፥6-7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፥13</ref>። </char></note><verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“የእዝጌር ትዛዝ ገፈርኩም የሰቦቺ ሴራ ሥራትም ትቅሮ።”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />ኧሗም ኢየሱስ፤ እኪ ባረኖ፤ “የነብሳሑ ሴራ የወቀየ<note caller="+" style="f"><char style="fr" closed="false">7፥9 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">የዋቁም </char><char style="ft" closed="false">ይብሮ</char></note> ትትብሮ፤ የእዝጌር ትዛዝ ትገፍሮᎄ ብላት ነነናሑ። <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />ሙሴ፤ ‘አባኸ ዳኳኸም አክብር፤ ኧሗም በአᎄች ወይ በዳኰች ᎈር ቡሼ ይዝነግ ሰብ በሞት የትቀጣ፤’ ይብር።<note caller="-" style="x"><char style="xo" closed="false">7፥10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዘፀ. 20፥12</ref>፤ <ref loc="EXO 21:17">21፥17</ref>፤ <ref loc="LEV 20:9">ዘሌ. 20፥9</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>። </char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />አሑም እኪ ትብሮ፤ ‘አት ሰብ ያᎄች የዳኰችም በወግዝ ሟኔ ያᎄች የዳኰችም ወሰክት ይጌቧኒ ዘንጋ እንም የእዝጌር ያቀረብኩን መባ ሙ፤’ ቢብርሑ፤ <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />ዚ ሰብ ያᎄች የዳኰችም ተወግዝ ነጣ ትኸትሮይ። <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />ስለኸነም የጨኘት ብታችላልፎይ ሴራ የእዝጌር ቃል ትሸሮ፤ ዚ የመሰረ ብዠ ቃር ትሸክቶ።”<verse eid="MRK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />ኧሗም ኢየሱስ የሕዝቢ ተሑቲዬ ጠራም እኪ ባረኖ፤ “ስሞኝ፤ እንማሑም አጥራምቶ፤ <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />በውጪ ተውስጤ ገባም የሰቦቺ ያረኩሺ አትም ቃር ኤነ፤ የጠቀለዪ የሰቦቺ ያረኩሽ በነብሰሑ ተውጪዬ ይወጣዪ ቃሩ፤ <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />[ኧጌሽ ይሰማ እንዝን ያነን የስማ!”]<note caller="+" style="f"><char style="fr" closed="false">7፥16 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 16 ይደብሮ፤ ቃሊም በ 4፥23 ያነዪ ይመስር። </char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />ኢየሱስ የሕዝቢ ገፈረም ተቤቴ በገባ አንቌ ደቀ መዛሙርተሑ የምሳሌዪ ቃር ተሳሎይ። <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ሑቲም፤ “አሑም ዘንጋዪ ኤይገባሑ? በውጪ ተሰቤ ቡየም ያረኩሼ ይችል አትም ቃር ኤነ፤ <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />ተ ሒነዄ ቴይኸን ተ ደነዄ ይቡየ፤ በዛም በገገሑ ይወጣ።” ኢየሱስ ዚ በወበረሑ ስንቅ እንም ንጡ ወሕነሑ ገለጠ።<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ቄጠለም ኢየሱስ እኪ ባረ፤ “በሰብ ሒን ይወጣ ዛ የሰብ ያረኩሽ፤ <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />ሕኖም፤ በሰብ ሒን ይወጦዪ ቡሼ አሳብ፤ ወሟግጥ፤ ወስርቅ፤ ወቅጥር፤ <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />አመንዝራነት፤ ወስገብገብ፤ ቡሼነት፤ ዋብላልጥ፤ ስድነት፤ ምቀኝነት፤ ሽም ዋጥፋ፤ ትዕቢት፤ ስንፍና ኖ። <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />ነዚሕኖ ቡሼ ቃሮች እንም በሰብ ሒን ይወጣ፤ የሰቢም ያረኩሽ።”<verse eid="MRK 7:23" /></para>
  <para style="s1">የአት ምሽት እምነት</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቴ. 15፥21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />ኢየሱስ በዛዬ ተነሣም ተጢሮስ<note caller="+" style="f"><char style="fr" closed="false">7፥24 </char><char style="ft" closed="false">አያሌ የድረ ቅጂዎች </char><char style="fqa" closed="false">ጢሮስ ሲዶናም</char><char style="ft" closed="false">ይብሪ ነነኖ</char></note> ከተማዬ ወረ፤ ታት ቤቴ ገባም በዛዬ ወንብረሑ ሟንም ኤይሑርᎄኸም ሸወ፤ ቢኸንም በዛዬ ወንብረሑ ይሼሜ አንቻለ። <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />ሒንጌም እንሲ ትኸዬታን በሩክስ መንፈስ የጠበጠባ አት ምሽት ስለ ኢየሱስ ሰማችም ቸኘች በግረሑም ᎈር ወጠቀች። <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />ምሽቲም ጨኘቴታንም ተሲሮፊኒቃዊያን ጐሳ የኸነች ግሪክ ባነች፤። ሒቲም ተትኸዬታን ጋኔኒ ያወጣናኸም የኢየሱስ ጮቀሰቹ። <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />ኢየሱስም፤ “የዴንጋዪ እንጄራ ወሰደም የጊየዎቺ ዋብ ተገቢ ያንከነ ስለኸነ፤ መጀመሪያ ዴንጋዪ ጦፎም የብሮ፤” ባረና።<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />ሒቲም ዠበረችም፤ “ኤክ ጔታኛ፤ ጊየዎችም በማዳ ተት ኸኖም የዴንጋ ትራፊ ይበሮ” ባረቹ።<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />ስለኸነም ኢየሱስ፤ “በዚ አዘነጔጔሽ ጋኔኒ በትኻሽ ወጣም ኧጌሽ ተቤታሼ ዌር!” ባረና።<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />ሒቲም ተቤቴታዬ ትትዠበር ትኸዬታን ባልጋ ᎈር ተገደረችም፤ ጋኔኒም ገፈረናም ረከበታ።<verse eid="MRK 7:30" /></para>
  <para style="s1">የጠንቋራዪ የዱዳዪም ፈያ ወሕን</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />በዛም ኢየሱስ በጢሮስ ገኝ ተነሣም፤ በሲዶና አዘር ሸከተም ዐሥር ከተማ<note caller="+" style="f"><char style="fr" closed="false">7፥31 </char><char style="ft" closed="false">የግሪኩ </char><char style="fqa" closed="false">ዴካፖሊስ </char><char style="ft" closed="false">ይቡን</char></note> ቢቡሪዪ ገኝ በወልፍ ተገሊላ ባሬ ቸኘ። <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />በዛዬም ሰቦች ጠንቋራ ዱዳም የኸነ አት ሰብ ተሑቲዬ አቸኖ፤ ኧጀሑም ይጨንወኸም ጮቀሶይ። <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />ኢየሱስም የምሲ ተሕዝቢ ላኘም በወሰደን አንቌ፤ አጤቤቶቸሑ ብንዝነሑ ኸና፤ በዛም እትፍ ባረም የምሲ አለመት ሙሻሸን። <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />ኢየሱስም ተሰሜዬ ተምሌከተም ጤለየ፤ “ኤፍታሕ!” ቧረን፤ ትርጉመሑም፤ “ተከፈት” ወበሩ።<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />ሒንጌም እንዝነሑ ተከፈቶ፤ አለመተሑ ተፈታ፤ አጣራም ወዘንግ ቀረሰ። <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />ኢየሱስ ዚ ዘንጋ የሟንም ኤዝነጎኸም ኤዘዘኖ፤ ቢኸንም ሑቲ ኤዝነጎኸም ቤዘዘኖ ቅጫ፤ ዘንጋዪ አቤተቶም ዝነጎ። <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />ሕዝቢም ስርመሑ በወደነቅ፤ “ይንም ቃር ፈያ ሸከተ! ጠንቋራዎቺም ይሰሞኸም፤ ዱዳዎቺ ይዝነጎኸም ሸከተም!” ባሮ።<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s1">ኢየሱስ አርበት ሺ ሰብ አበና</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቴ. 15፥21-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />በዛ ግዝየ፤ ዠበሮም ብዠ ሕዝብ ተስበሰበ። ይበሮይ አትም ስንቅ ዬነኖ ስለኸነ ደቀ መዛሙርተሑ ተሑቲዬ ጠራም፤ እኪ ባረኖ፤ <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“ቲያጌ ሦስት ከነ ዬከሶ በወሕነሕኖ ይበሮዪም ዬነኖ ስለኸነ ነዚሕኖ ሰቦች ያመጦኝ፤ <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />እኪ የትጋዶኸም ተቤተ ሕኖዬ ብንጌግቶ አታቶቺ በሩቄ የቸኖ ስለኸኖ ቤማ ᎈር ቌጦም ይወጥቆ።”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />ደቀ መዛሙርቲም ዠበሮም፤ “በዚ በረሐ ነዚሕኖ የዋብራ ያቸል እንጄራ ቤቴ ይቸኝ?” ባሮይ። <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />ሑቲም፤ “ምናሕር ቂጣ ነነናሑ?” ባረም ተሣለኖ። ሕኖም፤ “ሰበት ቂጣ ነነ፤” ባሮይ።<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />ሑቲም፤ ባፈር ᎈር ይቾኖኸም የሕዝቢ ኤዘዘ፤ ሰበቲ ቂጣ ጠበጠም ባምሰገነ አንቌ ፍረረመም የሰቦቺ ይሰዶኸም የደቀ መዛሙርተሑ አበኖ፤ ሕኖም የሕቢ አቀረቦ። <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />ዛምኸም ቅስስን ዓሣዎች ባነኖ፤ ሕኖም ዓሣዎቺ የእዝጌር ባምሰገነ አንቌ የሕዝቢ ያቀርቦኖኸም ደቀ መዛሙርተሑ ኤዘዘ። <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ሕዝቢም በኖም ጦፎ፤ በዛም ደቀ መዛሙርተሑ የተረፈዪ ፍርፋሪ ሰበት ሌማት ሙላ ነሦ። <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />በዛም አርበት ሺ ቅጫ ሰብ ባኖ፤ በጌገተኖም አንቌ፤ <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />ተደቀ መዛሙርተሑጌ በጀልባ ኸነም ዳልማኑታ ተቧሪ መደሬ ወረ።<verse eid="MRK 8:10" /></para>
  <para style="s1">ታምራት የወዥ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቴ. 16፥1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />ፈሪሳውያን ቸኖም ተኢየሱስጌ ይኦግቶ ቀረሶ። ይፌትኖዬም ሸዎም በሰሜ ምልክት ያቴዥኖኸም ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="MRK 12:38">12፥38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>። </char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />ኢየሱስም በመንፈሰሑ ስርም በውስጠሑ ስሜት በወቃት፤ “ዚ ጨኘት ምልክት ይሸ የመአሩ? የኢን ኧብርሑ፤ የዚ ጨኘት አትም ምልክት ኤይᎅ!” ባረ።<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="MRK 12:39">12፥39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፥29</ref>። </char></note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />በዛም ገፈረኖም በጀልባ ተዛዘሬ ተጔና።<verse eid="MRK 8:13" /></para>
  <para style="s1">የፈሪሳውያን የሔሮድስም እርሾ</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቴ. 16፥5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ደቀ መዛሙርተሑ ቂጣ ወጥብጥ የረሶ ስለኸነ፤ ተቁና ቂጣ አንኸንም በጀልባ ውስጥ አትም አነበረኖ። <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />ኢየሱስም “ተቀሮ፤ ተፈሪሳውያን ተሔሮድስም እርሾ ተቀሮ፤” ባረም ኤዘዘኖ።<note caller="-" style="x"><char style="xo" closed="false">8፥15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፥1</ref>። </char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />ሕኖም ነብስ በነብሰሕኖ፤ “እኪ ይብርነ ቂጣ ዬነነ ስለኸነው” ተበበሮ።<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />ኢየሱስም አሳበሕኖ ሐረም፤ እኪ ባረኖ፤ “ቂጣ ዬነነ ስለኸነው በወበር የመአር ትዝናጎ? ኧሗም አታጥራምቶ? ቀልብ አትብሮ? ወይሽ ሒናሑ ድነደነም? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />ዔን ትናነናሑ አታዞ? እንዝን ትናነናሑ አትሰሞ? አታስታውሶ?<note caller="-" style="x"><char style="xo" closed="false">8፥18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤር. 5፥21</ref>፤ <ref loc="EZK 12:2">ሕዝ. 12፥2</ref>፤ <ref loc="MRK 4:12">ማር. 4፥12</ref>። </char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />አምስት ቂጣ የአምስት ሺ ሰብ በፈረምኩ ግዝየ ምናሕር መሶብ ሙላ ትርፍራፊ ነሣሑ?”</para>
  <para style="p" vid="MRK 8:19">ሕኖም፤ “ዐሥረዄት” ባሮይ።<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“ሰበቲሽ ቂጣ የአርበት ሺ በፈረምኩ ግዝየ ምናሕር መሶብ ሙላ ትርፍራፊዪ ነሣሑ?” ባረኖ።</para>
  <para style="p" vid="MRK 8:20">ሕኖም፤ “ሰበት” ባሮይ።<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />ሑቲም፤ “ኧሗ ስን አናጥራመትኩ ወበሩ?” ባረኖ።<verse eid="MRK 8:21" /></para>
  <para style="s1">በቤተ ሳይዳ ወዥ ኤይችል ፈያ ወሕነሑ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />በዛም ተቤተ ሳይዳዬ ቸኖ፤ ቀል ሰቦችም አት ወዥ ኤይችል ተኢየሱሴ አቸኖም ይሙሻሽንኸም ጮቀሶይ። <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />ሑቲም ወዥ ዔይችሊ ኧጅ ጠበጠም ተሰፈር ውጪ አወጣን፤ ቤኖቸሑም ᎈር እትፍ ባረወም፤ ኧጀሑም በᎈረሑ ጫነወም፤ “ምን ይታዥኸ ቃር ነነ?” ቲብር ተሳለን።<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />ሑቲም ቀና ባረም አዠም፤ “ሰቦች የጨኸም ቲንቅለቅሎ አዥ” ባረ።<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />ኢየሱስም ዠበረም ኧጆቸሑ በምሲ ዔኖች ᎈር ጫነ፤ በዚ ግዝየ ዔኖቸሑ ተከፈቶ፤ ብራነሑም ተዠᎄረነ፤ እንም ቃር አጣራም ወዥ ቻለ። <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />በዛም፤ “ተመንደሪዬ አትግባ! በመንደሪም የሟንም አትዘንግ” ባረም ተቤተዄ ጔጐተን።<note caller="+" style="f"><char style="fr" closed="false">8፥26 </char><char style="ft" closed="false">የግዕዝ ገደሪ ጉዳ፥ በ 1947 ዓ. ም. ዬተᎁዪ የአማርኛ መጽሐፍ ቅዱስም፥ ባታት የድረ የግሪክ የጎጋ ጡሑፍ ይቄጥሊ ይደብሮ፦ </char><char style="fqa" closed="false">“በዛም ዚ የሟንም አታውድ”። </char></note><verse eid="MRK 8:26" /></para>
  <para style="s1">ጴጥሮስ ስለ ኢየሱስ የነᎄረን ወትረዳ</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቴ. 16፥13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፥18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ኢየሱስ ተደቀ መዛሙርተሑጌ ተፊልጶስ ቂሣርያ መንደሮቼ ወረ፤ ቤማም ᎈር ትናኖ ደቀ መዛሙርተሑ፤ “ሰቦች ይያ ሟ ይብሮኝ?” ባረም ተሳለኖ።<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />ሕኖም፤ “መጥምቂ ዮሐንስ ይብሮከ ባሮ፤ እንጐዲ ኤልያሱ ይብሮ፤ እንጐዲም ኧሗም ተነብዮች አቲው ይብሮከ፤” ቲብሮ ዠበሮነ።<note caller="-" style="x"><char style="xo" closed="false">8፥28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">ማር. 6፥14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፥7-8</ref>። </char></note><verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />ቄጠለም ኢየሱስ፤ “አሑሽ ሟ ትብሮኝ?” ቲብር ተሣለኖ። ጴጥሮስም፤ “አኸ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">8፥29 </char><char style="ft" closed="false">በግሪኪ </char><char style="fqa" closed="false">ክርስቶስ፣ </char><char style="ft" closed="false">በዕብራይስጢ </char><char style="fqa" closed="false">መሲሕ </char><char style="ft" closed="false">ይብሪ ቃል ትርጉም </char><char style="fqa" closed="false">የቀባ </char><char style="ft" closed="false">ወበሩ</char></note>ንከ፤” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">8፥29 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">ዮሐ. 6፥68-69</ref>። </char></note><verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />ኢየሱስም ስለ ሑቲ የሟንም ኤይዝነጎኸም አጥኔቀቀኖ።<verse eid="MRK 8:30" /></para>
  <para style="s1">ኢየሱስ ስለሞተሑ በደረም ወዘንጔሑ</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቴ. 16፥21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፥22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />በዛም የሰብ ትኸ ብዠ መከራ ይቄበርኸም፤ በባሊቆች፤ በካሕናት አለአዎችም የሕጊ አስተማሪዎች ይጐርጪኸም፤ ይቈጥሪኸም፤ በሦስት ከነም አንቌ ይትነሣኸም ያትመሮ ቀረሰ። <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />ሑቲም ዚ ቢልቢጢጦ ኤወደኖ። በዛ ግዝየ ጴጥሮስ የኢየሱስ የሟነሑ ወሰደንም ይጔስጭ ቀረሰ። <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />ኢየሱስም ዞር ባረም የደቀ መዛሙርተሑ ቲያዥ የጴጥሮስ፤ “አኸ ሼጣን፤ ቲያ አንቌዬ ወር! አኸ የሰቦቺ አንከንም የእዝጌር ቃር አቴስብ” በወበር ጔሰጠን።<verse eid="MRK 8:33" /></para>
  <para style="s1">የክርስቶስ ወትኸተል ያትኬፍል መሥዋዕትነት</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቴ. 10፥38-39</ref>፤ <ref loc="MAT 16:24-28">16፥24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፥23-27</ref>፤ <ref loc="LUK 14:25-27">14፥25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />በዛ አንቌ፤ ሕዝቢ ተደቀ መዛሙርተሑጌ ተሑቲዬ ጠራም እኪ ባረኖ፤ “ይትዄተሌ ይወድ ቢነብር ነብሰሑ የልጋ፤ መስቀሊም የጮርም የትኸተሌ፤<note caller="-" style="x"><char style="xo" closed="false">8፥34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቴ. 10፥38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፥27</ref>። </char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />ነብስያሑ<note caller="+" style="f"><char style="fr" closed="false">8፥35 </char><char style="ft" closed="false">የግሪኪ ቃል </char><char style="fqa" closed="false">ሕይወት</char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ነብስያ </char><char style="ft" closed="false">ወበር ይኸን። </char></note> ይወድ እንም ያጠፏን፤ ስለእያም ስለወንጌል ነብስያሑ ያጠፏን እንም ያተርፉ።<note caller="-" style="x"><char style="xo" closed="false">8፥35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቴ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:25">ዮሐ. 12፥25</ref>። </char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />ሰብ የዓለም ዱኒያ እንም የሑቲ ቢኸን ነብስያሑ ቢቀብጥ ምን ይጠቅሙ? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />ወሕነሑ፤ ሰብ የነብስያሑ ምን ዋጋ ነነን? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />በዚ ቢለጋ በአጢያተኘዪም ጨኘት ኢፍት ቢያ በቃለኛም ይሟልል እንም፤ እያም የሰብ ትኸ ባᎄች ክብር፤ ተቅዱሳን መላይካ ጌ ቲቸኝ በሑቲ ይማልሌ።”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="s1">የኢየሱስ መልክ ወሰገር</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቴ. 17፥1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፥28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />ቄጠለም ኢየሱስ፤ “የኢን ኧብርሑ፤ በዚ በቆሞዪ ግብት አታት የእዝጌር መንግሥት በሓይል ያዞ ስን ኤይᎀቶ አታቶች ነኖ፤” ባረኖ።<verse eid="MRK 9:1" /></para>
  <para style="s1">የኢየሱስ መልክ አምብራጣ</para>
  <para style="r">(<ref loc="LUK 9:28-36">ሉቃ. 9፥28-36</ref>፤ <ref loc="MAT 17:1-13">ማቴ. 17፥1-13</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />በስድስት ከነ አንቌ ኢየሱስ የጴጥሮስ፤ የያዕቆብም የዮሐንስ አትዄተለም ታት ገሊፍ ቈቶዬ ጠበጠኖም ወጣ፤ የሟነሕኖ ባኖ፤ ቢፍተሕኖም አምብራጣ።<note caller="-" style="x"><char style="xo" closed="false">9፥2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፥17-18</ref>። </char></note> <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />ልባሰሑም ባፈር ᎈር ሟንም ያጥቢ አጠበም ያነጣኔ ቤይችልወ ሐለት ስርም ነጨ ኸነ። <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />በዛም ግዝየ ኤልያስም ሙሴም ተኢየሱስጌ ቲዝናጎ ታዞዮ። <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />ጴጥሮስም የኢየሱስ፤ “አስተማሪ፤ በዚ ብንነብርነ ይና ፈያው፤ አት ያኸ፤ አት የሙሴ፤ አት የኤልያስ ይኸኖ ሦስት ዳስ ንሠክትነ” ቧረን። <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />ሦስቲ ደቀ መዝሙር ስርም የጔኖ ስለኸነ ጴጥሮስ ይዝነጊኒ ኤይሒር ባነ።<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />በዛም ዳበና ቸኘም ሼፈነኖ፤ በዳበናዪም ውስጥ፤ “ዚ ኧወጅጅ ትኸኛው፤ የሑቲ ስሞይ!” ይብር ጣምባ ቸኘ።<note caller="-" style="x"><char style="xo" closed="false">9፥7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቴ. 3፥17</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>። </char></note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ሒንጌም ዙሪያሕኖ ቲምሌከቶ ተኢየሱስ አንከንም ሟንም ተሕኖጌ አነበረ።<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />በቈቶዪም ᎈር ቢወርዶᎄም ግዝየ፤ የሰብ ትኸ በሞት ይትነሣ ስን ያዞዪ የሟንም ኤይዝነጎኸም ኤዘዘኖ።<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />ሕኖም የዝነጔኖዪ ቃል በሒነሕኖ ጠበጦም፤ ቢኸንም፤ “በሞት ወተንሣ” ምን ወበር የኸነኸም ነብስ በነብሰሕኖ ይዝናጎ ባነ። <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />በዛም፣ “የሕጊ አስተማሪዎች በደረም ወተኝ ያነወ ኤልያሱ የመአር ይብሮ?” ቲብሮ ተሣሎይ።<note caller="-" style="x"><char style="xo" closed="false">9፥11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>፤ <ref loc="MAT 11:14">ማቴ. 11፥14</ref>። </char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ኢየሱስም፤ እኪ ባረኖ፤ “ኤልያስ የኢንም በደረም ቸኘም እንም ቃር የነበረኸም ይሸክት፤ ኧጌሽ፤ የሰብ ትኸ ብዠ መከራ ወቀበር ወትገረጥም ያነወኸም የጣፈዪ የመአር ይመስሩሑ? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />ቢኸንም ኧብርሑ፤ ኤልያስሽ ቸኘም ባነ፤ ሕኖም ስለ ሑቲ በጣፈዪ መሠረት የሸዎዪ እንም ሸከቶᎄም።”<verse eid="MRK 9:13" /></para>
  <para style="s1">ሩክስ መንፈስ ያነወዪ ትኸ ፈያ ወሕነሑ</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቴ. 17፥14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፥37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ተቀኖዪ ደቀ መዛሙርቴ ተዠበሮም ቲቸኖ፤ ብዠ ሕዝብ ኸበቦይም፤ የሕጊ አስተማሪ ተሕኖጌ ቲኦግቶ አዞ። <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />ሕዝቢ እንም ቲያዞይ ሒንጌ ተዴነቆም ሰላም ይብሮዬ ተሑቲዬ ሮጦ። <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />ኢየሱስም፤ “ተሕኖጌ ቲኦግቶ የመአር ወባጀ ባነ?” ቲብር ተሣለኖ።<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />በሕዝቢ ግብት አቲ ሰብ እኪ ቧረን፤ “አስተማሪ፤ ሩክስ መንፈስ ጠᎄጠንም ዱዳ የኸነዪ ትኸኛ ታኸዬ አቸኘሑንም፤ <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />ቢትነሣወ ግዝየ እንም ያድጉ፤ አረፋ ይደፍቅ፤ ስነሑ ያፋጭ፤ ገገሑም ይደርቅ፤ ሩክሲ መንፈሲ ያትዌጦይኸም የደቀ መዛሙርታኸ ተሣልኩኖ፤ ሕኖም አንቻሎ።”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />ኢየሱስም ዠበረም፤ “አታምን ጨኘት፤ መቸ ስን ታሑጌ ኧነብር? መቸ ስን ኧፈርኩሑ? ትኸዪ ቲያዬ ናሞይ!” ባረኖ። <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />ሰቦቺም ተሑቲዬ አቸኖይ፤ ሩክሲ መንፈስም የኢየሱስ ባዠን ግዝየ የትኸዪ ሒንጌም አንጉደጐደን፤ ሑቲም ባፈር ᎈር ወጠቀም በወንፍራገጥም አረፋ ያዴፉቅ ቀረሰ። <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />ኢየሱስም የትኸዪ አባ፤ “በጠᎄጠን ምናሕር ግዝየውታው?” ባረም ተሳለን። ሑቲም እኪ ቧረን፤ “ተሰብዬነተሑ ቀረሰሙ፤ ቧረን። <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />ይቈጥሬም ሸም ብዠ ግዝየ በኧሳት በኧጋም ውስጥ ያድጉ፤ ቢኸንም አት ቃር ወሰክት ይቸልከ በኸነ ታውሽ ኧግዘነ!”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />ኢየሱስም “ይቸልከ በኸነ” ትብር? “ያምን ሰብ እንም ቃር ይቸል!” ቧረን።<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />ሒንጌም የትኸዪ አባ፤ “አምን፤ አለወምነኛ ርዴ!” በወበር ው ባረ።<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />ኢየሱስም ሕዝቢ ተዛዬ ተንጋጋም ቲሮጥ ወተኘሑ ባዠ ግዝየ፤ “አኸ ጠንቋራ ዱዳም መንፈስ ተሑቲ ውጣ! ተሗ ቀረሰም ተዠበርከም አትቡየወኸም ኤዝዝከ” ባረም የሩክሲ<note caller="+" style="f"><char style="fr" closed="false">9፥25 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቡሼ</char></note> መንፈስ ጔሰጠን።<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />ሩክሲም መንፈስ ው ቲብርም ቡሼኸም ባንፍራጐጠን አንቌ ተትኸዪ ወጣ፤ ብዠሕኖ “ᎀተም” ይብሮ ስን ትኸዪ የሬሳኸም ኸነ። <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />ቢኸንም ኢየሱስ ኧጀሑ ጠበጠም አትኔሣን፤ ትኸዪም ተነሣም ቈመ።<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />ኢየሱስም ተቤቴ በገባ አንቌ ደቀ መዛሙርተሑ የሟነሕኖ፤ “ኢና አወጣነዬ ያንቻልነ የመአሩ?” ባሮም ተሣሎይ።<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />ኢየሱስም፤ “እኪ ኸማቲ በጠሎት [በጦም]<note caller="+" style="f"><char style="fr" closed="false">9፥29 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">በጦም </char><char style="ft" closed="false">ይቡኒ ኤነኖ</char></note> ባከነ አኸንም በንጐድ ባትም ኤይወጣ” ቲብር ዠበረኖ።<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />በዛም ወጦም ኢየሱስም ደቀ መዛሙርተሑ ዛ መደር ገፈሮም በገሊላ አዘር ተቸለፎ፤ ያነወ መደርም ሟንም ሰብ ይሒርኸም ኢየሱስ አንሸ፤ <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ዚም የኸነ ኢየሱስ የደቀ መዛሙርተሑ፦ “የሰብ ትኸ በሰቦች ኧጅ ተችላለፈም ይቴብ፤ ሕኖም ይቀጥሮይ፤ በቀጠሮይ አንቌም በሦስታለኘዪ ከነ ይትነሣ።” ቲብር ያትመሮ ባነ።<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />ደቀ መዛሙርተሑም ዚ ዘንጋ አንገባኖ፤ ይሰሎዬ ጔኖይ።<verse eid="MRK 9:32" /></para>
  <para style="s1">ትንም ይበዛ ሟኒ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቴ. 18፥1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፥46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />ኢየሱስም ደቀ መዛሙርተሑ ተቅፍርናሖም ከተማዬ ቸኖ፤ ኢየሱስ ተቤቴ በገባ አንቌ ደቀ መዛሙርተሑ፦ “ቤማ ትናነሑ የኦገትኩᎄዪ ቃር መአር ባነ?” ቲብር ተሳለኖ።<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />ሕኖም እንቁስ ባሮ፤ ዚም ቤማ ትናኖ፥ “ትንመና ይበዛ ሟኒ?” ቲብሮ ይኦግቶ ባነ።<note caller="-" style="x"><char style="xo" closed="false">9፥34። </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፥24</ref>። </char></note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />ኢየሱስም በቾና አንቌ ዐሥረዄቲ ደቀ መዝሙር ጠራም፥ “መጀመሪያ ወሕን ይሸ ሟንም ሰብ ይንም ተት የሕን ይንም አገልጋይ ወሕን ነነወ፤” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቴ. 20፥26-27</ref>፤ <ref loc="MAT 23:11">23፥11</ref>፤ <ref loc="MRK 10:43-44">ማር. 10፥43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>። </char></note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />አት ሰብዬ አቸኘም በግብተሕኖ አቆᎀን፤ ዔንቀᎈንም እኪ ባረኖ፦ <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“ተዚሕኖ ጠቈኘት አቲ በሽመኛ ይቌበር እንም ይያ ይቌበሬ፤ ይያም ይቌበሬ ይቌᎄሪ ይያ ቴይኸን የላዄዪው” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቴ. 10፥40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10፥16</ref>፤ <ref loc="JHN 13:20">ዮሐ. 13፥20</ref>። </char></note><verse eid="MRK 9:37" /></para>
  <para style="s1">ኤይቃወመነ እንም ቲናጌው</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9፥49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />ዮሐንስም፤ “አስተማሪ፤ አት ሰብ በሽማኸ አጋንት ቲያወጣ አዠነ፤ ቲናጌ ያንከነ ስለኸነ ኸትርኔ” ቧረን።<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />ኢየሱስም እኪ ባረ፤ “በሽመኛ ታምር ሸከተም ሒንጌም ቢያ ᎈር ቡሼ ይዝነግ ዬነ ስለኸነ ግፍሮይ አትሕትሮይ፤ <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />ይና ኤይቃወመነ እንም ቲናጌው፤<note caller="-" style="x"><char style="xo" closed="false">9፥40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቴ. 12፥30</ref>፤ <ref loc="LUK 11:23">ሉቃ. 11፥23</ref>። </char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />የኢን ኧብርሑ፤ የክርስቶስ በወሕናሑ በሽመኛ ቁና ኩባያ ኧጋ ይብኩ ዋጋሑ ኤይቀብጥ።”<note caller="-" style="x"><char style="xo" closed="false">9፥41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቴ. 10፥42</ref>። </char></note> ባረኖ።<verse eid="MRK 9:41" /></para>
  <para style="s1">ይንጐዲ ቈፋ ወሕን</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቴ. 18፥6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፥1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“ሟንም ሰብ ቢያ ቢያምኖዪ ተዚሕኖ ተቅስስኖቺ አቲ ቲያሰት ይረዝ የወፍጨ እምን ባንገተሑ ᎈር ታገደም ተባሬ ቢያድጒ ይጠቁል። <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />ስለኸነም ኧጃኸ አጢያት ትሸክትኸም ቢያሰትከ ኧርጥም ኧድጉ! ዄት ኧጅ ትናነናኸም ተፍርድ ኧሳቴ ቢያድጉከ የጠቀለ ቈማጣ ኸንከም ተሕይወቴ ወግባ ይጠቅልኸ፤<note caller="-" style="x"><char style="xo" closed="false">9፥43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቴ. 5፥30</ref>። </char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />ተፍርድ ኧሳቴ ችረዪ ኤይᎀት፤ ኧሳቲ ኤይጠፋወ መደሩ።<note caller="+" style="f"><char style="fr" closed="false">9፥44 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 44 ይደብሮ፤ ቃሊም በቁ 48 ያነዪ ይመስር። </char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />ኧግራኸም ቢያሰትኸ ኧርጥም ኧድጉ፤ ዄት ኧግር ትናነናኸ ተፍርድ ኧሳቴ ተወድግ፤ ሸንካላ ኸንከም ተሕይወቴ ወግባ ይጠቅልኸ። <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />በፍርድ ኧሳት ችረዪ ኤይᎀት ኧሳቲ ኤይጠፋ<note caller="+" style="f"><char style="fr" closed="false">9፥46 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 46 ይደብሮ ቃሊም በቁ. 48 ያነዪ ይመስር። </char></note>። <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />ዔናኸም ቢያሰትከ አውጣም ኧድጉ፤ ዄት ዔን ትናነናኸ ተፍርድ ኧሳቴ ቲያድጉከ የጠቀለ ቁና ዔን ኸንከም ተእዝጌር መንግሥቴ ወግባ ይጠቅልኸ።<note caller="-" style="x"><char style="xo" closed="false">9፥47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቴ. 5፥29</ref>። </char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />ተፍርድ ኧሳቴ ችረዪ ኤይᎀትወ፤ ኧሳቲም ኤይጠፋወ መደሩ።<note caller="-" style="x"><char style="xo" closed="false">9፥48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">ኢሳ. 66፥24</ref>። </char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“መሥዋት ባሶ ያጠሬኸም እያታቲ ሰብ በሳት ወጥራ ነነወ። <note caller="+" style="f"><char style="fr" closed="false">9፥49 </char><char style="fqa" closed="false">ስላአሶ ስለ ኧሳትም ዋጥራ ወባጀ፦ </char><char style="ft" closed="false">ዘሌ. 2፥13፤ ሚል. 3፥2-3፤ ፊልጵ. 3፥17 ይትምሌኰች። </char></note><verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“አሶ ፈያው፤ የሕን አንኸንም ያሶነተሑ ታምናሑ በቀበጠ በመአር ይተምኸም ትሸክቶይ። በውስጣሑ ያሶኸም ይተም ፍቅር የንብርብኩ፤ ነብስ በነብሳሑ ተስማሞ በሰላም ንበሮ፤” ባረ።<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s1">የምስ የምሽትም ወትፋታ</para>
  <para style="r">(<ref loc="MAT 19:1-12">ማቴ. 19፥1-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />ኢየሱስ በዛ ተነሣም ተይሑዳ ገኜም በዮርዳኖስ ኧድየ ዛዘር ታነዪ ጭጭሳዪ ወረ፤ ሕዝቢም ዠበረም በዙራሑ ተስበሰበ፤ ተዚ ኢፍቴ ይሸኩች የነበረኸም አትመረኖ።<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />አታት ፈሪሳውያንም ቸኖም፤ “ሰብ ምሽተሑ ወፍታ ይጌቧን?” ባሮም ይፌትኖዬ ተሣሎይ።<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />ኢየሱስም ዠበረም፤ “ሙሴ ምን ባረም ኤዘዘናሑ?” ባረኖ።<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />ሕኖም፤ “ሙሴማ የፍቸዬታን የምስክር ወረቀት አበም ይፈታናኸም ፈአደም” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">10፥4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 5:31">ማቴ. 5፥31</ref>። </char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ኢየሱስም እኪ ባረኖ፤ “ሙሴ ዚ ሕጊ የጣፈክንኩ ሒናሑ ጀንጅን በወሕነሑ። <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />ቢኸንም ተኸልቀት መጀመሪያ ቀረሰም ‘እዝጌር ምስ ተምሽት ሸከተም ኸለቀኖ፤<note caller="-" style="x"><char style="xo" closed="false">10፥6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ዘፍ. 1፥27</ref>፤ <ref loc="GEN 5:2">5፥2</ref>። </char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />ስለኸነም ሰብ አᎄች ዳኰችም ገፈረም ተምሽተሑጌ ቁና ይኸኖ<note caller="+" style="f"><char style="fr" closed="false">10፥7 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ተምሽተሑ ጌ ቁና ይኸኖ </char><char style="ft" closed="false">ይብሪ ኤነኖ። </char></note>፤ <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ዄቲም አት ጅስም ይኸኖ፤’ በዛም ዛዘር ዄት ወሕነሕኖ ቀኘም ቁና ይኸኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዘፍ. 2፥24</ref>። </char></note> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />ስለኸነም እዝጌር ያትራከᎄን ሟንም ኤላይን።”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />ዠበሮም ተቤቴ በገቦ ግዝየ፤ ደቀ መዛሙርተሑ ዚም ነሦም ተሳሎይ። <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />ሑቲም፤ እኪ ቲብር ዠበረኖ፦ “ሟንም ምሽተሑ ፈታም ኧንጐዴታን ያገባ በሒቲ ᎈር ያምነዝር፤<note caller="-" style="x"><char style="xo" closed="false">10፥11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቴ. 5፥32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>። </char></note> <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />ሒቲም ምሴታን ፈታችም እንጐድ ብታገባ ታምነዝር” ባረኖ።<verse eid="MRK 10:12" /></para>
  <para style="s1">ኢየሱስ የጠቈኘቲ ወባርከሑ</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቴ. 19፥13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፥15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />ኢየሱስ ይሙሻሽኖኸም፤ ሰቦቺ የጠቈኘቲ ተሑቲዬ አቸኖ፤ ደቀ መዛሙርተሑም ጔሠጦዮ። <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ኢየሱስም ዚ ቲያዥ ማቸም እኪ ባረኖ፤ “ጠቈኘቲ ቲያዬ የተኖ፤ አትሕትሮዮ፤ የእዝጌር መንግሥት የዚሕኖኸም ያኖዪኖ። <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />የኢን ኧብርሑ፤ የእዝጌር መንግሥት የጠቈኘትኸም ኤይቌበር እንም ስርም ኤይገባወ።”<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቴ. 18፥3</ref>። </char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />ኢየሱስ የጠቈኘቲም ኤንቀፈኖ፤ ኧጀሑም ጫነም ባረከኖ።<verse eid="MRK 10:16" /></para>
  <para style="s1">ዱሬሻዪ አርዴ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቴ. 19፥16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፥18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />ኢየሱስ በዛም ተነሣም ኤማሑ ቲቀርስ፤ አት ሰብ ተሑቲዬ ቲሮጥ ቸኘ፤ ቢፍተሑም በጉልበተሑ ተንብረከከም፤ “ሜና አስተማሪ፤ የዘለዓለም ሕይወት የወውርስ መአር ወሰክት ይጌቤ?” ቲብር ተሳለን። <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />ኢየሱስም እኪ ቲብር ዠᎄረነ፤ “የመአር ሜና ትብሬ? ታቲ ተእዝጌር አንኸንም ሜና ኤነ፤ <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />ትዛዞቺ ቲሒር፤ ሕኖም አትቅጥር፤ አታመንዝር፤ አትስርቅ፤ በባጢል አትመስክር፤ አታብላልጥ፤ አባኸ ዳኳኸም አክብር።”<note caller="-" style="x"><char style="xo" closed="false">10፥19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ዘፀ. 20፥12-16</ref>፤ <ref loc="DEU 5:16-20">ዘዳ. 5፥16-20</ref>። </char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />ምሲም፤ “አስተማሪ፤ ነዚሕኖ እንም ተትኽነተኛ ቀረስኩም ቂየሑም” ቧረን።<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />ኢየሱስም ተምሌኰተንም ወደደን፤ “በይሽ አት ቃር ይቀብልኸ፤ ወርም ያነናኸዪ እንም አሰየ፤ የዜጋም አብ፤ በሰሜ የስበሰበ ዱኒያ ትረሕብ፤ በዛም አንቌ ኔኸ፤ ተዄተሌም” ቧረን። <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />ምሲም ዚ ቲሰማ ቡሼኸም አዘነ፤ ብዠ ዱኒያ የነᎄረን ስለኸነም ቲያዝን ወረ።<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ኢየሱስ ዙሪያሑ ተምሌከተም የደቀ መዛሙርተሑ፦ “የዱሬሻዎች ተእዝጌር መንግሥቴ ወግባ ምንኸም ያትሜካው!” ባረኖ።<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />ደቀ መዛሙርቲም በቃለሑ ተዴነቆ፤ ኢየሱስም ዠበረም እኪ ባረኖ፤ “ዴንጋ!<note caller="+" style="f"><char style="fr" closed="false">10፥24 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">በዱኒያ ይታመኖ </char><char style="ft" closed="false">ይብር ሐረግ ነነኖ። </char></note> ተእዝጌር መንግሥቴ ወግባ ምንኸም ምካቱ! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />ዱሬሻ ተእዝጌር መንግሥቴ ተወግባሑ የጠቀለ ጋሜላ በመርፍ ጉድ ቢቸለፍ ይጠቁል።”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />ደቀ መዛሙርተሑም የጠቀለ ተጌረሞም፤ “ኧጌ ሟ ይተርፌ ይችል?” ተበበሮ።<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ኢየሱስም ተሕኖዬ ተምሌከተም፤ “የኢንም ዚ ዘንጋ በሰቤ ኤይቸል፤ በእዝጌሬ እንም ይቸል” ባረኖ።<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />ጴጥሮስም፤ “ዘ ኢና እንም ቃር ገፈርነም ተዄተልነከም” ቧረን።<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ኢየሱስም ዠበረም እኪ ባረ፤ “የኢን ኧብርሑ፤ ይያ የወንጌልም ቲብር ቤተሑም ጐባቢቶቸሑም ኧተሟᎁቶቸሑም ዳኰችም አᎄችም ዴንጋሑም ኧርሻሑ የገፈረ እንም፥ <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ኧሗ በዚ ዘበን ተስደትጌ ቤቶች፥ ጐባቢት፥ ኧተሟᎁት፥ ዳኮ፥ ዴንጋ የእርሻ መቶ እጥፍ ኤይቌበር፤ ቢቸኚም ዓለም የዘለዓለም ሕይወት ይረሕብ። <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />የሕን አንኸንም የበደሮ የኸኖ ብዠሕኖ ያንቌዬ ይኸኖ፤ ያንቌዬ የኸኖዪም የበደሮ ይኸኖ።”<note caller="-" style="x"><char style="xo" closed="false">10፥31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቴ. 20፥16</ref>። </char></note><verse eid="MRK 10:31" /></para>
  <para style="s1">ኢየሱስ ደገመም ስለሞተሑ ተሞት ስለ ወተንሣሑም በደረም ዝነጔ</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቴ. 20፥17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፥31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />ኢየሩሳሌም የወውጣ ቤማ ᎈር ትናኖ፤ ኢየሱስ ኢፍት ኢፍተሕኖ ያር ባነ፤ ደቀ መዛሙርተሑ ተጌረሞ፤ እንጐዶቺ የትዄተሎይ ኧሗም ጔኖም ባነ። ኧሗም ዐሥረ ዄቲ ደቀ መዝሙር ተሕዝቢ ላኘም ምን ይሰላወኸም ኤወደኖ፤ <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />እኪም ባረኖ፤ “ኢየሩሳሌም ኧወጣነ፤ የሰብ ትኸ የካሕናት አለኦች አለአዎችም የሕጊ አስተማሪ አቼለፎም ይቴብ፤ ሕኖም የሞት ፍርድ ይፈርዶᎄ፤ አቸለፎም አይሑድ ያንከኖ ሰቦች አቸለፎም ይቦይ፤ <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />ይቄልዶᎄ፤ ይተፎᎄ፤ ይገርፎይ፤ በዛም ይቀጥሮይ፤ ሑቲም በሦስት ከነ አንቌ ይትነሣ።”<verse eid="MRK 10:34" /></para>
  <para style="s1">የያዕቆብ የዮሐንስም ወሳል</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቴ. 20፥20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />በዛም የዘብዴዎስ ዴንጋ ያዕቆብ ዮሐንስም ተሑቲዬ ቀረቦም፤ “አስተማሪ፤ እጮቅስከዪ እንም ትሸክትንነ ኸም ኧሸነ” ባሮይ።<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />ኢየሱስም፤ “ምን ኧሸክትንኩኸም ትሸዎ?” ባረኖ።<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />ሕኖም “በክብራኸ ግዝየ አተና በከነ፤ አተና በጉራ ኧቾናነኸም ፍቅድንነ” ባሮይ።<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />ኢየሱስም፤ “ትጮቅሶዪ አትሒሮ፤ እያ ኧሰጭኒ ጥወ ትሰጦዬ፤ እያሽ ኧጠᎀቊ ጥምቀት ትጠመቆዬ ትችሎ?” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ. 12፥50</ref>። </char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />ሕኖም፤ “ኤክ ኧችልነ” ባሮ። ኢየሱስም፣ “እያ ኧሰጭኒ ጥወ ትሰጦ፤ እያም ኧጠᎀቊ ጥምቀት ትጠመቆ፤ <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />ቢኸንም በከነኛ በጉራኛም ወቶና የዝጋጀኖዪ ይኸን አንከንም እያ ይᎅ ቃር አንከነ” ባረኖ።<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />የቀኖ ዐሥሪ ደቀ መዝሙር ዚ ቲሰሞ፤ ያዕቆብ ዮሐንስም ወማች ቀረሶ። <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />ኢየሱስም ቁናዬ ስበሰበም እኪ ባረኖ፤ “አይሑድ ያንከኖ የሕዝብ አለኦች ቧርዮም ይቴሰቦዪ ይገዞይኸም፤ ሹመሕኖም በሑቲ ᎈር ሥልጣነሕኖ ያቴዞኸም ቲሒሮ፤<note caller="-" style="x"><char style="xo" closed="false">10፥42-43 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፥25-26</ref>። </char></note> <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />ባሑዬም እኪ አንከነ፤ በግብታሑ ንቅ ወሕን ይሸ እንም አገልጋይ የሕን፤<note caller="-" style="x"><char style="xo" closed="false">10፥43-44። </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቴ. 23፥11</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="LUK 22:60">ሉቃ. 22፥60</ref>። </char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />የበደረ የወሕን ይሸ እንም፤ ይንም ጉዝ የሕን፤ <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />የሰብ ትኸ ያግለግሌ ሕይወተሑ የብዠሕኖ ሟኔ ሸከተም ይቤ ቸኘ አንኸንም ያግለግሌ አንተኘ።”<verse eid="MRK 10:45" /></para>
  <para style="s1">ኢየሱስ ወዥ ኤይችሊ የበርጤሜዎስ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቴ. 20፥29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፥35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />በዛ አንቌ ኢየሱስም ደቀ መዛሙርተሑምጌ ተኢያሪኮ ከተማዬ ቸኖ። ተቸለፎም በከተማዪ ወጦም ቢያሮᎄ ግዝየ ስርም ብዠ ሕዝብ ይትዄተል ባነ፤ ቤማ ᎀረ ኧሗም የጤሜዎስ ትኸ የኸነ በርጤሜዎስ ይቡሪ አት ወዥ ዔይችል ቾናም ይጮቅስ ባነ። <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />ሑቲም የናዝሬቲ ኢየሱስ ወሕነሑ በሰማ ግዝየ፤ “የዳዊት ትኸ፤ ኢየሱስ፤ ማሬ!” ቲብር ው ወበር ቀረሰ።<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />ብዠሕኖም እንቁስ ይብርኸም ጔሠጦይ፤ ሑቲም፤ “የዳዊት ትኸ፤ ማሬ!” ቲብር አበዛም ው ባረ።<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />ኢየሱስም ቈመም፤ “ጥሮይ” ባረኖ፤ ሕኖም ወዥ ኤይችሊ፤ “አይዞአኸ፤ ተንሣ፤ ይጠራኸው!” ባሮይ።<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />ሑቲም ልባሰሑ አደገም ዘለለም ብድግ በወበር፤ ተነሣም ተኢየሱሴ ቸኘ።<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ኢየሱስም፤ “ምን ኧሸክትንከኸም ትሸ?” ቲብር ተሳለን።</para>
  <para style="p" vid="MRK 10:51">ወዥ ኤይችሊም ሰብ፤ “አስተማሪ፤ ታውሽ ዔነኛ ያዥኸም ሰክትኒ” ቧረን።<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ኢየሱስም፤ “ወር፤ እምነታኸ አተረፈናኸም” ቧረን፤ ሒንጌም ዔነሑ ተከᎈተነ፤ ቤማም የኢየሱስ ተዄተለንም ወረ።<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s1">ኢየሱስ በወደል ክብር ተኢየሩሳሌሜ ገባ</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቴ. 21፥1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፥28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሐ. 12፥12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />ኢየሱስ ደቀ መዛሙርተሑም ኢየሩሳሌም በደብረዘይት ቈቶ ᎀረ ታኖዬ ተቤተ ፋጌዬ ተቢታንያዬም በቀረቦ ግዝየ፤ ኢየሱስ ተደቀ መዛሙርተሑ የዄቲ እኪ በወበር ላኸኖ፤ <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“ቢፍታሑ ታነዪ መንደሬ ወሮ፤ ሰብ ቶናወም ኤይሒር ይማር ደርማ በዛዬ ታገደም ትረሕቦይ፤ ፍቶም አተኖይ፤ <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />ሟንም፤ ሰብ ‘ምን ወሰክታሑ?’ ቢብርሑ፤ ‘የጔታ ያሸን፤ ሒንጌም ዠበረም ይለኩ’ በሮም አውዶይ።”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />ዄቲም ደቀ መዝሙር ወሮ፤ ባት ቤት ወረጀ ቤማ ᎈር ይማር ደርማ አጐጂም ረከቦይ፤ ፈቶይም። <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />በዛም በቆሞዪ አታት ሰቦች፤ “ደርማዪ የመአር ትፈቶይ?” ባሮዮ።<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />ደቀ መዛሙርተሑም ኢየሱስ የባረኖዪ የሰቦቺ ቤወዶዮ ግዝየ ፌቀዶኖ። <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />ደቀ መዛሙርተሑም ደርማዪም ተኢየሱሴ አቸኖም ልባሰሕኖ በጊንዠሑ ᎈር አወኖ፤ ሑቲም ቾናወ። <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />ብዠ ሰቦች ልባሰሕኖ ቤማ ᎈር ጬጮነ፤ ኧንጐዶቺ ኧሗም ለምለም የጨ ጫፍ አረጦም ይጉዘጉዞነ ባነ። <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />ቢፍቴ የበደሮዪ ባንቌሑም ይትዄተሎዪም በወደል ጣምባ፤ እኪ ይብሮ ባነ፤ “ሖሳዕና!<note caller="+" style="f"><char style="fr" closed="false">11፥9 </char><char style="ft" closed="false">በዕብራይስጢ </char><char style="fqa" closed="false">አትርፍ! </char><char style="ft" closed="false">ወበር ቲኸን ምስጋና ይገልጥ ይቡሪው፤ ዛምኸም ቁ 10 የዞ። </char></note> በጔታ ሽም ይቸኝ የትባረከው!<note caller="-" style="x"><char style="xo" closed="false">11፥9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">መዝ. 118፥25-26</ref>።</char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />ይቸኚ የአባና የዳዊት መንግሥት የትባረከው! ሖሳዕና በነን በሰሜ!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />ኢየሱስም ኢየሩሳሌም ሰላ፤ በዛም ተቤተ መቅደሴ ገባ፤ በዙሪያሑ ያነዪም እንም ተምሌከተ፤ ከነዪም የመሸ ስለኸነ ተዐሥራ ዄቲ ደቀ መዝሙርጌ ተቢታንያዬ ወረ።<verse eid="MRK 11:11" /></para>
  <para style="s1">ኢየሱስ የሰደᎄኒ የበለስ ኧጨ</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቴ. 21፥18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />የመናጊም በቢታንያ ቲዠበሮ ኢየሱስ ጓደን። <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />ቅጠሊም የልመለመ የበለስ ኧጨም በሩቄ አዠም የሟንᎀሑ ፍርየ ይትረከብወ የኸነኸም በወበር ተሑቲዬ ወረ፤ ቢኸንም ተሑቲዬ በቀረበ ግዝየ በለስ ያወርድወ ግዝየ ያነበረ ስለኸነ ተቅጠል እንጐድ አትም አረኸበወ። <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />ስለኸነም ኢየሱስ የበለሲ ኧጨ፥ “ተሗ ቀረሰም ሟንም ባኸ ፍርየ ኤይብራ!” ቧረን።</para>
  <para style="p" vid="MRK 11:14">ዚም ቲዝነግ ደቀ መዛሙርተሑ ሰሞ።<verse eid="MRK 11:14" /></para>
  <para style="s1">ኢየሱስ ቤተ መቅደሲ ዋጥዳሑ</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቴ. 21፥12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፥45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሐ. 2፥13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />ኢየሩሳሌም በሰሎ ግዝየ ኢየሱስ ተቤተ መቅደሴ ገባም በውስጠሑ ያስሮዪ፥ ይስሮዪም ሰቦች ያትዌጣ ቀረሰ፤ ዋጋ ይሸግሮዪ ጠረጴዛ ቡላል ያስሮዪም ሶረርም ግለበጠ፤ <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />ሟንም ሰብ አትም ግብር ጮረም በቤተ መቅደሲ ግቢ ውስጥ ይችላለፍኸም አንፈቀደ። <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />እኪም ቲብር አትመረኖ፤ “‘ቤተኛ የሕዝብ እንም የጠሎት ቤት ይቡሪ!’ ቧሪም አንጣᎉ? አሑ የወንበዴ ድብር ሸከትኩይ።” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">11፥17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፥7</ref>፤ <ref loc="JER 7:11">ኤር. 7፥11</ref>። </char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />የካሕናት አለኦቺ የሕጊ አስተማሪዎችም ዚ ቲዝነግ ሰሞይ፤ ሕዝቢ እንም በትምርተሑ ይዴነቆ የነበረ ስለኸነ ጔኖይ፤ ስለኸነም ምንኸም ሸከቶም ያጠፎይኸም መላ ይሸዎ ባነ።<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />በመሸ ግዝየ ኢየሱስም ደቀ መዛሙርተሑም በከተማ ወጦ።<verse eid="MRK 11:19" /></para>
  <para style="s1">የበለሲ ኧጨ ወጥርቅ</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቴ. 21፥20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />የመናጊ ቅረር ቤማ ቲቸለፎ፤ በለሲ ተነሥረሑ ጠረቀም አዞ። <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />ጴጥሮስም ዘንጋዪ ትዝ ቧረንም የኢየሱስ፤ “አስተማሪ፤ ዘ፤ የሰደᎄኒ በለስ ጠረቀም” ቧረን።<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ኢየሱስም ዠበረም እኪ ባረኖ፤ “በእዝጌር ኧምኖ<note caller="+" style="f"><char style="fr" closed="false">11፥22 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">በእዝጌር ᎈር እምነት ባነናሑ</char><char style="ft" closed="false">ይብሮ። </char></note>፤ <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />የኢን ኧብርሑ፤ ሟንም ዚ ቈቶ፤ ሰብ በሒነሑ ቴይጥራጠር ይሸኒ ቃር ይፌጠምነኸም አመነም ዚ ቈቶ ‘ተነቀልም ተባሬ ተረግ’ ቢቡን ዚም በሒነሑም ቴይጥራጠር ቢያምን ይዀነ።<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቴ. 17፥20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>። </char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />ስለኸነም በጠሎት ትጮቅሶዪ እንም የቄበርኩይኸም ሸከትኩም ብታምኖ ይኸንኩ። <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />ዛምኸም የጠሎት ብትቈምወ ግዝየ፤ የሰሜዪ አባሑ አጢያተሑ አፉ ይብርሑኸም፤ አሑም በሰብ ᎈር ያነናሑዪ እንም አፉ በሮ።<note caller="-" style="x"><char style="xo" closed="false">11፥25-26 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">ማቴ. 6፥14-15</ref>። </char></note> <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />[አፉ ባትብሮም የሰሜዪ አባሑ ያሑም አጢያተሑ አፉ ኤይብርኩ።”]<note caller="+" style="f"><char style="fr" closed="false">11፥26 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 26 ይደብሮ፤ ቃሊም በማቴ. 6፥15 ያነዪ ይመስር። </char></note><verse eid="MRK 11:26" /></para>
  <para style="s1">በኢየሱስ ሥልጣን ᎈር ጥያኤ ተነሣ</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቴ. 21፥23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፥1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />ዠበሮም ተኢየሩሳሌሜ ቸኖ፤ ኢየሱስም በቤተ መቅደሲ ውስጥ ቲዥዋወር ትናነ፤ የካሕናት አለኦች፤ የሕጊ አስተማሪዎች ባሊቆችም፥ ተሑቲዬ ቸኖም <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />“ነዚሕኖ ዘንጋ ትሸክት በመአር ሥልጣኑ? ነዚሕኖ ዘንጋ ትሸክትኸምሽ ዚ ሥልጣን ያበናኸ ሟኒው” ባሮይ።<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />ኢየሱስም ዠበረም እኪ ባረኖ፤ “እንዴ እያም አት ጥያኤ ንሳልኩ፤ ዘብሮኒ፤ እያም ነዚሕኖ ዘንጋ በመአር ሥልጣን ኧሸክትኸም ኢውድሑ። <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />የዮሐንስ ጥምቀት በእዝጌር ባነ ወይሽ በሰብ? ዘብሮኒ።”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />ሕኖም ነብስ በነብሰሕኖ እኪ ተበበሮ፤ “‘በእዝጌሩ’ ብንብርነ፣ ‘ኧጌሽ የመአር አነመንኩᎄ?’ ይብርነ፤ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />‘ኧጌሽ፤ በሰቡ’ ንበርነ?” ሕዝቢ እንም ዮሐንስ የኢነተኘ ነብይ ወሕነሑ ያምኖ የነበረ ስለኸነ ጔኖ። <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />ስለኸነም የኢየሱስ “አንሒርነ” ባሮም ዠበሮነ።</para>
  <para style="p" vid="MRK 11:33">ኢየሱስም፤ “ዛምኸም እያም ነዚሕኖ ዘንጋ በሟ ሥልጣን ኧሸክትኸም አንዊድሑ” ባረኖ።<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s1">የወይኒ አታሕልት ገበሬዎቺ ምሳሌ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቴ. 21፥33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፥9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />በዛም እኪ ቲብር በምሳሌ ይውዶ ቀረሰ፤ “አት ሰብ ወይን ቀበረ፤ ዙሪያዉታንም ኤጠረ፤ የወይን ይቆቁርᎄዪ ጐጀ ዀኘ፤ ይቁረᎄ ማማ ሸኰተነ፤ በዛም የገበሬዎች አክራኘም ትንጐድ ገኜ ወረ። <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />ፍርየ ቢለቅሙᎄ ግዝየ በወይኒ ፍርየ ያቸኝነኸም ተሜነተኞቺ አቲ ተገበሬዎቺዬ ላኸ። <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />ገበሬዎቺም ሜነተኘዪ ጠበጦም በወኮይ አንቌ፤ ባዶ ኧጀሑም ሰደዶይ። <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />ኧሗም ዠበረም ባለቤቲ እንጐድ ሜነተኘ ላኸ፤ ገበሬዎቺ ዚም ብምን ነቦም አትማለሎም ሰደዶይ”፤ <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />ኧሗም ዠበረም ኧንጐድ ላኸ፤ ዚዋኘም ቀጠሮይ፤ ትንጐዶቺ ተብዠሕኖዪ ግብት አታቶቺ ወኮ፤ አትባተሕኖም ቀጠሮ። <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />“ኧሗም ይለዂ እንጐድ ቧነን፤ ሑቲም ይወጅጂ ትኸኹ ባነ፤ ‘ትኸኛሽ ያከብሮይ’ በወበር ትንም አንቌ ላዀን።<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“ገበሬዎቺም ነብስ በነብሰሕኖ፤ ‘ዚማ ዋናዪ ወራሺው፤ ኔሑ ንቅጥርኔ፤ ርስተሑ ይና ይኸን’ ተበበሮ፤ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />በዛም ጠበጦም ቀጠሮይ፤ በወይኒ መደርም አወጦም አደጎይ።<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“ዛምኸም የወይኒ አታሕልት ባለቤት ምን ይሸክት ይመስሩሑ? ይቸኝ፤ የገበሬዎቺ ይቀጥር፤ የወይኒም አታሕልት የንጐዶቺ ይብ። <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />እኪ ይቡኒ የመጽሐፍ ቃል አናምበብኩ፤</para>
  <para style="q1" vid="MRK 12:10">“ ‘ግንበኞች የገረጦይ እምን፣</para>
  <para style="q2" vid="MRK 12:10">ሑቲ የማእዘን ጉነን ኸነ፤<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />ጔታ ዚ ሸከተም፣</para>
  <para style="q2" vid="MRK 12:11">ዚም የዔነና ድንቁ?’ ”<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />ምሳሌዪ የዝነጔኒ ስለ ሑቲ ወሕነሑ የሐሮ ስለኸነ፣ ይጠብጦዬ ሸዎ፤ ቢኸንም የሕዝቢ የጔኖ ስለኸነ ገፈሮይም ወሮ።<verse eid="MRK 12:12" /></para>
  <para style="s1">የቄሳር ግብር ስለወክፍል</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቴ. 22፥15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፥20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />በዛም በዘንጋ ያጠምዶይኸም ተፈሪሳውያን ተሔሮድስም ጐሳ ሰቦች ተሑቲዬ ላሖ። <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />ሕኖም ቸኖም እኪ ባሮይ፤ “አስተማሪ፤ አኸ ሱት ሰብ ወሕናኸ ኧሒርነ፤ የሰቦች ሟንነት ግድ ኤይብርከ ስለኸነ አታዳላ፤ የእዝጌር ኤማ ጠለለ የኢን ታትመር፤ ወሕነሑ የቄሣር ግብር ወክፍል ይጌባ? ወይሽ ኤይጌባ? <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />ኢናሽ ንክፍልነ ወይሽ አንክፍልነ?” ኢየሱስም ግብዝ ወሕነሕኖ ሐረም፣ “የመአር ታጠምዶኜ ትሸዎኝ? እንዴ ቁና ዲናር አተኖኒም ነዥን” ባረኖ። <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />ሕኖም አቸኖነ፤ “ዚ የሟ መልኩ? ጥፈቲሽ የሟኒ?” ባረኖ? ሕኖም “የቄሣሩ” ባሮይ። <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />ኢየሱስም፣ “የቄሣሪ የቄሣር፣ የእዝጌሪ የእዝጌር አቦ” ባረኖ። ሕኖም በሑቲ ተዴነቆ።<verse eid="MRK 12:17" /></para>
  <para style="s1">ጋብቻም ትንሣኤ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቴ. 22፥23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፥27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />በዛ አንቌ የሟቾቺ ትንሣኤ ኤነ ይብሮ ሰዱቃውያን ተሑቲዬ ቸኖም እኪ ቲብሮ ተሣሎይ፤ <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“አስተማሪ፤ ያት ሰብ ጐቤ ምሽት አገባም ትኸ ቴይጨኝ ቢᎀት፤ ዚ ሰብ የምሽቲ ቢወርሳ የጐቤች ዘር የሰጉርነ ባረም ሙሴ ጣፈንነም።<note caller="-" style="x"><char style="xo" closed="false">12፥19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዘዳ. 25፥5</ref>። </char></note> <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />ኧጌሽ ሰበት ጐባቢት ባኖ፤ የመጀመሪያዪ አገባናም ትኸ ቴይጨኝ ᎀተ፤ <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ዄታለኘዪም የምሽቲ አገባና፤ ሑቲም ዘር ቴይሸግር ᎀተ፤ ሦስታለኘዪም ዛምኸም ኸነ፤ <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ሰበቲም አገቦያም፤ ዘርም አንሰገሮ፤ በመጨረሻም ምሽቲ ᎀተች። <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />ኧጌሽ፤ ሰበቲም አገቦያም በትንሣኤ<note caller="+" style="f"><char style="fr" closed="false">12፥23 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">በትንሣኤ ሰቦች በሞት ቲነሶ </char><char style="ft" closed="false">ይብር ነነኖ </char></note> የሟነሕኖ ምሽት ትኸኔ ው?” ባሮይ።<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ኢየሱስም፤ እኪ ቲብር ዠበረኖ፤ “ትዳሎ የቅዱሳን መጥሐፎችም የእዝጌር ቆት አትሒሮ ስለኸነው! <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />ሟቾቺ ቢትነሦᎄ ግዝየ የሰሜ መላይካኸም ይኸኖ አንከንም ኤያገቦም፤ ኤይጋቦምም። <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />የሟቾቺ ወተንሣ ተኸነ የኸነኸም እዝጌር የሙሴ ተቁጥቋጦዪ ኧሳት ውስጥ መአር የዝነጔንኸም ተሙሴ መጽሐፍ አናምበብኩ? ዚም ‘እያ የአብርሐም አምላክ፥ የይስሐቅ አምላክ፥ የያዕቆብ አምላክንኩ፤’ የቧረኒው።<note caller="-" style="x"><char style="xo" closed="false">12፥26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ዘፀ. 3፥6</ref>። </char></note> <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />እዝጌር የሕያዋን አምላኩ አንከንም የሟቾቺ አምላክ አንከነ፤ ስለኸነም ስርም ተዳላሑም።”<verse eid="MRK 12:27" /></para>
  <para style="s1">ትንም ይበዛዪ ትዛዝ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቴ. 22፥34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />የሕጊ አስተማሪዎቺም አቲ ቸኘም ቲኦግቶ ሰማኖ፤ ኢየሱስ የቀረᎄነዪ ጥያኤ ይጌባዪ መልስ ዋበሑ አጥራመተም፤ “ወሕነሑ ተትዛዞቺ እንም ይበዛዪ ኤቲዋኘው?” ቲብር ተሣለን።<note caller="-" style="x"><char style="xo" closed="false">12፥28-34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>። </char></note><verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ኢየሱስም እኪ ቲብር ዠᎄረነ፤ “ትንም ይበዛዪ ዚቱ፤ ‘እስራኤል ስማ፤ ጔታ አምላክም ቁና ጔታው፤ <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />አኸም ጔታ አምላካኸም በፍጡም ሒናኸ፤ በፍጡም ነብስያኸ፤ በፍጡም አሳባኸም በፍጡም ቆታኸ ውጅጅ።’<note caller="-" style="x"><char style="xo" closed="false">12፥29-30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ዘዳ. 6፥4-5</ref>። </char></note> <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />ዄታለኛዪም ትዛዝ ዚቱ፤ ‘ሰብ እንም የነብሳኸኸም ውጅጅ።’ ተዚሕኖም ይበዛ ትዛዝ ኤነ።”<note caller="-" style="x"><char style="xo" closed="false">12፥31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዘሌ. 19፥18</ref>። </char></note><verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />የሕጊ አስተማሪዪም እኪ ቧረን፤ “አስተማሪ፤ ፈያ ባኸም፤ ሑቲ ቁና ወሕነሑ፤ ተሑቲም እንጐድ አለወምብረሑ ወዘንጋኸ ሱቱ፤<note caller="-" style="x"><char style="xo" closed="false">12፥32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ዘዳ. 4፥35</ref>። </char></note> <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />የእዝጌር በፍጡም ሒናኸ፤ በፍጡም አእምሮአኸ፤ በፍጡም ነብስያኸ፤ በፍጡም ቆታኸ ወውድድ፤ ዛምኸም ሰብ እንም የነብስያኸኸም ወውድድ ቲነድ መሥዕዋት እንም ትንጐዶቺም መሥዋዕቶቺ ይበዛ።”<note caller="-" style="x"><char style="xo" closed="false">12፥33 </char><char style="xt" closed="false"><ref loc="MRK 6:6">6፥6</ref>። </char></note><verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />ኢየሱስም በዋጥራምት የዠᎄረነኸም አዠም፤ “አኸ በእዝጌር መንግሥት የራቅከ አንከንከ” ቧረን። በዛ አንቌ ይሰሌ የደፈረ ሟንም አነበረ።<verse eid="MRK 12:34" /></para>
  <para style="s1">ክርስቶስ የሟ ትኸው?</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቴ. 22፥41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20፥41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />ኢየሱስ በቤተ መቅደሲ ጠባ ቢያትመርወ ግዝየ እኪ ቲብር ጥያኤ አቀረበ፤ “የሕጊ አስተማሪዎችም ምንኸም ‘ክርስቶስ የዳዊት ትኸው፤’ የመአር ይብሮ? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />ዳዊት ነብሰሑ በመንፈስ ቅዱስ ተመራም፥ ቲዝነግ</para>
  <para style="q1" vid="MRK 12:36">“ ‘እዝጌር የጔታኛ (የመሲሒ)፥</para>
  <para style="q2" vid="MRK 12:36">መሶአኸ በግራኸ ተት ኧሸክትንከ ስን</para>
  <para style="q2" vid="MRK 12:36">በከነኛ ቶና፤’ ቧረንም።<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />ኧጌሽ ዳዊት ነብሰሑ ‘ጔታ’ በቧረን፣ ምንኸም ተዠበረም ትኸኹ ይኸን?” ብዠ ሕዝብም በብልቃት ይሰሟን ባነ።<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />ኢየሱስ ቲያትመር እኪ ባረ፤ ተሕጊ አስተማሪዎች ተቀሮ፤ ሕኖ “ገሊፍ ቀሚስ ለበሶም ወዦር ይወዶ፤ በየጠባዪም የክብር ሠላምታ ይሸዎ፤ <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />የአይሑድ ጠሎት ቤት ከፍ የባረዪ ሶረር፤ በግብዣም መደር የክብር መደር ይሸዎ፤ <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />በገሊፍ ጠሎተሕኖ መሳ በወሰክት ምስ የᎀተበማ እንሽታዎች ቤት ያራቁቶ፤ ነዚሕኖ የሕኖ የባሰ ፍርድ ይቌበሮ።”<verse eid="MRK 12:40" /></para>
  <para style="s1">የመበለቲ ስጦታ</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21፥1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />ኢየሱስ ዋጋ ቢያወነᎄዪ ሣጥን ኢፍት ሊፍት ቾናም ብዠ ሰቦች ስጦታሕኖ ተቤተ መቅደሲዬ ዋጋ ያወነᎄዪ ሣጥን ቲኸሮ ይትምሌከት ባነ። ብዠ ዱሬሻዎች ብዠ ዋጋ ኸኖ፤ <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />አቲዬታ ዜጋ መበለትም ቸኘችም ዄት ፈረንክ ቅጫ የናስ ዋጋ ኸናች። <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />ኢየሱስ የደቀ መዛሙርተሑ ጠራም፤ እኪ ባረኖ፤ “የኢን ኧብርሑ፤ ዚዬታ ዜጋ መበለት በሣጥኒ ውስጥ ባደጎይ ትንጐዶቺ ይበዛ ኸናች። <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />እንጐዶቺ እንም ያቦ ባነኖ ዱኒያ የተረፈኖዪው፤ ሒቲም ዜጋ ኸነችም ትናነች አትም ታታቀይ ያነናዪ እንም አበች።”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s1">የመጨረሻዪ ዘበን ምልክቶች</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቴ. 24፥1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፥5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />ኢየሱስ በቤተ መቅደስ ቲወጣ ተደቀ መዛሙርተሑ አቲ፤ “አስተማሪ፤ እምኖቺ ምንኸም የኸኖኸም፤ ግንብ ቤት ምንኸም ይደንቅኸም” ኧዥ። <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />ኢየሱስም ዠበረም፤ “ነዚሕኖ ግድድር የግነቦ ቤቶች ታዥ? አቲ እምን ብንጐዲ እምን ᎈር ኸነም ኤይቀይ፤ እንም ይፈርስ” ቧረን።<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />ኢየሱስ በቤተ መቅደሲ ኢፍት ሊፍት፤ በደብረ ዘይት ቈቶ ᎈር ቾናም ትናነ ጴጥሮስ፤ ያዕቆብ፤ ዮሐንስም እንድርያስ እኪ ቲብሮ ተሳሎይ፤ <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“ዚ መቸ ይኸንኸም አውድነ፤ የዚሽ እንም ፍጣሜ ምልክተሑ መአሩ?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />ኢየሱስም እኪ ይብኖ ቀረሰ፤ “ሟንም ኤያሰሰትሑኸም ተቀሮ፤ <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />ብዠሕኖ፤ ‘እያ ክርስቶስንኩ’ ባሮም በሽመኛ ይቸኖ፤ ብዠሕኖም ያሰቶ። <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />አርብ ያርብ ኦጀም ብትሰሞᎄ ግዝየ አትደንብጦ፤ ዚ ይኸኔ ግዱ፤ ፍጣሜውታንም ገናው። <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />ሕዝብም በሕዝብ ᎈር፤ መንግሥትም በመንግሥት ᎈር ይትነሣ፤ በብዠ መደርም ያፈር ወንቀጥቀጥ ጋጀም ይኸን፤ ነዚሕኖ እንም የመጥ ጣር መጀመሪያዪኖ።<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“የራሳሑ ተቀሮ፤ የጭጭሳዪ ጀᎈር አቸለፎም ይቦኩ፤ ተሙኩራብ ምኩራብ ይገርፎኩ፤ ምስክር ትኸኖዬም ቢያ መሳ በገዢዎች በነገሥታትም ኢፍት ትቈሞ።<note caller="-" style="x"><char style="xo" closed="false">13፥9-11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቴ. 10፥17-20</ref>። </char></note> <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />ዚ ተወሕነሑ ኢፍት ወንጌል የሕዝብ እንም ወሰበክ ነነወ። <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />ተጠበጥኩም የፍርድ ብትቀርቦᎄ ግዝየ፤ በዛ ሰዓት ይብኩዪ ዘንጎ አንኸንም ምን ኧዝነግነ በወበር በደርኩም አትጨነቆ፤ ይዝነጊ መንፈስ ቅዱሱ አንኸንም አሑ አንከንኩ።<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />“ጐቤ የጐቤች፤ አብም የትኸሑ የሞት አቸለፈም ይብ፤ ዴንጋም በወላጆቸሕኖ ᎈር ዬምጦ፤ ይቀጥሮዮም። <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />ቢያ መሳ በሰብ እንሜ የጠላሑ ትኸኖ፤ መጨረሻ ስን በትዕግሥት ይጠናም ይተርፍ።<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“‘የጥፋት ሩክሰት’ መደረሑ ባንከነ መደር ቈመም ያነቢ ያጥራምት፤ በይሑዳ ያኖ ተቈቶዎቼ የስኮ፤ <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />በቤት ቁሬት ᎈር ያነ ኤይውረድ፤ ዱኒያሑም የዋውጣ ተቤተዄ ኤይግባ፤<note caller="-" style="x"><char style="xo" closed="false">13፥15-16 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፥31</ref>። </char></note> <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />በእርሻዪ መደር ያነ ልባሰሑ የወውስድ ኤዘበር። <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />በዚሕኖ ከነዎች የዄት ነብስም ያጦበማዪ ወዮሕነማ! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />ዚም በበርግ ኔይኸንከም ጠልዮ፤ <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />በመጀመሪያ እዝጌር ኸልቀቶቺ በኸለቀወ ግዝየ ቀረሰም ኧሗ ስን፣ ዛምኸም ኧሗም ቲፍቴዬ ታዠም ኤይትኴር ወደል መከራ ይኸን። <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />ጔታ የከነዎቺ ቤያቴጥሮ ሟንም ባንተረፈ ባነ፤ የትሜጠሮ ስለኸነ ስለምርጦቺ ቲብርም ከነዎቺ አቴጠረኖም። <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />በዛ ግዝየ ሟንም፤ ‘ዘ፤ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">13፥21 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">መሲሑ።</char></note> በዚዬው?’ ቢብሮኩም፣ ‘ዘ፤ በዛዬው’ ቢብርኩ አትምኖ። <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />ባጢለተኘ ክርስቶሶች ባጢለተኘ ነብዮችም ተነሶም፤ ምልክቶች ድንቆችም በወሰክት፤ ቢቸሎ የትሜጠሮዪ ያሰቶ። <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />ስለኸነም ተቀሮ፤ ግዝየሑ ቴይሰላ እንም ኤወደኩሑም።<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />“በዛ ግዝየ፥ በዛ እንም መከራ አንቌ፥ ጬት ይጨልም ጠራቃም ብራነሑ ኤይብ፤ <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />ኰኰቦቺም በሰሜ ይረግፎ፤ የሰሜ አይለኞቺም ይትናወጦ።<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />“በዛ ግዝየም የሰብ ትኸ በወደል ቆት ግርማም በዳበና ቲቸኝ ያዞይ። <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />ሑቲም መላይካዪ ላኸም ተአርበቲም አቅጣጫ ወሮም ተአፈሪ ተሰሜዪም ጥግ ስን ይትረከቦዪ፥ የሑቲ የትሜጠሮዪ ሰቦች ይስበሰቦ።<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“ምሳሌዪ ተበለስ ተማሮ፤ ጫፈሑ ቲልመልም፣ ቅጠለሑም ቲያቁጠቁጥ አባር የቀረበኸም ቲሒሮ፤ <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />ዛምኸም ኧሗ ነዚሕኖ ቃር ወፈጠመሕኖ ትታዞ የቀረበኸም፣ በወረጀም የኸነኸም ሐሮ። <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />የኢን ኧብርሑ፤ ነዚሕኖ ዘንጋ ይትፌጠሞ ስን ዚ ጨኘት ኤያልፍ፤ <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />ሰሜዪም አፈሪ ይቸለፎ፣ ቃለኛም ኤያልፍ።<verse eid="MRK 13:31" /></para>
  <para style="s1">ከነዪ ሰዓቲም ኤይትኴር</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቴ. 24፥36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“ቢኸንም ስለዛ ከነም ስለዛም ሰዓት ተአብ አንኸንም፤ የሰሜ መላይካም ቢኸኖ፤ ወልድም ቢኸን፤ ሟንም ኤይሒር።<note caller="-" style="x"><char style="xo" closed="false">13፥32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቴ. 24፥36</ref>። </char></note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />ስለኸነም ግዝየሑ መቸ ይኸንከም አቲሒሮም ተቀሮ፤ ተጋደሎም፣ ጠልዮ<note caller="+" style="f"><char style="fr" closed="false">13፥33 </char><char style="fqa" closed="false">ጠልዮ </char><char style="ft" closed="false">ይብሪ አታት ቅጂዎች ኤይደብሮ ኤይትረከብ። </char></note>። <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />ዚም ቤተሑ የአገልጋዮቸሑ ገፈረም፣ እያታቲ አገልጋይ በትልያየ የሜና አላፊ ᎈር ሜደበም፣ ዘበኘዪም ተጋደለም ይቅየኸም ኤዘዘን። <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />ኧጌሽ የቤቲ ባለቤት በምሳር ቢኸንም በግብት ምሳር፣ ኩተና ቲኖቅ ጬት ቲወጣ ይወጣኸም አቲሒሮ ተጋደሎም ቀሮ፤ <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ሒንጌም በድንገት ቲቸኝ ተገደርኩም ኔረሕብሑ፤ <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />ያሑ ኢውድሑዪ የሰብ እንም ኧዝነግ፤ ተጋደሎም ቀሮ!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s1">በኢየሱስ ᎈር የሸከተ ሴራ</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቴ. 26፥1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፥1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሐ. 11፥45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />ፋሲካ የቂጣ በዓልም ይከበሬ ዄት ከነ ቲቈይን፤ የካሕናት አለኦች የሕጊ አስተማሪዎችም የኢየሱስ ይጠብጦᎄ ይቀጥሮᎄም ብላት ይሸዎ ባነ።<note caller="-" style="x"><char style="xo" closed="false">14፥1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-7">ዘፀ. 12፥1-7</ref>። </char></note> <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />ቢኸንም፤ “ሕዝቢ ዐመጥ ኤያትኔሣኸም በበዓሊ ሰሞን ወሕን ኤነወ” ይትገገዞ ባነ።<verse eid="MRK 14:2" /></para>
  <para style="s1">የኢየሱስ ሽቶ የቀባቹ ምሽት</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቴ. 26፥6-13</ref>፤ <ref loc="JHN 12:1-8">ዮሐ. 12፥1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />ሑቲም በቢታንያ በለምጣሚ በስምዖን ቤት በማዳ ቾናም ትናነ፤ አት ምሽት ዋጋዪ ስርም ውድ የኸነ ንጡ የናርዶስ ሽቶ የᎀላወ የአልባስጥሮስ ብልቃጥ ጠበጠችም ቸኘች፤ ብልቃጢም ሰበረችም ሽቶዪ በኢየሱስ ጉነን ᎈር አፈሰሰቹ።<note caller="-" style="x"><char style="xo" closed="false">14፥3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፥37-38</ref>። </char></note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />በዛዬ በነበሮዪ አታቶቺ በሸከተዪ ማቶም እኪ ይትገገዞ ባነ፤ “ሽቶዪ የመአር ቤድገልል ቃር ይባክን? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />ተሦስት መቶ ዲናር ነን ተስየም፤ ዋጋዪ የዜጋዎች ዋብ ይቸል ባነ።” ተበበሮ፤ ምሽቲም ገረጦያ።<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ኢየሱስም እኪ ባረኖ፤ “ግፍሮያ፤ የመአር ታትሜኮያ? ፈያ ቃር ሸከተትኒም። <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />ዜጋዎች ሟንምጌ ታሑጌ ኖ፤ በሸሑ ግዝየ ታግዞዮዬ ትችሎ፤ እያም እንጌ ታሑጌ አንነብር፤<note caller="-" style="x"><char style="xo" closed="false">14፥7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዘዳ. 15፥11</ref>። </char></note> <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />ሒቲ ወሰክት ይቸላ ቅጫ ሸከተችም፤ የቀብረኛ ይኸንከም ገገኛ በደረችም ቀባችም። <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />የኢን ኧብርሑ፤ ዚ ወንጌል በዓለም እንም ቢሰበክወ በሟንም መደር ሒቲ የሸከተቹ ይዘጉጅᎄ ኸነም ይቴወድና።”<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />በዛ አንቌ ተዐሥረ ዄቲ ደቀ መዝሙር አቲ የኸነዪ የአስቆሮቱ ገኝ ይሑዳ አቸለፈም ይᎆ ተካሕናት አለኦቼ ወረ። <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ሕኖም ዚ ቲሰሞ ተብላለቆ፤ ዋጋ ይቦዬም ቃል ገቦነ፤ ስለኸነም የሑቲ አቸለፈም ይቡᎄዪ የትሜቸ ግዝየ ይቅየ ባነ።<verse eid="MRK 14:11" /></para>
  <para style="s1">የጔታ ኧርባት</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቴ. 26፥17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፥7-14</ref>፣<ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሐ. 13፥21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />የፋሲካ ኧጤ ቢያርዶᎄ በቂጣ በዓል የመጀመሪያ ከነ፤ ደቀ መዛሙርተሑ ተኢየሱሴ ቀረቦም፦ “የፋሲካ ኧርባት የወብራ ቴቴ ወርነም አዝጋጅነንከኸም ትሸ?” ቲብሮ ተሳሎ።<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ሑቲም ተደቀ መዛሙርተሑ ዄቲ እኪ ቲብር ላኸኖ፤ “ተከተማዬ ወሮ፤ ወሸን ኧጋ የጮረ ሰብ ትረክቦ፤ <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />ቲገባወ ቤቴም ተዄተሎይ፤ የቤቲም ጌቶች፤ ‘አስተማሪዪ፤ ተደቀ መዛሙርተሑጌ የፋሲካ ኧርባት ኧበራወ የባዘና ያᎈይወ ኤቲዋኘው?’ ባረም በሮይ፤ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />ሑቲም በፎቅ ᎈር የዝጋጀዪ የጬጨዪም በተት አዳራሽ ያቴዥሑ፤ በዛዬ አዝጋዶኒ።”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />ዄቲ ደቀ መዝሙር በዛም ወጦም ተከተማዬ ወሮ፤ ኢየሱስ የባረኖኸም ረከቦይ፤ የፋሲካም ኧርባት በዛ አዝጋዶ።<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />በመሸ ግዝየ ኢየሱስ ተዐሥረ ዄቲጌ ቸኘ። <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />በማዳ ᎈር ትናኖ ኢየሱስ፤ “የኢን ኧብርሑ፤ በግብታሑ አቲ፤ ቲያጌ ይበራዪ ሑቲ አቸለፈም ይቤ” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">14፥18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>። </char></note><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />ሕኖም አዘኖ፤ አትባተሕኖም፤ “እያ ኧኸን?” ይብሮይ ቀረሰ።<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />ኢየሱስም እኪ ባረኖ፤ “ተዐሥረ ዄቲ አቲ፤ ቲያጌ ኧጀሑ በወጨቲ ይኸራዪው። <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />የሰብ ትኸሽ ስለ ሑቲ የጣፈኸም ያር፤ የሰብ ትኸ አቸለፈም ይብ የዛ ሰብም ወዮውታ፤ ዛ ሰብ ቤጨኝ ይጠቁል ባነ።”<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />ቲበሮም ቂጣዪ ነሣም ባረከ፤ ፍረረመም የደቀ መዛሙርተሑ አበም፤ “የሑ፤ ዚ በሠረኛው” ባረኖ፤<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />ጥወዪም ነሣም፤ አምሰገነም አበኖ፤ እንም በዛ ሰጦ። <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />ኧሗም እኪ ባረኖ፤ “ዚ ስለብዠሕኖ ይፈስ የቃል ጉዳ ደመኛው፤<note caller="-" style="x"><char style="xo" closed="false">14፥24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ዘፀ. 24፥8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">14፥24 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ገደር ይብሪ </char><char style="ft" closed="false">ቃል ኤነኖ። </char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />የኢን ኧብርሑ፤ በእዝጌር መንግሥት በገደሪ ወይን ኧሰጭ ስን በዚ የወይን የቆቈሪ ዠበርኩም አንሰጭ።”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />በዛ አንቌ መዝሙር ዜመሮም ተደብረ ዘይት ቈቶዬ ወጦ።<verse eid="MRK 14:26" /></para>
  <para style="s1">ጴጥሮስ ይለጓንኸም ኢየሱስ በደረም ዝነጔ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቴ. 26፥31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፥31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሐ. 13፥36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />ኢየሱስ የደቀ መዛሙርተሑ እኪ ባረኖ፤</para>
  <para style="q1" vid="MRK 14:27">“ ‘ወጅመኘዪ ወካሑም ኧቈጥር፤ ኧጤዎቺም ይትቤተኖ፤’ ቧሪም ተጣፈም” እንማሑ ትለጎኝ፤ ቢያ ትስናከሎ፤ ገፈርኩኝም ትሰሖ፤<note caller="-" style="x"><char style="xo" closed="false">14፥27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፥7</ref>።</char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />በትነሣሑ አንቌም፣ በደረኩሑም ተገሊላዬ አር።<note caller="-" style="x"><char style="xo" closed="false">14፥28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቴ. 28፥16</ref>።</char></note> <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />ጴጥሮስም፤ “እንም ቢለጎከ እያ አንሸኩች” ባረ። <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />ኢየሱስም፤ “የኢን ኧብርኸ፤ በዚ ምሳር ኩተና ዄትጌ<note caller="+" style="f"><char style="fr" closed="false">14፥30 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ዄትጌ</char><char style="ft" closed="false">ይብሪ ሐረግ ኤነኖ። </char></note>ተወኑቀሑ ኢፍት አኸ ሦስትጌ ትለጌ፤” ቧረን።<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />ጴጥሮስም፤ “ታኸጌ ወሙት ቢያሸ ታኸጌ ኧᎀት” አንኸንም ስርም አንለጋኸ ቲብር አቆመረም ዝነጔ። ደቀ መዛሙርቲም ዛምኸም ይብሮ ባነ።<verse eid="MRK 14:31" /></para>
  <para style="s1">ኢየሱስ በጌቴሴማኒ ጤለየ</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቴ. 26፥36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፥39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />በዛም አንቌ ጌቴሴማኒ ቲቡሪዪ መደሬ ወሮ፤ ኢየሱስም የደቀ መዛሙርተሑ፤ “እያ በዛ ትንጤልይ አሑ በዚ አክሶ” ባረኖ። <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />የጴጥሮስ፤ የያዕቆብም ዮሐንስም ጠበጠም ወረ፤ ስርም ያዝን ይጨነቅ ቀረሰ።<verse eid="MRK 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 14:34" />ኧሗም፣ “ነብሰኛ የወሙት ስን ስርም አዘነ፤ በዚዬ ሕኖም ተጋደሎም ቀሮ” ባረኖ። <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />ተሕኖ ቀል ራቅ ባረም ወረ፤ በአፈርም ᎈር በግንባረሑ ተደፋም ይቸል ቢኸን ዛ ሰዓት ይቸለፉነኸም ጤለየ። <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />እኪም ባረ፤ “አባ<note caller="+" style="f"><char style="fr" closed="false">14፥36 </char><char style="ft" closed="false">በአረማይክ ቋንቋ አባ ይጠራወዪው። </char></note>፥ እንም ቃር ይቸልኸ፤ ዚ የመከራ ጥወ ቲያ ሽቅ አቢኒ፤ ቢኸንም ያኸ ፈአድኸም አንኸንም ይያ ፈአድኸም ኤይሕን።”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />ተዠበረም ቲቸኝ ደቀ መዛሙርተሑ ተገደሮም ረከበኖ፤ ጴጥሮስም እኪ ቧረን፤ “ስምዖን፤ ተገደርከም? ቁና ሰዓት ነቃኸም ወቀየ ቌመናኸ? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />ተፈተናዬ ናትገቦኸም ተጋደሎም፤ ጠልዮ፤ መንፈስ የዝጋጀው፤ በሠርም የቌጠው።” ባረኖ።<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />ኢየሱስ ዠበረም ወረም፤ ዛምኸም ይፍቴዪ ቃል በወዘንግ ጤለየ። <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />ሑቲም ዄታለኘም ቲዠበር ዔነሕኖ ወኔት ራዘንም ተገደሮም ረከበኖ፤ ይዠብሮነዪም ኤይሒሮ ባነ።<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />ሑቲ የሦስታለኘ ግዝየም ቸኘም እኪ ባረኖ፤ “ኧሗም የገደርኩኸም ያᎈኘሑኸምንኩ? ያሰላ! ሰዓቲ ሰላም፤ ዘ፤ የሰብ ትኸ በአጢያተኞች ኧጅ አቸለፊም ይᎅ። <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />ተንሦ፤ ንወርነ፤ አቸለፈም ይቤ ቸኘም።”<verse eid="MRK 14:42" /></para>
  <para style="s1">ኢየሱስ የጠᎄጪኸም</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቴ. 26፥47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፥47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሐ. 18፥3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ሒንጌም ኢየሱስ ዚ ቲዝነግ ትናነ ተዐሥረ ዄቲ አቲ ይሑዳ ቸኘ፤ ተሑቲጌ ሰይፍ እንጣርም የጠበጦ ብዠ ሰቦች ባኖ፤ ተካሕናት አለኦች፤ የሕጊ አስተማሪዎች ተሽማግሌዎቼ የትላሖ ባኖ። <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />አቸለፈም ይᎅም፤ “እያ ኧሰᎁም ሑቲቱ ጥብጦይ፤ ተቀሮም ውስዶይ” በወበር በደረም ምልክት አበኖም ባነ።<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />ይሑዳ ሒንጌም የሰላኸም ተኢየሱሴ ቀረበም፤ “አስተማሪ!” ባረም ሳᎀን፤ <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />ሰቦቺም የኢየሱስ ጠበጦም አገዶይ። <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />በዛም ቈሞም ተነበሮዪ አቲ ሰይፈሑ መዘዘም የካሕናት አለአዪ አገልጋይ እንዝን አረጠ። <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />ኢየሱስም እኪ ባረኖ፤ “ሰይፍ እንጣርም ጠበጥኩም የቸኘሑ ይያ የወንበዴኸም የወጥብጡ ወይ? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />ከነ በከነ በቤተ መቅደስ ትናትመር ታሑጌ ትንነብር አንጠበጥኩኝ፤ ቢኸንም ዚ እንም የኸነ የቅዱሳት መጽሐፎች ይትፌጠምኸሙ።”<note caller="-" style="x"><char style="xo" closed="false">14፥49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>፤ <ref loc="LUK 21:37">21፥37</ref>። </char></note><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />በዛ ግዝየ ደቀ መዛሙርተሑ እንም ገፈሮይም ሰኮ።<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />እንጨሑ የወሸፍን ገሊፍ ነጠላ የለበሰ አት አርዴ የኢየሱስ ይትዄተል ባነ። ሰቦቺም ዚ አርዴ በጠበጦይ ግዝየ፤ <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ነጠላሑ አደገም እንጨሑ ሰኴ።<verse eid="MRK 14:52" /></para>
  <para style="s1">ኢየሱስ በጀᎈሪ ኢፍት</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቴ. 26፥57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፥54-55</ref>፣<ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሐ. 18፥13-14</ref>፣<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />የኢየሱስም ተካሕናት አለአዬ ወሰዶይ፤ በዛዬ የካሕናት አለኦች፤ ሽማግሌዎች የሕጊ አስተማሪዎችም እንም ተስበስቦ። <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />ጴጥሮስም በሩቄ ቲትዄተልም፤ ተካሕናት አለአዪ ግቢ ስን ዘለቀ፤ በዛዬም ቾናም ተጉዚዎቺጌ ኧሳት ይᎀቅ ባነ። <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />የካሕናት አለኦች የጀᎈሪም እንም የኢየሱስ የወቅጥር ምስክር ሸዎ፤ ቢኸንም አረኸቦ። <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />ብዠሕኖ በባጢል ቢምሰክሮᎄም፤ ቃለሕኖ ቁና ይኸኔ አንቻለ።<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />አትባተሕኖም ተነሦም እኪ ቲብሮ በባጢል ምሰከሮᎄ፤ <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“ዚ፤ ‘የሰብ ኧጅ የሸኰተኒ ቤተ መቅደስ አፈርስም፤ በሦስት ከነ እንጐድ የሰብ ኧጅ ያንሠኰተኒ ኧሸክት’ ቲብር ሰማኔም።”<note caller="-" style="x"><char style="xo" closed="false">14፥58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሐ. 2፥19</ref>። </char></note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />ዚም ኸነም፤ ምስክርነተሕኖ ቁና አንከነ።<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />የካሕናት አለአዪም በግብተሕኖ ቈᎀም፤ “አትም አትዠብር? ነዚሕኖ ሰቦች ባኸ ᎈር ያቀረቦብከዪ ክስ መአሩ?” ቲብር የኢየሱስ ተሣለን።<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />ኢየሱስም እንቁስ ባረ፤ አትም መልስ አናበ። የካሕናት አለአዪም ዠበረም፤ “የብሩኪ የእዝጌር ትኸ ክርስቶስ አኸትንከ?” ቲብር ተሳለን።<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ኢየሱስም፣ “ኤክ እያትንኩ፤ የሰብ ትኸ በእዝጌር ከነ ይቾና፤ በሰሜ ዳበና ተዠበረም ቲቸኝ ታዞይ” ባረ።<note caller="-" style="x"><char style="xo" closed="false">14፥62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>። </char></note> <verse eid="MRK 14:62" /><verse number="63" style="v" sid="MRK 14:63" />የካሕናት አለአዪም በማት ልባሰሑ ገደደም “እንጐድ ምን ምስክር ያሸነ? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />ዘ! ዚ ስድበሑ ሰማሑይም፤ ኧጌሽ መአር ይመስርሑ?”፤</para>
  <para style="p" vid="MRK 14:64">ሕኖም ሞት ይጌቧን በወበር በቁና ቃል ፈረዶᎄ።<note caller="-" style="x"><char style="xo" closed="false">14፥64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ዘሌ. 24፥16</ref>። </char></note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />በዛ ግዝየ አታቶቺ ይተፎᎄ ቀረሰ፤ ዔነሑም ሼፈኖም በቦቅስ ቲወኮይ፤ “እንዴ ትምቢት ዘንግ!” ይብሮይ ባነ። ይቅሮዪም በትፊ ቲወኮ ወሰዶይ።<verse eid="MRK 14:65" /></para>
  <para style="s1">ጴጥሮስ የኢየሱስ የለጓንኸም</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቴ. 26፥69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፥56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሐ. 18፥15-18</ref>፣<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />ጴጥሮስ በካሕናት አለአዪ ቤት ተት በግቢዪ ውስጥ ትናነ በካሕናት አለአዪ ሜነተኞች አቲዬታ ቸኘች፤ <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />ጴጥሮስ ኧሳት ቲᎀቅ አዠችም ጡጥ ባረችም ተምሌከተቹም፤ “አኸም ተናዝሬቲ ተኢየሱስጌ ባነኸ” ባረቹ።<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />ሑቲም፤ “ትብዪ አንሒር፤ ኤይገቤ፤” በወበር ለጋ። በዛም ቲገᎄᎄዪ ወዝገቤ ወጣ ባረ፤ በዛ ግዝየ ኩተና ኖቀ<note caller="+" style="f"><char style="fr" closed="false">14፥68 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ኩተና ኖቀ</char><char style="ft" closed="false">ይብሪ ኤነኖ። </char></note>።<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />ሜነተኘዪም የጴጥሮስ አዠችም በዛዬ የቈሞዪ፤ “ዚም ተሕኖ ጐሣው” ትትብር ዠበረችም ትዝነጔ ቀረሰች። <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />ሑቲም፤ ኧሗም ለጋ። ተቀል ግዝየ አንቌ፤ በዛዬ የቈሞዪ ሰቦች የጴጥሮስ፤ “የገሊላ ሰብ ወሕናኸ የኢንም አኸ ተሕኖ አቲንከ” ባሮይ።<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />ጴጥሮስም፤ “አሑ ትብሮዪ ሰብ እያ አንሒን” ቲብር ይመል ይጌዘት ቀረሰ። <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />ሒንጌም ኩተና የዄታለኘ<note caller="+" style="f"><char style="fr" closed="false">14፥72 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች </char><char style="fqa" closed="false">ዄታለኘ</char><char style="ft" closed="false">ይቡኒ ቃል ኤነኖ። </char></note> ግዝየ ኖቀ። ጴጥሮስም፤ “ኩተና ዄትጌ ተወኑቀሑ ኢፍት ሦስትጌ ትለጌ” የቧረን የኢየሱስ ቃል ተዜጐደንም። በዛም ምርር ባረም በኴ።<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s1">ኢየሱስ በጲላጦስ ኢፍት</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቴ. 27፥1-2</ref>፣<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፥1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሐ. 18፥28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />ቅረር በሱቢ የካሕናት አለኦች ተሽማግሌዎች፤ ተሕጊ አስተማሪዎችም ትንም የጀᎈሪ አባልጌ ሒንጌም በትማከሮ አንቌ የኢየሱስ አገዶም ወሰዶይ፤ የጲላጦስ አቸለፎም አቦይ። <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />ጲላጦስም፤ “አኸ የአይሑድ ንጉሥንከ?” ቲብር ተሳለን፤ ኢየሱስም፤ “አኸ የባዀንኸሙ፤” በወበር ዠᎄረነ።<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />የካሕናት አለኦችም በብዠ ቃር ከሰሶይ። <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />ጲላጦስም፤ “የመአር መልስ አቲብ? ዘ በብዠ ቃር ከሰሶከም” ቲብር ዠበረም ተሳለን።<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />ኢየሱስም ጲላጦስ ይትጌረም ስን አትም መልስ አንዘበረ።<verse eid="MRK 15:5" /></para>
  <para style="s1">ኢየሱስ የሞት ፍርድ የᎈረጅᎄኸም</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቴ. 27፥15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፥13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሐ. 18፥39-40</ref>፤ <ref loc="JHN 19:1-16">19፥1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />ጲላጦስ በዓመት ዓመተሑ በአይሑድ ፋሲካ በዓል ግዝየ ይፈታኖኸም ሰቦቺ የሳሎዪ አት የታገደ ይገፍርኖ ባነ። <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />በዛ ግዝየ በመንግሥት ᎈር ተነሦም ሰብ በወቅጥር ወሕኔ ቤት የገቦ ዐመጠኞች ባኖ፤ ተዚሕኖም ዐመጠኞቺ አቲ በርባን ይቡሪዪ ሰብ ባነ። <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />ሕዝቢም ቸኖም የሮሺኸም ይሸክትኖኸም የጲላጦስ ጮቀሶይ። <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />ጲላጦስም፤ “የአይሑድ ንጉሥ ኧፈታንኩ ኸም ትሸዎ?” ቲብር ተሳለኖ። <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />ዚም የባረወ መሳ የካሕናት አለኦች የኢየሱስ አቸለፎም ያቦይ በቅናት ወሕነሑም ይሒር ባነ።<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />የካሕናት አለኦችም በርባን በኢየሱስ ሟኔ ይፈታኖኸም የጲላጦስ ይሰሎኸም የሕዝቢ አትንሤሦ። <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />ጲላጦስም ዠበረም፤ “ኧጌሽ የአይሑድ ንጉሥ ትብሮዪ ምን ኧሸኩችኸም ትሸዎ?” ቲብር ተሳለኖ።<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />ሕኖም ዠበሮም፤ “ስቁር!” ቲብሮ ዠበሮም ው ባሮ።<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />ጲላጦስም፤ “የመአር? ምን የፌጠᎀን ወንጀል ነነ” ባረኖ።</para>
  <para style="p" vid="MRK 15:14">ሕኖም፤ “ስቁር!” ቲብሮ አበዞም ው ባሮ።<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />ጲላጦስም፤ የሕዝቢ የዋትብላልቅ ቲብር የበርባን ፈታኖ፤ ኢየሱስም ገረፈም ይሰቀርኸም አቸለፈም አᎄን።<verse eid="MRK 15:15" /></para>
  <para style="s1">ወታደሮቺ በኢየሱስ ᎈር ያፌዞᎄኸም</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቴ. 27፥27-31</ref>፤ <ref loc="JHN 19:2-3">ዮሐ. 19፥2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />ወታደሮቺ የኢየሱስ ፕራይቶሪዮን ተቧሪዬ ተገዢ ግቢዬ ወሰዶይ፤ የቀኖዪም ወታደሮች እንም ጠሮ። <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />ብሻ ልባስም አለበሶይ፤ የሶክ አክሊል ታቶም በጉነነሑ ᎈር አወኖᎄም፤ <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />በዛም፤ “የአይሑድ ንጉሥ፤ ሰላም ያኸ የሕን!” ቲብሮ ኧጅ ነሦነ፤ <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />ጉነነሑ ብንጣር ወኮይ፤ ተፎᎄም፤ ተንብረከኮም ሰገዶነ። <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ባፌዞᎄም አንቌ ብሻዪ ልባስ አወለቆᎄ፤ የፎለሑ ልባስ አለበሶይ፤ ይሰቅሮዬ ወሰዶይ።<verse eid="MRK 15:20" /></para>
  <para style="s1">የኢየሱስ ወሰቀር</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቴ. 27፥32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፥26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሐ. 19፥17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />የአሌክሳንድሮስ የሩፎስም አባ ስምዖን የቧሪ አት የቀሬና ሰብ ተገጠር ተከተማዬ ቲገባ ረከቦይ፤ የኢየሱስ መስቀል ይጮርኸም የግድ ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">15፥21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ሮም 16፥13</ref>። </char></note> <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />በዛም አንቌ የኢየሱስ፤ ትርጉመሑ “የራስ ቅል መደር” ተቧሪዬ ተጎልጎታዬ ወሰዶይ። <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />ከርቤ ተቧሪ ጭዛጌ የቁላቈሊ ወይን አቦይ፤ ሑቲም አንሰጨ። <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />በዛም ሰቀሮይ፤ አትባተሕኖም ምን ይሰላንኸም የወሐር ኧጣ አደጎም ልባሲ ተሳዶይ።<note caller="-" style="x"><char style="xo" closed="false">15፥24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>። </char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />የኢየሱስ ቲሰቅሮይ ግዝየሑ ተቅረሪ ሦስት ሰዓት ባነ። <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />የክሲ ጡሑፍም፤ “የአይሑድ ንጉሥ” ይብር ባነ። <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />ተኢየሱስጌ ዄት ወንበዴ አቲ በከነሑ አቲም በጉራሑ ሰቀሮዮ። <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />[መጽሐፍ፤ “ተዐመጠኞቺጌ ተቆጠረ” ይቡሪዪ የትምቢቲ ቃል ተፌጠመ።]<note caller="-" style="x"><char style="xo" closed="false">15፥28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53፥12</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">15፥28 </char><char style="fqa" closed="false">አታት የጎጋ ጡሑፎች ቊ. 28 ይደብሮ፦ </char><char style="ft" closed="false">ቃሊም በሉቃ. 22፥37 ያነዪ ይመስር። </char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />ቤማም ይቸለፎዪም ጉነነሕኖ በወነቅንቅ የስድብ ናዳ በዋውርድ እኪ ይብሮይ ባነ፤ “እንዴ! ቤተ መቅደሲ አፈረስከም በሦስት ከነ ትሸክት አኸትንከ፤<note caller="-" style="x"><char style="xo" closed="false">15፥29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">መዝ. 22፥7</ref>፤ <ref loc="PSA 109:25">109፥25</ref>፤ <ref loc="MRK 14:58">ማር. 14፥58</ref>፤ <ref loc="JHN 2:19">ዮሐ. 2፥19</ref>። </char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />እንዴ ኧሗ በመስቀል ውረድም ነብስያኸ አትርፍ።”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />በዛምኸማት የካሕናት አለኦች የሕጊ አስተማሪዎችም በዋሹፍ ነብስ በነብሰሕኖ እኪ ባሮ፤ “ይንጐዲ አተረፈ፤ ነብሰሑም ዋትርፍ አንቻለ፤ <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />አዠነም ናምነዬ ዚ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">15፥32 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">መሲሕ</char></note>፤ ዚ የእስራኤል ንጉሥ እንዴ በመስቀል የውርድ።”</para>
  <para style="p" vid="MRK 15:32">ወንበዴዎቺም ዛምኸም ይሰድቦይ ባነ።<verse eid="MRK 15:32" /></para>
  <para style="s1">የኢየሱስ ወሙት</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቴ. 27፥45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፥44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሐ. 19፥28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />በከነዪ ስድስት ሰዓት ቀረሰም ዠጠ ሰዓት ስን ታፈሪ እንም ᎈር ጨለማ ኸነ። <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />ዠጠ ሰዓት ቲኸን ኢየሱስ፤ “ኤሎሔ፤ ኤሎሔ፤ ላማ ሰበቅታኒ?” ባረም በወደል ጣምባ ው ባረ፤ ትርጉመሑም “አምላከኛ፤ አምላከኛ የመአር ገፈርኬም?” ወበሩ።<note caller="-" style="x"><char style="xo" closed="false">15፥34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">መዝ. 22፥1</ref>። </char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />በዛም ቈሞም ተነበሮዪ አታቶቺ ዚ ቲሰሞ፤ “የኤልያስ ይጠራን” ባሮ። <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />በዛም አት ሰብ አቴከለም ወረም የሑመጠጠ ወይን በሰፍነግ ነከረ፤ በዘንግ ሴካም ይሰጭንኸም የኢየሱስ አቀረᎄነ፤ በዛም፤ “ግፍሮይ እንዴ ኤልያስ ቸኘም ቲያወርጅ ናዥነ” ባረ።<note caller="-" style="x"><char style="xo" closed="false">15፥36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>። </char></note><verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />ኢየሱስም በወደል ጣምባ ው ባረ፤ ᎀተ።<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />የቤተ መቅደሲ መጋረጃ ተነን ተት ስን ዄቴ ተገደደ። <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />በኢየሱስ ኢፍት ሊፍት ቈመም የነበረዪም የመቶ አለአ ዚኸም ው ባረም<note caller="+" style="f"><char style="fr" closed="false">15፥39 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">ዚኸም ው ባረም</char><char style="ft" closed="false">ይብሪ ሐረግ ኤነኖ። </char></note> ቲᎀት ባዠ ግዝየ፤ “ዚ ሰብ የኢንም የእዝጌር ትኸ ባነ፤” ባረ።<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />በዛ ግዝየ እንሽታዎቺ በሩቄ ኸነማም ይምሌከተማ ባነ፤ ተሕነማም ግብት መግደላዊት ማርያም፤ ይንሲም ያዕቆብም የዮሳ ዳኮ ማርያም፤ ዛምኸም ሰሎሜ ባነማ፤ <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />ነዚሕነማ እንሽታ በገሊላ የኢየሱስ ቲትዄተለማይም ቲያግለግለማይ የነበረማነማ፤ ኧሗም ተሑቲጌ ኢየሩሳሌም የቸነማ ብዠ እንጐድ ብዠ እንሽታ ባነማ።<note caller="-" style="x"><char style="xo" closed="false">15፥41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፥2-3</ref>። </char></note><verse eid="MRK 15:41" /></para>
  <para style="s1">የኢየሱስ ወቀበር</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቴ. 27፥57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሐ. 19፥38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />ግዝየዪ ቲመሽ ቸኘም የነገዪ ሰምበት ይዝጋዶᎄ ከነ ኸነ፤ <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />የትከበረ የጀᎈር አባልም የእዝጌር መንግሥት ይቅየ የነበረዪ የአርማትያስ ዮሴፍ በድፍረት ተጲላጦሴ ወረም የኢየሱስ ሬሳ ጮቈሰን። <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />ጲላጦስም እኪ በዋተክል ወሙተሑ ቲሰማ ተዴነቀ፤ የመቶ አለአዪም አጤራም በᎀተ ምናሕር ከነ የኸነኸም ተሳለን፤ <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />ወሙተሑም በመቶ አለአዪ ባርጋገጠ አንቌ ሬሳዪ የዮሴፍ አᎄን። <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />ዮሴፍም የከፈን ልባስ ስየም፤ ሬሳዪም አወረደም በከፈኒ ልባስ በኬᎈነን አንቌ፤ በአለት በትወቀረ ቀብር ቀᎄረን፤ የቀብሪም ወረጀ ብምን ገጠᎀን። <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />መግደላዊት ማርያም የዮሳ ዳኮ ማርያም የኢየሱስ ሬሳ ቤቴ ያወኖይኸም ይምሌከተማ ባነ።<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s1">የኢየሱስ ትንሣኤ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቴ. 28፥1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፥1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሐ. 20፥1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />የሰምበት ከነ ባለፈ አንቌ መግደላዊት ማርያም፤ የያዕቆብ ዳኮ ማርያም ሰሎሜም ኸነማም፥ የኢየሱስ ሬሳ የወቅባ ተፈያ ቅመም የዝጋጀ ሽቶ ስረማ። <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />በሳምቲ ውርሰምበት ከነ ቅረር ሱቢ፤ ገና ጬት ተወጣኸም፤ ተቀብሪዬ በወወር ትናነማ፤ <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />“ሕነማ እምኒ በቀብሪ ወረጀ ᎈር ሟ ያንክባልልንነ?” በወበር ነብስ በነብሰሕነማ ይዝናገማ ባነ። <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />ቀና ባረማም ቲምሌከተማ፤ ስርም ወደል የነበረዪ እምን በወረጀዪ ᎈር ተንክባለለም አዘማ። <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />ተቀብሪዬም በገበማኸም፤ ነጨ ልባስ የለበሰ ጐልማሳ በከነ አዘር ቾናም አዘማም ድነበጠማ።<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />ሑቲም እኪ ባረነማ፤ “አትደንብጠማ፤ ትሸወማዪ ተሰቀረዪ የናዝሬቲ ኢየሱስ፤ ሑቲ ተነሣም፤ በዚ ኤነ፤ የሑቲ የቀᎄርᎄ መደር ዝሙ። <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />ቢኸንም ወረማም የደቀ መዛሙርተሑም የጴጥሮስ፤ ‘በደረናሕማም ተገሊላዬ ያር፤ ዬወደናሕማኸም በዛዬ ትረሕበማይ’ በረማም አውደማዮ።”<note caller="-" style="x"><char style="xo" closed="false">16፥7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቴ. 26፥32</ref>፤ <ref loc="MRK 14:28">ማር. 14፥28</ref>። </char></note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />ኧንሽታዪም ቲያትረደማ ቲዴነቀማም በቀብሪ ሰከማም ወጠማ፤ ጔነማም የነበረ ስለኸነ የሟንም አትም አንዘገማ።<note caller="+" style="f"><char style="fr" closed="false">16፥8 </char><char style="ft" closed="false">ባታት የድረ መጽሐፎች በዚ ምዕራፍ በቁ 8 ቄጠለም ያነዪ ቃል ይትረከብ፦ </char><char style="fqa" closed="false">እንሽታ ተጴጥሮሴም ተመራርቻዄ ወረማም መላዪካዪ ዬወደነማዪ እንም ኤወደማዮ፤ በዛ አንቌ ኢየሱስ ነብሰሑ የዘላለም ወትርፍ የኸነዪ፤ ኤሸገሪ ቅዱስ ወንጌል ጬት ቲወጣወዪ፤ ቲቡየወዪ ስን በደቀ መዛሙርተሑ መሳ ላኸ። </char></note></para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />በሳምቲ ውርሰምበት ከነ ሱቢ በሞት በትነሣ አንቌ፤ ሰበት አጋንት ያወጣና መግደላዊት ማርያም በመጀመሪያ ታዠ።<note caller="+" style="f"><char style="fr" closed="false">16፥9 </char><char style="ft" closed="false">አታት ቅጂዎችም፥ የድረ ትርጉሞች ተቁ 9-20 ያነዪ ክፍል ኤደብሮ። </char></note> <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />ሒቲም ወረችም፤ ተሑቲጌ የነበሮዪ ቲያዝኖ ቲበሖ ረከበችም ሑቲ ሕያው ወሕነሑም የሒቲም ወታዠሑ ኤወደቶም፤ <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />ሒቲ “ኢየሱስ በሞት ተነሣም በሕይወት ነነ፤ እያም ቤነኛ አዠሑም፤” ባረችም ኤወደቶ፤ ሕኖም አነመኖያ።<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />በዛም አንቌ ተደቀ መዛሙርተሑ ዄቲ ተገጠሬ ቲያሮ ብንጐድ መልክ ታዠኖ። <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />ሕኖም ተዠበሮም ዚም የቀኖዪ ደቀ መዛሙርተሑ ኤወዶዮ፤ የሕን አንከንም የሕኖም አነመኖዮ።<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />በዛም ዐሥራ አቲ በማዳ ᎈር ትናኖ ተገለጠኖ፤ በትነሣ አንቌ ያዞይ ሰቦች የዝነጎዮዪ ያነመኖዮ ስለኸነ፤ አለወመነሕኖም በሒነሕኖ ጀንጂንነት ነቀፈ። <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />እኪም ባረኖ፤ “ተዓለም እንምሜ ወሮ፤ ወንጌልም የሰብ እንም ስብኮ፤<note caller="-" style="x"><char style="xo" closed="false">16፥15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሐዋ. 1፥8</ref>። </char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />ያመነ የጠመቀ ይተርፍ፤ ያነመነዪም ይᎈርጅᎄ። <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />ያመኖዪ ነዚሕኖ ምልክቶች ይትዄተሎ፤ በሽመኛ አጋንት ያወጦ፤ በገደር ቋንቋ ይዝነጎ፤ <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />እንድወደረዪ በጀሕኖ ይጠብጦ፤ ይቀጥር መርዝ ቢሰጦም ኤይጎዳኖ፤ ኧጀሕኖም በታቆዪም ᎈር ይጨኖ፤ ሕኖም ፈያ ይኸኖ።”<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />ጔታ ኢየሱስ ዚ በዝነጔኖ አንቌ ተሰሜዬ ዐረገ፤ በእዝጌርም ከነ ቾና።<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ሐዋ. 1፥9-11</ref>። </char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />በዛም ደቀ መዛሙርተሑም ወጦም፤ ተመደር መደሬ እንም ወሮም ሰበኮ፤ ጔታም ተሕኖጌ ይሸክት ባነ፤ ትምርተሕኖም ተዄተሎም ቢትፌጠሞ ምልክቶች ቃለሑ ያጠና ባነ<note caller="+" style="f"><char style="fr" closed="false">16፥20 </char><char style="ft" closed="false">አታት የድረ ቅጂዎች በቁ 9-20 ᎈር ያነዪ ክፍል ኤነኖ። </char></note>።]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>