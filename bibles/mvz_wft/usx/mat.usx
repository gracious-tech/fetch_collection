<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">Mesqan New Testament</book>
  <para style="h">የማቴዎስ ወንጌል</para>
  <para style="toc1">ማቴዎስ የጣᎈን የጔታና የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="toc2">የማቴዎስ ወንጌል</para>
  <para style="toc3">ማቴ.</para>
  <para style="mt1">ማቴዎስ የጣᎈን</para>
  <para style="mt2">የጔታና የኢየሱስ ክርስቶስ ወንጌል</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የማቴዎስ ወንጌል፥ ኢየሱስ የወተኘሑ ተስፋ በደረም የቴወደነ ያተርፍ ወሕነውታን እዝጌርም በጉርዚ ጉዳ የሕዝቢ ያᎄን የተስፋ ቃል የᎊጠᎀኒም በሑቲ መሳ ወሕነሑ ይውጂዪ ገደር የኸነዪ ቃል የጠበጠው። ዚም ገደር የኸነ ቃል ኢየሱስ በግብተሕኖ ተጨኘም የላቀ የአይሑድ ጠለለ ቴይኸን፥ ይንም ዓለም ሕዝብ ደበረሙ።</para>
  <para style="ip">የማቴዎስ ወንጌል በወቀየ የዝጋጀ መጽሐፉ፤ ተኢየሱስ ወጠኝ ቀረሰም፥ የጥምቀተሑ የመከራሑ ቤወደ አንቌ፥ በገሊላ ገኝ የፌጠᎀኒ የወስብክ፥ የዋትመር ፈያ የወሰክትም አገልግሎት ያቀርብ። በዛም በወቀጥል ኢየሱስ ተገሊላ ገኝ ተኢየሩሳሌሜ የሸኰተን ስለኸነ ጋዠም በዚ ዓለም ᎈር ቤከሰወ ዘበን በመጨረሻዪ ሳምት ስለኸኖዪ ቃር ያፍታታ፤ ነዚ ዘንጋ ስቅለተሑ፥ ሞተሑ ትንሣኤውታንም ያጥቃልሎ።</para>
  <para style="ip">ዚ ወንጌል የኢየሱስ፥ የእዝጌር ሕጊ የወተርጉም ሥልጣን ያነኒ ስለእዝጌር መንግሥት ያትመርም ንቅ አስተማሪ የኸነኸም ሸከተም ያቀርቡ። ተትምርተሑ ይበዛዪ ክፍል በትልያየ መልክ በጥናከሮ በአምስት ክፍል ይትሜደብ፦</para>
  <para style="ili">1. የእዝጌር መንግሥት ዜጋ አመል፥ ሜና፥ መብት፥ ግዴታም፥ የመጨረሻ ወጥ ሟኔ ያትሬዳ የቈቶዪ ስብከት (ተምራ. 5—7)።</para>
  <para style="ili">2. ዐሥረ ዄቲ ደቀ መዛሙርት የወንጌል ስብከት በትላሖᎄ ግዝየ ያቡዮ መመሪያ (ምራ. 10)።</para>
  <para style="ili">3. የእዝጌር መንግሥት የቀረቦ የትልያዮ ምሳሌ (ምራ. 13)።</para>
  <para style="ili">4. የደቀ መዛሙርቲ ትርጉም ያትሬዳ ትምርት (ምራ. 18)።</para>
  <para style="ili">5. የሗዪ ዘበን መጨረሻዪ የእዝጌር መንግሥትም ወተኝ ያᎅ ትምርት (ተምራ. 24—25)።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">የኢየሱስ ክርስቶስ የዘር ዝሬት የጨኘወ ከነ <char style="ior"><ref loc="MAT 1:1-2:23">1፥1—2፥23</ref> </char></para>
  <para style="io1">የመጥምቂ ዮሐንስ አገልግሎት <char style="ior"><ref loc="MAT 3:1-12">3፥1-12</ref> </char></para>
  <para style="io1">የኢየሱስ ወጠመቅ ወፈተንም <char style="ior"><ref loc="MAT 3:13-4:11">3፥13—4፥11</ref> </char></para>
  <para style="io1">ኢየሱስ ሜናሑ በገሊላ ገኝ ወቅርሰሑ <char style="ior"><ref loc="MAT 4:12-18:35">4፥12—18፥35</ref> </char></para>
  <para style="io1">ተገሊላ ተኢየሩሳሌሜ <char style="ior"><ref loc="MAT 19:1-20:34">19፥1—20፥34</ref> </char></para>
  <para style="io1">የመጨረሻዪ ሳምት በኢየሩሳሌም በጭጭሳሑም <char style="ior"><ref loc="MAT 21:1-27:66">21፥1—27፥66</ref> </char></para>
  <para style="io1">የጔታና ትንሣኤ መገለጡም <char style="ior"><ref loc="MAT 28:1-20">28፥1-20</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">የኢየሱስ ክርስቶስ የጨኘት ዝሬት</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ. 3፥23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />የዳዊት የአብርሐምም ትኸ የኸነዪ የኢየሱስ ክርስቶስ የጨኘት ዝሬት ዚ ሙ፦<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="PSA 132:11">መዝ. 132፥11</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11፥1</ref>። </char></note><verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />አብርሐም ይስሐቅ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:2">ይስሐቅ ያዕቆብ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:2">ያዕቆብ ይሑዳም ጐባቢተሑ ጨኘ፤<verse eid="MAT 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3" />ይሑዳ በትዕማር ፋሬስ ዛራም ጨኘ፤</para>
  <para style="q1" vid="MAT 1:3">ፋሬስ ሔስሮን ጨኘ፤</para>
  <para style="q1" vid="MAT 1:3">ሔስሮንም አራም ጨኘ፤<verse eid="MAT 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4" />አራም ዓሚናዳብ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:4">ዓሚናዳብ ነአሶን ጨኘ፤</para>
  <para style="q1" vid="MAT 1:4">ነአሶን ሰለሞን ጨኘ፤<verse eid="MAT 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5" />ሰለሞን ቦዔዝ ተረዓብ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:5">ቦዔዝ በሩት ኢዮቤድ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:5">ኢዮቤድ እሴይ ጨኘ፤<verse eid="MAT 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6" />እሴይ ንጉሥ ዳዊት ጨኘ።<note caller="-" style="x"><char style="xo" closed="false">1፥3-6 </char><char style="xt" closed="false"><ref loc="RUT 4:18-22">ሩት 4፥18-22</ref>፤ <ref loc="1CH 2:13-15">1 ዜና 2፥13-15</ref>። </char></note></para>
  <para style="p" vid="MAT 1:6">ንጉሥ ዳዊት የኦርዮ ምሽት ተኸነቺ ሰሎሞን ጨኘ፤<verse eid="MAT 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7" />ሰሎሞን ሮባዓም ጨኘ፤</para>
  <para style="q1" vid="MAT 1:7">ሮባዓም አቢያ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:7">አቢያ አሳፍ ጨኘ፤<verse eid="MAT 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8" />አሳፍ ኢዮሣፍጥ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:8">ኢዮሣፍጥ ኢዮራም ጨኘ፤</para>
  <para style="q1" vid="MAT 1:8">ኢዮራም ዖዝያን ጨኘ፤<verse eid="MAT 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9" />ዖዝያን ኢዮአታ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:9">ኢዮአታም አካዝ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:9">አካዝ ሕዝቅያስ ጨኘ፤<verse eid="MAT 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10" />ሕዝቅያስ ምናሴ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:10">ምናሴ አሞ. ጨኘ፤</para>
  <para style="q1" vid="MAT 1:10">አሞ. ኢዮስያስ ጨኘ፤<verse eid="MAT 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11" />ኢዮስያስ የእስራኤል ሕዝብ ተ ባቢሎን ተማረኮም በወሮᎄ ዘበን ኢኮንያን<note caller="+" style="f"><char style="fr" closed="false">1፥11 </char><char style="ft" closed="false">ዮአኪን ወበሩ፤ ቁ 12 የመ</char></note> ጐባቢተሑም ጨኘ፤<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 ነገ. 24፥14-15</ref>፤ <ref loc="2CH 36:10">2 ዜና 36፥10</ref>፤ <ref loc="JER 27:20">ኤር. 27፥20</ref>። </char></note><verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />ተባቢሎን ምርኮ አንቌ፤ ኢኮንያን ሰላትያል ጨኘ፤</para>
  <para style="q1" vid="MAT 1:12">ሰላትያልም ዘሩባቤል ጨኘ፤<verse eid="MAT 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13" />ዘሩባቤል አብዩድ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:13">አብዩድ ኤልያቄም ጨኘ፤</para>
  <para style="q1" vid="MAT 1:13">ኤልያቄም አዞር ጨኘ፤<verse eid="MAT 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14" />አዞር ሳዶቅ ጨኘ፤</para>
  <para style="q1" vid="MAT 1:14">ሳዶቅ አኪም ጨኘ፤</para>
  <para style="q1" vid="MAT 1:14">አኪም ኤልዩድ ጨኘ፤<verse eid="MAT 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15" />ኤልዩድ የአልዓዛር ጨኘ፤</para>
  <para style="q1" vid="MAT 1:15">አልዓዛር የማታን ጨኘ፤</para>
  <para style="q1" vid="MAT 1:15">ማታን የያዕቆብ ጨኘ፤<verse eid="MAT 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16" />ያዕቆብ ዮሴፍ ጨኘ፤ ዮሴፍም የኢየሱስ ክርስቶስ ዳኮ የማርያም እጮኛ ባነ።<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />ኧጌሽ ተአብርሐም ዳዊት ስን ዐሥራ አርበት ጨኘት፤ ተዳዊት ባቢሎን ምርኮ ስን ዐሥራ አርበት ጨኘት፤ ተባቢሎን ምርኮ ክርስቶስ የጨኘወ ስን ዐሥራ አርበት ጨኘት ይኸን።<verse eid="MAT 1:17" /></para>
  <para style="s1">የኢየሱስ ክርስቶስ ወጠኝ</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ. 2፥1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />ኢየሱስ ክርስቶስ የጨኘወ ሐለት ዚኸም ባነ፦ ዳኰች ማርያም የዮሴፍ ጮቈሽያም ትናነች፥ ቴይትጋቦ በመንፈስ ቅዱስ ዄት ነብስ ኸነችም ተረከበች። <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />እጮኛዬታ ዮሴፍ ጻድቅ ሰብ የነበረ ስለኸነ፥ የማርያም በሰብ ኢፍቴ ይውድባዬ አንሸ፤ ስለኸነም በሽሙቸ ይገፍራዬ ኤሰበ።<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />ቢኸንም ዚ ዘንጋ ቲዬስብ ትናነ፥ የጔታ መላይካ በብርዛዝ ተጐለጠነም እኪ ቧረን፤ “የዳዊት ዝሬት ዮሴፍ! እጮኛኸ ማርያም ዄት ነብስ የኸነች በመንፈስ ቅዱስ ስለኸነ፥ የሽቲ ተቤታኸዬ የወውስድ አትገና። <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />ሒቲም ኧርጅ ትጨኝ፤ ሑቲ የሕዝቢ ተአጢያተሕኖ ያተርፎ ስለኸነ ሽመሑ ኢየሱስ ትቡን።”<note caller="-" style="x"><char style="xo" closed="false">1፥21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃ. 1፥31</ref>። </char></note><verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />ዚ እንም የኸነ ጔታ እኪ ቲብር በነብይ መሳ የዝነጔኒ ይትፌጠም ኸሙ፤ <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“ዘ፥ ድንግል ዄት ነብስ ትኸን፤ ኧርጅ ትጨኝ፤ ሽመሑም ‘ዐማኑኤል’ ቧሪም ይጠሬ።” ዐማኑኤል ወበር “እዝጌር ቲናጌው” ወበሩ።<note caller="-" style="x"><char style="xo" closed="false">1፥22-23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7፥14</ref>። </char></note><verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />ዮሴፍ በወኔተሑ በትነሳ ግዝየ፥ የጔታ መላይካ ቤዘዘን መሠረት የእጮኛውታን የማርያም ተቤተዄ ወሰደና። <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />የሕን አንኸንም፥ የበሕር ትኸዬታን ትጨኝ ስን አንተራኸበና<note caller="+" style="f"><char style="fr" closed="false">1፥25 </char><char style="fqa" closed="false">አንተራኸበና፦ </char><char style="ft" closed="false">የምስ ተምሽትኸም አንትራኸቦ ወበሩ። </char></note> ሽመሑም ኢየሱስ ባረም ጠራን።<note caller="-" style="x"><char style="xo" closed="false">1፥25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">ሉቃ. 2፥21</ref>። </char></note><verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">በምስራቅ የቸኖ ኰኰብ ይምራመሮዪ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />በንጉሥ ሔሮድስ ዘበን፥ በይሑዳ ገኝ ቢትረከቢ በቤተ ልሔም ከተማ ኢየሱስ በጨኘወ ግዝየ፥ የኰኰብ ይምራመሮዪ ተምስራቅ ኢየሩሳሌም ስን ቸኖ። <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />እኪ ቲብሮ ተሳሎ፦ “የጨኘዪ የአይሑድ ንጉሥ ቤቴው? ኰኰቢ በምስራቅ አዠኔም የሑቲ ኧሰግድነነዬ ቸኘነ።”<note caller="-" style="x"><char style="xo" closed="false">2፥2 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23፥5</ref>፤ <ref loc="ZEC 9:9">ዘካ. 9፥9</ref>፤ <ref loc="NUM 24:17">ዘሑ. 24፥17</ref>። </char></note><verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />ንጉሢ ሔሮድስ ዚ ዘንጋ በሰማ ግዝየ ድነበጠ፤ የኢየሩሳሌም ሰቦች እንም ተሑቲ ጌ ድነበጦ። <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ሑቲም የካሕናት አለኦች እንም የሕዝቢ የሕጊ አስተማሪዎች ስበሰበም፤ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">2፥4 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">መሲሕ</char></note> ይጨኚ ቤቴ የኸነኸም ተሳለኖ። <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />ሕኖም፤ “በይሑዳ ቤተ ልሔም፤ ነብዪ እኪ ባረም ጣፈም ባሮ፤<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“‘በይሑዳ ገኝ ይትረከቢ አኸ ቤተ ልሔም፤</para>
  <para style="q2" vid="MAT 2:6">ትንጐዶቺ የይሑዳ ገዦች ባትም አታንስ፤</para>
  <para style="q2" vid="MAT 2:6">የሕዝበና የእስራኤል ይቂየ ይኸን፤ ባኸ ይወጣ።’ ”<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5፥2</ref>። </char></note><verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />በዛ አንቌ ንጉሥ ሔሮድስ ነዛ ኰኰብ ይምራመሮዪ በሽሙቸ አጤራም፥ ኰኰቢ የታዠወ ሱቲ ግዝየ ተሳለም ተሬዳ፤ <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />እኪ ባረም ቤተ ልሔም ላኸም፤ “ወሮማሑ፤ የሰብዬዪ ሳቦ፤ እያም ኧሗም ወርኩም ኧሰጉድነኸም፤ የረከብኩይኸም ቲያዬ ተዘበሮም ቤቴ ያነኸም አውዶኝ” ባረኖ።<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />ሕኖም የንጉሢ ቃል በሰሞ አንቌ፥ ወጦም ወሮ፤ ዘ! በምስራቅ ያዞዪ ኰኰብ ሰብዬዪ ባነወ መደር ᎈር ይቈም ስን፥ ኢፍት ኢፍተሕኖ ወረም ይመራኖ ባነ። <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />ኰኰቢዪም ባዞ ግዝየ ስርም ተብላለቆ፤ <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ተቤቴም ገቦም ሰብዬዪ ተዳኰች ተማርያም ጌ ኸነም አዞይ፤ ሙግ ባሮም ሰገዶነ፤ ሣጥነሕኖም ከፈቶም የወርቅ፥ ያዱርስ የድኚም ስጦታ አቀረቦነ።<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ተ ሔሮድሴ ኤዠበሮኸም እዝጌር በብርዛዝ ያጥኔቀቀኖ ስለኸነ፥ ይምራመሮዪ ብንጐድ ኤማ ተ ገኘሕኖዬ ተዠበሮም ወሮ።<verse eid="MAT 2:12" /></para>
  <para style="s1">ሰብዬዪ ጠበጦም ተ ግብጼ ወስኴሕኖ</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ኰኰብ ይምራመሮዪ በወሮ አንቌ፥ የጔታ መላይካ የዮሴፍ በብርዛዝ ተጐለጠነም፥ “ሔሮድስ የሰብዬዪ የወቅጥር ይሸን ስለኸነ፥ ተንሳማኸ ሰብዬዪ ተዳኰች ጌ ጥብጥም ተ ግብጽ ገኜ ሲሕ፤ ይውደኸ ስን በዛዬ አክስ” ቧረን።<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />ስለኸነም ዮሴፍ በግብጽ ምሳር ተነሣም፥ ሰብዬዪ ተዳኰች ጌ ጠበጠም፥ ተ ግብጼ ወረ። <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />በዛም ሔሮድስ ይᎀት ስን ኤከሰ፤ ዚም የኸነዪ ጔታ በነብዪ “ትኸኛ በግብጽ ጠራሑን” በወበር የእዝጌር ትኸ በነብዪ አፍ የዝነጔኒ ቃል ተፌጠመ።<note caller="-" style="x"><char style="xo" closed="false">2፥15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሖሴ. 11፥1</ref>። </char></note><verse eid="MAT 2:15" /></para>
  <para style="s1">ሔሮድስ ሰብዬዎቺ ያትቄጠረኸም</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />በዛም አንቌም ሔሮድስ፥ ኰኰብ ይምራመሮዪ ያብላለጦይኸም በትሬዳ ግዝየ፥ ስርም ተናደደ፤ ተቤተ ልሔም በጭጭሳዪም ታኖዪ መንደሮቼ እንም ወታደሮቸሑ ላኸም፥ ተኰኰብ ተመራማሪዎቸሑ በትሬዳን ዘበን መሠረት ዕድሜሕኖ ዄት ዓመት የኸነኖዪ ተዚ ተት የኸኖዪ በቤተ ልሔም በጭጭሳዪም የነብሮዪ ዴንጋ ጠቈኘቶች አትቄጠረኖ። <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />በዛ ግዝየ፥ በነብዪ ኤርሚያስ እኪ ቲብር የቴወደዪ ትምቢት ተፌጠመ፦<verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“ያልፋታ የወደል ውታ ጣምባም፤ በራማ ተሴማ፤</para>
  <para style="q1" vid="MAT 2:18">ራሔል የዴንጋዬታን በኴች፤</para>
  <para style="q2" vid="MAT 2:18">ወጥናናም አንቻለች፤</para>
  <para style="q2" vid="MAT 2:18">ዴንጋዬታን እንም አለቆም።”<note caller="-" style="x"><char style="xo" closed="false">2፥18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31፥15</ref>። </char></note><verse eid="MAT 2:18" /></para>
  <para style="s1">በግብጽ ተናዝሬቴ ወዘበር</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />ሔሮድስ በᎀተ አንቌ የጔታ መላዪካ በግብጽ የዮሴፍ በብርዛዝ ተጐለጠነም፥ <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“የሰብዬዪ የወቅጥር ይሸዎይ ሰቦች ስለᎀቶ፥ ተንሳም ሰብዬዪ ተዳኰች ጌ ጥብጥማኸ፥ ተእስራኤል ገኜ ወር” ቧረን። <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />ዮሴፍም ተነሳም የሰብዬዪ ተዳኰች ጌ ጠበጠም፥ ተእስራኤል ገኜ ተዠበረ።<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />ቢኸንም አርኬዎላዎስ ባᎄች በሔሮድስ መደር በይሑዳ ወንግሠሑ በሰማ ግዝየ ተዛዬ ወወር ጔና። ጔታ በብርዛዝ ያጥኔቈቈን ስለኸነው፤ ተገሊላ አውራጃዬ ወረ፤ <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />በነብዮች “ናዝሬቱ ይቡሪ” ቧሪም የቴወደዪ ይትፌጠሜ ናዝሬት ቲቡሪዪ ከተማዬ ቸኘም ቶና።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፥1</ref>፤ <ref loc="MRK 1:24">ማር. 1፥24</ref>፤ <ref loc="LUK 2:39">ሉቃ. 2፥39</ref>፤ <ref loc="JHN 1:45">ዮሐ. 1፥45</ref>። </char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">የመጥምቂ የዮሐንስ ስብከት</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1፥1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፥1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሐ. 1፥19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />በዛም ግዝየ ይጠምቂ ዮሐንስ በይሑዳ በረሐ ቲሰብክ ቸኘ። <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ስብከተሑም፣ “ዘ! መንግሥተ ሰሜ ቀረበም ንስሐ ግቦ” ይብር ባነ።<note caller="-" style="x"><char style="xo" closed="false">3፥2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቴ. 4፥17</ref>፤ <ref loc="MRK 1:15">ማር. 1፥15</ref>። </char></note> <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />በነብዪ በኢሳያስ እኪ ቧሪም የቴወደነ ሑቲቱ፤</para>
  <para style="q1" vid="MAT 3:3">“በበረሐ፤ ‘የጔታ ኤማ አዝጋዶ፤</para>
  <para style="q2" vid="MAT 3:3">ጎዳናዪም አስትካክሎ’ ቲብር ው ይብር ጣምባ።”<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፥3</ref>። </char></note><verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />የዮሐንስ ልባስ በጋሜላ ድገር የሸከተ ባነ፤ በጊንዠሑም ጥብጣብ ኧጉጀኘ ባነ፤ ስንቀሑም ፌንጣ የጣዝማም ውየ ባነ፤<note caller="-" style="x"><char style="xo" closed="false">3፥4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ነገ. 1፥8</ref>፤ <ref loc="ZEC 13:4">ዘካ. 13፥4</ref>፤ <ref loc="LEV 11:22">ዘሌ. 11፥22</ref>። </char></note> <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />በዛም ግዝየ በኢየሩሳሌም ብንም በይሑዳ ገኝ፥ በዮርዳኖስም ጭጭሳሑ እንም፥ ሰቦች ተዮሐንሴ ይቸኖ ባነ። <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />አጢያተሕኖ በወናዘዝ፥ በዮርዳኖስ ኧድየ በዮሐንስ ኧጅ ይጠመቆ ባነ።<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ቢኸንም፥ ዮሐንስ ፈሪሳውያን ተሰዱቃውያንም ብዠሕኖ የወጠመቅ ተሑቲዬ ቲቸኖ ባዠ ግዝየ፥ እኪ ባረኖ፦ “አሑ የእንድወደረ ዴንጋ! ቲቸኚ ማት ታመልጦኸም ሟ አጥኔቀቀናሑ?<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቴ. 12፥34</ref>፤ <ref loc="MAT 23:33">23፥33</ref>። </char></note> <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />በይሽ ንስሐ ወግባሑ ያምለክት ሜና ሰክቶ። <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />‘ኢና የአብርሐም ዴንጋ ንነ’ በወበር ታመልጦ ኤይምስርኩ፤ እዝጌር ተዚ እምን የአብርሐም ዴንጋ ያትኔሳነዬ ይችል ኧብርሑ።<note caller="-" style="x"><char style="xo" closed="false">3፥9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዮሐ. 8፥33</ref>። </char></note> <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />ዘ፥ ጌዞ የጨ ሥር ያርጤ ተዝጋጀም፤ ስለኸነም ፈያ ፍርየ ኤያወርድ ኧጨ እንም ይቅመጠል፤ ተሳቴ ያድጒ።<note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቴ. 7፥19</ref>። </char></note><verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />“ዘ፥ እያ የንስሐ በኧጋ አጠምቁሑ፤ ቲያ አንቌ ይቸኚም በመንፈስ ቅዱስ በሳትም ያጠምቁሑ፤ ሑቲ ቲያ ስርም ይበዛ፤ እያ የግረሑ ጫማ የወጮር የትጌባሑ አንከንኩ። <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ሑቲ መንሺ በጀውታው። በመንሺም ውድማዪ ፈያ ሸከተም ያᎆጥር። ስሬዪ በሻት ይዀራን፤ ገለባዪም ቤይጠፋ ኧሳት ያነጅጅ።”<verse eid="MAT 3:12" /></para>
  <para style="s1">የኢየሱስ ወጠመቅ</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1፥9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፥21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />በዛ ግዝየ ኢየሱስ በዮሐንስ የወጠመቅ በገሊላ ተዮርዳኖስ ኧድየዬ ቸኘ። <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />ዮሐንስም “ዚሽ ኤኸን፤ እያ ባኸ ኧጅ ወጠመቅ ቲጌቤ፥ ምንኸም አኸ ቲያዬ ትቸኝ!” ባረም ይዀትር ቀረሰ።<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />ኢየሱስም “የጽድቅ ሜና እንም በዚ ኤማ ወፈጥም ይጌባነ ስለኸነ፥ ኧሗሽ ግፉር፤ ዛምኸም የሕን” ቲብር ዠᎄረነ። ዮሐንስም በዘንጋዪ ተስማማም የኢየሱስ አጠᎀቈን። <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />ኢየሱስ ተጠመቀም ሒንጌም በኧጋዪ ተወጣኸም ሰሜ ተከፈተ፤ የእዝጌርም መንፈስ በቡላል መሰረም ወረደም በኢየሱስ ᎈር ቲያᎈይ አዠ። <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />በዛም ግዝየ “ዘ፥ በሑቲ ኧትብላለቅ ኧወጅጂ ትኸኛ ዚ ሙ” ይብር ጣምባ በሰሜ ቸኘ።<note caller="-" style="x"><char style="xo" closed="false">3፥17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዘፍ. 22፥2</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 12:18">ማቴ. 12፥18</ref>፤ <ref loc="MAT 17:5">17፥5</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9፥35</ref>። </char></note><verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">የኢየሱስ ወፈተን</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1፥12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4፥1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />በዛ አንቌ፥ ኢየሱስ በዳቡሎስ ይትፌተኔ የእዝጌር መንፈስ ተበረሐዬ ወሰደን።<note caller="-" style="x"><char style="xo" closed="false">4፥1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">ዕብ. 2፥18</ref>፤ <ref loc="HEB 4:15">4፥15</ref>። </char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />በዛም አርባ ከነ አርባ ምሳርም በጦመ አንቌ ጓደን።<note caller="-" style="x"><char style="xo" closed="false">4፥2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">ዘፀ. 34፥28</ref>፤ <ref loc="1KI 19:8">1 ነገ. 19፥8</ref>። </char></note> <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />ፈታኚ ተኢየሱሴ ቸኘም፥ “አኸ የእዝጌር ትኸ በኸንከ፥ እንዴ ነዚ እምን እንጄራ ይኸንኸም ኧዝዝ” ቧረን።<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />ኢየሱስም “‘ሰብ ይነብር በእዝጌር አፍ ቢወጣ ቃል እንም አንከንም፥ በእንጄራ ጠለለ አንከነ’ ቧሪም ተጣፈም” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">4፥4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ዘዳ. 8፥3</ref>። </char></note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />በዛ አንቌ፥ ዳቡሎስ የኢየሱስ ተቅዱስ ከተማዬ ተኢየሩሳሌሜ ወሰደም በቤተ መቅደስ ቁሬት ᎈር አቈመን፤<note caller="-" style="x"><char style="xo" closed="false">4፥5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">ነሕ. 11፥1</ref>፤ <ref loc="DAN 9:24">ዳን. 9፥24</ref>። </char></note><verse eid="MAT 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 4:6" />“‘ኧግራኸ ብምን ኔስናከሎ፥</para>
  <para style="q2" vid="MAT 4:6">በጀሕኖ ይዴግፎከዬ መላዪካዪ ዬዝዝንከ’</para>
  <para style="m" vid="MAT 4:6">ቧሪም ጣᎉም አኸ የእዝጌር ትኸ በኸንከ፥ በዚ ተተቴ ጉነናኸ ኧረግ” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">4፥6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">መዝ. 91፥11-12</ref>። </char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ኢየሱስም ዠበረም “‘ጔታ አምላካኸ አትፉታተን’ ቧሪም ኧሗም ተጣፈም” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">4፥7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ዘዳ. 6፥16</ref>። </char></note><verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />ዠበረም ዳቡሎስ የኢየሱስ ስርም ከፍ ተባረ ተቈቶ ᎈሬ አወጣንም፥ የዓለም መንግሥታት እንም ተክብረሕኖ ጌ አቴዠንም፤ <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“ሙግ ባኸም ብትሰግድኒ ዚ እንም ይብከ” ቧረን።<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />በዛ ግዝየ ኢየሱስ “‘የጔታ የአምላካኸ ስግድ፤ ሑቲም ጠለለ አምልኩ!’ ቧሪም ተጣፈም፥ ሽበር! አኸ ሼጣን ቲፍተኛዬ ሽቅ በር!” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ዘዳ. 6፥13</ref>። </char></note><verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />በዛ አንቌ ዳቡሎስ የኢየሱስ ገᎈረን፤ መላይካም ቸኖም አግለገሎይ።<verse eid="MAT 4:11" /></para>
  <para style="s1">ኢየሱስ የዋትመር ሜናሑ በገሊላ ገኝ የቀረሰኸም</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1፥14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4፥14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />ኢየሱስ የዮሐንስ ኧጉጀኘ በሰማ ግዝየ ተገሊላ ገኜ ወረ።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቴ. 14፥3</ref>፤ <ref loc="MRK 6:17">ማር. 6፥17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፥19-20</ref>። </char></note> <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />የናዝሬትም ከተማ ገፈረም፥ በዛብሎን በንፍታሌም አውራጃ በገሊላ ባር ᎀረ ይትረከቢ ተቅፍርናሖም ከተማዬ ቸኘም ቶና።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ዮሐ. 2፥12</ref>። </char></note><verse eid="MAT 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 4:14" />ዚም የኸነ፥ ነብዪ ኢሳያስ እኪ ቲብር የዝነጔን የትምቢት ቃል ይፌጠምኸም ሙ፤<verse eid="MAT 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 4:15" />“የዛብሎን ገኝ፤ የንፍታሌም ገኝ፤</para>
  <para style="q2" vid="MAT 4:15">በዮርዳኖስ ዛዘር በባር ኤማ ᎀረ፤</para>
  <para style="q1" vid="MAT 4:15">ያነዪ የአሕዛብ ገሊላ፤<verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />በጨለማ ይነብር ሕዝብ ወደል ብራን አዠ፤</para>
  <para style="q2" vid="MAT 4:16">በሞት ጥሌል ባደገወ ገኝ ይነብሮዪ ብራን ወጣኖ።”<note caller="-" style="x"><char style="xo" closed="false">4፥15-16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9፥1-2</ref>። </char></note><verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />ተዛ ግዝየ ቀረሰም ኢየሱስ፥ “የእዝጌር መንግሥት ቀረበም ንስሐ ግቦ!” ቲብር ወስብክ ቀረሰ።<note caller="-" style="x"><char style="xo" closed="false">4፥17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቴ. 3፥2</ref>። </char></note><verse eid="MAT 4:17" /></para>
  <para style="s1">ኢየሱስ አርበት ዓሣ ያሰግሮ የጠራኖኸም</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1፥16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፥1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />ኢየሱስ በገሊላ ባር ᎀረ ቲቸለፍ፥ ዓሣ ያሰግሮ የነበሮዪ ዄቲ ጐባቢት ሕኖም ጴጥሮስ የቧሪዪ ስምዖን የጐቤች የእንድርያስም መረበሕኖ ተባሪዬ ቲያድጎ አዠ። <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ኢየሱስም “ኔሑ ተኸተሎኝ፤ ዓሣ ታውሳኮኸም የሰቦች እንም ትስበስቦኒኸም ኧሸክትኩ” ባረኖ። <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ሕኖም ሒንጌም መረብሕኖ ገፈሮም ተዄተሎይ።<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ተዛም ተቸለፈም፤ እንጐድ ዄት የዘብዴዎስ ትኸ ያዕቆብ ጐቤች ዮሐንስም አዠ። ተአባሕኖ ተዘብዴዮስ ጌ በጀልባ ውስጥ መረበሕኖ ይጥገግኖ ባነ። ኢየሱስም ጠራኖ፤ <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ሕኖም ሒንጌም ጀልባዪ አባሕኖም ገፈሮም ተዄተሎይ።<verse eid="MAT 4:22" /></para>
  <para style="s1">ኢየሱስ የብዠ ሰቦች አትመረም ፈያ የሸከተኸም</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6፥17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />ኢየሱስም በምኩራበሕኖ<note caller="+" style="f"><char style="fr" closed="false">4፥23 </char><char style="fqa" closed="false">ምኩራብ፦ </char><char style="ft" closed="false">በመሠረተሑ ይስበሰቦᎄ መደር ቲኸን፥ የአይሑድ ጠሎት ቤትም ምኲራብ ይቡሪ። </char></note> ቲያትመር የእዝጌር መንግሥት የምስራች ቃል ቲሰብክ፥ በትልያየ ባሸ ኧቂናም የጠበጦዪም ሰቦች ፈያ ቲሸክት በገሊላ ገኝ እንም ይዥዋወር ባነ።<note caller="-" style="x"><char style="xo" closed="false">4፥23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቴ. 9፥35</ref>፤ <ref loc="MRK 1:39">ማር. 1፥39</ref>። </char></note> <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />በዚም የትነሣ ዝናውታ ብንም ሶርያ ተሴማ፤ ሕዝቢም በትልያዮ ባሸ በቡሼ ባሸ ይስቃዮዪ፥ በሩክስ መናፍስት የጠበጦዮዪ፥ ያድግ ባሸ ያነቦዪ ጅረዎቺ እንም ተውቲዬ አቸኖ፤ ሑቲም ፈያ ሸከተኖ። <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ተገሊላ ገኝም ዐሥር ከተማ<note caller="+" style="f"><char style="fr" closed="false">4፥25 </char><char style="fqa" closed="false">ዐሥሪ ከተማ፦ </char><char style="ft" closed="false">ግሪክኛ ይዝነጎዪም አይሑድ ያንከኖዪ ሕዝብ ቁናዬ ይነብሮዪ መደር ዐሥር ከተማ ይቡሪዮ። ነዚ ከተማ አብዛኛሕኖ ይትረከቦ በገሊላ ባር በምሥራቅ አዘርም በሰሜን ምሥራቅ አዘሩ። </char></note> በኢየሩሳሌም በይሑዳ፥ በዮርዳኖስም ኧድየ ዛዘር የቸኖ ብዠ ሰቦች የኢየሱስ ተዄተሎይ።<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="ms">ኢየሱስ በቈቶ ᎈር ኸነም ያትᎀረን ትምርት</para>
  <para style="mr">(<ref loc="MAT 5-7">ማቴ. 5—7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ኢየሱስ ይትዄተሎዪ ብዠ ሕዝብ ባዠ ግዝየ፥ ተቈቶዬ ወጣም ቶና፤ ደቀ መዛሙርተሑ ተሑቲዬ ቀረቦ። <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />እኪ ቲብር ያትመሮ ቀረሰ፤<verse eid="MAT 5:2" /></para>
  <para style="s1">የኢኒ በረካ ይረሕቦ ሰቦች</para>
  <para style="r">(<ref loc="LUK 6:20-23">ሉቃ. 6፥20-23</ref>)</para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />“መንግሥተ ሰሜ የሕኖ ስለኸነ በመንፈስ</para>
  <para style="q2" vid="MAT 5:3">ዜጋ የኸኖ የትባረኮኖ።<verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />እዝጌር ወጥናና ይቦ ስለኸነ ያዝኖዪ</para>
  <para style="q2" vid="MAT 5:4">የትባረኮኖ።<verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />ቁና ቀልብ የኸኖ አፈር ይወርሶ ስለኸነ የትባረኮኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">መዝ. 37፥11</ref>። </char></note><verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />ጽድቅ ይትገዶም ይጠማኖዪ ይጦፎ ስለኸነ</para>
  <para style="q1" vid="MAT 5:6">የትባረኮኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">ኢሳ. 55፥1-2</ref>። </char></note><verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />ምረት ይረሕቦ ስለኸነ ምረት ይሸክቶዪ የትባረኮኖ።<verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />የእዝጌር ያዞይ ስለኸነ ንጡ ሒን ያነኖ የትባረኮኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥8 </char><char style="xt" closed="false"><ref loc="PSA 24:3-4">መዝ. 24፥3-4</ref>። </char></note><verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />በሰቦች ግብት ዕርቅ ሰላምም ይሸክቶ፥</para>
  <para style="q2" vid="MAT 5:9">የእዝጌር ዴንጋ ይቡርዮ ስለኸኖ የትባረኮኖ።<verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />የጽድቅ ይሰደዶዪ፥ መንግሥት ሰሜ የሕኖ ስለኸነ</para>
  <para style="q2" vid="MAT 5:10">የትባረኮኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጥ. 3፥14</ref>። </char></note><verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“ቢያ መሳ ሰቦች ቲሰድቦኩ፥ ቲያሳድዶኩ፥ በባጢልም ሽማሑ ቲያጠፎይ ተብላለቆ።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 ጴጥ. 4፥14</ref>። </char></note> <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />በመንግሥተ ሰሜ ትረሕቦዪ ዋጋ ወደል ስለኸነ ተብላለቆ፤ ስርም ተብላለቆ። ታሑ ኢፍቴ የነበሮዪ ነብዮች ዛምኸም ስደት መከራም አሰሎቦም።”<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ዜና 36፥16</ref>፤ <ref loc="ACT 7:52">ሐዋ. 7፥52</ref>። </char></note><verse eid="MAT 5:12" /></para>
  <para style="s1">አሶ ብራንም</para>
  <para style="r">(<ref loc="MRK 9:50">ማር. 9፥50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፥34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />ቄጠለም ኢየሱስ እኪ ባረ፦ “አሑ የአፈር አሶንኩ፤ ቢኸንም አሶ ታምናሑ በቀበጠ ምንኸም ታምናሑ ዠበረም ይረሕቤ ይችል? ተወረጀዬ ተወድግም፥ በሰብ ኧግር ተወረገጥ አንከንም ቲፍቴዬ ያትም ቃር ኤድገልል።<note caller="-" style="x"><char style="xo" closed="false">5፥13 </char><char style="xt" closed="false"><ref loc="LUK 14:34-35">ሉቃ. 14፥34-35</ref>። </char></note><verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“አሑ የዓለም ብራንንኩ፤ በቈቶ ᎈር የትረሸ ከተማ ይሼሜ ኤይችል።<note caller="-" style="x"><char style="xo" closed="false">5፥14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ዮሐ. 8፥12</ref>፤ <ref loc="JHN 9:5">9፥5</ref>። </char></note> <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />ሰቦችም ኩራዝ አበሮም በቤት ውስጥ ያወኖዪ እንም ያበራኖኸም ከፍ በባረ መደር ያወኖይ አንከንም በሌማት ተት ኤያወኖይ።<note caller="-" style="x"><char style="xo" closed="false">5፥15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር. 4፥21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8፥16</ref>፤ <ref loc="LUK 11:33">11፥33</ref>። </char></note> <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />ዛምኸም ሰቦች ፈያ ሜናሑ አዞም የሰሜዪ አባሑ ምስጋናኸ ይብሮኸም፥ ያኹም ብራን በሰቦች ኢፍቴ የብራ።”<note caller="-" style="x"><char style="xo" closed="false">5፥16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጴጥ. 2፥12</ref>። </char></note><verse eid="MAT 5:16" /></para>
  <para style="s1">የኦሪት ሕጊ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />ኧሗም ኢየሱስ እኪ ባረ፦ “የኦሪት ሕጊ የነብዮች ትምርትም የወሻር የቸኘሑ ኤምስርኩ፤ እያ ይፌጠሞኸም ኧሸክቶዬ ቸኘሑ አንከንም ኧሸሮዬ አንተኘሑ። <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />የኢን ኧብርሑ፤ ሰሜዪ አፈሪም ያልፎ ስን ሕጊ እንም ይፌጠም አንኸንም ተሕጊ አት ጭረትም አተውታ ነጥብ ኤሸሪ።<note caller="-" style="x"><char style="xo" closed="false">5፥18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ. 16፥17</ref>። </char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />ስለኸነም ተዚሕኖ ትዛዞች ያንሲ የኸነዪ ቁናዪ ያፈርሲ ኧንጐዲም ሰቦች እኪ ይሸክቶኸም ያትመር ሰብ በመንግሥተ ሰሜ ንቅ ይኸን። ቢኸንም ትዛዞቺ እንም ይፌጥም እንጐዲም ሰቦች ዛምኸም ይፌጠሞኸም ያትመር ሰብ በመንግሥተ ሰሜ ንቅ ይኸን። <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />ጽድቃሑ ተፈሪሳውያን ተኦሪት ሕጊ አስተማሪዎች ጽድቅ በዛም ባትረኸበ የሰሜ መንግሥት ወግባ አትችሎ።<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“በድረ ግዝየ የነበሮ ሰቦች የቧሪዪ ሰማሑም፤ ዚም ‘አትቅጥር፤ ሰብ የቀጠረ ይᎈርጅᎄ’ ይብሪው።<note caller="-" style="x"><char style="xo" closed="false">5፥21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ዘፀ. 20፥13</ref>፤ <ref loc="DEU 5:17">ዘዳ. 5፥17</ref>፤ <ref loc="DEU 16:18">16፥18</ref>። </char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />እያም ኧብርሑ፤ በጐቤች ᎈር ይማች<note caller="+" style="f"><char style="fr" closed="false">5፥22 </char><char style="fqa" closed="false">በጐቤች ᎈር ይማች፦ </char><char style="ft" closed="false">አታት የድረ ጡሑፍ “ኤድገልል ቃር” ይብር ቃል ይደብሮ። </char></note> እንም ይᎈርጅᎄ፤ ኧሗም የጐቤች፥ ‘አኸ አታድገልል!’ ባረም ይሳደብ በጀᎈሪ ይᎈርጅᎄ፤ ‘ኤገቧን!’ ባረም ይሳደብ ሰብ እንም የገሐነም ኧሳት ፍርድ ይትፈረድወ። <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />ስለኸነም መባኸ በመሠዊያዪ ᎈር የእዝጌር ብታቀርብወ ግዝየ፥ የማቸብከ ጐቤ ወንብረሑ ብታስታውስ፥ <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />መባኸ በመሠዊያዪ ኢፍት አውናም፥ ወርም ብድርም በዛ ተጐቤያኸ ጌ ታረቅ፤ በዛም አንቌ ተዘበርም መባኸ አቅርብ። <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />መሶአኸ ከሰሰናኸም ተሑቲጌ ተፍርድ ቤቴ ትታር ቤማ ᎈር ትናነኸ ከሞ በርም ተመሶሐጌ ተስማማ። ባንከነ መሶአኸ የዳኛ፥ ዳኛዪም ያቴግዲ አቼለፈም ይብከም ተወሕኔ ቤቴ ትገባ። <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />የኢን ኧብርኸ፥ የትፈረደብከዪ የመጨረሻዪ ፈረንክ ከፈልከም ትᎈጅን ስን ስርም በዛ አትወጣ።”<verse eid="MAT 5:26" /></para>
  <para style="s1">የወሟግጥ ያᎅ ትምርት</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />ቄጠለም ኢየሱስ እኪ ባረ፦ “‘አትሟግጥ!’ የቧሪኸም ሰማሑም።<note caller="-" style="x"><char style="xo" closed="false">5፥27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ዘፀ. 20፥14</ref>፤ <ref loc="DEU 5:18">ዘዳ. 5፥18</ref>። </char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />እያም ‘የምሽት አዠም የትሜናና እንም፥ በዛ ግዝየ በሒነሑ ተሒቲጌ ሟገጠ’ ኧብርሑ። <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />ከነዪ ኤናኸ ያጢያት መሳ ቢኸንብከ፥ አውጣም ኧድጉ! ገጋኸ በሙላ ተፍርድ ኧሳቴ ቲያድጒ ይጠቅል በገጋኸ ቁናዪ ክፍል ብትቀቡጭ ይጠቅለኸ።<note caller="-" style="x"><char style="xo" closed="false">5፥29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቴ. 18፥9</ref>፤ <ref loc="MRK 9:47">ማር. 9፥47</ref>። </char></note> <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />ከነዪ ኧጃኸ የአጢያት መሳ ቢኸንብከ፥ ኧርጥም ኧድጉ! ገጋኸ እንም ተፍርድ ኧሳቴ ቲያድጒ ይጠቅል ተገጋኸ አቲ ክፍል ብትቀቡጭ ይጠቅለኸ።<note caller="-" style="x"><char style="xo" closed="false">5፥30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቴ. 18፥8</ref>፤ <ref loc="MRK 9:47">ማር. 9፥47</ref>። </char></note><verse eid="MAT 5:30" /></para>
  <para style="s1">የወትፋታ ያᎅ ትምርት</para>
  <para style="r">(<ref loc="MAT 19:9">ማቴ. 19፥9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“ምሽተሑ ይፈታ እንም የᎈቸᎄ ወረቀት ያባ” ቧሪም።<note caller="-" style="x"><char style="xo" closed="false">5፥31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 19:7">ማቴ. 19፥7</ref>፤ <ref loc="MRK 10:4">ማር. 10፥4</ref>። </char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />እያም “በዝሙት መሳ ባንከነ አንኸንም፥ ምሽተሑ ይፈታ እንም ታምነዝርኸም ይሸክታ፤ የᎈቼያዪ ያገባና እንም አመንዝራ ይኸን” ኧብርሑ።<note caller="-" style="x"><char style="xo" closed="false">5፥32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቴ. 19፥9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፥11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፥18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>። </char></note><verse eid="MAT 5:32" /></para>
  <para style="s1">የወማል ያᎅ ትምርት</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />ኧሗም የበደሮ ሰቦች “በባጢል አትማሎ፤ ቢኸንም ማላሑ የጔታ ፈጥሞ” የቧሪዪ ሰማሑም።<note caller="-" style="x"><char style="xo" closed="false">5፥33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዘሌ. 19፥12</ref>፤ <ref loc="NUM 30:2">ዘሑ. 30፥2</ref>፤ <ref loc="DEU 23:21">ዘዳ. 23፥21</ref>። </char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />እያም “ስርም አትማሎ” ኧብርሑ። ሰሜዪ የእዝጌር ዙፋን ስለኸነ፥ በሰሜም ቢኸን፥<note caller="-" style="x"><char style="xo" closed="false">5፥34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">ያዕ. 5፥12</ref>፤ <ref loc="ISA 66:1">ኢሳ. 66፥1</ref>፤ <ref loc="MAT 23:22">ማቴ. 23፥22</ref>። </char></note> <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ዐፈርም የጔታ ኧግር ያᎈይወ ስለኸነ በአፈርም አትማሎ፤ የንኢ ንጉሥ ከተማ ስለኸነ በኢየሩሳሌምም አትማሎ፤<note caller="-" style="x"><char style="xo" closed="false">5፥35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፥1</ref>፤ <ref loc="PSA 48:2">መዝ. 48፥2</ref>። </char></note> <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />በጉነናኸ አቲ ነጨ ጥቁርም ወሰክት አትችል ስለኸነ በነብሳኸም ቢኸን አትማል። <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />ስለኸነም ንግግራሑ “ኤክ፥” በኸነም “ኤክ፥” “አንከነ” በኸነም “አንከነ” የሕን። ተዚ የተረፈ ቃልም ተሼጣኑ።<note caller="-" style="x"><char style="xo" closed="false">5፥37 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዘሌ. 19፥12</ref>፤ <ref loc="NUM 30:2">ዘሑ. 30፥2</ref>፤ <ref loc="DEU 23:21">ዘዳ. 23፥21</ref>። </char></note><verse eid="MAT 5:37" /></para>
  <para style="s1">ቂም ወጥብጥ ኤጌባነ</para>
  <para style="r">(<ref loc="LUK 6:29-30">ሉቃ. 6፥29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“‘ዔን ስለ ዔን፥ ስን ስለ ስን’ የቧሪኸም ሰማሑም።<note caller="-" style="x"><char style="xo" closed="false">5፥38 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ዘሌ. 19፥12</ref>፤ <ref loc="NUM 30:2">ዘሑ. 30፥2</ref>፤ <ref loc="DEU 23:21">ዘዳ. 23፥21</ref>። </char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />እያም እኪ ኧብርሑ፤ ቡሼ ይሸክትብኩ ሰብ አትቀበሮይ። ቢኸንም ከነ ወኸታኸ ይወካኸዪ፥ ጉራ ወኸታኸ አቡ። <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />አት ሰብ ሸሚዛኸ የወውስድ ቢሸ ቢከሰኸ፥ ኮታኸም ይወስድኸም ግፉርነ። <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />አት ሰብ ‘ቲያጌ ቀል ኤማ ወር’ ባረም ቢያትሜካኸ፥ አኸም ድብርማኸ ወርነ። <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ይጮቅስከዪ አቡ፤ ተአኸ ወታደግ ይሸ እንቢ አትᎄን።”<note caller="-" style="x"><char style="xo" closed="false">5፥42። </char><char style="xt" closed="false"><ref loc="DEU 15:8">ዘዳ. 15፥8</ref>፤ <ref loc="PRO 24:29">ምሳ. 24፥29</ref>። </char></note><verse eid="MAT 5:42" /></para>
  <para style="s1">መሦ ወውድድ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ. 6፥27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />ቄጠለም ኢየሱስ እኪ ባረ፦ “‘ደቦማኸ ውደድ፤ መሶኸ ጥላ’ የቧሪኸም ሰማሑም።<note caller="-" style="x"><char style="xo" closed="false">5፥43። </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዘሌ. 19፥18</ref>። </char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />እያም መሶአሑ ውደዶ፤ ይሰድቦኩዪ መርቆ፤ ይጠሎኩዪ ፈያ ሰክቶ፤ ቡሼ ይሸክቶቡኩዪ፥ ያሳድዶኩዪም ጠልዮ” ኧብርሑ።<note caller="-" style="x"><char style="xo" closed="false">5፥44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">ምሳ. 25፥21-22</ref>። </char></note> <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ዚ ብትሸክቶ፥ በሰሜ ያነዪ አባሑ ዴንጋ ትኸኖ። ሑቲ የቡሼዎች የሩሕሩሖችም ጬት ያወጣ፤ ዛምኸም የጻድቃን የግፈኛም ዝናቢ ያዘንብ። <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />ይወዶኩዪ ሰብ ጠለለ ብትወዶ ምን ጄዛ ነነናሑ? ቀራጮችሽ ዛምኸም ይሸክቶ ኤነ? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />የጐባቢታሑ ጠለለ ሰላም ቲቦ በኸነ ምን ይበዛአር ያነን ቃር ትሸክቶ? አሕዛብሽ ዛምኸም ይሸክቶ ኤነ? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />ስለኸነም የሰሜ አባሑ ፍጡም የኸነኸም አሑም ፍጡም ሕኖ።<note caller="-" style="x"><char style="xo" closed="false">5፥48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ዘሌ. 19፥2</ref>፤ <ref loc="LEV 18">18</ref>፤ <ref loc="DEU 18:13">ዘዳ. 18፥13</ref>። </char></note><verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">ምጽዋት ይᎅኸም</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />ኧሗም ኢየሱስ እኪ ባረ፦ “ሰቦች የዞንነ ባሑም ፈያ ሜናሑ በሰቦች ኢፍት ተወሰክት ተቀሮ፤ ባንከነ፥ በሰሜ አባሑዬ አትም ጄዛ አትረሕቦ።<note caller="-" style="x"><char style="xo" closed="false">6፥1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">ማቴ. 23፥5</ref>። </char></note><verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“ስለኸነም የዜጋ ምጽዋት ብቲቦᎄ ግዝየ፥ ግብዞች በሙኩራብ ቤማም ይሸክቶይኸም ይታዥንኩዬ አትሰክቶ፤ የኢን ኢውድሑ፥ ሕኖ ጄዛሕኖ በደሮም ረከቦም። <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />አኸም ምጽዋት ትቲብ ከነ ኧጃኸ ይሸኩቺ ጉራ ኧጃኸ ኤሐር። <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />በይሽ ምጥዋታኸ በሽሙቸ የሕን፤ በሽሙቸ የሸኰቺዪ ያዢ አባኸ፥ የፈያ ሜናኸ ጄዛ ይከፍለኸ።<verse eid="MAT 6:4" /></para>
  <para style="s1">ስለ ጠሎት</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11፥2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“ብትጤልዮᎄ ግዝየ የግብዞችኸም አትሕኖ! ሕኖ ሰብ ያዥኖኸም ባሮም በምኩራብ ቤማም ᎀረ ቈሞም ወጠልይ ይወዶ። የኢን ኧብርሑ፥ ሕኖ ጄዛሕኖ በደሮም ረከቦም።<note caller="-" style="x"><char style="xo" closed="false">6፥5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18፥10-14</ref>። </char></note> <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />አኸም ትትጤልይ፥ ተክፍላኸዬ ግባም፥ ወዝገባኸ ኧጭማኸ በሽሙቸ ታነዪ ቴይታዢ አባኸዬ ጠልይ፤ በሽሙቸ የሸኰቺዪ ያዢ አባኸ የፈያ ሜናኸ ጄዛ ይከፍለኸ።<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />“አሑ ትትጤልሎ የአሕዛብኸም ኤድገልል ቃል በወድጋግም አትዘንጎ፤ ሕኖም በወድጋገመሕኖ ብዛት እዝጌር ጠሎተሕኖ ይሰማኖ ይመስሮ።<note caller="-" style="x"><char style="xo" closed="false">6፥7 </char><char style="xt" closed="false"><ref loc="1KI 18:25-29">1 ነገ. 18፥25-29</ref>። </char></note> <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />አሑ፥ አባሑ ያሸሑዪ ቃር ገና ታትጮቅሶይ በደረም ይሒር ስለኸነ የሕኖኸም አትሕኖ። <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />ስለኸነም አሑ እኪ ባሑም ጠልዮ፦</para>
  <para style="q1" vid="MAT 6:9">“‘በሰሜ ያነኸ አባና!</para>
  <para style="q2" vid="MAT 6:9">ሽማኸ የክብር፤<verse eid="MAT 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10" />መንግሥታኸ የተኝ፤</para>
  <para style="q2" vid="MAT 6:10">ፈአዳኸ በሰሜ የኸነም፥</para>
  <para style="q2" vid="MAT 6:10">ዛምኸም ባፈር የሕን።<verse eid="MAT 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11" />የከነ እንጄራና ኧኳ ናመነ።<verse eid="MAT 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 6:12" />ይናም የቤደሎነዪ አፉ ኧብርነኸም፥</para>
  <para style="q2" vid="MAT 6:12">በደለናም አፉ በረነ፤<verse eid="MAT 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 6:13" />ተቡሼ አትርፈነ አንኸንም፥</para>
  <para style="q2" vid="MAT 6:13">ተፈተናዬ፥ አትሕራነ፤</para>
  <para style="q2" vid="MAT 6:13">[መንግሥት፥ ቆት ክብርም</para>
  <para style="q2" vid="MAT 6:13">የዘለዓለም ያኸቱ፤</para>
  <para style="q2" vid="MAT 6:13">አሜን።’]<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“የሰቦች በደል አፉ ብትብሮኖ፥ ያሑም የሰሜዪ አባሑ አፉ ይብርሑ። <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />የሰቦች አጢያት አፉ ባትብሮዮ ያሑም የሰሜዪ አባሑም አጢያታሑ አፉ ኤይብርሑ።”<note caller="-" style="x"><char style="xo" closed="false">6፥14-16 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">ማቴ. 11፥25-26</ref>። </char></note><verse eid="MAT 6:15" /></para>
  <para style="s1">ስለጦም</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />ኢየሱስም ዠበረም እኪ ባረ፦ “ብትጦሞᎄ ግዝየ፥ ወጦመሕኖ ሰቦች ይሒሮኖኸም፥ ኢፍተሕኖ ይሸግሮይኸም የግብዞችኸም፥ ኢፍታሑ አታዶግሎ፤ የኢን ኧብርሑ፥ ሕኖ ጀዛሕኖ ተቌበሮም።<note caller="-" style="x"><char style="xo" closed="false">6፥16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">ኢሳ. 58፥5</ref>። </char></note> <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />አኸ ብትጦምወ ግዝየ ኢፍታኸ ታጠብ፤ ጉነናኸም ተቀባ፤ <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />በዚ ሐለት፥ ወጦማኸ በሽሙቸ ታነዪ አባኸ አንኸንም እንጐድ ሟንም ኤይሒር። በሽሙቸ የሸከተዪ ያዥ አባኸ ጄዛኸ ይከፍለኸ።”<verse eid="MAT 6:18" /></para>
  <para style="s1">ባፈር ᎈር ዱኒያ ወሰብስብ ኤይጌባኸም ዋትመረሑ</para>
  <para style="r">(<ref loc="LUK 12:33-34">ሉቃ. 12፥33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />ኧሗም ኢየሱስ እኪ ባረ፦ “ወት፥ ዝገትም ቢያጠፎᎄዪ፥ ሌባም ሰበሮም ቢሰርቆᎄዪ፥ በዚ አፈር ᎈር የነብሳሑ ዱኒያ አትሰብስቦ።<note caller="-" style="x"><char style="xo" closed="false">6፥19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">ያዕ. 5፥2-3</ref>። </char></note> <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />ይጠቅልሽ ዱኒያሑ ወት ዝገትም ያጠፎዬ ቤይችሎᎄ፥ ሌባም ሰበሮም ቤይሰርቆᎄ በሰሜ ዱኒያሑ ሰብስቦ። <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />ዱንያኸ ባነወ ሒናኸ በዛዬ ይኸን።<verse eid="MAT 6:21" /></para>
  <para style="s1">የገግ ብራን</para>
  <para style="r">(<ref loc="LUK 11:34-36">ሉቃ. 11፥34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“ዔን የገግ ብራኑ፤ ስለኸነም ዔናኸ ፈያ በኸነ፥ ገጋኸ እንም ብራን ይኸን፤ <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />ኤናኸ ፈያ ባንከነ፥ ገጋኸ እንም ጨለማ ይኸን። በይሽ ባኸ ያነዪ ብራን ጨለማ በኸነ፥ ጨለማዪ ምንኸም ይብስ ይኸን!<verse eid="MAT 6:23" /></para>
  <para style="s1">ስለኑሮ አለወጨነቅ</para>
  <para style="r">(<ref loc="LUK 16:13">ሉቃ. 16፥13</ref>፤ <ref loc="LUK 12:22-31">12፥22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“አት ሰብ የዄት ጔታ አገልጋይ ይኸኔ ኤይችል፤ አቲ ይጠላ፥ አተሑ ይወድ፤ አቲ ያከብር፥ ኧንጐደሑ ይገርጥ፤ ዛምኸም አት ሰብ በቁናጌ የእዝጌር የዋጋም አገልጋይ ወሕን ኤይችል። <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />ስለኸነም እኪ ኧብርሑ፤ ‘ምን ኧበራነ? ምን ኧሰጭነ? ምንሽ ኧለብስነ?’ በወበር የኑሮአሑ አትጨነቆ፤ ተስንቅ ሕይወት፥ ተልባስ ገግ ኤይበዛ? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />እንዴ በሰሜ ᎈር ይበሮዪ አንፉ ኧዞ፤ ሕኖም ኤይዘሮ፤ ኤያዶ፤ በጐተራ ኤይኸሮ፤ ቢኸንም የሰሜዪ አባሑ ያበራኖ። ኧጌ አሑ ታንፉዎች ስርም አትበዞ? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />ወሕነሑ ባሑ በወጨነቅ፥ በድሜሑ ᎈር ቁና ከነ<note caller="+" style="f"><char style="fr" closed="false">6፥27 </char><char style="fqa" closed="false">በዕድሜሑ ᎈር ቁና ከነ፦ </char><char style="ft" closed="false">ባታት ትርጉም </char><char style="fqa" closed="false">በቁመተሑ ᎈር አት ሕረ</char><char style="ft" closed="false">ይብር ይትረከብ። </char></note> ወድብር ይችል ሟኒ?<note caller="-" style="x"><char style="xo" closed="false">6፥27 </char><char style="xt" closed="false"><ref loc="PSA 39:5-7">መዝ. 39፥5-7</ref>። </char></note> <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />ኧሗም አሑ የልባስ የመአር ትጨነቆ? የጠባ አበባ ምንኸም ይለቆኸም እንዴ ኧዞ፤ ሕኖ በሜና ኤይቌጦ፤ ኤይፈትሎ፤ <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />ቢኸንም ሰሎሞን በዛ እንም ክብረሑ፥ ተሕኖ ያቲኸም አለበሰ ኧብርሑ።<note caller="-" style="x"><char style="xo" closed="false">6፥29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 ነገ. 10፥4-7</ref>፤ <ref loc="2CH 9:3-6">2 ዜና 9፥3-6</ref>። </char></note> <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />ኧጌ ኧኳ አዢም ነገ በሳት ውስጥ ያድጒዪ የጠባ ሠር እዝጌር እኪ ያለቡሽ በኸነ አሑ እምነት የቀበለናሑ! ያሑማ ምንኸም አበዛም ኤያለብስሑ! <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />ስለኸነም ‘ምን ኧበራነ? ምን ኧሰጭነ? ምንሽ ኧለብስነ?’ ባሑም በዋስብ አትጨነቆ። <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />ዚ የወርክብማ አሕዛብ ይሸዎ፤ አሑ ዚ እንም ያሸሑኸም የሰሜ አባሑ ይሒር። <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />አሑ ብድሮም የእዝጌር መንግሥት ጽድቀሑም ሳቦ፤ የቀኘዪ እንም ይደቡርንኩ፤ <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />ነገ የነብሰሑ ይጨነቅ፤ የነገ አትጨነቆ፤ የከነዪ ቡሼነተሑ ይዀን።”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">ብንጐድ ᎈር ወፍርድ ኤይጌባ ወሕነሑ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6፥37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />ቄጠለም ኢየሱስ እኪ ባረ፦ “ባሑ ᎈር ኤᎈርጅቡኩኸም፥ በሟንም ᎈር አትፍርዶ፤ <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />ብንጐድ ᎈር ብትፈርዶᎄ ፍርድ፥ ባሑም ᎈር ይᎈርጅብኩ፤ ዛምኸም ብትቃጦᎄዪ ግብር ይቋጨንኩ።<note caller="-" style="x"><char style="xo" closed="false">7፥2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4፥24</ref>። </char></note> <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />ባኸ ዔን ያነዪ ገሰስ ታታዥ፥ የመአር በጐቤያኸ ዔን ውስጥ ያነዪ ገሰስ ትምሌከት? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />ኧሗም ባኸ ዔን ውስጥ ያነዪ ገሰስ ትናነ፥ የጐቤያኸዪ ‘እንዴ ቤናኸ ያነዪ ገሰስ ናውጣንከ’ ምንኸም ትቡን? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />አኸ ግብዝ! ብደርም ባኸ ዔን ያነዪ ገሰስ አውጣ፤ በዛም አንቌ፥ በጐቤያኸ ዔን ውስጥ ያነዪ ገሰስ የዋውጣ ታጥራምትም ታዥ። <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />የትቄደሰዪ ቃር የጊየ አታቦ፤ ዕንቁአሑ በዐሣማ ኢፍቴ አትድጎ፤ ዐሣማዪ ዕንቁአሑ በግረሕኖ ይረቅጦይ፤ ጊየዪም ተዠበሮም ይነክሶኩ።<verse eid="MAT 7:6" /></para>
  <para style="s1">የጠሎት ውጤተሑ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11፥9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“ጮቅሶ ይቡኩ፤ ሳቦ ትረሕቦ፤ ወዝገብ ቀብቅቦ ይከፈትንኩ፤ <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />ይጮቅስ እንም ይቌበር፤ ይሸዪም ይረሕብ፤ ወዝገብ ይቅበቅቢም ይከᎈትነ። <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />ባኹ ግብት ትኸኹ ቂጣ ቢጮቁሽ እምን ይᎅ ሟኒ? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />ዓሣ ቢጮቁሽሽ እንድወደረ ይቡ? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />በይሽ አሑ ቡሼ ኸንኩም ትናነሑ፥ የዴንጋሑ ፈያ ቃር ዋብ በሐርኩ፤ ኧጌ፥ በሰሜ ያነዪ አባሑማ ይጮቅሶዪ ምንኸም አበዛም ፈያ ቃር ኤይቦ! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />ኧጌሽ ሰቦች ይሸክቶኑኩዬ ትሸዎዪ እንም፥ አሑም የሕኖ ዛምኸም ሰክቶኖ፤ የሙሴ ሕጊ የነብዮች ትምርትም ይብሮይ ዛምኸሙ።<note caller="-" style="x"><char style="xo" closed="false">7፥12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ. 6፥31</ref>። </char></note><verse eid="MAT 7:12" /></para>
  <para style="s1">ስለጡቂ በር</para>
  <para style="r">(<ref loc="LUK 13:24">ሉቃ. 13፥24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“በጡቂ በር ግቦ፤ ተጥፋቴ ይገᎄᎄዪ በር በተቱ፥ ኤማሚ ወደሉ። ተዛዬ ይገቦዪም ሰቦች ብዠሕኖኖ። <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />ተሕይወቴ ያገባዪ በር ጡቁ፤ ኤማሚ ያትሜካ፤ የሑቲ ይረሕቦዪ ሰቦች ቀልኖ።<note caller="-" style="x"><char style="xo" closed="false">7፥14 </char><char style="xt" closed="false"><ref loc="JER 21:8">ኤር. 21፥8</ref>፤ <ref loc="DEU 30:19">ዘዳ. 30፥19</ref>። </char></note><verse eid="MAT 7:14" /></para>
  <para style="s1">ኧጨ በፍርየሑ ይትኴር</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6፥43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“የጤ ጎጋ ለበሶም ቲቸኖቡኩዪ፥ በውስጠሕኖም ይጠልፎዪ ተኩላ ተኸኖዪ ተባጢለተኘ ነብዮች ተቀሮ፤<note caller="-" style="x"><char style="xo" closed="false">7፥15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">ሕዝ. 22፥27</ref>። </char></note> <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />የሕኖም ቲሒሮዮ በሜናሕኖ ፍርየው። ብሶክ የወይን ፍርየ፥ በቈንጥር የበለስ ፍርየ ይለቅᎁ? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />ዛምኸም ፈያ ኧጨ እንም ፈያ ፍርየ ያወርድ፤ ውዶ ኧጨም ውዶ ፍርየ ያወርድ። <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ፈያ ኧጨ ውዶ ፍርየ ዋውርድ ኤይችል፤ ውዶ ኧጨም ፈያ ፍርየ ዋውርድ ኤይችል። <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />ፈያ ፍርየ ኤያወርድ ኧጨ እንም፥ ቅᎀጠሊም ተኧሳቴ ይዀሬ።<note caller="-" style="x"><char style="xo" closed="false">7፥19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">ማቴ. 3፥10</ref>፤ <ref loc="LUK 3:9">ሉቃ. 3፥9</ref>፤ <ref loc="MAT 12:33">ማቴ. 12፥33</ref>። </char></note> <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />ስለኸነም፥ ባጢለተኞች ነብዮች በሜናሕኖ ፍርየ ቲሕሮዮ። <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" />‘ጔታ! ጔታ!’ ይብሬ እንም ተመግሥተ ሰሜ ኤገባ፤ ተመግሥተ ሰሜዬ ይገባዪ በሰሜ ያነዪ የአባኛ ፈአድ ይፌጥሚው። <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />በፍርድ ከነ ብዠሕኖ፥ ‘ጔታ! ጔታ! በሽማኸ ትምቢት አንዘጔነ? በሽማኸ አጋንቲ አናውጣነ? በሽማኸ ብዠ ታምር አንሰከትነ?’ ይብሮኝ። <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />እያም በዛ ከነ፥ ‘ስርም አንሒርሑ፤ አሑ ቡሼ ትሸክቶ ቲያ ተዛዬ ፍኮ!’ ኧብር።<note caller="-" style="x"><char style="xo" closed="false">7፥23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">መዝ. 6፥8</ref>። </char></note><verse eid="MAT 7:23" /></para>
  <para style="s1">ባለት ወይ ባሸዋ ያረሺ ቤት</para>
  <para style="r">(<ref loc="LUK 6:47-49">ሉቃ. 6፥47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“ዚ ቃለኛ ሰማም በሜና ᎈር ያወሊ እንም፥ ቤተሑ ብምን ᎈር የሸከተ ብላተኘ ሰብ ይመስር። <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />ዝናብ ዘነበ፥ ጎርፊም ወረደ፥ ኧንፋሲም ነፈሰ ዛም ቤት ገፏን፤ የሕን አንኸንም፥ ቤቲ ብምን መሠረት ᎈር የሸከተ ስለኸነ አወጠቀ። <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />ዚም ቃለኛ ሰማም በሜና ᎈር ኤያወል፥ ቤተሑ በአሸዋ ᎈር የሸከተ ገዋ ሰብ ይመስር። <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />ዝናብ ዘነበ፥ ጎርፊም ወረደ፥ ኧንፋሲም ነፈሰ ዛ ቤት ገፏን፤ ቤቲም ሒንጌ ወጠቀ፤ ወውጥቀሑ ወደል ኸነ።”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />ኢየሱስ ነዚ ዘንጋ ዝነጔም በፈጀ ግዝየ ሕዝቢ በትምርተሑ ተዴነቆም። <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />የዴነቆዪም ሑቲ የሙሴ ሕጊ አስተማሪኸም ቴይኸን፥ የባለሥልጣንኸም ያትመሮ የነበረ ስለኸነው።<note caller="-" style="x"><char style="xo" closed="false">7፥28-29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">ማር. 1፥22</ref>፤ <ref loc="LUK 4:32">ሉቃ. 4፥32</ref>፤ <ref loc="MRK 1:22">ማር. 1፥22</ref>፤ <ref loc="LUK 4:32">ሉቃ. 4፥32</ref>። </char></note><verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">ኢየሱስ የለምጣሚ ሰብ ዋንጣሑ</para>
  <para style="r">(<ref loc="MRK 1:40-45">ማር. 1፥40-45</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5፥12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />ኢየሱስ በቈቶዪ በወረደ ግዝየ፥ ብዠ ሰቦች ተዄተሎይ። <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />በዚ ግዝየ አት በለምጥ<note caller="+" style="f"><char style="fr" closed="false">8፥2 </char><char style="fqa" closed="false">ለምጥ፦ </char><char style="ft" closed="false">የመጽሐፍ ቅዱስ ኸም አገላለጥ በገግ ᎈር ይታዥ በትልያየ ኸማት የጎጋ ባሸ እንም ያምለክት። </char></note> የታቌ ሰብ ቸኘም የኢየሱስ ሰጐደነም “ጔታ! ፈአዳኸ ቢኸን ፈያ ትሸክቴዬ ትችል” ባረ።<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ኢየሱስም ኧጀሑ ዝረጋም ድቧᎄሰንም “ፌቀደክንከም፤ ንጣ!” ቧረን። ለምጣሚም ሒንጌም ነጣ። <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />በዛም አንቌ ኢየሱስ፥ ተለምጠሑ የተረፈዪ ሰብ እኪ ቧረን፤ “ዚ ዘንጋ የሟንም አትዘንግ፤ ቢኸንም ወርም ወትርፋኸ የካሕን አተዥ፤ ምስክር ይኸንቦዬ፥ ስለ ወትርፋኸ ሙሴ ዬዘዘኒ መባ የእዝጌር አቅርብ” ቧረን።<verse eid="MAT 8:4" /></para>
  <para style="s1">የመቶ አለአዪ እምነት</para>
  <para style="r">(<ref loc="LUK 7:1-10">ሉቃ. 7፥1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />ኢየሱስ ተቅፍርናሖም ከተማዬ በገባ ግዝየ፥ አት የሮማዊ ገኝ የመቶ አለአ ተሑቲዬ ቀረበም ጮቈሰን፥ <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“ጔታ!፥ አገልጋየኛ ጅረ ኸነም፥ ስርም በወስቃይ በቤት ተገደረም” ቧረን። <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />ኢየሱስም “እያ ቸኘሑም ፈያ ኧሸኩች” ቧረን። <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />የመቶ አለአዪ እኪ ቲብር ዠᎄረነ፦ “ጔታ! አኸ ተቤተኛዬ ትገባኸም እያ የትጌባሑ ሰብ አንከንኩ፤ ቢኸንም አት ቃል ጠለለ ዘንግ፤ አገልጋየኛም ፈያ ይኸን። <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />እያ ነብሰኛ የባለስልጣኖች ታዛዥ ስለኸንኩ፥ ቲያ ተት ኤዝዞ ወታደሮች ነኖኝ፤ ተሕኖ አቲም ‘ወር!’ ትንቡን ያር፤ እንጐዲ ‘ኔኸ!’ ትንቡን ይቸኝ፤ አገልጋየኛም ‘ዚ ሰክት!’ ትንቡን ይሸክት።”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />ኢየሱስ ዚ በሰማ ግዝየ ተዴነቀ፤ ይትዄተሎይ የነበሮዪ ሰቦች እኪ ባረኖ፤ “የኢን ኧብርሑ፤ ዚ ቅጫ ወደል እምነት ያነን አትም ሰብ በእስራኤል አረኸብኩ። <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />ኧብርሑ፤ ብዠሕኖ ተምስራቅ ተምዕራብም ይቸኖ፤ በመንግሥተ ሰሜ ማዳ ዙሪያ ተአብርሐም፤ ተይስሐቅም ተያዕቆብጌ ይቾኖ፤<note caller="-" style="x"><char style="xo" closed="false">8፥11 </char><char style="xt" closed="false"><ref loc="MAT 13:29">13፥29</ref>። </char></note> <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />የዚ መንግሥት ይወርሶዪ ወሕን ይትጌባኖ የነበሮዪም ሰብ በውጪ ታነ ጨለማዬ ያድጉዮ። በዛም አልፋታ ስን ዋቅጫቅጭም ይኸን።”<note caller="-" style="x"><char style="xo" closed="false">8፥12 </char><char style="xt" closed="false"><ref loc="MAT 8:12">8፥12</ref>፤ <ref loc="ISA 49:12">ኢሳ. 49፥12</ref>፤ <ref loc="ISA 59:19">59፥19</ref>፤ <ref loc="MAL 1:11">ሚል. 1፥11</ref>፤ <ref loc="PSA 107:3">መዝ. 107፥3</ref>፤ <ref loc="MAT 22:13">ማቴ. 22፥13</ref>፤ <ref loc="MAT 25:30">25፥30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፥28</ref>። </char></note> <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />ተዛ አንቌ፥ ኢየሱስ የመቶ አለአዪ “ወር፤ የእምነታኸኸም የሕንከ” ቧረን። አገልጋዪም በዛ ሰዓት ፈያ ኸነ።<verse eid="MAT 8:13" /></para>
  <para style="s1">ኢየሱስ ብዠ የታቆ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1፥29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፥38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />በዛ ኢየሱስ ተጴጥሮስ ቤቴ በገባ ግዝየ የጴጥሮስ ዐማተሑ በፉላ ባሸ ታቌችም የገደረችኸም አዠ። <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />ኧጄታንም በድባበሰ ግዝየ፥ ሒንጌም ፉላዪ ገፈረናም ፈያ ኸነች፤ ተነሳችም የኢየሱስም ታግለጉል ቀረሰች። <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />በመሸ ግዝየ ሰቦች በአጋንት የጠበጦ ብዠ የታቆ ተኢየሱሴ አቸኖ፤ ሑቲም በቃለሑ ሩክሲ መናፍስት አትዌጣ፤ የታቆዪም እንም ፈያ ሸከተ። <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />በዚም ኢሳያስ እኪ ባረም የዝነጔኒ ትምቢት ተፌጠመ፤ “ሑቲ ኧቂናና ተቌበረ፤ ባሸናም ጮረ።”<verse eid="MAT 8:17" /></para>
  <para style="s1">የኢየሱስ ይትዄተሎዪ ይሰላቦ ምካት</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9፥57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />ኢየሱስ ብዠ ሰቦች በዙራሑ ተስበሰቦም ባዠ ግዝየ ተባሬ ዛዘር ይጔኖኸም ኤዘዘኖ። <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />በዚ አንቌ አት የሕጊ አስተማሪ፥ ተኢየሱሴ ቸኘም፥ “አስተማሪ፥ ትታርወ ኤማዬ እንም ንከተልኸ” ቧረን። <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />ኢየሱስም “የጐረግየ ጐጀ ነነኖ፤ በሰሜ ይበሮዪ አንፉዎችም ይነብሮᎄ ቤት ነነኖ፤ የሰብ ትኸ ነብሰሑ ያትᎈኝወ መደር ኤነን” ቲብር ዠᎄረነ። <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />ተደቀ መዛሙርተሑም አቲ “ጔታ! በደርኩም ንወርም አባኛ ኧቀቡርኸም<note caller="+" style="f"><char style="fr" closed="false">8፥21 </char><char style="fqa" closed="false">ኧቀብርኸም፦ </char><char style="ft" closed="false">አᎄች ይᎀት ስን ጮረም የወቅብር ያነኒ ወሴ ያምለክት ይመስር። </char></note> ፍቅድኒ” ቧረን። <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />ኢየሱስም “አኸ ይያ ተኸተሌ፤ ሟቾቺም ሟቸሕኖ ይቀብሮዮኸም ግፍኖ” ቧረን።<verse eid="MAT 8:22" /></para>
  <para style="s1">ኢየሱስ ማዕበሊ ጭጭ ያᎄኘንኸም</para>
  <para style="r">(<ref loc="MRK 4:35-41">ማር. 4፥35-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፥22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ኢየሱስም ተጀልባዬ ቲገባ፥ ደቀ መዛሙርተሑ ተዄተሎይ። <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />ወደል እንቡልቡሊት በባሪ ᎈር ስለትነሣ ማዕበሊ የጀልባዪ ያሰሙጬ ሰላ፤ ኢየሱስም ተገደረም ባነ። <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />ደቀ መዛሙርተሑም ተኢየሱሴ ቀረቦም፥ “ጔታ! አልቅነዬው፤ አትርፈነ!” ባሮም ነሶይ።<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ሑቲም “አሑ እምነት የቀበለናሑ! የመአር ትጌኖ?” ባረኖ። በዛም አንቌ ኢየሱስ ተነሣም ኧንፋሲ ባሪም ጔሠጠን፤ ወደል ጭጭታ ኸነ። <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />ሰቦቺም ተዴነቆም፥ “ኧንፋሲ ባሪም ይታዘዞነ ዚ ምንኸም ያነ ሰቡ?” ባሮ።<verse eid="MAT 8:27" /></para>
  <para style="s1">ኢየሱስ በአጋንት የጠበጦ ዄት ሰብ ፈያ የሸከተኸም</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5፥1-20</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፥26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />ባሪ ተጔናም ጌርጌሶን ቲቡሪ ገኜ የሰላኸም፤ አጋንት የጠበጦዮ ዄት ሰብ ቢነብሮᎄ የቀብር መደር ወጦም ተራከቦይ። በዛም ኤማ ሰብ ወተለፍ ኤይችል ስን ስርም ኸርደዶች ባኖ። <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />ሕኖም “አኸ የእዝጌር ትኸ፥ አኸ ቲናጌ ምን ወባጀ ነነናኸ? ግዝየሑ ቴይሰላ ታስቃይነዬ ቸኘኸም?” ቲብሮ ው ባሮ።<note caller="-" style="x"><char style="xo" closed="false">8፥29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">መሳ. 11፥12</ref>፤ <ref loc="2SA 16:10">2 ሳሙ. 16፥10</ref>። </char></note> <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />ተሕኖ ቀል ሽቅ በባረ መደር የብዠ ዐሣሳማ ወጀ ዋልዮም ባነ። <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />አጋንቲም የኢየሱስ፤ “ታወጣነዬሽ በኸነ፥ ታውሽ ተዛዬ ተዐሣማዎቺ ወጀዬ ስድነ!” ቲብሮ ጮቀሶይ። <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />ኢየሱስም “ወሮ!” ባረኖ። ስለኸነም ተሰቦቺ ወጦም ተዐሣማዬ ወሮም ቡሮቦ። ዐሣማዪም እንም ተገደሊ ᎀረ ተንድረደሮም ወረዶም በባሪ ውስጥ ቡሮም ᎀቶ። <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />የዐሣማዪም ወጅመኘ ሰኮም ቡሮም እንም ዘንጋ ኤወዶ፤ አጋንት የጠበጠኖ ሰቦች የኸነዪ ዘንጋ ኤወዶ። <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />በዚ አንቌ የከተማዪ ሰቦች እንም የኢየሱስ የወዥ ቸኖ፤ ባዞይም ግዝየ ገኘሕኖ ገፈረኖም ያርኖኸም ጮቀሶይ።<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">ኢየሱስ ጅረዪ ሰብ ፈያ የሸከተኸም</para>
  <para style="r">(<ref loc="MRK 2:1-12">ማር. 2፥1-12</ref>፤ <ref loc="LUK 5:17-26">ሉቃ. 5፥17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />በዛ አንቌ ኢየሱስ በጀልባ ተሳፈረም በባሪ ተጔናም ተነብሰሑ ከተማዬ ቸኘ። <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />በዛም ሰቦች አት ጅረ ሰብ በቃሬዛ ጮሮም ተሑቲዬ አቸኖ። ኢየሱስም እምነተሕኖ አዠም የጅረዪ፤ “ትኸኛ አይዞአኸ፤ አጢያታኸ ተሴረዘንከም” ቧረን። <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />በዛ ግዝየ አታት የሙሴ ሕጊ አስተማሪ፥ “ዚ ሰብ በእዝጌር ᎈር የስድብ ቃል ይዝነግ!” ቲብሮ በሒነሕኖ ኤሰቦ። <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />ኢየሱስም አሳበሕኖ ሐረም እኪ ባረኖ፦ “የመአር ዚ ቡሼ ቃር በሒናሑ ቴስቦ? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />ወሕነሑ ‘አጢያታኸ ተሴረዘንከም’ ተወበር ‘ተንሣም ወር!’ ተወበርም ኤተሑ ይጠቅል? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />ቢኸንም የሰብ ትኸ ባፈር ᎈር አጢያት የዋሰርዝ ሥልጣን ያነንኸም ቲሕሮዬ” የጅረዪ ሰብ “ተንሣ አልጋኻም ጮርማኸ ተቤታኸዬ ወር” ቧረን። <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />ምሲም ተነሣም ተቤተዄ ወረ። <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />ሕዝቢም ዚ ባዞ ግዝየ ተጌረሞ፤ እኪ ያነዪም ሥልጣን የሰብ በዋበሑ የእዝጌር አምሰገኖ።<verse eid="MAT 9:8" /></para>
  <para style="s1">ኢየሱስ ማቴዎስ የቧሪዪ ሌዊ ወጥራሑ</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2፥13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፥27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />ኢየሱስ በዛ መደር ተነሣም ቲያር ትናነ ማቴዎስ የቧሪዪ ቀረጥመኘ ቀረጥ ቢቌᎄርᎄዪ መደር ቾናም አዠንም “ኔኸ ተኸተሌ!” ቧረን፤ ሑቲም ተነሣም ተዄተለን።<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />በዛም አንቌ ኢየሱስ በማቴዎስ ቤት በማዳ ይበራዬ ቾናም ትናነ ብዠ ቀረጥመኘ አጢያተኞችም፥ ተዛዬ ቸኖም ተሑቲጌ ተደቀ መዛሙርተሑጌ በማዳ ይበሮዬ ቶኖ። <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />ፈሪሳውያንም ዚ አዞም የደቀ መዛሙርተሑ “አስተማሪያሑ ተቀራጮች ተአጢያተኞችምጌ የመአር ቁናዪ ይበራ?” ባሮዮ።<note caller="-" style="x"><char style="xo" closed="false">9፥10-11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">15፥1-2</ref>። </char></note> <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />ኢየሱስም ዚ ሰማም እኪ ቲብር ዠበረኖ፦ “የታቆዪ አንኸንም ያንታቆዪ አኪም ኤያሸኖ። <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />ወሮ፤ ‘እያ ኧሸን ምረት አንኸንም መሥዋት አንከነ’ ቧሪም የጣፈዪ ምን ወበር የኸነኸም መርምሮማሑ አጥራምቶ። እያ የቸኘሑ የጻድቃን ቴይኸን የአጢያተኞቺ ተንስሐዬ የወጥራው” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">9፥13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሖሴ. 6፥6</ref>፤ <ref loc="MAT 12:7">ማቴ. 12፥7</ref>። </char></note><verse eid="MAT 9:13" /></para>
  <para style="s1">ስለጦም የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2፥18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፥33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />በዛ ግዝየ የዮሐንስ ደቀ መዛሙርት ተኢየሱሴ ቸኖም፥ “ኢና ፈሪሳውያንም እንጌ ኧጦምነ፤ ያኸ ደቀ መዛሙርትም የመአር ኤይጦሞ?” ቲብሮ ተሳሎይ። <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ሙሽራዪ ተሕኖጌ ትናነ ሙዜዪ ወዝን ይጌባኖ? ቢኸንም ሙሽራዪ ተሕኖ ይወሰድወ ግዝየ ይቸኝ፤ በዛ ግዝየ ይጦሞ። <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />በጉርዝ ልባስ ᎈር ገደር ጣᎈት ይጠፍ ሟንም ኤነ፤ ቢጠፉም ገደሪ ጣᎈት የጉርዚ ልባስ ነጨም ጉዲ የባሰ ያᎆችች። <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />ዛምኸም በገረዘ የኧጋ ወሸን ገደር የወይን ደጔ ያወና ሟንም ኤነ፤ ዚ ቢሸከት ወሸኒ ይሰቡን፤ የወይን ደጔዪም ይፈስ፤ ወሸኒም ተሰበረም ኤያድገልል። ቢኸንም ገደሪ የወይን ደጔ በገደሪ ወሸን ዋውና ይጌባ፤ በዚምኸማት፥ ዄቲም በፈያ ተቅሮም ይነብሮ።”<verse eid="MAT 9:17" /></para>
  <para style="s1">ስለኢያኢሮስ ትኸም የኢየሱስ ልባስ የለገደች ምሽት</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5፥21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፥40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />ኢየሱስ ዚ ቲይውዶ ትናነ፥ አት የምኩራብ አለአ ተሑቲዬ ቸኘ፤ በግንባረሑም በኢየሱስ ኢፍት ተደፋም፥ “ዘ፥ ትኸኛ ኧሗ ᎀተትቢ፤ ቢኸንም አኸ ቸኘኸም ኧጃኸ ብትጨንባ ትተርፍ” ቧረን። <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />ኢየሱስም ተነሣም የምሲ ተዄተለንም ወረ፤ ደቀ መዛሙርተሑም ቁናዬ ወሮ።<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />ዘ፥ ዐሥረ ዄት ዓመት ሙላ ደም ቲፈስሳ ትስቃይ የነበረች አት ምሽት በዛ ግዝየ ተኢየሱስ አንቌ አዘር ቸኘችም የልባሰሑ ጫፍ በጄታ ለገደች።<note caller="-" style="x"><char style="xo" closed="false">9፥20 </char><char style="xt" closed="false"><ref loc="NUM 15:38">ዘሑ. 15፥38</ref>፤ <ref loc="DEU 22:12">ዘዳ. 22፥12</ref>። </char></note> <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />ዚም የሸከተች “ልባሰሑ ጠለለ ብንለግድ ኧተርፍ” ባረችም በሒኔታ ኤሰበችም ባነ። <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />ኢየሱስም ዞር ባረም አዠናም “አይዞአሽ ትኸኛ!፤ እምነታሽ አተረፈናሽም” ባረና። ምሽቲም ሒንጌም ተረፈች።<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />ተዛ አንቌ ኢየሱስ ተምኩራብ አለአዪ ቤቴ በሰላ ግዝየ ያዘን አንዱር ይነፎዪ ቲትራወጦም ው በወበር ይበሖዪ ሰቦች አዠ። <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ሑቲም “ኧንማሑ በዚ ውጦ! ትኸዪ ተገደረችም አንኸንም አᎀተች!” ባረኖ። ሕኖም በወቀልድ ዳቆᎄ። <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />ሰቦቺም በወጦ አንቌ፥ ኢየሱስ ትኸዪ ያነትወ ክፍል ገባም ኧጄታን ጠበጠ፤ ሒቲም ተነሳች። <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />የዚም ዘንጋ ዝና በገኚ እንም ተሴማ።<verse eid="MAT 9:26" /></para>
  <para style="s1">ኢየሱስ ዄት ወዥ ኤይችሎዪ ያተረፈኸም</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />ኢየሱስ በዛ መደር ተነሳም ቲያር ዄት ወዥ ኤይችሎዪ ተዄተሎይ፤ ሕኖም “የዳዊት ትኸ! እንዴ ማረነ!” ባሮም ው ባሮ። <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />ኢየሱስ ተቤቴ በገባ ግዝየ ወዥ ኤይቺሎዪ ተሑቲዬ ቀረቦ፤ ሑቲም “እያ ወሰክት ኧችልኸም ታምኖ?” ባረኖ። ሕኖም “ኤክ፥ ጔታና!” ቲብሮ ዠበሮ።<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />በዛ አንቌ ኢየሱስ ዔነሕኖ በጀሑ ሙሻሸም፦ “የምነታሑኸም የሕንኩ!” ባረኖ። <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ዔነሕኖም አዠ፤ ኢየሱስም “ዚ ዘንጋ የሟንም አታውዶ!” ቲብር አጠበቀም ኤዘዘኖ። <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />ሕኖም ወሮም በዛ ገኝ እንም የኢየሱስ ዝና ዝነጎ።<verse eid="MAT 9:31" /></para>
  <para style="s1">ኢየሱስ አት ዱዳ ሰብ ፈያ ወሰክተሑ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />ዔነሕኖ የከፈተኖ ሰቦች ወጦም በወሮ ግዝየ እንጐድ ሰቦች ጋኔን ያነወዪ አት ዱዳ ሰብ ተኢየሱሴ አቸኖ። <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />ጋኔኒም ተሑቲ በወጣ ግዝየ ዱዳዪ ሰብ ዝነጔ፤ ሕዝቢም “የዚኸም ያነ ዘንጋ በእስራኤል ስርም ታዠም ኤይትከር!” ቲብሮ ተዴነቆ።<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />ፈሪሳውያንም “ሑቲ አጋንት ያትዌጣ በአጋንት አለአ መሳው” ባሮ።<note caller="-" style="x"><char style="xo" closed="false">9፥34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቴ. 10፥25</ref>፤ <ref loc="MAT 12:34">12፥34</ref>፤ <ref loc="MRK 3:22">ማር. 3፥22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፥15</ref>። </char></note><verse eid="MAT 9:34" /></para>
  <para style="s1">ኢየሱስ የሕዝቢ ወዝነሑ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />ኢየሱስ በምኩራበሕኖ ቲያትመር፥ የእዝጌር መንግሥት ወንጌል ቲሰብክ፥ የሕዝቢ ተባሸ ተቂናም እንም ፈያ ቲሸክት፥ በከተሞች በመንደሮችም እንም ይዥዋወር ባነ።<note caller="-" style="x"><char style="xo" closed="false">9፥35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቴ. 4፥23</ref>፤ <ref loc="MRK 1:39">ማር. 1፥39</ref>፤ <ref loc="LUK 4:44">ሉቃ. 4፥44</ref>። </char></note> <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />ሕዝቢ ወጅመኘ ዬነኖ ኧጤኸም ተጨነቆም፥ ዱቁቅ ባረቦም ባዠኖ ግዝየ አዘነኖ። <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />ስለኸነም የደቀ መዛሙርተሑ እኪ ባረኖ፦ “መኸሪ ብዠው፤ የመኸሪ ሜነተኞች ቀልኖ። <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ኧጔሽ ሜነተኘ ተመኸሪ ሜናዬ ይለክኸም ተመኸሪ ጔታዬ ጠልዮ።”<note caller="-" style="x"><char style="xo" closed="false">9፥37-38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ. 10፥2</ref>። </char></note><verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">ስላሥረዄቲ ሐዋርያት</para>
  <para style="r">(<ref loc="MRK 3:13-19">ማር. 3፥13-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፥12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ኢየሱስ የዐሥረ ዄቲ ደቀ መዝሙር ተሑቲዬ ጠራም፥ ሩክሲ መናፍስት ያወጦኸም፥ ባሸ ኧቂናም እንም ፈያ ይሸክቶኸም ስልጣን አበኖ። <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />የዐሥረ ዄቲ ሐዋርያት ሽም ቄጠለም ያነዪው፦ መጀመሪያ ጴጥሮስ የቧሪዪ ስምዖንም ጐቤች እንድርያስ፤ የዘብዴዎስ ትኸ ያዕቆብም ጐቤች ዮሐንስ፤ <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ፊልጶስ በርቶሎሜዎስ፤ ቶማስም ሰብሳቢዪ ማቴዎስ፤ የእልፍዮስ ትኸ ያዕቆብ ታዴዎስ የቧሪዪ ልብድዮስም፤ <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />ይቀናዪ<note caller="+" style="f"><char style="fr" closed="false">10፥4 </char><char style="fk" closed="false">ይቀናዪ፦ </char><char style="ft" closed="false">ቀነናዊ ይብሪ ቃል አራማይክ ቲኸን፣ ቀነናውያን የቧርዮዪ በዛ ግዝየ የሮም መንግሥት ይቃወሞ የፎለቲካ ቡድን አባላት ባኖ</char></note> ስምዖን ባንቌ የኢየሱስ አቸለፈም ያᎄን አስቆሮቱ ይሑዳ። ስምዖን ባንቌ የኢየሱስ አቸለፈም ያᎄን የአስቆሮቱ<note caller="+" style="f"><char style="fr" closed="false">10፥4 </char><char style="fk" closed="false">የአስቆሮቱ፦ </char><char style="ft" closed="false">በዚ ቃል ᎈር ዄት አስትያት ነኖ። አቲ አስትያት፥ ተመደር (ተገኝ ጌ) ቲያጥባቡጭ፤ ዄታለኘዪ አስትያት፥ ኧሗም የይሑዳ ባጢለተኘ፥ አብላላጭ ባረም የወስድብ ያᎅ ቅጥያው ሽሙ ይብር። </char></note> ይሑዳ።<verse eid="MAT 10:4" /></para>
  <para style="s1">ዐሥረዄቲ ሐዋርያት የዋትመር የትላሖኸም</para>
  <para style="r">(<ref loc="MRK 6:7-13">ማር. 6፥7-13</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፥1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ነዚ ዐሥረ ዄቲ ሐዋርያት ላኸኖ፤ ኢየሱስ እኪ ቲብር ትዛዝጌ ላኸኖ፤ “ተአሕዛቤ አትወሮ፤ ተሰማርያ ከተማዬ አትግቦ። <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />ይጠቅሊሽ የጤኸም ተጠፎዪ ተእስራኤል ሕዝቤ ወሮ። <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />ወሮማሑ ‘መንግሥተ ሰሜ ቀረበም!’ ትትብሮ ስበኮ።<note caller="-" style="x"><char style="xo" closed="false">10፥7-15 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10፥4-12</ref>። </char></note> <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />የታቆዪ ፈያ ሰክቶ፤ ሟቾቺ ንሶ፤ ለምጣሞቺ አንጦ፤ አጋንት አውጦ፤ በጠለለ የቌበርኩዪ በጠለለ አቦ። <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />ወርቅ ወይ ብር ወይ ናስ በኪሳሑ አትጥብጦ። <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />የሜነተኘ ይጌቧኒ ስንቅ ያሸን ስለኸነ ዬማሑ ኸረጪት፥ ትርፍ ልባስ፥ ትርፍ ጫማ፥ ኧንጣርም አትጥብጦ።<note caller="-" style="x"><char style="xo" closed="false">10፥10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9፥14</ref>፤ <ref loc="1TI 5:18">1 ጢሞ. 5፥18</ref>። </char></note> <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />ብትገቦᎄዪ ከተማ ወይ መንደር፥ ይጌቧን ሰብ ሟ የኸነኸም መርምሮ፤ ዛም መደር ገፈርኩም ትወጦ ስን ተሑቲጌ አክሶ። <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />ተሰብ ቤቴ ትትገቦ ሰላምታ አቦ፤ <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />ቤቲ የሰላማሑ ይቌበርኩ በኸነ ሰላማሑ የስላን፤ ኤይቌበርኩ በኸነ ሰላማሑም የዘብርንኩ። <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />ሟንም ሰብ ኤይቌበርኩ ወይ ቃላሑ ኤይሰማ ቢኸን ዛ ቤት ወይ ከተማ ገፈርኩይም ትትወጦ የግራሑ ቲባ አራግፎ።<note caller="-" style="x"><char style="xo" closed="false">10፥14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ሐዋ. 13፥51</ref>። </char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />የኢን ኧብርሑ፤ በፍርድ ከነ ተዛ ከተማ ቢሰላዪ ቅጣት የጠቀለ በሰዶም በገሞራ ይሰላዪ ይቀል።<note caller="-" style="x"><char style="xo" closed="false">10፥15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቴ. 11፥24</ref>፤ <ref loc="GEN 19:24-28">ዘፍ. 19፥24-28</ref>። </char></note><verse eid="MAT 10:15" /></para>
  <para style="s1">ጔታ ተወተኘሑ ኢፍቴ ስደት መከራም ይኸንኸም</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፥3-13</ref>፤ <ref loc="LUK 21:12-17">ሉቃ. 21፥12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“ዘ! የጤኸም በተኩላ ግብት ኧለክሑ፤ ስለኸነም የእንድወደረኸም አዩ ሕኖ፥ የቡላልኸም ደነ-ሜና ሕኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10፥3</ref>። </char></note> <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />ሰብ ተፍርድ ጀᎈሬ አቸለፎም ይቦኩ፤ በምኩራበሕኖም ይገርፎኩ፤ ስለኸነም ተሰቦች ተቀሮ።<note caller="-" style="x"><char style="xo" closed="false">10፥17-20 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13፥9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12፥11-12</ref>፤ <ref loc="LUK 21:12-15">21፥12-15</ref>። </char></note> <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />ቢያ መሳ፥ ቲገዞዪም ተነገሥታቴ የፍርድ ይወስዶኩ ስለኸነ በሕኖም በአሕዛብ ኢፍት ምስክረኛ ትኸኖ፤ <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />ሰብ ተፍርድ ጀᎈሬ ቲያቀርቦኩ ትዝነጎይ ቃር በዛ ሰዓት ይብኩ ስለኸነ፥ ‘ምንኸም ምን ኧዝነግነ?’ ባሑም በዋስብ አትጨነቆ። <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />ባሑ ውስጥ ቡየም ይዝነግ የሰሜዪ አባሑ መንፈሱ አንኸንም አሑ አንከንኩ።<note caller="-" style="x"><char style="xo" closed="false">10፥20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13፥12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21፥16</ref>። </char></note> <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />ሰብ የፎለሑ ጐቤ የሞት አቸለፈም ይብ። ዛምኸም አባ የፎለሑ ትኸሑ የሞት አቼለፈም ይብ፤ ዴንጋም በወላጀሕኖ ᎈር በመሶነት ይትነሦ፤ የሞትም አቸለፎም ይቦዮ። <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />ቢያ መሳ በሰብ እንምሜ የጠላሑ ትኸኖ፤ ቢኸንም መጨረሻ ስን ቆመረም ይቌም ይተርፍ።<note caller="-" style="x"><char style="xo" closed="false">10፥22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቴ. 24፥9</ref>፤ <ref loc="MAT 13">13</ref>፤ <ref loc="MRK 13:13">ማር. 13፥13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21፥17</ref>። </char></note> <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />ባት ከተማ መከራ ቲያበዞቡኩ ትንጐዴ ስኮ፤ የኢን ኧብርሑ የሰብ ትኸ<note caller="+" style="f"><char style="fr" closed="false">10፥23 </char><char style="fqa" closed="false">የሰብ ትኸ </char><char style="ft" closed="false">ኢየሱስ ክርስቶስ ወበሩ። </char></note> ተዠበረም ይቸኝ ስን የእስራኤል ከተማ እንም አታሳሎይ። <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" />ተማሪ ታስተማሪዪ ኤይበዛ፤ አገልጋዪም ተጌቶቸሑ ኤይበዛ።<note caller="-" style="x"><char style="xo" closed="false">10፥24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6፥40</ref>፤ <ref loc="JHN 13:16">ዮሐ. 13፥16</ref>፤ <ref loc="JHN 15:20">15፥20</ref>። </char></note> <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />ደቀ መዝሙር ታስተማሪዪ፤ አገልጋዪም ጌቶቸሑ በመሰረ ይበቋን። ባለቤተሑ ‘ብዔልዜቡል’ በባሮይ አበሮሰውታንማ ምንከም አበዞም ኤይብሮዮ፤<note caller="-" style="x"><char style="xo" closed="false">10፥25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቴ. 9፥34</ref>፤ <ref loc="MAT 12:24">12፥24</ref>፤ <ref loc="MRK 3:2">ማር. 3፥2</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፥15</ref>። </char></note><verse eid="MAT 10:25" /></para>
  <para style="s1">የሟ ወገና ይጌባኸም</para>
  <para style="r">(<ref loc="LUK 12:4-7">ሉቃ. 12፥4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“ኧጌሽ የሰቦች አትገኖ፤ የሼፈነ ወታዠሑ ኤይቀይ፤ የሼተረ ወትኴረሑ ኤይቀይ።<note caller="-" style="x"><char style="xo" closed="false">10፥26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4፥22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8፥17</ref>። </char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />ስለኸነም እያ በጨለማ ኢውድሑዪ፥ አሑ በብራን ዘጎይ፤ በመቈ የሰማሑዪም ከፍ በባረ መደር ᎈር ቸኘሑም ቢልብጢጦ አውጆይ። <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ያሑ በሠር ተወቅጥር ተቸለፎም ነብስያ ወቅጥር ኤይችሎዪ ሰቦች አትገኖ፤ ይልቅሽ ነብስያ በሰርም በፍርድ ኧሳት ያጠፋዬ ይችሊም አምላካሑ ገኖ። <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />ዄት አንፉ ባምስት ፈረንክ ያስረዮ አንከን? የሕን አንኸንም፥ የሰሜ አባሑ ቴፈቅድ አቲም አንፉ በአፈር ᎈር ኤይወጥቅ። <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />የአሑም የጉነናሑ ጉነን ቴይቀይ የትቆጠረው። <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />ቢኸንም አሑ ተብዠ አንፉ በብዠ ትበዞ ስለኸነ ስርም አትገኖ።<verse eid="MAT 10:31" /></para>
  <para style="s1">የክርስቶስ ወመስክር ይጌባነ ወሕነሑ</para>
  <para style="r">(<ref loc="LUK 12:8-9">ሉቃ. 12፥8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“በሰብ ኢፍት ይምሰክርኒ እንም፥ እያም በሰሜ ባነዪ አባኛ ኢፍቴ ኧምሰኩርነ። <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />በሰብ ኢፍት ይለጌ እንም እያም በሰሜ አባኛ ኢፍቴ ኧለጓን።<note caller="-" style="x"><char style="xo" closed="false">10፥33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጢሞ. 2፥12</ref>። </char></note> <verse eid="MAT 10:33" /><verse number="34" style="v" sid="MAT 10:34" />እያ የቸኘሑ፥ ሰላም በአፈር ᎈር የዋተኝ ኤይምስርኩ፤ እያ አርብ አንኸንም ሰላም የዋተኝ አንተኘሑ። <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />እያ የቸኘሑ፥ ኧርጅ ባᎄች ᎈር፥ ገረድ በዳኴታ ᎈር፥ መራቴታም በአማቴታ ᎈር፥ በመሶነት የዋትነሣው። <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />ስለኸነም የሰብ መሶዎቸሑ የፎለሑ አበሮሰሑ ይኸኖ።<note caller="-" style="x"><char style="xo" closed="false">10፥35-36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7፥6</ref>። </char></note> <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />ቲያ ይጠቅል አᎄችም፥ ዳኴችም ይወድ፥ ይያ ይኸኔ ኤይጌቧን፤ ቲያ ይጠቅል ኧርጀሑ፥ ገረደሑ ይወድ፥ ይያ ይኸኔ ኤይጌቧን። <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />የፎለሑ መስቀል ጮረም ኤይትዄተሌ ሰብ ይያ ይኸኔ ኤይጌቧን።<note caller="-" style="x"><char style="xo" closed="false">10፥38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቴ. 16፥24</ref>፤ <ref loc="MRK 8:34">ማር. 8፥34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9፥23</ref>። </char></note> <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />ሕይወተሑ የዋትርፍ ይሸ እንም ያጠፏን፤ ሕይወተሑ ይያ ያጠፏን እንም ያተርፉ።<note caller="-" style="x"><char style="xo" closed="false">10፥39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቴ. 16፥25</ref>፤ <ref loc="MRK 8:35">ማር. 8፥35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፥24</ref>፤ <ref loc="LUK 17:33">17፥33</ref>፤ <ref loc="JHN 12:25">ዮሐ. 12፥25</ref>። </char></note> <verse eid="MAT 10:39" /><verse number="40" style="v" sid="MAT 10:40" />ያሑ ይቌበር ይያ ይቌበር፤ ይያ ይቌበር የላሔዪ አባኛ ይቌበር።<note caller="-" style="x"><char style="xo" closed="false">10፥40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">ማር. 9፥37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፥48</ref>፤ <ref loc="LUK 10:16">10፥16</ref>፤ <ref loc="JHN 13:20">ዮሐ. 13፥20</ref>። </char></note> <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />ነብይ በነብይ ሽም ይቌበር የነብዪ ጄዛ ይረሕብ፤ ጻድቅም በጻድቅ ሽም ይቌበር የጻድቅ ጄዛ ይረሕብ። <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />የኢን ኧብርሑ፤ ይያ ደቀ መዝሙር በወሕነሑ፥ ተዚ ቅስስኖቺ ያቲ ቁና ብርጭቆ ቀዝቃዛ ኧጋ ይብ ሰብ ጄዛሑ ኤይቀብጥ።”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">በመጥምቂ ዮሐንስ ተኢየሱሴ የትላሖ መላክተኞች</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7፥18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />ኢየሱስ ነዚ ትዛዝ የዐሥረዄቲ ደቀ መዛሙርት ባበ አንቌ ዛ መደር ገፈረም በቁርቤ ቲትረከቦᎄዪ ከተማዬ ይሰብኬ ያትመሬም ወረ።<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />ዮሐንስ በወሕኔ ቤት ትናነ፥ የክርስቶስ ሜና በወሰማሑ ዄት ደቀ መዝሙር ላኸም፥ <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“ዛ ይቸኝ የቧሪዪ መሲሕ አኸት ንከ? ወይሽ ኧንጐድ ንቀየነ?” ባሮም የኢየሱስ ይሰሎይኸም ሸከተ። <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ወሮ፥ ያዠሑዪም የሰማሑዪ እንም የዮሐንስ አውዶይ። <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ዘ፥ ወዥ ኤይችሎዪ ያዞ፤ ሸንካሎች ብዝ ባሮም ያሮ፤ ለምጣሞች ፈያ ይኸኖ፤ ጠንቋራም ይሰሞ፤ የᎀቶ ይትነሦ፤ የዜጋም ወንጌል ይሰቡኲ፤<note caller="-" style="x"><char style="xo" closed="false">11፥5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35፥5-6</ref>፤ <ref loc="ISA 61:1">61፥1</ref>። </char></note> <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />ስለእያ ኤጥራጠር የትባረከው።”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />የዮሐንስ መልክተኞች በወሮ አንቌ፥ ኢየሱስ ስለዮሐንስ እኪ ቲብር ወዘንግ ቀረሰ፤ “ወሕነሑ ምን ታዞዬ ተበረሐዬ ወጣሑ? ብፋስ ይንቅለቅሊ ሸምበቆ የወዡ? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />ኧሗም ምን የወዥ ወጣሑም? ይደንቅ ልባስ የለበሰዪ ሰብ የወዡ? ይደንቅ ልባስ ይለብሶዪማ በነገሥታት ቤት ይትረከቦ። <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />ኧጌ፥ የመአር ወጣሑም? ነብይ የወዡ? ኤክ፥ ዛምኸም ተነብይ ስርም ይበዛዪ የወዡ ኧብርሑ። <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ሑቲ ‘ዘ፥ ኢፍት ኢፍታኸ ቲያር፥ ኤማኸ ያዝጋጅ መልክተኛኛ ባኸ ኢፍት ኧለሕ’ ቧሪም የጣᎈነኸሙ።<note caller="-" style="x"><char style="xo" closed="false">11፥10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፥1</ref>። </char></note> <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />የኢን ኧብርሑ፤ እንሽታ ተጨነማዮዪ ሰቦች ግብት ተመጥምቂ ዮሐንስ ይበዛ አንተሣ። ቢኸንም በመንግሥተ ሰሜ ትንም ያንሲ ይᎄዛን። <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />ተመጥምቂ ዮሐንስ ዘበን ቀረሰም ኧኳ ስን የመንግሥተ ሰሜ ስርም ይገፋ<note caller="+" style="f"><char style="fr" closed="false">11፥12 </char><char style="fqa" closed="false">ይትገፋ፦ </char><char style="ft" closed="false">ወገፋ፥ ወጋደልም ያምለክቶዪ የቡሼ ቆት ተቃውሞ ፈተናዪ የወተለፍ መንፈሳውያን ጐሣ ይሸክቶዪ መንፈሳዊ ግጅላው። </char></note> ብረቶም ይጋደሎዪ ይረሕቦይ።<verse eid="MAT 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 11:13" />“እንም የነብዮች ትምርት፥ በሙሴ ኧጅ ያᎅዪ ሕግም የመጥምቂ ዮሐንስ ስን ትምቢት ዝነጎም።<note caller="-" style="x"><char style="xo" closed="false">11፥12-13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16፥16</ref>። </char></note> <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ኧጌሽ፥ ሕኖ የዝነጎዪ የወቀበር በፈቀድኩ ዛ ይቸኝ የቧሪዪ ኤልያስ ዘ፥ ዚ ዮሐንሱ።<note caller="-" style="x"><char style="xo" closed="false">11፥14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>፤ <ref loc="MAT 17:10-13">ማቴ. 17፥10-13</ref>፤ <ref loc="MRK 9:11-13">ማር. 9፥11-13</ref>። </char></note> <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />ይሰማ እንዝን ያነን የስማ!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“ቢኸንም የዚ ዘበን ሰብ በመአር አምሳስሮ? በጠባ ቾኖም መራርቻሕኖ ቲጠሮ፥ <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘አንዱር ነፋነንኩም አንደረስኩ! ያልፋታ ግጥም ገጠምነንኩ አምበኴሑ!’ ይብሮዪ ዴንጋ ይመስሮ። <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />ዛምኸም መጥምቂ ዮሐንስ በቸኘ ግዝየ ስንቅ ቴይበራ፥ የወይን ደጔ ቴይሰጭ ቢቸኝ፥ ‘ዚሽ ጋኔን ነነወ!’ ባሮይ፤ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />የሰብ ትኸ ኧሗም ቲበራ ቲሰጭም ቢቸኝ፥ ‘ዘ! ዚ ወብራ፥ ወስጤም ይወዲው! የቀራጮች፥ የአጢያተኞችም ደቦው!’ ባሮይ። ቢኸንም የብላት ሱት በሜናውታ ይትዄር።”<verse eid="MAT 11:19" /></para>
  <para style="s1">ባለወምነሕኖ የወቈሽዮ ከተማ</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ. 10፥13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />ቄጠለም ኢየሱስ ትንጐድ ከተሞች የበዛ ብዠ ታምር የሸከተቦዪ ከተሞች፥ ንስሐ ስላንገቦ እኪ ቲብር ወቀሰኖ፦ <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“ወዮ አኸ ኮራዚን፤ ወዮ አኸ ቤተ ሳይዳ፤ ባሑ የሸከቶ ታምር በጢሮስ በሲዶናም ተሸከተም ቢኸንማ፤ ገና ድረ ማቅ ለበሶም፤ ዐመድ ንሰነሶም ንስሐ በገቦ ባነ።<note caller="-" style="x"><char style="xo" closed="false">11፥21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23፥1-18</ref>፤ <ref loc="EZK 26:1-28:26">ሕዝ. 26፥1—28፥26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3፥4-8</ref>። </char></note> <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />ስለኸነም በፍርድ ከነ፥ ታሑ ይጠቅል በጢሮስም በሲዶና ይነብሮዪ ቅጣተሑ ይቄንስኖ ኧብርሑ። <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />አኸም ሰሜ ስን ከፍ የባኸ ቅፍርናሖም! ተሲኦሌ ትወርድ! ባኸ የሸከቶዪ ታምራት፥ በሰዶም ተሸከቶም ቢኸን ዛ ከተማ ቴይጠፋ፥ ኧኳ ስን በነበረ ባነ!<note caller="-" style="x"><char style="xo" closed="false">11፥23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14፥13-15</ref>፤ <ref loc="GEN 19:24-28">ዘፍ. 19፥24-28</ref>። </char></note> <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />ስለኸነም ኧብርኸ፤ በፍርድ ከነ ታኸ የጠቀለ ቅጣተሑ የሰዶም ይቈልነ!” <note caller="-" style="x"><char style="xo" closed="false">11፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቴ. 10፥15</ref>፤ <ref loc="LUK 10:12">ሉቃ. 10፥12</ref>። </char></note><verse eid="MAT 11:24" /></para>
  <para style="s1">በክርስቶስ ዋᎉ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10፥21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />በዛ ግዝየ ኢየሱስ እኪ ባረ፦ “የሰሜ ያፈሪም ጔታ አባ! ዚ ዘንጋ ተብላተኞች ተዐዋቂዎችም ሼምከም ኤይሒሮዪ የገለጥከኖ ስለኸነ አምሰግንከ፤ <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />ኤክ! አባ! ዚ የወሰክት ያኸ ፈያ ፈአድ ኸነም። <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />አባኛ እንም ቃር አቤም፤ ተአብ አንኸንም ወልድ ይሒን ሟንም ኤነ። ዛምኸም ተወልድ አንከንም አብ ይሒን ኤነ፤ ሟንም ወልድ ባናተዠን አንኸንም የአብ ይሒሬ ኤይችል።<note caller="-" style="x"><char style="xo" closed="false">11፥27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዮሐ. 3፥35</ref>፤ <ref loc="JHN 1:18">1፥18</ref>፤ <ref loc="JHN 10:5">10፥5</ref>። </char></note><verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“አሑ የቌጥኩ ጡዋራ የራዘናሑ እንም ቲያዬ ኔሑ፤ እያም አትᎈኝሑ። <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />አንገችለኛ በᎈራሑ ጮሮ፤ ቢያም ተማሮ፤ እያ ደነ-ሜና ቁና ቀልብንኩ፤ የነብስያሑ ፎያት ትረሕቦ።<note caller="-" style="x"><char style="xo" closed="false">11፥29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6፥16</ref>። </char></note> <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />አንገችለኛ ኤቁረቁር፤ ጡዋራኛም ቀላሉ።”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">ሰምበት ዋክብር</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2፥23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፥1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />በዛ ግዝየ ኢየሱስ በሰምበት ከነ በስሬ ኧርሻ ግብት ይቸለፍ ባነ፤ ደቀ መዛሙርተሑ ጋደኖም ስለኸነ የስሬ ኧሴት ሜጠሶም በኖ፤<note caller="-" style="x"><char style="xo" closed="false">12፥1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ዘዳ. 23፥25</ref>። </char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />ፈሪሳውያን ዚ አዞም የኢየሱስም “ተመልከት! ደቀ መዛሙርታኸ በሰምበት ከነ ወሰከት ዬነወዪ ይሸክቶው!” ባሮይ። <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />ኢየሱስም እኪ ባረኖ፦ “ዳዊትም ተሑቲጌ ያኖዪ ሰቦች በጋደኖ ግዝየ ዳዊት የሸኰተኒ ስርም አናምበብኩ?<note caller="-" style="x"><char style="xo" closed="false">12፥3-4 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሙ. 21፥1-6</ref>። </char></note> <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />ሑቲ ተእዝጌር ቤቴ ገባም ተካሕናት አንኸንም ሑቲም ኸነ ተሑቲጌ ያኖዪ ሰቦች ይበሮዬ ያንትፈቀደዪ የትቄደሰ ቂጣ በና።<note caller="-" style="x"><char style="xo" closed="false">12፥4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ዘሌ. 24፥9</ref>። </char></note> <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />ኧሗም ካሕናት በሰንበት ከነ በቤተ መቅደስ ሰምበት ቲችላለፎ በደል ኸነም ኤቆጠርቦኸም በሙሴ መሳ ባቡዪ ሕጊ የጣፈዪ አናምበብኩ?<note caller="-" style="x"><char style="xo" closed="false">12፥5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ዘሑ. 28፥9-10</ref>። </char></note> <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />ቢኸንም በቤተ መቅደስ ይበዛ ዘ፥ በዚ ነነ ኧብርሑ። <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />ኧሗም ‘እያ ኧሸኒ ምረተሑ አንኸንም መስዋዕት አንከነ’ ይቡኒ የመጽሐፍ ቃል ምን የኸነኸም ብታጥራምቶ በደል ቤነቦ ሰቦች ᎈር ባንፈረድኩ ባነ።<note caller="-" style="x"><char style="xo" closed="false">12፥7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቴ. 9፥13</ref>፤ <ref loc="HOS 6:6">ሖሴ. 6፥6</ref>። </char></note> <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />ዛምኸም የሰብ ትኸ የሰምበት ጔታው።”<verse eid="MAT 12:8" /></para>
  <para style="s1">ኢየሱስ ኧጀሑ ጅረ የኸነዪ ሰብ አተረፈ</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3፥1-6</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፥6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />ኢየሱስ በዛ መደር ተነሳም ተምኩራበሕኖዬ ገባ፤ <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />በዛም አት ኧጅ ጅረ የኸነ ሰብ ባነ፤ የኢየሱስም ይከሶᎄዪ መሳ የሸዎ አታት ሰቦች “በሰምበት ከነ የታቌዪ ፈያ ወሰክት ተፌቀደም?” ቲብሮ ተሳሎይ። <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />ኢየሱስም እኪ ባረኖ፦ “ባሑ ግብት ቁና ኧጤ ያነን፥ ኧጤዪ በሰምበት ከነ በጐጀ ውስጥ ቢይቡየወ ሻበም ኤያወጣን ሟኒ?<note caller="-" style="x"><char style="xo" closed="false">12፥11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">ሉቃ. 14፥5</ref>። </char></note> <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />ኧጌ፥ ተጤዪ ቅጫ ሰብ ምንኸም ኤይበዛ! ስለኸነም በሰምበት ከነ ፈያ ቃር ወሰክት የትፌቀደው።” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />በዛ አንቌ ኢየሱስ ኧጅ ጅረዪ “ኧጃኸ ዘርጋ” ቧረን። ሑቲም በዝረጓን ግዝየ ኧጀሑ ተረፈም የዛ የፈያዪ ኧጅኸም ዀነነ። <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />ፈሪሳውያን በዛም ወጦም የኢየሱስ ምንኸም ሸከቶም ይቀጥሮይኸም ተማከሮ።<verse eid="MAT 12:14" /></para>
  <para style="s1">የእዝጌር የትሜጠረ አገልጋይ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ኢየሱስም ሤራሕኖ ሐረም በዛ መደር ሽቅ ባረ፤ ብዠ ሰቦች ተዄተሎይም ወሮ፤ የታቆዪም እንም ፈያ ሸከተኖ፤ <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ሰቦቺም ስለ ሑቲ የሟንም ኤይዝነጎኸም ኤዘዘኖ፤ <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ዚም የኸነ በነብዪ ኢሳያስ የዝነጒዪ ትምቢት ይትፌጠሜው።<verse eid="MAT 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18" />“ዘ! የሜጠርኩን አገልጋየኛ ዚቱ!</para>
  <para style="q2" vid="MAT 12:18">ሑቲ እያ ኧወጅጂም ኧትብላለቅወዪዉ!</para>
  <para style="q2" vid="MAT 12:18">መንፈሰኛ በሑቲ ᎈር አወናን፤</para>
  <para style="q2" vid="MAT 12:18">ሑቲም ቅን ፍርድ የሕዝቢ ይውድ።<verse eid="MAT 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19" />ሑቲ ኤይኦግት ወይ ው ኤይብር፤</para>
  <para style="q2" vid="MAT 12:19">ቤማ ᎈር ጣምባሑ ይሰማ ኤነ።<verse eid="MAT 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20" />የቅጠቀጠ ሸምበቆ ኤሰብር፤</para>
  <para style="q2" vid="MAT 12:20">ይተኒም የጧፍ ክር ኤያጠፋ፤</para>
  <para style="q2" vid="MAT 12:20">ዚም ይሸክቲ፥ ቅን ፍርድ</para>
  <para style="q2" vid="MAT 12:20">ውራግ ይረሕብ ስኑ።<verse eid="MAT 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="MAT 12:21" />አሕዛብ በሑቲ ተስፋ ይሸክቶ።”<note caller="-" style="x"><char style="xo" closed="false">12፥18-21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42፥1-4</ref>። </char></note><verse eid="MAT 12:21" /></para>
  <para style="s1">ኢየሱስ ብዔልዜቡልም</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3፥20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፥14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />በዛ አንቌ ሰቦች አት ጋኔን ያነወዪ ወዥ ኤይችሊ ዱዳ ሰብም ተኢየሱሴ አቸኖይ፤ ሑቲም ፈያ ሸኰተን፤ ምሲም ወዘንግም ወዥ ቻለ። <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ሕዝቢም እንም ተጌረሞ፦ “ዚ የዳዊት ትኸ ይኸን ሑኒ?” ባሮ።<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />ፈሪሳውያን ዚ በሰሞ ግዝየ “ሑቲ ‘ብዔልዜቡል’ በቧሪዪ በአጋንት አለአ መሳ ባንከነ አኸንም አጋንት ኤያወጣ” ባሮ።<note caller="-" style="x"><char style="xo" closed="false">12፥24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቴ. 9፥34</ref>፤ <ref loc="MAT 10:25">10፥25</ref>። </char></note><verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />ኢየሱስም አሳበሕኖ ሐረም እኪ ባረኖ፦ “አት መንግሥት ተሰሰደም ነብስ በነብሰሑ ይትናከስ በኸነ፥ ዛ መንግሥት ይወጥቅ። ዛምኸም አት ከተማ፥ አት አበሮስ ነብስ በነብሰሕኖ በሰሰዶ ጠኖም ወንብር ኤይችሎ። <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />ሼጣንም የሼጣን ያትዌጣ በኸነ ነብስ በነብሰሕኖ ተሰሰዶ ወበሩ፤ ኧጌ፥ መንግሥቲ ምንኸም ጠናም ይነብሬ ይችል! <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />እያ አጋንት አወጣ በብዔልዜቡል በኸነ፤ ዴንጋሑ በሟ ሽም ያትዌጦዮ? ስለኸነም ዴንጋሑ ባሑ ᎈር ይፈርዶቡኩ። <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />እያም አጋንት አትዌጣ በእዝጌር መንፈስ በኸነ፤ የእዝጌር መንግሥት ታሑዬ ቸኘም። <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />ኧሗም አት ሰብ በደረም የቡሼዪ ቴያግድ ተቡሼዪ ቤቴ ገባም ዱኒያሑ ይዘርፌ ምንኸም ይችል? ቡሼዪ ኧጉጀኘ በሸኰተን አንቌ የኢንም ዱንያሑ ይዘርፌ ይችል። <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />ቲያጌ ያንከነ እንም ተቃዋሚኛው፤ ቲያምጌ ኤይስበስብ ይቤትን።<note caller="-" style="x"><char style="xo" closed="false">12፥30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9፥40</ref>። </char></note> <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />ስለኸነም ሰብ ይሸኩች ሟንመሑ አጢያት ወይ የስድብ ቃል እንም አፉ ይትᎄኝነ ኧብርሑ፤ በመንፈስ ቅዱስ ᎈር የስድብ ቃል ይዝነግ ሰብ በደለሑ አፉ ኤይትᎄኝነ። <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />በሰብ ትኸ ᎈር የስድብ ቃል ይዝነግ እንም በደለሑ አፉ ይትᎄኝነ። በመንፈስ ቅዱስ ᎈር የስድብ ቃል ይዝነግ እንም በዚ ዓለም ኸነ ቢቸኚም ዓለም በደለሑ አፉ ኤይትᎄኝነ።”<note caller="-" style="x"><char style="xo" closed="false">12፥32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፥10</ref>። </char></note><verse eid="MAT 12:32" /></para>
  <para style="s1">ፈያ ኧጨ በፍርየሑ ይትኴር ወሕነሑ</para>
  <para style="r">(<ref loc="LUK 6:43-45">ሉቃ. 6፥43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“ኧጨ እንም በፍርየሑ ይትኴር ስለኸነ ፈያ ኧጨ የንብርኩ፤ ፍርየሑም ፈያ ይኸን፤ ኧጨዪ ውዶ በኸነ ፍርየዪም ውዶ ይኸን።<note caller="-" style="x"><char style="xo" closed="false">12፥33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">ማቴ. 7፥20</ref>፤ <ref loc="LUK 6:44">ሉቃ. 6፥44</ref>። </char></note> <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />አሑ የእንድወደረ ዴንጋ! ቡሼ ትትኸኖ ፈያ ዘንጋ ወዘንግ ምንኸም ትችሎ? ሰብ ባፈሑ ይዝነግኒ በሒነሑ መላም የተረᎈኒው።<note caller="-" style="x"><char style="xo" closed="false">12፥34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቴ. 3፥7</ref>፤ <ref loc="MAT 23:33">23፥33</ref>፤ <ref loc="MAT 15:18">15፥18</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፥7</ref>፤ <ref loc="LUK 6:45">6፥45</ref>። </char></note><verse eid="MAT 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 12:35" />“ፈያ ሰብ በፈያ መዝገበሑ፥ ፈያ ዘንጋ ያወጣ፤ ቡሼ ሰብ በቡሼ መዝገበሑ ቡሼ ዘንጋ ያወጣ። <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />የኢን ኧብርሑ፤ ሰቦች ስለይዝነጎዪ ኤድገልል ቃል እንም በፍርድ ከነ ይሰሎᎄ። <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />በቃላኸ የትነሳ ይፈረድንከ፤ በቃላኸ የትነሳ ይፈርድብከ።”<verse eid="MAT 12:37" /></para>
  <para style="s1">ታምር የወዥ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8፥11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11፥29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />በዛ ግዝየ አታት የሙሴ የሕጊ አስተማሪም ፈሪሳውያን የኢየሱስ፥ “አስተማሪ! አኸ ታምር ትትሸክት ወዥ ንሸነ!” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">12፥38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቴ. 16፥1</ref>፤ <ref loc="MRK 8:11">ማር. 8፥11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>። </char></note> <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />ሑቲም እኪ ባረም ዠበረኖ “ቡሼ አመንዝራም ጨኘት ምልክት ይሰል፤ ቢኸንም ተነብዪ ተዮናስ ምልክት አንኸንም ኧንጐድ ምልክት ኤይᎅ።<note caller="-" style="x"><char style="xo" closed="false">12፥39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">ማቴ. 16፥4</ref>፤ <ref loc="MRK 8:12">ማር. 8፥12</ref>። </char></note> <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />ዮናስ በዓሣ ነባሬ ደን ውስጥ ሦሥት ከነ ሦሥት ምሳርም ያቸለፈኸም፥ ዛምኸም የሰብ ትኸ በቀብር ውስጥ ሦሥት ከነ ሦሥት ምሳርም ያቸልፍ።<note caller="-" style="x"><char style="xo" closed="false">12፥40 </char><char style="xt" closed="false"><ref loc="JON 1:17">ዮና. 1፥17</ref>። </char></note> <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />የነነዌ ሰቦች በፍርድ ከነ ተዚ ጨኘትጌ ተነሶም በሑቲ ᎈር ይፈርዶᎄ፤ የነነዌ ሰቦች የዮናስ ስብከት በሰሞ ግዝየ በአጢያተሕኖ ተጤጠቶም ንስሐ ገቦም። ኧሗም ተዮናስ ይበዛ በዚ ነነ።<note caller="-" style="x"><char style="xo" closed="false">12፥41 </char><char style="xt" closed="false"><ref loc="JON 3:5">ዮና. 3፥5</ref>። </char></note> <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />በፍርድ ከነ የደቡብ ንግሥት ተዚ ጨኘትጌ ተነሣችም ትፈርድ፤ የሰሎሞን ብላት የወስማ ባፈር ጥግ ቸኘችም። ዘ፤ ተሰሎሞን ይበዛ በዚ ነነ።”<note caller="-" style="x"><char style="xo" closed="false">12፥42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ነገ. 10፥1-10</ref>፤ <ref loc="2CH 9:1-12">2 ዜና 9፥1-12</ref>። </char></note><verse eid="MAT 12:42" /></para>
  <para style="s1">ሩክስ መንፈስ በሰብ ውስጥ ተዠበረም ወᎄየሑ</para>
  <para style="r">(<ref loc="LUK 11:24-26">ሉቃ. 11፥24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />ቄጠለም ኢየሱስ እኪ ባረ፦ “ሩክስ መንፈስ በሰብ ውስጥ በወጣ ግዝየ ያᎈይወ መደር በወሴ ኧጋ ቤነወ በጠረቅ መደር ይዦር። ቢኸንም ኤይረሕብ፤ <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />ስለኸነም ‘ተወጣሑወ ቤተኛዬ ተዠበርኩም ንወር’ ይብር። ተዠበረም ቲቸኝ፥ ቤቲ ባዶ ኸነም፥ ተሟጀም፥ተዝጋጀም ይረሕቡ። <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />በዛ አንቌ፥ ሩክሲ መንፈስ ያርም ተውቲ ይብስ ቡሼዪ እንጐድ ሰበት አጋንት ጠበጠም ይቸኝ። ሕኖም በደረም የጋኔኒ ቤት ተነበረዪ ሰብ ሒን ቡሮም ቁናዬ በዛዬ ይነብሮ። ስለኸነም የዛ ሰብ ያንቌዪ ሐለት ተመጀመሪያዪ የባሰ የከፋ ይኸን። በዚ ቡሼ ጨኘት ᎈር ይኸኒ ዛምኸም የመሰረ ቃሩ።”<verse eid="MAT 12:45" /></para>
  <para style="s1">የኢየሱስ ዳኰች ጐባቢተሑም</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3፥31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፥19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />ኢየሱስ የሕዝቢ ገና ቲዝነግ ትናነ፥ ዳኰች ጐባቢተሑም ያዝናጎዬ ሸዎም በወረጀ ቈሞም ባነ። [<verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />በዛም በነበሮዪ ሰቦች አቲ የኢየሱስ፥ “ዘ ዳኳኸም ጐባቢታኸ ያዝናጎከዬ ሸዎም በወረጀ ቈሞም” ቧረን።]<note caller="+" style="f"><char style="fr" closed="false">12፥47 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊጥር 47 ኤነኖ። </char></note> <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />ኢየሱስም “ዳኮኛ ሟኒያ? ጐባቢተኛሽ? ሟኒኖ?” ቲብር ዠበረኖ። <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />በዛ አንቌ ኧጀሑ ዝረጋም ተደቀ መዛሙርተዄ አቴዠም እኪ ባረ፦ “ዳኮኛ ጐባቢተኛም ዘ፥ ነዚሕኖኖ፤ <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />በሰሜ ያነዪ የአባኛ ፈአድ ይፌጥም እንም፥ ጐቤኛም፥ ኧተመኛም፥ ዳኮኛም ሑቲቱ።”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">የዘሪ ምሳሌ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4፥1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፥4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />በዛም ከነ ኢየሱስ በቤት ወጣም በባሪ ᎀረ ቶና፤ <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />ብዠ ሰብ ተሑቲዬ ቸኖም በወሰብሰበሕኖ በጀልባ ᎈር ወጣም ቶና፤ ሕዝቢ እንም፥ በባሪ ᎀረ ቌሞም ባነ።<note caller="-" style="x"><char style="xo" closed="false">13፥2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፥1-3</ref>። </char></note> <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />በዛ አንቌ ብዠ ዘንጋ በምሳሌ እኪ ቲብር ኤወደኖ፤ “ዘ! ቁና ገበሬ የወዝራ ወጣ። <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />ሑቲም ቲዘራ አታቲ ዘር ቤማ ᎀረ ወጠቀም አንፉ ቸኖም በኖይ። <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />እንጐዲ ዘር ብዠ አፈር ቤነወ በጠረቅ አፈር ᎈር ወጠቀ፤ አፈሪም ብዠ አፈር ዬነወ ስለኸነ ጥልቀት አነᎄረን፤ ስለኸነም ዘሪ ሒንጌ በቀለ። <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />የሕን አንኸንም ጬት በወጣ ግዝየ ዶገለ፤ ሥር ያነᎄረን ስለኸነ ጠረቀ። <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />እንጐዲም ዘር ብሶክ ቁጥቋጦዪ ግብት ወጠቀ፤ ብሶሒ ቁጥቋጦ ላቀም ዘሪም የበቀለዪ ቡቃያ አነቀም አቈኘን። <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />እንጐዲም ዘር በፈያ አፈር ᎈር ወጠቀም በቀለም ብዠ ፍርየ አወረደ፤ አቲ መቶ፥ አቲ ሥልሳ፥ አቲም ሰላሳ ፍርየ አበም። <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />ይሰማ እዝን ያነን የስማ!”<verse eid="MAT 13:9" /></para>
  <para style="s1">ኢየሱስ የመአር በምሳሌ ይዝነግ የነበረኸም</para>
  <para style="r">(<ref loc="MRK 4:10-12">ማር. 4፥10-12</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፥9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />በዛ አንቌ ደቀ መዛሙርተሑ ተኢየሱሴ ቀረቦም፥ “የመአር የሕዝቢ በምሳሌ ትዝነግ?” ባሮይ። <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />ሑቲም እኪ ቲብር ዠበረኖ፦ “ያሑ የመንግሥተ ሰሜ ምስጢር ወሐር አቡኩም፤ የሕኖ አናቡዮ። <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />ያነን ሰብ የበዛ ይᎅ፤ ይᎄዛነ፤ ቤነን ሰብም ዛም ያነኒ ይወስጅᎄ።<note caller="-" style="x"><char style="xo" closed="false">13፥12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቴ. 25፥29</ref>፤ <ref loc="MRK 4:25">ማር. 4፥25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፥18</ref>፤ <ref loc="LUK 19:26">19፥26</ref>። </char></note> <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />ቲያዞ ኤያዞኸም፥ ቲሰሞ ኤይሰሞኸም ኤያጥራምቶ ስለኸኖ ዘ፥ እያ በምሳሌ ኢውዶ። <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />ስለኸነም በነብዪ በኢሳያስ እኪ ቧሪም የጣፈዪ በሕኖ ᎈር ይትፌጠም፦</para>
  <para style="q1" vid="MAT 13:14">“‘ወስማሽ ትሰሞ፤ ቢኸንም አታጥራምቶ፤</para>
  <para style="q2" vid="MAT 13:14">ወዥ ታዞ፤ ቢኸንም ሒን አትሸክቶ።<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />የዚ ሕዝብ ሒን ድነደነም፤</para>
  <para style="q2" vid="MAT 13:15">እዝነሕኖ ጥነቈረም፤ ዔነሕኖም ተደፈነም፤</para>
  <para style="q2" vid="MAT 13:15">እኪሽ ቤይኸን ቤነሕኖ አዞም፥</para>
  <para style="q2" vid="MAT 13:15">ብዝነሕኖም ሰሞም፥</para>
  <para style="q2" vid="MAT 13:15">በቀልበሕኖ አጥራመቶም፥</para>
  <para style="q2" vid="MAT 13:15">ቲያዬ በዠበሮ ፈያ በሸከትኩኖ ባነ።’<note caller="-" style="x"><char style="xo" closed="false">13፥14-15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፥9-10</ref>። </char></note><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“አሑ ዔናሑ ያዥ ስለኸነ፥ እዝናሑ ይሰማ ስለኸነ የትባረኮኖ። <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />የኢን ኧብርሑ፤ ብዠሕኖ ነብዮች ጻድቃንም ያሑ ታዞዪ የወዥ ተሜኖም ባነ፤ ቢኸንም አነዞ፤ አሑ ትሰሞዪ የወስማ ተሜኖም ባነ፤ ቢኸንም አንሰሞ።<note caller="-" style="x"><char style="xo" closed="false">13፥16-17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ. 10፥23-24</ref>። </char></note><verse eid="MAT 13:17" /></para>
  <para style="s1">የዘሪ ምሳሌ ትርጉም</para>
  <para style="r">(<ref loc="MRK 4:13-20">ማር. 4፥13-20</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፥11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“ኧጌሽ አሑ የዘሪ ምሳሌ ምን የኸነኸም ስሞ፤ <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ቤማ ᎀረ የወጠቀዪ ዘር ያምለክቲ፥ የእዝጌር መንግሥት ቃል ሰማም ኤያጥራምት ሰቡ፤ ሒንጌም ሼጣን ቸኘም በሒነሑ የዘሬዪ ቃል ይወስድወ፤ <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />በጠረቅ አፈር ᎈር የዘሬዪ ያምለክቲ፥ ቃሊ ሰማም ሒንጌም በብልቃት ይቌበሪ ሰቡ። <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />ቢኸንም የግዝየሑ አንኸንም በሒነሑ ውስጥ ሥር አንሰደደ፤ ስለኸነም በቃለሑ መሳ አት ምካት ስደትም በሰላወ ግዝየ ሒንጌ ይስናከል። <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />ብሶሕ ቁጥቋጦ ግብት የዘሬዪ ያምለክቲ፥ ቃሊ የግዝየሑ ይሰሟኒ ሰቡ፤ የሕን አንኸንም የዚ ዓለም አሳብ የዱኒያ ውዴታ ተሒነውታኔ ቡየም ቃሊ ያንቁ ስለኸነ ፍርየ ኤባን ፍርየ ይቀይ። <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />በፈያ አፈር ᎈር የዘሬዪ ያምለክቲ፥ ቃሊ ሰማም በዋጥራምት ይቄᎄሪ ሰቡ፤ ሑቲ ፍርየ ያወርድ፤ አቲ መቶ፥ አቲ ሥልሳ፥ አቲ ሠላሳ ፍርየ ይብ።”<verse eid="MAT 13:23" /></para>
  <para style="s1">የቅንጬዪ ምሳሌ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />ዛምኸም ኢየሱስ እኪ ቲብር እንጐድ ምሳሌ ኤወደኖ፦ “መንግሥተ ሰሜ በእርሻዪ ፈያ ዘር የዘራዪ ሰብ ይመስር፤ <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />ቢኸንም ሰብ እንም በገደረ አንቌ መሶ ቸኘም በስሬዪ ውስጥ ቅንጬዪ ዘራንም ወረ። <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />ስሬዪም ላቀም ባወረደ ግዝየ ቅንጬዪም በዛ ግዝየ ታዠ። <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />ስለኸነም የእርሻዪ ባለቤት ሜነተኞች ተሑቲዬ ቀረቦም ‘ጔታ፥ በእርሻኸ ፈያ ዘር ዘራኸም አነበረ? ኧጌ፥ ቅንጬዪ ቤቴ ቸኘ?’ ባሮይ። <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />ሑቲም ‘ዚ የሸከተ መሶው’ ባረኖ። ሜነተኞቺም ‘ኧጌ ወርነም ቅንጬዪ ኧነቅልነይኸም ትሸ?’ ባሮይ። <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />ሑቲም እኪ ቲብር ዠበረኖ ‘ኤይኸን ቅንጬዪ ትትነቅሎ ስሬዪ ቁናዬ ትነቅሎይ። <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />ስለኸነም ግፍሮዮ፤ መከር ግዝየ ስን ስሬዪም ቅንጬዪም ቁናዬ የላቆ፤ በመኸር ግዝየ ያዶዪ የቅንጬዪ ብድሮማሑ ንቅሎይ፤ በሳት ይᎂጉሪኸም በጦር ጦሪ ኧግዶ፤ ስሬዪም ሰብስቦማሑ በጐተራኛ ሕሮ’ ኧብሮ።”<verse eid="MAT 13:30" /></para>
  <para style="s1">የሰናፍጭ ዘር ምሳሌ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4፥30-32</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፥18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ኢየሱስ እንጐድ ምሳሌ እኪ ቲብር ኤወደኖ፦ “መንግሥተ ሰሜ አት ሰብ ወሰደም በእርሻዪ የዘራን የሰናፍጭ ዘር ይመስር። <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />የሰናፍጭ ዘር ትንጐድ ዘሮች እንም ያነሰ ቢኸንም፤ ቲለቅም ታታሕልቶች እንም በዛም፤ የሰሜ አንፉዎች ቸኖም በጫፈሑ ᎈር ያᎈሮᎄ ስን ኧጨ ይኸን።”<verse eid="MAT 13:32" /></para>
  <para style="s1">የእርሾዪ ምሳሌ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ. 13፥20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ኧሗም ኢየሱስ ዚ ምሳሌ ኤወደኖ፦ “የመንግሥተ ሰሜ አት ምሽት ወሰደችም በሦስት ይቋጨᎄ ቀማጌ የቅላቀለቺ እርሾ ይመስር፤ እርሾዪም የቡኮዪ እንም ይቦካኸም ሸኰተን።”<verse eid="MAT 13:33" /></para>
  <para style="s1">ኢየሱስ የመአር በምሳሌ ያትመረኸም</para>
  <para style="r">(<ref loc="MRK 4:33-34">ማር. 4፥33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />ኢየሱስ ዚ እንም ቃር በምሳሌ የሕዝቢ ዝነጔ፤ ምሳሌ ቴደብርወ አት ቃር አንዘጔኖ። <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ዚም የኸነወ መሳ በነብይ እኪ ቧሪም የጣፈዪ ይትፌጠምኸሙ፦</para>
  <para style="q1" vid="MAT 13:35">“ንግግረኛ በምሳሌ ኧጐልጭ፤</para>
  <para style="q2" vid="MAT 13:35">ዓለም በትኸለቀ ቀረሰም የሼመዪ ኧዝንግ።”<note caller="-" style="x"><char style="xo" closed="false">13፥35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">መዝ. 78፥2</ref>። </char></note><verse eid="MAT 13:35" /></para>
  <para style="s1">ኢየሱስ የቅንጬዪ ምሳሌ ያትሬዳኸም</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />በዛ አንቌ ኢየሱስ የሕዝቢ ጌገተም ተቤቴ ገባ፤ ደቀ መዛሙርተሑ ተውቲዬ ቀረቦም፥ “የእርሻዪ ቅንጬ ምሳሌ ትርጉም አትረዳነ” ባሮይ።<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ፈያዪ ዘር የዘራን የሰብ ትኸው፤ <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />እርሻዪ ዚ ዓለሙ፤ ፈያዪ ዘር የእዝጌር መንግሥት ዴንጋኖ፤ ቅንጬዪ የሼጣን ዴንጋ ኖ። <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ቅንጬዪ የዘራን መሶ ዳቡሎሱ፤ አዝማራዪ ይስᎄስቡᎄ ግዝየ የዓለም መጨረሻው፤ ያዶዪ መላይካኖ። <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />ልክ ቅንጬዪ ተነቀለም ተጦር ጦረሑ አጐጅም ይሜጉሪኸም እንም በዓለም መጨረሻ ዛምኸም ይኸን። <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />በዛ ግዝየ የሰብ ትኸ መላይካ ይለሕ፤ ሕኖም የአጢያት መሳ የኸኖዪ ቡሼ ይሸክቶዪ እንም ተሑቲ መንግሥት ስበሰቦም ያወጦዮ፤ <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />ተፍርድ ኧሳቴም ያድጎዮ፤ በዛም አልፋታም ስን ዋንቅጫቅጭም ይኸን። <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />ጻድቃንም በአበሕኖ መንግሥት የጬትኸም ያበሮ፤ ይሰማ እዝን ያነን የስማ!”<verse eid="MAT 13:43" /></para>
  <para style="s1">የሼመ ዱኒያ ምሳሌ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />ቄጠለም ኢየሱስ እኪ ባረ፦ “የመንግሥተ ሰሜ በእርሻ ውስጥ የሼመዪ ዱኒያ ይመስር። አት ሰብ ዚ ዱኒያ በረከᎄን ግዝየ ዠበረም ሼᎀን፤ ተብልቃተሑ ብዛት የትነሳ ወረም ያነኒ እንም አስየም ዛ እርሻ ስየን።”<verse eid="MAT 13:44" /></para>
  <para style="s1">የዕንቁ ምሳሌ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />ዠበረም ኢየሱስ እኪ ባረ፦ “ኧሗም የመንግሥተ ሰሜ ፈያ ዕንቁ የወሰየ ይሸ ነጋዴ ይመስር፤ <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />ነጋዴዪም ስርም ክቡር የኸነ ዕንቁ በረከበ ግዝየ ወረም ያነኒ እንም አስየም ዛ ዕንቁ ስየን።”<verse eid="MAT 13:46" /></para>
  <para style="s1">የመረቢ ምሳሌ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />ቄጠለም ኢየሱስ እኪ ባረ፦ “ዛምኸም መንግሥተ ሰሜ ተባሬ ያደጒ መረብ ይመስር፤ ሑቲ ዛም ኸማት ዓሣ ይስበስቢው፤ <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />በመላ ግዝየ ዓሣ ያሰግሮዪ ተባሪ ጥጊዬ ሻቦም ያወጦይ፤ ቶኖም ፈያ ፈያዪ ሜጠሮም በግብር ያወኖይ፤ ውዶ ውዶዪም ተዛዬ ያድጎይ። <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />በዓለም መጨረሻ እኪ ይኸን፥ መላይካ ቸኖም አጢያተኞች ተጻድቃን ይላኖዮ። <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />ቡሼዪ ተፍርድ ኧሳቴም ያድጎዮ፤ በዛ አልፋታ ስንም ዋንቅጫቅጭ ይኸን።”<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />ኧሗም ኢየሱስ፦ “ዚ እንም አጥራመትኩም?” ባረኖ።</para>
  <para style="p" vid="MAT 13:51">ሕኖም “ኤክ ጔታ!” ባሮ። <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />ሑቲም “ኧጌሽ የመንግሥተ ሰሜ ምስጢር ተቂየም ይሒር የሙሴ የሕጊ አስተማሪ፦ ግብር ቲያወነᎄዪ ቤቲ ገደር ጉርዝም ተኸነዪ ግብር ያቸኝ የዱኒያ ባለቤት ይመስር” ቲብር ዠበረኖ።<verse eid="MAT 13:52" /></para>
  <para style="s1">ኢየሱስ በናዝሬት የሰላወ ተቃውሞ</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6፥1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፥16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />ኢየሱስ ነዚ ምሳሌ ዝነጔም በፈጀ አንቌ፥ በዛ መደር ወረ። <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ተገኘሑ ተናዝሬት ከተማዬ ቸኘም በምኩራበሕኖ የሕዝቢ ያትመር ባነ፤ የሰሞዪም እንም በወደነቅ እኪ ይብሮ ባነ፤ “ዚ ሰብ ዚ ብላትም ዚ ድንቅ ሜና ቤቴ አቸኘን? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />ዚ ያናጢዪ ትኸ አንከነ? ዳኰች ማርያም አንከነች? ጐባቢተሑሽ ያዕቆብ፥ ዮሴፍ፥ ስምዖን ይሑዳም አንከኖ? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />ኧተሟᎁተሑ እንም ቲናጌ አንከነማ? ኧጌ፥ ዚ ሰብ ዚ እንም ብላት ቤቴ ረከᎄን?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />በዚም መሳ ተስናከሎᎄም ቴይቌበሮይ ቀኖ። ኢየሱስም፦ “ነብይ ኤይከበር በገኘሑ በፎለሑም ቤት ጠለለው” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">13፥57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሐ. 4፥44</ref>። </char></note> <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />ባለወምነሕኖም ኢየሱስ በዛዬ ብዠ ታምር አንሰከተ።<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">የመጥምቂ የዮሐንስ ሞት</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6፥14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፥7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />በዛ ግዝየ አርበታለኘዪ ክፍል ገዢ የነበረዪ፤ ሔሮድስ የኢየሱስ ዝና ሰማ። <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />አገልጋዮቸሑ፥ “ዚ መጥምቂ ዮሐንሱ፤ ሑቲ በሞት ተነሳም፤ ነዚ ድንቅ ቃር በሑቲ መሳ ይሸክቶ ስለኸነው” ባረኖ።<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />በደረም ሔሮድስ፤ በጐቤች በፊልጶስ ምሽት በሔሮድያዳ መሳ የዮሐንስ አጤበጠም በወሕኔ ቤት አትጌቧንም ባነ።<note caller="-" style="x"><char style="xo" closed="false">14፥3-4 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3፥19-20</ref>። </char></note> <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ዮሐንስ የሔሮድስ፦ “የጐቤያኸ ምሽት ታገባኸም የሙሴ ሕጊ ኤፈቅድንከ!” ቧረንም ባነ።<note caller="-" style="x"><char style="xo" closed="false">14፥4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ዘሌ. 18፥16</ref>፤ <ref loc="LEV 20:21">20፥21</ref>። </char></note> <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />ስለኸነም ሔሮድስ የዮሐንስ ይቌጥሬ ይሸ ባነ፤ ቢኸንም የአይሑድ ሕዝብ የነብይኸም ያዞይ የነበረ ስለኸነ የሕዝቢ ጔና። <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />ሔሮድስ የጨኘወ ከነ ቢከበርወ ከነ የሔሮድያዳ ገረድ ቸኘችም በጋᎄዥዮዪ ግብት ትትደርስ የሔሮድስ አትብላለቀቹ። <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />ስለኸነም ሔሮድስ፦ “የሸሺ ቃር ተሴልኝ! እያም ይብሽ!” ቲብር በወማል ቃል ገባና።<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />ሒቲም በዳኴታ ተመከረችም “የመጥምቂ የዮሐንስ ጉነን በወጨት ኧሗ ናሜ!” ባረቹ።<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />ንጉሢ በዚ ዘንጋ አዘነ፤ የሕን አንኸንም በወማለሑ፥ ተውቲጌ በማዳ ቾኖም የነብሮዪ ሰቦች ምን ይቡርኝ ባረም የዮሐንስ ጉነን ይቡያኸም ኤዘዘ። <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ስለኸነም ተወሕኔ ቤቴ ሰብ ላኸም የዮሐንስ ጉነን አቅᎂጠለን። <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />የቅመጠለዪም ጉነን በወጨት አቸኖም የገረዲ አቦያ፤ ሒቲም የዳኴታ ወሰደችም አበታ። <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />የዮሐንስ ደቀ መዛሙርትም ቸኖም ሬሳዪ ወሰዶም ቀበሮይ፤ ወሮም ዚ ዘንጋ የኢየሱስ ኤወዶይ።<verse eid="MAT 14:12" /></para>
  <para style="s1">ኢየሱስ አምስት ሺ ሰብ ያበናኸም</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6፥30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፥10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሐ. 6፥1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />ኢየሱስ የዮሐንስ ወሙት በሰማ ግዝየ በጀልባ ተሳፈረም ታት የትላኘ መደር የቢቶውታን የወሕን ወረ። ሕዝቢም ዚ በሰሞ ግዝየ በከተማ ተከተማዪ ወጦም በግረሕኖ ተዄተሎይ። <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />ኢየሱስ በጀልባዪ በወረደ ግዝየ ብዠ ሕዝብ አዠም አዘነኖም፤ የታቆቦዪም ፈያ ሸከተኖ።<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />በመሸ ግዝየ ደቀ መዛሙርተሑ ተሑቲዬ ቀረቦም፥ “ዚ መደር በረሐው፤ ከነዪም መሸም፤ ስለኸነም ሕዝቢ በቁርቤ ታኖዪ መንደሮቼ ወሮም ስንቀሕኖ ይስሮኸም ገግቶ” ባሮይ።<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />ኢየሱስም፦ “አሑ ይበሮዪ ቃር አቦዮ አንኸንም ሕኖ እክም ወወር ኤነቦ!” ባረኖ።<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />ደቀ መዛሙርተሑም “ኢና በዚ ያነነ አምስት እንጄራ ዄት ዓሣም ጠለለው” ባሮይ።<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />ኢየሱስም “ሑቲም ቲያዬ አተኖኒ!” ባረኖ። <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />በዛ አንቌ ሕዝቢ በጠባዪ ሠር ᎈር ይቾኖኸም ኤዘዘ፤ አምስቲ ቂጣ ዄቲ ዓሣም ነሣም ተሰሜዬ ቀና ባረም አዠም የምስጋና ጠሎት ሸከተ፤ ቂጣዪም ፍረረመም የደቀ መዛሙርተሑ አበ፤ ደቀ መዛሙርተሑም የሕዝቢ አቦዮ። <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />እንም በኖም ጦፎ፤ የትራረፈዪ ፍርፋሪ፥ ደቀ መዛሙርተሑ በዐሥረዄት ሌማት ᎀሎም ነሶ። <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />የበኖዪም ሰቦች ትንሽታ ተጠቈኘትም እንጐድ አምስት ሺ ቅጫ ገሜ ባኖ።<verse eid="MAT 14:21" /></para>
  <para style="s1">ኢየሱስ በኧጋ ᎈር የወረኸም</para>
  <para style="r">(<ref loc="MRK 6:45-52">ማር. 6፥45-52</ref>፤ <ref loc="JHN 6:15-21">ዮሐ. 6፥15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />በዛ አንቌ ኢየሱስ የደቀ መዛሙርተሑ፥ “እያ የሕዝቢ ኧጔግቶ ስን በጀልባ ተሳፈሮም ብደሮኝም ተዛዘሬ ተገኖ፤” ቲብር ኤዘዘኖ። <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />ሕዝቢም በጌገተ አንቌ የወጠልይ የቢቶሑ ታት ቈቶ ᎈሬ ወጣ፤ በመሸ ግዝየ ኢየሱስ በዛም የቢቶሑ ባነ። <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />በዛ ግዝየ ጀልባዪ በኧጋዪ ግብት ኸነም ቲያርወዪ ኤማ ብንጐድ ቢነፍሲ ኧንፋስ ቲትገፋ እንቡልቡልቲ ተዛዬ ተዚዬ ያንጉላታን ባነ። <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />በምሳሪ ዠጠ ሰዓት አንቌ ኢየሱስ በኧጋዪ ᎈር ተደቀ መዛሙርተዄ ቸኘ። <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />ደቀ መዛሙርተሑም በኧጋዪ ᎈር ቲያር ባዞይ ግዝየ ስርም ጔኖም ድነበጦ፤ “ዚ የᎀተ ሰብ መንፈሱ!” ባሮም በወገና ው ባሮ።<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ኢየሱስ ሒንጌም “አትክቶ! እያትንኩ፤ አትገኖ!” ባረኖ።<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />ጴጥሮስም፤ “ጔታ፤ አኸ በኸንከሽ፤ በኧጋዪ ᎈር ትንትራመድ ታኸዬ ኧቸኝኸም ኧዝዜ” ቧረን።<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ኢየሱስም “ኔኸ!” ቧረን። ስለኸነም ጴጥሮስ በጀልባዪ ወረደም ተኢየሱሴ የወወር በኧጋዪ ᎈር ወረ። <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />ቢኸንም ኧንፋሲም ቆት አዠም ጔታ፤ ተኧጋዬ ውስጥ ወስምጥ በቀረሰ ግዝየ “ጔታ! አትርፌ!” ቲብር ው ባረ።<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />ኢየሱስ ሒንጌም ኧጀሑ ዝረጋም ጠᎄጠንም፦ “አኸ እምነት የቀበለናኸ! የመአር ተጥራጠርኸ?” ቧረን።<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />ኢየሱስ ጴጥሮስም በጀልባዪ በገቦ ግዝየ ኧንፋሲ ጭጭ ባረ። <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />በጀልባዪም ውስጥ የነበሮዪ እንም “የኢንም አኸ የእዝጌር ትኸንከ!” ባሮም የኢየሱስ ሰገዶነ።<verse eid="MAT 14:33" /></para>
  <para style="s1">ኢየሱስ በጌሳሬጥ የታቆዪ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6፥53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />ባሪ በጔኖ አንቌ ጌንሳሬጥ ተቧሪ መደሬ ሰሎ። <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />በዛም ገኝ የነበሮዪ ሰቦች ኢየሱስ ወሕነሑ በሐሮ ግዝየ በጭጭሳዪ ታኖዪ መደሮቼ ተለለሖም የታቆዪ ተሑቲዬ አቼኖዮ። <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />የታቆዪም የልባሰሑ ጫፍ ጠለለ ይለግዶይኸም ጮቀሶይ። የለገዶዪም እንም ተባሸሕኖ ፈያ ኸኖ።<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">የአቦቸና ሤራ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7፥1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />በዛ አንቌ፥ በኢየሩሳሌም የቸኖ ፈሪሳውያን የሙሴ የሕጊ አስተማሪም ኢየሱስ ቀረቦም እኪ ቲብሮ ተሳሎይ፦ <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“ደቀ መዛሙርታኸ የባሊኦች ሤራ የመአር ያፈርሶ? ዘ! ስንቅ ይበሮ ኧጀሕኖ ቴይታጠቦው!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />ኢየሱስም እኪ ቲይብር ዠበረኖ፦ “አሑሽ ሤራሑ የወቀየ ባሑም የእዝጌር ትዛዝ የመአር ታፈርሶ? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />እዝጌር ‘አባኸም ዳኳኸ አክብር፤ ባᎄችም፥ በዳኰችም ᎈር የስድብ ቃል የዝነጔ በሞት ይትቀጣ’ ባረም ኤዘዘም።<note caller="-" style="x"><char style="xo" closed="false">15፥4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዘፀ. 20፥12</ref>፤ <ref loc="EXO 21:17">21፥17</ref>፤ <ref loc="DEU 5:16">ዘዳ. 5፥16</ref>፤ <ref loc="LEV 20:9">ዘሌ. 20፥9</ref>። </char></note> <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />አሑም አት ሰብ አᎄችም ዳኰችም ‘ቢያ ትረሕቦዪ እርዳታ የእዝጌር መባ ሸከትኩም አቀረብኩም’ ቢብኖ፥ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />‘ዛ ሰብ አᎄችም [ዳኰችም] ዋክብር ኤያሸን’ ትብሮ፤ ስለኸነም ሤራሑ የዋጥብቅ ባሑም የእዝጌር ቃል ትሸሮ፤<note caller="+" style="f"><char style="fr" closed="false">15፥6 </char><char style="fqa" closed="false">አᎄች፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ </char><char style="fqa" closed="false">አᎄች ወይ ዳኰች</char><char style="ft" closed="false">ይብር። </char></note> <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />አሑ ግብዝ! ኢሳያስ ስላሑ እኪ ቲብር የዝነጔን ትምቢት ልኩ፤<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“‘ዚ ሕዝብ ባፈሑ ያከብሬ፤</para>
  <para style="q2" vid="MAT 15:8">ሒነሑ ቲያ የራቀው፤<verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />ሰብ ይሸኩቺ ሤራ ሥራትም፥</para>
  <para style="q2" vid="MAT 15:9">የሕጊኸም ሸከተም ቲያትመር ቤድገልል ቃር ያመልኬ።’ ”<note caller="-" style="x"><char style="xo" closed="false">15፥8-9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፥13</ref>። </char></note><verse eid="MAT 15:9" /></para>
  <para style="s1">የሰብ ያረኩሽ ቃር</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7፥14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ቄጠለም ኢየሱስ የሰቦቺ ተሑቲዬ ጠራም እኪ ባረኖ፦ “ስሞ! አጥራምቶ! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />የሰብ ያረኩሽ ተአፍ ይወጣዪው አንኸንም ታፈውታዬ ይቡየዪ አንከነ!”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />በዚ አንቌ ደቀ መዛሙርተሑ ተሑቲዬ ቀረቦም፦ “ፈሪሳውያን ዚ የዝነጔዀኒ ሰሞም የስናከሎብከኸም ሐርከም?” ቲብሮ ተሳሎይ። <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />ሑቲም እኪ ቲብር ዠበረኖ፦ “የሰሜዪ አባኛ ያንቀᎄረን አታሕልት እንም ይነቀል፤ <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />ሕኖ ወዥ ኤይችሎ ወዥ ኤይችሎዪም ይመሮ ስለኸኖ ግፍሮዮ፤ ወዥ ኤይችል ወዥ ኤይችሊ ቢመራ ዄትመሕኖ በጐጀ ውስጥ ይቡሮ።”<note caller="-" style="x"><char style="xo" closed="false">15፥14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ. 6፥39</ref>። </char></note><verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ጴጥሮስ የኢየሱስ “የምሳሌዪ ትርጉም አውደነ” ቧረን። <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />ኢየሱስም እኪ ባረ፦ “አሑ ዚጌ ስን አታጥራምቶ ቃርንኩ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />ታፌ ይቡየዪ እንም ተደኔ ቡየም ተውጪዬ ይወጣኸም አታጥራምቶ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />በአፍ ይወጣዪ በሒን ይወጣ፤ የሰብ ያረኩሽ ሑቲቱ።<note caller="-" style="x"><char style="xo" closed="false">15፥18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቴ. 12፥34</ref>። </char></note> <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />ቡሼ ዋስብ፥ ሰብ ወቅጥር፥ ወሟግጥ፥ ዝሙት ወሰክት፥ ወስርቅ፥ በባጢል ወመስክር የሰብ ሽም ዋጥፋ፥ ዚ እንም በሰብ ሒን ይወጣ። <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />የሰብ ያረክሶ ነዚሕኖኖ አንኸንም ባንታጠበ ኧጅ ወብራሽ ኤያረኩሽ።”<verse eid="MAT 15:20" /></para>
  <para style="s1">የከነዓን ምሽት እምነት</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7፥24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ኢየሱስ በዛ ወጣም ተጢሮስ ተሲዶናም ገኜ ወረ። <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />በዛም አት የከነዓናዊት ምሽት ተኢየሱሴ ቸኘችም፥ “የዳዊት ትኸ ጔታ! ትኸኛ በሩክስ መንፈስ ተጠበጠችም ትስቃዩ ታውሽ ኧዝንኒ!” ትትብር ው ባረች።<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />ሑቲም አትም ቃል ቴይዠብርና እንቁስ ባረ፤ በዛ ግዝየ ደቀ መዛሙርተሑ ተሑቲዬ ቀረቦም፥ “ዚ ምሽት ተዄተለትነም ው ትብር ስለኸነ ታውሽ ገግታ!” ቲብሮ ጮቀሶይ። <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />ሑቲም “እያ የላሑኝ በእስራኤል ቤት የጤኸም የጠፎዪ ጠለለው” ቲብር ዠበረኖ።<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />ምሽቲ ቀረበችም በግረሑ ተት ብርክክ ባረችም “ጔታ! ታውሽ ርዴ!” ባረቹ።<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />ኢየሱስም “የዴንጋ እንጄራ ወሰጅም የጊየ ዋብ የትጌባ አንከነ” ባረ።<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ሒቲም “ጔታ! የኢኑ፤ ቢኸንም ጊየም ተጌቶቸሕኖ ማዳ የወጠቀዪ ፍርፋሪ ይበሮ” ባረች።<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />በዛ ግዝየ ኢየሱስ “ምሽቶ እምነታሽ! ወደሉ፤ ስለኸነም የሸሺኸም የሕንሽ!” ባረና። የምሽቲም ትኸ በዛ ሰዓት ጠቀለና።<verse eid="MAT 15:28" /></para>
  <para style="s1">ኢየሱስ ብዠ የታቆ ሰብ ፈያ ወሰክተሑ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ኢየሱስ በዛ ተነሳም ተገሊላ ባር ᎀረ ቸኘ፤ ተቈቶ ᎈሬ ወጣም በዛ ቶና። <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />ብዠ ሰቦች ሸንካላዎች፥ ወዥ ኤይችሎዪ፥ ጅረዎቺ፥ ዱዳዎቺ እንጐዲም የታቆዪም ጠበጦም ተኢየሱሴ ቸኖ፤ በግረሑ ተት አወኖዮ፤ ሑቲም ፈያ ሸከተኖ። <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ስለኸነም ሕዝቢ ዱዳዎች ቲዝነጎ፥ ጅረዎቺ ቲተርፎ፥ ሸንካላዎቺ በፈያ ቲያሮ፥ ወዥ ኤይችሎዪ ቲያዞ በትምሌከቶ ግዝየ ተዴነቆም የእስራኤል አምላክ አምሰገኖ።<verse eid="MAT 15:31" /></para>
  <para style="s1">ኢየሱስ አርበት ሺ ሰብ ዋብራሑ</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8፥1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ኢየሱስ የደቀ መዛሙርተሑ ጠራም፥ እኪ ባረኖ፦ “ሰቦች ቲያጌ ሦስት ከነ የኸነኖ ስለኸነ ይበሮይ ቃር ዬነኖ ስለኸነ አዘነኖ፤ ቲያሮ ቤማ ቌጦም ኤይወጥኦኸም አትም ቴይበሮ ኧጌግቶዬ አንፈቅድ።”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />ደቀ መዛሙርተሑም “ኧጌ፥ የዚ እንም ሰብ ያሰላ ስንቅ በዚ በረሐ ቤቴ ኧረሕብነ?” ባሮይ። <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />ኢየሱስም “ምናሕር እጄራ ነነናሑ?” ቲብር ተሳለኖ። ሕኖም “ሰበት እንጄራ ቀል ቅስስን ዓሣ ነኖነ” ባሮይ።<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />በዛ አንቌ፥ ኢየሱስ ሕዝቢ ባፈር ይቾኖኸም ኤዘዘ፤ <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ሰበቲ እጄራም ዓሣዪ ነሣም የምስጋና ጠሎት ሸከተ፤ ፍረረመም የደቀ መዛሙርተሑ አበ፤ ደቀ መዛሙርተሑም የሕዝቢ ሳዶ። <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />እንም በኖም ጦፎ፤ የተረፈዪም ደቀ መዛሙርተሑ ስበሰቦም ሰበት ሌማት ሙላ ፍርፋሪ ነሶ። <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />የበኖዪ ሰብ እንሽታም ጠቈኘትም ቴይቆጠሮ አርበት ሺ ገሜ ባኖ።<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />ኢየሱስ የሕዝቢ በጌገተ አንቌ በጀልባ ተመጌዶን ገኜ ወረ።<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">ታምር የወዥ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 8:11-13">ማር. 8፥11-13</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12፥54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ፈሪሳውያን ሰዱቃውያንም ተኢየሱሴ ቸኖ፤ ይፌትኖዬ ሸዎም “በሰሜ ታምር አተዥነ” ቲብሮ ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">16፥1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቴ. 12፥38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፥16</ref>። </char></note> <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />ሑቲም እኪ ቲብር ዠበረኖ፦ [“በምሳር ሰሜ ብሻ ኸነም ትታዞ ‘ብራ ይኸን’ ትብሮ፤ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />ቲዛኝ በቅረር ኧሗም ‘ሰሜዪ ዳበና ኸነም ብሻ ኸነም ኧኳ ይዘንብ’ ትብሮ፤ የሰሜዪ መልክ ወላይ ቲሒሮ፤ ቢኸንም የዘበኒ ምልክት ወላይ አትችሎ።]<note caller="+" style="f"><char style="fr" closed="false">16፥3 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ በቁ. 2ም 3 ያነዪ የኢየሱስ ይቡኒ አይጠቅሶ። </char></note> <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ቡሼ ኤያምንም ዝሬት፥ ምልክት የወዥ ይሸ፤ ቢኸንም ተነብዪ ተዮናስ ምልክት አንኸንም እንጐድ ምልክት ኤይᎅ።” በዚ አንቌ ኢየሱስ ገፈረኖም ትንጐድ መደሬ ወረ።<note caller="-" style="x"><char style="xo" closed="false">16፥4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቴ. 12፥39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፥29</ref>። </char></note><verse eid="MAT 16:4" /></para>
  <para style="s1">የፈሪሳውያን የሰዱቃውያንም እርሾ</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8፥14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />ደቀ መዛሙርተሑ ተባር ዛዘሬ በትጌኖ ግዝየ ረሶም እንጄራ አንጠበጦ ባነ፤ <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ኢየሱስ የደቀ መዛሙርተሑ “ሒን ሰክቶ፤ ተፈሪሳውያን ተሰዱቃውያንም እርሾ ተቀሮ” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">16፥6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፥1</ref>። </char></note><verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />ሕኖም “ዚ ወበረሑ ምናልባት እንጄራ ስላንጠበጥነ ይኸን” በወበር ነብስ በነብሰሕኖ ተዝናጎ።<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ኢየሱስም አሳበሕኖ ሐረም እኪ ባረኖ፤ “አሑ እምነት የቀበለናሑ! ‘እንጄራ ያንጠበጥነ ስለኸነው’ ባሑም የመአር ነብስ በነብሳሑ ትዝናጎ? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />ገና አታጥራምቶ ንኩ? አምስት እንጄራ አምስት ሺ ሰብ የኸነኸም የተረፈዪም ትርፍራፊ ምናሕር ሌማት ሙላ የነሳሑኸም አታጥራምቶ?<note caller="-" style="x"><char style="xo" closed="false">16፥9 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">ማቴ. 14፥17-21</ref>። </char></note> <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />ዛምኸም ሰበት እንጄራ የአርበት ሺ ሰብ የኸነኸም የተረፈዪም ትርፍራፊ ምናሕር ሌማት ሙላ የነሳሑኸም አታጥራምቶ?<note caller="-" style="x"><char style="xo" closed="false">16፥10 </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">ማቴ. 14፥17-21</ref>። </char></note> <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />በይሽ ‘ተፈሪሳውያን ተሰዱቃውያንም እርሾ ተቀሮ!’ ባሑም ትኒውድሑ ስለእንጄራ አለወሕነሑ ምንኸም አታጥራምቶ?”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />ደቀ መዛሙርተሑም ኢየሱስ ተቀሮ የባረኖ ተፈሪሳውያን ተሰዱቃውያንም ትምርት አንከንም የእንጄራ እርሾ ያንከነኸም ሐሮ።<verse eid="MAT 16:12" /></para>
  <para style="s1">ኢየሱስ መሲሕ ወሕነሑ ጴጥሮስ ወግልጠሑ</para>
  <para style="r">(<ref loc="MRK 8:27-30">ማር. 8፥27-30</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፥18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />ኢየሱስ የፊልጶስ ቂሣርያ ቲቡሪዪ ክፍለ ገኝ በሰላ ግዝየ የደቀ መዛሙርተሑ “ሰቦች የሰብ ትኸ ሟ ይብሮይ?” ቲብር ተሳለኖ።<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />ሕኖም “አታተሕኖ ‘መጥምቂ ዮሐንስ’ ይብሮ፤ እንጐዲ ‘ኤልያሱ’ ይብሮ፤ እንጐደሕኖ ‘ኤርሚያስ ወይ ተነብዮች አቲው’ ይብሮ” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">16፥14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">ማቴ. 14፥1-2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6፥14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፥7-8</ref>። </char></note><verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />ኢየሱስም “አሑ ይያ ሟ ትብሮኝ?” ባረኖ።<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />ስምዖን ጴጥሮስም፤ “አኸ ክርስቶስ የሕያው የእዝጌር ትኸንከ፤” በወበር ዠበረ።<note caller="-" style="x"><char style="xo" closed="false">16፥16 </char><char style="xt" closed="false"><ref loc="JHN 6:66-69">ዮሐ. 6፥66-69</ref>። </char></note><verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ኢየሱስም እኪ ቧረን፤ “የዮና ትኸ ስምዖን! የትባረክኸንከ፤ ዚ የገለጠንከ በሰሜ ያነዪ አባኛው አንከንም ሰብ አንከነ። <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />እያም እኪ ኧብርከ፤ አኸ (ጴጥሮስ)፥ አለትንከ፤ በዚም የመሠረት እምን ᎈር ቤተ ክርስቲያነኛ ኧሸክት፤ ዚም ቤተ ክርስቲያን የሞት ቆት ኤቌሙን። <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />ዘ፥ ያኸ የሰሜ መንግሥት መፍቻ ይብከ፤ ባፈር ያጐድኰን በሰሜ የታገደ ይኸን፤ ባፈር የᎈታዀን በሰሜ የትፈታ ይኸን።”<note caller="-" style="x"><char style="xo" closed="false">16፥19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቴ. 18፥18</ref>፤ <ref loc="JHN 20:23">ዮሐ. 20፥23</ref>። </char></note> <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />በዛ አንቌ ኢየሱስ የደቀ መዛሙርተሑ ሑቲ ክርስቶስ ወሕነሑ የሟንም ኤይዝነጎኸም ኤዘዘኖ።<verse eid="MAT 16:20" /></para>
  <para style="s1">ኢየሱስ ይሰላወ መከራ ሞትም የመጀመሪያ ግዝየ የዝነጔኸም</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8፥31-33</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፥22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ተዛ ግዝየ ቀረሰም ኢየሱስ የደቀ መዛሙርተሑ እኪ ባረኖ፦ “ተኢየሩሳሌሜ ወወር ነነቢ፤ በዛም ተሽማግሌዎች፥ ተካሕናት አለኦች ተሙሴ ሕጊ አስተማሪዎች መከራ ይሰላቢ፤ ይቀጥሮኝ፤ በሦሥታለኘዪ ከነ ኧትነሣ።”<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />ጴጥሮስም የኢየሱስ ተሜጠቄ ሻᎄንም፤ “ጔታ፤ እኪ ያነ ቃር ስርም ኤስላብከ” ቲብር ይጔስጭ ቀረሰ።<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />ኢየሱስም ተጴጥሮሴ ዞር ባረም፤ “አኸ ሼጣን፤ በዚ ወር! የሰብ አንኸንም የእዝጌር ዘንጋ በአሳባኸ ዬነ ስለኸነ ቈፋ ኸንከቢም!” ቧረን።<verse eid="MAT 16:23" /></para>
  <para style="s1">የክርስቶስ ወትኸተል ያትኬፍል ጄዛ</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">ማር. 8፥34—9፥1</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፥23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />በዛ አንቌ ኢየሱስ የደቀ መዛሙርተሑ እኪ ባረኖ፤ “ይያ ወትኸተል ይሸ የነብሰሑ የልጋ፤ መስቀለሑም የጮርም የትኸተሌ።<note caller="-" style="x"><char style="xo" closed="false">16፥24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቴ. 10፥38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፥27</ref>። </char></note> <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />ሕይወተሑ የዋትርፍ ይሸ እንም ያጠፋ፤ ሕይወተሑ ይያ ያጠፋ ይረሕቡ።<note caller="-" style="x"><char style="xo" closed="false">16፥25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቴ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:25">ዮሐ. 12፥25</ref>። </char></note> <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />ሰብ የዓለም እንም ዱኒያ ቢረሕብ፥ ነብሰሑም ቢያጠፋ፥ ምን ይጠቅሙ? ወይሽ ሰብ የነብሰሑ ሟኔ ምን ጄዛ ይከፍሌ ይችል? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />የሰብ ትኸ ባᎄች ክብር ኸነም ተመላይካጌ ይቸኝ፤ በዛ ግዝየም የያታቲ የሜናሑ ቅጫኸም ጄዛሑ ይከፉል።<note caller="-" style="x"><char style="xo" closed="false">16፥27 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቴ. 10፥39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፥33</ref>፤ <ref loc="JHN 12:25">ዮሐ. 12፥25</ref>። </char></note> <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />የኢን ኧብርሑ፤ የሰብ ትኸ በመንግሥተሑ ክብር ቲቸኝ ያዞ ስን በዚ በቈሞዪ ግብት ኤይᎀቶ ሰቦች ነኖ።”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">የኢየሱስ መልከሑ ሒንጌ ወሠገር</para>
  <para style="r">(<ref loc="MRK 9:2-13">ማር. 9፥2-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፥28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />በስድስት ከነ አንቌ ኢየሱስ የጴጥሮስ፥ የያዕቆብ የያዕቆብ ጐቤ ዮሐንስም ጠለለ አትዄተለም፥ የሟነሑ ታት ወደል ቈቶ ᎈሬ ወጣ።<note caller="-" style="x"><char style="xo" closed="false">17፥1-5 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፥17-18</ref>። </char></note> <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />በዛ ቢፍተሕኖ መልከሑ ተሸገረ፤ ኢፍተሑ የጬትኸም አበራ፤ ልባሰሑ ነጨ ኸነም የብራንኸም አምብራጣ። <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ሙሴ ኤልያስም ተኢየሱስጌ ቲዝናጎ ታዞዮ። <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />ጴጥሮስም የኢየሱስ፤ “ጔታ በዚ ብንኸነ ይና ፈያው፤ ፈአዳኸ በኸነ፤ አት ያኸ አት የሙሴ፤ አት የኤልያስ ሦስት ዳስ ንሰክት” ቧረን።<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />ጴጥሮስ ገና ዚ ቲዝነግ ትናነ የደመቅ ዳበና ሼፈነኖ፤ በዳበናዪ ውስጥ “በሑቲ ኧትብላለቅወ ኧወጅጅ ትኸኛ ዚቱ፤ የሑቲ ስሞይ!” ይብር ጣምባ ቸኘ።<note caller="-" style="x"><char style="xo" closed="false">17፥5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ዘፍ. 22፥2</ref>፤ <ref loc="DEU 18:15">ዘዳ. 18፥15</ref>፤ <ref loc="PSA 2:7">መዝ. 2፥7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፥1</ref>፤ <ref loc="MAT 3:17">ማቴ. 3፥17</ref>፤ <ref loc="MAT 12:8">12፥8</ref>፤ <ref loc="MRK 1:11">ማር. 1፥11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፥22</ref>። </char></note><verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />ደቀ መዛሙርተሑም ዚ ጣምባ በሰሞ ግዝየ ስርም ድነበጦም በግንባረሕኖ ባፈር ወጠቆ። <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />ኢየሱስም ተሕኖዬ ቀረበም በጀሑ ድባበሰኖም “ተንሶ፤ አትጔኖ!” ባረኖ። <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />ሕኖም ቀና ባሮም ቲምሌከቶ ተኢየሱስ አንኸንም እንጐድ ሟንም አነዞ።<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />በቈቶዪ ቲወርዶ ትናኖ ኢየሱስ፦ “የሰብ ትኸ በሞት ይትነሣ ስን ዚ ያዠሑዪ የሟንም አትዘንጎ” ቲብር የደቀ መዛሙርተሑ ኤዘዘኖ።<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />ደቀ መዛሙርተሑም “ኧጌ፥ የሙሴ የሕጊ አስተማሪ በደረም ወተኝ ያነወ ኤልያሱ የመአር ይብሮ?” ቲብሮ የኢየሱስ ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">17፥10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፥5</ref>። </char></note><verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ኢየሱስ እኪ ቲይብር ዠበረኖ፦ “የዮንም፤ ኤልያስማ በደረም ይቸኝ፤ ሑቲ እንመሑ ሱት ይሸኩች። <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />ቢኸንም ኤልያስ ገና ድረ ቸኘም ኧብርሑ፤ ሰቦቺም አንካሮይ፤ ስለኸነም የሸዎዪ እንም ሸከቶᎄ። ዛምኸም ኧሗም የሰብ ትኸ በሕኖ ኧጅ መከራ ወቀበር ነነወ።”<note caller="-" style="x"><char style="xo" closed="false">17፥12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቴ. 11፥14</ref>። </char></note><verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />በዛ ግዝየ ደቀ መዛሙርተሑ ኢየሱስ የዝነጔኒ መጥምቂ ዮሐንስ ወሕነሑ ተሬዶ።<verse eid="MAT 17:13" /></para>
  <para style="s1">ኢየሱስ ጋኔን የጠᎄጠኒ ትኸ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9፥14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፥37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />ኢየሱስ ሦስቲ ደቀ መዝሙር ተሕዝቢዬ በዠበሮ ግዝየ አት ሰብ ተኢየሱሴ ቸኘም በግረሑ ተምብረከከም እኪ ባረ፦ <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“ጔታ! ታውሽ የትኸኛ እዝነ፤ አዙሪት የጋኔን ባሸ ቡሼኸም ያስቋይን፤ ብሳት ᎈር በኧጋም ውስጥ ብዠ ግዝየ ያድጉ። <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ተደቀ መዛሙርታኸዬ አቸኘሑንም ባነ፤ ቢኸንም ፈያ ይሸክቶዬ አንቻሎ።” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />ኢየሱስም “አሑ አታምኖ ጠማማ ጨኘት! መቸ ስን ታሑጌ ኧነብር? መቸ ስንሽ ኧፈርኩሑ? እንዴ ትኸዪ ቲያዬ ናሞይ!” ባረኖ። <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />ኢየሱስ የጋኔኒ ጔሠጠን፤ ጋኔኒም በትኸዪ ውስጥ ወጣ፤ ትኸዪም በዛም ሰዓት ፈያ ኸነ።<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />በዚ አንቌ ደቀ መዛሙርተሑ የቢቶሕኖ ተኢየሱሴ ቀረቦም፦ “ኢና ጋኔኒ የዋውጣ ያንቻልኔ የመአሩ?” ቲብሮ ተሳሎይ። <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />ኢየሱስም እኪ ባረኖ፦ “እምነታሑ የቀበለ ስለኸነው፤ የኢን ኧብርሑ የሰናፍጭ ጢንጦ ቅጫ እምነት ቢነብርሑ ዚ ቈቶ ‘በዚ ተንሳም ተዛዬ ወር!’ ብትብሮይ ያር፤ ይቄምሑ አት ቃር ኤነብር።<note caller="-" style="x"><char style="xo" closed="false">17፥20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቴ. 21፥21</ref>፤ <ref loc="MRK 11:23">ማር. 11፥23</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>። </char></note> <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />ዚኸማቲ ጋኔን በጠሎት በጦም ባንከነ ስርም ኤወጣ።”<note caller="+" style="f"><char style="fr" closed="false">17፥21 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍም ቊ. 21 ይደብሮ፤ ቃሊም በማር. 9፥29 ያነዪ ይመስር። </char></note><verse eid="MAT 17:21" /></para>
  <para style="s1">ኢየሱስ ስለሞተሑ ተሞት ስለወተንሣሑም የዄታለኘ ግዝየ የዝነጔኸም</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9፥30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9፥43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />ደቀ መዛሙርተሑ በገሊላ በስበሰቦ ግዝየ ኢየሱስ እኪ ባረኖ፦ “የሰብ ትኸ በሰቦች ኧጅ አቸለᎉም ይᎅ፤ <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />ሕኖ ይቀጥሮይ፤ ቢኸንም በሦስታለኘዪ ከነ በሞት ይትነሣ።” ደቀ መዛሙርተሑም በዚ ዘንጋ ስርም አዘኖ።<verse eid="MAT 17:23" /></para>
  <para style="s1">የቤተ መቅደስ ግብር ወክፍል</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />ኢየሱስ ደቀ መዛሙርተሑም ቅፍርናሖም በሰሎ ግዝየ የቤተ መቅደስ ግብር ይቄበሮዪ ተጴጥሮሴ ቀረቦም፥ “አስተማሪያሑ የቤተ መቅደስ ግብር ኤከፍል?” ቲብሮ ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">17፥24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ዘፀ. 30፥13</ref>፤ <ref loc="EXO 38:26">38፥26</ref>። </char></note> <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />ጴጥሮስም፤ “ይከፍል አንከንም” ባረኖ። ጴጥሮስ ተቤቴ በገባኸም ኢየሱስ በደረም፤ “ስምዖን፤ የገኝ ነገሥታት ቀረጥ ግብር ይቌበሮም ተነብሰሕኖ ዴንጋ ወይሽ ብንጐደሕኖ ይመስርኸ?” ቧረን። <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />ጴጥሮስም “በውጪ ገኝ ሰቦቹ” ቲብር ዠᎄረነ። ኢየሱስም እኪ ባረ፦ “በይሽ ዴንጋሕኖ ግብር ተወክፍል ነጣኖ ወበሩዋ? <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />ቢኸንም የሕኖ ቈፋ አንኸነቦኸም ተባሬ ወርም መንጠቆ ኧድግ፤ በደረም ይወጣዪ ዓሣ ጥብጥ፤ አፈሑ ትትከፍት በውስጠሑ ዋጋ ትረሕብ፤ ዛም ውስድም ስለእያ ስላኸም ክፍል።”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">ትንም ይበዛ ሟኒ?</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9፥33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፥46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />በዛ ግዝየ ደቀ መዛሙርተሑ ተኢየሱሴ ቀረቦም፦ “በመንግሥተ ሰሜ ትንም ይበዛ ሟኒ?” ቲብሮ ተሳሎይ።<note caller="-" style="x"><char style="xo" closed="false">18፥1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፥24</ref>። </char></note> <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />ኢየሱስም አት ትኸ ጠራም በግብተሕኖ አቈመ፤ <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />እኪም ባረ፦ “የኢን ኧብርሑ፦ ባንትሰገርኩም የትኸዪኸም ባንከንሑ ስርም ተመንግሥተ ሰሜዬ አትገቦ።<note caller="-" style="x"><char style="xo" closed="false">18፥3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር. 10፥15</ref>፤ <ref loc="LUK 18:17">ሉቃ. 18፥17</ref>። </char></note> <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />የዚ ትኸኸም ነብሰሑ ያቴንስ በመንግሥተ ሰሜ ወደል ይኸን። <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />የዚኸም የኸነዪ ትኸ በሽመኛ ይቌᎄር ይያም ይቌበሬ።<verse eid="MAT 18:5" /></para>
  <para style="s1">የሰብ ቈፋ ተወሕን ወትቀየ</para>
  <para style="r">(<ref loc="MRK 9:42-48">ማር. 9፥42-48</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፥1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“ሟንም ሰብ ቢያ ቢያምኖዪ ተዚሕኖ ተቅስስኖቺ አቲ ተዋሰተሑ ወደል የወፍጨ እምን ባንገተሑ አጐጂም ተጥልቅ ባሬ አደጒም ቢሰምጥም ይጠቁል።” <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ቄጠለም ኢየሱስ እኪ ባረ፦ “የሰብ ቈፋ ይኸኖኸም ቢሸክቶዪ ዘንጋ መሳ የዓለም ወዮ ውታ! መቸም ቈፋ ይኸን ቃር ወተኘሕኖ ኤይቀይ፤ ቢኸንም የቈፋ ወተኝ ይኸኒ የዛ ሰብ ወዮ ውታ! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />ስለኸነ ወይ ኧጃኸ ኧግራኸ አጢያት ትሸክትኸም ቢያሰትከ ኧርጥም ተዛዬ ኧድጉ! ዄት ኧጅ ወይ ዄት ኧግር ነበረናኸም ተዘለዓለም ኧሳቴ ቢያድጉከ ይጠቅል ቈማጣ ወይ ሸንካላ ኸንከም ተዘለዓለም ሕይወቴ ወግባ ይጠቅልከ።<note caller="-" style="x"><char style="xo" closed="false">18፥8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቴ. 5፥30</ref>። </char></note> <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />ዔናኸም አጢያት ይሸክትኸም ቢያሰትከ አውጣም ተዛዬ ኧድጉ! ዄት ዔን ነበረናኸም ተፍርድ ኧሳቴ ቲያድጉከ ይጠቅል ቁና ዔን ኸንኸም ተዘለዓለም ሕይወቴ ወግባ ይጠቅልከ።<note caller="-" style="x"><char style="xo" closed="false">18፥9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቴ. 5፥29</ref>። </char></note> <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" />በሰሜ ያኖዪ መላይካሕኖ እንጌ በሰሜ ያነዪ የአባኛ ኢፍት ያዞ ስለኸነ ተዚ ቅስስኒ አቲም አትነቆኸም ተቀሮ። [<verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />የሰብ ትኸ የቸኘ የጠፋዪ የዋትርፉ።”] <note caller="+" style="f"><char style="fr" closed="false">18፥11 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 11 ይደብሮው፤ ጣምባዪም በሉቃ. 10 ያነዪም ይመስር። </char></note><note caller="-" style="x"><char style="xo" closed="false">18፥11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19፥10</ref>። </char></note><verse eid="MAT 18:11" /></para>
  <para style="s1">ጠፋም የትረከበዪ ኧጤ ምሳሌ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15፥3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />ኧሗም ኢየሱስ እኪ ባረ፦ “እንዴ ምን ይመስርሑ? አት ሰብ መቶ ኧጤ ቢነብሮይ ተዛ አቲ ቢጠፋወ ዘጠና ዠጠዪ በቈቶ ᎈር ገፈረም የጠፋዪ አቲ የወሴ ኤያር? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />የኢን ኧብርሑ፤ በረከᎄን ግዝየ ታንጠፎዪ ተዘጠና ዠጠዪ የጠቀለ ጠፋም በትረከበዪ ኧጤ ይትብላለቅ። <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />የዛምኸም በሰሜ ያነዪ አባሑ ተዚ ተቅስስኖቺ አቲ ይጠፋኸም ኤይሸ።<verse eid="MAT 18:14" /></para>
  <para style="s1">የቤደለ ሰብ ምን ወሰክት ይጌባኸም</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“ጐቤአኸ ቢቤድልኸ አኸም ሑቲም የቢቶአሑ ሕኖማሑ በደለሑ አውጅ፤ ቢሰማኸ ዠበርኸም ጐቤአኸ ይኸንኸም ትሸኩች፤<note caller="-" style="x"><char style="xo" closed="false">18፥15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17፥3</ref>። </char></note> <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />ቤሰማኸም የዄት ወይ የሦስት ሰቦች ምስክርነት ይጠና ስለኸነ ዄት ወይ ሦስት ሰቦች ጥብጥም ተሑቲዬ ወር።<note caller="-" style="x"><char style="xo" closed="false">18፥16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ዘዳ. 19፥15</ref>። </char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />የሕኖም አንሰማ ቢብር የቤተ ክርስቲያን አውድ፤ የቤተ ክርስቲያን ኤይሰማ በኸነ ያረመኔኸም ተውዘገበም ኤዠበርኸም የአጢያተኛኸም ቆጥር።<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“የኢን ኧብርሑ፤ ባፈር ታግዶዪ በሰሜ ኧጉጀኘ ይኸን፤ ባፈር ትፈቶዪም በሰሜ የትፈታ ይኸን።<note caller="-" style="x"><char style="xo" closed="false">18፥18 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቴ. 16፥1</ref>፤ <ref loc="LUK 20:23">ሉቃ. 20፥23</ref>። </char></note> <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />ኧሗም ኧብርሑ፤ ታሑ ዄቲ ባፈር ᎈር ሟንም ቃር የወጮቅስ ተስማሞም ቢጤልዮ፥ በሰሜ ያነዪ አባኛ ይፌጥምኖ። <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />ዄት ወይ ሦስት ኸኖም በሽመኛ ቢስበሰቦᎄ መደር እያ በግብተሕኖ ኧትረከብ።”<verse eid="MAT 18:20" /></para>
  <para style="s1">አፉታ ስለወሰክት</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />በዛ ግዝየ ጴጥሮስ ተኢየሱሴ ቀረበም፦ “ጔታ! ጐቤኛ ቢቤድሌ ምናሕርጌ አፉ ንᎄን? ሰበትጌ ስን የሕን?” ቲብር ተሳለን።<note caller="-" style="x"><char style="xo" closed="false">18፥21-22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17፥3-4</ref>። </char></note><verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />ኢየሱስም እኪ ቧረን፦ “ሰባጌ ሰበት ስን አንከንም ሰበትጌ ስን ጠለለ አንብርኸ፤<note caller="-" style="x"><char style="xo" closed="false">18፥21-22 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17፥3-4</ref>። </char></note> <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />ስለኸነም የመንግሥተ ሰሜ ታገልጋዮቸሑጌ ይትሳሰቤ የሸ ንጉሥ ይመስር፤ <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />ንጉሢ ወትሳሰብ በቀረሰ ግዝየ በብዠ ሺ መክሊት<note caller="+" style="f"><char style="fr" closed="false">18፥24 </char><char style="fqa" closed="false">መክሊት፦ </char><char style="ft" closed="false">አት መክሊት በዛ ግዝየ የ 15 ዓመት የከነ ሜነተኘ ቢከፉሊዪ ደሞዝ በነኔ ባነ። </char></note> ይቆጠር ኧድጉት ያነወ አት አገልጋይ ጠᎄጭም አቸኚ። <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />ዚ አገልጋይ ኧድጉተሑ ወዘብር ስላንቻለ ሑቲም፥ ምሽተሑ ዴንጋሑም ያነንም ዱኒያ እንም አስሬም ኧድጉተሑ ይከፉሊኸም ጌቶቸሑ ኤዘዘን። <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />አገልጋዪም በጌቶቸሑ ኧግር ተት ተንምብረከከም ‘ጌቶች! ታውሽ ፍርኬ፤ እንመሑ ኧከፍልኸ!’ ቲብር ጮቈሰን። <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ጌቶቸሑም አዘነነም ገᎈረን፤ ኧድጉተሑም ገᎈረነ።<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“ቢኸንም ዛ አገልጋይ በዛ ወጣም ቲያር ትናነ መቶ ዲናር<note caller="+" style="f"><char style="fr" closed="false">18፥28 </char><char style="fqa" closed="false">ዲናር፦ </char><char style="ft" closed="false">የአት የከነ ሜነተኘ የአት ከነ ደሞዙ። </char></note> ያታደጐኒ የሜና መራርቻሑ ረከᎄንም አንገተሑ አነቀም ጠበጠም፥ ‘ያታደገከኸዪ ዋጋ ክፈሌ!’ ቧረን። <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />አገልጋዪ መራርቻሑም በግረሑ ተት ወጠቀም ‘ታውሽ ፍርኬ፤ ኧከፍልኸ!’ ቲብር ጮቈሰን። <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />ምሲም ኤᎄሑ ቧረን። ዛምኸም ጠᎄጠንም ወረም ኧድጉተሑ ይከፍል ስን በወሕኔ ቤት አቴጐደን። <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />የሑቲኸም ያኖ እንጐድ የሜና መራርቻሑ ዚ ባዞ ግዝየ ስርም አዘኖ፤ ወሮም የኸነዪ እንም የጌቶቸሕኖ ኤወዶይ። <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />ጌቶቺም የዛ አገልጋይ አጤራንም እኪ ቧረን፦ ‘አኸ ቡሼ አገልጋይ! ስለጮቀስኬ ዛ እንም ኧዳ ገፈረክንከም፤ <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ኧጌ፥ እያ ኧድጉታኸ የገፈርኩንከኸም፥ አኸሽ ደቦአኸ የኸነዪ አገልጋይ ኧድጉተሑ ትገፉርነዬ ኤጌባኸ ባነ?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />ስለኸነም ጌቶቸሑ ማቸም ኧድጉተሑ እንም ይከፉል ስን የወሕኔ ቤቲ አላፊ አቸለፈም አᎄን።<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“ኧጌሽ አሑ አትባታሑ የጐቤያኹ ተሒን አፉ ባትብሮይ በሰሜ ያነዪ አባኛም ዛምኸም ይሸክትብኩ።”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">ኢየሱስ ስለ ጋብቻ ዋትመረሑ</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10፥1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />ኢየሱስ ዚ ዝነጔም በፈጀ አንቌ በገሊላ ተነሳም፥ በዮርዳኖስ ኧጋ ዛዘር ቲትረከቢ ተይሑዳ ገኜ ወረ። <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ብዠ ሕዝብም ተዄተሎይ፤ ተሕኖም የታቆዪ በዛ ፈያ ሸከተኖ።<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />በዛ ግዝየ ፈሪሳውያን ተሑቲዬ ቀረቦም ይፌትኖዬ ሸዎ፥ “ሰብ ምሽተሑ በሟንመሑ መሳ ይፈታኸም ይፌቈድነ?” ቲብሮ ተሳሎይ።<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እዝጌር ቢፍቴ ምስ ተምሽት ሸከተም የኸለቀኖኸም አናምበብኩ?<note caller="-" style="x"><char style="xo" closed="false">19፥4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ዘፍ. 1፥27</ref>፤ <ref loc="GEN 5:2">5፥2</ref>። </char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ኧሗም ‘በዚ መሳ ሰብ አᎄች ዳኰችም ገፈረም ተምሽተሑጌ ቁናዬ ይኸኖ፤ ዄቲም ቁና ገግ ይኸኖ’<note caller="-" style="x"><char style="xo" closed="false">19፥5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ዘፍ. 2፥24</ref>። </char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />ስለኸነም ሕኖ ተሗ ቀረሰም ቁና ጅስምኖ አንኸንም ዄት አንኸኖ። ቢኸንም ጔታ ቁና የሸኰተኒ ሰብ ኤላኝን።”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />ፈሪሳውያንም “እጌ፥ ሙሴ የመአር ‘ምስ የምሽተሑ ይፈታናዬ የምስክር ወረቀት ያብም የፍታና’ ይብር?” ባሮይ።<note caller="-" style="x"><char style="xo" closed="false">19፥7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ዘዳ. 24፥1-4</ref>፤ <ref loc="MAT 5:31">ማቴ. 5፥31</ref>። </char></note><verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ኢየሱስም እኪ ባረኖ፦ “ሙሴማ ምሽታሑ ትፈቶኸም የፈቀደንኩ ሒናሑ ድነደነም ታትሜኮ በወሕናሑ መሳው፤ በመጀመሪያ እኪ አነበረ።<verse eid="MAT 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 19:9" />“እያም፥ ‘ቁና ሰብ በወማግጥ መሳ ባንከነ አንኸንም ምሽተሑ ፈታም ኧንጐድ ምሽት ቢያገባ ሟገጠም’ ኧብርሑ።”<note caller="-" style="x"><char style="xo" closed="false">19፥9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቴ. 5፥32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፥10-11</ref>። </char></note><verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />ደቀ መዛሙርተሑም “የምስ ተምሽት ዘንጋ እኪ በኸነ አለዋግባ ይጠቅል” ባሮይ።<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ኢየሱስም እኪ ባረኖ፦ “ዚ ዘንጋ የትለየ ቆት ያቡዮዪ አንኸንም ይንም ኤይኸን። <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />ሱልᎄኘ ኸኖም የጨኖ ነኖ፤ ሰብ የሰለበኖ ነኖ፤ የመንግሥተ ሰሜ ቲብሮ ነብሰሕኖ የሱልᎄኘኸም የሸከቶ ነኖ፤ ስለኸነም ዚ ይቌበር ይችል የቀᎄን።”<verse eid="MAT 19:12" /></para>
  <para style="s1">ኢየሱስ ጠቌኘቲ የባረከኖኸም</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10፥13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፥15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />በዛ ግዝየ ኧጀሑ በᎈረሕኖ ጫነም ይጤልልኖኸም ሰቦች ጠቌኘቲ ተኢየሱሴ አቸኖ፤ ደቀ መዛሙርተሑም የሰቦቺ ጌሠጦዮ። <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />ኢየሱስም፦ “መንግሥተ ሰሜ የዚሕኖኸም ያኖዪ የኸኖ ስለኸነ ጠቌኘቲ ግፍሮዮ፤ ቲያዬ የተኖ፤ አትሕትሮዮ” ባረ፤ <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />ኧጀሑም በጫነቦ አንቌ በዛ መደር ተቸለፈም ወረ።<verse eid="MAT 19:15" /></para>
  <para style="s1">የዓለም ዱኒያ የሰሜ መንግሥትም</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10፥17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፥18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />አት ከነ አት ሰብ ተኢየሱሴ ቸኘም፦ “አስተማሪ! የዘለዓለም ሕይወት የወርሕብ ምን ፈያ ዘንጋ ወሰክት ይጌቤ?” ቲብር ተሳለን።<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ኢየሱስም “ስለ ፈያ ዘንጋ የመአር ትሰሌ? ፈያ የኸነ አት አምላክ ጠለለው፤ ተሕይወቴ የወግባ ብትሸ ትዛዞቺ ፈጥም” ቧረን።<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ምሲም “ኤትሕኖ ትዛዝ?” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">19፥18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ዘፀ. 20፥13-16</ref>። </char></note></para>
  <para style="p" vid="MAT 19:18">ኢየሱስም እኪ ቲብር ዠᎄረነ፦ “አትቅጥር፤ አትሟግጥ፤ አትስርቅ፤ በባጢል አትመስክር፤ <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />አባኸ ዳኳኸም አክብር፤ ኦላኸ የነብሳኸኸም ሰክትማኸ ውጅጅ፤ ይብሮዪ ትዛዝኖ” ቧረን።<note caller="-" style="x"><char style="xo" closed="false">19፥19 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ዘፀ. 20፥13-16</ref>። </char></note> <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />አርዴዪም “ነዚማ ትዛዞች ፌጠምኩም፤ እንጐድሽ ይቀብሌ ቃር መአሩ?” ባረ።<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ኢየሱስም “ፍጡም ወሕን ብትሸ ወርም ያነናኸዪ አሰየም ዋጋዪ የዜጋ አብ፤ በሰሜ ዱኒያ ትረሕብ፤ ኔኸም ተኸተሌ” ቧረን።<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />አርዴዪም ብዠ ዱኒያ ቧነን ዚ በሰማ ግዝየ ቲያዝን ወረ።<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />በዛ አንቌ ኢየሱስ የደቀ መዛሙርተሑ እኪ ባረኖ፦ “የኢን ኧብርሑ፤ የዱሬሻ ሰብ ተእዝጌር መንግሥቴ ወግባ ስርም ይረዙ። <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />ኧሗም ኧብርሑ፥ ዱሬሻ ሰብ ተእዝጌር መንግሥቴ ተወግባሑ የጠቀለ ጋሜላ በመርፍ ጉድ ቢቸለፍ ይቀል።”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ደቀ መዛሙርተሑ ዚ በሰሞ ግዝየ ስርም ተጌረሞም “እጌ፥ ሟ ይተርፌ ይችል?” ባሮይ።<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ኢየሱስ ተሕኖዬ ተምሌከተም “ዚ ዘንጋ የሰብ ኤይቸል ቃሩ፤ የእዝጌር እንም ይቸል” ባረ።<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />በዛ ግዝየ ጴጥሮስ “ዘ፥ ኢና እንም ገፈርነም ተዄተልነከም፤ ኧጌ፥ ኧረሕብኔዪ መአር ይኸን?” ባረ።<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ኢየሱስም እኪ ባረኖ፦ “የኢን ኧብርሑ፤ የሰብ ትኸ በክብር ዙፋን ᎈር ቢቾናወ በገደሪ ዓለም ይያ ተከታይ የኸንሑ፥ አሑ፥ በዐሥረ ዄቲ ዙፋን ᎈር ትቾኖ፤ በዐሥረ ዄቲም የእስራኤል ጐሳ ᎈር ትፈርዶ።<note caller="-" style="x"><char style="xo" closed="false">19፥28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቴ. 25፥31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22፥30</ref>። </char></note> <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />ስለእያ ባረም ቤተሑ፥ወይ ጐባቢተሑ፥ወይ ኧተሟᎁተሑ፥ወይ አᎄች፥ ወይ ዳኰች፥ ወይ ዴንጋሑ እርሻሑ የገፈረ እንም መቶ እጥፍ ይቌበር፤ የዘለዓለም ሕይወትም ይረሕብ። <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />ቢኸንም ኧሗ የበደሮ የኸኖ ብዠሕኖ ያንቌ ይኸኖ፤ ያንቌ የኸኖዪ የበደሮ ይኸኖ።”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">የወይን አታሕልት ሜነተኞች ያወልᎄ ምሳሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“መንግሥተ ሰሜ በወይኒ አታሕልት መደር ይሸክቶዪ ሜነተኞቺ የወቅጥር ቅረር በሱቢ የወጣዪ የአታሕልት ባለቤት ይመስር። <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />ሑቲ አትባተሑ በከነ አት ዲናር ይከፍሌ ተወወለም፥ ሜነተኞቺ ተወይኒ አታሕልት መደሬ ላኸኖ። <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />ሑቲም በሦስት ሰዓት ገደማ ወጣም፥ ሜና ፈቶም በጠባ የቈሞዪ እንጐድ ሰቦች አዠ፤ <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />‘አሑም ተወይን አታሕልት መደሬ ወሮም ሰክቶ፤ ይጌባሑዪ ዋጋ ኧከፍልሑ’ ባረኖ። <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />ሕኖም ተወይን አታሕልት መደሬ ወሮ፤ ኧሗም በስድስት ሰዓት በዠጠ ሰዓትም ገደማ ወጣም ዛምኸም ሸከተ። <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />በዐሥራት ሰዓት ገደማ ወጣም እንጐድ ሰብ ቈሞም ረከበም ‘አሑሽ ከነዪ ሙላ ሜና ፈታሑም በዚ የቈምኩ የመአሩ?’ ቲብር ተሳለኖ። <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />ሕኖም ‘ያወለነ ሰብ ቀበጥነሙ’ ባሮይ፤ ሑቲም ‘ኧጌሽ፥ አሑም ተወይኒ አታሕልት መደሬ ወሮም ሰክቶ’ ባረኖ።<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“በመሸ ግዝየ የወይኒ አታሕልት ባለቤት የሜና አላፊዪ ‘የሜነተኞቸሑ ጥራ በመጨረሻም ታወልዮዪ ቅርስም ቢፍቴ ያወልዮ ስን የሜና ዋጋሕኖ ክፍሎ’ ቧረን።<note caller="-" style="x"><char style="xo" closed="false">20፥8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ዘሌ. 19፥13</ref>፤ <ref loc="DEU 24:15">ዘዳ. 24፥15</ref>። </char></note> <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />ስለኸነም በዐሥራት ሰዓት ያወልዮዪ ቀረቦም አትባተሕኖ ቁና ዲናር ተቌበሮ። <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />ቢፍቴ የዋሎዪ በቀረቦ ግዝየ ይበዛ ይቌበሮ መሰረኖም ባነ፤ ቢኸንም ሕኖም አትባተሕኖ የከነ ዋጋሕኖ ተቌበሮ። <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />ዋጋዪ ተቌበሮም በወይኒ አታሕልት ባለቤት ᎈር እኪ ቲብሮ ቁምቁሜ ባሮ፤ <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘ሕኖም በመጨረሻ ቸኖም የሸከቶ የቁና ሰዓት ጠለለው፤ ቢኸንም ከነዪ ሙላ በጬት ቲጥበጥብነ ዋልነ በሜና ትንለፋነ ተዋልነዪ ቲናጌ ቂጦ ሸከትከኖ።’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />የወይኒ አታሕልት ባለቤትም ተሜነተኞቺ የአቲ እኪ ቲብር ዠᎄረነ፤ ‘ደቦኛ! አትም አንበደልከኸ፤ የትወወልነዪ በከነ ቁና ዲናር ኧከፍልኸዬ አንከነ? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />ስለኸነም ይሰላኸዪ ጥብጥማኸ ወር፤ ያኸ ያብከኸዪ ቅጫ የዚ ያንቌዋኘዪም ኢᎆ ፌቀድኩም። <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />በፎለኛ ዋጋ የሸሑኒ ወሰክት መብት ኤኔ? ወይሽ እያ ዋቢ ስለኸንኩ አኸ ትምቀኝ?’ ”<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />በዛ አንቌ ኢየሱስ “የዛምኸም ያንቌ የኸኖዪ የበደሮ፥ የበደሮ የኸኖዪ ያንቌ ይኸኖ፤” ባረ።<note caller="-" style="x"><char style="xo" closed="false">20፥16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቴ. 19፥30</ref>፤ <ref loc="MRK 10:31">ማር. 10፥31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፥30</ref>። </char></note><verse eid="MAT 20:16" /></para>
  <para style="s1">ኢየሱስ ስለሞተሑም ተሞት ወተንሣሑ የአምስታለኘ ግዝየ ወዘንጔሑ</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10፥32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፥31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />በዛ አንቌ ኢየሱስ ተኢየሩሳሌሜ ያር ባነ፤ ቤማም ትናኖ ዐሥረ ዄቲ ደቀ መዝሙር የሟነሕኖ ተሑቲዬ ወሰደም እኪ ባረኖ፤ <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“ዘ፥ ኧሗ ኢየሩሳሌም ወወረናው፤ በዛም የሰብ ትኸ የካሕናት አለኦቺ የሙሴ የሕጊ አስተማሪዎችም አቸለᎉም ይᎅ፤ ሕኖም የሞት ፍርድ ይፈርዶᎄ። <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />የአሕዛብ አቸለፎም ይቦይ፤ ሕኖም ያፌዞᎄ፤ ይገርፎይ፤ ይሰቅሮይ፤ በሦስታለኘዪም ከነ ተሞት ይትነሣ” ባረኖ።<verse eid="MAT 20:19" /></para>
  <para style="s1">የዘብዴዎስ ዴንጋ ዳኮ ጩቈሸ</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10፥35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />በዛ አንቌ የዘብዴዎስ ዴንጋ ዳኮ፥ ተዴጋዬታንጌ ተኢየሱሴ ቀረበችም ቢፍተሑም ተምብረከከችም አት ቃር ይሸክትናኸም ጮቀሰቹ። <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />ኢየሱስም “መአር ትሸ?” ባረና። ሒቲም “በመንግሥታኸ ነዚ ዄቲ ዴንጋኛ አቲ በከናኸ፥ አቲ በጉራኸ ይቾኖኸም ሰክትኒ!” ባረቹ።<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ኢየሱስም “አሑ ትጮቅሶዪ አቲሒሮ፤ እያ በቁርብ ግዝየ ኧሰጭን የመከራ ጥወ ወስጭ ትችሎ?” ባረኖ። ሕኖም “ኤክ ኧችልነ?” ባሮ።<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ኢየሱስም “የኢንም እያ ኧሰጭኒ የመከራ ጥወ ትሰጦ፤ ቢኸንም ሰቦች በከነኛ በጉራኛም ይቾኖኸም ኧሸኩቺ እያ አንከንሑ፤ ዚ መደር ይᎅ አባኛ ያዝጋጀኖ ሰቦችኖ።”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />የቀኖዪ ዐሥሪ ደቀ መዝሙር ዚ ጡቈሸ በሰሞ ግዝየ በዄቲ ጐባቢት ᎈር ማቶ። <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />ኢየሱስም ይንም ጠራም እኪ ባረኖ “የአሕዛብ አለኦች የሕዝበሕኖ ገዢኖ፤ መሪዎቸሕኖም በሕኖ ᎈር ሥልጣን ያነኖኸም ቲሒሮ። <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />ባሑሽ ግብት እኪ ወሕን ኤጌባ። ቢኸንም ባሑ ግብት ወደል ወሕን ይሸ ያሑ አገልጋይ የሕን። <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ዛምኸም ታሑ ነን ወደል የወሕን ይሸ ያሑ ጉዝ የሕን።<note caller="-" style="x"><char style="xo" closed="false">20፥27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቴ. 23፥11</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>። </char></note> <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />የሰብ ትኸ የዋገልግል ብዠሕኖም የዋትርፍ ሕይወተሑ አቸለፈም የዋብ ቸኘ አንኸንም ያግለግሎይኸም አንተኘ።”<verse eid="MAT 20:28" /></para>
  <para style="s1">ኢየሱስ ዄት ወዥ ኤይችሎዪ ፈያ ወሰክተሑ</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10፥46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፥35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />በዛ አንቌ ተኢያሪኮ ወጦም ቲያሮ ብዠ ሕዝብ የኢየሱስ ተዄተሎይ። <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />ዘ፥ ቤማ ᎀረ የቾኖ ዄት ወዥ ኤይችሎ በዛ ኤማ ይቼለፊ ኢየሱስ ወሕነሑ በሰሞ ግዝየ፥ “ጔታ የዳዊት ትኸ! ታውሽ ማረነ!” ቲብሮ ው ባሮ።<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />ሕዝቢም “እንቁስ በሮ!” ባሮም ጌሠጦዮ፤ ሕኖም “የዳዊት ትኸ ጔታ! ታውሽ ማረነ!” ቲብሮ አበዞም ው ባሮ።<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />ኢየሱስም ቈመም ጠራኖም “መአር ኧሸክትንኩኸም ትሸዎ?” ባረኖ።<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />ሕኖም “ጔታ! ኤነና ይትከፈትኸም ሰክትንነ!” ባሮይ።<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />ኢየሱስም አዘነኖም ዔነሕኖ ድባበሰም፤ ሒንጌም ዔነሕኖ አዞ፤ ሕኖም የኢየሱስ ተዄተሎይ።<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">ኢየሱስ በወደል ክብር ተኢየሩሳሌሜ ወግባሑ</para>
  <para style="r">(<ref loc="MRK 11:1-11">ማር. 11፥1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፥28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሐ. 12፥12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />ኢየሩሳሌም ይቀርቡᎄ ደብረዘይት ቈቶ ᎈር ቢትረከቢ ቤተ ፋጌዬ ትይቡሪ መንደሬ የሰሎኸም፤ ኢየሱስ ዄቲ ደቀ መዝሙር ላኸ፤ <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“ቢፍታሑ ታነዪ መንደሬ ወሮ፤ በዛም አት ያጐጂ ኧማር ተደርማውታን ሒንጌ ትረሕቦ፤ ፍቶም ናሞኒ። <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />ሟንም ሰብ አት ቃር ቢብርሑ ‘ጔታ ይሸኖ ስለኸነው’ በሮይ። ሑቲም ኧማሪ ሒንጌም ይለኮ።” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />ዚም የኸነዪ በነብይ እኪ ቧሪም የዝነጔኒ ይትፌጠምኸሙ፦<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“የጽዮን ትኸ እኪ በሮይ፤</para>
  <para style="q2" vid="MAT 21:5">‘ዘ፤ ንጉሳኸ ደቁና ቀልብ ኸነም፤ ብማሪ በደርማዪም፤</para>
  <para style="q2" vid="MAT 21:5">ᎈር ቾናም ታኸዬ ይቸኝ።’ ”<note caller="-" style="x"><char style="xo" closed="false">21፥5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዘካ. 9፥9</ref>። </char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />ደቀ መዛሙርቲም ወሮም ኢየሱስ ዬዘዘኖኸም ሸከቶ። <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />እማሪም ተደርማውታን አቸኖነ፤ ልባሰሕኖ ብማሪ ጊንዠ ᎈር አወኖ፤ ኢየሱስም በዛ ᎈር ቾና። <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />ተሕዝቢም ብዠሕኖ ልባሰሕኖ ቤማ ᎈር ጬጮ፤ እንጐዲ ኧሗም የጨ ጫፍ ቲᎂጥሶ ቤማ ᎈር ይጉዘጉዞ ባነ። <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />ተሕዝቢም ኢፍት ሊፍት ያሮ የነበሮዪም ባንቌ ይትዄተሎ የነበሮዪ፥ “ሖሳዕና የዳዊት ትኸ ምስጋናኸ የሕን! በጔታ ሽም ይቸኝ የትባረከው! ሖሳዕና!<note caller="+" style="f"><char style="fr" closed="false">21፥9</char><char style="fqa" closed="false">ሖሳዕና፦ </char><char style="ft" closed="false">በዕብራይስጥ ቋንቋ ወትርፍ፥ ታውሽ አትርፍነ ወበሩ። </char></note> ምስጋናኸ በነኔ በሰሜ የእዝጌር የሕን!” ቲብሮ ው ይብሮ ባነ።<note caller="-" style="x"><char style="xo" closed="false">21፥9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">መዝ. 118፥25-26</ref>። </char></note> <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />ኢየሱስ ኢየሩሳሌም በገባ ግዝየ የከተማዪ ሰቦች እንም “ዚ ሟኒ?” በወበር ተሬበሾ። <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />ሕዝቢም “ዚ በገሊላ ገኝ ይትረከቢ ተናዝሬት ከተማ የቸኘ ነብዪ ኢየሱስ” ባሮ።<verse eid="MAT 21:11" /></para>
  <para style="s1">ኢየሱስ በቤተ መቅደስ ይግባዮዪ ያትዌጣኸም</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11፥15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፥45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሐ. 2፥13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />በዛ አንቌ ኢየሱስ ተቤተ መቅደሴ ገባ፤ በዛም ያስሮዪ ይስሮዪም ሰቦች እንም አትዌጣ። ዋጋ ይሸግሮዪ ጠረቤዛ ቡላልም ያስሮዪም ወንበር ግለበጠ። <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />“‘ቤተኛ የጠሎት ቤት ይቡሪ’ ቧሪም ተጣፈም፤ አሑም የዘራፊ ዋሻ ሸከትኩይ!” ባረኖ።<note caller="-" style="x"><char style="xo" closed="false">21፥13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፥7</ref>፤ <ref loc="JER 7:11">ኤር. 7፥11</ref>። </char></note><verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />ኢየሱስ በቤተ መቅደስ ትናነ ወዥ ኤይችሎዪ የሽናወሎዪም ተሑቲዬ ቸኖም ፈያ ሸከተኖ። <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />ቢኸንም የካሕናት አለኦች የሙሴ የሕጊ አስተማሪም ኢየሱስ የሸኰተኒ ድንቅ ቃር በወዠሕኖም ጠቈኘቲም በቤተ መቅደስ “የዳዊት ትኸ ሖሳዕና! ምስጋናኸ የሕን” ቲብሮ ው ቲብሮ በወስማሕኖ ማቶም። <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />ስለኸነም የኢየሱስ “ነዚ ጠቈኘት ይብሮዪ ትሰማ?” ባሮይ፤ ሑቲም “ኤክ፥ ኧሰማ፤ ‘ተዴንጋዪ ቲጦቦዪ ጠቈኘትም አፍ ምስጋናኸ አዝጋጀኸም’ ይብሪ ስርም አናምበብኩ ወይ?” ባረኖ፤<note caller="-" style="x"><char style="xo" closed="false">21፥16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">መዝ. 8፥2</ref>። </char></note> <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />ገፈረኖም ተከተማዪ ወጣ፤ ተቢታንያዬም ወረም በዛም ዐደረ።<verse eid="MAT 21:17" /></para>
  <para style="s1">ኢየሱስ የሰደᎄኒ የበለስ ኧጨ</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11፥12-14</ref>፣<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />ኢየሱስ ቅረር በሱቢ፥ ተከተማዬ ተዠበረም ቲያር ጓደን፤ <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />አት የበለስ ኧጨ ቤማ ᎀረ አዠም ተሑቲዬ ወረ፤ ቢኸንም ተቅጠል አንኸንም አትም አረኸበ። ስለኸነም “ተሗ ቀረሰም ስርም ፍርየ ኤትረኸብብከ!” ቧረን። ኧጨዪም ሒንጌ ጠረቀ። <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />ደቀ መዛሙርተሑ ዚ ባዞ ግዝየ፥ “ዚ የበለስ ኧጨ በቁናጌ ምንኸም ጠረቀ!” በወበር ተጌረሞም። <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />ኢየሱስም እኪ ቲብር ዠበረኖ፤ “የኢን ኧብርሑ፤ እምነት ቢነብርሑ ባትጥራጠሮ በበለሲ ኧጨ ᎈር የሸከተኸም ወሰክት ጠለለ ቴይኸን ዚ ቈቶ ‘በዚ ተንሣም ተባሬ ተረግ!’ ብትብሮይ ይኸንኩ።<note caller="-" style="x"><char style="xo" closed="false">21፥21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቴ. 17፥20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፥2</ref>። </char></note> <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />አመንኩም በጠሎት ትጮቅሶዪ እንም ትረሕቦ።”<verse eid="MAT 21:22" /></para>
  <para style="s1">ኢየሱስ በምን ሥልጣን ይሸክትኸም የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11፥27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፥1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ኢየሱስ ተቤተ መቅደሴ ገባም ያትመር ባነ። በዛ ግዝየ የካሕናት አለኦች የሕዝብ ባሊቆች ተውቲዬ ቀረቦም “ዚ እንም ትሸክት በምን ሥልጣኑ? ዚ ሥልጣን ያበናኸሽ ሟኒ?” ቲብሮ ተሳሎይ። <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “እያም አት ጥያኤ ኧሰልኩ፤ የጥያኤኛ መልስ ባብኩኝ እያም ዚ እንም በምን ሥልጣን ኧሸክትኸም ኢውድሑ። <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />የዮሐንስ ጥምቀት ቤቴ ቸኘ? በእዝጌር ባነ ወይሽ በሰብ?” ሕኖም ነብስ በነብሰሕኖ እኪ ቲብሮ ተማከሮ፤ “‘በእዝጌሩ’ ብንብርነ ‘ኧጌ የመአር አነመንኩይ’ ይብርነ፤ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />‘በሰቡ’ ብንብርነ ኧሗም፥ የዮሐንስ እንም የነብይኸም ያዞይ ስለኸነ፥ ሕዝቢ ኧጔናነ።” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />ስለኸነም “አንሒርነ” ቲብሮ የኢየሱስ ዠበሮነ። ሑቲም “ኧጌሽ እያም በመአር ሥልጣን ዚ እንም ኧሸክትኸም አንዊድሑ” ባረኖ።<verse eid="MAT 21:27" /></para>
  <para style="s1">የዄቲ ዴንጋ ምሳሌ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />ቄጠለም ኢየሱስ እኪ ባረኖ፦ “ኧጌ መአር ይመስርሑ? አት ሰብ ዄት ዴንጋ ባኖይ፤ ተሕኖ ታቲዬ ቀረበም፥ ‘ትኸኛ፥ ኧኳ ተወይን አታሕልት መደረኛዬ ወርም ትሸክትኸም የሕን’ ቧረን። <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />ትኸዪም ‘እንምቢ አናር’ ባረ። የሕን አንከንም ባንቌ ተውዘገበም ይሸክቴ ወረ። <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />አᎄችም ተዄታለኘዪ ኧርጀዄ ኧሗም ወረም የሑቲም ዛምኸም ይሸክትኸም ኤዘዘን፤ ትኸዪም ‘የሕን አባኛ አር’ ባረ። ቢኸንም አወረ። <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />በሒሽ ተዚ ተዄቲ ያᎄች ፈአድ የፌጠᎀኒ ኤቲዋኘው?”</para>
  <para style="p" vid="MAT 21:31">ሕኖም “የመጀመሪያዪ ዋ!” ባሮ። ኢየሱስም እኪ ባረኖ፦ “የኢን ኧብርሑ፤ አጢያተኞችም ዘማውያንም ተመንግሥተ ሰሜዬ በወግባ ይበድሮኩ። <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />መጥምቂ ዮሐንስ የጽድቅ ኤማ ያቴዥሑዬ ቢቸኝ አነመንኩይ፤ አጢያተኞች ዘማውያንም አመኖይ፤ ዚም አዠሑም ንስሐ ገባሑም አነመንኩይ።”<note caller="-" style="x"><char style="xo" closed="false">21፥32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ. 3፥12</ref>፤ <ref loc="LUK 7:29-30">7፥29-30</ref>። </char></note><verse eid="MAT 21:32" /></para>
  <para style="s1">የወይኒ አታሕልት ገበሬ ምሳሌ</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12፥1-12</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፥9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />ኧሗም ኢየሱስ እኪ ባረ፦ “እንጐድ ምሳሌ ስሞ፤ የወይን አታሕልት የቀበረ አት ሰብ ባነ፤ ሑቲ በወይኒ አታሕልት ዙሪያ ኧጭር ኤጠረ፤ የወይን ይጨምቁᎄ ይኸኒ ጐጀ ዀኘ፤ የወይኒ ይቅየዪ ሜነተኘ ገሊፍ ግምብ ሸከተ፤ በዛ አንቌ የአታሕልቲ መደር የገበሬዎች አክራየም ትንጐድ ገኜ ወረ።<note caller="-" style="x"><char style="xo" closed="false">21፥33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5፥1-2</ref>። </char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />ፍርየ ያወርድወ መሬት በሰላ ግዝየ ሟኔሑ ይቌበሮነኸም የሜነተኘዪ ተገበሬዬ ላኸ። <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />ገበሬዪም የሜነተኘዪ ጠበጦም አቲ ወኮይ፤ አቲ ቀጠሮይ፤ ኧንጐዲ ኧሗም ብምን ወጎይ። <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />የወይኒ አታሕልት ባለቤት ዠበረም ቁጥረሕኖ ቲፍቴዪ ይበዛ እንጐዲ ሜነተኘ ኧሗም ላኸ። ገበሬዎቺ በሕኖም ᎈር ይምሳሰር ሜና ፌጠሞቦም። <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />በመጨረሻም የወይኒ አታሕልት ጌቶች ‘ትኸኛሽ ያከብሮይ!’ በወበር የትኸዪ ተገበሬዬ ላኸ። <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />ገበሬዪም የትኸዪ ባዞ ግዝየ ‘ዚማ ወራሺው፤ ኔሑ ንቅጥርነይም ርስተሑ ኢና ንውርስነ!’ ተበበሮ። <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />ትኸዪም ጠበጦም ተወይን አታሕልቲ መደር ተውጪዬ ወሰዶም ቀጠሮይ።<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“ኧጌ፥ የወይኒ አታሕልት ባለቤት በቸኘ ግዝየ በዚ ገበሬ ᎈር ምን ይሸክት ይመስርሑ?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />ሕኖም “የዚ ቡሼ ሰብ መጨረሻሕኖ የባሰ ይሸኩች። የወይኒም አታሕልት መደር ፍርየሑ በግዝየሑ ይቦዪ የንጐድ ገበሬ ያክራይ” ባሮይ።<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ቄጠለም ኢየሱስ እኪ ባረኖ፤</para>
  <para style="q1" vid="MAT 21:42">“በመጽሐፍ ቅዱስ</para>
  <para style="q2" vid="MAT 21:42">‘ግንምበኘ የገረጦይ እምን</para>
  <para style="q2" vid="MAT 21:42">ሑቲ ዋና የቋሚ አናት ኸነ፤</para>
  <para style="q1" vid="MAT 21:42">ዚም የጔታ ሜናው፤</para>
  <para style="q2" vid="MAT 21:42">ዬነና ድንቁ፤’</para>
  <para style="m" vid="MAT 21:42">ቧሪም የጣፈዪ ስርም አናምበብኩ?<note caller="-" style="x"><char style="xo" closed="false">21፥42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">መዝ. 118፥22-23</ref>። </char></note><verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“ስለኸነም እኪ ኧብርኹ፤ የእዝጌር መንግሥት ታሑ ወሰጂም ፍርየ ያወርዲ ሕዝብ ይᎅ። [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />በዚ እምን ᎈር ይወጥቅ ይሰበር፤ እምኒ በᎈረሑ ይወጥቅወዪ ሰብ ይደቅ።”]<note caller="+" style="f"><char style="fr" closed="false">21፥44 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 44 ይደብሮ፤ ቃለሑም በሉቃ. ምዕ. 20፥18 ያነዪም ይመስር። </char></note><verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />የካሕናት አለኦች ፈሪሳውያንም ነዚሕኖም ምሳሌዎች በሰሞ ግዝየ ኢየሱስ የዝነጔኒ ስለሕኖ ወሕነሑ ሐሮ። <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />ስለኸነም ይጠብጦዬ ሸዎም ባነ፤ ቢኸንም ሕዝቢ የነብይኸም ያዥን የነበረ ስለኸነ ጔኖ።<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">የሸቤዪ ግብዣ ምሳሌ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14፥15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />ዠበረም ኢየሱስ በምሳሌ እኪ ባረም ይውዶ ባነ፤ <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“የመንግሥተ ሰሜ የትኸኹ የሸቤ ድግስ የዴገሰዪ ንጉሥ ይመስር። <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />ንጉሢ የጠሬዮዪ ሰብ ተሸቤዬ ይቸኖኸም የዋተስብ አገልጋዮቺ ተሕኖዬ ላኸ፤ ሰቦቺም ተሸቤዬ ይቸኖዬ አንሸዎ።<verse eid="MAT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4" />“ንጉሢ እንጐድ የአገልጋዮች ዠበረም እኪ ቲብር ላኸ፤ ‘ተጠሮᎄ ሰቦቼ ወሮማሑ፦ ዘ፥ የሸቤ ድግሰኛ አዝጋጀሑም፤ ቦራኛ የፈቀሮ ኧሬኛም አረጅዮም፤ ድግሰኛ አዝጋጀሑም፤ እንም ቃር የዝጋጀ ስለኸነ ተሸቤ ግብዣዬ ኔሑ!’ በሮማሑ አውዶዮ። <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />ሕኖም ዘንጋዪ በጭ ባሮም የሟን የሟነሕኖ አቲ ተርሻዬ፥ እንጐዲም ተንግደዄ ወረ፤ <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />የቀኖዪ ኧሗም የአገልጋዪ ጠበጦም በዋዋርድ ወኮም ቀጠሮዮ፤ <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />በዚ ግዝየ ንጉሢ ማቸም የወታደሮቸሑ ላኸም ነዛ የቀጠሮዪ አትቄጠረ፤ ከተማሕኖ በሳት ያነዶይኸም ሸከተ፤ <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />በዚ አንቌ የአገልጋዮቺ እኪ ባረኖ፤ ‘ዘ፥ የሸቤዪ ድግስ ተዝጋጀም፤ የጠሬዮዪም የግብዣዪ የትጌቦ አንኸኖ። <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />ስለኸነም አውራ በአውራ ጎጋዳናዪ ወሮማሑ የረከብሑዪ ሰብ እንም ተሸቤ ግብዣዬ ጥሮ።’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />አገልጋዮቺም ቤማ ኤማ ወሮም፥ የረከቦዪ ሰብ እንም ቡሼዪም፥ ፈያዪም ስበሰቦ፤ ስለኸነም የሸቤዪ ቤት በጋᎄዥዮዪ ተᎀላ።<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“ቢኸንም ንጉሢ የጋᎄዥዮዪ የወዥ ተቤቴ በገባ ግዝየ፥ የሸቤ ልባስ ያለበሰ አት ሰብ በዛ አዠ። <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />እኪም ቧረን፤ ‘ደቦኛ፤ የሸቤ ልባስ ታትለብስ ምንኸም ተዚዬ ገባኸ?’ ምሲም እንቁስ ባረ። <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />ንጉሢም የአገልጋዮቸሑ፦ ‘ኧጀሑም ኧግረሑ ኧግዶማሑ አውጦም በወረጀ ታነዪ ጨለማዬ ኧድጎይ፤ በዛም አልፋታ ስንም ዋንቅጫቅጭ ይኸን’ ባረ።” <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />ቄጠለም ኢየሱስ “ስለኸነም የጠሬዮዪ ብዠኖ፤ የትሜጠሮዪም ቀልኖ” ባረ።<verse eid="MAT 22:14" /></para>
  <para style="s1">ግብር የወክፍል የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12፥13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፥20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />በዛ አንቌ ፈሪሳውያን ወሮም ምንኸም ሸከቶም የኢየሱስ በንግግረሑ ይጠብጦይኸም ተማከሮ፤ <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />የሕኖም ደቀ መዛሙርት ተሔሮድስ ሰቦችጌ ተኢየሱሴ ላሖም፥ “አስተማሪ! አኸ የኢነተኘ ወሕናኸ የእዝጌር ኤማም በኢን ታትመርኸም ኧሒርነ፤ የሰብም በወገና ትሸኩች ቃር ኤነ፤ የሰብ አታዳላ” በባሮይ አንቌ፥ እኪ ባሮም ተሳሎይ። <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />“በይ እንዴ አውድነ፤ ምን ይመስርኸ? ወሕነሑ የቄሣር ግብር ወክፈል ይጌባ ወይሽ ኤይጌባ?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />ኢየሱስም ቡሼነተሕኖ ሐረም፥ “አሑ ግብዝ! የመአር ትፌትኖኝ? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />የግብር ይከፉሊዪ ዋጋ እንዴ አተዞኝ?” ባረኖ። ስለኸነም ሕኖ አት ዲናር አቸኖም አቴዞይ። <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ሑቲም፥ “በዚ ዋጋ ᎈር ይታዢ መልክ የሟኒ? ጥፈተሑሽ የሟኒ?” ባረኖ። <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />ኧጌሽ ሕኖም፤ “የቄሣሩ” ባሮይ። ሑቲም ዠበረም፤ “በሒሽ የቄሣሪ የቄሣር፤ የእዝጌሪም የእዝጌር አቦ” ባረኖ። <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />ሕኖም በሰሞይ አንቌ በንግግረሑ ተዴነቆም ገፈሮይም ወሮ።<verse eid="MAT 22:22" /></para>
  <para style="s1">የሟቾቺ ወተንሣ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12፥18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፥27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />በዛም ከነ፥ “የሟቾቺ ትንሣኤ ኤነ” ይብሮ ሰዱቃውያን ተኢየሱሴ ቸኖም እኪ ቲብሮ ተሳሎይ፤<note caller="-" style="x"><char style="xo" closed="false">22፥23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ሐዋ. 23፥8</ref>። </char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“አስተማሪ! ሙሴ ‘አት ሰብ ትኸ ቴይጨኝ ተምሽተሑ በሞት ቢትላኝ ጐቤች የሟቸሑ ምሽት አገባም የሟቺ ዘር የሰጉርነ፤’ ባረም።<note caller="-" style="x"><char style="xo" closed="false">22፥24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ዘዳ. 25፥5</ref>። </char></note> <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />ሰበት ጐባቢት ቢናዬ ባኖ፤ ይንመሕኖ ንቅ ምሽት አገባም ትኸ ቴጨኝ ᎀተ፤ ስለኸነም እንስ ጐቤች የሟቺ ምሽት አገባ። <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />ዛምኸም ዄታለኘዪም፥ ሦስታለኘዪም ሰበታለኘዪ ስን ተራ በተራ አገቦያም ᎀቶ። <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />ብንም አንቌ ምሽቲ ᎀተች። <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />ኧጌ፥ ሰበቲም ስላገቦያ ሟቾቺ ቢትነሶᎄ ግዝየ ዬቲዋኘ ምሽት ትኸን?”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ኢየሱስም እኪ ቲብር ዠበረኖ፤ “አሑ ቅዱሳን መጽሐፍም የእዝጌር ቆት ባለወሐራሑ ትዳሎ። <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />የሟቾቺ ትንሣኤ ግዝየ ሰቦች በሰሜ ያኖዪ መላይካኸም ይኸኖ አንኸንም ኤያገቦ፤ ኤይጋቦ። <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />ኧሗም የሟቾቺ ወተንሣ እዝጌር ያሑ ዬወደናሑዪ አናምበብኩ? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />ሑቲ የባረ ዛም ኸሙ፦ ‘እያ የአብርሐም አምላክ፥ የይስሐቅ አምላክ፥ የያዕቆብ አምላክ ንኩ፤’ ስለኸነም እዝጌር የሕያዋን አምላኩ አንኸንም የሟቾቺ አምላክ አንከነ።”<note caller="-" style="x"><char style="xo" closed="false">22፥32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ዘፀ. 3፥6</ref>። </char></note> <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />ሕዝቢም ዚ በሰሞ ግዝየ በትምርተሑ ተዴነቆ።<verse eid="MAT 22:33" /></para>
  <para style="s1">ትንም ይበዛዪ ትዛዝ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12፥28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />ኢየሱስ የሰዱቃውያንም ኧንቁስ ያትበኘኖኸም በሰሞ ግዝየ፤ ፈሪሳውያን ቁናዬ ተስበሰቦ። <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />በሕኖ አት የሙሴ የሕጊ አስተማሪ፥ የኢየሱስ ይᎊትኔ ሸም እኪ ቲብር ተሳለን፦<note caller="-" style="x"><char style="xo" closed="false">22፥35-40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፥25-28</ref>። </char></note> <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“አስተማሪ! በሕጊ ውስጥ ትንም ይበዛዪ ትዛዝ ኤቲዋኘው?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />ኢየሱስም እኪ ቲብር ዠᎄረነ፦ “ጔታ አምላካኸ በሙላ ሒናኸ፥ በሙላ ነብስያኸ፥ በሙላ አሳባኸ ውጅጅ፤<note caller="-" style="x"><char style="xo" closed="false">22፥37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ዘዳ. 6፥5</ref>። </char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ትንም ይበዛዪ የበደረዪ ትዛዝ ዚ ቱ። <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />ዚም ይመስር ዄታለኘዪ ትዛዝ፥ ‘ኦላኸ የነብስያኸኸም ሰክትም ውጅጅ፤’ ይቡኒው።<note caller="-" style="x"><char style="xo" closed="false">22፥39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ዘሌ. 19፥18</ref>። </char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />የሙሴ ሕጊም የነብዮች ትምርት እንም የሸከቶ በዚሕኖ በዄቲ ትዛዝ ᎈሩ።”<verse eid="MAT 22:40" /></para>
  <para style="s1">ስለመሲሕ የቀረበ ጥያኤ</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12፥35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20፥41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />ፈሪሳውያን ተስበሰቦም ትናኖ ኢየሱስ እኪ ቲብር ተሳለኖ፤ <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“ስለ ክርስቶስ ምን ይመስርሑ? የሟሽ ትኸው?” ሕኖም “የዳዊት ትኸው” ባሮይ። <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />ኢየሱስም እኪ ባረኖ፤ “ኧጌ፥ ዳዊት በእዝጌር መንፈስ ተመራም በዝነጔ ግዝየ ምንኸም ‘ጔታ’ ባረም ጠራን? <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />‘እዝጌር የጔታኛ መሶአኸ በግራኸ ተት ኧሸክትንከ ስን በከነኛ ቶና!’ ቧረን።<note caller="-" style="x"><char style="xo" closed="false">22፥44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">መዝ. 110፥1</ref>። </char></note><verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />በይሽ ዳዊት ነብሰሑ ‘ጔታ’ ባረም በጠራን ኧጌ መሲሕ ምንኸም ትኸኹ ይኸኔ ይችል?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />በዚ አት ቃል ይዠቡርነዬ የቻለ ሟንም ሰብ አነበረ፤ በዛ ከነ ቀረሰም ጥያኤ ያቀርቡነዬ የደፈረ ሟንም አነበረ።<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">ስለሙሴ የሕጊ አስተማሪም ስለፈሪሳውያን ቡሼነት</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12፥38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11፥43-46</ref>፤ <ref loc="LUK 20:45-46">20፥45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />በዚ አንቌ ኢየሱስ የሕዝቢ የደቀ መዛሙርተሑም እኪ ቲብር ዝነጔኖ፦ <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“የኦሪት ሕጊ አስተማሪዎችም ፈሪሳውያን በሙሴ ወንበር ᎈር ቾኖም። <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />ስለኸነም ሕኖ ይብሮኩዪ እንም ሰክቶ፤ ቀሮ፤ ሕኖ ይሸክቶዪም አትሰክቶ፤ ሕኖ ይዝነጎዪ በሜና ᎈር ኤያወሎይ፤ <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />ይረዚም ያትሜካዪ ጡዋራ አገዶም በሰብ መመር ᎈር ያጮሮ፤ ነብሰሕኖ ባጤበተሕኖ ይለግዶዬ ኤይሸዎ። <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />ሜና ሕኖ እንም ይሸክቶ ሰብ ያዥኖኸም ባሮሙ፤ አሸንክታበሕኖ ያቤትቶ፤ የጠሎት ልባሰሕኖ ዘርፈሑ ያገልፎ፤<note caller="-" style="x"><char style="xo" closed="false">23፥5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቴ. 6፥1</ref>፤ <ref loc="NUM 15:38">ዘሑ. 15፥38</ref>፤ <ref loc="DEU 6:8">ዘዳ. 6፥8</ref>። </char></note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />በግብዣ ᎈር የክብር መደር፥ በምኩራብም ይፍቴዪ ሶረር ወጥብጥ ይወዶ። <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />በየጠባዪም ሰብ እንም ኧጅ ይነሳኖኸም ‘አስተማሪ!’ ባረም ይጠራኖኸም ይሸዎ፤ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />አሑም አስተማሪያሑ ቁና ጠለለ ስለኸነ እንማሑ ጐባቢት ስለኸንኩ፥ ‘አስተማሪ’ ቧሪም ኤይጥረኩ። <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />ኧሗም አሑ ያነናሑ በሰሜ ቁና አባ ጠለለ ስለኸነ ባፈር ᎈር የሟንም ‘አባ’ ባሑም አትጥሮ። <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />ሊቃሑ ክርስቶስ ጠለለ ስለኸነ ‘ሊቃውንት’ ቧሪም ኤይጥረኩ። <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />ታሑ ግብት ንቅ የኸነዪ ያሑ አገልጋይ የሕን።<note caller="-" style="x"><char style="xo" closed="false">23፥11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቴ. 20፥26-27</ref>፤ <ref loc="MRK 9:35">ማር. 9፥35</ref>፤ <ref loc="MRK 10:43-44">10፥43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፥26</ref>። </char></note> <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />ነብሰሑ ከፍ ያበይ ይትዋረድ፤ ነብሰሑ ዝቅ ያበይ ከፍ ይብር።”<note caller="-" style="x"><char style="xo" closed="false">23፥12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14፥11</ref>፤ <ref loc="LUK 18:14">18፥14</ref>። </char></note><verse eid="MAT 23:12" /></para>
  <para style="s1">የሙሴ የሕጊ አስተማሪም የፈሪሳውያን ያወጐዥዮኸም</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12፥40</ref>፤ <ref loc="LUK 11:39-42">ሉቃ. 11፥39-42</ref>፤ <ref loc="LUK 20:47">20፥47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“ሰቦች ተመንግሥተ ሰሜዬ ኤይገቦኸም ወዝገቢ ታጦ አሑ ግብዝ፥ የሙሴ የሕጊ አስተማሪ ፈሪሳውያንም! ወዮአሑ! አሑ ነብሳሑ አትገቦᎄ፤ ወግባ ይሸዎዪ ኤገቦኸም ትኸትሮ!</para>
  <para style="p" vid="MAT 23:13">[<verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />“ያዥንኩኸም ብታቀርቦዪ ገሊፍ ጠሎት መሳ ምሰሕነማ የᎀቶበማዪ እንሽታ ይትዳደርᎄ ትፈዶ አሑ ግብዝ የሙሴ የሕጊ አስተማሪም ፈሪሳውያን ወዮአሑ! ስለኸነም አሑ የባሰ ፍርድ ይሰላብኩ።] <note caller="+" style="f"><char style="fr" closed="false">23፥14 </char><char style="ft" closed="false">አታት የጎጋ ጡሑፍ ቊ. 14 ይደብሮ፤ ቃሊም በማር. 12፥40 ያነዪ ይመስር። </char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“አሑ ግብዞች፥ የሙሴ የሕጊ አስተማሪ ፈሪሳውያንም፤ አት ሰብ ተአይሑድ አይማኖት የወሕራ በባር በጠረቅ አፈርም ትጋዦ ስለኸነ፤ ባመነም ግዝየ ታሑ በዄት ኧጅ የባሰ የፍርድ ኧሳት ትኸ ትሸክቶይ ስለኸነ ወዮአሑ።<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“አሑ ኤነውር መሪ! ወዮአሑ! ‘ሰብ በቤተ መቅደስ ቢመል፥ አትም አንከነ’ ትብሮ፤ ‘በቤተ መቅደሲ ወርቅ ቢመልም በሟለኒ ይጠበጥ’ ትብሮ፤ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />አሑ ገዋ ወዥ አትችሎም! ተወርቂ የወርቂ ቲቄድሲ ቤተ መቅደስም ኤቲ ይበዛ? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />ዛምኸም ‘ሰብ ቢያርጅᎄዪ ቢመል አትም አንከነ’፤ ‘ቢያርጅᎄዪ ᎈር ባነዪ መባ ቢመልም በወማለሑ ይጠበጥ’ ትብሮ። <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />አሑ ኤነውር! ተመባዪም መባዪ ቢቄድሲ ያርጅᎄዪ ኤቲ ይበዛ? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />ስለኸነም ቢያርጅᎄዪ ይመል፥ ቢያርጅᎄዪም ቢያርጅᎄዪ ᎈር ባነዪ ቃር እንም ይመል።<note caller="+" style="f"><char style="fr" closed="false">23፥20 </char><char style="fqa" closed="false">መባ፦ </char><char style="ft" closed="false">ሰብ የአምላካሑ ያቀርᎅ አገልግሎት እንም መባ ይቡሪ። </char></note> <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />በቤተ መቅደስም ይመል፥ በቤተ መቅደሲም በቤተ መቅደስ ውስጥ ቢነብሪ ይመል። <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />በሰሜ ይመሊም በእዝጌር ዙፋነሑ ᎈር ቢቾናዪ ይመል።<note caller="-" style="x"><char style="xo" closed="false">23፥22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፥1</ref>፤ <ref loc="MAT 5:34">ማቴ. 5፥34</ref>። </char></note><verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“አሑ ግብዞች የሙሴ የሕጊ አስተማሪ ፈሪሳውያንም! ወዮአሑ! በአዝሙድ፤ በንስላል፥ በወካሸ ዐሥራት ቲቦ፤ ቢኸንም በሕጊ ውስጥ ይትረከቦዪ እንም ቡሪ ዘንጋ ትገፍሮ፤ ሕኖም ሱቲ ፍርድ፥ ምረት ታማኝነትም ኖ፤ ዛም ታትገፍሮ ዚም ወሰክት ይጌባሑ ባነ።<note caller="-" style="x"><char style="xo" closed="false">23፥23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ዘሌ. 27፥30</ref>። </char></note> <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />አሑ ኤነውር መሪ! ብትሰጦዪ እንም የቅንጭላኸም ቀል የኸነዪ ዘንጋ አጠለልሑም ታድጎይ፤ የጋሜላኸም ወደል የኸነዪ ቃር ትወጦ!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“አሑ ግብዝ የሙሴ የሕጊ አስተማሪ ፈሪሳውያንም! ወዮአሑ! የጥወዪ የወጨቲም የᎈረሑ አዘር ታጥቦ፤ ውስጣሑም የወዝርፍ ብስነትም ᎀላቦም፤ <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />አኸ ኤነውር ፈሪሳዊ! በደርኸም የጥወዪ የወጨቲ ውስጥ ኧጥቡ፤ በዛም አንቌ ᎈረሑ ንጡ ይኸን።<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />“አሑ ግብዝ የሙሴ የሕጊ አስተማሪ ፈሪሳውያንም! ወዮአሑ! በውስጠሕኖ የᎀቶ ሰቦች አጥም በሩክስም ቃር እንም የትᎀሎ፥ በውጪም በኖራ ተሌሰኖም ይደንቆ ቀብሮች ትመስሮ።<note caller="-" style="x"><char style="xo" closed="false">23፥27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ሐዋ. 23፥3</ref>። </char></note> <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />ዛምኸም አሑ፥ በውጪ የሰብ ጻድቅ መሰርኩም ትታዞ፤ በውስጣሑ ግብዝነትም ቡሼነት ᎀላብኩም።<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“አሑ ግብዝ፥ የሙሴ የሕጊ አስተማሪም ፈሪሳውያን! ወዮአሑ! የነብዮች ቀብር ትግነቦ፤ የጻድቃንም አውልት ታትጌጦ። <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />‘የበደሮዪ በአቦቸና ዘበን ተረከብነም ብንኸነ የነብዮች ደም በዋፍስስ አናግዝነዮ ባነ’ ትብሮ። <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />በይሽ፥ የነብዮች የቀጠሮ ሰቦች ዴንጋሕኖ ወሕናሑ ነብሳሑ ትምሰክሮ። <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />ኧጌሽ አቦቻሑ የቀረሶዪ አሑ ፈጥሞ። <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />አሑ እንድወደረ፥ የእንድወደረ ዴንጋ፥ ምንኸም በፍርድ ኧሳት ቅጣት ዋምልጥ ትችሎ?<note caller="-" style="x"><char style="xo" closed="false">23፥33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቴ. 3፥7</ref>፤ <ref loc="MAT 12:34">12፥34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፥7</ref>። </char></note> <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />ስለኸነም ዘ፥ እያ የነብዮች፥ ብላተኞች፥ አስተማሪ ታሑዬ ኧለሕ፤ ተሕኖ አታተሕኖ ትቀጥሮ፤ አታተሕኖም ትሰቅሮዮ፤ አታተሕኖም በምኩራባሑ ትገርፎ፤ በከተማ ተከተማዬ ታሳድዶዮ <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />በዚም መሳ፤ ተጻድቂ ተአቤል ደም ቀረሰም በመቅደሲ በመሠዊያዪም ግብት የቀጠርኩይ በራክያሕ ትኸ ስን ዘካርያስ ደም ባፈር ᎈር የፈሰሰ ስለኸነ የጻድቃን ደም ቅጣተሑ ባሑ ᎈር ይሰላ፤<note caller="-" style="x"><char style="xo" closed="false">23፥35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ዘፍ. 4፥8</ref>፤ <ref loc="2CH 24:20-21">2 ዜና 24፥20-21</ref>። </char></note> <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />የኢን ኧብርሑ፤ ዚ እንም ቅጣት በዚ ጨኘት ᎈር ይሰላ።”<verse eid="MAT 23:36" /></para>
  <para style="s1">ኢየሱስ የኢየሩሳሌም የበከኸም</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13፥34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />ቄጠለም ኢየሱስ እኪ ባረ፤ “ኢየሩሳሌም፥ ኢየሩሳሌም! አኸ የነብዮች ትቀጥር! ታኸዬ የላሑዮዪም ብምን ትወጋ! ኩተና ጭጭወውታን በካንፋዬታን ውስጥ ትስበስብኸም፥ እያም ያኸ ዴንጋ ቁናዬ ኧስበስቤ ምናሕርጌ ፈቀድሑ! አሑም አንሸሑ። <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />በይሽ ዘ፥ ቤታሑ ኦና ኸነም ይቀይ።<note caller="-" style="x"><char style="xo" closed="false">23፥38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22፥5</ref>። </char></note> <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />ስለኸነም ‘በጔታ ሽም ይቸኝ የትባረከው’ ትብሮ ስን ተሗ ቀረሰም ስርም አታዞኝ ኧብርሑ።”<note caller="-" style="x"><char style="xo" closed="false">23፥39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">መዝ. 118፥26</ref>። </char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">የዘበኒ መጨረሻ ምልክቶች</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13፥1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፥5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />ኢየሱስ በቤተ መቅደስ ወጣም ቲያር ደቀ መዛሙርተሑ የቤተ መቅደሲ ፎቅ ያቴዞዬ ተሑቲዬ ቀረቦ። <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ሑቲም “ዚ እንም ታዞ? የኢን ኧብርሑ፤ አትም ኧምን ብምን ᎈር ተድራረበም ቴይፈርስ በዚ ይቀይ ኤነ” ባረኖ።<verse eid="MAT 24:2" /></para>
  <para style="s1">ጔታ ተወተኘሑ ኢፍቴ ይሰላ ስደት መከራ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፥3-13</ref>፤ <ref loc="LUK 21:8-19">ሉቃ. 21፥8-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />ኢየሱስ በደብረ ዘይት ቈቶ ᎈር ቶናም ትናነ ደቀ መዛሙርተሑ የቢቶሕኖ ተውቲዬ ቀረቦም፦ “ዚ እንም ዘንጋ ይኸን መቸው? ትቸኝወዪ የዘበኒ መጨረሻ ምልክተሑ መአሩ?” ቲብሮ ተሳሎይ።<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ኢየሱስ እኪ ቲብር ዠበረኖ፦ “ሟንም ሰብ ኤያሰሰቶኩኸም ተቀሮ! <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />ብዠሕኖ ‘እያ ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">24፥5 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">መሲሕ </char><char style="ft" closed="false">ቁ 23 ተመ</char></note> ንኩ!’ በወበር በሽመኛ ይቸኖ፤ ብዠሕኖም ያሰቶ። <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />የአርብ ጣምባ ኦጀም ትሰሞ፤ ዚ እንም ወሕን ስላነወ አትደንብጦ፤ መጨረሻዪም ገናው። <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />ሕዝብ በሕዝብ ᎈር፥ መንግሥትም በመንግሥት ᎈር ያርብ ይትነሣ፤ በትልያየ መደር ጋጀ ያፈርም ይቅጠቀጥ ይኸን። <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />ዚ እንም የመጥ ጣርኸም የወጨነቅ የበደረ ይኸን። <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />በዛ ግዝየ ሰቦች የመከራ አቸለፎም ይቦኩ፤ ይቀጥሮኩ፤ ስለሽመኛ በሕዝቢ እንም የጠላሑ ትኸኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቴ. 10፥22</ref>። </char></note> <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />በዛም ግዝየ ብዠ ሕኖ አይማኖተሕኖ በወልጋ ይስናከሎ፤ አቲ ይንጐዲ አቸለፈም ይብ፤ ሰቦች ነብስ በነብሰሕኖ ይትናከሶ። <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />ብዠ ባጢለተኘ ነብዮች ይትነሦ፤ ብዠሕኖም ያሰቶ፤ <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />ተቡሼነት ብዛት የትነሳ የብዠ ሰቦች ፍቅር ይቅዘቅዝ። <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />መጨረሻ ስን በትዕግሥት ይጠናም ይተርፍ።<note caller="-" style="x"><char style="xo" closed="false">24፥13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቴ. 10፥22</ref>። </char></note> <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />የሕዝቢ እንም ምስክር ይኸንኸም ዚ የእዝጌር መንግሥት ወንጌል ብንም ዓለም ይሰበክ፤ በዛ ግዝየ መጨረሻሑ ይቸኝ።<verse eid="MAT 24:14" /></para>
  <para style="s1">አሠቃቂዪ መከራ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13፥14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፥20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“ነብዪ ዳንኤል በዚነጔን መሠረት የጥፋት ሩክሰት ውዶ ዘንጋ በቌደሰ መደር ቈመም ባዠሑ ግዝየ ያነቢ ያጥራምት!<note caller="-" style="x"><char style="xo" closed="false">24፥15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳን. 9፥27</ref>፤ <ref loc="DAN 11:31">11፥31</ref>፤ <ref loc="DAN 12:11">12፥11</ref>። </char></note> <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />በዛ ግዝየ በይሑዳ ገኝ ያኖ ተቈቶዬ የስኮ። <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />በቁሬት ᎈር ያነ በቤቲ አት ቃር የወውስድ ኤይውርድ።<note caller="-" style="x"><char style="xo" closed="false">24፥17-18 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፥31</ref>። </char></note> <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />በእርሻም ያነ ልባሰሑ የወውስድ ታንቌዄ ኤዘበር፤ <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />በዛ ግዝየ የዄትነብስም ያጦበማዪ ኧመጫትም ወዮሕነማ! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />ወስካሑ በበርግ በሰምበትም ከነ ኤኸንኸም ጠልዮ! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />በዛ ግዝየ ዓለም በትኸለቀ ቀረሰም ኧኳ ስን ኤይኸን፥ ቲፍቴዬም ሑቲ ይመስር ስርም ኤይኸን፥ ወደል መከራ ይኸን። <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />ነዛ ከነ ቤያጥሮ አትም ሰብ ወትርፍ ባንቻለ ባነ፤ ቢኸንም ስለᎀረጭዮዪ ሰብ ነዛ ከነ ያጥሮ።<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“በዛ ግዝየ ሟንም ሰብ፤ ‘ዝሙ ክርስቶስ በዚ ነነ’ ወይም ‘በዛ ነነ’ ቢብርሑ አትምኖ፤ <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />ባጢለተኘ መሲሖች ባጢለተኘ ነብዮችም ይትነሦ፤ ሕኖ ቢቸሎ የእዝጌር የᎂጠርዮዪ የዋሰሰት ወደል ታምር ያዴንቅም ቃር ያቴዞ።<note caller="-" style="x"><char style="xo" closed="false">24፥24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፥1</ref>፤ <ref loc="REV 7:14">መና 7፥14</ref>። </char></note><verse eid="MAT 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 24:25" />“ኧጌሽ ዚ እንም ዘንጋ በደርኩም ኤወደክሑም፤ <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />ስለኸነም ‘ዘ፥ በበረሐ ነነ!’ ቢብሮኩ አትውጦ፤ ‘ዘ፥ በሼመ መደር ነነ!’ ቢብሮኩ አትምኖ።<note caller="-" style="x"><char style="xo" closed="false">24፥26-27 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17፥23-24</ref>። </char></note> <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />ብራቅ በሰሜ ብልጭ ባረም በምስራቅ ምዕራብ ስን ይታዥኸም፥ የሰብ ትኸ ወተኝ ዛምኸም ይኸን። <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />ጥንምብ ታነወ መደሬ አመራዎች ይስበሰቦ።<note caller="-" style="x"><char style="xo" closed="false">24፥28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17፥37</ref>። </char></note><verse eid="MAT 24:28" /></para>
  <para style="s1">የክርስቶስ ተዠበረም ወተኝ</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13፥24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፥25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“ተዛሕኖ የመከራ ከነዎች አንቌ ሒንጌም ጬት ይጨልም፤ ጠራቃ ብራነሑ ኤይብ፤ ኰኰብ በሰሜ ይወጥቆ፤ የሰሜ ቆት ይንቅጠቅጦ።<note caller="-" style="x"><char style="xo" closed="false">24፥29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፥10</ref>፤ <ref loc="ISA 34:4">34፥4</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፥7</ref>፤ <ref loc="JOL 2:10-31">ኢዩ. 2፥10-31</ref>፤ <ref loc="JOL 3:15">3፥15</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">24፥29-30 </char><char style="xt" closed="false"><ref loc="DAN 6:12-13">ዳን. 6፥12-13</ref>፤ <ref loc="DAN 7:13">7፥13</ref>፤ <ref loc="ZEC 12:10-14">ዘካ. 12፥10-14</ref>፤ <ref loc="REV 1:7">መና 1፥7</ref>። </char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />በዛም አንቌ የሰብ ትኸ ምልክት በሰሜ ᎈር ይታዥ፤ ያፈር ጐሣዎች እንም ይበሖ፤ የሰብ ትኸም በሰሜ ዳበና ኸነም በቆት በወደል ክብርም ቲቸኝ ያዞይ፤ <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ወደል የጡርምባ ጣምባ ያሴሞ መላይካ ይለሕ፤ ሕኖ በአርበቲም የዓለም ማዘን ወሮም ተሰሜ ጥግ ሰሜ ጥግ ስን ያኖዪ የሑቲ የትሜጠሮ ሰቦች ይስበሰቦ።”<verse eid="MAT 24:31" /></para>
  <para style="s1">የበለስ ኧጨ ምሳሌ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13፥28-31</ref>፤ <ref loc="LUK 21:21-33">ሉቃ. 21፥21-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“የበለስ ኧጨ ምሳሌ ትምርት የሕንኩ፤ ጫፈሑ ቲያቁጠቁጥ ቅጠለሑም ቲልመልሞ፥ ዛ ግዝየ አባር ወስላሑ ቲሕሮ። <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />ዛምኸም አሑ ዚ እንም ትታዞ የሰብ ትኸ ይቸኝወ ግዝየ የሰላኸም ሐሮ። <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />የኢን ኧብርሑ፤ ዚ እንም ይትፌጠም ስን ዚ ዝሬት ኤያልፍ። <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />ሰሜ አፈርም ያልፎ፤ ቃለኛም ኤያልፍ።”<verse eid="MAT 24:35" /></para>
  <para style="s1">ጔታ ይቸኝወዪ ከነም ሰዓት ሟንም ኤይሒር ወሕነሑ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13፥32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17፥26-30</ref>፣<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“ስለዛ ከነ ስለዛ ሰዓትም ተአብ አንከንም የሰሜ መላይካ ቢኸኖ፥ ወልድም ቢኸን፥ ሟንም ይሒር ኤነ። <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />በኖሕ ዘበን የኸነኸም፥ የሰብ ትኸ ቢችኝወ ግዝየ ዛምኸም ይኸን።<note caller="-" style="x"><char style="xo" closed="false">24፥37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ዘፍ. 6፥5-8</ref>። </char></note> <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />በዛ ዘበን፥ ተጥፋት ኧጋ ኢፍቴ ኖሕ ተመርከቤ ይገባወ ከነ ስን ሰቦች ቲበሮ ቲሰጦም፥ ቲያገቦ ቲጋቦም ባነ። <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />የጥፋት ኧጋ ቸኘም እንመሕኖ ጥረረገም ይወስዶ ስን አንካሮ ባነ፤ የሰብ ትኸ ቲቸኝ ዛምኸም ይኸን።<note caller="+" style="f"><char style="fr" closed="false">24፥39 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">ዘፍ. 7፥6-24</ref>። </char></note> <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />በዛ ግዝየ ዄት ሰብ በእርሻ መደር ቁናዬ ይሸክቶ። አቲዋኘ ይትወሰድ እንጐዲ ይቀይ። <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />ዄት እንሽታ ቁናዬ ይፈጠማ፤ አቴታ ትትወስድ፤ እንጐዴታ ትቀይ። <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />ኧጌሽ ጌቶቻሑ ቤቲዋኘ ከነ ይቸኝኸም አቲሒሮ ተጋደሎም ቀሮ። <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />ቢኸንም ዚ ሐሮ፤ ባለቤቲ በምሳር ቤቲዋኘ ሰዓት ሌባ ይቸኝኸም ቢሒር፥ ነቃም በቂየ ባነ፤ ቤተሑም ይኩለኩሊኸም ባንገᎈረን ባነ። <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />ዛምኸም የሰብ ትኸ ባናሰብኩይ ሰዓት ይቸኝ ስለኸነ ተዝጋዶም ንበሮ።”<note caller="-" style="x"><char style="xo" closed="false">24፥43-44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ. 12፥39-40</ref>። </char></note><verse eid="MAT 24:44" /></para>
  <para style="s1">የታማኚም የቡሼዪ ሜነተኘ ምሳሌ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12፥41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“ያበሮሰሑ ስንቅ በግዝየሑ ይቦኸም፥ ጌቶቸሑ በአበሮሰሑ ᎈር ይሾᎁ ታማኝ አዩም አገልጋይ ሟኒ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />ጌቶቸሑ ቢቸኝወ ግዝየ እኪ ቲሸክት ይረሕᎅ ዛ ሜነተኘ የትባረከው። <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />የኢን ኧብርሑ፤ ዛ ሜነተኘ ጌቶቸሑ በዱኒያሑ እንም ᎈር ይሾም። <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />ዛ ቡሼ ሜነተኘም፥ ‘ጌቶቸኛ ኧሗ ኤይቸኝ ዬክስ’ ባረም ቢዬስብ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />የሜና መራርቻሑ ወውካ ቢቀርስ፥ ተሰካራምጌ ቢበራ ቢሰጭም <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />የዛ ሜነተኘ ጌቶቸሑ ባንቊየን ከነም ባንኳረን ሰዓት ይቸኝ፤ <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />ዛ ሜነተኘ ጌቶቸሑ ይቈጣን፤ ዕጣሑም ክፍለሑም ተግብዞችጌ ይሸክትወ፤ በዛም ወብክም ስን ዋንቅጫቅጭ ይኸን።”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">የዐሥሪ አፍቶ ምሳሌ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />ቄጠለም ኢየሱስ እኪ ባረ፤ “በዛ ግዝየ የመንግሥተ ሰሜ መብራተሕነማ ጠበጠማም፥ ሙሽራዪ የወቀበር የወጠማዪ ዐሥሪ አፍቶ ይመስር።<note caller="-" style="x"><char style="xo" closed="false">25፥1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12፥35</ref>። </char></note> <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />ተሕነማ አምስቲ ገዋ፥ አምስቲ አዩ ባነማ። <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ገዋዪ አፍቶ መብራተሕነማ ቢጠብጠማም የመብራቲ ይኸን ትርፍ ዘይት አንጠበጠማ ባነ። <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />አዩ አፍቶም ተመብራተሕነማጌ ትርፍ ዘይት በግብር ጠበጠማም ባነ፤ <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />ሙሽራዪ በዋክሰሑ እንም ወኔት ጠበጠነማም ተገደረማ።<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“ግብት ምሳር ቲኸንም ‘ዘ፥ ሙሽራዪ ቸኘ! ውጠማም ተቀበረማይ!’ ይብር ጫጫታ ተሴማ። <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />በዛ ግዝየ አፍቶዪ እንም ተነሠማም መብራተሕነማ አዝጋደማም። <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />ገዋዪ አፍቶ የአለኦቺ መብራተና ወጥፋሑ ስለኸነ ታበማሽ ተዘይታሕማ ናመማነ ባረማየማ። <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />አዩዎቺ አፍቶም ‘ይናም ያሕማ ይኸን ዘይት ኤነነ። ይልቅሽ ተሱቄ ወረማም ያሕማ ይኸን ዘይት ሰረማ’ ቲብረማ ዠበረማነማ። <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />ገዋዪ አፍቶ፥ ዘይት የወሰየ በወረማᎄ ወክት ሙሽራዪ ቸኘ። ተዝጋጀማም የነበረማዪ አፍቶ ተሙሽራዪጌ ተሸቤዬ ግብዣ ቤቴ ገበማ፤ ወዝገቢም ታጨ።<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />“ባንቌም የቀነማዪ አፍቶ ቸነማም፦ ‘ጔታ! ጔታ! ታውሽ ክፍትንነ!’ ባረማይ። <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />ሑቲም፥ ‘የኢን ኧብርሕማ፤ እያ አንሒርሕማ!’ ቲብር ዠበረነማ።<note caller="-" style="x"><char style="xo" closed="false">25፥11-12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">ሉቃ. 13፥25</ref>። </char></note> <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />ስለኸነም ከነዪ ሰዓቲም አቲሕሮ ስለኸነ በርቶም ቀሮ።”<verse eid="MAT 25:13" /></para>
  <para style="s1">መክሊት ያቡዮዪ የሦስቲ አገልጋይ ምሳሌ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19፥11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />ኢየሱስም እኪ ቲብር ኧንጐድ ምሳሌ ኤወደኖ፦ “በዛ ግዝየ ተመንግሥተ ሰሜዬ የወግባ ሐለት እኪ ይኸን፦ አት ትንጐድ ገኜ ያር ሰብ አገልጋዮቸሑ ጠራም ዱኒያሑ ያትሬከበኖኸም ይኸን።<note caller="-" style="x"><char style="xo" closed="false">25፥14 </char><char style="xt" closed="false"><ref loc="LUK 13:25">ሉቃ. 13፥25</ref>። </char></note> <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ጌቶቺ አትባተሑ የቆተኹ ቅጫ በወሳድ፥ ያቲ አምስት መክሊት፥ ያቲ ዄት መክሊት፥ ያቲ ኧሗም ቁና መክሊት አበም ትንጐድ ገኜ ወረ። <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />አምስት መክሊት የቌበረዪ ሒንጌም ወረም ኔገደወም ኧንጐድ አምስት መክሊት አተረፈ። <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />ዄት መክሊት የቌበረዪም ዛምኸም ኧንጐድ ዄት መክሊት አተረፈ። <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />ቁና መክሊት የቌበረዪ ወረም አፈር ኩለኰለም የጌቶቸሑ ዋጋ ቀᎄረን።<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“ተብዠ ግዝየ አንቌ የዛ አገልጋዮች ጌቶች ቸኘም ተሜነተኞቸሑጌ ወትሳሰብ ቀረሰ። <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />አምስት መክሊት የቌበረዪ አገልጋይ ተጌቶቸዄ ቸኘም አምስት መክሊት አቀረበም ‘ጌቶች! አምስት መክሊት አብኬም ባነ፤ ዘ! ኧንጐድ አምስት መክሊት አተረፍኩም!’ ባረ። <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />ጌቶቸሑም ‘ፈያ ሸከትከም፤ አኸ ታማኝ ሱት አገልጋይንኩ! በቀል ቃር ታማኝ ኸንከም የትረከብኸ ስለኸነ በብዠ ቃር ᎈር ኧሾምከ፤ ኔኸ የጌቶቻኸም ብልቃት የወሳድ ግባ!’ ቧረን። <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />ዄት መክሊት የቌበረዪ ቀረበም ‘ጌቶች! ዄት መክሊት አብኬም ባነ፤ ኧንጐድ ዄት መክሊት አተረፍኩም!’ ቧረን። <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />ጌቶቸሑም ‘ፈያው! አኸ ታማኝ ፈያ ሜነተኘ በቀል ዘንጋ ታማኝ ኸንከም የትረከብኸ በብዠ ዘንጋ ᎈር ኧሾምከ፤ ኔኸ የጌቶቻኸም ብልቃት የወሳድ ግባ!’ ቧረን። <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />አት መክሊት የቌበረዪ ቀረበም፥ ‘ጌቶች! ባንዘራኸወ ታድ፥ ባንብራጨኸወ ትስበስብ፥ አረመኔ ሰብ ወሕናኸ ኧሒር፤ <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />ስለኸነም ጔናሑም ወርኩም ዋጋኸ ባፈር ውስጥ ቀበርኩን፤ ዝሙ ዋጋኸ!’ ቧረን። <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />ጌቶቸሑም እኪ ቧረን፤ ‘አኸ ቡሼ ሰነፍ አገልጋይም! ባንዘራሑወ አድኸም ባንበተንኩወ ኧስበስብኸም ቲሒር በኸነ፥ <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />ዋጋኛ በባንክ ዋውና ባነብከ፤ እያም በቸኘሑ ግዝየ ዋጋኛ ተወለድ ወለደሑ ኧወስጅ ባነ። <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />በይ ዋጋዪ ተቀበሮማሑ ዐሥር መክሊት ያነኒ አቦይ። <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />ያነን ሰብ እንም ይደቡርነ ይᎄዛነ፤ ቤነን ሰብም ዛ ያነኒ ይወስጅᎄ።<note caller="-" style="x"><char style="xo" closed="false">25፥29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቴ. 13፥12</ref>፤ <ref loc="MRK 4:25">ማር. 4፥25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፥18</ref>። </char></note> <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />ዚ ኤያድገልል አገልጋዪም በውጪ ታነዪ ጨለማ አውጦማሑ ኧድጎይ፤ በዛ አልፋታ ስን ዋንቅጫቅጭም ይኸን።’<note caller="-" style="x"><char style="xo" closed="false">25፥30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቴ. 8፥12</ref>፤ <ref loc="MAT 22:13">22፥13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፥28</ref>። </char></note><verse eid="MAT 25:30" /></para>
  <para style="s1">በዓለም መጨረሻ ይኸን ፍርድ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“የሰብ ትኸ በመላይካሑ እንም ቴጀበም በክብር ቲቸኝ በክብረሑ ዙፋን ᎈር ይቾና፤<note caller="-" style="x"><char style="xo" closed="false">25፥31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">ማቴ. 16፥27</ref>፤ <ref loc="MAT 19:28">19፥28</ref>። </char></note> <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />ሕዝቢ እንም ቢፍተሑ ይስበሰቦ፤ ወጅመኘ ኧጤ ተፌቅ ይላኝኸም ሑቲም የሕዝቢ ነብስ በነብሰሕኖ ይላኝኖ። <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ጻድቃንም በከነሑ፥ አጢያተኞች በጉራሑ ያቈሞ። <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />በዛ ግዝየ ንጉሢ በከነሑ አዘር ያኖዪ እኪ ይብኖ፦ ‘አሑ አባኛ የባረከናሑ! ኔሑ! ዓለም በትኸለቀ ቀረሰም የዝጋጀንኩዪ መንግሥት ውረሶ! <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />ተጋድኩም ባነ፥ አበናሑኝም፤ ጠሜም ባነ፥ አሰጨሑኝም፤ ባዘና ኸንኩም ቸኘሑ፤ በቤታሑ ተቌበርኩኝም፤ <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ኧንጨኛ ባነሑ፥ አለበስኩኝም፤ ታቌሑም ባነ፥ አዠሑኝም፤ ኧጉጀኘ ኸንኩ ባነ ቸኘሑም ተሳልኩኝም።’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />በዛ ግዝየ ጻድቃን እኪ ቲብሮ ይዠብሮነ፤ ‘ጔታ፥ መቸ ጋደናኸም አዠነም አበናነከ? መቸ ተጠማኸም አዠነም አሰጨነከም? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />መቸ ባዘና ኸንከም አዠነከም በቤተና ተቌበርነከም? መቸ ኧንጫኸ አዠነከም አለበስነከም? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />መቸ ታቌኸም ኧጉጀ ኸንከ አዠነከም ቸኘነም ተሳልነከም?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />ንጉሢ ‘የኢን ኧብርሑ፤ ተዚሕኖ ተጐባቢተኛ ቀል የኸነዪ ያቲ የሸከትኩዪ እንም ይያ የሸከትሑኒኸሙ!’ ቲብር ይዠብርኖ። <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />በዛ አንቌ በጉራሑ አዘር ያኖዪም እኪ ይብኖ፤ ‘አሑ የሰደብኩ! ቲያ ዛዘር ወሮ! የዳቡሎስ ይትዄተሎዪም መላይካ ተዝጋጀኖዪ ተዘለዓለም የፍርድ ኧሳቴ ወሮ! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ተጋድኩም ባነ አናብራሑኝ፤ ተጠማሑም ባነ አናስጨሑኝ። <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ባዘና ኸንኩም ቸኘሑም ባነ፥ አንትቀበርኩኝ፤ በቤታሑ ኧንጨኛ ባነሑ፥ አናልበስኩኝ፤ ታቌሑም ኧጉጀኘ ኸኘንኩ ባነ፥ አንትሳልኩኝ፤’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />ሕኖም ‘ጔታ፥ ተጋድከም፥ ተጠማኸም፥ ባዘና ኸንከም፥ ኧንጫኸ፥ ታቌኸም፥ ኧጉጀኘ ኸንከ መቸ አዠነከም ታንረዳነከ ቀኘነ?’ ቲብሮ ይዠብሮነ። <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />ንጉሢም ‘የኢን ኧብርሑ፤ ተዚ ተጐባቢተኛ ቀል የኸነዪ ያቲ ያንሰከትኩይ እንም ይያ ያንሰከትኩኒኸሙ’ ይብኖ። <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />ስለኸነም ነዚ ተዘላለም ቅጣቴ ቲያሮ፥ ጻድቃንም ተዘላለም ሕይወቴ ያሮ።”<note caller="-" style="x"><char style="xo" closed="false">25፥46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳን. 12፥2</ref>። </char></note><verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">በኢየሱስ ᎈር የሸከተ ሤራ</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14፥1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፥1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሐ. 11፥45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />ኢየሱስ ዚ እንም ትምርት አትመረም በፈጀ ግዝየ የደቀ መዛሙርተሑ እኪ ባረኖ፤ <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“በዄት ከነ አንቌ የፋሲካ በዓል ይኸንኸም ቲሒሮ፤ የሰብ ትኸ የወሰቀር ተችላለፈም ይቴብ።”<note caller="-" style="x"><char style="xo" closed="false">26፥2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ዘፀ. 12፥1-27</ref>። </char></note><verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />በዛ ግዝየ የካሕናት አለኦች የሕዝቢ ሽማግሌዎችም ቀያፋ በቧሪ የካሕናት አለአዪ ግቢ ውስጥ ተስበሰቦም፤ <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />በዛዬም የኢየሱስ በሸር የወጥብጥም የወቅጥር ተማከሮ። <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />ቢኸንም “በሕዝቢ ግብት ሕላት ኔይትነሳ በበዓል ከነ ኤይሕን” ባሮ።<verse eid="MAT 26:5" /></para>
  <para style="s1">የኢየሱስ ሽቶ የቀባቹ ምሽት</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14፥3-9</ref>፤ <ref loc="JHN 12:1-8">ዮሐ. 12፥1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />ዘ፥ በቢታንያ ለምጣም በነበረዪ በስምዖን ቤት ባነ። <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />በዛዬም ኢየሱስ በማዳ ቾናም ትናነ አት ምሽት ዋጋሑ ስርም ውድ የኸነ ሽቶ የመላወ የአልባስጥሮስ<note caller="+" style="f"><char style="fr" closed="false">26፥7 </char><char style="fqa" closed="false">የአልባስጥሮስ፦ </char><char style="ft" closed="false">የክብር ግብር ይሸከትወ ነጨ ባፈር ውስጥ ኩለኰሊም ያወጬ እምኑ። </char></note> ብልቃጥ ጠበጠችም ተውቲዬ ቀረበች፤ ሽቶዪም በጉነነሑ ᎈር አፈሰሰቹ።<note caller="-" style="x"><char style="xo" closed="false">26፥7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፥37-38</ref>። </char></note> <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />ደቀ መዛሙርተሑ ዚ አዞም ማቶም እኪ ባሮ፦ “ዚ ሽቶ የመአር ቤድገልል ቃር ባከነ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />ዚ ሽቶ በብዠ ዋጋ ተስየም የዜጋ ዋብ ይቸል ባነ!” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />ኢየሱስም ዚ ወበረሕኖ ሐረም እኪ ባረኖ፤ “ዚ ምሽት የመአር ታትሜኮያ? ሒቲ ይያ ፈያ ቃር ሸከተችም፤ <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />ዜጋ እንጌ ታሑጌኖ፤ እያም እንጌ ታሑጌ በዚ አንትረከብ።<note caller="-" style="x"><char style="xo" closed="false">26፥11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ዘዳ. 15፥11</ref>። </char></note> <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ሒቲ ዚ ሽቶ ብያ ᎈር ዋፍስሴታ ይያም የቀብር የዋዝጋጁ። <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />የኢን ኧብርሑ በዓለም እንም ዚ ወንጌል ቢሰበክወ በሟንም መደር ዚ ሒቲ የሸከተቹዪ ትዜገድወዬ ይቴወድና።”<verse eid="MAT 26:13" /></para>
  <para style="s1">ይሑዳ የኢየሱስ አቼለፈም የዋብ ወስማማሑ</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14፥10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፥3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />በዛ ግዝየ ተዐሥረ ዄቲ ሐዋርያት አቲ የኸነዪ አስቆሮቱ ይሑዳ የካሕናት አለኦቼ ወረም <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />“ኢየሱስም አቸለፍኩም ብኒብኩ ምን ቲቦኝ?” ባረ። ሕኖም ሠላሳ የጣራ የጠገራ ብር <note caller="+" style="f"><char style="fr" closed="false">26፥15 </char><char style="fqa" closed="false">የጣራ የጠገራ ብር፦ </char><char style="ft" closed="false">እንጐድ አትም ያንትደበረወ የጣራ የጠገራ ብር ወበሩ። </char></note> አቦይ<note caller="-" style="x"><char style="xo" closed="false">26፥15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዘካ. 11፥12</ref>። </char></note> <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />ሑቲም በዛ ሰዓት ቀረሰም የኢየሱስ አቼለፈም ይብወዪ ይትᎂችን ግዝየ ይሸ ባነ።<verse eid="MAT 26:16" /></para>
  <para style="s1">የኢየሱስ የፋሲካ ኧርባት</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14፥12-21</ref>፤ <ref loc="LUK 12:7-14">ሉቃ. 12፥7-14</ref>፣<ref loc="LUK 12:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሐ. 13፥21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />በቂጣ በዓል መጀመሪያ ከነ ደቀ መዛሙርተሑ ተኢየሱሴ ቀረቦም “የፋሲካ በዓል ኧርባት ቤቴ አዝጋጅንከኸም ትሸ?” ቲብሮ ተሳሎይ። <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />ሑቲም “ተከተማዬ ትትገቦ ትረሕቦዪ ሰብ ቤቴ ወሮም ‘አስተማሪ ግዝየኛ ቀረበም ተደቀ መዛሙርተኛጌ የፋሲካ በዓል ኧርባት ኧᎄራኒ ባኸ ቤቱ ይብር’ በሮይ” ባረ። <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />ደቀ መዛሙርተሑም ኢየሱስ ዬዘዘኖኸም ሸከቶ፤ የፋሲካዪም ኧርባት አዝጋዶ። <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />በመሸም ግዝየ ኢየሱስ ተዐሥራ ዄቲ ሐዋርያትጌ በማዳ ቾና። <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />ቲበሮም ኢየሱስ፦ “የኢን ኧብርሑ፤ ታሑ አቲ ይያ አቸለፈም ይቤ” ባረ። <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />ደቀ መዛሙርተሑም በዚ ቃር ስርም አዘኖም፥ አትባተሕኖ ጔታ፥ “እያ ኧኸን?” ቲብሮ ይሰሎይ ቀረሰ። <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />ኢየሱስም እኪ ቲብር ዠበረኖ፦ “ይያ አቸለፈም ይቤ ቲያጌ በወጨቲ ውስጥ የኸናዪው። <note caller="-" style="x"><char style="xo" closed="false">26፥23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">መዝ. 41፥9</ref>።</char></note> <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />የሰብ ትኸ ስለሑቲ በጣፈዪ መሠረት ይᎀት፤ ቢኸንም የሰብ ትኸ አቸለፈም ይቢ የዛ ሰብ ወዮውታ! ዛ ሰብ ባንትጠኘ ይጠቁል ባነ።” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />አቸለፈም ይᎅ ይሑዳም፥ “አስተማሪ! እያ ኧኸን?” ባረ። ኢየሱስም፥ “አኸ የቧዀንኸሙ” ቧረን።<verse eid="MAT 26:25" /></para>
  <para style="s1">የቅዱስ ቁርባን ሥራት</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14፥22-26</ref>፤ <ref loc="LUK 22:15-20">ሉቃ. 22፥15-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፥23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />ቲበሮ ኢየሱስ ቂጣዪ ነሣም ምስጋናኸ ባረም ፈረመም የደቀ መዛሙርተሑ “የሑ ብሮ ዚ በሰረኛው” ባረም አበኖ። <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />ጥወዪም ነሣም የምስጋና ጠሎት በሸከተ አንቌ እኪ ቲብር አበኖ፤ “እንማሑ በዚ ጥወ ስጦ፤ <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ዚ ስለብዠሕኖ የአጢያት አፉታ ይፈስ የገደሪ ጉዳ ደመኛው፤<note caller="-" style="x"><char style="xo" closed="false">26፥28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ዘፀ. 24፥8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፥31-34</ref>። </char></note> <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />በአባኛ መንግሥት ገደሪ የወይን ፍርየ የቆቈሪ ታሑጌ ኧሰጭወ ከነ ስን ተሗ ቀረስኩም በዚ የወይን ፍርየ የቆቈሪ ዄታለኘ አንሰጭ ኧብርሑ፤” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />በዛ አንቌ መዝሙር ዜመሮም ተደብረ ዘይት ቈቶዬ ወጦ።<verse eid="MAT 26:30" /></para>
  <para style="s1">ጴጥሮስ ይለጓንኸም ኢየሱስ በደረም የዝነጔኸም</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14፥27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፥31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሐ. 13፥36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />በዛ ግዝየ ኢየሱስ፥ የደቀ መዛሙርተሑ እኪ ባረኖ፤ “ ‘ወጅመኘዪ ኧወካ፤ የወጅመኘዪ ኧጤዎች ይትብራጦ’ ቧሪም ጣᎉም በዚ ምሳር፥ እንማሑ ትለጎኝ።<note caller="-" style="x"><char style="xo" closed="false">26፥31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፥7</ref>። </char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />ቢኸንም በሞት በትነሳሑ አንቌ ተገሊላ ከተማዬ በደረኩሑም አር።”<note caller="-" style="x"><char style="xo" closed="false">26፥32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቴ. 28፥16</ref>። </char></note><verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />በዛ ግዝየ ጴጥሮስ፥ “ኧንጐደሕኖ እንም ቢለጎከ እያ ስርም አንለጋኸ!” ባረም ዝነጔ። <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />ኢየሱስም “የኢን ኧብርኸ፤ ኧኳ በዚ ምሳር ኩተና ተወኖቀሑ ኢፍቴ አኸ ሦስትጌ ትለጌ” ቧረን። <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />ጴጥሮስም “ታኸጌ ወሙት ያሸ ቢኸን ኧᎀት አንኸንም ስርም አንለጋኸ!” ቧረን። የቀኖዪም ደቀ መዛሙርት እንም ዛምኸም ይብሮ ባነ።<verse eid="MAT 26:35" /></para>
  <para style="s1">ኢየሱስ በጌቴሴማኒ የጤለየኸም</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14፥32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፥39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />በዛ አንቌ ኢየሱስ ተደቀ መዛሙርተሑጌ ጌቴሴማኒ ቲቡሪ መደሬ ወረ፤ ዛዬ በሰሎኸም ኢየሱስ የደቀ መዛሙርተሑ፦ “እያ ዛዬ ወርኩም ኧጤልል ስን አሑ በዚ አክሶ” ባረኖ። <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ተሑቲጌ ጴጥሮስም ዄቲ ተዘብዴዎስ ዴንጋ አትዄተለም ወረ፤ ያዝን ይጨነቅም ቀረሰ። <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />እኪም ባረኖ፦ “የወሙት ኧሰላ ስን አዘንሑም፤ አሑ በዚ አክሶ፤ ቲያምጌ ተጋደሎ” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />ተሕኖ ቀል ሽቅ ባረም ወረ፥ ባፈር ᎈር በግንባረሑ ተደፋም፥ እኪ ቲብር ጤለየ፤ “አባ! ይቸል በኸነ ዚ የመከራ ጥወ ቲያ ዛዘር የተለፍ! ቢኸንም ያኸ ፈአድ የሕን አንኸንም ይያ ፈአድ ኤይሕን።”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />በዛ አንቌ ተሦስቲ ደቀ መዛሙርት ተዠበረም በቸኘ ግዝየ ተገደሮም ረከበኖ፤ ስለኸነም፥ የጴጥሮስ እኪ ቧረን፦ “ቲያጌ የቁና ሰዓት ወጋደል አንቻልኩ? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />ተፈተናዬ አትገቦኸም ተጋደሎ ጠልዮ፤ መንፈስ ዮንም የዝጋጀው፤ በሰርም የቌጠው።”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />ዠበረም ኢየሱስ የዄታለኘ ግዝየ ሽቅ ባረም ወረም “አባኛ! ዚ የመከራ ጥወ ታንሰጭን ይቸለፌ ኤይቸል በኸነ ያኸ ፈአድ የሕን” ቲብር ጤለየ። <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />ኧሗም ተደቀ መዛሙርተዄ ተዠበረም በቸኘ ግዝየ ዔነሕኖ በወኔት ራዘኖም ባነ ተገደሮም ረከበኖ። <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />ዠበረም ገፈረኖም ወረም ዛም ይፍቴዪ ቃል በወዘንግ የሦስታለኘ ግዝየ ጤለየ። <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />በዛ አንቌ ተደቀ መዛሙርተዄ ተዠበረም ቸኘም እኪ ባረኖ፤ “ኧሗም ገና ተገደርሑም? አᎈኘሑሙ? ዘ፥ የሰብ ትኸ በአጢያተኞች ኧጅ ተችላለፈም ይቴብወ ሰዓት ሰላም፤ <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ተንሶ ንወርነ! ዘ፥ አቸለፈም ይቤ ቀረበም!”<verse eid="MAT 26:46" /></para>
  <para style="s1">የኢየሱስ ወጠበጠሑ</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14፥43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፥47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሐ. 18፥3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />ኢየሱስ ገና ቲዝነግ ትናነ ዘ፥ ተዐሥረ ዄቲ ደቀ መዝሙር አቲ የኸነዪ ይሑዳ ቸኘ፤ ተሑቲጌ ሰይፍ እንጣርም የጠበጦ ብዠ ሰቦች ቸኖ፤ ሕኖም ተካሕናት አለኦች ተሕዝቢ ባሊቆች የትላሖ ባኖ። <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />የኢየሱስ አቸለፈም ይᎅ ይሑዳ የሰቦቺ “ትሸዎዪ እያ ኧሰᎁው የሑቲ ጥብጦይ” ቲብር ምልክት አበኖም ባነ።<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />ይሑዳ ሒንጌም ቸኘም ተኢየሱሴ ቀረበም “አስተማሪ! ሰላም ያኸ የሕን!” ባረም ሳᎀን። <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />ኢየሱስም “ደቦኛ! ኧጌሽ የቸኘኸወዪ ዘንጋ ፈጥም” ቧረን፤ በዛ አንቌ ሰቦቺ ተኢየሱሴ ቀረቦም ጠበጦይ። <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />በዛ ግዝየ ተኢየሱስጌ ተነበሮዪ አቲ ኧጀሑ ዝረጋም ሰይፈሑ ሻበም የካሕናት አለአዪ አገልጋይ ወካም እንዝነሑ ቅᎀጠለን። <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />ኢየሱስም እኪ ባረ፤ “ሰይፍ ይነሶ በሰይፍ ይጠፎ ሰይፋኸ ቲዀረᎄዬ ዘብርም ሑራን። <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />ወሕነሑ እያ አባኛ ብንጮቁሽ ሑቲ በብዠ ሺ ይቆጠሮ የመላይካ አርብ ይለሕኒዬ ኤይችል ይመስርኸ? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />እኪማ ቢኸን ‘መከራ ወቀበር ነነወ’ ይብሪ የቅዱሳን መጽሐፍት ቃል ምንኸም ይትፌጠም?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />በዛ ሰዓት ኢየሱስ በዛ የስበሰቦዪ ሕዝብ እኪ ባረ፤ “ወንበዴ ትጠብጦኸም ይያም የወጥብጥ ሰይፍ እንጣርም ጠበጥኩም ቸኘሑ? ከነ በከነሑ በቤተ መቅደስ ትናትመር ታሑጌ ትናነሑ አንጠበጥኩኝ ባነ፤<note caller="-" style="x"><char style="xo" closed="false">26፥55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፥47</ref>፤ <ref loc="LUK 21:37">21፥37</ref>። </char></note> <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />ቢኸንም ዚ እንም የኸነ በነብዮች የጣፈዪ ይትፌጠምኸሙ” በዛም ግዝየ ደቀ መዛሙርተሑ እንም ገፈሮይም ሰኮ።<verse eid="MAT 26:56" /></para>
  <para style="s1">ኢየሱስ ተፍርድ ጀᎈሬ ወወሰደሑ</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14፥53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፥54-55</ref>፤ <ref loc="JHN 18:13-14">ዮሐ. 18፥13-14</ref>፣<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />በዛ አንቌ የኢየሱስ የጠበጦይ ሰቦች ተካሕናት አለአዪ ተቀያፋዬ ወሰዶይ፤ በዛም የሙሴ የሕጊ አስተማሪዎች ሽማግሌዎችም ተስበሰቦም ባነ። <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />ቢኸንም ጴጥሮስ በሩቄ ኸነም የካሕን አለአዪ ኧጭር ግቢ ስን ይትዄተል ባነ፤ ተውስጤ ገባም የሐለቲ መጨረሻ የወዥ ተዘበኞቺጌ ቶና። <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />የካሕናት አለአዪም የአይሑድ ጀᎈር አባል እንም በኢየሱስ ᎈር የሞት ፍርድ የዋትፈርድ የባጢል ምስክር ይሸዎ ባነ። <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ብዠ የባጢል ምስክሮች ቀረቦም ሞት ያትፌርድወ ምስክርነት አረኸቦ፤ የመጨረሻ ዄት ምስክር ቀረቦም፥ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />“ዚ ሰብ ‘የእዝጌር ቤተ መቅደስ አፈርስም በሦስት ከነ ኧሸኩቼ ኧችል’ ባረም” ቲብሮ ዝነጎ።<note caller="-" style="x"><char style="xo" closed="false">26፥61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሐ. 2፥19</ref>። </char></note><verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />የካሕናት አለአዪ ተነሳም “ነዚ ሰቦች ይምሰክሮብከዪ እንም አትም መልስ አቲብ?” ቲብር ተሳለን። <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />ኢየሱስም እንቁስ ባረ። የካሕናት አለአዪም፤ “በሕያው እዝጌር ሽም ኧጮቅስከ፤ አኸ ክርስቶስ የእዝጌር ትኸ የኸንከኸም አውድነ” ቧረን። <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />ኢየሱስም እኪ ቲብር ዠᎄረነ፤ “አኸ የቧዀንኸሙ፤ ቢኸንም ተሗ ቀረሰም የሰብ ትኸ በቆተሑ እዝጌር ከነ ቾናም ታዞይ፤ ዛምኸም በሰሜ ዳበና ኸነም ቲቸኝ ታዞይ ኧብርሑ።”<note caller="-" style="x"><char style="xo" closed="false">26፥64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፥13</ref>። </char></note> <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />በዛ ግዝየ የካሕናት አለአዪ በወብሳጭ ልባሰሑ ገደደም እኪ ባረ፤ “ዘ፥ በእዝጌር ᎈር የስድብ ቃል ዝነጔም! አሑ ስድበሑ ሰማሑም! ተዚ የበዛ ምን ምስክር ያሸ! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />ኧጌ፥ ምን ይመስርሑ?” ሕኖም “ሞት ይጌቧን!” ቲብሮ ዠበሮ።<note caller="-" style="x"><char style="xo" closed="false">26፥65-66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ዘሌ. 24፥16</ref>። </char></note><verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />በዛ ግዝየ እንባቌሕኖ ተፎᎄ፤ ኩረኰሞይ፤ በትፊ ቲወኮይ፥ <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />“ክርስቶስ! ሟኒ የወካናኸ? እንዴ ትምቢት ዘንግ” ይብሮይ ባነ።<verse eid="MAT 26:68" /></para>
  <para style="s1">ጴጥሮስ የኢየሱስ የለጓንኸም</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14፥66-72</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፥56-62</ref>፤ <ref loc="JHN 18:15-18">ዮሐ. 18፥15-18</ref>፣<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />ጴጥሮስ ተቤቲ ውጪ በካሕናት አለአዪ ግቢ ውስጥ ቾናም ባነ፤ በዛ ግዝየ አት የቤት ሜነተኘ ተሑቲዬ ቀረበችም “አኸ ተገሊላዊዪ ኢየሱስጌ ባነኸ!” ባረቹ። <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />ሑቲም “ትብዪ አንሒር!” ቲብር ብንም ኢፍቴ ለጋ። <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />ተግቢዪ ይወጨᎄ ተኸነዪ ተወዝገቢዬ ቲያር እንጐዴታ ሜነተኘ ተምሌከተቹም፤ በዛ የነበሮዪ ሰቦች፤ “ዚ ሰብ ተናዝሬቲ ተኢየሱስጌ ባነ!” ባረች። <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />ጴጥሮስም “ዚ ትብዪ ሰብ አንሒን!” ቲብር በወማል ዠበረም ለጋ። <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />ተቀል ግዝየ አንቌ በዛ ቈሞም የነበሮዪ ሰቦች ተጴጥሮሴ ጠጋ ባሮም፦ “ንግግራኸ ያትኴር፤ ዮንም አኸ ተሕኖም አቲንከ” ባሮይ። <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />በዛ ግዝየ ጴጥሮስ፦ “እያ ዚ ሰብ አንሒን!” ቲብር ነብሰሑ ወሳደብ ወማል ቀረሰ። ሒንጌም ኩተና ኖቀ።<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />በዛ ግዝየ ጴጥሮስ፤ “ኩተና ቴይኖቅ ሦስትጌ ትለጌ” ባረም ኢየሱስ የዝነጔን ቃል ተዜጐደን። ጴጥሮስም ተወረጀዬ ወጣም ምርር ባረም በኴ።<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">ኢየሱስ ተጲላጦሴ ወወሰደሑ</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15፥1</ref>፤ <ref loc="LUK 23:1-2">ሉቃ. 23፥1-2</ref>፤ <ref loc="JHN 18:28-32">ዮሐ. 18፥28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />ቅረር በሱቢ የካሕናት አለኦች የሕዝብ ባሊቆችም እንም በኢየሱስ ᎈር የሞት ፍርድ የዋትፈርድ ተማከሮ። <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />ባገዶይም አንቌ ወሰዶም የገዢዪ የጲላጦስ አቸለፎም አቦይ።<verse eid="MAT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />አየሱስ የᎈረጅᎄኸም ባዠ ግዝየ አቸለፈም ያᎄን ይሑዳ ተውዘገበ፤ ሠላሳዪም የጠገራ ብር የካሕናት አለኦች ባሊቆች እኪ በወበር ዠበረም አበኖ፤ <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />“ንጡዪ ሰብ የሞት አቸለፍኩም በዋበኛ ቤደልኩም።” ሕኖም “ኧጌ፥ ኢና ምን መካነም! የፎላኸ ቃሩ!” ባሮይ። <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />ሑቲም ሠላሳዪ የጠገራ ብር በቤተ መቅደስ ውስጥ ብራጨም፥ ገፈረኖም ወጣ፤ ወረም ታነቀም ᎀተ።<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />የካሕናት አለኦች ሠላሳዪ የጠገራ ብር ነሶም “ዚ ዋጋ የደም ዱኒያ ስለኸነ ተቤተ መቅደስ መባጌ ንደብርነዬ ኤትፌቀድ” ባሮ። <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />ስለኸነም በትማካሮ አንቌ የባዘና የቀብር መደር ይኸንኸም የሸክላ ይሸክቲ አፈር ስሮᎄ። <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />በዚ መሳ ዛ አፈር ኧኳ ስን “የደም አፈር” ቲቡሪ ይጠሬ።<note caller="-" style="x"><char style="xo" closed="false">27፥3-8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ሐዋ. 1፥18-19</ref>። </char></note><verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />በዛም በነብዪ ኤርሚያስ እኪ ቧሪም የቴወደዪ ተፌጠመ፤ “የእስራኤል ዴንጋ የጌመቶዪ የሑቲ ዋጋ ይኸን ሠላሳ የጠገራ ብር ወሰዶ፤ <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ጔታም ዬዘዜኸም ስለሸክላ ይሸክቲ አፈር ሳዶይ” ቧሪም በነብዪ በዘካርያስ የቴወደዪ ትምቢት ተፌጠመ።<note caller="-" style="x"><char style="xo" closed="false">27፥9-10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዘካ. 11፥12-13</ref>። </char></note><verse eid="MAT 27:10" /></para>
  <para style="s1">ኢየሱስ ተጲላጦሴ ወቅርበሑ</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15፥2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23፥3-5</ref>፤ <ref loc="JHN 18:33-38">ዮሐ. 18፥33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />በዛ ግዝየ ኢየሱስ ተገዢዪ ተጲላጦሴ ኢፍት ቀረበ፤ ገዢዪም “አኸ የአይሑድ ንጉሥንከ?” ቲብር ተሳለን፤ ኢየሱስም “አኸ የቧዀንኸሙ” ቲብር ዠበረ። <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />ቢኸንም የካሕናት አለኦች ባሊቆች ቲውነጅሎይ አትም መልስ አናበኖ። <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />በዛ ግዝየ ጲላጦስ “በምናሕር ቃር አቀረቦም ቲከሶከ አትሰማ?” ቧረን። <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />ኢየሱስም የገዢዪ ይዴነቅ ስን ያት ክስም ቃል አንዘᎄረነ።<verse eid="MAT 27:14" /></para>
  <para style="s1">ኢየሱስ የሞት ፍርድ የᎈረጅᎄኸም</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15፥6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፥13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሐ. 18፥39-40</ref>፤ <ref loc="JHN 19:1-16">19፥1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />ገዢዪ ተዓመት ዓመተሑ በአይሑድ የፋሲካ በዓል ግዝየ ይፈታኖኸም ሕዝቢ የሳሎዪ አት ኧጉጀኘ ፈታም ወግፍር አሮሸም ባነ። <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />በዛ ግዝየ በዐመጥ የትኴረ ኢየሱስ በርባን ይቡሪ ኧጉጀኘ ባነ። <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />ሕዝቢ የስበሰቦኸም ጲላጦስ፤ “ተበርባን ክርስቶስም ቲቡሪዪ ተኢየሱስ፤ ሟ ኧፈታንኩኸም ትሸዎ?” ባረኖ። <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />ዚ የባረወ መሳ የኢየሱስ በወቅና አቸለፎም ያቦይኸም ይሒር ስለኸነው። <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />በዚም ይበዛ ጲላጦስ በፍርድ ወንበር ቾናም ትናነ ምሽተሑ፦ “በሑቲ መሳ ኧኳ ምሳር በብርዛዝ ብዠ ተስቃየሑም በዛ በንጡ ሰብ ᎈር አትም አትሸክትወኸም” ትትብር ላኸትወ። <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />ቢኸንም የካሕናት አለኦች ባሊቆችም “በርባን ይᎈቸኖኸም ኢየሱስም ይቈጥሪኸም” ይጮቅሶዬ የሕዝቢ ያግባቦዮ ባነ። <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />ገዢዪም “ተዄቲ ኤቲዋኘ ኧፈታንኩኸም ትሸዎ?” ቲብር የሕዝቢ ዠበረም ተሳለ። ሕኖም “በርባን ትፈታንነኸም ኧሸነ” ቲብሮ ዠበሮ። <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />ጲላጦስም፤ “ኧጌ ክርስቶስ የቧሪዪ ኢየሱስሽ ምን ንሰኩች?” ባረኖ። እንም፤ “የስቁሪ!” ባሮ። <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />ገዢዪም የመአር? “ሑቲ የሸኰተን በደል መአሩ?” ባረኖ። ሕኖም “የስቁሪ!” ቲብሮ አበዞም ው ባሮ። <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />ስለኸነም ጲላጦስ ዚ ዘንጋ ሕላት ያትኔሳኸም አንኸንም እንጐድ አትም ኤይጠቅምኸም ባዠ ግዝየ ኧጋ ነሣም “እያ የዚ ሰብ ሞት አላፊ አንከንሑ፤ አላፊነተሑ ያሑቱ!” ባረም በሕዝቢ ኢፍት ኧጀሑ ታጠበ።<note caller="-" style="x"><char style="xo" closed="false">27፥24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">ዘዳ. 21፥6-9</ref>። </char></note><verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />ሕዝቢ እንም “በሑቲ ሞት መሳ ይቸኚ ቅጣት ቢና በዴንጋናም ᎈር የሕን” ባሮ።<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />በዛ ግዝየ ጲላጦስ በርባን ፈታም ገፈረኖ፤ ኢየሱስም ባጌረᎈን አንቌ ይሰቀርኸም አቸለፈም አበኖ።<verse eid="MAT 27:26" /></para>
  <para style="s1">ኢየሱስ በሮማውያን ወታደሮች ኧጅ</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15፥16-20</ref>፤ <ref loc="JHN 19:2-3">ዮሐ. 19፥2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />በዛ ግዝየ የገዢዪ ወታደሮች የኢየሱስ ተገዢ ግቢዬ ወሰዶይ፤ ወታደሮቺም እንም በኢየሱስ ዙራ ስበሰቦ። <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />ልባሰሑ አወጦም ብሻ ልባስ አለበሶይ። <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />የሶክ አክሊልም ታቶም በጉነነሑ ᎈር አወኖᎄ፤ በከነ ኧጀሑ የሸምበቆ ዘንግ አጠበጦይ፤ ቢፍተሑ ተንምብረከኮም “የአይሑድ ንጉሥ! ሰላም ያኸ የሕን!” ቲብሮ ያፌዞᎄ ባነ፤ <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />እንባቌሕኖ ይተፎᎄ ባነ፤ የሸንበቆዪ ዘንግ በጀሑ ወሰዶም ጉነን ጉነነሑ ይወኮይ ባነ። <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />ባፌዞᎄ አንቌ ብሻዪ ልባስ አወጦም የነብሰሑ ልባስ አለበሶይ፤ ይሰቅሮዬ ጠበጦይም ወሮ።<verse eid="MAT 27:31" /></para>
  <para style="s1">የኢየሱስ ወሰቀር</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15፥21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፥26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሐ. 19፥17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />ተገዢዪ ግቢ ቲወጦ ትናኖ ስምዖን የቧሪዪ የቀሬና ገኝ ሰብ ረከቦይም የኢየሱስ መስቀል ይጮርኸም የግድ ባሮይ። <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />በዛ አንቌ ትርጉመሑ “የራስ ቅል” ተኸነዬ ተጎልጎታዬ ሰሎ። <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />በዛም ታᎀታጌ የቁላቌሊ የወይን ደጔ ይሰጭኸም የኢየሱስ አቀረቦነ፤ ሑቲም ቀመስ አበኘም ይሰጭኔ አንሸ።<note caller="-" style="x"><char style="xo" closed="false">27፥34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>። </char></note> <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />ኢየሱስም በሰቀሮይ አንቌ ልባሰሑ ኧጣ አደጎም ተሳዶይ።<note caller="-" style="x"><char style="xo" closed="false">27፥35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">መዝ. 22፥18</ref>። </char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />በዛዬ ቾኖም ይቅሮይ ባነ። <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />የከሰሰወዪ ወንጀል ያምለክት፥ “ዚ የአይሑድ ንጉሥ ኢየሱሱ?” ይብር ጡሑፍ በመስቀሊ ጉነኔ ᎈር አወኖይ። <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />በዛ ግዝየ ተኢየሱስጌ ዄት ወንበዴ አቲ በከነ አቲ በጉራ ሰቀሮዮ።<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />በᎀረሑ ይቸለፎ የነበሮዪ ሰቦች በወናቅ ጉነነሕኖ ቲያንቃንቆ፥<note caller="-" style="x"><char style="xo" closed="false">27፥39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">መዝ. 22፥7</ref>፤ <ref loc="PSA 109:25">109፥25</ref>። </char></note> <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“አኸ የቤተ መቅደሲ ታፈርስም በሦት ከነ ትሸኩች! እንዴ ነብሳኸ አትርፍ! የእዝጌር ትኸ በኸንከ እንዴ በመስቀሊ ውረድ!” በወበር ያፌዞᎄ ባነ።<note caller="-" style="x"><char style="xo" closed="false">27፥40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቴ. 26፥61</ref>፤ <ref loc="JHN 2:19">ዮሐ. 2፥19</ref>። </char></note><verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />በዛምኸማት የካሕናት አለኦች የሕጊ አስተማሪ ተባሊኦችጌ እኪ ቲብሮ ያፌዞᎄ ባነ፤ <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“እንጐዲ አተረፈ፤ ነብሰሑም ዋትርፍ ኤይችል! ሑቲ የእስራኤል ንጉሥ በኸነ እንዴ ኧሗ በመስቀሊ የውርድ፤ ኢናም ንምነᎄ! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ሑቲ በእዝጌር ታመነም፤ ‘የእዝጌር ተኸንኩ’ ባረም፤ ስለኸነም እዝጌር ይወጅጅ በኸነ እንዴ ኧሗ ያትርፉ!”<note caller="-" style="x"><char style="xo" closed="false">27፥43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">መዝ. 22፥8</ref>። </char></note> <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />ዛምኸም ተሑቲጌ የሰቀሮዪ ወንበዴ ይሰድቦይ ባነ።<verse eid="MAT 27:44" /></para>
  <para style="s1">የኢየሱስ ወሙት</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15፥33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፥44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሐ. 19፥28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />በስድስት ሰዓት ቀረሰም ዠጠ ሰዓት ስን ባፈር እንም ጨለማ ኸነ። <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />ዠጠ ሰዓት ቲኸን ኢየሱስ፦ “ኤሎሔ! ኤሎሔ! ላማ ሰበቅታኒ?” ቲብር በወደል ጣምባ ው ባረ፤ ትርጉመሑ “አምላከኛ! አምላከኛ! የመአር ገፈርኬ?” ወበሩ።<note caller="-" style="x"><char style="xo" closed="false">27፥46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">መዝ. 22፥1</ref>። </char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />በዛም ቈሞም በነበሮዪ ሰቦች አታቲ ዚ ሰሞም “ዚ የኤልያስ ይጠራኑ!” ባሮ። <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />በዛ ግዝየ ተሕኖ አቲ ሰፍነግ አቸኘም ሖምጣጤ ᎀላወ፤ በመቃ ᎈር ሸከተም ኢየሱስ ይሰጭኸም አቀረᎄነ።<note caller="-" style="x"><char style="xo" closed="false">27፥48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">መዝ. 69፥21</ref>። </char></note> <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />እንጐዲም “አክስ እንዴ ኤልያስ ቸኘም ያተርፉ የኸነኸም ንዥነ!” ባሮ። <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />ኢየሱስ ዠበረም በወደል ጣምባ ው ባረም ነብስያሑ አበ።<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />በዛ ግዝየ የቄደሰዪ የቤተ መቅደስ መጋረጃ በነን ቀረሰም ተቴ ስን ዄቴ ተገደደ፤ አፈሪም ተንቅጠቀጠ፤ አለቲም ተስንጣጠቀ፤<note caller="-" style="x"><char style="xo" closed="false">27፥51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ዘፀ. 26፥31-33</ref>። </char></note> <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ቀብሮቺ ተከፈቶም ᎀቶም የነበሮዪ ቅዱሳን ሰቦች ብዠ ሕኖ በሞት ተነሶ። <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />በቀብሪ በወውጣ ተኢየሱስ ትንሣኤ አንቌ ተቅድስት ከተማ ተኢየሩሳሌሜ ገቦም የብዠ ሰቦች ታዞ። <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />የመቶ አለአዪም ተሑቲጌ የኢየሱስ ይቅሮይ የነበሮዪ የአፈሪ ወናወጥ የኸነዪም ቃር ባዞ ግዝየ ስርም ጔኖም “የኢንም ዚ የእዝጌር ትኸ ባነ!” ባሮ። <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />በሩቄ ኸነማም ይምሌከተማዪ ብዠ ኧንሽታም በዛ ባነማ፤ ሕነማም በገሊላ ከተማ ቀረሰማም የኢየሱስ ቲያግለግለማ ይትዄተለማ የነበረማነማ። <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />ተሕነማም ግብት መግደላዊት ማርያም፥ የያዕቆብ የዮሴፍም ዳኮ ማርያም የዘብዴዎስ ዴንጋ ዳኮ ይነብረማ ባነ።<verse eid="MAT 27:56" /></para>
  <para style="s1">የኢየሱስ ወቀበር</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15፥42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፥50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሐ. 19፥38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />በመሸ ግዝየ ዮሴፍ ይቡሪዪ አት የአርማትያስ ከተማ ዱሬሻ ሰብ ተዛዬ ቸኘ፤ ሑቲም የኢየሱስ ደቀ መዝሙር ባነ፤ <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ዚ ሰብ፥ ተጲላጦሴ ወረም የኢየሱስ ሬሳ ጮቀሰ፤ ጲላጦስም ሬሳዪ ይᎅኸም ኤዘዘ። <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />ስለኸነም ዮሴፍ የሬሳዪ አወረደም በንጡ አᎄጀጄ ጨርቅ ኬᎈነን። <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ባለት ተወቀረም በዝጋጀዪ በነብሰሑ ገደር ቀብር ውስጥ ቀᎄረን፤ በዛ አንቌ ወደል እምን አንክባለለም የቀብሪ ወዝገብ አጨም ወረ። <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />መግደላዊት ማርያምም እንጐዴታ ማርያም፥ በዛ በቀብሪ ኢፍት ሊፍት ቶነማም ባነ።<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />የመናጊ ቅዳንሰምበት፥ የካሕናት አለኦች ፈሪሳውያን ቁናዬ ተጲላጦሴ ወሮም እኪ ባሮይ፦ <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />“ጔታ! ዛ ያሰሰት ገና በሕይወተሑ ትናነ ‘ተሦስት ከነ አንቌ ተሞት ኧትነሳ’ የቧረኒ ተዜገደነ።<note caller="-" style="x"><char style="xo" closed="false">27፥63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቴ. 16፥21</ref>፤ <ref loc="MAT 17:23">17፥23</ref>፤ <ref loc="MAT 20:19">20፥19</ref>፤ <ref loc="MRK 8:31">ማር. 8፥31</ref>፤ <ref loc="MRK 9:31">9፥31</ref>፤ <ref loc="MRK 10:33-34">10፥33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9፥22</ref>፤ <ref loc="LUK 18:31-33">18፥31-33</ref>። </char></note> <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />ስለኸነም ደቀ መዛሙርተሑ ወሮም ኤይሰርቆይኸም የሕዝቢም ‘ዘ፥ በሞት ተነሣም’ ኤይብሮኸም ቀብሪ ሦስት ከነ ስን ይቁሬኸም ኧዝዝ፤ ባንኸነም ያንቌዪ ዋሰሰት ተመጀመሪያዪ ይብስ የባሰ ይኸን።” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />ጲላጦስም፤ “ይቅሮዪ ነነናሑ፤ ወሮም ብትሒሮይ ኤማ አትቀሮ” ባረኖ። <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />ስለኸነም ወሮም እምኒ በማተብ ኤሸጎም ቀብሪ በወታደር አትቅሮይ።<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">የኢየሱስ ተሞት ወተንሣ</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16፥1-10</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፥1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሐ. 20፥1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />ሰምበት <note caller="+" style="f"><char style="fr" closed="false">28፥1 </char><char style="fk" closed="false">ሰምበት፦ </char><char style="ft" closed="false">በዚ ᎈር ሰምበት የቧሪዪ ቅዳንሰምበቱ። </char></note> ባለፈ አንቌ በሳምቲ በመጀመሪያዪ ከነ<note caller="+" style="f"><char style="fr" closed="false">28፥0-1 </char><char style="ft" closed="false">ወይም ውርሰምበት። </char></note> ቅረር በሱቢ መግደላዊት ማርያምም ኧንጐዴታኒ ማርያም ቀብሪ የወዥ ወረማ። <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />ዘ፥ ሒንጌም ወደል የአፈር ወትናወጥ ኸነ፤ የጔታ መላይካ በሰሜ ወረደም ቀብሪ ያጭᎄዪ እምኒ አንክቧለለንም በᎈረሑ ቾና። <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />የመላይካዪ ኢፍት የብራቅኸም ያበራ ባነ፤ ልባሰሑ የበረድኸም ነጨ ባነ። <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ይቅሮዪ የመላይካዪ በወገና የትነሳ በዋንገድግድ የᎀቶኸም ኸኖ፤ <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />መላይካ የእንሽታዪ እኪ ባረነማ፤ “አሕማሽ አትጔነማ፤ የሰቀረዪ ኢየሱስ ትሸወማኸም ኧሒር፤ <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ሑቲ በዚ ኤነ በደረም የዝነጔንኸም ተነሳም። ተቀበረወም የነበረወዪ መደር ኔሕማም ኧዘማ። <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />ኧጌሽ አተክለማም ወረማም የደቀ መዛሙርተሑ ‘በሞት ተነሣም፤ በደረናሑም ተገሊላዬ በደረናሕማም ያር፤ በዛ ታዘማይ’ በረማም አውደማዮ። ኧጌሽ ኤወደክሕማም!” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />በዛ አንቌ ኧንሽታዪ በወጔና በወደል ብልቃት በቀብሪ አቴከለማም ወረማ፤ የደቀ መዛሙርተሑም ይውደማዬ ሮጠማ።<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />ኢየሱስ ቤማ ረከበነማም “ሰላም ያሕማ የሕን!” ባረነማ። ሕነማም ተሑቲዬ ቀረበማም ኧግረሑ ጠበጠማም ሰገደማነ። <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />በዛ ግዝየ ኢየሱስ፦ “አትጔነማ! ወረማም ተገሊላዬ ያሮኸም የጐባቢተኛ አውደማዮ፤ ያዞኝም በዛዬው” ባረነማ።<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />ኧንሽታዪም ቲያረማ ትናነ ተወታደሮቺ አታቲ ተከተማዬ ወሮም የኸነዪ ቃር እንም የካሕናት አለኦች ኤወዶማዮ። <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />የካሕናት አለኦች ተባሊኦችጌ ተስበሰቦም በትማከሮ አንቌ የወታደሮቺ ብዠ ዋጋ አቦዮም እኪ ባሮዮ፤ <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />“‘ኢና ተገደርነም ትናነ ደቀ መዛሙቲ በምሳር ቸኖም ሰረቆም ጠበጦይም ወሮ’ በሮማሑ የሕዝቢ አውዶዮ። <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />ዚ ገኝ ገዢዪ የሰማ በኸነ ኢና ዘንጋሑ የሑቲ አትሬዳነም በዋተምን ባሑ ᎈር ምካት ኤሰላብኩኸም ኧሸክትነ።” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />ስለኸነም ወታደሮቺ ዋጋ ተቄበሮም ልክ ዬወደኖኸም ሸከቶ፤ ዚም ዘንጋ ኧኳ ስን አይሑድ እንም በዋበትት ይቴወድ።<verse eid="MAT 28:15" /></para>
  <para style="s1">ኢየሱስ የደቀ መዛሙርተሑ የታዠኸም</para>
  <para style="r">(<ref loc="MRK 16:14-18">ማር. 16፥14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፥36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሐ. 20፥19-23</ref>፤ <ref loc="ACT 1:6-8">ሐዋ. 1፥6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15፥3-8</ref>)<note caller="-" style="x"><char style="xo" closed="false">28፥16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቴ. 26፥32</ref>፤ <ref loc="MRK 14:28">ማር. 14፥28</ref>። </char></note></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />ዐሥራ አቲ ደቀ መዝሙር ኢየሱስ ያሮኸም ታምሌከተኖዬ፥ በገሊላ ቲትረከቢ ቈቶዬ ወሮ። <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />ባዞይም ግዝየ ሰገዶነ፤ አታቲም ተጥራጠሮ፤ <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />ኢየሱስ ተሕኖዬ ቀረበም እኪ ባረኖ፤ “ሥልጣን እንም በሰሜ ባፈርም አቡኝም፤ <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />በይሽ ተዓለም ሕዝቤ እንም ወሮ፤ በአብ፥ በወልድ፥ በመንፈስ ቅዱስ ሽም ትታጠምቆዮ ይያ ደቀ መዛሙርት ሰክቶዮ።<note caller="-" style="x"><char style="xo" closed="false">28፥19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ሐዋ. 1፥8</ref>። </char></note> <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />ዬዘዘኩሑዪም እንም ይፌጥሞኸም አትመሮዮ! ዘ፥ እያ የዓለም መጨረሻ ስን እንጌ ታሑጌንኩ።”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>