<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">Mesqan New Testament 2 PETER</book>
  <para style="h">2 የጴጥሮስ መልክት</para>
  <para style="toc1">ዄታለኘዪ የሐዋርያዪ የጴጥሮስ መልክት</para>
  <para style="toc2">2 የጴጥሮስ</para>
  <para style="toc3">2 ጴጥ.</para>
  <para style="mt">ዄታለኘዪ የሐዋርያዪ የጴጥሮስ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ዄታለኘዪ የሐዋርያዪ የጴጥሮስ መልክት የጣፈዪ በትልያየ መደር ይትረከቦዪ የድረ ክርስቲያኖችኖ። የመልክቲ ዋና ዓላማ የባጢለተኞች አስተማሪ ቡሼ ሜና የሕኖም ትምርት አትምሌከተም የትኸለቀዪ የብልግና ሕይወት ወቃወሙ። የጠሮዮዪ ምካቶች መፍትሔ ይኸኒ የኢየሱስ ቤነሕኖ ያዞዪ ቲያትመርም ብዝነሕኖ የሰሞዪ ሰቦች ባችላለፎይ ትምርት መሳ የእዝጌር የጔታ ኢየሱስ ክርስቶስ ተጨባጭ ውቀት የወርክቡ። ጠሐፊዪ በትለየ ጥንቃቄ የሸከተዪ “ክርስቶስ ተዠበረም ኤቸኝ” ይቡኒ ስለኸነ የባጢል ትምርቱ፤ ዚም አትምሌከተም ቲዝነግ “ክርስቶስ ተዠበረም ተወተኝ ዬክሲ እዝጌር ሰብ እንም ተአጢያተሑ ይዠበርከም አንከንም ሟንም ሰብ ይጠፋኸም ኤሸ ስለኸነው” ይብር።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="2PE 1:1-2">1፥1-2</ref></char></para>
  <para style="io1">የክርስቲያን ጥሪ <char style="ior"><ref loc="2PE 1:3-21">1፥3-21</ref> </char></para>
  <para style="io1">ባጢለተኞች አስተማሪ <char style="ior"><ref loc="2PE 2:1-22">2፥1-22</ref></char></para>
  <para style="io1">የክርስቶስ ዠበረም ወተኝ <char style="ior"><ref loc="2PE 3:1-18">3፥1-18</ref> </char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />የኢየሱስ ክርስቶስ አገልጋይ ሐዋርያም ተኸነዪ ተስምዖን ጴጥሮስ፥</para>
  <para style="p" vid="2PE 1:1">ተአምላከና ተጭዛናም ተኢየሱስ ክርስቶስ ቢትረከቢ ጽድቅ መሳ ኢና የረከብነይ እምነትኸም ያነ የከበረ እምነት የረከብኩ፤<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />እዝጌር ጔታናም ኢየሱስ በወሐር ጸጋ ሰላም የብዛንኩ።<verse eid="2PE 1:2" /></para>
  <para style="s1">የእዝጌር ጥሪ ምርጫ</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />በክብረሑ በፈይነተሑም የጠራነ የሑቲ በወሐረና መለኮታዊ ቆተሑ የሕይወት እዝጌር የዋምልክም ያሸነዪ እንም አበነም። <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />በክብረሑ በሜናነተሑም የከበረ ጄዛ ያነኒ ስርም ንቅ የኸነዪ ተስፋውታን ረከብነም፤ በዚሕኖ መሳ አሑ በቡሼ ኤላት መሳ በዚ ዓለም ታነዪ ጥፋት አመለጥኩም የመለኮታዊ አመል ይሰድ ኸንኩም። <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />በዚ መሳ ይቄጥሎዪ ቃር ይደበሮንኩኸም ተጋደሎ፦ በእምነት ᎈር ፈይነት፥ በፈይነት ᎈር ውቀት <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />በውቀት ᎈር ነብስ ወቁጣጠር፥ በነብስ ወቁጣጠር ᎈር በትግሥት ወጥና፥ በትዕግሥት በወጥና ᎈር እዝጌር ዋምልክ፥ <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />የእዝጌር በዋምልክ ᎈር የጐባቢት ወትዋደድ፥ በጐባቢት ወትዋደድ ᎈር ፍቅር ድብሮ። <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />ነዚ ቃር በብዛት ቢነብሮኩ ጔታና ኢየሱስ ክርስቶስ የወሐር አትድገልሎ ፍርየ ዬነናሑ አትኸኖኸም ይቅሮኩ። <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />ነዚሕኖ ዓመሎች ዬኖዪም የሩቄዪ ኤያዥም ወዥ ኤይችሊው፤ ተበደረዪ አጢያተሑ ነጣ ወሕነሑ ረሳም።<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />ስለኸነም ጐባቢት! ወጠራሑ ወትመጠራሑም የዋርጋግጥ አበዛሑም ቴሎ ሕኖ፤ ዚ ብትሸክቶ ስርም አትስናከሎ። <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />በዚኸማት የዘላለም ተኸነዪ ተጔታናም ተጭዛናም ተኢየሱስ ክርስቶስ መንግሥቴ የወግባ ሙላ መብት ይቡኩ።<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />ነዚ ዘንጋ ብትሒሮዮ በጠበጥኩይ የኢን ጠናሑም ብትነብሮ ሕኖ ያሑ ተዋስብ በጭ አንብር።<verse eid="2PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 1:13" />በዚ ሕይወት ያነሑወ ግዝየ ስን ያሑ እንጌ ዋንቃቃ ሱት መሰረም ይታዤ። <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />ጔታና ኢየሱስ ክርስቶስ የገለጠኒኸም ሒንጌም ከሞ በዚ ዓለም በሞት ኧትላኝኸም ኧሒር። <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />እያ ኧሗ ኧትጋደል በሞት በትላኘኩሑ አንቌ ነዚ ቃር እንጌ ዋስታውስ ትችሎኸሙ።<verse eid="2PE 1:15" /></para>
  <para style="s1">የክርስቶስ ክብር ዬንም ምስክሮች</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />የጔታና ኢየሱስ ክርስቶስ ቆት ተዠበረም ወተኘሑ ቤወድነኩ ግዝየ ነብሰና ግርማሑ ቤነና አዠነም ኧምሰክርነ አንኸንም በሰብ ተንኰል የቴቀደዪ ተረት ተዄተልነም አንከነ። <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />መሳሑም “በሑቲ ኧትብላለቅ ኧወጅጂ ትኸኛ ዚቱ!” ይብር ጣምባ በእዝጌሬ ክብር በቸኘነ ግዝየ ተእዝጌር አብ ክብር ሞገስም ተቌበረም። <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />ተሑቲጌ በትቄደሰዪ ቈቶ ᎈር በነበርነᎄ ግዝየ ዚ በሰሜ የቸኘዪ ጣምባ ኢና ነብሰና ሰማነም።<note caller="-" style="x"><char style="xo" closed="false">1፥17-18 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">ማቴ. 17፥1-5</ref>፤ <ref loc="MRK 9:2-7">ማር. 9፥2-7</ref>፤ <ref loc="LUK 9:28-35">ሉቃ. 9፥28-35</ref>። </char></note><verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />ዚ እንም ነብዮች የዝነጎዪ የኢን ወሕነሑ ብዠ ያርጋግጦንነ፤ ስለኸነም በጨለማ መደር ይበራ መብራት ጥንቃቄ ትሸክቶነኸም ነብዮች የዝነጎዪም ጥንቃቄ ሰክቶ፤ ዚም ትሸክቶ ጬት ይወጣ ስን የዛኘት ኰኰብ በሒናሑ ይገለጥ ስኑ። <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />ትንም ኢፍቴ ዋጥራምት ይጌባሑ በቅዱስ መጽሐፍ ይትረከቢ ሟንመሑ ትምቢት ሟንም ሰብ በራሰሑ በግል አስተሳሰብ ይትረጉᎂ ኤይችል ወሕነውታው። <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />ሟንመሑ ትምቢት በሰብ ፈአድ ስርም አንተኘ፤ ቢኸንም ትምቢት በመንፈስ ቅዱስ የትመሮ ሰቦች በእዝጌር ተቌበሮም የዝነጎዩው።<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s1">የባጢለተኘ አስተማሪ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />ቢኸንም በበደረዪ ዘበን በሕዝቢ ግብት ባጢለተኞች ነብዮች የነበሮኸም፥ ዚምኸም ባሑ ግብት ባጢለተኞች አስተማሪ ይነብሮ፤ ሕኖ ጥፋት ያትሔትል የባጢለተኘ ትምርት በሽሙቸ ይስራጭኸም ይሸክቶ፤ የዋጀኖዪ ጔታ ለጎም የፈጠነ ጥፋት በነብሰሕኖ ያቸኖ። <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />በዚኸማት ብዠሕኖ የሕንም ያትማልል ኤማ ይትዄተሎ፤ ተሕኖም ቢሸክቶዪ የትነሣ የኢን ኤማ ይሰደብ። <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />ነዚ ባጢለተኞች አስተማሪዎች የዋጋ ተወስገብገበሕኖ የትነሣ ነብሰሕኖ ያዝጋዶዪ ታሪክ በወዘንግ ይብዘብዞኩ። ተብዠ ዘበን ኢፍቴ ቀረሰም ፍርድ ተዝጋጀኖም፥ ጥፋትም ዮንም ይቂየኖ!<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />መልክት አጢያት በሸከቶ ግዝየ እዝጌር ቴያዝንኖ በጨለመ በትዀኘ ጐጀ ውስጥ ኸኖም የፍርድ ከነ ይቅሮኸም ተፍርድ እሳቴ<note caller="+" style="f"><char style="fr" closed="false">2፥4 </char><char style="ft" closed="false">በግሪኪ ቋንቋ</char><char style="fqa" closed="false">ታርታሩስ </char><char style="ft" closed="false">ይቡን</char></note> አደገኖ፤ <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />ዛምኸም ጽድቅ ይሰብክ የነበረዪ የኖሕ ትንጐድ ሰበት ሰብጌ አተረፈም የእዝጌር ኤያመልኮ ሰቦች በነበሮᎄ ዓለም ᎈር ያጠፋ ኧጋ ቲያቸኝ አዘነም የበደረዪ ዓለም አሟረን፤ <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />ኧሗም አጢያት ይሸክቶዪ ምሳሌ ይኸኖኸም የሰዶም የገሞራም ከተሞች ዐመድ ይኸኖ ስን አነደደም በፈረደቦ፤<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">ዘፍ. 19፥24</ref>። </char></note> <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />በሕገ ወጦች ያትማልል ሜና ቲሳቀቅ ይነብር የነበረዪ የጻድቂ የሎጥም አተረᎈን፤<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-16">ዘፍ. 19፥1-16</ref>። </char></note> <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />ዛም ጻድቅ ሰብ በግብተሕኖ ቲነብር ከነ በከነሑ ያዠኒም ይሰሟን በነበረዪ ሕገ ወጥ ሜናሕኖ ጻድቅ ነብስያሑ ይጨነቅ ባነ። <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />ኧጌሽ ዚ እንም እኪ በኸነ ጔታ የሑቲ በዋምልክ ይነብሮዪ ሰቦች ተፈተና ያተርፎኸም የአጢያተኞቺ ምንኸም ይቀጣኸም የፍርድ<note caller="+" style="f"><char style="fr" closed="false">2፥9 </char><char style="fqa" closed="false">ዐመጠኞች የወቅጣ የፍርድ ከነ ስን</char></note> ከነም ምንኸም ቂየም ያቴክሶኸም ይሒር ወበሩ። <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />በተለይም ነዛሕኖ ሩክስ የኸነዪ የበሠር ኤላተሕኖ<note caller="+" style="f"><char style="fr" closed="false">2፥10 </char><char style="fqa" closed="false">የአጢያተኘ አመለሕኖ</char></note> ይትዄተሎዪም የእዝጌር ሥልጣን ይገርጦዪ የፍርድ ቂየም ያቴክሶ።</para>
  <para style="p" vid="2PE 2:10">ነዚ ባጢለተኘ አስተማሪዎች ደፋሮች ትዕቢተኞችም ስለኸኖ የሰሜ ሥልጣናት ቲሰድቦም ኤጔኖ። <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />መላይካ ተሕኖ በቆት በሥልጣን ይበዞ ቢኸንም በጔታ ኢፍት በሕኖ ᎈር ስድብ የመላወ ክስ ኤያቀርቦቦ። <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />ነዚ ባጢለተኘ አስተማሪዎችም የዋጥራምት የቌመኖዪ ቃር ይሳደቦ፤ ሕኖ የወደመድ የወቅጥርም የጨኖኸም፥ በኸልቀት ስሜት ይነብሮኸም አይምሮ ዬነኖም የእንሰሶችኖ፤ እንሰሶቺ ይጠፎኸም ሕኖም ስርም ይጠፎ። <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />የዐመጣሕኖ ይጌቧኒ የዐመጥ ጄዛ ይቄበሮ፤ በጠራራ ጬት ቲፍነጥዞ የብልቃትኸም ይቆጥሮይ፤ በግብዣ ᎈር ትናኖ ነውረኞች ሩክስ ኸኖም ታሑምጌ በፍቅር ግብዣ ᎈር<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="ft" closed="false">ባታት ቅጂዎች </char><char style="fqa" closed="false">በፍቅር ግብዣሕኖ ᎈር </char><char style="ft" closed="false">ይብር ኤነ።</char></note> ይቾኖ፤ <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />ምንዝር የᎀላቦ አጢያት ተወሰክት ኤይገፍር ዔን ነነኖ፤ ኤይጠኖዪ ነብሳት ያብላልጦ፤ ኤላት የሮሸ ሒን ነነኖ፤ የሰደቦኖ። <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />ሕኖ ሱቲ ኤማ ገፈሮም ጠፎም፤ ቡሼ በወሰክት ይትረከቢ ጄዛ የወደደዪ የቢዖር ትኸ የበለዓም ኤማ ተዄተሎም ተሰሰቶም። <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />በለዓም ያጢያተውታ ጔሰጪም፤ ወዘንግ ኤይችል እማር በሰብ ቃል ዝነጔም የነብዪ የውስ ሜና ተቃወᎀን።<note caller="-" style="x"><char style="xo" closed="false">2፥15-16 </char><char style="xt" closed="false"><ref loc="NUM 22:4-35">ዘሑ. 22፥4-35</ref>። </char></note><verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />ነዚ ሰቦች ኧጋ ዬነቦ ምንጭኸምኖ፤ በዐውሎ ኧንፋስ ይወሰዶ ዳበናኸምኖ፤ ኤንይወጋ ጨለማም ይቂየኖ። <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />በስሕተት ቲነብሮዪ ሰቦች ግብት አመለጦም በቸኖ ገና ብዠ ያናከሶዪ ሰቦች ኤይድገልል የኸነ የትዕቢት ቃል በወዘንግ፥ በበሠር ሴሰኝነት በዋብላልጥ ያብላልጦዮ። <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />“ነጣ ትወጦ” ቲብሮ ተስፋ ይቦዮ። ሰብ ቲቌም የቌመዪ ጉዙ ኸነም ይገዛ ስለኸነ ሕኖም ነብሰሕኖ ያጢያት ጉዙዎችኖ። <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />ጔታናም ያተርፍነዪም ኢየሱስ ክርስቶስ በወሐር በዓለም ሩኩስ ባመለጦ አንቌ ተዠበሮም በዛም በሩክስ ተጠበጦም ቢቌሞ ቲፍቴዪ የጠቀለ ያንቌዪ ሐለተሕኖ የባሰ ይኸንቦ፤ <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />የጽድቅ ኤማ በሐሮ አንቌ ባᎅዮዪ ቅዱስ ትዛዝ ታንቌዬ ቲዠበሮ የባሰ የጽድቅ ኤማ ቴይሒሮ ቀኖም ቢኸን በጠቀለኖ ባነ። <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />“ዬለቈኒ የወዋጥ ጊየ ትልቈቸዄ ይዠበር።” ዛምኸም “ዐሣማ በታጠበ አንቌ ተዠበረም በጭቃራ ᎈር ይንክባልል” ይብሪ የኢን ምሳሌ ሰላቦም።<note caller="-" style="x"><char style="xo" closed="false">2፥22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">ምሳ. 26፥11</ref>። </char></note><verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s1">የጔታ ኢየሱስ የወተኝ ተስፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />ደቦዎች! ዚ ኧጠፍንኩ ዄታለኘዪ መልክቱ፤ ዄትመሑ መልክት የጣፈክንኩ ነዛ ዘንጋ በዋስታውስ ቅን አስተሳሰብ ይነብሩሑኸም አነቃሑዬ ባሑሙ። <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />ተዚ ኢፍቴ ቅዱሳን ነብዮች የዝነጎዪ ቃል ባሑ ሐዋርያትም መሳ የረከብኩዪ የጔታና ያተርፍነዪ ትዛዝ ታስታውሶኸም ኧሸ። <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />ትንም ኢፍቴ ዚ አጥራምቶ፤ በመጨረሻዎቺ ከነ ያፌዞዪ ቡሼም ኤላተሕኖ ይትዄተሎ ዘባቾች ይቸኖ፤ <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />ሕኖ “ጔታ ኢየሱስ ይቸኝ ቧሪም ተስፋ አᎅም አነበረ? ኧጌ፥ ቤቴ ነነ? የድረ አቦቸና ተᎀቶᎄ ግዝየ ነሣም እንም ቃር ተኸልቀት መጀመሪያ ቀረሰም የነበረኸሙ” ይብሮ። <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />ነዚ ሰቦች ተብዠ ዘበን ኢፍቴ ሰሜ በእዝጌር ቃል ወትኸለቀሑ አፈርም የሸከተ ተኧጋ በኧጋም ወሕነሑ ኸነ ባሮም ይለጎ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">ዘፍ. 1፥6-9</ref>። </char></note> <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />በዛ ግዝየ የነበረሚ ዓለም በኧጋ ተጥልቀለቀም ጠፋ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 7:11">ዘፍ. 7፥11</ref>። </char></note> <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />እዝጌር ኤያመልኮ ሰቦች ኧሗ ያኖ ሰሜ ተአፈርም ይጠፎᎄ የፍርድ ከነ ስን የሳት ተቅሮም ዬክሶ።<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />ደቦዎቸኛ! አሑም በጔታዬ አት ከነ የሺ ዓመትኸም፥ ሺ ዓመት ያት ከነኸም ወሕነሑ ዚ አት ቃር አትርሶ።<note caller="-" style="x"><char style="xo" closed="false">3፥8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">መዝ. 90፥4</ref>። </char></note> <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />አታት ሰቦች ይመስሮኸም ጔታ የዝነጔኒ የተስፋ ቃል የወፈጥም ኤዬክስ፤ ቢኸንም ሰብ እንም ንስሐ ይገባኸም ሟንም ሰብ ኤይጠፋኸም ሸም ስላሑ ይታገሥ።<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />የጔታ ከነም የሌባኸም ሒንጌም በድንገት ይቸኝ፤ በዛ ከነ ሰሜዪ በወደል ጣምባ ይቸለፎ፤ ኸልቀት እንም በሳት ነደደም ይጠፋ። አፈር በሑቲም ᎈር ያነዪ ቃር እንም ይነድ፤<note caller="-" style="x"><char style="xo" closed="false">3፥10 </char><char style="xt" closed="false"><ref loc="MAT 24:43">ማቴ. 24፥43</ref>፤ <ref loc="LUK 12:39">ሉቃ. 12፥39</ref>፤ <ref loc="1TH 5:2">1 ተሰ. 5፥2</ref>፤ <ref loc="REV 16:15">መና 16፥15</ref>። </char></note> <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />ኧጌሽ ነዚ እንም ዘንጋ በዚ ሐለት ይጠፎ በኸነ፥ ኧጌ፥ አሑ በቅድስና የእዝጌር በዋምልክ ወንብር ምንኸም ኤይጌባሑ? <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />ኧጌሽ የእዝጌር ከነ ወተኝ በወቦርስ ትቀቀሮ ከሞ ይቸኝኸም ትሸክቶ ሕኖ፤ በዛ ከነ ሰሜ በሳት ነደደም ይጠፋ፤ ኸልቀቲም በሳት ሙቀት ይቀልጦ፤ <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />ቢኸንም ኢና ባበነ ተስፋ መሠረት የጽድቅ ሜና ይምሰረትወዪ ገደር ሰሜ ገደር አፈርም ኧቂየነ።<note caller="-" style="x"><char style="xo" closed="false">3፥13 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፥17</ref>፤ <ref loc="ISA 66:22">66፥22</ref>፤ <ref loc="REV 21:1">መና 21፥1</ref>። </char></note><verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />ስለኸነም ደቦዎች! ዚ እንም ይኸንወ ከነ በወቀየ ᎈር ታነሑ፥ ጔታ ያለ ወግርጥ ወይ ያለ ናጫ ኸንኩም በሰላም ይረሕብሑኸም በወጋደል ንበሮ፤ <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />የጔታናም ትዕግሥት ያሑ የዋትርፍ ወሕነሑ ሐሮ፤ የትወደደዪ ጐቤና ጳውሎስም ባᎅዪ ብላት ቅጫን የጣፈንኩ ዚቱ። <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />ሑቲ ስለዚ ወባጀ በመልክቶቸሑ እንም በዚኸማት ጣፈም፤ በመልክተሑ ውስጥ አታት የወሐር ያትሜኮ ቃር ነኖ። ውቀት የቀበለኖ ይውላውሎዪም እንጐዲ ቅዱሳት መጻሕፍት ያጣምሞኸም ነዚሕኖም ዘንጋ ያጣምሞ፤ ዚም ይሸክቶ የጥፋተሕኖው።<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />አሑም ደቦዎች! ዚ በደርኩም የሐርኩ ስለኸነ በዐመጠኞቺ ስተት ተሻብኩም ቲይውላውሊ አቋማሑ አትወጥቆኸም ተቀሮ፤ <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />ይልቅሽ በጔታናም በጭዛና በኢየሱስ ክርስቶስ ጸጋ የሑቲም በወሐር ከፍ ከፍ በሮ፤ የሑቲ ኧሗም የዘለዓለምም ክብር የሕን! አሜን።<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>