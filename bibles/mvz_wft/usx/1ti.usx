<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">Mesqan New Testament</book>
  <para style="h">1 ተጢሞቴዎሴ</para>
  <para style="toc1">የመጀመሪያዪ የሐዋርያዪ የጳውሎስ መላክት ተጢሞቴዎሴ</para>
  <para style="toc2">1 ተጢሞቴዎሴ</para>
  <para style="toc3">1 ጢሞ.</para>
  <para style="mt2">የመጀመሪያዪ የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተጢሞቴዎሴ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ጢሞቴዎስ የቧሪዪ አርዴ ክርስቲያን ጨኘተሑ ብንሲ እስያ ቲኸን፥ በዳኰች አይሑዳዊ፥ በአᎄች ኧሗም ግሪካዊ ባነ፤ የጳውሎስ የሜና መራርቻም በወንጌል ተልእኮዪም የቁርብ አጋዠሑ ባነ፤ ጳውሎስ የጢሞቴዎስ የጣᎈነ የመጀመሪያዪ መልክት በሦስት ዋና ዋና ዘንጋ ᎈር የትምሌከተው።</para>
  <para style="ip">ትንም በዋትበድር መልክተሑ በቤተ ክርስቲያን ውስጥ ተነሣም የነበረ ስለኸነዪ የባጢል ትምርት ያጥኔቅቅ ባነ፤ ዚም ባዘና ትምርት በግብት የአይሑድ፥ በግብት ኧሗም የንጐድ ሕዝብ አሳብ የጠበጠ ቲኸን፥ “ይታዢ ዓለም በአጢአት የትቤከለ ስለኸነ ወትርፍ ይትረከብ ይችሊ የትላኘ በኸነ ምሥጢራዊዪ ውቀትም በአታት ስንቅ በጋብቻም በወቀየው” ቢብር አሳብ ᎈር የትምሠረተ ባነ። ኧሗም መልክተሑ ስለቤተ ክርስቲያን ያትዳድሪም የአምልኮ ሥራት ትምርታዊዪ መመሪያ፥ ዛምኸም የቤተ ክርስቲያን መሪዎች ያግዞዮዪም ይነብሮዬ ይጌባ ስለኸነ አመል ቢልቢጢጦ የጠበጠው። በመጨረሻም ጢሞቴዎስ የኢየሱስ ክርስቶስ ፈያ አገልጋይ ምንኸም ይኸኔ ይጌቧንኸም በትልያዮ ማመረ ምእመናኔ ያነ ስለኸነ አላፊነት ጳውሎስ ያᎄኒ ምክር ኧረሕብነ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="1TI 1:1-2">1፥1-2</ref> </char></para>
  <para style="io1">ስለቤተ ክርስቲያን አገልጋዮችም <char style="ior"><ref loc="1TI 1:3-3:16">1፥3—3፥16</ref> </char></para>
  <para style="io1">የጢሞቴዎስ ስለአገልግሎተሑ ያᎅ ትምርት <char style="ior"><ref loc="1TI 4:1-6:21">4፥1—6፥21</ref> </char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s1">አትለኘ የሐዋርያዪ ጳውሎስ መልክት ተጢሞቴዎሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />ቢያተርፍነ በእዝጌር፥ ተስፋ በኢየሱስ ክርስቶስ ትዛዝ የኢየሱስ ክርስቶስ ሐዋርያ ተኸነ ተጳውሎስ፦<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />በእምነት የኢን ትኸኛ የኸነዪ የጢሞቴዎስ፥ ተአበና ተእዝጌር፥ ተጔታናም ተኢየሱስ ክርስቶስ ጸጋ ምረትም፤ ሰላምም የሕን።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16፥1</ref>። </char></note><verse eid="1TI 1:2" /></para>
  <para style="s1">ተባጢለተኘ የሕጊ አስተማሪዎች ያᎅ ማስጠንቀቂያ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />ተመቄዶንያዬ በወርኩ ግዝየ ዐደራ የባከኸኸም፤ አታት ሰቦች የባጢል ትምርት ኤያትመሮኸም ቴዝዞዬ በዛ በኤፌሶን ቾና፤ <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />ኧሗም ተት መጨረሻም ቴነኔ የጨኘት ታሪክ ነብሰሕኖ አቼለፎም ኤይቦኸም ኧዝዞ። ነዚሕኖ ቃር በእምነት በኸነዪ ተእዝጌር ሜና ይጠቅል ኦገት ያትንሤሦ። <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />የዚ ትዛዝ ዓላማም ተንጡ ሒን፥ በፈያ ሕሊና፥ ዛምኸም የኢኒ እምነት ይትረከብ ፍቅሩ። <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />አታቶቺ ተዚሕኖ ዘንጋ ዞር ባሮም ቴድገልል ንግግሬ ተዠበሮም። <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />የሕጊ አስተማሪ የወሕን ይሸዎ፤ ቢኸንም ይዝነጎዪ ወይ አርጋገጦም ይኦግቶነዪ ቃር ኤይሕሮ።<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />ቢኸንም ሰብ ባግባበሑ በጠቀመወ፤ ሕጊ ፈያ ወሕነሑ ኧሒርነ። <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />ኧሗም ሕጊ<note caller="+" style="f"><char style="fr" closed="false">1፥9 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ሕጊ</char></note> ያᎅ የጻድቃን ቴይኸን፤ የሕጊ ይችላለፎ የዐመጠኞች የወንጀለኞችም የእዝጌር ጊናት ዬነኖዪ የአጢያተኞችም፤ ቅድስና ዬነኖዪ የእዝጌር ይገርጦዪም፤ አባ ተዳኮሕኖም ይቀጥሮዪ፤ ሰብ ይቀጥሮዪ ወሕነሑ ኧሒርነ፤ <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />ዛምኸም የአመንዝሮች ተገሜጌ ይገደሮ ገሜዎችም፤ የሰብ ኤፈኖም በወውስድ ያስሮ ነጋዴዎች የውሸታሞች፥ በባጢል ይመሎ፤ የኢነተኘ ትምርት ተቃራኒ የኸነዪ ቃር እንም ይሸክቶዪኖ፤ <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />ዚ የሐቅ ትምርት የትባረከ እዝጌር ይያ ባደራ ባቤ ተክብር ወንጌልጌ ይስማማው።<verse eid="1TI 1:11" /></para>
  <para style="s1">የጳውሎስ ያᎅ የጔታ ጸጋ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />በአገልግሎተሑ በወሹም ታማኝ ሸከተም የቆጠሬዪም፤ ብርታት ያቤ ጔታናም ኢየሱስ ክርስቶስ አመስጉን። <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />ተዚ ኢፍቴ ተሳዳቢ፤ አሳዳጅ ዐመጠኘ የኸንኩ ብንኸንም፤ ባለወሐርም ባለወምን የሸከትኩን ስለኸነ ምረት ሸኰችኒም፤<note caller="-" style="x"><char style="xo" closed="false">1፥13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">ሐዋ. 8፥3</ref>፤ <ref loc="ACT 9:4-5">9፥4-5</ref>። </char></note> <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />በክርስቶስ ኢየሱስ ተኸኖዪ እምነት ፍቅርጌም የጔታና ጸጋ ተትርፈረፈኒም። <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />“ኢየሱስ ክርስቶስ አጢአተኞች የዋትርፍ ተዓለሜ ቸኘ” ይብሪ ቃል ሐቅ ወሕነሑ ሰብ እንም ይቌᎄሬ ይጌባ፤ ተአጢአተኞችም ዋናዪ እያትንኩ። <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />ቢኸንም ክርስቶስ ኢየሱስ በሑቲ ያምኖዪ የዘላለም ሕይወት ይቀበሮዪ ወሰን ዬነን ትዕግሥተሑ ተአጢያተኞቺ ዋና በኸንኩ ቢያ የምሳሌኸም ሸከተም ያቴዤ ምረተሑ ረከብኩ። <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />ኧጌሽ ዘላለማዊ የኸነዪ፤ ኤይᎀቲ፤ ኤይታዢ ጠለለሑ አምላክ የኸነዪ ንጉሥ ተዘላለም ዘላለም ስን ክብር ምስጋናም የሕን፤ አሜን።<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />ትኸኛ ጢሞቴዎስ! ኢፍቴ ስላአኸ በትምቢት በቴወደዪ መሠረት ዚ ትዛዝ ኢብከ፤ ዛም ሑቲም በወትኸተል ፈያዪ ገድል ትጋደልኸሙ። <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />እምነት ፈያ ሕሊናም የንብርከ። አታት ሰቦች ሕሊናሕኖ አደጎም ባር ᎈር አደጋ ሰላወም ይጠፋ መርከብኸም እምነተሕኖ አጠፎም። <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />ተሕኖ ግብት ሔሜኔዎስ እስክንድርም ይትረከቦ፤ ሕኖ በእዝጌር ᎈር የስድብ ቃል ተወዘንግ ወቆጠብ ይትመሮኸም የሼጣን አቸለፍኩም አብኩኖም።<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s1">የአምልኮ ቢምሌከት ያᎅ መመሪያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />ኧጌሽ ትንም ኢፍቴ ወጮቅስ ጠሎትም፤ ይያ ባኸም ምስጋናም የሰቦች እንም፤ የነገሥታትም የባለ ስልጣኖች እንም ይሸከትኸም አቴስብ፤ <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />ዚም በኢነተኘ መንፈሳዊ ሕይወት በቅድስናም እንም፤ በሰላም በጭጭታም ኧነብርነኸሙ። <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />ዚ በእዝጌር ቢያተርፍነ ኢፍት ያትብላልቅ ቃሩ፤ <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />ሑቲ የሰቦች እንም ይተርፎኸም የኢን ተወሐሬ ይሰሎኸም ይሸ። <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />ቁና እዝጌር ነነ፤ ኧሗም በእዝጌር በሰቦችም ግብት ቁና ያታርቅ ነነ፤ ሑቲም ሰብ የኸነ ክርስቶስ ኢየሱሱ፤ <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />የሰቦች እንም ተአጢያት የወዋጅ ነብሰሑ ቤዛ ሸከተም ያበ ሑቲቱ፤ ዚም ሱቲ ግዝየ ቲሰላ የእዝጌር የዋትርፍ ሜና ያትሬዳ ምስክርነቱ። <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />እያም የምሥራች አብሣሪ ሐዋርያም የዚምኸም የአሕዛብ የኢነተኘ እምነት አስተማሪ ኧኸንከም ሾሙኝም፤ ሐቅ ኧዝነግ፤ አንዋሽ።<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 ጢሞ. 1፥11</ref>። </char></note><verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />ኧጌሽ ገሜ ብንም መደር ያለ ማት ያለኦገት የትቄደሶ ኧጀሕኖ ጔጔር በወንሳ ይጤልዮኸም ኧሸ። <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />ዛምኸም እንሽታ በጨዋነት ነብስም በወግዛ ይትጌባ በኸነ ልባስ የልብሰማ አንከንም በሹርባም በዕንቁ ዋጋሕኖም ውድ በኸነ ልባስ ኤሽቈጥቁጠማ።<note caller="-" style="x"><char style="xo" closed="false">2፥9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 ጴጥ. 3፥3</ref>። </char></note> <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />ቢኸንም የእዝጌር ናመልክነ ይብረማ እንሽታ ይሸክተማዬ ይትጌባኸም በፈያ ሜና የድመቀማ። <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />ምሽት አደብ በወጥብጥ በወታዘዝም ትትማር፤ <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />ምሽት የገሜ ታትመርኸም ወይ በገሜ ᎈር ሥልጣን ይነብራኸም አንፈቅድ፤ ሒቲ እንቁስ ወበር ይጌባና። <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />መሳመሑ አዳም በደረም ተኸለቀም፤ ተዛ አንቌ ሔዋን ተኸለቀች።<note caller="-" style="x"><char style="xo" closed="false">2፥13 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ዘፍ. 2፥7</ref>፣<ref loc="GEN 2:21-22">21-22</ref>። </char></note> <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />ኧሗም የትብላለጠቺ የእዝጌር ሕጊ ያፈረሰቺ ምሽቲያ አንኸንም የትብላለጠ አዳም አንከነ።<note caller="-" style="x"><char style="xo" closed="false">2፥14 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">ዘፍ. 3፥1-6</ref>። </char></note> <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />የሕን አኸንም ምሽት<note caller="+" style="f"><char style="fr" closed="false">2፥15 </char><char style="ft" closed="false">ግሪኪ </char><char style="fqa" closed="false">ሒቲ</char><char style="ft" closed="false">ይብር</char></note> በእምነት በፍቅርም፤ በቅድስናም ራሴታን ትትገዛ ብትጠና ትኸ ተወጠኝ ትተርፍ<note caller="+" style="f"><char style="fr" closed="false">2፥15 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ትታደስ</char></note>።<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s1">መጋቢዎች ዳቆናትም</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />ሟንም የቤተ ክርስቲያን ዋና መሪ ወሕን<note caller="+" style="f"><char style="fr" closed="false">3፥1 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ዋና መሪ ቆጶስ ወበር የቤተ ክርስቲያን ዋና መሪ ወበሩ። </char></note> ቢሸ፤ ፈያ ሜና ይትሜና ይብሪ ቃል የታመነው። <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />ኧጌሽ የቤተ ክርስቲያን ዋና መሪ ናጫ ዬነወ፥ የቁና ምሽት ጠለለ ያገባ፥ በልክ ይነብር፥ ራሰሑ ይገዛ፥ በሥራት ይሸክት፥ ባዘና ይቌበር፥ ዋትመር ይችል፥ <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />ኤይሰክር፥ ኤይትናከስ ጨዋ የኸነ፤ ኤይጭቃጨቅ፤ ዋጋ ኤይወድ ይኸኔ ይትጌቧን። <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />ዴንጋመሑ ይታዘዞም አክባሪ ሸከተም በዋለቅ የፎለሑ አበሮስ ባግባበሑ ያትዳድር ይኸኔ ይጌባ። <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />አት ሰብ የነብሰሑ ቤት ዋትዳድር ባንካረወ፤ የእዝጌር ቤተ ክርስቲያን ምንኸም ይቂየዬ ይችል? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />በትዕቢት ተዌጠረም ዳቡሎስ በወጠቀወ ፍርድ ኤወጥቅኸም ገደር ክርስቲያን ኤይሕን። <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />ኧሗም ሽመው ኤነቀፍኸም በዳቡሎስ ወሳኸ ውስጥ ኤወጥቅኸም፤ በውጪ ባኖዪ ኤማ ፈያ ምስክርነት ይነቡሬ ያሸን።<note caller="-" style="x"><char style="xo" closed="false">3፥2-7 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">ቲቶ 1፥6-9</ref>። </char></note><verse eid="1TI 3:7" /></para>
  <para style="s1">ዳቆኖቺ</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />ዳቆኖቺም ዛምኸም የትከበሮ፣ ቃለሕኖ ኤሽጋግሮ፤ የብዠ ወይን ደጔ ኤጉመዞ፤ ያሌማ ይትረከብ ጥቅም ኤያሳድዶ ሰቦች ወሕን ይጌባኖ፤ <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />በእምነትም የጠለቀ ምስጢር በንጡ ሕሊና ወቀየ ነነቦ። <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />ሕኖም በመጀመሪያ የትፈተኖ፤ ተዛም አንቌ ናጫ ዬነቦ ኸኖም በትረከቦ በድቁንና ሜና ያገልግሎ። <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />ዛምኸም እንሽታ<note caller="+" style="f"><char style="fr" closed="false">3፥11 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ምሽተሕኖ</char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ዳቆናውያን</char></note> የትከበረማ፤ ኤዬመማ፥ በልክ ይነብረማ፥ ብንም ቃር ታማኞች ወሕን ይትጌባነማ። <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />ዲያቆናት የቁና ምሽት ምስ ወሕን ይጌባኖ፤ ኧሗም ዴንጋሕኖም አበሮሰሕኖም ባግባበሑ ያትዳድሮ ወሕን ነነቦ። <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />ባግባበሑ ያግለገሎ የነብሰሕኖ ወደል ክብርም፤ በክርስቶስ ኢየሱስ ባነኖ እምነት ብዠ ድፍረት ይረሕቦ።<verse eid="1TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />ታኸዬ ከሞ የወተኝ ተስፋ ብንሸክትም ዚ ትዛዝ ኧጠፍንከ፤ <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />ዚም ኧጠፍንከ ባቶርርም ሰቦች በእዝጌር ቤት ምንኸም ወንብር ያነቦኸም ቲሒርኸሙ፤ ቤቲም የሕያው እዝጌር ቤተ ክርስታን ዚም የኢን ኧችባንም መሠረቱ። <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />የኢን መንፈሳዊ ሕይወት ምስጢር ፍርየ ኤባን ወጥራጠር ወደሉ፤</para>
  <para style="q1" vid="1TI 3:16">ሑቲ<note caller="+" style="f"><char style="fr" closed="false">3፥16 </char><char style="ft" closed="false">አታት ቅጂዎች </char><char style="fqa" closed="false">አምላክ </char><char style="ft" closed="false">ይብር። </char></note> በጅስም<note caller="+" style="f"><char style="fr" closed="false">3፥16 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">በጅስም</char></note> ተገለጠ፤</para>
  <para style="q2" vid="1TI 3:16">በመንፈስ ጸደቀ፤</para>
  <para style="q1" vid="1TI 3:16">በመላይካ ታዠ፤</para>
  <para style="q2" vid="1TI 3:16">በአሕዛቤ ተሰበከ፤</para>
  <para style="q1" vid="1TI 3:16">በዓለም ባኖዪ ታመነ፤</para>
  <para style="q2" vid="1TI 3:16">በክብር ዐረገ።<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s1">የጢሞቴዎስ ያᎅ መመሪያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />ባንቄ ዘበን አታቶቺ እምነት ለጎም ያብላልጥ መናፍትም የአጋንትም ትምርት ይትዄተሎኸም መንፈስ ቢልቢጢጦ ይዝነግ። <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />እኪ የኸነ ትምርት ይቸኝ ሕሊናሕኖ በጋለ ብረት የጠበሰ ቅጫ በድነዘዘቦ ግብዝ ውሸተኞችኖ። <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />ሕኖ፣ ሰቦች ኤያገቦኸም ይኸትሮ፤ ያምኖም የኢንም ይሒሮ ሰቦች እዝጌር የዀለቈኒ በምስጋናም ይቌበሮዪ ኤበሮኸም ዬዝዞ፤ <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />እዝጌር የዀለቈን እንም ፈያው፤ በምስጋና በትቌበሮይ ያድጒ አትም ቃር ኤነ፤ <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />በእዝጌር ቃል በጠሎትም የትቄደሰው።<verse eid="1TI 4:5" /></para>
  <para style="s1">የክርስቶስ ፈያ አገልጋይ ወሕን</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />ዚ ትዛዝ የጐባቢት ብታቴስብ፣ በእምነት ቃልም በቌበርኰን ፈያ ትምርት ትታነጥም የክርስቶስ ኢየሱስ ፈያ አገልጋይ ትኸን። <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />የእዝጌርም ቴያከብር ኤድገልል አፈ ታሪክ ተባሊቅ እንሽታም ሲሕ፤ ይጠቅልሽ የኢነተኘ መንፈሳዊ ሕይወት የራሳኸ አሰልጥን። <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />የጅስም ብቃት ልምምድ የቀል ግዝየ ይጠቅም፤ የኢን መንፈሳዊ ሕይወት የራስ ዋሮሽ የሗሚ ኸነ ይቸኚም ሕይወት ተስፋ ያነን ስለኸነ የዄትመሑ ይጠቅም። <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />ዚ ቃል የታመነም ሙላ በሙላ ይቌበሮዬ ይትጌባው፤ <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />የዚ ባርነም ኧትጋደልነ፤ ኧቌጥነ፤ ዚምኸም የሰቦች እንም በተለይም ያምኖዪ ያተርፍ በኸነዪ በሕያው እዝጌር ተስፋ ኧሸክትነ ስለኸነው።<note caller="+" style="f"><char style="fr" closed="false">4፥10 </char><char style="fqa" closed="false">ኧጋደልነ፦ </char><char style="ft" closed="false">አታት ቅጂዎች ኧሰደብነ ይብሮ። </char></note><verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />ነዚሕኖ ዘንጋ ኧዝዝ፤ አትመር፤ <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />አርዴ በወሕናኸ ሟንም ኤናቅከ፤ ይልቅሽ በንግግር፥ በኑሮ፥ በፍቅር፥ በእምነት በንጥሕናም የአማኞች ፈያ ምሳሌ ሕን። <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />እያ ኧቸኝ ስን የዋንብብ፤ የወምክር የዋትመርም ተጋደል። <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />ሽማግሌዎች ኧጀሕኖ ባኸ ᎈር ቲጨኖ በትምቢት ያቡከዪ የጸጋ ስጦታ በጭ አታቢ። <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />ሰብ እንም ትትለቅ ያዤ በዚሕኖ ዘንጋዎች አትኩር፤ በወትጋደልም ፈጥሞ፤ <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />የሕይወታኸ የትምርታኸ ተቀየ፤ በዚሕኖም ጥና፤ ዚም ብትሸክት፤ ራሳሐ ይሰሞከዪም ታተርፍ።<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s1">የባሊኦች የመበለትም፤ የጉዙዎች ያቡዮ ምክር</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />የባለቀ ሰብ የአባኻኸም ሰክትም ምኩር አንኸንም በማት ቃል አትዘንጊን። አርዴ የኸኖ ገሜ የጐባቢታኸኸም ተቀበሮ፤ <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />ጉርዝ እንሽታ የዳኮዎችኸም ሰክትም ቀየነማ፤ ዛምኸም አፍቶ ግሬድ የተሟᎁትኸም ሰክትም በፍጡም ንጥሕና ቀየነማ።<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />የኢንም ምካተኘ የኸነማዪ መበለቶች ተንክባከበማ። <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />አት መበለትም ዴንጋ ወይ መቸቤ ቢነብሮያ፤ ነዚ ዴንጋም የራሰሕኖ አበሮስ በወርዳ የወላጆቸሕኖም ጄዛ በወዘብር ትንም ኢፍቴ እምነተሕኖ በሜና የዋተዥ ወትማር ይጌባኖ፤ ዚ የእዝጌር ያትቡላልቁ ቃሩ። <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />የኢንም መበለት የኸነች፤ ቁናዬታን ትነብር ተስፋዬታ በእዝጌር ᎈር ትሸክት፤ የጠሎት የእዝጌርም ኧጉዠ የወጮቅስ ምሳር ተክናን ትትጋደል። <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />የዚ ዓለም ብልቃት ጠለለ ትወድ መበለትም በቁሜታ የᎀተችያ። <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />ሟንም ናጫ ይውጅᎄ ቃር ኤነብርኸም፤ ዚም ትዛዝ የሕዘቢ አብ። <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />አት ሰብ ዘመዶቸሑ፣ በተለይም የቁርቤ አበሮሰሑ ኤይረዳ በኸነ አይማኖተሑ የለጋው፤ ቴያምን ሰብ ይብስ ቡሼው።<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />እድሜታ ተሥልሳ ዓመት ተት የኸነች ወቤት በመዝገብ አትጣፍ፤ ኧሗም የቁና ምስ ምሽት የነበረች<note caller="+" style="f"><char style="fr" closed="false">5፥9 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የምሴታ ታማኝ የነበረች</char></note> ትኸኔ ይጌባ፤ <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />ዴጋ በዋለቅ፤ ባዘና በወቀበር፤ የቅዱሳን ኧግር በወጥብ፤ የትመኮዪ በወርዳ የፈያ ሜና እንም ነብሴታን በዋብ በፈያ ሜናም የምሰኰርና ወሕን ነነባ።<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />እድሜ ያንገፈማ መበለቶችም እኪ ባነዪ መዝገብ አንትጣፈማ፤ መሳመሑም የገግ ኤላተሕነማ የክርስቶስ በገበማይ ቃል ᎈር ቢቌምነማ ግዝየ የዋግባ ይሸወማ። <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />በዚም መሳ ፍርድ በራሰሕነማ ᎈር ያቸነማ፤ ኢፍቴ የገበማዪ ጉዳ አፈረሰማም። <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />ኧሗም ሜና ወፍታ ቤት ተቤት ወዞር ይሮሰማ፤ ሜና የገፈረማ ጠለለ ቴይኸን፤ ኤይትጌባዪ ቲዝነገማ ኧሟተኞች በሰብ ዘንጋም ጣልቃ ይገበማ ይኸነማ። <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />ስለኸነም ዕድሜ ያንገፈማ ምስ የᎀተበማ ወቤት ያገበማኸም፤ ዴጋ ይጨነማኸም፤ ቤተሕነማ ያትዳድረማኸም፤ መሶም ናጫ ይውድበማ ቃር ኔይረሕብ ኧመክር። <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />የኢንም ተዚ ኢፍቴ አታቶቺ ሼጣንም የወትኸተል ተዠበረማም። <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />አማኝ የኸነች ሟንሜታ ምሽት በአበሮሴታ ግብት መበለቶች ቢነብራ፤ ቤተ ክርስቲያን የኢነተኘ መበለቶች ጠለለ ወርዳ ትችልኸም ነብሴታ ትርዳነማ አንኸንም የቤተ ክርስቲያን ጡዋራ ይኸነማኸም አትግፍረማ።<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />ቤተ ክርስቲያንም ቢጌባ ያትዳድሮ፣ ይልቅሽ በወስብክ በዋትመርም ይትጋደሎ ሽማግሌዎች ወደል ክብር ይትጌባኖ፤ <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />መጽሐፍም፣ “ይቄልሲ ቦራ አፈሑ አትግድ፤”<note caller="+" style="f"><char style="fr" closed="false">5፥18 </char><char style="ft" closed="false">ዘዳ 25፥4</char></note> ዛምኸም፤ “የሜነተኘ ደሞዘሑ ይትጌቧን<note caller="+" style="f"><char style="fr" closed="false">5፥18 </char><char style="ft" closed="false">ሉቃ 10፥7</char></note>” ይብር።<note caller="-" style="x"><char style="xo" closed="false">5፥18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">ዘዳ. 25፥4</ref>፤ <ref loc="MAT 10:10">ማቴ. 10፥10</ref>፤ <ref loc="LUK 10:7">ሉቃ. 10፥7</ref>። </char></note> <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />በዄት ወይ በሦስት ምስክር በምሰኰርᎄ አንኸንም በሽማግሌ ᎈር ይቀርብ ክስ አትቀበር።<note caller="-" style="x"><char style="xo" closed="false">5፥19 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ዘዳ. 17፥6</ref>፤ <ref loc="DEU 19:15">19፥15</ref>። </char></note> <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />እንጐደሕኖ አዞም ይጥነቀቆኸም አጢያት ይሸክቶዪ በጀᎈሪ ኢፍት ገስጦ።<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />በእዝጌር በክርስቶስ ኢየሱስም በትሜጠሮዪ መላይካ ኢፍቴ ነዚሕኖ ትዛዛ ታታዳላ ትቂየኸም አትም ቃር በዋብላልጥ አትሸክትኸም አደራ ኧብርኸ። <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />በሟንም ᎈር ኧጅ የወጫን አትደግድግ፤ ትንጐደሕኖምጌ በአጢያት አትትገገዝ፤ ኧራሳኸ በንጥሕና ቀየ።<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />የደናኸም ድጋገመም ይትነሳብኸዪ ኧቂና፤ ቀል የወይን መጠጥ ስጤወ አንኸንም በዚ አንቌ ኧጋ ጠለለ አትስጤ።<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />ያታት ሰቦች አጢያት ግልጡ፤ ተሕኖም በደረም ፍርድ መደር ይሰላ፤ እንጐደሕኖ አጢያተሕኖ ይትዄተሎ። <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />ፈያ ሜና ዛምኸም ግልጡ፤ ግልጥ ያንከነ ቢነብርም ተሼተረም ኤይቀይ።<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="s1">የአገልጋዮች ያᎅ ምክር</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />የእዝጌር ሽም ትምርተሑም ኔሰደብ፤ በጉዙነት ተት ያኖ እንም፤ ጌቶቸሕኖ ሙላ ክብር ይጌባኖኸም ሸከቶም የቆጥሮ። <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />ያምኖዪ ጌቶች ያኖዮዪም፤ ጐባቢት ስለኸኖ ይጌባኖዪ ክብር ኤይሑትርዮ፤ ይልቅሽ ባገልግሎተሕኖ ይጠቀሞዪ አማኞች ደቦዎቸሕኖም ስለኸኖ የጠቀለ ያግለግሎዮዬ ይትጌባ። ነዚሕኖ ቃርም አትመር፤ ምክር።<verse eid="1TI 6:2" /></para>
  <para style="s1">የዋጋ ፍቅር</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />ሟንም የባጢል ትምርት ቢያትመር፤ ተጔታና ተኢየሱስ ክርስቶስ ሱት ቃል የኢነተኘ መንፈሳዊነት ቲያለቅ ትምርትጌ ኤይስማማ ቢኸን፣ <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ዛ ሰብ በትዕቢት ተዌጠረም፤ ስርም ኤያጥራምት። ስለቃላት የወኦግት የወትናከስም ቡሼ ኤላት ነነን፤ ነዚሕኖ ቅናት፣ መናክስ፣ ስድብ፣ ውዶ ጥርጣሬ ያትዄትሎ፤ <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />ሐቅ በወሰጅቦ መንፈሳዊ ቃርም ትርፍ ይረሕቡᎄ ቢመስሮ አእምሮ በቀበለኖ ሰቦች ግብት ኤያቋርጥ ኦገት ያቸኖ።<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />ቢኸንም የኢን መንፈሳዊነት ያኔ ይኸኔ ወበር ወደል ትርፉ። <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />መሳመሑ ተዓለሜ ያቸኘኔ አትም ኤነ፤ አትም ጠበጥነም ወወር አንችልነ። <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />ቢኸንም ስንቅ ልባስም ባነነ፣ ዛ ይኸነነ። <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />ደንገኘ ወሕን ይሸዎ በፈተና ይወጥቆ፤ የሰቦች ቢያትብላሽ ቢያጠፋም ቤድገልል ቡሼ በኸነ በብዠ ኤላት ወሳኸ ይጠበጦ። <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />መሳሑም የዋጋ ፍቅር የቡሼ እንም ሥሩ፤ አታቶች ደንገኘ የወሕን ታነኖ ኤላት የትነሣ ተእምነት ኤማ ተዳሎም ወሮም፤ ራሰሕኖም በብዠ ሥቃይ ወጎም።<verse eid="1TI 6:10" /></para>
  <para style="s1">ጳውሎስ የጢሞቴዎስ ያᎄን ዐደራ</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />የእዝጌር ሰብ! አኸም ተዚ እንም ሲሕ፤ ጽድቅ፥ የኢን መንፈሳዊ ሕይወት፥ እምነት፥ ፍቅር፥ በትዕግሥት ወጥና፥ ሜናነት ተክታተል። <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />ፈያዪ የእምነት ገድል ተጋደል፤ በብዠ ምስክሮች ኢፍት በፈያ ወታመን የምሰከርዀነዪ የጠራኸወዪ የዘላለም ሕይወት አጥብቅም ጥብጥ። <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />ይንም ሕይወት ቢይቢ በእዝጌሬ ዛምኸም በጴንጤናዊዪ ጲላጦስ ኢፍት የኢን በምሰከረ በክርስቶስ ኢየሱስ ኢፍት ዐደራ ኧብርኸ፣<note caller="-" style="x"><char style="xo" closed="false">6፥13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">ዮሐ. 18፥37</ref>። </char></note> <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />ጔታና ኢየሱስ ክርስቶስ ይትገለጥወ ከነ ስን፣ ዚ ትዛዝ ፍርየ ኤባን ስሕተት ናጫም ኸንኸም ትቂየኸሙ። <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />ዛ መገለጥ፣ የትባረከ ጠለለሑ ገዢም የኸነዪ የነገሥታት ንጉሥ፤ የጌቶችም ጔታ እዝጌር በራሰሑ ግዝየ ያተዥኒው፤ <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />ሑቲ ጠለለ ኤይᎀት፤ ይቀርᎅዪ ቤይቸል ብራን ውስጥ ይነብር፤ ሑቲ ያዠ ሟንም ኤነ፤ ያዥኔም ይችል ኤነ። የሑቲ ክብር ቆትም ተዘላለም ዘላለም ስን የሕን፤ አሜን። <verse eid="1TI 6:16" /><verse number="17" style="v" sid="1TI 6:17" />በዚ ዓለም ደንገኘ የኸኖ ኔትነነዶ፣ ኧትብላለቅነኸም እንም ቃር አትርፈረፈም ቢበነ በእዝጌር አንኸንም ይትሟᎀንᎄ ቃር ቤነን ዱንያ ᎈር ተስፋ ኤሸክቶኸም ኧዝዞ። <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />ፈያ ይሸክቶኸም፣ ሜና የወሳድም ፈአደኞች የኸኖ ይኸኖኸማ ኧዝዞ። <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />በዚኸማት የኢን የኸነዪ ሕይወት ይረክቦኸም፣ ይቸኚ ዘበን የጠና መሠረት ይኸን ዱንያ የራሰሕኖ ይስበስቦ።<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />ጢሞቴዎስ! ባደራ የቌᎄርዀኒ እንም ቀየ፤ እዝጌር ቴያትኬብር ቴጠቅም ልፍለፋ የወቃወምም በባጢል ውቀት ተቧሪ ተወለፍልፍ ሲሕ፤ <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />የዚኸማቲ ውቀት ነነነ ቲብሮ የነበሮ አታቶቺ ዚም በወሰክተሕኖ ተእምነት ኤማ ተዳሎም ወሮ።<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>