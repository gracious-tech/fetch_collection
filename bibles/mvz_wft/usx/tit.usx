<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">Mesqan New Testament TITUS</book>
  <para style="h">ተቲቶዬ</para>
  <para style="toc1">የሐዋርያዪ የጳውሎስ መልክት ተቲቶዬ</para>
  <para style="toc2">ተቲቶዬ</para>
  <para style="toc3">ቲቶ</para>
  <para style="mt2">የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተቲቶዬ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ቲቶ አይሑድ ያንከነ ሕዝብ ተክርስትናዬ የዠበረ ቲኸን የጳውሎስ በወንጌል ተልእኮዪ በቁርብ ይረዳን የሜና መራርቻሑ ባነ፤ ጳውሎስ ዚ መልክት የጣፈ በዕድሜ እንስ የኸነዪ የዚም የሜና መራርቻሑ የቲቶ ቲኸን ቲቶ በዛ ግዝየ የቤተ ክርስቲያን ሜና በወቁጣጠር በቀርጤስ ይትረከብ ባነ። መልክቲ ያተኩሪ በሦስት ዋና ዋና ዘንጋ ᎈሩ፦</para>
  <para style="ip">አተኘ፥ የቤተ ክርስቲያን መሪዎች በተለይም በቀርጤስ ሰቦች በውዶ ሥነ አመል አንጣር ምንኸማት ሥነ አመል ይነብሮዬ ይትጌባኸም የቲቶ ማሳሰቢያ ይቡ፤</para>
  <para style="ip">ዄታለኘ፥ በቤተ ክርስቲያን ውስጥ ይትረከቦዪ የትልያዮ ቡድኖች ወበርም በዕድሜ የገፎ ገሜ እንሽታም፥ ዛምኸም አልቡላዎች አገልጋዮቺም ምንኸም ዋትመር ይትጌቧንኸም የቲቶ ይመኩር፤ በመጨረሻም ስለክርስቲያናዊ ሥነ አመል በተለይም በሰላም በደቦም ስለወንብር፥ ዛምኸም ተቤተ ክርስቲያን ውስጥ መናክስ፥ ኦገት ወትልያይም ስለዋጥፋ፥ የቲቶ ምክር መመሪያ ይቡ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="TIT 1:1-4">1፥1-4</ref> </char></para>
  <para style="io1">ስለቤተ ክርስቲያን መሪዎች <char style="ior"><ref loc="TIT 1:5-16">1፥5-16</ref> </char></para>
  <para style="io1">በቤተ ክርስቲያን የትልያዮ ቡድን የሜና ሟኔ <char style="ior"><ref loc="TIT 2:1-15">2፥1-15</ref> </char></para>
  <para style="io1">ምክር ያጥኔቁቁᎄም<char style="ior"><ref loc="TIT 3:1-11">3፥1-11</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="TIT 3:12-15">3፥12-15</ref> </char></para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />የእዝጌር አገልጋይ የኢየሱስ ክርስቶስ ሐዋርያ ተኸነዪ፥ እዝጌር የሜጠረኖዪ ሰቦች የዋጠንክር የአይማኖትም እምነት ሙላ በሙላ ይሒሮኸም የወሰክት ተሾመ ተጳውሎስ የትላኸ መልክት፦<verse eid="TIT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="TIT 1:2" />ዚም እምነት በዘላለም ሕይወት ተስፋ ᎈር የትምሠረተው፤ ባጢል ኤይሸክት አምላክ ዚ ሕይወት የዋብ ተዘበናት ኢፍቴ ቃል ገባንነም። <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />ዘበኒም በሰላ ግዝየ ቢያተርፍነዪ በእዝጌር ትዛዝ እያ ባቡኝ ዐደራ መሳ ኧሰብከኸም እዝጌር ቃለሑ ገለጠ።<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />የደነበና በኸነዪ እምነት የኢኒ ትኸኛ የኸንከዪ የቲቶ፥<note caller="-" style="x"><char style="xo" closed="false">1፥4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 ቆሮ. 8፥23</ref>፤ <ref loc="GAL 2:3">ገላ. 2፥3</ref>፤ <ref loc="2TI 4:10">2 ጢሞ. 4፥10</ref>። </char></note></para>
  <para style="p" vid="TIT 1:4">ተእዝጌር አብ ቲያተርፍነዪ ተኢየሱስ ክርስቶስም ጸጋ ሰላምም ያኸ የሕን።<verse eid="TIT 1:4" /></para>
  <para style="s1">የቤተ ክርስቲያን ሽማግሌዎች ትሾሙወ ሐለት</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />ያኸ በቀርጤስ የገፈርኩወ መሳ ያንተስትካከለዪ ታስትካክልኸም ቤዘዘከኸም መሠረት የቤተ ክርስቲያን ሽማግሌዎች በከተማ ተከተማዪ ትሾምኸሙ። <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />የቤተ ክርስቲያን ሽማግሌ ኤትነቀፍ የአት ምሽት ምስ የኸነ፤ ስድ በወሕን ባለወታዘዝም መሳ ኤይወቅሽዮ አማኞች ዴንጋ ያኖይ ሰብ ወሕን ይጌቧን። <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />የቤተ ክርስቲያን ዋና መሪ የእዝጌር ሜና በዐደራ የቌበረ ስለኸነ ኤትነቀፍ ወሕን ነነወ፤ ዛምኸም ኤይኰራ፥ ከሞ ኤይማች፥ ኤይሰክር፥ መናክሰኘ ያንከነ፥ የዋጋ ኤይስግበግብ ወሕን ነነወ። <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />ይልቅሽ ባዘና ተቀባይ፥ ፈያ የኸነዪ ቃር ይወድ፥ ነብሰሑ ይገዛ፥ ሱት፥ የእዝጌር አገልግሎት የትላኘ፥ በልክ ይነብር የሕን። <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />የኢኒ ትምርት በዋትመር የወምክር ይቃወሞዪም መልስ የዋብ ይችልኸም በትሟረን መሠረት ቢትማመንወ ቃል የጥና።<note caller="-" style="x"><char style="xo" closed="false">1፥6-9 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 ጢሞ. 3፥2-7</ref>። </char></note><verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />ብዠ ሰቦች፥ ይጠቅሊም ተአይሑድ ጐሳ የኸኖ ጤበን ሥራት፥ ይትዄተሎ፥ ኤታዘዞ፥ ቤይድገልል ቃር ይልፈልፎዪ ያብላልጦም ነኖ። <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />ነዚ ሰቦች እንቁስ ዋትበኝ ይጌባ፤ ሕኖ ቢያትማልል ትርፍ የወርክብ ኤይጌባዪ ቃር ቲያትመሮ ያበሮሲ በሙላ ያናውጦ። <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />ተሕኖ አቲ የኸነዪ የፎለሕኖ ነብይ “የቀርጤስ ሰቦች እንጌ ውሸታሞች፥ ቡሼ አውሬዎች ሰነፍም ጐረራምኖ” ባረም። <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />ዚ ምስክርነት የኢኑ፤ ስለኸነም አጠበከም ጔሠጠኖ፤ ዚም ሱቲ እምነት ይነብሮኸም <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />የአይሑድ ቸረት ኤይትዄተሎ የኢን ይቃወሞዪ ሰቦች ትዛዝ ኤይሰሞኸም አቆምርም ገሥጦ። <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />የንጡ ሰብ እንም ቃር ንጡው፤ የረከሶዪም ኤያምኖዪ ንጡ የኸነ አትም ቃር ኤነ፤ ዛምኸም አይምሮሕኖም ኸነ ሕሊናሕኖ የረከሰው። <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />የእዝጌር ኧሒርነ ይብሮ፤ ቢኸንም በሜናሕኖ ይለጎይ፤ ያጤይፎም፣ ኤይታዘዞም ፈያ ሜናም ወሰክት ኤይችሎኖ።<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s1">የሱቲ እምነት መመሪያ</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />አኸም ሕይወት ተሱቲ ትምርትጌ ይስማማ የኸነዪ አትመር፤ <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />በዕድሜ ባሊቅ የኸኖ ገሜ፥ በልክ ይነብሮ፥ ክብረሕኖ ይቅሮ፥ ጥንቁቅ፥ በእምነትም በፍቅር በትዕግሥትም ጤናማ ይኸኖኸም ምክሮ። <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />ዛምኸም በዕድሜ ባሊቅ የኸነማ እንሽታ ባመለሕነማ የከበረማ ይኸነማኸም አንኸንም ኧሟተኘ፥ የመጠጥ ሱሰኘ ኤይኸነማኸም ፈያዪ ትምርት ያትመረማኸም ምክረማ። <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />ዛምኸም አርዴ እንሽታ ምሰሕነማ ዴንጋሕነማም ይወደማኸም፥ <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />ጡንቁቅ ንጡም፥ ፈያ፥ የምሰሕነማም ይታዘዘማ ይኸነማኸም ያትመሮየማ። ዚም ይሸክቶዪ የእዝጌር ቃል ኤጐርጪኸሙ።<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />ዛምኸም አርዴዎች ነብሰሕኖ በወቁጣጠር ይነብሮኸም ምክሮ። <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />አኸም ፈያ የኸነዪ ትትሸክት ብንምቃር ምሳሌ ሕንኖ፤ በትምርታኸም ሐቀተኘነት፥ ተቁም ዘንጋጌ አተዥ፤ <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />ኤትነቀፍ ጤናማ ንግግር ግለጥኖ፤ በዚኸማት ይቃወሞዪ ቢና ᎈር ይዝነጎዪ ቡሼ ቃር ቲቀብጦ ይማልሎ።<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />አገልጋዮችም የጌቶቸሕኖ ይታዘዞኸም፥ ብንም ቃር ያትብላልቆዮኸም፥ ቡሼ ቃል ኤዠብሮኖኸም፥ አትመር፤ <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />ዚምም ቴይሰርቆ ብንም ኤማ ያተረፈነዪ የእዝጌር ትምርት ይወጂኸም ፍጡም ታማኝ ወሕነሕኖ ያትምሴክሮኸሙ።<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />መሳሑም ወትረፍ ይትረከብወ የእዝጌር ጸጋ የሰቦች እንም ተገለጠም፤ <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />ዚም ጸጋ በአጢያት ወንብር ዓለማዊ ኤላትም ለጋነም፣ በሗዪ ዘበን ነብሰና በወግዛ በጽድቅ፣ በሐቀተኝነት መንፈሳዊ ሕይወት ኧነብርነኸም ያትመረነ፤ <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />ዚም የትባረከ ተስፋና የኸነ የወደሊ የአምላከና ያተርፍነ የኢየሱስ ክርስቶስ በክብር መገለጥ በወቀየው፤ <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />ሑቲም ተቡሼ ይዋጅነዬ ፈያ የኸነዪ የወሰክት ይጋደሊ የሑቲ የኸነዪ ሕዝብ የነብሰሑ ያነጣዬ ነብሰሑ ይና አበም።<verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />ኧጌሽ ታትመሬ ይጌባኸ ነዚሕኖኖ፤ በሙላ ሥልጣን ምክር፤ ገሥጥ፤ ሟንም ኤይናቅኸ።<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s1">ፈያ የኸነዪ ወሰክት</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />ሰቦች የገዢዎች የባለ ሥልጣናትም ይትገዞኸም፣ ይታዘዞኸም ፈያ የኸነዪ እንም የወሰክት የዝጋዶ ይኸኖኸም አውዶ። <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />ዛምኸም በሟንም ᎈር ቡሼ ኤይዝነጎኸም፣ ሰላማዊ ይኸኖኸም፣ የሰቦችም እንም ተሒን የፌለቀ ቁናቀልብ ያቴዞኸም አትኴሮ። <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />በደረም ኢና ነብሰና ዋጥራምት የቀበለነ፣ አንታዘዝነ፣ የትብላለጥነ፣ የትልያየ ኤላት ድሎትም ጉዙ ኸነም የትገዛነ ባነነ፤ ትንትናከስነ አተና ይንጐደና ትንጠላነ በቡሼነት በምቀኝነትም ኧነብርነ ባነ። <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />ቢኸንም ያተረፈነ የእዝጌር ዋቢነት ፍቅር በገለጠ ግዝየ፣ <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />የሸከትነይ ስለኸነ የጽድቅ ሜና ቴይኸን፣ ተምረተሑ የትነሳ አተረፈነ። ያተረፈነም እንደገና ወጠኝ በኸነዪ ወታጠብ በመንፈስ ቅዱስም ወታደሱ፤ <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />ዚም መንፈስ እዝጌር ቢያተርፍነዪ በኢየሱስ ክርስቶስ ኤማ ቢና ᎈር አትርፈረፈም አᎈሰሰን፤ <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />ዚም በጸጋሑ ጸደቅነም የዘላለም ሕይወት ተስፋ ጠበጥነም ወራሾች ኧኸነኸሙ። <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />ዚም የታመነ ቃሉ። በእዝጌር ያመኖዪ ፈያዪ ቃር የወሰክት ነብሰሕኖ አቸለፎም ይቦዬ ነዚሕኖ ቃሮች አርጋገጥከም ትዝነግኸም ኧሸ። ዚ ፈያ የሟንም ሰብ ይጠቅም።<verse eid="TIT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 3:9" />ቢኸንም ኤይድገልል ተኸነ ኦገት ተጨኘት ዝሬት ቆጠራ፣ ተጭቅጭቅ ስለሕጊ ተትነሳዪ መናክስ ራቅ፤ ዚ ኤይድገልል ቃሩ። <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />ይላኝሑዬ ይሸ ሰብ ቁናጌ ምኩር፤ የዄታለኘ አጠንቁቅ፤ ተዚ ባለፈ ተሑቲጌ አትም ቃር ኤይንበርከ። <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />እኪ ያነዪ ሰብ ጠማማ አጢያተኛው፤ ሑቲ በነብሰሑ ᎈር የፈረደ ወሕነሑ ሐር።<verse eid="TIT 3:11" /></para>
  <para style="s1">የመጨረሻ ምክር</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />አርጤማስ ወይ ቲኪቆስ ታኸዬ የላሕኩኸም እያ ታነሑወዬ ተኒቆጵልዮሴ የወተኝ የቻለናኸ እንም ሰክት፤ በርግም በዛዬ አቸልፌ ሸሑም። <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />ሕጊ ይሒሪ ዜናስ አጵሎስም ቤማሕኖ የወርዳ የቻለናኸዪ እንም ሰክት፤ ያሸኖ እንም አሟላኖ። <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />ቲና ጐሳ የኸኖ የከነ ያሸኖ ቃር ይረክቦኸም ኑሮሕኖም ፍርየ ዬነን ኤይኸንኸም የፈያ ሜና ወትጋደል ይትመሮኸም ይጌባኖ።<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />ቲያጌ ያኖዪ እንም ሰላምታ ያቀርቦንኩ። በእምነት የትነሣ ይወዶነዪም ሰላምታ አቅርቦንነ። ጸጋ ትንማሑጌ የሕን።<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>