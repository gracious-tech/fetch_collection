<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">Mesqan New Testament 1 PETER</book>
  <para style="h">1 የጴጥሮስ መልክት</para>
  <para style="toc1">መጀመሪያው የሐዋርያዪ የጴጥሮስ መልክት</para>
  <para style="toc2">1 የጴጥሮስ</para>
  <para style="toc3">1 ጴጥ.</para>
  <para style="mt">በመጀመሪያዪ የሐዋርያዪ የጴጥሮስ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የመጀመሪያዪ የሐዋርያዪ የጴጥሮስ መልክት የጣፈ በመልክቲ ውስጥ “የእዝጌር የትሜጠሮ ሕዝብ” በወበር ይጠሬዮዪም ብንሲ እስያ ሰሜናዊ ክፍል የቤተኖዪ ክርስቲያኖቹ፤ የመልክቲ ዋና ዓላማ በእምነተሕኖ መሳ ስደት መከራም ሰላቦም የነበሮዪ ያነቦዪ የዋብርታታ የዋጥናናው፤ ጠሐፊዪ ዚ ይሸክት የሞተሑ፥ የትንሣኤሑ፥ ተዠበረም የወተኘሑ ተስፋ ያበሥሪ የኢየሱስ ክርስቶስ የምሥራች ቃል ያነቦዪ በዋስታውሱ፤ የኢየሱስ ክርስቶስ ሕይወት በምሳሌነት በወትመልከት መከራ በትግሥት ወቀበር ያነቦኸም ያቴስቦ፤ ተዚምጌ በዋጥባብጥ መከራ የእምነተሕኖ ጥራት ይትፌተንኸም “ኢየሱስ ክርስቶስ ቢትገለጥወም ከነ” ይጌባ ጄዛሕኖ ይቌበሮኸም ያትኴሮ።</para>
  <para style="ip">ጠሐፊዪ በመከራ ይፈርኮኸም ተዋድፋፍረሑም እንጐድ ያነቦዪ የክርስቶስ ተከታዮች ወንብር ይጌባኖኸማት ይነብሮኸም ያቴስቦ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="1PE 1:1-2">1፥1-2</ref> </char></para>
  <para style="io1">የእዝጌር አትርፎት ማስታወሻ <char style="ior"><ref loc="1PE 1:3-12">1፥3-12</ref> </char></para>
  <para style="io1">በትቄደሰ ሕይወት የወንብር የቴበ ምክር <char style="ior"><ref loc="1PE 1:13-2:10">1፥13—2፥10</ref></char></para>
  <para style="io1">በምካት ግዝየ የክርስቲያን አላፊነት <char style="ior"><ref loc="1PE 2:11-4:19">2፥11—4፥19</ref> </char></para>
  <para style="io1">የክርስቲያን ቁናቀልብ አገልግሎትም <char style="ior"><ref loc="1PE 5:1-11">5፥1-11</ref></char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="1PE 5:12-14">5፥12-14</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />የኢየሱስ ክርስቶስ ሐዋርያ ጴጥሮስ፤ ባዘና ኸንኩም በጳንጦስ፥ በገላትያ፥ በቀጰዶቅያ፥ በእስያ፥ በቢታንያ ተቤተኖም በባዘናነት ይነብሮዪ <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />እዝጌር አብ በደረም ቤቈደን መሠረት የትሜጠርኩዪ፥ የኢየሱስ ክርስቶስ የወታዘዝ በደመሑም ተሬጨሑም የወንጣ በመንፈስ ቅዱስ የቄደስኩዪ፥</para>
  <para style="p" vid="1PE 1:2">ጸጋ ሰላምም የብዛንኩ።<verse eid="1PE 1:2" /></para>
  <para style="s1">ሕያው ተስፋ</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />ኢየሱስ ክርስቶስ በሞት በወተንሳሑ መሳ ሕያው የኸነዪ ተስፋ ያበነ፥ በወደል ምረተሑ በገደር ወጠኝ ዴንጋሑ የሸከተነ፥ የጔታና የኢየሱስ ክርስቶስ አባ እዝጌር የትመስገን፤ <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />ሑቲም ኤይጠፋዪ፥ ኤይትብላሺ ኤይገርዚ ርስት በሰሜ አዝጋጅንኩ። <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />አሑም በመጨረሻዪ ዘበን ይትገለጢ ወትርፍ በእምነት መሳ በእዝጌር ቆት ተቂየሑም። <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />ኧሗ በብዠኸማት ፈተና ውስጥ ኸንኩም የቀል ግዝየ መከራ ብትቌበሮም በዚ ስርም ትትብላለቆ። <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />ነዚሕኖ ዘንጋ ባሑ ᎈር የሰሎ፣ በኧሳት ተፌተነም ንጡ ቢኸን፣ ይጠፋ ተኸነዪ ወርቅ ይጠቅል ስርም የከበረዪ እምነታሑ የኢነተኘ ወሕነሑ የትርጋገጠኸም ኢየሱስ ክርስቶስ ቢትገለጥወ ግዝየ ምስጋና ክብርም፣ ውዳሴ ያትሬክብንኩኸሙ። <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />የኢየሱስ ክርስቶስ ያነዠሑይ ብትኸኖም ትወዶይ፤ ኧሗም አታዞይ ብትኸኖ ታምኖᎄ፤ በቃላት ይትገለጤ ቤይቸል በከበረ ብልቃት ስርም ትትብላለቆ። <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />በእምነታሑ ትቅሮዪ የነብስያሑ ወትርፍ ትረሕቦ።<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />ያሑ ይᎅዪ ጸጋ ትምቢት የዝነጎዪ ነብዮች ስለዚ ወትርፍ ብረቶም ተቅሮም ይምረምሮይ ባነ። <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />በሕኖ ውስጥ የነበረዪ የክርስቶስ መንፈስ፥ በክርስቶስ መከራ ዛምኸም ተመከራዪ አንቌ ይኸኒ ክብር በደረም በወዘንግ ያምለከተኖ ግዝየ መቸ ምንኸም ይፌጠምኸም ይምረምሮ ባነ፤ <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />ነዚ ነብዮች ያግለግሎ የነበሮ ያሑ አንኸንም የነብሰሕኖ ያንከነኸም ተገለጠኖም፤ ያግለገሎኩም በሰሜ በትላኸዪ በመንፈስ ቅዱስ መሳ ኧሗ ወንጌል ይውዶኩ ሰቦች ዬወዶኩ በመገለጡ፤ ዚ ዘንጋ መላይካም የወዥ ይትሜኖ ባነ።<verse eid="1PE 1:12" /></para>
  <para style="s1">በቅድስና ወንብር</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />ስለኸነም ሒናሑ አዝጋዶ፤ ራሳሑም ግዞ፤ ተስፋሑ ኢየሱስ ክርስቶስ ቢትገለጥወ ግዝየ ትረሕቦይ ጸጋ የᎀላ ተስፋ የንብርኩ። <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />ታዛዥ ዴንጋ ኸንኩም ባለወሐር ድረ የነበረናሑ ቡሼ ኤላት አትትኸተሎ፤ <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />ቢኸንም የጠራናሑ እዝጌር ቅዱስ የኸነኸም አሑም በኑሯሑ እንም ቅዱሳን ሕኖ፤ <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />“እያ ቅዱስ የኸንኩ ስለኸነ አሑም ቅዱሳን ሕኖ” ቧሪም ጣᎉም።<note caller="-" style="x"><char style="xo" closed="false">1፥16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">ዘሌ. 11፥44-45</ref>፤ <ref loc="LEV 19:2">19፥2</ref>። </char></note><verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />የሟንም ተያዳላ የያታቲ የሜናሑኸም ይፈርዲ የእዝጌር “አባና” ባሑም ትጠሮይ በኸነ በዚ ዓለም በባዘናነት ባዘና ኸንኩም ትትነብሮ የሑቲ በወገና ንበሮ። <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />አሑ ተአቦቻሑ ተወረስኩይ ኤይድገልል ኑሮ የትዋጀሑ ቢጠፋ ቃር የጠገራ ብር ወይ በወርቅ አለወሕነሑ ቲሕሮ። <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />አሑ የትዋጀሑ ነውር ወይ ሰሕ ዬነወኸም ንጡ ኧጤ በኸነዪ በክርስቶስ ክቡር ደሙ። <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />ሑቲ የትኴረ ዓለም ተወትኸለቀሑ ኢፍቴ ቲኸን፥ ኧሗ በመጨረሻዪ ዘበን ስላአሑ ተገለጠም። <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />እምነታሑም ተስፋሑ በእዝጌር ይኸንኸም በኢየሱስ መሳ የሑቲ ተሞት ባትኔሳን ክብር ባᎄን በእዝጌር ትትመመኖ።<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />ኧጌሽ የኢን በወታዘዝ ነብስያሑ ስላነጣሑ የጐባቢታሑ ቅን ፍቅር የንብርኩ፤ ነብስ በነብሳሑ አጥብቆም ተሒን<note caller="+" style="f"><char style="fr" closed="false">1፥22 </char><char style="ft" closed="false">አታት የድር ቅጂዎች </char><char style="fqa" closed="false">በንጡ ሒን</char><char style="ft" closed="false">ይብሮ። </char></note>ተዋደዶ።<note caller="+" style="f"><char style="fr" closed="false">1፥22 </char><char style="fqa" closed="false">የጎጋ ጡሑፍ “በንጡ” ይብሮ። </char></note> <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />ዠበርኩም የጨኘሑ ሕያው በኸነዪ የዘለዓለም ጠናም ቢነብሪ በእዝጌር ቃል ቤይጠፋ ዘሩ አንኸንም ቲጠፋ ዘር አንከነ፤ <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />መጽሐፍ ይቡንኸም፦</para>
  <para style="q1" vid="1PE 1:24">“በሠር የለበሰ እንም የሰርኸሙ፤</para>
  <para style="q2" vid="1PE 1:24">ክብረሑ እንም የድብር አበባው፤</para>
  <para style="q2" vid="1PE 1:24">ሠሪም ይጠርቅ፤ አበባዪም ይረግፍ፤<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />የጔታ ቃልም</para>
  <para style="q2" vid="1PE 1:25">የዘለዓለም ጠናም ይነብር።”</para>
  <para style="m" vid="1PE 1:25">የሰበኩንኩ የምሥራች ቃል ዚቱ።<note caller="-" style="x"><char style="xo" closed="false">1፥24-25 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">ኢሳ. 40፥6-8</ref>። </char></note><verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s1">ሕያው እምን የትቌደሰም ሕዝብ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />ኧጌሽ ቡሼነት እንም፥ ዋብላልጥ እንም፥ ግብዝነት፥ ቅናትም፥ ሟንመሑ ኧሟት አትወግዶ፤ <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />ገደር የጨኖ ሰብዬ ብጭወ ይሸዎኸም አሑም የወትርፍ ትትለቆ ታሮᎄዪ ንጡ መንፈሳዊ ትምርት ተመኖ። <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />ትትሜኖዬ ትችሎ “ጔታ ዋቢ ወሕነሑ ሐርኩም በኸነው።”<note caller="-" style="x"><char style="xo" closed="false">2፥3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">መዝ. 34፥8</ref>። </char></note><verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />ስለኸነም ሕያው እምን ተኸነዪ ተጔታ ኢየሱሴ ቅረቦ፤ ዚ እምን ሰቦች ገረጦም የገፈሮይ፥ በእዝጌሬም የትሜጠረ የከበረም ጄዛ ያነኑ። <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />ተጔታ ኢየሱሴ ትቀርቦᎄ የሕያዋን እምንኸም መንፈሳዊ ቤት ኸንኩም የዋንጡ፤ በዚኸማት በኢየሱስ ክርስቶስ መሳ ያትብላልቅ መንፈሳዊ መሥዋት የእዝጌር የዋቅርብ ቅዱሳን ካሕናት ትኸኖ። <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />በቅዱስ መጽሐፍ</para>
  <para style="q1" vid="1PE 2:6">“ዘ! የትሜጠረ ክቡርም የኸነ</para>
  <para style="q2" vid="1PE 2:6">የማዘን እምን በጽዮን አነብር፤</para>
  <para style="q2" vid="1PE 2:6">በሑቲም ያምን ኤሟልል”</para>
  <para style="m" vid="1PE 2:6">ይብር ቃል ጣᎉም ይትረከብ።<note caller="-" style="x"><char style="xo" closed="false">2፥6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">ኢሳ. 28፥16</ref>። </char></note> <verse eid="1PE 2:6" /><verse number="7" style="v" sid="1PE 2:7" />ኧጌሽ ያሑ ታምኖዪ ዚ እምን የከበረው፤ ኤያምኖዪም</para>
  <para style="q1" vid="1PE 2:7">“ግንበኞች ገረጦም ያደጎይ እምን</para>
  <para style="q2" vid="1PE 2:7">የማዘን ጉነን ኸነ።”<note caller="-" style="x"><char style="xo" closed="false">2፥7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">መዝ. 118፥22</ref>። </char></note><verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />ኧሗም፥</para>
  <para style="q1" vid="1PE 2:8">“ዘ! ሰቦች ያክናትፍ እምን፤</para>
  <para style="q2" vid="1PE 2:8">ዘ! የሰቦች አክናተፈም ያድግ አለት” ይብር።</para>
  <para style="m" vid="1PE 2:8">ሕኖ ቃሊ ባለወምነሕኖ ይክናተፎ፤ በደሮም የዚ የትሜደቦኖ።<note caller="-" style="x"><char style="xo" closed="false">2፥8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">ኢሳ. 8፥14-15</ref>። </char></note><verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />አሑ በጨለማ ቲያዴንቅ ብራነዄ የጠራናሑ የእዝጌር ያዴንቅ ሜና ቲውዶኸም የትሜጠረ ጨኘት፥ የንጉሥ ካሕናት፥ እዝጌር የነብሰሑ የሸከተናሑ ቅዱስ ሕዝብንኩ። <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />አሑ ድረ የእዝጌር ሕዝብ አነበርኩ፤ ኧሗ የእዝጌር ሕዝብንኩ፤ ድረ ምረተሑ አረኸብኩ ባነ፤ ኧሗ ምረተሑ ረከብኩም።<note caller="-" style="x"><char style="xo" closed="false">2፥10 </char><char style="xt" closed="false"><ref loc="1PE 2:23">2፥23</ref>። </char></note><verse eid="1PE 2:10" /></para>
  <para style="s1">የእዝጌር አገልጋዮች</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />ደቦዎች፥ በዚ ዓለም ባዘና መጻተኞችም የኸንኩ ስለኸነ ተነብስጌ ቲትዋጎዪ ተቡሼ ኤላቶች ትሰኮኸም ዐደራ ኧብርሑ። <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />የሟንᎀሑ “ቡሼ ይሸክቶኖ” ባሮም ቢዬሞኩም እዝጌር ይና ይጉበኜ ቢቸኝወ ከነ አሕዛብ ፈያ ሜናሑ አዞም የእዝጌር ያምሰግኖኸም በሕኖ ግብት ትትነብሮ ፈያ አመል የንብርኩ።<verse eid="1PE 2:12" /></para>
  <para style="s1">የአለኦች የጌቶችም ወታዘዝ</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />የጔታ ኢየሱስ በሮም ያፈሪ ባለሥልጣን እንም ተገዞ፤ ትንም ይበዛ ባለሥልጣን ስለኸነ የንጉሥም ቢኸን፣ <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />የገኝ ገዢዎችም ታዘዞ፤ ሕኖ ቡሼ ይሽክቶዪ የወቅጣ፥ ፈያ ይሸክቶዪ የዋመስግን ተንጉሠ ነገሥቲ ይትለሖኖ። <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />ፈያ በወሰክት የገዋዪ ያለወሐር ንግግር እንቁስ ታትብኖኸም የእዝጌር ፈአዱ። <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />የእዝጌር አገልጋይኸም ሕኖም በነጣነት ንበሮ አንኸም ነጣነታሑ ቡሼ ይሼፉንᎄ አትሰክቶይ። <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />የሰብ እንም አክብሮ፤ የጐባቢት ውደዶ፤ የእዝጌር ገኖ፤ የንጉሥ አክብሮ።<verse eid="1PE 2:17" /></para>
  <para style="s1">የክርስቶስ መከራ ምሳሌነት</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />አሑ አገልጋይ የጌቶቻሑ በዋክብር ታዘዞ፤ ትታዘዞም የፈያዪ ሜናዪም ጠለለ ቴይኸን የቡሼዎቺሚው። <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />ሰብ ይትምሰገን በግፍ መከራ ቲቌበር የእዝጌር ባረም ቲፈርኩ። <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />ቡሼ ሸከትኩም ቅጣት ትትቌበሮ ብትፈርኮ ምን ምስጋና ይነብርሑ? ቢኸንም ፈያ ሸከትኩም መከራ ትትቌበሮ ብትፈርኮ በእዝጌሬ ምስጋና ትረሕቦ። <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />የጠረኩም የዚቱ፤ የሑቲ ምሳሌ ትትዄተሎኸም ክርስቶስ ያሑ መከራ በወቀበር ምሳሌ ኸነኩም። <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />ሑቲ አትም አጢያት አንሰከተ፤ ባፈሑ ቡሼ ቃር አንትረኸበወ።<note caller="-" style="x"><char style="xo" closed="false">2፥22 </char><char style="xt" closed="false"><ref loc="ISA 53:9">ኢሳ. 53፥9</ref>። </char></note> <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />ቲሰድቦይ ዠበረም አንትሳደበ፤ መከራ ቲቌበር በጽድቅ ይፈርዲ አምላክ ነብሰሑ ዐደራ አበ አንኸንም አንፎከር።<note caller="-" style="x"><char style="xo" closed="false">2፥23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፥7</ref>። </char></note> <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />ተአጢያት ተላኘነም በጽድቅ ኧነብርነኸም፥ ሑቲ ነብሰሑ በበሠረሑ አጢያተና በመስቀል ᎈር ጮረ፤ በሑቲ መዛ አሑ ተረፍኩም። <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />አሑ የጠፎ ኧጤኸም ትቅብዘበዞ ባነ፤ ኧሗም ተነብስያሑ መጋቢ ቲቂየሑዬም ተዠበርኩም።<note caller="-" style="x"><char style="xo" closed="false">2፥25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">ኢሳ. 53፥6</ref>። </char></note><verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s1">ምስ ተምሽት</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />ዛምኸም አሕማ እንሽታ! የምሳሕማ ታዘዘማ፤ በዚምኸማት አታቲ በእዝጌር ቃል ኤያምኖ ቢኸኖም ፍርየ ኤባን ቃለሑ ትምርት በምሽተሕኖ አመል ጠለለ ይትማረሖዬ ይችሎ ይኸን።<note caller="-" style="x"><char style="xo" closed="false">3፥1 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ኤፌ. 5፥22</ref>፤ <ref loc="COL 3:18">ቆላ. 3፥18</ref>። </char></note> <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />ይትማረሖዬ ይችሎ ንጡ የኸነዪ ሰብ አክባሪም የኸነዪ ሕይወተሕኖ ቲምሌከቶው። <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />ያሕማ መልክ ጉነን በወትረሽ፥ በወርቅ በዋንጠልጥል፥ ይደንቅ ልባስ በወልብስ በውጪ ቢታዢ ኤሕን።<note caller="-" style="x"><char style="xo" closed="false">3፥3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 ጢሞ. 2፥9</ref>። </char></note><verse eid="1PE 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 3:4" />ቢኸንም መልካሑ በእዝጌር ኢፍቴ ዋጋሑ ስርም በከበረ ቤይጠፋ ጌጥ በሜናነት በዋጥራምት መንፈስ የደመቀዪ፥ በሒን ተሼተረም ይትረከቢ፥ ገጋሕማ የሕን። <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />በድረ ግዝየ ተስፋሕነማ በእዝጌር ᎈር ያደገማ፥ የቌደሰማ እንሽታ ያጌጠማ በዚኸማት ባነ፤ የምሰሕነማም ይታዘዘማ ባነ። <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />የታዘዘማዪም ሣራ የአብርሐም “ጌቶቸኛ!” ባረችም ትታዘዝነ የነበረኸማቱ፤ አሕማም ፈያ የኸነዪ ቃር ብትሸክተማ አትም ያጔና ቃር ቤያድኔብጥክማ የሒቲ ግሬድንክማ።<note caller="-" style="x"><char style="xo" closed="false">3፥6 </char><char style="xt" closed="false"><ref loc="GEN 18:12">ዘፍ. 18፥12</ref>። </char></note><verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />ምሶች! ትንሽታሑጌ በዋጥራምት ቁናዬ ንበሮ፤ ታሑ ይልቅ የቌጠማ ኸልቀት የኸነማ ስለኸነ ታሑምጌ የሕይወት ጸጋ ይወርሰማ ስለኸነ አክብሮየማ፤ በዚምኸማት የጠሎታሑ ቈፋ ይኸን ቃር ኤነብር።<note caller="-" style="x"><char style="xo" closed="false">3፥7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ኤፌ. 5፥25</ref>፤ <ref loc="COL 3:19">ቆላ. 3፥19</ref>። </char></note><verse eid="1PE 3:7" /></para>
  <para style="s1">ፈያ በወሰክት መከራ ወቀበር</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />በመጨረሻዪ ነብስ በነብሳሑ ተስማሞም ንበሮ፤ ይንጐዲ ሰብ ምካት የነብሳሑኸም ሰክቶም ቆጥሮ፤ በጐባቢትነት ፍቅር ተዋደዶ፤ ፈያ ቁናቀልብም ሕኖ። <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />መርቆ አንኸንም ቡሼ በቡሼም ሟኔ፥ ስድብ በስድብ ሟኔ አትዘብሮ፤ መሳሑም አሑ የጠራሑ ዚ በወሰክት በረካ ትወርሶዬው፤<verse eid="1PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 3:10" />ቅዱስ መጽሐፍ ይቡንኸም፦</para>
  <para style="q1" vid="1PE 3:10">ሕይወት ይወድ ፈያ ከነ ያዤ ይሸ፥</para>
  <para style="q2" vid="1PE 3:10">ዓለመተሑ ቡሼ ቃር ኤይዝነግኸም፥</para>
  <para style="q2" vid="1PE 3:10">ከንፈረሑ ተንኰል ኤይዝነጎኸም የሕትር።<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />ተቡሼ የራቅ፤ ፈያ የሰክት፤</para>
  <para style="q2" vid="1PE 3:11">ሰላም የሴ፤ የትዀተልም፤<verse eid="1PE 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 3:12" />የጔታ ዔን</para>
  <para style="q2" vid="1PE 3:12">ተጻድቃኔ ይትምሌከት፤</para>
  <para style="q2" vid="1PE 3:12">እንዝንመሑ ተጠሎተሕኖ የወስማ ተከፈተም፤</para>
  <para style="q2" vid="1PE 3:12">ቡሼ ቢሸክቶዪም ᎈር</para>
  <para style="q2" vid="1PE 3:12">ጔታ የማት ኢፍተሑ ያቴዥ።<note caller="-" style="x"><char style="xo" closed="false">3፥10-12 </char><char style="xt" closed="false"><ref loc="PSA 34:12-16">መዝ. 34፥12-16</ref>። </char></note><verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />ፈያ የወሰክት ብትጋደሎ ይጎዳሑ ሟኒ? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />ፈያ በወሰክት መከራ ብትቄበሮ በረካ ትረሕቦ፤ የሰቦች ዋጊናናሕኖ አትገኖ፤ አትጨነቆ።<note caller="-" style="x"><char style="xo" closed="false">3፥14-15 </char><char style="xt" closed="false"><ref loc="MAT 5:10">ማቴ. 5፥10</ref>፤ <ref loc="ISA 8:12-13">ኢሳ. 8፥12-13</ref>። </char></note> <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />ጔታ ክርስቶስም በሒናሑ አክብሮይ፤ የሕይወታሑ ጔታ ሰክቶይ፤ ባሑ ᎈር ስላነዪ ተስፋ ይሰሎኩ እንም መልስ የወዘብር እንጌ ተዝጋዶ። <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />መልሳሑም በሜናነት በዋክብርም የሕን፤ የክርስቶስ በወሕናሑ ባነናሑ ፈያ አመል ᎈር ቡሼ ይዝነጎ ሰቦች በቡሼ ንግግረሕኖ ይማልሎኸም ፈያ ሕሊና የንብርኩ። <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />የእዝጌር ፈአድ በኸነ አሑ ቡሼ በወሰክት መከራ ተወቀበራሑ ፈያ በወሰክት መከራ ብትቌበሮ ይጠቅል። <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />ክርስቶስም ራሰሑ ተእዝጌሬ ያቀርብነዬ ሑቲ ጻድቅ ኸነም ትናነ ጽድቅ ዬነነ ይና በአጢያተና መሳ ቤያደግም ሐለት ቁናጌ መከራ በወቀበር ᎀተም፤ ሑቲ በበሠር ᎀተ፤ በመንፈስም ሕያው ኸነ። <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />በመንፈስም ወረም በወሕኔ ቤቴ የነበሮዪ ነብሳት ሰበከኖ። <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />ነዚ በወሕኔ የነበሮዪ ነብሳት ድረ በኖሕ ዘበን መርከብ ቲሸክት እዝጌር በትግሥት ይቂየኖ የነበሮ አንታዘዝ የባሮዪኖ። በዛም መርከብ ውስጥ ገቦም በጋ መሳ የተረፎ ቁጥረሕኖ ስሙት የኸኖ ቀል ሰቦች ጠለልኖ። <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ዚም ኧጋ ኧሗ ያሑ ያተርፍ የጥምቀት ምሳሌው፤ ዚ ጥምቀት የገግ ቆሻሻ ዋጥፋ ቴይኸን ንጡ ሕሊናም የወርክብ ተእዝጌሬ ይቀርብ ጡቈሸው፤ ያተርፍሑም በኢየሱስ ክርስቶስ ትንሣኤ መሳው፤ <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />ሑቲ ተሰሜዬ ወረም በእዝጌር አብ ከነው፤ መላይካ ሥልጣናትም ሓይላትም ተገዞነም።<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s1">የእዝጌር ወንብር</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />ክርስቶስ በበሠረሑ መከራ የቌበረ ስለኸነ አሑም ያርብ መሣሪያ የታገደ ሰብኸም በዚ አሳብ በርቶም ተዝጋዶ፤ በበሠረሑ መከራ የቌበረ ሰብ አጢያት ወሰክት ገፈረም። <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />ተሗ ቀረሰም በቀኘዪ ያፈሪ ኑሮሑ ይነብር የበሠር ቡሼ ኤላት በወሰክት ቴይኸን የእዝጌር ፈአድ በወፈጥሙ። <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />አሕዛብ ይሸክቶይኸም በስድነት፥ በወሟግጥ፥ በስካር፥ አቅል ቤነን ፈንጠዝያ፥ ብዠ በወስጤ ቢያትማልል የጣዖት አምልኮ ያቸለፍኩይ ዘበን ያሰላ።<verse eid="1PE 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 4:4" />ዚ በመሰረ የባከነ ሕይወት ተሕኖጌ አትሮጦ ስለኸነ ባዘና ኸነቦም በወደነቅ ይሰድቦኩ። <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />ቢኸንም በሕይወት ባኖዪ በᎀቶዪም ይፈርዴ የዝጋጀዪ መልስ ይቦይ።<verse eid="1PE 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 4:6" />የሟቾቺ ቴይቀይ ወንጌል የሰበከ በዚ መሳው፤ በዚኸማት በበሠረሕኖ የሰብኸም እንም ይትፈረድቦ፤ በመንፈሰሕኖም የእዝጌር ፈአድኸም ይነብሮ።<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />ኧጌሽ ይንም ቃር መጨረሻ ቀረበም፤ በወጋደል ወጠልይ ትችሎኸም የትርጋጋ አይምሮ የንብርኩ፤ ነብሳሑ በወግዛ ንበሮ።<verse eid="1PE 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 4:8" />ፍቅር ብዠ አጢያት ይሼፍን ስለኸነ ትንም ነን ነብስ በነብሳሑ አጥብቆማሑ ተዋደዶ።<note caller="-" style="x"><char style="xo" closed="false">4፥8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ምሳ. 10፥12</ref>። </char></note> <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />ቁምቁሜ ታትብሮ ነብስ በነብሳሑ ባዘንነት ተቀበሮ። <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />የትልያዮ የእዝጌር የጸጋ ስጦታ በወታመን በዋትዳድር ታሑ እያታቲ ባᎅዪ የጸጋ ስጦታ ይንጐዲ አገልጋይ የሕን።<verse eid="1PE 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 4:11" />ታሑ ሟንም ይዝነግ ቢነብር የእዝጌር ቃልኸም የዘንግ፤ ያግለግልም ቢነብር እዝጌር ቢይቡ ቆት ያገልግል፤ ዚም እዝጌር በኢየሱስ ክርስቶስ መሳ ይከብርኸሙ፤ ክብር ሥልጣንም ተዘላለም ዘላለም ስን የሕን፤ አሜን።<verse eid="1PE 4:11" /></para>
  <para style="s1">ክርስቲያን በወሕን ይሰላ መከራ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ደቦዎች! ይሳትኸም ይፌትን መከራ ውስጥ ትትረከቦ ያንትሮሸ ባዘና ቃር የሰላብኩኸም ሸከትኩም አትደነቆ፤ <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />ይልቅሽ የክርስቶስ ክብር ቢታዥወ ግዝየ ስርም ትትብላለቆኸም የሑቲ መከራ ትሰዶ በሒናሑ ተብላላቆ። <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />ስለክርስቶስ ሽም ብትሰደቦ የክብር መንፈስ ወበር የእዝጌር መንፈስ ባሑ ᎈር ያᎈይ ስለኸነ ተብላለቆ።<verse eid="1PE 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 4:15" />ታሑ ሟንም መከራ ይቌበር ቢነብር፤ ሰብ ይቀጥር የሌባ ወንጀለኛኸም በሰብ ዘንጋ ግብት ገባም መከራ ኤቀበር። <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />ክርስቲያን በወሕነሑ መከራ ይሰላወ ቢነብር ስለክርስቶስ ሽም የእዝጌር ያመስግን አንኸንም ኤሟልል።<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />ፍርድ ይቀርስወ ግዝየ ሰላም፤ ፍርዲ ይቀርስም በእዝጌር ሰቦች ᎈሩ፤ ኧጌ፥ ፍርድ ይቀርስ ቢና በኸነ የእዝጌር ወንጌል ኤይታዘዞ ሰቦች መጨረሻሕኖ ምን ይኸን? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />ቅዱስ መጽሐፍ ይቡንኸም፦</para>
  <para style="q1" vid="1PE 4:18">“ጻድቅም ወትርፍ ይችል በጭንቅ በኸነ</para>
  <para style="q2" vid="1PE 4:18">የእዝጌር ኤያመልኮ ሰቦች ምንኸም ይኸኖዬ ይችሎ?”<note caller="-" style="x"><char style="xo" closed="false">4፥18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">ምሳ. 11፥31</ref>። </char></note><verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />ስለኸነም የእዝጌር ፈአድኸም መከራ ይቌበሮ ሰቦች እንምቃረሕኖ የታማኚ ፈጣሪ ዐደራ አቦም ፈያ ቃር ተወሰክት ታንቌዬ ኤበሮ።<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s1">የእዝጌር ሕዝብ የዋትዳድር የቴበ መመሪያ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />ኧጌሽ እያ ተሕኖጌ ቁናዬ የቤተ ክርስቲያን ባሊቅ የኸንኩ፥ የክርስቶስ መከራ ምስክር የኸንኩ፥ ዚምኸም ቲፍቴዬ ይገለጢ ክብር ኧሰድ ኧኸን፥ በግብታሑ ያኖዪ የቤተ ክርስቲያን ሽማግሌዎች ኧመክሮ።<verse eid="1PE 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 5:2" />በዐደራ ያቡኩዪ የእዝጌር ሕዝብ ቀሮ፤ ሕዝቢ ትቅሮ በግድ ቴይኸን እዝጌር ቢሸንኸማት፥ በፈአደኝነት የሕን፤ ዋጋ የወሰብስብ ቴይኸን አገልጋይ የወሕን ባሑም በወሴ የሕን።<note caller="-" style="x"><char style="xo" closed="false">5፥2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">ዮሐ. 21፥15-17</ref>። </char></note> <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ዛምኸም ባሑ አላፊነት ተት ያኖዪ ጨቈኒም ወግዛ ቴይኸን የሕዝቢ ፈያ ምሳሌ በዋተዥ የሕን። <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />ዚ ብትሸክቶ የመጋቢዪ አለአ ቢገለጥወ ግዝየ ኤይትብላሺ የክብር አክሊል ትቌበሮ።<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />ዛምኸም አሑ ጐልማሳ! የሽማግሌዎች ታዘዞ፤ እንማሑ ቁና ቀልብነት የልባስኸም ልበሶ አቲ ይንጐዲ ያገልግል፤</para>
  <para style="q1" vid="1PE 5:5">“እዝጌር ትዕቢተኞች ይቃወም</para>
  <para style="q2" vid="1PE 5:5">የቁናቀልቢም ጸጋ ይብ” ቧሪም ጣᎉም።<note caller="-" style="x"><char style="xo" closed="false">5፥5 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ምሳ. 3፥34</ref>። </char></note><verse eid="1PE 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />ኧጌሽ እዝጌር በዌሰነን ግዝየ ከፍ ያበይንኩኸም ተእዝጌር የብረታ ኧጅ ተት ነብሳሑ አዋርዶ።<note caller="-" style="x"><char style="xo" closed="false">5፥6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">ማቴ. 23፥12</ref>፤ <ref loc="LUK 14:11">ሉቃ. 14፥11</ref>፤ <ref loc="LUK 18:14">18፥14</ref>። </char></note> <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />ሑቲ ያሑ ዬስብ ስለኸነ ያጬንቅኩዪ አሳብ እንም በሑቲ ᎈር ኧድጎይ።<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />በልክ ንበሮ፤ ተጋደሎ! መሶአኹ ዳቡሎስ ይወጪ በወሴ ያገሳ አንበሳኸም በዙሪያሑ ይዦር። <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />በዓለም እንም ያኖ ጐባቢታሑ ዚኸማት መከራ ይቌበሮኸም በወሐር በእምነት ጥኖም ተቃወሞይ።<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />የቀል ግዝየ መከራ በቌበርኩ አንቌ በክርስቶስ ተዘላለም ክብሬ የጠራናሑ የጸጋ እንም አምላክ ሑቲ ነብሰሑ በቌበርኩይ መከራ ያተርፍሑ፤ ይዴግፍኩ፤ ያጠናሑ፤ ይምሠርትኩ። <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />ተዘለዓለም ዘለዓለም ስን ክብር ቆትም የሑቲ የሕን! አሜን።<verse eid="1PE 5:11" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />ታማኝ ጐቤው ባሑም ብኔስቡ ሲላስ<note caller="+" style="f"><char style="fr" closed="false">5፥12 </char><char style="ft" closed="false">ወይም ሲልዋኖስ ወበር ሲላስ ወበሩ። </char></note> መሳ ዚ መልክት ባጭረሑ ጣፈኩንኩም፤ የጣፈክንኩም ኧመክርሑዬ ዚ የኢኒ የእዝጌር ጸጋ ወሕነሑ ኧገልጥንኩዬ ባሑሙ፤ ስለኸነም በዚ በእዝጌር ጸጋ ጥኖም ቁሞ።<note caller="-" style="x"><char style="xo" closed="false">5፥12 </char><char style="xt" closed="false"><ref loc="ACT 15:22">ሐዋ. 15፥22</ref>። </char></note><verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />የአሑኸም የᎂጠሪያዪ፥ ተባቢሎን ያነቺ ኧተም ቤተ ክርስቲያን ሰላምታ ታቀርብንኩ፤ ትኸኛ ማርቆስም ሰላምታ ያቀርብንኩ።<note caller="-" style="x"><char style="xo" closed="false">5፥13 </char><char style="xt" closed="false"><ref loc="ACT 12:12">ሐዋ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>፤ <ref loc="ACT 15:37-39">15፥37-39</ref>፤ <ref loc="COL 4:10">ቆላ. 4፥10</ref>።</char></note><verse eid="1PE 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14" />በፍቅር ነብስ በነብሳሑ የተም ተጐቤኸም በወሰሰም ሰላም ተበበሮ። የክርስቶስ የኸንኩዪ ይንማሑ ሰላም የሕን።<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>