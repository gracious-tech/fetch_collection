<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">Mesqan New Testament 2 TIMOTHY</book>
  <para style="h">2 ተጢሞቴዎሴ</para>
  <para style="toc1">ዄታለኘዪ የሐዋርያዪ የጳውሎስ መልክት ተጢሞቴዎሴ</para>
  <para style="toc2">2 ተጢሞቴዎሴ</para>
  <para style="toc3">2 ጢሞ.</para>
  <para style="mt2">ዄታለኘዪ የሐዋርያዪ የጳውሎስ መልክት</para>
  <para style="mt">ተጢሞቴዎሴ</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ጳውሎስ የጢሞቴዎስ የጣᎈኒ ዚ ዄታለኘዪ መልክት፥ ጳውሎስ የቁርብ ረዳተሑ የሜና መራርቻሑም የኸነዪ ያርዴዪ ጢሞቴዎስ ያᎄኒ ምክር የጠበጠው፤ በጠቀለም የመኰረኒ በትዕግሥት ይቆምርኸሙ፤ ጢሞቴዎስ የምክር ያቡርታቸᎄ ቃልም የረከበ ስለኢየሱስ ክርስቶስ በታማኝነት ይምሰክርኸም፥ የምሥራቺ ቃል የጉርዚ ጉዳም ትምርት አጠበቀም ይጠብጥኸም ስርም መከራ ተቃውሞም ቢበዛወም፥ በዋትመር በወንጌል ሰባኪነትም ሜናሑ ይጋደልኸም ባነ።</para>
  <para style="ip">ጢሞቴዎስ በትለኘ ያጥኔቁቁᎄ ያᎅ በገውነት ቲሸኩቺዪ ቴድገልል ኦገት ይረቅኸም ባነ፤ ዚኸማቲ ቃር ይሰሞዪ ተዋጥፋ አንከንም እንጐድ ይᎅ ጥቅም ኤነን።</para>
  <para style="ip">በዚ እንም ጢሞቴዎስ ዋስታውስ የነበረወ የጳውሎስ ሕይወት የኑሮ ዓላማም በትለኘም እምነተሑ፥ ትዕግሥተሑ ፍቅረሑ፥ ወጥናሑ በስደትም የሰላወዪ መከራ ምሳሌ በወሕን ይትዄተልኸሙ።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="2TI 1:1-2">1፥1-2</ref> </char></para>
  <para style="io1">የጢሞቴዎስ ያᎅ ምክር <char style="ior"><ref loc="2TI 1:3-2:13">1፥3—2፥13</ref> </char></para>
  <para style="io1">በወልጋ ግዝየ ታማኝ ኸነም ወትረኸብ <char style="ior"><ref loc="2TI 2:14-4:5">2፥14—4፥5</ref> </char></para>
  <para style="io1">በወክቲ የነበሮዪ ሐለት ያሸ መመሪያዎችም <char style="ior"><ref loc="2TI 4:6-18">4፥6-18</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="2TI 4:19-22">4፥19-22</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />በክርስቶስ ኢየሱስ ቃል በገቧኒ የሕይወት ተስፋ መሠረት፣ በእዝጌር ፈአድ የክርስቶስ ኢየሱስ ሐዋርያ የኸነ ጳውሎስ፤ <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />የትወደደዪ ትኸኛ፣ የጢሞቴዎስ፤ ጸጋ፣ ምረት ሰላም ተእዝጌር አብ፣ ተጔታናም በክርስቶስ ኢየሱስ የሕን።<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16፥1</ref>። </char></note><verse eid="2TI 1:2" /></para>
  <para style="s1">ታማኝ የወሕን ያᎅ ዋብርታታ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />ታናቋርጥ ምሳር ተክናን በጠሎተኛ ስላኸ ትኔስብ፣ የበደሮ አቦች የሸከቶኸም በንጡ ሕሊና አመልኲ እዝጌርም አምሰጉን። <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />ኢንባኸ ትናስታውስ በብልቃት ኧመላዬ አዥከዬ ኧቦርስ። <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" />ግብዝነት ዬነወ እምነታኸ አስታውስ፤ ዚ እምነት ድረም በሜትያኸ በሎይድ ዛምኸም በዳኳኸ በኤውኒቄ ባነ፤ ኧሗ ባኸ ያነኸም ተሬዳሑም።<note caller="-" style="x"><char style="xo" closed="false">1፥5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">ሐዋ. 16፥1</ref>። </char></note> <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />ስለኸነም በጆቸኛ ወጫን የቌበርኰኒ በአኸ ውስጥ ያነዪ የእዝጌር ስጦታ ታንሳሳንኸም አቴስብከ፤ <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />እዝጌር የቆት የፍቅር፣ ኧራስም የወግዛ መንፈስ አንኸንም የጊናት መንፈስ አናበነ።<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />ኧጌሽ፤ የጔታና የወመስክርም የሑቲ ኧጉጀኘ በኸንኩ ቢያ ኤማልኸ፤ ቢኸንም በእዝጌር ቆት በወንጌል ቲያጌ መከራ ተቀበር፤ <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />ኢና የሸከትነዪ አትም ቴይኸን ተእቅደሑ ተጸጋሑ የትነሣ ያተረፈነ ተቅዱስ ሕይወቴ የጠራን ሑቲቱ። ዚ ጸጋ ተዘላለም ዘበናት ኢፍቴ በክርስቶስ ኢየሱስ አቡነ፤ <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ዚም ጸጋ አትርፎተና ኢየሱስ ክርስቶስ በወተኘሑ ኧሗ ተገለጠ። ሑቲ የሞት ቆት ድመሰሰም በወንጌል መሳ ሞት ዬነወ ዘለዓለማዊ ሕይወት ገለጠንነ።<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />እያም የዚ ወንጌል የምስራች ኤውጅ ሐዋርያ፣ አስተማሪም ኸንኩም ተሾምሑም።<note caller="-" style="x"><char style="xo" closed="false">1፥11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 ጢሞ. 2፥7</ref>። </char></note> <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />መከራ ኧቌበር የዚቱ፤ ቢኸንም ያመንኩኒ ሑቲ ኧሒን ስለኸነ አንትማለልወ፤ ያብኩኒ አደራ የዛ ከነ ስን ወቀየ ይችልኸም ተሬዳሑም። <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />ቢያ የሰማዀኒ በክርስቶስ ኢየሱስ ባነዪ እምነት ፍቅርም፤ የፈያ ትምርት ምሳሌ ሰክትም ጥብጥ። <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />ያቡከዪ ፈያዪ ዐደራ፣ ቢና ውስጥ ቢነብሪ በመንፈስ ቅዱስ ቀየ።<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />በእስያ አውራጃ ያኖዪ እንም ይያ ገፈሮኝም የወሮኸም ቲሒር፤ ተሕኖም ግብት ፊጌሉስ ሔርዋጌኔስም ይትረከቦ። <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />ጔታ የኦኔሲፎር አበሮስ ምረት ያብ፤ መሳመሑ ብዠ ግዝየ ሜናነት ሸከተኒም፤ ኧጉጀኘ በኸንኩወ ሰንሰለት አሟለለን። <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />ዛምኸም ሮም በቸኘወ ግዝየ ሸ ሸም ረከቤ። <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />በዛ ከነ ምረት ተጔታ ይረክቤ ጔታ ያቡ፤ በኤፌሶን ምን ቅጫ ያግለገሌኸም አኸ ፈያኸም ትሒር።<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s1">የክርስቶስ ታማኝ ወታደር በወሕን መከራ ወቀበር</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />ኧጌሽ ትኸኛ! አኸ በክርስቶስ ኢየሱስ ባነዪ ጸጋ በርታ። <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />በብዠ ምስክር ኢፍት ቢያ የሰማዀኒ፤ ኧንጐድ ያትመሬ ብቃት ያነኖዪ የታመኖ ሰቦች ዐደራ አብ። <verse eid="2TI 2:2" /><verse number="3" style="v" sid="2TI 2:3" />የክርስቶስ ኢየሱስ ፈያ ወታደርኸም፣ ቲናጌ መከራ ተቀበር። <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />በወታደርነት ያግለግል ሰብ አዛዠሑ የዋትብላልቅ ይትጋደል አንኸንም በንጐድ ሜና ራሰሑ ኤያጥላልፍ። <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />ዛምኸም በውድድር ይሳተፍ ሰብ፣ የውድድሪ ሕጊ ቂየም ባንትውዳደረ የውራጊ አክሊል ኤረኽብ። <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />ይትጋደል ገበሬ በሕሪ የወጠቀም የመጀመሪያ ይኸኔ ይጌቧን። <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />ኧብርኸዪ አጥራምት፤ ጔታ ብንም ቃር ዋጥራምት ይብኸ። <verse eid="2TI 2:7" /><verse number="8" style="v" sid="2TI 2:8" />ተሟቾቺ የትነሳዪ፣ ተዳዊት ዘር የኸነዪም ኢየሱስ ክርስቶስ አስታውስ፤ ይያም ወንጌል ዚቱ፤ <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />የዚም ወጀለኛኸም ወታገድ ስን መከራም ኧትቌበሩ፤ የእዝጌር ቃልም ኤታገድ። <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ስለኸነም በክርስቶስ ኢየሱስ ያነዪ ወትርፍ ተዘላለም ክብርጌ ሕኖም ይረክቦዬ፣ የትሜጠሮዪ ትንብር ይንም በትዕግሥት ኧጠና። <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />እኪ ይብሪ ቃል የታመነው፦</para>
  <para style="q1" vid="2TI 2:11">“ተሑቲጌ በᎀትነ፣</para>
  <para style="q2" vid="2TI 2:11">ተሑቲጌ በሕይወት ኧነብርነ።<verse eid="2TI 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12" />በትዕግሥት ጠናነም በትረከብነ</para>
  <para style="q2" vid="2TI 2:12">ተሑቲጌም ኧነግስነ።</para>
  <para style="q2" vid="2TI 2:12">በለጋኔ ሑቲም ይለጋነ።<note caller="-" style="x"><char style="xo" closed="false">2፥12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">ማቴ. 10፥33</ref>፤ <ref loc="LUK 12:9">ሉቃ. 12፥9</ref>፤ <ref loc="NUM 16:5">ዘሑ. 16፥5</ref>። </char></note><verse eid="2TI 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13" />ኢና ታማኞች ባንኸነ</para>
  <para style="q2" vid="2TI 2:13">ሑቲም ነብሰሑ ኤለጋ ስለኸነ እንጌ ታማኝ ኸነም ይነብር፤”<verse eid="2TI 2:13" /></para>
  <para style="s1">እዝጌር የትቌᎄረን ሜነተኘ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />ነዚሕኖ ቃርም ዋተስባኸ አትግፍር፤ በቃላት ኤይኦግቶኸም በእዝጌር ኢፍት አትቌየኖ፤ ዚ ጥቅም ኤነን፤ ይሰሞዪም ያፈርስ ቃሩ። <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />ቴሟልል የኢን ቃል በሱት ያትሬዳኸም የትምሰኰረነ ሜነተኘ፣ ነብሳኸ በእዝጌር ኢፍት ታቀርቤ ተጋደል። <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />እዝጌርም ቴያከብር ቴድገልል ወለፍልፍ ሲሕ፤ በዚም ዘንጋ የጠበጦ ሰቦች ተእዝጌር ቲረቆ ያሮው። <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />ትምርተሕኖ ኤጠርቅ መዛኸም ይስራጭ፤ ተሕኖም ግብት ሔሜኔዎስ ፊሊጦስ ይትረከቦ፤ <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />ሕኖም ተኢን ራቆም ያዝኖኖ። ሕኖም ትንሣኤ ሙታን ተዚ ኢፍቴ ኸነም ቲብሮ አትባተሕኖ እምነት ይግለብጦ። <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />የሕን አንኸንም፤ “ጔታ የሑቲ የኸኖዪ ይሒር፤” ኧሗም፤ “የጔታ ሽም ይጠራ እንም ተቡሼ ሜና የሲሕ” ይብር ማተብ ያነወ ኤንቅለቅል የእዝጌር መሠረት ቈመም።<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />ባት ወደል ቤት ውስጥ የወርቅ የብር ግብርም ጠለለ ቴይኸን፤ የጨ የሸክላ ግብርም ይነብር፤ ተዚም አታቲ የከበረ እጐዲም ያንከበረ አገልግሎት ይኸኖ። <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />ኧጌሽ ሟንም ነብሰሑ ተዚሕኖ ተጠቀስኩኖ ቃር ቢያነጣ የከበረ አገልግሎት ይወል፣ የትቄደሰ፣ የጔታውታን ይጠቅም፣ የፈያም ሜና እንም የዝጋጀ ግብር ይኸን።<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />ተአርድነት ቡሼ ኤላት ሲሕ፤ በንጡ ሒን ጔታ ቲጠሮዪምጌ ጽድቅም፣ እምነትም፣ ፍቅርም ሰላም ተክታተል። <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />ቴድገልል ትርጉም ቴነን ኦገት ሲሕ፤ መሳመሑ ዚ እንም መናክስ ያትዄተሎኸም ትሒር። <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />የጔታ አገልጋይ ይናከሴ ኤይጌቧን፤ ይልቅሽ የሰብ እንም ሜና፣ የዋትመር ብቃት ያነን፣ ፈራሒ ወሕን ይትጌቧን፤ <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ኢንም ተወሐሬ ይሰሎኸም፣ እዝጌር ንስሐም ይቦኸም ተስፋ በወሰክት ይቃወሞዪም በፈይነት ያቃና ወሕን ይነብርወ፤ <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />ዚም ተቀልበሕኖዬ ይዠበሮ፤ ፈአደሑ ያሸክቶዬ ምርኮኛ ሸከተም በጠበጠኖ ተዳቡሎስ ወሳኸ ያመልጦ በወበሩ።<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">በመጨረሻዪ ከነ ይኸን ክደት</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />ቢኸንም በመጨረሻዪ ዘበን ያጬንቅ ግዝየ ይቸኝኸም ዚ ሐር። <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />ሰቦች የነብሰሕኖ ይወዶ ይኸኖ፤ ዋጋ ይወዶ፣ ይትነነዶ፣ ትዕቢተኞች፣ ተሳዳቢዎች፣ የወላጀሕኖ ኤታዘዞ፣ ኤያመሰግኖ፣ ቅድስና ኤነኖ፣ <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />ፍቅር ዬነኖ፣ እርቅ የሕን ኤብሮ፣ ኧሟተኞች፣ ነብሰሕኖ ኤገዞ፣ ጨካኞች፣ ፈያ ቃር ኤወዶ። <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />ይለጎዪ፣ ዱጉዱጎች፤ ቤድገልል ቃር በትዕቢት የትነፎ፣ የእዝጌር ተወውድድ የጠቀለ ደንገኘ ወሕን ይወዶ። <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />የአይማኖት መልክ ነነኖ፤ ቆተሑም ለጎም። ተዚሕኖ ሲሕ። <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />ሕኖም ቤት ተቤት ሾለኮም ገቦም የአጢያት ብዛት የጫነነማ፣ በትልያየ ቡሼ ኤላት ውስጥ ገበማ ይውላውል መንፈስ ያነነማ የቌጠማ እንሽታ ያጠምዶኖ፤ <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />የዚኸማቲ እንሽታ እንጌ ይትመረማ፤ ቢኸንም የኢን ተወሐሬ ስርም ኤሰለማ። <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />ኢያኔስ ኢያንበሬስም የሙሴ የቃወሞይኸም ነዚ ሰቦች አእምሮሕኖ የትብላሸ በእምነትም ዘንጋ ውጥቀት የሰላቦ ስለኸነ የኢን ይትቃወሞ። <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />የሕን አንኸንም ኤይሳካኖ፤ መሳሑታም የዛሕኖ ሰቦች ገውነት የገለጠዪ እንም፣ የዚሕኖም ይንም ግልጽ ይኸን።<verse eid="2TI 3:9" /></para>
  <para style="s1">ጳውሎስ የጢሞቴዎስ ያᎄን ዐደራ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />አኸም ትምርተኛ፥ ኑሮኛ፥ ዐላማኛ፥ እምነተኛ፥ ትዕግሥተኘ ፍቅረኛ፥ በጠበጥኩን ወጥናኛ ተዄተልኸም፤ <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />ወሰደደኛ መከራኛም፣ በአንጾኪያ በኢቆንዮንም፣ በልስጥራንም የሰላቢ እንም፣ የፈረኩን ወሰደደኛ ትሒር፤ ጔታም ተዚ እንም አተረፌ።<note caller="-" style="x"><char style="xo" closed="false">3፥11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">ሐዋ. 13፥14-52</ref>፤ <ref loc="ACT 14:1-7">14፥1-7</ref>፣<ref loc="ACT 14:8-20">8-20</ref>። </char></note> <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />የኢየሱስ ክርስቶስ ጐሳ ኸኖም መንፈሳዊ ሕይወት ወንብር ይሸዎ እንም ስደት ይገጥሞ። <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />ቢኸንም ቡሼ ሰቦች አስመሳዮችም ሰቦች ቲያሰቶ ራሰሕኖም ቲሰሰቶ፥ በቡሼ ᎈር ቡሼ ቲደብሮ ያሮ። <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />አኸም በትማርዀን በትሬዳዀንም ጥና፤ ዚም ተሟ የትሟርኰንኸም ትሒር። <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />ተሰብዬነታኸ ቀረስከም፣ በክርስቶስ ኢየሱስ በወምን ወትርፍ ይትረከብወዪ ብላት ይቦከዬ ይቸሎ ቅዱሳት መጽሐፍ ሐርከም። <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />ቅዱስ መጽሐፍ እንም የእዝጌር መንፈስ ያነቦኖ፤ የዋትመር፣ የወጔስጥ፣ የዋቅና በጽድቅም ኤማ የወምክር ይጠቅሞ፤ <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ዚም የእዝጌር ሰብ የፈያ ሜና እንም የበቃ ኸነም ይትረከብኸሙ።<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />በእዝጌር ኢፍት በሕያዋንም በሟቾቺ ይፈርዴ ባነዪ በክርስቶስ ኢየሱስ ኢፍት፣ መገለጠሑም መንግሥተሑ በዋስብ ዚ ዐደራ ኧብርከ፤ <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />ቃለሑ ስበክ፤ ግዝየዪ ቢትሜችም ቤይትሜችም ተዝጋጅ፤ በወደል ትዕግሥት በዋትመርም አቅና፤ ገሥጥ፤ አብርታታ። <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />ሰቦች ሕይወት ይትረከብወዪ ትምርት የወስማ ኤሸዎᎄ ግዝየ ይቸኝ፤ ቢኸንም የወሬ በዋላ ሕኖ ነብሰሕኖ ይወዶዪ ቃር ይውዶዮዪ አስተማሪዎች ይስበሰቦ። <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />የኢን ተወስማ እዝነሕኖ ይዠብሮ፤ ተቸረታዬም ዞር ይብሮ። <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />አኸም በሐለታኸ እንም ተርጋጋ፤ መከራ ፍረክ፤ የወንጌል ሰባኪ ሜና ሰክት፤ አገልግሎታኸም ፈጥም።<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />እያም መሥዋት የወሕን ቀረብኩም፤ ተዚ ዓለም ተላኘሑም አርወ ግዝየ ሰላም፤ <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />ፈያዪ ገድል ተጋደልኩም፤ ሩጫዪ ፈጀሑም፤ አይማኖትም ቂየሑም። <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />ቲፍቴዬ የጽድቅ አክሊል ተዝጋጀኒም፤ ዚም ጻድቅ ፈራጅ የኸነ ጔታ በዛ ከነ ይያ ይቤ፤ ኧሗም ይያ ጠለለ ቴይኸን፣ የሑቲ መገለጥ የቦረሶ እንሙ።<verse eid="2TI 4:8" /></para>
  <para style="s1">የጳውሎስ ዋተስብ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />ከሞ ቲያዬ የወተኝ የቻልዀን እንም ሰክት፤ <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />ዴማስ ዚ ዓለም ወደደም፤ ገፈሬም ተተሰሎንቄዬ ወረም። ቄርቂስ ተገላትያዬ፣ ቲቶም ተድልማጥያዬ ወሮም፤<note caller="-" style="x"><char style="xo" closed="false">4፥10 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4፥14</ref>፤ <ref loc="PHM 1:24">ፊል. 24</ref>፤ <ref loc="2CO 8:23">2 ቆሮ. 8፥23</ref>፤ <ref loc="GAL 2:3">ገላ. 2፥3</ref>፤ <ref loc="TIT 1">ቲቶ</ref>።</char></note> <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />ሉቃስ ጠለለው ቲያጌ ያነ። ማርቆስ ባገልግሎተኛ ያግዜ ስለኸነ ጥቡጭም ኔኸ።<note caller="-" style="x"><char style="xo" closed="false">4፥11 </char><char style="xt" closed="false"><ref loc="COL 4:14">ቆላ. 4፥14</ref>፤ <ref loc="PHM 1:24">ፊል. 24</ref>፤ <ref loc="ACT 12:12">ሐዋ. 12፥12</ref>፤ <ref loc="ACT 25">25</ref>፤ <ref loc="ACT 13:13">13፥13</ref>። </char></note> <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />ቲኪቆስም ተኤፌሶኔ ላክሑንም።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">ሐዋ. 20፥4</ref>፤ <ref loc="EPH 6:21-22">ኤፌ. 6፥21-22</ref>፤ <ref loc="COL 4:7-8">ቆላ. 4፥7-8</ref>። </char></note> <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />ትትቸኝ በጢሮአዳ በካርፑሴ የገፈርኩኒ ካባ ጥብጥኒም ኔኸ፤ መጽሐፊም ይልቅሽ የብራና መጽሐፊ አተኝኒ።።<note caller="-" style="x"><char style="xo" closed="false">4፥13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">ሐዋ. 20፥6</ref>። </char></note><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />አንጥረኘዪ እስክንድር ከፍተኘ ጉዳት አሰላቢም፤ ጔታ የሜናሑኸም ይከፉል።<note caller="-" style="x"><char style="xo" closed="false">4፥14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 ጢሞ. 1፥20</ref>፤ <ref loc="PSA 62:12">መዝ. 62፥12</ref>፤ <ref loc="ROM 2:6">ሮም 2፥6</ref>። </char></note> <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />መልክተናም ስርም ተቃወመም፣ አኸም ተሑቲ ተቀየ።<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />በከሰስኩወ ዘንጋ የመጀመሪያ መከላከያኛ ትናቀርብ ሟንም ያግዜዬ አንተኘ፤ ቢኸንም እንም ገፈሮኝም ወሮ። ዚም ኤቆጥርቦ። <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />ቢኸንም መልክቲ ቢያ መሳ በሙላት ይሰብክኸም አሕዛብ እንም ይሰሞይኸም ጔታ በሜጠቀኛ ቈመም አብረቴ፤ ተአንበሳም ዳንጋ አተረፌ። <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />ጔታ ተቡሼ ዘንጋ እንም ያተርፌ፤ ተሰሜ መንግሥተዄም በሰላም ያሰሌ፤ የሑቲ ተዘለዓለም ዘለዓለም ስን ክብር የሕን፤ አሜን።<verse eid="2TI 4:18" /></para>
  <para style="s1">የመጨረሻ ሰላምታ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />የጵርስቅላ<note caller="+" style="f"><char style="fr" closed="false">4፥19 </char><char style="ft" closed="false">ግሪኩ </char><char style="fqa" closed="false">ጵርስቃ </char><char style="ft" closed="false">ይብር። </char></note> የአቂላም፣ ኦኔሲፎር አበሮስ ሰላምታ አቅርብኒ።<note caller="-" style="x"><char style="xo" closed="false">4፥19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">ሐዋ. 18፥2</ref>፤ <ref loc="2TI 1:16-17">2 ጢሞ. 1፥16-17</ref>። </char></note> <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />ኤራስጦስ በቆሮንቶስ ቀኘም፤ ጥሮፊሞስ ያቌን ስለኸነ በሚሊጢን ገፈርኩንም።<note caller="-" style="x"><char style="xo" closed="false">4፥20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">ሐዋ. 19፥22</ref>፤ <ref loc="ROM 16:23">ሮም 16፥23</ref>፤ <ref loc="ACT 20:4">ሐዋ. 20፥4</ref>፤ <ref loc="ACT 21:29">21፥29</ref>። </char></note> <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />ተበርግ ኢፍቴ ዚዬ የወተኝ የቻልዀኒ ሰክት። ኤውቡሉስ ጱዴስም ዚም ሊኖስ፣ ቅላውዲያ ጐባቢት እንም ሰላምታ ያቀርቦንከ።<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />ጔታ ተመንፈሳሑጌ የሕን። ጸጋ ታሑጌ የሕን።<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>