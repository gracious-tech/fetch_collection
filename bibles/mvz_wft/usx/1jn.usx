<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">Mesqan New Testament 1 JOHN</book>
  <para style="h">1 የዮሐንስ</para>
  <para style="toc1">መጀመሪያው የሐዋርያዪ የዮሐንስ መልክት</para>
  <para style="toc2">1 የዮሐንስ</para>
  <para style="toc3">1 ዮሐ.</para>
  <para style="mt">የመጀመሪያ የሐዋርያዪ ዮሐንስ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">የመጀመሪያዪ የሐዋርያዪ የዮሐንስ መልክት ዄት ዋና ዋና ዓላማ ነኖይ። ሕኖም ያነቦዪ ተእዝጌርም ተትኸው ተኢየሱስ ክርስቶስጌ አትነት ይነብሮኸም የዋብርታታ ዚም አትነትም ያጠፋዬ ቢችሊ ባጢለተኘ ትምርት ይረቆኸም የዋትቀየው። በዛም ግዝየ የትኸለቀዪ ባጢለተኘ ትምርት ቡሼነት ይፈልቂ ተወደሊ ዓለምጌ ቢሸኩቺ ወትራኸብ ስለኸነ የእዝጌር ትኸ ኢየሱስ ስርም ሰብ ይኸኔም የሰብአዊነት አመል ይነቡሬ ኤይችል ይብር ባነ። ነዛሕኖ አስተማሪ “ወትርፍ ወበር የዓለማዊዪ ኑሮ ተወጨነቅ ነጣ ወውጣው” ይብሮ ባነ፤ ተዚምጌ “ፈያ ሜና ወሰክት አቋምም ኸነ ይንጐዲ ሰብ ፍቅር ዋተዥ ተወትርፍጌ አትም ሩሕቦት” ዬነን ይብሮ ባነ።</para>
  <para style="ip">ጣሐፊዪ ዚም ትምርት በወቃወም ኢየሱስ ክርስቶስ ፍጡም ሰቡ፤ በኢየሱስ ያምኖዪ የእዝጌር ይወዶዪም እንም ነፍስ በነብሰሕኖም ወትዋደድ ይነብርቦ በወበር አፍታታም።</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="1JN 1:1-4">1፥1-4</ref> </char></para>
  <para style="io1">ብራን ተጨለማ <char style="ior"><ref loc="1JN 1:5-2:29">1፥5—2፥29</ref> </char></para>
  <para style="io1">የእዝጌር ዴጋ የዳቡሎስ ዴንጋም <char style="ior"><ref loc="1JN 3:1-24">3፥1-24</ref> </char></para>
  <para style="io1">ኢን ስተትም<char style="ior"><ref loc="1JN 4:1-6">4፥1-6</ref> </char></para>
  <para style="io1">የፍቅር ግዴታ <char style="ior"><ref loc="1JN 4:7-21">4፥7-21</ref> </char></para>
  <para style="io1">ውራግ ይሸክት እምነት <char style="ior"><ref loc="1JN 5:1-21">5፥1-21</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s1">የሕይወት ቃል</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />በመጀመሪያ ስለነበረዪ ስለሕይወት ቃል ኧጠፍንኩ፤ ዚ የሕይወት ቃል የሰማኔዪም ቤኖቸና ያዠነዪ፤ የትምሌከትነዪም ኧጆቸና የድባበሶዪ ኧዝነጊነ።<note caller="-" style="x"><char style="xo" closed="false">1፥1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">ዮሐ. 1፥1</ref>። </char></note> <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />ሕይወት ተገለጠ፤ ኢናም አዠነይም፤ ኧትምሌከትነ። በአቤ የነበረዪ፤ ይናም የትገለጠንነዪ የዘላለም ሕይወት ኢውድነኩ፤<note caller="-" style="x"><char style="xo" closed="false">1፥2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">ዮሐ. 1፥14</ref>። </char></note> <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />አሑም ቲናጌ አትነት ይነብሩሑኸም፤ ያዠነዪ የሰማኔዪም ኢውድነኩ፤ አትነተናም ተአብ፤ ተትኸው ተኢየሱስ ክርስቶስጌው። <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />ብልቃተናም ፍጡም ይኸኔ ዚም ኧጠፍንኩ።<note caller="+" style="f"><char style="fr" closed="false">1፥4 </char><char style="fqa" closed="false">ብልቃተና፦ </char><char style="ft" closed="false">አታት የጎጋ ጡሑፎች “ብልቃታሑ” ይብሮው። </char></note><verse eid="1JN 1:4" /></para>
  <para style="s1">በብራን ወዥባበር</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />ተሑቲ የሰማኔዪ ያሑም ኧዝነጊነኩ መልክት፤ “እዝጌር ብራኑ፤ ጨለማም በሑቲዬ ሥርም ኤነ” ይብሪው። <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />በጨለማ ትንዥባበርነ ተሑቲጌ አትነት ነነነ ብንብርነ ኧዋሽነ፤ የኢንም አንነብርነᎄ። <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />ቢኸንም ሑቲ በብራን ያነኸም፤ ኢናም በብራን ብንዥባበርነ ነብስ በነብሰና አትነት ነነነ፤ የትኸኹ የኢየሱስ ክርስቶስ ደም ተአጢአት እንም<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="ft" closed="false">ወይም </char><char style="fqa" closed="false">ተሟንመሑም</char></note> ያነጣነ።<note caller="-" style="x"><char style="xo" closed="false">1፥7 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሐ. 13፥34</ref>። </char></note><verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />አጢያት ኤነብነ ብንብርነ፤ ነብሰና አሰትነ፤ ኢንም ቢና ውስጥ ኤነ። <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />አጢያተናም ብንናዘዝነ አጢያተና አፉ ይብርነዬ፤ ተዐመጣ እንም ያነጣነዬ ሑቲ ታማኝ ጻድቅሙ። <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />አጢያት አንሰከትነ ብንብርነ፤ የእዝጌር ባጢለተኘ ኧሸክትኔ፤ ቃሊም ቢና ውስጥ ኤነ።<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s1">ክርስቶስ ጠበቃና ወሕነሑ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ዴጋኛ፤ ዚም ኧጠፍንኩ አጢያት አትሸክቶኸሙ፤ ቢኸንም ሟንም ሰብ አጢያት ቢሸክት በአቤ ጠበቃ ነነነ፤ ሑቲም ጻድቂ ኢየሱስ ክርስቶሱ።<note caller="-" style="x"><char style="xo" closed="false">2፥1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">ዮሐ. 1፥12</ref>። </char></note> <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />ሑቲም የአጢያተና ይሴርዥᎄው፤ ዛም<note caller="+" style="f"><char style="fr" closed="false">2፥2 </char><char style="ft" closed="false">አጢያተናም አትዌገደም የእዝጌር ማት ቲና ሽቅ ያቢ ሑቲቱ ዛም ይና አጢያት ጠለለ ቴኸን የዓለም አጢያት ወበሩ</char></note> ይና አጢያት ጠለለ ቴይኸን የዓለሚም እንም አጢያት ይድᎀሽሽ በሑቲቱ።<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />ትዛዛተሑ ብንፌጥምነ የሑቲ ወሐረናም በዚ ናርጋግጥነ። <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />“የሑቲ ኧሒን” ቲብር ትዛዘሑ ኤይፌጥም ባጢለተኘው፤ የኢኒ በሑቲ ውስጥ ኤነ። <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />ቢኸንም ሟንም ቃለሑ ቢቂየ፤ በኢን የእዝጌር ፍቅር<note caller="+" style="f"><char style="fr" closed="false">2፥5 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">የእዝጌር ያነን ፍቅር </char><char style="ft" closed="false">ወበሩ። </char></note> በሑቲ ፍጡም ኸነም። በሑቲ ወሕነናም ኧሒርነይ በዚቱ፤ <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ሟንም በሑቲ ኧነብር ይብር፤ ኢየሱስ ይዥባበርኸም ይጌቧን።<verse eid="1JN 2:6" /></para>
  <para style="s1">ገደሪ ትዛዝ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />ደቦቸኛ! ኧጠፍንኩዪ፤ ተመጀመሪያዪ የነበረናሑዪም ዬከሰዪ ትዛዝ አንከነ፤ ዬከሰዪ ትዛዝ የሰማሑዪ ቃሉ። <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />ብንጐድ አዘር ኧጠፍንኩዪ ጨለማዪ ቲያልፍ የኢነተኘዪ ብራን ቲበራ ትናነ፤ በሑቲም፤ ባሑዬ ኢንም የኸነዪ ገደር ትዛዙ።<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />በብራን ነንኩ ይብር፤ የጐቤሑ ይጠላ ኧሗም በጨለማ ውስጡ። <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />የጐቤሑ ይወድ በብራን ይነብር፤ በሑቲዬ ይስናከልወ መሳ ኤነን። <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />ቢኸንም የጐቤሑ ይጠላ በጨለማ ውስጡ፤ በጨለማ ይዥባበር፤ ጨለማዪ ወዥ ኤችልኸም የሸኰተን ስለኸነ ኤቴ ያርኸም ኤይሒር።<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ዴጋኛ፥ አጢያተሑ በኢየሱስ ሽም ተሴረዘንኩም፤ ኧጠፍንኩ። <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />አቦች፤ ተመጀመሪያ ያነዪ የሑቲ ሐርኩይም፤ ኧጠፍንኩ። አርዴዎች፤ ቡሼዪ<note caller="+" style="f"><char style="fr" closed="false">2፥13 </char><char style="ft" closed="false">ቡሼዪ ወበር የሼጣን ሽሙ፤ </char></note> ቌመሑይም፤ ኧጠፍንኩ። ዴጋ፤ አብ ሐርኩይም፤ ኧጠፍንኩ። <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />አቦች፤ ተመጀመሪያ ያነዪ ሑቲ ሐርኩይም፤ ኧጠፍንኩ። አርዴዎች፤ የብረታሑ የኸንኩ ስለኸነ፤ የእዝጌር ቃል ባሑ ይነብር ስለኸነ፤ ቡሼዪም የቌመሑ ስለኸነ፤ ጣፈኩንኩም።<verse eid="1JN 2:14" /></para>
  <para style="s1">ዓለምም አትውደዶ</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />ዓለም ወይ በዓለም ያነዪ ቃር እንም አትውደዶ፤ ሟንም ዓለም ቢወድ፤ የአብ ፍቅር በሑትዬ ኤነ፤ <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />መሳሑም በዓለም ያነዪ እንም፦ የበሠር ኤላት፤ የዔን ቡረሾ፥ የኑሮ ወትነነድ ተዓለሙ አንኸንም ተእዝጌር አብ ይቸኝ አንከነ። <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />ዓለም ኤላትም ይቸለፎ፤ የእዝጌር ፈአድ ይፌጥም የዘላለም ይነብር።<verse eid="1JN 2:17" /></para>
  <para style="s1">ክርስቶስ ቲቃወሞዪ ጥንቃቄ ወሰክት</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ዴጋኛ! ዚ የመጨረሻዪ ሰዓቱ፤ የሰማሑይኸም የክርስቶስ ተቃዋሚ ይቸኝ፤ ኧሗም ብዠ የክርስቶስ ተቃዋሚዎች ቸኖም፤ የመጨረሻ ሰዓት የኸነኸም ኧሒርነዪ በዚቱ። <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />ቲና ግብት ወጦ፤ የሕን አንኸንም ቲና ጐሳ አነበሮ፤ ቲና ጐሳ ቢኸኖማ ቲናጌ ጠኖም በነበሮ ባነ። ቢኸንም እንም ቲና ጐሳ ያንከኖኸም ይትኴሬ ቲና ተላኖ።<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />አሑም ክርስቶስ በመንፈስ ቅዱስ ቀባናሑም። ስለኸነም እንማሑም እንምቃር ቲሒሮ። <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />እያ ኧጠፍንኩ ኢንም አቲሒሮ ስለኸነ አንከነ፤ ቢኸንም ኢንም አቲሒሮይ ስለኸነ አንከነ፤ ቢኸንም ኢንም ቲሒሮይ ስለኸነዪም ተኢን አትም ባጢል ኤወጣ ስለኸነው።<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />ክርስቶስ አንከነ ባረም ኢየሱስም ተወልጋሑ ባጢለተኘ ሟኒ? ዚ አብ ወልድም ይለጋዪ የክርስቶስ ተቃዋሚው። <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />የወልድ ይለጋ እንም አብ ኤነን፤ የወልድ ያምን እንም አብ ነነን።<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />በመጀመሪያ የሰማሑይ ባሑ ውስጥ የንብር፤ በመጀመሪያ የሰማሑዪ ባሑ ውስጥ ቢነብር፤ አሑም በወልድ በአብም ትነብሮ። <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />ዚ ሑቲ ያበነ ተስፋ የዘላለም ሕይወቱ።<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />ያሰቶኩ ስለኸኖዪ ሰቦች ዚ ጣፍኩንኩም። <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />አሑም ተሕኖ የቌበርኩይ ቅባት በውስጣሑ ይነብር፤ ሟንም ኤያትመርኩዬ ኤያሸ፤ ቢኸንም ኢንም አንከንም ባጢል ያንከነ የሑቲ ቅባት ይንም ቃር ያትመሮኩ ስለኸነ፤ ዛም ሐቁ አንከንም ባጢል ያንከነኸም፤ ያሑም ያትመረናሑኸም በሑቲ ንብሮ።<verse eid="1JN 2:27" /></para>
  <para style="s1">የእዝጌር ዴጋ</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />ኧጌሽ ዴጋኛ! ክርስቶስ ቲገለጥ ድፍረት ይነብርነኸም፤ ቢቸኝወ ግዝየ ኤማልልነኸም በሑቲ ንበሮ። <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />ሑቲ ጻድቅ ወሕነሑ በሐርኩ፤ ጽድቅ ይሸክት እንም ተሑቲ የጨኘኸም ቲሒሮ።<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s1">የእዝጌር ዴጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />የእዝጌር ዴጋ ቧርነም ኧጠራነኸም አብ ምንኸም አበዛም በፍቅር የወደደነኸም ኧዞ! ኢናም ዛምኸም ዴንጋንነ። ዓለም ይና ኤይሒርነ የሑቲ ያንኳረን ስለኸነው። <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />ደቦዎች፤ ኢና ኧሗ የእዝጌር ዴንጋንነ፤ ቲፍቴ ምን ኧኸነኸም ገና አንኳሪ። ክርስቶስ ቢትገለጥወ<note caller="+" style="f"><char style="fr" closed="false">3፥2 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">ቢትኴርወ ግዝየ</char></note> ግዝየ አዥነይ፤ ሑቲ ኧመስርነኸም ኧሒርነ። <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />በሑቲ ዚ ተስፋ ይሸክት እንም፤ ሑቲ ንጡ የኸነኸም ራሰሑ ያነጣ።<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />አጢያት ይሸክት እንም ዐመጥ ይሸክት፤ አጢያትም ዐመጡ። <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />ሑቲ አጢያት ያትዌግዴ የገለጠኸም ቲሒሮ፤ በክርስቶስ አጢያት ኤነ።<note caller="-" style="x"><char style="xo" closed="false">3፥5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">ዮሐ. 1፥29</ref>። </char></note> <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />በክርስቶስ ይነብር አጢያት ኤሸክት፤ አጢያት ይሸክት የሑቲ አነዠን ወይ አኳረን።<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ዴጋ፤ ሟንም ኤያሰትኩኸም ተቀሮ፤ ክርስቶስ ጻድቅ የኸነኸም፤ ጽድቅም ይሸክት ጻድቁ። <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />አጢያትም ይሸክት ተዳቡሎሱ። መሳሑም ዳቡሎስ ተድረ ቀረሰም አጢያት ይሸክት ስለኸነው። የእዝጌር ትኸ ቸኘም የታዠዪ የዳቡሎስም ሜና ያፈርስኸሙ።<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />ተእዝጌር የጨኘ እንም አጢያት ኤሸክት፤ የሑቲ ዘር በውስጠሑ ይነብር። ተእዝጌር የጨኘ ስለኸነ አጢያትም ይሸክቴ ኤይችል። <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />የእዝጌር ዴጋ የዳቡሎስ ዴንጋም ተላኖም ይትኴሮᎄ በዚቱ፦ ጽድቅ ኤይሸክት ጐቤች ኤይወድ እንም ተእዝጌር አንከነ።<verse eid="1JN 3:10" /></para>
  <para style="s1">ነብስ በነብሳሑ ተዋደዶ</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />በመጀመሪያ የሰማሑዪ፤ ነፍስ በነብሰናም ንትዋደድነዬ ይትጌባነ ይትበኚ መልክት ዚቱ፤<note caller="-" style="x"><char style="xo" closed="false">3፥11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሐ. 13፥34</ref>። </char></note> <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />የቡሼ ጐሣ ኸነም ጐቤሑ የቀጠረ የቃየልኸም አትሕኖ፤ የመአር ቈጠረን? መሳሑም የሑቲ ሜና ቡሼ፤ የጐቤሑም ጽድቅ የኸነ ስለኸነው።<note caller="-" style="x"><char style="xo" closed="false">3፥12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">ዘፍ. 4፥8</ref>። </char></note><verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />በጔታ ጐባቢት፤ የዚ ዓለም ሰብ ቢጠላሑ አትደነቆ። <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />ጐባቢተና ኧወድነ ስለኸነ ተሞት ተሕይወቴ የጔናነኸም ኧሒርነ፤ ፍቅር ኤነን እንም በሞት ይነብር።<note caller="-" style="x"><char style="xo" closed="false">3፥14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">ዮሐ. 5፥24</ref>። </char></note> <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />የጐቤሑ ይጠላ ሰብ የቀጠረው፤ ሰብ ይቀጥር የዘለዓለም ሕይወት ኤነንኸም ቲሒሮው። <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />ኢየሱስ ክርስቶስ ነብስያሑ ስለኢና አቼለፈም ያበ ስለኸነ፤ ፍቅር ምን የኸነኸም በዚ ኧሒርነ፤ ኢናም ሕይወተናም ስለጐባቢተና አቼለፍነም ይብነዬ ይትጌባነ። <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />ሟንም ዱንያ ትናነን፤ ጐቤሑ ቲትመካ አዠም ቤይራራነ፤ የእዝጌር ፍቅር ምንኸም በሑቲ ይነብር? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ዴጋ፤ በሜናም በኢን አንከንም በቃልም በንግግር ጠለለ አንትዋደድነ።<verse eid="1JN 3:18" /></para>
  <para style="s1">በእዝጌር ኢፍት ያነነነ ወትማመን</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />ኢና የኢን ጐሳ ወሕነናም በዚ ኧሒርነ፤ ሒነናም ቢፍተሑ ክፍት ኧሸክትነ፤ <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />ዚም ሒነና ቢና ᎈር ቢፈርድብነ ቃር እንሙ። እዝጌር ተሒነና የጠቀለ ወደሉ እንም ቃር ይሒር። <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ደቦዎች፤ ሒነና ኤይፈርድብነ በኸነ በእዝጌር ኢፍት ድፍረት ነነነ፤ <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />ትዛዛቲም የቂየነ ስለኸነ ቢፍተሑ ያትቡላልቁ ቃር ኧሸክት ስለኸነ ኧጮቅስነዪም እንም ተሑቲ ኧቌበርነ። <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />ትዛዚም በትኸሑ በኢየሱስ ክርስቶስ አምንነኸም ሑቲ ዬዘዘነኸም ነብስ በነብሰና ኧትዋደድነኸሙ።<note caller="-" style="x"><char style="xo" closed="false">3፥23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሐ. 13፥34</ref>፤ <ref loc="JHN 15:12">15፥12</ref>፤ <ref loc="JHN 17">17</ref>። </char></note> <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />ትዛዞቺም ይቅሮ እንም በሑቲ ይነብሮ፤ እዝጌርም በሕኖ ይነብር። ቢና ወንብረሑ ዛምኸም ሑቲ ባበነ መንፈስ ኧሒርነ።<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s1">መናፍስቶች መርምሮ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />ደቦዎች፤ መንፈስ እንም አትምኖ፤ ቢኸንም መናፍስት ተእዝጌር ወሕነሕኖ መርምሮ፤ መሳሑም ብዠ ባጢለተኞች ነብዮች ተዓለሜ ወጦም። <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />የእዝጌር መንፈስ በዚ ቲሒሮ፤ ኢየሱስ ክርስቶስ ሰብ ኸነም በበሠር የቸኘኸም ይቄበር መንፈስ እንም ተእዝጌሩ፤ <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />የኢየሱስ ኤይቌበር መንፈስ ተእዝጌር አንከነ፤ ይቸኝኸም የሰማሑዪ የክርስቶስ ተቃዋሚ መንፈስ ዚቱ፤ ኧሗም በዓለም ነነ።<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ዴንጋ፤ አሑ ተእዝጌርንኩ፤ የሕኖም<note caller="+" style="f"><char style="fr" closed="false">4፥4 </char><char style="ft" closed="false">ሕኖ ወበር የክርስቶስ ይቃወሞዪ ኖ ወበሩ። </char></note> ቌመሑዮም፤ መሳሑም ባሑ ውስጥ ያነዪ በዓለም ታነዪ ይበዛ። <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />ሕኖ በዓለምኖ፤ ስለኸነ ይዝነጎዪ የዓለምኸሙ፤ ዓለምም ይሰማኖ። <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />ኢና ተእዝጌርንነ፤ የእዝጌርም ይሒር ይሰማነ፤ ተእዝጌር ያንከነ ኤይሰማነ፤ በዚም የኢን መንፈስ የባጢልም መንፈስ ኧሒርነ።<verse eid="1JN 4:6" /></para>
  <para style="s1">የእዝጌር የሰብም ፍቅር</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ደቦዎች፤ ፍቅር ተእዝጌር ስለኸነ ነፍስ በነብሰናም ንትዋደድነ፤ ይወድ እንም ተእዝጌር የጨኘው፤ የእዝጌርም ይሒር። <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />ቢኸንም እዝጌር ፍቅር ስለኸነ የሰብ ኤይወድ እንም የእዝጌር ኤይሒር። <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />እዝጌር ፍቅረሑ በግብተና የጐለጠን እኪቱ፤ ኢና በሑቲ መሳ በሕይወት ኧነብርነዬ እዝጌር ቁናዪ ትኸሑ ተዓለሜ ላዀን። <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />ፍቅር ዚቱ፤ ኢና የእዝጌር የወደድኔኸም ቴይኸን ሑቲ የወደደነኸም ስለአጢያተናም ይሴርዝንነ<note caller="+" style="f"><char style="fr" closed="false">4፥10 </char><char style="ft" closed="false">ወይ </char><char style="fqa" closed="false">አጢአተና አትዌገደም፣ ማተሑ ሽቅ ያበይንነኸም</char></note> ይኸኔ የትኸኹ ወላከውታው።<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ደቦዎች! እዝጌር ዚኸም በወደደነ ኢናም ነብስ በነብሰና ወትዋደድ ይጌባነ። <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />የእዝጌር ያዠን ስርም ሟንም ኤነ። ነብስ በነብሰና ብንትዋደድነ እዝጌር ቢና ውስጥ ይነብር፤ ፍቅረሑ ቢና ፍጡም ይኸን።<note caller="-" style="x"><char style="xo" closed="false">4፥12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">ዮሐ. 1፥18</ref>። </char></note><verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />መንፈሰሑ ያበነ ስለኸነ፤ ኢና በሑቲ ኧነብርነኸም ሑቲም ቢና ይነብርኸም ኧሒርነ። <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />አብ ትኸሑ የዓለም ያተርፍ ይኸኔ የላዀንኸም አዠነም፤ ኧምሰክርነ። <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />ኢየሱስ የእዝጌር ትኸ የኸነኸም አመነም ቢምሰክር እንም፤ እዝጌር በሑቲ ይነብር፤ ሑቲም በእዝጌር ይነብር። <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />ስለኸነም እዝጌር ይና ያነኒ ፍቅር ኧሒርነ፤ በፍቅረሑ ናምንነ። እዝጌር ፍቅሩ፤ በፍቅር ይነብር በእዝጌር ይነብር፤ እዝጌርም በሑቲ ይነብር። <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />በዚ ዓለም ሑቲ ኧመስርነ። በፍርድ ከነ ድፍረት ይነብርነኸም፤ ፍቅር በዚኸማት በግብተና ፍጡም ኸነም፤ <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />በፍቅር ጊናት ኤነ፤ ፍጡም ፍቅር ጊናት አወጣም ያድግ፤ ጊናት ተቅጣትጌ የጥባበጠው። ይጔናም ሰብ ፍቅረሑ ፍጡም አንከነ።<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />ሑቲ በደረም ወደደነም ኢናም ኧወድነይ። <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ሟንም፤ “የእዝጌር ኧወጅጅ” ቲብር የጐቤች ቢጠላ፤ ሑቲ ባጢለተኘው፤ ያዠኒ ጐቤውታን ኤይወድ ያነዠኒ እዝጌር ወውድድ ኤይችል። <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />ስለኸነም የእዝጌር ይወድ የጐቤች ኧሗም ይወድኸም ዚ ትዛዝ በሑቲ ነነ።<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s1">በእዝጌር ትኸ ወምን</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />ኢየሱስ ሑቲ ክርስቶስ የኸነኸም ያምን እንም በእዝጌር ተጨኘም፤ የአብ ይወድ እንም የትኸሑ ዛምኸም ይወድ። <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />የእዝጌር ትንወድነም ትዛዘሑ ትንፌጥምነ የእዝጌር ዴጋ ኧወድነኸም በዚ ኧሒርነ፤ <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />የእዝጌር ወውድድ ትዛዘሑ ወፈጥሙ። ትዛዘሑም ይረዝ አንከነ፤<note caller="-" style="x"><char style="xo" closed="false">5፥3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">ዮሐ. 14፥15</ref>። </char></note> <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />መሳሑም ተእዝጌር የጨኘ እንም የዓለም ይቌም። የዓለም ይቌም እምነተናው። <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />ኢየሱስ የእዝጌር ትኸ የኸነኸም ቲያምን አንኸንም የዓለም ይቌም ሟኒ?<verse eid="1JN 5:5" /></para>
  <para style="s1">ስለክርስቶስ ያᎅ ምስክርነት</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />ጥምቀተሑ ቢያምለክት ኧጋም ሞተሑ ቢያምለክት ደም የቸኘ ኢየሱስ ክርስቶሱ። ሑቲ የቸኘ በጋ ጠለለ ቴይኸን በጋም በደሙ። ዚም የኢን ስለኸነ ዚ ዘንጋ የኢን ወሕነሑ መንፈስ ቅዱስ ይምሰክር፤ <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />ሦስት ምስክሮች ነኖ፤ <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />ሕኖም<note caller="+" style="f"><char style="fr" closed="false">5፥8 </char><char style="fqa" closed="false">በአፈር ይምሰክሮዪ ሦስቲ ኖ </char><char style="ft" closed="false">ቢኸንም ዚ ተ 16ኛዪ ክፍለ ዘበን ኢፍቴ በነበሮዪ የግሪክ ቅጂዎች ውስጥ ኤይትረከቦ። </char></note> መንፈስ፥ ኧጋም ደምኖ፤ ነዚም ሦስቲ በምስክርነት ይስማሞ። <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />ሰቦች ይቦዪም ምስክርነት ኧቌበርነ፤ ቢኸንም የእዝጌር ምስክርነት ትንም ይበዛ። እዝጌር ስለትኸው ያᎄን ምስክርነት ዚቱ። <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />በእዝጌር ትኸ ያምን ዚ ምስክርነት በሒነሑ ውስጥ ነነ፤ የእዝጌር ኤያምን እዝጌር ስለትኸው ያᎄኒ ምስክርነት ባለወምነሑ የእዝጌር ባጢለተኘ ሸኰተንም። <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />ምስክርነተሑ እዝጌር የዘላለም ሕይወት ያበነኸም ዚም ሕይወት በትኸኹ ያነኸም ይምሰክሩ።<note caller="-" style="x"><char style="xo" closed="false">5፥11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">ዮሐ. 3፥36</ref>። </char></note> <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />የእዝጌር ትኸ ያነን ሕይወት ነነን። የእዝጌር ትኸ ዬነን ሕይወት ኤነን።<verse eid="1JN 5:12" /></para>
  <para style="s1">የዘለዓለም ሕይወት</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />በእዝጌር ትኸ ሽም ያመንኩ አሑ፤ የዘለዓለም ሕይወት ያነናሑኸም ቲሒሮዬ ዚ ኧጠፍንኩ፤ <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />በእዝጌር ኢፍት የወቅርብ ያነነ ድፍረት ዚቱ፤ ሟንመሑ ቃር የሑቲ ፈአደሑኸም ብንጮቅስነ ሑቲ ይሰማነ፤ <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />ኧጮቅሥነዪም እንም ይሰማነኸም በሐርነ፤ የጮቀስነዪ ቃር የቌበርነኸም ኧሒርነ።<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ሟንም ሰብ ጐቤየሑ የሞት ያሰላ አጢያት ቲሸክት ቢያዥን የጠልይነ፤ እዝጌርም የሞት ያሰላ አጢያት በሸከቶዪ ሕይወት ይብ። የሞት ያሰላኒ አጢያት ነነ፤ የዚዋኘዪም የጠልይ አንብር። <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />ዐመጥ እንም አጢያቱ፤ የሞት ያሰላም አጢያት ነነ።<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />ተእዝጌር የጨኘ እንም አጢያት ኤሸክትኸም ቢኸንም የእዝጌር ትኸ ይቁየንኸም፤ ቡሼም ኤለጉጅኸም ኧሒርነ።<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />ኢና ተእዝጌር የኸነኸም፤ እንመሑ ዓለምም በቡሼ ተት የኸነኸም ኧሒርነ።<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />የእዝጌር ትኸ የቸኘኸም፤ የኢነተኘዪ አምላክ ኧሒርነኸም አጥራማች ሒን ያበነኸምም ኧሒርነ በትኸኹም በኢየሱስ ክርስቶስ የኢነተኘዪ አምላክጌ አትነት ነነ። ኢየሱስ ክርስቶስ የኢተኘዪ አምላክ የዘለዓለምም ሕይወቱ።<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ዴንጋ፤ ራሳሑ ጣዖቶች ተዋምልክ ተቀሮ።<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>