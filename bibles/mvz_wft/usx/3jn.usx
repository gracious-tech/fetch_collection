<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">Mesqan New Testament BIBLE 3 JOHN</book>
  <para style="h">3 የዮሐንስ</para>
  <para style="toc1">ሦስታለኘዪ የሐዋርያዪ የዮሐንስ መልክት</para>
  <para style="toc2">3 የዮሐንስ</para>
  <para style="toc3">3 ዮሐ.</para>
  <para style="mt">ሦስታለኘዪ የሐዋርያዪ የዮሐንስ መልክት</para>
  <para style="imt">ይቈርሽᎄ</para>
  <para style="ip">ሦስታለኘዪ የዮሐንስ መልክት የጣፈዪ በባሊቂ በሐዋርያ በዮሐንስ ቲኸን፥ የጣፈዪም ጋይዮስ የቧሪ የቤተ ክርስቲያን መሪ ባነ፤ ጠሐፊዪ ባት ኤማ ይንጐዲ ክርስቲያኖች በወርዳሑ</para>
  <para style="iot">እንመሑ የመጽሐፊ አሳብ</para>
  <para style="io1">ይቈርሽᎄ <char style="ior"><ref loc="3JN 1:1-4">1-4</ref> </char></para>
  <para style="io1">የጋይዮስ ወትመስገን <char style="ior"><ref loc="3JN 1:5-8">5-8</ref> </char></para>
  <para style="io1">የዲዮትሬፊስ ወትወቀስ <char style="ior"><ref loc="3JN 1:9-10">9-10</ref> </char></para>
  <para style="io1">የድሜጥሮስ ወትመስገን <char style="ior"><ref loc="3JN 1:11-12">11-12</ref> </char></para>
  <para style="io1">ያጥቋልልᎄ <char style="ior"><ref loc="3JN 1:13-15">13-15</ref> </char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />በኢን ኧወጅጂ፥ የትወደደዪ ጋይዮስ፥</para>
  <para style="p" vid="3JN 1:1">ቲያ ተባሊኢ የትላኸ መልክት፦<note caller="-" style="x"><char style="xo" closed="false">1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ሐዋ. 19፥29</ref>፤ <ref loc="ROM 16:23">ሮም 16፥23</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1፥14</ref>። </char></note><verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ደቦኛ፤ ነብስያኸ በፈያ ሐለት ᎈር ያነኸም እንም ፈያ ጤንነት ይነብርኸኸም በዘንጋ እንም ይሳካንከኸም ኧጤልይ። <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />የኢን ታማኝ የኸነኸም ትዥባበርወዪም በኢን የኸነኸም አታት ጐባቢት ቸኖም ስላኸ ቲምሰክሮኒ ስርም ተብላለቅኩም። <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />ዴጋኛ በኢን ይዥባበሮ ወሕነሕኖ ተወስማ ይበዛ ብልቃት ኤነ።<verse eid="3JN 1:4" /></para>
  <para style="s1">ጋይዮስ የትምሰገነኸም</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ደቦኛ፤ ያኸ ባዘናዎች ቢኸኖም በጔታ ጐባቢት ብትሸኩች ቃር እንም ታማኝንከ። <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />ሕኖ ያኸ ያነናኸ ፍቅር በቤተ ክርስቲያን ኢፍት ምሰከሮም፤ ቤማሕኖም የእዝጌር ያትብላልቅ ሐለት ብትረዳኖ ፈያ ትሸክት፤ <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />መሳሑም ስለክርስቶስ ሽም የዋገልግል ቲወጦ ተአሕዛብ አትም ቴይቄበሮው። <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />በይሽ ቁናዬ የኢን ኧሸክትነኸም እኪ የኸኖዪ ሰቦች አስተናግድነዬ ግድ ይብርነ።<verse eid="3JN 1:8" /></para>
  <para style="s1">የዲዮትሬፊስ ወትወቀስም የድሜጥሮስ ወትመስገን</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />የቤተ ክርስቲያን ደብዳቤ ጣፍኩም ባነ፤ ቢኸንም የቤተ ክርስቲያን መሪ ወሕን ይሸዪ ዲዮጥራጢስ ኤይቌበርነ። <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />ስለኸነ እያ በቸኘሑ ሑቲ በቡሼ ቃላት ሽመናም የዋጥፋ ይሸኩቺ እንም ይፋ አወጣ፤ ዚም ኤያሰላ ባሮም በጔታ ጐባቢት የኸኖዪ ኤይቌበር፤ ኤይቌበሮዮኸም ይሸዎዪ ይኸትሮ፤ ተቤተ ክርስቲያንም ያትዌጣኖ።<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />ደቦኛ፤ ፈያ የኸነዪ አንኸንም ቡሼዪ አትምስር። ፈያ የኸነዪም ይሸክት እንም ተእዝጌሩ። ቡሼ ሜና ይሸክት እንም የእዝጌር አነዠን።<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />የድሜጥሮስ፤ ሰብ እንም ፈይነተሑ ይምሰኩርነ፤ የኢን ነብሰሑ ይምሰኩርነ፤ ኢና ኧሗም ኧምሰክርነነ፤ አሑም ምስክርነተናም ሐቅ የኸነኸም ቲሒሮ።<verse eid="3JN 1:12" /></para>
  <para style="s1">የመጨረሻዪ ሰላምታ</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />ኧጠፍንኩ ብዠ ቃር ባኔ፤ የሕን አንከንም ብስኪቢርቶ በቀለምም ኧጠፍንከዬ አንሸ፤ <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />በቁርቤ አዥከዬ ተስፋ ኧሸክት፤ ኢፍት ሊፍት ኧዝናጊነ።<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />ሰላም ያኸ የሕን፤</para>
  <para style="p" vid="3JN 1:15">ደቦዎች ሰላምታ ያቀርቦንከ። የደቦዎቸና በሽም ሽመሕኖ ሰላምታ አቅርብኒ።<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>