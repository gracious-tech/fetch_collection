<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CH" style="id">RRK13.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">1 OBUSINGYE</para>
  <para style="toc1">Ekitabo Ky'Eby'omu Busingye Bw'abagabe Eky'okubanza</para>
  <para style="toc2">1 Eby'omu Busingye</para>
  <para style="toc3">1 Bus</para>
  <para style="mt2">EKITABO</para>
  <para style="mt1">KY'EBY'OMU BUSINGYE BW'ABAGABE</para>
  <para style="mt2">EKY'OKUBANZA</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">Baishenkuru b'enganda zoona okwiha ahari Adamu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 4:25">Kut 4:25</ref>, <ref loc="GEN 4:26">26</ref>; <ref loc="GEN 5:3">5:3</ref>, <ref loc="GEN 5:6">6</ref>. </char>
    </note> Adamu, Seezi, Enosi, <verse eid="1CH 1:1" /><verse number="2" style="v" sid="1CH 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2-4: </char><char style="xt" closed="false"><ref loc="GEN 5:9-32">Kut 5:9-32</ref>. </char></note> Kenani, Mahalaleeli, Yaredi, <verse eid="1CH 1:2" /><verse number="3" style="v" sid="1CH 1:3" />Enoka, Mesuseela, Lameka, <verse eid="1CH 1:3" /><verse number="4" style="v" sid="1CH 1:4" /><note caller="-" style="x"><char style="xo" closed="false">1:4: </char><char style="xt" closed="false"><ref loc="GEN 9:18">Kut 9:18</ref>. </char></note> Noa, Sheemu, Haamu, Yafeesi. <verse eid="1CH 1:4" /><verse number="5" style="v" sid="1CH 1:5" /><note caller="-" style="x"><char style="xo" closed="false">1:5-7: </char><char style="xt" closed="false"><ref loc="GEN 10:2-4">Kut 10:2-4</ref>. </char></note> Batabani ba Yafeesi: Gomeri, Magogi, Madai, Yavani, Tubali, Mesheki na Tiraasi. <verse eid="1CH 1:5" /><verse number="6" style="v" sid="1CH 1:6" />Batabani ba Gomeri: Ashikenaazi, Difaasi, Toguruma. <verse eid="1CH 1:6" /><verse number="7" style="v" sid="1CH 1:7" />Batabani ba Yavani: Elisha, Tarushiishi, Kitimu na Rodanimu.<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8-10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 10:6-8">Kut 10:6-8</ref>. </char>
    </note> Batabani ba Haamu: Kuushi, Misri, Puuti na Kanaani. <verse eid="1CH 1:8" /><verse number="9" style="v" sid="1CH 1:9" />Batabani ba Kuushi: Seeba, Havila, Sabuta, Raama, na Sabuteeka. Batabani ba Raama: Sheeba na Dedani. <verse eid="1CH 1:9" /><verse number="10" style="v" sid="1CH 1:10" />Kuushi yaazaara Nimuroodi; yaaba niwe yaabandize kuba ow'amaani rugambwa omu nsi.<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11-16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 10:13-18">Kut 10:13-18</ref>. </char>
    </note> Misri yaazaara Ludimu, Anamimu, Lehabimu, Nafutuhimu, <verse eid="1CH 1:11" /><verse number="12" style="v" sid="1CH 1:12" />Patirusimu, Kasiluhimu, ou Abafilistia baakomookireho, na Kafutorimu.<verse eid="1CH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 1:13" />Kanaani yaajigaija Sidoni, bwanyima yaazaara Heesi, <verse eid="1CH 1:13" /><verse number="14" style="v" sid="1CH 1:14" />kandi yaakomookwamu Abayebusi, Abaamori Abagirugashi, <verse eid="1CH 1:14" /><verse number="15" style="v" sid="1CH 1:15" />Abahiivi, Abaaruki, Abasiini, <verse eid="1CH 1:15" /><verse number="16" style="v" sid="1CH 1:16" />Abaarivadi, Abazemari, n'Abahamasi.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 1:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:17-23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 10:22-29">Kut 10:22-29</ref>. </char>
    </note> Batabani ba Sheemu: Elamu, Ashuri, Arufakisaadi, Luudi, Aramu, Uuzi, Huuli, Geseri, na Mesheki. <verse eid="1CH 1:17" /><verse number="18" style="v" sid="1CH 1:18" />Arufakisaadi yaazaara Sheela, Sheela yaazaara Eberi. <verse eid="1CH 1:18" /><verse number="19" style="v" sid="1CH 1:19" />Eberi yaazaara aboojo babiri, omwe akaba naayetwa Pelegi, ahabw'okuba omu biro bye ensi nibwo yaabaganisibwa, kandi eiziina ry'omurumuna akaba ari Yokitaani. <verse eid="1CH 1:19" /><verse number="20" style="v" sid="1CH 1:20" />Yokitaani yaazaara Alimodaadi, Shelefu, Hazarimaveesi, Yeera, <verse eid="1CH 1:20" /><verse number="21" style="v" sid="1CH 1:21" />Hadoramu, Uzali, Dikila, <verse eid="1CH 1:21" /><verse number="22" style="v" sid="1CH 1:22" />Ebali, Abimaeli, Sheeba, <verse eid="1CH 1:22" /><verse number="23" style="v" sid="1CH 1:23" />Ofiri, Havila na Yobabu; abo boona bakaba bari batabani ba Yokitaani.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 1:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:24-27: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 11:10-26">Kut 11:10-26</ref>. </char>
    </note> Sheemu, Arufakisaadi, Sheela,<note caller="-" style="x"><char style="xo" closed="false">1:24: </char><char style="xt" closed="false"><ref loc="LUK 3:34-36">Luk 3:34-36</ref>. </char></note> <verse eid="1CH 1:24" /><verse number="25" style="v" sid="1CH 1:25" />Eberi, Pelegi, Reu, <verse eid="1CH 1:25" /><verse number="26" style="v" sid="1CH 1:26" />Serugi, Nahori, Teera, <verse eid="1CH 1:26" /><verse number="27" style="v" sid="1CH 1:27" />Abraamu niwe Abrahamu.<verse eid="1CH 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 1:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:28: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 16:11">Kut 16:11</ref>, <ref loc="GEN 16:15">15</ref>; <ref loc="GEN 21:2">21:2</ref>, <ref loc="GEN 21:3">3</ref>. </char>
    </note> Batabani ba Abrahamu: Isaaka na Ishimaeli. <verse eid="1CH 1:28" /><verse number="29" style="v" sid="1CH 1:29" /><note caller="-" style="x"><char style="xo" closed="false">1:29-31: </char><char style="xt" closed="false"><ref loc="GEN 25:13-16">Kut 25:13-16</ref>. </char></note> Oru nirwo ruzaaro rwabo; omujigaijo gwa Ishimaeli, Nebayoosi, yaakuratwa Kedari, Adubeeli, Mibusaamu, <verse eid="1CH 1:29" /><verse number="30" style="v" sid="1CH 1:30" />Mishuma, Duuma, Maasa, Hadadi, Teema, <verse eid="1CH 1:30" /><verse number="31" style="v" sid="1CH 1:31" />Yeturi, Nafishi, na Kedema. Abo nibo batabani ba Ishimaeli. <verse eid="1CH 1:31" /><verse number="32" style="v" sid="1CH 1:32" /><note caller="-" style="x"><char style="xo" closed="false">1:32, 33: </char><char style="xt" closed="false"><ref loc="GEN 25:1-4">Kut 25:1-4</ref>. </char></note> Batabani ba Ketura, ekinyashunju kya Abrahamu, akazaara Zimuraani, Yokishaani, Medani, Midiani, Ishibaaki na Shua. Batabani ba Yokishaani, Sheeba na Dedani. <verse eid="1CH 1:32" /><verse number="33" style="v" sid="1CH 1:33" />Batabani ba Midiani: Eefa, Eferi, Hanoki, Abida, na Eludaya, abo boona bakaba bari batabani ba Ketura.<verse eid="1CH 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 1:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:34: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 25:25">Kut 25:25</ref>, <ref loc="GEN 25:26">26</ref>; <ref loc="GEN 32:28">32:28</ref>. </char>
    </note> Abrahamu yaazaara Isaaka. Batabani ba Isaaka: Esau na Israeli. <verse eid="1CH 1:34" /><verse number="35" style="v" sid="1CH 1:35" /><note caller="-" style="x"><char style="xo" closed="false">1:35-37: </char><char style="xt" closed="false"><ref loc="GEN 36:4">Kut 36:4</ref>, <ref loc="GEN 36:5">5</ref>, <ref loc="GEN 36:9-13">9-13</ref>. </char></note> Batabani ba Esau: Elifaazi, Reueli, Yerushi, Yalamu na Koora. <verse eid="1CH 1:35" /><verse number="36" style="v" sid="1CH 1:36" />Batabani ba Elifaazi: Temani, Omari, Zeefi, Gatamu, Kenazi, Timuna, na Amaleki. <verse eid="1CH 1:36" /><verse number="37" style="v" sid="1CH 1:37" />Batabani ba Reueli: Nahasi, Zeera, Shama na Miiza.<verse eid="1CH 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 1:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:38-42: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 36:20-28">Kut 36:20-28</ref>. </char>
    </note> Batabani ba Seiri: Lotani, Shobali, Zibeoni, Aana, Dishoni, Ezeeri na Dishani. <verse eid="1CH 1:38" /><verse number="39" style="v" sid="1CH 1:39" />Batabani ba Lotani: Hoori, na Homamu; munyaanya wa Lotani akaba ari Timuna. <verse eid="1CH 1:39" /><verse number="40" style="v" sid="1CH 1:40" />Batabani ba Shobali: Alivani, Manahaasi, Ebali, Sheefi na Onamu. Batabani ba Zibeoni: Aaya na Aana. <verse eid="1CH 1:40" /><verse number="41" style="v" sid="1CH 1:41" />Mutabani wa Aana: Dishoni. Batabani ba Dishoni: Hamuraani, Eshibaani, Isuraani, na Keraani. <verse eid="1CH 1:41" /><verse number="42" style="v" sid="1CH 1:42" />Batabani ba Ezeeri: Biluhaani, Zaavani, na Yakani. Batabani ba Dishoni: Uuzi na Arani. <verse eid="1CH 1:42" /><verse number="43" style="v" sid="1CH 1:43" /><note caller="-" style="x"><char style="xo" closed="false">1:43-54: </char><char style="xt" closed="false"><ref loc="GEN 36:31-43">Kut 36:31-43</ref>. </char></note> Aba nibo bagabe abaategyekire ensi ya Edomu, hatakabaireho mugabe weena ow'okutegyeka Abaisraeli: Beela mwene Beori, ou orurembo rwe rwabaire nirwetwa Dinihaba. <verse eid="1CH 1:43" /><verse number="44" style="v" sid="1CH 1:44" /><note caller="-" style="x"><char style="xo" closed="false">1:44: </char><char style="xt" closed="false"><ref loc="ISA 34:6">Isa 34:6</ref>; <ref loc="ISA 63:1">63:1</ref>; <ref loc="JER 49:13">Yer 49:13</ref>, <ref loc="JER 49:22">22</ref>. </char></note> Beela ku yaafiire, Yobabu mwene Zeera owa Bozira yaategyeka omu mwanya gwe. <verse eid="1CH 1:44" /><verse number="45" style="v" sid="1CH 1:45" /><note caller="-" style="x"><char style="xo" closed="false">1:45: </char><char style="xt" closed="false"><ref loc="JOB 2:11">Yob 2:11</ref>; <ref loc="JER 49:7">Yer 49:7</ref>, <ref loc="JER 49:20">20</ref>; <ref loc="EZK 25:13">Ezk 25:13</ref>; <ref loc="OBA 1:9">Oba 9</ref>. </char></note> Yobabu ku yaafiire, Hushamu ow'omu nsi y'Abatemaani yaategyeka omu mwanya gwe. <verse eid="1CH 1:45" /><verse number="46" style="v" sid="1CH 1:46" />Hushamu ku yaafiire, Hadadi mwene Bedadi owaasingwire Abamidiani omu nsi ya Moabu yaategyeka omu mwanya gwe; eiziina ry'orurembo rwe rukaba nirwetwa Aviisi. <verse eid="1CH 1:46" /><verse number="47" style="v" sid="1CH 1:47" />Hadadi ku yaafiire, Samula owa Masireka yaategyeka omu mwanya gwe. <verse eid="1CH 1:47" /><verse number="48" style="v" sid="1CH 1:48" />Samula ku yaafiire, Shauli owa Rehoboosi ey'aha mugyera Furaati yaategyeka omu mwanya gwe. <verse eid="1CH 1:48" /><verse number="49" style="v" sid="1CH 1:49" />Shauli ku yaafiire, Baali-hanani mwene Akiboori yaategyeka omu mwanya gwe. <verse eid="1CH 1:49" /><verse number="50" style="v" sid="1CH 1:50" />Baali-hanani ku yaafiire, Hadadi yaategyeka omu mwanya gwe; n'eiziina ry'orurembo rwe rukaba nirwetwa Pai, kandi omukazi we akaba naayetwa Mehetabeeli muhara wa Matireedi, omwijukuru wa Mezahaabu. <verse eid="1CH 1:50" /><verse number="51" style="v" sid="1CH 1:51" />Bwanyima Hadadi yaafa.</para>
  <para style="p" vid="1CH 1:51">Abaami ba Edomu bakaba bari aba: Omwami Timuna, Aliva, Yeseti, <verse eid="1CH 1:51" /><verse number="52" style="v" sid="1CH 1:52" />Oholibama, Eela, Pinoni, <verse eid="1CH 1:52" /><verse number="53" style="v" sid="1CH 1:53" />Kenazi, Temani, Mibuzaari, <verse eid="1CH 1:53" /><verse number="54" style="v" sid="1CH 1:54" />Magudieli na Iraamu; abo nibo baabaire bari abaami ba Edomu.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 29:32-30:24">Kut 29:32—30:24</ref>. </char>
    </note> Aba nibo batabani ba Israeli: Reubeeni, Simeoni, Leevi, Yuda, Isakaari, Zebuluuni, <verse eid="1CH 2:1" /><verse number="2" style="v" sid="1CH 2:2" /><note caller="-" style="x"><char style="xo" closed="false">2:2: </char><char style="xt" closed="false"><ref loc="GEN 35:18">Kut 35:18</ref>. </char></note> Daani, Yosefu, Benyamiini, Nafutaali, Gaadi na Asheri. <verse eid="1CH 2:2" /><verse number="3" style="v" sid="1CH 2:3" /><note caller="-" style="x"><char style="xo" closed="false">2:3: </char><char style="xt" closed="false"><ref loc="GEN 38:2-5">Kut 38:2-5</ref>, <ref loc="GEN 38:7">7</ref>; <ref loc="GEN 46:12">46:12</ref>. </char></note> Batabani ba Yuda: Eeri, Onani, na Sheela; abo bonshatu nibo Batishua Omunyakanaanikazi yaamuzaariire. Kwonka Eeri omujigaijo gwa Yuda akaba ari mubi omu maisho ga MUKAMA, yaamwita. <verse eid="1CH 2:3" /><verse number="4" style="v" sid="1CH 2:4" /><note caller="-" style="x"><char style="xo" closed="false">2:4: </char><char style="xt" closed="false"><ref loc="GEN 38:11">Kut 38:11</ref>, <ref loc="GEN 38:14">14</ref>, <ref loc="GEN 38:29">29</ref>, <ref loc="GEN 38:30">30</ref>; <ref loc="RUT 4:12">Rus 4:12</ref>; <ref loc="MAT 1:3">Mat 1:3</ref>. </char></note> Kandi mukaamwana Tamari nawe yaamuzaarira Pereezi na Zeera. Yuda akaba aine abatabani bataano.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:12">Kut 46:12</ref>. </char>
    </note> Batabani ba Pereezi: Hezirooni na Hamuli. <verse eid="1CH 2:5" /><verse number="6" style="v" sid="1CH 2:6" />Batabani ba Zeera: Zimuri, Esaani, Hemani, Kalukooli na Daara, boona bataano. <verse eid="1CH 2:6" /><verse number="7" style="v" sid="1CH 2:7" /><note caller="-" style="x"><char style="xo" closed="false">2:7: </char><char style="xt" closed="false"><ref loc="JOS 6:18">Yos 6:18</ref>; <ref loc="JOS 7:1">7:1</ref>. </char></note> Mutabani wa Karumi: Akani owaitsire kubi Abaisraeli akacumura omu byabiikiirwe MUKAMA; <verse eid="1CH 2:7" /><verse number="8" style="v" sid="1CH 2:8" />kandi mwene Esaani akaba ari Azaria.<verse eid="1CH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="RUT 4:19">Rus 4:19</ref>; <ref loc="1CH 2:42">1 Bus 2:42</ref>; <ref loc="MAT 1:3">Mat 1:3</ref>, <ref loc="MAT 1:4">4</ref>. </char>
    </note> Batabani ba Hezirooni abaamuzaariirwe: Yerameeli, Raamu na Kelubai. <verse eid="1CH 2:9" /><verse number="10" style="v" sid="1CH 2:10" /><note caller="-" style="x"><char style="xo" closed="false">2:10: </char><char style="xt" closed="false"><ref loc="NUM 1:7">Kub 1:7</ref>; <ref loc="NUM 2:3">2:3</ref>; <ref loc="RUT 4:19">Rus 4:19</ref>; <ref loc="MAT 1:4">Mat 1:4</ref>. </char></note> Raamu yaazaara Aminadabu, Aminadabu yaazaara Nahashooni, omukuru omuri beene Yuda. <verse eid="1CH 2:10" /><verse number="11" style="v" sid="1CH 2:11" /><note caller="-" style="x"><char style="xo" closed="false">2:11: </char><char style="xt" closed="false"><ref loc="RUT 4:20">Rus 4:20</ref>, <ref loc="RUT 4:21">21</ref>, <ref loc="RUT 4:22">22</ref>; <ref loc="MAT 1:4">Mat 1:4</ref>, <ref loc="MAT 1:5">5</ref>, <ref loc="MAT 1:6">6</ref>. </char></note> Nahashooni yaazaara Saluma, Saluma yaazaara Boazi, <verse eid="1CH 2:11" /><verse number="12" style="v" sid="1CH 2:12" />Boazi yaazaara Obedi, Obedi yaazaara Yese, <verse eid="1CH 2:12" /><verse number="13" style="v" sid="1CH 2:13" /><note caller="-" style="x"><char style="xo" closed="false">2:13: </char><char style="xt" closed="false"><ref loc="1SA 16:6">1 Sam 16:6</ref>, <ref loc="1SA 16:8">8</ref>, <ref loc="1SA 16:9">9</ref>; <ref loc="1SA 17:13">17:13</ref>. </char></note> Yese yaajigaija Eliabu, yaakuratwa Abinadabu, omwana we owa kashatu yaaba Shimea, <verse eid="1CH 2:13" /><verse number="14" style="v" sid="1CH 2:14" />owa kana Netaneeli, owa kataano Radai, <verse eid="1CH 2:14" /><verse number="15" style="v" sid="1CH 2:15" /><note caller="-" style="x"><char style="xo" closed="false">2:15: </char><char style="xt" closed="false"><ref loc="1SA 16:10">1 Sam 16:10</ref>; <ref loc="1SA 17:12">17:12</ref>, <ref loc="1SA 17:14">14</ref>. </char></note> owa mukaaga Ozeemu, owa mushanju Daudi; <verse eid="1CH 2:15" /><verse number="16" style="v" sid="1CH 2:16" /><note caller="-" style="x"><char style="xo" closed="false">2:16: </char><char style="xt" closed="false"><ref loc="2SA 2:18">2 Sam 2:18</ref>. </char></note> banyaanya baabo ni Zeruiya na Abigaili. Batabani ba Zeruiya: Abishai, Yoabu, na Asaheeli, bashatu. <verse eid="1CH 2:16" /><verse number="17" style="v" sid="1CH 2:17" /><note caller="-" style="x"><char style="xo" closed="false">2:17: </char><char style="xt" closed="false"><ref loc="2SA 17:25">2 Sam 17:25</ref>. </char></note> Abigaili yaazaara Amasa, kandi ishe wa Amasa akaba ari Yeseri Omuishimaeli. <verse eid="1CH 2:17" /><verse number="18" style="v" sid="1CH 2:18" /><note caller="-" style="x"><char style="xo" closed="false">2:18: </char><char style="xt" closed="false"><ref loc="1CH 2:9">1 Bus 2:9</ref>. </char></note> Kalebu mwene Hezirooni akazaara abaana aha mukazi we Azuuba n'ahari Yeriosi; kandi abaana be nibo aba: Yesheri, Shobabu na Aridooni. <verse eid="1CH 2:18" /><verse number="19" style="v" sid="1CH 2:19" /><note caller="-" style="x"><char style="xo" closed="false">2:19: </char><char style="xt" closed="false"><ref loc="EXO 17:10">Kur 17:10</ref>, <ref loc="EXO 17:12">12</ref>; <ref loc="EXO 24:14">24:14</ref>; <ref loc="1CH 2:50">1 Bus 2:50</ref>. </char></note> Azuuba ku yaafiire, Kalebu yaashwera Efuraata owaamuzaariire Huuri. <verse eid="1CH 2:19" /><verse number="20" style="v" sid="1CH 2:20" /><note caller="-" style="x"><char style="xo" closed="false">2:20: </char><char style="xt" closed="false"><ref loc="EXO 31:2">Kur 31:2</ref>; <ref loc="NUM 27:1">Kub 27:1</ref>. </char></note> Huuri yaazaara Uuri, na Uuri yaazaara Bezaleeli.<verse eid="1CH 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 2:21" />Bwanyima Hezirooni, ku yaahikize emyaka makumi mukaaga, yaataasya muhara wa Makiri ishe wa Gileadi, yaaba omukazi we; yaamuzaarira Seegebu. <verse eid="1CH 2:21" /><verse number="22" style="v" sid="1CH 2:22" />Seegebu yaazaara Yairi, owaabaire naategyeka endembo makumi abiri na ishatu omu nsi ya Gileadi. <verse eid="1CH 2:22" /><verse number="23" style="v" sid="1CH 2:23" /><note caller="-" style="x"><char style="xo" closed="false">2:23: </char><char style="xt" closed="false"><ref loc="NUM 32:41">Kub 32:41</ref>, <ref loc="NUM 32:42">42</ref>. </char></note> Kwonka Geshuri na Aramu yaanyagaho Havoosi-yairi, na Kenasi n'ebirorero byayo, tauni zoona makumi mukaaga. Abo boona bakaba bari baijukuru ba Makiri ishe wa Gileadi. <verse eid="1CH 2:23" /><verse number="24" style="v" sid="1CH 2:24" /><note caller="-" style="x"><char style="xo" closed="false">2:24: </char><char style="xt" closed="false"><ref loc="1CH 4:5">1 Bus 4:5</ref>. </char></note> Hezirooni ku yaafiire, Kalebu yaabyama na Efuraata muka Hezirooni ishe, yaamuzaarira Ashihuuri, ishe wa Tekoa.<verse eid="1CH 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 2:25" />Batabani ba Yerameeli omujigaijo gwa Hezirooni: Raamu omujigaijo gwe, Buna, Oreni, Ozemi na Ahiya. <verse eid="1CH 2:25" /><verse number="26" style="v" sid="1CH 2:26" />Yerameeli akaba aine ondiijo mukazi orikwetwa Atara owaabaire ari nyina wa Onamu. <verse eid="1CH 2:26" /><verse number="27" style="v" sid="1CH 2:27" />Batabani ba Raamu omujigaijo gwa Yerameeli: Maazi, Yamini na Ekeri. <verse eid="1CH 2:27" /><verse number="28" style="v" sid="1CH 2:28" />Batabani ba Onamu: Shamai: Nadabu na Abishuri. <verse eid="1CH 2:28" /><verse number="29" style="v" sid="1CH 2:29" />Muka Abishuri akaba naayetwa Abihaili; yaamuzaarira Ahibaani na Molidi. <verse eid="1CH 2:29" /><verse number="30" style="v" sid="1CH 2:30" />Batabani ba Nadabu: Seleedi na Apayimu: Seleedi ogwo yaafa bucwekye. <verse eid="1CH 2:30" /><verse number="31" style="v" sid="1CH 2:31" />Mutabani wa Apayimu: Iishi. Mutabani wa Iishi: Sheshani. Mutabani wa Sheshani: Ahilai. <verse eid="1CH 2:31" /><verse number="32" style="v" sid="1CH 2:32" />Batabani ba Yaada murumuna wa Shamai: Yeseri na Yonasaani. Yeseri ogwo yaafa bucwekye. <verse eid="1CH 2:32" /><verse number="33" style="v" sid="1CH 2:33" />Batabani ba Yonasaani: Pelesi na Zaaza. Abo nibo baijukuru ba Yerameeli. <verse eid="1CH 2:33" /><verse number="34" style="v" sid="1CH 2:34" />Kandi Sheshani akaba atazaire boojo kureka abaishiki bonka; kwonka Sheshani akaba aine omuhuuku Omunyamisri owaabaire naayetwa Yaruha. <verse eid="1CH 2:34" /><verse number="35" style="v" sid="1CH 2:35" />Atyo Sheshani yaahingira muhara we ogwo muhuuku we Yaruha, yaamuzaarira Atai. <verse eid="1CH 2:35" /><verse number="36" style="v" sid="1CH 2:36" />Atai ogwo yaazaara Nasani, Nasani yaazaara Zabadi. <verse eid="1CH 2:36" /><verse number="37" style="v" sid="1CH 2:37" /><note caller="-" style="x"><char style="xo" closed="false">2:37: </char><char style="xt" closed="false"><ref loc="1CH 11:41">1 Bus 11:41</ref>. </char></note> Zabadi yaazaara Efulaali, Efulaali yaazaara Obedi, <verse eid="1CH 2:37" /><verse number="38" style="v" sid="1CH 2:38" />Obedi yaazaara Yehu, Yehu yaazaara Azaria. <verse eid="1CH 2:38" /><verse number="39" style="v" sid="1CH 2:39" />Azaria yaazaara Helezi, Helezi yaazaara Eleasa. <verse eid="1CH 2:39" /><verse number="40" style="v" sid="1CH 2:40" />Eleasa yaazaara Sisumai, Sisumai yaazaara Shalumu; <verse eid="1CH 2:40" /><verse number="41" style="v" sid="1CH 2:41" />Shalumu yaazaara Yekamia, na Yekamia yaazaara Elishaama.<verse eid="1CH 2:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CH 2:42" />Batabani ba Kalebu murumuna wa Yerameeli: Mareesha omujigaijo gwe owaazaire Ziifu. Mutabani wa Mareesha: Heburooni. <verse eid="1CH 2:42" /><verse number="43" style="v" sid="1CH 2:43" />Batabani ba Heburooni: Koora, Tapua, Rekemu na Sheema. <verse eid="1CH 2:43" /><verse number="44" style="v" sid="1CH 2:44" />Sheema yaazaara Rahamu, ishe wa Yorikeamu; kandi Rekemu yaazaara Shamai. <verse eid="1CH 2:44" /><verse number="45" style="v" sid="1CH 2:45" />Mutabani wa Shamai: Maoni; kandi Maoni yaazaara Besizuuri. <verse eid="1CH 2:45" /><verse number="46" style="v" sid="1CH 2:46" />Eefa ekinyanshunju kya Kalebu nawe yaazaara Harani, Mooza na Gazezi; kandi Harani yaazaara Gazezi. <verse eid="1CH 2:46" /><verse number="47" style="v" sid="1CH 2:47" />Batabani ba Yahidai: Regemu, Yosamu, Geshani, Peleti, Eefa, na Shaafi. <verse eid="1CH 2:47" /><verse number="48" style="v" sid="1CH 2:48" />Maaka ekinyanshunju kya Kalebu yaazaara Sheberi na Tiruhaana. <verse eid="1CH 2:48" /><verse number="49" style="v" sid="1CH 2:49" /><note caller="-" style="x"><char style="xo" closed="false">2:49: </char><char style="xt" closed="false"><ref loc="JOS 15:17">Yos 15:17</ref>; <ref loc="JDG 1:13">Bar 1:13</ref>. </char></note> Kandi yaazaara Shaafi ishe wa Madumaana, Sheeva ishe wa Makibeena na ishe wa Gibea; kandi muhara wa Kalebu akaba ari Akisha. <verse eid="1CH 2:49" /><verse number="50" style="v" sid="1CH 2:50" /><note caller="-" style="x"><char style="xo" closed="false">2:50: </char><char style="xt" closed="false"><ref loc="1CH 2:19">1 Bus 2:19</ref>; <ref loc="1CH 4:4">4:4</ref>. </char></note> Abo nibo baijukuru ba Kalebu.</para>
  <para style="p" vid="1CH 2:50">Batabani ba Huuri omujigaijo gwa Efuraata: Shobaali ishe wa Kiryasi-yearimu, <verse eid="1CH 2:50" /><verse number="51" style="v" sid="1CH 2:51" />Saluma ishe wa Betelehemu, na Harefu ishe wa Besigadeeri. <verse eid="1CH 2:51" /><verse number="52" style="v" sid="1CH 2:52" />Shobaali ishe wa Kiryasi-yearimu akazaara abandi baana b'aboojo, Harowe, ekicweka ky'Abamenuhosi. <verse eid="1CH 2:52" /><verse number="53" style="v" sid="1CH 2:53" /><note caller="-" style="x"><char style="xo" closed="false">2:53: </char><char style="xt" closed="false"><ref loc="1CH 4:2">1 Bus 4:2</ref>. </char></note> Emiryango ya Kiryasi-yearimu; aba Isuri, aba Puuti, aba Shumaasi, n'aba Mishura; omuri abo hakakomookamu aba Zoraasi, n'aba Eshitaoli. <verse eid="1CH 2:53" /><verse number="54" style="v" sid="1CH 2:54" />Batabani ba Saluma: Betelehemu, aba Netoofaasi, Atiroosi-besiyoabu, n'ekicweka ky'aba Manahaasi abarikwetwa aba zoori. <verse eid="1CH 2:54" /><verse number="55" style="v" sid="1CH 2:55" /><note caller="-" style="x"><char style="xo" closed="false">2:55: </char><char style="xt" closed="false"><ref loc="JDG 1:6">Bar 1:6</ref>; <ref loc="2KI 10:15">2 Bag 10:15</ref>; <ref loc="JER 35:2">Yer 35:2</ref>. </char></note> Kandi emirayngo y'abahandiiki abaabaire batwire Yabezi: aba Tiraasi, aba Shimeasi n'aba Sukaasi. Abo nibo ba Keeni, abaakomookire ahari Hamasi, ishenkuru w'enju ya Rekabu.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1-4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 3:2-5">2 Sam 3:2-5</ref>. </char>
    </note> Aba nibo batabani ba Daudi abaamuzaariirwe ari Heburooni: omujigaijo gwe akaba ari Amunoni, ou yaazaire ahari Ahinoamu owa Yezereeli; owa kabiri ni Danieli ou yaazaire ahari Abigaili owa Karumeeli, <verse eid="1CH 3:1" /><verse number="2" style="v" sid="1CH 3:2" />owa kashatu ni Abusalomu, owaazairwe Maaka, muhara wa Talumai omugabe wa Geshuri: owa kana ni Adoniya, owaazairwe Hagisi, <verse eid="1CH 3:2" /><verse number="3" style="v" sid="1CH 3:3" />owa kataano Shefatia owaazairwe Abitaali, owa mukaaga Itereamu owaazairwe omukazi we Egula; <verse eid="1CH 3:3" /><verse number="4" style="v" sid="1CH 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4: </char><char style="xt" closed="false"><ref loc="2SA 2:11">2 Sam 2:11</ref>; <ref loc="2SA 5:5">5:5</ref>. </char></note> abo mukaaga bakamuzaarirwa ari Heburooni, ahu yaategyekyeire emyaka mushanju n'ameezi mukaaga. Kandi yaamara endiijo myaka makumi ashatu n'eshatu, naategyekyera Yerusaalemu. <verse eid="1CH 3:4" /><verse number="5" style="v" sid="1CH 3:5" /><note caller="-" style="x"><char style="xo" closed="false">3:5-8: </char><char style="xt" closed="false"><ref loc="2SA 5:14-16">2 Sam 5:14-16</ref>; <ref loc="1CH 14:4-7">1 Bus 14:4-7</ref>. </char></note> Kandi aba nibo baamuzaariirwe ari Yerusaalemu: Shimea, Shobabu, Nasani, na Sulemaani, baana abu yaazaire ahari Batishua muhara wa Amieli;<note caller="-" style="x"><char style="xo" closed="false">3:5: </char><char style="xt" closed="false"><ref loc="2SA 11:3">2 Sam 11:3</ref>; <ref loc="2SA 12:24">12:24</ref>. </char></note> <verse eid="1CH 3:5" /><verse number="6" style="v" sid="1CH 3:6" />bwanyima yaazaara Ibuhaari, Elishaama, Elifeleti, <verse eid="1CH 3:6" /><verse number="7" style="v" sid="1CH 3:7" />Nooga, Nefegi, Yafia, <verse eid="1CH 3:7" /><verse number="8" style="v" sid="1CH 3:8" />Elishaama, Eliada na Elifeleti, boona mwenda. <verse eid="1CH 3:8" /><verse number="9" style="v" sid="1CH 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9: </char><char style="xt" closed="false"><ref loc="2SA 13:1">2 Sam 13:1</ref>. </char></note> Abo boona bakaba bari batabani ba Daudi, otabariiremu batabani b'ebinyanshunju bye; kandi munyaanya waabo akaba ari Tamari.<verse eid="1CH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 11:43">1 Bag 11:43</ref>; <ref loc="1KI 14:31">14:31</ref>; <ref loc="1KI 15:1">15:1</ref>, <ref loc="1KI 15:8">8</ref>, <ref loc="1KI 15:24">24</ref>. </char>
    </note> Baijukuru ba Sulemaani: Rehoboamu, owaazire Abiya, owaazaire Asa, owaazaire Yehoshafaati, <verse eid="1CH 3:10" /><verse number="11" style="v" sid="1CH 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3:11: </char><char style="xt" closed="false"><ref loc="2KI 8:16">2 Bag 8:16</ref>, <ref loc="2KI 8:24">24</ref>; <ref loc="2KI 11:2">11:2</ref>; <ref loc="2CH 21:17">2 Bus 21:17</ref>. </char></note> owaazaire Yehoraamu, owaazaire Ahazia, owaazaire Yoasi, <verse eid="1CH 3:11" /><verse number="12" style="v" sid="1CH 3:12" /><note caller="-" style="x"><char style="xo" closed="false">3:12: </char><char style="xt" closed="false"><ref loc="2KI 12:21">2 Bag 12:21</ref>; <ref loc="2KI 14:21">14:21</ref>; <ref loc="2KI 15:7">15:7</ref>. </char></note> owaazaire Amazia, owaazaire Uziya, owaazaire Yosamu, <verse eid="1CH 3:12" /><verse number="13" style="v" sid="1CH 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3:13: </char><char style="xt" closed="false"><ref loc="2KI 15:38">2 Bag 15:38</ref>; <ref loc="2KI 16:20">16:20</ref>; <ref loc="2KI 20:21">20:21</ref>. </char></note> owaazaire Ahazi, owaazaire Hezekia, owaazaire Manaase, <verse eid="1CH 3:13" /><verse number="14" style="v" sid="1CH 3:14" /><note caller="-" style="x"><char style="xo" closed="false">3:14: </char><char style="xt" closed="false"><ref loc="2KI 21:18">2 Bag 21:18</ref>, <ref loc="2KI 21:26">26</ref>. </char></note> owaazaire Amoni, owaazaire Yosia. <verse eid="1CH 3:14" /><verse number="15" style="v" sid="1CH 3:15" /><note caller="-" style="x"><char style="xo" closed="false">3:15: </char><char style="xt" closed="false"><ref loc="2KI 23:30">2 Bag 23:30</ref>, <ref loc="2KI 23:34">34</ref>; <ref loc="2KI 24:17">24:17</ref>. </char></note> Batabani ba Yosia: omujigaijo gwe Yohanaani, owa kabiri Yehoyakimu, owa kashatu Zedekia, owa kana Shalumu. <verse eid="1CH 3:15" /><verse number="16" style="v" sid="1CH 3:16" /><note caller="-" style="x"><char style="xo" closed="false">3:16: </char><char style="xt" closed="false"><ref loc="2KI 24:6">2 Bag 24:6</ref>, <ref loc="2KI 24:17">17</ref>; <ref loc="JER 22:24">Yer 22:24</ref>; <ref loc="MAT 1:11">Mat 1:11</ref>. </char></note> Baijukuru ba Yehoyakimu, mutabani we Yekonia, ishe wa Zedekia; <verse eid="1CH 3:16" /><verse number="17" style="v" sid="1CH 3:17" /><note caller="-" style="x"><char style="xo" closed="false">3:17: </char><char style="xt" closed="false"><ref loc="2KI 24:15">2 Bag 24:15</ref>; <ref loc="EZR 3:2">Ezr 3:2</ref>; <ref loc="EZR 5:2">5:2</ref>; <ref loc="HAG 2:2">Hag 2:2</ref>, <ref loc="HAG 2:3">3</ref>; <ref loc="MAT 1:12">Mat 1:12</ref>; <ref loc="LUK 3:27">Luk 3:27</ref>. </char></note> batabani ba Yekonia enkwatwa: Shealutieli, <verse eid="1CH 3:17" /><verse number="18" style="v" sid="1CH 3:18" />Malikiramu, Pedaaya, Shenazaari, Yekamia, Hoshama na Nedabia; <verse eid="1CH 3:18" /><verse number="19" style="v" sid="1CH 3:19" /><note caller="-" style="x"><char style="xo" closed="false">3:19: </char><char style="xt" closed="false"><ref loc="EZR 2:2">Ezr 2:2</ref>; <ref loc="HAG 1:1">Hag 1:1</ref>; <ref loc="ZEC 4:6">Zek 4:6</ref>. </char></note> batabani ba Pedaaya: Zerubabeeli na Shimei; batabani ba Zerubabeeli: Meshulaamu na Hanania, kandi Shelomiisi akaba ari munyaanya; <verse eid="1CH 3:19" /><verse number="20" style="v" sid="1CH 3:20" />na Hashuba, Oheli, Berekia, Hasadia, na Yushabu-hesedi, boona bataano. <verse eid="1CH 3:20" /><verse number="21" style="v" sid="1CH 3:21" />Batabani ba Hanania: Pelatia na Yeshaya, owaazaire Refaaya, owaazaire Arunani, owaazaire Obadia, owaazaire Shekania. <verse eid="1CH 3:21" /><verse number="22" style="v" sid="1CH 3:22" /><note caller="-" style="x"><char style="xo" closed="false">3:22: </char><char style="xt" closed="false"><ref loc="EZR 8:2">Ezr 8:2</ref>; <ref loc="NEH 3:29">Neh 3:29</ref>. </char></note> Mutabani wa Shekania: Shemaya. Batabani ba Shemaya, Hatushi, Igali, Baria, Nearia, na Shafati, boona mukaaga. <verse eid="1CH 3:22" /><verse number="23" style="v" sid="1CH 3:23" />Batabani ba Nearia: Elio-enai, Hizukia, na Azurikaamu, boona bashatu. <verse eid="1CH 3:23" /><verse number="24" style="v" sid="1CH 3:24" />Batabani ba Elio-enai: Hodavia, Eliashibu, Pelaaya, Akubu, Yohanaani, Delaya na Anani, mushanju.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 38:29">Kut 38:29</ref>; <ref loc="GEN 46:12">46:12</ref>; <ref loc="1CH 2:7">1 Bus 2:7</ref>. </char>
    </note> Batabani ba Yuda: Pereezi, Hezirooni, Karumi, Huuri na Shobali. <verse eid="1CH 4:1" /><verse number="2" style="v" sid="1CH 4:2" /><note caller="-" style="x"><char style="xo" closed="false">4:2: </char><char style="xt" closed="false"><ref loc="1CH 2:52">1 Bus 2:52</ref>, <ref loc="1CH 2:53">53</ref>. </char></note> Reaya mwene Shobali akaba ari ishe wa Yahasi, Yahasi yaazaara Ahumai na Lahadi. Abo nibo b'emiryango y'aba Zorasi. <verse eid="1CH 4:2" /><verse number="3" style="v" sid="1CH 4:3" />Aba nibo batabani ba Etamu: Yezereeli, Ishuma na Ibudashi, munyaanya waabo akaba naayetwa Hazalelipooni, <verse eid="1CH 4:3" /><verse number="4" style="v" sid="1CH 4:4" /><note caller="-" style="x"><char style="xo" closed="false">4:4: </char><char style="xt" closed="false"><ref loc="GEN 35:19">Kut 35:19</ref>; <ref loc="1CH 2:50">1 Bus 2:50</ref>, <ref loc="1CH 2:51">51</ref>. </char></note> Penueli yaazara Gedori, na Ezeeri yaazaara Husha. Abo nibo batabani ba Huuri omujigaijo gwa Efuraata ishe wa Betelehemu. <verse eid="1CH 4:4" /><verse number="5" style="v" sid="1CH 4:5" /><note caller="-" style="x"><char style="xo" closed="false">4:5: </char><char style="xt" closed="false"><ref loc="1CH 2:24">1 Bus 2:24</ref>. </char></note> Ashihuri, ishe wa Tekoa akaba aine abakazi babiri, Heela na Naara; <verse eid="1CH 4:5" /><verse number="6" style="v" sid="1CH 4:6" />Naara yaamuzaarira Ahuzamu, Heferi, Temeni na Hahashitari. Abo nibo batabani ba Naara. <verse eid="1CH 4:6" /><verse number="7" style="v" sid="1CH 4:7" />Batabani ba Heela: Zeresi, Izuhari, na Esinaani. <verse eid="1CH 4:7" /><verse number="8" style="v" sid="1CH 4:8" />Koozi yaazaara Anubu, Zobeba n'emiryango ya Ahariheli mwene Harumu. <verse eid="1CH 4:8" /><verse number="9" style="v" sid="1CH 4:9" />Yabezi akaba ari omuntu orikusiimwa okukira beene ishe; nyina yaamweta Yabezi, naagira ati: Ahabw'okuba nkamuzaarira omu busaasi. <verse eid="1CH 4:9" /><verse number="10" style="v" sid="1CH 4:10" />Yabezi yaashaba Ruhanga wa Israeli naagira ati: Nkaabaasibwa ki, ompa omugisha, oirizayo emyatano yangye, omukono gwawe guguma naanye, ondinda akabi kareka kuunyita. Ruhanga yaamuha eki yaashabire.<verse eid="1CH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 4:11" />Kelubu murumuna wa Shuuha yaazaara Mehiiri, nawe yaazaara Eshitoni. <verse eid="1CH 4:11" /><verse number="12" style="v" sid="1CH 4:12" />Eshitoni yaazaara Besiraafa, Pasea na Tehina, ishe wa Irunahashi. Abo n'abashaija ba reeka. <verse eid="1CH 4:12" /><verse number="13" style="v" sid="1CH 4:13" /><note caller="-" style="x"><char style="xo" closed="false">4:13: </char><char style="xt" closed="false"><ref loc="JOS 15:17">Yos 15:17</ref>; <ref loc="JDG 1:13">Bar 1:13</ref>; <ref loc="JDG 3:9">3:9</ref>, <ref loc="JDG 3:11">11</ref>. </char></note> Batabani ba Kenazi: Otinyeli na Seraaya; batabani ba Otinyeli: Hatasi na Meonosai. <verse eid="1CH 4:13" /><verse number="14" style="v" sid="1CH 4:14" /><note caller="-" style="x"><char style="xo" closed="false">4:14: </char><char style="xt" closed="false"><ref loc="NEH 11:35">Neh 11:35</ref>. </char></note> Meonosai yaazaara Ofura; na Seraaya yaazaara Yoabu, ishe w'aba Gerashi, bakaba nibeetwa eryo iziina ahabw'okuba abanyamyoga. <verse eid="1CH 4:14" /><verse number="15" style="v" sid="1CH 4:15" /><note caller="-" style="x"><char style="xo" closed="false">4:15: </char><char style="xt" closed="false"><ref loc="NUM 13:6">Kub 13:6</ref>. </char></note> Batabani ba Kalebu mwene Yefune: Iiru, Ela, na naamu; mutabani wa Ela ni Kenazi. <verse eid="1CH 4:15" /><verse number="16" style="v" sid="1CH 4:16" />Batabani ba Yehaleleli: Ziifu, Ziifa, Tiria na Asareeli. <verse eid="1CH 4:16" /><verse number="17" style="v" sid="1CH 4:17" />Batabani ba Ezira: Yeseri, Meredi, Eferi, na Yalooni. Abo nibo batabani wa Bisia muhara wa Faraho, ou Meredi yaashweire; yaagira enda, yaazaara Miriamu, Shamai na Ishuba ishe wa Eshitemoa. <verse eid="1CH 4:17" /><verse number="18" style="v" sid="1CH 4:18" />Kandi omukazi we Omuyudaayakazi yaazaara Yeredi ishe Gedori, Heberi ishe wa Sooko na Yekusieli ishe wa Zanoa. <verse eid="1CH 4:18" /><verse number="19" style="v" sid="1CH 4:19" />Batabani ba muka Hodia, munyaanya wa Nahamu, bakazaara Keila owa Garumi na Eshitemoa owa Maakasi. <verse eid="1CH 4:19" /><verse number="20" style="v" sid="1CH 4:20" />Batabani ba Shimoni: Amunoni, Riina, Benihanani na Tilooni. Batabani ba Iishi: Zohesi na Benizohesi. <verse eid="1CH 4:20" /><verse number="21" style="v" sid="1CH 4:21" /><note caller="-" style="x"><char style="xo" closed="false">4:21: </char><char style="xt" closed="false"><ref loc="1CH 2:3">1 Bus 2:3</ref>. </char></note> Batabani ba Sheela mwene Yuda: Eeri ishe wa Leeka, Laada ishe wa Mareesha n'ab'emiryango y'enju y'abarikuruka emyenda ya kitaani ahari Betashibea <verse eid="1CH 4:21" /><verse number="22" style="v" sid="1CH 4:22" />na Yokimu n'abashaija ba Kozeba, na Yoasi, na Sarafu owaabaire naategyeka Moabu, na Yashubilehemu. Ebyo bihandiiko n'ebya ira munonga. <verse eid="1CH 4:22" /><verse number="23" style="v" sid="1CH 4:23" />Abo nibo baabaire bari ababumbi, batwire Netaimu na Gedera; bo bakaba batuurayo n'omugabe nibamukorera.<verse eid="1CH 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 4:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:24: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 26:12">Kub 26:12</ref>. </char>
    </note> Batabani ba Simeoni: Nemueli, Yamini, Yaribu, Seera na Shauli; <verse eid="1CH 4:24" /><verse number="25" style="v" sid="1CH 4:25" />kandi Shalumu n'omutabani, na Mibusamu na Mishima. <verse eid="1CH 4:25" /><verse number="26" style="v" sid="1CH 4:26" />Batabani ba Mishima: omutabani Hamueli, mwene Hamueli ni Zakuri, mwene Zakuri ni Shimei. <verse eid="1CH 4:26" /><verse number="27" style="v" sid="1CH 4:27" /><note caller="-" style="x"><char style="xo" closed="false">4:27: </char><char style="xt" closed="false"><ref loc="NUM 2:4">Kub 2:4</ref>, <ref loc="NUM 2:13">13</ref>; <ref loc="NUM 26:14">26:14</ref>, <ref loc="NUM 26:22">22</ref>. </char></note> Kandi Shimei ogwo akaba aine abaana b'aboojo ikumi na mukaaga n'ab'abaishiki mukaaga; kwonka beene ishe bakaba batazaire baana baingi, kandi oruganda rwabo rwona tirurakanyire nk'orwa Yuda. <verse eid="1CH 4:27" /><verse number="28" style="v" sid="1CH 4:28" /><note caller="-" style="x"><char style="xo" closed="false">4:28-33: </char><char style="xt" closed="false"><ref loc="JOS 19:2-8">Yos 19:2-8</ref>. </char></note> Bakaba batwire Beeri-sheba, Molada, Hazari-shuali, <verse eid="1CH 4:28" /><verse number="29" style="v" sid="1CH 4:29" />Biliha, Ezeemu, Toladi, <verse eid="1CH 4:29" /><verse number="30" style="v" sid="1CH 4:30" />Besueli, Horuma, zikulaagi, <verse eid="1CH 4:30" /><verse number="31" style="v" sid="1CH 4:31" />Besi-marikaboosi, Hazarasusimu, Besibiri na Sharaimu. Ezo nizo zaabaire ziri endembo zaabo okuhitsya obu Daudi yaagiire aha ngoma. <verse eid="1CH 4:31" /><verse number="32" style="v" sid="1CH 4:32" />Ebirorero byabo bikaba biri Etamu, Aini, rimona, Tokemu na Ashani, endembo zoona itaano, <verse eid="1CH 4:32" /><verse number="33" style="v" sid="1CH 4:33" />hamwe n'ebindi birorero byabo ebyabaire byehinguririize ezo ndembo okuhika Baali. Aho niho baabaire batwire, kandi bakaba baine ekitabo ky'okuhandiikamu oruzaaro rwabo. <verse eid="1CH 4:33" /><verse number="34" style="v" sid="1CH 4:34" />Meshobabu, Yamuleki, Yoosha mwene Amazia, <verse eid="1CH 4:34" /><verse number="35" style="v" sid="1CH 4:35" />Yoeli, Yehu mwene Yoshibia, mwijukuru wa Seraaya mwene Asieli, <verse eid="1CH 4:35" /><verse number="36" style="v" sid="1CH 4:36" />Elio-enai, Yakoba, Yeshohaaya, Asaaya, Adieli, Yesimieli, Benaaya, <verse eid="1CH 4:36" /><verse number="37" style="v" sid="1CH 4:37" />Ziiza mwene Shiifi, Shiifi ya Alooni, Alooni ya Yedaaya, Yedaaya ya Shimuri, Shimuri ya Shemaaya. <verse eid="1CH 4:37" /><verse number="38" style="v" sid="1CH 4:38" />Abo abu amaziina gaabo gagambwa bakaba bari bakuru omu miryango yaabo, kandi amaju ga baishenkurubo gakakanya munonga. <verse eid="1CH 4:38" /><verse number="39" style="v" sid="1CH 4:39" />Baaza ahu orikutaahira nooza Gedori, aha bukiizi bw'oburugwa-izooba bw'oruhita, kutatira amasyo gaabo obunyaatsi, <verse eid="1CH 4:39" /><verse number="40" style="v" sid="1CH 4:40" />baashangayo amariisizo marungi g'obunyaatsi, kandi ensi yaayo ekaba eri mpango munonga, eine obusingye, etuurize; ahabw'okuba abatuuzi baayo aba ira bakaba bari baijukuru ba Haamu. <verse eid="1CH 4:40" /><verse number="41" style="v" sid="1CH 4:41" /><note caller="-" style="x"><char style="xo" closed="false">4:41: </char><char style="xt" closed="false"><ref loc="1CH 4:34-38">1 Bus 4:34-38</ref>; <ref loc="1CH 5:22">5:22</ref>. </char></note> Kandi aba, abu amaziina gaabo gahandiikirwe, bakaija omu busingye bwa Hezekia omugabe wa Yuda, baateera amahema g'aba Haamu, n'ag'aba Meuniimu abu baashangireyo, baabacwekyerereza kimwe, baahwaho, tibaagaruka kwimutsya mutwe n'okuhitsya hati, baakubuura ensi yaabo, ahabw'okuba hakaba hariyo amariisizo g'amasyo gaabo. <verse eid="1CH 4:41" /><verse number="42" style="v" sid="1CH 4:42" /><note caller="-" style="x"><char style="xo" closed="false">4:42: </char><char style="xt" closed="false"><ref loc="GEN 36:8">Kut 36:8</ref>. </char></note> Kandi abamwe aharibo, beene Simeoni, abashaija magana ataano baaza omu bibungo bya Seiri, baine abeebembezi baabo Pelatia, Nearia, Refaaya na Uzieli beene Iishi; <verse eid="1CH 4:42" /><verse number="43" style="v" sid="1CH 4:43" /><note caller="-" style="x"><char style="xo" closed="false">4:43: </char><char style="xt" closed="false"><ref loc="1SA 15:8">1 Sam 15:8</ref>; <ref loc="1SA 30:17">30:17</ref>. </char></note> baacwekyereza ekicweka ky'Abaameleki ekyabaire kihonokireho, baatuurayo okuruga obwo n'okuhitsya hati.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 29:32">Kut 29:32</ref>; <ref loc="GEN 35:22">35:22</ref>; <ref loc="GEN 48:15-22">48:15-22</ref>; <ref loc="GEN 49:3">49:3</ref>, <ref loc="GEN 49:4">4</ref>. </char>
    </note> Beene Reubeeni omujigaijo gwa Israeli: (ahakuba niwe yaabaire ari omujigaijo, kwonka ahabw'okuhagara ekitabo kya ishe, yaayakwa obukuru bwe, bwaheebwa beene Yosefu mutabani wa Israeli; n'ahabw'ekyo omu kukuratana kw'amaziina tarahandiikirwe omu mwanya gw'obukuru, <verse eid="1CH 5:1" /><verse number="2" style="v" sid="1CH 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5:2: </char><char style="xt" closed="false"><ref loc="GEN 49:8-10">Kut 49:8-10</ref>; <ref loc="MIC 5:2">Mik 5:2</ref>; <ref loc="MAT 2:6">Mat 2:6</ref>. </char></note> kureka Yuda niwe yaakirize beene ishe amaani, kandi niwe yaakomookirwemu omutegyeki; kwonka obukuru bw'okuba omwana w'omujigaijo bwaguma buri obwa Yosefu.) <verse eid="1CH 5:2" /><verse number="3" style="v" sid="1CH 5:3" /><note caller="-" style="x"><char style="xo" closed="false">5:3: </char><char style="xt" closed="false"><ref loc="GEN 46:9">Kut 46:9</ref>. </char></note> Batabani ba Reubeeni omujigaijo gwa Israeli: Hanoki, Palu, Hezirooni na Karumi. <verse eid="1CH 5:3" /><verse number="4" style="v" sid="1CH 5:4" />Batabani ba Yoeli: mutabani we ni Shemaaya, mwene Shemaaya ni Googi, mwene Googi ni Shimei, <verse eid="1CH 5:4" /><verse number="5" style="v" sid="1CH 5:5" />mwene Shimei ni Niika, mwene Milka ni Reaya, mwene Reaya ni Baali; <verse eid="1CH 5:5" /><verse number="6" style="v" sid="1CH 5:6" /><note caller="-" style="x"><char style="xo" closed="false">5:6: </char><char style="xt" closed="false"><ref loc="2CH 28:20">2 Bus 28:20</ref>. </char></note> mwene Baali ni Beera; ogwo niwe Tigulaasi-pileseeri omugabe wa Asiria yaatwaire omu bukwatwa, kandi niwe yaabaire ari mukuru omu Bareubeeni. <verse eid="1CH 5:6" /><verse number="7" style="v" sid="1CH 5:7" /><note caller="-" style="x"><char style="xo" closed="false">5:7: </char><char style="xt" closed="false"><ref loc="1CH 5:17">1 Bus 5:17</ref>. </char></note> Beene waabo bakahandiikwa omu miryango yaabo, nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri; omukuru Yeyeli; na Zekaria, <verse eid="1CH 5:7" /><verse number="8" style="v" sid="1CH 5:8" /><note caller="-" style="x"><char style="xo" closed="false">5:8: </char><char style="xt" closed="false"><ref loc="NUM 32:3">Kub 32:3</ref>, <ref loc="NUM 32:38">38</ref>; <ref loc="JOS 13:16">Yos 13:16</ref>. </char></note> na Beela, mwene Azazi mwijukuru wa Sheema mwene Yoeli owaabaire atwire Aroeri okuhika Neebo na Baali-meoni; <verse eid="1CH 5:8" /><verse number="9" style="v" sid="1CH 5:9" /><note caller="-" style="x"><char style="xo" closed="false">5:9: </char><char style="xt" closed="false"><ref loc="JOS 22:9">Yos 22:9</ref>. </char></note> kandi akatuura aha bukiizi bw'oburugwa-izooba, ahu orikutaahira nooza omu ihamba seenu y'omugyera Furaati, ahakuba amatungo gaabo gakaba gakanyire omu nsi ya Gileadi. <verse eid="1CH 5:9" /><verse number="10" style="v" sid="1CH 5:10" />Bwanyima omu busingye bwa Saulo baarwana n'aba Hagari, baabaita; batyo baatuura omu mahema gaabo omu byanga byona eby'aha burugwa-izooba bwa Gileadi.<verse eid="1CH 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 5:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 13:11">Yos 13:11</ref>. </char>
    </note> Beene Gaadi baatuura obuseeri bwabo omu nsi ya Bashani okuhika Saleka; <verse eid="1CH 5:11" /><verse number="12" style="v" sid="1CH 5:12" />Yoeli niwe yaabaire ari mukuri, orikukurataho ari Shafamu, n'abandi Yanai na Shafati omuri Bashani. <verse eid="1CH 5:12" /><verse number="13" style="v" sid="1CH 5:13" />Na beene waabo nk'amaju ga baishenkurubo oku gaabaire gari: Mikaeli, Meshulaamu, Sheeba, Yorai, Yakani, Zia na Eberi, boona mushanju. <verse eid="1CH 5:13" /><verse number="14" style="v" sid="1CH 5:14" />Aba nibo batabani ba Abihaili mwene Huuri, mwijukuru wa Yaroa, mwene Gileadi, Gileadi ya Mikaeli, Mikaeli ya Yeshishai, Yeshishai ya Yahudo, na Yahudo ya Buuzi: <verse eid="1CH 5:14" /><verse number="15" style="v" sid="1CH 5:15" />Ahi mwene Abudieli, mwijukuru wa Guuni, niwe yaabaire ari mukuru omu maju ga baishenkurubo. <verse eid="1CH 5:15" /><verse number="16" style="v" sid="1CH 5:16" /><note caller="-" style="x"><char style="xo" closed="false">5:16: </char><char style="xt" closed="false"><ref loc="1CH 27:29">1 Bus 27:29</ref>. </char></note> Abo bakaba batwire Gileadi n'omuri Bashani n'omu ndembo zaayo, kandi n'omu mariisizo goona ag'omuri Sharooni okuhika ahu garikugarukira. <verse eid="1CH 5:16" /><verse number="17" style="v" sid="1CH 5:17" /><note caller="-" style="x"><char style="xo" closed="false">5:17: </char><char style="xt" closed="false"><ref loc="2KI 14:16">2 Bag 14:16</ref>, <ref loc="2KI 14:28">28</ref>; <ref loc="2KI 15:5">15:5</ref>, <ref loc="2KI 15:32">32</ref>. </char></note> Abo boona bakahandiikwa omu busingye bwa Yosamu omugabe wa Yuda, n'omu bwa Yeroboamu omugabe wa Israeli, nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri.<verse eid="1CH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:18: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 1:3">Kub 1:3</ref>. </char>
    </note> Abareubeeni n'Abagaadi n'ekicweka ky'oruganda rwa Manaase bakaba baine abashaija amamanzi, abaabaire bahagatira engabo na zaarurara, nibamanya kurwanisa amata, abarwani rukungwa, boona bari obukumi buna n'enkumi ina na magana mushanju na makumi mukaaga, abeeteekateekire kuhurura. <verse eid="1CH 5:18" /><verse number="19" style="v" sid="1CH 5:19" /><note caller="-" style="x"><char style="xo" closed="false">5:19: </char><char style="xt" closed="false"><ref loc="GEN 25:15">Kut 25:15</ref>; <ref loc="1CH 1:31">1 Bus 1:31</ref>. </char></note> Baateera aba Hagari, aba Yeturi, aba Nafishi n'aba Nodabu. <verse eid="1CH 5:19" /><verse number="20" style="v" sid="1CH 5:20" /><note caller="-" style="x"><char style="xo" closed="false">5:20: </char><char style="xt" closed="false"><ref loc="2CH 14:11">2 Bus 14:11</ref>; <ref loc="2CH 18:31">18:31</ref>; <ref loc="PSA 22:4">Zab 22:4</ref>, <ref loc="PSA 22:5">5</ref>. </char></note> Ku baabaire nibakirwana nabo, baakwerwa, aba Hagari na boona abu baabaire baine baaheebwayo omu mikono yaabo, ahakuba bakatakira Ruhanga omuri orwo rugamba, yaahurira okweshengyereza kwabo, ahabw'okuba bakamwesiga. <verse eid="1CH 5:20" /><verse number="21" style="v" sid="1CH 5:21" />Baanyaga amatungo gaabo, engamira obukumi butaano, entaama obusiriira bubiri n'obukumi butaano, n'endogoya enkumi ibiri, kandi n'abashaija akasiriira abaakwatsirwe; <verse eid="1CH 5:21" /><verse number="22" style="v" sid="1CH 5:22" /><note caller="-" style="x"><char style="xo" closed="false">5:22: </char><char style="xt" closed="false"><ref loc="2KI 15:29">2 Bag 15:29</ref>; <ref loc="2KI 17:6">17:6</ref>; <ref loc="1CH 4:41">1 Bus 4:41</ref>; <ref loc="1CH 5:6">5:6</ref>. </char></note> ahakuba baingi bakaitwa, ahabw'okuba orwo rugamba rukaba rurugire ahari Ruhanga. Bwanyima baatuura omu nsi ya bari, okuhitsya obu baatwairwe omu bukwatwa.<verse eid="1CH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:23: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:9">Bir 3:9</ref>; <ref loc="EZK 27:5">Ezk 27:5</ref>. </char>
    </note> Ab'ekicweka ky'oruganda rwa Manaase baatuura omuri egyo nsi, bari baingi munonga, okuruga Bashani okuhika Baali-herumooni, na Seniiri n'orushozi Herumooni. <verse eid="1CH 5:23" /><verse number="24" style="v" sid="1CH 5:24" />Kandi aba nibo baabaire bari bakuru omu maju ga baishenkurubo: Eferi, Iishi, Elieli, Azurieli, Yeremia, Hodavia na Yahudieli, abarwani b'amaani, abashaija rugambwa, abaabaire bari bakuru omu maju ga baishenkurubo. <verse eid="1CH 5:24" /><verse number="25" style="v" sid="1CH 5:25" /><note caller="-" style="x"><char style="xo" closed="false">5:25: </char><char style="xt" closed="false"><ref loc="EXO 34:15">Kur 34:15</ref>; <ref loc="2KI 17:17">2 Bag 17:17</ref>. </char></note> Kwonka bakacumura ahari Ruhanga wa baishenkurubo, baakuratira baaruhanga b'amahanga g'omuri egyo nsi nk'abarikuraaya, agu Ruhanga yaabacwekyerereize omu maisho. <verse eid="1CH 5:25" /><verse number="26" style="v" sid="1CH 5:26" /><note caller="-" style="x"><char style="xo" closed="false">5:26: </char><char style="xt" closed="false"><ref loc="2KI 15:9">2 Bag 15:9</ref>; <ref loc="2KI 17:6">17:6</ref>; <ref loc="2KI 18:11">18:11</ref>; <ref loc="1CH 5:6">1 Bus 5:6</ref>. </char></note> N'ahabw'ekyo Ruhanga wa Israeli yaimutsya Puuli omugabe wa Asiria na Tigulaasi-pileseeri omugabe wa Asiria, yaatwara Abareubeeni, Abagaadi n'ekicweka ky'oruganda rwa Manaase bari enkwatwa, yaabata Haala, Habora, Haara n'aha mugyera ogw'omuri Gozani, baagumayo n'okuhitsya hati.<verse eid="1CH 5:26" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:11">Kut 46:11</ref>; <ref loc="1CH 26:6">1 Bus 26:6</ref>. </char>
    </note> Batabani ba Leevi: Gereshoni, Kohasi na Merari. <verse eid="1CH 6:1" /><verse number="2" style="v" sid="1CH 6:2" /><note caller="-" style="x"><char style="xo" closed="false">6:2: </char><char style="xt" closed="false"><ref loc="EXO 6:18">Kur 6:18</ref>; <ref loc="1CH 6:22">1 Bus 6:22</ref>. </char></note> Batabani ba Kohasi: Amuraamu, Izuhaari, Heburooni na Uzieli. <verse eid="1CH 6:2" /><verse number="3" style="v" sid="1CH 6:3" /><note caller="-" style="x"><char style="xo" closed="false">6:3: </char><char style="xt" closed="false"><ref loc="EXO 6:20">Kur 6:20</ref>; <ref loc="EXO 15:20">15:20</ref>; <ref loc="LEV 10:1">Lev 10:1</ref>, <ref loc="LEV 10:2">2</ref>. </char></note> Abaana ba amuraamu: Arooni, Musa na Miriamu. Batabani ba Arooni: Nadabu, Abihu, Eleazaari na Itamaari. <verse eid="1CH 6:3" /><verse number="4" style="v" sid="1CH 6:4" /><note caller="-" style="x"><char style="xo" closed="false">6:4-6: </char><char style="xt" closed="false"><ref loc="1CH 6:11-14">1 Bus 6:11-14</ref>; <ref loc="EZR 7:1-5">Ezr 7:1-5</ref>; <ref loc="EXO 6:25">Kur 6:25</ref>. </char></note> Eleazaari yaazaara Finehaasi, Finehaasi yaazaara Abishua, <verse eid="1CH 6:4" /><verse number="5" style="v" sid="1CH 6:5" />Abishua yaazaara Buuki, Buuki yaazaara Uuzi, <verse eid="1CH 6:5" /><verse number="6" style="v" sid="1CH 6:6" /><note caller="-" style="x"><char style="xo" closed="false">6:6-8: </char><char style="xt" closed="false"><ref loc="1CH 6:50-53">1 Bus 6:50-53</ref>; <ref loc="1CH 9:11">9:11</ref>; <ref loc="NEH 11:11">Neh 11:11</ref>. </char></note> Uuzi yaazaara Zerahia, Zerahia yaazaara Merayoosi, <verse eid="1CH 6:6" /><verse number="7" style="v" sid="1CH 6:7" />Merayoosi yaazaara Amaria, Amaria yaazaara Ahitubu, <verse eid="1CH 6:7" /><verse number="8" style="v" sid="1CH 6:8" /><note caller="-" style="x"><char style="xo" closed="false">6:8: </char><char style="xt" closed="false"><ref loc="2SA 8:17">2 Sam 8:17</ref>; <ref loc="2SA 15:27">15:27</ref>. </char></note> Ahitubu yaazaara Zadoki, Zadoki yaazaara Ahimaazi, <verse eid="1CH 6:8" /><verse number="9" style="v" sid="1CH 6:9" />Ahimaazi yaazaara Azaria, Azaria yaazaara Yohanaani, <verse eid="1CH 6:9" /><verse number="10" style="v" sid="1CH 6:10" /><note caller="-" style="x"><char style="xo" closed="false">6:10: </char><char style="xt" closed="false"><ref loc="1KI 6:1">1 Bag 6:1</ref>; <ref loc="2CH 3:1">2 Bus 3:1</ref>. </char></note> Yohanaani yaazaara Azaria, (ogwo niwe yaabaire akora omurimo gw'obunyamurwa omu nju ei Sulemaani yaayombekire Yerusaalemu). <verse eid="1CH 6:10" /><verse number="11" style="v" sid="1CH 6:11" /><note caller="-" style="x"><char style="xo" closed="false">6:11: </char><char style="xt" closed="false"><ref loc="2CH 19:11">2 Bus 19:11</ref>. </char></note> Azaria yaazaara, Amaria, Amaria yaazaara Ahitubu, <verse eid="1CH 6:11" /><verse number="12" style="v" sid="1CH 6:12" />Ahitubu yaazaara Zadoki, Zadoki yaazaara Shalumu, <verse eid="1CH 6:12" /><verse number="13" style="v" sid="1CH 6:13" /><note caller="-" style="x"><char style="xo" closed="false">6:13: </char><char style="xt" closed="false"><ref loc="2KI 22:4">2 Bag 22:4</ref>. </char></note> Shalumu yaazaara Hilukia, Hilukia yaazaara Azaria, <verse eid="1CH 6:13" /><verse number="14" style="v" sid="1CH 6:14" /><note caller="-" style="x"><char style="xo" closed="false">6:14: </char><char style="xt" closed="false"><ref loc="2KI 25:18">2 Bag 25:18</ref>. </char></note> Azaria yaazaara Seraaya, Seraaya yaazaara Yehozadaki, <verse eid="1CH 6:14" /><verse number="15" style="v" sid="1CH 6:15" /><note caller="-" style="x"><char style="xo" closed="false">6:15: </char><char style="xt" closed="false"><ref loc="2KI 25:8-21">2 Bag 25:8-21</ref>; <ref loc="EZR 3:2">Ezr 3:2</ref>. </char></note> owaatwairwe omu bukwatwa, obu MUKAMA yaimutsya Nebukadeneeza, akatwara Abayuda n'aba Yerusaalemu omu bukwatwa.<verse eid="1CH 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 6:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:16-19: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 6:16-19">Kur 6:16-19</ref>. </char>
    </note> Batabani ba Leevi: Gereshoni, Kohasi na Merari. <verse eid="1CH 6:16" /><verse number="17" style="v" sid="1CH 6:17" /><note caller="-" style="x"><char style="xo" closed="false">6:17: </char><char style="xt" closed="false"><ref loc="1CH 23:7">1 Bus 23:7</ref>. </char></note> Kandi aga nigo maziina ga batabani ba Gereshoni: Libuni na Shimei. <verse eid="1CH 6:17" /><verse number="18" style="v" sid="1CH 6:18" /><note caller="-" style="x"><char style="xo" closed="false">6:18: </char><char style="xt" closed="false"><ref loc="1CH 23:12">1 Bus 23:12</ref>. </char></note> Batabani ba Kohasi: Amuraamu, Isuhaari, Heburooni na Uzieli. <verse eid="1CH 6:18" /><verse number="19" style="v" sid="1CH 6:19" /><note caller="-" style="x"><char style="xo" closed="false">6:19: </char><char style="xt" closed="false"><ref loc="1CH 6:44">1 Bus 6:44</ref>, <ref loc="1CH 6:47">47</ref>; <ref loc="1CH 23:21">23:21</ref>. </char></note> Batabani ba Merari: Mahili na Muushi. Egi niyo miryango y'Abaleevi nk'oku baishenkuru baabaire bari. <verse eid="1CH 6:19" /><verse number="20" style="v" sid="1CH 6:20" /><note caller="-" style="x"><char style="xo" closed="false">6:20, 21: </char><char style="xt" closed="false"><ref loc="1CH 6:40-43">1 Bus 6:40-43</ref>. </char></note> Aba Gereshoni: omutabani ni Libuni, mwene Libuni ni Yahasi, mwene Yahasi ni Ziima, <verse eid="1CH 6:20" /><verse number="21" style="v" sid="1CH 6:21" />mwene Ziima ni Yoa, mwene Yoa ni Iido, mwene Iido ni Zeera, mwene Zeera ni Yeaserai. <verse eid="1CH 6:21" /><verse number="22" style="v" sid="1CH 6:22" /><note caller="-" style="x"><char style="xo" closed="false">6:22-23: </char><char style="xt" closed="false"><ref loc="1CH 6:33-38">1 Bus 6:33-38</ref>. </char></note> Batabani ba Kohasi: omutabani ni Aminadabu, mwene Aminadabu ni Koora, mwene Koora ni Asiri, <verse eid="1CH 6:22" /><verse number="23" style="v" sid="1CH 6:23" />mwene Asiri ni Elukaana, mwene Elukaana ni Ebiasaafu, mwene Ebiasaafu ni Asiri, <verse eid="1CH 6:23" /><verse number="24" style="v" sid="1CH 6:24" />mwene Ariri ni Tahasi, mwene Tahasi ni Urieli, mwene Urieli ni Uziya, mwene Uziya ni Shauli. <verse eid="1CH 6:24" /><verse number="25" style="v" sid="1CH 6:25" />Batabani ba Elukaana: Amasai na Ahimoosi, <verse eid="1CH 6:25" /><verse number="26" style="v" sid="1CH 6:26" />omutabani ni Elukaana, mwene Elukaana ni Zofai, mwene Zofai ni Nahasi, <verse eid="1CH 6:26" /><verse number="27" style="v" sid="1CH 6:27" />mwene Nahasi ni Eliabu, mwene Eliabu ni Yerohaamu, mwene Yerohaamu ni Elukaana. <verse eid="1CH 6:27" /><verse number="28" style="v" sid="1CH 6:28" />Batabani ba Samueli: omujigaijo gwe ni Yoeli, n'omushubiro ni Abiya. <verse eid="1CH 6:28" /><verse number="29" style="v" sid="1CH 6:29" />Batabani ba Merari: Mahili, mwene Mahili ni Libuni, mwene Libuni ni Shimei, mwene Shimei ni Uuza, <verse eid="1CH 6:29" /><verse number="30" style="v" sid="1CH 6:30" />mwene Uuza ni Shimea, mwene Shimea ni Hagia, mwene Hagia ni Asaaya.<verse eid="1CH 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:31: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 6:12-17">2 Sam 6:12-17</ref>; <ref loc="1CH 15:25-16:1">1 Bus 15:25—16:1</ref>. </char>
    </note> Abo nibo Daudi yaakwatsize omurimo gw'okweshongora omu nju ya MUKAMA, eshanduukye eherize kuza hamwe; <verse eid="1CH 6:31" /><verse number="32" style="v" sid="1CH 6:32" />baaguma nibeeshongora omu maisho g'Obutaaho bw'Eihema ry'okubugaabuganiramu omu kuheereza kwabo, okuhitsya obu Sulemaani yaaherize kwombeka enju ya MUKAMA omuri Yerusaalemu; kandi baakora omurimo gwabo, nk'oku embu zaabo zaabaire ziri. <verse eid="1CH 6:32" /><verse number="33" style="v" sid="1CH 6:33" /><note caller="-" style="x"><char style="xo" closed="false">6:33: </char><char style="xt" closed="false"><ref loc="1CH 6:28">1 Bus 6:28</ref>; <ref loc="1CH 15:17">15:17</ref>, <ref loc="1CH 15:19">19</ref>; <ref loc="1CH 16:41">16:41</ref>, <ref loc="1CH 16:42">42</ref>; <ref loc="2CH 5:12">2 Bus 5:12</ref>. </char></note> Aba nibo baabaire baheereza hamwe n'abatabani baabo. Omuri beene Kohasi: Hemani omweshongozi mwene Yoeli, Yoeli ya Samueli, <verse eid="1CH 6:33" /><verse number="34" style="v" sid="1CH 6:34" />Samueli ya Elukaana, Elukaana ya Yerohaamu, Yerohaamu ya Elieli, Elieli ya Toa, <verse eid="1CH 6:34" /><verse number="35" style="v" sid="1CH 6:35" />Toa ya Zuufi, Zuufi ya Elukaana, Elukaana ya Mahasi, Mahasi ya Amasai, <verse eid="1CH 6:35" /><verse number="36" style="v" sid="1CH 6:36" />Amasai ya Elukaana, Elukaana ya Yoeli, Yoeli ya Azaria, Azaria ya Zefania, <verse eid="1CH 6:36" /><verse number="37" style="v" sid="1CH 6:37" />Zefania ya Tahasi, Tahasi ya Asiri, Asiri ya Ebiasaafu, Ebiasaafu ya Koora, <verse eid="1CH 6:37" /><verse number="38" style="v" sid="1CH 6:38" />Koora ya Izuhaari, Izuhaari ya Kohasi, mwene Leevi, omwana wa Israeli. <verse eid="1CH 6:38" /><verse number="39" style="v" sid="1CH 6:39" /><note caller="-" style="x"><char style="xo" closed="false">6:39: </char><char style="xt" closed="false"><ref loc="1CH 15:17">1 Bus 15:17</ref>, <ref loc="1CH 15:19">19</ref>; <ref loc="2CH 5:12">2 Bus 5:12</ref>; <ref loc="EZR 2:4">Ezr 2:4</ref>; <ref loc="NEH 7:44">Neh 7:44</ref>. </char></note> Murumuna wa Hemani ni Asafu owaabaire ayemerera aha rubaju rwe rwa buryo, niwe Asafu mwene Berekia, Berekia mwene Shimea, <verse eid="1CH 6:39" /><verse number="40" style="v" sid="1CH 6:40" />Shimea ya Mikaeli, Mikaeli ya Baseya, Baseyaya Malikiya, <verse eid="1CH 6:40" /><verse number="41" style="v" sid="1CH 6:41" />Malikiya ya Esuni, Esuni ya Zeera, Zeera ya Adaaya, <verse eid="1CH 6:41" /><verse number="42" style="v" sid="1CH 6:42" />Adaaya ya Esaani, Esaani ya Ziima, Ziima ya Shimei, <verse eid="1CH 6:42" /><verse number="43" style="v" sid="1CH 6:43" />Shimei ya Yahasi, Yahasi mwene Gereshoni, omwana wa Leevi. <verse eid="1CH 6:43" /><verse number="44" style="v" sid="1CH 6:44" />Aha rubaju rwabo rwa bumosho hakaba hariho beene waabo batabani ba Merari: Esaani mwene Kiishi, Kiishi ya Abudi, Abudi ya Maluki, <verse eid="1CH 6:44" /><verse number="45" style="v" sid="1CH 6:45" />Maluki ya Hashabia, Hashabia ya Amazia, Amazia ya Hilukia, <verse eid="1CH 6:45" /><verse number="46" style="v" sid="1CH 6:46" />Hilukia ya Amuzi, amuzi ya Baani, Baani ya Shemeri, <verse eid="1CH 6:46" /><verse number="47" style="v" sid="1CH 6:47" />Shemeri ya Mahili, Mahili ya Muushi mwene Merari, omwana wa Leevi. <verse eid="1CH 6:47" /><verse number="48" style="v" sid="1CH 6:48" />Kandi beene waabo Abaleevi bakateebwaho kukora omurimo gwona ogw'omu Butaaho bw'enju ya Ruhanga.<verse eid="1CH 6:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="1CH 6:49" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:49: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 30:7">Kur 30:7</ref>, <ref loc="EXO 30:10">10</ref>; <ref loc="LEV 1:7-9">Lev 1:7-9</ref>; <ref loc="LEV 4:20">4:20</ref>. </char>
    </note> Kwonka Arooni n'abatabani bakaba batambira ebitambo aha itambiro ry'ebitambo by'okwotsya, n'aha itambiro ry'okwotereraho obubaane ahabw'omurimo gwona ogw'Aharikwera munonga, okurihiirira Abaisraeli, nk'ebi Musa omwiru wa Ruhanga yaaragiire byona oku byabaire biri. <verse eid="1CH 6:49" /><verse number="50" style="v" sid="1CH 6:50" /><note caller="-" style="x"><char style="xo" closed="false">6:50-53: </char><char style="xt" closed="false"><ref loc="1CH 6:4-8">1 Bus 6:4-8</ref>. </char></note> Abo nibo batabani ba Arooni: Eleazaari omutabani, mwene eleazaari ni Finehaasi, mwene Finehaasi ni Abishua, <verse eid="1CH 6:50" /><verse number="51" style="v" sid="1CH 6:51" />mwene Abishua ni Buuki, mwene Buuki ni Uuzi, mwene Uuzi ni Zerahia, <verse eid="1CH 6:51" /><verse number="52" style="v" sid="1CH 6:52" />mwene Zerahia ni Merayosi, mwene Merayoosi na Amaria, mwene Amaria ni Ahitubu, <verse eid="1CH 6:52" /><verse number="53" style="v" sid="1CH 6:53" />mwene Ahitubu ni Zadoki, mwene Zadoki ni Ahimaazi.<verse eid="1CH 6:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="1CH 6:54" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:54: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 21:4">Yos 21:4</ref>, <ref loc="JOS 21:10">10</ref>. </char>
    </note> Kandi ebi nibyo bibanja byabo ebi baabaire batwiremu, nk'oku baabahaire ah'okutuura omu nsi yaabo yoona; beene Arooni ab'omu miryango y'aba Kohasi, ahabw'okuba omugabo gw'okubanza gukaba guri ogwabo. <verse eid="1CH 6:54" /><verse number="55" style="v" sid="1CH 6:55" />Bakabaha Heburooni omu ishaza rya Yuda n'amariisizo gaayo agaagyehinguririize, <verse eid="1CH 6:55" /><verse number="56" style="v" sid="1CH 6:56" /><note caller="-" style="x"><char style="xo" closed="false">6:56: </char><char style="xt" closed="false"><ref loc="JOS 14:13">Yos 14:13</ref>; <ref loc="JOS 15:13">15:13</ref>. </char></note> kwonka emisiri y'orurembo n'ebirorero byarwo baabiha Kalebu mwene Yefune. <verse eid="1CH 6:56" /><verse number="57" style="v" sid="1CH 6:57" /><note caller="-" style="x"><char style="xo" closed="false">6:57-60: </char><char style="xt" closed="false"><ref loc="JOS 21:13-19">Yos 21:13-19</ref>. </char></note> Beene Arooni abandi baabaha endembo ez'okuhungiramu- Heburooni, Libuna n'amariisizo gaayo, Yatiri, Eshitemoa n'amariisizo gaayo, <verse eid="1CH 6:57" /><verse number="58" style="v" sid="1CH 6:58" />Hileeni n'amariisizo gaayo, Debira n'amariisizo gaayo, <verse eid="1CH 6:58" /><verse number="59" style="v" sid="1CH 6:59" />Ashani n'amariisizo gaayo, na Beti-shemeshi n'amariisizo gaayo; <verse eid="1CH 6:59" /><verse number="60" style="v" sid="1CH 6:60" />kandi omu z'oruganda rwa Benyamiini baabaha Geeba n'amariisizo gaayo, Alemeesi n'amariisizo gaayo, na Anatoosi n'amariisizo gaayo. Endembo zaabo zoona ezi baabagaine omu miryango yaabo yoona zaaba ikumi na ishatu.<verse eid="1CH 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="1CH 6:61" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:61: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 6:66-70">1 Bus 6:66-70</ref>; <ref loc="JOS 21:5">Yos 21:5</ref>. </char>
    </note> Beene Kohasi abandi baaheebwa omugabo gw'endembo ikumi omu kicweka ky'oruganda rwa Manaase. <verse eid="1CH 6:61" /><verse number="62" style="v" sid="1CH 6:62" />Beene Gereshoni, nk'oku emiryango yaabo yaabaire eri, baaheebwa endembo ikumi na ishatu omu ruganda rwa Isakaari, orwa Asheri, orwa Nafutaali n'orwa Manaase omuri Bashani. <verse eid="1CH 6:62" /><verse number="63" style="v" sid="1CH 6:63" /><note caller="-" style="x"><char style="xo" closed="false">6:63: </char><char style="xt" closed="false"><ref loc="JOS 21:3">Yos 21:3</ref>. </char></note> Beene Merari nk'oku emiryango yaabo yaabaire eri baabaha endembo ikumi na ibiri omu ruganda rwa Reubeeni, orwa Gaadi, n'orwa zebuluuni. <verse eid="1CH 6:63" /><verse number="64" style="v" sid="1CH 6:64" />Batyo Abaisraeli baaha Abaleevi ezo ndembo n'amariisizo gaazo. <verse eid="1CH 6:64" /><verse number="65" style="v" sid="1CH 6:65" /><note caller="-" style="x"><char style="xo" closed="false">6:65: </char><char style="xt" closed="false"><ref loc="1CH 6:57-60">1 Bus 6:57-60</ref>. </char></note> Kandi baagaruka baabahaisa enteenyu ezo ndembo ezaagambwaho ez'omu ruganda rwa Yuda, orwa Simeoni n'orwa Benyamiini.<verse eid="1CH 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="1CH 6:66" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:66-70: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 21:20-26">Yos 21:20-26</ref>. </char>
    </note> Kandi bamwe ab'omu miryango y'aba Kohasi bakaba baine endembo omu ruganda rwa Efuraimu. <verse eid="1CH 6:66" /><verse number="67" style="v" sid="1CH 6:67" />Baaheebwa n'endembo z'okuhungiramu–Shekemu ey'omu nsi y'ebibungo eya Efuraimu n'amariisizo gaayo, Gezeri n'amariisizo gaayo, <verse eid="1CH 6:67" /><verse number="68" style="v" sid="1CH 6:68" /><note caller="-" style="x"><char style="xo" closed="false">6:68: </char><char style="xt" closed="false"><ref loc="JOS 12:22">Yos 12:22</ref>; <ref loc="1KI 4:12">1 Bag 4:12</ref>. </char></note> Yokimeamu n'amariisizo gaayo, Besihoroni n'amariisizo gaayo, <verse eid="1CH 6:68" /><verse number="69" style="v" sid="1CH 6:69" />Ayalooni n'amariisizo gaayo, na Gaasi-rimoni n'amariisizo gaayo; <verse eid="1CH 6:69" /><verse number="70" style="v" sid="1CH 6:70" />kandi omu kicweka ky'oruganda rwa Manaase Aneri n'amariisizo gaayo, na Bileamu n'amariisizo gaayo ahabw'emiryango y'aba Kohasi eyaatsigaireho.<verse eid="1CH 6:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="1CH 6:71" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:71-76: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 21:27-33">Yos 21:27-33</ref>; <ref loc="JOS 9:10">Yos 9:10</ref>. </char>
    </note> Beene Gereshoni baaheebwa endembo omu kicweka ky'oruganda rwa Manaase—Golani ey'omuri Bashani n'amariisizo gaayo, Ashitaroosi n'amariisizo gaayo; <verse eid="1CH 6:71" /><verse number="72" style="v" sid="1CH 6:72" />omu ruganda rwa Isakaari–Kedeshi n'amariisizo gaayo, Daberaasi n'amariisizo gaayo, <verse eid="1CH 6:72" /><verse number="73" style="v" sid="1CH 6:73" />Ramosi n'amariisizo gaayo, na Anemu n'amariisizo gaayo; <verse eid="1CH 6:73" /><verse number="74" style="v" sid="1CH 6:74" />omu ruganda rwa Asheri–Mashari n'amariisizo gaayo, Abudooni n'amariisizo gaayo, <verse eid="1CH 6:74" /><verse number="75" style="v" sid="1CH 6:75" />Hukoki n'amariisizo gaayo, na Rehobu n'amariisizo gaayo; <verse eid="1CH 6:75" /><verse number="76" style="v" sid="1CH 6:76" />omu ruganda rwa Nafutaali–Kedeshi ey'omuri Galilaaya n'amariisizo gaayo, na Kiryasaimu n'amariisizo gaayo. <verse eid="1CH 6:76" /><verse number="77" style="v" sid="1CH 6:77" /><note caller="-" style="x"><char style="xo" closed="false">6:77-81: </char><char style="xt" closed="false"><ref loc="JOS 21:34-39">Yos 21:34-39</ref>. </char></note> Beene Merari abandi baaheebwa omu ruganda rwa Zebuluuni Rimono n'amariisizo gaayo, Tabori n'amariisizo gaayo,<note caller="-" style="x"><char style="xo" closed="false">6:77: </char><char style="xt" closed="false"><ref loc="JOS 19:12">Yos 19:12</ref>, <ref loc="JOS 19:13">13</ref>. </char></note> <verse eid="1CH 6:77" /><verse number="78" style="v" sid="1CH 6:78" /><note caller="-" style="x"><char style="xo" closed="false">6:78: </char><char style="xt" closed="false"><ref loc="JOS 13:32">Yos 13:32</ref>. </char></note> na seeri ya Yorudani ahari Yeriko, aha rubaju rwayo rw'oburugwa-izooba omu ruganda rwa Reubeeni, Bezeeri ey'omu ihamba n'amariisizo gaayo, Yahuza n'amariisizo gaayo, <verse eid="1CH 6:78" /><verse number="79" style="v" sid="1CH 6:79" />Kedemoosi n'amariisizo gaayo na Mefaasi n'amariisizo gaayo; <verse eid="1CH 6:79" /><verse number="80" style="v" sid="1CH 6:80" /><note caller="-" style="x"><char style="xo" closed="false">6:80: </char><char style="xt" closed="false"><ref loc="GEN 32:2">Kut 32:2</ref>; <ref loc="1KI 22:3">1 Bag 22:3</ref>, <ref loc="1KI 22:4">4</ref>; <ref loc="2KI 9:1">2 Bag 9:1</ref>, <ref loc="2KI 9:14">14</ref>. </char></note> kandi omu ruganda rwa Gaadi Ramosi ey'omuri Gileadi n'amariisizo gaayo, Mahanaimu n'amariisizo gaayo, <verse eid="1CH 6:80" /><verse number="81" style="v" sid="1CH 6:81" /><note caller="-" style="x"><char style="xo" closed="false">6:81: </char><char style="xt" closed="false"><ref loc="NUM 21:32">Kub 21:32</ref>; <ref loc="JOS 13:17">Yos 13:17</ref>; <ref loc="JOS 21:39">21:39</ref>. </char></note> Heshibooni n'amariisizo gaayo, na Yazeri n'amariisizo gaayo.<verse eid="1CH 6:81" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 7:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:13">Kut 46:13</ref>; <ref loc="NUM 26:23">Kub 26:23</ref>. </char>
    </note> Batabani ba Isakaari: Toola, Pua, Yashubu, na Shimirooni, boona bana. <verse eid="1CH 7:1" /><verse number="2" style="v" sid="1CH 7:2" /><note caller="-" style="x"><char style="xo" closed="false">7:2: </char><char style="xt" closed="false"><ref loc="2SA 24:1">2 Sam 24:1</ref>, <ref loc="2SA 24:2">2</ref>, <ref loc="2SA 24:9">9</ref>. </char></note> Batabani ba Toola: Uuzi, Refaaya, Yerieli, Yahumai, Ibusaamu na Shemueli, abakuru b'amaju ga baishenkurubo, nibo beene Toola, abaabaire bari abarwani b'amaani omu biro byabo; omu busingye bwa Daudi omubaro gwabo bakaba bari obukumi bubiri n'enkumi ibiri na magana mukaaga. <verse eid="1CH 7:2" /><verse number="3" style="v" sid="1CH 7:3" />Mutabani wa Uuzi: Izurahia. Batabani ba Izurahia: Mikaeli, Obadia, Yoeli na Ishia, boona bataano bakaba bari abantu bakuru; <verse eid="1CH 7:3" /><verse number="4" style="v" sid="1CH 7:4" />kandi omuribo, nk'okukuratana kw'oruzaaro rw'amaju ga baishenkurubo oku kwabaire kuri, hakaba harimu emitwe y'engabo z'okuza aha rugamba obukumi bushatu n'enkumi mukaaga, ahabw'okuba bakaba baine abakazi baingi n'abaana b'aboojo baingi. <verse eid="1CH 7:4" /><verse number="5" style="v" sid="1CH 7:5" />Kandi beene waabo ab'omu miryango yoona y'Abaisakaari bakaba bari abarwani obukumi munaana n'enkumi mushanju, nk'oku baahandiikirwe omu kitabo ky'okuzaarwa kwabo. <verse eid="1CH 7:5" /><verse number="6" style="v" sid="1CH 7:6" /><note caller="-" style="x"><char style="xo" closed="false">7:6: </char><char style="xt" closed="false"><ref loc="GEN 46:21">Kut 46:21</ref>; <ref loc="NUM 26:38">Kub 26:38</ref>; <ref loc="1CH 8:1-40">1 Bus 8:1-40</ref>. </char></note> Batabani ba Benyamiini: Beela, Bekeri na Yedieli, bashatu. <verse eid="1CH 7:6" /><verse number="7" style="v" sid="1CH 7:7" />Batabani ba Beela: Ezibooni, Uuzi, Uzieli, Yerimoosi na Iiri, bataano, abakuru b'amaju ga baishenkurubo, kandi abarwani b'amaani; bakaba bari obukumi bubiri n'enkumi ibiri na makumi mukaaga na bana, nk'oku baahandiikirwe omu kukuratana kw'oruzaaro rwabo. <verse eid="1CH 7:7" /><verse number="8" style="v" sid="1CH 7:8" /><note caller="-" style="x"><char style="xo" closed="false">7:8: </char><char style="xt" closed="false"><ref loc="1CH 6:60">1 Bus 6:60</ref>. </char></note> Batabani ba Bekeri; Zemira, Yoasi, Eliezeeri, Elio-enai, Omuri, Yeremoosi, Abiya, Anatoosi na Alemeesi. <verse eid="1CH 7:8" /><verse number="9" style="v" sid="1CH 7:9" />Abo boona bakaba bari beene Bekeeri; omu kubarwa kw'okukuratana kw'oruzaaro rw'abakuru b'amaju ga baishenkurubo nk'oku kwabaire kuri, bakaba bari abarwani b'amaani obukumi bubiri na magana abiri. <verse eid="1CH 7:9" /><verse number="10" style="v" sid="1CH 7:10" />Mutabani wa Yedieli: Biluhaani: Yeushi, Benyamiini, Ehudi, Kenaana, Zesaani, Tarushiishi na Ahishahaari. <verse eid="1CH 7:10" /><verse number="11" style="v" sid="1CH 7:11" />Abo boona bakaba bari beene Yedieli; omu kubarwa kw'abakuru b'amaju ga baishenkurubo abashaija abarwani b'amaani baaba kakumi n'enkumi mushanju na magana abiri, abeeteekateekire kuza aha rugamba. <verse eid="1CH 7:11" /><verse number="12" style="v" sid="1CH 7:12" />Shupimu na Hupimu beene Iiri, Hushimu mwene Aheri.<verse eid="1CH 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 7:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:13: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 26:48-50">Kub 26:48-50</ref>. </char>
    </note> Batabani ba Nafutaali: Yahazieli, Guuni, Yezeri na Shalumu, ab'oruzaaro rwa Biliha. <verse eid="1CH 7:13" /><verse number="14" style="v" sid="1CH 7:14" /><note caller="-" style="x"><char style="xo" closed="false">7:14-19: </char><char style="xt" closed="false"><ref loc="NUM 26:29-33">Kub 26:29-33</ref>. </char></note> Batabani ba Manaase: Asirieli owaazairwe ekinyanshunju Omunyaaramu; kandi niwe yaazaire Makiri ishe wa Gileadi.<note caller="-" style="x"><char style="xo" closed="false">7:14: </char><char style="xt" closed="false"><ref loc="JOS 17:1">Yos 17:1</ref>. </char></note> <verse eid="1CH 7:14" /><verse number="15" style="v" sid="1CH 7:15" /><note caller="-" style="x"><char style="xo" closed="false">7:15: </char><char style="xt" closed="false"><ref loc="NUM 27:1">Kub 27:1</ref>; <ref loc="NUM 36:11">36:11</ref>. </char></note> Makiri yaashwererera Hupimu na Shupimu. Munyaanya akaba naayetwa Zelofehaadi; kandi Zelofehaadi ogwo akazaara abaishiki bonka. <verse eid="1CH 7:15" /><verse number="16" style="v" sid="1CH 7:16" />Maaka muka Makiri yaazaara omwana w'omwojo, yaamweta Pereshi; n'omurumuna akaba naayetwa Shereshi; batabani be baaba Ulamu na Rakemu. <verse eid="1CH 7:16" /><verse number="17" style="v" sid="1CH 7:17" /><note caller="-" style="x"><char style="xo" closed="false">7:17: </char><char style="xt" closed="false"><ref loc="1SA 12:11">1 Sam 12:11</ref>. </char></note> Mutabani wa Ulamu: Bedani. Abo nibo baabaire bari beene Gileadi mwene Makiri, mwijukuru wa Manaase. <verse eid="1CH 7:17" /><verse number="18" style="v" sid="1CH 7:18" />Hamolekesi munyaanya yaazaara Ishihoodi, Abiezeeri na Mahula. <verse eid="1CH 7:18" /><verse number="19" style="v" sid="1CH 7:19" />Batabani ba Shemida bakaba bari Ahiani, Shekemu, Likuhi na Aniamu.<verse eid="1CH 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 7:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:20: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 26:35">Kub 26:35</ref>. </char>
    </note> Batabani ba Efuraimu: Shuseela, mwene Shuseela ni Beredi, mwene Beredi ni Tahasi, mwene Tahasi ni Eleada, mwene Eleada ni Tahasi, <verse eid="1CH 7:20" /><verse number="21" style="v" sid="1CH 7:21" />mwene Tahasi ni Zabadi, mwene Zabadi ni Shuseela, kandi na Ezeri na Eleada abaitsirwe abashaija ba Gaasi abazaariirwe omuri egyo nsi, ahabw'okuba bakashuumayo kunyaga ente zaabo. <verse eid="1CH 7:21" /><verse number="22" style="v" sid="1CH 7:22" />Bwanyima Efuraimu ishebo yaamara ebiro bingi naabacurira, beene ishe baija kumugumya. <verse eid="1CH 7:22" /><verse number="23" style="v" sid="1CH 7:23" />Ku haahingwireho ebiro, Efuraimu yaabyama n'omukazi we, omukazi yaagira enda, yaazaara omwana w'omwojo, yaamweta Beria, ahakuba enju ye ekaguubwaho akabi. <verse eid="1CH 7:23" /><verse number="24" style="v" sid="1CH 7:24" /><note caller="-" style="x"><char style="xo" closed="false">7:24: </char><char style="xt" closed="false"><ref loc="JOS 10:10">Yos 10:10</ref>, <ref loc="JOS 10:11">11</ref>. </char></note> Muhara we akaba naayetwa Sheera owaayombekire Besi-horoni zombi, eya ifo n'eya uguru, na Uzene-sheera. <verse eid="1CH 7:24" /><verse number="25" style="v" sid="1CH 7:25" />Mutabani we ni Reefa, mwene Reefa ni Reshefu, mwene Reshefu ni Teela, mwene Teela ni Tahani, <verse eid="1CH 7:25" /><verse number="26" style="v" sid="1CH 7:26" /><note caller="-" style="x"><char style="xo" closed="false">7:26: </char><char style="xt" closed="false"><ref loc="NUM 1:10">Kub 1:10</ref>; <ref loc="NUM 7:48">7:48</ref>. </char></note> mwene Tahani ni Ladani, mwene Ladani ni Amihuudi, mwene Amihuudi ni Elishaama, <verse eid="1CH 7:26" /><verse number="27" style="v" sid="1CH 7:27" /><note caller="-" style="x"><char style="xo" closed="false">7:27: </char><char style="xt" closed="false"><ref loc="NUM 13:8">Kub 13:8</ref>, <ref loc="NUM 13:16">16</ref>. </char></note> mwene Elishaama ni Nuuni, mwene Nuuni ni Yoshua. <verse eid="1CH 7:27" /><verse number="28" style="v" sid="1CH 7:28" />Kandi ebibanja byabo n'ebi baabaire batungire bikaba biri Beseeli n'omu ndembo zaayo, aha bukiizi bw'oburugwa-izooba Narani, aha burengyerwa-izooba Gezeri n'endembo zaayo, Shekemu n'endembo zaayo na Aaza n'endembo zaayo; <verse eid="1CH 7:28" /><verse number="29" style="v" sid="1CH 7:29" /><note caller="-" style="x"><char style="xo" closed="false">7:29: </char><char style="xt" closed="false"><ref loc="JOS 17:7">Yos 17:7</ref>, <ref loc="JOS 17:11">11</ref>. </char></note> kandi n'aha myatano y'Abamanaase Besi-sheani n'endembo zaayo, Tanaki n'endembo zaayo na Doori n'endembo zaayo. Omuri ezo ndembo beene Yosefu mwene Israeli nimwo baabaire batwire.<verse eid="1CH 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="1CH 7:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:30: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:17">Kut 46:17</ref>; <ref loc="NUM 26:44">Kub 26:44</ref>. </char>
    </note> Batabani ba Ashera: Imuna, Ishuva, Ishuvi, Beria na munyaanya waabo Seera. <verse eid="1CH 7:30" /><verse number="31" style="v" sid="1CH 7:31" />Batabani ba Beria: Heberi na Malikieli owaabaire ari ishe wa Biruzaisi. <verse eid="1CH 7:31" /><verse number="32" style="v" sid="1CH 7:32" />Heberi yaazaara Yafuleeti, Shomeri, Hosamu na munyaanya waabo Shua. <verse eid="1CH 7:32" /><verse number="33" style="v" sid="1CH 7:33" />Batabani ba Yafuleeti Pasaki, Bimuhaali na Ashuvaati. Abo nibo beene Yafuleeti. <verse eid="1CH 7:33" /><verse number="34" style="v" sid="1CH 7:34" />Batabani ba Shemeri omurumuna: Rohuga, Yehuba, na Aramu. <verse eid="1CH 7:34" /><verse number="35" style="v" sid="1CH 7:35" />Batabani ba Helemu omurumuna: Zoofa, Imuna, Sheleshi na Amali. <verse eid="1CH 7:35" /><verse number="36" style="v" sid="1CH 7:36" />Batabani ba Zoofa: Sia, Harunefeeri, Shuali, Beeri, Imura, <verse eid="1CH 7:36" /><verse number="37" style="v" sid="1CH 7:37" />Bezeeri, Hoodi, Shama, Shilusha, Ituraani na Beera. <verse eid="1CH 7:37" /><verse number="38" style="v" sid="1CH 7:38" />Batabani ba Yeseri: Yefune, Pisupa na Araa. <verse eid="1CH 7:38" /><verse number="39" style="v" sid="1CH 7:39" />Batabani ba Uula: Aara, Hanieli na Rizia. <verse eid="1CH 7:39" /><verse number="40" style="v" sid="1CH 7:40" />Abo boona bakaba bari beene Asheri, abakuru b'amaju ga baishenkurubo, abashaija abarikusiimwa, abarwani b'amaani, abakuru b'abategyeki. Kandi omubaro ogw'abahandiikirwe kuza aha rugamba, nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri, gukaba guri obukumi bubiri n'enkumi mukaaga.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 8:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:21">Kut 46:21</ref>; <ref loc="NUM 26:38">Kub 26:38</ref>; <ref loc="1CH 7:6">1 Bus 7:6</ref>, <ref loc="1CH 7:12">12</ref>. </char>
    </note> Benyamiini yaajigaija Beela, yaakuratsaho Ashubeeli, owa kashatu yaaba Ahara, <verse eid="1CH 8:1" /><verse number="2" style="v" sid="1CH 8:2" />owa kana yaaba Nooha n'owa kataano yaaba Raafa. <verse eid="1CH 8:2" /><verse number="3" style="v" sid="1CH 8:3" />Beela nawe yaazaara abaana b'aboojo: Adari, Geera, Abihuudi, <verse eid="1CH 8:3" /><verse number="4" style="v" sid="1CH 8:4" /><note caller="-" style="x"><char style="xo" closed="false">8:4: </char><char style="xt" closed="false"><ref loc="NUM 26:40">Kub 26:40</ref>. </char></note> Abishua, Naamani, Ahoa, <verse eid="1CH 8:4" /><verse number="5" style="v" sid="1CH 8:5" />Geera, Shefufaani na Huraamu. <verse eid="1CH 8:5" /><verse number="6" style="v" sid="1CH 8:6" />Kandi aba nibo batabani ba Ehudi, (nibo babaire bari abakuru b'amaju ga baishenkuru b'abatuuzi ba Geeba, abaatwairwe omu bukwatwa, bakabata Manahaasi) <verse eid="1CH 8:6" /><verse number="7" style="v" sid="1CH 8:7" />Naamani, Ahiya na Geera, niwe Hegulaamu, ishe wa Uuza na Ahihuudi. <verse eid="1CH 8:7" /><verse number="8" style="v" sid="1CH 8:8" />Shaharaimu, ku yaaherize kushenda abakazi be Hushimu na Baara, yaazaarira abaana b'aboojo omu nsi ya Moabu. <verse eid="1CH 8:8" /><verse number="9" style="v" sid="1CH 8:9" />Yaazaara aha mukazi we Hodeshi abatabani, Yobabu, Zibia, Mesha, Malukaamu, <verse eid="1CH 8:9" /><verse number="10" style="v" sid="1CH 8:10" />Yeusi, Sakia na Miruma. Abo nibo batabani abaabaire bari abakuru b'amaju ga baishenkurubo. <verse eid="1CH 8:10" /><verse number="11" style="v" sid="1CH 8:11" />Kandi Hushimu abaana b'aboojo Ahitubu na Elipaali, <verse eid="1CH 8:11" /><verse number="12" style="v" sid="1CH 8:12" /><note caller="-" style="x"><char style="xo" closed="false">8:12: </char><char style="xt" closed="false"><ref loc="ACT 9:32">Byak 9:32</ref>, <ref loc="ACT 9:35">35</ref>, <ref loc="ACT 9:38">38</ref>. </char></note> Batabani ba Elipaali: Eberi, Mishamu, Shemedi owaayombekire Ono na Loodi n'endembo zaayo; <verse eid="1CH 8:12" /><verse number="13" style="v" sid="1CH 8:13" />Beria na Sheema abaabaire bari abakuru b'amaju ga baishenkurubo b'abatuuzi ba Ayalooni, abaagingire abatuuzi ba Gaasi, <verse eid="1CH 8:13" /><verse number="14" style="v" sid="1CH 8:14" />Ahio, Shashaki na Yeremoosi. <verse eid="1CH 8:14" /><verse number="15" style="v" sid="1CH 8:15" />Batabani ba Beria: Zebadia, Aradi, Ederi, <verse eid="1CH 8:15" /><verse number="16" style="v" sid="1CH 8:16" />Mikaeli, Ishupa na Yooha. <verse eid="1CH 8:16" /><verse number="17" style="v" sid="1CH 8:17" />Batabani ba Elipaali: Zebedia, Meshulaamu, Hizuki, Heberi, <verse eid="1CH 8:17" /><verse number="18" style="v" sid="1CH 8:18" />Ishimerai, Izulia na Yobabu. <verse eid="1CH 8:18" /><verse number="19" style="v" sid="1CH 8:19" />Batabani ba Shimei: Yahimu, Zikuri, Zabudi, <verse eid="1CH 8:19" /><verse number="20" style="v" sid="1CH 8:20" />Elienai, zilesai, Elieli, <verse eid="1CH 8:20" /><verse number="21" style="v" sid="1CH 8:21" />Adaya, Beraaya na Shimuraasi. <verse eid="1CH 8:21" /><verse number="22" style="v" sid="1CH 8:22" />Batabani ba Shashaki: Ishupaani, Eberi, Elieli, <verse eid="1CH 8:22" /><verse number="23" style="v" sid="1CH 8:23" />Abudooni, Zikuru, Hanani, <verse eid="1CH 8:23" /><verse number="24" style="v" sid="1CH 8:24" />Hanania, Elamu, Antosiya, <verse eid="1CH 8:24" /><verse number="25" style="v" sid="1CH 8:25" />Ifodwa na Penueli. <verse eid="1CH 8:25" /><verse number="26" style="v" sid="1CH 8:26" />Batabani ba Yerohaamu: Shamusherai, Sheharia, Atalia, <verse eid="1CH 8:26" /><verse number="27" style="v" sid="1CH 8:27" />Yareshia, Eliya na zikuri. <verse eid="1CH 8:27" /><verse number="28" style="v" sid="1CH 8:28" />Abo nibo baabaire bari abakuru b'amaju ga baishenkurubo, nk'oku kuratana kw'oruzaaro rwabo oku kwabaire kuri, abantu bakuru. Abo bakaba batwire Yerusaalemu. <verse eid="1CH 8:28" /><verse number="29" style="v" sid="1CH 8:29" /><note caller="-" style="x"><char style="xo" closed="false">8:29-32: </char><char style="xt" closed="false"><ref loc="1CH 9:25-38">1 Bus 9:25-38</ref>. </char></note> Yeyeli ishe wa Gibeoni akaba atwire Gibeoni, omukazi we akaba naayetwa Maaka. <verse eid="1CH 8:29" /><verse number="30" style="v" sid="1CH 8:30" />Omwana we w'omujigaijo akaba ari Abudooni, naakuratwa Zuuri, Kiishi, Baali, Nadabu, <verse eid="1CH 8:30" /><verse number="31" style="v" sid="1CH 8:31" />Gedori, Ahio, Zekeri <verse eid="1CH 8:31" /><verse number="32" style="v" sid="1CH 8:32" />na Mikuloosi owaazaire Shimea. Abo nabo bakaba batwire na beene waabo omuri Yerusaalemu nibareebana. <verse eid="1CH 8:32" /><verse number="33" style="v" sid="1CH 8:33" /><note caller="-" style="x"><char style="xo" closed="false">8:33-38: </char><char style="xt" closed="false"><ref loc="1CH 9:39-44">1 Bus 9:39-44</ref>. </char></note> Neeri yaazaara Kiishi, Kiishi yaazaara Saulo, Saulo yaazaara Yonasaani, Malikishua, Abinadabu na Eshibaali.<note caller="-" style="x"><char style="xo" closed="false">8:33: </char><char style="xt" closed="false"><ref loc="1SA 9:1">1 Sam 9:1</ref>; <ref loc="1SA 14:51">14:51</ref>; <ref loc="1CH 10:2">1 Bus 10:2</ref>. </char></note> <verse eid="1CH 8:33" /><verse number="34" style="v" sid="1CH 8:34" /><note caller="-" style="x"><char style="xo" closed="false">8:34: </char><char style="xt" closed="false"><ref loc="2SA 9:12">2 Sam 9:12</ref>. </char></note> Yonasaani yaazaara Meribubaali, Meribu-baali yaazaara Miika. <verse eid="1CH 8:34" /><verse number="35" style="v" sid="1CH 8:35" />Batabani ba Miika: Pisoni, Meleki, Tarea na Ahazi. <verse eid="1CH 8:35" /><verse number="36" style="v" sid="1CH 8:36" />Ahazi yaazaara Yehoada, Yehoada yaazaara Alemeesi, Azimaveesi na Zimuri, Zimuri yaazaara Mooza, <verse eid="1CH 8:36" /><verse number="37" style="v" sid="1CH 8:37" />Mooza yaazaara Binea; mwene Binea ni Raafa, mwene Raafa ni Eleasa, mwene Eleasa ni Azeeli. <verse eid="1CH 8:37" /><verse number="38" style="v" sid="1CH 8:38" />Azeeli akaba aine aboojo mukaaga, n'amaziina gaabo nigo aga, Azurikaamu, Bokeru, Ishimaeli, Shearia, Obadia na Hanani. Abo boona ni beene Azeeli. <verse eid="1CH 8:38" /><verse number="39" style="v" sid="1CH 8:39" />Beene Esheki omurumuna: Ulaamu omujigaijo gwe, omushubiro Yeushi, n'owa kashatu Elifeleti. <verse eid="1CH 8:39" /><verse number="40" style="v" sid="1CH 8:40" />Beene Ulaamu bakaba bari abarwani b'amaani, enkwata-mata, kandi bakaba baine abatabani n'abaijukuru baingi, omubaro gwabo guri igana na makumi ataano. Abo boona bakaba bari Ababenyamiini.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 5:25">1 Bus 5:25</ref>, <ref loc="1CH 5:26">26</ref>. </char>
    </note> Batyo Abaisraeli boona bakabarwa nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri; kandi bahandiikirwe omu kitabo ky'eby'omu busingye bw'abagabe ba Israeli. Bwanyima Abayuda baatwarwa Babulooni omu bukwatwa ahabw'ebicumuro byabo. <verse eid="1CH 9:1" /><verse number="2" style="v" sid="1CH 9:2" /><note caller="-" style="x"><char style="xo" closed="false">9:2-22: </char><char style="xt" closed="false"><ref loc="NEH 11:3-22">Neh 11:3-22</ref>. </char></note> Abaabandize kugaruka kutuura omu buhunguzi bwabo n'omu ndembo zaabo bakaba bari Abaisraeli, abanyamurwa, Abaleevi n'abaheereza b'omuri hekalu.<note caller="-" style="x"><char style="xo" closed="false">9:2: </char><char style="xt" closed="false"><ref loc="JOS 9:27">Yos 9:27</ref>; <ref loc="EZR 2:43">Ezr 2:43</ref>, <ref loc="EZR 2:70">70</ref>; <ref loc="EZR 8:20">8:20</ref>; <ref loc="NEH 7:60">Neh 7:60</ref>, <ref loc="NEH 7:73">73</ref>. </char></note> <verse eid="1CH 9:2" /><verse number="3" style="v" sid="1CH 9:3" />Kandi bamwe aha Bayuda, Ababenyamiini, Abaefuraimu n'Abamanaase bakatuura omuri Yerusaalemu; <verse eid="1CH 9:3" /><verse number="4" style="v" sid="1CH 9:4" />Usai mwene Amihuudi, Amihuudi ya Omuri, Omuri ya Baani, ab'omuri beene Pereezi mwene Yuda. <verse eid="1CH 9:4" /><verse number="5" style="v" sid="1CH 9:5" />N'aba Shiilo: omujigaijo gwe ni Asaaya n'abatabani. <verse eid="1CH 9:5" /><verse number="6" style="v" sid="1CH 9:6" />Ab'omuri batabani ba Zeera: Yeuli na beene waabo magana mukaaga na makumi mwenda. <verse eid="1CH 9:6" /><verse number="7" style="v" sid="1CH 9:7" />Ab'omuri beene Benyamiini: Saalu mwene Meshulaamu ya Hodavia, Hodavia ya Hasenua, <verse eid="1CH 9:7" /><verse number="8" style="v" sid="1CH 9:8" />na Ibunea mwene Yerohaamu, na Eela mwene Uuzi ya Makiri, na Meshulaamu mwene Shefatia ya Reuli mwene Ibunia; <verse eid="1CH 9:8" /><verse number="9" style="v" sid="1CH 9:9" /><note caller="-" style="x"><char style="xo" closed="false">9:9: </char><char style="xt" closed="false"><ref loc="2CH 35:4">2 Bus 35:4</ref>, <ref loc="2CH 35:5">5</ref>; <ref loc="NEH 11:8">Neh 11:8</ref>. </char></note> na beene waabo nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri, bakaba bari magana mwenda na makumi ataano na mukaaga. Abo boona bakaba bari abakuru b'amaju ga baishenkurubo, nk'oku gaabaire gari.<verse eid="1CH 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 9:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 9:10-13">1 Bus 9:10-13</ref>; <ref loc="NEH 11:10-14">Neh 11:10-14</ref>. </char>
    </note> Ab'omu banyamurwa: Yedaaya, Yehoyaribu, Yakiini. <verse eid="1CH 9:10" /><verse number="11" style="v" sid="1CH 9:11" /><note caller="-" style="x"><char style="xo" closed="false">9:11: </char><char style="xt" closed="false"><ref loc="JER 20:1">Yer 20:1</ref>; <ref loc="ACT 4:1">Byak 4:1</ref>. </char></note> Azaria mwene Hilukia ya Meshulaamu, Meshulaamu ya Zadoki, Zadoki ya Merayosi, Merayosi ya Ahitubu, omukuru w'enju ya Ruhanga; <verse eid="1CH 9:11" /><verse number="12" style="v" sid="1CH 9:12" />na Adaaya mwene Yerohaamu, Yerohaamu ya Pashihuuri, Pashihuuri ya Malikia; na Masai mwene Adieli ya Yahuzeera, Yahuzeera ya Meshulaamu, Meshulaamu ya Meshilemiisi mwene Imeri, <verse eid="1CH 9:12" /><verse number="13" style="v" sid="1CH 9:13" />otabariiremu beene waabo, abakuru b'amaju ga baishenkurubo, rukumi na magana mushanju na makumi mukaaga, abashaija abarikubaasiza kimwe kukora omurimo gw'enju ya Ruhanga.<verse eid="1CH 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 9:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:14-17: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 11:15-19">Neh 11:15-19</ref>. </char>
    </note> Ab'omu Baleevi: Shemaaya mwene Hashubu ya Azurikaamu, Azurikaamu ya Hashabia ab'omuri beene Merari; <verse eid="1CH 9:14" /><verse number="15" style="v" sid="1CH 9:15" />na Bakubakari, Hereshi, Galali, na Matania mwene Miika ya zikuri mwene Asafu; <verse eid="1CH 9:15" /><verse number="16" style="v" sid="1CH 9:16" />na Obadia mwene Shemaaya ya Galali, Galali ya Yedusiini, Yedusuuni ya Berekia, Berekia ya Aasa mwene Elukaana abaabaire batwire omu birorero by'aba Netofaasi.<verse eid="1CH 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 9:17" />Abakumiirizi b'amarembo: Shalumu, Akubu, Talumooni, Ahimaanu na beene waabo, (kandi Shalumu niwe yaabaire ari mukuru) <verse eid="1CH 9:17" /><verse number="18" style="v" sid="1CH 9:18" /><note caller="-" style="x"><char style="xo" closed="false">9:18: </char><char style="xt" closed="false"><ref loc="EZK 46:1">Ezk 46:1</ref>, <ref loc="EZK 46:2">2</ref>. </char></note> abaabaire batuura aha irembo ry'omugabe ery'aha bukiizi bw'oburugwa-izooba n'okuhitsya hati. Kandi abo nibo baabaire bari abakumiirizi b'eirembo ry'orusiisira rw'Abaleevi. <verse eid="1CH 9:18" /><verse number="19" style="v" sid="1CH 9:19" /><note caller="-" style="x"><char style="xo" closed="false">9:19: </char><char style="xt" closed="false"><ref loc="NUM 26:58">Kub 26:58</ref>; <ref loc="1CH 12:6">1 Bus 12:6</ref>; <ref loc="2CH 20:19">2 Bus 20:19</ref>. </char></note> Shalumu mwene Koore ya Eliasaafu mwene Koora na beene waabo ab'enju ya ishenkuru, aba Koora, nibo baabaire bakwatsiibwe omurimo gw'okuheereza, nigwo gw'okurinda omuryango gw'Eihema, nka baishenkurubo oku baabaire bakwatsiibwe orusiisira rwa MUKAMA nibarinda eirembo ryarwo. <verse eid="1CH 9:19" /><verse number="20" style="v" sid="1CH 9:20" /><note caller="-" style="x"><char style="xo" closed="false">9:20: </char><char style="xt" closed="false"><ref loc="NUM 25:11-13">Kub 25:11-13</ref>. </char></note> Na Finehaasi mwene Eleazaari niwe yaabaire naabategyeka omu bya ira; kandi MUKAMA akaba ari hamwe nawe. <verse eid="1CH 9:20" /><verse number="21" style="v" sid="1CH 9:21" />Zekaria mwene Meshelemia niwe yaabaire ari omukumiirizi aha irembo ry'Eihema ry'okubugaabuganiramu. <verse eid="1CH 9:21" /><verse number="22" style="v" sid="1CH 9:22" /><note caller="-" style="x"><char style="xo" closed="false">9:22: </char><char style="xt" closed="false"><ref loc="1CH 26:1">1 Bus 26:1</ref>, <ref loc="1CH 26:19">19</ref>; <ref loc="2CH 31:15">2 Bus 31:15</ref>, <ref loc="2CH 31:18">18</ref>. </char></note> Abo boona abaatoorainwe kuba abakumiirizi b'amarembo bakaba bari magana abiri na ikumi na babiri. Kandi bakaba bahandiikirwe omu birorero byabo, nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri. Abo nibo Daudi na Samueli omuhanuuzi baahamize omu murimo gwabo ogw'obwesigwa. <verse eid="1CH 9:22" /><verse number="23" style="v" sid="1CH 9:23" />N'ahabw'ekyo bo n'abatabani baabo baakwatsibwa omurimo gw'okurinda amarembo g'enju ya MUKAMA, niyo nju y'Eihema. <verse eid="1CH 9:23" /><verse number="24" style="v" sid="1CH 9:24" />Abo bakumiirizi baaguma nibaza aha mbaju zaayo ina, orw'oburugwa-izooba, orw'oburengyerwa-izooba, orw'obukiizi-bwa-bumosho n'obwa-buryo; <verse eid="1CH 9:24" /><verse number="25" style="v" sid="1CH 9:25" /><note caller="-" style="x"><char style="xo" closed="false">9:25: </char><char style="xt" closed="false"><ref loc="2KI 11:5">2 Bag 11:5</ref>. </char></note> kandi beene waabo ab'omu birorero byabo bakaba nibaragiirwa kwija buri biro mushanju kuguma nabo; <verse eid="1CH 9:25" /><verse number="26" style="v" sid="1CH 9:26" /><note caller="-" style="x"><char style="xo" closed="false">9:26: </char><char style="xt" closed="false"><ref loc="1KI 6:5">1 Bag 6:5</ref>, <ref loc="1KI 6:8">8</ref>. </char></note> ahabw'okuba abo bakumiirizi bakuru bana, abaabaire bari Abaleevi, bakaba baguma aha murimo gwabo batarikwihwa; kandi nibo baabaire bakwatsiibwe ebishengye n'amabiikoro eby'omu nju ya Ruhanga; <verse eid="1CH 9:26" /><verse number="27" style="v" sid="1CH 9:27" /><note caller="-" style="x"><char style="xo" closed="false">9:27: </char><char style="xt" closed="false"><ref loc="NUM 1:53">Kub 1:53</ref>. </char></note> baraara beehinguririze egyo nju ya Ruhanga, ahakuba omurimo gwabo gukaba guri okugirinda n'okugiigura buri kasheeshe.<verse eid="1CH 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28" />Abamwe omuribo bakaba bakwatsiibwe ebintu by'obuheereza; ahakuba bakaba nibaragiirwa kubibara omu kubitaasya n'omu kubishohoza. <verse eid="1CH 9:28" /><verse number="29" style="v" sid="1CH 9:29" /><note caller="-" style="x"><char style="xo" closed="false">9:29: </char><char style="xt" closed="false"><ref loc="LEV 6:20">Lev 6:20</ref>, <ref loc="LEV 6:21">21</ref>; <ref loc="1CH 23:29">1 Bus 23:29</ref>. </char></note> Abandi omuribo bakaba bakwatsiibwe ebintu by'omu Butaaho n'ebintu byona ebirikwera eby'okukoresa, kandi n'esaano y'obunono, viinyo, amajuta, obubaane n'emigaju. <verse eid="1CH 9:29" /><verse number="30" style="v" sid="1CH 9:30" /><note caller="-" style="x"><char style="xo" closed="false">9:30: </char><char style="xt" closed="false"><ref loc="EXO 30:23-35">Kur 30:23-35</ref>. </char></note> Abandi ab'omuri batabani b'abanyamurwa bakaba bajwanzya emigaju, <verse eid="1CH 9:30" /><verse number="31" style="v" sid="1CH 9:31" /><note caller="-" style="x"><char style="xo" closed="false">9:31: </char><char style="xt" closed="false"><ref loc="NUM 26:58">Kub 26:58</ref>; <ref loc="1CH 12:6">1 Bus 12:6</ref>; <ref loc="1CH 23:29">23:29</ref>. </char></note> kandi Matisia ow'omu Baleevi omujigaijo gwa Shalumu ow'omu ba Koora niwe yaabaire akwatsiibwe omurimo gw'okureeberera ebirikukarangwa aha byoma. <verse eid="1CH 9:31" /><verse number="32" style="v" sid="1CH 9:32" /><note caller="-" style="x"><char style="xo" closed="false">9:32: </char><char style="xt" closed="false"><ref loc="LEV 24:5-8">Lev 24:5-8</ref>. </char></note> Kandi n'abandi omuri beene waabo b'Abakohasi nibo baabaire bakwatsiibwe omurimo gw'emigaati y'okumurikwa, okugitebeekanisa buri Sabato.<verse eid="1CH 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:33: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 6:31">1 Bus 6:31</ref>; <ref loc="1CH 25:1">25:1</ref>; <ref loc="PSA 134:1">Zab 134:1</ref>. </char>
    </note> Kandi hakaba hariho abeeshongozi, abakuru b'amaju ga baishenkuru b'Abaleevi, abaabaire bataaha omu bishengye by'omuri hekalu, bataine gundi murimo, ahabw'okuba bakaba bagira omurimo gwabo nyomushana na nyekiro. <verse eid="1CH 9:33" /><verse number="34" style="v" sid="1CH 9:34" />Abo nibo baabaire bari bakuru b'amaju ga baishenkuru b'Abaleevi, nk'okukuratana kw'oruzaaro rwabo oku kwabaire kuri, abantu bakuru abaabaire batuura omuri Yerusaalemu.<verse eid="1CH 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CH 9:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:35-38: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 8:29-32">1 Bus 8:29-32</ref>. </char>
    </note> Omuri Gibeoni hakaba hatuuramu Yeyeli ishe wa Gibeoni, omukazi we akaba naayetwa Maaka; <verse eid="1CH 9:35" /><verse number="36" style="v" sid="1CH 9:36" />omutabani ow'omujigaijo akaba ari Abudooni, naakuratwa Zuuri, Kiishi, Baali, Neeri, Nadabu, <verse eid="1CH 9:36" /><verse number="37" style="v" sid="1CH 9:37" />Gedori, Ahio, Zekaria na Mikuloosi; <verse eid="1CH 9:37" /><verse number="38" style="v" sid="1CH 9:38" />Mikuloosi yaazaara Shimeamu; abo nabo bakaba batwire na beene waabo omuri Yerusaalemu, amaka gaabo nigareebana. <verse eid="1CH 9:38" /><verse number="39" style="v" sid="1CH 9:39" /><note caller="-" style="x"><char style="xo" closed="false">9:39-44: </char><char style="xt" closed="false"><ref loc="1CH 8:33-38">1 Bus 8:33-38</ref>. </char></note> Neeri yaazaara Kiishi, Kiishi yaazaara Saulo, Saulo yaazaara Yonasaani, Yonasaani yaazaara Melikishua, Abinadabu na Eshibaali; <verse eid="1CH 9:39" /><verse number="40" style="v" sid="1CH 9:40" />mwene Yonasaani akaba ari Meribu-baali, Meribu-baali yaazaara Miika. <verse eid="1CH 9:40" /><verse number="41" style="v" sid="1CH 9:41" />Batabani ba Miika: Pisoni, Meleki, Tahurea na Ahazi; <verse eid="1CH 9:41" /><verse number="42" style="v" sid="1CH 9:42" />Ahazi yaazaara Yaara, Yaara yaazaara Alimeesi, Azimaveesi na Zimuri; Zimuri yaazaara Mooza. <verse eid="1CH 9:42" /><verse number="43" style="v" sid="1CH 9:43" />Mooza yaazaara Binea, Binea yaazaara Refaaya, Refaaya yaazaara Eleasa, Eleasa yaazaara Azeeli. <verse eid="1CH 9:43" /><verse number="44" style="v" sid="1CH 9:44" />Azeeli yaazaara abaana b'aboojo mukaaga, n'amaziina gaabo nigo aga: Azurikaamu, Bokeru, Ishimaeli, Shearia, Obadia na Hanani; abo nibo beene Azeeli.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">Okufa kwa Saulo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:1-12: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 31:1-13">1 Sam 31:1-13</ref>. </char>
    </note> Omu biro ebyo Abafilistia bakarwanisa Abaisraeli, Abaisraeli baabahunga, baitirwa aha kibungo kya Giliboa. <verse eid="1CH 10:1" /><verse number="2" style="v" sid="1CH 10:2" />Abafilistia baahambya Saulo n'abatabani, baita Yonasaani, Abinadabu na Malikishua beene Saulo. <verse eid="1CH 10:2" /><verse number="3" style="v" sid="1CH 10:3" />Orugamba rwaba orw'amaani ahari Saulo, abarasi baamugwaho, baamuhutaaza. <verse eid="1CH 10:3" /><verse number="4" style="v" sid="1CH 10:4" />Saulo nikwo kugira omukwatsi w'eby'okurwanisa bye, ati: Ihayo rurara yaawe, oginteere, bariya bashaija batashazirwe batakaija, bakanshungisa. Kwonka omukwatsi w'eby'okurwanisa bye yaayanga, ahabw'okuba akatiina mononga. Nikyo Saulo yaasyoreireyo rurara ye, akagyetungaho. <verse eid="1CH 10:4" /><verse number="5" style="v" sid="1CH 10:5" />Ogwo mukwatsi w'eby'okurwanisa bye, ku yaareebire yaafa, nawe yaayetunga aha ye, yaafa. <verse eid="1CH 10:5" /><verse number="6" style="v" sid="1CH 10:6" />Okwo nikwo Saulo yaafiire; we n'abatabani bonshatu n'ab'omu ka ye boona bakafeera hamwe. <verse eid="1CH 10:6" /><verse number="7" style="v" sid="1CH 10:7" />Kandi Abaisraeli boona abaabaire bari omu ruhita, ku baareebire eihe ryahunga, na Saulo n'abatabani baafa, baatsigaho endembo zaabo, baahunga, Abafilistia baija baazituuramu.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8" />Ku bwaseesire, Abafilistia baija kucwijura emitumbi, baashanga Saulo n'abatani bagwire aha kibungo kya Giliboa, <verse eid="1CH 10:8" /><verse number="9" style="v" sid="1CH 10:9" />baamucwijura, baamucwaho omutwe, baatwara eby'okurwanisa bye, baatuma entumwa omu nsi yaabo yoona kubuzya amakuru omuri hekalu z'ebishushani byabo ebirikuramibwa. <verse eid="1CH 10:9" /><verse number="10" style="v" sid="1CH 10:10" />Eby'okurwanisa bye baabita omuri nyaruju za baaruhanga baabo, n'omutwe gwe baaguhanika omuri hekalu ya Dagoni. <verse eid="1CH 10:10" /><verse number="11" style="v" sid="1CH 10:11" />Kwonka aba Yabeshi-gileadi boona, ku baahuriire oku Abafilistia baagizire Saulo, <verse eid="1CH 10:11" /><verse number="12" style="v" sid="1CH 10:12" />abashaija boona amamanzi baimuka, baihayo omutumbi gwa Saulo n'ey'abatabani, baagitwara Yabeshi. Bwanyima baaziika amagufa gaabo ahansi y'omwela ogw'omuri Yabeshi, baamara ebiro mushanju nibeesiibyakwo.<verse eid="1CH 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:13: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 13:13">1 Sam 13:13</ref>, <ref loc="1SA 13:14">14</ref>; <ref loc="1SA 15">15</ref>; <ref loc="1SA 23">23</ref>; <ref loc="1SA 28:7">28:7</ref>. </char>
    </note> Okwo nikwo Saulo yaafiire ahabw'ekicumuro kye, eki yaacumwire ahari MUKAMA; ahabw'okuba taroorobeire kigambo kya MUKAMA, kandi akeehanuuza aha muntu orikugambisa emizimu, <verse eid="1CH 10:13" /><verse number="14" style="v" sid="1CH 10:14" /><note caller="-" style="x"><char style="xo" closed="false">10:14: </char><char style="xt" closed="false"><ref loc="1SA 15:28">1 Sam 15:28</ref>; <ref loc="1SA 28:6">28:6</ref>; <ref loc="2SA 3:9">2 Sam 3:9</ref>, <ref loc="2SA 3:10">10</ref>. </char></note> yaayanga kwehanuuza ahari MUKAMA. Nikyo MUKAMA yaamwitiire, obugabe akabuha Daudi mwene Yese.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">Abaisraeli okwemeka Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1-9: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 5:1-3">2 Sam 5:1-3</ref>, <ref loc="2SA 5:6-10">6-10</ref>. </char>
    </note> Bwanyima Abaisraeli boona baateeranira ahari Daudi omuri Heburooni, baamugira bati: Reeba turi eigufa ryawe kandi omubiri gwawe. <verse eid="1CH 11:1" /><verse number="2" style="v" sid="1CH 11:2" />Omu biro ebyahingwire, Saulo akiri omugabe, niiwe waabaire oyebembera Abaisraeli nibahurura kandi MUKAMA Ruhanga waawe akakugira ati: Niiwe oriba omuriisa w'abantu bangye Israeli, kandi niiwe oriba mugabe waabo. <verse eid="1CH 11:2" /><verse number="3" style="v" sid="1CH 11:3" /><note caller="-" style="x"><char style="xo" closed="false">11:3: </char><char style="xt" closed="false"><ref loc="1SA 16:1">1 Sam 16:1</ref>, <ref loc="1SA 16:3">3</ref>, <ref loc="1SA 16:12">12</ref>, <ref loc="1SA 16:13">13</ref>; <ref loc="1CH 11:10">1 Bus 11:10</ref>; <ref loc="1CH 12:23">12:23</ref>. </char></note> Batyo abakuru ba Israeli boona baija aha mugabe omuri Heburooni, kandi okwo niyo yaaraganiire nabo endagaano omu maisho ga MUKAMA, bakamushukaho amajuta kuba omugabe wa Israeli, nk'ekigambo kya MUKAMA oku kyabaire kiri eki yaagambire naaraba omuri Samueli.<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4" />Bwanyima Daudi n'Abaisraeli boona baaza Yerusaalemu, niyo Yebusi, ahu Abayebusi abatuuzi b'omuri egyo nsi baabaire bari. <verse eid="1CH 11:4" /><verse number="5" style="v" sid="1CH 11:5" />Abayebusi baagira Daudi bati: Otaija aha. Kwonka Daudi yaakwata ekigo kya Saayuuni, nirwo rurembo rwa Daudi. <verse eid="1CH 11:5" /><verse number="6" style="v" sid="1CH 11:6" /><note caller="-" style="x"><char style="xo" closed="false">11:6: </char><char style="xt" closed="false"><ref loc="2SA 8:16">2 Sam 8:16</ref>. </char></note> Kandi Daudi akaba agizire ati: Oraabanze kuteera aba Yebusi, niwe araabe omutware kandi omukuru w'engabo. Yoabu mwene Zeruiya yaaba niwe yaabanza kwinamukayo; n'ahabw'ekyo yaaba omutware. <verse eid="1CH 11:6" /><verse number="7" style="v" sid="1CH 11:7" />Daudi yaatuura omuri ekyo kigo, nikyo kyayeteirwe orurembo rwa Daudi. <verse eid="1CH 11:7" /><verse number="8" style="v" sid="1CH 11:8" />Yaakyombekaho amaju okuruga Miilo n'okukyehinguriririza kimwe; kandi Yoabu yaahunduuza ekicweka ky'orurembo ekyatsigaireho. <verse eid="1CH 11:8" /><verse number="9" style="v" sid="1CH 11:9" />Daudi yaaguma naayeyongyera kugira ekitiinisa; ahakuba MUKAMA Ruhanga ow'amahe akaba ari hamwe nawe.<verse eid="1CH 11:9" /></para>
  <para style="s1">Amamanzi ga Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:10-41: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 23:8-39">2 Sam 23:8-39</ref>; <ref loc="1CH 11:3">1 Bus 11:3</ref>. </char>
    </note> Aba nibo baabaire bari bakuru omu mamanzi ga Daudi abaamuhaire munonga emikono omu bugabe bwe, bakakwatanisa n'Abaisraeli boona kumwemeka, nk'ekigambo kya MUKAMA eki yaagambire ahari Israeli oku kyabaire kir. <verse eid="1CH 11:10" /><verse number="11" style="v" sid="1CH 11:11" /><note caller="-" style="x"><char style="xo" closed="false">11:11: </char><char style="xt" closed="false"><ref loc="1CH 12:18">1 Bus 12:18</ref>. </char></note> Ebi nibyo birikugambwa aha mamanzi agu Daudi yaabaire aine. Yashobeamu owa Hakimooni niwe yaabaire ari mukuru omuri abo abashatu; akakwata eicumu rye, yaariitsa abantu magana ashatu omurundi gumwe.<verse eid="1CH 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:12: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 27:4">1 Bus 27:4</ref>. </char>
    </note> Owaabaire naamukurata omuri ago mamanzi ashatu ni Eleazaari mwene Dodo, mwijukuru wa Ahohi. <verse eid="1CH 11:12" /><verse number="13" style="v" sid="1CH 11:13" />Akaba ari hamwe na Daudi Pasidamimu, obu Abafilistia baateeranirayo kurwana. Okwo hakaba hariyo omusiri gwa sayiri nyingi; Abaisraeli baahunga Abafilistia; <verse eid="1CH 11:13" /><verse number="14" style="v" sid="1CH 11:14" />kwonka we yaayemerera omuri ogwo musiri, yaagurwanaho, yaita Abafilistia; MUKAMA yaabajunisa okusingura kw'amaani.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15" />Bashatu omu bashaija bakuru makumi ashatu baashuuma, baashanga Daudi aha rukiri omu nyanga ya Adulaamu; obwo eihe ry'Abafilistia rikaba risiisiire omu ruhita rwa Reefa, <verse eid="1CH 11:15" /><verse number="16" style="v" sid="1CH 11:16" />Daudi ari omu kigo, n'omutwe gw'engabo z'Abafilistia guri Betelehemu. <verse eid="1CH 11:16" /><verse number="17" style="v" sid="1CH 11:17" />Daudi yaatenga, yaagira ati: Nkaabaasibwa ki, hagira owampa otwizi tw'omu iziba eriri aha irembo rya Betelehemu, ntunywa! <verse eid="1CH 11:17" /><verse number="18" style="v" sid="1CH 11:18" />Ahonaaho ago mamanzi ashatu gaayataguza omu rusiira rw'Abafilistia, gaataha amaizi g'omuri eryo iziba rya Betelehemu, eryabaire riri aha irembo, baagatwarira Daudi. Kwonka Daudi yaayanga kuganywa, kureka yaagashuka omu maisho ga MUKAMA; <verse eid="1CH 11:18" /><verse number="19" style="v" sid="1CH 11:19" />yaagira ati: Nikikabure nyowe okukora eki omu maisho ga Ruhanga wangye! Nimbaasa kunywa eshagama y'aba bashaija baayoga amagara gaabo? Ahakuba baagareeta ahabw'okwoga amagara. Ekyo nikyo yaayangiire kuganywa. Ebyo nibyo ago mamanzi gaakozire.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20" />Kandi Abishai mukuru wa Yoabu niwe yaabaire ari mukuru omu mamanzi makumi ashatu. Akakwata eicumu rye, yaarwana n'abashaija magana ashatu, yaabaita, yaarangaanwa nk'abo abashatu. <verse eid="1CH 11:20" /><verse number="21" style="v" sid="1CH 11:21" />Omuri abo makumi ashatu niwe yaakizire kurangaanwa, akahinduka mukuru waabo; kwonka tiyaahika hari abo abashatu.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22" />Kandi Benaaya mwene Yehoyaada owa Kabuzieli, owaabaire ari emanzi, akakora eby'amaani, yaita b'Arieli babiri aba Moabu. Kandi aha izooba rimwe omu biro by'ebirika akashuuma, yaitira entare omu kiina. <verse eid="1CH 11:22" /><verse number="23" style="v" sid="1CH 11:23" /><note caller="-" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="1SA 17:7">1 Sam 17:7</ref>. </char></note> Kandi yaita Omunyamisri muraingwa munonga, oburaingwa bwe mikono etaano. Ogwo Munyamisri akaba aine eicumu omu ngaro, orubango rwaryo ruri nk'empimbi ei barukiraho emyenda; yaamushuumira n'enkoni, yaamusikura eryo icumu omu ngaro, yaarimwitsa. <verse eid="1CH 11:23" /><verse number="24" style="v" sid="1CH 11:24" />Ebyo nibyo Benaaya mwene Yehoyaada yaakozire, akarangaanwa nk'abo abashatu ab'amaani. <verse eid="1CH 11:24" /><verse number="25" style="v" sid="1CH 11:25" />Yaarangaanwa omuri abo makumi ashatu, kwonka tiyaahika hari bari abashatu. Daudi yaamuhindura omukuru w'abarinzi be. <verse eid="1CH 11:25" /><verse number="26" style="v" sid="1CH 11:26" /><note caller="-" style="x"><char style="xo" closed="false">11:26: </char><char style="xt" closed="false"><ref loc="1CH 27:7">1 Bus 27:7</ref>. </char></note> Kandi ago mamanzi g'omu mahe nigo aga–Asaheeli murumuna wa Yoabu, Elihanani mwene Dodo owa Betelehemu, <verse eid="1CH 11:26" /><verse number="27" style="v" sid="1CH 11:27" />Shamosi owa Harodi, Helezi owa Pelooni, <verse eid="1CH 11:27" /><verse number="28" style="v" sid="1CH 11:28" />Iira mwene Ikeshi owa Tekoa, Abiezeeri owa Anatoosi, <verse eid="1CH 11:28" /><verse number="29" style="v" sid="1CH 11:29" />Sibekai owa Hushati, Ilai owa Ahohi, <verse eid="1CH 11:29" /><verse number="30" style="v" sid="1CH 11:30" />Maharai owa Netofa, Heleda mwene Baana owa Netofa, <verse eid="1CH 11:30" /><verse number="31" style="v" sid="1CH 11:31" />Itai mwene Ribai owa Gibea ey'Ababenyamiini, Benaaya owa Piratooni, <verse eid="1CH 11:31" /><verse number="32" style="v" sid="1CH 11:32" />Hurai ow'aha tugyera twa Gaashi, Abieli owa Arubaasi, <verse eid="1CH 11:32" /><verse number="33" style="v" sid="1CH 11:33" />Azimaveesi owa Baharamu, Eliahuba owa Shalibooni, <verse eid="1CH 11:33" /><verse number="34" style="v" sid="1CH 11:34" />Hashemi owa Gizooni, Yonasaani mwene Shageri owa Harari, <verse eid="1CH 11:34" /><verse number="35" style="v" sid="1CH 11:35" />Ahiamu mwene Sakeri owa Harari, Elifaali mwene Uuri, <verse eid="1CH 11:35" /><verse number="36" style="v" sid="1CH 11:36" />Heferi owa Mekeraasi, Ahiya owa Peloni <verse eid="1CH 11:36" /><verse number="37" style="v" sid="1CH 11:37" />Hezero owa Karumeeli, Narai mwene Ezubai, <verse eid="1CH 11:37" /><verse number="38" style="v" sid="1CH 11:38" /><note caller="-" style="x"><char style="xo" closed="false">11:38: </char><char style="xt" closed="false"><ref loc="1CH 5:10">1 Bus 5:10</ref>. </char></note> Yeli murumuna wa Nasani, Mibuhaari mwene Haguri, <verse eid="1CH 11:38" /><verse number="39" style="v" sid="1CH 11:39" />Zeleki Omuano, Naharai owa Beeroosi, owaabaire ari omukwatsi w'eby'okurwanisa bya Yoabu mwene Zeruiya, <verse eid="1CH 11:39" /><verse number="40" style="v" sid="1CH 11:40" />Iira owa Ituri, Garebu owa Ituri, <verse eid="1CH 11:40" /><verse number="41" style="v" sid="1CH 11:41" />Uriya Omuhiiti, Zabadi mwene Ahulai, <verse eid="1CH 11:41" /><verse number="42" style="v" sid="1CH 11:42" />Adina mwene Shiza Omureubeeni omwebembezi w'Abareubeeni, owaizire n'abantu makumi ashatu, <verse eid="1CH 11:42" /><verse number="43" style="v" sid="1CH 11:43" />Hanani mwene Maaka, Yoshafati owa Misuuni, <verse eid="1CH 11:43" /><verse number="44" style="v" sid="1CH 11:44" />Uziya owa Ashitaroosi, Shama na Yeyeli beene Hosamu owa Aroeri, <verse eid="1CH 11:44" /><verse number="45" style="v" sid="1CH 11:45" />Yediaeli mwene Shimuri, n'omurumuna Yooha owa Tiizi, <verse eid="1CH 11:45" /><verse number="46" style="v" sid="1CH 11:46" />Elieli owa Mahavi, Yeribai na Yoshavia beene Elunaamu, Ituma Omumoabu, <verse eid="1CH 11:46" /><verse number="47" style="v" sid="1CH 11:47" />Elieli, Obedi na Yasieli owa Mezoba.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">Abandi abaahaire Daudi emikono</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 27:2-6">1 Sam 27:2-6</ref>. </char>
    </note> Aba nibo baashangire Daudi Zikulaagi, obu yaabaire ayesherekire Saulo mwene Kiishi; nabo bakaba bari ab'omu mamanzi agaamuhaire emikono omu bweme. <verse eid="1CH 12:1" /><verse number="2" style="v" sid="1CH 12:2" /><note caller="-" style="x"><char style="xo" closed="false">12:2: </char><char style="xt" closed="false"><ref loc="JDG 20:16">Bar 20:16</ref>; <ref loc="1CH 12:29">1 Bus 12:29</ref>; <ref loc="2CH 17:17">2 Bus 17:17</ref>; <ref loc="PSA 78:9">Zab 78:9</ref>. </char></note> Bakaba nibamanya kurwanisa amata, kandi nibatwara emikono yombi omu kurekyera enjungu n'omu kurasha emyambi; bakaba bari Ababenyamiini beene waabo b'aba Saulo. <verse eid="1CH 12:2" /><verse number="3" style="v" sid="1CH 12:3" /><note caller="-" style="x"><char style="xo" closed="false">12:3: </char><char style="xt" closed="false"><ref loc="1CH 27:12">1 Bus 27:12</ref>. </char></note> Omukuru waabo akaba ari Ahiezeeri, naakuratwa Yoasi, bombi bari beene Shemaya owa Gibea, na Yezieli na Peleti beene Azimaveesi; Beraaka, Yehu owa Anatoosi, <verse eid="1CH 12:3" /><verse number="4" style="v" sid="1CH 12:4" /><note caller="-" style="x"><char style="xo" closed="false">12:4: </char><char style="xt" closed="false"><ref loc="JOS 9:3">Yos 9:3</ref>. </char></note> Ishumaaya owa Gibeoni, omushaija w'amaani omuri bari makumi ashatu, kandi omwebembezi waabo, Yeremia, Yahazieli, Yohanaani, Yozabadi owa Gedera, <verse eid="1CH 12:4" /><verse number="5" style="v" sid="1CH 12:5" />Eluzai, Yerimoosi, Bealia, Shemaria, Shefatia owa Harufi, <verse eid="1CH 12:5" /><verse number="6" style="v" sid="1CH 12:6" /><note caller="-" style="x"><char style="xo" closed="false">12:6: </char><char style="xt" closed="false"><ref loc="1CH 9:19">1 Bus 9:19</ref>. </char></note> Elukaana, Ishia, Azareeli, Yoezeeri, Yashobeamu ow'aba Koora; <verse eid="1CH 12:6" /><verse number="7" style="v" sid="1CH 12:7" />na Yoeli na Zebadia beene Yerohaamu owa Gedori.<verse eid="1CH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8" />Kandi omu Bagaadi haarugamu abashaija abarwani b'amaani abamanyiire eby'orugamba, amahano omu kutwara engabo n'amacumu, abu obuso bwabo bwabaire nibushusha obw'entare, abaabaire nibairuka nk'esirabo z'omu bibungo, baashanga Daudi omu kigo ky'omu ihamba. <verse eid="1CH 12:8" /><verse number="9" style="v" sid="1CH 12:9" />Omukuru akaba ari Ezeri, owa kabiri Obadia, owa kashatu Eliabu, <verse eid="1CH 12:9" /><verse number="10" style="v" sid="1CH 12:10" />owa kana Mishimana, owa kataano Yeremia, <verse eid="1CH 12:10" /><verse number="11" style="v" sid="1CH 12:11" />owa mukaaga Atai, owa mushanju Elieli, <verse eid="1CH 12:11" /><verse number="12" style="v" sid="1CH 12:12" />owa munaana Yohanaani, owa mwenda Elizabadi, <verse eid="1CH 12:12" /><verse number="13" style="v" sid="1CH 12:13" />owa ikumi Yeremia, owa ikumi n'omwe Makubanai. <verse eid="1CH 12:13" /><verse number="14" style="v" sid="1CH 12:14" /><note caller="-" style="x"><char style="xo" closed="false">12:14: </char><char style="xt" closed="false"><ref loc="LEV 26:8">Lev 26:8</ref>. </char></note> Abagaadi abo bakaba bari abakuru b'engabo, omuto omuribo akaba ari nk'abantu igana, n'omukuru nk'abantu rukumi. <verse eid="1CH 12:14" /><verse number="15" style="v" sid="1CH 12:15" /><note caller="-" style="x"><char style="xo" closed="false">12:15: </char><char style="xt" closed="false"><ref loc="JOS 3:15">Yos 3:15</ref>. </char></note> Abo nibo baayambukire Yorudani omu kwezi kw'okubanza, obu Yorudani yaabaire eijwire, amaizi garengyeire aha nkungu zaayo zoona, bakabinga ab'omu mpita z'oburugwa-izooba n'oburengyerwa-izooba boona.<verse eid="1CH 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16" />Bwanyima abamwe omu Babenyamiini n'Abayuda baija, baashanga Daudi omu kigo. <verse eid="1CH 12:16" /><verse number="17" style="v" sid="1CH 12:17" />Daudi yaashohora kubabugana, yaabagira ati: Ku muraabe mwaija kumpa emikono nk'abanywani bangye, omutima gwangye nigwija kukwatanisa n'eyaanyu; kwonka ku muraabe mwaija kundeebya aha bazigu bangye, haza ntaine ki nshobize, Ruhanga wa baatatenkuriitwe akireebe, kandi abahane. <verse eid="1CH 12:17" /><verse number="18" style="v" sid="1CH 12:18" /><note caller="-" style="x"><char style="xo" closed="false">12:18: </char><char style="xt" closed="false"><ref loc="JDG 3:10">Bar 3:10</ref>; <ref loc="2SA 17:25">2 Sam 17:25</ref>. </char></note> Ahonaaho Omwoyo yaija ahari Amasai, omukuru wa bari makumi ashatu, yaagira ati:</para>
  <para style="q1" vid="1CH 12:18">Turi abaawe, Daudi!</para>
  <para style="q1" vid="1CH 12:18">Turi aha rubaju rwawe, iwe mwene Yese!</para>
  <para style="q1" vid="1CH 12:18">Obusingye, obusingye bube ahariiwe,</para>
  <para style="q1" vid="1CH 12:18">N'aha barikukuha emikono;</para>
  <para style="q1" vid="1CH 12:18">Ahakuba Ruhanga waawe akuhwera.</para>
  <para style="p" vid="1CH 12:18">Ahonaaho Daudi yaabaakiira, yaabagira abakuru b'engabo ze. <verse eid="1CH 12:18" /><verse number="19" style="v" sid="1CH 12:19" /><note caller="-" style="x"><char style="xo" closed="false">12:19: </char><char style="xt" closed="false"><ref loc="1SA 29:2-9">1 Sam 29:2-9</ref>. </char></note> Kandi n'abamwe omu Bamanaase bakaimuura, baayehongyera Daudi, obu yaahurura n'Abafilistia kurwanisa Saulo. (Kwonka Daudi tarabahwereire, ahakuba abakuru omu Bafilistia bakaza omu naama, baamubinga nibagira bati: Naija kutureebya agarukire mukama we Saulo, atunagye omu kabi.) <verse eid="1CH 12:19" /><verse number="20" style="v" sid="1CH 12:20" />Ku yaabaire naakigaruka Zikulaagi, abashaija aba ab'omu Bamanaase baamwehongyera, Aduna, Yoazabadi, Yediaeli, Mikaeli, Yozabadi, Elihu na Zilesai, abaabaire bari abakuru b'emitwe y'engabo rukumi-rukumi y'eihe ry'Abamanaase; <verse eid="1CH 12:20" /><verse number="21" style="v" sid="1CH 12:21" /><note caller="-" style="x"><char style="xo" closed="false">12:21: </char><char style="xt" closed="false"><ref loc="1SA 30:1">1 Sam 30:1</ref>. </char></note> bakaha Daudi emikono kurwanisa emitwe y'abanyagi. <verse eid="1CH 12:21" /><verse number="22" style="v" sid="1CH 12:22" />Ahakuba abantu bakaba baija ahari Daudi buri izooba kumuha emikono, okuhitsya obu baabaire eihe rihango, nk'eihe rya Ruhanga.<verse eid="1CH 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 12:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:23: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 11:1">1 Bus 11:1</ref>, <ref loc="1CH 11:3">3</ref>, <ref loc="1CH 11:10">10</ref>. </char>
    </note> Egi niyo mibaro y'emitwe y'engabo ezaashangire Daudi Heburooni, ziine eby'okurwanisa, kumukubuurira obugabe bwa Saulo, nk'ekigambo kya MUKAMA oku kyabaire kiri. <verse eid="1CH 12:23" /><verse number="24" style="v" sid="1CH 12:24" />Abayuda abaabaire baine engabo n'amacumu, bakaba bari obukumi mukaaga na magana munaana abeeteekateekyeire orugamba; <verse eid="1CH 12:24" /><verse number="25" style="v" sid="1CH 12:25" />Abasimeoni abashaija abarwani b'amaani omu rugamba bari enkumi mushanju na igana; <verse eid="1CH 12:25" /><verse number="26" style="v" sid="1CH 12:26" />Abaleevi enkumi ina na magana mukaaga; <verse eid="1CH 12:26" /><verse number="27" style="v" sid="1CH 12:27" />Yehoyaada owaabaire ari omwebembezi w'enju ya Arooni yaija n'engabo enkumi ishatu na magana mushanju; <verse eid="1CH 12:27" /><verse number="28" style="v" sid="1CH 12:28" /><note caller="-" style="x"><char style="xo" closed="false">12:28: </char><char style="xt" closed="false"><ref loc="2SA 8:17">2 Sam 8:17</ref>; <ref loc="1CH 6:8">1 Bus 6:8</ref>. </char></note> Zadoki omutsigazi w'amaani emanzi yaija n'abakuru b'engabo makumi abiri na babiri ab'enju ya ishe. <verse eid="1CH 12:28" /><verse number="29" style="v" sid="1CH 12:29" /><note caller="-" style="x"><char style="xo" closed="false">12:29: </char><char style="xt" closed="false"><ref loc="2SA 2:8">2 Sam 2:8</ref>, <ref loc="2SA 2:9">9</ref>; <ref loc="1CH 12:2">1 Bus 12:2</ref>. </char></note> Ababenyamiini, abaine obuzaare na Saulo, bakaba bari enkumi ishatu, ahabw'okuba okuhitsya omu bunaku obwo abaingi omuribo bakaba bahamiire aha nju ya Saulo; <verse eid="1CH 12:29" /><verse number="30" style="v" sid="1CH 12:30" />Abaefuraimu abashaija b'amaani amamanzi, ba rugambwa omu maju ga baishenkurubo bari obukumi bubiri na magana munaana, <verse eid="1CH 12:30" /><verse number="31" style="v" sid="1CH 12:31" /><note caller="-" style="x"><char style="xo" closed="false">12:31: </char><char style="xt" closed="false"><ref loc="NUM 1:17">Kub 1:17</ref>. </char></note> ab'ekicweka ky'oruganda rwa Manaase, abu amaziina gaabo gaagambirweho ngu baije kwemeka Daudi, bari kakumi n'enkumi munaana; <verse eid="1CH 12:31" /><verse number="32" style="v" sid="1CH 12:32" />Abaisraeli abaabaire nibeetegyereza eby'obunaku, kandi nibamanya ebi Abaisraeli bashemereire kukora, abakuru bari magana abiri hamwe na beene waabo abu baabaire nibategyeka. <verse eid="1CH 12:32" /><verse number="33" style="v" sid="1CH 12:33" />Abazebuluuni, abaabaire bamanyiire eby'orugamba baine eby'okurwanisa byona, baizire kuhwera Daudi n'omutima gumwe, bari obukumi butaano; <verse eid="1CH 12:33" /><verse number="34" style="v" sid="1CH 12:34" />Abanafutaali abakuru b'engabo rukumi abaizire n'engabo eziine engabo n'amacumu bari obukumi bushatu n'enkumi mushanju; <verse eid="1CH 12:34" /><verse number="35" style="v" sid="1CH 12:35" /><note caller="-" style="x"><char style="xo" closed="false">12:35: </char><char style="xt" closed="false"><ref loc="1CH 12:36">1 Bus 12:36</ref>, <ref loc="1CH 12:38">38</ref>; <ref loc="PSA 12:2">Zab 12:2</ref>. </char></note> Abadaani abaabaire baine eby'okurwanisa by'orugamba bari obukumi bubiri n'enkumi munaana na magana mukaaga; <verse eid="1CH 12:35" /><verse number="36" style="v" sid="1CH 12:36" />Abaasheri engabo ezimanyiire orugamba ezaabaire zeeteekateekire kurwana bari obukumi buna; <verse eid="1CH 12:36" /><verse number="37" style="v" sid="1CH 12:37" />Abareubeeni n'Abagaadi n'ekicweka ky'oruganda rwa Manaase abaarugire seeri ya Yorudani baine eby'okurwanisa by'orugamba eby'emiringo yoona, bari akasiriira n'obukumi bubiri.<verse eid="1CH 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="1CH 12:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:38: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:61">1 Bag 8:61</ref>; <ref loc="1CH 12:33">1 Bus 12:33</ref>. </char>
    </note> Abo barwani boona, abaabaire bamanyiire eby'orugamba, baija Heburooni n'omutima gumwe kwemeka Daudi kuba omugabe wa Israeli yoona; kandi n'Abaisraeli abandi boona bakaba baine omutima gumwe gw'okwemeka Daudi. <verse eid="1CH 12:38" /><verse number="39" style="v" sid="1CH 12:39" />Baamarayo kashatu bari hamwe na Daudi, nibarya nibanywa; ahabw'okuba beene waabo bakaba bababisiire. <verse eid="1CH 12:39" /><verse number="40" style="v" sid="1CH 12:40" />Kandi na bataahi baabo, n'abaarugire Isakaari, Zebuluuni na Nafutaali, baija bareetsire eby'okurya aha ndogoya, aha ngamira, aha nyumbu n'aha nte, eby'okurya bingi, esaano, ebiihuro by'emizaabibu eyomire, viinyo n'amajuta, ente n'entaama; ahabw'okuba omuri Israeli hakaba harimu okushemererwa.<verse eid="1CH 12:40" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">Daudi okugarura eshanduukye ya MUKAMA omuri Yerusaalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1" />Bwanyima Daudi yaaza omu naama n'abeebembezi boona, abakuru b'engabo rukumi-rukumi na igana-igana. <verse eid="1CH 13:1" /><verse number="2" style="v" sid="1CH 13:2" /><note caller="-" style="x"><char style="xo" closed="false">13:2: </char><char style="xt" closed="false"><ref loc="1SA 31:1">1 Sam 31:1</ref>. </char></note> Kandi yaagambira omutwe gw'Abaisraeli boona abaabaire bateeraine naagira ati: Ku muraabe nimukisiima, kandi kirugire ahari MUKAMA Ruhanga waitu, tutume hoonahoona omuri beene waitu abatsigaire omu nsi ya Israeli yoona, abu abanyamurwa n'Abaleevi batwire nabo omu ndembo zaabo n'amariisizo gaazo, babone kuteeranira ahu turi; <verse eid="1CH 13:2" /><verse number="3" style="v" sid="1CH 13:3" /><note caller="-" style="x"><char style="xo" closed="false">13:3: </char><char style="xt" closed="false"><ref loc="1SA 7:12">1 Sam 7:12</ref>. </char></note> bwanyima tuze kugarura eshanduukye ya Ruhanga waitu; ahabw'okuba omu biro bya Saulo tituragyeteireho. <verse eid="1CH 13:3" /><verse number="4" style="v" sid="1CH 13:4" /><note caller="-" style="x"><char style="xo" closed="false">13:4: </char><char style="xt" closed="false"><ref loc="NUM 34:5">Kub 34:5</ref>; <ref loc="1SA 6:21">1 Sam 6:21</ref>; <ref loc="1SA 7:1">7:1</ref>; <ref loc="2SA 6:1">2 Sam 6:1</ref>; <ref loc="1KI 8:65">1 Bag 8:65</ref>; <ref loc="1CH 15:3">1 Bus 15:3</ref>. </char></note> Omutwe gwona gwaikiriza kutwaza gutyo, ahakuba egyo naama ekasiimwa abantu boona.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5" />Atyo Daudi yaateerana Abaisraeli boona okuruga Shihoori akagyera ka Misri okuhika ah'orikutaahira nooza Hamasi, ngu babone kwiha eshanduukye ya Ruhanga Kiryasi-yearimu. <verse eid="1CH 13:5" /><verse number="6" style="v" sid="1CH 13:6" /><note caller="-" style="x"><char style="xo" closed="false">13:6-14: </char><char style="xt" closed="false"><ref loc="2SA 6:2-11">2 Sam 6:2-11</ref>. </char></note> Daudi n'Abaisraeli boona bainamuka, baaza Baala niyo Kiryasi-yearimu ey'Abayuda, kwihayo eshanduukye ya Ruhanga, eyaabaire etakirirwaho Eiziina rya MUKAMA, oshutama aha kitebe kye ahaiguru ya baakerubi.<note caller="-" style="x"><char style="xo" closed="false">13:6: </char><char style="xt" closed="false"><ref loc="1SA 4:4">1 Sam 4:4</ref>. </char></note> <verse eid="1CH 13:6" /><verse number="7" style="v" sid="1CH 13:7" />Baatwarira eshanduukye ya Ruhanga aha kigaari kisya, baagiiha omu ka ya Abinadabu, kandi Uzza na Ahio nibo baabaire nibatwara ekyo kigaari. <verse eid="1CH 13:7" /><verse number="8" style="v" sid="1CH 13:8" /><note caller="-" style="x"><char style="xo" closed="false">13:8: </char><char style="xt" closed="false"><ref loc="1CH 15:16">1 Bus 15:16</ref>. </char></note> Daudi n'Abaisraeli boona baagyenda nibashemerererwa omu maisho ga MUKAMA n'amaani gaabo goona, nibeeshongora nibateera endingiri, n'enanga n'engarabi, n'amataari n'ebitaasa n'amakondere.<verse eid="1CH 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9" />Ku baahikire aha mbuga ya Kidoni, Uzza yaatayo omukono gwe kuramira eshanduukye ya Ruhanga, ahabw'okuba ente zikateera entsibo. <verse eid="1CH 13:9" /><verse number="10" style="v" sid="1CH 13:10" /><note caller="-" style="x"><char style="xo" closed="false">13:10: </char><char style="xt" closed="false"><ref loc="NUM 4:15">Kub 4:15</ref>; <ref loc="1CH 15:13">1 Bus 15:13</ref>, <ref loc="1CH 15:15">15</ref>. </char></note> MUKAMA yaagirira Uzza ekiniga; yaamwitira aho, naamutura okuramira eshanduukye n'omukono gwe; yaafeera aho omu maisho ga Ruhanga. <verse eid="1CH 13:10" /><verse number="11" style="v" sid="1CH 13:11" />Daudi yaaguubwa kubi ahabwa MUKAMA kugwa ahari Uzza; ogwo mwanya gwayetwa Pereezi-uzza n'okuhitsya hati. <verse eid="1CH 13:11" /><verse number="12" style="v" sid="1CH 13:12" />Eryo izooba Daudi yaatiina Ruhanga yaagira ati: Nimbaasa nta kutwara eshanduukye ya MUKAMA omu ka yangye? <verse eid="1CH 13:12" /><verse number="13" style="v" sid="1CH 13:13" />N'ahabw'ekyo Daudi tiyaatwara shanduukye ya Ruhanga owe omu rurembo rwa Daudi, kureka yaagikiikamya, yaagita omu nju ya Obededomu Omunyagaasi. <verse eid="1CH 13:13" /><verse number="14" style="v" sid="1CH 13:14" />Eshanduukye ya Ruhanga yaamara ameezi ashatu omu nju ya Obededomu; MUKAMA yaaha eka ya Obededomu omugisha, n'ebi yaabaire atungire byona.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">Hiraamu omugabe wa Tuuro okuhwera Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1-16: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 5:11-25">2 Sam 5:11-25</ref>. </char>
    </note> Bwanyima Hiraamu omugabe wa Tuuro yaayohereza entumwa ahari Daudi n'ebiti by'emyereezi, n'abarikwombekyesa amabaare n'ababaizi, kumwombekyera enju. <verse eid="1CH 14:1" /><verse number="2" style="v" sid="1CH 14:2" />Daudi yaamanyira aho ku MUKAMA amuhamize kuba omugabe wa Israeli, kandi ku aimukize obugabe bwe ahabw'abantu be Israeli.<verse eid="1CH 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3" />Bwanyima Daudi yaashwerera abandi bakazi omuri Yerusaalemu, yaazaara abandi baana b'aboojo n'ab'abaishiki. <verse eid="1CH 14:3" /><verse number="4" style="v" sid="1CH 14:4" /><note caller="-" style="x"><char style="xo" closed="false">14:4-7: </char><char style="xt" closed="false"><ref loc="1CH 3:5-8">1 Bus 3:5-8</ref>. </char></note> Aga nigo maziina g'abaana abu yaazaariire Yerusaalemu; Shamua, Shobabu, Nasani, Sulemaani, <verse eid="1CH 14:4" /><verse number="5" style="v" sid="1CH 14:5" />Ibuhaari, Elishua, Elipeleti, <verse eid="1CH 14:5" /><verse number="6" style="v" sid="1CH 14:6" />Nooga, Nefegi, Yafia, <verse eid="1CH 14:6" /><verse number="7" style="v" sid="1CH 14:7" />Elishaama, Beeliada na Elifeleti.<verse eid="1CH 14:7" /></para>
  <para style="s1">Daudi okugaruka kusingura Abafilistia</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8" />Abafilistia boona ku baahuriire ngu Daudi ashukirweho amajuta kuba omugabe w'Abaisraeli boona, bainamuka baaza kusherura Daudi; Daudi ku yaabihuriire, yaahurura kubarwanisa. <verse eid="1CH 14:8" /><verse number="9" style="v" sid="1CH 14:9" />Omu bunaku obwo Abafilistia bakaba baizire, bateire oruhita rw'Abareefa. <verse eid="1CH 14:9" /><verse number="10" style="v" sid="1CH 14:10" />Daudi yaayehanuuza ahari Ruhanga naabuuza ati: Nyinamukye ndwane n'Abafilistia? Noija kubahayo omu mikono yangye? MUKAMA yaamugarukamu ati: Inamuka, ahakuba niinyija kubahayo omu mikono yaawe. <verse eid="1CH 14:10" /><verse number="11" style="v" sid="1CH 14:11" />Daudi nikwo kuza Baali-peraziimu, akabaitirayo. Bwanyima yaagira ati: Ruhanga ahigwire abazigu bangye, nk'oku amaizi gahigura omucungiro. Nikyo baayeteire ogwo mwanya Baali-peraziimu. <verse eid="1CH 14:11" /><verse number="12" style="v" sid="1CH 14:12" />Abafilistia baatsigayo ebishushani byabo ebirikuramibwa, Daudi yaaragiira, baabyotsya.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13" />Ku haahingwireho ebiro Abafilistia baagaruka baateera orwo ruhita. <verse eid="1CH 14:13" /><verse number="14" style="v" sid="1CH 14:14" />Daudi yaagaruka yaayehanuuza ahari Ruhanga, Ruhanga yaamugarukamu ati: Otainamuka kubakurata; kureka obakiikuukye, obashangye ahashungaine n'akabira k'emitugunda. <verse eid="1CH 14:14" /><verse number="15" style="v" sid="1CH 14:15" />Bwanyima ku oraahurire okukaabuuza aha mitwe y'emitugunda, ahonaaho ogyende obateere; ahakuba Ruhanga naaba akwebembeire kwita engabo z'Abafilistia. <verse eid="1CH 14:15" /><verse number="16" style="v" sid="1CH 14:16" />Atyo Daudi yaatwaza nk'oku Ruhanga yaamuragiira, baagyenda baita Abafilistia okuruga Gibeoni okuhika Gezeri. <verse eid="1CH 14:16" /><verse number="17" style="v" sid="1CH 14:17" /><note caller="-" style="x"><char style="xo" closed="false">14:17: </char><char style="xt" closed="false"><ref loc="DEU 2:25">Bir 2:25</ref>. </char></note> Okurangaanwa kwa Daudi kwabuga ensi zoona, MUKAMA yaareetera amahanga goona kumutiina.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">Daudi okutaasya eshanduukye ya Ruhanga</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:1">1 Bus 16:1</ref>. </char>
    </note> Bwanyima Daudi yaayeyombekyera amaju omu rurembo rwe; kandi yaateguurira eshanduukye ya Ruhanga omwanya, yaagiteerera eihema. <verse eid="1CH 15:1" /><verse number="2" style="v" sid="1CH 15:2" /><note caller="-" style="x"><char style="xo" closed="false">15:2: </char><char style="xt" closed="false"><ref loc="1CH 15:15">1 Bus 15:15</ref>, <ref loc="1CH 15:26">26</ref>; <ref loc="NUM 4:15">Kub 4:15</ref>. </char></note> Daudi yaagira ati: Tihariho n'omwe oshemereire kuheeka eshanduukye ya Ruhanga kureka Abaleevi, ahabw'okuba nibo MUKAMA yaatooraine kuguma nibaheeka eshanduukye ya MUKAMA, n'okumuheereza ebiro byona. <verse eid="1CH 15:2" /><verse number="3" style="v" sid="1CH 15:3" /><note caller="-" style="x"><char style="xo" closed="false">15:3: </char><char style="xt" closed="false"><ref loc="1CH 13:5">1 Bus 13:5</ref>; <ref loc="1KI 8:1">1 Bag 8:1</ref>; <ref loc="2SA 6:17">2 Sam 6:17</ref>. </char></note> Bwanyima Daudi yaateeranira Abaisraeli boona Yerusaalemu, ngu baze kwinamura eshanduukye ya MUKAMA, bagite omu mwanya gwayo ogu agibonereize. <verse eid="1CH 15:3" /><verse number="4" style="v" sid="1CH 15:4" /><note caller="-" style="x"><char style="xo" closed="false">15:4: </char><char style="xt" closed="false"><ref loc="1CH 6:16-30">1 Bus 6:16-30</ref>. </char></note> Kandi Daudi yaateerana batabani ba Arooni n'Abaleevi; <verse eid="1CH 15:4" /><verse number="5" style="v" sid="1CH 15:5" />omuri beene Kohasi, omukuru akaba ari Urieli na beene ishe igana na makumi abiri; <verse eid="1CH 15:5" /><verse number="6" style="v" sid="1CH 15:6" />omuri beene Merari, omukuru Asaaya na beene ishe magana abiri na makumi abiri; <verse eid="1CH 15:6" /><verse number="7" style="v" sid="1CH 15:7" />omuri beene Gereshoni, omukuru Yoeli na beene ishe igana na makumi ashatu; <verse eid="1CH 15:7" /><verse number="8" style="v" sid="1CH 15:8" />omuri beene Elizafaani, omukuru Shemaaya na beene ishe magana abiri; <verse eid="1CH 15:8" /><verse number="9" style="v" sid="1CH 15:9" />omuri beene Heburooni, omukuru Elieli na beene ishe makumi munaana; <verse eid="1CH 15:9" /><verse number="10" style="v" sid="1CH 15:10" />omuri beene Uzieli, omukuru Abinadabu na beene ishe igana na ikumi na babiri. <verse eid="1CH 15:10" /><verse number="11" style="v" sid="1CH 15:11" /><note caller="-" style="x"><char style="xo" closed="false">15:11: </char><char style="xt" closed="false"><ref loc="1CH 6:18">1 Bus 6:18</ref>; <ref loc="1CH 16:39">16:39</ref>; <ref loc="1KI 1:25">1 Bag 1:25</ref>; <ref loc="1KI 2:26">2:26</ref>; <ref loc="2SA 15:24">2 Sam 15:24</ref>; <ref loc="1SA 22:20">1 Sam 22:20</ref>. </char></note> Bwanyima Daudi yaayeta Zadoki na Abiasaari abanyamurwa n'Abaleevi aba: Urieli, Asaaya, Yoeli, Shemaaya, Elieli na Aminadabu, <verse eid="1CH 15:11" /><verse number="12" style="v" sid="1CH 15:12" /><note caller="-" style="x"><char style="xo" closed="false">15:12: </char><char style="xt" closed="false"><ref loc="1CH 15:1">1 Bus 15:1</ref>, <ref loc="1CH 15:3">3</ref>; <ref loc="2CH 35:6">2 Bus 35:6</ref>. </char></note> yaabagira ati: Muri abakuru b'amaju ga baashwenkuriimwe Abaleevi; mweyeze, imwe ana beene waanyu, mubone kwinamura eshanduukye ya MUKAMA, Ruhanga wa Israeli kugita omu mwanya ogu ngibonereize. <verse eid="1CH 15:12" /><verse number="13" style="v" sid="1CH 15:13" /><note caller="-" style="x"><char style="xo" closed="false">15:13: </char><char style="xt" closed="false"><ref loc="1CH 13:7">1 Bus 13:7</ref>, <ref loc="1CH 13:11">11</ref>; <ref loc="2SA 6:3">2 Sam 6:3</ref>, <ref loc="2SA 6:8">8</ref>; <ref loc="NUM 7:6-9">Kub 7:6-9</ref>. </char></note> Ahabw'okuba obw'okubanza timuragiheekire, nikyo MUKAMA Ruhanga waitu yaatugwereireho naatutura okutagitwaza, nk'oku kyaragiirwe. <verse eid="1CH 15:13" /><verse number="14" style="v" sid="1CH 15:14" />Batyo abanyamurwa n'Abaleevi baayeyeza ahabw'okuza kwinamura eshanduukye ya MUKAMA, Ruhanga wa Israeli. <verse eid="1CH 15:14" /><verse number="15" style="v" sid="1CH 15:15" /><note caller="-" style="x"><char style="xo" closed="false">15:15: </char><char style="xt" closed="false"><ref loc="EXO 25:14">Kur 25:14</ref>; <ref loc="NUM 4:15">Kub 4:15</ref>; <ref loc="NUM 7:9">7:9</ref>. </char></note> Ku baahikireyo, Abaleevi baaheeka eshanduukye ya Ruhanga aha mabega gaabo n'emigamba, nk'oku Musa yaragiire naakuratira ekigambo kya MUKAMA. <verse eid="1CH 15:15" /><verse number="16" style="v" sid="1CH 15:16" /><note caller="-" style="x"><char style="xo" closed="false">15:16: </char><char style="xt" closed="false"><ref loc="1CH 13:8">1 Bus 13:8</ref>; <ref loc="1CH 16:42">16:42</ref>; <ref loc="1CH 25:1">25:1</ref>, <ref loc="1CH 25:6">6</ref>. </char></note> Kandi Daudi yaaragiira abakuru b'Abaleevi kutaho abeeshongozi ab'omuri beene waabo, ab'okuteera enanga, endingiri n'ebitaasa, nibateera akaari k'okushemererwa. <verse eid="1CH 15:16" /><verse number="17" style="v" sid="1CH 15:17" /><note caller="-" style="x"><char style="xo" closed="false">15:17: </char><char style="xt" closed="false"><ref loc="1CH 6:33">1 Bus 6:33</ref>, <ref loc="1CH 6:39">39</ref>, <ref loc="1CH 6:44">44</ref>. </char></note> Batyo Abaleevi baatoorana Hemani mwene Yoeli, omuri beene ishe baatoorana Asafu mwene Berekia, n'omuri beene Merari baatoorana Esaani mwene Kushaya; <verse eid="1CH 15:17" /><verse number="18" style="v" sid="1CH 15:18" />kandi hamwe n'abo baatoorana omuri beene waabo abarikukurataho, Zekaria, Yazieli, Shemiramoosi, Yehieli, Uuni, Eliabu, Benaaya, Maaseya, Matisiya, Elefelebu, Mikuneya n'abarinzi b'eirembo Obededomu na Yeyeli. <verse eid="1CH 15:18" /><verse number="19" style="v" sid="1CH 15:19" />Abeeshongozi aba, Hemani, Asafu na Esaani, bakaba bari ab'okuteera ebitaasa by'emiringa; <verse eid="1CH 15:19" /><verse number="20" style="v" sid="1CH 15:20" />Zekaria, Azieli, Shemiramoosi, Yehieli, Uuni, Eliabu, Maaseya na Benaaya bakaba baari ab'okuteera enanga omu iraka rya <note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">Alamoosi amakuru oburaka bukye. </char></note>Alamoosi; <verse eid="1CH 15:20" /><verse number="21" style="v" sid="1CH 15:21" />Matisiya, Elefelebu, Mikuneya, Obededomu, Yeyeli na Azazia bakaba bari ab'okuteera enanga omu iraka rya <note caller="+" style="f"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">Sheminiisi amakuru amaraka mahango. </char></note>Sheminiisi. <verse eid="1CH 15:21" /><verse number="22" style="v" sid="1CH 15:22" />Kandi Kenania, omwebembezi w'Abaleevi omu by'okweshongora, niwe yaabaire ari omwebembezi, ahabw'okuba akaba naabimanya munonga. <verse eid="1CH 15:22" /><verse number="23" style="v" sid="1CH 15:23" />Berekia na Elukaana bakaba bari abakuumirizi b'eirembo ahabw'eshanduukye. <verse eid="1CH 15:23" /><verse number="24" style="v" sid="1CH 15:24" /><note caller="-" style="x"><char style="xo" closed="false">15:24: </char><char style="xt" closed="false"><ref loc="1CH 15:28">1 Bus 15:28</ref>; <ref loc="1CH 16:6">16:6</ref>; <ref loc="NUM 10:8">Kub 10:8</ref>. </char></note> Shebania, Yoshafaati, Netaneeli, Amasai, Zekaria, Benaaya na Eliezeeri, abanyamurwa, nibo baabaire bari ab'okugyenda nibateerera amakondere omu maisho g'eshanduukye ya Ruhanga; Obededomu na Yehia nabo bari abakumiirizi b'eirembo ahabw'eshanduukye.<verse eid="1CH 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:25-28: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 6:12">2 Sam 6:12</ref>, <ref loc="2SA 6:15">15</ref>. </char>
    </note> Atyo Daudi n'abakuru ba Israeli, n'abakuru b'engabo rukumi-rukumi, baaza kwinamura eshanduukye y'endagaano ya MUKAMA, kugiiha owa Obededomu n'okushemererwa. <verse eid="1CH 15:25" /><verse number="26" style="v" sid="1CH 15:26" />Kandi ahabwa Ruhanga kuhwera Abaleevi ababaire baheekire eshanduukye y'endagaano ya MUKAMA, baatamba enimi mushanju n'empaya z'entaama mushanju. <verse eid="1CH 15:26" /><verse number="27" style="v" sid="1CH 15:27" />Obwo Daudi akaba ajwaire ekanzu ya kitaani, kandi n'Abaleevi abaabaire baheekire eshanduukye, n'abeeshongozi, na Kenania omwebembezi waabo, nabo bakaba bajwaire batyo; kwonka Daudi we ajwariireho n'efodi ya kitaani. <verse eid="1CH 15:27" /><verse number="28" style="v" sid="1CH 15:28" />Okwo nikwo Abaisraeli boona bainamwire eshanduukye y'endagaano ya MUKAMA nibateera akaari n'enzamba n'amakondere n'ebitaasa, nibateera munonga endingiri n'enanga.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29" />Bwanyima eshanduukye y'endagaano ya MUKAMA ku yaabaire neetaaha omu rurembo rwa Daudi, Mikaali muhara wa Saulo yaaringuririza omu dirisa, yaareba omugabe Daudi naazina naayemurika, yaamugayira aha mutima.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="s1">Obugyenyi bw'okugarura eshanduukye</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 15:1">1 Bus 15:1</ref>. </char>
    </note> Batyo baataasya enshanduukye ya Ruhanga, baagita omu ihema eri Daudi agiteereireho; baatamba ebitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye omu maisho ga Ruhanga. <verse eid="1CH 16:1" /><verse number="2" style="v" sid="1CH 16:2" />Daudi ku yaaherize kutamba ebyo bitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye, yaashabira abantu omugisha omu iziina rya MUKAMA, <verse eid="1CH 16:2" /><verse number="3" style="v" sid="1CH 16:3" />yaagaburira Abaisraeli boona, abashaija n'abakazi, buri muntu omugaati gumwe, entongo y'enyama kandi n'omwate gw'emizaabibu eyomire. <verse eid="1CH 16:3" /><verse number="4" style="v" sid="1CH 16:4" />Kandi yaataho Abaleevi bamwe kukora omurimo gw'obuheereza omu maisho g'eshanduukye ya MUKAMA, okuguma nibaijutsya, okusiima n'okuhimbisa MUKAMA, Ruhanga wa Israeli. <verse eid="1CH 16:4" /><verse number="5" style="v" sid="1CH 16:5" /><note caller="-" style="x"><char style="xo" closed="false">16:5: </char><char style="xt" closed="false"><ref loc="1CH 6:39">1 Bus 6:39</ref>. </char></note> Omukuru waabo yaaba Asafu, yaakuratwa Zekaria, Yeyeli, Shemiramoosi, Yehieli, Matisiya, Eliabu, Benaaya, Obededomu na Yeyeli, abaatairweho kuteera enanga n'endingiri; Asafu we yaaba ow'okuteera ebitaasa, <verse eid="1CH 16:5" /><verse number="6" style="v" sid="1CH 16:6" />Benaaya na Yahazieli abanyamurwa baaba ab'okuguma nibateerera amakondere omu maisho g'eshanduukye y'endagaano ya Ruhanga.<verse eid="1CH 16:6" /></para>
  <para style="s1">Zaaburi y'okusiima Ruhanga</para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7" />Eryo izooba nibwo Daudi yaatandika kutaho Asafu na beene ishe kuba ab'okusingiza MUKAMA.<verse eid="1CH 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8-22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:1-15">Zab 105:1-15</ref>. </char>
    </note> Musiime MUKAMA, murangaane eiziina rye,</para>
  <para style="q1" vid="1CH 16:8">Mumanyise ebi yaakozire omu mahanga!<note caller="-" style="x"><char style="xo" closed="false">16:8: </char><char style="xt" closed="false"><ref loc="PSA 145:11">Zab 145:11</ref>, <ref loc="PSA 145:12">12</ref>; <ref loc="ISA 12:4">Isa 12:4</ref>. </char></note><verse eid="1CH 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9" />Mumweshongorere, mweshongore eby'okumuhimbisa,</para>
  <para style="q1" vid="1CH 16:9">Mugambire abantu eby'emirimo ye yoona ey'okutangaaza!<verse eid="1CH 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10" />Mwesiime ahabw'eiziina rye eririkwera;</para>
  <para style="q1" vid="1CH 16:10">Emitima y'abarikusherura MUKAMA eshemererwe!<verse eid="1CH 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:6">Zab 24:6</ref>; <ref loc="PSA 27:8">27:8</ref>. </char>
    </note> Musherure MUKAMA n'amaani ge,</para>
  <para style="q1" vid="1CH 16:11">Mwetengye okuguma omu maisho ge obutoosha.<verse eid="1CH 16:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 16:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:11">Zab 77:11</ref>; <ref loc="PSA 143:5">143:5</ref>. </char>
    </note> Mwijukye emirimo ye ey'okutangaaza</para>
  <para style="q1" vid="1CH 16:12">N'ebitakareebwaga ebi yaakozire, n'emanja ezi yaacwire,<verse eid="1CH 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 16:13" />Imwe ab'oruzaaro rw'omwiru we Abrahamu,</para>
  <para style="q1" vid="1CH 16:13">Abaana ba Yakobo abu yaatooraine.<verse eid="1CH 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:9">Isa 26:9</ref>. </char>
    </note> Niwe MUKAMA Ruhanga waitu,</para>
  <para style="q1" vid="1CH 16:14">Emicwere ye eri omu nsi yoona;<verse eid="1CH 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15" />Aijuka endagaano ye ebiro byona,</para>
  <para style="q1" vid="1CH 16:15">Ekigambo eki yaaragiire ab'obusingye rukumi,<verse eid="1CH 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:2">Kut 17:2</ref>; <ref loc="GEN 22:16">22:16</ref>; <ref loc="GEN 26:3">26:3</ref>; <ref loc="LUK 1:73">Luk 1:73</ref>. </char>
    </note> Niyo ndagaano ei yaaragaine na Abrahamu,</para>
  <para style="q1" vid="1CH 16:16">Ei yaarahiire naaraganisa Isaaka,<verse eid="1CH 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:17: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 35:11">Kut 35:11</ref>, <ref loc="GEN 35:12">12</ref>. </char>
    </note> Akagihamiza Yakobo kuba ekiragiro,</para>
  <para style="q1" vid="1CH 16:17">Na Israeli okuba endagaano etarihwaho,<verse eid="1CH 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:15">Kut 13:15</ref>; <ref loc="GEN 15:18-21">15:18-21</ref>. </char>
    </note> Naagira ati: Niiwe ndiha ensi ya Kanaani,</para>
  <para style="q1" vid="1CH 16:18">Kuba omugabo gw'obuhunguzi bwanyu.<verse eid="1CH 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:19: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:7">Bir 7:7</ref>; <ref loc="DEU 26:5">26:5</ref>; <ref loc="HEB 11:9">Heb 11:9</ref>. </char>
    </note> Obu baabaire bakiri bakye,</para>
  <para style="q1" vid="1CH 16:19">Eego bakye munonga kandi abashuhuuki omu nsi egyo,<verse eid="1CH 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20" />Nibazengyerera omu mahanga agatari gamwe,</para>
  <para style="q1" vid="1CH 16:20">Okuruga omu bugabe bumwe okuza omu bundi,<verse eid="1CH 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:17">Kut 12:17</ref>; <ref loc="GEN 20:3">20:3</ref>. </char>
    </note> Taraikiriize muntu weena kubakora kubi,</para>
  <para style="q1" vid="1CH 16:21">Akateisa abagabe ahabwabo,<verse eid="1CH 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:22: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:7">Kut 20:7</ref>. </char>
    </note> Naagira ati: Mutakora aha bu naashukireho amajuta,</para>
  <para style="q1" vid="1CH 16:22">N'obu kwakuba okukora kubi baanabi bangye.<verse eid="1CH 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:23-33: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:1-13">Zab 96:1-13</ref>. </char>
    </note> Imwe abari omu nsi mwena, mweshongorere MUKAMA,</para>
  <para style="q1" vid="1CH 16:23">Mworekye okujuna kwe buri kasheeshe.<verse eid="1CH 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24" />Mumanyise ekitiinisa kye omu mahanga,</para>
  <para style="q1" vid="1CH 16:24">Emirimo ye ey'okutangaaza omu mahanga goona.<verse eid="1CH 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:3">Zab 95:3</ref>; <ref loc="PSA 145:3">145:3</ref>. </char>
    </note> Ahakuba MUKAMA ni mukuru, ashamereire kuhimbisibwa munonga,</para>
  <para style="q1" vid="1CH 16:25">Kandi n'okutiinwa okukira baaruhanga boona.<verse eid="1CH 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:26: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:4">Lev 19:4</ref>; <ref loc="PSA 115:15">Zab 115:15</ref>; <ref loc="ISA 42:5">Isa 42:5</ref>; <ref loc="JER 10:11">Yer 10:11</ref>, <ref loc="JER 10:12">12</ref>. </char>
    </note> Ahakuba baaruhanga boona aba bantu baba ebishushani,</para>
  <para style="q1" vid="1CH 16:26">Kwonka Ruhanga niwe yaahangire eiguru.<verse eid="1CH 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27" />Ekitiinisa n'obukuru bimwebembeire;</para>
  <para style="q1" vid="1CH 16:27">Amaani n'okushemererwa biri ahi atuura.<verse eid="1CH 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1">Zab 29:1</ref>. </char>
    </note> Imwe enganda z'amahanga, mugambe,</para>
  <para style="q1" vid="1CH 16:28">Mugambe ku MUKAMA aine ekitiinisa n'amaani,<verse eid="1CH 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:29: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 20:21">2 Bus 20:21</ref>; <ref loc="PSA 29:2">Zab 29:2</ref>; <ref loc="PSA 96:9">96:9</ref>. </char>
    </note> Mugambe ku MUKAMA aine ekitiinisa ekishemereire eiziina rye,</para>
  <para style="q1" vid="1CH 16:29">Mureete empongano, mwije omu maisho ge;</para>
  <para style="q1" vid="1CH 16:29">Muramye MUKAMA mujwaire ebirikwera;<verse eid="1CH 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="1CH 16:30" />Muteteme omu maisho ge, imwe ab'omu nsi mwena;</para>
  <para style="q1" vid="1CH 16:30">Eego, ensi ehamire, terikubaasa kutengyetsibwa.<verse eid="1CH 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:31: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:13">Isa 49:13</ref>. </char>
    </note> Eiguru rishemererwe, n'ensi eyesiime;</para>
  <para style="q1" vid="1CH 16:31">Bagambire omu mahanga nibagira bati: MUKAMA ari aha ngoma!<verse eid="1CH 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 93:1">Zab 93:1</ref>; <ref loc="PSA 97:1">97:1</ref>; <ref loc="PSA 98:7">98:7</ref>; <ref loc="PSA 99:1">99:1</ref>; <ref loc="ISA 52:7">Isa 52:7</ref>; <ref loc="REV 11:15">Kush 11:15</ref>, <ref loc="REV 11:17">17</ref>. </char>
    </note> Enyanja ehoorere, na byona ebiijwiremu,</para>
  <para style="q1" vid="1CH 16:32">Emisiri eyesiime n'ebirimu byona!<verse eid="1CH 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33" />Obwo nibwo emiti yoona ey'omu kibira eryeshongora</para>
  <para style="q1" vid="1CH 16:33">Ahabw'okushemererwa omu maisho ga MUKAMA,</para>
  <para style="q1" vid="1CH 16:33">Ahabw'okuba naija kucwera ensi orubanja.<verse eid="1CH 16:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:1">Zab 106:1</ref>; <ref loc="PSA 107:1">107:1</ref>; <ref loc="PSA 118:1">118:1</ref>; <ref loc="PSA 136:1">136:1</ref>. </char>
    </note> Musiime MUKAMA, ahabw'okuba ni murungi,</para>
  <para style="q1" vid="1CH 16:34">Kandi embabazi ze n'ez'ebiro n'ebiro!<verse eid="1CH 16:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:35: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:47">Zab 106:47</ref>, <ref loc="PSA 106:48">48</ref>. </char>
    </note> Kandi mugire muti: Otujune, ai Ruhanga ow'okujunwa kwaitu,</para>
  <para style="q1" vid="1CH 16:35">Otutaaruure, otujune nootwiha omu mahanga,</para>
  <para style="q1" vid="1CH 16:35">Tubone kusiima eiziina ryawe eririkwera,</para>
  <para style="q1" vid="1CH 16:35">Twesiimire okuhimbisibwa kwawe.<verse eid="1CH 16:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:36: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:15">1 Bag 8:15</ref>; <ref loc="PSA 41:13">Zab 41:13</ref>. </char>
    </note> MUKAMA, Ruhanga wa Israeli, ahimbisibwe</para>
  <para style="q1" vid="1CH 16:36">Okwiha ira ryona okuhitsya ebiro byona.</para>
  <para style="p" vid="1CH 16:36">Bwanyima abantu boona baagira bati: Amiina; baahimbisa MUKAMA. <verse eid="1CH 16:36" /><verse number="37" style="v" sid="1CH 16:37" />Atyo Daudi yaatsiga Asafu na beene ishe omu maisho g'eshanduukye y'endagaano ya MUKAMA kuguma nibakora omurimo gw'obuheereza omu maisho gaayo, nk'oku kyabaire nikyetengwa buri izooba; <verse eid="1CH 16:37" /><verse number="38" style="v" sid="1CH 16:38" /><note caller="-" style="x"><char style="xo" closed="false">16:38: </char><char style="xt" closed="false"><ref loc="1CH 26:4">1 Bus 26:4</ref>, <ref loc="1CH 26:8">8</ref>, <ref loc="1CH 26:10">10</ref>, <ref loc="1CH 26:15">15</ref>, <ref loc="1CH 26:16">16</ref>. </char></note> yaatsigayo na Obededomu na beene ishe makumi mukaaga na munaana; kandi yaataho Obededomu mwene Yedusuuni na Hoosa kuba abakumiirizi b'eirembo. <verse eid="1CH 16:38" /><verse number="39" style="v" sid="1CH 16:39" /><note caller="-" style="x"><char style="xo" closed="false">16:39: </char><char style="xt" closed="false"><ref loc="1KI 3:4">1 Bag 3:4</ref>; <ref loc="1CH 15:11">1 Bus 15:11</ref>. </char></note> Kandi yaatsiga Zadoki omunyamurwa na beene ishe abanyamurwa omu maisho g'eihema rya MUKAMA eryabaire riri omu mwanya mukuru gw'okuramizamu, ogwabaire guri Gibeoni, <verse eid="1CH 16:39" /><verse number="40" style="v" sid="1CH 16:40" /><note caller="-" style="x"><char style="xo" closed="false">16:40: </char><char style="xt" closed="false"><ref loc="EXO 27:1">Kur 27:1</ref>; <ref loc="EXO 29:38-46">29:38-46</ref>; <ref loc="NUM 28:3-8">Kub 28:3-8</ref>. </char></note> kuguma nibatambirira MUKAMA ebitambo by'okwotsya aha itambiro ryabyo omu kasheeshe n'omu mwabazyo, nk'oku byona byabaire bihandiikirwe omu biragiro bya MUKAMA ebi yaaragiire Abaisraeli. <verse eid="1CH 16:40" /><verse number="41" style="v" sid="1CH 16:41" /><note caller="-" style="x"><char style="xo" closed="false">16:41: </char><char style="xt" closed="false"><ref loc="1CH 6:33">1 Bus 6:33</ref>; <ref loc="1CH 25:1">25:1</ref>, <ref loc="1CH 25:3">3</ref>, <ref loc="1CH 25:6">6</ref>; <ref loc="2CH 5:13">2 Bus 5:13</ref>; <ref loc="2CH 7:3">7:3</ref>, <ref loc="2CH 7:6">6</ref>; <ref loc="EZR 3:11">Ezr 3:11</ref>; <ref loc="JER 33:11">Yer 33:11</ref>. </char></note> Kandi hamwe n'abo yaataho Hemani na Yedusuuni n'abandi abaatoorainwe, abu amaziina gaabo gaagambirweho, kuba ab'okusiima MUKAMA ahabw'embabazi ze ezigumaho ebiro byona. <verse eid="1CH 16:41" /><verse number="42" style="v" sid="1CH 16:42" /><note caller="-" style="x"><char style="xo" closed="false">16:42: </char><char style="xt" closed="false"><ref loc="2CH 7:6">2 Bus 7:6</ref>; <ref loc="2CH 29:27">29:27</ref>. </char></note> Kandi Hemani na Yedusuuni abo bakaba bagira amakondere n'ebitaasa eby'okuteera, n'ebindi bintu by'okuteerwa ahabw'ebyeshongoro ebirikwera. Kandi baataho batabani ba Yedusuuni kuba ab'okurinda eirembo.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43" />Bwanyima abantu boona baayaabuuka, buri muntu yaaza owe, na Daudi yaagaruka owe kushabira eka ye omugisha.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">Daudi okuzibirwa kwombekyera Ruhanga enju</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:1: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:1-29">2 Sam 7:1-29</ref>. </char>
    </note> Bwanyima Daudi, ku yaataahire omu nju ye, yaagogyeera, yaagira Nasani nabi ati: Reeba, hati ndi omu nju y'emyereezi, kwonka eshanduukye y'endagaano ya MUKAMA eri omu ihema. <verse eid="1CH 17:1" /><verse number="2" style="v" sid="1CH 17:2" />Nasani yaagira Daudi ati: Kora ekikuru aha mutima kyona, ahakuba Ruhanga ari hamwe naiwe.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3" />Kwonka ekyo kiro ekigambo kya MUKAMA kyaizira Nasani nikigira kiti: <verse eid="1CH 17:3" /><verse number="4" style="v" sid="1CH 17:4" /><note caller="-" style="x"><char style="xo" closed="false">17:4: </char><char style="xt" closed="false"><ref loc="1CH 28:3">1 Bus 28:3</ref>. </char></note> Irooko ogire omwiru wangye Daudi oti: Oku nikwo MUKAMA arikugamba naagira ati: Toriinyombekyera nju y'okutuuramu; <verse eid="1CH 17:4" /><verse number="5" style="v" sid="1CH 17:5" />ahakuba tinkatuuraga mu nju, okwiha aha izooba eri naihiireho Abaisraeli Misri n'okuhitsya hati, kureka nkaba ngyenda ninduga omu ihema nindigarukamu, ninduga omu butaaho nimbugarukamu. <verse eid="1CH 17:5" /><verse number="6" style="v" sid="1CH 17:6" />Nimugira ngu omu myanya yoona ei naabaire ngyendamu n'Abaisraeli boona nkaba ndagizire omwe aha baramuzi ba Israeli, abu naaragiire kuriisa abantu bangye Israeli, nti: Ahabw'enki mutakaanyombekyeraga nju y'emyereezi? <verse eid="1CH 17:6" /><verse number="7" style="v" sid="1CH 17:7" />N'ahabw'ekyo ogire omwiru wangye Daudi oti: Oku nikwo MUKAMA ow'amahe arikugamba naagira ati: Nkakwiha omu iriisizo nooriisa entaama, ngu nkuhindure omutegyeki w'abantu bangye Israeli; <verse eid="1CH 17:7" /><verse number="8" style="v" sid="1CH 17:8" />kandi nkaba nguma naiwe ahu waabaire oza hoona, ncwekyerereza abazigu baawe omu maisho gaawe; kandi ndyakuha eiziina nk'ery'abantu rugambwa ab'omu nsi. <verse eid="1CH 17:8" /><verse number="9" style="v" sid="1CH 17:9" />Ndyatooranira abantu bangye Israeli omwanya, mbabyaremu, babone kugira obutaka bw'okutuuramu, obu batariihwamu bundi; kandi abantu babi tibarigaruka kubaita kubi nk'obunyakare, <verse eid="1CH 17:9" /><verse number="10" style="v" sid="1CH 17:10" />obu naabaire ndagiira abaramuzi kutegyeka abantu bangye Israeli; kandi ndyagomoora abazigu baawe boona. N'ekindi ninkugambira nti: MUKAMA aryakwombekyera eka. <verse eid="1CH 17:10" /><verse number="11" style="v" sid="1CH 17:11" />Kandi obunaku bwawe obw'okushanga bashwenkuru ku burihika, ndyaimutsya omu ruzaaro rwawe omwe ahari batabani baawe akuhungurire, mpamye obugabe bwe. <verse eid="1CH 17:11" /><verse number="12" style="v" sid="1CH 17:12" />Ogwo niwe ariinyombekyera enju, kandi ndyahamya ekitebe ky'obugabe bwe ebiro byona. <verse eid="1CH 17:12" /><verse number="13" style="v" sid="1CH 17:13" /><note caller="-" style="x"><char style="xo" closed="false">17:13: </char><char style="xt" closed="false"><ref loc="1SA 15:23">1 Sam 15:23</ref>, <ref loc="1SA 15:28">28</ref>; <ref loc="HEB 1:5">Heb 1:5</ref>. </char></note> Ndyaba ishe, nawe abe omwana wangye. Tindimwihaho mbabazi zangye, nk'oku naaziihire aha waakubandiize, <verse eid="1CH 17:13" /><verse number="14" style="v" sid="1CH 17:14" />kureka ndyamuhamya omu nju yangye n'omu bugabe bwangye ebiro byona, kandi ekitebe ky'obugabe bwe kiryagumaho ebiro n'ebiro. <verse eid="1CH 17:14" /><verse number="15" style="v" sid="1CH 17:15" />Ebyo bigambo byona n'okwo kworekwa kwona Nasani yaabiteekyerereza Daudi nk'oku byabaire biri.<verse eid="1CH 17:15" /></para>
  <para style="s1">Okushaba kwa Daudi</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16" />Bwanyima omugabe Daudi yaataaha, yaashutama omu maisho ga MUKAMA, yaagira ati: Niinye oha, ai MUKAMA Ruhanga, kandi n'enju yangye nikyo ki, iwe okundinda okampitsya aha? <verse eid="1CH 17:16" /><verse number="17" style="v" sid="1CH 17:17" />Kwonka ekyo ahariiwe ni kikye, ai Ruhanga; mbwenu waayongyeraho n'okugamba aha by'enju y'omwiru waawe, oku eriba omu biro bingi munonga ebiriija, kandi reeba, waanyinganisa n'omuntu w'ekitiinisa kihango, ai MUKAMA Ruhanga! <verse eid="1CH 17:17" /><verse number="18" style="v" sid="1CH 17:18" />Mbwenu shi, ekindi, nyowe Daudi, nkugambire ki ahabw'okuha omwiru waawe ekitiinisa? Ahabw'okuba niiwe orikumumanya. <verse eid="1CH 17:18" /><verse number="19" style="v" sid="1CH 17:19" />Ai MUKAMA, ebikuru ebyo byona obikoreire omwiru waawe, nk'oku omutima gwawe gurikuteekateeka, ngu obone kworeka ebikuru ebyo byona. <verse eid="1CH 17:19" /><verse number="20" style="v" sid="1CH 17:20" />Ai MUKAMA, tihariho orikushushana naiwe; tihariho Ruhanga kureka Iwe, nk'ebi twahuriire byona oku biri. <verse eid="1CH 17:20" /><verse number="21" style="v" sid="1CH 17:21" />Kandi n'eihanga ki omu nsi eriri nk'abantu baawe Israeli, abu Ruhanga yaagiire kwecungurira kuba abantu be, ngu oyetungire eiziina ahabw'okubakorera ebikuru kandi ebirikutiinisa, noobinga amahanga omu maisho g'abantu baawe, abu waacungwire, okaiha Misri? <verse eid="1CH 17:21" /><verse number="22" style="v" sid="1CH 17:22" />Bwanyima abantu baawe Israeli okabagira abaawe buzima ebiro byona; naiwe MUKAMA, waaba Ruhanga waabo. <verse eid="1CH 17:22" /><verse number="23" style="v" sid="1CH 17:23" />Mbwenu hati, ai MUKAMA, ekigambo eki waagamba aha mwiru waawe n'aha nju ye, kihamibwe ebiro byona, kandi okore nk'oku waagamba; <verse eid="1CH 17:23" /><verse number="24" style="v" sid="1CH 17:24" />n'eziina ryawe rihamibwe, kandi riheebwe ekitiinisa ebiro byona, nibagira bati: MUKAMA ow'amahe, Ruhanga wa Israeli, niwe Ruhanga wa Israeli; kandi enju y'omwiru waawe Daudi eryahamibwa omu maisho gaawe. <verse eid="1CH 17:24" /><verse number="25" style="v" sid="1CH 17:25" />Ahakuba Iwe, Ruhanga wangye, oshuuruuriire omwiru waawe, ku orimwombekyera eka; nikyo omwiru waawe yaagirira obumanzi kushaba omu maisho gaawe. <verse eid="1CH 17:25" /><verse number="26" style="v" sid="1CH 17:26" />Mbwenu hati, ai MUKAMA, niiwe Ruhanga, kandi waaraganisa omwiru waawe ekyo kigambo kirungi; <verse eid="1CH 17:26" /><verse number="27" style="v" sid="1CH 17:27" />n'ahabw'ekyo hati ikiriza kuha enju y'omwiru waawe omugisha, egumeho ebiro byona, eri omu maisho gaawe; ahakuba, MUKAMA, eki ohaire omugisha, kigugira ebiro byona.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">Daudi okusingura Abafilistia n'Abamoabu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:1-17: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 8:1-18">2 Sam 8:1-18</ref>. </char>
    </note> Bwanyima y'ebyo Daudi yaasingura Abafilistia, yaabamara eishaija, yaakwata Gaasi, n'ebirorero byayo, yaagiiha omu mikono y'Abafilistia. <verse eid="1CH 18:1" /><verse number="2" style="v" sid="1CH 18:2" />Yaasingura n'Abamoabu, baaba abairu be, baaguma nibamutoijera.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3" />Kandi Daudi yaasingura Hadadezeeri omugabe wa Zooba, yaamubinga, yaamuhitsya Hamasi; obwo Hadadezeeri akaba naaza kubyara ekiijutsyo kye aha mugyera Furaati. <verse eid="1CH 18:3" /><verse number="4" style="v" sid="1CH 18:4" />Daudi yaamunyagaho ebigaari rukumi, n'abarikugyendera aha mbaraasi enkumi mushanju, n'engabo ezirikugyendesa ebigyere obukumi bubiri. Bwanyima Daudi yaatema ebiteega by'embaraasi ezirikukurura ebigaari zoona, kwonka yaatsigaho ezirikubaasa kukurura ebigaari igana. <verse eid="1CH 18:4" /><verse number="5" style="v" sid="1CH 18:5" />Abasiria ba Damasiko ku baizire kuha Hadadezeeri omugabe wa Zooba emikono, Daudi yaabaitamu abantu obukumi bubiri n'enkumi ibiri. <verse eid="1CH 18:5" /><verse number="6" style="v" sid="1CH 18:6" />Bwanyima Daudi yaata emitwe y'abarinzi omuri Siria eya Damasiko, n'Abasiria baahinduka abairu be, baaguma nibamutoijera. Kandi MUKAMA yaaguma naaha Daudi obusinguzi ei yaabaire aza yoona. <verse eid="1CH 18:6" /><verse number="7" style="v" sid="1CH 18:7" />Daudi yaanyaga engabo z'ezaabu, ezi abagaragwa ba Hadadezeeri baabaire baine, yaazitwara Yerusaalemu. <verse eid="1CH 18:7" /><verse number="8" style="v" sid="1CH 18:8" /><note caller="-" style="x"><char style="xo" closed="false">18:8: </char><char style="xt" closed="false"><ref loc="1KI 7:15">1 Bag 7:15</ref>, <ref loc="1KI 7:23">23</ref>; <ref loc="2CH 4:12">2 Bus 4:12</ref>, <ref loc="2CH 4:15">15</ref>, <ref loc="2CH 4:16">16</ref>. </char></note> Kandi Daudi yaiha emiringa mingi munonga omuri Tibuhaasi na Kuuni, endembo za Hadadezeeri.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9" />Bwanyima Tou omugabe wa Hamasi, ku yaahuriire ngu Daudi asingwire eihe ryona erya Hadadezeeri omugabe wa Zooba, <verse eid="1CH 18:9" /><verse number="10" style="v" sid="1CH 18:10" />yaatuma Yoramu omutabani aha mugabe Daudi, kumuramutsya, n'okumutabarutsya, ahabw'okurwana na Hadadezeeri n'okumusingura; ahabw'okuba Hadadezeeri akaba atuura naarwana na Tou. Yaamutwekyera ebintu by'emiringo yoona eby'ezaabu, eby'efeeza n'eby'emiringa; <verse eid="1CH 18:10" /><verse number="11" style="v" sid="1CH 18:11" />ebyo nabyo omugabe Daudi yaabishoroorera MUKAMA, hamwe n'efeeza n'ezaabu ebi yaabiare anyagire omu mahanga aga goona, Edomu, Moabu, n'omu Baamoni, Abafilistia, na Amaleki. <verse eid="1CH 18:11" /><verse number="12" style="v" sid="1CH 18:12" /><note caller="-" style="x"><char style="xo" closed="false">18:12: </char><char style="xt" closed="false"><ref loc="1SA 26:6">1 Sam 26:6</ref>. </char></note> Bwanyima Abishai mwene Zeruiya yaitira Abanyaedomu kakumi n'enkumi munaana omu ruhita rw'Omwonyo. <verse eid="1CH 18:12" /><verse number="13" style="v" sid="1CH 18:13" />Yaataho emitwe y'abarinzi omuri Edomu; Abanyaedomu boona baahinduka abairu ba Daudi. Okwo nikwo MUKAMA yaahaire Daudi okusingura, ei yaabaire aza yoona.<verse eid="1CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14" />Atyo Daudi yaategyeka Israeli yoona; kandi yaacwera abantu be boona emanja z'oburyo omu bwinganisa. <verse eid="1CH 18:14" /><verse number="15" style="v" sid="1CH 18:15" /><note caller="-" style="x"><char style="xo" closed="false">18:15: </char><char style="xt" closed="false"><ref loc="1CH 11:6">1 Bus 11:6</ref>. </char></note> Obwo Yoabu mwene Zeruiya akaba ari omukuru w'eihe; Yehoshafaati mwene Ahiluudi ari omuhandiiki w'ebirikubaho; <verse eid="1CH 18:15" /><verse number="16" style="v" sid="1CH 18:16" /><note caller="-" style="x"><char style="xo" closed="false">18:16: </char><char style="xt" closed="false"><ref loc="2SA 20:5">2 Sam 20:5</ref>; <ref loc="1CH 24:3">1 Bus 24:3</ref>, <ref loc="1CH 24:6">6</ref>. </char></note> Zadoki mwene Ahitubu na Abimeleki mwene Abiasaari bari abanyamurwa; Shavusha ari omuhandiiki; <verse eid="1CH 18:16" /><verse number="17" style="v" sid="1CH 18:17" />Benaaya mwene Yehoyaada ari omukuru w'Abakeresi n'Abapelesi; kandi batabani ba Daudi bari abategyeki bakuru b'omugabe.<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="s1">Abaamoni okugaya entumwa za Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:1-19: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 10:1-19">2 Sam 10:1-19</ref>. </char>
    </note> Bwanyima y'ebyo Nahashi omugabe w'Abaamoni yaafa, omutabani Hanuni yaategyeka omu mwanya gwe. <verse eid="1CH 19:1" /><verse number="2" style="v" sid="1CH 19:2" />Daudi ku yaakihuriire, yaagira ati: Niinyija kukorera gye Hanuni mwene Nahashi, nk'oku ishe yankoreire. Atyo Daudi yaayohereza entumwa kumuyaagira ahabw'okufeerwa ishe. Abagaragwa ba Daudi baahika owa Hanuni omu nsi y'Abaamoni kumuyaagira. <verse eid="1CH 19:2" /><verse number="3" style="v" sid="1CH 19:3" />Kwonka abanyiginya b'Abaamoni baagira Hanuni bati: Noogira ngu Daudi okukwoherereza ab'okukuyaagira n'okuha sho ekitiinisa? Torikumanya ku ayohereize abagaragwa be kwetegyereza ensi n'okugitata, ngu abone kugicwekyereza? <verse eid="1CH 19:3" /><verse number="4" style="v" sid="1CH 19:4" />N'ahabw'ekyo Hanuni yaakwata abagaragwa ba Daudi, yaabamwa ebireju by'orubaju rumwe, yaacegyeta ebijwaro byabo okugarukira aha bibunu, yaaboohereza; baagyenda. <verse eid="1CH 19:4" /><verse number="5" style="v" sid="1CH 19:5" />Ku baagambiire Daudi eby'abo bashaija, yaatuma ab'okubabugana, ahabw'okuba bakaba baine enshoni nyingi. Omugabe yaagira ati: Mugume Yeriko, okuhitsya ahu obureju bwanyu buraakurire, mukabona kwija.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6" />Abaamoni ku baamanyire ngu beetamiise Daudi, Hanuni n'Abaamoni baayohereza etalanta z'efeeza rukumi kupangisa ebigaari n'okuguriirira abarikugyendera aha mbaraasi, ebya Mesopotamia, Aramu-maaka na Zooba. <verse eid="1CH 19:6" /><verse number="7" style="v" sid="1CH 19:7" />Baapangisa ebigaari obukumi bushatu n'enkumi ibiri, baaguriirira omugabe wa Maaka n'eihe rye, baija, baateera orusiisira aharikureeba Medeba. Kandi Abaamoni baaruga omu ndembo zaabo, baateeranira hamwe kuza kurwana. <verse eid="1CH 19:7" /><verse number="8" style="v" sid="1CH 19:8" />Daudi ku yaakihuriire, yaayohereza Yoabu n'eihe ryona ey'amamanzi. <verse eid="1CH 19:8" /><verse number="9" style="v" sid="1CH 19:9" />Abaamoni baashohora, baatenga orugamba aha irembo ry'orurembo, kandi abagabe, abaabaire baizire kuhurura, bakaba bari ahakwabo omu ishwa.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10" />Yoabu ku yaareebire engabo zimuri omu maisho n'enyima, yaatoorana abashaija entoore omu Baisraeli, yaabatengyesa orugamba kurwana n'Abaisira; <verse eid="1CH 19:10" /><verse number="11" style="v" sid="1CH 19:11" /><note caller="-" style="x"><char style="xo" closed="false">19:11: </char><char style="xt" closed="false"><ref loc="1CH 18:12">1 Bus 18:12</ref>. </char></note> abandi boona yaabaha omurumuna Abishai, nabo baatenga orugamba kurwana n'Abaamoni. <verse eid="1CH 19:11" /><verse number="12" style="v" sid="1CH 19:12" />Yoabu yaagira ati: Abasiria ku barankize amaani, oije ompe emikono; kandi naiwe Abaamoni ku baarakukize amaani, naanye niinyija kugikuha. <verse eid="1CH 19:12" /><verse number="13" style="v" sid="1CH 19:13" />Guma, turwane mashaija ahabw'eihanga ryaitu, n'ahabw'endembo za Ruhanga waitu; kandi MUKAMA akore eki arikusiima. <verse eid="1CH 19:13" /><verse number="14" style="v" sid="1CH 19:14" />Atyo Yoabu n'engabo ezi yaabaire aine bairira haihi kurwanisa Abasiria baahunga. <verse eid="1CH 19:14" /><verse number="15" style="v" sid="1CH 19:15" />Abaamoni ku baareebire Abasiria baahunga, nabo baahunga Abishai murumuna wa Yoabu, baayeroha omu rurembo. Bwanyima Yoabu yaatabaaruka, yaaza Yerusaalemu.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16" />Kwonka Abasiria ku baareebire baabingwa Abaisraeli, baatuma entumwa, baahuruza Abasiria aba seeri y'omugyera Furaati, baija beebembeirwe Shofaki omukuru w'eihe ry'engabo za Hadadezeeri. <verse eid="1CH 19:16" /><verse number="17" style="v" sid="1CH 19:17" />Ku baakigambiire Daudi, nawe yaateerana Israeli yoona, baayambuka Yorudani, baahika ahu Abasiria baabaire bari, baatenga orugamba kubarwanisa. Daudi ku yaatengire orugamba kurwanisa Abasiria, baarwana nawe. <verse eid="1CH 19:17" /><verse number="18" style="v" sid="1CH 19:18" />Abasiria baahunga Abaisraeli; Daudi yaabaitamu abantu abarikurwanira omu bigaari enkumi mushanju, n'arikugyendesa ebigyere obukumi buna, yaita na Shofaki omukuru w'eihe ryabo. <verse eid="1CH 19:18" /><verse number="19" style="v" sid="1CH 19:19" />Abagaragwa ba Hadadezeeri ku baareebire baasingurwa Abaisraeli baayehongyera Daudi, baahinduka abairu be. N'ahabw'ekyo Abasiria baayanga kugaruka kuha Abaamoni emikono obundi.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">Daudi okusingura Abaamoni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 11:1">1 Sam 11:1</ref>; <ref loc="2SA 12:26">2 Sam 12:26</ref>. </char>
    </note> Omu kutandika kw'omwaka, omu bunaku obu abagabe baabaire bahururiramu, Yoabu akahurura, ayebembeire eihe, yaacwekyereza ensi y'Abaamoni, yaagyenda, yaagota Rabba; kwonka Daudi akaba ayetsigariire Yerusaalemu. Yoabu yaateera Rabba, yaagicwekyereza. <verse eid="1CH 20:1" /><verse number="2" style="v" sid="1CH 20:2" /><note caller="-" style="x"><char style="xo" closed="false">20:2: </char><char style="xt" closed="false"><ref loc="2SA 12:30">2 Sam 12:30</ref>, <ref loc="2SA 12:31">31</ref>. </char></note> Daudi yaiha omugabe waabo ekirunga aha mutwe; yaashanga kiine oburemeezi bw'etalanta emwe y'ezaabu, kandi kikaba kirimu eibaare ry'obuguzi bwingi; baakita ha mutwe gwa Daudi. Kandi omuri orwo rurembo yaanyagamu eminyago mingi munonga. <verse eid="1CH 20:2" /><verse number="3" style="v" sid="1CH 20:3" />Yaihamu abantu abaabaire barimu, yaabashara n'empango; okwo nikwo Daudi yaagizire endembo zoona ez'Abaamoni. Bwanyima Daudi n'engabo zoona baagaruka Yerusaalemu.<verse eid="1CH 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:4-8: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 21:18-22">2 Sam 21:18-22</ref>. </char>
    </note> Bwanyima y'ebyo haabaho orugamba n'Abafilistia Gezeri; omuri orwo rugamba Sibekai owa Husha yaita Sipai ow'omuri baijukuru b'ebikaaka; Abafilistia baacwa eishaija. <verse eid="1CH 20:4" /><verse number="5" style="v" sid="1CH 20:5" />Haagaruka haabaho orugamba n'Abafilistia; Elihanani mwene Yairi yaitu Lahumi, murumuna wa Goliasi owa Gaasi, ou orubango rw'eicumu rye rwabaire nirwigangana empimbi ei barukiraho emyenda. <verse eid="1CH 20:5" /><verse number="6" style="v" sid="1CH 20:6" />Kandi haagaruka haabaho orugamba Gaasi. Okwo hakaba hariyo omushaija muraingwa munonga, owaabaire aine enkumu mukaaga ahari buri ngaro, n'enkumu z'ebigyere mukaaga ahari buri kigyere, zoona makumi abiri na ina; nawe akaba ari ow'omuri baijukuru b'ebikaaka. <verse eid="1CH 20:6" /><verse number="7" style="v" sid="1CH 20:7" /><note caller="-" style="x"><char style="xo" closed="false">20:7: </char><char style="xt" closed="false"><ref loc="1CH 2:13">1 Bus 2:13</ref>. </char></note> Ku yaahigire Abaisraeli, Yonasaani mwene Shimei mukuru wa Daudi yaamwita. <verse eid="1CH 20:7" /><verse number="8" style="v" sid="1CH 20:8" />Abo boona bakaba bari baijukuru b'ebikaaka bya Gaasi; baitwa Daudi n'abashaija be.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">Sitaane okwosya Daudi kubara Abaisraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:1-28: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 24:1-25">2 Sam 24:1-25</ref>.</char>
    </note> Sitaane akeemerera kurwanisa Israeli, yaayosya Daudi kubara Abaisraeli.<note caller="-" style="x"><char style="xo" closed="false">21:1</char><char style="xt" closed="false"><ref loc="JOB 1:6-12">Yob 1:6-12</ref>; <ref loc="JOB 2:1-7">2:1-7</ref>. </char></note> <verse eid="1CH 21:1" /><verse number="2" style="v" sid="1CH 21:2" />N'ahabw'ekyo Daudi yaagira Yoabu n'abakuru b'eihe ati: Mugyende, mubare Abaisraeli okuruga Beeri-sheba okuhika Daani, mwije mungambire, mbone kumanya omubaro gwabo. <verse eid="1CH 21:2" /><verse number="3" style="v" sid="1CH 21:3" />Kwonka Yoabu yaagira ati: MUKAMA ayongyere aha bantu be okukira oku bari emirundi igana! Mukama wangye omugabe, abo boona t'abairu baawe? Mbwenu eki nookyendera ki, mukama wangye? Ahabw'enki nooyenda kureetera Abaisraeli orubanja? <verse eid="1CH 21:3" /><verse number="4" style="v" sid="1CH 21:4" />Kwonka ekigambo ky'omugabe kyakiza ebya Yoabu amaani. Yoabu nikwo kugyenda naaraba omuri Israeli yoona, akagaruka Yerusaalemu. <verse eid="1CH 21:4" /><verse number="5" style="v" sid="1CH 21:5" />Ku yaahikireyo, Yoabu yaaha Daudi omubaro gw'abantu abu yaabazire. Omuri Israeli yoona hakaba harimu abashaija enkwata-rurara akakaikuru n'akasiriira kamwe, n'omuri Yuda abashaija enkwata-rurara obusiriira buna n'obukumi mushanju. <verse eid="1CH 21:5" /><verse number="6" style="v" sid="1CH 21:6" /><note caller="-" style="x"><char style="xo" closed="false">21:6: </char><char style="xt" closed="false"><ref loc="1CH 27:24">1 Bus 27:24</ref>. </char></note> Kwonka omuri okwo kubara tiyaabariramu Baleevi n'obu baakuba Ababenyamiini; ahakuba ekiragiro ky'omugabe kikaba kimutamire. <verse eid="1CH 21:6" /><verse number="7" style="v" sid="1CH 21:7" />Kwonka ekigambo ekyo kyagwisa kubi Ruhanga, n'ahabw'ekyo yaateera Israeli. <verse eid="1CH 21:7" /><verse number="8" style="v" sid="1CH 21:8" /><note caller="-" style="x"><char style="xo" closed="false">21:8: </char><char style="xt" closed="false"><ref loc="2SA 12:13">2 Sam 12:13</ref>. </char></note> Daudi yaagira Ruhanga ati: Ncumwire munonga ahabw'ekyo eki nkozire. Kwonka hati ninkweshengyereza iha aha mwiru waawe okutahikiirira, ahakuba ndengyesereize, naakora eky'obufa-mutima. <verse eid="1CH 21:8" /><verse number="9" style="v" sid="1CH 21:9" /><note caller="-" style="x"><char style="xo" closed="false">21:9: </char><char style="xt" closed="false"><ref loc="1SA 9:9">1 Sam 9:9</ref>; <ref loc="1CH 29:29">1 Bus 29:29</ref>. </char></note> MUKAMA yaagambira Gaadi omuhanuuzi wa Daudi ati: <verse eid="1CH 21:9" /><verse number="10" style="v" sid="1CH 21:10" />Gyenda ogambire Daudi oti: Oku nikwo MUKAMA arikugamba naagira ati: Naakuha ebintu bishatu, oiheho kimwe, mbe nikyo naakukora. <verse eid="1CH 21:10" /><verse number="11" style="v" sid="1CH 21:11" />Atyo Gaadi yaija ahari Daudi, yaamugira ati: Oku nikwo MUKAMA arikugamba naagira ati: Ahari ebi byonshatu tooranaho kimwe eki orikwenda; <verse eid="1CH 21:11" /><verse number="12" style="v" sid="1CH 21:12" />emyaka eshatu y'enjara; nari okucwekyerezibwa abazigu baawe, noitwa rurara yaabo okumara ameezi ashatu, nari ebiro bishatu bya rurara ya MUKAMA, orufu okujuumikira ensi, kandi na maraika wa MUKAMA naacwekyereza ensi ya Israeli yoona. Mbwenu gira eki waihamu, ongambire eki ndaagarukyemu ontumire. <verse eid="1CH 21:12" /><verse number="13" style="v" sid="1CH 21:13" />Daudi yaagira Gaadi ati: Naashobererwa kimwe; ka ngwe omu mikono ya MUKAMA, ahakuba embabazi ze ni nyingi munonga; ndekye kugwa omu mikono y'abantu.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14" />N'ahabw'ekyo MUKAMA yaajuumikiza Israeli orufu, haafa Abaisraeli obukumi mushanju. <verse eid="1CH 21:14" /><verse number="15" style="v" sid="1CH 21:15" /><note caller="-" style="x"><char style="xo" closed="false">21:15: </char><char style="xt" closed="false"><ref loc="GEN 6:6">Kut 6:6</ref>. </char></note> Ruhanga yaatuma maraika Yerusaalemu kugicwekyereza; kwonka ku yaabaire ari haihi kugicwekyereza, MUKAMA yaareeba, yaayegarukamu ahabw'ako kabi; yaagira maraika owaabaire naacwekyereza, ati: Ekyo nikimara; banguura omukono. Obwo maraika wa MUKAMA akaba ari haihi n'embuga ya Orunaani Omuyebusi. <verse eid="1CH 21:15" /><verse number="16" style="v" sid="1CH 21:16" /><note caller="-" style="x"><char style="xo" closed="false">21:16: </char><char style="xt" closed="false"><ref loc="2SA 3:31">2 Sam 3:31</ref>. </char></note> Daudi yaimutsya amaisho, yaareeba maraika wa MUKAMA ayemereire ahagati y'ensi n'eiguru, asyoireyo rurara, agyorekyeize Yerusaalemu. Ahonaaho Daudi n'abakuru baagwa ahansi bajuumaire, bajwaire ebiguniya. <verse eid="1CH 21:16" /><verse number="17" style="v" sid="1CH 21:17" />Daudi yaagira Ruhanga ati: Tiinye ndagiire kubara abantu? Niinye ncumwire, nkakora kuba munonga. Mbwenu entaama ezi zo zikozire ki? Ninkweshengyereza, MUKAMA Ruhanga wangye, ba niinye waarwanisa n'enju ya tata; kwonka orekye kureeta orufu aha bantu baawe.<verse eid="1CH 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:18: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 3:1">2 Bus 3:1</ref>. </char>
    </note> Bwanyima maraika wa MUKAMA yaaragiira Gaadi kugambira Daudi ngu ainamukye ayombekyere MUKAMA eitambiro aha mbuga ya Orunaani Omuyebusi. <verse eid="1CH 21:18" /><verse number="19" style="v" sid="1CH 21:19" />Atyo Daudi yainamuka ahabw'ekigambo kya Gaadi, eki yaagamba omu iziina rya MUKAMA. <verse eid="1CH 21:19" /><verse number="20" style="v" sid="1CH 21:20" />Obwo Orunaani akaba naahuura engano; yaahinduka, yaareeba maraika, batabani be bana, abu yaabaire aine, baayeshereka. <verse eid="1CH 21:20" /><verse number="21" style="v" sid="1CH 21:21" />Daudi ku yaabaire naizira Orunaani, Orunaani yaimutsya amaisho, yaamureeba, ahonaaho yaaruga aha mbuga, yainama, yaamutangirira. <verse eid="1CH 21:21" /><verse number="22" style="v" sid="1CH 21:22" />Daudi yaagira Orunaani ati: Mpa ekibanja eki embuga yaawe erimu, nyombekyeremu MUKAMA eitambiro, orufu rubone kuruga aha bantu; kandi okinguze aha buguzi bwakyo bwona obukishemereire. <verse eid="1CH 21:22" /><verse number="23" style="v" sid="1CH 21:23" />Orunaani yaagira Daudi ati: Kitware, Nyakusinga omugabe! Okore eki orikusiima kyona; reeba, naakuha ente z'ebitambo by'okwotsya, n'ebihuuzo obiihemu enkum n'engano ogiihemu empongano y'esaano. Byona naabikuha. <verse eid="1CH 21:23" /><verse number="24" style="v" sid="1CH 21:24" />Kwonka omugabe Daudi yaagira Orunaani ati: Ngaaha! Kureka niinyija kukigura aha buguzi bwakyo bwona obukishemereire. Tindikwija kuhongyera MUKAMA ebyawe, n'obu kwakuba okutamba ebitambo eby'okwotsya, ebi ntaheereire byangye. <verse eid="1CH 21:24" /><verse number="25" style="v" sid="1CH 21:25" />Atyo Daudi yaarenga shekeli z'ezaabu magana mukaaga, yaaziihura Orunaani ahabw'ekibanja. <verse eid="1CH 21:25" /><verse number="26" style="v" sid="1CH 21:26" /><note caller="-" style="x"><char style="xo" closed="false">21:26: </char><char style="xt" closed="false"><ref loc="LEV 9:24">Lev 9:24</ref>. </char></note> Bwanyima Daudi yaayombekyerayo MUKAMA eitambiro, yaamuhongyera ebitambo by'okwotsya n'empongano z'okusiima ahabw'obusingye, yaashaba MUKAMA, nawe yaamugarukamu n'omuriro ogurikuruga omu iguru, gwagwa aha itambiro ry'ebitambo eby'okwotsya. <verse eid="1CH 21:26" /><verse number="27" style="v" sid="1CH 21:27" />Ahonaaho MUKAMA yaaragiira maraika; yaagarura rurara ye omu kyobati kyayo.<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 21:28" />Omu bunaku obwo Daudi ku yaareebire MUKAMA amugarukiiremu aha mbuga ya Orunaani Omuyebusi, yaatambirayo ebitambo. <verse eid="1CH 21:28" /><verse number="29" style="v" sid="1CH 21:29" /><note caller="-" style="x"><char style="xo" closed="false">21:29: </char><char style="xt" closed="false"><ref loc="1CH 16:39">1 Bus 16:39</ref>. </char></note> Ahakuba Eihema rya MUKAMA, eri Musa yaakoreire omu ihamba, n'eitambiro ry'ebitambo by'okwotsya omu biro ebyo bikaba biri Gibeoni omu mwanya mukru gw'okuramizamu. <verse eid="1CH 21:29" /><verse number="30" style="v" sid="1CH 21:30" />Kwonka Daudi tiyaabaasa kuza omu maisho gaaryo kwehanuuza ahari Ruhanga, ahabw'okuba akaba atiinire rurara ya maraika wa MUKAMA.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="s1">Daudi okweteguurira okwombeka hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 21:18">1 Bus 21:18</ref>, <ref loc="1CH 21:19">19</ref>, <ref loc="1CH 21:26">26</ref>, <ref loc="1CH 21:28">28</ref>; <ref loc="2CH 3:1">2 Bus 3:1</ref>. </char>
    </note> Bwanyima Daudi yaagira ati: Aha niho enju ya MUKAMA Ruhanga eriba, kandi n'eitambiro ry'okwokyezaho ebitambo ahabwa Israeli.<verse eid="1CH 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:2: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 5:17">1 Bag 5:17</ref>; <ref loc="1KI 9:20">9:20</ref>, <ref loc="1KI 9:21">21</ref>; <ref loc="2CH 2:17">2 Bus 2:17</ref>. </char>
    </note> Daudi yaaragiira kuteeranira hamwe abanyamahanga abaabaire bari omu nsi ya Israeli, yaata ababaizi b'amabaare kubaija ag'okwombekyesa enju ya Ruhanga. <verse eid="1CH 22:2" /><verse number="3" style="v" sid="1CH 22:3" /><note caller="-" style="x"><char style="xo" closed="false">22:3: </char><char style="xt" closed="false"><ref loc="1KI 7:47">1 Bag 7:47</ref>. </char></note> Kandi yaateekateeka ebyoma bingi by'okuheeshamu emisumaari y'enyigi z'amarembo, n'emiringa mingi munonga erengire kigyero, <verse eid="1CH 22:3" /><verse number="4" style="v" sid="1CH 22:4" /><note caller="-" style="x"><char style="xo" closed="false">22:4: </char><char style="xt" closed="false"><ref loc="1KI 5:6">1 Bag 5:6</ref>. </char></note> n'ebiti by'emyereezi ebitarikubarwa; ahabw'okuba Abasidoni n'Abatuuro bakareetera Daudi emyereezi mingi. <verse eid="1CH 22:4" /><verse number="5" style="v" sid="1CH 22:5" /><note caller="-" style="x"><char style="xo" closed="false">22:5: </char><char style="xt" closed="false"><ref loc="1KI 3:7">1 Bag 3:7</ref>; <ref loc="1CH 29:1">1 Bus 29:1</ref>; <ref loc="PRO 4:3">Enf 4:3</ref>. </char></note> Ahakuba Daudi akagira ati: Sulemaani mutabani wangye akiri muto, takahamire, kandi enju erikwija kwombekyerwa MUKAMA eshemereire kuba ey'ekitiinisa kingi munonga, ekarangaanwa, ekahimbisibwa omu nsi zoona; n'ahabw'ekyo niinyija kugiteekateekyera eby'okugyombeka. Atyo Daudi yaateekateeka ebintu bingi munonga atakafiire.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6" />Bwanyima yaayeta omutabani Sulemaani, yaamwehanangiriza kwombekyera MUKAMA Ruhanga wa Israeli enju. <verse eid="1CH 22:6" /><verse number="7" style="v" sid="1CH 22:7" /><note caller="-" style="x"><char style="xo" closed="false">22:7: </char><char style="xt" closed="false"><ref loc="2SA 7:2">2 Sam 7:2</ref>, <ref loc="2SA 7:3">3</ref>; <ref loc="1KI 8:17">1 Bag 8:17</ref>; <ref loc="1CH 17:1">1 Bus 17:1</ref>, <ref loc="1CH 17:2">2</ref>; <ref loc="1CH 28:2">28:2</ref>; <ref loc="PSA 132:1-5">Zab 132:1-5</ref>. </char></note> Yaagira Sulemaani ati: Mwana wangye, nkashangwa nkiine aha mutima kwombekyera eiziina rya MUKAMA Ruhanga wangye enju. <verse eid="1CH 22:7" /><verse number="8" style="v" sid="1CH 22:8" /><note caller="-" style="x"><char style="xo" closed="false">22:8: </char><char style="xt" closed="false"><ref loc="1KI 5:3">1 Bag 5:3</ref>; <ref loc="1CH 28:3">1 Bus 28:3</ref>. </char></note> Kwonka ekigambo kya MUKAMA kyanyizira, nikigira kiti: Okasheesha eshagama nyingi, waarwana engamba nyingi; toryombekyera iziina ryangye nju, ahabw'okuba okasheesha eshagama nyingi omu maisho gangye. <verse eid="1CH 22:8" /><verse number="9" style="v" sid="1CH 22:9" /><note caller="-" style="x"><char style="xo" closed="false">22:9: </char><char style="xt" closed="false"><ref loc="2SA 12:24">2 Sam 12:24</ref>; <ref loc="1KI 4:25">1 Bag 4:25</ref>; <ref loc="1KI 5:4">5:4</ref>. </char></note> Reeba, oryazaarirwa omwana, abe ow'obusingye; kandi ndyamuha obusingye aha bazigu be boona abariba bamwehinguririize; ahakuba eiziina rye aryayetwa Sulemaani; kandi omu biro bye ndyaha Israeli obusingye n'okutuuza. <verse eid="1CH 22:9" /><verse number="10" style="v" sid="1CH 22:10" /><note caller="-" style="x"><char style="xo" closed="false">22:10: </char><char style="xt" closed="false"><ref loc="2SA 7:13">2 Sam 7:13</ref>, <ref loc="2SA 7:14">14</ref>; <ref loc="1CH 28:6">1 Bus 28:6</ref>; <ref loc="HEB 1:5">Heb 1:5</ref>. </char></note> Ogwo niwe aryombekyera eiziina ryangye enju. Aryaba omwana wangye, naanye mbe ishe; kandi ndyahamya ekitebe ky'obugabe bwe omuri Israeli ebiro byona. <verse eid="1CH 22:10" /><verse number="11" style="v" sid="1CH 22:11" />Mbwenu, mwana wangye, MUKAMA agume naiwe, obone kwombeka enju ya MUKAMA Ruhanga waawe, ogiheze gye, nk'oku yaakugambireho. <verse eid="1CH 22:11" /><verse number="12" style="v" sid="1CH 22:12" /><note caller="-" style="x"><char style="xo" closed="false">22:12: </char><char style="xt" closed="false"><ref loc="1KI 3:9">1 Bag 3:9</ref>, <ref loc="1KI 3:12">12</ref>; <ref loc="PSA 72:1">Zab 72:1</ref>. </char></note> Kwonka, MUKAMA akuhe obwengye n'okwetegyereza, ku araakutegyekyese Israeli, oyorobere ebiragiro bya MUKAMA Ruhanga waawe. <verse eid="1CH 22:12" /><verse number="13" style="v" sid="1CH 22:13" /><note caller="-" style="x"><char style="xo" closed="false">22:13: </char><char style="xt" closed="false"><ref loc="1CH 28:7">1 Bus 28:7</ref>; <ref loc="DEU 31:6">Bir 31:6</ref>. </char></note> Obwo, ku orita omutima ha kworobera ebiragiro n'ebyatairweho ebi MUKAMA yaaragiira Musa ahabwa Israeli, oryaba gye. Ba ow'amaani, ogume; otatiina, kandi otahahaaza omutima. <verse eid="1CH 22:13" /><verse number="14" style="v" sid="1CH 22:14" /><note caller="-" style="x"><char style="xo" closed="false">22:14: </char><char style="xt" closed="false"><ref loc="1CH 29:4">1 Bus 29:4</ref>. </char></note> Reeba, omu kufa kubi kwangye nteekateekyeire enju ya MUKAMA etalanta z'ezaabu akasiriira kamwe, n'ez'efeeza akakaikuru, n'emiringa n'ebyoma ebirengire ekigyero, ahabw'okuba ni bingi munoga; kandi nteekateekire embaaho n'amabaare. Ahari ebyo naiwe oryayongyeraho. <verse eid="1CH 22:14" /><verse number="15" style="v" sid="1CH 22:15" />Kandi oine abakozi baingi munonga, ababaizi b'amabaare, abombeki, ababaizi, abanyamyoga b'emiringo yoona abatarikubarwa, <verse eid="1CH 22:15" /><verse number="16" style="v" sid="1CH 22:16" />abarikumanya kukoresa ezaabu, efeeza, emiringa n'ebyoma. Imuka okore! MUKAMA agume naiwe.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:17: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 28:1-6">1 Bus 28:1-6</ref>. </char>
    </note> Kandi Daudi yaaragiira abakuru ba Israeli boona kuhwera omutabani Sulemaani naagira ati: <verse eid="1CH 22:17" /><verse number="18" style="v" sid="1CH 22:18" /><note caller="-" style="x"><char style="xo" closed="false">22:18: </char><char style="xt" closed="false"><ref loc="1CH 23:25">1 Bus 23:25</ref>; <ref loc="2SA 7:1">2 Sam 7:1</ref>; <ref loc="JOS 21:44">Yos 21:44</ref>; <ref loc="JOS 23:1">23:1</ref>. </char></note> Timurikumanya MUKAMA Ruhanga waanyu, ku ari hamwe naimwe? Kandi tabahaire obusingye embaju zoona? Ahabw'okuba akahayo abatuuzi b'ensi egi omu mikono yangye; kandi ensi egomoirwe omu maisho ga MUKAMA n'omu maisho g'abantu be. <verse eid="1CH 22:18" /><verse number="19" style="v" sid="1CH 22:19" /><note caller="-" style="x"><char style="xo" closed="false">22:19: </char><char style="xt" closed="false"><ref loc="1KI 5:3">1 Bag 5:3</ref>; <ref loc="1KI 8:6">8:6</ref>, <ref loc="1KI 8:21">21</ref>; <ref loc="2CH 20:3">2 Bus 20:3</ref>. </char></note> Mbwenu mute omutima gwanyu gwona aha kusherura MUKAMA Ruhanga waanyu. Mwimukye, mwombekye Omwanya ogurikwera ogwa MUKAMA Ruhanga waanyu, mubone kureeta eshanduukye y'endagaano ya MUKAMA, n'ebintu ebirikwera bya Ruhanga, omu nju eryombekyerwa eiziina rye.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">Daudi okwemeka omutabani Sulemaani</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 29:22">1 Bus 29:22</ref>, <ref loc="1CH 29:28">28</ref>; <ref loc="1KI 1:33-39">1 Bag 1:33-39</ref>. </char>
    </note> Daudi ku yaakuzire, yaahika omu ngingo zaabukuru, yaayemeka omutabani Sulemaani kuba omugabe wa Israeli.<verse eid="1CH 23:1" /></para>
  <para style="s1">Daudi okubaganisiza Abaleevi emirimo</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2" />Yaateeranira hamwe abakuru ba Israeli boona, n'abanyamurwa n'Abaleevi. <verse eid="1CH 23:2" /><verse number="3" style="v" sid="1CH 23:3" /><note caller="-" style="x"><char style="xo" closed="false">23:3: </char><char style="xt" closed="false"><ref loc="1CH 23:24">1 Bus 23:24</ref>; <ref loc="NUM 4:3">Kub 4:3</ref>, <ref loc="NUM 4:47">47</ref>, <ref loc="NUM 4:48">48</ref>. </char></note> Batyo baabara Abaleevi abahikize emyaka makumi ashatu n'abagirengize, boona baaba abashaija obukumi bushatu n'enkumi munaana. <verse eid="1CH 23:3" /><verse number="4" style="v" sid="1CH 23:4" /><note caller="-" style="x"><char style="xo" closed="false">23:4: </char><char style="xt" closed="false"><ref loc="DEU 16:18">Bir 16:18</ref>; <ref loc="DEU 21:5">21:5</ref>; <ref loc="1CH 26:29">1 Bus 26:29</ref>; <ref loc="2CH 19:8">2 Bus 19:8</ref>; <ref loc="2CH 34:13">34:13</ref>; <ref loc="EZR 3:8">Ezr 3:8</ref>, <ref loc="EZR 3:9">9</ref>. </char></note> Daudi yaagira ati: Omuri aba, obukumi bubiri n'enkumi ina bakwatsibwe omurimo gw'okuheereza omu nju ya MUKAMA, enkumi mukaaga babe abatware n'abaramuzi, <verse eid="1CH 23:4" /><verse number="5" style="v" sid="1CH 23:5" /><note caller="-" style="x"><char style="xo" closed="false">23:5: </char><char style="xt" closed="false"><ref loc="2CH 29:25">2 Bus 29:25</ref>, <ref loc="2CH 29:26">26</ref>; <ref loc="NEH 12:36">Neh 12:36</ref>. </char></note> enkumi ina babe abarinzi b'amarembo, kandi enkumi ina babe ab'okuhimbisa MUKAMA n'ebintu ebi nkozire ahabw'okuhimbisa. <verse eid="1CH 23:5" /><verse number="6" style="v" sid="1CH 23:6" /><note caller="-" style="x"><char style="xo" closed="false">23:6: </char><char style="xt" closed="false"><ref loc="1CH 6:1">1 Bus 6:1</ref>, <ref loc="1CH 6:16">16</ref>; <ref loc="2CH 23:18">2 Bus 23:18</ref>; <ref loc="2CH 35:4">35:4</ref>. </char></note> Daudi yaabacwamu ebicweka nk'oku batabani ba Leevi baabaire bari: Gereshoni, Kohasi na Merari.<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 23:7" />Batabani ba Gereshoni bakaba bari Ladani na Shimei. <verse eid="1CH 23:7" /><verse number="8" style="v" sid="1CH 23:8" /><note caller="-" style="x"><char style="xo" closed="false">23:8: </char><char style="xt" closed="false"><ref loc="1CH 6:21">1 Bus 6:21</ref>; <ref loc="1CH 29:8">29:8</ref>. </char></note> Beene Ladani: omukuru Yehieli, naakuratwa Zesamu na Yoeli, boona bashatu. <verse eid="1CH 23:8" /><verse number="9" style="v" sid="1CH 23:9" />Beene Shimei, Shelomiisi, Hazieli, na Harani, boona bashatu. Abo nibo baabaire bari abakuru b'amaju ga baishenkuru ba Ladani. <verse eid="1CH 23:9" /><verse number="10" style="v" sid="1CH 23:10" />Beene Shimei, Yahasi, Ziina, Yeushi na Beria. Abo bana bakaba bari beene Shimei. <verse eid="1CH 23:10" /><verse number="11" style="v" sid="1CH 23:11" />Yahasi niwe yaabaire ari mukuru, naakuratwa Ziiza, kwonka Yeushi na Beria bakaba bataine baana b'aboojo baingi; nikyo kyabareeteire kubarwa nk'ab'enju emwe eya baishenkurubo.<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 23:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:12: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 6:18">1 Bus 6:18</ref>; <ref loc="NUM 3:19">Kub 3:19</ref>. </char>
    </note> Batabani ba Kohasi: Amuraamu, Izuhaari, Heburooni na Uzieli, boona bana. <verse eid="1CH 23:12" /><verse number="13" style="v" sid="1CH 23:13" /><note caller="-" style="x"><char style="xo" closed="false">23:13: </char><char style="xt" closed="false"><ref loc="EXO 6:20">Kur 6:20</ref>; <ref loc="EXO 28:1">28:1</ref>; <ref loc="EXO 30:7">30:7</ref>; <ref loc="NUM 6:23">Kub 6:23</ref>; <ref loc="HEB 5:4">Heb 5:4</ref>. </char></note> Beene Amuraamu, Arooni na Musa. Kandi Arooni ogwo niwe yaashoroirwe kuba ow'okweza ebintu ebirikwera munonga, we n'oruzaaro rwe kuguma nibootera obubaane omu maisho ga MUKAMA nibamuheereza, kandi n'okushabira abantu omugisha omu iziina rye ebiro byona. <verse eid="1CH 23:13" /><verse number="14" style="v" sid="1CH 23:14" /><note caller="-" style="x"><char style="xo" closed="false">23:14: </char><char style="xt" closed="false"><ref loc="1CH 26:23-25">1 Bus 26:23-25</ref>; <ref loc="DEU 33:1">Bir 33:1</ref>. </char></note> Kwonka beene Musa omushaija wa Ruhanga bakaba nibabarirwa omu ruganda rwa Leevi. <verse eid="1CH 23:14" /><verse number="15" style="v" sid="1CH 23:15" />Beene Musa, Gereshoni na Eliezeeri. <verse eid="1CH 23:15" /><verse number="16" style="v" sid="1CH 23:16" /><note caller="-" style="x"><char style="xo" closed="false">23:16: </char><char style="xt" closed="false"><ref loc="EXO 2:22">Kur 2:22</ref>; <ref loc="EXO 18:3">18:3</ref>, <ref loc="EXO 18:4">4</ref>. </char></note> Beene Gereshoni omukuru ni Shebueli. <verse eid="1CH 23:16" /><verse number="17" style="v" sid="1CH 23:17" />Beene Eliezeeri; Rehabia, niwe yaabaire ari mukuru, kandi Eliezeeri akaba ataine bandi baana b'aboojo, kwonka beene Rehabia bakaba bari baingi munonga. <verse eid="1CH 23:17" /><verse number="18" style="v" sid="1CH 23:18" />Beene Izuhaari, Shelomiisi niwe yaabaire ari mukuru. <verse eid="1CH 23:18" /><verse number="19" style="v" sid="1CH 23:19" /><note caller="-" style="x"><char style="xo" closed="false">23:19: </char><char style="xt" closed="false"><ref loc="1CH 26:31">1 Bus 26:31</ref>. </char></note> Beene Heburooni, Yeria niwe yaabaire ari mukuru, owa kabiri Amaria, owa kashatu Yahazieli, n'owa kana Yekameamu. <verse eid="1CH 23:19" /><verse number="20" style="v" sid="1CH 23:20" />Beene Uzieli, Miika niwe yaabaire ari mukuru, naakuratwa Ishia.<verse eid="1CH 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 23:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:21: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 6:19">Kur 6:19</ref>; <ref loc="1CH 6:19">1 Bus 6:19</ref>, <ref loc="1CH 6:29">29</ref>. </char>
    </note> Batabani ba Merari: Mahili na Muushi; beene Mahili, Eleazaari na Kiishi. <verse eid="1CH 23:21" /><verse number="22" style="v" sid="1CH 23:22" /><note caller="-" style="x"><char style="xo" closed="false">23:22: </char><char style="xt" closed="false"><ref loc="NUM 36:6">Kub 36:6</ref>, <ref loc="NUM 36:8">8</ref>. </char></note> Eleazaari yaafa atazaire baana b'aboojo, kureka abaishiki bonka; beene waabo batabani ba Kiishi baabashwera. <verse eid="1CH 23:22" /><verse number="23" style="v" sid="1CH 23:23" />Beene Muushi, Mahili, Ederi na Yeremoosi, boona bashatu.<verse eid="1CH 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 23:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:24: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 4:3">Kub 4:3</ref>; <ref loc="NUM 8:24">8:24</ref>; <ref loc="NUM 10:17">10:17</ref>, <ref loc="NUM 10:21">21</ref>. </char>
    </note> Abo nibo baabaire bari batabani ba Leevi, nk'amaju ga baishenkurubo oku gaabaire gari, kandi inibo bakuru b'amaju ga baishenkurubo, nk'oku baahandiikirwe, nibakuratira amaziina gaabo buri omwe, abahikize emyaka makumi abiri n'abagirengize, abaabaire bari ab'okukora omurimo gw'okuheereza omu nju ya MUKAMA. <verse eid="1CH 23:24" /><verse number="25" style="v" sid="1CH 23:25" /><note caller="-" style="x"><char style="xo" closed="false">23:25: </char><char style="xt" closed="false"><ref loc="1CH 22:18">1 Bus 22:18</ref>. </char></note> Ahabw'okuba Daudi akagira ati: MUKAMA Ruhanga wa Israeli ahaire abantu be obusingye; kandi atuura omuri Yerusaalemu ebiro byona. <verse eid="1CH 23:25" /><verse number="26" style="v" sid="1CH 23:26" /><note caller="-" style="x"><char style="xo" closed="false">23:26: </char><char style="xt" closed="false"><ref loc="NUM 4:5-15">Kub 4:5-15</ref>. </char></note> N'ahabw'ekyo Abaleevi tibakyetenga kuheeka Iheka, n'obu kyakuba ekintu kyona eky'okukoresa omurimo gwaryo; <verse eid="1CH 23:26" /><verse number="27" style="v" sid="1CH 23:27" />(ahakuba ahabw'ekiragiro kya Daudi eky'aha muheru Abaleevi abahikize emyaka makumi abiri n'abagirengize bakabarwa) <verse eid="1CH 23:27" /><verse number="28" style="v" sid="1CH 23:28" />kureka omurimo gwabo guryaba okuhwera beene Arooni ahabw'obuheereza omu nju ya MUKAMA, bakwatsiibwe ebibuga, ebishengye, okushemeza ebintu byona ebirikwera, kandi n'omurimo gwona ogw'okukora aha nju ya Ruhanga; <verse eid="1CH 23:28" /><verse number="29" style="v" sid="1CH 23:29" /><note caller="-" style="x"><char style="xo" closed="false">23:29: </char><char style="xt" closed="false"><ref loc="LEV 6:20">Lev 6:20</ref>, <ref loc="LEV 6:21">21</ref>; <ref loc="LEV 19:36">19:36</ref>; <ref loc="LEV 24:5-8">24:5-8</ref>; <ref loc="1CH 9:29">1 Bus 9:29</ref>, <ref loc="1CH 9:31">31</ref>. </char></note> kandi n'okuhwera omu by'emigaati ey'okumurikwa, omu by'esaano ahabw'empongano z'esaano, omu bya capati z'emigaati etatumbisiibwe, omu by'empongano eziteekire, omu by'empongano ezijwangizemu amajuta, n'omu bigyero byona eby'okurengyesa obwingi n'obuhango. <verse eid="1CH 23:29" /><verse number="30" style="v" sid="1CH 23:30" />Buri kasheeshe baryayemerera basiime MUKAMA, nibamuhimbisa, kandi n'omu mwabazyo batyo; <verse eid="1CH 23:30" /><verse number="31" style="v" sid="1CH 23:31" /><note caller="-" style="x"><char style="xo" closed="false">23:31: </char><char style="xt" closed="false"><ref loc="LEV 23:2">Lev 23:2</ref>, <ref loc="LEV 23:4">4</ref>; <ref loc="NUM 28:9">Kub 28:9</ref>, <ref loc="NUM 28:11">11</ref>. </char></note> kandi ku bariba nibahongyera MUKAMA ebitambo by'okwotsya ahari buri sabato, nari ahari buri kuboneka kw'okwezi, nari aha biro bikuru by'amagyenyi, nk'ebiragiro byabyo oku biri, bakore batyo obutoosha omu maisho ga MUKAMA. <verse eid="1CH 23:31" /><verse number="32" style="v" sid="1CH 23:32" /><note caller="-" style="x"><char style="xo" closed="false">23:32: </char><char style="xt" closed="false"><ref loc="NUM 1:53">Kub 1:53</ref>; <ref loc="NUM 3:6-9">3:6-9</ref>. </char></note> Okwo nikwo baririnda Eihema ry'okubugaabuganiramu, kandi bakaheereza beene waabo, beene Arooni, omu buheereza bw'omu nju ya MUKAMA.<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="s1">Embu z'abanyamurwa, beene Arooni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1" />Embu za beene Arooni zikaba ziri ziti. Batabani ba Arooni: Nadabu, Abihu, Eleazaari na Itamaari. <verse eid="1CH 24:1" /><verse number="2" style="v" sid="1CH 24:2" /><note caller="-" style="x"><char style="xo" closed="false">24:2: </char><char style="xt" closed="false"><ref loc="LEV 10:2">Lev 10:2</ref>. </char></note> Kwonka Nadabu na Abihu bakabandiza ishebo kufa, kandi bakaba bataine baana; nikyo Eleazaari na Itamaari baabeereire abanyamurwa. <verse eid="1CH 24:2" /><verse number="3" style="v" sid="1CH 24:3" /><note caller="-" style="x"><char style="xo" closed="false">24:3: </char><char style="xt" closed="false"><ref loc="2SA 8:17">2 Sam 8:17</ref>; <ref loc="1CH 24:31">1 Bus 24:31</ref>. </char></note> Daudi yaahwerwa Zadoki ow'omuri beene Eleazaari, na Ahimeleki ow'omuri beene Itamaari, kubabaganisa omu buheereza bwabo nk'emirimo ei bateereirweho oku eri. <verse eid="1CH 24:3" /><verse number="4" style="v" sid="1CH 24:4" />Ahabwa beene Eleazaari kugira abantu bakuru baingi okweshumba beene Itamaari, baataho abakuru b'amaju ga baishenkurubo ikumi na mukaaga omuri beene Eleazaari, na munaana omuri beene Itamaari. <verse eid="1CH 24:4" /><verse number="5" style="v" sid="1CH 24:5" />Baababaganisa n'enteenyu, boona omu muringo gumwe; ahakuba omuri beene Eleazaari n'omuri beene Itamaari hakaba harimu abatware b'Omwanya Ogurikwera, n'abatware ba Ruhanga. <verse eid="1CH 24:5" /><verse number="6" style="v" sid="1CH 24:6" /><note caller="-" style="x"><char style="xo" closed="false">24:6: </char><char style="xt" closed="false"><ref loc="1CH 15:11">1 Bus 15:11</ref>. </char></note> Bwanyima Shemaya mwene Netaneeli omuhandiiki ow'omu Baleevi yaabahandiikira omu maisho g'omugabe n'abanyiginya, na Zadoki omunyamurwa, na Ahimeleki mwne Abiasaari, n'abakuru b'amaju ga baishenkuru b'abanyamurwa n'Abaleevi, enju emwe yaatooranirwa Eleazaari, n'endiijo Itamaari nibakuratana.<verse eid="1CH 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 24:7" />Orubu rw'okubanza rwaba orwa Yehoyaribu, orwa kabiri Yedaaya, <verse eid="1CH 24:7" /><verse number="8" style="v" sid="1CH 24:8" />orwa kashatu Harimu, orwa kana Serorimi, <verse eid="1CH 24:8" /><verse number="9" style="v" sid="1CH 24:9" />orwa kataano Malukiya, orwa mukaaga Miyamiinu, <verse eid="1CH 24:9" /><verse number="10" style="v" sid="1CH 24:10" /><note caller="-" style="x"><char style="xo" closed="false">24:10: </char><char style="xt" closed="false"><ref loc="LUK 1:5">Luk 1:5</ref>. </char></note> orwa mushanju Hakozi, orwa munaana Abiya, <verse eid="1CH 24:10" /><verse number="11" style="v" sid="1CH 24:11" />orwa mwenda Yeshua, orwa ikumi Shekaniya, <verse eid="1CH 24:11" /><verse number="12" style="v" sid="1CH 24:12" />orwa ikumi na rumwe Eliashibu, orwa ikumi na ibiri Yakimi, <verse eid="1CH 24:12" /><verse number="13" style="v" sid="1CH 24:13" />orwa ikumi na ishatu Huupa, orwa ikumi na ina Yeshebeabu, <verse eid="1CH 24:13" /><verse number="14" style="v" sid="1CH 24:14" />orwa ikumi na itaano Biluga, orwa ikumi na mukaaga Imeri, <verse eid="1CH 24:14" /><verse number="15" style="v" sid="1CH 24:15" />orwa ikumi na mushanju Heziri, orwa ikumi na munaana Hapizeezi, <verse eid="1CH 24:15" /><verse number="16" style="v" sid="1CH 24:16" />orwa ikumi na mwenda Pesahia, orwa makumi abiri Yehezekeeli, <verse eid="1CH 24:16" /><verse number="17" style="v" sid="1CH 24:17" />orwa makumi abiri na rumwe Yakini, orwa makumi abiri na ibiri Gamuli, <verse eid="1CH 24:17" /><verse number="18" style="v" sid="1CH 24:18" />orwa makumi abiri na ishatu Delaaya, orwa makumi abiri na ina Maaziya. <verse eid="1CH 24:18" /><verse number="19" style="v" sid="1CH 24:19" /><note caller="-" style="x"><char style="xo" closed="false">24:19: </char><char style="xt" closed="false"><ref loc="1CH 9:25">1 Bus 9:25</ref>. </char></note> Ezo nizo zaabaire ziri embu z'emirimo y'obuheereza bwabo okutaaha omu nju ya MUKAMA, nibakuratira emitwarize ei baateereirweho Arooni, ishenkurubo, nk'oku MUKAMA Ruhanga wa Israeli yaamuragiire.<verse eid="1CH 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 24:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:20: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 23:13">1 Bus 23:13</ref>. </char>
    </note> Kandi abandi b'omuri beene Leevi nibo aba: omuri beene Amuraamu, Shubaeli; omuri beene Shubaeli, Yehodea; <verse eid="1CH 24:20" /><verse number="21" style="v" sid="1CH 24:21" /><note caller="-" style="x"><char style="xo" closed="false">24:21: </char><char style="xt" closed="false"><ref loc="1CH 23:17">1 Bus 23:17</ref>. </char></note> Beene Rehabia; omuri beene Rehabia, omukuru Ishia. <verse eid="1CH 24:21" /><verse number="22" style="v" sid="1CH 24:22" />Beene Izuhaari: Shelomoosi; omuri beene Shelomoosi, Yahasi; <verse eid="1CH 24:22" /><verse number="23" style="v" sid="1CH 24:23" /><note caller="-" style="x"><char style="xo" closed="false">24:23: </char><char style="xt" closed="false"><ref loc="1CH 23:19">1 Bus 23:19</ref>. </char></note> Beene Heburooni: omukuru Yeria, owa kabiri Amari; owa kashatu Yahazieli, owa kana Yekameamu. <verse eid="1CH 24:23" /><verse number="24" style="v" sid="1CH 24:24" /><note caller="-" style="x"><char style="xo" closed="false">24:24: </char><char style="xt" closed="false"><ref loc="1CH 23:20">1 Bus 23:20</ref>. </char></note> Beene Uzieli, Muika; omuri beene Miika, Shamiri. <verse eid="1CH 24:24" /><verse number="25" style="v" sid="1CH 24:25" />Murumuna wa Miika, Ishia; omuri beene Ishia, Zekaria. <verse eid="1CH 24:25" /><verse number="26" style="v" sid="1CH 24:26" /><note caller="-" style="x"><char style="xo" closed="false">24:26: </char><char style="xt" closed="false"><ref loc="1CH 23:21">1 Bus 23:21</ref>. </char></note> Beene Merari: Mahili na Muushi. Beene Yaaziya: Beno. <verse eid="1CH 24:26" /><verse number="27" style="v" sid="1CH 24:27" />Beene Merari: aba Yaaziya, Beno, Shohamu, Zakuri, na Iburi. <verse eid="1CH 24:27" /><verse number="28" style="v" sid="1CH 24:28" /><note caller="-" style="x"><char style="xo" closed="false">24:28: </char><char style="xt" closed="false"><ref loc="1CH 23:22">1 Bus 23:22</ref>. </char></note> Owa Mahili, Eleazaari, owaabaire ataine baana b'aboojo. <verse eid="1CH 24:28" /><verse number="29" style="v" sid="1CH 24:29" />Aba Kiishi, beene Kiishi Yerameeli. <verse eid="1CH 24:29" /><verse number="30" style="v" sid="1CH 24:30" /><note caller="-" style="x"><char style="xo" closed="false">24:30: </char><char style="xt" closed="false"><ref loc="1CH 23:23">1 Bus 23:23</ref>. </char></note> Beene Muushi, Mahili, Ederi na Yerimoosi. Abo nibo batabani ba beene Leevi nk'amaju ga baishenkurubo oku gaabare gari. <verse eid="1CH 24:30" /><verse number="31" style="v" sid="1CH 24:31" /><note caller="-" style="x"><char style="xo" closed="false">24:31: </char><char style="xt" closed="false"><ref loc="1CH 24:5">1 Bus 24:5</ref>. </char></note> Kandi abo bakuru b'amaju ga baishenkurubo, omukuru wa buri nju ya baishenkuru hamwe n'omurumuna, baateera enteenyu nka beene waabo beene Arooni, nibaziteerera omu maisho g'omugabe Daudi, na Zadoki na Ahimeleki, kandi n'omu maisho g'abakuru b'abanyamurwa n'Abaleevi.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">Abeeshongozi n'abateezi b'enanga omuri hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 3:15">2 Bag 3:15</ref>; <ref loc="1CH 6:33">1 Bus 6:33</ref>, <ref loc="1CH 6:39">39</ref>; <ref loc="1CH 16:41">16:41</ref>. </char>
    </note> Daudi n'abakuru b'omurimo gw'obuheereza omuri hekalu baashoroora bamwe omuri beene Asafu n'aba Hemani n'aba Yedusuuni ahabw'omurimo, ngu babe ab'okuragura n'enanga n'endingiri n'ebitaasa. Amaziina g'abaabaire nibakora ogwo murimo omu mbu zaabo nigo aga: <verse eid="1CH 25:1" /><verse number="2" style="v" sid="1CH 25:2" />Omuri beene Asafu, Zakuri, Yosefu, Netania, na Ashareela, beene Asafu, abaabaire nibeebemberwa Asafu, naaragura nk'ekiragiro ky'omugabe oku kyabaire kiri. <verse eid="1CH 25:2" /><verse number="3" style="v" sid="1CH 25:3" />Aba Yedusuuni, beene Yedusuuni: Gedalia, Zeeri, Yeshaaya, Shimei, Hashabia na Matisia, boona mukaaga nibeebemberwa ishebo Yedusuuni, owaabaire naaragura n'endingiri, naasiima MUKAMA kandi naamuhimbisa. <verse eid="1CH 25:3" /><verse number="4" style="v" sid="1CH 25:4" />Aba Hemani, beene Hemani: Bukia, Matania, Uzieli, Shebueli, na Yerimoosi, Hanania, Hanani, Eliata, Gidaliti, na Romamutiezeeri, Yoshibekasha, Maloosi, Hosiri na Mahaziosi. <verse eid="1CH 25:4" /><verse number="5" style="v" sid="1CH 25:5" /><note caller="-" style="x"><char style="xo" closed="false">25:5: </char><char style="xt" closed="false"><ref loc="2SA 24:11">2 Sam 24:11</ref>. </char></note> Abo boona bakaba bari beene Hemani omuhanuuzi w'omugabe, owaabaire naanuura ebigambo bya Ruhanga eby'okumuha ekitiinisa; kandi Ruhanga yaaha Hemani abaana b'aboojo ikumi na bana, n'ab'abaishiki bashatu. <verse eid="1CH 25:5" /><verse number="6" style="v" sid="1CH 25:6" /><note caller="-" style="x"><char style="xo" closed="false">25:6: </char><char style="xt" closed="false"><ref loc="1CH 15:16">1 Bus 15:16</ref>; <ref loc="NEH 12:27">Neh 12:27</ref>. </char></note> Abo boona bakaba beebemberwa ishebo, nibeeshongorera omu nju ya MUKAMA n'ebitaasa n'enanga n'endingiri, nibakora omurimo gw'obuheereza omu nju ya Ruhanga. Kandi Asafu na Yedusuuni na Hemani bakaba baragiirwa omugabe. <verse eid="1CH 25:6" /><verse number="7" style="v" sid="1CH 25:7" />Omubaro gwabo hamwe na beene waabo abaabaire beegyesiibwe okweshongorera MUKAMA, boona abaabaire nibakumanya gye, bakaba bari magana abiri na makumi munaana na munaana. <verse eid="1CH 25:7" /><verse number="8" style="v" sid="1CH 25:8" /><note caller="-" style="x"><char style="xo" closed="false">25:8: </char><char style="xt" closed="false"><ref loc="1CH 26:13">1 Bus 26:13</ref>. </char></note> Bwanyima baateerera emirimo yaabo enteenyu, abakuru n'abato, abeegyesa n'abeegi boona hamwe. <verse eid="1CH 25:8" /><verse number="9" style="v" sid="1CH 25:9" />Enteenyu y'okubanza yaakwata Yosefu ahabwa Asafu; eya kabiri, Gedalia na beene ishe n'abatabani, boona ikumi na babiri; <verse eid="1CH 25:9" /><verse number="10" style="v" sid="1CH 25:10" />eya kashatu, Zakuri n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:10" /><verse number="11" style="v" sid="1CH 25:11" />eya kana, Izuri, n'abatabani ba beene ishe, boona ikumi na babiri; <verse eid="1CH 25:11" /><verse number="12" style="v" sid="1CH 25:12" />eya kataano, Netania n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:12" /><verse number="13" style="v" sid="1CH 25:13" />eya mukaaga, Bukia n'abatabani ba beene ishe, boona ikumi na babiri; <verse eid="1CH 25:13" /><verse number="14" style="v" sid="1CH 25:14" />eya mushanju, Yeshareela, n'abatabani na beene ishe, boona ikumi na babiri, <verse eid="1CH 25:14" /><verse number="15" style="v" sid="1CH 25:15" />eya munaana, Yeshaaya n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:15" /><verse number="16" style="v" sid="1CH 25:16" />eya mwenda, Matania n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:16" /><verse number="17" style="v" sid="1CH 25:17" />eya ikumi Shimei n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:17" /><verse number="18" style="v" sid="1CH 25:18" />eya ikumi n'emwe, Azareeli n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:18" /><verse number="19" style="v" sid="1CH 25:19" />eya ikumi na ibiri, Hashabia, n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:19" /><verse number="20" style="v" sid="1CH 25:20" />eya ikumi na ishatu, Shubaeli n'abatabani ba beene ishe, boona ikumi na babiri; <verse eid="1CH 25:20" /><verse number="21" style="v" sid="1CH 25:21" />eya ikumi na ina, Matisia, n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:21" /><verse number="22" style="v" sid="1CH 25:22" />eya ikumi na itaano Yeremoosi, n'abatabani na beene ishe, boona ikumi na babiri, <verse eid="1CH 25:22" /><verse number="23" style="v" sid="1CH 25:23" />eya ikumi na mukaaga, Hanania, n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:23" /><verse number="24" style="v" sid="1CH 25:24" />eya ikumi na mushanju Yeshebekasha, n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:24" /><verse number="25" style="v" sid="1CH 25:25" />eya ikumi na munaana, Hanani n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:25" /><verse number="26" style="v" sid="1CH 25:26" />eya ikumi na mwenda, Maloosi n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:26" /><verse number="27" style="v" sid="1CH 25:27" />eya makumi abiri, Eliasa n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:27" /><verse number="28" style="v" sid="1CH 25:28" />eya makumi abiri n'emwe, Hosiri n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:28" /><verse number="29" style="v" sid="1CH 25:29" />ey makumi abiri na ibiri, Gidaliti n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:29" /><verse number="30" style="v" sid="1CH 25:30" />eya makumi abiri na ishatu, Mahaziosi n'abatabani na beene ishe, boona ikumi na babiri; <verse eid="1CH 25:30" /><verse number="31" style="v" sid="1CH 25:31" />n'eya makumi abiri na ina, Romamutiezeeri n'abatabani na beene ishe, boona ikumi na babiri.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">Abakozi b'omuri hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 26:1" />Eby'embu z'abakumiirizi b'amarembo; ab'omu ba Koora, Meshelemia mwene Koore, ow'omuri beene Asafu. <verse eid="1CH 26:1" /><verse number="2" style="v" sid="1CH 26:2" /><note caller="-" style="x"><char style="xo" closed="false">26:2: </char><char style="xt" closed="false"><ref loc="1CH 9:21">1 Bus 9:21</ref>. </char></note> Kandi Meshelemia ogwo akaba aine abaana b'aboojo; ow'omujigaijo Zekaria, owa kabiri Yedyaeli, owa kashatu Zebadia, owa kana Yatinyeli, <verse eid="1CH 26:2" /><verse number="3" style="v" sid="1CH 26:3" />owa kataano Elamu, owa mukaaga Yehohanani, owa mushanju Elyeho-enai. <verse eid="1CH 26:3" /><verse number="4" style="v" sid="1CH 26:4" /><note caller="-" style="x"><char style="xo" closed="false">26:4: </char><char style="xt" closed="false"><ref loc="1CH 15:18">1 Bus 15:18</ref>; <ref loc="1CH 16:38">16:38</ref>. </char></note> Obededomu nawe akaba aine abatabani: ow'omujigaijo Shemaaya, owa kabiri Yehozabadi, owa kashatu Yoa, owa kana Skari, owa kataano Netaneeli, <verse eid="1CH 26:4" /><verse number="5" style="v" sid="1CH 26:5" /><note caller="-" style="x"><char style="xo" closed="false">26:5: </char><char style="xt" closed="false"><ref loc="1SA 6:11">1 Sam 6:11</ref>. </char></note> owa mukaaga Amieli, owa mushanju Isakaari, owa munaana Peulesa; ahakuba Ruhanga akamuha omugisha. <verse eid="1CH 26:5" /><verse number="6" style="v" sid="1CH 26:6" />Kandi omutabani Shemaaya akazaara abaana b'aboojo, abaabaire bari abategyeki omu maju ga baishenkurubo; ahabw'okuba bakaba bari abashaija b'amaani amamanzi. <verse eid="1CH 26:6" /><verse number="7" style="v" sid="1CH 26:7" />Beene Shemaaya: otuni, Refaeli, Ebedi, Elizabaadi na beene ishe abaabaire bari amamanzi, Elihu na Semakia. <verse eid="1CH 26:7" /><verse number="8" style="v" sid="1CH 26:8" />Abo boona bakaba bari beene Obededomu hamwe n'abatabani baabo na beene ishebo, abashaija b'amaani abaabaire nibabaasa ogwo murimo; aba Obededomu boona bakaba bari makumi mukaaga na babiri. <verse eid="1CH 26:8" /><verse number="9" style="v" sid="1CH 26:9" />Kandi Meshelemia akaba aine abatabani na beene ishe, abashaija amamanzi ikumi na munaana. <verse eid="1CH 26:9" /><verse number="10" style="v" sid="1CH 26:10" /><note caller="-" style="x"><char style="xo" closed="false">26:10: </char><char style="xt" closed="false"><ref loc="1CH 16:38">1 Bus 16:38</ref>. </char></note> Na Hoosa ow'omuri beene Merari akaba aine abatabani: omukuru ari Shimuri, (ahakuba n'obu araabe yaabaire atari w'omujigaijo, ishe akamuhindura mukuru), <verse eid="1CH 26:10" /><verse number="11" style="v" sid="1CH 26:11" />owa kabiri Hilukia, owa kashatu Tebalia, n'owa kana Zekaria; batabani ba Hoosa na beene ishe boona bakaba bari ikumi na bashatu.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 26:12" />Abakumiirizi b'amarembo omuri ezo mbu, nk'abakuru baabo oku baabaire bari, bakaba baine emirimo ei bakwatsiibwe, nka beene waabo abaabaire nibaheereza omu nju ya MUKAMA oku baabaire bagiine; <verse eid="1CH 26:12" /><verse number="13" style="v" sid="1CH 26:13" /><note caller="-" style="x"><char style="xo" closed="false">26:13: </char><char style="xt" closed="false"><ref loc="1CH 25:8">1 Bus 25:8</ref>. </char></note> kandi baateerera amaju ga baishenkurubo enteenyu, amakye n'amahango, kumanya ab'okurinda amarembo gaabo. <verse eid="1CH 26:13" /><verse number="14" style="v" sid="1CH 26:14" />Enteenyu yaakwata Shelemia kurinda eirembo ry'oburugwa-izooba. Bwanyima baateerera omutabani Zekaria enteenyu, omuhanuuzi w'obwengye; yaakwatwa ey'okurinda ery'aha bukiizi-bwa-bumosho. <verse eid="1CH 26:14" /><verse number="15" style="v" sid="1CH 26:15" />Obededomu yaakwata ey'okurinda ery'aha bukiizi-bwa-buryo; kandi abatabani baakwatsibwa eibiikiro. <verse eid="1CH 26:15" /><verse number="16" style="v" sid="1CH 26:16" /><note caller="-" style="x"><char style="xo" closed="false">26:16: </char><char style="xt" closed="false"><ref loc="1KI 10:5">1 Bag 10:5</ref>. </char></note> Shupimu na Hoosa baakwatwa ey'okurinda eirembo ry'oburengyerwa-izooba, n'eirembo rya Shalekesi aha muhanda ogurikwinamuka, ahu abakumiirizi barikureebanira. <verse eid="1CH 26:16" /><verse number="17" style="v" sid="1CH 26:17" />Aha burugwa-izooba haazaho mukaaga buri izooba, aha bukiizi-bwa-bumosho bana buri izooba; aha bukiizi-bwa-buryo bana, kandi n'aha ibiikiro babiri-babiri; <verse eid="1CH 26:17" /><verse number="18" style="v" sid="1CH 26:18" />ahari Paribaari oburengyerwa-izooba bana ahari ogwo muhanda, na babiri ahari Paribaari. <verse eid="1CH 26:18" /><verse number="19" style="v" sid="1CH 26:19" />Ezo nizo mbu z'abakumiirizi b'amarembo b'omuri beene Koore, na beene Merari.<verse eid="1CH 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:20: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 26:22">1 Bus 26:22</ref>, <ref loc="1CH 26:24">24</ref>, <ref loc="1CH 26:26">26</ref>; <ref loc="1CH 28:12">28:12</ref>; <ref loc="EZR 2:69">Ezr 2:69</ref>; <ref loc="NEH 10:38">Neh 10:38</ref>. </char>
    </note> Kandi ab'omu Baleevi, Ahiya niwe yaabaire akwatsiibwe amabiikiro g'enju ya Ruhanga n'amabiikiro g'ebintu ebyeziibwe. <verse eid="1CH 26:20" /><verse number="21" style="v" sid="1CH 26:21" />Beene Ladani, beene Gereshon ab'omu ba Ladani, abakuru b'amaju ga baishenkurubo ba Ladani owa Gereshoni: Yahieli.<verse eid="1CH 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 26:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:22: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 23:8">1 Bus 23:8</ref>; <ref loc="1CH 29:8">29:8</ref>. </char>
    </note> Beene Yehieli, Zetami na Yoeli omurumuna nibo baabaire bakwatsiibwe amabiikiro g'enju ya MUKAMA. <verse eid="1CH 26:22" /><verse number="23" style="v" sid="1CH 26:23" /><note caller="-" style="x"><char style="xo" closed="false">26:23: </char><char style="xt" closed="false"><ref loc="1CH 23:12">1 Bus 23:12</ref>. </char></note> Omu ba Amuraamu, Abaizuhaari, Abaheburooni n'Abauzieli <verse eid="1CH 26:23" /><verse number="24" style="v" sid="1CH 26:24" /><note caller="-" style="x"><char style="xo" closed="false">26:24: </char><char style="xt" closed="false"><ref loc="1CH 23:16">1 Bus 23:16</ref>. </char></note> na Shebueli mwene Gereshoni, mwijukuru wa Musa, niwe yaabaire akwatsiibwe amabiikiro. <verse eid="1CH 26:24" /><verse number="25" style="v" sid="1CH 26:25" /><note caller="-" style="x"><char style="xo" closed="false">26:25: </char><char style="xt" closed="false"><ref loc="1CH 23:17">1 Bus 23:17</ref>; <ref loc="1CH 24:21">24:21</ref>. </char></note> Beene ishe Eliezeeri akakomookwaho Rehabia omutabani, mwene Rehebia Yeshaaya, mwene Yeshaaya Yoramu, mwene Yoramu Zikuri, mwene Zikuri Shelomoosi; <verse eid="1CH 26:25" /><verse number="26" style="v" sid="1CH 26:26" /><note caller="-" style="x"><char style="xo" closed="false">26:26: </char><char style="xt" closed="false"><ref loc="2SA 8:11">2 Sam 8:11</ref>. </char></note> Shelemoosi ogwo na beene ishe nibo baabaire bakwatsiibwe amabiikiro goona ag'ebintu ebyeziibwe, ebi Daudi omugabe n'abakuru b'amaju ga baishenkurubo n'abakuru b'engabo rukumi-rukumi n'aba igana-igana n'abakuru b'amahe, baayerize. <verse eid="1CH 26:26" /><verse number="27" style="v" sid="1CH 26:27" />Omu bintu ebi baanyagire omu ngamba bakashorooramu ebintu by'okuhunduuza enju ya MUKAMA. <verse eid="1CH 26:27" /><verse number="28" style="v" sid="1CH 26:28" />Kandi ebi Samueli omuhanuuzi na Saulo mwene Kiishi, na Abuneeri mwene Neeri, na Yoabu mwene Zeruiya baayerize byona, ebi omuntu weena yaabaire ahongyeire MUKAMA byona bikaba birindwa Shelomoosi na beene ishe. <verse eid="1CH 26:28" /><verse number="29" style="v" sid="1CH 26:29" /><note caller="-" style="x"><char style="xo" closed="false">26:29: </char><char style="xt" closed="false"><ref loc="1CH 23:4">1 Bus 23:4</ref>; <ref loc="NEH 11:16">Neh 11:16</ref>. </char></note> Omuri beene Izuhaari, Kanania n'abatabani nibo baabaire bakwatsiibwe omurimo gw'aheeru ahabw'Abaisraeli, bari abatware n'abaramuzi. <verse eid="1CH 26:29" /><verse number="30" style="v" sid="1CH 26:30" /><note caller="-" style="x"><char style="xo" closed="false">26:30: </char><char style="xt" closed="false"><ref loc="1CH 27:17">1 Bus 27:17</ref>. </char></note> Omuri beene Heburooni, Hashabia ana beene ishe, abashaija amamanzi rukumi na magana mushanju, nibo baabaire nibareeberera Israeli oburengyerwa-izooba bwa Yorudani ahabw'omurimo gwa MUKAMA gwona, n'ahabw'omurimo gw'omugabe. <verse eid="1CH 26:30" /><verse number="31" style="v" sid="1CH 26:31" /><note caller="-" style="x"><char style="xo" closed="false">26:31: </char><char style="xt" closed="false"><ref loc="1CH 24:23">1 Bus 24:23</ref>. </char></note> Omu ba Heburooni abo Yeriya niwe yaabaire ari omukuru waabo, nk'okukuratana kw'oruzaaro rw'abakuru b'amaju ga baishenkurubo oku kwabaire kuri. (Omu mwaka gwa makumi ana ogw'omu busingye bwa Daudi bakasherura, baashanga omuri abo ba Heburooni abashaija b'amaani amamanzi, bari Yazeri omuri Gileadi.) <verse eid="1CH 26:31" /><verse number="32" style="v" sid="1CH 26:32" /><note caller="-" style="x"><char style="xo" closed="false">26:32: </char><char style="xt" closed="false"><ref loc="1CH 6:8">1 Bus 6:8</ref>; <ref loc="2CH 19:11">2 Bus 19:11</ref>. </char></note> Omugabe Daudi yaataho Yeriya ogwo na beene ishe, abashaija amamanzi enkumi ibiri na magana mushanju, abakuru b'amaju ga baishenkurubo, kuba ab'okureeberera Abareubeeni, Abagaadi n'ekicweka ky'oruganda rwa Manaase, ahabw'ebintu bya Ruhanga byona, kandi n'eby'omugabe.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">Okutaho abakuru b'omu ihe rya Daudi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 27:1" />Aga nigo maziina g'Abaisraeli, abakuru b'amaju ga baishenkurubo, abakuru b'engabo rukumi-rukumi n'aba igana-igana n'abatware baabo abaabaire nibaheereza omugabe omu murimo gw'okureeberera abantu omu by'okwihaihana kw'embu zaabo, buri rubu rukaba rurimu abantu obukumi bubiri n'enkumi ina.<verse eid="1CH 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 27:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:2: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 11:11">1 Bus 11:11</ref>. </char>
    </note> Yashobeamu mwene Zabudieli niwe yaabaire naareeberera orubu rw'okubanza omu kwezi kw'okubanza; ab'orubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:2" /><verse number="3" style="v" sid="1CH 27:3" /><note caller="-" style="x"><char style="xo" closed="false">27:3: </char><char style="xt" closed="false"><ref loc="NUM 26:20">Kub 26:20</ref>. </char></note> Akaba ari ow'omuri baijukuru ba Pereezi, kandi ari omutegyeki mukuru w'abakuru b'amahe boona omu kwezi kw'okubanza. <verse eid="1CH 27:3" /><verse number="4" style="v" sid="1CH 27:4" /><note caller="-" style="x"><char style="xo" closed="false">27:4: </char><char style="xt" closed="false"><ref loc="1CH 11:12">1 Bus 11:12</ref>. </char></note> Dodai owa Ahohi niwe yaabaire naareeberera ab'orubu rw'okwezi kwa kabiri; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:4" /><verse number="5" style="v" sid="1CH 27:5" /><note caller="-" style="x"><char style="xo" closed="false">27:5: </char><char style="xt" closed="false"><ref loc="2SA 8:18">2 Sam 8:18</ref>. </char></note> Omukuru wa kashatu omu kwezi kwa kashatu akaba ari Benaaya mwene Yehoyaada omunyamurwa mukuru; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:5" /><verse number="6" style="v" sid="1CH 27:6" /><note caller="-" style="x"><char style="xo" closed="false">27:6: </char><char style="xt" closed="false"><ref loc="1CH 11:24">1 Bus 11:24</ref>, <ref loc="1CH 11:25">25</ref>. </char></note> Benaaya ogwo niwe yaabaire ari omushaija w'amaani ow'omuri bari amakumi ashatu, kandi ari omukuru waabo. Amizabaadi omutabani akaba ari omu rubu rwe. <verse eid="1CH 27:6" /><verse number="7" style="v" sid="1CH 27:7" /><note caller="-" style="x"><char style="xo" closed="false">27:7: </char><char style="xt" closed="false"><ref loc="1CH 11:26">1 Bus 11:26</ref>. </char></note> Asaheeli murumuna wa Yoabu niwe yaabaire ari omukuru wa kana omu kwezi kwa kana, naakuratwa omutabani Zebadia; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:7" /><verse number="8" style="v" sid="1CH 27:8" /><note caller="-" style="x"><char style="xo" closed="false">27:8: </char><char style="xt" closed="false"><ref loc="1CH 11:27">1 Bus 11:27</ref>. </char></note> Omukuru wa kataano omu kwezi kwa kataano akaba ari Shamuhuusi owa Izuraahi; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:8" /><verse number="9" style="v" sid="1CH 27:9" /><note caller="-" style="x"><char style="xo" closed="false">27:9: </char><char style="xt" closed="false"><ref loc="1CH 11:28">1 Bus 11:28</ref>. </char></note> Omukuru wa mukaaga omu kwezi kwa mukaaga akaba ari Iira mwene Ikeshi owa Tekoa; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:9" /><verse number="10" style="v" sid="1CH 27:10" /><note caller="-" style="x"><char style="xo" closed="false">27:10: </char><char style="xt" closed="false"><ref loc="1CH 11:27">1 Bus 11:27</ref>. </char></note> Omukuru wa mushanju omu kwezi kwa mushanju akaba ari Helezi owa Pelooni ow'omuri beene Efuraimu; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:10" /><verse number="11" style="v" sid="1CH 27:11" /><note caller="-" style="x"><char style="xo" closed="false">27:11: </char><char style="xt" closed="false"><ref loc="1CH 11:29">1 Bus 11:29</ref>; <ref loc="1CH 20:4">20:4</ref>. </char></note> Owa munaana omu kwezi kwa munaana akaba ari Sibekai, owa Huusha, ow'omu ba Zeera; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:11" /><verse number="12" style="v" sid="1CH 27:12" /><note caller="-" style="x"><char style="xo" closed="false">27:12: </char><char style="xt" closed="false"><ref loc="1CH 11:28">1 Bus 11:28</ref>. </char></note> Owa mwenda omu kwezi kwa mwenda akaba ari Abiezeeri owa Anatoosi, Omubenyamiini; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:12" /><verse number="13" style="v" sid="1CH 27:13" /><note caller="-" style="x"><char style="xo" closed="false">27:13: </char><char style="xt" closed="false"><ref loc="1CH 11:30">1 Bus 11:30</ref>. </char></note> Owa ikumi, omu kwezi kwa ikumi akaba ari Maharai owa Netofa, ow'omu ba Zeera; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:13" /><verse number="14" style="v" sid="1CH 27:14" /><note caller="-" style="x"><char style="xo" closed="false">27:14: </char><char style="xt" closed="false"><ref loc="1CH 11:31">1 Bus 11:31</ref>. </char></note> Owa ikumi n'omwe omu kwezi kwa ikumi na kumwe akaba ari Benaaya owa Piratooni ow'omuri beene Efuraimu; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina. <verse eid="1CH 27:14" /><verse number="15" style="v" sid="1CH 27:15" /><note caller="-" style="x"><char style="xo" closed="false">27:15: </char><char style="xt" closed="false"><ref loc="JDG 1:13">Bar 1:13</ref>. </char></note> Owa ikumi na babiri omu kwezi kwa ikumi n'abiri akaba ari Heludai owa Netofa mwene Otinyeli; ab'omu rubu rwe bakaba bari obukumi bubiri n'enkumi ina.<verse eid="1CH 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 27:16" />Kandi abategyeki b'enganda za Israeli nibo aba; omukuru w'Abareubeeni akaba ari Eliezeeri mwene Zikuri; ow'Abasimeoni, Shefatia mwene Maaka; <verse eid="1CH 27:16" /><verse number="17" style="v" sid="1CH 27:17" /><note caller="-" style="x"><char style="xo" closed="false">27:17: </char><char style="xt" closed="false"><ref loc="1CH 24:3">1 Bus 24:3</ref>; <ref loc="1CH 26:30">26:30</ref>. </char></note> ow'Abaleevi, Hashabia mwene Kemueli; ow'aba Arooni, Zadoki; <verse eid="1CH 27:17" /><verse number="18" style="v" sid="1CH 27:18" />ow'Abayuda, Elihu omwe ahari bakuru ba Daudi; ow'Abaisakaari, Omuri mwene Mikaeli; <verse eid="1CH 27:18" /><verse number="19" style="v" sid="1CH 27:19" />ow'Abazebuluuni, Ishimaaya, mwene Obadia; ow'Abanafutaali, Yeremoosi mwene Azurieli; <verse eid="1CH 27:19" /><verse number="20" style="v" sid="1CH 27:20" />ow'Abaefuraimu, Hoshea mwene Azazia; ow'ekicweka ky'oruganda rwa Manaase, Yoeli mwene Pedaya; <verse eid="1CH 27:20" /><verse number="21" style="v" sid="1CH 27:21" />ow'ekicweka ky'oruganda rwa Manaase eky'omuri Gileadi, Ido mwene Zekaria; ow'Ababenyamiini, Yaasieli mwene Abuneeri; <verse eid="1CH 27:21" /><verse number="22" style="v" sid="1CH 27:22" /><note caller="-" style="x"><char style="xo" closed="false">27:22: </char><char style="xt" closed="false"><ref loc="1CH 28:1">1 Bus 28:1</ref>. </char></note> ow'Abadaani, Azareeli mwene Yerohaamu. Abo nibo baabaire bari abakuru b'enganda za Israeli. <verse eid="1CH 27:22" /><verse number="23" style="v" sid="1CH 27:23" /><note caller="-" style="x"><char style="xo" closed="false">27:23: </char><char style="xt" closed="false"><ref loc="GEN 15:5">Kut 15:5</ref>. </char></note> Kwonka Daudi tarabazire batakahikize myaka makumi abiri, ahakuba MUKAMA akagamba ku arikanyisa Abaisraeli, bakaba nk'enyonyoozi z'omu iguru. <verse eid="1CH 27:23" /><verse number="24" style="v" sid="1CH 27:24" /><note caller="-" style="x"><char style="xo" closed="false">27:24: </char><char style="xt" closed="false"><ref loc="1CH 21:5">1 Bus 21:5</ref>, <ref loc="1CH 21:6">6</ref>, <ref loc="1CH 21:7">7</ref>; <ref loc="2SA 24:12-15">2 Sam 24:12-15</ref>. </char></note> Yoabu mwene Zeruiya yaatandika kubara, kwonka tiyaaheza; nikyo ekiniga kyaiziire ahari Israeli, kandi omubaro ogwo tiguhandiikirwe omu kitabo ky'eby'omu busingye bw'omugabe Daudi.<verse eid="1CH 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 27:25" />Omureeberezi w'amabiikiro g'omugabe akaba ari Azimaveesi mwene Adieli; ow'amabiikiro g'omu byaro, omu ndembo, omu birorero n'omu bigo, Yonasaani mwene Uziya; <verse eid="1CH 27:25" /><verse number="26" style="v" sid="1CH 27:26" />ow'abahingi b'omu misiri, Ezeri mwene Kelubu; <verse eid="1CH 27:26" /><verse number="27" style="v" sid="1CH 27:27" />ow'emisiri y'emizaabibu Shimei owa Raama; ow'ebirikuruga omu mizaabibu eby'okubiikwa omu mabiikiro ga viinyo, Zabudi owa Shiifu; <verse eid="1CH 27:27" /><verse number="28" style="v" sid="1CH 27:28" /><note caller="-" style="x"><char style="xo" closed="false">27:28: </char><char style="xt" closed="false"><ref loc="1KI 10:27">1 Bag 10:27</ref>; <ref loc="2CH 1:15">2 Bus 1:15</ref>. </char></note> ow'emiti y'emizeituuni n'emisikamoori ey'omu ruhita, Baali-hanani owa Gederi; ow'amabiikiro g'amajuta, Yoashi; <verse eid="1CH 27:28" /><verse number="29" style="v" sid="1CH 27:29" />ow'amasyo agaabaire gagisiire Sharooni, Shiturai owa Sharooni; ow'amasyo agaabaire gagisiire omu mpita, Shafati mwene Adulai; <verse eid="1CH 27:29" /><verse number="30" style="v" sid="1CH 27:30" />ow'engamira, Ebili owa Ishimaeli; ow'endogoya, Yehedeeya owa Meronoosi; kandi ow'obusyo bw'entaama, Yazizi owa Hagiri. <verse eid="1CH 27:30" /><verse number="31" style="v" sid="1CH 27:31" />Abo boona nibo baabaire bari ababiiki b'ebintu bya Daudi.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 27:32" />Yonasaani ishento wa Daudi niwe yaabaire ari omuhanuuzi, omushaija orikwetegyereza kandi omuhandiiki; we na Yehieli mwene Hakimooni nibo baabaire nibarera abaana b'omugabe. <verse eid="1CH 27:32" /><verse number="33" style="v" sid="1CH 27:33" /><note caller="-" style="x"><char style="xo" closed="false">27:33: </char><char style="xt" closed="false"><ref loc="2SA 15:12">2 Sam 15:12</ref>, <ref loc="2SA 15:37">37</ref>. </char></note> Ahisofeeli akaba ari omuhanuuzi w'omugabe, na Hushai owa Aruki ari munywani w'omugabe. <verse eid="1CH 27:33" /><verse number="34" style="v" sid="1CH 27:34" /><note caller="-" style="x"><char style="xo" closed="false">27:34: </char><char style="xt" closed="false"><ref loc="1CH 11:6">1 Bus 11:6</ref>; <ref loc="1CH 24:6">24:6</ref>; <ref loc="1CH 27:5">27:5</ref>. </char></note> Ahisofeeli akakuratwa Yehoyaada mwene Benaaya, na Abiasaari. Kandi Yoabu niwe yaabaire ari omukuru w'eihe ry'omugabe.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">Daudi okwehanangiriza abantu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 11:10-47">1 Bus 11:10-47</ref>; <ref loc="1CH 23:2">23:2</ref>; <ref loc="1CH 27:1-15">27:1-15</ref>, <ref loc="1CH 27:16-22">16-22</ref>, <ref loc="1CH 27:25-31">25-31</ref>. </char>
    </note> Daudi yaateeranira Yerusaalemu abakuru ba Israeli boona, ab'enganda n'abategyeki b'emitwe y'abantu abaabaire baheereza omugabe omu mbu, n'abakuru b'engabo rukumi-rukumi, n'aba igana-igana, n'ababiiki b'ebintu by'omugabe, abarikureeberera amasyo ge n'ag'abatabani, hamwe n'abakuru b'ekikaari, n'abashaija bari ab'amaani amamanzi boona. <verse eid="1CH 28:1" /><verse number="2" style="v" sid="1CH 28:2" /><note caller="-" style="x"><char style="xo" closed="false">28:2: </char><char style="xt" closed="false"><ref loc="1CH 22:7">1 Bus 22:7</ref>; <ref loc="PSA 132:7">Zab 132:7</ref>; <ref loc="ISA 66:1">Isa 66:1</ref>. </char></note> Bwanyima Daudi yaimuka, yaagira ati: Imwe beene tata n'abashaija bangye, mumpurire. Nkashangwa nkiine aha mutima kwombekyera eshanduukye y'endagaano ya MUKAMA enju y'okugitamu, n'okuba akatebe k'ebigyere ka Ruhanga; kandi nikwo naabaire nyetegwire ntyo. <verse eid="1CH 28:2" /><verse number="3" style="v" sid="1CH 28:3" /><note caller="-" style="x"><char style="xo" closed="false">28:3: </char><char style="xt" closed="false"><ref loc="2SA 7:5">2 Sam 7:5</ref>, <ref loc="2SA 7:13">13</ref>. </char></note> Kwonka Ruhanga yangira ati: Torikwija kwombekyera iziina ryangye nju, ahabw'okuba ori omushaija omurwani, kandi okasheesha eshagama nyingi. <verse eid="1CH 28:3" /><verse number="4" style="v" sid="1CH 28:4" /><note caller="-" style="x"><char style="xo" closed="false">28:4: </char><char style="xt" closed="false"><ref loc="GEN 49:8">Kut 49:8</ref>; <ref loc="1SA 16:12">1 Sam 16:12</ref>, <ref loc="1SA 16:13">13</ref>; <ref loc="1CH 5:2">1 Bus 5:2</ref>; <ref loc="1CH 17:23">17:23</ref>, <ref loc="1CH 17:27">27</ref>; <ref loc="PSA 78:68">Zab 78:68</ref>. </char></note> N'obu kiraabe kyabaire kiri kityo, MUKAMA Ruhanga wa Israeli akantoorana omu ruganda rwa baatatenkuru rwona kuba omugabe wa Israeli ebiro byona; ahabw'okuba akatoorana Yuda kuba omwebembezi, omu ruganda rwa Yuda yaatoorana enju ya tata, kandi omuri beene tata yaaba niinye yaihamu, yanshemerererwa, yangira omugabe wa Israeli yoona. <verse eid="1CH 28:4" /><verse number="5" style="v" sid="1CH 28:5" /><note caller="-" style="x"><char style="xo" closed="false">28:5: </char><char style="xt" closed="false"><ref loc="1CH 3:1-9">1 Bus 3:1-9</ref>; <ref loc="1CH 22:9">22:9</ref>. </char></note> Mbwenu omuri batabani bangye boona, (ahabw'okuba Ruhanga akampa abaana b'aboojo baingi,) yaatooranamu mutabani wangye Sulemaani kuba niwe yaaza aha kitebe ky'obugabe bwa MUKAMA kutegyeka Israeli. <verse eid="1CH 28:5" /><verse number="6" style="v" sid="1CH 28:6" /><note caller="-" style="x"><char style="xo" closed="false">28:6: </char><char style="xt" closed="false"><ref loc="2SA 7:13">2 Sam 7:13</ref>, <ref loc="2SA 7:14">14</ref>. </char></note> Yangira ati: Mutabani waawe Sulemaani niwe aryombeka enju yangye, n'ebikaari byangye, ahabw'okuba mmutooraine kuba omwana wangye, naanye nkaba ishe. <verse eid="1CH 28:6" /><verse number="7" style="v" sid="1CH 28:7" /><note caller="-" style="x"><char style="xo" closed="false">28:7: </char><char style="xt" closed="false"><ref loc="1SA 17:23">1 Sam 17:23</ref>, <ref loc="1SA 17:27">27</ref>; <ref loc="1SA 22:13">22:13</ref>. </char></note> Ku arigumizamu kworobera ebiragiro byangye n'ebi naataireho, nk'oku ari hati, ndyahamya obugabe bwe. <verse eid="1CH 28:7" /><verse number="8" style="v" sid="1CH 28:8" />N'ahabw'ekyo hati omu maisho ga Israeli yoona, nigwo mutwe gw'abantu ba MUKAMA abateeraine, kandi omu maisho ga Ruhanga waitu orikutuhurira, mute omutima aha biragiro bya MUKAMA Ruhanga waanyu byona, mubiijukye, mubone kukubuura ensi egi enungi, nyentsya mugitsigire abaana baanyu abaribakurata, ebe obuhunguzi bwabo ebiro byona.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:9: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:7">1 Sam 16:7</ref>; <ref loc="1KI 8:61">1 Bag 8:61</ref>; <ref loc="2CH 15:2">2 Bus 15:2</ref>. </char>
    </note> Naiwe Sulemaani mwana wangye, omanye Ruhanga wa sho, ogume omuheereze n'omutima gwawe gwona kandi ogwekundiire; ahabw'okuba MUKAMA acaaka emitima yoona, kandi amanya enaama zoona n'ebiteekateeko byona. Ku orimusherura, oryamubona; kwonka ku orimurugaho, aryakucwa obutagaruka. <verse eid="1CH 28:9" /><verse number="10" style="v" sid="1CH 28:10" /><note caller="-" style="x"><char style="xo" closed="false">28:10: </char><char style="xt" closed="false"><ref loc="1CH 28:20">1 Bus 28:20</ref>; <ref loc="EZR 10:4">Ezr 10:4</ref>; <ref loc="HAG 2:4">Hag 2:4</ref>. </char></note> N'ahabw'ekyo mbwenu oyerinda; ahabw'okuba MUKAMA akutooraine kwombekyera Obutaaho bwe enju: ba ow'amaani, ogikore.<verse eid="1CH 28:10" /></para>
  <para style="s1">Daudi okuha Sulemaani eky'okureeberaho ky'enju</para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 25:17">Kur 25:17</ref>, <ref loc="EXO 25:40">40</ref>; <ref loc="1KI 6:3">1 Bag 6:3</ref>; <ref loc="1CH 28:19">1 Bus 28:19</ref>; <ref loc="2CH 3:4">2 Bus 3:4</ref>. </char>
    </note> Bwanyima Daudi yaaha omutabani Sulemaani eky'okureeberaho ky'ekisasi kya hekalu, n'eky'amaju gaayo, n'eky'amabiikiro gaayo, n'eky'ebishengye byayo eby'ahaiguru, n'eby'omunda, n'eky'ekishengye ky'ekitebe ky'okusaasira; <verse eid="1CH 28:11" /><verse number="12" style="v" sid="1CH 28:12" /><note caller="-" style="x"><char style="xo" closed="false">28:12: </char><char style="xt" closed="false"><ref loc="1CH 26:20">1 Bus 26:20</ref>. </char></note> kandi eky'okureeberaho ky'ebi yaabaire aine omu mutima byona, eky'ebikaari by'enju ya MUKAMA, n'ebishengye byona ebigyehinguririize, n'amabiikiro g'enju ya Ruhanga, n'ag'ebintu by'emitoijo ebyashoroirwe; <verse eid="1CH 28:12" /><verse number="13" style="v" sid="1CH 28:13" /><note caller="-" style="x"><char style="xo" closed="false">28:13: </char><char style="xt" closed="false"><ref loc="1CH 23:6">1 Bus 23:6</ref>; <ref loc="1CH 24:1">24:1</ref>. </char></note> kandi n'eby'embu z'abanyamurwa n'Abaleevi, n'eby'emirimo yoona ey'okukorerwa omu nju ya MUKAMA; n'eby'ebintu byona eby'okukoresibwa omu nju ya MUKAMA. <verse eid="1CH 28:13" /><verse number="14" style="v" sid="1CH 28:14" />Kandi yaamugambira oburemeezi bw'ezaabu ahabw'ebintu by'ezaabu eby'okukoresa emirimo yoona, n'oburemeezi bw'efeeza ahabw'ebintu by'efeeza ahabw'emirimo yoona, <verse eid="1CH 28:14" /><verse number="15" style="v" sid="1CH 28:15" /><note caller="-" style="x"><char style="xo" closed="false">28:15: </char><char style="xt" closed="false"><ref loc="EXO 25:31-37">Kur 25:31-37</ref>. </char></note> n'oburemeezi bw'ekikondo ky'amatabaaza n'amatabaaza gaakyo eby'ezaabu, n'oburemeezi bw'ezaabu ahabw'ekikondo kyona n'amataabaza gaakyo, nka buri kikondo oku kirikoresibwa omu buheereza bwabo, <verse eid="1CH 28:15" /><verse number="16" style="v" sid="1CH 28:16" />n'oburemeezi bw'ezaabu za buri meeza y'emigaati y'okumurikwa, n'obw'efeeza ahabw'emeeza z'efeeza, <verse eid="1CH 28:16" /><verse number="17" style="v" sid="1CH 28:17" />n'obw'ezaabu eshemeziibwe ahabw'eby'okwihuza enyama, n'enyabya, n'ebikopo; n'obw'ezaabu za buru bakuri y'ezaabu, n'obw'efeeza za buri bakuri y'efeeza; <verse eid="1CH 28:17" /><verse number="18" style="v" sid="1CH 28:18" /><note caller="-" style="x"><char style="xo" closed="false">28:18: </char><char style="xt" closed="false"><ref loc="1KI 6:23-28">1 Bag 6:23-28</ref>; <ref loc="EXO 25:18-22">Kur 25:18-22</ref>; <ref loc="EXO 30:1">30:1</ref>. </char></note> kandi n'eky'okureeberaho ky'eitambiro ry'okwotereraho obubaane, ery'okukorwa omu zaabu eshemeziibwe, n'oburemeezi bwayo; kandi n'eky'okureeberaho ky'ekigaari ky'ezaabu ekya baakerubi, abashashanwire amapapa gaabo, gakashweka eshanduukye y'endagaano ya MUKAMA. <verse eid="1CH 28:18" /><verse number="19" style="v" sid="1CH 28:19" /><note caller="-" style="x"><char style="xo" closed="false">28:19: </char><char style="xt" closed="false"><ref loc="EXO 25:40">Kur 25:40</ref>; <ref loc="1CH 28:11">1 Bus 28:11</ref>, <ref loc="1CH 28:12">12</ref>. </char></note> Daudi yaagira ati: Ebyo byona nkabimanyisibwa ebyahandiikirwe omukono gwa MUKAMA; egyo niyo mirimo yoona nk'eky'okureeberaho kyayo oku kiri.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:20: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 22:13">1 Bus 22:13</ref>; <ref loc="JOS 1:5">Yos 1:5</ref>. </char>
    </note> Bwanyima Daudi yaagira omutabani Sulemaani ati: Ba ow'amaani, ohame, okikore. Otatiina, kandi otahahaaza omutima; ahabw'okuba MUKAMA Ruhanga, niwe Ruhanga wangye, ari hamwe naiwe; tarikutsigaho, kandi tarikuhemukaho, okuhitsya ahu emirimo yoona ey'ebirikorwa omu nju ya MUKAMA erihwera. <verse eid="1CH 28:20" /><verse number="21" style="v" sid="1CH 28:21" /><note caller="-" style="x"><char style="xo" closed="false">28:21: </char><char style="xt" closed="false"><ref loc="EXO 35:25">Kur 35:25</ref>, <ref loc="EXO 35:26">26</ref>; <ref loc="EXO 36:1">36:1</ref>, <ref loc="EXO 36:2">2</ref>; <ref loc="1CH 24:26">1 Bus 24:26</ref>; <ref loc="1CH 28:13">28:13</ref>. </char></note> Kandi reeba, hariho embu z'abanyamurwa n'Abaleevi ahabw'omurimo gwona ogw'obuheereza bw'omu nju ya Ruhanga; kandi omuri egyo mirimo yoona, oryaba oine omuntu weena oyekundiire, omunyamwoga w'okukora omurimo gwa buri muringo; kandi n'abategyeki hamwe n'abantu boona baryaba bari omu bushoboorozi bwawe kuhurira eki orikubaragiira.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">Daudi okugamba ebi yaahaire ahabw'okwombeka hekalu</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 22:5">1 Bus 22:5</ref>. </char>
    </note> Bwanyima omugabe Daudi yaagambira omutwe gwona ogwabaire guteeraine ati: Mutabani wangye Sulemaani, ou Ruhanga atooraine wenka, akiri muto, takahamire, kandi omurimo ni muhango; ahabw'okuba enju teriba nju y'abantu, kureka eryaba eya MUKAMA Ruhanga. <verse eid="1CH 29:1" /><verse number="2" style="v" sid="1CH 29:2" />N'ahabw'ekyo ntegwire enju ya Ruhanga wangye, nk'oku ndikubaasa, naatunga ezaabu ahabw'ebintu by'ezaabu, efeeza ahabw'ebintu by'efeeza, emiringa ahabw'ebintu by'emiringa, ebyoma ahabw'ebintu by'ebyoma, n'ebiti ahabw'ebintu by'ebiti, otabariireho amabaare amaingi agarikwetwa shohamu, n'agandi mabaare maingi g'okuhunda, n'amabaare garikwengyengyeta ag'amabara maingi n'ag'obuguzi bwingi ag'emiringo yoona, n'agarikwetwa marimaari agatarikubarwa. <verse eid="1CH 29:2" /><verse number="3" style="v" sid="1CH 29:3" />Kandi ahabw'okukunda oku nyine aha nju ya Ruhanga wangye, nk'oku nyine obutungi bwangye ahabwangye obw'ezaabu n'efeeza, mbwenu naabuhayo ahabw'enju ya Ruhanga wangye, okwongyera ahari ebyo byona ebi naateekateekyeire egyo nju erikwera; <verse eid="1CH 29:3" /><verse number="4" style="v" sid="1CH 29:4" /><note caller="-" style="x"><char style="xo" closed="false">29:4: </char><char style="xt" closed="false"><ref loc="1KI 9:28">1 Bag 9:28</ref>; <ref loc="1CH 22:14">1 Bus 22:14</ref>. </char></note> n'etalanta z'ezaabu za Ofiri enkumi ishatu, ez'efeeza eshemeziibwe enkumi mushanju ez'okushweka ebisiika by'enju, <verse eid="1CH 29:4" /><verse number="5" style="v" sid="1CH 29:5" />ezaabu ahabw'ebintu by'ezaabu, n'efeeza ahabw'ebintu by'efeeza, ebirikukorwa abanyamyoga b'obwengye. Mbwenu eri izooba n'oha orikwikiriza kugira eki yaahayo, naayeyereza MUKAMA?<verse eid="1CH 29:5" /></para>
  <para style="s1">Abakuru b'enganda nabo okureeta emitoijo yaabo</para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:6: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 27:1">1 Bus 27:1</ref>, <ref loc="1CH 27:25-31">25-31</ref>; <ref loc="1CH 28:1">28:1</ref>. </char>
    </note> Bwanyima abakuru b'amaju ga baishenkurubo, n'abeebembezi b'enganda za Israeli, n'abakuru b'engabo rukumi-rukumi, n'aba igana-igana, n'abategyeki b'emirimo y'omugabe, baahayo ebintu byabo n'omutima gwekundiire. <verse eid="1CH 29:6" /><verse number="7" style="v" sid="1CH 29:7" /><note caller="-" style="x"><char style="xo" closed="false">29:7: </char><char style="xt" closed="false"><ref loc="EZR 2:69">Ezr 2:69</ref>; <ref loc="NEH 7:70-72">Neh 7:70-72</ref>. </char></note> Baahayo etalanta z'ezaabu enkumi itaano na dariki kakumi, etalanta z'efeeza kakumi, ez'emiringa kakumi n'enkumi munaana, n'etalanta z'ebyoma akasiriira, ahabw'omurimo gw'enju ya Ruhanga. <verse eid="1CH 29:7" /><verse number="8" style="v" sid="1CH 29:8" /><note caller="-" style="x"><char style="xo" closed="false">29:8: </char><char style="xt" closed="false"><ref loc="1CH 23:8">1 Bus 23:8</ref>. </char></note> Kandi omuntu weena owaabaire aine amabaare g'obuguzi bwingi, yaagahayo, baagata omu ibikiro ry'enju ya MUKAMA kurindwa Yehieli owa Gereshoni. <verse eid="1CH 29:8" /><verse number="9" style="v" sid="1CH 29:9" /><note caller="-" style="x"><char style="xo" closed="false">29:9: </char><char style="xt" closed="false"><ref loc="2KI 12:4">2 Bag 12:4</ref>; <ref loc="2CO 9:7">2 Kor 9:7</ref>. </char></note> Bwanyima abantu baashemererwa, ahabw'okuba abo bantu bakahayo n'omutima ogwekundiire; ahakuba bakahongyera MUKAMA n'omutima gwabo gwona batarikugyemwa; kandi n'omugabe Daudi yaashemererwa munonga.<verse eid="1CH 29:9" /></para>
  <para style="s1">Okushaba kwa Daudi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:10: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:68">Luk 1:68</ref>. </char>
    </note> N'ahabw'ekyo Daudi yaasiimira MUKAMA omu maisho g'omutwe gwona ogw'abantu abaabaire bateeraine, naagira ati: MUKAMA, Ruhanga wa Israeli tatenkuriitwe, osiimwe ebiro n'ebiro. <verse eid="1CH 29:10" /><verse number="11" style="v" sid="1CH 29:11" /><note caller="-" style="x"><char style="xo" closed="false">29:11: </char><char style="xt" closed="false"><ref loc="1TI 1:17">1 Tim 1:17</ref>; <ref loc="REV 5:13">Kush 5:13</ref>. </char></note> Ai MUKAMA, obukuru, obushoboorozi, ekitiinisa, obusinguzi n'okutiinwa n'ebyawe; ahakuba ebiri omu iguru n'eby'omu nsi byona n'ebyawe; obukama n'obwawe, ai MUKAMA, kandi ohimbisibwa ahabw'okuba Omutwe gwa byona. <verse eid="1CH 29:11" /><verse number="12" style="v" sid="1CH 29:12" /><note caller="-" style="x"><char style="xo" closed="false">29:12: </char><char style="xt" closed="false"><ref loc="1KI 3:13">1 Bag 3:13</ref>; <ref loc="2CH 1:12">2 Bus 1:12</ref>; <ref loc="2CH 20:6">20:6</ref>; <ref loc="ROM 11:36">Rom 11:36</ref>. </char></note> Obutungi n'ekitiinisa niiwe bikomookaho, kandi otegyeka byona. Omu mukono gwawe harimu obushoboorozi n'amaani, kandi niiwe orikubaasa kukuza, n'okuha boona amaani. <verse eid="1CH 29:12" /><verse number="13" style="v" sid="1CH 29:13" />Mwenu hati, Ruhanga waitu, nitukusiima, kandi nitusingiza eiziina ryawe ery'ekitiinisa.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14" />Mbwenu nkaanye ndi oha, nyowe n'abantu bangye, okubaasa kukuhongyera tuti n'omutima gwekundiire? Ahakuba byona biruga ahariiwe, kandi ebi twakuha n'ebyawe. <verse eid="1CH 29:14" /><verse number="15" style="v" sid="1CH 29:15" /><note caller="-" style="x"><char style="xo" closed="false">29:15: </char><char style="xt" closed="false"><ref loc="LEV 25:23">Lev 25:23</ref>; <ref loc="JOB 14:2">Yob 14:2</ref>; <ref loc="PSA 102:11">Zab 102:11</ref>; <ref loc="PSA 144:4">144:4</ref>. </char></note> Ahabw'okuba omu maisho gaawe turi abagyenyi n'abashuhuuki, nka baatatenkuriitwe boona oku baabaire bari; ebiro ebi tumara aha nsi ni nk'ekicuucu, tihariho matsiko g'okumereera. <verse eid="1CH 29:15" /><verse number="16" style="v" sid="1CH 29:16" />Ai MUKAMA Ruhanga waitu, ebintu ebi byona ebingi, ebi tuteekateekire kukwombekyera enju ahabw'eiziina ryawe eririkwera, birugire omu mukono gwawe, kandi byona n'ebyawe. <verse eid="1CH 29:16" /><verse number="17" style="v" sid="1CH 29:17" /><note caller="-" style="x"><char style="xo" closed="false">29:17: </char><char style="xt" closed="false"><ref loc="1CH 28:9">1 Bus 28:9</ref>; <ref loc="1SA 16:7">1 Sam 16:7</ref>; <ref loc="PRO 11:20">Enf 11:20</ref>; <ref loc="PRO 17:3">17:3</ref>. </char></note> Ruhanga wangye, nimmanya ngu ocaaka emitima, kandi oshemerererwa amazima; naanye ahabwangye naahonga ebintu ebi byona n'omutima gw'amazima ntarikugyemwa; kandi hati naareeba abantu baawe abari aha nibakuhongyera n'okushemererwa kwingi batarikugyemwa. <verse eid="1CH 29:17" /><verse number="18" style="v" sid="1CH 29:18" />Ai MUKAMA, Ruhanga wa Abrahamu, owa Isaaka, kandi n'owa Israeli baatatenkuriitwe, ebi obihamye omu biteekateeko by'omu mitima y'abantu baawe; otebeekanise emitima yaabo, ebe niiwe yaazaho. <verse eid="1CH 29:18" /><verse number="19" style="v" sid="1CH 29:19" /><note caller="-" style="x"><char style="xo" closed="false">29:19: </char><char style="xt" closed="false"><ref loc="1CH 22:14">1 Bus 22:14</ref>; <ref loc="PSA 72:1">Zab 72:1</ref>. </char></note> Kandi mutabani wangye Sulemaani, omuhe kworobera ebiragiro byawe n'ebi waahamize n'ebyatairweho n'omutima gwe gwona, akore ebyo byona, kandi ayombekye nyaruju ei naateekateekire kwombeka.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:20: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 4:31">Kur 4:31</ref>. </char>
    </note> Bwanyima Daudi yaagambira omutwe gwona ati: Musiime MUKAMA Ruhanga waanyu. Batyo abantu boona abaabaire bateeraine baasiima MUKAMA, Ruhanga wa baishenkurubo, bainika emitwe yaabo, baaramya MUKAMA, kandi baatangirira omugabe. <verse eid="1CH 29:20" /><verse number="21" style="v" sid="1CH 29:21" />Ku bwaseesire, baatambira MUKAMA ebitambo, kandi baamuhongyera empongano z'ebitambo by'okwotsya, enimi rukumi, empaya z'entaama rukumi, n'abaana b'entaama rukumi, hamwe n'empongano zaabyo z'eby'okunywa n'ebindi bitambo bingi munonga ahabwa Israeli yoona; <verse eid="1CH 29:21" /><verse number="22" style="v" sid="1CH 29:22" /><note caller="-" style="x"><char style="xo" closed="false">29:22: </char><char style="xt" closed="false"><ref loc="1KI 1:33-39">1 Bag 1:33-39</ref>; <ref loc="1KI 2:35">2:35</ref>; <ref loc="1CH 23:1">1 Bus 23:1</ref>. </char></note> eryo izooba baarya, baanywa bashemereirwe, bari omu maisho ga MUKAMA. Baagaruka baayemeka Sulemaani mwene Daudi omugabe obwa kabiri, baamushukaho amajuta g'okumushoroorera MUKAMA kuba omugabe, na Zadoki kuba omunyamurwa.<verse eid="1CH 29:22" /></para>
  <para style="s1">Sulemaani okwemekwa obwa kabiri</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 29:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:23: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 28:5">1 Bus 28:5</ref>; <ref loc="1KI 2:12">1 Bag 2:12</ref>; <ref loc="2CH 9:8">2 Bus 9:8</ref>. </char>
    </note> Atyo Sulemaani yaaza aha kitebe ky'obugabe ekya MUKAMA, yaaba omugabe omu mwanya gwa Daudi ishe; yaaba gye, Abaisraeli boona baamutiina. <verse eid="1CH 29:23" /><verse number="24" style="v" sid="1CH 29:24" />Abeebembezi boona n'abashaija amamanzi, kandi n'abatabani b'omugabe Daudi boona baahiga omu maisho g'omugabe Sulemaani, ku barikwija kuba abashaija be. <verse eid="1CH 29:24" /><verse number="25" style="v" sid="1CH 29:25" /><note caller="-" style="x"><char style="xo" closed="false">29:25: </char><char style="xt" closed="false"><ref loc="2CH 1:1">2 Bus 1:1</ref>, <ref loc="2CH 1:12">12</ref>; <ref loc="1KI 3:13">1 Bag 3:13</ref>; <ref loc="JOS 3:7">Yos 3:7</ref>. </char></note> MUKAMA yaakuza Sulemaani munonga omu maisho ga Israeli yoona, yaamuha ekitiinisa ky'obugabe ekitakabaga ha mugabe weena owaamubandiize omuri Israeli.<verse eid="1CH 29:25" /></para>
  <para style="s1">Okufa kwa Daudi</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26" />Okwo nikwo Daudi mwene Yese yaategyekire Israeli yoona. <verse eid="1CH 29:26" /><verse number="27" style="v" sid="1CH 29:27" />Emyaka ei yaamazire naategyeka Israeli ekahika makumi ana; emyaka mushanju akagimara Heburooni, kandi emyaka makumi ashatu n'eshatu yaagimara Yerusaalemu. <verse eid="1CH 29:27" /><verse number="28" style="v" sid="1CH 29:28" />Bwanyima yaafa, yaahikire omu ngingo zaabukuru, amazire ebiro bingi ari omutungi munonga, kandi aine ekitiinisa kingi; omutabani Sulemaani yaategyeka omu mwanya gwe. <verse eid="1CH 29:28" /><verse number="29" style="v" sid="1CH 29:29" />Ebi omugabe Daudi yaakozire byona, okwiha aha by'okubanza okuhitsya aha by'aha muheru, bihandiikirwe omu kitabo ky'ebyabaireho ekya Samueli omuhanuuzi, n'ekya Nasani nabi, kandi n'ekya Gaadi omuhanuuzi, <verse eid="1CH 29:29" /><verse number="30" style="v" sid="1CH 29:30" />hamwe n'eby'obutegyeki bwe bwona, n'eby'amaani ge, n'ebyamubaireho, n'ahari Israeli kandi n'aha bugabe bwona obw'ezo nsi.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>