<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">RRK41.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">MATAYO</para>
  <para style="toc1">Engiri nk'oku Yaahandiikirwe Matayo</para>
  <para style="toc2">Matayo</para>
  <para style="toc3">Mat</para>
  <para style="mt2">ENGIRI NK'OKU YAAHANDIIKIRWE</para>
  <para style="mt1">MATAYO</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s1">Amaziina ga baishenkuru ba Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1-17: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:23-38">Luk 3:23-38</ref>. </char>
    </note> Okutondoora obukomooko bwa Yesu Kristo, Omwana wa Daudi, Omwana wa Abrahamu.<note caller="-" style="x"><char style="xo" closed="false">1:1: </char><char style="xt" closed="false"><ref loc="GEN 5:1">Kut 5:1</ref>. </char></note> <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Abrahamu akazaara Isaaka, Isaaka yaazaara Yakobo, Yakobo yaazaara Yuda n'abarumuna, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" /><note caller="-" style="x"><char style="xo" closed="false">1:3: </char><char style="xt" closed="false"><ref loc="RUT 4:13-22">Rus 4:13-22</ref>. </char></note> Yuda yaazaara Pereezi na Zeera ahari Tamari, Pereezi yaazaara Hezirooni, Hezirooni yaazaara Raamu, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Raamu yaazaara Aminadabu, Aminadabu yaazaara Nahasooni, Nahasooni yaazaara Salumooni, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salumooni yaazaara Boazi ahari Rahabu, Boazi yaazaara Obedi ahari Ruusi, Obedi yaazaara Yese, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Yese yaazaara Daudi omugabe. Daudi yaazaara Sulemaani ahari muka Uria, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Sulemaani yaazaara Rehoboamu, Rehoboamu yaazaara Abiya, Abiya yaazaara Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa yaazaara Yehoshafaati, Yehoshafaati yaazaara Yoramu, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Yoramu yaazaara Hezekia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekia yaazaara Manaase, Manaase yaazaara Amoni, Amoni yaazaara Yosia, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosia yaazaara Yekonia n'abarumuna omu biro by'okutwarwa Babulooni omu bukwatwa.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Bwanyima y'okutwarwa Babulooni Yekonia akazaara Shealitieli, Shealitieli yaazaara Zerubabeeli, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabeeli yaazaara Abiuda, Abiuda yaazaara Eliakimu, Eliakimu yaazaara Azori, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azori yaazaara Zadoki, Zadoki yaazaara Akimu, Akimu yaazaara Eliudi, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliudi yaazaara Eleazaari, Eleazaari yaazaara Mataani, Mataani yaazaara Yakobo, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakobo yaazaara Yosefu iba wa Mariamu; ogwo niwe nyina wa Yesu orikwetwa Kristo.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Nikwo kugira ngu baishenkuru boona okwiha ahari Abrahamu okuhitsya ahari Daudi n'ikumi na bana; kandi okwiha ahari Daudi okuhitsya aha kutwarwa Babulooni n'ikumi na bana; kandi okwiha aha kutwarwa Babulooni okuhitsya ahari Kristo n'ikumi na bana.<verse eid="MAT 1:17" /></para>
  <para style="s1">Okuzaarwa kwa Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:35">Luk 1:35</ref>. </char>
    </note> Okuzaarwa kwa Yesu Kristo kukaba kuri kuti. Mariamu nyina wa Yesu akaba naagambwa Yosefu obugyenyi. Kwonka Yosefu ku yaabaire atakamutaahize, Mariamu yaareebwa aine enda y'Omwoyo Orikwera. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Mbwenu Yosefu iba, ahabw'okuba omuntu ohikiriire, tiyaayenda kumuhemura, yaateekateeka kwita obugyenyi bwe bwesherekye. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Kwonka ku yaabaire naakiteekateeka atyo, maraika wa Mukama yaamwizira omu kirooto, yaamugira ati: Iwe Yosefu mwene Daudi, otatiina kutaasya Mariamu omukazi waawe, ahakuba enda ei aine n'ey'Omwoyo Orikwera; <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />aryazaara omwana w'omwojo, kandi oryamweta Yesu, ahabw'okuba niwe arijuna abantu be omu bibi byabo. <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" /><note caller="-" style="x"><char style="xo" closed="false">1:22: </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isa 7:14</ref>. </char></note> Ebyo byona bikabaho ahabw'okuhikiiriza ebi Mukama yaagambire naaraba omuri nabi, naagira ati:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />Reeba, omwishiki oshugaine</para>
  <para style="q1" vid="MAT 1:23">Aryagira enda, azaare omwana w'omwojo,</para>
  <para style="q1" vid="MAT 1:23">Eiziina rye aryayetwa Emanueli,</para>
  <para style="m" vid="MAT 1:23">amakuru ngu Ruhanga ari hamwe naitwe. <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Yosefu ku yaasisiimukire omu turo, yaakora nk'oku maraika wa Mukama yaamuragiira; yaataasya omukazi we; <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" /><note caller="-" style="x"><char style="xo" closed="false">1:25: </char><char style="xt" closed="false"><ref loc="LUK 2:7">Luk 2:7</ref>. </char></note> kwonka tararaire nawe okuhitsya obu yaazaire omwana; ishe akamweta Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Abanyabwengye okuramya Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:1-7">Luk 2:1-7</ref>. </char>
    </note> Yesu ku yaazaariirwe Betelehemu eya Buyudaaya omu biro by'omugabe Heroode, hakaija abanyabwengye abaarugire oburugwa-izooba, baahika Yerusaalemu nibabuuza bati: <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" /><note caller="-" style="x"><char style="xo" closed="false">2:2: </char><char style="xt" closed="false"><ref loc="NUM 24:17">Kub 24:17</ref>. </char></note> Omugabe w'Abayudaaya ozairwe ari nkahi? Ahabw'okuba tukareeba enyonyoozi ye oburugwa-izooba, mbwenu twizire kumuramya. <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Omugabe Heroode, ku yaakihuriire, yaayemereza omutima hamwe n'aba Yerusaalemu boona; <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />nikwo kuteerana abanyamurwa abakuru n'abahandiiki b'abantu boona, akabeehanuuzaho ahu Kristo yaaragwirwe kuzaarirwa. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" /><note caller="-" style="x"><char style="xo" closed="false">2:5: </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mik 5:2</ref>. </char></note> Baamugarukamu bati: Omuri Betelehemu eya Buyudaaya; ahabw'okuba nikwo kyahandiikirwe nabi ngu:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />Naiwe, Betelehemu ey'omu ishaza rya Buyudaaya,</para>
  <para style="q1" vid="MAT 2:6">
    <note caller="+" style="f">
      <char style="fr" closed="false">2:6 </char>
      <char style="ft" closed="false">Tori mwanya mukye okukira emyanya yaaryo emikuru yoona. </char>
    </note>Tori muto okukira boona ab'omu banyiginya baaryo;</para>
  <para style="q1" vid="MAT 2:6">Ahabw'okuba omuriiwe nimwo omutegyeki ariruga,</para>
  <para style="q1" vid="MAT 2:6">Oririisa abantu bangye Abaisraeli.<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Bwanyima Heroode yaayeta abo banyabwengye omu mubonano, yaababuuza obunaku obu baareebeiremu enyonyoozi; <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />yaabatuma Betelehemu naabagira ati: Mwirooko mugyende, musherure gye ogwo mwana; ku muraamubone, mugarukye mungambire, naanye nze kumuramya. <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Nabo ku baaherize kuhurira ebi yaabatuma, baarabaho baagyenda; kandi enyonyoozi ei baareebire oburugwa-izooba yaabeebembera, okuhitsya obu yaayemereire ahu omwana yaabaire ari. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Ku baareebire enyonyoozi, baayesiima munonga n'okushemererwa kwingi; <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" /><note caller="-" style="x"><char style="xo" closed="false">2:11: </char><char style="xt" closed="false"><ref loc="PSA 72:10">Zab 72:10</ref>, <ref loc="PSA 72:15">15</ref>. </char></note> baataaha omu nju, baashangamu omwana na Mariamu nyina, bainama, baamuramya. Baakomoorora emitwaro yaabo, baamuha ebiconco by'ezaabu n'eby'emigaju na <note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fk" closed="false">Sumuruna: </char><char style="ft" closed="false">n'omubazi ogurikutuubya obusaasi, ogujwangibwa omu majuta g'okushoroora, ogwomya emitumbi n'ebindi. </char></note>sumuruna. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Kandi ku baahabwirwe Ruhanga omu kirooto, ngu barekye kugaruka owa Heroode, baimuka, baatoora ogundi muhanda, baagaruka owaabo.<verse eid="MAT 2:12" /></para>
  <para style="s1">Yosefu okuhungiza Yesu Misri</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 2:15">Kur 2:15</ref>. </char>
    </note> Ku baaherize kugyenda, maraika wa Mukama yaareebekyera Yosefu omu kirooto, yaamugira ati: Imuka otware omwana na nyina, ohungire Misri, ogumeyo okuhitsya obu ndikugambira; ahakuba Heroode naasherura omwana kumwita. <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Atyo yaimuka, yaahunzya omwana na nyina nyekiro, yaaza Misri, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" /><note caller="-" style="x"><char style="xo" closed="false">2:15: </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos 11:1</ref>. </char></note> yaagumayo okuhitsya obu Heroode yaafiire. Ekyo kikabaho okuhikiiriza ebi Mukama yaagambire naaraba omuri nabi ati: Nkeeta omwana wangye kuruga Misri.<verse eid="MAT 2:15" /></para>
  <para style="s1">Okucwekyereza abaana bato omuri Betelehemu</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kandi Heroode ku yaareebire abo banyabwengye bamureebize, yaagira ekiniga kingi, yaatuma abantu kwita abaana b'aboojo boona abaabaire bari Betelehemu n'omu kyanga ekyo kyona, abaabaire bahikize emyaka ebiri, kandi n'abatakagihikize, naihirira aha bunaku obu yaamanyisiibwemu abanyabwengye. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" /><note caller="-" style="x"><char style="xo" closed="false">2:17: </char><char style="xt" closed="false"><ref loc="JER 31:15">Yer 31:15</ref>. </char></note> Mbwenu eki nabi Yeremia yaagambire kyahikiirizibwa, eki yaagizire ati:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 35:19">Kut 35:19</ref>. </char>
    </note> Enduuru ekahurirwa omuri Raama,</para>
  <para style="q1" vid="MAT 2:18">Okucura n'okuborooga munonga,</para>
  <para style="q1" vid="MAT 2:18">Rakeeli naaririra abaana be;</para>
  <para style="q1" vid="MAT 2:18">Kandi takyenda kuyaagirwa, ahakuba bahweireho.<verse eid="MAT 2:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 2:19" />Bwanyima Heroode ku yaafiire, maraika wa Mukama yaayeyorekyera Yosefu omu kirooto omuri Misri, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" /><note caller="-" style="x"><char style="xo" closed="false">2:20: </char><char style="xt" closed="false"><ref loc="EXO 4:19">Kur 4:19</ref>. </char></note> yaamugira ati: Imuka otware omwana na nyina, ogarukye omu nsi ya Israeli; ahabw'okuba abaabaire nibenda kwita omwana bafiire. <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Yaimuka, yaatwara omwana na nyina, yaagaruka omu nsi ya Israeli. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Kwonka ku yaahuriire ngu Arukelao niwe ayemire Buyudaaya, ahunguriire Heroode ishe, yaatiina kugarukayo; ku yaahabwirwe Ruhanga omu kirooto, yaakuba yaaza omu ishaza rya Galilaaya. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" /><note caller="-" style="x"><char style="xo" closed="false">2:23: </char><char style="xt" closed="false"><ref loc="LUK 1:26">Luk 1:26</ref>; <ref loc="LUK 2:39">2:39</ref>; <ref loc="JHN 1:46">Yoh 1:46</ref>. </char></note> Nikwo kugyenda, akatuura omuri tauni erikwetwa Nazareesi, ekigambo eki baanabi baagambire kibone kuhikiirira ngu, Aryayetwa Omunazarayo.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Obutumwa bwa Yohaana Omubatizi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1-12: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:3-18">Luk 3:3-18</ref>; <ref loc="MRK 1:1-8">Mak 1:1-8</ref>. </char>
    </note> Omu biro ebyo Yohaana Omubatizi akaija naabuurira omu ihamba rya Buyudaaya,<note caller="-" style="x"><char style="xo" closed="false">3:1: </char><char style="xt" closed="false"><ref loc="LUK 1:13">Luk 1:13</ref>. </char></note> <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" /><note caller="-" style="x"><char style="xo" closed="false">3:2: </char><char style="xt" closed="false"><ref loc="MAT 4:17">Mat 4:17</ref>. </char></note> ati: Mweteise, ahakuba obukama bw'omu iguru bwiriire haihi. <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3: </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref>; <ref loc="JHN 1:23">Yoh 1:23</ref>. </char></note> Mumanye ngu ogu niwe nabi Isaaya yaagambireho, obu yaagira ati:</para>
  <para style="q1" vid="MAT 3:3">Eiraka ry'orikugambira omu ihamba ati:</para>
  <para style="q1" vid="MAT 3:3">Mushemeze omuhanda gwa Mukama,</para>
  <para style="q1" vid="MAT 3:3">Mugorore otuhanda twe.<verse eid="MAT 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:8">2 Bag 1:8</ref>. </char>
    </note> Kandi Yohaana akaba naajwara ekijwaro ky'ebyoya by'engamira, naayezirikisa orukoba rw'oruhu omunda; eby'okurya bye bikaba biri enzigye n'obwoki bw'omu ishwa. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Ahonaaho aba Yerusaalemu n'aba Buyudaaya n'ab'omu byanga ebiri haihi na Yorudani boona baija, baamushangayo; <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />yaababatiriza omu kyambu Yorudani nibaatura ebibi byabo.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">Mat 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>. </char>
    </note> Kwonka ku yaareebire Abafarisaayo n'Abasadukaayo baingi nibaija kubatizibwa, yaababuuza ati: Imwe baana b'enjoka 'mwe, n'oha obahabwire kuhunga ekiniga ekirikwenda kwija? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Mbwenu nu mwane ebyana ebishemereire abeeteisize, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" /><note caller="-" style="x"><char style="xo" closed="false">3:9: </char><char style="xt" closed="false"><ref loc="ROM 2:28">Rom 2:28</ref>, <ref loc="ROM 2:29">29</ref>; <ref loc="JHN 8:33">Yoh 8:33</ref>, <ref loc="JHN 8:39">39</ref>. </char></note> muteehimbisa nimugira omu mitima yaanyu muti: Twine Abrahamu, niwe tatenkuriitwe; ahakuba nyowe nimbagambira nti: Ruhanga naabaasa amabaare aga kugaihiramu Abrahamu abaijukuru. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="-" style="x"><char style="xo" closed="false">3:10: </char><char style="xt" closed="false"><ref loc="LUK 13:6-9">Luk 13:6-9</ref>; <ref loc="JHN 15:6">Yoh 15:6</ref>. </char></note> Na mbwenu empango eteirwe aha kitsintsi ky'omuti; buri muti ogutarikwana byana birungi guryatemwa gunagwe omu muriro. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3:11: </char><char style="xt" closed="false"><ref loc="JHN 1:15">Yoh 1:15</ref>, <ref loc="JHN 1:26">26</ref>, <ref loc="JHN 1:27">27</ref>, <ref loc="JHN 1:33">33</ref>; <ref loc="ACT 1:5">Byak 1:5</ref>. </char></note> Nyowe nimbabatiza n'amaizi ahabw'okweteisa, kwonka orikwija enyima yangye nankiza obushoboorozi; kandi tinshemereire na kumukwatira enkaito; We aryababatiza n'Omwoyo Orikwera n'omuriro. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Orugari rwe ruri omu ngaro ze, ahunikye oburo omu kitara kye, kwonka ebishushunga aryabyotsya omu muriro ogutaraara.<verse eid="MAT 3:12" /></para>
  <para style="s1">Okubatizibwa kwa Yesu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13-17: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:21-22">Luk 3:21-22</ref>; <ref loc="MRK 1:9-11">Mak 1:9-11</ref>; <ref loc="JHN 1:31-34">Yoh 1:31-34</ref>. </char>
    </note> Omu biro ebyo Yesu akaruga Galilaaya, yaija Yorudani, yaashangayo Yohaana ngu amubatize. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Kwonka Yohaana yaayenda kumwangira, naagira ati: Niinye ndikwenda ku ombatiza; kandi naiwe waija ahariinye? <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Yesu yaamugarukamu ati: Mbwenu ikiriza tutwaze tutyo! Ahakuba kitushemereire kuhikiiriza eby'okuhikiirira byona. Atyo yaamwikiriza. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Yesu ku yaaherize kubatizibwa, yaaruga ati omu maizi, reeba, eiguru ryakinguuka, yaareeba Omwoyo wa Ruhanga naamushuumaho nk'enkombe, <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" /><note caller="-" style="x"><char style="xo" closed="false">3:17: </char><char style="xt" closed="false"><ref loc="MAT 17:5">Mat 17:5</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>. </char></note> yaahurira eiraka niriruga omu iguru, nirigira riti: Ogu n'Omwana wangye ou nkunda, kandi ou nshemerererwa munonga.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Yesu okwohibwa Sitaane</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1-11: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:12">Mak 1:12</ref>, <ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>. </char>
    </note> Okuruga aho Yesu yaayebemberwa Omwoyo kuza omu ihamba kwohibwa Sitaane.<note caller="-" style="x"><char style="xo" closed="false">4:1: </char><char style="xt" closed="false"><ref loc="HEB 4:15">Heb 4:15</ref>. </char></note> <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" /><note caller="-" style="x"><char style="xo" closed="false">4:2: </char><char style="xt" closed="false"><ref loc="1KI 19:8">1 Bag 19:8</ref>. </char></note> Ku yaamazire ebiro makumi ana atarikurya nyomushana na nyekiro, yaagira enjara. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" /><note caller="-" style="x"><char style="xo" closed="false">4:3: </char><char style="xt" closed="false"><ref loc="GEN 3:1-7">Kut 3:1-7</ref>. </char></note> Omwohi yaija yaamugira ati: Ku oraabe ori Omwana Ruhanga, gambira amabaare aga gahindukye eby'okurya. <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" /><note caller="-" style="x"><char style="xo" closed="false">4:4: </char><char style="xt" closed="false"><ref loc="DEU 8:3">Bir 8:3</ref>. </char></note> Kwonka We yaamugarukamu ati: Kikahandiikwa ngu, Omuntu tatungwa by'okurya byonka, kureka n'ekigambo kyona ekiruga omu kanwa ka Ruhanga.<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Bwanyima yaamuhitsya omu rurembo orurikwera, yaamuta aha itungu rya hekalu, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" /><note caller="-" style="x"><char style="xo" closed="false">4:6: </char><char style="xt" closed="false"><ref loc="PSA 91:11">Zab 91:11</ref>, <ref loc="PSA 91:12">12</ref>. </char></note> yaamugira ati: Ku oraabe ori Omwana wa Ruhanga, guruka oyetsimbe ahansi; ahakuba kikahandiikwa ngu,</para>
  <para style="q1" vid="MAT 4:6">Aryaragiira baamaraika be, bakurinde;</para>
  <para style="q1" vid="MAT 4:6">Nabo baryakutega emikono yaabo,</para>
  <para style="q1" vid="MAT 4:6">Ngu orekye kuhikiza ekigyere kyawe aha ibaare.<verse eid="MAT 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:16">Bir 6:16</ref>. </char>
    </note> Yesu yaamugarukamu ati: kandi omanye ku kyahandiikirwe ngu: Otaryosya Mukama Ruhanga waawe.<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Kandi Sitaane yaamuhitsya aha rushozi ruraingwa munonga, yaamworeka ensi z'abagabe boona n'ekitiinisa kyazo; <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />yaamugira ati: Ku orainame, wandamya, biriya byona niinyija kubikuha. <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" /><note caller="-" style="x"><char style="xo" closed="false">4:10: </char><char style="xt" closed="false"><ref loc="DEU 6:13">Bir 6:13</ref>. </char></note> Yesu yaamugarukamu ati: Rugaho, Sitaane, ahabw'okuba kikahandiikwa ngu: Oramye Mukama Ruhanga waawe; obe niwe waaheereza wenka. <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" /><note caller="-" style="x"><char style="xo" closed="false">4:11: </char><char style="xt" closed="false"><ref loc="HEB 1:6">Heb 1:6</ref>, <ref loc="HEB 1:14">14</ref>. </char></note> Atyo Sitaane yaamurugaho; reeba baamaraika baija, baamuheereza.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu okutandika omurimo gwe</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12-17: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 4:14">Luk 4:14</ref>, <ref loc="LUK 4:15">15</ref>; <ref loc="MRK 1:14">Mak 1:14</ref>, <ref loc="MRK 1:15">15</ref>. </char>
    </note> Kandi Yesu, ku yaahuriire ngu Yohaana abohirwe, yaakuba yaagaruka Galilaaya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Yaaruga Nazareesi, yaataaha Kaperenaumu ey'aha nyanja, yaaguma omu mashaza ga Zebuluuni na Nafutaali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" /><note caller="-" style="x"><char style="xo" closed="false">4:14: </char><char style="xt" closed="false"><ref loc="ISA 9:1">Isa 9:1</ref>. </char></note> ngu ekigambo eki nabi Isaaya yaagambire kihikiirire eki yaagizire ati:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />Omu ishaza rya Zebuluuni, n'erya Nafutaali,</para>
  <para style="q1" vid="MAT 4:15">Haihi n'enyanja, seeri ya Yorudani,</para>
  <para style="q1" vid="MAT 4:15">Galilaaya ey'Abanyamahanga,<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Abantu abaabaire bari omu mwirima</para>
  <para style="q1" vid="MAT 4:16">Bakareeba omushana mwingi,</para>
  <para style="q1" vid="MAT 4:16">N'abaabaire batuura omu nsi y'okufa n'omu kibunda kyakwo,</para>
  <para style="q1" vid="MAT 4:16">Omushana gubajwereire.<verse eid="MAT 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 4:17" />Okuruga obwo Yesu yaatandika kubuurira naagira ati: Mweteise, ahakuba obukama bw'omu iguru bwiriire haihi.<verse eid="MAT 4:17" /></para>
  <para style="s1">Yesu okweta abeegi be ab'okubanza</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:18-22: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:16-20">Mak 1:16-20</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>. </char>
    </note> Yesu ku yaabaire naaraba aha rubaju rw'enyanja ya Galilaaya, yaareeba enyineemwe ibiri, Simooni orikwetwa Petero, na Anderea omurumuna, nibatega obutimba omu nyanja; ahabw'okuba bakaba bari abajubi.<note caller="-" style="x"><char style="xo" closed="false">4:18: </char><char style="xt" closed="false"><ref loc="JHN 1:40">Yoh 1:40</ref>. </char></note> <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" /><note caller="-" style="x"><char style="xo" closed="false">4:19: </char><char style="xt" closed="false"><ref loc="MAT 13:47">Mat 13:47</ref>. </char></note> Yaabagira ati: Mwije munkuratire, naanye ndyabagira abajubi b'abantu. <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" /><note caller="-" style="x"><char style="xo" closed="false">4:20: </char><char style="xt" closed="false"><ref loc="MAT 19:27">Mat 19:27</ref>. </char></note> Ahonaaho baatsigaho obutimba bwabo, baamukuratira. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Ku yairiire omu maisho hakye, yaareeba abandi babiri enyineemwe, Yakobo mwene Zebedaayo, na Yohaana omurumuna, abaabaire bari omu bwato nibashumikanisa obutimba; nabo yaabeeta. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Ahonaaho baatsigaho obwato na ishebo, baamukuratira.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:23: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 10:38">Byak 10:38</ref>. </char>
    </note> Bwanyima yaagyenda omuri Galilaaya yoona, naayegyesa omuri <note caller="+" style="f"><char style="fr" closed="false">4:23: </char><char style="ft" closed="false">Sinagogi: n'ekanisa y'ekiyudaaya. </char></note>sinagogi zaabo, naabuurira engiri y'obukama, kandi naatamba endwara zoona n'obumuga bwona omu bantu. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ahabw'ebyo okurangaanwa kwe kwabuga omuri Siria yoona, baamureetera abarwaire boona abaabaire bakwatsirwe endwara ezitari zimwe, n'okuhururwa, n'abaabaire bariho baadaimoni, n'abarikugwa entsimbo, n'abazingazingirwe; kandi yaabakiza. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Emitwe mingi y'abantu abarugire Galilaaya, Dekapooli, Yerusaalemu, Buyudaaya na seeri ya Yorudani baamukuratira.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Abaine omugisha oku bari</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:20-49">Luk 6:20-49</ref>. </char>
    </note> Ku yaareebire emitwe y'abantu, yaatemba ekibungo. Ku yaaherize kushutama ahansi, abeegi be baija ah'ari; <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />yaatandika kugamba naabeegyesa ati:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:15">Isa 57:15</ref>. </char>
    </note> Baine omugisha abooro omu mutima, ahabw'okuba abo obukama bw'omu iguru n'obwabo.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 126:5">Zab 126:5</ref>; <ref loc="ISA 61:3">Isa 61:3</ref>. </char>
    </note> Baine omugisha abaganya; ahabw'okuba abo baryahuumuzibwa.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:11">Zab 37:11</ref>. </char>
    </note> Baine omugisha abacureezi; ahabw'okuba abo baryahungura ensi.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Baine omugisha abagirira, eby'okuhikiirira enjara n'eiriho, ahabw'okuba abo baryahaaga.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Baine omugisha abanyambabazi, ahabw'okuba abo baryagirirwa embabazi.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:4">Zab 24:4</ref>; <ref loc="PSA 51:10">51:10</ref>; <ref loc="1JN 3:3">1 Yoh 3:3</ref>. </char>
    </note> Baine omugisha abashemeire omu mutima, ahabw'okuba abo baryareeba Ruhanga.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:9: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 3:18">Yak 3:18</ref>. </char>
    </note> Baine omugisha abagarukanisa abantu, ahabw'okuba abo baryayetwa abaana ba Ruhanga.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:14">1 Pet 3:14</ref>. </char>
    </note> Baine omugisha abahiigwa ahabw'okuhikiirira, ahabw'okuba obukama bw'omu iguru n'obwabo.<verse eid="MAT 5:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 5:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:11: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">1 Pet 4:14</ref>. </char>
    </note> Imwe mwine omugisha ku baribajuma, ku baribahiiga, ku baribabeiherera ekigambo kyona ekibi nibabantura. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><note caller="-" style="x"><char style="xo" closed="false">5:12: </char><char style="xt" closed="false"><ref loc="HEB 11:33-38">Heb 11:33-38</ref>. </char></note> Mushemererwe, mwesiime munonga; ahabw'okuba ebihembo byanyu biryaba bingi omu iguru; kandi nikwo baahiigire batyo baanabi abaabandize imwe.<verse eid="MAT 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:13: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">Mak 9:50</ref>. </char>
    </note> Imwe muri omwonyo gw'ensi; beitu ku guraabe guhweirwemu ensha, muryagigaruramu muta? Niguba gutakiine mugasho, kureka okunagwa aheeru, abantu bakaguribatiirira.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:14: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 8:12">Yoh 8:12</ref>. </char>
    </note> Imwe muri omushana gw'ensi. Orurembo orwombekirwe aha rushozi tirubaasa kusherekwa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><note caller="-" style="x"><char style="xo" closed="false">5:15: </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mak 4:21</ref>. </char></note> Kandi tihaine okongyeza etabaaza, akagijuumikira ekiibo, kureka agita aha kikondo kyayo kumurikira ab'omu nju boona. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><note caller="-" style="x"><char style="xo" closed="false">5:16: </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 Pet 2:12</ref>. </char></note> Omushana gwanyu gube nikwo gwajwa gutyo omu maisho g'abantu, bareebe emicwe yaanyu emirungi, babone kuhimbisa Shoimwe ori omu iguru.<verse eid="MAT 5:16" /></para>
  <para style="s1">Yesu okuhikiiriza Ebiragiro</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:17: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:31">Rom 3:31</ref>. </char>
    </note> Mutateekateeka ngu nkaija kwihaho Ebiragiro n'ebya Baanabi. Tindaizire kubiihaho kureka okubihikiiriza. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><note caller="-" style="x"><char style="xo" closed="false">5:18: </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luk 16:17</ref>; <ref loc="LUK 21:33">21:33</ref>. </char></note> Buzimazima nimbagambira nti: Eiguru n'ensi okuhitsya obu birihwaho, Ebiragiro tibirihwaho, n'obu yaakuba enyuguta emwe nari akatonyezi kamwe okuhitsya byona obu birihikiirizibwa. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" /><note caller="-" style="x"><char style="xo" closed="false">5:19: </char><char style="xt" closed="false"><ref loc="JAS 2:10">Yak 2:10</ref>. </char></note> Omuntu weena orihenda ekiragiro kimwe ahari ebi, n'obu kyakuba kiri kikye okukira ebindi byona, akakyegyesa abantu atyo, aryayetwa muto omu bukama bw'omu iguru; kwonka oribikwata, akabyegyesa, ogwo aryayetwa mukuru omu bukama bw'omu iguru. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Ahakuba nimbagambira nti: Okuhikiirira kwanyu ku kuriba kutakizire kuhikiirira kw'abahandiiki n'Abafarisaayo, timuritaaha mu bukama bw'omu iguru na kakye.<verse eid="MAT 5:20" /></para>
  <para style="s1">Okushoboorora ebiragiro.</para>
  <para style="s1">Otariita</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:21: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:13">Kur 20:13</ref>; <ref loc="LEV 24:17">Lev 24:17</ref>. </char>
    </note> Mukahurira ku kyaragiirwe aba ira ngu: otariita; kandi ngu: Oriita aryaba ashemereire kugiibwaho orubanja. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" /><note caller="-" style="x"><char style="xo" closed="false">5:22: </char><char style="xt" closed="false"><ref loc="1JN 3:15">1 Yoh 3:15</ref>. </char></note> Kwonka nyowe nimbagambira nti: omuntu weena <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Ogwerwa kubi mugyenzi we, ataine ki agambire. </char></note>origwerwa kubi mugyenzi we, aryaba ashemereire kugiibwaho orubanja; n'ogwo origambira mugyenzi we ati: <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Omugwerwa kubi, akagamba eky'okumugaya-Raaka! </char></note>Raaka! Aryaba ashemereire kutwarwa omu ishengyero; kandi orimugira ati: ori <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Omugwerwa kubi, akagamba eky'okumujuma. </char></note>ekifeera! Aryaba ashemereire kunagwa omuri Gehena y'omuriro. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />N'ahabw'ekyo ku oraabe oreetsire empongano yaawe aha itambiro, waijukira aho eki oshobeize mugyenzi waawe, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />otsigye empongano yaawe omu maisho g'eitambiro, ogyende, obanze ogarukane nawe, bwanyima ogarukye oheyo empongano yaawe egyo. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" /><note caller="-" style="x"><char style="xo" closed="false">5:25: </char><char style="xt" closed="false"><ref loc="LUK 12:58">Luk 12:58</ref>, <ref loc="LUK 12:59">59</ref>; <ref loc="MAT 18:35">Mat 18:35</ref>. </char></note> Rahuka kwikirizana n'ogwo orikukutabaariza, mukiri omu muhanda, orikukutabaariza atakaakuhayo aha muramuzi, n'omuramuzi akakuha omuserukare, naiwe okateebwa omu kihome. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Buzimazima ninkugambira nti: Torirugamu okuhitsya obu oriihura eibanja ryona, otatsigyeyo nangwa na sente emwe.<verse eid="MAT 5:26" /></para>
  <para style="s1">Otarishambana</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Mukahurira ku kyaragiirwe ngu: Otarishambana. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" /><note caller="-" style="x"><char style="xo" closed="false">5:28: </char><char style="xt" closed="false"><ref loc="2PE 2:14">2 Pet 2:14</ref>. </char></note> Kwonka nyowe nimbagambira nti: Orikureeba omukazi akamwetenga, biri aherize kumushambanaho omu mutima gwe. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><note caller="-" style="x"><char style="xo" closed="false">5:29: </char><char style="xt" closed="false"><ref loc="MRK 9:42-47">Mak 9:42-47</ref>. </char></note> N'eriisho ryawe rya buryo ku riraabe nirikureetera kukora ekibi, oriihemu, orinagye; haakiri okufeerwa ekicweka kyawe kimwe, okukira omubiri gwawe gwona okunagwa omuri Gehena. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Kandi omukono gwawe gwa buryo ku guraabe nigukureetera kukora ekibi, ogutemeho, ogunagye; haakiri okufeerwa ekicweka kyawe kimwe okukira omubiri gwawe gwona okunagwa omuri Gehena.<verse eid="MAT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:31: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:3-9">Mat 19:3-9</ref>; <ref loc="DEU 24:1">Bir 24:1</ref>. </char>
    </note> Kandi kikagambwa ngu, omuntu weena ku araashende omukazi we, amuhe ebaruha y'okumushenda. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><note caller="-" style="x"><char style="xo" closed="false">5:32: </char><char style="xt" closed="false"><ref loc="LUK 16:18">Luk 16:18</ref>; <ref loc="1CO 7:10">1 Kor 7:10</ref>, <ref loc="1CO 7:11">11</ref>. </char></note> Kwonka nyowe nimbagambira nti: Omuntu weena orishenda omukazi we, atamutuzire kushambana, biri aryaba amushambaniise, kandi orishwera ogwo oshenzirwe, biri aryaba ashambaine.<verse eid="MAT 5:32" /></para>
  <para style="s1">Otarirahira ebishuba</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:33: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 30:2">Kub 30:2</ref>. </char>
    </note> Kandi mukahurira ku kyaragiirwe aba ira ngu: otarirahira ebishuba, kureka oryahikiiriza ahari Mukama ebi warahiire. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><note caller="-" style="x"><char style="xo" closed="false">5:34: </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa 66:1</ref>; <ref loc="ACT 7:49">Byak 7:49</ref>. </char></note> Kwonka nyowe nimbagambira nti: otarirahira na kakye, n'obu ryakuba eiguru, ahakuba n'ekitebe kya Ruhanga, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" /><note caller="-" style="x"><char style="xo" closed="false">5:35: </char><char style="xt" closed="false"><ref loc="PSA 48:2">Zab 48:2</ref>. </char></note> n'obu yaakuba ensi, ahakuba n'akatebe k'ebigyere bye, n'obu yaakuba Yerusaalemu, ahakuba n'orurembo rw'Omukama Omukuru. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Otarirahira omutwe gwawe; ahakuba torikubaasa kweza kashokye kamwe n'obu kwakuba okukairaguza. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" /><note caller="-" style="x"><char style="xo" closed="false">5:37: </char><char style="xt" closed="false"><ref loc="JAS 5:12">Yak 5:12</ref>. </char></note> Kwonka ebigambo byanyu bibe, Eego, Eego, nari Ngaaha, Ngaaha; ahakuba ebirikukira ahari ebyo biruga aha Mubi.<verse eid="MAT 5:37" /></para>
  <para style="s1">Otaryehoorera enzigu, okunde abarikukwanga</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:38: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 24:19">Lev 24:19</ref>, <ref loc="LEV 24:20">20</ref>. </char>
    </note> Mukahurira ku kyagambirwe ngu: Eriisho riryarihwa eriisho; kandi eriino riryarihwa eriino. <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" /><note caller="-" style="x"><char style="xo" closed="false">5:39-48: </char><char style="xt" closed="false"><ref loc="LUK 6:27-36">Luk 6:27-36</ref>. </char></note> Kwonka nyowe nimbagambira nti: Otarirwana n'omuntu mubi. Omuntu weena orikuteera oruhi rw'omushaya gwa buryo, omuhindurire ogwa bumosho;<note caller="-" style="x"><char style="xo" closed="false">5:39: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref>; <ref loc="JHN 18:22">Yoh 18:22</ref>, <ref loc="JHN 18:23">23</ref>. </char></note> <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" /><note caller="-" style="x"><char style="xo" closed="false">5:40: </char><char style="xt" closed="false"><ref loc="1CO 6:7">1 Kor 6:7</ref>. </char></note> n'omuntu ku aryenda kukutabaariza ngu akwakye ekanzu yaawe, omuhe n'omunagiro gwawe. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Kandi weena orikugyema kugyenda nawe mahiro emwe, ogyende nawe n'eya kabiri. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Orikushaba, omuhe; orikweguzaho, otarimuteera amabega.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:43: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:18">Lev 19:18</ref>. </char>
    </note> Mukahurira ku kyagambirwe ngu: okunde mutaahi waawe, oyangye omuzigu waawe. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" /><note caller="-" style="x"><char style="xo" closed="false">5:44: </char><char style="xt" closed="false"><ref loc="EXO 23:4">Kur 23:4</ref>, <ref loc="EXO 23:5">5</ref>; <ref loc="ROM 12:14">Rom 12:14</ref>, <ref loc="ROM 12:20">20</ref>; <ref loc="LUK 23:34">Luk 23:34</ref>; <ref loc="ACT 7:59">Byak 7:59</ref>. </char></note> Kwonka nyowe nimbagambira nti: Mukunde abazigu baanyu, kandi mushabire n'abarikubahiiga, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />mubone kuba abaana ba Shoimwe ori omu iguru; ahabw'okuba eizooba rye arijwisiza ababi n'abarungi, kandi agwisiza enjura abahikiriire n'abatahikiriire. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Mbwenu ku muraabe nimukunda abarikubakunda, muryaheebwa bihembo ki? N'abahooza tikwo bakora batyo? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Kandi ku muraabe nimuramutsya beene waanyu bonka, abandi nimubakiza ki? N'abanyamahanga tikwo bakora batyo? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />N'ahabw'ekyo mube abahikiriire nka Shoimwe ori omu iguru oku ahikiriire.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Okutakorera kusiimwa abantu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Mwerinde, murekye kukorera eby'okuhikiirira byanyu omu maisho g'abantu ngu babareebe; mumanye ngu, ku muraabe nimukora mutyo, Shoimwe ori omu iguru taribaha bihembo. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />N'ahabw'ekyo ku origabira abooro, otaryeteerera enzamba, nk'oku endyarya zikora omuri sinagogi n'omu nguuto, ngu basiimwe abantu. Buzimazima nimbagambira nti: Baherize kuheebwa ebihembo byabo. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Kwonka ku oraabe waagabiire abooro, omukono gwawe gwa bumosho gurekye kumanya eki ogwa buryo gurikukora, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />okugaba kwawe kube omu mubonano; kandi Sho oreeba eby'omu mubonano aryakuha ebihembo.<verse eid="MAT 6:4" /></para>
  <para style="s1">Eby'okushaba</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">Mat 23:5</ref>, <ref loc="MAT 23:6">6</ref>. </char>
    </note> Ku muraabe nimushaba, murekye kuba nk'endyarya; ahabw'okuba bakunda kushaba beemereire omuri sinagogi n'omu mateeraniro g'enguuto, ngu bareebwe abantu. Buzimazima nimbagambira nti: Abo baherize kuheebwa ebihembo byabo. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Kwonka iwe ku oraaze kushaba, otaahe omu kishengye kyawe, obanze okingye orwigi, oshabe Sho ori omu mubonano; kandi Sho ogwo oreeba eby'omu mubonano, aryakuha ebihembo.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:15">Isa 1:15</ref>. </char>
    </note> Ku muraabe nimushaba, murekye kushaba nimugarukagaruka omu bigambo bya busha, nk'oku abanyamahanga bashaba; haza nibateekateeka ngu nibaija kuhurirwa ahabw'ebigambo byabo bingi. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mutariba nkabo; ahakuba Shoimwe amanya ebi mukyenire mutakamushabire. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" /><note caller="-" style="x"><char style="xo" closed="false">6:9: </char><char style="xt" closed="false"><ref loc="LUK 11:2-4">Luk 11:2-4</ref>. </char></note> N'ahabw'ekyo mushabe muti:</para>
  <para style="q1" vid="MAT 6:9">Tataitwe ow'omu iguru,</para>
  <para style="q1" vid="MAT 6:9">Eiziina ryawe ryezibwe,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:10: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:42">Luk 22:42</ref>. </char>
    </note> Obukama bwawe bwije;</para>
  <para style="q1" vid="MAT 6:10">Eby'okunda bikorwe omu nsi</para>
  <para style="q1" vid="MAT 6:10">Nk'oku bikorwa omu iguru;<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Otuhe hati eby'okurya ebi otuha obutoosha;<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:12: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:21-35">Mat 18:21-35</ref>. </char>
    </note> Otusaasire amabanja gaitu,</para>
  <para style="q1" vid="MAT 6:12">Nkaitwe oku tusaasira abu turikwihuza;<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:13: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 29:11-13">1 Bus 29:11-13</ref>. </char>
    </note> Otatutwara omu kwohibwa</para>
  <para style="q1" vid="MAT 6:13">Kureka otujune Omubi.<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Ku murisaasira abantu eby'okushiisha byabo, naimwe Shoimwe ow'omu iguru aryabasaasira; <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" /><note caller="-" style="x"><char style="xo" closed="false">6:15: </char><char style="xt" closed="false"><ref loc="MRK 11:25">Mak 11:25</ref>, <ref loc="MRK 11:26">26</ref>. </char></note> kwonka ku muriba mutarikusaasira bantu eby'okushiisha byabo, naimwe Shoimwe taribasaasira by'okushiisha byanyu.<verse eid="MAT 6:15" /></para>
  <para style="s1">Eby'okwesiibyakwo</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 58:5-9">Isa 58:5-9</ref>. </char>
    </note> Ku muraabe nimwesiibyakwo, murekye kuba nk'endyarya, abeeyoreka baine enaku; ahakuba beeshiisha ahamaisho, ngu abantu babareebe ku beesiibizekwo. Buzimazima nimbagambira nti: Abo baherize kuheebwa ebihembo byabo. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Kwonka iwe, ku oraayesiibyekwo, ogume oyesiigye amajuta omu mutwe, onaabe ahamaisho, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />abantu barekye kukureeba ku oyesiibizekwo, kureka Sho ori omu mubonano; kandi Sho oreeba eby'omu mubonano aryakuha ebihembo.<verse eid="MAT 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Mutaryebiikira eitungo omu nsi, ahi ebiyenje n'omukyereenyo birisiisira, n'abashuma ahu barima bakariiba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" /><note caller="-" style="x"><char style="xo" closed="false">6:20: </char><char style="xt" closed="false"><ref loc="COL 3:1">Kol 3:1</ref>, <ref loc="COL 3:2">2</ref>. </char></note> Kwonka mwebiikire eitungo omu iguru, ahi ebiyenje n'omukyereenyo bitaririsiisira, n'abashuma ahu bataririma bakariiba; <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />ahakuba ahi eitungo ryawe riri, n'omutima gwawe niho guba.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Etabaaza ey'omubiri niryo riisho. N'ahabw'ekyo eriisho ryawe ku riraabe riri rirungi, omubiri gwawe gwona nigwija kwijura omushana; <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />kwonka eriisho ryawe ku riraabe riri ribi, omubiri gwawe gwona nigwija kwijura omwirima. Mbwenu omushana oguri omuriiwe ku guraabe guri omwirima, omwirima ogwo ka ni mwingi!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Tihariho muntu orikubaasa kuheereza abakama babiri; ahakuba aryayangaho omwe, akunde ondi; nari aryagumira kyarimwe ahari omwe, agaye ondi. Timurikubaasa kuheereza Ruhanga na <note caller="+" style="f"><char style="fr" closed="false">6:24 </char><char style="fk" closed="false">Mamona: </char><char style="ft" closed="false">n'ekigambo ky'orurimi orurikwetwa “Aramaic”, amakuru ngu eitungo. </char></note>Mamona.<verse eid="MAT 6:24" /></para>
  <para style="s1">Okuteemereza mutima</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:25-33: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:22-31">Luk 12:22-31</ref>. </char>
    </note> N'ahabw'ekyo nimbagambira nti: Mutaryemereza emitima yaanyu nimuteekateeka aha by'amagara gaanyu, nimutonzya muti, Turyarya ki? Turyanywa ki? N'aha mibiri yaanyu muti, Turyajwara ki? Amagara tigarikukira eby'okurya, n'omubiri tigurikukira ebijwaro?<note caller="-" style="x"><char style="xo" closed="false">6:25: </char><char style="xt" closed="false"><ref loc="PHP 4:6">Fil 4:6</ref>; <ref loc="1PE 5:7">1 Pet 5:7</ref>. </char></note> <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mwetegyereze enyonyi z'omu mwanya; tizibiba, tizigyesha, n'obu kwakuba okuhunika omu bitara; kwonka Shoimwe ow'omu iguru aziriisa. Mbwenu imwe timurikuzikira? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />N'oha omuriimwe <note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">nari: orikubaasa kwongyera aha rugyero rwe ekita na kimwe. </char></note>orikubaasa kwongyera ekiro na kimwe aha rugyero rw'emyaka y'obukuru bwe ahabw'okwemereza omutima? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />Mbwenu n'enki ekibeemereresa emitima ahabw'ebijwaro? Mwetegyereze ebirabyo by'omu ishwa oku bimera; tibigira murimo, tibiruka myenda; <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />beitu nimbagambira nti: Na Sulemaani omu kitiinisa kye kyona taraizihiirwe bijwaro nka kimwe aharibyo.<verse eid="MAT 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 6:30" />Mbwenu Ruhanga ku araabe ajweka obunyaatsi bw'omu kishaka, oburiho hati, nyencakare bukanagwa omu mahega, tarikizaho kubajweka, imwe abaine okwikiriza kukye? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />N'ahabw'ekyo mutaryemereza emitima nimutonzya muti, Turyarya ki? Nari, Turyanywa ki? Nari shi, Turyajwara ki? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ahakuba ebyo byona Abanyamahanga nibyo basherura; kandi Shoimwe ow'omu iguru naamanya ku ebyo byona bibashemereire. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" /><note caller="-" style="x"><char style="xo" closed="false">6:33: </char><char style="xt" closed="false"><ref loc="1KI 3:13">1 Bag 3:13</ref>, <ref loc="1KI 3:14">14</ref>; <ref loc="PSA 37:25">Zab 37:25</ref>. </char></note> Kwonka mubanze musherure obukama bwe n'okuhikiirira kwe; n'ebyo byona muryabyongyerwaho. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />N'ahabw'ekyo mutaryemereza emitima aha bya nyencakare; ahakuba ebya nyencakare biryayemererezibwa omutima okwabyo. Reka buri kiro kihwe n'amaganya gaakyo.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Okutacwererana manja</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:1">Rom 2:1</ref>. </char>
    </note> Mutaricwa orubanja, nyentsya naimwe mutarirucwerwa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><note caller="-" style="x"><char style="xo" closed="false">7:2: </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mak 4:24</ref>. </char></note> Ahabw'okuba orubanja oru mucwa, naimwe muryarucwerwa; kandi endengo ei murengamu, naimwe niyo murirengyerwamu. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Ahabwenki nooreeba akatokoozi akari omu riisho rya mugyenzi waawe, haza empimbi eri omu ryawe otagyeteho? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Nari shi noija kugambira mugyenzi waawe oti, Ka nkutokoore, haza obwo bwona empimbi eri omu riisho ryawe? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Iwe ndyarya 'we, banza oyekize empimbi eri omu riisho ryawe, obone kureeba gye oku oraatokoore mugyenzi waawe. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Mutariha embwa ekintu ekirikwera, nari okutambikira empunu <note caller="+" style="f"><char style="fr" closed="false">7:6 </char><char style="ft" closed="false">eruuru ni nk'otubaare oturikwera otw'obuguzi bwingi. </char></note>eruuru zaanyu, zitakaaziribata, zikabahindukana, zikabarya.<verse eid="MAT 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:7: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:9-13">Luk 11:9-13</ref>; <ref loc="MRK 11:24">Mak 11:24</ref>; <ref loc="JHN 14:13">Yoh 14:13</ref>; <ref loc="JHN 16:23">16:23</ref>. </char>
    </note> Mushabe, muryaheebwa; musherure, muryazoora; mwiguze, muryaigurirwaho. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ahakuba omuntu weena oshaba aheebwa; osherura azoora; oiguza aigurirwaho. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Ni muntu ki omuriimwe, ou omwana we yaakushaba omugaati, akmuha eibaare? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Nari ku yaakushaba eky'enyanja, akaamuha enjoka? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" /><note caller="-" style="x"><char style="xo" closed="false">7:11: </char><char style="xt" closed="false"><ref loc="JAS 1:17">Yak 1:17</ref>. </char></note> Imwe ku muraabe nimumanya kuha abaana baanyu ebirungi, haza muri babi, Shoimwe ow'omu iguru tarikizaho kuha ebirungi abo abamushaba? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><note caller="-" style="x"><char style="xo" closed="false">7:12: </char><char style="xt" closed="false"><ref loc="ROM 13:8-10">Rom 13:8-10</ref>. </char></note> N'ahabw'ekyo byona ebi mwenda ngu abantu babagirire, naimwe mube nikwo mwabagirira; ahakuba ebyo nibyo Biragiro kandi n'ebya Baanabi.<verse eid="MAT 7:12" /></para>
  <para style="s1">Eby'Eirembo rifunzire</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:24">Luk 13:24</ref>; <ref loc="JHN 10:7">Yoh 10:7</ref>, <ref loc="JHN 10:9">9</ref>. </char>
    </note> Mutaahire omu irembo erifunzire; ahakuba eirembo eririkutaasya omu kucwekyerera rigarami, n'omuhanda gwaryo guba muhango, kandi n'abagutooramu baba baingi; <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" /><note caller="-" style="x"><char style="xo" closed="false">7:14: </char><char style="xt" closed="false"><ref loc="ACT 14:22">Byak 14:22</ref>. </char></note> kwonka eirembo eririkutaasya omu magara rifunzire, n'akahanda kaaryo kagumire, n'abakazoora baba bakye.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:15: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:4">Mat 24:4</ref>, <ref loc="MAT 24:5">5</ref>, <ref loc="MAT 24:24">24</ref>; <ref loc="ACT 20:29">Byak 20:29</ref>. </char>
    </note> Mwerinde baanabi b'ebishuba ababaizira nibeeshushanisa nk'entaama, haza omunda bari emishega esheegire. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" /><note caller="-" style="x"><char style="xo" closed="false">7:16: </char><char style="xt" closed="false"><ref loc="GAL 5:19-22">Gal 5:19-22</ref>. </char></note> Muryabamanyira aha byana byabo. Hariho abaakushoroma emizaabibu aha munyinya, nari shi emitiini aha matojo? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />N'omuti gwona omurungi gwana ebyana birungi, kandi omuti omubi gwana ebyana bibi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Omuti murungi tigubaasa kwana byana bibi, kandi omuti mubi tigubaasa kwana byana birungi. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><note caller="-" style="x"><char style="xo" closed="false">7:19: </char><char style="xt" closed="false"><ref loc="JHN 15:2">Yoh 15:2</ref>, <ref loc="JHN 15:6">6</ref>. </char></note> Omuti gwona ogutaana byana birungi gutemwa, gunagwa omu muriro. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />N'ahabw'ekyo muryabamanyira aha byana byabo. <verse eid="MAT 7:20" /><verse number="21" style="v" sid="MAT 7:21" /><note caller="-" style="x"><char style="xo" closed="false">7:21: </char><char style="xt" closed="false"><ref loc="MAT 21:29">Mat 21:29</ref>; <ref loc="JAS 1:22-25">Yak 1:22-25</ref>; <ref loc="1CO 12:3">1 Kor 12:3</ref>. </char></note> Omuntu weena orikungira ati: Mukama wangye, Mukama wangye, tiwe aritaaha mu bukama bw'omu iguru, kureka orikukora ebi Tata ow'omu iguru akunda. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" /><note caller="-" style="x"><char style="xo" closed="false">7:22: </char><char style="xt" closed="false"><ref loc="JER 27:15">Yer 27:15</ref>; <ref loc="LUK 13:25-27">Luk 13:25-27</ref>. </char></note> Baingi baryayetonganira aha kiro ekyo bati: Mukama waitu, Mukama waitu, torikumanya ku twaburiire omu iziina ryawe, ku twabingire baadaimoni omu iziina ryawe, kandi ku twakozire eby'okutangaaza bingi omu iziina ryawe? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" /><note caller="-" style="x"><char style="xo" closed="false">7:23: </char><char style="xt" closed="false"><ref loc="MAT 25:41">Mat 25:41</ref>; <ref loc="2TI 2:19">2 Tim 2:19</ref>. </char></note> Haza naanye ndyabagarukamu nti: Tinkabamanyaga; mundugye omu maisho, imwe abakora eby'obugomi!<verse eid="MAT 7:23" /></para>
  <para style="s1">Eby'enju ey'aha rukiri n'ey'aha musheenyi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Buri muntu weena ohurira ebigambo byangye ebi, akabyorobera, naashushanisibwa n'omuntu ow'obwengye, owaayombekire enju ye aha rukiri; <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />bwanyima enjura ekagwa, omwegyemure gukahimintika, eihunga rikahuuha, byona bikateera egyo nju, kwonka etagwe, ahabw'okuba ekaba eyombekirwe aha rukiri. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Na buri muntu weena ohurira ebigambo byangye, atabyorobere, naashushanisibwa n'omuntu owaayombekire enju ye aha musheenyi; <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" /><note caller="-" style="x"><char style="xo" closed="false">7:27: </char><char style="xt" closed="false"><ref loc="EZK 13:10">Ezk 13:10</ref>, <ref loc="EZK 13:11">11</ref>. </char></note> bwanyima enjura ekagwa, omwegyemure gukahimintika, eihunga rikahuuha, bikateera egyo nju, ekagwa; n'okugwa kwayo kukaba kuhango. <verse eid="MAT 7:27" /><verse number="28" style="v" sid="MAT 7:28" /><note caller="-" style="x"><char style="xo" closed="false">7:28: </char><char style="xt" closed="false"><ref loc="MRK 1:22">Mak 1:22</ref>. </char></note> Bwanyima Yesu, ku yaaherize kugamba ebigambo ebyo, abantu baatangaarira okwegyesa kwe, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />ahabw'okuba akabeegyesa nk'oine obushoboorozi, kwonka ti nk'abahandiiki.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu okukiza omubembe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:12-14">Luk 5:12-14</ref>; <ref loc="MRK 1:40-44">Mak 1:40-44</ref>. </char>
    </note> Yesu ku yaashuumire naaruga omu kibungo, emitwe y'abantu baingi munonga yaamukuratira. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Kandi reeba, haija omubembe, yaamutsimbira amaju, yaagira ati: Mukama wangye, ku oraabe nookunda, noobaasa kunshemeza. <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yesu yaagorora omukono, yaamukoraho, yaamugira ati: Ninkunda; shemera! Ahonaaho ebibembe bye byashemezibwa. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" /><note caller="-" style="x"><char style="xo" closed="false">8:4: </char><char style="xt" closed="false"><ref loc="LEV 13:49">Lev 13:49</ref>; <ref loc="LEV 14:2-32">14:2-32</ref>; <ref loc="MRK 7:36">Mak 7:36</ref>. </char></note> Yesu yaamuragiira ati: Oyerinde, otagira ou waagambira; kwonka irooko ogyende, oyeyorekye aha munyamurwa, oheyo eky'okusiima eki Musa yaaragiire, kibe eky'okuhamya omu maisho g'abantu.<verse eid="MAT 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:5-13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:1-10">Luk 7:1-10</ref>. </char>
    </note> Ku yaabaire naakitaaha omuri Kaperenaumu, haija omukuru w'abaserukare, yaamweshengyereza,<note caller="-" style="x"><char style="xo" closed="false">8:5: </char><char style="xt" closed="false"><ref loc="JHN 4:47">Yoh 4:47</ref>. </char></note> <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />naagira ati: Mukama wangye, omuheereza wangye abyami omu nju, azingazingirwe, naahururwa munonga. <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yaamugarukamu naagira ati: Ka nyije, mmukize. <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Omukuru w'abaserukare yaamugarukamu naagira ati: Mukama wangye, tindi muntu ou oshemereire kutaaha omu nju ye; fa okugamba ekigambo kwonka, omuheereza wangye naija kukira. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Manya naanye ndi omuntu orikutwarwa, kandi nyine abaserukare abu ndikutegyeka. Ku ndagiira omwe nti, Gyenda, agyenda; n'ondiijo nti, Ija, aija; n'omuhuuku wangye nti, Gira oti, nawe agira kwo. <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yesu ku yaakihuriire, yaatangaara, yaagambira abaabaire bamukuratiire, ati: Tinkareebaga kwikiriza okurikwingana kuti, n'obu haakuba omu Baisraeli. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><note caller="-" style="x"><char style="xo" closed="false">8:11: </char><char style="xt" closed="false"><ref loc="LUK 13:28">Luk 13:28</ref>, <ref loc="LUK 13:29">29</ref>; <ref loc="MAL 1:11">Mal 1:11</ref>. </char></note> Kandi nimbagambira nti: Baingi baryaruga oburugwa-izooba n'oburengyerwa-izooba, bashutame na Abrahamu na Isaaka na Yakobo omu bukama bw'omu iguru, <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><note caller="-" style="x"><char style="xo" closed="false">8:12: </char><char style="xt" closed="false"><ref loc="MAT 25:30">Mat 25:30</ref>. </char></note> kwonka abaana b'obukama baryabingirwa aheeru omu mwirima; niho bariririra, bakanena enshaya. <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" /><note caller="-" style="x"><char style="xo" closed="false">8:13: </char><char style="xt" closed="false"><ref loc="MAT 15:28">Mat 15:28</ref>. </char></note> Yesu yaagambira omukuru w'abaserukare ati: irooko oyegyendere; nk'oku waikiriza, kikukorerwe kityo. Omuheereza we yaakira omuri ako kanya.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu okutambira nyinazaara wa Petero</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:14-16: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:29-34">Mak 1:29-34</ref>; <ref loc="LUK 4:38-41">Luk 4:38-41</ref>. </char>
    </note> Yesu ku yaataahire omu nju ya Petero, yaashanga nyinazaara abyami arwaire omushwija;<note caller="-" style="x"><char style="xo" closed="false">8:14: </char><char style="xt" closed="false"><ref loc="1CO 9:5">1 Kor 9:5</ref>. </char></note> <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />yaamukora aha mukono, omushwija gwamurugaho; yaimuka, yaamuheereza. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Kandi ku bwabaire nibwira, baamureetera baingi abaabaire bariho baadaimoni, yaababingisa ekigambo kwonka, yaakiza boona abaabaire barwaire. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" /><note caller="-" style="x"><char style="xo" closed="false">8:17: </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isa 53:4</ref>. </char></note> Ebyo byahikiiriza ebyagambirwe nabi Isaaya ati: We wenka akatwara obweremwa bwaitu, yaayekorera endwara zaitu.<verse eid="MAT 8:17" /></para>
  <para style="s1">Okukuratira Yesu</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:18: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:35">Mak 4:35</ref>. </char>
    </note> Yesu ku yaareebire emitwe mingi emwehinguririize, yaaragiira kwambuka seeri. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" /><note caller="-" style="x"><char style="xo" closed="false">8:19-22: </char><char style="xt" closed="false"><ref loc="LUK 9:57-60">Luk 9:57-60</ref>. </char></note> Haija omuhandiiki, yaamugira ati: Mwegyesa, niinyija kukukuratira ahu oraaze hoona. <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" /><note caller="-" style="x"><char style="xo" closed="false">8:20: </char><char style="xt" closed="false"><ref loc="2CO 8:9">2 Kor 8:9</ref>. </char></note> Yesu yaamugarukamu ati: Zaamuha ziine ebiina, n'enyonyi z'omu mwanya ziine ebyashuri; kwonka Omwana w'omuntu taine na h'okuta omutwe. <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" /><note caller="-" style="x"><char style="xo" closed="false">8:21: </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 Bag 19:20</ref>. </char></note> Ondi aha beegi be yaamugambira ati: Mukama wangye, reka, mbanze ngyende nziikye tata. <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Kwonka Yesu yaamugarukamu ati: Nkuratira; reka abafu baziikye abafu baabo.<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu okucureeza enyanja</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:23-27: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:36-41">Mak 4:36-41</ref>; <ref loc="LUK 8:23-25">Luk 8:23-25</ref>. </char>
    </note> Yesu ku yaagiire omu bwato, abeegi be baagyenda nawe. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" /><note caller="-" style="x"><char style="xo" closed="false">8:24: </char><char style="xt" closed="false"><ref loc="PSA 4:8">Zab 4:8</ref>. </char></note> Eihunga ry'amaani ryaija omu nyanja, ebingonzi byayeshuka omu bwato; kwonka We akaba agwejegyeire. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Baija ah'ari, baamusisiimura nibagira bati: Mukama waitu, tujune, twafa. <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" /><note caller="-" style="x"><char style="xo" closed="false">8:26: </char><char style="xt" closed="false"><ref loc="MAT 14:31">Mat 14:31</ref>; <ref loc="MAT 16:8">16:8</ref>. </char></note> Yaababuuza ati: Nimutiina ki, imwe abaine okwikiriza kukye? Ahonaaho yaimuka, yaakabukira eihunga n'enyanja, byacureera munonga. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Abashaija abo baatangaara, nibagira bati: Ogu ni muntu ki, ou eihunga n'enyanja birikuhurira?<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu okubinga baadaimoni aha bantu babiri</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:28-34: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:26-37">Luk 8:26-37</ref>; <ref loc="MRK 5:1-17">Mak 5:1-17</ref>. </char>
    </note> Ku yaayambukire seeri omu ishaza ry'Abagadarene, yaabuganwa abantu babiri abaabaire bariho baadaimoni, nibaruga omu bituuro, bagwire munonga eiraro, hatariho muntu owaakwehanga kuraba ogwo muhanda. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Ku baamureebire, baayomba munonga nibagira bati: Noofa ki naitwe, Iwe Omwana wa Ruhanga? Oizire kutuburabuza, obunaku bwaitu butakahikire? <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Aho hakaba hariho omukumbi gw'empunu nyingi hangahari nizirya. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Baadaimoni baamweshengyereza bati: Ku oraabe ori ow'okutubinga, twohereze omu mpunu. <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yaabagira ati: Nimwirooko! Baarugamu, baataaha omu mpunu; ahonaaho empunu ezo zoona zaarigita, nizishuuma aha ibanga, zaahwera omu nyanja. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Abariisa baazo bairuka, baataaha omuri tauni, baabagambira byona, n'ebyaba aha bantu abaabaire bariho baadaimoni. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ab'omuri tauni boona baahwayo, baija kubugana Yesu; kubaamureebire, baamweshengyereza kubarugira omu nsi.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu okukiza ozingazingirwe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:1-8: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:17-26">Luk 5:17-26</ref>; <ref loc="MRK 2:1-12">Mak 2:1-12</ref>. </char>
    </note> Yaagaruka omu bwato, yaayambuka, yaataaha omuri tauni y'owaabo. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Baamureetera omuntu ozingazingirwe, abyami omu ngozi. Yesu ku yaareebire okwikiriza kwabo, yaagambira ozingazingirwe ati: Mwana wangye, huumura; ebibi byawe byakusaasirwa. <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Abamwe aha bahandiiki baayetomboita bonka, ngu: Omuntu ogu naarogota. <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" /><note caller="-" style="x"><char style="xo" closed="false">9:4: </char><char style="xt" closed="false"><ref loc="JHN 2:25">Yoh 2:25</ref>. </char></note> Yesu ku yaamanyire ebiteekateeko byabo, yaababuuza ati: N'enki ekirikubateekateekyesa kubi omu mitima yaanyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ekirikurahuka nikiiha, okugira nti, Ebibi byawe byakusaasirwa, nari nti, Imuka, ogyende? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Kwonka mumanye ngu Omwana w'omuntu aine obushoboorozi omu nsi okusaasira ebibi, yaagambira ozingazingirwe ati: Imuka, oyekorere engozi yaawe, otaahe. <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Yaimuka, yaataaha. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Kandi abantu boona, ku baakireebire, baatiina, baahimbisa Ruhanga owaahaire abantu obushoboorozi oburikwingana butyo.<verse eid="MAT 9:8" /></para>
  <para style="s1">Okweta Matayo</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:9-13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:27-32">Luk 5:27-32</ref>; <ref loc="MRK 2:13-17">Mak 2:13-17</ref>. </char>
    </note> Yesu ku yaabaire naarugayo, yaareeba omuntu orikwetwa Matayo ashutami omu ihoorezo, yaamugambira ati: Nkuratira. Yaimuka, yaamukuratira. <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" />Bwanyima ku yaabaire ashutami omu nju naarya, reeba abahooza n'abasiisi baingi baija, baashutama na Yesu n'abeegi be. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Abafarisaayo, ku baakireebire, baabuuza abeegi be bati: Ahabw'enki omwegyesa waanyu naarya, kandi naanywa n'abahooza n'abasiisi? <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Yesu ku yaakihuriire, yaagira ati: Abahuriire tibeetenga mufumu, kureka abarwaire. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><note caller="-" style="x"><char style="xo" closed="false">9:13: </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6:6</ref>; <ref loc="1SA 15:22">1 Sam 15:22</ref>. </char></note> Mbwenu mugyende mwegye amakuru g'ekigambo eki ngu, Eki ndikwenda n'embabazi, ti bitambo; ahabw'okuba tindaizire kweta bahikiriire, kureka abasiisi.<verse eid="MAT 9:13" /></para>
  <para style="s1">Eby'okwesiibyakwo</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:14-17: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 2:18-22">Mak 2:18-22</ref>; <ref loc="LUK 5:33-38">Luk 5:33-38</ref>. </char>
    </note> Kandi akaizirwa abeegi ba Yohaana, baamubuuza bati: Ahabw'enki itwe n'Abafarisaayo kaingi twesiibyakwo, haza abeegi baawe bo bateesiibyakwo? <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" /><note caller="-" style="x"><char style="xo" closed="false">9:15: </char><char style="xt" closed="false"><ref loc="JHN 3:29">Yoh 3:29</ref>. </char></note> Yesu yaabagarukamu ati: Abakwe nibabaasa bata kuganya bakiine kishwera? Obunaku buryahika, obu kishwera aribaihwaho; obwo nibwo baryesiibyakwo. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Tihariho muntu oteera ekiremu ky'omwenda musya aha mwenda omukuru; ahabw'okuba ekyo ekyabaziirwaho kikaataagura ekijwaro, n'ekifumuka kihanguha. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Kandi tibashuka viinyo y'omutahe omu furebe z'empu ezikuzire; ku baakukora batyo, efurebe zikaabaruka, viinyo eyatika, n'efurebe zikaabaruka, viinyo eyatika, n'efurebe zisiisikara. Kureka viinyo y'omutahe eshukwa omu furebe ensya, byona bibona kurama.<verse eid="MAT 9:17" /></para>
  <para style="s1">Okuzoora muhara wa Yairo</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:18-26: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:41-56">Luk 8:41-56</ref>; <ref loc="MRK 5:22-43">Mak 5:22-43</ref>. </char>
    </note> Ku yaabaire naakibagambira ebigambo ebyo, haija omukungu, yaamukwata amaguru, yaamweshengyereza ati: Muhara wangye yaakaba; mbwenu oije, omuteho engaro, naija kuhimbuuka. <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu yaimuka, yaamukuratira n'abeegi be.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Kandi hakaba hariho omukazi, omazire emyaka ikumi n'ebiri arwaire ekyejwiso; yaija enyima ya Yesu, yaakora aha mukugiro gw'ekijwaro kye, <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" /><note caller="-" style="x"><char style="xo" closed="false">9:21: </char><char style="xt" closed="false"><ref loc="MAT 14:36">Mat 14:36</ref>. </char></note> ahabw'okuba akahamya omu mutima gwe ati: N'obu naakukora aha kijwaro kye kwonka, nkaakira. <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Yesu yaahinduka, yaamureeba, yaamugira ati: Mwana wangye, huumura; okwikiriza kwawe nikwo kwakutambira. Ahonaaho omukazi yaakira. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />Yesu ku yaahikire aha nju y'ogwo mukungu, yaareeba abarikuteera esheegu n'abandi baingi nibacura. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" /><note caller="-" style="x"><char style="xo" closed="false">9:24: </char><char style="xt" closed="false"><ref loc="JHN 11:11">Yoh 11:11</ref>, <ref loc="JHN 11:25">25</ref>. </char></note> Yaabagira ati: Murugyeho! Omwishiki tafiire, agwejegyeire. Baamushekyerera munonga. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Abantu ku baaherize kushohozibwa, yaataaha omu nju, yaakwata ogwo mwishiki omukono, yaimuka. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Egyo nkuru yaabuga omu ishaza eryo ryona.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu okuhumuura empumi n'okukiza abarwaire</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Kandi Yesu ku yaabaire naarugayo, empumi ibiri zaamukuratira nizimuyombererera ziti: Iwe Omwana wa Daudi, otugirire embabazi. <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Ku yaahikire omu nju, ezo mpumi zaamwirira haihi; Yesu yaazibuuza ati: Nimwikiriza ngu ekyo ninkibaasa? Zaamugarukamu ziti: Eego, Mukama waitu. <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Atyo yaazikora aha maisho, naagira ati: kibe nk'oku mwaikiriza. <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Amaisho gaabo gaahumuuka. Yesu yaabeehanangiriza munonga, naagira ati: Mwerinde, hatagira owaakimanya. <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Kwonka bo ku baarugire aho, baamurangaana omu ishaza eryo ryona.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Ku baabaire nibarugayo, baamureetera ekiteta kiriho daimoni. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu ku yaaherize kubinga daimoni ogwo, ekiteta kyagamba; abantu baatangaara nibagira bati: Tihariho kirikushusha nk'eki ekirareebirwe omuri Israeli. <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" /><note caller="-" style="x"><char style="xo" closed="false">9:34: </char><char style="xt" closed="false"><ref loc="MAT 12:24">Mat 12:24</ref>. </char></note> Kwonka Abafarisaayo baagira bati: Baadaimoni naababingisa amaani ga mukama waabo.<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu yaagyendagyenda omuri tauni zoona n'omu birorero byona naayegyesa omuri sinagogi, zaabo, naagamba engiri y'obukama bw'omu iguru, kandi naakiza endwara zoona n'obumuga bwona. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" /><note caller="-" style="x"><char style="xo" closed="false">9:36: </char><char style="xt" closed="false"><ref loc="EZK 34:5">Ezk 34:5</ref>. </char></note> Ku yaareebire emitwe y'abantu, yaabagirira esaasi, ahakuba bakaba baburaburiirwe, bashobeirwe nk'entaama ezitaine muriisa. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" /><note caller="-" style="x"><char style="xo" closed="false">9:37: </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luk 10:2</ref>. </char></note> Nikwo kugira abeegi be ati: Eby'okugyesha ni bingi munonga, kwonka abagyesi ni bakye; <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />n'ahabw'ekyo mushabe Mukama w'eigyesha ayohereze abagyesi omu by'okugyesha bye.<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Amaziina g'abeegi ikumi na babiri</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:1-15: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:1-5">Luk 9:1-5</ref>; <ref loc="MRK 6:7-13">Mak 6:7-13</ref>. </char>
    </note> Yaayeta abeegi be ikumi na babiri, yaabaha obushoboorozi bw'okubinga baadaimoni, n'okukiza endwara zoona n'obumuga bwona. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" /><note caller="-" style="x"><char style="xo" closed="false">10:2: </char><char style="xt" closed="false"><ref loc="JHN 1:40">Yoh 1:40</ref>, <ref loc="JHN 1:49">49</ref>. </char></note> Amaziina g'abeegi ikumi na babiri nigo aga: ow'okubanza ni Simooni orikwetwa Petero, na Anderea omurumuna; na Yakobo mwene Zebedaayo, na Yohaana omurumuna; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipo na Batolomaayo; Tomasi na Matayo omuhooza; Yakobo mwene Alufaayo na Tadaayo, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simooni Omukananaayo na Yuda Iskaryota owaamureebize.<verse eid="MAT 10:4" /></para>
  <para style="s1">Yesu okutuma abeegi be</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Abo ikumi na babiri Yesu akabatuma, yaabaragiira ati: Mutariza omu banyamahanga n'obu kwakuba okutaaha omuri tauni yoona ey'Abasamaria; <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" /><note caller="-" style="x"><char style="xo" closed="false">10:6: </char><char style="xt" closed="false"><ref loc="ACT 13:46">Byak 13:46</ref>; <ref loc="JER 50:6">Yer 50:6</ref>. </char></note> kureka mugyende omu ntaama ezaabuzire ez'omu ruganda rw'Abaisraeli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Omu kugyenda mugyende nimugamba muti: obukama bw'omu iguru bwiriire haihi. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" /><note caller="-" style="x"><char style="xo" closed="false">10:8: </char><char style="xt" closed="false"><ref loc="ACT 20:33">Byak 20:33</ref>. </char></note> Mukize abarwaire, muzoore abafiire, mushemeze ababembe, mubingye baadaimoni. Mukaheerwa busha, naimwe muheere busha. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Mutaritwara ezaabu nari efeeza nari emiringa omu nshaho zaanyu; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="-" style="x"><char style="xo" closed="false">10:10: </char><char style="xt" closed="false"><ref loc="LUK 10:4">Luk 10:4</ref>; <ref loc="1TI 5:18">1 Tim 5:18</ref>. </char></note> omurugyendo rwanyu mutaritwara efurebe, nari amakanzu abiri, nari enkaito, n'obu yaakuba enkoni; ahabw'okuba omukozi ashemereire kuheebwa eby'okumutunga. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Tauni yoona nari ekirorero kyona, omu muritaaha, mubanze musherure omuntu waamwo oshemereire, mube niwe mwaraarira okuhitsya obu murirugayo. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Ku muriba nimukitaaha omu nju egyo, mugiramutsye. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Enju ku eribashemerera, etungye obusingye bwanyu; ku eriba etabashemereire, obusingye bwanyu bubagarukire. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="-" style="x"><char style="xo" closed="false">10:14: </char><char style="xt" closed="false"><ref loc="ACT 13:51">Byak 13:51</ref>; <ref loc="ACT 18:6">18:6</ref>. </char></note> Omuntu weena ku aryanga kubakunira nari okuhurira ebigambo byanyu, ku muriba nimuruga omu nju egyo nari omu tauni egyo, mukunkumure omucuucu gw'omu bigyere byanyu. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Nimbagambira amazima nti; Aha kiro ky'okucwa orubanja, ekifubiro ky'ensi ya Sodoma na Gomora kiryaba ekirikubaasa kwemerwa okukira ekya tauni egyo.<verse eid="MAT 10:15" /></para>
  <para style="s1">Okuhiigwa kw'abeegi be</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:12">Yoh 10:12</ref>; <ref loc="ACT 20:29">Byak 20:29</ref>; <ref loc="EPH 5:15">Efe 5:15</ref>. </char>
    </note> Reeba, nimbatuma nk'orikutuma entaama omu mishega; n'ahabw'ekyo mugire obwengye nk'enjoka, kandi mube nk'enkombe ezitaine buryarya. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><note caller="-" style="x"><char style="xo" closed="false">10:17-22: </char><char style="xt" closed="false"><ref loc="LUK 21:12-17">Luk 21:12-17</ref>; <ref loc="MRK 13:9-13">Mak 13:9-13</ref>. </char></note> Mwerinde abantu, ahabw'okuba baryabatwara omu mashengyero, baryabateerera omuri sinagogi, <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" /><note caller="-" style="x"><char style="xo" closed="false">10:18: </char><char style="xt" closed="false"><ref loc="ACT 25:23">Byak 25:23</ref>; <ref loc="ACT 27:24">27:24</ref>. </char></note> kandi baryabatwara omu maisho g'abategyeki n'abagabe nibabantura, ahabw'okuba baakareebi b'okumpamya omu maisho gaabo n'ag'abanyamahanga. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Ku baribatwarayo, mutaryemereza emitima oku murigamba nari aha bi murigamba; ahakuba ebi murigamba, muryabiheebwa omu mwanya ogwo; <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />mumanye ngu tiimwe murigamba, kureka Omwoyo wa Shoimwe niwe aribagambisa. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" /><note caller="-" style="x"><char style="xo" closed="false">10:21: </char><char style="xt" closed="false"><ref loc="MIC 7:6">Mik 7:6</ref>. </char></note> Mukuru w'omuntu aryahayo omurumuna kwitwa, na ishe w'omwana aryahayo omwana we; abaana baryagomera abazaire baabo babaitise; <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><note caller="-" style="x"><char style="xo" closed="false">10:22: </char><char style="xt" closed="false"><ref loc="JHN 15:21">Yoh 15:21</ref>. </char></note> kandi muryayangwa abantu boona nibabatura eiziina ryangye. Kwonka origumisiriza okuhitsya aha muheru, niwe arijunwa. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ku baribahiiga omuri tauni emwe, muhungire omu ndiijo; buzimazima nimbagambira nti: Timuribuga tauni za Israeli zoona, Omwana w'omuntu atakaizire.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:24: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:16">Yoh 13:16</ref>. </char>
    </note> Omwegi takira mwegyesa we; kandi omuhuuku takira mukama we; <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />ekyakubaire gye aha mwegi n'okuba nk'omwegyesa we n'omuhuuku akaba nka mukama we. Ku baraabe beetsire nyineeka <note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="fk" closed="false">Belezebuli: </char><char style="ft" closed="false">n'eiziina ry'orikwetwa “Omutegyeki w'ensi egi,” niwe Sitaane. </char></note>Belezebuli, kaashwa ab'omu ka ye. <verse eid="MAT 10:25" /><verse number="26" style="v" sid="MAT 10:26" /><note caller="-" style="x"><char style="xo" closed="false">10:26-33: </char><char style="xt" closed="false"><ref loc="LUK 12:2-9">Luk 12:2-9</ref>. </char></note> N'ahabw'ekyo mutaribatiina; ahabw'okuba tihariho ekyashwekirwe ekitarishuuruurwa, n'obu kyakuba ekyasherekirwe ekitarimanywa.<note caller="-" style="x"><char style="xo" closed="false">10:26: </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mak 4:22</ref>. </char></note> <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Eki mbagambirira omu mwirima, mugume mukigambire omu mushana; eki murihurira kigambiirwe omu kutu, mukigambire aha mutwe gw'enju. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kandi mutaritiina abarikwita omubiri, kwonka tibarikubaasa kwita magara; kureka mutiine Orikubaasa kuhwerekyereza byombi, amagara n'omubiri, omuri Gehena.<verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />Ebiteera-nkumba bibiri tibigura senti emwe? Kwonka tihariho na kimwe ekigwa ahansi Shoimwe atakimanyire. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Nangwa n'eishokye ery'aha mitwe yaanyu ribazirwe ryona. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" /><note caller="-" style="x"><char style="xo" closed="false">10:31: </char><char style="xt" closed="false"><ref loc="MAT 12:12">Mat 12:12</ref>. </char></note> N'ahabw'ekyo mutaritiina; ahabw'okuba nimukira ebiteera-nkumba bingi. <verse eid="MAT 10:31" /><verse number="32" style="v" sid="MAT 10:32" />Kandi buri muntu orimpamya omu maisho g'abantu, naanye ndyamuhamya omu maisho ga Tata ori omu iguru. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="-" style="x"><char style="xo" closed="false">10:33: </char><char style="xt" closed="false"><ref loc="LUK 9:26">Luk 9:26</ref>. </char></note> Kwonka weena oriinyehakana omu maisho g'abantu, naanye ndyamwehakana omu maisho ga Tata ori omu iguru.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:34-36: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:51-53">Luk 12:51-53</ref>. </char>
    </note> Mutateekateeka ngu nkaija kureeta obusingye omu nsi; tindaizire kureeta busingye, kureka rurara. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Ahabw'okuba nkaija kutaanisa omwojo na ishe, omwishiki na nyina, omukazi na nyinazaara; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />abazigu b'omuntu baryaba ab'omu ka ye. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" /><note caller="-" style="x"><char style="xo" closed="false">10:37: </char><char style="xt" closed="false"><ref loc="LUK 14:26">Luk 14:26</ref>, <ref loc="LUK 14:27">27</ref>. </char></note> Orikukunda ishe nari nyina okubankiza, tashemereire kuba owangye; kandi orikukunda omutabani nari muhara we okubankiza, tashemereire kuba owangye. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><note caller="-" style="x"><char style="xo" closed="false">10:38: </char><char style="xt" closed="false"><ref loc="MAT 16:24">Mat 16:24</ref>, <ref loc="MAT 16:25">25</ref>. </char></note> Kandi oteekorera musharaba gwe, akankuratira, tashemereire kuba owangye. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><note caller="-" style="x"><char style="xo" closed="false">10:39: </char><char style="xt" closed="false"><ref loc="JHN 12:25">Yoh 12:25</ref>. </char></note> Orikukiza amagara ge, aryagabuza; kandi orikubuza amagara ge ahabwangye, aryagakiza.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:40: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:20">Yoh 13:20</ref>. </char>
    </note> Orikubaikiriza, biri aikiriize nyowe; n'orikwikiriza nyowe, biri aikiriize Owantumire. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Orikwikiriza nabi ahabw'okuba nabi, aryatunga ebihembo bya nabi; kandi orikwikiriza ohikiriire ahabw'okuba ohikiriire, aryatunga ebihembo by'ohikiriire. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" /><note caller="-" style="x"><char style="xo" closed="false">10:42: </char><char style="xt" closed="false"><ref loc="MAT 25:40">Mat 25:40</ref>. </char></note> Kandi orikunywaisa omwe ahari aba bato enkyeka y'amaizi agarikufuka ahabw'okuba omwegi wangye, nimbagambira amazima nti: Taribura bihembo bye.<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yesu okuhamya Yohaana omubatizi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Bwanyima Yesu ku yaaherize kwegyesa abeegi ikumi na babiri, yaarugayo, yaaza kwegyesa n'okubuurira omuri tauni zaabo. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" /><note caller="-" style="x"><char style="xo" closed="false">11:2-19: </char><char style="xt" closed="false"><ref loc="LUK 7:18-35">Luk 7:18-35</ref>. </char></note> Kwonka Yohaana ku yaabaire ari omu kihome, yaahurira ebi Yesu arikukora, yaamutumaho abeegi be kumubuuza,<note caller="-" style="x"><char style="xo" closed="false">11:2: </char><char style="xt" closed="false"><ref loc="MAT 14:3">Mat 14:3</ref>. </char></note> <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ati: Niiwe ogwo orikwenda kwija, nari tutegyereze ondiijo? <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu yaabagarukamu ati: Mugarukyeyo mugambire Yohaana ebi mwahurira, n'ebi mwareeba; <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" /><note caller="-" style="x"><char style="xo" closed="false">11:5: </char><char style="xt" closed="false"><ref loc="ISA 35:5">Isa 35:5</ref>, <ref loc="ISA 35:6">6</ref>; <ref loc="ISA 61:1">61:1</ref>. </char></note> empumi zihumwirwe, ebirema nibigyenda, ababembe bashemeziibwe, ebifa-matu nibihurira, abafiire bazoirwe, n'abooro bagambiirwe ebigambo birungi. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" /><note caller="-" style="x"><char style="xo" closed="false">11:6: </char><char style="xt" closed="false"><ref loc="MAT 13:57">Mat 13:57</ref>; <ref loc="MAT 26:31">26:31</ref>. </char></note> Kandi otarikumbanganisaho aine omugisha.<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Ku baagyenzire, Yesu yaatandika kugambira emitwe y'abantu aha bya Yohaana, naagira ati: Omu ihamba mukaza kureebayo ki? Orubingo orurikutengyetsibwa omuyaga? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Beitu mukaza kureeba ki? Omuntu ojwaire emyenda erikuterera? Manya abajwara ebirikuterera baba omu bikaari by'abagabe. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" /><note caller="-" style="x"><char style="xo" closed="false">11:9: </char><char style="xt" closed="false"><ref loc="LUK 1:76">Luk 1:76</ref>. </char></note> Beitu mukatwarwayo ki? Okureeba nabi? Eego, nimbagambira nti: Buzima naakirira kimwe nabi. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><note caller="-" style="x"><char style="xo" closed="false">11:10: </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref>. </char></note> Kandi ogwo niwe owaahandiikirweho ngu,</para>
  <para style="q1" vid="MAT 11:10">Reeba, nintuma entumwa yangye, ekubandize;</para>
  <para style="q1" vid="MAT 11:10">niyo erishemeza omuhanda gwawe.<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Buzimazima nimbagambira nti: Omuri boona abaazairwe abakazi tihakabahoga n'omwe orikukira Yohaana Omubatizi obukuru; kwonka omuto omu bukama bw'omu iguru naamukira. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><note caller="-" style="x"><char style="xo" closed="false">11:12: </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luk 16:16</ref>. </char></note> Okuruga omu biro bya Yohaana Omubatizi okuhitya hati, obukama bwa Ruhanga nibutwaranirwa, n'abarikubutwaranira babutaahamu n'amaani. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ahakuba baanabi boona n'ebiragiro bikaba nibiranga okuhitsya omu biro bya Yohaana; <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><note caller="-" style="x"><char style="xo" closed="false">11:14: </char><char style="xt" closed="false"><ref loc="MAT 17:10-13">Mat 17:10-13</ref>. </char></note> kandi ku muraabe nimukunda kukiikiriza, niwe Eliya owaarangirwe ku ariija. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Oine amatu agarikuhurira, ahurire.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />Mbwenu ab'ebiro ebi mbashushanise ki? Nibashusha nk'abaana bato abashutami omu katare, bakeeta bagyenzi baabo bati: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />Tubateereire emikuri, timwazina; twacura timwaganya. <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Ahakuba Yohaana akaija atarikurya n'obu kwakuba okunywa, baagira ngu, Ariho daimoni. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" /><note caller="-" style="x"><char style="xo" closed="false">11:19: </char><char style="xt" closed="false"><ref loc="MAT 9:14">Mat 9:14</ref>, <ref loc="MAT 9:15">15</ref>. </char></note> Omwana w'omuntu we yaija naarya kandi naanywa, baagira ngu, Reeba omunyamururu, kandi omusinzi, munywani w'abahooza n'abasiisi. Kwonka shi obwengye busiimirwa aha mirimo yabwo.<verse eid="MAT 11:19" /></para>
  <para style="s1">Yesu okuhana Koraziini na Besesaida</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:20-24: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:12-15">Luk 10:12-15</ref>. </char>
    </note> Yaatandikira aho kuhana tauni ahu yaakoreire eby'okutangaaza ebirikukira obwingi, ahabw'okuba bakanga kweteisa. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />Ati: Iwe Koraziini, oryakareeba! Naiwe, Besesaida, oryakareeba, ahabw'okuba eby'okutangaaza ebyakoreirwe omuriimwe, kuri noogira ngu bikakorerwa Tuuro na Sidoni, bakaabaire beeteisize kare, bajwaire ebiguniya, beeshukyeire eiju rya kashenda. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Kandi nimbagambira nti: Aha kito ky'okucwa orubanja, ekifubiro ky'okucwa orubanja, ekifubiro kya Tuuro na Sidoni kiryaba ekirikubaasa kwemerwa okukira ekyanyu. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" /><note caller="-" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="MAT 4:13">Mat 4:13</ref>; <ref loc="MAT 8:5">8:5</ref>; <ref loc="MAT 9:1">9:1</ref>. </char></note> Naiwe Kaperenaumu, nooyeraata ngu oryakuzibwa ohikye omu iguru? Ngabusha, oryagarurwa ahansi ohikye okuzimu. Ahabw'okuba eby'okutangaaza ebyakoreirwe omuriiwe, kuri noogira ngu bikakorerwa Sodoma, ekaabaire ekiriho n'okuhitsya hati. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Hoona nimbagambira nti: Aha kiro ky'okucwa orubanja, ekifubiro kya Sodoma kiryaba ekirikubaasa kwemerwa okukira ekyanyu.<verse eid="MAT 11:24" /></para>
  <para style="s1">Yesu okweta abaruhire n'abaremerairwe</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:25-27: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:21">Luk 10:21</ref>, <ref loc="LUK 10:22">22</ref>. </char>
    </note> Omu biro ebyo Yesu akagira ati: Taata, Mukama w'eiguru n'ensi, ninkusiima ahabw'okuba okashereka ebigambo ebi abanyabwengye n'abarikwetegyereza, waabishuuruurira abaana bato.<note caller="-" style="x"><char style="xo" closed="false">11:25: </char><char style="xt" closed="false"><ref loc="1CO 1:26-29">1 Kor 1:26-29</ref>. </char></note> <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Eego, Taata, ahabw'okuba ekyo nikyo waasiimire. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" /><note caller="-" style="x"><char style="xo" closed="false">11:27: </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yoh 3:35</ref>; <ref loc="PHP 2:9">Fil 2:9</ref>. </char></note> Ebintu byona nkabiheebwa Tata, kandi tihariho omanya Omwana wa Ruhanga kureka Ishe, kandi tihariho omanya Ishe, kureka Omwana we n'omuntu weena ou Omwana aikiriza kumushuuruurira. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" /><note caller="-" style="x"><char style="xo" closed="false">11:28: </char><char style="xt" closed="false"><ref loc="JER 31:25">Yer 31:25</ref>. </char></note> Imwe mwena abaruhire n'abaremereirwe, mwije ahariinye, mbaruhuure. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Mwekorere omugamba gwangye, muunyegyereho; ahabw'okuba nintwaza gye, kandi ndi omucureezi omu mutima; naimwe muryatunga okuhuumura omu mitima yaanyu, <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ahakuba omugamba gwangye tigurikuremeera, n'omutwaro gwangye gwanguhi.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s1">Ebya Sabato</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1-8: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:1-5">Luk 6:1-5</ref>; <ref loc="MRK 2:23-28">Mak 2:23-28</ref>. </char>
    </note> Omu biro ebyo Yesu akaba naaraba omu misiri y'oburo aha izooba rya Sabato; abeegi be baagira enjara, baatandika kucwa obushiisha bw'oburo n'okubukina.<note caller="-" style="x"><char style="xo" closed="false">12:1: </char><char style="xt" closed="false"><ref loc="DEU 23:25">Bir 23:25</ref>. </char></note> <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Abafarisaayo ku baakireebire, baamugira bati: Reeba, abeegi baawe nibakora ekirikuzira, okucwa obushiisha ahari Sabato. <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" /><note caller="-" style="x"><char style="xo" closed="false">12:3: </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam 21:1-6</ref>. </char></note> Nawe yaababuuza ati: Beitu shi timukashomaga eki Daudi yaakozire, obu yaagira enjara n'abu yaabaire aine; <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" /><note caller="-" style="x"><char style="xo" closed="false">12:4: </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lev 24:9</ref>. </char></note> ku yaataahire omu nju ya Ruhanga, akarya aha migaati ey'okumurikwa, ei Ebiragiro byabaire bitarikwikiriza ku aryaho, n'abu yaabaire aine, kureka abanyamurwa bonka? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Nari shi timukashomaga omu Biragiro abanyamurwa omuri hekalu oku baabaire bashobya Sabato, haza batagire rubanja? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Kwonka nyowe nimbagambira nti: Orikukira hekalu ari aha. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="-" style="x"><char style="xo" closed="false">12:7: </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat 9:13</ref>; <ref loc="HOS 6:6">Hos 6:6</ref>. </char></note> Kuri nimumanya ekigambo eki ngu, Eki ndikwenda n'embabazi, ti bitambo, timwakusingisiriize bataine rubanja. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ahakuba Omwana w'omuntu niwe Mukama wa Sabato.<verse eid="MAT 12:8" /></para>
  <para style="s1">Yesu okukiza omuntu okokootsire omukono</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:9-14: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:6-11">Luk 6:6-11</ref>; <ref loc="MRK 3:1-6">Mak 3:1-6</ref>. </char>
    </note> Yaarugayo, yaataaha omuri sinagogi yaabo; <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />yaashangamu omushaija okokootsire omukono. Baamubuuza bati: Ebiragiro nibiikiriza okutambira omuntu ahari Sabato? Bakamubuuza batyo ngu babone kumutabaariza. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Yaabagarukamu ati: N'oha omuriimwe owaakuba aine entaama ye emwe, ekagwa omu kiina aha izooba rya Sabato, atagikwate akagiihamu? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" /><note caller="-" style="x"><char style="xo" closed="false">12:12: </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luk 14:5</ref>. </char></note> Mbwenu shi omuntu tarikukirira kimwe entaama? N'ahabw'ekyo Ebiragiro nibiikiriza okukora gye ahari Sabato. <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Ahonaaho yaaragiira omushaija ogwo ati: Nanuura omukono gwawe. Yaagunanuura, gwakira, gwaba nk'ogundi. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" /><note caller="-" style="x"><char style="xo" closed="false">12:14: </char><char style="xt" closed="false"><ref loc="JHN 5:16">Yoh 5:16</ref>. </char></note> Abafarisaayo baashohora, baaza omu naama, baahanuura oku baraamwite. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />Yesu ku yaabimanyire, yaarugayo. Abantu baingi baamukuratira, yaabakiza boona, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />yaabeehanangiriza ngu, batamurangaana. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" /><note caller="-" style="x"><char style="xo" closed="false">12:17: </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isa 42:1-4</ref>; <ref loc="ISA 41:9">41:9</ref>. </char></note> Ekyo kikabaho ngu ebi Isaaya yaagambire bihikiirire ebi yaagizire ati:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />Reeba omuheereza wangye ou nkunda, ou naatooraine,</para>
  <para style="q1" vid="MAT 12:18">Omutima gwangye ou gushemerererwa;</para>
  <para style="q1" vid="MAT 12:18">Ndyamutaho Omwoyo wangye</para>
  <para style="q1" vid="MAT 12:18">Agambire abanyamahanga eby'oburyo.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Taritongana, tariyomba,</para>
  <para style="q1" vid="MAT 12:19">Nangwa tihariho n'orihurira eiraka rye omu mihanda.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Orubingo orushatukire tariruhenda,</para>
  <para style="q1" vid="MAT 12:20">Kandi n'orumuri orurikwaka kubi tariruraaza,</para>
  <para style="q1" vid="MAT 12:20">Okuhitsya obu arisingura ahabw'okuhikiirira kwe.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Kandi abanyamahanga baryagira amatsiko aha iziina rye.<verse eid="MAT 12:21" /></para>
  <para style="s1">Ekibi ky'okujuma Omwoyo Orikwera</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:22-45: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:14-26">Luk 11:14-26</ref>, <ref loc="LUK 11:29-32">29-32</ref>; <ref loc="MRK 3:22-30">Mak 3:22-30</ref>. </char>
    </note> Kandi baamureetera empumi eyaabaire eri ekiteta, eriho daimoni, yaagikiza; owaabaire ari ekiteta yaagamba, kandi yaahumuuka. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Abantu boona baatangaara, baayebuuza nibagira bati: Beitu ogu takaaba Omwana wa Daudi? <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" /><note caller="-" style="x"><char style="xo" closed="false">12:24: </char><char style="xt" closed="false"><ref loc="MAT 9:34">Mat 9:34</ref>. </char></note> Kwonka Abafarisaayo ku baakihuriire, baagira bati: omuntu ogu taine kindi ki arikubingisa baadaimoni kureka Belezebuli omukama wa baadaimoni. <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Yesu ku yaamanyire ebiteekateeko byabo, yaabagambira ati: Obugabe bwona ku bwebaganisamu, buhwerekyerezibwa; n'orurembo rwona nari enju yoona, ku byebaganisamu, tibigumaho. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Na Sitaane ku araabe naabinga Sitaane, biri ayebaganiisemu. Obukama bwe buryagumaho buta? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Nyowe, ku ndaabe nimbingisa baadaimoni Belezebuli, abaana baanyu bo nibamubingisa oha? N'ahabw'ekyo abo nibo baribasingisa orubanja. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Kwonka ku ndaabe nimbingisa baadaimoni Omwoyo wa Ruhanga, mumanye ngu obukama bwa Ruhanga bubahikireho. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" /><note caller="-" style="x"><char style="xo" closed="false">12:29: </char><char style="xt" closed="false"><ref loc="ISA 49:24">Isa 49:24</ref>. </char></note> Omuntu naabaasa ata kutaaha omu nju y'ondiijo ow'amaani okunyaga ebintu bye, atabandize kukoma ogwo ow'amaani? Bwanyima akabona kunyaga gye eby'omu nju ye.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:30: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">Mak 9:40</ref>. </char>
    </note> Ou tutakwatanisa, n'omuzigu wangye; kandi otataaruura hamwe naanye, ataataanisa. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" /><note caller="-" style="x"><char style="xo" closed="false">12:31: </char><char style="xt" closed="false"><ref loc="HEB 6:4">Heb 6:4</ref>, <ref loc="HEB 6:6">6</ref>; <ref loc="1JN 5:16">1 Yoh 5:16</ref>. </char></note> Nikyo ndikubagambirira nti: Abantu baryasaasirwa ekibi kyona n'okurogota kwona, kwonka okurogota aha Mwoyo Orikwera n'ekibi ekitarisaasirwa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="-" style="x"><char style="xo" closed="false">12:32: </char><char style="xt" closed="false"><ref loc="1TI 1:13">1 Tim 1:13</ref>. </char></note> Omuntu weena orirogota aha Mwana w'omuntu, aryasaasirwa; kwonka orirogota aha Mwoyo Orikwera tarisaasirwa mu busingye obu, n'obu bwakuba oburiija. <verse eid="MAT 12:32" /><verse number="33" style="v" sid="MAT 12:33" /><note caller="-" style="x"><char style="xo" closed="false">12:33: </char><char style="xt" closed="false"><ref loc="MAT 7:17">Mat 7:17</ref>. </char></note> Omuti ku muraagwete murungi, n'ebyana byagwo mubyete birungi; nari shi omuti ku muraagwete mubi, n'ebyana byagwo mubyete bibi; ahakuba omuti gumanyirwa aha byana byagwo. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Imwe baana b'enjoka 'mwe, nimubaasa muta kugamba ebigambo birungi, haza muri babi? Ebiijwire omutima, akanwa nibyo kagamba. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" /><note caller="-" style="x"><char style="xo" closed="false">12:35: </char><char style="xt" closed="false"><ref loc="LUK 6:45">Luk 6:45</ref>. </char></note> Omuntu murungi aiha ebirungi omu ibiikiro rye erirungi; n'omubi aiha ebibi omu ibiikiro rye eribi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Kandi nimbagambira nti: Ekigambo ekitaine buryo kyona eki abantu barigamba, baryakyetonganira aha kiro ky'okucwa orubanja. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Ebigambo byawe ebi ogamba nibyo birikwihisaho orubanja, nari shi nibyo birikusingisa orubanja.<verse eid="MAT 12:37" /></para>
  <para style="s1">Yesu okwima Abafarisaayo eky'okureeberaho</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:38: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">Mat 16:1</ref>. </char>
    </note> Bwanyima abamwe aha bahandiiki n'Abafarisaayo baamugarukamu bati: Mwegyesa, nitwenda kureeba akamanyiso akarikuruga ahariiwe. <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Nawe yaabagarukamu ati: Abantu b'obusingye obu obubi obw'obushambani nibenda akamanyiso; kwonka tibarikaheebwa kureka akamanyiso ka nabi Yona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" /><note caller="-" style="x"><char style="xo" closed="false">12:40: </char><char style="xt" closed="false"><ref loc="JON 2:1">Yon 2:1</ref>, <ref loc="JON 2:2">2</ref>. </char></note> Nk'oku Yona yaamazire amazooba ashatu n'ebiro byago omunda y'eky'enyanja ekihango, nikwo n'Omwana w'omuntu arimara ebiro bishatu nyomushana na nyekiro ari okuzimu. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" /><note caller="-" style="x"><char style="xo" closed="false">12:41: </char><char style="xt" closed="false"><ref loc="JON 3:5">Yon 3:5</ref>. </char></note> Abantu ba Nineeve baryayemerera n'ab'obusingye obu aha kiro ky'orubanja, barubasingise, ahabw'okuba ku baahuriire okubuurira kwa Yona, baayeteisa; kandi reeba, Orikukira Yona ari aha. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" /><note caller="-" style="x"><char style="xo" closed="false">12:42: </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Bag 10:1-10</ref>. </char></note> Omugabekazi w'eihanga ery'obukiizi-bwa-buryo aryayemerera n'ab'ebiro ebi aha kiro ky'orubanja arubasingise, ahabw'okuba akaruga aha muheru gw'ensi, yaija kuhurira obwengye bwa Sulemaani; kandi reeba, Orikukira Sulemaani ari aha.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Daimoni, ku aruga omu muntu, araba omu mpita ezitarimu maizi, naasherura oburuhuukiro, bumuburira. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Agira ati: Ka ngarukye omu nju yangye omu naarugire. Ku ahikayo, ashanga harimu busha, eyeyereire, eboneziibwe. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" /><note caller="-" style="x"><char style="xo" closed="false">12:45: </char><char style="xt" closed="false"><ref loc="2PE 2:20">2 Pet 2:20</ref>. </char></note> Atyo agyenda areeta abandi baadaimoni mushanju ababi okumukira, bataaha omwo, bagumamu; ebya bwanyima by'omuntu ogwo bikira eby'okubanza kuba bibi. Nikwo kiriba kityo n'aha b'obusingye obu obubi.<verse eid="MAT 12:45" /></para>
  <para style="s1">Yesu na beene waabo</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:46-50: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:19-21">Luk 8:19-21</ref>; <ref loc="MRK 3:31-35">Mak 3:31-35</ref>. </char>
    </note> Ku yaabaire naakigamba n'abantu, haija nyina n'abarumuna, baayemerera aheeru, nibenda kugamba nawe. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Omuntu yaamugambira ati: Reeba, nyoko n'abarumuna baawe beemereire aheeru, nibenda kugamba naiwe. <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" /><note caller="-" style="x"><char style="xo" closed="false">12:48: </char><char style="xt" closed="false"><ref loc="LUK 2:49">Luk 2:49</ref>. </char></note> Yaagarukamu owaamugambira, naamugira ati: Maawe n'oha, n'abarumuna bangye nibaahi? <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Yaagorora omukono naagworekyeza abeegi be, naagira ati: Reeba, maawe n'abarumuna bangye n'aba! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><note caller="-" style="x"><char style="xo" closed="false">12:50: </char><char style="xt" closed="false"><ref loc="ROM 8:29">Rom 8:29</ref>; <ref loc="JHN 15:14">Yoh 15:14</ref>. </char></note> Ahabw'okuba omuntu weena, okora ebi Tata ow'omu iguru akunda, niwe murumuna wangye, niwe munyaanyazi, niwe maawe.<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Enfumu y'omubibi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1-23: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:4-15">Luk 8:4-15</ref>; <ref loc="MRK 4:1-20">Mak 4:1-20</ref>. </char>
    </note> Aha izooba eryo Yesu yaashohora naaruga omu nju, yaashutama aha rubaju rw'enyanja. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Omutwe gw'abantu baingi baateeranira ah'ari; atyo yaaza omu bwato, yaabushutamamu; abantu abo boona baayemerera aha rubaju rw'enyanja. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yaabeegyesa bingi omu nfumu, naagira ati: Omubibi akashohora kubiba. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Ku yaabaire naabiba, embibo ezimwe zaagwa omu muhanda, enyonyi zaija, zaazitorotoora. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Embibo ezindi zaagwa aha rukiri, ahataine itaka ringi; ahonaaho zaamera; ahabw'eitaka kutaba ringi, <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />eizooba ku ryajwire, omushana gwaziteera, zaahonga; kandi ahabw'okutagira mizi, zaayoma. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Ezindi zaagwa omu mahwa; amahwa gaamera, gaazinyuruza. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ezindi zaagwa omu itaka rirungi; zaayera, ezimwe zaahitsya igana, ezindi makumi mukaaga, n'ezindi makumi ashatu. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Oine amatu, ahurire.<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Abeegi be baija ah'ari, baamubuuza bati: Ahabw'enki noobeegyesa omu nfumu? <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Yaabagarukamu ati: Imwe muhairwe okumanya emibonano y'obukama bw'omu iguru, kwonka bo tibahairwe. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="-" style="x"><char style="xo" closed="false">13:12: </char><char style="xt" closed="false"><ref loc="LUK 8:18">Luk 8:18</ref>; <ref loc="MRK 4:25">Mak 4:25</ref>. </char></note> Ahabw'okuba oine niwe ariheebwa, kandi aryayongyerwaho, agire ebingi; kwonka otaine, aryayakwa n'ekyo eki aine. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Eki ndikubeegyeseza omu nfumu nikyo eki: ahakuba okureeba tibareeba, kandi n'okuhurira tibahurira, n'obu kwakuba okwetegyereza. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" /><note caller="-" style="x"><char style="xo" closed="false">13:14: </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref>, <ref loc="ISA 6:10">10</ref>; <ref loc="ACT 28:26">Byak 28:26</ref>, <ref loc="ACT 28:27">27</ref>. </char></note> Ebi Isaaya yaaragwire bibahikireho, ebi yaagizire ati:</para>
  <para style="q1" vid="MAT 13:14">Okuhurira kwo muryahurira, kwonka timurishoborokyerwa;</para>
  <para style="q1" vid="MAT 13:14">Okureeba kwo muryareeba, kwonka timuryetegyereza;<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Ahakuba emitima y'abantu aba ehindukire ebitsire,</para>
  <para style="q1" vid="MAT 13:15">N'amatu gaabo nigahurira kubi,</para>
  <para style="q1" vid="MAT 13:15">N'amaisho gaabo bagahumiize,</para>
  <para style="q1" vid="MAT 13:15">Ngu batakaareebesa amaisho gaabo,</para>
  <para style="q1" vid="MAT 13:15">N'okuhuriza amatu gaabo,</para>
  <para style="q1" vid="MAT 13:15">N'okwetegyereza n'emitima yaabo,</para>
  <para style="q1" vid="MAT 13:15">Bakahinduka, nkabakiza.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Kwonka amaisho gaanyu gaine omugisha, ahabw'okuba nigareeba, n'amatu gaanyu, ahabw'okuba nigahurira. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kandi nimbagambira amazima nti: Baanabi baingi n'abantu abahikiriire baingi bakeetenga kureeba ebi murikureeba, tibaabireeba, n'okuhurira ebi murikuhurira, tibaabihurira.<verse eid="MAT 13:17" /></para>
  <para style="s1">Yesu okushoboorora enfumu y'omubibi</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Mbwenu nu, imwe muhurire enfumu y'omubibi. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Weena ohurira ekigambo ky'obukama, atakyetegyereze, Omubi aija, ashahura ekyabibwa omu mutima gwe; ebyo nibishoboorora amakuru g'embibo eyaagwire omu muhanda. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Eby'embibo ezaabibirwe aha rukiri, amakuru gaabyo n'omuntu ohurira ekigambo, akarahuka kukiikiriza ashemereirwe; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />kwonka we ahabwe ataine mizi, akeehangaana omwanya mukye; hakibaho obusaasi nari okuhiigwa naaturwa ekyo kigambo, ahonaaho bikamugwisa. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" /><note caller="-" style="x"><char style="xo" closed="false">13:22: </char><char style="xt" closed="false"><ref loc="1TI 6:9">1 Tim 6:9</ref>. </char></note> Eby'ezaabibirwe omu mahwa, amakuru gaabyo n'omuntu ohurira ekigambo; kwonka amaganya g'ensi n'okubeihwabeihwa obutungi bwayo bikanyuruza ekigambo, kikaremwa kwera. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Eby'ezaabibirwe omu itaka rirungi, ekigambo, akakimanya; buzima ogwo niwe ayana ebyana, omwe igana, ondiijo makumi mukaaga, n'ondiijo makumi ashatu.<verse eid="MAT 13:23" /></para>
  <para style="s1">Enfumu y'enkyenzi omu buro</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Kandi akabacwera endiijo nfumu, naabagira ati: Obukama bw'omu iguru nibushushanisibwa n'omuntu owaabibire embibo nungi omu musiri gwe; <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />kandi abantu ku baabaire bagwejegyeire, omuzigu we yaija, yaabiba enkyenzi omu <note caller="+" style="f"><char style="fr" closed="false">13:25 </char><char style="ft" closed="false">omu Rugriika n'engano. </char></note>buro, yaayegyendera. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Oburo ku bwamezire, bwaba obushiisha, enkyenzi nazo zaareebeka. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Abahuuku baija, baagambira mukama waabo bati: Mukama waitu, torabibire embibo nungi omu musiri gwawe? Mbwenu kandi enkyenzi zirugire hi? <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Yaabagarukamu ati: Ekyo kikakorwa omuzigu. Abahuuku baamubuuza bati: Mbwenu shi, nooyenda ngu tugyende tuzikuuremu? <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Yaabagira ati: Ngaaha! Obundi mukaaba nimukuuramu enkyenzi, mukuuriranamu oburo. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" /><note caller="-" style="x"><char style="xo" closed="false">13:30: </char><char style="xt" closed="false"><ref loc="MAT 3:12">Mat 3:12</ref>. </char></note> Murekye bikure byombi, bihikye omu igyesha; kandi omu igyesha ndyagambira abagyesi nti: Mubanze mutooranemu enkyenzi, muzibohe enganda zookibwe, reero oburo mubuhunikye omu bitara byangye.<verse eid="MAT 13:30" /></para>
  <para style="s1">Ezindi nfumu</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:31-32: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:18">Luk 13:18</ref>, <ref loc="LUK 13:19">19</ref>; <ref loc="MRK 4:30-32">Mak 4:30-32</ref>. </char>
    </note> Yaagaruka yaabacwera endiijo nfumu, naagira ati: Obukama bw'omu iguru nibushusha nk'akajuma ka <note caller="+" style="f"><char style="fr" closed="false">13:31 </char><char style="fk" closed="false">Sinaapi: </char><char style="ft" closed="false">n'akajuma kakye munonga, kwonka obundi ku kakura, karugamu ekishaka kihango. </char></note>sinaapi, aku omushaija yaatwaire, akakabiba omu musiri gwe; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" /><note caller="-" style="x"><char style="xo" closed="false">13:32: </char><char style="xt" closed="false"><ref loc="DAN 4:12">Dan 4:12</ref>, <ref loc="DAN 4:21">21</ref>; <ref loc="EZK 31:6">Ezk 31:6</ref>. </char></note> haza kari kakye okukira embibo zoona; kwonka ku kakuzire, kahanguha okukira ebishaka byona, kaahinduka omuti, enyonyi z'omu mwanya zaija zaayarika omu mataagi gaagwo.<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:33: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:20">Luk 13:20</ref>, <ref loc="LUK 13:21">21</ref>. </char>
    </note> Yaabacwera endiijo nfumu ati: Obukama bw'omu iguru nibushusha nk'ekitumbisa eki omukazi yaatwaire akashereka omu ncuro z'esaano ishatu okuhitsya obu yoona yaatumbisiibwe.<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Ebigambo ebyo byona Yesu akabyegyesa abantu omu nfumu; kandi tihariho ki yaabeegyeise kyona, atakirabize mu nfumu, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" /><note caller="-" style="x"><char style="xo" closed="false">13:35: </char><char style="xt" closed="false"><ref loc="PSA 78:2">Zab 78:2</ref>. </char></note> eki nabi yaagambire kihikiirire eki yaagizire ati:</para>
  <para style="q1" vid="MAT 13:35">Ndyayashamya akanwa kangye omu nfumu,</para>
  <para style="q1" vid="MAT 13:35">Ngambe ebigambo ebyasherekirwe okuruga aha kuhangwa kw'ensi.<verse eid="MAT 13:35" /></para>
  <para style="s1">Okushoboorora enfumu y'enkyenzi z'omu buro</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Bwanyima yaaraga emitwe y'abantu, yaataaha omu nju. Abeegi be baamwirira haihi, baamubuuza bati: Otushobororere amakuru g'enkyenzi z'omu musiri. <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Yaabagarukamu ati: Owaabibire embibo nungi n'Omwana w'omuntu; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />omusiri n'ensi; embibo enungi nibo baana b'obukama; enkyenzi n'abaana b'Omubi; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />omuzigu owaazibibire ni Sitaane; eigyesha niyo mperu y'obusingye obu; n'abagyesi ni baamaraika. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" /><note caller="-" style="x"><char style="xo" closed="false">13:40: </char><char style="xt" closed="false"><ref loc="JHN 15:6">Yoh 15:6</ref>. </char></note> Nk'oku enkyenzi zirundwa hamwe, zikookibwa n'omuriro, nikwo kiriba kityo aha mperu y'obusingye obu. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" /><note caller="-" style="x"><char style="xo" closed="false">13:41: </char><char style="xt" closed="false"><ref loc="ZEP 1:3">Zef 1:3</ref>. </char></note> Omwana w'omuntu aryatuma baamaraika be, nabo baryaiha omu bukama bwe byona ebirikuteeza abantu entsibo, n'enkozi z'ebibi, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" /><note caller="-" style="x"><char style="xo" closed="false">13:42: </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref>. </char></note> binagwe omu kikoomi ky'omuriro; omwo nimwo abantu bariririra, bakanena enshaya. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" /><note caller="-" style="x"><char style="xo" closed="false">13:43: </char><char style="xt" closed="false"><ref loc="DAN 12:3">Dan 12:3</ref>. </char></note> Obwo abahikiriire baryayengyengyeta nk'eizooba omu bukama bwa Ishebo. Oine amatu, ahurire.<verse eid="MAT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:44: </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:7">Fil 3:7</ref>; <ref loc="PRO 2:4">Enf 2:4</ref>. </char>
    </note> Obukama bw'omu iguru nibushusha nk'eky'obutungi ekyasherekirwe omu musiri; bwanyima omuntu ku yaakigwireho, nawe yaakishereka, yaagyenda, yaatunda ebi yaabaire aine byona ashemereirwe, yaija, yaagura omusiri ogwo.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Kandi obukama bw'omu iguru nibushusha nk'omushuubuzi orikusherura eruuru enungi; <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" /><note caller="-" style="x"><char style="xo" closed="false">13:46: </char><char style="xt" closed="false"><ref loc="PRO 8:10">Enf 8:10</ref>, <ref loc="PRO 8:11">11</ref>. </char></note> ku yaaboine eruuru emwe ey'obuguzi bwingi, yaagyenda, yaatunda ebye byona, yaagigura.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:47: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:9">Mat 22:9</ref>, <ref loc="MAT 22:10">10</ref>. </char>
    </note> Kandi hoona obukama bw'omu iguru nibushusha nk'akatimba aku bategire omu nyanja, kakakwata eby'enyanja by'emiringo yoona. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ku kaijwire, baakakurura, baakahitsya aha nkungu, baashutama, baatooranamu ebirungi, baabita omu bintu byabo, ebibi baabinaga. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" /><note caller="-" style="x"><char style="xo" closed="false">13:49: </char><char style="xt" closed="false"><ref loc="MAT 25:32">Mat 25:32</ref>. </char></note> Nikwo kiriba kityo aha mperu y'obusingye obu; baamaraika baryaija baihe ababi omu bahikiriire, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />babanagye omu kikoomi ky'omuriro; omwo nimwo bariririra, bakanena enshaya. <verse eid="MAT 13:50" /><verse number="51" style="v" sid="MAT 13:51" />Mwayetegyereza ebigambo ebyo byona? Baamugarukamu bati, Eego. <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Yaagaruka yaabagira ati: N'ahabw'ekyo omuhandiiki weena oyegyesiibwe eby'obukama bw'omu iguru naashushanisibwa na nyineeka, oiha omu ibiikiro rye ebintu ebisya n'ebya ira.<verse eid="MAT 13:52" /></para>
  <para style="s1">Yesu okugaywa ab'owaabo</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:53-58: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 4:15-30">Luk 4:15-30</ref>; <ref loc="MRK 6:1-6">Mak 6:1-6</ref>. </char>
    </note> Bwanyima Yesu, ku yaaherize kubacwera enfumu ezo, yaarugayo; <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ku yaahikire omu nsi y'owaabo, yaatandika kubeegyeseza omuri sinagogi yaabo; n'ahabw'ekyo baatangaara nibagira bati: Obwengye obu n'eby'okutangaaza ebi ogu akabiiha hi? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Beitu ogu t'omwana w'omubaizi, na nyina tarikwetwa Mariamu? N'abarumuna ti Yakobo, Yosefu, Simooni na Yuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" /><note caller="-" style="x"><char style="xo" closed="false">13:56: </char><char style="xt" closed="false"><ref loc="JHN 7:52">Yoh 7:52</ref>. </char></note> Nangwa na banyaanya boona ti bari aha naitwe? Beitu ogu mushaija ebi byona akabiiha hi? Ebye byabashobera. <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Yesu yaabagira ati: Nabi tabura kitiinisa kureka omu ihanga ryabo kandi n'omu ka ye. <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Okwo Yesu tiyaakorayo by'okutangaaza bingi ahabw'okutaikiriza kwabo.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Heroode okwita Yohaana omubatizi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1-32: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:7-9">Luk 9:7-9</ref>; <ref loc="MRK 6:17-30">Mak 6:17-30</ref>. </char>
    </note> Omu biro ebyo Heroode ow'eishaza akahurira okurangaanwa kwa Yesu; <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />yaagambira abagaragwa be ati: Ogwo ni Yohaana Omubatizi azookire omu bafu; nikyo kirikumukoresa eby'okutangaaza ebyo. <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Ahakuba ebyo bitakabaireho, Heroode akakwata Yohaana, yaamuboha, yaamuta omu kihome ahabwa Herodia, muka Filipo mwene ishe; <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ahabw'okuba Yohaana akateisa Heroode ati: Ebiragiro tibirikukwikiriza kumugira omukazi waawe. <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Ku yaabaire naayenda kumwita, yaatiina abantu, ahabw'okuba abantu bakaba nibahamya ku Yohaana ari nabi. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Kwonka ekiro ky'okwijuka okuzaarwa kwa Heroode ku kyahikire, muhara wa Herodia yaazinira omu maisho g'abagyenyi, yaashemeza Heroode. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />N'ahabw'ekyo yaamuraganisa, naarahira ku arikwija kumuha eki araamushabe kyona. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Omwishiki ku yaaherize kuhaburwa nyina, yaamushaba ati: Mpeera aha omutwe gwa Yohaana Omubatizi omu rucuba. <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ekyo kyasaasa omugabe; kwonka ahabw'okushangwa yaarahiire omu maisho g'abagyenyi be, yaaragiira kugumuha. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Yaatuma, baatemaho Yohaana omutwe omu kihome. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Baareeta omutwe omu rucuba, baaguha omwishiki, nawe yaagutwarira nyina. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Abeegi be baija, baatwara omutumbi gwe baaguziika, baagyenda baamubikira Yesu.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu okuriisa abantu 5,000</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:13-21: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="MRK 6:31-44">Mak 6:31-44</ref>; <ref loc="JHN 6:1-13">Yoh 6:1-13</ref>. </char>
    </note> Yesu ku yaabihuriire, yaarugayo, yaagyendera omu bwato, yaaza omu ihamba kwehereera; abantu baingi ku baakimanyire, baaruga omuri tauni, baaraba ogw'ebigyere, baamukurata. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Ku yaayambukire, yaashangayo emitwe mingi y'abantu, yaabagirira embabazi, yaatambira abarwaire baabo. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Ku bwaizire, abeegi be baija ah'ari, baamugira bati: Aha n'eihamba; kandi bwizire. Raga abantu bagyende omu birorero, beeshakire eby'okurya. <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Kwonka Yesu yaabagarukamu ati: Tihariho kirikubatwara; mubagaburire. <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Baamugarukamu bati: Eki twine aha n'emigaati etaano n'eby'enyanja bibiri kwonka. <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yaabagira ati: Mubindeetere. <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yaaragiira emitwe y'abantu kushutama omu kacwamba; yaayakiira egyo migaati etaano n'eby'enyanja bibiri, yaareeba ahaiguru, yaasiima, yaabega emigaati, yaagiha abeegi be, nabo baagaburira abantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" /><note caller="-" style="x"><char style="xo" closed="false">14:20: </char><char style="xt" closed="false"><ref loc="2KI 4:44">2 Bag 4:44</ref>. </char></note> Boona baarya, baahaaga. Bwanyima baatorotoora oburagarika obwatsigaraho, baijuza ebitenga ikumi na bibiri. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Abo abaariire bakaba bari abashaija enkumi itaano, otabariiremu bakazi n'abaana.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu okugyendesa amaguru aha maizi</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:22-36: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:45-56">Mak 6:45-56</ref>; <ref loc="JHN 6:15-21">Yoh 6:15-21</ref>. </char>
    </note> Ahonaaho yaagyema abeegi be ngu baze omu bwato, bamubandize seeri, We atsigare abanze aragye emitwe egyo. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" /><note caller="-" style="x"><char style="xo" closed="false">14:23: </char><char style="xt" closed="false"><ref loc="LUK 6:12">Luk 6:12</ref>; <ref loc="LUK 9:18">9:18</ref>. </char></note> Ku yaaherize kubaraga, yainamuka omu kibungo wenka kushaba. Obwire bwaira akiriyo wenka; <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />kwonka obwo, obwato bukaba buri ahagati y'enyanja, nibuzongibwa ebingonzi; ahabw'okuba omuyaga gukaba gubaturukire omu maisho. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" /><note caller="+" style="f"><char style="fr" closed="false">14:25 </char><char style="ft" closed="false">Omu Rugriika ngu: omu bunaku bw'abarinzi ba kana. </char></note>Enkoko ku zaabaire nizigamba, yaabaizira naagyendesa amaguru aha nyanja. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Abeegi be ku baamureebire naagyendera aha nyanja, baayemereza emitima, baataka ahabw'obwoba, nibagira bati: N'omuzimu! <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Ahonaaho Yesu yaabahuumuriza, naagira ati: muhuumure! Niinye, mutatiina.<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petero yaamugarukamu ati: Mukama wangye, ku oraabe ori iwe, ndagiira, nyije aho ningyendera aha maizi. <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yaamwikiriza ati: Ija. Petero yaaruga omu bwato, yaagyendera aha maizi kushanga Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Kwonka ku yaareebire omuyaga gwaba mwingi, yaatiina; ku yaatandikire kutobera, yaataka ati: Mukama wangye, njuna. <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Ahonaaho Yesu yaagorora omukono gwe, yaamukwata, yaamugira ati: Iwe oine okwikiriza kukye, ahanki noobanganisa? <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ku baagiire omu bwato, omuyaga gwatuuza. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Abaabaire bari omu bwato baamuramya nibagira bati: Buzimazima ori Omwana wa Ruhanga.<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ku baaherize kwambuka, baahika seeri aharikwetwa Genesareeti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Abantu bayo, ku baamumanyire, baagaba ebirari aho hoona, baamureetera boona abaabaire barwaire; <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />baamweshengyereza ngu nangwa bakore aha mukugiro gw'ekaanzu ye kwonka; boona abaagukozireho, oku baingana, baakirira kimwe.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Eby'emigyenzo y'Abafarisaayo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1-20: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 7:1-23">Mak 7:1-23</ref>. </char>
    </note> Kandi Abafarisaayo n'abahandiiki bakaruga Yerusaalemu, baija ahari Yesu, baamubuuza bati: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" /><note caller="-" style="x"><char style="xo" closed="false">15:2: </char><char style="xt" closed="false"><ref loc="LUK 11:38">Luk 11:38</ref>. </char></note> Ahabw'enki abeegi baawe bashobya emigyenzo ya baishenkurubo? Ahabw'okuba tibajabika ngaro omu maizi, baaba nibaza kurya. <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yaabagarukamu naababuuza ati: Ahabw'enki imwe mushobya ebiragiro bya Ruhanga ahabw'emigyenzo yaanyu? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" /><note caller="-" style="x"><char style="xo" closed="false">15:4: </char><char style="xt" closed="false"><ref loc="EXO 21:17">Kur 21:17</ref>. </char></note> Nimumanya ngu Ruhanga akaragiira ati: Otiine sho na nyoko; kandi ati: Orijuma ishe nari nyina, aitwe. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Kwonka imwe nimugira muti: Omuntu orikugambira ishe nari nyina ati: Kyona eki naakukuhaire kukuhwera, nkihongyeire Ruhanga, ogwo aba atakigyemwa kutiina ishe. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Omu buryo obwo ekigambo kya Ruhanga mukihindura busha, ngu mugumye emigyenzo yaanyu. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" /><note caller="-" style="x"><char style="xo" closed="false">15:7: </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29:13</ref>. </char></note> Imwe ndyarya 'mwe, Isaaya akabaraguraho kurungi, obu yaagira ati:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />Ab'eihanga eri nibampa ekitiinisa ky'aha minwa,</para>
  <para style="q1" vid="MAT 15:8">Kwonka emitima yaabo endi hare.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Bandamiza busha,</para>
  <para style="q1" vid="MAT 15:9">Ahakuba okwegyesa, oku beegyesa, kuba okw'ebiragiro by'abantu.<verse eid="MAT 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 15:10" />Yaayeta omutwe gw'abantu, yaabagambira ati: muhurire, kandi mwetegyereze. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ekitaaha omu kanwa tikyo kishiisha omuntu; kureka ekiruga omu kanwa, nikyo kishiisha omuntu. <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Bwanyima abeegi be baija baamugira bati: Noomanya ku Abafarisaayo baaguubwa kubi ahabw'okuhurira ebyo ebi waagamba? <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" /><note caller="-" style="x"><char style="xo" closed="false">15:13: </char><char style="xt" closed="false"><ref loc="JHN 15:2">Yoh 15:2</ref>. </char></note> Yaabagarukamu ati: Buri muti gwona ogu Tata ow'omu iguru atarabyaire, guryakuurwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><note caller="-" style="x"><char style="xo" closed="false">15:14: </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luk 6:39</ref>; <ref loc="JHN 9:40">Yoh 9:40</ref>; <ref loc="ROM 2:19">Rom 2:19</ref>. </char></note> Mubarekye! N'abeebembezi empumi, haza nabo bahumire. Mumanye ngu empumi ku eyebembera endiijo, zombi zigwa omu kiina. <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Petero yaamushaba ati: Tushobororere amakuru g'egyo nfumu. <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesu yaamugarukamu ati: Biri shi naimwe timukashoborokyeirwe? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Timurikumanya ngu, ekintu ku kitaaha omu kanwa, kiza omunda, bwanyima kishohora? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Kwonka ebiruga omu kanwa biba nibiruga omu mutima; ebyo nibyo bishiisha omuntu. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" /><note caller="-" style="x"><char style="xo" closed="false">15:19: </char><char style="xt" closed="false"><ref loc="GEN 8:21">Kut 8:21</ref>. </char></note> Ahabw'okuba omu mutima nimwo haruga ebiteekateeko bibi, okwita, okushambana, okwiba, okubeiherera abandi, okujuma; <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ebyo nibyo bishiisha omuntu; kwonka okuriisa engaro zitajabikire mu maizi, ekyo tikishiisha muntu.<verse eid="MAT 15:20" /></para>
  <para style="s1">Yesu okutambira omwana w'Omunyakanaanikazi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:21-28: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 7:24-30">Mak 7:24-30</ref>. </char>
    </note> Kandi Yesu yaarugayo, yaataaha omu ishaza rya Tuuro n'erya Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Haija Omunyakanaanikazi ow'omu kyanga ekyo, yaamweshengyereza naagira ati: mukama wangye, Mwana wa Daudi, ngirira embabazi! Muhara wangye ariho daimoni, naamwita kubi munonga. <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Kwonka Yesu tiyaagira ki yaamugarukamu. Abeegi be baija, bamweshengyereza nibagira bati: Muragiire, agyende, ahabw'okuba naatuyomberera. <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />We yaagarukamu ati: Tindatumirwe ha bandi kureka aha ntaama z'oruganda rwa Israeli ezaabuzire. <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Omukazi yaagaruka yaamuramya naagira ati: Mukama wangye, mpwera. <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yaamugarukamu ati: Ti kirungi omuntu kwaka abaana eby'okurya, akabitambikira embwa. <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Omukazi yaamwikiriza ati: Eego, Mukama wangye, kwonka embwa nazo zirya oburagarika oburagara niburuga aha meeza ya mukama waazo. <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" /><note caller="-" style="x"><char style="xo" closed="false">15:28: </char><char style="xt" closed="false"><ref loc="MAT 8:10">Mat 8:10</ref>. </char></note> Yesu yaamugarukamu ati: Mukazi 'we, okwikiriza kwawe kwingi; kibe nk'oku orikwenda. Okuruga aho muhara we yaakira.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu okugaburira abantu enkumi ina</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu yaarugayo, yaaraba aha rubaju rw'enyanja ya Galilaaya; yainamuka omu migongo, yaashutamayo. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Emitwe y'abantu baingi baamushangayo, bamureeteire ebirema n'empumi n'ebiteta n'ebimuga n'abandi baingi, baabata aha bigyere bye, yaabatambira; <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />n'ahabw'ekyo abantu baatangaara, ku baareebire ebiteta nibigamba, ebimuga nibikira, ebirema nibigyenda, n'empumi nizireeba; baahimbisa Ruhanga wa Israeli.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:32-39: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:1-10">Mak 8:1-10</ref>. </char>
    </note> Bwanyima Yesu yaayeta abeegi be, yaabagira ati: Ninsaasira abantu aba, ahabw'okuba bamazire aha naanye ebiro bishatu, hati tibaine ky'okurya; tinkaayenzire kuboohereza basiibirekwo, batakaagwera enshazi omu muhanda. <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Abeegi be baamubuuza bati: Omuri eri ihamba nitwiha hi emigaati erikubaasa kuhaazya abantu abarikwingana bati? <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yesu yaababuuza ati: Mwine emigaati engahi? Banu bati: Ni mushanju n'obw'enyanja bukye. <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Yaaragiira abantu kushutama ahansi; <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />yaakwata egyo migaati mushanju n'obw'enyanja; ku yaabisiimiire, yaabega emigaati, yaagiha abeegi be, nabo baagaburira abantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Boona baarya, baahaaga, baatorotoora oburagarika obwatsigaireho, baijuza ebiibo mushanju. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Boona abaariire bakaba bari enkumi ina, otabariiremu bakazi n'abaana. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Yaabaraga, yaaza omu bwato, yaataaha omu ishaza rya Magadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Yesu okwima Abafarisaayo akamanyiso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1-12: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:11-21">Mak 8:11-21</ref>. </char>
    </note> Abafarisaayo n'Abasadukaayo bakaija, baamushaba kubooreka akamanyiso akarikuruga omu iguru, nibamutega. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" /><note caller="-" style="x"><char style="xo" closed="false">16:2: </char><char style="xt" closed="false"><ref loc="LUK 12:54-56">Luk 12:54-56</ref>. </char></note> Yaabagarukamu ati: Ku buba buri haihi kwira, mwareeba ebicu nibitukura, mugira ngu, omu kasheeshe nihaija kusiiba hakyeire. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Kandi omu kasheeshe mugira ngu eri izooba nihaija kuba habi, ahabw'okuba ebicu nibitukura kandi nibikondakonda. Nimumanya kukyenga enshusha y'eiguru, kwonka timurikubaasa kukyenga obumanyiso bw'obunaku. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><note caller="-" style="x"><char style="xo" closed="false">16:4: </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>, <ref loc="MAT 12:40">40</ref>. </char></note> Ab'obusingye obubi obw'obushambani nibenda akamanyiso; kwonka tibarikaheebwa kureka akamanyiso ka Yona. Yaabarugaho, yaayegyendera.<verse eid="MAT 16:4" /></para>
  <para style="s1">Ekitumbisa ky'Abafarisaayo</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Abeegi be ku baahikire seeri, baijuka ku beebirwe kwereetera emigaati. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu yaabahabura ati: Reeba, mwerinde ekitumbisa ky'Abafarisaayo n'Abasadukaayo. <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Baagambirana bati: Eki arikufa n'ahabw'okuba titwareeta migaati. <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yesu ku yaabimanyire, yaababuuza ati: Imwe abaine okwikiriza kukye, nimufa ki aha by'emigaati? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><note caller="-" style="x"><char style="xo" closed="false">16:9: </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">Mat 14:17-21</ref>. </char></note> Timukashoborokyeirwe, n'obu kwakuba okwijuka emigaati etaano aha bantu enkumi itaano, n'ebitenga oku byaingaine ebi mwaijwize? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="-" style="x"><char style="xo" closed="false">16:10: </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">Mat 15:34-38</ref>. </char></note> Kandi n'emigaati mushanju aha nkumi ina, n'ebiibo oku byaingaine ebi mwaijwize? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />N'enki ekibazibiire kumanya ku ntarikugamba ha by'emigaati? Mwerinde ekitumbisa ky'Abafarisaayo n'Abasadukaayo. <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Okuruga aho baamanya ku atabagambiire kwerinda ekitumbisa eky'emigaati, kureka enyegyesa y'Abafarisaayo n'Abasadukaayo.<verse eid="MAT 16:12" /></para>
  <para style="s1">Petero okuhamya ku Yesu ari Kristo</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:13-20: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:18-21">Luk 9:18-21</ref>; <ref loc="MRK 8:27-30">Mak 8:27-30</ref>. </char>
    </note> Yesu, ku yaahikire omu kyanga kya Kaisarea-Filipi, yaabuuza abeegi be ati: Beitu abantu nibagira ngu nyowe Omwana w'omuntu ndi oha? <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Baamugira bati: Abamwe nibagira ngu, Ori Yohaana Omubatizi, abandi ngu, Ori Eliya, kandi abandi ngu, Ori Yeremia nari omwe ahari baanabi. <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Yaababuuza ati: Mbwenu shi imwe, mugira ngu mba oha? <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" /><note caller="-" style="x"><char style="xo" closed="false">16:16: </char><char style="xt" closed="false"><ref loc="JHN 6:69">Yoh 6:69</ref>. </char></note> Simooni Petero yaagarukamu ati: Ori Kristo, Omwana wa Ruhanga ohuriire. <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" /><note caller="-" style="x"><char style="xo" closed="false">16:17: </char><char style="xt" closed="false"><ref loc="GAL 1:15">Gal 1:15</ref>, <ref loc="GAL 1:16">16</ref>. </char></note> Yesu yaamugarukamu ati: Oine omugisha, Simooni mwene Yona; ahabw'okuba omubiri n'eshagama tibyo byakushuuruurira ekyo, kureka Tata ori omu iguru. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" /><note caller="-" style="x"><char style="xo" closed="false">16:18: </char><char style="xt" closed="false"><ref loc="JHN 1:42">Yoh 1:42</ref>; <ref loc="EPH 2:20">Efe 2:20</ref>. </char></note> Kandi ninkugambira nti: Ori <note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Omu Rugriika Petros amakuru eibaare. </char></note>Petero, naanye ndyayombeka ekanisa yangye aha <note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Petra omu Rugriika n'orukiri. </char></note>rukiri oru, <note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Nari amaani ga rufu. </char></note>n'amarembo g'okuzimu tigarigibaasa. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="-" style="x"><char style="xo" closed="false">16:19: </char><char style="xt" closed="false"><ref loc="MAT 18:18">Mat 18:18</ref>. </char></note> Ndyakuha ebishumuruzo by'obukama bw'omu iguru; eki oriboha omu nsi kyona, kiryabohwa n'omu iguru; eki orikomoorora omu nsi kyona, kiryakomoororwa n'omu iguru. <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Bwanyima yaayehanangiriza abeegi be kutagira ou baagambira ku ari Kristo.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu okuhana Petero</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:21-28: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:22-27">Luk 9:22-27</ref>; <ref loc="MRK 8:31-9:1">Mak 8:31—9:1</ref>. </char>
    </note> Okuruga aho Yesu yaatandika kumanyisa abeegi be oku ashemereire kuza Yerusaalemu, akabonabonesibwa omuri bingi abakuru n'abanyamurwa abakuru n'abahandiiki, akaitwa, kandi bwanyima y'ebiro bishatu akazooka. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Petero yaamuta aha rubaju, yaatandika kumuteisa, naamugira ati: Nikikabure, Mukama wangye! Ekyo tikirikwija kukubaho na kakye. <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Yesu yaahinduka, yaagira Petero ati: Garuka enyima yangye, Sitaane! Wambeera enkongi, ahabw'okuba torikuteekateeka bya Ruhanga, kureka eby'abantu.<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:24: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>, <ref loc="MAT 10:39">39</ref>. </char>
    </note> Yesu yaayeyongyera yaagambira abeegi be ati: Omuntu weena ku araayende kunkuratira, ayeyangise, ayekorere omusharaba gwe, ankuratire. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Omuntu weena orikwenda kukiza amagara ge, aryagabuza; kandi weena orikubuza amagara ge ahabwangye, aryagakiza. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" /><note caller="-" style="x"><char style="xo" closed="false">16:26: </char><char style="xt" closed="false"><ref loc="MAT 4:8">Mat 4:8</ref>. </char></note> Mbwenu kiryagasira ki omuntu kutunga ensi yoona, haza akafeerwa amagara ge? Nari shi, omuntu aryahayo ki kucungura amagara ge? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="-" style="x"><char style="xo" closed="false">16:27: </char><char style="xt" closed="false"><ref loc="ROM 2:6">Rom 2:6</ref>; <ref loc="PRO 24:12">Enf 24:12</ref>. </char></note> Mumanye ngu Omwana w'omuntu aryaija na baamaraika be omu kitiinisa kya Ishe; kandi obwo nibwo ariihura omuntu weena ebishemereire ebi yaakozire. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Buzima nimbagambira nti: Omuri aba abeemereire aha, hariho bamwe abarireeba Omwana w'omuntu naija omu bukama bwe batakafiire.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Okuhindurwa kwa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:1-13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:28-36">Luk 9:28-36</ref>; <ref loc="MRK 9:2-13">Mak 9:2-13</ref>. </char>
    </note> Ku haahingwireho ebiro mukaaga, Yesu yaagyenda na Petero na Yakobo na Yohaana omurumuna, yaabahitsya aha mutwe gw'orushozi ruraingwa bonka. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" /><note caller="-" style="x"><char style="xo" closed="false">17:2: </char><char style="xt" closed="false"><ref loc="2PE 1:16-18">2 Pet 1:16-18</ref>. </char></note> Yaahindurirwa omu maisho gaabo, aha maisho ge haamurinkana nk'eizooba, n'ebijwaro bye byayera nk'omushana. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kandi Musa na Eliya baareebeka omu maisho gaabo, nibagaaniira nawe. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Petero yaagambira Yesu ati: Mukama wangye, ni kirungi obu turi aha; ku oraabe nookunda, twombekye obuju bushatu, akamwe kabe akaawe, akandi kabe aka Musa, n'akandi aka Eliya. <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" /><note caller="-" style="x"><char style="xo" closed="false">17:5: </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="DEU 18:15">Bir 18:15</ref>. </char></note> Ku yaabaire naakigamba, haija ekicu kirikwengyengyeta, kyabasangira, eiraka ryakyemamu nirigira riti: ogu n'Omwana wangye ou nkunda, ou nyesiimira munonga; mumuhurire. <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Abeegi ku baarihuriire, baagwa bajuumaire, batiinire munonga. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesu yaija, yaabakoraho, yaabagambira ati: Mwimukye, mutatiina. <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Ku baajuumwire amaisho, tibareeba muntu weena kureka Yesu wenka. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Bwanyima ku baabaire nibashuuma nibaruga aha rushozi, Yesu yaabeehanangiriza ati: Mutagira ou mwagambira ebi mworekirwe, okuhitsya obu Omwana w'omuntu arizooka omu bafu. <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" /><note caller="-" style="x"><char style="xo" closed="false">17:10: </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref>. </char></note> Abeegi be baamubuuza bati: Ahabw'enki abahandiiki bagira ngu: Eliya ashemereire kubanza kwija? <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Yaabagarukamu ati: N'eky'amazima; Eliya aryaija, ashemeze byona; <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="-" style="x"><char style="xo" closed="false">17:12: </char><char style="xt" closed="false"><ref loc="MAT 14:9">Mat 14:9</ref>, <ref loc="MAT 14:10">10</ref>. </char></note> kwonka nimbagambira ngu, Eliya akaheza kwija; kwonka tibaramumanyire, kureka bakamutwaza, nk'oku baayenzire. Kandi hoona n'Omwana w'omuntu nikwo barimubonabonesa. <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Aho niho abeegi be baihire kumanya ku arikubagambira ahari Yohaana Omubatizi.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu okukiza omugwi w'entsimbo</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:14-21: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:37-42">Luk 9:37-42</ref>; <ref loc="MRK 9:14-20">Mak 9:14-20</ref>. </char>
    </note> Ku baahikire ahu abantu baingi baabaire bari, haija omushaija, yaamutsimbira amaju, yaamugira ati: <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Mukama wangye, saasira omwana wangye; ahabw'okuba naagwa entsimbo, kandi zimukabya munonga; kaingi agwa omu muriro, kandi obundi agwa omu maizi. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Naamureetera abeegi baawe, baaremwa kumukiza. <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Yesu yaagarukamu ati: Imwe ab'obusingye obu obutarikwikiriza, oburikwehabagiza, ndyahitsya hi okuguma naimwe? Ndyahitsya hi okubagumisiririza? Mumundeetere! <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yaagambira kubi daimoni; yaamurugaho, omwana ogwo yaakirira aho omuri ako kaanya. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" /><note caller="-" style="x"><char style="xo" closed="false">17:19: </char><char style="xt" closed="false"><ref loc="MAT 10:1">Mat 10:1</ref>. </char></note> Bwanyima abeegi baija ahari Yesu omu mubonano, baamubuuza bati: Ahabw'enki itwe tutabaasize kumubinga? <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" /><note caller="-" style="x"><char style="xo" closed="false">17:20: </char><char style="xt" closed="false"><ref loc="LUK 17:6">Luk 17:6</ref>; <ref loc="MRK 11:23">Mak 11:23</ref>. </char></note> Yaabagarukamu ati: N'ahabw'okwikiriza kwanyu kukye. Kandi buzima nimbagambira nti: Ku muraabe mwine okwikiriza nk'akajuma ka <note caller="+" style="f"><char style="fr" closed="false">17:20 </char><char style="fk" closed="false">Sinaapi: </char><char style="ft" closed="false">reeba Mat. 13:31. </char></note>sinaapi, ku murigambira orushozi oru ngu, Ruga aha, oze hariya, ruryarugaho; kandi tihariho kintu kyona ekiribarema. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Kwonka daimoni ow'omuringo nk'ogu tarikubingwa kindi kureka okushaba n'okwesiibyakwo.<verse eid="MAT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:22-23: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:43-45">Luk 9:43-45</ref>; <ref loc="MRK 9:30-32">Mak 9:30-32</ref>. </char>
    </note> Ku baabaire bari Galilaaya, Yesu yaabagambira ati: Omwana w'omuntu aryaheebwayo omu mikono y'abantu; <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />baryamwita, kandi aha kiro kya kashatu aryazooka. Baaganya munonga.<verse eid="MAT 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:24: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 30:13">Kur 30:13</ref>. </char>
    </note> Ku baataahire Kaperenaumu, abantu abarikushooza <note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">Omushoro gwa hekalu n'ekicweka kya shekeli ekyabaire kishorwa Omuyudaaya weena buri mwaka. Reeba Okuruga 30:12-16. </char></note>omushoro gwa hekalu baija ahari Petero, baamubuuza bati: Beitu omwegyesa waanyu tashora? <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Yaabagarukamu ati: Naashora. Ku yaataahire omu nju, Yesu yaaba niwe yaabanza kumubuuza ati: Nooteekateeka ota, Simooni? Abagabe b'ensi ehoozi n'omushoro babiheebwa bantu ki? Abaana baabo nari abantu abandi? <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Ku yaamugarukiremu ati, Abandi, Yesu yaamugambira ati: Mbwenu abaana baabo baine obusingye. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Kwonka itwe tutabagwisa kubi, ogyende aha nyanja, otegyese eirobo, eky'enyanja eki oraabanze kukwata, okyashamure, omu kanwa kaakyo noija kushangamu sitateeri; obe niyo waabaha ahabwangye n'ahabwawe.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Ebirikusiimwa n'ebirikwangwa omu bukama bwa Ruhanga</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:1-9: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 9:46-48">Luk 9:46-48</ref>; <ref loc="MRK 9:33-47">Mak 9:33-47</ref>. </char>
    </note> Omu bunaku obwo abeegi bakaija ahari Yesu, baamubuuza bati: Omukuru omu bukama bw'omu iguru n'oha? <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yaayeta omwana muto, yaamwemereza ahagati yaabo, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="-" style="x"><char style="xo" closed="false">18:3: </char><char style="xt" closed="false"><ref loc="JHN 3:3-5">Yoh 3:3-5</ref>. </char></note> yaagira ati: Buzimazima nimbagambira nti: Ku muriba mutahindukire, mukaba nk'abaana bato, timuritaaha mu bukama bw'omu iguru na kakye. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Omuntu weena, orikwecureeza nk'omwana ogu omuto, niwe mukuru omu bukama bw'omu iguru. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" /><note caller="-" style="x"><char style="xo" closed="false">18:5: </char><char style="xt" closed="false"><ref loc="JHN 13:20">Yoh 13:20</ref>. </char></note> Kandi weena orikwakiira omwana muto nk'ogu omu iziina ryangye, biri niinye ayakiire; <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" /><note caller="-" style="x"><char style="xo" closed="false">18:6: </char><char style="xt" closed="false"><ref loc="LUK 17:1">Luk 17:1</ref>, <ref loc="LUK 17:2">2</ref>. </char></note> kwonka weena orireetera omwe ahari aba abato abarikuunyikiriza kukora ekibi, haakiri omuntu ogwo okubohwa orubengo ruhango omu bitsya, akanagwa ahagati omu nyanja. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Ensi eryakareeba ahabw'ebirikugwisa abantu. Ebirikugwisa tibiribura kwija; kwonka origwisa abandi, aryakareeba. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Omukono gwawe nari shi ekigyere kyawe ku kiraakureetere kukora ekibi, okitemeho, okinagye hare; haakiri iwe okutaaha omu magara, ori ekirema nari noocumbagira, okukira okunagwa omu muriro ogutaraara oine emikono yombi nari ebigyere byombi. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Kandi n'eriisho ryawe ku riraakureetere kukora ekibi, oriihemu orinagye hare; haakiri iwe okutaaha omu magara oine eriisho rimwe, okukira okunagwa omuri Gehena ey'omuriro oine amaisho gombi.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:10: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:14">Heb 1:14</ref>. </char>
    </note> Mwerinde murekye kugaya omwe ahari aba abato; ahakuba nimbagambira nti: Omu iguru baamaraika baabo bareeba obutoosha ahamaisho ga Tata ori omu iguru. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Ahabw'okuba Omwana w'omuntu akaija kujuna ekyabaire kibuzire. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" /><note caller="-" style="x"><char style="xo" closed="false">18:12-14: </char><char style="xt" closed="false"><ref loc="LUK 15:4-7">Luk 15:4-7</ref>. </char></note> Nimuteekateeka muta? Omuntu ku aba aine entaama igana, emwe aharizo yaarara, tatsiga ziri makumi mwenda na mwenda aha mugongo, akaza kusherura egyo erazire? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Kandi ku agibona, buzimazima nimbagambira nti: Agishemerererwa okukira ziri makumi mwenda na mwenda ezaaba zitarazire. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nikwo na Tata ori omu iguru atarikwenda omwe ahari aba bato kuhwerekyerera.<verse eid="MAT 18:14" /></para>
  <para style="s1">Oku Ekanisa eshemereire kutwaza oyangire kuhanwa</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:15: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">Luk 17:3</ref>; <ref loc="LEV 19:17">Lev 19:17</ref>; <ref loc="GAL 6:1">Gal 6:1</ref>. </char>
    </note> Mwene waanyu ku araakukore kubi, gyenda omumanyise eki akushagiize muri mwembi. Ku araakworobere, biri waabona mwene sho. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" /><note caller="-" style="x"><char style="xo" closed="false">18:16: </char><char style="xt" closed="false"><ref loc="DEU 19:15">Bir 19:15</ref>. </char></note> Ku araayangye kukworobera, otware ondiijo nari babiri, ngu ekigambo kyona kihamibwe baakareebi babiri nari bashatu. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" /><note caller="-" style="x"><char style="xo" closed="false">18:17: </char><char style="xt" closed="false"><ref loc="1CO 5:13">1 Kor 5:13</ref>. </char></note> Nabo ku araayangye kuboorobera, okigambire ekanisa; kandi ku araayangye kworobera ekanisa, abe nk'omunyaihanga n'omuhooza ahariiwe. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" /><note caller="-" style="x"><char style="xo" closed="false">18:18: </char><char style="xt" closed="false"><ref loc="JHN 20:23">Yoh 20:23</ref>. </char></note> Buzimazima nimbagambira nti: Ebi muriboha omu nsi byona, biryabohwa n'omu iguru; kandi ebi murikomoorora omu nsi byona, biryakomoororwa n'omu iguru. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Kandi nimbagambira nti: Babiri ahariimwe ku barikwatanisa omu nsi, baashaba ekintu kyona, kiryabakorerwa Tata ori omu iguru. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" /><note caller="-" style="x"><char style="xo" closed="false">18:20: </char><char style="xt" closed="false"><ref loc="JHN 14:23">Yoh 14:23</ref>. </char></note> Ahabw'okuba babiri nari bashatu ku bariteeranira ahamwe omu iziina ryangye, naanye ndyaba ahagati yaabo.<verse eid="MAT 18:20" /></para>
  <para style="s1">Eby'okusaasirana</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Bwanyima Petero yaija, yaamubuuza ati: Mukama wangye, mugyenzi wangye ku araagume nanshaagiza, mmusaasire kangahi? Mpitsye emirundi mushanju? <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" /><note caller="-" style="x"><char style="xo" closed="false">18:22: </char><char style="xt" closed="false"><ref loc="LUK 17:4">Luk 17:4</ref>. </char></note> Yesu yaamugarukamu ati: Tindikukugira nti, Ohitsye emirundi mushanju, kureka nti, Ohitsye emirundi makumi mushanju emirundi mushanju.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />N'ahabw'ekyo obukama bw'omu iguru nibushushanisibwa n'omugabe owaayenzire kubara <note caller="+" style="f"><char style="fr" closed="false">18:23 </char><char style="ft" closed="false">Omu Rugriika n'omuhuuku. </char></note>n'abambari be ebintu ebi yaabaire ababiikize. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Ku yaatandikire kubara, baamureetera omwe owaabaire aine eibanja rye ery'etalanta kakumi. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Ku yaabuzire eky'okwihura, mukama we yaaragiira ku bamutunda, we n'omukazi we n'abaana be n'ebi yaabaire aine byona, ngu abone kumara eibanja. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" /><note caller="+" style="f"><char style="fr" closed="false">18:26 </char><char style="ft" closed="false">Omu Rugriika n'omuhuuku. </char></note>Omwambari ogwo nikwo kumukwata amaguru akamweshengyereza, naagira ati: Mukama wangye, nyihuza mpora, naanye ndyakwihura byona. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Mukama <note caller="+" style="f"><char style="fr" closed="false">18:27 </char><char style="ft" closed="false">Omu Rugriika n'omuhuuku. </char></note>w'omwambari ogwo ahabw'embabazi ze yaamurekura, yaamusaasira eibanja eryo.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Kwonka omwambari ogwo, ku yaashohoire, yaabugana omwambari mugyenzi we, owaabaire aine eibanja rye ery'edenaari igana; yaamukwata, yaamuta aha munigo, naagira ati: Nyihura eibanja ryangye. <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Ogwo mwambari mugyenzi we yaamukwata amaguru, yaamweshengyereza ati: Nyihuza mpora, niinyija kukwihura. <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />We yaayanga, yaagyenda, yaamuta omu kihome, okuhitsya obu araaheze eibanja. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Mbwenu abambari bagyenzi be, ku baareebire ebyabaho, baamugwerwa kubi munonga; baagyenda baabigambira mukama waabo byona. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Mukama waabo nikwo kumutuma, akamujuukirira ati: iwe mwambari 'we omubi, nkusaasiire eibanja eryo ryona ahabw'okuunyeshengyereza; <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />naiwe toshemereire kusaasira omwambari mugyenzi waawe, nk'oku nkusaasiire? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" /><note caller="-" style="x"><char style="xo" closed="false">18:34: </char><char style="xt" closed="false"><ref loc="MAT 5:26">Mat 5:26</ref>. </char></note> Mukama we yaamugwerwa kubi, yaamuhayo omu mikono y'abarinzi, okuhitsya obu ariihura eibanja ryona. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" /><note caller="-" style="x"><char style="xo" closed="false">18:35: </char><char style="xt" closed="false"><ref loc="MAT 6:14">Mat 6:14</ref>, <ref loc="MAT 6:15">15</ref>. </char></note> Nikwo Tata ow'omu iguru aribagira atyo, ku muriba mutasaasiire bagyenzi baanyu, mwihire aha mutima.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:1: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 10:1-12">Mak 10:1-12</ref>. </char>
    </note> Yesu ku yaaherize kugamba ebyo byona, yaaruga Galilaaya, yaataaha omu ishaza rya Buyudaaya seeri ya Yorudani; <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />emitwe y'abantu baingi yaamukuratira, yaabakirizayo.<verse eid="MAT 19:2" /></para>
  <para style="s1">Eby'okushenda omukazi</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:3: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">Mat 5:31</ref>, <ref loc="MAT 5:32">32</ref>. </char>
    </note> Abafarisaayo baija ah'ari, baamutega nibagira bati: Beitu Ebiragiro biikiriza omushaija kushenda omukazi we, yaaba aine eki arikumutura kyona? <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Yaabagarukamu ati: Timukashomaga ngu, Owaabahangire bwa mbere na mbere, akahanga omushaija n'omukazi? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><note caller="-" style="x"><char style="xo" closed="false">19:5: </char><char style="xt" closed="false"><ref loc="EPH 5:31">Efe 5:31</ref>. </char></note> Yaagira ati: Omushaija nikyo atsigiraho ishe na nyina, akaguma n'omukazi we; nabo bombi bakahinduka omuntu omwe. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" /><note caller="-" style="x"><char style="xo" closed="false">19:6: </char><char style="xt" closed="false"><ref loc="1CO 7:10">1 Kor 7:10</ref>, <ref loc="1CO 7:11">11</ref>. </char></note> Baba batakiri babiri kureka omwe. N'ahabw'ekyo eki Ruhanga yaateeraine hamwe, omuntu atarikitaanisa. <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" /><note caller="-" style="x"><char style="xo" closed="false">19:7: </char><char style="xt" closed="false"><ref loc="DEU 24:1">Bir 24:1</ref>. </char></note> Baagaruka baamubuuza bati: Ku kiraabe kiri kityo, ahabw'enki Musa akaragiira omuntu kuha ebaruha y'okutaana, ngu abone kushenda omukazi we? <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Yaabagarukamu ati: Ahabw'obugangaazi bw'emitima yaanyu Musa nikyo yaikiririize ku mutaana n'abakazi baanyu, kwonka bwa mbere na mbere kikaba kitari kityo. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><note caller="-" style="x"><char style="xo" closed="false">19:9: </char><char style="xt" closed="false"><ref loc="LUK 16:18">Luk 16:18</ref>. </char></note> Kandi naanye nimbagambira nti: Omuntu weena orishenda omukazi we atamutuzire bushambani, akashwera ondiijo, aryaba ashambaine; kandi n'orishwera oshenzirwe nawe aryaba ashambaine.<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Abeegi be baamugira bati: Eby'omushaija n'omukazi ku biraabe nikwo biri, ti kirungi kushwera. <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" /><note caller="-" style="x"><char style="xo" closed="false">19:11: </char><char style="xt" closed="false"><ref loc="1CO 7:7">1 Kor 7:7</ref>, <ref loc="1CO 7:17">17</ref>. </char></note> Yaabagarukamu ati: Abantu abarikubaasa kwemera ekigambo ekyo ti boona, kureka abo abakihairwe. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Nimumanya ngu hariho abakonwa abaazairwe batyo okuruga omunda za baanyinabo; hariho n'abakonwa abaakonirwe abantu; kandi hariho abakonwa abaayekonire ahabw'obukama bw'omu iguru. Orikubaasa kwemera ekyo, akyemere.<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu okwakiira abaana bato</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:13-15: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:15-17">Luk 18:15-17</ref>; <ref loc="MRK 10:13-16">Mak 10:13-16</ref>. </char>
    </note> Bakamureetera abaana bato ngu abateho engaro, abashabire. Abeegi be baagambira kubi abaabareeta. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Kwonka Yesu yaabagira ati: Murekye abaana bato baije ahariinye, mutabazibira; ahabw'okuba obukama bw'omu iguru n'obw'abari nk'aba. <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Yaabataho engaro, yaarugayo.<verse eid="MAT 19:15" /></para>
  <para style="s1">Eby'omutsigazi omutungi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:16-30: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:18-30">Luk 18:18-30</ref>; <ref loc="MRK 10:17-31">Mak 10:17-31</ref>. </char>
    </note> Kandi hakaija omuntu, yaamubuuza ati: Mwegyesa, nkaakora kirungi ki okutunga amagara agatahwaho? <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" /><note caller="-" style="x"><char style="xo" closed="false">19:17: </char><char style="xt" closed="false"><ref loc="LUK 10:26-28">Luk 10:26-28</ref>. </char></note> Yaamugarukamu ati: Nombuuriza ki aha kirungi? Omurungi n'omwe. Ku oraabe nooyenda kutaaha omu magara, oyorobere ebiragiro. <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Onu yaamubuuza ati: Nibiiha? Yesu ati: Otariita, Otarishambana, Otariiba, Otaribeiherera abandi; <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><note caller="-" style="x"><char style="xo" closed="false">19:19: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref>. </char></note> Otiine sho na nyoko; kandi Okunde mutaahi waawe, nk'oku oyekunda. <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Omutsigazi ogwo yaamugarukamu ati: Ebyo byona nkabyorobera; ekindi ekimbuzireho niki? <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" /><note caller="-" style="x"><char style="xo" closed="false">19:21: </char><char style="xt" closed="false"><ref loc="LUK 12:33">Luk 12:33</ref>. </char></note> Yesu yaamugarukamu ati: Ku oraabe nooyenda kuba ohikire, gyenda otunde ebi oine byona; ebi oraihemu, obihe abooro; naiwe oryatunga eitungo omu iguru; haza oije onkuratire. <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" /><note caller="-" style="x"><char style="xo" closed="false">19:22: </char><char style="xt" closed="false"><ref loc="PSA 62:10">Zab 62:10</ref>. </char></note> Omutsigazi ku yaahuriire ekigambo ekyo, yaagyenda aine enaku nyingi, ahabw'okuba akaba aine eitungo ringi.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yesu yaagambira abeegi be ati: Buzimazima nimbagambira nti: Kigumire omutungi okutaaha omu bukama bw'omu iguru. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Kandi nimbagambira nti: Nikirahuka engamira kuraba omu nyindo y'empitirizo, okukira omutungi kutaaha omu bukama bwa Ruhanga. <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Abeegi be, ku baakihuriire, baatangaara munonga, baamubuuza bati: Mbwenu shi hoona, n'oha orikubaasa kujunwa? <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" /><note caller="-" style="x"><char style="xo" closed="false">19:26: </char><char style="xt" closed="false"><ref loc="GEN 18:14">Kut 18:14</ref>. </char></note> Yesu yaabareeba, yaabagarukamu ati: Ekyo tikirikubaasika ha bantu; kwonka ahari Ruhanga byona nibibaasika.<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Petero nikwo kumugambira ati: Reeba itwe tukatsigaho byona, twakukuratira. Mbwenu turyatunga ki? <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" /><note caller="-" style="x"><char style="xo" closed="false">19:28: </char><char style="xt" closed="false"><ref loc="LUK 22:30">Luk 22:30</ref>. </char></note> Yesu yaabagarukamu ati: Buzimazima nimbagambira nti: Omu bunaku obu ebintu birihindukiramu bisya, Omwana w'omuntu ku arishutama aha kitebe ky'ekitiinisa kye, imwe abankuratiire muryashutama aha bitebe ikumi na bibiri, mucwere enganda za Israeli eikumi na ibiri emanja. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" /><note caller="-" style="x"><char style="xo" closed="false">19:29: </char><char style="xt" closed="false"><ref loc="HEB 10:34">Heb 10:34</ref>. </char></note> Omuntu weena owaatsigireho amaju, beene ishe, banyaanya, ishe, nyina, abaana nari ebibanja ahabw'eiziina ryangye, aryaheebwa nk'ebyo emirundi igana, kandi ahungure amagara agatahwaho.<verse eid="MAT 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 19:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:30: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:30">Luk 13:30</ref>. </char>
    </note> Kwonka baingi ab'okubanza baryaba ab'enyima, kandi ab'enyima baryaba ab'okubanza.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Enfumu y'abahingiire edenaari</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Ahakuba obukama bw'omu iguru nibushusha nk'omushaija nyineeka, owaimukire kare omu kasheeshe kugurira ab'okuhinga omu musiri gwe gw'emizaabibu. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ku yaaherize kuragaana nabo edenaari emwe ahabw'eizooba rimwe, yaaboohereza omu musiri gwe gw'emizaabibu. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Aha shaaha ya kashatu yaashohora, yaareeba abandi beemereire omu katare, bataine ki barikukora; <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />yaabagambira ati: Naimwe mugyende omu musiri gw'emizaabibu, niinyija kubaha ekibashemereire. Baagyenda. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Yaayongyera yaashohora aha shaaha ya mukaaga n'aha ya mwenda, naatwaza atyo. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Haihi n'eshaaha ya ikumi n'emwe yaashohora, yaashanga abandi beemereire, yaababuuza ati: N'enki ekibeemereize aho eizooba ryona, mutaine ki murikukora? <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Baamugarukamu bati: Ahabw'okuba tihaine owaatuha omurimo. Yaabagira ati: Naimwe mwirooko muze omu musiri gw'emizaabibu. <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Ku bwaizire, mukama w'omusiri gw'emizaabibu yaagira omunyampara we ati: Yeta abakozi, obahe ebihembo byabo, obandize aha ba bwanyima, okuhitsya aha baabanza. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Abaatandikire eshaaha ya ikumi n'emwe ku baizire, baihurwa edenaari emwe buri omwe. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Kandi abaabandize ku baizire, baagira ngu nibaija kwihurwa okukiraho; kwonka nabo baihurwa edenaari emwe buri omwe. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ku baagihairwe, baayetomboitera nyineeka, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />nibagira bati: Aba aba bwanyima baakora eshaaha emwe yonka, mbwenu waabainganisa naitwe abaahendeka eizooba ryona, tukaitwa omushana? <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />We yaagarukamu, naagira omwe aharibo ati: Mugyenzi wangye, tiinyine ki naakushaagiza. Torikumanya ku twaragaana edenaari emwe? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Twara eyaawe, ogyende; n'owa bwanyima naasiima kumuha nkaimwe. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" /><note caller="-" style="x"><char style="xo" closed="false">20:15: </char><char style="xt" closed="false"><ref loc="ROM 9:21">Rom 9:21</ref>. </char></note> Hariho ekirikunzibira kutwaza ebyangye nk'oku ndikwenda? Nonteera ekitsyori ahabw'obufura bwangye? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Nikwo aba bwanyima bariba ab'okubanza, n'ab'okubanza bakaba aba bwanyima.<verse eid="MAT 20:16" /></para>
  <para style="s1">Yesu okugamba eby'okufa kwe</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:17-19: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:31-33">Luk 18:31-33</ref>; <ref loc="MRK 10:32-34">Mak 10:32-34</ref>. </char>
    </note> Yesu ku yaabaire nainamuka Yerusaalemu, yaatwara abeegi be ikumi na babiri, yaabakiika aha rubaju; omu muhanda nibakigyenda yaabagambira ati: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" /><note caller="-" style="x"><char style="xo" closed="false">20:18: </char><char style="xt" closed="false"><ref loc="MAT 16:21">Mat 16:21</ref>. </char></note> Reeba, nitwinamuka Yerusaalemu; Omwana w'omuntu naija kuheebwayo aha banyamurwa abakuru n'abahandiiki; nabo bamucwere orubanja rw'okumwita; <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />kandi bamuheyo aha banyamahanga kumushungisa, n'okumwasha, n'okumubamba aha musharaba; kandi aha kiro kya kashatu aryazooka.<verse eid="MAT 20:19" /></para>
  <para style="s1">Obukuru omu bukama bwa Ruhanga</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:20-28: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 10:35-45">Mak 10:35-45</ref>. </char>
    </note> Bwanyima nyina wa beene Zebedaayo yaija ahari Yesu n'abatabani, yaamutsimbira amaju, aine eki arikwenda kumushaba. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" /><note caller="-" style="x"><char style="xo" closed="false">20:21: </char><char style="xt" closed="false"><ref loc="MAT 19:28">Mat 19:28</ref>. </char></note> Yaamubuuza ati: Nooyenda ki? Yaamugarukamu ati: Ragiira batabani bangye bombi bashutame omwe aha rubaju rwawe rwa buryo n'ondi aha rwa bumosho omu bukama bwawe.<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:22: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">Luk 12:50</ref>; <ref loc="MAT 26:39">Mat 26:39</ref>. </char>
    </note> Kwonka Yesu yaagarukamu ati: Timurikumanya ki murikushaba. Nimubaasa kunywa aha kikopo eki ndaije kunywaho? Baamugarukamu bati: Eego, nitubaasa. <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Yaabagira ati: Ekikopo kyangye kyo muryakinywaho buzima; kwonka okunshutama aha rubaju rwa buryo, nari shi orwa bumosho, tiinye nkuha, kureka kuryaheebwa abo, abu Tata yaakucumiire. <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" /><note caller="-" style="x"><char style="xo" closed="false">20:24: </char><char style="xt" closed="false"><ref loc="LUK 22:24-26">Luk 22:24-26</ref>. </char></note> Kandi eikumi, ku baabihuriire, baagwerwa kubi enyineemwe ezo zombi. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu yaabeeta, yaabagira ati: Nimumanya abakuru b'abanyamahanga ku babategyekyesa eikama, n'abakuru baabo bakabaragiiza obushoboorozi; <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><note caller="-" style="x"><char style="xo" closed="false">20:26: </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mat 23:11</ref>. </char></note> kwonka omuriimwe tikwo kiriba; weena orikwenda kuba mukuru omuriimwe, ashemereire kuba omuheereza waanyu; <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />n'orikwenda kuba ow'okubanza omuriimwe ashemereire kuba omuhuuku waanyu; <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" /><note caller="-" style="x"><char style="xo" closed="false">20:28: </char><char style="xt" closed="false"><ref loc="PHP 2:7">Fil 2:7</ref>; <ref loc="1TI 2:6">1 Tim 2:6</ref>. </char></note> nk'Omwana w'omuntu oku ataizire kuheerezibwa, kureka okuheereza abandi, n'okuhayo amagara ge okucungura baingi.<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu okuhumuura empumi ibiri</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:29-34: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:35-43">Luk 18:35-43</ref>; <ref loc="MRK 10:46-52">Mak 10:46-52</ref>. </char>
    </note> Ku baabaire nibashohora omuri Yeriko, omutwe muhango gw'abantu gwamukuratira. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Kandi empumi ibiri zikaba zishutami aha rubaju rw'omuhanda. Ku zaahuriire ngu Yesu naahingura, zaayeta nizigira ziti: Mukama waitu, Mwana wa Daudi, otugirire embabazi! <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Ab'omu mutwe baaziteisa ngu zicureere; <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />kwonka zo zaagumizamu nizeeta munonga ziti: Mukama waitu, Mwana wa Daudi, otugirire embabazi! <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Yesu nikwo kwemerera, akazeeta, akazibuuza ati: Nimwenda ngu mbakorere ki? <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Zikamugarukamu ziti: Mukama waitu, nitwenda ngu amaisho gaitu gahumuukye. <verse eid="MAT 20:34" /><verse number="35" style="v" sid="MAT 20:35" />Yesu yaazigirira embabazi, yaakora aha maisho gaazo; ahonaaho zaahumuuka, zaamukuratira.<verse eid="MAT 20:35" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Yesu okutaaha n'ekitiinisa omuri Yerusaalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:1-11: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:29-38">Luk 19:29-38</ref>; <ref loc="MRK 11:1-10">Mak 11:1-10</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>. </char>
    </note> Kandi ku bairiire haihi na Yerusaalemu, baahika Besifaage omu kibungo kya Zeituuni; Yesu yaatuma abeegi be babiri, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />yaabagira ati: Mugyende omu kirorero ekibari omu maisho; ahonaaho nimwija kushangamu endogoya etsibikire n'omwana gwayo; muzitsibure, muzindeetere. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Omuntu weena ku araababuuze, mumugarukyemu muti: Mukama waitu naazenda. Ahonaaho mukama waazo naija kuzoohereza. <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Eki kikabaho okuhikiiriza ekyagambirwe nabi ati:<verse eid="MAT 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 21:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:5: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 9:9">Zek 9:9</ref>. </char>
    </note> Mugambire Saayuuni muti:</para>
  <para style="q1" vid="MAT 21:5">Reeba, Mukama waawe naija ah'ori,</para>
  <para style="q1" vid="MAT 21:5">Omucureezi, atembire endogoya,</para>
  <para style="q1" vid="MAT 21:5">Endogoya nto, omwana gw'endogoya.<verse eid="MAT 21:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 21:6" />Abeegi be baagyenda, baakora nk'oku Yesu yaabaragiira, <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />baareeta endogoya n'omwana gwayo, baazaaraho ebijwaro byabo; yaabishutamaho. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Abaingi baayarira ebijwaro byabo omu nguuto, abandi baatema amababi g'ebiti, baagariira omu nguuto. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Abaamushendekyereize bamwebembeire, n'abandi bamuri enyima nibagyenda nibeeshongora n'eiraka rihango, nibagira bati: Hosana aha Mwana wa Daudi! Orikwija omu iziina rya Mukama asiimwe! Hosana ahaiguru ya byona! <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />Ku yaataahire Yerusaalemu, orurembo rwona rwajagarara, abantu baabuuzana bati: Ogu n'oha? <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Abaizire nawe baagarukamu bati: Ni nabi Yesu owaarugire Nazareesi eya Galilaaya.<verse eid="MAT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:12-22: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="MRK 11:11-24">Mak 11:11-24</ref>; <ref loc="JHN 2:14-16">Yoh 2:14-16</ref>. </char>
    </note> Yesu yaataaha omuri hekalu ya Ruhanga, yaagibingamu boona abaabaire nibatunda, n'abaabaire nibagura, yaajumika emeeza z'abarikuhingisa empiiha, n'ebitebe by'abaabaire nibatunda enkombe; <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" /><note caller="-" style="x"><char style="xo" closed="false">21:13: </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Yer 7:11</ref>. </char></note> yaabagira ati: Kikahandiikwa ngu, Enju yangye eryayetwa enju y'okushabiramu; mbwenu imwe mugihindwire nk'enyanga y'abambuzi. <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Kandi empumi n'abarikucumbagira baija baamushanga omuri hekalu, yaabakiza. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Abanyamurwa abakuru n'abahandiiki ku baareebire eby'okutangaaza ebi yaakozire, baahurira n'abaana nibeeshongorera omuri hekalu bati: Hosana aha Mwana wa Daudi, baguubwa kubi munonga; <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" /><note caller="-" style="x"><char style="xo" closed="false">21:16: </char><char style="xt" closed="false"><ref loc="PSA 8:2">Zab 8:2</ref>. </char></note> baamugira bati: Beitu ohuriire ebi aba barikugamba? Yesu yaabagarukamu ati: Eego! Imwe timukashomaga ngu,</para>
  <para style="q1" vid="MAT 21:16">Omu kanwa k'abaana bato n'abarikwonka</para>
  <para style="q1" vid="MAT 21:16">Okatamu okuhimbisa okuhikire?<verse eid="MAT 21:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 21:17" />Yaabatsigaho, yaashohora omu rurembo, yaataaha Besania, yaaraarayo.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu okukyeena omuti</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Omu kasheeshe ku yaabaire naagaruka omu rurembo, yaagira enjara. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" /><note caller="-" style="x"><char style="xo" closed="false">21:19: </char><char style="xt" closed="false"><ref loc="LUK 13:6">Luk 13:6</ref>. </char></note> Ku yaareebire omutiini aha rubaju rw'omuhanda, yaaguhikaho, tiyaagushangaho kantu kureka omubengyeyo gw'amababi. Yaagugira ati: Otaryana ebyana ebiro byona. Ahonaaho omutiini gwayoma. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Abeegi ku baakireebire, baatangaara nibagira bati: Omutiini gwarahuka guta kwoma? <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" /><note caller="-" style="x"><char style="xo" closed="false">21:21: </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>. </char></note> Yesu yaabagarukamu ati: Buzimazima nimbagambira nti: KU murigira okwikiriza, mutarikubanganisa, timurikora eki ekyakorwa aha mutiini ogwo kyonka; nangwa n'obu muriragiira orushozi oru muti, Tsinduka onagwe omu nyanja, nikwo kiriba kityo. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Byona ebi muryenda omu kushaba kwanyu, mwabishaba mwine okwikiriza, muryabiheebwa.<verse eid="MAT 21:22" /></para>
  <para style="s1">Yesu okubuuzibwa ahu yaihire obushoboorozi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:23-27: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:1-8">Luk 20:1-8</ref>; <ref loc="MRK 11:27-33">Mak 11:27-33</ref>. </char>
    </note> Ku yaataahire omuri hekalu, abanyamurwa abakuru n'abakuru b'abantu baija ahu yaabaire naayegyeseza, baamubuuza bati: Ni bushoboorozi ki oburikukukoresa ebi, kandi n'oha owaabukuhaire? <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesu yaabagarukamu ati: Reka naanye mbabuuze ekigambo kimwe; ku murangarukyemu, naanye niinyija kubashobororera obushoboorozi obunkoresa ebi. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Okubatiza kwa Yohaana kukaruga nkahi? Omu iguru nari omu bantu? Baayegarukanamu bonka, nibagira bati: Ku turaagire tuti, Kukaruga omu iguru, naatugarukamu ati, Kandi shi, n'enki ekyabazibiire kumwikiriza? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" /><note caller="-" style="x"><char style="xo" closed="false">21:26: </char><char style="xt" closed="false"><ref loc="MAT 14:5">Mat 14:5</ref>. </char></note> Kandi tukaagizire tuti, Kukaruga omu bantu, nitutiina abantu; ahabw'okuba boona nibahamya ku Yohaana yaabaire ari nabi. <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Baamugarukamu bati: Titurikuhamanya. Yesu nikwo kubagira ati: Naanye tindikubagambira bushoborozi oburikunkoresa ebi.<verse eid="MAT 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Mbwenu nimuteekateeka muta ahari ebyo? Omushaija akaba aine abatabani babiri; yaaragiira ow'omujigaijo ati: Mwana wangye, irooko okore omu musiri gwangye ogw'emizaabibu eri izooba. <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" /><note caller="-" style="x"><char style="xo" closed="false">21:29: </char><char style="xt" closed="false"><ref loc="MAT 7:21">Mat 7:21</ref>. </char></note> Yaayanga ati: Tindikuzayo; kwonka bwanyima yaayeteisa, yaazayo. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Yaaza aha murumuna, nawe yaamuragiira nk'ebyo; yaamwikiriza ati: Eego Taata, ka ngyende; kwonka tiyaazayo. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" /><note caller="-" style="x"><char style="xo" closed="false">21:31: </char><char style="xt" closed="false"><ref loc="LUK 18:14">Luk 18:14</ref>. </char></note> Ahari abo bombi n'oha owaakozire eki ishe yaabaire naakunda? Banu bati: Ow'omujigaijo. Yesu yaabagira ati: Buzimazima nimbagambira nti: Abahooza na baamaraaya nibaija kubabandiza kutaaha omu bukama bwa Ruhanga. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Ahabw'okuba Yohaana akaija ahariimwe arabire omu muhanda gw'okuhikiirira, timwamwikiriza; kwonka abahooza na baamaraaya bakamwikiriza; naimwe, n'obu mwabireebire mutyo, bwanyima timureefurize, mukamwikiriza.<verse eid="MAT 21:32" /></para>
  <para style="s1">Enfumu y'abahingi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:33-46: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:9-19">Luk 20:9-19</ref>; <ref loc="MRK 12:1-12">Mak 12:1-12</ref>. </char>
    </note> Muhurire endiijo nfumu. Hakaba hariho omushaija nyineeka; yaabyara omusiri gw'emizaabibu, yaaguzitirira orugo, yaarimamu einyuukiro rya viinyo, yaayombekamu eirindiro, yaagutsigamu abahingi, yaataaha omu nsi endiijo.<note caller="-" style="x"><char style="xo" closed="false">21:33: </char><char style="xt" closed="false"><ref loc="MAT 25:14">Mat 25:14</ref>. </char></note> <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Mbwenu obunaku bw'okwera ku bwahikire, yaatuma abahuuku be ahari abo bahingi, ngu bamutwekyere aha byana by'emizaabibu ye. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Abahingi baakwata abo bahuuku be, omwe baamuteera, ondiijo baamwita, n'ondiijo baamuteera amabaare. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Yaagaruka yaatuma abandi bahuuku baingi okukira ab'okubanza; nabo baabatwaza batyo. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Bwanyima yaabatumaho omwana we, naagira ati: Omwana wangye baryamuha ekitiinisa. <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Kwonka abahingi ku baareebire omwana we, baagambirana bati: Ogu niwe muhunguzi; murekye tumwite, tutungye obuhunguzi bwe. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Baamukwata, baamubinga omu musiri gw'emizaabibu, baamwita. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Mbwenu mukama w'emizaabibu, ku ariija, aryagira ata abo bahingi? <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Baamugarukamu bati: Abagomi abo aryabaita kubi, n'emizaabibu ye aryagitsigamu abandi bahingi, abariguma nibamutwekyera ebyana byayo omu bunaku bwabyo.<verse eid="MAT 21:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="MAT 21:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:42: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:22">Zab 118:22</ref>, <ref loc="PSA 118:23">23</ref>; <ref loc="ACT 4:11">Byak 4:11</ref>; <ref loc="1PE 2:6-8">1 Pet 2:6-8</ref>. </char>
    </note> Yesu yaababuuza ati: Timukashomaga omu Byahandiikirwe ngu,</para>
  <para style="q1" vid="MAT 21:42">Eibaare eri abombeki baayangire</para>
  <para style="q1" vid="MAT 21:42">Niryo ryahindukire erikuru ery'obuhamizo bw'enju;</para>
  <para style="q1" vid="MAT 21:42">Ekyo kikaruga ahari Mukama,</para>
  <para style="q1" vid="MAT 21:42">Kandi n'eky'okutangaaza omu maisho gaitu.<verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Nikyo ndikubagirira nti: Obukama bwa Ruhanga buryabaakwa, buheebwe eihanga eririkwana ebyana byabwo. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Omuntu weena origwa aha ibaare eryo aryacwagurika; kwonka ou ririgwera, riryamucwa obusaasingo.<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Abanyamurwa abakuru n'Abafarisaayo, ku baahuriire enfumu ze, baamanya ku nibo arikurengyeza. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Baayenda kumukwata; kwonka baatiina abantu, ahabw'okuba abantu bakaba nibahamya ku ari nabi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Enfumu y'obugyenyi bw'omwana w'omugabe</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Kandi Yesu yaagaruka yaabacwera enfumu naagira ati: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" /><note caller="-" style="x"><char style="xo" closed="false">22:2-14: </char><char style="xt" closed="false"><ref loc="LUK 14:16-24">Luk 14:16-24</ref>. </char></note> Obukama bw'omu iguru nibushushanisibwa n'omugabe owaataahize omwana we obugyenyi bw'okushwera. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Obugyenyi ku bwahikire, yaatuma abahuuku be kweta abeetsirwe, baayanga kwija. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Yaagaruka yaatuma abandi bahuuku, yaabagira ati: Mwirooko mungirire abeetsirwe muti: Reeba nteekateekire eby'okugabura, enimi n'enyana z'ebishaju zangye ziitsirwe, byona byatebeekaine, mwije mutaahe obugyenyi. <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Kwonka tibaabitaho mutima, baayegyendera, omwe omu kibanja kye, ondiijo omu mirimo ye, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />n'abaatsigaireho baakwata abahuuku be, baabahemangura, baabaita. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Omugabe yaakwatwa ekiniga, yaayohereza engabo ze, yaahwerekyereza abaitsi abo, yaayotsya orurembo rwabo. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Bwanyima yaagira abahuuku be ati: Obugyenyi bwatebeekaine, kwonka abeetsirwe tibabushemereire. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Mbwenu mugyende ahu emihanda y'omu rurembo erikuteeranira; abu muraareebeyo boona mubeete baije bataahe obugyenyi. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />N'abahuuku abo baaza omuri egyo mihanda, baayeta boona abu baareebire, ababi n'abarungi; enju yaijura abagyenyi.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Omugabe ku yaizire kureeba abagyenyi, yaashangamu omushaija otajwaire kijwaro ky'obugyenyi. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Yaamubuuza ati: Mugyenzi wangye, waija ota aha otajwaire kijwaro ky'obugyenyi. Yaabura eky'okumugarukamu. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="-" style="x"><char style="xo" closed="false">22:13: </char><char style="xt" closed="false"><ref loc="MAT 8:12">Mat 8:12</ref>. </char></note> Omugabe nikwo kuragiira abambari be ati: Mumubohe emikono n'amaguru, mumunagye aheeru omu mwirima; okwo niyo abantu bariririra, bakanena enshaya. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Ahakuba abeetwa ni baingi, kwonka abatooranwa ni bakye.<verse eid="MAT 22:14" /></para>
  <para style="s1">Abafarisaayo okumutegyesa eby'omushoro</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:15-22: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:20-26">Luk 20:20-26</ref>; <ref loc="MRK 12:13-17">Mak 12:13-17</ref>. </char>
    </note> Kandi Abafarisaayo bakagyenda, baahanuura hamwe oku baraamutegye omu kugamba kwe. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Batyo baamutumaho abeegi baabo hamwe n'aba Heroode, baamugira bati: Mwegyesa, nitumanya ku ori ow'amazima, ku oyegyesa omuhanda gwa Ruhanga omu mazima, kandi ku otagwera rubaju rw'omuntu weena orutahikire, ahakuba totiinisibwa kitiinisa ky'omuntu. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Mbwenu otugambire eki orikuteekateeka. Ebiragiro nibiikiriza kuha Kaisaari omushoro, nari tikwo? <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Kwonka Yesu ku yaamanyire obugobya bwato, yaagira ati: Nimuntegyera ki, imwe ndyarya 'mwe? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Muunyorekye empiiha ei mushora. Baamureetera edenaari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yaababuuza ati: Ekishushani eki n'ebihandiikirweho n'eby'oha? <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" /><note caller="-" style="x"><char style="xo" closed="false">22:21: </char><char style="xt" closed="false"><ref loc="ROM 13:7">Rom 13:7</ref>. </char></note> Baamugarukamu bati: N'ebya Kaisaari. Yesu yaabagira ati: Mbwenu ebya Kaisaari mubihe Kaisaari, n'ebya Ruhanga mubihe Ruhanga. <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Ku baabihuriire, baatangaara, baamurugaho, baagyenda.<verse eid="MAT 22:22" /></para>
  <para style="s1">Abasadukaayo okuhakanisa okuzooka</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:23-33: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:27-40">Luk 20:27-40</ref>; <ref loc="MRK 12:18-27">Mak 12:18-27</ref>. </char>
    </note> Aha izooba eryo Abasadukaayo, abahakana ku hatabaho kuzooka, baija ah'ari, baamubuuza bati:<note caller="-" style="x"><char style="xo" closed="false">22:23: </char><char style="xt" closed="false"><ref loc="ACT 23:6">Byak 23:6</ref>, <ref loc="ACT 23:8">8</ref>. </char></note> <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Mwegyesa, Musa akagira ati: Omuntu ku arifa atakazaire, omurumuna ashemereire kuhungura omufaakazi ogwo, amumuzaarireho abaana. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Mbwenu owaitu hakaba hariyo enyineemwe mushanju. Ow'okubanza akashwera omukazi, yaafa; ahabw'okufa atakazaire, omukazi we yaamuraga owa kabiri. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Nikwo batyo owa kabiri n'owa kashatu, okuhika aha wa mushanju. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Boona ku baahweireho, omukazi nawe yaafa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Mbwenu omu kuzooka aryaba muka oha ahari abo mushanju? Ahabw'okuba boona omushanju akabaho omukazi waabo. <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Yesu yaabagarukamu naabagira ati: Muhabire, ahabw'okutamanya Ebyahandiikirwe n'obu gaakuba amaani ga Ruhanga. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Mumanye ngu omu kuzooka tibarishwera, kandi tibarishwerwa, kureka baryaba nka baamaraika b'omu iguru. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ebirikukwata aha by'okuzooka kw'abafu, timukashomaga eki Ruhanga yaabagambiire ati: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><note caller="-" style="x"><char style="xo" closed="false">22:32: </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kur 3:6</ref>. </char></note> Nyowe ndi Ruhanga wa Abrahamu, Ruhanga wa Isaaka, kandi Ruhanga wa Yakobo? Ti Ruhanga w'abafu, kureka Ow'abahuriire. <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Abantu ku bakihuriire, baatangaarira okwegyesa kwe.<verse eid="MAT 22:33" /></para>
  <para style="s1">Ekiragiro ekirikukira ebindi</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:34-40: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Luk 10:25-28</ref>; <ref loc="MRK 12:28-31">Mak 12:28-31</ref>. </char>
    </note> Abafarisaayo ku baahuriire oku aremeise Abasadukaayo bakahunama, baateerana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Omwe aharibo, omwegyesa w'Ebiragiro, yaamubuuza naamutega ati: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />Mwegyesa, ekiragiro ekikuru omu biragiro nikiiha? <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" /><note caller="-" style="x"><char style="xo" closed="false">22:37: </char><char style="xt" closed="false"><ref loc="DEU 6:5">Bir 6:5</ref>. </char></note> Yaamugarukamu ati: Kunda Mukama Ruhanga waawe n'omutima gwawe gwona, n'amagara gaawe goona, n'obwengye bwawe bwona. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Eki nikyo kiragiro kikuru kandi eky'okubanza. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" /><note caller="-" style="x"><char style="xo" closed="false">22:39: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref>. </char></note> Ekya kabiri ekirikukishusha n'eki, Kunda mutaahi waawe nk'oku oyekunda. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><note caller="-" style="x"><char style="xo" closed="false">22:40: </char><char style="xt" closed="false"><ref loc="ROM 13:10">Rom 13:10</ref>; <ref loc="GAL 5:14">Gal 5:14</ref>. </char></note> Omu biragiro ebi byombi Ebiragiro byona n'ebya Baanabi nimwo bikomooka.<verse eid="MAT 22:40" /></para>
  <para style="s1">Omwana wa Daudi</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:41-46: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 20:41-44">Luk 20:41-44</ref>; <ref loc="MRK 12:35-37">Mak 12:35-37</ref>. </char>
    </note> Abafarisaayo ku baabaire bakiteeraine hamwe, Yesu yaababuuza ati: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />Kristo nimumuteekateekaho muta? N'Omwana w'oha? Baamugarukamu bati: N'Omwana wa Daudi. <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Yaagaruka yaababuuza ati: Kandi shi ahanki Daudi, obu yaagambisibwa Omwoyo Orikwera, akamweta Mukama we ati:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:44: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:64">Mat 26:64</ref>; <ref loc="PSA 110:1">Zab 110:1</ref>. </char>
    </note> Mukama akagira Mukama wangye ati:</para>
  <para style="q1" vid="MAT 22:44">Shutama aha rubaju rwangye rwa buryo,</para>
  <para style="q1" vid="MAT 22:44">Okuhitsya obu ndita abazigu baawe ahansi y'ebigyere byawe.<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Beitu shi, Daudi ku araabe yaayetsire Kristo Mukama we, kandi Kristo ogwo naabaasa ata kuba Omwana we? <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Kandi tihariho n'omwe owaabaasize kumugarukamu ekigambo; n'okuruga aha kiro ekyo tihaine waayehangire kumubuuza ebindi bibuuzo.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesu okugamba aha migyenzo y'Abafarisaayo</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:1-39: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 11:39-52">Luk 11:39-52</ref>; <ref loc="MRK 12:38-40">Mak 12:38-40</ref>. </char>
    </note> Kandi Yesu akagaruka yaagira emitwe y'abantu n'abeegi be ati: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />Abahandiiki n'Abafarisaayo bashutama aha kitebe kya Musa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" /><note caller="-" style="x"><char style="xo" closed="false">23:3: </char><char style="xt" closed="false"><ref loc="MAL 2:7">Mal 2:7</ref>, <ref loc="MAL 2:8">8</ref>. </char></note> N'ahabw'ekyo ebi babaragiira byona, mubikore, kandi mubihitsye; kwonka mutarikora nk'oku bakora; ahabw'okuba bagamba, kwonka tibakora. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Bakoma emitwaro erikuremeera, etarikubaasa kwekorerwa, bagyekoreza abantu aha mabega; kwonka bo tibenda kugitenzyaho n'orukumu rwabo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" /><note caller="-" style="x"><char style="xo" closed="false">23:5: </char><char style="xt" closed="false"><ref loc="MAT 6:1">Mat 6:1</ref>; <ref loc="NUM 15:38">Kub 15:38</ref>, <ref loc="NUM 15:39">39</ref>. </char></note> Ebi bakora byona babikora kureebwa abantu; bahangutsya <note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">Fulakateeri n'akantu akakozirwe omu ruhu, aku batamu ebigambo bikuru bikye eby'omu Biragiro, akajwarwa aha buso n'aha mukono gwa bumosho. </char></note>fulakateeri zaabo, baraisya ebijwengye by'emyenda yaabo; <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" /><note caller="-" style="x"><char style="xo" closed="false">23:6: </char><char style="xt" closed="false"><ref loc="LUK 14:7">Luk 14:7</ref>; <ref loc="MAT 6:5">Mat 6:5</ref>. </char></note> bakunda emyanya y'ekitiinisa omu magyenyi, n'ebitebe by'ekitiinisa omuri sinagogi, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />n'okutangirirwa omu katare, n'okwetwa abantu Rabi. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Kwonka imwe mutaryetwa Rabi, ahabw'okuba Omwegyesa waanyu n'omwe, kandi naimwe mwena muri eishe-emwe. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kandi mutaryeta omuntu weena ow'omu nsi Shoimwe; ahabw'okuba mwine Shoimwe omwe ori omu iguru. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kandi mutaryetwa abakama, ahabw'okuba mwine Omukama omwe, niwe Kristo. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Orikukira obukuru omuriimwe aryaba omuheereza waanyu; <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><note caller="-" style="x"><char style="xo" closed="false">23:12: </char><char style="xt" closed="false"><ref loc="PRO 29:23">Enf 29:23</ref>; <ref loc="EZK 21:26">Ezk 21:26</ref>; <ref loc="1PE 5:5">1 Pet 5:5</ref>. </char></note> orikwetunguura aryagarurwa ahansi; kandi orikwegarura ahansi, aryatunguurwa.<verse eid="MAT 23:12" /></para>
  <para style="s1">Yesu okuhana Abafarisaayo</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Kwonka muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba mukinga obukama bw'omu iguru, ngu abantu batabutaahamu; imwe mwenka timubutaahamu, kandi abarikwenda kubutaahamu, timubaikiriza. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya; ahabw'okuba munyaga enju z'abafaakazi, kandi murandagatana omu kushaba, haza kunu nimuryarya; n'ahabw'ekyo muryacwerwa orubanja orurikukira obuhango. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Muryakareeba, imwe Abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba mwambuka enyanja, mugyendagyenda n'omu mahanga kuhindura omuntu omwe, ngu aikirize ediini yaanyu; kandi ku mumubona, mumuhindura omwana wa Gehena okukira imwe kabiri.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:16: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 15:14">Mat 15:14</ref>. </char>
    </note> Muryakareeba, imwe abeebembezi empumi, abagira ngu, Orikurahira hekalu, ti rubanja; kwonka ngu Orikurahira ezaabu y'omuri hekalu, ashemereire kuhikiiriza eki yaarahiire kukora. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Imwe bashema 'mwe kandi empumi! Ekirikukira obukuru n'enki, n'ezaabu, nari ni hekalu erikweza ezaabu? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Kandi nimugira ngu, Orikurahira eitambiro, ti rubanja; kureka ngu Orikurahira empongano eri aha itambiro, ashemereire kuhikiiriza eki yaarahiire kukora. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Imwe mpumi 'mwe! Ekirikukira obukuru n'enki, n'empongano, nari n'eitambiro eririkweza empongano? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Mumanye ngu orikurahira eitambiro, biri arirahiire n'ebiririho byona; <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />kandi orikurahira hekalu biri agirahiire n'Ogwo ogituuramu. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><note caller="-" style="x"><char style="xo" closed="false">23:22: </char><char style="xt" closed="false"><ref loc="MAT 5:34">Mat 5:34</ref>. </char></note> N'orikurahira eiguru, biri arahiire ekitebe kya Ruhanga n'Ogwo okishutamaho.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:23: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 6:6-8">Mik 6:6-8</ref>. </char>
    </note> Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba muganura kimwe kya ikumi ky'eshogi, na anisi, na kumino; kwonka mutsigaho ebigambo bikuru eby'omu Biragiro, okucwa emanja ez'amazima, n'embabazi, n'okwikiriza; ebyo mukaashemereire kubikora, kandi na biri okutabireka. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Imwe abeebembezi empumi, abagyegyena omubu, mukamira engamira!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:25: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 7:4">Mak 7:4</ref>. </char>
    </note> Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba enkyeka n'enyabya mubyozya aharuguru, haza omunda biijwire obunyagi n'okuteerinda. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Iwe Omufarisaayo empumi, banza oyozye omunda y'enkyeka n'orwabya, aharuguru yaabyo habone kushemera. <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba nimushusha nk'ebituuro ebisiigire einoni; aharuguru bikareebeka nk'ebishemeire, haza omunda biijwire amagufa n'oburofa bwona. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nikwo naimwe omu by'aharuguru mureebeka nka'abahikiriire omu maisho g'abantu, kwonka omunda mwijwire oburyarya n'obugomi.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Muryakareeba, imwe abahandiiki n'Abafarisaayo, endyarya! Ahabw'okuba mwombeka ebituuro bya baanabi, musharura ebiijutsyo by'abahikiriire, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />nimugira ngu, Kuri twabaire turiho omu biro bya baatatenkuriitwe, titwakukwataniise nabo omu kusheesha eshagama ya baanabi. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" /><note caller="-" style="x"><char style="xo" closed="false">23:31: </char><char style="xt" closed="false"><ref loc="ACT 7:52">Byak 7:52</ref>. </char></note> Okwo nikwo mweshinja ku muri abaana b'abo abaitsire baanabi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Mbwenu nu nimwijuze orugyero rwa baashwenkuriimwe. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Imwe enjoka kandi abaana b'encwera, muryakira muta orubanja rwa Gehena? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" /><note caller="-" style="x"><char style="xo" closed="false">23:34: </char><char style="xt" closed="false"><ref loc="1TH 2:15">1 Tes 2:15</ref>. </char></note> N'ahabw'ekyo niinyija kubatumaho baanabi n'abanyabwengye n'abahandiiki; abamwe aharibo muryabaita, abandi muryababamba, n'abandi muryabateerera omuri sinagogi zaanyu; muryabahiiga, mubabingye omuri tauni zoona ezi barihungiramu, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" /><note caller="-" style="x"><char style="xo" closed="false">23:35: </char><char style="xt" closed="false"><ref loc="GEN 4:8">Kut 4:8</ref>; <ref loc="2CH 24:20">2 Bus 24:20</ref>, <ref loc="2CH 24:21">21</ref>. </char></note> ngu mubone kutukurirwa eshagama y'abarikwera yoona eyaaseesirwe omu nsi, okwiha aha shagama ya Abeeli ohikiriire okuhitsya aha shagama ya Zakaria mwene Barakia, ou mwaitiire ahagati ya hekalu n'eitambiro. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Buzimazima nimbagambira nti: Ebyo byona biryahika aha bantu b'obusingye obu.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:37: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:34">Luk 13:34</ref>, <ref loc="LUK 13:35">35</ref>. </char>
    </note> Yerusaalemu, Yerusaalemu, oita baanabi, okateera abarikukutumwaho amabaare! Ka ni kaingi abaana baawe, nk'oku enkoko ebumbatira abaana baayo omunda y'amapapa gaayo, haza mutankundire! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Reeba, enju yaanyu etsigirweho n'omushaka. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" /><note caller="-" style="x"><char style="xo" closed="false">23:39: </char><char style="xt" closed="false"><ref loc="PSA 118:26">Zab 118:26</ref>. </char></note> Nimbagambira nti: Timurindeeba okuruga hati okuhitsya obu murigira muti: Orikwija omu iziina rya Mukama asiimwe!<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Ebirikumanyisa okucwekyerera kwa Yerusaalemu, n'okugaruka kwa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:1-51: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 21:5-36">Luk 21:5-36</ref>; <ref loc="MRK 13:1-37">Mak 13:1-37</ref>. </char>
    </note> Yesu yaashohora omuri hekalu; ku yaabaire naagyenda, abeegi be baija kumworeka ebyombeko bya hekalu. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />We yaabagarukamu, naagira ati: Timurikureeba ebi byona? Buzimazima nimbagambira nti: Tihariho ibaare eriritsigara riri aha rindi eritarinagwa ahansi.<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Ku yaabaire ashutami omu kibungo kya Zeituuni, abeegi be baija ah'ari omu mubonano, baamubuuza bati: Tugambire ebi ahu biribeeraho, n'akamanyiso k'okwija kwawe oku kariba, n'ak'obunaku obu ensi egi erihweraho. <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Yesu yaabagarukamu ati: Mwerinde, omuntu weena ataribahabisa; <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" /><note caller="-" style="x"><char style="xo" closed="false">24:5: </char><char style="xt" closed="false"><ref loc="ACT 5:36">Byak 5:36</ref>, <ref loc="ACT 5:37">37</ref>; <ref loc="1JN 2:18">1 Yoh 2:18</ref>. </char></note> ahabw'okuba baingi baryaija omu iziina ryangye, nibagira bati: Niinye Kristo! Kandi baryahabisa baingi. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Kandi muryahurira engamba n'okurangaanwa kwazo; mwerinde, mutaryemereza emitima, ahakuba ebyo byona tibiribura kwija; kwonka emperu yo eryaba etakahikire. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" /><note caller="-" style="x"><char style="xo" closed="false">24:7: </char><char style="xt" closed="false"><ref loc="ISA 19:2">Isa 19:2</ref>. </char></note> Eihanga riryateera erindi ihanga, n'obugabe buryateera obundi bugabe; haryabaho enjara n'emitsitsa omu myanya mingi. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ebyo byona niyo ntandikiro y'obusaasi.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:9: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">Mat 10:22</ref>; <ref loc="JHN 16:2">Yoh 16:2</ref>. </char>
    </note> Obwo baryabahayo okubonabonesibwa n'okwitwa; muryayangwa amahanga goona ahabw'eiziina ryangye. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Omu biro ebyo baingi baryagwa, bareebyane, bangane. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" /><note caller="-" style="x"><char style="xo" closed="false">24:11: </char><char style="xt" closed="false"><ref loc="1JN 4:1">1 Yoh 4:1</ref>. </char></note> Haryaimuka baanabi baingi b'ebishuba, bahabise baingi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" /><note caller="-" style="x"><char style="xo" closed="false">24:12: </char><char style="xt" closed="false"><ref loc="2TI 3:1-5">2 Tim 3:1-5</ref>. </char></note> Ahabw'obugomi kukanya, okukunda kw'abaingi kuryahora. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Kwonka origumisiriza okuhitsya aha muheru, niwe arijunwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Kandi engiri egi ey'obukama eryagambwa omu nsi zoona okuba eky'okuhamya aha mahanga goona; obwo nibwo emperu erihika.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:15: </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:26">Dan 9:26</ref>, <ref loc="DAN 9:27">27</ref>; <ref loc="DAN 12:11">12:11</ref>. </char>
    </note> Kandi ku murireeba ekirikuzira ekirikuhwerekyereza, ekyagambirwe nabi Danieli, kyemereire omu Mwanya ogurikwera, (orikushoma ayetegyereze) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />abo abariba bari Buyudaaya omu bunaku obwo bahungire aha nshozi; <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><note caller="-" style="x"><char style="xo" closed="false">24:17: </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luk 17:31</ref>. </char></note> n'ori aha mutwe gw'enju ataritemburuka ngu agire ebi yaiha omu nju ye; <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />n'oriba ari omu misiri atarigarukayo kwenda ekijwaro kye. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Abariba baine enda n'abarikwontsya omu biro ebyo baryakareeba! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Mushabe okuhunga kwanyu kutaribaho omu biro by'embeho nari ahari Sabato; <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><note caller="-" style="x"><char style="xo" closed="false">24:21: </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12:1</ref>. </char></note> ahabw'okuba omu biro ebyo haryabaho okubonabona kwingi okutakabahoga okwiha aha kuhangwa kw'ensi okuhitsya hati, kandi tikuribaho. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ebiro ebyo kuri bitaracwireho, tihaakurokokireho muntu n'omwe; kwonka ahabw'entoore ebiro ebyo biryacuubwaho. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Omu biro ebyo omuntu weena ku aribagira ati: Reeba, Kristo ari aha! Nari shi, ari hariya, mutarimwikiriza; <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" /><note caller="-" style="x"><char style="xo" closed="false">24:24: </char><char style="xt" closed="false"><ref loc="2TH 2:8">2 Tes 2:8</ref>, <ref loc="2TH 2:9">9</ref>. </char></note> ahakuba haryaimukam abarikweyeta Kristo na baanabi b'ebishuba, baryakora obumanyiso bukuru n'eby'okutangaaza, babone kuhabisa n'entoore, kyaba nikibaasika. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Reeba naabibagambira bitakahikire. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />N'ahabw'ekyo ku baribagira bati: Reeba, ari omu ihamba, mutarizayo; nari ngu, ari omu kishengye, mutarikiikiriza. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Nk'oku omurabyo gurabiza oburugwa-izooba gukahika oburengyerwa-izooba, nikwo n'okwija kw'Omwana w'omuntu kuriba. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ahu omutumbi guri hoona, niho amahungu gateeranira.<verse eid="MAT 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:29: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="2PE 3:10">2 Pet 3:10</ref>. </char>
    </note> Bwanyima y'okubonabona kw'omu biro ebyo, ahonaaho eizooba riryahinduka omwirima, n'okwezi tikuryaka, n'enyonyoozi ziryaragara niziruga omu iguru biryatengyetsibwa; <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" /><note caller="-" style="x"><char style="xo" closed="false">24:30: </char><char style="xt" closed="false"><ref loc="REV 1:7">Kush 1:7</ref>; <ref loc="MAT 26:64">Mat 26:64</ref>; <ref loc="DAN 7:13">Dan 7:13</ref>, <ref loc="DAN 7:14">14</ref>; <ref loc="ZEC 12:10">Zek 12:10</ref>. </char></note> obwo akamanyiso k'Omwana w'omuntu karyareebeka omu iguru, amahanga goona ag'ensi garyacura, kandi baryareeba Omwana w'omuntu naizira omu bicu by'omu iguru, aine obushoboorozi n'ekitiinisa kingi. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" /><note caller="-" style="x"><char style="xo" closed="false">24:31: </char><char style="xt" closed="false"><ref loc="1CO 15:52">1 Kor 15:52</ref>; <ref loc="1TH 4:16">1 Tes 4:16</ref>. </char></note> Aryatuma baamaraika be n'eiraka rihango ry'enzamba, bateerane entoore ze nibazitaaruura omu mbaju ina okuruga aha muheru gw'eiguru okuhika aha gundi. <verse eid="MAT 24:31" /><verse number="32" style="v" sid="MAT 24:32" />N'ahabw'ekyo mwegyere aha mutiini nk'eky'okureeberaho; eitaagi ryagwo ku ryoroba, ryatooka amababi, mumanya ku omwaka guri haihi. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Mutyo naimwe ku murireeba ebyo byona, mumanye ku ari haihi, ku yaahikire n'aha rwigi. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Buzimazima nimbagambira nti: Obusingye obu tiburihwaho, okuhitsya obu ebi byona biribaho. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" /><note caller="-" style="x"><char style="xo" closed="false">24:35: </char><char style="xt" closed="false"><ref loc="MAT 5:18">Mat 5:18</ref>. </char></note> Eiguru n'ensi biryahwaho, kwonka ebigambo byangye tibirihwaho.<verse eid="MAT 24:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Kwonka eby'ekyo kiro n'obwo bunaku tihaine orikubimanya, n'obu baakuba baamaraika b'omu iguru, n'obu yaakuba Omwana, kureka Isheboona wenka. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" /><note caller="-" style="x"><char style="xo" closed="false">24:37: </char><char style="xt" closed="false"><ref loc="GEN 6:11-13">Kut 6:11-13</ref>. </char></note> Nk'ebiro bya Noa oku byabaire biri, nikwo n'okwija kw'Omwana w'omuntu kuriba. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" /><note caller="-" style="x"><char style="xo" closed="false">24:38: </char><char style="xt" closed="false"><ref loc="2PE 3:5">2 Pet 3:5</ref>, <ref loc="2PE 3:6">6</ref>. </char></note> Ahakuba nk'oku baabaire bari omu biro ebyo ebyabandiize omwegyemure gw'amaizi, nibarya kandi nibanywa, nibashwera, nibahingira, okuhitsya aha kiro eki Noa yaataahiireho omu bwato; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />bakaba bari aho bataine ki barikumanya, okuhitsya obu omwegyemure gw'amaizi gwaizire, gukabatwara boona; n'okwija kw'Omwana w'omuntu nikwo kuriba kutyo. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" /><note caller="-" style="x"><char style="xo" closed="false">24:40: </char><char style="xt" closed="false"><ref loc="LUK 17:35">Luk 17:35</ref>, <ref loc="LUK 17:36">36</ref>. </char></note> Obwo abashaija babiri baryaba bari omu musiri, omwe aryatwarwa, ondiijo atsigweho. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Abakazi babiri baryaba nibasa aha rubengo; omwe aryatwarwa, ondiijo atsigweho. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />N'ahabw'ekyo mugume nimureeba, ahakuba timurikumanya kiro eki Mukama waanyu ariiziraho. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><note caller="-" style="x"><char style="xo" closed="false">24:43: </char><char style="xt" closed="false"><ref loc="LUK 12:39-46">Luk 12:39-46</ref>. </char></note> Mumanye ngu, kuri nyineeka yaamanyire obunaku nyekiro obu omushuma araiziremu, akaagumire naareeba, areka kwikiriza omushuma kurima n'okutaaha omu nju ye. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />N'ahabw'ekyo naimwe mweteguure, ahabw'okuba obunaku obu mutarikuteekateeka, nibwo Omwana w'omuntu ariiziramu.<verse eid="MAT 24:44" /></para>
  <para style="s1">Enfumu y'abambari babiri, omubi n'omurungi</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Ni <note caller="+" style="f"><char style="fr" closed="false">24:45 </char><char style="ft" closed="false">Omu Rugriika n'omuhuuku. </char></note>mwambari ki ow'okwesigwa kandi ow'obwengye, ou mukama we yaatsigiire ab'omu ka ye kubagaburira omu bunaku obuhikire? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Aine omugisha omwambari ogwo, ou mukama we arigaruka akashanga naakora atyo. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" /><note caller="-" style="x"><char style="xo" closed="false">24:47: </char><char style="xt" closed="false"><ref loc="MAT 25:21">Mat 25:21</ref>, <ref loc="MAT 25:23">23</ref>. </char></note> Buzimazima nimbagambira nti: Aryamukwatsa ebi atungire byona. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" /><note caller="-" style="x"><char style="xo" closed="false">24:48: </char><char style="xt" closed="false"><ref loc="ECC 8:11">Mub 8:11</ref>. </char></note> Kwonka omwambari omubi, ku ariteekateeka omu mutima gwe ati: Mukama wangye atwireyo, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />akatandika kuteera abambari bagyenzi be, akarya kandi akanywa n'abasinzi, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />mukama w'omwambari ogwo aryaija aha izooba eri atamutegyerereizeho, n'obunaku obu atarikumanya, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />aryamutemamu habiri, amuhe omugabo gwe n'endyarya; okwo niyo abantu bariririra, bakanena enshaya.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Enfumu y'abaishiki ikumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">Luk 12:35</ref>, <ref loc="LUK 12:36">36</ref>; <ref loc="REV 19:7">Kush 19:7</ref>. </char>
    </note> Omu biro ebyo obukama bw'omu iguru buryashusha nk'abaishiki ikumi, abaatwaire etabaaza zaabo, bakaza kubugana kishwera. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Bataano aharibo bakaba bari abashema, n'abandi bataano bari ab'obwengye; <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ahakuba abashema ku baatwaire etabaaza zaabo, tibaatwara gandi majuta; <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />kwonka ab'obwengye baatwara amajuta omu cupa hamwe n'etabaaza zaabo. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Kandi kishwera ku yairiirweyo, boona baahungira, baagwejegyera. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Bwanyima nyekiro omu itumbi haabaho orwari ngu: Reeba, kishwera yaija! Mushohore tumubugane. <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Abaishiki abo baimuka, baashemeza etabaaza zaabo. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Abashema baashaba ab'obwengye bati: Mutuhe aha majuta gaanyu, ahakuba etabaaza zaitu zaaza kuraara. <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ab'obwengye baagarukamu bati: Nooshusha oti, tigarikutumarira twena; kureka mugyende ahu barikugatundira; mwegurire. <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Ku baabaire bagiire kugura, kishwera yaija; abaabaire beeteekateekire baataaha nawe, omu nju omu bugyenyi bw'okushwera; orwigi rwakingwa. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" /><note caller="-" style="x"><char style="xo" closed="false">25:11: </char><char style="xt" closed="false"><ref loc="LUK 13:25">Luk 13:25</ref>, <ref loc="LUK 13:27">27</ref>. </char></note> Bwanyima abaishiki abo abandi nabo baija, nibagira bati: Mukama waitu, Mukama waitu, twigurireho. <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />We yaabagarukamu ati: Buzimazima nimbagambira nti: Tindikubamanya. <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />N'ahabw'ekyo mugume nimureeba, ahabw'okuba timurikumanya kiro n'obu yaakuba eshaaha.<verse eid="MAT 25:13" /></para>
  <para style="s1">Enfumu y'etalanta.</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:14-30: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:12-27">Luk 19:12-27</ref>. </char>
    </note> Kandi nibushusha nk'eby'omuntu owaabaire naayenda kugyenda kuza omu nsi endiijo; ku yaabaire atakagyenzire, yaayeta <note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="ft" closed="false">Omu Rugriika n'omuhuuku. </char></note>abambari be, yaabatsigira ebintu bye. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" /><note caller="-" style="x"><char style="xo" closed="false">25:15: </char><char style="xt" closed="false"><ref loc="ROM 12:6">Rom 12:6</ref>. </char></note> Omwe yaamuha etalanta itaano, ondi ibiri, n'ondiijo emwe, nka buri omwe oku yaabaire naabaasa; yaaheza, yaagyenda. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Owaahairwe etalanta itaano ahonaaho yaagyenda, yaazishuubuza, yaashaazyamu ezindi itaano. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />N'owaahairwe ibiri nawe yaashaazyamu atyo ezindi ibiri. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Kwonka owaahairwe emwe yaagyenda, yaatimba omu itaka, yaasherekamu etalanta ya mukama we. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Ebiro bingi ku byahingwireho, mukama w'abambari abo yaagaruka, yaabara nabo ebi yaabatsigiire. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Owaahairwe etalanta itaano, yaija yaareeta ezindi itaano, yaagira ati: Mukama wangye, okantsigira etalanta itaano; reeba nshaagizemu ezindi itaano. <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" /><note caller="-" style="x"><char style="xo" closed="false">25:21: </char><char style="xt" closed="false"><ref loc="LUK 16:10">Luk 16:10</ref>. </char></note> Mukama we yaamugira ati: Kazaare, iwe omwambari omurungi orikwesigwa! Obaire omwesigwa omuri bikye, ndyakuha obushoboorozi kutegyeka bingi; taaha omu kushemererwa kwa mukama waawe. <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Owaahairwe etalanta ibiri nawe yaija, yaagira ati: Mukama wangye, okantsigira etalanta ibiri; reeba nshaagizemu ezindi ibiri. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Mukama we yaagira ati: Kazaare, iwe omwambari omurungi orikwesigwa! Obaire omwesigwa omuri bikye; ndyakuha obushoboorozi kutegyeka bingi; taaha omu kushemererwa kwa mukama waawe. <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Kandi n'ogwo owaahairwe etalanta emwe yaija, yaagira ati: Mukama wangye, nkamanya ku ori omuntu ogumire, ogyesha ahu otarabibire, kandi ohunika ebi otaraheheerize; <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />n'ahabw'ekyo nkatiina, naagyenda naashereka etalanta yaawe omu itaka. Reeba ngigi, ogigarukane. <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Mukama we nikwo kumugarukamu ati: Iwe omwambari omubi kandi omweremwa! Okamanya ku ngyesha ahu ntarabibire, nkahunika ebi ntaraheheerize. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />N'ahabw'ekyo okaba oshemereire kuha etalanta yangye ababiiki b'empiiha, naanye ku naakwizire, nkaagigaruriirwe n'enshaagi yaayo. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Mbwenu mugimwakye, mugihe oine etalanta ikumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><note caller="-" style="x"><char style="xo" closed="false">25:29: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>. </char></note> Ahakuba oine niwe ariheebwa, akagira bingi; kwonka otaine aryayakwa n'eki aine. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />N'omwambari ogwo otaine mugasho, mumunagye aheeru omu mwirima; okwo niyo abantu bariririra, bakanena enshaya.<verse eid="MAT 25:30" /></para>
  <para style="s1">Enfumu y'entaama n'embuzi</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:31: </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:11-13">Kush 20:11-13</ref>. </char>
    </note> Omwana w'omuntu ku ariizira omu kitiinisa kye hamwe na baamaraika be boona, aryashutama aha kitebe kye eky'ekitiinisa, <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" /><note caller="-" style="x"><char style="xo" closed="false">25:32: </char><char style="xt" closed="false"><ref loc="ROM 14:10">Rom 14:10</ref>. </char></note> amahanga goona gateeranirwe omu maisho ge; kandi aryagashoroora, nk'oku omuriisa ashoroora entaama omu mbuzi. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Entaama aryazita aha rubaju rwe rwa buryo, kwonka embuzi aryazita aha rwa bumosho. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Obwo Mukama aryagira ab'aha rubaju rwa buryo ati: Mwije, imwe abu Tata yaahaire omugisha, muhungure obukama obwabateekateekyeirwe okuruga aha kuhangwa kw'ensi; <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" /><note caller="-" style="x"><char style="xo" closed="false">25:35: </char><char style="xt" closed="false"><ref loc="PRO 19:17">Enf 19:17</ref>; <ref loc="HEB 2:11">Heb 2:11</ref>. </char></note> ahakuba nkaba nyine enjara, mwampa eby'okurya; nkaba nyine eiriho, mwampa eky'okunywa; nkaba ndi omugyenyi, mwankunira; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />nkaba njwaire busha, mwanjweka; nkaba ndwaire, mwaija kundeeba; nkaba ndi omu kihome, mwantaayaayira. <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Abahikiriire baryamubuuza bati: Mukama waitu, tukakureeba ryari oine enjara, tukakuha eby'okurya, nari oine eiriho tukakuha eky'okunywa? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Tukakureeba ryari ori omugyenyi tukakukunira, nari ojwaire busha tukakujweka? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Tukakureeba ryari orwaire, nari ori omu kihome tukaija kukureeba? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Mukama aryabagarukamu ati: Buzimazima nimbagambira nti: Nk'oku mwabikoreire omwe ahari beene Tata abo abato okukira abandi, biri niinye mwabikoreire.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:41: </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:10">Kush 20:10</ref>, <ref loc="REV 20:15">15</ref>. </char>
    </note> Bwanyima aryagira ab'aha rubaju rwa bumosho ati: Mundugyeho, imwe abakyeenirwe, muze omu muriro ogutaraara, ogwateekateekyeirwe Sitaane na baamaraika be; <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ahakuba nkaba nyine enjara, timwampa by'okurya; nyine eiriho, timwampa ky'okunywa; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />nkaba ndi omugyenyi, timwankunira; njwaire busha, timwanjweka; ndwaire kandi ndi omu kihome, timwaija kundeeba. <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Nabo baryamugarukamu bati: Mukama waitu, tukakureeba ryari oine enjara, nari oine eiriho, nari ori omugyenyi, nari ojwaire busha, nari orwaire, nari ori omu kihome, tukabura eki twakukorera? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Nawe aryabagarukamu ati: Nk'oku mutarabikoreire omwe ahari abo abato okukira abandi, biri naanye timurabinkoreire. <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" /><note caller="-" style="x"><char style="xo" closed="false">25:46: </char><char style="xt" closed="false"><ref loc="JHN 5:29">Yoh 5:29</ref>; <ref loc="DAN 12:2">Dan 12:2</ref>. </char></note> Abo baryaza omu kubonabonesibwa okw'ebiro n'ebiro, kwonka abahikiriire bo baryataaha omu magara agatahwaho.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Abanyamurwa okucuma enaama y'okwita Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesu ku yaaherize kugamba ebyo byona, yaagira abeegi be ati: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><note caller="-" style="x"><char style="xo" closed="false">26:2-5: </char><char style="xt" closed="false"><ref loc="LUK 22:1">Luk 22:1</ref>, <ref loc="LUK 22:2">2</ref>; <ref loc="MRK 14:1">Mak 14:1</ref>, <ref loc="MRK 14:2">2</ref>. </char></note> Nimumanya ku hatsigaireho ebiro bibiri okuhika aha kiro ky'Okuhingurwaho, Omwana w'omuntu naija kuheebwayo kubambwa aha musharaba. <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Omu biro ebyo abanyamurwa abakuru n'abakuru b'eihanga eryo bakateeranira omu ka y'omunyamurwa omukuru, owaabaire naayetwa Kayaafa; <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />baahanuura hamwe oku baraakwate Yesu omu bwengye, bakamwita. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Kwonka baagira bati: Haza tutamukwatira omu biro by'obugyenyi, hatabaho okurabanamu omu bantu.<verse eid="MAT 26:5" /></para>
  <para style="s1">Yesu okusiigwa amajuta</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:6-13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:36-50">Luk 7:36-50</ref>; <ref loc="MRK 14:3-9">Mak 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoh 12:1-8</ref>. </char>
    </note> Yesu ku yaabaire ari Besania omwa Simooni omubembe, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />haija omukazi oine eihembe ry'amajuta ag'obuguzi bwingi munonga, yaagashuka aha mutwe gwe ashutami naarya. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Abeegi be, ku baakireebire, baaguubwa kubi nibagira bati: Amajuta aga gaafa ki? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Nangwa kuri gaguzirwemu bingi, bikagabirwa abooro! <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Kwonka Yesu, ku yaabimanyire, yaabagira ati: Nimugwisiza ki kubi omukazi ogu? Ahakuba eki yankorera ni kirungi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ahabw'okuba abooro mutuura nabo obutoosha; kwonka nyowe timuriguma naanye obutoosha. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Omu kushuka amajuta aga aha mubiri gwangye, yaakikora ahabw'okunteekateekyera okuziikwa. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Buzimazima nimbagambira nti: Ahu engiri erigambwa hoona omu nsi zoona, n'eki omukazi ogu yaakora kiryagambwayo kumwijuka.<verse eid="MAT 26:13" /></para>
  <para style="s1">Yuda Iskaryota okutunda Yesu</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:14-16: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:3-6">Luk 22:3-6</ref>; <ref loc="MRK 14:10">Mak 14:10</ref>, <ref loc="MRK 14:11">11</ref>. </char>
    </note> Bwanyima omwe ahari bari ikumi na babiri, orikweta Yuda Iskaryota, yaaza aha banyamurwa abakuru, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" /><note caller="-" style="x"><char style="xo" closed="false">26:15: </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Zek 11:12</ref>. </char></note> yaababuuza ati: Nimwija kumpa ki, naanye nkamubaha? Baamubarira <note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="ft" closed="false">Omu Rugriika ni drachma. </char></note>ebicweka by'efeeza makumi ashatu. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" /><note caller="-" style="x"><char style="xo" closed="false">26:16: </char><char style="xt" closed="false"><ref loc="1TI 6:9">1 Tim 6:9</ref>, <ref loc="1TI 6:10">10</ref>. </char></note> Okuruga aho yaasherura oburyo oku araamureebye.<verse eid="MAT 26:16" /></para>
  <para style="s1">Yesu n'abeegi be okurya hamwe obugyenyi bw'Okuhingurwaho</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:17-19: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:7-13">Luk 22:7-13</ref>; <ref loc="MRK 14:12-16">Mak 14:12-16</ref>. </char>
    </note> Aha kiro ky'okubanza eky'Emigaati etatumbisiibwe, abeegi bakaija ahari Yesu, baamubuuza bati: Nooyenda tutebeekanise hi ei oraariire Okuhingurwaho?<note caller="-" style="x"><char style="xo" closed="false">26:17: </char><char style="xt" closed="false"><ref loc="EXO 12:18-20">Kur 12:18-20</ref>. </char></note> <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Yaabaragiira ati: Mwirooko mugyende omu rurembo owa nanka, mumugire muti: Omwegyesa naagira ati: Obunaku bwangye nibwenda kuhika; omu nju yaawe nimwo ndaariire Okuhingurwaho hamwe n'abeegi bangye. <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Abeegi abo baakora nk'oku Yesu yaabagambira; baatebeekanisa Okuhingurwaho.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:20-30: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:14-23">Luk 22:14-23</ref>; <ref loc="JHN 13:21-26">Yoh 13:21-26</ref>; <ref loc="MRK 14:17-26">Mak 14:17-26</ref>. </char>
    </note> Kandi ku bwabaire omu mwabazyo, yaashutama aha meeza n'abeegi be ikumi na babiri. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Ku baabaire nibarya, yaabagira ati: Buzimazima nimbagambira nti: Omwe ahariimwe naija kundeebya. <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Baashaasha munonga bashobeirwe, baatandika kumubuuza omwe omwe bati: Mukama wangye, niinye? <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Yaabagarukamu ati: Owaaba naakoza naanye omu rwabya, niwe arikwija kundeebya. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Omwana w'omuntu naagyenda, nk'oku kyamuhandiikirweho; kwonka orikumureebya aryakareeba. Kikaabaire kirungi nangwa omuntu ogwo kuri atarazairwe. <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Yuda owaamureebize yaamubuuza ati: Mwegyesa, niinye? Yaamugaruku ati: Eki waagamba nikwo kiri.<verse eid="MAT 26:25" /></para>
  <para style="s1">Okugabura kwa Mukama waitu</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:26: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>. </char>
    </note> Ku baabaire nibarya Yesu yaakwata omugaati, yaagusiimira, yaagubega, yaaguheereza abeegi be naagira ati: Mwakiire, murye; ogu nigwo mubiri gwangye. <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Yaakwata ekikopo; ku yaaherize kusiima, yaakibaha naagira ati: Munyweho mwena; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" /><note caller="-" style="x"><char style="xo" closed="false">26:28: </char><char style="xt" closed="false"><ref loc="EXO 24:8">Kur 24:8</ref>; <ref loc="ZEC 9:11">Zek 9:11</ref>. </char></note> ahakuba egi n'eshagama yangye ey'endagaano ensya, esheesheka ahabwa baingi, ngu basaasirwe ebibi. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nimbagambira nti: Tindinywa hari viinyo y'ebyana by'omuzaabibu okwiha hati okuhitsya aha kiro ekyo, obu ndinywa naimwe viinyo nsya omu bukama bwa Tata. <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" /><note caller="-" style="x"><char style="xo" closed="false">26:30: </char><char style="xt" closed="false"><ref loc="PSA 113-118">Zab 113—118</ref>; <ref loc="JHN 18:1">Yoh 18:1</ref>. </char></note> Ku baaherize kweshongora zaaburi, baashohora, baaza omu kibungo kya Zeituuni.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu okugamba oku Petero araamwehakane</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:31-35: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="MRK 14:27-31">Mak 14:27-31</ref>. </char>
    </note> Kandi Yesu yaabagira ati: Imwe mwena eki kiro nimwija kumpemukaho; ahakuba kikahandiikwa ngu: Ndyateera omuriisa, entaama z'omu busyo zitaataane.<note caller="-" style="x"><char style="xo" closed="false">26:31: </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zek 13:7</ref>. </char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Kwonka ku ndiheza kuzooka, ndyababandiza Galilaaya. <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Petero yaahiga naagira ati: N'obu abandi boona baraagwe bakakuhemukaho, nyowe tindikwija kuhemukaho na kakye. <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" /><note caller="-" style="x"><char style="xo" closed="false">26:34: </char><char style="xt" closed="false"><ref loc="JHN 13:38">Yoh 13:38</ref>. </char></note> Yesu yaamugarukamu ati: Buzimazima ninkugambira nti: Iwe eki kiro, enkoko etakagambire, noija kuunyehakana kashatu. <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Petero yaamugarukamu ati: N'obu ndaabe ow'okwitwa naiwe, tindikwija kukwehakana. N'abandi boona baahiga batyo.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu okushaba n'obusaasi omuri Gesesemaani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:36-46: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:40-46">Luk 22:40-46</ref>; <ref loc="MRK 14:32-42">Mak 14:32-42</ref>. </char>
    </note> Bwanyima Yesu yaagyenda nabo, baahika omu mwanya ogurikwetwa Gesesemaani, yaagira abeegi be ati: Mube mushutami aha, nyiririreho omu maisho, nshabe. <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" /><note caller="-" style="x"><char style="xo" closed="false">26:37: </char><char style="xt" closed="false"><ref loc="HEB 5:7">Heb 5:7</ref>. </char></note> Yaatwara Petero na beene Zebedaayo bombi, yaatandika kugira obusaasi bwingi n'okushoberwa munonga. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Yaabagira ati: Omutima gwangye gwine obusaasi bwingi, nibwija kuunyita; mugume aha, nimureeba naanye. <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Yairirira kakye omu maisho, yaajuumara ahansi, yaashaba ati: Ai bambe Taata, ekikopo eki kimpingure, ku kiraabe nikibaasika; kwonka kitaba nk'oku ndikwenda, kureka nkaiwe oku orikwenda. <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Yaagaruka aha beegi be, yaashanga bagwejegyeire; yaabuuza Petero ati: Ebyo mwaremwa kwehangaana kureeba naanye nangwa n'eshaaha emwe? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" /><note caller="-" style="x"><char style="xo" closed="false">26:41: </char><char style="xt" closed="false"><ref loc="HEB 4:15">Heb 4:15</ref>. </char></note> Mureebe mushabe, murekye kugwa omu kwohibwa, Omutima gwo nigukunda, kwonka omubiri n'omweremwa. <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />Yaagarukayo obwa kabiri, yaashaba ati: Ai bambe Taata, ekikopo eki ku kiraabe kitarikubaasa kundabaho ntakinyweire, eki orikwenda kibe nikyo kyakorwa. <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Yaagaruka yaija, nabwo yaashanga bagwejegyeire, ahabw'okuba amaisho gaabo gakaba nigahungira. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Nikwo kubareka, akagarukayo kushaba obwa kashatu, akashaba ebigambo bimwe nk'eby'okubanza. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Bwanyima yaagaruka aha beegi be, yaabagira ati: Na hati mukigwejegyeire, mukihuumwire? Reeba, obunaku bwairira haihi, Omwana w'omuntu yaaheebwayo omu mikono y'abasiisi. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Mwimukye, tugyende; reeba, orikundeebya ari haihi.<verse eid="MAT 26:46" /></para>
  <para style="s1">Okukwata Yesu</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:47-56: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="MRK 14:43-50">Mak 14:43-50</ref>; <ref loc="JHN 18:3-12">Yoh 18:3-12</ref>. </char>
    </note> Ku yaabaire naakigamba, haija Yuda, omwe ahari bari ikumi na babiri, hamwe n'omutwe gw'abantu baingi baine zaarurara n'ebikoni, nibaruga aha banyamurwa abakuru n'abakuru b'eihanga eryo. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Kandi ogwo owaabaire naamureebya, akaba abahaire akamanyiso, naagira ati: ou ndaanywegyere, niwe ogwo; mumukwate. <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Ahonaaho yaija ahari Yesu, yaamuramutsya ati: Osingire, Mwegyesa! Yaamunywegyera. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Yesu yaamugira ati: Mugyenzi wangye, kora eki oiziriire. Ahonaaho baija baamugurukira, baamukwata. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Kandi reeba, omwe ahari abo abaabaire bari na Yesu, yaatayo omukono, yaasyorayo rurara ye, yaatema omuhuuku w'omunyamurwa omukuru, yaamucwaho okutu. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" /><note caller="-" style="x"><char style="xo" closed="false">26:52: </char><char style="xt" closed="false"><ref loc="GEN 9:6">Kut 9:6</ref>. </char></note> Yesu yaamuhana ati: Garura rurara yaawe omu kyobati kyayo; ahakuba boona abatwara rurara, baryaitwa rurara. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Nari shi, noogira ngu, tindikubaasa kushaba Tata, akaanyoherereza ahonaaho baamaraika abarikukira <note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">Legioni n'omutwe gw'engabo nka 6,000. </char></note>legioni ikumi na ibiri? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Mbwenu ku kyakubaire kitabaire kityo, Ebyahandiikirwe bihikiirira ryari, haza kandi nikwo kishemereire kuba? <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Omu shaaha egyo Yesu yaagira emitwe y'abantu ati: Mwampururira kunkwata na zaarurara n'ebikoni, nk'oku bahururira omwambuzi? Ebiro byona nkaba ntuura omuri hekalu niinyegyesa, timurankwatsire. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Kwonka ebi byona byabaho, ngu ebyahandiikirwe baanabi bihikiirire. Okuruga aho abeegi be boona baamuhungaho, bairuka.<verse eid="MAT 26:56" /></para>
  <para style="s1">Abanyamurwa okucwera Yesu orubanja rw'okumwita</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:57-75: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:54-71">Luk 22:54-71</ref>; <ref loc="MRK 14:53-72">Mak 14:53-72</ref>; <ref loc="JHN 18:12-27">Yoh 18:12-27</ref>. </char>
    </note> Abo abaakwatsire Yesu baamutwara owa Kayaafa omunyamurwa omukuru, ei abahandiiki n'abakuru baabaire bateeraniire. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Kandi Petero yaamukuratira naamugyenda hare okuhika omu kibuga ky'omunyamurwa omukuru; ku yaataahiremu, yaashutama n'abambari kureeba ahu biraaherere. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Kandi abanyamurwa abakuru n'ab'omu ishengyero boona baasherura obwamushinja bw'ebishuba kubeiherera Yesu ngu bamwite; <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />tibaabubona, n'obu haraabe haizire baamushinja baingi b'ebishuba. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="-" style="x"><char style="xo" closed="false">26:61: </char><char style="xt" closed="false"><ref loc="JHN 2:19-21">Yoh 2:19-21</ref>. </char></note> Bwanyima haija babiri, nibagira bati: Ogu mushaija akagira ati: Nimbaasa kusheenya hekalu ya Ruhanga, kandi ngyombekye omu biro bishatu. <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Omunyamurwa omukuru yaayemerera, yaamubuuza ati: Toine ki orikwetonganira na kakye? Aba nibakwomesereza ki? <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Yesu yaabeetsiza. Omunyamurwa omukuru yaamugira ati: Ninkurahiza Ruhanga. <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" /><note caller="-" style="x"><char style="xo" closed="false">26:64: </char><char style="xt" closed="false"><ref loc="MAT 24:30">Mat 24:30</ref>; <ref loc="DAN 7:13">Dan 7:13</ref>. </char></note> Yesu yaamugarukamu ati: Eki waagamba nikwo kiri; kandi nimbagambira nti: Bwanyima muryareeba Omwana w'omuntu ashutami aha rubaju rwa buryo orw'Obushoboorozi naizira omu bicu by'omu iguru. <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" /><note caller="-" style="x"><char style="xo" closed="false">26:65: </char><char style="xt" closed="false"><ref loc="JHN 10:33">Yoh 10:33</ref>. </char></note> Ahonaaho omunyamurwa omukuru yaataagura ebijwaro bye, naagira ati: Yaarogota; nitukyendera ki baamushinja abandi? Naimwe mwayehuririra okurogota kwe. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" /><note caller="-" style="x"><char style="xo" closed="false">26:66: </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lev 24:16</ref>; <ref loc="JHN 19:7">Yoh 19:7</ref>. </char></note> Mbwenu nimuteekateeka muta? Baagarukamu nibagira bati: Ashemereire kufa. <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" /><note caller="-" style="x"><char style="xo" closed="false">26:67: </char><char style="xt" closed="false"><ref loc="ISA 50:6">Isa 50:6</ref>. </char></note> Baamucwera amacwante aha maisho, baamuteera entomi; abandi baamuteera empi, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />nibagira bati: Iwe Kristo, ragura, otugambire owaakuteera.<verse eid="MAT 26:68" /></para>
  <para style="s1">Petero okwehakana Yesu</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Kandi Petero akaba ashutami aheeru omu kibuga. Omuzaana yaija ah'ari, yaamugira ati: Naiwe obaire ori hamwe na Yesu owa Galilaaya. <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Kwonka we yaayehakanira omu maisho ga boona, ati: Tindikumanya ki orikugamba. <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Ku yaabaire naashohora, yaahika aha irembo, omuzaana ondiijo yaamureeba, yaagambira abandi abaabaire bari aho, ati: Omushaija ogu nawe abaire ari hamwe na Yesu owa Nazareesi. <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Yaagaruka yaayehakana naarahira ati: Omuntu ogwo tindikumumanya. <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Ku haahingwireho akaanya kakye, abaabaire beemereire aho baija baagambira Petero bati: Buzimazima naiwe ori omwe aharibo, ahabw'okuba emigambire yaawe neekumanyisa. <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Obwo yaatandika kukyeena n'okurahira, naagira ati: Omushaija ogwo tindikumumanya. Ahonaaho enkoko yaagamba. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Petero yaijuka ekigambo eki Yesu amugambiire ati: Enkoko etakagambire, noija kuunyehakana kashatu. Yaashohora aheeru, yaarira munonga.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Yesu okutwarwa owa Pilaato</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Ku bwaseesire, abanyamurwa abakuru boona n'abakuru b'eihanga baahanuura hamwe oku baraite Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Baamuboha, baamutwara, baamuhayo ahari Pilaato omutegyeki.<verse eid="MAT 27:2" /></para>
  <para style="s1">Yuda okwehanika</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kandi Yuda owaamureebize, ku yaareebire orubanja rwasinga Yesu, yaayefuuza, yaagarurira abanyamurwa abakuru n'abakuru b'abantu ebyo bicweka by'efeeza makumi ashatu, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />naagira ati: Nsiisire okureebya eshagama etaine rubanja. Kwonka bo baagarukamu bati: Ebyo shi n'ebyaitu? N'orubanja rwawe. <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" /><note caller="-" style="x"><char style="xo" closed="false">27:5: </char><char style="xt" closed="false"><ref loc="ACT 1:18">Byak 1:18</ref>, <ref loc="ACT 1:19">19</ref>; <ref loc="2SA 17:23">2 Sam 17:23</ref>. </char></note> Yaatambika ebyo bicweka by'efeeza omuri hekalu, yaashohora, yaagyenda, yaayehanika. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Abanyamurwa abakuru baatorotoora ebyo bicweka by'efeeza, nibagira bati: Ebiragiro tibirikwikiriza kubita omu ibiikiro, ahabw'okuba n'obuguzi bw'eshagama. <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Baahanuura, baabiguramu ekibanja ky'omubumbi kuguma nibaziikamu abahinguzi. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />N'ahabw'ekyo ekibanja ekyo kyayetwa Ekibanja, ky'eshagama okuruga obwo n'okuhitsya hati. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" /><note caller="-" style="x"><char style="xo" closed="false">27:9: </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Zek 11:12</ref>, <ref loc="ZEC 11:13">13</ref>. </char></note> Okwo nikwo ekyagambirwe nabi Yeremia kyahikiriire, eki yaagizire ati: Bakatwara ebicweka by'efeeza makumi ashatu, nibwo buguzi bwe obu abamwe aha Baisraeli baamucwereire, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />baabiguramu ekibanja ky'omubumbi, nk'oku Mukama yandagiire.<verse eid="MAT 27:10" /></para>
  <para style="s1">Pilaato okucwera Yesu orubanja rw'okumubamba</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:11-14: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:2">Luk 23:2</ref>, <ref loc="LUK 23:3">3</ref>; <ref loc="MRK 15:2-5">Mak 15:2-5</ref>; <ref loc="JHN 18:29-38">Yoh 18:29-38</ref>. </char>
    </note> Yesu yaayemerera omu maisho g'omutegyeki: omutegyeki yaamubuuza ati: Weeza ori Omugabe w'Abayudaaya? Yesu yaamugarukamu ati: Eki waagamba nikwo kiri. <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" /><note caller="-" style="x"><char style="xo" closed="false">27:12: </char><char style="xt" closed="false"><ref loc="ISA 53:7">Isa 53:7</ref>. </char></note> Kwonka ku yaatabaariziibwe abanyamurwa abakuru n'abakuru b'abantu, tiyaagarukamu na kakye. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Pilaato nikwo kumubuuza ati: Tohuriire ebi byona ebi barikukushinja ku biri bingi? <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" /><note caller="-" style="x"><char style="xo" closed="false">27:14: </char><char style="xt" closed="false"><ref loc="JHN 19:9">Yoh 19:9</ref>. </char></note> We tiyaamugarukamu n'obu kyakuba ekigambo na kimwe; n'ahabw'ekyo omutegyeki yaatangaara munonga. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" /><note caller="-" style="x"><char style="xo" closed="false">27:15-26: </char><char style="xt" closed="false"><ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="MRK 15:6-15">Mak 15:6-15</ref>; <ref loc="JHN 18:39-19:1">Yoh 18:39—19:1</ref>. </char></note> Kandi aha bugyenyi nk'obwo omutegyeki akaba amanyiire kurekurira abantu embohe emwe, ei baabaire bamushaba. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Omu biro ebyo bakaba baine embohe erangainwe ahabw'obubi erikwetwa Barabba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Boona ku baaherize kuteerana, Pilaato yaababuuza ati: Nimwenda ngu mbarekurire oha? Barabba nari Yesu orikwetwa Kristo? <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" /><note caller="-" style="x"><char style="xo" closed="false">27:18: </char><char style="xt" closed="false"><ref loc="JHN 11:47">Yoh 11:47</ref>, <ref loc="JHN 11:48">48</ref>; <ref loc="JHN 12:19">12:19</ref>. </char></note> Ahakuba akamanya ku baamuhayo ahabw'eihari.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Ku yaashutamire aha kitebe ky'okucweraho emanja, omukazi we yaamutumaho naagira ati: Oyetantare ebigambo by'omushaija ogwo ohikiriire; ahakuba ebi mmurootsireho nyekiro binsaasize munonga. <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Kwonka abanyamurwa abakuru n'abakuru baayosya abantu ngu bashabe Barabba, baite Yesu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Omutegyeki yaagaruka yaababuuza ati: Ahari abo bombi nimwenda ku mbarekurira oha? Baamugarukamu bati; Barabba. <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilaato yaababuuza ati: Mbwenu shi, ngire nta Yesu orikwetwa Kristo? Boona baagarukamu bati: Abambwe aha musharaba. <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Yaababuuza ati: Ahanki? Ni kibi ki eki akozire? Baayeyongyera kuyomba nibagira bati: Abambwe! <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Pilaato ku yaareebire naayeruhiriza busha, kandi yaareeba ngu haza kubaho okurabanamu, yaayakiira amaizi, yaanaaba omu ngaro omu maisho g'abantu, naagira ati: Tiinyine rubanja ahabw'eshagama y'omuntu ogu ohikiriire; mubyemarire. <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" /><note caller="-" style="x"><char style="xo" closed="false">27:25: </char><char style="xt" closed="false"><ref loc="ACT 5:28">Byak 5:28</ref>. </char></note> Abantu boona baagarukamu nibagira bati: Eshagama ye ebe niitwe yaatukurira n'abaana baitu. <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Pilaato nikwo kubarekurira Barabba. Kandi ku yaaherize kwasha Yesu, yaamuhayo kubambwa. <verse eid="MAT 27:26" /><verse number="27" style="v" sid="MAT 27:27" /><note caller="-" style="x"><char style="xo" closed="false">27:27-30: </char><char style="xt" closed="false"><ref loc="MRK 15:16-19">Mak 15:16-19</ref>; <ref loc="JHN 19:2">Yoh 19:2</ref>, <ref loc="JHN 19:3">3</ref>. </char></note> Bwanyima abaserukare b'omutegyeki baatwara Yesu omu kibuga ekirikwetwa Puratorio, omutwe gwabo gwona baagumuteeraniraho. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Baamujuura ebijwaro bye, baamujweka omwenda gwa karari. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Ku baaherize kuruka ekirunga ky'amahwa, baakimujweka omu mutwe, baamukwatsa ekibingo omu mukono gwe gwa buryo, baamutsimbira amaju, baamuteerera enaku nibagira bati: Singa, Mugabe w'Abayudaaya! <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" /><note caller="-" style="x"><char style="xo" closed="false">27:30: </char><char style="xt" closed="false"><ref loc="ISA 50:6">Isa 50:6</ref>. </char></note> Baamucwera amacwante, baakwata ekyo kibingo, baakimuteera omu mutwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" /><note caller="-" style="x"><char style="xo" closed="false">27:31-56: </char><char style="xt" closed="false"><ref loc="LUK 23:26">Luk 23:26</ref>, <ref loc="LUK 23:33-49">33-49</ref>; <ref loc="MRK 15:20-41">Mak 15:20-41</ref>; <ref loc="JHN 19:16-30">Yoh 19:16-30</ref>. </char></note> Ku baaherize kumuteerera enaku, baamujuura ogwo mwenda, baagaruka baamujweka ebijwaro bye, baamutwara kubambwa aha musharaba.<verse eid="MAT 27:31" /></para>
  <para style="s1">Yesu okubambwa</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Ku baabaire nibashohora, baabugana omushaija wa Kureene orikwetwa Simooni; ogwo baamugyema kwekorera omusharaba gwa Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Ku baahikire aharikwetwa Gologosa, amakuru gaakyo ngu Omwanya gw'empanga y'omuntu, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" /><note caller="-" style="x"><char style="xo" closed="false">27:34: </char><char style="xt" closed="false"><ref loc="PSA 69:21">Zab 69:21</ref>. </char></note> baamuha viinyo ejwangiremu omubazi ogurikwetwa sumuruna; ku yaagirorizeho, yaayanga kuginywa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" /><note caller="-" style="x"><char style="xo" closed="false">27:35: </char><char style="xt" closed="false"><ref loc="PSA 22:18">Zab 22:18</ref>. </char></note> Ku baaherize kumubamba, baabagana ebijwaro bye, nibabiteerera enteenyu. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Baashutama ahansi, baaguma nibamureeba. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Baahanika ebigambo ebi baamutabaariza ahaiguru y'omutwe gwe, ebyabaire bihandiikirwe biti: OGU NI YESU, OMUGABE W'ABAYUDAAYA. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" /><note caller="-" style="x"><char style="xo" closed="false">27:38: </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref>. </char></note> Kandi akabambwa hamwe n'abambuzi babiri, omwe aha rubaju rwe rwa buryo, n'ondi aha rwa bumosho. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" /><note caller="-" style="x"><char style="xo" closed="false">27:39: </char><char style="xt" closed="false"><ref loc="PSA 22:7">Zab 22:7</ref>. </char></note> Kandi n'abaabaire nibahinguraho baamutsyorera, nibamuzongoreza emitwe, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" /><note caller="-" style="x"><char style="xo" closed="false">27:40: </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoh 2:19</ref>. </char></note> nibagira bati: Iwe orikusheenya hekalu, okagyombeka omu biro bishatu, yejune! Ku oraabe ori Omwana wa Ruhanga, hanuka orugye aha musharaba. <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Abanyamurwa abakuru n'abahandiiki n'abakuru b'abantu nabo baamutsyorera batyo nibagira bati: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Akajuna abandi; tarikubaasa kwejuna. Ngu, N'omugabe w'Abaisraeli! Naahanukye, arugye aha musharaba hati, naitwe tumwikirize. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" /><note caller="-" style="x"><char style="xo" closed="false">27:43: </char><char style="xt" closed="false"><ref loc="PSA 22:8">Zab 22:8</ref>. </char></note> Ayesiga Ruhanga, mbwenu naamujune hati, ku araabe naamukunda; ahabw'okuba yaagira ati: Ndi Omwana wa Ruhanga. <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kandi n'abambuzi abaabaire babambirwe nawe nabo nikwo baamuteerera enaku batyo.<verse eid="MAT 27:44" /></para>
  <para style="s1">Okukaba kwa Yesu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Okuruga aha shaaha ya mukaaga okuhitsya aha ya mwenda omwirima gwashweka ensi yoona. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" /><note caller="-" style="x"><char style="xo" closed="false">27:46: </char><char style="xt" closed="false"><ref loc="PSA 22:1">Zab 22:1</ref>. </char></note> Ku bwabaire buri haihi kuhika aha shaaha ya mwenda, Yesu yaagamba n'eiraka rihango, ati: Eli, Eli, laama sabakasaani; amakuru ngu; Ruhanga wangye, Ruhanga wangye, n'enki ekyakuntsigisaho? <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Bamwe aha baabaire beemereire aho, ku baakihuriire, baagira bati: Omushaija ogu naayeta Eliya. <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" /><note caller="-" style="x"><char style="xo" closed="false">27:48: </char><char style="xt" closed="false"><ref loc="PSA 69:21">Zab 69:21</ref>. </char></note> Ahonaaho omwe aharibo yairuka, yaakwata ekyangu, yaakijabika omuri viinyo erikushaarira, yaakita aha kibingo, yaamuheereza kunywa. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Abandi baagira bati: Reka tureebe Eliya ku araabe naija kumujuna. <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Bwanyima Yesu yaagaruka yaagamba n'eiraka rihango, yaahayo amagara ge.<verse eid="MAT 27:50" /></para>
  <para style="s1">Eby'okutangaaza ebyabaireho</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:51: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:19">Heb 10:19</ref>, <ref loc="HEB 10:20">20</ref>. </char>
    </note> Omukingo gw'omuri hekalu gwataagukamu ebicweka bibiri okuruga aha mutwe gwagwo okuhika ahansi, ensi yaatengyeta, enkiri z'amabaare zaayatika, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ebituuro byaiguka; emitumbi mingi y'abahikiriire abaabaire bagwejegyeire yaazoorwa; <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />baaruga omu bituuro bwanyima y'okuzooka kwe, baataaha omu rurembo orurikwera, baareebwa baingi. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Omukuru w'abaserukare n'abu yaabaire aine nibarinda Yesu, ku baareebire omutsitsa n'ebindi byabaho, baatiina munonga, nibagira bati: Buzima kwo ogu abaire ari Omwana wa Ruhanga. <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Hakaba hariho n'abakazi baingi beemereire nibareebera hangahari; abo nibo baarugire Galilaaya bamukuratiire nibamuheereza; <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />omuri abo hakaba harimu Mariamu Magadaleene na Mariamu nyina wa Yakobo na Yosefu, kandi na nyina wa beene Zebedaayo. <verse eid="MAT 27:56" /><verse number="57" style="v" sid="MAT 27:57" /><note caller="-" style="x"><char style="xo" closed="false">27:57-61: </char><char style="xt" closed="false"><ref loc="LUK 23:50-55">Luk 23:50-55</ref>; <ref loc="MRK 15:42-47">Mak 15:42-47</ref>; <ref loc="JHN 19:38-42">Yoh 19:38-42</ref>. </char></note> Omu mwabazyo haija omushaija omutungi owa Arimasaaya, orikwetwa Yosefu, kandi nawe akaba ari omwegi wa Yesu.<note caller="-" style="x"><char style="xo" closed="false">27:57: </char><char style="xt" closed="false"><ref loc="EXO 34:25">Kur 34:25</ref>. </char></note> <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Omushaija ogwo yaaza owa Pilaato, yaashaba omutumbi gwa Yesu. Pilaato yaaragiira kugumuha. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosefu yaatwara omutumbi, yaaguzinga omu mwenda gwa kitaani ogurikwera, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" /><note caller="-" style="x"><char style="xo" closed="false">27:60: </char><char style="xt" closed="false"><ref loc="ISA 53:9">Isa 53:9</ref>. </char></note> yaagurambika omu kituuro kye kisya, eki yaabaire ayetimbiire omu rukiri; yaakumbagaza eibaare rihango, yaarikingisa aha muryango gwakyo, yaagyenda. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Kandi Mariamu Magadaleene na Mariamu ondiijo bakaba bariho, bashutami nibareeba ekyo kituuro.<verse eid="MAT 27:61" /></para>
  <para style="s1">Okurinda ekituuro kya Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Ku bwaseesire aha izooba eryakuratiire ekiro ky'Okweteguura, abanyamurwa abakuru n'Abafarisaayo baateeranira owa Pilaato, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />baamugira bati: Mukama waitu, nitwijuka eki omubeihi ori yaagambire akiriho, ati: Ndyazooka bwanyima y'ebiro bishatu. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Mbwenu ragiira barindire kimwe ekituuro okuhitsya aha kiro kya kashatu, abeegi be batakaija bakamwiba, haza bakagambira abantu ngu, Azookire omu bafu; kandi okuhaba okurirugamu kuryaba kubi okukira okw'okubanza. <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilaato yaabagarukamu ati: Mwine abarinzi b'abaserukare; mugyende, mukirindire kimwe, nk'oku murikubaasa. <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Nabo baagyenda, baahamisa eryo ibaare akamanyiso, baataho n'abarinzi, ngu ekituuro kitaigurwa.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Okuzooka kwa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:1-10: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 24:1-10">Luk 24:1-10</ref>; <ref loc="MRK 16:1-10">Mak 16:1-10</ref>; <ref loc="JHN 20:1-18">Yoh 20:1-18</ref>. </char>
    </note> Bwanyima y'eizooba rya Sabato, omushekye ku gwabaire nigujuguta omu kasheeshe k'ekiro ky'okubanza omuri saabiiti, Mariamu Magadaleene na Mariamu ondiijo baaza kureeba ekituuro. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Haabaho omutsitsa gw'amaani; ahabw'okuba maraika wa Mukama akaruga omu iguru, yaija, yaakumbagaza eibaare, yaarishutamaho. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Enshusha ye akaba naamurinkana nk'omurabyo, n'ebijwaro bye bikaba nibyera nk'orubaare. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Abarinzi ahaw'okutiina batetema, baahinduka nk'abafiire. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Kwonka maraika yaagambira abakazi ati: Imwe, mutatiina; ahakuba nimmanya ku murikusherura Yesu obambirwe. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Tari aha; ahabw'okuba azookire, nk'oku yaagambire. Mwije mureebe omwanya ahu abaire abyami. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Haza mwehuute, mugambire abeegi be ku azookire omu bafu, kandi ku arikwija kubabandiza Galilaaya; okwo niyo muraamureebere. Reeba naabagambira. <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Baaruga aha kituuro, nibeehuuta baine obwoba n'okushemererwa kwingi, bairuka kugambira abeegi be. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Yesu yaababugana, yaabagira ati: Mushemererwe! Baamwirira haihi, baamukwata aha bigyere, baamuramya. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" /><note caller="-" style="x"><char style="xo" closed="false">28:10: </char><char style="xt" closed="false"><ref loc="HEB 2:11">Heb 2:11</ref>. </char></note> Yesu nikwo kubagambira ati: Mutatiina, mugyende, mugambire bagyenzi bangye baze Galilaaya; okwo niyo barandeebere.<verse eid="MAT 28:10" /></para>
  <para style="s1">Abanyamurwa okugurira abarinzi</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Ku baabaire nibagyenda, abamwe ahari abo barinzi baija omu rurembo, baagambira abanyamurwa abakuru byona ebyabaho. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Abanyamurwa nikwo kuteerana abakuru b'abantu, bakahanuura hamwe; ku baaherize, baaha abaserukare empiiha nyingi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />baabagambira bati: Mugume mugire muti: Abeegi be baizire nyekiro, baamwiba itwe tugwejegyeire. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Omutegyeki ku araabimanye, nitwija kumwikiririsa, tubaiheho orubanja. <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Abaserukare baayakiira empiiha, baakora nk'oku baahabwirwe; ekigambo ekyo kyabuga omuri Buyudaaya n'okuhitsya hati.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yesu okutuma abeegi be omu mahanga goona</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Bwanyima abeegi be ikumi n'omwe baaza Galilaaya, aha rushozi oru Yesu abaragiire. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Ku baamureebire, baamuramya; kwonka abandi baabanganisa. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" /><note caller="-" style="x"><char style="xo" closed="false">28:18: </char><char style="xt" closed="false"><ref loc="MAT 11:27">Mat 11:27</ref>; <ref loc="EPH 1:20-22">Efe 1:20-22</ref>. </char></note> Yesu yaija, yaabagira ati: Mpairwe obushoboorozi bwona omu iguru n'omu nsi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><note caller="-" style="x"><char style="xo" closed="false">28:19: </char><char style="xt" closed="false"><ref loc="MRK 16:15">Mak 16:15</ref>, <ref loc="MRK 16:16">16</ref>. </char></note> N'ahabw'ekyo mugyende omu mahanga goona, muhindure abantu abeegi nimubabatiza omu iziina rya Isheboona n'ery'Omwana n'ery'Omwoyo Orikwera, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" /><note caller="-" style="x"><char style="xo" closed="false">28:20: </char><char style="xt" closed="false"><ref loc="HEB 13:5">Heb 13:5</ref>. </char></note> nimubeegyesa kworobera byona ebi naabaragiire; kandi reeba, ndi hamwe naimwe ebiro byona okuhitsya obu ensi egi erihwaho.<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>