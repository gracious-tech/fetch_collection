<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">RRK19.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">ZAABURI</para>
  <para style="toc1">Zaaburi Ekitabo Ky'okubanza</para>
  <para style="toc2">Zaaburi</para>
  <para style="toc3">Zab</para>
  <para style="mt1">ZAABURI</para>
  <para style="mt2">EKITABO KY'OKUBANZA</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="s1">Okugyeragyeranisa abahikiriire n'ababi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:14">Enf 4:14</ref>; <ref loc="PRO 21:24">21:24</ref>. </char>
    </note> Aine omugisha omuntu otakuratira naama z'ababi,</para>
  <para style="q1" vid="PSA 1:1">Nari okwemerera omu muhanda gw'abasisi,</para>
  <para style="q1" vid="PSA 1:1">N'obu kwakuba okushutama aha bitebe by'abarikugaya;<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 1:8">Yos 1:8</ref>; <ref loc="PSA 119:47">Zab 119:47</ref>, <ref loc="PSA 119:97">97</ref>; <ref loc="ROM 7:22">Rom 7:22</ref>. </char>
    </note> Kureka oshemerererwa Ebiragiro bya MUKAMA,</para>
  <para style="q1" vid="PSA 1:2">Kandi Ebiragiro ebyo nibyo ateekateekaho nyomushana na nyekioro.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:3">Kut 39:3</ref>, <ref loc="GEN 39:23">23</ref>; <ref loc="EZK 47:12">Ezk 47:12</ref>. </char>
    </note> Ari nk'omuti ogubyairwe aha rubaju rw'amaizi,</para>
  <para style="q1" vid="PSA 1:3">Ogwana ebyana byagwo omu bunaku bwabyo,</para>
  <para style="q1" vid="PSA 1:3">N'amababi gaagwo tigahotoka;</para>
  <para style="q1" vid="PSA 1:3">Ebi akora byona bigyenda gye.<verse eid="PSA 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:18">Yob 21:18</ref>. </char>
    </note> Kwonka ababi tikwo baba,</para>
  <para style="q1" vid="PSA 1:4">Kureka bashusha nk'ebishushunga ebirikutwarwa omuyaga.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:5">Zab 5:5</ref>. </char>
    </note> Nikyo ababi bataribaasiza kwemerera mu rubanja,</para>
  <para style="q1" vid="PSA 1:5">N'obu baakuba abasiisi omu kuteerana kw'abahikiriire;<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:14">Yoh 10:14</ref>. </char>
    </note> Ahakuba MUKAMA naamanya omuhanda gw'abahikiriire,</para>
  <para style="q1" vid="PSA 1:6">Kwonka omuhanda gw'ababi guryabura.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s1">Obutegyeki bwa Kristo owaashukirweho amajuta</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 4:25">Byak 4:25</ref>, <ref loc="ACT 4:26">26</ref>. </char>
    </note> N'enki ekiteeraine hamwe amahanga?</para>
  <para style="q1" vid="PSA 2:1">Ahabw'enki abanyamahanga nibaza omu naama za busha?<note caller="-" style="x"><char style="xo" closed="false">2:1: </char><char style="xt" closed="false"><ref loc="PSA 46:6">Zab 46:6</ref>. </char></note><verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:50">Zab 18:50</ref>; <ref loc="PSA 45:7">45:7</ref>. </char>
    </note> Abagabe b'ensi batengire orugamba,</para>
  <para style="q1" vid="PSA 2:2">N'abategyeki nibahanuura hamwe,</para>
  <para style="q1" vid="PSA 2:2">Okurwanisa MUKAMA n'ou yaashukireho amajuta, ni bagira bati:<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:5">Yer 5:5</ref>. </char>
    </note> Ka tucwe enjegyere zaabo,</para>
  <para style="q1" vid="PSA 2:3">Tunagye hare emirunga yaabo.<verse eid="PSA 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:4">Zab 11:4</ref>; <ref loc="PSA 37:13">37:13</ref>; <ref loc="PRO 1:26">Enf 1:26</ref>. </char>
    </note> Oshutami omu iguru naasheka;</para>
  <para style="q1" vid="PSA 2:4">MUKAMA naabateerera enaku.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Aryabagambira abagwereirwe kubi,</para>
  <para style="q1" vid="PSA 2:5">Abatiinise n'ekiniga kingi, ati:<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:4">Zab 3:4</ref>; <ref loc="PSA 15:1">15:1</ref>; <ref loc="PSA 43:3">43:3</ref>. </char>
    </note> Nyowe nyemekire omugabe wangye</para>
  <para style="q1" vid="PSA 2:6">Aha rushozi rwangye orurikwera Saayuni.<verse eid="PSA 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:33">Byak 13:33</ref>; <ref loc="HEB 1:5">Heb 1:5</ref>; <ref loc="HEB 5:5">5:5</ref>. </char>
    </note> Niinyija kuranga ekiragiro kya MUKAMA;</para>
  <para style="q1" vid="PSA 2:7">Yangira ati: Ori Omwana wangye,</para>
  <para style="q1" vid="PSA 2:7">Eri izooba naakuzaara.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:8">Zab 72:8</ref>; <ref loc="DAN 7:14">Dan 7:14</ref>. </char>
    </note> Nshaba, ndyakuha amahanga gabe obutaka bwawe,</para>
  <para style="q1" vid="PSA 2:8">N'embaju zoona ez'ensi zibe eitungo ryawe.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:14">Isa 30:14</ref>; <ref loc="REV 2:27">Kush 2:27</ref>. </char>
    </note> Oryabacoocoora n'enkoni y'ekyoma,</para>
  <para style="q1" vid="PSA 2:9">Obaatagure nk'enyungu y'omubumbi.<verse eid="PSA 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />N'ahabw'ekyo, imwe bagabe 'mwe, mugire obwengye,</para>
  <para style="q1" vid="PSA 2:10">Naimwe abategyeki b'ensi, mwikirize kuhaburwa.<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:28">Heb 12:28</ref>. </char>
    </note> Muheereze MUKAMA n'okutiina,</para>
  <para style="q1" vid="PSA 2:11">Mushemererwe n'okutetema.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:8">Zab 34:8</ref>; <ref loc="PSA 84:12">84:12</ref>; <ref loc="JER 17:7">Yer 17:7</ref>. </char>
    </note> Munywegyere Omwana, atakaabagirira ekiniga,</para>
  <para style="q1" vid="PSA 2:12">Mukahwerekyererera omu muhanda;</para>
  <para style="q1" vid="PSA 2:12">Ahakuba ekiniga kye nikiija kurahuka kwaka.</para>
  <para style="q1" vid="PSA 2:12">Boona abamuhungiraho baine omugisha.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" sid="PSA 3" />
  <para style="d">Okushaba kw'omu kasheeshe kw'okwesiga Mukama Zaaburi ei Daudi yaayeshongoire ahungire omutabani Abusalomu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 15:12">1 Sam 15:12</ref>. </char>
    </note> MUKAMA wangye, abazigu bangye ka ni baingi!</para>
  <para style="q1" vid="PSA 3:1">Baingi baanyimukiriire;<verse eid="PSA 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:11">Zab 71:11</ref>. </char>
    </note> Baingi nibangambaho bati:</para>
  <para style="q1" vid="PSA 3:2">Taine kuhwerwa kwona ahari Ruhanga.<verse eid="PSA 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:6">Zab 27:6</ref>; <ref loc="PSA 28:7">28:7</ref>; <ref loc="PSA 119:114">119:114</ref>; <ref loc="GEN 15:1">Kut 15:1</ref>. </char>
    </note> Kwonka Iwe MUKAMA, ori engabo enyehinguririize;</para>
  <para style="q1" vid="PSA 3:3">Niiwe ndikwehimbisizaho, kandi niiwe oimukize omutwe gwangye.<verse eid="PSA 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:6">Zab 2:6</ref>; <ref loc="PSA 77:1">77:1</ref>; <ref loc="PSA 142:1">142:1</ref>. </char>
    </note> Ntakira MUKAMA n'eiraka ryangye,</para>
  <para style="q1" vid="PSA 3:4">Nawe angarukamu naayema aha rushozi rwe orurikwera.<verse eid="PSA 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:8">Zab 4:8</ref>; <ref loc="PRO 3:24">Enf 3:24</ref>. </char>
    </note> Nkabyama, naagwejegyera,</para>
  <para style="q1" vid="PSA 3:5">Kandi naasisiimuka, ahakuba MUKAMA niwe andamira.<verse eid="PSA 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:3">Zab 27:3</ref>. </char>
    </note> Tinditiina bukumi bw'abantu</para>
  <para style="q1" vid="PSA 3:6">Abankubire kundwanisa.<verse eid="PSA 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:12">Zab 10:12</ref>; <ref loc="PSA 58:6">58:6</ref>. </char>
    </note> Ai bambe MUKAMA, imuka;</para>
  <para style="q1" vid="PSA 3:7">Ruhanga wangye, njuna;</para>
  <para style="q1" vid="PSA 3:7">Ahakuba okateera abazigu bangye boona aha mushaya,</para>
  <para style="q1" vid="PSA 3:7">Waacwa amaino g'ababi.<verse eid="PSA 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:39">Zab 37:39</ref>; <ref loc="PRO 21:31">Enf 21:31</ref>; <ref loc="JER 3:23">Yer 3:23</ref>; <ref loc="JON 2:9">Yon 2:9</ref>. </char>
    </note> Okujuna n'okwa MUKAMA;</para>
  <para style="q1" vid="PSA 3:8">Omugisha gwawe gube aha bantu baawe.<verse eid="PSA 3:8" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" sid="PSA 4" />
  <para style="d">Okushaba kw'omu mwabazyo kw'okushemererwa n'obusingye Aha Mukuru w'abeeshongozi b'enanga ez'emirya, Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 23:6">Yer 23:6</ref>. </char>
    </note> Ai Ruhanga, omanya okuhikiirira kwangye;</para>
  <para style="q1" vid="PSA 4:1">Ku ndaagume naakweta, onyetabe.</para>
  <para style="q1" vid="PSA 4:1">Ku naabaire nfunziibwe, wampa omwanya, naayeshanja.</para>
  <para style="q1" vid="PSA 4:1">Ongirire embabazi, ohurire okushaba kwangye.<verse eid="PSA 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2" />Imwe bantu 'mwe, muryahitsya hi okuhemura ekitiinisa kyangye?</para>
  <para style="q1" vid="PSA 4:2">Muryahitsya hi okukunda ebitaine mugasho, n'okukuratira ebishuba?<verse eid="PSA 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:6">Zab 77:6</ref>; <ref loc="EXO 33:16">Kur 33:16</ref>. </char>
    </note> Kwonka mumanye ngu MUKAMA ayetooraniire orikumutiina;</para>
  <para style="q1" vid="PSA 4:3">MUKAMA ampurira, ku mmutakira.<verse eid="PSA 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Efe 4:26</ref>; <ref loc="DEU 33:19">Bir 33:19</ref>. </char>
    </note> Mugire ekiniga, kwonka murekye kushiisha;</para>
  <para style="q1" vid="PSA 4:4">Muhanuure n'emitima yaanyu mubyami, mucecekye.<verse eid="PSA 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:3">Zab 37:3</ref>; <ref loc="PSA 51:19">51:19</ref>; <ref loc="NUM 6:26">Kub 6:26</ref>. </char>
    </note> Muheyo ebitambo ebihikire,</para>
  <para style="q1" vid="PSA 4:5">Kandi mwesigye MUKAMA.<verse eid="PSA 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:15">Zab 89:15</ref>. </char>
    </note> Hariho baingi abarikubuuza bati: N'oha oraatworekye ebirungi?</para>
  <para style="q1" vid="PSA 4:6">Ai MUKAMA, otwakize omushana gw'amaisho gaawe.<verse eid="PSA 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:3">Isa 9:3</ref>; <ref loc="LEV 25:18">Lev 25:18</ref>, <ref loc="LEV 25:19">19</ref>. </char>
    </note> Otaire okushemererwa omu mutima gwangye</para>
  <para style="q1" vid="PSA 4:7">Okurikukira oku bagira omu biro by'omweru n'eby'emihiiso ya viinyo.<verse eid="PSA 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:5">Zab 3:5</ref>. </char>
    </note> Niinyija kubyama ntaine ki ndikwekyenga, ngwejegyere,</para>
  <para style="q1" vid="PSA 4:8">Ahakuba niiwe wenka, MUKAMA, ondinda nkagira obusingye.<verse eid="PSA 4:8" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" sid="PSA 5" />
  <para style="d">Okushaba okurindwa abazigu Aha Mukuru w'abeeshongozi n'abateezi b'ebirikugamba byona ebiterwa eminwa.</para>
  <para style="s1">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 5:1" />Ai MUKAMA, tega amatu, ohurire ebigambo byangye,</para>
  <para style="q1" vid="PSA 5:1">Ote omutima aha kuteekateeka kwangye.<verse eid="PSA 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:3">Zab 84:3</ref>. </char>
    </note> Hurira eiraka ry'okutaka kwangye,</para>
  <para style="q1" vid="PSA 5:2">Mukama wangye, kandi Ruhanga wangye,</para>
  <para style="q1" vid="PSA 5:2">Ahakuba niiwe ndikushaba.<verse eid="PSA 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:13">Zab 88:13</ref>; <ref loc="PSA 119:147">119:147</ref>. </char>
    </note> Ai MUKAMA, buri kasheeshe noija kuguma noohurira eiraka ryangye,</para>
  <para style="q1" vid="PSA 5:3">Buri kasheeshe nintebeekanisa eby'okukuhongyera, ngume nindeeba.<verse eid="PSA 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4" />Ahakuba tori Ruhanga orikushemerererwa obubi,</para>
  <para style="q1" vid="PSA 5:4">Ekibi tikiriguma h'ori.<verse eid="PSA 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:5">Zab 1:5</ref>; <ref loc="PSA 11:5">11:5</ref>; <ref loc="PSA 73:4">73:4</ref>; <ref loc="HAB 1:13">Hab 1:13</ref>. </char>
    </note> Abarikwehimbisa tibaryemerera mu maisho gaawe;</para>
  <para style="q1" vid="PSA 5:5">Oyanga boona abakora ebibi.<verse eid="PSA 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:23">Zab 55:23</ref>; <ref loc="REV 22:15">Kush 22:15</ref>. </char>
    </note> Ababeihi oryabahwerekyereza;</para>
  <para style="q1" vid="PSA 5:6">MUKAMA ayangira kimwe omwitsi w'abantu, n'engobya.<verse eid="PSA 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:7: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:30">1 Bag 8:30</ref>. </char>
    </note> Kwonka nyowe, ahabw'embabazi zaawe nyingi</para>
  <para style="q1" vid="PSA 5:7">Ndyataaha omu nju yaawe;</para>
  <para style="q1" vid="PSA 5:7">Ndamye ntaire amaisho ahari hekalu yaawe erikwera ninkuha ekitiinisa.<verse eid="PSA 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:3">Zab 23:3</ref>; <ref loc="PSA 27:11">27:11</ref>. </char>
    </note> Ahabw'abantu abangwereire, ai MUKAMA, onyebembere omu kuhikiirira kwawe;</para>
  <para style="q1" vid="PSA 5:8">Onshemereze omuhanda gwawe omu maisho gangye.<verse eid="PSA 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>; <ref loc="ROM 3:13">Rom 3:13</ref>. </char>
    </note> Ahakuba omu kanwa kaabo tiharimu mazima,</para>
  <para style="q1" vid="PSA 5:9">Emitima yaabo n'obubi busha,</para>
  <para style="q1" vid="PSA 5:9">Emimiro yaabo n'ekituuro kirangaire,</para>
  <para style="q1" vid="PSA 5:9">Bashunga abantu n'endimi zaabo.<verse eid="PSA 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 15:31">2 Sam 15:31</ref>. </char>
    </note> Obasingise orubanja, ai Ruhanga;</para>
  <para style="q1" vid="PSA 5:10">Bagwe ahabw'enaama zaabo;</para>
  <para style="q1" vid="PSA 5:10">Obabingye ahabw'eby'okushiisha byabo bingi,</para>
  <para style="q1" vid="PSA 5:10">ahakuba bakugomeire.<verse eid="PSA 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:12">Zab 2:12</ref>; <ref loc="PSA 33:21">33:21</ref>; <ref loc="1SA 2:1">1 Sam 2:1</ref>. </char>
    </note> Kwonka boona abarikukuhungiraho bashemererwe;</para>
  <para style="q1" vid="PSA 5:11">Bagume bateere akaari ahabw'okunanuka;</para>
  <para style="q1" vid="PSA 5:11">ahakuba niiwe obarinda,</para>
  <para style="q1" vid="PSA 5:11">Kandi n'abakunda eiziina ryawe bashemerererwe omuriiwe.<verse eid="PSA 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:13">Zab 115:13</ref>. </char>
    </note> Ahakuba Iwe MUKAMA, oryaha omugisha abahikiriire,</para>
  <para style="q1" vid="PSA 5:12">Obakingize embabazi nk'engabo.<verse eid="PSA 5:12" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="d">Okushaba okuhwerwa omu biro by'emirabanamu Aha Mukuru w'abeeshongozi aha nanga ez'emirya y'ekishiminiisi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:1">Zab 38:1</ref>; <ref loc="HEB 12:5">Heb 12:5</ref>, <ref loc="HEB 12:6">6</ref>. </char>
    </note> Ai MUKAMA, otanteisa ongwereirwe kubi,</para>
  <para style="q1" vid="PSA 6:1">N'obu kwakuba okumpana n'ekiniga kyawe kingi.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:4">Zab 41:4</ref>; <ref loc="HOS 6:1">Hos 6:1</ref>. </char>
    </note> Ongirire embabazi, ai MUKAMA, ahakuba nyomeire kimwe;</para>
  <para style="q1" vid="PSA 6:2">Ontambire, MUKAMA, ahakuba amagufa gangye nigajegajega,<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:3: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 12:27">Yoh 12:27</ref>. </char>
    </note> Kandi n'omutima gwangye nigutetema munonga.</para>
  <para style="q1" vid="PSA 6:3">Beitu Iwe, ai MUKAMA, oryandeka okuhitsya ryari?<verse eid="PSA 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />Ai MUKAMA, garuka ojune amagara gangye,</para>
  <para style="q1" vid="PSA 6:4">Onkize ahabw'embabazi zaawe;<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:9">Zab 30:9</ref>; <ref loc="PSA 88:10-12">88:10-12</ref>; <ref loc="PSA 115:17">115:17</ref>; <ref loc="ISA 38:18">Isa 38:18</ref>. </char>
    </note> Ahakuba ofiire aba atakikwijuka.</para>
  <para style="q1" vid="PSA 6:5">N'oha orikubaasa kukuhimbisiza okuzimu?<verse eid="PSA 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:3">Zab 69:3</ref>. </char>
    </note> Okutsinda kunkabize;</para>
  <para style="q1" vid="PSA 6:6">Buri kiro ndirira aha kitabo kyangye;</para>
  <para style="q1" vid="PSA 6:6">Ekitanda kyangye nkijubya n'amarira.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:9">Zab 31:9</ref>; <ref loc="PSA 88:9">88:9</ref>. </char>
    </note> Amaisho gampwereire ahabw'amaganya;</para>
  <para style="q1" vid="PSA 6:7">Gakambire ahabw'abazigu bangye boona.<verse eid="PSA 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:8: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:23">Mat 7:23</ref>; <ref loc="MAT 25:41">25:41</ref>. </char>
    </note> Imwe mwena enkozi z'ebibi, mundugyeho,</para>
  <para style="q1" vid="PSA 6:8">Ahakuba MUKAMA ahuriire eiraka ry'okurira kwangye;<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:22">Zab 31:22</ref>. </char>
    </note> MUKAMA ahuriire okweshengyereza kwangye;</para>
  <para style="q1" vid="PSA 6:9">MUKAMA naikiriza okushaba kwangye.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:14">Zab 40:14</ref>. </char>
    </note> Abazigu bangye boona baryakwatwa enshoni, bateteme munonga;</para>
  <para style="q1" vid="PSA 6:10">Baryagaruka enyima, bahemukye omuri ako kaanya.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" sid="PSA 7" />
  <para style="d">Okushaba okurindwa abazigu Shigayoni ya Daudi, ei yaayeshongoreire MUKAMA ahabw'ebigambo bya Kushi ow'omu ruganda rwa Benyamiini</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 7:1" />Ai MUKAMA Ruhanga wangye, niiwe ndikwesiga;</para>
  <para style="q1" vid="PSA 7:1">Njuna boona abarikumpiiga, kandi onkize,<verse eid="PSA 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:22">Zab 50:22</ref>. </char>
    </note> Barekye kuntaagataagura nk'entare,</para>
  <para style="q1" vid="PSA 7:2">Nibantwara ntaine kijuna.<verse eid="PSA 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 26:18">1 Sam 26:18</ref>. </char>
    </note> Ai MUKAMA Ruhanga wangye, ku ndaabe nyine eki naakozire,</para>
  <para style="q1" vid="PSA 7:3">Emikono yangye ku eraabe yaakozire ekibi,<verse eid="PSA 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 7:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:4: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:7">1 Sam 24:7</ref>; <ref loc="1SA 26:9">26:9</ref>. </char>
    </note> Ku ndaabe naakozire kubi owaabaire atuura gye naanye,</para>
  <para style="q1" vid="PSA 7:4">Ku ndaabe naatuzire busha omuzigu wangye,<verse eid="PSA 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 7:5" />Orekye omuzigu wangye ampiigye, ankwate,</para>
  <para style="q1" vid="PSA 7:5">Aribatiirire amagara gangye,</para>
  <para style="q1" vid="PSA 7:5">N'ekitiinisa kyangye akite omu mucuucu.<verse eid="PSA 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:23">Zab 35:23</ref>; <ref loc="PSA 94:2">94:2</ref>; <ref loc="JOB 8:6">Yob 8:6</ref>; <ref loc="ISA 33:10">Isa 33:10</ref>. </char>
    </note> Imuka, ai MUKAMA, n'ekiniga kyawe,</para>
  <para style="q1" vid="PSA 7:6">Oyemerere ogungire abazigu bangye abaanyiniire ekiniga kingi;</para>
  <para style="q1" vid="PSA 7:6">Sisiimuka, Ruhanga wangye; ahakuba niiwe waaragiire kucwa orubanja.<verse eid="PSA 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7" />K'emitwe y'amahanga ekwehinguririze,</para>
  <para style="q1" vid="PSA 7:7">Naiwe obategyekye, oshutami aha kitebe kyawe eky'ahaiguru.<verse eid="PSA 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:1">Zab 26:1</ref>; <ref loc="PSA 35:24">35:24</ref>. </char>
    </note> MUKAMA acwera amahanga emanja;</para>
  <para style="q1" vid="PSA 7:8">Ai MUKAMA, oncwere orubanja nk'okuhikiirira kwangye oku kuri,</para>
  <para style="q1" vid="PSA 7:8">N'amazima agari omuriinye oku gari.<verse eid="PSA 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:2">Zab 26:2</ref>; <ref loc="JER 11:20">Yer 11:20</ref>; <ref loc="REV 2:23">Kush 2:23</ref>. </char>
    </note> Ai bambe Ruhanga ohikiriire, ogyeza emitima n'ebiteekateeko,</para>
  <para style="q1" vid="PSA 7:9">Reka obubi bw'ababi buhweho,</para>
  <para style="q1" vid="PSA 7:9">Kwonka abahikiriire obagumye.<verse eid="PSA 7:9" /></para>
  <para style="s1">Oku Ruhanga ahindura busha enaama z'ababi</para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10" />Engabo yangye ni Ruhanga</para>
  <para style="q1" vid="PSA 7:10">Okiza abaine emitima egororokire.<verse eid="PSA 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:3">Yob 8:3</ref>; <ref loc="NAM 1:2">Nah 1:2</ref>. </char>
    </note> Ruhanga n'Omucwi w'emanja ohikiriire,</para>
  <para style="q1" vid="PSA 7:11">Ogwerwa kubi ababi obutoosha.<verse eid="PSA 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12" />Omuntu ku ayanga kweteisa,</para>
  <para style="q1" vid="PSA 7:12">Ruhanga atyaza rurara ye;</para>
  <para style="q1" vid="PSA 7:12">Areegire obuta bwe,</para>
  <para style="q1" vid="PSA 7:12">Yaabuteekateeka.<verse eid="PSA 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:14">Zab 18:14</ref>. </char>
    </note> Amuteekateekyeire eby'okurwanisa by'okumwita;</para>
  <para style="q1" vid="PSA 7:13">Emyambi ye agitaireho omuriro.<verse eid="PSA 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:35">Yob 15:35</ref>; <ref loc="ISA 59:4">Isa 59:4</ref>. </char>
    </note> Omusiisi arumwa okuzaara obubi,</para>
  <para style="q1" vid="PSA 7:14">Agira enda y'eitima, kandi azaara ebishuba.<verse eid="PSA 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:6">Zab 57:6</ref>; <ref loc="PRO 26:27">Enf 26:27</ref>; <ref loc="ECC 10:8">Mub 10:8</ref>. </char>
    </note> Atimbire ekiina, yaakiihamu eitaka,</para>
  <para style="q1" vid="PSA 7:15">Kandi yaagwa omu busya obu atimbire.<verse eid="PSA 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:23">Zab 94:23</ref>; <ref loc="EST 9:25">Est 9:25</ref>; <ref loc="1KI 2:32">1 Bag 2:32</ref>. </char>
    </note> Eitima rye riryamugarukira;</para>
  <para style="q1" vid="PSA 7:16">Omwaga ogu agirira abandi guryamugwisiza akagwe.<verse eid="PSA 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:2">Zab 9:2</ref>. </char>
    </note> Ndyasiima MUKAMA okusiima okushemereire okuhikiirira kwe;</para>
  <para style="q1" vid="PSA 7:17">Ndyayeshongora, mpimbise eiziina rya MUKAMA Rukira-boona.<verse eid="PSA 7:17" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" sid="PSA 8" />
  <para style="d">Ekitiinisa kya Mukama n'obushoboorozi obu yaahaire abantu Aha Mukuru w'abeeshongozi b'enanga ey'ekigitiiti. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:4">Zab 113:4</ref>; <ref loc="PSA 148:13">148:13</ref>. </char>
    </note> Ai MUKAMA, Mukama waitu,</para>
  <para style="q1" vid="PSA 8:1">Eiziina ryawe ka ni rirungi omu nsi yoona!</para>
  <para style="p" vid="PSA 8:1">Okata ekitiinisa kyawe ahaiguru y'eiguru.<verse eid="PSA 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:16">Zab 44:16</ref>; <ref loc="MAT 11:25">Mat 11:25</ref>; <ref loc="MAT 21:16">21:16</ref>; <ref loc="1CO 1:27">1 Kor 1:27</ref>. </char>
    </note> Ahabw'abarikukurwanisa, okaha abaana bato n'abarikwonka</para>
  <para style="q1" vid="PSA 8:2">Amaani g'okugamba eby'okuhunamya abazigu n'abahoozi b'enzigu.<verse eid="PSA 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Zab 19:1</ref>; <ref loc="PSA 111:2">111:2</ref>; <ref loc="GEN 1:16">Kut 1:16</ref>; <ref loc="ROM 1:20">Rom 1:20</ref>. </char>
    </note> Ku nteekateeka aha iguru ryawe eri waahangire n'engaro zaawe,</para>
  <para style="q1" vid="PSA 8:3">Okwezi n'enyonyoozi ebi waataireho,<verse eid="PSA 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 8:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:4-6: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:6-8">Heb 2:6-8</ref>. </char>
    </note> Omuntu ni kintu ki Iwe kumwijuka?</para>
  <para style="q1" vid="PSA 8:4">Nari shi omwana w'omuntu Iwe kumutaayaayira?<note caller="-" style="x"><char style="xo" closed="false">8:4: </char><char style="xt" closed="false"><ref loc="PSA 144:3">Zab 144:3</ref>; <ref loc="JOB 7:17">Yob 7:17</ref>; <ref loc="JOB 25:6">25:6</ref>. </char></note><verse eid="PSA 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:5, 6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:26-28">Kut 1:26-28</ref>; <ref loc="PSA 21:5">Zab 21:5</ref>; <ref loc="1CO 15:27">1 Kor 15:27</ref>; <ref loc="EPH 1:22">Efe 1:22</ref>. </char>
    </note> Kwonka okamuhanga yaaburaho kakye kwingana na Ruhanga;</para>
  <para style="q1" vid="PSA 8:5">Waamujweka ekirunga ky'ekitiinisa n'okuhimbisibwa.<verse eid="PSA 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6" />Waamutegyekyesa emirimo y'emikono yaawe;</para>
  <para style="q1" vid="PSA 8:6">Waata ebintu byona ahansi y'ebigyere bye,<verse eid="PSA 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7" />Entaama n'ente zoona,</para>
  <para style="q1" vid="PSA 8:7">N'enyamaishwa z'omu ishwa,<verse eid="PSA 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 8:8" />N'enyonyi z'omu mwanya, n'eby'enyanja eby'omu mayanja,</para>
  <para style="q1" vid="PSA 8:8">N'ebirikuraba omu nyanja byona.<verse eid="PSA 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9" />Ai MUKAMA, Mukama waitu,</para>
  <para style="q1" vid="PSA 8:9">Eiziina ryawe ka ni rirungi munonga omu nsi yoona!<verse eid="PSA 8:9" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" sid="PSA 9" />
  <para style="d">Mukama okucwa emanja z'oburyo Aha Mukuru w'abeeshongozi b'enanga ey'ekimusi-labeni. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 9:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:7">Zab 26:7</ref>. </char>
    </note> Ndyasiima MUKAMA n'omutima gwangye gwona;</para>
  <para style="q1" vid="PSA 9:1">Mmanyise abantu eby'okutangaaza byona ebi waakozire.<verse eid="PSA 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:17">Zab 7:17</ref>. </char>
    </note> Ndyashemererwa, nyesiimire omuriiwe,</para>
  <para style="q1" vid="PSA 9:2">Ndyayeshongora eby'okuhimbisa eiziina ryawe, Iwe Rukira-boona.<verse eid="PSA 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3" />Ahabw'okuba abazigu bangye bagarukire enyima,</para>
  <para style="q1" vid="PSA 9:3">Baagwa, baahwerekyererera omu maisho gaawe.<verse eid="PSA 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:12">Zab 140:12</ref>. </char>
    </note> Ahakuba okandwanaho, naasinga orubanja omu mazima;</para>
  <para style="q1" vid="PSA 9:4">Oshutami aha kitebe kyawe eky'obukama, noocwa emanja omu buryo.<verse eid="PSA 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:5: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 9:14">Bir 9:14</ref>. </char>
    </note> Okahana amahanga, waacwekyereza ababi;</para>
  <para style="q1" vid="PSA 9:5">Waamariraho kimwe amaziina gaabo ebiro n'ebiro.<verse eid="PSA 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6" />Abazigu bahweireho, bacwekyerereziibwe kimwe;</para>
  <para style="q1" vid="PSA 9:6">Endembo zaabo ozisheenyire, n'okwijukwa tizaakiijukwa.<verse eid="PSA 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:10">Zab 29:10</ref>; <ref loc="HAB 1:12">Hab 1:12</ref>. </char>
    </note> Kwonka MUKAMA atuura aha ngoma obutwire bwona,</para>
  <para style="q1" vid="PSA 9:7">Ateekateekire ekitebe kye kucwa emanja;<verse eid="PSA 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 58:11">Zab 58:11</ref>; <ref loc="PSA 96:10">96:10</ref>, <ref loc="PSA 96:13">13</ref>. </char>
    </note> Kandi aryacwera ensi yoona orubanja omu kuhikiirira,</para>
  <para style="q1" vid="PSA 9:8">Acwere abantu boona orubanja omu mazima.<verse eid="PSA 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:16">Zab 59:16</ref>; <ref loc="2SA 22:3">2 Sam 22:3</ref>. </char>
    </note> MUKAMA n'obuhungiro bw'abarikuburabuzibwa,</para>
  <para style="q1" vid="PSA 9:9">Obu bahungiramu omu biro by'obusaasi.<verse eid="PSA 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:14">Zab 91:14</ref>; <ref loc="2TI 1:12">2 Tim 1:12</ref>. </char>
    </note> Abo abarikumanya eiziina ryawe baryakwesiga,</para>
  <para style="q1" vid="PSA 9:10">Ahakuba iwe, MUKAMA, tokahemukaga ha bakusherura.<verse eid="PSA 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:2">Zab 74:2</ref>; <ref loc="PSA 76:2">76:2</ref>; <ref loc="PSA 107:21">107:21</ref>. </char>
    </note> Mweshongore eby'okuhimbisa Mukama otuura omuri Saayuuni;</para>
  <para style="q1" vid="PSA 9:11">Kandi mumanyise abantu boona ebi akora;<verse eid="PSA 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:12">Zab 10:12</ref>, <ref loc="PSA 10:13">13</ref>; <ref loc="1KI 21:17-19">1 Bag 21:17-19</ref>; <ref loc="GEN 9:5">Kut 9:5</ref>. </char>
    </note> Ahakuba Ogwo ohoorera eshagama abataho omutima,</para>
  <para style="q1" vid="PSA 9:12">Kandi tayebwa kutaka kw'abari omu busaasi.<verse eid="PSA 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13" />Ai MUKAMA, ongirire embabazi!</para>
  <para style="q1" vid="PSA 9:13">Reeba okubonabona oku ndikubonabonesibwa abarikuunyanga,</para>
  <para style="q1" vid="PSA 9:13">Iwe onyimutsya okanyiha aha marembo ga rufu,<verse eid="PSA 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:5">Zab 13:5</ref>; <ref loc="PSA 35:9">35:9</ref>; <ref loc="2KI 19:21">2 Bag 19:21</ref>; <ref loc="1SA 2:1">1 Sam 2:1</ref>. </char>
    </note> Ngu mbone kumanyisa okuhimbisibwa kwawe kwona;</para>
  <para style="q1" vid="PSA 9:14">Kandi ndyashemerererwa okujuna kwawe</para>
  <para style="q1" vid="PSA 9:14">Omu marembo ga Saayuuni.<verse eid="PSA 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>; <ref loc="PSA 35:8">35:8</ref>. </char>
    </note> Abanyamahanga bagwire omu busya obu batimbire;</para>
  <para style="q1" vid="PSA 9:15">Ebigyere byabo byakwatwa ekigoye eki bategire.<verse eid="PSA 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:5">Kur 7:5</ref>; <ref loc="EXO 14:4">14:4</ref>. </char>
    </note> MUKAMA akeeyoreka, yaacwa orubanja;</para>
  <para style="q1" vid="PSA 9:16">Ababi bakwatirwa omutego omu bi bakozire n'emikono yaabo. Higayoni.<verse eid="PSA 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:22">Zab 50:22</ref>; <ref loc="JER 2:32">Yer 2:32</ref>; <ref loc="JOB 8:13">Yob 8:13</ref>. </char>
    </note> Ababi baryagaruka okuzimu;</para>
  <para style="q1" vid="PSA 9:17">Nigo mahanga goona ageebwa Ruhanga.<verse eid="PSA 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:5">Zab 12:5</ref>. </char>
    </note> Abakyene tibariguma nibeeba,</para>
  <para style="q1" vid="PSA 9:18">Kandi amatsiko g'abooro tigarihwaho ebiro n'ebiro.<verse eid="PSA 9:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:7">Zab 3:7</ref>; <ref loc="PSA 10:18">10:18</ref>. </char>
    </note> Imuka, ai MUKAMA! Otaikiriza abantu kusingura;</para>
  <para style="q1" vid="PSA 9:19">Amahanga gacwerwe orubanja omu maisho gaawe.<verse eid="PSA 9:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20" />Obatiinise, ai MUKAMA!</para>
  <para style="q1" vid="PSA 9:20">Amahanga gamanye ku bari abantu-buntu.<verse eid="PSA 9:20" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" sid="PSA 10" />
  <para style="s1">Okushaba Ruhanga okufubira ababi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:1">Zab 13:1</ref>; <ref loc="PSA 22:11">22:11</ref>. </char>
    </note> Ahabw'enki oyemereire hare, ai MUKAMA?</para>
  <para style="q1" vid="PSA 10:1">Ahanki nooyeshereka omu biro by'obusaasi?<verse eid="PSA 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 5:22">Enf 5:22</ref>. </char>
    </note> Ahabw'amaryo omubi ahiiga munonga omworo;</para>
  <para style="q1" vid="PSA 10:2">Ka bagwe omu naama ezi baagizire.<verse eid="PSA 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3" />Ahakuba omubi ayehimbisa ahabw'ebi omutima gwe gwetenga;</para>
  <para style="q1" vid="PSA 10:3">N'omwetengi w'enshaagi ayehakana MUKAMA, kandi amugaya.<verse eid="PSA 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:1">Zab 14:1</ref>; <ref loc="PSA 53:1">53:1</ref>. </char>
    </note> Omubi omu maryo g'emireebere ye tasherura Ruhanga;</para>
  <para style="q1" vid="PSA 10:4">Kandi omu biteekateeko bye byona agira ngu, Tihariho Ruhanga.<verse eid="PSA 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5" />Ahiirwa omu mihanda ye obutoosha bwona;</para>
  <para style="q1" vid="PSA 10:5">Okucwa emanja kwawe kumuri hare ahu atarikureeba;</para>
  <para style="q1" vid="PSA 10:5">Abazigu be boona abeeshaanya.<verse eid="PSA 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:6: </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:7">Kush 18:7</ref>. </char>
    </note> Agira omu mutima gwe ati: Tindiihwa hu ndi;</para>
  <para style="q1" vid="PSA 10:6">Ebiro byona tindigira by'okunnyangaraza.<verse eid="PSA 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 20:12">Yob 20:12</ref>; <ref loc="ROM 3:14">Rom 3:14</ref>. </char>
    </note> Akanwa ke kaijwire okukyeena n'obugobya n'okubonabonesa;</para>
  <para style="q1" vid="PSA 10:7">Ahansi y'orurimi rwe hariho eitima n'okutahikiirira.<verse eid="PSA 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8" />Agwera omu birorero;</para>
  <para style="q1" vid="PSA 10:8">Omu myanya eyekiikire nimwo aitira abataine kabi;</para>
  <para style="q1" vid="PSA 10:8">Amaisho ge agata aha bataine kihwera omu mubonano.<verse eid="PSA 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:12">Zab 17:12</ref>; <ref loc="MIC 7:2">Mik 7:2</ref>; <ref loc="JOB 38:40">Yob 38:40</ref>. </char>
    </note> Agwera ayesherekire nk'entare eri omu ryaya ryayo;</para>
  <para style="q1" vid="PSA 10:9">Agwera omuntu enshoberwa kumukwata;</para>
  <para style="q1" vid="PSA 10:9">Kandi kwo amukwata, amukuruza ekigoye kye.<verse eid="PSA 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10" />Egyo nshoberwa eshekurwa, einama,</para>
  <para style="q1" vid="PSA 10:10">Kandi ebandama ahabw'amaani ge.<verse eid="PSA 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:7">Zab 94:7</ref>; <ref loc="JOB 22:13">Yob 22:13</ref>; <ref loc="EZK 9:9">Ezk 9:9</ref>. </char>
    </note> Agira omu mutima gwe ati: Ruhanga ayebirwe,</para>
  <para style="q1" vid="PSA 10:11">Akyehugize; tarikireeba.<verse eid="PSA 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:7">Zab 3:7</ref>; <ref loc="PSA 9:12">9:12</ref>, <ref loc="PSA 9:18">18</ref>. </char>
    </note> Imuka, ai MUKAMA; imutsya omukono gwawe, ai Ruhanga;</para>
  <para style="q1" vid="PSA 10:12">Oteebwa abari omu busaasi.<verse eid="PSA 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13" />Omubi agayira ki Ruhanga.</para>
  <para style="q1" vid="PSA 10:13">Akagira omu mutima gwe ati: Tarikimbuuza?<verse eid="PSA 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:13">Zab 33:13</ref>; <ref loc="PSA 146:9">146:9</ref>; <ref loc="1PE 4:19">1 Pet 4:19</ref>. </char>
    </note> Okireebire; ahakuba oyetegyereza eitima n'okushaazya,</para>
  <para style="q1" vid="PSA 10:14">Ngu obone kubikoraho n'omukono gwawe;</para>
  <para style="q1" vid="PSA 10:14">Omuntu enshoberwa ayeta omu mikono yaawe;</para>
  <para style="q1" vid="PSA 10:14">Ahakuba niiwe oshangwa oba omuhwezi w'efuuzi.<verse eid="PSA 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:17">Zab 37:17</ref>; <ref loc="ISA 41:12">Isa 41:12</ref>. </char>
    </note> Henda omukono gw'obubi n'enkozi y'ebibi;</para>
  <para style="q1" vid="PSA 10:15">Ocaakye obubi bwe, okuhitsya obu oribureeba bwona.<verse eid="PSA 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:10">Zab 29:10</ref>; <ref loc="REV 11:15">Kush 11:15</ref>; <ref loc="EXO 15:18">Kur 15:18</ref>. </char>
    </note> MUKAMA niwe Mugabe ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 10:16">Abanyamahanga baryahwera kimwe omu nsi ye.<verse eid="PSA 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:17: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 29:18">1 Bus 29:18</ref>. </char>
    </note> Ai MUKAMA, ohuriire okwetenga kw'abacureezi;</para>
  <para style="q1" vid="PSA 10:17">Oryagumya emitima yaabo, obategye okutu,<verse eid="PSA 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:19">Zab 9:19</ref>; <ref loc="PSA 82:3">82:3</ref>; <ref loc="ISA 1:17">Isa 1:17</ref>. </char>
    </note> Kucwera efuuzi n'abarikuburabuzibwa emanja z'oburyo,</para>
  <para style="q1" vid="PSA 10:18">Omuntu-buntu arekye kubatiinisa obundi.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" sid="PSA 11" />
  <para style="d">Ruhanga nk'oku ari obuhungiro bw'abahikiriire Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>; <ref loc="1SA 23:14">1 Sam 23:14</ref>. </char>
    </note> MUKAMA niwe mpungiraho;</para>
  <para style="q1" vid="PSA 11:1">Noobaasa ota kungira oti:</para>
  <para style="q1" vid="PSA 11:1">Hungira aha bibungo nk'enyonyi;<verse eid="PSA 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 64:4">Zab 64:4</ref>. </char>
    </note> Ahakuba, reeba, ababi bareega obuta bwabo,</para>
  <para style="q1" vid="PSA 11:2">Babutamikamu omwambi gwabo,</para>
  <para style="q1" vid="PSA 11:2">Kurasira omu mwirima ab'emitima egororokire.<verse eid="PSA 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3" />Emisingi ku yaakuhwerekyerezibwa,</para>
  <para style="q1" vid="PSA 11:3">Abahikiriire bakaakora ki?<verse eid="PSA 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:13">Zab 33:13</ref>; <ref loc="ISA 66:1">Isa 66:1</ref>; <ref loc="HAB 2:20">Hab 2:20</ref>; <ref loc="MAT 5:34">Mat 5:34</ref>; <ref loc="ACT 7:49">Byak 7:49</ref>. </char>
    </note> MUKAMA ari omuri hekalu ye erikwera,</para>
  <para style="q1" vid="PSA 11:4">Ekitebe kya MUKAMA kiri omu iguru;</para>
  <para style="q1" vid="PSA 11:4">Amaisho ge gareeba abantu, n'ekitsigye kye kibagyeza.<verse eid="PSA 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:5">Zab 5:5</ref>; <ref loc="GEN 22:1">Kut 22:1</ref>; <ref loc="JAS 1:12">Yak 1:12</ref>. </char>
    </note> MUKAMA agyeza abahikiriire;</para>
  <para style="q1" vid="PSA 11:5">Kwonka ababi n'abakunda endwano omutima gwe gubanga.<verse eid="PSA 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 75:8">Zab 75:8</ref>; <ref loc="EZK 38:22">Ezk 38:22</ref>; <ref loc="GEN 19:24">Kut 19:24</ref>. </char>
    </note> Ababi aryabagwisaho amakara g'omuriro n'obuganga nk'enjura;</para>
  <para style="q1" vid="PSA 11:6">Omuyaga gwa nyeirurwe guryaba omugabo omu kikopo kyabo.<verse eid="PSA 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:15">Zab 17:15</ref>; <ref loc="PSA 33:5">33:5</ref>; <ref loc="1JN 3:2">1 Yoh 3:2</ref>; <ref loc="REV 22:4">Kush 22:4</ref>. </char>
    </note> Ahakuba MUKAMA n'ohikiriire, kandi akunda eby'okuhikiirira;</para>
  <para style="q1" vid="PSA 11:7">Ab'emitima egororokire baryareeba amaisho ge.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" sid="PSA 12" />
  <para style="d">Okushaba Ruhanga okuturinda aha barikutureebya Aha Mukuru w'abeeshongozi ey'ekisheminiisi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:1">Isa 57:1</ref>; <ref loc="MIC 7:2">Mik 7:2</ref>. </char>
    </note> Njuna, MUKAMA! Ahakuba tihaakiriho orikutiina Ruhanga;</para>
  <para style="q1" vid="PSA 12:1">Ahabw'okuba abarikwesigwa babuzire omu bantu.<verse eid="PSA 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:9">Zab 5:9</ref>; <ref loc="JER 9:8">Yer 9:8</ref>; <ref loc="ROM 16:18">Rom 16:18</ref>; <ref loc="JAS 1:8">Yak 1:8</ref>. </char>
    </note> Buri muntu naabeihana na mutaahi we,</para>
  <para style="q1" vid="PSA 12:2">Nibagamba n'eminwa erikushungana baine emitima ebiri.<verse eid="PSA 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3" />MUKAMA aryacwaho eminwa yoona erikushungana,</para>
  <para style="q1" vid="PSA 12:3">N'orurimi orurikugamba eby'okwetunguura,<verse eid="PSA 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4" />Abo abagira bati: Turyasinguza endimi zaitu;</para>
  <para style="q1" vid="PSA 12:4">Eminwa yaitu n'eyaitu; n'oha orikututegyeka?<verse eid="PSA 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:12">Zab 9:12</ref>; <ref loc="ISA 33:10">Isa 33:10</ref>. </char>
    </note> Ahabw'okunyagwa kw'abooro, n'ahabw'okutsinda kw'abakyene,</para>
  <para style="q1" vid="PSA 12:5">Mbwenu ka nyimukye, nikwo MUKAMA arikugira,</para>
  <para style="q1" vid="PSA 12:5">Mmute omu mwanya gw'obusingye ogu atuura naayetenga.<verse eid="PSA 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:30">Zab 18:30</ref>; <ref loc="PSA 119:140">119:140</ref>; <ref loc="PRO 30:5">Enf 30:5</ref>. </char>
    </note> Ebigambo bya MUKAMA n'ebigambo bishemeire,</para>
  <para style="q1" vid="PSA 12:6">Ni nk'efeeza eshemeziibwe omu iziiko ry'ahansi,</para>
  <para style="q1" vid="PSA 12:6">Eshemeziibwe emirundi mushanju.<verse eid="PSA 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7" />MUKAMA, ogume oturinde,</para>
  <para style="q1" vid="PSA 12:7">Kandi otujune ab'obusingye obu.<verse eid="PSA 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8" />Obufamutima ku buhingurana bwasiimwa abantu,</para>
  <para style="q1" vid="PSA 12:8">Ababi bagyenda nibanaga omukono hoonahoona.<verse eid="PSA 12:8" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" sid="PSA 13" />
  <para style="d">Okushaba Ruhanga okuhwera abari omu naku Aha Mukuru w'abeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 13:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:5">Zab 79:5</ref>; <ref loc="PSA 89:46">89:46</ref>; <ref loc="JOB 13:24">Yob 13:24</ref>; <ref loc="ISA 59:2">Isa 59:2</ref>. </char>
    </note> MUKAMA, oryahitsya hi okuunyebwa obutwire bwona?</para>
  <para style="q1" vid="PSA 13:1">Oryahitsya hi okuunyima amaisho?<verse eid="PSA 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2" />Ndyahitsya hi okwehanuurira,</para>
  <para style="q1" vid="PSA 13:2">N'okurenzya eizooba nyine obusaasi omu mutima gwangye?</para>
  <para style="q1" vid="PSA 13:2">Omuzigu wangye aryahitsya hi okuunyetunguuraho?<verse eid="PSA 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 14:27">1 Sam 14:27</ref>; <ref loc="EZR 9:8">Ezr 9:8</ref>; <ref loc="PRO 29:13">Enf 29:13</ref>; <ref loc="EPH 1:18">Efe 1:18</ref>. </char>
    </note> Ai MUKAMA Ruhanga wangye, kiteekateekyeho, ongarukeymu,</para>
  <para style="q1" vid="PSA 13:3">Hwezesa amaisho gangye, ntakaagwejegyera oturo tw'okufa;<verse eid="PSA 13:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:27">Bir 32:27</ref>. </char>
    </note> Omuzigu wangye arekye kugira ati: Mmusingwire;</para>
  <para style="q1" vid="PSA 13:4">Abazigu bangye barekye kushemerererwa okutengyetsibwa kwangye.<verse eid="PSA 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:14">Zab 9:14</ref>. </char>
    </note> Kwonka nyesigire embabazi zaawe,</para>
  <para style="q1" vid="PSA 13:5">Omutima gwangye guryashemererwa okujuna kwawe.<verse eid="PSA 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:7">Zab 116:7</ref>; <ref loc="PSA 119:17">119:17</ref>. </char>
    </note> Ndyayeshongorera MUKAMA,</para>
  <para style="q1" vid="PSA 13:6">Ahakuba akangirira embabazi nyingi.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" sid="PSA 14" />
  <para style="d">Obushema bw'abantu n'obubi bwabo Aha mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 14:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1-7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 53:1-6">Zab 53:1-6</ref>; <ref loc="ROM 3:10-12">Rom 3:10-12</ref>. </char>
    </note> Omushema agira omu mutima gwe ati:</para>
  <para style="q1" vid="PSA 14:1">Ruhanga tabaho.</para>
  <para style="q1" vid="PSA 14:1">Basiisikaire nibakora ebihagaro,</para>
  <para style="q1" vid="PSA 14:1">Tihariho n'omwe orikukora gye.<note caller="-" style="x"><char style="xo" closed="false">14:1: </char><char style="xt" closed="false"><ref loc="PSA 10:4">Zab 10:4</ref>. </char></note><verse eid="PSA 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:19">Zab 102:19</ref>; <ref loc="2CH 19:3">2 Bus 19:3</ref>. </char>
    </note> MUKAMA akeema omu iguru, yaareeba abantu,</para>
  <para style="q1" vid="PSA 14:2">Ngu amanye ku haraabe hariho abarikwetegyereza</para>
  <para style="q1" vid="PSA 14:2">Bakasherura Ruhanga.<verse eid="PSA 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3" />Boona bahabire, boona hamwe basiisikaire;</para>
  <para style="q1" vid="PSA 14:3">Tihariho n'omwe orikukora gye; buzima tihariho n'omwe.<verse eid="PSA 14:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:6">Zab 79:6</ref>; <ref loc="ISA 1:3">Isa 1:3</ref>; <ref loc="JER 4:22">Yer 4:22</ref>; <ref loc="JER 10:25">10:25</ref>; <ref loc="HOS 7:7">Hos 7:7</ref>; <ref loc="MIC 3:3">Mik 3:3</ref>. </char>
    </note> Beitu enkozi z'ebibi zoona tizigira bwengye?</para>
  <para style="q1" vid="PSA 14:4">Barya abantu bangye nk'abarikurya eby'okurya,</para>
  <para style="q1" vid="PSA 14:4">Kandi tibatakira MUKAMA.<verse eid="PSA 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5" />Okwo baryagirirayo obwoba bwingi,</para>
  <para style="q1" vid="PSA 14:5">Ahakuba Ruhanga ari hamwe n'abahikiriire.<verse eid="PSA 14:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:1">Zab 46:1</ref>; <ref loc="PSA 61:3">61:3</ref>; <ref loc="PSA 91:2">91:2</ref>; <ref loc="PSA 142:5">142:5</ref>. </char>
    </note> Mushiisha enaama z'omukyene;</para>
  <para style="q1" vid="PSA 14:6">Kwonka MUKAMA n'obuhugiro bwe.<verse eid="PSA 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:1">Zab 85:1</ref>; <ref loc="PSA 126:1">126:1</ref>; <ref loc="HOS 6:11">Hos 6:11</ref>; <ref loc="JOL 3:1">Yoel 3:1</ref>. </char>
    </note> Nkaabaasibwa ki, okujunwa kwa Israeli kuruga omuri Saayuuni!</para>
  <para style="q1" vid="PSA 14:7">MUKAMA ku arigarura abantu be abaanyagirwe,</para>
  <para style="q1" vid="PSA 14:7">Yakobo aryayesiima, na Israeli ananukye.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" sid="PSA 15" />
  <para style="d">Orikwikirizibwa kuguma aha rushozi rwa Mukama Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 15:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:1-5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:3-5">Zab 24:3-5</ref>; <ref loc="ISA 33:14-16">Isa 33:14-16</ref>. </char>
    </note> MUKAMA, n'oha oriraara omu ihema ryawe?</para>
  <para style="q1" vid="PSA 15:1">N'oha orituura aha kibungo kyawe ekirikwera?<note caller="-" style="x"><char style="xo" closed="false">15:1: </char><char style="xt" closed="false"><ref loc="PSA 2:6">Zab 2:6</ref>. </char></note><verse eid="PSA 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:11">Zab 84:11</ref>; <ref loc="PSA 106:3">106:3</ref>; <ref loc="ZEC 8:16">Zek 8:16</ref>; <ref loc="EPH 4:25">Efe 4:25</ref>. </char>
    </note> Niwe ogwo ogyenda ataine ki arikuhanwa, okora eby'okuhikiirira,</para>
  <para style="q1" vid="PSA 15:2">Kandi akagamba eby'amazima aihire aha mutima;<verse eid="PSA 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 15:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:1">Kur 23:1</ref>; <ref loc="LEV 19:16">Lev 19:16</ref>. </char>
    </note> Otabeiherera bandi na rurimi rwe,</para>
  <para style="q1" vid="PSA 15:3">N'obu kwakuba okukora kubi mugyenzi we,</para>
  <para style="q1" vid="PSA 15:3">Nari okuyaaga mutaahi we;<verse eid="PSA 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 15:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 9:18-20">Yos 9:18-20</ref>; <ref loc="JDG 11:35">Bar 11:35</ref>; <ref loc="EST 3:2">Est 3:2</ref>. </char>
    </note> Otaine mugasho agaywa omu maisho ge,</para>
  <para style="q1" vid="PSA 15:4">Kwonka abatiina MUKAMA abaha ekitiinisa;</para>
  <para style="q1" vid="PSA 15:4">Ku arahira, n'obu afeerwa, tahinduka.<verse eid="PSA 15:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 15:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:5: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:8">Kur 23:8</ref>; <ref loc="DEU 23:19">Bir 23:19</ref>; <ref loc="EZK 18:8">Ezk 18:8</ref>; <ref loc="EZK 16:19">16:19</ref>. </char>
    </note> Taguza mpiiha ze ahabw'enshaagi ehinguraine,</para>
  <para style="q1" vid="PSA 15:5">N'obu kwakuba okurya enguzi, ngu asingise rubanja abatarwine.</para>
  <para style="q1" vid="PSA 15:5">Okora ebyo taritengyetsibwa ebiro byona.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" sid="PSA 16" />
  <para style="d">Mukama nk'oku ari omugabo gw'abarikumutiina Mikitaamu ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:20">Zab 25:20</ref>. </char>
    </note> Ndinda, ai Ruhanga, ahakuba niiwe nyesiga.<verse eid="PSA 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:25">Zab 73:25</ref>. </char>
    </note> Nkagambira MUKAMA nti: Niiwe Mukama wangye,</para>
  <para style="q1" vid="PSA 16:2">Tiinyine karungi koona ahu otari.<verse eid="PSA 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:6">Bir 7:6</ref>; <ref loc="1PE 2:9">1 Pet 2:9</ref>. </char>
    </note> Abarikwera abari omu nsi nibo barungi,</para>
  <para style="q1" vid="PSA 16:3">Abu nshemerererwa n'omutima gwangye gwona.<verse eid="PSA 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:4: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:13">Kur 23:13</ref>; <ref loc="JOS 23:7">Yos 23:7</ref>. </char>
    </note> Abaimuura MUKAMA bakeehongyera ruhanga ondiijo</para>
  <para style="q1" vid="PSA 16:4">Beekanyisiza obusaasi;</para>
  <para style="q1" vid="PSA 16:4">Ebihongwa byabo by'eshagama tindibihayo,</para>
  <para style="q1" vid="PSA 16:4">N'obu kwakuba okugamba aha maziina gaabo.<verse eid="PSA 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:5">Zab 23:5</ref>; <ref loc="PSA 119:57">119:57</ref>; <ref loc="NUM 18:20">Kub 18:20</ref>. </char>
    </note> MUKAMA n'omugabo gw'obuhunguzi bwangye, n'egabo omu kikopo kyangye;</para>
  <para style="q1" vid="PSA 16:5">Niiwe orinda ebyangye.<verse eid="PSA 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:55">Zab 78:55</ref>. </char>
    </note> Emigoye ekangyerera emyanya erikushemeza,</para>
  <para style="q1" vid="PSA 16:6">N'ekya buzima nyine obuhunguzi burungi.<verse eid="PSA 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:7: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:9-12">1 Sam 23:9-12</ref>; <ref loc="2SA 5:18">2 Sam 5:18</ref>, <ref loc="2SA 5:19">19</ref>. </char>
    </note> Ninsiima MUKAMA ompa obwengye,</para>
  <para style="q1" vid="PSA 16:7">Kandi nyekiro omutima gwangye guunyegyesa.<verse eid="PSA 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:8-11: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:25-28">Byak 2:25-28</ref>. </char>
    </note> MUKAMA niwe ntaho amaisho obutoosha;</para>
  <para style="q1" vid="PSA 16:8">Tinditengyetsibwa, ahakuba ari aha rubaju rwangye rwa buryo.<note caller="-" style="x"><char style="xo" closed="false">16:8: </char><char style="xt" closed="false"><ref loc="PSA 109:31">Zab 109:31</ref>. </char></note><verse eid="PSA 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9" />Nikyo omutima gwangye gushemerererwa, n'amagara gangye gakeesiima;</para>
  <para style="q1" vid="PSA 16:9">N'omubiri gwangye guryaguma guri buhooro.<verse eid="PSA 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:9">Zab 49:9</ref>, <ref loc="PSA 49:15">15</ref>; <ref loc="MRK 1:24">Mak 1:24</ref>; <ref loc="LUK 1:35">Luk 1:35</ref>; <ref loc="ACT 13:35">Byak 13:35</ref>. </char>
    </note> Ahakuba toritsiga magara gangye Kuzimu,</para>
  <para style="q1" vid="PSA 16:10">N'obu kwakuba okureka Orikwera waawe kujunda.<verse eid="PSA 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:6">Zab 21:6</ref>; <ref loc="PSA 36:8">36:8</ref>; <ref loc="MAT 7:14">Mat 7:14</ref>. </char>
    </note> Oryanyoreka omuhanda gw'amagara,</para>
  <para style="q1" vid="PSA 16:11">Omu maisho gaawe hariho okushemererwa kwingi munonga;</para>
  <para style="q1" vid="PSA 16:11">Omu mukono gwawe gwa buryo harimu ebirikushemeza ebiro byona.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" sid="PSA 17" />
  <para style="d">Ohikiriire okushaba okujunwa omu mikono y'abarikumuhiiga Okushaba kwa Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 17:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 61:1">Zab 61:1</ref>; <ref loc="PSA 142:6">142:6</ref>. </char>
    </note> Hurira eby'amazima, ai MUKAMA; ote omutima aha kutaka kwangye;</para>
  <para style="q1" vid="PSA 17:1">Otegye okutu okushaba kwangye, okutarikuruga mu minwa y'obugobya.<verse eid="PSA 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2" />K'obe niiwe wancwera orubanja;</para>
  <para style="q1" vid="PSA 17:2">Amaisho gaawe gareebe eby'oburyo!<verse eid="PSA 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:10">Yob 23:10</ref>; <ref loc="ZEC 13:9">Zek 13:9</ref>; <ref loc="1PE 1:7">1 Pet 1:7</ref>. </char>
    </note> Ku oraarengye omutima gwangye, wantaayaayira nyekiro,</para>
  <para style="q1" vid="PSA 17:3">Wangyeza, torikwija kundeebamu kibi kyona;</para>
  <para style="q1" vid="PSA 17:3">Mmaririire kutashiisha n'akanwa kangye.<verse eid="PSA 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4" />Omu by'emirimo y'abantu, ahabw'ekigambo ky'eminwa yaawe</para>
  <para style="q1" vid="PSA 17:4">Nyetantaire emihanda y'abanyamwaga.<verse eid="PSA 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:11">Yob 23:11</ref>. </char>
    </note> Tinkarugaga mu mihanda yaawe,</para>
  <para style="q1" vid="PSA 17:5">N'ebigyere byangye tibikateereraga.<verse eid="PSA 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:1">Zab 116:1</ref>, <ref loc="PSA 116:2">2</ref>. </char>
    </note> Ai Ruhanga, nkutakiire, ahakuba nimmanya ngu noija kungarukamu.</para>
  <para style="q1" vid="PSA 17:6">Ontegye okutu, ohurire ebigambo byangye.<verse eid="PSA 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7" />Oyorekye embabazi zaawe ez'okutangaaza,</para>
  <para style="q1" vid="PSA 17:7">Iwe Omujuni w'abo abasherura obuhungiro aha rubaju rwawe rwa buryo,</para>
  <para style="q1" vid="PSA 17:7">Nibahunga abazigu baabo.<verse eid="PSA 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:7">Zab 36:7</ref>; <ref loc="PSA 91:4">91:4</ref>; <ref loc="MAT 23:37">Mat 23:37</ref>; <ref loc="RUT 2:12">Rus 2:12</ref>; <ref loc="DEU 32:10">Bir 32:10</ref>. </char>
    </note> Ondinde nk'embone y'eriisho,</para>
  <para style="q1" vid="PSA 17:8">Ombumbatire n'amapapa gaawe,<verse eid="PSA 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9" />Onkize ababi abannyaga,</para>
  <para style="q1" vid="PSA 17:9">Nibo bazigu bangye abanyehinguririize, abarikwenda kuunyita.<verse eid="PSA 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:7">Zab 73:7</ref>; <ref loc="PSA 119:70">119:70</ref>; <ref loc="ISA 6:10">Isa 6:10</ref>; <ref loc="JOB 15:27">Yob 15:27</ref>. </char>
    </note> Emitima yaabo terikwenda kusaasira;</para>
  <para style="q1" vid="PSA 17:10">Akanwa kaabo kagamba eby'amaryo.<verse eid="PSA 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:11: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 23:26">1 Sam 23:26</ref>. </char>
    </note> Bantangatangire, bambuza obutooro;</para>
  <para style="q1" vid="PSA 17:11">Banzooreire amaisho kunteera ahansi.<verse eid="PSA 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:9">Zab 10:9</ref>. </char>
    </note> Nibashusha nk'entare eine amairu g'eki erikwenda kwita,</para>
  <para style="q1" vid="PSA 17:12">Nk'ekitsigazi ky'entare ekigwereire aheekiikire.<verse eid="PSA 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13" />Imuka, ai MUKAMA, obatangye omu maisho, obatuure ahansi!</para>
  <para style="q1" vid="PSA 17:13">Okize amagara gangye ababi na rurara yaawe;<verse eid="PSA 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:18">Zab 10:18</ref>; <ref loc="JOB 21:8-11">Yob 21:8-11</ref>; <ref loc="MAT 6:2">Mat 6:2</ref>, <ref loc="MAT 6:5">5</ref>, <ref loc="MAT 6:16">16</ref>; <ref loc="LUK 16:8">Luk 16:8</ref>, <ref loc="LUK 16:25">25</ref>. </char>
    </note> Ai MUKAMA, onjune abantu babi n'omukono gwawe,</para>
  <para style="q1" vid="PSA 17:14">Abu omugabo gwabo guri ogw'ensi egi.</para>
  <para style="q1" vid="PSA 17:14">Oijuze enda zaabo ebi waababiikiire,</para>
  <para style="q1" vid="PSA 17:14">N'abaana baabo babihaagye,</para>
  <para style="q1" vid="PSA 17:14">Kandi nabo babitsigire n'abeereere baabo.<verse eid="PSA 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">17:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="1JN 3:2">1 Yoh 3:2</ref>; <ref loc="JOB 19:26">Yob 19:26</ref>, <ref loc="JOB 19:27">27</ref>. </char>
    </note> Kwonka nyowe ndyakureeba aha maisho ndi ohikiriire;</para>
  <para style="q1" vid="PSA 17:15">Ku ndisisiimuka, ndyamarwa okureeba oku orikushusha.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" sid="PSA 18" />
  <para style="d">Okusiima Mukama ahabw'okujuna abantu be Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi omuheereza wa Mukama, owaamweshongoreire aha izooba eri yaamujuniireho omu mikono y'abazigu be boona, n'omu mukono gwa Saulo, naagira ati:</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 18:1" />Ninkukunda, ai MUKAMA, maani gangye.<verse eid="PSA 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:2-50: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 22:2-51">2 Sam 22:2-51</ref>. </char>
    </note> MUKAMA n'orukiri rwangye, orugo rwangye orugumire, kandi Omujuni wangye;</para>
  <para style="q1" vid="PSA 18:2">Ruhanga wangye, orukiri rwangye orugumire oru mpungiramu,</para>
  <para style="q1" vid="PSA 18:2">Engabo yangye, eihembe ry'okujunwa kwangye,</para>
  <para style="q1" vid="PSA 18:2">Kandi omunaara gwangye omuraingwa.<note caller="-" style="x"><char style="xo" closed="false">18:2: </char><char style="xt" closed="false"><ref loc="GEN 15:1">Kut 15:1</ref>; <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="1SA 2:2">1 Sam 2:2</ref>; <ref loc="PSA 9:9">Zab 9:9</ref>; <ref loc="PSA 18:30">18:30</ref>, <ref loc="PSA 18:31">31</ref>; <ref loc="PSA 31:3">31:3</ref>; <ref loc="PSA 91:2">91:2</ref>; <ref loc="LUK 1:69">Luk 1:69</ref>; <ref loc="HEB 2:13">Heb 2:13</ref>. </char></note><verse eid="PSA 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1">Zab 48:1</ref>; <ref loc="PSA 96:4">96:4</ref>. </char>
    </note> Ndyatakira MUKAMA oshemereire kuhimbisibwa;</para>
  <para style="q1" vid="PSA 18:3">Obwo nibwo ndikira abazigu bangye.<verse eid="PSA 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:6">Zab 32:6</ref>; <ref loc="PSA 116:3">116:3</ref>. </char>
    </note> Emigoye ya Rufu ekanzingazinga,</para>
  <para style="q1" vid="PSA 18:4">N'emyegyemure y'okuhwerekyerera yantiinisa;<verse eid="PSA 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5" />Emigoye y'Okuzimu ekanzingazinga;</para>
  <para style="q1" vid="PSA 18:5">Emitego ya Rufu yantanga omu maisho.<verse eid="PSA 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:4">Zab 11:4</ref>; <ref loc="PSA 120:1">120:1</ref>; <ref loc="JON 2:2">Yon 2:2</ref>. </char>
    </note> Omu busaasi bwangye naayeta MUKAMA,</para>
  <para style="q1" vid="PSA 18:6">Naatakira Ruhanga wangye kumpa emikono;</para>
  <para style="q1" vid="PSA 18:6">Yaahurira eiraka ryangye ari omuri hekalu ye,</para>
  <para style="q1" vid="PSA 18:6">N'okurira kwangye kwahika omu matu ge.<verse eid="PSA 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:18">Zab 77:18</ref>; <ref loc="ACT 4:31">Byak 4:31</ref>; <ref loc="ACT 16:26">16:26</ref>. </char>
    </note> Bwanyima ensi yaatengyeta, yaatetema;</para>
  <para style="q1" vid="PSA 18:7">N'emisingi y'ebibungo yaanyiganyiga,</para>
  <para style="q1" vid="PSA 18:7">Yaatengyetsibwa ekiniga kye.<verse eid="PSA 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:9">Zab 21:9</ref>. </char>
    </note> Omwika gukaruga omu nyindo ze,</para>
  <para style="q1" vid="PSA 18:8">N'omu kanwa ke haarugamu omuriro ogurikurya busha,</para>
  <para style="q1" vid="PSA 18:8">Gwayatsya amakara.<verse eid="PSA 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:5">Zab 144:5</ref>; <ref loc="EXO 20:21">Kur 20:21</ref>; <ref loc="ISA 64:1">Isa 64:1</ref>. </char>
    </note> Kandi akainamya eiguru, yaashuuma,</para>
  <para style="q1" vid="PSA 18:9">Omwirima ndindindi guri ahansi y'ebigyere bye;<verse eid="PSA 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:3">Zab 104:3</ref>. </char>
    </note> Yaagaruka aheekirwe kerubi,</para>
  <para style="q1" vid="PSA 18:10">Yaija naarahuka ari aha mapapa g'omuyaga.<verse eid="PSA 18:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:2">Zab 97:2</ref>; <ref loc="JOB 36:29">Yob 36:29</ref>. </char>
    </note> Akahindura omwirima obweshereko nk'eihema erimwehinguririize,</para>
  <para style="q1" vid="PSA 18:11">N'ebicu ebikwaitse, ebitimbire omwirima mwingi gw'enjura,</para>
  <para style="q1" vid="PSA 18:11">Yaabigira eky'okumusangira.<verse eid="PSA 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12" />Omu kumurinkana okwabaire kuri omu maisho ge</para>
  <para style="q1" vid="PSA 18:12">Haarugamu orubaare n'amakara garikwaka nibiruga omu bicu bye.<verse eid="PSA 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:13: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:10">1 Sam 2:10</ref>; <ref loc="1SA 7:10">7:10</ref>; <ref loc="JOB 37:4">Yob 37:4</ref>; <ref loc="PSA 29:3-9">Zab 29:3-9</ref>; <ref loc="ISA 30:30">Isa 30:30</ref>. </char>
    </note> MUKAMA yaahindira omu iguru,</para>
  <para style="q1" vid="PSA 18:13">Rukira-boona yaagamba n'eiraka rye,</para>
  <para style="q1" vid="PSA 18:13">Haija orubaare n'amakara agarikwaka;<verse eid="PSA 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:17">Zab 77:17</ref>; <ref loc="PSA 144:6">144:6</ref>; <ref loc="HAB 3:11">Hab 3:11</ref>. </char>
    </note> Yaarasha emyambi ye, yaabataataanisa,</para>
  <para style="q1" vid="PSA 18:14">Niyo mirabyo ye mingi, yaababinga.<verse eid="PSA 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:8">Kur 15:8</ref>; <ref loc="NAM 1:4">Nah 1:4</ref>. </char>
    </note> Obwo nibwo emikura y'amaizi yaareebwa,</para>
  <para style="q1" vid="PSA 18:15">N'emisingi y'ensi ekashuuruuka</para>
  <para style="q1" vid="PSA 18:15">Ahabw'okuhuuha kw'amaani okw'omwitsyo gw'omu nyindo zaawe.<verse eid="PSA 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:7">Zab 144:7</ref>. </char>
    </note> Yankununkirira ari ahaiguru, yankwata,</para>
  <para style="q1" vid="PSA 18:16">Yaanyiha omu maizi maingi;<verse eid="PSA 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17" />Yankiza omuzigu wangye ow'amaani,</para>
  <para style="q1" vid="PSA 18:17">N'abo abaabaire nibaanyanga, ahakuba bakaba nibankiza amaani.<verse eid="PSA 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18" />Bakampurira aha izooba ry'okureeberaho enaku;</para>
  <para style="q1" vid="PSA 18:18">Kwonka MUKAMA yaaba obwegamo bwangye.<verse eid="PSA 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:8">Zab 22:8</ref>; <ref loc="PSA 31:8">31:8</ref>; <ref loc="PSA 118:5">118:5</ref>. </char>
    </note> Yaaziinyihamu, yanta omu mwanya ogugarami;</para>
  <para style="q1" vid="PSA 18:19">Yanjuna, ahabw'okuba akaba nanshemerererwa.<verse eid="PSA 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:20: </char>
      <char style="xt" closed="false">
        <ref loc="RUT 2:12">Rus 2:12</ref>; <ref loc="1SA 24:19">1 Sam 24:19</ref>; <ref loc="1KI 8:32">1 Bag 8:32</ref>. </char>
    </note> MUKAMA akampa ebihembo nk'okuhikiirira kwangye oku kuri,</para>
  <para style="q1" vid="PSA 18:20">Yanzimuurira nk'okushemera kw'emikono yangye oku kuri;<verse eid="PSA 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:1">Kut 17:1</ref>; <ref loc="1KI 14:18">1 Bag 14:18</ref>. </char>
    </note> ahakuba nkagumira omu mihanda ya MUKAMA,</para>
  <para style="q1" vid="PSA 18:21">Kandi tinkacumuraga kuruga ahari Ruhanga wangye.<verse eid="PSA 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22" />Ebiragiro bye byona bikaba biri omu maisho gangye,</para>
  <para style="q1" vid="PSA 18:22">Tinkeetantaraga bi yaaragiire.<verse eid="PSA 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23" />Nkaba ntaine ky'okuhanwa omu maisho ge,</para>
  <para style="q1" vid="PSA 18:23">Kandi nkeerinda okushiisha<verse eid="PSA 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24" />Nikyo MUKAMA yaanyihuriire, nk'okuhikiirira kwangye oku kuri,</para>
  <para style="q1" vid="PSA 18:24">Kandi akanzimuurira ebishemereire okushemera kw'emikono yangye omu maisho ge.<verse eid="PSA 18:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:25: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:7">Mat 5:7</ref>; <ref loc="MAT 18:33">18:33</ref>. </char>
    </note> Aha munyambabazi oyeyoreka ori ow'embabazi;</para>
  <para style="q1" vid="PSA 18:25">Ahari ohikire oyeyoreka ori ohikire;<verse eid="PSA 18:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:26: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:23">Lev 26:23</ref>, <ref loc="LEV 26:24">24</ref>; <ref loc="PRO 3:34">Enf 3:34</ref>; <ref loc="ROM 1:28">Rom 1:28</ref>. </char>
    </note> Ahari oshemeire oyeyoreka ori oshemeire;</para>
  <para style="q1" vid="PSA 18:26">Aha mugomi oyeyoreka ogumire.<verse eid="PSA 18:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:27: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:7">Kur 3:7</ref>; <ref loc="PRO 6:17">Enf 6:17</ref>; <ref loc="LUK 1:51">Luk 1:51</ref>. </char>
    </note> Ahakuba ojuna abacureezi;</para>
  <para style="q1" vid="PSA 18:27">Konka ab'amaisho g'amaryo obagarura ahansi.<verse eid="PSA 18:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:17">Zab 132:17</ref>; <ref loc="1KI 11:36">1 Bag 11:36</ref>. </char>
    </note> Eego, niiwe okongyeza etabaaza yangye;</para>
  <para style="q1" vid="PSA 18:28">MUKAMA Ruhanga wangye niwe ayakira omwirima gwangye.<verse eid="PSA 18:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29" />Eego, ahabwawe nimbaasa kurwanisa omutwe gw'engabo,</para>
  <para style="q1" vid="PSA 18:29">Ahabw'okuhwerwa Ruhanga wangye nimbaasa kuguruka orugo.<verse eid="PSA 18:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:30: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:6">Zab 12:6</ref>; <ref loc="PSA 18:2">18:2</ref>; <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="MAT 5:48">Mat 5:48</ref>. </char>
    </note> Ruhanga ogwo, omuhanda gwe n'oguhikire;</para>
  <para style="q1" vid="PSA 18:30">Okuraganisa kwa MUKAMA kurengirwe, n'okw'amazima;</para>
  <para style="q1" vid="PSA 18:30">Niwe ngabo ekingira abamuhungiraho boona.<verse eid="PSA 18:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:8">Zab 86:8</ref>; <ref loc="DEU 32:31">Bir 32:31</ref>. </char>
    </note> Mbwenu n'oha oba Ruhanga otari MUKAMA?</para>
  <para style="q1" vid="PSA 18:31">N'oha oba Rukiri, otari Ruhanga waitu?<verse eid="PSA 18:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 101:2">Zab 101:2</ref>, <ref loc="PSA 101:6">6</ref>; <ref loc="1SA 2:4">1 Sam 2:4</ref>. </char>
    </note> Niwe Ruhanga onzirika amaani,</para>
  <para style="q1" vid="PSA 18:32">Akashemeza omuhanda gwangye.<verse eid="PSA 18:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:33: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 58:14">Isa 58:14</ref>; <ref loc="HAB 3:19">Hab 3:19</ref>. </char>
    </note> Agira ebigyere byangye nk'eby'empara,</para>
  <para style="q1" vid="PSA 18:33">Anyemereza aha nengo mpamire.<verse eid="PSA 18:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:1">Zab 144:1</ref>. </char>
    </note> Ayegyesa engaro zangye okurwana,</para>
  <para style="q1" vid="PSA 18:34">Ngu emikono yangye ebaase kureega obuta bw'omuringa.<verse eid="PSA 18:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:35: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:9">Isa 63:9</ref>. </char>
    </note> Ompaire engabo y'okujuna kwawe,</para>
  <para style="q1" vid="PSA 18:35">N'omukono gwawe gwa buryo gumbangiire,</para>
  <para style="q1" vid="PSA 18:35">Okutwaza gye kwawe kunkurize.<verse eid="PSA 18:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:19">Zab 18:19</ref>; <ref loc="PRO 4:12">Enf 4:12</ref>. </char>
    </note> Ompanguhiize ah'okuraba,</para>
  <para style="q1" vid="PSA 18:36">Ebigyere byangye tibyaterera.<verse eid="PSA 18:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37" />Nkakurata abazigu bangye, naabahika,</para>
  <para style="q1" vid="PSA 18:37">Kandi tindagarukire okuhitsya obu baahweireho;<verse eid="PSA 18:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38" />Naabacumita, tibaabaasa kwimuka,</para>
  <para style="q1" vid="PSA 18:38">Baagwa ahansi y'ebigyere byangye,<verse eid="PSA 18:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39" />Ahakuba okanzirika amaani g'okurwana,</para>
  <para style="q1" vid="PSA 18:39">Waagomoora abaabaire nibaija kundwanisa.<verse eid="PSA 18:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:40: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:12">Zab 21:12</ref>; <ref loc="EXO 23:27">Kur 23:27</ref>. </char>
    </note> Okareetera abazigu bangye kumpunga,</para>
  <para style="q1" vid="PSA 18:40">Kandi n'abaabaire nibanyanga naabacwekyereza.<verse eid="PSA 18:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:41: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:9">Yob 27:9</ref>; <ref loc="PRO 1:28">Enf 1:28</ref>. </char>
    </note> Baataka, kwonka baabura kijuna;</para>
  <para style="q1" vid="PSA 18:41">Baatakira MUKAMA, tiyaabagarukamu.<verse eid="PSA 18:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42" />Naabateera, naabatuntumura nk'oku omuyaga gugira omucuucu;</para>
  <para style="q1" vid="PSA 18:42">Naabanaga nk'ebyondo by'omu nguuto.<verse eid="PSA 18:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:43: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:8">Zab 2:8</ref>; <ref loc="ISA 55:5">Isa 55:5</ref>; <ref loc="2SA 3:1">2 Sam 3:1</ref>; <ref loc="2SA 8:1-14">8:1-14</ref>; <ref loc="2SA 19:9">19:9</ref>, <ref loc="2SA 19:43">43</ref>. </char>
    </note> Okankiza okurwana n'amahanga,</para>
  <para style="q1" vid="PSA 18:43">Wampindura omukuru waago;</para>
  <para style="q1" vid="PSA 18:43">Naaheerezibwa abantu abu ntakamanyaga.<verse eid="PSA 18:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44" />Ahonaaho abanyamahanga, ku bampuriirre,</para>
  <para style="q1" vid="PSA 18:44">Baanyorobera, baanyehongyera.<verse eid="PSA 18:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:45: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:17">Mik 7:17</ref>. </char>
    </note> Abo banyamahanga bakeehwa amatsiko,</para>
  <para style="q1" vid="PSA 18:45">Baaruga omu bigo byabo nibatetema.<verse eid="PSA 18:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46" />MUKAMA n'ohuriire; Rukiri rwangye ahimbisibwe!</para>
  <para style="q1" vid="PSA 18:46">Ruhanga ow'okujunwa kwangye aheebwe ekitiinisa.<verse eid="PSA 18:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:47: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:3">Zab 47:3</ref>. </char>
    </note> Niwe Ruhanga owampooreire,</para>
  <para style="q1" vid="PSA 18:47">Akangomoorera amahanga;<verse eid="PSA 18:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:48: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:1">Zab 59:1</ref>. </char>
    </note> Akankiza abazigu;</para>
  <para style="q1" vid="PSA 18:48">Eego, okanta ahaiguru y'abarikundwanisa,</para>
  <para style="q1" vid="PSA 18:48">Waanyiha omu mikono y'abanyamwaga.<verse eid="PSA 18:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:49: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:9">Rom 15:9</ref>. </char>
    </note> N'ahabw'ekyo, ai MUKAMA, ndyakusiimira omu mahanga,</para>
  <para style="q1" vid="PSA 18:49">Kandi nyeshongore eby'okuhimbisa eiziina ryawe.<verse eid="PSA 18:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:50: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:2">Zab 2:2</ref>; <ref loc="PSA 89:29">89:29</ref>; <ref loc="PSA 144:10">144:10</ref>; <ref loc="2SA 7:12">2 Sam 7:12</ref>, <ref loc="2SA 7:13">13</ref>. </char>
    </note> Omugabe ou yaataireho amuha obusinguzi bwingi,</para>
  <para style="q1" vid="PSA 18:50">Kandi ayoreka ou yaashukireho amajuta embabazi,</para>
  <para style="q1" vid="PSA 18:50">Niwe Daudi n'abaijukuru ebiro n'ebiro.<verse eid="PSA 18:50" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" sid="PSA 19" />
  <para style="d">Ekitiinisa kya Mukama ekirikureeberwa omu bi yaahangire n'omu Biragiro bye Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 19:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:1-6: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:20">Rom 1:20</ref>. </char>
    </note> Eiguru rimanyisa ekitiinisa kya Ruhanga,</para>
  <para style="q1" vid="PSA 19:1">N'omwanya gw'ahaiguru gworeka emirimo y'emikono ye.<verse eid="PSA 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2" />Nyomushana egambira nyomushana endiijo ebigambo,</para>
  <para style="q1" vid="PSA 19:2">N'ekiro kimanyisa ekindi kiro obwengye.<verse eid="PSA 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3" />Tihariho rurimi, n'obu byakuba ebigambo;</para>
  <para style="q1" vid="PSA 19:3">Amaraka gaabyo tigahurirwa.<verse eid="PSA 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:4: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 10:18">Rom 10:18</ref>. </char>
    </note> Kwonka eiraka ryabyo ribuga ensi yoona,</para>
  <para style="q1" vid="PSA 19:4">Kandi n'ebigambo byabyo bihika aha muheru gw'ensi.</para>
  <para style="q1" vid="PSA 19:4">Omuribyo nimwo yaateire eihema ahabw'eizooba,<verse eid="PSA 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:5: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 5:31">Bar 5:31</ref>. </char>
    </note> Riri nka kishwera oku ashohora omu kishengye kye,</para>
  <para style="q1" vid="PSA 19:5">Rishemererwa nk'ow'amaani, niriraba omu rugyendo rwaryo.<verse eid="PSA 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:6: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 7:12">Rom 7:12</ref>; <ref loc="ECC 1:5">Mub 1:5</ref>, <ref loc="ECC 1:7">7</ref>, <ref loc="ECC 1:8">8</ref>. </char>
    </note> Riruga aha muheru gw'eiguru,</para>
  <para style="q1" vid="PSA 19:6">Ryehinguririza, rihika aha gundi;</para>
  <para style="q1" vid="PSA 19:6">Tihariho kisherekwa okwotsya kwaryo.<verse eid="PSA 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 11:25">Mat 11:25</ref>; <ref loc="2TI 3:15">2 Tim 3:15</ref>. </char>
    </note> Ekiragiro kya MUKAMA kihikire,</para>
  <para style="q1" vid="PSA 19:7">Kigarura omutima omunda;</para>
  <para style="q1" vid="PSA 19:7">Ebi MUKAMA yaahamize n'eby'okwesigwa,</para>
  <para style="q1" vid="PSA 19:7">Biha obwengye otabwine;<verse eid="PSA 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:6">Zab 12:6</ref>; <ref loc="PSA 13:3">13:3</ref>. </char>
    </note> Eby'okwegyesa bya MUKAMA bihikire,</para>
  <para style="q1" vid="PSA 19:8">Bigwisa gye omutima;</para>
  <para style="q1" vid="PSA 19:8">Ekiragiro kya MUKAMA kishemeire,</para>
  <para style="q1" vid="PSA 19:8">Kihwezesa amaisho;<verse eid="PSA 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:142">Zab 119:142</ref>, <ref loc="PSA 119:151">151</ref>. </char>
    </note> Okutiina MUKAMA ni kurungi,</para>
  <para style="q1" vid="PSA 19:9">Kugumaho ebiro byona;</para>
  <para style="q1" vid="PSA 19:9">Ebi MUKAMA aragiira n'eby'amazima,</para>
  <para style="q1" vid="PSA 19:9">Kandi n'eby'okuhikiirira buzima.<verse eid="PSA 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:103">Zab 119:103</ref>, <ref loc="PSA 119:127">127</ref>. </char>
    </note> Bishemereire kwetengwa okukira ezaabu,</para>
  <para style="q1" vid="PSA 19:10">Nangwa n'ezaabu enungi munonga;</para>
  <para style="q1" vid="PSA 19:10">Binuzire okukira obwoki,</para>
  <para style="q1" vid="PSA 19:10">Oburikutoonya niburuga omu ngabo yaabwo.<verse eid="PSA 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11" />Kandi nibyo bihabura omwiru waawe,</para>
  <para style="q1" vid="PSA 19:11">N'omu kubyorobera harimu ebihembo bingi.<verse eid="PSA 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:32">Yob 34:32</ref>; <ref loc="PSA 90:8">Zab 90:8</ref>; <ref loc="1CO 4:4">1 Kor 4:4</ref>. </char>
    </note> N'oha orikubaasa kumanya ebishobyo bye?</para>
  <para style="q1" vid="PSA 19:12">Onshemezeho ebibi ebisherekirwe.<verse eid="PSA 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:13: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 6:12">Rom 6:12</ref>, <ref loc="ROM 6:14">14</ref>; <ref loc="PSA 119:133">Zab 119:133</ref>; <ref loc="1SA 25:33">1 Sam 25:33</ref>, <ref loc="1SA 25:34">34</ref>, <ref loc="1SA 25:39">39</ref>; <ref loc="NUM 15:30">Kub 15:30</ref>. </char>
    </note> Kandi ozibire omwiru waawe kukora ebibi nkana;</para>
  <para style="q1" vid="PSA 19:13">Otabiikiriza kuntegyeka!</para>
  <para style="q1" vid="PSA 19:13">Obwo ndyaba otaine ky'okuhanwa,</para>
  <para style="q1" vid="PSA 19:13">Kandi tindigira rubanja rw'okushiisha okuhinguraine.<verse eid="PSA 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:25">Yob 19:25</ref>. </char>
    </note> Ebigambo by'omu kanwa kangye,</para>
  <para style="q1" vid="PSA 19:14">N'okuteekateeka kw'omu mutima gwangye</para>
  <para style="q1" vid="PSA 19:14">Bisiimwe omu maisho gaawe,</para>
  <para style="q1" vid="PSA 19:14">Ai MUKAMA, orukiri rwangye, kandi omucunguzi wangye.<verse eid="PSA 19:14" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" sid="PSA 20" />
  <para style="d">Okushaba obusinguzi Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 20:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 35:3">Kut 35:3</ref>; <ref loc="PSA 59:1">Zab 59:1</ref>. </char>
    </note> MUKAMA akugarukyemu aha izooba ry'okureeberaho enaku,</para>
  <para style="q1" vid="PSA 20:1">Eiziina rya Ruhanga wa Yakobo rikurinde!<verse eid="PSA 20:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2" />Akutwekyere okuhwera okurikuruga omu Mwanya ogurikwera,</para>
  <para style="q1" vid="PSA 20:2">Akuhe amaani agarikuruga omuri Saayuuni.<verse eid="PSA 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:3: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 10:4">Byak 10:4</ref>. </char>
    </note> Aijukye empongano zaawe zoona,</para>
  <para style="q1" vid="PSA 20:3">aikirize ebitambo byawe ebyokize!<verse eid="PSA 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:2">Zab 21:2</ref>. </char>
    </note> Akuhe eki omutima gwawe gurikwetenga,</para>
  <para style="q1" vid="PSA 20:4">Kandi ahikiirize enaama zaawe zoona!<verse eid="PSA 20:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:4">Zab 60:4</ref>; <ref loc="1SA 17:45">1 Sam 17:45</ref>. </char>
    </note> Turyateera akaari k'okushemerererwa okusingura kwawe,</para>
  <para style="q1" vid="PSA 20:5">Kandi omu iziina rya Ruhanga waitu turyaimutsya endango zaitu.</para>
  <para style="q1" vid="PSA 20:5">MUKAMA ahikiirize ebi orikushaba byona!<verse eid="PSA 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:8">Zab 28:8</ref>. </char>
    </note> Mbwenu nimmanyira kimwe ngu MUKAMA aryahwera ou yaashukireho amajuta,</para>
  <para style="q1" vid="PSA 20:6">Amugarukyemu, naayema omu iguru rye eririkwera,</para>
  <para style="q1" vid="PSA 20:6">N'obusinguzi bw'amaani g'omukono gwe gwa buryo.<verse eid="PSA 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:7: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 32:8">2 Bus 32:8</ref>; <ref loc="PRO 21:31">Enf 21:31</ref>; <ref loc="ISA 31:1">Isa 31:1</ref>. </char>
    </note> Abamwe beesiga ebigaari by'okurwanisa, n'abandi beesiga embaraasi,</para>
  <para style="q1" vid="PSA 20:7">Kwonka itwe twesiga eiziina rya MUKAMA Ruhanga waitu.<verse eid="PSA 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8" />Bo baryainama, bagwe;</para>
  <para style="q1" vid="PSA 20:8">Kwonka itwe turyaimuka, twemerere tuhamire.<verse eid="PSA 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9" />Ai MUKAMA, ohe omugabe okusingura;</para>
  <para style="q1" vid="PSA 20:9">Kandi ku turaakutakire, otuhurire.<verse eid="PSA 20:9" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" sid="PSA 21" />
  <para style="d">Okusiima ahabw'obusinguzi</para>
  <para style="q1">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 21:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:7">Zab 28:7</ref>, <ref loc="PSA 28:8">8</ref>. </char>
    </note> Ai MUKAMA, omugabe naayesiimira amaani gaawe;</para>
  <para style="q1" vid="PSA 21:1">Eshi okuhwera kwawe naakushemerererwa munonga!<verse eid="PSA 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:4">Zab 20:4</ref>. </char>
    </note> Omuhaire eki omutima gwe gurikwetenga,</para>
  <para style="q1" vid="PSA 21:2">Kandi tomwimire ki eminwa ye eshabire.<verse eid="PSA 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:3: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 20:2">1 Bus 20:2</ref>. </char>
    </note> Ahakuba omubuganiise eby'emigisha ebirungi,</para>
  <para style="q1" vid="PSA 21:3">Waamujweka ekirunga ky'ezaabu enungi aha mutwe.<verse eid="PSA 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 61:6">Zab 61:6</ref>; <ref loc="PSA 91:16">91:16</ref>. </char>
    </note> Akakushaba amagara, waagamuha,</para>
  <para style="q1" vid="PSA 21:4">Nikwo kumereera ebiro n'ebiro.<verse eid="PSA 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:6">Zab 96:6</ref>. </char>
    </note> Ekitiinisa kye ni kingi ahabw'okuhwera kwawe,</para>
  <para style="q1" vid="PSA 21:5">Kandi omujwekire okusiimwa n'obukuru.<verse eid="PSA 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:11">Zab 16:11</ref>. </char>
    </note> Omuhaire emigisha mingi ebiro byona,</para>
  <para style="q1" vid="PSA 21:6">Kandi omunanwire n'okushemererwa ahabw'okuguma omu maisho gaawe;<verse eid="PSA 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:8">Zab 16:8</ref>; <ref loc="PSA 91:2">91:2</ref>. </char>
    </note> Ahakuba omugabe ayesiga MUKAMA;</para>
  <para style="q1" vid="PSA 21:7">Kandi ahabw'embabazi za Rukira-boona taritengyetsibwa.<verse eid="PSA 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8" />Omukono gwawe guryagwa aha bazigu baawe boona,</para>
  <para style="q1" vid="PSA 21:8">Omukono gwawe gwa buryo guryakwata abarikukwanga.<verse eid="PSA 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:3">Zab 50:3</ref>; <ref loc="ISA 26:11">Isa 26:11</ref>; <ref loc="MAL 4:1">Mal 4:1</ref>. </char>
    </note> Oryabagira nk'ekikoomi ekirikubuguma omu biro by'ekiniga kyawe;</para>
  <para style="q1" vid="PSA 21:9">MUKAMA aryabamira n'ekiniga kye,</para>
  <para style="q1" vid="PSA 21:9">Kandi omuriro guryabamaraho.<verse eid="PSA 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:28">Zab 37:28</ref>; <ref loc="1KI 13:34">1 Bag 13:34</ref>; <ref loc="ISA 14:20">Isa 14:20</ref>. </char>
    </note> Oruzaaro rwabo oryarumara omu nsi,</para>
  <para style="q1" vid="PSA 21:10">Na baijukuru baabo obamare omu baana b'abantu.<verse eid="PSA 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11" />N'obu barihanuura kukukora kubi,</para>
  <para style="q1" vid="PSA 21:11">Bakakugiraho enaama mbi, tibaribaasa.<verse eid="PSA 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:2">Zab 11:2</ref>; <ref loc="PSA 18:40">18:40</ref>. </char>
    </note> Oryababinga bakuhungye,</para>
  <para style="q1" vid="PSA 21:12">Otaire emyambi yaawe omu buta ogyorekyeize aha maisho gaabo.<verse eid="PSA 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13" />Ohimbisibwe, ai MUKAMA, omu maani gaawe;</para>
  <para style="q1" vid="PSA 21:13">Naitwe turyayeshongora tusingize obushoboorozi bwawe.<verse eid="PSA 21:13" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" sid="PSA 22" />
  <para style="d">Okutaka kw'ori omu busaasi, n'ekyeshongoro ky'okuhimbisa; kandi ebimwe nibyo Yesu yaagambiire aha musharaba Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi eyaayeshongoirwe n'eiraka eririkwetwa Empara y'omu busheeshe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:8">Zab 38:8</ref>; <ref loc="MAT 27:46">Mat 27:46</ref>; <ref loc="MRK 15:34">Mak 15:34</ref>; <ref loc="HEB 5:7">Heb 5:7</ref>. </char>
    </note> Ruhanga wangye, Ruhanga wangye, n'enki ekyakuntsigisaho?</para>
  <para style="q1" vid="PSA 22:1">Ahabw'enki ori hare, otarikumpwera, kandi otarikuhurira bigambo by'okutsinda kwangye?<verse eid="PSA 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:1">Zab 88:1</ref>. </char>
    </note> Ai bambe Ruhanga wangye, nkutakira nyomushana, tongarukamu;</para>
  <para style="q1" vid="PSA 22:2">Kandi na nyekiro, timpunama.<verse eid="PSA 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:1">Zab 80:1</ref>; <ref loc="PSA 147:12">147:12</ref>; <ref loc="LEV 19:2">Lev 19:2</ref>. </char>
    </note> Kwonka Iwe ori Orikwera,</para>
  <para style="q1" vid="PSA 22:3">Iwe otuura aha kitebe ky'okuhimbisa kwa Israeli.<verse eid="PSA 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4" />Baatatenkuriitwe bakakwesiga;</para>
  <para style="q1" vid="PSA 22:4">Ku baakwesigire, waabajuna.<verse eid="PSA 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:2">Zab 35:2</ref>; <ref loc="JDG 3:9">Bar 3:9</ref>; <ref loc="ROM 9:33">Rom 9:33</ref>. </char>
    </note> Bakakutakira, waabakiza;</para>
  <para style="q1" vid="PSA 22:5">Bakakwesiga, tibaayefuuza.<verse eid="PSA 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:19">Zab 69:19</ref>; <ref loc="JOB 25:6">Yob 25:6</ref>; <ref loc="ISA 53:3">Isa 53:3</ref>. </char>
    </note> Kwonka nyowe ndi omunyongororwa, tindi muntu,</para>
  <para style="q1" vid="PSA 22:6">Ou abantu bajuma, kandi ogaywa boona.<verse eid="PSA 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:25">Zab 109:25</ref>; <ref loc="2KI 19:21">2 Bag 19:21</ref>; <ref loc="MRK 15:29-32">Mak 15:29-32</ref>. </char>
    </note> Boona abandeeba banshekyerera,</para>
  <para style="q1" vid="PSA 22:7">Banteerera enaku n'eminwa yaabo, nibazongoza emitwe,<verse eid="PSA 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:19">Zab 18:19</ref>; <ref loc="PSA 37:5">37:5</ref>; <ref loc="PSA 91:14">91:14</ref>; <ref loc="MRK 1:11">Mak 1:11</ref>. </char>
    </note> Nibagira bati: Akeesiga Ruhanga; mbwenu naamujune;</para>
  <para style="q1" vid="PSA 22:8">Amukize, ahakuba amushemerererwa.<verse eid="PSA 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:6">Zab 71:6</ref>. </char>
    </note> Kwonka niiwe waanyihire omunda ya maawe,</para>
  <para style="q1" vid="PSA 22:9">Kandi okandinda nkiri aha mabeere.<verse eid="PSA 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:1">Isa 49:1</ref>; <ref loc="GAL 1:15">Gal 1:15</ref>. </char>
    </note> Okwiha obu naazarwa, niiwe nyegamira;</para>
  <para style="q1" vid="PSA 22:10">Okwiha obu maawe yanzaara, niiwe oba Ruhanga wangye.<verse eid="PSA 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:1">Zab 10:1</ref>; <ref loc="ISA 63:5">Isa 63:5</ref>. </char>
    </note> Otanza hare, ahakuba akabi kari haihi;</para>
  <para style="q1" vid="PSA 22:11">Kandi tiinyine kihwera.<verse eid="PSA 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12" />Enimi nyingi ziinyehinguririize;</para>
  <para style="q1" vid="PSA 22:12">Enimi z'amaani eza Bashani zintangatangire;<verse eid="PSA 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:21">Zab 35:21</ref>; <ref loc="1PE 5:8">1 Pet 5:8</ref>; <ref loc="JOB 16:10">Yob 16:10</ref>. </char>
    </note> Ziinyashamiire,</para>
  <para style="q1" vid="PSA 22:13">Nk'entare esheegire, erikutsinda.<verse eid="PSA 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 2:11">Yos 2:11</ref>; <ref loc="NAM 2:10">Nah 2:10</ref>. </char>
    </note> Nyatikire nk'amaizi,</para>
  <para style="q1" vid="PSA 22:14">Amagufa gangye goona gataine;</para>
  <para style="q1" vid="PSA 22:14">Omutima gwangye guri nk'entsinda,</para>
  <para style="q1" vid="PSA 22:14">Niguyagira omu kifuba kyangye.<verse eid="PSA 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:10">Yob 29:10</ref>; <ref loc="PRO 17:22">Enf 17:22</ref>; <ref loc="JHN 19:28">Yoh 19:28</ref>. </char>
    </note> Amaani gampweiremu, nyomire nk'orugusyo,</para>
  <para style="q1" vid="PSA 22:15">Orurimi rundamatiire aha nkanka;</para>
  <para style="q1" vid="PSA 22:15">Ontaire omu mucuucu gw'okufa.<verse eid="PSA 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:16: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 15:24">Mak 15:24</ref>; <ref loc="LUK 24:40">Luk 24:40</ref>; <ref loc="JHN 19:23">Yoh 19:23</ref>; <ref loc="JHN 20:20">20:20</ref>, <ref loc="JHN 20:25">25</ref>. </char>
    </note> Embwa ziinyehinguririize,</para>
  <para style="q1" vid="PSA 22:16">Omutwe gw'enkozi z'ebibi guntaire ahagati;</para>
  <para style="q1" vid="PSA 22:16">Banfumwire ebiganja n'ebigyere.<verse eid="PSA 22:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:17: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:36">Mat 27:36</ref>; <ref loc="LUK 23:35">Luk 23:35</ref>. </char>
    </note> Nimbaasa kubara amagufa gangye goona;</para>
  <para style="q1" vid="PSA 22:17">Banteireho amaisho nibanshamaarira,<verse eid="PSA 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:18: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:35">Mat 27:35</ref>; <ref loc="MRK 15:24">Mak 15:24</ref>; <ref loc="LUK 23:34">Luk 23:34</ref>; <ref loc="JHN 19:23">Yoh 19:23</ref>, <ref loc="JHN 19:24">24</ref>. </char>
    </note> Baabagana eby'okujwara byangye,</para>
  <para style="q1" vid="PSA 22:18">Baateerera enteenyu ekijwaro kyangye.<verse eid="PSA 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:22">Zab 38:22</ref>. </char>
    </note> Kwonka ai MUKAMA, otaza hare!</para>
  <para style="q1" vid="PSA 22:19">Iwe omuhwezi wangye, rahuka ompe emikono!<verse eid="PSA 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:17">Zab 35:17</ref>. </char>
    </note> Onkize rurara,</para>
  <para style="q1" vid="PSA 22:20">Amagara gangye ogaihe omu maani g'embwa!<verse eid="PSA 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:21: </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:17">2 Tim 4:17</ref>. </char>
    </note> Onjune omu kanwa k'entare,</para>
  <para style="q1" vid="PSA 22:21">N'amagara gangye agarikubonabona ogaihe omu mahembe g'embogo!<verse eid="PSA 22:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:22: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 28:10">Mat 28:10</ref>; <ref loc="JHN 17:6">Yoh 17:6</ref>; <ref loc="JHN 20:17">20:17</ref>; <ref loc="HEB 2:12">Heb 2:12</ref>. </char>
    </note> Ndyagambira ab'eishe-emwe eiziina ryawe;</para>
  <para style="q1" vid="PSA 22:22">Nkuhimbisize ahagati omu mutwe gw'abantu.<verse eid="PSA 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23" />Imwe abatiina MUKAMA, mumuhimbise!</para>
  <para style="q1" vid="PSA 22:23">Naimwe oruzaaro rwa Yakobo, mumuhe ekitiinisa,</para>
  <para style="q1" vid="PSA 22:23">Kandi imwe baijukuru ba Israeli mwena, mumutiine!<verse eid="PSA 22:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:1">Zab 10:1</ref>; <ref loc="PSA 13:1">13:1</ref>; <ref loc="HEB 5:7">Heb 5:7</ref>. </char>
    </note> Ahakuba takagayaga n'obu kwakuba okunuga</para>
  <para style="q1" vid="PSA 22:24">Okubonabona kw'orikubonabonesibwa;</para>
  <para style="q1" vid="PSA 22:24">Kandi takamwimaga maisho,</para>
  <para style="q1" vid="PSA 22:24">Kureka ku yaamutakiire, yaamuhurira.<verse eid="PSA 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:13">Zab 66:13</ref>; <ref loc="JON 2:9">Yon 2:9</ref>. </char>
    </note> Ahariiwe niho okuhimbisa kwangye kuruga, oku nkuhimbisiza omu mutwe muhango gw'abantu;</para>
  <para style="q1" vid="PSA 22:25">Ndyahikiiriza okuhiga kwangye omu maisho g'abarikumutiina.<verse eid="PSA 22:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:32">Zab 69:32</ref>. </char>
    </note> Abacureezi baryarya, bahaagye,</para>
  <para style="q1" vid="PSA 22:26">N'abasherura MUKAMA baryamuhimbisa.</para>
  <para style="q1" vid="PSA 22:26">Emitima yaanyu emereere ebiro byona.<verse eid="PSA 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:8">Zab 2:8</ref>; <ref loc="PSA 67:7">67:7</ref>; <ref loc="PSA 96:7">96:7</ref>. </char>
    </note> Ab'embaju zoona ez'ensi baryaijuka,</para>
  <para style="q1" vid="PSA 22:27">Bahindukire MUKAMA;</para>
  <para style="q1" vid="PSA 22:27">N'enganda zoona ez'amahanga ziryaramiza omu maisho ge;<verse eid="PSA 22:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:8">Zab 47:8</ref>; <ref loc="OBA 1:21">Oba 21</ref>; <ref loc="ZEC 14:9">Zek 14:9</ref>. </char>
    </note> Ahakuba obutegyeki n'obwa MUKAMA,</para>
  <para style="q1" vid="PSA 22:28">Kandi niwe ategyeka amahanga.<verse eid="PSA 22:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:12">Zab 45:12</ref>. </char>
    </note> Eego, abanyamaryo boona ab'omu nsi baryamwinamira,</para>
  <para style="q1" vid="PSA 22:29">N'abashuuma omu mucuucu boona baryainama omu maisho ge,</para>
  <para style="q1" vid="PSA 22:29">Omuntu weena otarikubaasa kuzibira amagara ge kufa.<verse eid="PSA 22:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:30, 31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:18">Zab 71:18</ref>; <ref loc="PSA 78:6">78:6</ref>. </char>
    </note> Abaijukuru baryamuheereza,</para>
  <para style="q1" vid="PSA 22:30">Abantu baryagambira ab'obusingye oburikurataho ebya MUKAMA,<verse eid="PSA 22:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31" />Bamanyise abantu abarizaarwa okuhikiirira kwe,</para>
  <para style="q1" vid="PSA 22:31">Ku niwe yaakikozire.<verse eid="PSA 22:31" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="d">Mukama okuba Omuriisa w'abantu be Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:9">Zab 34:9</ref>, <ref loc="PSA 34:10">10</ref>; <ref loc="PSA 80:1">80:1</ref>; <ref loc="ISA 40:11">Isa 40:11</ref>, <ref loc="ISA 40:12">12</ref>; <ref loc="JHN 10:11">Yoh 10:11</ref>; <ref loc="HEB 13:20">Heb 13:20</ref>; <ref loc="1PE 2:25">1 Pet 2:25</ref>; <ref loc="1PE 5:4">5:4</ref>. </char>
    </note> MUKAMA niwe muriisa wangye, tindikyena kintu kyona.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:2: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 34:14">Ezk 34:14</ref>; <ref loc="JHN 10:9">Yoh 10:9</ref>. </char>
    </note> Ambyamya omu iriisizo ry'obunyaatsi buto,</para>
  <para style="q1" vid="PSA 23:2">Antwara aha rubaju rw'amaizi agarikusheneneka;<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:7">Zab 19:7</ref>; <ref loc="PSA 31:3">31:3</ref>; <ref loc="ISA 49:10">Isa 49:10</ref>; <ref loc="EZK 20:9">Ezk 20:9</ref>; <ref loc="REV 7:17">Kush 7:17</ref>. </char>
    </note> Agarura amaani omu magara gangye.</para>
  <para style="q1" vid="PSA 23:3">Anyebembera omu mihanda y'okuhikiirira ahabw'eiziina rye.<verse eid="PSA 23:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:1">Zab 27:1</ref>; <ref loc="PSA 138:7">138:7</ref>; <ref loc="ISA 8:10">Isa 8:10</ref>; <ref loc="ISA 43:2">43:2</ref>; <ref loc="MIC 7:14">Mik 7:14</ref>. </char>
    </note> N'obu ndiraba omu ruhanga rw'ekibunda ky'okufa,</para>
  <para style="q1" vid="PSA 23:4">Tinditiina kabi koona,</para>
  <para style="q1" vid="PSA 23:4">Ahabw'okuba ori hamwe naanye;</para>
  <para style="q1" vid="PSA 23:4">Oruga rwawe n'enkoni yaawe bimpuumuza.<verse eid="PSA 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:7">Zab 45:7</ref>; <ref loc="PSA 78:19">78:19</ref>; <ref loc="LUK 7:46">Luk 7:46</ref>; <ref loc="2SA 17:27-29">2 Sam 17:27-29</ref>. </char>
    </note> Ontebeekanisiza emeeza omu maisho g'abazigu bangye,</para>
  <para style="q1" vid="PSA 23:5">Onshuka amajuta aha mutwe,</para>
  <para style="q1" vid="PSA 23:5">Ekikopo kyangye kiijwire nikisheesheka.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:4">Zab 27:4</ref>. </char>
    </note> Buzimazima oburungi n'embabazi biryaguma naanye</para>
  <para style="q1" vid="PSA 23:6">Ebiro byona eby'amagara gangye;</para>
  <para style="q1" vid="PSA 23:6">Naanye ndyaguma omu nju ya MUKAMA</para>
  <para style="q1" vid="PSA 23:6">Ebiro n'ebiro.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" sid="PSA 24" />
  <para style="d">Mukama ow'ekitiinisa Omuhangi waitu, n'eby'abashemereire kutaaha omuri hekalu ye Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 24:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:12">Zab 50:12</ref>; <ref loc="PSA 89:11">89:11</ref>; <ref loc="JOB 41:11">Yob 41:11</ref>; <ref loc="EXO 9:29">Kur 9:29</ref>; <ref loc="1CO 10:26">1 Kor 10:26</ref>. </char>
    </note> Ensi n'eya MUKAMA n'ebirimu byona,</para>
  <para style="q1" vid="PSA 24:1">Ensi yoona n'abagituuramu;<verse eid="PSA 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 136:6">Zab 136:6</ref>; <ref loc="PRO 8:29">Enf 8:29</ref>. </char>
    </note> Ahakuba akata emisingi yaayo aha nyanja,</para>
  <para style="q1" vid="PSA 24:2">Yaagihamiza aha migyera y'amaizi maingi.<verse eid="PSA 24:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:3-5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:1-5">Zab 15:1-5</ref>. </char>
    </note> N'oha oritemba aha kibungo kya MUKAMA?</para>
  <para style="q1" vid="PSA 24:3">Kandi oryemerera omu mwanya gwe ogurikwera n'oha?<verse eid="PSA 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:1">Zab 73:1</ref>; <ref loc="PSA 119:37">119:37</ref>; <ref loc="MAT 5:8">Mat 5:8</ref>; <ref loc="JOB 22:30">Yob 22:30</ref>. </char>
    </note> Nogwo oine engaro ezishemeziibwe n'omutima ogushemeire,</para>
  <para style="q1" vid="PSA 24:4">Otata mutima gwe ha by'ebishuba,</para>
  <para style="q1" vid="PSA 24:4">Kandi otarahira by'obubobya.<verse eid="PSA 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Zab 27:9</ref>; <ref loc="PSA 51:14">51:14</ref>; <ref loc="PSA 88:1">88:1</ref>; <ref loc="ISA 46:13">Isa 46:13</ref>; <ref loc="GEN 22:17">Kut 22:17</ref>, <ref loc="GEN 22:18">18</ref>. </char>
    </note> Ogwo niwe ariheebwa omugisha kuruga ahari MUKAMA,</para>
  <para style="q1" vid="PSA 24:5">N'okuhikiirira kuruga ahari Ruhanga ow'okujunwa kwe.<verse eid="PSA 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:4">Zab 105:4</ref>. </char>
    </note> Abamusherura n'abari nk'ogwo,</para>
  <para style="q1" vid="PSA 24:6">Abenda kureeba amaisho ga Ruhanga wa Yakobo.<verse eid="PSA 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:19">Zab 118:19</ref>, <ref loc="PSA 118:20">20</ref>; <ref loc="1CO 2:8">1 Kor 2:8</ref>. </char>
    </note> Imwe marembo 'mwe, nimwimutsye emitwe yaanyu,</para>
  <para style="q1" vid="PSA 24:7">Naimwe enyigi eza ira, mwimukye,</para>
  <para style="q1" vid="PSA 24:7">Mukama w'ekitiinisa abone kutaahamu.<verse eid="PSA 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:3">Kur 15:3</ref>. </char>
    </note> Ogwo Mukama w'ekitiinisa n'oha?</para>
  <para style="q1" vid="PSA 24:8">Ni MUKAMA ow'amaani, ow'obushoboorozi,</para>
  <para style="q1" vid="PSA 24:8">MUKAMA ow'obushoboorozi omu kurwana.<verse eid="PSA 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9" />Imwe marembo 'mwe, nimwimutsye emitwe yaanyu,</para>
  <para style="q1" vid="PSA 24:9">Naimwe enyigi eza ira, mwimukye,</para>
  <para style="q1" vid="PSA 24:9">MUKAMA w'ekitiinisa abone kutaahamu.<verse eid="PSA 24:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:10: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 1:14">Mal 1:14</ref>. </char>
    </note> Ogwo Mukama w'ekitiinisa n'oha?</para>
  <para style="q1" vid="PSA 24:10">MUKAMA w'amahe niwe Mukama ow'ekitiinisa.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" sid="PSA 25" />
  <para style="d">Okushaba okurindwa n'okusaasirwa Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:8">Zab 143:8</ref>; <ref loc="LAM 3:41">Tonz 3:41</ref>. </char>
    </note> Ai MUKAMA, niiwe nyimukiza omutima.<verse eid="PSA 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:20">Zab 25:20</ref>; <ref loc="PSA 31:1">31:1</ref>; <ref loc="PSA 71:1">71:1</ref>. </char>
    </note> Ai Ruhanga wangye, niiwe nyesiga;</para>
  <para style="q1" vid="PSA 25:2">Otandeka kwitwa enshoni,</para>
  <para style="q1" vid="PSA 25:2">Otaikiriza abazigu bangye kuunyehimbisizaho.<verse eid="PSA 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:23">Isa 49:23</ref>; <ref loc="JER 3:20">Yer 3:20</ref>; <ref loc="ROM 10:11">Rom 10:11</ref>. </char>
    </note> Eego, otaikiriza weena orikukutegyereza kwitwa enshoni;</para>
  <para style="q1" vid="PSA 25:3">Abareebeza abandi busha bakwatwe enshoni.<verse eid="PSA 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:11">Zab 27:11</ref>; <ref loc="EXO 33:13">Kur 33:13</ref>. </char>
    </note> Ompabure emihanda yaawe, ai MUKAMA;</para>
  <para style="q1" vid="PSA 25:4">Kandi onyegyese emitwarize yaawe.<verse eid="PSA 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5" />Onyebembere omu mazima gaawe, kandi onyegyese,</para>
  <para style="q1" vid="PSA 25:5">ahakuba niiwe Ruhanga w'okujunwa kwangye;</para>
  <para style="q1" vid="PSA 25:5">Niiwe ntegyereza eizooba ryona.<verse eid="PSA 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:1">Zab 51:1</ref>; <ref loc="GEN 9:15">Kut 9:15</ref>; <ref loc="GEN 19:29">19:29</ref>. </char>
    </note> Ai MUKAMA, ijuka okusaasira kwawe n'embabazi zaawe,</para>
  <para style="q1" vid="PSA 25:6">Ahakuba bikaba biriho okuruga ira ryona.<verse eid="PSA 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 13:26">Yob 13:26</ref>; <ref loc="JER 3:25">Yer 3:25</ref>. </char>
    </note> Otaijuka ebibi by'obutsigazi bwangye, n'obu byakuba eby'okushiisha byangye;</para>
  <para style="q1" vid="PSA 25:7">Onyijukye nk'embabazi zaawe oku ziri,</para>
  <para style="q1" vid="PSA 25:7">Ahabw'oburungi bwawe, ai MUKAMA.<verse eid="PSA 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:8">Zab 32:8</ref>; <ref loc="PSA 100:5">100:5</ref>. </char>
    </note> MUKAMA ni murungi kandi ow'amazima;</para>
  <para style="q1" vid="PSA 25:8">Nikyo ahaburira abasiisi omuhanda.<verse eid="PSA 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9" />Abacureezi abeebembera omu by'oburyo,</para>
  <para style="q1" vid="PSA 25:9">Kandi abeegyesa omuhanda gwe.<verse eid="PSA 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10" />Emihanda yoona eya MUKAMA n'embabazi n'amazima</para>
  <para style="q1" vid="PSA 25:10">Ahari abo abarinda endagaano ye n'ebi yahamize.<verse eid="PSA 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:3">Zab 31:3</ref>; <ref loc="PSA 79:9">79:9</ref>; <ref loc="ROM 5:20">Rom 5:20</ref>. </char>
    </note> Ahabw'eiziina ryawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 25:11">Saasira okushiisha kwangye, ahabw'okuba ni kwingi.<verse eid="PSA 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:8">Zab 32:8</ref>. </char>
    </note> Omuntu orikutiina MUKAMA n'oha?</para>
  <para style="q1" vid="PSA 25:12">Ogwo niwe aryegyesa omuhanda ogu ashemereire kutoora.<verse eid="PSA 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:9">Zab 37:9</ref>; <ref loc="PSA 112:2">112:2</ref>; <ref loc="PRO 1:33">Enf 1:33</ref>. </char>
    </note> Amagara ge garyaguma omu busingye,</para>
  <para style="q1" vid="PSA 25:13">Kandi abaana be baryahungura ensi.<verse eid="PSA 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:4">Yob 29:4</ref>; <ref loc="AMO 3:7">Amo 3:7</ref>. </char>
    </note> Emibonano ya MUKAMA emanywa abarikumutiina,</para>
  <para style="q1" vid="PSA 25:14">Kandi aryabooreka endagaano ze.<verse eid="PSA 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:4">Zab 31:4</ref>; <ref loc="PSA 123:1">123:1</ref>, <ref loc="PSA 123:2">2</ref>. </char>
    </note> Amaisho gangye ntuura ngahangire MUKAMA,</para>
  <para style="q1" vid="PSA 25:15">Ahakuba niwe ariiha ebigyere byangye omu mutego.<verse eid="PSA 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:16">Zab 86:16</ref>. </char>
    </note> Ompindukire, ongirire embabazi,</para>
  <para style="q1" vid="PSA 25:16">Ahakuba tiinyine ifo na ruguru, kandi nimbonabona.<verse eid="PSA 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17" />Otuubye enaku z'omu mutima gwangye,</para>
  <para style="q1" vid="PSA 25:17">Onyihe omu busaasi bwangye.<verse eid="PSA 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18" />Reeba okubonabona kwangye n'enaku zangye,</para>
  <para style="q1" vid="PSA 25:18">Onsaasire ebibi byangye byona.<verse eid="PSA 25:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19" />Reeba abazigu bangye ku bari baingi,</para>
  <para style="q1" vid="PSA 25:19">Kandi ku barikuunyanga okwanga okubi.<verse eid="PSA 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>. </char>
    </note> Rinda amagara gangye, onjune;</para>
  <para style="q1" vid="PSA 25:20">Otandeka kwitwa enshoni, ahabw'okuba nkuhungiireho.<verse eid="PSA 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21" />Okuhikiirira n'amazima bindinde,</para>
  <para style="q1" vid="PSA 25:21">Ahabw'okuba nkutegyereize.<verse eid="PSA 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:22">Zab 34:22</ref>; <ref loc="PSA 130:8">130:8</ref>; <ref loc="2SA 4:9">2 Sam 4:9</ref>. </char>
    </note> Ai Ruhanga, cungura Israeli,</para>
  <para style="q1" vid="PSA 25:22">Omwihe omu naku ze zoona.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" sid="PSA 26" />
  <para style="d">Obujurizi bw'omuntu ohikiriire Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 26:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:8">Zab 7:8</ref>; <ref loc="PSA 11:1">11:1</ref>. </char>
    </note> Oncwere orubanja, ai MUKAMA,</para>
  <para style="q1" vid="PSA 26:1">Ahakuba okuhikiirira kwangye nikwo ngyendeiremu,</para>
  <para style="q1" vid="PSA 26:1">Kandi nyesigire MUKAMA ntarikubanganisa.<verse eid="PSA 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:9">Zab 7:9</ref>; <ref loc="PSA 17:3">17:3</ref>. </char>
    </note> Onshwijume, ai MUKAMA, ongyeze;</para>
  <para style="q1" vid="PSA 26:2">Orengye omutima gwangye n'obwengye bwangye.<verse eid="PSA 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:10">Zab 25:10</ref>; <ref loc="2KI 20:3">2 Bag 20:3</ref>. </char>
    </note> Ahakuba embabazi zaawe ziri omu maisho gangye,</para>
  <para style="q1" vid="PSA 26:3">Kandi ngyendeire omu mazima gaawe.<verse eid="PSA 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4" />Tinshutama n'abantu bataine mugasho,</para>
  <para style="q1" vid="PSA 26:4">Kandi tinkwatanisa na ndyarya.<verse eid="PSA 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:21">Zab 139:21</ref>, <ref loc="PSA 139:22">22</ref>. </char>
    </note> Nyanga omutwe gw'enkozi z'ebibi,</para>
  <para style="q1" vid="PSA 26:5">Kandi tindishutama na basiisi.<verse eid="PSA 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:13">Zab 73:13</ref>; <ref loc="EXO 30:19">Kur 30:19</ref>, <ref loc="EXO 30:20">20</ref>. </char>
    </note> Nnaabisa engaro zangye ntaine rubanja,</para>
  <para style="q1" vid="PSA 26:6">Ngu mbone kwehinguririza eitambiro ryawe, ai MUKAMA,<verse eid="PSA 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:1">Zab 9:1</ref>. </char>
    </note> Niinyeshongora munonga eby'okusiima,</para>
  <para style="q1" vid="PSA 26:7">Nimmanyisa emirimo yaawe yoona erikutangaaza.<verse eid="PSA 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:4">Zab 27:4</ref>. </char>
    </note> MUKAMA, nkunda oburaaro bw'omu nju yaawe,</para>
  <para style="q1" vid="PSA 26:8">N'ahi ekitiinisa kyawe kituura.<verse eid="PSA 26:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:3">Zab 28:3</ref>. </char>
    </note> Otampwerekyereza n'abanyabibi,</para>
  <para style="q1" vid="PSA 26:9">N'obu gaakuba amagara gangye n'abasheesha eshagama,<verse eid="PSA 26:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 16:19">Bir 16:19</ref>. </char>
    </note> Abu emikono yaabo eine eitima,</para>
  <para style="q1" vid="PSA 26:10">Kandi abu emikono yaabo eya buryo eijwire enguzi.<verse eid="PSA 26:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11" />Kwonka nyowe ndyagyendera omu kuhikiirira kwangye;</para>
  <para style="q1" vid="PSA 26:11">Oncungure, ongirire embabazi.<verse eid="PSA 26:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">26:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:25">Zab 22:25</ref>. </char>
    </note> Ekigyere kyangye kyemereire aharinganiire.</para>
  <para style="q1" vid="PSA 26:12">Ndyahimbisiza MUKAMA omu iteeraniro rihango ry'abantu.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" sid="PSA 27" />
  <para style="d">Okutatiina ahabw'okwesiga Mukama Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 27:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:4">Zab 23:4</ref>; <ref loc="EXO 15:2">Kur 15:2</ref>; <ref loc="ISA 12:2">Isa 12:2</ref>; <ref loc="ISA 60:20">60:20</ref>; <ref loc="MIC 7:8">Mik 7:8</ref>; <ref loc="HEB 13:6">Heb 13:6</ref>. </char>
    </note> MUKAMA niwe mushana gwangye kandi okujunwa kwangye;</para>
  <para style="q1" vid="PSA 27:1">N'oha ou nditiina?</para>
  <para style="q1" vid="PSA 27:1">MUKAMA niwe maani g'amagara gangye;</para>
  <para style="q1" vid="PSA 27:1">Orintiinisa n'oha?<verse eid="PSA 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2" />Enkozi z'ebibi ku zampururiire kummira,</para>
  <para style="q1" vid="PSA 27:2">Nibo bazigu bangye n'abarikuunyanga,</para>
  <para style="q1" vid="PSA 27:2">Bakateera entsibo, baagwa.<verse eid="PSA 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:6">Zab 3:6</ref>. </char>
    </note> N'obu engabo zaakuteeka enteeko kundwanisa,</para>
  <para style="q1" vid="PSA 27:3">Omutima gwangye tigukaatiina;</para>
  <para style="q1" vid="PSA 27:3">N'obu orugamba rwakumbaho, hoona nabwo nkaaguma omutima.<verse eid="PSA 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:6">Zab 23:6</ref>; <ref loc="PSA 26:8">26:8</ref>; <ref loc="PSA 84:1">84:1</ref>, <ref loc="PSA 84:2">2</ref>; <ref loc="PSA 90:17">90:17</ref>; <ref loc="LUK 2:37">Luk 2:37</ref>. </char>
    </note> Ekigambo eki nshabire MUKAMA ni kimwe,</para>
  <para style="q1" vid="PSA 27:4">Kandi nikyo ndiguma ninsherura;</para>
  <para style="q1" vid="PSA 27:4">Nikwo kuguma omu nju ya MUKAMA ebiro byona eby'amagara gangye,</para>
  <para style="q1" vid="PSA 27:4">Okureeba oburungi bwa MUKAMA, n'okwehanuuza omuri hekalu ye.<verse eid="PSA 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:20">Zab 31:20</ref>; <ref loc="PSA 40:2">40:2</ref>; <ref loc="ISA 4:6">Isa 4:6</ref>. </char>
    </note> Ahakuba aha izooba ry'okureeberaho enaku aryandindira omu mubonano omu kibanda kye,</para>
  <para style="q1" vid="PSA 27:5">Omu bweshereko bw'eihema rye nimwo arinshereka,</para>
  <para style="q1" vid="PSA 27:5">Akanyimutsya, akanyemereza aha rukiri.<verse eid="PSA 27:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:3">Zab 3:3</ref>; <ref loc="EPH 5:19">Efe 5:19</ref>. </char>
    </note> Na mbwenu hati omutwe gwangye nigwija kutunguurwa,</para>
  <para style="q1" vid="PSA 27:6">Gube ahaiguru y'abazigu bangye abandi embaju zoona;</para>
  <para style="q1" vid="PSA 27:6">Ndyahonga ebitambo omu ihema rye n'okwesiima,</para>
  <para style="q1" vid="PSA 27:6">Nyeshongore; eego nyeshongorere MUKAMA eby'okumuhimbisa.<verse eid="PSA 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:10">Zab 30:10</ref>. </char>
    </note> Hurira, ai MUKAMA, ku ndaakutakire n'eiraka rihango,</para>
  <para style="q1" vid="PSA 27:7">Ongirire embabazi, kandi ongarukyemu.<verse eid="PSA 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:6">Zab 24:6</ref>. </char>
    </note> Ku waagizire oti: Musherure amaisho gangye,</para>
  <para style="q1" vid="PSA 27:8">Omutima gwangye gwakugarukamu guti:</para>
  <para style="q1" vid="PSA 27:8">Ai MUKAMA, amaisho gaawe nigo ndiguma ninsherura.<verse eid="PSA 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:5">Zab 24:5</ref>; <ref loc="PSA 69:17">69:17</ref>; <ref loc="PSA 102:2">102:2</ref>. </char>
    </note> Otanyima amaisho, otabinga omwiru waawe n'ekiniga;</para>
  <para style="q1" vid="PSA 27:9">Niiwe waabaire ori Omuhwezi wangye;</para>
  <para style="q1" vid="PSA 27:9">Otannaga, n'obu kwakuba okuntsigaho,</para>
  <para style="q1" vid="PSA 27:9">Ai Ruhanga ow'okujunwa kwangye.<verse eid="PSA 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:15">Isa 49:15</ref>; <ref loc="JHN 16:32">Yoh 16:32</ref>; <ref loc="2TI 4:16">2 Tim 4:16</ref>, <ref loc="2TI 4:17">17</ref>. </char>
    </note> Tata na maawe bantsigireho,</para>
  <para style="q1" vid="PSA 27:10">Kwonka MUKAMA naija kuunyanduura.<verse eid="PSA 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:11">Zab 35:11</ref>; <ref loc="PSA 41:2">41:2</ref>; <ref loc="MAT 26:59">Mat 26:59</ref>, <ref loc="MAT 26:60">60</ref>; <ref loc="MRK 14:55">Mak 14:55</ref>, <ref loc="MRK 14:56">56</ref>. </char>
    </note> Onyegyese omuhanda gwawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 27:11">Onyebembere omu muhanda ogutarikuhabya ahabw'abazigu bangye.<verse eid="PSA 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12" />Otareka ababisha bangye kunkora eki barikwenda,</para>
  <para style="q1" vid="PSA 27:12">Ahakuba baakareebi b'ebishuba baanyimukiriire,</para>
  <para style="q1" vid="PSA 27:12">Nibagamba n'amaani eby'okuntiinisa.<verse eid="PSA 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 142:5">Zab 142:5</ref>; <ref loc="EXO 33:19">Kur 33:19</ref>; <ref loc="ISA 38:11">Isa 38:11</ref>. </char>
    </note> Nkaagwire enshazi, kuri ntaraikiriize kureeba oburungi bwa MUKAMA</para>
  <para style="q1" vid="PSA 27:13">Omu nsi y'abahuriire;<verse eid="PSA 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:24">Zab 31:24</ref>; <ref loc="PSA 37:34">37:34</ref>; <ref loc="ISA 25:9">Isa 25:9</ref>; <ref loc="JOS 1:6">Yos 1:6</ref>. </char>
    </note> Tegyereza MUKAMA; gira amaani;</para>
  <para style="q1" vid="PSA 27:14">Guma omutima. Eego otegyereze MUKAMA.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" sid="PSA 28" />
  <para style="d">Okushaba Ruhanga okuzimuurira ababi ebibashemereire Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 28:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:2">Zab 18:2</ref>; <ref loc="PSA 31:3">31:3</ref>; <ref loc="PSA 35:22">35:22</ref>; <ref loc="PSA 143:7">143:7</ref>. </char>
    </note> Ai MUKAMA, niiwe ndikutakira;</para>
  <para style="q1" vid="PSA 28:1">Iwe Rukiri rwangye, otaanyetsiza;</para>
  <para style="q1" vid="PSA 28:1">Ahakuba ku waakuunyetsiza,</para>
  <para style="q1" vid="PSA 28:1">Nkaaba nk'abarikushuuma omu Kiina.<verse eid="PSA 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:7">Zab 5:7</ref>; <ref loc="PSA 134:2">134:2</ref>; <ref loc="PSA 140:6">140:6</ref>; <ref loc="1KI 8:29">1 Bag 8:29</ref>. </char>
    </note> Ohurire eiraka ry'okweshengyereza kwangye,</para>
  <para style="q1" vid="PSA 28:2">Ku ndaakutakire niinyimutsya emikono yangye,</para>
  <para style="q1" vid="PSA 28:2">Ngyorekyeize Omwanya gwawe ogurikwera munonga.<verse eid="PSA 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:9">Zab 26:9</ref>; <ref loc="JER 9:8">Yer 9:8</ref>. </char>
    </note> Otantwarirana n'abasiisi n'enkozi z'ebibi,</para>
  <para style="q1" vid="PSA 28:3">Abagamba gye na bataahi baabo,</para>
  <para style="q1" vid="PSA 28:3">Kwonka baine eitima omu mitima yaabo.<verse eid="PSA 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:4: </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:15">Yer 50:15</ref>, <ref loc="JER 50:29">29</ref>; <ref loc="2TI 4:14">2 Tim 4:14</ref>; <ref loc="REV 18:6">Kush 18:6</ref>; <ref loc="REV 22:12">22:12</ref>. </char>
    </note> Obazimuurire ebishemereire emirimo yaabo,</para>
  <para style="q1" vid="PSA 28:4">Kandi nk'obubi bw'emicwe yaabo oku buri;</para>
  <para style="q1" vid="PSA 28:4">Obahe nk'ebi bakozire n'engaro zaabo oku biri,</para>
  <para style="q1" vid="PSA 28:4">Obaihure ebibashemereire.<verse eid="PSA 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:12">Isa 5:12</ref>. </char>
    </note> Ahakuba tibata mutima ha mirimo ya MUKAMA,</para>
  <para style="q1" vid="PSA 28:5">Nari aha bi emikono ye ekora;</para>
  <para style="q1" vid="PSA 28:5">Aryabasheenya, taribombeka bundi.<verse eid="PSA 28:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6" />MUKAMA ahimbisibwe,</para>
  <para style="q1" vid="PSA 28:6">Ahakuba ahuriire eiraka ry'okweshengyereza kwangye.<verse eid="PSA 28:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:3">Zab 3:3</ref>; <ref loc="PSA 69:30">69:30</ref>. </char>
    </note> MUKAMA niwe maani gangye, kandi engabo yangye;</para>
  <para style="q1" vid="PSA 28:7">Omutima gwangye gumwesigire, naahwerwa;</para>
  <para style="q1" vid="PSA 28:7">Nikyo omutima gwangye gushemerererwa munonga,</para>
  <para style="q1" vid="PSA 28:7">Nkamusingiza n'ekyeshongoro kyangye.<verse eid="PSA 28:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:6">Zab 20:6</ref>; <ref loc="PSA 140:7">140:7</ref>. </char>
    </note> MUKAMA n'amaani g'abantu be,</para>
  <para style="q1" vid="PSA 28:8">Niwe buhungiro oburikujuna ou yaashukireho amajuta.<verse eid="PSA 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:71">Zab 78:71</ref>, <ref loc="PSA 78:72">72</ref>; <ref loc="ISA 63:9">Isa 63:9</ref>; <ref loc="1KI 8:51">1 Bag 8:51</ref>; <ref loc="DEU 9:29">Bir 9:29</ref>. </char>
    </note> Juna abantu baawe, n'obuhunguzi bwawe obuhe omugisha;</para>
  <para style="q1" vid="PSA 28:9">Obe omuriisa waabo, kandi obaramire ebiro byona.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" sid="PSA 29" />
  <para style="d">Amaani g'Eiraka rya Mukama Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:7-9">Zab 96:7-9</ref>. </char>
    </note> Imwe ab'omu iguru, muhimbise MUKAMA,</para>
  <para style="q1" vid="PSA 29:1">Muhimbise MUKAMA, mugambe ku aine ekitiinisa n'amaani;<note caller="-" style="x"><char style="xo" closed="false">29:1: </char><char style="xt" closed="false"><ref loc="PSA 89:6">Zab 89:6</ref>. </char></note><verse eid="PSA 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2" />Muhe MUKAMA ekitiinisa ekishemereire eiziina rye;</para>
  <para style="q1" vid="PSA 29:2">Muramye MUKAMA, mujwaire eby'okuhikiirira.<verse eid="PSA 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:11">Zab 18:11</ref>, <ref loc="PSA 18:13">13</ref>; <ref loc="JOB 37:4">Yob 37:4</ref>, <ref loc="JOB 37:5">5</ref>. </char>
    </note> Eiraka rya MUKAMA rigambira aha maizi,</para>
  <para style="q1" vid="PSA 29:3">Ruhanga ow'ekitiinisa ahinda,</para>
  <para style="q1" vid="PSA 29:3">Niwe MUKAMA ohindira aha maizi maingi.<verse eid="PSA 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:33">Zab 68:33</ref>. </char>
    </note> Eiraka rya MUKAMA n'ery'amaani,</para>
  <para style="q1" vid="PSA 29:4">Eiraka rya MUKAMA riijwire ekitiinisa.<verse eid="PSA 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5" />Eiraka rya MUKAMA rihenda ebiti by'emyereezi;</para>
  <para style="q1" vid="PSA 29:5">Eego, MUKAMA ahenda ebiti bya Lebanooni eby'emyereezi.<verse eid="PSA 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 114:4">Zab 114:4</ref>, <ref loc="PSA 114:6">6</ref>; <ref loc="DEU 3:9">Bir 3:9</ref>. </char>
    </note> Akinisa Lebanooni nk'enyana,</para>
  <para style="q1" vid="PSA 29:6">Na Sirioni nk'enyana y'embogo.<verse eid="PSA 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7" />Eiraka rya MUKAMA ribaganisa endimi z'omuriro.<verse eid="PSA 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8" />Eiraka rya MUKAMA ritengyetsa eihamba,</para>
  <para style="q1" vid="PSA 29:8">MUKAMA atengyetsa eihamba rya Kadeshi.<verse eid="PSA 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 39:1-3">Yob 39:1-3</ref>. </char>
    </note> Eiraka rya MUKAMA ritoroozya empara, rikonkobora ebibira;</para>
  <para style="q1" vid="PSA 29:9">Kandi omuri hekalu ye byona bigira biti: Oheebwe ekitiinisa.<verse eid="PSA 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:16">Zab 10:16</ref>; <ref loc="GEN 6:17">Kut 6:17</ref>. </char>
    </note> MUKAMA akashutama aha kitebe ky'obukama bwe aha mwegyemure gw'amaizi;</para>
  <para style="q1" vid="PSA 29:10">Eego, MUKAMA atuura ari Omukama ebiro byona.<verse eid="PSA 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:35">Zab 68:35</ref>; <ref loc="ISA 40:29">Isa 40:29</ref>. </char>
    </note> MUKAMA aryaha abantu be amaani;</para>
  <para style="q1" vid="PSA 29:11">MUKAMA aryaha abantu be omugisha gw'obusingye.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="d">Okusiima Ruhanga ahabw'okwihwa omu busaasi Zaaburi ya Daudi. N'ekyeshongoro ekyayeshongoirwe, obu baashoroora hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>; <ref loc="PSA 35:19">35:19</ref>, <ref loc="PSA 35:24">24</ref>. </char>
    </note> Ai MUKAMA, ninkuhimbisa, ahakuba onyimukize,</para>
  <para style="q1" vid="PSA 30:1">Kandi tiwaareka bazigu bangye kuunyehimbisizaho.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:2">Zab 6:2</ref>; <ref loc="PSA 88:13">88:13</ref>. </char>
    </note> Ai MUKAMA Ruhanga wangye,</para>
  <para style="q1" vid="PSA 30:2">Nkakutakira, wankiza.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:10">Zab 16:10</ref>; <ref loc="PSA 28:1">28:1</ref>. </char>
    </note> MUKAMA, okaiha amagara gangye Okuzimu,</para>
  <para style="q1" vid="PSA 30:3">Wandinda, naaguma ndi ohuriire,</para>
  <para style="q1" vid="PSA 30:3">Waanyiha omu barikushuuma omu Kiina.<verse eid="PSA 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:5">Zab 50:5</ref>; <ref loc="PSA 97:12">97:12</ref>. </char>
    </note> Imwe abarikwera be, mweshongorere MUKAMA eby'okuhimbisa,</para>
  <para style="q1" vid="PSA 30:4">Kandi musiime eiziina rye eririkwera.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:9">Zab 103:9</ref>; <ref loc="ISA 54:7">Isa 54:7</ref>, <ref loc="ISA 54:8">8</ref>. </char>
    </note> Ahakuba ekiniga kye n'eky'akaanya kakye,</para>
  <para style="q1" vid="PSA 30:5">Kwonka embabazi ze zigumaho ebiro byona eby'amagara g'omuntu.</para>
  <para style="q1" vid="PSA 30:5">Okurira kukaaraarira omuntu nyekiro,</para>
  <para style="q1" vid="PSA 30:5">Kwonka okushemererwa kwija omu kasheeshe.<verse eid="PSA 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:6">Zab 10:6</ref>; <ref loc="PRO 1:32">Enf 1:32</ref>. </char>
    </note> Nyowe omu biro by'okuhiirwa kwangye nkagira nti:</para>
  <para style="q1" vid="PSA 30:6">Tinditengyetsibwa ebiro byona.<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:29">Zab 104:29</ref>; <ref loc="2SA 24:10">2 Sam 24:10</ref>. </char>
    </note> Iwe MUKAMA, ahabw'embabazi zaawe okangumya nk'ekibungo;</para>
  <para style="q1" vid="PSA 30:7">Ku wanyimire amaisho naaburaburirwa,<verse eid="PSA 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 142:1">Zab 142:1</ref>. </char>
    </note> Naakutakira, ai MUKAMA;</para>
  <para style="q1" vid="PSA 30:8">Kandi niiwe naayeshengyereza, nkeebuuza nti:<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:5">Zab 6:5</ref>. </char>
    </note> Ku ndishuuma omu Kiina, eshagama yangye eryangasira ki?</para>
  <para style="q1" vid="PSA 30:9">Omucuucu guryakuhimbisa, nari gumanyise amazima gaawe?<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:7">Zab 27:7</ref>. </char>
    </note> Hurira, ai MUKAMA, ongirire embabazi!</para>
  <para style="q1" vid="PSA 30:10">MUKAMA, ogume ori Omuhwezi wangye!<verse eid="PSA 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:11: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 6:14">2 Sam 6:14</ref>; <ref loc="JER 31:13">Yer 31:13</ref>. </char>
    </note> Okucura kwangye okakuhindura okuzina;</para>
  <para style="q1" vid="PSA 30:11">Okanzirikuurura ekiguniya, wanzirika okushemererwa,<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">30:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:9">Zab 16:9</ref>. </char>
    </note> Ngu amagara gangye gakuhimbise, garekye kuhunama.</para>
  <para style="q1" vid="PSA 30:12">Ai MUKAMA Ruhanga wangye, ndyakusiima ebiro byona.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" sid="PSA 31" />
  <para style="d">Okwesiga Mukama turi omu kabi Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 31:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:1-3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:1-3">Zab 71:1-3</ref>. </char>
    </note> Ai MUKAMA, niiwe ndikwesiga, otarindeka kuhemuka ebiro byona;</para>
  <para style="q1" vid="PSA 31:1">Onjune ahabw'okuhikiirira kwawe.<note caller="-" style="x"><char style="xo" closed="false">31:1: </char><char style="xt" closed="false"><ref loc="PSA 11:1">Zab 11:1</ref>; <ref loc="PSA 31:17">31:17</ref>. </char></note><verse eid="PSA 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:2">Zab 71:2</ref>; <ref loc="PSA 86:1">86:1</ref>; <ref loc="PSA 91:2">91:2</ref>. </char>
    </note> Ontegye okutu, orahukye kunjuna;</para>
  <para style="q1" vid="PSA 31:2">Ombeere orukiri rw'okuhungiramu, kandi orugo rugumire orw'okunjuna.<verse eid="PSA 31:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:2">Zab 18:2</ref>; <ref loc="PSA 23:2">23:2</ref>; <ref loc="JER 14:7">Yer 14:7</ref>. </char>
    </note> Eego niiwe rukiri rwangye, kandi orugo rwangye orugumire;</para>
  <para style="q1" vid="PSA 31:3">Ahabw'eiziina ryawe onyebembere, kandi ompabure,<verse eid="PSA 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:15">Zab 25:15</ref>; <ref loc="PSA 43:2">43:2</ref>. </char>
    </note> Onyihe omu mutego ogu bantegire,</para>
  <para style="q1" vid="PSA 31:4">Ahakuba niiwe buhungiro bwangye.<verse eid="PSA 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:5: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="LUK 23:46">Luk 23:46</ref>; <ref loc="ACT 7:59">Byak 7:59</ref>; <ref loc="1PE 4:19">1 Pet 4:19</ref>. </char>
    </note> Ninta omwoyo gwangye omu mikono yaawe;</para>
  <para style="q1" vid="PSA 31:5">Okancungura, ai MUKAMA, iwe Ruhanga orikwesigwa.<verse eid="PSA 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:22">Yer 14:22</ref>; <ref loc="JON 2:8">Yon 2:8</ref>. </char>
    </note> Nyanga abata omutima aha bishushani ebirikuramibwa ebitaine mugasho;</para>
  <para style="q1" vid="PSA 31:6">Kandi nyesiga MUKAMA.<verse eid="PSA 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7" />Ndyashemererwa, nyesiime ahabw'embabazi zaawe;</para>
  <para style="q1" vid="PSA 31:7">Ahakuba okareeba obusaasi bwangye,</para>
  <para style="q1" vid="PSA 31:7">Waamanya enaku zangye,<verse eid="PSA 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:19">Zab 18:19</ref>. </char>
    </note> Kandi tokampayoga mu mikono y'abazigu;</para>
  <para style="q1" vid="PSA 31:8">Okata ebigyere byangye omu mwanya ogugarami.<verse eid="PSA 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:7">Zab 6:7</ref>. </char>
    </note> Ongirire embabazi, ai MUKAMA, ahakuba nyine obusaasi;</para>
  <para style="q1" vid="PSA 31:9">Eriisho ringwire omunda,</para>
  <para style="q1" vid="PSA 31:9">amagara gangye n'omubiri gwangye binyangaraire ahabw'obusaasi.<verse eid="PSA 31:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:2">Zab 6:2</ref>; <ref loc="PSA 38:3">38:3</ref>. </char>
    </note> Ahakuba ebiro byangye byona mbimazire nyine enaku,</para>
  <para style="q1" vid="PSA 31:10">N'emyaka yangye ngimazire nintsinda;</para>
  <para style="q1" vid="PSA 31:10">Mpweirwemu amaani ahabw'okushiisha kwangye,</para>
  <para style="q1" vid="PSA 31:10">N'amagufa gangye goomire.<verse eid="PSA 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:8">Zab 88:8</ref>; <ref loc="JOB 19:13">Yob 19:13</ref>, <ref loc="JOB 19:14">14</ref>. </char>
    </note> Aha bazigu bangye boona mpindukira ekujumo,</para>
  <para style="q1" vid="PSA 31:11">N'okukira munonga ahari bataahi bangye,</para>
  <para style="q1" vid="PSA 31:11">Kandi ahari bagyenzi bangye mbaire ekirikutiinisa;</para>
  <para style="q1" vid="PSA 31:11">Abarikumbugana omu muhanda, nibampunga.<verse eid="PSA 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:5">Zab 88:5</ref>; <ref loc="ECC 9:5">Mub 9:5</ref>. </char>
    </note> Nyebire nk'ofiire otakiijukwa,</para>
  <para style="q1" vid="PSA 31:12">Ndi nk'orwabya orwatikire.<verse eid="PSA 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:13: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 17:1-4">2 Sam 17:1-4</ref>; <ref loc="JER 20:10">Yer 20:10</ref>; <ref loc="MAT 27:1">Mat 27:1</ref>. </char>
    </note> Eego, nimpurira baingi nibambeiherera;</para>
  <para style="q1" vid="PSA 31:13">Obwoba bunturukire embaju zoona,</para>
  <para style="q1" vid="PSA 31:13">Nibangiira omu naama, kusherura obwengye bw'okuunyita.<verse eid="PSA 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:1">Zab 31:1</ref>, <ref loc="PSA 31:6">6</ref>. </char>
    </note> Kwonka niiwe ndikwesiga, ai MUKAMA,</para>
  <para style="q1" vid="PSA 31:14">Ningira nti: Niiwe Ruhanga wangye.<verse eid="PSA 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:1">Zab 7:1</ref>. </char>
    </note> Ebiro byangye biri omu mikono yaawe;</para>
  <para style="q1" vid="PSA 31:15">Onyihe omu mikono y'abazigu bangye n'abarikumpiiga.<verse eid="PSA 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:135">Zab 119:135</ref>; <ref loc="DAN 9:17">Dan 9:17</ref>; <ref loc="NUM 6:25">Kub 6:25</ref>. </char>
    </note> Oyakize omwiru waawe omushana gw'amaisho gaawe;</para>
  <para style="q1" vid="PSA 31:16">Onjune ahabw'embabazi zaawe enyingi.<verse eid="PSA 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>; <ref loc="PSA 31:1">31:1</ref>; <ref loc="PSA 115:17">115:17</ref>; <ref loc="1SA 2:9">1 Sam 2:9</ref>. </char>
    </note> Otandeka kwitwa enshoni, ai MUKAMA,</para>
  <para style="q1" vid="PSA 31:17">Ahabw'okuba nkutakiire;</para>
  <para style="q1" vid="PSA 31:17">Ababi ka babe nibo baitwa enshoni,</para>
  <para style="q1" vid="PSA 31:17">Bashuume Okuzimu bahunami.<verse eid="PSA 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:3">Zab 12:3</ref>; <ref loc="PSA 17:10">17:10</ref>. </char>
    </note> Abarikubeiha bagobwe endimi,</para>
  <para style="q1" vid="PSA 31:18">Abarikugamba kubi aha bahikiriire,</para>
  <para style="q1" vid="PSA 31:18">Baine amaryo n'okwemanya n'okugaya.<verse eid="PSA 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 64:4">Isa 64:4</ref>. </char>
    </note> Oburungi bwawe ka ni bwingi, obu waabiikiire abarikukutiina,</para>
  <para style="q1" vid="PSA 31:19">Obu waagiriire abarikukwesiga omu maisho g'abantu!<verse eid="PSA 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:5">Zab 27:5</ref>; <ref loc="PSA 32:7">32:7</ref>; <ref loc="JOB 5:21">Yob 5:21</ref>. </char>
    </note> Omu bweshereko ahu otuura niho oribashereka enaama mbi z'abantu,</para>
  <para style="q1" vid="PSA 31:20">Oryabarindira omu kibanda kyawe, bakire empaka z'endimi.<verse eid="PSA 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:7">Zab 17:7</ref>; <ref loc="1SA 23:7">1 Sam 23:7</ref>. </char>
    </note> MUKAMA ahimbisibwe,</para>
  <para style="q1" vid="PSA 31:21">Ahakuba akanyoreka embabazi ze ez'okutangaaza omu rurembo rw'amaani.<verse eid="PSA 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:22: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 15:4">2 Sam 15:4</ref>; <ref loc="ISA 38:11">Isa 38:11</ref>, <ref loc="ISA 38:12">12</ref>; <ref loc="JON 2:4">Yon 2:4</ref>. </char>
    </note> Nkagambisa obwoba nti:</para>
  <para style="q1" vid="PSA 31:22">Ncwirwe omu maisho gaawe;</para>
  <para style="q1" vid="PSA 31:22">Kwonka ku naakutakiire, waahurira okweshengyereza kwangye.<verse eid="PSA 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:4">Zab 30:4</ref>; <ref loc="DEU 32:41">Bir 32:41</ref>. </char>
    </note> Mukunde MUKAMA, imwe abarikwera be boona!</para>
  <para style="q1" vid="PSA 31:23">MUKAMA arinda abeesigwa,</para>
  <para style="q1" vid="PSA 31:23">Kwonka orikukoresa emyekuniko, naamuzimuurira bingi ebimushemereire.<verse eid="PSA 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">31:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:14">Zab 27:14</ref>. </char>
    </note> Mugire amaani, mugume omutima,</para>
  <para style="q1" vid="PSA 31:24">Imwe mwena abategyereza MUKAMA.<verse eid="PSA 31:24" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" sid="PSA 32" />
  <para style="d">Okuhiirwa kw'omuntu osaasiirwe ekibi Zaaburi ya Daudi. Ekyeshongoro ekirikwetwa Masikiili ekyagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 32:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:7">Rom 4:7</ref>, <ref loc="ROM 4:8">8</ref>. </char>
    </note> Aine omugisha osaasiirwe eby'okushiisha bye,</para>
  <para style="q1" vid="PSA 32:1">N'ebibi bye bikashwekwa.<note caller="-" style="x"><char style="xo" closed="false">32:1 </char><char style="xt" closed="false"><ref loc="PSA 32:1">32:1</ref>; <ref loc="PSA 85:2">85:2</ref>; <ref loc="EXO 34:7">Kur 34:7</ref>; <ref loc="PSA 6:7">Zab 6:7</ref>. </char></note><verse eid="PSA 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:2: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:47">Yoh 1:47</ref>; <ref loc="2CO 5:19">2 Kor 5:19</ref>. </char>
    </note> Aine omugisha omuntu ou MUKAMA atabarira kutahikiirira,</para>
  <para style="q1" vid="PSA 32:2">Ou omutima gwe gutarimu bugobya.<verse eid="PSA 32:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:1">Zab 22:1</ref>; <ref loc="PSA 31:10">31:10</ref>. </char>
    </note> Ku naayangire kwatura ekibi kyangye, naahwa aha magufa</para>
  <para style="q1" vid="PSA 32:3">Ahabw'okurenzya eizooba nintsinda.<verse eid="PSA 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:4: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 5:6">1 Sam 5:6</ref>, <ref loc="1SA 5:11">11</ref>. </char>
    </note> Ahabw'okuba omukono gwawe gukaba gumpingamira nyomushana na nyekiro,</para>
  <para style="q1" vid="PSA 32:4">Amagara gangye gaayoma nk'oku omuntu ayomibwa omushana gw'ekyanda.<verse eid="PSA 32:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:18">Zab 38:18</ref>; <ref loc="PSA 51:3">51:3</ref>; <ref loc="2SA 12:13">2 Sam 12:13</ref>; <ref loc="PRO 28:13">Enf 28:13</ref>; <ref loc="LUK 15:18">Luk 15:18</ref>; <ref loc="1JN 1:9">1 Yoh 1:9</ref>. </char>
    </note> Nkakugambira ekibi kyangye,</para>
  <para style="q1" vid="PSA 32:5">Tinaakushereka kutahikiirira kwangye;</para>
  <para style="q1" vid="PSA 32:5">Naagira nti: Naaza kwaturira MUKAMA eby'okushiisha byangye.</para>
  <para style="q1" vid="PSA 32:5">Naiwe nikwo kunsaasira orubanja rw'ekibi kyangye.<verse eid="PSA 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:7">Zab 42:7</ref>; <ref loc="PSA 69:1">69:1</ref>, <ref loc="PSA 69:13">13</ref>; <ref loc="ISA 55:6">Isa 55:6</ref>. </char>
    </note> N'ahabw'ekyo orikutiina Ruhanga weena akushabe omu biro by'obusaasi,</para>
  <para style="q1" vid="PSA 32:6">Kandi omwegyemure gw'amaizi maingi tigurimuhikaho.<verse eid="PSA 32:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:9">Zab 9:9</ref>; <ref loc="PSA 31:20">31:20</ref>; <ref loc="PSA 119:114">119:114</ref>; <ref loc="JDG 5:1-31">Bar 5:1-31</ref>; <ref loc="EXO 15:1-18">Kur 15:1-18</ref>. </char>
    </note> Niiwe bweshereko bwangye, oryandinda ndekye kureeba enaku;</para>
  <para style="q1" vid="PSA 32:7">Oryanyehinguririza n'ebyeshongoro by'okujunwa.<verse eid="PSA 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:8">Zab 25:8</ref>, <ref loc="PSA 25:12">12</ref>; <ref loc="ISA 48:17">Isa 48:17</ref>. </char>
    </note> Ndyakwegyesa, nkuhabure omuhanda ogu oritoora;</para>
  <para style="q1" vid="PSA 32:8">Ndyakuha obwengye, nkutaireho eriisho.<verse eid="PSA 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 35:11">Yob 35:11</ref>; <ref loc="PRO 26:3">Enf 26:3</ref>. </char>
    </note> Mutariba nk'embaraasi nari enyumbu, ezitaine bwengye,</para>
  <para style="q1" vid="PSA 32:9">Ezishemereire kutegyekyesibwa ekyoma ky'omu kanwa, n'enkoba z'omu bitsya,</para>
  <para style="q1" vid="PSA 32:9">Ahatari ebyo, tizaakugumire naiwe.<verse eid="PSA 32:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:8">Zab 34:8</ref>; <ref loc="PRO 13:21">Enf 13:21</ref>; <ref loc="PRO 16:20">16:20</ref>; <ref loc="JER 17:7">Yer 17:7</ref>; <ref loc="ROM 2:9">Rom 2:9</ref>. </char>
    </note> Ababi baryareeba obusaasi bwingi;</para>
  <para style="q1" vid="PSA 32:10">Kwonka oyesiga MUKAMA, embabazi ziryamwehinguririza.<verse eid="PSA 32:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 64:10">Zab 64:10</ref>; <ref loc="PSA 68:3">68:3</ref>. </char>
    </note> Mushemerererwe omuri MUKAMA, mwesiime, imwe abahikiriire;</para>
  <para style="q1" vid="PSA 32:11">Muteere akaari k'okushemererwa, imwe mwena abaine emitima egororokire.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" sid="PSA 33" />
  <para style="s1">Okusiima Ruhanga Omuhangi n'Omurinzi waitu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 33:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:11">Zab 32:11</ref>. </char>
    </note> Imwe abahikiriire, mushemerererwe omuri MUKAMA,</para>
  <para style="q1" vid="PSA 33:1">Okuhimbisa kushemereire ab'amazima.<verse eid="PSA 33:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:22">Zab 71:22</ref>; <ref loc="PSA 144:9">144:9</ref>. </char>
    </note> Muhimbise MUKAMA n'enanga;</para>
  <para style="q1" vid="PSA 33:2">Mumuteerere enanga ey'emirya ikumi!<verse eid="PSA 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:3">Zab 40:3</ref>; <ref loc="ISA 42:10">Isa 42:10</ref>; <ref loc="PSA 40:3">Zab 40:3</ref>. </char>
    </note> Mumweshongorere ekyeshongoro kisya;</para>
  <para style="q1" vid="PSA 33:3">Mugiteere gye, mugijumeeze.<verse eid="PSA 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4" />Ahakuba ekigambo kya MUKAMA kihikire;</para>
  <para style="q1" vid="PSA 33:4">Kandi emirimo ye yoona agikora n'obwesigwa.<verse eid="PSA 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 89:14">89:14</ref>; <ref loc="PSA 119:64">119:64</ref>. </char>
    </note> Akunda okuhikiirira n'eby'oburyo;</para>
  <para style="q1" vid="PSA 33:5">Ensi eijwire embabazi za MUKAMA.<verse eid="PSA 33:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:6">Kut 1:6</ref>, <ref loc="GEN 1:7">7</ref>; <ref loc="GEN 2:1">2:1</ref>; <ref loc="ISA 11:4">Isa 11:4</ref>; <ref loc="JHN 1:1-3">Yoh 1:1-3</ref>; <ref loc="HEB 11:3">Heb 11:3</ref>; <ref loc="2PE 3:5">2 Pet 3:5</ref>. </char>
    </note> Ekigambo kya MUKAMA nikyo kyahangire eiguru;</para>
  <para style="q1" vid="PSA 33:6">N'omwitsyo gw'omu kanwa ke nigwo gwahangire amahe gaamwo goona.<verse eid="PSA 33:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:8">Kur 15:8</ref>; <ref loc="JOS 3:13">Yos 3:13</ref>. </char>
    </note> Akarundaana amaizi g'omu nyanja nk'agari omu cupa;</para>
  <para style="q1" vid="PSA 33:7">Yaabiika eby'okuzimu omu bitara bye.<verse eid="PSA 33:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8" />Ensi yoona ehe MUKAMA ekitiinisa,</para>
  <para style="q1" vid="PSA 33:8">N'abagituuramu boona bamutiine!<verse eid="PSA 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 148:5">Zab 148:5</ref>; <ref loc="GEN 1:3">Kut 1:3</ref>. </char>
    </note> Ahakuba akagamba, kyabakwo;</para>
  <para style="q1" vid="PSA 33:9">Yaaragiira, kyahama.<verse eid="PSA 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:10: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 15:34">2 Sam 15:34</ref>; <ref loc="2SA 17:14">17:14</ref>; <ref loc="NEH 4:15">Neh 4:15</ref>; <ref loc="ISA 8:10">Isa 8:10</ref>; <ref loc="ISA 19:3">19:3</ref>. </char>
    </note> MUKAMA ahindura busha enaama mbi z'amahanga,</para>
  <para style="q1" vid="PSA 33:10">Azibira ebi abantu bateekateeka kukora.<verse eid="PSA 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:11: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:21">Enf 19:21</ref>; <ref loc="ISA 46:10">Isa 46:10</ref>; <ref loc="ACT 4:27">Byak 4:27</ref>, <ref loc="ACT 4:28">28</ref>. </char>
    </note> Enaama za MUKAMA zihamire ebiro byona,</para>
  <para style="q1" vid="PSA 33:11">Ebiteekateeko by'omu mutima gwe bigumaho okuhitsya obusingye bwona.<verse eid="PSA 33:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:15">Zab 144:15</ref>; <ref loc="DEU 7:6">Bir 7:6</ref>. </char>
    </note> Riine omugisha eihanga eri MUKAMA ari Ruhanga waaryo,</para>
  <para style="q1" vid="PSA 33:12">Abantu abu yaatooraine kuba obuhunguzi bwe.<verse eid="PSA 33:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:13: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 16:9">2 Bus 16:9</ref>; <ref loc="JOB 34:21">Yob 34:21</ref>; <ref loc="PSA 11:4">Zab 11:4</ref>; <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> MUKAMA anaga amaisho ari omu iguru,</para>
  <para style="q1" vid="PSA 33:13">Areeba abantu boona;<verse eid="PSA 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:14: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:39">1 Bag 8:39</ref>, <ref loc="1KI 8:49">49</ref>; <ref loc="JER 32:19">Yer 32:19</ref>. </char>
    </note> Areeba abatuura omu nsi boona</para>
  <para style="q1" vid="PSA 33:14">Ashutami aha kitebe kye ky'obukama.<verse eid="PSA 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:15: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 64:8">Isa 64:8</ref>. </char>
    </note> Niwe abumba emitima y'abo boona,</para>
  <para style="q1" vid="PSA 33:15">Akeetegyereza ebi bakora byona.<verse eid="PSA 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:6">Zab 44:6</ref>. </char>
    </note> Omugabe tajunwa ngabo ze nyingi;</para>
  <para style="q1" vid="PSA 33:16">Emanzi tekira habw'amaani gaayo amaingi.<verse eid="PSA 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:7">Zab 20:7</ref>; <ref loc="PRO 21:31">Enf 21:31</ref>; <ref loc="HOS 1:7">Hos 1:7</ref>. </char>
    </note> Embaraasi n'ekintu ekitarikubaasa kureeta businguzi,</para>
  <para style="q1" vid="PSA 33:17">N'obu kwakuba okujuna omuntu ahabw'amaani gaayo amaingi.<verse eid="PSA 33:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:15">Zab 34:15</ref>; <ref loc="JOB 36:7">Yob 36:7</ref>. </char>
    </note> Reeba, eriisho rya MUKAMA riguma aha barikumutiina,</para>
  <para style="q1" vid="PSA 33:18">Abagira amatsiko omu mbabazi ze,<verse eid="PSA 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:19">Zab 37:19</ref>; <ref loc="JOB 5:20">Yob 5:20</ref>; <ref loc="ACT 12:11">Byak 12:11</ref>. </char>
    </note> Ngu akize amagara gaabo okufa.</para>
  <para style="q1" vid="PSA 33:19">Kandi abarinde okutaitwa njara.<verse eid="PSA 33:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:9-11">Zab 115:9-11</ref>; <ref loc="ISA 8:17">Isa 8:17</ref>. </char>
    </note> Amagara gaitu gategyereza MUKAMA;</para>
  <para style="q1" vid="PSA 33:20">Niwe Muhwezi waitu kandi engabo yaitu.<verse eid="PSA 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:21: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 10:7">Zek 10:7</ref>. </char>
    </note> Eego, emitima yaitu eshemerererwa omuriwe.</para>
  <para style="q1" vid="PSA 33:21">Ahakuba twesiga eiziina rye eririkwera.<verse eid="PSA 33:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22" />Embabazi zaawe, ai MUKAMA, zigume naitwe,</para>
  <para style="q1" vid="PSA 33:22">Nk'oku turikukwesiga.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" sid="PSA 34" />
  <para style="d">Oku Ruhanga arinda abantu be abarikumwesiga Zaaburi ya Daudi, obu yaayegwisiza Abimeleki eiraro, Abimeleki akamubinga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 34:1" />Ndyahimbisa MUKAMA ebiro byona;</para>
  <para style="q1" vid="PSA 34:1">Okusingizibwa kwe kuryaguma omu kanwa kangye.<verse eid="PSA 34:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:8">Zab 44:8</ref>; <ref loc="JER 9:24">Yer 9:24</ref>; <ref loc="1CO 1:31">1 Kor 1:31</ref>. </char>
    </note> Amagara gangye garyayeraatira omuri MUKAMA;</para>
  <para style="q1" vid="PSA 34:2">Abarikubonabonesibwa bakihurire, beesiime.<verse eid="PSA 34:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:30">Zab 69:30</ref>; <ref loc="LUK 1:46">Luk 1:46</ref>. </char>
    </note> Mukwatanise naanye okuha MUKAMA ekitiinisa.</para>
  <para style="q1" vid="PSA 34:3">Tuhimbise kumwe eiziina rye.<verse eid="PSA 34:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Zab 18:6</ref>; <ref loc="MAT 7:7">Mat 7:7</ref>. </char>
    </note> Nkasherura MUKAMA, yaangarukamu;</para>
  <para style="q1" vid="PSA 34:4">Yankiza ebyabaire nibintiinisa byona.<verse eid="PSA 34:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5" />Mumuhangye amaisho, mujwerwe omushana;</para>
  <para style="q1" vid="PSA 34:5">N'amaisho gaanyu tigarikwatwa nshoni obundi.<verse eid="PSA 34:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:6: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 22:1">2 Sam 22:1</ref>. </char>
    </note> Enshoberwa egi ekatakira MUKAMA, yaagihurira,</para>
  <para style="q1" vid="PSA 34:6">Yaagikiza enaku zaayo zoona.<verse eid="PSA 34:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 32:1">Kut 32:1</ref>, <ref loc="GEN 32:2">2</ref>; <ref loc="2KI 6:17">2 Bag 6:17</ref>; <ref loc="DAN 6:22">Dan 6:22</ref>; <ref loc="HEB 1:14">Heb 1:14</ref>. </char>
    </note> Maraika wa MUKAMA ateera amahema okwehinguririza abarikumutiina,</para>
  <para style="q1" vid="PSA 34:7">Kandi abajuna.<verse eid="PSA 34:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:12">Zab 2:12</ref>; <ref loc="HEB 6:5">Heb 6:5</ref>; <ref loc="1PE 2:3">1 Pet 2:3</ref>. </char>
    </note> Yeimwe, nimuroze, mureebe MUKAMA ku ari murungi!</para>
  <para style="q1" vid="PSA 34:8">Orikumwesiga weena aine omugisha.<verse eid="PSA 34:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:9: </char>
      <char style="xt" closed="false">
        <ref loc="PHP 4:19">Fil 4:19</ref>. </char>
    </note> Mutiine MUKAMA, imwe abarikwera be;</para>
  <para style="q1" vid="PSA 34:9">ahakuba abarikumutiina tibagira ki bakyena,<verse eid="PSA 34:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:11">Zab 84:11</ref>; <ref loc="JOB 4:10">Yob 4:10</ref>, <ref loc="JOB 4:11">11</ref>. </char>
    </note> Obwana bw'entare bubura eby'okurya, bwitwa enjara,</para>
  <para style="q1" vid="PSA 34:10">Kwonka abasherura MUKAMA, tibariburirwa kirungi kyona.<verse eid="PSA 34:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:16">Zab 66:16</ref>. </char>
    </note> Imwe baana 'mwe, mwije mumpurire;</para>
  <para style="q1" vid="PSA 34:11">Mbeegyesa okutiina MUKAMA.<verse eid="PSA 34:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:12-16: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:10-12">1 Pet 3:10-12</ref>. </char>
    </note> N'oha orikwenda amagara, akakunda okuhangaara</para>
  <para style="q1" vid="PSA 34:12">Ngu abone omugisha?<verse eid="PSA 34:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:3">Zab 15:3</ref>; <ref loc="PSA 141:3">141:3</ref>; <ref loc="JAS 1:26">Yak 1:26</ref>; <ref loc="1PE 2:1">1 Pet 2:1</ref>, <ref loc="1PE 2:22">22</ref>; <ref loc="REV 14:5">Kush 14:5</ref>. </char>
    </note> Zibira orurimi rwawe kugamba ebibi,</para>
  <para style="q1" vid="PSA 34:13">N'eminwa yaawe okuryarya.<verse eid="PSA 34:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:27">Zab 37:27</ref>; <ref loc="ROM 12:18">Rom 12:18</ref>; <ref loc="ROM 14:19">14:19</ref>; <ref loc="3JN 1:11">3 Yoh 11</ref>. </char>
    </note> Reka ebibi, okore ebirungi;</para>
  <para style="q1" vid="PSA 34:14">Sherura obusingye, kandi obukuratire.<verse eid="PSA 34:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:18">Zab 33:18</ref>; <ref loc="JHN 9:31">Yoh 9:31</ref>. </char>
    </note> Amaisho ga MUKAMA agata aha bahikiriire,</para>
  <para style="q1" vid="PSA 34:15">N'amatu ge agatega okutaka kwabo.<verse eid="PSA 34:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:10">Zab 21:10</ref>; <ref loc="JER 44:11">Yer 44:11</ref>; <ref loc="AMO 9:4">Amo 9:4</ref>. </char>
    </note> Ekitsyori kya MUKAMA akiteera abakora kubi,</para>
  <para style="q1" vid="PSA 34:16">Kumaraho okwijukwa kwabo omu nsi.<verse eid="PSA 34:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17" />Abahikiriire ku bataka, MUKAMA ahurira,</para>
  <para style="q1" vid="PSA 34:17">Abajuna omu naku zaabo zoona.<verse eid="PSA 34:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:17">Zab 51:17</ref>; <ref loc="ISA 61:1">Isa 61:1</ref>; <ref loc="ISA 66:2">66:2</ref>. </char>
    </note> MUKAMA aba haihi ab'emitima ehendekire,</para>
  <para style="q1" vid="PSA 34:18">Ajuna ab'omutima ogweteisiize kimwe.<verse eid="PSA 34:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:6">Zab 34:6</ref>; <ref loc="ACT 12:11">Byak 12:11</ref>; <ref loc="2TI 3:11">2 Tim 3:11</ref>, <ref loc="2TI 3:12">12</ref>. </char>
    </note> Ebibonabono by'ohikiriire ni bingi;</para>
  <para style="q1" vid="PSA 34:19">Kwonka MUKAMA abimwihamu byona.<verse eid="PSA 34:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:20: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:46">Kur 12:46</ref>; <ref loc="JHN 19:36">Yoh 19:36</ref>. </char>
    </note> Arinda amagufa ge goona,</para>
  <para style="q1" vid="PSA 34:20">Tihahendekaho na rimwe.<verse eid="PSA 34:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>, <ref loc="PSA 7:16">16</ref>; <ref loc="PSA 94:23">94:23</ref>. </char>
    </note> Obubi buryaita ababi;</para>
  <para style="q1" vid="PSA 34:21">N'abanga ohikiriire baryasingwa orubanja.<verse eid="PSA 34:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:22">Zab 25:22</ref>; <ref loc="PSA 103:4">103:4</ref>; <ref loc="ROM 8:33">Rom 8:33</ref>, <ref loc="ROM 8:34">34</ref>. </char>
    </note> MUKAMA acungura amagara g'abairu be;</para>
  <para style="q1" vid="PSA 34:22">Tihariho n'omwe omu bamuhungiraho orisingwa orubanja.<verse eid="PSA 34:22" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" sid="PSA 35" />
  <para style="d">Okushaba kw'ohikiriire okutonganirwa omu maisho g'abazigu be Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 35:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:25">Kur 14:25</ref>; <ref loc="ISA 49:25">Isa 49:25</ref>. </char>
    </note> Ai MUKAMA, tongana n'abarikuntonganisa;</para>
  <para style="q1" vid="PSA 35:1">Orwane n'abarikundwanisa.<verse eid="PSA 35:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2" />Kwata engabo n'akagabo,</para>
  <para style="q1" vid="PSA 35:2">Oimukye, ompe emikono!<verse eid="PSA 35:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3" />Ihayo eicumu, okumiirire abambingire;</para>
  <para style="q1" vid="PSA 35:3">Ogire amagara gangye oti: Niinye kujunwa kwawe.<verse eid="PSA 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:4-8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:22-28">Zab 69:22-28</ref>; <ref loc="PSA 109:6-15">109:6-15</ref>. </char>
    </note> Haza abarikwenda kuunyita</para>
  <para style="q1" vid="PSA 35:4">Bahemurwe, baihweho ekitiinisa!</para>
  <para style="q1" vid="PSA 35:4">Abangiriire enaama mbi</para>
  <para style="q1" vid="PSA 35:4">Bagarurwe enyima, bagaywe!<note caller="-" style="x"><char style="xo" closed="false">35:4: </char><char style="xt" closed="false"><ref loc="PSA 35:26">Zab 35:26</ref>; <ref loc="PSA 40:14">40:14</ref>; <ref loc="PSA 70:2">70:2</ref>; <ref loc="PSA 71:13">71:13</ref>. </char></note><verse eid="PSA 35:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:18">Yob 21:18</ref>. </char>
    </note> Babe nk'ebishushunga ebitwarwa omuyaga,</para>
  <para style="q1" vid="PSA 35:5">Na maraika wa MUKAMA ababingye.<verse eid="PSA 35:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:18">Zab 73:18</ref>; <ref loc="JER 23:12">Yer 23:12</ref>. </char>
    </note> Omuhanda gwabo gugire omwirima n'obuterezi,</para>
  <para style="q1" vid="PSA 35:6">Obwo maraika wa MUKAMA ababingire.<verse eid="PSA 35:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7" />Ahakuba bantegire omutego,</para>
  <para style="q1" vid="PSA 35:7">Amagara gangye bagategire obusya, nibantura busha.<verse eid="PSA 35:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>; <ref loc="PRO 5:22">Enf 5:22</ref>; <ref loc="1TH 5:3">1 Tes 5:3</ref>. </char>
    </note> Okucwekyerera kubagweho batakimanyire,</para>
  <para style="q1" vid="PSA 35:8">Omutego ogu bategire gube nibo gwakwata,</para>
  <para style="q1" vid="PSA 35:8">Bagugwemu, bacwekyerere.<verse eid="PSA 35:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:14">Zab 9:14</ref>; <ref loc="ISA 61:10">Isa 61:10</ref>; <ref loc="LUK 1:47">Luk 1:47</ref>. </char>
    </note> Obwo nibwo amagara gangye garishemerererwa omuri MUKAMA,</para>
  <para style="q1" vid="PSA 35:9">Nigeesiimira okujuna kwe.<verse eid="PSA 35:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:8">Zab 51:8</ref>; <ref loc="PSA 71:19">71:19</ref>; <ref loc="PSA 86:8">86:8</ref>. </char>
    </note> Amagufa gangye goona garyagira gati:</para>
  <para style="q1" vid="PSA 35:10">Ai MUKAMA, n'oha orikushushana naiwe,</para>
  <para style="q1" vid="PSA 35:10">Iwe oiha otaine maani</para>
  <para style="q1" vid="PSA 35:10">Omu mikono y'orikumukiza amaani,</para>
  <para style="q1" vid="PSA 35:10">Okakiza otaine maani kandi enshoberwa</para>
  <para style="q1" vid="PSA 35:10">Omu mikono y'orikumunyaga.<verse eid="PSA 35:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:12">Zab 27:12</ref>. </char>
    </note> Baamushinja b'ebishuba baimuka,</para>
  <para style="q1" vid="PSA 35:11">Bantabaaririza ebi ntarikumanya;<verse eid="PSA 35:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:20">Zab 38:20</ref>; <ref loc="JER 18:20">Yer 18:20</ref>. </char>
    </note> Baanyihura ebibi ahabw'ebirungi,</para>
  <para style="q1" vid="PSA 35:12">Baareetera amagara gangye okushoberwa.<verse eid="PSA 35:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:10">Zab 69:10</ref>, <ref loc="PSA 69:11">11</ref>; <ref loc="MAT 10:13">Mat 10:13</ref>; <ref loc="JOB 30:25">Yob 30:25</ref>; <ref loc="1KI 20:31">1 Bag 20:31</ref>. </char>
    </note> Haza bo, ku baabaire barwaire,</para>
  <para style="q1" vid="PSA 35:13">Naajwara ebiguniya, naayebonabonesa niinyesiibyakwo,</para>
  <para style="q1" vid="PSA 35:13">Naashaba ncurikire omutwe omu kifuba kyangye,<verse eid="PSA 35:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:6">Zab 38:6</ref>. </char>
    </note> Nk'orikusaasibwa munywani we nari mwene ishe;</para>
  <para style="q1" vid="PSA 35:14">Naagyendagyenda nk'orikucurira nyina,</para>
  <para style="q1" vid="PSA 35:14">Nyinami n'amaganya maingi.<verse eid="PSA 35:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15" />Kwonka nyowe, ku naagwire, baayesiima,</para>
  <para style="q1" vid="PSA 35:15">Baayeteerana kundwanisa;</para>
  <para style="q1" vid="PSA 35:15">N'abataine ku bari, abu naabaire ntarikumanya,</para>
  <para style="q1" vid="PSA 35:15">Baaguma nibannyaanyaata;<verse eid="PSA 35:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:12">Zab 37:12</ref>. </char>
    </note> Baagumizamu nibanteerera enaku,</para>
  <para style="q1" vid="PSA 35:16">Nibannenera amaino baine ekiniga,</para>
  <para style="q1" vid="PSA 35:16">Nk'abatatiina Ruhanga oku bagira.<verse eid="PSA 35:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:20">Zab 22:20</ref>; <ref loc="HAB 1:13">Hab 1:13</ref>. </char>
    </note> Ai MUKAMA, oryahitsya hi okufa okundeeba?</para>
  <para style="q1" vid="PSA 35:17">Onjune batampwerekyereza,</para>
  <para style="q1" vid="PSA 35:17">Okize amagara gangye entare.<verse eid="PSA 35:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:22">Zab 22:22</ref>, <ref loc="PSA 22:25">25</ref>. </char>
    </note> Naanye ndyakusiimira omu mutwe muhango gw'abantu,</para>
  <para style="q1" vid="PSA 35:18">Nkuhimbisize omu bantu baingi.<verse eid="PSA 35:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:4">Zab 69:4</ref>; <ref loc="JHN 15:25">Yoh 15:25</ref>. </char>
    </note> Otaikiriza abazigu bangye abarikuunyangira ebitahikire kuunyehimbisizaho;</para>
  <para style="q1" vid="PSA 35:19">N'abanyanigira busha barekye kuunyitiranira amaisho.<verse eid="PSA 35:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20" />Ahakuba tibagamba by'obusingye,</para>
  <para style="q1" vid="PSA 35:20">Kureka bateekateeka enaama z'ebishuba kurwanisa abatuurize omu nsi.<verse eid="PSA 35:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:13">Zab 22:13</ref>; <ref loc="PSA 70:3">70:3</ref>; <ref loc="EXO 3:7">Kur 3:7</ref>. </char>
    </note> Baanyashamiire munonga, nibagira bati:</para>
  <para style="q1" vid="PSA 35:21">Otyo! Otyo! Mbwenu twakyereebera!<verse eid="PSA 35:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:1">Zab 10:1</ref>; <ref loc="PSA 28:1">28:1</ref>; <ref loc="EXO 3:7">Kur 3:7</ref>. </char>
    </note> Ai MUKAMA, waakireeba; otahunama!</para>
  <para style="q1" vid="PSA 35:22">Ai MUKAMA, otamba hare!<verse eid="PSA 35:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Zab 7:6</ref>; <ref loc="PSA 44:23">44:23</ref>. </char>
    </note> Ruhanga wangye, kandi MUKAMA wangye,</para>
  <para style="q1" vid="PSA 35:23">Sisiimuka, oimukye oncwere orubanja omu buryo.<verse eid="PSA 35:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:8">Zab 7:8</ref>; <ref loc="PSA 35:19">35:19</ref>. </char>
    </note> Oncwere orubanja, ai MUKAMA Ruhanga wangye,</para>
  <para style="q1" vid="PSA 35:24">Nk'okuhikiirira kwawe oku kuri;</para>
  <para style="q1" vid="PSA 35:24">Otabareka kuunyehimbisizaho.<verse eid="PSA 35:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:25: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 17:16">2 Sam 17:16</ref>; <ref loc="LAM 2:16">Tonz 2:16</ref>. </char>
    </note> Barekye kugira omu mitima yaabo bati: Otyo! Ekyo nikyo twabaire nitwenda.</para>
  <para style="q1" vid="PSA 35:25">Barekye kugira bati: Mbwenu ho, twamumirira kimwe.<verse eid="PSA 35:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4">Zab 35:4</ref>; <ref loc="JOB 8:22">Yob 8:22</ref>; <ref loc="JOB 19:5">19:5</ref>. </char>
    </note> K'abarikwesiimira enaku zangye bakwatwe enshoni, boona bashoberwe;</para>
  <para style="q1" vid="PSA 35:26">Abarikuunyehimbisizaho bajwekwe enshoni n'okugaywa!<verse eid="PSA 35:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:16">Zab 40:16</ref>; <ref loc="PSA 70:4">70:4</ref>. </char>
    </note> Abarikuunyendeza okusinga omu mazima</para>
  <para style="q1" vid="PSA 35:27">Bateere akaari k'okushemererwa, beesiime!</para>
  <para style="q1" vid="PSA 35:27">Eego, bagume bagire bati: MUKAMA orikwesiimira omwiru we kuba gye,</para>
  <para style="q1" vid="PSA 35:27">Aheebwe ekitiinisa.<verse eid="PSA 35:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:14">Zab 51:14</ref>; <ref loc="PSA 71:24">71:24</ref>. </char>
    </note> Kandi orurimi rwangye ruryagamba aha by'okuhikiirira kwawe,</para>
  <para style="q1" vid="PSA 35:28">N'aha kuhimbisibwa kwawe eizooba ryona.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="d">Obubi bw'ababi n'embabazi za Mukama Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi omwiru wa MUKAMA</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 36:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:18">Rom 3:18</ref>. </char>
    </note> Ekibi kigamba n'omusiisi omu mutima gwe hare,</para>
  <para style="q1" vid="PSA 36:1">Kandi okutiina Ruhanga tikuba mu maisho ge;<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 29:19">Bir 29:19</ref>. </char>
    </note> Ahakuba omu kwebeiha kwe agira ngu,</para>
  <para style="q1" vid="PSA 36:2">Eby'okutahikiirira bye tibirireebwa, bikangwa.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>. </char>
    </note> Ebigambo ebi agamba birimu eitima n'obugobya,</para>
  <para style="q1" vid="PSA 36:3">Takikoresa bwengye, kandi takikora gye.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:4: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 65:2">Isa 65:2</ref>; <ref loc="MIC 2:1">Mik 2:1</ref>. </char>
    </note> Ateekateeka enaama z'okukora kubi, ari aha kitabo kye;</para>
  <para style="q1" vid="PSA 36:4">Ayeta omu muhanda ogutari murungi, tayangira kimwe kibi.<verse eid="PSA 36:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:10">Zab 57:10</ref>; <ref loc="PSA 89:2">89:2</ref>. </char>
    </note> Embabazi zaawe, ai MUKAMA, ni nyingi, zihika omu iguru,</para>
  <para style="q1" vid="PSA 36:5">N'okwesigwa kwawe kuhika omu bicu.<verse eid="PSA 36:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:19">Zab 71:19</ref>; <ref loc="PSA 92:2">92:2</ref>; <ref loc="PSA 104:14">104:14</ref>, <ref loc="PSA 104:15">15</ref>; <ref loc="ROM 11:33">Rom 11:33</ref>; <ref loc="JOB 11:8">Yob 11:8</ref>. </char>
    </note> Okuhikiirira kwawe ni nk'enshozi za Ruhanga,</para>
  <para style="q1" vid="PSA 36:6">Emicwere yaawe eri hare nk'okuzimu.</para>
  <para style="q1" vid="PSA 36:6">Ai MUKAMA, niiwe orinda abantu n'enyamaishwa.<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:8">Zab 17:8</ref>; <ref loc="PSA 31:19">31:19</ref>. </char>
    </note> Ai Ruhanga, embabazi zaawe ka n'ez'obuguzi bwingi!</para>
  <para style="q1" vid="PSA 36:7">N'ahabw'ekyo abantu bahungira omu mapapa gaawe.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:11">Zab 16:11</ref>; <ref loc="PSA 46:4">46:4</ref>; <ref loc="PSA 65:4">65:4</ref>; <ref loc="ISA 25:6">Isa 25:6</ref>; <ref loc="REV 22:1">Kush 22:1</ref>. </char>
    </note> Baryaigutira kimwe ebishaagaine eby'omu nju yaawe;</para>
  <para style="q1" vid="PSA 36:8">Kandi oryabanywaisa aha mugyera gw'eby'okushemererwa byawe.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:13">Yer 2:13</ref>; <ref loc="JHN 1:9">Yoh 1:9</ref>; <ref loc="JHN 4:10">4:10</ref>, <ref loc="JHN 4:14">14</ref>; <ref loc="ACT 26:8">Byak 26:8</ref>; <ref loc="1PE 2:9">1 Pet 2:9</ref>; <ref loc="REV 21:6">Kush 21:6</ref>. </char>
    </note> Ahakuba ah'ori niho enshuro y'amagara eri;</para>
  <para style="q1" vid="PSA 36:9">Omu mushana gwawe nimwo turireebera omushana.<verse eid="PSA 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:10: </char>
      <char style="xt" closed="false">
        <ref loc="JER 22:16">Yer 22:16</ref>. </char>
    </note> Guma ogirire abarikukukunda embabazi nyingi;</para>
  <para style="q1" vid="PSA 36:10">Kandi oyorekye abaine emitima egororokire okuhikiirira kwawe.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />Otaikiriza ekigyere ky'ab'amaryo kumpikaho,</para>
  <para style="q1" vid="PSA 36:11">N'obu gwakuba omukono gw'omubi kumbinga.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">36:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:5">Zab 1:5</ref>. </char>
    </note> Okwo niyo abakozi b'ebibi bagwire;</para>
  <para style="q1" vid="PSA 36:12">Batwirwe ahansi, kandi tibaribaasa kwimuka.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="d">Oku Mukama arinda abantu be, n'oku ababi baricwekyerezibwa Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:1">Enf 24:1</ref>, <ref loc="PRO 24:19">19</ref>. </char>
    </note> Otaryemereza omutima ahabw'ababi,</para>
  <para style="q1" vid="PSA 37:1">N'obu kwakuba okugirira enkozi z'ebibi eihari.<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:5">Zab 90:5</ref>, <ref loc="PSA 90:6">6</ref>; <ref loc="PSA 129:6">129:6</ref>. </char>
    </note> Ahakuba baryarahuka kutemwa nk'obunyaatsi,</para>
  <para style="q1" vid="PSA 37:2">Bahotokye nk'amababi.<verse eid="PSA 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 62:8">Zab 62:8</ref>; <ref loc="ISA 26:4">Isa 26:4</ref>. </char>
    </note> Oyesigye MUKAMA, okore ebirungi,</para>
  <para style="q1" vid="PSA 37:3">Obwo nibwo orituura omu nsi, nooriira omu mariisizo n'obusingye.<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 22:26">Yob 22:26</ref>; <ref loc="ISA 58:14">Isa 58:14</ref>. </char>
    </note> Kandi oshemerererwe omuri MUKAMA,</para>
  <para style="q1" vid="PSA 37:4">Nawe aryakuha ebi omutima gwawe gurikwetenga.<verse eid="PSA 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:8">Zab 22:8</ref>; <ref loc="1PE 5:7">1 Pet 5:7</ref>. </char>
    </note> Orugyendo rwawe orwegyekyerere MUKAMA;</para>
  <para style="q1" vid="PSA 37:5">Kandi omwesigye; nawe aryaruhikiiriza.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 58:8">Isa 58:8</ref>, <ref loc="ISA 58:10">10</ref>. </char>
    </note> Aryayoreka okuhikiirira kwawe nk'omushana,</para>
  <para style="q1" vid="PSA 37:6">N'amazima gaawe nk'eihangwe.<verse eid="PSA 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 62:1">Zab 62:1</ref>; <ref loc="PSA 73:3">73:3</ref>; <ref loc="ISA 30:15">Isa 30:15</ref>; <ref loc="JER 12:1">Yer 12:1</ref>. </char>
    </note> Huumurira omuri MUKAMA, omutegyereze n'okugumisiriza;</para>
  <para style="q1" vid="PSA 37:7">Oteemereza omutima ahabw'omuntu orikuhiirwa omu muhanda gwe,</para>
  <para style="q1" vid="PSA 37:7">Akahikiiriza enaama ze embi.<verse eid="PSA 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:8: </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:26">Efe 4:26</ref>; <ref loc="JAS 1:19">Yak 1:19</ref>. </char>
    </note> Reka kuguubwa kubi, ruga omu kiniga;</para>
  <para style="q1" vid="PSA 37:8">Oteemereza omutima; ahakuba ekirugamu n'okukora ekibi.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:21">Enf 2:21</ref>; <ref loc="ISA 57:13">Isa 57:13</ref>; <ref loc="ISA 60:21">60:21</ref>. </char>
    </note> Mumanye ngu ababi baryacwekyerezibwa;</para>
  <para style="q1" vid="PSA 37:9">Kwonka abategyereza MUKAMA baryahungura ensi.<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 24:24">Yob 24:24</ref>. </char>
    </note> Bwanyima y'akaanya kakye omubi aryaba atakiriho;</para>
  <para style="q1" vid="PSA 37:10">Buzima oryamusherura aha mwanya gwe, oshangye atariho.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 32:17">Isa 32:17</ref>; <ref loc="MAT 5:5">Mat 5:5</ref>. </char>
    </note> Kwonka abacureezi baryahungura ensi,</para>
  <para style="q1" vid="PSA 37:11">Beesiime ahabw'okugira obusingye bwingi.<verse eid="PSA 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:13">Zab 31:13</ref>. </char>
    </note> Omubi agiira ohikiriire omu naama mbi,</para>
  <para style="q1" vid="PSA 37:12">Kandi amunenera amaino.<verse eid="PSA 37:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:4">Zab 2:4</ref>. </char>
    </note> Kwonka Mukama ashekyerera omubi,</para>
  <para style="q1" vid="PSA 37:13">Ahakuba areeba eizooba rye riri haihi.<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Ababi baasyoireyo zaarurara zaabo, batamikire emyambi omu mata gaabo,</para>
  <para style="q1" vid="PSA 37:14">Kuteera ahansi enshoberwa n'abakyene,</para>
  <para style="q1" vid="PSA 37:14">N'okwita abagyenda baine emitima egororokire.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:15: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:4">1 Sam 2:4</ref>. </char>
    </note> Zaarurara zaabo nibo zirirezya emitima,</para>
  <para style="q1" vid="PSA 37:15">Kandi amata gaabo garyahendwa.<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:16: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 15:16">Enf 15:16</ref>; <ref loc="PRO 16:8">16:8</ref>; <ref loc="1TI 6:6">1 Tim 6:6</ref>. </char>
    </note> Ebikye ebi ohikiriire aine</para>
  <para style="q1" vid="PSA 37:16">Bikira ebishaagire eby'ababi baingi;<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:15">Zab 10:15</ref>. </char>
    </note> Ahakuba emikono y'ababi eryahendeka,</para>
  <para style="q1" vid="PSA 37:17">Kwonka MUKAMA akwatirira abahikiriire.<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:6">Zab 1:6</ref>; <ref loc="PSA 37:9">37:9</ref>. </char>
    </note> MUKAMA amanya ebiro ebi abashugaine barimara,</para>
  <para style="q1" vid="PSA 37:18">N'obuhunguzi bwabo buryagumaho ebiro byona;<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:19">Zab 33:19</ref>; <ref loc="JOB 5:20">Yob 5:20</ref>. </char>
    </note> Omu biro by'okureeba enaku tibariitwa nshoni,</para>
  <para style="q1" vid="PSA 37:19">Kandi omu biro by'enjara baryaiguta.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:2">Zab 68:2</ref>; <ref loc="HOS 13:3">Hos 13:3</ref>. </char>
    </note> Kwonka ababi baryahwerekyerera,</para>
  <para style="q1" vid="PSA 37:20">Abazigu ba MUKAMA baryaba nk'obunyaatsi burungi obw'omu iriisizo;</para>
  <para style="q1" vid="PSA 37:20">Baryahwerekyerera, bahweho nk'omwika.<verse eid="PSA 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Omubi ayeguza, taihura;</para>
  <para style="q1" vid="PSA 37:21">Kwonka ohikiriire aba efura, kandi agaba.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:9">Zab 37:9</ref>. </char>
    </note> Ahakuba abu MUKAMA aha omugisha baryahungura ensi,</para>
  <para style="q1" vid="PSA 37:22">Kwonka abu akyeenire baracwekyerera.<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:2">Zab 40:2</ref>; <ref loc="1SA 2:9">1 Sam 2:9</ref>. </char>
    </note> Orugyendo rw'omuntu ku ruhamibwa MUKAMA,</para>
  <para style="q1" vid="PSA 37:23">Yaasiima emihanda ye,<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:24: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 24:16">Enf 24:16</ref>; <ref loc="MIC 7:8">Mik 7:8</ref>; <ref loc="2CO 4:9">2 Kor 4:9</ref>. </char>
    </note>N'obu agwa, tagwera kimwe,</para>
  <para style="q1" vid="PSA 37:24">Ahakuba MUKAMA amuramira n'omukono gwe.<verse eid="PSA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Nkaba ndi omutisgazi, mbwenu ndi omurugurusi;</para>
  <para style="q1" vid="PSA 37:25">Kwonka tinkareebaga ohikiriire atsigirweho,</para>
  <para style="q1" vid="PSA 37:25">N'obu baakuba abaana be nibashaba ak'okurya.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:5">Zab 112:5</ref>, <ref loc="PSA 112:9">9</ref>; <ref loc="DEU 15:8">Bir 15:8</ref>, <ref loc="DEU 15:10">10</ref>; <ref loc="MAT 5:42">Mat 5:42</ref>; <ref loc="LUK 6:34">Luk 6:34</ref>, <ref loc="LUK 6:35">35</ref>. </char>
    </note> Obutoosha agaba n'obufura, kandi aguza abandi,</para>
  <para style="q1" vid="PSA 37:26">N'abaana be baryaheebwa omugisha.<verse eid="PSA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:14">Zab 34:14</ref>; <ref loc="PSA 102:28">102:28</ref>. </char>
    </note> Ruga omu bibi, okore ebirungi,</para>
  <para style="q1" vid="PSA 37:27">Naiwe obwo oryagumaho ebiro byona;<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 21:10">21:10</ref>; <ref loc="ISA 14:20">Isa 14:20</ref>. </char>
    </note> Ahakuba MUKAMA akunda eby'oburyo,</para>
  <para style="q1" vid="PSA 37:28">Taritsigaho barikwera be.</para>
  <para style="q1" vid="PSA 37:28">Baryarindwa ebiro byona;</para>
  <para style="q1" vid="PSA 37:28">Kwonka oruzaaro rw'ababi ruryacwekyerezibwa.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Abahikiriire baryahungura ensi,</para>
  <para style="q1" vid="PSA 37:29">Bagituuremu ebiro byona.<verse eid="PSA 37:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Akanwa k'ohikiriire kagamba eby'obwengye,</para>
  <para style="q1" vid="PSA 37:30">N'orurimi rwe rugamba eby'oburyo;<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:8">Zab 40:8</ref>; <ref loc="PSA 119:11">119:11</ref>; <ref loc="ISA 51:7">Isa 51:7</ref>; <ref loc="JER 31:33">Yer 31:33</ref>. </char>
    </note> Ebiragiro bya Ruhanga biba omu mutima gwe;</para>
  <para style="q1" vid="PSA 37:31">Ebigyere bye tibiterera.<verse eid="PSA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Omubi agyenza ohikiriire,</para>
  <para style="q1" vid="PSA 37:32">Naasherura oku araamwitwe.<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:33: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:31">Zab 109:31</ref>. </char>
    </note> MUKAMA tarimutsiga mu mikono ye,</para>
  <para style="q1" vid="PSA 37:33">N'obu kwakuba okumusingisa emanja.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:14">Zab 27:14</ref>; <ref loc="PSA 91:8">91:8</ref>. </char>
    </note> Tegyereza MUKAMA, ogume omu muhanda gwe;</para>
  <para style="q1" vid="PSA 37:34">Niwe arikutunguura, okahungura ensi;</para>
  <para style="q1" vid="PSA 37:34">Oryareeba okuhwerekyerera kw'abasiisi.<verse eid="PSA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:35, 36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:8">Zab 52:8</ref>; <ref loc="JOB 5:3">Yob 5:3</ref>; <ref loc="JOB 20:5">20:5</ref>. </char>
    </note> Nkareeba omubi aine obushoboorozi bwingi,</para>
  <para style="q1" vid="PSA 37:35">Agaire nk'omwereezi gwa Lebanooni.<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />Naagaruka, naarabaho; kwonka eky'okutangaaza, akaba atakiriho;</para>
  <para style="q1" vid="PSA 37:36">N'obu ndaabe naamusherwire, tarabonekire.<verse eid="PSA 37:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:37: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:165">Zab 119:165</ref>; <ref loc="ISA 32:17">Isa 32:17</ref>. </char>
    </note> Yetegyereze omuntu oshugaine, kandi oreebe ow'amazima;</para>
  <para style="q1" vid="PSA 37:37">ahakuba omuheru gw'omuntu ogwo n'obusingye;<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:38: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:22">Enf 2:22</ref>. </char>
    </note> Kwonka abasiisi baryahwerekyererezibwa kimwe,</para>
  <para style="q1" vid="PSA 37:38">Kandi omuheru gw'omubi n'okucwekyerezibwa.<verse eid="PSA 37:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:39: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:8">Zab 3:8</ref>; <ref loc="PSA 9:9">9:9</ref>; <ref loc="ISA 12:2">Isa 12:2</ref>. </char>
    </note> Okujunwa kw'abahikiriire kuruga ahari MUKAMA;</para>
  <para style="q1" vid="PSA 37:39">Niwe buhungiro bwabo omu biro by'okureeba enaku.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">37:40: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 5:20">1 Bus 5:20</ref>; <ref loc="ISA 31:5">Isa 31:5</ref>; <ref loc="DAN 3:17">Dan 3:17</ref>; <ref loc="ACT 12:11">Byak 12:11</ref>. </char>
    </note> MUKAMA abahwera, kandi abakiza;</para>
  <para style="q1" vid="PSA 37:40">Abaiha omu mikono y'ababi, kandi abajuna,</para>
  <para style="q1" vid="PSA 37:40">Ahabw'okuba bamuhungiraho.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="d">Okushaba kw'omuntu ori omu busaasi ahabw'ekibi kye, bwanyima akeeteisa Zaaburi ya Daudi ey'okwijutsya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:1">Zab 6:1</ref>. </char>
    </note> Ai MUKAMA, otanteisa onyiniire ekiniga,</para>
  <para style="q1" vid="PSA 38:1">N'obu kwakuba okumpana ongwereirwe kubi munonga;<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:4">Zab 32:4</ref>; <ref loc="JOB 6:4">Yob 6:4</ref>. </char>
    </note> Ahakuba emyambi yaawe empwereiremu,</para>
  <para style="q1" vid="PSA 38:2">N'omukono gwawe gumpingamiire munonga.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:10">Zab 31:10</ref>; <ref loc="ISA 1:6">Isa 1:6</ref>. </char>
    </note> Tihariho hahuriire omu mubiri gwangye ahabw'ekiniga kyawe;</para>
  <para style="q1" vid="PSA 38:3">N'amagufa gangye tigari gye ahabw'ekibi kyangye.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:4: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 9:6">Ezr 9:6</ref>. </char>
    </note> Ahakuba eby'okushiisha byangye bindengyeire aha mutwe,</para>
  <para style="q1" vid="PSA 38:4">Bindemire nk'omutwaro guremeire.<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Obuhuta bwangye nibunuuka, bujunzire,</para>
  <para style="q1" vid="PSA 38:5">ahabw'obushema bwangye.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:14">Zab 35:14</ref>; <ref loc="ISA 21:3">Isa 21:3</ref>. </char>
    </note> Mpetami omugongo, nyeinamiriire;</para>
  <para style="q1" vid="PSA 38:6">Ngyendagyenda nincura okurenzya eizooba;<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:3">Zab 38:3</ref>. </char>
    </note> Ahakuba nimbabiirirwa munonga omu manyaanya;</para>
  <para style="q1" vid="PSA 38:7">Kandi omu mubiri gwangye tiharimu hahuriire.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Ninkabaakaba mpendagurikire;</para>
  <para style="q1" vid="PSA 38:8">Nintsinda ahabw'omutima gwangye kutatuuza.<verse eid="PSA 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Ai MUKAMA, noomanya ebi nyetenga byona,</para>
  <para style="q1" vid="PSA 38:9">Kandi tosherekirwe kutsinda kwangye.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:7">Zab 6:7</ref>. </char>
    </note> Omutima gwangye niguteera munonga enkuratima, amaani gampweiremu;</para>
  <para style="q1" vid="PSA 38:10">amaisho gangye nago tigakihweza.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:18">Zab 88:18</ref>; <ref loc="MRK 15:40">Mak 15:40</ref>; <ref loc="LUK 10:31">Luk 10:31</ref>, <ref loc="LUK 10:32">32</ref>. </char>
    </note> Banywani bangye na bagyenzi bangye nibanyetantara ahabw'okubonabona kwangye,</para>
  <para style="q1" vid="PSA 38:11">N'abanyaruganda baanyemereire hare.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:20">Zab 35:20</ref>; <ref loc="MRK 12:13">Mak 12:13</ref>; <ref loc="2SA 16:7">2 Sam 16:7</ref>, <ref loc="2SA 16:8">8</ref>; <ref loc="2SA 17:1-3">17:1-3</ref>. </char>
    </note> Kandi abarikwenda kuunyita nibantega emitego;</para>
  <para style="q1" vid="PSA 38:12">N'abarikwenda kunkora kubi nibagamba eby'okumpwerekyereza,</para>
  <para style="q1" vid="PSA 38:12">Kandi bateekateeka eby'okundeebya eizooba ryona.<verse eid="PSA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:2">Zab 39:2</ref>, <ref loc="PSA 39:9">9</ref>; <ref loc="ISA 53:7">Isa 53:7</ref>; <ref loc="1PE 2:23">1 Pet 2:23</ref>. </char>
    </note> Kwonka nyowe ndi nk'ekifa-matu, tindikuhurira;</para>
  <para style="q1" vid="PSA 38:13">Ndi nk'ekiteta ekitarikugamba.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Eego, ndi nk'omuntu otarikuhurira,</para>
  <para style="q1" vid="PSA 38:14">Otaine bigambo by'okuteisa abandi.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:7">Zab 39:7</ref>; <ref loc="2SA 16:12">2 Sam 16:12</ref>. </char>
    </note> Kandi ai MUKAMA, niiwe ndikutegyereza;</para>
  <para style="q1" vid="PSA 38:15">Oryangarukamu, Mukama Ruhanga wangye.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:4">Zab 13:4</ref>. </char>
    </note> N'ahabw'ekyo ninkushaba, otaikiriza abarikwesiimira okuterera kwangye</para>
  <para style="q1" vid="PSA 38:16">Kuunyehimbisizaho.<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:17: </char>
      <char style="xt" closed="false">
        <ref loc="JER 20:10">Yer 20:10</ref>. </char>
    </note> Ndaariire kugwa,</para>
  <para style="q1" vid="PSA 38:17">Kandi obusaasi bwangye tindikubaasa kubwehuzya obutoosha.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:5">Zab 32:5</ref>; <ref loc="2CO 7:9">2 Kor 7:9</ref>, <ref loc="2CO 7:10">10</ref>. </char>
    </note> Ahakuba niinyatura eby'okushiisha byangye,</para>
  <para style="q1" vid="PSA 38:18">Ninshaasha ahabw'ekibi kyangye.<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Kwonka abazigu bangye abanyangira busha baine amaani;</para>
  <para style="q1" vid="PSA 38:19">N'abanyangira ebitahikire bakanyire.<verse eid="PSA 38:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:12">Zab 35:12</ref>; <ref loc="PSA 109:4">109:4</ref>. </char>
    </note> Abazimuurira ekibi ahabw'ekirungi nabo n'abazigu bangye,</para>
  <para style="q1" vid="PSA 38:20">ahakuba ninkuratira ebirungi.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:11">Zab 22:11</ref>. </char>
    </note> Otantsigaho, ai MUKAMA;</para>
  <para style="q1" vid="PSA 38:21">Ruhanga wangye, otanza hare!<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">38:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:13">Zab 40:13</ref>; <ref loc="EXO 15:2">Kur 15:2</ref>; <ref loc="ISA 12:2">Isa 12:2</ref>. </char>
    </note> Rahuka kumpwera, ai Mukama, okujunwa kwangye.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="d">Okumanya amagara gaitu ku gari ag'okuhwaho juba, kandi amatsiko gaitu ku gari omuri Mukama Aha Mukuru w'abeeshongozi Yedusuuni. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:13">Zab 34:13</ref>; <ref loc="1KI 2:4">1 Bag 2:4</ref>; <ref loc="JOB 2:10">Yob 2:10</ref>. </char>
    </note> Nkagira nti: Ndyarinda emitwarize yangye,</para>
  <para style="q1" vid="PSA 39:1">Ndekye kushiisha n'orurimi rwangye;</para>
  <para style="q1" vid="PSA 39:1">Kandi ndyabumba akanwa kangye, omubi akiri omu maisho gangye.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:2: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 40:4">Yob 40:4</ref>, <ref loc="JOB 40:5">5</ref>. </char>
    </note> Naahunama nk'ekiteta,</para>
  <para style="q1" vid="PSA 39:2">Naacureera, kyabura eki kyangasira.</para>
  <para style="q1" vid="PSA 39:2">Okuganya kwangye kwayeyongyera.<verse eid="PSA 39:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 20:9">Yer 20:9</ref>; <ref loc="LUK 24:32">Luk 24:32</ref>. </char>
    </note> Omutima gwangye gwabugumwamu omuriro;</para>
  <para style="q1" vid="PSA 39:3">Ku naateekateekire, gwayaka,</para>
  <para style="q1" vid="PSA 39:3">Ahonaaho naagamba.<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:12">Zab 90:12</ref>. </char>
    </note> MUKAMA, ommanyise omuheru gwangye,</para>
  <para style="q1" vid="PSA 39:4">N'obunaku bw'ebiro byangye oku burikwingana;</para>
  <para style="q1" vid="PSA 39:4">Ommanyise ku ndi ow'okuhwaho juba.<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 62:9">Zab 62:9</ref>; <ref loc="PSA 89:47">89:47</ref>; <ref loc="JOB 14:1">Yob 14:1</ref>, <ref loc="JOB 14:2">2</ref>. </char>
    </note> Reeba, ohindwire ebiro byangye nk'ebita bikye,</para>
  <para style="q1" vid="PSA 39:5">N'emyaka yangye omu maisho gaawe ni busha;</para>
  <para style="q1" vid="PSA 39:5">buzimazima omuntu weena, n'obu yaakuba agumire ata, n'omwitsyo.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:16">Yob 27:16</ref>, <ref loc="JOB 27:17">17</ref>; <ref loc="ECC 2:18">Mub 2:18</ref>, <ref loc="ECC 2:21">21</ref>; <ref loc="LUK 12:20">Luk 12:20</ref>; <ref loc="1CO 7:31">1 Kor 7:31</ref>; <ref loc="JAS 4:14">Yak 4:14</ref>. </char>
    </note> Buzima omuntu weena agyenda ari nk'ekinyimanyimi,</para>
  <para style="q1" vid="PSA 39:6">Buzima bahendekyera busha;</para>
  <para style="q1" vid="PSA 39:6">Omuntu ashanguruza ebintu, atarikumanya oribitwara.<verse eid="PSA 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:15">Zab 38:15</ref>. </char>
    </note> Mbwenu Mukama, ntegyereize ki?</para>
  <para style="q1" vid="PSA 39:7">Amaisho gangye goona gari omuriiwe.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:13">Zab 44:13</ref>. </char>
    </note> Onjune eby'okushiisha byangye byona,</para>
  <para style="q1" vid="PSA 39:8">Otampindura ekirikugaywa abashema.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:13">Zab 38:13</ref>; <ref loc="JOB 2:10">Yob 2:10</ref>; <ref loc="2SA 16:10">2 Sam 16:10</ref>. </char>
    </note> Mpunamire, tinaagira ky'okugamba,</para>
  <para style="q1" vid="PSA 39:9">ahakuba niiwe okikozire.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 9:34">Yob 9:34</ref>; <ref loc="JOB 13:21">13:21</ref>. </char>
    </note> Onyiheho enkoni yaawe;</para>
  <para style="q1" vid="PSA 39:10">Ahakuba empi zaawe zaanyita.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:5">Zab 39:5</ref>; <ref loc="PSA 49:14">49:14</ref>; <ref loc="JOB 13:28">Yob 13:28</ref>. </char>
    </note> Ku ohana omuntu, noomuteisa ahabw'okushiisha kwe,</para>
  <para style="q1" vid="PSA 39:11">Omumariramu kimwe oburungi bwe, nk'oku ebiyenje bigira.</para>
  <para style="q1" vid="PSA 39:11">Buzima kwo, omuntu weena ni nk'omwitsyo!<verse eid="PSA 39:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:12: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 25:23">Lev 25:23</ref>; <ref loc="1CH 29:15">1 Bus 29:15</ref>; <ref loc="PSA 102:1">Zab 102:1</ref>; <ref loc="HEB 11:13">Heb 11:13</ref>. </char>
    </note> Ai MUKAMA, hurira okushaba kwangye,</para>
  <para style="q1" vid="PSA 39:12">Otegye okutu okutaka kwangye,</para>
  <para style="q1" vid="PSA 39:12">Oteetsiza okurira kwangye;</para>
  <para style="q1" vid="PSA 39:12">Ahakuba ahariiwe ndi omugyenyi,</para>
  <para style="q1" vid="PSA 39:12">Kandi omuhinguzi, nka baatatenkuriitwe boona.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">39:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:20">Yob 10:20</ref>, <ref loc="JOB 10:21">21</ref>; <ref loc="JOB 14:10-12">14:10-12</ref>. </char>
    </note> Ongirire embabazi, mbone kugarukwamu amaani,</para>
  <para style="q1" vid="PSA 39:13">Ntakarugire aha kubura.<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="d">Ekyeshongoro kisya ky'okusiima Mukama, n'okushaba okuhwerwa Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:7">Zab 37:7</ref>; <ref loc="PSA 39:12">39:12</ref>. </char>
    </note> Nkategyereza MUKAMA n'okugumisiriza;</para>
  <para style="q1" vid="PSA 40:1">Yantega okutu, yaahurira okutaka kwangye.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:5">Zab 27:5</ref>; <ref loc="PSA 69:2">69:2</ref>, <ref loc="PSA 69:14">14</ref>. </char>
    </note> Yaanyiha omu kiina ky'okuhwerekyereramu omu byondo;</para>
  <para style="q1" vid="PSA 40:2">Yaayemereza ebigyere byangye aha rukiri,</para>
  <para style="q1" vid="PSA 40:2">Yaahamya entegye zangye;<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:3">Zab 33:3</ref>; <ref loc="PSA 52:6">52:6</ref>. </char>
    </note> Yaanyegyesa ekyeshongoro kisya</para>
  <para style="q1" vid="PSA 40:3">eky'okuhimbisa Ruhanga waitu;</para>
  <para style="q1" vid="PSA 40:3">Baingi baryakireeba, batiine,</para>
  <para style="q1" vid="PSA 40:3">Kandi beesigye MUKAMA.<verse eid="PSA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:12">Zab 2:12</ref>; <ref loc="PSA 125:5">125:5</ref>. </char>
    </note> Aine omugisha omuntu, ou MUKAMA aba obwesigye bwe,</para>
  <para style="q1" vid="PSA 40:4">Otakubuukira banyamaryo,</para>
  <para style="q1" vid="PSA 40:4">N'obu baakuba abahabisibwa baaruhanga ab'ebishuba.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:17">Zab 139:17</ref>, <ref loc="PSA 139:18">18</ref>; <ref loc="JOB 5:9">Yob 5:9</ref>. </char>
    </note> Ai MUKAMA Ruhanga wangye, eby'okutangaaza, ebi waakozire,</para>
  <para style="q1" vid="PSA 40:5">N'ebiteekateeko ebi otuteekateekaho ka ni bingi!</para>
  <para style="q1" vid="PSA 40:5">Tihariho orikwingana naiwe.</para>
  <para style="q1" vid="PSA 40:5">Ku naakwenda kubigamba n'okubitondoora,</para>
  <para style="q1" vid="PSA 40:5">Ni bingi, tibirikubaasa kubarwa.<verse eid="PSA 40:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:6-8: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 10:5-7">Heb 10:5-7</ref>. </char>
    </note> Ebitambo n'empongano tobishemerererwa;</para>
  <para style="q1" vid="PSA 40:6">Amatu gangye ogaigwire;</para>
  <para style="q1" vid="PSA 40:6">Ebitambo eby'okwokyeza kimwe n'ebitambo by'ebibi torabyenzire;<note caller="-" style="x"><char style="xo" closed="false">40:6: </char><char style="xt" closed="false"><ref loc="PSA 51:16">Zab 51:16</ref>; <ref loc="1SA 15:22">1 Sam 15:22</ref>; <ref loc="HOS 6:6">Hos 6:6</ref>; <ref loc="MAT 9:13">Mat 9:13</ref>. </char></note><verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:7: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 24:44">Luk 24:44</ref>. </char>
    </note> Naanye nikwo kugira nti: Reeba, naija!</para>
  <para style="q1" vid="PSA 40:7">Nk'oku kyampandiikirweho omu muzingo gw'ekitabo;<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:35">Zab 119:35</ref>; <ref loc="JOB 23:12">Yob 23:12</ref>; <ref loc="JER 15:16">Yer 15:16</ref>; <ref loc="JHN 4:34">Yoh 4:34</ref>; <ref loc="ROM 7:22">Rom 7:22</ref>. </char>
    </note> Ninshemerererwa okukora ebi okunda, ai Ruhanga wangye;</para>
  <para style="q1" vid="PSA 40:8">Ebiragiro byawe biri omu mutima gwangye.<verse eid="PSA 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:22">Zab 22:22</ref>, <ref loc="PSA 22:25">25</ref>; <ref loc="JOS 22:22">Yos 22:22</ref>. </char>
    </note> Mbuuriire eby'okuhikiirira omu mutwe muhango gw'abantu;</para>
  <para style="q1" vid="PSA 40:9">Reeba tindekire kugamba;</para>
  <para style="q1" vid="PSA 40:9">Naiwe nookimanya, ai MUKAMA.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:10: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:20">Byak 20:20</ref>, <ref loc="ACT 20:27">27</ref>; <ref loc="ROM 1:16">Rom 1:16</ref>, <ref loc="ROM 1:17">17</ref>. </char>
    </note> Tinsherekire by'okuhikiirira kwawe omu mutima gwangye;</para>
  <para style="q1" vid="PSA 40:10">Ngambire eby'okwesigwa kwawe n'okujuna kwawe;</para>
  <para style="q1" vid="PSA 40:10">Embabazi zaawe n'amazima gaawe timbisherekire mutwe muhango gw'abantu.<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:3">Zab 57:3</ref>; <ref loc="PSA 61:7">61:7</ref>. </char>
    </note> Ai MUKAMA, otaanyima okusaasira kwawe kwingi;</para>
  <para style="q1" vid="PSA 40:11">Embabazi zaawe n'amazima gaawe bigume bindinde.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:4">Zab 38:4</ref>, <ref loc="PSA 38:10">10</ref>; <ref loc="PSA 116:3">116:3</ref>. </char>
    </note> Ahakuba obubi bwingi obuhinguraine bunyehinguririize;</para>
  <para style="q1" vid="PSA 40:12">Eby'okutahikiirira byangye bimpikireho,</para>
  <para style="q1" vid="PSA 40:12">Byanzibira kwimutsya amaisho;</para>
  <para style="q1" vid="PSA 40:12">Ni bingi okukira eishokye ry'aha mutwe gwangye;</para>
  <para style="q1" vid="PSA 40:12">Omutima gwampwa omunda.<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:13-17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 70:1-5">Zab 70:1-5</ref>. </char>
    </note> Ai MUKAMA, ikiriza kunjuna;</para>
  <para style="q1" vid="PSA 40:13">Orahukye kumpwera, MUKAMA wangye!<note caller="-" style="x"><char style="xo" closed="false">40:13: </char><char style="xt" closed="false"><ref loc="PSA 38:22">Zab 38:22</ref>. </char></note><verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:10">Zab 6:10</ref>; <ref loc="PSA 35:4">35:4</ref>. </char>
    </note> Abarikwenda kuhwerekyereza amagara gangye</para>
  <para style="q1" vid="PSA 40:14">Bakwatwe enshoni, boona bashoberwe;</para>
  <para style="q1" vid="PSA 40:14">Abarikwesiimira enaku zangye, bagarurwe enyima, bagaywe.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:21">Zab 35:21</ref>, <ref loc="PSA 35:25">25</ref>. </char>
    </note> Abarikunteerera enaku, nibagira bati: Otyo! Otyo!</para>
  <para style="q1" vid="PSA 40:15">Bashobererwe kimwe ahabw'enshoni zaabo.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:27">Zab 35:27</ref>. </char>
    </note> Boona abakusherura bashemererwe, bananukire omuriiwe;</para>
  <para style="q1" vid="PSA 40:16">Abarikukunda okujuna kwawe bagume bagire bati:</para>
  <para style="q1" vid="PSA 40:16">MUKAMA aheebwe ekitiinisa!<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">40:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:1">Zab 86:1</ref>; <ref loc="1PE 5:7">1 Pet 5:7</ref>. </char>
    </note> N'obu ndaabe ndi omworo kandi omukyene,</para>
  <para style="q1" vid="PSA 40:17">Kwonka Mukama anteekateekaho.</para>
  <para style="q1" vid="PSA 40:17">Niiwe Muhwezi wangye kandi Omujuni wangye;</para>
  <para style="q1" vid="PSA 40:17">Ai Ruhanga wangye, otatuuraho.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="d">Okushaba kw'omurwaire okujunwa ebi abarikumwanga barikumwetengyera Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:1: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 14:21">Enf 14:21</ref>; <ref loc="MRK 10:21">Mak 10:21</ref>. </char>
    </note> Osaasibwa abooro aine omugisha;</para>
  <para style="q1" vid="PSA 41:1">MUKAMA aryamujuna aha izooba ry'okureeberaho enaku.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:12">Zab 27:12</ref>. </char>
    </note> MUKAMA aryamurinda, agume ari ohuriire;</para>
  <para style="q1" vid="PSA 41:2">Kandi aryaheebwa omugisha akiri omu nsi.</para>
  <para style="q1" vid="PSA 41:2">Otamurekurira abazigu be kumukora nk'oku barikwenda.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />MUKAMA aryamweyegamiza, arembeire aha kitabo kye;</para>
  <para style="q1" vid="PSA 41:3">Niiwe orimwarira arwaire.<verse eid="PSA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:2">Zab 6:2</ref>; <ref loc="PSA 147:3">147:3</ref>. </char>
    </note> Nyowe nkagira nti: Ngirira embabazi, ai MUKAMA!</para>
  <para style="q1" vid="PSA 41:4">Kiza amagara gangye; ahakuba nkucumwireho.<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Abazigu bangye bangambaho kubi nibagira bati:</para>
  <para style="q1" vid="PSA 41:5">Aryafa ryari, eiziina rye rikeeba?<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>; <ref loc="PSA 144:8">144:8</ref>. </char>
    </note> Ku aija kundeeba, ayegambagambisa ebitaine mugasho;</para>
  <para style="q1" vid="PSA 41:6">Haza obwo omutima gwe nigushanguruza orukuru;</para>
  <para style="q1" vid="PSA 41:6">Ngu ku araashohore, arubuzye.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Abarikuunyanga boona bangambuura nibagambirana omu kutu;</para>
  <para style="q1" vid="PSA 41:7">Bangirira enaama mbi.<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />Nibagira bati: Endwara mbi emukwatiire kimwe;</para>
  <para style="q1" vid="PSA 41:8">Ahu abyami tarikwija kwimukaho.<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:12">Zab 55:12</ref>, <ref loc="PSA 55:13">13</ref>; <ref loc="2SA 15:12">2 Sam 15:12</ref>; <ref loc="JER 20:10">Yer 20:10</ref>; <ref loc="OBA 1:7">Oba 7</ref>; <ref loc="MRK 14:18">Mak 14:18</ref>; <ref loc="JHN 13:18">Yoh 13:18</ref>. </char>
    </note> Nangwa na munywani wangye w'aha mara, ou naabaire niinyesiga,</para>
  <para style="q1" vid="PSA 41:9">Ou naabaire ndya nawe ambangiire omugyere.<verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Kwonka iwe ai MUKAMA, ongirire embabazi,</para>
  <para style="q1" vid="PSA 41:10">Onyimutsye, mbone kubahoora.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:11: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 15:25">2 Sam 15:25</ref>, <ref loc="2SA 15:26">26</ref>. </char>
    </note> Ekyo nikyo kirikummanyisa ku onshemerererwa,</para>
  <para style="q1" vid="PSA 41:11">ahakuba omuzigu wangye tansingwire.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:8">Zab 63:8</ref>; <ref loc="JOB 36:7">Yob 36:7</ref>. </char>
    </note> Kwonka nyowe omu bwesigwa bwangye onkwatiriire,</para>
  <para style="q1" vid="PSA 41:12">Wanta omu maisho gaawe, okuguma naiwe ebiro byona.<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">41:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:18">Zab 72:18</ref>; <ref loc="PSA 106:48">106:48</ref>; <ref loc="LUK 1:68">Luk 1:68</ref>. </char>
    </note> MUKAMA Ruhanga w'Abaisraeli ahimbisibwe,</para>
  <para style="q1" vid="PSA 41:13">Okwiha iranaira, okuhitsya obusingye bwona.</para>
  <para style="q2" vid="PSA 41:13">Amiina, kandi Amiina.<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="ms">EKITABO KYA KABIRI</para>
  <para style="s1">Eiriho n'ekyaka by'omuntu orikukunda Ruhanga yaaba ayehweire amatsiko</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Ekyeshongoro kya Beene Koora, ekyagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:1: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:20">Yoel 1:20</ref>. </char>
    </note> Nk'oku empara egira ekyaka neeyenda amaizi,</para>
  <para style="q1" vid="PSA 42:1">N'omutima gwangye nikwo gugira ekyaka ahabwawe, ai Ruhanga.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:1">Zab 63:1</ref>; <ref loc="PSA 84:2">84:2</ref>, <ref loc="PSA 84:7">7</ref>; <ref loc="ISA 55:1">Isa 55:1</ref>; <ref loc="JHN 7:37">Yoh 7:37</ref>; <ref loc="1TH 1:9">1 Tes 1:9</ref>. </char>
    </note> Amagara gangye gagirira Ruhanga eiriho, Ruhanga ohuriire;</para>
  <para style="q1" vid="PSA 42:2">Ndyaija ryari, nkareebwa omu maisho ga Ruhanga?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 62:8">Zab 62:8</ref>; <ref loc="ISA 30:29">Isa 30:29</ref>; <ref loc="2SA 6:15">2 Sam 6:15</ref>; <ref loc="1SA 1:15">1 Sam 1:15</ref>. </char>
    </note> Amarira gangye gambeereire eby'okurya nyomushana na nyekiro,</para>
  <para style="q1" vid="PSA 42:3">Abantu nibanteerera enaku obutoosha,</para>
  <para style="q1" vid="PSA 42:3">Nibagira bati: Ruhanga waawe arahi?<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Ku mba ningamba naamara omu kashansha,</para>
  <para style="q1" vid="PSA 42:4">Nyijuka oku naabaire ngyenda n'abantu baingi,</para>
  <para style="q1" vid="PSA 42:4">Nkabeebembera kuza omu nju ya Ruhanga,</para>
  <para style="q1" vid="PSA 42:4">Nituteera akaari k'okushemererwa n'ebyeshongoro,</para>
  <para style="q1" vid="PSA 42:4">Turi omutwe muhango gw'abantu abarikwijuka ekiro kikuru.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 43:5">Zab 43:5</ref>; <ref loc="PSA 77:3">77:3</ref>; <ref loc="LAM 3:24">Tonz 3:24</ref>; <ref loc="MAT 26:38">Mat 26:38</ref>; <ref loc="JHN 12:27">Yoh 12:27</ref>. </char>
    </note> Ahabw'enki oyehweire amatsiko, iwe magara gangye?</para>
  <para style="q1" vid="PSA 42:5">Ahabw'enki oyemereize omutima omunda yangye?</para>
  <para style="q1" vid="PSA 42:5">Ta amatsiko ahari Ruhanga; ahakuba ndyagaruka mmuhimbise,</para>
  <para style="q1" vid="PSA 42:5">Niwe Muhwezi wangye kandi Ruhanga wangye.<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:9">Bir 3:9</ref>; <ref loc="JON 2:7">Yon 2:7</ref>. </char>
    </note> Ai Ruhanga wangye, amagara gangye geehweire amatsiko;</para>
  <para style="q1" vid="PSA 42:6">Nikyo ndikwijukira, ndi omu nsi ya Yorudani na Herumooni,</para>
  <para style="q1" vid="PSA 42:6">N'aha kabungo ka Mizaari.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:7">Zab 88:7</ref>; <ref loc="JON 2:3">Yon 2:3</ref>. </char>
    </note> Amaizi agaijwire geetana n'agandi,</para>
  <para style="q1" vid="PSA 42:7">ahabw'okuhoorera kw'obururuma bwawe.</para>
  <para style="q1" vid="PSA 42:7">Ebingonzi byawe n'emijumba yaawe byona bindengyeireho.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:6">Zab 77:6</ref>; <ref loc="PSA 133:3">133:3</ref>; <ref loc="PSA 149:5">149:5</ref>; <ref loc="JOB 35:10">Yob 35:10</ref>; <ref loc="DEU 28:8">Bir 28:8</ref>. </char>
    </note> MUKAMA antwekyera embabazi ze nyomushana,</para>
  <para style="q1" vid="PSA 42:8">Na nyekiro ekyeshongoro kye kiba kiri omu kanwa kangye,</para>
  <para style="q1" vid="PSA 42:8">Nikwo kushaba Ruhanga ow'amagara gangye.<verse eid="PSA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">42:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:6">Zab 38:6</ref>; <ref loc="2SA 22:2">2 Sam 22:2</ref>. </char>
    </note> Niinyija kubuuza Ruhanga orukiri rwangye nti:</para>
  <para style="q1" vid="PSA 42:9">Onyebeirwe ki?</para>
  <para style="q1" vid="PSA 42:9">Ahabw'enki ninguma n'amaganya ahabw'okubonabonesibwa abazigu?<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Ababisha bangye ni nka rurara omu magufa gangye,</para>
  <para style="q1" vid="PSA 42:10">Nibanteerera enaku obutoosha,</para>
  <para style="q1" vid="PSA 42:10">Nibagira bati: Ruhanga waawe arahi?<verse eid="PSA 42:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11" />Ahabw'enki oyehweire amatsiko iwe magara gangye?</para>
  <para style="q1" vid="PSA 42:11">Ahabw'enki oyemereize omutima omunda yangye?</para>
  <para style="q1" vid="PSA 42:11">Ta amatsiko ahari Ruhanga; ahakuba ndyagaruka mmuhimbise,</para>
  <para style="q1" vid="PSA 42:11">Niwe Muhwezi wangye kandi Ruhanga wangye.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s1">Okushaba okugaruka kutaaha omuri hekalu ya Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">43:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:6">Zab 5:6</ref>; <ref loc="PSA 7:8">7:8</ref>; <ref loc="1SA 24:15">1 Sam 24:15</ref>. </char>
    </note> Oncwere orubanja, ai Ruhanga, ontonganire aha bantu abatarikukutiina,</para>
  <para style="q1" vid="PSA 43:1">Onkize abantu engobya kandi abatari b'amazima!<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">43:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:4">Zab 31:4</ref>; <ref loc="PSA 42:9">42:9</ref>; <ref loc="PSA 44:9">44:9</ref>. </char>
    </note> Ahakuba niiwe Ruhanga obuhungiro bwangye.</para>
  <para style="q1" vid="PSA 43:2">Mbwenu onaagiire ki?</para>
  <para style="q1" vid="PSA 43:2">Ahanki ninguma n'amaganya ahabw'okubonabonesibwa abazigu?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">43:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:6">Zab 2:6</ref>; <ref loc="PSA 57:3">57:3</ref>; <ref loc="PSA 84:1">84:1</ref>. </char>
    </note> Nyakusinga, yohereza omushana gwawe n'amazima gaawe, binyebembere;</para>
  <para style="q1" vid="PSA 43:3">Bimpitsye aha kibungo kyawe ekirikwera ahu otuura!<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Obwo nibwo ndaaze aha itambiro rya Ruhanga,</para>
  <para style="q1" vid="PSA 43:4">Ahari Ruhanga okushemererwa kwangye okwingi munonga;</para>
  <para style="q1" vid="PSA 43:4">Kandi ndyakuhimbisa n'enanga, ai Ruhanga, Ruhanga wangye.<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">43:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:5">Zab 42:5</ref>. </char>
    </note> Ahabw'enki oyehweire amatsiko, iwe magara gangye?</para>
  <para style="q1" vid="PSA 43:5">Ahabw'enki oyemereize omutima omunda yangye?</para>
  <para style="q1" vid="PSA 43:5">Ta amatsiko ahari Ruhanga; ahakuba ndyagaruka mmuhimbise,</para>
  <para style="q1" vid="PSA 43:5">Niwe Muhwezi wangye kandi Ruhanga wangye.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="s1">Okwijuka embabazi za Ruhanga eza ira oku kurikugumya omutima gw'omuntu ori omu busaasi</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Ekyeshongoro kya Beene Koora, ekyagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:5">Zab 77:5</ref>; <ref loc="PSA 78:3">78:3</ref>; <ref loc="EXO 10:2">Kur 10:2</ref>; <ref loc="EXO 13:8">13:8</ref>, <ref loc="EXO 13:14">14</ref>. </char>
    </note> Ai Ruhanga, tukeehuririra n'amatu gaitu,</para>
  <para style="q1" vid="PSA 44:1">Baatatenkuriitwe baatugambira,</para>
  <para style="q1" vid="PSA 44:1">Ebi waakozire omu bunaku bwabo omu biro ebya ira;<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:8">Zab 80:8</ref>; <ref loc="EXO 15:17">Kur 15:17</ref>; <ref loc="JOS 3:10">Yos 3:10</ref>. </char>
    </note> Amahanga okagabingamu n'omukono gwawe,</para>
  <para style="q1" vid="PSA 44:2">Kwonka bo waabareeta, baatuuramu;</para>
  <para style="q1" vid="PSA 44:2">Okabonabonesa abanyamahanga,</para>
  <para style="q1" vid="PSA 44:2">Kwonka bo waababuzya omu nsi.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 10:15">Bir 10:15</ref>; <ref loc="JOS 24:12">Yos 24:12</ref>; <ref loc="HOS 1:7">Hos 1:7</ref>. </char>
    </note> Ahakuba rurara yaabo tiyo yaabakubwize ensi,</para>
  <para style="q1" vid="PSA 44:3">Kandi n'omukono gwabo tigwo gwabajunire;</para>
  <para style="q1" vid="PSA 44:3">Kureka omukono gwawe gwa buryo n'amaani gaawe,</para>
  <para style="q1" vid="PSA 44:3">N'omushana gw'amaisho gaawe;</para>
  <para style="q1" vid="PSA 44:3">Ahakuba okabeekundira.<verse eid="PSA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:12">Zab 74:12</ref>. </char>
    </note> Ruhanga wangye, niiwe MUKAMA wangye;</para>
  <para style="q1" vid="PSA 44:4">Ragiira Yakobo asingure.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:12">Zab 60:12</ref>; <ref loc="DAN 8:4">Dan 8:4</ref>. </char>
    </note> Niiwe oritubaasisa kuteera ahansi abazigu baitu,</para>
  <para style="q1" vid="PSA 44:5">N'eiziina ryawe niryo rirituha amaani g'okuribatiirira abarikuturwanisa.<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:16">Zab 33:16</ref>; <ref loc="1SA 17:47">1 Sam 17:47</ref>. </char>
    </note> Ahakuba tindyesiga buta bwangye,</para>
  <para style="q1" vid="PSA 44:6">Kandi na rurara yangye tiyo erinjuna.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Kureka niiwe waatujunire ababisha baitu,</para>
  <para style="q1" vid="PSA 44:7">Okakwatsa enshoni abarikutwanga.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:1">Zab 60:1</ref>, <ref loc="PSA 60:10">10</ref>; <ref loc="PSA 74:1">74:1</ref>; <ref loc="PSA 108:11">108:11</ref>; <ref loc="2SA 5:24">2 Sam 5:24</ref>. </char>
    </note> Tutuura nitwehimbisiza omuri Ruhanga;</para>
  <para style="q1" vid="PSA 44:8">Kandi turyasiima eiziina ryawe ebiro byona.<verse eid="PSA 44:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:12">Zab 74:12</ref>. </char>
    </note> Kwonka mbwenu otunagire, waatuhemura,</para>
  <para style="q1" vid="PSA 44:9">Tokihurura na ngabo zaitu.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:10: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:17">Lev 26:17</ref>; <ref loc="JOS 7:8">Yos 7:8</ref>, <ref loc="JOS 7:12">12</ref>. </char>
    </note> Otureeteire okubingwa abazigu,</para>
  <para style="q1" vid="PSA 44:10">N'abarikutwanga batwenyagiire.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:11: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:27">Bir 4:27</ref>; <ref loc="DEU 28:64">28:64</ref>; <ref loc="2KI 17:6">2 Bag 17:6</ref>; <ref loc="PSA 106:27">Zab 106:27</ref>; <ref loc="EZK 20:23">Ezk 20:23</ref>; <ref loc="LUK 21:24">Luk 21:24</ref>. </char>
    </note> Otuhaireyo nk'entaama z'okubaagwa,</para>
  <para style="q1" vid="PSA 44:11">Waatutaataanisiza omu mahanga.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:12: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:14">Bar 2:14</ref>; <ref loc="JDG 3:8">3:8</ref>; <ref loc="ISA 52:3">Isa 52:3</ref>. </char>
    </note> Abantu baawe obatunziremu busha,</para>
  <para style="q1" vid="PSA 44:12">Obuguzi bwabo tibwine ki bukwongyeireho.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:4">Zab 79:4</ref>; <ref loc="PSA 80:6">80:6</ref>. </char>
    </note> Otuhindwire ekijumo ahari bataahi baitu,</para>
  <para style="q1" vid="PSA 44:13">Ekirikugaywa kandi eky'okugaaniiza aha batwehinguririize.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:14: </char>
      <char style="xt" closed="false">
        <ref loc="JER 24:9">Yer 24:9</ref>. </char>
    </note> Otugizire eky'okucweraho enfumu omu mahanga,</para>
  <para style="q1" vid="PSA 44:14">Abu abantu bazongoreza emitwe.<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Nsiiba n'ekihemu eizooba ryona,</para>
  <para style="q1" vid="PSA 44:15">N'enshoni zinshwekire ahamaisho,<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:2">Zab 8:2</ref>. </char>
    </note> Ahabw'ebigambo by'orikungaaniiza nanjuma,</para>
  <para style="q1" vid="PSA 44:16">N'ahabw'omuzigu n'orikumpoora.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:17: </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:13">Dan 9:13</ref>. </char>
    </note> Ebyo byona n'obu biraabe byatuhikireho,</para>
  <para style="q1" vid="PSA 44:17">Kwonka titurakwebirwe,</para>
  <para style="q1" vid="PSA 44:17">N'obu kwakuba okwita endagaano yaawe.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:157">Zab 119:157</ref>. </char>
    </note> Emitima yaitu teragarukire nyima,</para>
  <para style="q1" vid="PSA 44:18">N'ebigyere byaitu bitirateishukire muhanda gwawe,<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />Ebyakukureeteire okutuhendagurira omu maaya g'emishega,</para>
  <para style="q1" vid="PSA 44:19">N'okutushweka ekibunda ky'okufa.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Kuri twayebirwe eiziina rya Ruhanga waitu,</para>
  <para style="q1" vid="PSA 44:20">Nari tukaimukiza baaruhanga abandi emikono yaitu,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:1">Zab 139:1</ref>; <ref loc="1SA 16:7">1 Sam 16:7</ref>; <ref loc="JHN 2:25">Yoh 2:25</ref>; <ref loc="ROM 2:16">Rom 2:16</ref>; <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> Ekyo Ruhanga takukimanyire?</para>
  <para style="q1" vid="PSA 44:21">Ahakuba amanya ebisherekirwe omu mitima.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:22: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:36">Rom 8:36</ref>. </char>
    </note> Eego, ahabwawe nitwitwa eizooba ryona</para>
  <para style="q1" vid="PSA 44:22">Nituteekateekwaho nk'entaama z'okubaagwa.<verse eid="PSA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Zab 7:6</ref>; <ref loc="PSA 44:9">44:9</ref>. </char>
    </note> Sisiimuka, ai MUKAMA, ogwejegyeeziibwe ki?</para>
  <para style="q1" vid="PSA 44:23">Imuka, otatunagira kimwe!<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:25">Zab 119:25</ref>. </char>
    </note> Ahabw'enki otwehugize,</para>
  <para style="q1" vid="PSA 44:24">Okeebwa okubonabona n'okwitwa kubi kwaitu?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:12">Zab 74:12</ref>. </char>
    </note> Ahakuba amagara gaitu gainami ahansi omu mucuucu,</para>
  <para style="q1" vid="PSA 44:25">N'emibiri yaitu ehikiire kimwe aha itaka.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">44:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:22">Zab 25:22</ref>. </char>
    </note> Imuka otuhwere,</para>
  <para style="q1" vid="PSA 44:26">Otucungure ahabw'embabazi zaawe!<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="s1">Ekyeshongoro ky'obushwere bw'abanyiginya</para>
  <para style="d">Aha Mukuru w'Abeeshongozi. Zaaburi ya Beene Koora omu iraka eririkwetwa Omwangangye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Omutima gwangye gwijwire ebigambo birungi nibisheesheka;</para>
  <para style="q1" vid="PSA 45:1">Ningamba ebigambo ebi naahimbiire omugabe;</para>
  <para style="q1" vid="PSA 45:1">Orurimi rwangye n'ekaraamu y'omuhandiiki orikurahutsya.<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:2: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 4:22">Luk 4:22</ref>. </char>
    </note> Ori murungi noohita abaana b'abantu;</para>
  <para style="q1" vid="PSA 45:2">Oburungi bushukirwe aha minwa yaawe.</para>
  <para style="q1" vid="PSA 45:2">Nikyo Ruhanga akuheereire omugisha ebiro n'ebiro.<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:5">Zab 21:5</ref>; <ref loc="PSA 24:8">24:8</ref>; <ref loc="REV 1:16">Kush 1:16</ref>; <ref loc="REV 19:15">19:15</ref>. </char>
    </note> Hagatira rurara yaawe, Iwe emanzi,</para>
  <para style="q1" vid="PSA 45:3">Ojware ekitiinisa n'obukuru bw'obugabe bwawe.<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:4, 5: </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:2">Kush 6:2</ref>. </char>
    </note> Omu bukuru bwawe otembe embaraasi yaawe,</para>
  <para style="q1" vid="PSA 45:4">Ogyende ori omusinguzi,</para>
  <para style="q1" vid="PSA 45:4">Orwanirire amazima n'obucureezi n'okuhikiirira;</para>
  <para style="q1" vid="PSA 45:4">Omukono gwawe guryarasha, batiine.<verse eid="PSA 45:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5" />Emyambi yaawe eine obwogi</para>
  <para style="q1" vid="PSA 45:5">Omu mitima y'abazigu b'omugabe;</para>
  <para style="q1" vid="PSA 45:5">Amahanga nigagwa omu maisho gaawe.<verse eid="PSA 45:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:6, 7: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:8">Heb 1:8</ref>, <ref loc="HEB 1:9">9</ref>. </char>
    </note> Ekitebe kyawe eky'obukama, ai Ruhanga, n'eky'ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 45:6">Enkoni yaawe n'obukama n'ey'okuhikiirira;<note caller="-" style="x"><char style="xo" closed="false">45:6: </char><char style="xt" closed="false"><ref loc="PSA 93:2">Zab 93:2</ref>. </char></note><verse eid="PSA 45:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 21:6">21:6</ref>; <ref loc="1KI 1:39">1 Bag 1:39</ref>; <ref loc="ISA 61:1">Isa 61:1</ref>; <ref loc="ACT 10:38">Byak 10:38</ref>. </char>
    </note> Okakunda okuhikiirira, waayanga obubi;</para>
  <para style="q1" vid="PSA 45:7">Nikyo Ruhanga, Ruhanga waawe, yaakushukiireho amajuta</para>
  <para style="q1" vid="PSA 45:7">G'okushemererwa okukira bagyenzi baawe.<verse eid="PSA 45:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8" />Ebijwaro byawe byona nibitaamirana omugaju</para>
  <para style="q1" vid="PSA 45:8">Gwa sumuruna, obunyanunga n'omudarasiini;</para>
  <para style="q1" vid="PSA 45:8">Enanga ezirikuteererwa omu bikaari ebihunzire emiino nizikushemeza.<verse eid="PSA 45:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:9: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 2:19">1 Bag 2:19</ref>; <ref loc="1KI 9:28">9:28</ref>. </char>
    </note> Omu baheereza baawe abakazi ab'ekitiinisa harimi bahara b'abagabe;</para>
  <para style="q1" vid="PSA 45:9">Aha rubaju rwawe rwa buryo heemereireho omugabekazi ajwaire ezaabu y'Ofiri.<verse eid="PSA 45:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10" />Iwe mwishiki 'we, hurira, oteekateekye, otegye okutu;</para>
  <para style="q1" vid="PSA 45:10">Oyebwe eihanga ryawe n'enju ya sho.<verse eid="PSA 45:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 54:5">Isa 54:5</ref>. </char>
    </note> Obwo nibwo omugabe arikurigira ahabw'oburungi bwawe;</para>
  <para style="q1" vid="PSA 45:11">Ahakuba niwe Mukama waawe; obe niwe waaramya.<verse eid="PSA 45:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:12 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:29">Zab 22:29</ref>; <ref loc="PSA 72:10">72:10</ref>; <ref loc="JOB 11:19">Yob 11:19</ref>. </char>
    </note> Aba Tuuro baryakwekundisa n'emitoijo,</para>
  <para style="q1" vid="PSA 45:12">N'abarikukira obutungi omu bantu baryakweshengyereza ngu obahakye gye.<verse eid="PSA 45:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:13, 14: </char>
      <char style="xt" closed="false">
        <ref loc="REV 19:7">Kush 19:7</ref>, <ref loc="REV 19:8">8</ref>. </char>
    </note> Muhara w'omugabe omu kishengye kye ajwaire eby'ekitiinisa kingi ebirukirwemu ezaabu.<verse eid="PSA 45:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14" />Baryamutwarira omugabe ajwaire emyenda etariize n'amabara maingi;</para>
  <para style="q1" vid="PSA 45:14">Abaishiki bagyenzi be abamukuratiire baryareetwa ah'ori;<verse eid="PSA 45:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15" />Baryareetwa baine okushemererwa n'okwesiima,</para>
  <para style="q1" vid="PSA 45:15">Bataahe omuri nyaruju y'omugabe.<verse eid="PSA 45:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:16: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:9">1 Pet 2:9</ref>; <ref loc="REV 1:6">Kush 1:6</ref>. </char>
    </note> Omu mwanya gwa baashwenkuru haryagarukamu batabani baawe;</para>
  <para style="q1" vid="PSA 45:16">Oryabahindura abategyeki omu nsi yoona.<verse eid="PSA 45:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">45:17: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 1:11">Mal 1:11</ref>. </char>
    </note> Eiziina ryawe ndyariijutsya ab'obusingye bwona;</para>
  <para style="q1" vid="PSA 45:17">N'ahabw'ekyo abantu baryakuhimbisa ebiro n'ebiro.<verse eid="PSA 45:17" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" sid="PSA 46" />
  <para style="s1">Ruhanga oku ari obuhungiro bw'abantu be</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Beene Koora. Ekyeshongoro ekyeshongorwa omu buraka bukye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 46:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:6">Zab 14:6</ref>; <ref loc="DEU 4:7">Bir 4:7</ref>. </char>
    </note> Ruhanga niwe buhungiro bwaitu, kandi amaani gaitu,</para>
  <para style="q1" vid="PSA 46:1">Omuhwezi buzima otabura mu biro by'enaku.<verse eid="PSA 46:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:7">Zab 18:7</ref>. </char>
    </note> N'ahabw'ekyo tituritiina, n'obu ensi yaakuhinduka,</para>
  <para style="q1" vid="PSA 46:2">Enshozi zikatsindukira ahagati y'enyanja,<verse eid="PSA 46:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 93:3">Zab 93:3</ref>, <ref loc="PSA 93:4">4</ref>; <ref loc="JER 5:22">Yer 5:22</ref>. </char>
    </note> Amaizi gaayo gakahoorera, gakahinduriza,</para>
  <para style="q1" vid="PSA 46:3">N'ebibungo bikatengyetsibwa okwehuura kwayo.<verse eid="PSA 46:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:8">Zab 36:8</ref>; <ref loc="PSA 43:3">43:3</ref>; <ref loc="PSA 48:1">48:1</ref>; <ref loc="ISA 33:21">Isa 33:21</ref>; <ref loc="ISA 60:14">60:14</ref>; <ref loc="REV 22:1">Kush 22:1</ref>, <ref loc="REV 22:2">2</ref>. </char>
    </note> Hariho omugyera, okusheneneka kwagwo nikushemeza orurembo rwa Ruhanga,</para>
  <para style="q1" vid="PSA 46:4">Omwanya Ogurikwera ahu Rukira-boona atuura.<verse eid="PSA 46:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:5: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:14">Bir 23:14</ref>; <ref loc="ISA 12:6">Isa 12:6</ref>; <ref loc="EZK 43:7">Ezk 43:7</ref>; <ref loc="ZEC 8:3">Zek 8:3</ref>. </char>
    </note> Ruhanga ari ahagati yaarwo; tiruritengyetsibwa;</para>
  <para style="q1" vid="PSA 46:5">Ruhanga aryaruhwera kare nibutaagurukana.<verse eid="PSA 46:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:1">Zab 2:1</ref>; <ref loc="PSA 18:13">18:13</ref>; <ref loc="JOL 3:16">Yoel 3:16</ref>; <ref loc="AMO 9:5">Amo 9:5</ref>. </char>
    </note> Amahanga gakajagarara, obugabe bwarabanamu,</para>
  <para style="q1" vid="PSA 46:6">Yaagamba n'eiraka rihango, ensi yaayaga.<verse eid="PSA 46:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:3">Zab 48:3</ref>. </char>
    </note> MUKAMA ow'amahe ari hamwe naitwe;</para>
  <para style="q1" vid="PSA 46:7">Ruhanga wa Yakobo niwe buhungiro bwaitu.<verse eid="PSA 46:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:5">Zab 66:5</ref>. </char>
    </note> Mwije mureebe emirimo ya MUKAMA,</para>
  <para style="q1" vid="PSA 46:8">Oku areetsire okuhwerekyerera omu nsi.<verse eid="PSA 46:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 76:3">Zab 76:3</ref>; <ref loc="1SA 2:4">1 Sam 2:4</ref>; <ref loc="ISA 2:4">Isa 2:4</ref>; <ref loc="MIC 4:3">Mik 4:3</ref>. </char>
    </note> Amaraho engamba okuhika aha muheru gw'ensi;</para>
  <para style="q1" vid="PSA 46:9">Ahenda amata, amacumu agatemamu kabiri;</para>
  <para style="q1" vid="PSA 46:9">N'ebigaari abyotsya n'omuriro.<verse eid="PSA 46:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:13">Kur 14:13</ref>; <ref loc="ISA 2:11">Isa 2:11</ref>, <ref loc="ISA 2:17">17</ref>. </char>
    </note> Mucureere, mumanye ku ndi Ruhanga.</para>
  <para style="q1" vid="PSA 46:10">Ndyahimbisibwa omu mahanga,</para>
  <para style="q1" vid="PSA 46:10">Ndyahimbisibwa omu nsi.<verse eid="PSA 46:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">46:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:7">Zab 46:7</ref>. </char>
    </note> MUKAMA ow'amahe hamwe naitwe,</para>
  <para style="q1" vid="PSA 46:11">Ruhanga wa Yakobo niwe buhungiro bwaitu!<verse eid="PSA 46:11" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" sid="PSA 47" />
  <para style="s1">Okwesiima ahabwa Ruhanga okuba Mukama w'ensi yoona</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Ekyeshongoro kya Beene Koora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 47:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 10:24">1 Sam 10:24</ref>; <ref loc="2KI 11:12">2 Bag 11:12</ref>; <ref loc="ISA 55:12">Isa 55:12</ref>. </char>
    </note> Imwe ab'amahanga goona, muteere omu ngaro;</para>
  <para style="q1" vid="PSA 47:1">Mweshongorere Ruhanga n'amaraka mahango g'okusingura;<verse eid="PSA 47:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:21">Bir 7:21</ref>; <ref loc="NEH 1:5">Neh 1:5</ref>; <ref loc="MAL 1:14">Mal 1:14</ref>. </char>
    </note> Ahakuba MUKAMA Rukira-boona naatiinisa,</para>
  <para style="q1" vid="PSA 47:2">N'Omugabe rugambwa orikutegyeka ensi zoona.<verse eid="PSA 47:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:47">Zab 18:47</ref>. </char>
    </note> Akatugomoorera abantu, twabategyeka,</para>
  <para style="q1" vid="PSA 47:3">N'amahanga yaagata ahansi y'ebigyere byaitu.<verse eid="PSA 47:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:4: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 8:7">Amo 8:7</ref>; <ref loc="NAM 2:2">Nah 2:2</ref>; <ref loc="1PE 1:4">1 Pet 1:4</ref>. </char>
    </note> Yaatutooranira obuhunguzi,</para>
  <para style="q1" vid="PSA 47:4">Nikyo kyeraato kya Yakobo ou yaakunzire.<verse eid="PSA 47:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:18">Zab 68:18</ref>; <ref loc="2SA 6:15">2 Sam 6:15</ref>. </char>
    </note> Ruhanga ainamukire n'akaari k'okushemererwa,</para>
  <para style="q1" vid="PSA 47:5">MUKAMA ainamukire n'eiraka ry'enzamba.<verse eid="PSA 47:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6" />Mweshongorere Ruhanga eby'okuhimbisa, mweshongore eby'okuhimbisa!</para>
  <para style="q1" vid="PSA 47:6">Mweshongorere MUKAMA waitu eby'okuhimbisa, mweshongore eby'okuhimbisa;<verse eid="PSA 47:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:7: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 14:9">Zek 14:9</ref>; <ref loc="1CO 14:15">1 Kor 14:15</ref>. </char>
    </note> Ahabw'okuba Ruhanga niwe Mukama w'ensi yoona;</para>
  <para style="q1" vid="PSA 47:7">Mweshongore zaaburi z'okumuhimbisa n'obwengye!<verse eid="PSA 47:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:28">Zab 22:28</ref>; <ref loc="1CH 16:31">1 Bus 16:31</ref>. </char>
    </note> Ruhanga ategyeka amahanga;</para>
  <para style="q1" vid="PSA 47:8">Ruhanga ashutami aha kitebe kye ekirikwera.<verse eid="PSA 47:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">47:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:11">Zab 72:11</ref>; <ref loc="PSA 89:18">89:18</ref>; <ref loc="ISA 49:7">Isa 49:7</ref>, <ref loc="ISA 49:23">23</ref>. </char>
    </note> Abakuru b'amahanga bateeraine nk'abantu ba Ruhanga wa Abrahamu;<verse eid="PSA 47:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 47:10" />Ahakuba engabo z'omu nsi n'eza Ruhanga;</para>
  <para style="q1" vid="PSA 47:10">Naaheebwa ekitiinisa kingi.<verse eid="PSA 47:10" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" sid="PSA 48" />
  <para style="s1">Okusiima Ruhanga ahabw'oburungi bwa Saayuuni n'amaani gaayo</para>
  <para style="d">Ekyeshongoro. Zaaburi ya Beene Koora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 48:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:4">Zab 46:4</ref>; <ref loc="PSA 96:4">96:4</ref>; <ref loc="PSA 145:3">145:3</ref>; <ref loc="ISA 2:2">Isa 2:2</ref>; <ref loc="ZEC 8:3">Zek 8:3</ref>. </char>
    </note> MUKAMA ni mukuru; ashemereire kuhimbisibwa munonga</para>
  <para style="q1" vid="PSA 48:1">Omu rurembo rwa Ruhanga waitu aha kibungo kye ekirikwera.<verse eid="PSA 48:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:2">Zab 50:2</ref>; <ref loc="LAM 2:15">Tonz 2:15</ref>; <ref loc="MAT 5:35">Mat 5:35</ref>. </char>
    </note> Ekibungo Saayuuni ekiri aha bukiizi-bwa-bumosho,</para>
  <para style="q1" vid="PSA 48:2">Ekirungi munonga omu kunyeeta kwakyo, nikyo ensi yoona eshemerererwa,</para>
  <para style="q1" vid="PSA 48:2">kandi nirwo rurembo rw'Omukama rugambwa.<verse eid="PSA 48:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:7">Zab 46:7</ref>. </char>
    </note> Ruhanga akeemanyisa omu bikaari byarwo</para>
  <para style="q1" vid="PSA 48:3">Ku ari orugo rugumire orw'okuhungiramu.<verse eid="PSA 48:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:4-6: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 10:6-19">2 Sam 10:6-19</ref>. </char>
    </note> Reeba, abagabe bakateerana, baizira hamwe;<verse eid="PSA 48:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5" />Ku baarureebire, baatangaara,</para>
  <para style="q1" vid="PSA 48:5">Baakwatwa obwoba, baahunga;<verse eid="PSA 48:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:15">Kur 15:15</ref>; <ref loc="ISA 13:8">Isa 13:8</ref>. </char>
    </note> Orutetema rwabakwatirayo,</para>
  <para style="q1" vid="PSA 48:6">Baarumwa nk'omukazi orikwenda kuzaara.<verse eid="PSA 48:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:7: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:22">1 Bag 10:22</ref>; <ref loc="1KI 22:48">22:48</ref>; <ref loc="EZK 27:26">Ezk 27:26</ref>. </char>
    </note> Waareeta omuyaga ogw'oburugwa-izooba,</para>
  <para style="q1" vid="PSA 48:7">Gwahendagura emeeri za Tarushiishi.<verse eid="PSA 48:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1">Zab 48:1</ref>; <ref loc="PSA 87:5">87:5</ref>. </char>
    </note> Nkoku twahuriire, nikwo twareebire omu rurembo rwa MUKAMA ow'amahe,</para>
  <para style="q1" vid="PSA 48:8">Omu rurembo rwa Ruhanga waitu.</para>
  <para style="q1" vid="PSA 48:8">Ruhanga aryarugumiza kimwe ebiro byona.<verse eid="PSA 48:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9" />Ai Ruhanga, tuteekateekire munonga aha mbabazi zaawe</para>
  <para style="q1" vid="PSA 48:9">Turi omuri hekalu yaawe.<verse eid="PSA 48:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:3">Zab 113:3</ref>; <ref loc="DEU 28:58">Bir 28:58</ref>; <ref loc="MAL 1:11">Mal 1:11</ref>. </char>
    </note> Nk'oku eiziina ryawe riri, ai Ruhanga,</para>
  <para style="q1" vid="PSA 48:10">N'okuhimbisibwa kwawe nikwo kuri, nikuhika aha muheru gw'ensi.</para>
  <para style="q1" vid="PSA 48:10">Omukono gwawe gwa buryo gwijwire okuhikiirira.<verse eid="PSA 48:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:8">Zab 97:8</ref>. </char>
    </note> Ekibungo Saayuuni kishemererwe,</para>
  <para style="q1" vid="PSA 48:11">Abaishiki ba Yuda beesiime ahabw'emicwere yaawe y'oburyo!<verse eid="PSA 48:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12" />Mugyendagyende aha kibungo Saayuuni, mukyehinguririze,</para>
  <para style="q1" vid="PSA 48:12">Mubare eminaara y'orwo rurembo.<verse eid="PSA 48:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:4-6">Zab 78:4-6</ref>; <ref loc="PSA 122:7">122:7</ref>. </char>
    </note> Mwetegyereze orugo rwarwo, oku ruzitiire;</para>
  <para style="q1" vid="PSA 48:13">Mumanye ebikaari byarwo,</para>
  <para style="q1" vid="PSA 48:13">Mureebe oku muribiteekyerereza ab'obusingye oburiija.<verse eid="PSA 48:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">48:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:3">Zab 23:3</ref>, <ref loc="PSA 23:4">4</ref>. </char>
    </note> Ahakuba Ruhanga ogu ni Ruhanga waitu ebiro byona,</para>
  <para style="q1" vid="PSA 48:14">Niwe aritwebembera okuhitsya aha kufa.<verse eid="PSA 48:14" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" sid="PSA 49" />
  <para style="s1">Oku obutungi butarikubaasa kuzibira omuntu kufa</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Beene Koora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 49:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:2">Isa 1:2</ref>; <ref loc="MIC 1:2">Mik 1:2</ref>. </char>
    </note> Muhurire eki, imwe amahanga goona;</para>
  <para style="q1" vid="PSA 49:1">Mutegye amatu, imwe mwena abatuura omu nsi;<verse eid="PSA 49:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2" />Ab'ekitiinisa n'abatakiine,</para>
  <para style="q1" vid="PSA 49:2">Abatungi hamwe n'abooro!<verse eid="PSA 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3" />Akanwa kangye kaaza kugamba eby'obwengye;</para>
  <para style="q1" vid="PSA 49:3">Okuteekateeka kw'omu mutima gwangye kurugwemu okwetegyereza.<verse eid="PSA 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:2">Zab 78:2</ref>. </char>
    </note> Niinyija kutega okutu, mpurire enfumu;</para>
  <para style="q1" vid="PSA 49:4">Nshoboorore ekigambo kyangye ekitarikushobooroka, ninteera enanga.<verse eid="PSA 49:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5" />N'enki ekyakuntiinisa omu biro by'enaku,</para>
  <para style="q1" vid="PSA 49:5">Obubi bw'abarikumpiiga bunyehinguririize?<verse eid="PSA 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:7">Zab 52:7</ref>; <ref loc="PRO 11:28">Enf 11:28</ref>; <ref loc="MRK 10:24">Mak 10:24</ref>. </char>
    </note> Abo abeesiga eitungo ryabo,</para>
  <para style="q1" vid="PSA 49:6">Bakeehimbisa ahabw'obutungi bwabo bwingi,<verse eid="PSA 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:7: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:26">Mat 16:26</ref>. </char>
    </note> Tihariho n'omwe aharibo orikubaasa kucungura mwene ishe,</para>
  <para style="q1" vid="PSA 49:7">N'obu kwakuba okuha Ruhanga eky'okumucungura,<verse eid="PSA 49:7" /></para>
  <para style="q1">
    <verse number="8-9" style="v" sid="PSA 49:8-9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:18">Yob 36:18</ref>, <ref loc="JOB 36:19">19</ref>. </char>
    </note> Ngu abone kugumaho ebiro byona, atafiire akajunda.</para>
  <para style="q1" vid="PSA 49:8-9">Ahakuba okucungura amagara gaabo n'okw'obuguzi bwingi,</para>
  <para style="q1" vid="PSA 49:8-9">Tikushemereire kwehangwa.<note caller="-" style="x"><char style="xo" closed="false">49:9: </char><char style="xt" closed="false"><ref loc="PSA 16:10">Zab 16:10</ref>; <ref loc="PSA 89:48">89:48</ref>. </char></note><verse eid="PSA 49:8-9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:6">Zab 39:6</ref>; <ref loc="ECC 2:16">Mub 2:16</ref>. </char>
    </note> Eego, areeba abanyabwengye nibafa;</para>
  <para style="q1" vid="PSA 49:10">Omushema n'ekituuriizi boona bahwerekyerera,</para>
  <para style="q1" vid="PSA 49:10">Batsigira abandi eitungo ryabo.<verse eid="PSA 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:11: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 4:17">Kut 4:17</ref>. </char>
    </note> Bateekateeka ngu amaka gaabo garyagumaho ebiro byona,</para>
  <para style="q1" vid="PSA 49:11">Kandi ngu obutaaho bwabo buryagumaho okuhitsya obusingye bwona;</para>
  <para style="q1" vid="PSA 49:11">N'ebibanja byabo bigume nibibeetererwa.<verse eid="PSA 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 82:7">Zab 82:7</ref>; <ref loc="ECC 3:19">Mub 3:19</ref>. </char>
    </note> Kwonka omuntu taguma na kitiinisa kye;</para>
  <para style="q1" vid="PSA 49:12">Naashusha nk'enyamaishwa ezifa, zikahwaho.<verse eid="PSA 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13" />Ogwo nigwo muheru gw'abeesiga busha,</para>
  <para style="q1" vid="PSA 49:13">N'abarikwesiima ahabw'omugabo gwabo nikwo bafa.<verse eid="PSA 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 24:19">Yob 24:19</ref>; <ref loc="DAN 7:22">Dan 7:22</ref>; <ref loc="MAL 4:3">Mal 4:3</ref>; <ref loc="1CO 6:2">1 Kor 6:2</ref>; <ref loc="REV 2:26">Kush 2:26</ref>. </char>
    </note> Bafunywa nk'obusyo bw'entaama, nibaza Okuzimu;</para>
  <para style="q1" vid="PSA 49:14">Rufu n'omuriisa waabo kandi omutegyeki waabo.</para>
  <para style="q1" vid="PSA 49:14">Oburungi bwabo buryahwaho;</para>
  <para style="q1" vid="PSA 49:14">Kandi Okuzimu eryaba eka yaabo.<verse eid="PSA 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:10">Zab 16:10</ref>; <ref loc="HOS 13:14">Hos 13:14</ref>. </char>
    </note> Kwonka Ruhanga aryacungura amagara gangye, agaihe omu bushoboorozi bw'okuzimu;</para>
  <para style="q1" vid="PSA 49:15">Ahakuba aryanyakiira.<verse eid="PSA 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16" />Otaritiina ku orireeba omuntu yaatunga,</para>
  <para style="q1" vid="PSA 49:16">Ekitiinisa ky'eka ye kyakanya;<verse eid="PSA 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:17: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:19">Yob 27:19</ref>; <ref loc="1TI 6:7">1 Tim 6:7</ref>. </char>
    </note> Ahabw'okuba ku arifa, tarigira ki yaatwara;</para>
  <para style="q1" vid="PSA 49:17">N'ekitiinisa tikirimukurata Kuzimu.<verse eid="PSA 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">49:18: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 29:19">Bir 29:19</ref>; <ref loc="LUK 12:19">Luk 12:19</ref>. </char>
    </note> N'obu araabe yaayeyetsire ohiiriirwe akiriho,</para>
  <para style="q1" vid="PSA 49:18">Kandi abantu bakamusiima ahabw'okwegirira gye,<verse eid="PSA 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 49:19" />Kwonka aryakurata baishenkuru,</para>
  <para style="q1" vid="PSA 49:19">Abatarigaruka ruguru kureeba omushana obundi.<verse eid="PSA 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20" />Omuntu oine ekitiinisa, atagire bwengye,</para>
  <para style="q1" vid="PSA 49:20">Naashusha nk'enyamaishwa ezifa, zikahwaho.<verse eid="PSA 49:20" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" sid="PSA 50" />
  <para style="s1">Ruhanga oku atarikusiima ediini n'ebitambo kwonka, kureka okumworobera tutarikuryarya</para>
  <para style="d">Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 50:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:3">Zab 113:3</ref>. </char>
    </note> Ruhanga, MUKAMA Ruhanga ow'obushoboorozi agambire,</para>
  <para style="q1" vid="PSA 50:1">Yaayeta ensi, okuruga oburugwa-izooba okuhika oburengyerwa-izooba.<verse eid="PSA 50:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:2">Zab 48:2</ref>; <ref loc="PSA 80:1">80:1</ref>; <ref loc="DEU 33:2">Bir 33:2</ref>. </char>
    </note> Ruhanga ayakire, naayema omuri Saayuuni,</para>
  <para style="q1" vid="PSA 50:2">Ahu oburungi obutaine kamogo buba.<verse eid="PSA 50:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:9">Zab 21:9</ref>; <ref loc="EXO 19:16">Kur 19:16</ref>. </char>
    </note> Ruhanga waitu naija, taryetsiza;</para>
  <para style="q1" vid="PSA 50:3">Omuriro ogurikwokyeza kimwe gumwebembeire,</para>
  <para style="q1" vid="PSA 50:3">Ayehinguririziibwe eihunga ry'amaani;<verse eid="PSA 50:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:1">Bir 32:1</ref>; <ref loc="ISA 1:2">Isa 1:2</ref>; <ref loc="MIC 6:1">Mik 6:1</ref>, <ref loc="MIC 6:2">2</ref>. </char>
    </note> Naayeta eiguru n'ensi,</para>
  <para style="q1" vid="PSA 50:4">Ngu abone kucwera abantu be orubanja.<verse eid="PSA 50:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 15:9-18">Kut 15:9-18</ref>; <ref loc="EXO 24:7">Kur 24:7</ref>, <ref loc="EXO 24:8">8</ref>. </char>
    </note> Naagira ati: Muteerane abarikwera bangye, baije ahariinye,</para>
  <para style="q1" vid="PSA 50:5">Abaaragaine naanye endagaano nibahayo ebitambo.<verse eid="PSA 50:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 75:7">Zab 75:7</ref>; <ref loc="PSA 97:6">97:6</ref>. </char>
    </note> Eiguru rimanyisa okuhikiirira kwe,</para>
  <para style="q1" vid="PSA 50:6">Ahakuba Ruhanga we wenka niwe Mucwi w'emanja.<verse eid="PSA 50:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 81:8">Zab 81:8</ref>; <ref loc="EXO 20:2">Kur 20:2</ref>. </char>
    </note> Muhurire, imwe abantu bangye, ngambe;</para>
  <para style="q1" vid="PSA 50:7">Hurira, Israeli, nkuhamize.</para>
  <para style="q1" vid="PSA 50:7">Niinye Ruhanga, Ruhanga waawe.<verse eid="PSA 50:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:6">Zab 40:6</ref>. </char>
    </note> Tindikukuhana habw'ebitambo byawe;</para>
  <para style="q1" vid="PSA 50:8">Ebitambo byawe ebyokize biri omu maisho gangye obutoosha.<verse eid="PSA 50:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9" />Tindikwija kwakiira nimi y'omu nju yaawe,</para>
  <para style="q1" vid="PSA 50:9">N'obu yaakuba empaya y'embuzi omu busyo bwawe;<verse eid="PSA 50:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10" />Ahakuba enyamaishwa zoona ez'omu kibira n'ezangye,</para>
  <para style="q1" vid="PSA 50:10">N'ente ez'aha bibungo rukumi nazo n'ezangye.<verse eid="PSA 50:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:29">Mat 10:29</ref>. </char>
    </note> Nimmanya enyonyi zoona ez'omu mwanya,</para>
  <para style="q1" vid="PSA 50:11">Kandi enyamaishwa ez'omu ishwa n'ezangye.<verse eid="PSA 50:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:1">Zab 24:1</ref>. </char>
    </note> Kuri naagizire enjara, tinaakukugambiire,</para>
  <para style="q1" vid="PSA 50:12">Ahakuba ensi n'ebigirimu byona n'ebyangye.<verse eid="PSA 50:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13" />Noogira ngu ndya enyama y'enimi,</para>
  <para style="q1" vid="PSA 50:13">Nari nnywa orwamba rw'embuzi?<verse eid="PSA 50:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:14: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 30:2">Kub 30:2</ref>; <ref loc="PSA 22:25">Zab 22:25</ref>; <ref loc="PSA 107:22">107:22</ref>; <ref loc="ECC 5:4">Mub 5:4</ref>; <ref loc="HOS 14:2">Hos 14:2</ref>; <ref loc="JON 2:9">Yon 2:9</ref>; <ref loc="HEB 13:15">Heb 13:15</ref>. </char>
    </note> Ohe Ruhanga ekitambo ky'okusiima,</para>
  <para style="q1" vid="PSA 50:14">Ohikiirize eki waaraganiise Rukira-boona;<verse eid="PSA 50:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:23">Zab 22:23</ref>; <ref loc="PSA 81:7">81:7</ref>; <ref loc="PSA 107:6">107:6</ref>; <ref loc="ZEC 13:9">Zek 13:9</ref>. </char>
    </note> Kandi ontakire aha izooba ry'okureeba enaku,</para>
  <para style="q1" vid="PSA 50:15">Ndyakukiza, naiwe ompimbisise.<verse eid="PSA 50:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16" />Kwonka omubi Ruhanga amugira ati:</para>
  <para style="q1" vid="PSA 50:16">Oine bushoboorozi ki okugambira abandi ebiragiro byangye,</para>
  <para style="q1" vid="PSA 50:16">N'okwegambisa eby'endagaano yangye?<verse eid="PSA 50:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:17: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 9:26">Neh 9:26</ref>; <ref loc="ROM 2:21">Rom 2:21</ref>, <ref loc="ROM 2:22">22</ref>. </char>
    </note> Haza oyanga okuhanwa,</para>
  <para style="q1" vid="PSA 50:17">Kandi ebigambo byangye obyenaga enyima?<verse eid="PSA 50:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:18: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:32">Rom 1:32</ref>; <ref loc="1TI 5:22">1 Tim 5:22</ref>. </char>
    </note> Ku oreeba omushuma, onywana nawe,</para>
  <para style="q1" vid="PSA 50:18">Kandi okwatanisa n'abashambani.<verse eid="PSA 50:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:2">Zab 52:2</ref>. </char>
    </note> Orekire akanwa kaawe kugamba eby'obubi,</para>
  <para style="q1" vid="PSA 50:19">N'orurimi rwawe rwehangira eby'obugobya.<verse eid="PSA 50:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20" />Otuura noogambuura mwene sho,</para>
  <para style="q1" vid="PSA 50:20">Kandi obeiherera mwene nyoko.<verse eid="PSA 50:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:21: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 8:11">Mub 8:11</ref>; <ref loc="ISA 57:11">Isa 57:11</ref>; <ref loc="ROM 2:4">Rom 2:4</ref>. </char>
    </note> Ebyo byona okabikora, naakwetsiza;</para>
  <para style="q1" vid="PSA 50:21">Waateekateeka ngu niinyinganira kimwe naiwe,</para>
  <para style="q1" vid="PSA 50:21">Kwonka ndyakuhana, mbikuratanise omu maisho gaawe.<verse eid="PSA 50:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:2">Zab 7:2</ref>; <ref loc="PSA 9:17">9:17</ref>. </char>
    </note> Mbwenu imwe abeebwa Ruhanga, mwetegyereze eki,</para>
  <para style="q1" vid="PSA 50:22">Ntakaabataagataagura, mukabura kijuna.<verse eid="PSA 50:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">50:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>, <ref loc="PSA 50:15">15</ref>; <ref loc="PSA 91:16">91:16</ref>. </char>
    </note> Orikuhayo ekitambo ky'okusiima, naaba ampaire ekitiinisa;</para>
  <para style="q1" vid="PSA 50:23">Kandi orikutwza gye omu micwe ye, ndyamworeka okujuna kwa Ruhanga.<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s1">Okweteisa kwa Daudi</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi, obu yaizirwa nabi Nasani, aherize kushambana na Batisheba</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:45">Zab 106:45</ref>; <ref loc="ISA 44:22">Isa 44:22</ref>; <ref loc="ACT 3:19">Byak 3:19</ref>. </char>
    </note> Ai MUKAMA, onsaasire nk'embabazi zaawe nyingi oku ziri;</para>
  <para style="q1" vid="PSA 51:1">Nk'okusaasira kwawe kwingi oku kuri, oragaze eby'okushiisha byangye.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:2: </char>
      <char style="xt" closed="false">
        <ref loc="JER 4:14">Yer 4:14</ref>; <ref loc="ACT 22:16">Byak 22:16</ref>; <ref loc="HEB 9:14">Heb 9:14</ref>; <ref loc="1JN 1:7">1 Yoh 1:7</ref>. </char>
    </note> Onyogyeze kimwe okutahikiirira kwangye.</para>
  <para style="q1" vid="PSA 51:2">Kandi onshemeze, onyiheho ekibi kyangye;<verse eid="PSA 51:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:5">Zab 32:5</ref>. </char>
    </note> ahakuba niinyemera eby'okushiisha byangye,</para>
  <para style="q1" vid="PSA 51:3">N'ekibi kyangye kiri omu maisho gangye obutoosha.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:4: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:9">Kut 39:9</ref>; <ref loc="2SA 12:13">2 Sam 12:13</ref>; <ref loc="LUK 15:18">Luk 15:18</ref>, <ref loc="LUK 15:21">21</ref>; <ref loc="ROM 3:4">Rom 3:4</ref>. </char>
    </note> Iwe, niiwe wenka ou naacumwireho,</para>
  <para style="q1" vid="PSA 51:4">Nkakora ekihagaro omu maisho gaawe,</para>
  <para style="q1" vid="PSA 51:4">N'ahabw'ekyo ohikire omu kwomesereza kwawe,</para>
  <para style="q1" vid="PSA 51:4">Kandi ori ow'amazima omu micwere yaawe.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 15:14">Yob 15:14</ref>; <ref loc="ROM 5:12">Rom 5:12</ref>, <ref loc="ROM 5:19">19</ref>. </char>
    </note> Reeba, nkahangirwa omu kutahikiirira;</para>
  <para style="q1" vid="PSA 51:5">N'omu kibi maawe nimwo yanzaariire.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:36">Yob 38:36</ref>. </char>
    </note> Reeba, okunda amazima g'omunda,</para>
  <para style="q1" vid="PSA 51:6">N'ahabw'ekyo onyegyese obwengye omu mutima ahatareebwa.<verse eid="PSA 51:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:2">Zab 51:2</ref>; <ref loc="LEV 14:4">Lev 14:4</ref>, <ref loc="LEV 14:6">6</ref>, <ref loc="LEV 14:7">7</ref>; <ref loc="ISA 1:18">Isa 1:18</ref>. </char>
    </note> Onyeze <note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="ft" closed="false">Enyaweera, omu Ruheburaayo ni ezob, omu Rugriika ni hussopos. </char></note>n'enyaweera, niinyija kushemera;</para>
  <para style="q1" vid="PSA 51:7">Onyozye nyere okukira orubaare.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />Onyijuze okushemererwa n'okwesiima,</para>
  <para style="q1" vid="PSA 51:8">Amagufa agu waahenzire gananukye.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:1">Zab 51:1</ref>; <ref loc="JER 16:17">Yer 16:17</ref>. </char>
    </note> Otareeba ebibi byangye,</para>
  <para style="q1" vid="PSA 51:9">Oragarize kimwe eby'okushiisha byangye byona.<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:4">Zab 24:4</ref>; <ref loc="PSA 78:37">78:37</ref>; <ref loc="1SA 10:9">1 Sam 10:9</ref>; <ref loc="JER 24:7">Yer 24:7</ref>; <ref loc="EZK 36:26">Ezk 36:26</ref>. </char>
    </note> Ompangyemu omutima ogushemeire, ai Ruhanga;</para>
  <para style="q1" vid="PSA 51:10">Ogarure omwoyo murungi omunda yangye.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:11: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 4:14">Kut 4:14</ref>; <ref loc="2KI 13:23">2 Bag 13:23</ref>; <ref loc="JER 7:15">Yer 7:15</ref>. </char>
    </note> Otambinga ahu ori,</para>
  <para style="q1" vid="PSA 51:11">Kandi otaanyihaho Omwoyo waawe Orikwera.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:12: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:15">Rom 8:15</ref>; <ref loc="2CO 3:17">2 Kor 3:17</ref>. </char>
    </note> Ongarurire okushemererwa kw'okujuna kwawe,</para>
  <para style="q1" vid="PSA 51:12">Ompamye n'omwoyo ogurikukworobera.<verse eid="PSA 51:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:32">Luk 22:32</ref>. </char>
    </note> Obwo nibwo ndyegyesa abasiisi emihanda yaawe,</para>
  <para style="q1" vid="PSA 51:13">N'enkozi z'ebibi zikakuhindukira.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:5">Zab 24:5</ref>; <ref loc="PSA 71:15">71:15</ref>; <ref loc="2SA 11:17">2 Sam 11:17</ref>; <ref loc="2SA 12:9">12:9</ref>. </char>
    </note> Onkize orubanja rw'obwitsi,</para>
  <para style="q1" vid="PSA 51:14">Ai Ruhanga, iwe Ruhanga w'okujunwa kwangye,</para>
  <para style="q1" vid="PSA 51:14">Kandi orurimi rwangye ruryayeshongora munonga eby'okuhikiirira kwawe.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />Ai MUKAMA, yashamya akanwa kangye,</para>
  <para style="q1" vid="PSA 51:15">N'eminwa yangye emanyise okuhimbisibwa kwawe;<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:6">Zab 40:6</ref>. </char>
    </note> Ahakuba toshemerererwa bitambo, nkaabikuhaire;</para>
  <para style="q1" vid="PSA 51:16">Ebitambo ebyokize tobisiima.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:18">Zab 34:18</ref>. </char>
    </note> Ebitambo ebi Ruhanga asiima n'omutima oguhendekire,</para>
  <para style="q1" vid="PSA 51:17">Omutima oguhendekire, ogweteisiize kimwe,<verse eid="PSA 51:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Kora gye Saayuuni, nk'oku orikusiima;</para>
  <para style="q1" vid="PSA 51:18">Zitirira Yerusaalemu orugo rw'amabaare.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">51:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:5">Zab 4:5</ref>; <ref loc="DEU 33:10">Bir 33:10</ref>; <ref loc="MAL 3:3">Mal 3:3</ref>. </char>
    </note> Obwo nibwo orishemerererwa ebitambo ebihikire,</para>
  <para style="q1" vid="PSA 51:19">N'ebitambo ebyokize, n'ebitambo ebyokyeize kimwe;</para>
  <para style="q1" vid="PSA 51:19">Haza nibwo enimi zirihongyerwa aha itambiro ryawe.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" sid="PSA 52" />
  <para style="s1">Ekifubiro ky'omubi orikwesiimira obubi</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi obu Doegi Omunyedomu yaija kugambira Saulo ku Daudi ataahire owa Ahimeleki</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 52:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:1: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 22:9">1 Sam 22:9</ref>; <ref loc="1SA 10">10</ref>. </char>
    </note> Ahabw'enki oyesiimira eitima, iwe manzi 'we,</para>
  <para style="q1" vid="PSA 52:1">Noorwanisa embabazi za Ruhanga?</para>
  <para style="q1" vid="PSA 52:1">Orenzya eizooba noocuma enaama z'okuhwerekyereza.<verse eid="PSA 52:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:19">Zab 50:19</ref>; <ref loc="PSA 101:7">101:7</ref>. </char>
    </note> Orurimi rwawe ni nk'orumweiso rw'obwogi,</para>
  <para style="q1" vid="PSA 52:2">Iwe orikuhanuura eby'okureebya.<verse eid="PSA 52:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:4">Yer 9:4</ref>, <ref loc="JER 9:5">5</ref>. </char>
    </note> Okunda ebibi okukira ebirungi,</para>
  <para style="q1" vid="PSA 52:3">N'okubeiha okukira okugamba eby'amazima.<verse eid="PSA 52:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4" />Okunda ebigambo byona ebirikuhwerekyereza,</para>
  <para style="q1" vid="PSA 52:4">Iwe orurimi orurikugobya.<verse eid="PSA 52:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:13">Zab 27:13</ref>; <ref loc="PRO 2:22">Enf 2:22</ref>. </char>
    </note> Naiwe nikwo Ruhanga arikuhwerekyereza ebiro byona;</para>
  <para style="q1" vid="PSA 52:5">Aryakukwata n'amaani, akuhuruuture omu ihema ryawe,</para>
  <para style="q1" vid="PSA 52:5">Akurandure omu nsi y'abahuriire.<verse eid="PSA 52:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:3">Zab 40:3</ref>; <ref loc="JOB 22:19">Yob 22:19</ref>. </char>
    </note> Abahikiriire baryakireeba, batiine,</para>
  <para style="q1" vid="PSA 52:6">Bamushekyerere nibagira bati:<verse eid="PSA 52:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:6">Zab 49:6</ref>; <ref loc="JOB 31:24">Yob 31:24</ref>, <ref loc="JOB 31:25">25</ref>. </char>
    </note> Nimureebe ogu mushaija otaragizire Ruhanga buhungiro bwe,</para>
  <para style="q1" vid="PSA 52:7">Kureka owaayesigire eitungo rye ringi,</para>
  <para style="q1" vid="PSA 52:7">N'obutungi bwe akabugira obuhungiro.<verse eid="PSA 52:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:12">Zab 92:12</ref>, <ref loc="PSA 92:13">13</ref>; <ref loc="PSA 128:3">128:3</ref>; <ref loc="JER 11:16">Yer 11:16</ref>. </char>
    </note> Kwonka nyowe ndi nk'omuzeituuni mubisi omu nju ya Ruhanga,</para>
  <para style="q1" vid="PSA 52:8">Nyesiga embabazi za Ruhanga ebiro n'ebiro.<verse eid="PSA 52:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">52:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:6">Zab 54:6</ref>. </char>
    </note> Ndyagamba eiziina ryawe omu maisho g'abarikwera baawe,</para>
  <para style="q1" vid="PSA 52:9">Ahabw'okuba ni rirungi.<verse eid="PSA 52:9" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" sid="PSA 53" />
  <para style="s1">Obushema bw'abantu n'obubi bwabo</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Ekyeshongoro kya Daudi omu iraka rya Mahalaasi, ekyagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 53:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:1-6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:1-7">Zab 14:1-7</ref>. </char>
    </note> <note caller="-" style="x"><char style="xo" closed="false">53:1-3: </char><char style="xt" closed="false"><ref loc="ROM 3:10-12">Rom 3:10-12</ref>. </char></note>Omushema agira omu mutima gwe ati:</para>
  <para style="q1" vid="PSA 53:1">Ruhanga tabaho;</para>
  <para style="q1" vid="PSA 53:1">Basiisikaire, nibakora ebihagaro;</para>
  <para style="q1" vid="PSA 53:1">Tihariho n'omwe orikukora gye.<note caller="-" style="x"><char style="xo" closed="false">53:1: </char><char style="xt" closed="false"><ref loc="PSA 10:4">Zab 10:4</ref>. </char></note><verse eid="PSA 53:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:2 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:19">Zab 102:19</ref>; <ref loc="2CH 19:3">2 Bus 19:3</ref>. </char>
    </note> Ruhanga akeema omu iguru, yaareeba abantu,</para>
  <para style="q1" vid="PSA 53:2">Ngu amanye ku haraabe hariho abarikwetegyereza,</para>
  <para style="q1" vid="PSA 53:2">Bakasherura Ruhanga.<verse eid="PSA 53:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3" />Boona bagarukire enyima; boona basiisikaire hamwe;</para>
  <para style="q1" vid="PSA 53:3">Tihariho orikukora gye; buzima tihariho n'omwe.<verse eid="PSA 53:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:6">Zab 79:6</ref>; <ref loc="ISA 1:3">Isa 1:3</ref>; <ref loc="JER 4:22">Yer 4:22</ref>; <ref loc="JER 10:25">10:25</ref>; <ref loc="HOS 7:7">Hos 7:7</ref>; <ref loc="MIC 3:3">Mik 3:3</ref>. </char>
    </note> Beitu enkozi z'ebibi tizigira obwengye?</para>
  <para style="q1" vid="PSA 53:4">Barya abantu bangye nk'abarikurya eby'okurya,</para>
  <para style="q1" vid="PSA 53:4">Kandi tibatakira Ruhanga.<verse eid="PSA 53:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:7">Zab 141:7</ref>; <ref loc="LEV 26:36">Lev 26:36</ref>; <ref loc="PRO 28:1">Enf 28:1</ref>. </char>
    </note> Okwo bakagirirayo obwoba bwingi,</para>
  <para style="q1" vid="PSA 53:5">Ahu batakubugiriire.</para>
  <para style="q1" vid="PSA 53:5">Ahabw'okuba Ruhanga akanaganaga amagufa g'oteekire enteeko kukuteera;</para>
  <para style="q1" vid="PSA 53:5">Waabaitsa enshoni, ahakuba Ruhanga abangire.<verse eid="PSA 53:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">53:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:1">Zab 85:1</ref>; <ref loc="EZK 39:25">Ezk 39:25</ref>; <ref loc="HOS 6:11">Hos 6:11</ref>; <ref loc="JOL 3:1">Yoel 3:1</ref>. </char>
    </note> Nkaabaasibwa ki, okujunwa kwa Israeli kuruga omuri Saayuuni!</para>
  <para style="q1" vid="PSA 53:6">Ruhanga ku araagarure abantu be abanyagirwe,</para>
  <para style="q1" vid="PSA 53:6">Yakobo aryayesiima, na Israeli ananukye.<verse eid="PSA 53:6" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" sid="PSA 54" />
  <para style="s1">Okushaba okujunwa omu mikono y'abazigu babi</para>
  <para style="d">Aha Mukuru w'abeeshongozi abateera enanga. Zaaburi ya Daudi, obu aba Ziifu baagambira Saulo ku Daudi ayesherekire owaabo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 54:1" />Ai Ruhanga, njunisa eiziina ryawe,</para>
  <para style="q1" vid="PSA 54:1">Omu bushoboorozi bwawe oncwere orubanja omu mazima.<verse eid="PSA 54:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:1">Zab 55:1</ref>. </char>
    </note> Ohurire okushaba kwangye, ai Ruhanga,</para>
  <para style="q1" vid="PSA 54:2">Otegye okutu ebigambo ebi ndikugamba;<verse eid="PSA 54:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:14">Zab 86:14</ref>; <ref loc="1SA 23:15">1 Sam 23:15</ref>. </char>
    </note> Ahakuba abanyamaryo banyimukiriire,</para>
  <para style="q1" vid="PSA 54:3">Abataine saasi nibacwa obwengye oku baraanyite;</para>
  <para style="q1" vid="PSA 54:3">Tibeeteire hari Ruhanga.<verse eid="PSA 54:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:6">Zab 118:6</ref>, <ref loc="PSA 118:7">7</ref>; <ref loc="ISA 41:10">Isa 41:10</ref>. </char>
    </note> Reeba, Ruhanga niwe Muhwezi wangye;</para>
  <para style="q1" vid="PSA 54:4">Mukama niwe akwatirira amagara gangye.<verse eid="PSA 54:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:12">Zab 143:12</ref>. </char>
    </note> Aryahoora abazigu bangye ahabw'obubi bwabo;</para>
  <para style="q1" vid="PSA 54:5">Obamareho, nk'obwesigwa bwawe oku buri.<verse eid="PSA 54:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:9">Zab 52:9</ref>. </char>
    </note> Ndyakuhogyera ekitambo nyihire aha mutima;</para>
  <para style="q1" vid="PSA 54:6">Ndyasingiza eiziina ryawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 54:6">Ahakuba ni rirungi.<verse eid="PSA 54:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">54:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:10">Zab 59:10</ref>; <ref loc="PSA 92:11">92:11</ref>; <ref loc="PSA 112:8">112:8</ref>; <ref loc="PSA 118:7">118:7</ref>. </char>
    </note> Ahabw'okuba onyihire omu naku zangye zoona;</para>
  <para style="q1" vid="PSA 54:7">Kandi eriisho ryangye ryareeba eki naayetengyeire abazigu bangye.<verse eid="PSA 54:7" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" sid="PSA 55" />
  <para style="s1">Okushaba okwihwa omu mikono y'abarikutureebya</para>
  <para style="d">Aha Mukuru w'abeeshongozi abateera enanga. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 55:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:2">Zab 54:2</ref>; <ref loc="PSA 86:6">86:6</ref>. </char>
    </note> Otegye okutu okushaba kwangye, ai Ruhanga,</para>
  <para style="q1" vid="PSA 55:1">Kandi oteehuzya okweshengyereza kwangye.<verse eid="PSA 55:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:17">Zab 55:17</ref>. </char>
    </note> Ompurire, ongarukyemu,</para>
  <para style="q1" vid="PSA 55:2">Ninfa kubi ahabw'obusaasi bwangye, kandi nintsinda.<verse eid="PSA 55:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:3: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 16:7">2 Sam 16:7</ref>, <ref loc="2SA 16:8">8</ref>. </char>
    </note> Orwari rw'abazigu n'okwitwa kubi ababi byankabya,</para>
  <para style="q1" vid="PSA 55:3">Ahakuba nibandusya, kandi nibampiiga n'ekiniga.<verse eid="PSA 55:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:4: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:38">Mat 26:38</ref>. </char>
    </note> Omutima gwangye gwine obusaasi bwingi;</para>
  <para style="q1" vid="PSA 55:4">Nkwatsirwe obwoba bwingi ahabw'okutiina rufu,<verse eid="PSA 55:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:6">Yob 21:6</ref>; <ref loc="ISA 21:4">Isa 21:4</ref>. </char>
    </note> Nintiina kandi nintetema; omutima gumpweire omunda.<verse eid="PSA 55:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6" />Naanye nikwo kugira nti: Ekyakumbaasa, n'okugira amapapa nk'enkombe,</para>
  <para style="q1" vid="PSA 55:6">Nkeegurukira, nkaruhuuka!<verse eid="PSA 55:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:2">Yer 9:2</ref>. </char>
    </note> Nkaagiire hare, ndarira omu ihamba.<verse eid="PSA 55:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8" />Nkaarahukire kwesherurira obwegamo,</para>
  <para style="q1" vid="PSA 55:8">Ndeka kwitwa eihunga n'omuyaga mwingi.<verse eid="PSA 55:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:7">Yer 6:7</ref>. </char>
    </note> Shiisha enaama zaabo, ai Mukama, n'endimi zaabo ozirabanisemu;</para>
  <para style="q1" vid="PSA 55:9">Ahakuba ndeebire okwitana n'okurwana omu rurembo.<verse eid="PSA 55:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10" />Nyomushana na nyekiro nibagyendagyendera aha mutwe gw'orugo rwarwo nibarwehinguririza;</para>
  <para style="q1" vid="PSA 55:10">Omurirwo harimu okutahikiirira n'eitima.<verse eid="PSA 55:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11" />Obubi buri ahagati omurirwo;</para>
  <para style="q1" vid="PSA 55:11">Okwita kubi n'oburyarya tibiruga mu nguuto zaarwo.<verse eid="PSA 55:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:12-14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:9">Zab 41:9</ref>; <ref loc="JOB 19:5">Yob 19:5</ref>, <ref loc="JOB 19:14">14</ref>, <ref loc="JOB 19:19">19</ref>; <ref loc="2SA 15:12">2 Sam 15:12</ref>. </char>
    </note> Kwonka owanjumire akaba atari muzigu wangye;</para>
  <para style="q1" vid="PSA 55:12">Kandi owaanyekunikireho akaba atari mubisha,</para>
  <para style="q1" vid="PSA 55:12">Nkaamwesherekire;<verse eid="PSA 55:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13" />Kureka akaba ari iwe, ou turikwingana,</para>
  <para style="q1" vid="PSA 55:13">Mugyenzi wangye kandi munywani wangye buzima.<verse eid="PSA 55:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14" />Tukaba tugaaniira hamwe n'okushemererwa;</para>
  <para style="q1" vid="PSA 55:14">Tugyendana omu nju ya Ruhanga, tukwataniise.<verse eid="PSA 55:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:15: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:30">Kub 16:30</ref>, <ref loc="NUM 16:33">33</ref>. </char>
    </note> Ka rufu ebagweho;</para>
  <para style="q1" vid="PSA 55:15">Bashuume okuzimu bahuriire;</para>
  <para style="q1" vid="PSA 55:15">Ahakuba obubi buri omuribo n'omu maka gaabo.<verse eid="PSA 55:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16" />Kwonka nyowe ahabwangye ndyatakira Ruhanga;</para>
  <para style="q1" vid="PSA 55:16">Kandi MUKAMA aryanjuna.<verse eid="PSA 55:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:3">Zab 5:3</ref>; <ref loc="PSA 92:2">92:2</ref>; <ref loc="PSA 141:2">141:2</ref>; <ref loc="DAN 6:10">Dan 6:10</ref>; <ref loc="ACT 10:9">Byak 10:9</ref>. </char>
    </note> Omu mwabazyo, omu kasheeshe n'omu ihangwe,</para>
  <para style="q1" vid="PSA 55:17">Ndyatonzya nintsinda; kandi aryahurira eiraka ryangye.<verse eid="PSA 55:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18" />Aryajuna amagara gangye,</para>
  <para style="q1" vid="PSA 55:18">Ankize abarikuunyirira haihi kundwanisa;</para>
  <para style="q1" vid="PSA 55:18">Ahakuba abarikundwanisa ni baingi.<verse eid="PSA 55:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:19: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 33:27">Bir 33:27</ref>. </char>
    </note> Ruhanga otuura aha kitebe kye eky'obukama okuruga iranaira,</para>
  <para style="q1" vid="PSA 55:19">Aryahurira, abacureeze,</para>
  <para style="q1" vid="PSA 55:19">Ahakuba tibahinduka, tibatiina Ruhanga.<verse eid="PSA 55:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20" />Mugyenzi wangye ogwo akabanga omukono kuteera banywani be;</para>
  <para style="q1" vid="PSA 55:20">Yaita endagaano ye.<verse eid="PSA 55:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:3">Zab 28:3</ref>; <ref loc="PSA 57:4">57:4</ref>; <ref loc="PRO 5:3">Enf 5:3</ref>. </char>
    </note> Akaba agamba ebyorobi nk'amajuta,</para>
  <para style="q1" vid="PSA 55:21">Kwonka omutima gwe gukaba gubamu orugamba;</para>
  <para style="q1" vid="PSA 55:21">Ebigambo bye bikaba byorobi nk'amajuta g'emizeituuni,</para>
  <para style="q1" vid="PSA 55:21">Kwonka biri nka zaarurara ezisyoirweyo.<verse eid="PSA 55:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:5">Zab 37:5</ref>, <ref loc="PSA 37:24">24</ref>. </char>
    </note> Yegyekyerera MUKAMA omutwaro gwawe,</para>
  <para style="q1" vid="PSA 55:22">Nawe aryaguma naakukwatirira;</para>
  <para style="q1" vid="PSA 55:22">Tariikiriza ohikiriire kutengyetsibwa.<verse eid="PSA 55:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">55:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:6">Zab 5:6</ref>; <ref loc="PSA 59:11">59:11</ref>; <ref loc="PSA 69:15">69:15</ref>; <ref loc="JOB 15:32">Yob 15:32</ref>; <ref loc="PRO 10:27">Enf 10:27</ref>. </char>
    </note> Kwonka Iwe, Ruhanga, oryabanaga omu kiina ky'okuhwerekyerereramu;</para>
  <para style="q1" vid="PSA 55:23">Abaitsi n'engobya baryafa batakahikize kicweka ky'emyaka yaabo;</para>
  <para style="q1" vid="PSA 55:23">Kwonka nyowe ndyaguma nkwesigye.<verse eid="PSA 55:23" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" sid="PSA 56" />
  <para style="s1">Okwesiga Mukama n'obu abazigu baitu baraabe nibatuhiiga</para>
  <para style="d">Aha Mukuru w'abeeshongozi, aha iraka eririkwetwa Enkombe. Zaaburi ya Daudi erikwetwa Mikitaamu, obu Abafilistia baamukwatira Gaasi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 56:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 124:3">Zab 124:3</ref>; <ref loc="PRO 1:12">Enf 1:12</ref>. </char>
    </note> Ngirira embabazi, ai Ruhanga,</para>
  <para style="q1" vid="PSA 56:1">Ahakuba abantu nibenda kummira;</para>
  <para style="q1" vid="PSA 56:1">Eizooba ryona nibandwanisa, nibaanyita kubi.<verse eid="PSA 56:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2" />Abazigu bangye barenzya eizooba nibenda kummira;</para>
  <para style="q1" vid="PSA 56:2">Ahakuba abarikundwanisa n'amaryo ni baingi.<verse eid="PSA 56:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 30:6">1 Sam 30:6</ref>; <ref loc="2CH 20:3">2 Bus 20:3</ref>. </char>
    </note> Ku ndaagume naatiina, ninkwesiga.<verse eid="PSA 56:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:6">Zab 118:6</ref>. </char>
    </note> Ruhanga aryampa okusiima ekigambo kye;</para>
  <para style="q1" vid="PSA 56:4">Ruhanga niwe ndikwesiga; tinditiina;</para>
  <para style="q1" vid="PSA 56:4">Abantu-buntu nibabaasa kunkora ki?<verse eid="PSA 56:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5" />Barenzya eizooba nibahindahindura ebigambo byangye;</para>
  <para style="q1" vid="PSA 56:5">Ebiteekateeko byabo byona n'eby'okundwanisa kunkora kubi.<verse eid="PSA 56:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:3">Zab 59:3</ref>; <ref loc="PSA 71:10">71:10</ref>. </char>
    </note> Beeteerana hamwe, beesherekire;</para>
  <para style="q1" vid="PSA 56:6">Nibareebereza ahu ndikuraba.</para>
  <para style="q1" vid="PSA 56:6">Nk'oku baagwereire amagara gangye,<verse eid="PSA 56:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7" />Naiwe obazimuurire ahabw'ekibi kyabo;</para>
  <para style="q1" vid="PSA 56:7">Ai Ruhanga, omu kiniga kyawe otuure ahansi amahanga.<verse eid="PSA 56:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:8: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 20:5">2 Bag 20:5</ref>; <ref loc="MAT 3:16">Mat 3:16</ref>. </char>
    </note> Niiwe omanya okuzengyerera kwangye;</para>
  <para style="q1" vid="PSA 56:8">Ote amarira gangye omu cupa yaawe.</para>
  <para style="q1" vid="PSA 56:8">Tigarahandiikirwe omu kitabo kyawe?<verse eid="PSA 56:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:2">Zab 102:2</ref>; <ref loc="PSA 118:6">118:6</ref>; <ref loc="ROM 8:31">Rom 8:31</ref>. </char>
    </note> Aha izooba eri ndikutakiriraho,</para>
  <para style="q1" vid="PSA 56:9">Abazigu bangye baryagarurwa enyima.</para>
  <para style="q1" vid="PSA 56:9">Eki ndikumanya n'eki ngu, Ruhanga ari aha rubaju rwangye.<verse eid="PSA 56:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10" />Ruhanga aryampa okusiima ekigambo kye;</para>
  <para style="q1" vid="PSA 56:10">MUKAMA aryampa okusiima ekigambo kye;<verse eid="PSA 56:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 56:11" />Ruhanga niwe nyesiga; tinditiina;</para>
  <para style="q1" vid="PSA 56:11">Abantu-buntu nibabaasa kunkora ki?<verse eid="PSA 56:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>. </char>
    </note> Ebi naakuraganiise nshemereire kubihikiiriza, ai Ruhanga;</para>
  <para style="q1" vid="PSA 56:12">Ndyakuha ebihongwa by'okusiima;<verse eid="PSA 56:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">56:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:19">Zab 49:19</ref>; <ref loc="PSA 116:8">116:8</ref>, <ref loc="PSA 116:9">9</ref>; <ref loc="JOB 33:30">Yob 33:30</ref>. </char>
    </note> Ahakuba okaiha amagara gangye omu kufa,</para>
  <para style="q1" vid="PSA 56:13">Waazibira ebigyere byangye kuterera,</para>
  <para style="q1" vid="PSA 56:13">Ngu mbone kugyendera omu maisho ga Ruhanga</para>
  <para style="q1" vid="PSA 56:13">Omu mushana gw'amagara.<verse eid="PSA 56:13" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" sid="PSA 57" />
  <para style="s1">Okwesiga Mukama omu kabi koona tutarikubangaanisa</para>
  <para style="d">Aha Mukuru w'abeeshongozi, aha iraka eririkwetwa Otahwerekyereza. Zaaburi ya Daudi obu yaahungira Saulo omu ryaya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 57:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:8">Zab 17:8</ref>; <ref loc="PSA 91:4">91:4</ref>; <ref loc="ISA 26:20">Isa 26:20</ref>. </char>
    </note> Nsaasira, ai Ruhanga, onsaasire,</para>
  <para style="q1" vid="PSA 57:1">Ahakuba amagara gangye niiwe gahungiraho;</para>
  <para style="q1" vid="PSA 57:1">Ndyahungira omu mapapa gaawe, gambumbatire,</para>
  <para style="q1" vid="PSA 57:1">Okuhitsya obu akabi aka koona karihwaho.<verse eid="PSA 57:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 138:8">Zab 138:8</ref>. </char>
    </note> Ndyatakira Ruhanga Rukira-boona,</para>
  <para style="q1" vid="PSA 57:2">Niwe Ruhanga onkorera byona.<verse eid="PSA 57:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:16">Zab 18:16</ref>; <ref loc="PSA 40:11">40:11</ref>; <ref loc="PSA 43:3">43:3</ref>; <ref loc="PSA 56:1">56:1</ref>. </char>
    </note> Aryayema omu iguru, anjune;</para>
  <para style="q1" vid="PSA 57:3">Aryahemura abarikwenda kummira.</para>
  <para style="q1" vid="PSA 57:3">Ruhanga aryayohereza embabazi ze n'amazima ge.<verse eid="PSA 57:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 64:3">Zab 64:3</ref>; <ref loc="PRO 30:14">Enf 30:14</ref>. </char>
    </note> Amagara gangye gari ahagati y'entare</para>
  <para style="q1" vid="PSA 57:4">Ezishonsomera abantu n'omururu.</para>
  <para style="q1" vid="PSA 57:4">Amaino gaabo n'amacumu n'emyambi,</para>
  <para style="q1" vid="PSA 57:4">Kandi endimi zaabo ni zaarurara z'obwogi.<verse eid="PSA 57:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:5">Zab 108:5</ref>. </char>
    </note> Oteebwe ahaiguru okukira eiguru, ai Ruhanga!</para>
  <para style="q1" vid="PSA 57:5">Ekitiinisa kyawe kibe ahaiguru y'ensi yoona!<verse eid="PSA 57:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>; <ref loc="JOB 18:8">Yob 18:8</ref>. </char>
    </note> Bategire ebigyere byangye omutego;</para>
  <para style="q1" vid="PSA 57:6">Omutima gwangye gucuramiriirwe;</para>
  <para style="q1" vid="PSA 57:6">Batimbire obusya ahu ndikuraba;</para>
  <para style="q1" vid="PSA 57:6">Kwonka baaba nibo baabugwamu.<verse eid="PSA 57:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:7-11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:1-5">Zab 108:1-5</ref>. </char>
    </note> Omutima gwangye gugumire, ai Ruhanga,</para>
  <para style="q1" vid="PSA 57:7">Omutima gwangye gugumire;</para>
  <para style="q1" vid="PSA 57:7">Ndyayeshongora; eego, ndyayeshongora eby'okuhimbisa!<note caller="-" style="x"><char style="xo" closed="false">57:7: </char><char style="xt" closed="false"><ref loc="PSA 112:7">Zab 112:7</ref>. </char></note><verse eid="PSA 57:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:9">Zab 16:9</ref>; <ref loc="JDG 5:12">Bar 5:12</ref>; <ref loc="1CH 15:16">1 Bus 15:16</ref>. </char>
    </note> Sisiimuka, iwe magara gangye!</para>
  <para style="q1" vid="PSA 57:8">Sisiimuka, iwe enanga n'endigiri!</para>
  <para style="q1" vid="PSA 57:8">Naanye ahabwangye niinyija kusisiimuka kare munonga.<verse eid="PSA 57:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9" />Ai Mukama, ndyakusiima omu bantu,</para>
  <para style="q1" vid="PSA 57:9">Ndyayeshongora eby'okukuhimbisa omu mahanga.<verse eid="PSA 57:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">57:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:5">Zab 36:5</ref>. </char>
    </note> Ahakuba embabazi zaawe ni nyingi, nizihika omu iguru,</para>
  <para style="q1" vid="PSA 57:10">N'okwesigwa kwawe kuhika omu bicu.<verse eid="PSA 57:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11" />Oteebwe ahaiguru okukira eiguru, ai Ruhanga!</para>
  <para style="q1" vid="PSA 57:11">Ekitiinisa kyawe kibe ahaiguru y'ensi yoona!<verse eid="PSA 57:11" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" sid="PSA 58" />
  <para style="s1">Okushaba Ruhanga kuba niwe yaahoora ebabi</para>
  <para style="d">Aha Mukuru w'abeeshongozi, aha iraka eririkwetwa Otahwerekyereza. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 58:1" />Beitu kwo imwe bantu 'mwe, mugamba eby'amazima?</para>
  <para style="q1" vid="PSA 58:1">Mucwera abantu emanja omu buryo?<verse eid="PSA 58:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2" />Ngaaha! Kureka omu mitima yaanyu mucwa obwengye kukora eby'okutahikiirira;</para>
  <para style="q1" vid="PSA 58:2">Endwano z'emikono yaanyu nirwo rubanja oru mucwa omu nsi.<verse eid="PSA 58:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:5">Zab 51:5</ref>; <ref loc="ISA 48:8">Isa 48:8</ref>. </char>
    </note> Ababi bataana na Ruhanga nibakiruga omunda;</para>
  <para style="q1" vid="PSA 58:3">Ku bazaarwa, bahaba, nibagamba eby'ebishuba.<verse eid="PSA 58:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:3">Zab 140:3</ref>; <ref loc="DEU 32:33">Bir 32:33</ref>. </char>
    </note> Obushegu bwabo ni nk'obw'enjoka;</para>
  <para style="q1" vid="PSA 58:4">Bari nk'empoma etarikuhurira, eyeitsire amatu,<verse eid="PSA 58:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 8:17">Yer 8:17</ref>. </char>
    </note> Eyanga kuhurira eiraka ry'abarogi,</para>
  <para style="q1" vid="PSA 58:5">N'obu baakuroga n'obwengye buta.<verse eid="PSA 58:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:7">Zab 3:7</ref>; <ref loc="JOB 4:10">Yob 4:10</ref>. </char>
    </note> Ai Ruhanga, bacwe amaino, ogamare omu kanwa;</para>
  <para style="q1" vid="PSA 58:6">Okuure ebigigo by'ebitsigazi by'entare, ai MUKAMA.<verse eid="PSA 58:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:10">Zab 112:10</ref>. </char>
    </note> Ka batuube, boome nk'emaizi agarikuhwererera omu itaka.</para>
  <para style="q1" vid="PSA 58:7">Baribatiirirwe nk'obunyaatsi bubisi, bahotokye.<verse eid="PSA 58:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 3:16">Yob 3:16</ref>. </char>
    </note> Babe nk'ekinyangondokyera, ekiyaga kikahwaho;</para>
  <para style="q1" vid="PSA 58:8">Nk'omwana ozaarwa atakahikire, otakareebaga izooba.<verse eid="PSA 58:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:12">Zab 118:12</ref>; <ref loc="PRO 10:25">Enf 10:25</ref>. </char>
    </note> Enyungu zaanyu zitakatagatsiibwe muriro gw'amahwa,</para>
  <para style="q1" vid="PSA 58:9">Ruhanga aryagatwaza omuyaga gw'akasooroora,</para>
  <para style="q1" vid="PSA 58:9">amabisi n'agahiire goona.<verse eid="PSA 58:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:23">Zab 68:23</ref>; <ref loc="DEU 32:43">Bir 32:43</ref>; <ref loc="JOB 22:19">Yob 22:19</ref>. </char>
    </note> Ohikiriire ku arireeba okwo kuhoora enzigu, aryayesiima;</para>
  <para style="q1" vid="PSA 58:10">Aryayogyesa ebigyere bye eshagama y'ababi.<verse eid="PSA 58:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">58:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:8">Zab 9:8</ref>; <ref loc="PSA 67:4">67:4</ref>; <ref loc="GEN 18:25">Kut 18:25</ref>; <ref loc="ECC 12:14">Mub 12:14</ref>; <ref loc="ISA 3:10">Isa 3:10</ref>. </char>
    </note> Ekirirugamu, abantu baryagira bati:</para>
  <para style="q1" vid="PSA 58:11">Buzimazima hariho ebihembo by'abahikiriire;</para>
  <para style="q1" vid="PSA 58:11">Buzimazima hariho Ruhanga ocwa emanja omu nsi.<verse eid="PSA 58:11" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" sid="PSA 59" />
  <para style="s1">Okushaba Ruhanga okutujuna abazigu baitu abarikutujuma</para>
  <para style="d">Aha Mukuru w'abeeshongozi omu iraka eririkwetwa Otahwerekyereza. Zaaburi ya Daudi, obu Saulo yaatuma ab'okurinda enju ye ngu bamwite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 59:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:48">Zab 18:48</ref>; <ref loc="PSA 20:1">20:1</ref>. </char>
    </note> Onkize abazigu bangye, ai Ruhanga;</para>
  <para style="q1" vid="PSA 59:1">Ondinde abampururiire.<verse eid="PSA 59:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2" />Onkize enkozi z'ebibi,</para>
  <para style="q1" vid="PSA 59:2">Onjune abakunda kusheesha eshagama;<verse eid="PSA 59:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:9">Zab 10:9</ref>; <ref loc="PSA 56:6">56:6</ref>; <ref loc="1SA 19:11">1 Sam 19:11</ref>; <ref loc="1SA 24:11">24:11</ref>. </char>
    </note> ahakuba bagwereire amagara gangye;</para>
  <para style="q1" vid="PSA 59:3">Amamanzi geeteeraine kundwanisa,</para>
  <para style="q1" vid="PSA 59:3">Ntaine kibi kyona, n'obu kyakuba eki nsiisire.<verse eid="PSA 59:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4" />Bairukanga nibaza kweteekateeka kundwanisa, ntaine ki nshobize.</para>
  <para style="q1" vid="PSA 59:4">Sisiimuka, ompwere, oyereebere.<verse eid="PSA 59:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:4">Zab 80:4</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'amahe, Ruhanga wa Israeli,</para>
  <para style="q1" vid="PSA 59:5">Imuka ohane abanyamahanga boona;</para>
  <para style="q1" vid="PSA 59:5">Otasaasira omunyabibi weena orikureebya.<verse eid="PSA 59:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6" />Buri mwabazyo bagaruka nibarira nk'embwa,</para>
  <para style="q1" vid="PSA 59:6">Nibagyendagyenda hoona omu rurembo.<verse eid="PSA 59:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:4">Zab 57:4</ref>; <ref loc="JOB 22:13">Yob 22:13</ref>; <ref loc="PRO 15:28">Enf 15:28</ref>. </char>
    </note> Reeba, bakankama n'akanwa kaabo;</para>
  <para style="q1" vid="PSA 59:7">Basinikire amaino,</para>
  <para style="q1" vid="PSA 59:7">Ahakuba bagira bati: Ebyo hariho orikutuhurira?<verse eid="PSA 59:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:4">Zab 2:4</ref>. </char>
    </note> Kwonka iwe, MUKAMA, oryabashekyerera;</para>
  <para style="q1" vid="PSA 59:8">Oteerere enaku abanyamahanga boona.<verse eid="PSA 59:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:9">Zab 9:9</ref>. </char>
    </note> Iwe Maani gangye, ndyakutegyereza;</para>
  <para style="q1" vid="PSA 59:9">Ahakuba Ruhanga niwe rugo rwangye orugumire.<verse eid="PSA 59:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:7">Zab 54:7</ref>. </char>
    </note> Ruhanga omu kusaasira kwe aryambugana;</para>
  <para style="q1" vid="PSA 59:10">Ruhanga aryanyikiriza ndeebe eki naayetengyeire abazigu bangye.<verse eid="PSA 59:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:23">Zab 55:23</ref>. </char>
    </note> Otabaita, abantu bangye barekye kwebwa;</para>
  <para style="q1" vid="PSA 59:11">Obatetemye n'amaani gaawe,</para>
  <para style="q1" vid="PSA 59:11">Obacwe amaryo, ai Mukama engabo yaitu.<verse eid="PSA 59:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12" />Ka bakwatirwe omu maryo gaabo</para>
  <para style="q1" vid="PSA 59:12">Ahabw'ebibi by'omu kanwa kaabo n'ebigambo by'eminwa yaabo,</para>
  <para style="q1" vid="PSA 59:12">N'ahabw'okukyeena n'ebishuba ebi bagamba.<verse eid="PSA 59:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 59:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:9">Zab 7:9</ref>. </char>
    </note> Obamareho n'ekiniga kyawe,</para>
  <para style="q1" vid="PSA 59:13">Obamareho okuhitsya obu baraahwereho kimwe,</para>
  <para style="q1" vid="PSA 59:13">Bamanye ku Ruhanga ategyeka Yakobo,</para>
  <para style="q1" vid="PSA 59:13">Okuhika aha muheru gw'ensi.<verse eid="PSA 59:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14" />Buri mwabazyo bagaruka nibarira nk'embwa,</para>
  <para style="q1" vid="PSA 59:14">Nibagyendagyenda hoona omu rurembo.<verse eid="PSA 59:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">59:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:10">Zab 109:10</ref>; <ref loc="JOB 15:23">Yob 15:23</ref>. </char>
    </note> Bazengyerera nibasherura eby'okurya;</para>
  <para style="q1" vid="PSA 59:15">Ku baba batahaagire, bubasheesheraho.<verse eid="PSA 59:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16" />Kwonka nyowe ndyayeshongora aha by'amaani gaawe,</para>
  <para style="q1" vid="PSA 59:16">Eego, omu kasheeshe ndyayeshongora n'eiraka rihango eby'embabazi zaawe;</para>
  <para style="q1" vid="PSA 59:16">ahakuba ombeereire orugo rugumire,</para>
  <para style="q1" vid="PSA 59:16">Kandi obuhungiro omu biro by'okubonabona kwangye.<verse eid="PSA 59:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17" />Iwe Maani gangye, ndyayeshongora eby'okukuhimbisa;</para>
  <para style="q1" vid="PSA 59:17">Ahakuba Ruhanga onsaasira niwe rugo rwangye orugumire.<verse eid="PSA 59:17" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" sid="PSA 60" />
  <para style="s1">Okushaba kutuhwera, twaba tusingwirwe omu rugamba</para>
  <para style="d">Aha Mukuru w'abeeshongozi; omu iraka eririkwetwa Shushani-Edusi. Zaaburi ya Daudi ey'okwegyesa, obu yaarwana na Aramunaharaimu na Aramu-zooba, kandi obu Yoabu yaita Abanyedomu kakumi n'enkumi ibiri, naagaruka omu ruhanga rw'Omwonyo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 60:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:9">Zab 44:9</ref>. </char>
    </note> Ai Ruhanga, otwangire, waatucwa emikono;</para>
  <para style="q1" vid="PSA 60:1">Waatugwerwa kubi; Nyakusinga, otugarure omu buteeka.<verse eid="PSA 60:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:2: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 7:14">2 Bus 7:14</ref>. </char>
    </note> Otetemize ensi, waagigangabura;</para>
  <para style="q1" vid="PSA 60:2">Ita obwatika bwayo; ahakuba neetengyeta.<verse eid="PSA 60:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:20">Zab 71:20</ref>; <ref loc="JOB 21:20">Yob 21:20</ref>; <ref loc="ISA 51:17">Isa 51:17</ref>. </char>
    </note> Oreeteire abantu baawe omunyangararo;</para>
  <para style="q1" vid="PSA 60:3">Otunyweisize viinyo y'okugyenda nitugwererana.<verse eid="PSA 60:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:5">Zab 20:5</ref>; <ref loc="ISA 11:10">Isa 11:10</ref>, <ref loc="ISA 11:12">12</ref>. </char>
    </note> Ohaire abarikukutiina orurango,</para>
  <para style="q1" vid="PSA 60:4">Ngu baruteeranireho nibahunga emyambi.<verse eid="PSA 60:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:5-12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 108:6-13">Zab 108:6-13</ref>. </char>
    </note> Ahabw'omukono gwawe ogwa buryo otuhe obusinguzi, otugarukyemu,</para>
  <para style="q1" vid="PSA 60:5">Eihanga ryawe eririkukundwa ribone kukira abazigu.<verse eid="PSA 60:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:35">Zab 89:35</ref>; <ref loc="GEN 33:17">Kut 33:17</ref>. </char>
    </note> Ruhanga akeema omu mwanya gwe ogurikwera, yaagira ati:</para>
  <para style="q1" vid="PSA 60:6">Ndyabaganisa Shekemu n'okwesiima kuhango,</para>
  <para style="q1" vid="PSA 60:6">Ngabe oruhanga rwa Sukoosi omu bicweka.<verse eid="PSA 60:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:10">Kut 49:10</ref>; <ref loc="NUM 32:1">Kub 32:1</ref>; <ref loc="DEU 33:17">Bir 33:17</ref>. </char>
    </note> Gileadi n'eyangye; na Manaase nayo n'eyangye;</para>
  <para style="q1" vid="PSA 60:7">Efuraimu n'enkofiira y'okundinda;</para>
  <para style="q1" vid="PSA 60:7">Yuda n'enkoni yangye ey'obukama.<verse eid="PSA 60:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:8, 9: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 8:1">2 Sam 8:1</ref>, <ref loc="2SA 8:2">2</ref>, <ref loc="2SA 8:14">14</ref>. </char>
    </note> Moabu n'ekinaabiro kyangye;</para>
  <para style="q1" vid="PSA 60:8">Edomu niho nnaga enkaito yangye;</para>
  <para style="q1" vid="PSA 60:8">Filistia niho nteerera akaari k'okusingura.<verse eid="PSA 60:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9" />N'oha orindeeta omu rurembo rw'amaani?</para>
  <para style="q1" vid="PSA 60:9">Kandi orimpitsya Edomu n'oha?<verse eid="PSA 60:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10" />Ai Ruhanga, toratwangire?</para>
  <para style="q1" vid="PSA 60:10">Ebi biro tokihurura na ngabo zaitu, ai Ruhanga.<verse eid="PSA 60:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 146:3">Zab 146:3</ref>. </char>
    </note> Otuhe emikono, turwanise abazigu baitu;</para>
  <para style="q1" vid="PSA 60:11">Ahakuba okuhwera kw'abantu tikwine mugasho.<verse eid="PSA 60:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">60:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:5">Zab 44:5</ref>; <ref loc="PSA 118:15">118:15</ref>, <ref loc="PSA 118:16">16</ref>; <ref loc="ISA 63:3">Isa 63:3</ref>. </char>
    </note> Ahabw'amaani ga Ruhanga, turyarwana mashaija;</para>
  <para style="q1" vid="PSA 60:12">Ahakuba niwe ariribatiirira abazigu baitu.<verse eid="PSA 60:12" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" sid="PSA 61" />
  <para style="s1">Okutakira Ruhanga, twaba twehweire amatsiko</para>
  <para style="d">Aha Mukuru w'Abeeshongozi. Zaaburi ya Daudi ey'okweshongorwa n'enanga y'emirya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 61:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:1">Zab 55:1</ref>, <ref loc="PSA 55:2">2</ref>; <ref loc="PSA 142:6">142:6</ref>. </char>
    </note> Hurira okutaka kwangye, ai Ruhanga;</para>
  <para style="q1" vid="PSA 61:1">Ote omutima aha kushaba kwangye;<verse eid="PSA 61:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:2">Zab 18:2</ref>; <ref loc="PSA 77:3">77:3</ref>. </char>
    </note> Ku ndiba ndi aha muheru gw'ensi, omutima gwangye gwagwa enshazi,</para>
  <para style="q1" vid="PSA 61:2">Ndyaguma nkutakire;</para>
  <para style="q1" vid="PSA 61:2">Ompitsye aha mutwe gw'orukiri, ahu ntarikubaasa kwehitsya.<verse eid="PSA 61:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:6">Zab 14:6</ref>; <ref loc="PRO 18:10">Enf 18:10</ref>. </char>
    </note> Ahakuba niiwe buhungiro bwangye,</para>
  <para style="q1" vid="PSA 61:3">N'omunaara gw'amaani gw'okundinda abazigu.<verse eid="PSA 61:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:8">Zab 17:8</ref>; <ref loc="PSA 23:6">23:6</ref>. </char>
    </note> Ndyaguma omu ihema ryawe ebiro byona;</para>
  <para style="q1" vid="PSA 61:4">Ndyahungira omu mapapa gaawe, gambumbatire.<verse eid="PSA 61:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5" />Ahakuba iwe Ruhanga, ohuriire okuhiga kwangye;</para>
  <para style="q1" vid="PSA 61:5">Ompaire obuhunguzi obuheebwa abatiina eiziina ryawe.<verse eid="PSA 61:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:4">Zab 21:4</ref>. </char>
    </note> Oyongyere aha biro by'amagara g'omugabe;</para>
  <para style="q1" vid="PSA 61:6">Emyaka ye ebe ey'obusingye bwingi.<verse eid="PSA 61:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:11">Zab 40:11</ref>. </char>
    </note> Agume aha ngoma omu maisho gaawe, ai Ruhanga, ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 61:7">Omutwekyere embabazi n'obwesigwa, bimurinde.<verse eid="PSA 61:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">61:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>. </char>
    </note> Obwo nibwo ndyeshongora eby'okuhimbisa eiziina ryawe ebiro byona,</para>
  <para style="q1" vid="PSA 61:8">Nkahikiiriza obutoosha ebi naaraganiise nimpiga.<verse eid="PSA 61:8" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" sid="PSA 62" />
  <para style="s1">Oku Mukama ari obuhungiro bwaitu ebiro byona</para>
  <para style="d">Aha Mukuru w'abeeshongozi, omu muringo gwa Yedusuuni. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 62:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:20">Zab 33:20</ref>. </char>
    </note> Amagara gangye gacureera nigategyereza Ruhanga wenka,</para>
  <para style="q1" vid="PSA 62:1">Ou okujunwa kwangye kurugaho.<verse eid="PSA 62:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:9">Zab 9:9</ref>; <ref loc="PSA 18:2">18:2</ref>. </char>
    </note> We wenka niwe rukiri rwangye kandi okujunwa kwangye;</para>
  <para style="q1" vid="PSA 62:2">Niwe rugo rwangye orugumire; tinditengyeta munonga.<verse eid="PSA 62:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:13">Isa 30:13</ref>. </char>
    </note> Muryahitsya hi okujumbukana omuntu, ngu mukwatanise, mumwite,</para>
  <para style="q1" vid="PSA 62:3">Nk'ekisiika kibogami, nk'orugo orurikugogoma kugwa.<verse eid="PSA 62:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:3">Zab 28:3</ref>. </char>
    </note> Enaama ei bagira n'emwe yonka, nikwo kumwiha aha bukuru bwe.</para>
  <para style="q1" vid="PSA 62:4">Bashemerererwa ebishuba.</para>
  <para style="q1" vid="PSA 62:4">Bashabira abantu omugisha n'akanwa kaabo,</para>
  <para style="q1" vid="PSA 62:4">Kwonka omunda nibabakyeena.<verse eid="PSA 62:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5" />Amagara gangye gacureera nigategyereza Ruhanga wenka;</para>
  <para style="q1" vid="PSA 62:5">ahakuba niwe amatsiko gangye garugaho.<verse eid="PSA 62:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6" />We wenka niwe rukiri rwangye kandi okujunwa kwangye;</para>
  <para style="q1" vid="PSA 62:6">Niwe rugo rwangye orugumire; tinditengyeta.<verse eid="PSA 62:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:8">Zab 3:8</ref>; <ref loc="PSA 14:6">14:6</ref>. </char>
    </note> Okujunwa kwangye n'ekitiinisa kyangye biri ahari Ruhanga;</para>
  <para style="q1" vid="PSA 62:7">Ruhanga niwe rukiri rwangye orw'amaani, kandi obuhungiro bwangye.<verse eid="PSA 62:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:6">Zab 14:6</ref>; <ref loc="PSA 37:3">37:3</ref>; <ref loc="PSA 42:4">42:4</ref>; <ref loc="1SA 1:15">1 Sam 1:15</ref>. </char>
    </note> Imwe abantu, mumwesigye buri kaanya;</para>
  <para style="q1" vid="PSA 62:8">Mumugambire byona, mumare omu kashansha;</para>
  <para style="q1" vid="PSA 62:8">Ruhanga n'obuhungiro bwaitu.<verse eid="PSA 62:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:5">Zab 39:5</ref>; <ref loc="PSA 116:11">116:11</ref>. </char>
    </note> Abantu abataine kitiinisa baba omwitsyo kwonka;</para>
  <para style="q1" vid="PSA 62:9">N'abaine ekitiinisa ni busha;</para>
  <para style="q1" vid="PSA 62:9">Ku bateebwa aha minzaani, ebaimutsya;</para>
  <para style="q1" vid="PSA 62:9">Boona hamwe banguhi okukira omwitsyo.<verse eid="PSA 62:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:10-15">Enf 1:10-15</ref>, <ref loc="PRO 1:19">19</ref>; <ref loc="LUK 12:15">Luk 12:15</ref>. </char>
    </note> Mutaryesiga okuhata abandi;</para>
  <para style="q1" vid="PSA 62:10">Mutarigira amatsiko ga busha aha kunyaga.</para>
  <para style="q1" vid="PSA 62:10">Eitungo ku ririkanya, mutariritaho omutima.<verse eid="PSA 62:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 33:14">Yob 33:14</ref>; <ref loc="REV 19:1">Kush 19:1</ref>. </char>
    </note> Ruhanga akagamba rimwe; naakihurira kabiri,</para>
  <para style="q1" vid="PSA 62:11">Ku obushoboorozi buri obwa Ruhanga,<verse eid="PSA 62:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">62:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:8">Zab 103:8</ref>; <ref loc="JOB 34:11">Yob 34:11</ref>; <ref loc="JER 17:10">Yer 17:10</ref>; <ref loc="DAN 9:9">Dan 9:9</ref>; <ref loc="1PE 1:17">1 Pet 1:17</ref>. </char>
    </note> Kandi ku embabazi ziri ezaawe, ai Mukama;</para>
  <para style="q1" vid="PSA 62:12">ahakuba ozimuurira omuntu weena ebishemereire ebi yaakozire.<verse eid="PSA 62:12" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" sid="PSA 63" />
  <para style="s1">Oku Mukama amara eiriho ry'omuntu orikumwetenga</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 63:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 84:2">Zab 84:2</ref>; <ref loc="PSA 143:6">143:6</ref>; <ref loc="ISA 26:9">Isa 26:9</ref>; <ref loc="ISA 32:2">32:2</ref>. </char>
    </note> Ai Ruhanga, niiwe Ruhanga wangye; ndyaimuka kare kukusherura.</para>
  <para style="q1" vid="PSA 63:1">Amagara gangye gakwiniire eiriho; omubiri gwangye nigukwetenga</para>
  <para style="q1" vid="PSA 63:1">Nk'ori omu nsi eyomire, erikurusya, kandi etarimu maizi.<verse eid="PSA 63:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:61">Zab 78:61</ref>. </char>
    </note> Okwo nikwo nkuhangire amaisho omu mwanya gwawe ogurikwera,</para>
  <para style="q1" vid="PSA 63:2">Ngu nkaareeba obushoboorozi bwawe n'ekitiinisa kyawe.<verse eid="PSA 63:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3" />Ahakuba embabazi zaawe ni nungi okukira amagara,</para>
  <para style="q1" vid="PSA 63:3">Eminwa yangye eryakuhimbisa.<verse eid="PSA 63:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:2">Zab 28:2</ref>; <ref loc="PSA 104:33">104:33</ref>. </char>
    </note> N'ahabw'ekyo ndyakusiima nkiri ohuriire;</para>
  <para style="q1" vid="PSA 63:4">Nyimutsye emikono yangye nintakira eiziina ryawe.<verse eid="PSA 63:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:8">Zab 36:8</ref>. </char>
    </note> Amagara gangye garyahaaga nk'oriire omushokooro n'ebishaju,</para>
  <para style="q1" vid="PSA 63:5">N'akanwa kangye karyakuhimbisa n'eminwa eshemereirwe,<verse eid="PSA 63:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:8">Zab 42:8</ref>; <ref loc="PSA 119:148">119:148</ref>. </char>
    </note> Ku ndikukwijuka ndi aha kitabo kyangye,</para>
  <para style="q1" vid="PSA 63:6">Naakuteekateekaho omu kusisiimuka kwa nyekiro;<verse eid="PSA 63:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:8">Zab 17:8</ref>. </char>
    </note> Ahakuba okaba ori omuhwezi wangye;</para>
  <para style="q1" vid="PSA 63:7">Kandi omunda y'amapapa gaawe nimwo ndyeshongorera ahabw'okushemererwa.<verse eid="PSA 63:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:12">Zab 41:12</ref>; <ref loc="NUM 14:24">Kub 14:24</ref>. </char>
    </note> Amagara gangye niiwe geegamiire;</para>
  <para style="q1" vid="PSA 63:8">Omukono gwawe gwa buryo gunkwatirira;<verse eid="PSA 63:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:15">Zab 55:15</ref>; <ref loc="EZK 31:14">Ezk 31:14</ref>; <ref loc="EPH 4:9">Efe 4:9</ref>. </char>
    </note> Kwonka abahiiga amagara gangye kumpwerekyereza,</para>
  <para style="q1" vid="PSA 63:9">Baryaza okuzimu omu itaka.<verse eid="PSA 63:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10" />Baryaheebwayo baitwe rurara;</para>
  <para style="q1" vid="PSA 63:10">Baryaba omugabo gw'emishega.<verse eid="PSA 63:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">63:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:42">Zab 107:42</ref>; <ref loc="ISA 65:16">Isa 65:16</ref>; <ref loc="JOB 5:16">Yob 5:16</ref>; <ref loc="DEU 6:13">Bir 6:13</ref>. </char>
    </note> Kwonka omugabe aryashemerererwa omuri Ruhanga;</para>
  <para style="q1" vid="PSA 63:11">Weena orikumurahira aryayesiima;</para>
  <para style="q1" vid="PSA 63:11">ahakuba akanwa k'ababeihi karyaigarwa.<verse eid="PSA 63:11" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" sid="PSA 64" />
  <para style="s1">Okushaba okurindwa abazigu abarikuturwanisa bwesherekye</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 64:1" />Hurira eiraka ry'okuganya kwangye, ai Ruhanga;</para>
  <para style="q1" vid="PSA 64:1">Okize amagara gangye okutiina abazigu.<verse eid="PSA 64:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2" />Onsherekye enaama, ezi ababi barikungirira,</para>
  <para style="q1" vid="PSA 64:2">N'okujagarara kw'enkozi z'ebibi,<verse eid="PSA 64:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:4">Zab 57:4</ref>. </char>
    </note> Abatyaza endimi zaabo nka rurara,</para>
  <para style="q1" vid="PSA 64:3">Bakatamika emyambi yaabo, nibyo bigambo byabo ebirikushaarira,<verse eid="PSA 64:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:2">Zab 11:2</ref>. </char>
    </note> Ngu babone kurasha otaine rubanja, bamugwereire;</para>
  <para style="q1" vid="PSA 64:4">Barahuka kumurasha, batarikutiina.<verse eid="PSA 64:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:5">Zab 140:5</ref>; <ref loc="JOB 22:13">Yob 22:13</ref>; <ref loc="EZK 13:22">Ezk 13:22</ref>. </char>
    </note> Beegumiza omu naama zaabo mbi;</para>
  <para style="q1" vid="PSA 64:5">Bahanuura kutega emitego omu mubonano,</para>
  <para style="q1" vid="PSA 64:5">Nibagira bati: N'oha orikwija kutureeba?<verse eid="PSA 64:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6" />N'oha orikubaasa kuzoora ebibi byaitu?</para>
  <para style="q1" vid="PSA 64:6">Ahakuba enaama ezi tugizire n'ez'obwengye.</para>
  <para style="q1" vid="PSA 64:6">Manya, ebiteekateeko by'omu mutima gw'omuntu biri hare!<verse eid="PSA 64:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7" />Kwonka Ruhanga aryabarasha;</para>
  <para style="q1" vid="PSA 64:7">Abahutaaze ahonaaho;<verse eid="PSA 64:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:13">Enf 12:13</ref>; <ref loc="PRO 18:7">18:7</ref>; <ref loc="JER 48:27">Yer 48:27</ref>. </char>
    </note> Atyo abamareho, bazire orurimi rwabo;</para>
  <para style="q1" vid="PSA 64:8">Boona abaribareeba baryazongoza emitwe.<verse eid="PSA 64:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:28">Yer 50:28</ref>; <ref loc="JER 51:10">51:10</ref>. </char>
    </note> Obwo nibwo abantu boona baritiina,</para>
  <para style="q1" vid="PSA 64:9">Bakamanyisa omurimo gwa Ruhanga.</para>
  <para style="q1" vid="PSA 64:9">Kandi bakateekateeka munonga aha bi yaakozire.<verse eid="PSA 64:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">64:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:11">Zab 32:11</ref>. </char>
    </note> Abahikiriire baryashemerererwa omuri MUKAMA, bamwesigye;</para>
  <para style="q1" vid="PSA 64:10">Boona abaine emitima egororokire beesiime.<verse eid="PSA 64:10" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" sid="PSA 65" />
  <para style="s1">Okusiima Ruhanga okutuha eby'okututunga byona</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi ei baayeshongoire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 65:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>. </char>
    </note> Ai Ruhanga, okuhimbisibwa kukushemereire omuri Saayuni;</para>
  <para style="q1" vid="PSA 65:1">Kandi niiwe barihikiiririzaho ebi baaraganiise nibahiga.<verse eid="PSA 65:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:9">Zab 86:9</ref>; <ref loc="2KI 19:20">2 Bag 19:20</ref>; <ref loc="ISA 66:23">Isa 66:23</ref>. </char>
    </note> Iwe ohurira okushaba, abantu boona baryaija ah'ori.<verse eid="PSA 65:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:4">Zab 38:4</ref>; <ref loc="PSA 79:9">79:9</ref>; <ref loc="ISA 6:7">Isa 6:7</ref>. </char>
    </note> Eby'okutahikiirira n'obu biraabe nibituremesa,</para>
  <para style="q1" vid="PSA 65:3">Kwonka Iwe otusaasire eby'okushiisha byaitu.<verse eid="PSA 65:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:12">Zab 33:12</ref>; <ref loc="PSA 84:4">84:4</ref>. </char>
    </note> Aine omugisha ou otoorana, okamwiriza haihi, kuguma omu bikaari byawe.</para>
  <para style="q1" vid="PSA 65:4">Turyahaagibwa oburungi bw'omu nju yaawe,</para>
  <para style="q1" vid="PSA 65:4">Omwanya ogurikwera omuri hekalu yaawe.<verse eid="PSA 65:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Zab 22:27</ref>; <ref loc="DEU 10:21">Bir 10:21</ref>; <ref loc="2SA 7:23">2 Sam 7:23</ref>. </char>
    </note> Omu kuhikiirira kwawe oryatugarukamu n'ebirikutiinisa,</para>
  <para style="q1" vid="PSA 65:5">Ai Ruhanga ow'okujunwa kwaitu;</para>
  <para style="q1" vid="PSA 65:5">Niiwe matsiko g'abari aha muheru gw'ensi,</para>
  <para style="q1" vid="PSA 65:5">N'abari hare aha nyanja.<verse eid="PSA 65:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 93:1">Zab 93:1</ref>. </char>
    </note> Niiwe waagumize ebibungo,</para>
  <para style="q1" vid="PSA 65:6">Oyezirikire amaani gaawe;<verse eid="PSA 65:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:9">Zab 89:9</ref>; <ref loc="ISA 17:12">Isa 17:12</ref>, <ref loc="ISA 17:13">13</ref>; <ref loc="MRK 4:39">Mak 4:39</ref>. </char>
    </note> Niiwe ocureeza okuhoorera kw'enyanja n'okw'ebingonzi byayo,</para>
  <para style="q1" vid="PSA 65:7">Kandi n'okujagarara kw'amahanga;<verse eid="PSA 65:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8" />N'ahabw'ekyo abatuura aha muheru gw'ensi</para>
  <para style="q1" vid="PSA 65:8">Batiina, baareeba obumanyiso bwawe;</para>
  <para style="q1" vid="PSA 65:8">Ku butsya bwaira, oreetera akasheeshe n'omwabazyo</para>
  <para style="q1" vid="PSA 65:8">Kuteera akaari k'okushemererwa.<verse eid="PSA 65:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:4">Zab 46:4</ref>; <ref loc="PSA 68:9">68:9</ref>; <ref loc="PSA 147:14">147:14</ref>; <ref loc="LEV 26:4">Lev 26:4</ref>. </char>
    </note> Otaayaayira ensi, kandi ogigwisiza enjura,</para>
  <para style="q1" vid="PSA 65:9">Ngu ogihindure erikweza munonga.</para>
  <para style="q1" vid="PSA 65:9">Omugyera gwa Ruhanga gwijwire amaizi.</para>
  <para style="q1" vid="PSA 65:9">Niiwe obatungira oburo,</para>
  <para style="q1" vid="PSA 65:9">Waaheza kushemeza otyo eitaka.<verse eid="PSA 65:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:10">Yob 5:10</ref>. </char>
    </note> Niiwe oshukyerera empazo zaayo amaizi maingi,</para>
  <para style="q1" vid="PSA 65:10">Okaringaniza emigongo yaayo,</para>
  <para style="q1" vid="PSA 65:10">Okagyorobya n'orutoonyerera,</para>
  <para style="q1" vid="PSA 65:10">Okaha omugisha ebigimeramu.<verse eid="PSA 65:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:13">Zab 104:13</ref>. </char>
    </note> Ojweka omwaka ekirunga ky'oburungi bwawe;</para>
  <para style="q1" vid="PSA 65:11">Ebigaari byawe bigyenda nibisheesha omweru;<verse eid="PSA 65:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:26">Yob 38:26</ref>, <ref loc="JOB 38:27">27</ref>; <ref loc="JOL 2:22">Yoel 2:22</ref>. </char>
    </note> Niguragarika omu mariisizo g'omu ihamba,</para>
  <para style="q1" vid="PSA 65:12">Ebibungo byezirika okushemererwa;<verse eid="PSA 65:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">65:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:8">Zab 98:8</ref>; <ref loc="ISA 30:23">Isa 30:23</ref>; <ref loc="ISA 44:23">44:23</ref>. </char>
    </note> Amariisizo gashwekwa amagana,</para>
  <para style="q1" vid="PSA 65:13">N'empanga zishwekwa oburo,</para>
  <para style="q1" vid="PSA 65:13">Ziteera akaari k'okushemererwa, kandi zeeshongora.<verse eid="PSA 65:13" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" sid="PSA 66" />
  <para style="s1">Okusiima Ruhanga ahabw'eby'okutangaaza ebi yaatukoreire</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi y'okweshongorwa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 66:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:4">Zab 98:4</ref>. </char>
    </note> Iwe ensi yoona, teerera Ruhanga akaari k'okushemererwa;<verse eid="PSA 66:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:12">Isa 42:12</ref>. </char>
    </note> Oyeshongore eby'okuhimbisa eiziina rye,</para>
  <para style="q1" vid="PSA 66:2">N'okuhimbisibwa kwe okuhe ekitiinisa.<verse eid="PSA 66:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:44">Zab 18:44</ref>; <ref loc="PSA 65:5">65:5</ref>. </char>
    </note> Ogire Ruhanga oti: Emirimo yaawe ka n'ey'okutiinisa!</para>
  <para style="q1" vid="PSA 66:3">Ahabw'amaani gaawe maingi abazigu baawe baryakugomokyera.<verse eid="PSA 66:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4" />Ab'ensi yoona baryakuramya, bakweshongorere,</para>
  <para style="q1" vid="PSA 66:4">Beeshongore eby'okuhimbisa eiziina ryawe.<verse eid="PSA 66:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:8">Zab 46:8</ref>. </char>
    </note> Mwije mureebe emirimo ya Ruhanga;</para>
  <para style="q1" vid="PSA 66:5">N'ow'okutiinisa omu bi akorera abantu.<verse eid="PSA 66:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Kur 14:21</ref>; <ref loc="JOS 3:17">Yos 3:17</ref>; <ref loc="JOS 4:23">4:23</ref>; <ref loc="ISA 63:12">Isa 63:12</ref>. </char>
    </note> Akahindura enyanja ensi eyomire,</para>
  <para style="q1" vid="PSA 66:6">Abantu baaraba omu mugyera n'ebigyere;</para>
  <para style="q1" vid="PSA 66:6">Okwo niyo twamusiimiire munonga.<verse eid="PSA 66:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7" />Ategyekyesa obushoboorozi ebiro byona;</para>
  <para style="q1" vid="PSA 66:7">Amaisho ge agatuuza aha mahanga.</para>
  <para style="q1" vid="PSA 66:7">Abagomi beerinde, barekye kwetunguura.<verse eid="PSA 66:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8" />Imwe mahanga 'mwe, muhe Ruhanga waitu ekitiinisa,</para>
  <para style="q1" vid="PSA 66:8">Amaraka agarikumuhimbisa gahurirwe;<verse eid="PSA 66:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 121:3">Zab 121:3</ref>. </char>
    </note> Ahakuba aturinda tuguma turi abahuriire,</para>
  <para style="q1" vid="PSA 66:9">Kandi taikiriza bigyere byaitu kuterera.<verse eid="PSA 66:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 23:10">Yob 23:10</ref>; <ref loc="ZEC 13:9">Zek 13:9</ref>. </char>
    </note> Iwe Ruhanga, okatugyeza,</para>
  <para style="q1" vid="PSA 66:10">Waaturabya omu iziiko, nk'oku bagira efeeza.<verse eid="PSA 66:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:11: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 1:13">Tonz 1:13</ref>; <ref loc="EZK 12:13">Ezk 12:13</ref>. </char>
    </note> Okatutooza ekigoye;</para>
  <para style="q1" vid="PSA 66:11">Waatuhatisa ebirikutusaasa omu manyaanya.<verse eid="PSA 66:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 43:2">Isa 43:2</ref>; <ref loc="ISA 51:23">51:23</ref>. </char>
    </note> Waikiriza abantu kuturibatiirira, batembire embaraasi;</para>
  <para style="q1" vid="PSA 66:12">Tukaraba omu muriro n'omu maizi,</para>
  <para style="q1" vid="PSA 66:12">Kwonka waatuhitsya omu mwanya ogwine obweshanziro.<verse eid="PSA 66:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>. </char>
    </note> Niinyija kutaaha omu nju yaawe n'ebitambo ebyokize,</para>
  <para style="q1" vid="PSA 66:13">Mpikiirize ebi naaraganiise nindahira,<verse eid="PSA 66:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Zab 18:6</ref>. </char>
    </note> Ebi eminwa yangye yaagambire,</para>
  <para style="q1" vid="PSA 66:14">N'ebi akanwa kangye kaaraganiise, obu naareeba enaku.<verse eid="PSA 66:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15" />Niinyija kukuha ebitambo byokize eby'ebishaju,</para>
  <para style="q1" vid="PSA 66:15">N'ekisooroora ky'ebitambo by'empaya y'entaama,</para>
  <para style="q1" vid="PSA 66:15">Nkuhongyere enimi n'embuzi.<verse eid="PSA 66:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16" />Imwe abatiina Ruhanga, mwije muhurire,</para>
  <para style="q1" vid="PSA 66:16">Mbagambire ebi yaakoreire amagara gangye.<verse eid="PSA 66:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17" />Nkamutakira munonga n'akanwa kangye,</para>
  <para style="q1" vid="PSA 66:17">N'orurimi rwangye rwamuhimbisa.<verse eid="PSA 66:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:18: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:9">Enf 28:9</ref>; <ref loc="ISA 1:15">Isa 1:15</ref>; <ref loc="ISA 59:2">59:2</ref>; <ref loc="JHN 9:31">Yoh 9:31</ref>. </char>
    </note> Kuri naataire omutima aha by'okutahikiirira,</para>
  <para style="q1" vid="PSA 66:18">Mukama takumpuriire.<verse eid="PSA 66:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">66:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:1">Zab 116:1</ref>, <ref loc="PSA 116:2">2</ref>. </char>
    </note> Kwonka buzima Ruhanga akahurira,</para>
  <para style="q1" vid="PSA 66:19">Yaata omutima aha iraka ry'okushaba kwangye.<verse eid="PSA 66:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20" />Ruhanga asiimwe, ahakuba tayangire kuhurira kushaba kwangye,</para>
  <para style="q1" vid="PSA 66:20">Kandi taanyihireho kukunda kwe.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" sid="PSA 67" />
  <para style="s1">Amahanga goona oku gashemereire kusiima Ruhanga</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi eyaayeshongoirwe n'enanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 67:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">67:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:6">Zab 4:6</ref>; <ref loc="NUM 6:25">Kub 6:25</ref>. </char>
    </note> Ruhanga atugirire embabazi, atuhe omugisha,</para>
  <para style="q1" vid="PSA 67:1">Atwakize amaisho ge,<verse eid="PSA 67:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">67:2: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 2:30-32">Luk 2:30-32</ref>; <ref loc="ACT 18:25">Byak 18:25</ref>, <ref loc="ACT 18:26">26</ref>; <ref loc="TIT 2:11">Tit 2:11</ref>. </char>
    </note> Omuhanda gwawe gubone kumanywa omu nsi,</para>
  <para style="q1" vid="PSA 67:2">N'amaani gaawe agarikujuna gamanywe omu mahanga goona.<verse eid="PSA 67:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3" />Abantu bakuhimbise, ai Ruhanga;</para>
  <para style="q1" vid="PSA 67:3">K'abantu boona bakuhimbise!<verse eid="PSA 67:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">67:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:8">Zab 9:8</ref>. </char>
    </note> Amahanga geesiime, geeshongore ahabw'okushemererwa;</para>
  <para style="q1" vid="PSA 67:4">Ahabw'okuba ocwera abantu emanja omu bwinganisa,</para>
  <para style="q1" vid="PSA 67:4">Kandi oyebembera amahanga agari omu nsi.<verse eid="PSA 67:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5" />Abantu bakuhimbise, ai Ruhanga;</para>
  <para style="q1" vid="PSA 67:5">K'abantu boona bakuhimbise!<verse eid="PSA 67:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">67:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:12">Zab 85:12</ref>; <ref loc="LEV 26:4">Lev 26:4</ref>; <ref loc="EZK 34:27">Ezk 34:27</ref>. </char>
    </note> Ensi ereetsire omweru gwayo,</para>
  <para style="q1" vid="PSA 67:6">Ruhanga, Ruhanga waitu, atuhaire omugisha.<verse eid="PSA 67:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">67:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Zab 22:27</ref>. </char>
    </note> Ruhanga aryatuha omugisha;</para>
  <para style="q1" vid="PSA 67:7">Kandi boona ab'aha muheru gw'ensi baryamutiina.<verse eid="PSA 67:7" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" sid="PSA 68" />
  <para style="s1">Ekyeshongoro ky'okusiima ahabw'obusinguzi bwa Mukama</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi ei yaayeshongoire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 68:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:9">Zab 92:9</ref>; <ref loc="NUM 10:35">Kub 10:35</ref>; <ref loc="ISA 33:3">Isa 33:3</ref>. </char>
    </note> Ka Ruhanga aimukye, abazigu be bataataane!</para>
  <para style="q1" vid="PSA 68:1">N'abarikumwanga bamuhungye.<verse eid="PSA 68:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:5">Zab 97:5</ref>; <ref loc="MIC 1:4">Mik 1:4</ref>. </char>
    </note> Obatuntumure nk'omwika;</para>
  <para style="q1" vid="PSA 68:2">Ababi bahwerekyererere omu maisho ga Ruhanga,</para>
  <para style="q1" vid="PSA 68:2">Nk'oku entsinda eyagira aha muriro;<verse eid="PSA 68:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3" />Kwonka abahikiriire bo bananukye;</para>
  <para style="q1" vid="PSA 68:3">Beesime munonga omu maisho ge;</para>
  <para style="q1" vid="PSA 68:3">Eego, bashemererwe n'okunanuka.<verse eid="PSA 68:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:4">Zab 66:4</ref>; <ref loc="PSA 89:8">89:8</ref>; <ref loc="ISA 40:3">Isa 40:3</ref>; <ref loc="ISA 57:14">57:14</ref>; <ref loc="HAB 3:8">Hab 3:8</ref>. </char>
    </note> Mweshongorere Ruhanga, mweshongore eby'okuhimbisa eiziina rye;</para>
  <para style="q1" vid="PSA 68:4">Mwimutsye amaraka, mweshongorere Ogwo ogyendera aha bicu;</para>
  <para style="q1" vid="PSA 68:4">Eiziina rye ni Yehova; mwesiimire munonga omu maisho ge!<verse eid="PSA 68:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:14">Zab 10:14</ref>; <ref loc="DEU 10:18">Bir 10:18</ref>. </char>
    </note> Ruhanga omu mwanya gwe ogurikwera ogu atuuramu</para>
  <para style="q1" vid="PSA 68:5">N'ishe w'efuuzi kandi omucwi w'emanja w'abafaakazi.<verse eid="PSA 68:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:33">Zab 107:33</ref>; <ref loc="PSA 146:7">146:7</ref>; <ref loc="1SA 2:5">1 Sam 2:5</ref>; <ref loc="ACT 12:7">Byak 12:7</ref>; <ref loc="ACT 16:26">16:26</ref>. </char>
    </note> Ruhanga aha amaka abataine ifo na ruguru;</para>
  <para style="q1" vid="PSA 68:6">Abohoorora embohe, ngu zitungye ebirungi,</para>
  <para style="q1" vid="PSA 68:6">Kwonka abagomi batuura omu nsi eyomire.<verse eid="PSA 68:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Kur 13:21</ref>; <ref loc="JDG 4:14">Bar 4:14</ref>. </char>
    </note> Ai Ruhanga, obu waayebembera abantu baawe,</para>
  <para style="q1" vid="PSA 68:7">Nooraba omu ihamba,<verse eid="PSA 68:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:18">Kur 19:18</ref>; <ref loc="JDG 5:4">Bar 5:4</ref>. </char>
    </note> Ensi ekatengyeta, eiguru ryagwisa enjura ahabw'okwija kwawe,</para>
  <para style="q1" vid="PSA 68:8">Na Sinai yaatengyeta ahabw'okwija kwawe, iwe Ruhanga wa Israeli.<verse eid="PSA 68:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:9, 10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:9">Zab 65:9</ref>, <ref loc="PSA 65:10">10</ref>. </char>
    </note> Ai Ruhanga, okagwisa enjura y'omugisha aha buhunguzi bwawe,</para>
  <para style="q1" vid="PSA 68:9">Waabugaruramu amaani buruhire.<verse eid="PSA 68:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10" />Abantu baawe baabubonamu obutaaho;</para>
  <para style="q1" vid="PSA 68:10">Omu burungi bwawe, ai Ruhanga, waatungira abakyene eby'okubahwera.<verse eid="PSA 68:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:9">Zab 33:9</ref>; <ref loc="1SA 18:6">1 Sam 18:6</ref>; <ref loc="EXO 15:20">Kur 15:20</ref>. </char>
    </note> Mukama aha ekiragiro,</para>
  <para style="q1" vid="PSA 68:11">Abakazi abarikutwara amakuru n'eihe rihango.<verse eid="PSA 68:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 10:16">Yos 10:16</ref>; <ref loc="JDG 5:30">Bar 5:30</ref>. </char>
    </note> Abagabe b'amahe bahunga, eego bahunga;</para>
  <para style="q1" vid="PSA 68:12">Abakazi abatsigara omuka babagana eminyago.<verse eid="PSA 68:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:13: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 5:16">Bar 5:16</ref>. </char>
    </note> Ahabw'enki muraara omu kibuga ky'entaama,</para>
  <para style="q1" vid="PSA 68:13">Nk'amapapa g'enkombe agashwekirwe efeeza,</para>
  <para style="q1" vid="PSA 68:13">N'ebyoya byayo ebishwekirwe ezaabu?<verse eid="PSA 68:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14" />Obu Ow'obushoboorozi bwona yaabinga abakama baabo, bakataataana,</para>
  <para style="q1" vid="PSA 68:14">Orubaare rukaba nirugwa ahari Salumooni.<verse eid="PSA 68:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15" />Iwe orushozi rw'amaani, orushozi rwa Bashani,</para>
  <para style="q1" vid="PSA 68:15">Iwe orushozi rwa Bashani orwine emitwe mingi,<verse eid="PSA 68:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:13">Zab 132:13</ref>, <ref loc="PSA 132:14">14</ref>. </char>
    </note> Imwe enshozi ndaingwa, ahabw'enki mureebesa eihari</para>
  <para style="q1" vid="PSA 68:16">Orushozi oru Ruhanga yaasiimire kutuuraho?</para>
  <para style="q1" vid="PSA 68:16">N'ekya buzima, MUKAMA aryarutuuraho ebiro byona.<verse eid="PSA 68:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:17: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 6:17">2 Bag 6:17</ref>. </char>
    </note> Ebigaari bya Ruhanga n'obukumi bubiri,</para>
  <para style="q1" vid="PSA 68:17">Enkumi n'enkumi;</para>
  <para style="q1" vid="PSA 68:17">Mukama akaija omu Mwanya ogurikwera, naaruga Sinai.<verse eid="PSA 68:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:18: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 5:12">Bar 5:12</ref>; <ref loc="ACT 1:9">Byak 1:9</ref>; <ref loc="EPH 4:8">Efe 4:8</ref>; <ref loc="REV 21:3">Kush 21:3</ref>. </char>
    </note> Okatemba orushozi ruraingwa,</para>
  <para style="q1" vid="PSA 68:18">Nootwara abu waanyagire bakukuratiire,</para>
  <para style="q1" vid="PSA 68:18">N'abandi bantu baakureetera emitoijo,</para>
  <para style="q1" vid="PSA 68:18">Nangwa n'omu bagomi nabo,</para>
  <para style="q1" vid="PSA 68:18">Ngu MUKAMA Ruhanga abone kutuura omuribo.<verse eid="PSA 68:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 46:4">Isa 46:4</ref>. </char>
    </note> Mukama asiimwe, otwekorerera emitwaro obutoosha,</para>
  <para style="q1" vid="PSA 68:19">Ruhanga ow'okujunwa kwaitu.<verse eid="PSA 68:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:20: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:39">Bir 32:39</ref>; <ref loc="REV 1:18">Kush 1:18</ref>. </char>
    </note> Ruhanga waitu ni Ruhanga orikujuna;</para>
  <para style="q1" vid="PSA 68:20">Ahari Yehova Mukama niho haruga okukira okufa.<verse eid="PSA 68:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:6">Zab 110:6</ref>. </char>
    </note> Kwonka Ruhanga aryayatagura emitwe y'abazigu be,</para>
  <para style="q1" vid="PSA 68:21">Kandi ahutaaze ekikoba ky'omutwe gw'ogwo orikugumira omu kushobya kwe.<verse eid="PSA 68:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:22: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:33-35">Kub 21:33-35</ref>. </char>
    </note> Mukama akagira ati: Ndyabagarura barugye Bashani,</para>
  <para style="q1" vid="PSA 68:22">Ndyabagarura mbaihe okuzimu ahagati y'enyanja,<verse eid="PSA 68:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 58:10">Zab 58:10</ref>; <ref loc="1KI 22:38">1 Bag 22:38</ref>. </char>
    </note> Ngu obone kwozya ebigyere byawe omu shagama,</para>
  <para style="q1" vid="PSA 68:23">Kandi ngu endimi z'embwa zaawe zitungye omugabo gwazo omu bazigu.<verse eid="PSA 68:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24" />Bareebire emigyendere yaawe, ai Ruhanga, Ruhanga wangye kandi Mukama wangye,</para>
  <para style="q1" vid="PSA 68:24">Okuratiirwe abantu baawe nootaaha omu Mwanya ogurikwera;<verse eid="PSA 68:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:25: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:20">Kur 15:20</ref>; <ref loc="1CH 13:8">1 Bus 13:8</ref>; <ref loc="1CH 15:16">15:16</ref>. </char>
    </note> Abeeshongozi beebembeire, abateezi b'enanga bari enyima;</para>
  <para style="q1" vid="PSA 68:25">N'ahagati yaabo hariho abaishiki nibateera ebitaasa.<verse eid="PSA 68:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:12">Zab 26:12</ref>; <ref loc="ISA 48:1">Isa 48:1</ref>; <ref loc="DEU 33:28">Bir 33:28</ref>. </char>
    </note> Muhimbise Ruhanga omu iteeraniro rihango ry'abantu;</para>
  <para style="q1" vid="PSA 68:26">Muhimbise MUKAMA, imwe abaakomookire omu ihanga rya Israeli!<verse eid="PSA 68:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:27: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 5:18">Bar 5:18</ref>; <ref loc="1SA 9:21">1 Sam 9:21</ref>. </char>
    </note> Benyamiini bucuracuriro abari omu mutwe,</para>
  <para style="q1" vid="PSA 68:27">Abanyiginya ba Yuda n'omutwe muhango,</para>
  <para style="q1" vid="PSA 68:27">Abanyiginya ba Zebuluuni, abanyiginya ba Nafutaali.<verse eid="PSA 68:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28" />Ragiira amaani gaawe, ai Ruhanga;</para>
  <para style="q1" vid="PSA 68:28">Ohamye ebi waatukoreire.<verse eid="PSA 68:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:29: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 32:23">2 Bus 32:23</ref>; <ref loc="ISA 18:7">Isa 18:7</ref>. </char>
    </note> Abagabe bakureetera emitoijo,</para>
  <para style="q1" vid="PSA 68:29">ahabwa hekalu yaawe, eri omuri Yerusaalemu,<verse eid="PSA 68:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:30: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:12">Zab 22:12</ref>; <ref loc="JOB 40:21">Yob 40:21</ref>; <ref loc="2SA 8:2">2 Sam 8:2</ref>, <ref loc="2SA 8:6">6</ref>. </char>
    </note> Hana n'amaani enyamaishwa z'omu rufunjo,</para>
  <para style="q1" vid="PSA 68:30">Eigana ry'enimi n'enyana z'amahanga;</para>
  <para style="q1" vid="PSA 68:30">Oribatiirire abantu abaine omururu gw'okutoijesa agandi mahanga;</para>
  <para style="q1" vid="PSA 68:30">Otaataanise amahanga agakunda kurwana.<verse eid="PSA 68:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31" />Abanyiginya baryaruga Misiri;</para>
  <para style="q1" vid="PSA 68:31">Na Esiopia eryarahuka kutega Ruhanga emikono.<verse eid="PSA 68:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32" />Imwe obugabe bwona obw'ensi, mweshongorere Ruhanga,</para>
  <para style="q1" vid="PSA 68:32">Mweshongore eby'okuhimbisa Mukama,<verse eid="PSA 68:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:33, 34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1">Zab 29:1</ref>, <ref loc="PSA 29:4">4</ref>; <ref loc="PSA 150:1">150:1</ref>; <ref loc="DEU 10:14">Bir 10:14</ref>; <ref loc="DEU 33:26">33:26</ref>. </char>
    </note> Orikutemba ahaiguru y'eiguru omu iguru erya ira.</para>
  <para style="q1" vid="PSA 68:33">Reeba, naagamba n'eiraka rihango, n'eiraka rye ery'amaani.<verse eid="PSA 68:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34" />Mugambe ku Ruhanga aine amaani;</para>
  <para style="q1" vid="PSA 68:34">Ategyeka Israeli omu kitiinisa ky'obukama bwe,</para>
  <para style="q1" vid="PSA 68:34">Kandi amaani ge gari omu bicu.<verse eid="PSA 68:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">68:35: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:11">Zab 29:11</ref>; <ref loc="ISA 40:29">Isa 40:29</ref>. </char>
    </note> Ruhanga n'Ow'okutiinisa omu Mwanya gwe ogurikwera;</para>
  <para style="q1" vid="PSA 68:35">Ruhanga wa Israeli niwe aha abantu be obushoboorozi n'amaani.</para>
  <para style="q1" vid="PSA 68:35">Ruhanga asiimwe!<verse eid="PSA 68:35" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" sid="PSA 69" />
  <para style="s1">Okushaba kw'omuntu ori omu busaasi</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Omu iraka eririkwetwa Emyangangye. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 69:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:6">Zab 32:6</ref>. </char>
    </note> Njuna, ai Ruhanga;</para>
  <para style="q1" vid="PSA 69:1">Ahakuba amaizi nigenda kuunyita;<verse eid="PSA 69:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:2">Zab 40:2</ref>; <ref loc="PSA 124:4">124:4</ref>. </char>
    </note> Ninshaaya omu byondo bingi,</para>
  <para style="q1" vid="PSA 69:2">Ebi ntarikubaasa kuhamyamu bigyere;</para>
  <para style="q1" vid="PSA 69:2">Naahika omu maizi maraingwa,</para>
  <para style="q1" vid="PSA 69:2">Ahi amaizi agaijwire garikummirira.<verse eid="PSA 69:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:6">Zab 6:6</ref>; <ref loc="PSA 119:123">119:123</ref>; <ref loc="ISA 38:14">Isa 38:14</ref>. </char>
    </note> Okurira kunduhize; amaraka ganzindaire;</para>
  <para style="q1" vid="PSA 69:3">Amaisho gangye gahotokire ahabw'okutegyereza Ruhanga wangye.<verse eid="PSA 69:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:19">Zab 38:19</ref>; <ref loc="PSA 40:12">40:12</ref>; <ref loc="JHN 15:25">Yoh 15:25</ref>. </char>
    </note> Abarikuunyangira busha ni baingi okukira eishokye ry'aha mutwe gwangye;</para>
  <para style="q1" vid="PSA 69:4">Abazigu bangye abarikwenda kuunyitira busha n'ab'amaani.</para>
  <para style="q1" vid="PSA 69:4">Nshemereire kuriha ebi ntaraibire?<verse eid="PSA 69:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5" />Ai Ruhanga, noomanya obushema bwangye;</para>
  <para style="q1" vid="PSA 69:5">N'ebibi byangye tibikusherekirwe.<verse eid="PSA 69:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6" />Abarikukwesiga, Mukama RUHANGA ow'amahe,</para>
  <para style="q1" vid="PSA 69:6">Barekye kukwatwa enshoni ahabwangye;</para>
  <para style="q1" vid="PSA 69:6">Abarikukusherura, ai Ruhanga wa israeli,</para>
  <para style="q1" vid="PSA 69:6">Batahemurwa ahabwangye.<verse eid="PSA 69:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 15:15">Yer 15:15</ref>. </char>
    </note> Ahakuba ahabwawe nyemeire okujumwa,</para>
  <para style="q1" vid="PSA 69:7">N'enshoni zinshwekire ahamaisho.<verse eid="PSA 69:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:13">Yob 19:13</ref>; <ref loc="ISA 53:3">Isa 53:3</ref>; <ref loc="JHN 1:11">Yoh 1:11</ref>. </char>
    </note> Mpindukire otarikumanywa ahari beene tata,</para>
  <para style="q1" vid="PSA 69:8">n'omunyaihanga aha baana ba maawe.<verse eid="PSA 69:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:41">Zab 89:41</ref>, <ref loc="PSA 89:50">50</ref>; <ref loc="PSA 119:139">119:139</ref>; <ref loc="JHN 2:17">Yoh 2:17</ref>; <ref loc="ROM 15:3">Rom 15:3</ref>. </char>
    </note> Okusaasibwa enju yaawe kummazireho,</para>
  <para style="q1" vid="PSA 69:9">kandi ebijumo ebi barikukujuma niinye bigwereire.<verse eid="PSA 69:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10" />Ku naarizire, naayeburabuza niinyesiibyakwo,</para>
  <para style="q1" vid="PSA 69:10">Kyampindukira ekijumo.<verse eid="PSA 69:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:13">Zab 35:13</ref>; <ref loc="JOB 17:6">Yob 17:6</ref>. </char>
    </note> Ku naahindwire ekiguniya eky'okujwara,</para>
  <para style="q1" vid="PSA 69:11">Bampindura eky'okucweraho enfumu.<verse eid="PSA 69:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:12: </char>
      <char style="xt" closed="false">
        <ref loc="RUT 4:1">Rus 4:1</ref>; <ref loc="JOB 30:9">Yob 30:9</ref>; <ref loc="LAM 3:14">Tonz 3:14</ref>. </char>
    </note> Ndi ekigaaniiro ky'abashutama aha irembo,</para>
  <para style="q1" vid="PSA 69:12">Kandi ekyeshongoro ky'abasinzi.<verse eid="PSA 69:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:8">Isa 49:8</ref>. </char>
    </note> Kwonka nyowe, ai MUKAMA, niiwe nshaba.</para>
  <para style="q1" vid="PSA 69:13">Omu bunaku oburikwikiririzibwamu, ai Ruhanga,</para>
  <para style="q1" vid="PSA 69:13">ahabw'embabazi zaawe nyingi ongarukyemu.<verse eid="PSA 69:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:1">Zab 69:1</ref>, <ref loc="PSA 69:2">2</ref>; <ref loc="PSA 144:7">144:7</ref>. </char>
    </note> Ahabw'okuhwera kwawe okurikwesigwa onjune,</para>
  <para style="q1" vid="PSA 69:14">Ntashaayira omu byondo;</para>
  <para style="q1" vid="PSA 69:14">Nkire abarikuunyanga, kandi ndugye omu maizi maraingwa.<verse eid="PSA 69:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15" />Otaikiriza omwegyemure kuntwara,</para>
  <para style="q1" vid="PSA 69:15">N'obu kwakuba okumirirwa ahagati y'amaizi maingi;</para>
  <para style="q1" vid="PSA 69:15">Kandi otaikiriza Ekiina kunkingirana omu kanwa kaakyo.<verse eid="PSA 69:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:3">Zab 63:3</ref>; <ref loc="PSA 106:45">106:45</ref>. </char>
    </note> Ongarukyemu, ai MUKAMA ahabw'okuba embabazi zaawe ni nungi;</para>
  <para style="q1" vid="PSA 69:16">ahabw'okusaasira kwawe kwingi ompindukire;<verse eid="PSA 69:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Zab 27:9</ref>; <ref loc="PSA 102:2">102:2</ref>. </char>
    </note> Kandi otaanyima amaisho gaawe, nyowe omwiru waawe;</para>
  <para style="q1" vid="PSA 69:17">ahakuba ndi omu kabi, orahukye kungarukamu.<verse eid="PSA 69:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18" />Onyirire haihi, oncungure;</para>
  <para style="q1" vid="PSA 69:18">Onyihe omu mikono y'abazigu bangye.<verse eid="PSA 69:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:6">Zab 22:6</ref>; <ref loc="HEB 12:2">Heb 12:2</ref>. </char>
    </note> Noomanya okujumwa kwangye, enshoni zangye, n'okuhemuka kwangye;</para>
  <para style="q1" vid="PSA 69:19">Ababisha bangye boona noobamanya.<verse eid="PSA 69:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:20: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:5">Isa 63:5</ref>; <ref loc="JER 15:5">Yer 15:5</ref>. </char>
    </note> Ebijumo bincwire omutima, ninshaasha munonga;</para>
  <para style="q1" vid="PSA 69:20">Nsherwire ow'okunsaasira, yaabura;</para>
  <para style="q1" vid="PSA 69:20">Kandi naasherura ab'okumpuumuriza, nabo bamburira.<verse eid="PSA 69:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:21: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:34">Mat 27:34</ref>; <ref loc="MRK 15:36">Mak 15:36</ref>; <ref loc="LUK 23:36">Luk 23:36</ref>; <ref loc="JHN 19:29">Yoh 19:29</ref>. </char>
    </note> Bampa ebirikushaarira kubirya;</para>
  <para style="q1" vid="PSA 69:21">N'ahabw'eiriho bampa viinyo erikushaarira kuginywa.<verse eid="PSA 69:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:22-28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4-8">Zab 35:4-8</ref>; <ref loc="PSA 109:6-15">109:6-15</ref>. </char>
    </note> <note caller="-" style="x"><char style="xo" closed="false">69:22, 23: </char><char style="xt" closed="false"><ref loc="ROM 11:9">Rom 11:9</ref>, <ref loc="ROM 11:10">10</ref>. </char></note> Emeeza yaabo ebabeere omutego,</para>
  <para style="q1" vid="PSA 69:22">N'okugira obusingye kubabeere orugogo.<verse eid="PSA 69:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:23: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 6:18">2 Bag 6:18</ref>; <ref loc="ISA 6:10">Isa 6:10</ref>; <ref loc="DAN 5:6">Dan 5:6</ref>. </char>
    </note> Amaisho gaabo gashwekwe oruho, barekye kureeba;</para>
  <para style="q1" vid="PSA 69:23">Otetemye enyugunyu zaabo obutoosha.<verse eid="PSA 69:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24" />Obashukyeho okuguubwa kubi kwawe,</para>
  <para style="q1" vid="PSA 69:24">Kandi ekiniga kyawe kingi kibahikyeho;<verse eid="PSA 69:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:25: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:20">Byak 1:20</ref>. </char>
    </note> Eka yaabo ehindukye eitongo;</para>
  <para style="q1" vid="PSA 69:25">Hatagira owaatuura omu mahema gaabo.<verse eid="PSA 69:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:26: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:21">Yob 19:21</ref>, <ref loc="JOB 19:22">22</ref>; <ref loc="ISA 53:4">Isa 53:4</ref>. </char>
    </note> Ahakuba nibahiiga ou waateire,</para>
  <para style="q1" vid="PSA 69:26">Nibagambirana eby'obusaasi bw'ogwo ou waahutaize.<verse eid="PSA 69:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:27: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 4:5">Neh 4:5</ref>. </char>
    </note> Oyongyere ebiheneso aha biheneso byabo,</para>
  <para style="q1" vid="PSA 69:27">Hatagira owaasinga orubanja omu maisho gaawe.<verse eid="PSA 69:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:28: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:32">Kur 32:32</ref>; <ref loc="ISA 4:3">Isa 4:3</ref>; <ref loc="EZK 13:9">Ezk 13:9</ref>; <ref loc="LUK 10:20">Luk 10:20</ref>; <ref loc="PHP 4:3">Fil 4:3</ref>; <ref loc="HEB 12:23">Heb 12:23</ref>; <ref loc="REV 3:5">Kush 3:5</ref>; <ref loc="REV 13:8">13:8</ref>. </char>
    </note> Amaziina gaabo gaihwe omu kitabo ky'amagara;</para>
  <para style="q1" vid="PSA 69:28">Barekye kuhandiikwa n'abahikiriire.<verse eid="PSA 69:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:1">Zab 20:1</ref>. </char>
    </note> Kwonka nyowe ndi omworo, kandi ow'obusaasi;</para>
  <para style="q1" vid="PSA 69:29">Okujuna kwawe, ai Ruhanga, kuntunguure.<verse eid="PSA 69:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:30: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:46">Luk 1:46</ref>. </char>
    </note> Ndyahimbisa eiziina rya Ruhanga n'ekyeshongoro,</para>
  <para style="q1" vid="PSA 69:30">Mmuhe ekitiinisa n'eby'okumusiima.<verse eid="PSA 69:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:13">Zab 50:13</ref>, <ref loc="PSA 50:14">14</ref>. </char>
    </note> Ebyo biryagwisa gye MUKAMA okukira enimi,</para>
  <para style="q1" vid="PSA 69:31">Nari enimi y'ekimasha eine emahembe n'ebyara.<verse eid="PSA 69:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:26">Zab 22:26</ref>. </char>
    </note> Abarikubonabonesibwa bakireebe, bashemererwe;</para>
  <para style="q1" vid="PSA 69:32">Imwe abarikusherura Ruhanga, emitima yaanyu ehimbuukye!<verse eid="PSA 69:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:33: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:6">Zab 68:6</ref>. </char>
    </note> Ahakuba MUKAMA ahurira abakyene,</para>
  <para style="q1" vid="PSA 69:33">Kandi tagaya bantu be abari omu kihome.<verse eid="PSA 69:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:11">Zab 96:11</ref>. </char>
    </note> Eiguru n'ensi bimuhimbise,</para>
  <para style="q1" vid="PSA 69:34">N'enyanja n'ebirikugyenderamu byona.<verse eid="PSA 69:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:35: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:26">Isa 44:26</ref>. </char>
    </note> Ahakuba Ruhanga aryajuna Saayuuni,</para>
  <para style="q1" vid="PSA 69:35">Agarukye ayombekye endembo za Yuda,</para>
  <para style="q1" vid="PSA 69:35">Abantu be baryagituuramu, ebe eyaabo;<verse eid="PSA 69:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">69:36: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 65:9">Isa 65:9</ref>. </char>
    </note> Abaana b'abairu be baryagihungura,</para>
  <para style="q1" vid="PSA 69:36">N'abakunda eiziina rye baryagituuramu.<verse eid="PSA 69:36" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" sid="PSA 70" />
  <para style="s1">Okushaba Ruhanga okurahuka kutuhwera omu bworo bwaitu</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi ahabw'empongano y'okwijutsya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 70:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">70:1-5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:13-17">Zab 40:13-17</ref>. </char>
    </note> Ikiriza kunjuna, ai Ruhanga!</para>
  <para style="q1" vid="PSA 70:1">Ai MUKAMA orahukye kumpwera!<note caller="-" style="x"><char style="xo" closed="false">70:1: </char><char style="xt" closed="false"><ref loc="PSA 32:7">Zab 32:7</ref>. </char></note><verse eid="PSA 70:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">70:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4">Zab 35:4</ref>. </char>
    </note> Abarikwenda kuunyita</para>
  <para style="q1" vid="PSA 70:2">Bahemurwe, bashoberwe;</para>
  <para style="q1" vid="PSA 70:2">N'abarikwesiima naakorwa kubi bagarurwe enyima, bagaywe.<verse eid="PSA 70:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3" />Abarikunteerera enaku, nibagira bati: Otyo! Otyo!</para>
  <para style="q1" vid="PSA 70:3">Batsigweho ahabw'enshoni zaabo.<verse eid="PSA 70:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">70:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:27">Zab 35:27</ref>. </char>
    </note> Boona abarikukusherura bashemererwe, bananukire omuriiwe!</para>
  <para style="q1" vid="PSA 70:4">Abarikukunda okujuna kwawe bagume bagire bati:</para>
  <para style="q1" vid="PSA 70:4">Ruhanga aheebwe ekitiinisa!<verse eid="PSA 70:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">70:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:1">Zab 86:1</ref>; <ref loc="PSA 141:1">141:1</ref>. </char>
    </note> Kwonka ndi omworo kandi omukyene;</para>
  <para style="q1" vid="PSA 70:5">Rahuka kumpikaho, ai Ruhanga;</para>
  <para style="q1" vid="PSA 70:5">Niiwe Muhwezi wangye, kandi Omujuni wangye;</para>
  <para style="q1" vid="PSA 70:5">Ai MUKAMA otaikarayo!<verse eid="PSA 70:5" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" sid="PSA 71" />
  <para style="s1">Okushaba kw'omugurusi n'okuhimbisa kwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 71:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:1-3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:1-3">Zab 31:1-3</ref>. </char>
    </note> Ai MUKAMA, niiwe mpungiraho;</para>
  <para style="q1" vid="PSA 71:1">Otandeka kuhemurwa!<verse eid="PSA 71:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2" />Onjune ahabw'okuhikiirira kwawe, onkize;</para>
  <para style="q1" vid="PSA 71:2">Ontegye okutu, onjune!<verse eid="PSA 71:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:1">Zab 90:1</ref>; <ref loc="PSA 91:9">91:9</ref>; <ref loc="DEU 33:27">Bir 33:27</ref>. </char>
    </note> Ombeere orukiri rw'okutuuramu,</para>
  <para style="q1" vid="PSA 71:3">Omu ndaabaase kuguma nimpungira.</para>
  <para style="q1" vid="PSA 71:3">Okaragiira kunjuna;</para>
  <para style="q1" vid="PSA 71:3">ahakuba niiwe rukiri rwangye, kandi orugo rwangye orugumire.<verse eid="PSA 71:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:1">Zab 140:1</ref>, <ref loc="PSA 140:4">4</ref>. </char>
    </note> Ai Ruhanga wangye, onyihe omu mikono y'omubi,</para>
  <para style="q1" vid="PSA 71:4">Onsikure omu mikono y'omuntu enshaarizi otahikiriire.<verse eid="PSA 71:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:7">Yer 17:7</ref>; <ref loc="ROM 15:13">Rom 15:13</ref>; <ref loc="1TI 1:1">1 Tim 1:1</ref>. </char>
    </note> Ahakuba niiwe matsiko gangye, ai Mukama RUHANGA.</para>
  <para style="q1" vid="PSA 71:5">Ou naayesigire okwiha omu buto bwangye.<verse eid="PSA 71:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:9">Zab 22:9</ref>, <ref loc="PSA 22:10">10</ref>; <ref loc="ISA 46:3">Isa 46:3</ref>. </char>
    </note> Niiwe nyegamira okwiha obu naazaarwa;</para>
  <para style="q1" vid="PSA 71:6">Niiwe waanyihire omunda ya maawe.</para>
  <para style="q1" vid="PSA 71:6">Niiwe ndiguma nimpimbisa.<verse eid="PSA 71:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 8:18">Isa 8:18</ref>; <ref loc="1CO 4:9">1 Kor 4:9</ref>. </char>
    </note> Ndi nk'eihano eririkutangaaza baingi,</para>
  <para style="q1" vid="PSA 71:7">Kwonka Iwe ori obuhungiro bwangye obugumire.<verse eid="PSA 71:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:28">Zab 35:28</ref>. </char>
    </note> Akanwa kangye kaijura eby'okukuhimbisa,</para>
  <para style="q1" vid="PSA 71:8">N'eby'okukuha ekitiinisa eizooba ryona.<verse eid="PSA 71:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9" />Ku ndiba naabaire omugurusi, otarinnaga;</para>
  <para style="q1" vid="PSA 71:9">Kandi ku ndihwamu amaani, otarintisigaho!<verse eid="PSA 71:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:10, 11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:6">Zab 56:6</ref>; <ref loc="2SA 17:1">2 Sam 17:1</ref>, <ref loc="2SA 17:2">2</ref>. </char>
    </note> Ahakuba abazigu bangye nibangambaho,</para>
  <para style="q1" vid="PSA 71:10">Abagwereire amagara gangye nibahanuura hamwe,<verse eid="PSA 71:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11" />Nibagira bati: Ruhanga amutsigireho;</para>
  <para style="q1" vid="PSA 71:11">Mumukurate, mumukwate;</para>
  <para style="q1" vid="PSA 71:11">Ahakuba taine kijuna.<verse eid="PSA 71:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:1">Zab 10:1</ref>; <ref loc="PSA 40:13">40:13</ref>. </char>
    </note> Ai Ruhanga, otanza hare,</para>
  <para style="q1" vid="PSA 71:12">Ruhanga wangye, rahuka kumpwera.<verse eid="PSA 71:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4">Zab 35:4</ref>. </char>
    </note> Ababisha b'amagara gangye bakwatwe enshoni, bamarweho;</para>
  <para style="q1" vid="PSA 71:13">Abarikwenda kunkora kubi bahindukye ekijumo, bagaywe.<verse eid="PSA 71:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14" />Kwonka nyowe ndyaguma n'amatsiko obutoosha,</para>
  <para style="q1" vid="PSA 71:14">Nyeyongyere kukuhimbisa buri izooba.<verse eid="PSA 71:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:5">Zab 40:5</ref>. </char>
    </note> Akanwa kangye karyamanyisa eby'okuhikiirira kwawe,</para>
  <para style="q1" vid="PSA 71:15">N'eby'okujuna kwawe eizooba ryona;</para>
  <para style="q1" vid="PSA 71:15">ahakuba ni bingi, tindikubaasa kubibara.<verse eid="PSA 71:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16" />Ndyaija ngambe ebikuru ebi Mukama RUHANGA yaakozire;</para>
  <para style="q1" vid="PSA 71:16">Ndyahimbisa okuhikiirira kwawe wenka.<verse eid="PSA 71:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17" />Ai Ruhanga, okanyegyesa okwiha omu buto bwangye,</para>
  <para style="q1" vid="PSA 71:17">Kandi ninkigamba eby'okutangaaza ebi waakozire n'okuhitsya hati.<verse eid="PSA 71:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:18: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 46:4">Isa 46:4</ref>. </char>
    </note> N'obu ndikura naamera enju, ai Ruhanga, otarintsigaho,</para>
  <para style="q1" vid="PSA 71:18">Okuhitsya obu ndimanyisa amaani gaawe ab'obusingye bwona oburikurataho.<verse eid="PSA 71:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:10">Zab 35:10</ref>; <ref loc="PSA 36:6">36:6</ref>; <ref loc="PSA 126:2">126:2</ref>; <ref loc="1SA 12:24">1 Sam 12:24</ref>; <ref loc="LUK 1:49">Luk 1:49</ref>. </char>
    </note> Kandi n'okuhikiirira kwawe, ai Ruhanga, kuri ahaiguru munonga;</para>
  <para style="q1" vid="PSA 71:19">Iwe Ruhanga owaakozire ebikuru, n'oha orikushushana naiwe?<verse eid="PSA 71:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:3">Zab 60:3</ref>; <ref loc="PSA 85:6">85:6</ref>; <ref loc="HOS 6:2">Hos 6:2</ref>. </char>
    </note> Iwe owaanyikiriize nkareeba enaku nyingi,</para>
  <para style="q1" vid="PSA 71:20">Oryagaruka, ompe amagara;</para>
  <para style="q1" vid="PSA 71:20">Onzoore, onyihe okuzimu.<verse eid="PSA 71:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21" />Oryanyongyeraho ekitiinisa,</para>
  <para style="q1" vid="PSA 71:21">Kandi ogarukye ompuumuze omutima.<verse eid="PSA 71:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:2">Zab 33:2</ref>; <ref loc="PSA 78:41">78:41</ref>; <ref loc="2KI 19:22">2 Bag 19:22</ref>; <ref loc="ISA 60:9">Isa 60:9</ref>. </char>
    </note> Naanye ndyakuhimbisa n'enanga,</para>
  <para style="q1" vid="PSA 71:22">ahabw'okwesigwa kwawe, Ruhanga wangye;</para>
  <para style="q1" vid="PSA 71:22">Ndyayeshongora eby'okukuhimbisa n'endingiri,</para>
  <para style="q1" vid="PSA 71:22">Iwe Orikwera wa Israeli.<verse eid="PSA 71:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:22">Zab 25:22</ref>. </char>
    </note> Ku ndyeshongora eby'okukuhimbisa,</para>
  <para style="q1" vid="PSA 71:23">eminwa yangye eryateera akaari k'okushemererwa,</para>
  <para style="q1" vid="PSA 71:23">Kandi n'amagara gangye agu waacungwire.<verse eid="PSA 71:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">71:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:8">Zab 71:8</ref>. </char>
    </note> N'orurimi rwangye ruryagamba eby'okuhikiirira kwawe eizooba ryona;</para>
  <para style="q1" vid="PSA 71:24">ahakuba abarikwenda kunkora kubi bakwatsiibwe enshoni, baahemurwa.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" sid="PSA 72" />
  <para style="s1">Zaaburi y'okushabira abagabe</para>
  <para style="d">Zaaburi ya Sulemaani</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 72:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 22:12">1 Bus 22:12</ref>. </char>
    </note> Ohe omugabe okucwa emanja omu buryo bwawe, ai Ruhanga,</para>
  <para style="q1" vid="PSA 72:1">N'omwana we omuhe okuhikiirira kwawe.<verse eid="PSA 72:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 11:4">Isa 11:4</ref>; <ref loc="ISA 32:1">32:1</ref>. </char>
    </note> Aryacwera abantu baawe emanja omu kuhikiirira,</para>
  <para style="q1" vid="PSA 72:2">N'abooro baawe omu buryo.<verse eid="PSA 72:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 32:17">Isa 32:17</ref>. </char>
    </note> Ebibungo n'otubungo biryareetera abantu obusingye omu kuhikiirira.<verse eid="PSA 72:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4" />Aryacwera abooro b'omu bantu emanja,</para>
  <para style="q1" vid="PSA 72:4">Ajune abaana b'abakyene,</para>
  <para style="q1" vid="PSA 72:4">Kandi acwanyagure orikubonabonesa.<verse eid="PSA 72:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:36">Zab 89:36</ref>, <ref loc="PSA 89:37">37</ref>; <ref loc="JER 31:35">Yer 31:35</ref>, <ref loc="JER 31:36">36</ref>. </char>
    </note> Baryakutiina obusingye bwona,</para>
  <para style="q1" vid="PSA 72:5">Eizooba n'okwezi bikiriho.<verse eid="PSA 72:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:2">Bir 32:2</ref>; <ref loc="2SA 23:4">2 Sam 23:4</ref>; <ref loc="AMO 7:1">Amo 7:1</ref>. </char>
    </note> Aryaija nk'enjura erikugwa aha bunyaatsi butemire,</para>
  <para style="q1" vid="PSA 72:6">Nk'orutoonyerera orurikutoonyerera aha itaka.<verse eid="PSA 72:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:12">Zab 92:12</ref>; <ref loc="ISA 2:4">Isa 2:4</ref>; <ref loc="EPH 2:14">Efe 2:14</ref>. </char>
    </note> Omu biro bye abahikiriire baryagogyeera,</para>
  <para style="q1" vid="PSA 72:7">Bagire obusingye bwingi okuhitsya obu okwezi kuriburira kimwe.<verse eid="PSA 72:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:8">Zab 2:8</ref>; <ref loc="EXO 23:31">Kur 23:31</ref>; <ref loc="ZEC 9:10">Zek 9:10</ref>. </char>
    </note> Aryategyeka okuruga aha nyanja okuhika aha nyanja,</para>
  <para style="q1" vid="PSA 72:8">N'okuruga aha Mugyera omukuru okuhika aha muheru gw'ensi.<verse eid="PSA 72:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:29">Zab 22:29</ref>; <ref loc="ISA 49:23">Isa 49:23</ref>. </char>
    </note> Abatuura omu ihamba baryamwinamira;</para>
  <para style="q1" vid="PSA 72:9">N'abazigu be baryarigatsa omucuucu.<verse eid="PSA 72:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:29">Zab 68:29</ref>; <ref loc="1KI 10:1">1 Bag 10:1</ref>, <ref loc="1KI 10:22">22</ref>; <ref loc="ISA 43:3">Isa 43:3</ref>; <ref loc="ISA 60:9">60:9</ref>. </char>
    </note> Abagabe ba Tarushiishi n'ab'omu birwa baryamutoijera;</para>
  <para style="q1" vid="PSA 72:10">N'abagabe ba Sheeba na Seeba baryamureetera ebiconco.<verse eid="PSA 72:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:7">Isa 49:7</ref>. </char>
    </note> Eego abagabe boona baryagwa, bajuumare omu maisho ge,</para>
  <para style="q1" vid="PSA 72:11">N'amahanga goona gamuheereze;<verse eid="PSA 72:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12" />Ahakuba aryajuna omukyene, ku arimutakira,</para>
  <para style="q1" vid="PSA 72:12">N'omworo otaine kihwera.<verse eid="PSA 72:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13" />Aryasaasira abooro n'abakyene,</para>
  <para style="q1" vid="PSA 72:13">Kandi amagara g'enshoberwa agajune.<verse eid="PSA 72:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:15">Zab 116:15</ref>; <ref loc="2KI 1:13">2 Bag 1:13</ref>. </char>
    </note> Aryacungura amagara gaabo, agaihe omu kubonabonesibwa n'omu mwaga,</para>
  <para style="q1" vid="PSA 72:14">Kandi eshagama yaabo eryamubeera ey'obuguzi bwingi.<verse eid="PSA 72:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:15: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 10:10">1 Bag 10:10</ref>. </char>
    </note> Aryagumaho; kandi baryamureetera ezaabu ya Sheeba;</para>
  <para style="q1" vid="PSA 72:15">N'abantu baryaguma nibamushabira,</para>
  <para style="q1" vid="PSA 72:15">Bamushabire omugisha eizooba ryona.<verse eid="PSA 72:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:16: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:25">Yob 5:25</ref>. </char>
    </note> Haryabaho omweru mwingi omu nsi,</para>
  <para style="q1" vid="PSA 72:16">Emyaka eryakondakonda omu misiri omu bibungo;</para>
  <para style="q1" vid="PSA 72:16">Nk'ebiti bya Lebanooni.</para>
  <para style="q1" vid="PSA 72:16">N'abantu b'omu rurembo baryaba nk'obunyaatsi bw'omu ishwa oburabize.<verse eid="PSA 72:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:31">Zab 104:31</ref>; <ref loc="GEN 12:3">Kut 12:3</ref>; <ref loc="JER 4:2">Yer 4:2</ref>; <ref loc="LUK 1:48">Luk 1:48</ref>. </char>
    </note> Eiziina rye riryagumaho ebiro byona,</para>
  <para style="q1" vid="PSA 72:17">N'okurangaanwa kwe kuryagumaho, eizooba ku ririba rikiriho;</para>
  <para style="q1" vid="PSA 72:17">Kandi omuriwe abantu boona nimwo bariheerwa omugisha;</para>
  <para style="q1" vid="PSA 72:17">Amahanga goona garyamweta Oine omugisha.<verse eid="PSA 72:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">72:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:13">Zab 41:13</ref>; <ref loc="NEH 9:5">Neh 9:5</ref>. </char>
    </note> MUKAMA asiimwe, niwe Ruhanga wa Israeli;</para>
  <para style="q1" vid="PSA 72:18">We wenka akora eby'okutangaaza.<verse eid="PSA 72:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19" />Kandi eiziina rye ery'ekitiinisa risiimwe ebiro byona;</para>
  <para style="q1" vid="PSA 72:19">Ekitiinisa kye kiijure ensi yoona.</para>
  <para style="q2" vid="PSA 72:19">Amiina, kandi Amiina!<verse eid="PSA 72:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20" />Eby'okushaba bya Daudi mwene Yese byagarukira aha.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" sid="PSA 73" />
  <para style="ms">EKITABO KYA KASHATU</para>
  <para style="s1">Okugwa gye kw'ababi n'omuheru gwabo</para>
  <para style="d">Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 73:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:4">Zab 24:4</ref>. </char>
    </note> Buzimazima Ruhanga ni murungi aha Baisraeli</para>
  <para style="q1" vid="PSA 73:1">Abaine emitima eshemeire.<verse eid="PSA 73:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2" />Kwonka nyowe, ebigyere byangye bikaba byatereire,</para>
  <para style="q1" vid="PSA 73:2">Nkaba ndi haihi kugwa;<verse eid="PSA 73:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:1">Zab 37:1</ref>; <ref loc="JOB 21:7">Yob 21:7</ref>. </char>
    </note> Ahakuba ku naareebire okugogyeera kw'ababi,</para>
  <para style="q1" vid="PSA 73:3">Naagirira abanyamaryo eihari.<verse eid="PSA 73:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4" />Ku baba nibafa, tibashaasha,</para>
  <para style="q1" vid="PSA 73:4">Batuura bari gye, kandi bagomokire.<verse eid="PSA 73:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5" />Tibareeba naku nk'abandi,</para>
  <para style="q1" vid="PSA 73:5">N'obu kwakuba okugwerwa akagwe nkabo.<verse eid="PSA 73:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:18">Zab 109:18</ref>. </char>
    </note> N'ahabw'ekyo amaryo gaba nk'orukwanzi omu bitsya byabo;</para>
  <para style="q1" vid="PSA 73:6">N'omwaga gubashweka nk'eky'okujwara.<verse eid="PSA 73:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:10">Zab 17:10</ref>. </char>
    </note> Amaisho gabahwererera omu mutwe ahabw'okugomoka;</para>
  <para style="q1" vid="PSA 73:7">N'emitima yaabo egira ebiteekateeko by'obushema ebirengyesereize.<verse eid="PSA 73:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8" />Bashekyerera abandi, bagamba eby'eitima,</para>
  <para style="q1" vid="PSA 73:8">Omu maryo gaabo bakangisa abantu ku barikwija kubabonabonesa.<verse eid="PSA 73:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9" />Akanwa kaabo kagamba eby'okujuma eiguru,</para>
  <para style="q1" vid="PSA 73:9">N'orurimi rwabo rugyendagyenda omu nsi nirugamba eby'okwehimbisa.<verse eid="PSA 73:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10" />N'ahabw'ekyo abantu bahinduka, babasiima,</para>
  <para style="q1" vid="PSA 73:10">Babura ekibi ki babareebamu;<verse eid="PSA 73:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:11">Zab 10:11</ref>; <ref loc="JOB 22:13">Yob 22:13</ref>. </char>
    </note> Kandi bagira bati: Ruhanga naakimanya ata?</para>
  <para style="q1" vid="PSA 73:11">Rukira-boona aine eki arikumanya?<verse eid="PSA 73:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12" />Reeba, ababi n'aba;</para>
  <para style="q1" vid="PSA 73:12">Kandi ahabw'okugira obusingye obutoosha, beeyongyera kugira obutungi.<verse eid="PSA 73:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:6">Zab 26:6</ref>; <ref loc="JOB 21:15">Yob 21:15</ref>; <ref loc="JOB 34:9">34:9</ref>; <ref loc="MAL 3:14">Mal 3:14</ref>. </char>
    </note> Nkeeruhiza busha kushemeza omutima gwangye,</para>
  <para style="q1" vid="PSA 73:13">N'okunaabisa engaro zangye omu kutashiisha;<verse eid="PSA 73:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:14: </char>
      <char style="xt" closed="false">
        <ref loc="REV 3:19">Kush 3:19</ref>. </char>
    </note> ahakuba ndenzya eizooba nimbonabonesibwa,</para>
  <para style="q1" vid="PSA 73:14">Kandi buri kasheeshe mpeebwa ebiheneso.<verse eid="PSA 73:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15" />Kuri naagizire nti: Ka ngambe ntyo,</para>
  <para style="q1" vid="PSA 73:15">Nkaagobeize ab'obusingye bw'abaana baawe.<verse eid="PSA 73:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16" />Ku naateekateekire oku ndaashoborokyerwe ekyo,</para>
  <para style="q1" vid="PSA 73:16">Kikandusya, kyandema,<verse eid="PSA 73:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:38">Zab 37:38</ref>. </char>
    </note> Okuhitsya obu naagiire omu Mwanya gwa Ruhanga ogurikwera;</para>
  <para style="q1" vid="PSA 73:17">Nkateekateeka ebiribabaho aha muheru.<verse eid="PSA 73:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:6">Zab 35:6</ref>. </char>
    </note> Buzimazima obata aharikuterera,</para>
  <para style="q1" vid="PSA 73:18">Obagwisa, bahwerekyerera.<verse eid="PSA 73:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:19: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:11">Yob 18:11</ref>. </char>
    </note> Ka bahindukire eitongo omu mwanya mukye!</para>
  <para style="q1" vid="PSA 73:19">Ebirikutiinisa bibamariireho kimwe.<verse eid="PSA 73:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:65">Zab 78:65</ref>; <ref loc="JOB 20:8">Yob 20:8</ref>. </char>
    </note> Nk'oku ekirooto kiba omuntu yaasisiimuka,</para>
  <para style="q1" vid="PSA 73:20">Ku oriimuka, ai Mukama,</para>
  <para style="q1" vid="PSA 73:20">Nikwo origaya otyo ebiteekateeko ebitariho.<verse eid="PSA 73:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21" />Ahakuba omutima gwangye gukagwisibwa kubi,</para>
  <para style="q1" vid="PSA 73:21">Naacumitwa omunda yangye;<verse eid="PSA 73:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 73:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:22: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:3">Yob 18:3</ref>. </char>
    </note> Naaba omushema, otaine ki arikumanya,</para>
  <para style="q1" vid="PSA 73:22">Naaba nk'enyamaishwa omu maisho gaawe.<verse eid="PSA 73:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:8">Zab 63:8</ref>. </char>
    </note> Kwonka nyowe ndi hamwe naiwe obutoosha;</para>
  <para style="q1" vid="PSA 73:23">Okwaitse omukono gwangye gwa buryo.<verse eid="PSA 73:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:8">Zab 32:8</ref>; <ref loc="PSA 49:15">49:15</ref>; <ref loc="JHN 14:3">Yoh 14:3</ref>. </char>
    </note> Oryampabura n'obwengye bwawe,</para>
  <para style="q1" vid="PSA 73:24">Kandi aha muheru oryantaasya omu kitiinisa.<verse eid="PSA 73:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:2">Zab 16:2</ref>; <ref loc="ISA 26:8">Isa 26:8</ref>; <ref loc="PHP 3:8">Fil 3:8</ref>. </char>
    </note> N'oha ou nyine omu iguru kureka Iwe?</para>
  <para style="q1" vid="PSA 73:25">Tihariho ondiijo weena aha nsi ou nyiniire orushusho kureka Iwe.<verse eid="PSA 73:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:5">Zab 16:5</ref>; <ref loc="PSA 84:2">84:2</ref>. </char>
    </note> Omubiri gwangye n'omutima gwangye n'obu byakuhwaho,</para>
  <para style="q1" vid="PSA 73:26">Kwonka Ruhanga niwe rukiri oru omutima gwangye guhungiraho,</para>
  <para style="q1" vid="PSA 73:26">Kandi niwe omugabo gwangye ebiro n'ebiro.<verse eid="PSA 73:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:39">Zab 106:39</ref>; <ref loc="EXO 34:15">Kur 34:15</ref>; <ref loc="JAS 4:4">Yak 4:4</ref>. </char>
    </note> Abakuza hare baryahwerekyerera;</para>
  <para style="q1" vid="PSA 73:27">Omariraho kimwe abakutsigaho, bakeegyendera.<verse eid="PSA 73:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">73:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:6">Zab 14:6</ref>; <ref loc="PSA 118:17">118:17</ref>; <ref loc="HEB 10:22">Heb 10:22</ref>; <ref loc="JAS 4:8">Yak 4:8</ref>. </char>
    </note> Kwonka ekirungi ahariinye n'okwirira haihi Ruhanga;</para>
  <para style="q1" vid="PSA 73:28">Mukama RUHANGA mmuhindwire obweshereko bwangye,</para>
  <para style="q1" vid="PSA 73:28">Mbone kumanyisa abantu ebi waakozire byona.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" sid="PSA 74" />
  <para style="s1">Okushaba kw'ab'omu nsi ecwekyereziibwe. Ruhanga okubagarura obusya</para>
  <para style="d">Zaaburi ya Asafu eyaagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 74:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:9">Zab 44:9</ref>; <ref loc="PSA 95:7">95:7</ref>; <ref loc="PSA 100:3">100:3</ref>; <ref loc="DEU 29:20">Bir 29:20</ref>; <ref loc="JER 23:1">Yer 23:1</ref>; <ref loc="EZK 34:31">Ezk 34:31</ref>. </char>
    </note> Ai Ruhanga, ahabw'enki otunagire ebiro byona?</para>
  <para style="q1" vid="PSA 74:1">Ahanki ekiniga kyawe nikibuguma aha ntaama z'omu iriisizo ryawe?<verse eid="PSA 74:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:11">Zab 9:11</ref>; <ref loc="EXO 15:16">Kur 15:16</ref>; <ref loc="ISA 63:9">Isa 63:9</ref>, <ref loc="ISA 63:17">17</ref>. </char>
    </note> Ijuka omutwe gw'abantu baawe abu waaguzire ira,</para>
  <para style="q1" vid="PSA 74:2">Abu waacungwire kuba oruganda rw'obuhunguzi bwawe,</para>
  <para style="q1" vid="PSA 74:2">N'orushozi Saayuuni oru waatwireho.<verse eid="PSA 74:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3" />Imuka oze omu mwanya ogwahindukiire kimwe amatongo,</para>
  <para style="q1" vid="PSA 74:3">Oreebe obubi bwona obu abazigu baakozire omu Mwanya ogurikwera.<verse eid="PSA 74:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:4: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 2:7">Tonz 2:7</ref>. </char>
    </note> Ababisha baawe bakatontomera ahagati y'enju yaawe ey'okuteeraniramu;</para>
  <para style="q1" vid="PSA 74:4">Baahanika endango zaabo kuba obumanyiso.<verse eid="PSA 74:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 46:22">Yer 46:22</ref>. </char>
    </note> Aha irembo rya ruguru baatemagura</para>
  <para style="q1" vid="PSA 74:5">Orugo rw'obubaaho bwogainemu n'empango zaabo.<verse eid="PSA 74:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:6: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 6:18">1 Bag 6:18</ref>, <ref loc="1KI 6:29-35">29-35</ref>. </char>
    </note> Nk'abantu abakwaitse empango nibatema emiti y'omu kibira,</para>
  <para style="q1" vid="PSA 74:6">Nikwo baashatagwire n'empango n'enyondo ebintu ebisharwire;<verse eid="PSA 74:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:1">Zab 79:1</ref>; <ref loc="2KI 25:9">2 Bag 25:9</ref>. </char>
    </note> Baayotsya Omwanya gwawe ogurikwera,</para>
  <para style="q1" vid="PSA 74:7">Kandi ahi Eiziina ryawe rituura baahashiisha nibahasheenyagura.<verse eid="PSA 74:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8" />Baagira omu mitima yaabo bati: Ka tubahwerekyerereze kimwe!</para>
  <para style="q1" vid="PSA 74:8">Baayotsya sinagogi za Ruhanga zoona omu nsi.<verse eid="PSA 74:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:9: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 3:1">1 Sam 3:1</ref>; <ref loc="LAM 2:9">Tonz 2:9</ref>; <ref loc="MIC 3:6">Mik 3:6</ref>; <ref loc="MAT 16:4">Mat 16:4</ref>. </char>
    </note> Titukireeba bumanyiso bwaitu;</para>
  <para style="q1" vid="PSA 74:9">Tihaakiriho nabi n'omwe,</para>
  <para style="q1" vid="PSA 74:9">Kandi tihariho n'omwe ahariitwe orikumanya ahi ebi birigarukira.<verse eid="PSA 74:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10" />Ai Ruhanga, ababisha baryahitsya hi okutujuma?</para>
  <para style="q1" vid="PSA 74:10">Abazigu baryaguma barogote aha Iziina ryawe ebiro byona?<verse eid="PSA 74:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:11: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 2:3">Tonz 2:3</ref>. </char>
    </note> Ahabw'enki ohinyire omukono gwawe, omukono gwawe gwa buryo?</para>
  <para style="q1" vid="PSA 74:11">Gwihe omu kifuba kyawe, obahwerekyereze.<verse eid="PSA 74:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:4">Zab 44:4</ref>. </char>
    </note> Kwonka Ruhanga niwe Mukama wangye okwiha ira ryona,</para>
  <para style="q1" vid="PSA 74:12">Otuura naakora eby'okujuna omu nsi.<verse eid="PSA 74:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Kur 14:21</ref>; <ref loc="ISA 51:9">Isa 51:9</ref>. </char>
    </note> Okabaganisa enyanja n'amaani gaawe,</para>
  <para style="q1" vid="PSA 74:13">Waayatagurira kimwe emitwe y'ebijoka omu maizi;<verse eid="PSA 74:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 41:1">Yob 41:1</ref>; <ref loc="ISA 27:1">Isa 27:1</ref>. </char>
    </note> Niiwe waayatagwire emitwe ya Leviasaani,</para>
  <para style="q1" vid="PSA 74:14">Okagiha enyamaishwa z'omu ihamba kugirya.<verse eid="PSA 74:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:41">Zab 105:41</ref>; <ref loc="ISA 48:21">Isa 48:21</ref>; <ref loc="ISA 51:10">51:10</ref>; <ref loc="EXO 17:5">Kur 17:5</ref>, <ref loc="EXO 17:6">6</ref>; <ref loc="NUM 20:11">Kub 20:11</ref>; <ref loc="JOS 4:23">Yos 4:23</ref>. </char>
    </note> Okaigura enshuro n'obugyera,</para>
  <para style="q1" vid="PSA 74:15">Waayomya emigyera etooma.<verse eid="PSA 74:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:14-16">Kut 1:14-16</ref>. </char>
    </note> Nyomushana n'eyaawe, kandi na nyekiro n'eyaawe;</para>
  <para style="q1" vid="PSA 74:16">Niiwe waataireho omushana n'eizooba.<verse eid="PSA 74:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:17: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 8:22">Kut 8:22</ref>; <ref loc="DEU 32:8">Bir 32:8</ref>; <ref loc="ACT 17:26">Byak 17:26</ref>. </char>
    </note> Niiwe waataireho emyatano yoona ey'ensi.</para>
  <para style="q1" vid="PSA 74:17">Kandi okataho ekyanda n'eitumba.<verse eid="PSA 74:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:50">Zab 89:50</ref>. </char>
    </note> Ijuka eki, ai Ruhanga, oku abazigu barikukujuma,</para>
  <para style="q1" vid="PSA 74:18">Nk'oku abantu abashema barikurogota aha Iziina ryawe.<verse eid="PSA 74:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19" />Otaha enyamaishwa amagara g'enkombe yaawe;</para>
  <para style="q1" vid="PSA 74:19">Oteebwa amagara g'abooro baawe ebiro byona.<verse eid="PSA 74:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:45">Zab 106:45</ref>; <ref loc="GEN 17:7">Kut 17:7</ref>; <ref loc="LEV 26:44">Lev 26:44</ref>, <ref loc="LEV 26:45">45</ref>; <ref loc="JER 33:21">Yer 33:21</ref>. </char>
    </note> Ta omutima aha ndagaano yaawe;</para>
  <para style="q1" vid="PSA 74:20">ahabw'okuba emyanya y'omwirima omu nsi eijwire obutaaho bw'abanyamwaga.<verse eid="PSA 74:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:10">Zab 6:10</ref>; <ref loc="PSA 9:9">9:9</ref>. </char>
    </note> Otaikiriza abarikubonabonesibwa kuhemurwa;</para>
  <para style="q1" vid="PSA 74:21">Abooro n'abakyene bahimbise Eiziina ryawe.<verse eid="PSA 74:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:22: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:15">1 Sam 24:15</ref>. </char>
    </note> Imuka, ai Ruhanga, oyetonganire;</para>
  <para style="q1" vid="PSA 74:22">Oijukye oku abashema barikukujuma okurenzya eizooba.<verse eid="PSA 74:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">74:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:7">Zab 65:7</ref>. </char>
    </note> Oteebwa orwari rw'abazigu baawe,</para>
  <para style="q1" vid="PSA 74:23">N'okujagarara kw'abakugomeire oku baimutsya obutoosha.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" sid="PSA 75" />
  <para style="s1">Oku Ruhanga acwa emanja omu bwinganisa</para>
  <para style="d">Aha Mukuru w'abeeshongozi, omu iraka eririkwetwa Otahwerekyereza. Zaaburi ya Asafu ei baayeshongoire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 75:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:18">Zab 145:18</ref>. </char>
    </note> Nitukusiima, ai Ruhanga; nitukusiima;</para>
  <para style="q1" vid="PSA 75:1">ahakuba eiziina ryawe riri haihi;</para>
  <para style="q1" vid="PSA 75:1">Abantu nibagamba eby'okutangaaza ebi waakozire.<verse eid="PSA 75:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:13">Zab 102:13</ref>; <ref loc="DAN 8:19">Dan 8:19</ref>; <ref loc="HAB 2:3">Hab 2:3</ref>. </char>
    </note> Omu bunaku obu nditaho,</para>
  <para style="q1" vid="PSA 75:2">Ndyacwa emanja omu mazima.<verse eid="PSA 75:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:8">1 Sam 2:8</ref>; <ref loc="ISA 24:9">Isa 24:9</ref>. </char>
    </note> Ensi n'abagituuramu n'obu biraabe nibitengatenga kugwa,</para>
  <para style="q1" vid="PSA 75:3">Kwonka niinye mpamya enyomyo zaayo.<verse eid="PSA 75:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:4, 5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:4">Zab 94:4</ref>; <ref loc="ZEC 1:21">Zek 1:21</ref>. </char>
    </note> Nkagambira abanyamaryo nti: Mutagira amaryo;</para>
  <para style="q1" vid="PSA 75:4">N'ababi nti: Mutaimutsya amahembe gaanyu.<verse eid="PSA 75:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5" />Mutaimutsya amahembe gaanyu; mutagamba mugangaize ebitsya.<verse eid="PSA 75:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:3">Zab 3:3</ref>. </char>
    </note> Mumanye ngu okukuzibwa tikuruga burugwa-izooba,</para>
  <para style="q1" vid="PSA 75:6">Nari oburengyerwa-izooba, n'obu bwakuba obukiizi-bwa-buryo;<verse eid="PSA 75:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:6">Zab 50:6</ref>; <ref loc="1SA 2:7">1 Sam 2:7</ref>; <ref loc="DAN 2:21">Dan 2:21</ref>; <ref loc="LUK 1:52">Luk 1:52</ref>. </char>
    </note> Kureka Ruhanga niwe mucwi w'emanja,</para>
  <para style="q1" vid="PSA 75:7">Ogarura ahansi omwe, akatunguura ondiijo.<verse eid="PSA 75:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:10">Zab 73:10</ref>; <ref loc="JOB 21:20">Yob 21:20</ref>; <ref loc="JER 25:15">Yer 25:15</ref>; <ref loc="REV 14:10">Kush 14:10</ref>. </char>
    </note> Ahakuba omu mikono gwa MUKAMA harimu ekikopo,</para>
  <para style="q1" vid="PSA 75:8">Ekirimu viinyo etimbwire erikubira; aryagishuka;</para>
  <para style="q1" vid="PSA 75:8">Buzima ababi boona ab'omu nsi baryaginywa, bagimaremu,</para>
  <para style="q1" vid="PSA 75:8">Bacence n'ebikanja byayo.<verse eid="PSA 75:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9" />Kwonka nyowe ndyashemererwa ebiro byona;</para>
  <para style="q1" vid="PSA 75:9">Nyeshongore eby'okuhimbisa Ruhanga wa Yakobo.<verse eid="PSA 75:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">75:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:17">Zab 89:17</ref>; <ref loc="1SA 2:1">1 Sam 2:1</ref>; <ref loc="JER 48:25">Yer 48:25</ref>. </char>
    </note> Amahembe goona ag'ababi aryagatemaho,</para>
  <para style="q1" vid="PSA 75:10">Kwonka amahembe g'abahikiriire garyaheebwa ekitiinisa.<verse eid="PSA 75:10" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" sid="PSA 76" />
  <para style="s1">Okuhimbisibwa kwa Ruhanga ahabw'okujuna Saayuuni</para>
  <para style="d">Aha Mukuru w'abeeshongozi, Zaaburi ya Asafu ei baayeshongoroire aha nanga y'emirya</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 76:1" />Omuri Yuda Ruhanga naamanywa;</para>
  <para style="q1" vid="PSA 76:1">Eiziina rye ni rukuru omuri Israeli.<verse eid="PSA 76:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:11">Zab 9:11</ref>; <ref loc="PSA 27:5">27:5</ref>; <ref loc="GEN 14:18">Kut 14:18</ref>. </char>
    </note> Eihema rye riri omuri Saalemu,</para>
  <para style="q1" vid="PSA 76:2">Kandi atuura omuri Saayuuni.<verse eid="PSA 76:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:9">Zab 46:9</ref>; <ref loc="EZK 39:9">Ezk 39:9</ref>. </char>
    </note> Okwo niyo yaahendeire emyambi y'obuta,</para>
  <para style="q1" vid="PSA 76:3">Engabo, na rurara, n'eby'okurwanisa omu rugamba.<verse eid="PSA 76:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4" />Ori ow'ekitiinisa, kandi ori murungi okukira boona,</para>
  <para style="q1" vid="PSA 76:4">Otabaarukire aha bibungo ebiriho eminyago.<verse eid="PSA 76:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:3">Zab 13:3</ref>; <ref loc="JER 51:39">Yer 51:39</ref>; <ref loc="NAM 3:18">Nah 3:18</ref>. </char>
    </note> Ab'omutima gw'obumanzi banyagirwe,</para>
  <para style="q1" vid="PSA 76:5">Bagwejegyeire obutasisiimuka,</para>
  <para style="q1" vid="PSA 76:5">Abarwani boona tibabaasize kwerwanaho n'emikono yaabo.<verse eid="PSA 76:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:1">Kur 15:1</ref>. </char>
    </note> Ahabw'okuhana kwawe, ai Ruhanga wa Yakobo,</para>
  <para style="q1" vid="PSA 76:6">Embaraasi n'abarikuzigyenderaho bagwejegyeire obutaimutsya mutwe.<verse eid="PSA 76:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:3">Zab 130:3</ref>; <ref loc="JOB 41:10">Yob 41:10</ref>; <ref loc="NAM 1:6">Nah 1:6</ref>. </char>
    </note> Kwonka Iwe ori ow'okutiinisa!</para>
  <para style="q1" vid="PSA 76:7">N'oha orikubaasa kukwemerera omu maisho waagira ekiniga?<verse eid="PSA 76:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:8: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 20:29">2 Bus 20:29</ref>, <ref loc="2CH 20:30">30</ref>; <ref loc="HAB 2:20">Hab 2:20</ref>. </char>
    </note> Okeema omu iguru, waamanyisa oku waacwire orubanja,</para>
  <para style="q1" vid="PSA 76:8">Ensi yaatiina, yaacureera,<verse eid="PSA 76:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:7">Zab 9:7</ref>, <ref loc="PSA 9:8">8</ref>. </char>
    </note> Ruhanga ku yaimukire kucwa orubanja,</para>
  <para style="q1" vid="PSA 76:9">N'okujuna boona abarikubonabonesibwa omu nsi.<verse eid="PSA 76:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:16">Kur 9:16</ref>. </char>
    </note> Buzimazima ekiniga ky'abantu kiryakuhimbisa,</para>
  <para style="q1" vid="PSA 76:10">N'ekiniga ekiritsigaraho oryakizibira.<verse eid="PSA 76:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>; <ref loc="PSA 68:29">68:29</ref>; <ref loc="PSA 89:7">89:7</ref>; <ref loc="ECC 5:4">Mub 5:4</ref>; <ref loc="ISA 8:13">Isa 8:13</ref>. </char>
    </note> Ohigye ahari MUKAMA Ruhanga waawe, kandi ohikiirize okuhiga kwawe;</para>
  <para style="q1" vid="PSA 76:11">Boona abamwehinguririize bareete emitoijo</para>
  <para style="q1" vid="PSA 76:11">ahari Ogwo oshemereire kutiinwa,<verse eid="PSA 76:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">76:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:2">Zab 47:2</ref>. </char>
    </note> Niwe ahwerekyereza amagara g'abanyiginya,</para>
  <para style="q1" vid="PSA 76:12">Kandi otiinisa abagabe b'ensi.<verse eid="PSA 76:12" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" sid="PSA 77" />
  <para style="s1">Okwijuka oku Ruhanga yaakozire eby'okutangaaza omu biro ebya ira</para>
  <para style="d">Aha Mukuru w'abeeshongozi omu muringo gwa Yedusuuni. Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 77:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:4">Zab 3:4</ref>. </char>
    </note> Ka ntakire Ruhanga n'eiraka ryangye,</para>
  <para style="q1" vid="PSA 77:1">Ka mmutakire n'eiraka rihango, naija kumpurira.<verse eid="PSA 77:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:15">Zab 50:15</ref>; <ref loc="PSA 86:7">86:7</ref>; <ref loc="PSA 143:6">143:6</ref>; <ref loc="ISA 26:9">Isa 26:9</ref>. </char>
    </note> Aha izooba eri naareebeireho enaku, nkasherura Mukama;</para>
  <para style="q1" vid="PSA 77:2">Naimutsya emikono yangye nyekiro, tinaaruha;</para>
  <para style="q1" vid="PSA 77:2">amagara gangye gaayanga kuhuumuzibwa.<verse eid="PSA 77:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 43:5">Zab 43:5</ref>; <ref loc="PSA 61:2">61:2</ref>; <ref loc="PSA 142:3">142:3</ref>; <ref loc="PSA 143:4">143:4</ref>. </char>
    </note> Ku nyijuka Ruhanga, nyemereza omutima,</para>
  <para style="q1" vid="PSA 77:3">Ngira amaganya, omutima gwangye gugwa enshazi.<verse eid="PSA 77:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4" />Ozibira amaisho gangye kuteerana;</para>
  <para style="q1" vid="PSA 77:4">Nyine enaku; tindikubaasa kugamba.<verse eid="PSA 77:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:5">Zab 143:5</ref>; <ref loc="DEU 32:7">Bir 32:7</ref>; <ref loc="ISA 51:9">Isa 51:9</ref>. </char>
    </note> Nteekateekire ebiro ebya ira,</para>
  <para style="q1" vid="PSA 77:5">N'emyaka eya iranaira.<verse eid="PSA 77:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:4">Zab 4:4</ref>; <ref loc="PSA 42:8">42:8</ref>. </char>
    </note> Naijuka ekyeshongoro kyangye kya nyekiro;</para>
  <para style="q1" vid="PSA 77:6">Naateekateeka munonga, omutima gwangye gwayezirika kwecaaka.<verse eid="PSA 77:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:9">Zab 44:9</ref>. </char>
    </note> Mukama aryanagira kimwe?</para>
  <para style="q1" vid="PSA 77:7">Tarigaruka kugira embabazi obundi?<verse eid="PSA 77:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:8: </char>
      <char style="xt" closed="false">
        <ref loc="JER 15:18">Yer 15:18</ref>; <ref loc="ROM 9:6">Rom 9:6</ref>. </char>
    </note> Okusaasira kwe kuhwereireho kimwe ebiro byona?</para>
  <para style="q1" vid="PSA 77:8">Ebi yaaraganiise biryaguma bibuzire obutwire bwona?<verse eid="PSA 77:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:15">Isa 49:15</ref>; <ref loc="HAB 3:2">Hab 3:2</ref>. </char>
    </note> Ruhanga ayebirwe okugira embabazi?</para>
  <para style="q1" vid="PSA 77:9">Aimire embabazi ze nyingi ahabw'ekiniga?<verse eid="PSA 77:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:10: </char>
      <char style="xt" closed="false">
        <ref loc="JER 10:19">Yer 10:19</ref>. </char>
    </note> Bwanyima naagira nti:</para>
  <para style="q1" vid="PSA 77:10">Ebyo nibiruga omu bweremwa bwangye;</para>
  <para style="q1" vid="PSA 77:10">Okuteekateeka ngu omukono gwa buryo ogwa Rukira-boona niguhinduka!<verse eid="PSA 77:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:5">Zab 105:5</ref>. </char>
    </note> Ndyaijutsya abantu ebi MUKAMA yaakozire.</para>
  <para style="q1" vid="PSA 77:11">Kandi ndyaijuka eby'okutangaaza byawe ebya ira.<verse eid="PSA 77:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12" />Ndyateekateeka munonga aha murimo gwawe gwona,</para>
  <para style="q1" vid="PSA 77:12">Ngumye ebiteekateeko byangye aha bikuru ebi waakozire.<verse eid="PSA 77:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:10">Zab 35:10</ref>. </char>
    </note> Omuhanda gwawe, ai Ruhanga, nigwera.</para>
  <para style="q1" vid="PSA 77:13">N'oha ruhanga omukuru orukwingana na Ruhanga waitu?<verse eid="PSA 77:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:18">Zab 72:18</ref>; <ref loc="PSA 106:8">106:8</ref>. </char>
    </note> Niiwe wenka Ruhanga okora eby'okutangaaza;</para>
  <para style="q1" vid="PSA 77:14">Okooreka amaani gaawe omu mahanga;<verse eid="PSA 77:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15" />Waacungura abantu baawe n'omukono gwawe,</para>
  <para style="q1" vid="PSA 77:15">Nibo baana ba Yakobo na Yosefu.<verse eid="PSA 77:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 114:3">Zab 114:3</ref>; <ref loc="HAB 3:10">Hab 3:10</ref>; <ref loc="JOS 3:15">Yos 3:15</ref>, <ref loc="JOS 3:16">16</ref>; <ref loc="EXO 14:21">Kur 14:21</ref>. </char>
    </note> Amaizi gakakureeba, ai Ruhanga;</para>
  <para style="q1" vid="PSA 77:16">Ku gaakureebire, gaatiina; ahagati omu maizi maingi haatetema.<verse eid="PSA 77:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:14">Zab 18:14</ref>. </char>
    </note> Ebicu byashuka amaizi, eiguru ryahinda;</para>
  <para style="q1" vid="PSA 77:17">Emyambi yaawe yamurinkana hoona;<verse eid="PSA 77:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:4">Zab 97:4</ref>; <ref loc="PSA 104:7">104:7</ref>. </char>
    </note> Eiraka ry'okuhinda kwawe ryaizira omu kasooroora;</para>
  <para style="q1" vid="PSA 77:18">Emirabyo yaawe yaamurika ensi yoona;</para>
  <para style="q1" vid="PSA 77:18">Ensi yaatetema, yaatengyeta.<verse eid="PSA 77:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:19: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:15">Hab 3:15</ref>. </char>
    </note> Omuhanda gwawe gukaba guri omu nyanja,</para>
  <para style="q1" vid="PSA 77:19">N'otuhanda twawe nituraba omu maizi maingi;</para>
  <para style="q1" vid="PSA 77:19">Ahi ebigyere byawe byarabire, tiharamanyirwe.<verse eid="PSA 77:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">77:20: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Kur 13:21</ref>; <ref loc="ISA 63:11">Isa 63:11</ref>, <ref loc="ISA 63:12">12</ref>. </char>
    </note> Ahabw'omukono gwa Musa na Arooni</para>
  <para style="q1" vid="PSA 77:20">Okeebembera abantu baawe nk'obusyo bw'entaama.<verse eid="PSA 77:20" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" sid="PSA 78" />
  <para style="s1">Ebirikwijutsya oku Ruhanga yaayebembeire abantu be omu rugyendo rwabo</para>
  <para style="d">Zaaburi ya Asafu eyagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 78:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:1">Zab 49:1</ref>; <ref loc="ISA 51:4">Isa 51:4</ref>. </char>
    </note> Imwe bantu bangye 'mwe, nimuhurire okwegyesa kwangye,</para>
  <para style="q1" vid="PSA 78:1">Mutege amatu ebigambo, ebirikuruga omu kanwa kangye.<verse eid="PSA 78:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:4">Zab 49:4</ref>; <ref loc="MAT 13:35">Mat 13:35</ref>. </char>
    </note> Ndyayashamya akanwa kangye, ncwe enfumu;</para>
  <para style="q1" vid="PSA 78:2">Ngambe ebitarikushobooroka ebya ira,<verse eid="PSA 78:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:1">Zab 44:1</ref>. </char>
    </note> Ebi twahuriire tukamanya,</para>
  <para style="q1" vid="PSA 78:3">Ebi baatatenkuriitwe baatugambiire.<verse eid="PSA 78:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:4: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:26">Kur 12:26</ref>, <ref loc="EXO 12:27">27</ref>; <ref loc="DEU 4:9">Bir 4:9</ref>; <ref loc="JOS 4:6">Yos 4:6</ref>, <ref loc="JOS 4:7">7</ref>. </char>
    </note> Tituribishereka baana baabo,</para>
  <para style="q1" vid="PSA 78:4">Kureka turyagambira ab'obusingye oburiija</para>
  <para style="q1" vid="PSA 78:4">Eby'ekitiinisa ebi MUKAMA yaakozire n'amaani ge,</para>
  <para style="q1" vid="PSA 78:4">N'eby'okutangaaza ebi yaakozire.<verse eid="PSA 78:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 147:19">Zab 147:19</ref>. </char>
    </note> Ahakuba akataho eby'okumuhamya omuri Yakobo,</para>
  <para style="q1" vid="PSA 78:5">Yaaragiira ekiragiro omuri Israeli,</para>
  <para style="q1" vid="PSA 78:5">Ebi yaaragiire baatatenkuriitwe kwegyesa abaana baabo,<verse eid="PSA 78:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:18">Zab 102:18</ref>. </char>
    </note> Ngu ab'obusingye oburiija babimanye, nibo baana abarizaarwa,</para>
  <para style="q1" vid="PSA 78:6">Bakaimuka, bakabigambira abaana baabo;<verse eid="PSA 78:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:45">Zab 105:45</ref>. </char>
    </note> Ngu babone kwesiga Ruhanga, n'okuteebwa mirimo ye,</para>
  <para style="q1" vid="PSA 78:7">Kureka boorobere ebiragiro bye;<verse eid="PSA 78:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:9">Kur 32:9</ref>; <ref loc="2KI 17:14">2 Bag 17:14</ref>; <ref loc="JER 5:23">Yer 5:23</ref>. </char>
    </note> Kandi barekye kuba nka baishenkurubo</para>
  <para style="q1" vid="PSA 78:8">Ab'obusingye obugangaire obw'obugomi,</para>
  <para style="q1" vid="PSA 78:8">Abaabaire baine emitima etahamiire hamwe,</para>
  <para style="q1" vid="PSA 78:8">Kandi abaagizire omwoyo ogutarikwesigwa ahari Ruhanga.<verse eid="PSA 78:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9" />Abefuraimu, abaabaire bahagatiire amata,</para>
  <para style="q1" vid="PSA 78:9">Bakahunga aha izooba ry'orugamba.<verse eid="PSA 78:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:10: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 17:15">2 Bag 17:15</ref>. </char>
    </note> Tibararinzire ndagaano ya Ruhanga,</para>
  <para style="q1" vid="PSA 78:10">Bakanga kugyenda nk'oku ebiragiro bye biri.<verse eid="PSA 78:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:13">Zab 106:13</ref>; <ref loc="ISA 17:10">Isa 17:10</ref>; <ref loc="JER 2:32">Yer 2:32</ref>. </char>
    </note> Baayebwa ebi yaakozire,</para>
  <para style="q1" vid="PSA 78:11">N'eby'okutangaaza ebi yaaboorekire.<verse eid="PSA 78:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:8-12:32">Kur 7:8—12:32</ref>. </char>
    </note> Akakora eby'okutangaaza omu maisho ga baishenkurubo,</para>
  <para style="q1" vid="PSA 78:12">Omu nsi ya Misri n'omu mariisizo ga Zoani.<verse eid="PSA 78:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Kur 14:21</ref>; <ref loc="EXO 15:8">15:8</ref>. </char>
    </note> Yaabaganisa enyanja, yaagibarabyamu,</para>
  <para style="q1" vid="PSA 78:13">Yaayemereza amaizi, gaaba nk'omugongo.<verse eid="PSA 78:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Kur 13:21</ref>. </char>
    </note> Nyomushana abeebembeza ekicu,</para>
  <para style="q1" vid="PSA 78:14">Kandi nyekiro abeebembeza omuriro gurikwaka.<verse eid="PSA 78:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:15, 16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:41">Zab 105:41</ref>; <ref loc="EXO 17:6">Kur 17:6</ref>; <ref loc="NUM 20:11">Kub 20:11</ref>; <ref loc="ISA 48:21">Isa 48:21</ref>. </char>
    </note> Akaata enkiri omu ihamba,</para>
  <para style="q1" vid="PSA 78:15">Yaabanywaisa amaizi maingi nk'agarikuruga aha nshuro z'okuzimu.<verse eid="PSA 78:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16" />Akaigura enshuro omu rukiri,</para>
  <para style="q1" vid="PSA 78:16">amaizi gaahimintika nigashuuma nk'emigyera.<verse eid="PSA 78:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:17: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 9:22">Bir 9:22</ref>; <ref loc="ISA 63:10">Isa 63:10</ref>; <ref loc="HEB 3:16">Heb 3:16</ref>. </char>
    </note> Kwonka baayeyongyera kumucumuraho,</para>
  <para style="q1" vid="PSA 78:17">Nibagomera Rukira-boona bari omu ihamba.<verse eid="PSA 78:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:14">Zab 106:14</ref>; <ref loc="EXO 17:2">Kur 17:2</ref>; <ref loc="NUM 11:4">Kub 11:4</ref>; <ref loc="DEU 6:16">Bir 6:16</ref>; <ref loc="1CO 10:9">1 Kor 10:9</ref>. </char>
    </note> Baagyeza Ruhanga omu mitima yaabo,</para>
  <para style="q1" vid="PSA 78:18">Nibamushaba eby'okurya ebi baayetengire.<verse eid="PSA 78:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:5">Zab 23:5</ref>; <ref loc="EXO 16:3">Kur 16:3</ref>; <ref loc="NUM 21:5">Kub 21:5</ref>. </char>
    </note> Baagamba nibagaya Ruhanga, nibagira bati:</para>
  <para style="q1" vid="PSA 78:19">Ebyo Ruhanga naabaasa kutugaburira eby'okurya omu ihamba?<verse eid="PSA 78:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20" />N'eky'amazima akateera orukiri, amaizi gaahimintika, emigyera yaashandaara,</para>
  <para style="q1" vid="PSA 78:20">Beitu naabaasa kuha abantu be eby'okurya, abahe n'enyama?<verse eid="PSA 78:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:21, 22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:10">Zab 95:10</ref>; <ref loc="NUM 11:1">Kub 11:1</ref>. </char>
    </note> N'ahabw'ekyo MUKAMA ku yaakihuriire, yaakwatwa ekiniga;</para>
  <para style="q1" vid="PSA 78:21">Omuriro gwahembwa kwotsya Yakobo,</para>
  <para style="q1" vid="PSA 78:21">Ekiniga kyacumbuukira Israeli;<verse eid="PSA 78:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22" />Ahabw'okuba tibaraikiriize Ruhanga, n'obu kwakuba okwesiga okujuna kwe.<verse eid="PSA 78:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 7:11">Kut 7:11</ref>; <ref loc="MAL 3:10">Mal 3:10</ref>. </char>
    </note> Kwonka yaaragiira ebicu by'omu iguru,</para>
  <para style="q1" vid="PSA 78:23">Yaigura enyigi z'eiguru,<verse eid="PSA 78:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:24, 25: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:4">Kur 16:4</ref>; <ref loc="NEH 9:15">Neh 9:15</ref>, <ref loc="NEH 9:20">20</ref>; <ref loc="JHN 6:31">Yoh 6:31</ref>; <ref loc="1CO 10:3">1 Kor 10:3</ref>. </char>
    </note> Yaabagwisiza emaanu ey'okurya,</para>
  <para style="q1" vid="PSA 78:24">Yaaguma naabaha engano z'eiguru.<verse eid="PSA 78:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25" />Abantu baarya aha mugaati gw'ekinyamaraika,</para>
  <para style="q1" vid="PSA 78:25">Yaabagaburira, baahaaga.<verse eid="PSA 78:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:26-29: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:18-20">Kub 11:18-20</ref>, <ref loc="NUM 11:31">31</ref>. </char>
    </note> Yaareeta omuyaga gw'oburugwa-izooba, gwahuuha omu iguru,</para>
  <para style="q1" vid="PSA 78:26">Ahabw'amaani ge yaahabura omuyaga gw'obukiizi-bwa-buryo;<verse eid="PSA 78:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27" />Yaabagwisiza enyama nyingi nk'omucuucu,</para>
  <para style="q1" vid="PSA 78:27">Endahi ezirikwingana nk'omusheenyi gw'omu nyanja;<verse eid="PSA 78:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28" />Yaazigwisa ahagati omu nsiisira zaabo</para>
  <para style="q1" vid="PSA 78:28">Embaju zoona ez'amahema gaabo;<verse eid="PSA 78:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29" />Batyo baarya, baahaagira kimwe;</para>
  <para style="q1" vid="PSA 78:29">Ahakuba akabaha eki baayetengire;<verse eid="PSA 78:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:30, 31: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 11:33">Kub 11:33</ref>, <ref loc="NUM 11:34">34</ref>. </char>
    </note> Kwonka ku baabaire batakahweire kwetenga,</para>
  <para style="q1" vid="PSA 78:30">N'enyama zikiri omu kanwa kaabo,<verse eid="PSA 78:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31" />Ekiniga kya Ruhanga kyabagwaho,</para>
  <para style="q1" vid="PSA 78:31">Kyabitamu ab'amaani,</para>
  <para style="q1" vid="PSA 78:31">Kyahwerekyereza abatsigazi ba Israeli.<verse eid="PSA 78:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:32: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:1-4">Kub 14:1-4</ref>, <ref loc="NUM 14:11">11</ref>. </char>
    </note> Kwonka ebyo byona n'obu biraabe byabaireho, bakaguma nibashiisha,</para>
  <para style="q1" vid="PSA 78:32">Tibaikiriza by'okutangaaza ebi yaakozire.<verse eid="PSA 78:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:33: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:29">Kub 14:29</ref>, <ref loc="NUM 14:35">35</ref>; <ref loc="NUM 26:64">26:64</ref>, <ref loc="NUM 26:65">65</ref>. </char>
    </note> N'ahabw'ekyo yaafiisa ebiro byabo busha,</para>
  <para style="q1" vid="PSA 78:33">N'emyaka yaabo baagimara baine obwoba.<verse eid="PSA 78:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:1">Zab 63:1</ref>; <ref loc="HOS 5:15">Hos 5:15</ref>. </char>
    </note> Ku yaabaire abaita, bamusherura;</para>
  <para style="q1" vid="PSA 78:34">Beeteisa, beezirika kusherura Ruhanga.<verse eid="PSA 78:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:35: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:4">Bir 32:4</ref>, <ref loc="DEU 32:15">15</ref>. </char>
    </note> Kandi baijuka ku Ruhanga ari orukiri rwabo,</para>
  <para style="q1" vid="PSA 78:35">Ruhanga Rukira-boona ku ari Omucunguzi waabo.<verse eid="PSA 78:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:36: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:13">Isa 29:13</ref>; <ref loc="ISA 57:11">57:11</ref>; <ref loc="EZK 33:31">Ezk 33:31</ref>. </char>
    </note> Kwonka bamuha ekitiinisa ky'aha minwa,</para>
  <para style="q1" vid="PSA 78:36">Nibamubeha n'endimi zaabo;<verse eid="PSA 78:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:37: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:10">Zab 51:10</ref>; <ref loc="ACT 8:21">Byak 8:21</ref>. </char>
    </note> ahakuba emitima yaabo ekaba etamuhamiireho,</para>
  <para style="q1" vid="PSA 78:37">Kandi batari beesigwa ha ndagaano ye.<verse eid="PSA 78:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:38: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:15">Zab 86:15</ref>; <ref loc="NEH 9:17">Neh 9:17</ref>; <ref loc="NUM 14:20">Kub 14:20</ref>; <ref loc="EXO 34:6">Kur 34:6</ref>. </char>
    </note> Kwonka We ahabw'embabazi ze nyingi</para>
  <para style="q1" vid="PSA 78:38">Yaabasaasira okutahikiirira kwabo,</para>
  <para style="q1" vid="PSA 78:38">Tiyaabahwerekyereza;</para>
  <para style="q1" vid="PSA 78:38">Kaingi akaba ayezibira kubagwerwa kubi,</para>
  <para style="q1" vid="PSA 78:38">Areka kubamariraho ekiniga kye kyona.<verse eid="PSA 78:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:39: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 6:3">Kut 6:3</ref>; <ref loc="JOB 7:7">Yob 7:7</ref>; <ref loc="JAS 4:14">Yak 4:14</ref>. </char>
    </note> Aijuka ku bari abantu-buntu,</para>
  <para style="q1" vid="PSA 78:39">Nk'omuyaga oguhingura, gutagarukye.<verse eid="PSA 78:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40" />Ka ni kaingi obu baamugomera omu ihamba,</para>
  <para style="q1" vid="PSA 78:40">Bakamugwisiza kubi ahatatuurwa bantu!<verse eid="PSA 78:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:22">Zab 71:22</ref>. </char>
    </note> Bakaguma nibamugyeza,</para>
  <para style="q1" vid="PSA 78:41">Baakwatsa ekiniga Orikwera wa Israeli.<verse eid="PSA 78:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:42: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 8:34">Bar 8:34</ref>. </char>
    </note> Tibaijuka bushoboorozi bwe,</para>
  <para style="q1" vid="PSA 78:42">N'obu ryakuba eizooba eri yaabakiriizeho abazigu baabo,<verse eid="PSA 78:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:43-51: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:27-36">Zab 105:27-36</ref>. </char>
    </note> Obu yaakora obumanyiso omuri Misri,</para>
  <para style="q1" vid="PSA 78:43">N'eby'okutangaaza omu mariisizo ga Zoani.<note caller="-" style="x"><char style="xo" closed="false">78:43: </char><char style="xt" closed="false"><ref loc="EXO 7:3">Kur 7:3</ref>; <ref loc="EXO 11:9">11:9</ref>, <ref loc="EXO 11:10">10</ref>. </char></note><verse eid="PSA 78:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:44: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Kur 7:17-21</ref>. </char>
    </note> Akahindura emigyera yaabo eshagama,</para>
  <para style="q1" vid="PSA 78:44">Tibaabaasa kunywa maizi gaayo.<verse eid="PSA 78:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:45: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:2-14">Kur 8:2-14</ref>, <ref loc="EXO 8:21-24">21-24</ref>. </char>
    </note> Yaabateeza emizinga y'enshohera, zaabaruma,</para>
  <para style="q1" vid="PSA 78:45">N'ebikyere ebyabahwerekyereize.<verse eid="PSA 78:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:46: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Kur 10:12-15</ref>. </char>
    </note> Yaariisa emisiri yaabo kanyananga,</para>
  <para style="q1" vid="PSA 78:46">N'ebi baahingire yaabiriisa enzigye.<verse eid="PSA 78:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:47: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Kur 9:22-25</ref>. </char>
    </note> Yaateeza emizaabubu yaabo orubaare,</para>
  <para style="q1" vid="PSA 78:47">N'emisikamoori yaabo yaagiitsa embeho y'enyababa.<verse eid="PSA 78:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:48: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:19-21">Kur 9:19-21</ref>. </char>
    </note> Yaareka ente zaabo, zaateerwa orubaare,</para>
  <para style="q1" vid="PSA 78:48">N'amasyo gaabo gaateerwa enkuba.<verse eid="PSA 78:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:49: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:13">Kur 12:13</ref>, <ref loc="EXO 12:23">23</ref>; <ref loc="2SA 24:16">2 Sam 24:16</ref>. </char>
    </note> Yaabashukaho ekiniga kye kingi,</para>
  <para style="q1" vid="PSA 78:49">Okuguubwa kubi, okutamwa, n'enaku,</para>
  <para style="q1" vid="PSA 78:49">Nigwo mutwe gwa baamaraika abarikuhwerekyereza.<verse eid="PSA 78:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50" />Akacwera ekiniga kye ekirarai,</para>
  <para style="q1" vid="PSA 78:50">Tiyaabakiza kufa, kureka yaahayo amagara gaabo kubonabonesibwa.<verse eid="PSA 78:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:51: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:23">Zab 105:23</ref>, <ref loc="PSA 105:36">36</ref>; <ref loc="EXO 12:29">Kur 12:29</ref>. </char>
    </note> Yaita emijigaijo yoona omuri Misri,</para>
  <para style="q1" vid="PSA 78:51">Abaana b'amaani gaabo ag'okubanza omu mahema ga Haamu.<verse eid="PSA 78:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:52: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:20">Zab 77:20</ref>. </char>
    </note> Kwonka abantu be yaabeebembera nk'entaama, naabashohoza,</para>
  <para style="q1" vid="PSA 78:52">Yaabahabura, naabarabya omu ihamba nk'amasyo g'entaama.<verse eid="PSA 78:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:53: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:13">Kur 14:13</ref>, <ref loc="EXO 14:19">19</ref>, <ref loc="EXO 14:20">20</ref>, <ref loc="EXO 14:27">27</ref>, <ref loc="EXO 14:28">28</ref>. </char>
    </note> Yaabeebembera gye, tibaatiina;</para>
  <para style="q1" vid="PSA 78:53">Kwonak enyanja yaamira abazigu baabo.<verse eid="PSA 78:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:54: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:16">Zab 68:16</ref>; <ref loc="EXO 15:17">Kur 15:17</ref>. </char>
    </note> Yaabahitsya aha mwatano gw'ensi ye erikwera,</para>
  <para style="q1" vid="PSA 78:54">N'aha kibungo, eki yaakubwire n'omukono gwe gwa buryo.<verse eid="PSA 78:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:55: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:2">Zab 44:2</ref>; <ref loc="JOS 23:4">Yos 23:4</ref>. </char>
    </note> Yaabingamu amahanga, gaabahunga;</para>
  <para style="q1" vid="PSA 78:55">Yaagibabaganisiza kuba obuhunguzi bwabo,</para>
  <para style="q1" vid="PSA 78:55">Yaata enganda za Israeli omu mahema gaabo.<verse eid="PSA 78:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:56: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:11">Bar 2:11</ref>, <ref loc="JDG 2:12">12</ref>. </char>
    </note> Kwonka baagyeza Ruhanga Rukira-boona, baamugomera,</para>
  <para style="q1" vid="PSA 78:56">Tibaata mutima aha bi yaahamize;<verse eid="PSA 78:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:57: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 7:16">Hos 7:16</ref>. </char>
    </note> Kureka baagaruka enyima, baagobya nka baishenkurubo;</para>
  <para style="q1" vid="PSA 78:57">Baategama nk'obuta obureebya nyinabwo;<verse eid="PSA 78:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:58: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:30">Lev 26:30</ref>; <ref loc="DEU 12:3">Bir 12:3</ref>; <ref loc="DEU 31:29">31:29</ref>; <ref loc="DEU 32:16">32:16</ref>; <ref loc="EZK 20:28">Ezk 20:28</ref>. </char>
    </note> Ahabw'okuba bakamukwatsa ekiniga n'emyanya yaabo mikuru ey'okuramizamu,</para>
  <para style="q1" vid="PSA 78:58">Baamwitsya eihari n'ebishushani byabo ebibaizire.<verse eid="PSA 78:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:59: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:40">Zab 106:40</ref>. </char>
    </note> Ruhanga ku yaakihuriire, yaagira ekiniga kingi,</para>
  <para style="q1" vid="PSA 78:59">Yaayangira kimwe Israeli;<verse eid="PSA 78:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:60: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 18:1">Yos 18:1</ref>; <ref loc="1SA 4:11">1 Sam 4:11</ref>; <ref loc="JER 7:12-14">Yer 7:12-14</ref>. </char>
    </note> N'ahabw'ekyo yaatsigaho eihema rye omuri Shiilo,</para>
  <para style="q1" vid="PSA 78:60">Eri yaabaire atuuramu omu bantu,<verse eid="PSA 78:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:61: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:21">1 Sam 4:21</ref>. </char>
    </note> Yaahayo eshanduukye y'amaani ge kunyagwa,</para>
  <para style="q1" vid="PSA 78:61">Kandi ey'ekitiinisa kye omu mikono y'abazigu.<verse eid="PSA 78:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:62: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:10">1 Sam 4:10</ref>. </char>
    </note> Yaareka abantu be kwitwa rurara,</para>
  <para style="q1" vid="PSA 78:62">Yaagirira obuhunguzi bwe ekiniga.<verse eid="PSA 78:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:63: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:46">Zab 89:46</ref>; <ref loc="JER 7:34">Yer 7:34</ref>. </char>
    </note> Omuriro gwayokyeza kimwe abatsigazi baabo,</para>
  <para style="q1" vid="PSA 78:63">N'abaishiki baabo tibaagaruka kweshongorera ha bugyenyi.<verse eid="PSA 78:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:64: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 4:11">1 Sam 4:11</ref>; <ref loc="JOB 27:15">Yob 27:15</ref>. </char>
    </note> Abanyamurwa baabo baitwa rurara,</para>
  <para style="q1" vid="PSA 78:64">N'abafaakzi baabo tibaabacurira.<verse eid="PSA 78:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:65: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 73:20">Zab 73:20</ref>; <ref loc="ISA 42:13">Isa 42:13</ref>. </char>
    </note> Bwanyima Mukama yaasisiimuka nk'owaaba agwejegyeire,</para>
  <para style="q1" vid="PSA 78:65">Nk'omushaija ow'amaani orikuyombesibwa viinyo;<verse eid="PSA 78:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66" />Yaateera abazigu be, yaabagarura enyima,</para>
  <para style="q1" vid="PSA 78:66">Yaabataho ekihemu eky'ebiro n'ebiro.<verse eid="PSA 78:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67" />Kandi yaayanga eihema rya Yosefu,</para>
  <para style="q1" vid="PSA 78:67">Tiyaatoorana ruganda rwa Efuraimu;<verse eid="PSA 78:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:68: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 87:2">Zab 87:2</ref>. </char>
    </note> Kureka yaatoorana orwa Yuda,</para>
  <para style="q1" vid="PSA 78:68">N'ekibungo Saayuuni eki akunda.<verse eid="PSA 78:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:69: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 6:1-14">1 Bag 6:1-14</ref>. </char>
    </note> Yaayombeka Omwanya gwe ogurikwera gwaba nk'enshozi ndaingwa,</para>
  <para style="q1" vid="PSA 78:69">Kandi gwaguma nk'ensi ei yaahamiize kimwe.<verse eid="PSA 78:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:70: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:11-13">1 Sam 16:11-13</ref>. </char>
    </note> Yaatoorana Daudi omwiru we,</para>
  <para style="q1" vid="PSA 78:70">Yaamwiha omu ntaama,<verse eid="PSA 78:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:71: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 5:2">2 Sam 5:2</ref>; <ref loc="2SA 7:8">7:8</ref>; <ref loc="MIC 5:2-4">Mik 5:2-4</ref>. </char>
    </note> Omu kuriisa ebuguma ezirikwontsya</para>
  <para style="q1" vid="PSA 78:71">Ngu ariise Yakobo abantu be, na Israeli obuhunguzi bwe.<verse eid="PSA 78:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72" />
    <note caller="-" style="x">
      <char style="xo" closed="false">78:72: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 101:2">Zab 101:2</ref>; <ref loc="1KI 9:4">1 Bag 9:4</ref>. </char>
    </note> Yaabariisa n'omutima gw'amazima,</para>
  <para style="q1" vid="PSA 78:72">Yaabeebembeza obwengye bw'emikono ye.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" sid="PSA 79" />
  <para style="s1">Oku hekalu ya Mukama yaasiisirwe</para>
  <para style="d">Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 79:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:2">Zab 74:2</ref>, <ref loc="PSA 74:7">7</ref>; <ref loc="2KI 25:9">2 Bag 25:9</ref>; <ref loc="JER 26:18">Yer 26:18</ref>; <ref loc="LAM 1:10">Tonz 1:10</ref>. </char>
    </note> Ai Ruhanga, abanyamahanga bataahire omu buhunguzi bwawe,</para>
  <para style="q1" vid="PSA 79:1">Baashiisha hekalu yaawe erikwera,</para>
  <para style="q1" vid="PSA 79:1">Baashenya Yerusaalemu, baagihindura omutuumo.<verse eid="PSA 79:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:26">Bir 28:26</ref>; <ref loc="JER 7:33">Yer 7:33</ref>. </char>
    </note> Emitumbi y'abairu baawe bagihaire enyonyi z'omu mwanya kugirya,</para>
  <para style="q1" vid="PSA 79:2">Baagaburira enyamaishwa z'omu nsi emibiri y'abarikwera baawe.<verse eid="PSA 79:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:16">Yer 14:16</ref>. </char>
    </note> Baseesire eshagama yaabo nk'amaizi okwehinguririza Yerusaalemu;</para>
  <para style="q1" vid="PSA 79:3">Kandi tibaine kiziika.<verse eid="PSA 79:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:13">Zab 44:13</ref>; <ref loc="DAN 9:16">Dan 9:16</ref>. </char>
    </note> Ahari bataahi baitu tuhindukire ekijumo,</para>
  <para style="q1" vid="PSA 79:4">Kandi abatwehinguririize nibatushekyerera, nibatugaya.<verse eid="PSA 79:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:1">Zab 13:1</ref>; <ref loc="DEU 29:20">Bir 29:20</ref>; <ref loc="EZK 36:5">Ezk 36:5</ref>. </char>
    </note> Oryahitsya hi, ai MUKAMA okutugirira ekiniga ebiro byona?</para>
  <para style="q1" vid="PSA 79:5">Eihari ryawe riryayaka nk'omuriro?<verse eid="PSA 79:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:6, 7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:4">Zab 14:4</ref>; <ref loc="JER 10:25">Yer 10:25</ref>; <ref loc="ZEP 3:8">Zef 3:8</ref>. </char>
    </note> Shuka ekiniga kyawe aha mahanga agatarikukumanya,</para>
  <para style="q1" vid="PSA 79:6">N'aha bugabe obutatakira iziina ryawe;<verse eid="PSA 79:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7" />Ahabw'okuba bamizire Yakobo,</para>
  <para style="q1" vid="PSA 79:7">N'ahu atwire baahahindura eitongo.<verse eid="PSA 79:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:6">Zab 116:6</ref>; <ref loc="ISA 64:9">Isa 64:9</ref>; <ref loc="JER 11:10">Yer 11:10</ref>. </char>
    </note> Otaijuka eby'okutahikiirira bya baatatenkuriitwe, okabitutura;</para>
  <para style="q1" vid="PSA 79:8">Okusaasira kwawe kurahukye kutuhikaho,</para>
  <para style="q1" vid="PSA 79:8">Ahabw'okuba tugarwirwe ahansi munonga.<verse eid="PSA 79:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:3">Zab 23:3</ref>; <ref loc="JER 14:7">Yer 14:7</ref>. </char>
    </note> Ai Ruhanga ow'okujunwa kwaitu, otuhwere</para>
  <para style="q1" vid="PSA 79:9">Ahabw'ekitiinisa ky'eiziina ryawe;</para>
  <para style="q1" vid="PSA 79:9">Otujune, oshwekye ebibi byaitu ahabw'eiziina ryawe.<verse eid="PSA 79:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Zab 42:3</ref>; <ref loc="PSA 94:1">94:1</ref>. </char>
    </note> Ahabw'enki abanyamahanga nibagira bati: Ruhanga waabo arahi?</para>
  <para style="q1" vid="PSA 79:10">Okuhoora enzigu ahabw'eshagama y'abairu baawe eyaasheeshekire</para>
  <para style="q1" vid="PSA 79:10">Kumanywe omu banyamahanga, naitwe tukireebe.<verse eid="PSA 79:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:20">Zab 102:20</ref>. </char>
    </note> Okutsinda kw'embohe kukuhikyeho;</para>
  <para style="q1" vid="PSA 79:11">Ahabw'amaani gaawe maingi okize abateekateekyeirwe okufa.<verse eid="PSA 79:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:12: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:21">Lev 26:21</ref>, <ref loc="LEV 26:28">28</ref>; <ref loc="ISA 65:6">Isa 65:6</ref>, <ref loc="ISA 65:7">7</ref>. </char>
    </note> Oihure bataahi baitu emirundi mushanju ebijumo</para>
  <para style="q1" vid="PSA 79:12">Ebi baakujumire, ai Mukama!<verse eid="PSA 79:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">79:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:1">Zab 74:1</ref>; <ref loc="ISA 43:21">Isa 43:21</ref>. </char>
    </note> Naitwe abantu baawe, entaama z'omu iriisizo ryawe,</para>
  <para style="q1" vid="PSA 79:13">Turyakusiima ebiro byona,</para>
  <para style="q1" vid="PSA 79:13">Tumanyise ab'obusingye bwona okuhimbisibwa kwawe.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" sid="PSA 80" />
  <para style="s1">Okushaba Ruhanga okusaasira abantu be n'okubagarura busya</para>
  <para style="d">Aha Mukuru w'abeeshongozi, omu iraka eririkwetwa Emyangangye. Zaaburi y'ebi Asafu yaahamize</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 80:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:2">Zab 50:2</ref>; <ref loc="PSA 77:20">77:20</ref>; <ref loc="PSA 99:1">99:1</ref>; <ref loc="2SA 6:2">2 Sam 6:2</ref>; <ref loc="1SA 4:4">1 Sam 4:4</ref>; <ref loc="EXO 25:22">Kur 25:22</ref>. </char>
    </note> Tega okutu, Iwe Omuriisa wa Israeli,</para>
  <para style="q1" vid="PSA 80:1">Oyebembera Yosefu nk'obusyo!</para>
  <para style="q1" vid="PSA 80:1">Iwe oshutama aha kitebe ahagati ya baakerubi, jwisa omushana gwawe!<verse eid="PSA 80:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:2: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 2:18-24">Kub 2:18-24</ref>. </char>
    </note> Omu maisho ga Efuraimu, Benyamiini na Manaase</para>
  <para style="q1" vid="PSA 80:2">Sisiimura amaani gaawe, oije otujune!<verse eid="PSA 80:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:1">Zab 60:1</ref>; <ref loc="PSA 85:4">85:4</ref>; <ref loc="1KI 18:37">1 Bag 18:37</ref>; <ref loc="NUM 6:25">Kub 6:25</ref>. </char>
    </note> Otugarure aha buteeka, ai Ruhanga,</para>
  <para style="q1" vid="PSA 80:3">Otwakize amaisho gaawe, tubone kujunwa!<verse eid="PSA 80:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:5">Zab 59:5</ref>; <ref loc="PSA 79:5">79:5</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'amahe,</para>
  <para style="q1" vid="PSA 80:4">Oryahitsya hi okugwerwa kubi okushaba kw'abantu baawe?<verse eid="PSA 80:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Zab 42:3</ref>; <ref loc="PSA 102:9">102:9</ref>. </char>
    </note> Obagaburiire okurira nk'eby'okurya,</para>
  <para style="q1" vid="PSA 80:5">Waabanywaisa amarira maingi munonga.<verse eid="PSA 80:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:13">Zab 44:13</ref>. </char>
    </note> Otuhindwire eki bataahi baitu barikurwanira;</para>
  <para style="q1" vid="PSA 80:6">Abazigu baitu nibeeshekyera.<verse eid="PSA 80:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7" />Ai Ruhanga ow'amahe, otugarure aha buteeka;</para>
  <para style="q1" vid="PSA 80:7">Otwakize amaisho gaawe, tubone kujunwa.<verse eid="PSA 80:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:2">Zab 44:2</ref>; <ref loc="ISA 5:1">Isa 5:1</ref>, <ref loc="ISA 5:7">7</ref>; <ref loc="JER 2:21">Yer 2:21</ref>; <ref loc="EZK 17:6">Ezk 17:6</ref>; <ref loc="MRK 12:1">Mak 12:1</ref>. </char>
    </note> Okaiha omuzaabibu omuri Misri,</para>
  <para style="q1" vid="PSA 80:8">Waabinga amahanga, waagubyara.<verse eid="PSA 80:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9" />Waaguhingirira, gwahitsya emizi okuzimu,</para>
  <para style="q1" vid="PSA 80:9">Gwabuga ensi.<verse eid="PSA 80:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10" />Gwarandira aha bibungo byona,</para>
  <para style="q1" vid="PSA 80:10">N'amataagi gaagwo gaashweka emyereezi mihango;<verse eid="PSA 80:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:8">Zab 72:8</ref>. </char>
    </note> Gwanaga amataagi, gaahika aha Nyanja,</para>
  <para style="q1" vid="PSA 80:11">Gwazaara abaana, baahika aha Mugyera mukuru.<verse eid="PSA 80:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:40">Zab 89:40</ref>; <ref loc="ISA 5:5">Isa 5:5</ref>. </char>
    </note> Mbwenu ahabw'enki osheenyire orugo rwagwo,</para>
  <para style="q1" vid="PSA 80:12">Ngu abahinguzi boona bagucweho?<verse eid="PSA 80:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:6">Yer 5:6</ref>. </char>
    </note> Engiri z'omu ihamba nizigushiisha,</para>
  <para style="q1" vid="PSA 80:13">Enyamaishwa z'omu ishwa nizigwona.<verse eid="PSA 80:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:15">Isa 63:15</ref>. </char>
    </note> Ai Ruhanga ow'amahe, nitukweshengyereza otugarure aha buteeka,</para>
  <para style="q1" vid="PSA 80:14">Oyeme omu iguru, oreebe oyetegyereze,</para>
  <para style="q1" vid="PSA 80:14">Ote omutima ahari ogu muzaabibu,<verse eid="PSA 80:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:15: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:22">Kut 49:22</ref>. </char>
    </note> Ekitsintsi kyawe eki waayebyariire,</para>
  <para style="q1" vid="PSA 80:15">Kandi eitaagi eri waayehamiize.<verse eid="PSA 80:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 33:12">Isa 33:12</ref>. </char>
    </note> Bagwokize n'omuriro, baagutema.</para>
  <para style="q1" vid="PSA 80:16">Nkaahenwa ki bahwerekyerezibwa okuhana kw'ekitsyori kyawe!<verse eid="PSA 80:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:21">Zab 89:21</ref>. </char>
    </note> Kwonka omukono gwawe gugume aha muntu waawe <note caller="+" style="f"><char style="fr" closed="false">80:17 </char><char style="ft" closed="false">Omuntu waawe empika, omu Ruheburayo n'omuntu ow'omukono gwawe gwa buryo. </char></note>empika,</para>
  <para style="q1" vid="PSA 80:17">Aha mwana w'omuntu ou waahaire amaani kukugasira.<verse eid="PSA 80:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:20">Zab 71:20</ref>. </char>
    </note> Mbwenu obwo naitwe titurigaruka enyima, tukakutsigaho;</para>
  <para style="q1" vid="PSA 80:18">Otuhe amagara, tugume tutakire eiziina ryawe!<verse eid="PSA 80:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">80:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:3">Zab 80:3</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'amahe, otugarure aha buteeka,</para>
  <para style="q1" vid="PSA 80:19">Otwakize amaisho gaawe, tubone kujunwa!<verse eid="PSA 80:19" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" sid="PSA 81" />
  <para style="s1">Okusiima Ruhanga ahabw'ebirungi ebi yaakoreire abantu be n'obu baraabe baamugomeire</para>
  <para style="d">Aha Mukuru w'abeeshongozi, aha iraka ery'ekigitiiti. Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 81:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:1">Zab 66:1</ref>. </char>
    </note> Mweshongorere Ruhanga amaani gaitu n'eiraka rihango,</para>
  <para style="q1" vid="PSA 81:1">Muteerere Ruhanga wa Yakobo akaari k'okushemererwa!<verse eid="PSA 81:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:2">Zab 33:2</ref>; <ref loc="EXO 15:20">Kur 15:20</ref>. </char>
    </note> Mwimutsye ekyeshongoro, muteere ebitaasa,</para>
  <para style="q1" vid="PSA 81:2">N'enanga nungi n'endingiri.<verse eid="PSA 81:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:3, 4: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 10:10">Kub 10:10</ref>; <ref loc="LEV 23:24">Lev 23:24</ref>. </char>
    </note> Muteere amakondere okwezi kubonekire, kandi mugateere kukuzire,</para>
  <para style="q1" vid="PSA 81:3">aha izooba ryaitu ry'obugyenyi erikuru.<verse eid="PSA 81:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4" />Ahakuba n'ekiragiro ahabw'Abaisraeli,</para>
  <para style="q1" vid="PSA 81:4">Ekyaragiirwe Ruhanga wa Yakobo;<verse eid="PSA 81:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:5">Zab 78:5</ref>; <ref loc="PSA 114:1">114:1</ref>; <ref loc="EXO 11:4">Kur 11:4</ref>. </char>
    </note> Akakitaho kuba eky'okureeberaho omu ba Yosefu,</para>
  <para style="q1" vid="PSA 81:5">Obu yaaraba omu nsi ya Misri,</para>
  <para style="q1" vid="PSA 81:5">Ei naahuririire orurimi oru ntarikumanya.<verse eid="PSA 81:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:11">Kur 1:11</ref>. </char>
    </note> Nkabaiha omutwaro aha mabega,</para>
  <para style="q1" vid="PSA 81:6">Engaro zaanyu zaarekura ekiibo.<verse eid="PSA 81:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 2:23">Kur 2:23</ref>; <ref loc="EXO 14:10">14:10</ref>; <ref loc="EXO 19:19">19:19</ref>; <ref loc="NUM 20:13">Kub 20:13</ref>. </char>
    </note> Ku mwatakire muri omu busaasi, naabakiza;</para>
  <para style="q1" vid="PSA 81:7">Naabagarukamu ndi omu mwanya gw'enkuba ogutarikumanywa;</para>
  <para style="q1" vid="PSA 81:7">Naabagyereza aha maizi ga Meriba. Sela.<verse eid="PSA 81:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:7">Zab 50:7</ref>. </char>
    </note> Bantu bangye, muhurire ebi ndikubahana;</para>
  <para style="q1" vid="PSA 81:8">Iwe Israeli, nkaabaasibwa ki, ompurira!<verse eid="PSA 81:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:3">Kur 20:3</ref>; <ref loc="ISA 43:12">Isa 43:12</ref>. </char>
    </note> Mutarigira ruhanga w'abanyamahanga omuriimwe,</para>
  <para style="q1" vid="PSA 81:9">N'obu kwakuba okumuramya.<verse eid="PSA 81:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:2">Kur 20:2</ref>. </char>
    </note> Niinye MUKAMA Ruhanga waawe,</para>
  <para style="q1" vid="PSA 81:10">Owaakwihire omu nsi ya Misri;</para>
  <para style="q1" vid="PSA 81:10">Yashamya munonga akanwa kaawe, nkaijuze.<verse eid="PSA 81:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:1">Kur 32:1</ref>; <ref loc="PRO 1:30">Enf 1:30</ref>. </char>
    </note> Kwonka abantu bangye tibarahuriire iraka ryangye,</para>
  <para style="q1" vid="PSA 81:11">Kandi Israeli tarankunzire na kakye;<verse eid="PSA 81:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:12: </char>
      <char style="xt" closed="false">
        <ref loc="JER 7:24">Yer 7:24</ref>; <ref loc="ACT 7:42">Byak 7:42</ref>; <ref loc="ROM 1:24">Rom 1:24</ref>. </char>
    </note> Nikwo kubareka, bakaguma baine emitima egangaire,</para>
  <para style="q1" vid="PSA 81:12">Bakakurata obwengye bwabo ahabwabo.<verse eid="PSA 81:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:13: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 5:29">Bir 5:29</ref>; <ref loc="ISA 48:18">Isa 48:18</ref>; <ref loc="MAT 23:37">Mat 23:37</ref>. </char>
    </note> Nkaabaasibwa ki, abantu bangye bampurira,</para>
  <para style="q1" vid="PSA 81:13">Abaisraeli bagyendera omu mihanda yangye!<verse eid="PSA 81:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14" />Naanye ndahuka kugomoora abazigu baabo,</para>
  <para style="q1" vid="PSA 81:14">Ndwanisa ababisha baabo.<verse eid="PSA 81:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:44">Zab 18:44</ref>. </char>
    </note> Abangi ba MUKAMA bamugomookyera,</para>
  <para style="q1" vid="PSA 81:15">Kandi n'ebiro byabo tibyakuhweireho ebiro byona.<verse eid="PSA 81:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">81:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 147:14">Zab 147:14</ref>; <ref loc="DEU 32:13">Bir 32:13</ref>, <ref loc="DEU 32:14">14</ref>. </char>
    </note> Nkaabagaburiire engano nungi munonga,</para>
  <para style="q1" vid="PSA 81:16">Mbaigutsa obwoki oburikuruga omu rukiri.<verse eid="PSA 81:16" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" sid="PSA 82" />
  <para style="s1">Okuhanwa kw'abategyeki babi</para>
  <para style="d">Zaaburi ya Asafu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 82:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:1: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 22:16">Yos 22:16</ref>, <ref loc="JOS 22:17">17</ref>; <ref loc="ECC 5:8">Mub 5:8</ref>. </char>
    </note> Ruhanga ayemereire omu ishengyero rye;</para>
  <para style="q1" vid="PSA 82:1">Ahagati ya baaruhanga naacwa emanja.<verse eid="PSA 82:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 1:17">Bir 1:17</ref>; <ref loc="PRO 18:5">Enf 18:5</ref>. </char>
    </note> Muryahitsya hi okucwa emanja ezitari z'oburyo,</para>
  <para style="q1" vid="PSA 82:2">N'okugwera orubaju rw'ababi?<verse eid="PSA 82:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:18">Zab 10:18</ref>; <ref loc="JER 22:3">Yer 22:3</ref>. </char>
    </note> Mucwere abooro n'efuuzi emanja z'oburyo,</para>
  <para style="q1" vid="PSA 82:3">Mukorere abarikubonabonesibwa n'enshoberwa eby'amazima.<verse eid="PSA 82:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:4: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:12">Yob 29:12</ref>; <ref loc="PRO 24:11">Enf 24:11</ref>. </char>
    </note> Mujune abooro n'abakyene,</para>
  <para style="q1" vid="PSA 82:4">Mubaihe omu mikono y'ababi.<verse eid="PSA 82:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:3">Zab 11:3</ref>; <ref loc="PSA 14:4">14:4</ref>; <ref loc="PRO 2:13">Enf 2:13</ref>. </char>
    </note> Tibaine ki barikumanya, n'obu kwakuba okwetegyereza;</para>
  <para style="q1" vid="PSA 82:5">Bagyendagyendera omu mwirima;</para>
  <para style="q1" vid="PSA 82:5">Emisingi y'ensi yoona etengyetsibwa.<verse eid="PSA 82:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:6: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 10:34">Yoh 10:34</ref>. </char>
    </note> Nkagira nti: Muri baaruhanga;</para>
  <para style="q1" vid="PSA 82:6">Imwe mwena muri abaana ba Rukira-boona,<verse eid="PSA 82:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:32">Yob 21:32</ref>; <ref loc="EZK 28:2-10">Ezk 28:2-10</ref>. </char>
    </note> Kwonka muryafa nk'abantu,</para>
  <para style="q1" vid="PSA 82:7">Mugwe nk'abanyiginya boona oku bagwa.<verse eid="PSA 82:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">82:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:8">Zab 2:8</ref>; <ref loc="PSA 12:5">12:5</ref>; <ref loc="REV 11:15">Kush 11:15</ref>. </char>
    </note> Imuka, ai Ruhanga, ocwere ensi orubanja;</para>
  <para style="q1" vid="PSA 82:8">Ahabw'okuba amahanga goona garyaba obuhunguzi bwawe.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" sid="PSA 83" />
  <para style="s1">Okushaba Ruhanga okuburabuza abazigu be</para>
  <para style="d">Zaaburi ya Asafu, ei baayeshongoire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 83:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:1">Zab 28:1</ref>. </char>
    </note> Ai Ruhanga, otaceceka, otahunama,</para>
  <para style="q1" vid="PSA 83:1">Kandi otahugaho, ai Ruhanga!<verse eid="PSA 83:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:1">Zab 2:1</ref>; <ref loc="JDG 8:28">Bar 8:28</ref>. </char>
    </note> Ahabw'okuba abazigu baawe bajagaraire,</para>
  <para style="q1" vid="PSA 83:2">N'abarikukwanga baimukize emitwe nibeekunika.<verse eid="PSA 83:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:3: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 4:8">Neh 4:8</ref>; <ref loc="PSA 27:5">Zab 27:5</ref>. </char>
    </note> Bacumiire abantu baawe enaama mbi,</para>
  <para style="q1" vid="PSA 83:3">Nibahanuura hamwe kukora kubi abu waasherekire.<verse eid="PSA 83:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:8">Zab 74:8</ref>; <ref loc="JER 48:2">Yer 48:2</ref>; <ref loc="EST 3:6">Est 3:6</ref>. </char>
    </note> Nibagira bati: Nimwije tubamareho, barekye kuba eihanga,</para>
  <para style="q1" vid="PSA 83:4">Eiziina rya Israeli ritagaruka kwijukwa obundi.<verse eid="PSA 83:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5" />Ahakuba bakahanuura hamwe n'omutima gumwe;</para>
  <para style="q1" vid="PSA 83:5">Baakora endagaano y'okukurwanisa,<verse eid="PSA 83:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 25:12-16">Kut 25:12-16</ref>; <ref loc="2CH 20:10">2 Bus 20:10</ref>. </char>
    </note> Nibo Banyedomu n'Abaishimaeli abatuura omu mahema,<verse eid="PSA 83:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:7: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 14:1">1 Sam 14:1</ref>; <ref loc="1SA 15:2">15:2</ref>. </char>
    </note> Abagebali, Abaamoni n'Abaamaleki,</para>
  <para style="q1" vid="PSA 83:7">Abafilistia n'abatuura omuri Tuuro;<verse eid="PSA 83:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:8: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 2:9">Bir 2:9</ref>, <ref loc="DEU 2:19">19</ref>; <ref loc="2KI 15:19">2 Bag 15:19</ref>. </char>
    </note> Abasiria bakwataniise nabo,</para>
  <para style="q1" vid="PSA 83:8">Baaha emikono aba Looti. Sela.<verse eid="PSA 83:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:9: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 31:7">Kub 31:7</ref>; <ref loc="JDG 4:7">Bar 4:7</ref>, <ref loc="JDG 4:15">15</ref>; <ref loc="JDG 5:21">5:21</ref>; <ref loc="ISA 9:4">Isa 9:4</ref>. </char>
    </note> Obagire nk'oku waagizire Abamidiani,</para>
  <para style="q1" vid="PSA 83:9">Nka Sisera na Yabini aha mugyera Kisoni.<verse eid="PSA 83:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10" />Abacwekyerereziibwe Endoori</para>
  <para style="q1" vid="PSA 83:10">Bakahinduka nk'amasha omu itaka.<verse eid="PSA 83:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:11: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 7:25">Bar 7:25</ref>; <ref loc="JDG 8:5">8:5</ref>, <ref loc="JDG 8:21">21</ref>. </char>
    </note> Abakuru baabo obagire nka Orebu na Zeebu,</para>
  <para style="q1" vid="PSA 83:11">N'abanyiginya baabo boona nka Zeeba na Zalumuuna,<verse eid="PSA 83:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:12: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 20:11">2 Bus 20:11</ref>. </char>
    </note> Abagizire bati: Ka twetwarire amaka ga Ruhanga, tuganyagye!<verse eid="PSA 83:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 21:18">Yob 21:18</ref>; <ref loc="ISA 17:13">Isa 17:13</ref>. </char>
    </note> Ruhanga wangye, obagire nk'omucuucu ogurikutwarwa akasooroora,</para>
  <para style="q1" vid="PSA 83:13">Nk'ebishushunga ebiririkutwarwa omuyaga.<verse eid="PSA 83:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:22">Bir 32:22</ref>; <ref loc="ISA 9:18">Isa 9:18</ref>. </char>
    </note> Nk'oku omuriro gurikwotsya ekibira,</para>
  <para style="q1" vid="PSA 83:14">Nk'oku omuriro gurikwotsya ebibungo, bikabuguma,<verse eid="PSA 83:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 83:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 9:17">Yob 9:17</ref>. </char>
    </note> Obe nikwo waabakurata n'omuyaga gwawe ogw'amaani,</para>
  <para style="q1" vid="PSA 83:15">Kandi obatiinise n'eihunga ryawe.<verse eid="PSA 83:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:16, 17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4">Zab 35:4</ref>, <ref loc="PSA 35:26">26</ref>. </char>
    </note> Oitse amaisho gaabo enshoni,</para>
  <para style="q1" vid="PSA 83:16">Babone kusherura eiziina ryawe, ai MUKAMA.<verse eid="PSA 83:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17" />Bakwatwe enshoni, batiine ebiro byona;</para>
  <para style="q1" vid="PSA 83:17">Baburaburirwe, bahwerekyerere;<verse eid="PSA 83:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">83:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:13">Zab 59:13</ref>; <ref loc="PSA 97:9">97:9</ref>; <ref loc="EXO 6:3">Kur 6:3</ref>. </char>
    </note> Bamanye ngu niiwe wenka, orikwetwa Yehova,</para>
  <para style="q1" vid="PSA 83:18">Okira boona, kandi otegyeka ensi yoona.<verse eid="PSA 83:18" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" sid="PSA 84" />
  <para style="s1">Okugira orushusho rw'okuramiza omu nju ya Ruhanga</para>
  <para style="d">Aha Mukuru w'abeeshongozi omu iraka ry'ekigitiiti. Zaaburi ya Beene Koora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 84:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 43:3">Zab 43:3</ref>. </char>
    </note> Ai MUKAMA ow'amahe,</para>
  <para style="q1" vid="PSA 84:1">Ahu otuura ka ni harungi!<verse eid="PSA 84:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:4">Zab 27:4</ref>; <ref loc="PSA 42:1">42:1</ref>, <ref loc="PSA 42:2">2</ref>; <ref loc="PSA 63:1">63:1</ref>. </char>
    </note> Amagara gangye ni geetenga kureeba ebikaari byawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 84:2">Nangwa kigareeteire n'okugwa enshazi;</para>
  <para style="q1" vid="PSA 84:2">Omutima gwangye n'omubiri gwangye nibitakira Ruhanga ohuriire.<verse eid="PSA 84:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:2">Zab 5:2</ref>. </char>
    </note> Ekiteerankumba kigira obutaaho,</para>
  <para style="q1" vid="PSA 84:3">N'entaratambi egira ekyashuri, ahi ezaarira obwana bwayo,</para>
  <para style="q1" vid="PSA 84:3">Nigo matambiro gaawe, ai MUKAMA ow'amahe, Mukama wangye, kandi Ruhanga wangye.<verse eid="PSA 84:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:5">Zab 42:5</ref>, <ref loc="PSA 42:11">11</ref>; <ref loc="PSA 65:4">65:4</ref>. </char>
    </note> Baine omugisha abatuura omu nju yaawe;</para>
  <para style="q1" vid="PSA 84:4">Baryaguma nibakuhimbisa Sela.<verse eid="PSA 84:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5" />Aine omugisha omuntu, ou amaani ge gaba omuriiwe,</para>
  <para style="q1" vid="PSA 84:5">Omu mutima gwe hakabamu emihanda erikuza Saayuuni.<verse eid="PSA 84:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:6: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 34:26">Ezk 34:26</ref>. </char>
    </note> Ku baba nibaraba omu <note caller="+" style="f"><char style="fr" closed="false">84:6 </char><char style="ft" closed="false">Omu Ruheburaayo oruhanga rw'amarira nirwetwa oruhanga rwa Baaka. </char></note>ruhanga rw'amarira,</para>
  <para style="q1" vid="PSA 84:6">Baruhindura omwanya gw'enshuro z'amaizi;</para>
  <para style="q1" vid="PSA 84:6">Kandi enjura y'empangukano erushweka emigisha.<verse eid="PSA 84:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:2">Zab 42:2</ref>; <ref loc="PRO 4:18">Enf 4:18</ref>; <ref loc="ISA 40:31">Isa 40:31</ref>; <ref loc="2CO 3:18">2 Kor 3:18</ref>. </char>
    </note> Bagyenda nibeeyongyera amaani;</para>
  <para style="q1" vid="PSA 84:7">Buri muntu omuribo areebwa omu maisho ga Ruhanga omuri Saayuuni.<verse eid="PSA 84:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:5">Zab 59:5</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'amahe, hurira okushaba kwangye;</para>
  <para style="q1" vid="PSA 84:8">Otegye okutu, ai Ruhanga wa Yakobo. <char style="qs">Sela.</char><verse eid="PSA 84:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:3">Zab 3:3</ref>. </char>
    </note> Ai Ruhanga reeba engabo yaitu,</para>
  <para style="q1" vid="PSA 84:9">Kandi oreebe ahamaisho g'ogwo ou waashukireho amajuta.<verse eid="PSA 84:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:2">Zab 15:2</ref>; <ref loc="PSA 34:9">34:9</ref>, <ref loc="PSA 34:10">10</ref>; <ref loc="PRO 2:7">Enf 2:7</ref>; <ref loc="ISA 60:19">Isa 60:19</ref>, <ref loc="ISA 60:20">20</ref>; <ref loc="MAL 4:2">Mal 4:2</ref>; <ref loc="REV 21:11">Kush 21:11</ref>, <ref loc="REV 21:23">23</ref>. </char>
    </note> Ahakuba okumara ekiro kimwe omu bikaari byawe</para>
  <para style="q1" vid="PSA 84:10">Nikikira okumara ebiro rukumi ahandi.</para>
  <para style="q1" vid="PSA 84:10">Nkaayenzire kuba omukumiirizi omu nju ya Ruhanga wangye,</para>
  <para style="q1" vid="PSA 84:10">Okukira okutuura omu mahema g'obubi.<verse eid="PSA 84:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11" />Ahakuba MUKAMA Ruhanga niwe izooba kandi engabo;</para>
  <para style="q1" vid="PSA 84:11">MUKAMA aha embabazi n'ekitiinisa;</para>
  <para style="q1" vid="PSA 84:11">Taine kirungi kyona eki aima abagyendera omu mazima.<verse eid="PSA 84:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">84:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:12">Zab 2:12</ref>. </char>
    </note> Ai MUKAMA ow'amahe,</para>
  <para style="q1" vid="PSA 84:12">Omuntu orikukwesiga aine omugisha.<verse eid="PSA 84:12" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" sid="PSA 85" />
  <para style="s1">Okushaba Ruhanga okutugirira embabazi n'okumwesiga</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Beene koora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 85:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:7">Zab 14:7</ref>. </char>
    </note> MUKAMA, okagirira ensi yaawe embabazi;</para>
  <para style="q1" vid="PSA 85:1">Waagarura aba Yakobo abaabaire banyagirwe.<verse eid="PSA 85:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:2, 3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:1">Zab 32:1</ref>; <ref loc="PSA 78:38">78:38</ref>; <ref loc="JON 3:9">Yon 3:9</ref>. </char>
    </note> Okaihaho okutahikiirira kw'abantu baawe;</para>
  <para style="q1" vid="PSA 85:2">Waasaasira ebibi byabo byona.<verse eid="PSA 85:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3" />Okaihaho ekiniga kyawe kyona;</para>
  <para style="q1" vid="PSA 85:3">Waareka ekiniga kyawe ekirikwaka.<verse eid="PSA 85:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:3">Zab 80:3</ref>. </char>
    </note> Otugarure aha buteeka, ai Ruhanga ow'okujunwa kwaitu,</para>
  <para style="q1" vid="PSA 85:4">Kandi orekye kutugwerwa kubi!<verse eid="PSA 85:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:5">Zab 79:5</ref>. </char>
    </note> Oryatugirira ekiniga ebiro byona?</para>
  <para style="q1" vid="PSA 85:5">Oryaguma ogwereirwe kubi ab'obusingye bwona?<verse eid="PSA 85:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:20">Zab 71:20</ref>; <ref loc="PSA 90:14">90:14</ref>. </char>
    </note> Toritugaruramu amagara,</para>
  <para style="q1" vid="PSA 85:6">Abantu baawe bakashemerererwa omuriiwe?<verse eid="PSA 85:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7" />Otworekye embabazi zaawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 85:7">Otuhe okujuna kwawe.<verse eid="PSA 85:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:8: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 2:1">Hab 2:1</ref>; <ref loc="ZEC 9:10">Zek 9:10</ref>; <ref loc="2PE 2:21">2 Pet 2:21</ref>. </char>
    </note> Ka mpurire ebi Ruhanga MUKAMA araagambe,</para>
  <para style="q1" vid="PSA 85:8">Ahakuba naija kugambira abantu be n'abarikwera be eby'obusingye;</para>
  <para style="q1" vid="PSA 85:8">Kwonka barekye kugaruka omu bushema.<verse eid="PSA 85:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:9: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 2:5">Zek 2:5</ref>; <ref loc="ISA 46:13">Isa 46:13</ref>. </char>
    </note> Buzimazima okujuna kwe kuri haihi n'abarikumutiina,</para>
  <para style="q1" vid="PSA 85:9">Ngu ekitiinisa kibone kuguma omu nsi yaitu.<verse eid="PSA 85:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:3">Zab 72:3</ref>; <ref loc="PSA 89:14">89:14</ref>; <ref loc="ISA 32:17">Isa 32:17</ref>; <ref loc="MIC 7:20">Mik 7:20</ref>. </char>
    </note> Okusaasira n'amazima biryakwatanisa,</para>
  <para style="q1" vid="PSA 85:10">Okuhikiirira n'obusingye binywegyerane.<verse eid="PSA 85:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:11: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:8">Isa 45:8</ref>. </char>
    </note> Amazima gamezire omu itaka;</para>
  <para style="q1" vid="PSA 85:11">N'okuhikiirira kwemire omu iguru, kwareeba aha nsi.<verse eid="PSA 85:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 67:6">Zab 67:6</ref>; <ref loc="PSA 84:11">84:11</ref>; <ref loc="JAS 1:17">Yak 1:17</ref>. </char>
    </note> Eego, MUKAMA aryagaba ekirungi,</para>
  <para style="q1" vid="PSA 85:12">N'ensi yaitu eryareeta omweru gwayo.<verse eid="PSA 85:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">85:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 58:8">Isa 58:8</ref>. </char>
    </note> Okuhikiirira kuryamwebembera,</para>
  <para style="q1" vid="PSA 85:13">Kumubandire ah'okuraba.<verse eid="PSA 85:13" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" sid="PSA 86" />
  <para style="s1">Okushaba kw'omuntu wa Ruhanga omu biro by'emirabanamu</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 86:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:2">Zab 31:2</ref>; <ref loc="PSA 40:17">40:17</ref>. </char>
    </note> Tega okutu, ai MUKAMA, ongarukyemu;</para>
  <para style="q1" vid="PSA 86:1">Ahabw'okuba ndi omworo kandi omukyene.<verse eid="PSA 86:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2" />Orinde amagara gangye, ahakuba nintiina Ruhanga;</para>
  <para style="q1" vid="PSA 86:2">Iwe Ruhanga wangye, juna omwiru waawe orikukwesiga.<verse eid="PSA 86:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:1">Zab 56:1</ref>; <ref loc="PSA 57:1">57:1</ref>. </char>
    </note> Ongirire embabazi, ai Mukama;</para>
  <para style="q1" vid="PSA 86:3">ahakuba niiwe ntakira eizooba ryona.<verse eid="PSA 86:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:1">Zab 25:1</ref>. </char>
    </note> Ohe amagara g'omwiru waawe okushemererwa;</para>
  <para style="q1" vid="PSA 86:4">Ahakuba, ai Mukama, nyimutysa omutima gwangye ahariiwe.<verse eid="PSA 86:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:4">Zab 130:4</ref>; <ref loc="NUM 14:18">Kub 14:18</ref>. </char>
    </note> Ahabw'okuba Iwe Mukama ori murungi, orahuka kusaasira,</para>
  <para style="q1" vid="PSA 86:5">Kandi ogira embabazi nyingi ahari boona abakutakira.<verse eid="PSA 86:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:1">Zab 55:1</ref>. </char>
    </note> Otegye okutu okushaba kwangye, ai MUKAMA;</para>
  <para style="q1" vid="PSA 86:6">Kandi ohurire eiraka ry'okweshengyereza kwangye.<verse eid="PSA 86:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:6">Zab 17:6</ref>; <ref loc="PSA 77:2">77:2</ref>. </char>
    </note> Aha kiro eki ndireeberaho enaku, ndyakutakira;</para>
  <para style="q1" vid="PSA 86:7">Ahakuba oryangarukamu.<verse eid="PSA 86:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:10">Zab 35:10</ref>; <ref loc="1SA 2:2">1 Sam 2:2</ref>; <ref loc="DEU 3:24">Bir 3:24</ref>; <ref loc="EXO 15:11">Kur 15:11</ref>. </char>
    </note> Omuri baaruhanga abandi tiharimu orikushushana naiwe, ai Mukama;</para>
  <para style="q1" vid="PSA 86:8">Kandi omu birikukorwa byona tiharimu ebiri nk'ebyawe.<verse eid="PSA 86:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:4">Zab 66:4</ref>; <ref loc="ISA 66:23">Isa 66:23</ref>; <ref loc="REV 15:4">Kush 15:4</ref>. </char>
    </note> Amahanga goona agu waahangire garyaija,</para>
  <para style="q1" vid="PSA 86:9">Gakwinamire, ai Mukama, kandi gahimbise eiziina ryawe.<verse eid="PSA 86:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:18">Zab 72:18</ref>; <ref loc="DEU 6:4">Bir 6:4</ref>; <ref loc="ISA 37:16">Isa 37:16</ref>; <ref loc="1CO 8:4">1 Kor 8:4</ref>; <ref loc="EPH 4:6">Efe 4:6</ref>. </char>
    </note> Ahakuba ori mukuru, okora eby'okutangaaza;</para>
  <para style="q1" vid="PSA 86:10">Kandi niiwe Ruhanga wenka.<verse eid="PSA 86:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:4">Zab 25:4</ref>; <ref loc="PSA 26:3">26:3</ref>. </char>
    </note> Ai MUKAMA, onyegyese omuhanda gwawe,</para>
  <para style="q1" vid="PSA 86:11">Mbone kugyendera omu mazima gaawe;</para>
  <para style="q1" vid="PSA 86:11">Teerana hamwe ebiri omu mutima gwangye,</para>
  <para style="q1" vid="PSA 86:11">Gubone kutiina eiziina ryawe.<verse eid="PSA 86:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12" />Ndyakuhimbisa, Mukama Ruhanga wangye, n'omutima gwangye gwona,</para>
  <para style="q1" vid="PSA 86:12">Mpe eiziina ryawe ekitiinisa ebiro byona.<verse eid="PSA 86:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:3">Zab 30:3</ref>; <ref loc="PSA 56:13">56:13</ref>. </char>
    </note> Ahakuba onyiniire okusaasira kwingi,</para>
  <para style="q1" vid="PSA 86:13">Kandi oihire amagara gangye okuzimu owa Nyamuteza.<verse eid="PSA 86:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:3">Zab 54:3</ref>. </char>
    </note> Ai Ruhanga abanyamaryo banyimukiriire,</para>
  <para style="q1" vid="PSA 86:14">Omutwe gw'abataine saasi nigucwa obwengye bw'okuunyita,</para>
  <para style="q1" vid="PSA 86:14">Kandi tibakwetaireho.<verse eid="PSA 86:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:8">Zab 103:8</ref>; <ref loc="PSA 111:4">111:4</ref>; <ref loc="PSA 145:8">145:8</ref>; <ref loc="JOL 2:13">Yoel 2:13</ref>; <ref loc="JON 4:2">Yon 4:2</ref>; <ref loc="NEH 9:17">Neh 9:17</ref>; <ref loc="EXO 34:6">Kur 34:6</ref>. </char>
    </note> Kwonka Iwe Mukama, ori Ruhanga oijwire okusaasira n'embabazi,</para>
  <para style="q1" vid="PSA 86:15">Otarahuka kuguubwa kubi, oine embabazi nyingi n'amazima.<verse eid="PSA 86:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:16">Zab 25:16</ref>; <ref loc="PSA 116:16">116:16</ref>. </char>
    </note> Ompindukire, onsaasire;</para>
  <para style="q1" vid="PSA 86:16">Ohe omwiru waawe amaani gaawe,</para>
  <para style="q1" vid="PSA 86:16">Kandi ojune omwana w'omuzaana waawe.<verse eid="PSA 86:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">86:17: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 6:17">Bar 6:17</ref>. </char>
    </note> Onyorekye akamanyiso akarikuhamya ku onkunda,</para>
  <para style="q1" vid="PSA 86:17">Abarikuunyanga bakireebe, bahemukye;</para>
  <para style="q1" vid="PSA 86:17">Ahakuba MUKAMA, niiwe ompwereire, okampuumuza omutima.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" sid="PSA 87" />
  <para style="s1">Eby'Orurembo rwa Mukama orw'ekitiinisa</para>
  <para style="d">Zaaburi ya Beene Koora, ei baayeshongoire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:6">Zab 2:6</ref>; <ref loc="ISA 28:16">Isa 28:16</ref>. </char>
    </note> Omusingi ogu yaataireho guri aha bibungo birikwera.<verse eid="PSA 87:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:67">Zab 78:67</ref>, <ref loc="PSA 78:68">68</ref>. </char>
    </note> MUKAMA naakunda amarembo ga Saayuuni</para>
  <para style="q1" vid="PSA 87:2">Okukira amaka goona aga Yakobo.<verse eid="PSA 87:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:4">Zab 46:4</ref>; <ref loc="ISA 60:1">Isa 60:1</ref>, <ref loc="ISA 60:2">2</ref>. </char>
    </note> Iwe orurembo rwa Ruhanga, ogambwaho eby'ekitiinisa. Sela.<verse eid="PSA 87:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4" />Ahari abo abarikummanya ndyagamba ahari Rahabu na Babulooni;</para>
  <para style="q1" vid="PSA 87:4">Reeba Filistia na Tuuro hamwe na Esiopia;</para>
  <para style="q1" vid="PSA 87:4">Ogu niyo yaazaariirwe.<verse eid="PSA 87:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:8">Zab 48:8</ref>. </char>
    </note> Eego baryagamba ahari Saayuuni bati:</para>
  <para style="q1" vid="PSA 87:5">Ogu n'oriya niyo baazaariirwe.</para>
  <para style="q1" vid="PSA 87:5">Ahakuba Rukira-boona niwe arigigumya wenka.<verse eid="PSA 87:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 4:3">Isa 4:3</ref>; <ref loc="EZK 13:9">Ezk 13:9</ref>. </char>
    </note> MUKAMA ku arihandiika abantu, aryahamya ati:</para>
  <para style="q1" vid="PSA 87:6">Ogu niyo yaazaariirwe. <char style="qs">Sela</char><verse eid="PSA 87:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">87:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 12:3">Isa 12:3</ref>; <ref loc="REV 21:6">Kush 21:6</ref>. </char>
    </note> Abeeshongozi n'abazini nabo baryagira bati:</para>
  <para style="q1" vid="PSA 87:7">Enshuro zangye zoona ziri omuriiwe.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" sid="PSA 88" />
  <para style="s1">Okushaba kw'omurwire ari wenka</para>
  <para style="d">Zaaburi ya Beene Koora. Aha Mukuru w'abeeshongozi omu iraka eririkwetwa Mahalaasi-Leanoosi. Zaaburi ya Hemani Omuezerahi, eyaagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 88:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:2">Zab 22:2</ref>; <ref loc="PSA 24:5">24:5</ref>; <ref loc="LUK 18:7">Luk 18:7</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'okujunwa kwangye,</para>
  <para style="q1" vid="PSA 88:1">Ntakira omu maisho gaawe nyomushana na nyekiro;<verse eid="PSA 88:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2" />Okushaba kwangye kukuhikyeho;</para>
  <para style="q1" vid="PSA 88:2">Otegye okutu okutaka kwangye;<verse eid="PSA 88:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:18">Zab 107:18</ref>. </char>
    </note> Ahakuba omutima gwangye gwijwire enaku,</para>
  <para style="q1" vid="PSA 88:3">N'amagara gangye gari haihi kuza Okuzimu.<verse eid="PSA 88:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:1">Zab 28:1</ref>. </char>
    </note> Nimbarirwa hamwe n'abarikushuuma omu Kiina;</para>
  <para style="q1" vid="PSA 88:4">Ndi nk'otaine kihwera,<verse eid="PSA 88:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:12">Zab 31:12</ref>. </char>
    </note> Nnagirwe hamwe n'abafu, nk'abaitsirwe abari omu kituuro,</para>
  <para style="q1" vid="PSA 88:5">Abu otakiijuka, kandi abataanisiibwe n'omukono gwawe.<verse eid="PSA 88:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:3">Zab 143:3</ref>; <ref loc="LAM 3:6">Tonz 3:6</ref>. </char>
    </note> Ontaire omu Kiina kiraingwa munonga,</para>
  <para style="q1" vid="PSA 88:6">Omu myanya y'omwirima okuzimu hare.<verse eid="PSA 88:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:4">Zab 32:4</ref>; <ref loc="PSA 42:7">42:7</ref>. </char>
    </note> Ekiniga kyawe kimbandamiire,</para>
  <para style="q1" vid="PSA 88:7">Kandi ebingonzi byawe bimmiriire kimwe. Sela.<verse eid="PSA 88:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:13">Yob 19:13</ref>; <ref loc="JOB 30:10">30:10</ref>; <ref loc="JER 32:2">Yer 32:2</ref>. </char>
    </note> Oreeteire abamanyi kuunyetantara,</para>
  <para style="q1" vid="PSA 88:8">Wampindura eki barikunuga;</para>
  <para style="q1" vid="PSA 88:8">Nkingirainwe, tindikubaasa kushohora.<verse eid="PSA 88:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:7">Zab 6:7</ref>; <ref loc="JOB 11:13">Yob 11:13</ref>. </char>
    </note> Eriisho ringwire omunda ahabw'okubonabonesibwa;</para>
  <para style="q1" vid="PSA 88:9">Buri izooba nkutakira, nkutegire emikono, ai MUKAMA.<verse eid="PSA 88:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:10, 11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:5">Zab 6:5</ref>. </char>
    </note> Ebyo oryayoreka abafu eby'okutangaaza?</para>
  <para style="q1" vid="PSA 88:10">Abafiire baryazooka, bakuhimbise?<verse eid="PSA 88:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11" />Embabazi zaawe ziryagambirwa okuzimu,</para>
  <para style="q1" vid="PSA 88:11">Nari okwesigwa kwawe omu ihwero?<verse eid="PSA 88:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:21">Yob 10:21</ref>; <ref loc="ECC 9:5">Mub 9:5</ref>. </char>
    </note> Eby'okutangaaza byawe biryamanyirwa omu mwirima,</para>
  <para style="q1" vid="PSA 88:12">Nari okuhikiirira kwawe omu nsi y'abayebire?<verse eid="PSA 88:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:3">Zab 5:3</ref>. </char>
    </note> Kwonka ai MUKAMA, niiwe ntakira;</para>
  <para style="q1" vid="PSA 88:13">Buri kasheeshe okushaba kwangye kukuhikaho.<verse eid="PSA 88:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 13:24">Yob 13:24</ref>. </char>
    </note> MUKAMA, onagiire ki amagara gangye?</para>
  <para style="q1" vid="PSA 88:14">Ahabw'enki onyimire amaisho?<verse eid="PSA 88:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:15, 16: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 6:4">Yob 6:4</ref>; <ref loc="JOB 9:34">9:34</ref>. </char>
    </note> Nkaiha omu buto nimbonabona, ndi haihi kufa;</para>
  <para style="q1" vid="PSA 88:15">Ebirikutiinisa byawe ku bimpikaho, nyehwa amatsiko.<verse eid="PSA 88:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16" />Ekiniga kyawe ekingi kindengyeireho;</para>
  <para style="q1" vid="PSA 88:16">N'eby'okutiinisa byawe bincwekyereize.<verse eid="PSA 88:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:10">Zab 118:10</ref>. </char>
    </note> Binyehinguririza eizooba ryona nk'omwegyemure,</para>
  <para style="q1" vid="PSA 88:17">Nibindeetwa embaju zoona.<verse eid="PSA 88:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">88:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:13">Yob 19:13</ref>, <ref loc="JOB 19:14">14</ref>. </char>
    </note> Oreeteire nkunzi zangye n'abanywani bangye kuunyetantara;</para>
  <para style="q1" vid="PSA 88:18">Abarikummanya bari omu mwirima.<verse eid="PSA 88:18" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" sid="PSA 89" />
  <para style="s1">Endagaano ei Ruhanga yaaragaine na Daudi</para>
  <para style="d">Zaaburi ya Esaani Omuezerahi, eyaagunzirwe n'obwengye</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 89:1" />Ndyayeshongora eby'embabazi za MUKAMA ebiro byona;</para>
  <para style="q1" vid="PSA 89:1">Ndyaguma niinyeshongora eby'embabazi zaawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 89:1">Mmanyise ab'obusingye bwona okwesigwa kwawe n'akanwa kangye.<verse eid="PSA 89:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:5">Zab 36:5</ref>. </char>
    </note> Ahakuba ngizire nti: Embabazi zaawe ziryaguma zongyerweho ebiro byona;</para>
  <para style="q1" vid="PSA 89:2">Kandi okwesigwa kwawe kuryahamibwa omu iguru.<verse eid="PSA 89:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:11">Zab 132:11</ref>; <ref loc="1KI 8:16">1 Bag 8:16</ref>. </char>
    </note> Ndagaine endagaano n'ou naatooraine,</para>
  <para style="q1" vid="PSA 89:3">Nindahirira Daudi omwiru wangye, nti:<verse eid="PSA 89:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:8-16">2 Sam 7:8-16</ref>; <ref loc="1KI 9:5">1 Bag 9:5</ref>; <ref loc="ISA 9:7">Isa 9:7</ref>; <ref loc="JER 33:17">Yer 33:17</ref>; <ref loc="EZK 37:25">Ezk 37:25</ref>; <ref loc="LUK 1:32">Luk 1:32</ref>, <ref loc="LUK 1:33">33</ref>; <ref loc="JHN 12:34">Yoh 12:34</ref>. </char>
    </note> Baijukuru baawe ndyabagumyaho ebiro byona,</para>
  <para style="q1" vid="PSA 89:4">Mpamye ekitebe ky'obukama bwawe obusingye bwona. <char style="qs">Sela</char><verse eid="PSA 89:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Zab 19:1</ref>; <ref loc="PSA 50:6">50:6</ref>; <ref loc="JOB 5:1">Yob 5:1</ref>. </char>
    </note> Ai MUKAMA, eiguru rihimbisa eby'okutangaaza byawe,</para>
  <para style="q1" vid="PSA 89:5">Kandi n'okwesigwa kwawe omu mutwe gw'abarikwera.<verse eid="PSA 89:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 29:1">Zab 29:1</ref>; <ref loc="PSA 86:8">86:8</ref>; <ref loc="ISA 40:18">Isa 40:18</ref>. </char>
    </note> Ahakuba n'oha omu iguru orikubaasa kugyeranisibwa na MUKAMA?</para>
  <para style="q1" vid="PSA 89:6">N'oha omu b'omu iguru ori nka MUKAMA,<verse eid="PSA 89:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:2">Zab 47:2</ref>; <ref loc="PSA 103:20">103:20</ref>, <ref loc="PSA 103:21">21</ref>. </char>
    </note> Ruhanga ow'okutiinisa omu ishengyero ry'abahikiriire,</para>
  <para style="q1" vid="PSA 89:7">Kandi ow'okutiinwa okukira abamwehinguririize boona?<verse eid="PSA 89:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:10">Zab 35:10</ref>; <ref loc="PSA 68:4">68:4</ref>; <ref loc="1SA 2:2">1 Sam 2:2</ref>. </char>
    </note> Ai MUKAMA Ruhanga ow'amahe, n'oha ow'obushoboorozi nkaiwe,</para>
  <para style="q1" vid="PSA 89:8">Oyehinguririziibwe okwesigwa kwawe, ai MUKAMA?<verse eid="PSA 89:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:7">Zab 65:7</ref>. </char>
    </note> Niiwe otegyeka okuhinduriza kw'enyanja;</para>
  <para style="q1" vid="PSA 89:9">Ebingonzi byayo ku bisiikuuka, obicureeza.<verse eid="PSA 89:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:7">Isa 30:7</ref>. </char>
    </note> Okahondahonda Rahabu nk'oitsirwe,</para>
  <para style="q1" vid="PSA 89:10">Waabingisa abazigu baawe omukono gwawe ogw'amaani, baataataana.<verse eid="PSA 89:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11" />Eiguru n'eryawe, n'ensi nayo n'eyaawe;</para>
  <para style="q1" vid="PSA 89:11">Ensi n'ebirimu byona niiwe waabitaireho.<verse eid="PSA 89:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:8">Zab 98:8</ref>. </char>
    </note> Obukiizi-bwa-bumosho n'obwa-buryo niiwe waabihangire;</para>
  <para style="q1" vid="PSA 89:12">Tabora na Herumooni zishemerererwa eiziina ryawe;<verse eid="PSA 89:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13" />Oine omukono gw'obushoborozi;</para>
  <para style="q1" vid="PSA 89:13">Omukono gwawe n'ogw'amaani, omukono gwawe gwa buryo gubangirwe.<verse eid="PSA 89:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:13">Zab 85:13</ref>; <ref loc="PSA 97:2">97:2</ref>. </char>
    </note> Okuhikiirira n'amazima niyo misingi y'ekitebe kyawe ky'obukama;</para>
  <para style="q1" vid="PSA 89:14">Embabazi n'okwesigwa bikwebembera.<verse eid="PSA 89:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15" />Abarikumanya eiraka ry'okushemererwa baine omugisha;</para>
  <para style="q1" vid="PSA 89:15">Bagyendera omu mushana gw'amaisho gaawe, ai MUKAMA.<verse eid="PSA 89:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 20:5">Zab 20:5</ref>, <ref loc="PSA 20:7">7</ref>. </char>
    </note> Beesiimira eiziina ryawe eizooba ryona;</para>
  <para style="q1" vid="PSA 89:16">Kandi omu kuhikiirira kwawe nimwo batunguurirwa.<verse eid="PSA 89:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 75:10">Zab 75:10</ref>. </char>
    </note> Ahakuba niiwe kitiinisa ky'amaani gaabo;</para>
  <para style="q1" vid="PSA 89:17">Kandi embabazi zaawe nizo ziriimutsya eihembe ryaitu.<verse eid="PSA 89:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:9">Zab 47:9</ref>; <ref loc="PSA 71:22">71:22</ref>. </char>
    </note> Ahakuba engabo yaitu n'eya MUKAMA,</para>
  <para style="q1" vid="PSA 89:18">Kandi omugabe waitu n'ow'Orikwera wa Israeli.<verse eid="PSA 89:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19" />Omu bunaku obwa ira okagambira abarikwera baawe omu kworekwa oti:</para>
  <para style="q1" vid="PSA 89:19">Njwekire ow'amaani ekirunga;</para>
  <para style="q1" vid="PSA 89:19">Ntungwire owaatoorainwe omu bantu.<verse eid="PSA 89:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:20: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 16:13">1 Sam 16:13</ref>; <ref loc="ACT 13:22">Byak 13:22</ref>. </char>
    </note> Mboine Daudi omwiru wangye,</para>
  <para style="q1" vid="PSA 89:20">Naamushukaho amajuta gangye agarikwera.<verse eid="PSA 89:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21" />Engaro yangye eryaguma nawe obutoosha,</para>
  <para style="q1" vid="PSA 89:21">N'omukono gwangye guryamugumya.<verse eid="PSA 89:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:22, 23: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:9">2 Sam 7:9</ref>, <ref loc="2SA 7:10">10</ref>. </char>
    </note> Omuzigu tarimubuza bwengye;</para>
  <para style="q1" vid="PSA 89:22">N'omubi tarimubonabonesa.<verse eid="PSA 89:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23" />Ndyahondahondera ababisha be omu maisho ge,</para>
  <para style="q1" vid="PSA 89:23">N'abarikumwanga mbateere, bagwe.<verse eid="PSA 89:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:1">Zab 89:1</ref>. </char>
    </note> Kwonka okwesigwa kwangye n'embabazi zangye biryaguma nawe;</para>
  <para style="q1" vid="PSA 89:24">Kandi omu iziina ryangye eihembe rye nimwo riritunguurirwa.<verse eid="PSA 89:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:8">Zab 72:8</ref>. </char>
    </note> Ndyategyekyesa enyanja omukono gwe,</para>
  <para style="q1" vid="PSA 89:25">N'emigyera omukono gwe gwa buryo.<verse eid="PSA 89:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:26: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:14">2 Sam 7:14</ref>; <ref loc="1CH 22:10">1 Bus 22:10</ref>. </char>
    </note> Aryantakira ati: Niiwe Tata;</para>
  <para style="q1" vid="PSA 89:26">Ruhanga wangye, kandi orukiri rw'okujunwa kwangye.<verse eid="PSA 89:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:7">Zab 2:7</ref>; <ref loc="EXO 4:22">Kur 4:22</ref>; <ref loc="ROM 8:29">Rom 8:29</ref>; <ref loc="HEB 1:5">Heb 1:5</ref>; <ref loc="REV 1:5">Kush 1:5</ref>. </char>
    </note> Ndyamugira omujigaijo gwangye,</para>
  <para style="q1" vid="PSA 89:27">Omugabe orikukira abandi boona ab'omu nsi.<verse eid="PSA 89:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:3">Zab 89:3</ref>. </char>
    </note> Ndyamubiikira embabazi zangye ebiro n'ebiro,</para>
  <para style="q1" vid="PSA 89:28">N'ewendagaano yangye nawe eryahama.<verse eid="PSA 89:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:4">Zab 89:4</ref>; <ref loc="DEU 11:21">Bir 11:21</ref>. </char>
    </note> Ndyagumyaho oruzaaro rwe ebiro byona,</para>
  <para style="q1" vid="PSA 89:29">N'ekitebe kye ky'obugabe nk'ebiro by'eiguru.<verse eid="PSA 89:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:30: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:14">2 Sam 7:14</ref>; <ref loc="JER 9:13">Yer 9:13</ref>. </char>
    </note> Abaana be ku barireka ekiragiro kyangye,</para>
  <para style="q1" vid="PSA 89:30">Bataatwaza nk'oku naaragiire,<verse eid="PSA 89:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 89:31" />Kandi ku barishiisha ebi naataireho,</para>
  <para style="q1" vid="PSA 89:31">Bataayorobera biragiro byangye,<verse eid="PSA 89:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 89:32" />Ndyahanisa eby'okushiisha byabo enkoni,</para>
  <para style="q1" vid="PSA 89:32">N'okutahikiirira kwabo nkuhanise enkoba;<verse eid="PSA 89:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33" />Kwonka tindimwihiraho kimwe mbabazi zangye,</para>
  <para style="q1" vid="PSA 89:33">Kandi tindireka bwesigwa bwangye kuba ebishuba.<verse eid="PSA 89:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34" />Tindiita ndagaano yangye,</para>
  <para style="q1" vid="PSA 89:34">Nobu kwakuba okuhindura eki naagambire.<verse eid="PSA 89:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:35: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 4:2">Amo 4:2</ref>; <ref loc="HEB 6:17">Heb 6:17</ref>, <ref loc="HEB 6:18">18</ref>. </char>
    </note> Nkarahira okuhikiirira kwangye rimwe naaheza,</para>
  <para style="q1" vid="PSA 89:35">Tindibeiha Daudi.<verse eid="PSA 89:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:5">Zab 72:5</ref>; <ref loc="PSA 89:4">89:4</ref>. </char>
    </note> Oruzaaro rwe ruryagumaho ebiro byona,</para>
  <para style="q1" vid="PSA 89:36">N'ekitebe kye ky'obugabe kigume omu maisho gangye nk'eizooba.<verse eid="PSA 89:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:37: </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:35">Yer 31:35</ref>, <ref loc="JER 31:36">36</ref>. </char>
    </note> Kiryagumibwa ebiro byona nk'okwezi,</para>
  <para style="q1" vid="PSA 89:37">Kandi nk'omujurizi ow'okwesigwa omu iguru.<verse eid="PSA 89:37" /></para>
  <para style="s1">Okutakira Mukama ahabw'obugabe bwabo okugayibwa</para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:38: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:9">Zab 44:9</ref>. </char>
    </note> Kwonka hati onagire ou waashukireho amajuta,</para>
  <para style="q1" vid="PSA 89:38">Waamwanga, kandi waamugirira ekiniga;<verse eid="PSA 89:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:39: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:7">Zab 74:7</ref>; <ref loc="LAM 5:16">Tonz 5:16</ref>. </char>
    </note> Oyangiire kimwe endagaano ei waaragaine n'omwiru waawe;</para>
  <para style="q1" vid="PSA 89:39">Waashiisha ekirunga kye, waakinaga omu mucuucu.<verse eid="PSA 89:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:40, 41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:13">Zab 44:13</ref>; <ref loc="PSA 80:12">80:12</ref>. </char>
    </note> Osheenyire engo ze zoona,</para>
  <para style="q1" vid="PSA 89:40">N'engo ze z'amaani waazihwerekyereza.<verse eid="PSA 89:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41" />Abahinguzi boona nibamunyaga;</para>
  <para style="q1" vid="PSA 89:41">Ahindukire orikugaywa bataahi be.<verse eid="PSA 89:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42" />Otungwire omukono gw'ababisha be ogwa buryo;</para>
  <para style="q1" vid="PSA 89:42">Waareetera abazigu be boona kwesiima.<verse eid="PSA 89:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43" />Ogaranjwire rurara ye ey'obwogi,</para>
  <para style="q1" vid="PSA 89:43">Tiwaamubaasisa kwemerera ahamire omu rugamba.<verse eid="PSA 89:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44" />Omazireho ekitiinisa kye,</para>
  <para style="q1" vid="PSA 89:44">Waanaga ahansi ekitebe kye ky'obugabe.<verse eid="PSA 89:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:45: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:23">Zab 102:23</ref>; <ref loc="PSA 109:29">109:29</ref>. </char>
    </note> Otuubize ebiro by'obutsigazi bwe,</para>
  <para style="q1" vid="PSA 89:45">Waamujweka enshoni. Sela.<verse eid="PSA 89:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:46: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:1">Zab 13:1</ref>. </char>
    </note> Oryahitsya hi, ai MUKAMA, okweshereka ebiro byona?</para>
  <para style="q1" vid="PSA 89:46">Ekiniga kyawe kiryahitsya hi okwaka nk'omuriro?<verse eid="PSA 89:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:47: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:5">Zab 39:5</ref>; <ref loc="JOB 7:7">Yob 7:7</ref>; <ref loc="JOB 14:1">14:1</ref>. </char>
    </note> Ijuka ebiro byangye ku biri bikye,</para>
  <para style="q1" vid="PSA 89:47">Abaana b'abantu ka waabahangiire busha!<verse eid="PSA 89:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:48: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 49:9">Zab 49:9</ref>; <ref loc="HEB 11:5">Heb 11:5</ref>. </char>
    </note> Ni muntu ki origuma ari ohuriire, atafe,</para>
  <para style="q1" vid="PSA 89:48">Akaiha amagara ge omu bushoboorozi bw'Okuzimu? Sela.<verse eid="PSA 89:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49" />Mukama, embabazi zaawe eza ira ziri nkahi,</para>
  <para style="q1" vid="PSA 89:49">Ezi waarahiriire Daudi omu bwesigwa bwawe?<verse eid="PSA 89:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:50, 51: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:18">Zab 74:18</ref>, <ref loc="PSA 74:22">22</ref>; <ref loc="PSA 79:12">79:12</ref>. </char>
    </note> Mukama, ijuka oku barikujuma abairu baawe,</para>
  <para style="q1" vid="PSA 89:50">Oku ndikugumisiririza ebijumo by'amahanga goona ag'amaani,<verse eid="PSA 89:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51" />Ebi abazigu baawe barikujuma ou waashukireho amajuta, ai MUKAMA,</para>
  <para style="q1" vid="PSA 89:51">Bakashekyerera emigyendere ye.<verse eid="PSA 89:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">89:52: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:13">Zab 41:13</ref>. </char>
    </note> MUKAMA asiimwe ebiro n'ebiro. Amiina kandi Amiina.<verse eid="PSA 89:52" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" sid="PSA 90" />
  <para style="ms">EKITABO KYA KANA</para>
  <para style="s1">Obuhungiro bw'abantu ni Ruhanga otahwaho</para>
  <para style="d">Okushaba kwa Musa, omushaija wa Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 90:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:3">Zab 71:3</ref>. </char>
    </note> MUKAMA, niiwe waabaire ori obutaaho bwaitu obusingye bwona.<verse eid="PSA 90:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:2: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:26">Yob 36:26</ref>; <ref loc="PRO 8:25">Enf 8:25</ref>. </char>
    </note> Ebibungo bitakabaireho, otakahangire nsi n'ebirimu byona,</para>
  <para style="q1" vid="PSA 90:2">Okwiha obusingye bwona n'okuhitsya obusingye bwona</para>
  <para style="q1" vid="PSA 90:2">Niiwe Ruhanga.<verse eid="PSA 90:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:3: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 3:19">Kut 3:19</ref>; <ref loc="ECC 12:7">Mub 12:7</ref>. </char>
    </note> Ogarura abantu omu mucuucu,</para>
  <para style="q1" vid="PSA 90:3">Noogira oti: Nimugarukyeyo, imwe bantu 'mwe!<verse eid="PSA 90:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:4: </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:8">2 Pet 3:8</ref>. </char>
    </note> Ahakuba emyaka rukumi omu maisho gaawe</para>
  <para style="q1" vid="PSA 90:4">Eri nk'eizooba rya nyomwabazyo erihweire,</para>
  <para style="q1" vid="PSA 90:4">Nari nk'ahu abantu basisiimukira nyekiro.<verse eid="PSA 90:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:15">Zab 103:15</ref>; <ref loc="JOB 20:8">Yob 20:8</ref>; <ref loc="ISA 40:6-8">Isa 40:6-8</ref>. </char>
    </note> Obatwarira kimwe, nk'abarikutwarwa omwegyemure;</para>
  <para style="q1" vid="PSA 90:5">Bari nk'abagwejegyeire;</para>
  <para style="q1" vid="PSA 90:5">Omu kasheeshe baba nk'obunyaatsi oburikumera;<verse eid="PSA 90:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 4:20">Yob 4:20</ref>; <ref loc="JOB 14:2">14:2</ref>; <ref loc="JAS 1:11">Yak 1:11</ref>. </char>
    </note> Omu kasheeshe butooka, kandi bukura;</para>
  <para style="q1" vid="PSA 90:6">Omu mwabazyo butemwa, kandi buhonga;<verse eid="PSA 90:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7" />Ahakuba tumazirweho okuguubwa kubi kwawe,</para>
  <para style="q1" vid="PSA 90:7">N'ekiniga kyawe nikitureebesa enaku.<verse eid="PSA 90:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:12">Zab 19:12</ref>; <ref loc="JER 16:17">Yer 16:17</ref>; <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> Oyetaire okutahikiirira kwaitu omu maisho,</para>
  <para style="q1" vid="PSA 90:8">N'ebibi byaitu ebisherekirwe waabita omu mushana gw'amaisho gaawe.<verse eid="PSA 90:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9" />Ahakuba ebiro byaitu byona bigyenda nibihwaho otwiniire ekiniga,</para>
  <para style="q1" vid="PSA 90:9">Emyaka yaitu ehwaho nk'omwityso.<verse eid="PSA 90:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10" />Emyaka y'amagara gaitu eba makumi mushanju,</para>
  <para style="q1" vid="PSA 90:10">Nari ku tuba twagizire amaani, ehika makumi munaana;</para>
  <para style="q1" vid="PSA 90:10">Kwonka okugyogamu n'okufa kubi n'okureeba enaku;</para>
  <para style="q1" vid="PSA 90:10">ahakuba erahuka kuhwaho, naitwe twegyendera.<verse eid="PSA 90:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11" />N'oha orikumanya amaani g'okuguubwa kubi kwawe,</para>
  <para style="q1" vid="PSA 90:11">N'ekiniga kyawe, oku oshemereire kutiinwa?<verse eid="PSA 90:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:4">Zab 39:4</ref>. </char>
    </note> N'ahabw'ekyo otwegyese kubara ebiro byaitu,</para>
  <para style="q1" vid="PSA 90:12">Tubone kugira omutima gw'obwengye.<verse eid="PSA 90:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:9">Zab 74:9</ref>, <ref loc="PSA 74:10">10</ref>; <ref loc="PSA 135:14">135:14</ref>; <ref loc="DEU 32:36">Bir 32:36</ref>. </char>
    </note> Garuka, ai MUKAMA! Oryahitsya hi?</para>
  <para style="q1" vid="PSA 90:13">Saasira abairu baawe.<verse eid="PSA 90:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 85:6">Zab 85:6</ref>. </char>
    </note> Omu kasheeshe otuhaazye embabazi zaawe,</para>
  <para style="q1" vid="PSA 90:14">Tubone kushemererwa n'okwesiima ebiro byaitu byona.<verse eid="PSA 90:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15" />Otuhe okwesiima okurikwingana n'ebiro ebi waatubonaboneseizemu,</para>
  <para style="q1" vid="PSA 90:15">N'emyaka ei twareebeiremu enaku.<verse eid="PSA 90:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:4">Zab 92:4</ref>; <ref loc="HAB 3:2">Hab 3:2</ref>. </char>
    </note> Itwe abairu baawe, otworekye omurimo gwawe,</para>
  <para style="q1" vid="PSA 90:16">N'abaana baitu oboorekye ekitiinisa kyawe.<verse eid="PSA 90:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">90:17: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:12">Isa 26:12</ref>; <ref loc="2TH 2:16">2 Tes 2:16</ref>, <ref loc="2TH 2:17">17</ref>. </char>
    </note> Embabazi za Mukama Ruhanga waitu zigume ahariitwe,</para>
  <para style="q1" vid="PSA 90:17">Ohamye omurimo gw'emikono yaitu;</para>
  <para style="q1" vid="PSA 90:17">Eego, omurimo gw'emikono yaitu;</para>
  <para style="q1" vid="PSA 90:17">Eego, omurimo gw'emikono yaitu oguhamye.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" sid="PSA 91" />
  <para style="s1">Oku Ruhanga arinda abarikumwesiga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 91:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:7">Zab 32:7</ref>; <ref loc="PSA 121:5">121:5</ref>; <ref loc="ISA 25:4">Isa 25:4</ref>; <ref loc="ISA 32:2">32:2</ref>. </char>
    </note> Otuura omu mwanya gw'omubonano gwa Rukira-boona,</para>
  <para style="q1" vid="PSA 91:1">Kandi oguma asangiirwe Ow'obushoboorozi bwona,<verse eid="PSA 91:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:1">Zab 11:1</ref>; <ref loc="PSA 14:6">14:6</ref>; <ref loc="PSA 18:2">18:2</ref>. </char>
    </note> Aryagira MUKAMA ati: Niiwe buhungiro bwangye, kandi orugo rwangye orugumire,</para>
  <para style="q1" vid="PSA 91:2">Ruhanga wangye ou ndikwesiga.<verse eid="PSA 91:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 124:7">Zab 124:7</ref>. </char>
    </note> Aryakwiha omu mutego gw'omutegi,</para>
  <para style="q1" vid="PSA 91:3">akukize orufu orurikwita.<verse eid="PSA 91:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:2">Zab 35:2</ref>; <ref loc="PSA 57:1">57:1</ref>; <ref loc="PSA 61:4">61:4</ref>. </char>
    </note> Aryakushweka amoya ge,</para>
  <para style="q1" vid="PSA 91:4">Ahansi y'amapapa ge niho orishanga obuhungiro;</para>
  <para style="q1" vid="PSA 91:4">Amazima ge n'engabo n'akagabo.<verse eid="PSA 91:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:5-7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:19-23">Yob 5:19-23</ref>; <ref loc="PRO 3:25">Enf 3:25</ref>; <ref loc="ISA 43:1">Isa 43:1</ref>, <ref loc="ISA 43:2">2</ref>. </char>
    </note> Toritiina kirikutiinisa kyona nyekiro,</para>
  <para style="q1" vid="PSA 91:5">Nobu gwakuba omwambi ogurashwa nyomushana,<verse eid="PSA 91:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6" />Nari orufu orushoobera omu mwirima,</para>
  <para style="q1" vid="PSA 91:6">N'obu kwakuba okucwekyereza okumaraho abantu omu ihangwe.<verse eid="PSA 91:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7" />Abantu rukumi bakaagwa aha rubaju rwawe,</para>
  <para style="q1" vid="PSA 91:7">Na kakumi bagwa aha rubaju rwawe rwa buryo,</para>
  <para style="q1" vid="PSA 91:7">Kwonka iwe torihikwaho;<verse eid="PSA 91:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8" />Oryabireebesa amaisho kwonka,</para>
  <para style="q1" vid="PSA 91:8">Oyetegyereza ebihembo by'ababi.<verse eid="PSA 91:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:3">Zab 71:3</ref>; <ref loc="PSA 91:2">91:2</ref>. </char>
    </note> Ahakuba ogizire MUKAMA obuhungiro bwawe,</para>
  <para style="q1" vid="PSA 91:9">Na Rukira-boona waamugira obutaaho bwawe,<verse eid="PSA 91:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 91:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:10: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 12:21">Enf 12:21</ref>. </char>
    </note> Akabi koona tikarikuhikaho,</para>
  <para style="q1" vid="PSA 91:10">Kandi orufu rwona tirurihika haihi n'eihema ryawe.<verse eid="PSA 91:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:11, 12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:7">Zab 34:7</ref>; <ref loc="EXO 23:20">Kur 23:20</ref>; <ref loc="PRO 3:23">Enf 3:23</ref>; <ref loc="MAT 4:6">Mat 4:6</ref>; <ref loc="HEB 1:14">Heb 1:14</ref>. </char>
    </note> Ahakuba aryaragiira baamaraika be,</para>
  <para style="q1" vid="PSA 91:11">Bakurinde omu mihanda yaawe yoona;<verse eid="PSA 91:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12" />Baryakutega emikono yaabo</para>
  <para style="q1" vid="PSA 91:12">Ngu orekye kuhikiza ekigyere kyawe aha ibaare.<verse eid="PSA 91:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:13: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:19">Luk 10:19</ref>; <ref loc="ACT 28:5">Byak 28:5</ref>. </char>
    </note> Oryaribata entare n'empiri;</para>
  <para style="q1" vid="PSA 91:13">Oribatiirire ekitsigazi ky'entare n'enjoka.<verse eid="PSA 91:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:10">Zab 9:10</ref>. </char>
    </note> Ndyamukiza, ahabw'okuba nankunda,</para>
  <para style="q1" vid="PSA 91:14">Ndyamurinda, ahakuba naamanya eiziina ryangye.<verse eid="PSA 91:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:15">Zab 50:15</ref>; <ref loc="JOB 12:4">Yob 12:4</ref>; <ref loc="1SA 2:30">1 Sam 2:30</ref>; <ref loc="JER 33:3">Yer 33:3</ref>; <ref loc="ZEC 13:9">Zek 13:9</ref>; <ref loc="JHN 12:26">Yoh 12:26</ref>. </char>
    </note> Ku arintakira, ndyamugarukamu;</para>
  <para style="q1" vid="PSA 91:15">Ndyaguma nawe omu naku;</para>
  <para style="q1" vid="PSA 91:15">Ndyamujuna, mmuhe ekitiinisa;<verse eid="PSA 91:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">91:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:4">Zab 21:4</ref>; <ref loc="PSA 50:23">50:23</ref>; <ref loc="1KI 3:14">1 Bag 3:14</ref>. </char>
    </note> Ndyamuhaazya amagara g'ebiro bingi,</para>
  <para style="q1" vid="PSA 91:16">Kandi mmworekye okujuna kwangye.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" sid="PSA 92" />
  <para style="s1">Okusiima Ruhanga ahabw'omugisha ogu aha abantu be</para>
  <para style="d">Zaaburi ey'okweshongora ahari Sabato</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 92:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 147:1">Zab 147:1</ref>; <ref loc="GEN 14:19">Kut 14:19</ref>, <ref loc="GEN 14:20">20</ref>. </char>
    </note> Ni kirungi okusiima MUKAMA,</para>
  <para style="q1" vid="PSA 92:1">N'okweshongora eby'okuhimbisa eiziina ryawe, iwe Rukira-boona,<verse eid="PSA 92:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:5">Zab 36:5</ref>; <ref loc="PSA 119:147">119:147</ref>, <ref loc="PSA 119:148">148</ref>. </char>
    </note> Okumanyisa embabazi zaawe omu kasheeshe,</para>
  <para style="q1" vid="PSA 92:2">N'okwesigwa kwawe buri kiro,<verse eid="PSA 92:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:2">Zab 33:2</ref>. </char>
    </note> Ninteera omukuri n'endingiri</para>
  <para style="q1" vid="PSA 92:3">omu iraka eririkugyendera hamwe n'enanga.<verse eid="PSA 92:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:6">Zab 8:6</ref>. </char>
    </note> Ahakuba Iwe MUKAMA, okangwisa gye n'omurimo gwawe,</para>
  <para style="q1" vid="PSA 92:4">Ndyayeshongora, nshemerererwe ebi emikono yaawe yaakozire.<verse eid="PSA 92:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:2">Zab 111:2</ref>; <ref loc="PSA 139:17">139:17</ref>; <ref loc="ROM 11:33">Rom 11:33</ref>; <ref loc="REV 15:3">Kush 15:3</ref>. </char>
    </note> Ai MUKAMA, emirimo yaawe ka ni mikuru!</para>
  <para style="q1" vid="PSA 92:5">Ebiteekateeko byawe ka biri hare!<verse eid="PSA 92:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:8">Zab 94:8</ref>. </char>
    </note> Ekitsire tikirikukimanya,</para>
  <para style="q1" vid="PSA 92:6">N'omushema tarikukyetegyereza;<verse eid="PSA 92:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:4">Zab 94:4</ref>; <ref loc="JOB 21:7">Yob 21:7</ref>; <ref loc="JER 12:1">Yer 12:1</ref>. </char>
    </note> Ababi n'obu bamera nk'obunyaatsi,</para>
  <para style="q1" vid="PSA 92:7">N'enkozi z'ebibi zikagogyera,</para>
  <para style="q1" vid="PSA 92:7">Kwonka n'ab'okuhwerekyerera ebiro byona.<verse eid="PSA 92:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 93:4">Zab 93:4</ref>. </char>
    </note> Kwonka Iwe MUKAMA, ori ow'ekitiinisa ebiro byona.<verse eid="PSA 92:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:1">Zab 68:1</ref>. </char>
    </note> Ahakuba reeba abazigu baawe, ai MUKAMA!</para>
  <para style="q1" vid="PSA 92:9">Ahakuba reeba, abazigu baawe baryahwerekyerera,</para>
  <para style="q1" vid="PSA 92:9">N'enkozi z'ebibi ziryataataanisibwa.<verse eid="PSA 92:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:5">Zab 23:5</ref>; <ref loc="PSA 75:10">75:10</ref>; <ref loc="1SA 2:1">1 Sam 2:1</ref>. </char>
    </note> Kwonka otungwire eihembe ryangye nk'ery'embogo,</para>
  <para style="q1" vid="PSA 92:10">Wanshukaho amajuta masya.<verse eid="PSA 92:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:7">Zab 54:7</ref>. </char>
    </note> Amaisho gangye gareebire eki ndikwetengyera abazigu bangye;</para>
  <para style="q1" vid="PSA 92:11">N'amatu gangye gaahurira eki ndikwetengyera enkozi z'ebibi eziimukire kundwanisa.<verse eid="PSA 92:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:8">Zab 52:8</ref>; <ref loc="PSA 72:7">72:7</ref>; <ref loc="HOS 14:5">Hos 14:5</ref>, <ref loc="HOS 14:6">6</ref>. </char>
    </note> Abahikiriire nibabengyeya nk'omukindo,</para>
  <para style="q1" vid="PSA 92:12">Nibakura nk'omwereezi gwa Lebanooni.<verse eid="PSA 92:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:2">Zab 135:2</ref>. </char>
    </note> Abo ababyairwe omu nju ya MUKAMA</para>
  <para style="q1" vid="PSA 92:13">Baryagogyerera omu bikaari bya Ruhanga waitu.<verse eid="PSA 92:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14" />Baryaguma nibaana ebyana baakuzire,</para>
  <para style="q1" vid="PSA 92:14">Bagume baine amaizi nibabengyeya.<verse eid="PSA 92:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">92:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 58:11">Zab 58:11</ref>; <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="ROM 9:14">Rom 9:14</ref>. </char>
    </note> Kibone kworeka ku MUKAMA ari ow'amazima;</para>
  <para style="q1" vid="PSA 92:15">Ogwo niwe rukiri rwangye; kandi omuriwe tiharimu kutahikiirira.<verse eid="PSA 92:15" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" sid="PSA 93" />
  <para style="s1">Ekitiinisa kya Mukama n'amaani ge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 93:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">93:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:6">Zab 65:6</ref>; <ref loc="PSA 96:10">96:10</ref>; <ref loc="PSA 104:1">104:1</ref>; <ref loc="ISA 51:9">Isa 51:9</ref>; <ref loc="REV 19:6">Kush 19:6</ref>; <ref loc="1CH 16:31">1 Bus 16:31</ref>. </char>
    </note> MUKAMA ari aha ngoma; ajwaire ekitiinisa;</para>
  <para style="q1" vid="PSA 93:1">MUKAMA ajwaire, ayezirikire amaani;</para>
  <para style="q1" vid="PSA 93:1">Eego, ensi ehamire; terikubaasa kutengyetsibwa.<verse eid="PSA 93:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">93:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:6">Zab 45:6</ref>; <ref loc="PSA 90:2">90:2</ref>. </char>
    </note> Ekitebe kyawe ky'obukama kituura kihamire okwiha ira ryona.<verse eid="PSA 93:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">93:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:7">Zab 98:7</ref>, <ref loc="PSA 98:8">8</ref>; <ref loc="HAB 3:10">Hab 3:10</ref>. </char>
    </note> Emyegyemure ehooreire, ai MUKAMA;</para>
  <para style="q1" vid="PSA 93:3">Emyegyemure ehooreire n'amaraka gaayo;</para>
  <para style="q1" vid="PSA 93:3">Emyegyemure eborogotsire munonga.<verse eid="PSA 93:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">93:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:6">Zab 65:6</ref>, <ref loc="PSA 65:7">7</ref>; <ref loc="PSA 92:8">92:8</ref>. </char>
    </note> Okuhoorera kw'amaizi maingi</para>
  <para style="q1" vid="PSA 93:4">N'ebingoozi by'amaani eby'enyanja,</para>
  <para style="q1" vid="PSA 93:4">MUKAMA naabikiza amaani.<verse eid="PSA 93:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">93:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:7">Zab 19:7</ref>; <ref loc="PSA 29:2">29:2</ref>. </char>
    </note> Ebi waahamize n'eby'okwesigwa munonga;</para>
  <para style="q1" vid="PSA 93:5">MUKAMA, okwera kushemereire enju yaawe ebiro byona.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" sid="PSA 94" />
  <para style="s1">Okushaba Ruhanga okuhoora enkozi z'ebibi enzigu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 94:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:1: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:35">Bir 32:35</ref>; <ref loc="ISA 35:4">Isa 35:4</ref>; <ref loc="ROM 12:19">Rom 12:19</ref>. </char>
    </note> Ai MUKAMA, Ruhanga omuhoozi w'enzigu,</para>
  <para style="q1" vid="PSA 94:1">Iwe Ruhanga omuhoozi w'enzigu, jwisa omushana gwawe!<verse eid="PSA 94:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Zab 7:6</ref>; <ref loc="PSA 58:11">58:11</ref>. </char>
    </note> Imuka, Iwe ocwera ensi emanja,</para>
  <para style="q1" vid="PSA 94:2">Ozimuurire ab'amaryo ebibashemereire.<verse eid="PSA 94:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 20:5">Yob 20:5</ref>; <ref loc="REV 6:10">Kush 6:10</ref>. </char>
    </note> MUKAMA, ababi baryahitsya hi,</para>
  <para style="q1" vid="PSA 94:3">Baryahitsya hi okwehimbisa?<verse eid="PSA 94:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:4: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 2:3">1 Sam 2:3</ref>; <ref loc="JUD 1:15">Yud 15</ref>. </char>
    </note> Batungikirana ebigambo byabo by'amaryo;</para>
  <para style="q1" vid="PSA 94:4">Enkozi z'ebibi zoona zeehimbisa.<verse eid="PSA 94:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:15">Isa 3:15</ref>. </char>
    </note> Baita kubi abantu baawe, ai MUKAMA,</para>
  <para style="q1" vid="PSA 94:5">Kandi babonabonesa obuhunguzi bwawe.<verse eid="PSA 94:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:2">Isa 10:2</ref>. </char>
    </note> Baita omufaakazi n'omunyaihanga,</para>
  <para style="q1" vid="PSA 94:6">Bahotora efuuzi;<verse eid="PSA 94:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 22:13">Yob 22:13</ref>. </char>
    </note> Haza bagira ngu: MUKAMA tarikukireeba,</para>
  <para style="q1" vid="PSA 94:7">Ruhanga wa Yakobo tarikukyetaho.<verse eid="PSA 94:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8" />Imwe bitsire by'omu bantu 'mwe, nimuteekateekye;</para>
  <para style="q1" vid="PSA 94:8">Imwe bashema 'mwe, muryagira ryari obwengye?<verse eid="PSA 94:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 4:11">Kur 4:11</ref>; <ref loc="PRO 20:12">Enf 20:12</ref>. </char>
    </note> Owaataireho okutu tarihurira?</para>
  <para style="q1" vid="PSA 94:9">Owaahangire eriisho tarireeba?<verse eid="PSA 94:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 35:11">Yob 35:11</ref>; <ref loc="ISA 28:26">Isa 28:26</ref>. </char>
    </note> Ohana amahanga tarihana,</para>
  <para style="q1" vid="PSA 94:10">Kandi ari oyegyesa abantu obwengye?<verse eid="PSA 94:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:11: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 3:20">1 Kor 3:20</ref>. </char>
    </note> MUKAMA amanya ebiteekateeko by'abantu,</para>
  <para style="q1" vid="PSA 94:11">Ku biri nk'omwitsyo kwonka.<verse eid="PSA 94:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:17">Yob 5:17</ref>; <ref loc="PRO 3:11">Enf 3:11</ref>, <ref loc="PRO 3:12">12</ref>. </char>
    </note> Ai MUKAMA, aine omugisha omuntu ou ohana,</para>
  <para style="q1" vid="PSA 94:12">Okamwegyesa eby'omu Biragiro byawe,<verse eid="PSA 94:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:29">Yob 34:29</ref>. </char>
    </note> Ngu omuhuumuze, arekye kureeba enaku,</para>
  <para style="q1" vid="PSA 94:13">Okuhitsya obu ababi baririmirwa ekiina.<verse eid="PSA 94:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:9">Bir 32:9</ref>; <ref loc="1SA 12:22">1 Sam 12:22</ref>; <ref loc="1KI 6:13">1 Bag 6:13</ref>; <ref loc="JER 31:37">Yer 31:37</ref>; <ref loc="ROM 11:2">Rom 11:2</ref>. </char>
    </note> Ahakuba MUKAMA tarinaga bantu be,</para>
  <para style="q1" vid="PSA 94:14">N'obu kwakuba okutsigaho obuhunguzi bwe;<verse eid="PSA 94:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:15: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 14:8">1 Bag 14:8</ref>. </char>
    </note> Ahakuba emanja ziryagaruka zicuubwe omu kuhikiirira,</para>
  <para style="q1" vid="PSA 94:15">Kandi boona abaine emitima egororokire baryakukuratira.<verse eid="PSA 94:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16" />N'oha oriimuka akandwanisiza ababi?</para>
  <para style="q1" vid="PSA 94:16">N'oha oryemerera akandwanira n'enkozi z'ebibi?<verse eid="PSA 94:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 124:1">Zab 124:1</ref>, <ref loc="PSA 124:2">2</ref>. </char>
    </note> Kuri MUKAMA atarabaire Muhwezi wangye,</para>
  <para style="q1" vid="PSA 94:17">Amagara gangye gakaarahukire kutuura omu nsi etagira kateezo.<verse eid="PSA 94:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18" />Ku naagizire nti: Mpwera, naaterera,</para>
  <para style="q1" vid="PSA 94:18">Embabazi zaawe, MUKAMA, zandamira.<verse eid="PSA 94:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19" />Ku nteekateeka bingi, naayemereza omutima,</para>
  <para style="q1" vid="PSA 94:19">Okuhuumuriza kwawe kugwisa gye amagara gangye.<verse eid="PSA 94:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:20: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:1">Isa 10:1</ref>; <ref loc="2CO 6:14">2 Kor 6:14</ref>. </char>
    </note> Abategyeki babi nibabaasa kukwatanisa naiwe,</para>
  <para style="q1" vid="PSA 94:20">Abakora eby'eitima nibeekwatsa ebiragiro?<verse eid="PSA 94:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:15">Enf 17:15</ref>; <ref loc="MAT 27:4">Mat 27:4</ref>. </char>
    </note> Beeteerana kurwanisa amagara g'ohikiriire,</para>
  <para style="q1" vid="PSA 94:21">Bacwera otaine kabi orubanja rw'okufa.<verse eid="PSA 94:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:9">Zab 9:9</ref>; <ref loc="PSA 14:6">14:6</ref>; <ref loc="PSA 18:2">18:2</ref>. </char>
    </note> Kwonka MUKAMA ambeereire orugo rugumire,</para>
  <para style="q1" vid="PSA 94:22">Kandi Ruhanga wangye yaaba orukiri rwangye rw'okuhungiramu.<verse eid="PSA 94:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">94:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:16">Zab 7:16</ref>. </char>
    </note> Aryabagaruraho okutahikiirira kwabo,</para>
  <para style="q1" vid="PSA 94:23">Abamarireho kimwe ahabw'obubi bwabo;</para>
  <para style="q1" vid="PSA 94:23">MUKAMA Ruhanga waitu aryabamariraho kimwe.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" sid="PSA 95" />
  <para style="s1">Eby'okusiima Ruhanga, n'okumushaba okuturinda ebibi by'Abaisraeli aba ira</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 95:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:1">Zab 66:1</ref>; <ref loc="PSA 89:26">89:26</ref>. </char>
    </note> Nimwije tweshongorere MUKAMA,</para>
  <para style="q1" vid="PSA 95:1">Tuteerere Rukiri rw'okujunwa kwaitu akaari k'okushemererwa.<verse eid="PSA 95:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2" />Twije omu maisho ge nitusiima,</para>
  <para style="q1" vid="PSA 95:2">Tumuteerere akaari k'okushemererwa na zaaburi.<verse eid="PSA 95:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:5">Zab 135:5</ref>; <ref loc="2CH 2:5">2 Bus 2:5</ref>. </char>
    </note> Ahakuba MUKAMA ni Ruhanga omukuru,</para>
  <para style="q1" vid="PSA 95:3">Omukama omukuru orikukira baaruhanga boona.<verse eid="PSA 95:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4" />Ensa z'ensi ziri omu mukono gwe,</para>
  <para style="q1" vid="PSA 95:4">N'emitwe y'enshozi nayo n'eye.<verse eid="PSA 95:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:9">Kut 1:9</ref>, <ref loc="GEN 1:10">10</ref>; <ref loc="JON 1:9">Yon 1:9</ref>. </char>
    </note> Enyanja n'eye, ahakuba niwe yaagihangire,</para>
  <para style="q1" vid="PSA 95:5">N'engaro ze zikabumba ensi.<verse eid="PSA 95:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:6">Bir 32:6</ref>; <ref loc="2CH 6:13">2 Bus 6:13</ref>; <ref loc="JOB 35:10">Yob 35:10</ref>; <ref loc="ISA 51:13">Isa 51:13</ref>; <ref loc="DAN 6:10">Dan 6:10</ref>; <ref loc="LUK 22:41">Luk 22:41</ref>. </char>
    </note> Mwije tumuramye nitwinama,</para>
  <para style="q1" vid="PSA 95:6">Tutsimbire amaju MUKAMA Omuhangi waitu;<verse eid="PSA 95:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:14">Zab 48:14</ref>; <ref loc="PSA 74:1">74:1</ref>. </char>
    </note> Ahakuba niwe Ruhanga waitu,</para>
  <para style="q1" vid="PSA 95:7">Naitwe turi abantu b'omu iriisizo rye, kandi entaama z'omu mukono gwe.<note caller="-" style="x"><char style="xo" closed="false">95:7-11: </char><char style="xt" closed="false"><ref loc="HEB 3:7-11">Heb 3:7-11</ref>. </char></note><verse eid="PSA 95:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:34">Kur 9:34</ref>; <ref loc="EXO 17:2-7">17:2-7</ref>; <ref loc="NUM 20:2-13">Kub 20:2-13</ref>; <ref loc="1SA 6:6">1 Sam 6:6</ref>. </char>
    </note> Nkaabaasibwa ki, hati muhurira eiraka rye,</para>
  <para style="q1" vid="PSA 95:8">Mureka kugangaaza emitima yaanyu nk'ahari Meriba,</para>
  <para style="q1" vid="PSA 95:8">Nk'obwa Maasa muri omu ihamba,<verse eid="PSA 95:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:18">Zab 78:18</ref>; <ref loc="1CO 10:9">1 Kor 10:9</ref>. </char>
    </note> Obu baashwenkuriimwe bangyeza,</para>
  <para style="q1" vid="PSA 95:9">Bakantega, nibareeba emirimo yangye.<verse eid="PSA 95:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:10: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:33">Kub 14:33</ref>, <ref loc="NUM 14:34">34</ref>; <ref loc="ACT 13:18">Byak 13:18</ref>; <ref loc="HEB 3:17">Heb 3:17</ref>. </char>
    </note> Nkamara emyaka makumi ana ngwereirwe kubi ab'obusingye obwo,</para>
  <para style="q1" vid="PSA 95:10">Naagira nti: N'abantu abatuura nibahaba omu mitima yaabo,</para>
  <para style="q1" vid="PSA 95:10">Kandi tibarikumanya mihanda yaabo,</para>
  <para style="q1" vid="PSA 95:10">Kandi tibarikumanya mihanda yangye.<verse eid="PSA 95:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">95:11: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 1:34">Bir 1:34</ref>, <ref loc="DEU 1:35">35</ref>; <ref loc="DEU 12:9">12:9</ref>; <ref loc="HEB 3:18">Heb 3:18</ref>; <ref loc="HEB 4:3">4:3</ref>, <ref loc="HEB 4:5">5</ref>. </char>
    </note> Nikyo naarahiriire n'ekiniga nti:</para>
  <para style="q1" vid="PSA 95:11">Tibaritaaha mu buruhuukiro bwangye.<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" sid="PSA 96" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 96:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:1-13: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:23-33">1 Bus 16:23-33</ref>. </char>
    </note> Nimweshongorere MUKAMA ekyeshongoro kisya;</para>
  <para style="q1" vid="PSA 96:1">Imwe abari omu nsi mwena, mweshongorere MUKAMA.<note caller="-" style="x"><char style="xo" closed="false">96:1: </char><char style="xt" closed="false"><ref loc="PSA 33:3">Zab 33:3</ref>; <ref loc="PSA 98:1">98:1</ref>. </char></note><verse eid="PSA 96:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 52:7">Isa 52:7</ref>. </char>
    </note> Mweshongorere MUKAMA, musiime eiziina rye,</para>
  <para style="q1" vid="PSA 96:2">Mworekye okujuna kwe buri kasheeshe.<verse eid="PSA 96:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3" />Mumanyise ekitiinisa kye omu mahanga,</para>
  <para style="q1" vid="PSA 96:3">Emirimo ye ey'okutangaaza omu mahanga goona.<verse eid="PSA 96:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1">Zab 48:1</ref>; <ref loc="PSA 95:3">95:3</ref>. </char>
    </note>Ahakuba MUKAMA ni mukuru, ashemereire kuhimbisibwa munonga,</para>
  <para style="q1" vid="PSA 96:4">Kandi n'okutiinwa okukira baaruhanga boona.<verse eid="PSA 96:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4">Zab 115:4</ref>; <ref loc="GEN 1:1">Kut 1:1</ref>; <ref loc="ISA 42:5">Isa 42:5</ref>; <ref loc="JER 10:12">Yer 10:12</ref>; <ref loc="HAB 2:18-20">Hab 2:18-20</ref>; <ref loc="ACT 19:26">Byak 19:26</ref>. </char>
    </note> Ahabw'okuba baaruhanga boona aba bantu baba ebishushani;</para>
  <para style="q1" vid="PSA 96:5">Kwonka Ruhanga niwe yaahangire eiguru.<verse eid="PSA 96:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6" />Ekitiinisa n'obukuru bimwebembeire,</para>
  <para style="q1" vid="PSA 96:6">Amaani n'oburungi biri omu Mwanya gwe ogurikwera.<verse eid="PSA 96:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Zab 22:27</ref>; <ref loc="PSA 29:1">29:1</ref>, <ref loc="PSA 29:2">2</ref>; <ref loc="PSA 114:7">114:7</ref>. </char>
    </note> Imwe enganda z'amahanga, mugambe,</para>
  <para style="q1" vid="PSA 96:7">Mugambe ku MUKAMA aine ekitiinisa n'amaani.<verse eid="PSA 96:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8" />Mugambe ku MUKAMA aine ekitiinisa ekishemereire eiziina rye;</para>
  <para style="q1" vid="PSA 96:8">Mureete empongano, mwije omu bikaari bye!<verse eid="PSA 96:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9" />Muramye MUKAMA mujwaire ebirikwera,</para>
  <para style="q1" vid="PSA 96:9">Muteteme omu maisho ge, imwe ab'omu nsi mwena!<verse eid="PSA 96:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:8">Zab 9:8</ref>; <ref loc="PSA 93:1">93:1</ref>. </char>
    </note> Mugambire omu mahanga muti: MUKAMA ari aha ngoma!</para>
  <para style="q1" vid="PSA 96:10">Eego, ensi ehamire; terikubaasa kutengyetsibwa;</para>
  <para style="q1" vid="PSA 96:10">Aryacwera amahanga emanja z'oburyo.<verse eid="PSA 96:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:34">Zab 69:34</ref>; <ref loc="PSA 97:1">97:1</ref>; <ref loc="PSA 98:7">98:7</ref>. </char>
    </note> Eiguru rishemererwe, n'ensi eyesiime;</para>
  <para style="q1" vid="PSA 96:11">Enyanja ehoorere na byona ebiijwiremu;<verse eid="PSA 96:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 35:1">Isa 35:1</ref>; <ref loc="ISA 55:12">55:12</ref>. </char>
    </note> Emisiri eyesiime n'ebirimu byona!</para>
  <para style="q1" vid="PSA 96:12">Obwo nibwo emiti yoona ey'omu kibira eryeshongora ahabw'okushemererwa<verse eid="PSA 96:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">96:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 11:1-5">Isa 11:1-5</ref>. </char>
    </note> Omu maisho ga MUKAMA, ahabw'okuba naija,</para>
  <para style="q1" vid="PSA 96:13">Naija kucwera ensi orubanja;</para>
  <para style="q1" vid="PSA 96:13">Aryacwera ensi orubanja omu kuhikiirira,</para>
  <para style="q1" vid="PSA 96:13">N'amahanga omu mazima ge.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" sid="PSA 97" />
  <para style="s1">Ekitiinisa kya Ruhanga ekirikureeberwa omu bi arikukora</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 97:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 93:1">Zab 93:1</ref>; <ref loc="PSA 96:10">96:10</ref>, <ref loc="PSA 96:11">11</ref>. </char>
    </note> MUKAMA ari aha ngoma; ensi k'eyesiime,</para>
  <para style="q1" vid="PSA 97:1">Ebirwa bingi bishemererwe!<verse eid="PSA 97:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:11">Zab 18:11</ref>; <ref loc="PSA 89:14">89:14</ref>; <ref loc="DEU 4:11">Bir 4:11</ref>; <ref loc="EXO 19:9">Kur 19:9</ref>. </char>
    </note> Ebicu n'omwirima bimbwe hinguririize;</para>
  <para style="q1" vid="PSA 97:2">Okuhikiirira n'amazima nigwo musingi gw'ekitebe kye ky'obukama.<verse eid="PSA 97:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:9">Zab 21:9</ref>; <ref loc="DAN 7:10">Dan 7:10</ref>. </char>
    </note> Omuriro gumwebembera,</para>
  <para style="q1" vid="PSA 97:3">Nigwotsya abazigu be abamuri embaju zoona.<verse eid="PSA 97:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:18">Zab 77:18</ref>. </char>
    </note> Emirabyo ye emurika ensi,</para>
  <para style="q1" vid="PSA 97:4">Ensi ereeba, kandi etetema.<verse eid="PSA 97:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:5: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 4:13">Mik 4:13</ref>; <ref loc="NAM 1:5">Nah 1:5</ref>. </char>
    </note> Enshozi ziyagira omu maisho ga MUKAMA nk'entsinda,</para>
  <para style="q1" vid="PSA 97:5">Omu maisho ga MUKAMA ow'ensi yoona.<verse eid="PSA 97:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:6">Zab 50:6</ref>; <ref loc="ISA 40:5">Isa 40:5</ref>. </char>
    </note> Eiguru rimanyisa okuhikiirira kwe,</para>
  <para style="q1" vid="PSA 97:6">N'amahanga goona gareeba ekitiinisa kye,<verse eid="PSA 97:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:5">Zab 96:5</ref>; <ref loc="ISA 42:17">Isa 42:17</ref>; <ref loc="JER 10:14">Yer 10:14</ref>. </char>
    </note> Boona abaramya ebishushani bakwatwe enshoni,</para>
  <para style="q1" vid="PSA 97:7">Abarikwehimbisa ahabw'ebishushani ebitaine mugasho.</para>
  <para style="q1" vid="PSA 97:7">Imwe baaruhanga mwena, mumuramye.<verse eid="PSA 97:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:11">Zab 48:11</ref>. </char>
    </note> Saayuuni ekabihurira, yaashemererwa,</para>
  <para style="q1" vid="PSA 97:8">N'abaishiki ba Yuda baayesiima</para>
  <para style="q1" vid="PSA 97:8">Ahabw'emicwere yaawe, ai Ruhanga;<verse eid="PSA 97:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 83:18">Zab 83:18</ref>; <ref loc="PSA 95:3">95:3</ref>. </char>
    </note> Ahakuba Iwe, ai MUKAMA, nookira ebiri omu nsi yoona,</para>
  <para style="q1" vid="PSA 97:9">Noohimbisibwa okukirira kimwe baaruhanga boona.<verse eid="PSA 97:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:14">Zab 34:14</ref>; <ref loc="PRO 2:8">Enf 2:8</ref>; <ref loc="PRO 8:13">8:13</ref>; <ref loc="DAN 3:28">Dan 3:28</ref>; <ref loc="AMO 5:15">Amo 5:15</ref>; <ref loc="ACT 12:11">Byak 12:11</ref>; <ref loc="ROM 12:9">Rom 12:9</ref>. </char>
    </note> Imwe abakunda MUKAMA, mwangye obubi.</para>
  <para style="q1" vid="PSA 97:10">Arinda amagara g'abarikwera be,</para>
  <para style="q1" vid="PSA 97:10">Abaiha omu mikono y'ababi.<verse eid="PSA 97:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:4">Zab 112:4</ref>; <ref loc="PRO 4:18">Enf 4:18</ref>. </char>
    </note> Omushana gujwera abahikiriire,</para>
  <para style="q1" vid="PSA 97:11">Kandi okushemererwa kujwera ab'emitima egororokire.<verse eid="PSA 97:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">97:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:4">Zab 30:4</ref>; <ref loc="PSA 32:11">32:11</ref>. </char>
    </note> Imwe abahikiriire, mushemerererwe omuri MUKAMA,</para>
  <para style="q1" vid="PSA 97:12">Kandi musiime eiziina rye eririkwera.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" sid="PSA 98" />
  <para style="s1">Okusiima Ruhanga ahabw'okuhikiirira kwe</para>
  <para style="d">Zaaburi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 98:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:6">Kur 15:6</ref>; <ref loc="PSA 33:3">Zab 33:3</ref>; <ref loc="PSA 96:3">96:3</ref>; <ref loc="ISA 59:16">Isa 59:16</ref>; <ref loc="LUK 1:51">Luk 1:51</ref>. </char>
    </note> Mweshongorere MUKAMA ekyeshongoro kisya,</para>
  <para style="q1" vid="PSA 98:1">Ahakuba akozire eby'okutangaaza;</para>
  <para style="q1" vid="PSA 98:1">Omukono gwe gwa buryo kandi ogurikwera</para>
  <para style="q1" vid="PSA 98:1">Gumureeteire obusinguzi.<verse eid="PSA 98:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 52:10">Isa 52:10</ref>; <ref loc="ISA 62:2">62:2</ref>; <ref loc="LUK 2:30">Luk 2:30</ref>, <ref loc="LUK 2:31">31</ref>; <ref loc="ROM 3:25">Rom 3:25</ref>, <ref loc="ROM 3:26">26</ref>. </char>
    </note> Mukama amanyiise okujuna kwe,</para>
  <para style="q1" vid="PSA 98:2">Okuhikiirira kwe okushuurwire butunu omu maisho g'amahanga.<verse eid="PSA 98:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:31">Bir 4:31</ref>; <ref loc="ISA 49:6">Isa 49:6</ref>; <ref loc="LUK 1:54">Luk 1:54</ref>, <ref loc="LUK 1:72">72</ref>; <ref loc="LUK 3:6">3:6</ref>. </char>
    </note> Aijukire embabazi ze n'okwesigwa kwe,</para>
  <para style="q1" vid="PSA 98:3">Ebi yaagiriire enju ya israeli.</para>
  <para style="q1" vid="PSA 98:3">Embaju zoona ez'ensi zaareeba okujuna kwa Ruhanga waitu.<verse eid="PSA 98:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:1">Zab 66:1</ref>; <ref loc="ISA 44:23">Isa 44:23</ref>. </char>
    </note> Muteere MUKAMA akaari k'okushemererwa, imwe ab'omu nsi mwena,</para>
  <para style="q1" vid="PSA 98:4">Mwimutsye amaraka, mweshongore ekyeshongoro ky'okushemererwa n'eby'okuhimbisa.<verse eid="PSA 98:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5" />Mweshongorere MUKAMA aha nanga,</para>
  <para style="q1" vid="PSA 98:5">N'eiraka eririkugyendera hamwe nayo;<verse eid="PSA 98:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:6: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 10:10">Kub 10:10</ref>; <ref loc="1CH 15:28">1 Bus 15:28</ref>. </char>
    </note> Muteere akaari k'okushemererwa omu maisho ga MUKAMA kandi Omugabe</para>
  <para style="q1" vid="PSA 98:6">N'amakondere n'eiraka ry'enzamba.<verse eid="PSA 98:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:1">Zab 24:1</ref>; <ref loc="PSA 96:11">96:11</ref>. </char>
    </note> Enyanja ehoorere na byona ebiijwiremu,</para>
  <para style="q1" vid="PSA 98:7">N'ensi n'abagitwiremu.<verse eid="PSA 98:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:12">Zab 89:12</ref>; <ref loc="ISA 55:12">Isa 55:12</ref>. </char>
    </note> Emyegyemure eteere omu ngaro;</para>
  <para style="q1" vid="PSA 98:8">Ebibungo byeshongorere hamwe ahabw'okushemererwa<verse eid="PSA 98:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">98:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:13">Zab 96:13</ref>. </char>
    </note> Omu maisho ga MUKAMA; ahakuba naija kutegyeka ensi;</para>
  <para style="q1" vid="PSA 98:9">Aryacwera ensi emanja omu kuhikiirira,</para>
  <para style="q1" vid="PSA 98:9">N'amahanga omu bwinganisa.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" sid="PSA 99" />
  <para style="s1">Okusiima Ruhanga orikwera</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 99:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:1">Zab 80:1</ref>; <ref loc="PSA 93:1">93:1</ref>; <ref loc="PSA 96:9">96:9</ref>; <ref loc="ISA 24:19">Isa 24:19</ref>. </char>
    </note> MUKAMA ari aha ngoma; k'amahanga gateteme!</para>
  <para style="q1" vid="PSA 99:1">Ashutami ahagati ya baakerubi; k'ensi etengyete!<verse eid="PSA 99:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:4">Zab 113:4</ref>; <ref loc="ISA 24:23">Isa 24:23</ref>. </char>
    </note> MUKAMA ni mukuru omuri Saayuuni;</para>
  <para style="q1" vid="PSA 99:2">Ari ahaiguru, naakira amahanga goona.<verse eid="PSA 99:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:58">Bir 28:58</ref>; <ref loc="JOS 24:19">Yos 24:19</ref>; <ref loc="ISA 6:3">Isa 6:3</ref>. </char>
    </note> Ka bahimbise eiziina ryawe erikuru kandi eririkutiinisa;</para>
  <para style="q1" vid="PSA 99:3">Bati: N'Orikwera kandi Ow'amaani,<verse eid="PSA 99:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:4">Bir 32:4</ref>; <ref loc="ISA 61:8">Isa 61:8</ref>; <ref loc="JER 23:5">Yer 23:5</ref>. </char>
    </note> Omukama okunda eby'oburyo!</para>
  <para style="q1" vid="PSA 99:4">Niiwe otaho obwinganisa omu bantu;</para>
  <para style="q1" vid="PSA 99:4">Okacwa emanja z'oburyo n'okuhikiirira omuri Yakobo.<verse eid="PSA 99:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:28">Zab 118:28</ref>; <ref loc="PSA 132:7">132:7</ref>; <ref loc="1CH 28:2">1 Bus 28:2</ref>; <ref loc="EXO 15:2">Kur 15:2</ref>; <ref loc="ISA 60:13">Isa 60:13</ref>. </char>
    </note> Muhimbise MUKAMA Ruhanga waitu;</para>
  <para style="q1" vid="PSA 99:5">Mumuramize omu maisho g'akatebe k'ebigyere bye,</para>
  <para style="q1" vid="PSA 99:5">Nimugira muti: N'Orikwera!<verse eid="PSA 99:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:6: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:11">Kur 17:11</ref>; <ref loc="LEV 8:12">Lev 8:12</ref>; <ref loc="1SA 7:9">1 Sam 7:9</ref>; <ref loc="JER 15:1">Yer 15:1</ref>. </char>
    </note> Musa na Arooni bakaba bari omu banyamurwa be,</para>
  <para style="q1" vid="PSA 99:6">Na Samueli ari omu barikutakira eiziina rye.</para>
  <para style="q1" vid="PSA 99:6">Bakatakira MUKAMA, yaabagarukamu.<verse eid="PSA 99:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:9">Kur 33:9</ref>; <ref loc="NUM 12:5">Kub 12:5</ref>. </char>
    </note> Akabagambira ari omu nyomyo y'ekicu,</para>
  <para style="q1" vid="PSA 99:7">Baayorobera ebi yaahamize n'ebiragiro ebi yaabateereireho.<verse eid="PSA 99:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:35">Kur 32:35</ref>; <ref loc="NUM 14:20">Kub 14:20</ref>; <ref loc="NUM 20:12">20:12</ref>; <ref loc="DEU 9:20">Bir 9:20</ref>. </char>
    </note> Ai MUKAMA Ruhanga waitu, okaba obagarukamu;</para>
  <para style="q1" vid="PSA 99:8">Okaba ori Ruhanga orikubasaasira,</para>
  <para style="q1" vid="PSA 99:8">N'obu oraabe waabahoire enzigu ahabw'ebibi ebi baakozire.<verse eid="PSA 99:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">99:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:6">Zab 2:6</ref>. </char>
    </note> Muhe MUKAMA Ruhanga waitu ekitiinisa,</para>
  <para style="q1" vid="PSA 99:9">Mumuramize aha kibungo kye ekirikwera.</para>
  <para style="q1" vid="PSA 99:9">Ahakuba MUKAMA Ruhanga waitu n'Orikwera.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s1">Okukorera Mukama n'okushemererwa</para>
  <para style="d">Zaaburi y'okusiima</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">100:1-2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:1">Zab 66:1</ref>; <ref loc="PSA 95:1">95:1</ref>, <ref loc="PSA 95:2">2</ref>. </char>
    </note> Imwe ab'omu nsi zoona,</para>
  <para style="q1" vid="PSA 100:1">Muteerere MUKAMA akaari k'okushemererwa.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Muheereze MUKAMA mushemereirwe;</para>
  <para style="q1" vid="PSA 100:2">Mwije omu maisho ge nimweshongora.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">100:3: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:39">1 Bag 18:39</ref>; <ref loc="JOB 10:8">Yob 10:8</ref>, <ref loc="JOB 10:9">9</ref>; <ref loc="ISA 43:1">Isa 43:1</ref>; <ref loc="EZK 34:30">Ezk 34:30</ref>, <ref loc="EZK 34:31">31</ref>; <ref loc="EPH 2:10">Efe 2:10</ref>. </char>
    </note> Mumanye ngu MUKAMA ni Ruhanga.</para>
  <para style="q1" vid="PSA 100:3">Niwe yaatuhangire, kandi turi abe.</para>
  <para style="q1" vid="PSA 100:3">Turi abantu be, kandi entaama z'omu iriisizo rye.<verse eid="PSA 100:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Mutaahe omu marembo ge nimumusiima,</para>
  <para style="q1" vid="PSA 100:4">N'omu bikaari bye nimumuhimbisa.</para>
  <para style="q1" vid="PSA 100:4">Mumusiime, musingize eiziina na rye!<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">100:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:8">Zab 25:8</ref>; <ref loc="PSA 106:1">106:1</ref>. </char>
    </note> Ahakuba MUKAMA ni murungi;</para>
  <para style="q1" vid="PSA 100:5">Embabazi ze n'ez'ebiro n'ebiro, n'okwesigwa kwe n'okw'obusingye bwona.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" sid="PSA 101" />
  <para style="s1">Oku omutegyeki ashemereire kumariirira kuba ohikiriire</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 101:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:7">Kur 34:7</ref>. </char>
    </note> Niinyeshongora aha by'embabazi eby'okuhimbisa.<verse eid="PSA 101:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:2: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 18:14">1 Sam 18:14</ref>; <ref loc="1KI 9:4">1 Bag 9:4</ref>; <ref loc="PRO 11:20">Enf 11:20</ref>; <ref loc="JHN 14:23">Yoh 14:23</ref>. </char>
    </note> Ndyayerinda ngyendere omu muhanda oguhikire.</para>
  <para style="q1" vid="PSA 101:2">Oryaija ryari ahi ndi?<verse eid="PSA 101:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:3: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 12:20">1 Sam 12:20</ref>. </char>
    </note> Tindigira kintu kyona ekibi eki naayebembeza;</para>
  <para style="q1" vid="PSA 101:3">Niinyangira kimwe ekirikukorwa abarikuteishuka omuhanda gwawe;</para>
  <para style="q1" vid="PSA 101:3">Tindikwatanisa nakyo.<verse eid="PSA 101:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 17:20">Enf 17:20</ref>; <ref loc="2TI 2:19">2 Tim 2:19</ref>. </char>
    </note> Omutima gw'obugomi guryanza hare;</para>
  <para style="q1" vid="PSA 101:4">Tindimanya kintu kyona ekibi.<verse eid="PSA 101:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:5: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 16:5">Enf 16:5</ref>; <ref loc="PRO 21:4">21:4</ref>. </char>
    </note> Orikubeiherera mutaahi we omu mubonano, ndyamucwekyereza;</para>
  <para style="q1" vid="PSA 101:5">Orikureebesa abantu esheshemi, kandi ow'omutima gw'amaryo, tindimugumisiririza.<verse eid="PSA 101:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:1">Zab 119:1</ref>; <ref loc="MAT 5:48">Mat 5:48</ref>. </char>
    </note> Ndyareeba n'embabazi abarikwesigwa omu nsi,</para>
  <para style="q1" vid="PSA 101:6">Bagume naanye.</para>
  <para style="q1" vid="PSA 101:6">Orikugyendera omu muhanda oguhikire,</para>
  <para style="q1" vid="PSA 101:6">Niwe ariguma nampeereza.<verse eid="PSA 101:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7" />Omuntu weena okora eby'okugobya, tariguma mu nju yangye;</para>
  <para style="q1" vid="PSA 101:7">Omuntu weena orikubeiha, tarihamibwa mu maisho gangye.<verse eid="PSA 101:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">101:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:4">Zab 46:4</ref>; <ref loc="PSA 94:4">94:4</ref>. </char>
    </note> Buri kasheeshe ndyaguma ncwekyereze ababi boona ab'omu nsi,</para>
  <para style="q1" vid="PSA 101:8">Mbone kumariraho kimwe enkozi z'ebibi zoona omu rurembo rwa MUKAMA.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" sid="PSA 102" />
  <para style="s1">Okushaba kw'omuntu orikubonabonesibwa, yaaba naataaga, naashuka amaganya omu maisho ga MUKAMA</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 102:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:12">Zab 39:12</ref>; <ref loc="EXO 2:23">Kur 2:23</ref>. </char>
    </note> Hurira okushaba kwangye, ai MUKAMA,</para>
  <para style="q1" vid="PSA 102:1">N'okutaka kwangye kukuhikyeho.<verse eid="PSA 102:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Zab 18:6</ref>; <ref loc="PSA 27:9">27:9</ref>; <ref loc="PSA 56:9">56:9</ref>; <ref loc="PSA 69:17">69:17</ref>. </char>
    </note> Otaanyima amaisho aha izooba ry'obusaasi bwangye,</para>
  <para style="q1" vid="PSA 102:2">Ontegye okutu kwawe,</para>
  <para style="q1" vid="PSA 102:2">Orahukye kungarukamu aha izooba eri ndaakutakirireho;<verse eid="PSA 102:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:3: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 1:13">Tonz 1:13</ref>; <ref loc="JAS 4:14">Yak 4:14</ref>. </char>
    </note> Ahakuba ebiro byangye bihwaho nk'omwika,</para>
  <para style="q1" vid="PSA 102:3">N'amagufa gangye nigabugumwamu omuriro nk'ekikoomi.<verse eid="PSA 102:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:4: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 12:17">2 Sam 12:17</ref>; <ref loc="ISA 40:7">Isa 40:7</ref>; <ref loc="JAS 1:10">Yak 1:10</ref>, <ref loc="JAS 1:11">11</ref>. </char>
    </note> Omutima gwangye guri nk'obunyaatsi obuteirwe omushana, bukahonga;</para>
  <para style="q1" vid="PSA 102:4">Mbuzire n'agarya eby'okurya.<verse eid="PSA 102:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:20">Yob 19:20</ref>. </char>
    </note> Ahabw'okutsinda kwingi munonga</para>
  <para style="q1" vid="PSA 102:5">Amagufa gangye garamataine n'omubiri.<verse eid="PSA 102:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:11">Isa 34:11</ref>; <ref loc="ZEP 2:14">Zef 2:14</ref>. </char>
    </note> Ndi nka nyamunyonyi y'omu ihamba,</para>
  <para style="q1" vid="PSA 102:6">Nari nk'ekihihizi omu myanya etarimu bantu.<verse eid="PSA 102:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7" />Ndaara nindeeba;</para>
  <para style="q1" vid="PSA 102:7">Ndi nk'ekiteerankumba ekiteekami kyonka aha mutwe gw'enju.<verse eid="PSA 102:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:8: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 26:11">Byak 26:11</ref>. </char>
    </note> Abazigu bangye banjuma eizooba ryona;</para>
  <para style="q1" vid="PSA 102:8">Abangwereire eiraro bampindwire eky'okujumisa abandi;<verse eid="PSA 102:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Zab 42:3</ref>. </char>
    </note> Ahakuba ndiire eiju ry'akashenda nk'omugaati,</para>
  <para style="q1" vid="PSA 102:9">Naajwanzya eky'okunywa kyangye n'amarira,<verse eid="PSA 102:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10" />Ahabw'okuguubwa kubi kwawe n'ekiniga kyawe,</para>
  <para style="q1" vid="PSA 102:10">Ahabw'okuba ontwaire, wannaga.<verse eid="PSA 102:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:23">Zab 109:23</ref>. </char>
    </note> Ebiro byangye ni nk'ekicuucu ky'omu mwabazyo ekihwaho.</para>
  <para style="q1" vid="PSA 102:11">Kandi nyomire nk'obunyaatsi.<verse eid="PSA 102:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:13">Zab 135:13</ref>; <ref loc="EXO 3:15">Kur 3:15</ref>. </char>
    </note> Kwonka Iwe MUKAMA, oryaguma aha ngoma ebiro byona;</para>
  <para style="q1" vid="PSA 102:12">Kandi ab'obusingye bwona baryaguma bakwijukye.<verse eid="PSA 102:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:13: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 60:10">Isa 60:10</ref>; <ref loc="JER 29:10">Yer 29:10</ref>; <ref loc="ZEC 1:12">Zek 1:12</ref>. </char>
    </note> Oryaimuka osaasire Saayuuni;</para>
  <para style="q1" vid="PSA 102:13">ahakuba nibwo bunaku bw'okugigirira embabazi;</para>
  <para style="q1" vid="PSA 102:13">Eego, obunaku obwatairweho buhikire.<verse eid="PSA 102:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:14: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 4:2">Neh 4:2</ref>. </char>
    </note> Ahakuba abairu baawe bakunda amabaare gaayo,</para>
  <para style="q1" vid="PSA 102:14">Kandi basaasibwa omucuucu gwayo.<verse eid="PSA 102:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 138:4">Zab 138:4</ref>; <ref loc="1KI 8:43">1 Bag 8:43</ref>; <ref loc="ISA 60:3">Isa 60:3</ref>. </char>
    </note> Amahanga garyatiina eiziina rya MUKAMA,</para>
  <para style="q1" vid="PSA 102:15">N'abagabe boona ab'ensi batiine ekitiinisa kyawe;<verse eid="PSA 102:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16" />Ahabw'okuba MUKAMA aryagaruka ayombekye Saayuuni,</para>
  <para style="q1" vid="PSA 102:16">Kandi areeberwe omu kitiinisa kye.<verse eid="PSA 102:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17" />Aryata omutima aha kushaba kw'enshoberwa;</para>
  <para style="q1" vid="PSA 102:17">Tarigaya kweshengyereza kwabo.<verse eid="PSA 102:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:31">Zab 22:31</ref>; <ref loc="ISA 43:21">Isa 43:21</ref>; <ref loc="ROM 15:4">Rom 15:4</ref>; <ref loc="1CO 10:11">1 Kor 10:11</ref>. </char>
    </note> Ekyo ka kihandiikirwe ab'obusingye oburiija,</para>
  <para style="q1" vid="PSA 102:18">Ngu abantu abarizaarwa bahimbise MUKAMA;<verse eid="PSA 102:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:2">Zab 14:2</ref>; <ref loc="DEU 26:15">Bir 26:15</ref>. </char>
    </note> Ahabw'okuba MUKAMA akareeba ahansi, ari ahaiguru omu Mwanya gwe ogurikwera,</para>
  <para style="q1" vid="PSA 102:19">Yaareeba n'ensi, naayema omu iguru,<verse eid="PSA 102:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:11">Zab 79:11</ref>. </char>
    </note> Ngu ahurire okutsinda kw'embohe,</para>
  <para style="q1" vid="PSA 102:20">Akomorore abacwereirwe orubanja rw'okufa;<verse eid="PSA 102:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:22">Zab 22:22</ref>. </char>
    </note> Ngu abantu bagambe omuri Saayuuni eiziina rya MUKAMA.</para>
  <para style="q1" vid="PSA 102:21">N'okuhimbisibwa kwe omuri Yerusaalemu,<verse eid="PSA 102:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:27">Zab 22:27</ref>. </char>
    </note> Abantu bateeraniire hamwe</para>
  <para style="q1" vid="PSA 102:22">N'amahanga goona kuramya MUKAMA.<verse eid="PSA 102:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:45">Zab 89:45</ref>; <ref loc="JOB 36:26">Yob 36:26</ref>; <ref loc="PSA 90:2">Zab 90:2</ref>; <ref loc="ISA 38:10">Isa 38:10</ref>. </char>
    </note> Akatuubya amaani gangye nkiri rwagati.</para>
  <para style="q1" vid="PSA 102:23">Yaacwa aha biro byangye.<verse eid="PSA 102:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24" />Naagira nti: Ai bambe Ruhanga wangye, otantwara nkiri ahagati y'ebiro byangye,</para>
  <para style="q1" vid="PSA 102:24">Haza emyaka yaawe eba ey'obusiingye bwona.<verse eid="PSA 102:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:25-27: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:10-12">Heb 1:10-12</ref>. </char>
    </note> Okutaho omusingi gw'ensi iranaira,</para>
  <para style="q1" vid="PSA 102:25">N'eiguru rikahangwa emikono yaawe.<note caller="-" style="x"><char style="xo" closed="false">102:25: </char><char style="xt" closed="false"><ref loc="GEN 1:1">Kut 1:1</ref>; <ref loc="JOB 38:4-7">Yob 38:4-7</ref>; <ref loc="ISA 42:5">Isa 42:5</ref>. </char></note><verse eid="PSA 102:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:26: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="ISA 51:6">51:6</ref>; <ref loc="MAT 24:35">Mat 24:35</ref>; <ref loc="REV 20:11">Kush 20:11</ref>. </char>
    </note> Ebyo biryahwaho, kwonka Iwe oryagumaho;</para>
  <para style="q1" vid="PSA 102:26">Eego, ebyo byona biryakura nk'ekijwaro,</para>
  <para style="q1" vid="PSA 102:26">Oryabihindura nk'omwenda, bihindukye okundi;<verse eid="PSA 102:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:27: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 41:4">Isa 41:4</ref>; <ref loc="MAL 3:6">Mal 3:6</ref>; <ref loc="JAS 1:17">Yak 1:17</ref>. </char>
    </note> Kwonka Iwe tohinduka,</para>
  <para style="q1" vid="PSA 102:27">Kandi emyaka yaawe terihwaho;<verse eid="PSA 102:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">102:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:29">Zab 37:29</ref>; <ref loc="PSA 69:36">69:36</ref>. </char>
    </note> Abaana b'abairu baawe baryagumaho;</para>
  <para style="q1" vid="PSA 102:28">Kandi oruzaaro rwabo ruryahambibwa omu maisho gaawe.<verse eid="PSA 102:28" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" sid="PSA 103" />
  <para style="s1">Okusiima Mukama ahabw'emigisha ye yoona</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 103:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:1">Zab 104:1</ref>. </char>
    </note> Singiza MUKAMA, iwe magara gangye!</para>
  <para style="q1" vid="PSA 103:1">Na byona ebiri omuriinye bisingize eiziina rye eririkwera!<verse eid="PSA 103:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:12">Bir 6:12</ref>. </char>
    </note> Singiza MUKAMA, iwe magara gangye,</para>
  <para style="q1" vid="PSA 103:2">Kandi oteebwa ebirungi byona ebi yaakukoreire.<verse eid="PSA 103:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:26">Kur 15:26</ref>; <ref loc="EXO 34:7">34:7</ref>; <ref loc="ISA 33:24">Isa 33:24</ref>; <ref loc="JER 17:14">Yer 17:14</ref>; <ref loc="MRK 2:5">Mak 2:5</ref>; <ref loc="LUK 7:47">Luk 7:47</ref>. </char>
    </note> Niwe asaasira eby'okutahikiirira byawe byona,</para>
  <para style="q1" vid="PSA 103:3">Akakiza endwara zaawe zoona;<verse eid="PSA 103:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:13">Zab 56:13</ref>. </char>
    </note> Akacungura amagara gaawe, ngu garekye kuhwerekyerera,</para>
  <para style="q1" vid="PSA 103:4">Akakujweka embabazi n'okusaasirwa nk'ekirunga;<verse eid="PSA 103:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:9">Zab 107:9</ref>; <ref loc="ISA 40:31">Isa 40:31</ref>. </char>
    </note> Akakuhaazya ebirungi,</para>
  <para style="q1" vid="PSA 103:5">Ngu obutsigazi bwawe bugarukye busya nk'empungu.<verse eid="PSA 103:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 147:7">Zab 147:7</ref>. </char>
    </note> MUKAMA akora eby'okuhikiirira;</para>
  <para style="q1" vid="PSA 103:6">Boona abarikubonabonesibwa abakorera eby'oburyo.<verse eid="PSA 103:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 33:13">Kur 33:13</ref>; <ref loc="EXO 34:10">34:10</ref>. </char>
    </note> Akamanyisa Musa emitwarize ye,</para>
  <para style="q1" vid="PSA 103:7">N'Abaisraeli yaabooreka ebi yaakozire.<verse eid="PSA 103:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:15">Zab 86:15</ref>. </char>
    </note> MUKAMA n'omunyambabazi, kandi omusaasizi;</para>
  <para style="q1" vid="PSA 103:8">Tarahuka kuguubwa kubi, kureka agira okusaasira kwingi.<verse eid="PSA 103:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 57:6">Isa 57:6</ref>; <ref loc="JER 3:5">Yer 3:5</ref>, <ref loc="JER 3:12">12</ref>; <ref loc="MIC 7:18">Mik 7:18</ref>. </char>
    </note> Tariguma naahana obutoosha,</para>
  <para style="q1" vid="PSA 103:9">N'obu kwakuba okuguma n'ekiniga ebiro byona.<verse eid="PSA 103:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:10: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 9:13">Ezr 9:13</ref>. </char>
    </note> Tatugira nk'ebibi byaitu oku biri,</para>
  <para style="q1" vid="PSA 103:10">N'obu kwakuba okutuzimuurira nk'okutahikiirira kwaitu oku kuri.<verse eid="PSA 103:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 117:2">Zab 117:2</ref>; <ref loc="LUK 1:50">Luk 1:50</ref>. </char>
    </note> Ahakuba nk'eiguru oku riri ahaiguru munonga okuruga ahansi,</para>
  <para style="q1" vid="PSA 103:11">N'embabazi ezi agirira abarikumutiina nikwo ziri nyingi.<verse eid="PSA 103:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 38:17">Isa 38:17</ref>; <ref loc="MIC 7:19">Mik 7:19</ref>. </char>
    </note> Nk'oburugwa-izooba oku eri hare n'oburengyerwa-izooba,</para>
  <para style="q1" vid="PSA 103:12">Nikwo atwaire atyo hare eby'okushiisha byaitu.<verse eid="PSA 103:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:13: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:17">Mal 3:17</ref>. </char>
    </note> Nka ishe w'abaana oku asaasira abaana be,</para>
  <para style="q1" vid="PSA 103:13">Nikwo MUKAMA asaasira abarikumutiina;<verse eid="PSA 103:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:39">Zab 78:39</ref>; <ref loc="GEN 3:19">Kut 3:19</ref>; <ref loc="ECC 12:7">Mub 12:7</ref>. </char>
    </note> Ahakuba naamanya obuhangwa bwaitu,</para>
  <para style="q1" vid="PSA 103:14">Naijuka ku turi omucuucu.<verse eid="PSA 103:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:5">Zab 90:5</ref>; <ref loc="JOB 14:2">Yob 14:2</ref>. </char>
    </note> Eby'omuntu, ebiro bye biri nk'obunyaatsi;</para>
  <para style="q1" vid="PSA 103:15">Aba gye, nk'ekirabyo ky'omu ishwa;<verse eid="PSA 103:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:16: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 7:10">Yob 7:10</ref>; <ref loc="ISA 40:7">Isa 40:7</ref>. </char>
    </note> Ahakuba omuyaga ku gukihuuha, kihwaho,</para>
  <para style="q1" vid="PSA 103:16">Omwanya gwakyo gutsigara gutakikimanya.<verse eid="PSA 103:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17" />Kwonka embabazi za MUKAMA ziguma aha barikumutiina okwiha iranaira, okuhitsya obusingye bwona,</para>
  <para style="q1" vid="PSA 103:17">N'okuhikiirira kwe kuhika aha baijukuru.<verse eid="PSA 103:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:18: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:9">Bir 7:9</ref>. </char>
    </note> Aha barinda endagaano ye,</para>
  <para style="q1" vid="PSA 103:18">Bakaijuka ebiragiro bye, bakabyorobera.<verse eid="PSA 103:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:2">Zab 47:2</ref>; <ref loc="PSA 93:2">93:2</ref>; <ref loc="DAN 4:17">Dan 4:17</ref>. </char>
    </note> MUKAMA akahamya ekitebe kye eky'obukama omu iguru,</para>
  <para style="q1" vid="PSA 103:19">N'obukama bwe butegyeka byona.<verse eid="PSA 103:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 148:2">Zab 148:2</ref>; <ref loc="MAT 6:10">Mat 6:10</ref>; <ref loc="LUK 2:13">Luk 2:13</ref>. </char>
    </note> Musingize MUKAMA, imwe baamaraika be,</para>
  <para style="q1" vid="PSA 103:20">Imwe amamanzi g'amaani, abarikukora ebi yaaragiire,</para>
  <para style="q1" vid="PSA 103:20">mukahurira eiraka ry'ekigambo kye.<verse eid="PSA 103:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 32:2">Kut 32:2</ref>; <ref loc="DAN 7:10">Dan 7:10</ref>; <ref loc="HEB 1:14">Heb 1:14</ref>. </char>
    </note> Musingize MUKAMA, imwe amahe ge goona,</para>
  <para style="q1" vid="PSA 103:21">Abaheereza be abakora ebi akunda.<verse eid="PSA 103:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">103:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:1">Zab 103:1</ref>; <ref loc="PSA 145:10">145:10</ref>. </char>
    </note> Musingize MUKAMA, imwe emirimo ye yoona omu myanya yoona ei arikutegyeka.</para>
  <para style="q1" vid="PSA 103:22">Singiza MUKAMA, iwe magara gangye!<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" sid="PSA 104" />
  <para style="s1">Ekitiinisa kya Ruhanga ekirikureeberwa omu bi yaahangire</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 104:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:1">Zab 103:1</ref>, <ref loc="PSA 103:2">2</ref>; <ref loc="2SA 7:22">2 Sam 7:22</ref>; <ref loc="JOB 40:10">Yob 40:10</ref>. </char>
    </note> Singiza MUKAMA, iwe magara gangye!</para>
  <para style="q1" vid="PSA 104:1">Ai MUKAMA Ruhanga wangye, ori mukuru munonga;</para>
  <para style="q1" vid="PSA 104:1">Ojwaire ekitiinisa n'obukuru.<verse eid="PSA 104:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:2: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 9:8">Yob 9:8</ref>; <ref loc="ISA 40:22">Isa 40:22</ref>. </char>
    </note> Ojwara okumurinkana nk'ekijwaro;</para>
  <para style="q1" vid="PSA 104:2">Okabamba eiguru nk'eihema.<verse eid="PSA 104:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:19">Zab 18:19</ref>; <ref loc="ISA 19:1">Isa 19:1</ref>; <ref loc="AMO 9:6">Amo 9:6</ref>. </char>
    </note> Waataho enyomyo z'ekishengye kyawe omu maizi;</para>
  <para style="q1" vid="PSA 104:3">Ebicu waabigira ekigaari kyawe,</para>
  <para style="q1" vid="PSA 104:3">Noogyenda aha mapapa g'omuyaga.<verse eid="PSA 104:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:4: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:10">2 Bag 1:10</ref>; <ref loc="2KI 6:17">6:17</ref>; <ref loc="HEB 1:7">Heb 1:7</ref>. </char>
    </note> Emiyaga ogigira entumwa zaawe,</para>
  <para style="q1" vid="PSA 104:4">
    <note caller="+" style="f">
      <char style="fr" closed="false">104:4 </char>
      <char style="ft" closed="false">Nari, Omuriro n'endimi zaagwo obigira abaheereza baawe. </char>
    </note>N'abaheereza baawe baba omuriro ogurikwaka.<verse eid="PSA 104:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:4">Yob 38:4</ref>; <ref loc="ECC 1:4">Mub 1:4</ref>. </char>
    </note> Okata ensi aha misingi yaayo,</para>
  <para style="q1" vid="PSA 104:5">Ngu etaritengyetsibwa ebiro byona.<verse eid="PSA 104:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 7:19">Kut 7:19</ref>. </char>
    </note> Waagishweka enyanja nk'ekijwaro;</para>
  <para style="q1" vid="PSA 104:6">amaizi gaashweka enshozi.<verse eid="PSA 104:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:15">Zab 18:15</ref>; <ref loc="PSA 77:18">77:18</ref>. </char>
    </note> Ku waagakabukiire, gaahunga;</para>
  <para style="q1" vid="PSA 104:7">ahabw'eiraka ry'okuhinda kwawe, gairukira kimwe.<verse eid="PSA 104:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:8">Yob 38:8</ref>. </char>
    </note> Enshozi zaimuka, empanga zaagaruka ahansi</para>
  <para style="q1" vid="PSA 104:8">Omu mwanya ogu waaziteekateekyeire.<verse eid="PSA 104:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:9: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 9:11">Kut 9:11</ref>; <ref loc="JOB 38:11">Yob 38:11</ref>; <ref loc="JER 5:22">Yer 5:22</ref>. </char>
    </note> Waataho emyatano ei gatashemereire kurenga,</para>
  <para style="q1" vid="PSA 104:9">Ngu gatagaruka kushweka ensi.<verse eid="PSA 104:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10" />Ku oragiira, enshuro zifumuka omu mpanga;</para>
  <para style="q1" vid="PSA 104:10">Emigyera ehimintika ahagati y'ebibungo;<verse eid="PSA 104:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11" />Enywaisa enyamaishwa zoona;</para>
  <para style="q1" vid="PSA 104:11">Kandi enturegye zihweraho eiriho.<verse eid="PSA 104:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12" />Aha rubaju rwayo enyonyi n'amahungu niho byarika,</para>
  <para style="q1" vid="PSA 104:12">Bikeeshongorera omu mataagi g'ebiti.<verse eid="PSA 104:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:9">Zab 65:9</ref>; <ref loc="JOB 5:10">Yob 5:10</ref>. </char>
    </note> Ogwisiza ebibungo enjura, neeruga omu iguru,</para>
  <para style="q1" vid="PSA 104:13">Ensi ehaaga ebyana by'omurimo gwawe.<verse eid="PSA 104:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 136:25">Zab 136:25</ref>; <ref loc="PSA 147:8">147:8</ref>; <ref loc="JOB 28:5">Yob 28:5</ref>; <ref loc="GEN 1:29">Kut 1:29</ref>, <ref loc="GEN 1:30">30</ref>. </char>
    </note> Omereza ente obunyaatsi,</para>
  <para style="q1" vid="PSA 104:14">N'abantu obaha eby'okubyara,</para>
  <para style="q1" vid="PSA 104:14">Ngu babone kwiha eby'okurya omu itaka,<verse eid="PSA 104:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 104:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:15: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 18:5">Kut 18:5</ref>; <ref loc="JDG 9:9">Bar 9:9</ref>, <ref loc="JDG 9:13">13</ref>; <ref loc="PRO 31:6">Enf 31:6</ref>, <ref loc="PRO 31:7">7</ref>; <ref loc="ECC 10:19">Mub 10:19</ref>. </char>
    </note> Na viinyo ey'okugwisa gye emitima yaabo,</para>
  <para style="q1" vid="PSA 104:15">N'amajuta g'okuyagayagisa ahamaisho gaabo,</para>
  <para style="q1" vid="PSA 104:15">N'eby'okurya by'okugumya emitima yaabo.<verse eid="PSA 104:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:16: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 24:6">Kub 24:6</ref>. </char>
    </note> Emiti ya MUKAMA ehaagire amaizi,</para>
  <para style="q1" vid="PSA 104:16">Emyereezi ya Lebanooni ei yaabyaire.<verse eid="PSA 104:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17" />Omuriyo nimwo enyonyi zaarika,</para>
  <para style="q1" vid="PSA 104:17">Oruyongoyongo rwine enju yaarwo omu miberooshi.<verse eid="PSA 104:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 39:1">Yob 39:1</ref>; <ref loc="PRO 30:26">Enf 30:26</ref>. </char>
    </note> Omu nshozi ndaingwa enzaza nimwo ziba,</para>
  <para style="q1" vid="PSA 104:18">N'enkiri n'obweshereko bw'endirira.<verse eid="PSA 104:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:19: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:14">Kut 1:14</ref>. </char>
    </note> Okataho okwezi kumanyisa obunaku,</para>
  <para style="q1" vid="PSA 104:19">N'eizooba rimanya obunaku obu rirengyeraho.<verse eid="PSA 104:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:20: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:7">Isa 45:7</ref>. </char>
    </note> Oreeta omwirima, kiba ekiro;</para>
  <para style="q1" vid="PSA 104:20">Enyamaishwa zoona ez'omu ihamba zibona kushohora nizishooba.<verse eid="PSA 104:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:21: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:39">Yob 38:39</ref>. </char>
    </note> Ebitsigazi by'entare biboorogyera eki biraarye,</para>
  <para style="q1" vid="PSA 104:21">Nibisherura eby'okurya byabyo ahari Ruhanga.<verse eid="PSA 104:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22" />Eizooba ku rirasha, zigyenda,</para>
  <para style="q1" vid="PSA 104:22">Zibyama omu maaya gaazo.<verse eid="PSA 104:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 3:19">Kut 3:19</ref>. </char>
    </note> Abantu bashohora, baza aha mirimo yaabo,</para>
  <para style="q1" vid="PSA 104:23">Basiiba nibafa kubi okuhitsya omu mwabazyo.<verse eid="PSA 104:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:24: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:20">Kut 1:20</ref>, <ref loc="GEN 1:21">21</ref>, <ref loc="GEN 1:24">24</ref>, <ref loc="GEN 1:25">25</ref>; <ref loc="PRO 3:19">Enf 3:19</ref>. </char>
    </note> Ai MUKAMA, emirimo yaawe ka n'ey'emiringo mingi!</para>
  <para style="q1" vid="PSA 104:24">Ebyo byona okabikoresa obwengye.</para>
  <para style="q1" vid="PSA 104:24">N'ensi eijwire ebihangirwe byawe.<verse eid="PSA 104:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25" />Reeba, eriya nyanja ndaingwa kandi empango,</para>
  <para style="q1" vid="PSA 104:25">Ebamu ebintu ebitarikubarwa,</para>
  <para style="q1" vid="PSA 104:25">Ebiine amagara ebikye n'ebihango.<verse eid="PSA 104:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:14">Zab 74:14</ref>; <ref loc="JOB 41:1">Yob 41:1</ref>; <ref loc="ISA 27:1">Isa 27:1</ref>. </char>
    </note> Nimwo emeeri ziraba,</para>
  <para style="q1" vid="PSA 104:26">Na Leviasaani ei waahangire kuguma neezaniramu.<verse eid="PSA 104:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:15">Zab 145:15</ref>. </char>
    </note> Ebyo byona bikuhanga amaisho</para>
  <para style="q1" vid="PSA 104:27">Ngu obigaburire omu bunaku bwabyo.<verse eid="PSA 104:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:16">Zab 145:16</ref>. </char>
    </note> Ebi obiha, nibyo bitorotoora;</para>
  <para style="q1" vid="PSA 104:28">Ku oshashaanura engaro zaawe, biiguta ebirungi.<verse eid="PSA 104:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 30:7">Zab 30:7</ref>; <ref loc="JOB 34:14">Yob 34:14</ref>, <ref loc="JOB 34:15">15</ref>. </char>
    </note> Ku obiima amaisho, bishoberwa;</para>
  <para style="q1" vid="PSA 104:29">Ku obiihamu omwitsyo, bifa.</para>
  <para style="q1" vid="PSA 104:29">Bigaruka omu mucuucu omu byarugire.<verse eid="PSA 104:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:30: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 33:4">Yob 33:4</ref>; <ref loc="ISA 32:15">Isa 32:15</ref>. </char>
    </note> Ku oyohereza Omwoyo waawe, bihangwa,</para>
  <para style="q1" vid="PSA 104:30">Ohindura eitaka, rigaruka riba risya.<verse eid="PSA 104:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:17">Zab 72:17</ref>; <ref loc="GEN 1:31">Kut 1:31</ref>. </char>
    </note> Ekitiinisa kya MUKAMA kigumeho ebiro byona,</para>
  <para style="q1" vid="PSA 104:31">Mukama ashemerererwa emirimo ye,<verse eid="PSA 104:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:5">Zab 144:5</ref>; <ref loc="EXO 19:18">Kur 19:18</ref>. </char>
    </note> Oreeba ensi ekatetema,</para>
  <para style="q1" vid="PSA 104:32">Akikora aha nshozi, zikacumba omwika.<verse eid="PSA 104:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:33: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:4">Zab 63:4</ref>. </char>
    </note> Ndayeshongorera MUKAMA, nkiri ohuriire,</para>
  <para style="q1" vid="PSA 104:33">Nyeshongorere Ruhanga wangye, nkiriho.<verse eid="PSA 104:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34" />Okuteekateeka kwangye kugume kumugwise gye;</para>
  <para style="q1" vid="PSA 104:34">Ahakuba nshemerererwa omuri MUKAMA.<verse eid="PSA 104:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">104:35: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:38">Zab 37:38</ref>; <ref loc="PSA 104:1">104:1</ref>; <ref loc="PSA 105:45">105:45</ref>. </char>
    </note> K'abasiisi bahwerekyerezibwe, barugye omu nsi,</para>
  <para style="q1" vid="PSA 104:35">N'ababi batarirangwa omu nsi.</para>
  <para style="q1" vid="PSA 104:35">Singiza MUKAMA iwe magara gangye!</para>
  <para style="q1" vid="PSA 104:35">Haleluya.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" sid="PSA 105" />
  <para style="s1">Ebirungi ebi Ruhanga yaakozire ahabw'Abaisraeli</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 105:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:1-15: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:8-22">1 Bus 16:8-22</ref>. </char>
    </note> Musiime MUKAMA, murangaane eiziina rye,</para>
  <para style="q1" vid="PSA 105:1">Mumanyise ebi yaakozire omu mahanga.<note caller="-" style="x"><char style="xo" closed="false">105:1: </char><char style="xt" closed="false"><ref loc="ISA 12:4">Isa 12:4</ref>. </char></note><verse eid="PSA 105:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2" />Mumweshongorere, mweshongore eby'okumuhimbisa,</para>
  <para style="q1" vid="PSA 105:2">Mugambire abantu eby'emirimo ye yoona ey'okutangaaza.<verse eid="PSA 105:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3" />Mwesiime ahabw'eiziina rye eririkwera,</para>
  <para style="q1" vid="PSA 105:3">Emitima y'abarikusherura MUKAMA eshemererwe.<verse eid="PSA 105:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:8">Zab 27:8</ref>. </char>
    </note> Musherure MUKAMA n'amaani ge,</para>
  <para style="q1" vid="PSA 105:4">Mwetengye okuguma omu maisho ge obutoosha.<verse eid="PSA 105:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 105:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:11">Zab 77:11</ref>; <ref loc="EXO 6:6">Kur 6:6</ref>. </char>
    </note> Mwijukye emirimo ye ey'okutangaaza,</para>
  <para style="q1" vid="PSA 105:5">N'ebitakareebwaga ebi yaakozire, n'emanja ezi yaacwire,<verse eid="PSA 105:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 105:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:42">Zab 105:42</ref>. </char>
    </note> Imwe ab'oruzaaro rw'omwiru we Abrahamu,</para>
  <para style="q1" vid="PSA 105:6">Abaana ba Yakobo, abu yaatooraine.<verse eid="PSA 105:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:9">Isa 26:9</ref>. </char>
    </note> Niwe MUKAMA Ruhanga waitu,</para>
  <para style="q1" vid="PSA 105:7">Emicwere ye eri omu nsi yoona.<verse eid="PSA 105:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:5">Zab 111:5</ref>, <ref loc="PSA 111:9">9</ref>; <ref loc="DEU 7:9">Bir 7:9</ref>; <ref loc="LUK 1:72">Luk 1:72</ref>. </char>
    </note> Aijuka endagaano ye ebiro byona,</para>
  <para style="q1" vid="PSA 105:8">Ekigambo eki yaaragiire ab'obusingye rukumi,<verse eid="PSA 105:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:9: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:2">Kut 17:2</ref>; <ref loc="GEN 22:16-18">22:16-18</ref>; <ref loc="GEN 26:3">26:3</ref>; <ref loc="LUK 1:73">Luk 1:73</ref>. </char>
    </note> Niyo ndagaano ei yaaragaine na Abrahamu,</para>
  <para style="q1" vid="PSA 105:9">Ei yaarahiire naaraganisa Isaaka,<verse eid="PSA 105:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:13">Kut 28:13</ref>, <ref loc="GEN 28:14">14</ref>; <ref loc="GEN 35:10-12">35:10-12</ref>. </char>
    </note> Akagihamiza Yakobo kuba ekiragiro,</para>
  <para style="q1" vid="PSA 105:10">Na Israeli okuba endagaano etarihwaho,<verse eid="PSA 105:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:11: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:15">Kut 13:15</ref>; <ref loc="GEN 15:18">15:18</ref>. </char>
    </note> Naagira ati: Niiwe ndiha ensi ya Kanaani,</para>
  <para style="q1" vid="PSA 105:11">Kuba omugabo gw'obuhunguzi bwanyu.<verse eid="PSA 105:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:12: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 34:30">Kut 34:30</ref>; <ref loc="HEB 11:9">Heb 11:9</ref>. </char>
    </note> Obu baabaire bakiri bakye,</para>
  <para style="q1" vid="PSA 105:12">Eego bakye munonga kandi abashuhuuki omu nsi egyo,<verse eid="PSA 105:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13" />Nibazengyerera omu mahanga agatari gamwe,</para>
  <para style="q1" vid="PSA 105:13">Okuruga omu bugabe bumwe okuza omu bundi,<verse eid="PSA 105:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:14: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:17">Kut 12:17</ref>; <ref loc="GEN 35:5">35:5</ref>. </char>
    </note> Taraikiriize muntu weena kubakora kubi;</para>
  <para style="q1" vid="PSA 105:14">Akateisa abagabe ahabwabo,<verse eid="PSA 105:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:15: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 20:6">Kut 20:6</ref>, <ref loc="GEN 20:7">7</ref>. </char>
    </note> Naagira ati: Mutakora aha bu naashukireho amajuta,</para>
  <para style="q1" vid="PSA 105:15">N'obu kwakuba okukora kubi baanabi bangye.<verse eid="PSA 105:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:16: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:54">Kut 41:54</ref>; <ref loc="EZK 4:16">Ezk 4:16</ref>. </char>
    </note> Obu yaayeta enjara, ekateera ensi egyo,</para>
  <para style="q1" vid="PSA 105:16">Akahendera kimwe enkoni ei baabaire beesigire, nibyo by'okurya byabo.<verse eid="PSA 105:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:17: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:28">Kut 37:28</ref>, <ref loc="GEN 37:36">36</ref>; <ref loc="GEN 45:5">45:5</ref>; <ref loc="ACT 7:9">Byak 7:9</ref>. </char>
    </note> Akashangwa yaatumire omuntu kubabandizayo,</para>
  <para style="q1" vid="PSA 105:17">Niwe Yosefu owaaguzirwe kuba omuhuuku.<verse eid="PSA 105:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:18: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 39:20">Kut 39:20</ref>. </char>
    </note> Ebigyere bye baabisaasa n'emihama,</para>
  <para style="q1" vid="PSA 105:18">Baamubohesa enjegyere z'ebyoma.<verse eid="PSA 105:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:19: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 40:20-22">Kut 40:20-22</ref>. </char>
    </note> Ekigambo kya MUKAMA kikaguma nikimugyeza,</para>
  <para style="q1" vid="PSA 105:19">Okuhitsya obu eki yaagambire kyabaireho.<verse eid="PSA 105:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:20: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:14">Kut 41:14</ref>. </char>
    </note> Omugabe yaatuma, baamubohoorora,</para>
  <para style="q1" vid="PSA 105:20">omutegyeki w'amahanga yaamurekura;<verse eid="PSA 105:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:21: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 41:40">Kut 41:40</ref>. </char>
    </note> Yaamuhindura omukuru w'eka ye,</para>
  <para style="q1" vid="PSA 105:21">Kandi omutegyeki w'ebintu bye byona,<verse eid="PSA 105:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22" />Okuboha abanyiginya be nk'oku arikwenda,</para>
  <para style="q1" vid="PSA 105:22">N'okwegyesa abakuru be obwengye.<verse eid="PSA 105:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:23: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 46:6">Kut 46:6</ref>; <ref loc="GEN 47:11">47:11</ref>; <ref loc="ACT 7:15">Byak 7:15</ref>; <ref loc="ACT 13:17">13:17</ref>. </char>
    </note> Bwanyima Israeli yaija omuri Misiri</para>
  <para style="q1" vid="PSA 105:23">Yakobo yaashuhuukira omu nsi ya Haamu.<verse eid="PSA 105:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:24: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:8-14">Kur 1:8-14</ref>; <ref loc="ACT 7:17">Byak 7:17</ref>. </char>
    </note> MUKAMA yaakanyisa abantu be munonga,</para>
  <para style="q1" vid="PSA 105:24">Yaabahindura ab'amaani okukira abazigu baabo.<verse eid="PSA 105:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:25: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 1:8-14">Kur 1:8-14</ref>; <ref loc="ACT 7:19">Byak 7:19</ref>. </char>
    </note> Yaahindura emitima yaabo kwanga abantu be,</para>
  <para style="q1" vid="PSA 105:25">N'okugira obwengye bw'okutwaza kubi abairu be.<verse eid="PSA 105:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:26: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 3:10">Kur 3:10</ref>; <ref loc="EXO 4:12">4:12</ref>; <ref loc="NUM 17:5-8">Kub 17:5-8</ref>. </char>
    </note> Yaatuma Musa omwiru we,</para>
  <para style="q1" vid="PSA 105:26">Na Arooni ou yaatooraine;<verse eid="PSA 105:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:27-36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:43-51">Zab 78:43-51</ref>. </char>
    </note> Baakora obumanyiso bwe omuribo,</para>
  <para style="q1" vid="PSA 105:27">N'eby'okutangaaza omu nsi ya Haamu.<verse eid="PSA 105:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 99:7">Zab 99:7</ref>; <ref loc="EXO 10:21-23">Kur 10:21-23</ref>. </char>
    </note> Yaareeta omwirima, gwashweka ensi.</para>
  <para style="q1" vid="PSA 105:28">Ngu barekye kugomera ekigambo kye.<verse eid="PSA 105:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:29: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 7:17-21">Kur 7:17-21</ref>. </char>
    </note> Yaahindura amaizi gaabo eshagama,</para>
  <para style="q1" vid="PSA 105:29">Yaita eby'enyanja byabo.<verse eid="PSA 105:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:30: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:2-6">Kur 8:2-6</ref>. </char>
    </note> Ensi yaabo yaijura ebikyere,</para>
  <para style="q1" vid="PSA 105:30">Byaza n'omu bishengye by'abagabe baabo.<verse eid="PSA 105:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:31: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 8:16">Kur 8:16</ref>, <ref loc="EXO 8:17">17</ref>, <ref loc="EXO 8:21-24">21-24</ref>. </char>
    </note> Yaaragiira, haija emizinga y'eshohera,</para>
  <para style="q1" vid="PSA 105:31">Enda zaanyiga omu nsi yaabo yoona.<verse eid="PSA 105:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:32, 33: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:22-25">Kur 9:22-25</ref>. </char>
    </note> Omu mwanya gw'enjura yaabagwisiza orubaare,</para>
  <para style="q1" vid="PSA 105:32">N'emirabyo yaatyankana omu nsi yaabo.<verse eid="PSA 105:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33" />Yaateera emizaabibu yaabo n'emitiini yaabo,</para>
  <para style="q1" vid="PSA 105:33">Yaahendagura ebiti by'omu nsi yaabo.<verse eid="PSA 105:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:34, 35: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 10:12-15">Kur 10:12-15</ref>. </char>
    </note> Yaagamba, enzigye zaateera,</para>
  <para style="q1" vid="PSA 105:34">Na kanyananga nyingi munonga,<verse eid="PSA 105:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35" />Byarya ebimezire byona omu nsi yaabo,</para>
  <para style="q1" vid="PSA 105:35">N'emyaka ey'omu misiri yaabo.<verse eid="PSA 105:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:51">Zab 78:51</ref>; <ref loc="EXO 12:29">Kur 12:29</ref>. </char>
    </note> Kandi yaateera emijigaijo yoona ey'omu nsi yaabo,</para>
  <para style="q1" vid="PSA 105:36">Abaana b'amaani gaabo ag'okubanza.<verse eid="PSA 105:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:37: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:35">Kur 12:35</ref>, <ref loc="EXO 12:36">36</ref>. </char>
    </note> Bwanyima yaiha Abaisraeli omu nsi egyo, baine efeeza n'ezaabu;</para>
  <para style="q1" vid="PSA 105:37">Tihariho n'omwe aharibo owaabaire ataine maani.<verse eid="PSA 105:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:38: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:15-16">Kur 12:15-16</ref>, <ref loc="EXO 12:33">33</ref>. </char>
    </note> Ku baarugiremu, Abanyamisiri baashemererwa,</para>
  <para style="q1" vid="PSA 105:38">Ahabw'okuba bakaba baine obwoba ahabwabo.<verse eid="PSA 105:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:39: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Kur 13:21</ref>; <ref loc="ISA 4:5">Isa 4:5</ref>; <ref loc="1CO 10:1">1 Kor 10:1</ref>. </char>
    </note> Yaashashaanura ekicu ky'okubasangira,</para>
  <para style="q1" vid="PSA 105:39">Yaataho n'omuriro gw'okubamurikira nyekiro.<verse eid="PSA 105:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:40: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:24">Zab 78:24</ref>, <ref loc="PSA 78:27">27</ref>; <ref loc="EXO 16:12-15">Kur 16:12-15</ref>; <ref loc="JHN 6:31">Yoh 6:31</ref>. </char>
    </note> Baashaba, yaareeta endahi,</para>
  <para style="q1" vid="PSA 105:40">Yaabahaazya eby'okurya by'omu iguru.<verse eid="PSA 105:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:41: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:6">Kur 17:6</ref>; <ref loc="NUM 20:11">Kub 20:11</ref>; <ref loc="ISA 48:21">Isa 48:21</ref>; <ref loc="1CO 10:4">1 Kor 10:4</ref>. </char>
    </note> Yaayata orukiri, amaizi gaahimintika;</para>
  <para style="q1" vid="PSA 105:41">Gaaraba omu myanya eyomire nk'emigyera;<verse eid="PSA 105:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:42: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:6-9">Zab 105:6-9</ref>; <ref loc="EXO 2:24">Kur 2:24</ref>; <ref loc="GEN 15:14">Kut 15:14</ref>. </char>
    </note> Ahakuba akaijuka ekigambo kye ekirikwera,</para>
  <para style="q1" vid="PSA 105:42">Na Abrahamu omwiru we.<verse eid="PSA 105:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:43: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:1">Kur 15:1</ref>. </char>
    </note> Yaihayo abantu be n'okushemererwa,</para>
  <para style="q1" vid="PSA 105:43">Abu yaatooraine baija nibeeshongora.<verse eid="PSA 105:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:44: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:55">Zab 78:55</ref>; <ref loc="JOS 11:23">Yos 11:23</ref>; <ref loc="JOS 24:13">24:13</ref>. </char>
    </note> Yaabaha ensi z'abanyamahanga,</para>
  <para style="q1" vid="PSA 105:44">Baahungura ebi abanyamahanga baahendekyeire,<verse eid="PSA 105:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">105:45: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:35">Zab 104:35</ref>; <ref loc="DEU 4:1">Bir 4:1</ref>, <ref loc="DEU 4:40">40</ref>. </char>
    </note> Ngu babone kworobera ebiragiro bye n'okurinda ebi yaataireho.</para>
  <para style="q1" vid="PSA 105:45">Haleluya.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" sid="PSA 106" />
  <para style="s1">Okushiisha kw'Abaisraeli n'oburungi bwa Mukama aharibo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 106:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:34">1 Bus 16:34</ref>; <ref loc="JER 33:11">Yer 33:11</ref>. </char>
    </note> Haleluya;</para>
  <para style="q1" vid="PSA 106:1">Musiime MUKAMA, ahabw'okuba ni murungi;</para>
  <para style="q1" vid="PSA 106:1">Kandi embabazi ze n'ez'ebiro n'ebiro.<verse eid="PSA 106:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2" />N'oha owaakubaasa kugamba eby'amaani ebi MUKAMA yaakozire,</para>
  <para style="q1" vid="PSA 106:2">Nari okumanyisa ebirikumuhimbisisa byona?<verse eid="PSA 106:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 15:2">Zab 15:2</ref>. </char>
    </note> Baine omugisha abarikukora eby'oburyo,</para>
  <para style="q1" vid="PSA 106:3">Abakora eby'okuhikiirira buri kaanya.<verse eid="PSA 106:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:132">Zab 119:132</ref>. </char>
    </note> Onyijukye, ai MUKAMA, n'embabazi ezi ogirira abantu baawe;</para>
  <para style="q1" vid="PSA 106:4">Ontaayaayire n'okujuna kwawe,<verse eid="PSA 106:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5" />Mbone kureeba okugogyeera kw'abu waatooraine,</para>
  <para style="q1" vid="PSA 106:5">Nshemererwe ahabw'okwesiima kw'eihanga ryawe,</para>
  <para style="q1" vid="PSA 106:5">Kandi nyehimbise hamwe n'ab'obuhunguzi bwawe.<verse eid="PSA 106:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:6: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:40">Lev 26:40</ref>; <ref loc="1KI 8:47">1 Bag 8:47</ref>; <ref loc="NEH 1:6">Neh 1:6</ref>, <ref loc="NEH 1:7">7</ref>; <ref loc="JER 14:20">Yer 14:20</ref>. </char>
    </note> Itwe na baatatenkuriitwe tukashiisha,</para>
  <para style="q1" vid="PSA 106:6">Twakora eby'okutahikiirira; twakora kubi.<verse eid="PSA 106:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:11">Zab 78:11</ref>; <ref loc="EXO 14:11">Kur 14:11</ref>, <ref loc="EXO 14:12">12</ref>. </char>
    </note> Baatatenkuriitwe tibareetegyereize by'okutangaaza ebi waakozire omuri Misri;</para>
  <para style="q1" vid="PSA 106:7">Tibaraijukire by'embabazi bingi ebi waakozire,</para>
  <para style="q1" vid="PSA 106:7">Kureka bakagomera Rukira-boona aha Nyanja erikutukura.<verse eid="PSA 106:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 9:16">Kur 9:16</ref>; <ref loc="EZK 20:9">Ezk 20:9</ref>. </char>
    </note> Kwonka yaabajuna ahabw'eiziina rye,</para>
  <para style="q1" vid="PSA 106:8">Ngu amanyise obushoboorozi bw'amaani ge.<verse eid="PSA 106:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Kur 14:21</ref>; <ref loc="ISA 51:10">Isa 51:10</ref>; <ref loc="ISA 63:13">63:13</ref>. </char>
    </note> Yaakabukira egyo Nyanja erikutukura, yaayoma,</para>
  <para style="q1" vid="PSA 106:9">Yaabarabya ahagati yaayo nk'abarikuraba omu bwerere;<verse eid="PSA 106:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:2">Zab 107:2</ref>; <ref loc="EXO 14:30">Kur 14:30</ref>. </char>
    </note> Yaabajuna omu mukono gw'ogwo owaabaire naabanga,</para>
  <para style="q1" vid="PSA 106:10">Yaabaiha omu mikono y'abazigu baabo.<verse eid="PSA 106:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:28">Kur 14:28</ref>. </char>
    </note> Amaizi gaashweka ababisha baabo,</para>
  <para style="q1" vid="PSA 106:11">Tihaatsigara n'omwe.<verse eid="PSA 106:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:31">Kur 14:31</ref>; <ref loc="EXO 15:1-21">15:1-21</ref>. </char>
    </note> Obwo baikiriza ebigambo bye,</para>
  <para style="q1" vid="PSA 106:12">Baayeshongora eby'okumuhimbisa.<verse eid="PSA 106:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:11">Zab 107:11</ref>; <ref loc="EXO 15:24">Kur 15:24</ref>; <ref loc="EXO 16:2">16:2</ref>. </char>
    </note> Ku haahingwire akaanya kakye, baayebwa emirimo ye,</para>
  <para style="q1" vid="PSA 106:13">Tibaategyereza naama ye kuhikiirizibwa;<verse eid="PSA 106:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:2">Kur 17:2</ref>; <ref loc="NUM 11:4">Kub 11:4</ref>; <ref loc="1CO 10:6">1 Kor 10:6</ref>, <ref loc="1CO 10:9">9</ref>. </char>
    </note> Kureka baagira okwetenga kwingi omu ihamba,</para>
  <para style="q1" vid="PSA 106:14">Baagyereza Ruhanga ahatatuurwa bantu.<verse eid="PSA 106:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:29">Zab 78:29</ref>; <ref loc="ISA 10:16">Isa 10:16</ref>. </char>
    </note> Yaabaha ebi baamushabire,</para>
  <para style="q1" vid="PSA 106:15">Kwonka omu magara gaabo yaabareetera okuhururuka.<verse eid="PSA 106:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:16: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:1-3">Kub 16:1-3</ref>. </char>
    </note> Baagirira Musa eihari omu nsiisira z'amahema,</para>
  <para style="q1" vid="PSA 106:16">Na Arooni orikwera wa MUKAMA.<verse eid="PSA 106:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:17: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:31">Kub 16:31</ref>, <ref loc="NUM 16:32">32</ref>. </char>
    </note> Ensi yaayashama, yaamira Dasani,</para>
  <para style="q1" vid="PSA 106:17">Yaashweka abantu ba Abiraamu;<verse eid="PSA 106:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:18: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:35">Kub 16:35</ref>. </char>
    </note> N'omuriro gwayaka omu mutwe gw'abo bantu,</para>
  <para style="q1" vid="PSA 106:18">Endimi zaagwo zaayotsya ababi.<verse eid="PSA 106:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:19: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:4">Kur 32:4</ref>; <ref loc="ACT 7:41">Byak 7:41</ref>. </char>
    </note> Baakorera enyana omuri Horebu,</para>
  <para style="q1" vid="PSA 106:19">Baaramya ekishushani ekiheesirwe.<verse eid="PSA 106:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:20: </char>
      <char style="xt" closed="false">
        <ref loc="JER 2:11">Yer 2:11</ref>; <ref loc="ROM 1:23">Rom 1:23</ref>. </char>
    </note> Okwo nikwo baahindwire ekitiinisa kya Ruhanga,</para>
  <para style="q1" vid="PSA 106:20">Omu mwanya gwakyo bakatamu ekishushani ky'enimi erikurya obunyaatsi.<verse eid="PSA 106:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:11">Zab 78:11</ref>, <ref loc="PSA 78:43">43</ref>. </char>
    </note> Baayebwa Ruhanga Omujuni waabo,</para>
  <para style="q1" vid="PSA 106:21">Owaakoreire ebikuru omuri Misri;<verse eid="PSA 106:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22" />Akakora eby'okutangaaza omu nsi ya Haamu,</para>
  <para style="q1" vid="PSA 106:22">N'ebirikutiinisa aha Nyanja erikutukura.<verse eid="PSA 106:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:23: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 32:10">Kur 32:10</ref>, <ref loc="EXO 32:11">11</ref>; <ref loc="DEU 9:14">Bir 9:14</ref>, <ref loc="DEU 9:18">18</ref>; <ref loc="EZK 20:13">Ezk 20:13</ref>. </char>
    </note> N'ahabw'ekyo yaabahayira ku arikwija kubahwerekyereza;</para>
  <para style="q1" vid="PSA 106:23">Akaabaire yaabaherizeho, kuri Musa ou yaatooraine ataramwemereire mu maisho ahasheenyukire,</para>
  <para style="q1" vid="PSA 106:23">Kutuubya ekiniga kye, ngu atakaabacwekyereza.<verse eid="PSA 106:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:24: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:31">Kub 14:31</ref>; <ref loc="DEU 9:23">Bir 9:23</ref>; <ref loc="HEB 3:18">Heb 3:18</ref>, <ref loc="HEB 3:19">19</ref>. </char>
    </note> Eego, baagaya ensi egyo erikukundwa;</para>
  <para style="q1" vid="PSA 106:24">Tibaikiriza kigambo kye;<verse eid="PSA 106:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:25: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:2">Kub 14:2</ref>. </char>
    </note> Kureka baayetomboitera omu mahema gaabo,</para>
  <para style="q1" vid="PSA 106:25">Tibaayorobera iraka rya MUKAMA.<verse eid="PSA 106:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:26, 27: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:30">Kub 14:30</ref>; <ref loc="EZK 20:23">Ezk 20:23</ref>. </char>
    </note> Nikyo yaabarahiriire, aimukize omukono gwe,</para>
  <para style="q1" vid="PSA 106:26">Ku aribagwisa omu ihamba,<verse eid="PSA 106:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27" />Kandi ku aribingira oruzaaro rwabo omu mahanga,</para>
  <para style="q1" vid="PSA 106:27">Bakataataanira omu nsi zaago.<verse eid="PSA 106:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:28: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:2">Kub 25:2</ref>, <ref loc="NUM 25:3">3</ref>; <ref loc="HOS 9:10">Hos 9:10</ref>; <ref loc="REV 2:14">Kush 2:14</ref>. </char>
    </note> Bwanyima baakwatanisa na Baali-peori,</para>
  <para style="q1" vid="PSA 106:28">Baarya ebitambirwe ahabw'abafiire.<verse eid="PSA 106:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:29, 30: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:7">Kub 25:7</ref>, <ref loc="NUM 25:8">8</ref>. </char>
    </note> Okwo nikwo baamukwatsize ekiniga n'emicwe yaabo;</para>
  <para style="q1" vid="PSA 106:29">Orufu rukabaijamu.<verse eid="PSA 106:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30" />Ahonaaho Finehaasi yaimuka, yaakora eky'okuhikiiriza ebiragiro,</para>
  <para style="q1" vid="PSA 106:30">Orufu rwahwaho.<verse eid="PSA 106:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:31: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 25:10-13">Kub 25:10-13</ref>. </char>
    </note>Ekyo kyamubarirwa kuba okuhikiirira,</para>
  <para style="q1" vid="PSA 106:31">Okuhitsya obusingye bwona obutarihwaho.<verse eid="PSA 106:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:32: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 20:2-13">Kub 20:2-13</ref>. </char>
    </note> Kandi baakwatsa MUKAMA ekiniga aha maizi ga Meriba,</para>
  <para style="q1" vid="PSA 106:32">Kyareetera Musa okugwa omu kabi ahabwabo,<verse eid="PSA 106:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33" />Ahabw'okuba bakagomera Omwoyo wa Ruhanga;</para>
  <para style="q1" vid="PSA 106:33">Ekyo kyareetera Musa okugamba ebitahikire.<verse eid="PSA 106:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:34: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:2">Bir 7:2</ref>; <ref loc="JDG 1:21">Bar 1:21</ref>, <ref loc="JDG 1:27-36">27-36</ref>. </char>
    </note> Tibarahwerekyereize mahanga,</para>
  <para style="q1" vid="PSA 106:34">Nk'oku MUKAMA yaabaragiire;<verse eid="PSA 106:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:35: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 3:5">Bar 3:5</ref>, <ref loc="JDG 3:6">6</ref>; <ref loc="EZR 9:2">Ezr 9:2</ref>; <ref loc="ISA 2:6">Isa 2:6</ref>. </char>
    </note> Kureka bakeejwanzya n'ago mahanga,</para>
  <para style="q1" vid="PSA 106:35">Baayega kukora nkabo.<verse eid="PSA 106:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:36: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 2:12">Bar 2:12</ref>, <ref loc="JDG 2:13">13</ref>; <ref loc="2KI 17:7-12">2 Bag 17:7-12</ref>. </char>
    </note> Baaheereza ebishushani byabo ebirikuramibwa,</para>
  <para style="q1" vid="PSA 106:36">Byabahindukira omutego.<verse eid="PSA 106:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:37: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:17">Bir 32:17</ref>; <ref loc="2KI 17:17">2 Bag 17:17</ref>; <ref loc="ISA 57:5">Isa 57:5</ref>; <ref loc="EZK 16:20">Ezk 16:20</ref>, <ref loc="EZK 16:21">21</ref>; <ref loc="1CO 10:20">1 Kor 10:20</ref>. </char>
    </note> Kandi baahongyera baadaimoni abaana baabo, aboojo n'abaishiki, nk'ebitambo;<verse eid="PSA 106:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:38: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:33">Kub 35:33</ref>. </char>
    </note> Baasheesha eshagama y'abataine rubanja,</para>
  <para style="q1" vid="PSA 106:38">Ey'abo boojo n'abaishiki baabo,</para>
  <para style="q1" vid="PSA 106:38">Abu baahongyeire ebishushani ebyabaire nibiramibwa omuri Kanaani;</para>
  <para style="q1" vid="PSA 106:38">Ensi yaasiisikara ahabw'okusheesha eshagama.<verse eid="PSA 106:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:39: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 20:18">Ezk 20:18</ref>, <ref loc="EZK 20:30">30</ref>, <ref loc="EZK 20:31">31</ref>. </char>
    </note> Nikwo baasiisikaire batyo ahabw'emicwe yaabo,</para>
  <para style="q1" vid="PSA 106:39">Bakahinduka abashambani omu bi baabaire nibakora.<verse eid="PSA 106:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:40, 41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:59">Zab 78:59</ref>, <ref loc="PSA 78:62">62</ref>; <ref loc="NEH 9:27">Neh 9:27</ref>; <ref loc="JDG 2:14">Bar 2:14</ref>. </char>
    </note> Nikyo ekiniga kya MUKAMA kyaiziire aha bantu be,</para>
  <para style="q1" vid="PSA 106:40">Akatamirwa kimwe obuhunguzi bwe;<verse eid="PSA 106:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41" />Akabahayo omu mikono y'abanyamahanga;</para>
  <para style="q1" vid="PSA 106:41">Abaabaire nibabanga bakabategyeka.<verse eid="PSA 106:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:42: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 4:3">Bar 4:3</ref>; <ref loc="JDG 10:12">10:12</ref>. </char>
    </note> Abazigu baabo baababonabonesa;</para>
  <para style="q1" vid="PSA 106:42">Baabagomoora, baabategyeka omu bushoboorozi bwabo.<verse eid="PSA 106:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:43: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 81:12">Zab 81:12</ref>; <ref loc="PSA 107:11">107:11</ref>; <ref loc="JDG 2:16">Bar 2:16</ref>; <ref loc="LEV 26:39">Lev 26:39</ref>. </char>
    </note> Kaingi akaba abakiza;</para>
  <para style="q1" vid="PSA 106:43">Kwonka bamugomera omu naama zaabo,</para>
  <para style="q1" vid="PSA 106:43">N'okutahikiirira kwabo kubagarura ahansi.<verse eid="PSA 106:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:44: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 3:9">Bar 3:9</ref>; <ref loc="JDG 6:6">6:6</ref>. </char>
    </note> N'obu byabaire biba bityo, ku yaabaire ahurira okutaka kwabo,</para>
  <para style="q1" vid="PSA 106:44">Ata omutima aha busaasi bwabo,<verse eid="PSA 106:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:45: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:13">Zab 90:13</ref>; <ref loc="LEV 26:42">Lev 26:42</ref>; <ref loc="LAM 3:32">Tonz 3:32</ref>. </char>
    </note> Aijuka endagaano ye ahabwabo,</para>
  <para style="q1" vid="PSA 106:45">Ayegarukamu, nk'embabazi ze nyingi oku ziri.<verse eid="PSA 106:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:46: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 9:9">Ezr 9:9</ref>; <ref loc="JER 42:12">Yer 42:12</ref>. </char>
    </note> Abareetera okusaasirwa abo boona,</para>
  <para style="q1" vid="PSA 106:46">Abaabaire baba babanyagire.<verse eid="PSA 106:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:47, 48: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 16:35">1 Bus 16:35</ref>, <ref loc="1CH 16:36">36</ref>. </char>
    </note> Otujune, ai MUKAMA Ruhanga waitu,</para>
  <para style="q1" vid="PSA 106:47">Otutaaruure, otwihe omu mahanga,</para>
  <para style="q1" vid="PSA 106:47">Tubone kusiima eiziina ryawe eririkwera,</para>
  <para style="q1" vid="PSA 106:47">Twesiimire okuhimbisibwa kwawe.<note caller="-" style="x"><char style="xo" closed="false">106:47: </char><char style="xt" closed="false"><ref loc="PSA 107:3">Zab 107:3</ref>. </char></note><verse eid="PSA 106:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">106:48: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:13">Zab 41:13</ref>. </char>
    </note> MUKAMA Ruhanga wa Israeli ahimbisibwe</para>
  <para style="q1" vid="PSA 106:48">Okwiha ira ryona okuhitsya ebiro byona!</para>
  <para style="q1" vid="PSA 106:48">Kandi abantu boona bagire bati: Amiina.</para>
  <para style="q1" vid="PSA 106:48">Haleluya.<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" sid="PSA 107" />
  <para style="ms">EKITABO KYA KATAANO</para>
  <para style="s1">Okusiima Mukama ahabw'okujuna kwe okw'okutangaaza aha bantu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:1">Zab 106:1</ref>. </char>
    </note> Yeimwe, musiime MUKAMA, ahabw'okuba ni murungi,</para>
  <para style="q1" vid="PSA 107:1">Kandi embabazi ze n'ez'ebiro n'ebiro.<verse eid="PSA 107:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:10">Zab 106:10</ref>; <ref loc="ISA 62:12">Isa 62:12</ref>. </char>
    </note> Abacungwirwe MUKAMA bagire batyo,</para>
  <para style="q1" vid="PSA 107:2">Abu yaacungwire, akabaiha omu mikono y'omuzigu,<verse eid="PSA 107:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:47">Zab 106:47</ref>; <ref loc="ISA 43:5">Isa 43:5</ref>, <ref loc="ISA 43:6">6</ref>; <ref loc="ISA 49:12">49:12</ref>; <ref loc="JER 29:14">Yer 29:14</ref>; <ref loc="EZK 39:27">Ezk 39:27</ref>. </char>
    </note> Akabataarura naabaiha omu nsi nyingi,</para>
  <para style="q1" vid="PSA 107:3">Okuruga oburugwa-izooba, n'oburengyerwa-izooba,</para>
  <para style="q1" vid="PSA 107:3">N'obukiizi-bwa-bumosho n'obwa-buryo.<verse eid="PSA 107:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:10">Bir 32:10</ref>. </char>
    </note> Bakazengyerera omu ihamba,</para>
  <para style="q1" vid="PSA 107:4">Baabura omuhanda gw'okubahitsya omu rurembo rw'okutuuramu;<verse eid="PSA 107:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5" />Baagira enjara n'eiriho,</para>
  <para style="q1" vid="PSA 107:5">Emitima yaabo yaagwa enshazi.<verse eid="PSA 107:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:15">Zab 50:15</ref>; <ref loc="PSA 106:44">106:44</ref>. </char>
    </note> Bwanyima baatakira MUKAMA omu naku zaabo,</para>
  <para style="q1" vid="PSA 107:6">Yaabaiha omu busaasi bwabo;<verse eid="PSA 107:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:7: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 8:21">Ezr 8:21</ref>. </char>
    </note> Yaabahabura omuhanda ogugororokire,</para>
  <para style="q1" vid="PSA 107:7">Ngu babone kuhika omu rurembo rw'okutuuramu.<verse eid="PSA 107:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8" />Kuri abantu basiima MUKAMA ahabw'embabazi ze,</para>
  <para style="q1" vid="PSA 107:8">N'ahabw'eby'okutangaaza ebi akorera abantu!<verse eid="PSA 107:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:10">Zab 34:10</ref>; <ref loc="LUK 1:53">Luk 1:53</ref>. </char>
    </note> Ahabw'okuba ahaazya omutima gw'oine eiriho,</para>
  <para style="q1" vid="PSA 107:9">Kandi oine enjara amwigutsa ebirungi.<verse eid="PSA 107:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:21">Yob 10:21</ref>; <ref loc="JOB 36:8">36:8</ref>; <ref loc="LUK 1:79">Luk 1:79</ref>. </char>
    </note> Abamwe bakaba bashutami omu mwirima n'omu kibunda ky'okufa,</para>
  <para style="q1" vid="PSA 107:10">Babohirwe obusaasi n'ebyoma,<verse eid="PSA 107:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:40">Zab 78:40</ref>; <ref loc="PSA 106:43">106:43</ref>; <ref loc="PRO 1:30">Enf 1:30</ref>; <ref loc="LUK 7:30">Luk 7:30</ref>. </char>
    </note> Ahabw'okugomera ebigambo bya Ruhanga,</para>
  <para style="q1" vid="PSA 107:11">N'okugaya enaama za Rukira-boona.<verse eid="PSA 107:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:11">Zab 22:11</ref>. </char>
    </note> Nikyo yainikiire emitima yaabo n'emirimo erikurusya;</para>
  <para style="q1" vid="PSA 107:12">Bakagwa ahansi, bakabura kihwera.<verse eid="PSA 107:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13" />Bwanyima bakatakira MUKAMA omu naku zaabo,</para>
  <para style="q1" vid="PSA 107:13">Akabakiza obusaasi bwabo.<verse eid="PSA 107:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:10">Zab 107:10</ref>; <ref loc="ISA 49:9">Isa 49:9</ref>. </char>
    </note> Akabaiha omu mwirima n'omu kibunda ky'okufa,</para>
  <para style="q1" vid="PSA 107:14">akacwanyagura enjegyere zaabo.<verse eid="PSA 107:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15" />Kuri abantu basiima MUKAMA ahabw'embabazi ze,</para>
  <para style="q1" vid="PSA 107:15">N'ahabw'eby'okutangaaza ebi akorera abantu!<verse eid="PSA 107:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:2">Isa 45:2</ref>. </char>
    </note> Ahakuba ahenda enyigi z'emiringa,</para>
  <para style="q1" vid="PSA 107:16">Kandi atemamu kabiri empimbi z'ebyoma.<verse eid="PSA 107:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17" />Abashema bakabonabonesibwa ahabw'okushiisha kwabo</para>
  <para style="q1" vid="PSA 107:17">N'ahabw'okutahikiirira kwabo;<verse eid="PSA 107:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 33:20">Yob 33:20</ref>, <ref loc="JOB 33:22">22</ref>. </char>
    </note> Amagara gaabo gaatamwa eby'okurya byona,</para>
  <para style="q1" vid="PSA 107:18">Bairira haihi amarembo g'okufa.<verse eid="PSA 107:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19" />Bwanyima baatakira MUKAMA omu naku zaabo,</para>
  <para style="q1" vid="PSA 107:19">Yaabaiha omu busaasi bwabo;<verse eid="PSA 107:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:3">Zab 103:3</ref>, <ref loc="PSA 103:4">4</ref>; <ref loc="2KI 20:5">2 Bag 20:5</ref>; <ref loc="MAT 8:8">Mat 8:8</ref>. </char>
    </note> Yaayohereza ekigambo kye, yaabakiza,</para>
  <para style="q1" vid="PSA 107:20">Yaabaiha omu kuhwerekyerera kwabo.<verse eid="PSA 107:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21" />Kuri abantu basiima MUKAMA ahabw'embabazi ze,</para>
  <para style="q1" vid="PSA 107:21">N'ahabw'eby'okutangaaza ebi akorera abantu!<verse eid="PSA 107:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:11">Zab 9:11</ref>; <ref loc="PSA 50:14">50:14</ref>; <ref loc="HEB 13:15">Heb 13:15</ref>. </char>
    </note> Ka bahongye ebitambo by'okusiima,</para>
  <para style="q1" vid="PSA 107:22">Bamanyisize omu kweshongora ebi yaakozire.<verse eid="PSA 107:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:23: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:10">Isa 42:10</ref>. </char>
    </note> Abarikuza aha nyanja omu meeri,</para>
  <para style="q1" vid="PSA 107:23">Bakakorera emirimo yaabo omu mayanja,<verse eid="PSA 107:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24" />Nibo baareeba emirimo ya MUKAMA,</para>
  <para style="q1" vid="PSA 107:24">N'eby'okutangaaza bye omuri ago maizi maingi.<verse eid="PSA 107:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:25: </char>
      <char style="xt" closed="false">
        <ref loc="JON 1:4">Yon 1:4</ref>. </char>
    </note> Ahakuba aragiira, eihunga ry'amaani riija,</para>
  <para style="q1" vid="PSA 107:25">Riimutsya ebingonzi byayo.<verse eid="PSA 107:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:26: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:14">Zab 22:14</ref>. </char>
    </note> Batemba ahaiguru, bagaruka ahansi;</para>
  <para style="q1" vid="PSA 107:26">Emitima yaabo eyaga ahabw'obusaasi;<verse eid="PSA 107:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:27: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 12:25">Yob 12:25</ref>. </char>
    </note> Bagyenda nibazonga oku n'oku, nibagwererana nk'omusinzi,</para>
  <para style="q1" vid="PSA 107:27">Baburirwa kimwe obwengye.<verse eid="PSA 107:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28" />Bwanyima batakira MUKAMA omu naku zaabo,</para>
  <para style="q1" vid="PSA 107:28">Abaiha omu busaasi bwabo;<verse eid="PSA 107:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 65:7">Zab 65:7</ref>. </char>
    </note> Acureeza eihunga,</para>
  <para style="q1" vid="PSA 107:29">Ebingonzi byayo bituuza.<verse eid="PSA 107:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30" />Bwanyima bashemererwa ahabw'okutuuza;</para>
  <para style="q1" vid="PSA 107:30">Kandi abahitsya aha nyambukiro ei baba nibeetenga.<verse eid="PSA 107:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31" />Kuri abantu basiima MUKAMA ahabw'embabazi ze,</para>
  <para style="q1" vid="PSA 107:31">N'ahabw'eby'okutangaaza ebi akorera abantu!<verse eid="PSA 107:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:22">Zab 22:22</ref>, <ref loc="PSA 22:25">25</ref>. </char>
    </note> Ka bamuye ekitiinisa omu mutwe gw'abantu,</para>
  <para style="q1" vid="PSA 107:32">Bamuhimbisize omu ishengyero ry'abakuru.<verse eid="PSA 107:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:33: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 42:15">Isa 42:15</ref>; <ref loc="ISA 50:2">50:2</ref>; <ref loc="NAM 1:4">Nah 1:4</ref>. </char>
    </note> Emigyera agihindura eihamba ry'omusheenyi,</para>
  <para style="q1" vid="PSA 107:33">N'enshuro z'amaizi azihindura empaama;<verse eid="PSA 107:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:34: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:10">Kut 13:10</ref>; <ref loc="GEN 19:24-28">19:24-28</ref>. </char>
    </note> Kandi ensi erikweza agihindura eihamba ry'orwonyo</para>
  <para style="q1" vid="PSA 107:34">ahabw'obubi bw'abagitwiremu.<verse eid="PSA 107:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:35: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:26">Yob 38:26</ref>, <ref loc="JOB 38:27">27</ref>; <ref loc="ISA 35:7">Isa 35:7</ref>; <ref loc="ISA 41:18">41:18</ref>. </char>
    </note> Kandi ahindura eihamba ebiyanja by'amaizi,</para>
  <para style="q" vid="PSA 107:35">N'eitaka eryomire arifumuramu enshuro.<verse eid="PSA 107:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36" />Omwo nimwo atuuza abaine enjara,</para>
  <para style="q1" vid="PSA 107:36">Ngu beeyombekyeremu orurembo rw'okutuuramu,<verse eid="PSA 107:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37" />Babibe embibo omu misiri, babyare emizaabibu,</para>
  <para style="q1" vid="PSA 107:37">Beetungire emyaka eyezire munonga.<verse eid="PSA 107:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:38: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:2">Kut 12:2</ref>. </char>
    </note> Abaha omugisha, bakanya munonga;</para>
  <para style="q1" vid="PSA 107:38">Kandi taikiriza nte zaabo kutuuba.<verse eid="PSA 107:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39" />Obundi ku batuuba, bagarurwa ahansi</para>
  <para style="q1" vid="PSA 107:39">Ahabw'okubonabonesibwa n'enaku n'obusaasi,<verse eid="PSA 107:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:40: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 12:21">Yob 12:21</ref>, <ref loc="JOB 12:24">24</ref>. </char>
    </note> Areetera abakuru okugayirwa kimwe,</para>
  <para style="q1" vid="PSA 107:40">Abazengyereza omu ihamba eritarimu kirari.<verse eid="PSA 107:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:7">Zab 113:7</ref>; <ref loc="JOB 21:11">Yob 21:11</ref>; <ref loc="1SA 2:8">1 Sam 2:8</ref>. </char>
    </note> Kwonka abakyene abatunguura, abaiha omu kubonabona,</para>
  <para style="q1" vid="PSA 107:41">Abakanyisiza enganda nk'amasyo.<verse eid="PSA 107:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:42: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:11">Zab 63:11</ref>; <ref loc="JOB 5:16">Yob 5:16</ref>; <ref loc="JOB 22:19">22:19</ref>. </char>
    </note> Abahikiriire baryakireeba, beesiime;</para>
  <para style="q1" vid="PSA 107:42">Okutahikiirira kwona kwigara akanwa.<verse eid="PSA 107:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43" />
    <note caller="-" style="x">
      <char style="xo" closed="false">107:43: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:12">Yer 9:12</ref>; <ref loc="DAN 12:10">Dan 12:10</ref>; <ref loc="HOS 14:9">Hos 14:9</ref>. </char>
    </note> Oine obwengye weena ate omutima aha bigambo ebyo;</para>
  <para style="q1" vid="PSA 107:43">Abantu bateekateekye aha mbabazi za MUKAMA.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" sid="PSA 108" />
  <para style="s1">Okuhimbisa Ruhanga n'okumushaba obusinguzi Ekyeshongoro.</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:1-5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:7-11">Zab 57:7-11</ref>. </char>
    </note> Omutima gwangye gugumire, ai Ruhanga.</para>
  <para style="q1" vid="PSA 108:1">Ndyayeshongora; eego, ndyayeshongora eby'okuhimbisa n'obwengye bwangye.<note caller="-" style="x"><char style="xo" closed="false">108:1: </char><char style="xt" closed="false"><ref loc="PSA 112:7">Zab 112:7</ref>. </char></note><verse eid="PSA 108:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:2: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 15:16">1 Bus 15:16</ref>. </char>
    </note> Musisiimukye, imwe enanga n'endingiri!</para>
  <para style="q1" vid="PSA 108:2">Naanye ahabwangye niinyija kusisiimuka kare munonga.<verse eid="PSA 108:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3" />Ai MUKAMA, ndyakusiima omu bantu,</para>
  <para style="q1" vid="PSA 108:3">Ndyayeshongora eby'okukuhimbisa omu mahanga.<verse eid="PSA 108:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:5">Zab 36:5</ref>; <ref loc="PSA 113:4">113:4</ref>. </char>
    </note> Ahakuba embabazi zaawe ni nyingi okukira eiguru,</para>
  <para style="q1" vid="PSA 108:4">N'okwesigwa kwawe nikuhika omu bicu.<verse eid="PSA 108:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:5">Zab 57:5</ref>. </char>
    </note> Oteebwe ahaiguru okukira eiguru, ai Ruhanga,</para>
  <para style="q1" vid="PSA 108:5">Ekitiinisa kyawe kibe ahaiguru y'ensi yoona.<verse eid="PSA 108:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:6-13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:5-12">Zab 60:5-12</ref>. </char>
    </note> Ahabw'omukono gwawe ogwa buryo otuhe obusinguzi, otugarukyemu,</para>
  <para style="q1" vid="PSA 108:6">Eihanga ryawe eririkukundwa ribone kukira abazigu.<verse eid="PSA 108:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 89:35">Zab 89:35</ref>; <ref loc="GEN 33:17">Kut 33:17</ref>. </char>
    </note> Ruhanga akeema omu Mwanya gwe ogurikwera, yaagira ati:</para>
  <para style="q1" vid="PSA 108:7">Ndyabaganisa Shekemu n'okwesiima kuhango,</para>
  <para style="q1" vid="PSA 108:7">Ngabe oruhanga rwa Sukoosi omu bicweka.<verse eid="PSA 108:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:8: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:10">Kut 49:10</ref>; <ref loc="NUM 32:1">Kub 32:1</ref>; <ref loc="DEU 33:17">Bir 33:17</ref>. </char>
    </note> Gileadi n'eyangye; na Manaase nayo n'eyangye;</para>
  <para style="q1" vid="PSA 108:8">Efuraimu n'enkofiira y'okundinda;</para>
  <para style="q1" vid="PSA 108:8">Yuda n'enkoni yangye ey'obukama.<verse eid="PSA 108:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:9, 10: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 8:1">2 Sam 8:1</ref>, <ref loc="2SA 8:2">2</ref>, <ref loc="2SA 8:14">14</ref>. </char>
    </note> Moabu n'ekinaabiro kyangye;</para>
  <para style="q1" vid="PSA 108:9">Edomu niho nnaga enkaito yangye;</para>
  <para style="q1" vid="PSA 108:9">Filistia niho nteerera akaari k'obusinguzi.<verse eid="PSA 108:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10" />N'oha orindeeta omu rurembo rw'orugo rugumire?</para>
  <para style="q1" vid="PSA 108:10">Kandi orimpitsya Edomu n'oha?<verse eid="PSA 108:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:9">Zab 44:9</ref>. </char>
    </note> Ai Ruhanga, toratwangire?</para>
  <para style="q1" vid="PSA 108:11">Ebi biro tokihurura na ngabo zaitu, ai Ruhanga.<verse eid="PSA 108:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 146:3">Zab 146:3</ref>. </char>
    </note> Otuhe emikono, turwanise ababisha baitu;</para>
  <para style="q1" vid="PSA 108:12">Ahakuba okuhwera kw'abantu tikwine mugasho.<verse eid="PSA 108:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">108:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:5">Zab 44:5</ref>; <ref loc="PSA 118:15">118:15</ref>, <ref loc="PSA 118:16">16</ref>; <ref loc="ISA 63:3">Isa 63:3</ref>. </char>
    </note> Ahabw'amaani ga Ruhanga turyarwana mashaija;</para>
  <para style="q1" vid="PSA 108:13">Ahakuba niwe ariribatiirira ababisha baitu.<verse eid="PSA 108:13" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" sid="PSA 109" />
  <para style="s1">Okushaba Ruhanga okuzimuurira ababi ebi baamukoreire Aha Mukuru w'abeeshongozi.</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 109:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 83:1">Zab 83:1</ref>; <ref loc="JER 17:14">Yer 17:14</ref>. </char>
    </note> Ai Ruhanga ou ntuura nimpimbisa, oteetsiza,<verse eid="PSA 109:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2" />Ahakuba bakanyashamira n'akanwa k'obubi n'obugobya,</para>
  <para style="q1" vid="PSA 109:2">Nibambeiherera.<verse eid="PSA 109:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3" />Bantangatangire n'ebigambo by'orwango,</para>
  <para style="q1" vid="PSA 109:3">Nibandwanisiza busha.<verse eid="PSA 109:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:20">Zab 38:20</ref>. </char>
    </note> Okukunda oku ndikubakunda bakuzimwire okuba abazigu bangye;</para>
  <para style="q1" vid="PSA 109:4">Kwonka nyowe nguma ninshaba.<verse eid="PSA 109:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:12">Zab 35:12</ref>. </char>
    </note> Batyo banzimuriire ebibi ahabw'ebirungi,</para>
  <para style="q1" vid="PSA 109:5">Na rwango ahabw'okubakunda.<verse eid="PSA 109:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6" />Omutegyekyese omubi;</para>
  <para style="q1" vid="PSA 109:6">Omuregi amwemerere aha rubaju rwa buryo.<verse eid="PSA 109:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:7: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 28:9">Enf 28:9</ref>. </char>
    </note> Ku araacwerwe orubanja, ashohore rumusingire;</para>
  <para style="q1" vid="PSA 109:7">Okushaba kwe kuhindukye ekibi.<verse eid="PSA 109:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:8: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 17:12">Yoh 17:12</ref>; <ref loc="ACT 1:20">Byak 1:20</ref>. </char>
    </note> Ebiro by'amagara ge bituube,</para>
  <para style="q1" vid="PSA 109:8">Obureeberezi bwe butwarwe ondiijo.<verse eid="PSA 109:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:9: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:24">Kur 22:24</ref>; <ref loc="JER 18:21">Yer 18:21</ref>. </char>
    </note> Abaana be babe efuuzi,</para>
  <para style="q1" vid="PSA 109:9">N'omukazi we abe omufaakazi.<verse eid="PSA 109:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:15">Zab 59:15</ref>; <ref loc="GEN 4:12">Kut 4:12</ref>. </char>
    </note> Abaana be babe ebizengyerezi, basheegye;</para>
  <para style="q1" vid="PSA 109:10">Babingwe omu matongo ahu baabaire batwire.<verse eid="PSA 109:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11" />Omwihuza anyagye byona ebi aine;</para>
  <para style="q1" vid="PSA 109:11">Abanyamahanga banyagye ebi yaahendekyeire.<verse eid="PSA 109:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:4">Yob 5:4</ref>. </char>
    </note> Hatarigira owaamugirira embabazi,</para>
  <para style="q1" vid="PSA 109:12">N'obu yaakuba ow'okusaasira efuuzi ze.<verse eid="PSA 109:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:5">Zab 9:5</ref>; <ref loc="PSA 21:10">21:10</ref>. </char>
    </note> Oruzaaro rwe rucwekyerezibwe;</para>
  <para style="q1" vid="PSA 109:13">Omu busingye oburiija eiziina ryarwo ryebe.<verse eid="PSA 109:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:5">Kur 20:5</ref>; <ref loc="NEH 4:5">Neh 4:5</ref>. </char>
    </note> Okutahikiirira kwa baishenkuru kwijukwe MUKAMA,</para>
  <para style="q1" vid="PSA 109:14">N'ekibi kya nyina kirekye kuragazibwa!<verse eid="PSA 109:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:16">Zab 34:16</ref>; <ref loc="PSA 90:8">90:8</ref>; <ref loc="JOB 18:17">Yob 18:17</ref>. </char>
    </note> Bigume omu maisho ga MUKAMA obutoosha,</para>
  <para style="q1" vid="PSA 109:15">amareho okwijukwa kwabo omu nsi;<verse eid="PSA 109:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16" />Ahabw'okuba taraijukire kusaasira,</para>
  <para style="q1" vid="PSA 109:16">Kureka akahiiga omukyene n'enshoberwa,</para>
  <para style="q1" vid="PSA 109:16">N'ab'emitima ehendekire ngu abaite.<verse eid="PSA 109:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:17: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 35:6">Ezk 35:6</ref>. </char>
    </note> Akakunda okukyeena; k'emikyeeno emuhikyeho;</para>
  <para style="q1" vid="PSA 109:17">Tarashemerereirwe kushabira abandi omugisha; nkaahenwa ki gumuza hare.<verse eid="PSA 109:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18" />Akaba ajwara okukyeena nk'ekijwaro;</para>
  <para style="q1" vid="PSA 109:18">Nkaahenwa ki kumuza omunda nk'amaizi, kandi nk'amajuta omu magufa ge.<verse eid="PSA 109:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19" />Kumuhindukira nk'omunagiro ogu ayehumbikire,</para>
  <para style="q1" vid="PSA 109:19">N'omushumi ogu ayezirikisa obutoosha.<verse eid="PSA 109:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PSA 109:20" />Ebyo bibe nibyo byaba ebihembo by'abazigu bangye ebirikuruga ahari MUKAMA,</para>
  <para style="q1" vid="PSA 109:20">N'abarikugamba kubi aha magara gangye.<verse eid="PSA 109:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:16">Zab 69:16</ref>. </char>
    </note> Kwonka Iwe RUHANGA Mukama wangye, ahabw'eiziina ryawe ongirire eby'embabazi;</para>
  <para style="q1" vid="PSA 109:21">Onkize, ahabw'okuba okusaasira kwawe ni kurungi;<verse eid="PSA 109:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22" />Ahakuba ndi omukyene kandi enshoberwa;</para>
  <para style="q1" vid="PSA 109:22">N'omutima gwangye guhutaire omunda yangye.<verse eid="PSA 109:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:11">Zab 102:11</ref>. </char>
    </note> Bingyendera kimwe, mpwaho nk'ekirengabazaana;</para>
  <para style="q1" vid="PSA 109:23">Nkunkumurwa, nnagwa nk'oruzigye.<verse eid="PSA 109:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:13">Zab 35:13</ref>; <ref loc="JOB 16:8">Yob 16:8</ref>. </char>
    </note> Amaju gangye tigaine maani ahabw'okusiibakwo;</para>
  <para style="q1" vid="PSA 109:24">Omubiri gwangye guhururukire ahabw'okubura ebishaju.<verse eid="PSA 109:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:6">Zab 22:6</ref>, <ref loc="PSA 22:7">7</ref>; <ref loc="ISA 37:22">Isa 37:22</ref>; <ref loc="MAT 27:39">Mat 27:39</ref>. </char>
    </note> Mpindukire ekirikugaywa aharibo;</para>
  <para style="q1" vid="PSA 109:25">Ku barikundeeba, bazongoza emitwe yaabo.<verse eid="PSA 109:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26" />Mpwera, ai MUKAMA Ruhanga wangye;</para>
  <para style="q1" vid="PSA 109:26">Onjune, nk'oku embabazi zaawe ziri,<verse eid="PSA 109:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:27: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 37:7">Yob 37:7</ref>. </char>
    </note> Babone kumanya ngu ebyo n'omukono gwawe;</para>
  <para style="q1" vid="PSA 109:27">Niiwe obikozire, ai MUKAMA.<verse eid="PSA 109:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:28: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 16:12">2 Sam 16:12</ref>; <ref loc="ISA 65:14">Isa 65:14</ref>. </char>
    </note> Bo ka bakyeene, kwonka Iwe ohe omugisha;</para>
  <para style="q1" vid="PSA 109:28">Ku baraimukye, bakwatwe enshoni;</para>
  <para style="q1" vid="PSA 109:28">Kwonka omwiru waawe ashemererwe!<verse eid="PSA 109:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:26">Zab 35:26</ref>; <ref loc="PSA 71:13">71:13</ref>; <ref loc="JOB 8:22">Yob 8:22</ref>. </char>
    </note> Ababisha bangye bajwekwe okugaywa;</para>
  <para style="q1" vid="PSA 109:29">Beehumbikye enshoni zaabo nk'omunagiro.<verse eid="PSA 109:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30" />Ndyasiima MUKAMA munonga n'akanwa kangye;</para>
  <para style="q1" vid="PSA 109:30">Eego, ndyamuhimbisa omu iteeraniro rihango ry'abantu;<verse eid="PSA 109:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">109:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:8">Zab 16:8</ref>. </char>
    </note> Ahakuba ayemerera aha rubaju rwa buryo rw'enshoberwa,</para>
  <para style="q1" vid="PSA 109:31">Okugikiza abarikugicwera orubanja rw'okufa.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" sid="PSA 110" />
  <para style="s1">Ruhanga okuha Kristo obushoboorozi bw'okutegyeka</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 110:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:1: </char>
      <char style="xt" closed="false">
        <ref loc="MRK 12:36">Mak 12:36</ref>; <ref loc="ACT 2:34">Byak 2:34</ref>, <ref loc="ACT 2:35">35</ref>; <ref loc="1CO 15:25">1 Kor 15:25</ref>; <ref loc="HEB 1:13">Heb 1:13</ref>; <ref loc="HEB 10:12">10:12</ref>, <ref loc="HEB 10:13">13</ref>. </char>
    </note> MUKAMA akagambira Mukama wangye ati:</para>
  <para style="q1" vid="PSA 110:1">Shutama aha rubaju rwangye rwa buryo,</para>
  <para style="q1" vid="PSA 110:1">Okuhitsya obu ndigira abazigu baawe akatebe k'ebigyere byawe.<verse eid="PSA 110:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 45:6">Zab 45:6</ref>; <ref loc="DAN 7:14">Dan 7:14</ref>. </char>
    </note> MUKAMA aryayohereza enkoni y'obushoboorozi bwawe, ari omuri Saayuuni;</para>
  <para style="q1" vid="PSA 110:2">Otegyekye ahagati omu bazigu baawe.<verse eid="PSA 110:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:9">Zab 96:9</ref>; <ref loc="JDG 5:2">Bar 5:2</ref>. </char>
    </note> Abantu baawe baryayehayo beekundiire aha izooba eri origabiraho engabo,</para>
  <para style="q1" vid="PSA 110:3">Abatsigazi baawe baije ah'ori nk'ekime,</para>
  <para style="q1" vid="PSA 110:3">Bajwaire eby'obwecumi ebirikwera, baimukire kare omu kasheeshe.<verse eid="PSA 110:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:4: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 14:18">Kut 14:18</ref>; <ref loc="NUM 23:19">Kub 23:19</ref>; <ref loc="ZEC 6:13">Zek 6:13</ref>; <ref loc="HEB 5:6">Heb 5:6</ref>; <ref loc="HEB 6:17">6:17</ref>, <ref loc="HEB 6:18">18</ref>, <ref loc="HEB 6:20">20</ref>; <ref loc="HEB 7:17">7:17</ref>, <ref loc="HEB 7:21">21</ref>. </char>
    </note> MUKAMA akarahira, kandi taryefuuza, naagira ati:</para>
  <para style="q1" vid="PSA 110:4">Ori omunyamurwa w'ebiro byona omu muringo gwa Melikizedeki.<verse eid="PSA 110:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:5">Zab 2:5</ref>, <ref loc="PSA 2:12">12</ref>; <ref loc="PSA 16:8">16:8</ref>; <ref loc="ROM 2:5">Rom 2:5</ref>; <ref loc="REV 11:18">Kush 11:18</ref>. </char>
    </note> Mukama ari aha rubaju rwawe rwa buryo;</para>
  <para style="q1" vid="PSA 110:5">Aryacwanyagura abagabe aha izooba ry'ekiniga kye.<verse eid="PSA 110:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">110:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:21">Zab 68:21</ref>; <ref loc="ISA 2:4">Isa 2:4</ref>; <ref loc="JOL 3:12">Yoel 3:12</ref>. </char>
    </note> Aryacwa emanja omu mahanga.</para>
  <para style="q1" vid="PSA 110:6">Aryaijuza emyanya emitumbi,</para>
  <para style="q1" vid="PSA 110:6">Ayatagurire emitwe y'engabo omu mwanya gugarami.<verse eid="PSA 110:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7" />Aryanywa aha kagyera k'omu muhanda;</para>
  <para style="q1" vid="PSA 110:7">Nikyo kirimureetera kwimutsya omutwe.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" sid="PSA 111" />
  <para style="s1">Okusiima Mukama ahabw'obukuru bwe n'oburungi bwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 111:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:35">Zab 104:35</ref>; <ref loc="PSA 138:1">138:1</ref>. </char>
    </note> Haleluya. Ndyasiima MUKAMA n'omutima gwangye gwona,</para>
  <para style="q1" vid="PSA 111:1">Omu ishengyero ry'abahikiriire n'omu mutwe gwabo.<verse eid="PSA 111:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:5">Zab 92:5</ref>; <ref loc="PSA 139:14">139:14</ref>; <ref loc="REV 15:3">Kush 15:3</ref>. </char>
    </note> Ebi MUKAMA akora ni bikuru,</para>
  <para style="q1" vid="PSA 111:2">Abarikubishemerererwa babyetegyereza.<verse eid="PSA 111:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:3">Zab 112:3</ref>, <ref loc="PSA 112:9">9</ref>; <ref loc="PSA 145:5">145:5</ref>. </char>
    </note> Emirimo ye n'ey'ekitiinisa n'obukuru,</para>
  <para style="q1" vid="PSA 111:3">Kandi okuhikiirira kwe n'okw'ebiro byona.<verse eid="PSA 111:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:15">Zab 86:15</ref>. </char>
    </note> Areetera emirimo ye ey'okutangaaza okwijukwa.</para>
  <para style="q1" vid="PSA 111:4">MUKAMA n'ow'embabazi, kandi ow'okusaasira kwingi.<verse eid="PSA 111:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:9">Zab 34:9</ref>, <ref loc="PSA 34:10">10</ref>; <ref loc="PSA 105:8">105:8</ref>; <ref loc="MAT 6:31-33">Mat 6:31-33</ref>. </char>
    </note> Abarikumutiina abaha eby'okurya;</para>
  <para style="q1" vid="PSA 111:5">Aryaguma naijuka endagaano ye.<verse eid="PSA 111:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6" />Akooreka abantu be ebi yaakozire oku biri bikuru,</para>
  <para style="q1" vid="PSA 111:6">Obu yaabaha obuhunguzi bw'abanyamahanga.<verse eid="PSA 111:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:7">Zab 10:7</ref>. </char>
    </note> Ebi yaakozire n'emikono ye n'eby'okwesigwa kandi eby'oburyo;</para>
  <para style="q1" vid="PSA 111:7">Ebiragiro bye byona bihamire.<verse eid="PSA 111:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:8: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:8">Isa 40:8</ref>; <ref loc="MAT 5:18">Mat 5:18</ref>; <ref loc="REV 15:3">Kush 15:3</ref>. </char>
    </note> Bikateebwaho kuba eby'ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 111:8">Byaragiirwa omu mazima n'okuhikiirira.<verse eid="PSA 111:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 133:3">Zab 133:3</ref>; <ref loc="LUK 1:49">Luk 1:49</ref>, <ref loc="LUK 1:68">68</ref>. </char>
    </note> Akatwekyera abantu be eky'okubacungura;</para>
  <para style="q1" vid="PSA 111:9">Yaataho endagaano ye kuba ey'ebiro byona;</para>
  <para style="q1" vid="PSA 111:9">Eiziina rye niryera kandi n'ery'okutiinwa.<verse eid="PSA 111:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">111:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:6">Bir 4:6</ref>; <ref loc="JOB 28:28">Yob 28:28</ref>; <ref loc="PRO 1:7">Enf 1:7</ref>; <ref loc="PRO 3:4">3:4</ref>; <ref loc="PRO 9:10">9:10</ref>. </char>
    </note> Omu kutiina MUKAMA nimwo obwengye bukomooka;</para>
  <para style="q1" vid="PSA 111:10">Boona abakugyenderamu baine okwetegyereza kurungi.</para>
  <para style="q1" vid="PSA 111:10">Okuhimbisibwa kwe n'okw'ebiro byona.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" sid="PSA 112" />
  <para style="s1">Okuhiirwa kw'abarikutiina Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 112:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:2">Zab 1:2</ref>; <ref loc="PSA 104:35">104:35</ref>; <ref loc="PSA 128:1">128:1</ref>. </char>
    </note> Haleluya. Aine omugisha omuntu orikutiina MUKAMA,</para>
  <para style="q1" vid="PSA 112:1">Akashemerererwa munonga ebiragiro bye.<verse eid="PSA 112:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:2: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 20:7">Enf 20:7</ref>. </char>
    </note> Baijukuru be baryaba ab'amaani omu nsi;</para>
  <para style="q1" vid="PSA 112:2">Oruzaaro rw'ohikiriire ruryaheebwa omugisha.<verse eid="PSA 112:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:3: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:16">Enf 3:16</ref>; <ref loc="PRO 15:6">15:6</ref>. </char>
    </note> Eitungo n'obutungi biryaba omu nju ye;</para>
  <para style="q1" vid="PSA 112:3">Kandi okuhikiirira kwe kuryaba okw'ebiro n'ebiro.<verse eid="PSA 112:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:4">Zab 111:4</ref>; <ref loc="JOB 11:17">Yob 11:17</ref>. </char>
    </note> Ow'omutima ogugororokire ajwerwa omushana omu mwirima,</para>
  <para style="q1" vid="PSA 112:4">Gujwera oine embabazi n'okusaasira kwingi kandi ohikiriire.<verse eid="PSA 112:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:26">Zab 37:26</ref>. </char>
    </note> Aine omugisha omuntu ogira obufura, akaguza abandi,</para>
  <para style="q1" vid="PSA 112:5">akakora emirimo ye omu buryo buhikire;<verse eid="PSA 112:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 55:22">Zab 55:22</ref>; <ref loc="PRO 10:7">Enf 10:7</ref>. </char>
    </note> Ahakuba ohikiriire taritengyetsibwa,</para>
  <para style="q1" vid="PSA 112:6">Aryaijukwa ebiro byona.<verse eid="PSA 112:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:7">Zab 57:7</ref>; <ref loc="PRO 1:33">Enf 1:33</ref>. </char>
    </note> Taritiinisibwa nkuru mbi;</para>
  <para style="q1" vid="PSA 112:7">Omutima gwe guhamire nigwesiga MUKAMA.<verse eid="PSA 112:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:7">Zab 54:7</ref>. </char>
    </note> Omutima gwe guhamiire hamwe, taritiina,</para>
  <para style="q1" vid="PSA 112:8">Okuhitsya obu arireeba ebi arikwetengyera abazigu be.<verse eid="PSA 112:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 75:10">Zab 75:10</ref>; <ref loc="ROM 12:13">Rom 12:13</ref>; <ref loc="2CO 9:9">2 Kor 9:9</ref>; <ref loc="1TI 6:18">1 Tim 6:18</ref>. </char>
    </note> Akagabisa obufura, yaagabira abooro;</para>
  <para style="q1" vid="PSA 112:9">Okuhikiirira kwe nikugumaho ebiro byona;</para>
  <para style="q1" vid="PSA 112:9">Eihembe rye riryatunguurwa n'ekitiinisa.<verse eid="PSA 112:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">112:10: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:13">Yob 8:13</ref>; <ref loc="MAT 8:12">Mat 8:12</ref>. </char>
    </note> Omubi aryakireeba, aguubwe kubi;</para>
  <para style="q1" vid="PSA 112:10">Aryanena enshaya, ahwereho kimwe;</para>
  <para style="q1" vid="PSA 112:10">Eki omubi ayetenga kiryabura.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" sid="PSA 113" />
  <para style="s1">Ruhanga ori ahaiguru oku atunguura abacureezi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:35">Zab 104:35</ref>; <ref loc="PSA 135:1">135:1</ref>. </char>
    </note> Haleluya! Imwe abairu ba MUKAMA, muhimbise,</para>
  <para style="q1" vid="PSA 113:1">Muhimbise eiziina rya MUKAMA!<verse eid="PSA 113:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:18">Zab 115:18</ref>; <ref loc="DAN 2:20">Dan 2:20</ref>; <ref loc="JOB 1:21">Yob 1:21</ref>. </char>
    </note> Eiziina rya MUKAMA risiimwe</para>
  <para style="q1" vid="PSA 113:2">Okwiha hati okuhitsya ebiro byona.<verse eid="PSA 113:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:10">Zab 48:10</ref>; <ref loc="PSA 50:1">50:1</ref>; <ref loc="MAL 1:11">Mal 1:11</ref>. </char>
    </note> Okuruga oburugwa-izooba okuhika oburengyerwa-izooba</para>
  <para style="q1" vid="PSA 113:3">Eiziina rya MUKAMA rishemereire kuhimbisibwa.<verse eid="PSA 113:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:1">Zab 8:1</ref>; <ref loc="PSA 99:2">99:2</ref>. </char>
    </note> MUKAMA ari ahaiguru munonga, naakira amahanga goona,</para>
  <para style="q1" vid="PSA 113:4">Ekitiinisa kye kyeshumba eiguru.<verse eid="PSA 113:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:5, 6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:1o">Zab 35:1o</ref>; <ref loc="PSA 138:6">138:6</ref>; <ref loc="ISA 57:15">Isa 57:15</ref>. </char>
    </note> N'oha orikushushana na MUKAMA Ruhanga waitu,</para>
  <para style="q1" vid="PSA 113:5">Ou ekitebe kye kiri ahaiguru,<verse eid="PSA 113:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6" />Akeecureeza kureeba ebiri omu iguru n'eby'omu nsi?<verse eid="PSA 113:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:7, 8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:41">Zab 107:41</ref>; <ref loc="JOB 36:7">Yob 36:7</ref>; <ref loc="1SA 2:8">1 Sam 2:8</ref>. </char>
    </note> Atunguura omworo naamwiha omu mucuucu,</para>
  <para style="q1" vid="PSA 113:7">Aimutsya enshoberwa naagiha omu rubungo,<verse eid="PSA 113:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8" />Ngu abashutamye n'abanyiginya,</para>
  <para style="q1" vid="PSA 113:8">Abanyiginya b'abantu be.<verse eid="PSA 113:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">113:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:6">Zab 68:6</ref>; <ref loc="1SA 2:5">1 Sam 2:5</ref>. </char>
    </note> Omukazi engumba amugumya omu nju,</para>
  <para style="q1" vid="PSA 113:9">Amuha okuzaara abaana n'okushemererwa.</para>
  <para style="q1" vid="PSA 113:9">Haleluya!<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" sid="PSA 114" />
  <para style="s1">Oku Ruhanga yaihire Abaisraeli omuri Misri</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 81:5">Zab 81:5</ref>; <ref loc="EXO 12:37">Kur 12:37</ref>, <ref loc="EXO 12:41">41</ref>. </char>
    </note> Israeli obu yaaruga Misri,</para>
  <para style="q1" vid="PSA 114:1">Enju ya Yakobo obu yaaruga omu bantu b'orurimi orundi,<verse eid="PSA 114:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:68">Zab 78:68</ref>, <ref loc="PSA 78:69">69</ref>; <ref loc="EXO 19:5">Kur 19:5</ref>, <ref loc="EXO 19:6">6</ref>. </char>
    </note> Yuda akahinduka Omwanya gwe ogurikwera,</para>
  <para style="q1" vid="PSA 114:2">Israeli yaahinduka obukama bwe.<verse eid="PSA 114:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:21">Kur 14:21</ref>; <ref loc="JOS 3:13-16">Yos 3:13-16</ref>. </char>
    </note> Enyanja ku yaakireebire, yaahunga,</para>
  <para style="q1" vid="PSA 114:3">Yorudani yaagaruka enyima.<verse eid="PSA 114:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:7">Zab 18:7</ref>; <ref loc="PSA 29:6">29:6</ref>. </char>
    </note> Ebibungo bikateera kyamubambaigwa nk'empaya z'entaama,</para>
  <para style="q1" vid="PSA 114:4">N'otubungo nk'abaana baazo.<verse eid="PSA 114:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:5: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:8">Hab 3:8</ref>. </char>
    </note> Iwe nyanja 'we, noohungira ki?</para>
  <para style="q1" vid="PSA 114:5">Naiwe Yorudani, n'enki ekirikukugarura enyima?<verse eid="PSA 114:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6" />Naimwe ebibungo, okuguruka nk'empaya z'entaama,</para>
  <para style="q1" vid="PSA 114:6">N'otubungo nk'abaagazi baazo?<verse eid="PSA 114:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 96:9">Zab 96:9</ref>. </char>
    </note> Iwe nsi 'we, tetema omu maisho ga MUKAMA,</para>
  <para style="q1" vid="PSA 114:7">Omu maisho ga Ruhanga wa Yakobo,<verse eid="PSA 114:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">114:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:35">Zab 107:35</ref>; <ref loc="DEU 8:15">Bir 8:15</ref>; <ref loc="NUM 20:11">Kub 20:11</ref>; <ref loc="EXO 17:6">Kur 17:6</ref>. </char>
    </note> Owaahindwire orukiri ekiyanja ky'amaizi,</para>
  <para style="q1" vid="PSA 114:8">N'amabaare agagumire akagafumuramu enshuro.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" sid="PSA 115" />
  <para style="s1">Oku okuramya ebishushani okukira okwesiga Mukama buri obushema</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 48:11">Isa 48:11</ref>; <ref loc="EZK 36:22">Ezk 36:22</ref>. </char>
    </note> Tiitwe tushemereire kuheebwa ekitiinisa, ai MUKAMA,</para>
  <para style="q1" vid="PSA 115:1">Tiitwe, kureka eiziina ryawe,</para>
  <para style="q1" vid="PSA 115:1">Ahabw'embabazi zaawe n'amazima gaawe.<verse eid="PSA 115:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:3">Zab 42:3</ref>, <ref loc="PSA 42:10">10</ref>; <ref loc="PSA 79:10">79:10</ref>; <ref loc="JOL 2:17">Yoel 2:17</ref>. </char>
    </note> Ab'amahanga nibabuuriza ki bati:</para>
  <para style="q1" vid="PSA 115:2">Ruhanga waabo arahi?<verse eid="PSA 115:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:6">Zab 135:6</ref>; <ref loc="DAN 4:35">Dan 4:35</ref>. </char>
    </note> Kwonka Ruhanga waitu ari omu iguru,</para>
  <para style="q1" vid="PSA 115:3">Akora eki arikwenda kyona.<verse eid="PSA 115:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:4-8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:15-18">Zab 135:15-18</ref>. </char>
    </note> Ebishushani ebi barikuramya n'efeeza n'ezaabu,</para>
  <para style="q1" vid="PSA 115:4">Ebikozirwe emikono y'abantu.<note caller="-" style="x"><char style="xo" closed="false">115:4: </char><char style="xt" closed="false"><ref loc="JER 10:3-5">Yer 10:3-5</ref>; <ref loc="ISA 37:19">Isa 37:19</ref>; <ref loc="DEU 4:28">Bir 4:28</ref>. </char></note><verse eid="PSA 115:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:5, 6: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 2:18">Hab 2:18</ref>; <ref loc="REV 9:20">Kush 9:20</ref>. </char>
    </note> Bigira eminwa, kwonka tibigamba;</para>
  <para style="q1" vid="PSA 115:5">Bigira amaisho, tibireeba;<verse eid="PSA 115:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6" />Bigira amatu, tibihurira;</para>
  <para style="q1" vid="PSA 115:6">Bigira enyindo, tibikaga;<verse eid="PSA 115:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 46:7">Isa 46:7</ref>. </char>
    </note> Bigira engaro, tibikwata;</para>
  <para style="q1" vid="PSA 115:7">Bigira ebigyere, tibigyenda;</para>
  <para style="q1" vid="PSA 115:7">Kandi tibigambisa mimiro yaabyo.<verse eid="PSA 115:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:8: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:9">Isa 44:9</ref>; <ref loc="JON 2:8">Yon 2:8</ref>. </char>
    </note> Ababikora babishusha;</para>
  <para style="q1" vid="PSA 115:8">Kandi n'omuntu weena orikubyesiga nikwo aba.<verse eid="PSA 115:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:9-11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:20">Zab 33:20</ref>; <ref loc="PSA 62:8">62:8</ref>; <ref loc="PSA 118:2-4">118:2-4</ref>; <ref loc="PSA 135:19">135:19</ref>, <ref loc="PSA 135:20">20</ref>. </char>
    </note> Iwe Israeli, yesigye MUKAMA!</para>
  <para style="q1" vid="PSA 115:9">Niwe Muhwezi waabo, kandi Engabo yaabo.<verse eid="PSA 115:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10" />Imwe ab'enju ya Arooni, mwesigye MUKAMA!</para>
  <para style="q1" vid="PSA 115:10">Niwe Muhwezi waabo kandi Engabo yaabo.<verse eid="PSA 115:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11" />Imwe abatiina MUKAMA, mumwesigye!</para>
  <para style="q1" vid="PSA 115:11">Niwe Muhwezi waabo kandi Engabo yaabo.<verse eid="PSA 115:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12" />MUKAMA atwijukire, aryatuha omugisha;</para>
  <para style="q1" vid="PSA 115:12">Aryaha enju ya Israeli omugisha,</para>
  <para style="q" vid="PSA 115:12">Aryaha enju ya Arooni omugisha;<verse eid="PSA 115:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:1">Zab 112:1</ref>; <ref loc="REV 19:5">Kush 19:5</ref>. </char>
    </note> Aryaha omugisha boona abatiina MUKAMA,</para>
  <para style="q1" vid="PSA 115:13">Abato n'abakuru.<verse eid="PSA 115:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 1:11">Bir 1:11</ref>. </char>
    </note> MUKAMA abakanyise, imwe n'abaana baanyu!<verse eid="PSA 115:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 134:3">Zab 134:3</ref>. </char>
    </note> MUKAMA owaahangire eiguru n'ensi abahe omugisha!<verse eid="PSA 115:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16" />Eiguru n'erya MUKAMA,</para>
  <para style="q1" vid="PSA 115:16">Kwonka ensi akagiha abantu.<verse eid="PSA 115:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:5">Zab 6:5</ref>. </char>
    </note> Abafu tibahimbisa MUKAMA,</para>
  <para style="q1" vid="PSA 115:17">N'obu baakuba abashuuma ahataine kateezo,<verse eid="PSA 115:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">115:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:2">Zab 145:2</ref>; <ref loc="DAN 2:20">Dan 2:20</ref>. </char>
    </note> Kwonka itwe turyahimbisa MUKAMA</para>
  <para style="q1" vid="PSA 115:18">Okwiha hati n'okuhitsya ebiro byona. Haleluya!<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" sid="PSA 116" />
  <para style="s1">Okusiima Mukama ahabw'okugarukira aha ncwamba za rufu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 116:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:1">Zab 18:1</ref>; <ref loc="PSA 66:19">66:19</ref>. </char>
    </note> Ninkunda MUKAMA, ahakuba ahuriire</para>
  <para style="q1" vid="PSA 116:1">Eiraka ryangye n'okweshengyereza kwangye.<verse eid="PSA 116:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2" />Ndyaguma nimmutakira nkiriho,</para>
  <para style="q1" vid="PSA 116:2">Ahabw'okuba antegire okutu.<verse eid="PSA 116:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:4">Zab 18:4</ref>, <ref loc="PSA 18:5">5</ref>. </char>
    </note> Emitego ya rufu ekanzingazinga,</para>
  <para style="q1" vid="PSA 116:3">N'obuhuruzi bw'okuzimu bwankwata;</para>
  <para style="q1" vid="PSA 116:3">Naareeba enaku n'obusaasi.<verse eid="PSA 116:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Zab 18:6</ref>; <ref loc="PSA 118:5">118:5</ref>. </char>
    </note> Ahonaaho naatakira eiziina rya MUKAMA,</para>
  <para style="q1" vid="PSA 116:4">Nti: Ai MUKAMA, ninkweshengyereza, juna amagara gangye!<verse eid="PSA 116:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 86:15">86:15</ref>; <ref loc="NEH 9:8">Neh 9:8</ref>; <ref loc="EZR 9:15">Ezr 9:15</ref>; <ref loc="JER 12:1">Yer 12:1</ref>; <ref loc="REV 16:5">Kush 16:5</ref>. </char>
    </note> MUKAMA n'ow'embabazi kandi ohikiriire;</para>
  <para style="q1" vid="PSA 116:5">Buzimazima, Ruhanga waitu n'Omunyasaasi.<verse eid="PSA 116:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 142:6">Zab 142:6</ref>. </char>
    </note> MUKAMA arinda aboorobi;</para>
  <para style="q1" vid="PSA 116:6">Ku naagarwirwe ahansi, yanjuna.<verse eid="PSA 116:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:6">Zab 13:6</ref>; <ref loc="JER 6:16">Yer 6:16</ref>; <ref loc="MAT 11:29">Mat 11:29</ref>. </char>
    </note> Magara gangye, garuka omu buruhuukiro bwawe;</para>
  <para style="q1" vid="PSA 116:7">Ahakuba MUKAMA akugiriire embabazi nyingi.<verse eid="PSA 116:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:8, 9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:13">Zab 56:13</ref>. </char>
    </note> Ahabw'okuba okakiza amagara gangye okufa, n'amaisho gangye okurira,</para>
  <para style="q1" vid="PSA 116:8">Kandi waazibira ebigyere byangye kuterera.<verse eid="PSA 116:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9" />Ndyaguma ngyendere omu maisho ga MUKAMA</para>
  <para style="q1" vid="PSA 116:9">Omu nsi y'abahuriire.<verse eid="PSA 116:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:10: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:13">2 Kor 4:13</ref>. </char>
    </note> Nkagumira omu kwikiriza kwangye,</para>
  <para style="q1" vid="PSA 116:10">N'obu ndaabe naagizire nti: Nimbonabonesibwa munonga;<verse eid="PSA 116:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:22">Zab 31:22</ref>; <ref loc="PSA 62:9">62:9</ref>; <ref loc="JER 9:5">Yer 9:5</ref>; <ref loc="ROM 3:4">Rom 3:4</ref>. </char>
    </note> Nkarahukiriza kugira nti:</para>
  <para style="q1" vid="PSA 116:11">Abantu boona n'abanyabishuba.<verse eid="PSA 116:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12" />N'enki eki ndizimuurira MUKAMA</para>
  <para style="q1" vid="PSA 116:12">Ahabw'ebirungi bye byona ebi yankoreire?<verse eid="PSA 116:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:5">Zab 16:5</ref>; <ref loc="PSA 105:1">105:1</ref>. </char>
    </note> Ndyayakiira ekikopo ky'okujunwa,</para>
  <para style="q1" vid="PSA 116:13">Ntakire eiziina rya MUKAMA.<verse eid="PSA 116:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:14">Zab 50:14</ref>; <ref loc="JON 2:9">Yon 2:9</ref>. </char>
    </note> Ndyahikiiriza ebi naahigire ahari MUKAMA,</para>
  <para style="q1" vid="PSA 116:14">Ndi omu maisho g'abantu be boona.<verse eid="PSA 116:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:14">Zab 72:14</ref>. </char>
    </note> Okufa kw'abarikwera ba MUKAMA</para>
  <para style="q1" vid="PSA 116:15">N'okw'obuguzi bwingi omu maisho ge.<verse eid="PSA 116:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">116:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:16">Zab 86:16</ref>; <ref loc="PSA 119:125">119:125</ref>. </char>
    </note> Ai MUKAMA, ndi omwiru waawe,</para>
  <para style="q1" vid="PSA 116:16">Ndi omwiru waawe, omwana w'omuzaana waawe.</para>
  <para style="q1" vid="PSA 116:16">Okomoroire ebibaire binkomire.<verse eid="PSA 116:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17" />Ndyakuhongyera ekitambo ky'okusiima,</para>
  <para style="q1" vid="PSA 116:17">Ntakire eiziina rya MUKAMA.<verse eid="PSA 116:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18" />Ndyahikiiriza ebi naahigire ahari MUKAMA</para>
  <para style="q1" vid="PSA 116:18">Omu maisho g'abantu be boona,<verse eid="PSA 116:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19" />Omu bikaari by'enju ya MUKAMA</para>
  <para style="q1" vid="PSA 116:19">Ahagati yaawe, iwe Yerusaalemu. Haleluya!<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="s1">Okuhimbisa Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">117:1: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:11">Rom 15:11</ref>. </char>
    </note> Muhimbise MUKAMA, imwe amahanga goona!</para>
  <para style="q1" vid="PSA 117:1">Imwe abantu boona, muhe MUKAMA ekitiinisa;<verse eid="PSA 117:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">117:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:11">Zab 103:11</ref>. </char>
    </note> Ahakuba embabazi ze ahariitwe ni nyingi,</para>
  <para style="q1" vid="PSA 117:2">Kandi obwesigwa bwa MUKAMA n'obw'ebiro byona.</para>
  <para style="q1" vid="PSA 117:2">Haleluya!<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" sid="PSA 118" />
  <para style="s1">Oku embabazi za Mukama zigumaho ebiro byona</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 118:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:5">Zab 100:5</ref>; <ref loc="1CH 16:34">1 Bus 16:34</ref>; <ref loc="JER 33:11">Yer 33:11</ref>. </char>
    </note> Nimusiime MUKAMA, ahabw'okuba ni murungi;</para>
  <para style="q1" vid="PSA 118:1">Kandi embabazi ze n'ez'ebiro byona.<verse eid="PSA 118:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:2-4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:9-11">Zab 115:9-11</ref>. </char>
    </note> Israeli agire ati:</para>
  <para style="q1" vid="PSA 118:2">Embabazi ze n'ez'ebiro byona.<verse eid="PSA 118:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3" />Ab'enju ya Arooni bagire bati:</para>
  <para style="q1" vid="PSA 118:3">Embabazi ze n'ez'ebiro byona.<verse eid="PSA 118:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4" />Abatiina MUKAMA bagire bati:</para>
  <para style="q1" vid="PSA 118:4">Embabazi ze n'ez'ebiro byona.<verse eid="PSA 118:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:6">Zab 18:6</ref>, <ref loc="PSA 18:19">19</ref>. </char>
    </note> Ku naabaire ndi omu busaasi, nkatakira MUKAMA,</para>
  <para style="q1" vid="PSA 118:5">MUKAMA yangarukamu, yanta omu mwanya gugarami.<verse eid="PSA 118:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:9">Zab 56:9</ref>, <ref loc="PSA 56:11">11</ref>; <ref loc="ROM 8:31">Rom 8:31</ref>; <ref loc="HEB 13:6">Heb 13:6</ref>. </char>
    </note> MUKAMA ari aha rubaju rwangye, tinditiina;</para>
  <para style="q1" vid="PSA 118:6">Omuntu naabaasa kungira ata?<verse eid="PSA 118:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:4">Zab 54:4</ref>, <ref loc="PSA 54:7">7</ref>. </char>
    </note> MUKAMA ari aha rubaju rwangye kumpwera;</para>
  <para style="q1" vid="PSA 118:7">N'ahabw'ekyo ndyareeba eki ndikwetengyera abarikuunyanga.<verse eid="PSA 118:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:4">Zab 40:4</ref>; <ref loc="JER 17:5">Yer 17:5</ref>, <ref loc="JER 17:7">7</ref>. </char>
    </note> Ni kirungi okwesiga MUKAMA</para>
  <para style="q1" vid="PSA 118:8">Okukira okwesiga abantu;<verse eid="PSA 118:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 146:3">Zab 146:3</ref>; <ref loc="ISA 30:1-3">Isa 30:1-3</ref>. </char>
    </note> Ni kirungi okwesiga MUKAMA</para>
  <para style="q1" vid="PSA 118:9">Okukira okwesiga abategyeki.<verse eid="PSA 118:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:10, 11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:17">Zab 88:17</ref>. </char>
    </note> Amahanga goona gantangatangire;</para>
  <para style="q1" vid="PSA 118:10">Omu iziina rya MUKAMA ndyagahwerekyereza.<verse eid="PSA 118:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11" />Gantangatangire; buzima gantangatangire;</para>
  <para style="q1" vid="PSA 118:11">Omu iziina rya MUKAMA ndyagahwerekyereza.<verse eid="PSA 118:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 58:9">Zab 58:9</ref>; <ref loc="DEU 1:44">Bir 1:44</ref>. </char>
    </note> Bampumbatsi nk'enjoki,</para>
  <para style="q1" vid="PSA 118:12">Nibabuguma nk'omuriro gw'amahwa;</para>
  <para style="q1" vid="PSA 118:12">Omu iziina rya MUKAMA ndyabahwerekyereza.<verse eid="PSA 118:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13" />Baanyohire kungwisa;</para>
  <para style="q1" vid="PSA 118:13">Kwonka MUKAMA yampwera.<verse eid="PSA 118:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:14: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:2">Kur 15:2</ref>; <ref loc="ISA 12:2">Isa 12:2</ref>. </char>
    </note> MUKAMA niwe maani gangye n'ekyeshongoro kyangye;</para>
  <para style="q1" vid="PSA 118:14">Kandi ahindukire okujunwa kwangye.<verse eid="PSA 118:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:15, 16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:6">Kur 15:6</ref>; <ref loc="LUK 1:51">Luk 1:51</ref>. </char>
    </note> Eiraka ry'okushemererwa ahabw'okujunwa</para>
  <para style="q1" vid="PSA 118:15">Nirihurirwa omu mahema g'abahikiriire;</para>
  <para style="q1" vid="PSA 118:15">Omukono gwa buryo gwa MUKAMA gukora eby'obumanzi.<verse eid="PSA 118:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16" />Omukono gwa buryo gwa MUKAMA gubangirwe;</para>
  <para style="q1" vid="PSA 118:16">Omukono gwa buryo gwa MUKAMA gukora eby'obumanzi.<verse eid="PSA 118:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:5">Zab 6:5</ref>; <ref loc="PSA 73:28">73:28</ref>; <ref loc="PSA 107:22">107:22</ref>. </char>
    </note> Tindifa, kureka ndyagumaho,</para>
  <para style="q1" vid="PSA 118:17">Mmanyise abantu ebi MUKAMA yaakozire.<verse eid="PSA 118:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:18: </char>
      <char style="xt" closed="false">
        <ref loc="JER 30:11">Yer 30:11</ref>; <ref loc="2CO 6:9">2 Kor 6:9</ref>. </char>
    </note> MUKAMA akampana munonga;</para>
  <para style="q1" vid="PSA 118:18">Kwonka tarampaireyo hari rufu.<verse eid="PSA 118:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:2">Isa 26:2</ref>. </char>
    </note> Muunyigurire amarembo g'okuhikiirira,</para>
  <para style="q1" vid="PSA 118:19">Ntaahemu, nsiime MUKAMA.<verse eid="PSA 118:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:7">Zab 24:7</ref>; <ref loc="REV 21:27">Kush 21:27</ref>; <ref loc="REV 22:14">22:14</ref>. </char>
    </note> Eri niryo irembo rya MUKAMA;</para>
  <para style="q1" vid="PSA 118:20">Abahikiriire nibo baririrabamu.<verse eid="PSA 118:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:1">Zab 27:1</ref>; <ref loc="PSA 116:1">116:1</ref>. </char>
    </note> Ninkusiima, ahabw'okuba ongarukiremu,</para>
  <para style="q1" vid="PSA 118:21">Waahinduka okujunwa kwangye.<verse eid="PSA 118:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:22, 23: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 28:16">Isa 28:16</ref>; <ref loc="MRK 12:10">Mak 12:10</ref>, <ref loc="MRK 12:11">11</ref>; <ref loc="ACT 4:11">Byak 4:11</ref>; <ref loc="EPH 2:20">Efe 2:20</ref>; <ref loc="1PE 2:4">1 Pet 2:4</ref>, <ref loc="1PE 2:7">7</ref>. </char>
    </note> Eibaare eri abombeki baayangire,</para>
  <para style="q1" vid="PSA 118:22">Niryo ryahindukire erikuru ery'obuhamizo bw'enju,<verse eid="PSA 118:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23" />Ekyo kikaruga ahari MUKAMA,</para>
  <para style="q1" vid="PSA 118:23">Kandi n'eky'okutangaaza omu maisho gaitu.<verse eid="PSA 118:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24" />Eri niryo izooba eri MUKAMA yaataireho;</para>
  <para style="q1" vid="PSA 118:24">Ka turishemerererwe, turyesiimireho.<verse eid="PSA 118:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:25, 26: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:39">Mat 23:39</ref>; <ref loc="MRK 11:9">Mak 11:9</ref>; <ref loc="JHN 12:13">Yoh 12:13</ref>. </char>
    </note> Ai MUKAMA, nitukweshengyereza, otujune;</para>
  <para style="q1" vid="PSA 118:25">Ai MUKAMA, nitukweshengyereza, otuhe okuhitsya gye ebi turikukora.<verse eid="PSA 118:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26" />Orikwija omu iziina rya MUKAMA aine omugisha;</para>
  <para style="q1" vid="PSA 118:26">Twabashabira omugisha turi omu nju ya MUKAMA.<verse eid="PSA 118:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:27: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:11">Zab 97:11</ref>; <ref loc="EXO 27:2">Kur 27:2</ref>. </char>
    </note> MUKAMA niwe Ruhanga, kandi atujwisiza omushana.</para>
  <para style="q1" vid="PSA 118:27">Mubohese ekitambo emigoye, mukitware aha mahembe g'eitambiro.<verse eid="PSA 118:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 99:5">Zab 99:5</ref>; <ref loc="EXO 15:2">Kur 15:2</ref>; <ref loc="ISA 25:1">Isa 25:1</ref>. </char>
    </note> Niiwe Ruhanga wangye, ninkusiima;</para>
  <para style="q1" vid="PSA 118:28">Niiwe Ruhanga wangye, ninkuha ekitiinisa.<verse eid="PSA 118:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">118:29: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:1">Zab 118:1</ref>. </char>
    </note> Musiime MUKAMA, ahabw'okuba ni murungi;</para>
  <para style="q1" vid="PSA 118:29">Kandi embabazi ze n'ez'ebiro n'ebiro.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" sid="PSA 119" />
  <para style="s1">Okuteekateeka munonga aha Biragiro bya Ruhanga</para>
  <para style="s2">Alefu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 119:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 128:1">Zab 128:1</ref>; <ref loc="GEN 17:1">Kut 17:1</ref>. </char>
    </note> Baine omugisha abu emitwarize yaabo ehikire,</para>
  <para style="q1" vid="PSA 119:1">Abagyendera omu kutegyekwa ebiragiro bya MUKAMA.<verse eid="PSA 119:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:29">Bir 4:29</ref>; <ref loc="2CH 15:2">2 Bus 15:2</ref>. </char>
    </note> Baine omugisha abarinda ebi yaahamize,</para>
  <para style="q1" vid="PSA 119:2">Abamusherura n'omutima gwabo gwona,<verse eid="PSA 119:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3" />Kandi abatakora kibi kyona,</para>
  <para style="q1" vid="PSA 119:3">Kureka abagyendera omu mihanda ye.<verse eid="PSA 119:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4" />Okatuha ebiragiro byawe,</para>
  <para style="q1" vid="PSA 119:4">Ngu twezirikye kubyorobera.<verse eid="PSA 119:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5" />Nkaahenwa ki emitwarize yangye eba ehamire,</para>
  <para style="q1" vid="PSA 119:5">Mbona kworobera ebi waataireho!<verse eid="PSA 119:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:80">Zab 119:80</ref>; <ref loc="JOB 22:26">Yob 22:26</ref>. </char>
    </note> Ku ndita omutima aha biragiro byawe byona,</para>
  <para style="q1" vid="PSA 119:6">Tindikwatwa nshoni.<verse eid="PSA 119:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7" />Ndyakusiima n'omutima ogugororokire,</para>
  <para style="q1" vid="PSA 119:7">Ku ndiba naayegire emicwere yaawe ey'oburyo.<verse eid="PSA 119:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 38:21">Zab 38:21</ref>; <ref loc="PSA 71:9">71:9</ref>, <ref loc="PSA 71:18">18</ref>. </char>
    </note> Ndyaguma ndinde ebi waataireho;</para>
  <para style="q1" vid="PSA 119:8">Ai bambe, otantsigiraho kimwe.<verse eid="PSA 119:8" /></para>
  <para style="s2">Beth</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:9: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:4">Enf 1:4</ref>. </char>
    </note> Omutsigazi aryashemeza ata omuhanda gwe?</para>
  <para style="q1" vid="PSA 119:9">Aryagushemeza ahabw'okugurinda, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10" />Ninkusherura n'omutima gwangye gwona;</para>
  <para style="q1" vid="PSA 119:10">Otandeka kuruga omu biragiro byawe, nkahaba.<verse eid="PSA 119:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:31">Zab 37:31</ref>; <ref loc="LUK 2:19">Luk 2:19</ref>, <ref loc="LUK 2:51">51</ref>. </char>
    </note> Ekigambo kyawe nkibiikire omu mutima gwangye,</para>
  <para style="q1" vid="PSA 119:11">Ngu ndekye kukucumuraho.<verse eid="PSA 119:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12" />Ori ow'okusiimwa, ai MUKAMA;</para>
  <para style="q1" vid="PSA 119:12">Onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:9">Zab 40:9</ref>. </char>
    </note> Nkagambira abantu n'eminwa yangye</para>
  <para style="q1" vid="PSA 119:13">Emanja zoona ezi waacwire.<verse eid="PSA 119:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:14: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:13-15">Enf 3:13-15</ref>; <ref loc="PRO 8:10">8:10</ref>, <ref loc="PRO 8:11">11</ref>. </char>
    </note> Nyesiimira omuhanda gw'ebi waahamize,</para>
  <para style="q1" vid="PSA 119:14">Nk'oku nyesiimira okugira eitungo ryona.<verse eid="PSA 119:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15" />Ndyateekateeka munonga aha kuhabura kwawe,</para>
  <para style="q1" vid="PSA 119:15">Nte omutima gwangye aha mihanda yaawe.<verse eid="PSA 119:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16" />Ndyayesiimira ebiragiro ebi waataireho;</para>
  <para style="q1" vid="PSA 119:16">N'ekigambo kyawe tindikyebwa.<verse eid="PSA 119:16" /></para>
  <para style="s2">Gimel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:6">Zab 13:6</ref>. </char>
    </note> Ogirire omwiru waawe embabazi nyingi, mbone kuguma ndi ohuriire;</para>
  <para style="q1" vid="PSA 119:17">Haza ngume nyorobere ekigambo kyawe.<verse eid="PSA 119:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18" />Humuura amaisho gangye,</para>
  <para style="q1" vid="PSA 119:18">Mbone kureeba eby'okutangaaza eby'omu biragiro byawe.<verse eid="PSA 119:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:12">Zab 39:12</ref>. </char>
    </note> Omu nsi ndi empinguzi;</para>
  <para style="q1" vid="PSA 119:19">Otanshereka ebiragiro byawe.<verse eid="PSA 119:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:1">Zab 42:1</ref>, <ref loc="PSA 42:2">2</ref>. </char>
    </note> Omutima gwangye gucwekire ahabw'okwetenga</para>
  <para style="q1" vid="PSA 119:20">Ebi oragiira buri kaanya.<verse eid="PSA 119:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:21: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 27:26">Bir 27:26</ref>. </char>
    </note> Okahana ab'amaryo abakyeenirwe,</para>
  <para style="q1" vid="PSA 119:21">Abarikuhaba okuruga omu biragiro byawe.<verse eid="PSA 119:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22" />Onyiheho okujumwa n'okugaywa;</para>
  <para style="q1" vid="PSA 119:22">Ahabw'okuba ndinzire ebi waahamize.<verse eid="PSA 119:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23" />Abanyiginya n'obu baraabe baashutamire bakangiira omu naama,</para>
  <para style="q1" vid="PSA 119:23">Kwonka omwiru waawe naija kuguma naateekateeka aha biragiro ebi waataireho.<verse eid="PSA 119:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:24: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 7:22">Rom 7:22</ref>. </char>
    </note> Ebi waahamize nibyo nshemerererwa,</para>
  <para style="q1" vid="PSA 119:24">Kandi nibyo bimpa obwengye.<verse eid="PSA 119:24" /></para>
  <para style="s2">Daleth</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 44:25">Zab 44:25</ref>. </char>
    </note> Amagara gangye gakwataniire kimwe n'omucuucu;</para>
  <para style="q1" vid="PSA 119:25">Ompimbuure, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26" />Ku naakugambiire eby'emihanda yangye, wangarukamu;</para>
  <para style="q1" vid="PSA 119:26">Onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27" />Ommanyise omuhanda gw'ebi oyegyesa,</para>
  <para style="q1" vid="PSA 119:27">Mbone kuguma ninteekateeka aha by'okutangaaza ebi waakozire.<verse eid="PSA 119:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:28: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:14">Zab 22:14</ref>. </char>
    </note> Omutima gwangye niguyaga ahabw'obusaasi;</para>
  <para style="q1" vid="PSA 119:28">Ongaruremu amaani, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:29: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:8">Enf 30:8</ref>. </char>
    </note> Onyiheho emitwarize y'ebishuba;</para>
  <para style="q1" vid="PSA 119:29">Ahabw'embabazi zaawe onyegyese ebiragiro byawe.<verse eid="PSA 119:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30" />Nyihiremu omuhanda gw'obwesigwa;</para>
  <para style="q1" vid="PSA 119:30">Emicwere yaawe ngitaire omu maisho gangye.<verse eid="PSA 119:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31" />Mpamiire aha bi waahamize;</para>
  <para style="q1" vid="PSA 119:31">Ai MUKAMA, otankwatsa enshoni.<verse eid="PSA 119:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:32: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 4:29">1 Bag 4:29</ref>; <ref loc="ISA 60:5">Isa 60:5</ref>; <ref loc="2CO 6:11">2 Kor 6:11</ref>, <ref loc="2CO 6:13">13</ref>. </char>
    </note> <note caller="+" style="f"><char style="fr" closed="false">119:32 </char><char style="ft" closed="false">Nari, Ku oryongyera omutima gwangye okwetegyereza. </char></note>Ku oriha omutima gwangye obusingye.</para>
  <para style="q1" vid="PSA 119:32">Ndyaguma niinyiruka, ndi omu muhanda gw'ebiragiro byawe.<verse eid="PSA 119:32" /></para>
  <para style="s2">He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:33: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">Mat 10:22</ref>; <ref loc="HEB 3:6">Heb 3:6</ref>; <ref loc="REV 2:26">Kush 2:26</ref>. </char>
    </note> Ai MUKAMA, onyegyese omuhanda gw'ebiragiro ebi waataireho;</para>
  <para style="q1" vid="PSA 119:33">Ndyagugumamu okuhitsya aha muheru.<verse eid="PSA 119:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:34: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:6">Enf 2:6</ref>; <ref loc="JAS 1:5">Yak 1:5</ref>. </char>
    </note> Ompe okwetegyereza, mbone kworobera ebiragiro byawe,</para>
  <para style="q1" vid="PSA 119:34">N'okubikwata n'omutima gwangye gwona.<verse eid="PSA 119:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:35: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:4">Zab 25:4</ref>. </char>
    </note> Ongyendese omu muhanda gw'ebiragiro byawe;</para>
  <para style="q1" vid="PSA 119:35">Ahakuba nigwo nshemerererwamu.<verse eid="PSA 119:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:36: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 141:4">Zab 141:4</ref>; <ref loc="LUK 12:15">Luk 12:15</ref>; <ref loc="1TI 6:10">1 Tim 6:10</ref>; <ref loc="HEB 13:5">Heb 13:5</ref>. </char>
    </note> Okundise omutima gwangye ebi waahamize,</para>
  <para style="q1" vid="PSA 119:36">Gurekye kuhugira omu kwetenga.<verse eid="PSA 119:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:37: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 23:5">Enf 23:5</ref>. </char>
    </note> Ohindure amaisho gangye, garekye kureeba ebitaine mugasho;</para>
  <para style="q1" vid="PSA 119:37">Ompimbuure, ngyendere omu mihanda yaawe.<verse eid="PSA 119:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:38: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:25">2 Sam 7:25</ref>. </char>
    </note> Ohamize omwiru waawe ekigambo kyawe,</para>
  <para style="q1" vid="PSA 119:38">Ekyaraganisiibwe abarikukutiina.<verse eid="PSA 119:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39" />Ompinguzeho ekijumo eki ndikutiina;</para>
  <para style="q1" vid="PSA 119:39">Ahakuba emicwere yaawe ni mirungi.<verse eid="PSA 119:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40" />Reeba, ntuura niinyetenga ebi oyegyesa;</para>
  <para style="q1" vid="PSA 119:40">Omu kuhikiirira kwawe ompe amagara.<verse eid="PSA 119:40" /></para>
  <para style="s2">Vau</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:4">Zab 106:4</ref>. </char>
    </note> Embabazi zaawe zimpikyeho, ai MUKAMA,</para>
  <para style="q1" vid="PSA 119:41">Nikwo kujuna kwawe, nk'ekigambo kyawe oku kiri;<verse eid="PSA 119:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:42: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 27:11">Enf 27:11</ref>. </char>
    </note> Mbone kugira eky'okugarukamu orikunjuma;</para>
  <para style="q1" vid="PSA 119:42">Ahakuba nyesiga ekigambo kyawe.<verse eid="PSA 119:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43" />Kandi ekigambo ky'amazima otakiihira kimwe omu kanwa kangye;</para>
  <para style="q1" vid="PSA 119:43">Ahakuba nyine amatsiko aha micwere yaawe;<verse eid="PSA 119:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44" />Nahabw'ekyo ndyaguma nyorobere ebiragiro byawe</para>
  <para style="q1" vid="PSA 119:44">Ebiro n'ebiro.<verse eid="PSA 119:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:45: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 4:12">Enf 4:12</ref>; <ref loc="JHN 8:32">Yoh 8:32</ref>. </char>
    </note> Kandi ndyaguma ngyende n'obusingye;</para>
  <para style="q1" vid="PSA 119:45">Ahakuba nsherwire ebi oyegyesa.<verse eid="PSA 119:45" /></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:46: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:18">Mat 10:18</ref>; <ref loc="ACT 26:1">Byak 26:1</ref>, <ref loc="ACT 26:2">2</ref>. </char>
    </note> Ndyagambira omu maisho g'abagabe ebi waahamize,</para>
  <para style="q1" vid="PSA 119:46">Kandi tindikwatwa nshoni.<verse eid="PSA 119:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47" />Ndyashemerererwa ebiragiro byawe,</para>
  <para style="q1" vid="PSA 119:47">Ebi naakunzire.<verse eid="PSA 119:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:48: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:2">Zab 28:2</ref>. </char>
    </note> Ndyaha ekitiinisa ebiragiro byawe, ebi naakunzire;</para>
  <para style="q1" vid="PSA 119:48">Kandi ndyaguma ninteekateeka aha biragiro ebi waataireho.<verse eid="PSA 119:48" /></para>
  <para style="s2">Zain</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49" />Ijuka ekigambo eki waagambiire omwiru waawe,</para>
  <para style="q1" vid="PSA 119:49">Eki wangiriizemu amatsiko.<verse eid="PSA 119:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:50: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:4">Rom 15:4</ref>. </char>
    </note> Ekyo nikyo kimpuumuza omutima omu kubonabona kwangye;</para>
  <para style="q1" vid="PSA 119:50">Ahakuba ekigambo kyawe kingarwiremu amagara.<verse eid="PSA 119:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:51: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 123:4">Zab 123:4</ref>; <ref loc="JOB 23:11">Yob 23:11</ref>; <ref loc="JER 20:7">Yer 20:7</ref>. </char>
    </note> Ab'amaryo bakanshekyerera munonga;</para>
  <para style="q1" vid="PSA 119:51">Kwonka tinaateishuka kureka ebiragiro byawe.<verse eid="PSA 119:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52" />Ku nyijuka emicwere yaawe eya ira, ai MUKAMA,</para>
  <para style="q1" vid="PSA 119:52">Ngarukwa omutima omunda.<verse eid="PSA 119:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:53: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 13:25">Neh 13:25</ref>. </char>
    </note> Ngira ekiniga kingi,</para>
  <para style="q1" vid="PSA 119:53">Ahabw'ababi abarikureka ebiragiro byawe.<verse eid="PSA 119:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54" />Ebiragiro ebi waataireho bimbeereire ebyeshongoro</para>
  <para style="q1" vid="PSA 119:54">Omu nju ei ncumbikiremu<verse eid="PSA 119:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:55: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:8">Zab 42:8</ref>; <ref loc="PSA 63:6">63:6</ref>. </char>
    </note> Ai MUKAMA, ntuura niinyijuka eiziina ryawe nyekiro,</para>
  <para style="q1" vid="PSA 119:55">Kandi nyorobera ebiragiro byawe.<verse eid="PSA 119:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56" />Omugisha ogu nkagutunga</para>
  <para style="q1" vid="PSA 119:56">Ahabw'okworobera ebi oyegyesa.<verse eid="PSA 119:56" /></para>
  <para style="s2">Cheth</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:57: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:5">Zab 16:5</ref>; <ref loc="JER 10:16">Yer 10:16</ref>; <ref loc="LAM 3:24">Tonz 3:24</ref>. </char>
    </note> Mukama niwe mugabo gwangye;</para>
  <para style="q1" vid="PSA 119:57">Nkagira nti: Ndyayorobera ebigambo byawe.<verse eid="PSA 119:57" /></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58" />Ninkweshengyereza n'omutima gwangye gwona, ongirire embabazi;</para>
  <para style="q1" vid="PSA 119:58">Onsaasire, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:59: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 3:40">Tonz 3:40</ref>; <ref loc="LUK 15:17">Luk 15:17</ref>. </char>
    </note> Ku naateekateekire aha mihanda yangye,</para>
  <para style="q1" vid="PSA 119:59">Naahindura ebigyere byangye kukuratira ebi waahamize;<verse eid="PSA 119:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60" />Naarahuka kworobera ebiragiro byawe,</para>
  <para style="q1" vid="PSA 119:60">Tinaayeziringa.<verse eid="PSA 119:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61" />Emigoye y'ababi n'obu eraabe yanzingazingire,</para>
  <para style="q1" vid="PSA 119:61">Kwonka tinkeebwaga biragiro byawe.<verse eid="PSA 119:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:62: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:25">Byak 16:25</ref>. </char>
    </note> Obutoosha nyimuka omu itumbi kukusiima</para>
  <para style="q1" vid="PSA 119:62">Ahabw'emicwere yaawe ey'oburyo.<verse eid="PSA 119:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:63: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 101:6">Zab 101:6</ref>. </char>
    </note> Ndi mugyenzi wa boona abakutiina,</para>
  <para style="q1" vid="PSA 119:63">Kandi n'abakwata ebi oyegyesa.<verse eid="PSA 119:63" /></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:64: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:5">Zab 33:5</ref>. </char>
    </note> Ai MUKAMA, ensi eijwire okusaasira kwawe;</para>
  <para style="q1" vid="PSA 119:64">Onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:64" /></para>
  <para style="s2">Teth</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65" />Otwarize gye omwiru waawe,</para>
  <para style="q1" vid="PSA 119:65">Ai MUKAMA, nk'oku ekigambo kyawe kiri.<verse eid="PSA 119:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:66: </char>
      <char style="xt" closed="false">
        <ref loc="PHP 1:9">Fil 1:9</ref>. </char>
    </note> Onyegyese okucwamu ekihikire, kandi n'okumanya;</para>
  <para style="q1" vid="PSA 119:66">Ahakuba nyikiriize ebiragiro byawe.<verse eid="PSA 119:66" /></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:67: </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:18">Yer 31:18</ref>, <ref loc="JER 31:19">19</ref>; <ref loc="HOS 5:15">Hos 5:15</ref>; <ref loc="HEB 12:11">Heb 12:11</ref>; <ref loc="REV 3:19">Kush 3:19</ref>. </char>
    </note> Obu naabaire ntakabonabonesiibwe, nkahaba;</para>
  <para style="q1" vid="PSA 119:67">Kwonka hati niinyorobera ekigambo kyawe.<verse eid="PSA 119:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:68: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:1">Zab 107:1</ref>. </char>
    </note> Ori murungi, kandi okora ebirungi;</para>
  <para style="q1" vid="PSA 119:68">Onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:69: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:2">Zab 109:2</ref>; <ref loc="JOB 13:4">Yob 13:4</ref>. </char>
    </note> Ab'amaryo bancwereire ekishuba;</para>
  <para style="q1" vid="PSA 119:69">Kwonka ndyakwata ebi oyegyesa n'omutima gwangye gwona.<verse eid="PSA 119:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:70: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:10">Zab 17:10</ref>; <ref loc="ISA 6:10">Isa 6:10</ref>; <ref loc="ACT 28:27">Byak 28:27</ref>. </char>
    </note> Omutima gwabo gugomokire n'ekirite;</para>
  <para style="q1" vid="PSA 119:70">Kwonka nyowe nyesiimira ebiragiro byawe.<verse eid="PSA 119:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:71: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:10">Heb 12:10</ref>. </char>
    </note> Kikangasira okubonabonesibwa,</para>
  <para style="q1" vid="PSA 119:71">Ngu mbone kwega ebiragiro ebi waataireho.<verse eid="PSA 119:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:72: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:10">Zab 19:10</ref>; <ref loc="PRO 8:10">Enf 8:10</ref>. </char>
    </note> Ebiragiro by'omu kanwa kangye nibimpitira</para>
  <para style="q1" vid="PSA 119:72">Ebicweka rukumi eby'ezaabu n'efeeza.<verse eid="PSA 119:72" /></para>
  <para style="s2">Yodi</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:73: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:3">Zab 100:3</ref>; <ref loc="JOB 10:8">Yob 10:8</ref>. </char>
    </note> Engaro zaawe nizo zampangire, kandi nizo zambumbire;</para>
  <para style="q1" vid="PSA 119:73">Ompe okwetegyereza, mbone kwega ebiragiro byawe.<verse eid="PSA 119:73" /></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:74: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:2">Zab 34:2</ref>; <ref loc="PSA 130:5">130:5</ref>. </char>
    </note> Abarikukutiina baryandeeba, bashemererwe;</para>
  <para style="q1" vid="PSA 119:74">Ahabw'okuba ntuura nyine amatsiko aha kigambo kyawe.<verse eid="PSA 119:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:75: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:4">Zab 33:4</ref>. </char>
    </note> Ai MUKAMA, nimmanya ngu emicwere yaawe n'ey'oburyo,</para>
  <para style="q1" vid="PSA 119:75">Kandi ngu okambonabonesa omu bwesigwa.<verse eid="PSA 119:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76" />Ninkweshengyereza embabazi zaawe ezitahinduka zibe ez'okumpuumuza omutima,</para>
  <para style="q1" vid="PSA 119:76">Nk'ekigambo eki waagambiire omwiru waawe oku kiri.<verse eid="PSA 119:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77" />Embabazi zaawe zimpikyeho, mbone kuguma ndi ohuriire;</para>
  <para style="q1" vid="PSA 119:77">Ahakuba ebiragiro byawe nibyo nshemerererwa.<verse eid="PSA 119:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:78: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:3">Zab 25:3</ref>. </char>
    </note> Ab'amaryo bakwatwe enshoni, ahabw'okunteerera ahansi busha,</para>
  <para style="q1" vid="PSA 119:78">Kwonka nyowe ndyaguma nteekateekye aha kuhabura kwawe.<verse eid="PSA 119:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:79: </char>
      <char style="xt" closed="false">
        <ref loc="JER 15:19">Yer 15:19</ref>. </char>
    </note> Abarikukutiina bampindukire,</para>
  <para style="q1" vid="PSA 119:79">Babone kumanya ebi waahamize.<verse eid="PSA 119:79" /></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80" />Omutima gwangye gube oguhikire omu biragiro ebi waataireho,</para>
  <para style="q1" vid="PSA 119:80">Ndekye kukwatwa enshoni.<verse eid="PSA 119:80" /></para>
  <para style="s2">Kafu</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:81: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:1">Zab 42:1</ref>, <ref loc="PSA 42:2">2</ref>; <ref loc="PSA 84:2">84:2</ref>. </char>
    </note> Amagara gangye gagwire enshazi ahabw'okwetenga okujuna kwawe;</para>
  <para style="q1" vid="PSA 119:81">Kandi ekigambo kyawe nikyo nyineho amatsiko.<verse eid="PSA 119:81" /></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:82: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:3">Zab 69:3</ref>; <ref loc="PSA 101:2">101:2</ref>. </char>
    </note> Amaisho gampotokire ahabw'okutegyereza ekigambo kyawe,</para>
  <para style="q1" vid="PSA 119:82">Nimbuuza nti: Oryampuumuza ryari omutima?<verse eid="PSA 119:82" /></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:83: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 30:30">Yob 30:30</ref>. </char>
    </note> Ahakuba mpindukire nk'efurebe ehanikire omu mwika;</para>
  <para style="q1" vid="PSA 119:83">Kwonka tinkeebwaga biragiro ebi waataireho.<verse eid="PSA 119:83" /></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:84: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:6">Zab 7:6</ref>; <ref loc="PSA 39:4">39:4</ref>; <ref loc="REV 6:10">Kush 6:10</ref>. </char>
    </note> Omwiru waawe aryahitsya hi okugumisiriza?</para>
  <para style="q1" vid="PSA 119:84">Oryacwa ryari orubanja rw'abarikumpiiga?<verse eid="PSA 119:84" /></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:85: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>; <ref loc="PSA 35:7">35:7</ref>. </char>
    </note> Ab'amaryo abatoorobera biragiro byawe,</para>
  <para style="q1" vid="PSA 119:85">Bandimiire obusya.<verse eid="PSA 119:85" /></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:86: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:19">Zab 35:19</ref>; <ref loc="PSA 109:26">109:26</ref>. </char>
    </note> Ebiragiro byawe byona n'eby'okwesigwa;</para>
  <para style="q1" vid="PSA 119:86">Nibampiigira busha; ompe emikono.<verse eid="PSA 119:86" /></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87" />Bari haihi kuunyiha omu nsi;</para>
  <para style="q1" vid="PSA 119:87">Kwonka tinkarekire bi oyegyesa.<verse eid="PSA 119:87" /></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88" />Mpimbuura, nk'embabazi zaawe nyingi oku ziri;</para>
  <para style="q1" vid="PSA 119:88">Mbone kworobera ebi akanwa kaawe kahamize.<verse eid="PSA 119:88" /></para>
  <para style="s2">Lamed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:89: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:8">Isa 40:8</ref>; <ref loc="MAT 24:35">Mat 24:35</ref>. </char>
    </note> Ai MUKAMA, ekigambo kyawe kihamire omu iguru ebiro byona.<verse eid="PSA 119:89" /></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:90, 91: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 148:6">Zab 148:6</ref>; <ref loc="ECC 1:4">Mub 1:4</ref>; <ref loc="JER 33:25">Yer 33:25</ref>. </char>
    </note> Okwesigwa kwawe kugumaho okuhitsya obusingye bwona;</para>
  <para style="q1" vid="PSA 119:90">Okataho ensi, yaahamira kimwe.<verse eid="PSA 119:90" /></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91" />Bikiriho n'eri izooba nk'oku waaragiire;</para>
  <para style="q1" vid="PSA 119:91">Ahakuba ebintu byona biba abairu baawe.<verse eid="PSA 119:91" /></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92" />Kuri ntarashemerereirwe biragiro byawe,</para>
  <para style="q1" vid="PSA 119:92">Nkaahwerekyerereire omu kubonabona kwangye.<verse eid="PSA 119:92" /></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93" />Tindyebwa bi oyegyesa;</para>
  <para style="q1" vid="PSA 119:93">Ahabw'okuba nibyo ompeereiremu amagara.<verse eid="PSA 119:93" /></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94" />Ndi owaawe; onjune;</para>
  <para style="q1" vid="PSA 119:94">Ahakuba nsherwire ebi oyegyesa.<verse eid="PSA 119:94" /></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95" />Ababi bangwereire kuunyita;</para>
  <para style="q1" vid="PSA 119:95">Kwonka niinyija kuteekateeka aha bi waahamize.<verse eid="PSA 119:95" /></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96" />Ndeebire ngu ebihikire byona biine obugarukiro;</para>
  <para style="q1" vid="PSA 119:96">Kwonka ebiragiro byawe nibihika hare munonga.<verse eid="PSA 119:96" /></para>
  <para style="s2">Menu</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:97: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 1:2">Zab 1:2</ref>. </char>
    </note> Eshi nkunda ebiragiro byawe!</para>
  <para style="q1" vid="PSA 119:97">Nibyo nsiiba ninteekateekaho eizooba ryona.<verse eid="PSA 119:97" /></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:98: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:6">Bir 4:6</ref>. </char>
    </note> Ebi oragiira bimpa obwengye oburikukira obw'abazigu bangye;</para>
  <para style="q1" vid="PSA 119:98">Ahakuba biguma naanye obutoosha.<verse eid="PSA 119:98" /></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:99: </char>
      <char style="xt" closed="false">
        <ref loc="2TI 3:15">2 Tim 3:15</ref>. </char>
    </note> Nyine okwetegyereza okurikweshumba okw'abarikuunyegyesa boona;</para>
  <para style="q1" vid="PSA 119:99">Ahakuba ebi waahamize nibyo ntuura ninteekateekaho.<verse eid="PSA 119:99" /></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:100: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 12:12">Yob 12:12</ref>; <ref loc="JOB 32:7-9">32:7-9</ref>. </char>
    </note> Niinyetegyereza okukira abagurusi,</para>
  <para style="q1" vid="PSA 119:100">Ahakuba nyorobera ebi oyegyesa.<verse eid="PSA 119:100" /></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:101: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 1:15">Enf 1:15</ref>. </char>
    </note> Nzibira ebigyere byangye kutoora omuhanda gwona omubi,</para>
  <para style="q1" vid="PSA 119:101">Ngu mbone kworobera ekigambo kyawe.<verse eid="PSA 119:101" /></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102" />Tinkateishukaga micwere yaawe;</para>
  <para style="q1" vid="PSA 119:102">Ahakuba niiwe onyegyesa.<verse eid="PSA 119:102" /></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:103: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:10">Zab 19:10</ref>. </char>
    </note> Ebigambo byawe ka nibinnurira,</para>
  <para style="q1" vid="PSA 119:103">Nibinnurira munonga okukira obwoki!<verse eid="PSA 119:103" /></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104" />Ebi oyegyesa bimpa okwetegyereza;</para>
  <para style="q1" vid="PSA 119:104">Nikyo nyangira omuhanda gwona ogw'ebishuba.<verse eid="PSA 119:104" /></para>
  <para style="s2">Nuni</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:105: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:23">Enf 6:23</ref>; <ref loc="2PE 1:19">2 Pet 1:19</ref>. </char>
    </note> Ekigambo kyawe n'etabaaza emurika ebigyere byangye,</para>
  <para style="q1" vid="PSA 119:105">N'omushana ogujwera omuhanda gwangye.<verse eid="PSA 119:105" /></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:106: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 10:29">Neh 10:29</ref>. </char>
    </note> Nkarahira endahiro, kandi naagihamya,</para>
  <para style="q1" vid="PSA 119:106">Nti: Ndyayorobera emicwere yaawe ey'oburyo.<verse eid="PSA 119:106" /></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107" />Nimbonabona munonga;</para>
  <para style="q1" vid="PSA 119:107">Mpimbuura nk'ekigambo kyawe oku kiri, ai MUKAMA.<verse eid="PSA 119:107" /></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:108: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 14:2">Hos 14:2</ref>; <ref loc="HEB 13:15">Heb 13:15</ref>. </char>
    </note> Ninkweshengyereza, oyakiire empongano zangye ez'okuhimbisa,</para>
  <para style="q1" vid="PSA 119:108">Kandi onyegyese emicwere yaawe, ai MUKAMA.<verse eid="PSA 119:108" /></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:109: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 12:3">Bar 12:3</ref>. </char>
    </note> Amagara gangye gari omu kabi obutoosha,</para>
  <para style="q1" vid="PSA 119:109">Kwonka tinkeebwaga biragiro byawe.<verse eid="PSA 119:109" /></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:110: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:3">Zab 91:3</ref>. </char>
    </note> Ababi bantegire omutego,</para>
  <para style="q1" vid="PSA 119:110">Kwonka tinkahabaga kuruga omu bi oyegyesa.<verse eid="PSA 119:110" /></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:111: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 33:4">Bir 33:4</ref>; <ref loc="JER 15:16">Yer 15:16</ref>. </char>
    </note> Ebi waahamize nibwo buhunguzi bwangye ebiro byona;</para>
  <para style="q1" vid="PSA 119:111">Buzima nibyo omutima gwangye gushemerererwa.<verse eid="PSA 119:111" /></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:112: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:33">Zab 119:33</ref>. </char>
    </note> Ntaire omutima gwangye aha kuhitsya ebiragiro byawe ebi waataireho</para>
  <para style="q1" vid="PSA 119:112">Ebiro byona okuhitsya aha muheru.<verse eid="PSA 119:112" /></para>
  <para style="s2">Sameki</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:113: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 18:21">1 Bag 18:21</ref>; <ref loc="JAS 1:8">Yak 1:8</ref>. </char>
    </note> Nyanga abantu b'emitima ebiri;</para>
  <para style="q1" vid="PSA 119:113">Kwonka ebiragiro byawe nibyo nkunda.<verse eid="PSA 119:113" /></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:114: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:3">Zab 3:3</ref>; <ref loc="PSA 32:7">32:7</ref>. </char>
    </note> Niiwe bweshereko bwangye, kandi engabo yangye;</para>
  <para style="q1" vid="PSA 119:114">Nyesiga ekigambo kyawe.<verse eid="PSA 119:114" /></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:115: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:8">Zab 6:8</ref>. </char>
    </note> Imwe nkozi z'ebibi 'mwe, mundugyeho,</para>
  <para style="q1" vid="PSA 119:115">Mbone kworobera ebiragiro bya Ruhanga wangye.<verse eid="PSA 119:115" /></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:116: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>; <ref loc="PSA 146:5">146:5</ref>; <ref loc="ROM 5:5">Rom 5:5</ref>. </char>
    </note> Onkwatirire, mbone kugumaho, nk'okuraganisa kwawe oku kuri,</para>
  <para style="q1" vid="PSA 119:116">Ndekye kukwatirwa enshoni amatsiko gangye.<verse eid="PSA 119:116" /></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117" />Ondamire, mbone kugira obusingye,</para>
  <para style="q1" vid="PSA 119:117">N'okuguma ninta omutima aha biragiro bi waataireho.<verse eid="PSA 119:117" /></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118" />Ogaya abahaba okuruga omu biragiro byawe;</para>
  <para style="q1" vid="PSA 119:118">Buzima, obwengye bwabo n'obwa busha.<verse eid="PSA 119:118" /></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:119: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:25">Isa 1:25</ref>; <ref loc="EZK 22:18">Ezk 22:18</ref>; <ref loc="MAL 3:3">Mal 3:3</ref>. </char>
    </note> Omaraho ababi boona ab'ensi nk'enkamba;</para>
  <para style="q1" vid="PSA 119:119">Nikyo nkundira ebi waahamize.<verse eid="PSA 119:119" /></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:120: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 3:16">Hab 3:16</ref>. </char>
    </note> Omubiri gwangye nigutetema ahabw'okukutiina;</para>
  <para style="q1" vid="PSA 119:120">Kandi n'emicwere yaawe ningitiina.<verse eid="PSA 119:120" /></para>
  <para style="s2">Ayini</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121" />Nkozire eby'oburyo n'eby'amazima;</para>
  <para style="q1" vid="PSA 119:121">Otandekyera abarikuunyita kubi.<verse eid="PSA 119:121" /></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:122: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 17:3">Yob 17:3</ref>. </char>
    </note> Oyemererere omwiru waawe ahabw'oburungi;</para>
  <para style="q1" vid="PSA 119:122">Ab'amaryo barekye kuunyita kubi.<verse eid="PSA 119:122" /></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:123: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:3">Zab 69:3</ref>. </char>
    </note> Amaisho gangye gahotokire ahabw'okutegyereza okujuna kwawe,</para>
  <para style="q1" vid="PSA 119:123">N'ahabw'ekigambo kyawe eky'okuhikiirira.<verse eid="PSA 119:123" /></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124" />Otwaze omwiru waawe, nk'oku embabazi zaawe ziri.</para>
  <para style="q1" vid="PSA 119:124">Kandi onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:124" /></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:125: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:16">Zab 116:16</ref>. </char>
    </note> Ndi omwiru waawe, ompe okwetegyereza,</para>
  <para style="q1" vid="PSA 119:125">Mbone kumanya ebi waahamize.<verse eid="PSA 119:125" /></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126" />Obunaku bwa MUKAMA obw'okukoreramu bwahika;</para>
  <para style="q1" vid="PSA 119:126">Ahakuba ebiragiro byawe babihindwire busha.<verse eid="PSA 119:126" /></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:127: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:72">Zab 119:72</ref>. </char>
    </note> Nikyo ndikukundira ebiragiro byawe</para>
  <para style="q1" vid="PSA 119:127">Okukira ezaabu, n'obu yaakuba ezaabu enungi munonga.<verse eid="PSA 119:127" /></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128" />Nikyo nteekateekyera ngu ebi oyegyesa aha bintu byona bihikire;</para>
  <para style="q1" vid="PSA 119:128">Kandi nyanga omuhanda gwona ogw'ebishuba.<verse eid="PSA 119:128" /></para>
  <para style="s2">Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129" />Ebi waahamize n'eby'okutangaaza;</para>
  <para style="q1" vid="PSA 119:129">Nikyo kireetera omutima gwangye kubyorobera.<verse eid="PSA 119:129" /></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:130: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:7">Zab 19:7</ref>. </char>
    </note> Ebigambo byawe, ku bishuuruurwa, bireeta omushana;</para>
  <para style="q1" vid="PSA 119:130">Biha aboorobi okwetegyereza.<verse eid="PSA 119:130" /></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:131: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:1">Zab 42:1</ref>; <ref loc="JOB 29:23">Yob 29:23</ref>. </char>
    </note> Nkaashamya akanwa kangye, nyine ekyaka,</para>
  <para style="q1" vid="PSA 119:131">Ahabw'okwetenga munonga ebiragiro byawe.<verse eid="PSA 119:131" /></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:132: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:16">Zab 25:16</ref>. </char>
    </note> Ompindukire, ongirire embabazi;</para>
  <para style="q1" vid="PSA 119:132">Nk'oku ozigirira abakunda eiziina ryawe.<verse eid="PSA 119:132" /></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:133: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:13">Zab 19:13</ref>. </char>
    </note> Oshoronzye ebigyere byangye omu kigambo kyawe;</para>
  <para style="q1" vid="PSA 119:133">Otaikiriza okutahikiirira kwona kuntegyeka.<verse eid="PSA 119:133" /></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:134: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:74">Luk 1:74</ref>. </char>
    </note> Oncungure, ndekye kwitwa kubi abantu;</para>
  <para style="q1" vid="PSA 119:134">Mbone kworobera ebi oyegyesa.<verse eid="PSA 119:134" /></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:135: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:6">Zab 4:6</ref>. </char>
    </note> Oyakize omwiru waawe omushana gw'amaisho gaawe,</para>
  <para style="q1" vid="PSA 119:135">Onyegyese ebiragiro ebi waataireho.<verse eid="PSA 119:135" /></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:136: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:1">Yer 9:1</ref>, <ref loc="JER 9:18">18</ref>; <ref loc="JER 14:17">14:17</ref>. </char>
    </note> Amaisho gangye gahimintika obutoosha emigyera y'amaizi,</para>
  <para style="q1" vid="PSA 119:136">Ahabw'abantu kutoorobera biragiro byawe.<verse eid="PSA 119:136" /></para>
  <para style="s2">Tsade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:137: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:5">Zab 116:5</ref>; <ref loc="EZR 9:15">Ezr 9:15</ref>; <ref loc="DAN 9:7">Dan 9:7</ref>. </char>
    </note> Ai MUKAMA, ori ohikiriire;</para>
  <para style="q1" vid="PSA 119:137">Kandi emicwere yaawe n'ey'oburyo.<verse eid="PSA 119:137" /></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:138: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:7-9">Zab 19:7-9</ref>. </char>
    </note> Okataho ebi waahamize omu kuhikiirira</para>
  <para style="q1" vid="PSA 119:138">N'omu bwesigwa buzima.<verse eid="PSA 119:138" /></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:139: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:9">Zab 69:9</ref>. </char>
    </note> Obweziriki bwangye bummazireho,</para>
  <para style="q1" vid="PSA 119:139">Ahakuba ababisha bangye beebirwe ebigambo byawe.<verse eid="PSA 119:139" /></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:140: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:6">Zab 12:6</ref>. </char>
    </note> Ekigambo kyawe kishemeire munonga;</para>
  <para style="q1" vid="PSA 119:140">Nikyo omwiru waawe akikundira.<verse eid="PSA 119:140" /></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141" />Tiinyine ku ndi, nibangaya;</para>
  <para style="q1" vid="PSA 119:141">Kwonka tinkeebwaga bi oyegyesa.<verse eid="PSA 119:141" /></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:142: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:9">Zab 19:9</ref>; <ref loc="JHN 17:17">Yoh 17:17</ref>. </char>
    </note> Okuhikiirira kwawe n'okw'ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 119:142">Kandi ebiragiro byawe n'amazima.<verse eid="PSA 119:142" /></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:143: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:24">Zab 119:24</ref>. </char>
    </note> Enaku n'obusaasi binkwatsire;</para>
  <para style="q1" vid="PSA 119:143">Kwonka ebiragiro byawe nibyo nshemerererwa.<verse eid="PSA 119:143" /></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:144: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 32:8">Yob 32:8</ref>. </char>
    </note> Ebi waahamize bituura bihikiriire ebiro byona;</para>
  <para style="q1" vid="PSA 119:144">Ompe okwetegyereza, mbone kuguma ndi ohuriire.<verse eid="PSA 119:144" /></para>
  <para style="s2">Kofu</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:145: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:2">Zab 119:2</ref>. </char>
    </note> Ai MUKAMA, ninkutakira n'omutima gwangye gwona;</para>
  <para style="q1" vid="PSA 119:145">Ongarukyemu, mbone kworobera ebiragiro ebi waataireho.<verse eid="PSA 119:145" /></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146" />Ninkutakira; njuna;</para>
  <para style="q1" vid="PSA 119:146">Mbone kworobera ebi waahamize.<verse eid="PSA 119:146" /></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:147: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:3">Zab 5:3</ref>; <ref loc="PSA 130:5">130:5</ref>. </char>
    </note> Nyimuka omushekye gutakajugutsire kukutakira,</para>
  <para style="q1" vid="PSA 119:147">Ntaire amatsiko aha bigambo byawe.<verse eid="PSA 119:147" /></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:148: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:55">Zab 119:55</ref>. </char>
    </note> Ku nsisiimuka, amaisho gangye gaguma nigareeba, obunaku bw'okusisiimuka nyekiro butakahikire,</para>
  <para style="q1" vid="PSA 119:148">Ngu mbone kuguma ninteekateeka aha kigambo kyawe.<verse eid="PSA 119:148" /></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149" />Hurira eiraka ryangye, nk'embabazi zaawe ezitahinduka oku ziri;</para>
  <para style="q1" vid="PSA 119:149">Ompimbuure, ai MUKAMA, nk'oku emicwere yaawe eri.<verse eid="PSA 119:149" /></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150" />Abarikumpiiga ahabw'eitima nibaanyirira haihi;</para>
  <para style="q1" vid="PSA 119:150">Ebiragiro byawe bibari hare.<verse eid="PSA 119:150" /></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:151: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:18">Zab 145:18</ref>. </char>
    </note> Kwonka Iwe ai MUKAMA, ori haihi;</para>
  <para style="q1" vid="PSA 119:151">Ebiragiro byawe byona n'amazima.<verse eid="PSA 119:151" /></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:152: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:89">Zab 119:89</ref>. </char>
    </note> Kandi mmazire omwanya muhango nimmanyira aha bi waahamize,</para>
  <para style="q1" vid="PSA 119:152">Ku waabitaireho kugumaho ebiro byona.<verse eid="PSA 119:152" /></para>
  <para style="s2">Reshi</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:153: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 36:15">Yob 36:15</ref>. </char>
    </note> Teekateeka aha kubonabona kwangye, onjune;</para>
  <para style="q1" vid="PSA 119:153">Ahakuba tiinyebwa biragiro byawe.<verse eid="PSA 119:153" /></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:154: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:15">1 Sam 24:15</ref>; <ref loc="MIC 7:9">Mik 7:9</ref>. </char>
    </note> Ontonganire, kandi oncungure;</para>
  <para style="q1" vid="PSA 119:154">Ompimbuure, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:154" /></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:155: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:4">Yob 5:4</ref>. </char>
    </note> Ababi okujunwa kubari hare;</para>
  <para style="q1" vid="PSA 119:155">Ahakuba tibata mutima ha biragiro ebi waataireho.<verse eid="PSA 119:155" /></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:156: </char>
      <char style="xt" closed="false">
        <ref loc="JER 3:20">Yer 3:20</ref>. </char>
    </note> Ai MUKAMA, embabazi zaawe ni nyingi;</para>
  <para style="q1" vid="PSA 119:156">Ompimbuure, nk'emicwere yaawe ey'oburyo oku eri.<verse eid="PSA 119:156" /></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:157: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:1">Zab 3:1</ref>, <ref loc="PSA 3:2">2</ref>. </char>
    </note> Abarikumpiiga n'abazigu bangye ni baingi;</para>
  <para style="q1" vid="PSA 119:157">Kwonka tinkateishukaga kureka ebi waahamize.<verse eid="PSA 119:157" /></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:158: </char>
      <char style="xt" closed="false">
        <ref loc="JER 3:20">Yer 3:20</ref>. </char>
    </note> Nkareeba abarikukora eby'obugobya, bantama;</para>
  <para style="q1" vid="PSA 119:158">Ahakuba tiboorobera biragiro byawe.<verse eid="PSA 119:158" /></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159" />Teekateeka oku nkunda ebi oyegyesa;</para>
  <para style="q1" vid="PSA 119:159">Ompimbuure, ai MUKAMA, nk'embabazi zaawe ezitahinduka oku ziri.<verse eid="PSA 119:159" /></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:160: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:17">Zab 139:17</ref>. </char>
    </note> Okutwarira hamwe ekigambo kyawe kyona gaba amazima;</para>
  <para style="q1" vid="PSA 119:160">Emicwere yaawe yoona ey'oburyo egumaho ebiro byona.<verse eid="PSA 119:160" /></para>
  <para style="s2">Shini</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:161: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:11">1 Sam 24:11</ref>. </char>
    </note> Abanyiginya bampiigira busha;</para>
  <para style="q1" vid="PSA 119:161">Kwonka ebigambo byawe bikwatsa omutima gwangye obwoba.<verse eid="PSA 119:161" /></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:162: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 21:11">Zab 21:11</ref>; <ref loc="ISA 9:3">Isa 9:3</ref>; <ref loc="JER 15:16">Yer 15:16</ref>. </char>
    </note> Nshemerererwa ekigambo kyawe,</para>
  <para style="q1" vid="PSA 119:162">Nk'owaagwa aha minyago mingi.<verse eid="PSA 119:162" /></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163" />Nyanga ebishuba, kandi mbinuga;</para>
  <para style="q1" vid="PSA 119:163">Kwonka ebiragiro byawe mbikunda.<verse eid="PSA 119:163" /></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164" />Buri izooba nkuhimbisa emirundi mushanju,</para>
  <para style="q1" vid="PSA 119:164">Ahabw'emicwere yaawe y'oburyo.<verse eid="PSA 119:164" /></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:165: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:11">Zab 37:11</ref>, <ref loc="PSA 37:37">37</ref>; <ref loc="PRO 3:2">Enf 3:2</ref>, <ref loc="PRO 3:23">23</ref>; <ref loc="ISA 32:17">Isa 32:17</ref>; <ref loc="1JN 2:10">1 Yoh 2:10</ref>. </char>
    </note> Abakunda ebiragiro byawe baine obusingye bwingi;</para>
  <para style="q1" vid="PSA 119:165">Tihariho kirikubaasa kubateeza entsibo.<verse eid="PSA 119:165" /></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:166: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:18">Kut 49:18</ref>. </char>
    </note> Ai MUKAMA, ntegyereize okujuna kwawe;</para>
  <para style="q1" vid="PSA 119:166">Kandi nkora ebi oragiira.<verse eid="PSA 119:166" /></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167" />Omutima gwangye gworobera ebi waahamize;<verse eid="PSA 119:167" /></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:168: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:3">Zab 139:3</ref>; <ref loc="JOB 34:21">Yob 34:21</ref>; <ref loc="PRO 5:21">Enf 5:21</ref>. </char>
    </note> Obutoosha nyorobera ebi oyegyesa n'ebi waahamize;</para>
  <para style="q1" vid="PSA 119:168">Ahakuba emitwarize yangye yoona eri omu maisho gaawe.<verse eid="PSA 119:168" /></para>
  <para style="s2">Tau</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:169: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 2:6">Enf 2:6</ref>; <ref loc="JAS 1:5">Yak 1:5</ref>. </char>
    </note> Ai MUKAMA, ikiriza okutaka kwangye kukuhikyeho;</para>
  <para style="q1" vid="PSA 119:169">Ompe okwetegyereza, nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:169" /></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170" />Okweshengyereza kwangye kuhikye omu maisho gaawe;</para>
  <para style="q1" vid="PSA 119:170">Onkize nk'ekigambo kyawe oku kiri.<verse eid="PSA 119:170" /></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:171: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:7">Zab 145:7</ref>. </char>
    </note> Eminwa yangye eryagamba eby'okuhimbisa;</para>
  <para style="q1" vid="PSA 119:171">Ahakuba onyegyesa ebiragiro ebi waataireho.<verse eid="PSA 119:171" /></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172" />Orurimi rwangye ruryayeshongora eby'ekigambo kyawe;</para>
  <para style="q1" vid="PSA 119:172">Ahakuba ebiragiro byawe byona bihikire.<verse eid="PSA 119:172" /></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:173: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 24:22">Yos 24:22</ref>; <ref loc="PRO 1:29">Enf 1:29</ref>; <ref loc="LUK 10:42">Luk 10:42</ref>. </char>
    </note> Omukono gwawe gugume gweteekateekire kumpwera;</para>
  <para style="q1" vid="PSA 119:173">Ahakuba nkatoorana ebi oyegyesa.<verse eid="PSA 119:173" /></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:174: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:20">Zab 119:20</ref>, <ref loc="PSA 119:24">24</ref>. </char>
    </note> Ntuura niinyetenga munonga okujuna kwawe, ai MUKAMA;</para>
  <para style="q1" vid="PSA 119:174">Kandi ebiragiro byawe nibyo nshemerererwa.<verse eid="PSA 119:174" /></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175" />Ondekye ngume ndi ohuriire, mbone kukuhimbisa;</para>
  <para style="q1" vid="PSA 119:175">Emicwere yaawe ey'oburyo empwere.<verse eid="PSA 119:175" /></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176" />
    <note caller="-" style="x">
      <char style="xo" closed="false">119:176: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 53:6">Isa 53:6</ref>; <ref loc="MAT 18:12">Mat 18:12</ref>; <ref loc="LUK 15:4">Luk 15:4</ref>; <ref loc="1PE 2:25">1 Pet 2:25</ref>. </char>
    </note> Mpabire nk'entaama ebuzire; sherura omwiru waawe;</para>
  <para style="q1" vid="PSA 119:176">Ahakuba tiinyebwa biragiro byawe.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" sid="PSA 120" />
  <para style="s1">Okushaba okurindwa abarikuturwanisa</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 120:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">120:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:5">Zab 118:5</ref>; <ref loc="JON 2:2">Yon 2:2</ref>. </char>
    </note> Omu busaasi bwangye nkatakira MUKAMA, yangarukamu.<verse eid="PSA 120:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2" />Ai MUKAMA, kiza amagara gangye eminwa erikubeiha,</para>
  <para style="q1" vid="PSA 120:2">N'orurimi orurikugobya.<verse eid="PSA 120:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">120:3: </char>
      <char style="xt" closed="false">
        <ref loc="JAS 3:6">Yak 3:6</ref>. </char>
    </note> Iwe rurimi orurikugobya 'we, baryakuha ki,</para>
  <para style="q1" vid="PSA 120:3">Kandi baryakukorera ki ekindi?<verse eid="PSA 120:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">120:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 127:4">Zab 127:4</ref>; <ref loc="PSA 140:10">140:10</ref>. </char>
    </note> Emyambi y'obwogi y'amamanzi,</para>
  <para style="q1" vid="PSA 120:4">N'amakara g'omushasha.<verse eid="PSA 120:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">120:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 21:16">Isa 21:16</ref>; <ref loc="JER 49:28">Yer 49:28</ref>; <ref loc="EZK 27:13">Ezk 27:13</ref>, <ref loc="EZK 27:21">21</ref>. </char>
    </note> Ka ndeebire enaku ahabw'okushuhuukira Mesheki,</para>
  <para style="q1" vid="PSA 120:5">N'okutuura omu mahema ga Kedari.<verse eid="PSA 120:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6" />Mmazire omwanya muhango,</para>
  <para style="q1" vid="PSA 120:6">Ntwire n'abarikwanga obusingye.<verse eid="PSA 120:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7" />Nyowe eki nkunda n'obusingye;</para>
  <para style="q1" vid="PSA 120:7">Kwonka ku ngamba, bo baimutsya orugamba.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" sid="PSA 121" />
  <para style="s1">Mukama okuba Omurinzi w'abantu be</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 121:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 123:1">Zab 123:1</ref>; <ref loc="JER 3:23">Yer 3:23</ref>. </char>
    </note> Nyimutsye amaisho gangye aha bibungo?</para>
  <para style="q1" vid="PSA 121:1">Okuhwerwa kwangye kuruga hi?<verse eid="PSA 121:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:15">Zab 115:15</ref>; <ref loc="PSA 124:8">124:8</ref>. </char>
    </note> Okuhwera kwangye kuruga ahari MUKAMA,</para>
  <para style="q1" vid="PSA 121:2">Owaahangire eiguru n'ensi.<verse eid="PSA 121:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 41:2">Zab 41:2</ref>. </char>
    </note> Tariikiriza kigyere kyawe kutsimbuka;</para>
  <para style="q1" vid="PSA 121:3">Orikukurinda tarihungira.<verse eid="PSA 121:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4" />Reeba, Orikurinda Israeli tarihungira, n'obu kwakuba okugwejegyera.<verse eid="PSA 121:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:8">Zab 16:8</ref>; <ref loc="PSA 91:1">91:1</ref>. </char>
    </note> MUKAMA niwe Murinzi waawe,</para>
  <para style="q1" vid="PSA 121:5">MUKAMA niwe ky'okwesangira kyawe aha rubaju rwawe rwa buryo.<verse eid="PSA 121:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:10">Isa 49:10</ref>; <ref loc="REV 7:16">Kush 7:16</ref>. </char>
    </note> Izooba tiririkuteera nyomushana,</para>
  <para style="q1" vid="PSA 121:6">N'obu kwakuba okwezi nyekiro.<verse eid="PSA 121:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:10">Zab 91:10</ref>. </char>
    </note> MUKAMA aryakurinda akabi koona;</para>
  <para style="q1" vid="PSA 121:7">Niwe aririnda amagara gaawe.<verse eid="PSA 121:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">121:8: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:6">Bir 28:6</ref>. </char>
    </note> MUKAMA aryakurinda omu magyenda n'amagaruka,</para>
  <para style="q1" vid="PSA 121:8">Okwiha hati okuhitsya ebiro byona.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" sid="PSA 122" />
  <para style="s1">Okushabira Yerusaalemu obusingye</para>
  <para style="d">Ekyeshongoro kya Daudi eky'okutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 122:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:3">Isa 2:3</ref>; <ref loc="JER 31:6">Yer 31:6</ref>; <ref loc="ZEC 8:21">Zek 8:21</ref>. </char>
    </note> Nkashemererwa ku bangambiire</para>
  <para style="q1" vid="PSA 122:1">Ngu tugyende omu nju ya MUKAMA.<verse eid="PSA 122:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2" />Iwe Yerusaalemu, ebigyere byaitu</para>
  <para style="q1" vid="PSA 122:2">Byemereire omu marembo gaawe,<verse eid="PSA 122:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3" />Iwe Yerusaalemu eyaayombekirwe</para>
  <para style="q1" vid="PSA 122:3">Nk'orurembo orukwataine,<verse eid="PSA 122:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 16:16">Bir 16:16</ref>. </char>
    </note> Ei enganda ziinamuka, nizo nganda za MUKAMA,</para>
  <para style="q1" vid="PSA 122:4">Kuba eky'okuhamya ahari Israeli, n'okusiima eiziina rya MUKAMA.<verse eid="PSA 122:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:5: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 3:16-28">1 Bag 3:16-28</ref>. </char>
    </note> Ahakuba niyo baataire ebitebe by'okucweraho emanja,</para>
  <para style="q1" vid="PSA 122:5">Nibyo bitebe by'obugabe eby'enju ya Daudi.<verse eid="PSA 122:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 29:7">Yer 29:7</ref>; <ref loc="JER 51:50">51:50</ref>. </char>
    </note> Mushabire Yerusaalemu obusingye;</para>
  <para style="q1" vid="PSA 122:6">Abarikukukunda baryagogyera.<verse eid="PSA 122:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:13">Zab 48:13</ref>. </char>
    </note> Obusingye bugume omunda y'orugo rwawe,</para>
  <para style="q1" vid="PSA 122:7">N'omu bikaari byawe habemu omugisha.<verse eid="PSA 122:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">122:8: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 25:6">1 Sam 25:6</ref>. </char>
    </note> Ahabwa beene waitu na bagyenzi bangye</para>
  <para style="q1" vid="PSA 122:8">Ningira nti: Obusingye bugume omuriiwe!<verse eid="PSA 122:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9" />Ahabw'enju ya MUKAMA Ruhanga waitu</para>
  <para style="q1" vid="PSA 122:9">Ndyateeraho kusherura oku ndaabaase kukukorera gye.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" sid="PSA 123" />
  <para style="s1">Okutegyereza Mukama tumwineho amatsiko</para>
  <para style="d">Ekyeshongoro eky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 123:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">123:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 2:4">Zab 2:4</ref>; <ref loc="PSA 121:1">121:1</ref>. </char>
    </note> Iwe oshutami omu iguru,</para>
  <para style="q1" vid="PSA 123:1">Niiwe nyimukiza amaisho.<verse eid="PSA 123:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2" />Reeba, nk'oku abahuuku bahanga mukama waabo amaisho,</para>
  <para style="q1" vid="PSA 123:2">N'abazaana nk'oku bagahanga mugore waabo,</para>
  <para style="q1" vid="PSA 123:2">Naitwe nikwo tuhangiire MUKAMA Ruhanga waitu amaisho,</para>
  <para style="q1" vid="PSA 123:2">Okuhitsya obu aritugirira embabazi.<verse eid="PSA 123:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">123:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 4:1">Zab 4:1</ref>; <ref loc="NEH 4:4">Neh 4:4</ref>. </char>
    </note> Otugirire embabazi, ai MUKAMA, otugirire embabazi,</para>
  <para style="q1" vid="PSA 123:3">Ahakuba barengyesereize kutugaya.<verse eid="PSA 123:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">123:4: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 2:19">Neh 2:19</ref>. </char>
    </note> Amagara gaitu gatamiirwe kimwe okuteererwa enaku abagaramisiriize,</para>
  <para style="q1" vid="PSA 123:4">N'okugaywa ab'amaryo.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" sid="PSA 124" />
  <para style="s1">Okusiima Mukama ahabw'okutujuna abarikutwimukirira</para>
  <para style="d">Ekyeshongoro kya Daudi eky'okutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 124:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">124:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 94:17">Zab 94:17</ref>; <ref loc="JOS 1:5">Yos 1:5</ref>; <ref loc="ROM 8:31">Rom 8:31</ref>. </char>
    </note> MUKAMA ku araabe yaabaire atari ha rubaju rwaitu,</para>
  <para style="q1" vid="PSA 124:1">Israeli naakigambe hati mbwenu.<verse eid="PSA 124:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2" />MUKAMA kuri yaabaire atari ha rubaju rwaitu,</para>
  <para style="q1" vid="PSA 124:2">Obu abantu baimuka kuturwanisa,<verse eid="PSA 124:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 124:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">124:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:25">Zab 35:25</ref>; <ref loc="PSA 56:1">56:1</ref>; <ref loc="JER 51:34">Yer 51:34</ref>. </char>
    </note> Obwo bakaatumizire tuhuriire,</para>
  <para style="q1" vid="PSA 124:3">Obu ekiniga kyatwakaho nk'omuriro;<verse eid="PSA 124:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">124:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:6">Zab 32:6</ref>; <ref loc="PSA 69:1">69:1</ref>, <ref loc="PSA 69:2">2</ref>. </char>
    </note> Obwo amaizi gakaatutwariire kimwe,</para>
  <para style="q1" vid="PSA 124:4">Omugyera ogurikuhimintika gushweka amagara gaitu;<verse eid="PSA 124:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5" />N'amaizi agarikutabanguka gashweka amagara gaitu.<verse eid="PSA 124:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6" />MUKAMA asiimwe, otaratuhaireyo</para>
  <para style="q1" vid="PSA 124:6">Kuba omuhiigo gw'okutaagataagurwa amaino gaabo.<verse eid="PSA 124:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">124:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 91:3">Zab 91:3</ref>. </char>
    </note> Amagara gaitu gacwire, nk'oku enyonyi eruga omu mutego gw'abategi;</para>
  <para style="q1" vid="PSA 124:7">Omutego gucwekire; naitwe twarugamu.<verse eid="PSA 124:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">124:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 121:2">Zab 121:2</ref>; <ref loc="ISA 50:10">Isa 50:10</ref>; <ref loc="HEB 13:6">Heb 13:6</ref>. </char>
    </note> Okuhwerwa kwaitu kuri omu iziina rya MUKAMA</para>
  <para style="q1" vid="PSA 124:8">Owaahangire eiguru n'ensi.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" sid="PSA 125" />
  <para style="s1">Mukama nk'oku ayehinguririize abantu be</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">125:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:2">Zab 25:2</ref>, <ref loc="PSA 25:3">3</ref>; <ref loc="PRO 10:30">Enf 10:30</ref>. </char>
    </note> Abarikwesiga MUKAMA bari nk'orushozi Saayuuni,</para>
  <para style="q1" vid="PSA 125:1">Orutarikubaasa kutengyetsibwa, kureka orutuura ruhamire ebiro byona.<verse eid="PSA 125:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">125:2: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 6:17">2 Bag 6:17</ref>; <ref loc="ZEC 2:5">Zek 2:5</ref>. </char>
    </note> Nk'oku ebibungo byehinguririize abantu be</para>
  <para style="q1" vid="PSA 125:2">Okwiha hati okuhitsya ebiro byona.<verse eid="PSA 125:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3" />Ahakuba enkoni y'obutegyeki bw'obubi</para>
  <para style="q1" vid="PSA 125:3">Teriguma neetegyeka abahikiriire omu buhunguzi bwabo,</para>
  <para style="q1" vid="PSA 125:3">Ngu abahikiriire batakaagorora emikono yaabo kukora kubi.<verse eid="PSA 125:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4" />Ai MUKAMA, abarungi obakorere ebirungi,</para>
  <para style="q1" vid="PSA 125:4">N'abaine emitima egororokire.<verse eid="PSA 125:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">125:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 128:6">Zab 128:6</ref>; <ref loc="PRO 2:15">Enf 2:15</ref>; <ref loc="ISA 59:8">Isa 59:8</ref>; <ref loc="GAL 6:16">Gal 6:16</ref>. </char>
    </note> Kwonka abarikuteishuka, bakatoora emihanda yaabo ekiikami,</para>
  <para style="q1" vid="PSA 125:5">MUKAMA aryabatwarirana n'enkozi z'ebibi.</para>
  <para style="q1" vid="PSA 125:5">Obusingye bugume omuri Israeli!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" sid="PSA 126" />
  <para style="s1">Eby'okusiima ahabw'okuruga omu bukwatwa</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 126:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">126:1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:9">Byak 12:9</ref>. </char>
    </note> MUKAMA obu yaagarura aba Saayuuni abaanyagirwe,</para>
  <para style="q1" vid="PSA 126:1">Obwo tukashusha nk'abarikuroota;<verse eid="PSA 126:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">126:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:19">Zab 71:19</ref>; <ref loc="JOB 8:21">Yob 8:21</ref>. </char>
    </note>2 Akanwa kaitu kakaijura esheko,</para>
  <para style="q1" vid="PSA 126:2">N'orurimi rwaitu rwayeshongora.</para>
  <para style="q1" vid="PSA 126:2">Obwo ab'omu banyamahanga baagambirana bati:</para>
  <para style="q1" vid="PSA 126:2">MUKAMA abakoreire ebikuru.<verse eid="PSA 126:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3" />Eego, MUKAMA atukoreire ebikuru;</para>
  <para style="q1" vid="PSA 126:3">Nikyo tushemerereirwe.<verse eid="PSA 126:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4" />MUKAMA, itwe abaanyagirwe otugarure,</para>
  <para style="q1" vid="PSA 126:4">Tube nk'emigyera ya Negebu!<verse eid="PSA 126:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">126:5: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 12:43">Neh 12:43</ref>; <ref loc="JER 31:9">Yer 31:9</ref>. </char>
    </note> Abarikubiba nibarira, baryagyesha nibashemererwa.<verse eid="PSA 126:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6" />Orikugyenda naarira, naaza kubiba embibo,</para>
  <para style="q1" vid="PSA 126:6">Aryagaruka n'okushemererwa, ayekoreire ebiba bye.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" sid="PSA 127" />
  <para style="s1">Okusiima Mukama ahabw'okutuha okuba gye omu maka</para>
  <para style="d">Ekyeshongoro kya Sulemaani ky'okutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 127:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">127:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 121:4">Zab 121:4</ref>. </char>
    </note> MUKAMA ku aba atombekire nju, abombeki beeruhiza busha.</para>
  <para style="q1" vid="PSA 127:1">MUKAMA ku aba atarinzire rurembo, omurinzi araara naareebera busha.<verse eid="PSA 127:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">127:2: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 3:17">Kut 3:17</ref>. </char>
    </note> Muhendekyera busha okwimuka kare, mukakyerererwa kubyama,</para>
  <para style="q1" vid="PSA 127:2">Kandi mukarya eby'okurya ebi muhendekyeire;</para>
  <para style="q1" vid="PSA 127:2">Haza ebyo abiha abu akunda, beegwejegyereire.<verse eid="PSA 127:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">127:3: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 33:5">Kut 33:5</ref>; <ref loc="DEU 28:4">Bir 28:4</ref>. </char>
    </note> Reeba, abaana n'obuhunguzi oburuga ahari MUKAMA,</para>
  <para style="q1" vid="PSA 127:3">N'enda ezizaarwa n'ebiconco ebi agaba.<verse eid="PSA 127:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4" />Nk'oku emyambi eba omu mukono gw'emanzi,</para>
  <para style="q1" vid="PSA 127:4">N'abaana b'omu butsigazi nikwo baba.<verse eid="PSA 127:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5" />Omuntu ou omutana gwe gwijwire gutyo ahiiriirwe.</para>
  <para style="q1" vid="PSA 127:5">Abari nk'abo tibarikwatwa nshoni,</para>
  <para style="q1" vid="PSA 127:5">Baba nibagamba n'abazigu baabo omu irembo.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" sid="PSA 128" />
  <para style="s1">Omugisha gw'eka y'omuntu orikutiina Mukama</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 128:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">128:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:1">Zab 112:1</ref>; <ref loc="PRO 8:32">Enf 8:32</ref>. </char>
    </note> Aine omugisha omuntu weena orikutiina MUKAMA,</para>
  <para style="q1" vid="PSA 128:1">Akagyendera omu mihanda ye.<verse eid="PSA 128:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">128:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:10">Isa 3:10</ref>. </char>
    </note> Oryaguma orye ebi emikono yaawe ehendekyeire;</para>
  <para style="q1" vid="PSA 128:2">Oryayesiima, kandi ogire omugisha.<verse eid="PSA 128:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">128:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:8">Zab 52:8</ref>; <ref loc="EZK 19:10">Ezk 19:10</ref>. </char>
    </note> Omukazi waawe aryaba nk'omuzaabibu ogurikwana</para>
  <para style="q1" vid="PSA 128:3">Omu bishengye by'omu nju yaawe,</para>
  <para style="q1" vid="PSA 128:3">N'abaana baawe nk'amataagi g'omuzeituuni</para>
  <para style="q1" vid="PSA 128:3">Beehinguririize emeeza yaawe.<verse eid="PSA 128:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4" />Reeba, okwo nikwo omuntu orikutiina MUKAMA</para>
  <para style="q1" vid="PSA 128:4">Ariheebwa omugisha.<verse eid="PSA 128:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">128:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 134:3">Zab 134:3</ref>. </char>
    </note> MUKAMA akuhe omugisha naayema omuri Saayuuni,</para>
  <para style="q1" vid="PSA 128:5">Oreebe omugisha gwa Yerusaalemu ebiro byona eby'amagara gaawe.<verse eid="PSA 128:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">128:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 125:5">Zab 125:5</ref>; <ref loc="GEN 50:23">Kut 50:23</ref>; <ref loc="PRO 17:6">Enf 17:6</ref>. </char>
    </note> Eego, oreebe abaana b'abaana baawe!</para>
  <para style="q1" vid="PSA 128:6">Obusingye bugume ahari Israeli.<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" sid="PSA 129" />
  <para style="s1">Okushaba ngu abarikwanga Saayuuni boona bagarurwe ahansi</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 129:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 124:1">Zab 124:1</ref>; <ref loc="EXO 1:14">Kur 1:14</ref>; <ref loc="JER 2:2">Yer 2:2</ref>; <ref loc="HOS 2:15">Hos 2:15</ref>. </char>
    </note> Bakambonabonesa kaingi okwiha omu butsigazi bwangye;</para>
  <para style="q1" vid="PSA 129:1">Israeli abe nikwo yaagamba hati mbwenu;<verse eid="PSA 129:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:2: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 4:8">2 Kor 4:8</ref>, <ref loc="2CO 4:9">9</ref>. </char>
    </note> Bakambonabonesa kaingi okwiha omu butsigazi bwangye,</para>
  <para style="q1" vid="PSA 129:2">Kwonka tibarambazise.<verse eid="PSA 129:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 51:23">Isa 51:23</ref>; <ref loc="MIC 3:12">Mik 3:12</ref>. </char>
    </note> Abahingi bakahinga aha mugongo gwangye;</para>
  <para style="q1" vid="PSA 129:3">Baahateera emikura miraingwa.<verse eid="PSA 129:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4" />MUKAMA n'ohikiriire;</para>
  <para style="q1" vid="PSA 129:4">Emigoye y'ababi agicwiremu kabiri.<verse eid="PSA 129:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:4">Zab 35:4</ref>. </char>
    </note> Boona abarikwanga Saayuuni</para>
  <para style="q1" vid="PSA 129:5">Bakwatwe enshoni, bagarurwe enyima;<verse eid="PSA 129:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:6: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 19:26">2 Bag 19:26</ref>; <ref loc="JOB 8:12">Yob 8:12</ref>. </char>
    </note> Babe nk'obunyaatsi obumera aha mutwe gw'enju,</para>
  <para style="q1" vid="PSA 129:6">Obwoma butakakuzire;<verse eid="PSA 129:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7" />Obu omugyesi ataijuza ngaro ze,</para>
  <para style="q1" vid="PSA 129:7">N'obu yaakuba orikuboha enganda obu atijuza mikono ye;<verse eid="PSA 129:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">129:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:26">Zab 118:26</ref>; <ref loc="RUT 2:4">Rus 2:4</ref>. </char>
    </note> Kandi n'abahinguzi tibagira bati:</para>
  <para style="q1" vid="PSA 129:8">Omugisha gwa MUKAMA gugume ahariimwe.</para>
  <para style="q1" vid="PSA 129:8">Nitubashabira omugisha omu iziina rya MUKAMA.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" sid="PSA 130" />
  <para style="s1">Okushaba kw'omuntu ori hare oyehweire amatsiko, n'okuhamya ngu Mukama naija kumucungura</para>
  <para style="d">Ekyeshongoro ky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 130:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:1: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 3:55">Tonz 3:55</ref>; <ref loc="JON 2:2">Yon 2:2</ref>. </char>
    </note> Ai MUKAMA, ninkutakira ndi hare okuzimu.<verse eid="PSA 130:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:6">Zab 86:6</ref>. </char>
    </note> Hurira eiraka ryangye, ai Mukama,</para>
  <para style="q1" vid="PSA 130:2">Otegye amatu eiraka ry'okweshengyereza kwangye.<verse eid="PSA 130:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 76:7">Zab 76:7</ref>; <ref loc="PSA 143:2">143:2</ref>; <ref loc="JOB 10:14">Yob 10:14</ref>; <ref loc="NAM 1:6">Nah 1:6</ref>; <ref loc="MAL 3:2">Mal 3:2</ref>; <ref loc="REV 6:17">Kush 6:17</ref>. </char>
    </note> MUKAMA, kuri noofa aha by'okutahikiirira,</para>
  <para style="q1" vid="PSA 130:3">N'oha owaakubaasa kwemerera, ai MUKAMA?<verse eid="PSA 130:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:4: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:39">1 Bag 8:39</ref>, <ref loc="1KI 8:40">40</ref>; <ref loc="ISA 55:7">Isa 55:7</ref>; <ref loc="JER 33:8">Yer 33:8</ref>, <ref loc="JER 33:9">9</ref>; <ref loc="DAN 9:9">Dan 9:9</ref>; <ref loc="EPH 1:7">Efe 1:7</ref>. </char>
    </note> Kwonka ah'ori hariho okusaasirwa,</para>
  <para style="q1" vid="PSA 130:4">Ngu obone kutiinwa.<verse eid="PSA 130:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:20">Zab 33:20</ref>; <ref loc="PSA 119:74">119:74</ref>; <ref loc="ISA 26:8">Isa 26:8</ref>. </char>
    </note> Nintegyereza MUKAMA; n'amagara gangye nigategyereza;</para>
  <para style="q1" vid="PSA 130:5">Kandi n'amatsiko gangye gaba aha kigambo kye;<verse eid="PSA 130:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:147">Zab 119:147</ref>; <ref loc="PSA 123:2">123:2</ref>. </char>
    </note> Amagara gangye nigategyereza MUKAMA,</para>
  <para style="q1" vid="PSA 130:6">Okukira oku abarinzi beetenga obusheeshe,</para>
  <para style="q1" vid="PSA 130:6">Eego, okukira oku abarinzi beetenga obusheeshe.<verse eid="PSA 130:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 131:3">Zab 131:3</ref>. </char>
    </note> Iwe Israeli, ta amatsiko gaawe ahari MUKAMA,</para>
  <para style="q1" vid="PSA 130:7">Ahakuba ahari MUKAMA hariho embabazi ezitahinduka;</para>
  <para style="q1" vid="PSA 130:7">Kandi ahariwe hariho okucungurwa kwingi;<verse eid="PSA 130:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">130:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 111:9">Zab 111:9</ref>; <ref loc="MAT 1:21">Mat 1:21</ref>; <ref loc="LUK 1:68">Luk 1:68</ref>; <ref loc="TIT 2:14">Tit 2:14</ref>. </char>
    </note> Na mbwenu aryacungura Israeli,</para>
  <para style="q1" vid="PSA 130:8">Amwiheho eby'okutahikiirira bye byona.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" sid="PSA 131" />
  <para style="s1">Omucureezi oku arikwesiga Ruhanga</para>
  <para style="d">Ekyeshongoro kya Daudi eky'okutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 131:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">131:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 101:5">Zab 101:5</ref>; <ref loc="PSA 138:6">138:6</ref>; <ref loc="JOB 42:3">Yob 42:3</ref>; <ref loc="JER 45:5">Yer 45:5</ref>; <ref loc="ROM 12:16">Rom 12:16</ref>. </char>
    </note> Ai MUKAMA, omutima gwangye tigugira maryo,</para>
  <para style="q1" vid="PSA 131:1">N'amaisho gangye tigeetenga by'ahaiguru,</para>
  <para style="q1" vid="PSA 131:1">Kandi tiinyeta ha bikuru, n'obu byakuba eby'okutangaaza ebi ntarikubaasa.<verse eid="PSA 131:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">131:2: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:3">Mat 18:3</ref>; <ref loc="1CO 14:20">1 Kor 14:20</ref>. </char>
    </note> Buzimazima ncureize omutima gwangye, naaguhunamya,</para>
  <para style="q1" vid="PSA 131:2">Nk'omwana ou nyina yaarembesereza, akamuha akabeere;</para>
  <para style="q1" vid="PSA 131:2">Omutima gwangye guri nk'omwana owaarembeserezibwa.<verse eid="PSA 131:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">131:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:7">Zab 130:7</ref>. </char>
    </note> Iwe Israeli, ta amatsiko ahari MUKAMA,</para>
  <para style="q1" vid="PSA 131:3">Okwiha hati okuhitsya ebiro byona.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" sid="PSA 132" />
  <para style="s1">Okusiima Mukama ahabw'okugarura eshanduukye y'endagaano omu mwanya gwayo</para>
  <para style="d">Ekyeshongoro eky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 132:1" />Ai MUKAMA, ijuka Daudi n'eby'okubonabona kwe byona;<verse eid="PSA 132:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:2: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 49:24">Kut 49:24</ref>; <ref loc="ISA 60:16">Isa 60:16</ref>. </char>
    </note> Oku yaarahiire ahari MUKAMA,</para>
  <para style="q1" vid="PSA 132:2">Akahiga ahari Ruhanga wa Yakobo ow'obushoboorozi bwona;<verse eid="PSA 132:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 132:3" />Naagira ati: Buzimazima tinditaaha hansi y'akanono k'enju yangye,</para>
  <para style="q1" vid="PSA 132:3">N'obu kwakuba okutemba ekitabo kyangye,<verse eid="PSA 132:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 132:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:4: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 6:4">Enf 6:4</ref>. </char>
    </note> Tindihumiza maisho gangye kugwejegyera,</para>
  <para style="q1" vid="PSA 132:4">N'obu kwakuba okuhungira,<verse eid="PSA 132:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 132:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:5: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 22:7">1 Bus 22:7</ref>; <ref loc="ACT 7:46">Byak 7:46</ref>. </char>
    </note> Okuhitsya obu nditungira MUKAMA omwanya,</para>
  <para style="q1" vid="PSA 132:5">Ahu Ruhanga wa Yakobo ow'obushoboorozi bwona arituura.<verse eid="PSA 132:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:6: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 7:1">1 Sam 7:1</ref>; <ref loc="1CH 13:5">1 Bus 13:5</ref>. </char>
    </note> Reeba, tukakihuriraho Efuraata,</para>
  <para style="q1" vid="PSA 132:6">Twakishanga Kiryasi-yearimu.<verse eid="PSA 132:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 99:5">Zab 99:5</ref>, <ref loc="PSA 99:8-9">8-9</ref>; <ref loc="2CH 6:41">2 Bus 6:41</ref>, <ref loc="2CH 6:42">42</ref>. </char>
    </note> Nibagira bati: Ka tutaahe omu mahema ge;</para>
  <para style="q1" vid="PSA 132:7">Turamize aha katebe k'ebigyere bye.<verse eid="PSA 132:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:61">Zab 78:61</ref>. </char>
    </note> Imuka, ai MUKAMA, oze omu buruhuukiro bwawe,</para>
  <para style="q1" vid="PSA 132:8">Iwe hamwe n'eshanduukye y'Amaani gaawe.<verse eid="PSA 132:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:14">Yob 29:14</ref>; <ref loc="ISA 61:10">Isa 61:10</ref>. </char>
    </note> Abanyamurwa baawe bajware eby'okuhikiirira;</para>
  <para style="q1" vid="PSA 132:9">N'abarikwera baawe bateere akaari k'okushemererwa.<verse eid="PSA 132:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10" />Ahabw'omwiru waawe Daudi,</para>
  <para style="q1" vid="PSA 132:10">Otabinga owaawe owaashukirweho amajuta.<verse eid="PSA 132:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:11, 12: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 2:4">1 Bag 2:4</ref>; <ref loc="1KI 8:25">8:25</ref>; <ref loc="2CH 6:16">2 Bus 6:16</ref>; <ref loc="PSA 89:3">Zab 89:3</ref>, <ref loc="PSA 89:4">4</ref>; <ref loc="PSA 110:4">110:4</ref>; <ref loc="LUK 1:32">Luk 1:32</ref>; <ref loc="ACT 2:30">Byak 2:30</ref>. </char>
    </note> MUKAMA akarahira Daudi omu mazima; tariita ndahiro;</para>
  <para style="q1" vid="PSA 132:11">Naagira ati: Ndyayemeka omwe aha baana b'enda yaawe,</para>
  <para style="q1" vid="PSA 132:11">Arye engoma yaawe.<verse eid="PSA 132:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12" />Abaana baawe ku baririnda endagaano yangye</para>
  <para style="q1" vid="PSA 132:12">N'ebi naahamize, ebi ndibeegyesa,</para>
  <para style="q1" vid="PSA 132:12">Abaana baabo nabo baryaguma aha ngoma yaawe ebiro byona.<verse eid="PSA 132:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:13, 14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:16">Zab 68:16</ref>; <ref loc="PSA 78:68">78:68</ref>; <ref loc="MAT 23:21">Mat 23:21</ref>. </char>
    </note> Ahakuba MUKAMA akeetooranira Saayuuni,</para>
  <para style="q1" vid="PSA 132:13">Yaayenda ku eba omwanya gwe gw'okutuuramu;<verse eid="PSA 132:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14" />Naagira ati: Nibwo buruhuukiro bwangye obw'ebiro byona;</para>
  <para style="q1" vid="PSA 132:14">Aha niho ndituura, ahakuba niho naayenzire.<verse eid="PSA 132:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15" />Buzimazima eby'okubagaburira ndyabiha omugisha mwingi,</para>
  <para style="q1" vid="PSA 132:15">Mpaazye abooro baayo eby'okurya.<verse eid="PSA 132:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:9">Zab 132:9</ref>. </char>
    </note> Abanyamurwa baayo nabo ndyabajweka okujunwa,</para>
  <para style="q1" vid="PSA 132:16">N'abarikwera baayo baryateera akaari k'okushemererwa.<verse eid="PSA 132:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:17: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 11:36">1 Bag 11:36</ref>; <ref loc="1KI 15:4">15:4</ref>; <ref loc="EZK 29:21">Ezk 29:21</ref>; <ref loc="LUK 1:69">Luk 1:69</ref>. </char>
    </note> Aho niho ndifunduurira Daudi eihembe;</para>
  <para style="q1" vid="PSA 132:17">Owangye ou naashukireho amajuta, nkamuteekateekyera etabaaza.<verse eid="PSA 132:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">132:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 8:22">Yob 8:22</ref>. </char>
    </note> Abazigu be ndyabajweka enshoni,</para>
  <para style="q1" vid="PSA 132:18">Kwonka we ekirunga kye kiryamumurinkaniraho.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" sid="PSA 133" />
  <para style="s1">Obumwe bw'ab'eishe-emwe</para>
  <para style="d">Ekyeshongoro kya Daudi eky'okutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">133:1: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:8">Kut 13:8</ref>; <ref loc="1CO 1:10">1 Kor 1:10</ref>. </char>
    </note> Reeba, ku kiri kirungi kandi ekirikushemeza,</para>
  <para style="q1" vid="PSA 133:1">Ab'eishe-emwe kutuura hamwe nibakwatanisa!<verse eid="PSA 133:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">133:2: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 29:7">Kur 29:7</ref>; <ref loc="LEV 8:12">Lev 8:12</ref>. </char>
    </note> Ni nk'amajuta g'obuguzi bwingi agaashukirwe aha mutwe gwa Arooni,</para>
  <para style="q1" vid="PSA 133:2">Gakaitururukira omu bireju bye,</para>
  <para style="q1" vid="PSA 133:2">Gakahika aha kitogi ky'ekijwaro kye,<verse eid="PSA 133:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">133:3: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 25:21">Lev 25:21</ref>; <ref loc="DEU 28:8">Bir 28:8</ref>; <ref loc="MAT 25:34">Mat 25:34</ref>; <ref loc="JHN 4:14">Yoh 4:14</ref>; <ref loc="JHN 17:3">17:3</ref>; <ref loc="1JN 5:11">1 Yoh 5:11</ref>. </char>
    </note> Nk'orume rwa Herumooni oruragarika aha bibungo bya Saayuuni;</para>
  <para style="q1" vid="PSA 133:3">Ahakuba aho niho MUKAMA yaaragiire ngu hagire omugisha,</para>
  <para style="q1" vid="PSA 133:3">Nigo magara ag'ebiro n'ebiro.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" sid="PSA 134" />
  <para style="s1">Okusiima Ruhanga kw'abarinzi ba hekalu ba nyekiro</para>
  <para style="d">Ekyeshongoro eky'abarikutemba omuri hekalu</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 134:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">134:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:1">Zab 135:1</ref>; <ref loc="1CH 9:33">1 Bus 9:33</ref>; <ref loc="1CH 23:30">23:30</ref>. </char>
    </note> Imwe abairu ba Mukama mwena, mumusiime,</para>
  <para style="q1" vid="PSA 134:1">Abeemerera omu nju ye nibagirinda nyekiro.<verse eid="PSA 134:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">134:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:2">Zab 28:2</ref>. </char>
    </note> Mwimutsye emikono yaanyu, mugyorekire Omwanya ogurikwera,</para>
  <para style="q1" vid="PSA 134:2">Kandi musiime MUKAMA.<verse eid="PSA 134:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">134:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:15">Zab 115:15</ref>; <ref loc="PSA 128:5">128:5</ref>. </char>
    </note> MUKAMA owaahangire eiguru n'ensi</para>
  <para style="q1" vid="PSA 134:3">Akuhe omugisha naayema omuri Saayuuni.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" sid="PSA 135" />
  <para style="s1">Okuhimbisa Mukama ahabw'obukuru bwe</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 135:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:35">Zab 104:35</ref>; <ref loc="PSA 113:1">113:1</ref>. </char>
    </note> Haleluya!</para>
  <para style="q1" vid="PSA 135:1">Muhimbise eiziina rya MUKAMA;</para>
  <para style="q1" vid="PSA 135:1">Imwe abairu ba MUKAMA, mumuhimbise!<verse eid="PSA 135:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:13">Zab 92:13</ref>; <ref loc="DEU 10:8">Bir 10:8</ref>. </char>
    </note> Imwe abeemerera omu nju ya MUKAMA,</para>
  <para style="q1" vid="PSA 135:2">Omu bikaari by'enju ya MUKAMA waitu!<verse eid="PSA 135:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:5">Zab 100:5</ref>; <ref loc="PSA 147:1">147:1</ref>. </char>
    </note> Haleluya, ahakuba ni murungi;</para>
  <para style="q1" vid="PSA 135:3">Mweshongore eby'okuhimbisa eiziina rye, ahakuba nirishemeza.<verse eid="PSA 135:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:4: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 19:5">Kur 19:5</ref>; <ref loc="DEU 7:6">Bir 7:6</ref>, <ref loc="DEU 7:7">7</ref>. </char>
    </note> Ahabw'okuba MUKAMA akeetooranira Yakobo,</para>
  <para style="q1" vid="PSA 135:4">Na Israeli okuba owe wenka.<verse eid="PSA 135:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:3">Zab 95:3</ref>; <ref loc="EXO 18:11">Kur 18:11</ref>. </char>
    </note> Nimmanya ngu MUKAMA ni mukuru,</para>
  <para style="q1" vid="PSA 135:5">Kandi MUKAMA waitu naakira baaruhanga boona.<verse eid="PSA 135:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:3">Zab 115:3</ref>. </char>
    </note> Eki MUKAMA akunda kyona, akikora</para>
  <para style="q1" vid="PSA 135:6">Omu iguru n'omu nsi n'omu nyanja n'omu myanya yoona eya hare okuzimu.<verse eid="PSA 135:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:7: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 38:22">Yob 38:22</ref>, <ref loc="JOB 38:25">25</ref>; <ref loc="JER 10:13">Yer 10:13</ref>; <ref loc="ZEC 10:1">Zek 10:1</ref>. </char>
    </note> Niwe aimutsya ebicu aha mbaju zoona ez'ensi;</para>
  <para style="q1" vid="PSA 135:7">Akareeta emirabyo ahabw'enjura;</para>
  <para style="q1" vid="PSA 135:7">Akashohoza omuyaga okuruga omu mabiikiro ge.<verse eid="PSA 135:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:51">Zab 78:51</ref>; <ref loc="EXO 12:29">Kur 12:29</ref>. </char>
    </note> Niwe yaateire emijigaijo ya Misri,</para>
  <para style="q1" vid="PSA 135:8">Ey'abantu n'ey'enyamaishwa;<verse eid="PSA 135:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:9: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:22">Bir 6:22</ref>. </char>
    </note> Akareeta obumanyiso n'eby'okutangaaza omuriiwe, Misri,</para>
  <para style="q1" vid="PSA 135:9">Ahari Faraaho n'abairu be boona.<verse eid="PSA 135:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:10-12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 136:17-22">Zab 136:17-22</ref>. </char>
    </note> Akateera amahanga maingi,</para>
  <para style="q1" vid="PSA 135:10">Yaita abagabe b'amaani,<verse eid="PSA 135:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:11: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-26">Kub 21:21-26</ref>, <ref loc="NUM 21:33-35">33-35</ref>; <ref loc="JOS 12:7-24">Yos 12:7-24</ref>. </char>
    </note> Sihooni, omugabe w'Abaamori, na Ogi omugabe wa Bashani,</para>
  <para style="q1" vid="PSA 135:11">N'amahanga goona aga Kanaani;<verse eid="PSA 135:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 23:4">Yos 23:4</ref>, <ref loc="JOS 23:5">5</ref>. </char>
    </note> Kandi yaagaba ensi yaabo kuba obuhunguzi,</para>
  <para style="q1" vid="PSA 135:12">Obuhunguzi bwa Israeli abantu be.<verse eid="PSA 135:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:12">Zab 102:12</ref>; <ref loc="EXO 3:15">Kur 3:15</ref>. </char>
    </note> Eiziina ryawe, ai MUKAMA, rigumaho ebiro byona;</para>
  <para style="q1" vid="PSA 135:13">Kandi ab'obusingye bwona baryaguma bakwijukye.<verse eid="PSA 135:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 90:13">Zab 90:13</ref>; <ref loc="DEU 32:36">Bir 32:36</ref>. </char>
    </note> Ahakuba MUKAMA aryacwera abantu be orubanja,</para>
  <para style="q1" vid="PSA 135:14">Agirire abairu be embabazi.<verse eid="PSA 135:14" /></para>
  <para style="s1">Oku ebishushani ebirikuramibwa bitaine mugasho</para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:15-18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:4-8">Zab 115:4-8</ref>. </char>
    </note> Ebishushani by'amahanga ebirikuramibwa n'efeeza n'ezaabu,</para>
  <para style="q1" vid="PSA 135:15">Ebikozirwe emikono y'abantu;<verse eid="PSA 135:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16" />Bigira eminwa, kwonka tibigamba;</para>
  <para style="q1" vid="PSA 135:16">Bigira amaisho, tibireeba;<verse eid="PSA 135:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17" />Bigira amatu, tibihurira;</para>
  <para style="q1" vid="PSA 135:17">Kandi tibigira mwitsyo mu kanwa kaabyo.<verse eid="PSA 135:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18" />Ababikora baryashusha nkabyo,</para>
  <para style="q1" vid="PSA 135:18">Kandi n'omuntu weena obyesiga.<verse eid="PSA 135:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:19, 20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:9-11">Zab 115:9-11</ref>. </char>
    </note> Imwe enju ya Israeli, siima MUKAMA!</para>
  <para style="q1" vid="PSA 135:19">Iwe enju ya Arooni, siima MUKAMA!<verse eid="PSA 135:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20" />Iwe enju ya Leevi, siima MUKAMA!</para>
  <para style="q1" vid="PSA 135:20">Naimwe abarikutiina MUKAMA, mumusiime!<verse eid="PSA 135:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">135:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 132:14">Zab 132:14</ref>. </char>
    </note> MUKAMA otuura omuri Yerusaalemu</para>
  <para style="q1" vid="PSA 135:21">Ahimbisizibwe omuri Saayuuni.</para>
  <para style="q1" vid="PSA 135:21">Haleluya!<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" sid="PSA 136" />
  <para style="d">Okusiima Ruhanga ahabw'embabazi ze n'oburungi bwe ebi yaakoreire Abaisraeli obu yaabaiha omuri Misri</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:1">Zab 106:1</ref>. </char>
    </note> Musiime MUKAMA, ahakuba ni murungi;</para>
  <para style="q1" vid="PSA 136:1">Kandi embabazi ze n'ez'ebiro byona.<verse eid="PSA 136:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:2, 3: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 10:17">Bir 10:17</ref>; <ref loc="REV 17:14">Kush 17:14</ref>. </char>
    </note> Musiime Ruhanga Nyamuhanga;</para>
  <para style="q1" vid="PSA 136:2">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3" />Musiime Mukama w'abakama;</para>
  <para style="q1" vid="PSA 136:3">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 72:18">Zab 72:18</ref>. </char>
    </note> Ogwo wenka akora eby'okutangaaza bikuru;</para>
  <para style="q1" vid="PSA 136:4">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:5: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:1">Kut 1:1</ref>; <ref loc="PRO 3:19">Enf 3:19</ref>; <ref loc="JER 10:12">Yer 10:12</ref>. </char>
    </note> Ogwo owaahangire eiguru n'obwengye;</para>
  <para style="q1" vid="PSA 136:5">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 24:2">Zab 24:2</ref>; <ref loc="GEN 1:6">Kut 1:6</ref>; <ref loc="ISA 42:5">Isa 42:5</ref>. </char>
    </note> Ogwo owaayazire ensi ahaiguru y'amaizi;</para>
  <para style="q1" vid="PSA 136:6">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:16">Kut 1:16</ref>. </char>
    </note> Ogwo owaahangire ebirikwaka ebikuru,</para>
  <para style="q1" vid="PSA 136:7">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8" />Eizooba okutegyeka nyomushana,</para>
  <para style="q1" vid="PSA 136:8">ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9" />Okwezi n'enyonyoozi okutegyeka nyekiro;</para>
  <para style="q1" vid="PSA 136:9">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:51">Zab 78:51</ref>; <ref loc="EXO 12:29">Kur 12:29</ref>. </char>
    </note> Ogwo owaateire emijigaijo ya Misri,</para>
  <para style="q1" vid="PSA 136:10">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:11: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:51">Kur 12:51</ref>. </char>
    </note> Akaiha Abaisraeli omuribo,</para>
  <para style="q1" vid="PSA 136:11">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12" />N'engaro z'amaani n'omukono ogubangire,</para>
  <para style="q1" vid="PSA 136:12">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:13, 14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:13">Zab 78:13</ref>; <ref loc="EXO 14:21">Kur 14:21</ref>, <ref loc="EXO 14:22">22</ref>. </char>
    </note> Ogwo owaacwiremu Enyanja erikutukura habiri,</para>
  <para style="q1" vid="PSA 136:13">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14" />Akarabya Abaisraeli ahagati yaayo,</para>
  <para style="q1" vid="PSA 136:14">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 14:27">Kur 14:27</ref>. </char>
    </note> Kwonka Faraaho n'eihe rye akabacwekyererezamu,</para>
  <para style="q1" vid="PSA 136:15">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:16: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 8:15">Bir 8:15</ref>. </char>
    </note> Ogwo owaayebembeire abantu be, akabarabya omu ihamba,</para>
  <para style="q1" vid="PSA 136:16">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:17-22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 135:10-12">Zab 135:10-12</ref>. </char>
    </note> Ogwo owaateire abagabe b'ekitiinisa,</para>
  <para style="q1" vid="PSA 136:17">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18" />Akaita abagabe rugambwa,</para>
  <para style="q1" vid="PSA 136:18">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19" />Sihooni omugabe w'Abaamori,</para>
  <para style="q2" vid="PSA 136:19">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20" />Na Ogi omugabe wa Bashani,</para>
  <para style="q1" vid="PSA 136:20">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21" />Akagaba ensi yaabo kuba obuhunguzi,</para>
  <para style="q1" vid="PSA 136:21">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22" />Obuhunguzi bw'omwiru we Israeli,</para>
  <para style="q1" vid="PSA 136:22">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23" />Ogwo owaatwijukire turi habi munonga,</para>
  <para style="q1" vid="PSA 136:23">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:2">Zab 107:2</ref>. </char>
    </note> Akatukiza abazigu baitu,</para>
  <para style="q1" vid="PSA 136:24">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:27">Zab 104:27</ref>. </char>
    </note> Ogwo oriisa ebiine omubiri byona,</para>
  <para style="q1" vid="PSA 136:25">Ahakuba embabazi ze n'ez'ebiro byona;<verse eid="PSA 136:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">136:26: </char>
      <char style="xt" closed="false">
        <ref loc="EZR 5:12">Ezr 5:12</ref>; <ref loc="NEH 1:4">Neh 1:4</ref>. </char>
    </note> Musiime Ruhanga ow'omu iguru;</para>
  <para style="q1" vid="PSA 136:26">Ahakuba embabazi ze n'ez'ebiro byona.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" sid="PSA 137" />
  <para style="s1">Obushaarizi obu enkwatwa zaarebire omuri Babulooni</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">137:1: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 1:1">Ezk 1:1</ref>. </char>
    </note> Aha rubaju rw'emigyera ya Babulooni tukashutama,</para>
  <para style="q1" vid="PSA 137:1">Twarira ahabw'okwijuka Saayuuni.<verse eid="PSA 137:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2" />Twahanika enanga zaitu aha biti,</para>
  <para style="q1" vid="PSA 137:2">Ebyabaire biri aha rubaju rw'egyo migyera.<verse eid="PSA 137:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3" />Ahakuba abaatunyagire, aho niho baaturagiririire kweshongora,</para>
  <para style="q1" vid="PSA 137:3">Kandi abaabaire nibatuboroozya, baaturagiira kusheka,</para>
  <para style="q1" vid="PSA 137:3">Nibagira bati: Mutweshongorere ekyeshongoro kimwe aha bya Saayuuni.<verse eid="PSA 137:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4" />Nitubaasa tuta kweshongora ekyeshongoro kya MUKAMA</para>
  <para style="q1" vid="PSA 137:4">Omu ihanga eritari ryaitu?<verse eid="PSA 137:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5" />Ku ndaakwebwe, iwe Yerusaalemu,</para>
  <para style="q1" vid="PSA 137:5">Omukono gwangye gwa buryo gukookoote.<verse eid="PSA 137:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">137:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 29:10">Yob 29:10</ref>; <ref loc="EZK 3:26">Ezk 3:26</ref>. </char>
    </note> Orurimi runyomere aha nkanka,</para>
  <para style="q1" vid="PSA 137:6">Ku ndaabe ntakwijukire,</para>
  <para style="q1" vid="PSA 137:6">Ntakunzire Yerusaalemu okukira ebirikunshemeza byona.<verse eid="PSA 137:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">137:7: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 4:21">Tonz 4:21</ref>, <ref loc="LAM 4:22">22</ref>; <ref loc="EZK 35:2">Ezk 35:2</ref>, <ref loc="EZK 35:15">15</ref>; <ref loc="AMO 1:11">Amo 1:11</ref>, <ref loc="AMO 1:12">12</ref>; <ref loc="OBA 1:8-14">Oba 8-14</ref>. </char>
    </note> Ai MUKAMA, ijuka eki Abanyedomu baakozire buri</para>
  <para style="q1" vid="PSA 137:7">Aha izooba rya Yerusaalemu, obu baagira bati:</para>
  <para style="q1" vid="PSA 137:7">Nimugisheenye, mugisheenye, muhikye aha misingi yaayo.<verse eid="PSA 137:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8" />Iwe Babulooni 'we, orikwija kuhwerekyerezibwa,</para>
  <para style="q1" vid="PSA 137:8">Orikuzimuurira nk'ebi waatugiriire, ahiiriirwe!<verse eid="PSA 137:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9" />Orikwata abaana baawe abato, akabateera aha nkiri,</para>
  <para style="q1" vid="PSA 137:9">Ahiiriirwe!<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" sid="PSA 138" />
  <para style="s1">Okusiima Ruhanga ahabw'emigisha ei aha abantu be abacureezi</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 138:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:3">Zab 95:3</ref>; <ref loc="PSA 111:1">111:1</ref>. </char>
    </note> Ndyakusiima n'omutima gangye gwona;</para>
  <para style="q1" vid="PSA 138:1">Omu maisho ga baaruhanga ndyayeshongora eby'okukuhimbisa.<verse eid="PSA 138:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 5:7">Zab 5:7</ref>. </char>
    </note> Ndyaramya, mpindukire ei hekalu yaawe erikwera eri,</para>
  <para style="q1" vid="PSA 138:2">Nsiime eiziina ryawe ahabw'embabazi zaawe ezitahinduka n'ahabw'amazima gaawe;</para>
  <para style="q1" vid="PSA 138:2">Ahabw'okuba okaha ekigambo kyawe ekitiinisa okukira ebindi byona.<verse eid="PSA 138:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3" />Aha izooba eri naakutakiriireho, okangarukamu,</para>
  <para style="q1" vid="PSA 138:3">Wangumya ahabw'okuha amagara gangye amaani.<verse eid="PSA 138:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:15">Zab 102:15</ref>. </char>
    </note> Abagabe boona ab'omu nsi baryakusingiza, ai MUKAMA;</para>
  <para style="q1" vid="PSA 138:4">Ahakuba bahuriire ebigambo by'omu kanwa kaawe.<verse eid="PSA 138:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5" />Kandi baryayeshongora eby'emitwarize ya MUKAMA,</para>
  <para style="q1" vid="PSA 138:5">ahakuba ekitiinisa kya MUKAMA ni kingi.<verse eid="PSA 138:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 113:5">Zab 113:5</ref>, <ref loc="PSA 113:6">6</ref>; <ref loc="PRO 3:34">Enf 3:34</ref>; <ref loc="LUK 1:48">Luk 1:48</ref>; <ref loc="JAS 4:6">Yak 4:6</ref>. </char>
    </note> Mumanye ngu MUKAMA, n'obu araabe ari ahaiguru munonga,</para>
  <para style="q1" vid="PSA 138:6">Ata omutima aha bacureezi;</para>
  <para style="q1" vid="PSA 138:6">Kwonka ab'amaryo abamanyira hare.<verse eid="PSA 138:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:4">Zab 23:4</ref>; <ref loc="PSA 71:20">71:20</ref>. </char>
    </note> N'obu ndaabe ningyenda enaku ziinyehinguririize,</para>
  <para style="q1" vid="PSA 138:7">Kwonka oryarinda amagara gangye.</para>
  <para style="q1" vid="PSA 138:7">Oryagorora omukono gwawe kurwanisa ekiniga ky'abazigu bangye,</para>
  <para style="q1" vid="PSA 138:7">Kandi omukono gwawe gwa buryo guryankiza.<verse eid="PSA 138:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">138:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 57:2">Zab 57:2</ref>; <ref loc="PHP 1:6">Fil 1:6</ref>; <ref loc="1CH 16:34">1 Bus 16:34</ref>. </char>
    </note> MUKAMA aryahikiiriza byona ebi yanteekateekyeire;</para>
  <para style="q1" vid="PSA 138:8">Embabazi zaawe, ai MUKAMA, n'ez'ebiro byona;</para>
  <para style="q1" vid="PSA 138:8">Otareka ebi waayekoreire n'emikono yaawe.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" sid="PSA 139" />
  <para style="s1">Oku Ruhanga amanya ebintu byona, kandi oku ataine hu arikwesherekwa</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 139:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:3">Zab 17:3</ref>; <ref loc="PSA 44:21">44:21</ref>; <ref loc="JER 12:3">Yer 12:3</ref>. </char>
    </note> Ai MUKAMA, okancaaka, wammanya.<verse eid="PSA 139:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:2: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 19:27">2 Bag 19:27</ref>; <ref loc="LAM 3:63">Tonz 3:63</ref>; <ref loc="MAT 9:4">Mat 9:4</ref>; <ref loc="JHN 2:24">Yoh 2:24</ref>, <ref loc="JHN 2:25">25</ref>. </char>
    </note> Noomanya emishutamire yangye, n'emyimukire yangye,</para>
  <para style="q1" vid="PSA 139:2">Omanyiire hare ebiteekateeko byangye.<verse eid="PSA 139:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 31:4">Yob 31:4</ref>. </char>
    </note> Orondoreza kimwe emigyendere yangye n'emibyamire yangye,</para>
  <para style="q1" vid="PSA 139:3">Kandi noomanya emihanda yangye yoona;<verse eid="PSA 139:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:4: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 4:13">Heb 4:13</ref>. </char>
    </note> Ahakuba orurimi rwangye ku ruba rutakashohoize kigambo,</para>
  <para style="q1" vid="PSA 139:4">Reeba MUKAMA, iwe oba waakimanyiire kimwe.<verse eid="PSA 139:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5" />Ondi omu maisho n'enyima,</para>
  <para style="q1" vid="PSA 139:5">Kandi ontaireho omukono gwawe.<verse eid="PSA 139:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 42:3">Yob 42:3</ref>; <ref loc="ROM 11:33">Rom 11:33</ref>. </char>
    </note> Okumanya nk'okwo nikuntangaaza kurengyesereize;</para>
  <para style="q1" vid="PSA 139:6">N'okw'ahaiguru munonga, tindikukubaasa.<verse eid="PSA 139:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 23:24">Yer 23:24</ref>; <ref loc="JON 1:3">Yon 1:3</ref>. </char>
    </note> Ndyayetantarira hi Omwoyo waawe?</para>
  <para style="q1" vid="PSA 139:7">Nari ndyahungira hi amaisho gaawe?<verse eid="PSA 139:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 26:6">Yob 26:6</ref>; <ref loc="PRO 15:11">Enf 15:11</ref>; <ref loc="AMO 9:2">Amo 9:2</ref>. </char>
    </note> Ku ndaatembe omu iguru, okwo niyo ori;</para>
  <para style="q1" vid="PSA 139:8">Ku ndaatinde ekitabo kyangye Okuzimu, reeba nayo oriyo.<verse eid="PSA 139:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9" />Ku ndaagurukise amapapa g'akasheeshe,</para>
  <para style="q1" vid="PSA 139:9">Naatuura aha muheru gw'enyanja,<verse eid="PSA 139:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 139:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:3">Zab 23:3</ref>. </char>
    </note> N'okwo nayo omukono gwawe guryanyebembera,</para>
  <para style="q1" vid="PSA 139:10">Omukono gwawe gwa buryo gunkwate.<verse eid="PSA 139:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:11: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 22:13">Yob 22:13</ref>, <ref loc="JOB 22:14">14</ref>. </char>
    </note> Ku ndaagire nti: Buzima omwirima nigwija kunshweka,</para>
  <para style="q1" vid="PSA 139:11">Kandi n'omushana oguunyehinguririize gube ekiro;<verse eid="PSA 139:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 139:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 34:22">Yob 34:22</ref>; <ref loc="DAN 2:22">Dan 2:22</ref>. </char>
    </note> Omwirima nagwo tigwine ki gukushereka;</para>
  <para style="q1" vid="PSA 139:12">Ahakuba ekiro kihweza nka nyomushana;</para>
  <para style="q1" vid="PSA 139:12">Omwirima n'omushana nikyo kimwe ahariiwe.<verse eid="PSA 139:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13" />Ahakuba niiwe waahangire ebicweka by'omunda yangye,</para>
  <para style="q1" vid="PSA 139:13">Okanteeranira omunda ya maawe.<verse eid="PSA 139:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:14: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 5:9">Yob 5:9</ref>. </char>
    </note> Ninkuhimbisa ahabw'okumpanga omu muringo gw'eihano kandi ogurikutangaaza;</para>
  <para style="q1" vid="PSA 139:14">Ebi waakozire n'eby'okutangaaza,</para>
  <para style="q1" vid="PSA 139:14">Kandi eby'omu mutima gwangye noobimanya gye buzima.<verse eid="PSA 139:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 10:8-11">Yob 10:8-11</ref>. </char>
    </note> Ekyemerero kyangye tikirakusherekirwe,</para>
  <para style="q1" vid="PSA 139:15">Ubu naabaire nimpangirwa omu mubonano,</para>
  <para style="q1" vid="PSA 139:15">Ninkorwa omu muringo ogutarikushobooroka omu myanya y'okuzimu ahansi y'ensi.<verse eid="PSA 139:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 139:16" />Amaisho gaawe gakaba gandeebera omunda, nkiri amaizi;</para>
  <para style="q1" vid="PSA 139:16">Omu kitabo kyawe hahandiikirwemu ebiro byangye byona,</para>
  <para style="q1" vid="PSA 139:16">Nk'oku byaragiirwe, hatakabaireho na kimwe.<verse eid="PSA 139:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:5">Zab 92:5</ref>. </char>
    </note> Ai Ruhanga, ebiteekateeko byawe ka n'eby'obuguzi bwingi ahariinye!</para>
  <para style="q1" vid="PSA 139:17">Ku orikubiteeranira hamwe ni bingi.<verse eid="PSA 139:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 40:5">Zab 40:5</ref>. </char>
    </note> Ku naakubibara, bikaakira omusheenyi obwingi.</para>
  <para style="q1" vid="PSA 139:18">Ku nsisiimuka, mba nkiri hamwe naiwe.<verse eid="PSA 139:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 6:8">Zab 6:8</ref>; <ref loc="ISA 11:4">Isa 11:4</ref>. </char>
    </note> Nkaahenwa ki, oita ababi, ai Ruhanga,</para>
  <para style="q1" vid="PSA 139:19">Abakunda kusheesha eshagama bandugaho,<verse eid="PSA 139:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:20: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:7">Kur 20:7</ref>; <ref loc="JUD 1:15">Yud 15</ref>. </char>
    </note> Abakugambaho kubi,</para>
  <para style="q1" vid="PSA 139:20">Abazigu baawe abarahirira busha eiziina ryawe.<verse eid="PSA 139:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:21, 22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:5">Zab 26:5</ref>. </char>
    </note> Ai MUKAMA, abakwanga timbanga?</para>
  <para style="q1" vid="PSA 139:21">Tingwerwa kubi abaimuka kukurwanisa?<verse eid="PSA 139:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22" />Nimbangira kimwe buzima;</para>
  <para style="q1" vid="PSA 139:22">Mbeeta abazigu bangye.<verse eid="PSA 139:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">139:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 26:2">Zab 26:2</ref>; <ref loc="JER 17:10">Yer 17:10</ref>. </char>
    </note> Oncaakye, ai Ruhanga, omanye omutima gwangye;</para>
  <para style="q1" vid="PSA 139:23">Ongyeze, omanye ebiteekateeko byangye;<verse eid="PSA 139:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24" />Oreebe omuriinye ku haraabe harimu emitwarize yoona emibi,</para>
  <para style="q1" vid="PSA 139:24">Haza onyebembere omu muhanda ogw'ebiro n'ebiro.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" sid="PSA 140" />
  <para style="s1">Okushaba okurindwa aha bantu abanyamwaga</para>
  <para style="d">Aha Mukuru w'abeeshongozi. Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 140:1" />Ai MUKAMA, onkize abantu babi;</para>
  <para style="q1" vid="PSA 140:1">Ondinde abanyamwaga,<verse eid="PSA 140:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:48">Zab 18:48</ref>. </char>
    </note> Abateekateeka enaama mbi omu mitima yaabo,</para>
  <para style="q1" vid="PSA 140:2">Abeeteerana obutoosha kurwana.<verse eid="PSA 140:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 52:2">Zab 52:2</ref>; <ref loc="PSA 58:4">58:4</ref>; <ref loc="ROM 3:13">Rom 3:13</ref>. </char>
    </note> Bashongoire orurimi rwabo nk'enjoka,</para>
  <para style="q1" vid="PSA 140:3">Omu minwa yaabo harimu obushegu bw'encwera. <char style="qs">Sela</char><verse eid="PSA 140:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 71:4">Zab 71:4</ref>. </char>
    </note> Ai MUKAMA, ondinde emikono y'ababi;</para>
  <para style="q1" vid="PSA 140:4">Ondinde abanyamwaga, abahanwire kutega ebigyere byangye.<verse eid="PSA 140:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 18:8-10">Yob 18:8-10</ref>; <ref loc="JER 18:22">Yer 18:22</ref>. </char>
    </note> Ab'amaryo bantegire omutego n'emigoye;</para>
  <para style="q1" vid="PSA 140:5">Bategire ekigoye aha muhanda,</para>
  <para style="q1" vid="PSA 140:5">Bantega orugogo. <char style="qs">Sela</char><verse eid="PSA 140:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:2">Zab 28:2</ref>. </char>
    </note> Naagira MUKAMA nti: Niiwe Ruhanga wangye;</para>
  <para style="q1" vid="PSA 140:6">Tega amatu eiraka ry'okweshengyereza kwangye, ai MUKAMA.<verse eid="PSA 140:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:8">Zab 28:8</ref>. </char>
    </note> Ai RUHANGA, Mukama wangye, Omujuni wangye ow'amaani,</para>
  <para style="q1" vid="PSA 140:7">Okakingira omutwe gwangye aha izooba ry'orugamba.<verse eid="PSA 140:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:25">Zab 35:25</ref>; <ref loc="JOB 5:12">Yob 5:12</ref>, <ref loc="JOB 5:13">13</ref>. </char>
    </note> Ai MUKAMA, otaikiriza kuha omubi ebi arikwetenga,</para>
  <para style="q1" vid="PSA 140:8">Kandi otamukwatsa kugumizamu n'enaama ye embi,</para>
  <para style="q1" vid="PSA 140:8">Arekye kwehimbisa. <char style="qs">Sela</char><verse eid="PSA 140:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:16">Zab 7:16</ref>. </char>
    </note> Abanyehinguririize nibeehimbisa;</para>
  <para style="q1" vid="PSA 140:9">Eitima ry'eminwa yaabo ribamareho;<verse eid="PSA 140:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:6">Zab 11:6</ref>. </char>
    </note> Amakara agarikwaka gabagweho;</para>
  <para style="q1" vid="PSA 140:10">Banagwe omu biina batarirugayo.<verse eid="PSA 140:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11" />Orikugambuura atarihama omu nsi;</para>
  <para style="q1" vid="PSA 140:11">Ekibi kihiigye omunyamwaga, kimuhwerekyereze.<verse eid="PSA 140:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 9:4">Zab 9:4</ref>; <ref loc="1KI 8:59">1 Bag 8:59</ref>. </char>
    </note> Nimmanya ngu MUKAMA aryatonganira abarikubonabonesibwa,</para>
  <para style="q1" vid="PSA 140:12">Arwanirire amazima g'abakyene.<verse eid="PSA 140:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">140:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 64:10">64:10</ref>. </char>
    </note> Buzimazima abahikiriire baryasiima eiziina ryawe;</para>
  <para style="q1" vid="PSA 140:13">N'ab'emitima egororokire baryatuura ah'ori.<verse eid="PSA 140:13" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" sid="PSA 141" />
  <para style="s1">Okushaba Ruhanga okuturinda ngu turekye kumuhemukaho</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 141:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 70:5">Zab 70:5</ref>. </char>
    </note> Ai MUKAMA, rahuka kumpikaho;</para>
  <para style="q1" vid="PSA 141:1">Ohurire eiraka ryangye, ku ndaakutakire!<verse eid="PSA 141:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:2: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 29:41">Kur 29:41</ref>; <ref loc="LUK 1:10">Luk 1:10</ref>; <ref loc="1TI 2:8">1 Tim 2:8</ref>; <ref loc="REV 5:8">Kush 5:8</ref>. </char>
    </note> Okushaba kwangye kube nk'omugaju omu maisho gaawe,</para>
  <para style="q1" vid="PSA 141:2">N'okwimutsya emikono yangye kube nk'ekitambo ky'omu mwabazyo.<verse eid="PSA 141:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:13">Zab 34:13</ref>. </char>
    </note> Ote omurinzi aha kanwa kangye, ai MUKAMA,</para>
  <para style="q1" vid="PSA 141:3">Kandi ogume noorinda omuryango gw'eminwa yangye!<verse eid="PSA 141:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:36">Zab 119:36</ref>; <ref loc="PRO 23:6">Enf 23:6</ref>; <ref loc="MAT 6:13">Mat 6:13</ref>. </char>
    </note> Otaanyikiriza kuta omutima aha kintu kyona ekibi,</para>
  <para style="q1" vid="PSA 141:4">Ndekye kuguma ninkora eby'okutahikiirira n'enkozi z'ebibi,</para>
  <para style="q1" vid="PSA 141:4">N'obu kwakuba okurya aha by'okurya byazo ebinuzire.<verse eid="PSA 141:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:4">Zab 109:4</ref>; <ref loc="PRO 9:8">Enf 9:8</ref>; <ref loc="PRO 27:6">27:6</ref>; <ref loc="ECC 7:5">Mub 7:5</ref>. </char>
    </note> Omuntu murungi anteere nari ampane n'embabazi;</para>
  <para style="q1" vid="PSA 141:5">Kwonka amajuta g'omubi gatarishukwa aha mutwe gwangye;</para>
  <para style="q1" vid="PSA 141:5">Ahakuba obutoosha nshaba nindwanisa emicwe yaabo emibi.<verse eid="PSA 141:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6" />Ku bariheebwayo omu mikono y'abaribacwera orubanja,</para>
  <para style="q1" vid="PSA 141:6">Obwo nibwo barimanya ngu ekigambo kya Ruhanga n'eky'amazima.<verse eid="PSA 141:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 53:5">Zab 53:5</ref>. </char>
    </note> Nk'oku omuhingi abanjura eitaka, akaritabira,</para>
  <para style="q1" vid="PSA 141:7">Nikwo amagufa gaabo garinaganagwa gatyo aha munwa gw'Okuzimu.<verse eid="PSA 141:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:1">Zab 11:1</ref>; <ref loc="PSA 25:15">25:15</ref>. </char>
    </note> Kwonka niiwe ntaireho amaisho, ai MUKAMA Ruhanga;</para>
  <para style="q1" vid="PSA 141:8">Niiwe nsheruramu obuhungiro; otantsiga ntaine kirinda!<verse eid="PSA 141:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:5">Zab 140:5</ref>. </char>
    </note> Ondinde omutego ogu bantegire,</para>
  <para style="q1" vid="PSA 141:9">N'orugogo rw'enkozi z'ebibi.<verse eid="PSA 141:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">141:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 7:15">Zab 7:15</ref>, <ref loc="PSA 7:16">16</ref>; <ref loc="EST 7:10">Est 7:10</ref>. </char>
    </note> K'ababi bagwe omu migoye ei bategire,</para>
  <para style="q1" vid="PSA 141:10">Haza nyowe nkire.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" sid="PSA 142" />
  <para style="s1">Okushaba kw'omuntu orikuhiigwa ataine kihwera</para>
  <para style="d">Zaaburi ei Daudi yaagunzire, n'okushaba kwe obu yaabaire ari omu nyanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 142:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 3:4">Zab 3:4</ref>; <ref loc="PSA 30:8">30:8</ref>. </char>
    </note> Ntakira MUKAMA n'eiraka ryangye;</para>
  <para style="q1" vid="PSA 142:1">Ngaruka mmweshengyereza naryo.<verse eid="PSA 142:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 26:16">Isa 26:16</ref>. </char>
    </note> Nshuka amaganya gangye omu maisho ge;</para>
  <para style="q1" vid="PSA 142:2">Kandi mmworeka enaku zangye.<verse eid="PSA 142:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:3">Zab 77:3</ref>; <ref loc="PSA 140:5">140:5</ref>. </char>
    </note> Omwoyo gwangye ku gwagwire enshazi,</para>
  <para style="q1" vid="PSA 142:3">Okamanya omuhanda gwangye.</para>
  <para style="q1" vid="PSA 142:3">Omu muhanda ogu ndabamu,</para>
  <para style="q1" vid="PSA 142:3">Nimwo bantegire omutego.<verse eid="PSA 142:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:11">Zab 31:11</ref>; <ref loc="PSA 69:20">69:20</ref>. </char>
    </note> Naareeba aha rubaju rwangye rwa buryo,</para>
  <para style="q1" vid="PSA 142:4">Kwonka naashanga hatariho orikuunyetaho;</para>
  <para style="q1" vid="PSA 142:4">Ntakiine h'okuhungira, hataine orikuntaho omutima.<verse eid="PSA 142:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:6">Zab 14:6</ref>; <ref loc="PSA 27:13">27:13</ref>; <ref loc="LAM 3:24">Tonz 3:24</ref>. </char>
    </note> Naakutakira, MUKAMA wangye; naagira nti: Niiwe buhungiro bwangye,</para>
  <para style="q1" vid="PSA 142:5">Kandi omugabo gwangye omu nsi y'abahuriire.<verse eid="PSA 142:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 17:1">Zab 17:1</ref>; <ref loc="PSA 18:17">18:17</ref>; <ref loc="PSA 79:8">79:8</ref>. </char>
    </note> Hurira okutaka kwangye; ahakuba ngarwirwe ahansi munonga.</para>
  <para style="p" vid="PSA 142:6">Onkize abarikumpiiga; ahakuba nibankiza amaani.<verse eid="PSA 142:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">142:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:6">Zab 13:6</ref>; <ref loc="ISA 42:7">Isa 42:7</ref>. </char>
    </note> Onyihe omu kihome, mbone kusiima eiziina ryawe,</para>
  <para style="q1" vid="PSA 142:7">Abahikiriire bamanye hamwe naanye,</para>
  <para style="q1" vid="PSA 142:7">Ku onkorera eby'embabazi.<verse eid="PSA 142:7" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" sid="PSA 143" />
  <para style="s1">Okushaba kw'omuntu enshoberwa okuhaburwa oku ashemereire kutwaza</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 143:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 140:6">Zab 140:6</ref>; <ref loc="1JN 1:9">1 Yoh 1:9</ref>. </char>
    </note> Hurira okushaba kwangye, ai MUKAMA; otegye okutu okweshengyereza kwangye;</para>
  <para style="q1" vid="PSA 143:1">Ahabw'okwesigwa kwawe n'okuhikiirira kwawe ongarukyemu.<verse eid="PSA 143:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:3">Zab 130:3</ref>; <ref loc="JOB 14:3">Yob 14:3</ref>; <ref loc="JOB 25:4">25:4</ref>; <ref loc="ECC 7:20">Mub 7:20</ref>; <ref loc="ROM 3:23">Rom 3:23</ref>; <ref loc="1CO 4:4">1 Kor 4:4</ref>. </char>
    </note> Otacwera omwiru waawe orubanja;</para>
  <para style="q1" vid="PSA 143:2">ahabw'okuba omu maisho gaawe tihariho muntu weena ohuriire orisinga orubanja.<verse eid="PSA 143:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:3-6">Zab 88:3-6</ref>; <ref loc="LAM 3:6">Tonz 3:6</ref>. </char>
    </note> Noomanya ngu omuzigu wangye ampiigire,</para>
  <para style="q1" vid="PSA 143:3">Yaateera amagara gangye ahansi;</para>
  <para style="q1" vid="PSA 143:3">Yanshutamya omu kizima, nk'abaafiire ira.<verse eid="PSA 143:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:3">Zab 77:3</ref>. </char>
    </note> Nikyo omwoyo gwangye gurikugwera enshazi omunda yangye,</para>
  <para style="q1" vid="PSA 143:4">N'omutima gwangye gukeeshobera.<verse eid="PSA 143:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 77:5">Zab 77:5</ref>, <ref loc="PSA 77:11">11</ref>, <ref loc="PSA 77:12">12</ref>. </char>
    </note> Niinyijuka ebiro ebya ira; nguma ninteekateeka ahari byona ebi okora;</para>
  <para style="q1" vid="PSA 143:5">Ninteekateeka aha bi emikono yaawe yaakozire.<verse eid="PSA 143:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 42:2">Zab 42:2</ref>; <ref loc="PSA 63:1">63:1</ref>; <ref loc="JOB 11:13">Yob 11:13</ref>. </char>
    </note> Nkutegire emikono;</para>
  <para style="q1" vid="PSA 143:6">Omutima gwangye gukwiniire eiriho, nk'ori omu nsi eyomire.</para>
  <para style="p" vid="PSA 143:6">Sera<verse eid="PSA 143:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 27:9">Zab 27:9</ref>; <ref loc="PSA 28:1">28:1</ref>; <ref loc="PSA 69:17">69:17</ref>. </char>
    </note> Rahuka kungarukamu, ai MUKAMA, omwoyo gwangye nigugwa enshazi;</para>
  <para style="q1" vid="PSA 143:7">Otaanyima amaisho, nkaba nk'abarikushuuma Okuzimu.<verse eid="PSA 143:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:1">Zab 25:1</ref>, <ref loc="PSA 25:4">4</ref>; <ref loc="PSA 90:14">90:14</ref>. </char>
    </note> Ompurize omu kasheeshe eby'embabazi zaawe ezitahinduka;</para>
  <para style="q1" vid="PSA 143:8">Ahakuba niiwe nyesiga.</para>
  <para style="q1" vid="PSA 143:8">Ompabure omuhanda ogu nshemereire kurabamu,</para>
  <para style="q1" vid="PSA 143:8">Ahakuba niiwe nyimukiza omutima.<verse eid="PSA 143:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 59:1">Zab 59:1</ref>. </char>
    </note> Onkize abazigu bangye, ai MUKAMA!</para>
  <para style="q1" vid="PSA 143:9">Niiwe mpungiireho ntakwakwa.<verse eid="PSA 143:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 23:3">Zab 23:3</ref>; <ref loc="PSA 119:12">119:12</ref>; <ref loc="NEH 9:20">Neh 9:20</ref>; <ref loc="ISA 26:10">Isa 26:10</ref>. </char>
    </note> Onyegyese kukora ebi okunda,</para>
  <para style="q1" vid="PSA 143:10">Ahakuba niiwe Ruhanga wangye;</para>
  <para style="q1" vid="PSA 143:10">Omwoyo waawe omurungi anyebembere omu muhanda oguringaniire.<verse eid="PSA 143:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 25:11">Zab 25:11</ref>; <ref loc="PSA 71:20">71:20</ref>. </char>
    </note> Ompimbuure, ai MUKAMA, ahabw'eiziina ryawe;</para>
  <para style="q1" vid="PSA 143:11">Ahabw'okuhikiirira kwawe onyihe omu naku!<verse eid="PSA 143:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">143:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 54:5">Zab 54:5</ref>; <ref loc="PSA 116:16">116:16</ref>. </char>
    </note> Ahabw'embabazi zaawe ezitahinduka cwekyereza abazigu bangye;</para>
  <para style="q1" vid="PSA 143:12">Kandi omareho boona abarikubonabonesa amagara gangye;</para>
  <para style="q1" vid="PSA 143:12">Ahabw'okuba ndi omwiru waawe.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" sid="PSA 144" />
  <para style="s1">Okushaba kw'omurwani orikwesiga Mukama</para>
  <para style="d">Zaaburi ya Daudi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 144:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:31">Zab 18:31</ref>, <ref loc="PSA 18:34">34</ref>. </char>
    </note> MUKAMA orukiri rwangye ahimbisibwe,</para>
  <para style="q1" vid="PSA 144:1">Oyegyese emikono yangye kurashana, n'engaro zangye kurwana;<verse eid="PSA 144:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:2">Zab 18:2</ref>, <ref loc="PSA 18:47">47</ref>. </char>
    </note> Niwe rukiri rwangye, n'orugo rwangye orugumire;</para>
  <para style="q1" vid="PSA 144:2">Omunaara gwangye omuraingwa, kandi omujuni wangye;</para>
  <para style="q1" vid="PSA 144:2">Engabo yangye, kandi ou nyesiga,</para>
  <para style="q1" vid="PSA 144:2">Ongomoorera abantu bangye.<verse eid="PSA 144:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:4">Zab 8:4</ref>. </char>
    </note> Omuntu ni kintu ki Iwe okumwijuka,</para>
  <para style="q1" vid="PSA 144:3">Nari shi omwana w'omuntu Iwe okumuteekateekaho?<verse eid="PSA 144:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 39:5">Zab 39:5</ref>; <ref loc="PSA 102:11">102:11</ref>. </char>
    </note> Omuntu ni nk'omwitsyo;</para>
  <para style="q1" vid="PSA 144:4">Ebiro bye ni nk'ekibunda ekirikuhwaho.<verse eid="PSA 144:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:9">Zab 18:9</ref>; <ref loc="PSA 104:32">104:32</ref>; <ref loc="ISA 64:1">Isa 64:1</ref>. </char>
    </note> Ai MUKAMA, inamya eiguru ryawe, oshuume;</para>
  <para style="q1" vid="PSA 144:5">Okore aha bibungo, bicumbe omwika.<verse eid="PSA 144:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:14">Zab 18:14</ref>. </char>
    </note> Yohereza emirabyo y'enkuba, obataataanise;</para>
  <para style="q1" vid="PSA 144:6">Orashe emyambi yaawe, obabingye.<verse eid="PSA 144:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 18:16">Zab 18:16</ref>; <ref loc="PSA 69:14">69:14</ref>. </char>
    </note> Gorora omukono gwawe nooyema ahaiguru;</para>
  <para style="q1" vid="PSA 144:7">Onjune, onyihe omu maizi maingi,</para>
  <para style="q1" vid="PSA 144:7">Omu mikono y'abanyamahanga;<verse eid="PSA 144:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 12:2">Zab 12:2</ref>; <ref loc="ISA 62:8">Isa 62:8</ref>. </char>
    </note> Akanwa kaabo kagamba ebitaine mugasho,</para>
  <para style="q1" vid="PSA 144:8">N'omukono gwabo gwa buryo n'ogw'ebishuba.<verse eid="PSA 144:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:2">Zab 33:2</ref>, <ref loc="PSA 33:3">3</ref>. </char>
    </note> Ai Ruhanga, naaza kukweshongorera ekyeshongoro kisya,</para>
  <para style="q1" vid="PSA 144:9">Nyeshongore eby'okukuhimbisa ninteera enanga y'emirya ikumi.<verse eid="PSA 144:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10" />Niiwe oha abagabe obusinguzi,</para>
  <para style="q1" vid="PSA 144:10">Okakiza omwiru waawe Daudi rurara erikwita kubi.<verse eid="PSA 144:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11" />Onjune, onyihe omu mikono y'abanyamahanga,</para>
  <para style="q1" vid="PSA 144:11">Abu akanwa kaabo kagamba ebitaine mugasho,</para>
  <para style="q1" vid="PSA 144:11">N'omukono gwabo gwa buryo gukaba ogw'ebishuba.<verse eid="PSA 144:11" /></para>
  <para style="s1">Okushaba Ruhanga emigisha y'omu maka</para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 128:3">Zab 128:3</ref>; <ref loc="LEV 26:3-10">Lev 26:3-10</ref>. </char>
    </note> Nkaabaasibwa ki, batabani baitu bakura nk'emiti erikunyeeta omu butsigazi bwabo;</para>
  <para style="q1" vid="PSA 144:12">Bahara baitu baba nk'amabaare agabaizirwe kwombeka nyaruju;<verse eid="PSA 144:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13" />N'ebitara byaitu biijura eby'okurya by'emiringo yoona;</para>
  <para style="q1" vid="PSA 144:13">Entaama zaitu zizaara enkumi n'obukumi omu mariisizo gaitu;<verse eid="PSA 144:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:11">Isa 24:11</ref>. </char>
    </note> Ente zaitu zihaka, zireka kutorooga;</para>
  <para style="q1" vid="PSA 144:14">Hareka kugira abaasheenya orugo, bakataaha,</para>
  <para style="q1" vid="PSA 144:14">Nari abaashohora kuza kurwana;</para>
  <para style="q1" vid="PSA 144:14">N'obu kwakuba okuboroogyera omu bihandagazi byaitu!<verse eid="PSA 144:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">144:15: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:12">Zab 33:12</ref>; <ref loc="PSA 146:5">146:5</ref>; <ref loc="DEU 33:29">Bir 33:29</ref>. </char>
    </note> Eihanga eryakuba rityo rikaaba rihiiriirwe!</para>
  <para style="q1" vid="PSA 144:15">Eego, eihanga eri Ruhanga waaryo aba Yehova rihiiriirwe!<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" sid="PSA 145" />
  <para style="s1">Okuhimbisa Ruhanga ahabw'obukuru bwe n'oburungi bwe</para>
  <para style="d">Ekyeshongoro kya Daudi eky'okuhimbisa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 145:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 99:5">Zab 99:5</ref>; <ref loc="PSA 146:2">146:2</ref>. </char>
    </note> Ndyakuhimbisa, ai Ruhanga wangye kandi Omugabe wangye;</para>
  <para style="q1" vid="PSA 145:1">Ndyasiima eiziina ryawe ebiro byona.<verse eid="PSA 145:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2" />Buri izooba ndyakusiima,</para>
  <para style="q1" vid="PSA 145:2">Mpimbise eiziina ryawe ebiro n'ebiro.<verse eid="PSA 145:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 48:1">Zab 48:1</ref>; <ref loc="ISA 40:28">Isa 40:28</ref>. </char>
    </note> MUKAMA ni mukuru, kandi ashemereire kuhimbisibwa munonga,</para>
  <para style="q1" vid="PSA 145:3">Obukuru bwe tibwetegyerezibwa.<verse eid="PSA 145:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:24">Bir 3:24</ref>; <ref loc="ISA 38:19">Isa 38:19</ref>. </char>
    </note> Ab'obusingye bumwe baryagambira ab'obundi busingye, nibasiima emirimo yaawe,</para>
  <para style="q1" vid="PSA 145:4">Kandi bamanyise eby'amaani ebi waakozire.<verse eid="PSA 145:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5" />Ndyagamba aha burungi bw'ekitiinisa ky'obukuru bwawe,</para>
  <para style="q1" vid="PSA 145:5">Ngume ninteekateeka aha mirimo yaawe y'okutangaaza.<verse eid="PSA 145:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:4">Zab 78:4</ref>. </char>
    </note> Abantu baryagamba aha maani g'ebirikutiinisa ebi okora;</para>
  <para style="q1" vid="PSA 145:6">Kandi naanye ndyagamba aha bukuru bwawe.<verse eid="PSA 145:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:7">Isa 63:7</ref>. </char>
    </note> Baryagamba munonga aha kurangaanwa kw'oburungi bwawe obwingi,</para>
  <para style="q1" vid="PSA 145:7">Beeshongore eby'okuhikiirira kwawe.<verse eid="PSA 145:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 86:15">Zab 86:15</ref>; <ref loc="EXO 34:6">Kur 34:6</ref>. </char>
    </note> MUKAMA n'owembabazi kandi n'omunyasaasi buzima,</para>
  <para style="q1" vid="PSA 145:8">Tarahuka kuguubwa kubi, kandi aine okusaasira kwingi.<verse eid="PSA 145:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 100:5">Zab 100:5</ref>; <ref loc="MAT 5:45">Mat 5:45</ref>. </char>
    </note> MUKAMA ni murungi ahari boona,</para>
  <para style="q1" vid="PSA 145:9">Kandi agira embabazi nyingi ahari byona ebi yaahangire.<verse eid="PSA 145:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 19:1">Zab 19:1</ref>; <ref loc="PSA 103:22">103:22</ref>. </char>
    </note> Ai MUKAMA, ebi waahangire byona biryakuhimbisa,</para>
  <para style="q1" vid="PSA 145:10">N'abarikwera baawe baryakusingiza.<verse eid="PSA 145:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11" />Baryagamba aha kitiinisa ky'obukama bwawe,</para>
  <para style="q1" vid="PSA 145:11">Bagambe aha by'obushoboorozi bwawe,<verse eid="PSA 145:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:1">Zab 105:1</ref>. </char>
    </note> Okumanyisa abantu eby'amaani ebi okora,</para>
  <para style="q1" vid="PSA 145:12">N'ekitiinisa ky'obukuru bw'obukama bwawe.<verse eid="PSA 145:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:16">Zab 10:16</ref>; <ref loc="DAN 4:34">Dan 4:34</ref>. </char>
    </note> Obukama bwawe n'obukama bw'ebiro byona,</para>
  <para style="q1" vid="PSA 145:13">N'obutegyeki bwawe buryagumaho obusingye bwona.<verse eid="PSA 145:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 37:24">Zab 37:24</ref>; <ref loc="PSA 146:8">146:8</ref>. </char>
    </note> MUKAMA aramira boona abarikugwa,</para>
  <para style="q1" vid="PSA 145:14">Kandi aimutsya boona abeyinamiriire.<verse eid="PSA 145:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:15, 16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:27">Zab 104:27</ref>, <ref loc="PSA 104:28">28</ref>. </char>
    </note> Ebintu byona bikutega amaisho,</para>
  <para style="q1" vid="PSA 145:15">Naiwe obiha eby'okurya omu bunaku obuhikire.<verse eid="PSA 145:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16" />Oshashaanura engaro zaawe,</para>
  <para style="q1" vid="PSA 145:16">Ohaazya ekintu kyona ekihuriire ebi kirikwetenga.<verse eid="PSA 145:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:17: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:5">Zab 116:5</ref>. </char>
    </note> MUKAMA n'ohikiriire omu mitwarize ye yoona,</para>
  <para style="q1" vid="PSA 145:17">Kandi ow'embabazi omu bi akora byona.<verse eid="PSA 145:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:151">Zab 119:151</ref>; <ref loc="DEU 4:7">Bir 4:7</ref>; <ref loc="JHN 4:23">Yoh 4:23</ref>, <ref loc="JHN 4:24">24</ref>; <ref loc="JAS 4:8">Yak 4:8</ref>. </char>
    </note> MUKAMA ari haihi na boona abamutakira,</para>
  <para style="q1" vid="PSA 145:18">Boona abamutakira omu mazima.<verse eid="PSA 145:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 31:22">Zab 31:22</ref>; <ref loc="PRO 10:24">Enf 10:24</ref>; <ref loc="JHN 9:31">Yoh 9:31</ref>; <ref loc="1JN 5:14">1 Yoh 5:14</ref>. </char>
    </note> Abarikumutiina aryabamarira ebi barikwetenga,</para>
  <para style="q1" vid="PSA 145:19">Kandi aryahurira okutaka kwabo, abajune.<verse eid="PSA 145:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 97:10">Zab 97:10</ref>. </char>
    </note> MUKAMA arinda boona abarikumukunda;</para>
  <para style="q1" vid="PSA 145:20">Kwonka ababi boona aryabahwerekyereza.<verse eid="PSA 145:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">145:21: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 150:6">Zab 150:6</ref>. </char>
    </note> Akanwa kangye karyagamba eby'okuhimbisa MUKAMA;</para>
  <para style="q1" vid="PSA 145:21">Ebiine omubiri byona bisiime eiziina rye eririkwera ebiro n'ebiro.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" sid="PSA 146" />
  <para style="s1">Oku Ruhanga ari Omuhwezi w'abantu boona</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1" />Haleluya</para>
  <para style="q1" vid="PSA 146:1">Himbisa MUKAMA, iwe magara gangye!<verse eid="PSA 146:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:4">Zab 63:4</ref>; <ref loc="PSA 104:33">104:33</ref>. </char>
    </note> Ndyayeshongorera MUKAMA, nkiri ohuriire,</para>
  <para style="q1" vid="PSA 146:2">Nyeshongorere Ruhanga eby'okuhimbisa, nkiriho.<verse eid="PSA 146:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 60:11">Zab 60:11</ref>; <ref loc="PSA 118:8">118:8</ref>, <ref loc="PSA 118:9">9</ref>; <ref loc="JER 17:5">Yer 17:5</ref>. </char>
    </note> Mutaryesiga abanyiginya,</para>
  <para style="q1" vid="PSA 146:3">N'obu yaakuba omuntu, otaine kuhwera kwona.<verse eid="PSA 146:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:29">Zab 104:29</ref>; <ref loc="JOB 34:14">Yob 34:14</ref>, <ref loc="JOB 34:15">15</ref>. </char>
    </note> Omwitsyo ku gumuhwamu, agaruka omu itaka;</para>
  <para style="q1" vid="PSA 146:4">Eryo izooba ebiteekateeko bye bihwaho.<verse eid="PSA 146:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 144:15">Zab 144:15</ref>; <ref loc="JER 17:7">Yer 17:7</ref>. </char>
    </note> Omuntu ahiiriirwe, ou Ruhanga wa Yakobo aba Muhwezi we,</para>
  <para style="q1" vid="PSA 146:5">Kandi ota amatsiko ahari MUKAMA Ruhanga we,<verse eid="PSA 146:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 115:15">Zab 115:15</ref>; <ref loc="PSA 117:2">117:2</ref>; <ref loc="REV 14:7">Kush 14:7</ref>. </char>
    </note> Owaahangire eiguru n'ensi, enyanja na byona ebirimu,</para>
  <para style="q1" vid="PSA 146:6">Otuura ari omwesigwa ebiro byona,<verse eid="PSA 146:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:6">Zab 103:6</ref>; <ref loc="PSA 107:9">107:9</ref>; <ref loc="ISA 61:1">Isa 61:1</ref>. </char>
    </note> Ocwera abarikubonabonesibwa emanja z'oburyo;</para>
  <para style="q1" vid="PSA 146:7">Oha abaine enjara eby'okurya.</para>
  <para style="q1" vid="PSA 146:7">MUKAMA akomorora embohe;<verse eid="PSA 146:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:7">Zab 11:7</ref>; <ref loc="PSA 145:14">145:14</ref>; <ref loc="MAT 9:30">Mat 9:30</ref>; <ref loc="JHN 9:7">Yoh 9:7</ref>. </char>
    </note> MUKAMA ahumuura empumi;</para>
  <para style="q1" vid="PSA 146:8">MUKAMA aimutsya abeyinamiriire;</para>
  <para style="q1" vid="PSA 146:8">MUKAMA akunda abahikiriire.<verse eid="PSA 146:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 147:6">Zab 147:6</ref>; <ref loc="DEU 10:18">Bir 10:18</ref>; <ref loc="EXO 22:21">Kur 22:21</ref>, <ref loc="EXO 22:22">22</ref>. </char>
    </note> MUKAMA arinda abashuhuuki,</para>
  <para style="q1" vid="PSA 146:9">Aramira abafaakazi n'efuuzi,</para>
  <para style="q1" vid="PSA 146:9">Kwonka omuhanda gw'ababi agwitira kimwe.<verse eid="PSA 146:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">146:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 10:16">Zab 10:16</ref>. </char>
    </note> MUKAMA aryategyeka ebiro byona;</para>
  <para style="q1" vid="PSA 146:10">Iwe Saayuni, Ruhanga waawe aryategyeka okuhitsya obusingye bwona.</para>
  <para style="q1" vid="PSA 146:10">Haleluya!<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" sid="PSA 147" />
  <para style="s1">Okusiima Ruhanga ahabw'amaani ge n'ebirungi ebi yaakoreire Abaisraeli</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 147:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 92:1">Zab 92:1</ref>. </char>
    </note> Haleluya!</para>
  <para style="q1" vid="PSA 147:1">Ahakuba ni kirungi okweshongorera Ruhanga waitu eby'okuhimbisa;</para>
  <para style="q1" vid="PSA 147:1">Ahabw'okuba n'ow'embabazi, kandi okuhimbisa kuhikire.<verse eid="PSA 147:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:16">Zab 102:16</ref>; <ref loc="DEU 30:3">Bir 30:3</ref>; <ref loc="ISA 11:12">Isa 11:12</ref>; <ref loc="ISA 56:8">56:8</ref>. </char>
    </note> MUKAMA ayombeka busya Yerusaalemu,</para>
  <para style="q1" vid="PSA 147:2">Ataruura Abaisraeli abaabingirwe.<verse eid="PSA 147:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 34:18">Zab 34:18</ref>; <ref loc="ISA 61:1">Isa 61:1</ref>. </char>
    </note> Akiza ab'emitima ehendekire,</para>
  <para style="q1" vid="PSA 147:3">Ashemba obuhuta bwabo.<verse eid="PSA 147:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:4: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 15:5">Kut 15:5</ref>; <ref loc="ISA 40:26">Isa 40:26</ref>. </char>
    </note> Amanya obwingi bw'enyonyoozi,</para>
  <para style="q1" vid="PSA 147:4">Zoona azeeta amaziina gaazo<verse eid="PSA 147:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:5: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:28">Isa 40:28</ref>; <ref loc="NAM 1:3">Nah 1:3</ref>. </char>
    </note> MUKAMA waitu ni mukuru, kandi n'ow'obushoboorozi bwingi;</para>
  <para style="q1" vid="PSA 147:5">Okwetegyereza kwe kurengire orugyero.<verse eid="PSA 147:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 146:8">Zab 146:8</ref>, <ref loc="PSA 146:9">9</ref>. </char>
    </note> MUKAMA akwatirira abacureezi;</para>
  <para style="q1" vid="PSA 147:6">Kwonka ababi abanagira kimwe ahansi.<verse eid="PSA 147:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:1">Zab 95:1</ref>, <ref loc="PSA 95:2">2</ref>; <ref loc="1CH 15:16">1 Bus 15:16</ref>; <ref loc="EPH 5:19">Efe 5:19</ref>. </char>
    </note> Mweshongorere MUKAMA n'okusiima;</para>
  <para style="q1" vid="PSA 147:7">Mweshongorere Ruhanga waitu n'enanga!<verse eid="PSA 147:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:14">Zab 104:14</ref>; <ref loc="JOB 5:10">Yob 5:10</ref>. </char>
    </note> Niwe ashweka eiguru ebicu, akateekateekyera ensi enjura,</para>
  <para style="q1" vid="PSA 147:8">Kandi akameza obunyaatsi aha migongo.<verse eid="PSA 147:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:9: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:27">Zab 104:27</ref>, <ref loc="PSA 104:28">28</ref>; <ref loc="JOB 38:41">Yob 38:41</ref>; <ref loc="MAT 6:26">Mat 6:26</ref>. </char>
    </note> Aha enyamaishwa eby'okurya byazo,</para>
  <para style="q1" vid="PSA 147:9">Kandi ariisa abaana b'ebikoona abarikwaniira.<verse eid="PSA 147:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:17">Zab 33:17</ref>. </char>
    </note> Tayesiimira maani g'embaraasi,</para>
  <para style="q1" vid="PSA 147:10">N'amaguru g'omuntu tigo ashemerererwa,<verse eid="PSA 147:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:18">Zab 33:18</ref>; <ref loc="PSA 149:4">149:4</ref>. </char>
    </note> Kureka MUKAMA ashemerererwa abarikumutiina,</para>
  <para style="q1" vid="PSA 147:11">Bakeesiga embabazi ze ezitahinduka.<verse eid="PSA 147:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12" />Iwe Yerusaalemu, himbisa MUKAMA!</para>
  <para style="q1" vid="PSA 147:12">Naiwe Saayuuni, himbisa Ruhanga waawe!<verse eid="PSA 147:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13" />Ahakuba akagumya empimbi z'amarembo gaawe;</para>
  <para style="q1" vid="PSA 147:13">N'abaana baawe abari omuriiwe yaabaha omugisha.<verse eid="PSA 147:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:14: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 81:16">Zab 81:16</ref>; <ref loc="EXO 34:24">Kur 34:24</ref>; <ref loc="ISA 60:17">Isa 60:17</ref>, <ref loc="ISA 60:18">18</ref>. </char>
    </note> Areeta obusingye omunda y'emyatano yaawe;</para>
  <para style="q1" vid="PSA 147:14">Akwijuza engano nungi munonga.<verse eid="PSA 147:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15" />Atweka ekiragiro kye ahansi;</para>
  <para style="q1" vid="PSA 147:15">Ekigambo kye kiirukanga munonga.<verse eid="PSA 147:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:16: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 37:6">Yob 37:6</ref>; <ref loc="JOB 38:29">38:29</ref>. </char>
    </note> Agwisa ebirika nk'ebyoya;</para>
  <para style="q1" vid="PSA 147:16">Amaamagiza ekime ky'embeho nk'eiju.<verse eid="PSA 147:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:17: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 37:9">Yob 37:9</ref>, <ref loc="JOB 37:10">10</ref>. </char>
    </note> Anaga orubaare rwe nk'oburagarika.</para>
  <para style="q1" vid="PSA 147:17">N'oha owaakubaasa kwemera embeho ye?<verse eid="PSA 147:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18" />Atweka ekigambo kye, abiyazya;</para>
  <para style="q1" vid="PSA 147:18">Ahuuhisa omuyaga gwe, amaizi gagyenda.<verse eid="PSA 147:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:19: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 33:4">Bir 33:4</ref>; <ref loc="MAL 4:4">Mal 4:4</ref>; <ref loc="ROM 3:2">Rom 3:2</ref>. </char>
    </note> Amanyisa Yakobo ekigambo kye,</para>
  <para style="q1" vid="PSA 147:19">Na Israeli amumanyisa ebiragiro bye n'emicwere ye.<verse eid="PSA 147:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">147:20: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:32-34">Bir 4:32-34</ref>. </char>
    </note> Tihariho ihanga erindi ryona eri aragizire atyo;</para>
  <para style="q1" vid="PSA 147:20">Kandi n'emicwere ye tibakagimanyaga.</para>
  <para style="q1" vid="PSA 147:20">Haleluya!<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" sid="PSA 148" />
  <para style="s1">Oku ebintu byona ebyahangirwe bishemereire kuhimbisa Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:34">Zab 69:34</ref>; <ref loc="MAT 21:9">Mat 21:9</ref>. </char>
    </note> Haleluya!</para>
  <para style="q1" vid="PSA 148:1">Imwe ab'omu iguru, muhimbise MUKAMA,</para>
  <para style="q1" vid="PSA 148:1">Naimwe abari omu myanya y'ahaiguru mumuhimbise!<verse eid="PSA 148:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:20">Zab 103:20</ref>, <ref loc="PSA 103:21">21</ref>; <ref loc="DAN 7:10">Dan 7:10</ref>. </char>
    </note> Imwe baamaraika be mwena, mumuhimbise;</para>
  <para style="q1" vid="PSA 148:2">Naimwe ab'omu ihe rye mwena, mumuhimbise.<verse eid="PSA 148:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3" />Iwe eizooba n'okwezi, mumuhimbise;</para>
  <para style="q1" vid="PSA 148:3">Naimwe enyonyoozi ezirikwaka mwena, mumuhimbise.<verse eid="PSA 148:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:33">Zab 68:33</ref>; <ref loc="1KI 8:27">1 Bag 8:27</ref>; <ref loc="GEN 1:7">Kut 1:7</ref>. </char>
    </note> Iwe eiguru eririkweshumba erindi, muhimbise;</para>
  <para style="q1" vid="PSA 148:4">Naimwe amaizi agari ahaiguru y'eiguru.<verse eid="PSA 148:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:6">Zab 33:6</ref>, <ref loc="PSA 33:9">9</ref>. </char>
    </note> Ka bihimbise eiziina rya MUKAMA;</para>
  <para style="q1" vid="PSA 148:5">Ahakuba akaragiira, byahangwa;<verse eid="PSA 148:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:90">Zab 119:90</ref>; <ref loc="JER 31:35">Yer 31:35</ref>, <ref loc="JER 31:36">36</ref>. </char>
    </note> Kandi yaabihamiza kimwe ebiro n'ebiro;</para>
  <para style="q1" vid="PSA 148:6">Yaataho ekiragiro ekitarihwaho.<verse eid="PSA 148:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:21">Kut 1:21</ref>. </char>
    </note> Imwe eby'omu nsi, muhimbise MUKAMA!</para>
  <para style="q1" vid="PSA 148:7">Imwe emigoye, n'ahagati y'amayanja hoona;<verse eid="PSA 148:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 105:32">Zab 105:32</ref>; <ref loc="PSA 107:25">107:25</ref>; <ref loc="PSA 147:15-18">147:15-18</ref>. </char>
    </note> Omuriro n'orubaare, ebirika n'omwika,</para>
  <para style="q1" vid="PSA 148:8">Omuyaga gw'amaani, oguhikiiriza ekiragiro kye;<verse eid="PSA 148:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 44:23">Isa 44:23</ref>; <ref loc="ISA 55:12">55:12</ref>. </char>
    </note> Ebibungo n'emigongo yoona;</para>
  <para style="q1" vid="PSA 148:9">Emiti erikwana, n'emyereezi yoona;<verse eid="PSA 148:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:10: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:20">Kut 1:20</ref>, <ref loc="GEN 1:21">21</ref>, <ref loc="GEN 1:24">24</ref>, <ref loc="GEN 1:25">25</ref>. </char>
    </note> Enyamaishwa n'amatungo goona,</para>
  <para style="q1" vid="PSA 148:10">Ebirikwekurura, n'enyonyi ezirikuguruka;<verse eid="PSA 148:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:11: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:26">Byak 17:26</ref>; <ref loc="REV 7:9">Kush 7:9</ref>. </char>
    </note> Abagabe b'ensi, n'amahanga goona;</para>
  <para style="q1" vid="PSA 148:11">Abanyiginya n'abaramuzi boona ab'omu nsi;<verse eid="PSA 148:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12" />Abatsigazi n'empangare;</para>
  <para style="q1" vid="PSA 148:12">Abagurusi n'abaana!<verse eid="PSA 148:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:1">Zab 8:1</ref>; <ref loc="PSA 113:4">113:4</ref>; <ref loc="ISA 6:3">Isa 6:3</ref>. </char>
    </note> Bihimbise eiziina rya MUKAMA;</para>
  <para style="q1" vid="PSA 148:13">Ahakuba eiziina rye wenka niryo rihimbisibwa;</para>
  <para style="q1" vid="PSA 148:13">Ekitiinisa kye nikyeshumba ensi n'eiguru.<verse eid="PSA 148:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">148:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:7">Bir 4:7</ref>; <ref loc="DEU 10:21">10:21</ref>; <ref loc="EPH 2:17">Efe 2:17</ref>. </char>
    </note> Aimukize eihembe ahabw'abantu be, eririkuhimbisibwa abarikwera be boona;</para>
  <para style="q1" vid="PSA 148:14">Nibo baana ba Israeli, eihanga erimuri haihi.</para>
  <para style="q1" vid="PSA 148:14">Haleluya!<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" sid="PSA 149" />
  <para style="s1">Oku Abaisraeli bashemereire kuhimbisa Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 149:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:3">Zab 33:3</ref>; <ref loc="PSA 89:5">89:5</ref>. </char>
    </note> Haleluya!</para>
  <para style="q1" vid="PSA 149:1">Mweshongorere MUKAMA ekyeshongoro kisya,</para>
  <para style="q1" vid="PSA 149:1">Kandi mweshongore eby'okumuhimbisa omu mutwe gw'abarikwera.<verse eid="PSA 149:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 95:6">Zab 95:6</ref>; <ref loc="ZEC 9:9">Zek 9:9</ref>. </char>
    </note> Israeli ashemerererwe Owaamuhangire,</para>
  <para style="q1" vid="PSA 149:2">N'abaana ba Saayuuni bashemerererwe Omugabe waabo.<verse eid="PSA 149:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:20">Kur 15:20</ref>; <ref loc="2SA 6:14">2 Sam 6:14</ref>. </char>
    </note> Bahimbise eiziina rye nibazina,</para>
  <para style="q1" vid="PSA 149:3">Bamweshongorere eby'okuhimbisa n'engarabi n'enanga;<verse eid="PSA 149:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:27">Zab 35:27</ref>; <ref loc="PSA 147:11">147:11</ref>. </char>
    </note> Ahakuba MUKAMA ashemerererwa abantu be;</para>
  <para style="q1" vid="PSA 149:4">Abacureezi aryabahunda okujunwa.<verse eid="PSA 149:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 63:6">Zab 63:6</ref>; <ref loc="JOB 35:10">Yob 35:10</ref>. </char>
    </note> Abarikwera beesiimire omu kitiinisa,</para>
  <para style="q1" vid="PSA 149:5">Beeshongore ahabw'okushemererwa, bari aha bitabo byabo.<verse eid="PSA 149:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">149:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 66:17">Zab 66:17</ref>; <ref loc="HEB 4:12">Heb 4:12</ref>; <ref loc="REV 1:16">Kush 1:16</ref>. </char>
    </note> Ebyeshongoro by'okusingiza Ruhanga bigume omu kanwa kaabo,</para>
  <para style="q1" vid="PSA 149:6">Na rurara ey'amoogi abiri egume omu ngaro zaabo,<verse eid="PSA 149:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7" />Okuhoora amahanga,</para>
  <para style="q1" vid="PSA 149:7">N'okuha abantu ebiheneso,<verse eid="PSA 149:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8" />Okuboha abagabe baabo n'enjegyere,</para>
  <para style="q1" vid="PSA 149:8">N'abakuru baabo n'emihama y'ebyoma,<verse eid="PSA 149:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9" />Kandi n'okubataho orubanja oruhandiikirwe.</para>
  <para style="q1" vid="PSA 149:9">Ekitiinisa ekyo n'eky'abarikwera be boona.</para>
  <para style="q1" vid="PSA 149:9">Haleluya!<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" sid="PSA 150" />
  <para style="s1">Okuhimbisa Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:1: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 68:34">Zab 68:34</ref>. </char>
    </note> Haleluya!</para>
  <para style="q1" vid="PSA 150:1">Muhimbisize Ruhanga omu Mwanya gwe ogurikwera;</para>
  <para style="q1" vid="PSA 150:1">Mumuhimbisize omu kaabunga k'amaani ge.<verse eid="PSA 150:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:12">Zab 145:12</ref>; <ref loc="DEU 3:24">Bir 3:24</ref>. </char>
    </note> Mumusiime ahabw'eby'amaani ebi akora;</para>
  <para style="q1" vid="PSA 150:2">Mumusiime nk'obukuru bwe obutakareebwaga oku buri.<verse eid="PSA 150:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 98:5">Zab 98:5</ref>, <ref loc="PSA 98:6">6</ref>. </char>
    </note> Mumusiime n'eiraka ry'amakondere;</para>
  <para style="q1" vid="PSA 150:3">Mumusiime n'endingiri n'enanga;<verse eid="PSA 150:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 149:3">Zab 149:3</ref>; <ref loc="ISA 38:20">Isa 38:20</ref>; <ref loc="JOB 21:12">Yob 21:12</ref>. </char>
    </note> Mumusiime n'engarabi n'okuzina;</para>
  <para style="q1" vid="PSA 150:4">Mumusiime n'ebiine emirya n'esheegu;<verse eid="PSA 150:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:5: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 15:28">1 Bus 15:28</ref>. </char>
    </note> Mumusiime n'ebitaasa ebirikugamba,</para>
  <para style="q1" vid="PSA 150:5">Mumusiime n'ebitaasa ebirikukwaya munonga.<verse eid="PSA 150:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">150:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 145:21">Zab 145:21</ref>; <ref loc="REV 5:13">Kush 5:13</ref>. </char>
    </note> Byona ebiine omwitsyo bihimbise MUKAMA.</para>
  <para style="q1" vid="PSA 150:6">Haleluya!<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>