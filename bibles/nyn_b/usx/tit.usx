<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">RRK57.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">TITO</para>
  <para style="toc1">Ebaruha ei Paulo yaahandiikiire Tito</para>
  <para style="toc2">Tito</para>
  <para style="toc3">Tit</para>
  <para style="mt2">EBARUHA EI PAULO YAAHANDIIKIIRE</para>
  <para style="mt1">TITO</para>
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Nyowe Paulo, omuhuuku wa Ruhanga kandi entumwa ya Yesu Kristo, owaatumirwe aha baatoorainwe Ruhanga ngu beeyongyere omu kwikiriza n'okumanya amazima agarimu okutiina Ruhanga, <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />baine amatsiko g'amagara agatahwaho, agu Ruhanga otabaasa kubeiha yaaraganiise iranaira; <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" /><note caller="-" style="x"><char style="xo" closed="false">1:3: </char><char style="xt" closed="false"><ref loc="EPH 1:9">Efe 1:9</ref>, <ref loc="EPH 1:10">10</ref>. </char></note> kandi obunaku obu yaatooraine ku bwahikire, yaayoreka ekigambo kye omu butumwa obu naakwatsiibwe nka Ruhanga Omujuni waitu oku yandagiire; <verse eid="TIT 1:3" /><verse number="4" style="v" sid="TIT 1:4" />naakuhandiikira, Tito mwana wangye buzima omu kwikiriza oku tukwataniise; ninkwendeza embabazi n'obusingye ebirikuruga ahari Ruhanga Isheboona na Kristo Yesu Omujuni waitu.<verse eid="TIT 1:4" /></para>
  <para style="s1">Paulo okuhabura Tito oku araatwaze obureeberezi</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Eki naakutsigiire Kureete n'okushemeza ebyatsigariire kandi n'okutaho abakuru omuri tauni zoona, nk'oku naakuragiire; <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" /><note caller="-" style="x"><char style="xo" closed="false">1:6: </char><char style="xt" closed="false"><ref loc="1TI 3:2-4">1 Tim 3:2-4</ref>. </char></note> omuntu weena omuribo abe otaine ki arikugaywaho, oine omukazi omwe, kandi oine abaana abarikwikiriza, abatarikwetwa birare nari abagomi. <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" /><note caller="-" style="x"><char style="xo" closed="false">1:7: </char><char style="xt" closed="false"><ref loc="1PE 5:2">1 Pet 5:2</ref>. </char></note> Ahakuba omureeberezi ashemereire kutagira ki arikugaywaho, nk'omubiiki wa Ruhanga; kandi tashemereire kuba otarikuteisibwa nari orikurahuka kubiihirwa nari omusinzi nari omuteezi w'abantu nari oine omururu gw'enshaagi, <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />kureka abe orikukunira abagyenyi, orikukunda oburungi, oine omutima murungi, ohikiriire, orikwera, omwerinzi, <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />orikuhamira aha kigambo ky'okwesigwa ekiri nk'okwegyesa kwaitu oku kuri, abone kushobororera abantu enyegyesa y'amazima, n'okusinga abarikugihakanisa.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Ahakuba hariho abagomi baingi, abagamba busha kandi engobya, okukira munonga ab'omu kigombe ky'abashazirwe; <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" /><note caller="-" style="x"><char style="xo" closed="false">1:11: </char><char style="xt" closed="false"><ref loc="JHN 10:12">Yoh 10:12</ref>. </char></note> abo bashemereire kuzibirwa kugamba; n'abantu abarikusheenya amaka, nibeegyesa ebitashemeire ahabw'okwetungira enshaagi. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Omwe omuribo, nabi waabo, akagira ati: Aba Kureete obutoosha bashangwa baba abanyabishuba, enyamaishwa mbi, abeeremwa, endiirakukinduka. <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" /><note caller="-" style="x"><char style="xo" closed="false">1:13: </char><char style="xt" closed="false"><ref loc="2TI 4:2">2 Tim 4:2</ref>. </char></note> Okuhamya oku n'okw'amazima. N'ahabw'ekyo obahane n'amaani, babone kuhamira omu kwikiriza; <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />omu mwanya gw'okweta aha biteekerezo by'ebigunjano by'Abayudaaya n'ebiragiro by'abantu abarikuteishuka bakaruga omu mazima. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" /><note caller="-" style="x"><char style="xo" closed="false">1:15: </char><char style="xt" closed="false"><ref loc="MAT 15:11">Mat 15:11</ref>. </char></note> Aha bashemeire byona bishemeire, kwonka aha basiisikaire n'abatarikwikiriza tihariho kishemeire; ahakuba obwengye bwabo n'emitima yaabo bisiisikaire. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" /><note caller="-" style="x"><char style="xo" closed="false">1:16: </char><char style="xt" closed="false"><ref loc="2TI 3:5">2 Tim 3:5</ref>. </char></note> Beegamba ku barikumanya Ruhanga, kwonka omu micwe yaabo bamwehakana; n'ab'okunugwa, entahurira, kandi abatarikugasha mu murimo gwona omurungi.<verse eid="TIT 1:16" /></para>
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s1">Emitwarize mirungi y'Omukristaayo</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:13">2 Tim 1:13</ref>. </char>
    </note> Kwonka iwe ogume oyegyese ebishemereire enyegyesa y'amazima, <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />ogambire abagurusi barekye kusinda, babe abeerinzi, abaine omutima ogurikweyangisa, kandi babe abahikire omu kwikiriza n'omu kukunda kandi n'omu kugumisiriza; <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" /><note caller="-" style="x"><char style="xo" closed="false">2:3: </char><char style="xt" closed="false"><ref loc="1TI 3:11">1 Tim 3:11</ref>. </char></note> abakaikuru nabo batwaze nk'oku kishemereire abarikwera, abatarikubeiherera bandi, abatari bahuuku b'ebirikusinza; beegyese ebirungi, <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />babone kutendeka abakazi bato kukunda baibabo n'abaana baabo, <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />bagire omutima murungi, beerinde obushambani, bakore emirimo yaabo omu maka, bagire embabazi, boorobere baibabo, ekigambo kya Ruhanga kirekye kujumwa; <verse eid="TIT 2:5" /><verse number="6" style="v" sid="TIT 2:6" />kandi oragiire abatsigazi nabo bagire omutima ogurikweyangisa; <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" /><note caller="-" style="x"><char style="xo" closed="false">2:7: </char><char style="xt" closed="false"><ref loc="1PE 5:3">1 Pet 5:3</ref>. </char></note> naiwe omuri byona oyeyorekye nk'eky'okureeberaho omu kukora gye; omu kwegyesa kwawe oyeyorekye ku otari ndyarya, kureka ku ori omwerinzi, <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" /><note caller="-" style="x"><char style="xo" closed="false">2:8: </char><char style="xt" closed="false"><ref loc="1PE 2:15">1 Pet 2:15</ref>. </char></note> orikugamba ebigambo by'amazima ebitarikugaywa, haza ogwo orikuturwanisa akwatwe enshoni ahabw'okubura ekibi ky'okutwomesereza. <verse eid="TIT 2:8" /><verse number="9" style="v" sid="TIT 2:9" /><note caller="-" style="x"><char style="xo" closed="false">2:9: </char><char style="xt" closed="false"><ref loc="EPH 6:5">Efe 6:5</ref>. </char></note> Gambira abahuuku boorobere bakama baabo, babone kusiimwa omuri byona; barekye kwetomboita, <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />nari okwiba; kureka beeyorekye bari abeesigwa buzima, babone kusiimisa enyegyesa ya Ruhanga Omujuni waitu omuri byona.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Ahakuba embabazi za Ruhanga zireebekire nizireetera abantu boona okujunwa, <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />nizituhabura kwanga okutatiina Ruhanga n'okwetenga eby'ensi, ngu tubone kugumaho omu busingye obu obwa hati, nitwerinda, turi abahikiriire, abarikutiina Ruhanga, <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" /><note caller="-" style="x"><char style="xo" closed="false">2:13: </char><char style="xt" closed="false"><ref loc="PHP 3:20">Fil 3:20</ref>. </char></note> tutegyereize eki twineho amatsiko agarimu omugisha, nikwo kworekwa kw'ekitiinisa okwa Ruhanga waitu, Yesu Kristo, <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" /><note caller="-" style="x"><char style="xo" closed="false">2:14: </char><char style="xt" closed="false"><ref loc="GAL 1:4">Gal 1:4</ref>; <ref loc="PSA 130:8">Zab 130:8</ref>; <ref loc="DEU 14:2">Bir 14:2</ref>. </char></note> owaayehaireyo ahabwaitu, kutucungura omu bugomi bwona, n'okutweza ahabwe, ngu tubone kuba eihanga rye eritoorainwe, eririkwezirikira kukora emirimo emirungi. <verse eid="TIT 2:14" /><verse number="15" style="v" sid="TIT 2:15" />Ebyo obe nibyo waagamba, obibahabure, obahane n'obushoboorozi bwingi. Hatagira omuntu weena owaakugaya.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 2:13">1 Pet 2:13</ref>. </char>
    </note> Obaijutsye kworobera abategyeki n'abaine obushoboorozi, n'okubahurira, n'okweteekateekyera omurimo gwona omurungi, <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />okutagira ou bagambaho kubi, okutatongana kureka okutwaza gye, nibooreka obucureezi bwingi aha bantu boona. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" /><note caller="-" style="x"><char style="xo" closed="false">3:3: </char><char style="xt" closed="false"><ref loc="EPH 2:2">Efe 2:2</ref>. </char></note> Ahakuba naitwe ira tukaba turi abashema, entahurira, abahabisiibwe, abahuuku b'okwetenga okubi n'okweshemeza okw'emiringo mingi, nitumarira omwanya gwaitu omu itima n'eihari, nitwangwa, kandi nitwangana. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Kwonka embabazi za Ruhanga Omujuni waitu n'okukunda oku yaakunzire abantu ku byareebekire, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" /><note caller="-" style="x"><char style="xo" closed="false">3:5: </char><char style="xt" closed="false"><ref loc="EPH 2:8">Efe 2:8</ref>, <ref loc="EPH 2:9">9</ref>; <ref loc="JHN 3:5">Yoh 3:5</ref>. </char></note> yaatujuna, ti habw'eby'okuhikiirira ebi twakozire, kureka ahabw'okusaasira kwe, akatujunisa okwogibwa okw'okuzaarwa obwa kabiri n'okuhindurwa abasya omu Mwoyo Orikwera, <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />ou yaatushukireho atarikubariirira, naamurabya omuri Yesu Kristo Omujuni waitu, <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" /><note caller="-" style="x"><char style="xo" closed="false">3:7: </char><char style="xt" closed="false"><ref loc="ROM 3:24">Rom 3:24</ref>. </char></note> ngu tubone kwihwaho orubanja ahabw'embabazi ze, tuhindukye abahunguzi abaine amatsiko g'amagara agatahwaho. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Ekigambo eki n'eky'okwesigwa; kandi niinyenda ngu ebyo obihamye otarikubanganisa, abaikiriize Ruhanga babone kuguma nibata omutima aha kukora ebirungi. Ebigambo ebi ni birungi, kandi nibigasira abantu. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Kwonka oyetantare ebibuuzo by'obushema n'eby'okutondoora obukomooko bwa baishenkurubo n'entongane n'okuhakana aha Biragiro; ahakuba ebyo tibiine mugasho kandi n'ebya busha. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" /><note caller="-" style="x"><char style="xo" closed="false">3:10: </char><char style="xt" closed="false"><ref loc="MAT 18:15">Mat 18:15</ref>, <ref loc="MAT 18:16">16</ref>. </char></note> Orikureeta okwecwamu ebicweka omu kanisa, ku orimuteisa rimwe nari kabiri, yaayanga, omurekye; <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" /><note caller="-" style="x"><char style="xo" closed="false">3:11: </char><char style="xt" closed="false"><ref loc="1TI 6:4">1 Tim 6:4</ref>, <ref loc="1TI 6:5">5</ref>. </char></note> noomanya ku omuntu nk'ogwo ahabire, kandi ku ari enkozi y'ebibi, orikwesingisa orubanja.<verse eid="TIT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:11">2 Tim 4:11</ref>, <ref loc="2TI 4:12">12</ref>. </char>
    </note> Ku ndikutumaho Arutema nari Tukiko, oteereho nk'oku orikubaasa, kunshanga Nikopooli; ahakuba okwo niyo mmaririire kumarira ebiro by'embeho. <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3:13: </char><char style="xt" closed="false"><ref loc="ACT 18:24">Byak 18:24</ref>. </char></note> Kandi oteereho n'okushendekyereza Zeena, omwegyesa w'Ebiragiro, na Apolo; oreebe ngu tibaine ki babuzire. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" /><note caller="-" style="x"><char style="xo" closed="false">3:14: </char><char style="xt" closed="false"><ref loc="EPH 4:28">Efe 4:28</ref>, <ref loc="EPH 4:29">29</ref>. </char></note> Kandi abantu baitu b'okwo beegye kuguma nibakora ebirungi, babone kuhwera abashemereire kuhwerwa buzima, barekye kuba abatarikwana byana.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Boona abari hamwe naanye baakuramutsya. Naiwe ondamukize abarikutukunda omu kwikiriza.</para>
  <para style="p" vid="TIT 3:15">Embabazi zigume naimwe mwena.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>