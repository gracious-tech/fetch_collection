<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">RRK03.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">OKUBARA</para>
  <para style="toc1">Ekitabo Kya Musa Ekya Kana Ekirikwetwa Okubara</para>
  <para style="toc2">Okubara</para>
  <para style="toc3">Kub</para>
  <para style="mt2">EKITABO KYA MUSA EKYA KANA EKIRIKWETWA</para>
  <para style="mt1">OKUBARA</para>
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s1">Okubarwa kw'enganda ikumi na rumwe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />MUKAMA akagambirira Musa omu ihamba rya Sinai, ari omu Ihema ry'okubugaabuganiramu, aha kiro ky'okubanza eky'okwezi kwa kabiri omu mwaka gwa kabiri barugire omu nsi ya Misri, ati: <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2: </char><char style="xt" closed="false"><ref loc="EXO 30:12">Kur 30:12</ref>; <ref loc="NUM 26:2-4">Kub 26:2-4</ref>; <ref loc="2SA 24:2">2 Sam 24:2</ref>. </char></note> Mubare eihanga ryona ery'Abaisraeli, nk'oku enganda zaabo ziri n'emiryango ya baishenkurubo oku eri, mubare abashaija boona, omwe omwe, nk'amaziina gaabo oku gari, <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />abahikize emyaka makumi abiri n'okukiraho, ab'omuri Israeli abarikubaasa kuhurura; iwe na Arooni mubabare nk'emitwe y'engabo zaabo oku eri. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Mukwatanise n'omuntu omwe omuri buri ruganda, omukuru w'omuryango gwa baishenkuru. <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />Aga nigo maziina g'abashaija abaraakwatanise naimwe. Omu ruganda rwa Reubeeni, Elizuuri mwene Shedeuri; <verse eid="NUM 1:5" /><verse number="6" style="v" sid="NUM 1:6" />omu rwa Simeoni, Shelumieli mwene Zuri-shadai; <verse eid="NUM 1:6" /><verse number="7" style="v" sid="NUM 1:7" />omu rwa Yuda, Nahashooni mwene Aminadabu; <verse eid="NUM 1:7" /><verse number="8" style="v" sid="NUM 1:8" />omu rwa Isakaari, Netaneeli mwene Zuari; <verse eid="NUM 1:8" /><verse number="9" style="v" sid="NUM 1:9" />omu rwa Zebuluuni, Eliabu mwene Heloni; <verse eid="NUM 1:9" /><verse number="10" style="v" sid="NUM 1:10" />omuri beene Yosefu, ow'omu rwa Efuraimu, Elishaama mwene Amihuudi; omu rwa Manaase, Gamalieli mwene Pedazuuri; <verse eid="NUM 1:10" /><verse number="11" style="v" sid="NUM 1:11" />omu rwa Benyamiini, Abidaani mwene Gideoni; <verse eid="NUM 1:11" /><verse number="12" style="v" sid="NUM 1:12" />omu rwa Daani, Ahiezeeri mwene Ami-shadai; <verse eid="NUM 1:12" /><verse number="13" style="v" sid="NUM 1:13" />omu rwa Asheri, Pagieli mwene Okiraani; <verse eid="NUM 1:13" /><verse number="14" style="v" sid="NUM 1:14" />omu rwa Gaadi, Eliasaafu mwene Deueli; <verse eid="NUM 1:14" /><verse number="15" style="v" sid="NUM 1:15" />omu rwa Nafutaali, Ahiira mwene Enani. <verse eid="NUM 1:15" /><verse number="16" style="v" sid="NUM 1:16" />Abo nibo baatoorainwe omu ihanga ryona, abaabaire bari abeebembezi b'enganda za baishenkurubo, kandi abakuru b'emiryango y'Abaisraeli.<verse eid="NUM 1:16" /></para>
  <para style="s1">Eby'oruganda rw'Abaleevi okutabarirwa hamwe n'ezindi</para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />Musa na Arooni baatwara abantu abo abu amaziina gaabo gaagambwaho, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />baateerana eihanga ryona aha kiro ky'okubanza eky'okwezi kwa kabiri, baayehandiikisa nk'enganda zaabo oku zaabaire ziri n'emiryango ya baishenkurubo oku yaabaire eri, baabara amaziina gaabo omwe omwe, abahikize emyaka makumi abiri n'okukiraho. <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />Nk'oku MUKAMA yaaragiire Musa, nikwo yaababariire omu ihamba rya Sinai.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 1:20" />Baahandiika oruzaaro rwa Reubeeni, omujigaijo gwa Israeli, nk'emiryango yaabo oku eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe, abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:20" /><verse number="21" style="v" sid="NUM 1:21" />Ab'omu ruganda rwa Reubeeni abaabazirwe baaba obukumi buna n'enkumi mukaaga na magana ataano.<verse eid="NUM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 1:22" />Baahandiika oruzaaro rwa Simeoni nk'oku emiryango yaabo yaabaire eri n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:22" /><verse number="23" style="v" sid="NUM 1:23" />Ab'omu ruganda rwa Simeoni abaabazirwe baaba obukumi butaano n'enkumi mwenda na magana ashatu.<verse eid="NUM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 1:24" />Baahandiika oruzaaro rwa Gaadi, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:24" /><verse number="25" style="v" sid="NUM 1:25" />Ab'omu ruganda rwa Gaadi abaabazirwe baaba obukumi buna n'enkumi itaano na magana mukaaga na makumi ataano.<verse eid="NUM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 1:26" />Baahandiika oruzaaro rwa Yuda, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:26" /><verse number="27" style="v" sid="NUM 1:27" />Ab'omu ruganda rwa Yuda abaabazirwe baaba obukumi mushanju n'enkumi ina na magana mukaaga.<verse eid="NUM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 1:28" />Baahandiika oruzaaro rwa Isakaari, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:28" /><verse number="29" style="v" sid="NUM 1:29" />Ab'omu ruganda rwa Isakaari abaabazirwe baaba obukumi butaano n'enkumi ina na magana ana.<verse eid="NUM 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 1:30" />Baahandiika oruzaaro rwa Zebuluuni, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:30" /><verse number="31" style="v" sid="NUM 1:31" />Ab'omu ruganda rwa Zebuluuni abaabazirwe baaba obukumi butaano n'enkumi mushanju na magana ana.<verse eid="NUM 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 1:32" />Omuri batabani ba Yosefu baahandiika oruzaaro rwa Efuraimu, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:32" /><verse number="33" style="v" sid="NUM 1:33" />Ab'omu ruganda rwa Efuraimu abaabazirwe baaba obukumi buna na magana ataano. <verse eid="NUM 1:33" /><verse number="34" style="v" sid="NUM 1:34" />Baahandiika oruzaaro rwa Manaase nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:34" /><verse number="35" style="v" sid="NUM 1:35" />Ab'omu ruganda rwa Manaase abaabazirwe baaba obukumi bushatu n'enkumi ibiri na magana abiri.<verse eid="NUM 1:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 1:36" />Baahandiika oruzaaro rwa Benyamiini, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:36" /><verse number="37" style="v" sid="NUM 1:37" />Ab'omu ruganda rwa Benyamiini abaabazirwe baaba obukumi bushatu n'enkumi itaano na magana ana. <verse eid="NUM 1:37" /><verse number="38" style="v" sid="NUM 1:38" />Baahandiika oruzaaro rwa Daani, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:38" /><verse number="39" style="v" sid="NUM 1:39" />Ab'omu ruganda rwa Daani abaabazirwe baaba obukumi mukaaga n'enkumi ibiri na magana mushanju.<verse eid="NUM 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 1:40" />Baahandiika oruzaaro rwa Asheri, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:40" /><verse number="41" style="v" sid="NUM 1:41" />Ab'omu ruganda rwa Asheri abaabazirwe baaba obukumi buna na rukumi na magana ataano.<verse eid="NUM 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 1:42" />Baahandiika oruzaaro rwa Nafutaali, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, nibabara amaziina g'abashaija boona omwe omwe abahikize emyaka makumi abiri n'okukiraho, boona abarikubaasa kuhurura. <verse eid="NUM 1:42" /><verse number="43" style="v" sid="NUM 1:43" />Ab'omu ruganda rwa Nafutaali abaabazirwe baaba obukumi butaano n'enkumi ishatu na magana ana.<verse eid="NUM 1:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />Abo nibo baabazirwe, abu Musa na Arooni baabazire, nibahwerwa abeebembezi ba Israeli, abashaija ikumi na babiri, buri omwe ahabw'enju ya baishenkuru. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />N'ahabw'ekyo abaabazirwe boona omu Baisraeli nk'amaju ga baishenkurubo oku gaabaire gari, abaabaire bahikize emyaka makumi abiri n'okukiraho, kandi boona abaabaire nibabaasa kuhurura, <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" /><note caller="-" style="x"><char style="xo" closed="false">1:46: </char><char style="xt" closed="false"><ref loc="DEU 10:22">Bir 10:22</ref>; <ref loc="NUM 26:51">Kub 26:51</ref>. </char></note> abaabazirwe boona baaba obusiriira mukaaga n'enkumi ishatu na magana ataano na makumi ataano.<verse eid="NUM 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:47: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 2:33">Kub 2:33</ref>; <ref loc="NUM 26:57">26:57</ref>. </char>
    </note> Kwonka Abaleevi nk'oruganda rwa baishenkurubo oku rwabaire ruri tibaabarwa hamwe nabo; <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />ahabw'okuba MUKAMA akagira Musa ati: <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />Oruganda rwa Leevi rwo otarirubara, n'obu kwakuba okubabarira hamwe n'Abaisraeli abandi; <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />kureka Abaleevi obagire ab'okutegyeka Obutaaho bw'Ebirikuhamya, n'ebintu byamwo byona, n'ebintu byabwo byona; nibo bariguma nibatwara obwo Butaaho n'ebintu byamwo byona; nibo bariguma nibabukoramu emirimo y'obuheereza, kandi baryaguma bateere amahema gaabo okubwehinguririza. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" /><note caller="-" style="x"><char style="xo" closed="false">1:51: </char><char style="xt" closed="false"><ref loc="NUM 10:17">Kub 10:17</ref>, <ref loc="NUM 10:21">21</ref>. </char></note> Kandi Obutaaho ku buriba nibwimuka kugyenda, Abaleevi babe nibo baabukuura; kandi ku buriba nibuza kuteerwa, Abaleevi babe nibo baabuteera. Otari Muleevi weena ku aribuhika haihi, aitwe. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Abaisraeli baryaguma bateere amahema gaabo, buri muntu omu rusiisira rw'owaabo aha rurango rwabo, nk'oku emitwe yaabo eri. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" /><note caller="-" style="x"><char style="xo" closed="false">1:53: </char><char style="xt" closed="false"><ref loc="2CH 13:10">2 Bus 13:10</ref>. </char></note> Kwonka Abaleevi bo baryateera amahema gaabo nibeehinguririza Obutaaho bw'Ebirikuhamya, eihanga ry'Abaisreli rirekye kugirirwa ekiniga; kandi Abaleevi nibo bariguma nibarinda Obutaaho bw'Ebirikuhamya. <verse eid="NUM 1:53" /><verse number="54" style="v" sid="NUM 1:54" />Okwo nikwo Abaisraeli baakozire, bakakora nk'oku MUKAMA yaaragiire Musa.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">Okuteera amahema omu nteeko ina</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />MUKAMA yaagambira Musa na Arooni ati: <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" /><note caller="-" style="x"><char style="xo" closed="false">2:2: </char><char style="xt" closed="false"><ref loc="NUM 24:2-9">Kub 24:2-9</ref>. </char></note> Abaisraeli bagume bateere amahema gaabo, buri muntu aha rurango rw'owaabo, n'aha turango tw'amaju ga baishenkurubo; bagateere nigareeba Eihema ry'okubugaabuganiramu aha mbaju zaaryo zoona. <verse eid="NUM 2:2" /><verse number="3" style="v" sid="NUM 2:3" />Abaraateere amahema gaabo aha rubaju rwaryo orw'oburugwa-izooba bagume babe ab'orusiisira rwa Yuda, nk'oku emitwe yaabo eri, baine orurango rw'oruganda rwabo; kandi omwebembezi w'Abayuda abe Nahashooni mwene Abinadabu. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />Eihe rye rikaba ririmu abashaija obukumi mushanju n'enkumi ina na magana mukaaga, nk'oku baabazirwe. <verse eid="NUM 2:4" /><verse number="5" style="v" sid="NUM 2:5" />Ab'oruganda rwa Isakaari nibo baraateere orusiisira okubahereera; omwebembezi waabo abe Netaneeli mwene Zuari. <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />Eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi ina na magana ana, nk'oku baabazirwe. <verse eid="NUM 2:6" /><verse number="7" style="v" sid="NUM 2:7" />Hakurateho oruganda rwa Zebuluuni, omwebembezi waabo abe Eliabu mwene Heloohi; <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi mushanju na magana ana, nk'oku baabazirwe. <verse eid="NUM 2:8" /><verse number="9" style="v" sid="NUM 2:9" />Boona abaabazirwe omu kicweka kya Yuda bakaba bari abashaija akasiriira n'obukumi munaana n'enkumi mukaaga na magana ana, nk'oku amahe gaabo gaabaire gari. Abo babe nibo baaguma nibabanza kwimutsya orugyendo.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />Aha bukiizi-bwa-buryo hagume hazeho orurango rw'orusiisira rw'oruganda rwa Reubeeni, nk'oku emitwe yaabo eri; omwebembezi waabo abe Elizuuri mwene Shedeuri. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />Eihe rye rikaba ririmu abashaija obukumi buna n'enkumi mukaaga na magana ataano, nk'oku baabazirwe. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Abaraateere orusiisira okubahereera babe ab'oruganda rwa Simeoni; omwebembezi waabo abe Shelumieli mwene Zuri-shadai; <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi mwenda na magana ashatu, nk'oku baabazirwe. <verse eid="NUM 2:13" /><verse number="14" style="v" sid="NUM 2:14" />Hakurateho oruganda rwa Gaadi; omwebembezi waabo abe Eliasaafu mwene Reueli; <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />eihe rye rikaba ririmu abashaija obukumi buna n'enkumi itaano na magana mukaaga na makumi ataano. <verse eid="NUM 2:15" /><verse number="16" style="v" sid="NUM 2:16" />Boona abaabazirwe omu kicweka kya Reubeeni bakaba bari abashaija akasiriira n'obukumi butaano na rukumi na magana ana na makumi ataano, nk'oku amahe gaabo gaabaire gari. Abo babe nibo baaba aba kabiri omu kwimutsya orugyendo.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />Eihema ry'okubugaabuganiramu rigume riimukize hamwe n'orusiisira rw'Abaleevi ahagati y'ensiisira ezindi; nk'oku barikusiisira, babe nikwo baaguma nibaimutsya orugyendo, buri ruganda omu mwanya gwarwo, nk'oku endango zaabo ziri.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />Aha rubaju rw'oburengyerwa izooba hagume hazeho orurango rw'orusiisira rw'oruganda rwa Efuraimu, nk'oku emitwe yaabo eri; omwebembezi waabo abe Elishaama mwene Amihuudi. <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />Eihe rye rikaba ririmu abashaija obukumi buna na magana ataano, nk'oku baabazirwe. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Ab'oruganda rwa Manaase babe nibo baabahereera; omwebembezi waabo abe Gamalieli mwene Pedazuuri; <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />eihe rye rikaba ririmu abashaija obukumi bushatu n'enkumi ibiri na magana abiri, nk'oku baabazirwe. <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Hakurateho oruganda rwa Benyamiini; omwebembezi waabo abe Abidaani mwene Gideoni; <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />eihe rye rikaba ririmu abashaija obukumi bushatu n'enkumi itaano na magana ana, nk'oku baabazirwe. <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />Boona abaabazirwe omu kicweka kya Efuraimu bakaba bari abashaija akasiriira n'enkumi munaana na igana, nk'oku amahe gaabo gaabaire gari. Abo babe nibo baaba aba kashatu omu kwimutsya orugyendo.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />Aha bukiizi-bwa-bumosho hagume hazeho orurango rw'orusiisira rw'oruganda rwa Daani nk'oku emitwe yaabo eri; omwebembezi waabo abe Ahiezeeri mwene Ami-shadai. <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />Eihe rye rikaba ririmu abashaija obukumi mukaaga n'enkumi ibiri na magana mushanju, nk'oku baabazirwe. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Ab'oruganda rwa Ashera babe nibo baabahereera; omwebembezi waabo abe Pagieli mwene Okiraani; <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />eihe rye rikaba ririmu abashaija obukumi buna na rukumi na magana ataano, nk'oku baabazirwe. <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />Hakurateho oruganda rwa Nafutaali; omwebembezi waabo abe Ahiira mwene Enani; <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />eihe rye rikaba ririmu abashaija obukumi butaano n'enkumi ishatu na magana ana, nk'oku baabazirwe. <verse eid="NUM 2:30" /><verse number="31" style="v" sid="NUM 2:31" />Boona abaabazirwe omu kicweka kya Daani bakaba bari abashaija akasiriira n'obukumi butaano n'enkumi mushanju na magana mukaaga. Abo babe nibo baaguma nibahereeruka, nk'endango zaabo oku ziri.<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Abo nibo Baisraeli abaabazirwe nk'oku amaju ga baishenkurubo gaabaire gari; ab'omu nsiisira boona abaabazirwe nk'amahe gaabo oku gaabaire gari, bakaba bari abashaija obusiriira mukaaga n'enkumi ishatu na magana ataano na makumi ataano. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Kwonka omu kubara Abaisraeli Abaleevi bo tibarabazirwe, nk'oku MUKAMA yaaragiire Musa. <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" />Okwo nikwo Abaisraeli baakozire, nk'ebi MUKAMA yaaragiire Musa byona oku byabaire biri. Nikwo baagumire nibateera amahema gaabo nk'endango zaabo oku zaabaire ziri, kandi nikwo baabaire baimutsya orugyendo, buri muntu omu ruganda rwe, n'omu muryango gwa baishenkuru.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">Okubarwa kw'Abaleevi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Oru nirwo ruzaaro rwa Arooni na Musa omu bunaku obu MUKAMA yaagambiiremu na Musa aha rushozi Sinai. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Aga nigo maziina ga beene Arooni; omujigaijo gwe ni Nadabu, abandi ni Abihu, Eleazaari na Itamaari. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />Ago nigo maziina ga beene Arooni, abanyamurwa abaashukirweho amajuta, abu yaashoroire kuheereza omu mirimo y'abanyamurwa. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" /><note caller="-" style="x"><char style="xo" closed="false">3:4: </char><char style="xt" closed="false"><ref loc="LEV 10:1">Lev 10:1</ref>; <ref loc="HEB 12:29">Heb 12:29</ref>. </char></note> Nadabu na Abihu bakafeera omu maisho ga MUKAMA, obu baayoteza omu maisho ga MUKAMA omuriro ogundi ogutararagiirwe kwoteza, bari omu ihamba rya Sinai kandi bakaba batakagizire baana. Kwonka Eleazaari na Itamaari baaguma nibaheereza omu murimo gw'obunyamurwa omu maisho ga Arooni ishebo.<verse eid="NUM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />MUKAMA yaagambira Musa ati: <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />Reeta oruganda rwa Leevi, oruhitsye omu maisho ga Arooni omunyamurwa, babone kuguma nibamuheereza. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Bagume nibamukorera omurimo, bakorere n'eihanga ryona omu maisho g'Eihema ry'okubugaabuganiramu, nibakora omurimo gw'Obutaaho. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Babe nibo baarinda ebintu byona eby'omu Ihema ry'okubugaabuganiramu, beezirikye kukora emirimo y'okuheereza omu by'Obutaaho ahabw'Abaisraeli. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Oheyo Abaleevi ahari Arooni n'abatabani; bamuheerwe kimwe ahabw'Abaisraeli. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Kandi oryataho Arooni n'abatabani, beezirikye kukora omurimo gwabo gw'obunyamurwa; kwonka otari w'omuribo orihika haihi, akabyetaasyamu, aitwe.<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />Kandi MUKAMA yaagambira Musa ati: <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" /><note caller="-" style="x"><char style="xo" closed="false">3:12: </char><char style="xt" closed="false"><ref loc="NUM 8:16">Kub 8:16</ref>. </char></note> Reeba, nyetooraniire Abaleevi omu Baisraeli omu mwanya gw'emijigaijo yoona ey'Abaisraeli. Abaleevi n'abangye; <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" /><note caller="-" style="x"><char style="xo" closed="false">3:13: </char><char style="xt" closed="false"><ref loc="NEH 10:36">Neh 10:36</ref>; <ref loc="LUK 2:23">Luk 2:23</ref>. </char></note> ahabw'okuba emijigaijo yoona n'eyangye; aha izooba eri naitiireho emijigaijo yoona ey'omu nsi ya Misri, nibwo naayeyereza emijigaijo yoona omuri Israeli, ey'abantu n'ey'amatungo. Emijigaijo yoona eryaguma ebe eyangye. Niinye MUKAMA.<verse eid="NUM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />Kandi MUKAMA yaagambirira Musa omu ihamba rya Sinai, ati: <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />Bara Abaleevi, nk'oku amaju ga baishenkurubo gari, n'emiryango yaabo oku eri; obare oyetwa omushaija weena, okwiha aha beereere abahikize okwezi. <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Musa yaayorobera ekigambo kya MUKAMA, yaababara nk'oku yaaragiirwe. <verse eid="NUM 3:16" /><verse number="17" style="v" sid="NUM 3:17" />Aga nigo maziina ga batabani ba Leevi, Gereshoni, Kohasi na Merari. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />Kandi aga nigo maziina ga beene Gereshoni, nk'oku emiryango yaabo yaabaire eri, Libuni na Shimei. <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" />Kandi aba nibo beene Kohasi nk'oku emiryango yaabo yaabaire eri, Amuraamu, Izuhaari, Heburooni na Uzieli. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />Na beene Merari nk'oku emiryango yaabo yaabaire eri nibo aba; Mahili na Muushi. Egyo niyo miryango y'Abaleevi, nk'oku amaju ga baishenkurubo gaabaire gari.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Omuri Gereshoni nimwo haakomookire omuryango gw'aba Libuni n'ogw'aba Shimei; egyo niyo miryango y'aba Gereshoni. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Omubaro gw'abarikwetwa abashaija boona okwiha aha beereere abahikize okwezi kumwe gukaba guri enkumi mushanju na magana ataano. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Emiryango y'aba Gereshoni egume eteere amahema gaayo enyima y'Obutaaho aha rubaju rw'oburengyerwa-izooba. <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />Kandi omwebembezi w'enju ya baishenkuru b'aba Gereshoni abe Eliasaafu mwene Laeli. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Eby'Eihema ry'okubugaabuganiramu ebiraakwatsibwe beene Gereshoni, bibe Obutaaho n'Eihema, eby'okurishakaara, omukingo gw'okukinga aha muryango gw'Eihema ry'okubugaabuganiramu, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />emikingo y'orugo, n'omukingo ogw'aha irembo ry'orwo rugo orwehinguririize Obutaaho n'eitambiro, n'emirunga yaarwo, kandi n'emirimo yoona ey'ebyo bintu.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Omuri Kohasi nimwo haakomookire omuryango gw'aba Amuraamu, n'ogw'aba Izuhaari, n'ogw'aba Heburooni, n'ogw'aba Uzieli; egyo niyo miryango y'aba Kohasi. <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />Abeetwa abashaija boona okwiha aha beereere abahikize okwezi kumwe bakaba bari enkumi munaana na magana mukaaga, abaakwatsiibwe eby'Omwanya ogurikwera. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />Emiryango ya beene Kohasi egume eteere amahema gaayo aha rubaju rw'Obutaaho orw'obukiizi-bwa-buryo. <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />Kandi omwebembezi w'enju ya baishenkurubo omu miryango y'aba Kohasi abe Elizafaani mwene Uzieli. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Ebi baraakwatsibwe bibe eshanduukye y'endagaano, emeeza, ekikondo ky'amatabaaza, n'amatambiro, n'ebintu by'Omwanya ogurikwera ebirikukoresibwa abanyamurwa n'omukingo gwaho, kandi n'emirimo yaabyo yoona. <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />Kandi Eleazaari mwene Arooni omunyamurwa abe niwe yaaba omukuru w'abeebembezi b'Abaleevi, areeberere abakwatsiibwe eby'Omwanya ogurikwera. <verse eid="NUM 3:32" /><verse number="33" style="v" sid="NUM 3:33" />Omuri Merari nimwo haakomookire omuryango gw'aba Mahili, n'ogw'aba Muushi; egyo niyo miryango y'aba Merari. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Ab'omuribo abarikwetwa abashaija boona okwiha aha beereere abahikize okwezi kumwe bakaba bari enkumi mukaaga na magana abiri. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Omukuru w'enju ya baishenkurubo omu miryango ya Merari akaba ari Zurieli mwene Abihaili; abo bagume bateere amahema gaabo aha rubaju rw'Obutaaho orw'obukiizi-bwa-bumosho. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Ebi beene Merari baraakwatsibwe bibe embaaho z'obutaaho n'embazi zaazo n'enyomyo zaabwo n'ebiina byazo n'ebintu byabyo byona, kandi n'emirimo yaabyo yoona; <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />kandi n'enyomyo z'orugo orwehinguririize ekibuga, n'ebiina byazo n'enkondo zaazo n'emirunga yaazo.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Abaraagume nibateera amahema aha rubaju rw'Obutaaho orw'oburugwa-izooba, omu maisho g'Eihema ry'okubugaabuganiramu, aharikureeba ei eizooba rireetwa, ni Musa na Arooni n'abatabani, abaakwatsiibwe omurimo gw'omwanya ogurikwera, ogurikukorwa ahabw'Abaisraeli; otari w'omuribo ku arihika haihi yaabyetaasyamu, aitwe. <verse eid="NUM 3:38" /><verse number="39" style="v" sid="NUM 3:39" />Abaleevi boona abaabazirwe, abu Musa na Arooni baabazire ahabw'ekiragiro kya MUKAMA, nk'emiryango yaabo oku eri, abeetwa abashaija boona okwiha aha beereere abahikize okwezi kumwe, bakaba bari obukumi bubiri n'enkumi ibiri.<verse eid="NUM 3:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />Kandi MUKAMA yaaragiira Musa ati: Bara abeetwa abashaija boona ab'emijigaijo omu Baisraeli okwiha aha beereere abahikize okwezi kumwe, ohandiikye omubaro gw'amaziina gaabo. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Ontooranire Abaleevi niinye MUKAMA omu mwanya gw'emijigaijo yoona ey'Abaisraeli; ompe n'amatungo g'Abaleevi omu mwanya gw'emijigaijo yoona ey'amatungo g'Abaisraeli. <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" />Musa yaabara emijigaijo yoona ey'Abaisraeli, nk'oku MUKAMA yaamuragiire. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Abeetwa abashaija boona ab'emijigaijo okwiha aha beereere abahikize okwezi, omubaro gw'amaziina gaabo gwaba obukumi bubiri n'enkumi ibiri na magana abiri na makumi mushanju na bashatu.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />Kandi MUKAMA yaagira Musa ati: <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />Twara Abaleevi omu mwanya gw'emijigaijo yoona ey'Abaisraeli, otware n'amatungo g'Abaleevi omu mwanya gw'emijigaijo y'amatungo gaabo, Abaleevi babe abangye; niinye MUKAMA. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Kandi ahabw'okucungura emijigaijo y'Abaisraeli magana abiri na makumi mushanju na bashatu abaashaagire aha mubaro gw'Abaleevi, <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />otware shekeli itaano za buri omwe ahari egyo mijigaijo, otware eziri nka shekeli ey'Omwanya ogurikwera oku eri; (shekeli emwe erimu geera makumi abiri), <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />ohe Arooni n'abatabani ezo feeza z'okucungura egyo mijigaijo eshaagire. <verse eid="NUM 3:48" /><verse number="49" style="v" sid="NUM 3:49" /><note caller="-" style="x"><char style="xo" closed="false">3:49: </char><char style="xt" closed="false"><ref loc="HEB 9:12">Heb 9:12</ref>. </char></note> Ahari abo abaashaagire aha baacungwirwe Abaleevi, Musa yaabaihaho efeeza z'okubacungura; <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />efeeza ezi yaihire ahari egyo mijigaijo y'Abaisraeli zaaba shekeli rukumi na magana ashatu na makumi mukaaga na itaano, nka shekeli ey'Omwanya ogurikwera oku eri. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Musa yaaha Arooni n'abatabani ezo feeza z'okucungura, nk'ekigambo eki MUKAMA yaaragiire oku kyabaire kiri.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">Endiijo mirimo y'Abaleevi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />Kandi MUKAMA yaagambira Musa na Arooni ati: <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />Mubare beene Kohasi, mubashoroore omu Baleevi, mubabare nk'emiryango yaabo oku eri, n'amaju ga baishenkurubo oku gari, <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />okwiha aha bahikize emyaka makumi ashatu, abatakarengize myaka makumi ataano, boona abarikubaasa kuza omu buheereza obwo, kukora omurimo gw'Eihema ry'okubugaabuganiramu. <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />Ogu nigwo murimo gwa beene Kohasi, ogu bashemereire kukora omu Ihema ry'okubugaabuganiramu; ogwo murimo n'ogw'ebintu birikwera munonga. <verse eid="NUM 4:4" /><verse number="5" style="v" sid="NUM 4:5" />Ab'omu rusiisira ku baryenda kwimutsya orugyendo, Arooni n'abatabani bataahemu, bahanure omukingo ogukingiire Aharikwera munonga, bagushwekye eshanduukye erimu Ebirikuhamya, <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />bashwekyeho eky'okushweka ky'empu z'engongi, nakyo bakiteho omwenda gwa bururu gwonka, bwanyima bate emigamba omu bifunga byayo. <verse eid="NUM 4:6" /><verse number="7" style="v" sid="NUM 4:7" />Kandi aha meeza y'emigaati y'okumurika bateho omwenda gwa bururu, baguteho enyabya n'ebikopo n'ebakuri n'emidumo y'okushukisa empongano z'eby'okunywa; kandi emigaati y'obutoosha nayo ebeho; <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />babishwekye omwenda gurikutukura, nagwo baguteho eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byayo. <verse eid="NUM 4:8" /><verse number="9" style="v" sid="NUM 4:9" />Kandi batware omwenda gwa bururu, bagushwekye ekikondo ky'etabaaza n'amatabaaza gaakyo n'empana zaakyo n'otusohaani twago, n'ebintu byakyo eby'okushukisa amajuta, ebi barikukoresa omurimo gwakyo; <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />bakikomerane n'ebintu byakyo byona omu ky'okushweka ky'empu z'engongi, babite aha biti by'okubiheekyesa. <verse eid="NUM 4:10" /><verse number="11" style="v" sid="NUM 4:11" />Kandi ekyoterero ky'ezaabu bakishwekye omwenda gwa bururu, baguteho eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byakyo. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Kandi bareete ebintu ebi barikukoresa byona, ebiri kukoresibwa omu Mwanya ogurikwera, babikome omu mwenda gwa bururu, babishwekye eky'okushweka ky'empu z'engongi, babite aha biti by'okubiheekyesa. <verse eid="NUM 4:12" /><verse number="13" style="v" sid="NUM 4:13" />Kandi bayoore eiju aha itambiro, bariteho omwenda gwa bujwa, <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />bariteho n'ebintu byaryo byona, ebi barikukoresa emirimo yaaryo, n'eby'okuguhisa omuriro gw'amakara n'eby'okwihuza enyama, n'eby'okuyooreraho eiju, n'eby'okuriyooresa, n'enyabya, ebintu eby'eitambiro byona; babishwekye eky'okushweka ky'empu z'engongi, bate emigamba omu bifunga byaryo. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />Arooni n'abatabani ku bariguma baaheza kushweka eby'Omwanya ogurikwera n'ebirikukoresibwaho byona, ab'omu rusiisira baaba nibenda kwimutsya orugyendo, bwanyima beene Kohasi babone kwija kubiheeka; kwonka batarikora aha birikwera, batakaafa. Ebyo nibyo bintu by'omu Ihema ry'okubugaabuganiramu ebiriheekwa beene Kohasi.<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />Kandi Eleazaari mwene Arooni omunyamurwa akwatsibwe amajuta g'okuhemba, n'obubaane burikutaamirana, n'empongano y'esaano y'obutoosha, n'amajuta ag'okushukaho ahabw'okushoroora; kandi akwatsibwe n'Obutaaho bwona n'ebirimu byona, n'Omwanya ogurikwera n'ebintu byaho.<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />Kandi MUKAMA yaagambira Musa na Arooni ati: <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />Mutareka omuryango gw'aba Kohasi kuhwerekyerezibwa, bakahwaho omu Baleevi; <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />oku mube nikwo mwabatwaza, babone kugumaho, barekye kufa baahika aha bintu ebirikwera munonga. Arooni n'abatabani bagume bataahemu, baragiire buri omwe omurimo gwe n'eki ashemereire kutwara; <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" /><note caller="-" style="x"><char style="xo" closed="false">4:20: </char><char style="xt" closed="false"><ref loc="EXO 19:21">Kur 19:21</ref>; <ref loc="1SA 6:19">1 Sam 6:19</ref>. </char></note> kwonka bataritaahamu bakareeba Aharikwera, n'obu kaakuba akaanya akarikwingana busha, batakaafa.<verse eid="NUM 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />MUKAMA yaagira Musa ati: <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />Kandi obare beene Gereshomu nabo, nk'amaju ga baishenkurubo oku gari, n'emiryango yaabo oku eri; <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />obare boona abahikize emyaka makumi ashatu, abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'Eihema ry'okubugaabuganiramu. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />Ogu nigwo murimo gw'emiryango y'aba Gereshoni omu kuheereza n'omu kuheeka ebintu; <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />baryaguma baheekye emikingo y'Obutaaho, n'Eihema ry'okubugaabuganiramu, n'eby'okurishakaara, n'eky'okushwekaho eky'empu z'engongi ekibishwekire, n'omukingo gw'omuryango gw'Eihema ry'okubugaabuganiramu, <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />n'emikingo y'orugo, n'omukingo ogurikukinga eirembo ry'orugo orwehinguririize ekibuga ekirimu Obutaaho n'eitambiro, n'emirunga yaayo n'ebintu ebirikukoresibwa byona; babe nibo baakora emirimo yaabyo yoona. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Arooni n'abatabani nibo bariguma nibaragiira beene Gereshoni emirimo yaabo yoona omu bi bariba nibaheeka byona, n'omu kuheereza kwabo kwona; mubakwatse ebi bashemereire kuheeka byona. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Obwo nibwo buheereza bw'emiryango ya beene Gereshoni omu by'Eihema ry'okubugaabuganiramu; omu mirimo yaabo baryaguma nibareebererwa Itamaari mwene Arooni omunyamurwa.<verse eid="NUM 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />Ebya beene Merari, oryababara nk'emiryango yaabo oku eri n'amaju ga baishenkurubo oku gari; <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />obare boona abahikize emyaka makumi ashatu, abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'Eihema ry'okubugaabuganiramu. <verse eid="NUM 4:30" /><verse number="31" style="v" sid="NUM 4:31" />Ebi babe nibyo baakwatsibwa kuheeka omu buheereza bwabo bwona obw'omu by'Eihema ry'okubugaabuganiramu; embaaho z'obutaaho, embazi zaazo, n'enyomyo zaazo n'ebiina byazo, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />kandi n'enyomyo z'orugo orwehinguririize obwo Butaaho n'ebiina byazo n'enkondo zaazo n'emirunga yaazo, n'ebintu byabyo byona ebirikukoresibwa omu buheereza bwabo bwona; kandi mugambe amaziina g'ebintu ebi omuntu weena ashemereire kuheeka. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Obwo nibwo buheereza bw'emiryango ya beene Merari, nk'emirimo yaabo yoona oku eri omu by'Eihema ry'okubugaabuganiramu, nibareebererwa Itamaari mwene Arooni omunyamurwa.<verse eid="NUM 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Musa na Arooni n'abakuru b'eihanga ryona baabara beene Kohasi nk'emiryango yaabo oku eri, n'amaju ga baishenkurubo oku gari, <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" /><note caller="-" style="x"><char style="xo" closed="false">4:35: </char><char style="xt" closed="false"><ref loc="1TI 3:6">1 Tim 3:6</ref>. </char></note> baabara abahikize emyaka makumi ashatu abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'Eihema ry'okubugaabuganiramu. <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />Abaabazirwe omuribo nk'emiryango yaabo oku eri baaba enkumi ibiri na magana mushanju na makumi ataano. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Abo nibo baabazirwe omu miryango y'aba Kohasi, boona abaabaire nibakora omurimo gw'eby'Eihema ry'okubugaabuganiramu, abu Musa na Arooni baabazire, nk'oku MUKAMA yaaragiire naaraba omuri Musa.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />Kandi abaabazirwe ahari beene Gereshoni, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />abahikize emyaka makumi ashatu abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'eby'Eihema ry'okubugaabuganiramu, <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />abaabazirwe aharibo nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, baaba enkumi ibiri na magana mukaaga na makumi ashatu. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Abo nibo baabazirwe omu miryango ya beene Gereshoni, boona abaabaire bakora omurimo gw'eby'Eihema ry'okubugaabuganiramu, abu Musa na Arooni baabazire, nk'oku MUKAMA yaaragiire.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />Kandi abaabazirwe omu miryango ya beene Merari, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />abahikize emyaka makumi ashatu, abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'eby'Eihema ry'okubugaabuganiramu, <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />abaabazirwe nk'emiryango yaabo oku yaabaire eri, baaba enkumi ishatu na magana abiri. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Abo nibo baabazirwe omu miryango ya beene Merari, abu Musa na Arooni baabazire nk'oku MUKAMA yaaragiire naaraba omuri Musa.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Boona abaabazirwe aha Baleevi, abu Musa na Arooni n'abakuru b'Abaisraeli baabazire, nk'emiryango yaabo oku yaabaire eri, n'amaju ga baishenkurubo oku gaabaire gari, <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />abahikize emyaka makumi ashatu, abatakarengize makumi ataano, boona abarikubaasa kuza omu buheereza obwo kukora omurimo gw'eby'Eihema ry'okubugaabuganiramu, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />abaabazirwe aharibo baaba enkumi munaana na magana ataano na makumi munaana. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />Nk'oku MUKAMA yaaragiire naaraba omuri Musa, buri muntu yaakwatsibwa omurimo gwe ogw'obuheereza nari ogw'okwekorera. Musa nikwo yaababazire atyo, nk'oku MUKAMA yaamuragiire.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">Ebiragiro by'okushemeza orusiisira</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />Kandi MUKAMA yaagira Musa ati: <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" /><note caller="-" style="x"><char style="xo" closed="false">5:2: </char><char style="xt" closed="false"><ref loc="LEV 13:3">Lev 13:3</ref>, <ref loc="LEV 13:46">46</ref>; <ref loc="2CH 26:20">2 Bus 26:20</ref>; <ref loc="ISA 52:11">Isa 52:11</ref>. </char></note> Ragiira Abaisraeli baihe omu rusiisira omubembe weena, na buri muntu orikureeta amahira, n'osiisikaire ahabw'omutumbi; <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" /><note caller="-" style="x"><char style="xo" closed="false">5:3: </char><char style="xt" closed="false"><ref loc="JHN 14:17">Yoh 14:17</ref>, <ref loc="JHN 14:23">23</ref>; <ref loc="2CO 6:16">2 Kor 6:16</ref>. </char></note> mwihe abashaija n'abakazi omu rusiisira, mubate aheeru yaarwo, barekye kushiisha orusiisira rwabo, oruntuura ahagati. <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />Abaisraeli baakora batyo, baabaihamu, baabata aheeru y'orusiisira. Nka MUKAMA oku yaagambiire Musa, Abaisraeli baaba nikwo baakora.<verse eid="NUM 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />MUKAMA yaagira Musa ati: <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />Gambira Abaisraeli oti: Omushaija nari omukazi ku arikora ekibi kyona eki abantu bakora, bakacumura ahari MUKAMA, yaagiibwaho orubanja, <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />ayature ekibi eki akozire, arihe ekimureeteire orubanja ataine ki atsigireyo, akihe ou akozire kubi, kandi akyongyereho ekicweka kyakyo kya kataano. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Kwonka ogwo ou akozire kubi, ku ariba ataine waabo ow'okurihwa, egyo ndihano erihwe MUKAMA, ebe ey'omunyamurwa, kandi eyongyerweho empaya y'entaama ey'okurihiirira, ei baraamurihiirire. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Kandi buri mpongano y'ebintu ebirikwera ebi Abaisraeli barireetera omunyamurwa eryaba eye. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Ebirikwera byona ebi omuntu ashoroire biryaba eby'omunyamurwa; eki omuntu ariha omunyamurwa kyona, kiryaba ekye.<verse eid="NUM 5:10" /></para>
  <para style="s1">Emitwarize ey'okushoora omukazi ou barikuteekateekaho ngu ashambaine</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />MUKAMA yaagira Musa ati: <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" /><note caller="-" style="x"><char style="xo" closed="false">5:12: </char><char style="xt" closed="false"><ref loc="HOS 4:13">Hos 4:13</ref>. </char></note> Gambira Abaisraeli oti: Muka mushaija ku aryekiika aha rubaju, yaakora ekitari ky'obwesigwa ahari iba, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />omushaija ondi yaabyama nawe, kyasherekwa iba ataakimanya, ogwo mukazi yaasiisikara, hataine orikumushinja ahabw'okutagira omukwatsire naakikora; <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" /><note caller="-" style="x"><char style="xo" closed="false">5:14: </char><char style="xt" closed="false"><ref loc="PRO 6:34">Enf 6:34</ref>. </char></note> iba yaagira omutima gw'obufuuhi, yaafuuhira omukazi we, n'obu yaakuba atasiisire, <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />obwo ogwo mushaija aryatwara omukazi we aha munyamurwa, ayereetere empongano, ey'ekicweka kimwe kya ikumi ekya eefa y'esaano ya sayiri; atarigishukaho amajuta n'obu bwakuba obubaane bwa lebona, ahabw'okuba n'empongano y'esaano ahabw'obufuuhi, empongano y'esaano ey'ekiijutsyo eky'okwijutsya okutahikiirira. <verse eid="NUM 5:15" /><verse number="16" style="v" sid="NUM 5:16" />Omunyamurwa airize haihi ogwo mukazi, amute omu maisho ga MUKAMA; <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />omunyamurwa atware amaizi garikwera omu rwabya rw'eibumba, atware aha mucuucu gw'ahansi omu Butaaho, agute omuri ago maizi; <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />kandi ate ogwo mukazi omu maisho ga MUKAMA, azingurure eishokye ry'aha mutwe gwe, amute omu ngaro egyo mpongano y'ekiijutsyo, empongano y'esaano ahabw'obufuuhi; kandi omunyamurwa akwate omu ngaro ago maizi garikushaarira, agari kureeta omukyeeno. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Bwanyima arahize ogwo mukazi, naamugira ati: Ku oraabe otaine mushaija ou oshambaine nawe, oteekiikire okeeshiisha, haza nookitegyekwa baro, aga maizi garikushaarira, agarikureeta omukyeeno, garekye kugira eki gaakukoraho. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Kwonka ku oraabe oyekiikire nookitegyekwa baro, okeeshiisha, okabyama n'ondiijo mushaija otari baro; <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" /><note caller="-" style="x"><char style="xo" closed="false">5:21: </char><char style="xt" closed="false"><ref loc="GEN 9:25">Kut 9:25</ref>; <ref loc="JOS 6:26">Yos 6:26</ref>. </char></note> omunyamurwa arahize ogwo mukazi endahiro y'okukyeenwa, amugire ati: MUKAMA akuhindure eky'okukyeenwa kandi eky'okurahira omu ihanga ryawe, ku araanyuunyuure ekibero kyawe, yaakuhazya enda; <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" /><note caller="-" style="x"><char style="xo" closed="false">5:22: </char><char style="xt" closed="false"><ref loc="DEU 27:15">Bir 27:15</ref>. </char></note> kandi amaizi aga agarikureeta omukyeeno nigaija kukuza omu mara, gakuhazye enda, gakunyuunyuure ekibero. Ogwo mukazi aikirize ati: <note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">Amiina, amakuru gaakyo ngu: Kibe kityo. </char></note>Amiina! Amiina.<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />Bwanyima ogwo munyamurwa ahandiikye ebigambo by'egyo mikyeeno omu kitabo, abyozye n'amaizi, gaze omuri ago agarikushaarira, <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />anywaise ogwo mukazi ago maizi garikushaarira agarikureeta omukyeeno; ago maizi agarikureeta omukyeeno gamuze omunda, gaamushaarire. <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />Omunyamurwa aihe omu ngaro z'ogwo mukazi egyo mpongano y'esaano ahabw'obufuuhi, agizongazonzye omu maisho ga MUKAMA, agitware aha itambiro; <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />aihe ahari egyo mpongano oruhi rwayo, rube ekiijutsyo kyayo, orwo ruhi rw'esaano arwokyeze aha itambiro, abone kunywaisa ogwo mukazi ago maizi. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />Ku ariheza kugamunywaisa, biryaba biti: ku ariba ayesiisire, akozire ebitari by'obwesigwa ahari iba, ago maizi agarikureeta omukyeeno garyamuza omunda, gamushaarire, ahagye enda, ekibero kye kinyuunyuukye; ogwo mukazi ahindukye eky'okukyeenwa omu ihanga rye. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" /><note caller="-" style="x"><char style="xo" closed="false">5:28: </char><char style="xt" closed="false"><ref loc="PSA 37:5">Zab 37:5</ref>, <ref loc="PSA 37:6">6</ref>. </char></note> Kwonka ku ariba ateesiisire, yaashangwa ari oshemeire, tihaine kirimubaho; aryarekurwa, azaare abaana.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 5:29" />Ekyo nikyo kiragiro ky'obufuuhi aha mukazi oine iba orikwekiika, akeeshiisha; <verse eid="NUM 5:29" /><verse number="30" style="v" sid="NUM 5:30" />n'aha mushaija owaagira omutima gw'obufuuhi, akafuuhira omukazi we; obwo aryareeta omukazi we omu maisho ga MUKAMA, omunyamurwa amukorere eby'emigyenzo y'ekyo kiragiro byona. <verse eid="NUM 5:30" /><verse number="31" style="v" sid="NUM 5:31" /><note caller="-" style="x"><char style="xo" closed="false">5:31: </char><char style="xt" closed="false"><ref loc="ROM 2:8">Rom 2:8</ref>, <ref loc="ROM 2:9">9</ref>. </char></note> Omushaija aryaihwaho okutahikiirira kwe, kwonka omukazi okutahikiirira kuryamugumaho.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">Ebiragiro by'Abanaziiri</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />MUKAMA yaagira Musa ati: <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" /><note caller="-" style="x"><char style="xo" closed="false">6:2: </char><char style="xt" closed="false"><ref loc="JDG 13:4">Bar 13:4</ref>, <ref loc="JDG 13:5">5</ref>; <ref loc="LUK 1:15">Luk 1:15</ref>. </char></note> Gambira Abaisraeli oti: Omushaija nari omukazi ku arihiga okuhiga okutari kw'obutoosha okw'Omunaziiri, naaraganisa kweshoroorera MUKAMA, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />ayetaanise na viinyo n'eky'okunywa ky'amaani, atarinywa viinyo erikushaarira, nari eky'okunywa ky'amaani kyona ekirikushaarira, n'obu kwakuba okunywa eky'okunywa kyona ekirikuruga omu mizaabibu, nari okurya ebijuma byayo ebibisi nari ebyomire. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />Ebiro byona ebi arimara omu bunaziiri atarirya ekintu kyona ekirikuruga omu muzaabibu, okuruga aha mbibo zaayo okuhika aha kishushu kyayo.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 1:11">1 Sam 1:11</ref>. </char>
    </note> Ebiro byona ebi arimara omu bunaziiri, orumweiso rutarimuraba aha mutwe; aryaba orikwera, arekye obutsibo bw'eishokye rye bukure, okuhitsya obu ebiro by'okweshoroora kwe ahari MUKAMA birihwaho.<verse eid="NUM 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 6:6" />Ebiro byona eby'okweshoroora kwe ahari MUKAMA atarihika aha mutumbi. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />Ishe nari nyina nari mwene nyina nari munyaanya, ku arifa, ataryeshiisha ahabw'orufu rwabo, ahabw'okuba okweshoroora kwe ahari Ruhanga kuri aha mutwe gwe. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />Ebiro byona ebi arimara omu bunaziiri aryaba oyereziibwe MUKAMA. <verse eid="NUM 6:8" /><verse number="9" style="v" sid="NUM 6:9" />Ku harigira omuntu yaamukinukira aha rubaju, yaashiisha omutwe gw'obunaziiri bwe, aryamwa eishokye rye aha izooba ry'okushemezibwa kwe; aha kiro kya mushanju niho aririmwera. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Kandi aha kiro kya munaana aryareeta obwiba bubiri nari enkombe nto ibiri, abiheere omunyamurwa aha muryango gw'Eihema ry'okubugaabuganiramu, <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />omunyamurwa ahongyeho emwe kuba ekitambo ky'ekibi, n'endi okuba ekitambo eky'okwotsya, amurihiirire, ahabw'okuba asiisire ahabw'omufu. Bwanyima ahari eryo izooba ayeze omutwe gwe, <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />ayeshoroore ahari MUKAMA okumara ebiro byona eby'obunaziiri bwe, areete empaya nto y'entaama ehikize omwaka kuba ekitambo ky'okwihaho orubanja; ahakuba ebiro bye eby'okubanza biryaba bifiire busha, ahabw'okuba obunaziiri bwe busiisikaire.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:13: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 21:26">Byak 21:26</ref>. </char>
    </note> Eki nikyo kiragiro ky'Omunaziiri, ebiro by'obunaziiri bwe ku birihwa. Aryareetwa aha muryango gw'Eihema ry'okubugaabuganiramu, <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />ahongyere MUKAMA empongano ze, empaya nto y'entaama emwe ehikize omwaka etaine kamogo kuba ekitambo ky'okwotsya, omwagazi gw'entaama gumwe oguhikize omwaka ogutaine kamogo kuba ekitambo ky'ekibi, empaya y'embuzi emwe etaine kamogo kuba ekitambo ky'okusiima ahabw'obusingye, <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" /><note caller="-" style="x"><char style="xo" closed="false">6:15: </char><char style="xt" closed="false"><ref loc="EXO 29:2">Kur 29:2</ref>. </char></note> ekiibo ky'emigaati etatumbisiibwe otukeeki tw'esaano y'obunono ejwangize n'amajuta, na capati ezitatumbisiibwe ezisiigirwe amajuta, hamwe n'empongano zaabyo z'esaano n'ez'eby'okunywa. <verse eid="NUM 6:15" /><verse number="16" style="v" sid="NUM 6:16" />Omunyamurwa abimurikye omu maisho ga MUKAMA, amuhongyerere ekitambo kye ky'ekibi n'eky'okwotsya, <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />kandi ahongyere MUKAMA egyo mpaya y'entaama kuba ekitambo ky'empongano z'okusiima ahabw'obusingye, abihongye n'ekiibo ky'egyo migaati etatumbisiibwe; kandi omunyamurwa ahongye empongano zaabyo ez'esaano n'ez'eby'okunywa. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" /><note caller="-" style="x"><char style="xo" closed="false">6:18: </char><char style="xt" closed="false"><ref loc="ACT 21:24">Byak 21:24</ref>. </char></note> Obwo ogwo Munaziiri amwe eishokye aha mutwe gwe ogw'obunaziiri, arimwere aha muryango gw'Eihema ry'okubugaabuganiramu, atware eryo ishokye ry'aha mutwe gwe ogw'obunaziri, arite aha muriro oguri ahansi y'ekitambo ky'empongano z'okusiima ahabw'obusingye. <verse eid="NUM 6:18" /><verse number="19" style="v" sid="NUM 6:19" />Omunyamurwa atware ekivune ky'omukono ky'egyo mpaya y'entaama kiteekire, aihe akakeeki kamwe akatatumbisiibwe omuri ekyo kiibo, na capati emwe etatumbisiibwe, abite omu ngaro z'ogwo Munaziiri, yaaheza kumwa eishokye ry'aha mutwe gwe ogw'obunaziiri; <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" /><note caller="-" style="x"><char style="xo" closed="false">6:20: </char><char style="xt" closed="false"><ref loc="ISA 35:10">Isa 35:10</ref>. </char></note> omunyamurwa abizongazonzye omu maisho ga MUKAMA; bibe omugabo gw'omunyamurwa ogurikwera, hamwe n'enkoro ezongazongiibwe n'ekivune ky'okuguru ekihongirwe. Ebyo ku birihwa, Omunaziiri abone kunywa viinyo. <verse eid="NUM 6:20" /><verse number="21" style="v" sid="NUM 6:21" />Ekyo nikyo kiragiro ky'Omunaziiri orikuhiga, n'eky'empongano ezi arihongyera MUKAMA ahabw'obunaziiri bwe, otabariiremu ebi arikubaasa kuhonga ahabw'okweyendera; okuhiga oku yaahigire akuhikiirize, nk'ekiragiro ky'obunaziiri bwe oku kiri.<verse eid="NUM 6:21" /></para>
  <para style="s1">Omugisha ogu abanyamurwa baabaire bashabira Abaisraeli</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />MUKAMA yaagira Musa ati: <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />Gambira Arooni n'abatabani oti: Oku nikwo muriguma nimushabira Abaisraeli omugisha, nimugira muti:<verse eid="NUM 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 6:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:24: </char>
      <char style="xt" closed="false">
        <ref loc="1PE 1:5">1 Pet 1:5</ref>. </char>
    </note> MUKAMA akuhe omugisha, akurinde.<verse eid="NUM 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 6:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:3">Zab 80:3</ref>. </char>
    </note> MUKAMA akwakize omushana gw'amaisho ge, akugirire embabazi.<verse eid="NUM 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 6:26" />MUKAMA akwimukize amaisho ge, akuhe obusingye. <verse eid="NUM 6:26" /><verse number="27" style="v" sid="NUM 6:27" /><note caller="-" style="x"><char style="xo" closed="false">6:27: </char><char style="xt" closed="false"><ref loc="DEU 28:10">Bir 28:10</ref>; <ref loc="PSA 115:12">Zab 115:12</ref>. </char></note> Okwo nikwo bariguma nibata eiziina ryangye aha Baisraeli; naanye ndyaguma mbahe omugisha.<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">Empongano z'abakuru b'eihanga ezi baahongire nibashoroora eitambiro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Musa ku yaaherize kwimutsya Obutaaho, n'okubushukaho amajuta g'okubushoroora, n'okubweza n'ebintu byabwo byona, n'eitambiro n'ebintu byaryo byona, nabyo yaaheza kubishukaho amajuta g'okubishoroora, n'okubyeza, <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" /><note caller="-" style="x"><char style="xo" closed="false">7:2: </char><char style="xt" closed="false"><ref loc="2CH 35:8">2 Bus 35:8</ref>; <ref loc="NEH 7:70-72">Neh 7:70-72</ref>. </char></note> ahari eryo izooba abeebembezi ba Israeli, abakuru b'amaju ga baishenkurubo, nabo baahonga empongano; abo nibo beebembezi b'enganda, abaabaire nibategyeka abaabazirwe; <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />baareeta empongano zaabo omu maisho ga MUKAMA, ebigaari mukaaga ebiine ekisanga ahaiguru n'enimi ikumi na ibiri, ekigaari kimwe ahabw'abeebembezi babiri, n'enimi emwe ahabwa buri mwebembezi; baabimurika omu maisho g'Obutaaho. <verse eid="NUM 7:3" /><verse number="4" style="v" sid="NUM 7:4" />MUKAMA yaagira Musa ati: <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />Ikiriza ebi, ebi baahonga, bibe eby'okukoresibwa emirimo y'eby'Eihema ry'okubugaabuganiramu, obihe Abaleevi, nk'obuheereza bwa buri muntu oku buri. <verse eid="NUM 7:5" /><verse number="6" style="v" sid="NUM 7:6" />Musa nikwo kwakiira ebyo bigaari n'ezo nimi, akabiha Abaleevi. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Ebigaari bibiri n'enimi ina yaabiha beene Gereshoni, nk'obuheereza bwabo oku buri; <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />ebigaari bina n'enimi munaana yaabiha beene Merari, nk'obuheereza bwabo oku buri, okureebererwa Itamaari mwene Arooni omunyamurwa. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Kwonka beene Kohasi tiyaagira ki yaabaha, ahabw'okuba bakakwatsibwa obuheereza bw'eby'Omwanya ogurikwera kuguma nibabiheeka aha mabega. <verse eid="NUM 7:9" /><verse number="10" style="v" sid="NUM 7:10" />Kandi abo beebembezi baahonga empongano z'okweza eitambiro aha izooba eri ryashukiirweho amajuta g'okurishoroora, baazihongyera omu maisho gaaryo. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />MUKAMA yaagambira Musa ati: Bagume bareete empongano zaabo z'okweza eitambiro, buri mwebembezi aha izooba rye.<verse eid="NUM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 7:12" />Owaareetsire empongano ye aha kiro ky'okubanza ni Nahashooni mwene Aminadabu ow'omu ruganda rwa Yuda. <verse eid="NUM 7:12" /><verse number="13" style="v" sid="NUM 7:13" />Empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane, <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka gumwe, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />n'empaya y'embuzi emwe kuba ekitambo ky'ekibi; <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />kandi enimi ibiri, empaya z'entaama itaano, ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka gumwe kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Nahashooni mwene Aminadabu.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 7:18" />Aha kiro kya kabiri Netaneeli mwene Zuari omwebembezi w'Abaisakaari yaaba niwe yaahonga; <verse eid="NUM 7:18" /><verse number="19" style="v" sid="NUM 7:19" />empongano ye ei yaahongire, ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano, <verse eid="NUM 7:19" /><verse number="20" style="v" sid="NUM 7:20" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane, <verse eid="NUM 7:20" /><verse number="21" style="v" sid="NUM 7:21" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka gumwe, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:21" /><verse number="22" style="v" sid="NUM 7:22" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:22" /><verse number="23" style="v" sid="NUM 7:23" />kandi enimi ibiri, empaya z'entaama itaano, ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Netaneeli mwene Zuari.<verse eid="NUM 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 7:24" />Aha kiro kya kashatu Eliabu mwene Helooni, omwebembezi w'Abazebuluuni, yaaba niwe yaahonga; <verse eid="NUM 7:24" /><verse number="25" style="v" sid="NUM 7:25" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:25" /><verse number="26" style="v" sid="NUM 7:26" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:26" /><verse number="27" style="v" sid="NUM 7:27" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:27" /><verse number="28" style="v" sid="NUM 7:28" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:28" /><verse number="29" style="v" sid="NUM 7:29" />kandi enimi ibiri, empaya z'entaama itaano, ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Eliabu mwene Helooni.<verse eid="NUM 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 7:30" />Aha kiro kya kana Elizuuri mwene Shedeuri, omwebembezi w'Abareubeeni yaaba niwe yaahonga; <verse eid="NUM 7:30" /><verse number="31" style="v" sid="NUM 7:31" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:31" /><verse number="32" style="v" sid="NUM 7:32" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:32" /><verse number="33" style="v" sid="NUM 7:33" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:33" /><verse number="34" style="v" sid="NUM 7:34" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:34" /><verse number="35" style="v" sid="NUM 7:35" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Elizuuri mwene Shedeuri.<verse eid="NUM 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 7:36" />Aha kiro kya kataano Shelumieli mwene Zuri-shadai, omwebembezi w'Abasimeoni, yaaba niwe yaahonga; <verse eid="NUM 7:36" /><verse number="37" style="v" sid="NUM 7:37" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:37" /><verse number="38" style="v" sid="NUM 7:38" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:38" /><verse number="39" style="v" sid="NUM 7:39" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:39" /><verse number="40" style="v" sid="NUM 7:40" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:40" /><verse number="41" style="v" sid="NUM 7:41" />kandi enimi ibiri, empaya z'entaama itaano, n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Shelumieli mwene Zuri-shadai.<verse eid="NUM 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 7:42" />Aha kiro kya mukaaga Eliasaafu mwene Deueli, omwebembezi w'Abagaadi, yaaba niwe yaahonga; <verse eid="NUM 7:42" /><verse number="43" style="v" sid="NUM 7:43" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:43" /><verse number="44" style="v" sid="NUM 7:44" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:44" /><verse number="45" style="v" sid="NUM 7:45" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:45" /><verse number="46" style="v" sid="NUM 7:46" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:46" /><verse number="47" style="v" sid="NUM 7:47" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Eliasaafu mwene Deueli.<verse eid="NUM 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 7:48" />Aha kiro kya mushanju Elishaama mwene Amihuudi, omwebembezi w'Abaefuraimu, yaaba niwe yaahonga; <verse eid="NUM 7:48" /><verse number="49" style="v" sid="NUM 7:49" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:49" /><verse number="50" style="v" sid="NUM 7:50" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:50" /><verse number="51" style="v" sid="NUM 7:51" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:51" /><verse number="52" style="v" sid="NUM 7:52" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:52" /><verse number="53" style="v" sid="NUM 7:53" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Elishaama mwene Amihuudi.<verse eid="NUM 7:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="NUM 7:54" />Aha kiro kya munaana Gamalieli mwene Pedazuuri, omwebembezi w'Abamanaase, yaaba niwe yaahonga; <verse eid="NUM 7:54" /><verse number="55" style="v" sid="NUM 7:55" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:55" /><verse number="56" style="v" sid="NUM 7:56" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:56" /><verse number="57" style="v" sid="NUM 7:57" />enimi y'ekimasha emwe, empaya y'entaama emwe n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:57" /><verse number="58" style="v" sid="NUM 7:58" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:58" /><verse number="59" style="v" sid="NUM 7:59" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezi nizo mpongano za Gamalieli mwene Pedazuuri.<verse eid="NUM 7:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="NUM 7:60" />Aha kiro kya mwenda Abidaani mwene Gideoni, omwebembezi w'Ababenyamiini, yaaba niwe yaahonga; <verse eid="NUM 7:60" /><verse number="61" style="v" sid="NUM 7:61" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:61" /><verse number="62" style="v" sid="NUM 7:62" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:62" /><verse number="63" style="v" sid="NUM 7:63" />enimi y'ekimasha emwe, empaya y'entaama emwe n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:63" /><verse number="64" style="v" sid="NUM 7:64" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:64" /><verse number="65" style="v" sid="NUM 7:65" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Abidaani mwene Gideoni.<verse eid="NUM 7:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="NUM 7:66" />Aha kiro kya ikumi Ahiezeeri mwene Ami-Shadai, omwebembezi w'Abadaani, yaaba niwe yaahonga; <verse eid="NUM 7:66" /><verse number="67" style="v" sid="NUM 7:67" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:67" /><verse number="68" style="v" sid="NUM 7:68" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:68" /><verse number="69" style="v" sid="NUM 7:69" />enimi y'ekimasha emwe, empaya y'entaama emwe n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:69" /><verse number="70" style="v" sid="NUM 7:70" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:70" /><verse number="71" style="v" sid="NUM 7:71" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Ahiezeeri mwene Ami-shadai.<verse eid="NUM 7:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="NUM 7:72" />Aha kiro kya ikumi na kimwe Pagieli mwene Okiraane omwebembezi w'Abaasheri, yaaba niwe yaahonga; <verse eid="NUM 7:72" /><verse number="73" style="v" sid="NUM 7:73" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju, nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:73" /><verse number="74" style="v" sid="NUM 7:74" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi, kiijwire obubaane; <verse eid="NUM 7:74" /><verse number="75" style="v" sid="NUM 7:75" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:75" /><verse number="76" style="v" sid="NUM 7:76" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:76" /><verse number="77" style="v" sid="NUM 7:77" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka, kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Pagieli mwene Okiraane.<verse eid="NUM 7:77" /></para>
  <para style="p">
    <verse number="78" style="v" sid="NUM 7:78" />Aha kiro kya ikumi na bibiri Ahiira mwene Enani, omwebembezi w'Abanafutaali, yaaba niwe yaahonga; <verse eid="NUM 7:78" /><verse number="79" style="v" sid="NUM 7:79" />empongano ye ekaba eri eshohaani y'efeeza, oburemeezi bwayo shekeli igana na makumi ashatu, n'orwabya rw'efeeza, oburemeezi bwarwo shekeli makumi mushanju nka shekeli ey'Omwanya ogurikwera oku eri, byombi biijwire esaano y'obunono ejwangize n'amajuta kuba empongano y'esaano; <verse eid="NUM 7:79" /><verse number="80" style="v" sid="NUM 7:80" />n'ekikopo ky'ezaabu ekiine oburemeezi bwa shekeli ikumi kiijwire obubaane; <verse eid="NUM 7:80" /><verse number="81" style="v" sid="NUM 7:81" />enimi y'ekimasha emwe, empaya y'entaama emwe, n'empaya nto y'entaama ehikize omwaka, kuba ekitambo ky'okwotsya; <verse eid="NUM 7:81" /><verse number="82" style="v" sid="NUM 7:82" />n'empaya y'embuzi kuba ekitambo ky'ekibi; <verse eid="NUM 7:82" /><verse number="83" style="v" sid="NUM 7:83" />kandi enimi ibiri, empaya z'entaama itaano n'ez'embuzi itaano, n'empaya nto z'entaama itaano ezihikize omwaka, kuba ekitambo ky'empongano z'okusiima ahabw'obusingye; ezo nizo mpongano za Ahiira mwene Enani.<verse eid="NUM 7:83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />Ezi nizo mpongano zoona abeebembezi b'Abaisraeli ezi baahongire ahabw'okweza eitambiro, aha izooba eri ryashukiirweho amajuta g'okurishoroora, eshohaani z'efeeza ikumi na ibiri, enyabya z'efeeza ikumi na ibiri, n'ebikopo by'ezaabu ikumi na bibiri; <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />oburemeezi bwa buri shohaani y'efeeza bukaba buri shekeli igana na makumi ashatu, na buri rwabya shekeli makumi mushanju; efeeza z'ebyo bintu byona zaagira oburemeezi bwa shekeli enkumi ibiri na magana ana, nk'efeeza y'Omwanya ogurikwera oku eri; <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />kandi ebikopo by'ezaabu ikumi na bibiri ebiijwire obubaane, buri kimwe kikaba kiine oburemeezi bwa shekeli ikumi, nka shekeli ey'Omwanya ogurikwera oku eri, ezaabu yoona ey'ebyo bikopo yaagira oburemeezi bwa shekeli igana na makumi abiri; <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />kandi amatungo goona ag'ebitambo by'okwotsya, enimi z'ebimasha ikumi na ibiri, empaya z'entaama ikumi na ibiri, n'empaya nto z'entaama ezihikize omwaka ikumi na ibiri hamwe n'empongano zaabyo z'esaano; n'empaya z'embuzi z'ekitambo ky'ekibi ikumi na ibiri; <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />n'amatungo goona ag'ebitambo by'empongano z'okusiima ahabw'obusingye, enimi makumi abiri na ina, empaya z'entaama makumi mukaaga, n'ez'embuzi makumi mukaaga, n'empaya nto z'entaama ezihikize omwaka makumi mukaaga. Ezo nizo zaabaire ziri empongano z'okweza eitambiro, ryaheza kushukwaho amajuta g'okurishoroora.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />Musa ku yaataahire omu Ihema ry'okubugaabuganiramu kugamba na MUKAMA, yaahurira eiraka eririkugamba nawe, niriruga ahaiguru y'ekitebe ky'okusaasira, ekyabaire kiri aha shanduukye y'Ebirikuhamya ahagati ya baakerubi bombi; eryo iraka ryagamba nawe.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s1">Eby'okuhemba amatabaaza</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />MUKAMA yaagira Musa ati: <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" /><note caller="-" style="x"><char style="xo" closed="false">8:2: </char><char style="xt" closed="false"><ref loc="PSA 119:105">Zab 119:105</ref>; <ref loc="JHN 8:12">Yoh 8:12</ref>. </char></note> Gambira Arooni oti: Ku origuma waahemba etabaaza, ago matabaaza mushanju gagume gaakye, gahwezese omwanya oguri omu maisho g'ekikondo kyago. <verse eid="NUM 8:2" /><verse number="3" style="v" sid="NUM 8:3" />Arooni yaakora atyo; yaahemba ago mataabaza ngu gaakye, gahwezese omwanya oguri omu maisho g'ekikondo kyago, nk'oku MUKAMA yaaragiire Musa. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Oku nikwo ekikondo ky'amatabaaza kyaheesirwe, kikaheeshwa omu zaabu; okuruga aha kibunu kyakyo okuhika aha birabyo byakyo kyona kikaba kiheesirwe; nk'eky'okureeberaho, eki MUKAMA yaayorekire Musa, oku kyabaire kiri, nikwo yaaheesire ekyo kikondo ky'amatabaaza.<verse eid="NUM 8:4" /></para>
  <para style="s1">Okushoroorwa kw'Abaleevi n'obuheereza bwabo</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />MUKAMA yaagira Musa ati: <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" /><note caller="-" style="x"><char style="xo" closed="false">8:6: </char><char style="xt" closed="false"><ref loc="ISA 52:11">Isa 52:11</ref>. </char></note> Iha Abaleevi omu Baisraeli, obashemeze. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Oku nikwo oraabashemeze; obamiisiire amaizi ag'okubaihaho ekibi, bamwe emibiri yaabo yoona, boozye emyenda yaabo, beeshemeze. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Bwanyima batware enimi y'ekimasha n'empongano yaayo y'esaano y'obunono ejwangize n'amajuta; kandi naiwe otware endiijo nimi y'ekimasha kuba ekitambo ky'ekibi. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" /><note caller="-" style="x"><char style="xo" closed="false">8:9: </char><char style="xt" closed="false"><ref loc="LEV 8:3">Lev 8:3</ref>. </char></note> Oreete Abaleevi omu maisho g'Eihema ry'okubugaabuganiramu, oteeranire hamwe eihanga ryona erya Israeli, <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />omurikye Abaleevi omu maisho ga MUKAMA, Abaisraeli babateho engaro, <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Arooni ahongye Abaleevi omu maisho ga MUKAMA kuba empongano ezongazongiibwe omu mwanya gw'Abaisraeli, babe ab'okukora omurimo gw'okuheereza MUKAMA. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />Bwanyima Abaleevi bate engaro zaabo aha mitwe y'ezo nimi, emwe ogihongye kuba ekitambo ky'ekibi, endi kuba ekitambo ky'okwotsya ekihongyeirwe MUKAMA okurihiirira Abaleevi. <verse eid="NUM 8:12" /><verse number="13" style="v" sid="NUM 8:13" />Ote Abaleevi omu maisho ga Arooni n'abatabani, obahongyere MUKAMA kuba empongano ezongazongiibwe.<verse eid="NUM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 8:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:14: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 16:9">Kub 16:9</ref>. </char>
    </note> Okwo obe nikwo waashoroora Abaleevi omu Baisraeli abandi; Abaleevi babe abangye. <verse eid="NUM 8:14" /><verse number="15" style="v" sid="NUM 8:15" />Bwanyima y'okubeeza n'okubahonga kuba empongano ezongazongiibwe, Abaleevi bataahe bakore omurimo gw'obuheereza omu by'Eihema ry'okubugaabuganiramu. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" /><note caller="-" style="x"><char style="xo" closed="false">8:16: </char><char style="xt" closed="false"><ref loc="NUM 3:12">Kub 3:12</ref>, <ref loc="NUM 3:45">45</ref>. </char></note> Ahakuba mbaheereirwe kimwe kuruga omu Baisraeli; mbeetooraniire kuza omu mwanya gw'emijigaijo yoona ey'Abaisraeli; <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" /><note caller="-" style="x"><char style="xo" closed="false">8:17: </char><char style="xt" closed="false"><ref loc="EXO 13:2">Kur 13:2</ref>, <ref loc="EXO 13:12-15">12-15</ref>. </char></note> ahabw'okuba emijigaijo y'Abaisraeli yoona n'eyangye, ey'abantu n'ey'amatungo; nkagyeyereza aha izooba eri naitiireho emijigaijo yoona ey'omu nsi ya Misri. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Mbwenu ntooraine Abaleevi omu mwanya gw'emijigaijo yoona ey'Abaisraeli. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Kandi abo Baleevi mbaihire omu Baisraeli, naabaha Arooni n'abatabani nk'ekiconco, okukora omurimo gw'obuheereza omu by'Eihema ry'okubugaabuganiramu ahabw'Abaisraeli, n'okubarihiirira, ngu hataribaho orufu omu Baisraeli, ku bariba baahikire haihi n'Omwanya ogurikwera. <verse eid="NUM 8:19" /><verse number="20" style="v" sid="NUM 8:20" />Okwo nikwo Musa na Arooni n'eihanga ryona ery'Abaisraeli baatwarize Abaleevi; nk'oku MUKAMA yaaragiire Musa aha by'Abaleevi byona, Abaisraeli baaba nikwo baabatwaza. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Abaleevi baayeshemezaho ekibi, baayozya emyenda yaabo, Arooni yaabahonga omu maisho ga MUKAMA kuba empongano ezongazongiibwe, yaabarihiirira kubashemeza. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Bwanyima y'ebyo Abaleevi baabona kutaaha kukora omurimo gw'obuheereza omu by'Eihema ry'okubugaabuganiramu omu maisho ga Arooni n'abatabani; nk'oku MUKAMA yaabaire aragiire Musa aha by'Abaleevi, baaba nikwo baabatwaza.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />MUKAMA yaagira Musa ati: <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />Ebi ndikukugambira aha Baleevi n'ebi; baryatandika kutaaha omu buheereza bw'okukora omurimo gw'eby'Eihema ry'okubugaabuganiramu, bahikize emyaka makumi abiri n'etaano n'okukiraho; <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />kandi ku barihitsya emyaka makumi ataano, barekyere aho kukora omurimo gw'obwo buheereza ogurikurusya, barekye kugaruka kuheereza; <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" /><note caller="-" style="x"><char style="xo" closed="false">8:26: </char><char style="xt" closed="false"><ref loc="NUM 1:53">Kub 1:53</ref>. </char></note> kwonka bagume bahwere beene waabo omu by'Eihema ry'okubugaabuganiramu, okurinda ebi bakwatsiibwe, kwonka barekye kukora eby'obuheereza. Okwo obe nikwo waatwaza Abaleevi aha by'ebi bakwatsiibwe.<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s1">Ebindi biragiro by'Okuhingurwaho</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />MUKAMA yaagambirira Musa omu ihamba rya Sinai omu kwezi kw'okubanza okw'omu mwaka gwa kabiri, barugire omu nsi ya Misri, ati: <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" /><note caller="-" style="x"><char style="xo" closed="false">9:2: </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kur 12:1</ref>; <ref loc="DEU 16:1">Bir 16:1</ref>, <ref loc="DEU 16:2">2</ref>. </char></note> Abaisraeli bagume barinde Okuhingurwaho omu bunaku bwakwo obwatairweho. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Aha kiro kya ikumi na bina eky'okwezi oku omu mwabazyo, mube nibwo mwakurinda nk'obunaku bwakwo obwatairweho oku buri; mukurinde nk'ebiragiro byakwo byona n'emigyenzo yaakwo yoona oku biri. <verse eid="NUM 9:3" /><verse number="4" style="v" sid="NUM 9:4" />Musa yaagambira Abaisraeli kurinda Okuhingurwaho. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" /><note caller="-" style="x"><char style="xo" closed="false">9:5: </char><char style="xt" closed="false"><ref loc="JOS 5:10">Yos 5:10</ref>. </char></note> Baakurinda omu kwezi kw'okubanza aha kiro kya ikumi na bina omu mwabazyo, bari omu ihamba rya Sinai; nk'ebi MUKAMA yaaragiire Musa byona oku byabaire biri, Abaisraeli baaba nikwo baatwaza. <verse eid="NUM 9:5" /><verse number="6" style="v" sid="NUM 9:6" /><note caller="-" style="x"><char style="xo" closed="false">9:6: </char><char style="xt" closed="false"><ref loc="NUM 6:6">Kub 6:6</ref>, <ref loc="NUM 6:7">7</ref>; <ref loc="JHN 18:28">Yoh 18:28</ref>. </char></note> Kandi hakaba hariho abashaija abasiisirwe omutumbi gw'omuntu, tibaabaasa kurinda Okuhingurwaho eryo izooba; baija ahari Musa na Arooni ahari eryo izooba, <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />baamugira bati: Tusiisirwe omutumbi gw'omuntu; n'enki ekirikutuzibira kuhongyera MUKAMA empongano omu bunaku bwayo hamwe n'Abaisraeli abandi? <verse eid="NUM 9:7" /><verse number="8" style="v" sid="NUM 9:8" /><note caller="-" style="x"><char style="xo" closed="false">9:8: </char><char style="xt" closed="false"><ref loc="PSA 25:14">Zab 25:14</ref>; <ref loc="PSA 85:8">85:8</ref>; <ref loc="JHN 7:17">Yoh 7:17</ref>. </char></note> Musa yaabagarukamu ati: Mube murekire, mbanze mpurire eki MUKAMA araaragiire aha byanyu.<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />MUKAMA yaagambira Musa ati: <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />Gambira Abaisraeli oti: Omuntu weena omuriimwe nari omu ruzaaro rwanyu, ku arishiishwa omutumbi, nari ku ariba ari omu rugyendo rwa hare, n'obu kiriba kiri kityo, arinde Okuhingurwaho ahari MUKAMA; <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" /><note caller="-" style="x"><char style="xo" closed="false">9:11: </char><char style="xt" closed="false"><ref loc="2CH 30:2">2 Bus 30:2</ref>, <ref loc="2CH 30:15">15</ref>. </char></note> omu kwezi kwa kabiri aha kiro kya ikumi na bina omu mwabazyo, babe nibwo baakurinda; omwana gw'entaama gw'Okuhingurwaho baguriise emigaati etatumbisiibwe n'emboga ezirikushaarira; <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" /><note caller="-" style="x"><char style="xo" closed="false">9:12: </char><char style="xt" closed="false"><ref loc="JHN 19:36">Yoh 19:36</ref>. </char></note> batarigira eki baatsigaho okuhitsya omu kasheeshe, kandi batarihenda eigufa ryagwo na rimwe; nk'ebiragiro by'Okuhingurwaho byona oku biri, babe nikwo baakurinda. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" /><note caller="-" style="x"><char style="xo" closed="false">9:13: </char><char style="xt" closed="false"><ref loc="GAL 3:10">Gal 3:10</ref>. </char></note> Kwonka omuntu otasiisikaire, kandi otari mu rugyendo, ku arireka kurinda Okuhingurwaho, aryacuubwa omu ihanga rye; ahabw'okuba tahongyeire MUKAMA empongano omu bunaku bwayo obwatairweho, omuntu ogwo okutahikiirira kwe kuryamugumaho. <verse eid="NUM 9:13" /><verse number="14" style="v" sid="NUM 9:14" />Kandi omunyamahanga obashuhuukiiremu, ku aryenda kurinda Okuhingurwaho ahari MUKAMA, aryatwaza nk'ebiragiro byakwo n'emigyenzo yaakwo oku biri; omunyamahanga n'enzaarwa baryagira ekiragiro kimwe.<verse eid="NUM 9:14" /></para>
  <para style="s1">Eby'ekicu ekyabaire kihabura Abaisraeli omuhanda</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 13:21">Kur 13:21</ref>. </char>
    </note> Aha izooba eri baimukiizeho Obutaaho, ekicu kikasangira obwo Butaaho, niryo Ihema ry'Ebirikuhamya; kandi omu mwabazyo kyaguma ahaiguru y'Obutaaho nikishusha nk'omuriro okuhitsya omu kasheeshe. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" /><note caller="-" style="x"><char style="xo" closed="false">9:16: </char><char style="xt" closed="false"><ref loc="DEU 1:33">Bir 1:33</ref>. </char></note> Okwo nikwo byabaire biba obutoosha; ekicu kikaba kibusangira nyomushana, nyekiro kishusha nk'omuriro. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" /><note caller="-" style="x"><char style="xo" closed="false">9:17: </char><char style="xt" closed="false"><ref loc="EXO 40:36">Kur 40:36</ref>, <ref loc="EXO 40:37">37</ref>; <ref loc="ISA 49:10">Isa 49:10</ref>; <ref loc="JHN 10:4">Yoh 10:4</ref>. </char></note> Ekyo kicu ku kyabaire kiihwa ahaiguru y'Eihema, Abaisraeli babona kugyenda; kandi ahu kyabaire kyemerera, Abaisraeli niho baabaire bateera amahema. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" /><note caller="-" style="x"><char style="xo" closed="false">9:18: </char><char style="xt" closed="false"><ref loc="1CO 10:1">1 Kor 10:1</ref>. </char></note> Abaisraeli bakaba bagyenda ahabw'ekiragiro kya MUKAMA, kandi basiisira ahabw'ekiragiro kya MUKAMA; omwanya gwona ogu ekicu kyabaire kimara ahaiguru y'Obutaaho, bakaba baguma omu rusiisira. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />N'obu ekicu kyabaire kimara ebiro bingi ahaiguru y'obwo Butaaho, nabwo Abaisraeli bakaba boorobera ekiragiro kya MUKAMA, bareka kugyenda. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Obundi ekicu kikaba kimara ebiro bikye ahaiguru y'Obutaaho; baguma omu rusiisira nk'ekiragiro kya MUKAMA oku kiri; kandi bwanyima nk'ekiragiro kya MUKAMA oku kiri, baimutsya orugyendo. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Obundi ekicu kigumaho okwiha omu mwabazyo okuhitsya omu kasheeshe; ekicu kikiihwa aha Butaaho omu kasheeshe, baimutsya orugyendo; nari shi ku kyabaire kisiibaho, kyaraaraho, bwanyima kikiihwaho, baimutsya orugyendo. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" /><note caller="-" style="x"><char style="xo" closed="false">9:22: </char><char style="xt" closed="false"><ref loc="PSA 107:7">Zab 107:7</ref>. </char></note> N'obu ekicu kyabaire kimara ebiro bibiri nari okwezi nari omwaka kiri ahaiguru y'obwo Butaaho, Abaisraeli bakaba baguma omu rusiisira, bareka kugyenda; kwonka ku kyabaire kiihwaho, bagyenda. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" /><note caller="-" style="x"><char style="xo" closed="false">9:23: </char><char style="xt" closed="false"><ref loc="ISA 63:14">Isa 63:14</ref>. </char></note> Bakaba bateera amahema ahabw'ekiragiro kya MUKAMA; kandi bagyenda ahabw'ekiragiro kye; baguma niboorobera ekiragiro kya MUKAMA, nk'oku yaabaragiire naaraba omuri Musa.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s1">Enzamba z'efeeza</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />MUKAMA yaagambira Musa ati: <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" /><note caller="-" style="x"><char style="xo" closed="false">10:2: </char><char style="xt" closed="false"><ref loc="PSA 81:3">Zab 81:3</ref>. </char></note> Heesha enzamba ibiri omu feeza; ozikore omu feeza eheesire; ogume ozeetese eihanga ryona, n'okuziimukisa abari omu rusiisira kugyenda. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" /><note caller="-" style="x"><char style="xo" closed="false">10:3: </char><char style="xt" closed="false"><ref loc="JER 4:5">Yer 4:5</ref>; <ref loc="JOL 2:15">Yoel 2:15</ref>. </char></note> Ku bariziteera zombi, eihanga ryona rikuteeranireho aha muryango gw'Eihema ry'okubaabuganiramu. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" /><note caller="-" style="x"><char style="xo" closed="false">10:4: </char><char style="xt" closed="false"><ref loc="EXO 18:21">Kur 18:21</ref>. </char></note> Ku bariteera emwe yonka, abeebembezi, abakuru b'enganda z'Abaisraeli, bagume bakuteeranireho. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Ku muriteera ey'akasirikiriro, ab'omu nsiisira eziri aha rubaju rw'oburugwa-izooba bagume baimutsye orugyendo. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Ku murigaruka mwateera ey'akasirikiriro, ab'omu nsiisira ez'aha rubaju rw'obukiizi-bwa-buryo bagume baimutsye orugyendo; ku bariba nibenda kwimutsya orugyendo, bagume bateere ey'akasirikiriro. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Ku muryenda kuteerana eihanga ryona, mugume muteere ezo nzamba, kwonka mutariteera ez'akasirikiriro. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" /><note caller="-" style="x"><char style="xo" closed="false">10:8: </char><char style="xt" closed="false"><ref loc="NUM 31:6">Kub 31:6</ref>; <ref loc="2CH 13:12">2 Bus 13:12</ref>. </char></note> Batabani ba Arooni abanyamurwa babe nibo baaguma nibateera ezo nzamba. Okwo kuteera enzamba kubabeere ekiragiro ekitarihwaho omu busingye bwanyu bwona. <verse eid="NUM 10:8" /><verse number="9" style="v" sid="NUM 10:9" /><note caller="-" style="x"><char style="xo" closed="false">10:9: </char><char style="xt" closed="false"><ref loc="JDG 3:27">Bar 3:27</ref>; <ref loc="1KI 8:44">1 Bag 8:44</ref>. </char></note> Ku murihurura kurwanisa abazigu baanyu abarikubaita kubi omu nsi yaanyu, mugume muteere ezo nzamba z'akasirikiriro, mubone kwijukwa MUKAMA Ruhanga waanyu, n'okujunwa omu bazigu baanyu. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" /><note caller="-" style="x"><char style="xo" closed="false">10:10: </char><char style="xt" closed="false"><ref loc="LEV 23:24">Lev 23:24</ref>; <ref loc="1CH 15:24">1 Bus 15:24</ref>. </char></note> Kandi omu biro by'okushemererwa kwanyu n'omu magyenyi gaanyu agatairweho n'omu kuboneka kw'ameezi gaanyu, mugume muteere ezo nzamba nimutamba ebitambo, by'okwotsya, n'eby'empongano zaanyu z'okusiima ahabw'obusingye, zibabeere ekiijutsyo ky'okwijukirwaho Ruhanga waanyu; niinye MUKAMA Ruhanga waanyu.<verse eid="NUM 10:10" /></para>
  <para style="s1">Orugyendo rw'Abaisraeli okuruga Sinai okuhika Parani</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Omu mwaka gwa kabiri, omu kwezi kwa kabiri aha kiro kyakwo kya makumi abiri, ekicu kiri kikaihwa aha Butaaho bw'ebirikuhamya. <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" /><note caller="-" style="x"><char style="xo" closed="false">10:12: </char><char style="xt" closed="false"><ref loc="EXO 40:36">Kur 40:36</ref>. </char></note> Abaisraeli baimutsya orugyendo, baaruga omu ihamba rya Sinai, nk'oku orugyendo rwabo rwabaire nirukuratana; ekyo kicu kyayemerera omu ihamba rya Parani. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Okwo nikwo kwimutsya orugyendo kwabo okw'okubanza, nibagyenda nk'oku MUKAMA yaabaragiire naaraba omuri Musa. <verse eid="NUM 10:13" /><verse number="14" style="v" sid="NUM 10:14" />Haabanza kwimutsya orurango rw'orusiisira rw'Abayuda, nk'oku amahe gaabo gaabaire gari; omwebembezi w'eihe ry'Abayuda akaba ari Nahashooni mwene Aminadabu. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Omwebembezi w'eihe ry'Abaisakaari akaba ari Netaneeli mwene Zuari; <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />kandi omwebembezi w'eihe ry'Abazebuluuni akaba ari Eliabu mwene Helooni.<verse eid="NUM 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 10:17" />Ku baaherize kukuura Obutaaho, beene Gereshoni na beene Merari ababwekorera baimutsya orugyendo. <verse eid="NUM 10:17" /><verse number="18" style="v" sid="NUM 10:18" />Orurango rw'orusiisira rw'Abareubeeni rwaimutsya orugyendo, nk'oku amahe gaabo gaabaire gari; omukuru w'eihe ryabo akaba ari Elizuuri mwene Shedeuri. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Omukuru w'eihe ry'oruganda rw'Abasimeoni akaba ari Shelumieli mwene Zuri-shadai; <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />kandi omukuru w'eihe ry'oruganda rw'Abagaadi akaba ari Eliasaafu mwene Deueli.<verse eid="NUM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 10:21" />Bwanyima aba Kohasi baimutsya orugyendo, baheekire ebintu eby'Omwanya ogurikwera; baashanga Obutaaho bwaherize kuteerwa. <verse eid="NUM 10:21" /><verse number="22" style="v" sid="NUM 10:22" />Orurango rw'orusiisira rw'Abaefuraimu rwaimutsya orugyendo, nk'oku amahe gaabo gaabaire gari; omukuru w'eihe ryabo akaba ari Elishaama mwene Amihuudi; <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />omukuru w'eihe ry'oruganda rw'Abamanaase akaba ari Gamalieli mwene Pedazuuri; <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />kandi omukuru w'eihe ry'oruganda rw'Ababenyamiini akaba ari Abidaani mwene Gideoni.<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />Orurango rw'orusiisira rw'Abadaani orwabaire ruri enyima y'ezindi nsiisira zoona, rwaimutsya orugyendo, nk'oku amahe gaabo gaabaire gari; omukuru w'eihe ryabo akaba ari Ahiezeeri mwene Ami-shadai; <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />omukuru w'eihe ry'oruganda rw'Abaasheri akaba ari Pagieli mwene Okiraane; <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />kandi omukuru w'eihe ry'oruganda rw'Abanafutaali akaba ari Ahiira mwene Enani. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Okwo nikwo Abaisraeli baakurataine omu ngyendo zaabo, obu baimutsya orugyendo, nk'oku amahe gaabo gaabaire gari.<verse eid="NUM 10:28" /></para>
  <para style="s1">Musa okushaba ishe-zaara kugyenda nabo</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:29: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 2:18">Kur 2:18</ref>; <ref loc="GEN 12:7">Kut 12:7</ref>; <ref loc="JDG 1:16">Bar 1:16</ref>; <ref loc="JDG 4:11">4:11</ref>. </char>
    </note> Musa yaagambira Hobabu, mwene Reueli Omunyamidiani ishezaara wa Musa, ati: Nitwimutsya orugyendo kuza omu nsi ei MUKAMA yaagambire kutuha. Ija tugyendane; nitwija kukukorera gye; ahakuba MUKAMA akaraganisa kukorera Abaisraeli ebirungi. <verse eid="NUM 10:29" /><verse number="30" style="v" sid="NUM 10:30" />Yaamugarukamu ati: Tindikwija kugyenda naimwe, kureka niinyija kugaruka omu nsi yaitu omuri beene waitu. <verse eid="NUM 10:30" /><verse number="31" style="v" sid="NUM 10:31" /><note caller="-" style="x"><char style="xo" closed="false">10:31: </char><char style="xt" closed="false"><ref loc="JOB 29:15">Yob 29:15</ref>. </char></note> Musa yaamugira ati: Ninkweshengyereza, otatutsigaho; ahabw'okuba noomanya omuringo ogu tushemereire kusiisiramu omu ihamba, niiwe orikwija kuba amaisho gaitu. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Kandi ku oraagyende naitwe, ebirungi byona ebi MUKAMA aritukorera, naitwe turyabikukorera.<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">10:33: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 1:33">Bir 1:33</ref>. </char>
    </note> Baimuka, baaruga aha rushozi rwa MUKAMA, baagyenda orugyendo rw'ebiro bishatu; eshanduukye y'endagaano ya MUKAMA yaabeebembera omuri orwo rugyendo rw'ebiro bishatu, neebasherurira omwanya gw'okuhuumuriramu. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" /><note caller="-" style="x"><char style="xo" closed="false">10:34: </char><char style="xt" closed="false"><ref loc="EXO 13:21">Kur 13:21</ref>; <ref loc="PSA 105:39">Zab 105:39</ref>. </char></note> Ku baabaire baimutsya orugyendo kuruga omu rusiisira, ekicu kya MUKAMA kiguma kiri ahaiguru yaabo nyomushana. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" /><note caller="-" style="x"><char style="xo" closed="false">10:35: </char><char style="xt" closed="false"><ref loc="PSA 68:1">Zab 68:1</ref>. </char></note> Kandi egyo shanduukye ku yaabaire eimutsya orugyendo, Musa agira ati: Ai MUKAMA, imuka, abazigu baawe bataataane, n'abarikukwanga bakuhungye. <verse eid="NUM 10:35" /><verse number="36" style="v" sid="NUM 10:36" /><note caller="-" style="x"><char style="xo" closed="false">10:36: </char><char style="xt" closed="false"><ref loc="PSA 132:8">Zab 132:8</ref>. </char></note> Kandi ku yaabaire ehuumura, agira ati: Ai MUKAMA, garuka aha bukumi n'obukumi bw'Abaisraeli.<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s1">Abaisraeli okugaya emaanu; n'okushaba Musa enyama</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 15:23">Kur 15:23</ref>, <ref loc="EXO 15:24">24</ref>; <ref loc="EXO 16:2">16:2</ref>, <ref loc="EXO 16:3">3</ref>; <ref loc="DEU 9:22">Bir 9:22</ref>; <ref loc="LAM 3:39">Tonz 3:39</ref>. </char>
    </note> Bwanyima abantu baayetomboita ahabw'ebibabaireho, MUKAMA yaabihurira; ku yaabihuriire, yaabagirira ekiniga kingi; omuriro gwa MUKAMA gwabaakamu, gwayotsya ebicweka bimwe ebirikuhereerukayo omu rusiisira. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" /><note caller="-" style="x"><char style="xo" closed="false">11:2: </char><char style="xt" closed="false"><ref loc="JAS 5:16">Yak 5:16</ref>. </char></note> Abantu baatakira Musa; Musa yaashaba MUKAMA; omuriro gwaraara. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Omwanya ogwo gwayetwa Tabera, ahabw'okuba omuriro gwa MUKAMA gukabaakamu. <verse eid="NUM 11:3" /><verse number="4" style="v" sid="NUM 11:4" /><note caller="-" style="x"><char style="xo" closed="false">11:4: </char><char style="xt" closed="false"><ref loc="EXO 12:38">Kur 12:38</ref>; <ref loc="1CO 10:6">1 Kor 10:6</ref>. </char></note> Omutwe gw'ebijwangye by'abanyamahanga abaabaire bari omuribo baatandika kwetenga; Abaisraeli nabo baagaruka baarira, nibagira bati: N'oha oraatuhe enyama y'okurya? <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" /><note caller="-" style="x"><char style="xo" closed="false">11:5: </char><char style="xt" closed="false"><ref loc="MAT 6:24-34">Mat 6:24-34</ref>; <ref loc="ROM 8:7">Rom 8:7</ref>. </char></note> Twaijuka eby'enyanja, ebi twabaire turiira busha, tukiri omuri Misri, emyongo, ebihaaza, obutunguru bw'ebibabi n'obw'ebitakuri, na katunguricumu; <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />mbwenu twomire, titwine kindi kyona eki turikureeba kureka emaanu egi yonka.<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />Kandi egyo maanu ekaba neeshusha otujuma tw'obunyaatsi oburikwetwa gaadi; enshusha yaayo ekaba eri nk'amakanca g'ebiti agarikwetwa budola. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Abantu bakaba bagyenda, bagitorotoora, bagisa aha mengo, nari bagishekura omu shekuro, bagiteeka omu nyungu, bagikoramu twakeeki; okunura kwayo kukaba kuri nk'okw'otukeeki otukozirwe n'amajuta. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Orume ku rwabaire rutonda omu rusiisira nyekiro, emaanu erutondaho.<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />Musa ku yaahuriire abantu nibarira, buri muntu n'ab'eka ye nibaririra aha miryango y'amahema gaabo, MUKAMA yaagira ekiniga kingi munonga, Musa nawe yaaguubwa kubi. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" /><note caller="-" style="x"><char style="xo" closed="false">11:11: </char><char style="xt" closed="false"><ref loc="DEU 1:12">Bir 1:12</ref>; <ref loc="JER 20:7-18">Yer 20:7-18</ref>; <ref loc="2CO 11:28">2 Kor 11:28</ref>. </char></note> Musa yaagambira MUKAMA ati: Ahabw'enki oitsire kubi omwiru waawe? Ahabw'enki onkoreire oburemeezi bw'aba bantu boona, okanga kungirira embabazi? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" /><note caller="-" style="x"><char style="xo" closed="false">11:12: </char><char style="xt" closed="false"><ref loc="ISA 40:11">Isa 40:11</ref>; <ref loc="1TH 2:7">1 Tes 2:7</ref>. </char></note> Niinye naatwaire enda y'aba bantu boona? Niinye naabazaire, waaza kungira oti: Obatwarire omu kifuba, nk'omurezi oku akiikira omwana orikwonka, obahitsye omu nsi ei naaraganiise baishenkurubo? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" /><note caller="-" style="x"><char style="xo" closed="false">11:13: </char><char style="xt" closed="false"><ref loc="2KI 4:43">2 Bag 4:43</ref>; <ref loc="MRK 8:4">Mak 8:4</ref>. </char></note> Nkaihire hi enyama y'okugaburira aba bantu boona? Ahakuba nibandirira omu maisho nibagira bati: Tuhe enyama y'okurya. <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" /><note caller="-" style="x"><char style="xo" closed="false">11:14: </char><char style="xt" closed="false"><ref loc="EXO 18:18">Kur 18:18</ref>. </char></note> Tindikubaasa kuheeka aba bantu boona nyenka, ahabw'okuba n'omutwaro gurikundema. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" /><note caller="-" style="x"><char style="xo" closed="false">11:15: </char><char style="xt" closed="false"><ref loc="1KI 19:4">1 Bag 19:4</ref>; <ref loc="JON 4:3">Yon 4:3</ref>. </char></note> Ku oraabe nooyenda kuntwaza otyo, ninkweshengyereza, nyita ndugyeho, ku oraabe nongirira embabazi, ndekye kureeba enaku ezirimbaho.<verse eid="NUM 11:15" /></para>
  <para style="s1">MUKAMA okuha Musa abahwezi makumi mushanju</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 24:1">Kur 24:1</ref>, <ref loc="EXO 24:9">9</ref>. </char>
    </note> MUKAMA yaagira Musa ati: Nteeranira abantu makumi mushanju omu bakuru b'Abaisraeli, abu orikumanya ngu n'abakuru b'abantu, n'abategyeki baabo, obareete aha Ihema ry'okubugaabuganiramu, beemerereho naiwe. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" /><note caller="-" style="x"><char style="xo" closed="false">11:17: </char><char style="xt" closed="false"><ref loc="1SA 10:6">1 Sam 10:6</ref>. </char></note> Naanye niinyija kushuuma, ngambireyo naiwe; nyihe aha mwoyo oguri ahariiwe, ngubateho; nabo bagume baheekye naiwe omutwaro gw'abo bantu, orekye kuguheeka wenka. <verse eid="NUM 11:17" /><verse number="18" style="v" sid="NUM 11:18" /><note caller="-" style="x"><char style="xo" closed="false">11:18: </char><char style="xt" closed="false"><ref loc="ACT 7:39">Byak 7:39</ref>. </char></note> Kandi ogambire abantu oti: Mweyeze ahabw'eizooba rya nyencakare, nimwija kurya enyama; ahakuba muririire omu matu ga MUKAMA, nimugira muti: N'oha oraatuhe enyama y'okurya? Ahakuba tukaba turi gye omuri Misri. N'ahabw'ekyo MUKAMA naija kubaha enyama, nimugirya. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Timurigirya izooba rimwe, nari amazooba abiri, nari ataano nari ikumi nari makumi abiri, <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />kureka nimwija kugirya okwezi kwona, okuhitsya obu eribareetwa omu nyindo, ekabatama; ahabw'okuba mugayire MUKAMA ori omuriimwe, mwamuririra omu maisho nimugira muti: Tukaba twarugira ki Misri? <verse eid="NUM 11:20" /><verse number="21" style="v" sid="NUM 11:21" />Musa yaagira ati: Abantu abu ntuuramu n'abashaija obusiriira mukaaga abarikugyendesa ebigyere; kandi waagira oti: Niinyija kubaha enyama, bagirye okumara okwezi kwona. <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" /><note caller="-" style="x"><char style="xo" closed="false">11:22: </char><char style="xt" closed="false"><ref loc="2KI 7:2">2 Bag 7:2</ref>; <ref loc="MAT 15:33">Mat 15:33</ref>. </char></note> Nibaija kubaagirwa amasyo g'entaama n'ag'ente g'okubahaazya? Nari shi eby'enyanja byona nibiija kuteeranirwa hamwe ahabw'abo kubahaazya? <verse eid="NUM 11:22" /><verse number="23" style="v" sid="NUM 11:23" /><note caller="-" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="ISA 50:2">Isa 50:2</ref>; <ref loc="EZK 12:25">Ezk 12:25</ref>. </char></note> MUKAMA yaagambira Musa ati: Noogira ngu omukono gwa MUKAMA gubaire mugufu? Mbwenu noija kureeba ekigambo kyangye ku kiraabe nikiija kuhikiirira ahabwawe nari kitarikwija kubakwo.<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Musa yaashohora, yaagambira abantu ebi MUKAMA yaamugambira; bwanyima yaateerana abashaija makumi mushanju ab'omu bakuru b'abantu, yaabata omu myanya okwehinguririza Eihema ry'okubugaabuganiramu. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" /><note caller="-" style="x"><char style="xo" closed="false">11:25: </char><char style="xt" closed="false"><ref loc="1SA 10:5">1 Sam 10:5</ref>, <ref loc="1SA 10:6">6</ref>; <ref loc="JOL 2:29">Yoel 2:29</ref>; <ref loc="1CO 14:1">1 Kor 14:1</ref>. </char></note> MUKAMA yaashuumira omu kicu, yaagamba na Musa, yaiha aha mwoyo ogwabaire gumuriho, yaaguta ahari abo bakuru makumi mushanju; omwoyo ku gwabagiireho, baaragura; kwonka tibaagaruka kukora batyo obundi. <verse eid="NUM 11:25" /><verse number="26" style="v" sid="NUM 11:26" />Kwonka omu rusiisira hakaba hatsigaramu abashaija babiri, omwe orikwetwa Eludaadi n'ondi orikwetwa Medadi; ogwo mwoyo gwabazaho; kandi bakaba bari omu mubaro gw'abahandiikirwe, kwonka batarugire aho kuza aha Ihema; baaragurira aho omu rusiisira. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Omutsigazi yaagyenda nairuka, yaagambira Musa ati: Eludaadi na Medadi nibaragurira omu rusiisira. <verse eid="NUM 11:27" /><verse number="28" style="v" sid="NUM 11:28" /><note caller="-" style="x"><char style="xo" closed="false">11:28: </char><char style="xt" closed="false"><ref loc="MRK 9:38">Mak 9:38</ref>; <ref loc="JHN 3:26">Yoh 3:26</ref>. </char></note> Yoshua mwene Nuuni omuheereza wa Musa, omwe aha bashaija be b'entoore, yaamugira ati: Mukama wangye Musa, bazibire. <verse eid="NUM 11:28" /><verse number="29" style="v" sid="NUM 11:29" /><note caller="-" style="x"><char style="xo" closed="false">11:29: </char><char style="xt" closed="false"><ref loc="ACT 26:29">Byak 26:29</ref>; <ref loc="1CO 14:5">1 Kor 14:5</ref>. </char></note> Musa yaamugarukamu ati: Waagira eihari aha bwangye? Nkaabaasibwa ki abantu ba MUKAMA boona baba baanabi, MUKAMA abaha omwoyo gwe. <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Musa yaagaruka omu rusiisira, we n'abo bakuru b'Abaisraeli.<verse eid="NUM 11:30" /></para>
  <para style="s1">MUKAMA okubareetera endahi n'okubaitamu baingi</para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">11:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:26-31">Zab 78:26-31</ref>. </char>
    </note> Omuyaga gwaruga ahari MUKAMA, gwareeta endahi zaaruga aha nyanja, zaagwa haihi n'orusiisira okurwehinguririza, zaahitsya omwanya ogu omuntu arikubaasa kugyenda eizooba ryona buri rubaju, nizigyendera omu mwanya nk'ogwa mikono ebiri okuruga ahansi. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />Abantu baimuka, baarenzya eryo izooba, baaseesa ekiro, baarenzya erindi izooba nibazikwata; owaakwatsire enkye, yaakwata homeri ikumi, baazeeyanikira embaju zoona ez'orusiisira. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Enyama ku yaabaire ekibari omu kanwa, batakagimizire, MUKAMA yaabagirira ekiniga kingi, yaajuumikiza abantu orufu rwingi munonga. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" /><note caller="-" style="x"><char style="xo" closed="false">11:34: </char><char style="xt" closed="false"><ref loc="DEU 9:22">Bir 9:22</ref>. </char></note> Omwanya ogwo gwayetwa Kibiroosi-hatava, ahabw'okuba niho baaziikire abantu abaayetengire.<verse eid="NUM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 11:35" />Abantu baimuka Kibiroosi-hatava, baaza Hazeroosi; baamarayo ebiro.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s1">Miriamu na Arooni okugirira Musa eihari</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 2:21">Kur 2:21</ref>. </char>
    </note> Miriamu na Arooni baagambuura Musa ahabw'Omukuushikazi ou yaabaire ashweire; ahabw'okuba akashwera Omukuushikazi. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" /><note caller="-" style="x"><char style="xo" closed="false">12:2: </char><char style="xt" closed="false"><ref loc="2KI 19:4">2 Bag 19:4</ref>; <ref loc="PSA 94:9">Zab 94:9</ref>. </char></note> Baagira bati: N'eky'amazima MUKAMA agambira omuri Musa wenka? Itwe tatugambiramu? MUKAMA yaakihurira. <verse eid="NUM 12:2" /><verse number="3" style="v" sid="NUM 12:3" /><note caller="-" style="x"><char style="xo" closed="false">12:3: </char><char style="xt" closed="false"><ref loc="PSA 147:6">Zab 147:6</ref>; <ref loc="MAT 5:5">Mat 5:5</ref>; <ref loc="2TI 2:25">2 Tim 2:25</ref>; <ref loc="1PE 3:4">1 Pet 3:4</ref>. </char></note> Kandi ogwo mushaija Musa akaba ari omucureezi, okukira abantu boona ab'omu nsi. <verse eid="NUM 12:3" /><verse number="4" style="v" sid="NUM 12:4" />Ahonaaho MUKAMA yaagambira Musa na Arooni na Miriamu ati: Mushohore mwenshatu, mwije aha Ihema ry'okubugaabuganiramu. Bonshatu baashohora. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />MUKAMA yaashuumira omu nyomyo y'ekicu, yaayemerera aha muryango gw'Eihema, yaayeta Arooni na Miriamu, bombi baija; <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" /><note caller="-" style="x"><char style="xo" closed="false">12:6: </char><char style="xt" closed="false"><ref loc="LUK 1:11">Luk 1:11</ref>, <ref loc="LUK 1:22">22</ref>; <ref loc="MAT 1:20">Mat 1:20</ref>. </char></note> yaabagira ati: Nimuhurire ebigambo byangye. Omuriimwe ku haraabe harimu nabi, omu kworekwa nimwo nyowe MUKAMA ndimwemanyisiza, kandi n'omu kirooto nimwo ndigambira nawe. <verse eid="NUM 12:6" /><verse number="7" style="v" sid="NUM 12:7" /><note caller="-" style="x"><char style="xo" closed="false">12:7: </char><char style="xt" closed="false"><ref loc="HEB 3:5">Heb 3:5</ref>. </char></note> Kwonka omugaragwa wangye Musa tikwo mmutwaza; n'omwesigwa omu nju yangye yoona. <verse eid="NUM 12:7" /><verse number="8" style="v" sid="NUM 12:8" /><note caller="-" style="x"><char style="xo" closed="false">12:8: </char><char style="xt" closed="false"><ref loc="EXO 33:11">Kur 33:11</ref>, <ref loc="EXO 33:19">19</ref>; <ref loc="DEU 34:10">Bir 34:10</ref>; <ref loc="2PE 2:10">2 Pet 2:10</ref>. </char></note> We ngamba nawe butunu nitureebana, ntarikugamba nawe mu nfumu, kandi n'enshusha yangye agireeba. Mbwenu ahabw'enki timutiinire kugamba kubi aha mugaragwa wangye Musa?<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />MUKAMA yaabagirira ekiniga kingi, yaagyenda. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" /><note caller="-" style="x"><char style="xo" closed="false">12:10: </char><char style="xt" closed="false"><ref loc="2KI 5:27">2 Bag 5:27</ref>; <ref loc="2CH 26:19">2 Bus 26:19</ref>. </char></note> Ekicu ku kyarugire ahaiguru y'Eihema baareeba Miriamu aseesire ebibembe ebirikwera nk'orubaare. Arooni ku yaareebire Miriamu, yaashanga aseesire ebibembe. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />Arooni yaagira Musa ati: Ai bambe Mukama wangye, otatuha ekifubiro ahabw'ekibi eki tukoresiibwe obushema. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Ninkweshengyereza arekye kushusha nk'ekizairwe kifiire kijunzire orubaju rumwe. <verse eid="NUM 12:12" /><verse number="13" style="v" sid="NUM 12:13" />Musa yaatakira MUKAMA ati: Ai Ruhanga, naakweshengyereza mutambire. <verse eid="NUM 12:13" /><verse number="14" style="v" sid="NUM 12:14" /><note caller="-" style="x"><char style="xo" closed="false">12:14: </char><char style="xt" closed="false"><ref loc="HEB 12">Heb 12:0</ref>; <ref loc="NUM 5:2">Kub 5:2</ref>, <ref loc="NUM 5:3">3</ref>. </char></note> MUKAMA yaagarukamu Musa ati: Kuri noogira ngu ishe amucweire amacwante bucwante omu maisho, takugizire nshoni okumara ebiro mushanju? Reka amare ebiro mushanju akomeirwe aheeru y'orusiisira, bwanyima abone kurugarurwamu. <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" /><note caller="-" style="x"><char style="xo" closed="false">12:15: </char><char style="xt" closed="false"><ref loc="DEU 24:9">Bir 24:9</ref>. </char></note> Atyo Miriamu yaakomerwa aheeru y'orusiisira okumara ebiro mushanju; abantu tibaimutsya rugyendo okuhitsya obu yaagarwirwe omu rusiisira. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />Bwanyima abantu baimutsya orugyendo, baaruga Hazeroosi, baateera orusiisira omu ihamba rya Parani.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s1">Entatsi ikumi na ibiri z'okutata Kanaani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />MUKAMA yaagambira Musa ati: <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" /><note caller="-" style="x"><char style="xo" closed="false">13:2: </char><char style="xt" closed="false"><ref loc="DEU 1:22">Bir 1:22</ref>; <ref loc="DEU 9:23">9:23</ref>. </char></note> Tuma abantu batate ensi ya Kanaani, ei ndikuha Abaisraeli; mwihe omuntu omwe omuri buri ruganda rwa baishenkurubo, buri omwe aharibo abe ari omwebembezi. <verse eid="NUM 13:2" /><verse number="3" style="v" sid="NUM 13:3" />Musa yaabatuma ari omu ihamba rya Parani nk'oku MUKAMA yaaragiire; abu yaatumire boona bakaba bari abakuru b'Abaisraeli. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />Aga nigo maziina gaabo. Omu ruganda rwa Reubeeni baatuma Sahamua mwene Zakura; <verse eid="NUM 13:4" /><verse number="5" style="v" sid="NUM 13:5" />omu rwa Simeoni Shafati mwene Hoori; <verse eid="NUM 13:5" /><verse number="6" style="v" sid="NUM 13:6" /><note caller="-" style="x"><char style="xo" closed="false">13:6: </char><char style="xt" closed="false"><ref loc="JOS 14:6">Yos 14:6</ref>. </char></note> omu rwa Yuda, Kalebu mwene Yefune; <verse eid="NUM 13:6" /><verse number="7" style="v" sid="NUM 13:7" />omu rwa Isakaari, Igali mwene Yosefu; <verse eid="NUM 13:7" /><verse number="8" style="v" sid="NUM 13:8" />omu rwa Efuraimu, Hoshea mwene Nuuni; <verse eid="NUM 13:8" /><verse number="9" style="v" sid="NUM 13:9" />omu rwa Benyamiini, Paluti mwene Raafu; <verse eid="NUM 13:9" /><verse number="10" style="v" sid="NUM 13:10" />omu rwa Zebuluuni, Gadieli, mwene Soodi; <verse eid="NUM 13:10" /><verse number="11" style="v" sid="NUM 13:11" />omu rwa Yosefu nirwo ruganda rwa Manaase Gaadi mwene Suusi; <verse eid="NUM 13:11" /><verse number="12" style="v" sid="NUM 13:12" />omu rwa Daani, Amieli mwene Gemali; <verse eid="NUM 13:12" /><verse number="13" style="v" sid="NUM 13:13" />omu rwa Asheri, Seeturi mwene Mikaeli; <verse eid="NUM 13:13" /><verse number="14" style="v" sid="NUM 13:14" />omu rwa Nafutaali, Nahibi mwene Vofisi; <verse eid="NUM 13:14" /><verse number="15" style="v" sid="NUM 13:15" />omu rwa Gaadi, Geueli mwene Maaki. <verse eid="NUM 13:15" /><verse number="16" style="v" sid="NUM 13:16" /><note caller="-" style="x"><char style="xo" closed="false">13:16: </char><char style="xt" closed="false"><ref loc="EXO 17:9">Kur 17:9</ref>; <ref loc="HEB 4:8">Heb 4:8</ref>. </char></note> Ago nigo maziina g'abantu abu Musa yaatumire kutata egyo nsi. Musa yaayeta Hoshea mwene Nuuni Yoshua.<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />Musa yaabatuma kutata ensi ya Kanaani, yaabagira ati: Mutoore omuhanda ogurikuraba Negebu, mwinamukye omu nsi y'ebibungo, <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />mutate ensi, mumanye oku eri, n'abantu abagitwiremu mumanye ku baraabe baine amaani nari batagaine, nari shi ku baraabe bari bakye nari baingi; <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />n'ensi ei batwiremu ku eraabe eri nungi nari eri mbi; n'endembo ezi batwiremu oku ziri, ku baraabe nibataaha omu nsiisira, nari omu ngo zigumire; <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" /><note caller="-" style="x"><char style="xo" closed="false">13:20: </char><char style="xt" closed="false"><ref loc="DEU 31:6">Bir 31:6</ref>. </char></note> kandi mureebe eitaka ryayo ku riraabe niryeza nari ritarikweza, n'ensi ku eraabe erimu ebiti nari bitarimu. Mutatiina, mureete aha bijuma by'omuri egyo nsi. Kandi obunaku obwo bukaba buri eitogyera ry'emizaabibu.<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />Batyo baagyenda, baatata ensi okuruga omu ihamba rya Ziini okuhika Rehobu, ahu orikutaahira nooza Hamasi. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" /><note caller="-" style="x"><char style="xo" closed="false">13:22: </char><char style="xt" closed="false"><ref loc="JDG 1:10">Bar 1:10</ref>; <ref loc="DEU 1:25">Bir 1:25</ref>. </char></note> Bainamuka Negebu, baahika Heburooni; kandi obwo Ahimaanu na Sheshai na Talumai beene Anaki bakaba bari okwo. (Heburooni egyo ekaba emazire emyaka mushanju eyombekire, Zoani ey'omuri Misri etakombekirwe.) <verse eid="NUM 13:22" /><verse number="23" style="v" sid="NUM 13:23" />Baahika omu ruhanga rwa Eshikooli, baatemayo omutsitsa gw'ebijuma by'emizaabibu, abantu babiri baaguheeka aha mugamba; kandi baareeta n'amakomamahanga n'ebijuma by'emitiini. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Omwanya ogwo gwayetwa oruhanga rwa Eshikooli ahabw'omutsitsa gw'ebijuma by'emizaabibu, ogu Abaisraeli baatemireyo. <verse eid="NUM 13:24" /><verse number="25" style="v" sid="NUM 13:25" />Ku baamazire ebiro makumi ana nibatata egyo nsi, baagaruka.<verse eid="NUM 13:25" /></para>
  <para style="s1">Entatsi ikumi okugaruka n'enkuru mbi</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 13:26" />Ku baizire, baashanga Musa na Arooni n'eihanga ry'Abaisraeli ryona Kadeshi omu ihamba rya Parani, baabagambira hamwe n'eihanga ryona ebi baareebire, kandi baabooreka n'ebijuma ebi baihire omu nsi egyo. <verse eid="NUM 13:26" /><verse number="27" style="v" sid="NUM 13:27" />Baagira Musa bati: Tukahika omu nsi ei waatutumiremu, n'ekya buzima n'ensi y'amate n'obwoki; kandi n'ebijuma byayo mbibi. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" /><note caller="-" style="x"><char style="xo" closed="false">13:28: </char><char style="xt" closed="false"><ref loc="DEU 9:1">Bir 9:1</ref>, <ref loc="DEU 9:2">2</ref>. </char></note> Kwonka abantu abagitwiremu n'ab'amaani, n'endembo zaabo zizitiize engo z'amabaare, kandi ni mpango munonga; tukareebayo na beene Anaki. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" /><note caller="-" style="x"><char style="xo" closed="false">13:29: </char><char style="xt" closed="false"><ref loc="EXO 17:8">Kur 17:8</ref>; <ref loc="NUM 14:43">Kub 14:43</ref>; <ref loc="1SA 15:3">1 Sam 15:3</ref>. </char></note> Abaamaleki batwire omu nsi ya Negebu, Abahiiti n'Abayebusi n'Abaamori batwire omu nsi y'ebibungo; n'Abanyakanaani batwire aha nyanja n'omu mpita za Yorudani.<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">13:30: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:31">Rom 8:31</ref>; <ref loc="PHP 4:13">Fil 4:13</ref>. </char>
    </note> Kalebu yaacureeza abantu omu maisho ga Musa naagira ati: Twinamukye ahonaaho, tugikubuure; ahakuba buzima nitubaasa kugisingura. <verse eid="NUM 13:30" /><verse number="31" style="v" sid="NUM 13:31" />Kwonka abantu abaabaire bagyenzire nawe baagira bati: Titurikubaasa kwinamukayo kurwana na bari bantu, ahabw'okuba nibatukiza amaani. <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Baagambira Abaisraeli enkuru mbi z'ensi ei baagiire kutata, nibagira bati: Ensi ei twarabiremu kutata, n'ensi erikurya abagitwiremu; n'abantu boona abu twareebireyo ni baraingwa munonga. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" /><note caller="-" style="x"><char style="xo" closed="false">13:33: </char><char style="xt" closed="false"><ref loc="1SA 17:4-7">1 Sam 17:4-7</ref>; <ref loc="ISA 40:22">Isa 40:22</ref>. </char></note> Kandi tukareebayo abantu b'ebikaaka, beene Anaki, abaakomookire aha Baanefili; tukeereeba turi nk'eseenene, kandi kwo nikwo twabaire turi omu maisho gaabo.<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s1">Abaisraeli okwetomboita</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />Eihanga ry'abantu boona baimutsya amaraka gaabo, baaborooga; ekyo kiro baaraara nibarira. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" /><note caller="-" style="x"><char style="xo" closed="false">14:2: </char><char style="xt" closed="false"><ref loc="PSA 106:25">Zab 106:25</ref>; <ref loc="DEU 28:68">Bir 28:68</ref>. </char></note> Abaisraeli boona baayetomboitera Musa na Arooni, eihanga ryona ryagira riti: Kuri nangwa twagwire omu nsi ya Misri! Nari tukaahenwa ki, tugwa omuri eri ihamba! <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />MUKAMA naatutwarira ki omuri egyo nsi kumarirwayo rurara? Abakazi baitu n'abaana baitu abato nibaija kuba eminyago. Ekirikukira t'okwegarukira Misri?<verse eid="NUM 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 14:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:4: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 9:17">Neh 9:17</ref>; <ref loc="ACT 7:39">Byak 7:39</ref>. </char>
    </note> Baagambirana bati: Ka tweteereho omwebembezi, tugarukye Misri. <verse eid="NUM 14:4" /><verse number="5" style="v" sid="NUM 14:5" />Musa na Arooni baajuumara omu maisho g'omutwe gwona ogw'eihanga ry'Abaisraeli boona. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Bwanyima Yoshua mwene Nuuni na Kalebu mwene Yefune, bamwe ahari abo abaatatsire ensi, baataagura ebijwaro byabo. <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />Baagambira eihanga ry'Abaisraeli ryona bati: Ensi ei twarabiremu kutata ni nungi munonga. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" /><note caller="-" style="x"><char style="xo" closed="false">14:8: </char><char style="xt" closed="false"><ref loc="DEU 10:15">Bir 10:15</ref>; <ref loc="2SA 15:25">2 Sam 15:25</ref>; <ref loc="ISA 62:4">Isa 62:4</ref>. </char></note> MUKAMA ku araabe naatusiima, aryagituhitsyamu, agituhe; n'ensi y'amate n'obwoki. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" /><note caller="-" style="x"><char style="xo" closed="false">14:9: </char><char style="xt" closed="false"><ref loc="DEU 20:1">Bir 20:1</ref>, <ref loc="DEU 20:3">3</ref>; <ref loc="2CH 15:2">2 Bus 15:2</ref>. </char></note> Kwonka murekye kugomera MUKAMA, kandi mutatiina abantu b'omu nsi egyo, ahakuba n'eby'okurya ahariitwe; ekibaire kibakingiire kibaihirweho, kandi MUKAMA ari hamwe naitwe; mutabatiina. <verse eid="NUM 14:9" /><verse number="10" style="v" sid="NUM 14:10" /><note caller="-" style="x"><char style="xo" closed="false">14:10: </char><char style="xt" closed="false"><ref loc="EXO 17:4">Kur 17:4</ref>. </char></note> Kwonka eihanga ryona ryagira riti: Tubateere amabaare.</para>
  <para style="p" vid="NUM 14:10">Ahonaaho ekitiinisa kya MUKAMA kyabonekyera Abaisraeli boona omu Ihema ry'okubugaabuganiramu. <verse eid="NUM 14:10" /><verse number="11" style="v" sid="NUM 14:11" /><note caller="-" style="x"><char style="xo" closed="false">14:11: </char><char style="xt" closed="false"><ref loc="JHN 12:37">Yoh 12:37</ref>. </char></note> MUKAMA yaagira Musa ati: Abantu aba baryahitsya hi okungaya? Baryahitsya hi okutanyikiriza, haza kunu naakozire obumanyiso obwo bwona omuribo? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" /><note caller="-" style="x"><char style="xo" closed="false">14:12: </char><char style="xt" closed="false"><ref loc="EXO 32:10">Kur 32:10</ref>. </char></note> Niinyija kubaitsa orufu, mbaiheho obuhunguzi bwabo, haza nkuhindure eihanga eririkubakira obwingi n'amaani.<verse eid="NUM 14:12" /></para>
  <para style="s1">Musa okweshengyerereza abantu ahari Ruhanga</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Musa yaagambira MUKAMA ati: Ku oraagire otyo, Abanyamisri nibaija kubihurira; ahakuba okaiha aba bantu omuribo n'amaani gaawe, <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />bakigambire abatwire omu nsi egi, haza baabaire baahuriire ngu iwe MUKAMA otuura omuri aba bantu; ahakuba iwe MUKAMA oreebwa n'amaisho butunu, kandi ekicu kyawe kyemerera ahaiguru yaabo, kandi ogyenda obeebembeire, ori omu nyomyo y'ekicu nyomushana, n'omu nyomyo y'omuriro nyekiro. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Mbwenu ku oraite aba bantu nk'omuntu omwe, amahanga agaahuriire okurangaanwa kwawe, garyagira gati: <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" /><note caller="-" style="x"><char style="xo" closed="false">14:16: </char><char style="xt" closed="false"><ref loc="JOS 7:9">Yos 7:9</ref>. </char></note> MUKAMA aremirwe kuhitsya abo bantu omu nsi ei yaarahiire naaraganisa kubaha, nikyo abacwekyererereize omu ihamba. <verse eid="NUM 14:16" /><verse number="17" style="v" sid="NUM 14:17" />Mbwenu ninkweshengyereza amaani ga MUKAMA gabe maingi, nk'oku waagambire noogira oti: <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" /><note caller="-" style="x"><char style="xo" closed="false">14:18: </char><char style="xt" closed="false"><ref loc="JON 4:2">Yon 4:2</ref>; <ref loc="EXO 34:7">Kur 34:7</ref>. </char></note> MUKAMA tarahuka kuguubwa kubi, n'ow'embabazi nyingi, asaasira eby'okutahikiirira n'eby'okushiisha, tasingisiriza abaine orubanja na kakye; atura abaana okutahikiirira kwa baishebo, okuhitsya aha baijukuru n'abaijukuruza. <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Ninkweshengyereza saasira okutahikiirira kw'abantu aba, nk'embabazi zaawe nyingi oku ziri, nk'oku oshangwa obasaasira okwiha obu baaruga Misri n'okuhitsya hati.<verse eid="NUM 14:19" /></para>
  <para style="s1">Okufubirwa kwabo ahabw'obugomi</para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:20: </char>
      <char style="xt" closed="false">
        <ref loc="1JN 5:16">1 Yoh 5:16</ref>. </char>
    </note> MUKAMA yaamugira ati: Naabasaasira nk'oku wanshaba; <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" /><note caller="-" style="x"><char style="xo" closed="false">14:21: </char><char style="xt" closed="false"><ref loc="PSA 72:19">Zab 72:19</ref>; <ref loc="HAB 2:14">Hab 2:14</ref>. </char></note> kwonka niinyerahira nti, nk'oku ensi eriijura ekitiinisa kya MUKAMA, <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" /><note caller="-" style="x"><char style="xo" closed="false">14:22: </char><char style="xt" closed="false"><ref loc="PSA 95:11">Zab 95:11</ref>; <ref loc="HEB 4:6">Heb 4:6</ref>, <ref loc="HEB 4:7">7</ref>. </char></note> aha bantu abo boona, abaareebire ekitiinisa kyangye n'obumanyiso obu naakoreire Misri n'omu ihamba, bakangyeza emirundi egi yoona ikumi, batarikworobera iraka ryangye, <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" /><note caller="-" style="x"><char style="xo" closed="false">14:23: </char><char style="xt" closed="false"><ref loc="DEU 1:35">Bir 1:35</ref>; <ref loc="HEB 3:18">Heb 3:18</ref>. </char></note> tihariho n'omwe aharibo orireeba ensi ei naarahiire kuha baishenkurubo; kandi tihariho n'omwe ahari abo abangayire origireeba, <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" /><note caller="-" style="x"><char style="xo" closed="false">14:24: </char><char style="xt" closed="false"><ref loc="PSA 25:12">Zab 25:12</ref>, <ref loc="PSA 25:13">13</ref>; <ref loc="MAT 5:5">Mat 5:5</ref>. </char></note> kureka omwiru wangye Kalebu, ahabw'okuba aine omutima ogundi, ogutari nk'ogwabo, akankuratirira kimwe; ogwo ndyamuhitsya omu nsi ei yaagiiremu; n'oruzaaro rwe ruryagihungura. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Mbwenu, nk'oku Abaamaleki n'Abanyakanaani batwire omu mpanga, nyencakare muhindukye, mugarukye omu ihamba, mutoore omuhanda ogurikuza aha Nyanja erikutukura.<verse eid="NUM 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />Kandi MUKAMA yaagambira Musa na Arooni ati: <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" /><note caller="-" style="x"><char style="xo" closed="false">14:27: </char><char style="xt" closed="false"><ref loc="EXO 16:12">Kur 16:12</ref>, <ref loc="EXO 16:28">28</ref>; <ref loc="1CO 10:10">1 Kor 10:10</ref>. </char></note> Eihanga eri eribi riryahitsya hi okuunyetomboitera? Mpuriire okwetomboita oku Abaisraeli barikuunyetomboitera. <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Bagambire oti: MUKAMA naagira ati: Buzimazima niinyerahira nti, nk'oku mpuriire nimugamba, nikwo ndibagira; <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" /><note caller="-" style="x"><char style="xo" closed="false">14:29: </char><char style="xt" closed="false"><ref loc="HEB 3:18">Heb 3:18</ref>. </char></note> emitumbi yaanyu eryagwa omuri eri ihamba; abaabazirwe mwena, nk'omubaro gwanyu gwona ogw'abahikize emyaka makumi abiri n'okukiraho oku guri, mwena abaanyetomboiteire, <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />buzima timurihika mu nsi ei naimukiize omukono nindahira kubaha ngu mugituuremu, kureka Kalebu mwene Yefune na Yoshua mwene Nuuni. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" /><note caller="-" style="x"><char style="xo" closed="false">14:31: </char><char style="xt" closed="false"><ref loc="PRO 1:25">Enf 1:25</ref>, <ref loc="PRO 1:26">26</ref>; <ref loc="HEB 12:16">Heb 12:16</ref>, <ref loc="HEB 12:17">17</ref>. </char></note> Kwonka abaana baanyu abato, abu mugizire ngu baryaba eminyago, nibo ndigihitsyamu, bakamanya ensi ei mwangire. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Kwonka imwe, emitumbi yaanyu eryagwa omuri eri ihamba; <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" /><note caller="-" style="x"><char style="xo" closed="false">14:33: </char><char style="xt" closed="false"><ref loc="DEU 2:14">Bir 2:14</ref>. </char></note> kandi abaana baanyu baryamara emyaka makumi ana nibarizengyereramu nibariisa, nibaturwa obuteesigwa bwanyu, okuhitsya obu emitumbi yaanyu yoona eriziikwa omu ihamba. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" /><note caller="-" style="x"><char style="xo" closed="false">14:34: </char><char style="xt" closed="false"><ref loc="PSA 95:10">Zab 95:10</ref>; <ref loc="HEB 4:1">Heb 4:1</ref>. </char></note> Nk'ebiro makumi ana ebi mwatatiiremu egyo nsi oku birikwingana, ekiro kimwe kiryaingana omwaka, mumare emyaka makumi ana mwine orubanja rw'okutahikiirira, kandi muryamanya ku mbagwereirwe kubi. <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" /><note caller="-" style="x"><char style="xo" closed="false">14:35: </char><char style="xt" closed="false"><ref loc="NUM 23:19">Kub 23:19</ref>. </char></note> Niinye MUKAMA owaakigamba; buzimazima eki nikyo ndikora aha ihanga eri ryona eribi, eriteeraine kundwanisa; baryahwera omuri eri ihamba, kandi nimwo barifeera.<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:36: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 13:31">Kub 13:31</ref>. </char>
    </note> Kandi abo bashaija abu Musa yaatumire kutata ensi, kandi abaagarukire, bakareetera eihanga ryona kumwetomboitera ahabw'okugamba kubi ahari egyo nsi, <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" /><note caller="-" style="x"><char style="xo" closed="false">14:37: </char><char style="xt" closed="false"><ref loc="JUD 1:5">Yud 1:5</ref>. </char></note> abo bashaija abaagambire kubi ahari egyo nsi baitirwa orufu omu maisho ga MUKAMA. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />Kwonka Yoshua mwene Nuuni na Kalebu mwene Yefune, bamwe ahari abo abaagiire kutata ensi, baaba nibo baahonokaho.<verse eid="NUM 14:38" /></para>
  <para style="s1">Abaisraeli okuteeraho kuteera Kanaani n'okubingwa kwabo</para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">14:39: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:17">Heb 12:17</ref>. </char>
    </note> Musa ku yaagambiire Abaisraeli ebyo bigambo, abantu baashaasha munonga. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" /><note caller="-" style="x"><char style="xo" closed="false">14:40: </char><char style="xt" closed="false"><ref loc="DEU 1:40-44">Bir 1:40-44</ref>. </char></note> Baimuka kare omu kasheeshe, bainamuka kuza omu kibungo nibagira bati: Reeba turi aha, nitwinamuka kuza omu nsi ei MUKAMA yaaraganiise kutuha; ahakuba tusiisire. <verse eid="NUM 14:40" /><verse number="41" style="v" sid="NUM 14:41" /><note caller="-" style="x"><char style="xo" closed="false">14:41: </char><char style="xt" closed="false"><ref loc="2CH 24:20">2 Bus 24:20</ref>; <ref loc="JOB 9:4">Yob 9:4</ref>. </char></note> Musa yaabagira ati: Ahabw'enki nimushobya ekiragiro kya MUKAMA? Eki murikukora tikirikwija kuba gye. <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Mutainamuka, mukasingurwa abazigu baanyu; ahabw'okuba MUKAMA tari muriimwe. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" /><note caller="-" style="x"><char style="xo" closed="false">14:43: </char><char style="xt" closed="false"><ref loc="JDG 16:20">Bar 16:20</ref>. </char></note> Mumanye ngu omu maisho gaanyu harimu Abaamaleki n'Abanyakanaani, nimwija kwitwa rurara, ahakuba muteishukire mwareka kukuratira MUKAMA; n'ahabw'ekyo tarikwija kuguma naimwe. <verse eid="NUM 14:43" /><verse number="44" style="v" sid="NUM 14:44" />Kwonka bo baabigaya, baagumizamu bainamuka omu kibungo; kwonka eshanduukye y'endagaano ya MUKAMA tiyaaruga mu rusiisira, n'obu yaakuba Musa. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Bwanyima Abaamaleki n'Abanyakanaani abaabaire batwire omuri ekyo kibungo baashuuma, baabateera, baababinga, baabahitsya Horuma.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s1">Ebindi biragiro</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />MUKAMA yaagira Musa ati: <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />Gambira Abaisraeli ebigambo byangye ebi ndikugamba ningira nti: Ku murihika omu nsi ei ndikubaha, ei murikuza kutuuramu, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" /><note caller="-" style="x"><char style="xo" closed="false">15:3: </char><char style="xt" closed="false"><ref loc="EZK 20:41">Ezk 20:41</ref>; <ref loc="2CO 2:15">2 Kor 2:15</ref>; <ref loc="PHP 4:18">Fil 4:18</ref>. </char></note> mwayenda kuhongyera MUKAMA empongano z'okwotsya omu muriro, n'obu kiriba kiri ekitambo ky'okwotsya, nari ekitambo ky'okuhikiiriza eki waaraganiise noohiga, nari eky'okuhonga ahabw'okweyendera, nari eky'okuhonga aha magyenyi gaanyu agaatairweho, kuba ekisooroora kirungi ahari MUKAMA, nimukiiha omu masyo g'ente nari ag'entaama, <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" /><note caller="-" style="x"><char style="xo" closed="false">15:4: </char><char style="xt" closed="false"><ref loc="LEV 2:1">Lev 2:1</ref>. </char></note> orihonga empongano ye ahongyere MUKAMA empongano y'esaano ey'ekicweka kimwe kya ikumi kya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kana kya hiini y'amajuta g'emizeituuni, <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />kandi, oteekateekye ekicweka kimwe kya kana kya hiini ya viinyo ahabwa buri mwana gw'entaama, kuba empongano ey'eby'okunywa, ehongwe hamwe n'ekitambo ky'okwotsya nari ekindi kitambo. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />Nari ku eriba eri empaya y'entaama oteekateekye ebicweka bibiri bya ikumi bya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kashatu ekya hiini y'amajuta g'emizeituuni kuba empongano y'esaano y'okuhongwa n'egyo mpaya; <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />kandi ohongye ekicweka kimwe kya kashatu kya hiini ya viinyo kuba empongano y'eby'okunywa ey'omugaju murungi ahari MUKAMA. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" /><note caller="-" style="x"><char style="xo" closed="false">15:8: </char><char style="xt" closed="false"><ref loc="LEV 7:11">Lev 7:11</ref>. </char></note> Kandi ku oriteekateeka enimi y'ekimasha kuba ekitambo ky'okwotsya, nari ekindi kitambo eky'okuhikiiriza eki waaraganiise noohiga, nari empongano z'okusiima ahabw'obusingye ez'okuhongyera MUKAMA, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />oriba naahonga egyo nimi, agihongye n'ebicweka bishatu bya ikumi bya eefa y'esaano y'obunono ejwangizemu ekicweka kimwe kya kabiri kya hiini y'amajuta g'emizeituuni kuba empongano y'esaano. <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />Kandi oryahonga ekicweka kimwe kya kabiri kya hiini ya viinyo kuba empongano y'eby'okunywa, byona bibe empongano ey'okwotsya omu muriro ey'ekisooroora kirungi ekirikushemeza MUKAMA. <verse eid="NUM 15:10" /><verse number="11" style="v" sid="NUM 15:11" />Okwo bibe nikwo byaguma nibikorwa ahari buri nimi, nari buri mpaya, nari ahari buri mpaya nto y'entaama nari ey'embuzi. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Nk'ebitambo ebi muriteekateeka oku birikwingana, mube nikwo mwakora ahabwa buri kimwe nk'omubaro gwabyo oku guri. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />Enzaarwa zoona ziryaguma zikore ebyo zityo, ku ziriba nizihonga empongano ez'okwotsya omu muriro ez'ekisooroora kirungi ekirikushemeza MUKAMA. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Kandi omunyaihanga ku ariba abashuhuukiiremu nari omuntu weena oriba atwire naimwe omu busingye bwanyu bwona, yaayenda kuhonga empongano ey'okwotsya omu muriro, ey'ekisooroora kirungi ekirikushemeza MUKAMA, nk'oku mutwaza, abe nikwo yaatwaza. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" /><note caller="-" style="x"><char style="xo" closed="false">15:15: </char><char style="xt" closed="false"><ref loc="GAL 3:28">Gal 3:28</ref>; <ref loc="COL 3:11">Kol 3:11</ref>. </char></note> Ahabw'eihanga haryabaho ekiragiro kimwe ekitairweho ahabwanyu n'ahabw'omunyaihanga obashuhuukiiremu, ekiragiro ekitarihwaho omu busingye bwanyu bwona; nkaimwe oku muri, n'omunyaihanga nikwo ariba omu maisho ga MUKAMA. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Muryagira ekiragiro kimwe n'omugyenzo gumwe hamwe n'omunyaihanga obashuhuukiiremu.<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />MUKAMA yaagira Musa ati: <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />Gambira Abaisraeli ebigambo byangye ebi ndikugamba ningira nti: Ku murihika omu nsi ei ndikubatwaramu, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />mwarya aha by'okurya byayo, muryahongyera MUKAMA empongano. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" /><note caller="-" style="x"><char style="xo" closed="false">15:20: </char><char style="xt" closed="false"><ref loc="NEH 10:37">Neh 10:37</ref>; <ref loc="PRO 3:9">Enf 3:9</ref>. </char></note> Aha saano ei muribanza kusa muryahonga omugaati kuba empongano; muryagihonga kuba empongano erugire aha mbuga y'okuhuuriraho. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Aha saano ei muribanza kusa muryaihaho empongano y'okuhongyera MUKAMA omu busingye bwanyu bwona. <verse eid="NUM 15:21" /><verse number="22" style="v" sid="NUM 15:22" /><note caller="-" style="x"><char style="xo" closed="false">15:22: </char><char style="xt" closed="false"><ref loc="LEV 4:2">Lev 4:2</ref>. </char></note> Kwonka ku murishobya, mutaarinda biragiro ebi byona, ebi MUKAMA yaaragiire Musa, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />nibyo byona ebi MUKAMA yaabaragiriire omuri Musa, okwiha aha kiro eki MUKAMA yaaragiriireho ebiragiro okuhitsya ebiro byona omu busingye bwanyu bwona, <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" /><note caller="-" style="x"><char style="xo" closed="false">15:24: </char><char style="xt" closed="false"><ref loc="NUM 28:15">Kub 28:15</ref>. </char></note> kumuriba mutakikozire nkana, kandi kitaamanywa ihanga, eihanga ryona riryahonga enimi nto kuba ekitambo ky'okwotsya, eky'ekisooroora kirungi ekihongyeirwe MUKAMA, hamwe n'empongano y'esaano yaakyo n'empongano y'eby'okunywa byakyo, nk'emigyenzo yaabyo oku eri, kandi n'empaya y'embuzi kuba ekitambo ky'ekibi. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" /><note caller="-" style="x"><char style="xo" closed="false">15:25: </char><char style="xt" closed="false"><ref loc="LEV 4:20">Lev 4:20</ref>; <ref loc="HEB 10:10-12">Heb 10:10-12</ref>; <ref loc="1JN 2:1">1 Yoh 2:1</ref>, <ref loc="1JN 2:2">2</ref>. </char></note> Omunyamurwa arihiirire eihanga ry'Abaisraeli ryona, kandi riryasaasirwa; ahabw'okuba baryaba batakikozire nkana, kandi baryaba bareetsire empongano yaabo, eyokiibwe omu muriro, ehongyeirwe MUKAMA, bareetsire n'ekitambo ky'ekibi omu maisho ga MUKAMA ahabw'ekyo kibi ki batarakozire nkana. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />N'ahabw'ekyo eihanga ryona ery'Abaisraeli hamwe n'omunyaihanga oriba abashuhuukiiremu, baryasaasirwa; ahakuba eihanga ryona riryaba ritakikozire nkana.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">15:27: </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:48">Luk 12:48</ref>. </char>
    </note> Kandi omuntu omwe ku arikora ekibi atakikozire nkana, ahongye omwagazi gw'embuzi oguhikize omwaka kuba ekitambo ky'ekibi. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Omunyamurwa arihiirire ogwo oriba ashobize, akakora ekibi omu maisho ga MUKAMA, atakikozire nkana; ku ariheza kumurihiirira, ogwo muntu aryasaasirwa. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Muryagira ekiragiro kimwe aha bw'omuntu weena okozire ekibi, atakikozire nkana, yaaba nzaarwa y'omu Baisraeli nari omunyaihanga oriba abashuhuukiiremu. <verse eid="NUM 15:29" /><verse number="30" style="v" sid="NUM 15:30" /><note caller="-" style="x"><char style="xo" closed="false">15:30: </char><char style="xt" closed="false"><ref loc="PSA 19:13">Zab 19:13</ref>; <ref loc="HEB 10:26-28">Heb 10:26-28</ref>. </char></note> Kwonka omuntu weena orikora ekibi nkana n'amaryo, yaaba nzaarwa nari omunyaihanga, ogwo muntu aryaba ajumire MUKAMA, kandi aryacuubwa omu ihanga rye. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" /><note caller="-" style="x"><char style="xo" closed="false">15:31: </char><char style="xt" closed="false"><ref loc="2SA 12:9">2 Sam 12:9</ref>; <ref loc="PRO 13:13">Enf 13:13</ref>. </char></note> Ahabw'okugaya ekigambo kya MUKAMA n'okushobya ekiragiro kye, ogwo muntu aryacwerwa kimwe, okutahikiirira kumugumeho.<verse eid="NUM 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Abaisraeli ku baabaire bakiri omu ihamba, baashanga omuntu naatorotoora enku ahari sabato. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />Abaamushangire naazitorotoora, baamutwara ahari Musa na Arooni n'eihanga ryona. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" /><note caller="-" style="x"><char style="xo" closed="false">15:34: </char><char style="xt" closed="false"><ref loc="LEV 24:12">Lev 24:12</ref>. </char></note> Baamukingirana, ahabw'okuba bakaba batakagambiirwe oku baraamugire. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" /><note caller="-" style="x"><char style="xo" closed="false">15:35: </char><char style="xt" closed="false"><ref loc="EXO 31:14">Kur 31:14</ref>, <ref loc="EXO 31:15">15</ref>. </char></note> MUKAMA yaagira Musa ati: Buzimazima omushaija ogwo aitwe; eihanga ryona rimuteerere amabaare aheeru y'orusiisira. <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Eihanga ryona ryamutwara aheeru y'orusiisira, ryamuteera amabaare, yaafa; nk'oku MUKAMA yaaragiire Musa.<verse eid="NUM 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />MUKAMA yaagira Musa ati: <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" /><note caller="-" style="x"><char style="xo" closed="false">15:38: </char><char style="xt" closed="false"><ref loc="DEU 22:12">Bir 22:12</ref>; <ref loc="MAT 23:5">Mat 23:5</ref>. </char></note> Gambira Abaisraeli, bagume bakore ebijwengye aha mikugiro y'ebijwaro byabo omu busingye bwabo bwona, kandi babaziire aha kijwengye ky'ahari buri nshonda akenda ka bururu; <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" /><note caller="-" style="x"><char style="xo" closed="false">15:39: </char><char style="xt" closed="false"><ref loc="EZK 6:9">Ezk 6:9</ref>; <ref loc="PSA 106:39">Zab 106:39</ref>; <ref loc="JAS 4:4">Yak 4:4</ref>. </char></note> kibe ekijwengye eki muraagume nimureebaho, mukaijuka ebiragiro byona ebya MUKAMA, mukabyorobera, mukareka kukuratira ebi emitima yaanyu n'amaisho gaanyu byetenga, ebi mwabaire mukurata nimuraaya; <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" /><note caller="-" style="x"><char style="xo" closed="false">15:40: </char><char style="xt" closed="false"><ref loc="COL 1:22">Kol 1:22</ref>; <ref loc="1PE 1:15">1 Pet 1:15</ref>. </char></note> mubone kwijuka n'okworobera ebiragiro byangye byona, n'okuba abarikwera ahari Ruhanga waanyu. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Niinye MUKAMA Ruhanga waanyu owaabaihire omu nsi ya Misri okuba Ruhanga waanyu. Niinye MUKAMA Ruhanga waanyu.<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s1">Okugoma kw'aba Koora n'okufa kwabo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:1: </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:11">Yud 1:11</ref>. </char>
    </note> Koora mwene Izuhaari, mwijukuru wa Kohasi mwene Leevi, na Dasani na Abiraamu beene Eliabu, na Oni mwene Pelesi, beene Reubeeni, bakatwara abantu; <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />baimuka omu maisho ga Musa, bakwataniise n'abamwe omu Baisraeli, abeebembezi b'eihanga magana abiri na makumi ataano, abashaija rugambwa abaatoorainwe omu mutwe gw'abateeraine, <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" /><note caller="-" style="x"><char style="xo" closed="false">16:3: </char><char style="xt" closed="false"><ref loc="PSA 106:16-18">Zab 106:16-18</ref>; <ref loc="EXO 19:6">Kur 19:6</ref>. </char></note> baayeteerana hamwe kugomera Musa na Arooni, baabagira bati: Mwekurize mwahingurana; ahakuba abantu b'eihanga ryona n'abarikwera, buri omwe omuribo, kandi MUKAMA ari omuribo. Mbwenu nimwekuriza ki aha ihanga rya MUKAMA? <verse eid="NUM 16:3" /><verse number="4" style="v" sid="NUM 16:4" /><note caller="-" style="x"><char style="xo" closed="false">16:4: </char><char style="xt" closed="false"><ref loc="NUM 20:6">Kub 20:6</ref>. </char></note> Musa ku yaakihuriire, yaajuumara ahansi; <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" /><note caller="-" style="x"><char style="xo" closed="false">16:5: </char><char style="xt" closed="false"><ref loc="2TI 2:19">2 Tim 2:19</ref>; <ref loc="EXO 28:11">Kur 28:11</ref>; <ref loc="PSA 105:26">Zab 105:26</ref>; <ref loc="LEV 10:3">Lev 10:3</ref>. </char></note> yaagambira Koora n'omutwe gwe gwona, naagira ati: Omu kasheeshe MUKAMA naija kworeka ori owe, kandi n'ori orikwera, amwirize haihi; ogwo ou araatoorane, niwe arayeiririze haihi. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Mukore muti; iwe Koora n'omutwe gwawe gwona, mutware ebyoterero, <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />mubiiteho omuriro, kandi omu kasheeshe mubiteho obubaane omu maisho ga MUKAMA; bwanyima omuntu ou MUKAMA araatoorane, niwe araabe orikwera. Imwe beene Leevi, mwekurize mwahingurana. <verse eid="NUM 16:7" /><verse number="8" style="v" sid="NUM 16:8" />Musa yaagaruka yaagira Koora ati: Imwe beene Leevi, muhurire! <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" /><note caller="-" style="x"><char style="xo" closed="false">16:9: </char><char style="xt" closed="false"><ref loc="DEU 10:8">Bir 10:8</ref>. </char></note> Imwe nimugira ngu n'ekigambo kikye Ruhanga wa Israeli okubashoroora omu ihanga rya Israeli, akabeehitsya haihi kukora omurimo gw'omu Butaaho bwa MUKAMA, n'okuguma nimwemerera omu maisho g'eihanga ryona okuriheereza, <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />kandi naiwe okukwiriza haihi hamwe na bagyenzi baawe boona beene Leevi; mbwenu nimwenda n'obunyamurwa? <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" /><note caller="-" style="x"><char style="xo" closed="false">16:11: </char><char style="xt" closed="false"><ref loc="EXO 16:8">Kur 16:8</ref>; <ref loc="1CO 3:5">1 Kor 3:5</ref>. </char></note> N'ahabw'ekyo mumanye ngu iwe n'omutwe gwawe gwona, ou mweteeraine kurwanisa ni MUKAMA; kandi Arooni niwe oha, imwe kumwetomboitera?<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />Bwanyima Musa yaatuma kweta Dasani na Abiraamu, beene Eliabu; baagira bati: Titurikwija kwinamukayo; <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" /><note caller="-" style="x"><char style="xo" closed="false">16:13: </char><char style="xt" closed="false"><ref loc="EXO 2:14">Kur 2:14</ref>; <ref loc="ACT 7:27">Byak 7:27</ref>, <ref loc="ACT 7:35">35</ref>. </char></note> noogira ngu n'ekintu kikye iwe okutwiha omu nsi y'amate n'obwoki, okatwinamura omu ihamba kutwitiramu, haza n'okwehindura okatwehinduraho omukama? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Kandi otatureetsire omu nsi y'amate n'obwoki, n'obu kwakuba okutuha obuhunguzi bw'obutaka n'emisiri y'emizaabibu. Nooyenda kwihamu abantu aba amaisho? Titurikwija kwinamukayo.<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:15: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 12:3">1 Sam 12:3</ref>; <ref loc="ACT 20:33">Byak 20:33</ref>; <ref loc="2CO 7:2">2 Kor 7:2</ref>. </char>
    </note> Musa yaagira ekiniga kingi, yaagambira MUKAMA ati: Otaikiriza empongano yaabo. Tinkabanyagaga n'obu yaakuba endogoya n'emwe; kandi tihariho n'omwe muribo ou ndakozire kubi. <verse eid="NUM 16:15" /><verse number="16" style="v" sid="NUM 16:16" />Musa yaagira Koora ati: Nyencakare iwe n'omutwe gwawe gwona mwije na Arooni, muhikye omu maisho ga MUKAMA. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Buri muntu omuriimwe areete ekyoterero kye, akiteho obubaane, mubireete omu maisho ga MUKAMA, buri muntu ayereetere ekye, ebyoterero byona magana abiri na makumi ataano; naiwe na Arooni mureete ebyanyu. <verse eid="NUM 16:17" /><verse number="18" style="v" sid="NUM 16:18" />Buri muntu omuribo yaatwara ekyoterero kye, boona baabitaho omuriro, baataho n'obubaane, baayemerera aha muryango gw'Eihema ry'okubugaabuganiramu hamwe na Musa na Arooni. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" /><note caller="-" style="x"><char style="xo" closed="false">16:19: </char><char style="xt" closed="false"><ref loc="EXO 16:10">Kur 16:10</ref>; <ref loc="LEV 9:23">Lev 9:23</ref>. </char></note> Koora yaateerana abantu b'eihanga ryona, baabaza omu maisho aha muryango gw'Eihema ry'okubugaabuganiramu; ekitiinisa kya MUKAMA kyabonekyera eihanga ryona.<verse eid="NUM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 16:20" />MUKAMA yaagira Musa na Arooni ati: <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" /><note caller="-" style="x"><char style="xo" closed="false">16:21: </char><char style="xt" closed="false"><ref loc="JER 51:6">Yer 51:6</ref>; <ref loc="ACT 2:40">Byak 2:40</ref>; <ref loc="REV 18:4">Kush 18:4</ref>; <ref loc="EXO 32:10">Kur 32:10</ref>. </char></note> Mwetaanise n'omutwe ogu, mbone kubacwekyereza omuri aka kaanya. <verse eid="NUM 16:21" /><verse number="22" style="v" sid="NUM 16:22" /><note caller="-" style="x"><char style="xo" closed="false">16:22: </char><char style="xt" closed="false"><ref loc="JOB 12:10">Yob 12:10</ref>; <ref loc="2SA 24:17">2 Sam 24:17</ref>; <ref loc="EZK 18:20">Ezk 18:20</ref>. </char></note> Baajuumara ahansi nibagira bati: Ai Ruhanga, Ruhanga w'emyoyo y'abantu boona, omuntu omwe ku araashiishe, noogirira ekiniga eihanga ryona? <verse eid="NUM 16:22" /><verse number="23" style="v" sid="NUM 16:23" />MUKAMA yaagira Musa ati: <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />Gambira abantu oti: Mwimukye, murugye aha mahema g'aba Koora, Dasani na Abiraamu. <verse eid="NUM 16:24" /><verse number="25" style="v" sid="NUM 16:25" />Musa yaimuka, yaaza owa Dasani na Abiraamu; abakuru b'Abaisraeli baagyenda bamukuratiire. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" /><note caller="-" style="x"><char style="xo" closed="false">16:26: </char><char style="xt" closed="false"><ref loc="GEN 19:12">Kut 19:12</ref>; <ref loc="2CO 6:17">2 Kor 6:17</ref>. </char></note> Yaagambira omutwe gwona ati: Nimbeeshengyereza, murugye aha mahema g'aba bantu babi, kandi mutagira ekintu kyabo kyona eki mwakoraho, mutakaacwekyerezibwa nabo omu kifubiro ky'ebibi byabo. <verse eid="NUM 16:26" /><verse number="27" style="v" sid="NUM 16:27" /><note caller="-" style="x"><char style="xo" closed="false">16:27: </char><char style="xt" closed="false"><ref loc="JOB 9:4">Yob 9:4</ref>. </char></note> Abantu nikwo kwimuka, bakaruga aha mbaju zoona ez'amahema g'aba Koora, Dasani na Abiraamu. Bwanyima Dasani na Abiraamu baashohora, baayemerera aha miryango y'amahema gaabo hamwe n'abakazi baabo n'abatabani baabo n'abaana baabo abato. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" /><note caller="-" style="x"><char style="xo" closed="false">16:28: </char><char style="xt" closed="false"><ref loc="EXO 3:12">Kur 3:12</ref>; <ref loc="DEU 18:22">Bir 18:22</ref>. </char></note> Musa yaagira ati: Aha niho muraamanyire MUKAMA ku niwe yantumire kukora emirimo egi yoona; kandi ku ntaragikozire ahabwangye. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Abantu aba ku baraafe orufu orwita abandi boona, nari shi ku baraaguubweho ebigwa aha bandi boona, biri MUKAMA tarantumire. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" /><note caller="-" style="x"><char style="xo" closed="false">16:30: </char><char style="xt" closed="false"><ref loc="PSA 55:15">Zab 55:15</ref>; <ref loc="REV 9:2">Kush 9:2</ref>. </char></note> Kwonka MUKAMA ku araakore ekitakareebwaga, eitaka okwashama, rikabamira hamwe n'ebyabo byona, bakashuuma okuzimu bahuriire, niho muraamanyire abantu aba ku bagayire MUKAMA.<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:17">Zab 106:17</ref>. </char>
    </note> Ku yaabaire naakiheza kugamba ebigambo ebyo byona, eitaka eri beemereireho ryagangabuka; <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />ensi yaayashama, yaabamira n'amaka gaabo, hamwe n'aba Koora boona n'ebintu byabo byona. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Batyo bo n'abaabo boona baashuuma okuzimu bahuriire, eitaka ryabashweka, baacwekyerera, baihwa omu ihanga. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Abaisraeli boona abaabaire babeehinguririize baahunga ahabw'okuborooga kwabo, nibagira bati: Tuhungye, naitwe ensi etakaatumira. <verse eid="NUM 16:34" /><verse number="35" style="v" sid="NUM 16:35" /><note caller="-" style="x"><char style="xo" closed="false">16:35: </char><char style="xt" closed="false"><ref loc="LEV 10:2">Lev 10:2</ref>; <ref loc="PSA 106:18">Zab 106:18</ref>. </char></note> Ahonaaho omuriro gwaruga ahari MUKAMA, gwayokyeza kimwe abo bashaija magana abiri na makumi ataano abaabaire nibootera obubaane.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />Bwanyima MUKAMA yaagira Musa ati: <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />Gambira Eleazaari mwene Arooni omunyamurwa ashahure ebyo byoterero omu muriro, kandi naiwe ogutaataanise, ahabw'okuba n'ebirikwera. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" /><note caller="-" style="x"><char style="xo" closed="false">16:38: </char><char style="xt" closed="false"><ref loc="EZK 14:8">Ezk 14:8</ref>; <ref loc="1CO 10:11">1 Kor 10:11</ref>. </char></note> Ebyoterero by'abo basiisi, abasiisire bakafa, babiheeshemu ebyoma eby'okushweka eitambiro; ahakuba babihongyeire MUKAMA, n'ahabw'ekyo n'ebirikwera; kandi biryaguma biri eky'okureeberaho aha Baisraeli. <verse eid="NUM 16:38" /><verse number="39" style="v" sid="NUM 16:39" />Eleazaari omunyamurwa nikwo kutwara ebyo byoterero by'emiringa, ebi abookiibwe babaire bahongire, bakabiheeshamu eky'okushweka eitambiro, <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" /><note caller="-" style="x"><char style="xo" closed="false">16:40: </char><char style="xt" closed="false"><ref loc="NUM 18:4-7">Kub 18:4-7</ref>; <ref loc="1KI 13:1">1 Bag 13:1</ref>. </char></note> kandi n'okuba ekiijutsyo aha Baisraeli, ngu hatarigira omuntu otari w'omu ruzaaro rwa Arooni owairira haihi kwotera obubaane omu maisho ga MUKAMA, akaba nka Koora n'ab'ekigombe kye; yaabikora nk'oku MUKAMA yaamugambiire naaraba omuri Musa.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">16:41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:13">Zab 106:13</ref>, <ref loc="PSA 106:26">26</ref>; <ref loc="MAT 5:11">Mat 5:11</ref>; <ref loc="2CO 6:8">2 Kor 6:8</ref>. </char>
    </note> Kwonka omu kasheeshe eihanga ry'Abaisraeli ryona ryayetomboitera Musa na Arooni riti: Mwitsire abantu ba MUKAMA. <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" /><note caller="-" style="x"><char style="xo" closed="false">16:42: </char><char style="xt" closed="false"><ref loc="NUM 14:10">Kub 14:10</ref>. </char></note> Abantu ku baayeteeraine kugomera Musa na Arooni, baanaga amaisho ei Eihema ry'okubugaabuganiramu riri, baareeba ekicu kiri kirishwekire, kandi ekitiinisa kya MUKAMA kyareebeka. <verse eid="NUM 16:42" /><verse number="43" style="v" sid="NUM 16:43" />Musa na Arooni baaza omu maisho g'Eihema ry'okubugaabuganiramu. <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />MUKAMA yaagambira Musa ati: <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" /><note caller="-" style="x"><char style="xo" closed="false">16:45: </char><char style="xt" closed="false"><ref loc="1CH 21:16">1 Bus 21:16</ref>. </char></note> Mwimukye murugye omuri aba bantu, mbone kubacwekyereza omuri aka kaanya. Baajuumara ahansi. <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" /><note caller="-" style="x"><char style="xo" closed="false">16:46: </char><char style="xt" closed="false"><ref loc="NUM 1:53">Kub 1:53</ref>; <ref loc="NUM 11:33">11:33</ref>; <ref loc="JOS 7:1">Yos 7:1</ref>; <ref loc="1CH 27:24">1 Bus 27:24</ref>. </char></note> Musa yaagira Arooni ati: Twara ekyoterero kyawe, okiteho omuriro ogw'aha itambiro, oteho n'obubaane, okitware ahonaaho omu bantu, obarihiirire; ahabw'okuba ekiniga kyaruga ahari MUKAMA, orufu rwatandika. <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Arooni yaakitwara nk'oku Musa yaamuragiire, yairuka yaaza ahagati y'abantu abaabaire beeteeraine, yaashanga orufu rwatandikire omu bantu; yaakitaho obubaane, yaarihiirira abantu. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Yaayemerera ahagati y'abafiire n'abahuriire; orufu rwazibirwa. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" /><note caller="-" style="x"><char style="xo" closed="false">16:49: </char><char style="xt" closed="false"><ref loc="2SA 24:16">2 Sam 24:16</ref>, <ref loc="2SA 24:25">25</ref>; <ref loc="JOB 33:24">Yob 33:24</ref>; <ref loc="PSA 106:30">Zab 106:30</ref>; <ref loc="HEB 7:24">Heb 7:24</ref>. </char></note> Abaitsirwe orwo rufu bakaba bari abantu kakumi n'enkumi ina na magana mushanju, otabariiremu abafiire ahabw'ebya Koora. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Arooni yaagaruka ahari Musa aha muryango gw'Eihema ry'okubugaabuganiramu, orufu rwaheza kuzibirwa.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s1">Enkoni ya Arooni okutooka</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />Kandi MUKAMA yaagira Musa ati: <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />Gambira Abaisraeli bareete enkoni, emwe omuri buri ruganda rwa baishenkurubo, zireetwe abeebembezi baabo, nk'amaju ga baishenkurubo oku gari, enkoni zoona zibe ikumi na ibiri. Ohandiikye eiziina rya buri muntu aha nkoni ye. <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />Kandi ohandiikye eiziina rya Arooni aha nkoni ya Leevi, ahakuba omukuru wa buri ruganda rwa baishenkuru naija kugira enkoni emwe; <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" /><note caller="-" style="x"><char style="xo" closed="false">17:4: </char><char style="xt" closed="false"><ref loc="EXO 25:22">Kur 25:22</ref>. </char></note> ozibiikye omu Ihema ry'okubugaabuganiramu omu maisho g'Ebirikuhamya, ahu mbugaabuganira naimwe. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" /><note caller="-" style="x"><char style="xo" closed="false">17:5: </char><char style="xt" closed="false"><ref loc="NUM 16:5">Kub 16:5</ref>. </char></note> Enkoni y'omushaija ou ndaatoorane neija kutooka, ntyo mmareho okwetomboita omu maisho gangye oku Abaisraeli barikubeetomboitera. <verse eid="NUM 17:5" /><verse number="6" style="v" sid="NUM 17:6" />Musa yaabigambira Abaisraeli, abeebembezi baabo boona baamuha enkoni, buri mwebembezi yaamuha emwe, nk'enganda za baishenkurubo oku zaabaire ziri, enkoni zoona ikumi na ibiri; kandi n'enkoni ya Arooni yaaziteebwamu. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" /><note caller="-" style="x"><char style="xo" closed="false">17:7: </char><char style="xt" closed="false"><ref loc="NUM 18:2">Kub 18:2</ref>; <ref loc="ACT 7:44">Byak 7:44</ref>. </char></note> Musa yaazita omu maisho ga MUKAMA omu Ihema ry'Ebirikuhamya.<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />Omu kasheeshe Musa ku yaataahire omu Ihema ry'Ebirikuhamya, yaashanga enkoni ya Arooni, ey'oruganda rwa Leevi, etookire, erabize kandi ereetsire enjuma zihiisize ezirikwetwa endozi. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Musa yaashohoza enkoni zoona, naaziiha omu maisho ga MUKAMA, yaazireetera Abaisraeli boona, abo bakuru baazireeba, buri muntu yaatwara eye. <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" /><note caller="-" style="x"><char style="xo" closed="false">17:10: </char><char style="xt" closed="false"><ref loc="HEB 9:4">Heb 9:4</ref>; <ref loc="EXO 16:32-34">Kur 16:32-34</ref>. </char></note> MUKAMA yaagira Musa ati: Garura enkoni ya Arooni omu maisho g'Ebirikuhamya, ebiikwe kuba akamanyiso k'okwomesereza abagomi, obone kumaraho okwetomboita oku barikuunyetomboitera, barekye kufa. <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />Okwo nikwo Musa yaakozire; nk'oku MUKAMA yaamuragiire, yaaba nikwo yaakora.<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />Abaisraeli baagira Musa bati: Reeba, nituhwerekyerera, twahwaho, twahwaho twena. <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" /><note caller="-" style="x"><char style="xo" closed="false">17:13: </char><char style="xt" closed="false"><ref loc="NUM 18:4">Kub 18:4</ref>, <ref loc="NUM 18:7">7</ref>. </char></note> Buri muntu orikwija akairira haihi Obutaaho gwa MUKAMA, naafa. Ebyo twahwaho twena?<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s1">Emirimo y'abanyamurwa n'ey'Abaleevi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />MUKAMA yaagira Arooni ati: Iwe n'abatabani baawe n'eka ya sho muryabuuzibwa byona ebiriba byashobire omu by'Omwanya ogurikwera; iwe n'abatabani baawe niimwe muribuuzibwa ebiriba byashobire omu bunyamurwa bwanyu. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" /><note caller="-" style="x"><char style="xo" closed="false">18:2: </char><char style="xt" closed="false"><ref loc="NUM 3:6-37">Kub 3:6-37</ref>. </char></note> Kandi na beene waanyu ab'oruganda rwa Leevi oruganda rwa shwenkuru, obairize haihi naiwe, bagume bakwatanise naiwe, bakuheereze; kwonka iwe n'abatabani baawe niimwe muriguma omu maisho g'Eihema ry'Ebirikuhamya. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Bagume nibooroobera ebi orikubaragiira, kandi bakwatsibwe eby'Eihema byona, kwonka batariirira haihi n'ebintu by'Omwanya ogurikwera n'eitambiro, imwe nabo mutakaafa. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Bakwatanise naiwe, kandi bakwatsibwe eby'Eihema ry'okubugaabuganiramu ahabw'omurimo gw'obuheereza bwaryo bwona; otari w'omuribo atariirira haihi naimwe. <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" /><note caller="-" style="x"><char style="xo" closed="false">18:5: </char><char style="xt" closed="false"><ref loc="NUM 1:53">Kub 1:53</ref>. </char></note> Niimwe mwakwatsibwa eby'Omwanya ogurikwera n'eitambiro, Abaisraeli barekye kugaruka kugirirwa ekiniga. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Kandi reeba, nyihire beene waanyu Abaleevi omu Baisraeli; ahariimwe n'ekiconco ekihairwe MUKAMA okukora omurimo gw'obuheereza omu Ihema ry'okubugaabuganiramu. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" /><note caller="-" style="x"><char style="xo" closed="false">18:7: </char><char style="xt" closed="false"><ref loc="HEB 9:3">Heb 9:3</ref>, <ref loc="HEB 9:6">6</ref>. </char></note> Kwonka iwe n'abatabani baawe mugume nimukora omurimo gw'obunyamurwa ogurikukwata aha buri kintu kyona eky'aha itambiro, n'ahari byona ebiri omunda y'omukingo; egyo niyo mirimo ei muraagume nimukora. Naabaha obunyamurwa nk'ekiconco; otari w'omuriimwe oribyetaasyamu, aryaitwa.<verse eid="NUM 18:7" /></para>
  <para style="s1">Eby'okutunga abanyamurwa n'Abaleevi</para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:8: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 6:16">Lev 6:16</ref>, <ref loc="LEV 6:18">18</ref>. </char>
    </note> MUKAMA yaagira Arooni ati: Nyowe nyenka naakukwatsa eby'empongano byona ebibiikirwe, ebi mpongyeirwe, byona ebi Abaisraeli baanyereza; naabikuha kuba omugabo gwawe n'abatabani baawe okuba ekiragiro ky'ebiro byona. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Ebi ebitarikwokibwa aha birikwera munonga bibe ebyawe; buri mpongano yaabo yoona, buri mpongano yaabo ey'esaano, buri kitambo kyabo eky'ekibi, na buri kitambo kyabo eky'okubaihisaho orubanja rw'ekibi, ebi barimpongyera, biryaba ebirikwera munonga ahabwawe n'abatabani baawe. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Ogume obiriire aharikwera munonga, orikwetwa omushaija weena omuriimwe abe niwe yaabiryaho; biryakubeera ebirikwera. <verse eid="NUM 18:10" /><verse number="11" style="v" sid="NUM 18:11" /><note caller="-" style="x"><char style="xo" closed="false">18:11: </char><char style="xt" closed="false"><ref loc="LEV 7:30-34">Lev 7:30-34</ref>; <ref loc="DEU 18:3">Bir 18:3</ref>, <ref loc="DEU 18:4">4</ref>. </char></note> Kandi ebi nabyo n'ebyawe; empongano zaabo ezi bahayo ahabw'okweyendera, empongano zoona ezizongazongiibwe ez'Abaisraeli, naazikuha n'abatabani baawe na bahara baawe kuba omugabo gwanyu ogw'ebiro byona; buri muntu weena ow'omu ka yaawe oshemeire aryaguma aziryeho. <verse eid="NUM 18:11" /><verse number="12" style="v" sid="NUM 18:12" />Kandi amajuta agarikukira oburungi goona, na viinyo erikukira oburungi yoona, n'engano ezirikukira oburungi zoona, n'emiganuro yaabyo ei bariguma nibareetera MUKAMA, niiwe naabiha. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Ebijuma byona ebiriguma nibibanza kwera omu nsi yaabo, ebi bareetera MUKAMA, biryaba ebyawe; buri muntu weena ow'omu ka yaawe oshemeire aryaguma abiryeho. <verse eid="NUM 18:13" /><verse number="14" style="v" sid="NUM 18:14" />Ekintu kyona ekiriheerwayo kimwe omuri Israeli kiryaba ekyawe. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" /><note caller="-" style="x"><char style="xo" closed="false">18:15: </char><char style="xt" closed="false"><ref loc="EXO 13:2">Kur 13:2</ref>; <ref loc="EXO 34:20">34:20</ref>. </char></note> Emijigaijo yoona ey'ebiine omubiri byona ebi bahongyera MUKAMA, yaaba y'abantu nari ey'enyamaishwa, egume ebe eyaawe; kwonka emijigaijo y'abantu otaribura kugicungura, kandi emijigaijo y'enyamaishwa ezirikuzira nayo oryagicungura. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" /><note caller="-" style="x"><char style="xo" closed="false">18:16: </char><char style="xt" closed="false"><ref loc="EXO 30:13">Kur 30:13</ref>. </char></note> Ebishemereire kucungurwa aharibyo okutandikira aha bihikize okwezi, bicungurwe obuguzi bwa shekeli itaano obu oricwa, nka shekeli ey'Omwanya ogurikwera oku eri, (nizo geera makumi abiri). <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />Kwonka emijigaijo y'ente nari ey'entaama nari ey'embuzi otarigicungura; emijigaijo yaazo n'erikwera; oryaguma oshukyere eitambiro eshagama yaayo, oyotsye ebishaju byayo kuba empongano eyokiibwe omu muriro, ey'ekisooroora kirungi ahari MUKAMA. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Kwonka enyama yaayo ey'enkoro ezongazongiibwe, n'ey'ekivune ky'okuguru kwa buryo eryaguma ebe eyaawe. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Empongano zoona ezirikwera ezi Abaisraeli bahongyera MUKAMA, naazikuha n'abatabani baawe, kuba omugabo gwanyu ogw'ebiro byona; n'endagaano ey'ebiro byona eraganisibwa omwonyo omu maisho ga MUKAMA ahariiwe n'oruzaaro rwawe. <verse eid="NUM 18:19" /><verse number="20" style="v" sid="NUM 18:20" /><note caller="-" style="x"><char style="xo" closed="false">18:20: </char><char style="xt" closed="false"><ref loc="PSA 73:26">Zab 73:26</ref>. </char></note> Kandi MUKAMA yaagira Arooni ati: Iwe torigira buhunguzi omu nsi y'Abaisraeli, n'obu gwakuba omugabo gwona omuribo; niinye mugabo gwawe n'obuhunguzi bwawe omu Baisraeli.<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">18:21: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 12:44">Neh 12:44</ref>; <ref loc="HEB 7:5">Heb 7:5</ref>, <ref loc="HEB 7:8">8</ref>. </char>
    </note> Kandi Abaleevi naabaha ebicweka byona ebya kimwe kya ikumi ebi Abaisraeli barikuha kuba obuhunguzi bwabo ahabw'omurimo gwabo gw'obuheereza, ogu barikukora omu Ihema ry'okubugaabuganiramu. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Kandi okuruga hati Abaisraeli batariirira haihi n'Eihema ry'okubugaabuganiramu, bakagiibwaho ekibi, bakafa. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Kureka Abaleevi babe nibo baakora omurimo gw'obuheereza ogw'Eihema ry'okubugaabuganiramu, kandi babe nibo baagumwaho orubanja rw'okutahikiirira. Kibe ekiragiro ekitarihwaho ebiro byona omu busingye bwanyu bwona; kandi batarigira obuhunguzi omu Baisraeli. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Ahabw'okuba ebicweka bya kimwe kya ikumi ebi Abaisraeli barireeta kuhongyera MUKAMA, naabiha Abaleevi kuba obuhunguzi bwabo; nikyo naabagambirira ku batarigira buhunguzi omu Baisraeli.<verse eid="NUM 18:24" /></para>
  <para style="s1">Abaleevi okuha kimwe kya ikumi</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />MUKAMA yaagira Musa ati: <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" /><note caller="-" style="x"><char style="xo" closed="false">18:26: </char><char style="xt" closed="false"><ref loc="NEH 10:38">Neh 10:38</ref>. </char></note> Kandi ogambire Abaleevi oti: Ku muriiha aha Baisraeli kimwe kya ikumi, eki mbahaire kuba obuhunguzi bwanyu, naimwe mugume mukiiheho kimwe kya ikumi kuba empongano y'okuhongyera MUKAMA. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Egyo mpongano eryababarirwa nk'ey'engano erugire aha mbuga y'okuhuuriraho, kandi nk'eya viinyo enyuukirwe omu icwa ryona ery'emizaabibu. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Okwo mube nikwo mwaguma nimuhongyera MUKAMA empongano ezi mwihire aha bicweka byanyu byona ebya kimwe kya ikumi eki muriiha aha Baisraeli. Kandi aharibyo mugume mwiheho empongano y'okuhongyera MUKAMA, mugihe Arooni omunyamurwa. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Aha biconco byona ebi muriheebwa, mugume muheyo empongano eshemereire kuhongyerwa MUKAMA, nimugiiha aha birikukira oburungi, nimuhayo ebicweka byabyo ebyeziibwe. <verse eid="NUM 18:29" /><verse number="30" style="v" sid="NUM 18:30" />N'ahabw'ekyo obagire oti: Ku muriguma mwaheza kuhonga ebicweka byabyo ebirikukira oburungi, ebiritsigaraho biryabarirwa Abaleevi nk'ekirugire aha mbuga ey'okuhuuriraho, kandi nka viinyo erugire omu inyuukiro; <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" /><note caller="-" style="x"><char style="xo" closed="false">18:31: </char><char style="xt" closed="false"><ref loc="MAT 10:10">Mat 10:10</ref>; <ref loc="1CO 9:13">1 Kor 9:13</ref>; <ref loc="2CO 12:13">2 Kor 12:13</ref>; <ref loc="1TI 5:18">1 Tim 5:18</ref>. </char></note> muryaguma mubiriire ahu murikwenda hoona, imwe n'ab'omu maka gaanyu; ahabw'okuba n'ebihembo byanyu ebi murikuheebwa ahabw'omurimo gwanyu ogu murikukora omu Ihema ry'okubugaabuganiramu. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Kandi timurigira rubanja rw'ekibi ahabwabyo, ku muriheza kubiihaho ebirikukira oburungi, mwabihonga; kandi mutarishiisha ebintu by'Abaisraeli ebirikwera, mukafa.<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s1">Ekitambo ky'enyana y'eruutsi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />MUKAMA yaagambira Musa na Arooni ati: <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" /><note caller="-" style="x"><char style="xo" closed="false">19:2: </char><char style="xt" closed="false"><ref loc="DEU 21:3">Bir 21:3</ref>. </char></note> Ebi nibyo bigambo by'ekiragiro eki MUKAMA yaaragiire, naagira ati: Gambira Abaisraeli bakureetere enyana y'eruutsi kahogo etaine ibara, n'obu kaakuba akamogo, ei batakahingisaga. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" /><note caller="-" style="x"><char style="xo" closed="false">19:3: </char><char style="xt" closed="false"><ref loc="HEB 13:11">Heb 13:11</ref>. </char></note> Mugihe Eleazaari omunyamurwa, agishohoze aheeru y'orusiisira, bagiitire omu maisho ge. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Eleazaari omunyamurwa aihe aha shagama yaayo n'orukumu, agimiisiire emirundi mushanju naatooza ei Eihema ry'okubugaabuganiramu riri; <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" /><note caller="-" style="x"><char style="xo" closed="false">19:5: </char><char style="xt" closed="false"><ref loc="ISA 53:10">Isa 53:10</ref>. </char></note> egyo nyana bagyokyeze omu maisho ge; bootyse oruhu rwayo n'enyama yaayo n'eshagama yaayo n'efa yaayo. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Omunyamurwa atware ekiti ky'omwereezi n'enyaweera n'akenda ka karari, abinagye omu muriro ogurikwotsya egyo nyana. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Bwanyima omunyamurwa ayozye ebijwaro bye, ayogye omubiri gwe omu maizi, abone kugaruka omu rusiisira, kwonka asiibe ari osiisikaire okuhitsya omu mwabazyo. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />Owaagyotsya ayozye ebijwaro bye, ayogye omubiri omu maizi, asiibe ari osiisikaire okuhitsya omu mwabazyo. <verse eid="NUM 19:8" /><verse number="9" style="v" sid="NUM 19:9" /><note caller="-" style="x"><char style="xo" closed="false">19:9: </char><char style="xt" closed="false"><ref loc="HEB 9:13">Heb 9:13</ref>, <ref loc="HEB 9:14">14</ref>; <ref loc="ZEC 13:1">Zek 13:1</ref>. </char></note> Omuntu oshemeire ayoore eiju ry'egyo nyana, arishukye omu mwanya gushemeire aheeru y'orusiisira, ribiikwe ahabw'eihanga ry'Abaisraeli okurijwanzya n'amaizi, gabe amaizi g'okweza n'okwihaho ebibi. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Owaayoora eiju ry'egyo nyana ayozye ebijwaro bye, agume ari osiisikaire okuhitsya omu mwabazyo. Ekyo kigume kiri ekiragiro ekitarihwaho aha Baisraeli n'abanyamahanga abariba babashuhuukiiremu.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />Orikora aha mutumbi gw'omuntu weena aryamara ebiro mushanju ari osiisikaire. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Ogwo muntu aryayeyeza n'ago maizi aha kiro kya kashatu, n'ekya mushanju abone kuba oshemeire; kwonka ku ariba ateeyerize aha kiro kya kashatu, n'ekya mushanju, tariba oshemeire. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" /><note caller="-" style="x"><char style="xo" closed="false">19:13: </char><char style="xt" closed="false"><ref loc="NUM 8:7">Kub 8:7</ref>. </char></note> Orikora aha mutumbi gw'omuntu weena ofiire, akanga kweyeza, aryaba asiisire Obutaaho bwa MUKAMA; ogwo muntu acuubwe omu Baisraeli; ahakuba tamiisiirweho ago maizi g'okweza, aryaguma ari osiisikaire; okusiisikara kwe kuryaba kukimuriho.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />Eki n'ekiragiro ky'omuntu ofeereire omu ihema; oriritaahamu weena n'oriba aririmu weena, baryamara ebiro mushanju bari abasiisikaire. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Kandi ekintu kyona ekyashami, ekitaine kifundikizo ekikihamiireho, kiryaba ekisiisikaire. <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />Kandi omuntu weena oriba ari omu ishwa, akakora aha mutumbi gw'omuntu oitsirwe rurara, nari aha gundi mutumbi, nari aha igufa ry'omuntu, nari aha kituuro, aryamara ebiro mushanju ari osiisikaire. <verse eid="NUM 19:16" /><verse number="17" style="v" sid="NUM 19:17" />Ahabw'ogwo muntu osiisikaire baryatwara aha iju ry'egyo nyana y'ekitambo ky'ekibi, barite omu kintu, barishukyemu amaizi g'omugyera, <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" /><note caller="-" style="x"><char style="xo" closed="false">19:18: </char><char style="xt" closed="false"><ref loc="PSA 51:7">Zab 51:7</ref>. </char></note> omuntu oshemeire atware enyaweera, agijabikye omuri ago maizi, agamiisiire aha ihema n'aha bintu byona n'abantu abaririmu n'ahari ogwo okozire aha igufa nari aha muntu oitsirwe nari aha mutumbi ogundi nari aha kituuro. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Kandi ogwo muntu oshemeire amiisiire osiisikaire aha kiro kya kashatu n'ekya mushanju; aha kiro kya mushanju amushemeze; nawe ayozye ebijwaro bye, ayogye omubiri omu maizi, abone kuba oshemeire omu mwabazyo.<verse eid="NUM 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">19:20: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 13:39-41">Byak 13:39-41</ref>; <ref loc="ROM 2:4">Rom 2:4</ref>, <ref loc="ROM 2:5">5</ref>. </char>
    </note> Kwonka omuntu oriba asiisikaire, akanga kweyeza, aryacuubwa, aihwe omu ihanga, ahabw'okuba aryaba asiisire Omwanya ogurikwera gwa MUKAMA; ahabw'okutamiisiirwaho maizi ag'okweza, aryaba akiri osiisikaire. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Ekyo kiryababeera ekiragiro ekitarihwaho. Kandi orimiisiira ago maizi g'okweza, aryayozya ebijwaro bye; n'origakoraho aryaba osiisikaire okuhitsya omu mwabazyo. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Kandi ekintu kyona eki omuntu osiisikaire arikoraho kiryaba ekisiisikaire, n'omuntu orikikoraho aryaba osiisikaire okuhitsya omu mwabazyo.<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s1">Okufa kwa Miriamu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:1: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 26:59">Kub 26:59</ref>. </char>
    </note> Eihanga ryona ery'Abaisraeli ryahika omu ihamba rya Ziini omu kwezi kw'okubanza; abantu baaguma Kadeshi; Miriamu yaagwa okwo, baaba niyo baamuziika.<verse eid="NUM 20:1" /></para>
  <para style="s1">Ekibi eki Musa na Arooni baakoreire aha maizi ga Meriba</para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:2: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 17:1-6">Kur 17:1-6</ref>. </char>
    </note> Bwanyima eihanga ryona ryabura amaizi; abantu baayeteerana, baayetomboitera Musa na Arooni. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" /><note caller="-" style="x"><char style="xo" closed="false">20:3: </char><char style="xt" closed="false"><ref loc="NUM 14:2">Kub 14:2</ref>. </char></note> Baatonganisa Musa nibagira bati: Nangwa kuri twafiire obu beene waitu baagwa omu maisho ga MUKAMA! <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Mbwenu mukareetera ki eihanga rya MUKAMA omuri eri ihamba kufeeramu n'amatungo gaitu? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Mukatwihira ki Misri kutureeta omu mwanya ogu omubi? Ti mwanya ogurikuhingwamu engano nari emitiini nari emizaabibu n'obu gaakuba amakomamahanga; kandi tiharimu maizi g'okunywa. <verse eid="NUM 20:5" /><verse number="6" style="v" sid="NUM 20:6" />Musa na Arooni baaruga omu maisho g'abo bantu abeeteeraine, baaza aha muryango gw'Eihema ry'okubugaabuganiramu, baajuumara ahansi; ekitiinisa kya MUKAMA kyababonekyera. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />MUKAMA yaagira Musa ati: <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />Twara enkoni eri, oteerane eihanga ryona, iwe na Arooni mukuru waawe, mugambirire orukiri omu maisho gaabo, rureete amaizi gaarwo, obaihire amaizi omuri orwo rukiri; obone kunywaisa eihanga ryona n'amatungo gaaryo. <verse eid="NUM 20:8" /><verse number="9" style="v" sid="NUM 20:9" /><note caller="-" style="x"><char style="xo" closed="false">20:9: </char><char style="xt" closed="false"><ref loc="NUM 17:10">Kub 17:10</ref>. </char></note> Musa yaiha egyo nkoni omu maisho ga MUKAMA, nk'oku yaamuragiira.<verse eid="NUM 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 20:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:10: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:33">Zab 106:33</ref>. </char>
    </note> Musa na Arooni baateeranira eihanga omu maisho g'orwo rukiri, Musa yaagira abantu ati: Muhurire, imwe bagomi 'mwe; tubaihire amaizi omuri oru rukiri? <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" /><note caller="-" style="x"><char style="xo" closed="false">20:11: </char><char style="xt" closed="false"><ref loc="JAS 1:20">Yak 1:20</ref>; <ref loc="1CO 10:4">1 Kor 10:4</ref>. </char></note> Musa yaimutsya omukono gwe, yaatera orwo rukiri kabiri n'enkoni ye, haarugamu amaizi maingi; abantu boona baanywa hamwe n'amatungo gaabo. <verse eid="NUM 20:11" /><verse number="12" style="v" sid="NUM 20:12" /><note caller="-" style="x"><char style="xo" closed="false">20:12: </char><char style="xt" closed="false"><ref loc="NUM 27:15">Kub 27:15</ref>; <ref loc="DEU 3:26">Bir 3:26</ref>. </char></note> MUKAMA yaagira Musa na Arooni ati: Ahabw'okuba timuunyikiriize, mukampaisa ekitiinisa omu maisho g'Abaisraeli, timurihitsya eri ihanga omu nsi ei mbahaire. <verse eid="NUM 20:12" /><verse number="13" style="v" sid="NUM 20:13" />Ago nigo maizi ga Meriba, ahabw'okuba Abaisraeli bakahakanisa MUKAMA, yaayeyoreka omuribo ku ari Orikwera.<verse eid="NUM 20:13" /></para>
  <para style="s1">Abanyaedomu okwangira Abaisraeli kuraba omu nsi yaabo</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">20:14: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 11:16">Bar 11:16</ref>, <ref loc="JDG 11:17">17</ref>; <ref loc="OBA 1:10">Oba 1:10</ref>, <ref loc="OBA 1:12">12</ref>. </char>
    </note> Musa ku yaabaire ari Kadeshi, yaatuma entumwa aha mugabe wa Edomu, naagira ati: Oku nikwo Israeli mwene sho arikugira. Noomanya enaku zoona ezi twareebire; <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />baatatenkuriitwe bakashuuma, baaza Misri, twatuurayo omwanya muraingwa; Abanyamisri baatwita kubi na baatatenkuriitwe. <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />Ku twatakiire MUKAMA, yaahurira okutaka kwaitu, yaatuma maraika, yaatwiha omuri Misri; mbwenu reeba turi Kadeshi, orurembo oruri aha mwatano gw'ensi yaawe. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" /><note caller="-" style="x"><char style="xo" closed="false">20:17: </char><char style="xt" closed="false"><ref loc="NUM 21:22">Kub 21:22</ref>. </char></note> Nitukweshengyereza, reka turabe omu nsi yaawe; titurikwija kuraba omu misiri n'obu kwakuba okuraba omu misiri y'emizaabibu, kandi titurikwija kunywa maizi g'omu maziba; nitwija kuraba omu nguuto y'omugabe, turekye kukiikama aha rubaju rwa buryo nari orwa bumosho, okuhitsya obu turaarugire kimwe omu nsi yaawe. <verse eid="NUM 20:17" /><verse number="18" style="v" sid="NUM 20:18" />Kwonka omugabe wa Edomu yaamugarukamu ati: Torikwija kuraba mu nsi yangye, ntakaahurura nkakurwanisa na rurara. <verse eid="NUM 20:18" /><verse number="19" style="v" sid="NUM 20:19" />Abaisraeli baamugira bati: Nitwija kuraba omu nguuto empango; kandi itwe n'amatungo gaitu ku turaanywe aha maizi gaawe, nitwija kugaihurira. Ka turabemu n'ebigyere kwonka, titwine kindi ki turikwija kukora. <verse eid="NUM 20:19" /><verse number="20" style="v" sid="NUM 20:20" /><note caller="-" style="x"><char style="xo" closed="false">20:20: </char><char style="xt" closed="false"><ref loc="GEN 27:41">Kut 27:41</ref>; <ref loc="GEN 32:6">32:6</ref>; <ref loc="PSA 120:7">Zab 120:7</ref>; <ref loc="AMO 1:11">Amo 1:11</ref>. </char></note> Yaagarukamu ati: Timurikwija kurabamu. Ogwo mugabe wa Edomu yaija n'engabo nyingi kumurwanisa n'amaani maingi. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" /><note caller="-" style="x"><char style="xo" closed="false">20:21: </char><char style="xt" closed="false"><ref loc="ROM 12:18">Rom 12:18</ref>. </char></note> Okwo nikwo Abanyaedomu baayangiire Abaisraeli kuraba omu nsi yaabo; nikyo Abaisraeli baahindukiire bakabarugaho.<verse eid="NUM 20:21" /></para>
  <para style="s1">Okufa kwa Arooni</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Eihanga ryona ery'Abaisraeli ryaruga Kadeshi, ryahika aha rushozi Hoori. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />MUKAMA yaagambirira Musa na Arooni ahari orwo rushozi Hoori orw'aha mwatano gw'ensi ya Edomu, ati: <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />Arooni yaaza kukurata abaabo, ahakuba tarihika mu nsi ei naahaire Abaisraeli, ahabw'okuba mukagomera ekiragiro kyangye aha maizi ga Meriba. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Twara Arooni na Eleazaari omutabani obainamure aha rushozi Hoori, <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />ojuure Arooni ebijwaro bye, obijwekye Eleazaari omutabani; bwanyima Arooni naija kufeerayo, akurate abaabo. <verse eid="NUM 20:26" /><verse number="27" style="v" sid="NUM 20:27" />Musa yaakora nk'oku MUKAMA yaaragiira; bainamuka aha rushozi Hoori, eihanga ryona niribareeba. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" /><note caller="-" style="x"><char style="xo" closed="false">20:28: </char><char style="xt" closed="false"><ref loc="EXO 29:29">Kur 29:29</ref>, <ref loc="EXO 29:30">30</ref>; <ref loc="PRO 14:32">Enf 14:32</ref>. </char></note> Musa yaajuura Arooni ebijwaro bye, yaabijweka Eleazaari omutabani; Arooni yaafeera aho, aha mutwe gw'orwo rushozi; Musa na Eleazaari baashuuma, baarugayo. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Eihanga ryona, nibo b'enju ya Israeli boona, ku baareebire Arooni yaafa, baamara ebiro makumi ashatu nibamucurira.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s1">Abaisraeli okwitwa enjoka, n'okutambirwa enjoka y'omuringa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Omugabe wa Aradi Omunyakanaani, owaabaire atwire Negebu, ku yaahuriire ngu Abaisraeli nibaija bareetsirwe omu muhanda gwa Asarimu, yaabarwanisa, yaakwatamu bamwe. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />Abaisraeli baahiga ahari MUKAMA nibagira bati: Ku oraaheyo eri ihanga omu mikono yaitu, nitwija kusheenyera kimwe endembo zaabo n'okuzicwekyereza. <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />MUKAMA yaahurira Abaisraeli, yaahayo Abanyakanaani; Abaisraeli baabacwekyerereza kimwe hamwe n'endembo zaabo; ogwo mwanya baagweta Horuma.<verse eid="NUM 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Baimutsya orugyendo okuruga aha rushozi Hoori, baatoora omuhanda ogurikuza aha Nyanja erikutukura, ngu beehinguririze ensi ya Edomu; emitima y'abantu yaafoobeera munonga ahabw'orugyendo; <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" /><note caller="-" style="x"><char style="xo" closed="false">21:5: </char><char style="xt" closed="false"><ref loc="EXO 16:3">Kur 16:3</ref>; <ref loc="PRO 27:7">Enf 27:7</ref>. </char></note> baagamba kubi ahari Ruhanga n'ahari Musa, nibagira bati: Mukatwihira ki Misri okutureeta omuri eri ihamba kugwamu; ahakuba tiharimu by'okurya n'obu gaakuba amaizi, kandi tutamirwe eby'okurya ebi ebitaine ku biri. <verse eid="NUM 21:5" /><verse number="6" style="v" sid="NUM 21:6" /><note caller="-" style="x"><char style="xo" closed="false">21:6: </char><char style="xt" closed="false"><ref loc="1CO 10:9">1 Kor 10:9</ref>. </char></note> MUKAMA yaayohereza omu bantu enjoka z'obushegu oburikubabiirira, zaabaruma; abantu baingi omu Baisraeli baafa. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" /><note caller="-" style="x"><char style="xo" closed="false">21:7: </char><char style="xt" closed="false"><ref loc="HOS 5:15">Hos 5:15</ref>; <ref loc="ACT 8:24">Byak 8:24</ref>. </char></note> Baayetuurira Musa, baagira bati: Tucumwire, ahabw'okuba tugambire kubi ahari MUKAMA n'ahariiwe; shaba MUKAMA atwiheho ezi njoka. Musa yaabashabira. <verse eid="NUM 21:7" /><verse number="8" style="v" sid="NUM 21:8" />MUKAMA yaagira Musa ati: Heesha enjoka ey'obushegu oburikubabiirira, ogihanikye aha muti; bwanyima oraarumwe enjoka weena, ku araagireebe, naakira. <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" /><note caller="-" style="x"><char style="xo" closed="false">21:9: </char><char style="xt" closed="false"><ref loc="2KI 18:4">2 Bag 18:4</ref>; <ref loc="JHN 3:14">Yoh 3:14</ref>, <ref loc="JHN 3:15">15</ref>. </char></note> Musa yaaheesha enjoka y'omuringa, yaagihanika aha muti; bwanyima omuntu weena owaabaire arumwa enjoka, ku yaabaire areeba ahari egyo njoka y'omuringa, akira.<verse eid="NUM 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Abaisraeli baimutsya orugyendo, baateera orusiisira Obosi; <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />baaruga Obosi, baateera orusiisira Iye-abariimu omu ihamba eririkureebana na Moabu aha rubaju rw'oburugwa-izooba. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Okuruga aho baimutsya orugyendo, baateera orusiisira omu ruhanga rwa Zeredi; <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />baarugayo baateera orusiisira seeri y'omugyera Arunooni, oguri omu ihamba ogurikuruga omu nsi y'Abaamori; ahakuba omugyera Arunooni gukaba guri omwatano gwa Moabu, ogurikutaanisa Moabu n'Abaamori. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Nikyo kirikugambirwa omu kitabo ky'Engamba za MUKAMA ngu,</para>
  <para style="q1" vid="NUM 21:14">Wahebu omuri Suufa n'empanga za Arunooni<verse eid="NUM 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="NUM 21:15" />Aharikushuuma omu mpanga</para>
  <para style="q1" vid="NUM 21:15">Hakahika aha mwanya ogu Aari atuuramu,</para>
  <para style="q1" vid="NUM 21:15">Ogwegamiire omwatano gwa Moabu<verse eid="NUM 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 21:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:16: </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:17">Kush 7:17</ref>. </char>
    </note> Baarugayo, baaza Beeri; eryo niryo iziba eri MUKAMA yaagambiireho Musa, obu yaamugira ati: Teerana hamwe abantu, mbahe amaizi. <verse eid="NUM 21:16" /><verse number="17" style="v" sid="NUM 21:17" />Bwanyima Abaisraeli nikwo kweshongora ekyeshongoro eki:</para>
  <para style="q1" vid="NUM 21:17">Imuka, oijure, iwe iziba 'we; muryeshongorere;<verse eid="NUM 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18" />Eiziba eryatimbirwe abanyiginya,</para>
  <para style="q1" vid="NUM 21:18">Eri abakuru b'abantu baafukwize enkoni y'ekitiinisa</para>
  <para style="q1" vid="NUM 21:18">N'ebikoni byabo.</para>
  <para style="q1" vid="NUM 21:18">Baaruga omu ihamba, baaza Matana; <note caller="-" style="x"><char style="xo" closed="false">21:18: </char><char style="xt" closed="false"><ref loc="NEH 3:15">Neh 3:15</ref>, <ref loc="NEH 3:16">16</ref>. </char></note> <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />baarugayo, baaza Nahalieli; baarugayo, baaza Bamosi. <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />Baaruga Bamosi, baaza omu ruhanga omu nsi ya Moabu, baahika aha mutwe gwa Pisiga aharikurengyera omu ihamba.<verse eid="NUM 21:20" /></para>
  <para style="s1">Abaisraeli okusingura Sihooni na Ogi</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">21:21: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 11:19-24">Bar 11:19-24</ref>. </char>
    </note> Abaisraeli baatuma entumwa ahari Sihooni omugabe w'Abaamori, nibagira bati: <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" /><note caller="-" style="x"><char style="xo" closed="false">21:22: </char><char style="xt" closed="false"><ref loc="NUM 20:17">Kub 20:17</ref>. </char></note> Ka turabe omu nsi yaawe; titurikwija kuraba omu misiri, n'obu kwakuba okuraba omu misiri y'emizaabibu; kandi titurikwija kunywa amaizi g'omu maziba, kureka nitwija kuraba omu nguuto y'omugabe okuhitsya obu turaarugire kimwe omu nsi yaawe. <verse eid="NUM 21:22" /><verse number="23" style="v" sid="NUM 21:23" />Sihooni tiyaikiriza Abaisraeli kuraba omu nsi ye, kureka yaahuruza engabo ze zoona, yaaza omu ihamba kubarwanisa; yaahika Yahazi, yaarwanirayo nabo. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" /><note caller="-" style="x"><char style="xo" closed="false">21:24: </char><char style="xt" closed="false"><ref loc="DEU 29:7">Bir 29:7</ref>; <ref loc="PSA 135:10">Zab 135:10</ref>, <ref loc="PSA 135:11">11</ref>; <ref loc="AMO 2:9">Amo 2:9</ref>. </char></note> Abaisraeli baamusinguza rurara, baakubuura ensi ye okutandikira ahari Arunooni okuhika Yaboki, aha mwatano gw'Abaamoni; ahabw'okuba omwatano gw'Abaamoni gukaba guri ogw'amaani. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Abaisraeli baakwata ezo ndembo zoona, baatuura omuri ezo ndembo z'Abaamori, n'omuri Heshibooni n'omu birorero byayo byona. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Ahakuba Heshibooni rukaba ruri orurembo rwa Sihooni omugabe w'Abaamori, owaarwaniise omugabe wa Moabu owa ira, akanyaga ensi ye yoona okuhitsya Arunooni. <verse eid="NUM 21:26" /><verse number="27" style="v" sid="NUM 21:27" />Nikyo abeeshongozi b'ebyeshongoro by'ebihimbano bagirira bati:</para>
  <para style="q1" vid="NUM 21:27">Nimwije Heshibooni,</para>
  <para style="q1" vid="NUM 21:27">Orurembo rwa Sihooni rwombekwe, ruhame.<verse eid="NUM 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />Ahabw'okuba omuriro gurugire Heshibooni,</para>
  <para style="q1" vid="NUM 21:28">Endimi z'omuriro zaaruga omu rurembo rwa Sihooni;</para>
  <para style="q1" vid="NUM 21:28">Zaayotsya Aari ey'omuri Moabu.</para>
  <para style="q1" vid="NUM 21:28">N'abakama b'ebibungo bya Arunooni.<note caller="-" style="x"><char style="xo" closed="false">21:28: </char><char style="xt" closed="false"><ref loc="JER 48:45">Yer 48:45</ref>, <ref loc="JER 48:46">46</ref>; <ref loc="DEU 2:9">Bir 2:9</ref>. </char></note><verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />Oryareeba enaku, iwe Moabu!</para>
  <para style="q1" vid="NUM 21:29">Mwahwa, imwe abantu ba Kemoshi!</para>
  <para style="q1" vid="NUM 21:29">Areeteire batabani be kuhunga,</para>
  <para style="q1" vid="NUM 21:29">Na bahara be kuba enkwatwa</para>
  <para style="q1" vid="NUM 21:29">Z'omugabe Sihooni ow'Abaamori.<note caller="-" style="x"><char style="xo" closed="false">21:29: </char><char style="xt" closed="false"><ref loc="JDG 11:24">Bar 11:24</ref>; <ref loc="1KI 11:7">1 Bag 11:7</ref>, <ref loc="1KI 11:33">33</ref>. </char></note><verse eid="NUM 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />Tubarasire; Heshibooni yaacwekyerera okuhika Diboni,</para>
  <para style="q1" vid="NUM 21:30">Twahwerekyereza ensi okuhika Noofa</para>
  <para style="q1" vid="NUM 21:30">Okuhitsya obu omuriro guhikire Medeba.<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Batyo Abaisraeli baatuura omu nsi y'Abaamori. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Musa yaatuma ab'okutata Yazeri, baakwata ebirorero byayo, baabingamu Abaamori abaabaire batwiremu. <verse eid="NUM 21:32" /><verse number="33" style="v" sid="NUM 21:33" />Baakuba, baatoora omuhanda ogurikuza Bashani; Ogi omugabe wa Bashani yaabahururira n'engabo ze zoona, yaarwanira nabo Edurei. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" /><note caller="-" style="x"><char style="xo" closed="false">21:34: </char><char style="xt" closed="false"><ref loc="DEU 3:2-4">Bir 3:2-4</ref>. </char></note> MUKAMA yaagira Musa ati: Otamutiina; ahakuba mmuhaireyo omu mikono yaawe n'abantu be boona n'ensi ye; omugire nk'oku waagizire Sihooni omugabe w'Abaamori, owaabaire atwire Heshibooni. <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />Baamucwekyereza n'abatabani n'abantu be boona, okuhitsya obu hataratsigaireho n'omwe; n'ensi ye baagikubuura.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s1">Balaki okushaba Balamu okumukyeenera Abaisraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Abaisraeli baimutsya orugyendo, baateera orusiisira omu mpita za Moabu seeri ya Yorudani ahashungaine na Yeriko. <verse eid="NUM 22:1" /><verse number="2" style="v" sid="NUM 22:2" /><note caller="-" style="x"><char style="xo" closed="false">22:2: </char><char style="xt" closed="false"><ref loc="JDG 11:25">Bar 11:25</ref>. </char></note> Balaki mwene Zipori yaareeba byona ebi Abaisraeli baakozire Abaamori; <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" /><note caller="-" style="x"><char style="xo" closed="false">22:3: </char><char style="xt" closed="false"><ref loc="EXO 23:27">Kur 23:27</ref>. </char></note> Abamoabu baatiina munonga Abaisraeli; ahakuba bakaba bari baingi munonga; emitima yaabahwa omunda ahabw'abo. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" /><note caller="-" style="x"><char style="xo" closed="false">22:4: </char><char style="xt" closed="false"><ref loc="NUM 31:8">Kub 31:8</ref>. </char></note> Abamoabu baagambira abakuru ba Midiani bati: Egi nyanja y'abantu neija kumaraho ebitwehinguririize byona, nk'oku ente emara obunyaatsi omu iriisizo. Kandi omu biro ebyo Balaki mwene Zipori niwe yaabaire ari omugabe wa Moabu. <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" /><note caller="-" style="x"><char style="xo" closed="false">22:5: </char><char style="xt" closed="false"><ref loc="DEU 23:4">Bir 23:4</ref>; <ref loc="JOS 13:22">Yos 13:22</ref>. </char></note> Yaatuma entumwa ahari Balamu mwene Beori, owaabaire atwire Pesori aha mugyera Furaati omu nsi y'abantu b'eihanga rye, kumweta, naagira ati: Hariho abantu barugire Misri; reeba, bashwekire ensi, batwire aharikureebana naitwe. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" /><note caller="-" style="x"><char style="xo" closed="false">22:6: </char><char style="xt" closed="false"><ref loc="GEN 27:29">Kut 27:29</ref>. </char></note> Mbwenu ninkweshengyereza, ija onkyeenere aba bantu; ahabw'okuba nibankiza amaani; obundi nkaabaasa kubasingura, mbabingira kimwe omu nsi; ahakuba nimmanya ngu ou oshabira omugisha aguheebwa, kandi ou okyeena akyeenwa.<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:7: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:8">Kur 23:8</ref>; <ref loc="MIC 3:11">Mik 3:11</ref>. </char>
    </note> Abakuru ba Moabu n'Abamidiani baagyenda n'emikimbo omu ngaro; baahika ahari Balamu, baamugambira ebi Balaki abatumire. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />Yaabagira ati: Muraare aha eki kiro; niinyija kubagambira nk'oku MUKAMA arangambire. Abanyiginya ba Moabu baaraara owa Balamu. <verse eid="NUM 22:8" /><verse number="9" style="v" sid="NUM 22:9" />Ruhanga yaija ahari Balamu, yaamubuuza ati: Abo bashaija abari hamwe naiwe nibaahi? <verse eid="NUM 22:9" /><verse number="10" style="v" sid="NUM 22:10" />Balamu yaagarukamu Ruhanga ati: Balaki mwene Zipori omugabe wa Moabu antumireho ati: <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />Reeba, hariho abantu barugire Misri, baashweka ensi; mbwenu ija obankyeenere; obundi nkaabaasa kubarwanisa, mbabinga. <verse eid="NUM 22:11" /><verse number="12" style="v" sid="NUM 22:12" /><note caller="-" style="x"><char style="xo" closed="false">22:12: </char><char style="xt" closed="false"><ref loc="NUM 23:20">Kub 23:20</ref>; <ref loc="PSA 144:15">Zab 144:15</ref>. </char></note> Ruhanga yaagira Balamu ati: Otagyenda nabo, otarikyeena abo bantu, ahakuba bahairwe omugisha. <verse eid="NUM 22:12" /><verse number="13" style="v" sid="NUM 22:13" />Balamu yaimuka omu kasheeshe, yaagambira abanyiginya ba Balaki ati: Mwirooko mugarukye owaanyu, ahabw'okuba MUKAMA taanyikiriize kugyenda naimwe. <verse eid="NUM 22:13" /><verse number="14" style="v" sid="NUM 22:14" />Abanyiginya ba Moabu baimuka, baagaruka ahari Balaki, baamugira bati: Balamu ayangire kwija naitwe.<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Balaki yaagaruka yaatuma abandi banyiginya abarikukira bari obwingi n'ekitiinisa. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Baija ahari Balamu, baamugira bati: Balaki mwene Zipori atutumire naagira ngu, hatagira ekyakuzibira kwija; <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" /><note caller="-" style="x"><char style="xo" closed="false">22:17: </char><char style="xt" closed="false"><ref loc="DEU 16:19">Bir 16:19</ref>; <ref loc="MAT 4:8">Mat 4:8</ref>, <ref loc="MAT 4:9">9</ref>. </char></note> ahakuba naija kukukuza, akuhindure omuntu w'ekitiinisa kingi; kandi ngu, eki orimugambira kyona, aryakikora; n'ahabw'ekyo ngu oije omukyeenere abo bantu. <verse eid="NUM 22:17" /><verse number="18" style="v" sid="NUM 22:18" /><note caller="-" style="x"><char style="xo" closed="false">22:18: </char><char style="xt" closed="false"><ref loc="1KI 22:14">1 Bag 22:14</ref>. </char></note> Balamu yaagarukamu abagaragwa ba Balaki ati: N'obu Balaki yaakumpa enju ye eijwire efeeza n'ezaabu, tinkaabaasa kuhingura aha kigambo kya MUKAMA Ruhanga wangye, kukicwaho nari okukyongyeraho. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Mbwenu nimbeeshengyereza, naimwe muraare aha eki kiro, ndeebe eki MUKAMA araagarukye kungambira. <verse eid="NUM 22:19" /><verse number="20" style="v" sid="NUM 22:20" />Ruhanga yaija ahari Balamu ekyo kiro, yaamugira ati: Aba bashaija ku baraabe baizire kukweta, imuka ogyende nabo; kwonka eki ndaakuragiire, obe nikyo waakora.<verse eid="NUM 22:20" /></para>
  <para style="s1">Ruhanga okuhanisa Balamu endogoya</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:21: </char>
      <char style="xt" closed="false">
        <ref loc="1TI 6:9">1 Tim 6:9</ref>, <ref loc="1TI 6:10">10</ref>; <ref loc="2PE 2:15">2 Pet 2:15</ref>. </char>
    </note> Balamu yaimuka omu kasheeshe, yaatandika endogoya ye, yaagyenda n'abanyiginya ba Moabu. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" /><note caller="-" style="x"><char style="xo" closed="false">22:22: </char><char style="xt" closed="false"><ref loc="EXO 23:20">Kur 23:20</ref>. </char></note> Kwonka Ruhanga yaamugirira ekiniga ahabw'okugyenda; maraika wa MUKAMA yaayemerera omu muhanda kumutanga; obwo Balamu akaba atembire endogoya ye, kandi aine abaheereza be bombi. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Endogoya yaareeba maraika wa MUKAMA ayemereire omu muhanda, aine rurara omu ngaro; endogoya yaaruga omu muhanda, yaakiikama yaaza omu kishaka; Balamu yaagiteera kugigarura omu muhanda. <verse eid="NUM 22:23" /><verse number="24" style="v" sid="NUM 22:24" />Bwanyima maraika wa MUKAMA yaayemerera omu kahanda kafunzire, akarikuraba ahagati y'emisiri y'emizaabibu, orugo rumuri oku n'oku. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Egyo ndogoya ku yaareebire maraika wa MUKAMA, yaayemigisiriza aha rugo, yaarumigiraho ekigyere kya Balamu; Balamu yaagaruka yaagiteera. <verse eid="NUM 22:25" /><verse number="26" style="v" sid="NUM 22:26" /><note caller="-" style="x"><char style="xo" closed="false">22:26: </char><char style="xt" closed="false"><ref loc="HOS 2:6">Hos 2:6</ref>. </char></note> Maraika wa MUKAMA yaagaruka enyima, yaayemerera ahafunzire munonga, ahataine buhindukiro aha rubaju rwa buryo nari orwa bumosho. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Endogoya ku yaareebire maraika wa MUKAMA, yaabyama omu maguru ga Balamu; Balamu yaagira ekiniga kingi, yaagiteera enkoni. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" /><note caller="-" style="x"><char style="xo" closed="false">22:28: </char><char style="xt" closed="false"><ref loc="MAT 19:26">Mat 19:26</ref>; <ref loc="2PE 2:16">2 Pet 2:16</ref>. </char></note> MUKAMA yaayashamya akanwa k'egyo ndogoya, yaabuuza Balamu eti: Wantura ki okunteera egi mirundi yonshatu? <verse eid="NUM 22:28" /><verse number="29" style="v" sid="NUM 22:29" /><note caller="-" style="x"><char style="xo" closed="false">22:29: </char><char style="xt" closed="false"><ref loc="PRO 12:10">Enf 12:10</ref>. </char></note> Balamu yaagigarukamu ati: Naakutura okungaya. Kuri naaba nyine rurara mu ngaro, naaba ninkwita. <verse eid="NUM 22:29" /><verse number="30" style="v" sid="NUM 22:30" /><note caller="-" style="x"><char style="xo" closed="false">22:30: </char><char style="xt" closed="false"><ref loc="1CO 1:27">1 Kor 1:27</ref>. </char></note> Endogoya yaabuuza Balamu eti: Tiinye endogoya yaawe, ei otuura nootemba obutoosha n'okuhitsya eri izooba? Hariho obu ndakugizire nti? Onu ati: Ngaaha!<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:31: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 6:17">2 Bag 6:17</ref>; <ref loc="1CH 21:16">1 Bus 21:16</ref>. </char>
    </note> Bwanyima MUKAMA yaahwezesa amaisho ga Balamu, yaareeba maraika wa MUKAMA ayemereire omu muhanda, aine rurara omu ngaro; yainama, yaajuumara. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" /><note caller="-" style="x"><char style="xo" closed="false">22:32: </char><char style="xt" closed="false"><ref loc="ACT 13:10">Byak 13:10</ref>; <ref loc="2PE 2:14">2 Pet 2:14</ref>, <ref loc="2PE 2:15">15</ref>. </char></note> Maraika wa MUKAMA yaamubuuza ati: Waateerera ki endogoya yaawe egi mirundi yonshatu? Reeba, naija kukutanga omu maisho, ahabw'okuba orugyendo oru orimu n'orw'obugomi omu maisho gangye; <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />endogoya yaawe ku yandeeba, yampigiza egyo mirundi eshatu; kuri etampigiza, buzimazima hati kuri naakwitsire, yo ngireka ehuriire. <verse eid="NUM 22:33" /><verse number="34" style="v" sid="NUM 22:34" /><note caller="-" style="x"><char style="xo" closed="false">22:34: </char><char style="xt" closed="false"><ref loc="1SA 26:21">1 Sam 26:21</ref>. </char></note> Balamu yaagarukamu maraika wa MUKAMA ati: Naacumura, ahakuba naaba ntamanyire ku onyemereire omu maisho kuntanga; mbwenu ku kiraabe nikikugwisa kubi, naaza kugarukayo. <verse eid="NUM 22:34" /><verse number="35" style="v" sid="NUM 22:35" />Maraika wa MUKAMA yaagira Balamu ati: Irooko ogyende n'abo bashaija; kwonka ekigambo eki ndaakugambire, obe nikyo waagamba. Atyo Balamu yaagumizamu, yaagyenda n'abanyiginya ba Balaki. <verse eid="NUM 22:35" /><verse number="36" style="v" sid="NUM 22:36" />Balaki ku yaahuriire ngu Balamu yaija, yaaza kumubugana omu rurembo rwa Moabu, orwabaire ruri aha mwatano gwa Arunooni, ahu ogwo mwatano gurikugarukira. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />Balaki yaagira Balamu ati: Tindakutumireho kukweta? N'enki ekyakuzibiire kwija? Torikumanya ku ndikubaasa kukukuza nkakuhindura omuntu w'ekitiinisa? <verse eid="NUM 22:37" /><verse number="38" style="v" sid="NUM 22:38" /><note caller="-" style="x"><char style="xo" closed="false">22:38: </char><char style="xt" closed="false"><ref loc="2CH 18:13">2 Bus 18:13</ref>. </char></note> Balamu yaagarukamu Balaki ati: Reeba, mbwenu naija; noogira ngu nyine obushoboorozi bwona kugira eki naagamba ahabwangye? Ekigambo eki Ruhanga araate omu kanwa kangye, nikyo ndaagambe. <verse eid="NUM 22:38" /><verse number="39" style="v" sid="NUM 22:39" />Balamu yaagyenda na Balaki, baahika Kiryasi-huzoosi. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />Balaki yaatamba ebitambo by'ente n'entaama, yaatwekyeraho Balamu n'abanyiginya abaizire nawe.<verse eid="NUM 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">22:41: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 12:2">Bir 12:2</ref>. </char>
    </note> Ku bwaseesire, Balaki yaatwara Balamu yaamwinamura omu kibungo ekirikwetwa Bamosi-baali; yaareebera okwo orubaju rumwe orw'Abaisraeli orwabaire rumuri haihi.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s1">Okuragura kwa Balamu</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Balamu yaagira Balaki ati: Nyombekyera aha amatambiro mushanju, ondeetereho enimi mushanju n'empaya z'entaama mushanju. <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />Balaki yaakora nk'oku Balamu yaamugambira; Balaki na Balamu baatambira ahari buri itambiro enimi n'empaya y'entaama. <verse eid="NUM 23:2" /><verse number="3" style="v" sid="NUM 23:3" />Balamu yaagira Balaki ati: Yemerera aha rubaju rw'ekitambo kyawe ekyokize, nyowe ngyende; shana MUKAMA akaija kumbugana; eki MUKAMA araanyorekye kyona, niinyija kukikugambira. Yaaza aha mutwe gw'ekibungo, ahataine kati. <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />Ruhanga yaabugana Balamu, Balamu yaamugira ati: Naatebeekanisa amatambiro mushanju, naatambira ahari buri itambiro enimi n'empaya y'entaama. <verse eid="NUM 23:4" /><verse number="5" style="v" sid="NUM 23:5" /><note caller="-" style="x"><char style="xo" closed="false">23:5: </char><char style="xt" closed="false"><ref loc="JER 1:9">Yer 1:9</ref>. </char></note> MUKAMA yaata ekigambo omu kanwa ka Balamu, yaamugira ati: Garuka ahari Balaki, oku obe nikwo waagamba. <verse eid="NUM 23:5" /><verse number="6" style="v" sid="NUM 23:6" />Balamu yaagaruka ahari Balaki, yaashanga akyemereire aha rubaju rw'ekitambo kye ekyokize hamwe n'abanyiginya ba Moabu boona. <verse eid="NUM 23:6" /><verse number="7" style="v" sid="NUM 23:7" />Yaagamba ebigambo bye naahanuura ati:</para>
  <para style="q1" vid="NUM 23:7">Omuri Aramu niyo Balaki yaanyihire,</para>
  <para style="q1" vid="NUM 23:7">Omugabe wa Moabu akanyiha omu bibungo by'oburugwa-izooba;</para>
  <para style="q1" vid="NUM 23:7">Ati: Ija onkyeenere Yakobo,</para>
  <para style="q1" vid="NUM 23:7">Rugayo, ohayire Israeli.<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />Nkaakyeena nta abu Ruhanga atakyeenire?</para>
  <para style="q1" vid="NUM 23:8">Kandi nkaahayira nta abu Ruhanga atahayiire?<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />Ahakuba nimmureebera ahaiguru y'enkiri,</para>
  <para style="q1" vid="NUM 23:9">Mmwetegyerereza aha mitwe y'ebibungo;</para>
  <para style="q1" vid="NUM 23:9">Reeba, n'eihanga erituura ryonka,</para>
  <para style="q1" vid="NUM 23:9">Eriteebarira mu gandi.<note caller="-" style="x"><char style="xo" closed="false">23:9: </char><char style="xt" closed="false"><ref loc="DEU 33:28">Bir 33:28</ref>; <ref loc="EZR 9:2">Ezr 9:2</ref>. </char></note><verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />N'oha owaakubaasa kubara omucuucu gwa Yakobo,</para>
  <para style="q1" vid="NUM 23:10">Nari akabara ekicweka kimwe kya kana kya Israeli?</para>
  <para style="q1" vid="NUM 23:10">Ka nyefeere nk'oku ohikiriire afa,</para>
  <para style="q1" vid="NUM 23:10">N'omuheru gw'amagara gangye gube nk'ogwe.<note caller="-" style="x"><char style="xo" closed="false">23:10: </char><char style="xt" closed="false"><ref loc="PSA 116:15">Zab 116:15</ref>; <ref loc="ISA 57:1">Isa 57:1</ref>, <ref loc="ISA 57:2">2</ref>. </char></note><verse eid="NUM 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">23:11: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 13:2">Neh 13:2</ref>; <ref loc="1SA 3:17">1 Sam 3:17</ref>. </char>
    </note> Balaki yaagira Balamu ati: Wankorera ki? Nkwetsire kunkyeenera abazigu; mbwenu reeba, waabashabira omugisha gwonka. <verse eid="NUM 23:11" /><verse number="12" style="v" sid="NUM 23:12" />Balamu yaamugarukamu ati: Ebi MUKAMA yaata omu kanwa kangye, tinshemereire kubyerinda, nkaba nibyo naagamba?<verse eid="NUM 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Balaki yaamugira ati: Ninkweshengyereza, ija nkutware ahandi, ahu oraabaase kubareebera; noija kureeba ekicweka kyabo ekirikuhera haihi, torikwija kubareeba boona; aho obe niho waayema, abankyeenere. <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />Yaamutwara omu bwerere bwa Zofimu aha mutwe gwa Pisiga, yaayombekayo amatambiro mushanju, yaatambira ahari buri itambiro enimi n'empaya y'entaama. <verse eid="NUM 23:14" /><verse number="15" style="v" sid="NUM 23:15" />Balamu yaagira Balaki ati: Yemerera aha rubaju rw'ekitambo kyawe ekyokize, mbanze mbugane MUKAMA hariya. <verse eid="NUM 23:15" /><verse number="16" style="v" sid="NUM 23:16" />MUKAMA yaabugana Balamu, yaata ekigambo omu kanwa ke, yaamugira ati: Garuka ahari Balaki, oku obe nikwo waagamba. <verse eid="NUM 23:16" /><verse number="17" style="v" sid="NUM 23:17" />Yaija ahari Balaki, yaashanga akyemereire aha rubaju rw'ekitambo kye ekyokize, ari hamwe n'abanyiginya ba Moabu. Balaki yaamubuuza ati: MUKAMA yaagamba ki? <verse eid="NUM 23:17" /><verse number="18" style="v" sid="NUM 23:18" />Balamu yaagamba ebigambo bye, naahanuura ati:</para>
  <para style="q1" vid="NUM 23:18">Imuka, Balaki, ohurire;</para>
  <para style="q1" vid="NUM 23:18">Iwe mwene Zipori, ntega amatu!<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />Ruhanga ti muntu, ngu abeihe;</para>
  <para style="q1" vid="NUM 23:19">Kandi ti mwana w'omuntu, ngu ayefuuze.</para>
  <para style="q1" vid="NUM 23:19">Ebi yaagambire, taribikora?</para>
  <para style="q1" vid="NUM 23:19">Kandi ebyarugire omu kanwa ke, taribihikiiriza?<note caller="-" style="x"><char style="xo" closed="false">23:19: </char><char style="xt" closed="false"><ref loc="1SA 15:29">1 Sam 15:29</ref>; <ref loc="TIT 1:2">Tit 1:2</ref>. </char></note><verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />Reeba, nkaragiirwa kubashabira omugisha;</para>
  <para style="q1" vid="NUM 23:20">Ruhanga agubahaire, tindikubaasa kugubaaka.<note caller="-" style="x"><char style="xo" closed="false">23:20: </char><char style="xt" closed="false"><ref loc="GEN 12:2">Kut 12:2</ref>. </char></note><verse eid="NUM 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />Tareebire kutahikiirira omuri Yakobo,</para>
  <para style="q1" vid="NUM 23:21">Kandi omuribo tareebire bugomi omuri Israeli.</para>
  <para style="q1" vid="NUM 23:21">MUKAMA Ruhanga waabo ari hamwe nabo,</para>
  <para style="q1" vid="NUM 23:21">Kandi omuribo harimu akaari aku barikuteerera Omugabe waabo.<note caller="-" style="x"><char style="xo" closed="false">23:21: </char><char style="xt" closed="false"><ref loc="MIC 7:18-20">Mik 7:18-20</ref>; <ref loc="ROM 4:7">Rom 4:7</ref>; <ref loc="ROM 8:1">8:1</ref>; <ref loc="2CO 5:19">2 Kor 5:19</ref>; <ref loc="LUK 19:37">Luk 19:37</ref>, <ref loc="LUK 19:38">38</ref>. </char></note><verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />Ruhanga owaabaihire omuri Misri, akabareeta,</para>
  <para style="q1" vid="NUM 23:22">Aine amaani nk'ag'embogo.<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />Buzima tihariho burogo bw'okuroga Yakobo,</para>
  <para style="q1" vid="NUM 23:23">N'obu kwakuba okuragurira kubi Israeli;</para>
  <para style="q1" vid="NUM 23:23">Hati nikiija kugambwa ahari Yakobo na Israeli ngu,</para>
  <para style="q1" vid="NUM 23:23">Eki Ruhanga abakoreire ka n'eky'okutangaaza!<note caller="-" style="x"><char style="xo" closed="false">23:23: </char><char style="xt" closed="false"><ref loc="PSA 31:19">Zab 31:19</ref>. </char></note><verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />Reeba, eri ihanga niribandatuka nk'entare y'enkazi,</para>
  <para style="q1" vid="NUM 23:24">Kandi niriimuka nk'entare y'enshaija;</para>
  <para style="q1" vid="NUM 23:24">Teribyama, etakariire ki ekwatsire,</para>
  <para style="q1" vid="NUM 23:24">Etakanyweire shagama y'ebi eitsire.<verse eid="NUM 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Balaki yaagira Balamu ati: Otabakyeena na kakye, n'obu kwakuba okubashabira omugisha. <verse eid="NUM 23:25" /><verse number="26" style="v" sid="NUM 23:26" />Kwonka Balamu yaagarukamu Balaki ati: Tinkugambiire nti: Byona ebi MUKAMA araagambe, nibyo nshemereire kukora? <verse eid="NUM 23:26" /><verse number="27" style="v" sid="NUM 23:27" />Balaki yaagira Balamu ati: Ija nu, nkutware omu gundi mwanya; obundi Ruhanga akaasiima ku oyema okwo, okabankyeenera. <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />Balaki yaatwara Balamu aha mutwe gwa Peori, aharikureeba ahansi omu ihamba. <verse eid="NUM 23:28" /><verse number="29" style="v" sid="NUM 23:29" />Balamu yaagira Balaki ati: Nyombekyera aha amatambiro mushanju, ondeetereho enimi mushanju n'empaya z'entaama mushanju. <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />Balaki yaakora nk'oku Balamu yaamugambira, yaatambira ahari buri itambiro enimi n'empaya y'entaama.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="s1">Okundi kuragura kwa Balamu n'okubingwa Balaki</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Balamu ku yaareebire ngu MUKAMA asiimire kuha Israeli omugisha, tiyaagyenda, nk'oku abaire naagyenda obundi, kusherura endagu, kureka yaahanga amaisho omu ihamba. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />Bwanyima yaimutsya amaisho, yaareeba Abaisraeli basiisiire nk'enganda zaabo oku ziri. Omwoyo wa Ruhanga yaamwijaho. <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />Yaagamba ebigambo bye, naahanuura ati:</para>
  <para style="q1" vid="NUM 24:3">Okuhanuura kwa Balamu mwene Beori,</para>
  <para style="q1" vid="NUM 24:3">Okuhanuura kw'omushaija obaire ahumire,<verse eid="NUM 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4" />Okuhanuura kw'ogwo orikuhurira ebigambo bya Ruhanga,</para>
  <para style="q1" vid="NUM 24:4">Akareeba okworekwa kw'Ow'obushoboorozi bwona,</para>
  <para style="q1" vid="NUM 24:4">Ogwire ahansi, kwonka amaisho ge nigareeba;</para>
  <para style="q1" vid="NUM 24:4">Naagira ati:<note caller="-" style="x"><char style="xo" closed="false">24:4: </char><char style="xt" closed="false"><ref loc="1SA 19:24">1 Sam 19:24</ref>; <ref loc="2CO 12:2">2 Kor 12:2</ref>. </char></note><verse eid="NUM 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />Amahema gaawe ka ni marungi, iwe Yakobo;</para>
  <para style="q1" vid="NUM 24:5">N'ensiisira zaawe ka ni nungi, iwe Israeli!<verse eid="NUM 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />Zaaririkire, zaahika hare nk'empita,</para>
  <para style="q1" vid="NUM 24:6">Nk'emisiri y'aha rubaju rw'omugyera,</para>
  <para style="q1" vid="NUM 24:6">Nk'enkaka ezi MUKAMA yaabyaire,</para>
  <para style="q1" vid="NUM 24:6">Nk'emyereezi y'aha rubaju rw'amaizi.<note caller="-" style="x"><char style="xo" closed="false">24:6: </char><char style="xt" closed="false"><ref loc="PSA 1:3">Zab 1:3</ref>; <ref loc="JER 17:8">Yer 17:8</ref>. </char></note><verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />Amaizi garyahimintika, nigaruga omu ndobo ze,</para>
  <para style="q1" vid="NUM 24:7">N'oruzaaro rwe ruryatuura ahu amaizi maingi gari;</para>
  <para style="q1" vid="NUM 24:7">Omugabe we aryaba mukuru okukira Agagi,</para>
  <para style="q1" vid="NUM 24:7">Kandi obugabe bwe buryahimbisibwa.<note caller="-" style="x"><char style="xo" closed="false">24:7: </char><char style="xt" closed="false"><ref loc="1CH 14:2">1 Bus 14:2</ref>; <ref loc="ISA 9:7">Isa 9:7</ref>. </char></note><verse eid="NUM 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />Ruhanga amwihire omuri Misri;</para>
  <para style="q1" vid="NUM 24:8">Aine amaani nk'ag'embogo;</para>
  <para style="q1" vid="NUM 24:8">Aryamaraho amahanga agarikumurwanisa,</para>
  <para style="q1" vid="NUM 24:8">Ahendagure amagufa gaabo,</para>
  <para style="q1" vid="NUM 24:8">Abarashe, aboozyemu emyambi ye.<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />Abunzire, yaabyama nk'entare y'enshaija,</para>
  <para style="q1" vid="NUM 24:9">N'entare y'enkazi; n'oha owaakwemera kumwimutsya?</para>
  <para style="q1" vid="NUM 24:9">Orikukushabira omugisha weena, aguheebwe;</para>
  <para style="q1" vid="NUM 24:9">N'orikukukyeena weena, akyeenwe.<note caller="-" style="x"><char style="xo" closed="false">24:9: </char><char style="xt" closed="false"><ref loc="GEN 27:29">Kut 27:29</ref>; <ref loc="MAT 25:40">Mat 25:40</ref>, <ref loc="MAT 25:45">45</ref>. </char></note><verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Balaki yaagirira Balamu ekiniga kingi, yaateera omu ngaro, yaamugira ati: Nkakweta kunkyeenera abazigu; mbwenu waabashabira omugisha egi mirundi yonshatu. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />N'ahabw'ekyo irooko, ogarukye owaawe; nkaba ninteekateeka kukukuza, nkakuhindura omuntu w'ekitiinisa kingi; mbwenu MUKAMA akikwimire. <verse eid="NUM 24:11" /><verse number="12" style="v" sid="NUM 24:12" />Balamu yaagira Balaki ati: Tindagambiire entumwa zaawe, ezi wantumireho, nti: <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />N'obu Balaki yaakumpa enju ye eijwire efeeza n'ezaabu, tinkaabaasa kuhingura aha kigambo kya MUKAMA kukora ekirungi nari ekibi omu bwengye bwangye nyenka; kureka eki MUKAMA araagambe, nikyo ndaagambe? <verse eid="NUM 24:13" /><verse number="14" style="v" sid="NUM 24:14" />Mbwenu reeba, naaza kugaruka owaitu; ija nkuhanuurire eki eri ihanga ririkora abantu baawe omu biro bya bwanyima. <verse eid="NUM 24:14" /><verse number="15" style="v" sid="NUM 24:15" />Balamu yaagamba ebigambo bye, naahanuura ati:</para>
  <para style="q1" vid="NUM 24:15">Okuhanuura kwa Balamu mwene Beori,</para>
  <para style="q1" vid="NUM 24:15">Okuhanuura kw'omushaija obaire ahumire;<verse eid="NUM 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16" />Okuhanuura kw'ogwo orikuhurira ebigambo bya Ruhanga,</para>
  <para style="q1" vid="NUM 24:16">Akamanya obwengye bwa Rukira-boona,</para>
  <para style="q1" vid="NUM 24:16">Akareeba okworekwa kw'Ow'obushoboorozi bwona,</para>
  <para style="q1" vid="NUM 24:16">Ogwire ahansi, kwonka amaisho ge nigareeba,</para>
  <para style="q1" vid="NUM 24:16">Naagira ati:<verse eid="NUM 24:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />Nimmureeba, n'obu ndaabe ntarikumureeba hati;</para>
  <para style="q1" vid="NUM 24:17">Mmuhangire amaisho, n'obu araabe atari haihi;</para>
  <para style="q1" vid="NUM 24:17">Enyonyoozi eryaruga omuri Yakobo,</para>
  <para style="q1" vid="NUM 24:17">N'enkoni y'obugabe eimukye omuri Israeli;</para>
  <para style="q1" vid="NUM 24:17">Eryateera embaju zoona eza Moabu</para>
  <para style="q1" vid="NUM 24:17">Ecwekyereze beene Sheesi boona.<note caller="-" style="x"><char style="xo" closed="false">24:17: </char><char style="xt" closed="false"><ref loc="JOB 19:25-27">Yob 19:25-27</ref>; <ref loc="JER 23:5">Yer 23:5</ref>; <ref loc="HEB 1:8">Heb 1:8</ref>; <ref loc="REV 22:16">Kush 22:16</ref>; <ref loc="GEN 49:10">Kut 49:10</ref>. </char></note><verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />Edomu eryakubuurwa,</para>
  <para style="q1" vid="NUM 24:18">Seiri ekubuurwe, ensi ey'abazigu be,</para>
  <para style="q1" vid="NUM 24:18">Obwo Israeli naakora eby'obumanzi.<note caller="-" style="x"><char style="xo" closed="false">24:18: </char><char style="xt" closed="false"><ref loc="2SA 8:14">2 Sam 8:14</ref>; <ref loc="PSA 60:8-12">Zab 60:8-12</ref>; <ref loc="AMO 9:12">Amo 9:12</ref>. </char></note><verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />Omuri Yakobo haryarugamu omutegyeki,</para>
  <para style="q1" vid="NUM 24:19">Acwekyereze ab'omu ndembo abaahonokireho.<verse eid="NUM 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 24:20" />Bwanyima yaareeba Abaamaleki, yaagamba ebigambo bye, naahanuura ati:</para>
  <para style="q1" vid="NUM 24:20">Amaleki niwe yaabaire ari ow'okubanza omu mahanga,</para>
  <para style="q1" vid="NUM 24:20">Kwonka omuheru gwe guryaba okucwekyerezibwa.<verse eid="NUM 24:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 24:21" />Yaagaruka yaareeba Abakeeni, yaagamba ebigambo bye naahanuura ati:</para>
  <para style="q1" vid="NUM 24:21">Ahu otwire n'ah'amaani;</para>
  <para style="q1" vid="NUM 24:21">N'ekyashuri kyawe kiri omu rukiri;<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />Kwonka Kaini aryanyagwa,</para>
  <para style="q1" vid="NUM 24:22">Okuhitsya obu Abaashuri barikutwara omu bunyagwa.<verse eid="NUM 24:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 24:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">24:23: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 22:14">Ezk 22:14</ref>. </char>
    </note> Yaagaruka yaagamba ebigambo bye naahanuura ati:</para>
  <para style="q1" vid="NUM 24:23">Ai bambe, Ruhanga ku arikora ekyo, n'oha origumaho?<verse eid="NUM 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24" />Kwonka emeeri ziryaruga Kitimu,</para>
  <para style="q1" vid="NUM 24:24">Zibonabonese Ashuri na Eberi;</para>
  <para style="q1" vid="NUM 24:24">Nawe acwekyerere.<verse eid="NUM 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 24:25" />Bwanyima Balamu yaimuka, yaagyenda, yaagaruka owe; na Balaki yaayegyendera.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s1">Abaisraeli okuramya Baali n'okushambana</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">25:1: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 31:16">Kub 31:16</ref>; <ref loc="REV 2:14">Kush 2:14</ref>. </char>
    </note> Abaisraeli baaguma omuri Shitimu, baatandika kushambana n'abaishiki b'Abamoabu; <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" /><note caller="-" style="x"><char style="xo" closed="false">25:2: </char><char style="xt" closed="false"><ref loc="JOS 22:17">Yos 22:17</ref>; <ref loc="HOS 9:10">Hos 9:10</ref>; <ref loc="EXO 34:15">Kur 34:15</ref>. </char></note> ahakuba Abamoabu bakaba babeeta aha magyenyi g'okutambira baaruhanga baabo ebitambo; Abaisraeli bakiija, barya nabo, baramya baaruhanga baabo. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" /><note caller="-" style="x"><char style="xo" closed="false">25:3: </char><char style="xt" closed="false"><ref loc="PSA 106:29">Zab 106:29</ref>. </char></note> Batyo Abaisraeli baayeteerana na Baali-peori, MUKAMA yaabagirira ekiniga kingi ekirikwaka nk'omuriro. <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />MUKAMA yaagira Musa ati: Reeta abakuru b'eihanga boona, obahanikye omu mushana omu maisho gangye, ekiniga kyangye kingi kibone kuruga ahari Israeli. <verse eid="NUM 25:4" /><verse number="5" style="v" sid="NUM 25:5" /><note caller="-" style="x"><char style="xo" closed="false">25:5: </char><char style="xt" closed="false"><ref loc="1KI 18:40">1 Bag 18:40</ref>. </char></note> Musa yaagambira abaramuzi b'Abaisraeli ati: Buri muntu omuriimwe aite abashaija be abeeteeraine na Baali-peori.<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Omwe aha Baisraeli yaija, areeteire beene waabo Omumidianikazi omu maisho ga Musa n'omu maisho g'eihanga ryona ry'Abaisraeli, yaashanga nibaririra aha muryango gw'Eihema ry'okubugaabuganiramu. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" /><note caller="-" style="x"><char style="xo" closed="false">25:7: </char><char style="xt" closed="false"><ref loc="EXO 6:25">Kur 6:25</ref>. </char></note> Finehaasi mwene Eleazaari, mwijukuru wa Arooni omunyamurwa, ku yaakireebire, yaimuka ahagati y'abantu, yaakwata eicumu omu ngaro, <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />yaakurata ogwo Mwisraeli omu ihema, yaabacumita bombi, eicumu ryayoga omu Mwisraeli, ryateera omukazi aha nda. N'ahabw'ekyo orufu rwazibirwa omu Baisraeli. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" /><note caller="-" style="x"><char style="xo" closed="false">25:9: </char><char style="xt" closed="false"><ref loc="1CO 10:8">1 Kor 10:8</ref>. </char></note> Boona abaitsirwe orwo rufu bakaba bari obukumi bubiri n'enkumi ina.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />MUKAMA yaagira Musa ati: <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" /><note caller="-" style="x"><char style="xo" closed="false">25:11: </char><char style="xt" closed="false"><ref loc="PSA 106:30">Zab 106:30</ref>. </char></note> Finehaasi mwene Eleazaari, mwijukuru wa Arooni omunyamurwa, aihire ekiniga kyangye aha Baisraeli, ahabw'okuba andwaniire eihato omuribo, tinaabacwekyereza ahabw'eihato ryangye. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />N'ahabw'ekyo omugambire ebi ndikugamba ningira nti: Naakuha endagaano yangye ey'obusingye; <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" /><note caller="-" style="x"><char style="xo" closed="false">25:13: </char><char style="xt" closed="false"><ref loc="EXO 40:15">Kur 40:15</ref>; <ref loc="ACT 22:3">Byak 22:3</ref>. </char></note> eryaba endagaano y'obunyamurwa obutarihwaho ei naaragaana naiwe n'oruzaaro rwawe orurikurataho, ahabw'okurwanira Ruhanga waawe eihato, okarihiirira Abaisraeli. <verse eid="NUM 25:13" /><verse number="14" style="v" sid="NUM 25:14" />Kandi ogwo Mwisraeli owaitsirwe n'ogwo Mumidianikazi akaba naayetwa Zimuri mwene Saalu, omukuru w'enju ya baishenkuru omu ruganda rwa Simeoni; <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />kandi ogwo Mumidianikazi owaitsirwe akaba naayetwa Kozibi muhara wa Zuuri; nawe akaba ari omukuru w'omutwe gw'ab'enju ya baishenkuru omu Bamidiani. <verse eid="NUM 25:15" /><verse number="16" style="v" sid="NUM 25:16" />MUKAMA yaagira Musa ati: <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />Tuntuza Abamidiani, obaite, <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />ahabw'okuba babatuntwize n'oburyarya bwabo, obu baababeihabeihiise omu bya Peori, n'omu bya Kozibi muhara w'omukuru w'Abamidiani, munyaanyabo oitsirwe aha izooba ry'orufu orureetsirwe ebya Peori.<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s1">Okubara Abaisraeli obwa kabiri</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Bwanyima y'orwo rufu MUKAMA yaagambira Musa na Eleazaari mwene Arooni omunyamurwa, ati: <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" /><note caller="-" style="x"><char style="xo" closed="false">26:2: </char><char style="xt" closed="false"><ref loc="NUM 1:2">Kub 1:2</ref>. </char></note> Mubare eihanga ry'Abaisraeli ryona, abahikize emyaka makumi abiri n'okukiraho, nk'emiryango ya baishenkurubo oku eri, ab'omu Baisraeli boona abarikubaasa kuhurura. <verse eid="NUM 26:2" /><verse number="3" style="v" sid="NUM 26:3" />Musa na Eleazaari omunyamurwa baagamba nabo bari omu mpita za Moabu, haihi na Yorudani, ahashungaine na Yeriko, nibagira bati: <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />Mubare abantu abahikize emyaka makumi abiri n'okukiraho, nk'oku MUKAMA aragiire Musa.</para>
  <para style="p" vid="NUM 26:4">Abaisraeli abaarugire omu nsi ya Misri nibo aba: <verse eid="NUM 26:4" /><verse number="5" style="v" sid="NUM 26:5" />Reubeeni omujigaijo gwa Israeli; beene Reubeeni, abaazairwe Hanoki, omuryango gw'aba Hanoki; abaazairwe Palu, omuryango gw'aba Palu, <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />abaazairwe Hezirooni, omuryango gw'aba Hezirooni; abaazairwe Karumi, omuryango gw'aba Karumi. <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />Egyo niyo miryango y'Abareubeeni; abaabazirwe omuribo bakaba bari obukumi buna n'enkumi ishatu na magana mushanju na makumi ashatu. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />Omuri beene Palu, Eliabu. <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" /><note caller="-" style="x"><char style="xo" closed="false">26:9: </char><char style="xt" closed="false"><ref loc="NUM 16:1">Kub 16:1</ref>, <ref loc="NUM 16:2">2</ref>. </char></note> Beene Eliabu Nemueli, Dasani na Abiraamu, Dasani na Abiraamu abo nibo baatoorainwe omu ihanga, bakahakanisa Musa na Arooni bakwataniise na Koora, obu baahakanisa MUKAMA, <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" /><note caller="-" style="x"><char style="xo" closed="false">26:10: </char><char style="xt" closed="false"><ref loc="NUM 16:38">Kub 16:38</ref>. </char></note> ensi ekaashamya akanwa, ekabamira hamwe na Koora, obu ekigombe kye ekyo kyafa, omuriro gukootsya abashaija magana abiri na makumi ataano, bakahinduka eky'okureeberaho. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" /><note caller="-" style="x"><char style="xo" closed="false">26:11: </char><char style="xt" closed="false"><ref loc="EZK 18:20">Ezk 18:20</ref>. </char></note> Kwonka beene Koora tibarafiire.<verse eid="NUM 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />Beene Simeoni nk'emiryango yaabo oku yaabaire eri; abaazairwe Nemueli, omuryango gw'aba N'emueli; abaazairwe Yamini, omuryango gw'aba Yamini; abaazairwe Yakini, omuryango gw'aba Yakini; <verse eid="NUM 26:12" /><verse number="13" style="v" sid="NUM 26:13" />abaazairwe Zeera, omuryango gw'aba Zeera; abaazairwe Shauli, omuryango gw'aba Shauli. <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />Egyo niyo miryango y'Abasimeoni, abashaija obukumi bubiri n'enkumi ibiri na magana abiri.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Beene Gaadi nk'emiryango yaabo oku yaabaire eri; abaazairwe Zefoni, omuryango gw'aba Zefoni; abaazairwe Haagi, omuryango gw'aba Haagi; abaazairwe Shuuni, omuryango gw'aba Shuuni; <verse eid="NUM 26:15" /><verse number="16" style="v" sid="NUM 26:16" />abaazairwe Ozini, omuryango gw'aba Ozini; abaazairwe Eeri, omuryango gw'aba Eeri; <verse eid="NUM 26:16" /><verse number="17" style="v" sid="NUM 26:17" />abaazairwe Arodi, omuryango gw'aba Arodi; abaazairwe Areeli, omuryango gw'aba Areeli. <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />Egyo niyo miryango y'Abagaadi, nk'abo abaabazirwe aharibo oku baabaire bari, obukumi buna na magana ataano.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Beene Yuda Eeri na Onani; Eeri na Onani abo bakagwa omu nsi ya Kanaani. <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />Beene Yuda nk'emiryango yaabo oku yaabaire eri, abaazairwe Sheela, omuryango gw'aba Sheela; abaazairwe Pereezi, omuryango gw'aba Pereezi, abaazairwe Zeera, omuryango gw'aba Zeera. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />Beene Pereezi nibo aba; abaazairwe Hezirooni, omuryango gw'aba Hezirooni; abaazairwe Hamuli, omuryango gw'aba Hamuli. <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />Egyo niyo miryango ya Yuda, nk'abo abaabazirwe aharibo, obukumi mushanju n'enkumi mukaaga na magana ataano.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Beene Isakaari nk'emiryango yaabo oku yaabaire eri; abaazairwe Toola, omuryango gw'aba Toola; abaazairwe Puuva, omuryango gw'aba Puuna; <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />abaazairwe Yashubu, omuryango gw'aba Yashubu; abaazairwe Shimirooni, omuryango gw'aba Shimirooni. <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />Egyo niyo miryango ya Isakaari, nk'abo abaabazirwe oku baabaire bari, obukumi mukaaga n'enkumi ina na magana ashatu.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Beene Zebuluuni nk'emiryango yaabo oku yaabaire eri; abaazairwe Seredi, omuryango gw'aba Seredi; abaazairwe Eloni, omuryango gw'aba Eloni; abaazairwe Yahaleeli, omuryango gw'aba Yahaleeli. <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />Egyo niyo miryango y'Abazebuluuni, nk'abo abaabazirwe aharibo oku baabaire bari, obukumi mukaaga na magana ataano.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Beene Yosefu nk'emiryango yaabo oku yaabaire eri; Manaase na Efuraimu. <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />Beene Manaase, abaazairwe Makiri, omuryango gw'aba Makiri; kandi Makiri akazaara Gileadi; abaazairwe Gileadi, omuryango gw'aba Gileadi. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />Kandi aba nibo beene Gileadi, abaazairwe Yezeri, omuryango gw'aba Yezeri; abaazairwe Heleki, omuryango gw'aba Heleki; <verse eid="NUM 26:30" /><verse number="31" style="v" sid="NUM 26:31" />abaazairwe Asirieli, omuryango gw'aba Asirieli; abaazairwe Shekemu, omuryango gw'aba Shekemu; <verse eid="NUM 26:31" /><verse number="32" style="v" sid="NUM 26:32" />abaazairwe Shemida, omuryango gw'aba Shemida; abaazairwe Heferi, omuryango gw'aba Heferi. <verse eid="NUM 26:32" /><verse number="33" style="v" sid="NUM 26:33" /><note caller="-" style="x"><char style="xo" closed="false">26:33: </char><char style="xt" closed="false"><ref loc="NUM 27:1-11">Kub 27:1-11</ref>; <ref loc="JOS 17:3">Yos 17:3</ref>. </char></note> Zelofehaadi mwene Heferi tarazaire boojo, kureka abaishiki; amaziina ga bahara ba Zelofehaadi ni Maala na Noa, Hogula, Milika na Tiruza. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />Egyo niyo miryango ya Manaase; abaabazirwe aharibo bakaba bari obukumi butaano n'enkumi ibiri na magana mushanju.<verse eid="NUM 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />Aba nibo beene Efuraimu nk'emiryango yaabo oku yaabaire eri; abaazairwe Shuseela, omuryango gw'aba Shuseela; abaazairwe Bekeri, omuryango gw'aba Bekeri; abaazairwe Tahani, omuryango gw'aba Tahani. <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />Kandi nibo beene Shuseela; abaazairwe Erani, omuryango gw'aba Erani. <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />Egyo niyo miryango y'Abaefuraimu, nk'abo abaabazirwe aharibo oku baabaire bari, obukumi bushatu n'enkumi ibiri na magana ataano. Abo nibo beene Yosefu nk'emiryango yaabo oku yaabaire eri.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Beene Benyamiini nk'emiryango yaabo oku yaabaire eri; abaazairwe Beela, omuryango gw'aba Beela; abaazairwe Ashubeeli, omuryango gw'aba Ashubeeli; abaazairwe Ahiraamu, omuryango gw'aba Ahiraamu; <verse eid="NUM 26:38" /><verse number="39" style="v" sid="NUM 26:39" />abaazairwe Shufaamu, omuryango gw'aba Shufaamu; abaazairwe Hufaamu, omuryango gw'aba Hufaamu. <verse eid="NUM 26:39" /><verse number="40" style="v" sid="NUM 26:40" />Kandi beene Beela bakaba bari Arudi na Naamani; abaazairwe Arudi, omuryango gw'aba Arudi; abaazairwe Naamani, omuryango gw'aba Naamani. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />Abo nibo beene Benyamiini nk'emiryango yaabo oku yaabaire eri; abaabazirwe aharibo bakaba bari obukumi buna n'enkumi itaano na magana mukaaga.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Aba nibo beene Daani nk'emiryango yaabo oku yaabaire eri; abaazairwe Shuhaamu, omuryango gw'aba Shuhaamu; egyo niyo miryango y'Abadaani. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Emiryango yoona ey'aba Shuhaamu, nk'abo abaabazirwe aharibo oku baabaire bari, n'obukumi mukaaga n'enkumi ina na magana ana.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Beene Asheri nk'emiryango yaabo oku yaabaire eri; abaazairwe Imuna, omuryango gw'aba Imuna; abaazairwe Ishuvi, omuryango gw'aba Ishuvi; abaazairwe Beria, omuryango gw'aba Beeri; <verse eid="NUM 26:44" /><verse number="45" style="v" sid="NUM 26:45" />omuri beene Beria, abaazairwe Heberi, omuryango gw'aba Heberi; abaazairwe Malikieli, omuryango gw'aba Malikieli; <verse eid="NUM 26:45" /><verse number="46" style="v" sid="NUM 26:46" />kandi muhara wa Asheri akaba naayetwa Seera. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />Egyo niyo miryango y'Abaasheri, nk'abo abaabazirwe aharibo oku baabaire bari, obukumi butaano n'enkumi ishatu na magana ana.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Beene Nafutaali nk'emiryango yaabo oku yaabaire eri; abaazairwe Yahazeeli, omuryango gw'aba Yahazeeli; abaazairwe Guuni, omuryango gw'aba Guuni; <verse eid="NUM 26:48" /><verse number="49" style="v" sid="NUM 26:49" />abaazairwe Yezeri, omuryango gw'aba Yezeri; abaazairwe Shileemu, omuryango gw'aba Shileemu. <verse eid="NUM 26:49" /><verse number="50" style="v" sid="NUM 26:50" />Egyo niyo miryango ya Nafutaali nk'emiryango yaabo oku yaabaire eri; abaabazirwe aharibo bakaba bari obukumi buna n'enkumi itaano na magana ana. <verse eid="NUM 26:50" /><verse number="51" style="v" sid="NUM 26:51" /><note caller="-" style="x"><char style="xo" closed="false">26:51: </char><char style="xt" closed="false"><ref loc="NUM 1:46">Kub 1:46</ref>. </char></note> Abo nibo baabazirwe aha Baisraeli, boona bakaba bari obusiriira mukaaga na rukumi na magana mushanju na makumi ashatu.<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />MUKAMA yaagira Musa ati: <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />Abo nibo baribaganisizibwa ensi kuba obuhunguzi, nk'omubaro gw'amaziina gaabo oku guri. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" /><note caller="-" style="x"><char style="xo" closed="false">26:54: </char><char style="xt" closed="false"><ref loc="NUM 33:54">Kub 33:54</ref>. </char></note> Abaingi oryabaha obuhunguzi bwingi, kandi abakye obahe obuhunguzi bukye; buri ruganda ruheebwe obuhunguzi nk'omubaro gw'abantu baarwo abaabazirwe oku guri. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" /><note caller="-" style="x"><char style="xo" closed="false">26:55: </char><char style="xt" closed="false"><ref loc="JOS 14:2">Yos 14:2</ref>. </char></note> Kwonka ensi eryabaganisibwa n'enteenyu; baryagihungura nk'amaziina g'enganda za baishenkurubo oku gari. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Nk'oku enteenyu eriba, nikwo n'obuhunguzi buribaganisizibwa abaingi n'abakye. <verse eid="NUM 26:56" /><verse number="57" style="v" sid="NUM 26:57" />Aba nibo baabazirwe omu Baleevi, nk'emiryango yaabo oku yaabaire eri; abaazairwe Gereshoni, omuryango gw'aba Gereshoni; abaazairwe Kohasi, omuryango gw'aba Kohasi; abaazairwe Merari, omuryango gw'aba Merari. <verse eid="NUM 26:57" /><verse number="58" style="v" sid="NUM 26:58" />Egyo niyo miryango ya Leevi, omuryango gw'aba Libuni, omuryango gw'aba Heburooni, n'ogw'aba Mahili n'ogw'aba Muushi, n'ogw'aba Koora. Kandi Kohasi niwe yaazaire Amuraamu. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Kandi muka Amuraamu akaba naayetwa Yokebedi, muhara wa Leevi, ou Leevi yaazaariire Misri; yaazaara na Amuraamu, Arooni na Musa, na Miriamu munyaanyabo. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Na Arooni yaazaara Nadabu, Abihu, Eleazaari na Itamaari. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" /><note caller="-" style="x"><char style="xo" closed="false">26:61: </char><char style="xt" closed="false"><ref loc="LEV 10:1">Lev 10:1</ref>, <ref loc="LEV 10:2">2</ref>. </char></note> Kwonka Nadabu na Abihu bakafa, obu baayoteza omuriro ogundi ogutararagiirwe kwoteza omu maisho ga MUKAMA. <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" />Abaleevi abaabazirwe, oyetwa omushaija weena okwiha aha mwana ohikize okwezi bakaba bari obukumi bubiri n'enkumi ishatu; kandi tibarabazirwe na Baisraeli abandi, ahabw'okuba tibarahairwe buhunguzi hamwe nabo.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Abo nibo baabazirwe Musa na Eleazaari omunyamurwa, abaabariire Abaisraeli omu mpita za Moabu haihi na Yorudani ahashungaine na Yeriko. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" /><note caller="-" style="x"><char style="xo" closed="false">26:64: </char><char style="xt" closed="false"><ref loc="NUM 1:1">Kub 1:1</ref>; <ref loc="DEU 2:14">Bir 2:14</ref>, <ref loc="DEU 2:15">15</ref>. </char></note> Kwonka omuri abo hakaba hatarimu n'omwe omu baabazirwe Musa na Arooni omunyamurwa, abaabariire Abaisraeli omu ihamba rya Sinai. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" /><note caller="-" style="x"><char style="xo" closed="false">26:65: </char><char style="xt" closed="false"><ref loc="NUM 14:28">Kub 14:28</ref>; <ref loc="ROM 11:22">Rom 11:22</ref>; <ref loc="HEB 3:17">Heb 3:17</ref>, <ref loc="HEB 3:18">18</ref>; <ref loc="JOS 14:10">Yos 14:10</ref>. </char></note> Ahakuba MUKAMA akabagambaho, naagira ati: Buzimazima baryafeera omu ihamba. Tihariho n'omwe aharibo owaatsigaireho kureka Kalebu mwene Yefune na Yoshua mwene Nuuni.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s1">Ebiragiro by'obuhunguzi bw'abaishiki</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:1: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 17:3">Yos 17:3</ref>. </char>
    </note> Bwanyima haija bahara ba Zelofehaadi, mwene Heferi ya Gileadi, ya Makiri, ya Manaase ab'emiryango ya Manaase ab'emiryango ya Manaase mwene Yosefu; bahara be bakaba nibeetwa Maala, Noa, Hogula, Milika na Tiruza; <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" /><note caller="-" style="x"><char style="xo" closed="false">27:2: </char><char style="xt" closed="false"><ref loc="ROM 6:23">Rom 6:23</ref>. </char></note> baayemerera omu maisho ga Musa na Eleazaari omunyamurwa n'abeebembezi n'eihanga ryona aha muryango gw'Eihema ry'okubugaabuganiramu; baagira bati: <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />Tataitwe akagwa omu ihamba; kandi akaba atari mu mutwe gw'abaayeteeraine kugomera MUKAMA omu kigombe kya Koora; akafeera omu bibi bye wenka, kandi akaba atazaire boojo. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />N'enki ekirikwihisa eiziina rya tataitwe omu b'omuryango gwe, ngu ahabw'okuba tarazaire mwojo? Otuhe obutaka omu b'oruganda rwa tataitwe. <verse eid="NUM 27:4" /><verse number="5" style="v" sid="NUM 27:5" /><note caller="-" style="x"><char style="xo" closed="false">27:5: </char><char style="xt" closed="false"><ref loc="EXO 18:15">Kur 18:15</ref>; <ref loc="PRO 3:5">Enf 3:5</ref>, <ref loc="PRO 3:6">6</ref>. </char></note> Musa yaatwarira MUKAMA ebigambo byabo.<verse eid="NUM 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 27:6" />MUKAMA yaagira Musa ati: <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" /><note caller="-" style="x"><char style="xo" closed="false">27:7: </char><char style="xt" closed="false"><ref loc="NUM 36:2">Kub 36:2</ref>. </char></note> Ebi bahara ba Zelofehaadi barikufa n'eby'amazima; buzimazima otaribura kubaha obutaka omu b'omuryango gwa ishebo; obarekye bahungure obuhunguzi bwe. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Kandi ogambire Abaisraeli oti: Omuntu ku arifa, atatsigire mwana w'omwojo, muryareka obuhunguzi bwe bube obwa muhara we. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Ku ariba atatsigire muhara, obuhunguzi mubuhe beene ishe. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Ku ariba ataine beene ishe, mubuhe baishento. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Kwonka ishe ku ariba ataine bakuru be nari abarumuna, obuhunguzi mubuhe omunyaruganda omuri haihi, abuhungure. Ekyo kibe ekiragiro ky'okucweraho emanja z'obuhunguzi omu Baisraeli, nk'oku MUKAMA yaaragiire Musa.<verse eid="NUM 27:11" /></para>
  <para style="s1">MUKAMA okugambira Musa eby'okufa kwe, n'okutoorana Yoshua kumuhungurira</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">27:12: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 34:1">Bir 34:1</ref>. </char>
    </note> MUKAMA yaagira Musa ati: Oryainamuka ahari oru rushozi rwa Abariimu, oreebe ensi ei mpaire Abaisraeli. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" /><note caller="-" style="x"><char style="xo" closed="false">27:13: </char><char style="xt" closed="false"><ref loc="NUM 31:2">Kub 31:2</ref>; <ref loc="DEU 10:6">Bir 10:6</ref>. </char></note> Ku oriheza kugireeba, naiwe oryafa, okurate abaanyu, nka Arooni mukuru waawe oku yaabakuratsire, <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" /><note caller="-" style="x"><char style="xo" closed="false">27:14: </char><char style="xt" closed="false"><ref loc="PSA 106:32">Zab 106:32</ref>; <ref loc="NUM 20:24">Kub 20:24</ref>. </char></note> ahabw'okuba mukagomera ekiragiro kyangye omu ihamba rya Ziini, obu eihanga ryampakanisa, mukanga kumpaisa ekitiinisa omu maisho gaaryo aha maizi. Ago nigo maizi ga Meriba omuri Kadeshi omu ihamba rya Ziini. <verse eid="NUM 27:14" /><verse number="15" style="v" sid="NUM 27:15" />Musa yaagira MUKAMA ati: <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />MUKAMA Ruhanga w'emyoyo y'abantu boona atoorane omushaija w'okutegyeka eri ihanga, <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" /><note caller="-" style="x"><char style="xo" closed="false">27:17: </char><char style="xt" closed="false"><ref loc="DEU 31:2">Bir 31:2</ref>; <ref loc="1KI 22:17">1 Bag 22:17</ref>; <ref loc="MAT 9:36">Mat 9:36</ref>. </char></note> ow'okubeebembera nibashohora, kandi nibataaha, oraabashohoze, kandi akabataasya, eihanga rya MUKAMA rirekye kuba nk'entaama ezitaine muriisa. <verse eid="NUM 27:17" /><verse number="18" style="v" sid="NUM 27:18" /><note caller="-" style="x"><char style="xo" closed="false">27:18: </char><char style="xt" closed="false"><ref loc="GEN 41:38">Kut 41:38</ref>. </char></note> MUKAMA yaagira Musa ati: Twara Yoshua mwene Nuuni, omuntu oine omwoyo, omuteho engaro; <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />bwanyima omwemereze omu maisho ga Eleazaari omunyamurwa n'omu g'eihanga ryona, omukwatsize omurimo omu maisho gaabo. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" /><note caller="-" style="x"><char style="xo" closed="false">27:20: </char><char style="xt" closed="false"><ref loc="NUM 11:17">Kub 11:17</ref>; <ref loc="2KI 2:15">2 Bag 2:15</ref>; <ref loc="DEU 34:9">Bir 34:9</ref>. </char></note> Kandi omuhe aha kitiinisa kyawe, ab'eihanga ry'Abaisraeli boona babone kumworobera. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" /><note caller="-" style="x"><char style="xo" closed="false">27:21: </char><char style="xt" closed="false"><ref loc="JDG 1:1">Bar 1:1</ref>; <ref loc="JDG 20:18">20:18</ref>; <ref loc="DEU 33:8">Bir 33:8</ref>; <ref loc="JOS 9:14">Yos 9:14</ref>. </char></note> Aryaguma ayemerere omu maisho ga Eleazaari omunyamurwa, nawe aije omu maisho gangye amubuurize ahariinye naakoresa Urimu; ahabw'okuragiira kwa Eleazaari baryaguma bashohore, kandi bataahe ahabw'okuragiira kwe, Yoshua hamwe n'Abaisraeli boona, niryo ihanga ryona. <verse eid="NUM 27:21" /><verse number="22" style="v" sid="NUM 27:22" />Musa yaakora nk'oku MUKAMA yaamuragiira; yaatwara Yoshua, yaamwemereza omu maisho ga Eleazaari omunyamurwa n'eihanga ryona, <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" /><note caller="-" style="x"><char style="xo" closed="false">27:23: </char><char style="xt" closed="false"><ref loc="DEU 3:28">Bir 3:28</ref>; <ref loc="ISA 55:4">Isa 55:4</ref>. </char></note> yaamutaho engaro, yaamukwatsa omurimo, nk'oku MUKAMA yaaragiire naaraba omuri Musa.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s1">Ebishemereire kuhongwa aha biro bikuru by'amagyenyi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />MUKAMA yaagira Musa ati: <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" /><note caller="-" style="x"><char style="xo" closed="false">28:2: </char><char style="xt" closed="false"><ref loc="LEV 3:11">Lev 3:11</ref>; <ref loc="MAL 1:7">Mal 1:7</ref>, <ref loc="MAL 1:12">12</ref>. </char></note> Ragiira Abaisraeli, obagambire ebi ndikugamba ningira nti: Ebi mpongyeirwe, eby'okurya ebi murikumpongyera ebyokiibwe omu muriro, eby'ekisoroora ekirikunshemeza, mugume mwijukye kubimpongyera omu bunaku bwabyo obwatairweho. <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" /><note caller="-" style="x"><char style="xo" closed="false">28:3: </char><char style="xt" closed="false"><ref loc="EXO 29:38">Kur 29:38</ref>. </char></note> Obagire oti: Egi niyo mpongano y'okwotsya omu muriro, ei muriguma nimuhongyera MUKAMA; buri izooba muhongye empaya nto z'entaama ibiri ezitaine kamogo, kuba ekitambo ky'okwotsya eky'obutoosha. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Ogume ohongye omwana gw'entaama gumwe omu kasheeshe, n'ogundi omu mwabazyo, <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" /><note caller="-" style="x"><char style="xo" closed="false">28:5: </char><char style="xt" closed="false"><ref loc="NUM 15:4">Kub 15:4</ref>. </char></note> hamwe n'ekicweka kimwe kya ikumi kya eefa y'esaano y'obunono kuba empongano y'esaano, ejwangizemu ekicweka kimwe kya kana kya hiini y'amajuta g'emizeituuni agashekwire. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Egyo n'empongano y'okwotsya ey'obutoosha, eyaaragiriirwe aha rushozi Sinai kuba ey'ekisoroora kirungi, empongano eyokiibwe omu muriro ehongyeirwe MUKAMA. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Kandi empongano y'eby'okunywa ey'okuhongwa n'omwana gw'entaama gumwe, eryaba ekicweka kimwe kya kana kya hiini. Omu mwanya ogurikwera nimwo origuma nooshuka empongano ya viinyo y'amaani, ebirikuhongyerwa MUKAMA. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Ogundi mwana gw'entaama oguhongye omu mwabazyo; oguhongye n'empongano yaagwo y'esaano n'ey'eby'okunywa nk'eby'omu kasheeshe, kuba empongano eyokiibwe omu muriro ey'ekisoroora ekirikushemeza MUKAMA.<verse eid="NUM 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />Aha izooba rya sabato muhongye empaya nto z'entaama ibiri, ezihikize omwaka ezitaine kamogo, hamwe n'ebicweka bibiri bya ikumi ebya eefa y'esaano y'obunono ejwangizemu amajuta n'empongano yaayo y'eby'okunywa; <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />egyo niyo mpongano y'okwotsya buri sabato, mutabariireho ekitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'eby'okunywa. <verse eid="NUM 28:10" /><verse number="11" style="v" sid="NUM 28:11" /><note caller="-" style="x"><char style="xo" closed="false">28:11: </char><char style="xt" closed="false"><ref loc="2CH 2:4">2 Bus 2:4</ref>; <ref loc="ISA 1:13">Isa 1:13</ref>, <ref loc="ISA 1:14">14</ref>; <ref loc="COL 2:16">Kol 2:16</ref>. </char></note> Aha kutandika kwa buri kwezi mugume muhongyere MUKAMA empongano y'okwotsya enimi z'ebimasha ibiri, n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka ezitaine kamogo, <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />n'ebicweka bishatu bya ikumi bya eefa y'esaano y'obunono kuba empongano y'esaano ejwangizemu amajuta ey'okuhongwa na buri nimi, n'ebicweka bibiri bya ikumi bya eefa y'esaano y'obunono kuba empongano y'esaano ejwangizemu amajuta ey'okuhongwa na buri mpaya y'entaama, <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />kandi n'ekicweka kimwe kya ikumi ky'esaano y'obunono, ejwangizemu amajuta kuba empongano y'esaano ey'okuhongwa na buri mwana gw'entaama, byona bibe empongano y'okwotsya ey'ekisooroora kirungi, empongano eyokiibwe omu muriro ehongyeirwe MUKAMA. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Kandi empongano z'eby'okunywa ez'okuhongwa nabyo zibe ekicweka kimwe kya kabiri kya hiini ya viinyo ahabwa buri nimi, n'ekicweka kimwe kya kashatu kya hiini ahabwa buri mpaya y'entaama, kandi n'ekicweka kimwe kya kana kya hiini ahabwa buri mwana gw'entaama; egyo niyo mpongano ey'okwotsya eya buri kwezi okumara ameezi goona ag'omu mwaka. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />Kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi ekihongyeirwe MUKAMA, mutabariireho ekitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'eby'okunywa.<verse eid="NUM 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:16: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:6">Kur 12:6</ref>; <ref loc="LUK 22:7">Luk 22:7</ref>. </char>
    </note> Omu kwezi kw'okubanza aha kiro kya ikumi na bina n'ekiro ky'Okuhinguraho kwa MUKAMA. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />Aha kiro kya ikumi na bitaano eky'okwo kwezi hagume habeho ekiro kikuru ky'obugyenyi; muryaguma mumare ebiro mushanju nimurya emigaati etatumbisiibwe. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />Aha izooba eririkubibandiza habeho okuteerana okurikwera; mutarikoreraho omurimo gwona ogurikurusya; <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />kureka muhongyereho empongano eyokiibwe omu muriro, ekitambo ky'okwotsya eky'okuhongyera MUKAMA, enimi z'ebimasha ibiri, n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka; mureebe ngu tibiine kamogo; <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />mubihongye n'empongano zaabyo ez'esaano ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabwa buri nimi, n'ebicweka bibiri bya ikumi ahabwa buri mpaya y'entaama, <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju; <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" /><note caller="-" style="x"><char style="xo" closed="false">28:22: </char><char style="xt" closed="false"><ref loc="ROM 8:3">Rom 8:3</ref>. </char></note> kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi ky'okubarihiirira. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Mugume mubihongye mutabariireho ekitambo ky'okwotsya ekya buri kasheeshe, empongano y'okwotsya ey'obutoosha. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" /><note caller="-" style="x"><char style="xo" closed="false">28:24: </char><char style="xt" closed="false"><ref loc="EPH 5:2">Efe 5:2</ref>. </char></note> Kandi mugume muhongye mutyo buri izooba, okumara ebiro mushanju, eby'okurya by'empongano ezookiibwe omu muriro kuba ekisooroora ekirikushemeza MUKAMA; bihongwe nibyongyerwa aha kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'eby'okunywa. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Aha kiro kya mushanju mugire okuteerana okurikwera; mutarikikoreraho omurimo gwona ogurikurusya.<verse eid="NUM 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">28:26: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:9">Enf 3:9</ref>; <ref loc="ACT 2:1">Byak 2:1</ref>. </char>
    </note> Kandi n'aha izooba ry'emiganuro, ku muriba nimuhongyera MUKAMA empongano z'emiganuro omu bugyenyi bwa saabiiti mushanju, muryaguma mugire okuteerana okurikwera; mutaririkoreraho omurimo gwona ogurikurusya; <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" /><note caller="-" style="x"><char style="xo" closed="false">28:27: </char><char style="xt" closed="false"><ref loc="LEV 23:18">Lev 23:18</ref>, <ref loc="LEV 23:19">19</ref>. </char></note> kureka muhongye ekitambo ky'okwotsya eky'ekisooroora ekirikushemeza MUKAMA, enimi z'ebimasha ibiri, n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka, <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />n'empongano z'esaano ez'okuhongwa nabyo, esaano y'obunono ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabwa buri nimi, n'ebicweka bibiri bya ikumi ahabwa buri mpaya, <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju, <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />kandi muhongye empaya y'embuzi emwe ey'okubarihiirira. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Mugume mubihongye n'empongano zaabyo z'eby'okunywa, mutabariireho kitambo ky'okwotsya eky'obutoosha. Mureebe ngu tibiine kamogo.<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s1">Emigyenzo y'ebishemereire kukorwa omu kwezi kwa mushanju</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:1: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 23:24">Lev 23:24</ref>; <ref loc="ISA 27:13">Isa 27:13</ref>; <ref loc="MRK 16:15">Mak 16:15</ref>. </char>
    </note> Omu kwezi kwa mushanju aha kiro ky'okubanza, mugume mugire okuteerana okurikwera; mutarikikoreraho omurimo gwona ogurikurusya. Eryo izooba riryaba eizooba eri muriguma nimuteereraho amakondere. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Kandi muryaguma nimurihongyeraho empongano y'okwotsya ey'ekisooroora ekirikushemeza MUKAMA, enimi y'ekimasha emwe, n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka ezitaine kamogo, <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />n'empongano ez'okuhongwa nabyo z'esaano ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabw'egyo nimi, n'ebicweka bibiri bya ikumi ahabw'egyo mpaya y'entaama, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju; <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi eky'okubarihiirira, <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />mutabariireho kitambo ky'okwotsya ekihongwa aha kuboneka kw'okwezi n'empongano y'esaano yaakyo, n'ekitambo ky'okwotsya eky'obutoosha n'empongano y'esaano yaakyo, n'ey'eby'okunywa yaakyo, nk'ekiragiro kyabyo oku kiri, kuba empongano y'ekisooroora kirungi, eyokiibwe omu muriro, erikuhongyerwa MUKAMA.<verse eid="NUM 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:7: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 58:5">Isa 58:5</ref>; <ref loc="MAT 5:4">Mat 5:4</ref>; <ref loc="1CO 9:27">1 Kor 9:27</ref>; <ref loc="2CO 7:9">2 Kor 7:9</ref>. </char>
    </note> Aha kiro kya ikumi eky'okwo kwezi kwa mushanju mugume mugire okuteerana okurikwera; ahari eryo izooba mwebonabonese, mutaririkoreraho omurimo gwona ogurikurusya; <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />kureka muhongyere MUKAMA empongano y'okwotsya ey'ekisooroora kirungi, enimi y'ekimasha emwe n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju, ezihikize omwaka; bibe ebitaine kamogo, <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />n'empongano z'esaano ez'okuhongwa nabyo, ez'esaano y'obunono ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabw'egyo nimi, n'ebicweka bibiri bya ikumi ahabw'egyo mpaya y'entaama, <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo mushanju; <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />kandi muhongye empaya y'embuzi emwe kuba ekitambo ky'ekibi; mutabariiremu kitambo ky'okurihiirira ekibi, n'ekitambo ky'okwotsya eky'obutoosha, n'empongano yaakyo y'esaano, n'empongano zaabyo z'eby'okunywa.<verse eid="NUM 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:12: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 23:34">Lev 23:34</ref>; <ref loc="DEU 16:13">Bir 16:13</ref>. </char>
    </note> Kandi aha kiro kya ikumi na bitaano omuri okwo kwezi kwa mushanju muryaguma mugire okuteerana okurikwera; mutarikikoreraho omurimo gwona ogurikurusya; kandi muryamara ebiro mushanju nimurinda obugyenyi bw'ebiro bikuru ahari MUKAMA. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" /><note caller="-" style="x"><char style="xo" closed="false">29:13: </char><char style="xt" closed="false"><ref loc="HEB 10:1-18">Heb 10:1-18</ref>. </char></note> Kandi muryahonga ebitambo by'okwotsya, empongano eyokiibwe omu muriro, ey'ekisooroora kirungi ahari MUKAMA; enimi z'ebimasha ikumi na ishatu, n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina, ezihikize omwaka; bibe ebitaine kamogo; <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />obihongye n'empongano zaabyo ez'esaano y'obunono ejwangizemu amajuta, ebicweka bishatu bya ikumi ahabwa buri nimi ahari ezo ikumi na ishatu, n'ebicweka bibiri bya ikumi ahabwa buri mpaya ahari ezo zombi, <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />kandi n'ekicweka kimwe kya ikumi ahabwa buri mwana gw'entaama ahari ezo ikumi na ina; <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />muhongye n'empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />Aha izooba rya kabiri muhongye enimi z'ebimasha ikumi na ibiri, n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina, ezihikize omwaka ezitaine kamogo; <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />mubihongye n'empongano yaabyo y'esaano n'ez'eby'okunywa ahabw'ezo nimi, n'ahabw'ezo mpaya z'entaama, kandi n'ahabw'abo baana b'entaama, nk'omubaro gwabyo oku guri, nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa. <verse eid="NUM 29:19" /><verse number="20" style="v" sid="NUM 29:20" />Aha kiro kya kashatu muhongye enimi z'ebimasha ikumi na emwe n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina ezihikize omwaka ezitaine kamogo, <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />mubihongye n'empongano zaabyo ez'esaano n'ez'eby'okunywa ahabw'ezo nimi n'ezo mpaya, kandi n'abo baana b'entaama, nk'omubaro gwabyo oku guri, nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho ekyo kitambo ky'okwotsya eky'obutoosha n'empongano y'esaano yaakyo n'ez'eby'okunywa.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />Aha kiro kya kana muhongye enimi z'ebimasha ikumi, n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina ezihikize omwaka ezitaine kamogo, <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />mubihongye n'empongano zaabyo z'esaano n'ez'eby'okunywa ahabw'ezo nimi, n'ezo mpaya, n'abo baana b'entaama, nk'omubaro gwabyo oku guri, nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho ekyo kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />Aha kiro kya kataano muhongye enimi z'ebimasha mwenda n'empaya z'entaama ibiri, kandi n'empaya nto z'entaama ikumi na ina ezihikize omwaka ezitaine kamogo. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Mubihongye n'empongano zaabyo z'esaano n'ez'eby'okunywa ahabw'ezo nimi n'ezo mpaya kandi n'abo baana b'entaama, nk'omubaro gwabyo oku guri, kandi nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho ekyo kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />Aha kiro kya mukaaga muhongye enimi z'ebimasha munaana, n'empaya z'entaama ibiri kandi n'empaya nto z'entaama ikumi na ina ezihikize omwaka ezitaine kamogo, <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />mubihongye n'empongano zaabyo z'esaano n'ez'eby'okunywa ahabw'ezo nimi n'ezo mpaya z'entaama kandi n'abo baana b'entaama, nk'omubaro gwabyo oku guri, kandi nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />Aha kiro kya mushanju muhongye enimi z'ebimasha mushanju n'empaya z'entaama ibiri kandi n'empaya nto z'entaama ikumi na ina ezihikize omwaka ezitaine kamogo, <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />mubihongye n'empongano zaabyo z'esaano n'ez'eby'okunywa ahabw'ezo nimi n'ezo mpaya z'entaama kandi n'abo baana b'entaama, nk'omubaro gwabyo oku guri, kandi nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo y'esaano n'ez'eby'okunywa.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">29:35: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 7:37">Yoh 7:37</ref>. </char>
    </note> Aha kiro kya munaana mugume mugire okuteerana kw'okwecureeza; mutarikikoreraho omurimo gwona ogurikurusya; <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />kureka muhongye ekitambo ky'okwotsya, kuba empongano eyokiibwe omu muriro, ey'ekisooroora kirungi ahari MUKAMA; muhongye enimi emwe n'empaya y'entaama emwe, kandi n'empaya nto z'entaama mushanju ezihikize omwaka ezitaine kamogo; <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />mubihongye n'empongano zaabyo z'esaano n'ez'eby'okunywa ahabw'egyo nimi n'egyo mpaya y'entaama, kandi n'abo baana b'entaama, nk'omubaro gwabyo oku guri, nk'oku ebiragiro byabyo biri; <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />kandi muhongye empaya y'embuzi kuba ekitambo ky'ekibi, mutabariireho ekyo kitambo ky'okwotsya eky'obutoosha n'empongano yaakyo ey'esaano n'ez'eby'okunywa.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />Ebyo nibyo muriguma nimuhongyera MUKAMA omu biro by'amagyenyi gaanyu agaatairweho, kuba ebitambo byanyu by'okwotsya, n'empongano zaanyu z'esaano n'ez'eby'okunywa, kandi n'empongano zaanyu z'okusiima ahabw'obusingye, mutabariireho bi muhonga ahabw'ebi mwaraganiise n'ebi mutoija ahabw'okweyendera. <verse eid="NUM 29:39" /><verse number="40" style="v" sid="NUM 29:40" /><note caller="-" style="x"><char style="xo" closed="false">29:40: </char><char style="xt" closed="false"><ref loc="JHN 1:17">Yoh 1:17</ref>. </char></note> Bwanyima Musa yaagambira Abaisraeli byona, nk'oku MUKAMA yaamuragiire.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s1">Ebiragiro by'okuhiga</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Musa yaagambira abakuru b'enganda z'Abaisraeli ati: Eki nikyo kiragiro eki MUKAMA yaaragiira. <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" /><note caller="-" style="x"><char style="xo" closed="false">30:2: </char><char style="xt" closed="false"><ref loc="DEU 23:21">Bir 23:21</ref>; <ref loc="JDG 11:30">Bar 11:30</ref>, <ref loc="JDG 11:35">35</ref>; <ref loc="ECC 5:4">Mub 5:4</ref>, <ref loc="ECC 5:5">5</ref>; <ref loc="MAT 14:9">Mat 14:9</ref>. </char></note> Omuntu ku arihiga omu maisho ga MUKAMA, nari shi ku arirahira, yaayekwatiriza, atariita egyo ndahiro ye, kureka ahikiirize ekyamurugire omu kanwa kyona. <verse eid="NUM 30:2" /><verse number="3" style="v" sid="NUM 30:3" />Kandi omwishiki ku arihiga omuhigo omu maisho ga MUKAMA, yaayekwatiriza, akiri omu ka ya ishe omu buhangare bwe, <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />ishe yaahurira okuhiga kwe, n'okwekwatiriza kwe, yaamwetsiza, okuhiga kwe kwona n'okwekwatiriza kwe kwona n'endahiro biryahama. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Kwonka ishe ku aryanga ebi arikurahira aha izooba eri yaabihuririraho, ebi yaahiga byona, n'okwekwatiriza kwe tibirihama; kandi MUKAMA aryamusaasira, ahabw'okuba ishe yaamwangira. <verse eid="NUM 30:5" /><verse number="6" style="v" sid="NUM 30:6" />Kandi ku arishwerwa omushaija naakitegyekwa ebi yaahigire, nari shi akibohirwe endahiro ei yaarahiriire egyo, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />iba yaabihurira, yaamwetsiza aha izooba eri yaabihuririraho, ebi yaahigire biryahama, n'ebi yaarahiire naayekwatiriza nabyo bihame. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" /><note caller="-" style="x"><char style="xo" closed="false">30:8: </char><char style="xt" closed="false"><ref loc="EPH 5:22-24">Efe 5:22-24</ref>. </char></note> Kwonka iba ku arimwangira aha izooba eri yaabihuririraho, aryaba aihireho okuhiga kwe oku yaahigire, n'endahiro ei yaarahiriire eryo kurahira naayesinga; kandi MUKAMA aryamusaasira. <verse eid="NUM 30:8" /><verse number="9" style="v" sid="NUM 30:9" />Kwonka omufaakazi nari omukazi oshenzirwe ku arihiga, eki yaahigire kyona, akarahira endahiro, naayekwatiriza, kiryamutukurira. <verse eid="NUM 30:9" /><verse number="10" style="v" sid="NUM 30:10" />Kandi ku ariba ahigiire omwa iba, nari ku ariba arahiire naayekwatiriza, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />iba yaabihurira, yaamwetsiza, ataamwangira, ebi yaahigire byona biryahama, n'ebi yaarahiire naayekwatiriza byona nabyo bihame. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />Kwonka iba ku aribiihaho, yaabyanga aha izooba eri yaabihuririraho, ebyarugire omu kanwa ke naahiga, nari shi ebi yaarahiire naayekwatiriza, tibirihama, ahakuba iba aryaba abiihireho; kandi MUKAMA aryamusaasira. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />Okuhiga kwona n'endahiro yoona ei ogwo mukazi arirahira kwebonabonesa, iba aine obushoboorozi bw'okugihamya nari kugiihaho. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Kwonka iba ku arimara ebiro naamwetsiza, biri ahamize emihigo ye yoona n'endahiro ze zoona ezi yaarahiire naayekwatiriza; iba aryaba abihamize, ahakuba akamwetsiza aha izooba eri yaabihuririireho. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Kwonka ku aribiihaho, amazire ebiro naabihurira, aryagiibwaho okutahikiirira kw'omukazi we.<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />Ebyo nibyo biragiro ebi MUKAMA yaaragiire Musa, aha mushaija n'omukazi we, n'aha mushaija na muhara we, okiri empangare omu ka ya ishe.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s1">Abaisraeli okucwekyereza Abamidiani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />MUKAMA yaagambira Musa ati: <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" /><note caller="-" style="x"><char style="xo" closed="false">31:2: </char><char style="xt" closed="false"><ref loc="NUM 25:17">Kub 25:17</ref>; <ref loc="PSA 94:1">Zab 94:1</ref>. </char></note> Hoora Abamidiani, obahoorere Abaisraeli; bwanyima oryafa okurate abaanyu. <verse eid="NUM 31:2" /><verse number="3" style="v" sid="NUM 31:3" /><note caller="-" style="x"><char style="xo" closed="false">31:3: </char><char style="xt" closed="false"><ref loc="ROM 12:19">Rom 12:19</ref>. </char></note> Musa yaagambira abantu ati: Mutoorane abantu omuriimwe, mubahe eby'okurwanisa, bateere Midiani, babahoore enzigu ahabwa MUKAMA. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Omuri buri ruganda rw'enganda zoona eza Israeli mwihemu engabo rukumi, muzoohereze aha rugamba. <verse eid="NUM 31:4" /><verse number="5" style="v" sid="NUM 31:5" />Batyo omu nkumi z'Abaisraeli baatooranamu engabo rukumi-rukumi omuri buri ruganda, baihamu engabo kakumi n'enkumi ibiri eziine eby'okurwanisa. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Musa yaaboohereza aha rugamba, rukumi omuri buri ruganda, hamwe na Finehaasi mwene Eleazaari omunyamurwa, baine ebintu by'Aharikwera n'enzamba z'okuhuruza. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" /><note caller="-" style="x"><char style="xo" closed="false">31:7: </char><char style="xt" closed="false"><ref loc="DEU 20:13">Bir 20:13</ref>; <ref loc="JDG 6:1">Bar 6:1</ref>, <ref loc="JDG 6:2">2</ref>, <ref loc="JDG 6:33">33</ref>. </char></note> Baarwanisa Abamidiani, nk'oku MUKAMA yaaragiire Musa, baita abashaija boona. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" /><note caller="-" style="x"><char style="xo" closed="false">31:8: </char><char style="xt" closed="false"><ref loc="NUM 22:10">Kub 22:10</ref>; <ref loc="JUD 1:11">Yud 1:11</ref>. </char></note> Kandi hamwe n'abo abaitsirwe, baitiranamu abagabe bataano ba Midiani, Evi, Rekemu, Zuuri, Huuri na Reeba, kandi na Balamu mwene Beori baamwitsa rurara. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Abaisraeli baanyaga abakazi b'Abamidiani n'abaana baabo abato; n'ente zaabo zoona n'amasyo gaabo goona ag'entaama n'embuzi, n'ebintu byabo byona nabyo baabinyaga. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />Kandi endembo zaabo zoona omu myanya ei baabaire batwiremu, n'ensiisira zaabo zoona baabyotsya. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Baatabaarukana ebi baanyagire byona, abantu n'amatungo. <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />Enkwatwa n'eminyago n'ebintu baabireetera Musa na Eleazaari omunyamurwa n'eihanga ryona ery'Abaisraeli, ahu baabaire basiisiire omu mpita za Moabu haihi na Yorudani ahashungaine na Yeriko.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Musa na Eleazaari n'abeebembezi boona ab'eihanga baashohora kubabugana aheeru y'orusiisira. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Musa yaagwerwa kubi abakuru b'eihe, abeebembezi b'engabo rukumi-rukumi, n'aba igana-igana, abaabaire nibatabaaruka. <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" /><note caller="-" style="x"><char style="xo" closed="false">31:15: </char><char style="xt" closed="false"><ref loc="DEU 20:13">Bir 20:13</ref>; <ref loc="1SA 15:3">1 Sam 15:3</ref>. </char></note> Musa yaababuuza ati: Abakazi boona mubarekire, timwabaita? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" /><note caller="-" style="x"><char style="xo" closed="false">31:16: </char><char style="xt" closed="false"><ref loc="NUM 25:2">Kub 25:2</ref>; <ref loc="MIC 6:5">Mik 6:5</ref>; <ref loc="REV 2:14">Kush 2:14</ref>. </char></note> Nimumanya ngu abo nibo baacumwize Abaisraeli ahari MUKAMA omu bya Peori, ahabw'okuhaburwa Balamu, kikareeta orufu omu ihanga rya MUKAMA. <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" /><note caller="-" style="x"><char style="xo" closed="false">31:17: </char><char style="xt" closed="false"><ref loc="JDG 21:11">Bar 21:11</ref>. </char></note> N'ahabw'ekyo hati mwite omwojo weena omu baana, na buri mukazi weena orabyamire n'omushaija. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Kwonka abaishiki boona abatakabyamaga n'abashaija, mubeetsigireho. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Bwanyima muteere amahema gaanyu aheeru y'orusiisira, mumareyo ebiro mushanju; oitsire omuntu weena, n'okozire aha muntu oitsirwe weena, mweshemeze aha kiro kya kashatu n'aha kya mushanju, imwe n'enkwatwa zaanyu. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Kandi mushemeze buri kijwaro kyona, n'ekintu kyona ekikozirwe omu mpu n'omu bwoya bw'embuzi, n'ekibaizire kyona.<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Eleazaari omunyamurwa yaagambira engabo ezitabaarukire ati: Eki nikyo kiragiro eki MUKAMA aragiire Musa; <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />kwonka ezaabu, n'efeeza, n'emiringa, n'ebyoma, n'amabaati na rusasi, <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" /><note caller="-" style="x"><char style="xo" closed="false">31:23: </char><char style="xt" closed="false"><ref loc="NUM 19:9">Kub 19:9</ref>, <ref loc="NUM 19:17">17</ref>. </char></note> ekintu kyona ekitarikubaasa kusya, mukirabye omu muriro, kibone kushemera; kwonka kandi mukishemeze n'amaizi gari ag'okweza; kandi ekintu kyona ekirikubaasa kusya, mukirabye omuri ago maizi. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" /><note caller="-" style="x"><char style="xo" closed="false">31:24: </char><char style="xt" closed="false"><ref loc="PSA 51:2">Zab 51:2</ref>; <ref loc="ZEC 13:1">Zek 13:1</ref>. </char></note> Bwanyima aha kiro kya mushanju mwozye ebijwaro byanyu, mubone kushemera, mugarukye omu rusiisira.<verse eid="NUM 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />MUKAMA yaagira Musa ati: <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />Iwe na Eleazaari omunyamurwa n'abakuru b'amaju ga baishenkuru b'eryo ihanga mubare eminyago enyagirwe, ey'abantu n'ey'amatungo, <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" /><note caller="-" style="x"><char style="xo" closed="false">31:27: </char><char style="xt" closed="false"><ref loc="1SA 30:24">1 Sam 30:24</ref>; <ref loc="PSA 68:12">Zab 68:12</ref>. </char></note> mubaganise egyo minyago omu bicweka bibiri, ekimwe mukihe abarwani abagiire aha rugamba, n'ekindi mukihe eihanga ryona. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" /><note caller="-" style="x"><char style="xo" closed="false">31:28: </char><char style="xt" closed="false"><ref loc="2SA 8:11">2 Sam 8:11</ref>; <ref loc="1CH 26:27">1 Bus 26:27</ref>. </char></note> Mwihe aha barwani abagiire omu rugamba ebi muraabacwere kuha MUKAMA, kimwe kya ikumi ahari magana ataano, eky'abantu, eky'ente, eky'endogoya, n'eky'amasyo g'entaama, <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />mubiihe aha mugabo gwabo, mubihe Eleazaari omunyamurwa kuba empongano ehongyeirwe MUKAMA. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Kandi aha mugabo gw'Abaisraeli mwiheho kimwe kya makumi ataano, eky'abantu, eky'ente, eky'endogoya, n'eky'amasyo g'entaama, nigo matungo goona, mubihe Abaleevi abarikurinda Obutaaho bwa MUKAMA. <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Musa na Eleazaari omunyamurwa baakora nk'oku MUKAMA yaaragiire Musa.<verse eid="NUM 31:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 31:32" />Eminyago eyaatsigaire ahari byona ebi abarwani baanyagire, ekaba eri entaama obusiriira mukaaga n'obukumi mushanju n'enkumi itaano, <verse eid="NUM 31:32" /><verse number="33" style="v" sid="NUM 31:33" />n'ente obukumi mushanju n'enkumi ibiri, <verse eid="NUM 31:33" /><verse number="34" style="v" sid="NUM 31:34" />n'endogoya obukumi mukaaga na rukumi; <verse eid="NUM 31:34" /><verse number="35" style="v" sid="NUM 31:35" />kandi abaishiki boona abaabaire batakabyamaga n'abashaija bakaba bari obukumi bushatu n'enkumi ibiri. <verse eid="NUM 31:35" /><verse number="36" style="v" sid="NUM 31:36" />Ekicweka kyabyo, nigwo mugabo gw'abaagiire aha rugamba, kikaba kiri entaama obusiriira bushatu n'obukumi bushatu n'enkumi mushanju na magana ataano; <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" /><note caller="-" style="x"><char style="xo" closed="false">31:37: </char><char style="xt" closed="false"><ref loc="DEU 10:14">Bir 10:14</ref>; <ref loc="MAT 22:21">Mat 22:21</ref>. </char></note> ahari ezo ntaama, ekicweka ekyaihirweho kuba ekya MUKAMA, zikaba ziri entaama magana mukaaga na makumi mushanju na itaano. <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />Ente zikaba ziri obukumi bushatu n'enkumi mukaaga; ahari ezo ezaihirweho kuba eza MUKAMA zikaba ziri makumi mushanju na ibiri. <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />Endogoya zikaba ziri obukumi bushatu na magana ataano; ahari ezo ezaihirweho kuba eza MUKAMA zikaba ziri makumi mukaaga n'emwe. <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />Kandi n'abantu bakaba bari kakumi n'enkumi mukaaga; ahari abo abaihirweho kuba aba MUKAMA bakaba bari makumi ashatu na babiri. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />Musa yaaha Eleazaari omunyamurwa ebyo ebyaihirweho kuba empongano ehongyeirwe MUKAMA, nk'oku MUKAMA yaaragiire Musa. <verse eid="NUM 31:41" /><verse number="42" style="v" sid="NUM 31:42" />Ekicweka kyabyo eky'Abaisraeli, eki Musa yaihire aha by'abantu abaagiire omu rugamba <verse eid="NUM 31:42" /><verse number="43" style="v" sid="NUM 31:43" />(Kandi omugabo gw'eihanga zikaba ziri entaama obusiriira bushatu n'obukumi bushatu n'enkumi mushanju na magana ataano, <verse eid="NUM 31:43" /><verse number="44" style="v" sid="NUM 31:44" />ente obukumi bushatu n'enkumi mukaaga, <verse eid="NUM 31:44" /><verse number="45" style="v" sid="NUM 31:45" />n'endogoya obukumi bushatu na magana ataano, <verse eid="NUM 31:45" /><verse number="46" style="v" sid="NUM 31:46" />kandi n'abantu kakumi n'enkumi mukaaga.) <verse eid="NUM 31:46" /><verse number="47" style="v" sid="NUM 31:47" />Ahari ogwo mugabo gw'Abaisraeli Musa yaihaho kimwe kya makumi ataano ky'abantu n'amatungo, yaabiha Abaleevi, abaabaire barinda Obutaaho bwa MUKAMA, nk'oku MUKAMA yaaragiire Musa.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Bwanyima abakuru abaabaire nibategyeka enkumi ez'omu ihe, n'abeebembezi ba rukumi-rukumi, n'aba igana-igana, baija ahari Musa, baamugira bati: <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" /><note caller="-" style="x"><char style="xo" closed="false">31:49: </char><char style="xt" closed="false"><ref loc="LEV 26:7-9">Lev 26:7-9</ref>; <ref loc="PSA 116:15">Zab 116:15</ref>; <ref loc="1SA 30:19">1 Sam 30:19</ref>. </char></note> Itwe abairu baawe, twabara engabo ezi turikutegyeka, twashanga hataine obuzire n'omwe. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Mbwenu tureeteire MUKAMA empongano aha bi buri muntu anyagire, ebintu by'obuguzi eby'ezaabu, emikuufu y'aha maguru, n'engoro z'aha mikono, n'empeta z'obumanyiso, n'ez'omu matu, kandi n'enkwanzi, eby'okurihiirira amagara gaitu omu maisho ga MUKAMA. <verse eid="NUM 31:50" /><verse number="51" style="v" sid="NUM 31:51" />Musa na Eleazaari omunyamurwa baayakiira ebyo bintu byona ebiheesirwe omu zaabu. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Ezo zaabu zoona ez'empongano ei baahongyeire MUKAMA, ezaahongirwe abeebembezi b'engabo rukumi-rukumi, na igana-igana, zikaba ziri shekeli kakumi n'enkumi mukaaga na magana mushanju na makumi ataano. <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" /><note caller="-" style="x"><char style="xo" closed="false">31:53: </char><char style="xt" closed="false"><ref loc="DEU 20:14">Bir 20:14</ref>. </char></note> (Ahabw'okuba buri murwani akaba aine ebi yaayenyagiire.) <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" /><note caller="-" style="x"><char style="xo" closed="false">31:54: </char><char style="xt" closed="false"><ref loc="JOS 4:7">Yos 4:7</ref>. </char></note> Musa na Eleazaari omunyamurwa baayakiira ezaabu z'abo beebembezi b'engabo rukumi-rukumi, na igana-igana, baazitwara omu Ihema ry'okubugaabuganiramu kuba ekiijutsyo ky'Abaisraeli omu maisho ga MUKAMA.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s1">Abareubeeni n'Abagaadi okuheebwa obuhunguzi seenu ya Yorudani</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Abareubeeni n'Abagaadi bakaba baine amatungo maingi munonga; ku baareebire ensi ya Yazeri n'ensi ya Gileadi ziri ensi z'amatungo, <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />Abagaadi n'Abareubeeni baija, baagambira Musa na Eleazaari omunyamurwa n'abeebembezi b'eihanga bati: <verse eid="NUM 32:2" /><verse number="3" style="v" sid="NUM 32:3" />Ataroosi, Diboni, Yazeri, Nimura, Heshibooni, Eleale, Shebamu, Neebo na Beoni, <verse eid="NUM 32:3" /><verse number="4" style="v" sid="NUM 32:4" /><note caller="-" style="x"><char style="xo" closed="false">32:4: </char><char style="xt" closed="false"><ref loc="NUM 21:24">Kub 21:24</ref>, <ref loc="NUM 21:34">34</ref>. </char></note> ensi ei MUKAMA yaasingwire omu maisho g'Abaisraeli, n'ensi y'amatungo, kandi itwe abairu baawe tugaine. <verse eid="NUM 32:4" /><verse number="5" style="v" sid="NUM 32:5" />Baagaruka baagira bati: Ku oraabe nootugirira embabazi, itwe abairu baawe tuheebwe egi nsi ebe eyaitu, otatwambutsya Yorudani. <verse eid="NUM 32:5" /><verse number="6" style="v" sid="NUM 32:6" />Musa yaabuuza Abagaadi n'Abareubeeni ati: Beene waanyu nibaija kuhurura, imwe mugume aha? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Nimuhahaariza ki Abaisraeli emitima, ngu batambuka kuza omu nsi ei MUKAMA yaabahaire? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" /><note caller="-" style="x"><char style="xo" closed="false">32:8: </char><char style="xt" closed="false"><ref loc="NUM 13:3">Kub 13:3</ref>, <ref loc="NUM 13:33">33</ref>. </char></note> Okwo nikwo baashoimwe baagizire, obu naabatuma kutata egyo nsi, tukiri Kadeshi-barunea; <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />ahakuba, ku bainamukire omu ruhanga rwa Eshikooli, baareeba egyo nsi, baahahaaza Abaisraeli emitima, ngu bataza omu nsi ei MUKAMA yaabahaire. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" /><note caller="-" style="x"><char style="xo" closed="false">32:10: </char><char style="xt" closed="false"><ref loc="NUM 14:11">Kub 14:11</ref>; <ref loc="PSA 95:11">Zab 95:11</ref>; <ref loc="HEB 3:8-19">Heb 3:8-19</ref>. </char></note> MUKAMA yaabagirira ekiniga ekirikwaka nk'omuriro eryo izooba, yaarahira naagira ati: <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />Buzimazima tihariho n'omwe omuri aba bashaija abaarugire Misri, abahikize emyaka makumi abiri n'okukiraho, orireeba ensi ei naarahiire kuha Abrahamu na Isaaka na Yakobo; ahabw'okuba tibankuratiriire kimwe, <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" /><note caller="-" style="x"><char style="xo" closed="false">32:12: </char><char style="xt" closed="false"><ref loc="DEU 1:36">Bir 1:36</ref>; <ref loc="JOS 14:8">Yos 14:8</ref>, <ref loc="JOS 14:9">9</ref>. </char></note> kureka Kalebu mwene Yefune Omukenizi, na Yoshua mwene Nuuni, ahakuba bo bankuratiriire kimwe. <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />MUKAMA yaagirira Abaisraeli ekiniga, yaabazengyereza omu ihamba okumara emyaka makumi ana, okuhitsya obu ab'obusingye obwo bwona, abaakozire ebirikwangwa MUKAMA, baahweireho. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" /><note caller="-" style="x"><char style="xo" closed="false">32:14: </char><char style="xt" closed="false"><ref loc="DEU 1:34">Bir 1:34</ref>. </char></note> Mbwenu reeba, naimwe mugarukire omu mwanya gwa baashoimwe, oruzaaro rw'enkozi z'ebibi, kugaruka kwongyera ekiniga kya MUKAMA, ku kiba kingi munonga aha Baisraeli. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" /><note caller="-" style="x"><char style="xo" closed="false">32:15: </char><char style="xt" closed="false"><ref loc="DEU 30:17">Bir 30:17</ref>; <ref loc="2CH 15:2">2 Bus 15:2</ref>. </char></note> Ahabw'okuba ku muraamurugyeho, mwayanga kumukuratira, naija kugaruka abatsigye omuri eri ihamba; haza naimwe mureetere eihanga eri ryona kucwekyerera.<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Baamwirira haihi, baamugira bati: Nitwija kuzitirira amasyo gaitu, twombekyere abaana baitu endembo; <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" /><note caller="-" style="x"><char style="xo" closed="false">32:17: </char><char style="xt" closed="false"><ref loc="JOS 4:12">Yos 4:12</ref>, <ref loc="JOS 4:13">13</ref>. </char></note> Kwonka itwe twenka nitwija kukwata eby'okurwanisa, twebembere Abaisraeli, okuhitsya obu turibahitsya omu nsi yaabo; kandi abaana baitu baryaguma omuri ezi ndembo ezeehinguririziibwe engo z'amabaare ahabw'okwerinda abatwire omuri egi nsi. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" /><note caller="-" style="x"><char style="xo" closed="false">32:18: </char><char style="xt" closed="false"><ref loc="JOS 22:4">Yos 22:4</ref>. </char></note> Titurigaruka mu maka gaitu, buri muntu omu Baisraeli atakatungire buhunguzi bwe; <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />ahakuba tituriheebwa buhunguzi hamwe nabo seeri ya Yorudani kandi n'okweyongyerayo; ahabw'okuba obuhunguzi bwaitu tubuhairwe seenu ya Yorudani aha rubaju rw'oburugwa-izooba.<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:20: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:18">Bir 3:18</ref>. </char>
    </note> Musa yaabagarukamu ati: Ku murikora ekyo, mwatwara eby'okurwanisa, mwahurura mwebembeire MUKAMA, <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />abashaija boona omuriimwe abaine eby'okurwanisa ku baryambuka Yorudani omu maisho ga MUKAMA, okuhitsya obu aribingira kimwe abazigu be omu maisho ge, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" /><note caller="-" style="x"><char style="xo" closed="false">32:22: </char><char style="xt" closed="false"><ref loc="DEU 3:12">Bir 3:12</ref>. </char></note> ensi ekagomoorerwa MUKAMA, bwanyima muryagaruka mutaine rubanja omu maisho ga MUKAMA n'omu maisho g'Abaisraeli; kandi ensi egi eryaba eyaanyu omu maisho ga MUKAMA. <verse eid="NUM 32:22" /><verse number="23" style="v" sid="NUM 32:23" /><note caller="-" style="x"><char style="xo" closed="false">32:23: </char><char style="xt" closed="false"><ref loc="GEN 44:16">Kut 44:16</ref>; <ref loc="PSA 140:11">Zab 140:11</ref>; <ref loc="PRO 13:21">Enf 13:21</ref>. </char></note> Kwonka ku muriba mutakozire mutyo, muryaba mucumwire ahari MUKAMA; kandi mumanyire kimwe ngu ekibi kyanyu kiryabahindukana. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Mbwenu mwombekyere abaana baanyu endembo, muzitirire entaama zaanyu, mukore ekyo eki mwagamba. <verse eid="NUM 32:24" /><verse number="25" style="v" sid="NUM 32:25" />Abagaadi n'Abareubeeni baagira Musa bati: Itwe abairu baawe turyakora nk'oku waaturagiira, mukama waitu. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Abaana baitu n'abakazi baitu n'entaama zaitu, kandi n'ente zaitu zoona biryaguma omu ndembo za Gileadi; <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />kwonka itwe twena abairu baawe abaine eby'okurwanisa turyayambuka, tuhurure twebembeire MUKAMA, nk'oku waagamba, mukama waitu. <verse eid="NUM 32:27" /><verse number="28" style="v" sid="NUM 32:28" />Bwanyima y'ebyo Musa yaabiragiira Eleazaari omunyamurwa na Yoshua mwene Nuuni n'abakuru b'amaju ga baishenkuru b'enganda z'Abaisraeli. <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />Yaabagira ati: Abagaadi n'Abareubeeni ku baryambuka Yorudani naimwe, beebembeire MUKAMA kuhurura, buri muntu aine eby'okurwanisa bye, ensi yaagomoorwa omu maisho gaanyu, bwanyima muryabaha ensi ya Gileadi ebe eyaabo. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Kwonka ku bariba batambukire naimwe baine eby'okurwanisa, baryaheebwa naimwe obutaka omu nsi ya Kanaani. <verse eid="NUM 32:30" /><verse number="31" style="v" sid="NUM 32:31" />Abagaadi n'Abareubeeni baagarukamu nibagira bati: Oku MUKAMA yaaragiira abairu baawe, nikwo turikora. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Turyayambuka twine eby'okurwanisa, tuze omu nsi ya Kanaani twebembeire MUKAMA, obutaka bwaitu tugume nabwo seenu ya Yorudani.<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">32:33: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 3:12">Bir 3:12</ref>; <ref loc="PSA 135:10">Zab 135:10</ref>, <ref loc="PSA 135:11">11</ref>. </char>
    </note> Abagaadi n'Abareubeeni n'ekicweka ky'oruganda rwa Manaase mwene Yosefu, Musa yaabaha obugabe bwa Sihooni omugabe w'Abaamori, n'obwa Ogi omugabe wa Bashani, ensi n'endembo zaayo hamwe n'ebyanga ebihereraine nazo, endembo eziri omu nsi egyo yoona. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />Abagaadi baayombeka Diboni, Ataroosi, Aroeri, <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Atiroosi-shofani, Yazeri, Yogibeha, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Besi-nimura na Besi-harani; ezo ndembo baazeehinguririza engo z'amabaare, kandi baazitirira entaama zaabo. <verse eid="NUM 32:36" /><verse number="37" style="v" sid="NUM 32:37" />Abareubeeni baayombeka Heshibooni, Eleale, Kiryasaimu, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />Neebo, Baalimeoni (baahindura amaziina gaazo) na Sibuma; endembo ezi baayombekire baazeeta agandi maziina. <verse eid="NUM 32:38" /><verse number="39" style="v" sid="NUM 32:39" /><note caller="-" style="x"><char style="xo" closed="false">32:39: </char><char style="xt" closed="false"><ref loc="JOS 17:1">Yos 17:1</ref>. </char></note> Aba Makiri mwene Manaase baaza Gileadi, baagikwata, baabingamu Abaamori abaabaire batwiremu. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Musa yaaha Makiri mwene Manaase Gileadi, yaagituuramu. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Na Yairi mwene Manaase yaakwata ebirorero byayo, yaabyeta Havosi-yairi. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" /><note caller="-" style="x"><char style="xo" closed="false">32:42: </char><char style="xt" closed="false"><ref loc="PSA 49:11">Zab 49:11</ref>. </char></note> Kandi na Nooba yaagyenda, yaakwata Kenaasi n'ebirorero byayo, yaagyeterera eiziina rye Nooba.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s1">Orugyendo rw'Abaisraeli omu ihamba n'endaariro zaabo</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Ezi nizo ndaariro z'Abaisraeli, obu baaruga Misri, nk'amahe gaabo oku gaabaire gari, beebembeirwe Musa na Arooni. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Musa yaahandiika endaariro zaabo, nk'oku zaabaire nizikuratana omu ngyendo zaabo naaragiirwa MUKAMA; mbwenu ezi nizo ndaariro zaabo nk'oku baagyenzire. <verse eid="NUM 33:2" /><verse number="3" style="v" sid="NUM 33:3" /><note caller="-" style="x"><char style="xo" closed="false">33:3: </char><char style="xt" closed="false"><ref loc="PSA 105:38">Zab 105:38</ref>; <ref loc="ISA 52:12">Isa 52:12</ref>. </char></note> Aha kiro kya ikumi na bitaano omu kwezi kw'okubanza bakaimutsya orugyendo, baaruga Rameseesi; Okuhingurwaho kuraire kuhweire, Abaisraeli baarugayo nibeemurika omu maisho g'Abanyamisri; <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" /><note caller="-" style="x"><char style="xo" closed="false">33:4: </char><char style="xt" closed="false"><ref loc="EXO 12:12">Kur 12:12</ref>; <ref loc="ISA 19:1">Isa 19:1</ref>. </char></note> baatsiga banu nibakiziika emijigaijo yaabo yoona, ei MUKAMA yaabaire abaitsiremu; kandi na baaruhanga baabo MUKAMA akaba abacwereire orubanja.<verse eid="NUM 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:5: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:37">Kur 12:37</ref>. </char>
    </note> Abaisraeli baaruga Rameseesi, baasiisira Sukoosi. <verse eid="NUM 33:5" /><verse number="6" style="v" sid="NUM 33:6" />Baaruga Sukoosi, baasiisira Etamu eri aha rubaju rw'eihamba. <verse eid="NUM 33:6" /><verse number="7" style="v" sid="NUM 33:7" />Baaruga Etamu, baagaruka enyima, baaza Pihahiroosi, aharikureebana na Baali-zefooni, baasiisira omu maisho ga Migidooli. <verse eid="NUM 33:7" /><verse number="8" style="v" sid="NUM 33:8" />Baaruga ahu baabaire bari omu maisho ga Hahiroosi, baaraba omu nyanja, baahika omu ihamba; baagyenda orugyendo rw'ebiro bishatu omu ihamba rya Etamu, baasiisira Maara. <verse eid="NUM 33:8" /><verse number="9" style="v" sid="NUM 33:9" />Baaruga Maara, baahika Elimu; omuri Elimu hakaba harimu enshuro z'amaizi ikumi na ibiri, n'emikindo makumi mushanju; baasiisirayo. <verse eid="NUM 33:9" /><verse number="10" style="v" sid="NUM 33:10" />Baaruga Elimu, baasiisira aha rubaju rw'Enyanja erikutukura. <verse eid="NUM 33:10" /><verse number="11" style="v" sid="NUM 33:11" />Baaruga aha Nyanja erikutukura, baasiisira omu ihamba rya Siini. <verse eid="NUM 33:11" /><verse number="12" style="v" sid="NUM 33:12" />Baaruga omu ihamba rya Siini, baasiisira Dofika. <verse eid="NUM 33:12" /><verse number="13" style="v" sid="NUM 33:13" />Baaruga Dofika, baasiisira Alushi. <verse eid="NUM 33:13" /><verse number="14" style="v" sid="NUM 33:14" /><note caller="-" style="x"><char style="xo" closed="false">33:14: </char><char style="xt" closed="false"><ref loc="EXO 17:1">Kur 17:1</ref>. </char></note> Baaruga Alushi, baasiisira Refidimu, ahu abantu baaburiire amaizi g'okunywa. <verse eid="NUM 33:14" /><verse number="15" style="v" sid="NUM 33:15" />Baaruga Refidimu, baasiisira omu ihamba rya Sinai. <verse eid="NUM 33:15" /><verse number="16" style="v" sid="NUM 33:16" />Baaruga omu ihamba rya Sinai, baasiisira Kibiroosi-hatava. <verse eid="NUM 33:16" /><verse number="17" style="v" sid="NUM 33:17" />Baaruga Kibiroosi-hatava, baasiisira Hazeroosi. <verse eid="NUM 33:17" /><verse number="18" style="v" sid="NUM 33:18" />Baaruga Hazeroosi, baasiisira Risima. <verse eid="NUM 33:18" /><verse number="19" style="v" sid="NUM 33:19" />Baaruga Risima baasiisira Rimoni-pereezi. <verse eid="NUM 33:19" /><verse number="20" style="v" sid="NUM 33:20" />Baaruga Rimoni-pereezi, baasiisira Libuna. <verse eid="NUM 33:20" /><verse number="21" style="v" sid="NUM 33:21" />Baaruga Libuna, baasiisira Risa. <verse eid="NUM 33:21" /><verse number="22" style="v" sid="NUM 33:22" />Baaruga Risa, baasiisira Kehelaasa. <verse eid="NUM 33:22" /><verse number="23" style="v" sid="NUM 33:23" />Baaruga Kehelaasa, baasiisira omu kibungo kya Sheferi. <verse eid="NUM 33:23" /><verse number="24" style="v" sid="NUM 33:24" />Baaruga omu kibungo kya Sheferi, baasiisira Harada. <verse eid="NUM 33:24" /><verse number="25" style="v" sid="NUM 33:25" />Baaruga Harada, baasiisira Maki-heloosi. <verse eid="NUM 33:25" /><verse number="26" style="v" sid="NUM 33:26" />Baaruga Maki-heloosi, baasiisira Tahasi. <verse eid="NUM 33:26" /><verse number="27" style="v" sid="NUM 33:27" />Baaruga Tahasi, baasiisira Teera. <verse eid="NUM 33:27" /><verse number="28" style="v" sid="NUM 33:28" />Baaruga Teera, baasiisira Misika. <verse eid="NUM 33:28" /><verse number="29" style="v" sid="NUM 33:29" />Baaruga Misika, baasiisira Hashimoona. <verse eid="NUM 33:29" /><verse number="30" style="v" sid="NUM 33:30" />Baaruga Hashi-moona, baasiisira Moseroosi. <verse eid="NUM 33:30" /><verse number="31" style="v" sid="NUM 33:31" />Baaruga Moseroosi, baasiisira Bene-yakani. <verse eid="NUM 33:31" /><verse number="32" style="v" sid="NUM 33:32" />Baaruga Bene-yakani, baasiisira Hori-hagidigadi. <verse eid="NUM 33:32" /><verse number="33" style="v" sid="NUM 33:33" />Baaruga Hori-hagidigadi, baasiisira Yotibaasa. <verse eid="NUM 33:33" /><verse number="34" style="v" sid="NUM 33:34" />Baaruga Yotibaasa, baasiisira Abiroona. <verse eid="NUM 33:34" /><verse number="35" style="v" sid="NUM 33:35" />Baaruga Abiroona, baasiisira Ezioni-geberi. <verse eid="NUM 33:35" /><verse number="36" style="v" sid="NUM 33:36" />Baaruga Ezioni-geberi, baasiisira omu ihamba rya Ziini, niyo Kadeshi. <verse eid="NUM 33:36" /><verse number="37" style="v" sid="NUM 33:37" />Baaruga Kadeshi, baasiisira aha rushozi Hoori aha mwatano gw'ensi ya Edomu. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" /><note caller="-" style="x"><char style="xo" closed="false">33:38: </char><char style="xt" closed="false"><ref loc="NUM 20:25">Kub 20:25</ref>, <ref loc="NUM 20:28">28</ref>. </char></note> Arooni omunyamurwa yainamuka aha rushozi Hoori ahabw'ekiragiro kya MUKAMA, yaafeerayo omu mwaka gwa makumi ana Abaisraeli barugire omu nsi ya Misri, omu kwezi kwa kataano aha kiro ky'okubanza. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Kandi Arooni akaba ahikize emyaka igana na makumi abiri n'eshatu, obu yaagwa aha rushozi Hoori.<verse eid="NUM 33:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">33:40: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:1">Kub 21:1</ref>. </char>
    </note> Omunyakanaani omugabe wa Aradi, owaabaire atwire Negebu omu nsi ya Kanaani, yaahurira ngu Abaisraeli baizire.<verse eid="NUM 33:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41" />Baaruga aha rushozi Hoori, baasiisira Zalumoona. <verse eid="NUM 33:41" /><verse number="42" style="v" sid="NUM 33:42" />Baaruga Zalumoona, baasiisira Punooni. <verse eid="NUM 33:42" /><verse number="43" style="v" sid="NUM 33:43" />Baaruga Punooni, baasiisira Obosi. <verse eid="NUM 33:43" /><verse number="44" style="v" sid="NUM 33:44" />Baaruga Obosi, baasiisira Iye-abariimu eri omu mwatano gwa Moabu. <verse eid="NUM 33:44" /><verse number="45" style="v" sid="NUM 33:45" />Baaruga Iyimu, baasiisira Diboni-gaadi. <verse eid="NUM 33:45" /><verse number="46" style="v" sid="NUM 33:46" />Baaruga Diboni-gaadi, baasiisira Alimoni-dibulasaimu. <verse eid="NUM 33:46" /><verse number="47" style="v" sid="NUM 33:47" />Baaruga Alimoni-dibulasaimu, baasiisira omu nshozi za Abariimu omu maisho ga Neebo. <verse eid="NUM 33:47" /><verse number="48" style="v" sid="NUM 33:48" />Baaruga omu nshozi za Abariimu, baasiisira omu mpita za Moabu haihi na Yorudani ahashungaine na Yeriko. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Bwanyima baasiisira haihi na Yorudani okuruga Besi-yeshimooseveni okuhika Abeeli-shitimu omu mpita za Moabu.<verse eid="NUM 33:49" /></para>
  <para style="s1">Ruhanga okuragiira Abaisraeli kubinga Abanyakanaani n'okumaraho ebishushani byabo ebirikuramibwa</para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />MUKAMA yaagambirira Musa omu mpita za Moabu, haihi na Yorudani ahashungaine na Yeriko, ati: <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />Gambira Abaisraeli oti: Ku muryambuka Yorudani, mwahika omu nsi ya Kanaani, <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" /><note caller="-" style="x"><char style="xo" closed="false">33:52: </char><char style="xt" closed="false"><ref loc="DEU 7:2-5">Bir 7:2-5</ref>, <ref loc="DEU 7:25">25</ref>, <ref loc="DEU 7:26">26</ref>; <ref loc="JDG 2:2">Bar 2:2</ref>. </char></note> mubingye abatuuzi boona ab'omuri egyo nsi, babarugye omu maisho, mucwekyereze ebishushani byabo byona ebibaizirwe omu mabaare, n'ebishushani byabo byona ebiheesire, kandi musheenye emyanya yaabo yoona emikuru ey'okuramizamu, <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />mukubuure ensi, mugituuremu; ahabw'okuba niimwe ngihaire kuba eyaanyu. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" /><note caller="-" style="x"><char style="xo" closed="false">33:54: </char><char style="xt" closed="false"><ref loc="NUM 26:53">Kub 26:53</ref>. </char></note> Ensi egyo muryagihungura nimugiteerera enteenyu, nk'emiryango yaanyu oku eri; abaingi muryabaha obuhunguzi bwingi, n'abakye mubahe bukye; ahu enteenyu erikwatira omuntu, niho hariba ahakwe; muryagihungura nk'enganda za bashwenkuriimwe oku ziri. <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" /><note caller="-" style="x"><char style="xo" closed="false">33:55: </char><char style="xt" closed="false"><ref loc="JOS 23:13">Yos 23:13</ref>; <ref loc="PSA 106:34">Zab 106:34</ref>. </char></note> Kwonka ku muriba mutabingire abagitwiremu, mukabaiha omu maisho gaanyu, abumuritsigamu baryababeera ebirikucumita omu maisho, n'amahwa omu mbaju, babatuntuze omuri egyo nsi ei muriba mutwiremu. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Kandi oku naabaire niinyenda kubagira, naimwe nikwo ndibagira.<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s1">Emyatano y'ensi y'Abaisraeli</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />MUKAMA yaagira Musa ati: <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />Ragiira Abaisraeli oti: Ku murihika omu nsi ya Kanaani, (niyo nsi ei muriheebwa kuba obuhunguzi, nk'emyatano yaayo oku eri) <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" /><note caller="-" style="x"><char style="xo" closed="false">34:3: </char><char style="xt" closed="false"><ref loc="JOS 15:1">Yos 15:1</ref>. </char></note> ekicweka kyanyu eky'aha bukiizi-bwa-buryo kiryaruga aha ihamba rya Ziini, kiraabe aha rubaju rwa Edomu, kandi omwatano gwanyu ogw'aha bukiizi-bwa-buryo guryatandikira aha Nyanja y'Omwonyo okwiha aha muheru gwayo aha bukiizi bw'oburugwa-izooba; <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />ogwo mwatano gwanyu gukiikame gutoore aha bukiizi-bwa-buryo aharikwinamuka Akarabiimu, gwogyemu guhikye Ziini, gugarukire aha rubaju rwa Kadeshi-barunea aha bukiizi bwayo obwa-buryo; gugumizemu, guhikye Hazari-adaari, gwogyemu guhikye Azimooni. <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />Bwanyima gurugye Azimooni, gukiikame, guhikye aha kagyera ka Misri, gugarukire aha Nyanja Empango. <verse eid="NUM 34:5" /><verse number="6" style="v" sid="NUM 34:6" />Omwatano gwayo ogw'aha burengyerwa-izooba guryaba Enyanja Empango n'embaju zaayo; ogwo nigwo guriba omwatano gwanyu aha rubaju rw'oburengyerwa-izooba. <verse eid="NUM 34:6" /><verse number="7" style="v" sid="NUM 34:7" />N'ogu nigwo guriba omwatano gwanyu aha rubaju r'obukiizi-bwa-bumosho; okwiha aha Nyanja Empango muryataho omwatano guhikye aha rushozi Hoori. <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />Okuruga aha rushozi Hoori muteho omwatano guhikye ahu orikutaahira nooza Hamasi, gugarukire Zedadi. <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />Bwanyima omwatano gugumizemu guhikye Zifurooni, gugarukire Hazari-enani; ogwo gube nigwo gwaba omwatano gwanyu ogw'aha bukiizi-bwa-bumosho.<verse eid="NUM 34:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10" />Kandi muryataho omwatano gwanyu aha rubaju rw'oburugwa-izooba okuruga Hazari-enani okuhika Shefamu. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Gurugye Shefamu, gushuume, guhikye Ribula aha rubaju rwa Aini orw'oburugwa-izooba; gugumizemu gushuume, guhikye aha rubaju rw'enyanja ya Kinereesi oburugwa-izooba; <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />gugumizemu gushuume guhikye Yorudani, gugarukire aha Nyanja y'Omwonyo; egyo niyo eriba ensi yaanyu, nk'emyatano yaayo egyehinguririize oku eri.<verse eid="NUM 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">34:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 14:1">Yos 14:1</ref>, <ref loc="JOS 14:2">2</ref>. </char>
    </note> Musa yaaragiira Abaisraeli ati: Egi niyo nsi ei murihungura nimugiteerera enteenyu ei MUKAMA yaaragiire kuha enganda mwenda n'ekicweka; <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" /><note caller="-" style="x"><char style="xo" closed="false">34:14: </char><char style="xt" closed="false"><ref loc="NUM 32:33">Kub 32:33</ref>. </char></note> ahabw'okuba oruganda rwa Reubeeni nk'emiryango ya baishenkurubo oku eri, n'oruganda rwa Gaadi nk'emiryango ya baishenkurubo oku eri, n'ekicweka ky'oruganda rwa Manaase, baherize kuheebwa obuhunguzi bwabo. <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />Ezo nganda ibiri n'ekicweka ziherize kuheebwa obuhunguzi bwazo seenu ya Yorudani ahashungaine na Yeriko aha rubaju rw'oburugwa-izooba.<verse eid="NUM 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />MUKAMA yaagira Musa ati: <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />Aga nigo maziina g'abantu abaribabaganisiza ensi kuba obuhunguzi bwanyu; Eleazaari omunyamurwa na Yoshua mwene Nuuni. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Kandi muryatoorana omwebembezi omwe omuri buri ruganda, babaganise ensi kuba obuhunguzi. <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Amaziina gaabo n'aga; ow'oruganda rwa Yuda, Kalebu mwene Yefune; <verse eid="NUM 34:19" /><verse number="20" style="v" sid="NUM 34:20" />ow'oruganda rwa Simeoni, Shemueli mwene Amihuudi; <verse eid="NUM 34:20" /><verse number="21" style="v" sid="NUM 34:21" />ow'oruganda rwa Benyamiini Elidaadi mwene Kisilooni; <verse eid="NUM 34:21" /><verse number="22" style="v" sid="NUM 34:22" />ow'oruganda rwa Daani omwebembezi Buuki mwene Yogili; <verse eid="NUM 34:22" /><verse number="23" style="v" sid="NUM 34:23" />owa beene Yosefu, ow'oruganda rwa Manaase, omwebembezi Hanieli mwene Efodi; <verse eid="NUM 34:23" /><verse number="24" style="v" sid="NUM 34:24" />ow'oruganda rwa Efuraimu omwebembezi Kemueli mwene Shifitaani; <verse eid="NUM 34:24" /><verse number="25" style="v" sid="NUM 34:25" />ow'oruganda rwa Zebuluuni omwebembezi Elizafaani mwene Parinaaki; <verse eid="NUM 34:25" /><verse number="26" style="v" sid="NUM 34:26" />ow'oruganda rwa Isakaari omwebembezi Palitieli mwene Azaani; <verse eid="NUM 34:26" /><verse number="27" style="v" sid="NUM 34:27" />ow'oruganda rwa Asheri omwebembezi Ahihuudi mwene Shelomi; <verse eid="NUM 34:27" /><verse number="28" style="v" sid="NUM 34:28" />ow'oruganda rwa Nafutaali omwebembezi Pedaheli mwene Amihuudi. <verse eid="NUM 34:28" /><verse number="29" style="v" sid="NUM 34:29" /><note caller="-" style="x"><char style="xo" closed="false">34:29: </char><char style="xt" closed="false"><ref loc="ACT 17:26">Byak 17:26</ref>. </char></note> Abo nibo MUKAMA yaaragiire kubaganisiza Abaisraeli obuhunguzi bwabo omu nsi ya Kanaani.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s1">Endembo z'Abaleevi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />MUKAMA yaagambirira Musa omu mpita za Moabu haihi na Yorudani ahashungaine na Yeriko, ati: <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" /><note caller="-" style="x"><char style="xo" closed="false">35:2: </char><char style="xt" closed="false"><ref loc="JOS 14:3">Yos 14:3</ref>, <ref loc="JOS 14:4">4</ref>. </char></note> Ragiira Abaisraeli bahe Abaleevi endembo z'okutuuramu, nibaziiha aha nsi yaabo ei bahungwire; kandi mubahe amariisizo ageehinguririize ezo ndembo. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />Ezo ndembo zibe ezaabo z'okutuuramu, n'amariisizo gabe ag'ente zaabo n'ebintu byabo, n'amatungo gaabo goona. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />Amariisizo ag'aha ndembo agu muriha Abaleevi, gatandikire aha ngo z'endembo, gahitsye entambwe magana ataano embaju zoona. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Aheeru y'orurembo aha rubaju rw'oburugwa-izooba mugyere entambwe rukumi, aha rubaju rw'obukiizi-bwa-buryo entambwe rukumi, aha rubaju rw'oburengyerwa-izooba entambwe rukumi, kandi n'aha rubaju rw'obukiizi-bwa-bumosho entambwe rukumi, orurembo rugume ahagati. Ago gabe nigo gaaba mariisizo g'aha ndembo zaabo. <verse eid="NUM 35:5" /><verse number="6" style="v" sid="NUM 35:6" /><note caller="-" style="x"><char style="xo" closed="false">35:6: </char><char style="xt" closed="false"><ref loc="DEU 4:41">Bir 4:41</ref>; <ref loc="PSA 9:9">Zab 9:9</ref>; <ref loc="PSA 62:7">62:7</ref>, <ref loc="PSA 62:8">8</ref>; <ref loc="ISA 4:6">Isa 4:6</ref>. </char></note> Endembo ezi muriha Abaleevi zibe endembo mukaaga ez'okuhungiramu, oriita omuntu weena azihungiremu; kandi ahari ezo mukaaga mwongyereho ezindi makumi ana na ibiri. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Endembo zoona ezi muriha Abaleevi zibe makumi ana na munaana; muzibahe hamwe n'amariisizo gaazo. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" /><note caller="-" style="x"><char style="xo" closed="false">35:8: </char><char style="xt" closed="false"><ref loc="NUM 33:54">Kub 33:54</ref>. </char></note> Endembo ezi muriiha aha butaka bw'Abaisraeli kuha Abaleevi, abaingi muryabaihaho nyingi, n'abakye mubaiheho nkye. Buri ruganda nk'obuhunguzi bwarwo oku buri, nikwo ruribaha aha ndembo zaarwo.<verse eid="NUM 35:8" /></para>
  <para style="s1">Endembo z'okuhungiramu</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />MUKAMA yaagira Musa ati: <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" /><note caller="-" style="x"><char style="xo" closed="false">35:10: </char><char style="xt" closed="false"><ref loc="JOS 20:2">Yos 20:2</ref>, <ref loc="JOS 20:3">3</ref>. </char></note> Gambira Abaisraeli oti: Ku muryambuka Yorudani, mwahika omu nsi ya Kanaani, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />muryayetooranira endembo zibe ezaanyu z'okuhungiramu, oitsire omuntu weena, atamwitsire nkana, ahungiremu. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Ezo ndembo ziryababeera obuhungiro bw'okukiriramu omuhoozi w'enzigu, oriba aitsire omuntu arekye kufa, atakeemereire mu maisho g'omutwe gw'abakuru kucwerwa orubanja. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Kandi ezo ndembo ezi muriha, nizo ziriba endembo zaanyu mukaaga ez'okuhungiramu. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Muryaha endembo ishatu seenu ya Yorudani, n'ezindi ishatu omu nsi ya Kanaani, zibe endembo z'okuhungiramu. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Ezo ndembo zoona mukaaga ziryaba obuhungiro bw'Abaisraeli n'obw'abanyamahanga n'obw'abariba babashuhuukiiremu, oriita omuntu weena, atamwitsire nkana, ahungiremu.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">35:16: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 19:11">Bir 19:11</ref>, <ref loc="DEU 19:12">12</ref>. </char>
    </note> Kwonka ku arimuteeza ekyoma, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />Nari ku arimuteera eibaare, eri aine omu ngaro, eririkubaasa kwita omuntu, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />Nari shi, ku arimuteeza ekiti kibaizire eki akwaitse omu ngaro, ekirikubaasa kwita omuntu, yaafa, biri n'omwitsi; kandi omwitsi ataribura kwitwa. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Orikuhoorera nyakufa niwe ariyeitira oitsire omuntu; ku arimureeba, amwite. <verse eid="NUM 35:19" /><verse number="20" style="v" sid="NUM 35:20" /><note caller="-" style="x"><char style="xo" closed="false">35:20: </char><char style="xt" closed="false"><ref loc="2SA 3:27">2 Sam 3:27</ref>; <ref loc="PSA 10:7-10">Zab 10:7-10</ref>. </char></note> Kandi oitsire omuntu, ku ariba amucumitsire ahabw'okumwanga, nari aine eki yaamurekyeire, akamuteera amugwereire, akafa, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />nari shi amuteire entomi ahabw'okumwanga, yaagwa ahansi, yaafa, owaamuteire ataribura kwitwa; biri n'omwitsi; orikuhoorera nyakufa aite ogwo mwitsi, ku arimureeba. <verse eid="NUM 35:21" /><verse number="22" style="v" sid="NUM 35:22" />Kwonka ku arihikiirirwa, yaacumita omuntu atamwineho rwango, nari yaagira eki yaamuteera, atamugwereire; <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />nari shi ku arimuteera eibaare eririkubaasa kwita omuntu atamureebire, yaarimuteera, yaafa, kandi ashangirwe atari muzigu we, kandi atarikwenda kumukora kubi, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" /><note caller="-" style="x"><char style="xo" closed="false">35:24: </char><char style="xt" closed="false"><ref loc="JOS 20:6">Yos 20:6</ref>. </char></note> obwo omutwe gw'abakuru guryacwera omwitsi n'orikuhoorera eshagama orubanja, nk'ebiragiro ebyo oku biri; <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" /><note caller="-" style="x"><char style="xo" closed="false">35:25: </char><char style="xt" closed="false"><ref loc="EPH 1:7">Efe 1:7</ref>. </char></note> abo bakuru bakize oitsire omuntu orikumuhoorera nyakufa, bamugarure omu rurembo rw'obuhungiro, oru abaire ahungiiremu, arugumemu okuhitsya obu omunyamurwa omukuru, owaashukirweho amajuta g'okushoroora, arifa. <verse eid="NUM 35:25" /><verse number="26" style="v" sid="NUM 35:26" />Kwonka ogwo muntu oitsire ondiijo ku arirenga omwatano gw'orurembo rw'obuhungiro, oru ahungiiremu, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />orikuhoorera eshagama yaamushanga aheeru y'orwo rurembo rw'obuhungiro, yaamwita, tarigiibwaho rubanja rw'eshagama ye; <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />ahakuba ogwo akaabaire agumire omu rurembo rw'obuhungiro bwe, okuhitsya ahu omunyamurwa omukuru arifeera; kwonka omunyamurwa omukuru ku ariheza kufa, ogwo oitsire omuntu agarukye omu butaka bwe.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />Ebyo bigume bibabeere ebiragiro n'emitwarize ebitairweho omu busingye bwanyu bwona n'omu maka gaanyu goona. <verse eid="NUM 35:29" /><verse number="30" style="v" sid="NUM 35:30" /><note caller="-" style="x"><char style="xo" closed="false">35:30: </char><char style="xt" closed="false"><ref loc="2CO 13:1">2 Kor 13:1</ref>; <ref loc="HEB 10:28">Heb 10:28</ref>. </char></note> Oriita omuntu weena aryaitwa ahabwa baamushinja, kwonka atariitwa ahabwa mushinja omwe. <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />Kandi mutaryakiira eky'okucungura oitsire omuntu, oshemereire kwitwa; kureka omuntu ogwo buzimazima aryaitwa. <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" /><note caller="-" style="x"><char style="xo" closed="false">35:32: </char><char style="xt" closed="false"><ref loc="GAL 2:21">Gal 2:21</ref>. </char></note> Kandi mutariikiriza ekarabo y'omuntu ohungiire omu rurembo rw'obuhungiro, ngu agarukye kutuura omu nsi, omunyamurwa omukuru atakafiire. <verse eid="NUM 35:32" /><verse number="33" style="v" sid="NUM 35:33" /><note caller="-" style="x"><char style="xo" closed="false">35:33: </char><char style="xt" closed="false"><ref loc="GEN 4:9-12">Kut 4:9-12</ref>; <ref loc="GEN 9:6">9:6</ref>; <ref loc="DEU 21:23">Bir 21:23</ref>. </char></note> Ku muritwaza mutyo, timurishiisha nsi ei murituuramu; ahabw'okuba eshagama niyo eshiisha ensi, kandi tihariho ky'okurihiirira ensi, ahabw'eshagama eyaagisheeshekireho, kureka eshagama y'ogwo owaagijwisize. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" /><note caller="-" style="x"><char style="xo" closed="false">35:34: </char><char style="xt" closed="false"><ref loc="EXO 29:45">Kur 29:45</ref>, <ref loc="EXO 29:46">46</ref>. </char></note> Mutarishiisha ensi ei mutwiremu, ei ntuuramu ahagati; ahabw'okuba nyowe MUKAMA ntuura ahagati y'Abaisraeli.<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s1">Ekiragiro ky'obuhunguzi bw'abaishiki n'abakazi</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Abakuru b'amaju ga baishenkurubo ag'emiryango ya beene Gileadi mwene Makiri, mwene Manaase, ab'omu miryango ya beene Yosefu, bairira haihi, baagambira omu maisho ga Musa n'abeebembezi n'abakuru b'amaju ga baishenkuru b'Abaisraeli, <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" /><note caller="-" style="x"><char style="xo" closed="false">36:2: </char><char style="xt" closed="false"><ref loc="NUM 27:1">Kub 27:1</ref>, <ref loc="NUM 27:7">7</ref>. </char></note> nibagira bati: MUKAMA akakuragiira, iwe mukama waitu, kubaganisa ensi n'enteenyu noogiha Abaisraeli kuba obuhunguzi; kandi, mukama waitu, okaragiirwa MUKAMA kuha bahara ba Zelofehaadi mwene waitu obuhunguzi bwe. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Kwonka ku barishwerwa abantu b'omu nganda ezindi ez'Abaisraeli, obuhunguzi bwabo buryaihwa aha buhunguzi bwa baatatenkuriitwe, bwongyerwe aha buhunguzi bw'enganda ezi barishwerwamu; n'ahabw'ekyo buryaba bwihirwe aha mugabo gw'obuhunguzi bwaitu. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" /><note caller="-" style="x"><char style="xo" closed="false">36:4: </char><char style="xt" closed="false"><ref loc="LEV 25:10">Lev 25:10</ref>. </char></note> Kandi omwaka gwa jubili y'Abaisraeli ku gurihika, obuhunguzi buryayongyerwa aha buhunguzi bw'oruganda oru baashweirwemu; n'ahabw'ekyo obuhunguzi bwabo buryaihirwa kimwe aha buhunguzi bw'oruganda rwa baatatenkuriitwe.<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Musa yaaragiira Abaisraeli nk'ekigambo kya MUKAMA oku kyabaire kiri, naagira ati: Ebi oruganda rwa beene Yosefu rurikufa n'eby'amazima. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Eki nikyo MUKAMA arikuragiira aha bya bahara ba Zelofehaadi, ati: Mubarekye bagume bashwerwe abu barisiima; kwonka bashwerwe omu muryango gw'oruganda rwa baishenkurubo. <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" /><note caller="-" style="x"><char style="xo" closed="false">36:7: </char><char style="xt" closed="false"><ref loc="1KI 21:3">1 Bag 21:3</ref>. </char></note> Hatarigira obuhunguzi bw'Abaisraeli obwaruga omu ruganda bukaza omurundi; kureka buri muntu omu Baisraeli agume omu buhunguzi bw'oruganda rwa baishenkuru. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Kandi omwishiki weena, oriheebwa obuhunguzi omu ruganda rw'Abaisraeli, ashwerwe ow'omu muryango gw'oruganda rwa baishenkuru, buri muntu ow'omu Baisraeli abone kuheebwa obuhunguzi bwa baishenkuru. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />N'ahabw'ekyo tiharibaho buhunguzi obwaruga omu ruganda bukaza omurundi; ahakuba buri ruganda omu nganda z'Abaisraeli ruryagumya obuhunguzi bwarwo.<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />Bwanyima bahara ba Zelofehaadi baakora, nk'oku MUKAMA yaaragiira Musa; <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />ahakuba Maala, Tiruza, Hogula, Milika na Noa, bahara ba Zelofehaadi, bakashwerwa batabani ba baishentobo. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />Baashwerwa ab'omu miryango ya beene Manaase, mwene Yosefu; obuhunguzi bwabo bwaguma omu ruganda rw'omuryango gwa ishebo.<verse eid="NUM 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 36:13" />Ebyo nibyo biragiro n'emitwarize ebyatairweho, ebi MUKAMA yaaragiire Abaisraeli naaraba omuri Musa, bari omu mpita za Moabu haihi na Yorudani, ahashungaine na Yeriko.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>