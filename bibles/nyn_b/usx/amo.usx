<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">RRK30.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">AMOSI</para>
  <para style="toc1">Ekitabo Kya Nabi Amosi</para>
  <para style="toc2">Amosi</para>
  <para style="toc3">Amo</para>
  <para style="mt2">EKITABO KYA NABI</para>
  <para style="mt1">AMOSI</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="s1">Ruhanga okucwera amahanga agatari gamwe orubanja</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 7:10">Amo 7:10</ref>, <ref loc="AMO 7:14">14</ref>, <ref loc="AMO 7:15">15</ref>; <ref loc="2KI 14:23">2 Bag 14:23</ref>; <ref loc="2CH 26:1">2 Bus 26:1</ref>, <ref loc="2CH 26:3">3</ref>; <ref loc="HOS 1:1">Hos 1:1</ref>; <ref loc="ZEC 14:5">Zek 14:5</ref>. </char>
    </note> Ebi n'ebigambo bya Amosi, ow'omu bariisa ba Tekoa, ebi yaareebire omu busingye bwa Uziya omugabe wa Yuda, n'omu busingye bwa Yeroboamu mwene Yoashi, omugabe wa Israeli, haatsigaire emyaka ebiri kuhika aha mutsitsa. <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" /><note caller="-" style="x"><char style="xo" closed="false">1:2: </char><char style="xt" closed="false"><ref loc="JOL 3:16">Yoel 3:16</ref>. </char></note> Akagira ati:</para>
  <para style="q1" vid="AMO 1:2">MUKAMA naatsinda naayema Saayuuni,</para>
  <para style="q1" vid="AMO 1:2">Naimutsya eiraka rye ari Yerusaalemu;</para>
  <para style="q1" vid="AMO 1:2">Amariisizo g'abariisa nigacura,</para>
  <para style="q1" vid="AMO 1:2">Omutwe gwa Karumeeli niguhotoka.<verse eid="AMO 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 10:23">2 Bag 10:23</ref>; <ref loc="PRO 30:18">Enf 30:18</ref>; <ref loc="ISA 8:4">Isa 8:4</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 1:3">Ahabw'ebicumuro bya Damasiko bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 1:3">Tindigiihaho kifubiro,</para>
  <para style="q1" vid="AMO 1:3">ahabw'okuba bakahuura Gileadi n'ebihuuzo by'ebyoma.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 13:24">2 Bag 13:24</ref>, <ref loc="2KI 13:25">25</ref>; <ref loc="JER 49:27">Yer 49:27</ref>. </char>
    </note> N'ahabw'ekyo ndyayohereza omuriro aha nju ya Hazaeli,</para>
  <para style="q1" vid="AMO 1:4">Gwokyeze kimwe ebikaari bya Beni-hadadi.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:7">Amo 9:7</ref>; <ref loc="2KI 16:9">2 Bag 16:9</ref>; <ref loc="2KI 19:12">19:12</ref>. </char>
    </note> Ndyahenda empimbi y'eirembo rya Damasiko,</para>
  <para style="q1" vid="AMO 1:5">Mmareho abatwire omu ruhita rwa Aveeni,</para>
  <para style="q1" vid="AMO 1:5">N'okwaitse enkoni y'obugabe omuri Besedeni;</para>
  <para style="q1" vid="AMO 1:5">Kandi n'Abasiria baryatwarwa Kiiri bari enkwatwa;</para>
  <para style="m" vid="AMO 1:5">nikwo MUKAMA arikugira.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 28:17">2 Bus 28:17</ref>, <ref loc="2CH 28:18">18</ref>; <ref loc="JER 47:1">Yer 47:1</ref>, <ref loc="JER 47:5">5</ref>; <ref loc="JOL 3:4-6">Yoel 3:4-6</ref>; <ref loc="ZEP 2:4">Zef 2:4</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 1:6">Ahabw'ebicumuro bya Gaaza bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 1:6">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 1:6">Ahabw'okuba bakatwara eihanga ryona omu bukwatwa,</para>
  <para style="q1" vid="AMO 1:6">Baarihayo omu mikono y'Abanyedomu.<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />N'ahabw'ekyo ndyayohereza omuriro aha rugo rwa Gaaza,</para>
  <para style="q1" vid="AMO 1:7">Gwokyeze kimwe ebikaari byayo,<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />Mmareho abatwire omuri Ashidoodi,</para>
  <para style="q1" vid="AMO 1:8">N'okwaitse enkoni y'obugabe omuri Ashikelooni;</para>
  <para style="q1" vid="AMO 1:8">Ndyabangira Ekurooni omukono gwangye, ngiteere,</para>
  <para style="q1" vid="AMO 1:8">N'Abafilistia abatsigaireho bacwekyerere;</para>
  <para style="m" vid="AMO 1:8">nikwo MUKAMA arikugira.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 1:9">Ahabw'ebicumuro bya Tuuro bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 1:9">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 1:9">Ahabw'okuba bakahayo eihanga ryona omu mikono y'Abanyedomu,</para>
  <para style="q1" vid="AMO 1:9">Tibaijuka ndagaano y'oruganda.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />N'ahabw'ekyo ndyayohereza omuriro aha rugo rwa Tuuro,</para>
  <para style="q1" vid="AMO 1:10">Gwokyeze kimwe ebikaari byayo.<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 137:7">Zab 137:7</ref>; <ref loc="EZK 35:5">Ezk 35:5</ref>; <ref loc="JOL 3:19">Yoel 3:19</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 1:11">Ahabw'ebicumuro bya Edomu bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 1:11">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 1:11">Ahabw'okuba Edomu akabingisa mwene ishe rurara,</para>
  <para style="q1" vid="AMO 1:11">Yaayenaga enyima embabazi ze,</para>
  <para style="q1" vid="AMO 1:11">Ekiniga kye kyaguma nikitaagura,</para>
  <para style="q1" vid="AMO 1:11">Yaaguma agwirwe kubi ebiro byona.<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />N'ahabw'ekyo ndyayohereza omuriro Temani,</para>
  <para style="q1" vid="AMO 1:12">Gwokyeze kimwe ebikaari bya Bozira.<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 49:1-3">Yer 49:1-3</ref>; <ref loc="HOS 13:16">Hos 13:16</ref>; <ref loc="ZEP 2:8">Zef 2:8</ref>, <ref loc="ZEP 2:9">9</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 1:13">Ahabw'ebicumuro by'Abaamoni bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 1:13">Tindibaihaho kifubiro;</para>
  <para style="q1" vid="AMO 1:13">Ahabw'okuba bakafumurana abakazi ba Gileadi baine enda,</para>
  <para style="q1" vid="AMO 1:13">Ngu babone kwirizayo emyatano yaabo.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 21:20">Ezk 21:20</ref>, <ref loc="EZK 21:28">28</ref>. </char>
    </note> N'ahabw'ekyo ndyayohereza omuriro aha rugo rwa Rabba,</para>
  <para style="q1" vid="AMO 1:14">Gwokyeze kimwe ebikaari byayo,</para>
  <para style="q1" vid="AMO 1:14">Habeyo orwari aha izooba ry'orugamba,</para>
  <para style="q1" vid="AMO 1:14">N'eihunga aha izooba ry'omuyaga gw'akasooroora.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />Kandi omugabe waabo aryatwarwa omu bukwatwa,</para>
  <para style="q1" vid="AMO 1:15">We hamwe n'abanyiginya be;</para>
  <para style="m" vid="AMO 1:15">nikwo MUKAMA arikugira.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 15:1-9">Isa 15:1-9</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 2:1">Ahabw'ebicumuro bya Moabu bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 2:1">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 2:1">Ahabw'okuba ekootsya amagufa g'omugabe wa Edomu,</para>
  <para style="q1" vid="AMO 2:1">Yaagagira eiju.<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="JER 48:24">Yer 48:24</ref>. </char>
    </note> N'ahabw'ekyo ndyayohereza omuriro ahari Moabu,</para>
  <para style="q1" vid="AMO 2:2">Gwokyeze kimwe ebikaari bya Keriosi.</para>
  <para style="q1" vid="AMO 2:2">Moabu eryagwa omu ruyombo,</para>
  <para style="q1" vid="AMO 2:2">n'enduuru n'eiraka ry'enzamba.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 48:7">Yer 48:7</ref>. </char>
    </note> Ndyagiihamu omutegyeki,</para>
  <para style="q1" vid="AMO 2:3">Mmwite hamwe n'abanyiginya baayo boona;</para>
  <para style="m" vid="AMO 2:3">nikwo MUKAMA arikugira.<verse eid="AMO 2:3" /></para>
  <para style="s1">Ruhanga okucwera Abayuda n'Abaisraeli orubanja</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:14">Lev 26:14</ref>, <ref loc="LEV 26:15">15</ref>; <ref loc="EZK 20:13">Ezk 20:13</ref>; <ref loc="DAN 9:11">Dan 9:11</ref>; <ref loc="ROM 1:25">Rom 1:25</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 2:4">Ahabw'ebicumuro bya Yuda bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 2:4">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 2:4">Ahabw'okuba bakanga ebiragiro bya MUKAMA,</para>
  <para style="q1" vid="AMO 2:4">Tibaarinda bi yaataireho,</para>
  <para style="q1" vid="AMO 2:4">Kureka ebishuba byabo byabahabya,</para>
  <para style="q1" vid="AMO 2:4">Ebi baishenkurubo baabaire bakuratira.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:27">Yer 17:27</ref>; <ref loc="HOS 8:14">Hos 8:14</ref>. </char>
    </note> N'ahabw'ekyo ndyayohereza omuriro ahari Yuda, Gwokyeze kimwe ebikaari bya Yerusaalemu.<verse eid="AMO 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 8:6">Amo 8:6</ref>; <ref loc="LEV 25:39">Lev 25:39</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 2:6">Ahabw'ebicumuro bya Israeli bishatu n'ahabwa bina,</para>
  <para style="q1" vid="AMO 2:6">Tindigiihaho kifubiro;</para>
  <para style="q1" vid="AMO 2:6">Ahabw'okuba nibatunda abahikiriire efeeza,</para>
  <para style="q1" vid="AMO 2:6">N'abakyene babahinga enkaito.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 5:12">Amo 5:12</ref>; <ref loc="JOB 24:4">Yob 24:4</ref>; <ref loc="ISA 10:2">Isa 10:2</ref>; <ref loc="EZK 22:11">Ezk 22:11</ref>; <ref loc="1CO 5:1">1 Kor 5:1</ref>. </char>
    </note> Nibaribatiirira emitwe y'abooro omu mucuucu,</para>
  <para style="q1" vid="AMO 2:7">Nibakiikamya emihanda y'abacureezi;</para>
  <para style="q1" vid="AMO 2:7">Omushaija na ishe nibaza aha mwishiki omwe,</para>
  <para style="q1" vid="AMO 2:7">Bireetera eiziina ryangye eririkwera kujumwa;<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:26">Kur 22:26</ref>. </char>
    </note> Nibabyama aha rubaju rwa buri itambiro,</para>
  <para style="q1" vid="AMO 2:8">Beeyariire ebijwaro by'omukwato;</para>
  <para style="q1" vid="AMO 2:8">Kandi nibanywera omu nju ya Ruhanga waabo</para>
  <para style="q1" vid="AMO 2:8">Viinyo y'abahongyesiibwe.<verse eid="AMO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />Kandi niinye naacwekyereize Abaamori omu maisho gaabo,</para>
  <para style="q1" vid="AMO 2:9">Abaabaire bari baraingwa nk'emyereezi,</para>
  <para style="q1" vid="AMO 2:9">Kandi bagumire nk'emyela;</para>
  <para style="q1" vid="AMO 2:9">Nkacwekyereza ebyana byabo eruguru</para>
  <para style="q1" vid="AMO 2:9">N'emizi yaabo okuzimu.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:10: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:17">Kur 12:17</ref>, <ref loc="EXO 12:51">51</ref>. </char>
    </note> Kandi niinye naabaihire omu nsi ya Misri,</para>
  <para style="q1" vid="AMO 2:10">Nkamara emyaka makumi ana omu ihamba nimbeebembera,</para>
  <para style="q1" vid="AMO 2:10">Ngu mubone kukubuura ensi y'Abaamori.<verse eid="AMO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:2">Kub 6:2</ref>, <ref loc="NUM 6:3">3</ref>. </char>
    </note> Kandi omuri batabani baanyu nkaimutsyamu baanabi,</para>
  <para style="q1" vid="AMO 2:11">N'omu batsigazi baanyu naihamu Abanaziiri.</para>
  <para style="q1" vid="AMO 2:11">Imwe Baisraeli 'mwe, buzimazima tikwo kiri?</para>
  <para style="qr" vid="AMO 2:11">Nikwo MUKAMA arikugira.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 7:13">Amo 7:13</ref>, <ref loc="AMO 7:16">16</ref>; <ref loc="ISA 30:10">Isa 30:10</ref>. </char>
    </note> Kwonka mukanywaisa Abanaziiri viinyo,</para>
  <para style="q1" vid="AMO 2:12">Na baanabi mwabaragiira muti:</para>
  <para style="q1" vid="AMO 2:12">Mutarihanuura.<verse eid="AMO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />Ndyababandamirira omu mwanya gwanyu,</para>
  <para style="q1" vid="AMO 2:13">Nk'oku ekigaari kibandama kiijwire ebiba.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14, 15: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:1">Amo 9:1</ref>; <ref loc="PSA 33:16">Zab 33:16</ref>, <ref loc="PSA 33:17">17</ref>. </char>
    </note> Empaya-maguru eryabura agahunga,</para>
  <para style="q1" vid="AMO 2:14">N'ow'amaani tariguma nago,</para>
  <para style="q1" vid="AMO 2:14">N'emanzi terikiza magara gaayo.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />Kikwata-buta taryemerera,</para>
  <para style="q1" vid="AMO 2:15">Ow'amaguru taryejuna,</para>
  <para style="q1" vid="AMO 2:15">N'origyendera aha mbaraasi tarikiza magara ge.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />Kandi na rugambwa omu mamanzi</para>
  <para style="q1" vid="AMO 2:16">Ahari eryo izooba aryahunga ajwaire busha;</para>
  <para style="m" vid="AMO 2:16">nikwo MUKAMA arikugira.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">Ruhanga okufubira Israeli</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 2:10">Amo 2:10</ref>; <ref loc="AMO 7:16">7:16</ref>. </char>
    </note> Imwe Baisraeli 'mwe, nimuhurire ekigambo eki, eki MUKAMA agambire naabahana, imwe n'oruganda rwona oru naihire omu nsi ya Misri, ningira nti:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 7:6">Bir 7:6</ref>; <ref loc="PSA 147:19">Zab 147:19</ref>, <ref loc="PSA 147:20">20</ref>; <ref loc="MAT 11:21-23">Mat 11:21-23</ref>; <ref loc="ROM 2:9">Rom 2:9</ref>. </char>
    </note> Omu nganda zoona ez'omu nsi,</para>
  <para style="q1" vid="AMO 3:2">Imwe mwenka niimwe naamanyire;</para>
  <para style="q1" vid="AMO 3:2">Nikyo ndibafubirira</para>
  <para style="q1" vid="AMO 3:2">Ahabw'eby'okushiisha byanyu byona.<verse eid="AMO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />Nimugira ngu abantu babiri nibabaasa kugyenda hamwe</para>
  <para style="q1" vid="AMO 3:3">Bataikirizaine?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />Entare etsindira omu kibira</para>
  <para style="q1" vid="AMO 3:4">Etaine ki eitsire?</para>
  <para style="q1" vid="AMO 3:4">Omugunju gw'entare gururumira ryaya,</para>
  <para style="q1" vid="AMO 3:4">Gutaine ki gukwatsire?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />Enyonyi egwa ahansi omu mutego</para>
  <para style="q1" vid="AMO 3:5">Gutategire?</para>
  <para style="q1" vid="AMO 3:5">Omutego gubarashuka</para>
  <para style="q1" vid="AMO 3:5">Gutaine ki gukwatsire?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:7">Isa 45:7</ref>; <ref loc="EZK 33:3">Ezk 33:3</ref>; <ref loc="MIC 1:12">Mik 1:12</ref>. </char>
    </note> Enzamba ekateererwa omu rurembo,</para>
  <para style="q1" vid="AMO 3:6">Abantu batatiine?</para>
  <para style="q1" vid="AMO 3:6">Akabi kagwa aha rurembo,</para>
  <para style="q1" vid="AMO 3:6">MUKAMA atakareetsire?<verse eid="AMO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 18:17">Kut 18:17</ref>. </char>
    </note> Buzimazima Mukama RUHANGA takora kintu kyona,</para>
  <para style="q1" vid="AMO 3:7">Atabandize kukishuuruurira bairu be baanabi.<verse eid="AMO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 22:36">Kub 22:36</ref>. </char>
    </note> Entare etsinzire;</para>
  <para style="q1" vid="AMO 3:8">Mbwenu n'oha otarikwija kutiina?</para>
  <para style="q1" vid="AMO 3:8">Mukama RUHANGA agambire;</para>
  <para style="q1" vid="AMO 3:8">N'oha orikubaasa kwezibira kuhanuura?<verse eid="AMO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:9: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 16:24">1 Bag 16:24</ref>; <ref loc="1KI 21:1-16">21:1-16</ref>. </char>
    </note> Murangire omu bikaari bya Ashidoodi</para>
  <para style="q1" vid="AMO 3:9">N'omu bikaari by'omu nsi ya Misri,</para>
  <para style="q1" vid="AMO 3:9">Nimugira muti: Mweteeranire omu bibungo bya Samaria,</para>
  <para style="q1" vid="AMO 3:9">Mureebe okujagarara kwingi okuriyo,</para>
  <para style="q1" vid="AMO 3:9">N'eby'okuhata ebigirimu.<verse eid="AMO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:14">Isa 3:14</ref>, <ref loc="ISA 3:15">15</ref>; <ref loc="MIC 6:10-12">Mik 6:10-12</ref>. </char>
    </note> MUKAMA naagira ati:</para>
  <para style="q1" vid="AMO 3:10">Ababiika obubisha n'obwambuzi omu bikaari byabo</para>
  <para style="q1" vid="AMO 3:10">Tibamanya kukora bihikire.<verse eid="AMO 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 3:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 17:5">2 Bag 17:5</ref>, <ref loc="2KI 17:6">6</ref>; <ref loc="ISA 39:6">Isa 39:6</ref>. </char>
    </note> Nikyo Mukama RUHANGA arikugirira ati:</para>
  <para style="q1" vid="AMO 3:11">Omuzigu aryayehinguririza ensi,</para>
  <para style="q1" vid="AMO 3:11">Asheenye engo zaawe ezirikukurinda,</para>
  <para style="q1" vid="AMO 3:11">N'ebikaari byawe binyagwe.<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:13">Kur 22:13</ref>. </char>
    </note> Oku nikwo MUKAMA arikugamba naagira ati: Nk'oku omuriisa asikura amaguru abiri nari ekicweka ky'okutu omu kanwa k'entare, n'abantu abatwire Samaria abagaramisiriize omu keehogo k'ekitabo, n'aha mishego y'ekitanda ya riiri, nikwo barijunwa.<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 50:7">Zab 50:7</ref>. </char>
    </note> Mukama RUHANGA, Ruhanga ow'amahe naagira ati:</para>
  <para style="q1" vid="AMO 3:13">Nimuhurire, mushinje enju ya Yakobo;<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:14: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 13:1-3">1 Bag 13:1-3</ref>; <ref loc="HOS 10:15">Hos 10:15</ref>. </char>
    </note> Ahabw'okuba eizooba eri ndifubiriraho Israeli ahabw'ebicumuro bye,</para>
  <para style="q1" vid="AMO 3:14">Ndyafubiriraho n'amatambiro ga Beseeli,</para>
  <para style="q1" vid="AMO 3:14">Kandi amahembe g'eitambiro garyatemwaho,</para>
  <para style="q1" vid="AMO 3:14">Gagwe ahansi.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:15: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 3:20">Bar 3:20</ref>; <ref loc="1KI 22:39">1 Bag 22:39</ref>; <ref loc="JER 36:22">Yer 36:22</ref>. </char>
    </note> Enju y'omuri katumba ndyagisheenya hamwe n'ey'omu kyanda;</para>
  <para style="q1" vid="AMO 3:15">N'amaju g'emiino y'enjojo garyahwerekyerera,</para>
  <para style="q1" vid="AMO 3:15">Kandi na zaanyaruju ziryahwaho;</para>
  <para style="m" vid="AMO 3:15">nikwo MUKAMA arikugira.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">Oku emigyenzo y'ediini etari y'amazima erikugwisa kubi Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />Nimuhurire ekigambo eki, imwe nte za Bashani 'mwe,</para>
  <para style="q1" vid="AMO 4:1">Eziri omu kibungo kya Samaria,</para>
  <para style="q1" vid="AMO 4:1">Ezirikuhata abooro, zikasingyera abakyene,</para>
  <para style="q1" vid="AMO 4:1">Ezirikugira engundu zaazo ziti:</para>
  <para style="q1" vid="AMO 4:1">Mureete eby'okunywa, tunywe.<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:2: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 19:28">2 Bag 19:28</ref>; <ref loc="PSA 89:35">Zab 89:35</ref>; <ref loc="JER 16:16">Yer 16:16</ref>. </char>
    </note> Mukama RUHANGA arahiire okwera kwe, naagira ati:</para>
  <para style="q1" vid="AMO 4:2">Ebiro nibiija kubahikaho,</para>
  <para style="q1" vid="AMO 4:2">Obu baribatwaza amarobo,</para>
  <para style="q1" vid="AMO 4:2">Bakatwaza abarihereeruka omuriimwe</para>
  <para style="q1" vid="AMO 4:2">Amarobo g'okutega eby'enyanja.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />Kandi muryashohorera ahasheenyirwe,</para>
  <para style="q1" vid="AMO 4:3">Buri mukazi naatora ei agyemire;</para>
  <para style="q1" vid="AMO 4:3">Kandi muryanagwa omuri Harumooni</para>
  <para style="m" vid="AMO 4:3">nikwo MUKAMA arikugira.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 28:3">Kub 28:3</ref>, <ref loc="NUM 28:4">4</ref>; <ref loc="EZK 20:39">Ezk 20:39</ref>; <ref loc="HOS 4:15">Hos 4:15</ref>. </char>
    </note> Nimwije Beseeli, mucumure;</para>
  <para style="q1" vid="AMO 4:4">Mwije Gilugaali, mukanyise ebicumuro;</para>
  <para style="q1" vid="AMO 4:4">Mureete ebitambo byanyu buri kasheeshe,</para>
  <para style="q1" vid="AMO 4:4">N'ebicweka byanyu bya kimwe kya ikumi buri biro bishatu;<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 7:13">Lev 7:13</ref>; <ref loc="LEV 22:18">22:18</ref>, <ref loc="LEV 22:21">21</ref>; <ref loc="PSA 81:11">Zab 81:11</ref>, <ref loc="PSA 81:12">12</ref>. </char>
    </note> Muhongye empongano zaanyu z'okusiima, zirimu ekitumbisa,</para>
  <para style="q1" vid="AMO 4:5">Kandi murangye empongano ezi muhonga mwekundiire,</para>
  <para style="q1" vid="AMO 4:5">Muzirangaane hoona;</para>
  <para style="q1" vid="AMO 4:5">Ahakuba ebyo nibyo mwenda, imwe Baisraeli 'mwe;</para>
  <para style="m" vid="AMO 4:5">nikwo Mukama RUHANGA arikugira.<verse eid="AMO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:57">Bir 28:57</ref>; <ref loc="JER 15:7">Yer 15:7</ref>. </char>
    </note> Nkababuza eky'okutamira omu ndembo zaanyu zoona,</para>
  <para style="q1" vid="AMO 4:6">Amaino gaanyu gaaguma nigeera, ahu mutwire hoona;</para>
  <para style="q1" vid="AMO 4:6">Kwonka nabwo timwangarukira;</para>
  <para style="m" vid="AMO 4:6">nikwo MUKAMA arikugira.<verse eid="AMO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 3:3">Yer 3:3</ref>. </char>
    </note> Kandi nkabaima enjura,</para>
  <para style="q1" vid="AMO 4:7">Hatsigaire ameezi ashatu eigyesha kuhika.</para>
  <para style="q1" vid="AMO 4:7">Obundi nkaba ngwisiza orurembo rumwe enjura,</para>
  <para style="q1" vid="AMO 4:7">Orundi ndugiima;</para>
  <para style="q1" vid="AMO 4:7">Omusiri gumwe guguubwamu enjura,</para>
  <para style="q1" vid="AMO 4:7">Ogu etaagwamu gwoma.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />N'ahabw'ekyo ab'omu ndembo ibiri nari ishatu</para>
  <para style="q1" vid="AMO 4:8">Bakaba bazegyerera omu rurembo rumwe</para>
  <para style="q1" vid="AMO 4:8">Kunywa amaizi, babura kuhwa eiriho;</para>
  <para style="q1" vid="AMO 4:8">Kwonka nabwo timwangarukira;</para>
  <para style="m" vid="AMO 4:8">nikwo MUKAMA arikugira.<verse eid="AMO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:9: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:22">Bir 28:22</ref>; <ref loc="JOL 1:4">Yoel 1:4</ref>; <ref loc="HAG 2:17">Hag 2:17</ref>. </char>
    </note> Nkabateeza okubabuka n'okusya-nyamwenga,</para>
  <para style="q1" vid="AMO 4:9">Naacwekyereza emisiri yaanyu n'ey'emizaabibu;</para>
  <para style="q1" vid="AMO 4:9">Emitiini yaanyu n'emizeituuni yaanyu yaariibwa enzigye;</para>
  <para style="q1" vid="AMO 4:9">Kwonka nabwo timwangarukira;</para>
  <para style="m" vid="AMO 4:9">nikwo MUKAMA arikugira.<verse eid="AMO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:27">Bir 28:27</ref>, <ref loc="DEU 28:60">60</ref>; <ref loc="2KI 13:7">2 Bag 13:7</ref>; <ref loc="PSA 78:50">Zab 78:50</ref>; <ref loc="JOL 2:20">Yoel 2:20</ref>. </char>
    </note> Nkabooherereza orufu nk'orwa Misri,</para>
  <para style="q1" vid="AMO 4:10">Naitsa abatsigazi baanyu rurara,</para>
  <para style="q1" vid="AMO 4:10">Naanyaga embaraasi zaanyu,</para>
  <para style="q1" vid="AMO 4:10">Enyindo zaanyu naaziitsa ekinuuko ky'orusisiira rwanyu;</para>
  <para style="q1" vid="AMO 4:10">Kwonka nabwo timwangarukira;</para>
  <para style="m" vid="AMO 4:10">nikwo MUKAMA arikugira.<verse eid="AMO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:11: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 3:2">Zek 3:2</ref>; <ref loc="JUD 1:23">Yud 23</ref>. </char>
    </note> Nkajuumika endembo zaanyu,</para>
  <para style="q1" vid="AMO 4:11">Nk'oku Ruhanga yaajuumikire Sodoma na Gomora.</para>
  <para style="q1" vid="AMO 4:11">Mwaba nk'ekicumurwa kiihirwe omu muriro;</para>
  <para style="q1" vid="AMO 4:11">Kwonka nabwo hoona timurangarukiire;</para>
  <para style="m" vid="AMO 4:11">nikwo MUKAMA arikugira.<verse eid="AMO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />Nikyo ndikugirira ntyo, iwe Israeli,</para>
  <para style="q1" vid="AMO 4:12">N'ahabw'ekyo yeteekateekye kubugabugana na Ruhanga waawe, iwe Israeli;</para>
  <para style="q1" vid="AMO 4:12">ahabw'okuba niinyija kukugira ntyo.<verse eid="AMO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:2">Zab 139:2</ref>; <ref loc="JER 10:16">Yer 10:16</ref>; <ref loc="AMO 5:8">Amo 5:8</ref>; <ref loc="MIC 1:3">Mik 1:3</ref>. </char>
    </note> Ahakuba reeba, Obumba enshozi, akahanga omuyaga,</para>
  <para style="q1" vid="AMO 4:13">Akagambira omuntu ebiteekateeko bye,</para>
  <para style="q1" vid="AMO 4:13">Kandi Ohindura akasheeshe omwirima,</para>
  <para style="q1" vid="AMO 4:13">Akagyendagyenda aha mitwe y'ebibungo by'omu nsi,</para>
  <para style="q1" vid="AMO 4:13">MUKAMA Ruhanga ow'amahe, niryo iziina rye.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">Oku Abaisraeli bashemereire kweteisa n'okusherura Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 19:1">Ezk 19:1</ref>. </char>
    </note> Iwe nju ya Israeli 'we, hurira ekigambo eki,</para>
  <para style="q1" vid="AMO 5:1">Eki ndikugamba ninkutongyeza;<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:2: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 2:1">Tonz 2:1</ref>. </char>
    </note> Israeli omwishiki oshugaine agwire,</para>
  <para style="q1" vid="AMO 5:2">Kandi tarigaruka kwimuka;</para>
  <para style="q1" vid="AMO 5:2">Atsigirwe omu nsi ye,</para>
  <para style="q1" vid="AMO 5:2">Haabura ow'okumwimutsya.<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />Ahakuba oku nikwo Mukama RUHANGA arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 5:3">Orurembo orwahurwirwemu engabo rukumi,</para>
  <para style="q1" vid="AMO 5:3">Haryatabaarukaho igana;</para>
  <para style="q1" vid="AMO 5:3">N'orwahurwirwemu igana,</para>
  <para style="q1" vid="AMO 5:3">Haryatabaarukaho ikumi</para>
  <para style="q1" vid="AMO 5:3">Eziritsigara aha nju ya Israeli.<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:4: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 15:3">2 Bus 15:3</ref>; <ref loc="ZEP 2:3">Zef 2:3</ref>. </char>
    </note> Oku nikwo MUKAMA arikugira enju ya Israeli ati:</para>
  <para style="q1" vid="AMO 5:4">Munsherure, mubone kugumaho;<verse eid="AMO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 4:4">Amo 4:4</ref>; <ref loc="AMO 8:14">8:14</ref>. </char>
    </note> Kwonka mutasherura Beseeli,</para>
  <para style="q1" vid="AMO 5:5">Mutataaha omuri Gilugaali,</para>
  <para style="q1" vid="AMO 5:5">N'obu kwakuba okwambuka Beeri-sheba;</para>
  <para style="q1" vid="AMO 5:5">Ahabw'okuba buzimazima Gilugaali eryaza omu bukwatwa,</para>
  <para style="q1" vid="AMO 5:5">Na Beseeli eryahinduka busha.<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />Musherure MUKAMA, mubone kugumaho,</para>
  <para style="q1" vid="AMO 5:6">Atakaimuka omu nju ya Yosefu nk'omuriro,</para>
  <para style="q1" vid="AMO 5:6">Gukagyenda nigurya busha, hakabura ow'okuguraariza omuri Beseeli,<verse eid="AMO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />Imwe abarikuhindura eby'oburyo omuravunga,</para>
  <para style="q1" vid="AMO 5:7">Mukanaga ahansi okuhikiirira!<verse eid="AMO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:8: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 4:13">Amo 4:13</ref>; <ref loc="AMO 9:6">9:6</ref>; <ref loc="JOB 9:9">Yob 9:9</ref>; <ref loc="JOB 38:31">38:31</ref>; <ref loc="PSA 104:6">Zab 104:6</ref>, <ref loc="PSA 104:7">7</ref>, <ref loc="PSA 104:20">20</ref>. </char>
    </note> Owaahangire enyonyoozi za Kakaaga na za Orioni,</para>
  <para style="q1" vid="AMO 5:8">Ohindura omwirima ndindindi akasheeshe,</para>
  <para style="q1" vid="AMO 5:8">Akahindura nyomushana ekiro,</para>
  <para style="q1" vid="AMO 5:8">Otuma amaizi g'omu nyanja</para>
  <para style="q1" vid="AMO 5:8">Akagashandaaza ahansi,</para>
  <para style="q1" vid="AMO 5:8">MUKAMA niryo iziina rye,<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />Oreetera ab'amaani kucwekyerera kitaraariire,</para>
  <para style="q1" vid="AMO 5:9">Okucwekyerera kukahika aha kigo kigumire.<verse eid="AMO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10: </char>
      <char style="xt" closed="false">
        <ref loc="RUT 4:1">Rus 4:1</ref>; <ref loc="1KI 22:8">1 Bag 22:8</ref>; <ref loc="ISA 29:21">Isa 29:21</ref>. </char>
    </note> Orikubahanira omu irembo nibamwanga,</para>
  <para style="q1" vid="AMO 5:10">Kandi nibatamwa orikugamba amazima.<verse eid="AMO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:11: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:30">Bir 28:30</ref>, <ref loc="DEU 28:39">39</ref>; <ref loc="JAS 2:6">Yak 2:6</ref>. </char>
    </note> N'ahabw'ekyo, ahabw'okuribatiirira abooro,</para>
  <para style="q1" vid="AMO 5:11">Mukabatoijesa engano,</para>
  <para style="q1" vid="AMO 5:11">Mweyombekyeire amaju g'amabaare gabaizire,</para>
  <para style="q1" vid="AMO 5:11">Kwonka timurigataahamu.</para>
  <para style="q1" vid="AMO 5:11">Mwebyariire emisiri mirungi y'emizaabibu,</para>
  <para style="q1" vid="AMO 5:11">Kwonka timurinywa viinyo yaayo.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 2:7">Amo 2:7</ref>; <ref loc="1SA 8:3">1 Sam 8:3</ref>; <ref loc="1SA 12:3">12:3</ref>. </char>
    </note> Ahabw'okuba nimmanya ebicumuro byanyu ku biri bingi,</para>
  <para style="q1" vid="AMO 5:12">N'ebibi byanyu ku birengyesereize,</para>
  <para style="q1" vid="AMO 5:12">Imwe abarikubonabonesa abahikiriire, mukarya enguzi,</para>
  <para style="q1" vid="AMO 5:12">Kandi abakyene mukabateereza enkokora omu irembo.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:13: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 2:3">Mik 2:3</ref>. </char>
    </note> Nikyo orikwerinda aricecekyera omu bunaku nk'obu,</para>
  <para style="q1" vid="AMO 5:13">Ahabw'okuba n'obunaku bubi.<verse eid="AMO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 30:15">Bir 30:15</ref>, <ref loc="DEU 30:19">19</ref>. </char>
    </note> Musherure ebirungi, t'ebibi,</para>
  <para style="q1" vid="AMO 5:14">Mubone kugumaho;</para>
  <para style="q1" vid="AMO 5:14">Obo nibwo MUKAMA, Ruhanga ow'amahe,</para>
  <para style="q1" vid="AMO 5:14">Ariguma naimwe, nk'oku mugambire.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:15: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:14">Yoel 2:14</ref>; <ref loc="ROM 12:9">Rom 12:9</ref>. </char>
    </note> Mwangye ebibi, mukunde ebirungi,</para>
  <para style="q1" vid="AMO 5:15">Muhamye eby'oburyo omu irembo;</para>
  <para style="q1" vid="AMO 5:15">Obundi MUKAMA, Ruhanga ow'amahe,</para>
  <para style="q1" vid="AMO 5:15">Akaagirira embabazi aba Yosefu abatsigaireho.<verse eid="AMO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 5:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:17">Yer 9:17</ref>, <ref loc="JER 9:18">18</ref>. </char>
    </note> N'ahabw'ekyo, oku nikwo MUKAMA Ruhanga ow'amahe,</para>
  <para style="q1" vid="AMO 5:16">Mukama arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 5:16">Omu nteeraniro z'enguuto zoona haryabamu okuborooga,</para>
  <para style="q1" vid="AMO 5:16">N'omu nguuto zoona baryacura bati: Ai bambe! Ai bambe!</para>
  <para style="q1" vid="AMO 5:16">Baryatuma aha bahingi kwija omu rufu,</para>
  <para style="q1" vid="AMO 5:16">N'abarikumanya kutonzya kwija kucura;<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:17: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:12">Kur 12:12</ref>. </char>
    </note> N'omu misiri y'emizaabibu yoona haryabamu okuborooga,</para>
  <para style="q1" vid="AMO 5:17">Ahabw'okuba ndyaraba ahagati omuriimwe;</para>
  <para style="m" vid="AMO 5:17">nikwo MUKAMA arikugira.<verse eid="AMO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:18: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 1:15">Yoel 1:15</ref>; <ref loc="JOL 2:1">2:1</ref>, <ref loc="JOL 2:2">2</ref>. </char>
    </note> Imwe abarikwetenga eizooba rya MUKAMA, muryakareeba!</para>
  <para style="q1" vid="AMO 5:18">Mbwenu eryo izooba rya MUKAMA nimuryendera ki?</para>
  <para style="q1" vid="AMO 5:18">N'ery'omwirima, ti ry'omushana;<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:19: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:18">Isa 24:18</ref>. </char>
    </note> Ni nk'oku omuntu yaakuhunga entare,</para>
  <para style="q1" vid="AMO 5:19">Akabugana edubu;</para>
  <para style="q1" vid="AMO 5:19">Nari nk'owaakuza omu nju, akeegamiza omukono aha kisiika,</para>
  <para style="q1" vid="AMO 5:19">Enjoka ekamuruma.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />Eryo izooba rya MUKAMA t'omwirima, n'omushana,</para>
  <para style="q1" vid="AMO 5:20">T'omwirima ogutarimu kuhweza kwona?<verse eid="AMO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:21, 22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 51:16">Zab 51:16</ref>; <ref loc="ISA 1:11">Isa 1:11</ref>, <ref loc="ISA 1:14">14</ref>. </char>
    </note> Nyanga amagyenyi gaanyu, ningagaya,</para>
  <para style="q1" vid="AMO 5:21">Kandi tindikushemerererwa kuteerana kwanyu okurikwera na kakye.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />N'obu murampongyere ebitambo byanyu eby'okwotsya,</para>
  <para style="q1" vid="AMO 5:22">N'empongano zaanyu z'esaano,</para>
  <para style="q1" vid="AMO 5:22">Tindikwija kubyakiira,</para>
  <para style="q1" vid="AMO 5:22">Kandi tindikwija kweta ha mpongano zaanyu</para>
  <para style="q1" vid="AMO 5:22">Ez'ente zaanyu z'ebishaju ez'okusiima ahabw'obusingye.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:23: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 8:3">Amo 8:3</ref>. </char>
    </note> Nimuunyiheho orwari rw'ebyeshongoro byanyu;</para>
  <para style="q1" vid="AMO 5:23">Tindikwija kutega kutu okujumeera kw'enanga zaanyu.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />Kureka murekye eby'oburyo bihimintikye nk'amaizi,</para>
  <para style="q1" vid="AMO 5:24">N'okuhikiirira nk'omugyera ogutarikwoma.<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:25-27: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:42">Byak 7:42</ref>, <ref loc="ACT 7:43">43</ref>. </char>
    </note> Imwe b'enju ya Israeli 'mwe, niinye mwabaire muhongyera ebitambo n'empongano omuri egyo myaka makumi ana, muri omu ihamba? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" /><note caller="-" style="x"><char style="xo" closed="false">5:26: </char><char style="xt" closed="false"><ref loc="DEU 32:17">Bir 32:17</ref>; <ref loc="ISA 46:7">Isa 46:7</ref>. </char></note> Mukaheeka ekishushani kya Sukooti omugabe waanyu, n'ekya Kiuni, enyonyoozi ya ruhanga waanyu, ebishushani ebi mwayebaijeire; <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" /><note caller="-" style="x"><char style="xo" closed="false">5:27: </char><char style="xt" closed="false"><ref loc="2KI 17:6">2 Bag 17:6</ref>. </char></note> nikyo ndibatwarira omu bukwatwa seeri ya Damasiko; nikwo MUKAMA arikugira, ou eiziina rye riba Ruhanga ow'amahe.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">Ebifubiro bigumire ebiriija ahabw'ebibi byabo</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 32:9">Isa 32:9</ref>; <ref loc="EZK 22:6">Ezk 22:6</ref>; <ref loc="ZEP 1:12">Zef 1:12</ref>; <ref loc="LUK 6:24">Luk 6:24</ref>. </char>
    </note> Baryakareeba, abagaramisiriize omuri Saayuuni,</para>
  <para style="q1" vid="AMO 6:1">N'abatwire omu kibungo kya Samaria bataine ki beeteireho,</para>
  <para style="q1" vid="AMO 6:1">Abakungu b'amahanga makuru agarikukira agandi,</para>
  <para style="q1" vid="AMO 6:1">Agu ab'enju ya Israeli baijaho!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 10:9">Isa 10:9</ref>. </char>
    </note> Mwambukye Kalune, mureebe;</para>
  <para style="q1" vid="AMO 6:2">Murugyeyo, muze Hamasi enkuru;</para>
  <para style="q1" vid="AMO 6:2">Bwanyima mushuume Gaasi ey'Abafilistia.</para>
  <para style="q1" vid="AMO 6:2">Nimugira ngu nizihita ezi nsi z'obugabe?</para>
  <para style="q1" vid="AMO 6:2">Nari shi ensi yaazo neekira eyaanyu obuhango,<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:3: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 9:10">Amo 9:10</ref>; <ref loc="EZK 12:27">Ezk 12:27</ref>. </char>
    </note> Imwe abata hare eizooba ribi,</para>
  <para style="q1" vid="AMO 6:3">Mukairiza haihi ekitebe ky'obubisha?<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4: </char>
      <char style="xt" closed="false">
        <ref loc="EST 1:6">Est 1:6</ref>; <ref loc="JAS 5:5">Yak 5:5</ref>. </char>
    </note> Baryakareeba, ababyama aha bitanda by'emiino y'enjojo,</para>
  <para style="q1" vid="AMO 6:4">Bakeegororera aha bitabo byabo,</para>
  <para style="q1" vid="AMO 6:4">Bakarya ebyana by'entaama, nibabiiha omu busyo,</para>
  <para style="q1" vid="AMO 6:4">N'ebinyana ebi barikwiha omu kihongore,<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5, 6: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:12">Isa 5:12</ref>. </char>
    </note> Abeeshongorera aha nanga ebyeshongoro bitaine buryo,</para>
  <para style="q1" vid="AMO 6:5">Bakeegunzira ebirikuteerwa nka Daudi,<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />Abanywera amaarwa aha bishare,</para>
  <para style="q1" vid="AMO 6:6">Bakeesiiga amajuta marungi munonga;</para>
  <para style="q1" vid="AMO 6:6">Kwonka batasaasibwe kucwekyerera kwa Yosefu!<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:7: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 7:11">Amo 7:11</ref>, <ref loc="AMO 7:17">17</ref>. </char>
    </note> Nikyo baribandiriza abandi kutwarwa omu bukwatwa,</para>
  <para style="q1" vid="AMO 6:7">Kandi okweshemeza kw'abarikwenanuura kukahwaho.<verse eid="AMO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 6:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:8: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 47:4">Zab 47:4</ref>; <ref loc="JER 51:14">Yer 51:14</ref>. </char>
    </note> Mukama RUHANGA ayerahiire!</para>
  <para style="q1" vid="AMO 6:8">MUKAMA, Ruhanga ow'amahe, naagira ati:</para>
  <para style="q1" vid="AMO 6:8">Ntamirwe amaryo ga Yakobo,</para>
  <para style="q1" vid="AMO 6:8">Ebigo bye ebigumire nimbyanga;</para>
  <para style="q1" vid="AMO 6:8">Kandi ndyahayo oru rurembo n'ebirimu byona.<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:9: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 8:3">Amo 8:3</ref>. </char>
    </note> Kandi omu nju emwe ku hatsigaramu abantu ikumi, baryafa. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" /><note caller="-" style="x"><char style="xo" closed="false">6:10: </char><char style="xt" closed="false"><ref loc="AMO 5:13">Amo 5:13</ref>; <ref loc="2CH 16:14">2 Bus 16:14</ref>. </char></note> N'oine obuzaare n'omuntu omwe ahari abo, ku ariija kumwotsya, aryamutwara kwiha amagufa omu nju, abuuze ori omu kishengye ati: Hakiriho ondiijo okiri hamwe naiwe? Onu amugarukyemu ati: Ngaaha! Ori amugira ati: Hunama! Titushemereire kugamba aha iziina rya MUKAMA.<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:11: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 3:15">Amo 3:15</ref>. </char>
    </note> Ahakuba reeba, MUKAMA naaragiira,</para>
  <para style="q1" vid="AMO 6:11">Enju mpango neija kusheenywa,</para>
  <para style="q1" vid="AMO 6:11">N'enkye esheenyagurwe.<verse eid="AMO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:12: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 5:7">Amo 5:7</ref>. </char>
    </note> Embaraasi ziiruka aha nkiri?</para>
  <para style="q1" vid="AMO 6:12">Omuntu ahingisa ente enyanja?</para>
  <para style="q1" vid="AMO 6:12">Kwonka imwe eby'oburyo mubihindwire endurwe,</para>
  <para style="q1" vid="AMO 6:12">N'ebyana by'okuhikiirira mwabihindura omuravunga,<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:13: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 22:11">1 Bag 22:11</ref>. </char>
    </note> Imwe abashemerererwa Lodebaari,</para>
  <para style="q1" vid="AMO 6:13">Mukagira ngu mukwatsire Karunaimu ahabw'amaani gaanyu.<verse eid="AMO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 14:25">2 Bag 14:25</ref>; <ref loc="JER 5:15">Yer 5:15</ref>. </char>
    </note> Ahakuba reeba, ndyaimutsya eihanga, ribarwanise,</para>
  <para style="q1" vid="AMO 6:14">Imwe b'enju ya Israeli 'mwe;</para>
  <para style="q1" vid="AMO 6:14">Ribabonabonese okuruga aharikutaahirwa Hamasi,</para>
  <para style="q1" vid="AMO 6:14">Okuhika aha kagyera k'omuri Araba;</para>
  <para style="m" vid="AMO 6:14">nikwo MUKAMA, Ruhanga ow'amahe, arikugira.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">Ekifubiro ky'omuzinga gw'enzigye</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />Eki nikyo Mukama RUHANGA yaanyorekire; reeba, akaba naakanyisa omuzinga gw'enzigye; obwo oruhiira nirutandika kumera, kandi orwo ruhiira n'orwamezire, obunyaatsi bw'omugabe buherize kutemwa. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />Ku zaaherize kurya obunyaatsi omu nsi, naagira nti:</para>
  <para style="q1" vid="AMO 7:2">Ai Mukama RUHANGA, ninkweshengyereza, gira embabazi!</para>
  <para style="q1" vid="AMO 7:2">Yakobo naabaasa ata kugumaho,</para>
  <para style="q1" vid="AMO 7:2">Haza ari mukye?<verse eid="AMO 7:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="AMO 7:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:3: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:13">Yoel 2:13</ref>. </char>
    </note> MUKAMA nikwo kwegarukamu ahabw'ekyo, akagira ati: Tikiribaho.<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:4: </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:7">Kush 8:7</ref>, <ref loc="REV 8:8">8</ref>. </char>
    </note> Kandi eki nikyo Mukama RUHANGA yaanyorekire; reeba Mukama RUHANGA akaba naayeta omuriro kugucwisa orubanja, gwamaraho enyanja mpango, kandi gukaba niguza kumaraho n'ensi. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />Bwanyima naagira nti:</para>
  <para style="q1" vid="AMO 7:5">Ai Mukama RUHANGA, ninkweshengyereza, rekyera aho!</para>
  <para style="q1" vid="AMO 7:5">Yakobo naabaasa ata kugumaho,</para>
  <para style="q1" vid="AMO 7:5">Haza ari mukye?<verse eid="AMO 7:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="AMO 7:6" />MUKAMA nikwo kwegarukamu ahabw'ekyo; Mukama RUHANGA akagira ati: N'ekyo tikiribaho.<verse eid="AMO 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:7: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 21:13">2 Bag 21:13</ref>. </char>
    </note> Kandi eki nakyo nikyo yaanyorekire; reeba Mukama akaba ayemereire aha rugo rw'amabaare orwombekyesiibwe kariisho, aine kariisho omu ngaro. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />MUKAMA yambuuza ati: Iwe Amosi, nooreeba ki? Naamugarukamu nti: Nindeeba kariisho. MUKAMA nikwo kugira ati: Reeba, ninta kariisho omu bantu bangye Israeli; tindibasaasira bundi; <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" /><note caller="-" style="x"><char style="xo" closed="false">7:9: </char><char style="xt" closed="false"><ref loc="GEN 26:25">Kut 26:25</ref>; <ref loc="2KI 15:8-12">2 Bag 15:8-12</ref>. </char></note> emyanya mikuru ya Isaaka ey'okuramizamu eryahinduka ebifurukwa, n'emyanya ya Israeli erikwera esheenywe; kandi ndyaimuka ndwanise enju ya Yeroboamu na rurara.<verse eid="AMO 7:9" /></para>
  <para style="s1">Amazia okurega Amosi</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:10: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 12:32">1 Bag 12:32</ref>; <ref loc="JER 38:4">Yer 38:4</ref>. </char>
    </note> Bwanyima Amazia omunyamurwa wa Beseeli yaatuma ahari Yeroboamu omugabe wa Israeli, naagira ati: Amosi akugiriire enaama y'okukukora kubi ahagati y'Abaisraeli; kandi ensi yaitu terikubaasa kugumisiririza bigambo bye byona. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />Ahakuba oku nikwo Amosi arikugamba naagira ati:</para>
  <para style="q1" vid="AMO 7:11">Yeroboamu aryaitwa rurara,</para>
  <para style="q1" vid="AMO 7:11">Na Israeli aihwe omu nsi ye, atwarwe omu bukwatwa.<verse eid="AMO 7:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="AMO 7:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:12: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:1">Amo 1:1</ref>; <ref loc="1SA 9:9">1 Sam 9:9</ref>. </char>
    </note> Bwanyima Amazia yaagira Amosi ati: Iwe muhanuuzi 'we, irooko ohungire omu nsi ya Yuda, obe niyo waahwera omushumi, ohanuurireyo; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" /><note caller="-" style="x"><char style="xo" closed="false">7:13: </char><char style="xt" closed="false"><ref loc="AMO 2:12">Amo 2:12</ref>. </char></note> kwonka otagaruka kuhanuurira Beseeli, ahakuba n'omwanya gw'omugabe ogurikwera, kandi ni nyaruju y'obugabe.<verse eid="AMO 7:13" /></para>
  <para style="s1">Amosi okwetonganira</para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:14: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 13:5">Zek 13:5</ref>. </char>
    </note> Amosi yaagarukamu Amazia ati: Nkaba ntari nabi nari mwana wa nabi; kureka nkaba ndi omuriisa, kandi omusharizi w'emisikamoori. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" /><note caller="-" style="x"><char style="xo" closed="false">7:15: </char><char style="xt" closed="false"><ref loc="PSA 78:71">Zab 78:71</ref>; <ref loc="EZK 6:2">Ezk 6:2</ref>. </char></note> Bwanyima MUKAMA yanyiha omu kuriisa amatungo, yangira ati: Irooko ohanuurire abantu bangye Israeli.<verse eid="AMO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 7:16" />Mbwenu hurira ekigambo kya MUKAMA.</para>
  <para style="q1" vid="AMO 7:16">Noogira oti: Otahanuurira Israeli ebirigibaho,</para>
  <para style="q1" vid="AMO 7:16">Kandi otagamba ekigambo kyona eky'okuhana enju ya Isaaka.<verse eid="AMO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 7:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">7:17: </char>
      <char style="xt" closed="false">
        <ref loc="JER 28:16">Yer 28:16</ref>; <ref loc="JER 29:21">29:21</ref>, <ref loc="JER 29:31">31</ref>. </char>
    </note> Nikyo MUKAMA arikugirira ati:</para>
  <para style="q1" vid="AMO 7:17">Omukazi waawe aryaba maraaya omuri oru rurembo,</para>
  <para style="q1" vid="AMO 7:17">Batabani baawe na bahara baawe baryaitwa rurara,</para>
  <para style="q1" vid="AMO 7:17">Kandi ensi yaawe eryabaganisisibwa omugoye;</para>
  <para style="q1" vid="AMO 7:17">Naiwe oryagwa omu nsi etashemeire,</para>
  <para style="q1" vid="AMO 7:17">Kandi buzimazima Israeli aryaihwa omu nsi ye</para>
  <para style="q1" vid="AMO 7:17">Atwarwe omu bukwatwa.<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">Akamanyiso k'ekiibo ekirimu ebijuma by'ekyanda</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />Eki nikyo Mukama RUHANGA yaanyorekire. Nkareeba ekiibo ky'ebijuma by'omu kyanda. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" /><note caller="-" style="x"><char style="xo" closed="false">8:2: </char><char style="xt" closed="false"><ref loc="JER 24:1">Yer 24:1</ref>; <ref loc="LAM 4:18">Tonz 4:18</ref>; <ref loc="MIC 7:1">Mik 7:1</ref>. </char></note> Yangira ati: Iwe Amosi, nooreeba ki? Naamugarukamu nti: Nindeeba ekiibo ky'ebijuma by'omu kyanda. MUKAMA nikwo kungira ati:</para>
  <para style="q1" vid="AMO 8:2">Omuheru gw'abantu bangye Israeli gwahika;</para>
  <para style="q1" vid="AMO 8:2">Tindibasaasira bundi.<verse eid="AMO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 8:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:3: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 5:23">Amo 5:23</ref>; <ref loc="AMO 6:9">6:9</ref>, <ref loc="AMO 6:10">10</ref>; <ref loc="JER 16:4">Yer 16:4</ref>, <ref loc="JER 16:6">6</ref>. </char>
    </note> Eryo izooba ebyeshongoro by'omuri hekalu</para>
  <para style="q1" vid="AMO 8:3">Biryahinduka okuborooga;</para>
  <para style="q1" vid="AMO 8:3">Emitumbi y'abafu eryaba mingi,</para>
  <para style="q1" vid="AMO 8:3">Abantu baginaganagye hoona, bari omu kaceceko;</para>
  <para style="m" vid="AMO 8:3">nikwo Mukama RUHANGA arikugira.<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 14:4">Zab 14:4</ref>. </char>
    </note> Nimuhurire eki, imwe abarikuribatiirira abakyene,</para>
  <para style="q1" vid="AMO 8:4">N'abooro b'omu nsi mukabamaraho.<verse eid="AMO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 8:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:5: </char>
      <char style="xt" closed="false">
        <ref loc="NEH 13:15">Neh 13:15</ref>, <ref loc="NEH 13:16">16</ref>; <ref loc="EZK 45:10">Ezk 45:10</ref>; <ref loc="HOS 12:7">Hos 12:7</ref>; <ref loc="MIC 6:10">Mik 6:10</ref>, <ref loc="MIC 6:11">11</ref>. </char>
    </note> Nimugira muti: Beitu oku kwezi, okwaboneka eki kiro, kurengye ryari,</para>
  <para style="q1" vid="AMO 8:5">Tukatunda oburo?</para>
  <para style="q1" vid="AMO 8:5">Na sabato neehwa ryari,</para>
  <para style="q1" vid="AMO 8:5">Tukahununura engano z'okutunda,</para>
  <para style="q1" vid="AMO 8:5">Tukatuubya eefa, tukahangusya shekeli,</para>
  <para style="q1" vid="AMO 8:5">tukaryangatanisisa eminzaani y'obugobya,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:6: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 2:6">Amo 2:6</ref>. </char>
    </note> Tukabona kugura abooro efeeza,</para>
  <para style="q1" vid="AMO 8:6">N'abakyene tukabagura enkaito,</para>
  <para style="q1" vid="AMO 8:6">Tukagura entiti z'engano?<verse eid="AMO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 8:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:7: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 8:13">Hos 8:13</ref>. </char>
    </note> MUKAMA arahiire oburungi bwa Yakobo ati:</para>
  <para style="q1" vid="AMO 8:7">Buzimazima tindyebwa kintu kyona eki baakozire,<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:8: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 4:3">Hos 4:3</ref>; <ref loc="ZEC 10:11">Zek 10:11</ref>. </char>
    </note> Ekyo tikirireetera ensi kutetema,</para>
  <para style="q1" vid="AMO 8:8">N'abagitwiremu boona bakacura?</para>
  <para style="q1" vid="AMO 8:8">Yoona eryaijura nka Nailo,</para>
  <para style="q1" vid="AMO 8:8">Eyecunde, eijururukye nk'ogwo mugyera gwa Misri.<verse eid="AMO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 8:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:9: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 3:6">Mik 3:6</ref>; <ref loc="MAT 24:29">Mat 24:29</ref>. </char>
    </note> Mukama RUHANGA naagira ati: Ahari eryo izooba</para>
  <para style="q1" vid="AMO 8:9">Ndyarenzya eizooba omu ihangwe,</para>
  <para style="q1" vid="AMO 8:9">Nshwekye ensi omwirima nyomushana.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:10: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 3:24">Isa 3:24</ref>; <ref loc="JER 6:26">Yer 6:26</ref>; <ref loc="HOS 2:11">Hos 2:11</ref>. </char>
    </note> Amagyenyi gaanyu ndyagahindura okucura,</para>
  <para style="q1" vid="AMO 8:10">N'ebyeshongoro byanyu byona mbihindure okutonzya.</para>
  <para style="q1" vid="AMO 8:10">Ndyareetera boona kwezirika ebiguniya,</para>
  <para style="q1" vid="AMO 8:10">N'emitwe ya boona ngihindure enkomborora.</para>
  <para style="q1" vid="AMO 8:10">Ndyarigira nk'ery'okucuririraho omwana w'omwojo omwe nyamunegyere,</para>
  <para style="q1" vid="AMO 8:10">N'omuheru gwaryo gube nk'eizooba ry'obusaasi.<verse eid="AMO 8:10" /></para>
  <para style="s1">Abantu okugira enjara y'ekigambo kya Ruhanga</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 74:9">Zab 74:9</ref>; <ref loc="ISA 8:20">Isa 8:20</ref>, <ref loc="ISA 8:21">21</ref>; <ref loc="MIC 3:7">Mik 3:7</ref>. </char>
    </note> Mukama RUHANGA naagira ati:</para>
  <para style="q1" vid="AMO 8:11">Reeba, obunaku nibwija kuhika,</para>
  <para style="q1" vid="AMO 8:11">Obu nditeeza ensi enjara,</para>
  <para style="q1" vid="AMO 8:11">Etari njara y'eby'okurya, nari eiriho ry'eby'okunywa,</para>
  <para style="q1" vid="AMO 8:11">Kureka enjara y'okuhurira ekigambo kya MUKAMA.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:12: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 4:8">Amo 4:8</ref>. </char>
    </note> Baryazengyerera nibaruga aha nyanja nibahika aha ndiijo,</para>
  <para style="q1" vid="AMO 8:12">Nibaruga aha bukiizi-bwa-bumosho, nibahika oburugwa-izooba;</para>
  <para style="q1" vid="AMO 8:12">Baryairuka nibakora oku n'oku kusherura ekigambo kya MUKAMA,</para>
  <para style="q1" vid="AMO 8:12">Kwonka tibarikibona.<verse eid="AMO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 8:13" />Ahari eryo izooba empangare nungi n'abatsigazi</para>
  <para style="q1" vid="AMO 8:13">Baryagwa enshazi nibaitwa eiriho.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">8:14: </char>
      <char style="xt" closed="false">
        <ref loc="1KI 12:29">1 Bag 12:29</ref>, <ref loc="1KI 12:30">30</ref>; <ref loc="ACT 9:2">Byak 9:2</ref>. </char>
    </note> Abarahira ekibi kya Samaria bati:</para>
  <para style="q1" vid="AMO 8:14">Iwe Daani, nindahira ruhanga waawe;</para>
  <para style="q1" vid="AMO 8:14">Kandi bati: Nindahira omuhanda ogurikuza Beeri-sheba,</para>
  <para style="q1" vid="AMO 8:14">Nabo baryagwa, kandi tibariimuka bundi.<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">Oku abantu bataine h'okukirira ebifubiro bya Ruhanga</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:1: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 16:26-30">Bar 16:26-30</ref>. </char>
    </note> Nkareeba MUKAMA ayemereire aha rubaju rw'eitambiro; kandi yaagira ati:</para>
  <para style="q1" vid="AMO 9:1">Teera emitwe y'enyomyo, okuhitsya obu ebisasi biraatengyete;</para>
  <para style="q1" vid="AMO 9:1">Ogisheenyagurire aha mitwe y'abantu boona;</para>
  <para style="q1" vid="AMO 9:1">Abaraahonokyeho mbaitse rurara;</para>
  <para style="q1" vid="AMO 9:1">Tihariho n'omwe omuribo oraahungye,</para>
  <para style="q1" vid="AMO 9:1">Tihariho n'omwe omuribo oraakire.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2, 3: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:8">Zab 139:8</ref>, <ref loc="PSA 139:9">9</ref>. </char>
    </note> N'obu baakutimba, bakahika Okuzimu,</para>
  <para style="q1" vid="AMO 9:2">Nayo omukono gwangye gukaabaihayo;</para>
  <para style="q1" vid="AMO 9:2">N'obu baakutemba, bakahika omu iguru,</para>
  <para style="q1" vid="AMO 9:2">Nayo nkaabahanurayo.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />N'obu baakweshereka aha mutwe gwa Karumeeli,</para>
  <para style="q1" vid="AMO 9:3">Nkaabasherura, mbaihayo;</para>
  <para style="q1" vid="AMO 9:3">N'obu baakuunyeshereka okuzimu ahansi y'enyanja,</para>
  <para style="q1" vid="AMO 9:3">Okwo nayo nkaayohereza enjoka, ebarumirayo.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:4: </char>
      <char style="xt" closed="false">
        <ref loc="JER 21:10">Yer 21:10</ref>. </char>
    </note> Kandi n'obu baakutwarwa omu bukwatwa, bafunyirwe abazigu baabo,</para>
  <para style="q1" vid="AMO 9:4">Okwo nayo nkaaragiira rurara, ebaita;</para>
  <para style="q1" vid="AMO 9:4">Kandi nguma mbataireho eriisho</para>
  <para style="q1" vid="AMO 9:4">Ahabw'okubakora kubi, kutari kubakora gye.<verse eid="AMO 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:5: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 46:6">Zab 46:6</ref>. </char>
    </note> Mukama RUHANGA ow'amahe,</para>
  <para style="q1" vid="AMO 9:5">Ogwo okora aha nsi, ekayaga,</para>
  <para style="q1" vid="AMO 9:5">Abagitwiremu boona bakacura,</para>
  <para style="q1" vid="AMO 9:5">Egyo nsi yoona ekaijura nka Nailo,</para>
  <para style="q1" vid="AMO 9:5">Ekaijura nk'ogwo mugyera gwa Misri,<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 104:3">Zab 104:3</ref>. </char>
    </note> Oyombeka ebishengye bye by'ahaiguru omu iguru,</para>
  <para style="q1" vid="AMO 9:6">Akahamiza orukanga rwaryo ahansi,</para>
  <para style="q1" vid="AMO 9:6">Otuma amaizi g'omu nyanja kwija, akagashandaaza aha nsi,</para>
  <para style="q1" vid="AMO 9:6">MUKAMA niryo iziina rye.<verse eid="AMO 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 1:5">Amo 1:5</ref>; <ref loc="JER 47:4">Yer 47:4</ref>. </char>
    </note> MUKAMA naagira ati: Imwe Baisraeli 'mwe,</para>
  <para style="q1" vid="AMO 9:7">Ahariinye timuri nk'Abanyesiopia?</para>
  <para style="q1" vid="AMO 9:7">Tindaihire Baisraeli omu nsi ya Misri,</para>
  <para style="q1" vid="AMO 9:7">Abafilistia omuri Kafutoori,</para>
  <para style="q1" vid="AMO 9:7">N'Abasiria omuri Kiiri?<verse eid="AMO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:8: </char>
      <char style="xt" closed="false">
        <ref loc="JER 30:11">Yer 30:11</ref>. </char>
    </note> Reeba, amaisho ga Mukama RUHANGA</para>
  <para style="q1" vid="AMO 9:8">Gari aha bugabe oburikukora ebibi,</para>
  <para style="q1" vid="AMO 9:8">Ndyabucwekyereza, mbumare aha nsi;</para>
  <para style="q1" vid="AMO 9:8">Kwonka enju ya Yakobo yo, tindigicwekyerereza kimwe;</para>
  <para style="m" vid="AMO 9:8">nikwo MUKAMA arikugira.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:9: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 30:28">Isa 30:28</ref>; <ref loc="LUK 22:31">Luk 22:31</ref>. </char>
    </note> Ahakuba reeba, ndyaragiira,</para>
  <para style="q1" vid="AMO 9:9">Kandi nshungurire enju ya Israeli omu mahanga goona,</para>
  <para style="q1" vid="AMO 9:9">Nk'oku engano zishungurwa n'engari,</para>
  <para style="q1" vid="AMO 9:9">Hatagire ezaaragara ahansi.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 6:3">Amo 6:3</ref>. </char>
    </note> Abasiisi b'omu bantu bangye boona baryaitwa rurara,</para>
  <para style="q1" vid="AMO 9:10">Abarikugira bati: Titurihikwaho kabi,</para>
  <para style="q1" vid="AMO 9:10">N'obu kwakuba okukareeba.<verse eid="AMO 9:10" /></para>
  <para style="s1">Ruhanga okuraganisa ku arigarura Abaisraeli abaatwairwe omu bukwatwa</para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 9:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:11, 12: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:16-18">Byak 15:16-18</ref>. </char>
    </note> Eryo izooba ndyaimutsya eihema rya Daudi eryagwire,</para>
  <para style="q1" vid="AMO 9:11">Ndibaziire ahataagukire;</para>
  <para style="q1" vid="AMO 9:11">Nyimutsye ebicwagurika byaryo,</para>
  <para style="q1" vid="AMO 9:11">Ndyombekye, ribe nk'oku ryabaire riri obunyakare;<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />Babone kukubuura ekicweka kya Edomu ekyatsigaireho,</para>
  <para style="q1" vid="AMO 9:12">N'amahanga goona agarikwetererwa eiziina ryangye;</para>
  <para style="m" vid="AMO 9:12">nikwo MUKAMA orikukora ebyo arikugira.<verse eid="AMO 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 9:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:13: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:5">Lev 26:5</ref>; <ref loc="JOL 3:18">Yoel 3:18</ref>. </char>
    </note> MUKAMA naagira ati: Reeba, obunaku nibwija,</para>
  <para style="q1" vid="AMO 9:13">Obu omuhingi arihinga omugyesi atakasharwire,</para>
  <para style="q1" vid="AMO 9:13">N'omunyuuki w'emizaabibu akanyuuka omubibi naakibiba;</para>
  <para style="q1" vid="AMO 9:13">Enshozi ziryatoonya viinyo enuzire,</para>
  <para style="q1" vid="AMO 9:13">N'ebibungo byona ebihimintikyemu.<verse eid="AMO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 9:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 61:4">Isa 61:4</ref>; <ref loc="JER 31:5">Yer 31:5</ref>. </char>
    </note> Ndyagarura abantu bangye Israeli abaatwairwe omu bukwatwa.</para>
  <para style="q1" vid="AMO 9:14">Bagarukye bombekye endembo ezaabaire zisheenyirwe,</para>
  <para style="q1" vid="AMO 9:14">Bazituuremu.</para>
  <para style="q1" vid="AMO 9:14">Baryabyara emizaabibu, banywe viinyo yaayo,</para>
  <para style="q1" vid="AMO 9:14">Bahingye emisiri, barye ebyeziremu.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">9:15: </char>
      <char style="xt" closed="false">
        <ref loc="JER 24:6">Yer 24:6</ref>. </char>
    </note> Ndyababyara omu nsi yaabo,</para>
  <para style="q1" vid="AMO 9:15">Tibarigaruka kukuurwa bundi</para>
  <para style="q1" vid="AMO 9:15">Omu nsi ei naabahaire;</para>
  <para style="m" vid="AMO 9:15">nikwo MUKAMA Ruhanga waawe arikugira.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>