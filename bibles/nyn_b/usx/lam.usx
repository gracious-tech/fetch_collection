<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">RRK25.SFM Runyankore-Rukiga Bible Version 1964 lasted edited 06.07.2022</book>
  <para style="h">OKUTONZYA</para>
  <para style="toc1">Okutonzya Kwa Yeremia</para>
  <para style="toc2">Okutonzya kwa Yeremia</para>
  <para style="toc3">Tonz</para>
  <para style="mt1">OKUTONZYA</para>
  <para style="mt2">KWA YEREMIA</para>
  <chapter number="1" style="c" sid="LAM 1" />
  <para style="s1">Okutonzya kwa Yeremia ahabw'okucwekyerezibwa kwa Saayuuni</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 7:34">Yer 7:34</ref>; <ref loc="JER 15:8">15:8</ref>; <ref loc="EZR 4:20">Ezr 4:20</ref>. </char>
    </note> Ka n'eihano, orurembo orwabaire rwijwire abantu kugira eirungu!</para>
  <para style="q1" vid="LAM 1:1">Orwabaire ruba rukuru omu mahanga kuba nk'omufaakazi!</para>
  <para style="q1" vid="LAM 1:1">Orwabaire ruri omunyiginyakazi omu ndembo</para>
  <para style="q1" vid="LAM 1:1">Ruhindukire orw'okutoija!<verse eid="LAM 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:1">Yer 9:1</ref>; <ref loc="JER 30:14">30:14</ref>; <ref loc="ECC 4:1">Mub 4:1</ref>; <ref loc="PSA 6:6">Zab 6:6</ref>. </char>
    </note> Nyekiro nirurira munonga,</para>
  <para style="q1" vid="LAM 1:2">amatama gashwekwa amarira;</para>
  <para style="q1" vid="LAM 1:2">Omuri nkunzi zaarwo tiharimu n'omwe</para>
  <para style="q1" vid="LAM 1:2">W'okururembesereza.</para>
  <para style="q1" vid="LAM 1:2">Banywani baarwo boona barureebize,</para>
  <para style="q1" vid="LAM 1:2">Baahinduka abazigu baarwo.<verse eid="LAM 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="JER 52:27">Yer 52:27</ref>; <ref loc="DEU 28:64">Bir 28:64</ref>, <ref loc="DEU 28:65">65</ref>. </char>
    </note> Ahabw'okubonabonesibwa n'ahabw'obuhuuku bw'amaani</para>
  <para style="q1" vid="LAM 1:3">Yuda agiire omu bukwatwa;</para>
  <para style="q1" vid="LAM 1:3">Hati atwire omu mahanga,</para>
  <para style="q1" vid="LAM 1:3">Kwonka abuzire ah'okuhuumurira;</para>
  <para style="q1" vid="LAM 1:3">Abarikumuhiiga boona bamukwatsire,</para>
  <para style="q1" vid="LAM 1:3">Enaku zimukondahiriire.<verse eid="LAM 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:4: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:2">Yer 14:2</ref>; <ref loc="LAM 2:6">Tonz 2:6</ref>. </char>
    </note> Emihanda erikuza Saayuuni neecura,</para>
  <para style="q1" vid="LAM 1:4">Ahabw'okubura omuntu weena owaija aha magyenyi agaatairweho;</para>
  <para style="q1" vid="LAM 1:4">Amarembo gaayo goona n'ebifurukwa;</para>
  <para style="q1" vid="LAM 1:4">Abanyamurwa baayo nibatsinda,</para>
  <para style="q1" vid="LAM 1:4">Abaishiki baayo bakurwirwe, baatwarwa,</para>
  <para style="q1" vid="LAM 1:4">Kandi nayo neeshaasha munonga.<verse eid="LAM 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:5: </char>
      <char style="xt" closed="false">
        <ref loc="JER 12:1">Yer 12:1</ref>; <ref loc="JER 30:14">30:14</ref>, <ref loc="JER 30:15">15</ref>; <ref loc="DEU 28:13">Bir 28:13</ref>, <ref loc="DEU 28:44">44</ref>; <ref loc="2CH 36:17">2 Bus 36:17</ref>, <ref loc="2CH 36:20">20</ref>; <ref loc="LAM 3:33">Tonz 3:33</ref>; <ref loc="DAN 9:16">Dan 9:16</ref>. </char>
    </note> Abazigu baayo nibo bahindukire abategyeki,</para>
  <para style="q1" vid="LAM 1:5">N'abarikugyanga bagogyeire.</para>
  <para style="q1" vid="LAM 1:5">Ahabw'okuba MUKAMA agireeteire okubonabona</para>
  <para style="q1" vid="LAM 1:5">Ahabw'eby'okushiisha byayo kuba bingi munonga;</para>
  <para style="q1" vid="LAM 1:5">Abaana baayo bagyenzire bari enkwatwa,</para>
  <para style="q1" vid="LAM 1:5">Beebembeire abazigu baabo.<verse eid="LAM 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:6">Yer 14:6</ref>. </char>
    </note> Ekitiinisa kya Saayuuni kyona kigihweireho;</para>
  <para style="q1" vid="LAM 1:6">Abanyiginya baayo babaire nk'empara zibuzire oburiiro;</para>
  <para style="q1" vid="LAM 1:6">Bahungire abarikubahiiga nibakooza.<verse eid="LAM 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 46:26">Yer 46:26</ref>; <ref loc="OBA 1:12">Oba 12</ref>, <ref loc="OBA 1:13">13</ref>. </char>
    </note> Omu biro by'okubonabona n'okushaarirwa kwayo,</para>
  <para style="q1" vid="LAM 1:7">Yerusaalemu neijuka ebintu by'obuguzi bwingi byona</para>
  <para style="q1" vid="LAM 1:7">Ebi yaabaire eine okwiha ira.</para>
  <para style="q1" vid="LAM 1:7">Abantu baayo ku baagwire omu mikono y'abazigu,</para>
  <para style="q1" vid="LAM 1:7">Yaabura kihwera,</para>
  <para style="q1" vid="LAM 1:7">Abazigu baayo baagyesiimirana,</para>
  <para style="q1" vid="LAM 1:7">Nibagishekyerera ahabw'okugwa kwayo.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 16:37">Ezk 16:37</ref>; <ref loc="ZEC 13:1">Zek 13:1</ref>. </char>
    </note> Yerusaalemu ekashiisha munonga,</para>
  <para style="q1" vid="LAM 1:8">Nikyo yaahindukiire ekihagaro;</para>
  <para style="q1" vid="LAM 1:8">Boona abaabaire bagiha ekitiinisa, hati nibagigaya;</para>
  <para style="q1" vid="LAM 1:8">Ahabw'okuba bareebire enjuuro yaayo;</para>
  <para style="q1" vid="LAM 1:8">Eego yo neetsinda, ehugika omushaya.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 13:22">Yer 13:22</ref>; <ref loc="DEU 32:29">Bir 32:29</ref>. </char>
    </note> Oburofa bwayo bukaba buri omu kipumpuriya kyayo,</para>
  <para style="q1" vid="LAM 1:9">Tereetaire ha birigibaho aha muheru;</para>
  <para style="q1" vid="LAM 1:9">N'ahabw'ekyo okugwa kwayo nikutiinisa,</para>
  <para style="q1" vid="LAM 1:9">Teine w'okugihuumuriza.</para>
  <para style="q1" vid="LAM 1:9">Ai MUKAMA, reeba okubonabona kwangye,</para>
  <para style="q1" vid="LAM 1:9">Ahabw'okuba omuzigu asingwire!<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:10: </char>
      <char style="xt" closed="false">
        <ref loc="JER 51:51">Yer 51:51</ref>; <ref loc="DEU 23:3">Bir 23:3</ref>; <ref loc="NEH 13:1">Neh 13:1</ref>; <ref loc="PSA 79:1">Zab 79:1</ref>. </char>
    </note> Omuzigu naakununkirira ebintu byayo byona eby'obuguzi bwingi;</para>
  <para style="q1" vid="LAM 1:10">Eego, ereebire amahanga gahurwire nigataaha omu Mwanya gwayo ogurikwera,</para>
  <para style="q1" vid="LAM 1:10">Agu waazibiire kutaaha omu iteeraniro ry'abantu baawe.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:11: </char>
      <char style="xt" closed="false">
        <ref loc="JER 38:9">Yer 38:9</ref>; <ref loc="JER 52:6">52:6</ref>. </char>
    </note> Abantu baayo nibaaniira, nibaza kushaka,</para>
  <para style="q1" vid="LAM 1:11">Nibahayo eby'obutungi byabo</para>
  <para style="q1" vid="LAM 1:11">Kugura eby'okurya by'okubagaruramu amaani.</para>
  <para style="q1" vid="LAM 1:11">Ai MUKAMA, reeba, oyetegyereze,</para>
  <para style="q1" vid="LAM 1:11">Ahabw'okuba ningaywa.<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:12: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 80:12">Zab 80:12</ref>; <ref loc="DAN 9:12">Dan 9:12</ref>. </char>
    </note> Imwe mwena abarikuhingura, timurikukyetaho?</para>
  <para style="q1" vid="LAM 1:12">Mureebe, mwetegyereze,</para>
  <para style="q1" vid="LAM 1:12">Ku haraabe hariho obusaasi bwona oburi nk'obwangye,</para>
  <para style="q1" vid="LAM 1:12">Obu baanyitsize,</para>
  <para style="q1" vid="LAM 1:12">Obu MUKAMA yantaireho aha kiro ky'ekiniga kye kingi.<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 8:18">Yer 8:18</ref>; <ref loc="PSA 102:3">Zab 102:3</ref>; <ref loc="PSA 9:15">9:15</ref>; <ref loc="EZK 12:13">Ezk 12:13</ref>. </char>
    </note> Akeema ahaiguru, yaayohereza omuriro,</para>
  <para style="q1" vid="LAM 1:13">Yaagushuumya omu magufa gangye;</para>
  <para style="q1" vid="LAM 1:13">Yaatega ebigyere byangye ekigoye,</para>
  <para style="q1" vid="LAM 1:13">Yangarura enyima;</para>
  <para style="q1" vid="LAM 1:13">Yantsigaho nyeshobeire,</para>
  <para style="q1" vid="LAM 1:13">Ningwa enshazi eizooba ryona.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 28:48">Bir 28:48</ref>. </char>
    </note> Eby'okushiisha byangye bikoogoshwa,</para>
  <para style="q1" vid="LAM 1:14">Omukono gwe gwabikomerana,</para>
  <para style="q1" vid="LAM 1:14">Byanteebwa omu bitsya nk'omugamba.</para>
  <para style="q1" vid="LAM 1:14">MUKAMA yammaramu amaani,</para>
  <para style="q1" vid="LAM 1:14">Yampayo omu mikono y'abu ntarikubaasa kuza omu kaso.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:2">Isa 63:2</ref>, <ref loc="ISA 63:3">3</ref>. </char>
    </note> MUKAMA agayiise amamanzi gangye goona,</para>
  <para style="q1" vid="LAM 1:15">Agaabaire gari omuriinye;</para>
  <para style="q1" vid="LAM 1:15">Yaahuruza omutwe gw'abantu kundwanisa,</para>
  <para style="q1" vid="LAM 1:15">Ngu abone kusingyera abatsigazi bangye.</para>
  <para style="q1" vid="LAM 1:15">MUKAMA aribatiriire Yuda omwishiki oshugaine,</para>
  <para style="q1" vid="LAM 1:15">Nk'orikunyuukira omu inyuukiro rya viinyo.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16" />Ebyo nibyo birikundiza,</para>
  <para style="q1" vid="LAM 1:16">Amaisho gangye gakafukunkuka amarira,</para>
  <para style="q1" vid="LAM 1:16">Ahakuba omuhuumuza owaakungarwire omutima omunda</para>
  <para style="q1" vid="LAM 1:16">Andi hare.</para>
  <para style="q1" vid="LAM 1:16">Abaana bangye beeshobeire, ahakuba omuzigu asingwire.<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17" />Saayuuni neetega emikono,</para>
  <para style="q1" vid="LAM 1:17">Kwonka tihaine w'okugihuumuriza.</para>
  <para style="q1" vid="LAM 1:17">MUKAMA aragiire ebya Yakobo,</para>
  <para style="q1" vid="LAM 1:17">Ngu bataahi be babe abazigu be.</para>
  <para style="q1" vid="LAM 1:17">Yerusaalemu ehindukira ekihagaro omuribo.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="JER 12:1">Yer 12:1</ref>; <ref loc="1SA 12:14">1 Sam 12:14</ref>, <ref loc="1SA 12:15">15</ref>. </char>
    </note> MUKAMA niwe ahikire,</para>
  <para style="q1" vid="LAM 1:18">Ahabw'okuba ngomeire ekigambo kye;</para>
  <para style="q1" vid="LAM 1:18">Kwonka imwe mahanga 'mwe mwena, muhurire,</para>
  <para style="q1" vid="LAM 1:18">Mureebe obusaasi bwangye.</para>
  <para style="q1" vid="LAM 1:18">Empangare zangye n'abatsigazi bangye</para>
  <para style="q1" vid="LAM 1:18">Baagiire omu bukwatwa.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19" />Nyetsire nkunzi zangye,</para>
  <para style="q1" vid="LAM 1:19">Kwonka bandyarya;</para>
  <para style="q1" vid="LAM 1:19">Abanyamurwa bangye n'abakuru bangye</para>
  <para style="q1" vid="LAM 1:19">Bacwekyerereire omu rurembo,</para>
  <para style="q1" vid="LAM 1:19">Nibasherura eby'okurya</para>
  <para style="q1" vid="LAM 1:19">By'okubagaruramu amaani.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:20: </char>
      <char style="xt" closed="false">
        <ref loc="JER 15:2">Yer 15:2</ref>; <ref loc="DEU 32:25">Bir 32:25</ref>; <ref loc="JOB 30:27">Yob 30:27</ref>; <ref loc="ISA 16:11">Isa 16:11</ref>. </char>
    </note> Reeba, ai MUKAMA, ahakuba nyine enaku nyingi;</para>
  <para style="q1" vid="LAM 1:20">Omutima guunyemereire,</para>
  <para style="q1" vid="LAM 1:20">Omunda ninkaanyuurwa,</para>
  <para style="q1" vid="LAM 1:20">Ahabw'okuba mbaire ndi omugomi orengyesereize.</para>
  <para style="q1" vid="LAM 1:20">Omu nju harimu rufu.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:21: </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:11">Yer 50:11</ref>; <ref loc="LAM 4:21">Tonz 4:21</ref>. </char>
    </note> Hurira oku ndikutsinda;</para>
  <para style="q1" vid="LAM 1:21">Tihaine w'okumpuumuriza.</para>
  <para style="q1" vid="LAM 1:21">Abazigu bangye boona bahuriire enaku zangye,</para>
  <para style="q1" vid="LAM 1:21">Nibeesiima ahabw'okuba okikozire.</para>
  <para style="q1" vid="LAM 1:21">Ohikiirize ekiro eki waagambire,</para>
  <para style="q1" vid="LAM 1:21">Nabo babe nkaanye.<verse eid="LAM 1:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">1:22: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 109:14">Zab 109:14</ref>, <ref loc="PSA 109:15">15</ref>. </char>
    </note> Obubi bwabo bwona buze omu maisho gaawe,</para>
  <para style="q1" vid="LAM 1:22">Obagirire nk'oku wangiriire</para>
  <para style="q1" vid="LAM 1:22">Nontura ebicumuro byangye byona;</para>
  <para style="q1" vid="LAM 1:22">Ahabw'okuba okutsinda kwangye ni kwingi,</para>
  <para style="q1" vid="LAM 1:22">N'omutima gwangye gugwire enshazi.<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" sid="LAM 2" />
  <para style="s1">Obusaasi bwa Saayuuni ahabw'ekiniga kya Mukama</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="1CH 28:2">1 Bus 28:2</ref>; <ref loc="ISA 14:15">Isa 14:15</ref>; <ref loc="LAM 3:44">Tonz 3:44</ref>. </char>
    </note> Eshi MUKAMA ashwekire Saayuuni ekicu,</para>
  <para style="q1" vid="LAM 2:1">Agiiniire ekiniga!</para>
  <para style="q1" vid="LAM 2:1">Oburungi bwa Israeli yaabwiha omu iguru,</para>
  <para style="q1" vid="LAM 2:1">Yaabunaga ahansi;</para>
  <para style="q1" vid="LAM 2:1">Taijukire katebe k'ebigyere bye</para>
  <para style="q1" vid="LAM 2:1">Aha izooba ry'ekiniga kye.<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 56:2">Zab 56:2</ref>; <ref loc="PSA 74:7">74:7</ref>, <ref loc="PSA 74:11">11</ref>; <ref loc="PSA 89:40">89:40</ref>, <ref loc="PSA 89:46">46</ref>; <ref loc="EZK 9:5">Ezk 9:5</ref>, <ref loc="EZK 9:10">10</ref>. </char>
    </note> MUKAMA acwekyereize amaka ga Yakobo goona</para>
  <para style="q1" vid="LAM 2:2">Ataine saasi;</para>
  <para style="q1" vid="LAM 2:2">Asheenyire ebigo bya Yuda</para>
  <para style="q1" vid="LAM 2:2">Aine ekiniga kingi.</para>
  <para style="q1" vid="LAM 2:2">Kandi obugabe n'abategyeki baabwo</para>
  <para style="q1" vid="LAM 2:2">Abigarwire ahansi, yaabihemura.<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3" />Amazireho amaani ga Israeli goona</para>
  <para style="q1" vid="LAM 2:3">Amwiniire ekiniga kingi,</para>
  <para style="q1" vid="LAM 2:3">Yaahinya omukono gwe gwa buryo</para>
  <para style="q1" vid="LAM 2:3">omu maisho g'abazigu baabo.</para>
  <para style="q1" vid="LAM 2:3">Yaayotsya Yakobo, naabuguma nk'omuriro</para>
  <para style="q1" vid="LAM 2:3">Ogurikurya busha embaju zoona.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:4: </char>
      <char style="xt" closed="false">
        <ref loc="JER 30:14">Yer 30:14</ref>; <ref loc="LAM 3:12">Tonz 3:12</ref>. </char>
    </note> Ananwire obuta bwe nk'omuzigu,</para>
  <para style="q1" vid="LAM 2:4">Ayemereire abangire omukono gwe gwa buryo nk'omubisha;</para>
  <para style="q1" vid="LAM 2:4">Aitsire boona abashemeza amaisho gaitu</para>
  <para style="q1" vid="LAM 2:4">Abari omu ihema rya Saayuuni;</para>
  <para style="q1" vid="LAM 2:4">Yaashuka ekiniga kye nk'omuriro.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:5: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:9">2 Bag 25:9</ref>. </char>
    </note> MUKAMA ahindukire nk'omuzigu,</para>
  <para style="q1" vid="LAM 2:5">Yaamaraho Israeli,</para>
  <para style="q1" vid="LAM 2:5">Yaacwekyereza ebikaari byayo byona,</para>
  <para style="q1" vid="LAM 2:5">Ebigo byayo yaabigira amatongo,</para>
  <para style="q1" vid="LAM 2:5">Yaakanyisa okucura n'okutonzya omuri Yuda.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 27:18">Yob 27:18</ref>; <ref loc="ISA 1:13">Isa 1:13</ref>; <ref loc="LAM 1:4">Tonz 1:4</ref>; <ref loc="ZEP 3:18">Zef 3:18</ref>. </char>
    </note> Yaasheenya akaju ke nk'ak'aha musiri,</para>
  <para style="q1" vid="LAM 2:6">Omwanya gw'amagyenyi agu yaateireho</para>
  <para style="q1" vid="LAM 2:6">Yaagugira amatongo.</para>
  <para style="q1" vid="LAM 2:6">MUKAMA yaamariraho kimwe omuri Saayuuni</para>
  <para style="q1" vid="LAM 2:6">Obugyenyi na Sabato ebyatairweho,</para>
  <para style="q1" vid="LAM 2:6">Kandi omugabe n'omunyamurwa</para>
  <para style="q1" vid="LAM 2:6">Yaababingisa ekiniga kye kingi.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:7: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:30">Bir 32:30</ref>; <ref loc="PSA 74:4">Zab 74:4</ref>; <ref loc="PSA 89:38">89:38</ref>; <ref loc="EZK 24:21">Ezk 24:21</ref>. </char>
    </note> MUKAMA agayire eitambiro rye,</para>
  <para style="q1" vid="LAM 2:7">Yaatamirwa kimwe Omwanya gwe ogurikwera,</para>
  <para style="q1" vid="LAM 2:7">Engo z'ebikaari byayo</para>
  <para style="q1" vid="LAM 2:7">Yaazihayo omu mikono y'abazigu,</para>
  <para style="q1" vid="LAM 2:7">Baateerera omu nju ya MUKAMA orwari</para>
  <para style="q1" vid="LAM 2:7">Nk'orw'aha izooba ry'obugyenyi obwataireho.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:8: </char>
      <char style="xt" closed="false">
        <ref loc="JER 41:2">Yer 41:2</ref>; <ref loc="2KI 21:13">2 Bag 21:13</ref>. </char>
    </note> MUKAMA amaririire kusheenyera kimwe</para>
  <para style="q1" vid="LAM 2:8">Orugo rwa Saayuuni;</para>
  <para style="q1" vid="LAM 2:8">Yaarugyeresa omugoye;</para>
  <para style="q1" vid="LAM 2:8">Tiyaahinya mukono gwe kurekyera aho okucwekyereza;</para>
  <para style="q1" vid="LAM 2:8">Yaareetera ekigo n'orugo kutonzya,</para>
  <para style="q1" vid="LAM 2:8">Amaani gaabihweramu hamwe.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:9: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 7:6">Yos 7:6</ref>; <ref loc="ISA 3:26">Isa 3:26</ref>; <ref loc="EZK 3:15">Ezk 3:15</ref>; <ref loc="EZK 7:18">7:18</ref>. </char>
    </note> Ebiti by'amarembo gaayo byakyengyera omu itaka,</para>
  <para style="q1" vid="LAM 2:9">Empimbi zaayo yaazihendagura, yaazicwekyereza,</para>
  <para style="q1" vid="LAM 2:9">Omugabe waayo n'abanyiginya be bari omu mahanga,</para>
  <para style="q1" vid="LAM 2:9">Ebiragiro bya Ruhanga tibikiriho,</para>
  <para style="q1" vid="LAM 2:9">Na baanabi baayo tibakiine kworekwa</para>
  <para style="q1" vid="LAM 2:9">Okurikuruga ahari MUKAMA.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10" />Abakuru ba Saayuuni</para>
  <para style="q1" vid="LAM 2:10">Bashutami ahansi bahunami,</para>
  <para style="q1" vid="LAM 2:10">Nibeeshuka omucuucu omu mitwe</para>
  <para style="q1" vid="LAM 2:10">Bajwaire ebiguniya;</para>
  <para style="q1" vid="LAM 2:10">Abaishiki ba Yerusaalemu bajuumikire emitwe omu itaka.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:11: </char>
      <char style="xt" closed="false">
        <ref loc="JER 44:7">Yer 44:7</ref>; <ref loc="JOB 16:13">Yob 16:13</ref>; <ref loc="PSA 6:7">Zab 6:7</ref>; <ref loc="ISA 51:20">Isa 51:20</ref>. </char>
    </note> Amaisho gangye garuhiibwe okurira,</para>
  <para style="q1" vid="LAM 2:11">Omutima guunyemereire,</para>
  <para style="q1" vid="LAM 2:11">Omu busaasi bwangye amagara gampweiremu</para>
  <para style="q1" vid="LAM 2:11">Ahabw'okucwekyerezibwa kw'abantu bangye,</para>
  <para style="q1" vid="LAM 2:11">Ahabw'okuba abeereere n'abaana bato bagwereire enshazi</para>
  <para style="q1" vid="LAM 2:11">Omu nguuto z'orurembo.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12: </char>
      <char style="xt" closed="false">
        <ref loc="LAM 1:11">Tonz 1:11</ref>, <ref loc="LAM 1:12">12</ref>. </char>
    </note> Nibatakira baanyinabo nibagira bati:</para>
  <para style="q1" vid="LAM 2:12">Akagaati na viinyo birahi?</para>
  <para style="q1" vid="LAM 2:12">Nibarabira omu nguuto z'omu rurembo</para>
  <para style="q1" vid="LAM 2:12">Nk'abashaija bahutaire,</para>
  <para style="q1" vid="LAM 2:12">Nibahondobererera omu bifuba bya baanyinabo.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:13: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 26:3">Ezk 26:3</ref>. </char>
    </note> Iwe Yerusaalemu 'we,</para>
  <para style="q1" vid="LAM 2:13">Mbwenu nkugambeho ki?</para>
  <para style="q2" vid="LAM 2:13">Nkugyeranise na ki?</para>
  <para style="q1" vid="LAM 2:13">Iwe Saayuuni 'we, omwishiki oshugaine,</para>
  <para style="q1" vid="LAM 2:13">Nkaakushushanisa na ki,</para>
  <para style="q1" vid="LAM 2:13">Ngu mbone kukuhuumuriza?</para>
  <para style="q1" vid="LAM 2:13">Ahabw'okuba okucwekyerera kwawe ni kwingi nk'enyanja,</para>
  <para style="q1" vid="LAM 2:13">N'oha owaakubaasa kukutambira?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:14: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:31">Yer 5:31</ref>; <ref loc="JER 23:33">23:33</ref>, <ref loc="JER 23:34">34</ref>. </char>
    </note> Baanabi baawe boorekirwe ahabwawe</para>
  <para style="q1" vid="LAM 2:14">Eby'ebishuba kandi ebirikuhabisa;</para>
  <para style="q1" vid="LAM 2:14">Tiboorekire butunu by'okutahikiirira kwawe</para>
  <para style="q1" vid="LAM 2:14">Kugarura abantu baawe abaatwairwe omu bukwatwa;</para>
  <para style="q1" vid="LAM 2:14">Kureka ahabwawe boorekirwe</para>
  <para style="q1" vid="LAM 2:14">Okuragura kw'ebishuba kandi okurikuhabisa.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:15: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 29:8">2 Bus 29:8</ref>; <ref loc="PSA 48:2">Zab 48:2</ref>; <ref loc="EZK 16:14">Ezk 16:14</ref>. </char>
    </note> Abahinguzi boona nibakuteerera entomi ahansi,</para>
  <para style="q1" vid="LAM 2:15">Nibeeshaanya Yerusaalemu,</para>
  <para style="q1" vid="LAM 2:15">Nibagizongoreza omutwe nibagira bati:</para>
  <para style="q1" vid="LAM 2:15">Beitu oru nirwo rurembo</para>
  <para style="q1" vid="LAM 2:15">Orwabaire nirwetwa rurungi orutaine kabara,</para>
  <para style="q1" vid="LAM 2:15">Oru ensi yoona eshemerererwa?<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16" />Abazigu baawe boona nibakujuma,</para>
  <para style="q1" vid="LAM 2:16">Nibakweshaanya, nibanena amaino,</para>
  <para style="q1" vid="LAM 2:16">Nibagira bati: Tumucwekyereize!</para>
  <para style="q1" vid="LAM 2:16">Otyo! Eri niryo izooba eri tutuura nitwenda;</para>
  <para style="q1" vid="LAM 2:16">Mbwenu twaribona, twarireeba!<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:17: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:14-45">Lev 26:14-45</ref>; <ref loc="PSA 38:16">Zab 38:16</ref>; <ref loc="PSA 89:42">89:42</ref>. </char>
    </note> MUKAMA akozire eki yaagyendereire,</para>
  <para style="q1" vid="LAM 2:17">Yaahikiiriza ekigambo kye,</para>
  <para style="q1" vid="LAM 2:17">Eki yaaragiire omu biro bya ira;</para>
  <para style="q1" vid="LAM 2:17">Yaakukumbagaza ataine saasi,</para>
  <para style="q1" vid="LAM 2:17">Yaareetera omuzigu kukwesiimirana,</para>
  <para style="q1" vid="LAM 2:17">Yaatunguura amaani g'abazigu baawe.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:18: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 32:4">Zab 32:4</ref>; <ref loc="PSA 42:3">42:3</ref>; <ref loc="PSA 77:2">77:2</ref>. </char>
    </note> Iwe Saayuuni 'we, takira munonga MUKAMA,</para>
  <para style="q1" vid="LAM 2:18">Amarira gahimintikye nk'omutunga</para>
  <para style="q1" vid="LAM 2:18">Nyomushana na nyekiro!</para>
  <para style="q1" vid="LAM 2:18">Otahuumura, amaisho gaawe garekye kutuuza.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:19: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 7:6">1 Sam 7:6</ref>; <ref loc="PSA 119:147">Zab 119:147</ref>, <ref loc="PSA 119:148">148</ref>; <ref loc="1TI 2:8">1 Tim 2:8</ref>. </char>
    </note> Imuka, otakye nyekiro,</para>
  <para style="q1" vid="LAM 2:19">Ahu abarinzi batandikira,</para>
  <para style="q1" vid="LAM 2:19">Shuka ebiri omu mutima gwawe</para>
  <para style="q1" vid="LAM 2:19">Omu maisho ga MUKAMA nk'amaizi!</para>
  <para style="q1" vid="LAM 2:19">Omutegye emikono ahabw'amagara g'abaana baawe,</para>
  <para style="q1" vid="LAM 2:19">Abu enjara erikugwisiza enshazi</para>
  <para style="q1" vid="LAM 2:19">Omu mateeraniro g'enguuto zoona.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:20: </char>
      <char style="xt" closed="false">
        <ref loc="JER 19:9">Yer 19:9</ref>. </char>
    </note> Ai MUKAMA, reeba oyetegyereze</para>
  <para style="q1" vid="LAM 2:20">Abu waakozire otyo!</para>
  <para style="q1" vid="LAM 2:20">Nimugira ngu abakazi bashemereire kurya oruzaaro rwabo,</para>
  <para style="q1" vid="LAM 2:20">Abaana abu baayeyororoire?</para>
  <para style="q1" vid="LAM 2:20">Nari shi omunyamurwa na nabi</para>
  <para style="q1" vid="LAM 2:20">Bashemereire kwitirwa omu Mwanya gwa MUKAMA ogurikwera?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:21: </char>
      <char style="xt" closed="false">
        <ref loc="2CH 36:17">2 Bus 36:17</ref>. </char>
    </note> Abato n'abakuru babyami omu mucuucu gw'enguuto;</para>
  <para style="q1" vid="LAM 2:21">Empangare zangye n'abatsigazi bangye</para>
  <para style="q1" vid="LAM 2:21">Baitsirwe rurara;</para>
  <para style="q1" vid="LAM 2:21">Waabaita aha izooba ry'ekiniga kyawe,</para>
  <para style="q1" vid="LAM 2:21">Waabamaraho otaine saasi.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">2:22: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:25">Yer 6:25</ref>; <ref loc="JER 42:17">42:17</ref>. </char>
    </note> Oyetsire ebirikuunyitsa obwoba embaju zoona,</para>
  <para style="q1" vid="LAM 2:22">Nk'oku beeta abantu aha izooba ry'obugyenyi obuteekateekirwe,</para>
  <para style="q1" vid="LAM 2:22">Aha izooba ry'ekiniga kya MUKAMA;</para>
  <para style="q1" vid="LAM 2:22">Tihaine waarokokire nari owaahonokireho;</para>
  <para style="q1" vid="LAM 2:22">Abu naakiikiire nkoorora</para>
  <para style="q1" vid="LAM 2:22">Omuzigu wangye abamazireho.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" sid="LAM 3" />
  <para style="s1">Amatsiko agu Saayuuni aine ahabw'embabazi za Ruhanga</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 3:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:1: </char>
      <char style="xt" closed="false">
        <ref loc="JER 20:18">Yer 20:18</ref>. </char>
    </note> Niinye muntu ori, owaabonabonesiibwe</para>
  <para style="q1" vid="LAM 3:1">Enkoni y'ekiniga kye.<verse eid="LAM 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:30">Isa 5:30</ref>. </char>
    </note> Akambiga, yampitsya omu mwirima,</para>
  <para style="q1" vid="LAM 3:2">Ahataine kuhweza kwona.<verse eid="LAM 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3" />Buzimazima akaguma nambangira omukono</para>
  <para style="q1" vid="LAM 3:3">Buri kaanya, bwarugaho bwaira.<verse eid="LAM 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:4: </char>
      <char style="xt" closed="false">
        <ref loc="JER 50:17">Yer 50:17</ref>; <ref loc="PSA 51:8">Zab 51:8</ref>. </char>
    </note> Omubiri gwangye n'oruhu rwagwo abihwereize,</para>
  <para style="q1" vid="LAM 3:4">N'amagufa gangye yaagahendagura,<verse eid="LAM 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 19:7-12">Yob 19:7-12</ref>. </char>
    </note> Angotsire, yanshweka</para>
  <para style="q1" vid="LAM 3:5">Obushaarizi n'okubonabona.<verse eid="LAM 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:3">Zab 143:3</ref>. </char>
    </note> Yantuuza omu mwirima</para>
  <para style="q1" vid="LAM 3:6">Nk'abaafiire ira.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 88:8">Zab 88:8</ref>. </char>
    </note> Ankubiise orugo; n'ahabw'ekyo tindikubaasa kucwa;</para>
  <para style="q1" vid="LAM 3:7">Yambohesa enjegyere ziremeire;<verse eid="LAM 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 30:20">Yob 30:20</ref>; <ref loc="PSA 22:2">Zab 22:2</ref>. </char>
    </note> N'obu ndikweta, nkataka,</para>
  <para style="q1" vid="LAM 3:8">Tarikwenda kuhurira kushaba kwangye;<verse eid="LAM 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9" />Emihanda yangye agiitiise amabaare gabaizire,</para>
  <para style="q1" vid="LAM 3:9">N'otuhanda twangye atukiikamize.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 13:8">Hos 13:8</ref>. </char>
    </note> Ambeereire nk'edubu egwereire,</para>
  <para style="q1" vid="LAM 3:10">Kandi nk'entare eyesherekire.<verse eid="LAM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11" />Anteishwire omuhanda, yantaanyagura,</para>
  <para style="q1" vid="LAM 3:11">Yampindura enshoberwa.<verse eid="LAM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 16:12">Yob 16:12</ref>. </char>
    </note> Ananwire obuta,</para>
  <para style="q1" vid="LAM 3:12">Yampindura ekimaasho ky'omwambi gwe.<verse eid="LAM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 6:4">Yob 6:4</ref>. </char>
    </note> Emyambi y'omu mutana gwe</para>
  <para style="q1" vid="LAM 3:13">Yaagimarira omu mutima gwangye;<verse eid="LAM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:14: </char>
      <char style="xt" closed="false">
        <ref loc="JER 20:7">Yer 20:7</ref>; <ref loc="JOB 30:9">Yob 30:9</ref>. </char>
    </note> Mpindukire eky'okushekyererwa omu ihanga ryangye,</para>
  <para style="q1" vid="LAM 3:14">Nibaanyeshongora eizooba ryona.<verse eid="LAM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:15: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:15">Yer 9:15</ref>. </char>
    </note> Anyijwize obushaarizi,</para>
  <para style="q1" vid="LAM 3:15">Yaanyigutsa apusinto.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:26">Yer 6:26</ref>; <ref loc="PRO 20:17">Enf 20:17</ref>. </char>
    </note> Amaisho gangye agacwisize amabaare,</para>
  <para style="q1" vid="LAM 3:16">Yanshweka eiju rya kashenda.<verse eid="LAM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17" />Omutima gwangye gubuzirwe obusingye,</para>
  <para style="q1" vid="LAM 3:17">Naayebwa oku okushemererwa kushusha.<verse eid="LAM 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18" />Ntyo naagira nti: Ekitiinisa kyangye</para>
  <para style="q1" vid="LAM 3:18">N'amatsiko gangye ahari MUKAMA bihweireho.<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19" />Ijuka okubonabona kwangye n'enaku zangye,</para>
  <para style="q1" vid="LAM 3:19">Apusinto n'endurwe.<verse eid="LAM 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20" />Omutima gwangye gutuura nigubiijuka,</para>
  <para style="q1" vid="LAM 3:20">Gweinamiriire omunda yangye.<verse eid="LAM 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21" />Kwonka eki nikiijuka;</para>
  <para style="q1" vid="LAM 3:21">N'ahabw'ekyo nyine amatsiko.<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22: </char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:6">Mal 3:6</ref>. </char>
    </note> Embabazi za MUKAMA tizihwaho,</para>
  <para style="q1" vid="LAM 3:22">N'okusaasira kwe kugumaho ebiro byona.<verse eid="LAM 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:23: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 36:5">Zab 36:5</ref>. </char>
    </note> Buri kasheeshe ziba nsya;</para>
  <para style="q1" vid="LAM 3:23">Obwesigwa bwawe ni bwingi.<verse eid="LAM 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:24: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 16:5">Zab 16:5</ref>. </char>
    </note> Omutima gwangye nigugira guti: MUKAMA niwe mugabo gwangye;</para>
  <para style="q1" vid="LAM 3:24">Nikyo ndimugiriraho amatsiko.<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:25: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:6">Zab 130:6</ref>; <ref loc="ISA 30:18">Isa 30:18</ref>. </char>
    </note> MUKAMA ni murungi aha barikumutegyereza,</para>
  <para style="q1" vid="LAM 3:25">N'aha muntu orikumusherura.<verse eid="LAM 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:26: </char>
      <char style="xt" closed="false">
        <ref loc="MIC 7:7">Mik 7:7</ref>. </char>
    </note> Ni kirungi omuntu okutegyereza</para>
  <para style="q1" vid="LAM 3:26">Okujuna kwa MUKAMA atuurize.<verse eid="LAM 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:27: </char>
      <char style="xt" closed="false">
        <ref loc="ECC 12:1">Mub 12:1</ref>; <ref loc="MAT 11:29">Mat 11:29</ref>. </char>
    </note> Ni kirungi omuntu okwemera omugamba</para>
  <para style="q1" vid="LAM 3:27">Akiri omutsigazi.<verse eid="LAM 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28" />Ashutame wenka ahunami,</para>
  <para style="q1" vid="LAM 3:28">Ahabw'okuba MUKAMA niwe agumukoreire.<verse eid="LAM 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:29: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 42:6">Yob 42:6</ref>. </char>
    </note> Ate eminwa ye omu mucuucu,</para>
  <para style="q1" vid="LAM 3:29">Obundi hakaabaho amatsiko.<verse eid="LAM 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:30: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 50:6">Isa 50:6</ref>; <ref loc="MAT 5:39">Mat 5:39</ref>. </char>
    </note> Ategye abateezi omushaya gwe,</para>
  <para style="q1" vid="LAM 3:30">Bamwitse ebijumo.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:31: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 103:8">Zab 103:8</ref>, <ref loc="PSA 103:9">9</ref>. </char>
    </note> Ahakuba MUKAMA taribingira kimwe</para>
  <para style="q1" vid="LAM 3:31">Muntu ebiro byona;<verse eid="LAM 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:32: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 106:45">Zab 106:45</ref>. </char>
    </note> Kandi, n'obu yaakusaasa omuntu,</para>
  <para style="q1" vid="LAM 3:32">Kwonka aryamugirira esaasi,</para>
  <para style="q1" vid="LAM 3:32">nk'oku embabazi ze nyingi ziri.<verse eid="LAM 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:33: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:6-11">Heb 12:6-11</ref>. </char>
    </note> Ahabw'okuba tabonabonesa bantu nkana,</para>
  <para style="q1" vid="LAM 3:33">N'obu kwakuba okubasaasa.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:34: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 107:10">Zab 107:10</ref>. </char>
    </note> Okusingyera embohe zoona ez'omu nsi,<verse eid="LAM 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:35: </char>
      <char style="xt" closed="false">
        <ref loc="HAB 1:13">Hab 1:13</ref>. </char>
    </note> Nari okuzibira omuntu kutunga</para>
  <para style="q1" vid="LAM 3:35">Ebimushemereire omu maisho ga Rukira-boona,<verse eid="LAM 3:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36" />Nari okumwitira orubanja,</para>
  <para style="q1" vid="LAM 3:36">Ebyo byona MUKAMA tabyenda.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:37: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 33:9">Zab 33:9</ref>. </char>
    </note> N'oha oraragiire kikabaho,</para>
  <para style="q1" vid="LAM 3:37">MUKAMA atakiragiire?<verse eid="LAM 3:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:38: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 45:7">Isa 45:7</ref>. </char>
    </note> Ebibi n'ebirungi tibiruga</para>
  <para style="q1" vid="LAM 3:38">Omu kanwa ka Rukira-boona?<verse eid="LAM 3:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:39: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 19:3">Enf 19:3</ref>. </char>
    </note> Ahabw'enki omuntu ohuriire</para>
  <para style="q1" vid="LAM 3:39">Ayetomboitera okufubirwa ahabw'ebibi bye?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:40: </char>
      <char style="xt" closed="false">
        <ref loc="JOL 2:12">Yoel 2:12</ref>, <ref loc="JOL 2:13">13</ref>. </char>
    </note> Ka tureebe emitwarize yaitu, tugishwijume,</para>
  <para style="q1" vid="LAM 3:40">Tugarukye ahari MUKAMA.<verse eid="LAM 3:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:41: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 119:48">Zab 119:48</ref>. </char>
    </note> Ka twimutsye emitima n'emikono yaitu</para>
  <para style="q1" vid="LAM 3:41">Ahari Ruhanga omu iguru, tugire tuti:<verse eid="LAM 3:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:42: </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:5">Dan 9:5</ref>. </char>
    </note> Tukashiisha, kandi twagoma;</para>
  <para style="q1" vid="LAM 3:42">Tiwaatusaasira.<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43" />Okeehumbika ekiniga kyawe,</para>
  <para style="q1" vid="LAM 3:43">Waatuhiiga, waatwita otaine saasi.<verse eid="LAM 3:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44" />Okeeshweka ekicu,</para>
  <para style="q1" vid="LAM 3:44">Okushaba kwona kwabura oburabo.<verse eid="LAM 3:44" /></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:45: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:13">1 Kor 4:13</ref>. </char>
    </note> Okatuhindura ekumbwe</para>
  <para style="q1" vid="LAM 3:45">N'ebisingo omu mahanga.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46" />Abazigu baitu boona nibatujuma;<verse eid="LAM 3:46" /></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:47: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:17">Isa 24:17</ref>; <ref loc="ISA 51:19">51:19</ref>. </char>
    </note> Obwoba n'obusya, okusheenywa n'okucwekyerera,</para>
  <para style="q1" vid="LAM 3:47">Byona bituhikireho.<verse eid="LAM 3:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:48: </char>
      <char style="xt" closed="false">
        <ref loc="JER 13:17">Yer 13:17</ref>. </char>
    </note> Amaisho gangye nigahimintika emigyera y'amarira,</para>
  <para style="q1" vid="LAM 3:48">Nindizibwa okucwekyerera kw'eihanga ryangye.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49" />Amaisho gangye nigahimintika amaizi</para>
  <para style="q1" vid="LAM 3:49">Obutaitsya, gatarikurereera,<verse eid="LAM 3:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:50: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 63:15">Isa 63:15</ref>. </char>
    </note> Okuhitsya obu MUKAMA aryema omu iguru,</para>
  <para style="q1" vid="LAM 3:50">Akareeba ahansi;<verse eid="LAM 3:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51" />Amaisho gangye nigandeetera obujune,</para>
  <para style="q1" vid="LAM 3:51">Ku ndikureeba ebiri aha baishiki b'omu rurembo rwangye.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:52: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 11:1">Zab 11:1</ref>; <ref loc="PSA 35:19">35:19</ref>. </char>
    </note> Abaanyangiire busha</para>
  <para style="q1" vid="LAM 3:52">Bampiigire nk'enyonyi;<verse eid="LAM 3:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:53: </char>
      <char style="xt" closed="false">
        <ref loc="JER 37:16">Yer 37:16</ref>; <ref loc="DAN 6:17">Dan 6:17</ref>. </char>
    </note> Bannagire omu busya mpuriire,</para>
  <para style="q1" vid="LAM 3:53">Banteereramu amabaare;<verse eid="LAM 3:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:54: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 69:2">Zab 69:2</ref>; <ref loc="PSA 88:5">88:5</ref>; <ref loc="EZK 37:11">Ezk 37:11</ref>. </char>
    </note> Amaizi gandengyera aha mutwe;</para>
  <para style="q1" vid="LAM 3:54">Naagira nti: Mbwenuho naafeera kimwe.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:55: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 130:1">Zab 130:1</ref>, <ref loc="PSA 130:2">2</ref>. </char>
    </note> Ai MUKAMA, nkatakira eiziina ryawe,</para>
  <para style="q1" vid="LAM 3:55">Ndi okuzimu omu kiina;<verse eid="LAM 3:55" /></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56" />Waahurira okweshengyereza kwangye, nti:</para>
  <para style="q1" vid="LAM 3:56">Otanga kutega okutu kwawe kuhurira okutaka kwangye.<verse eid="LAM 3:56" /></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:57: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 1:9">Yos 1:9</ref>; <ref loc="JAS 4:8">Yak 4:8</ref>. </char>
    </note> Ku naakutakiire, waanyirira haihi,</para>
  <para style="q1" vid="LAM 3:57">Waagira oti: Otatiina.<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:58: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 24:15">1 Sam 24:15</ref>. </char>
    </note> Ai MUKAMA, okantonganira,</para>
  <para style="q1" vid="LAM 3:58">Waacungura amagara gangye.<verse eid="LAM 3:58" /></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:59: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 35:22">Zab 35:22</ref>, <ref loc="PSA 35:23">23</ref>. </char>
    </note> Ai MUKAMA, okareeba okukorwa kubi kwangye;</para>
  <para style="q1" vid="LAM 3:59">Ba niiwe wancwera orubanja.<verse eid="LAM 3:59" /></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:60: </char>
      <char style="xt" closed="false">
        <ref loc="JER 11:19">Yer 11:19</ref>, <ref loc="JER 11:20">20</ref>. </char>
    </note> Okareeba okuhoora enzigu kwabo kwona,</para>
  <para style="q1" vid="LAM 3:60">N'enaama yaabo yoona ei bangiriire.<verse eid="LAM 3:60" /></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61" />Ai MUKAMA, ohuriire ebigaaniizo byabo,</para>
  <para style="q1" vid="LAM 3:61">N'enaama yaabo yoona, ei bangiriire;<verse eid="LAM 3:61" /></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62" />Abaanyimukiriire, nibarenzya eizooba nibandwanisa</para>
  <para style="q1" vid="LAM 3:62">N'ebigambo byabo kandi n'ebiteekateeko byabo.<verse eid="LAM 3:62" /></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:63: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 139:2">Zab 139:2</ref>. </char>
    </note> Reeba emishutamire yaabo n'emiimukire yaabo,</para>
  <para style="q1" vid="LAM 3:63">Nibaanyeshongora.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:64: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 28:4">Zab 28:4</ref>; <ref loc="2TI 4:14">2 Tim 4:14</ref>. </char>
    </note> Ai MUKAMA, oryabazimuurira</para>
  <para style="q1" vid="LAM 3:64">Nk'emirimo y'emikono yaabo oku eri.<verse eid="LAM 3:64" /></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65" />Oryabaha omutima gugangaire,</para>
  <para style="q1" vid="LAM 3:65">Omukyeeno gwawe gubahikyeho.<verse eid="LAM 3:65" /></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66" />
    <note caller="-" style="x">
      <char style="xo" closed="false">3:66: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 25:19">Bir 25:19</ref>. </char>
    </note> Ai MUKAMA, oryabahiiga obainiire ekiniga;</para>
  <para style="q1" vid="LAM 3:66">Obahwerekyereze, obamare ahansi y'eiguru ryawe.<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" sid="LAM 4" />
  <para style="s1">Eby'ekitiinisa eki Saayuuni yaabaire eine, n'okugarurwa ahansi kwayo</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 4:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:22">Isa 1:22</ref>. </char>
    </note> Eshi ezaabu eiragwire,</para>
  <para style="q1" vid="LAM 4:1">Ezaabu eshemeziibwe ehindukire!</para>
  <para style="q1" vid="LAM 4:1">Amabaare g'Omwanya ogurikwera</para>
  <para style="q1" vid="LAM 4:1">Ganaganagire ahu buri nguuto erikutandikira.<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:2: </char>
      <char style="xt" closed="false">
        <ref loc="JER 19:11">Yer 19:11</ref>. </char>
    </note> Abaana ba Saayuuni b'enkora-mutima</para>
  <para style="q1" vid="LAM 4:2">Abari nk'ezaabu eshemeziibwe</para>
  <para style="q1" vid="LAM 4:2">Ka bainganisiibwe n'enyungu z'eibumba,</para>
  <para style="q1" vid="LAM 4:2">Ezi omubumbi abumbisa engaro ze!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3" />Nangwa na zaamuha niziha ebibwana byazo amabwabwa</para>
  <para style="q1" vid="LAM 4:3">Zibyontsya,</para>
  <para style="q1" vid="LAM 4:3">Kwonka abantu bangye bahindukire enshaarizi</para>
  <para style="q1" vid="LAM 4:3">Nka zaamaya omu ihamba.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:4: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:15">Zab 22:15</ref>. </char>
    </note> Endimi z'abarikwonka</para>
  <para style="q1" vid="LAM 4:4">Zibaramatiire omu nkanka;</para>
  <para style="q1" vid="LAM 4:4">Abaana nibashaba eby'okurya,</para>
  <para style="q1" vid="LAM 4:4">Haabura owaabibaha.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5: </char>
      <char style="xt" closed="false">
        <ref loc="2SA 1:24">2 Sam 1:24</ref>. </char>
    </note> Abaabaire barya gye</para>
  <para style="q1" vid="LAM 4:5">Hati nibacwekyererera omu nguuto;</para>
  <para style="q1" vid="LAM 4:5">Abaayororeirwe omuri zaabujwa</para>
  <para style="q1" vid="LAM 4:5">Hati nibabyama ahu baata eiju.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:7">Yud 7</ref>; <ref loc="GEN 19:25">Kut 19:25</ref>; <ref loc="MAT 10:15">Mat 10:15</ref>. </char>
    </note> Ahabw'okuba ekifubiro ky'eby'okushiisha by'abantu bangye</para>
  <para style="q1" vid="LAM 4:6">Nikikira ekifubiro kya Sodoma,</para>
  <para style="q1" vid="LAM 4:6">Eyaacwekyereziibwe omu kaanya kakye,</para>
  <para style="q1" vid="LAM 4:6">Hataine mukono ogugikozireho.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:7: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 6:2">Kub 6:2</ref>. </char>
    </note> Abanyiginya be bakaba nibeera okukira ebirika,</para>
  <para style="q1" vid="LAM 4:7">Nibakira amate okwera,</para>
  <para style="q1" vid="LAM 4:7">Emibiri yaabo neemwamwatikana okukira amabaare agarikutukurikana,</para>
  <para style="q1" vid="LAM 4:7">N'okwengyengyeta kwabo kukaba kuri nk'okwa safiro.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:8: </char>
      <char style="xt" closed="false">
        <ref loc="JOB 30:30">Yob 30:30</ref>. </char>
    </note> Kwonka hati aha maisho gaabo nihakiza enziro kwiragura;</para>
  <para style="q1" vid="LAM 4:8">Tibaakimanywa omu nguuto;</para>
  <para style="q1" vid="LAM 4:8">Omubiri gwabo guramataine n'amagufa gaabo,</para>
  <para style="q1" vid="LAM 4:8">Gwayoma, gwaba nk'ekiti.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9" />Abaitsirwe rurara bakahiirwa</para>
  <para style="q1" vid="LAM 4:9">Okukira abaitsirwe enjara,</para>
  <para style="q1" vid="LAM 4:9">Abaahwereire ahabw'okubura ebishaarwirwe omu misiri.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:10: </char>
      <char style="xt" closed="false">
        <ref loc="JER 19:9">Yer 19:9</ref>; <ref loc="DEU 28:57">Bir 28:57</ref>; <ref loc="2KI 6:29">2 Bag 6:29</ref>; <ref loc="ISA 49:15">Isa 49:15</ref>. </char>
    </note> Emikono y'abakazi abanyambabazi</para>
  <para style="q1" vid="LAM 4:10">Ekateeka abaana abu beezaariire,</para>
  <para style="q1" vid="LAM 4:10">Omu kuhwerekyerera kw'abantu bangye</para>
  <para style="q1" vid="LAM 4:10">Baabagira eby'okurya.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:11: </char>
      <char style="xt" closed="false">
        <ref loc="JER 17:27">Yer 17:27</ref>; <ref loc="EZK 5:13">Ezk 5:13</ref>. </char>
    </note> MUKAMA ahikiriize okuguubwa kubi kwe kwona,</para>
  <para style="q1" vid="LAM 4:11">Yaashuka ekiniga kye ekirikubuguma;</para>
  <para style="q1" vid="LAM 4:11">Yaatweka omuriro omuri Saayuuni</para>
  <para style="q1" vid="LAM 4:11">Ogwokize emisingi yaayo.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:12: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 52:15">Isa 52:15</ref>; <ref loc="ISA 53:1">53:1</ref>. </char>
    </note> Abagabe b'omu nsi n'abatuuzi baamwo</para>
  <para style="q1" vid="LAM 4:12">Bakaba bataine kiteekateeko,</para>
  <para style="q1" vid="LAM 4:12">Ngu omuzigu nari omubisha weena naabaasa</para>
  <para style="q1" vid="LAM 4:12">Kutaaha omu marembo ga Yerusaalemu.<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:13: </char>
      <char style="xt" closed="false">
        <ref loc="JER 5:31">Yer 5:31</ref>. </char>
    </note> Ekyo kikagibaho ahabw'ebibi bya baanabi baayo</para>
  <para style="q1" vid="LAM 4:13">N'eby'okushiisha by'abanyamurwa baayo</para>
  <para style="q1" vid="LAM 4:13">Abaabaire bagisheeshamu eshagama y'abahikiriire.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:14: </char>
      <char style="xt" closed="false">
        <ref loc="NUM 19:16">Kub 19:16</ref>; <ref loc="ISA 59:10">Isa 59:10</ref>. </char>
    </note> Bakabandagira omu nguuto nk'empumi,</para>
  <para style="q1" vid="LAM 4:14">Basiisirwe munonga eshagama,</para>
  <para style="q1" vid="LAM 4:14">Hataine waakubaasa kukora aha bijwaro byabo.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:15: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 13:45">Lev 13:45</ref>. </char>
    </note> Abantu bakabaamagana nibagira bati:</para>
  <para style="q1" vid="LAM 4:15">Nimurugyeho, imwe abasiisikaire!</para>
  <para style="q1" vid="LAM 4:15">Nimurugyeho! Nimurugyeho! Mutagira eki mwakoraho!</para>
  <para style="q1" vid="LAM 4:15">Batyo baahinduka abahungi n'ebizengyerezi;</para>
  <para style="q1" vid="LAM 4:15">Abantu baagirira omu mahanga bati:</para>
  <para style="q1" vid="LAM 4:15">Tibarigaruka kutuura naitwe bundi.<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:16: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:2">Isa 24:2</ref>. </char>
    </note> MUKAMA wenka niwe abataataaniise,</para>
  <para style="q1" vid="LAM 4:16">Taribeetaho bundi;</para>
  <para style="q1" vid="LAM 4:16">Abanyamurwa tibarahairwe kitiinisa,</para>
  <para style="q1" vid="LAM 4:16">N'abakuru tibaragiriirwe mbabazi.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:17: </char>
      <char style="xt" closed="false">
        <ref loc="JER 3:23">Yer 3:23</ref>; <ref loc="JER 37:7">37:7</ref>, <ref loc="JER 37:8">8</ref>. </char>
    </note> Amaisho gaitu gaagwa omu nkiro,</para>
  <para style="q1" vid="LAM 4:17">Tuhendekyeire busha tutegyereize okuhwerwa;</para>
  <para style="q1" vid="LAM 4:17">Omu kutegyereza kwaitu, tukategyereza</para>
  <para style="q1" vid="LAM 4:17">Eihanga eritarikubaasa kujuna.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:18: </char>
      <char style="xt" closed="false">
        <ref loc="EZK 7:2">Ezk 7:2</ref>, <ref loc="EZK 7:3">3</ref>, <ref loc="EZK 7:6">6</ref>; <ref loc="AMO 8:2">Amo 8:2</ref>. </char>
    </note> Abantu baatuhiiga batuhambize,</para>
  <para style="q1" vid="LAM 4:18">Kyatuzibira kuraba omu nguuto zaitu;</para>
  <para style="q1" vid="LAM 4:18">Omuheru gwaitu gwairira haihi; ebiro byaitu byaba mbarwa;</para>
  <para style="q1" vid="LAM 4:18">Ahabw'okuba omuheru gwaitu gukaba guhikire.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:19: </char>
      <char style="xt" closed="false">
        <ref loc="JER 4:13">Yer 4:13</ref>; <ref loc="HAB 1:8">Hab 1:8</ref>. </char>
    </note> Abaatuhiigire baakiza amaguru</para>
  <para style="q1" vid="LAM 4:19">Amashamba g'omu mwanya;</para>
  <para style="q1" vid="LAM 4:19">Baatukurata omu nshozi batubingire,</para>
  <para style="q1" vid="LAM 4:19">Baatugwera omu ihamba.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:20: </char>
      <char style="xt" closed="false">
        <ref loc="JDG 9:15">Bar 9:15</ref>; <ref loc="2KI 25:5">2 Bag 25:5</ref>, <ref loc="2KI 25:6">6</ref>; <ref loc="LAM 2:9">Tonz 2:9</ref>; <ref loc="EZK 12:13">Ezk 12:13</ref>; <ref loc="EZK 31:6">31:6</ref>, <ref loc="EZK 31:17">17</ref>. </char>
    </note> Owaabaire ari omwitsyo gwaitu, ou MUKAMA yaashukireho amajuta,</para>
  <para style="q1" vid="LAM 4:20">Akakwatirwa omu busya bwabo,</para>
  <para style="q1" vid="LAM 4:20">Haza niwe twabaire twesigire ngu</para>
  <para style="q1" vid="LAM 4:20">omu kicuucu kye nimwo turituura, turi ahagati y'amahanga.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:21: </char>
      <char style="xt" closed="false">
        <ref loc="JER 25:15">Yer 25:15</ref>, <ref loc="JER 25:16">16</ref>, <ref loc="JER 25:20">20</ref>; <ref loc="JOB 1:1">Yob 1:1</ref>. </char>
    </note> Iwe Edomu 'we, otwire omu nsi ya Uuzi,</para>
  <para style="q1" vid="LAM 4:21">Yesiime, kandi oshemererwe;</para>
  <para style="q1" vid="LAM 4:21">Kwonka naiwe ekikopo kiryakuhikaho,</para>
  <para style="q1" vid="LAM 4:21">Osinde, oyejwekye busha.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">4:22: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:2">Isa 40:2</ref>; <ref loc="OBA 1:10">Oba 10</ref>. </char>
    </note> Iwe Saayuuni 'we,</para>
  <para style="q1" vid="LAM 4:22">Ekifubiro ky'eby'okushiisha byawe kihweire,</para>
  <para style="q1" vid="LAM 4:22">Tarikugumya mu bukwatwa obundi;</para>
  <para style="q1" vid="LAM 4:22">Kwonka iwe Edomu,</para>
  <para style="q1" vid="LAM 4:22">Aryakufubira ahabw'okushiisha kwawe,</para>
  <para style="q1" vid="LAM 4:22">Ashuuruure ebibi byawe.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" sid="LAM 5" />
  <para style="s1">Saayuuni okushaba Ruhanga okugyegarurira</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:1, 2: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 79:1">Zab 79:1</ref>; <ref loc="PSA 89:50">89:50</ref>. </char>
    </note> Ai MUKAMA, ijuka ebyatubaireho,</para>
  <para style="q1" vid="LAM 5:1">Reeba oyetegyereze okuhemuka kwaitu!<verse eid="LAM 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2" />Obuhunguzi bwaitu buhindwirwe obw'abanyamahanga,</para>
  <para style="q1" vid="LAM 5:2">N'amaka gaitu gabaire ag'enduga-mahanga.<verse eid="LAM 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3" />Tuhindukire efuuzi, ezitaine baishezo,</para>
  <para style="q1" vid="LAM 5:3">Baamaaweitwe bahindukire abafaakazi.<verse eid="LAM 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4" />Nitunywa amaizi g'engurano,</para>
  <para style="q1" vid="LAM 5:4">Twaza kubona enku nitubanza kuzigura.<verse eid="LAM 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:5: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 10:24">Yos 10:24</ref>. </char>
    </note> Nitukoresibwa n'amaani, omugamba guturi aha mabega;</para>
  <para style="q1" vid="LAM 5:5">Turuhire, titurikuheebwa kahuumuro,<verse eid="LAM 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:6: </char>
      <char style="xt" closed="false">
        <ref loc="HOS 12:1">Hos 12:1</ref>. </char>
    </note> Twerekuriire Abanyamisri n'Abaasiria,</para>
  <para style="q1" vid="LAM 5:6">Ngu tubone ak'okurya k'okututunga.<verse eid="LAM 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:7: </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:29">Yer 31:29</ref>. </char>
    </note> Baatatenkuriitwe bakashiisha, tibaakiriho;</para>
  <para style="q1" vid="LAM 5:7">Mbwenu itwe twekoreire eby'okushiisha byabo.<verse eid="LAM 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:8: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 30:21">Enf 30:21</ref>, <ref loc="PRO 30:22">22</ref>. </char>
    </note> Abahuuku nibo barikututegyeka,</para>
  <para style="q1" vid="LAM 5:8">Tihaine w'okubatujuna.<verse eid="LAM 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:9: </char>
      <char style="xt" closed="false">
        <ref loc="JER 6:25">Yer 6:25</ref>. </char>
    </note> Eby'okurya byaitu nitubitunga twogire amagara,</para>
  <para style="q1" vid="LAM 5:9">Ahabwa rurara y'omu ihamba.<verse eid="LAM 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 32:24">Bir 32:24</ref>. </char>
    </note> Emibiri yaitu eiraguriirwe nk'enziro</para>
  <para style="q1" vid="LAM 5:10">ahabw'ekibabo ky'omushana ogureetsire rwaranda.<verse eid="LAM 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11" />Abakazi nibahambirwa omuri Saayuuni,</para>
  <para style="q1" vid="LAM 5:11">N'empangare omuri tauni za Yuda.<verse eid="LAM 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:12: </char>
      <char style="xt" closed="false">
        <ref loc="2KI 25:19-21">2 Bag 25:19-21</ref>. </char>
    </note> Abanyiginya nibahanikwa emikono ekomeirwe ahaiguru,</para>
  <para style="q1" vid="LAM 5:12">N'abakuru tibarikuheebwa kitiinisa.<verse eid="LAM 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:13: </char>
      <char style="xt" closed="false">
        <ref loc="JOS 9:27">Yos 9:27</ref>; <ref loc="JDG 16:21">Bar 16:21</ref>. </char>
    </note> Abatsigazi nibeekorezibwa emengo,</para>
  <para style="q1" vid="LAM 5:13">N'aboojo nibataruza n'emba z'enku.<verse eid="LAM 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:14: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 24:8">Isa 24:8</ref>. </char>
    </note> Abagurusi tibakishutama ha irembo ry'orurembo,</para>
  <para style="q1" vid="LAM 5:14">N'abatsigazi tibakiteera nanga.<verse eid="LAM 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:15: </char>
      <char style="xt" closed="false">
        <ref loc="AMO 8:10">Amo 8:10</ref>. </char>
    </note> Okushemererwa kw'omu mitima yaitu kuhweireho,</para>
  <para style="q1" vid="LAM 5:15">N'okuzina kwaitu kuhindukire okucura.<verse eid="LAM 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:16: </char>
      <char style="xt" closed="false">
        <ref loc="JER 13:18">Yer 13:18</ref>. </char>
    </note> Ekirunga kiturugire aha mutwe, kyagwa;</para>
  <para style="q1" vid="LAM 5:16">Tugwereirwe akagwe, ahabw'okuba tukashiisha.<verse eid="LAM 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:17: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 1:5">Isa 1:5</ref>. </char>
    </note> N'ahabw'ekyo emitima yaitu egwire enshazi;</para>
  <para style="q1" vid="LAM 5:17">Ebyo nibyo bireeteire amaisho gaitu kubamu ebisanganana,<verse eid="LAM 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:18: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 34:13">Isa 34:13</ref>. </char>
    </note> Ahabw'orushozi Saayuuni orubaire amatongo;</para>
  <para style="q1" vid="LAM 5:18">Zaamuha zikarushoobamu.<verse eid="LAM 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:19: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 102:12">Zab 102:12</ref>. </char>
    </note> Kwonka iwe, MUKAMA, otuuraho ebiro byona,</para>
  <para style="q1" vid="LAM 5:19">Ekitebe kyawe kigumaho okuhitsya aha busingye bwona.<verse eid="LAM 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:20: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 13:1">Zab 13:1</ref>. </char>
    </note> Ahabw'enki otwebwa ebiro byona?</para>
  <para style="q1" vid="LAM 5:20">Ahabw'enki omazire omwanya muraingwa gutyo otutsigireho?<verse eid="LAM 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:21: </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:18">Yer 31:18</ref>. </char>
    </note> Ai MUKAMA, otwegarurire, tubone kugarurwa!</para>
  <para style="q1" vid="LAM 5:21">Ogarure busya ebiro byaitu nka ira!<verse eid="LAM 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22" />
    <note caller="-" style="x">
      <char style="xo" closed="false">5:22: </char>
      <char style="xt" closed="false">
        <ref loc="JER 14:19">Yer 14:19</ref>. </char>
    </note> Nari shi otunagiire kimwe?</para>
  <para style="q1" vid="LAM 5:22">Otugwereirwe kubi munonga?<verse eid="LAM 5:22" /></para>
  <chapter eid="LAM 5" />
</usx>