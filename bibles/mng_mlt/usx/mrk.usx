  <book code="MRK" style="id">EN_MLT mng_Eastern⋅Mnong_ltr Thu Jun 19 2025 08:47:56 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Mark</para>
  <para style="toc1">Pơp Găl hui si Mak</para>
  <para style="toc2">Mak</para>
  <para style="toc3">Mrk</para>
  <para style="mt">Mak</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Mhei bôk Pơp Găl Yang Tŏng Tlĕh Yê-su di, Kuôn Yang Trôk.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Klăh di jêh čih mŏng ră têh luôr Ê-sai:</para>
  <para style="q1" vid="MRK 1:2">“Ăn dlăng ho, Ăñ yua nêh bi la Ăñ ji sak ta măt Kuôn,</para>
  <para style="q1" vid="MRK 1:2">kăn jrăng wĕh truông Kuôn di;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />ƀơn dơk ôr tĕh mŏng tač ndrăñ:</para>
  <para style="q1" vid="MRK 1:3">‘Ăn wĕh ưm truông sak Yang Trôk di;</para>
  <para style="q1" vid="MRK 1:3">lăm tŏng grăp ndrôih Yang di.’”<verse eid="MRK 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4" />Yô-han jêh trôh, mhŏ ƀap-tem mŏng tač ndrăñ jêh iên tơ ti pơp ƀap-tem băh pơp niêl mlih yơng ta pơp ndrŏh tih. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Lĕ wăl Yu-đê jêh iên grăp nau nêh ta Yê-ru-sa-lem tŏng ndơm trôh ta kăn jêh iên hên tŭ ăn kăn mhŏ ƀap-tem mŏng dak kruông Yô-đan jai jêh hên sơm pơp tih hên di. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Yô-han sŏh ao ta nuôk lak đa wăt ta sei drăng iêng tau dar tŏng nuôi kăn, jêh iên sa krăh wăt dak wei bri. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Kăn ngơi klăh iêu: “Mtao mau pơp myang hĭn ta ăñ jrăng trôh ta kơi ăñ, jêng Mtao ăñ so năng tư̆n bôk mŏng sô̆ no di lĕh sei jep ta Khua Yang. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ăñ mhŏ ƀap-tem pu me ư ta dak, ƀê̆ dăh Khua Yang jrăng mhŏ ƀap-tem pu me ư ta Yang Ngăt Găl.”<verse eid="MRK 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Bruă ĕh trôh mŏng grăp nar hư̆n, hư̆n jêng Yang Yê-su jêh sak băh Na-sa-ret mŏng wăl Ga-li-lê, jêh iên Khua Yang tŭ ăn kăn Yô-han mhŏ ƀap-tem mŏng dak kruông Yô-đan. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Jêh iên mhăč rŏk, jai dŏk băh dak, Khua Yang so grăp tal trôk ĕh pŏk jêh iên Yang Ngăt Găl jrăm tŏng săk Khua Yang klăh di sư̆m tơp. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Jêh hư̆n mau dơk ngơi trôh băh trôk: “Kuôn jêng Kuôn khăp ngăn Ăñ ji. Ăñ brơn nuih ngăn yơng ta Kuôn.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Mhăč rŏk, Yang Ngăt Găl čhôl trôt Khua Yang sak mư̆t mŏng tač ndrăñ. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Khua Yang gŭk mŏng tač ndrăñ puôn jăt nar, tŭ pơp Sa-tan mblơm. Khua Yang gŭk băk pơp bri, jêh iên băl myang đru bruă Khua Yang.<verse eid="MRK 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Jăng jai Yô-han tŭ pơp nggruôn, Yang Yê-su sak trôh Ga-li-lê têh sơm Pơp Găl Yang Trôk di, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />jêh iên ngơi klăh iêu: “Mông nar jêh lĕ, jêh iên čar Yang Trôk di jêh mơñ. Ăn niêl mlih jêh iên đăo ta Pơp Găl.”<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Jăng jai sak iêu hang dak sĭ Ga-li-lê, Khua Yang so Si-môn ta An-drê, ŏh kăn Si-môn, jai hên drăng ñuôl ta dak sĭ, bơ yơng hên jêng nêh ñư̆p ka. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yang Yê-su ngơi ta hên: “Jơ̆ ăn gre ăñ, jêh hư̆n ăñ jrăng lăm ñjêng pu me ñjêng băl drăng ñuôl nêh.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Mhăč rŏk, jai jêh ndrŏh ñuôl ta iên, hên hui gre Khua Yang.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Jai wêh sak ju wăh băh iên, Khua Yang so Ya-kơ, kuôn tlau Sê-ƀê-đê, jêh iên Yô-han, ŏh kăn di, hên jai rư̆m ñuôl tŏng plŭng. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Mhăč rŏk, jai jêh Khua Yang kuôl hên, jêh iên hên dŏk gre Khua Yang, hên lơi bap hên jêng Sê-ƀê-đê gŭk dêh tŏng plŭng ju băk ta băl nêh mhŏ mưn.<verse eid="MRK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Khua Yang mư̆t mŏng uôn ram Ka-ƀê-na-um, jêh iên mhăč rŏk, mŏng nar Sa-ƀat, jai jêh sak mư̆t mŏng hih ƀư̆n, Khua Yang dư̆ng tơ ti lăh. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Nai hơ̆ hă ngăn yơng ta pơp tơ ti lăh Yang di, bơ yơng Khua Yang tơ ti lăh hên klăh di mau pơp myang so mau ndrơm băl tơ ti pơp bhiên. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Mhăč rŏk, ju nau nêh geh yang djŏh mư̆t kăn krĕh gŭk mŏng hih ƀư̆n hên di, kăn ôr tĕh dơk, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />klăh iêu: “Wơ Yê-su Na-sa-ret, băl hi năn pơp mau ta Khua Yang? Geh ya Khua Yang trôh no di lăm rai băl hi? Ăñ gư̆t Khua Yang jêng nêh tơm — Mtao Ƀrăh Yang Trôk di!” <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Yang Yê-su ôt ñjăm ĕh, klăh iêu: “Ăn gŭk miêt jêh iên du băh nêh ho!” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Jêh hư̆n jai jêh yang djŏh we lăm bông nêh hư̆n mŏng sô̆, jêh iên ôr tĕh dơk, jêh hư̆n ĕh du băh kăn hư̆n.<verse eid="MRK 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27" />Grăp nêh dlăng đhir ngăn, tăl hên tŏng ngơi ro do klăh iêu: “Đô̆ nă bruă ho di? Pơp tơ ti mhei hui si pơp myang! Tăl kăn dơi ôt yang djŏh jêh iên ĕh gưt dơk kăn ya.” <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Jêh hư̆n pơp pĕh hing yơng ta Khua Yang mhăč rŏk ĕh lar trôh ta grăp wăl mơñ čar Ga-li-lê.<verse eid="MRK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Mhăč rŏk, jai jêh du băh hih ƀư̆n, hên mư̆t mŏng hih Si-môn jêh iên An-drê, wăt ta Ya-kơ jêh iên Yô-han. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Mông hư̆n, mei ur kăn Si-môn jai piêm kuôp kăt bê̆ tŏng jhưng, jêh iên hên ngơi rŏk ta Khua Yang yơng ta de. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Jai sak mơñ, kŏng ta ti de, Khua Yang têk de dŏk, jêh iên pơp kuôp kăt du băh de, jêh hư̆n de dư̆ng đru bruă hên.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Kơt iên, trôh mông mho, jai jêh măt nar ñăp, nai sak ndơp trôh ta Khua Yang lĕ mơt băl geh pơp kuôp ji jêh iên đơ băl yang djŏh mư̆t. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Lĕ ju uôn jêh hên tŏng ƀư̆n ta ƀăng hih. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Khua Yang lăm băh ŏk nêh geh pơp djhup dư̆r wăt ta djăp mta pơp kuôp ji, jêh iên prŏh ŏk čak, ƀê̆ dăh Khua Yang so ăn băl čak ngơi dơk bơ yơng ĕh gư̆t năl Khua Yang.<verse eid="MRK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Mŏng mông ôi ưm, jai trôk hôm ngo ngăn, jai jêh ngĕh bê̆, Khua Yang du ling, sak trôh ta tŭk ngă nguôi, jêh iên mŏng tŭk hư̆n, Khua Yang kuôl dăn. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Si-môn jêh iên đơ băl gŭk băk Khua Yang sak juôi Khua Yang, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />jêh iên hên dơi so Khua Yang, hư̆n hên ngơi ta Khua Yang klăh iêu: “Grăp nau nêh jai juôi me.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Khua Yang ngơi ta hên: “Băl băn jrăng du tŭk dêh, mŏng grăp uôn ram jư̆m dar, no di ăñ tơ ti lăh mŏng iên ya, bơ yơng ăñ trôh yơng băh bruă ho.” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Khua Yang sak trôh ta grăp wăl Ga-li-lê, ti lăh mŏng grăp hih ƀư̆n băl uôn lan di jêh iên prŏh yang djŏh.<verse eid="MRK 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mông hư̆n, mau ju nau nêh dư̆n lôt sak tŏng tuôm Khua Yang, wơl dăn Khua Yang jêh iên čuôn krŭng, ngơi ta Yang, klăh iêu: “Ndă khua khơñ, khua mau pơp dơi lăm ñjêng ăñ dơi ngôr.” <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />Jêh iên yơng băh nuih nhăm tlŏng đač, jai Khua Yang yơr ti iêu tŏ, Khua Yang bi tŏng kăn, jêh iên ngơi ta kăn: “Ăñ khơñ. Ăn ngôr gơñ.” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Mhăč rŏk dư̆n lôt du băh kăn jêh iên kăn dơi ngôr.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Jai jêh buôi ktang kăn, Khua Yang mhăč rŏk ăn kăn du. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Khua Yang ngơi ta kăn: “Ăn ñjrăng, me so dơi ngơi ju mta pơp ta grăp nau nêh, ƀê̆ dăh ăn sak, lăm ƀlang săk jăn me ta khua mhŏ yang jêh iên myơr grăp pơp mhŏ yang yơng băh pơp jêh ƀrăh ngôr me di, hư̆n jêng bruă jêh Mô-ih tơ tă, klăh di ju mta pơp ngơi nư̆k ta hên.” <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Ƀê̆ dăh, jai du băh iên, kăn dư̆ng têh sơm ta ŏk nêh jêh iên têh sơm pơp ho grăp tŭk, tăl Khua Yang so dơi hôm sak mư̆t mŏng grăp uôn ram ta pơp êngiê ôh, ƀê̆ dăh khua Yang gŭk ta ling tŏ mŏng tŭk ngă nêh, jêh iên băl uôn lan băh grăp tŭk ăt hên sak tŏng tuôm Khua Yang ya.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Jai jêh wêh mư̆t mŏng uôn Ka-ƀê-na-um ƀê̆ nar ta kơi, băl uôn lan tŏng pĕh jêng Khua Yang jai gŭk mŏng hih. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Jêh iên ŏk nêh tŏng ƀư̆n tăl so hôm mau tŭk hŏng ôh, khă ta ƀăng hih so hôm ya, bơ Khua Yang tơ ti pơp đăo ta hên. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Ƀơ ƀă nêh sak trôh ta Khua Yang, hên triêu băk ju nau nêh kuet, nêh tung kăn mau puôn nau. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Yơng băh so dơi sak mơñ Khua Yang hau ŏk ir nêh, hên pŏk dôn hih trip tŭk Khua Yang gŭk, jêh iên jai jêh hên mau tŭk hŏng, hên lăm yôh jhưng bê̆ jêng tŭk nêh kuet jai bê̆. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Jai jêh so pơp đăo hên di, Yang Yê-su ngơi ta nêh kuet: “Wơ kuôn, pơp tih me di jêh dơi đač ru!”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Ƀê̆ dăh đơ băl tơ ti pơp bhiên jai gŭk ta iên mau pơp ngơi mŏng nuih nhăm hên di: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Pơp mhŏ kăn ho ngơi klăh iên? Kăn ho ngăn jêng nêh mưč yang! Nêh tơm mau pơp dơi ndrŏh tih băh gu ju nau Yang Trôk?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Mhăč rŏk, bơ yơng Yang Yê-su jêh gư̆t mŏng nuih nhăm Yang di tŏ ru hên jai mau pơp mĭn ndăp klăh iên, hư̆n Khua Yang ngơi ta hên: “Pơp mhŏ pu me mĭn đơ pơp klăh iên mŏng nuih nhăm? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Năn pơp jêng lưih hĭn no di ngơi ta nêh wiên, ‘Pơp tih me jêh dơi ndrŏh ru!’ mdăh ngơi ‘Ăn dŏk, tung jhưng me jêh iên djhuang sak!’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ƀê̆ dăh no di pu me gư̆t klăh iêu Kuôn Nêh mŏng dôn teh ho mau pơp dơi ndrŏh tih”, Khua Yang ngơi ta nêh wiên: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Ăñ ngơi me ăn dŏk tŏng tê̆, tung jhưng me di jêh iên du ta hih me.”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Kơt iên jai jêh dŏk tŏng tê̆ mhăč rŏk tung jhưng, kăn sak ta măt ŏk nêh, tăl grăp nêh nai dlăng ndrơh ngăn jêh iên nơ nei Yang Trôk, hên ngơi: “Băl băn ñăm tuôm so bruă klăh iên.”<verse eid="MRK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Khua Yang wêh sak hang dak sĭ, jêh iên lĕ băl uôn lan sak ta Khua Yang, jêh hư̆n Khua Yang tơ ti hên. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Jăng jai găn gao, Khua Yang so Lê-wi, kuôn tlau kăn A-phê, jai gŭk mŏng tŭk rư̆ng jia, hư̆n Khua Yang ngơi kăn: “Ăn gre ăñ!” Jai jêh dŏk tŏng tê̆, kăn gre Khua Yang.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Bruă trôh jai mông Khua Yang gŭk sông sa mŏng hih kăn, ŏk băl rư̆ng jia wăt băl tih djŏh gŭk sông băk Yang Yê-su jêh iên băl ƀing kna Yang di, bơ yơng ŏk nêh jêh hên gre Khua Yang ru. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Jai băl tơ ti pơp bhiên ting ju băl Pha-ri-si hên so ru Khua Yang gŭk sông sa băk băl tih djŏh jêh iên băl rư̆ng jia, hên ngơi ta băl ƀing kna Khua Yang: “Pơp mhŏ kăn sông sa ju băk băl rư̆ng jia jêh iên băl tih djŏh?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Jai jêh tŏng pơp hư̆n, Yang Yê-su ngơi ta hên: “Nêh prăl ktang so mau pơp khơñ ta nai dak gư̆n, ƀê̆ dăh hư̆n jêng nêh kuôp ji. Ăñ sak trôh o so mau kuôl ndơm nêh geh găl, ƀê̆ dăh kuôl nêh tih djŏh.”<verse eid="MRK 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Bơ băl ƀing kna Yô-han jêh iên băl Pha-ri-si jai ngăl sông sa, ăt hên trôh ya jêh iên lup Khua Yang: “Bơ yơng pơp mhŏ ƀing kna kăn Yô-han jêh iên ƀing kna băl Pha-ri-si ngăl sông sa, ƀê̆ dăh ƀing kna me di so hên ngăl sông sa?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yang Yê-su ngơi ta hên: “Năč gŭk mŏng mar tăm sai so thơp ngăl sông sa ôh jăng jai kăn tle hôm gŭk băk hên, geh ya? Dŏng ŏk hôm yau hên mau kăn tle gŭk băk ta hên, dŏng iên hên so thơp ngăl sông sa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ƀê̆ dăh đơ nar ta kơi ho, jêng nar kăn tle jêh nai sŏk lat băh hên, mông hư̆n, hên jrăng ngăl sông sa mŏng grăp nar hư̆n. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />So mau nêh rư̆m ju nhêk mnal mhei mŏng blăh ao yau, ƀê̆ dăh ndă mau nêh mhŏ iên, hư̆n ĕh jrăng lăm sat tŭk nai rư̆m ta ao hư̆n, tŭk mnal mhei wăt mnal yau, jêh hư̆n tŭk sat jrăng kjham hĭn ĕh lăm pơl. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />So mau nêh nggăr nơm mhei mŏng nhông tau yau, ndă mau nêh mhŏ klăh iên, nơm jrăng lăm čăh nhông tau, jêh hư̆n wăt nơm wăt nhông tau jrăng jhat lĕ mơt, mlih mŏng iên, nơm mhei nggăr mŏng nhông tau mhei.”<verse eid="MRK 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Bruă trôh mŏng nar Sa-ƀat, jai Khua Yang găn gao tač lŏ ba, grăp ƀing kna Khua Yang dư̆ng hôč mbôn ba mi jăng jai sak truông. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Băl Pha-ri-si ngơi ta Khua Yang: “Dlăng tŏ, pơp mhŏ băl ĕh mhŏ bruă nai wiêr mŏng nar Sa-ƀat?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Khua Yang ngơi ta hên: “Pu me ñăm tuôm dlăng bruă Đa-wit — mtao wăt ta băl hui gre băk kăn — jêh hên mhŏ jai mtao mau pơp khơñ mŏng mông hên nguôt lăh? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Đô̆ nă mtao mư̆t mŏng hih Yang Trôk mŏng nuk khua mhŏ yang ram A-ƀia-tha, jêh iên sa ƀăñ myơr, jêng ƀăñ so dơi sa, čuôm gu băl khua mhŏ yang, jêh iên kăn ăt phă ya ta băl gŭk ju băk ta kăn?”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Khua Yang ngơi ta hên: “Nar Sa-ƀat dơi lăm ñjêng yơng băh kuôn nêh, so mau kuôn nêh yơng băh nar Sa-ƀat ôh. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Hư̆n yơh, Kuôn Nêh jêng Yang, wăt ta nar Sa-ƀat di ya.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Khua Yang wêh sak mư̆t mŏng hih ƀư̆n, jêh iên ju nau nêh mau plang ti ro jai gŭk ta iên. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Nai ksiêm Khua Yang nư̆k ngăn, geh ya Khua Yang jrăng lăm băh nêh hư̆n mŏng nar Sa-ƀat, no di hên dơi kčŭt tih Khua Yang. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Khua Yang ngơi ta nêh mau plang ti ro: “Ăn dŏk trip mŏng mbar.” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Jêh iên Khua Yang lup hên: “Nar Sa-ƀat dơi mhŏ bruă găl mdăh bruă djŏh; lăm tlĕh nêh mdăh lăm khư̆t nêh?” Ƀê̆ dăh hên gŭk miêt. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Jai jêh wiêng măt dlăng hên ta nuih nhăm sriê̆, ênguôt bơ yơng pơp dăng nuih hên di, Khua Yang ngơi ta nêh tlơ tlau: “Ăn ƀlang plang ti me iêu tŏ.” Kăn ƀlang iêu tŏ jêh iên plang ti kăn dơi băh rŏk. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Jêh iên trôh mông du ta ling, đơ băl Pha-ri-si wăt băl pôl Hê-rôt mhăč rŏk hên trông čhai mnăč tăm dăng Khua Yang, đô̆ nă mhŏ no di dơi hên lăm khư̆t Khua Yang.<verse eid="MRK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yang Yê-su wăt băl ƀing kna Yang di du iêu dak sĭ tŏ, jêh iên ju pôl uôn lan ŏk ngăn hui gre băh Ga-li-lê, băh Yu-đê, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />băh Yê-ru-sa-lem, jêh iên băh I-đu-mê wăt băh wăl đăh tŏ dak kruông Yô-đan, ju băk ta jư̆m dar uôn ram Ti-rơ jêh iên Si-đôn. Bơ yơng tŏng pĕh ŏk mŏk bruă Khua Yang mhŏ, ju pôl nêh ŏk ngăn hên tŏng ndơm sak ta Khua Yang. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Khua Yang ngơi ta băl ƀing kna Yang di khă bi mau plŭng kuôn nê̆ prăp prê ta Khua Yang yơng băh băl uôn lan, no di ơn hên ñhêt Khua Yang. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Bơ yơng Khua Yang jêh lăm băh ŏk nêh, tăl lĕ mơt nêh mau pơp kuôp ji hên tŏng ñhêt dơi sak mơñ Khua Yang no di dơi bi ta săk Khua Yang. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Grăp dŏ băl yang djŏh so Khua Yang, băl ĕh buôn mŏng sô̆ ta măt Khua Yang, jêh iên ĕh ôr driêu, ĕh ngơi: “Khua Yang jêng Kuôn Yang Trôk.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Khua Yang mhŏ ktang ghă ĕh no di ơn ĕh têh Khua Yang ta nai.<verse eid="MRK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Khua Yang sak čơng tŏng yôk jêh iên kuôl ndơm đơ nêh tơm Khua Yang khơñ, jêh iên hên sak trôh ta Khua Yang. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Khua Yang săč ruăh măt bar nau nêh (hư̆n jêng băl Khua Yang nơ năn jêng ƀing kna), no di hên gŭk băk Khua Yang jêh iên ăn Khua Yang yua hên sak tơ ti lăh, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />jêh iên ăn pơp myang prơh čak. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Khua Yang săč ruăh măt bar nau nêh: Si-môn, Khua Yang wêh năn kăn jêng Pê-trôih; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Ya-kơ, kuôn tlau Sê-ƀê-đê, jêh iên Yô-han, ŏh kăn Ya-kơ, jêng băl Khua Yang wêh nơ năn jêng Ƀô-a-net, lơ lang jêng băl kuôn tlau tăr nĕh di; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />wăt ta An-drê, Phi-lip, Ƀa-thê-lê-mi, Ma-thi-ơ, Thô-ma, Ya-kơ kuôn tlau A-phê, Tha-đê, Si-môn Sê-lôt, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />jêh iên Yu-đa Ič-ka-ri-ôt, ăt jêng nêh lhiăr Khua Yang ya.<verse eid="MRK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Khua Yang mư̆t mŏng ƀơn hih, jêh iên ju pôl uôn lan wêh tŏng ndơm trôh iên, tăl Khua Yang wăt băl ƀing kna tăl so dơi sa ƀăñ nơn. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Jai băl găp mi Khua Yang tŏng pĕh kơt iên, hên sak no di ñư̆p kăng Khua Yang, bơ yơng hên ngơi klăh iêu: “Kăn jêh nga pơp mĭn ru.” <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Đơ băl tơ ti pơp bhiên, jêng băl sak băh Yê-ru-sa-lem, hên ngơi: “Kăn ho jêh Ƀel-sê-ƀul mư̆t ru,” jêh iên ngơi: “Mơn băh mtao čak hư̆n kăn dơi prơh čak.” <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Ƀê̆ dăh jai kuôl ndơm hên trôh ta iên, Khua Yang tơ ti hên ta pơp hơ hôr: “Đô̆ nă mhŏ no di Sa-tan tŏng prŏh ndăng Sa-tan? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Ndă ƀơn čar mau pơp tŏng jăh tăm dăng ta čar hư̆n tơm, ndă iên čar hư̆n so dơi ĕh gŭk kjăp ôh. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Ndă ju hih nhăk mau pơp tăm jăh čŏng tăm dăng ta ĕh tơm, hih hư̆n jrăng so dơi ĕh gŭk kjăp ya. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Jêh iên ndă Sa-tan dŏk tăm dăng ta ĕh tơm jêh hư̆n tăm jăh, hư̆n ĕh so dơi gŭk kjăp, ƀê̆ dăh jêh trôh mông nga rai ru. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Mdê ta bruă čŏng tăm dăng dêh săk tơm, jai jêh mư̆t mŏng hih ju nau nêh prăl ktang di, so mau nêh dơi tŭng tlĕ ngăn drăp kăn di čuôm gu jêh dơi čăp nêh prăl ktang hư̆n luôr, jêh hư̆n kăh dơi tlĕ pơp mŏng hih kăn. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Ngĭn ngăn, ăñ ngơi ta pu me, đơ lĕ mơt pơp tih ŏh kuôn kuôn nêh di jrăng dơi đač lĕ, tăl lĕ mơt pơp mưč yang hên ngơi băh dơk hên, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />ƀê̆ dăh nêh tơm ngơi mưč tăm dăng ta Yang Ngăt Găl, hư̆n so mau pơp ndrŏh tih tăl trôh nơn nan, jêh iên nêh hư̆n jrăng đuôm tih trôh hui hai.” — <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Khua Yang ngơi klăh iên bơ yơng hên ngơi: “Kăn hư̆n jêh yang djŏh mư̆t.”<verse eid="MRK 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Mei Khua Yang wăt băl ŏh Yang di trôh, jêh iên jăng jai gŭk ta ling, hên yua nêh têh ta Khua Yang, kuôl Khua Yang du ling. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ju pôl nêh ŏk jai gŭk jư̆m dar Khua Yang, jêh iên nai ngơi ta Khua Yang: “Dlăng tŏ, mei khua di wăt băl ŏh khua dŏk ling tŏ, jai juôi khua.” <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Boh pơp hên, Khua Yang ngơi: “Nêh tơm jêng mei ăñ jêh iên băl ŏh ăñ?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Jêh hư̆n jai jêh wiêng măt dlăng iêu băl jai gŭk jư̆m dar hư̆n, Khua Yang ngơi: “Ăn dlăng ho, mei ăñ jêh iên băl ŏh ăñ ji ho! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Bơ yơng nêh tơm mhŏ hui pơp khơñ Yang Trôk di, hư̆n yơh jêng ŏh mi, rôh mei, jêh iên mei ăñ ji.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Ju dŏ hư̆t, Khua Yang dư̆ng tơ ti lăh ta hang dak sĭ, jêh iên ju pôl uôn lan ŏk ngăn tăm ƀư̆n jư̆m dar Khua Yang. Kơt iên, Khua Yang hao tŏng ƀơn plŭng kêng dak sĭ jêh hư̆n gŭk ta iên, bơ lĕ mơt băl uôn lan hên gŭk ta hang dak sĭ tê̆. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Khua Yang tơ ti hên ŏk pơp ta pơp hơ hôr, jêh iên mŏng pơp tơ ti lăh Yang di, Khua Yang ngơi ta hên: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Ăn iêt ho! Tŏ hư̆n, mau nêh mhŏ lŏ sak răh til. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Bruă trôh jai nêh răh til, mau ƀơ ƀă nggăr ĕh lăč kêng truông jêh iên sư̆m răč sak sa lĕ mơt til hư̆n. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Mau nggăr dơ dêh ĕh lăč mŏng tŭk teh mau ndrĕh, hư̆n jêng tŭk so mau ŏk teh găl, jêh iên ĕh čăt mhăč rŏk, yơng băh so ĕh čư̆t jru mŏng teh. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Jai măt nar jua tŏng tê̆, jhi hư̆n tŭ pơp dôh nar al, jêh iên yơng băh so mau rĕh, hư̆n yơh ĕh ƀa ro. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Nggăr dơ dêh ĕh lăč mŏng mbar pôm luôk, tơm luôk čăt jua ĕh dlăn til, jêh iên til hư̆n so dơi mau ple kao ôh. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Mau nggăr dơ dêh ya ĕh lăč mŏng teh găl, grăp nggăr ĕh mau ple kao, jai jêh ĕh huôn ru ĕh dŏk ta ram, jêh iên ĕh mau ple kao ju nggăr mau pei jăt, ƀơ ƀă pro jăt, jêh iên mau ya ju hiêng.” <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Jêh hiên Khua Yang ngơi: “Nêh tơm mau tôr no di iêt, ăn iêt.”<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Jăng jai Khua Yang gŭk dêh ju nau, đơ băl gŭk jư̆m dar Khua Yang wăt ta măt bar nau ƀing kna hên lup Khua Yang yơng ta grăp pơp hơ hôr hư̆n. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Khua Yang ngơi ta hên: “Pơp yuôm ndăp yơng ta uôn tŏng trôk Yang Trôk di jêh dơi ăn ta pu me, ƀê̆ dăh yơng ta băl ta ling, grăp pơp jrăng yua pơp hơ hôr gơ gu,<verse eid="MRK 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MRK 4:12" />no di jai dlăng, mông hư̆n hên dlăng ya, ƀê̆ dăh so dơi so ôh,</para>
  <para style="q1" vid="MRK 4:12">jai iêt, hư̆n ăt hên iêt ya, ƀê̆ dăh so wơng ôh,</para>
  <para style="q1" vid="MRK 4:12">ơn dăh, hên niêl mlih jêh iên pơp tih dơi đač un ta hên.”<verse eid="MRK 4:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MRK 4:13" />Khua Yang ngơi ta hên: “Pu me so wơng pơp hơ hôr ho lăh? Ndă iên đô̆ nă pu me dơi gư̆t wơng lĕ mơt grăp pơp hơ hôr? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Nêh răh nggăr hư̆n jêng răh pơp đăo. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Bơ ho jêng đơ băl ta kêng truông hư̆n jêng tŭk pơp đăo jêh dơi răh, ƀê̆ dăh jai hên tŏng pơp đăo, Sa-tan mhăč rŏk trôh jêh iên tlĕ nga pơp đăo jêh mhei răh mŏng hên. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Iên ya, ho jêng đơ băl ta teh mau ndrĕh jai jêh nai răh, hư̆n jêng băl jai jêh hên tŏng pơp đăo, mhăč rŏk hên ruôm pơp đăo ta pơp čhô̆ brơn, <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />ƀê̆ dăh hên so mau rĕh mŏng hên băh gu bhiêu gu. Trôh ta kơi jai pơp knap mñai mdăh pơp kpĭ kpiêt trôh yơng băh pơp đăo, hên mhăč rŏk ĕh păk bông. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Nggăr ƀơ ƀă jêng đơ băl mŏng mbar pôm luôk jêh răh pơp đăo. Ho jêng đơ băl tŏng pơp đăo, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ƀê̆ dăh lĕ mơt pơp mĭn yơng ta nuk ho jêh iên pơp khơñ ta pơp ndrŏng săh, wăt ta nuih nhăm tluh ŏk pơp dơ dêh tŏng ñhêt mŏng iên, ĕh dlăn khư̆t pơp đăo jêh iên tăl ĕh ñjêng so mau ple kao. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Jêh iên ho jêng lĕ mơt nêh mŏng teh găl jêh răh pơp đăo, hư̆n jêng lĕ mơt băl tŏng pơp đăo jêh iên sŏk ruôm, jêh hư̆n duôm kao mau ple, mau pei jăt, mau pro jăt, jêh iên mau ju hiêng.”<verse eid="MRK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Khua Yang ngơi ta hên: “Kđen jêh jhu so mau nai ăn mŏng sô̆ thŭng mdăh mŏng ƀrôm jhưng geh ya? So lăh geh no di nai ĕh ăn tŏng jŏng kđen lăh? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Bơ yơng so mau ju mta pơp dơi ndăp ndă so geh no di dơi nai lăm ƀlang, ăt so mau ju mta pơp mhŏ mŏng tŭk ndăp no di so dơi lăm ƀlang mŏng tŭk ang. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Ndă nêh tơm mau tôr no di iêt, ăn iêt.” <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />Jêh hư̆n Khua Yang ngơi ta hên: “Ăn ñjrăng ta pơp pu me iêt, Ŏk dŏng năk pu me sŏng mkă, ăt năk hư̆n ya nai jrăng sŏng mkă ta pu me jêh iên ĕh jrăng dơi nai wêh mbăč ta pu me ya. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Bơ yơng nêh tơm mau nai jrăng wêh mbăč hư̆t ta nêh hư̆n, bơ nêh so mau, hư̆n tăl pơp jêh kăn mau, nai jrăng sŏk lat băh kăn.”<verse eid="MRK 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Khua Yang ngơi: “Uôn Yang Trôk di jêng klăh iêu: klăh di ju nau nêh hư̆n răh til mŏng teh, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />kăn bê̆ mdăh ngĕh, măng mdăh nar, nggăr til ĕh čăt kuôt jêh iên ĕh têh ram đô̆ nă — kăn tơm so kăn gư̆t ya. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Teh duôm kao mau ple hui si truông ĕh di: luôr hĭn jêng jhi ha, jêh hư̆n kăh mbôn ba, jêh iên ple jŏk krư̆p mŏng mbôn ba hư̆n. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Jêh hư̆n trôh mông dơm dư̆m ba, kăn mhăč rŏk ñôt niêh riêk bơ yơng dơm riêk jêh trôh.”<verse eid="MRK 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Jêh iên Khua Yang ngơi: “Băl băn jrăng tô mô uôn tŏng trôk Yang Trôk di đô̆ nă, mdăh băl băn jrăng lơ lang uôn găl hư̆n ta năn pơp hơ hôr? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Klăh di ƀơn nggăr pai bi, jêng nggăr jai jêh nai răh mŏng teh, hư̆n jêng nggăr kuôn nê̆ hĭn mŏng djăp mta nggăr mŏng teh, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />jai jêh dơi răh ru, ĕh čăt jua jêh iên ñjêng ram hĭn ta djăp mta pai mŏng mir, jêh iên ĕh čăt grăp mbăh dhan ram, tăl sư̆m trôk dơi mhŏ suôn mŏng gui yô̆ ĕh.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Wăt ta ŏk pơp hơ hôr klăh iên, Khua Yang tơ ti pơp đăo ta hên, hui si pơp dơi hên gư̆t wơng, <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />ƀê̆ dăh Khua Yang so tơ ti ju mta pơp ta hên no di so yua pơp hơ hôr ôh, ƀê̆ dăh jai gŭk dêh, Khua Yang lơ lang djăp pơp ta ƀing kna Yang di.<verse eid="MRK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Mŏng nar hư̆n, jai trôk jêh mơñ mho, Khua Yang ngơi ta hên: “Băl băn jrăng găn gao trôh hang đăh tŏ.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Jêh hư̆n jai jêh du băh pôl uôn lan, hên ndơp Khua Yang sak băk hên, bơ yơng Khua Yang jai hôm gŭk mŏng plŭng. Ăt mau grăp plŭng dêh ya gre Khua Yang. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Mau čal ŭ ram ngăn ĕh dŏk tŏng tê̆ jêh iên yak dak tlă ta plŭng tăl plŭng mơñ ĕh rŏng bêng dak. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Bơ săk Khua Yang jai gŭk ta kơi plŭng, kơl bôk jêh iên bê̆. Hên le Khua Yang jêh iên ngơi ta Khua Yang: “Wơ khua, khua so mĭn ôh băl băn jrăng khư̆t lăh?” <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Jai jêh ngĕh bê̆, Khua Yang ôt čal jêh iên ngơi ta dak sĭ: “Gŭk miêt gơñ! Gŭk kriêp gơñ!” Hư̆n kăh, čal dư̆t lat, jêh iên mau pơp nge ngêt lĕ mơt. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Khua Yang ngơi hên: “Pơp mhŏ pu me bhŭng? Pu me ñăm mau pơp đăo lăh?” <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Hên nga nuih nhăm ta pơp đhir ngit ram hư̆n jêh iên hên tŏng ngơi ndăng hên: “Kơt iên năn nêh ho jêng, bơ yơng tăl čal wăt dak sĭ ăt ĕh gưt Kăn ya?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Jêh hư̆n hên sak trôh ta hang dak đăh tŏ, trôh ta čar Yê-ra-sê. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Jai Khua Yang du băh plŭng, mhăč rŏk, ju nau nêh yang djŏh mư̆t sak drông Khua Yang băh tŭk tu môč, <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />nêh ho mau tŭk gŭk mŏng grăp tu môč, jêh iên so mau nêh dơi ñư̆p čăp kăn ôh, khă nai čăp ta kliêng đai ăt so dơi ya, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />bơ yơng ŏk dŏ kăn jêh nai khuă ta kông jêh iên kliêng đai, ƀê̆ dăh kliêng đai jêh kăn lăm tĕ, jêh iên kông jêh kăn lăm rai, jêh hư̆n so mau nêh djăp pơp ktang no di ñư̆p kăn ôh. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Grăp nar lôh wăt măng mŏng grăp tŭ môč jêh iên tŏng grăp dôn yôk, kăn ôr mbriêu jêh iên tuôr săk jăn kăn tơm ta bôk mau nhañ. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />Jai so Yang Yê-su băh wăč, kăn răn băh tŏ jêh iên buôn săk mŏng sô̆ ta măt Khua Yang. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Tĕh dơk ôr mbriêu, kăn ngơi: “Wơ Yê-su, Kuôn Yang Trôk Tŏng Tê̆ Hĭn, năn pơp ăñ mau ta Khua Yang? Ăñ kôh dăn Khua Yang kăt săk ta măt Yang Trôk, ei ru lăm knap ăñ.” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Bơ yơng Khua Yang jêh lăh ta ĕh, klăh iêu: “Wơ yang djŏh! Ăn du băh nêh ho.” <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Khua Yang lup ĕh: “Đô̆ nă năn me?” Ĕh têh ta Khua Yang: “Năn ăñ jêng Pôl Ka Han, bơ yơng băl hi ŏk ngăn.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Jêh hư̆n ĕh răn ƀăn kôh dăn Khua Yang no di Khua Yang ei ru prơh băl ĕh du băh wăl hư̆n. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Mông hư̆n, ta iên mau ju pôl sư̆r ŏk ngăn jai nai phưi sa băt tŏng yôk, <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />hư̆n yơh ĕh kôh dăn Khua Yang, klăh iêu: “Dăn ăn ta băl hi mư̆t mŏng pôl sư̆r, no di băl hi dơi mư̆t mŏng ĕh.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Khua Yang ăn pơp dơi ta ĕh, jêh iên jai jêh du băh iên hư̆n grăp yang djŏh mư̆t mŏng pôl sư̆r, jêh hư̆n pôl sư̆r — năng ai bar bau mlăm — băh dôn yôk ĕh tuôt iêu dak sĭ sô̆ jêh iên khư̆t krăm mŏng dak sĭ. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Đơ băl kĕ sư̆r tuôt du jêh iên têh sơm bruă hư̆n mŏng uôn ram wăt ta uôn đăm, hư̆n yơh ŏk nêh trôh no di dlăng bruă trôh hư̆n. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Hên trôh ta Yang Yê-su jêh iên so nêh yang djŏh mư̆t — hư̆n jêng nêh jêh Pôl Ka Han yang djŏh mư̆t — jai gŭk ta iên, kăn čư̆t sŏh găl jêh iên mŏng săk jăn pơp mĭn kăn ang, hư̆n hên bhŭng tlŏh nŏh. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Đơ nêh so bruă hư̆n lŏ têh ta hên đô̆ nă bruă jêh trôh ta nêh yang djŏh mư̆t jêh iên bruă yơng ta pôl sư̆r. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Jêh iên hên pŏk dơk kôh dăn Khua Yang du băh wăl teh hên di. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Jai Khua Yang sak čơng mŏng plŭng, nêh jêh yang djŏh mư̆t kôh dăn Khua Yang no di kăn dơi gŭk băk Khua Yang. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Khua Yang so ăn kăn gre, ƀê̆ dăh tơ tă kăn: “Ăn du ta hih me, sak tŏng tuôm ta nêh mŏng hih nhăk me no di têh sơm ta hên bruă ram Yang Trôk jêh mhŏ ta me jêh iên đô̆ nă Khua Yang lăm ƀlang nuih tlŏng đač ta me.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Jêh băh iên, kăn sak jêh iên dư̆ng têh sơm mŏng wăl Đê-ka-ƀô-lơ đô̆ nă bruă ram Yang Yê-su jêh mhŏ ta kăn, jêh iên grăp nau nêh nai dlăng ndrơh gơ gu.<verse eid="MRK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Jai jêh Yang Yê-su hao plŭng sak găn hang đăh tŏ ju dŏ hư̆t, ju pôl uôn lan ŏk ngăn tăm ƀư̆n jư̆m dar Khua Yang, jêh iên Khua Yang jai gŭk ta kêng dak sĭ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Tŏ hư̆n, ju nau mŏng băl kĕ kriê hih ƀư̆n, năn jêng Yai-ru, trôh ta iên, jai jêh so Khua Yang, kăn čuôn krŭng ta jŏng Khua Yang. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Kăn buôn săk kôh dăn Khua Yang jai kăn ngơi klăh iêu: “Kuôn ur dêt ăñ ji kjham ngăn ru. Dăn Khua Yang sak no di Khua Yang bi ti tŏng de no di de dơi băh pơp ji jêh iên dơi brêh.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Hư̆n jêng Khua Yang sak băk kăn, ju pôl uôn lan ŏk ăt hên hui gre Khua Yang jêh iên tŏng ñhêt jư̆m dar Khua Yang.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Mau ju nau u ur ji huôr mham măt bar năm, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />jêh tŭ pơp knap mñai yau ngăn ru bơ yơng ŏk nai dak gư̆n jêh iên lăm le lĕ mơt ngăn drăp de di, ƀê̆ dăh so mau ƀơn pơp tŭ dơn, ƀê̆ dăh mlih mŏng iên, pơp ji ĕh ñjêng kjham hĭn, <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />jai jêh tŏng pĕh yơng ta Yang Yê-su, trôh mông sak mơñ băh kơi Khua Yang mŏng mbar pôl uôn lan ŏk, de bi tŏng ao Khua Yang. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Bơ yơng de mĭn klăh iêu: “Ndă ăñ čuôm gu bi ta ao Khua Yang gu hư̆n ăñ jrăng dơi băh.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Mhăč rŏk, pơp ji huôr mham de di dơi dư̆t, jêh iên de gư̆t năl mŏng săk jăn de, jêng săk jăn de jêh băh pơp kuôp ji. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Mông hư̆n rŏk, Yang Yê-su, gư̆t năl băh săk jăn Yang di jêng pơp myang băh săk Khua Yang ĕh sak, hư̆n yơh wiêng măt iêu pôl ŏk, Khua Yang lup klăh iêu: “Nêh tơm tuôm bi tŏng ao ăñ ji?” <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Băl ƀing kna Yang di ngơi ta Khua Yang: “Khua so ru băl pôl ŏk hên ñhêt Khua, ƀê̆ dăh khua wêh lup: ‘Nêh tơm bi tŏng ăñ’ lăh?” <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Khua Yang ăt hôm dlăng jư̆m dar no di dlăng nêh tơm mhŏ bruă hư̆n. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Mông hư̆n, de u ur, bơ yơng jêh de bhŭng jêh iên prơ prăm, gư̆t bruă jêh trôh ta de, hư̆n de sak mơñ, čư̆p măt mŏng teh ta măt Khua Yang jêh iên têh sơm ta Khua Yang lĕ mơt bruă trôh hư̆n ta pơp klă. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ƀê̆ dăh Khua Yang ngơi ta de: “Wơ kuôn ur, pơp đăo kuôn jêh lăm băh kuôn. Ăn sak mŏng pơp ngăp nge jêh iên dơi tlĕh băh pơp kuôp ji kuôn di.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Mŏng mông Khua Yang jai hôm ngơi, mau nêh băh hih kăn kĕ kriê hih ƀư̆n sak têh klăh iêu: “Kuôn u ur me jêh khư̆t ru. Pơp mhŏ wêh lăm rŭng khua ya?” <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Ƀê̆ dăh jai jêh tŏng pơp hên ngơi, Yang Yê-su ngơi ta nêh kĕ kriê hih ƀư̆n: “Ei ru bhŭng. Čuôm gu đăo gu.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Khua Yang so ăn nêh dơ dêh sak gre băk Khua Yang, čuôm gu Pê-trôih, Ya-kơ jêh iên Yô-han, ŏh kăn Ya-kơ. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Khua Yang sak trôh hih kăn kĕ kriê hih ƀư̆n jêh iên so pơp nai mhŏ khŭk khăk wăt pơp nai ñim jêh iên ôr mbriêu sư̆k rư̆k. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Jai mư̆t mŏng tŏ, Khua Yang ngơi ta hên: “Pơp mhŏ pu me nguôt nư̆ng jêh iên ôr ñim? Kuôn sei ho so khư̆t, ƀê̆ dăh de jai bê̆.” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Hư̆n jêng băl ĕh gơm mưč Khua Yang, ƀê̆ dăh jai jêh prơh lĕ mơt băl ĕh du ling, Khua Yang ndơm gu bap, mei kuôn sei hư̆n jêh iên đơ băl sak băk Khua Yang, jêh hư̆n Khua Yang sak ta tŭk kuôn sei bê̆. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Jai jêh kŏng ti kuôn sei, Khua Yang ngơi ta de: “Ta-li-tha, kum!” Pơp hư̆n dơi lơ lang klăh iêu: “Wơ kuôn ur dêt, ăñ yua kuôn ăn dŏk tŏng tê̆.” <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Mhăč rŏk, de dŏk tŏng tê̆ jêh iên djhuang sak (bơ yơng de jêh măt bar năm ru), jêh iên đơ băl gŭk ta iên hên ndrăt, hơ̆ hă ngăn yơh. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Khua Yang mhŏ khĭm tă jă hên klăh iêu so ăn ju nau nêh dơi gư̆t bruă ho, jêh iên Khua Yang ngơi ta hên ăn de kuôn sei hư̆n sông.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Băh tŭk hư̆n, Khua Yang dŏk du, jêh hư̆n du trôh ta uôn tơm Yang di, jêh iên băl ƀing kna Yang di hui gre Khua Yang. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Trôh nar Sa-ƀat, Khua Yang dư̆ng tơ ti mŏng hih ƀư̆n. Ŏk nêh iêt ĕh hơ̆ hă, jêh iên ngơi klăh iêu: “Đơ pơp tơ ti lăh ho u tŭk băh kăn sŏk? Pơp knhau jêh dơi mau mŏng kăn ho wăt ta pơp myang klăh tŏ hư̆n ĕh ƀlang băh ti kăn hư̆n jêng đô̆ nă? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />So lăh geh ho jêng tlau trăh phat, kuôn tlau Ma-ri di, jêh iên mi tlơ tlau kăn Ya-kơ, Yô-sê, Yu-đe jêh iên Si-môn lăh? So lăh geh đơ rôh mei kăn di jai hên gŭk ta o mŏng mbar băl băn lăh?” Hên păk bông yơng ta Khua Yang. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Yang Yê-su ngơi ta hên klăh iêu: “Nêh têh luôr so tuôm kƀăh ôh pơp nai mpŭ, čuôm gu ta uôn hên tơm, mŏng mbar găp pôl hên jêh iên mŏng hih nhăk hên gu.” <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Khua Yang so dơi mhŏ ju mta bruă myang ta iên ôh, čuôm gu Khua Yang lăm băh kuôp ji jai bi ti tŏng ƀê̆ ngăn nêh kuôp ji. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Khua Yang dlăng ndrơh ngăn yơng băh nuih krăk dăng hên di, jêh hư̆n Khua Yang sak tơ ti lăh jư̆m dar grăp uôn đăm.<verse eid="MRK 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Khua Yang kuôl măt bar ƀing kna jêh iên dư̆ng yua hên sak tơ ti, bar nau ju tŭk, Khua Yang ăt ăn ta hên pơp dơi tŏng grăp yang djŏh, <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />jêh iên tơ tă hên klăh iêu ei ru ñôt ju mta pơp jai sak truông, čuôm gu ƀơn mŏng jra gu — so ñôt ƀăñ, so ñôt kdô, ăt so ñôt prăk kăk mŏng sei drăng iêng ya — <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />ƀê̆ dăh ăn triêu jep, jêh iên “Pu me so dơi sŏh bar ao.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Jêh iên Khua Yang tơ tă ta hên: “Năn mŏng hih jai pu me mư̆t, ăn gŭk ta iên tăl trôh ta mông pu me du băh hih hư̆n. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />U ta tŭk so nai ruôm pu me, mdăh so khơñ iêt pu me, hư̆n jai du băh iên, ăn tơ tôh ƀhŭl mŏng jŏng pu me klăh di pơp lăm nư̆k tăm dăng ta hên.” <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Hư̆n jêng, jai jêh sak truông, hên tơ ti klăh iêu grăp nau nêh ăn gư̆t niêl mlih. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Hên prŏh ŏk yang djŏh, jêh iên ñŏh dak ndriêng ta ŏk nêh kuôp ji jêh hư̆n lăm băh hên.<verse eid="MRK 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Hư̆n yơh, mtao Hê-rôt tŏng pĕh pơp ho, bơ yơng năn Yang di jêh ñjêng pĕh hing ŏk, jêh iên nai ngơi klăh iêu: “Yô-han Ƀap-tit jêh dơi wêh dŏk brêh băh tŭk khư̆t, hư̆n yơh grăp pơp ndrơh myang dơi mau mŏng nêh ho.” <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Mau ya nêh dơ dêh ngơi klăh iêu: “Kăn ho jêng Ê-li.” Ƀê̆ dăh mau ya nêh ngơi hư̆n jêng: “Ju nau nêh têh luôr, ndrơm klăh di ju nau mŏng băl têh luôr.” <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Ƀê̆ dăh jai jêh tŏng kơt iên, Hê-rôt ngơi klăh iêu: “Yô-han, jêng nêh ăñ ndăč bôk, kăn jêh dơi wêh dŏk brêh.” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Bơ yơng kăn Hê-rôt yơh, jêh yua nêh, ñư̆p Yô-han jêh iên čăp kăn mŏng war yơng ta bruă de Hê-rô-đia (ur kăn Phi-lip, ŏh tlơ tlau mtao di) bơ yơng mtao jêh sai de hư̆n. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Yơng băh Yô-han ngơi ta Hê-rôt klăh iêu: “Ngĭn ngăn tih ta pơp bhiên jai mtao sai ur ŏh mtao di.” <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Ƀê̆ dăh Hê-rô-đia hao nuih ta kăn jêh iên khơñ lăm khư̆t kăn, ƀê̆ dăh de so thơp mhŏ ôh, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />yơng băh Hê-rôt bhŭng Yô-han, bơ yơng gư̆t kăn jêng nêh geh tŏng jêh iên ƀrăh ngôr, hư̆n mtao ăn kăn dơi đăp nang, wăt di lăh jêh tŏng pơp kăn ngơi, mtao tŏng sriê̆ ngăn, ƀê̆ dăh mtao ăt ñăt nuih nhăm iêt kăn ngơi. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Jêh hư̆n jai jêh trôh mông geh găl, jêng mông Hê-rôt mkra mar mei lai săk kăn di kăn ndơm jă grăp băl khua kăn wăt ta băl git gai pôl ka han, jêh iên băl kĕ kriê wăl Ga-li-lê, <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />mông hư̆n kuôn ur de Hê-rô-đia mtao di, mư̆t mŏng tŏ, muñ kdŏ, jêh iên de lăm ăn ta Hê-rôt wăt băl năč gŭk jhưng ju băk mtao hên brơn nuih ngăn, hư̆n mtao ngơi ta de ur drôh: “Ăn e dăn ta ăñ djăp mta pơp e khơñ jêh iên ăñ jrăng ăn ĕh ta e.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Kăn kăt săk ta de klăh iêu: “Wăt di lăh e dăn ăñ, trôh ta ju khăn čar ăñ ji, ăt ăñ jrăng ăn ta e ya.” <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Hư̆n yơh, jai jêh du ta ling, de ur drôh hư̆n lup mei de: “Năn pơp ăñ jrăng dăn?” Jêh hư̆n mei de ngơi: “Bôk kăn Yô-han Ƀap-tit.” <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Mhăč rŏk, mŏng pơp tơ tan jai de plơ̆ iêu mtao, de ur drôh dăn: “Ăñ khơñ mau mŏng mông ho rŏk mtao ăn ta ăñ bôk kăn Yô-han Ƀap-tit ăn tŏng măm.” <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Wăt di lăh bêng pơp nguôt nư̆ng, ƀê̆ dăh mtao so thơp ơ̆ pơp de dăn ôh yơng băh pơp kăt săk kăn di jêh iên băl năč yang jai gŭk jhưng ju băk kăn, <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />hư̆n mtao mhăč rŏk, yua nêh kŏng pêh, ăn ndơp bôk Yô-han ta iên, jêh iên jai jêh du ling, nêh hư̆n sak srĕh bôk kăn mŏng mnă. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Kăn ñôt bôk Yô-han ăn tŏng măm jêh hư̆n jao ĕh ta de ur drôh, jêh hư̆n de ur drôh wêh jao ĕh ta mei de. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Jai jêh tŏng pĕh bruă hư̆n, băl ƀing kna Yô-han trôh ta iên, sŏk săk khư̆t kăn, jêh iên ñôt ĕh sak tăp bư̆l mŏng tu.<verse eid="MRK 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Băl ƀing kna ƀư̆n jư̆m dar Yang Yê-su, têh ta Khua Yang grăp bruă hên jêh tuôm mhŏ jêh iên grăp pơp hên jêh tơ ti. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Khua Yang ngơi ta hên: “Ăn pu me sak dêh trôh mŏng grăp tŭk ngă nguôi, jêh iên gŭk mdei dŏng nê̆.” Bơ yơng mau ŏk ngăn nêh sak tŏ nêh sak o, jêh iên tăl hên so mau mông no di sông sa. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Hên ju băk băl hao tŏng plŭng sak trôh ta tŭk ngă nguôi. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Ŏk nêh nai so hên du jêh iên gư̆t năl hên, hư̆n yơh băh grăp uôn ram, nai ju băk băl sak jŏng trôh ta iên jêh hư̆n nai trôh ta tŭk hư̆n luôr ta hên. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Jai jêh du băh plŭng, Khua Yang so ju pôl uôn lan ŏk ngăn, jêh iên Khua Yang mau nuih nhăm tlŏng đač hên bơ yơng hên ndrơm klăh di biêp so mau nêh kĕ, jêh hư̆n Khua Yang dư̆ng tơ ti lăh hên ŏk pơp. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Mông hư̆n jêh la ru, hư̆n yơh jai trôh ta Khua Yang, băl ƀing kna Yang di ngơi klăh iêu: “Tŭk ho jêng tŭk ngă nguôi jêh iên mông ho trôk jêh ngo ngăn ru. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Dăn ăn ta băl uôn lan du, no di jai jêh sak mư̆t mŏng grăp uôn jư̆m dar păt o, hư̆n lơi hên ruôt dêh pơp sông sa.” <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Ƀê̆ dăh jai boh pơp hên, Khua Yang ngơi: “Pu me jrăng ăn hên sa.” Hên ngơi ta Khua Yang: “Jêh sak băh o, năng ai dơi băl hi ruôt bar hiêng đơ-niê ƀăñ jêh iên ăn ta băl uôn lan ho sa lăh?” <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Jêh hư̆n, Khua Yang ngơi ta hên: “Ăn sak. Dlăng tŏ. Dŏng ŏk mlăm pu me mau ƀăñ?” Jai jêh hên sak dlăng, hên têh: “Prăm mlăm ƀăñ jêh iên bar mlăm ka.” <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Khua Yang yua lĕ mơt băl uôn lan gŭk mŏng sô̆ ju pôl ju pôl tŏng băt piêk. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Hên gŭk tŏng phă ñjêng grăp pôl, phă ju pôl ju hiêng nau nêh jêh iên ju pôl prăm jăt nau nêh. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Jai jêh ñôt prăm mlăm ƀăñ jêh iên bar mlăm ka, ngơk măt tŏng trôk tê̆, Khua Yang lăh găl jêh iên phič ƀăñ jêh hư̆n ndơp ta băl ƀing kna Yang di no di hên sak tŏng phă ta băl uôn lan. Khua Yang wêh phă ya bar mlăm ka hư̆n ta grăp nau nêh. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Hên sa gơ gu jêh iên dơi hơm. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Jêh iên dơi hên dôñ măt bar bai bêng ƀăñ djăh wăt ta ka. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Đơ nêh jêh sa ƀăñ trôh ta prăm bau nau nêh tlơ tlau.<verse eid="MRK 6:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Mhăč rŏk, Khua Yang ñjêt băl ƀing kna Yang di hao tŏng plŭng jêh iên sak luôr trôh ta hang đăh tŏ, trôh ta Ƀêt-sai-đa, jăng jai Khua Yang ăn băl uôn lan du. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Jai jêh hên sak, Khua Yang čơng tŏng yôk no di kuôl dăn. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Trôh măng, plŭng jêh trôh mŏng mbar dak sĭ, jêh iên Khua Yang gŭk dêh ju nau tŏng hang. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />So hên jai gir lĕ ai ƀăh plŭng — bơ yơng čal jai ĕh prôh iêu plŭng hên — năng ai trôh ta mông tal puôn măng hư̆n, Khua Yang sak jŏng tŏng bôk dak sĭ trôh tŭk hên jêh iên Khua Yang khơñ găn gao hên. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Ƀê̆ dăh jai hên so Khua Yang djhuang sak tŏng bôk dak sĭ, hên mĭn klăh iêu hư̆n jêng čak, hư̆n yơh hên ôr ndrăt, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />bơ yơng hên so gơ gu Khua Yang jêh iên bhŭng ndrăt. Ƀê̆ dăh mhăč rŏk, Khua Yang ngơi ta hên jêh iên tơ tă hên: “Ăn kjăp nuih nhăm! Jêng ăñ ho! Ei ru bhŭng!” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Khua Yang djhuang mư̆t mŏng plŭng băk hên jêh iên čal gŭk miêt rŏk, grăp băl ƀing kna mau pơp ñhuôt ktang ngăn mŏng mbar hên. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Bơ yơng hên so wơng yơng ta pơp myang lăm ñjêng ƀăñ, mlih ta iên, nuih nhăm hên ăt hôm krăk dăng.<verse eid="MRK 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Jăng jai jêh sak găn hang đăh tŏ, hên sak trôh Gê-nê-sa-rêt jêh iên čhiêp plŭng ta hang hư̆n. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Jai hên du băh plŭng, bơ yơng gư̆t năl Khua Yang rŏk, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />hư̆n nai dhul grăp wăl hư̆n jêh iên dư̆ng tung đơ băl kuôp ji tŏng jhưng trôh ta tŭk hên tŏng pĕh klă Khua Yang jai gŭk ta iên. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />U ta tŭk Khua Yang sak mư̆t, mŏng grăp uôn đăm, mdăh mŏng uôn ram mdăh mŏng uôn wăč, băl uôn lan hên sak ndơp đơ băl kuôp ji ăn ta tŭk tăč blơ̆ jêh iên dăn Khua Yang no di ƀê̆ ngăn hên dơi bi ta tiêng ao Khua Yang, jêh iên đơ nêh tơm dơi bi tŏng Khua Yang jrăng dơi băh kuôp ji.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Đơ băl Pha-ri-si wăt ta băl tơ ti pơp bhiên, hên sak băh Yê-ru-sa-lem, jai tŏng ƀư̆n jư̆m dar Khua Yang. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Bơ yơng jêh so băl ƀing kna Khua Yang di, jai pŏng hên sa ƀăñ ta ti ƀơ̆, hư̆n jêng ti ñăm rao. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(Yơng băh băl Pha-ri-si ăt ndrơm ta lĕ mơt băl Yo Thaĭ hên so sông sa ndă ñăm hên rao ti hên ngôr, bơ yơng hên ñôt pơp krĕh mưng pang yo hên di; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />jêh iên đơ pơp ruôt băh tŭk tăč blơ̆, hên so sông sa ndă ñăm rao ngôr, jêh iên hôm ŏk ya pơp dơ dêh hên sŏk dơn no di ñôt gưt: klăh di bruă rao čiên bơng, dlăn nhông, jêh iên djăp mta pơp nai mhŏ ta kuông.) <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Ƀê̆ dăh băl Pha-ri-si jêh iên băl tơ ti pơp bhiên lup čêk Khua Yang: “Pơp mhŏ băl ƀing kna me so hên brêh hui si pơp krĕh mưng pang yo lak, ƀê̆ dăh hên sa ƀăñ ta ti ñăm rao?” <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />Ƀê̆ dăh jai boh pơp hên, Khua Yang ngơi klăh iêu: “Ê-sai ngơi têh luôr geh ngăn yơng ta băl pra mhŏ găl pu me. Ndrơm ta pơp čih klăh iêu:</para>
  <para style="q1" vid="MRK 7:6">‘Uôn lan ho nơ nei ăñ ta băr yuôi čông piêt</para>
  <para style="q1" vid="MRK 7:6">ƀê̆ dăh nuih nhăm hên di wăč ngăn băh ăñ.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Bơ hên kôh mpŭ ăñ ta pơp dăh dan,</para>
  <para style="q1" vid="MRK 7:7">jai tơ ti lăh grăp pơp bhiên kuôn nêh di klăh di pơp tơ ti geh.’<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Ndrŏh lat pơp bhiên Yang Trôk di, pu me ñôt gưt pơp krĕh mưng kuôn nêh.” <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />Jêh iên Khua Yang ngơi hên: “Pu me nă khĕ ndrŏh lat pơp bhiên Yang Trôk di no di ñôt gưt pơp krĕh mưng pu me tơm! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Bơ yơng Mô-ih tơ ti: ‘Ăn gư̆t mpŭ bap tơm wăt mei tơm,’ jêh iên ‘Nêh tơm tăm păh bap mdăh mei, kăn hư̆n jrăng tŭ pơp kmhal jêng pơp khư̆t.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ƀê̆ dăh pu me lŏ ngơi: ‘Ndă ju nau nêh ngơi ta bap mdăh mei kăn: “Năn pơp jêng mei bap năng dơi dơn băh ŏh kuôn jêng Ko-ƀan (hư̆n jêng pơp mhŏ yang myơr Yang Trôk),”’ <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />jêng pu me so ăn pơp dơi ta nêh hư̆n mhŏ ju mta pơp ta bap mdăh mei kăn ya, <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />lăm ñjêng pơp ngơi Yang Trôk di ĕh ñjêng dăh dan mkă ta pơp krĕh mưng pang yo hư̆n jêng pơp pu me tăm tơ ti hư̆t, jêh iên pu me mhŏ ŏk bruă ndrơm klăh iên.” <verse eid="MRK 7:13" /><verse number="14" style="v" sid="MRK 7:14" />Jêh hư̆n jai jêh kuôl uôn lan trôh, Khua Yang ngơi ta hên: “Lĕ mơt pu me ăn iêt ăñ jêh iên gư̆t wơng: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />so mau ju mta pơp băh ling ju nau nêh ĕh mư̆t mŏng nêh hư̆n dơi ĕh lăm ƀơ̆ nêh hư̆n ôh; ƀê̆ dăh đơ grăp pơp dŏng băh nuông tŏ ĕh du băh kăn hư̆n jêng grăp pơp ĕh lăm ƀơ̆ ñơ̆ nai.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />(Ndă nêh tơm mau tôr no di iêt, ăn iêt.)<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Jai Khua Yang sak mư̆t mŏng hih, wăč băh pôl ŏk, băl ƀing kna Yang di lup Khua Yang yơng ta pơp hơ hôr hư̆n. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Khua Yang ngơi ta hên: “Kơt iên ru pu me ăt ñăm mau pơp gư̆t wơng ya lăh? Pu me so gư̆t năl lăh grăp pơp dŏng băh ling ĕh mư̆t mŏng nêh so dơi ĕh lăm ƀơ̆ ñơ̆ nêh hư̆n ôh? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Bơ yơng ĕh so dơi mư̆t mŏng nuih nhăm nêh, ƀê̆ dăh ĕh mư̆t mŏng khŭng, jêh hư̆n ĕh du ta ling mŏng hih djăh tŏ (hư̆n jêng grăp pơp sông sa ƀrăh ngôr gơ gu.)” <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Ƀê̆ dăh Khua Yang ngơi klăh iêu: “Pơp ĕh du băh dơk nai pơp hư̆n ĕh lăm ƀơ̆ ñơ̆ nai. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Bơ yơng băh nuông tŏ, ĕh lôh băh nuih nhăm kuôn nêh, lăm ndơp grăp pơp mĭn ƀai, čhơng tăt, tŭng tlĕ, lăm khư̆t nêh, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />dŏng tư̆r, he khơñ, djŏh ƀai, mblơm mblam, pliă plia, kuôn măt tŏng nač, păh rak, mhŏ mgao, čhul bliêl. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Grăp pơp ƀai ho ĕh lôh băh nuông tŏ ta ling jêh iên ĕh lăm ƀơ̆ ñơ̆ nai.”<verse eid="MRK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Jêh hư̆n jai jêh du băh iên, Khua Yang sak trôh ta wăl Ti-rơ jêh iên Si-đôn, jêh iên jai jêh mư̆t mŏng ƀơn hih, Khua Yang so khơñ mau nêh gư̆t, ƀê̆ dăh so dơi srôm săk ôh. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Ƀê̆ dăh mông hư̆n rŏk, ju nau nêh u ur hư̆n, jêng nêh mau kuôn ur dêt de di geh yang djŏh mư̆t, bơ yơng jêh tŏng pĕh yơng ta Khua Yang, hư̆n jai trôh iên, de čư̆p măt ta jŏng Khua Yang. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Mông hư̆n, de u ur hư̆n jêng nêh Grek, nguôl de băh Si-rô-phê-ni-si, jêh iên de kôh dăn Khua Yang no di Khua Yang prŏh yang djŏh du băh kuôn ur de. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Khua Yang ngơi ta de: “Luôr hĭn, ăn ta ŏh kuôn dơi sa hơm luôr, bơ yơng ngĭn ngăn so găl ôh ndă sŏk ƀăñ ŏh kuôn di jêh iên čĕ ta sau kuôn.” <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Ƀê̆ dăh de boh pơp jêh iên ngơi ta Khua Yang: “Geh ngăn, wơ Khua Yang, jêh iên đơ sau kuôn mŏng sô̆ jhưng ĕh sa băh đơ djăh ƀăñ ŏh kuôn di.” <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Hư̆n jêng Khua Yang ngơi ta de: “Yơng băh pơp ngơi ho, e du yơh. Yang djŏh jêh ĕh du băh kuôn ur e ru.” <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Jai de du trôh ta hih, de so kuôn sei dêt bê̆ tŏng jhưng, jêh iên yang djŏh jêh ĕh du.<verse eid="MRK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Jêh iên ju dŏ hư̆t, jai jêh du băh wăl Ti-rơ, Khua Yang găn gao uôn ram Si-đôn trôh dak sĭ Ga-li-lê, trôh mŏng mbar wăl Đê-ka-ƀô-lơ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Nai sak ndơp ta Khua Yang ju nau nêh tư̆k jêh iên mblo, jêh hư̆n hên kôh dăn Khua Yang, no di Khua Yang bi ti tŏng kăn hư̆n. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Jai jêh đŏh kăn hư̆n du băh pôl ŏk, Khua Yang ăn grăp kuôn ti Yang di tŏng bar trôm tôr kăn, jêh iên jêh čhŏh dak diêu ru, Khua Yang ñŏh tŏng piêt kăn. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Jêh iên ngơk măt iêu trôk tê̆, Khua Yang drôh nhăm, jêh hư̆n ngơi ta kăn: “Ep-pha-ta,” (lơ lang jêng: “Ăn pŏk gơñ!”). <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Kơt iên tôr kăn hư̆n ang bhơng, pơp dăng mŏng piêt kăn dơi nga, jêh iên kăn dư̆ng ngơi klă nơn. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Khua Yang ghă hên no di ơn hên têh ta nai. Ƀê̆ dăh Khua Yang ndôl ghă hên, hên ndôl wêh têh sơm pơp hư̆n ktang hĭn băh iên ya. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Nai bêng pơp hơ̆ hă, nai ngơi: “Kăn hư̆n jêh mhŏ grăp bruă găl gơ gu. Tăl, kăn dơi mhŏ ta nêh tư̆k dơi tŏng jêh iên nêh mblo dơi ngơi.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Mŏng grăp nar hư̆n, wêh mau ju pôl uôn lan ŏk ngăn, jêh iên so mau ju mta pơp no di sa, jai jêh kuôl băl ƀing kna Yang di, Khua Yang ngơi ta hên: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Ăñ tŏng đač ta pôl uôn lan ho, bơ yơng hên gŭk răn băk ăñ trôh ta pei nar ho ru ƀê̆ dăh ñăm mau ju mta pơp no di sa. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Ndă ăñ yua hên du ta hih hên ta ndư̆l nguôt, hư̆n hên jrăng wiên mŏng nuông truông, jêh iên ƀơ ƀă nêh mŏng hên trôh băh tŭk wăč ngăn.” <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Băl ƀing kna Yang di ngơi ta Khua Yang klăh iêu: “Nêh tơm mau ta o, mŏng tŭk ngă nguôi ho, u băh tŭk dơi sŏk no di ăn ta băl uôn lan klăh iêu ƀăñ sa ho?” <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Khua Yang lup hên: “Pu me mau ŏk mlăm ƀăñ?” Hên têh: “Pŏh mlăm.” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Khua Yang ăn uôn lan gŭk mŏng teh, jêh iên jai jêh sŏk pŏh mlăm ƀăñ, lăh găl, Khua Yang phič jêh iên jao ta băl ƀing kna Yang di no di hên sak tŏng phă, kơt iên hên sak phă ta băl uôn lan. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Jêh iên hên mau ƀê̆ ka kuôn nê̆, hư̆n yơh jai jêh lăh găl yơng ta ka hư̆n, Khua Yang ngơi hên no di hên sak phă lĕ mơt ka hư̆n ya. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Uôn lan sa jêh iên dơi hơm, jêh hư̆n hên dôñ mau pŏh bai ƀăñ djăh hôm khăñ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Mông hư̆n, mau năng ai puôn bau nau nêh, jêh hư̆n Khua Yang ăn hên du. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Mhăč rŏk, jai jêh mư̆t mŏng plŭng ju băk băl ƀing kna Yang di, Khua Yang sak trôh wăl Đa-ma-nu-tha.<verse eid="MRK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Băl Pha-ri-si trôh ta iên jêh hư̆n hên dư̆ng tŏng nhan ta Khua Yang, hên khơñ so mŏng Khua Yang ƀơn pơp myang băh trôk, no di lông Khua Yang. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Jai jêh ndrôh djha mŏng nuih nhăm tŏ, Khua Yang ngơi: “Pơp mhŏ nuk ho khơñ so pơp myang? Ngĭn ngăn, ăñ ngơi ta pu me, so mau ƀơn pơp myang jrăng dơi ăn ta nuk băl ho ôh …” <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Jêh hư̆n jai jêh ndrŏh hên, wêh mư̆t mŏng plŭng, Khua Yang găn gao hang đăh tŏ.<verse eid="MRK 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Băl ƀing kna jăng wăr ñôt ƀăñ, jêh iên hên so mau ju mta pơp băk săk mŏng plŭng, čuôm gu ju mlăm ƀăñ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Khua Yang buôi hên klăh iêu: “Ăn dlăng nư̆k! Ăn gư̆t răng yơng ta pei băl Pha-ri-si di jêh iên pei Hê-rôt di.” <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Hên tŏng ngơi ro do ndăng hên klăh iêu bruă ho jêng yơng băh hên so ñôt ƀăñ. <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Bơ yơng gư̆t klăh iên, Yang Yê-su ngơi ta hên: “Pơp mhŏ pu me tŏng ngơi ro do yơng ta bruă pu me so mau ƀăñ? Pu me ñăm kăh tôr, jêh iên ăt ñăm gư̆t wơng lăh? Geh ya nuih nhăm pu me jêh ñjêng krăk dăng ru? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Mau măt ƀê̆ dăh so pu me so lăh? Mau tôr ƀê̆ dăh pu me so dơi tŏng lăh? Pu me ăt so kăh wơi ya lăh? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Jai ăñ phič prăm mlăm ƀăñ ta prăm bau nau nêh, dŏng ŏk bai bêng ƀăñ khăñ pu me dơi dôñ?” Hên têh ta Khua Yang: “Măt bar bai.” <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />“Mă năng pŏh mlăm ƀăñ ta puôn bau nau nêh, dŏng ŏk bai bêng ƀăñ khăñ pu me dơi dôñ?” Hên têh ta Khua Yang: “Pŏh bai.” <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Jêh hư̆n Khua Yang ngơi ta hên: “Đô̆ nă mhŏ no di pu me ñăm gư̆t wơng?”<verse eid="MRK 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Hên sak trôh Ƀêt-sai-đa, jêh iên nai sak ndơp ta Khua Yang ju nau nêh tiêh, jêh iên hên kôh dăn Khua Yang no di Khua Yang dơi bi ti ta kăn hư̆n. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Kŏng ti nêh tiêh, Khua Yang têk kăn hư̆n du ta ling uôn. Jai jêh čhŏh dak diêu tŏng măt kăn, bi ti Yang di tŏng săk kăn, Khua Yang lup kăn: “Me dơi so djăp pơp ya?” <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Ngơk dlăng tŏng tê̆, kăn ngơi: “Ăñ so nai ƀê̆ dăh dlăng hên ndrơm tơm jhi jai sak.” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Jêh hư̆n, wêh ju dŏ hư̆t, Khua Yang bi ti tŏng măt kăn, jêh iên kăn dlăng goh iêu tŏ, pơp ngo dơi băh jêh iên kăn dơi so grăp pơp ta pơp klă nơn. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Khua Yang yua kăn du hih kăn di, jêh iên tơ tă: “Ei ru sak mư̆t mŏng uôn.”<verse eid="MRK 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Yang Yê-su wăt ta băl ƀing kna Yang di sak mư̆t mŏng grăp uôn đăm čar Sê-sa-rê Phi-lip, jêh iên jai sak truông, Khua Yang lup băl ƀing kna Yang di, ngơi ta hên klăh iêu: “Nai ngơi ăñ jêng nêh tơm?” <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Jêh hư̆n hên têh ta Khua Yang, ngơi klăh iêu: “Yô-han Ƀap-tit, mau nêh ngơi ‘Ê-li,’ mau ya nêh ngơi jêng: ‘Ju nau mŏng băl khua têh luôr.’” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Khua Yang lup hên: “Bơ pu me lăh ăñ jêng nêh tơm?” Jêh hư̆n mông ngơi, Pê-trôih ngơi ta Khua Yang: “Khua jêng Yang Tŏng Tlĕh.” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Khua Yang buôi hên klăh iêu hên so dơi têh ta nai yơng ta Khua Yang ôh.<verse eid="MRK 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Jêh iên Khua Yang dư̆ng tơ ti hên klăh iêu Kuôn Nêh jrăng tŭ ŏk pơp ji knap, tŭ nai ndrŏh lat yơng băh băl khua u rañ, băl khua mhŏ yang ram wăt ta băl khua tơ ti pơp bhiên, jêh iên nai lăm khư̆t lat, jêh hư̆n pei nar ta kơi wêh dŏk brêh. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Khua Yang ngơi pơp ho klă klư̆ng nơn. Pê-trôih, jai jêh đŏh Khua Yang tŭk dêh, dư̆ng ƀuăh ñjăm Khua Yang. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Ƀê̆ dăh, jai jêh wiêng dlăng iêu băl ƀing kna Yang di, Khua Yang ôt ñjăm Pê-trôih klăh iêu: “Wơ Sa-tan, ăn du lat băh kơi ăñ! Bơ yơng me so ăn nuih nhăm me mĭn ta bruă Yang Trôk di ôh, ƀê̆ dăh čuôm gu ta bruă kuôn nêh.” <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />Jai jêh kuôl băl uôn lan wăt băl ƀing kna Yang di, Khua Yang ngơi ta hên: “Ndă nêh tơm khơñ hui gre ta kơi ăñ, nêh hư̆n ăn ndrŏh lat kăn tơm, tung jhi tăm kăng kăn di jêh iên gre ăñ. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Bơ yơng đơ nêh tơm khơñ tlĕh pơp brêh kăn, hư̆n jrăng lăm nga ĕh, bơ nêh tơm yơng băh ăñ jêh iên Pơp Găl jrăng tŭ ư lăm nga pơp brêh kăn, hư̆n jrăng dơi lăm tlĕh ĕh. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Bơ yơng năn pơp tŭ dơn ta nêh dơi mau lĕ dôn teh ƀê̆ dăh nga lat ngăt nhuôl kăn di? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Năn pơp nêh hư̆n jrăng sŏk no di mlih hư̆t ngăt nhuôl kăn? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Ndă nêh tơm tŏng prêng yơng ta ăñ jêh iên yơng ta pơp ngơi ăñ ji mŏng nuk čhơng tăt jêh iên tih djŏh ho, hư̆n Kuôn Nêh ăt jrăng prêng ya yơng ta nêh hư̆n jai Khua Yang trôh mŏng guh ang Bap Yang di wăt ta băl myang ƀrăh.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Khua Yang ngơi ta hên: “Ngĭn ngăn, ăñ ngơi ta pu me klăh iêu mau ƀơ ƀă nêh jai gŭk ta o hư̆n jêng băl ngĭn ngăn so găn gao pơp khư̆t luôr ta hên dơi so uôn tŏng trôk Yang Trôk di trôh ta pơp myang.” <verse eid="MRK 9:1" /><verse number="2" style="v" sid="MRK 9:2" />Pro nar ta kơi, Yang Yê-su ndơm Pê-trôih, Ya-kơ jêh iên Yô-han jêh hư̆n ndơm dêh ju nau hên sak čơng tŏng bôk yôk jua, jêh iên Khua Yang mlih săk jăn ta măt hên. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Ao Khua Yang ĕh ñjêng tlŏh nŏh sang ƀrăh, ang dơr, tăl so mau nêh nă pih mŏng dôn teh dơi mhŏ đat ang klăh iên. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ê-li ta Mô-ih dơi hên mau so, jêh iên bar nau hên hư̆n jai tŏng ngơi ta Yang Yê-su. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Jai pŏk dơk, Pê-trôih ngơi ta Yang Yê-su: “Wơ Ra-ƀi, găl ngăn yơh jêng băl băn gŭk ta o, băl hi jrăng lăm ndŏk pei mlăm tư̆m, ƀơn ta khua, ƀơn ta Mô-ih jêh iên ƀơn ta Ê-li.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />(Bơ yơng kăn so gư̆t năn pơp kăn jrăng ngơi, yơng băh lĕ hên ndrăt gơ gu.) <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Jêh hư̆n mau ñuôi tŭk ram sak guôm lư̆m hên, jêh iên mau dơk ngơi ĕh wao băh ñuôi tŭk: “Ho jêng Kuôn khăp ngăn Ăñ ji. Ăn gưt dơk Kuôn hư̆n.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Măp gu, jai dlăng jư̆m dar, hên so hôm so ju nau nêh dêh gŭk băk hên ôh, čuôm gu ju nau Yang Yê-su.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Jăng jai hên jư̆r băh yôk, Khua Yang tơ tă hên klăh iêu hên so dơi têh hư̆t ta nai yơng ta lĕ mơt pơp jêh hên so, ndă ñăm trôh mông Kuôn Nêh băh tŭk khư̆t wêh dŏk brêh. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Hên ñăt kriêp pơp ngơi hư̆n mŏng mbar hên, tŏng ngơi dêh ndăng hên pơp “băh tŭk khư̆t wêh dŏk brêh” hư̆n jêng đô̆ nă. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Hên mau pơp lup ta Khua Yang, hên ngơi: “Pơp mhŏ băl khua tơ ti pơp bhiên ngơi kăn Ê-li geh trôh luôr?” <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Jêh hư̆n Khua Yang ngơi ta hên: “Ê-li geh ru jêng nêh trôh luôr no di lăm ndŏk hư̆t grăp bruă. Ndă iên pơp ngơi jêh čih yơng ta Kuôn Nêh klăh iêu Khua Yang jrăng tŭ ŏk pơp knap mñai jêh iên tŭ pơp hêr mưč jêng đô̆ nă? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ƀê̆ dăh, ăñ ngơi ta pu me klăh iêu Ê-li jêh trôh ngăn ru, jêh iên nai jêh mhŏ ŏk mŏk pơp hên khơñ mhŏ ta kăn, trip klăh di pơp ngơi jêh dơi čih yơng ta kăn.”<verse eid="MRK 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Jai sak trôh ta tŭk băl ƀing kna dŏng iên, hên so ju pôl uôn lan ŏk ngăn jư̆m dar hên jêh iên đơ băl tơ ti pơp bhiên jai tŏng nhan ta băl ƀing kna hư̆n. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Mông hư̆n rŏk, jai jêh so Khua Yang, lĕ ju pôl uôn lan hơ̆ hă, jêh hư̆n jai jêh hên sak trôh ta Khua Yang, hên tŭ drông Khua Yang. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Khua Yang lup băl ƀing kna: “Pu me jai tŏng nhan ta hên yơng ta năn bruă hư̆n?” <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Ju nau mŏng băl pôl ŏk têh ta Khua Yang: “Wơ khua, ăñ sak ndơp ta khua kuôn tlau ăñ ji, geh ƀơn čak mblo mư̆t. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />U ta tŭk dơi ĕh mhŏ kuôn ăñ, mông hư̆n ĕh we kăn mŏng sô̆, jêh hư̆n kăn mbôh dak diêu, kriêt sêk, jêh iên dăng ngơng, ăñ sak dăn ru ta băl ƀing kna khua di no di hên prŏh ĕh, ƀê̆ dăh hên so djăp pơp ktang.” <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Mông hư̆n, jai boh pơp hên, Khua Yang ngơi: “Wơ pôl nhuôr dăng nuih, ăñ jrăng gŭk băk pu me tăl trôh ta năn mông? Ăñ jrăng gir pu me tăl trôh ta năn mông? Ăn ndơp kuôn sei trôh ta ăñ o.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Hên ndơp kuôn sei trôh ta Khua Yang, jêh iên jai so Khua Yang, yang djŏh mhăč rŏk ĕh mhŏ kăn dư̆ng đhŏk săk jăn, jêh hư̆n jai ĕh bông mŏng teh, kăn lơ lăm, jêh iên mbôh dak diêu. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Khua Yang lup bap kăn: “Dŏng ŏk ru dŏ dŏng băh mông bruă ho ĕh trôh ta kăn?” Kăn têh: “Dŏng băh dêt. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ĕh krĕh lăm bông kăn, tăp năng mŏng iñ, tăp năng mŏng dak, no di lăm rai kăn, ƀê̆ dăh ndă di khua dơi mhŏ năn bruă, yơng băh đač băl hi, dăn khua đru un băl hi.” <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Mông hư̆n, Yang Yê-su ngơi ta kăn: “‘Ndă di khua dơi mhŏ’ lăh? Grăp bruă dơi gơ gu yơng ta nêh mau pơp đăo.” <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Mhăč rŏk, jai jêh ôr tĕh, bap kăn kuôn sei ngơi: “Ăñ đăo! Dăn khua đač un mŏng pơp so đăo ăñ ji!” <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Jêh hư̆n jai jêh so pôl ŏk sak trôh ta tŭk hên, Yang Yê-su prŏh yang djŏh, ngơi ta ĕh klăh iêu: “Wơ čak mblo jêh iên tư̆k, ăñ yua me ăn du băh kuôn sei jêh iên so hôm dơi wêh mư̆t mŏng kăn ôh.” <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Jai jêh ôr tĕh jêh iên ĕh lăm đhŏk kăn ktang, ĕh du băh kăn jêh iên kăn kuôn sei hư̆n ĕh mhŏ klăh di nêh khư̆t, tăl ŏk nêh nai ngơi klăh iêu: “Kuôn sei ho khư̆t ru.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ƀê̆ dăh jai kŏng ti kăn, Yang Yê-su lăm ndŏk kăn tŏng tê̆, jêh iên kăn kuôn sei dŏk. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />Jai Khua Yang jêh mư̆t mŏng hih ru, băl ƀing kna Khua Yang lup muôč Khua Yang klăh iêu: “Pơp mhŏ băl hi so dơi prŏh yang djŏh hư̆n?” <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Khua Yang ngơi ta hên: “Pôl čak ho, so mau nêh dơi prŏh ĕh ndă so knang ta pơp kuôl dăn jêh iên ngăl sa.”<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Jêh iên du băh tŭk hư̆n, hên găn gao čar Ga-li-lê, ƀê̆ dăh Khua Yang so khơñ ăn nai gư̆t, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />bơ yơng Khua Yang jai tơ ti băl ƀing kna Yang di, jêh iên ngơi ta hên klăh iêu: “Kuôn Nêh mơñ nai jao mŏng plang ti nêh tih, hên jrăng lăm khư̆t lat Khua Yang. Jai jêh nai lăm khư̆t, Khua Yang jrăng wêh brêh ta kơi pei nar.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Ƀê̆ dăh hên so gư̆t wơng pơp ho, jêh iên bhŭng so năñ lup Khua Yang. <verse eid="MRK 9:32" /><verse number="33" style="v" sid="MRK 9:33" />Hên sak trôh ta uôn Ka-ƀê-na-um, jêh iên jai mư̆t mŏng hih, Khua Yang lup hên: “Năn pơp pu me krĕh trông čhai jai sak truông?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Ƀê̆ dăh hên gŭk miêt, bơ yơng hên jêh tŏng nhan ndăng hên păt truông sak khơñ gư̆t nêh tơm jêng ram hĭn. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Jai jêh gŭk mŏng sô̆, Khua Yang kuôl măt bar nau ƀing kna tŏng ƀư̆n ju tŭk jêh iên ngơi ta hên: “Ndă nêh tơm khơñ ñôt bôk, nêh hư̆n ăn ñjêng nêh ta kơi dư̆t mŏng lĕ mơt nêh jêh iên ñjêng dư̆k ta grăp nêh.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Săč ruăh ju nau kuôn sei dêt, Khua Yang ăn kuôn sei hư̆n mŏng mbar hên, jêh hư̆n jai jêh u kuôn sei mŏng ti, Khua Yang ngơi ta hên: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Nêh tơm sŏk năn ăñ ruôm ju nau mŏng băl ku sei klăh iêu ho jêng nêh hư̆n ruôm ăñ, jêh iên nêh tơm ruôm ăñ hư̆n jêng so mau čuôm gu ruôm ăñ ôh, ƀê̆ dăh hư̆n jêng ruôm Mtao yua ăñ trôh.” <verse eid="MRK 9:37" /><verse number="38" style="v" sid="MRK 9:38" />Yô-han ngơi ta Khua Yang: “Wơ khua, băl hi tuôm so ju nau nêh hư̆n sŏk năn khua di prŏh yang djŏh jêh iên băl hi tuôm ghă nêh hư̆n, bơ yơng nêh hư̆n so hui gre băl băn.” <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Ƀê̆ dăh Yang Yê-su ngơi: “Ei ru ghă nêh hư̆n, bơ yơng so mau nêh jêng nêh sŏk năn ăñ mhŏ pơp myang jêh iên ta kơi hư̆n rŏk lŏ wêh tăm păh ăñ. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Bơ yơng nêh tơm so geh jêng nêh tăm dăng ta băl băn hư̆n jêng nêh ting ju băl băn. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Bơ yơng nêh tơm sŏk năn ăñ ăn ta pu me ju kčok dak bơ yơng pu me jêng nêh ting ju Yang Tŏng Tlĕh, ngĭn ngăn ăñ ngơi ta pu me klăh iêu nêh hư̆n ngĭn ngăn yơh so nga pơp khôm kăn ƀă. <verse eid="MRK 9:41" /><verse number="42" style="v" sid="MRK 9:42" />Bơ nêh tơm lăm păk bông ju nau mŏng băl kuôn sei ho jêng băl nêh đăo ta năn ăñ, găl hĭn mhŏ ta kăn hư̆n, pơp găl hĭn jêng kăn tŭ pơp nai kăt ƀơn păl mau ram jư̆m dar ko kăn, jêh hư̆n nai čĕ mŏng dak sĭ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ndă plang ti pu me lăm păk bông me, ăn ndăč lat ĕh. Pơp găl hĭn ta pu me jêng nga ju khăn săk jăn ƀê̆ dăh mư̆t mŏng pơp brêh, ta mau nư̆m bar plang ti ƀê̆ dăh sak mư̆t mŏng war iñ, mŏng iñ so dơi khư̆t <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />(jêng tŭk hai ndrŭng băl ĕh so khư̆t, jêh iên iñ so nă khư̆t). <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Ndă plang jŏng pu me lăm păk bông pu me, ăn ndăč lat ĕh. Pơp găl hĭn ta pu me jêng nga ju đăh jŏng ƀê̆ dăh mư̆t mŏng pơp brêh, găl hĭn ta mau bar đăh jŏng ƀê̆ dăh nai čĕ mŏng war iñ <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />(tŭk hai ndrŭng băl ĕh so khư̆t, jêh iên iñ so nă khư̆t). <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ndă măt pu me ĕh lăm pu me păk bông, ăn liêk lat ĕh. Pơp găl hĭn ta pu me jêng nga ju đăh măt ƀê̆ dăh mư̆t mŏng uôn tŏng trôk Yang Trôk di, ta hôm nư̆m bar đăh măt ƀê̆ dăh nai čĕ mŏng war iñ, <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />tŭk hai ndrŭng băl ĕh so khư̆t jêh iên iñ so nai lăm khư̆t. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />Bơ yơng grăp nau nêh jrăng geh buôh ta iñ. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />Buôh jêng pơp găl, ƀê̆ dăh ndă buôh ñjêng nga pơp tiêt ĕh, Năn pơp pu me jrăng mbăč ta ĕh? Ăn pu me mau buôh mŏng pu me, jêh iên brêh geh guôp ndăng găp.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Jêh dŏk tŏng tê̆, Khua Yang sak băh tŭk hư̆n trôh ta wăl Yu-đê jêh iên wăl teh đăh tŏ dak kruông Yô-đan, jêh hư̆n uôn lan tŏng ndơm sak trôh ta Khua Yang ju dŏ hư̆t. Khua Yang wêh tơ ti hên klăh di Khua Yang krĕh mhŏ. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Jai băl Pha-ri-si sak mơñ, hên lup Khua Yang pơp bhiên dơi ăn ju nau nêh sai ndrŏh lat ur mdăh so, no di khơñ lông Khua Yang. <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Ƀê̆ dăh, no di boh pơp hư̆n, Khua Yang ngơi ta hên klăh iêu: “Đô̆ nă pơp jêh kăn Mô-ih tơ tă pu me?” <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />Hên ngơi: “Mô-ih ăn pơp dơi ta nêh sai čih ju pŏk ră tŏng ndrŏh jêh hư̆n lơi de du.” <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />Ƀê̆ dăh Yang Yê-su ngơi ta hên: “Yơng băh pơp dăng nuih pu me, hư̆n kăn čih pơp tơ tă klăh iên ta pu me. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Gao băh iên, dŏng băh mhei rih ñjêng trôk teh,</para>
  <para style="q1" vid="MRK 10:6">‘Khua Yang jêh rih ñjêng hên, ju nau tlau jêh iên ju nau ur.’<verse eid="MRK 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 10:7" />‘Yơng hư̆n yơh, nêh tlau jrăng yĕh băh bap jêh iên mei kăn,<verse eid="MRK 10:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="MRK 10:8" />jêh iên bar nau hên jrăng ñjêng ƀơn lŏng săk.’</para>
  <para style="m" vid="MRK 10:8">Hư̆n yơh, hên so hôm jêng bar ôh ƀê̆ dăh jêng ƀơn lŏng săk. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Hư̆n yơh, năn pơp jêh Yang Trôk tăm tlăč ru, hư̆n kuôn nêh so dơi tăm tlăh ôh.” <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />Jai gŭk mŏng hih, băl ƀing kna wêh lup Khua Yang yơng ta bruă ho. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Khua Yang ngơi ta hên: “Nêh tơm ndrŏh lat ur kăn jêh iên sai nêh dơ dêh, nêh hư̆n mhŏ tih dŏng tư̆r yơng ta ur kăn. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Jêh iên ndă nêh u ur, jai jêh ndrŏh sai de, sai nêh dêh, hư̆n de yơh mhŏ tih dŏng tư̆r.”<verse eid="MRK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Nai sak ndơp ta Khua Yang đơ băl kuôn sei dêt no di Khua Yang dơi bi ti tŏng băl ĕh, ƀê̆ dăh băl ƀing kna ƀuăh ñjăm hên. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Ƀê̆ dăh, jai jêh so pơp hư̆n, Yang Yê-su hao nuih jêh iên ngơi ta hên: “Ăn băl kuôn sei dêt trôh ta ăñ o, jêh iên ei ru ghă băl ĕh, bơ yơng uôn tŏng trôk Yang Trôk di ting ju nêh tơm ndrơm klăh di băl ĕh. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Ngĭn ngăn, ăñ ngơi ta pu me, nêh tơm so sŏk ruôm uôn tŏng trôk Yang Trôk di klăh di kuôn sei dêt, nêh hư̆n ngĭn ngăn so dơi mư̆t mŏng iên ôh.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Jai jêh u băl kuôn sei hư̆n mŏng ti Yang di, bi ti tŏng băl ĕh, Khua Yang ăn pơp găl jôn ta băl ĕh.<verse eid="MRK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Jai Khua Yang dư̆ng sak truông, mau ju nau nêh trôh ta iên, jêh hư̆n jai jêh čuôn krŭng ta măt Khua Yang, nêh hư̆n lup Khua Yang: “Wơ Khua Nhăp Găl, năn bruă ăñ jrăng mhŏ no di ăñ dơi dơn pơp brêh hui hai?” <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Ƀê̆ dăh Yang Yê-su ngơi ta kăn: “Pơp mhŏ me kuôl ăñ jêng nhăp găl? So mau nêh nhăp găl ôh čuôm gu ju nau Yang Trôk. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Me gư̆t ru grăp pơp bhiên: ‘Ei ru lăm khư̆t nêh, ei ru dŏng tư̆r, ei ru tŭng tlĕ, ei ru ngơi huôk, ei ru mhŏ mblơm, ăn gư̆t mpŭ bap jêh iên mei me.’” <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />Ƀê̆ dăh kăn ngơi ta Khua Yang: “Wơ khua, ăñ jêh ñôt grăp pơp hư̆n dŏng băh dêt ăñ ru.” <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Ƀê̆ dăh jai dlăng iêu kăn, Yang Yê-su khăp kăn, jêh iên Khua Yang ngơi kăn: “Me hôm bhơi ƀơn pơp; ăn sak, blơ̆ lĕ mơt pơp me mau, phă gai ta nêh ƀun, hư̆n me jrăng mau ngăn yuôm tŏng trôk, jêh iên sak ta o gơñ, ăn gre ăñ.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Ƀê̆ dăh môh măt ĕh ñjêng nguôt nư̆ng jai tŏng pơp ngơi hư̆n, kăn nguôt nư̆ng du băh iên, bơ yơng kăn jêng nêh mau ŏk ngăn drăp.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Jai jêh dlăng jư̆m dar, Yang Yê-su ngơi ta ƀing kna Yang di: “Dlĕh ngăn yơh yơng ta băl mau ŏk ngăn drăp no di dơi mư̆t mŏng uôn tŏng trôk Yang Trôk di!” <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Băl ƀing kna hơ̆ hă ngăn yơng ta grăp pơp ngơi Yang di, ƀê̆ dăh wêh ju dŏ hư̆t, jai boh dơk, Yang Yê-su ngơi ta hên klăh iêu: “Wơ băl kuôn, dlĕh ngăn yơh đô̆ nă mhŏ no di mư̆t mŏng uôn tŏng trôk Yang Trôk di! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Yơng ta kuôn lak đa mư̆t mŏng trôm nư̆ng, hư̆n jêng bruă lưih hĭn ta nêh ndrŏng mư̆t mŏng uôn tŏng trôk Yang Trôk di.” <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Jêh hư̆n hên hơ̆ hă ngăn yơh, ngơi ta Khua Yang: “Ndă iên nêh tơm dơi tlĕh?” <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />Dlăng iêu hên, Yang Yê-su ngơi: “Pơp so dơi yơng ta kuôn nêh, ƀê̆ dăh so geh ta Yang Trôk. Bơ yơng ta Yang Trôk, grăp bruă dơi gơ gu.” <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Pê-trôih pŏk dơk ngơi ta Khua Yang: “Khua dlăng ho, băl hi jêh ndrŏh grăp pơp no di gre khua.” <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />Yang Yê-su ngơi: “Ngĭn ngăn, ăñ ngơi ta pu me, so mau nêh ndrŏh hih tư̆m, ŏh mi, rôh mei, bap mei, ŏh kuôn, teh bri yơng băh ăñ jêh iên Pơp Găl, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />no di so dơi dơn khăñ ju hiêng dŏ mông ho mŏng nuk ho: yơng ta hih tư̆m, ŏh mi, rôh mei, mei, kuôn, teh bri wăt ta pơp kpĭ kpiêt, jêh iên pơp brêh hui hai mŏng nuk jrăng trôh. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ƀê̆ dăh ŏk nêh bôk măt jrăng ñjêng kơi dư̆t, jêh iên nêh kơi dư̆t jrăng ñjêng bôk măt.”<verse eid="MRK 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Mông hư̆n, hên jai sak truông trôh ta Yê-ru-sa-lem, jêh iên Yang Yê-su jai sak luôr hên. Hên ndrăt, bơ băl nêh hui gre kơi hên bhŭng ngăn. Jai jêh ndơm măt bar ƀing kna tŭk dêh, Khua Yang wêh dư̆ng ngơi ta hên đơ bruă jrăng trôh ta Khua Yang, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />klăh iêu: “Dlăng ho, băl băn jai sak trôh Yê-ru-sa-lem, jêh iên Kuôn Nêh jrăng tŭ nai jao ta băl khua mhŏ yang ram jêh iên băl tơ ti pơp bhiên, jêh hư̆n hên jrăng kčăh dôih khư̆t ta Khua Yang jêh iên jao Khua Yang ta băl ling lač. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Hên jrăng tăm păh Khua Yang, čhŏh mưč Khua Yang, pŭ bang Khua Yang, jêh iên lăm khư̆t Khua Yang, ƀê̆ dăh ta kơi pei nar Khua Yang jrăng wêh dŏk brêh.”<verse eid="MRK 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ya-kơ jêh iên Yô-han, bar kuôn tlau kăn Sê-ƀê-đê, sak tŏng tuôm Khua Yang, ngơi ta Khua Yang: “Wơ khua, băl hi khơñ ngăn đơ năn pơp băl hi dăn ta khua, khua jrăng mhŏ un ta băl hi.” <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Jêh hư̆n Khua Yang ngơi ta hên: “Năn pơp pu me khơñ ăñ mhŏ ta pu me?” <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Hư̆n jêng hên ngơi ta Khua Yang: “Dăn dăp băl hi no di băl hi dơi gŭk mŏng tŭk guh ang khua di, ju nau đăh ma khua jêh iên ju nau đăh kiêu khua.” <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Ƀê̆ dăh Yang Yê-su ngơi hên: “Pu me so gư̆t năn pơp pu me jai dăn ôh. Dơi ya pu me ñêt čiên jêng pơp ăñ ñêt, mdăh tŭ ƀap-tem klăh di ƀap-tem jêng pơp ăñ tŭ?” <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Hên ngơi ta Khua Yang: “Băl hi dơi ya.” Jêh hư̆n Yang Yê-su ngơi ta hên: “Čiên jêng pơp ăñ ñêt, pu me jrăng ñêt, jêh iên pơp ƀap-tem jêng pơp ăñ tŭ, pu me jrăng tŭ. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Ƀê̆ dăh no di dơi gŭk đăh ma mdăh đăh kiêu ăñ ji so mau yơng ăñ ôh dăp dăng, ƀê̆ dăh thêm ta nêh jêh nai prê luôr.” <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Jai tŏng bruă hư̆n, măt nau ƀing kna dŏng iên hên mhŏ nuih ta Ya-kơ jêh iên Yô-han. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Jai jêh kuôl hên ta iên, Yang Yê-su ngơi ta hên: “Pu me gư̆t ru đơ băl jêh nai ăn kĕ kriê uôn lan ta ling hên mhŏ ktang ta uôn lan, jêh iên đơ nêh mhŏ khua ram hên di yua pơp dơi hư̆n kĕ kriê nai. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ƀê̆ dăh bruă so mau klăh iên ôh mŏng mbar pu me. Gao băh iên, nêh tơm khơñ ñjêng ram mŏng mbar pu me ăn ñjêng nêh đru bruă pu me, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />jêh iên nêh tơm khơñ jêng bôk mŏng mbar pu me ăn kăn mhŏ dư̆k ta grăp nau nêh. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Bơ yơng Kuôn Nêh tăl jêh sak trôh so ăn nai đru bruă, ƀê̆ dăh no di đru bruă nai jêh iên săl pơp brêh tơm ñjêng nŏh tuai truôk un ta ŏk nêh.”<verse eid="MRK 10:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Hên sak mư̆t uôn Yê-ri-kô, jêh iên jăng jai Khua Yang du băh Yê-ri-kô ju băk ta băl ƀing kna Yang di wăt băl uôn lan ŏk, hư̆n kăn Ƀa-ti-mê, kuôn tlau kăn Ti-mê, jêng ju nau nêh sa dăn tiêh măt jai gŭk kêng truông. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Jai kăn tŏng pĕh ru hư̆n jêng Yang Yê-su nêh Na-sa-ret, kăn dư̆ng ôr tĕh jêh iên ngơi: “Wơ Yê-su, Kuôn mtao Đa-wit, dăn tlŏng đač ăñ!” <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Ŏk nêh ƀuăh ñjăm kăn ho no di kăn gŭk miêt, ƀê̆ dăh kăn wêh ôr tĕh hĭn ya: “Kuôn mtao Đa-wit, dăn tlŏng đač ăñ!” <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Jai jêh hŏng ju tŭk, Yang Yê-su ngơi: “Ăn kuôl kăn ta o.” Jêh iên hên kuôl nêh tiêh hư̆n, ngơi ta kăn: “Man rŭng răng! Ăn dŏk gơñ! Khua jai kuôl me.” <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Jai jêh čĕ ao jhŭng kăn ju đăh, kăn dŏk brik, kăn sak ta Yang Yê-su. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Dơn pơp kăn dăn, Yang Yê-su ngơi: “Năn pơp me khơñ ăñ mhŏ ta me?” Hư̆n nêh tiêh ngơi ta Khua Yang: “Wơ Ra-ƀi, hư̆n jêng ăñ khơñ dơi so.” <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />Kơt iên Yang Yê-su ngơi ta kăn: “Ăn sak. Pơp đăo me di jêh lăm băh ta me.” Mhăč rŏk, kăn dơi so jêh hư̆n kăn hui gre Khua Yang ta truông.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Jai hên sak mơñ trôh Yê-ru-sa-lem, trôh Ƀê-pha-yê jêh iên Ƀê-tha-ni, tŏng iêu yôk Ô-liu, Khua Yang yua bar nau ƀing kna Yang di sak, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />jêh iên ngơi ta hên: “Ăn sak mư̆t mŏng uôn ta măt pu me tŏ, jai jêh sak mư̆t mŏng iên, pu me jrăng so ƀơn ƀle hĕ kuôn nai kăt, ñăm tuôm mau nêh hao tŏng ĕh. Ăn lĕh sei kăt ta ĕh jêh iên ñôt ĕh iêu o. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Ndă mau nêh lup pu me: ‘Pơp mhŏ pu me mhŏ klăh iên?’ hư̆n ăn ngơi klăh iêu: ‘Yang Trôk mau pơp khơñ yua ĕh jêh iên Khua Yang jrăng wêh plơ̆ hư̆t ĕh ya.’” <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Hên sak băh iên jêh iên hên so ƀơn ƀle hĕ kuôn nai kăt trip ƀăng ñjang kêng truông, hư̆n hên lĕh sei ta ĕh. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Mau nêh dŏk ta iên ngơi ta hên: “Năn pơp pu me khơñ mhŏ no di lĕh sei ƀle hĕ kuôn hư̆n?” <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Hên boh hư̆t pơp băl hư̆n klăh di Yang Yê-su jêh tơ tă, jêh iên đơ băl hư̆n lơi hên sak. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Hên ñôt ƀle hĕ kuôn ta Yang Yê-su jêh hư̆n lŏk ao jhŭng hên di tŏng dôn ĕh, jêh iên Khua Yang gŭk tŏng iên. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Ŏk nêh lŏk ao hên ta truông, bơ băl ƀơ ƀă, hên lŏk grăp ha jhi hên srĕh băh tač lŏ. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Lĕ mơt nêh sak ta măt wăt băl hui gre ta kơi hên ôr tĕh:</para>
  <para style="q1" vid="MRK 11:9">“Hô-sa-na! Năng nơ nei Mtao sak trôh mŏng năn Yang Trôk.<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Găl jôn yơh čar jrăng trôh pang yo Đa-wit băl băn di!</para>
  <para style="q1" vid="MRK 11:10">Hô-sa-na mŏng tŭk jua hĭn!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Khua Yang sak mư̆t mŏng uôn ram Yê-ru-sa-lem, mư̆t mŏng hih ƀư̆n, jêh iên jai jêh wiêng dlăng jư̆m dar grăp pơp, bơ yơng mông hư̆n jêh mơñ trôh mho ru, Khua Yang sak trôh ta Ƀê-tha-ni ju băk ta măt bar ƀing kna. <verse eid="MRK 11:11" /><verse number="12" style="v" sid="MRK 11:12" />Nar ta kơi, mông hên jêh du băh Ƀê-tha-ni, hư̆n Khua Yang nguôt. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Jai so ƀơn tơm jhi a ra mau ŏk ha băh wăč, Khua Yang sak, năng ai Khua Yang jrăng so ƀơn bar ple mŏng tơm jhi hư̆n. Ƀê̆ dăh jai jêh trôh tơm jhi hư̆n, Khua Yang so so ju mta pơp ôh čuôm gu ha, bơ yơng ñăm geh ta dơm ple a ra. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Ndrŏh lat bruă ho, Khua Yang ngơi ta tơm jhi hư̆n: “Jrăng so hôm mau nêh nai sa ple băh me ôh.” Băl ƀing kna Yang di tŏng pơp ngơi hư̆n.<verse eid="MRK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Jai sak trôh Yê-ru-sa-lem, jêh iên mư̆t mŏng hih ƀư̆n, Khua Yang dư̆ng prơh băl blŏ nêh ruôt mŏng hih ƀư̆n du ling, Khua Yang lơk bông jhưng băl mlih prăk di jêh iên jhưng băl blŏ sư̆m tơp di, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Khua Yang so ăn ju nau nêh dơi ñôt ju mta pơp sak tăč blŏ mŏng hih ƀư̆n ôh. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Jêh hư̆n Khua Yang tơ ti hên jêh iên ngơi: “So lăh mau pơp čih klăh iêu:</para>
  <para style="q1" vid="MRK 11:17">‘Hih ăñ nai nơ năn jêng hih kuôl dăn ta grăp uôn lan’ lăh?</para>
  <para style="m" vid="MRK 11:17">Ƀê̆ dăh pu me lăm ñjêng ĕh jêng gơp băl tŭng tlĕ.”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Băl khua mhŏ yang ram jêh iên băl tơ ti pơp bhiên tŏng klăh iên, hư̆n hên juôi truông no di dơi hên lăm khư̆t Khua Yang, ƀê̆ dăh hên bhŭng Khua Yang, bơ yơng lĕ mơt uôn lan ŏk hơ̆ hă gơ gu ta pơp tơ ti Yang di. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Trôh mông mho măng, hên du băh uôn ram.<verse eid="MRK 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Trôh ang ôi, jăng jai găn gao tŭk hư̆n, hên so jhi a ra jêh ƀa ro dŏng băh tơm rĕh. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Jai jêh kăh wơi, Pê-trôih ngơi ta Khua Yang: “Ra-ƀi, dlăng tŏ! Jhi a ra jêh khua tăm păh đo lĕ ro ru.” <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Jai boh pơp, Yang Yê-su ngơi ta hên: “Ăn mau pơp đăo mŏng Yang Trôk. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ngĭn ngăn, ăñ ngơi ta pu me, ndă nêh tơm ngơi ta yôk ho: ‘Ăn hơk tŏng tê̆ jêh iên tuôt mŏng dak sĭ,’ ƀê̆ dăh so mau pơp đing nơn mŏng nuih nhăm kăn tŏ, ƀê̆ dăh đăo kjăp ta pơp kăn ngơi jrăng ñjêng ngơ ngăn, bruă hư̆n ĕh jrăng ñjêng ta nêh hư̆n. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Hư̆n yơh, ăñ ngơi ta pu me, lĕ mơt pơp pu me kuôl dăn jêh iên dăn, ăn đăo kjăp pu me jêh dơi dơn ru, pơp hư̆n ĕh jrăng ñjêng ta pu me. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Jai pu me dŏk kuôl dăn, ndă pu me mau bruă hao nuih ta ju nau nêh, hư̆n ăn ndrŏh tih, no di Bap pu me di jêng Mtao gŭk tŏng trôk ăt ndrŏh tih pu me yơng ta grăp pơp tih djŏh pu me di.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />(Ƀê̆ dăh ndă pu me so ndrŏh tih, hư̆n Bap pu me di jêng Mtao gŭk tŏng trôk ăt jrăng so ndrŏh grăp pơp tih djŏh pu me di ya.)<verse eid="MRK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Jêh hư̆n hên lŏ wêh sak trôh Yê-ru-sa-lem jêh iên mông Khua Yang jai sak mư̆t mŏng hih ƀư̆n, băl khua mhŏ yang ram, băl tơ ti pơp bhiên, jêh iên grăp băl khua u rañ sak ta Khua Yang. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Hên ngơi ta Khua Yang: “U tŭk băh pơp dơi no di me mhŏ grăp bruă hư̆n jêh iên nêh tơm jao ta me pơp dơi ho no di me dơi mhŏ grăp pơp hư̆n?” <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Ƀê̆ dăh Yang Yê-su ngơi ta hên: “Ăñ ăt jrăng lup pu me ƀơn pơp ya, jêh iên ăn wêh lăh ta ăñ, jêh hư̆n ăñ jrăng têh ta pu me u băh tŭk pơp dơi ăñ sŏk no di ăñ mhŏ grăp bruă hư̆n. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Pơp ƀap-tem kăn Yô-han jêng băh trôk mdăh băh kuôn nêh? Ăn têh ta ăñ.” <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Hên tŏng trông čhai ndăng hên klăh iêu: “Đô̆ nă băl băn ngơi? Ndă băl băn ngơi: ‘Băh trôk’, nêh ho jrăng ngơi: ‘Ndă iên, pơp mhŏ pu me so tip Yô-han?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Mlih ta iên, ndă băl băn ngơi: ‘Băh kuôn nêh,’ …?” (Băl ĕh bhŭng uôn lan, bơ yơng grăp nau nêh nai dlăng Yô-han ngĭn ngăn jêng ju nau nêh têh luôr.) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Hư̆n yơh jai hên têh ta Yang Yê-su, hên ngơi: “Băl hi so gư̆t.” Yang Yê-su ngơi ta hên: “Ăñ ăt so čiêng têh ta pu me u băh tŭk pơp dơi no di ăñ mhŏ grăp bruă hư̆n.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Khua Yang dư̆ng ngơi ta hên ta pơp hơ hôr: “Ju nau nêh hư̆n tăm mir ño, pêr nêr jư̆m dar, sir ƀăng păt dak ño, lăm ndŏk ju mlăm hih jua, jêh iên ăn ta băl tăm ño mưn mir hư̆n, jêh iên kăn sak čar wăč. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Trôh dơm lêh ple, kăn yua ju nau nêh dư̆k sak ta băl tăm ño no di băh băl ho, kăn dơi dơn ju khăn kao nga băh mir hư̆n. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ƀê̆ dăh jai jêh ñư̆p pŏng knai, băl ĕh pŭ bang jêh hư̆n prơh du ti gai. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Kăn wêh yua ju nau nêh dư̆k dơ dêh sak ta băl ĕh, jêh iên ta kăn dư̆k hư̆n, băl ĕh pŭ tŏng bôk jêh iên mưč mač. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Jêh hư̆n kăn wêh yua dư̆k dơ dêh ya, ta nêh hư̆n, băl ĕh lăm khư̆t, ju băk ta ŏk băl dơ dêh — nar o pŭ bang nêh ho, tŏng o lăm khư̆t nêh dơ dêh. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Kăn hôm gu ju nau nêh, jêng kuôn tlau khăp khơñ ngăn, kăn yua kuôn hư̆n, nêh kơi dư̆t, sak ta băl ĕh, kăn mĭn klăh iêu: ‘Băl ĕh jrăng mpŭ ta kuôn tlau ăñ.’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Ƀê̆ dăh băl tăm ño hư̆n tŏng trông čhai ndăng hên klăh iêu: ‘Ho jêng tlau dơn ngăn. Jơ̆ sak, băl băn lăm khư̆t kăn, jêh hư̆n ngăn drăp kăn dơn hư̆n jrăng ñjêng pơp băn di.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Kơt iên jai jêh ñư̆p čăp, băl ĕh lăm khư̆t kuôn tlau hư̆n, jêh hư̆n čĕ pŏng knai ta ling mir ño. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />Hư̆n yơh, Đô̆ nă khua mir ño jrăng mhŏ? Kăn jrăng sak lăm khư̆t lĕ mơt băl tăm ño jêh iên jao mir ño ta băl dơ dêh. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Pu me ñăm tuôm dlăng pơp ho mŏng Ră Ƀrăh lăh?</para>
  <para style="q1" vid="MRK 12:10">‘Bôk mau jêh băl mhŏ hih ndrŏh lat,</para>
  <para style="q1" vid="MRK 12:10">mau hư̆n jêh ĕh ñjêng mau tur hih.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Bruă hư̆n trôh băh Yang Trôk,</para>
  <para style="q1" vid="MRK 12:11">jêh iên hư̆n jêng bruă ndrơh ngăn ta măt băl băn.’”<verse eid="MRK 12:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MRK 12:12" />Hư̆n jêng hên juôi truông ñư̆p Khua Yang ƀê̆ dăh hên bhŭng uôn lan, bơ yơng hên gư̆t klă Khua Yang prơ pơp hơ hôr hư̆n čiêng ngơi ta hên. Hư̆n yơh jai yĕh băh Khua Yang, hên du tŭk dêh.<verse eid="MRK 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Jêh hư̆n hên yua bar pei nau nêh ting ju pôl Pha-ri-si jêh iên ting ju pôl Hê-rôt sak ta Khua Yang no di hên mblơm Khua Yang mŏng pơp ngơi. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Trôh ta iên, hên ngơi ta Khua Yang: “Wơ khua, băl hi gư̆t ru khua jêng nêh ngĭn ngăn jêh iên mŏng khua, so mau pơp hui gre ju nau nêh ôh, bơ yơng khua so dlăng băh bôk dih kuôn nêh, mlih mŏng iên, khua tơ ti lăh truông ƀăng Yang Trôk di geh trip ta pơp ngĭn ngăn. Geh ta pơp bhiên mdăh so jai tôh jia ta Sê-sa? Băl băn tôh jia mdăh ei ru tôh jia?” <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Ƀê̆ dăh yơng băh gư̆t luôr ru pơp krĕh pra mhŏ nhăp mhŏ găl hên di, Khua Yang ngơi ta hên: “Pơp mhŏ pu me lông dlăng ăñ? Ăn ndơp ta ăñ ju đơ-niê no di ăñ dlăng.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Hư̆n jêng hên ndơp ju đơ-niê, jêh hư̆n Khua Yang ngơi ta hên: “Rup jêh iên năn ho jêng nêh tơm di?” Hên ngơi ta Khua Yang: “Sê-sa di.” <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Mông hư̆n, Yang Yê-su tơ tă hên: “Ăn plơ̆ ta Sê-sa năn pơp Sê-sa di, jêh iên plơ̆ ta Yang Trôk năn pơp Yang Trôk di.” Hên hơ̆ hă ta măt Khua Yang.<verse eid="MRK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Jêh hư̆n pôl băl Sa-đu-sê, jêng băl krĕh ngơi klăh iêu so mau pơp wêh dŏk brêh, sak ta Khua Yang jêh iên lup čêk Khua Yang, klăh iêu: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Wơ khua, Mô-ih jêh čih ta băl hi klăh iêu: ‘Ndă mi ju nau nêh hư̆n khư̆t kăn lơi ur ndrau ƀê̆ dăh ñăm mau kuôn, mông hư̆n ŏh nêh mi hư̆n jrăng sai ur ndrau hư̆n no di bă kuôn ta brau mi kăn.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Mau pŏh nau ŏh mi hư̆n, kăn mi bôk gŭk ur jêh iên khư̆t, so mau kuôn, <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />nêh tal bar sai de hư̆n, jêh hư̆n khư̆t, so mau kuôn, jêh iên nêh tal pei ăt iên ya, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />lĕ pŏh nau so mau kuôn gơ gu. Trôh kơi dư̆t, nêh u ur hư̆n khư̆t ya. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Trôh nar dŏk brêh, jai hên wêh brêh, de hư̆n jrăng ñjêng ur nêh tơm mŏng hên hư̆n? Bơ yơng pŏh nau hên jêh sŏk de ñjêng ur.” <verse eid="MRK 12:23" /><verse number="24" style="v" sid="MRK 12:24" />Yang Yê-su ngơi ta hên: “So lăh geh pu me jêh nai lăm čhuai yơng băh pơp ho lăh, yơng băh so gư̆t wơng Ră Ƀrăh wăt ta pơp myang Yang Trôk di? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Bơ yơng mông kuôn nêh băh tŭk khư̆t dŏk brêh, nai so hôm gŭk ur mdăh gŭk sai, ƀê̆ dăh hên jrăng ñjêng klăh di băl myang tŏng trôk. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ƀê̆ dăh yơng ta bruă nêh khư̆t dơi dŏk brêh, năng ai pu me ñăm dlăng mŏng ră Mô-ih, ta tŭk kăn čih yơng ta pôm luôk, đô̆ nă Yang Trôk ngơi ta kăn lak: ‘Ăñ jêng Yang Trôk kăn A-bra-ham, Yang Trôk kăn I-săk, jêh iên Yang Trôk kăn Ya-kôp’? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Khua Yang so geh jêng Yang Trôk băl khư̆t di, ƀê̆ dăh hư̆n jêng băl brêh di. Pu me čhuai kjham ngăn ru.”<verse eid="MRK 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Jai ju nau mŏng băl tơ ti pơp bhiên sak mơñ, čang tŏng pơp hên jai tŏng nhan, kăn so ru Khua Yang wêh lăh ta băl tŏ hư̆n geh ngăn, hư̆n kăn lup Khua Yang: “Năn pơp jêng pơp bhiên yuôm bhăn hĭn mŏng lĕ mơt?” <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Yang Yê-su ngơi klăh iêu: “Pơp bhiên yuôm hĭn jêng: ‘Wơ I-sra-el, ăn iêt ho, Khua Yang, Yang Trôk băl băn, jêng Yang čuôm gu ƀơn <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Ăn kuôn khăp Yang jêng Yang Trôk kuôn di ta lĕ mơt nuih nhăm kuôn, ta lĕ mơt ngăt nhuôl kuôn, ta lĕ mơt pơp gư̆t mĭn kuôn, jêh iên ta lĕ mơt pơp prăl ktang kuôn di.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Pơp bhiên tal bar jêng ho: ‘Ăn kuôn khăp khơñ nêh kiêu ma kuôn di klăh di săk jăn tơm.’ So hôm mau ju mta pơp bhiên dơ dêh ram hĭn ta bar mta ho.” <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Khua tơ ti pơp bhiên ngơi ta Khua Yang: “Geh ngăn, wơ khua! Khua jêh ngơi hui si pơp ngĭn ngăn ru Khua Yang jêng čuôm gu ƀơn, jêh iên so mau yang dêh dai gao hĭn băh Khua Yang. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Khăp khơñ Khua Yang ta lĕ mơt nuih nhăm, ta lĕ mơt pơp gư̆t mĭn, wăt ta lĕ mơt pơp ktang, jêh iên khăp khơñ nêh kiêu ma ndrơm ta săk tơm pơp hư̆n tăl ĕh yuôm bhăn hĭn ta grăp pơp mhŏ yang pô̆ jêh iên pơp mhŏ yang dêh.” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Jai jêh dlăng kăn, yơng băh kăn wêh lăh ta pơp gư̆t mĭn, Yang Yê-su ngơi ta kăn: “Me so wăč băh uôn tŏng trôk Yang Trôk di ƀă.” Jêh iên so mau nêh năñ wêh lup čêk Khua Yang ôh.<verse eid="MRK 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />No di boh pơp, mông jai tơ ti mŏng jŏng gung hih ƀư̆n, Yang Yê-su ngơi: “Đô̆ nă mhŏ no di băl tơ ti pơp bhiên ngơi klăh iêu Yang Tŏng Tlĕh jêng kuôn mtao Đa-wit? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dơk mtao Đa-wit tơm, mŏng Yang Ngăt Găl, kăn ngơi:</para>
  <para style="q1" vid="MRK 12:36">‘Yang ngơi ta Yang ăñ:</para>
  <para style="q1" vid="MRK 12:36">“Ăn gŭk đăh ma Ăñ,</para>
  <para style="q1" vid="MRK 12:36">tăl trôh ta mông Ăñ ăn băl rŏh Kuôn ta jŏng Kuôn di.”’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Dơk mtao Đa-wit tơm kuôl Khua Yang jêng ‘Yang Trôk,’ hư̆n đô̆ nă Khua Yang dơi jêng kuôn mtao hư̆n di ya?” Pôl uôn lan ŏk iêt Khua Yang srei ngăn.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Mŏng pơp tơ ti lăh Yang di, Khua Yang ngơi: “Ăn ñjrăng ta băl tơ ti pơp bhiên, jêng băl khăp čiêng čư̆t sŏh ta čhum ao djha, grăp pơp kôh nơ nei mŏng tŭk tăč blơ̆, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />tŭk gŭk drưh ang mŏng hih ƀư̆n wăt ta tŭk gŭk bôk măt mŏng tŭk mar. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Đơ băl hư̆n hên luôn hih băl ur ndrau, pra mhŏ kuôl dăn djhak. Pôl băl ho jrăng tŭ pơp phat dôih kjham hĭn.”<verse eid="MRK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Jai jêh gŭk mŏng sô̆ tŏng ta tŭk nai ăn hip prăk myơr hih ƀư̆n, Khua Yang ksiêm dlăng uôn lan lăm lôh prăk mŏng hip đô̆ nă. Ŏk băl ndrŏng hên lăm lôh mŏng iên ta nŏh prăk ram. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Jai ju nau ur ndrau ƀun sak mơñ, de lăm lôh bar lui prăk kuôn nê̆, nŏh yuôm ĕh jêng ju su. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Jai jêh kuôl ƀing kna Yang di trôh ta iên, Khua Yang ngơi ta hên: “Ngĭn ngăn, ăñ ngơi ta pu me klăh iêu ur ndrau ƀun ho de myơr ŏk hĭn lĕ mơt đơ băl jêh lăm lôh prăk mŏng hip tŏ hư̆n. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Bơ yơng lĕ dŏng hên čuôm gu myơr băh pơp khăñ khăh hên di gu, ƀê̆ dăh ur ndrau hư̆n, dŏng băh pơp knap mñai de di, de myơr lĕ mơt djăp mta pơp de dơi mau, hư̆n jêng djăp pơp thêm ñăt no di ruông brêh de.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Mông Khua Yang jai du băh hih ƀư̆n, ju nau mŏng băl ƀing kna Yang di ngơi ta Khua Yang: “Wơ khua, dlăng tŏ! Grăp bôk mau ram ngăn yơh jêh iên grăp bruă nai lăm ndŏk drưh ang ngăn!” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Yang Yê-su ngơi ta ƀing kna hư̆n: “Me so grăp hih kdrăm ka ăh ho ya? Ĕh jrăng so pơ pat ju mlăm bôk mau ta o dơi ĕh tŏng kơng tŏng bôk mau tŏ no di bôk mau hư̆n so ĕh dlưh rai mŏng sô̆.”<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Jêh iên jai Khua Yang gŭk tŏng yôk Ô-liu mơñ băk hih ƀư̆n, Pê-trôih, Ya-kơ, Yô-han jêh iên An-drê lup dêh ju nau Khua Yang: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Dăn khua ngơi ta băl hi, năn mông grăp bruă hư̆n jrăng trôh? Jêh iên năn têl ndrơh mông grăp bruă hư̆n ĕh trôh nư̆k?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Mông hư̆n, Yang Yê-su pŏk dơk ngơi ta hên: “Ăn ñjrăng, ei ru ăn nai têk lăm pu me sak čhuai truông. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Ŏk nêh jrăng trôh sŏk năn ăñ, ngơi klăh iêu: ‘Hư̆n jêng ăñ ho,’ jêh iên hên jrăng têk lăm ŏk nêh sak čhuai. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Bơ jai pu me tŏng yơng ta pơp tŏng mblăh jêh iên nai têh ta pơp tŏng mblăh, hư̆n ei ru bhŭng; bruă hư̆n ĕh jrăng trôh, ƀê̆ dăh ñăm geh jêng tôč dư̆t ôh. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Bơ yơng uôn lan ho jrăng dŏk tăm dăng ta uôn lan dơ dêh, jêh iên čar ho tăm dăng ta čar tŏ. Jrăng mau pơp nggŏh teh ta ŏk tŭk, jrăng mau ŏk pơp nguôt sap. Grăp bruă hư̆n jêng đhơm ta djăp pơp ji deh kuôn.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Gao băh iên, ăn pu me gư̆t răng. Nai jrăng jao pu me ta pôl phat dôih jêh iên ta hih ƀư̆n, pu me jrăng tŭ nai pŭ bang, jrăng dŏk ta măt băl khua jêh iên băl mtao yơng băh ăñ, klăh di pơp têh sơm ta hên. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Jêh iên luôr hĭn, Pơp Găl jrăng dơi têh sơm ta grăp uôn lan. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Jai hên ñư̆p čăp pu me sak jao ta nai, ei ru rŭng răng yơng ta pơp pu me jrăng ngơi. Ƀê̆ dăh, ndă năn pơp ngơi dơi ăn ta pu me mŏng mông hư̆n, ăn ngơi pơp hư̆n; bơ yơng pu me so geh jêng nêh jai ngơi, ƀê̆ dăh hư̆n jêng Yang Ngăt Găl. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Mi jrăng jao ŏh mŏng tŭk khư̆t, bap jrăng jao kuôn. Jêh hư̆n ŏh kuôn jrăng dŏk tăm dăng ta mei bap jêh iên ndơp hên mŏng tŭk nai lăm khư̆t. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Pu me jrăng tŭ pơp grăp nau nêh hao nuih yơng băh năn ăñ. Ƀê̆ dăh nêh tơm kjăp nuih nhăm tăl trôh tôč dư̆t, nêh hư̆n jrăng dơi tlĕh.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Gao băh iên, jai pu me so pơp đhir ngit băh tŭk jêh rai ĕh mau ta tŭk so tuôm mau (nêh dlăng ăn gư̆t wơng), mông hư̆n đơ băl gŭk ta čar Yu-đê ăn tuôt du tŏng yôk, <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />bơ nêh tơm gŭk tŏng dôn hih, ei ru jư̆r ăt ei ru mư̆t mŏng tŏ no di sŏk djăp mta pơp băh hih kăn tŏ, <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />jêh iên nêh tơm gŭk mŏng lŏ, ei ru wêh du hih wăt ta grăp pơp hôm ta kơi no di sŏk ao djha pu me di. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ƀê̆ dăh knap mñai yơh ta u ur jai trơ triêu jêh iên u ur ăn kuôn pu tŏh mŏng grăp nar hư̆n! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Mlih mŏng iên, ăn kuôl dăn no di bruă hư̆n so ĕh trôh mŏng dơm ik. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Bơ yơng mŏng grăp nar hư̆n jrăng mau pơp knap mñai tăl ñăm tuôm mau klăh iên dŏng băh đhơm rih ñjêng trôk teh, jêng mông Yang Trôk rih ñjêng grăp pơp tăl trôh nar o, jêh iên ăt jrăng so hôm wêh mau ya. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Jêh iên ndă Yang Trôk so lăm hič tơt grăp nar hư̆n, grăp pơp păm brêh jrăng so dơi tlĕh. Ƀê̆ dăh yơng băh đơ băl jêh săč ruăh, hư̆n jêng băl jêh Khua Yang săč ruăh, Khua Yang lăm hič grăp nar hư̆n. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Mông hư̆n, ndă mau nêh ngơi ta pu me: ‘Dlăng ho, Yang Tŏng Tlĕh ta o! Dlăng tŏ, đăh tŏ hư̆n!’ hư̆n ei ru tip. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Bơ yơng yang tŏng tlĕh huôk jêh iên băl têh luôr huôk jrăng dŏk ŏk, jêh hư̆n jrăng lăm ƀlang ŏk têl ndrơh jêh iên pơp myang no di, ndă di dơi, lăm čhuai đơ băl jêh săč ruăh. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ƀê̆ dăh ăn pu me gư̆t răng! Ăn dlăng ho, ăñ jêh ăn pu me gư̆t luôr djăp bruă ru.<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Ƀê̆ dăh, mŏng grăp nar hư̆n, ta kơi pơp knap mñai hư̆n, măt nar jrăng ñjêng ngo rlư̆m, măt khe jrăng so hôm lăm ƀlang pơp ang mŏng ĕh ôh; <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />grăp măñ băh trôk jăng lăč mŏng sô̆, jêh iên grăp pơp myang tŏng trôk ĕh jrăng nggŏh lĕ.<verse eid="MRK 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26" />Mŏng mông hư̆n, nai jrăng so Kuôn Nêh ta pơp myang ram jêh iên guh ang kdrăm ka ăh trôh mŏng mbar grăp ñuôi tŭk. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Ta kơi hư̆n, Khua Yang jrăng yua băl myang jêh iên Khua Yang jrăng tŏng ƀư̆n lĕ mơt băl jêh săč ruăh Yang di grăp puôn đăh jŏng trôk, dŏng băh dư̆t teh trôh ta dư̆t trôk.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Gao băh iên, ăn riêm gư̆t pơp hơ hôr băh jhi a ra. Jai mbăh ĕh ñjêng bơ băn jêh iên ĕh čăt ha ru, pu me gư̆t klă dơm bhang jêh trôh mơñ. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Ăt iên ya, jai pu me so grăp bruă hư̆n trôh, pu me gư̆t ru Khua Yang jai gŭk mơñ, trip ta ƀăng hih. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Ngĭn ngăn, ăñ ngơi ta pu me klăh iêu nuk ho ngĭn ngăn jrăng so tôč gao tăl trôh ta mông grăp bruă hư̆n jrăng trôh. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Trôk jêh iên teh jrăng tôč gao, ƀê̆ dăh grăp pơp ngơi ăñ ji ngĭn ngăn jrăng so dơi gao tôč ôh. <verse eid="MRK 13:31" /><verse number="32" style="v" sid="MRK 13:32" />Ƀê̆ dăh yơng ta nar hư̆n mdăh mông hư̆n, čuôm gu Bap, so hôm mau nêh dơi gư̆t, tăl lĕ mơt băl myang tŏng trôk ăt so gư̆t ya, jêh iên Kuôn ăt iên ya.<verse eid="MRK 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 13:33" />Ăn gư̆t ñjrăng! Ăn ngĕh măt jêh iên kuôl dăn, bơ yơng pu me so gư̆t năn mông nar trôh hư̆n trôh. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Klăh di ju nau nêh hư̆n prê sak wăč băh hih, jai jêh du băh hih kăn, jêh iên kăn jao ta grăp nêh dư̆k kăn di pơp dơi kĕ kriê grăp bruă hên di, hư̆n kăn tơ tă ta nêh gak ƀăng klăh iêu nêh hư̆n ăn kăn ngĕh măt; <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />hư̆n yơh, ăn ngĕh măt, bơ yơng pu me so gư̆t năn mông nêh tơm hih jrăng du — mdăh mông mho măng, mdăh mông tluông măng; mdăh jai iêr ndrau mdăh mông ang ôi — <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ơn ndă ăp răp trôh hih, khua ban pu me jai bê̆. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ƀê̆ dăh pơp jêh ăñ ngơi ta pu me, ăñ ăt jêh ngơi ya ta găp nau nêh: ‘Ăn ngĕh măt!’”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Mông hư̆n, hôm gu bar nar jêng trôh Mar Găn Gao jêh iên Mar Ƀăñ So Mau Pei, băl khua mhŏ yang ram wăt băl tơ ti pơp bhiên jai hên juôi truông, no di jêh ñư̆p čăp Khua Yang ta pơp ndăp, hên dơi lăm khư̆t Khua Yang. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Bơ yơng hên ngơi: “So dơi mhŏ mŏng mông mar, ơn dăh pơp tŏng pŭ rŭng jrăng trôh mŏng uôn lan.”<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Jăng jai Khua Yang gŭk ta Ƀê-tha-ni, mŏng hih kăn Si-môn, nêh tuôm geh dư̆n, Khua Yang jai gŭk ta kêng jhưng sông hư̆n ju nau u ur trôh ta iên, de ñôt ƀơn gri dak ndriêng nai mhŏ ta bôk mau yuôm dŏng dak hiêng kam tŭng, tlŏh nŏh yuôm prăk. Jai jêh čăm čăh gri, de tôh dak ndriêng hư̆n tŏng bôk Khua Yang. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Ƀê̆ dăh mŏng mbar hên, mau ƀơ ƀă nêh hao nuih: “Yơng băh năn pơp no di lăm le li dak ƀau kăh ho? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Bơ yơng dak ƀau kăh ho dơi blŏ khăñ ta pei hiêng đơ-niê jêh hư̆n phă gai ta băl ƀun ƀin.” Hên ƀuăh ñjăm de. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Ƀê̆ dăh Yang Yê-su ngơi: “Lơi iên de di. Pơp mhŏ pu me lăm dlĕh de? De jai mhŏ ƀơn bruă găl ta ăñ. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Bơ yơng pu me khăng mau nêh ƀun ƀin gŭk băk pu me, jêh iên năn mông pu me khơñ pu me dơi mhŏ bruă găl ta hên, ƀê̆ dăh pu me jrăng so dơi mau ăñ răn răn ƀă. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />De jêh mhŏ ƀơn bruă hư̆n jêng bruă de dơi mhŏ. De jêh prăp prê luôr no di ñŏh săk khư̆t ăñ trôh ta nar tăp bư̆l. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Ngĭn ngăn, ăñ ngơi ta pu me, u ta tŭk Pơp Găl dơi têh sơm mŏng grăp dôn teh hư̆n bruă de mhŏ ho ăt nai jrăng wañ hư̆t ya mŏng pơp kăh wơi yơng ta de.”<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Bơ Yu-đa Ič-ka-ri-ôt, ju nau mŏng măt bar nau ƀing kna, du băh iên sak tŏng tuôm băl khua mhŏ yang ram no di kăn dơi ñư̆p jao Khua Yang ta hên. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Mông hư̆n, jai jêh tŏng kơt iên, hên bêng pơp brơn jêh iên ƀuôn ăn ta kăn ƀak. Jêh hư̆n kăn juôi năn mông găl no di lhiăr jao Khua Yang.<verse eid="MRK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Mŏng nar tal muôi Mar Ƀăñ So Mau Pei, jai nai myơr pơp mhŏ yang biêp kuôn Mar Găn Gao, băl ƀing kna Yang di ngơi ta Khua Yang: “U ta tŭk khua khơñ băl hi sak prăp prê no di khua dơi sa Mar Găn Gao?” <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Jêh hư̆n Khua Yang yua bar nau mŏng băl ƀing kna Yang di, jêh iên ngơi ta hên: “Ăn sak mư̆t mŏng uôn ram, jêh iên ju nau nêh ñôt nhông dak jrăng tŏng tuôm pu me. Ăn hui gre kăn hư̆n. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Ndă năn hih kăn mư̆t, ăn ngơi ta khua hih klăh iêu: ‘Khua ngơi: “Dŭ lăm năč ăñ ji, tŭk ăñ jrăng sa Mar Găn Gao băk băl ƀing kna ăñ ji, u tŭk hư̆n?”’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Khua hih jrăng tơ to pu me ƀơn dŭ lăm ram tŏng tal tê̆ jêh prăp prê luôr ru, jêh iên ăn prăp prê ta băl băn ta iên.” <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Jêh hư̆n băl ƀing kna du băh iên jêh hư̆n sak mư̆t mŏng uôn ram, jêh hư̆n hên so grăp bruă trip klăh di Khua Yang jêh ngơi ta hên, jêh hư̆n hên prăp prê pơp sa Mar Găn Gao.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Jai jêh trôh mông mho, Khua Yang sak trôh ta tŭk măt bar nau ƀing kna. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Mông hên jai gŭk ta jhưng sông jêh iên sông sa, Yang Yê-su ngơi: “Ngĭn ngăn, ăñ ngơi ta pu me klăh iêu ju nau mŏng pu me, jêng nêh jai sông băk ăñ jrăng lhiăr ăñ.” <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Hên dư̆ng nguôt nư̆ng jêh iên nêh ho trôh nêh tŏ lup Khua Yang: “Năng ai so geh jêng ăñ ôh?” <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Ƀê̆ dăh Khua Yang ngơi ta hên: “Hư̆n jêng ju nau mŏng măt bar nau pu me, nêh jai djrut ƀăñ mŏng čiên băk ta ăñ. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Bơ yơng Kuôn Nêh sak geh trip hui si pơp jêh čih yơng ta Khua Yang, ƀê̆ dăh năng tăm păh yơh ta nêh jêh iên yơng băh kăn, Kuôn Nêh tŭ pơp lhiăr jao! Găl hĭn nêh hư̆n tlaih nai lai săk pơp hư̆n găl hĭn ta kăn.”<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Mông jai hên sông, jai jêh sŏk ƀăñ, lăh găl, Khua Yang phič, jao ta hên jêh iên ngơi: “Ăn sŏk yơh. Ho jêng săk jăn ăñ ji.” <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />Jêh iên jai jêh sŏk čiên, lăh găl, Khua Yang jao ta hên, jêh iên lĕ mơt hên ñêt băh ƀơn čiên hư̆n. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Khua Yang ngơi ta hên: “Ho jêng mham pơp tăm tlăč ăñ ji, jêng mham dơi tôh ta ŏk nêh. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Ngĭn ngăn, ăñ ngơi ta pu me, ngĭn ngăn yơh ăñ so hôm wêh ñêt dak băh ple tơm ño ôh tăl trôh ta nar hư̆n, jêng mông ăñ ñêt dak ño mhei mŏng uôn tŏng trôk Yang Trôk di.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Jai jêh muñ ƀơn pơp muñ ƀrăh, hên sak trôh iêu yôk Ô-liu. <verse eid="MRK 14:26" /><verse number="27" style="v" sid="MRK 14:27" />Yang Yê-su ngơi ta hên klăh iêu: “Lĕ mơt pu me jrăng păk bông, ndrơm pơp čih klăh iêu:</para>
  <para style="q1" vid="MRK 14:27">‘Ăñ jrăng pŭ nêh kĕ,</para>
  <para style="q1" vid="MRK 14:27">mông hư̆n biêp jrăng ndrăh ndrêng.’<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Ƀê̆ dăh jai jêh ăñ dŏk brêh hư̆t, ăñ jrăng sak luôr pu me trôh Ga-li-lê.” <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Ƀê̆ dăh Pê-trôih ngơi ta Khua Yang: “Wăt di lăh grăp nau nêh jrăng păk bông, ƀê̆ dăh ăñ so dơi ĕh bông.” <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Yang Yê-su ngơi ta kăn: “Ngĭn ngăn, ăñ ngơi ta me, hư̆n jêng nar o — măng ƀê̆ rŏk — luôr ta iêr kuăng ndrau bar dŏ, me jrăng khan ăñ pei dŏ.” <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Ƀê̆ dăh kăn ngơi ta pơp ktang: “Ndă ăn ăñ khư̆t ju băk ta khua, ăñ ngơi ngĭn ngăn ăñ jrăng so khan khua ôh.” Mông hư̆n, lĕ mơt ƀing kna ngơi kơt iên gu.<verse eid="MRK 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Jêh hư̆n hên sak ta ƀơn tŭk, năn tŭk hư̆n jêng Gêt-sê-ma-nê, jêh iên Khua Yang ngơi ta băl ƀing kna Yang di: “Ăn gŭk o jăng jai ăñ kuôl dăn.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Khua Yang ndơm Pê-trôih, Ya-kơ, jêh iên Yô-han sak ju băk Khua Yang, jêh hư̆n Khua Yang dư̆ng nguôt nư̆ng jêh iên bêng pơp rŭng răng. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Khua Yang ngơi ta hên: “Ngăt nhuôl ăñ ji jai nguôt nư̆ng ngăn, pơi ĕh rŏng khư̆t. Ăn gŭk ta o jêh iên ngĕh măt.” <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />Jêh hư̆n sak wăč ƀê̆ băh iên, Khua Yang čư̆p măt mŏng teh jêh iên kuôl dăn klăh iêu, ndă di dơi, dăn mông hư̆n tlĕh băh Khua Yang. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Khua Yang dăn: “A-ƀa, wơ Bap, ta Bap grăp bruă jêng dơi gơ gu. Dăn sŏk čiên ho băh kuôn. Ƀê̆ dăh so geh jêng pơp kuôn khơñ ôh, hư̆n jêng pơp Bap khơñ.” <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Jêh hư̆n Khua Yang plơ̆ ta iên jêh hư̆n so hên jai bê̆, hư̆n yơh Khua Yang kuôl kăn Pê-trôih: “Si-môn, me bê̆ lăh? Me so dơi ngĕh čuôm gu ju mông ya lăh? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Ăn ngĕh măt jêh iên kuôl dăn, no di pu me so ĕh lăč mŏng pơp mblơm. Pơp mĭn ĕh khơñ ngăn, ƀê̆ dăh lŏng săk ĕh djhup dư̆r.” <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Ju dŏ hư̆t, jai jêh du băh tŏ, Khua Yang kuôl dăn, ngơi klăh di pơp ta luôr hư̆n ya. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Jêh hư̆n ju dŏ hư̆t, jai plơ̆ ta kơi, Khua Yang so hên hôm bê̆, bơ yơng măt hên jŏk krư̆p, jêh iên hên so hôm thơp no di boh pơp Khua Yang. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Jêh hư̆n Khua Yang plơ̆ tal pei jêh iên ngơi ta hên: “Pu me ăt hôm bê̆ jêh iên mdei lăh? Djăp ru! Mông jêh trôh. Dlăng tŏ hư̆n! Kuôn Nêh mơñ nai lhiăr jao mŏng ti băl tih djŏh. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Ăn dŏk gơñ, jơ̆ sak. Dlăng tŏ, nêh lhiăr ăñ jêh trôh mơñ.” <verse eid="MRK 14:42" /><verse number="43" style="v" sid="MRK 14:43" />Mông hư̆n rŏk, mông Khua Yang jai hôm ngơi, Yu-đa, ju nau mŏng măt bar ƀing kna, trôh ta iên jêh iên ju băk ta kăn jêng ju pôl ŏk ñôt gưm đao jêh iên mŏng jra, hên sak băh tŭk băl khua mhŏ yang ram, băl tơ ti pơp bhiên jêh iên băl khua u rañ. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Mông hư̆n, tlau lhiăr Khua Yang jêh ăn ta hên ƀơn pơp lăm năl, klăh iêu: “Nêh tơm ăñ čư̆m hư̆n yơh kăn. Ăn ñư̆p čăp kăn jêh iên sak jao nơ nơn.” <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Hư̆n yơh, jai jêh trôh iên, mhăč rŏk, jêh sak mơñ Khua Yang, kăn ngơi: “Ra-ƀi,” jêh hư̆n kăn čư̆m Khua Yang. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Mông hư̆n, băl ĕh kŏng ti tŏng săk Khua Yang jêh iên ñư̆p čăp Khua Yang. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ƀê̆ dăh ju nau nêh hư̆n mŏng băl dŏk ta iên, jai jêh tŏk pêh ta ling, kăn răn pŭ dư̆k khua mhŏ yang ram jêh iên srĕh tĕ tôr kăn dư̆k hư̆n. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Boh pơp hên ñư̆p čăp hư̆n, Yang Yê-su ngơi ta hên: “Pu me trôh o ta gưm đao jêh iên mŏng jra no di ñư̆p ăñ klăh di sak ñư̆p nêh tŭng tlĕ lăh? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Grăp nar ăñ gŭk băk pu me mông tơ ti lăh mŏng hih ƀư̆n, ƀê̆ dăh pu me so ñư̆p ăñ. Ƀê̆ dăh, ho jêng no di pơp ngơi Ră Ƀrăh dơi ñjêng nư̆k.” <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Jai jêh ndrŏh Khua Yang, lĕ mơt hên tuôt du gơ gu.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Ju nau tlau nu hư̆n hui gre Khua Yang, čuôm gu kăn sŏh ju blăh ao djha mnal nhơ tŏng săk kăn, jêh iên hên ñư̆p čăp kăn, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />ƀê̆ dăh jai jêh čĕ lat ao djha hư̆n, kăn tuôt săk kôh.<verse eid="MRK 14:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Băl ĕh sak ndơp Yang Yê-su trôh ta tŭk khua mhŏ yang ram, jêh iên lĕ mơt khua mhŏ yang ram, băl khua u rañ, wăt băl tơ ti pơp bhiên tŏng ƀư̆n ta iên. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Bơ kăn Pê-trôih hui gre Khua Yang băh wăč, kăn mư̆t trôh ta jŏng gung khua mhŏ yang ram tŏ, jêh iên kăn gŭk băk ta ka han gak jêh hư̆n jhăr dôh ta kêng iñ. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Mông hư̆n, băl khua mhŏ yang ram jêh iên lĕ mơt Pôl băl Yo Thaĭ juôi pơp kčŭt tăm dăng ta Yang Yê-su no di ndơp Khua Yang mŏng tŭk khư̆t, ƀê̆ dăh hên so dơi so nơn. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Bơ yơng ŏk nêh mčĕh huôk tăm dăng ta Khua Yang, ƀê̆ dăh pơp kčŭt hên di so mau ndrơm ju băk. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Mau nêh, jai dŏk tŏng tê̆, mčĕh huôk tăm dăng ta Khua Yang, jai kăn ngơi <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />klăh iêu: “Băl hi tŏng kăn ho ngơi iêu ‘Ăñ jrăng lăm rai hih kôh mpŭ yơng băh plang ti nêh lăm ñjêng ho, jêh hư̆n mŏng pei nar ăñ jrăng lăm ndŏk ƀơn hih kôh mpŭ dơ dêh so mau yơng băh plang ti nêh lăm ñjêng.’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Iên tŭ, wăt ta bruă ho tŭ, pơp kčŭt hên di ăt so dơi ndrơm ya. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Jai jêh dŏk ta măt grăp nau nêh, khua mhŏ yang ram lup čêk Yang Yê-su klăh iêu: “Pơp mhŏ so me ngơi ju mta pơp nơn? Đơ băl ho kčŭt tăm dăng ta me năn pơp hư̆n?” <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Ƀê̆ dăh Khua Yang ăt gŭk miêt jêh iên so têh ju mta pơp nơn. Khua mhŏ yang ram wêh lup čêk Khua Yang, jêh iên kăn ngơi ta Khua Yang: “Me geh ya jêng Yang Tŏng Tlĕh, Kuôn Mtao năng nơ nei, lăh?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Mông hư̆n, Yang Yê-su ngơi: “Hư̆n jêng ăñ; o tlak pu me jrăng so</para>
  <para style="q1" vid="MRK 14:62">Kuôn Nêh gŭk đăh ma Mtao Pơp Myang</para>
  <para style="q1" vid="MRK 14:62">jêh iên trôh mŏng mbar grăp ñuôi tŭk băh trôk.”<verse eid="MRK 14:62" /></para>
  <para style="m">
    <verse number="63" style="v" sid="MRK 14:63" />Jêh iên jai jêh čriêk ao kăn di, khua mhŏ yang ram ngơi: “Băl băn năn pơp hôm khơñ yơng ta nêh sơm nư̆k hư̆t? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Pu me jêh tŏng pơp mưč yang ru hư̆n. Đô̆ nă pu me mĭn?” Jêh hư̆n lĕ mơt dŏng hên kčŭt Khua Yang jêng nêh năng khư̆t. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Ƀơ ƀă nêh dư̆ng čhŏh dak diêu iêu Khua Yang, put măt Khua Yang jêh iên pŭ bang Khua Yang, jêh hư̆n ngơi ta Khua Yang: “Ngơi pơp têh luôr ta hi gơñ!” Đơ băl ka han gak ăt ñư̆p kŏng Khua Yang jêh iên tap.<verse eid="MRK 14:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Jăng jai Pê-trôih gŭk ta jŏng gung, ju nau mŏng băl dư̆k u ur khua mhŏ yang ram di sak mơñ tŭk kăn. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Mông de so Pê-trôih jai jhăr iñ, de dlăng nư̆k kăn, hư̆n de ngơi: “Me ăt gŭk băk Yê-su, nêh Na-sa-ret.” <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Ƀê̆ dăh kăn khan, jêh iên ngơi: “So ăñ gư̆t, ăt so wơng năn pơp e jai ngơi hư̆n ya.” Jêh hư̆n kăn du ta jŏng gung tŏ. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />De dư̆k u ur hư̆n jai jêh so kăn de dư̆ng têh sơm ta băl nêh jai dŏk ta iên klăh iêu: “Nêh ho jêng ting ju pôl băl tŏ hư̆n!” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ƀê̆ dăh kăn khan ju dŏ hư̆t. Păh pê băh iên, đơ băl dŏk ta iên wêh ngơi ta Pê-trôih: “Geh ru me jêng ju pôl băk băl tŏ, bơ yơng me ăt jêng nêh Ga-li-lê ya.” <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Ƀê̆ dăh kăn dư̆ng tăm păh jêh iên kăt săk klăh iêu: “Ăñ so gư̆t năl nêh hư̆n, jêng nêh pu me jai ngơi hư̆n.” <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Mhăč rŏk iêr kuăng ndrau tal bar jêh iên Pê-trôih bhŏng kăh tôr pơp ngơi Yang Yê-su ngơi ta kăn klăh iêu: “Luôr ta iêr kuăng ndrau bar dŏ, me jrăng khan ăñ pei dŏ,” hư̆n yơh mŏng mông nguôt nư̆ng, kăn lôh ñim.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ang ôi măng hư̆n rŏk, mông băl khua mhŏ yang ram jêh tŏng ƀư̆n pơp trông čhai ta băl khua u rañ wăt băl tơ ti pơp bhiên jêh iên lĕ mơt Pôl Băl Yo Thaĭ, jai jêh čăp Yang Yê-su, hên lăm Khua Yang sak jêh iên jao ta kăn Pi-lat. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pi-lat lup Khua Yang: “Me jêng Mtao băl Yo Thaĭ geh ya?” Ƀê̆ dăh jai boh pơp kăn, Khua Yang ngơi: “Me tơm ngơi klăh iên.” <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Jêh hư̆n băl khua mhŏ yang ram kčŭt Khua Yang ŏk pơp dơ dêh. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Mông hư̆n, Pi-lat wêh lup čêk Khua Yang klăh iêu: “Me so ngơi ju mta pơp nơn lăh? Dlăng tŏ, hên jai kčŭt me ŏk khĕ pơp tŏ hư̆n!” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Ƀê̆ dăh Yang Yê-su so hôm wêh ngơi ju mta pơp ôh, tăl kăn Pi-lat dlăng ndrơh ngăn.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Gao băh iên, mŏng mông mar, kăn krĕh phưi ta uôn lan ju nau nêh mnă jêng nêh mnă hên khơñ. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Mông hư̆n, mau ju nau nêh nai năn jêng Ƀa-ra-ƀa, jai nai nggruôn ju băk ta băl lăm rŭng, hư̆n jêng băl mhŏ tih lăm khư̆t nêh mŏng pơp tăm dăng ta nuk kna. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Jai jêh trôh ta iên, băl uôn lan ŏk dư̆ng dăn ta kăn klăh di kăn krĕh mhŏ ta hên. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Mông hư̆n, Pi-lat lup hên, klăh iêu: “Pu me khơñ ăñ phưi Mtao băl Yo Thaĭ ta pu me ya?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Bơ yơng kăn gư̆t ru băl khua mhŏ yang ram ñư̆p jao Khua Yang yơng băh nuih tŏng nač. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Ƀê̆ dăh băl khua mhŏ yang ram čhôl trôt pôl ŏk no di mlih ta iên, ăn kăn lăm tlĕh Ƀa-ra-ƀa ta hên. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Ƀê̆ dăh, jai lup hư̆t, Pi-lat ngơi ta hên: “Ndă iên, đô̆ nă ăñ jrăng mhŏ yơng ta nêh pu me kuôl jêng Mtao uôn lan Yo Thaĭ ho?” <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Mông hư̆n, uôn lan wêh ôr tĕh: “Ăn păng đĭn kăn ta jhi tăm kăng.” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Ƀê̆ dăh, Pi-lat ngơi ta hên: “Yơng băh năn pơp tih kăn mhŏ hư̆n?” Ƀê̆ dăh, nai ndôl ôr tĕh hĭn: “Ăn păng đĭn kăn ta jhi tăm kăng.” <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Mông hư̆n, yơng băh khơñ lăm găl nuih nhăm băl ŏk, Pi-lat lăm phưi kăn Ƀa-ra-ƀa ta hên jêh iên kăn yua nêh ndơp Yang Yê-su iêu tŏ no di jêh tŭ nai pŭ plat, Khua Yang tŭ păng đĭn.<verse eid="MRK 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Mông hư̆n, băl ka han đŏh Khua Yang lăm mư̆t mŏng hih (hư̆n jêng hih khua kwar di) jêh iên kuôl lĕ pôl ka han tŏng ƀư̆n ju tŭk, <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />jêh hư̆n băl ĕh lăm sŏh tŏng săk Yang ju blăh ao brông hăr, jêh iên lăm ndau ta Khua Yang ƀơn đuôn mtao ta luôk jêh băl ĕh tañ, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />jêh hư̆n băl ĕh dư̆ng kôh Khua Yang: “Nơ nei Mtao băl Yo Thaĭ!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Jêh hư̆n, băl ĕh pŭ tŏng bôk Khua Yang ta mŏng jra jêh iên čhŏh dak diêu tŏng Khua Yang, jêh iên čuôn krŭng ka kôh Khua Yang. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Mông jêh băl ĕh liê̆ mưč Khua Yang ru, băl ĕh lĕh băh săk Khua Yang ao brông hăr jêh iên lăm sŏh ao Yang di ta săk Khua Yang, jêh hư̆n lăm Khua Yang sak no di hên păng đĭn Khua Yang ta jhi tăm kăng. <verse eid="MRK 15:20" /><verse number="21" style="v" sid="MRK 15:21" />Hên ñư̆p ju nau nêh sak truông, năn kăn jêng Si-môn, nêh Si-ren (bap kăn A-lek-san-đơ jêh iên Ru-phu), trôh băh uôn đăm sô̆, no di kăn tung jhi tăm kăng Yang di.<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />Băl ĕh ndơp Khua Yang trôh ta Gôl-gô-tha (tŭk hư̆n nai nơ năn jêng “Tŭk Ndŏh Bôk”). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Băl ĕh ăn Khua Yang ñêt nơm jêh tăm lŭk ta dak gư̆n tăng, ƀê̆ dăh so Khua Yang ñêt. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Jêh hư̆n hên păng đĭn Khua Yang jêh iên tăm phă blăh ao Yang di ta pơp tăm mđăo ndăng hên, dlăng nêh tơm dơi dơn ao. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Mông hư̆n jêng mông tal pei, băl ĕh păng đĭn Khua Yang. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Ho jêng pŏk mdhă pơp tih Yang di, hên čih iêu: “Mtao Băl Yo Thaĭ.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Băl ĕh ăt păng đĭn ya bar nau băl tlĕ ju băk Khua Yang, ju nau ting đăh ma, bơ kăn ƀơn ting đăh kiêu Khua Yang. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />(Pơp ngơi Ră Ƀrăh jêh ñjêng nư̆k, klăh iêu: “Khua Yang geh nai ngơp ju băk ta băl so mau pơp bhiên.”) <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Đơ băl găn truông hên čhŏh mưč Khua Yang, hên ngăč bôk jêh iên ngơi: “Hơi! Wơ tlau lăm rai hih ƀư̆n jêh iên lăm ndŏk hư̆t mŏng pei nar, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />ăn lăm tlĕh dêh săk me tơm jêh iên jư̆r băh jhi tăm kăng hư̆n gơñ!” <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Ăt ndrơm klăh iên ya, đơ băl khua mhŏ yang ram wăt băl tơ ti pơp bhiên, hên liê̆ mưč Khua Yang, hên ngơi: “Kăn dơi lăm tlĕh ŏk nêh dơ dêh, ƀê̆ dăh kăn so dơi lăm tlĕh săk kăn tơm. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Yang Tŏng Tlĕh, Mtao băl I-sra-el, mông ho ăn jư̆r băh jhi tăm kăng gơñ, no di băl hi so jêh iên tip.” Đơ băl nai păng đĭn ju băk Khua Yang ăt hên ngơi mưč Khua Yang ya.<verse eid="MRK 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Trôh mông tal pro, pơp ngo măng ĕh trôh guôm lĕ dôn teh tăl trôh mông tal sư̆n. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Mŏng mông tal sư̆n, Yang Yê-su ôr tĕh dơk: “Ê-lô-i, Ê-lô-i, la-ma-sa-ƀăč-tha-ni?” Pơp hư̆n lơ lang jêng: “Wơ Yang Trôk ăñ, Yang Trôk ăñ, pơp mhŏ Khua Yang ndrŏh lat ăñ?” <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Jai tŏng kơt iên, đơ băl dŏk mơñ ta iên ngơi: “Dlăng tŏ, kăn jai kuôl Ê-li.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Jêh hư̆n, ju nau ka han, jai jêh kăn dhul sak ñŭk djhôp bêng dak srat, kăn čôh ta tơm prŏh, nêh hư̆n ăn Khua Yang ñêt, kăn ngơi: “Lơi khiêp kăn di, dlăng Ê-li sak lăm tlĕh kăn mdăh so.” <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Mông hư̆n, jai jêh ôr ju dŏ tĕh ngăn, Yang Yê-su tĕ nhăm tôč dư̆t. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Jêh iên păng dhiêm ram mŏng ƀư̆n ĕh čriêk mŏng mbar băh tê̆ trôh mŏng sô̆. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Mông hư̆n khua ka han, jêng nêh dŏk mơñ hĭn ta Khua Yang, jai jêh kăn so ru Khua Yang tĕ nhăm kơi dư̆t klăh iên, kăn ngơi: “Ngĭn ngăn, nêh ho jêng Kuôn Yang Trôk di.” <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />Ăt mau ya băl u ur dŏk dlăng băh tŭk wăč, mŏng hên hư̆n mau Ma-ri Ma-đơ-len, Ma-ri (mei Ya-kơ kuôn nê̆ jêh iên Yô-sê) wăt ta Sa-lô-mê, <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />hư̆n jêng đơ băl jăng jai Khua Yang hôm gŭk ta Ga-li-lê, hên tuôm gre Khua Yang jêh iên đru bruă Khua Yang, mau ŏk ya băl u ur dơ dêh hui gre ju băk Khua Yang sak trôh Yê-ru-sa-lem.<verse eid="MRK 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Trôh mông trôk jêh ngo ru, bơ yơng nar hư̆n jêng Nar Prăp Prê, hư̆n jêng nar luôr ta nar Sa-ƀat, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yô-sep, jêng nêh băh čar A-ri-ma-thê, ju nau nêh năng mpŭ mŏng Pôl Phat Dôih, ăt jêng nêh jai kăp găn čar tŏng trôk Yang Trôk di, jai jêh trôh ta iên, kăn sak tŏng tuôm rŏk ta Pi-lat jêh iên kăn lup dăn săk khư̆t Yang Yê-su. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Mông hư̆n, Pi-lat dlăng ndrơh ngăn ndă ngĭn ngăn Khua Yang jêh khư̆t ru, jêh hư̆n jêh kăn kuôl khua ka han, kăn lông lup nêh hư̆n no di gư̆t Khua Yang khư̆t ŏk ru yau. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Mông jêh kăn gư̆t nư̆k ru bruă hư̆n băh khua ka han, kăn jao săk khư̆t ta Yô-sep. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Jai jêh kăn ruôt mnal nhơ, lăm jư̆r Khua Yang băh jhi tăm kăng, kăn put Khua Yang ta mnal hư̆n, jêh iên ăn Khua Yang mŏng tu môč jêh nai phat tŏng gơp mau. Jêh hư̆n kăn lơk ƀơn bôk mau ram ndăl lat ƀăng tu. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Mông hư̆n, Ma-ri Ma-đơ-len jêh iên Ma-ri mei kăn Yô-sê jêh hên so ru tŭk nai tăp bư̆l Khua Yang.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Jai nar Sa-ƀat jêh gao, Ma-ri Ma-đơ-len, Ma-ri mei kăn Ya-kơ, jêh iên Sa-lô-mê, hên ruôt dak ƀau kăh no di sak trôh tu môč, hên khơñ ñŏh săk khư̆t Khua Yang. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Băh ôi măng nar tal muôi mŏng pŏh, hên sak trôh ta tu môč jai măt nar mhei lôh. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Hên tŏng trông čhai: “Nêh tơm jrăng lơ̆ un bôk mau băh ƀăng tu môč ta băl băn ƀê̆?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Jai dlăng iêu tê̆, hư̆n hên so bôk mau jêh nai lơ̆ ru, wăt di lăh ĕh ram ngăn. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Jai jêh sak mư̆t mŏng tu môč, hên so ju nau tlau nu sŏh ao nang khu jai gŭk ju đăh ma, jêh iên hên bhŭng ndrăt. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Ƀê̆ dăh nêh hư̆n ngơi ta hên: “Ei ru bhŭng. Pu e jai juôi Yê-su nêh Na-sa-ret, Mtao jêh nai păng đĭn ta jhi tăm kăng. Khua Yang jêh nai lăm brêh ru! Khua Yang so hôm ta o. Ăn dlăng ta tŭk nai ăn săk khư̆t Khua Yang. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Iên tŭ, ăn sak, têh sơm ta băl ƀing kna Khua Yang jêh iên Pê-trôih klăh iêu: ‘Khua Yang sak luôr ta pu me trôh ta Ga-li-lê. Ta iên, pu me jrăng so Khua Yang’, trip klăh di Khua Yang jêh ngơi ta pu me.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Mông jêh du ling, hên tuôt băh tu môč, bơ yơng bhŭng pơ prăm jêh iên pơp đhir ngit ĕh guôm hên. Jêh iên so hên ngơi ju mta pơp ta nai bơ yơng hên bhŭng ir. <verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />(Ôi măng nar tal muôi mŏng pŏh, jai jêh dŏk brêh, Khua Yang nôh ƀlang luôr hĭn ta Ma-ri Ma-đơ-len, jêng nêh jêh Khua Yang prŏh pŏh nau yang djŏh du băh de. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />De u ur hư̆n sak têh sơm hư̆t ta băl jêh tuôm gŭk băk Khua Yang jăng jai hên tlŏng nư̆ng jêh iên srăč ñim. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Bơ hên, jai hên tŏng ru Khua Yang hôm brêh jêh iên de tơm jêh tuôm so nư̆k, hư̆n so hên tip.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Mông hư̆n, jêh bruă hư̆n, Khua Yang nôh ƀlang mŏng rup săk dơ dêh ta bar nau nêh mŏng pôl hên jai sak truông du iêu uôn tơm. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Jêh iên bar nau hên hư̆n, jai hên du plơ̆ ta kơi, hên sơm hư̆t ta băl ƀing kna dŏng iên, ƀê̆ dăh ƀing kna so tip bar nau hên hư̆n.<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Jêh hư̆n, trôh ta kơi, Khua Yang lăm ƀlang ta măt muôi nau ƀing kna jăng jai hên gŭk ta jhưng sông, Khua Yang ƀuăh ñjăm pơp so đăo jêh iên nuih krăk dăng hên di bơ yơng hên so khơñ tip đơ băl jêh tuôm so Khua Yang jai jêh Khua Yang wêh dŏk brêh băh tŭk khư̆t. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Khua Yang tơ tă hên: “Jai jêh sak grăp dôn teh, ăn têh sơm Pơp Găl ta grăp nau nêh. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Nêh tơm đăo jêh iên tŭ ƀap-tem jrăng dơi tlĕh, bơ nêh tơm so đăo jrăng tŭ pơp kmhal. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Đơ pơp myang ho jrăng sak băk ta băl mau pơp đăo: Sŏk năn ăñ, hên jrăng prŏh yang djŏh. Hên jrăng ngơi grăp dơk ngơi mhei. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Hên jrăng ñư̆p bêh, jêh iên wăt di lăh hên ñêt pơp khơih, ngĭn ngăn ĕh so dơi lăm rai hên ôh. Hên jrăng bi ti tŏng grăp nau nêh kuôp ji mông hư̆n đơ băl hư̆n jrăng dơi băh.”<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Jai jêh Yang Yê-su ngơi ta hên, Khua Yang dơi nai sŏk iêu trôk jêh iên gŭk ju đăh ma Yang Trôk. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Bơ lĕ mơt băl hư̆n, jai jêh du băh iên, hên têh sơm grăp tŭk, jăng jai Yang Trôk mhŏ bruă ju băk hên jêh iên lăm nư̆k pơp đăo ta grăp pơp myang ĕh sak băk. A-men.)<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>