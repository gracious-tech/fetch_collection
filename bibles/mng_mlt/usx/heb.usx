  <book code="HEB" style="id">EN_MLT mng_Eastern⋅Mnong_ltr Mon Nov 03 2025 09:09:01 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Hebrews</para>
  <para style="toc1">Ră ñuôr ta băl Hê-brơ</para>
  <para style="toc2">Hê-brơ</para>
  <para style="toc3">Heb</para>
  <para style="mt">Hê-brơ</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Mŏng ŏk nuk jêh iên ŏk truông băh đưm lak, jai jêh Yang Trôk ngơi ta băl pang yo yơng băh băl têh luôr, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />hư̆n mŏng mông nar tôč dư̆t ho, Khua Yang ngơi ta băl băn yơng băh Kuôn Yang di, hư̆n jêng Mtao jêh Khua Yang lăm ndŏk ñjêng Nêh Dơn djăp pơp, ăt mŏng Kuôn hư̆n ya, jêh Khua Yang rih ñjêng grăp nuk; <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />jêh iên mŏng Kuôn hư̆n yơh jêng pơp trang ang guh ang jêh iên pơp lăm ƀlang nư̆k nơn yơng ta knuih Yang di, jêh iên guôm čăng djăp pơp yơng băh pơp ngơi myang Yang di, trôh mông jêh lăm dư̆t lĕ mơt bruă rao pơp tih, Kuôn hư̆n gŭk đăh ma Mtao Kdrăm Ka ăh tŏng trôk jua; <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />yơng băh dơi ñjêng guh ang gao hĭn ta băl myang, Kuôn jêh dơi dơn năn ram hĭn ta lĕ mơt băl myang hư̆n. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Bơ yơng ñăm tuôm Khua Yang ngơi ta ju nau nêh mŏng băl myang klăh iêu:</para>
  <para style="q1" vid="HEB 1:5">“Kuôn jêng Kuôn ăñ ji.</para>
  <para style="q1" vid="HEB 1:5">Nar o ăñ lai săk ta Kuôn”?</para>
  <para style="m" vid="HEB 1:5">Lŏ wêh ngơi:</para>
  <para style="q1" vid="HEB 1:5">“Ăñ jrăng ñjêng Bap ta Me,</para>
  <para style="q1" vid="HEB 1:5">jêh iên Me jrăng ñjêng Kuôn ñăt thêm ta Ăñ”?<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Ƀê̆ dăh gao hĭn băh iên, jai Khua Yang ñuôr Kuôn Bôk mŏng dôn teh, Khua Yang ngơi: “Lĕ mơt grăp băl myang Yang Trôk di hên jrăng kôh mpŭ Kuôn hư̆n.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Yơng ta băl myang, Khua Yang ngơi:</para>
  <para style="q1" vid="HEB 1:7">“Mtao lăm ñjêng nêh myang Yang di jêng čal,</para>
  <para style="q1" vid="HEB 1:7">jêh iên băl dư̆k Yang di jêng piêt iñ.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Ƀê̆ dăh yơng ta Kuôn hư̆n, Khua Yang ngơi:</para>
  <para style="q1" vid="HEB 1:8">“Wơ Yang Trôk, jhưng mtao Yang di hôm răn ƀăn hui hai,</para>
  <para style="q1" vid="HEB 1:8">jêh iên pơp khưm kpă jêng pơp myang čar Yang di.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Khua Yang khăp pơp kpă jêh iên hao nuih ta pơp so đăo.</para>
  <para style="q1" vid="HEB 1:9">Yơng hư̆n yơh, Yang Trôk, hư̆n jêng Yang Trôk Kăn di,</para>
  <para style="q1" vid="HEB 1:9">jêh truôč ta Kăn dak ndriêng čhô̆ brơn ŏk hĭn ta băl găp mi Kăn.”<verse eid="HEB 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 1:10" />Jêh iên “Wơ Yang Trôk, băh mhei bôk, Khua Yang lăm ndŏk tur teh dih,</para>
  <para style="q1" vid="HEB 1:10">jêh iên grăp tal trôk jêng lĕ mơt bruă plang ti Yang di mhŏ.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Ĕh jrăng nga rai, ƀê̆ dăh Khua Yang khăng hôm,</para>
  <para style="q1" vid="HEB 1:11">lĕ mơt dŏng ĕh jrăng ñjêng djăh yau klăh di ao djha,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />jêh iên ndrơm klăh di ao djha, Khua Yang jrăng tuôn ĕh ju tŭk,</para>
  <para style="q1" vid="HEB 1:12">klăh di ao bôk dih, nai jrăng mlih lat ĕh,</para>
  <para style="q1" vid="HEB 1:12">ƀê̆ dăh Khua Yang ăt hôm têl lơih,</para>
  <para style="q1" vid="HEB 1:12">jêh iên grăp năm Yang di jrăng so dơi bôl.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Ƀê̆ dăh, Khua Yang ñăm tuôm ngơi ta ju nau mŏng băl myang:</para>
  <para style="q1" vid="HEB 1:13">“Ăn gŭk đăh ma Ăñ</para>
  <para style="q1" vid="HEB 1:13">tăl trôh mông Ăñ ăn băl rŏh Kuôn di ĕh ñjêng tŭk kơng jŏng ta Kuôn”?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />So lăh lĕ mơt băl hư̆n jêng nêh myang mhŏ bruă, nai jao ta hên bruă ksiêm dlăng yơng băh pơp tŭ dơn đơ băl jrăng dơn pơp tŏng tlĕh lăh?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Yơng hư̆n yơh, pơp ho ĕh ăn băn ksiêm nư̆k hĭn ta djăp mta pơp jêh băn tuôm iêt, ơn săk băn tơm jrăng wăč băh ĕh. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Ndă di pơp tơ ti lăh jêh têh sơm băh băl myang jêh ñjêng pơp kjăp, jêh iên djăp pơp mhŏ tih wăt ta pơp so dơn dơk jêh tŭ pơp kmhal năng ngăn ru, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />đô̆ nă băn jrăng dơi tlĕh ndă di băn mưč pơp tŏng tlĕh ram klăh iên? Jêh iên pơp tŏng tlĕh hư̆n, jêh Khua Yang dư̆ng têh sơm luôr hĭn, pơp hư̆n nai lŏ lăm nư̆k ta băn yơng băh băl nêh iêt tŏ; <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />bơ yơng Yang Trôk ăt ju ni ai têh sơm băk hên ta grăp têl ndrơh, pơp myang, jêh iên ŏk bruă myang mdê mdê, wăt ta pơp phă gai băh Yang Ngăt Găl hui si pơp khơñ Khua Yang.<verse eid="HEB 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Bơ yơng so geh ăn ta băl myang ôh ƀê̆ dăh Yang Trôk kĕ kriê trôk teh jrăng trôh, hư̆n jêng trôk teh jai băn tŏng wañ ho. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Mŏng iên, mau ya nêh tuôm têh sơm tŭk ho tŭk tŏ, klăh iêu:</para>
  <para style="q1" vid="HEB 2:6">“Năn pơp kuôn nêh jêng, pơp mhŏ Khua Yang mĭn yơng ta ĕh,</para>
  <para style="q1" vid="HEB 2:6">mdăh năn pơp pôl nhuôr kuôn nêh jêng, pơp mhŏ Khua Yang ruông năk ĕh?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Khua Yang ăn kuôn nêh bhơi hĭn ta băl myang dŏng nê̆ so yau;</para>
  <para style="q1" vid="HEB 2:7">Khua Yang lăm ndau đuôn mtao ta kuôn nêh mŏng pơp guh ang jêh iên năng mpŭ.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Khua Yang ăn djăp pơp mŏng jŏng kăn.”</para>
  <para style="p" vid="HEB 2:8">Bơ yơng jăng jai ñôt bôk djăp pơp, Khua Yang so ăn ju mta pơp so gưt mpŭ ta kăn ôh. Ƀê̆ dăh nar o ñăm băn dơi so djăp mta pơp gưt mpŭ kăn, <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />ƀê̆ dăh băn so Yang Yê-su, jêng Mtao nai ăn bhơi hĭn ta grăp băl myang mŏng ƀê̆ nar, jêh nai lăm ndau đuôn mtao mŏng pơp guh ang jêh iên năng mpŭ yơng băh pơp knap mñai mŏng pơp khư̆t Yang di, no di yơng băh pơp đač Yang Trôk, Khua Yang dơi găn gao pơp khư̆t bi la ta grăp nau nêh. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Bơ yơng Yang Trôk, jêng Mtao yơng băh Khua Yang yơh dơi mau grăp pơp jêh iên mơn băh Khua Yang grăp pơp dơi ñjêng, no di lăm ndơp ŏk kuôn trôh ta pơp guh ang, hư̆n jêh Khua Yang mhŏ pơp geh năng jai ăn Mtao Ñôt Bôk pơp tŏng tlĕh hên di ñjêng nư̆m nơn mŏng pơp knap mñai. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Bơ yơng dŏng băh Mtao lăm ƀrăh ngôr wăt ta lĕ mơt nêh dơi ƀrăh ngôr ĕh lôh băh ƀơn tơm rĕh gu. Yơng băh pơp ho yơh, Khua Yang so prêng ôh jai kuôl hên jêng ŏh mi, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />jai Khua Yang ngơi:</para>
  <para style="q1" vid="HEB 2:12">“Kuôn jrăng têh sơm năn Khua Yang ta grăp ŏh mi Kuôn;</para>
  <para style="q1" vid="HEB 2:12">Kuôn jrăng nơ nei Khua Yang mŏng mbar pôl ŏk.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Jêh iên lŏ ju dŏ hư̆t:</para>
  <para style="q1" vid="HEB 2:13">“Ăñ jrăng gŭk kjăp mŏng Yang Trôk.”</para>
  <para style="m" vid="HEB 2:13">Jêh hư̆n wêh ngơi:</para>
  <para style="q1" vid="HEB 2:13">“Dlăng ho, ăñ jêh iên băl kuôn sei jêng nêh jêh Yang Trôk ăn ta ăñ.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Hư̆n yơh, bơ yơng băl kuôn sei hên mau ju khăn mŏng lŏng mham, hư̆n Khua Yang ăt mau khăn ju băk mŏng pơp hư̆n klăh di găn gao mŏng pơp khư̆t Khua Yang, Khua Yang dơi lăm rai nêh ñôt bôk pơp khư̆t, hư̆n jêng yang djŏh, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />jêh iên dơi lăm tlĕh đơ băl hư̆n, hư̆n jêng đơ băl gŭk brêh mŏng sô̆ gui yô̆ pơp khư̆t, jêng nêh gŭk brêh mŏng pơp jêng dư̆k. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Geh ngăn ya, so mau Khua Yang kĕ kriê băl myang ôh, ƀê̆ dăh Khua Yang guôm čăng pôl nhuôr kăn A-bra-ham, <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />hư̆n yơh Khua Yang jrăng ăn ñjêng ndrơm klăh di ŏh mi Yang di mŏng grăp pơp, no di Khua Yang dơi ñjêng khua mhŏ yang ram krĕh tlŏng đač jêh iên sĭt suôr yơng ta lĕ mơt bruă ĕh lăm ndơp iêu Yang Trôk no di dơi lăm ƀlang pơp đač tŏng pơp tih uôn lan Yang di. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Jai jêh găn gao pơp mblơm, Khua Yang dơi đru dŏng đơ nêh tŭ pơp mblơm, bơ yơng Khua Yang tơm jêh tuôm găn lĕ mơt pơp hư̆n.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Kơt iên, wơ ŏh mi ƀrăh ngôr, jêng băl gŭk mŏng pơp kuôl ndơm băh trôk, ăn dlăng nư̆k ta Nêh Bi La jêh iên Khua Mhŏ Yang Ram pơp têh sơm băn di, hư̆n jêng Yang Yê-su, <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />jai sĭt suôr ta Mtao jêh kčăh Khua Yang, ndrơm klăh di kăn Mô-ih mŏng hih Yang Trôk ya. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Bơ yơng Mtao ho jêng nêh năng ta pơp guh ang ram hĭn kăn Mô-ih, ndrơm klăh di nêh mhŏ hih nai mpŭ ŏk hĭn ya ta hih kăn mhŏ hư̆n. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Bơ yơng grăp mlăm hih yơng băh plang ti nêh lăm ndŏk, ƀê̆ dăh Yang Trôk jêng Mtao rih ñjêng djăp pơp no. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Kăn Mô-ih ñjêng nêh sĭt suôr klăh di nêh dư̆k mŏng lĕ mơt hih Yang Trôk, no di ĕh ñjêng klăh di pơp têh sơm nư̆k hư̆n jêng grăp pơp nai jrăng tŏng ngơi ta nar ta kơi; <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />ƀê̆ dăh Yang Tŏng Tlĕh, klăh di ju nau Nêh Kuôn mŏng hih Yang Trôk (băn jêng hih Yang di ndă băn ñôt kjăp pơp đăo mŏng nuih nhăm jêh iên klăh di pơp nôh ƀlang yơng ta pơp čang mơn băn di). <verse eid="HEB 3:6" /><verse number="7" style="v" sid="HEB 3:7" />Hư̆n yơh, geh trĭp klăh di pơp Yang Ngăt Găl ngơi:</para>
  <para style="q1" vid="HEB 3:7">“Nar o, ndă băl kuôn iêt dơk Khua Yang,<verse eid="HEB 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 3:8" />hư̆n ei ru băl kuôn mhŏ dăng nuih klăh di mông tăm dăng lak,</para>
  <para style="q1" vid="HEB 3:8">mŏng lĕ mơt mông nar găn gao pơp lông dlăng mŏng tač ndrăñ<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />hư̆n jêng tŭk pang yo pu me tăm dăng ta ăñ mŏng pơp hên lông dlăng ăñ, jêh hư̆n hên so lĕ mơt bruă Ăñ mhŏ<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />mŏng puôn jăt năm. Hư̆n yơh, ăñ hao nuih ngăn ta băl mŏng nuk hư̆n,</para>
  <para style="q1" vid="HEB 3:10">jêh iên Ăñ ngơi: ‘Băl ĕh sak hui hai mŏng truông suô̆ băh nuih nhăm tŏ,</para>
  <para style="q1" vid="HEB 3:10">ƀê̆ dăh so tuôm băl ĕh gư̆t ôh truông ƀăng Ăñ ji.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Klăh di Ăñ kăt săk mŏng pơp hao nuih ăñ ji:</para>
  <para style="q1" vid="HEB 3:11">‘… Băl ĕh so dơi mư̆t mŏng pơp mdei Ăñ ji ôh!’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Wơ ŏh mi, ăn răng yơh, ơn nuih nhăm so đăo djŏh ƀai ĕh jrăng lôh băh ju nau nêh mŏng mbar ŏh mi, hư̆n jêng nêh ndrŏh wăč băh Yang Trôk khăng brêh. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ƀê̆ dăh, ăn tŏng čhôl trôt ndăng găp ta grăp nar, tăl trôh mông hôm nai jrăng năn jêng “nar o” no di so mau ju nau nêh mŏng ŏh mi ĕh ñjêng krăk dăng yơng băh pơp mblơm băh pơp tih. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Bơ yơng băl băn jêh ñjêng nêh mhŏ bruă băk Yang Tŏng Tlĕh, khă bi băn ñôt kjăp pơp đăo băn di băh mhei tăl trôh tôč dư̆t, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />klăh di pơp jêh nai têh sơm ru:</para>
  <para style="q1" vid="HEB 3:15">“Nar o, ndă băl kuôn tŏng dơk Khua Yang,</para>
  <para style="q1" vid="HEB 3:15">nuih nhăm băl kuôn ei ru mhŏ krăk dăng klăh di mông tăm dăng lak.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Bơ yơng nêh tơm jêh iêt Khua Yang ru ƀê̆ dăh ăt wêh tăm dăng? So mau nêh băh gu lĕ mơt băl jêh du băh čar Ê-jip mơn băh kăn Mô-ih lăh? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Ƀê̆ dăh Khua Yang hao nuih ta nêh tơm mŏng puôn jăt năm? Yŏng ngăn so lăh geh ta băl mhŏ tih, jêng săk khư̆t hên ĕh bông drak mŏng tač ndrăñ lăh? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Jêh iên Khua Yang kăt săk ta nêh tơm jrăng so dơi mư̆t mŏng pơp mdei Yang di, so lăh geh ngơi ta băl so gưt dơk lăh? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Băn so nư̆k ru hên so mau pơp dơi no di mư̆t mŏng iên yơng băh nuih nhăm krăk dăng.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Hư̆n yơh, ăn băn gư̆t bhŭng mpŭ, ơn dăh jai mau pơp ƀuôn dơi mư̆t mŏng pơp mdei Yang Trôk hôm ĕh gŭk iên, hư̆n mau nêh mŏng ŏh mi klăh di jêh nga ru. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Bơ yơng ndrơm klăh hên ya, băn ăt jêh tuôm tŏng nai têh sơm Pơp Găl. Ƀê̆ dăh, pơp hên iêt tŏng Pơp Găl hư̆n so mau pơp tŭ dơn ta hên, đơ pơp hên iêt hư̆n pơp đăo so ĕh gŭk mŏng hên ôh. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Yơng ta băl băn, jêng nêh jêh đăo, jêh dơi mư̆t mŏng pơp mdei, hui si pơp Khua Yang ngơi:</para>
  <para style="q1" vid="HEB 4:3">“Klăh di pơp jêh Ăñ kăt săk mŏng pơp hao nuih Ăñ ji,</para>
  <para style="q1" vid="HEB 4:3">‘… băl ĕh jrăng so dơi hôm mư̆t mŏng pơp mdei Ăñ ji!’”</para>
  <para style="m" vid="HEB 4:3">wăt di lăh grăp bruă Yang di jêh lĕ mơt dŏng băh nuk lăm ndŏk tur teh dih. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Bơ yơng mau tŭk Khua Yang ngơi klăh iêu yơng ta nar tal pŏh:</para>
  <para style="q1" vid="HEB 4:4">“Jêh iên Yang Trôk gŭk mdei lĕ mơt grăp bruă Yang di mŏng nar tal pŏh.”<verse eid="HEB 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="HEB 4:5" />Jêh iên lŏ wêh mau ya mŏng tŭk dơ dêh:</para>
  <para style="q1" vid="HEB 4:5">“… Băl ĕh jrăng so dơi mư̆t mŏng pơp gŭk mdei Ăñ ji.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Kơt iên, jai pơp ƀuôn hôm nai thêm ta ƀơ ƀă nêh no di hên mư̆t mŏng pơp mdei hư̆n, ƀê̆ dăh đơ băl luôr lak hư̆n jêng băl krĕh têh sơm Pơp Găl so dơi mư̆t yơng băh pơp so gưt dơk, <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />hư̆n Yang Trôk wêh kčăh ju nar dơ dêh hư̆t, nơ năn jêng “Nar o,” Jai ngơi yơng băh kăn Đa-wit dŏng băh yau năm ru, klăh di pơp jêh ngơi băh tê̆ hư̆n:</para>
  <para style="q1" vid="HEB 4:7">“Nar o, ndă băl kuôn iêt dơk Khua Yang,</para>
  <para style="q1" vid="HEB 4:7">hư̆n ei ru mhŏ krăk dăng nuih nhăm băl kuôn.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Ndă di kăn Yô-suê jêh lăm ndơp pơp gŭk mdei ta băl uôn lan, năng ai so Yang Trôk wêh ngơi yơng ta nar dơ dêh ta kơi lĕ mơt bruă ho. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Hư̆n yơh, ăt hôm iên ya pơp mdei Sa-ƀat thêm ta băl uôn lan Yang Trôk di. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Bơ yơng nêh tơm jêh dơi mư̆t mŏng pơp mdei Yang Trôk di, nêh hư̆n ăt jrăng mdei grăp bruă kăn, klăh di Yang Trôk mdei djăp bruă Yang di ya. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Kơt iên, ăn băn hur har mư̆t mŏng pơp mdei hư̆n, no di so mau ju nau nêh ĕh lăč ju băk mŏng pơp so gưt dơk klăh iên. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />Bơ yơng pơp Yang Trôk ngơi jêng pơp ngơi brêh, yuôm bhăn jêh iên sôt nhañ hĭn ta grăp pêh đao bar măt, srăp blôh tăl trôh ta ĕh tăm jăh ngăt jêh iên nhuôl, wăt ta ting jêh iên dlo mŏng tŏ, jêh hư̆n dơi ĕh ksiêm dlăng lĕ mơt pơp mĭn wăt ta pơp khơñ mhŏ mŏng nuih nhăm tŏ. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />So mau ju mta dơi ndăp ta măt Yang Trôk. Ƀê̆ dăh, djăp pơp ĕh lăm pơl prak jêh iên ĕh lăm ƀlang ta măt Khua Yang, jêng Mtao jrăng iêt lĕ mơt pơp lơ lang trôh băh kuôn nêh.<verse eid="HEB 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Kơt iên, jăng jai mau ju nau khua mhŏ yang ram jêh găn gao grăp tal trôk, hư̆n jêng Yang Yê-su Kuôn Yang Trôk, hư̆n ăn băn ñôt kjăp pơp đăo băh dơk băn. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Bơ yơng so geh băn mau ju nau khua mhŏ yang ram so gư̆t đač ta djăp mta pơp djhup dư̆r băn di, Ƀê̆ dăh hư̆n jêng Mtao jêh tŭ pơp mblơm mŏng grăp bruă klăh di pơp mblơm ta băl băn, ƀê̆ dăh so mau ju mta pơp tih ôh. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Hư̆n yơh, ta nuih nhăm năñ, băn dơi sak mơñ ta jhưng pơp đač, no di sŏk dơn pơp đač jêh iên dơi so pơp găl jôn mŏng pơp đru dŏng trip mông nar.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Bơ yơng grăp nau khua mhŏ yang ram, jai jêh dơi săč ruăh mŏng mbar uôn lan, nai kčăh no di hên bi la uôn lan mŏng grăp bruă ĕh rêng ta Yang Trôk, no di hên myơr pơp mhŏ yang jêh iên pơp mhŏ yang tuai tih; <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />jai dơi mau pơp dơi tŏng đač ta băl mlŭk mgu jêh iên suô̆ truông, bơ yơng kăn tơm ăt jêng nêh djhup dư̆r gu ya. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />Hư̆n yơh, kăn jrăng myơr pơp mhŏ yang tuai tih, đô̆ nă kăn myơr ta uôn lan, hư̆n ăt klăh iên ya ta kăn tơm. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />So mau ju nau nêh čŏng sŏk bruă ho ta kăn tơm ƀă, ƀê̆ dăh băh gu Yang Trôk săč ruăh, klăh di kăn A-rôn. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Klăh iên ya, Yang Tŏng Tlĕh so mau čŏng sak mhŏ khua mhŏ yang ram ôh. Mlih mŏng iên jêng Mtao jêh tuôm ngơi ta Khua Yang:</para>
  <para style="q1" vid="HEB 5:5">“Kuôn jêng Kuôn Ăñ;</para>
  <para style="q1" vid="HEB 5:5">nar o Ăñ jêh lai săk ta Kuôn.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Klăh di Mtao hư̆n ngơi ya mŏng tŭk dơ dêh:</para>
  <para style="q1" vid="HEB 5:6">“Kuôn jêng khua mhŏ yang tăl trôh hui hai,</para>
  <para style="q1" vid="HEB 5:6">hui si pôl nhuôr kăn Mên-či-sê-đek.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Jăng jai hôm gŭk brêh mŏng lŏng săk, Khua Yang myơr pơp kuôl dăn wăt pơp khơñ, ju băk ta dơk ôr ñim tlŏng nư̆ng jêh iên dak măt ta Mtao mau pơp myang no di lăm tlĕh Khua Yang băh pơp khư̆t, jêh iên Mtao hư̆n tŏng dơk yơng băh pơp brêh gưt mpŭ Khua Yang di. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Wăt di lăh jêng Kuôn, ƀê̆ dăh Khua Yang riêm pơp gưt mpŭ băh lĕ mơt pơp knap mñai Khua Yang tŭ. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Jêh iên trôh mông jêh dơi mau pơp nư̆m nơn, Khua Yang ñjêng tơm rĕh pơp tŏng tlĕh hui hui ta lĕ mơt nêh gưt dơk Khua Yang, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />jai jêh dơi Yang Trôk kčăh ñjêng khua mhŏ yang ram hui si pôl nhuôr kăn Mên-či-sê-đek, <verse eid="HEB 5:10" /><verse number="11" style="v" sid="HEB 5:11" />ƀê̆ dăh yơng ta nêh ho pơp lăm riêm ta băl băn ŏk ngăn, jêh iên dlĕh lơ lang, bơ yơng ŏh mi jêh ĕh ñjêng wơ wa mŏng pơp iêt. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Bơ yơng tăl trôh ta nar o, geh ngăn ŏh mi jêh ĕh ñjêng nêh tơ ti ru, ƀê̆ dăh ŏh mi mau pơp khơñ juôi nêh dơ dêh lŏ tơ ti hư̆t ŏh mi djăp mta pơp dhơl mŏng grăp pơp ngơi Yang Trôk di, jêh iên ŏh mi ĕh ñjêng nêh khơñ pu dak tŏh, so geh pơp sa pơp krăk! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Bơ yơng grăp nau nêh ndă gư̆t pu gu dak tŏh nêh hư̆n so dơi djăp pơp gư̆t wơng yơng ta pơp đăo kpă, bơ yơng nêh hư̆n hôm jêng kuôn ŏh nga. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Ƀê̆ dăh pơp sa krăk jêng pơp nai ăn ta băl têh ram, hư̆n jêng lĕ mơt nêh mơn băh pơp krĕh mưng mhŏ hui pơp gư̆t năl yơng ta pơp khơñ gư̆t dŏng băh pơp găl wăt pơp djŏh.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Kơt iên, jai jêh găn gao lĕ mơt pơp đăo dhơl yơng ta Yang Tŏng Tlĕh, băn jrăng sak trôh ta tŭk têh ram, ei ru wêh lŏ riêm ôh klăh di pơp niêl mlih tlĕh băh grăp bruă khư̆t, yơng ta pơp đăo mŏng Yang Trôk, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />pơp tơ ti yơng ta pơp ƀap-tem, jêh iên pơp bi ti wăt pơp wêh dŏk brêh nêh khư̆t di, jêh iên pơp phat dôih hui hai. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Băn jrăng mhŏ pơp hư̆n ndă di Yang Trôk ăn. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />Bơ yơng hư̆n jêng bruă so dơi mhŏ — yơng ta băl jêh tuôm mau pơp đang ang, jêh iên hên tuôm sŏk dơn pơp găl jôn băh trôk tê̆, ñjêng nêh sŏk dơn yơng ta Yang Ngăt Găl <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />jêh iên gư̆t wơng pơp ngơi găl jôn Yang Trôk di wăt ta pơp myang băh nuk mhei jrăng trôh <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />ndă wêh păk bông — so dơi wêh ndơp hên trôh ta tŭk niêl mlih ƀă, hên jêng nêh pŏng đĭn Kuôn Yang Trôk ta hên tơm ju dŏ hư̆t, jêh iên hên ƀlang nơn pơp lăm prêng Khua Yang. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Bơ yơng ju lôk teh, jêh bơ bĭ dak mih grăp nar tôh tŏng ĕh jêh iên ĕh jrăng čăt pơp no tŭ dơn ta nai, hư̆n jêng ăn ta nêh čŏh teh, nêh hư̆n mau khăn mŏng pơp găl jôn băh Yang Trôk, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />ndă di ĕh čăt gu pôm luôk jêh iên băt bri, hư̆n jêng teh nai ndrŏh lat jêh iên ndrơm klăh di pơp nai tăm păh, jêh hư̆n tŭk tôč dư̆r ta ĕh jrăng thêm ta iñ hăr sa.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ƀê̆ dăh yơng ta ŏh mi, jêng băl nai khăp khơñ, khă ngơi klăh iên tŭ, hi ăt đăo kjăp ta grăp bruă găl hĭn jêh iên ndơp trôh ta pơp tŏng tlĕh. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Bơ yơng so geh Yang Trôk so kpă ôh tăl Khua Yang huăr tôr ta bruă ŏh mi di, wăt ta pơp khăp jêh ŏh mi lăm ƀlang ta năn Khua Yang, jai ŏh mi đru bruă băl đăo ƀrăh jêh iên nar o ăt hôm đru bruă hên ya. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Ƀê̆ dăh hi khơñ ngăn grăp nau nêh mŏng ŏh mi lăm ƀlang nuih nhăm hur har klăh iên, no di ñôt kjăp nơn yơng ta pơp čang mơn ŏh mi di tăl trôh tôč dư̆t, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />no di ơn ŏh mi jrăng ñjêng băl a lĕh, ƀê̆ dăh jrăng ñjêng nêh hui gre pơp tô mô mơn băh pơp đăo jêh iên nuih nhăm gir găn no di dơn pơp ƀuôn.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Bơ yơng Yang Trôk, jai ƀuôn ta A-bra-ham, Khua Yang so hôm mau nêh ram hĭn no di kăt săk ta nêh hư̆n, hư̆n yơh Khua Yang knang ta săk Yang tơm, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />ngơi klăh iêu: “Ndă di ngĭn ngăn ăn pơp găl, Ăñ jrăng tôh pơp găl jôn tŏng kuôn, jêh iên ndă di wêh mbăč, Ăñ jrăng wêh mbăč pôl nhuôr kuôn ŏk hĭn.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Hư̆n yơh, jai jêh sĭt suôr kăp găn, kăn dơi dơn pơp ƀuôn hư̆n. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />Bơ yơng nai krĕh kăt săk ta nêh ram hĭn ta nai tơm, jêh iên yơng ta hên, tŭk tôč dư̆t djăp mta pơp tŏng pit ĕh lăm ndơp trôh ta pơp lŏ lăm găl jêng pơp kăt săt, <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />ăt iên ya, jai khơñ lăm ƀlang klă hĭn ta băl sŏk dơn pơp ƀuôn yơng ta pơp so ĕh thơp mlih băh pơp khơñ Yang di, hư̆n yơh Khua Yang lăm nư̆k ta pơp kăt săk <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />no di mơn băh bar mta pơp so thơp ĕh mlih hư̆n, yơng ta bar mta pơp hư̆n so thơp mau truông no di Yang Trôk ngơi huôk ôh, băl băn, jêng nêh tuôt trôh ta tŭk buôn săk, năng ai ĕh jrăng dơi jôh lih ktang hĭn no di kŏng kjăp pơp čang mơn jêh nai ăn ru ta măt băn; <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />hư̆n jêng pơp čang mơn băn dơi mau klăh di knuăk ksi ta ngăt nhuôl, mau pơp đăp nang mau pơp kjăp ya, jêh iên sak mư̆t mŏng nuông păng dhiêm, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />hư̆n jêng tŭk jêh Yang Yê-su sak mư̆t klăh di ju nau Mtao sak luôr bi la ta băl băn, jai jêh dơi ñjêng khua mhŏ yang ram tăl trôh hui hai hui si pôl nhuôr kăn Mên-či-sê-đek.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Bơ yơng kăn Mên-či-sê-đek ho, kăn jêng mtao čar La-lem, khua mhŏ yang Yang Trôk Tŏng Tê̆ Hĭn, kăn sak tŏng tuôm ta A-bra-ham jai du băh tŭk tŏng mblăh ta grăp băl mtao, jêh iên kăn dăn pơp găl jôn ta A-bra-ham, <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />hư̆n A-bra-ham sŏk lĕ mơt ju khăn măt ngăn drăp băh tŭk tŏng mblăh jêh iên kăn myơr ta mtao hư̆n; luôr hĭn, Mên-či-sê-đek dơi lơ lang jêng “mtao geh tŏng,” jêh iên gao băh iên kăn jêng mtao čar Sa-lem, ăt jêng “mtao đăp nang,” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />mtao so mau bap, so mau mei, so mau pang yo, so mau nar lai săk mdăh nar tôč dư̆t pơp brêh, ƀê̆ dăh dơi ñjêng klăh di Kuôn Yang Trôk, mtao hư̆n ăt hôm jêng khua mhŏ yang ram tăl tôh hui hai.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Ƀê̆ dăh ăn ksiêm dlăng mtao hư̆n đô̆ nă pơp guh ang kăn, tăl pang yo A-bra-ham myơr ju khăn măt ngăn drăp yuôm bhăn hĭn băh tŭk tŏng mblăh. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Jêh iên đơ băl băh pôl nhuôr Lê-wi, mông hên sŏk dơn bruă mhŏ yang, mông hư̆n hên mau pơp dơi no di hên sŏk ju khăn măt băh uôn lan hui si pơp bhiên, čiêng ngơi băh ŏh mi hên tơm, wăt di lăh hên jêng kuôn so kăn A-bra-ham gơ gu. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Ƀê̆ dăh, mtao hư̆n so mau pôl nhuôr ju băk ta băl hên, ăt kăn dơn ju khăn măt băh kăn A-bra-ham, jêh iên kăn dăn pơp găl jôn ta nêh mau grăp pơp ƀuôn. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Mlih mŏng iên, so mau ju mta pơp tŏng nhan ôh jai nêh gŭk mŏng bruă ram hĭn dăn pơp găl jôn ta nêh gŭk mŏng bruă kuôn nê̆ hĭn. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Jêh iên mŏng bruă ho, đơ nêh mơñ khư̆t dơi sŏk dơn ju khăn măt, jêh iên mŏng bruă tŏ, nai gư̆t nư̆k mtao hư̆n jêng nêh hôm brêh. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Băn dơi ngơi ju mta pơp klăh iêu, Lê-wi, jêng nêh sŏk lĕ mơt ju khăn măt, ăt dơi kăn sŏk lĕ mơt khăn măt găn gao kăn A-bra-ham, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />bơ yơng mông hư̆n hôm kăn gŭk mŏng ndư̆l pang yo kăn hư̆n jêng mông kăn Mên-či-sê-đek tŏng tuôm ta kăn A-bra-ham.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Kơt iên, ndă pơp nư̆m nơn jêng mơn băh bruă mhŏ yang băh băl Lê-wi (bơ yơng mơn băh niêr hư̆n yơh, băl uôn lan dơi dơn pơp bhiên), hư̆n ăn lŏ wêh mbăč hư̆t băl khua mhŏ yang dơ dêh hui si pôl nhuôr Mên-či-sê-đek so hôm ngơp ting ju pôl nhuôr kăn A-rôn? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Bơ yơng bruă mhŏ yang jrăng mlih, yơng băh pơp bhiên kčăh klăh iên, pơp mlih yơng ta pơp bhiên ăt ĕh jrăng mlih ya. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Yơng băh Khua Yang, hư̆n jêng Mtao lĕ mơt pơp ho čiêng ngơi, ting ju pôl nhuôr dơ dêh, jêh iên mŏng pôl nhuôr hư̆n ñăm tuôm mau ju nau nêh mhŏ bruă ta jhưng mhŏ yang ôh. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Bơ yơng klă ngăn ru Khua Yang băn jêng nêh trôh băh găp pôl Yu-đa, jêh iên yơng ta găp pôl hư̆n, Mô-ih so tuôm ngơi ju mta pơp ĕh rêng trôh ta băl khua mhŏ yang ôh. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Pơp ho lŏ lăm nư̆k hĭn ya ndă ĕh dŏk ju nau khua mhŏ yang dơ dêh hui si rup kăn Mên-či-sê-đek, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />hư̆n jêng Mtao ñjêng khua mhŏ yang so mkă hui si pơp krĕh mưng jêh nai kčăh băh lŏng săk, ƀê̆ dăh hui si pơp myang băh pơp brêh hui hai. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Bơ yơng Khua Yang jêh dơi lăm nư̆k klă ru:</para>
  <para style="q1" vid="HEB 7:17">“Kuôn jêng khua mhŏ yang hui hai mkă hui si pôl nhuôr Mên-či-sê-đek.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Gao băh iên, pơp mhŏ nai ndrŏh pơp bhiên luôr lak bơ yơng ĕh djhup dư̆r jêh iên so tŭ dơn <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(bơ yơng pơp bhiên so ĕh lăm ndơp trôh ta pơp nư̆m nơn), jêh hư̆n gao băh iên jêng pơp ĕh lăm ndơp trôh ta pơp čang mơn găl hĭn, mơn băh iên yơh băh dơi sak mơñ Yang Trôk. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />Jêh iên so lăh geh lĕ mơt pơp ho ĕh mau băh pơp kăt săk, — wăt di lăh đơ băl hư̆n so mau pơp kăt săk ƀê̆ dăh jêh dơi ñjêng khua mhŏ yang gơ gu, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />ƀê̆ dăh Khua Yang jêh gŭk nơn mŏng pơp pơp kăt săk, mơn băh Mtao ngơi ta Khua Yang:</para>
  <para style="q1" vid="HEB 7:21">“Yang Trôk jêh kăt săk jêh iên jrăng so hôm wêh mlih:</para>
  <para style="q1" vid="HEB 7:21">‘Kuôn jêng khua mhŏ yang tăl trôh hui hai.’” —<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />hư̆n yơh hui si truông găl hĭn lĕ mơt, Yang Yê-su ñjêng Mtao bi la ta pơp ƀuôn găl hĭn. <verse eid="HEB 7:22" /><verse number="23" style="v" sid="HEB 7:23" />Wăt di lăh đơ băl tuôm ñjêng khua mhŏ yang ŏk hĭn tŭ mơh, yơng băh pơp khư̆t ĕh ghă so dơi hên wêh mhŏ bruă ôh, <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />ƀê̆ dăh, Khua Yang ñôt bruă mhŏ yang so dơi wêh mlih, bơ yơng Khua Yang krĕh hôm tăl trôh hui hai, <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />yơng băh iên yơh, Khua Yang ăt mau pơp myang no di tŏng tlĕh nư̆m nơn đơ nêh sak mơñ Yang Trôk găn gao Khua Yang, jêng Mtao khăng brêh no di kuôl dăn un ta hên. <verse eid="HEB 7:25" /><verse number="26" style="v" sid="HEB 7:26" />Bơ yơng ju nau khua mhŏ yang klăh iên geh ngăn jêng thêm ta băl băn: Mtao ƀrăh ngôr, so mau tih, geh găl, gŭk wăč băh băl tih djŏh, jêh iên ĕh ñjêng guh ang hĭn ta grăp tal trôk; <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />jêng Mtao so čang myơr pơp mhŏ yang grăp nar lôh klăh di băl khua mhŏ yang dơ dêh ôh, hên myơr pơp tuai tih, luôr hĭn tuai ta pơp tih hên tơm, jêh hư̆n jêng pơp tih băl uôn lan, bơ yơng jêh Khua Yang mhŏ pơp hư̆n ru hư̆n jêng mông Khua Yang myơr săk Khua Yang tơm ju dŏ nư̆m lĕ mơt. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Bơ yơng pơp bhiên lăm ndŏk đơ nêh bêng pơp djhup dư̆r ñjêng khua mhŏ yang ram, Ƀê̆ dăh pơp kăt săk, jêng pơp trôh ta kơi pơp bhiên, jêh hư̆n ĕh lăm ndŏk Kuôn, jêng Mtao jêh dơi ñjêng nư̆m nơn tăl trôh hui hai.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Kơt iên, pơp yuôm bhăn čiêng ngơi mŏng pơp ho jêng klăh iêu: Băn mau ju nau khua mhŏ yang ram klăh iên, jêng Mtao jai gŭk đăh ma jhưng mtao Mtao Kdrăm Ka ăh tŏng grăp tal trôk, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />ju nau nêh dư̆k mŏng tŭk ƀrăh ngôr jêh iên tư̆m dhiêm ngơ ngăn yơng băh Yang Trôk tơm lăm ndŏk, so geh kuôn nêh ôh. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Bơ yơng grăp nau băl khua mhŏ yang ram nai jao no di hên myơr lĕ pơp myơr wăt pơp mhŏ yang, yơng hư̆n yơh, Mtao hư̆n ăt mau ju mta pơp ya no di myơr ta jhưng mhŏ yang. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Kơt iên, ndă di Khua Yang hôm mŏng dôn teh, ngĭn ngăn yơh Khua Yang so mhŏ khua mhŏ yang ram ôh, bơ yơng jêh mau nêh myơr pơp mhŏ yang hui si pơp bhiên ru; <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />hư̆n jêng băl mhŏ bruă hui si kdrăp jêh iên rup băh lĕ mơt pơp tŏng trôk, klăh di Mô-ih jêh tuôm nai tơ tă jai mơñ kăn lăm jêh tư̆m dhiêm, bơ yơng Yang Trôk ngơi: “Ăn răng, me jrăng mhŏ djăp pơp hui si rup jêh nôh ƀlang ru ta me tŏng dôn yôk.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ƀê̆ dăh nar o, jêh Khua Yang sŏk dơn ju mta bruă ram hĭn dŏng ŏk, Khua Yang ăt jrăng ñjêng Mtao bi la ta pơp tăm guôp găl hĭn dŏng iên ya, hư̆n jêng pơp tăm guôp jêh nai dơn ru knang tŏng grăp pơp ƀuôn găl hĭn. <verse eid="HEB 8:6" /><verse number="7" style="v" sid="HEB 8:7" />Ndă di pơp tăm guôp tal muôi hư̆n so mau ju mta pơp bhơi, ƀăh jai mŏng pơp tăm guôp tal bar ho so hôm mau nơn. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Bơ yơng jăng jai ƀuăh ñjăm băl uôn lan, Yang Trôk ngơi:</para>
  <para style="q1" vid="HEB 8:8">“Ăn dlăng ho, mông nar hư̆n jai trôh, Yang Trôk ngơi:</para>
  <para style="q1" vid="HEB 8:8">Ta kơi ho ăñ jrăng mkra pơp tăm guôp mhei</para>
  <para style="q2" vid="HEB 8:8">ta băl I-sra-el jêh iên ta băl Yu-đa;<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />so hôm knang hui si pơp tăm guôp</para>
  <para style="q2" vid="HEB 8:9">hư̆n jêng pơp ăñ mkra ta băl pang yo hên</para>
  <para style="q1" vid="HEB 8:9">mŏng nar ăñ kŏng ti hên</para>
  <para style="q2" vid="HEB 8:9">no di têk lăm hên du băh čar Ê-jip,</para>
  <para style="q1" vid="HEB 8:9">bơ yơng so hên khơñ gŭk mŏng pơp tăm guôp ăñ ji,</para>
  <para style="q2" vid="HEB 8:9">ăñ ndrŏh lat hên,</para>
  <para style="q1" vid="HEB 8:9">Yang Trôk ngơi.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Bơ yơng ho jêng pơp tăm guôp Ăñ mkra ta băl I-sra-el ta kơi lĕ mơt nar hư̆n,</para>
  <para style="q2" vid="HEB 8:10">Yang Trôk ngơi,</para>
  <para style="q1" vid="HEB 8:10">jai Ăñ ăn pơp bhiên Ăñ mŏng bôk dlo hên,</para>
  <para style="q1" vid="HEB 8:10">Ăñ jrăng wêh čih ĕh mŏng nuih nhăm hên ya,</para>
  <para style="q1" vid="HEB 8:10">jêh iên Ăñ jrăng ñjêng Yang Trôk ta hên,</para>
  <para style="q1" vid="HEB 8:10">jêh iên hên jrăng ñjêng ju uôn lan thêm ta Ăñ.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Ngĭn ngăn so hên jrăng tơ ti băl uôn lan hên</para>
  <para style="q1" vid="HEB 8:11">wăt băl ŏh mi hên di, klăh iêu: ‘Ăn gư̆t năl Yang Trôk,’</para>
  <para style="q1" vid="HEB 8:11">bơ yơng lĕ mơt dŏng hên jrăng gư̆t năl Ăñ,</para>
  <para style="q1" vid="HEB 8:11">dŏng băh băl kuôn nê̆ ngăn mŏng hên trôh ta nêh ram.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Bơ yơng Ăñ jrăng băn dhư̆ yơng ta grăp bruă so kpă hên mhŏ,</para>
  <para style="q1" vid="HEB 8:12">jêh iên ngĭn ngăn so hôm Ăñ lŏ wêh kăh wơi ta pơp tih hên ya.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Bơ yơng bruă ngơi jêng “mhei”, hư̆n Khua Yang ngơp pơp tăm guôp tal muôi ñjêng pơp yau, năn pơp jêh ĕh ñjêng yau jêh iên jêng djơ̆h rơh klăh di pơp jêh nga rai ru.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Hư̆n nar o, pơp tăm guôp tal muôi hư̆n ĕh krĕh mau grăp pơp kčăh yơng ta pơp kôh mpŭ, ju băk mŏng iên mau ƀơn tŭk ƀrăh ngôr mŏng dôn teh, <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />bơ yơng ƀơn tư̆m dhiêm jêh nai lăm ndŏk, ju khăn tal muôi, mŏng iên mau jŏng kđen wăt jhưng, ju băk ta grăp klŏ ƀăñ myơr, hư̆n jêng tŭk nai nơ năn jêng “Tŭk Ƀrăh”, <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />jêh iên ta kơi păng dhiêm tal bar mau ju mlăm du lăm dêh, tŭk hư̆n nai nơ năn jêng “Tŭk Ƀrăh Hĭn”, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />ta iên mau jhưng pô̆ pơp ƀau kăh ta măh, jêh iên mau hip tăm guôp nai luôm lĕ ta măh, mŏng nuông hip hư̆n nai ăn yăng măh mŏng nuông tŏ mau ma-na, mŏng jra ĕh čăt kao kăn A-rôn di, jêh iên grăp păng mau pơp bhiên, <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />jêh iên tŏng bôk hip hư̆n, mau grăp Čê-ru-ƀim guh ang ĕh guôm ndrư̆p pơp đač, ƀê̆ dăh yơng ta lĕ mơt pơp hư̆n so geh mông no di ngơi đêt lĕ mơt ôh. <verse eid="HEB 9:5" /><verse number="6" style="v" sid="HEB 9:6" />Jăng jai jêh nai dăp dăng lĕ mơt pơp hư̆n klăh iên, grăp băl khua mhŏ yang hên krĕh sak mư̆t mŏng dŭ lăm tal muôi, hên mhŏ lĕ mơt bruă nai jao ta hên; <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />ƀê̆ dăh băh gu khua mhŏ yang ram dơi mư̆t mŏng dŭ lăm tal bar ju năm ju dŏ, jêh iên so dơi so mau mham ôh, hư̆n jêng pơp tuai tih kăn myơr ta săk kăn tơm wăt ta grăp pơp tih băl uôn lan di. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Yang Ngăt Găl tơ to ta băn gư̆t nư̆k ru mŏng bruă hư̆n, truông mư̆t mŏng tŭk ƀrăh hĭn lĕ mơt ñăm nai lăm ƀlang ôh jai tư̆m dhiêm tal muôi hôm ĕh gŭk ta iên, <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ƀê̆ dăh hư̆n jêng pơp ngơi păt juôr ta nuk nar o, jêh iên hui si truông hư̆n, lĕ mơt pơp mhŏ yang tuai tih nai myơr so ĕh mau pơp dơi no di ĕh lăm nư̆m nơn nêh kôh mpŭ ting ju ngăt nhuôl, <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />băh gu ĕh rêng ta pơp sa jêh iên pơp ñêt, wăt ta grăp kdrăp lăm ƀrăh ngôr mdê mdê, hư̆n jêng grăp pơp nai kčăh ting ju lŏng săk, nai hui gưt tăl trôh ta mông nai mlih ĕh.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ƀê̆ dăh Yang Tŏng Tlĕh, jai dŏk mŏng bruă khua mhŏ yang ram băh grăp bruă nhăp găl hư̆n jêng bruă khăng mau, găn gao hih dhiêm ram hĭn jêh iên nư̆m hĭn so mau yơng băh plang ti nêh lăm ndŏk, hư̆n jêng pơp so mau mŏng dôn teh ho, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />ăt so geh yơng băh mham bei kuăng mdăh ndrôk kuôn, ƀê̆ dăh yơng băh mham Khua Yang tơm, Khua Yang mư̆t jêh mŏng grăp tŭk ƀrăh ngôr ju dŏ djăp lĕ, Khua Yang tơm sak sŏk pơp tŏng tlĕh hui hai. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Ndă di mham bei kuăng mdăh ndrôk kuăng wăt ta bruă prĕ dô̆ buh ndrôk drôh tŏng grăp băl ƀơ̆ ñơ̆ ăt dơi ya ĕh lăm ndơp pơp ƀrăh ngôr, hư̆n jêng pơp nai yua no di lăm ƀrăh ngôr săk jăn hên, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />ƀăh jai jêng mham Yang Tŏng Tlĕh, hư̆n jêng Mtao yơng băh Yang Ngăt Găl hui hai jêh Khua Yang myơr săk Khua Yang tơm no di ĕh ñjêng pơp mhŏ yang so mau têl so mau ƀơ̆ ta Yang Trôk, ĕh jrăng lăm ƀrăh ngôr nuih nhăm ŏh mi mŏng nuông tŏ tlĕh băh lĕ mơt bruă khư̆t no di mhŏ bruă Yang Trôk khăng brêh! <verse eid="HEB 9:14" /><verse number="15" style="v" sid="HEB 9:15" />Yơng hư̆n yơh, Khua Yang jêng Mtao Bi La ta pơp tăm guôp mhei, no di ta kơi pơp khư̆t thêm ta bruă tuai grăp pơp tih mkă ta pơp tŏng guôp tal muôi jêh gao ru, đơ băl jêh nai săč ruăh dơi sŏk dơn pơp ƀuôn yơng ta ngăn drăp hui hai. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Bơ yơng u tŭk mau ră tă dơk, ta iên jrăng mau pơp khư̆t nêh čih ră tă dơk ta iên. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Bơ yơng mau pơp khư̆t kăh ră tă dơk mau pơp tŭ dơn, hư̆n yơh so ĕh mau pơp tŭ dơn jai nêh čih ră tơ tă hôm brêh. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Kơt iên, pơp tăm guôp yau lak ăt nai mkra ta mham ya. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Bơ yơng jăng jai kăn Mô-ih têh sơm grăp pơp tơ tă mŏng pơp bhiên ta lĕ mơt băl uôn lan, jêh kăn sŏk mham ndrôk kuôn jêh iên bei kuăng, wăt ta dak, sei brai brông, mbăh jhi ƀau jêh iên kăn prĕ tŏng ră pơp bhiên wăt ta lĕ mơt băl uôn lan, <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />kăn ngơi: “Ho jêng mham pơp tăm guôp jêh Yang Trôk tơ tă ta ŏh mi.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Ăt klăh iên ya, kăn prĕ mham tŏng tư̆m dhiêm wăt ta lĕ mơt pơp no mŏng kdrăp pơp mhŏ yang. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Mkă hui si pơp bhiên, đơ lĕ mơt pơp no nai jrăng lăm ngôr ƀrăh ta mham, jêh iên ndă so mau pơp tôh mham ăt so mau pơp ndrŏh tih ya.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Hư̆n yơh, ndă đơ lĕ mơt pơp tô mô ta grăp pơp tŏng trôk ăt knang ta mham hư̆n no di lăm ƀrăh ngôr ĕh, ƀăh jai grăp pơp no tŏng trôk ĕh jrăng knang ta pơp mhŏ yang yuôm hĭn ya no di lăm ƀrăh ngôr ĕh, <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />ngăn ya, Yang Tŏng Tlĕh ei so mau mư̆t mŏng tŭk ƀrăh ngôr yơng băh ti kuôn nêh mhŏ ôh — hư̆n jêng grăp pơp tô mô ta grăp pơp ngĭn ngăn — mlih mŏng iên Khua Yang mư̆t nơn mŏng uôn găl, no di nar o lăm ƀlang ta măt Yang Trôk bi la un ta băl băn, <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />ăt so mau myơr săk Yang di ŏk dŏ, klăh di băl khua mhŏ yang ram grăp năm hên sak mư̆t mŏng grăp tŭk ƀrăh ngôr wăt ta mham tuai tih nêh dơ dêh; <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />ndă so mhŏ klăh iên, pơp knap mñai Khua Yang tŭ añ ĕh jrăng ŏk hĭn dŏng băh mông rih ñjêng trôk teh. Ƀê̆ dăh nar o, băh gu ju dŏ mŏng mông tôč dư̆t grăp nuk, yơng băh pơp lăm rai pơp tih, hư̆n nai lăm ƀlang Khua Yang mŏng pơp săn săk Yang di. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Jêh iên hui si pơp jêh kčăh ta kuôn nêh jrăng khư̆t ju dŏ, jêh hư̆n kăh jêng pơp phat dôih, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />ăt iên ya, jêh myơr ju dŏ no di añ lĕ mơt pơp tih grăp nau nêh, nai jrăng so Yang Tŏng Tlĕh tal bar, so hôm añ pơp tih ôh, ƀê̆ dăh no di ăn pơp tŏng tlĕh trôh ta grăp nau nêh kăp găn Khua Yang.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Bơ yơng pơp bhiên — băh gu ĕh mau rup grăp pơp nhăp găl mơñ trôh, so geh rup ngơ ngăn đơ pơp hư̆n di ƀă — so tuôm dơi ĕh lăm nư̆m nơn đơ nêh sak mơñ Yang Trôk ta pơp mhŏ yang ƀă ƀê̆ dăh hên jrăng myơr pơp mhŏ yang grăp năm. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Ndă di dơi, pơp mhŏ yang trôh mông ho ăt jêh ăn mdei lat ru, bơ yơng đơ băl kôh mpŭ so hôm hên ñôt pơp prêng yơng băh pơp tih ôh, jai jêh nai lăm ƀrăh ngôr hên ju dŏ gu djăp lĕ mơt lăh? <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Mlih mŏng iên, yơng ta grăp pơp mhŏ yang hư̆n, jêng ƀơn pơp lăm kăh wơi ta pơp tih grăp năm. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Bơ yơng mham ndrôk kuăng jêh iên bei kuăng so dơi lăm ngôr pơp tih ƀă. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Hư̆n yơh, jai mư̆t mŏng dôn teh, Khua Yang ngơi:</para>
  <para style="q1" vid="HEB 10:5">“So Yang Trôk khơñ</para>
  <para style="q2" vid="HEB 10:5">pơp mhŏ yang jêh iên pơp myơr,</para>
  <para style="q2" vid="HEB 10:5">ƀê̆ dăh jêh Khua Yang prê ju mlăm săk jăn ta Kuôn;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Khua Yang ăt so khơñ</para>
  <para style="q2" vid="HEB 10:6">pơp mhŏ yang pô̆ jêh iên pơp mhŏ yang tuai tih ya.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Jêh hư̆n, ăñ ngơi: ‘Dăn dlăng ho, Kuôn jêh trôh —</para>
  <para style="q2" vid="HEB 10:7">hui si pơp ngơi mŏng ră čih yơng ta kuôn —</para>
  <para style="q1" vid="HEB 10:7">no di lăm jêh pơp khơñ Khua Yang, wơ Yang Trôk!’”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Jai Khua Yang ngơi pơp klăh iên ru: “Khua Yang so khơñ pơp mhŏ yang jêh iên pơp myơr, wăt ta pơp mhŏ yang pô̆ jêh iên pơp mhŏ yang tuai tih. Khua Yang ăt so khăp ta grăp pơp hư̆n ya” (ƀê̆ dăh nai myơr ĕh hui si pơp bhiên), <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />jêh hư̆n, Khua Yang ngơi: “Dăn dlăng ho, Kuôn sak lăm jêh pơp khơñ Yang di.” Khua Yang ndrŏh lat pơp tal muôi lak no di lăm ndŏk pơp tal bar. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Yơng băh pơp khơñ hư̆n, lĕ dŏng băn dơi mau pơp ƀrăh ngôr mơn băh pơp myơr săk jăn Yang Tŏng Tlĕh Yê-su no di ĕh ñjêng pơp mhŏ yang ju dŏ djăp lĕ. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Ngăn ya, lĕ mơt băl khua mhŏ yang grăp nar hên dŏk mkra pơp mhŏ yang jêh iên hên krĕh myơr pơp mhŏ yang, ƀê̆ dăh so dơi ĕh lăm nga lat pơp tih ôh. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Ƀê̆ dăh Khua Yang, yơng băh lĕ mơt pơp tih băn myơr pơp mhŏ yang čuôm gu ju dŏ tăl trôh hui hai, Khua Yang gŭk rŏk ta kêng đăh ma Yang Trôk, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />kăp găn dŏng băh mông hư̆n tăl trôh mông đơ băl rŏh Khua Yang gŭk mŏng tŭk juôt jŏng Yang di. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Bơ yơng băh gu mơn ƀơn băh pơp mhŏ yang hư̆n, Khua Yang ăn lĕ mơt băl ƀrăh ngôr dơi ñjêng nư̆m nơn tăl trôh hui hai. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Jêh iên Yang Ngăt Găl ăt lăm nư̆k un băl băn ya, bơ yơng ta kơi hư̆n Khua Yang ngơi:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Ho jêng pơp tăm guôp ăñ jrăng mkra ta hên</para>
  <para style="q2" vid="HEB 10:16">ta kơi lĕ mơt nar hư̆n, Yang Trôk ngơi,</para>
  <para style="q1" vid="HEB 10:16">jai ăñ ăn pơp bhiên ăñ ji mŏng nuih nhăm hên,</para>
  <para style="q2" vid="HEB 10:16">ăñ jrăng wêh čih pơp hư̆n tŏng bôk mĭn hên ya.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />Jêh hư̆n:</para>
  <para style="q1" vid="HEB 10:17">“Ngĭn ngăn yơh so hôm ăñ jrăng wêh wơi ta pơp tih hên ôh</para>
  <para style="q2" vid="HEB 10:17">mdăh grăp bruă pliă plia hên ya.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />Ƀê̆ dăh u tŭk mau pơp ndrŏh grăp pơp tih hư̆n, tŭk hư̆n so hôm wêh mau pơp mhŏ yang tuai tih ôh.<verse eid="HEB 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Kơt iên, wơ ŏh mi, băn dơi mau nuih nhăm năñ mư̆t mŏng tŭk ƀrăh ngôr mơñ băh mham Yang Yê-su, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />jêng Mtao jêh mkra ru ta băl băn ƀơn truông sak mhei jêh iên brêh găn gao păng dhiêm, čiêng ngơi ta săk jăn Khua Yang, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />jêh iên ju nau khua mhŏ yang ram kĕ kriê tŏng hih Yang Trôk di, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />hư̆n yơh băn khơñ Yang Trôk ta nuih nhăm ngĭn ngăn mŏng pơp kčăh nư̆k băh pơp đăo, nuih nhăm jêh nai prĕ mham rao ƀrăh băh pơp mĭn djŏh ƀai jêh iên săk jăn jêh nai rao ta dak sang ƀrăh. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ăn băn ñôt kjăp pơp jêh băn têh sơm yơng ta pơp čang mơn băn di ei ru rŭng răng, bơ yơng Mtao ƀuôn hư̆n jêng sĭt suôr. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Jêh hư̆n ăn băn tŏng đru ndăng găp no di băn čhôl trôt yơng ta nuih nhăm khăp khơñ jêh iên grăp bruă nhăp găl, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />ei ru ndrŏh lat pơp tăm ƀư̆n băn klăh di ƀơ ƀă nêh krĕh mhŏ, ƀê̆ dăh ăn băn tŏng čhôl trôt ndăng găp, jêh iên năn mông ŏh mi so nar hư̆n mơñ trôh dŏng iên hư̆n ăn ŏh mi ndôl mhŏ klăh iên hĭn ya.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Ndă di băn jêh gư̆t pơp ngĭn ngăn ru ƀê̆ dăh băn čŏng mhăl mhŏ tih, hư̆n so hôm wêh mau pơp mhŏ yang tuai tih ôh, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />ƀê̆ dăh băh gu hôm kăp găn đhir ngit yơng ta pơp phat dôih jêh iên iñ dôh ñjrăng hăr sa đơ băl tăm dăng. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Grăp nau nêh, ndă di hên ndrŏh lat pơp bhiên Mô-ih knang ta bar mdăh pei nau nêh so nư̆k, nai jrăng lăm khư̆t so hôm wêh đač. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Đa lăh ŏh mi mĭn ta nêh juôt lên Kuôn Yang Trôk, jêh iên dlăng mham tăm guôp jêng dăh dan ƀơ̆ ñơ̆ — ƀăh mơn băh mham hư̆n, kăn dơi ƀrăh ngôr — jêh iên mưč mač Yang Ngăt Găl pơp đač, kăn hư̆n năng ta pơp kmhal jŏk hĭn băh iên ya? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Bơ yơng băn gư̆t ru Mtao ngơi: “Pơp rŭ nua jêng bruă ăñ ji; ăñ jrăng sak rŭ.” Wêh ngơi ya: “Yang Trôk jrăng phat dôih uôn lan Yang di.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Ĕh lăč mŏng ti Yang Trôk Khăng Brêh jêng pơp đhir ngit ngăn yơh!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Ƀê̆ dăh ăn wêh kăh wơi đơ nar ta luôr lak, ŏh mi jêh dơi sŏk dơn pơp pơk ang ru, hư̆n jêh ŏh mi tŭ ju mta pơp tŏng mblăh ram băh ŏk pơp knap mñai, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />mông ho ŏh mi tŭ pơp nai hêr mưč wăt ta pơp nai mhŏ ƀai ta măt băl uôn lan, ƀê̆ dăh mau ya mông băn ñjêng nêh tŏng bhă ta băl tŭ pơp knap mñai klăh iên. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Bơ yơng ŏh mi mau nuih nhăm gư̆t tŏng đač ta băl nai nggruôn, jêh iên ŏh mi tŭ ư ăn nai sua ngăn drăp ŏh mi di ta pơp čhô̆ brơn, bơ yơng ŏh mi gư̆t ŏh mi mau ngăn drăp găl hĭn jêh iên hôm hui hai. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Kơt iên, ei ru ŏh mi ndrŏh lat pơp đăo kjăp ŏh mi di, hư̆n jêng pơp jrăng dơn ju khăn pơp khôm ram. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Bơ yơng ăn ŏh mi riêm pơp kăp găn gir ăt, no di jêh mhŏ hui pơp khơñ Yang Trôk, mông hư̆n ŏh mi dơi dơn pơp ƀuôn.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“Bơ yơng so hôm yau ƀă,</para>
  <para style="q1" vid="HEB 10:37">Mtao jai sak jrăng trôh, jêh iên jrăng so la ƀă.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Ƀê̆ dăh nêh kpă ăñ ji jrăng brêh yơng băh pơp đăo;</para>
  <para style="q1" vid="HEB 10:38">ƀê̆ dăh nêh tơm lŏ du ta kơi, mông hư̆n ngăt nhuôl ăñ so hôm găl ta nêh hư̆n ôh.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />Ƀê̆ dăh băl băn so gŭk mŏng tŭk ĕh plơ̆ nuih trôh ta tŭk rai lêk ôh, mlih mŏng iên băn gŭk mŏng pơp đăo ĕh lăm ndơp trôh tŭk guôm čăng ngăt nhuôl.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Pơp đăo jêng pơp gư̆t klă kjăp yơng ta grăp pơp băn čang mơn, jêng pơp nư̆k yơng ta grăp pơp băn so dơi so. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Bơ yơng mơn băh pơp đăo, băl pang yo lak dơi mau pơp nai têh sơm găl. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Mơn băh pơp đăo băn dơi gư̆t wơng trôk teh ho dơi rih ñjêng yơng băh pơp ngơi Yang Trôk di — tăl lĕ mơt pơp dơi băn so ĕh mau băh pơp so dơi băn so. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Mơn băh pơp đăo kăn A-ƀel myơr ta Yang Trôk pơp mhŏ yang găl hĭn ta kăn Ka-in, mơn băh iên dơi ngơp kăn jêng nêh kpă, jai Yang Trôk ngơp pơp kpă ta kăn mŏng grăp pơp mhŏ yang kăn, jêh iên mơn băh pơp đăo, A-ƀel hôm nai kăh wơi ya wăt di lăh kăn jêh khư̆t. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Mơn băh pơp đăo Hê-nŏk dơi du tŏng trôk, so kăn găn gao pơp khư̆t, jêh iên “so hôm nai so kăn, yơng băh Yang Trôk sŏk kăn du.” Bơ yơng luôr ta kăn dơi du, nai ngơp kăn jêng nêh mhŏ geh nuih nhăm Yang Trôk. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Ƀê̆ dăh, ndă so mau pơp đăo jrăng so dơi lăm brơn nuih nhăm Yang Trôk. Bơ yơng nêh tơm sak ta Yang Trôk ăn đăo mau Yang Trôk jêh iên Khua Yang krĕh khôm ta nêh tơm juôi Khua Yang. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Mơn băh pơp đăo, jai jêh Nô-ê tŏng pơp Yang Trôk têh sơm yơng ta grăp bruă ñăm tuôm so, hư̆n kăn bhŭng mpŭ ta Khua Yang, Nô-ê mhŏ ju mlăm plŭng thêm ta pơp lăm tlĕh hih nhăk kăn, mơn băh iên, kăn dơi phat dôih dôn teh jêh iên ĕh ñjêng nêh ndơn pơp kpă mơn băh pơp đăo. <verse eid="HEB 11:7" /><verse number="8" style="v" sid="HEB 11:8" />Mơn băh pơp đăo, yơng băh pơp kuôl ndơm, A-bra-ham gưt dơk no di sak trôh ta tŭk kăn jrăng dơn no di ñjêng ngăn drăp, jêh iên kăn sak ƀê̆ dăh so kăn gư̆t u tŭk kăn jrăng sak. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Mơn băh pơp đăo, kăn gŭk brêh mŏng čar ƀuôn klăh di năč ndrơh, jai jêh kăn gŭk brêh mŏng tư̆m dhiêm băk kăn I-săk jêh iên kăn Ya-kôp, jêng băl dơn ju băk pơp ƀuôn, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />Bơ yơng hôm kăn kăp găn ju uôn ram mau tur kjăp, jêh iên nêh mkra rup jêh iên lăm ndŏk hih hư̆n jêng Yang Trôk. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Mơn băh pơp đăo, tăl ta de Sa-ra tơm jêh dơi de dơn pơp dơi bă kuôn wăt di lăh săk jăn de jêh u rañ, bơ yơng de gư̆t năl Mtao ƀuôn ta de hư̆n jêng sĭt suôr. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Kơt iên, ăt yơng băh ju nau nêh — jêh iên nai dlăng klăh di jêh khư̆t ru — ƀê̆ dăh dơi bă ŏh muôn kuôn so, ŏk klăk klai blăh di măñ tŏng trôk, jêh iên blăh di kiêk so dơi ngơp ta kêng hang dak sĭ. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Mŏng pơp đăo, lĕ mơt băl ho jêh khư̆t jai ñăm hên dơn grăp pơp ƀuôn, ƀê̆ dăh hên so jêh iên hên tŭ drông ĕh băh wăč, hên ngơp hên tơm jêng năč ndrơh jêh iên năč sak truông mŏng dôn teh. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Bơ yơng đơ băl ngơi grăp pơp klăh iên hư̆n băn gư̆t nư̆k ru jai hên juôi nguôl hên tơm. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Ndă di hên kăh wơi nguôl hên hư̆n jêng tŭk hên jêh ndrŏh lat, ngĭn ngăn yơh hên jrăng mau mông găl no di hên du plơ̆. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Ƀê̆ dăh nar o hên hur har khơñ mau ju mlăm čar găl hĭn, hư̆n jêng čar tŏng trôk. Hư̆n yơh Yang Trôk so mau prêng yơng ta hên, no di nai kuôl jêng Yang Trôk hên, bơ yơng jêh Khua Yang prăp prê ju mlăm čar ta hên. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Mơn băh pơp đăo, A-bra-ham myơr kăn I-săk jai mông lông dlăng, tăl trôh mông jêh kăn dơi mau grăp pơp ƀuôn, kăn sak myơr kuôn ƀơn kăn di, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />yơng ta kuôn hư̆n, mau pơp ngơi klăh iêu: “Mŏng kăn I-săk, pôl nhuôr me jrăng dơi mau năn,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />bơ yơng kăn čŏng mĭn klăh iêu Yang Trôk mau pơp dơi no di wêh lăm brêh hư̆t, khă nêh băh tŭk khư̆t tŭ, ăt ndrơm klăh iên ya, kăn dơi wêh sŏk hư̆t kuôn kăn băh tŭk hư̆n. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Ăt mơn băh pơp đăo, kăn I-săk dăn pơp găl jôn ta kăn Ya-kôp jêh iên kăn Ê-sau yơng ta grăp bruă jrăng trôh. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Mơn băh pơp đăo, trôh mông mơñ khư̆t, kăn Ya-kôp dăn pơp găl jôn ta grăp nau kuôn kăn Yô-sep, jêh iên kăn dưh ta mŏng jra kăn jêh iên kăn kôh mpŭ. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Mơn băh pơp đăo, trôh mông mơñ khư̆t, kăn Yô-sep ngơi yơng ta bruă kuôn so I-sra-el jrăng du jêh iên tơ tă hên yơng ta săk khư̆t kăn di. <verse eid="HEB 11:22" /><verse number="23" style="v" sid="HEB 11:23" />Mơn băh pơp đăo, jai jêh nai lai săk, mei bap kăn Mô-ih sŏk srôm kăn mŏng pei khe bơ yơng hên dlăng kuôn sei hư̆n nhăp găl, jêh iên so hên bhŭng ta pơp bhiên mtao di. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Mơn băh pơp đăo, trôh mông ram, Mô-ih ndrŏh lat năn nai kuôl jêng kuôn tlau ta de kuôn ur Pha-ra-ôn. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Mlih mŏng iên, kăn ruăh pơp tŭ knap ju băk ta uôn lan Yang di hĭn ta pơp brêh čhô̆ brơn bhiêu mŏng pơp tih. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Kăn dlăng pơp nai lăm prêng yơng ta nêh nai truôč dak ndriêng jêng pơp ndrŏng săh ram hĭn ta grăp ngăn drăp čar Ê-jip. Bơ yơng băh gu kăn dlăng nư̆k ta pơp nai jrăng khôm ta kăn. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Mơn băh pơp đăo, kăn ndrŏh čar Ê-jip, so kăn bhŭng ta pơp hao nuih mtao di, bơ yơng kăn gir ăt lĕ mơt klăh di jêh kăn tuôm so Mtao so dơi so. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Mơn băh pơp đăo, kăn mkra Mar Găn Gao jêh iên pơp prĕ mham, no di ơn băl myang lăm khư̆t kuôn bôk băl I-sra-el di. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Mơn băh pơp đăo, băl uôn lan sak găn Dak Sĭ Brông klăh di hên sak mŏng teh răñ, hư̆n jêng tŭk băl Ê-jip khư̆t krăm mŏng dak sĭ. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Mơn băh pơp đăo, grăp pir gang uôn Yê-ri-kô ĕh dlưh mŏng sô̆, jăng jai jêh hên sak jư̆m dar pŏh nar. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Mơn băh pơp đăo, de čhơng tăt Ra-hap so khư̆t ju băk ta băl so đăo, jêh de tŭ drông băl ksiêm čar ta nuih nhăm găl. <verse eid="HEB 11:31" /><verse number="32" style="v" sid="HEB 11:32" />Jêh iên năn pơp hôm ăñ lŏ wêh têh sơm? Bơ yơng mông nar so hôm wêh djăp ta ăñ ndă ăñ wêh têh sơm yơng ta kăn Gê-đê-ôn, Ƀa-răk, Sam-sôn, Yep-thê, Đa-wit, jêh iên wăt ta kăn Sa-mu-el jêh iên đơ băl têh luôr <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />hư̆n jêng băl, mơn băh pơp đăo, hên sak sua grăp čar, mhŏ pơp geh tŏng, dơi sŏk dơn pơp ƀuôn, ndap yuôi tla mhư̆r, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />lăm khư̆t pơp ktang iñ hăr, tlĕh băh măt pêh đao, wêh ñjêng ktang băh tŭk djhup dư̆r, dơi ñjêng prăl ktang mŏng tŭk tăm mblăh, hên lăm rai pôl ka han băl ling lač. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Ŏk băl u ur hên lŏ wêh so hư̆t nêh băh hih nhăk hên dŏk brêh băh tŭk khư̆t, ƀê̆ dăh đơ băl dơ dêh nai kmhal, so hôm čang mơn nai lăm tlĕh, no di hôm dơi hên dơn hư̆t pơp wêh brêh găl jôn; <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />bơ băl dơ dêh jêh hên tŭ pơp lông dlăng băh pơp nai hêr mưč jêh iên pŭ plat, jêh iên gao hĭn băh iên jêng sei kliêng đai ta war mnă. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Nai jăng hên ta mau, nai uôt mŏng mbar, hên tŭ pơp lông dlăng, hên khư̆t ta pêh đao srĕh păč, hên sak tŏ o mŏng tau biêp, tau bei, tŭ knap mñai, nai pŭ bang, nai mhŏ ƀai; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />(jêh iên dôn teh so hôm năng ta hên), hên sak wơ wa mŏng tač ndrăñ, yôk čuôr, grăp gơp mau jêh iên grăp trôm mŏng teh. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Jêh hư̆n jêh dơi nai têh sơm găl yơng băh pơp đăo, lĕ mơt đơ băl ho ñăm tuôm hên dơn pơp ƀuôn ta hên ôh, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />bơ yơng jêh Yang Trôk mkra pơp găl hĭn yơng ta băl băn, no di so mau băl băn, hên so dơi ñjêng nư̆m nơn ôh.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Bơ yơng hư̆n yơh, jăng jai mau ju ñuôi tŭk ram ngăn băh ŏk nêh ksiêm dlăng jư̆m dar băn, mông hư̆n băl băn, jai jêh ndrŏh lat lĕ mơt grăp pơp jŏk jêh iên pơp tih lưih ĕh lăm păk bông, ăt hôm băn dhul mŏng pơp tŏng lông jêh nai ăn ru ta măt băn mŏng pơp gir, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />ăn dlăng nư̆k gu ta Yang Yê-su, jêng Mtao Rih Ñjêng jêh iên Mtao Lăm Nư̆m Nơn pơp đăo, hư̆n jêng Mtao yơng băh pơp čhô̆ brơn ăn lĕ mơt pơp ta măt tơm jêh iên tŭ añ jhi tăm kăng, dlăng nghơč pơp prêng, jêh iên Khua Yang gŭk đăh ma jhưng mtao Yang Trôk. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Ăn ksiêm dlăng nư̆k ta Mtao jêh tŭ añ pơp knap mñai ram klăh iên băh lĕ mơt băl tih djŏh tŏ, no di ơn ŏh mi tŏng ăr măh mŏng nuih nhăm tŏ, tăl ĕh plơ̆ nuih.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />Ñăm tuôm ŏh mi tăm dăng tăl ĕh tôh mham jai mông tăm mblăh ta pơp tih ƀă, <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />ƀê̆ dăh jêh ŏh mi wăr lĕ mơt pơp jêh nai tơ tă, hư̆n jêng pơp nai tơ tă ŏh mi klăh di kuôn, klăh iêu:</para>
  <para style="q1" vid="HEB 12:5">“Wơ kuôn ăñ ji, ei ru mưč pơp tơ ti lăh Yang Trôk di,</para>
  <para style="q1" vid="HEB 12:5">ăt ei ru plơ̆ nuih ya jai Khua Yang ƀuăh mkra;<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Bơ yơng nêh Yang Trôk khăp, Khua Yang jrăng ƀuăh mkra,</para>
  <para style="q1" vid="HEB 12:6">jêh iên Khua Yang plat kmhal grăp nau kuôn Khua Yang sŏk ruôm.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Jai ŏh mi gir mŏng pơp ƀuăh mkra; hư̆n jêng Yang Trôk jai mhŏ ta ŏh mi klăh di kuôn. Bơ yơng mau ya ju nêh kuôn so mau pơp bap ƀuăh mkra? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Ƀê̆ dăh ndă so ŏh mi khơñ tŭ pơp ƀuăh mkra, klăh di lĕ mơt băl ñjêng ŏh kuôn pŏng hên gir, ŏh mi jêng kuôn bă dăm, jêh iên so geh băl kuôn ngơ ngăn Yang Trôk di ôh. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Gao băh iên, băn mau băl bap ting ju lŏng săk băn ho, klăh di băl ƀuăh mkra, jêh iên ăt băn mpŭ ya; ƀăh jai bap ting ju đăh ngăt, so lăh băn jrăng mpŭ ŏk hĭn, no di băn dơi mau pơp brêh hui hai lăh? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Wăt di lăh bap ting ju lŏng săk ho ƀuăh mkra băn mŏng ƀê̆ nar hui si pơp găl hĭn ĕh mau mŏng hên, ƀê̆ dăh Bap ting ju đăh ngăt ƀuăh mkra yơng băh pơp tŭ dơn ta băn, no di băn gŭk mŏng pơp ƀrăh ngôr Yang di. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Khă lĕ mơt pơp ƀuăh mkra băh mhei bôk so mau ju mta pơp čhô̆ brơn, mŏng iên mau pơp ji kôr, ƀê̆ dăh trôh ta kơi, pơp hư̆n ĕh mau ple ngăp nge băh pơp kpă ta nêh tơm tŭ pơp riêm băh ĕh. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Kơt iên, ăn ŏh mi lăm ndŏk hư̆t grăp plang ti jêh ĕh djhup dư̆r jêh iên đơ ting krŭng lĕ luôi dlut, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />jêh iên ăn lăm tŏng lĕ mơt truông ta jăng ŏh mi sak, no di so ĕh tiêr bông băl jŏh dlŭt, mlih mŏng iên hên dơi mau pơp băh.<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Ăn tư̆ng juôi pơp êngiê ta grăp nau nêh, wăt ta pơp ñjêng ƀrăh, ndă so mau pơp ho so mau nêh dơi so Yang Trôk, <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />ăn ksiêm dlăng nơ nôh, no di ơn mau nêh jrăng nga băh pơp đač Yang Trôk, ơn dăh ĕh jrăng čăt rĕh tăng băh tê̆ tŏ lăm rŭng, jêh iên ŏk nêh jrăng ñjêng ƀơ̆ ñơ̆ yơng băh ĕh hư̆n, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />ơn di mau nêh čhơng tăt mdăh mưč mač klăh kăn Ê-sau, hư̆n jêng nêh yơng băh mlih pơp sông sa jêh iên kăn blơ̆ pơp dơi ñjêng kuôn bôk kăn di. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Bơ yơng ŏh mi gư̆t klă ru tăl ta kơi hư̆n, jai kăn khơñ mau pơp găl jôn, ƀê̆ dăh nai ndrŏh kăn ta ling, yơng băh so hôm kăn mau mông niêl mlih, wăt di lăh kăn juôi ĕh ta dak măt.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Bơ yơng ŏh mi so dơi sak mơñ ta pơp dơi bi, ta iñ hăr sa, ta pơp ngo măng, ta pơp ñhuôt črê̆, jêh iên ta čal ŭ <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ju băk ta dơk kei ôh wao, jêh iên băh dơk ngơi đhir ngit tăl nêh tơm iêt hên dăn ei ru hôm ăn hên tŏng dŏng nê̆ pơp klăh iên ôh. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Bơ yơng so hôm dơi hên iêt pơp ngơi ho, klăh iêu: “Djăp mta pơp păm ĕh sak mơñ yôk ho, ăt nai jrăng jăng mau ya.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Jêh iên rup ĕh nôh ƀlang mông hư̆n đhir ngit tăl kăn Mô-ih ngơi: “Ăñ bhŭng ngăn jêh iên prơ prăm.” <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Ƀê̆ dăh, ŏh mi dơi trôh ta yôk Si-ôn jêh iên uôn ram Yang Trôk khăng brêh, trôh Yê-ru-sa-lem tŏng trôk, ju băk ta klăk klai băl myang, ju băk ta pôl kôh mpŭ, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />jêh iên Pôl Ƀrăh băl kuôn bôk jêh nai čih năn tŏng grăp tal trôk, ta Yang Trôk jêng Mtao phat dôih grăp nau nêh, wăt ta grăp ngăt nhuôl băl geh găl di jêh nai lăm nư̆m nơn ru, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />ta Yang Yê-su, Mtao Mŏng Mbar pơp tăm guôp mhei di, jêh iên ta mham pơp jêh nai prĕ mau dơk ngơi prăl ktang hĭn ta mham kăn A-ƀel. <verse eid="HEB 12:24" /><verse number="25" style="v" sid="HEB 12:25" />Ăn gư̆t răng, no di ơn ŏh mi ndrŏh lat Mtao jai tơ ti lăh. Bơ yơng ndă băl tŏ hư̆n so dơi hên tlĕh jai so hên khơñ iêt nêh buôi hên mŏng dôn teh, hư̆n băn jrăng ñjêng kjham hĭn ya, jai băn ñjêng nêh wiêng kơi ta Mtao jư̆r băh trôk, <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />jêh iên dơk Mtao hư̆n ĕh lăm nggăr teh mŏng nuk hư̆n, bơ nar o Khua Yang ƀuôn klăh iêu: “Wêh ju dŏ hư̆t săk ăñ tơm jrăng lăm nggăr, so mau băh gu teh, ƀê̆ dăh wăt tal trôk.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Đơ pơp ngơi “Wêh ju dŏ hư̆t” ĕh sơm nư̆k bruă ndrŏh lat grăp pơp jêh ĕh nggăr, klăh di djăp pơp jêh rih ñjêng, no di lĕ mơt pơp so dơi ĕh nggăr jrăng hôm iên. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Hư̆n yơh, ăn băn mau nuih gư̆t lăh găl jai băn sŏk dơn ju mlăm čar so dơi ĕh nggăr, mơn băh iên băn dơi kôh mpŭ hui si kdrăp găl nuih nhăm Yang Trôk, ta nuih nhăm bhŭng wăt ta mpŭ, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />bơ yơng Yang Trôk băn di jêng piêt iñ sa hăr.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Pơp khăp khơñ ŏh mi ăn hôm nơn iên. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Ei ru ndrŏh lat pơp ruôm năč, yơng băh bruă ho, mau nêh ruôm băl myang ƀê̆ dăh so hên gư̆t. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Ăn kăh wơi ta nêh jai gŭk mŏng war mnă, klăh di nai nggruôn ju băk ta hên, wăt ta băl nai mhŏ knap, klăh di săk ŏh mi tơm mau ƀơn săk jăn băk hên. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Ăn grăp nau nêh mpŭ ta pơp tăm sai, jêh iên ei ru lăm ƀơ̆ dŭ lăm ur sai di, bơ yơng Yang Trôk jrăng phat dôih băl čhơng tăt jêh iên băl dŏng tư̆r. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Mŏng pơp brêh ŏh mi ei ru he ta prăk, ăn băn brơn nuih ta djăp mta pơp băn mau, bơ yơng jêh Khua Yang ngơi ru: “So ăñ jrăng yĕh băh kuôn, ăt so ăñ ndrŏh kuôn ya,” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />tăl ta băn, dơi mau nuih nhăm năñ, jêh iên băn ngơi:</para>
  <para style="q1" vid="HEB 13:6">“Yang Trôk jêng Mtao đru dŏng ăñ jêh iên so hôm ăñ jrăng bhŭng ôh.</para>
  <para style="q1" vid="HEB 13:6">Nêh tơm dơi mhŏ ta ăñ?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Ăn kăh wơi ta băl têk lăm ŏh mi, hư̆n jêng băl tơ ti lăh pơp ngơi Yang Trôk ta ŏh mi, jêh ŏh mi ksiêm dlăng ple băh pơp brêh hên di, ăn hui gre pơp đăo hên. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Yang Tŏng Tlĕh Yê-su năng đo, nar o jêh iên tăl trôh hui hai ăt hôm nơn iên. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Ei ru ăn nai mblơm yơng băh grăp pơp đăo ndrơh. Bơ yơng pơp găl jôn mŏng nuih nhăm hư̆n jêng pơp kjăp băh pơp đač, so mau yơng băh grăp pơp sông sa, jêh iên yơng ta grăp pơp hư̆n, đơ băl brêh yơng băh ĕh so mau ju mta pơp tŭ dơn. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Băn mau ju mlăm jhưng kôh mpŭ, dŏng băh o, đơ băl mhŏ bruă mŏng tư̆m dhiêm so mau pơp dơi no di sa ĕh. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Bơ yơng mham tuai tih, jêng ju khăn pơp ĕh lôh băh puh ndrôk, nai ndơp mŏng grăp tŭk ƀrăh yơng băh băl khua mhŏ yang ram, đơ čĭ ĕh nai sŏk jhu ta ling pôih ka han tŏ. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Hư̆n yơh, Yang Yê-su ăt tŭ pơp knap mñai ta ling uôn ram ya, no di Khua Yang dơi lăm ƀrăh ngôr băl uôn lan mŏng mham Khua Yang tơm. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Kơt iên, ăn băn sak băk Khua Yang ta ling uôn ram, tŭ añ lĕ mơt pơp prêng Yang di. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Bơ yơng băn so hôm mau ju mlăm uôn ram hôm ĕh gŭk ta o ôh, mlih ta iên, jai băn juôi ju mlăm uôn ram jrăng trôh. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Mơn Khua Yang, băn dơi myơr pơp mhŏ yang nơ nei ta Yang Trôk mŏng grăp pơp, hư̆n jêng ple kao băh dơk ko nơ nei năn Yang. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Bơ bruă mhŏ pơp găl jêh iên pơp tăm đru dŏng ei ru ndrŏh lat bơ yơng Yang Trôk găl nuih nhăm yơng ta grăp pơp mhŏ yang klăh iên. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />Ăn gưt dơk jêh iên bhŭng mpŭ ta băl têk lăm ŏh mi, bơ yơng hên ngĕh măng yơng ta ngăt nhuôl ŏh mi klăh di hên yơr pơp ngơi lơ lang, no di ăn hên mhŏ bruă hư̆n ta nuih nhăm hur har jêh iên so hên tŏng wăm, bơ yơng pơp ho so tŭ dơn ta ŏh mi.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Ăn kuôl dăn ta hi ƀă, bơ yơng hi gư̆t klă hi mau nuih nhăm ƀrăh ngôr, jai hi khăp khơñ brêh geh kdrăp mŏng grăp bruă. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Ƀê̆ dăh ndôl ăñ čhôl trôt ŏh mi ăn mhŏ klăh iên ŏk hĭn, no di ưm nai phưi ăñ du ta ŏh mi.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Yang Trôk đăp nang, Mtao jêh lăm brêh Mtao Kĕ Biêp Ram, hư̆n jêng Yang Yê-su băn di, băh tŭk khư̆t mơn băh mham tŏng guôp hui hai, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />dăn Khua Yang prăp prê ŏh mi ta grăp pơp nhăp găl no di ŏh mi mhŏ hui pơp khơñ Yang di, jai mhŏ pơp geh ta măt Khua Yang mŏng băl băn, mơn băh Yang Tŏng Tlĕh Yê-su, hư̆n jêng Mtao lĕ mơt pơp guh ang ĕh jrăng du ta Khua Yang tăl trôh răn ƀăn hui hai. A-men.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Wơ ŏh mi, ăñ kuôl ndơm ŏh mi gir kăp găn yơng ta pơp jôh lih ho, bơ yơng ăñ čih ru ta ŏh mi băh gu ƀê̆ pơp ngơi dŏng iên gu. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Ŏh mi gư̆t ru kăn Ti-mô-thê jêng găp mi băn di jêh nai phưi ru băh war, ju băk ta kăn ăñ jrăng tŏng tuôm ta ŏh mi ndă kăn trôh ưm.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Dăn kôh čhưn đơ nêh têk lăm ŏh mi wăt ta lĕ mơt băl đăo ƀrăh. Grăp băl đăo ƀrăh băh I-ta-li dăn kôh čhưn ŏh mi.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Dăn pơp đač Yang Trôk di gŭk băk ta lĕ mơt ŏh mi.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>