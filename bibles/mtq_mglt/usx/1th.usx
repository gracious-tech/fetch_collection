  <book code="1TH" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:03:38 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">Thư Tê-sa-lô-ni-ca thứ nhất</para>
  <para style="toc2">1 Tê-sa-lô-ni-ca</para>
  <para style="toc3">1Th</para>
  <para style="mt">1 Tê-sa-lô-ni-ca</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />Phao-lô, ôộng Sin-vanh, côống ôộng Ti-mô-thê cởi cho Hối Thành Tê-sa-lô-ni-ca tloong Thiên Chùa, là Cha ôộng Chùa, là Chùa Cừu Thề Giê-xu. Nguyến ân điển ôộng sứ pính an ở tlêng ái ới ùn.<verse eid="1TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />Tán tôi luôn cảm tá Thiên Chùa vến tẩt cả ái ới ùn, khới chăng xôi vé tềng ái ới ùn tloong cảc lới cấu nguyến của mếng, <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />ví căắn tềng côông việc pởi đửc tin, ôộng sứ khò nhoọc pởi tính yêu xương, côống loóng kiên tlí pởi niếm hy voóng của ái ới ùn ở Chùa tán ha, là Chùa Cừu Thề Giê-xu, tlưởc mặt Thiên Chùa, Cha tán ha; <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />ví mẳt ái ới ùn, cảc moón àn Thiên Chùa yêu xương, ái ới ùn àn Thiên Chùa lứa chón, <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />pởi ví Tin Lénh của tán tôi tà àn truyến cho ái ới ùn chăng chỉ pắng lới khề, mơi yý pắng quyến năng ôộng pắng Chùa Thành Linh, côống niếm tin chẳc chằn — như ái ới ùn mẳt tán tôi tà khôồng như xí nó khừa voóng ái ới ùn ví ỉch lới của ái ới ùn. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />Ái ới ùn yý tà tlở rêng cảc moón xeo gương của tán tôi ôộng của Chùa, khới tiểp nhấn đáo khừa nhiếu khò khăn côống sứ phui mứng của Chùa Thành Linh. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />Tềng nổi, ái ới ùn tà tlở rêng tầm gương cho tẩt cả cảc moón cò đửc tin ở Ma-xê-đoan ôộng ở A-chai. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />Ví pở ái ới ùn, đáo Chùa tà àn truyến xa, chăng chỉ tloong púng Ma-xê-đoan ôộng tloong púng A-chai, mơi đửc tin của ái ới ùn ở Thiên Chùa tà lan truyến tềng khồm tược. Xí rêng, tán tôi chăng kỉa cấn phải vé chi nửa. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />Pởi khới vé vến tán tôi, chình maáng hay vé lái sứ tiểp tòn mà tán tôi tà cò ở ái ới ùn xa xí nó, ôộng xí nó ái ới ùn tà lảc ti hính tướng, hường vến Thiên Chùa tể phục vuú Thiên Chùa hắng khôồng ôộng chân xật, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />ôộng tể chớ tới Con Ngái pở tlới, Tầng mà Ngái tà mấn khôồng lái pở cày chểt – nghỉa là Chùa Giê-xu, Tầng giải cừu tán ha khỏi cơn phẩn nố tang tềng.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />Thưa ái ới ùn, chình ái ới ùn hay là việc tán tôi tềng côống ái ới ùn tà chăng tlở rêng vô ỉch. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />Mơi khâu khới chíu khổ ôộng pí sỉ nhục ở thánh Phi-líp xeo như ái ới ùn tà mẳt, tán tôi àn can đảm tloong Thiên Chùa của tán tôi tể rao truyến cho ái ới ùn Tin Lénh của Thiên Chùa khừa nhiếu sứ tlanh đầu. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />Ví việc khuyên nái của tán tôi chăng phải xa pở tiếu khai tlài, yý chăng tềng pở loóng ô dơ, hay pởi ỳ tố lứa gạt, <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />mơi tán tôi tà àn Thiên Chùa thử luyến tể àn giao phò Tin Lénh như xí nó, xì tán tôi yý vé xa xí rì, chăng phải tể mấn phưa loóng maáng, mơi tể mấn phui loóng Thiên Chùa. là Tầng tla xẻt loóng tán tôi. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />Như ái ới ùn tà hay, khới rì tán tôi chăng tềng côống cảc lới nính hỏt, hay pởi loóng xam giả hính — Thiên Chùa mấn chừng — <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />yý chăng xím kiềm vinh quang pở loái moón, chăng phải pở ái ới ùn hay pở moón khảc, <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />tuy cò thể àn tiểp đải tử tề ví là sừ tố của Chùa Cừu Thề, mơi ở khừa ái ới ùn, tán tôi như là teẻ xa cảc con rẻt, khảc nó mế cấn phải chăm nom con mếng. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />Ví yêu mền ái ới ùn như xí, rêng tán tôi phui loóng chia sẻ côống ái ới ùn chăng chỉ Tin Lénh của Thiên Chùa, mơi cón maáng khôồng của chình mếng. Rì là pởi ái ới ùn tà tlở rêng cảc moón yêu dầu đồi côống tán tôi. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />Thưa ái ới ùn, chẳc là ái ới ùn cón căắn sứ lao nhoọc ôộng vẩt vả của tán tôi, tán tôi tà rao giảng Tin Lénh của Thiên Chùa cho ái ới ùn khới vẩn mấn việc têm ngày tể chăng mấn tliêng nắng cho pẩt ký ôông ay tloong ái ới ùn. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />Ái ới ùn là nhân chừng, ôộng cả Thiên Chùa nửa, là đồi côống ái ới ùn, là cảc moón cò loóng tin, tán tôi tà khôồng thành khiểt, côông chình, ôộng chăng thể tlẻch àn xa xí nó, <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />yý như ái ới ùn tà mẳt, xí nó tán tôi đồi côống mổi mộch moón tloong ái ới ùn, như pồ đồi côống con cài mếng, <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />khuyên nhủ ái ới ùn, khỉch lế ôộng thủc giục ái ới ùn tể ăn ở xật xừng đàng côống Thiên Chùa, Tầng hôổc ái ới ùn pao tloong vương quổc ôộng vinh quang của Ngái.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />Pởi lỳ do rì, tán tôi yý chăng xôi cảm tá Thiên Chùa, ví khới tiểp lế lới Thiên Chùa qua việc măng xeo pở tán tôi, ái ới ùn tà tòn nhấn chăng phải như lới của con moón, mơi xeo xật sứ rì là lới của Thiên Chùa, yý là tiếu tang mấn việc tloong ái ới ùn, nghỉa là tloong cảc moón cò loóng tin. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />Thưa ái ới ùn, ái ới ùn tà tlở rêng cảc moón xeo gương cảc Hối Thành của Thiên Chùa, là cảc hối thành tloong Chùa Cừu Thề Giê-xu ở tái púng Giu-đê, ví ái ới ùn tà chíu côống cảc khồn khổ pởi chình dân tộc mếng, chôồng như cảc hối thành rì yý tà chíu pở moón Do Thài, <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />là cảc moón tà phưa giểt Chùa, là Chùa Giê-xu, côống cảc tiên tli, phưa pẳt pờ tán tôi, ôộng yý là cảc moón chăng mấn phui loóng Thiên Chùa, lái cón thú địch côống tẩt cả cảc moón, <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />khới cầm cản tán tôi rao giảng cho moón ngoái quổc tể nhiếu moón cò thể àn cừu, tà mấn xối lổi của maáng cừ luôn lẩp tấy xêm. Mơi tềng cuồi cúng, cơn phẩn nố chẳc chằn giàng tlêng maáng.<verse eid="1TH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />Thưa ái ới ùn, ngay cả pí chia cảch côống ái ới ùn tloong mộch khoảng thới gian, tuy xa mặt mơi chăng cảch loóng, tán tôi hểt khửc sổt roạch tloong niếm khao khảt mẳt cớ nó tể tốn mặt ái ới ùn. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />Cho rêng, tán tôi moành ti tềng côống ái ới ùn — nhẩt là tôi, Phao-lô, mộch han lấn pú ti — mơi Sa-tan tà ngăn cản tán tôi. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />Ví niếm hy voóng, hay sứ phui mứng, hoặc vương miến hảnh diến của tán tôi là cày chi? Chăng phải rì là ái ới ùn ở tlưởc mặt Chùa tán ha, là Chùa Giê-xu, tloong sứ hiến tềng của Ngái hay chăng? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />Xật, ái ới ùn là vinh quang ôộng sứ phui mứng của tán tôi.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />Pởi xí, khới chăng chíu lô hơn àn, tán tôi nghỉ tổt hơn là mộch mếng tôi phải pí ở lái tái A-thên, <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />ôộng tán tôi tà khai phài Ti-mô-thê, moón ái ùn của tán tôi ôộng moón hấu việc của Thiên Chùa tloong Tin Lénh của Chùa Cừu Thề, tể mấn vửng váng ôộng khuyền khỉch ái ới ùn vến đửc tin của mếng, <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />tể chăng ôông ay pí nao nùng khừa cảc hoán nán ní. Ví chình ái ới ùn hay là tán ha tà àn lứa chón đồi diến chuyến như xí. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />Tềng nổi khới tán tôi cón ở côống ái ới ùn, tán tôi tà pảo tlưởc cho ái ới ùn là tán ha sẻ chíu hoán nán, ôộng việc xảy xa chôồng như ái ới ùn tà mẳt. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />Ví lỳ do rì, khới chăng thể chíu lô hơn àn nửa, tôi tà khai moón ti tể hay đửc tin ái ới ùn như xí nó, hay nó xên càm dổ pắng cảch nó rì tà càm dổ ái ới ùn ôộng côông lao của tán tôi thánh xa vô ỉch. <verse eid="1TH 3:5" /><verse number="6" style="v" sid="1TH 3:6" />Mơi ngay caá ní, Ti-mô-thê, khâu khới ti pở tược ái ới ùn vến côống tán tôi, tà tom cho tán tôi tin phui vến đửc tin ôộng tính yêu xương của ái ới ùn, là ái ới ùn luôn giử cảc kỳ ửc tổt lénh vến tán tôi, moong mỏi tốn tán tôi yý chôồng như tán tôi moong tốn ái ới ùn. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />Ví lỳ do rì, thưa ái ới ùn, tán tôi àn yên ủi pởi ái ới ùn khới đồi mặt côống tẩt cả hiểm nguy ôộng hoán nán của mếng, ví đửc tin của ái ới ùn. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />Kể pở caá ní, nều chình ái ới ùn từng vửng tloong Chùa, xì tán tôi khôồng. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />Tán tôi cò thể dơng lêng Thiên Chùa lới cảm tá xí nó vến ái ới ùn dứa tlêng tẩt cả niếm hân hoan mà ví pởi ái ới ùn, tán tôi phui mứng tlưởc mặt Thiên Chùa tán tôi, <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />têm ngáy cấu nguyến khẩn thiểt tể àn tốn mặt ái ới ùn ôộng xêm lêng cày chi cón xiều tloong đửc tin ái ới ùn?<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />Cấu cườn chình Thiên Chùa, Cha tán ha, ôộng Chùa Giê-xu, Chùa tán ha, tưa khà tán tôi tềng côống ái ới ùn. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />Nguyến Chùa mấn ái ới ùn xêm lêng ôộng dư dật tloong tính yêu xương đồi côống phố ôộng đồi côống tẩt cả cảc moón, yý như cảch tán tôi đồi côống ái ới ùn, <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />tể mấn cho loóng ái ới ùn vửng váng, chăng cò cày chi đàng tlẻch tloong sứ thành khiểt tlưởc mặt Thiên Chùa, Cha tán ha, tloong sứ hiến tềng của Chùa tán ha, là Chùa Giê-xu, côống ôộng tẩt cả cảc thành tố Ngái. A-men!<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />Xí rêng, cuồi cúng, thưa ái ới ùn, tán tôi nái cườn ôộng khuyên nhủ ái ới ùn tloong Chùa, là Chùa Giê-xu, chôồng như ái ới ùn tà nhấn àn pở tán tôi xí nó là tiếu cấn thiểt cho ái ới ùn tể khôồng ôộng mấn phưa loóng Thiên Chùa, yý như cảch ái ới ùn tang khồng, tể cho ái ới ùn cò thể tăng tlưởng hơn nửa. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />Ví ái ới ùn mẳt cảc giào huần nó tán tôi tà truyến cho ái ới ùn pởi Chùa Giê-xu. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />Ví ní là ỳ moành của Thiên Chùa, nghỉa là sứ rêng thành của ái ới ùn: phải giử mếng tlènh xa sứ gian dâm; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />mổi moón tloong ái ới ùn phải mẳt gín giử pỏc mếng mếng tloong sứ thành khiểt ôộng tôn tlóng, <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />chăng mấn xeo ham moành dâm dục (chôồng như moón ngoái quổc là moón chăng mẳt Thiên Chùa); <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />tể má ôông ay vi phám ôộng lứa gạt ái ới ùn mếng tloong việc ní, pởi ví Chùa là Tầng pào thú vến tẩt cả cảc tiếu rì, chôồng tán tôi yý tà vé tlưởc ôộng nghiêm tủc kẻnh pào cho ái ới ùn. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />Ví Thiên Chùa chăng hôổc tán ha tềng sứ ô uề, mơi pao tloong sứ rêng thành. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />Pởi xí, ôông ay tứ chồi mếnh lếnh ní chăng phải tứ chồi con moón, mơi là tứ chồi Thiên Chùa, Tầng pan Chùa Thành Linh Ngái cho ái ới ùn.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />Cón vến tính thân ái ới ùn, ái ới ùn chăng cấn tán tôi viểt cho ái ới ùn, ví chình ái ới ùn tà àn Thiên Chùa táy phải yêu xương phố. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />Ví xật, ái ới ùn cò mấn như xí đồi côống tẩt cả ái ới ùn tloong cả tỉnh Ma-xê-đoan. Mơi thưa ái ới ùn, tán tôi nái khuyên ái ới ùn cừ gia tăng hơn nửa, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />ôộng phải gằng khửc khôồng yên lắng, chăm lo cảc việc của mếng, tứ xay mếng mấn việc, như tán tôi tà truyến táy ái ới ùn, <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />tể ái ới ùn cò thể ăn ở cảch phân miêng tlưởc mặt moón chăng tin ôộng chăng cò xiều xồn cày chi.<verse eid="1TH 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />Thưa ái ới ùn, tán tôi chăng moành ái ới ùn chăng mẳt cày chi vến cảc moón tang tảy, tể ái ới ùn chăng tâu puốn chôồng cảc moón khảc là cảc moón chăng cò niếm hy voóng. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />Ví nều tán ha tin là Chùa Giê-xu tà chểt ôộng tà khôồng lái, xì Thiên Chùa yý sẻ tom cảc moón tà tảy tềng côống Ngái thông qua Chùa Giê-xu. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />Dứa pao lới của Chùa, tán tôi vé tiếu ní cho ái ới ùn là tán ha, cảc moón caá ní tang khôồng, cảc moón cón ở lái cho tềng khới Chùa tlở lái, chẳc chằn sẻ chăng ti tlưởc cảc moón tà tảy. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />Ví chình Chùa sẻ pở tlới giàng xuồng côống mếnh lếnh, côống xiềng của thiên sừ tlưởng, côống ôộng xiềng kén của Thiên Chùa, rối cảc moón tà chểt tloong Chùa Cừu Thề, sẻ khôồng lái tlưởc tiên. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />Tiểp xeo, tán ha, là cảc moón caá rì tang khôồng, cảc moón cón lái, sẻ àn tom lêng côống ôộng maáng tloong cảc đàm mân tể tốn Chùa tlêng khôông tlung, ôộng như xí, tán ha sẻ ở côống Chùa luôn luôn. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />Xí rêng, hảy an ủi phố pắng cảc lới ní.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />Thưa ái ới ùn, vến thới điểm ôộng thới ký, ái ới ùn chăng cấn tán tôi viểt cho ái ới ùn. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />Ví ngay ái ới ùn hay rẩt rỏ ráng là ngáy của Chùa tềng như xí nó — như moón lốm tloong pan têm. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />Khới maáng vé: "Hóa pính ôộng an ninh" xì sứ hủy diệt pẩt ngớ ập xuồng tlêng maáng, chôồng như cơn tâu teẻ của moón phú nử tang cò chửa, ôộng maáng chẳc chằn chăng thoảt àn. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />Mơi, thưa ái ới ùn, ái ới ùn chăng ở tloong poòng xồn tể rối ngáy rì xảy tềng cho ái ới ùn pẩt ngớ như moón lốm. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />Ví ái ới ùn tếu là con của ènh tlàng ôộng con của pan ngáy. Tán ha chăng xuộc vến pan têm hay poòng xồn. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />xí rêng, tán ha má tảy như cảc moón khảc, ngược lái, tán ha cấn kẻnh giảc ôộng tỉnh tào. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />Ví moón tảy là tảy pao pan têm, ôộng moón phay xì phay tloong pan têm. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />Mơi ví xuộc vến pan ngáy, rêng tán ta phải tỉnh tào, mặc ào giảp của đửc tin ôộng tính yêu xương, côống mù khảch — là hy voóng cừu rổi. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />Ví Thiên Chùa tà chăng lứa chón cho tán ha chíu cơn phẩn nố, mơi tể hưởng sứ cừu rổi pởi Chùa tán ha, là Chùa Cừu Thề Giê-xu, <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />Tầng tà chểt ví tán ha, tể tán ha ngay cả chể hay tảy, tán ha tếu côống khôồng ôộng Ngái. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />Pởi xí, hảy khuyền khỉch phố, moón ní hảy gây dứng moón kia, như ái ới ùn vẩn tang mấn.<verse eid="1TH 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />Thưa ái ới ùn, tán tôi cườn ái ới ùn hảy quỳ tlóng cảc moón chíu khò nhoọc khừa voóng ái ới ùn, dẩn tưa ái ới ùn tloong Chùa, khuyên pảo ái ới ùn, <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />ôộng hảy nghỉ tềng maáng mộch cảch tôn kình tloong tính yêu xương ví côông tảc của maáng. Hảy khôồng hoá thuấn côống phố. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />Thưa ái ới ùn, tán tôi thủc giục ái ới ùn: phải kẻnh cào moón chăng cò kỷ luật, phải an ủi moón nản loóng, phải nơng tở moón yều đuồi, phải kiên nhẩn côống tẩt cả cảc moón. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />Hảy cẩn thấn, má ôông ay lế ảc pào ảc cho ôông ay, ngược lái, hảy luôn xeo tuổi tiếu tổt lénh dánh cho phố ôộng cho tẩt cả cảc moón. <verse eid="1TH 5:15" /><verse number="16" style="v" sid="1TH 5:16" />Hảy luôn luôn phui mứng <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />Hảy cấu nguyến chăng xôi. <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />Tloong pẩt cừ tiếu chi, hảy tá ơn, ví tiếu rì là ỳ moành của Thiên Chùa dénh cho ái ới ùn tloong Chùa Cừu Thề Giê-xu. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />Má dập xẳt Thành Linh. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />Má khinh thướng cảc lới tiên tli. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />Hảy tla xẻt tẩt cả cảc việc. Hảy giử lế tiếu chi là thiến lénh. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />Hảy tlènh xa khỏi tẩt cả hính thửc gian ảc.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />Cấu cườn chình Thiên Chùa pính an thành hòa ái ới ùn hoán toán, ôộng nguyến tẩt cả tâm thấn, linh hốn, pỏc mếng của ái ới ùn àn gín giử cho chăng tược tlẻch àn khới Chùa tán ha, là Chùa Cừu Thề Giê-xu, ngứ tềng. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />Thánh tìn thay là Tầng rố hôổc ái ới ùn, yý là Tầng sẻ mấn việc rì.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />Thưa ái ới ùn, yý hảy cấu nguyến cho tán tôi nửa.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />Cườn poi thăm tẩt cả ái ới ùn pắng cày hôn thành. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />Tôi nhân danh Chùa truyến cho ái ới ùn phải tể cày thư ní àn toọc cho tẩt cả ái ới ùn.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />Nguyến cườn ân điển của Chùa tán ha, là Chùa Cừu Thề Giê-xu, ở côống ái ới ùn.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>