  <book code="1PE" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:03:31 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">1 Peter</para>
  <para style="toc1">Thư Phi-e-rơ thứ nhất</para>
  <para style="toc2">1 Phi-e-rơ</para>
  <para style="toc3">1Pe</para>
  <para style="mt">1 Phi-e-rơ</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Phi-e-rơ, sừ tố của Chùa Cừu Thề Giê-xu, cởi cho cảc moón àn chón khừa cảc moón lưu lạc phân tàn khồm tược ở tỉnh Bông, Ga-la-ti, Cáp-ba-đốc, A-si ôộng Bi-thi-ni, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />xeo sứ hay tlưởc của Thiên Chùa, là Cha, pởi sứ piệt riêng của Chùa Thành Linh cho sứ vâng phục ôộng sứ rảy mầu của Chùa Cừu Thề Giê-xu. Nguyến cườn ân điển ôộng sứ pính an àn xêm lêng nhiếu tlêng ái ới ùn.<verse eid="1PE 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Đàng ngới khen quà Thiên Chùa ôộng Cha của Chùa tán ha, là Chùa Cừu Thề Giê-xu, Tầng túy xeo loóng xương xỏt vỉ đái của Ngái, tà teẻ lái tán ha pao tloong niếm hy voóng khôồng pởi sứ phục sinh của Chùa Cừu Thề Giê-xu pở cày chểt. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />hường vến mộch cơ nghiệp chăng hư hoái, chăng ô uề ôộng chăng phai tán, tà àn gín giử tlêng tlới cho ái ới ùn, <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />là tể cho cảc moón pởi đửc tin, àn pảo vế pởi quyến năng Thiên Chùa cho sứ cừu rổi, là tiếu sẳn sáng àn páy tỏ xa tloong thới ký cuồi cúng. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />Pởi xí, ái ới ùn rẩt phui mứng, ngay cả caá ní cấn phải chíu puốn rấu ét lô tloong muôn kiểu thử thảch <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />tể cho sứ chừng tỏ của đức tin ái ới ùn — tiếu tà quỳ hơn váng là xừ hư raảch, mơi khới àn xử nghiếm pởi lửa — cò thể àn xảc nhấn tể tưa tềng sứ ngới khen, vinh hiển ôộng tôn tlóng tloong sứ hiến xa của Chùa Cừu Thề Giê-xu, <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />Tầng mà ái ới ùn yêu mền ngay cả chưa kỉa, caá ní tềng nổi chăng kỉa Ngái mơi ví tin tưởng ở Ngái, rêng ái ới ùn hân hoan côống niếm phui chăng tả nổi ôộng àn tlán tấy vinh hiển, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />nhấn lảnh kểt quả đửc tin của ái ới ùn, rì là sứ cừu rổi linh hốn. <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />Cảc nhá tiên tli tà xím hiểu ôộng tla xẻt kỷ cáng vến sứ cừu rổi ní, rì là cảc moón tà tiên pào vến ân điển tể cho ái ới ùn, <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />Khới xím hiểu vến moón nó hay khới nó mà Thành Linh của Chùa Cừu Thề tloong maáng tà páy tỏ, cho hay tlưởc vến sứ xương khò của Chùa Cừu Thề ôộng sứ vinh hiển khâu cảc việc rì. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />Tiếu tà àn páy tỏ cho maáng, rì là maáng xật xa chăng phục vuú cho chình mếng, mơi cho ái ới ùn, vến cảc tiếu mà caá ní tà àn côông pồ cho ái ới ùn qua cảc moón rao giảng Tin Lénh cho ái ới ùn pởi Chùa Thành Linh àn khai phài pở tlới — đồi côống cảc tiếu rì, cảc thiên sừ yý ưởc ao hẩu kỉa.<verse eid="1PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Pởi xí, pắng cảch chuẩn pí tâm tlì ái ới ùn chôồng như xẳt cố rôồng, giử tỉnh tào, hảy tệch cả hy voóng pao ân điển àn tom tềng cho ái ới ùn tloong sứ hiến xa của Chùa Cừu Thề Giê-xu. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />như con cài mẳt vâng lới, chăng mấn xeo cảc ham moành ngáy tlưởc của mếng tloong sứ ngu dổt của ái ới ùn. <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />ngược lái, chôồng như Tầng tà hôổc ái ới ùn là thành, chình ái ới ùn yý phải àn rêng thành tloong tẩt cả cảch ăn ở của mếng. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />Ví cò lới chẻp: “Cảc con sẻ rêng thành ví Ho là thành.” <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />Ôộng nều ái ới ùn hôổc Tầng phân xử cảch chăng thiên ví túy xeo côông việc của mổi moón là "Cha", xì hảy khôồng côống loóng kình rưởi tloong thới gian tha hương của mếng, <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />ví hay là chẳng phải pởi cảc xừ cò thể hư raảch như pạc hay váng mà ái ới ùn tà àn chuộc xa khỏi cảch khôồng vô nghỉa của mếng pởi tổ tiên truyến lái, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />mơi là pởi mầu quỳ già của Chùa Cừu Thề, chôồng như chiên con chăng tố vểt ôộng chăng ô uề, <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />tà àn đính tlưởc khới sàng thề, mơi àn tỏ xa tloong thới ký cuồi cúng ní ví pởi ái ới ùn, <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />là cảc moón pởi Ngái tin ở Thiên Chùa, Tầng tà mấn Ngái khôồng lái pở cày chểt ôộng pan vinh quang cho Ngái, tể đửc tin ôộng niếm hy voóng của ái ới ùn ở tloong Thiên Chùa. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />Khới tà thanh tẩy linh hốn mếng pởi sứ vâng phục chân lỳ hường tềng tính ái ùn chân thánh, ái ới ùn hảy yêu xương phố xật tha thiểt côống loóng thanh quang, <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />ví tà àn teẻ lái, chăng phải pở giôồng cò thể hư raảch, mơi pở giôồng chăng thể hư raảch, pởi lới khôồng ôộng vỉnh cửu của Thiên Chùa. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />Pởi ví:</para>
  <para style="q1" vid="1PE 1:24">“Tẩt cả cảc xảc xịt chôồng như cỏ,</para>
  <para style="q1" vid="1PE 1:24">ôộng tẩt cả cảc vinh quang của reé chôồng như hoa cỏ.</para>
  <para style="q1" vid="1PE 1:24">Cỏ khô, ôộng hoa rúng,<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />mơi lới Chùa cón tềng tới tới.”</para>
  <para style="q1" vid="1PE 1:25">Rì là Tin Lénh tà àn côông pồ cho ái ới ùn.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Xí rêng, khới tà lảc ti tẩt cả tiếu gian ảc, tẩt cả gian dồi ôộng đáo đửc giả, sứ gen khẻt côống tẩt cả sứ khề xầu, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />xì chôồng như tán rẻt mời teẻ, hảy xém khảt sửa xuộc linh tinh khiểt, tể pởi rì ái ới ùn cò thể mấn cho tăng tlưởng cho tềng cừu rổi, <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />nều ái ới ùn tà rềm mẳt là Chùa nhân lénh, <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />khới tềng khênh côống Ngái, là hón phú khôồng, tà pí maáng lảc xa, mơi lái là sứ lứa chón quỳ già tlưởc mẳt Thiên Chùa, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />ôộng chình ái ới ùn, chôồng như cảc hón phú tang khôồng, tang àn xây lêng thánh cày nhá xuộc linh, dénh cho chửc thấy tề lể thành tể dơng sinh tề xuộc linh phưa loóng Thiên Chùa qua Chùa Cừu Thề Giê-xu. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />Cho rêng, nối dung ní cò viểt tloong Kinh Thành:</para>
  <para style="q1" vid="1PE 2:6">“Hẩu rạ, Ho tệch ở Si-ôn mộch hón phú goỏc,</para>
  <para style="q1" vid="1PE 2:6">àn lứa chón, rẩt quỳ già.</para>
  <para style="q1" vid="1PE 2:6">Ôộng ay tin pao Ngái chẳc chằn chăng pí xầu hổ.”<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />Xí rêng vinh dứ tể cho ái ới ùn là cảc moón tà tin. Cón đồi côống cảc moón chăng tin:</para>
  <para style="q1" vid="1PE 2:7">“Hón phú mà pí cảc thớ xây lảc xa,</para>
  <para style="q1" vid="1PE 2:7">phú rì tà àn tlở rêng phú chuẩn goỏc nhá” –<verse eid="1PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 2:8" />ôộng là</para>
  <para style="q1" vid="1PE 2:8">“Hón phú mấn vẩp chó, tảng phú mấn cho pổ lở." Maáng pổ lở ví chăng vâng xeo lới Chùa, mà vến chuyến ní maáng yý tà àn đính khẳn rối. <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />Mơi ái ới ùn là doóng dỏi àn lứa chón, là chửc tề lể hoáng gia, là dân tộc thành, mộch dân xuộc quyến sở hửu của Thiên Chùa, tể ái ới ùn rao pào cảc việc lá lúng của Tầng tà hôổc ái ới ùn xa khỏi poòng xồn pao tloong ènh tlàng diếu ký của Ngài, <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />mà ái ới ùn tlưởc kia "chăng phải là mộch dân",</para>
  <para style="q1" vid="1PE 2:10">mơi nay là "dân cùa Thiên Chùa";</para>
  <para style="q1" vid="1PE 2:10">là cảc moón tứng "chăng àn xương xỏt",</para>
  <para style="q1" vid="1PE 2:10">mơi caá ní "tà àn xương xỏt".<verse eid="1PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />Ái ới ùn yều dầu, tôi nái khuyên ái ới ùn, như cảc kiếu dân ôộng khẻch tha hương, phải tlènh xa cảc ham moành xảc thịt, là xừ tlanh chiền nghịch côống linh hốn ái ới ùn, <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />khới giử gín cảch ăn ở của ái ới ùn cho phân miêng khừa voóng cảc moón ngoái quổc, tể rối, tloong tiếu chi maáng khề xầu vến ái ới ùn như cảc moón mấn ảc, xì pởi hẩu kỉa cảc việc lénh của ái ới ùn, maáng cò thể ngới khen Thiên Chùa tloong ngáy Ngái viềng thăm.<verse eid="1PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Pởi ví Chùa, hảy tuân xeo tẩt cả thẩm quyến con moón, cò thể rì là vua như moón cò quyến cao nhẩt, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />hay cảc quan thồng đổc, cảc moón àn vua khai phài tể tom tềng tlứng phạt moón mấn ảc ôộng khen thưởng moón mấn lénh. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />Ví ní là ỳ moành của Thiên Chùa: mấn việc lénh tể mấn cho tán moón ngu dổt ăn vé xiều tli thửc phải im ménh, <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />tloong tâm thề như cảc moón tứ do, ôộng chăng dúng sứ tứ do của mếng như mán chee cho việc ảc, mơi như cảc moón hấu của Thiên Chùa. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />Hảy tôn tloóng tẩt cả cảc moón. Hảy yêu xương ái ới ùn mếng. Phải kình rưởi Thiên Chùa. Phải tôn tloóng vua.<verse eid="1PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Hớ cảc ái ới ùn mấn gia nhân, phải vâng phục chủ mếng côống tẩt cả loóng kình tlóng, chăng phải chỉ moón chủ tổt ôộng hiến lénh, mơi cón moón chủ khò tình nửa. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />Ví nều ôông ay chíu đứng tâu khổ tloong khới tlải nghiếm sứ pẩt côông pởi ví lương tâm hường vến Thiên Chùa, xì rì là mộch ơn phưởc. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />Cò vẻ vang chi nều phám xối rối ái ới ùn phải chíu pí tành tập? Mơi nều mấn lénh rối ái ới ùn phải chíu đứng tlải qua khồn khò, xì rì là mộch ơn phưởc tlưởc mặt Thiên Chùa. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />Ví ái ới ùn tà àn hôổc cho tiếu rì, pởi Chùa Cừu Thề yý tà chíu khổ thay ái ới ùn, tể lái mộch gương cho ái ới ùn tể cho ái ới ùn có thể noi xeo pưởc chó Ngái,<verse eid="1PE 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="1PE 2:22" />“Tầng chăng phám xối,</para>
  <para style="q1" vid="1PE 2:22">yý chăng cò lới khề lẻo nó àn xím kỉa ở ménh Ngái”;<verse eid="1PE 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="1PE 2:23" />là Tầng khới pí vằng, Ngái chăng vằng lái; khới chíu khổ, Ngái chăng doá nạt, mơi Ngái phò mếng cho Tầng xẻt đoàn côông pính; <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />chình Tầng rì tà vang xối lổi tán ha tloong thân thể Ngái lêng câl gổ, tể khâu khới tà chểt đồi côống xối lổi, tán ha cò thể khôồng cho sứ côông chình, pởi cảc thương tỉch của Ngái mà ái ới ùn tà àn chửa lénh. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />Ví ái ới ùn tà như chiên lạc pí lạc, mơi nay ái ới ùn tà àn tlở vến côống Tầng chăn chiên ôộng Tầng Giàm Mục của linh hốn mếng.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Thưa cảc ới ùn là du, yý như xí, cấn vâng phục chầu mếng, tể ngay cả nều mầy moón chầu chăng vâng xeo đáo, mơi pởi cảch ăn ở của du ngay cả chăng pắng lới khề, xì cảc moón chầu rì sẻ àn chinh phục, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />khâu khới chừng kiền nểp khôồng tinh quang côống ôộng sứ cung kình của cảc ới ùn, <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />mơi tlang sửc của cảc ới ùn chăng phải ở khà vái puộc xẳc ôộng teo tố váng, hay ăn mặc quấn ào sang tlóng, <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />mơi là tầm loóng con moón khà tloong, côống vẻ oai mải mải của tinh thấn díu dáng ôộng im lắng, tiếu rì là quỳ già tlưởc mẳt Thiên Chùa. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />Ví cảc thành nử ngáy hơ, là cảc moón tệch hy voóng ở Thiên Chùa, yý tà tlang điểm mếng như xí khới vâng phục chầu mếng, <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />như Sa-ra tà vâng phục Áp-ra-ham khới hôổc ôông là chùa, cảc ới ùn àn tlở rêng xôn con của mú khới mấn lénh ôộng chăng rưởi pẩt ký nổi kinh hoáng nó.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Thưa cảc ái ùn là moón chầu, yý nhứ xí, pắng sứ tli thửc, cấn phải chung khôồng côống du như côống phài yều hơn, yý san sẻ sứ tôn tlóng như moón côống dứ phấn ân điển sứ khôồng, tể cho lới cấu nguyến của ái ùn chăng pí cản tlở.<verse eid="1PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />Khâu cúng, tẩt cả cấn cò côống tâm tlì, sứ cảm thông, tính ái ới ùn thân ài, loóng nhân tứ, sứ khiêm nhướng, <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />má lế ảc pào ảc, hay lới xủc phám tlả lới lái lới xủc phám, mơi ngược lái, cừ chủc lénh, ví ái ới ùn tà àn hôổc tềng tiếu rì, tể ái ới ùn àn hưởng phưởc lénh.<verse eid="1PE 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="1PE 3:10" />Ví,</para>
  <para style="q1" vid="1PE 3:10">“Ay moành yêu sứ khôồng ôộng kỉa ngáy khàng tổt lénh</para>
  <para style="q1" vid="1PE 3:10">phải ngăn cầm lài mếng khỏi tiếu ảc, ôộng vôi mếng khỏi vé tiếu gian lẻo.<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />Moón rì phải tlènh khỏi tiếu ảc mà mấn tiếu lénh.</para>
  <para style="q1" vid="1PE 3:11">Moón rì phải xím kiềm hóa pính ôộng xeo tuổi reé,<verse eid="1PE 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="1PE 3:12" />ví mẳt Chùa ở tlêng moón côông chình ôộng xai Ngái ở khênh lới cấu nguyến của maáng,</para>
  <para style="q1" vid="1PE 3:12">mơi mặt Chùa nghịch lái moón mấn ảc.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />Ay là moón sẻ hảm hái ái ới ùn nều ái ới ùn tlở rêng cảc moón nhiệt tính vến tiếu lénh? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />Mơi, ngay cả ái ới ùn tềng nổi phải chíu khổ ví sứ côông chình, xì ái ới ùn xật cò phưởc. Mặt khảc, má pí kinh hải xeo cày rưởi của maáng, yý má pí nao nùng, <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />mơi hảy tôn thành Chùa Cừu Thề, là Chùa tloong loóng mếng, luôn sẳn sáng cho việc tlả lới pẩt ký ôông ay poi ái ới ùn lỳ do cho niếm hy voóng tloong ái ới ùn, <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />mơi côống sứ hiến lénh ôộng tôn tlóng, ví cò mộch lương tâm tổt, tể tloong tiếu chi mà ái ới ùn pí vu cào, xì cảc moón sỉ nhục cảch khôồng thiến lénh của ái ới ùn tloong Chùa Cừu Thề phải xầu hổ. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />Ví nều là ỳ Thiên Chùa moành, xì thá chíu khổ mấn lénh, hơn là mấn ảc. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />Pởi ví Chùa Cừu Thề yý tà chíu khổ ví xối lổi — Tầng côông chình chểt thay moón pẩt chình — tể Ngái cò thể tom tán ha tềng côống Thiên Chùa, khới pí chểt vến phấn xảc mà àn mấn cho khôồng vến phấn tâm linh, <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />tloong tâm linh rì, Ngái yý tà táy pảo khới àn tềng côống linh hốn tloong ngục, <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />là tán moón ngáy tlưởc chăng vâng phục khới sứ kiên nhẩn của Thiên Chùa xật xa moong tới tloong tới Nô-ê, tang khới con tấu àn toòng, mơi tloong tấu rì, mấy moón — rì là xàm linh hốn — tà àn cừu qua rảc, <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />mà rì yý là hính poòng ngáy nay cừu rổi ái ới ùn, nghỉa là phẻp báp-têm — chăng phải việc lảc ti pun pẩn tlêng pỏc mếng, mơi là sứ cam kểt của mộch lương tâm tổt dénh cho Thiên Chùa — pởi sứ phục sinh của Chùa Cừu Thề Giê-xu, <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />là Tầng, khâu khới ti lêng tlới, tang ngứ táng chăm Thiên Chùa, mà cảc thiên sừ ôộng cảc tầng cò thẩm quyến côống cảc thề lực tếu vâng phục Ngái.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Xí xì, ví Chùa Cừu Thề tà chíu khổ tloong xảc xịt, rêng ái ới ùn yý hảy chíu tlang pí côống tư tưởng rì, pởi moón nó tà chíu khổ tloong xảc xịt xì tà cảch tểch côống xối lổi, <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />tể cả thới gian cón lái tloong xảc xịt, moón rì chăng cón khôồng cho ham moành thẩp hén của con moón nửa, mơi cho ỳ moành của Thiên Chùa. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />Ví thới gian tà ti qua quà tủ tể đạt àn ỳ moành của moón ngoái quổc, khới khôồng tloong sứ dâm đảng, mê ham, phay phưa, ham ăn mê oòng, ăn chơi hư hoỏng ôộng thớ láy hính tướng đàng kinh tởm, <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />mà tloong chuyến ní, maáng pí kinh ngạc khới ái ới ùn chăng chắn xeo maáng tloong côống doóng thảc lủ của sứ ăn chơi hư hoỏng, rêng puông lới xủc phám; <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />tán rì sẻ tưa lêng lới khai tlính tlưởc Tầng sẳn sáng phàn xẻt moón khôồng mân moón chểt. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />Pởi ví tiếu rì, Tin Lénh yý tà àn rao giảng cho cảc moón chểt rối, tể ngay cả maáng tà chíu đoàn xẻt xeo loái moón tloong xảc xịt, xì nay maáng vẩn cò thể khôồng xeo Thiên Chùa tloong tâm linh.<verse eid="1PE 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Mặt khảc, sứ cuồi cúng của muôn vật tà tềng khênh. Pởi xí, hảy tlàng suổt ôộng tỉnh tào tlính dơng cảc lới cấu nguyến; <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />khới tlêng hểt cò loóng yêu xương nhiệt thánh dénh cho phố, ví tính yêu xương sẻ che ti muôn ván xối lổi; <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />cò loóng mền khẻch côống phố mà chăng ét nó phán nán, <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />ôộng xeo như mổi moón tà nhấn ân từ, sử dúng reé phục vuú cho phố, khảc nó cảc moón quản lỳ giỏi đồi côống ân điển muôn mấu muôn vẻ của Thiên Chùa. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />Nều ay rao giảng — xì như là vé lới của Thiên Chùa; nều ay phục vuú — xì mấn như pắng khửc mà Thiên Chùa pan cho, tể tloong tẩt cả cảc việc Thiên Chùa àn tôn vinh qua Chùa Cừu Thề Giê-xu, là Tầng đàng àn vinh quang ôộng quyến năng cho tềng tới tới vỉnh cửu. A-men.<verse eid="1PE 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />Ái ới ùn yêu dầu, má pí hoang mang vến ló lửa phứng ở khừa ái ới ùn, khới xuẩt hiến ở ái ới ùn tể thử luyến, như là tiếu khảc lá xảy tềng cho mếng, <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />ngược lái, túy xeo ái ới ùn chia sẻ như xí nó pao cảc khổ nán của Chùa Cừu Thề, xì hảy phui mứng, tể cho tloong sứ páy tỏ vinh quang của Ngái, ái ới ùn àn hân hoan, ngập tlán phui sường. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />Nều ái ới ùn pí sỉ nhục ví danh Chùa Cừu Thề, xì cò phưởc quà, pởi Thành Linh của sứ vinh hiển ôộng của Thiên Chùa, ngứ tlêng ái ới ùn. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />Má ay tloong ái ới ùn chíu khổ như xên giểt moón, moón ăn lốm, moón mấn ảc, hay như moón xen pao chuyến moón khảc, <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />mơi nều chíu khổ ví là moón của Chùa Cừu Thề, xì moón rì má xầu hổ, mơi tloong danh hiếu rì hảy tôn vinh Thiên Chùa. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />Pởi ví tà tềng caá pẳt tấu sứ phàn xẻt pở nhá của Thiên Chùa; mà nều tlưởc tiên pở tán ha, xì sứ cuồi cúng của cảc moón chăng vâng phục Tin Lénh của Thiên Chùa sẻ xí nó?<verse eid="1PE 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="1PE 4:18" />Ôộng “Nều moón côông chình khò àn cừu,</para>
  <para style="q1" vid="1PE 4:18">xì moón chăng tin kình ôộng moón cò xối sẻ ở nó?”<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />Pởi xí, ôông ay chíu khổ xeo ỳ moành của Thiên Chùa hảy giao phò linh hốn mếng cho Tầng Sàng Táo thánh tìn tloong việc mấn lénh.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Pởi xí, tôi — yý là tlưởng lảo ôộng là nhân chừng vến cảc khổ nán của Chùa Cừu Thề, yý là moón chia sẻ vinh quang pú àn páy tỏ — nái khuyên cảc tlưởng lảo khừa voóng ái ới ùn: <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />Hảy chăn tảch tán chiên énh của Thiên Chùa ở khừa ái ùn, mấn côông việc chăn chiên — chăng mấn cảch ẻp puộc, mơi khẳn loóng tứ nguyến; túy xeo Thiên Chùa — yý chăng mấn côống tinh thấn ham moành của cải mơi mấn cảch nhiệt tính phui mứng; <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ôộng yý chăng mấn như thể là ôông chủ cai tlí cảc moón mà Thiên Chùa tà giao phò, thay pao rì, là tlở rêng gương tổt cho tán chiên énh. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />Rối khâu khới Tầng Chăn Chiên Chì Cao àn páy tỏ, ái ùn sẻ nhấn àn vương miến vinh quang chăng phai tán. <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />Chôồng như xí, cảc pán thanh niên ới, hảy vâng phục cảc tlưởng lảo. Tẩt cả phải mặc lế sứ khiêm nhướng đồi côống phố, ví Thiên Chùa chồng lái moón kiêu ngáo, mơi pan ân điển cho moón khiêm tồn. <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />Xí rêng, hảy há mếng xuồng tìn xay quyến năng của Thiên Chùa tể Ngái nơng ái ới ùn lêng tloong thới điểm thỉch hợp, <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />khới tà tlao hểt lo âu của mếng cho Ngái, ví Ngái chăm nom ái ới ùn. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />Hảy tỉnh tào, hảy kẻnh giảc. Moón thú nghịch của ái ới ùn, là ma quỷ, chôồng như sử tử rố lêng, tang ti quenh, xím ay rì tể cành roảch. <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />Hảy chồng lái reé, từng vửng tloong đửc tin, hay là ái ùn tloong đửc tin của mếng tlêng khồm thề giời tang chíu chung cảc khổ nán như xí. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />Mơi khới tà chíu khổ ét lô, Thiên Chùa của tẩt cả cảc ân điển, Tầng tà hôổc ái ới ùn tềng côống vinh quang muôn tới của Ngái tloong Chùa Cừu Thề, chình Ngái sẻ khôi phục, mấn cho vửng, mấn cho nôống lăng ôộng kiên cướng. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />Nguyến quyến cai tlí xuộc vến Ngái cho tềng muôn tới. A-men.<verse eid="1PE 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Pởi Sin-vanh, mộch moón ái ùn tlung tìn xeo cảch tôi xảc nhấn, tôi tà viểt cảch tòm tẳt cho ái ới ùn, khỉch lế ôộng chừng nhấn ní là ân điển chân xật của Thiên Chùa. Hảy từng vửng tloong ân điển rì. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />Hối thành ở Ba-by-lôn, hối àn chón như ái ới ùn, poi thăm ái ới ùn. Mác, con từa tôi, yý xí. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />Hảy cháo phố pắng cày hôn yêu xương. Nguyến cườn sứ pính an ở côống tẩt cả ái ới ùn là cảc moón tloong Chùa Cừu Thề.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>