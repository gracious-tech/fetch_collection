  <book code="EPH" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:04:52 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Ephesians</para>
  <para style="toc1">Thư Ê-phê-sô</para>
  <para style="toc2">Ê-phê-sô</para>
  <para style="toc3">Eph</para>
  <para style="mt">Ê-phê-sô</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Phao-lô, sừ tố của Chùa Cừu Thề Giê-xu pởi ỳ moành của Thiên Chùa, cởi cho cảc thành tố, là cảc moón tìn hửu ở tái Ê-phê-sô ôộng là cảc moón trung thánh tloong Chùa Cừu Thề Giê-xu. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Nguyến ân điển ôộng sứ pính an pở Thiên Chùa, Cha tán ha, ôộng Chùa, là Chùa Cừu Thề Giê-xu, tềng tlêng ái ới ùn.<verse eid="EPH 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Đàng khen ngới Thiên Chùa, Cha của Chùa Cừu Thề Giê-xu, Chùa tán ha, là Tầng tà xuồng phưởc cho tán ha côống tẩt cả phưởc lénh xuộc linh ở cảc tược tlêng tlới tloong Chùa Cừu Thề, <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />chôồng như Ngái tà chón tán ha tloong Chùa Cừu Thề pở tlưởc khới mấn rêng thề giời, tể tán ha àn thành khiểt ôộng chăng tược chê tlẻch tluởc mặt Ngái.</para>
  <para style="p" vid="EPH 1:4">Pởi loóng yêu xương, <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Ngái tà đính tlưởc tán ha cho đía ví con ruôi của Ngái qua Chùa Cừu Thề Giê-xu, xeo sứ tổt lénh của ỳ moành Ngái, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />tể kểt quả pắng sứ khen ngới vinh hiển của ân điển Ngái mà Ngái tà rôống rải pan tắng cho tán ha tloong Con Yêu Dầu của Ngái, <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />mà tloong Con rì, tán ha cò sứ cừu chuộc pởi mầu Ngái, việc tha xừ xối lổi xeo sứ chấu cò của ân điển Ngái, <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />là ân điển mà Ngái tà pan cho tán ha cảch dư dả tloong tẩt cả sứ khôn ngoan ôộng sàng suổt. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />mấn cho tán ha hay mẳt sứ pì ẩn của ỳ moành Ngái xeo tiếu phui loóng Ngái, là tiếu mà Ngái tà quyểt đính tlưởc tloong Chùa Cừu Thề, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />tể khới tềng thới gian hoán thánh chương trính tà ần đính, xì tập tlung muôn vật lái tloong Chùa Cừu Thề, cả cảc vật tlêng tlới ôộng cảc vật tìn tẩt, tloong Ngái, <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />nghỉa là tloong Tầng mà tán ha yý àn chia phấn sản nghiệp, ví tà àn đính trưởc xeo mục đỉch của Tầng mấn rêng tô việc xeo như chương trính của ỳ moành Ngái, <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />tể cho tán ha, cảc moón đấu tiên tệch hy voóng ở Chùa Cừu Thề, àn kểt quả pắng việc khen ngới vến vinh hiển của Ngái. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Yý tloong Ngái, khâu khới măng đáo của chân lỳ, là Tin Lénh vến sứ cừu rổi ái ới ùn, ôộng khới tà àn tin ở Ngái, xì ái ới ùn tà àn toòng dầu pắng Chùa Thành linh xeo lới hừa. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />mà Tầng rì là sứ pảo đảm vến cơ nghiệp của tán ha cho tềng khới chuộc mua tẩt cả sản nghiệp, tể kểt quả pắng việc khen ngới vến vinh hiển của Ngái.<verse eid="EPH 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Pởi xí, kể pở khới tôi măng vến đửc tin của ái ới ùn tloong Chùa, là Chùa Giê-xu, ôộng tính yêu xương đồi côống tẩt cả cảc thành tố, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />xì tôi chăng ngứng dơng lới cảm ơn ví ái ới ùn, căắn tềng ái ới ùn tloong lới cấu nguyến của mếng, <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />tể cho Thiên Chùa của Chùa Cừu Thề Giê-xu, Chùa tán ha, là Cha vinh hiển, sẻ pan cho ái ới ùn thấn linh của sứ khôn ngoan ôộng sứ mạc khải tloong việc hay mẳt Ngái, <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />tể con mẳt của loóng ái ới ùn àn chiều tlàng, tể ái ới ùn hay niếm hy voóng vến sứ hôổc của Ngái là chi, sứ chấu cò của cơ nghiệp vinh hiển Ngái tloong cảc thành tố xa xí nó, <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />ôộng sứ vỉ đái chăng cày chi so sành của quyến năng Ngái là xí nó đồi côống tán ha, là cảc moón cò loóng tin, xeo sứ tảc đống pởi khửc mánh năng quyến của Ngái, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />mà Ngái tà mấn tloong Chùa Cừu Thề khới mấn Chùa Cừu Thề pở cày chểt khôồng lái ôộng tệch ngối khà chăm Ngái ở cảc tược tlêng tlới, <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />vượt lêng tlêng tẩt cả uy quyến, thẩm quyến, năng quyến, ôộng chủ quyến, côống tẩt cả danh hiếu àn tệch xên, chăng chỉ tloong tới ní mà cả tloong tới khênh tềng nửa. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Ngái tà tệch muôn vật phục tìn choó Chùa Cừu Thề ôộng lập Chùa Cừu Thề mấn tlổc ở tlêng tô việc đồi côống hối thánh, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />mà hối Thành là poỏc mếng Ngái, là sứ tấy tủ của Tầng mấn tấy tủ tô việc tloong tô loái.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Vến phấn ái ới ùn, là enh chểt tloong cảc vi phám ôộng xối lổi mếng, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />là tloong cảc tiếu mà ngáy tlưởc ái ới ùn tà ăn ở xeo thòi quen của thề gian ní, xeo enh cai tlí côống thẩm quyến ở không tlung, là tá linh caá ní tang hánh đống tloong cảc con cài chăng vơng phục. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />mà ngáy tlưởc, ở khừa maáng, tẩt cả tán ha yý tà khôồng tloong cảc ham moành của xảc xịt mếng, mấn cảc ham moành của xảc xịt ôộng tâm trì. Xeo pản chẩt tứ nhiên, tán ha vồn là con cài của sứ phẩn nố yý như cảc moón khảc. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Mơi Thiên Chùa là Tầng chấu loóng xương xỏt, ví tính yêu rẩt náy của Ngái mà Ngái tà yêu tán ha, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />rêng khới tán ha là cảc moón chểt tloong cảc vi phám mếng, xì Ngái tà mấn tán ha àn khôồng tloong Chùa Cừu Thề – ní là pởi ân điển mà ái ới ùn tà àn cừu – <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Ngái mấn tán ha àn khôồng lái, ôộng tệch ngối côống Ngái ở cảc tược tlêng tlới tloong Chùa Cừu Thề Giê-xu, <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />tể tloong cảc thới đaái khênh tềng, Ngái cò thể páy tỏ xa sứ chấu cò vô biên của ơn phưởc Ngái qua sứ nhân tứ đồi côống tán ha tloong Chùa Cừu Thề Giê-xu. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Ví pởi ân điển, ái ới ùn àn cừu qua đửc tin; tiếu ní chăng tềng pở ái ới ùn, mơi là mòn quá của Thiên Chùa, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />chăng phải xa pở cảc việc mấn, tể chăng mộch ôông ay cò thể tứ háo. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Ví tán ha là tảc phẩm của Ngái, àn mấn rêng tloong Chùa Cừu Thề Giê-xu cho cảc việc lénh mà Thiên Chùa tà chuẩn pí tlưởc tể tán ha cò thể khôồng tloong cảc viêc rì.<verse eid="EPH 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Pởi xí, hảy căắn là tlưởc ní, ái ới ùn là moón ngoái quổc tloong xảc xịt, moón pí hôổc là "chưa chíu cảch pí" pởi moón àn hôổc là "tà àn cảch pí" tloong xảc xịt, nghi lể pởi xay con moón mấn. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Ví khới rì, ái ới ùn tà pí chia kẻch côống Chùa Cừu Thề, khới pí tể khà vái cống đống Y-sơ-ra-ên, ôộng là khẻch lá đồi côống cảc giao ưởc của lới hừa, rêng chăng cò hy voóng, yý chăng cò Thiên Chùa tloong thề gian ní. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Mơi, tloong Chùa Cừu Thề Giê-xu, ái ới ùn, cảc moón ngáy tlưởc tà tững kẻch giang, caá ní tà àn tom tềng khênh pởi mầu của Chùa Cừu Thề. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Ví chình Ngái là sứ hoá pính của tán ha, là Tầng tà mấn cho cả han tlở rêng mộch ôộng phà hủy háng ráo của sứ chia rẻ, là sứ thuú khẻt, tloong thân xảc Ngái, <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />khới tà lảc ti luật của cảc tiếu răn tloong cảc quy đính, tể cho Ngái cò thể mấn cho cả han tlở rêng mộch moón mời tloong Ngái, mấn rêng hoá pính, <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />ôộng tể Ngái cò thể hoá giải cả han côống Thiên Chùa tloong mộch poỏc mếng qua thập tứ già, khâu khới tiêu diệt tính tláng thuú khẻt tlêng rì. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Caá Ngái tà tềng, Ngái rao giảng sứ hoá pính cho ái ới ùn, là cảc moón ở giang, ôộng sứ hóa pính cho ôông ay ở khênh, <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />ví pởi Ngái, cả han cò quyến pưởc tềng khênh tloong mộch Thành Linh tể tềng côống Cha. <verse eid="EPH 2:18" /><verse number="19" style="v" sid="EPH 2:19" />Xí rêng, ái ới ùn chăng cón là khẻch lá hay moón ngoái quổc nửa. Thay pao rì, ái ới ùn là công dân côống cảc thành tố ôộng là thánh viên tloong gia đính của Thiên Chùa. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Vì tà àn xây dứng tlêng nến của cảc sừ tố ôộng cảc tiên tli, khới chình Chùa Cừu Thề Giê-xu là phú goỏc nhá, <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />mà tloong Ngái, cả cày nhá, àn kểt hợp côống phố, xì hính thánh rêng mộch tến thớ thành tloong Chùa, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />ôộng yý ở tloong Ngái, ái ới ùn àn xây dứng chung côống phố tlở rêng tược khôồng của Thiên Chùa tloong Thành Linh.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Pởi lỳ do rì, tôi, Phao-lô, là moón tú của Chùa Cừu Thề Giê-xu ví pởi ái ới ùn dân ngoái - <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />ví chẳc là ái ới ùn tà măng vến việc quản lỳ ân điển của Thiên Chùa, là tiếu tà àn giao cho tôi ví ái ới ùn, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />xeo sứ mặc khải tà àn páy tỏ cho tôi, nghỉa là sứ mấu nhiếm như tôi tà viểt cảch tòm tẳt ở tlêng. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Khới toọc tềng tiếu rì, ái ới ùn sẻ cò thể nhấn xa sứ am hiểu của tôi vến sứ mấu nhiếm của Chùa Cừu Thề, <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />là tiếu tà chăng àn páy tỏ cho con cài loái moón tloong cảc thề hế tlưởc, tloong khới hiến nay, pởi Thành Linh, tiếu rì tà àn páy tỏ cho cảc sừ tố thành của ngái côống cảc tiên tli - <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />rì là: cảc dân ngoái là moón côống àn thứa kề, là cảc pố phấn tloong côống mộch poỏc mếng, ôộng là cảc moón côống chia sẻ lới hừa tloong Chùa Cừu Thề Giê-xu qua Tin Lénh, <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />ví Tin Lénh rì mà tôi tà àn tlở rêng mộch moón hấu rứa tlêng mòn quá ân điển của Thiên Chùa, là tiếu tà àn pan cho tôi xeo sứ vấn hánh của quyến năng Ngái. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Ân điển rì tà àn pan cho tôi – moón énh nhẩt tloong tẩt cả cảc thành tố – tể rao giảng cho cảc dân ngoái sứ chấu cò chăng thể hiểu àn của Chùa Cừu Thề, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />ôộng tể mấn rỏ ráng cho tẩt cả cảc moón nó là việc quản lỳ sứ nhiếm mấu, là tiếu tà àn chù kìn tlải qua cảc thới đaái tloong Thiên Chùa, Tầng mấn xa muôn vật, <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />tể cho caá ní, qua Hối Thành, sứ khôn ngoan nhiếu mặt của Thiên Chùa cò thể àn páy tỏ cho cảc Tầng cai tlí ôộng cảc pậc thẩm quyến ở cảc tược tlêng tlới, <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />xeo mục đỉch tới tới mà Ngái tà hoán thánh tloong Chùa Cừu Thề Giê-xu, Chùa tán ha, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />mà tloong Tầng rì, tán ha cò loóng can đảm ôộng táng ti tềng khênh Thiên Chùa côống sứ tin cấy pởi đửc tin ở Ngái. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Xí rêng, tôi cườn ái ới ùn má nản loóng ví cảc hoán nán của tôi ví pởi ái ới ùn, mà cảc hoán nán rì là sứ vinh hiển của ái ới ùn.<verse eid="EPH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Pởi lỳ do rì, tôi quý cổ cồn tlưởc mặt Cha, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />là Tầng mà pở Ngái, tẩt cả doóng dỏi tlêng tlới ôộng tìn tẩt àn tệch xên, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />tể cườn Ngái, tuý xeo sứ chấu cò của vinh hiển Ngái, mấn ái ới ùn àn nôống khửc côống năng quyến qua Thành Linh của Ngái ở con moón táng tloong, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />tể Chùa Cừu Thề khôồng tloong loóng ái ới ùn pởi đửc tin, khới tà àn pèn rề ôộng vửng váng tloong tính yêu xương, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />tể cho ái ới ùn côống tẩt cả cảc thành tố, cò tủ khửc tể hiểu rỏ như xí nó là rôống, dán, cao, khu, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />ôộng tể nhấn xa tiếu vượt quà tli thửc chình là tính yêu của Chùa Cừu Thề, tể cho ái ới ùn àn tổ tấy pắng tẩt cả sứ viên mản của Thiên Chùa.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Cườn hường vến Tầng cò thể mấn vượt quà tẩt cả tiếu mà tán ha cườn hay suy nghỉ, xeo quyến năng tang hoạt đống tloong tán ha, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Nguyến Ngái àn vinh hiển tloong Hối Thành ôộng tloong Chùa Cừu Thề Giê-xu tlải qua tẩt cả thề hế tới tới vỉnh cửu. A-men.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Xí rêng, tôi, moón tú tloong Chùa, khuyền khỉch ái ới ùn phải khôồng cảch xừng đàng côống lới hôổc mà ái ới un tà àn hôổc tềng, <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />pắng tẩt cả sứ khiêm tồn ôộng hiến hoá, côống loóng kiên nhẩn, chíu tứng lẩn phố tloong tính yêu xương, <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />phải cồ gằng hểt khửc tể giử sứ hiệp mộch của Thành Linh tloong mồi liên kểt hóa pính. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Chỉ mộch thân thể ôộng mộch Thành Linh, yý như ái ùn tà àn hôổc tềng mộch niếm hy voóng tloong sứ hôổc của mếng, <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />chỉ mộch Chùa, mộch đửc tin, mộch phẻp báp-têm, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />chỉ mộch Thiên Chùa, Cha của tẩt cả moón, Tầng ở tlêng hểt tẩt cả moón, qua tẩt cả moón ôộng tloong tẩt cả moón. <verse eid="EPH 4:6" /><verse number="7" style="v" sid="EPH 4:7" />Mơi, ân điển tà àn pan cho mổi moón tán ha tuý xeo mửc đố tloong việc pan cho của Chùa Cừu Thề. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Xí rêng, cò lới viểt:</para>
  <para style="q1" vid="EPH 4:8">“Khới Ngái ngứ lêng cảc tược cao,</para>
  <para style="q1" vid="EPH 4:8">Ngái ti tlưởc dẩn xeo cảc moón tú,</para>
  <para style="q1" vid="EPH 4:8">ôộng pan cảc ơn cho loái moón.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Xí mơi, "Ngái ngứ lêng" nghỉa là cày chi nều chăng phải là Ngái yý tà xuồng tềng cảc tược khà tìn của tẩt? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Chình Tầng tà xuồng yý là Tầng tà ngứ lêng cao hơn tẩt cả cảc tấng tlới, tể Ngái cò thể mấn tấy dẩy muôn vật. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Chình Ngái tà tệch mộch xồ mấn sừ tố, mộch xồ mấn tiên tli, mộch xồ mấn nhá rao giảng Tin Lénh, mộch xồ mấn mục sư ôộng thấy giào, <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />tể tom tềng việc chuẩn pí cảc thành tố cho côông việc phục vuú, hường tềng việc xây dứng poỏc mếng của Chùa Cừu Thề, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />cho tềng khới tẩt cả tán ha đạt tềng sứ hiệp mộch tloong đửc tin ôộng việc hay mẳt Con Thiên Chùa, tlở rêng moón tlưởng thánh, đạt tềng vỏc dàng tlón vén của Chùa Cừu Thề, <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />tể tán ha chăng cón là con rẻt, pí xui dục ôộng lôi cuồn xeo cảc hường xò giào lỳ pởi thủ đoán của maáng tloong tình mưu méo côống việc gian dồi, xảo quyệt. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Thay pao rì, khới vé xa chân lỳ tloong tính yêu xương, tán ha cò thể tăng tlưởng tẩt cả phương diến hường tềng Ngái, Tầng là tlổc, nghỉa là Chùa Cừu Thề, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />pở tược Ngái mà cả poỏc mếng àn hiệp lái ôộng liên kểt côống phố pởi cảc sứ kểt nồi giủp đở, xeo như mửc đố hoạt đống tloong mổi mộch pố phấn, mấn cho poỏc mếng tăng tlưởng tể tứ xây dứng tloong tính yêu xương.<verse eid="EPH 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Pởi xí, tôi vé tiếu ní ôộng thủc giục ái ới ùn tloong Chùa tể chăng cón ăn ở chôồng như dân ngoái nửa, maáng khôồng tloong sứ hư ảo của ỳ tưởng mếng, <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Ví tâm tlì maáng tà pí mấn cho xồn xăm, tlở rêng xa lá côống sứ khôồng của Thiên Chùa pởi sứ ngu dổt ở tloong maáng, pởi loóng maáng cừng cỏi. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />tlở rêng vô cảm pẩt cấn, rêng maáng lảc mếng pao dâm dục, tể phám tẩt cả tiếu ô uề côống loóng xam lam. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Mơi ái ới ùn tà chăng hoọc mẳt Chùa Cừu Thề như xí, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />nều xật sứ ái ới ùn tà măng vến Ngái ôộng tà àn táy pảo tloong Ngái, xeo như chân lỳ ở tloong Chùa Giê-xu. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />là phải lảc khỏi ái ới ùn, cảc cày chi xuộc vến kẻch khôồng tlưởc ní, nghĩa là con moón cù pí hư hoái ví ham moành gian dồi, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />ôộng àn mấn rêng mời pởi thấn linh tloong tâm trì mếng, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />ôộng mặc pao con moón mời, là moón àn tứng rêng xeo Thiên Chùa – tloong sứ côông chình ôộng thành khiểt của chân lỳ.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Xí rêng, khới tà lảc sứ giả dồi, mổi moón phải vé tiếu chân xật côống moón khênh mếng, ví pởi tán ha là chi thể của phố. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Ái ới ùn àn tửc giấn mà chăng phám xối. Hảy tể mặt tlới chăng lắn tlêng cơn giấn của ái ới ùn, <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />yý má cho ma quỷ cơ hối. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Moón ăn lốm má ăn lốm nửa. Mơi tổt hơn, moón rì phải cồ gằng mấn việc tổt lénh pắng chình tôi xay mếng, tể cho moón rì cò tể chia sẻ côống moón nó tang ở tloong hoán cảnh xiều xồn. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Má tể lới khề dơ pẩn nó vé xa pở ménh ái ới ùn, mà hảy vé cảc lới nó tổt lénh hường tềng việc xây dứng moón nó tloong cảnh khò khăn, tể lới rì cò thể tom ơn lénh cho moón măng, <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Yý má mấn puốn Chùa Thành Linh của Thiên Chùa, pởi Ngái mà ái ới ùn àn toòng ần cho ngáy cừu chuộc. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Hảy lảc khỏi ái ới ùn tẩt cả căn tằng, phẩn nố, giấn dử, cải vả, xủc phám, côống tẩt cả tiếu gian ảc. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Thay pao rì, hảy páy tỏ cho phố loóng nhân tứ, xương xỏt, tha thừ cho phố yý như Thiên Chùa tà tha thừ ái ới ùn tloong Chùa Cừu Thề.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Xí rêng, hảy tlở rêng cảc moón pẳt tlưởc Thiên Chùa, như con cài rẩt àn yêu quỳ của Ngái, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />ôộng hảy khôồng tloong tính yêu xương, yý như Chùa Cừu Thề tà yêu tán ha ôộng hy sinh chình Ngái ví tán ha như mộch lể vật ôộng con vật hiền tề côống hương hơm ngáo ngảt dơng lêng Thiên Chùa.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Cón việc gian dâm, côống tẩt cả tiếu ô uề hay xam lam xì yý chăng àn vé tềng khừa voóng ái ới ùn, như tiếu rì là phú hợp côống cảc thành tố, <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />yý má vé lới tục tỉu, lới nhảm nhì, hay đúa cợt thô lổ - là cảc xừ chăng phú hợp - mà thay pao rì, hảy dâng lới cảm tá. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Xật xí, hảy mẳt tiếu ní cho chẳc chằn là tẩt cả moón gian dâm, ô uề, hay xam lam - nghỉa là moón thớ hính tướng - tếu chăng cò cơ nghiệp tloong vương quổc của Chùa Cừu Thề ôộng Thiên Chùa. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Má tể ôông ay lứa gạt ái ới ùn pắng cảc lới khề vô nghỉa, ví pởi cảc tiếu rì, cơn phẩn nố của Thiên Chùa tổ xuồng tlêng cảc con cài chăng vơng phục. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Cho rêng, ái ới ùn má tlở rêng cảc moón tham gia côống maáng, <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />ví tlưởc rì ái ới ùn cón xồn xăm, mơi nay là ènh tlàng tloong Chùa. Hảy ăn ở như con cài của ènh tlàng <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(ví pôông tlày của sứ tlàng ở khừa tẩt cả cảc tiếu tổt lénh, côông chình, ôộng chân xật), <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />khới cẩn thấn xem xẻt nó là tiếu phưa loóng Chùa. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Má tham gia pao cảc việc vô ỉch của sứ xồn xăm, mơi hảy lêng àn phệ xì hơn. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />ví xật là xầu hổ khới chỉ vé tềng cảc việc maáng mấn cảch chù kìn. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Mơi tẩt cả cảc vật àn kỉa rỏ khới àn páy tỏ pởi ènh tlàng, ví tẩt cả cảc vật àn kỉa rỏ tếu là ènh tlàng. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Pởi xí, cò lới phàn:</para>
  <para style="q1" vid="EPH 5:14">“Hảy tỉnh dấn, hớ moón tang tảy,</para>
  <para style="q1" vid="EPH 5:14">hảy từng dấn pở tloong tán moón chểt,</para>
  <para style="q1" vid="EPH 5:14">Chùa Cừu Thề sẻ chiều tlàng dâu.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Xí rêng, hảy chù ỳ cẩn thấn cảch ái ới ùn tang ăn ở - má như moón ngu dổt, mơi như moón khôn ngoan, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />hảy tấn dúng thới gian, ví cảc ngáy là xầu. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Pởi xí, má tlở rêng enh ngu dổt, mơi phải hiểu nó là ỳ moành của Chùa. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Má phay ráo, pởi tiếu rì là puông tuống. Mơi, hảy tấy dẩy côống Thành Linh, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />duyên chuyến côống phố pắng thi thiên, thành ca ôộng pái hảt thiêng liêng,côống tầm loóng mếng hảt xường ôộng chủc túng Chùa, <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />dơng lới tá ơn Thiên Chùa, là Cha tloong tô caá vến tô tiếu nhân danh Chùa Cừu Thề Giê-xu, Chùa tán ha, <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />hảy vơng phục phố tloong sứ kình rưởi Chùa Cừu Thề;<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />moón mấn du phải vơng phục chầu mếng như vơng phục Chùa. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Ví chầu là tlổc du, yý như Chùa Cừu Thề là tlổc Hối Thành - Chình Ngái là Cừu Chùa của poỏc mếng. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Mơi, hối thành vơng phục Chùa Cừu Thề xí nó xì du yý phải vơng phục chầu mếng tloong tẩt cả cảc việc xí rì. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Moón mấn chầu, hảy yêu du mếng, yý như Chùa Cừu Thề tà yêu hối thành ôộng hy sinh chình mếng ví hối thành, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />tể Ngái cò thể thành hòa hối rị, khâu khới mấn cho quang pắng việc xửa của rảc côống lới Chùa, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />tể cho Ngái tom tlính diến cho chình mếng mộch hối thành vinh hiển, chăng cò tồ pẩn hay rểp nhăn, hay pẩt ký tiếu nó như xí, mơi tể hối àn thành khiểt ôộng chăng tược chê àn. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Xeo cảch như xí xì chầu yý phải yêu du mếng như chình thân mếng. Moón chầu yêu du của mếng là yêu chình mếng. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Ví chăng ôông ay khẻt pản thân mếng caá nó, mơi ruôi dưởng ôộng chăm nom reé, yý như cảch Chùa Cừu Thề đồi côống hối thành, <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />ví tán ha là cảc pố phấn của poỏc mếng Ngái. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Pởi lỳ do rị, moón tán ôông sẻ ti khỏi pồ mế ôộng sẻ àn kểt hợp côống du mếng, cả han sẻ tlở rêng mộch xịt.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Tiếu mấu nhiếm ní xật to náy - mơi tôi tang vé vến Chùa Cừu Thề ôộng vến hối thành. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Xí mơi, ái ới ùn - yý xeo cảch rì - mổi moón mộch - mổi moón chầu phải yêu du mếng như chình mếng, cón moón du rì là cẫn kình tlóng chầu mếng.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Moón mấn con, hảy vơng lới pồ mế của cảc con tloong Chùa, ví ní là tiếu tùng. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />"Hảy hiều kình pồ mế con" (ní là tiếu răn tấu tiên kém xeo lới hừa), <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />"tể phưởc lénh tềng côống con ôộng con cò thể àn khôồng lô tlêng tẩt." <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />Moón mấn pồ, má choọc tửc con cài mếng. Thay pao rì, hảy ruôi dưởng phệ tloong kỉ luật ôộng sứ táy pảo của Chùa.<verse eid="EPH 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Moón mấn nô lế, hảy vơng phục moón chủ xeo phấn xảc côống sứ kình nể ôộng run rưởi ở loóng chân thánh của mếng, chôồng như đồi côống Chùa Cừu Thề, <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />chăng phải côống kiểu phục vuú khới chủ giàm sảt như tán moón moành lế loóng, mơi như môn tố của Chùa Cừu Thề, mấn xeo ỳ moành của Thiên Chùa pắng cả tâm hốn, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />phục vuú côống loóng nhiệt tính, như phục vuú cho Chùa mà chăng phải cho maáng, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />ví hay là mổi moón, dú nô lế hay tứ do, nều mấn việc lénh nó, xì moón rì sẻ nhấn tiếu tương ừng ở tược Chùa.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Ôộng moón mấn chủ, phải đồi xử côống kẻch rì ôộng cảc moón hấu. Hảy xôi việc dóa nạt, ví hay là Moón Chủ phưa của maáng phưa của ái ùn tang ở tlêng tlới, ôộng chăng cò việc thiên ví tloong Ngái.<verse eid="EPH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Cuồi cúng, hảy àn mấn cho vửng váng tloong chùa, ôộng tloong khửc mánh năng quyến của Ngái. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Hảy mặc pao tẩt cả pố pinh giảp của Thiên Chùa, tể mấn cho ái ới ùn cò thể từng vửng, chồng lái cảc âm mưu xảo quyệt của ma quỷ. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Ví cuộc chiền đầu của tán ha chăng phải là chồng lái côống mầu ôộng xảc xịt, mơi là chồng lái cảc quyến thôồng tlí, chồng lái cảc quyến lực, chồng lái cảc linh cai quản thề gian xồn xăm ní, chồng lái cảc linh gian ảc ở cảc tược tlêng tlới. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Pởi xí rì, hảy mặc pao tẩt cả pinh khì của Thiên Chùa, tể ái ới ùn cò thể chôồng nổi tloong ngáy tai hóa, ôộng từng vửng váng khâu khới hoán thánh tẩt cả cảc việc. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Xí rêng, hảy từng vửng, xẳt khái cố rôồng của ái ới ùn pắng chân lỳ, mặc lế ào giảp của sứ côông chình, <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />vang pao choó sứ sẳn sáng của Tin lénh pính an. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />nơng cao cày khiên của đửc tin tloong tẩt cả tlướng hợp, pởi rì mà ái ới ùn sẻ cò thể dập xẳt tẩt cả xên lửa của ma quỷ. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Hảy nhấn lế cày mủ giàp cừu rổi ôộng gươm Thành Linh, mà rì là lới của Thiên Chùa, <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />khới cấu nguyến tô caá tloong Thành Linh thông qua tẩt cả lới cấu khẩn ôộng nái cườn, ôộng hường tềng kểt quả tloong khới tỉnh tào pắng tẩt cả sứ kiên tlí ôộng sứ cấu thay cho tẩt cả cảc thành tố, <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />ôộng dánh cho tôi, tể thôông điệp cò thể àn pan cho tôi, tloong việc vở ménh của tôi côống sứ can đảm tể rao giảng sứ nhiếm mấu của Tin Lénh <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />(ví Tin Lénh rì mà tôi tlở rêng sừ giả khừa voóng xiếng xỉch), tể cho tloong hoán cảnh rì, tôi cò thể mánh dán rao giảng xeo như pổn phấn tôi phải vé.<verse eid="EPH 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Mơi tể ái ới ùn yý cò thể hay cảc chuyến liên quan tềng tôi, tôi tang mấn chi, xì Ty-chi-cơ, moón ái ùn yêu quỳ ôộng moón hấu chung thánh tloong Chùa, sẻ cho ái ới ùn hay tẩt cả cảc chuyến. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ái rì là moón mà tôi tà khai tềng côống ái ới ùn ví mục đỉch ní, tể ái ới ùn cò thể hay tính hính của tán tôi ôộng loóng ái ới ùn àn khỉch lế.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Nguyến sứ pính an pan cho ái ới ùn, côống tính yêu xương ôộng đửc tin pở thiên Chùa là Cha, ôộng Chùa, là Chùa Cừu Thề Giê-xu. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Nguyến ân điển ở côống tẩt cả cảc moón yêu quỳ Chùa Cừu Thề Giê-xu, Chùa tán ha, pắng tính yêu vỉnh cửu.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>