  <book code="MRK" style="id">EN_MGLT mtq_Muong_ltr Tue Apr 23 2024 11:06:20 GMT+0700 (Indochina Time) tc</book>
  <para style="usfm">3.0</para>
  <para style="ide">UTF-8</para>
  <para style="h">Mark</para>
  <para style="toc1">Phúc Âm Mác</para>
  <para style="toc2">Mác</para>
  <para style="toc3">Mrk</para>
  <para style="mt">Mác</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Khởi tấu Tin Lénh của Chùa Cừu Thề Giê-xu, Con Thiên Chùa.<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />Như tà àn viểt tloong sảch tiên tli Ê-sai:</para>
  <para style="q" vid="MRK 1:2">"Hảy hẩu ní, Ho khai sừ giả của Ho ti tlưởc mặt Con,</para>
  <para style="q" vid="MRK 1:2">nọ sẻ rón khà của Con.<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />Mộch xiềng rố náy tloong hoang mạc:</para>
  <para style="q" vid="MRK 1:3">Hảy dón khẳn cày khà của Chùa</para>
  <para style="q" vid="MRK 1:3">mấn cho thẳng cảc khà của Ngái.'"<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Giăng tà tềng, mấn báp-têm tloong hoang mạc ôộng rao giảng phẻp báp-têm của sứ ăn năn tể àn tha xối. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Khồm púng Giu-đê ôộng cảc moón ở Giê-ru-sa-lem kèo tềng côống ôông ôộng maáng àn ôông mấn báp-têm tìn khôông Giô-đanh khới xưng nhấn xối lổi mếng. <verse eid="MRK 1:5" /><verse number="6" style="v" sid="MRK 1:6" />Giăng xì mặc ào pắng lôông lạc đaã ôộng xẳt khái ta quenh eo mếng, ôộng ăn chồ chồ côống mật oong rứng.<verse eid="MRK 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 1:7" />Ôông rao giảng xí ní: “Tầng cò quyến phẻp hơn tôi tang tềng khâu tôi, là Tầng mà tôi chăng xừng đàng cùi xuồng tể vở khái giáy của Ngái. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Tôi mấn báp-têm cho ái ới ùn pắng rảc, mơi Ngái sẻ mấn báp-têm cho ái ới ùn pắng Chùa Thành Linh."<verse eid="MRK 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Việc xảy xa tloong cảc ngáy rì, rì là Chùa Giê-xu tà tềng pở Na-xa-rét xuộc púng Ga-li-lê, ôộng Ngái àn Giăng mấn báp-têm tìn khôông Giô-đanh. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Ôộng ngay lập tửc, khới lêng khỏi rảc, Ngái kỉa cảc tấng tlới àn vở xa ôộng Thành Linh ngứ xuồng tlêng Ngái chôồng chim cú cu. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Ôộng mộch xiềng phàn tềng pở tlới: “Con là Con yêu dầu của Ho. Ho rẩt phưa loóng vến Con.”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Ngay caá rì, Thành Linh thủc giục Ngái ti pao hoang mạc. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Ngái ở tloong hoang mạc pồn mươi ngáy, chíu Sa-tan càm dổ. Ngái ở côống moong rứng, ôộng cảc thiên sừ hấu việc Ngái.<verse eid="MRK 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Khâu khới Giăng pí pẳt, Chùa Giê-xu ti tềng Ga-li-lê côông pồ Tin Lénh của Thiên Chùa, <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />ôộng vé xí ní: "Thới điểm tà tlón, ôộng vương quổc của Thiên Chùa tà tềng khênh. Hảy ăn năn ôộng tin ở Tin Lénh."<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Khới ti roong xeo nâấm piển Ga-li-lê, Ngái kỉa Si-môn ôộng Anh-rê, ùn của Si-môn, tang giăng lài tlêng piển, ví maáng mấn nghế tènh cà. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Chùa Giê-xu vé côống maáng: “Hảy ti xeo thấy rạ, rối thấy sẻ mấn ái ùn tlở rêng xay tènh lài moón.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ngay caá rì, khới tà lảc lài lái, maáng ti xeo Ngái. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Khới ti xêm mộch ét nửa, Ngái kỉa Gia-cơ, con từa Xê-bê-đê, ôộng Giăng, ùn của ôông, maáng tang pà lài tlêng thuyến. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Ngay caá rì, khâu khới Ngái hôổc maáng, xì maáng lêng khà xeo Ngái, tể pồ mếng là Xê-bê-đê ở lái tlêng thuyến côống ôộng mầy moón mấn xê.<verse eid="MRK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Ngái pao tloong thánh Ca-bê-na-um, ôộng ngay caá rì, tloong ngáy Sa-bát, khới tà ti pao nhá hối, ngái pẳt tấu giảng táy. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Máng sửng sổt vến lới táy của Ngái, ví Ngái tà táy pảo maáng như cò thẩm quyến mà chăng như cảc thấy táy luật. <verse eid="MRK 1:22" /><verse number="23" style="v" sid="MRK 1:23" />Ngay lập tửc, mộch moón pí linh ô uề ềm tà tang ở tloong nhá hối của maáng, ái ha rố lêng, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />xí ní: “Hớ Giê-xu Na-xa-rét, tán tôi liên quan chi tềng Ngái? Phải chăng Ngái tềng tể hủy diệt tán tôi? Tôi mẳt Ngái là ôông ay – Tầng Thành của Thiên Chùa!” <verse eid="MRK 1:24" /><verse number="25" style="v" sid="MRK 1:25" />Chùa Giê-xu quở tlẻch reé, xí ní: “Hảy im ti ôộng xa khỏi moón ní!” <verse eid="MRK 1:25" /><verse number="26" style="v" sid="MRK 1:26" />Rối khâu khới linh ô uề vật pổ ái ha xuồng, ôộng rố náy xiềng, xì reé xa khỏi ái ní. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Tẩt cả cảc moón sửng sổt, tềng nổi pán luấn côống phố, xí ní: “chuyến ní là xí nó? Mộch giào huần mời xeo thẩm quyến! Tềng nổi ôông rì xa lếnh cho linh ô uề ôộng tán reé măng lới ôông ha. <verse eid="MRK 1:27" /><verse number="28" style="v" sid="MRK 1:28" />Rối tin tửc vến Ngái lập tửc lan truyến khồm tược tềng tẩt cả púng xung quenh Ga-li-lê.<verse eid="MRK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Ngay lập tửc, khới ti khỏi nhá hối, maáng pao tloong nhá Si-môn ôộng Anh-rê, côống Gia-cơ ôộng Giăng. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Caá rì, mế du của Si-môn tang pí sổt tảy tlêng chớng, ôộng maáng liến vé côống Ngái vến mú. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Caá tềng khênh, cấm lế xay mú, Ngái tở mú dấn, ôộng cơn sổt xa khỏi mú, rối mú pẳt tấu phục vuú maáng.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Xí rối, tềng khuống xồn, khâu khới mặt tlới tà lắn, maáng tom tềng cho Ngái tẩt cả cảc moón vẳc pếng ôộng cảc moón pí quỷ ềm. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Cả thánh tà tập tlung ở ngay cửa. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Ngái chửa lénh nhiếu moón pí tâu yều côống tủ xừ pếng tật, ôộng tuổi nhiếu quỷ, mơi Ngái chăng cho phẻp cảc quỷ lêng xiềng ví tán reé mẳt Ngái.<verse eid="MRK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Pao puổi tlàng khờm, caá tlới cón rẩt xồn, khâu khới tỉnh dấn, Ngái xa vái, ti tềng mộch tược vằng vẻ, ôộng ở tược rì, Ngái cấu nguyến. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Si-môn ôộng cảc moón ở côống Ngái ti xím Ngái. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />ôộng maáng xím àn Ngái, xì vé côống Ngái xí ní: "Tẩt cả cảc moón tang xím thấy." <verse eid="MRK 1:37" /><verse number="38" style="v" sid="MRK 1:38" />Ngái pảo maáng: “Tán ha hảy ti tược khảc, tloong cảc thí trần chung quenh, tể thấy yý giảng táy ở rì nửa, ví thấy tà tềng là pởi việc ní." <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Ngái ti tềng khồm cả púng Ga-li-lê, rao giảng tloong cảc nhá hối của dân chùng ôộng tuổi quỷ.<verse eid="MRK 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Caá ní, mộch moón vẳc pếnh phong hủi tềng tốn Ngái, nái cườn Ngái ôộng quý xuồng, vé côống Ngái, xí ní: “Nều thấy moành, thấy cò thể mấn tôi àn quang." <verse eid="MRK 1:40" /><verse number="41" style="v" sid="MRK 1:41" />Ôộng ví tôống loóng xương xỏt, khới tưa xay mếng xa, Ngái chám pao ái, ôộng vé côống ái: "Ho moành. Hảy quang ti." <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ngay pập tửc phong hủi piền khỏi ái ôộng ái àn quang. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Khâu khới nghiêm gioóng cảnh cào ái, Ngái liến cho ái ha ti. <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />Ngái pảo ái ha: "Hảy cẩn thấn, ái má rêng vé chi côống pẩt cừ ôông ay, mơi hảy ti, tlính diến mếng côống thấy tề lể ôộng hảy dơng cảc của lể ví việc àn quang của mếng, là việc mà Môi-se tà truyến táy, như mộch lới chừng cho maáng." <verse eid="MRK 1:44" /><verse number="45" style="v" sid="MRK 1:45" />Mơi, khâu khới ti khỏi, ái ha pẳt tấu côông pồ cho nhiếu moón ôộng loan truyến tin ní khồm tược, tềng nổi Ngái chăng thể pao tloong mộch thí trần nó cảch côông khai àn nửa, mơi Ngái ở khà vái ở cảc tược vằng vẻ, ôộng dân chùng pở khồm tược vẩn tang tềng côống ngái.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Khới tlở pao lái tloong thánh Ca-bê-na-um khâu mầy ngáy, dân chùng măng àn là Ngái tang ở tloong nhá. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ôộng nhiếu moón tà tập tlung tềng nổi chăng cón tược nửa, ngay cả ở cửa xa pao yý chăng, cón Ngái táy đáo cho maáng. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Mầy moón tềng côống Ngái, tom xeo mộch moón pái liệt, àn rướng pởi pồn moón. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Ví chăng thể tềng khênh Ngái pởi đàm tôông, maáng dở mài nhá ngay tược Ngái ở, ôộng khâu khới mấn xa lồ tlủng, maáng tưa xuồng cày chớng cò moón pái liệt tang tảy. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Khới tà kỉa đửc tin của maáng, Chùa Giê-xu vé côống moón pái: "Hớ con, xối lổi con tà àn tha!" <verse eid="MRK 2:5" /><verse number="6" style="v" sid="MRK 2:6" />Mơi mầy thấy táy luật tang ngối ở rì lỳ luấn tloong loóng maáng: <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />"Xí nó moón ní lái vé như xí? Ôông ha xật phám thướng! Ôông ay cò quyến tha xối tlứ xa mộch mếng Thiên Chùa?" <verse eid="MRK 2:7" /><verse number="8" style="v" sid="MRK 2:8" />Ngay lập tửc, ví Chùa Giê-xu tà mẳt tloong tâm thấn mếng là maáng tang tứ nghỉ thấm như xí, Ngái vé côống maáng: "Xí nó cảc ôông lái nghỉ cảc tiếu rì tloong loóng? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Tiếu nó là lời hơn tể vé côống moón pái, ‘Xối lổi ái tà àn tha!’ hay vé ‘Hảy từng dấn, ôm chớng ái lêng ôộng pưởc ti!’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Mơi tể cảc ôông mẳt là Con Moón tlêng tẩt ní cò thẩm quyến tha xối", Ngái vé côống moón pái: <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />"Tôi pảo ái hảy từng dấn, ôm chớng của mếng lêng, ôộng ti vến nhá mếng." <verse eid="MRK 2:11" /><verse number="12" style="v" sid="MRK 2:12" />Xí là khâu khới từng dấn xì lập tửc ôm chớng lêng, ái ha ti xa tlưởc mặt tẩt cả cảc moón, tềng nổi ôông ay yý tếu sửng sổt ôộng tôn vinh Thiên Chùa, vé là: "Tán ha chưa pao giớ kỉa chuyến như xí."<verse eid="MRK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Ngái lái ti xa nâấm piển, ôộng cả đoán dân tếu tềng côống Ngái, rối Ngái táy pảo maáng. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Tang caá ti ngang qua, Ngái kỉa Lê-vi, con từa của A-phê, tang ngối tái tlám thu thuề, xì Ngái pảo ôông: “Hảy xeo thấy!” Khâu khới từng dấn, ôông xeo Ngái.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Việc xảy xa caá Ngái tang ăn pừa ở nhá ôông, nhiếu moón thu thuề yý như moón cò xối côống ngối ăn ôộng Chùa Giê-xu ôộng cảc môn tố Ngái, ví nhiếu moón yý tà xeo Ngái. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Khới cảc thấy táy luật, xuộc phe Pha-ri-si, kỉa là Ngái ngối ăn côống cảc moón cò xối ôộng tán thu thuề, maáng vé côống cảc môn tố Ngái: “Xí nó ôông rì ăn côống tán thu thuề ôộng moón cò xối?” <verse eid="MRK 2:16" /><verse number="17" style="v" sid="MRK 2:17" />Khâu khới măng lới rì, Chùa Giê-xu vé côống maáng: "Moón nôống lăng chăng cò cẫn tềng thấy xuổc, mơi là moón vẳc pếng. Tôi chăng tềng tể hôổc moón côông chình, mơi là moón cò xối."<verse eid="MRK 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Cón cảc môn tố của Giăng ôộng moón Pha-ri-si tang kiêng ăn, maáng yý tềng ôộng poi Ngái: “Ví lỳ do chi mà môn tố của Giăng ôộng môn tố của moón Pha-ri-si kiêng ăn, mơi môn tố của thấy chăng kiêng ăn?” <verse eid="MRK 2:18" /><verse number="19" style="v" sid="MRK 2:19" />Chùa Giê-xu vé côống maáng: “Khẻch tham dứ lể cười chăng thể kiêng ăn tloong khới chù rể cón ở côống maáng tùng chăng? Nều pao lô maáng cò chù rể ở côống mếng, xì maáng chăng thể kiêng ăn àn. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Mơi cảc ngáy sẻ tềng, là caá mà chù rể tà pí tom ti khỏi maáng, xì khới rì, maáng sẻ kiêng ăn tloong cảc ngáy rì. <verse eid="MRK 2:20" /><verse number="21" style="v" sid="MRK 2:21" />Chăng ay pà mộch ménh pải mời pao cày ào cù, mơi nều như cò ôông ay mấn xí, xì mấn rẻch phấn tà pà ở cày ào, tược pải mời côống pải cù, rối tược rẻch xầu hơn xuẩt hiến. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Chăng ay tứng ráo mời tloong pấu ta cù, mơi nều như cò ôông ay mấn xí, xì ráo sẻ mấn rểch pể pấu ta, rối cả ráo ôộng pấu ta tếu pí hư, thay pao rì, ráo mời ở tloong pấu ta mời."<verse eid="MRK 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Việc xảy xa pao ngáy Sa-bát, khới Ngái ti ngang qua mầy roóng loó, cảc môn tố Ngái pẳt tấu pểch pôông loó mí tloong caá ti khà. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Moón Pha-ri-si vé côống Ngái: "Hẩu rạ, xí nó tán reé mấn tiếu chăng àn phẻp tloong ngáy Sa-bát?" <verse eid="MRK 2:24" /><verse number="25" style="v" sid="MRK 2:25" />Ngài pảo maáng: “Cảc ôông chưa pao giớ toọc việc Đa-vít — vua ôộng cảc moón ti côống mếng — tà mấn khới vua cò nhu cấu ôộng pí tòi à? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Xí nó mà ôông tà ti pao nhá Thiên Chùa tloong tới thấy tề lể thướng phẩm A-bia-tha, ôộng ăn pènh cung hiền, là pènh chăng àn phẻp ăn, tlứ xa cảc thấy tề lể, ôộng ôông yý chia cho cảc moón tang ở côống mếng?" <verse eid="MRK 2:26" /><verse number="27" style="v" sid="MRK 2:27" />Ngái vé côống maáng: “Ngáy Sa-bát àn lập xa cho loái moón, ôộng chăng phải loái moón ví ngáy Sa-bát. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Pởi xí, Con Moón là Chùa, ngay cả của ngáy Sa-bát.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Ngái lái ti pao nhá hối, ôộng mộch moón cò pán xay pí teo tang ở tái rì. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Maáng xeo dỏi Ngái kỉ cáng, cò phải Ngái sẻ chửa lénh moón rì tloong ngáy Sa-bát, tể cho maáng cò thể kểt xối Ngái. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Ngái pảo moón cò pán xay pí teo: "Hảy từng pao chình khừa." <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Ôộng Ngái poi maáng: "Ngáy Sa-bát àn phẻp mấn lénh hay mấn ảc; cừu moón hay giểt moón?" Mơi maáng yên lắng. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Khâu khới tưa mẳt hẩu maáng côống loóng giấn, tâu puốn ví sứ cừng loóng của maáng, Ngái vé côống moón tán ôông: "Hảy duổi pán ay của ái xa." Ái duổi xa ôộng pán xay ái àn phục hối. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Ôộng caá tà xa vái, cảc moón Pha-ri-si côống cảc moón xuộc đảng Hê-rốt liến pán mưu tình kề chôồng lái Ngái, mấn xí nó tể tán phè cò thể giểt Ngái.<verse eid="MRK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Chùa Giê-xu côống cảc môn tố Ngái lui vến táng piển, ôộng mộch đoán dân rẩt tôông tà ti xeo pở Ga-li-lê, pở Giu-đê, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />pở Giê-ru-sa-lem, ôộng pở Y-đu-mê côống púng táng pêng kia khôông Giô-đanh, yý như chung quenh thánh Ty-rơ ôộng Si-đôn. Ví măng mẳt cớ nó tiếu Ngái mấn xa, mộch tàm tôông rẩt nhiếu tà kèo tềng côống Ngái. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Ngái pảo cảc môn tố mếng xí nó cho mộch cày thuyến énh chuẩn pí khẳn cho Ngái ví pởi đoán dân, tể maáng chăng chen ẻp Ngái. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Pởi Ngái tà chửa lénh nhiếu moón, tềng nổi nều ôông ay cò pếng tật phải chen lần tềng khênh Ngái tể cò thể chám pao Ngái. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Pẩt cừ khới nó cảc linh ô uề kỉa Ngái, tán reé tếu khẩp mếng xuồng tlưởc Ngái, ôộng tán reé rố náy, vé xí ní: “Ngái là Con Thiên Chùa.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Ngái nghiêm khẳc quở tlẻch tán phè tể tán phè chăng páy tỏ vến Ngái.<verse eid="MRK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Ngài ti lêng tlêng nùi ôộng hôổc cảc moón mà chình Ngái moành, ôộng maáng tềng côống Ngái. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Ngái lập rêng mười han moón (cảc moón mà Ngái yý hôổc là cảc sừ tố), tể maáng ở côống Ngái ôộng tể Ngái cò thể khai phài maáng ti rao giảng, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />yý như pan cho thẩm quyến tuổi quỷ. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Ngái lập rêng mưới han moón: côống Si-môn, Ngái tệch xêm xên là Phi-e-rơ; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />Gia-cơ, con từa Xê-bê-đê, ôộng Giăng, ùn của Gia-cơ, là cảc moón Ngái yý tệch xêm xên là Bô-a-nẹt, nghỉa là cảc con từa của khầm khẻt; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />côống ôộng Anh-rê, Phi-líp, Ba-thê-lê-my, Ma-thi-ơ, Thô-ma, Gia-cơ con từa A-phê, Tha-đê, Si-môn Xê-lốt, <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />ôộng Giu-đa Ích-ca-ri-ốt, yý là xên phản pối Ngái.<verse eid="MRK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ngái pao tloong mộch ngôi nhá, ôộng dân chùng lái kèo phố tềng, tềng nổi Ngái côống cảc môn tố ngay cả chăng thể ăn pènh àn. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Khới cảc moón xân quen Ngái măng xí, maáng tềng tể pẳt giử Ngái, ví maáng vé là: "Ái rì vẩt tlì rối." <verse eid="MRK 3:21" /><verse number="22" style="v" sid="MRK 3:22" />Cảc thấy táy luật, là cảc moón ti xuồng pở Giê-ru-sa-lem, vé là: "Reé pí Bê-ên-xê-bun ềm," ôộng xí ní: "Pởi chùa quỷ mà reé tuổi quỷ." <verse eid="MRK 3:22" /><verse number="23" style="v" sid="MRK 3:23" />Mơi khới tà hôổc maáng tềng côống mếng, Ngái vé côống maáng pắng ẩn dú: "Mấn xí nó Sa-tan cò thể tuổi Sa-tan? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Nều mộch vương quổc pí chia rẻ tứ chôồng lái chình reé, xì vương quổc rì chăng thể từng vửng àn. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Nều mộch gia đính pí chia rẻ tứ chôồng lái chình reé, xì gia đính rì sẻ chăng thể pến lô àn. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Ôộng nều Sa-tan rổi dấn chôồng lái chình mếng mà pí chia cảch, xì reé chăng thể từng vửng, mơi tà tềng khới diệt voong. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />Ngược lái côống việc tứ chôồng lái chình mếng, khới tà pao tloong nhá của mộch moón nôống khửc, chăng ôông ay cò thể cưởp ti tái sản của ái ha tlứ xa tà tlòi àn moón nôống khửc rì tlưởc, rối khâu rì mời cưởp nhá nọ. <verse eid="MRK 3:27" /><verse number="28" style="v" sid="MRK 3:28" />Xật, tôi vé cho cảc ôông, là tẩt cả xối lổi của con cài loái moón sẻ àn tha, ngay cả pẩt ký lới phám thướng nó maáng vé xa, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />mơi nều ôông ay vé phám thướng chôồng lái Chùa Thành Linh, xì chăng cò sứ tha xừ tềng tới tới, mơi moón rì pí vẳc xối mải mải." — <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Ngái vé xí ví maáng pảo: “Reé pí linh ô uề ềm."<verse eid="MRK 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Mế Ngái côống cảc ùn của Ngái tềng, ôộng khới tang từng khá vái, maáng maánh moón pào cho Ngái, hôổc Ngái xa. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Mộch đàm tôông tang ngối quenh Ngái, ôộng maáng vé côống Ngái: “Hẩu rạ, mế thấy côống cảc ái ùn thấy ở vái, tang xím thấy." <verse eid="MRK 3:32" /><verse number="33" style="v" sid="MRK 3:33" />Tlả lới lái maáng, Ngái vé: “Ôông ay là mế tôi ôộng cảc ái ùn tôi?" <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Rối khâu khới tưa mẳt hẩu cảc moón tang ngối chung quenh mếng, Ngái vé: "Hảy hẩu ní, mế tôi ôộng cảc ái ùn tôi! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Ví nều ôông ay mấn xeo ỳ moành Thiên Chùa, xì rì là ái ùn, ới ùn, ôộng mế tôi."<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Mộch lấn nửa, Ngái pẳt tấu giảng táy ở nâấm piển, ôộng mộch đoán dân tôông lặm tập tlung lái chung quenh Ngái. Pởi xí, Ngái tà pưởc pao mộch cày thuyến tlêng piển tể ngối tái rì, cón cả đoán dân ở tlêng nâấm piển. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Ngái táy maáng nhiếu tiếu pắng ẩn dú, ôộng tloong sứ táy pảo của mếng, Ngái vé côống maáng: <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />"Hảy măng ní! Lả, mộch nôông dân đi xa oải giôồng. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Việc diển xa khới moón oải giôồng, mộch sồ hột rúng pêng khà ôộng chim tềng ăn hểt sồ rì. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Sồ hột khảc rúng tlêng tược phú sỏi, là tược chăng cò nhiếu tẩt xịt, ôộng reé moọc lêng ngay lập tửc, ví chăng cằm khu pao tẩt. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Khới mặt tlới moọc lêng, câl pí rằng xiêu tổch, ôộng pởi chăng cò reè, rêng phề pí hèo khô. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Sồ khảc rúng pao khừa púi khoóng. Khoóng moọc lêng chén ẻp reé, ôộng reé chăng teẻ xa hoa tlày chi àn. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Cảc hột khảc nửa rúng tlêng tẩt tổt, mổi hột tom tềng hoa mấu, khới moọc lêng rối àn tăng tlưởng, ôộng reé kểt tlày xa pa mươi, xa phầu mươi, ôộng xa mộch tlăm." <verse eid="MRK 4:8" /><verse number="9" style="v" sid="MRK 4:9" />Ôộng Ngái vé: "Ôông ay cò xai tể măng, hảy măng."<verse eid="MRK 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Khới Ngái ở riêng mộch mếng, cảc moón ở quenh Ngái côống mưới han sừ tố poi Ngái vến cảc ẩn dú rì. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Ngái vé côống maáng: “Sứ mấu nhiếm vến vương quổc của Thiên Chùa tà àn pan cho ái ới ùn, mơi côống cảc moón vái, tẩt cả tếu là pắng ẩn dú,<verse eid="MRK 4:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MRK 4:12" />tể khới hẩu, xì maáng vẩn cò thể hẩu, mơi chăng kỉa àn</para>
  <para style="q" vid="MRK 4:12">khới măng, xì maáng vẩn cò thể măng, mơi chăng hiểu àn,</para>
  <para style="q" vid="MRK 4:12">nều chăng, maáng hồi cải ôộng xối àn tha xừ cho maáng."<verse eid="MRK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ngái vé côống maáng: "Ái ùn chăng hiểu ẩn dú ní à? Xí xì mấn xí nó ái ùn hiểu tẩt cả cảc ẩn dú? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Moón oải hột rì oải đáo. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Cón ní là cảc moón pêng mẻp khà tược mà đáo àn oải xa, mơi khới maáng măng đáo rì, Sa-tan liến tềng ôộng lốm vẩt đáo tà àn oải tloong maáng. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Yý xí, ní là cảc enh tược phú xỏi khới àn oải, nghỉa là moón mà khới maáng măng đáo, liến tiểp nhấn đáo côống niếm phui, <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />mơi maáng chăng cò reè tloong mếng mà chỉ là tám thới. Xí là khới hoán nán hay pửc hái xảy xa ví do đáo, maáng liến lảc đáo. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Sồ khảc là cảc moón khừa púi khoóng àn oải đáo. Ní là cảc moón măng đáo, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />mơi cảc việc lo lằng vến tới ní ôộng ảo tưởng của sứ chấu cò, côống loóng ham moành nhiếu tiếu khảc chen pao, pỏp nghẹt đáo ôộng reé tlở rêng chăng kểt tlày. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Ôộng ní là cảc moón tlêng tẩt tổt àn oải đáo, nghỉa là cảc moón măng đáo ôộng tiểp nhấn, rối xa hoa kểt tlày, xa pa mươi, xa phầu mươi, ôộng xa mộch tlăm."<verse eid="MRK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Ngái pảo maáng: "Tén tổch lêng chăng phải tể àn tệch tìn chấu hay tìn chớng tùng chăng? Chăng phải tể reé àn tệch tlêng chõ tén à? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Ví chăng cò tiếu nó là chù kìn nều chăng phải là tể àn páy tỏ, yý chăng cò tiếu chi tà diển xa cảch pì mật mà chăng phải là tể tưa xa ènh tlàng. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Nều ôông ay cò xai tể măng, hảy măng." <verse eid="MRK 4:23" /><verse number="24" style="v" sid="MRK 4:24" />Rối Ngái vé côống maáng: “Hảy tể ỳ tiếu ái ùn măng. Ái ùn toong to xeo mửc nó, xì mửc rì sẻ àn toong to cho ái ùn ôộng reé sẻ àn tăng xêm cho ái ùn nửa. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Ví moón nó cò xì reé sẻ àn pan cho moón rì, cón moón chăng cò, xì tềng nổi tiếu mà moón rì cò, sẻ pí lế ti khỏi nọ."<verse eid="MRK 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Ngái kể: “Vương quổc của Thiên Chùa là xí ní: chôồng như mộch moón kia oải giôồng tlêng tẩt, <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ái ha tảy hay thửc, têm hay ngáy, hột giôồng xa mấm ôộng náy lêng xí nó — chình ái chăng mẳt. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Tẩt xa hoa kểt tlày xeo cảch của reé: tlưởc tiên là câl là, khâu rì tềng pôông loó, rối hột tấy tủ ở pôông rì. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Rối khới múa loó chìn váng, ái liến tla lài hài ví múa thu hoạch tà tềng."<verse eid="MRK 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Ôộng Ngái vé: “Tán ha cò thể so sành vương quổc của Thiên Chùa như xí nó, hay tán ha cò thể diển tả vương quổc rì pắng ẩn dú chi? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Chôồng như mộch hột cải, là hột mà khới àn oải xuồng tẩt, vồn là énh nhẩt tloong tẩt cả cảc loái hột tlêng tẩt, <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />mơi khới tà àn oải rối, reé moọc lêng ôộng tlở rêng to náy hơn tẩt cả cảc loái xâu tloong vướn, ôộng reé teẻ xa cảc nhènh náy, tềng nổi chim tlới cò thể mấn ổ tìn poòng reé."<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Côống nhiếu ẩn dú như xí, Ngái giảng đáo cho maáng, tuý xeo mửc đố maáng cò thể măng àn, <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />mơi Ngái chăng giảng chi cho maáng mà chăng cò ẩn dú, mơi khới ở riêng, Ngái giải nghỉa tẩt cả cho cảc môn tố mếng.<verse eid="MRK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Tloong ngáy rì, caá tlới tà khuống xồn, Ngài vé côống maáng: “Tán ha cấn ti qua khà nâấm táng kia.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Ôộng khâu khới ti khỏi đoán dân, maáng tưa Ngái côống ti ôộng mếng, ví Ngái tà tang ở tlêng thuyến. Yý cò cảc thuyến khảc xeo Ngái. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Mộch cơn giông pảo náy lặm rổi lêng ôộng soòng cừ ập pao thuyến tềng nổi thuyến khênh pí tấy rảc. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Cón chình Ngái tang ở táng tuôi thuyến, tứa kền tlổc tảy. Maáng hôổc Ngái dấn ôộng thưa côống Ngái: "Thấy ới, thấy chăng lo là tán ha pú chểt à?" <verse eid="MRK 4:38" /><verse number="39" style="v" sid="MRK 4:39" />Khâu khới tỉnh dấn, Ngái quở xò ôộng phàn côống piển: "Hảy yên ti! Hảy lắng ti!" Xí là, xò ngưng xổi, ôộng cò sứ yên lắng hoán toán. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Ngái pảo maáng: "Xí nó ái ùn rưởi? Ái ùn vẩn chưa cò đửc tin à?" <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />Maáng pí hoảng hổt côống sứ khiểp rưởi lặm ôộng maáng vé côống phố: "Xí xì Moón ní là ôông ay, ví tềng nổi xò ôộng piển phải vâng lếnh Nọ?"<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Rối maáng ti tềng nâấm piển táng kia, tềng púng tẩt Giê-ra-sê. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Khới Ngái xa khỏi thuyến, ngay lập tửc, mộch moón pí linh ô uề ềm xa tòn Ngái pở khu nghỉa tlang, <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />moón ní cò tược khôồng tloong cảc cày môố, ôộng chăng ôông ay cò thể cấm giử ái ha àn nửa, ngay cả lế khái xỉch yý chăng àn, <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />ví nhiếu lấn ái pí tlòi pắng cúm ôộng xỉch, mơi khái xỉch xì pí ái pểch tểch, cón cúm xì pí tập raảch, ôộng chăng ôông ay nôống tủ tể khồng chề ái ha. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Suổt cả ngáy lẩn têm tloong cảc hang môố ôộng tlêng cảc khu tốn nùi, ái ha la hẻt ôộng rẹch cảch pỏc mếng pắng phú khẳc nhoánh. <verse eid="MRK 5:5" /><verse number="6" style="v" sid="MRK 5:6" />Khới hẩu kỉa Chùa Giê-xu pở táng giang, nọ chắn tềng ôộng khẩp mếng xuồng tlưởc Ngái. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Náy xiềng rố lêng, ái ha vé: "Hớ Giê-xu, Con của Thiên Chùa Chì Cao, tôi cò liên quan chi côống Ngái? Tôi cấu khẩn Ngái thế tlưởc Thiên Chùa, má mấn khổ tôi." <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Ví Ngái xật xa tà truyến cho reé, xí ní: “Ảc linh kia, hảy xa khỏi moón ní.” <verse eid="MRK 5:8" /><verse number="9" style="v" sid="MRK 5:9" />Ngái poi reé: "Dâu xên chi?" Reé thưa côống Ngái: "Xên tôi là Quân Đoán, ví tán tôi tôông." <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Rối reé cừ liên tục cấu cườn Ngái là Ngái má tuổi tán reé xa khỏi púng rì. <verse eid="MRK 5:10" /><verse number="11" style="v" sid="MRK 5:11" />Caá ní, ở rì cò mộch tán cùn rẩt tôông tang àn tlởi ăn tlêng tốn. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />rêng phề nái cườn Ngái, xí ní: “Cườn truyến cho tán tôi pao tloong tán cùn, tể tán tôi cò thể nhập pao phề.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Ngái cho phẻp phề, ôộng khới tà xuẩt xa xì cảc ảc linh nhập pao tán cùn, rối tán cùn — cò khoảng han nghín con — pở choòng tốn lao lanh xuồng piển ôộng chểt tuồi tìn piển. <verse eid="MRK 5:13" /><verse number="14" style="v" sid="MRK 5:14" />Cảc enh chăn cùn lảc chắn ôộng vé lái việc rì tloong thánh phồ ôộng tloong púng láng quê, rêng nhiếu moón ti tềng tể hẩu việc chi tà diển xa. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Maáng tềng côống Chùa Giê-xu ôộng kỉa moón pí quỷ ềm — nghỉa là moón tà pí Quân Đoán quỷ ềm pao — tang ngối rì, àn ăn mặc phân miêng ôộng ở tloong tính tláng tâm tlì tỉnh tào, xì maáng rưởi lặm. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Mầy moón hẩu kỉa kể lái côống maáng việc tà diển xa như xí nó cho moón pí quỷ ềm ôộng chuyến vến tán cùn. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ôộng maáng vở lới cấu khẩn Ngái ti khỏi púng của mếng. <verse eid="MRK 5:17" /><verse number="18" style="v" sid="MRK 5:18" />Khới Ngái tang pưởc pao thuyến, moón tà pí quỷ ềm nái cườn Ngái tể ái cò thể ở côống Ngái. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Ngái chăng cho phẻp ái, mơi truyến cho ái: "Hảy ti vến nhá ái, tềng côống cảc moón xân quen của ái mà vé lái cho maáng việc vỉ đái Chùa tà mấn tlêng ái ôộng xí nó Ngái tà tỏ loóng xương xỏt ái." <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Ôộng rối, ái xa ti ôộng pẳt tấu loan pào tloong púng Đê-ca-bô-lơ việc vỉ đái xí nó mà Chùa Giê-xu tà mấn cho mếng, ôộng ôông ay yý tếu sửng sổt.<verse eid="MRK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Khâu khới Chùa Giê-xu ở tlêng thuyến păng qua nâấm táng kia lấn nửa, mộch đoán dân tôông lặm tập tlung lái quenh Ngái, ôộng Ngái tang ở tược nâấm piển. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Hẩu rạ, mộch tloong cảc moón cai quản nhá hối, xên là Giai-ru, ti tềng, ôộng khới kỉa Ngái, ôông quý xuồng tìn chõ Ngái. <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />Ôông khẩn thiểt cườn Ngái khới thưa xí ní: "Con cài énh của tôi tang rẩt nguy kịch. Cườn Ngái tềng tể Ngái tệch xay lêng xôn tể cho xôn cò thể àn chửa lénh ôộng àn khôồng." <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Xí là Ngái ti côống ôông, mộch đoán dân tôông lặm yý ti xeo Ngái ôộng lần ẻp chung quenh Ngái.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Cò mộch phú nử tà pí roong mầu mưới han năm, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />tà chíu khồn khổ nhiếu lặm pởi nhiếu thấy xuổc ôộng tà tiêu hểt cảc xừ của mếng, mơi chăng tom lái lới ỉch chi, mà thay pao rì, pếnh cón tlở rêng nắng hơn, <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />khâu khới măng vến Chùa Giê-xu, xì caá tềng khênh khà khâu Ngái khừa đoán dân tôông, ới chám pao ào Ngái. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Ví ới nghỉ xí ní: “Nều mếng chỉ chám pao ào Ngái rôi xì mếng sẻ àn lénh.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Ngay lập tửc, pếnh rong mầu của ới ngưng lái, ôộng ới cảm nhấn tlêng pỏc mếng mếng, là pản xân tà àn chửa lénh khỏi pếnh. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Lập tửc, Chùa Giê-xu, hay àn ở chình mếng là quyến năng pở mếng tà xuẩt xa, rêng quay lái khừa đàm tôông, Ngái poi xí ní: "Ôông ay tà chám pao ào của tôi?" <verse eid="MRK 5:30" /><verse number="31" style="v" sid="MRK 5:31" />Cảc môn tố Ngái thưa côống Ngái: "Thấy kỉa đàm tôông tang lần ẻp thấy, mà thấy cón poi: 'Ôông ay chám pao tôi' à?" <verse eid="MRK 5:31" /><verse number="32" style="v" sid="MRK 5:32" />Ngái vẩn tang hẩu quenh tể mẳt ôông ay tà mấn tiếu rì. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Caá ní, moón phú nử, ví tà tlở rêng rưởi lặm ôộng run rẩy, mẳt việc tà diển xa cho mếng, rêng tà tềng, khẩp mếng xuồng tlưởc Ngái ôộng kể lái cho Ngái tẩt cả sứ xật. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Mơi Ngái vé côống ới: “Hớ con cài, đửc tin con tà chửa lénh con. Hảy ti tloong pính an ôộng àn nôống lăng khỏi pếng của con."<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Tloong caá Ngái cón tang vé, cò mầy enh pở nhá của moón cai quản nhá hối tềng pào xí ní: “Con cài của ôông chểt rối. Xí nó cón mấn phiến thấy nửa?" <verse eid="MRK 5:35" /><verse number="36" style="v" sid="MRK 5:36" />Mơi khới măng àn lới maáng vé, Chùa Giê-xu pảo moón cai quản nhá hối: "Má rưởi. Chỉ tin mà rôi." <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Ngái chăng cho phẻp ôông ay khảc ti côống mếng, tlứ xa Phi-e-rơ, Gia-cơ ôộng Giăng, ùn Gia-cơ. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Ngái ti tềng nhá của moón cai quản nhá hối ôộng kỉa cảnh hổn loán côống nhám ôộng than vản lặm. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Khới pưởc pao, Ngái vé côống maáng: "Xí nó tán dâu puốn rấu ôộng nhám? Từa rẻt chăng chểt, mơi xôn tang tảy." <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Xí là tán phề cưới nháo Ngái, mơi khới tà tuổi hểt tán phề xa vái, Ngái tom xeo pồ, mế của từa rẻt ôộng cảc moón ti côống Ngái, rối Ngái tềng tược từa rẻt tảy. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Khâu khới cấm xay từa rẻt, Ngái pảo vaá rẻt: "Ta-li-tha, cum!" lới rì xì àn dịch là: "Con cài énh, ho pảo con hảy tỉnh dấn." <verse eid="MRK 5:41" /><verse number="42" style="v" sid="MRK 5:42" />Lập tửc, vaá rẻt ngối dấn ôộng pưởc ti (ví tà àn mưới han xuổi), ôộng cảc moón ở rì liến ngạc nhiên, sửng sổt lặm. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ngái nghiêm khẳc pảo maáng là chăng mộch ôông ay rêng mẳt việc ní, ôộng Ngái pảo maáng cho vaá rẻt ăn.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Pở tược rì, Ngái tà ti khỏi, rối vến tềng quê nhá của mếng, ôộng cảc môn tố của Ngái ti xeo Ngái. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Tềng ngáy Sa-bát, Ngài pẳt tấu giảng táy tloong nhá hối. Nhiếu moón măng pí sửng sổt, vé xí ní: "Cảc lới giảng táy ní lế xa pở nó? Sứ khôn ngoan tà àn pan cho ôông ní côống mầy phẻp lá như xí rì diển xa pởi xay ôông ha là xí nó? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />"Chăng phải ní là enh thớ mộc, con từa của Ma-ri, ôộng ái của Gia-cơ, Giô-sê, Giu-đe ôộng Si-môn à? Chăng phải mầy vaá ùn cài của ôông rì tang ở ní khừa tán ha à?” maáng pí vẩp phám vến Ngái. <verse eid="MRK 6:3" /><verse number="4" style="v" sid="MRK 6:4" />Chùa Giê-xu vé côống maáng Xí ní: “Nhá tiên tli xì chăng xiều sứ tôn tlóng, tlứ xa ở quê nhá mếng, khừa voóng ùn maáng mếng ôộng ở moón nhá mếng." <verse eid="MRK 6:4" /><verse number="5" style="v" sid="MRK 6:5" />Ngái chăng thể mấn pẩt ký việc quyến năng nó ở rì, tlứ xa Ngái tà chửa pếnh khới tệch xay tlêng rẩt ét moón tâu ồm. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Ngái ngạc nhiên ví pởi loóng chăng tin của maáng, rối Ngái ti giảng táy quenh cảc láng quê.<verse eid="MRK 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />Ngài hôổc mưới han sừ tố ôộng pẳt tấu khai phài maáng xa ti, mổi đôi mộch; Ngái yý pan cho maáng thẩm quyến tlêng cảc ảc linh, <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />ôộng truyến pảo maáng là má tom chi xeo cho chuyền ti, tlứ xa mộch câl câấy duy nhẩt — chăng pènh, chăng xôông, yý chăng xiến pạc tloong xẳt cố rôồng — <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />mơi cò tom giáy dẻp, ôộng "Ái ùn má mặc han ào." <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Ôộng Ngái truyến cho maáng: "Nều khới ái ùn pao tloong nhá nó, hảy cừ ở tái rì cho tềng khới nó ái ùn ti khỏi nhá rì. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Pẩt cừ tược nó chăng tòn tiểp ái ùn, hay chăng chíu măng ái ùn, xì khới ti khỏi rì, hảy phủi pún tìn chõ mếng như pắng chừng chôồng lái maáng." <verse eid="MRK 6:11" /><verse number="12" style="v" sid="MRK 6:12" />Xí là, khâu khới lêng khà, maáng rao giảng là tẩt cả cảc moón cấn phải ăn năn. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Maáng tuổi nhiếu quỷ, ôộng xửc dấu cho nhiếu moón pếnh ôộng chửa lénh maáng.<verse eid="MRK 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Xí rối, vua Hê-rốt tà măng àn tin ní, ví danh xiềng Ngái tà tlở rêng rổi xiềng, ôộng maáng vé là: "Giăng Báp-tít tà àn mấn cho khôồng lái pở cày chểt, pởi rì cảc phẻp lá quyến năng tang mấn xa pởi moón ní." <verse eid="MRK 6:14" /><verse number="15" style="v" sid="MRK 6:15" />Cón cảc moón khảc vé xí ní: “Ôông ha là Ê-li.” Mà moón khảc nửa vé rì là: “mộch nhá tiên tli, chôồng như mộch tloong cảc tầng tiên tli." <verse eid="MRK 6:15" /><verse number="16" style="v" sid="MRK 6:16" />Mơi khới măng xí, Hê-rốt pảo là: "Giăng, moón mà ho chạch tlổc, ôông rì tà àn mấn cho khôồng lái." <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Ví chình Hê-rốt, tà cử moón, pẳt Giăng ôộng tlòi ôông tloong ngục vến việc Hê-rô-đia (du của Phi-líp, ùn từa vua) ví pởi vua tà lế mú ha. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Pởi Giăng tà vé côống Hê-rốt là: "Xật là tlài luật khới vua cười du của ùn từa mếng." <verse eid="MRK 6:18" /><verse number="19" style="v" sid="MRK 6:19" />Mơi Hê-rô-đia căm giấn ôông ôộng moành giểt chểt ôông, mơi mú ha chăng thể, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />pởi Hê-rốt rưởi Giăng; ví mẳt ôông là moón côông chình ôộng xuộc vến Chùa, rêng vua giử cho ôông àn an toán, ngay cả khới măng ôông vé, vua rẩt khò chíu, mơi vua vẩn khẳn loóng tlằng ôông. <verse eid="MRK 6:20" /><verse number="21" style="v" sid="MRK 6:21" />Rối khới tềng thới điểm thuấn lới, là caá Hê-rốt mấn tiệc sinh nhật mếng đải cảc quan chửc của mếng côống cảc chỉ huy quân đối, ôộng tán lảnh đáo púng Ga-li-lê, <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />xì caá rì con cài Hê-rô-đia của vua tà pưởc pao, dảch mùa, ôộng mấn Hê-rốt côống cảc khẻch chung pán ôộng vua rẩt phưa loóng, rêng vua tà vé côống vaá cài: "Hảy cườn ho pẩt cừ tiếu chi con moành ôộng ho sẻ pan reé cho con." <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Ôông thế côống vaá là: “Cho dú con cườn ho, tềng mộch nửa vương quổc của ho, ho yý sẻ cho con." <verse eid="MRK 6:23" /><verse number="24" style="v" sid="MRK 6:24" />Xí là, khâu khới ti xa vái, vaá cài poi mế mếng: "Con rêng cườn chi?" Rối mú ha tlả lới: "Cày tlổc của Giăng Báp-tít." <verse eid="MRK 6:24" /><verse number="25" style="v" sid="MRK 6:25" />Ngay caá rì, tloong sứ vối váng caá quay tlở lái côống vua, vaá cài cườn: "Con moành là ngay caá ní vua pan cho con cày tlổc của Giăng Báp-tít tệch tlêng vâm." <verse eid="MRK 6:25" /><verse number="26" style="v" sid="MRK 6:26" />Ngay cả tlở rêng rẩt puốn rấu, mơi vua chăng moành tứ chồi vaá ví pởi lới thế của mếng ôộng cảc quan khẻch tang ngối chung pán ôộng mếng, <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />rêng vua liến, khai tao phủ, truyến tom tlổc của Giăng tềng, ôộng khâu khới xa vái, reé ti chạch tlổc ôông tloong ngục. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Reé tom tlổc của ôông tể tlêng vâm ôộng tưa reé cho vaá cài, rối vaá cài tưa reé lái cho mế mếng. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Khới tà măng àn chuyến, cảc môn tố của Giăng tềng, lế xảc ôông, ôộng tom reé ti pầm tloong môố.<verse eid="MRK 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Cảc sừ tố tập tlung lái côống Chùa Giê-xu, kể cho Ngái tẩt cả cảc việc maáng tà mấn ôộng cảc tiếu maáng tà táy. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Ngài pảo maáng: “Chình ái ùn hảy tứ ti tềng tược nó rì riêng tư vằng vẻ, ôộng hảy hơi mai mộch ét." Ví cò rẩt nhiếu moón ti qua moón ti lái, ôộng maáng tềng nổi chăng cò thới gian tể ăn. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Maáng côống phố ti lêng thuyến tềng mộch tược vằng vẻ. <verse eid="MRK 6:32" /><verse number="33" style="v" sid="MRK 6:33" />Nhiếu moón tà kỉa maáng ti khỏi ôộng nhấn xa maáng, rêng pở khồm cảc thí trần, maáng tà côống phố chắn pố tềng rì ôộng tềng tược tlưởc maáng. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Khới tà pưởc xa khỏi thuyến, Ngái kỉa mộch đoán dân rẩt tôông, ôộng Ngái tôống loóng xương xỏt maáng ví maáng chôồng như chiên chăng cò moón chăn, rối Ngái pẳt tấu táy maáng nhiếu tiếu. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Caá rì tà muốn rối, rêng khới tềng côống Ngái, cảc môn tố của Ngái thưa là: "Tược ní là tược vằng vẻ ôộng giớ ní khuống xồn lặm rối. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Cườn cho tán dân xa vến, tể khâu khới ti pao cảc lùng láng chung quenh ní, xì maáng cò thể tứ mua cày chi rì tể ăn." <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Mơi khới tlả lới maáng, Ngái pảo: "Ái ùn hảy cho maáng ăn." Maáng thưa côống Ngái: "Khới ti rối, xì mẳt tán tôi cò thể mua àn han tlăm đơ-ni-ê pènh mà tưa cho tán dân ăn à?" <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Xí là, Ngái vé côống maáng: "Hảy ti. Xím xử. Ái ùn cò cớ nó cày pènh?" Khâu khới xím hiểu, maáng thưa: "Răm cày pènh ôộng han con cà." <verse eid="MRK 6:38" /><verse number="39" style="v" sid="MRK 6:39" />Ngái truyến cho tẩt cả dân chùng ngối xuồng thánh mổi nhòm tlêng cỏ xenh. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Maáng ngối chia xa cảc nhòm phân thánh mộch tlăm moón ôộng thánh răm mươi moón. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Khâu khới cấm răm cày pènh ôộng han con cà, ngảc mặt lêng tlới, Ngái tá ơn ôộng pẻ pènh xa rối tưa cho cảc môn tố mếng tể maáng tom phân phảt cho dân chùng, Ngái yý chia han con cà xa cho tẩt cả cảc moón. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Maáng tếu ăn ôộng àn ro tlống. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Ôộng maáng thu gom àn mưới han giỏ tấy cảc ménh pènh vún ôộng cà. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Cảc moón tà ăn pènh là răm nghín moón tán ôông.<verse eid="MRK 6:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Lập tửc, Ngái thủc giục cảc môn tố mếng pưởc lêng thuyến ôộng ti tlưởc qua nậm táng kia, tềng Bết-sai-đa, tloong khới Ngái cho dân chùng xa vến. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Khới maáng tà khởi hãnh, Ngái ti lêng nùi tể cấu nguyến. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Tềng xồn, thuyến tà ở khừa piển, ôộng Ngái ở môộch mếng tlêng tẩt liến. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Kỉa maáng tang gằng khửc chéo thuyến — ví xò tang ngược hường côống maáng — xì khoảng canh tư têm rì, Ngái ti pố tlêng mặt piển tềng tược maáng ôộng Ngái moành vượt qua maáng. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Mơi khới hẩu kỉa Ngái pưởc ti tlêng mặt piển, maáng tưởng rì là ma, rêng maáng rố náy lêng, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />ví maáng tếu hẩu kỉa Ngái ôộng pí rưởi lặm. Mơi lập tửc, Ngái vé côống maáng ôộng truyến pảo maáng: "Hảy vửng loóng! Là thấy ní! Má rưởi!" <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Ngái pưởc pao tloong thuyến côống maáng ôộng xò yên ti hẳn, cảc môn tố cò sứ ngạc nhiên tột đố ở khừa voóng maáng. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Ví maáng tà chăng hiểu vến phẻp lá hoà pènh, thay pao rì, loóng maáng vẩn cón cừng cỏi.<verse eid="MRK 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Khới tà ti qua táng nâấm kia, maáng ti tềng Ghê-nê-xa-rết ôộng tâấu thuyến ở rì. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />khới maáng xa khỏi thuyến, ví nhấn xa Ngái ngay, <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />rêng maáng chắn ti khồm púng rì ôộng pẳt tấu rướng cảc moón pí pếnh tlêng chớng tềng tược mà maáng măng là Ngái tang ở rì. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Ở tược nó Ngái ti pao, tloong cảc láng mạc, hay tloong thánh phồ hay tloong xôn quê, dân chùng tếu tom cảc moón pếnh tệch ở tược phồ chớ ôộng cườn Ngái tể ét nhẩt maáng cò thể chám pao vạt ào của Ngái, ôộng pẩt cừ moón nó chám pao Ngái tếu àn lénh pếnh.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Cảc moón Pha-ri-si côống mầy thấy táy luật, tà tềng pở Giê-ru-sa-lem, tang tập tlung lái chung quenh Ngái. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Ví tà chừng kiền mộch sồ môn tố của Ngái, khới maáng ăn pènh côống pán xay ô uề, nghỉa là chưa xửa. <verse eid="MRK 7:2" /><verse number="3" style="v" sid="MRK 7:3" />(Pởi moón Pha-ri-si yý như tẩt cả moón Do Thài tếu chăng ăn pừa nều chưa xửa xay mếng cẩn thấn, vì tuân giử truyến thồng của tổ tiên; <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />ôộng cày chi tom pở chớ vến, maáng chăng ăn nều chưa tẩy xửa, ôộng cón nhiếu cày khảc mà maáng tà thứa hưởng tể vâng giử: việc xửa chèn tìa, nối niêu, ôộng cảc vật tứng pắng tôống.) <verse eid="MRK 7:4" /><verse number="5" style="v" sid="MRK 7:5" />Cảc moón Pha-ri-si ôộng thấy táy luật poi Ngái: “Xí nó môn tố của thấy chăng khôồng xeo truyến thồng của cha ôông, mơi lái ăn pènh pắng xay chưa xửa?" <verse eid="MRK 7:5" /><verse number="6" style="v" sid="MRK 7:6" />Mơi khới tlả lới maáng, Ngái vé xí ní: "Ê-sai vé tiên tli rẩt tùng vến tán moón đáo đửc giả cảc ôông. Như cò chẻp xí ní:</para>
  <para style="q" vid="MRK 7:6">‘Dân ní tôn kình ho ở tấu môi chỏt lài</para>
  <para style="q" vid="MRK 7:6">mơi tầm loóng của maáng xì cảch giang khỏi ho.<verse eid="MRK 7:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MRK 7:7" />Cón maáng thớ phướng ho cảch vô ỉch, khới táy pảo cảc tiếu luật của loái moón như cảc giào lỳ.'<verse eid="MRK 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8" />Lảc ti mếnh lếnh của Thiên Chùa, cảc ôông giử xeo truyến thồng của loái moón." <verse eid="MRK 7:8" /><verse number="9" style="v" sid="MRK 7:9" />Ôộng Ngái pảo maáng: "Cảc ôông xật khèo tứ chồi mếnh lếnh của Thiên Chùa tể tuân giử truyến thồng của mếng! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Ví Môi-se táy: ‘Hảy tôn kình pồ mếng côống mế mếng,' ôộng 'Moón nó rủa pồ hay mế — moón rì phải chíu kểt cục pắng cày chểt.' <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Mơi cảc ôông pảo: ‘Nều môộch moón vé côống pồ hay mế mếng: "nều tiếu mà pồ mế đàng xa àn chăm nom pở con là Co-ban (nghỉa là 'lể vật dơng Thiên Chùa')", <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />xì cảc ôông chăng cho phẻp moón rì mấn pẩt cừ tiếu chi cho pồ hay mế của mếng nửa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />mấn lới của Thiên Chùa thánh xa chăng cò già tlí pắng truyến thồng của cảc ôông mà cảc ôông tà truyến lái, ôộng cảc ôông mấn nhiếu tiếu chôồng như xí." <verse eid="MRK 7:13" /><verse number="14" style="v" sid="MRK 7:14" />Ôộng khâu khới lái hôổc dân chùng tềng, Ngái vé côống maáng: "Tẩt cả ái ới ùn hảy măng tôi ôộng hảy hiểu: <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />chăng cò cày chi pở khà vái mộch moón pao tloong moón rì mà cò thể mấn ô uề moón rì; mơi cảc tiếu pở khà tloong xa khỏi moón rì là cảc tiếu mấn ô uề maáng." <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />(Nều ôông ay cò xai tể măng, hảy măng.) <verse eid="MRK 7:16" /><verse number="17" style="v" sid="MRK 7:17" />khới Ngái ti pao nhá, xa khỏi đàm tôông, cảc môn tố Ngái poi Ngái vến ẩn dú. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Ngái vé côống maáng: "Như xí mà ái ùn yý chăng cò sứ thông hiểu à? Ái ùn chăng nhấn xa là tẩt cả cảc cày pở khà vái pao tloong mộch moón chăng thể mấn ô uề moón rì àn à? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Ví reé chăng ti pao tầm loóng moón, mơi là pao tlống, rối pí thải xa tloong hồ xì (nghỉa là tẩt cả tố ăn tếu àn quang.)" <verse eid="MRK 7:19" /><verse number="20" style="v" sid="MRK 7:20" />Mơi Ngái vé xí ní: "Tiếu xa khỏi moón mời là thừ mấn ô uề maáng. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Ví pở khà tloong, xuẩt phảt pở tầm loóng con moón, phảt xa cảc ảc tưởng, gian dâm, lốm cẳp, giểt moón, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ngoái tính, tham lam, tôộc ảc, lứa gạt, hoang dâm, con mẳt genh khẻt, phỉ pàng, kiêu căng, ngôông cuống. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Tẩt cả tiếu ảc ní pở khà tloong phảt xa ôộng phề mấn ô uề maáng.”<verse eid="MRK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Rối khới tà từng dấn khỏi rì, Ngái ti tềng púng Ty-rơ ôộng Si-đôn, ôộng khới tà pao tloong mộch cày nhá, Ngái chăng moành ôông ay hay, mà chăng thể chù mếng àn. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Mơi ngay lập tửc, mộch phú nử kia, là moón cò con cài énh của vaá pí ảc linh ềm, ví tà măng vến Ngái, rêng khới tềng, vaá khẩp mếng xuồng tìn chõ Ngái. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Caá ní, moón phú nử rì là moón Hy-lạp, côổc Sy-rô-phê-ni-xi, ôộng vaá cấu cườn Ngái tể Ngái tuổi quỷ xa khỏi con cài mếng. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Ngái vé côống vaá: "Tlưởc tiên, phải tể con cài àn ăn cho ro tlưởc, ví xật là chăng tổt khới lế pènh của con cài ôộng nèm cho chò con." <verse eid="MRK 7:27" /><verse number="28" style="v" sid="MRK 7:28" />Mơi vaá tlả lới lái ôộng thưa côống Ngái: "Tùng xí, thưa Chùa, ôộng mầy chò con ở tìn pán ăn pở cảc vún pènh của con cài." <verse eid="MRK 7:28" /><verse number="29" style="v" sid="MRK 7:29" />Xí là Ngái pảo vaá: "Ví lới ní, vaá hảy vến ti. Quỷ tà xa khỏi con cài của vaá." <verse eid="MRK 7:29" /><verse number="30" style="v" sid="MRK 7:30" />Khới ti vến tềng nhá mếng, vaá kỉa từa rẻt tảy tlêng chớng, ôộng quỷ tà xa khỏi.<verse eid="MRK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Ôộng mộch lấn nửa, khâu khới ti khỏi púng Ty-rơ, Ngái ti păng qua thánh Si-đôn tềng piển Ga-li-lê, tềng cả khừa púng Đê-ca-bô-lơ. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Maáng tom tềng cho Ngái mộch moón tiểc ôộng ngoóng, rối maáng cườn Ngái, tể cho Ngái tệch xay tlêng ái ha. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Khới tà tứ mếng tom moón rì xa khỏi đàm tôông, Ngái tệch cảc ngòn xay mếng pao han lồ xai ái, ôộng khới chù rảc dài rối, Ngái xửc pao lài ái. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Ôộng ngảc mặt lêng tlới, Ngái thở dán, rối vé côống ái: "Ép-pha-ta," (nghỉa là: "Hảy vở xa!"). <verse eid="MRK 7:34" /><verse number="35" style="v" sid="MRK 7:35" />Xí là xai ái rì àn vở xa, ngăn cản ở lài ái àn giải phoòng, ôộng ái pẳt tấu vé rỏ ráng. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Ngái cầm maáng tể maáng chăng vé côống ôông ay. Mơi Ngái cáng cầm maáng cớ nó, maáng lái cáng rao tin rì xa nhiếu hơn cớ rì. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Maáng rẩt là sửng sổt, vé xí ní: "Ôông rì tà mấn tẩt cả cảc việc xật tổt lénh. Tềng nổi, ôông rì mấn cho moón tiểc măng àn ôộng moón câm vé àn."<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Tloong cảc ngáy rì, lái cò mộch đoán dân tôông lặm, ôộng chăng cò chi tể ăn, khâu khới hôổc cảc môn tố mếng, Ngái vé côống maáng: <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Thấy xương đoán dân ní, ví maáng cừ ở côống thấy tà pa ngáy rối mơi chưa cò cày chi tể ăn cả. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Nều thấy truyến cho maáng ti vến nhá maáng tang tlống tòi, xì maáng sẻ ngẩt tlêng khà, mơi mộch xồ moón tloong maáng tà tềng pở tược giang lặm." <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />Cảc môn đố Ngái tlả lới côống Ngái xí ní: "Mộch ôông ay rì ở ní, ở tược vằng vẻ ní, cò thể lế pở nó mà cho đoán dân như xí ăn pènh àn?" <verse eid="MRK 8:4" /><verse number="5" style="v" sid="MRK 8:5" />Ngái poi maáng: “Ái ùn cò cớ nó pènh?” Maáng tlả lới: “Pảy cày.” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Ngái truyến cho đoán dân ngối xuồng tẩt, ôộng khâu khới lế pảy cày pènh, tá ơn, Ngái pẻ xa rối tưa cho cảc môn tố mếng tể maáng cò thể tom phục vuú, xí là maáng rón xa cho đoán dân. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Ôộng maáng cò mầy con cà énh, rêng khâu khới cảm tá vến phề, Ngái pảo maáng yý phân phảt phấn cà ní nửa. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Dân chùng ăn ôộng àn ro tlống, rối maáng gom àn pảy giỏ pènh vún cón xứa. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Caá ní, cò khoảng pồn nghín moón, rối Ngái cho maáng vến. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Ngay caá rì, khâu khới pao tloong thuyến côống cảc môn tố mếng, Ngái ti tềng púng Đa-ma-nu-tha.<verse eid="MRK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Cảc moón Pha-ri-si xuẩt hiến ôộng pẳt tấu tlenh luấn côống Ngái, tói xím ở Ngái mộch phẻp lá pở tlới, tể thử Ngái. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Khâu khới thở dán tloong tâm thấn mếng, Ngái tlả lới: "Ví xí nó thề hế ní tói xím phẻp lá? Xật là, tôi vé côống cảc ôông, chăng cò phẻp lá nó sẻ àn pan cho thề hế ní ..." <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Rối khới tà ti khỏi maáng, pao lái tloong thuyến, Ngái ti qua nâấm táng kia.<verse eid="MRK 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Cảc môn tố phêng tom xeo pènh, ôộng maáng chăng cò chi côống mếng tloong thuyến, tlứ xa mộch cày pènh. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Ngái cảnh pào maáng là: "Hảy cẩn thấn! Hảy tề ỳ vến men của moón Pha-ri-si ôộng men của Hê-rốt." <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Maáng pán luấn côống phố là chuyến ní là ví maáng chăng cò pènh. <verse eid="MRK 8:16" /><verse number="17" style="v" sid="MRK 8:17" />Ví mẳt như xí, Chùa Giê-xu vé côống maáng: "Xí nó ái ùn lái pán cải ví chuyến ái ùn chăng cò pènh? Ái ùn vẩn chưa nhấn thửc àn, ôộng yý chưa hiểu à? Cò phải loóng ái ùn tlở rêng chai cừng rối? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Cò mẳt mà ái ùn chăng kỉa à? Cò xai mà ái ùn chăng măng à? Ái ùn yý chăng căắn à? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Khới thấy pẻ răm cày pènh cho răm nghín moón, ái ùn tà gom àn cớ nó giỏ tấy pènh vún?" Maáng tlả lới côống Ngái: "Mưới han giỏ." <verse eid="MRK 8:19" /><verse number="20" style="v" sid="MRK 8:20" />"Cón caá pảy cày pènh cho pồn nghín moón, ái ùn gom àn mầy giỏ tấy pènh vún?" Maáng tlả lới côống Ngái: "Pảy giỏ." <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Ôộng Ngái pảo maáng: "Mấn xí nó mà ái ùn vẩn chưa hiểu?"<verse eid="MRK 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Maáng ti tềng Bết-sai-đa, ôộng maáng tom tềng cho Ngái mộch moón mú, rối maáng cấu cườn Ngái tể Ngái cò thể chám pao ái ha. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Câấm xay moón muú, Ngái tảch ái ha xa vái láng. Khâu khới chù rảc dài lêng mẳt ái, tệch xay mếng tlêng ái, Ngái poi ái: "Ái cò kỉa pẩt ký xừ chi chăng?" <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Ngảc hẩu lêng, ái tlả lới: "Tôi kỉa maáng mơi maáng hẩu chôồng cảc cày câl tang ti." <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Tiểp xeo, mộch lân nửa, Ngái tệch xay lêng mẳt ái, rối ái hẩu chăm chù, mẳt àn pính phục ôộng ái hẩu kỉa tẩt cả cảch rỏ ráng. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ngái pảo ái ti vến nhá mếng, pảo là: "Má rêng pao tloong láng."<verse eid="MRK 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Chùa Giê-xu côống cảc môn tố mếng ti pao cảc láng xuộc Xê-xa-rê Phi-líp, ôộng tlêng khà ti, Ngái poi cảc môn tố mếng, vé côống maáng là: "Maáng vé thấy là ôông ay?" <verse eid="MRK 8:27" /><verse number="28" style="v" sid="MRK 8:28" />Rối maáng vé côống Ngái, thưa là: "Giăng Báp-tít, xồ khảc là 'Ê-li,' cón moón khảc nửa là: 'Mộch tloong cảc nhá tiên tli." <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Ngái poi maáng: “Cón ái ùn vé thấy là ôông ay?" Rối caá tlả lới, Phi-e-rơ thưa côống Ngái: "Thấy là Chùa Cừu Thề." <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Ngái cảnh pào maáng là maáng chăng rêng vé côống ôông ay vến Ngái.<verse eid="MRK 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Ôộng Ngái pẳt tấu táy maáng là Con Moón phải chíu nhiếu tiếu tâu khổ, pí loái xa pởi cảc tlưởng lảo, cảc thấy tề lể cả côống cảc thấy táy luật, ôộng pí giểt chểt, rối khôồng lái khâu pa ngáy. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ngái tà vé lới ní cảch rỏ ráng. Phi-e-rơ, khâu khới tom Ngái riêng xa, pẳt tấu tlẻch Ngái. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Mơi, khới tà quay lái hẩu cảc môn tố mếng, Ngái quở tlẻch Phi-e-rơ là: "Sa-tan kia, hảy lui xa khà khâu ho! Ví ái chăng tể loóng mếng nghỉ tềng việc của Thiên Chùa, mơi chỉ tềng việc loái moón." <verse eid="MRK 8:33" /><verse number="34" style="v" sid="MRK 8:34" />Khâu khới hôổc đoán dân côống cảc môn tố mếng, Ngái vé côống maáng: "Nều ôông ay moành xeo khâu tôi, moón rì phải tứ chồi chình mếng, vảc câl thập tứ mếng ôộng xeo tôi. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Pởi nều ôông ay moành cừu maáng khôồng mếng, xì sẻ mấn vẩt reé, cón moón nó ví pởi tôi ôộng Tin Lénh sẻ chíu vẩt maáng khôồng mếng, xì sẻ cừu àn reé. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Ví ỉch lới chi cho moón àn cả thề giời mơi lái vẩt ti linh hốn mếng? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Moón rì cò thể lế chi như vật trao tổi côống linh hốn mếng? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Nều ôông ay xầu hổ vến tôi ôộng lới của tôi tloong thề hế gian dâm ôộng xối lổi ní, xì Con Moón yý sẻ xầu hổ vến moón rì khới Ngái tềng tloong vinh quang của Cha Ngái côống cảc thiên sừ thành."<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Ngái vé côống maáng: "Xật sứ, thấy vé côống ái ới ùn là cò mộch xồ moón tang từng ní là cảc moón chẳc chằn chăng rềm tlải cày chểt tlưởc khới maáng hẩu kỉa vương quổc của Thiên Chùa tềng côống năng quyến." <verse eid="MRK 9:1" /><verse number="2" style="v" sid="MRK 9:2" />Phầu ngáy khâu, Chùa Giê-xu tom Phi-e-rơ, Gia-cơ ôộng Giăng rối tưa riêng mếng maáng ti lêng mộch ngón nùi cao, ôộng Ngái àn piền hoà tlưởc mặt maáng. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Ào Ngái tlở rêng rẩt là chòi tlàng, tlằng tinh, tềng nổi chăng moón thớ chẳt nó tlêng thề gian cò thể mấn cho tlằng àn như xí. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ê-li côống Môi-se àn maáng hẩu kỉa, ôộng han ôông rì tang duyên chuyến côống Chùa Giê-xu. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Khới vở lới, Phi-e-rơ thưa côống Chùa Giê-xu: "Ra-bi, xật là tổt cho tán ha ở ní, tán tôi cò thể tứng pa cày lếu, mộch cho thấy, mộch cho Môi-se ôộng mộch cho Ê-li." <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />(Ví ôông chăng mẳt ôông rêng vở lới vé cày chi, pởi maáng tếu rưởi lặm.) <verse eid="MRK 9:6" /><verse number="7" style="v" sid="MRK 9:7" />Rối mộch đàm mân kèo tềng pao phủ maáng, ôộng xiềng phàn phảt xa pở đàm mân: "Ní là Con yêu dầu của Ho. Hảy măng lới Con rì." <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Pẩt ngớ, khới hẩu quenh, maáng chăng cón kỉa pẩt cừ ôông ay khảc ở côống mếng, tlứ xa mộch mếng Chùa Giê-xu.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Khới maáng ti pở tlêng nùi xuồng, Ngái pảo maáng là maáng má kể lái côống ôông ay vến cày chi maáng tà kỉa, nều chưa tềng thới điểm Con Moón pở cày chểt khôồng lái. <verse eid="MRK 9:9" /><verse number="10" style="v" sid="MRK 9:10" />Maáng giử kìn lới rì tloong voóng maáng, pán luấn côống phố là "pở cày chểt khôồng lái" là xí nó. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Maáng poi côống Ngái, thưa xí ní: “Xí nó cảc thấy táy luật vé là Ê-li phải tềng tlưởc?” <verse eid="MRK 9:11" /><verse number="12" style="v" sid="MRK 9:12" />Rối Ngái vé côống maáng: "Ê-li tùng là tềng tlưởc tể khôi phục lái tẩt cả cảc việc. Xí xì lới àn chẻp vến Con Moón là Ngái phải chíu nhiếu tiếu tâu khổ ôộng pí khinh thướng là xí nó? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Mơi, thấy vé côống ái ùn là Ê-li tà tềng xật rối, ôộng maáng tà mấn mẳt cớ nó tiếu maáng moành côống ôông, chôồng như lới tà àn chẻp vến ôông."<verse eid="MRK 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Khới tềng tược cảc môn tố cón lái, maáng kỉa mộch đoán dân tôông lặm chung quenh maáng ôộng cảc thấy táy luật tang tlenh luấn côống cảc môn tố rì. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Ngay caá rì, khới tà kỉa Ngái, cả đoán dân ngạc nhiên, ôộng khâu khới chắn tềng côống Ngái, maáng tòn cháo Ngái. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Ngái poi cảc môn tố: “Ái ùn tang tlenh luấn côống maáng vến việc chi?” <verse eid="MRK 9:16" /><verse number="17" style="v" sid="MRK 9:17" />Mộch moón tloong đàm tôông tlả lới Ngái: “Thưa thấy, tôi tom tềng cho thấy lấu con từa của tôi, pí mộch linh câm ềm pao. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Nều tược nó reé cò thể khồng chề con tôi, xì reé vật lấu rẻt xuồng, rối lấu rẻt súi pọt ménh, nghiền xăng, ôộng cừng đơ, tôi tà cườn cảc môn tố thấy tể maáng trục xuẩt reé, mơi maáng chăng tủ nôống." <verse eid="MRK 9:18" /><verse number="19" style="v" sid="MRK 9:19" />Caá ní, khới tlả lới lái maáng, Ngái vé: "Thề hế chăng tin ní, tôi sẻ ở côống tán dâu cho tềng caá nó? Tôi sẻ chíu đứng tán dâu cho tềng caá nó? Hảy tom từa rẻt tềng cho tôi." <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Maáng tom từa rẻt tềng cho Ngái, ôộng khới kỉa Ngái, ảc linh liến mấn lấu rẻt lêng cơn co giật, rối khới pổ xuồng tẩt, reé lăn lốn, súi pọt ménh. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Ngái poi pồ của lấu rẻt: "Tà cớ nó lấn pở khới chuyến ní xảy xa côống xôn?" Ôông tlả lới: "Pở khới cón énh. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Reé cừ hay nèm xôn, caá xì pao lửa, caá xì xuồng rảc, tể huỷ hoái lấu rẻt, mơi nều thấy cò thể mấn àn chi, ví xương xỏt tán tôi, cườn thấy giủp tán tôi." <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Caá rì, Chùa Giê-xu vé côống ôông: “‘Nều thấy cò thể' à? Tẩt cả cảc việc là cò thể đồi côống moón tin.” <verse eid="MRK 9:23" /><verse number="24" style="v" sid="MRK 9:24" />Ngay caá rì, khâu khới rố lêng, pồ của lấu rẻt thưa: "Tôi tin! Cườn thấy cừu giủp tính tláng chăng tin của tôi!" <verse eid="MRK 9:24" /><verse number="25" style="v" sid="MRK 9:25" />Rối khới kỉa đàm tôông tang chắn tềng tược maáng, Chùa Giê-xu vằng ảc linh, truyến cho reé: "Linh câm ôộng tiểc kia, ho xa lếng cho dâu phải xa khỏi từa rẻt ôộng chăng pao giớ àn nhập pao reé nửa." <verse eid="MRK 9:25" /><verse number="26" style="v" sid="MRK 9:26" />Khâu khới rố náy ôộng mấn cho lấu rẻt co giật dử dối, reé xuẩt xa khỏi ôộng lấu rẻt tlở rêng chôồng như moón chểt, tềng nổi nhiếu moón vé xí ní: "Lấu rẻt chểt rối." <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Mơi khới cấm lế xay reé, Chùa Giê-xu tở reé lêng, ôộng lấu rẻt từng dấn. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />Khâu khới Ngái tà ti pao nhá rối, cảc môn tố Ngái poi riêng Ngái xí ní: "Xí nó tán tôi chăng thể trục xuẩt àn linh rì? <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Ngái tlả lới côống maáng: “Loái linh ní, chăng ôông ay cò thể trục xuẩt àn nều chăng pởi sứ cấu nguyến ôộng sứ kiêng ăn.”<verse eid="MRK 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Ôộng pở tược rì xa ti, maáng păng qua púng Ga-li-lê, mơi Ngái chăng moành tể ôông ay hay. <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />ví Ngái tang táy pảo cảc môn tố mếng, ôộng vé côống maáng xí ní: “Con Moón pú pí nộp pao xay maáng, maáng sẻ giểt chểt Ngái. Khới tà pí giểt, Ngái sẻ khôồng lái khâu pa ngáy." <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Mơi maáng chăng hiểu lới ní, ôộng rưởi phải poi Ngái.<verse eid="MRK 9:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Maáng ti tềng thánh Ca-bê-na-um, ôộng khới tà pao tloong nhá, Ngái poi maáng: "Ái ùn tà pán luấn chuyến chi tlêng khà ti?" <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Mơi maáng im lắng, ví maáng tà tlenh luấn côống phố tlêng khà ti hẩu ôông ay là náy nhẩt. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Ôộng khâu khới ngối xuồng, Ngái hôổc mưới han sừ tố tập tlung lái ôộng vé côống maáng: “Nều ôông ay moành mấn tấu, moón rì phải là moón cuồi tloong tẩt cả ôộng là moón hấu việc cho tẩt cả cảc moón." <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Chón lế mộch từa rẻt, Ngái tệch từa rẻt ở chình khừa maáng, rối khâu khới pề từa rẻt tlêng xay, Ngái vé côống maáng: <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />"Moón nó nhân danh thấy tiểp mộch tloong cảc từa rẻt như xí ní xì moón rì tiểp thấy, ôộng nều ôông ay tiểp thấy xì moón rì chăng chỉ tiểp thấy, mơi cón tiểp Tầng khai phài thấy." <verse eid="MRK 9:37" /><verse number="38" style="v" sid="MRK 9:38" />Giăng vé côống Ngái: “Thưa thấy, tán tôi tà kỉa mộch moón rì nhân danh thấy tuổi quỷ ôộng tán tôi tà ngăn moón rì lái, ví moón rì chăng xeo tán ha." <verse eid="MRK 9:38" /><verse number="39" style="v" sid="MRK 9:39" />Mơi Chùa Giê-xu tlả lới: “Má ngăn cản moón rì, ví chăng cò ôông ay là moón nhân danh thấy mấn phẻp lá rối cò thể ngay khâu rì nguyến rủa thấy. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Pởi ôông ay chăng phải là nghịch côống tán ha nghỉa là ủng hố tán ha. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Ví moón nó nhân danh thấy cho ái ùn mộch chèn rảc ví ái ùn xuộc vến Chùa Cừu Thề, xật sứ thấy vé côống ái ùn là moón rì chẳc chằn chăng vẩt phấn thưởng mếng. <verse eid="MRK 9:41" /><verse number="42" style="v" sid="MRK 9:42" />Cón enh nó mấn xa xối lổi cho mộch tloong cảc từa rẻt ní là cảc xôn tin tưởng ở thấy, xì chăng thá đồi côống moón rì, tiếu tổt hơn là reé pí puộc mộch cồn phuú náy quenh cố ken mếng, rối pí nèm xuồng piển. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Nều pán xay ái ùn cò thể mấn cho ái ùn phám xối, hảy chạch reé ti. Tiếu tổt hơn cho ái ùn là côống thương tật mà pao tược sứ khôồng, cón hơn là cò han pán xay mơi phải ti pao hoả ngục, tloong lửa chăng caá nó xẳt. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />(tược rôi rói tán reé chăng chểt, ôộng lửa chăng pí dập xẳt) <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nều pán chõ ái ùn cò thể mấn cho ái ùn phám xối, hảy chạch reé ti. Tiếu tổt hơn cho ái ùn là côống chõ cụt mơi pao tloong tược sứ khôồng, cón hơn là cò han chõ mơi pí nèm pao hoả ngục. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />(tược rôi rói tán reé chăng chểt, ôộng lửa chăng pí dập xẳt) <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nều mẳt ái ùn cò thể mấn cho ái ùn phám xối, hảy voỏc reé xa. Tiếu tổt hơn cho ái ùn là côống mộch mẳt mơi pao tloong vương quổc của Thiên Chùa, cón hơn là cò han mẳt mơi pí nèm pao hoả ngục. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />tược rôi rói tán reé chăng chểt ôộng lửa chăng pí dập xẳt. <verse eid="MRK 9:48" /><verse number="49" style="v" sid="MRK 9:49" />Ví tẩt cả cảc moón sẻ pí vòi pắng lửa. <verse eid="MRK 9:49" /><verse number="50" style="v" sid="MRK 9:50" />Vòi là tổt lénh, mơi nều vòi tlở rêng vẩt chằm, ái ùn sẻ rêm pao reé côống gia ví chi? Ái ùn phải cò vòi tloong mếng, ôộng khôồng hoá thuấn côống phố."<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Khâu khới từng dấn, Ngái ti pở tược rì tềng púng Giu-đê ôộng púng tẩt táng kia khôông Giô-đanh, rối dân chùng kèo phố tềng côống Ngái lấn nửa. Ngái lái táy pảo maáng như Ngái vẩn hay mấn. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Khới cảc moón Pha-ri-si tềng khênh, maáng poi Ngái là luật cò cho phẻp mộch moón chầu ly dí du hay chăng, tể thử Ngái. <verse eid="MRK 10:2" /><verse number="3" style="v" sid="MRK 10:3" />Mơi, tể tlả lới lái, Ngái vé côống maáng xí ní: "Môi-se tà truyến táy cảc ôông tiếu chi?" <verse eid="MRK 10:3" /><verse number="4" style="v" sid="MRK 10:4" />Maáng vé: “Môi-se cho phẻp moón chầu viểt đơn ly dí rối tể du xa ti.” <verse eid="MRK 10:4" /><verse number="5" style="v" sid="MRK 10:5" />Mơi Chùa Giê-xu vé côống maáng: “Ví sứ cừng loóng của cảc ôông, nọ mời viểt xa tiếu luật rì cho cảc ôông. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Mặt khảc, pở thuở pan tấu của cuộc sàng táo, 'Ngái tà tứng rêng maáng, mộch từa ôộng mộch cài.'<verse eid="MRK 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MRK 10:7" />Pởi lỳ do rì, moón tán ôông sẻ lía pồ ôộng mế mếng, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />ôộng han moón sẻ àn rêng mộch xịt.’</para>
  <para style="p" vid="MRK 10:8">Cho rêng, maáng chăng cón là han mơi là mộch xịt. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Pởi rì, tiếu chi mà Thiên Chùa tà kểt hiệp lái, xì con moón má phân rẻ." <verse eid="MRK 10:9" /><verse number="10" style="v" sid="MRK 10:10" />Khới ở tloong nhá, cảc môn tố lái poi Ngái vến việc ní. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ngài vé côống maáng: “Moón nó ly dí du mếng ôộng cười mộch moón khảc, xì moón rì phám xối ngoái tính đồi côống du mếng. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Ôộng nều moón phú nử, khới tà ly dí chầu mếng, lế moón khảc, xì vaá phám xối ngoái tính."<verse eid="MRK 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Maáng tom tềng cho Ngái cảc con rẻt tể Ngái cò thể tệch xay tlêng phề, mơi cảc môn tố khiển tlẻch maáng. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Mơi, khới hẩu kỉa tiếu rì, Chùa Giê-xu giấn ôộng vé côống maáng: "Hảy tể cảc xôn énh tềng côống thấy, ôộng má ngăn cản phề, ví vương quổc của Thiên Chùa xuộc vến ôông ay chôồng như phề. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Xật sứ, thấy vé côống ái ùn, moón nó chăng tiểp nhấn vương quổc của Thiên Chùa chôồng mộch con rẻt, xì moón rì chẳc chằn chăng àn pao tloong rì." <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Khâu khới pề cảc từa rẻt tloong voóng xay mếng, tệch xay tlêng phề, Ngái pan phưởc cho.<verse eid="MRK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Khới Ngái pẳt tấu lêng khà, mộch moón rì chắn tềng, ôộng khâu khới quý xuồng tlưởc Ngái, moón rì poi Ngái: "Thưa Thấy Nhân Lénh, tôi cấn mấn chi tể tôi cò thể hưởng sứ khôồng tới tới?" <verse eid="MRK 10:17" /><verse number="18" style="v" sid="MRK 10:18" />Mơi Chùa Giê-xu vé côống ái: “Rêng nó ái hôổc tôi là nhân lénh? Chăng ôông ay nhân lénh tlứ xa mộch mếng Thiên Chùa. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ái tà mẳt cảc tiếu răn: 'má giểt moón, má ngoái tính, má ăn lốm, má mấn chừng lẻo, má lứa gạt, phải tôn kình pồ ôộng mế mếng'." <verse eid="MRK 10:19" /><verse number="20" style="v" sid="MRK 10:20" />Mơi ái ha vé côống Ngái: “Thưa thấy, tôi tà tuân giử tẩt cả cảc tiếu rì pở khới énh của tôi." <verse eid="MRK 10:20" /><verse number="21" style="v" sid="MRK 10:21" />Mơi khới hẩu ái, Chùa Giê-xu yêu quỳ ái, ôộng Ngái pảo ái: "Ái cón xiều mộch tiếu; hảy ti, paành hểt tẩt cả cảc xừ mếng cò, pan phảt cho moón nghéo, xì ái sẻ cò kho bầu ở tlêng tlới, ôộng tềng ní rạ, hảy xeo tôi." <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Mơi nẻt mặt tlở rêng chàn nản tlưởc lới rì, ái ha tâu puốn lảc ti, ví ái vồn tang cò nhiếu của cải lặm.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Khâu khới hẩu chung quenh, Chùa Giê-xu vé côống môn tố mếng: "Xật khò cớ nó đồi côống cảc moón cò nhiếu của cải tể àn pao tloong vương quổc của Thiên Chùa!" <verse eid="MRK 10:23" /><verse number="24" style="v" sid="MRK 10:24" />Cảc môn tố rẩt sửng sổt vến cảc lới của Ngái, mơi mộch lấn nửa, khởi vé tiểp, Chùa Giê-xu vé côống maáng xí ní: "Cảc con ời, xật là khò cớ nó tể pao tloong vương quổc của Thiên Chùa! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Đồi côống con lạc đá chun qua lồ kim, rì là chuyến lời hơn đồi côống moón chấu pao tloong vương quổc của Thiên Chùa." <verse eid="MRK 10:25" /><verse number="26" style="v" sid="MRK 10:26" />Rối maáng rẩt là sửng sổt, vé côống Ngái: "Xí xì ôông ay cò thể àn cừu?" <verse eid="MRK 10:26" /><verse number="27" style="v" sid="MRK 10:27" />Hẩu pao maáng, Chùa Giê-xu pảo: "Tiếu chăng thể àn côống loái moón, mơi chăng phải côống Thiên Chùa. Ví côống Thiên Chùa, tẩt cả cảc việc tếu cò thể." <verse eid="MRK 10:27" /><verse number="28" style="v" sid="MRK 10:28" />Phi-e-rơ lêng xiềng thưa côống Ngái: “Thấy hẩu rạ, tán tôi tà lảc tẩt cả cảc xừ mà xeo thấy.” <verse eid="MRK 10:28" /><verse number="29" style="v" sid="MRK 10:29" />Chùa Giê-xu tlả lới: “Xật sứ, thấy vé côống ái ùn, chăng cò moón nó lảc ti nhá cửa, ái ùn, ới ùn, pồ mế, con cài, tẩt caảt ví pởi thấy ôộng Tin Lénh, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />mà chăng nhấn àn gẩp tlăm lấn caá ní toong thới ký ní: vến nhá cửa, ái ùn, ới ùn, mế, con, tẩt roóng côống sứ pẳt pờ, ôộng sứ khôồng tới tới tloong thới đái tương lai. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Mơi cò nhiếu moón tấu sẻ tlở rêng cuồi, ôộng moón cuồi sẻ lêng tấu."<verse eid="MRK 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Caá ní, maáng tang tlêng khà ti lêng tềng Giê-ru-sa-lem, ôộng Chùa Giê-xu tang ti tlưởc maáng. Maáng ngạc nhiên, cón cảc moón ti xeo khâu xì rưởi lặm. Khâu khới tom mưới han sừ tố riêng xa, Ngái lái pẳt tấu vé côống maáng vến cảc việc pú xảy tềng cho Ngái, <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />xí ní: “Hẩu ní, tán ha tang ti lêng tềng Giê-ru-sa-lem, ôộng Con Moón sẻ pí nộp cho cảc thấy tề lể cả ôộng cảc thấy táy luật, rối maáng sẻ kểt àn tử hính Ngái ôộng giao Ngái cho moón ngoái quổc. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Maáng sẻ chề nháo Ngái, chù rảc dài pao Ngái, tành roi Ngái, ôộng giểt chểt Ngái, mơi khâu pa ngáy Ngái sẻ khôồng lái."<verse eid="MRK 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Gia-cơ ôộng Giăng, han con từa của Xê-bê-đê, tềng tốn Ngái, vé côống Ngái: “Thưa thấy, tán tôi ưởc ao là nều tiếu chi tán tôi cườn thấy, thấy sẻ mấn cho tán tôi." <verse eid="MRK 10:35" /><verse number="36" style="v" sid="MRK 10:36" />Rối Ngái vé côống maáng: "Ái ùn moành thấy mấn chi cho ái ùn?" <verse eid="MRK 10:36" /><verse number="37" style="v" sid="MRK 10:37" />Xí là maáng thưa côống Ngái: “Cườn tệch tể tán tôi xí nó cho tán tôi cò thể ngối tloong tược vinh hiển của thấy, mộch moón táng chăm thấy ôộng mộch moón táng chiêu thấy." <verse eid="MRK 10:37" /><verse number="38" style="v" sid="MRK 10:38" />Mơi Chùa Giê-xu pảo maáng: “Ái ùn chăng mẳt mếng tang cườn tiếu chi. Ái ùn cò thể oòng chèn mà thấy oòng, hay là chíu báp-têm như phẻp báp-têm mà thấy chíu chăng?” <verse eid="MRK 10:38" /><verse number="39" style="v" sid="MRK 10:39" />Maáng thưa côống Ngái: “Tán tôi cò thể." Rối Chùa Giê-xu vé côống maáng: "Chèn mà thấy oòng, ái ùn sẻ oòng, ôộng phẻp báp-têm mà thấy chíu, ái ùn sẻ chíu. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Mơi tể ngối táng chăm hay táng chiêu của thấy xì chăng pởi thấy cho àn, mơi tể cho moón tà àn chuẩn pí khẳn." <verse eid="MRK 10:40" /><verse number="41" style="v" sid="MRK 10:41" />Khới măng việc ní, mưới sừ tố kia rổi giấn côống Gia-cơ ôộng Giăng. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Khâu khới hôổc maáng tềng, Chùa Giê-xu vé côống maáng: "Ái ùn mẳt là cảc moón àn tôn cai tlí moón ngoái quổc xì đán ảp dân chùng, ôộng cảc moón cò chửc quyến của maáng xì sử dúng quyến hánh cưởng chề maáng. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Mơi sứ việc chăng phải là như xí khừa voóng ái ùn. Ngược lái, moón nó moành tlở rêng náy khừa voóng ái ùn sẻ phải là moón phục vuú của ái ùn, <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />ôộng moón nó moành là tấu khừa voóng ái ùn sẻ phải là nô lế cho tẩt cả cảc moón. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Ví Con Moón thấm chì tà chăng tềng tể àn phục vuú, mơi là tể phục vuú ôộng dơng maáng khôồng mếng mấn già chuộc thay cho nhiếu moón."<verse eid="MRK 10:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Maáng ti pao thánh Giê-ri-cô, ôộng tloong caá Ngái tang ti xa pở Giê-ri-cô côống cảc môn tố mếng ôộng đoán dân tôông, xì Ba-ti-mê, con từa của Ti-mê, là mộch moón ăn máy mú tang ngối pêng khà. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Khới măng àn là rì là Chùa Giê-xu moón Na-xa-rét, ái pẳt tấu rố náy ôộng vé: "Hớ Giê-xu, Con vua Đa-vít, cườn xương xỏt tôi!" <verse eid="MRK 10:47" /><verse number="48" style="v" sid="MRK 10:48" />Nhiếu moón tlẻch vằng ái ní tể ái im lắng, mơi ái rố caáng náy hơn nửa: "Con vua Đa-vít, cườn xương xỏt tôi!" <verse eid="MRK 10:48" /><verse number="49" style="v" sid="MRK 10:49" />Khâu khới dứng lái, Chùa Giê-xu vé: "Hảy hổổc ái rì." maáng hôổc ái mú rì, pảo ái: "Hảy yên tâm! Từng dấn ti! Thấy tang hôổc ái." <verse eid="MRK 10:49" /><verse number="50" style="v" sid="MRK 10:50" />Rối khới nèm ào choáng mếng qua mộch táng, từng pật lêng, ái tềng côống Chùa Giê-xu. <verse eid="MRK 10:50" /><verse number="51" style="v" sid="MRK 10:51" />Tlả lới côống ái, Chùa Giê-xu vé: "Ái moành tôi mấn chi cho ái?" Xí là moón mú thưa côống Ngái: "Ra-bi, rì là tôi cò thể hẩu kỉa." <verse eid="MRK 10:51" /><verse number="52" style="v" sid="MRK 10:52" />Xí là Chùa Giê-xu vé côống ái: “Hảy ti. Đửc tin của ái tà chửa lénh cho ái.” Lập tửc, ái hẩu kỉa àn rối ái ti xeo Ngái tlêng khà.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Khới maáng ti khênh tềng Giê-ru-sa-lem, pao Bê-pha-giê ôộng Bê-tha-ni, hường vến nùi Ô-liu, Ngái khai han môn tố của mếng ti, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ôộng vé côống maáng: “Hảy ti pao cày láng tlưởc mặt ái ùn, ngay khới pao tềng rì, ái ùn sẻ kỉa mộch lứa con pí tanh, chưa tững cò ôông ay rôông tlêng reé. Hảy vở khái puộc cho reé ôộng tom reé vến ní. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Nều ôông ay rì poi ái ùn: ‘Rêng nó cảc ái mấn như xí?’ xì hảy tlả lới là: ‘Chùa cò việc cẫn dúng reé ôộng Ngái sẻ cởi tlả reé lái ở ní ngay.’” <verse eid="MRK 11:3" /><verse number="4" style="v" sid="MRK 11:4" />Maáng ti khỏi ôộng kỉa mộch lứa con pí tanh ngay cửa vái pêng khà, rêng maáng vở khái cho reé. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />Mầy moón từng rì vé côống maáng: "Han ái tang mấn chi mà vở khái puộc lứa con rì? <verse eid="MRK 11:5" /><verse number="6" style="v" sid="MRK 11:6" />Maáng tlả lới lái mầy moón rì như Chùa Giê-xu tà pảo, ôộng cảc moón rì tể cho maáng ti. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Maáng tom lứa con vến cho Chùa Giê-xu rối tlải ào choáng mếng tlêng reé, ôộng Ngái ngối lêng rì. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Nhiều moón tlải ào maáng xa tlêng khà, cón côống moón khảc, xì tlải cảc nhènh câl tà chạch pở vái tôống. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Cả cảc moón ti tlưởc ôộng cảc moón xeo khâu rố náy:</para>
  <para style="q" vid="MRK 11:9">“Hô-sa-na! Đàng ca ngới Tầng ngứ tềng nhân danh Chùa.<verse eid="MRK 11:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MRK 11:10" />Phưởc thay vương quổc sẻ tềng của tổ tiên Đa-vít tán ha! Hô-sa-na tloong tược cao nhẩt!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Ngái tà ti pao thánh Giê-ru-sa-lem, pao tloong tến thớ, ôộng khới tà hẩu chung quenh tẩt cả cảc xừ, ví giớ rì yý khênh xồn rối, Ngái ti xa tềng Bê-tha-ni côống mưới han sừ tố. <verse eid="MRK 11:11" /><verse number="12" style="v" sid="MRK 11:12" />Ngáy hôm khâu, caá maáng tà ti xa khỏi Bê-tha-ni, xì Ngái tòi. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Khới hẩu kỉa mộch câl vả cò nhiếu là pở táng giang, Ngái tềng, cò thể Ngái sẻ xím kỉa cò tlày nó tlêng câl chăng. Mơi caá tà tềng tược câl rì, Ngái chăng kỉa cò chi tlứ xa là, ví chưa phải là múa vả. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Tể lái chuyến ní, Ngái phàn côống câl rì: "Sẻ chăng pao giớ cón ôông ay ăn tlày pở tược dâu nửa." Cảc môn tố Ngái măng lới rì.<verse eid="MRK 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Khới ti tềng Giê-ru-sa-lem, ôộng pao tloong tến thớ, Ngái pẳt tấu tuổi moón paành moón mua tloong tến thớ xa vái, Ngái lật tổ pán của cảc moón tổi xiến ôộng ghề của cảc moón paành chim cú cu, <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Ngái chăng cho phẻp pẩt cừ ôông ay tom háng hòa ti qua tến thớ. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Rối Ngái táy maáng ôộng vé: "Chăng phải cò lới chẻp xí ní:</para>
  <para style="q" vid="MRK 11:17">‘Nhá ho sẻ àn hôổc là nhá cấu nguyến cho tẩt cả cảc dân tộc’ à?</para>
  <para style="q" vid="MRK 11:17">Mơi tán dâu tà piền reé xa hang ổ của tán cưởp.”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Cảc thấy tề lể cả ôộng thấy táy luật măng như xí, xì maáng xím cảch mà maáng cò thể giểt Ngái, ví maáng rưởi Ngái, pởi cả đoán dân tếu sửng sổt vến sứ táy pảo của Ngái. <verse eid="MRK 11:18" /><verse number="19" style="v" sid="MRK 11:19" />Tềng khới khuống xồn, maáng ti khỏi thánh<verse eid="MRK 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Pao pan khờm, tang khới ti ngang qua, maáng kỉa câl vả tà khô hèo pở côổc rè. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Khâu khới căắn lái, Phi-e-rơ thưa côống Ngái: "Ra-bi, hẩu rạ! Câl vả mà thấy rủa tà khô hèo rối." <verse eid="MRK 11:21" /><verse number="22" style="v" sid="MRK 11:22" />Khới tlả lới lái, Chùa Giê-xu vé côống maáng: "Hảy cò đửc tin ở Thiên Chùa. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Xật sứ, thấy vé côống ái ùn, là moón nó vé côống ngón nùi ní: ‘Hãy dôổc lêng ôộng lao xuồng piển,' mà chăng nghi ngớ tloong loóng mếng, mơi tin là tiếu mếng vé pú diển xa, xì việc sẻ àn cho moón rì. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Pởi xí, thấy vé côống ái ùn, tẩt cả cảc tiếu ái ùn cấu nguyến ôộng nái cườn, hảy tin là ái ùn tà nhấn àn, xì tiếu rì sẻ thánh cho ái ùn. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Khới ái ùn từng cấu nguyến, nều ái ùn cò chuyến nghịch côống ôông ay rì, xì hảy tha xừ, tể Cha của ái ùn là Tầng ở tlêng tlới yý tha xừ ái ùn vến cảc vi phám của ái ùn." <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />(Mơi nều ái ùn chăng tha xừ, xì Cha của ái ùn là Tầng ở tlêng tlới yý sẻ chăng tha xừ cảc vi phám của ái ùn)<verse eid="MRK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Rối maáng lái ti tềng Giê-ru-sa-lem ôộng khới Ngái tang ti tloong tến thớ, cảc thấy tề lể cả, cảc thấy táy luật, ôộng cảc tlưởng lảo tềng côống Ngái. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Maáng vé côống Ngái: “Pởi thẩm quyến nó mà ôông mấn cảc việc rì ôộng ôông ay tà giao cho ôông thẩm quyến ní tể ôông cò thể mấn cảc tiếu rì?" <verse eid="MRK 11:28" /><verse number="29" style="v" sid="MRK 11:29" />Mơi Chùa Giê-xu vé côống maáng: “Tôi yý sẻ poi cảc ôông mộch câu, ôộng hảy tlả lới tôi, rối tôi sẻ vé cho cảc ôông pởi thẩm quyến nó mà tôi mấn cảc việc rì. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Phẻp báp-têm của Giăng là pở tlới hay pở con moón? Hảy tlả lới tôi. <verse eid="MRK 11:30" /><verse number="31" style="v" sid="MRK 11:31" />Maáng pán luấn côống phố xí ní: “Tán ha rêng tlả lới như xí nó? Nều tán ha vé: ‘Pở tlới’ xì moón ní sẻ pảo: ‘Nều xí, ví xí nó cảc ôông chăng tin Giăng?’’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ngược lái, nều tán ha vé: ‘Pở con moón,’ ...” Tán phề rưởi dân chùng, ví ôông ay yý kỉa là Giăng xật sứ là mộch tiên tli. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Rêng khới tlả lới Chùa Giê-xu, maáng vé: "Tán tôi chăng mẳt." Chùa Giê-xu vé côống maáng: "Tôi yý chăng vé côống cảc ôông pởi thẩm quyến nó mà tôi mấn cảc việc rì."<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Ngái pẳt tấu vé côống maáng pắng ẩn dú: “Mộch moón kia tlôông vướn nho, tứng rão chung quenh, táo hấm ẻp ráo, xây mộch thảp kenh, ôộng cho cảc moón tlôông nho xê lái vướn, rối lêng khà ti giang. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Tềng múa thu hoạch, ôông khai mộch moón hấu tềng tốn tán tlôông nho tể pở cảc moón ní, ôông cò thể nhấn mộch phấn hoa mấu của vướn. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Mơi khâu khới giử lế ái ha, tán phề tành tẩp rối tuổi vến xay rỏ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Ôông lái khai mộch moón hấu khảc tềng côống tán phề, ôộng côống moón rì, phề tành pao tlổc ôộng sỉ nhục. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Rối ôông khai moón hấu khảc nửa, côống moón rì, tán phề giểt chểt, ôộng côống nhiếu moón khảc — caá tành tập moón ní, khới sảt hái moón kia. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Ôông cò mộch moón nửa, là enh con từa yêu dầu, ôông khai ái rì, moón cuồi cúng, tềng côống tán phề, nghỉ xí ní: "Tán phề sẻ kiêng nể con từa mếng." <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Mơi tán tlôông nho rì pán côống phố xí ní: “Ní là enh thứa kề. Ti rạ, tán ha hảy giểt reé, rối tái sản thứa kề sẻ là của tán ha." <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Xí là khâu khới pẳt giử, tán phề giểt enh con rì, rối nèm ái xa khà vái vướn nho. <verse eid="MRK 12:8" /><verse number="9" style="v" sid="MRK 12:9" />Xí rêng, chủ vướn nho sẻ mấn chi? Ôông sẻ tềng tiêu diệt tán tlôông nho ôộng giao vướn nho cho cảc moón khảc. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Cảc ôông chưa toọc lới ní tloong Kinh Thành à?</para>
  <para style="q" vid="MRK 12:10">‘Viên phú mà thớ xây nhá lảc ti,</para>
  <para style="q" vid="MRK 12:10">phú rì tà àn tlở rêng phú goỏc nhá.<verse eid="MRK 12:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MRK 12:11" />Việc ní tềng pở Chùa</para>
  <para style="q" vid="MRK 12:11">ôộng rì là việc diếu ký tloong mẳt tán ha.”<verse eid="MRK 12:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MRK 12:12" />Xí là maáng xím cảch pẳt Ngái mơi maáng rưởi dân chùng, ví maáng hiểu là Ngái kể ẩn dú rì chỉ pao maáng. Rêng khới ti khỏi Ngái, maáng lảc ti.<verse eid="MRK 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Rối maáng cử mầy moón xuộc nhòm Pha-ri-si ôộng xuộc đảng Hê-rốt tềng côống Ngái tể tán phề pẳt lổi Ngái tloong lới khề. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Khới tềng, maáng vé côống Ngái: "Thưa thấy, tán tôi mẳt là thấy là moón tlung thực ôộng ở thấy, chăng cò chuyến chiếu xeo pẩt cừ ôông ay, ví thấy chăng hẩu pao khà vái của maáng, thay pao rì, thấy táy pảo ỳ moành của Thiên Chùa tùng xeo chân lỳ. Cò tùng luật hay chăng khới nộp thuề cho Xê-xa? Tán ha rêng nộp hay chăng rêng nộp?" <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Mơi ví mẳt sứ đáo đửc giả của maáng, Ngái vé côống maáng: "Xí nó cảc ôông lái xử tôi? Hảy tom cho tôi mộch đơ-ni-ê tể tôi hẩu." <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Xí là maáng tom tềng mộch tôống. Rối Ngái vé côống maáng: "Hính ôộng danh hiếu ní là của ôông ay?" Maáng thưa côống Ngái: "Của Xê-xa." <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Caá ní, Chùa Giê-xu truyến pảo maáng: "Hảy tlả cho Xê-xa cày chi của Xê-xa, ôộng tlả cho Thiên Chùa cày chi của Thiên Chùa." Maáng tếu ngạc nhiên tlưởc Ngái.<verse eid="MRK 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Rối tán moón Sa-đu-sê, là cảc moón vé là chăng cò sứ khôồng lái, tềng côống Ngái ôộng poi Ngái, xí ní: <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Thưa thấy, Môi-se tà viểt cho tán ha xí ní: 'Nều ái của mộch ôông ay rì chểt ti tể lái du mơi chưa cò con, xì ùn của moón ái phải lế moón du rì ôộng nồi dỏi cho ái mếng.' <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Cò pảy ái ùn ní; moón ái cả lế du rối chểt, chăng có con, <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ái xừ han cười ới du, rối chểt, chăng cò con. ôộng ái xừ pa yý xí. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Cả pảy moón tếu chăng cò con. Khâu tẩt cả, moón phú nử yý chểt. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Tềng ký phục sinh, khới maáng khôồng lái, ới kia sẻ là du của ôông ay tloong sồ maáng? Ví pảy moón tếu tà lế ới rì mấn du." <verse eid="MRK 12:23" /><verse number="24" style="v" sid="MRK 12:24" />Chùa Giê-xu vé côống maáng: "Chăng phải cảc ôông pí tảch ti phảng khà pởi tiếu ní à, ví chăng hiểu àn Kinh Thành yý như quyến năng của Thiên Chùa? <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Ví khới maáng pở cày chểt khôồng lái, maáng chăng cười hay gả, mơi maáng sẻ chôồng như cảc thiên sừ tlêng tlới. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Cón vến việc moón chểt àn khôồng lái, chăng lẻ cảc ôông chưa toọc tloong sảch của Môi-se, ở phấn thuật lái vến púi khoóng, xí nó mà Thiên Chùa phàn côống ôông là: "Ho là Thiên Chùa của Áp-ra-ham, Thiên Chùa của Y-sác, ôộng Thiên Chùa của Gia-cốp'? <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ngái chăng phải là Thiên Chùa của moón chểt, mơi là của moón khôồng. Cảc ôông tang vẳc lổi lấm rẩt náy.”<verse eid="MRK 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Khới mộch tloong cảc thấy táy luật tà tềng khênh, măng àn maáng tang tlenh luấn côống phố, kỉa là Ngái tlả lới cảc moón kia rẩt hay, xì ôông poi Ngái: "Tiếu nó là tiếu răn quan tlóng nhẩt tloong tẩt cả?" <verse eid="MRK 12:28" /><verse number="29" style="v" sid="MRK 12:29" />Chùa Giê-xu tlả lới xí ní: “Tiếu răn quan tlóng nhẩt là: ‘Hớ Y-sơ-ra-ên, hảy măng ní, Chùa, Thiên Chùa tán ha, là Chùa duy nhẩt. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Con phải yêu kình Chùa là Thiên Chùa của con côống hểt cả tầm loóng mếng, côống hểt cả linh hốn mếng, côống hểt cả tâm tlì mếng, ôộng côống hểt cả khửc lực mếng.' <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Tiếu răn xừ han là ní: ‘Con phải yêu xương moón lân cấn của con như pản xân mếng.’ Chăng cò tiếu răn nó khảc náy hơn han tiếu rì.” <verse eid="MRK 12:31" /><verse number="32" style="v" sid="MRK 12:32" />Thấy táy luật vé côống Ngái: “Tùng rối, thưa thấy! Thấy tà vé xeo lẻ xật là Ngái là duy nhẩt, ôộng chăng cò chùa nó khảc tlứ xa Ngái. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kình yêu Ngái pắng cả tầm loóng, côống tẩt cả tlì khôn, côống ôộng tẩt cả khửc lực, ôộng yêu xương moón lân cấn như chình mếng thấm chì cò già tlí hơn tẩt cả của lể thiêu ôộng sinh tề.” <verse eid="MRK 12:33" /><verse number="34" style="v" sid="MRK 12:34" />Khâu khới hẩu ôông, ví ôông tà tlả lới lái cảch khôn ngoan, Chùa Giê-xu vé côống ôông: "Ôông chăng ở giang khỏi vương quổc của Thiên Chùa nó." Ôộng chăng ôông ay cón ràm poi Ngái nửa.<verse eid="MRK 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Tể tlả lới, caá tang giảng táy tloong sân tến thớ, Chùa Giê-xu vé: "Mấn xí nó cảc thấy táy luật pảo là Chùa Cừu Thề là con vua Đa-vít? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Chình vua Đa-vít, tloong Chùa Thành Linh, tà vé:</para>
  <para style="q" vid="MRK 12:36">‘Chùa phán côống Chùa tôi:</para>
  <para style="q" vid="MRK 12:36">“Hảy ngối khà chăm Ho,</para>
  <para style="q" vid="MRK 12:36">cho tềng khới nó Ho tệch cảc keẻ thú Con tìn chõ của Con.”’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />Chình vua Đa-vít hôốc Ngái là ‘Chùa,’ xì mấn xí nó Ngái là con của vua rì àn?" Đoán dân tôông tlằng Ngái cảch phui mứng.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Tloong sứ giảng táy của mếng, Ngái pảo: "Hảy cẩn thấn côống cảc thấy táy luật, là cảc enh ưa moành ti từng tloong pố ào dán, cảc lới poi cháo khừa phồ chớ, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />tược ngối vinh dứ tloong nhá hối côống tược háng tấu ở đàm tiệc. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Cảc moón rì roảch nhá của mú goà, mấn giả toó cấu nguyến dán doóng. Tán moón ní sẻ chíu pản àn nghiêm khẳc hơn."<verse eid="MRK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Rối khới tà ngối xuồng đồi ngang tược tể hộp tứng xiến dơng của tến thớ, Ngái hẩu dân chùng tla xiến pao hộp như xí nó. Nhiếu moón chấu tla pao cảc khoản xiến náy. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Khới mộch mú goà nghéo ti tềng, mú tla pao han tôống xiến énh, già tlí tương đương là mộch xu. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Khâu khới hôổc cảc môn tố của mếng lái, Ngái vé côống maáng: "Xật sứ, thấy vé côống ái ùn là mú goà nghéo ní tà dơng nhiếu hơn tẩt cả cảc moón tà tla xiến pao hộp kia. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Ví tẩt cả maáng tếu dơng pở sứ dư giả của mếng, mơi mú rì, pở tloong sứ nghéo khò của mếng, tà dơng hểt tẩt cả mú cò, nghỉa là tẩt cả cảc xừ tể ruôi khôồng mếng."<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Khới Ngái tang ti khỏi tến thớ, mộch tloong cảc môn tố Ngái thưa côống Ngái: "Thấy ời, hẩu rạ! Cảc tảng phuú to náy mẳt cớ nó ôộng cảc tóa nhá oai xí nó!" <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Chùa Giê-xu vé côống môn tố rì: “Ái kỉa cảc tóa nhá nguy nga ní vảy? Sẻ chăng cón sỏt mộch khồi phuú nó ở ní àn tể chấn tlêng khồi phuú khảc mà phuú rì sẻ chăng pí phà tổ."<verse eid="MRK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Ôộng khới Ngái tang ngối tlêng nùi Ô-liu đồi ngang tến thớ, Phi-e-rơ, Gia-cơ, Giăng ôộng Anh-rê poi riêng Ngái: <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Cườn thấy vé cho tán tôi, caá nó cảc việc rì sẻ diển xa? Ôộng cò dầu hiếu chi khới tẩt cả cảc tiếu rì pú àn ừng nghiếm?” <verse eid="MRK 13:4" /><verse number="5" style="v" sid="MRK 13:5" />Caá ní, Chùa Giê-xu lêng xiềng vé côống maáng: "Hảy cẩn thấn, má tể ôông ay tưa tảch ái ùn ti phảng khà. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Nhiếu moón sẻ tềng nhân danh thấy, vé xí ní: ‘Là ho ní,’ ôộng maáng sẻ tảch nhiếu moón ti phảng khà. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Cón khới ái ùn măng vến chiền tlanh ôộng tin đốn vến chiền tlanh, xì má rưởi; tiếu rì phải diển xa, mơi chưa phải là cuồi cúng. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Ví dân ní sẻ rổi dấn chôồng lái dân khảc, ôộng nưởc ní chôồng lái nưởc kia. Sẻ cò tôống tẩt ở nhiếu tược, sẻ cò nhiếu nán tòi. Cảc việc rì là khởi tấu của cảc cơn tâu teẻ.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Mặt khảc, chình ái ùn phải cẩn thấn. Maáng sẻ nộp ái ùn cho hối đống ôộng cho nhá hối, ái ùn sẻ pí tành tẩp, sẻ từng tlưởc moón cấm quyến ôộng cảc vua pởi ví thấy, như mộch lới chừng cho maáng. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ôộng tlưởc hểt, Tin Lénh phải àn rao giảng cho tẩt cả cảc dân tộc. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Khới maáng pẳt giải ái ùn ti giao nộp, má lo vến lới mếng phải vé. Mơi, nều lới nó àn pan cho ái ùn tloong giớ rì, xì hảy vé lới rì; ví ái ùn chăng phải là moón tang vé, mơi là Chùa Thành Linh. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Ái sẻ nộp ùn pao tược chểt, pồ xì nộp con. Rối con cài sẻ rổi dấn chồng đồi pồ mế ôộng mấn maáng pí giểt ti. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ái ùn sẻ pí tẩt cả cảc moón thú khẻt ví danh của thấy. Mơi ôông ay pến loóng cho tềng cuồi cúng, moón rì sẻ àn cừu.<verse eid="MRK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Mặt khảc, khới ái ùn kỉa sứ gờm ghiểc của cảnh hoang tán diển xa ở tược chăng rêng cò (moón toọc phải hiểu), xì ôông ay ở tái púng Giu-đê hảy chắn tlồn lêng nùi, <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />cón ôông ay ở tlêng mài nhá, má xuồng yý má pao tloong tể lế pẩt ký xừ chi xa khỏi nhá mếng, <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />ôộng ôông ay ở vái tôống, má quay tlở vến côống cảc xừ cón khà khâu tể lế ào khoảc của mếng. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Mơi khồn khổ thay cho phú nử tang cò chửa ôộng phú nử cho con ù tloong cảc ngáy rì! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Ngược lái, hảy cấu nguyến tể việc rì chăng diển xa pao múa đông. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ví tloong cảc ngáy rì sẻ cò hoán nán tềng mửc chưa tững cò như xí kể pở thới pan tấu sàng thề, là khới Thiên Chùa mấn rêng muôn vật cho tềng nay, ôộng yý sẻ chăng pao giớ cò nửa. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Ôộng nều Chùa chăng rủt pằn cảc ngáy rì, tẩt cả xảc xịt sẻ chăng àn cừu. Mơi ví pởi cảc moón àn chón, là cảc moón Ngái tà chón, Ngái cảch giảm cảc ngáy rì. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Caá rì, nều ôông ay rì vé côống ái ùn: ‘Hẩu rạ, Chùa Cừu Thề ở ní! Hẩu rạ, ở táng kia!' xì má tin. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Ví chùa cừu thề giả ôộng tiên tli giả sẻ àn rổi lêng, rối sẻ mấn xa cảc dầu ký ôộng phẻp lá tể, nều cò thể, mấn cho lấm lạc cảc moón àn chón. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Mơi ái ùn phải cẩn thấn! Hảy hẩu rạ, thấy tà cho ái ùn mẳt tlưởc tẩt cả cảc việc rối.<verse eid="MRK 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Mơi, pao cảc ngáy rì, khâu cơn hoán nán rì,</para>
  <para style="q" vid="MRK 13:24">mặt tlới sẻ xồn dấm, mặt tlăng sẻ chăng chiều xa ènh tlàng ở reé;<verse eid="MRK 13:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="MRK 13:25" />cảc ngôi khao sẻ pở tlới rúng xuồng,</para>
  <para style="q" vid="MRK 13:25">ôộng cảc thề lực tlêng tlới sẻ pí rung chuyển.<verse eid="MRK 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26" />Caá ní, maáng sẻ kỉa Con Moón côống quyến năng ôộng vinh hiển vỉ đái ngứ tềng khừa cảc đàm mân. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Khâu rì, Ngái sẻ khai phài cảc thiên sừ ôộng Ngái sẻ tập tlung lái cảc moón àn chón của Ngái khồm pồn phương, pở cuồi tẩt cho tềng cuồi tlới.<verse eid="MRK 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Mặt khảc, hảy hoọc cho hay ẩn dú pở câl vả. Khới nhènh reé tlở rêng mếm ôộng xa là rối, ái ùn mẳt là múa hé tà khênh. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Yý như xí, khới ái ùn kỉa cảc việc rì diển xa, ái ùn hay là Ngái tang ở khênh, ngay tlưởc cửa. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Xật sứ, thấy vé côống ái ùn là thề hế ní chẳc chằn sẻ chăng qua ti cho tềng khới nó tẩt cả cảc việc rì diển xa. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Tlới ôộng tẩt sẻ qua ti, mơi cảc lới của thấy chẳc chằn sẻ chăng qua ti. <verse eid="MRK 13:31" /><verse number="32" style="v" sid="MRK 13:32" />Cón vến ngáy rì hay giớ rì, tlứ xa Cha, xì chăng ôông ay hay àn, ngay cả cảc thiên sừ tlêng tlới yý chăng, ôộng Con yý xí.<verse eid="MRK 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 13:33" />Hảy cẩn tlóng! Hảy tỉnh tào ôộng cấu nguyến ví ái ùn chăng hay thới giớ rì là khới nó. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Chôồng như mộch moón kia lêng khà ti giang nhá, khới tà ti khỏi nhá mếng, ôộng tà giao cho mổi moón hấu mếng quyến cai quản côông việc của mếng, xì ôông xa lếng moón gảc cửa là moón rì cấn phải tỉnh tào; <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />pởi xí, hảy tỉnh tào, ví ái ùn chăng hay khới nó chủ nhá vến tềng – hoặc pao khuống xồn, hay caá nửa têm; hay là khới kha cằn hay pao puổi khờm; <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />rưởi là khâu khới pẩt ngớ vến tềng, chủ tốn ái ùn tang tảy. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Mơi tiếu mà thấy vé côống ái ùn, thấy yý vé côống tẩt cả cảc moón: Hảy tỉnh tào!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Caá ní, khâu han ngáy nửa là lể Vượt Qua ôộng lể Pènh Chăng Men, cảc thấy tề lể cả côống thấy táy luật tang xím cảch nó, tể khâu khới pẳt giử Ngái cảch lèn lủt, maáng cò thể giểt Ngái ti. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Ví maáng vé: “Chăng rêng mấn tloong ký lể, rưởi là páo loán sẻ diển xa tloong dân chùng."<verse eid="MRK 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Tang caá Ngái ở tái Bê-tha-ni, tloong nhá của Si-môn, moón vẳc pếng hủi, Ngái tang ngối pêng pán ăn xì mộch phú nử ti tềng, tom xeo cày pính dấu pắng ngoọc tứng dấu cam túng nguyên chẩt, tẳt xiến lặm. Khâu khới tập pể cày pính, ới tổ dấu rì lêng tlổc Ngái. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Mơi khừa voóng maáng, cò mầy moón rổi giấn: "Ví cày chi mà cò chuyến hao phì dấu hơm ní? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Pởi dấu ní cò thể paành àn hơn pa tlăm đơ-ni-ê rối pan phảt cho moón nghéo." Maáng tlẻch vằng ới. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Mơi Chùa Giê-xu vé: “Hảy tể ới rì yên. Rêng nó ái ùn mấn khò ới rì? Ới tà mấn mộch việc tổt cho thấy. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Ví ái ùn luôn có moón nghéo ở côống mếng, ôộng pẩt cừ khới nó ái ùn moành ái ùn cò thể mấn việc tổt cho maáng, mơi ái ùn sẻ chăng cò thấy luôn. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Ới tà mấn việc mà ới cò thể. Ới tà chuẩn pí tlưởc mà xửc xảc thấy hường tềng việc pầm. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Xật sứ, thấy vé côống ái ùn, pẩt ký Tin Lénh àn rao giảng tược nó tlêng khồm thề giời xì việc mà ới ní tà mấn yý sẻ àn kể lái tloong việc căắn vến ới."<verse eid="MRK 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Cón Giu-đa Ích-ca-ri-ốt, mộch tloong mưới han sừ tố, xa ti tềng côống cảc thấy tề lể cả tể reé cò thể giao nộp Ngái cho maáng. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Caá ní, khâu khới măng như xí, maáng phui lặm ôộng hừa cho reé pạc. Rối reé xím cảch nó thuấn lới tể phản nộp Ngái.<verse eid="MRK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Pao ngáy tấu tiên của lể Pènh Chăng Men, khới maáng dơng sinh tề chiên con lể Vượt Qua, cảc môn tố Ngái vé côống Ngái: "Thấy moành tán tôi ti chuẩn pí ở tược nó tể thấy cò thể ăn lể Vượt Qua?" <verse eid="MRK 14:12" /><verse number="13" style="v" sid="MRK 14:13" />Rối Ngái khai phài han tloong cảc môn tố mếng, ôộng vé côống maáng: “Hảy ti pao tloong thánh, ôộng mộch moón vang pính rảc sẻ tốn ái ùn. Hảy ti xeo ái ha. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Nều ái ha pao nhá nó, hảy vé côống chủ nhá là: 'Thấy pảo: "Phoóng khẻch của tôi, tược tôi cò thể ăn lể Vượt Qua côống cảc môn tố mếng, ở tược nó?" <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Chủ nhá sẻ chỉ ái ùn mộch cày phoóng náy tlêng tấng tà àn sẳp tệch sẳn sáng, ôộng hảy chuẩn pí cho tán ha ở rì." <verse eid="MRK 14:15" /><verse number="16" style="v" sid="MRK 14:16" />Xí là cảc môn tố xa khỏi ôộng ti pao thánh, rối maáng kỉa tẩt cả cảc việc chôồng như Ngái tà vé côống maáng, ôộng maáng chuẩn pí pừa ăn lể Vượt Qua.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Khới tà tềng khuống xồn, Ngái ti tềng côống mưới han sừ tố. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Khới maáng tang ngối pêng pán ăn ôộng tang ăn, Chùa Giê-xu vé: “Xật sứ, thấy vé côống ái ùn là mộch moón tloong ái ùn, là moón tang ăn côống thấy, sẻ phản thấy.” <verse eid="MRK 14:18" /><verse number="19" style="v" sid="MRK 14:19" />Maáng pẳt tấu puốn rấu ôộng moón ní tềng moón kia thưa côống Ngái: "Chẳc chăng phải là tôi vảy?" <verse eid="MRK 14:19" /><verse number="20" style="v" sid="MRK 14:20" />Mơi Ngái vé côống maáng: "Rì là mộch tloong mưới han ái ùn, moón tang chuú pènh pao chèn côống thấy. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Ví Con Moón xa ti chôồng như lới tà àn chẻp vến Ngái, mơi đàng rủa sả thay cho enh mà pởi reé, Con Moón pí phản nộp! Thá enh rì má teẻ xa xì tổt hơn cho reé."<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Tang caá maáng ăn, khâu khới lế pènh, cảm tá, Ngái pẻ xa, tưa cho maáng ôộng vé: "Hảy nhấn lế. Ní là thân thể của thấy." <verse eid="MRK 14:22" /><verse number="23" style="v" sid="MRK 14:23" />Ôộng khâu khới lế chèn, tá ơn, Ngái tưa cho maáng, ôộng maáng tếu oòng ở chèn rì. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Ngái vé côống maáng: “Ní là mầu giao ưởc của thấy, là mầu àn tổ xa cho nhiếu moón. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Xật sứ, thấy vé côống ái ùn, là thấy chẳc chằn sẻ chăng cón oòng rảc pở tlày của câl nho nửa cho tềng ngáy rì, là khới thấy oòng rảc nho mời tloong vương quổc Thiên Chùa.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Khâu khới hảt mộch pái thành ca, maáng ti xa hường tềng nùi Ô-liu. <verse eid="MRK 14:26" /><verse number="27" style="v" sid="MRK 14:27" />Chùa Giê-xu vé côống maáng xí ní: “Tẩt cả ái ùn sẻ pổ lở, như có chẻp xí ní:</para>
  <para style="q" vid="MRK 14:27">‘Ho sẻ tành moón chăn,</para>
  <para style="q" vid="MRK 14:27">xì chiên sẻ pí tan lạc.’<verse eid="MRK 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28" />Mơi khâu khới thấy tà àn mấn cho khôồng lái, thấy sẻ ti tlưởc ái ùn tềng Ga-li-lê.” <verse eid="MRK 14:28" /><verse number="29" style="v" sid="MRK 14:29" />Mơi Phi-e-rơ thưa côống Ngái: “Thấm chì ngay cả maáng sẻ pí pổ lở, mơi tôi xì chăng nó." <verse eid="MRK 14:29" /><verse number="30" style="v" sid="MRK 14:30" />Chùa Giê-xu vé côống ôông: “Xật sứ, thấy pảo ái, là hôm nay — ngay têm nay — tlưởc khới kha khôồng cằn han lượt, ái sẻ tứ chồi thấy pa lấn." <verse eid="MRK 14:30" /><verse number="31" style="v" sid="MRK 14:31" />Mơi ôông vé cảch chẳc chằn: "Nều pẳt puộc tôi chểt côống thấy, tôi chẳc chằn sẻ chăng tứ chồi thấy." Caá ní, tẩt cả maáng yý tếu vé như xí.<verse eid="MRK 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Rối maáng ti tềng mộch tược, xên tược rì là Ghết-sê-ma-nê, ôộng Ngái vé côống cảc môn tố mếng: "Hảy ngối ní tloong caá thấy cấu nguyến." <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Ngái tom Phi-e-rơ, Gia-cơ, ôộng Giăng côống ti ôộng Ngái, rối Ngái pẳt tấu sấu nảo ôộng rẩt là pồi rồi. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ngái vé côống maáng: “Linh hốn của thấy tang puốn rấu lặm, tềng mửc chểt ti. Hảy cừ ở ní ôộng tỉnh tào." <verse eid="MRK 14:34" /><verse number="35" style="v" sid="MRK 14:35" />Rối ti giang xêm mộch ét nửa, Ngái khẩp mếng xuồng tẩt ôộng cấu nguyến là, nều cò thể àn, cườn giớ rì qua khỏi Ngái. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ngái thưa: “A-ba, Cha ời, côống Cha tẩt cả cảc việc là cò thể. Cườn mon chèn ní khỏi con. Mơi chăng phải là tiếu con moành, mơi là tiếu Cha moành." <verse eid="MRK 14:36" /><verse number="37" style="v" sid="MRK 14:37" />Rối Ngái tlở lái ôộng kỉa maáng tang tảy, rêng Ngái hôổc Phi-e-rơ: “Si-môn, ái tảy à? Ái chăng thể tỉnh tào mộch giớ àn à? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Hảy tỉnh tào ôộng cấu nguyến, tể ái ùn chăng pưởc pao càm dổ. Tâm thấn xì xật moành, mơi xảc xịt lái yếu ởt.” <verse eid="MRK 14:38" /><verse number="39" style="v" sid="MRK 14:39" />Mộch lấn nửa, khới tà ti xa, Ngái cấu nguyến, thưa cảc lới chôồng như xí. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Ôộng lấn nửa, khới quay lái, Ngái kỉa maáng tang tảy, ví mẳt maáng tlỉu nắng, ôộng maáng chăng mẳt cày chi tể tlả lới Ngái. <verse eid="MRK 14:40" /><verse number="41" style="v" sid="MRK 14:41" />Rối Ngái tềng lấn xừ pa ôộng vé côống maáng: “Ái ùn vẩn cón tảy ôộng hơi mai à? Tủ rối! Giớ tà tềng. Hảy hẩu ti! Con Moón pú pí phản nộp pao xay moón cò xối. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Hảy từng dấn, ti rôi. Hẩu rạ, moón phản thấy tà tềng khênh." <verse eid="MRK 14:42" /><verse number="43" style="v" sid="MRK 14:43" />Ngay caá rì, Khới Ngái vẩn cón tang vé, Giu-đa, mộch tloong mưới han sừ tố, ti tềng côống reé là mộch đàm tôông kém xeo gươm tao ôộng câấy, xuẩt phảt pở tược cảc thấy tề lể cả, cảc thấy táy luật ôộng cảc tlưởng lảo. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Caá ní, xên phản bối Ngái tà cho maáng mộch àm hiếu, xí ní: "Moón nó mà tôi hôn xì chình là ôông rì. Hảy pẳt ôông ha ôộng giải ti cảch cẩn thấn." <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Xí là, khới tà tềng tược, lập tửc, khâu khới ti tềng Ngái, reé vé: "Ra-bi," rối reé hôn Ngái. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Caá ní, tán phề xa xay tlêng Ngái ôộng pẳt giử Ngái. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Mơi mộch moón ní tloong cảc moón từng khênh, khâu khới rủt gươm xa, tà tần côông moón hấu của thấy tề lể cả ôộng chạch tểch cày xai ái ha. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Tlả lới lái việc pẳt giử, Chùa Giê-xu vé côống maáng: "Cảc ôông ti xa côống gươm giào ôộng câấy tể pẳt tôi như thể chồng lái mộch xên cưởp à? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Hãng ngáy tôi ở côống cảc ôông khới giảng táy tloong tến thớ, mà cảc ôông lái chăng pẳt tôi. Mơi, ní là tể lới Kinh Thành àn ừng nghiếm." <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Khâu khới lảc lái Ngái, tẩt cả maáng tếu chắn tlồn.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Mộch thanh niên kia ti xeo Ngái, vồn chỉ mặc cày ào khoảc pải lanh phủ quenh moón, ôộng maáng pẳt giử ái, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />mơi khâu khới lảc lái cày ào khoảc, ái ha ở lo chắn ti.<verse eid="MRK 14:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Tán phề tưa Chùa Giê-xu tềng tược thấy tề lể thướng phẩm, ôộng tẩt cả cảc thấy tề lể cả, cảc tlưởng lảo, côống cảc thấy táy luật tếu tập tlung lái. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Cón Phi-e-rơ xeo Ngái pở táng giang, pao tềng tấn khà tloong sân của thấy tề lể thướng phẩm, rối ôông ngối côống cảc lình gảc ôộng hơ ầm pêng đàm lửa. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Caá rì, cảc thấy tề lể cả ôộng tẩt cả Hối đống Do Thài tang xím chừng cừ chồng lái Chùa Giê-xu tể tưa Ngái pao tược chểt, mơi maáng chăng xím kỉa cày chi. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Ví nhiếu moón mấn chừng lẻo chồng lái Ngái, mơi lới chừng của maáng xì chăng chôồng ôộng phố. <verse eid="MRK 14:56" /><verse number="57" style="v" sid="MRK 14:57" />Mầy moón, khâu khới từng dấn, mấn chừng lẻo chồng lái Ngái, khới vé <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />xí ní: “Tán tôi măng ôông ha vé là ‘Tôi sẻ phà hủy tến thớ pởi xay moón mấn xa ní, rối tloong pa ngáy tôi sẻ xây mộch tến thớ khảc chăng pởi xay moón mấn rêng.’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Mơi, ngay cả vến việc ní, xì lới chừng của maáng yý chăng chôồng phố. <verse eid="MRK 14:59" /><verse number="60" style="v" sid="MRK 14:60" />Rối khâu khới từng lêng ở khừa tẩt cả cảc moón, thấy tề lể thướng phẩm poi Chùa Giê-xu là: “Xí nó ái chăng tlả lới cày chi cả? Cảc moón ní mấn chừng chồng lái ái tiếu chi?" <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Mơi Ngái vẩn im lắng ôộng chăng tlả lới chi hểt. Thấy tề lể thướng phẩm lái poi Ngái, ôộng ôông vé côống Ngái: “Ái cò phải là Chùa Cừu Thề, Con của Tầng đàng ca ngới, chăng?” <verse eid="MRK 14:61" /><verse number="62" style="v" sid="MRK 14:62" />Caá rì, Chùa Giê-xu vé: “Chình là tôi;</para>
  <para style="q" vid="MRK 14:62">rối cảc ôông sẻ kỉa Con Moón</para>
  <para style="q2" vid="MRK 14:62">ngối táng chăm Tầng Quyến Năng</para>
  <para style="q2" vid="MRK 14:62">ôộng tềng khừa cảc đàm mân tlới.”<verse eid="MRK 14:62" /></para>
  <para style="m">
    <verse number="63" style="v" sid="MRK 14:63" />Xí là khâu khới xè rẻch ào mếng, thấy tề lể thướng phẩm vé: "Tán ha cón cấn chi vến nhân chừng nửa? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Cảc ôông tà măng lới phám thướng rối lả. Cảc ôông nghỉ xí nó?” Xí là tẩt cả tếu lêng àn Ngái là enh đàng chểt. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Một xồ enh pẳt tấu chủ rảc dài pao Ngái, pịt mặt Ngái ôộng tành tẩp Ngái, rối vé côống Ngái: “Vé tiên tli ti hẩu iếng!” Mấy cảnh vế yý giử lế Ngái mà tảt.<verse eid="MRK 14:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Tloong khới Phi-e-rơ ở tìn sân, mộch tloong cảc moón hấu cài của thấy tề lể thướng phẩm ti tềng tược ôông. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Caá kỉa Phi-e-rơ tang hơ ầm, khới hẩu kỷ ôông, vaá rì pảo: "Ái yý ở côống Giê-xu, moón Na-xa-rét." <verse eid="MRK 14:67" /><verse number="68" style="v" sid="MRK 14:68" />Mơi ôông tứ chồi, pảo là: “Tôi chăng mẳt, yý chăng hiểu vaá tang vé cày chi.” Rối ôông ti xa vái sân. <verse eid="MRK 14:68" /><verse number="69" style="v" sid="MRK 14:69" />Từa hấu cài tà hẩu kỉa ôông lái pẳt tấu vé côống cảc moón tang từng rì xí ní: “Moón ní là xuộc tán rì!” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Mơi ôông tứ chồi lấn nửa. Mộch caá khâu rì, cảc enh từng rì lái vé côống Phi-e-rơ: “Chẳc chằn ái xuộc vến tán cảc enh rì, ví ái yý là moón Ga-li-lê.” <verse eid="MRK 14:70" /><verse number="71" style="v" sid="MRK 14:71" />Mơi ôông pẳt tấu rủa ôộng thế xí ní: "Tôi chăng mẳt moón rì, cày moón mà mầy ái tang vé tềng." <verse eid="MRK 14:71" /><verse number="72" style="v" sid="MRK 14:72" />Ngay caá rì kha khôồng cằn lấn xừ han ôộng Phi-e-rơ căắn xa lới mà Chùa Giê-xu tà vé côống ôông xí ní: "Tlưởc khới kha khôồng cằn hai lượt, ái sẻ tứ chồi thấy pa lấn," rêng tloong caá suy sụp, ôộng nhám lêng.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Ngay pao puổi tlàng khờm, caá cảc thấy tề lể cả tà vở cuộc họp côống cảc tlưởng lảo côống cảc thấy táy luật ôộng tẩt cả Hối đống Do Thài, xì khâu khới tlòi Chùa Giê-xu, maáng tưa Ngái ti ôộng giao cho Phi-lát. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Phi-lát poi Ngái: “Ái là Vua moón Do Thài phải chăng?” Mơi khới tlả lới ôông, Ngái pảo: "Chình ôông vé như xí." <verse eid="MRK 15:2" /><verse number="3" style="v" sid="MRK 15:3" />Rối cảc thấy tề lể cả tồ cào Ngái nhiếu tiếu. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Caá ní, Phi-lát lái chẩt vần Ngái, xí ní: “Ái chăng tlả lới lái cày chi cả à? Hẩu rạ, maáng tang puộc xối ái nhiếu tiếu lặm!” <verse eid="MRK 15:4" /><verse number="5" style="v" sid="MRK 15:5" />Mơi Chùa Giê-xu chăng cón vé lái lới nó nửa, tềng nổi Phi-lát lế mấn ngạc nhiên.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Mặt khảc, pao dịp lể, ôông hay tha cho dân chùng mộch moón tú mà maáng yêu cấu. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Caá ní, cò mộch moón àn hôổc là Ba-ra-ba tang pí tú côống cảc moón mấn loán, là cảc enh phám xối giểt moón tloong cuộc páo đống. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Khâu khới kèo tềng, đàm tôông pẳt tấu yêu cấu ôông như ôông hay mấn cho maáng. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Caá ní, Phi-lát poi maáng, xí ní: “Tán dâu moành tôi tha Vua dân Do Thài cho tán dâu chăng?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Ví ôông mẳt là cảc thấy tề lể cả tà giao nộp Ngái ví loóng ghen khẻt. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Mơi cảc thấy tề lể cả xui giục dân chùng tể thay pao rì, ôông ha cấn phải tha Ba-ra-ba cho maáng. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Mơi, khới poi lái, Phi-lát vé côống maáng: "Xí xì, tôi phải mấn chi côống moón mà tán dâu hôổc là Vua dân Do Thài ní?" <verse eid="MRK 15:12" /><verse number="13" style="v" sid="MRK 15:13" />Caá ní, dân chùng lái rố náy: “Hảy toòng tenh reé tlêng câl thập tứ.” <verse eid="MRK 15:13" /><verse number="14" style="v" sid="MRK 15:14" />Mơi, Phi-lát vé côống maáng: "Ví tiếu ảc nó moón ní tà mấn?" Mơi, maáng cáng rố náy hơn: "Hảy toòng tenh reé tlêng câl thập tứ." <verse eid="MRK 15:14" /><verse number="15" style="v" sid="MRK 15:15" />Caá ní, ví moành mấn phưa loóng đàm tôông, Phi-lát tà tha Ba-ra-ba cho maáng ôộng ôông cho giải Chùa Giê-xu ti tể khâu khới tành tón, xì Ngái pí toòng tenh.<verse eid="MRK 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Caá rì, tán lình lôi Ngái pao tloong dinh (nghỉa là dinh tổng đổc) ôộng hôổc cả đối binh tập tlung lái, <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />rối phề mặc lêng Ngái mộch cày ào mấu tìa, rối puông cho Ngái mộch cày vương miến pắng khoóng phề tà taanh, <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />ôộng phề pẳt tấu cháo Ngái: “Hoan hô Vua dân Do Thài!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Xí rối, phề tành lêng tlổc Ngái pắng câấy ôộng chủ rảc dài pao Ngái, ôộng quý cổ cồn xuồng thớ láy Ngái. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Caá tán phề tà chề nháo Ngái xoong, phề cởi ti khỏi Ngái cày ào mấu tìa ôộng mặc tố của Ngái pao cho Ngái, rối tưa Ngái ti tể phề toòng tenh Ngái tlêng câl thập tứ. <verse eid="MRK 15:20" /><verse number="21" style="v" sid="MRK 15:21" />Phề pẳt mộch moón ti khà ní, xên là Si-môn, moón Sy-ren (pồ của A-léc-xan-đơ ôộng Ru-phu), pở quê lêng, tể ôông vảc câl thập tứ của Ngái.<verse eid="MRK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 15:22" />Phề tom Ngái tềng Gô-gô-tha (mộch tược mà reé cò nghỉa là “Tược Cày Xoó”). <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Phề cho Ngái oòng ráo àn hóa côống nhứa hơm, mơi Ngái chăng oòng. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Rối phề toòng tenh Ngái ôộng chia phố ào của Ngái pắng cảch rủt thăm cho mếng, hẩu ôông ay àn phấn nó. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Caá ní là giớ xừ pa, phề toòng tenh Ngái. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Ní là cày pảng kểt xối của Ngái, tà àn viểt: "Vua Dân Do Thài." <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Phề yý toòng tenh han enh lốm côống Ngái, mộch enh ở táng chăm, cón enh kia ở táng chiêu Ngái. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />(Lới Kinh Thành tà àn ừng nghiếm, xí ní: 'Ngái pí kể chung côống cảc moón chăng luật phảp'). <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Cảc moón ti qua sỉ nhục Ngái, lẳc tlổc mếng ôộng vé: “Hớ! Cày enh phà tến thớ rối xây lái tloong pa ngáy, <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />hảy tứ cừu mếng pắng cảch xuồng khỏi câl thập tứ ti!" <verse eid="MRK 15:30" /><verse number="31" style="v" sid="MRK 15:31" />Yý chôồng như xí, cảc thấy tề lể cả côống cảc thấy táy luật, côống phố chề nháo Ngái, maáng vé: "Reé cừu àn nhiếu moón khảc, mơi reé chăng thể tứ cừu lế mếng. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Chùa Cừu Thề, Vua của Y-sơ-ra-ên, caá ní hảy xuồng khỏi câl thập tứ ti, tể tán tôi kỉa mà tin.” Cảc moón pí toòng tenh côống Ngái yý chề nháo Ngái.<verse eid="MRK 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Tềng giớ xừ phầu, sứ xồn xăm xuẩt hiến pao phủ khồm tẩt cho tềng giớ xừ chìn. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Pao giớ xừ chìn, Chùa Giê-xu rố náy xiềng: “Ê-lô-i, Ê-lô-i, la-ma sa-bách-tha-ni?” lới rì cò nghỉa là: “Thiên Chùa tôi ời, Thiên Chùa tôi ời, xí nó Ngái lảc tôi?” <verse eid="MRK 15:34" /><verse number="35" style="v" sid="MRK 15:35" />Khới măng xí, mầy enh từng khênh rì vé: "Hẩu rạ, reé tang hôổc Ê-li." <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Xí rối, mộch ôông ay rì, khâu khới chắn ti tẩm tấy giầm pao pọt piển, puộc tlêng câl sấy, moón rì tưa cho Ngái oòng, pảo: "Hảy cừ tể mặc reé, hẩu Ê-li cò tềng tom reé xuồng chăng." <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />Caá ní, khâu khới tà rố lêng mộch xiềng náy, Chùa Giê-xu xẳt hơi thở cuồi cúng. <verse eid="MRK 15:37" /><verse number="38" style="v" sid="MRK 15:38" />Ôộng cày mán tloong tến thớ pí xeè mấn han pở tlêng xuồng tìn. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Caá ní viên đối tlưởng, moón từng ở khà đồi diến Ngái, khới tà kỉa là Ngái xẳt hơi thở cuồi cúng như xí, ôông vé: "Xật sứ, moón ní là Con của Thiên Chùa." <verse eid="MRK 15:39" /><verse number="40" style="v" sid="MRK 15:40" />Yý cò cảc moón phú nử từng hẩu pở táng giang, tloong sồ maáng cò Ma-ri Ma-đơ-len, Ma-ri (mế Gia-cơ énh ôộng Giô-sê) côống Sa-lô-mê. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />là cảc moón mà khới Ngái cón ở tái Ga-li-ê, maáng tà ti xeo Ngái ôộng phục vuú Ngái, cón nhiếu phú nử khảc nửa tà côống ti lêng ôộng Ngái tềng Giê-ru-sa-lem.<verse eid="MRK 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Caá tà tềng khuống xồn rối, vì hôm rì là Ngáy Chuẩn Pí, nghỉa là ngáy tlưởc ngáy Sa-bát, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Giô-sép, là moón pở púng A-ri-ma-thê, mộch thánh viên đàng kình tloong Hối đống, yý chình là moón tang moong tới vương quổc của Thiên Chùa, khới tà tềng tược, ôông can đảm pao tốn Phi-lát ôộng poi cườn xảc Chùa Giê-xu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Caá ní, Phi-lát rẩt ngạc nhiên nều xật là Ngái tà chểt rối, ôộng khâu khới hôổc viên đối tlưởng, ôông poi moón rì hẩu xứ Ngái tà chểt pao lô. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Caá tà mẳt rỏ sứ việc pở viên đối tlưởng, ôông ha giao xảc cho Giô-sép. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Khâu khới mua pải gai, tom Ngái xuồng khỏi câl thập tứ, ôông quần Ngái lái pắng pải rì, ôộng tệch Ngái pao mộch cày môố tà àn tục tloong nùi phú. Rối ôông lăn mộch tảng phú ngăn cửa môố. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Caá rì, Ma-ri Ma-đơ-len ôộng Ma-ri mế của Giô-sê tà kỉa tược Ngái àn pầm.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Khới ngáy Sa-bát tà qua, Ma-ri Ma-đơ-len, Ma-ri mế Gia-cơ, ôộng Sa-lô-mê, mua xuổc hơm tể khới tềng tược, maáng cò thể xửc xảc Ngái. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Pở rẩt khờm ngáy xừ nhẩt tloong tuấn, maáng ti tềng tược cày môố khới mặt tlới phưa moọc. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Maáng pán côống phố: “Ôông ay sẻ lăn tảng phú khỏi cửa cày môố cho tán ha?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Khới hẩu lêng, maáng kỉa là tảng phú tà àn lăn ti, dú reé rẩt náy. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Rối khới tà pao tloong cày môố, maáng kỉa mộch thanh niên mặc ào tlằng tang ngối ở táng chăm, ôộng maáng pí hoảng hổt. <verse eid="MRK 16:5" /><verse number="6" style="v" sid="MRK 16:6" />Mơi moón rì vé côống maáng: “Má rưởi. Cảc ới tang xím Giê-xu moón Na-xa-rét, Tầng tà pí toòng tenh tlêng câl thập tứ. Ngái tà àn mấn khôồng lái rối! Ngái chăng ở ní. Hảy hẩu tược mà maáng tà tệch xảc Ngái. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Mơi, hảy ti, vé cho cảc môn tố Ngái ôộng Phi-e-rơ là: 'Ngái sẻ ti tlưởc ái ùn tềng Ga-li-lê. Ở rì, ái ùn sẻ kỉa Ngái', chôồng như Ngái tà vé côống ái ùn."<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Caá tà xa vái, maáng chắn khỏi cày môố, ví sứ run rẩy ôộng sửng sổt pao phủ maáng. Ôộng maáng chăng vé cày chi côống ôông ay ví maáng rưởi quà. <verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />(Tlàng Khờm ngáy thừ nhẩt tloong tuấn, khới tà khôồng lái, Ngái hiến xa tlưởc hểt cho Ma-ri Ma-đơ-len, là moón mà Ngái tà tuổi pảy quỷ xa khỏi. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Moón phú nử rì ti vé lái cho cảc moón tững ở côống Ngái tloong caá maáng tang puốn thảm ôộng tang nhám. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Cón maáng, khới măng là Ngái caá ní tang khôồng ôộng tà àn chình vaá hẩu kỉa, xì chăng tin.<verse eid="MRK 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Caá rì, khâu cảc việc rì, Ngái hiến xa tloong hính dàng khảc cho han moón tloong xồ maáng tang caá ti pố tiền vến púng quê. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Ôộng han moón rì, khâu khới quay tlở lái, kể cho cảc môn tố cón lái, mơi maáng chăng tin han moón.<verse eid="MRK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Mơi rối, cuồi cúng, Ngái hiến xa cho mưới mộch sừ tố tang khới maáng ngối pêng pán ăn, Ngái quở tlẻch sứ chăng tin ôộng cừng loóng của maáng ví maáng chăng tin cảc moón tà kỉa Ngái khâu khới Ngái tà àn khôồng lái pở cày chểt. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Ngái truyến pảo maáng: “Khới ti tềng khồm thề gian, hảy rao giảng Tin Lénh cho tẩt cả táo vật. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Ôông ay tin ôộng chíu báp-têm sẻ àn cừu, cón ôông ay chăng tin sẻ pí kểt xối. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Cảc dầu lá ní sẻ xeo côống cảc moón cò đửc tin: Nhân danh thấy, maáng sẻ tlục xuẩt cảc quỷ. Maáng sẻ vé cảc xừ xiềng mời. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Maáng sẻ pẳt xành, ôộng dú cho maáng oòng cày chi tôộc hái, chẳc chằn reé chăng mấn thương tổn chi tềng maáng. Maáng sẻ tệch xay lêng cảc moón tâu yều xì cảc moón rì sẻ àn lénh.”<verse eid="MRK 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Khâu khới Chùa Giê-xu tà vé côống maáng, Ngái àn tom lêng tlới ôộng ngối táng chăm Thiên Chùa. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Cón cảc moón rì, khâu khới xa ti, maáng rao giảng khồm tẩt cả cảc tược, tloong khới Chùa mấn việc côống maáng ôộng xảc nhấn cho đáo pắng cảc dầu lá kém xeo. A-men.)<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>